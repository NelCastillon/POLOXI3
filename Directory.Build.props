<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Azure.Core / Azure.Identity can register JsonSchemaSegment items that trigger
    VS 18's GenerateCombinedAppSettingsSchemaTarget.
    VS 18 does not ship the base appsettings schema file that target requires, causing a
    design-time build error: "Could not find file '...appsettingsschema.json'".
    This solution does not use Aspire component configuration schemas, so suppress them.
  -->
  <Target Name="_SuppressAzureSdkJsonSchemaSegments"
          BeforeTargets="GenerateCombinedComponentSchemaTarget;GenerateCombinedAppSettingsSchemaTarget">
    <ItemGroup>
      <JsonSchemaSegment Remove="@(JsonSchemaSegment)" />
    </ItemGroup>
  </Target>
</Project>
