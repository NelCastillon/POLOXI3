<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AmsCodeSigningThumbprint Condition="'$(AmsCodeSigningThumbprint)' == ''">$(AMS_CODE_SIGNING_THUMBPRINT)</AmsCodeSigningThumbprint>
    <AmsCodeSigningTimestampServer Condition="'$(AmsCodeSigningTimestampServer)' == ''">http://timestamp.digicert.com</AmsCodeSigningTimestampServer>
  </PropertyGroup>
  <Target Name="SignAmsWebArtifacts"
          AfterTargets="Build;Publish"
          Condition="'$(OS)' == 'Windows_NT' and '$(AmsCodeSigningThumbprint)' != ''">
    <ItemGroup>
      <_AmsWebSigningArtifact Include="$(TargetPath)" Condition="Exists('$(TargetPath)')" />
      <_AmsWebSigningArtifact Include="$(TargetDir)$(TargetName).exe" Condition="Exists('$(TargetDir)$(TargetName).exe')" />
      <_AmsWebSigningArtifact Include="$(PublishDir)$(TargetFileName)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)$(TargetFileName)')" />
      <_AmsWebSigningArtifact Include="$(PublishDir)$(TargetName).exe" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)$(TargetName).exe')" />
    </ItemGroup>
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\eng\Sign-Authenticode.ps1&quot; -Thumbprint &quot;$(AmsCodeSigningThumbprint)&quot; -TimestampServer &quot;$(AmsCodeSigningTimestampServer)&quot; @(_AmsWebSigningArtifact->'&quot;%(FullPath)&quot;', ' ')" />
  </Target>
  <ItemGroup>
    <Compile Remove="Components\Pages\Platform\Tenants\Tabs\**" />
    <Content Remove="Components\Pages\Platform\Tenants\Tabs\**" />
    <EmbeddedResource Remove="Components\Pages\Platform\Tenants\Tabs\**" />
    <None Remove="Components\Pages\Platform\Tenants\Tabs\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Components\Pages\Accounts\_AccountPageModels.cs" />
    <Compile Remove="Components\Pages\_SubmissionPageModels.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Components\Pages\AcordFormsCenter.razor" />
    <Content Remove="Components\Pages\Branches.razor" />
    <Content Remove="Components\Pages\CreateLead.razor" />
    <Content Remove="Components\Pages\Iam\Permissions\RolePermissionMatrix.razor" />
    <Content Remove="Components\Pages\ProducerWorkbench.razor" />
    <Content Remove="Components\Pages\TenantDocumentsFormsSetup.razor" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Components\Pages\AcordFormsCenter.razor.css" />
    <None Remove="Components\Pages\Branches.razor.css" />
    <None Remove="Components\Pages\Iam\Permissions\RolePermissionMatrix.razor.css" />
    <None Remove="Components\Pages\TenantDocumentsFormsSetup.razor.css" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ams.Application\Ams.Application.csproj" />
    <ProjectReference Include="..\Ams.Infrastructure\Ams.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Knowledge\Ams.Knowledge.Application\Ams.Knowledge.Application.csproj" />
    <ProjectReference Include="..\Modules\Knowledge\Ams.Knowledge.Contracts\Ams.Knowledge.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Components\Pages\Platform\Provisioning\" />
  </ItemGroup>
</Project>
