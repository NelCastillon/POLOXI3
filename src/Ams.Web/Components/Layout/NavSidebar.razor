    protected override void OnInitialized()
    {
        Shell.OnChange        += OnShellChange;
        NavContext.OnChange   += OnNavContextChange;
        Nav.LocationChanged   += OnLocationChanged;
        AutoExpandForUrl(Nav.Uri);
    }

