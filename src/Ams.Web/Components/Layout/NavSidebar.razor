        (Shell.MobileNavOpen ? " is-mobile-open" : "");

    // ── Lifecycle ─────────────────────────────────────────────
    protected override void OnInitialized()
    {
        Shell.OnChange      += OnShellChange;
        Nav.LocationChanged += OnLocationChanged;
        AutoExpandForUrl(Nav.Uri);
    }

    private void OnShellChange() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? _, LocationChangedEventArgs e)
    {
        AutoExpandForUrl(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void AutoExpandForUrl(string uri)
    {
        var path = "/" + Nav.ToBaseRelativePath(uri).Split('?')[0].TrimStart('/');
        foreach (var sec in AllSections)
        {
            foreach (var grp in sec.Groups)
            {
                var hit = grp.Items.FirstOrDefault(
                    i => i.Url.Equals(path, StringComparison.OrdinalIgnoreCase));
                if (hit is null) continue;
                _expandedSections.Add(sec.Key);
                _expandedGroups.Add(grp.Key);
                RecordRecent(hit);
                return;
            }
        }
    }

    private void RecordRecent(NavItem item)
    {
        _recents.RemoveAll(r => r.Url == item.Url);
        _recents.Add(item);
        if (_recents.Count > 10) _recents.RemoveAt(0);
    }

    // ── Filtering ─────────────────────────────────────────────
    private IEnumerable<NavSection> GetVisibleSections()
    {
        if (string.IsNullOrWhiteSpace(_query)) return AllSections;
        var q = _query.Trim();
        return AllSections.Where(s =>
            s.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            s.Groups.Any(g =>
                g.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                g.Items.Any(i => i.Label.Contains(q, StringComparison.OrdinalIgnoreCase))));
    }

    private IEnumerable<NavGroup> GetVisibleGroupsInSection(NavSection sec)
    {
        if (string.IsNullOrWhiteSpace(_query)) return sec.Groups;
        var q = _query.Trim();
        return sec.Groups.Where(g =>
            g.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            g.Items.Any(i => i.Label.Contains(q, StringComparison.OrdinalIgnoreCase)));
    }

    private IEnumerable<NavItem> GetVisibleItems(NavGroup grp)
    {
        if (string.IsNullOrWhiteSpace(_query)) return grp.Items;
        var q = _query.Trim();
        return grp.Items.Where(i => i.Label.Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsSectionOpen(NavSection sec) =>
        _expandedSections.Contains(sec.Key) || !string.IsNullOrEmpty(_query);

    private bool IsGroupOpen(NavGroup grp) =>
        _expandedGroups.Contains(grp.Key) || !string.IsNullOrEmpty(_query);

    // ── Interactions ──────────────────────────────────────────
    private void HandleSectionClick(string key)
    {
        if (Shell.NavCollapsed)
        {
            Shell.ToggleNav();
            _expandedSections.Add(key);
            return;
        }
        if (!_expandedSections.Add(key))
            _expandedSections.Remove(key);
    }

    private void HandleGroupClick(string key)
    {
        if (!_expandedGroups.Add(key))
            _expandedGroups.Remove(key);
    }

    private void ToggleFavorite(NavItem item)
    {
        if (_favorites.Any(f => f.Url == item.Url))
            _favorites.RemoveAll(f => f.Url == item.Url);
        else
            _favorites.Insert(0, item);
    }

    public void Dispose()
    {
        Shell.OnChange      -= OnShellChange;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
