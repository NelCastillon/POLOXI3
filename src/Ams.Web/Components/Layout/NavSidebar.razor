@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject ShellStateService Shell
@inject NavigationContextService NavContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IDisposable

<nav id="ams-nav"
     class="@_navClass"
     aria-label="Main navigation">

    @* ── Brand / Logo ──────────────────────────────────── *@
    <a class="nav-brand" href="/" aria-label="Home">
        <div class="nav-logo" aria-hidden="true">
            <img src="/image/AgencyBinderLogo.png" alt="" />
        </div>
        <div class="nav-brand-text">
            <span class="nav-brand-name">AGENCYBINDER</span>
            <span class="nav-brand-sub">AMS Enterprise</span>
        </div>
    </a>

    @* ── Menu search ───────────────────────────────────── *@
    <div class="nav-search-wrap">
        <div class="nav-search-inner">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="nav-menu-search"
                   type="search"
                   class="nav-search-input"
                   placeholder="Search menu…"
                   autocomplete="off"
                   aria-label="Search navigation menu"
                   @bind="_query"
                   @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(_query))
            {
                <button class="nav-search-clear"
                        @onclick='() => _query = string.Empty'
                        aria-label="Clear search">
                    <i class="bi bi-x" aria-hidden="true"></i>
                </button>
            }
        </div>
    </div>

    @* ── Scrollable nav body ────────────────────────────── *@
    <div class="nav-body" role="list">

        @* ── Pinned favorites ──────────────────────────── *@
        @if (_favorites.Count > 0 && string.IsNullOrEmpty(_query))
        {
            <div class="nav-section-hd" role="separator">Favorites</div>
            @foreach (var fav in _favorites)
            {
                <NavLink class="nav-item-sub nav-item-fav" href="@fav.Url" title="@fav.Label" role="listitem">
                    <i class="bi bi-star-fill nav-fav-icon" aria-hidden="true"></i>
                    <span class="nav-label">@fav.Label</span>
                    <button class="nav-pin"
                            @onclick:stopPropagation="true"
                            @onclick="() => ToggleFavorite(fav)"
                            aria-label="Unpin @fav.Label">
                        <i class="bi bi-x" aria-hidden="true"></i>
                    </button>
                </NavLink>
            }
        }

        @* ── Module sections ───────────────────────────── *@
        @{
            bool _zoneShown = false;
        }
        @foreach (var sec in GetVisibleSections())
        {
            var secOpen = IsSectionOpen(sec);
            @if (AdminSectionKeys.Contains(sec.Key) && !_zoneShown && string.IsNullOrEmpty(_query))
            {
                _zoneShown = true;
                <div class="nav-zone-divider" role="separator">Administration</div>
            }
            <div class="nav-group @(secOpen ? "is-open" : "") @(AdminSectionKeys.Contains(sec.Key) ? "nav-zone-admin" : "")" role="listitem">
                <button class="nav-group-hd"
                        @onclick="() => HandleSectionClick(sec.Key)"
                        aria-expanded="@secOpen.ToString().ToLower()"
                        aria-controls="ns-@sec.Key"
                        title="@sec.Label">
                    <i class="@sec.Icon nav-icon" aria-hidden="true"></i>
                    <span class="nav-label">@sec.Label</span>
                    <i class="bi bi-chevron-right nav-chevron" aria-hidden="true"></i>
                </button>
                <div class="nav-group-items" id="ns-@sec.Key" role="list">
                    @if (sec.Groups.Length == 1)
                    {
                        @* Flat section — render items directly *@
                        @foreach (var item in GetVisibleItems(sec.Groups[0]))
                        {
                            var pinned = _favorites.Any(f => f.Url == item.Url);
                            <NavLink class="nav-item-sub" href="@item.Url" title="@item.Label" role="listitem">
                                <i class="@item.Icon nav-icon" aria-hidden="true"></i>
                                <span class="nav-label">@item.Label</span>
                                <button class="nav-pin @(pinned ? "is-active" : "")"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => ToggleFavorite(item)"
                                        aria-label="@(pinned ? "Unpin" : "Pin") @item.Label">
                                    <i class="@(pinned ? "bi bi-star-fill" : "bi bi-star")" aria-hidden="true"></i>
                                </button>
                            </NavLink>
                        }
                    }
                    else
                    {
                        @* Nested section — render sub-groups *@
                        @foreach (var grp in GetVisibleGroupsInSection(sec))
                        {
                            @if (grp.Items.Length == 1)
                            {
                                @* Single-item group — render as a direct NavLink (no collapsible wrapper) *@
                                var onlyItem = grp.Items[0];
                                var pinned0 = _favorites.Any(f => f.Url == onlyItem.Url);
                                <NavLink class="nav-item-sub nav-subgroup-hd" href="@onlyItem.Url" title="@onlyItem.Label" role="listitem">
                                    <i class="@onlyItem.Icon nav-icon" aria-hidden="true"></i>
                                    <span class="nav-label">@onlyItem.Label</span>
                                    <button class="nav-pin @(pinned0 ? "is-active" : "")"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => ToggleFavorite(onlyItem)"
                                            aria-label="@(pinned0 ? "Unpin" : "Pin") @onlyItem.Label">
                                        <i class="@(pinned0 ? "bi bi-star-fill" : "bi bi-star")" aria-hidden="true"></i>
                                    </button>
                                </NavLink>
                            }
                            else
                            {
                                var grpOpen = IsGroupOpen(grp);
                                <div class="nav-group nav-subgroup @(grpOpen ? "is-open" : "")" role="listitem">
                                    <button class="nav-group-hd nav-subgroup-hd"
                                            @onclick="() => HandleGroupClick(grp.Key)"
                                            aria-expanded="@grpOpen.ToString().ToLower()"
                                            aria-controls="ng-@grp.Key"
                                            title="@grp.Label">
                                        <i class="@grp.Icon nav-icon" aria-hidden="true"></i>
                                        <span class="nav-label">@grp.Label</span>
                                        <i class="bi bi-chevron-right nav-chevron" aria-hidden="true"></i>
                                    </button>
                                    <div class="nav-group-items" id="ng-@grp.Key" role="list">
                                        @foreach (var item in GetVisibleItems(grp))
                                        {
                                            var pinned = _favorites.Any(f => f.Url == item.Url);
                                            <NavLink class="nav-item-sub nav-item-deep" href="@item.Url" title="@item.Label" role="listitem">
                                                <i class="@item.Icon nav-icon" aria-hidden="true"></i>
                                                <span class="nav-label">@item.Label</span>
                                                <button class="nav-pin @(pinned ? "is-active" : "")"
                                                        @onclick:stopPropagation="true"
                                                        @onclick="() => ToggleFavorite(item)"
                                                        aria-label="@(pinned ? "Unpin" : "Pin") @item.Label">
                                                    <i class="@(pinned ? "bi bi-star-fill" : "bi bi-star")" aria-hidden="true"></i>
                                                </button>
                                            </NavLink>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        }

        @* ── Recently visited ──────────────────────────── *@
        @if (_recents.Count > 0 && string.IsNullOrEmpty(_query))
        {
            <div class="nav-section-hd" role="separator">Recent</div>
            @foreach (var r in _recents.AsEnumerable().Reverse().Take(5))
            {
                <NavLink class="nav-item-sub nav-recent" href="@r.Url" title="@r.Label" role="listitem">
                    <i class="bi bi-clock-history nav-icon" aria-hidden="true"></i>
                    <span class="nav-label">@r.Label</span>
                </NavLink>
            }
        }

    </div>
</nav>

