    {
        await LoadUserAccessAsync();
    }

    private async Task LoadUserAccessAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _isAuthenticated = user.Identity?.IsAuthenticated == true;
        _roles.Clear();
        _permissions.Clear();

        if (!_isAuthenticated)
        {
            return;
        }

        foreach (var role in user.FindAll(ClaimTypes.Role).Select(c => c.Value))
        {
            _roles.Add(role);
        }

        foreach (var permission in user.FindAll("permission").Select(c => c.Value))
        {
            _permissions.Add(permission);
        }
    }

    private void OnShellChange()      => InvokeAsync(StateHasChanged);
    private void OnNavContextChange() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? _, LocationChangedEventArgs e)
    {
        AutoExpandForUrl(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void AutoExpandForUrl(string uri)
    {
        var path = "/" + Nav.ToBaseRelativePath(uri).Split('?')[0].TrimStart('/');
        foreach (var sec in AllSections)
        {
            foreach (var grp in sec.Groups)
            {
                var hit = grp.Items.FirstOrDefault(i =>
                    i.Url.Equals(path, StringComparison.OrdinalIgnoreCase) ||
                    (i.Url.Contains("{id}") && MatchesPattern(i.Url, path)));
                if (hit is null) continue;
                _expandedSections.Add(sec.Key);
                _expandedGroups.Add(grp.Key);
                RecordRecent(ResolveItem(hit));
                return;
            }
        }
    }

    // Checks whether a URL pattern with {id} matches a concrete path
    private static bool MatchesPattern(string pattern, string path)
    {
        var patParts  = pattern.Split('/');
        var pathParts = path.Split('/');
        if (patParts.Length != pathParts.Length) return false;
        for (var i = 0; i < patParts.Length; i++)
        {
            if (patParts[i] == "{id}") continue;
            if (!patParts[i].Equals(pathParts[i], StringComparison.OrdinalIgnoreCase)) return false;
        }
        return true;
    }

    private void RecordRecent(NavItem item)
    {
        _recents.RemoveAll(r => r.Url == item.Url);
        _recents.Add(item);
        if (_recents.Count > 10) _recents.RemoveAt(0);
    }

    // ── URL resolution — replaces {id} placeholders with real context values ──
    private string ResolveUrl(string url)
    {
        if (url.Contains("{id}"))
        {
            var id = NavContext.CurrentAccountId?.ToString();
            if (string.IsNullOrWhiteSpace(id))
            {
                return "/accounts";
            }

            url = url.Replace("{id}", id);
        }
        return url;
    }

    private NavItem ResolveItem(NavItem item) =>
        item.Url.Contains("{id}") ? item with { Url = ResolveUrl(item.Url) } : item;

    // ── Filtering ─────────────────────────────────────────────
    private IEnumerable<NavSection> GetVisibleSections()
    {
        var visible = AllSections.Where(CanSeeSection).Where(s => GetVisibleGroupsInSection(s).Any());
        if (string.IsNullOrWhiteSpace(_query)) return visible;
        var q = _query.Trim();
        return visible.Where(s =>
            s.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            s.Groups.Any(g =>
                g.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                GetVisibleItems(g).Any(i => i.Label.Contains(q, StringComparison.OrdinalIgnoreCase))));
    }

    private IEnumerable<NavGroup> GetVisibleGroupsInSection(NavSection sec)
    {
        var visible = sec.Groups.Where(g => GetVisibleItems(g).Any());
        if (string.IsNullOrWhiteSpace(_query)) return visible;
        var q = _query.Trim();
        return visible.Where(g =>
            g.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            GetVisibleItems(g).Any(i => i.Label.Contains(q, StringComparison.OrdinalIgnoreCase)));
    }

    private IEnumerable<NavItem> GetVisibleItems(NavGroup grp)
    {
        var items = string.IsNullOrWhiteSpace(_query)
            ? grp.Items.AsEnumerable()
            : grp.Items.Where(i => i.Label.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase));
        return items.Where(CanSeeItem).Select(ResolveItem);
    }

    private bool CanSeeSection(NavSection section)
    {
        if (HasFullAccess()) return true;
        if (!_isAuthenticated) return false;
        return !SectionPermissions.TryGetValue(section.Key, out var required) || HasAnyPermission(required);
    }

    private bool CanSeeItem(NavItem item)
    {
        if (HasFullAccess()) return true;
        if (!_isAuthenticated) return false;
        if (!string.IsNullOrWhiteSpace(item.Role) && !_roles.Contains(item.Role)) return false;
        if (!string.IsNullOrWhiteSpace(item.Permission) && !_permissions.Contains(item.Permission)) return false;
        var normalizedUrl = item.Url.Split('?')[0];
        return !ItemPermissions.TryGetValue(normalizedUrl, out var required) || HasAnyPermission(required);
    }

    private bool HasFullAccess() =>
        _roles.Contains("SYSTEM_ADMIN") ||
        _roles.Contains("TENANT_ADMIN") ||
        _permissions.Contains("NAV_ALL") ||
        _permissions.Contains("PLATFORM_ADMIN");

    private bool HasAnyPermission(IEnumerable<string> permissions) =>
        permissions.Any(_permissions.Contains);

    private bool IsSectionOpen(NavSection sec) =>
        _expandedSections.Contains(sec.Key) || !string.IsNullOrEmpty(_query);

    private bool IsGroupOpen(NavGroup grp) =>
        _expandedGroups.Contains(grp.Key) || !string.IsNullOrEmpty(_query);

    // ── Interactions ──────────────────────────────────────────
    private void HandleSectionClick(string key)
    {
        if (Shell.NavCollapsed)
        {
            Shell.ToggleNav();
            _expandedSections.Add(key);
            return;
        }
        if (!_expandedSections.Add(key))
            _expandedSections.Remove(key);
    }

    private void HandleGroupClick(string key)
    {
        if (!_expandedGroups.Add(key))
            _expandedGroups.Remove(key);
    }

    private void ToggleFavorite(NavItem item)
    {
        if (_favorites.Any(f => f.Url == item.Url))
            _favorites.RemoveAll(f => f.Url == item.Url);
        else
            _favorites.Insert(0, item);
    }

    public void Dispose()
    {
        Shell.OnChange        -= OnShellChange;
        NavContext.OnChange   -= OnNavContextChange;
        Nav.LocationChanged   -= OnLocationChanged;
    }
}
