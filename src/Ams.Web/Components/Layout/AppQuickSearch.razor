@*
    AppQuickSearch - global command-palette / quick-search overlay.
    Activated by Ctrl+K (or ⌘K on Mac) via the keyboard listener in AppQuickSearch.razor.js,
    or programmatically via Shell.OpenQuickSearch() (e.g. clicking the search box in TopHeader).

    Place once inside MainLayout.razor.  The component self-registers its JS keyboard shortcut
    on first render using a DotNetObjectReference.
*@

@inject ShellStateService Shell
@inject ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Ams.Application.Features.Intelligence

@if (Shell.QuickSearchOpen)
{
    <div class="aqs-overlay" @onclick="Close" aria-hidden="true"></div>

    <div class="aqs-modal" role="dialog" aria-label="Quick search" aria-modal="true">
        <div class="aqs-header">
            <div>
                <span>Enterprise Search</span>
                <strong>Find pages, actions, and authorized records</strong>
            </div>
            <span class="aqs-fast-badge"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i> Fast mode</span>
        </div>

        @* -- Search input ---------------------------------- *@
        <div class="aqs-search-row">
            <i class="bi bi-search aqs-icon" aria-hidden="true"></i>
            <input id="aqs-input"
                   type="text"
                   class="aqs-input"
                   placeholder="Search pages, actions, records..."
                   autocomplete="off"
                   value="@_query"
                   @oninput="OnSearchInput"
                   @onkeydown="OnKeyDown" />
            <kbd class="aqs-esc-hint" aria-label="Press Escape to close">Esc</kbd>
        </div>

        @{
            var results = GetResults();
        }

        @* -- Results --------------------------------------- *@
        @if (results.Count > 0)
        {
            <ul class="aqs-results" role="listbox" aria-label="Search results">
                @for (var i = 0; i < results.Count; i++)
                {
                    var r   = results[i];
                    var idx = i;
                    <li role="none">
                        <a class="aqs-result-item @(_selectedIdx == idx ? "is-active" : "")"
                           href="@r.Url"
                           role="option"
                           aria-selected="@(_selectedIdx == idx ? "true" : "false")"
                           @onclick="Close">
                            <div class="aqs-result-icon">
                                <i class="bi @r.Icon" aria-hidden="true"></i>
                            </div>
                            <div class="aqs-result-body">
                                <span class="aqs-result-label">@r.Label</span>
                                @if (!string.IsNullOrEmpty(r.Category))
                                {
                                    <span class="aqs-result-cat">@r.Category</span>
                                }
                            </div>
                            <i class="bi bi-arrow-return-left aqs-result-enter" aria-hidden="true"></i>
                        </a>
                    </li>
                }
            </ul>
        }
        else if (_isSearching)
        {
            <div class="aqs-empty" role="status">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                <span>Searching records...</span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_query))
        {
            <div class="aqs-empty">
                <i class="bi @(string.IsNullOrWhiteSpace(_searchError) ? "bi-search" : "bi-exclamation-triangle")" aria-hidden="true"></i>
                <span>@(!string.IsNullOrWhiteSpace(_searchError) ? _searchError : _hasSearched ? (MarkupString)$"No results for \"<strong>{_query}</strong>\"" : (MarkupString)"Press <strong>Enter</strong> to search records")</span>
            </div>
        }
        else
        {
            @* -- Hint groups shown when no query is typed -- *@
            <div class="aqs-hints">
                @foreach (var grp in _hintGroups)
                {
                    <div class="aqs-hint-group">
                        <div class="aqs-hint-label">@grp.Label</div>
                        @foreach (var item in grp.Items)
                        {
                            <a class="aqs-hint-item" href="@item.Url" @onclick="Close">
                                <i class="bi @item.Icon" aria-hidden="true"></i>
                                <span>@item.Label</span>
                            </a>
                        }
                    </div>
                }
            </div>
        }

        @* -- Keyboard shortcut legend ----------------------- *@
        <div class="aqs-footer" aria-hidden="true">
            <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
            <span><kbd>↵</kbd> open</span>
            <span><kbd>Esc</kbd> close</span>
        </div>

    </div>
}

@code {
    private sealed record SearchItem(string Label, string Url, string Icon, string? Category = null);
    private sealed record HintGroup(string Label, SearchItem[] Items);

    private string _query       = string.Empty;
    private int    _selectedIdx = 0;
    private bool   _prevOpen;
    private bool   _isSearching;
    private bool   _hasSearched;
    private string? _searchError;
    private List<SearchItem> _recordResults = [];
    private CancellationTokenSource? _searchCancellation;
    private readonly Dictionary<string, QuickSearchCacheEntry> _quickSearchCache = new(StringComparer.OrdinalIgnoreCase);

    private DotNetObjectReference<AppQuickSearch>? _dotnetRef;
    private IJSObjectReference? _module;

    private sealed record QuickSearchCacheEntry(DateTimeOffset ExpiresUtc,IReadOnlyList<SearchItem> Results);

    // -- Hint groups (shown when query is empty) ---------------
    private static readonly HintGroup[] _hintGroups =
    [
        new("Navigation",
        [
            new("Dashboard",    "/",            "bi-speedometer2"),
            new("Leads",        "/leads",       "bi-person-plus"),
            new("Accounts",     "/accounts",    "bi-building"),
            new("Invoices",     "/invoices",    "bi-receipt"),
            new("Time Entries", "/timeentries", "bi-clock"),
        ]),
        new("Admin",
        [
            new("Users",       "/users",       "bi-people"),
            new("Roles",       "/roles",       "bi-shield-check"),
            new("Preferences", "/preferences", "bi-sliders"),
        ]),
    ];

    // -- Full searchable catalogue -----------------------------
    private static readonly SearchItem[] _catalogue =
    [
        new("Dashboard",          "/",                           "bi-speedometer2",       "Navigation"),
        new("Leads",              "/leads",                      "bi-person-plus",         "CRM"),
        new("Opportunities",      "/opportunities",              "bi-trophy",              "CRM"),
        new("Quotes",             "/crm/quotes",                 "bi-file-text",           "CRM"),
        new("Lead Activities",    "/crm/lead-activities",        "bi-lightning",           "CRM"),
        new("Accounts",           "/accounts",                   "bi-building",            "Accounts"),
        new("Contacts",           "/contacts",                   "bi-person-badge",        "Accounts"),
        new("Agreements",         "/agreements",                 "bi-file-earmark-check",  "Operations"),
        new("Engagements",        "/engagements",                "bi-briefcase",           "Operations"),
        new("Milestones",         "/ops/milestones",             "bi-flag",                "Operations"),
        new("Invoices",           "/invoices",                   "bi-receipt",             "Billing"),
        new("Time Entries",       "/timeentries",                "bi-clock",               "Billing"),
        new("Expenses",           "/expenses",                   "bi-credit-card",         "Billing"),
        new("Payments",           "/payments",                   "bi-cash-coin",           "Billing"),
        new("GL Accounts",        "/finance/glaccounts",         "bi-journals",            "Finance"),
        new("Journal Entries",    "/finance/journalentries",     "bi-journal-text",        "Finance"),
        new("Vendors",            "/finance/vendors",            "bi-truck",               "Finance"),
        new("Users",              "/users",                      "bi-people",              "Admin"),
        new("Roles",              "/roles",                      "bi-shield-check",        "Admin"),
        new("Preferences",        "/preferences",                "bi-sliders",             "Admin"),
    ];

    private List<SearchItem> GetResults()
    {
        if (string.IsNullOrWhiteSpace(_query)) return [];
        var q = _query.Trim();
        return _catalogue
            .Where(i =>
                i.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (i.Category?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false))
            .Concat(_recordResults)
            .DistinctBy(item => item.Url, StringComparer.OrdinalIgnoreCase)
            .Take(12)
            .ToList();
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        _selectedIdx = 0;
        _recordResults = [];
        _hasSearched = false;
        _searchError = null;
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _searchCancellation = null;
        _isSearching = false;
    }

    private async Task SearchRecordsAsync()
    {
        var normalizedQuery = _query.Trim();
        if (normalizedQuery.Length < 3)
        {
            _isSearching = false;
            _hasSearched = true;
            _searchError = null;
            return;
        }

        if (_quickSearchCache.TryGetValue(normalizedQuery, out var cached) && cached.ExpiresUtc > DateTimeOffset.UtcNow)
        {
            _recordResults = cached.Results.ToList();
            _isSearching = false;
            _hasSearched = true;
            _searchError = null;
            return;
        }

        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _searchCancellation = new CancellationTokenSource();
        var token = _searchCancellation.Token;
        _isSearching = true;
        _hasSearched = true;
        _searchError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var response = await Api.IntelligenceSearchAsync(new(Guid.Empty, Guid.Empty, normalizedQuery, null, null, 8, Guid.NewGuid().ToString("N"))
            {
                IncludeRelatedResults = false,
                IncludeAiSummary = false,
                IsQuickSearch = true
            }, token);
            if (token.IsCancellationRequested || !string.Equals(normalizedQuery, _query.Trim(), StringComparison.OrdinalIgnoreCase)) return;
            _recordResults = (response?.Results ?? [])
                .Where(result => !string.IsNullOrWhiteSpace(result.NavigationRoute))
                .Select(result => new SearchItem(
                    result.Title,
                    result.NavigationRoute!,
                    IconFor(result.EntityTypeCode),
                    $"Unified Intelligence · {result.ModuleCode} · {result.EntityTypeCode} · {result.CombinedScore:P0}"))
                .ToList();
            _quickSearchCache[normalizedQuery] = new(DateTimeOffset.UtcNow.AddSeconds(45), _recordResults.ToArray());
            TrimQuickSearchCache();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
            _recordResults = [];
            _searchError = "Search is temporarily unavailable.";
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _isSearching = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void TrimQuickSearchCache()
    {
        var now = DateTimeOffset.UtcNow;
        foreach (var key in _quickSearchCache.Where(pair => pair.Value.ExpiresUtc <= now).Select(pair => pair.Key).ToArray())
            _quickSearchCache.Remove(key);

        foreach (var key in _quickSearchCache.OrderByDescending(pair => pair.Value.ExpiresUtc).Skip(20).Select(pair => pair.Key).ToArray())
            _quickSearchCache.Remove(key);
    }

    private static string IconFor(string entityTypeCode) => entityTypeCode.ToUpperInvariant() switch
    {
        "ACCOUNT" => "bi-building",
        "CONTACT" => "bi-person-badge",
        "LEAD" => "bi-person-plus",
        "SUBMISSION" => "bi-folder2-open",
        "POLICY" => "bi-file-earmark-check",
        "CLAIM" => "bi-shield-exclamation",
        "DOCUMENT" => "bi-file-earmark-text",
        "CERTIFICATE" => "bi-award",
        "CARRIER" => "bi-bank",
        "LOCATION" => "bi-geo-alt",
        "VEHICLE" => "bi-truck-front",
        "CLAIMPARTY" => "bi-people",
        "COMMISSIONLINE" => "bi-cash-stack",
        _ => "bi-search"
    };

    // -- Keyboard navigation -----------------------------------
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        var results = GetResults();
        switch (e.Key)
        {
            case "ArrowDown":
                _selectedIdx = Math.Min(_selectedIdx + 1, results.Count - 1);
                break;
            case "ArrowUp":
                _selectedIdx = Math.Max(_selectedIdx - 1, 0);
                break;
            case "Enter" when _selectedIdx >= 0 && _selectedIdx < results.Count:
                Nav.NavigateTo(results[_selectedIdx].Url);
                Close();
                break;
            case "Enter":
                await SearchRecordsAsync();
                break;
            case "Escape":
                Close();
                break;
        }
    }

    private void Close()
    {
        _searchCancellation?.Cancel();
        Shell.CloseQuickSearch();
        _query       = string.Empty;
        _selectedIdx = 0;
        _recordResults = [];
        _hasSearched = false;
        _searchError = null;
        _isSearching = false;
    }

    // -- Called from AppQuickSearch.razor.js via DotNetObjectReference --------
    [JSInvokable]
    public void OpenFromJs()
    {
        Shell.OpenQuickSearch();
        InvokeAsync(StateHasChanged);
    }

    // -- Lifecycle ---------------------------------------------
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Layout/AppQuickSearch.razor.js");
            _dotnetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _dotnetRef);
        }

        if (Shell.QuickSearchOpen && !_prevOpen && _module is not null)
            await _module.InvokeVoidAsync("focus", "aqs-input");

        _prevOpen = Shell.QuickSearchOpen;
    }

    protected override void OnInitialized() => Shell.OnChange += OnShellChange;
    private void OnShellChange()            => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Shell.OnChange -= OnShellChange;
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _dotnetRef?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }
}
