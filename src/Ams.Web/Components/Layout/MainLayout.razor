@inherits LayoutComponentBase
@inject ShellStateService Shell
@inject IJSRuntime JS
@implements IDisposable

@* WCAG 2.4.1 - skip navigation *@
<a class="skip-link" href="#ams-main">Skip to main content</a>

<div class="ams-shell @(Shell.ThemeDark ? "theme-dark" : "")">
    <NavSidebar />
    <div class="ams-body">
        <TopHeader />
        <AppBreadcrumb />
        <main id="ams-main" class="ams-content" tabindex="-1">
            @Body
        </main>
    </div>
</div>

@* Global command-palette - rendered outside ams-shell so it always stacks above everything *@
<AppQuickSearch />
<AppConfirmDialog />
<CreateLeadDialog />

@* Mobile nav backdrop - click to dismiss *@
@if (Shell.MobileNavOpen)
{
    <div class="ams-overlay" @onclick="Shell.CloseMobileNav" aria-hidden="true"></div>
}

@code {
    private bool _prevDark;

    protected override void OnInitialized()  => Shell.OnChange += OnShellChange;
    private void OnShellChange()             => InvokeAsync(StateHasChanged);
    public  void Dispose()                   => Shell.OnChange -= OnShellChange;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || Shell.ThemeDark != _prevDark)
        {
            await JS.InvokeVoidAsync("amsShell.setTheme", Shell.ThemeDark);
            _prevDark = Shell.ThemeDark;
        }
    }
}

