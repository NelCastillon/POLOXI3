@inherits LayoutComponentBase
@inject ShellStateService Shell
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpContextAccessor
@implements IDisposable

@* WCAG 2.4.1 - skip navigation *@
<a class="skip-link" href="#ams-main">Skip to main content</a>

<div class="ams-shell @(Shell.ThemeDark ? "theme-dark" : "")">
    <NavSidebar />
    <div class="ams-body">
        <TopHeader />
        <AppBreadcrumb />
        <main id="ams-main" class="ams-content" tabindex="-1">
            @Body
        </main>
    </div>
</div>

@* Global command-palette - rendered outside ams-shell so it always stacks above everything *@
<AppQuickSearch />
<AppConfirmDialog />
<CreateLeadDialog />

@* Mobile nav backdrop - click to dismiss *@
@if (Shell.MobileNavOpen)
{
    <div class="ams-overlay" @onclick="Shell.CloseMobileNav" aria-hidden="true"></div>
}

@code {
    private bool _prevDark;
    private IJSObjectReference? _module;

    protected override void OnInitialized()
    {
        Shell.OnChange += OnShellChange;

        // Restore the persisted theme from the cookie so the very first render
        // (including prerender) is already in the right theme - no flash/twitch.
        var cookieTheme = HttpContextAccessor.HttpContext?.Request.Cookies["ams-theme"];
        if (cookieTheme == "dark" && !Shell.ThemeDark)
        {
            Shell.SetTheme(true);
        }

        _prevDark = Shell.ThemeDark;
    }

    private void OnShellChange()             => InvokeAsync(StateHasChanged);
    public  void Dispose()                   => Shell.OnChange -= OnShellChange;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Layout/MainLayout.razor.js");
            await _module.InvokeVoidAsync("init");
        }

        if (_module is not null && (firstRender || Shell.ThemeDark != _prevDark))
        {
            await _module.InvokeVoidAsync("applyTheme", Shell.ThemeDark);
            _prevDark = Shell.ThemeDark;
        }
    }
}

