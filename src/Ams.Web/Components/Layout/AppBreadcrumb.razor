@*
    AppBreadcrumb - renders the current-page breadcrumb trail populated by BreadcrumbService.
    Collapses automatically when no crumbs are set (pages that don't call SetCrumbs).

    Usage (from a page's OnInitialized / OnParametersSetAsync):
        Breadcrumbs.SetCrumbs(
            new("Home",  "/",       "bi-house"),
            new("Users", "/users",  "bi-people"),
            new("Alice Smith"));    // last item = current page - omit Url
*@

@inject BreadcrumbService Breadcrumbs
@implements IDisposable

@if (Breadcrumbs.Crumbs.Count > 0)
{
    <nav class="app-breadcrumb" aria-label="Breadcrumb">
        <ol class="abc-list">
            @{
                var crumbs = Breadcrumbs.Crumbs;
                for (var i = 0; i < crumbs.Count; i++)
                {
                    var crumb  = crumbs[i];
                    var isLast = i == crumbs.Count - 1;

                    <li class="abc-item @(isLast ? "is-current" : "")">
                        @if (!isLast && crumb.Url is not null)
                        {
                            <a class="abc-link" href="@crumb.Url">
                                @if (!string.IsNullOrEmpty(crumb.Icon))
                                {
                                    <i class="bi @crumb.Icon" aria-hidden="true"></i>
                                }
                                @crumb.Label
                            </a>
                        }
                        else
                        {
                            <span class="abc-current" aria-current="@(isLast ? "page" : null)">
                                @if (!string.IsNullOrEmpty(crumb.Icon))
                                {
                                    <i class="bi @crumb.Icon" aria-hidden="true"></i>
                                }
                                @crumb.Label
                            </span>
                        }

                        @if (!isLast)
                        {
                            <i class="bi bi-chevron-right abc-sep" aria-hidden="true"></i>
                        }
                    </li>
                }
            }
        </ol>
    </nav>
}

@code {
    protected override void OnInitialized() => Breadcrumbs.OnChange += OnCrumbsChange;
    private void OnCrumbsChange()           => InvokeAsync(StateHasChanged);
    public  void Dispose()                  => Breadcrumbs.OnChange -= OnCrumbsChange;
}
