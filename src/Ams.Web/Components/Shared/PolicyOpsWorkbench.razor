@namespace Ams.Web.Components.Shared
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.PolicyLifecycle
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@Title - AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4500" NewestOnTop="true" />

<AppPageHeader Title="@Title" Subtitle="@Subtitle" Icon="@Icon">
    <Actions>
        <a class="um-btn um-btn-ghost" href="/policies"><i class="bi bi-shield-check"></i> Policies</a>
        <a class="um-btn um-btn-ghost" href="/policies/documents"><i class="bi bi-folder2"></i> Documents</a>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "ad-spin" : "")"></i> Refresh</button>
        <button class="um-btn um-btn-primary" @onclick="PrimaryActionAsync"><i class="bi @PrimaryIcon"></i> @PrimaryText</button>
    </Actions>
</AppPageHeader>

<section class="polw-hero">
    <div>
        <span class="polw-eyebrow">@Eyebrow</span>
        <h2>@HeroTitle</h2>
        <p>@HeroText</p>
    </div>
    <div class="polw-hero-actions">
        <a class="um-btn um-btn-ghost" href="/policies/endorsements"><i class="bi bi-pen"></i> Endorsements</a>
        <a class="um-btn um-btn-ghost" href="/policies/cancellations"><i class="bi bi-x-circle"></i> Cancellations</a>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button>
    </div>
</section>

<div class="polw-kpi-strip">
    @Kpi("bi-stack", "Total", FilterSource.Count().ToString(), TotalValue, "polw-kpi-total", null)
    @Kpi(Kpi1Icon, Kpi1Label, CountBy(Kpi1Filter).ToString(), Kpi1Title, "polw-kpi-active", Kpi1Filter)
    @Kpi(Kpi2Icon, Kpi2Label, CountBy(Kpi2Filter).ToString(), Kpi2Title, "polw-kpi-warning", Kpi2Filter)
    @Kpi(Kpi3Icon, Kpi3Label, CountBy(Kpi3Filter).ToString(), Kpi3Title, "polw-kpi-danger", Kpi3Filter)
    @Kpi("bi-calendar-event", "Due Soon", FilterSource.Count(IsDueSoon).ToString(), "Requires attention", "polw-kpi-risk", "due")
    @Kpi("bi-cash-stack", "Premium", FilterSource.Sum(x => x.Amount).ToString("C0"), "Financial impact", "polw-kpi-prem", "premium")
</div>

<div class="polw-command-bar">
    <div class="polw-search-wrap"><i class="bi bi-search"></i><input @bind="_search" @bind:event="oninput" placeholder="@SearchPlaceholder" /></div>
    <select class="polw-filter-sel" @bind="_statusFilter"><option value="">All status</option>@foreach (var v in StatusValues) { <option>@v</option> }</select>
    <select class="polw-filter-sel" @bind="_typeFilter"><option value="">All types</option>@foreach (var v in TypeValues) { <option>@v</option> }</select>
    <select class="polw-filter-sel" @bind="_ownerFilter"><option value="">All owners</option>@foreach (var v in OwnerValues) { <option>@v</option> }</select>
    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button>
    <span class="polw-filter-count">@Filtered.Count() item(s)</span>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError
    </div>
}

@if (_loading)
{
    <div class="mt-loading"><div class="um-spinner"></div><span>Loading @Title.ToLowerInvariant()...</span></div>
}

<div class="polw-workbench">
    <div class="polw-feed">
        @foreach (var group in Groups)
        {
            <div class="polw-date-sep"><span>@group.Label</span></div>
            @foreach (var row in group.Items)
            {
                <article class="polw-item @(_selected?.Id == row.Id ? "polw-item-selected" : null) @(IsRisk(row) ? "polw-item-risk" : null)" @onclick="() => Select(row)">
                    <div class="polw-icon @IconClass"><i class="bi @ItemIcon"></i></div>
                    <div class="polw-body">
                        <div class="polw-hdr">
                            <strong>@row.Number</strong>
                            <span class="polw-chip polw-chip-status">@row.Status</span>
                            <span class="polw-chip polw-chip-type">@row.Type</span>
                            @if (IsDueSoon(row)) { <span class="polw-risk">Due soon</span> }
                        </div>
                        <div class="polw-title">@row.Title</div>
                        <div class="polw-meta">
                            <span><i class="bi bi-building"></i> @row.Account</span>
                            <span><i class="bi bi-broadcast"></i> @row.Carrier</span>
                            <span><i class="bi bi-person"></i> @row.Owner</span>
                            <span><i class="bi bi-calendar3"></i> @row.Date.ToString("MMM d")</span>
                            <span><i class="bi bi-cash-stack"></i> @row.Amount.ToString("C0")</span>
                        </div>
                    </div>
                    <div class="polw-actions" @onclick:stopPropagation="true">
                        <button class="um-btn um-btn-ghost um-btn-xs" title="Open" @onclick="() => Open(row)"><i class="bi bi-arrow-right"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" title="Review lifecycle history" @onclick="() => Review(row)"><i class="bi bi-eye"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" title="@AdvanceTitle(row)" disabled="@(row.PolicyTransactionId is null || string.IsNullOrWhiteSpace(row.NextStatusCode))" @onclick="() => AdvanceAsync(row)"><i class="bi @AdvanceIcon(row)"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" title="Document" @onclick="() => DocumentAsync(row)"><i class="bi bi-folder2"></i></button>
                    </div>
                </article>
            }
        }
        @if (!Filtered.Any())
        {
            <div class="polw-empty"><i class="bi @ItemIcon"></i><span>No records match the current filters.</span></div>
        }
    </div>

    @if (_selected is not null)
    {
        <aside class="polw-detail-panel">
            <div class="polw-detail-header">
                <span class="polw-chip polw-chip-status">@_selected.Status</span>
                <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _selected = null"><i class="bi bi-x-lg"></i></button>
            </div>
            <h3>@_selected.Number</h3>
            <p>@_selected.Title</p>
            <div class="polw-detail-grid">
                <div><span>Account</span><strong>@_selected.Account</strong></div>
                <div><span>Carrier</span><strong>@_selected.Carrier</strong></div>
                <div><span>Type</span><strong>@_selected.Type</strong></div>
                <div><span>Status</span><strong>@_selected.Status</strong></div>
                <div><span>Date</span><strong>@_selected.Date.ToString("d")</strong></div>
                <div><span>Amount</span><strong>@_selected.Amount.ToString("C0")</strong></div>
                <div><span>Owner</span><strong>@_selected.Owner</strong></div>
                <div><span>Branch</span><strong>@_selected.Branch</strong></div>
            </div>
            <div class="polw-detail-actions">
                <button class="um-btn um-btn-primary" @onclick="() => Open(_selected)"><i class="bi bi-arrow-right"></i> Open</button>
                <button class="um-btn um-btn-ghost" @onclick="() => Review(_selected)"><i class="bi bi-eye"></i> Review History</button>
                <button class="um-btn um-btn-ghost" disabled="@(_selected.PolicyTransactionId is null || string.IsNullOrWhiteSpace(_selected.NextStatusCode))" @onclick="() => AdvanceAsync(_selected)"><i class="bi @AdvanceIcon(_selected)"></i> @AdvanceLabel(_selected)</button>
                <button class="um-btn um-btn-ghost" @onclick="() => DocumentAsync(_selected)"><i class="bi bi-folder2"></i> Documents</button>
            </div>
        </aside>
    }
</div>

@code {
    [Parameter] public string Mode { get; set; } = "policies";

    EnterpriseToast? _toast;
    Guid _tenantId;
    bool _loading;
    string? _loadError;
    string _search = string.Empty;
    string _statusFilter = string.Empty;
    string _typeFilter = string.Empty;
    string _ownerFilter = string.Empty;
    string _activeFilter = string.Empty;
    PolicyWorkRow? _selected;
    readonly List<PolicyWorkRow> _rows = [];

    IEnumerable<PolicyWorkRow> FilterSource => _rows.Where(x => x.Mode == ModeKey);
    IEnumerable<PolicyWorkRow> Filtered => FilterSource.Where(x => MatchesKpi(x)
        && (string.IsNullOrEmpty(_statusFilter) || x.Status == _statusFilter)
        && (string.IsNullOrEmpty(_typeFilter) || x.Type == _typeFilter)
        && (string.IsNullOrEmpty(_ownerFilter) || x.Owner == _ownerFilter)
        && (string.IsNullOrEmpty(_search) || x.Number.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Account.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Carrier.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Type.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase))).OrderBy(x => x.Date);
    IEnumerable<Group<PolicyWorkRow>> Groups => Filtered.GroupBy(x => x.Status).OrderBy(g => StatusOrder(g.Key)).Select(g => new Group<PolicyWorkRow>(g.Key, g.ToList()));
    string[] StatusValues => FilterSource.Select(x => x.Status).Distinct().OrderBy(StatusOrder).ToArray();
    string[] TypeValues => FilterSource.Select(x => x.Type).Distinct().Order().ToArray();
    string[] OwnerValues => FilterSource.Select(x => x.Owner).Distinct().Order().ToArray();

    string ModeKey => Mode.Trim().ToLowerInvariant();
    string Title => ModeKey switch { "endorsements" => "Endorsement Workbench", "cancellations" => "Cancellation Center", "policy-documents" => "Policy Documents", "compliance-policies" => "Compliance Policies", "acknowledgements" => "Policy Acknowledgements", _ => "Policies Workbench" };
    string Subtitle => ModeKey switch { "endorsements" => "Review, approve, issue, and track policy change requests", "cancellations" => "Manage cancellations, reinstatements, return premium, and rescission", "policy-documents" => "Manage policy forms, endorsements, binders, certificates, and declarations", "compliance-policies" => "Create, publish, retire, and govern compliance policy documents", "acknowledgements" => "Track pending, overdue, and completed policy acknowledgements", _ => "Complete policy lifecycle workbench for active, expiring, renewal, and premium activity" };
    string Icon => ModeKey switch { "endorsements" => "bi-pen-fill", "cancellations" => "bi-x-circle-fill", "policy-documents" => "bi-folder2-open", "compliance-policies" => "bi-patch-check-fill", "acknowledgements" => "bi-check2-circle", _ => "bi-shield-check-fill" };
    string ItemIcon => ModeKey switch { "endorsements" => "bi-pen-fill", "cancellations" => "bi-x-circle-fill", "policy-documents" => "bi-folder2-open", "compliance-policies" => "bi-file-earmark-check-fill", "acknowledgements" => "bi-check2-circle", _ => "bi-shield-check-fill" };
    string IconClass => ModeKey == "cancellations" ? "polw-icon-danger" : ModeKey == "acknowledgements" ? "polw-icon-success" : string.Empty;
    string Eyebrow => ModeKey switch { "compliance-policies" or "acknowledgements" => "Compliance Governance", "policy-documents" => "Policy Document Control", _ => "Policy Operations" };
    string HeroTitle => ModeKey switch { "endorsements" => "Policy Change Desk", "cancellations" => "Cancellation & Reinstatement Desk", "policy-documents" => "Policy Document Library", "compliance-policies" => "Compliance Policy Library", "acknowledgements" => "Acknowledgement Tracking Desk", _ => "Policy Lifecycle Desk" };
    string HeroText => "Search, filter, triage, and act on policy operations using a workbench layout with KPI-driven views, operational queues, and detail context.";
    string PrimaryText => ModeKey switch { "endorsements" => "New Endorsement", "cancellations" => "Request Cancellation", "policy-documents" => "Upload Document", "compliance-policies" => "New Policy", "acknowledgements" => "Send Reminder", _ => "New Policy" };
    string PrimaryIcon => ModeKey switch { "cancellations" => "bi-x-circle", "policy-documents" => "bi-upload", "acknowledgements" => "bi-send", _ => "bi-plus-lg" };
    string SearchPlaceholder => ModeKey switch { "acknowledgements" => "Search user, policy, department, acknowledgement status...", "policy-documents" => "Search document, policy number, category, uploader...", "compliance-policies" => "Search policy code, title, owner, status...", _ => "Search policy number, account, carrier, LOB, owner..." };
    string TotalValue => ModeKey switch { "acknowledgements" => $"{FilterSource.Count(x => x.Status == "Acknowledged")} done", _ => FilterSource.Sum(x => x.Amount).ToString("C0") };
    string Kpi1Label => ModeKey switch { "cancellations" => "Pending", "acknowledgements" => "Pending", "compliance-policies" => "Draft", _ => "Active" };
    string Kpi1Filter => ModeKey switch { "cancellations" => "status:Pending", "acknowledgements" => "status:Pending", "compliance-policies" => "status:Draft", _ => "status:Active" };
    string Kpi1Title => "Primary active queue";
    string Kpi1Icon => ModeKey switch { "acknowledgements" => "bi-hourglass-split", "compliance-policies" => "bi-pencil", _ => "bi-shield-check" };
    string Kpi2Label => ModeKey switch { "endorsements" => "Pending", "cancellations" => "Cancelled", "acknowledgements" => "Overdue", "compliance-policies" => "Published", _ => "Expiring" };
    string Kpi2Filter => ModeKey switch { "endorsements" => "status:Pending", "cancellations" => "status:Cancelled", "acknowledgements" => "status:Overdue", "compliance-policies" => "status:Published", _ => "due" };
    string Kpi2Title => "Attention queue";
    string Kpi2Icon => ModeKey switch { "cancellations" => "bi-x-circle", "acknowledgements" => "bi-exclamation-circle", "compliance-policies" => "bi-check-circle", _ => "bi-clock" };
    string Kpi3Label => ModeKey switch { "endorsements" => "Declined", "cancellations" => "Reinstated", "acknowledgements" => "Acknowledged", "compliance-policies" => "Retired", _ => "Lapsed" };
    string Kpi3Filter => ModeKey switch { "endorsements" => "status:Declined", "cancellations" => "status:Reinstated", "acknowledgements" => "status:Acknowledged", "compliance-policies" => "status:Retired", _ => "status:Lapsed" };
    string Kpi3Title => "Closed or exception state";
    string Kpi3Icon => ModeKey switch { "cancellations" => "bi-arrow-counterclockwise", "acknowledgements" => "bi-check2-circle", "compliance-policies" => "bi-archive", _ => "bi-exclamation-triangle" };

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policies", "/policies"), new(Title, CurrentUrl));
        await LoadAsync();
    }

    string CurrentUrl => ModeKey switch { "endorsements" => "/policies/endorsements", "cancellations" => "/policies/cancellations", "policy-documents" => "/policies/documents", "compliance-policies" => "/compliance/policies", "acknowledgements" => "/compliance/acknowledgements", _ => "/policies" };

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            if (_tenantId == Guid.Empty)
            {
                await ResolveCurrentUserContextAsync();
            }

            var rows = await Api.GetPolicyLifecycleWorkbenchAsync(_tenantId, ModeKey) ?? [];
            _rows.Clear();
            _rows.AddRange(rows.Select(ToWorkRow));
            _selected = _selected is null ? Filtered.FirstOrDefault() : Filtered.FirstOrDefault(x => x.Id == _selected.Id) ?? Filtered.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Title = Title, Content = $"Load failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
        }
        finally
        {
            _loading = false;
        }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
    }

    bool MatchesKpi(PolicyWorkRow x) => _activeFilter switch
    {
        "due" => IsDueSoon(x),
        "premium" => x.Amount > 0,
        _ when _activeFilter.StartsWith("status:") => x.Status == _activeFilter[7..],
        _ => true
    };

    int CountBy(string filter)
    {
        var previous = _activeFilter;
        _activeFilter = filter;
        var count = FilterSource.Count(MatchesKpi);
        _activeFilter = previous;
        return count;
    }

    void ResetFilters() { _search = _statusFilter = _typeFilter = _ownerFilter = _activeFilter = string.Empty; }
    void SetFilter(string? filter) => _activeFilter = _activeFilter == (filter ?? string.Empty) ? string.Empty : filter ?? string.Empty;
    void Select(PolicyWorkRow row) => _selected = row;
    void Open(PolicyWorkRow row) => Nav.NavigateTo(ModeKey is "policy-documents" or "compliance-policies" ? "/policies/documents" : $"/policies/{row.PolicyId}");
    void Review(PolicyWorkRow row) => Nav.NavigateTo($"/policies/{row.PolicyId}/versions");
    Task PrimaryActionAsync() => ToastAsync($"{PrimaryText} started.");
    Task DocumentAsync(PolicyWorkRow row) { Nav.NavigateTo("/policies/documents"); return Task.CompletedTask; }
    async Task ToastAsync(string message) { if (_toast is not null) await _toast.ShowAsync(new ToastModel { Title = Title, Content = message, CssClass = "enterprise-toast-success" }); }

    async Task AdvanceAsync(PolicyWorkRow row)
    {
        if (row.PolicyTransactionId is null || string.IsNullOrWhiteSpace(row.NextStatusCode))
        {
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Title = Title, Content = "No further lifecycle transition is configured for this record.", CssClass = "enterprise-toast-danger" });
            return;
        }

        if (row.NextTransitionRequiresDocument && row.DocumentCount == 0)
        {
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Title = Title, Content = $"{AdvanceLabel(row)} requires a linked policy transaction document.", CssClass = "enterprise-toast-danger" });
            return;
        }

        try
        {
            var context = await CurrentUser.RequireAsync();
            await Api.TransitionPolicyLifecycleTransactionAsync(row.PolicyTransactionId.Value, new TransitionPolicyLifecycleTransactionRequest
            {
                TenantId = _tenantId,
                ToStatusCode = row.NextStatusCode,
                ChangedByUserId = context.UserId == Guid.Empty ? null : context.UserId,
                Notes = $"Advanced from the {Title}."
            });
            await LoadAsync();
            await ToastAsync($"{row.Number} advanced to {row.NextStatusDisplayName ?? row.NextStatusCode}.");
        }
        catch (Exception ex)
        {
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Title = Title, Content = $"Transition failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
        }
    }

    static string AdvanceLabel(PolicyWorkRow row) => string.IsNullOrWhiteSpace(row.NextStatusDisplayName) ? "No Next Action" : row.NextStatusDisplayName;
    static string AdvanceTitle(PolicyWorkRow row) => string.IsNullOrWhiteSpace(row.NextStatusDisplayName) ? "No configured next transition" : $"Advance to {row.NextStatusDisplayName}";
    static string AdvanceIcon(PolicyWorkRow row) => row.NextStatusCode switch { "PendingReview" => "bi-eye", "Approved" => "bi-check-circle", "Issued" => "bi-file-earmark-check", "Completed" => "bi-check2-all", _ => "bi-arrow-right-circle" };

    static PolicyWorkRow ToWorkRow(PolicyLifecycleWorkbenchRowDto row) => new()
    {
        Id = row.PolicyTransactionId ?? row.PolicyId,
        PolicyId = row.PolicyId,
        PolicyTransactionId = row.PolicyTransactionId,
        Mode = row.Mode,
        Number = row.Number,
        Title = row.Title,
        Account = row.Account,
        Carrier = row.Carrier,
        Owner = row.Owner,
        Branch = row.Branch,
        Type = row.Type,
        Status = row.Status,
        Date = row.Date,
        Amount = row.Amount,
        DocumentCount = row.DocumentCount,
        NextStatusCode = row.NextStatusCode,
        NextStatusDisplayName = row.NextStatusDisplayName,
        NextTransitionRequiresDocument = row.NextTransitionRequiresDocument,
        NextTransitionRequiresApproval = row.NextTransitionRequiresApproval
    };

    bool IsDueSoon(PolicyWorkRow row) => row.Date.Date <= DateTime.Today.AddDays(30) && row.Status is not "Retired" and not "Acknowledged" and not "Cancelled";
    static bool IsRisk(PolicyWorkRow row) => row.Date.Date < DateTime.Today && row.Status is not "Acknowledged" and not "Retired";
    static int StatusOrder(string status) => status switch { "Active" => 1, "Pending" => 2, "Draft" => 3, "Published" => 4, "Issued" => 5, "Acknowledged" => 6, "Cancelled" => 7, "Reinstated" => 8, "Declined" => 9, "Retired" => 10, "Lapsed" => 11, "Overdue" => 12, _ => 99 };

    RenderFragment Kpi(string icon, string label, string value, string title, string css, string? filter) => @<button class="polw-kpi-card @css @(_activeFilter == (filter ?? string.Empty) ? "polw-kpi-active" : "")" title="@title" @onclick="() => SetFilter(filter)"><div class="polw-kpi-val">@value</div><div class="polw-kpi-lbl"><i class="bi @icon"></i> @label</div><small>@title</small></button>;

    sealed record Group<T>(string Label, List<T> Items);
    sealed class PolicyWorkRow
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public Guid PolicyId { get; set; }
        public Guid? PolicyTransactionId { get; set; }
        public string Mode { get; set; } = string.Empty;
        public string Number { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Account { get; set; } = string.Empty;
        public string Carrier { get; set; } = string.Empty;
        public string Owner { get; set; } = string.Empty;
        public string Branch { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public DateTime Date { get; set; }
        public decimal Amount { get; set; }
        public int DocumentCount { get; set; }
        public string? NextStatusCode { get; set; }
        public string? NextStatusDisplayName { get; set; }
        public bool NextTransitionRequiresDocument { get; set; }
        public bool NextTransitionRequiresApproval { get; set; }
    }
}
