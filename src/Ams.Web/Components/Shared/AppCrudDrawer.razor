@*
    AppCrudDrawer - right-side native drawer panel for create / edit forms.
    Provides a standard header (icon + title + close), scrollable body, and sticky footer.

    Usage:
        <AppCrudDrawer @bind-Visible="_showDrawer" Title="Create Role" Icon="bi-plus-circle"
                       OnConfirm="SaveAsync" IsBusy="_saving">
            <Content>
                <div class="form-row">...</div>
            </Content>
        </AppCrudDrawer>

    Override the footer completely with the Footer slot when custom buttons are needed.
*@

@inject IJSRuntime JS

@if (_visible)
{
    <div class="acd-backdrop" @onclick="Close">
        <aside class="acd-panel" style="width:@Width" @onclick:stopPropagation="true">
        <div class="acd-wrap" data-acd-id="@_drawerId">

            <!-- Header -->
            <div class="acd-header">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <span class="acd-header-icon" aria-hidden="true">
                        <i class="bi @Icon"></i>
                    </span>
                }
                <h2 class="acd-title">@Title</h2>
                <button class="acd-close" @onclick="Close" aria-label="Close drawer">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="acd-body">
                @Content
            </div>

            <!-- Footer -->
            <div class="acd-footer">
                @if (Footer is not null)
                {
                    @Footer
                }
                else
                {
                    <button type="button" class="um-btn um-btn-ghost" @onclick="Close" disabled="@IsBusy">@CancelText</button>
                    <button type="button" class="um-btn um-btn-primary" @onclick="ConfirmAsync" disabled="@IsBusy">
                        @if (IsBusy) { <span class="um-spin" aria-hidden="true"></span> }
                        @ConfirmText
                    </button>
                }
            </div>

        </div>
        </aside>
    </div>
}

@code {
    private bool _visible;
    private readonly string _drawerId = $"acd-{Guid.NewGuid():N}";

    [Parameter]
    public bool Visible
    {
        get => _visible;
        set
        {
            if (_visible != value)
            {
                _visible = value;
                StateHasChanged();
            }
        }
    }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public string  Title       { get; set; } = string.Empty;

    /// <summary>Bootstrap Icon class, e.g. "bi-plus-circle".</summary>
    [Parameter] public string? Icon        { get; set; }

    /// <summary>Drawer panel width. Default: 520px.</summary>
    [Parameter] public string  Width       { get; set; } = "520px";

    [Parameter] public bool    IsBusy      { get; set; }
    [Parameter] public string  ConfirmText { get; set; } = "Save";
    [Parameter] public string  CancelText  { get; set; } = "Cancel";

    /// <summary>Form content rendered in the scrollable body area.</summary>
    [Parameter] public RenderFragment? Content { get; set; }

    /// <summary>Replaces the default Cancel + Save footer buttons when provided.</summary>
    [Parameter] public RenderFragment? Footer  { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnClose   { get; set; }

    protected override void OnParametersSet()
    {
        _visible = Visible;
    }

    private async Task Close()
    {
        _visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
        StateHasChanged();
    }

    private async Task ConfirmAsync()
    {
        var submittedForm = false;

        try
        {
            submittedForm = await JS.InvokeAsync<bool>("eval", $"(() => {{ const form = document.querySelector('[data-acd-id=\"{_drawerId}\"] form'); if (!form) return false; if (typeof form.requestSubmit === 'function') {{ form.requestSubmit(); }} else {{ form.dispatchEvent(new Event('submit', {{ bubbles: true, cancelable: true }})); }} return true; }})()");
        }
        catch
        {
            submittedForm = false;
        }

        if (!submittedForm)
            await OnConfirm.InvokeAsync();
    }
}
