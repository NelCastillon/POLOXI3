@*
    AppCrudDrawer — right-side SfSidebar panel for create / edit forms.
    Provides a standard header (icon + title + close), scrollable body, and sticky footer.

    Usage:
        <AppCrudDrawer @bind-Visible="_showDrawer" Title="Create Role" Icon="bi-plus-circle"
                       OnConfirm="SaveAsync" IsBusy="_saving">
            <Content>
                <div class="form-row">...</div>
            </Content>
        </AppCrudDrawer>

    Override the footer completely with the Footer slot when custom buttons are needed.
*@

<SfSidebar Width="@Width"
           Position="SidebarPosition.Right"
           Type="SidebarType.Over"
           IsOpen="_visible"
           ShowBackdrop="true"
           EnableGestures="false">
    <ChildContent>
        <div class="acd-wrap">

            <!-- Header -->
            <div class="acd-header">
                @if (!string.IsNullOrEmpty(Icon))
                {
                    <span class="acd-header-icon" aria-hidden="true">
                        <i class="bi @Icon"></i>
                    </span>
                }
                <h2 class="acd-title">@Title</h2>
                <button class="acd-close" @onclick="Close" aria-label="Close drawer">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="acd-body">
                @Content
            </div>

            <!-- Footer -->
            <div class="acd-footer">
                @if (Footer is not null)
                {
                    @Footer
                }
                else
                {
                    <button class="um-btn um-btn-ghost" @onclick="Close" disabled="@IsBusy">@CancelText</button>
                    <button class="um-btn um-btn-primary" @onclick="ConfirmAsync" disabled="@IsBusy">
                        @if (IsBusy) { <span class="um-spin" aria-hidden="true"></span> }
                        @ConfirmText
                    </button>
                }
            </div>

        </div>
    </ChildContent>
</SfSidebar>

@code {
    private bool _visible;

    [Parameter]
    public bool Visible
    {
        get => _visible;
        set => _visible = value;
    }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public string  Title       { get; set; } = string.Empty;

    /// <summary>Bootstrap Icon class, e.g. "bi-plus-circle".</summary>
    [Parameter] public string? Icon        { get; set; }

    /// <summary>Drawer panel width. Default: 520px.</summary>
    [Parameter] public string  Width       { get; set; } = "520px";

    [Parameter] public bool    IsBusy      { get; set; }
    [Parameter] public string  ConfirmText { get; set; } = "Save";
    [Parameter] public string  CancelText  { get; set; } = "Cancel";

    /// <summary>Form content rendered in the scrollable body area.</summary>
    [Parameter] public RenderFragment? Content { get; set; }

    /// <summary>Replaces the default Cancel + Save footer buttons when provided.</summary>
    [Parameter] public RenderFragment? Footer  { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnClose   { get; set; }

    protected override void OnParametersSet() => _visible = Visible;

    private async Task Close()
    {
        _visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnClose.InvokeAsync();
    }

    private async Task ConfirmAsync() => await OnConfirm.InvokeAsync();
}
