@*
    AppDetailTabs — standard AMS SfTab wrapper with dynamic content loading and scrollable overflow.
    Wrap your <TabItem> elements in the Tabs slot.

    Usage:
        <AppDetailTabs @bind-SelectedTab="_tab">
            <Tabs>
                <TabItem>
                    <ChildContent><TabHeader Text="Profile" IconCss="bi bi-person" /></ChildContent>
                    <ContentTemplate><MyProfileTab ... /></ContentTemplate>
                </TabItem>
            </Tabs>
        </AppDetailTabs>
*@

<div class="app-tabs-card">
    <SfTab @bind-SelectedItem="SelectedTab"
           LoadOn="ContentLoad.Dynamic"
           OverflowMode="OverflowMode.Scrollable">
        <TabItems>
            @Tabs
        </TabItems>
    </SfTab>
</div>

@code {
    [Parameter] public int SelectedTab { get; set; }
    [Parameter] public EventCallback<int> SelectedTabChanged { get; set; }

    /// <summary>One or more &lt;TabItem&gt; elements.</summary>
    [Parameter] public RenderFragment? Tabs { get; set; }
}
