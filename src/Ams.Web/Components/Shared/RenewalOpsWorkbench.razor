@namespace Ams.Web.Components.Shared
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@Title — AMS</PageTitle>
<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4500" NewestOnTop="true" />

<AppPageHeader Title="@Title" Subtitle="@Subtitle" Icon="@Icon">
    <Actions>
        <a class="um-btn um-btn-ghost" href="/renewals"><i class="bi bi-grid"></i> Dashboard</a>
        <a class="um-btn um-btn-ghost" href="/renewals/pipeline"><i class="bi bi-funnel"></i> Pipeline</a>
        <a class="um-btn um-btn-ghost" href="/renewals/activities"><i class="bi bi-lightning"></i> Activities</a>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "ad-spin" : "")"></i> Refresh</button>
        <button class="um-btn um-btn-primary" @onclick="PrimaryActionAsync"><i class="bi @PrimaryIcon"></i> @PrimaryText</button>
    </Actions>
</AppPageHeader>

<section class="rnw-hero">
    <div>
        <span class="rnw-eyebrow">@Eyebrow</span>
        <h2>@HeroTitle</h2>
        <p>@HeroText</p>
    </div>
    <div class="rnw-hero-actions">
        <a class="um-btn um-btn-ghost" href="/renewals/risk"><i class="bi bi-shield-exclamation"></i> Risk</a>
        <a class="um-btn um-btn-ghost" href="/renewals/remarketing"><i class="bi bi-megaphone"></i> Remarketing</a>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button>
    </div>
</section>

<div class="rnw-kpi-strip">
    @Kpi("bi-stack", "Total", FilterSource.Count().ToString(), PremiumAtStake.ToString("C0"), "rnw-kpi-total", null)
    @Kpi("bi-hourglass", "Not Started", CountStage("Not Started").ToString(), "Renewal not started", "rnw-kpi-new", "stage:Not Started")
    @Kpi("bi-arrow-clockwise", "In Progress", CountStage("In Progress").ToString(), "Active renewal work", "rnw-kpi-progress", "stage:In Progress")
    @Kpi("bi-quote", "Quoted", CountStage("Quoted").ToString(), "Quoted renewals", "rnw-kpi-quoted", "stage:Quoted")
    @Kpi("bi-check-circle", "Renewed", CountStage("Renewed").ToString(), RetentionRate, "rnw-kpi-renewed", "stage:Renewed")
    @Kpi("bi-exclamation-triangle", "Urgent", FilterSource.Count(IsUrgent).ToString(), "Expiring within 30 days or overdue task", "rnw-kpi-risk", "urgent")
</div>

<div class="rnw-command-bar">
    <div class="rnw-search-wrap"><i class="bi bi-search"></i><input @bind="_search" @bind:event="oninput" placeholder="@SearchPlaceholder" /></div>
    <select class="rnw-filter-sel" @bind="_stageFilter"><option value="">All stages</option>@foreach (var v in StageValues) { <option>@v</option> }</select>
    <select class="rnw-filter-sel" @bind="_lobFilter"><option value="">All lines</option>@foreach (var v in LobValues) { <option>@v</option> }</select>
    <select class="rnw-filter-sel" @bind="_producerFilter"><option value="">All producers</option>@foreach (var v in ProducerValues) { <option>@v</option> }</select>
    <select class="rnw-filter-sel" @bind="_daysFilter"><option value="0">All expiries</option><option value="30">30 days</option><option value="60">60 days</option><option value="90">90 days</option><option value="120">120 days</option></select>
    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button>
    <span class="rnw-filter-count">@Filtered.Count() item(s)</span>
</div>

@if (_loading)
{
    <div class="mt-loading"><div class="um-spinner"></div><span>Loading @Title.ToLowerInvariant()…</span></div>
}

@if (ModeKey == "pipeline")
{
    <div class="rnw-board-layout">
        <div class="rnw-board-scroll">
            @foreach (var stage in Stages)
            {
                var cards = Filtered.Where(x => x.Stage == stage).OrderBy(x => x.DaysToExpiry).ToList();
                <section class="rnw-lane">
                    <div class="rnw-lane-hdr"><div><span class="rnw-chip rnw-chip-stage">@stage</span><small>@cards.Count renewals • @cards.Sum(x => x.CurrentPremium).ToString("C0")</small></div><button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => SetStageFilter(stage)"><i class="bi bi-funnel"></i></button></div>
                    <div class="rnw-card-list">
                        @if (cards.Count == 0) { <div class="rnw-empty-mini">No renewals</div> }
                        @foreach (var row in cards)
                        {
                            <article class="rnw-work-card @(_selected?.Id == row.Id ? "rnw-work-card--selected" : null) @(IsUrgent(row) ? "rnw-work-card--risk" : null)" @onclick="() => Select(row)">
                                <div class="rnw-work-top"><span class="rnw-chip rnw-chip-stage">@row.Stage</span><span class="rnw-risk-pill" style="background:@RiskColor(row.RetentionRiskScore)">@row.RetentionRiskScore</span></div>
                                <strong>@row.AccountName</strong><p>@row.PolicyNumber • @row.Lob</p>
                                <div class="rnw-work-meta"><span><i class="bi bi-calendar3"></i> @DaysLabel(row.DaysToExpiry)</span><span><i class="bi bi-cash-stack"></i> @row.CurrentPremium.ToString("C0")</span></div>
                                <div class="rnw-card-actions" @onclick:stopPropagation="true"><button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => Open(row)"><i class="bi bi-arrow-right"></i></button><button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => MoveNextAsync(row)"><i class="bi bi-arrow-right-circle"></i></button><button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => LogActivityAsync(row)"><i class="bi bi-lightning"></i></button></div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>
        @DetailPanel()
    </div>
}
else
{
    <div class="rnw-workbench">
        <div class="rnw-feed">
            @foreach (var group in Groups)
            {
                <div class="rnw-date-sep"><span>@group.Label</span></div>
                @foreach (var row in group.Items)
                {
                    <article class="rnw-item @(_selected?.Id == row.Id ? "rnw-item-selected" : null) @(IsUrgent(row) ? "rnw-item-risk" : null)" @onclick="() => Select(row)">
                        <div class="rnw-icon @IconClass"><i class="bi @ItemIcon"></i></div>
                        <div class="rnw-body">
                            <div class="rnw-hdr"><strong>@row.DisplayNumber</strong><span class="rnw-chip rnw-chip-stage">@row.Stage</span><span class="rnw-chip rnw-chip-lob">@row.Lob</span>@if (IsUrgent(row)) { <span class="rnw-risk">Urgent</span> }</div>
                            <div class="rnw-title">@row.AccountName</div>
                            <div class="rnw-meta"><span><i class="bi bi-shield"></i> @row.PolicyNumber</span><span><i class="bi bi-broadcast"></i> @row.Carrier</span><span><i class="bi bi-person"></i> @row.Producer</span><span><i class="bi bi-calendar-event"></i> @DaysLabel(row.DaysToExpiry)</span><span><i class="bi bi-cash-stack"></i> @row.CurrentPremium.ToString("C0")</span></div>
                            @if (ModeKey == "activities") { <div class="rnw-activity-note"><i class="bi @ActivityIcon(row.ActivityType)"></i> @row.ActivityType: @row.ActivitySubject</div> }
                        </div>
                        <div class="rnw-actions" @onclick:stopPropagation="true"><button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => Open(row)"><i class="bi bi-arrow-right"></i></button><button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => LogActivityAsync(row)"><i class="bi bi-lightning"></i></button><button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => MoveNextAsync(row)"><i class="bi bi-arrow-right-circle"></i></button><button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => QuoteAsync(row)"><i class="bi bi-quote"></i></button></div>
                    </article>
                }
            }
            @if (!Filtered.Any()) { <div class="rnw-empty"><i class="bi @ItemIcon"></i><span>No renewal records match the current filters.</span></div> }
        </div>
        @DetailPanel()
    </div>
}

@code {
    [Parameter] public string Mode { get; set; } = "dashboard";

    EnterpriseToast? _toast;
    bool _loading;
    string _search = string.Empty;
    string _stageFilter = string.Empty;
    string _lobFilter = string.Empty;
    string _producerFilter = string.Empty;
    string _activeFilter = string.Empty;
    int _daysFilter;
    RenewalWorkRow? _selected;
    readonly List<RenewalWorkRow> _rows = [];

    static readonly string[] Stages = ["Not Started", "In Progress", "Quoted", "Renewed", "Lost", "Non-Renewed"];
    string ModeKey => Mode.Trim().ToLowerInvariant();
    IEnumerable<RenewalWorkRow> FilterSource => _rows;
    IEnumerable<RenewalWorkRow> Filtered => FilterSource.Where(x => MatchesKpi(x)
        && (string.IsNullOrEmpty(_stageFilter) || x.Stage == _stageFilter)
        && (string.IsNullOrEmpty(_lobFilter) || x.Lob == _lobFilter)
        && (string.IsNullOrEmpty(_producerFilter) || x.Producer == _producerFilter)
        && (_daysFilter == 0 || x.DaysToExpiry <= _daysFilter)
        && (string.IsNullOrEmpty(_search) || x.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.PolicyNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Carrier.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Producer.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.ActivitySubject.Contains(_search, StringComparison.OrdinalIgnoreCase))).OrderBy(x => ModeKey == "activities" ? -x.ActivityDate.Ticks : x.DaysToExpiry);
    IEnumerable<Group<RenewalWorkRow>> Groups => (ModeKey == "activities" ? Filtered.GroupBy(x => FormatActivityDate(x.ActivityDate.Date)) : Filtered.GroupBy(x => x.Stage)).Select(g => new Group<RenewalWorkRow>(g.Key, g.ToList()));
    string[] StageValues => FilterSource.Select(x => x.Stage).Distinct().OrderBy(StageOrder).ToArray();
    string[] LobValues => FilterSource.Select(x => x.Lob).Distinct().Order().ToArray();
    string[] ProducerValues => FilterSource.Select(x => x.Producer).Distinct().Order().ToArray();

    string Title => ModeKey switch { "pipeline" => "Renewal Pipeline", "activities" => "Renewal Activities", _ => "Renewals Workbench" };
    string Subtitle => ModeKey switch { "pipeline" => "Visualize renewal stage movement, urgency, premium at stake, and retention risk", "activities" => "Track calls, emails, meetings, tasks, and follow-ups against renewal accounts", _ => "Manage upcoming renewals, retention risk, premium at stake, and action queues" };
    string Icon => ModeKey switch { "pipeline" => "bi-funnel", "activities" => "bi-lightning-fill", _ => "bi-arrow-clockwise" };
    string Eyebrow => ModeKey == "activities" ? "Renewal Touchpoints" : "Renewal Operations";
    string HeroTitle => ModeKey switch { "pipeline" => "Retention Pipeline Board", "activities" => "Renewal Activity Desk", _ => "Retention Command Center" };
    string HeroText => "Search, filter, triage, and action renewal work by urgency, stage, premium impact, producer, carrier, and line of business.";
    string PrimaryText => ModeKey == "activities" ? "Log Activity" : ModeKey == "pipeline" ? "Open Dashboard" : "Export";
    string PrimaryIcon => ModeKey == "activities" ? "bi-plus-lg" : ModeKey == "pipeline" ? "bi-grid" : "bi-download";
    string ItemIcon => ModeKey == "activities" ? "bi-lightning-fill" : "bi-arrow-clockwise";
    string IconClass => ModeKey == "activities" ? "rnw-icon-activity" : string.Empty;
    string SearchPlaceholder => ModeKey == "activities" ? "Search account, activity subject, notes, producer…" : "Search account, policy number, carrier, producer…";
    decimal PremiumAtStake => FilterSource.Where(x => x.Stage is not "Renewed" and not "Lost" and not "Non-Renewed").Sum(x => x.CurrentPremium);
    string RetentionRate => FilterSource.Count(x => x.Stage is "Renewed" or "Lost" or "Non-Renewed") == 0 ? "—" : $"{FilterSource.Count(x => x.Stage == "Renewed") / (double)FilterSource.Count(x => x.Stage is "Renewed" or "Lost" or "Non-Renewed"):P0}";

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Renewals", "/renewals"), new(Title, CurrentUrl));
        await LoadAsync();
    }

    string CurrentUrl => ModeKey switch { "pipeline" => "/renewals/pipeline", "activities" => "/renewals/activities", _ => "/renewals" };
    async Task LoadAsync() { _loading = true; await Task.Delay(0); if (_rows.Count == 0) BuildStub(); _selected ??= Filtered.FirstOrDefault(); _loading = false; }
    bool MatchesKpi(RenewalWorkRow x) => _activeFilter switch { "urgent" => IsUrgent(x), _ when _activeFilter.StartsWith("stage:") => x.Stage == _activeFilter[6..], _ => true };
    int CountStage(string stage) => FilterSource.Count(x => x.Stage == stage);
    void ResetFilters() { _search = _stageFilter = _lobFilter = _producerFilter = _activeFilter = string.Empty; _daysFilter = 0; }
    void SetFilter(string? filter) => _activeFilter = _activeFilter == (filter ?? string.Empty) ? string.Empty : filter ?? string.Empty;
    void SetStageFilter(string stage) => SetFilter($"stage:{stage}");
    void Select(RenewalWorkRow row) => _selected = row;
    void Open(RenewalWorkRow row) => Nav.NavigateTo($"/renewals/{row.Id}");
    Task PrimaryActionAsync() => ModeKey == "pipeline" ? NavigateAsync("/renewals") : ToastAsync($"{PrimaryText} started.");
    Task NavigateAsync(string url) { Nav.NavigateTo(url); return Task.CompletedTask; }
    Task LogActivityAsync(RenewalWorkRow row) => ToastAsync($"Activity logged for {row.AccountName}.");
    Task QuoteAsync(RenewalWorkRow row) => ToastAsync($"Quote workflow started for {row.PolicyNumber}.");
    Task MoveNextAsync(RenewalWorkRow row) { var index = Array.IndexOf(Stages, row.Stage); if (index >= 0 && index < Stages.Length - 1) row.Stage = Stages[index + 1]; return ToastAsync($"Moved {row.PolicyNumber} to {row.Stage}."); }
    async Task ToastAsync(string message) { if (_toast is not null) await _toast.ShowAsync(new ToastModel { Title = Title, Content = message, CssClass = "e-toast-success" }); }

    bool IsUrgent(RenewalWorkRow row) => row.DaysToExpiry <= 30 && row.Stage is not "Renewed" and not "Lost" and not "Non-Renewed" || ModeKey == "activities" && row.ActivityType == "Task" && !row.IsCompleted && row.ActivityDate.Date < DateTime.Today;
    static string DaysLabel(int days) => days < 0 ? $"{Math.Abs(days)}d overdue" : days == 0 ? "Today" : $"{days}d";
    static string RiskColor(int risk) => risk >= 75 ? "#be123c" : risk >= 50 ? "#d97706" : "#047857";
    static int StageOrder(string stage) => stage switch { "Not Started" => 1, "In Progress" => 2, "Quoted" => 3, "Renewed" => 4, "Lost" => 5, "Non-Renewed" => 6, _ => 99 };
    static string FormatActivityDate(DateTime date) => date == DateTime.Today ? "Today" : date == DateTime.Today.AddDays(-1) ? "Yesterday" : date.ToString("MMM d, yyyy");
    static string ActivityIcon(string type) => type switch { "Call" => "bi-telephone", "Email" => "bi-envelope", "Meeting" => "bi-calendar-event", "Task" => "bi-check2-square", _ => "bi-sticky" };

    RenderFragment Kpi(string icon, string label, string value, string title, string css, string? filter) => @<button class="rnw-kpi-card @css @(_activeFilter == (filter ?? string.Empty) ? "rnw-kpi-active" : "")" title="@title" @onclick="() => SetFilter(filter)"><div class="rnw-kpi-val">@value</div><div class="rnw-kpi-lbl"><i class="bi @icon"></i> @label</div><small>@title</small></button>;
    RenderFragment DetailPanel() => @<text>@if (_selected is not null) { <aside class="rnw-detail-panel"><div class="rnw-detail-header"><span class="rnw-chip rnw-chip-stage">@_selected.Stage</span><button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _selected = null"><i class="bi bi-x-lg"></i></button></div><h3>@_selected.AccountName</h3><p>@_selected.PolicyNumber • @_selected.Lob</p><div class="rnw-detail-grid"><div><span>Carrier</span><strong>@_selected.Carrier</strong></div><div><span>Premium</span><strong>@_selected.CurrentPremium.ToString("C0")</strong></div><div><span>Expiry</span><strong>@_selected.ExpiryDate.ToString("d")</strong></div><div><span>Days</span><strong>@DaysLabel(_selected.DaysToExpiry)</strong></div><div><span>Risk</span><strong>@_selected.RetentionRiskScore</strong></div><div><span>Producer</span><strong>@_selected.Producer</strong></div><div><span>Assigned</span><strong>@_selected.AssignedTo</strong></div><div><span>Open Tasks</span><strong>@_selected.OpenTasks</strong></div></div><div class="rnw-detail-actions"><button class="um-btn um-btn-primary" @onclick="() => Open(_selected)"><i class="bi bi-arrow-right"></i> Open</button><button class="um-btn um-btn-ghost" @onclick="() => LogActivityAsync(_selected)"><i class="bi bi-lightning"></i> Log Activity</button><button class="um-btn um-btn-ghost" @onclick="() => MoveNextAsync(_selected)"><i class="bi bi-arrow-right-circle"></i> Move Stage</button><button class="um-btn um-btn-ghost" @onclick="() => QuoteAsync(_selected)"><i class="bi bi-quote"></i> Quote</button></div></aside> }</text>;

    void BuildStub()
    {
        var rng = new Random(73);
        string[] accounts = ["Sullivan Mfg. LLC", "Bridgewater Hotels", "Metro Freight Co.", "PineCrest Builders", "Omega Tech Corp.", "BlueSky Aviation", "Harbor Fresh Foods", "Summit Properties LLC"];
        string[] lobs = ["General Liability", "Commercial Auto", "Commercial Property", "Workers Comp", "Umbrella", "Professional Liability", "Home/Dwelling", "Personal Auto"];
        string[] carriers = ["Travelers", "Chubb", "Zurich", "AIG", "Hartford", "CNA", "Liberty Mutual"];
        string[] producers = ["Maria Santos", "James Park", "Kevin Obi", "Sarah Kim", "Lisa Chen"];
        string[] activityTypes = ["Call", "Email", "Meeting", "Task", "Note"];
        string[] subjects = ["Renewal questionnaire sent", "Loss runs requested", "Carrier quote follow-up", "Coverage review meeting", "Premium change discussion", "Remarketing strategy call"];
        for (var i = 1; i <= 80; i++)
        {
            var days = rng.Next(-10, 130);
            var type = activityTypes[rng.Next(activityTypes.Length)];
            _rows.Add(new RenewalWorkRow
            {
                AccountName = accounts[rng.Next(accounts.Length)],
                PolicyNumber = $"POL-2025-{rng.Next(10000, 99999)}",
                Lob = lobs[rng.Next(lobs.Length)],
                Carrier = carriers[rng.Next(carriers.Length)],
                ExpiryDate = DateTime.Today.AddDays(days),
                DaysToExpiry = days,
                Stage = Stages[rng.Next(Stages.Length)],
                RetentionRiskScore = rng.Next(5, 98),
                CurrentPremium = rng.Next(2500, 115000),
                ProjectedPremium = rng.Next(2) == 0 ? null : rng.Next(3000, 125000),
                LossRatio = rng.Next(0, 115),
                Producer = producers[rng.Next(producers.Length)],
                AssignedTo = producers[rng.Next(producers.Length)],
                OpenTasks = rng.Next(0, 8),
                ActivityType = type,
                ActivitySubject = subjects[rng.Next(subjects.Length)],
                ActivityDate = DateTime.Today.AddDays(-rng.Next(0, 30)).AddHours(rng.Next(8, 17)),
                IsCompleted = rng.Next(3) == 0
            });
        }
    }

    sealed record Group<T>(string Label, List<T> Items);
    sealed class RenewalWorkRow
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public string DisplayNumber => ModeNumber;
        public string ModeNumber => ActivityType.Length > 0 ? $"ACT-{Id.ToString("N")[..6].ToUpperInvariant()}" : PolicyNumber;
        public string AccountName { get; set; } = string.Empty;
        public string PolicyNumber { get; set; } = string.Empty;
        public string Lob { get; set; } = string.Empty;
        public string Carrier { get; set; } = string.Empty;
        public DateTime ExpiryDate { get; set; }
        public int DaysToExpiry { get; set; }
        public string Stage { get; set; } = string.Empty;
        public int RetentionRiskScore { get; set; }
        public decimal CurrentPremium { get; set; }
        public decimal? ProjectedPremium { get; set; }
        public decimal LossRatio { get; set; }
        public string Producer { get; set; } = string.Empty;
        public string AssignedTo { get; set; } = string.Empty;
        public int OpenTasks { get; set; }
        public string ActivityType { get; set; } = string.Empty;
        public string ActivitySubject { get; set; } = string.Empty;
        public DateTime ActivityDate { get; set; }
        public bool IsCompleted { get; set; }
    }
}
