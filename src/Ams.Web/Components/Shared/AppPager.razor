<div class="app-pager" aria-label="Pagination">
    <button type="button" class="um-btn um-btn-ghost um-btn-sm" disabled="@(CurrentPage <= 1)" @onclick="PreviousAsync">Previous</button>
    <span class="app-pager__status">Page @CurrentPage</span>
    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextAsync">Next</button>
</div>

@code {
    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public int TotalItemsCount { get; set; }
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public EventCallback<PageChangedEventArgs> CurrentPageChanged { get; set; }
    [Parameter] public EventCallback<PageChangedEventArgs> PageChanged { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private Task PreviousAsync() => ChangePageAsync(Math.Max(1, CurrentPage - 1));
    private Task NextAsync() => ChangePageAsync(CurrentPage + 1);

    private async Task ChangePageAsync(int page)
    {
        CurrentPage = page;
        var args = new PageChangedEventArgs { CurrentPage = CurrentPage, PageSize = PageSize };
        await CurrentPageChanged.InvokeAsync(args);
        await PageChanged.InvokeAsync(args);
    }
}
