@*
    AppTimelinePanel - renders a vertical activity timeline from TimelineEventVm records.
    Typically embedded as a tab content component in detail pages.

    Usage:
        <AppTimelinePanel Events="_timeline" Loading="_timelineLoading" Title="Activity" />

    Map your application activity/history DTOs to AppTimelinePanel.TimelineEventVm before passing.
*@

<div class="tab-section">
    <div class="ts-header">
        <h3 class="ts-title">
            <i class="bi bi-clock-history" aria-hidden="true"></i> @Title
        </h3>
        @if (HeaderActions is not null)
        {
            <div class="ts-header-right">@HeaderActions</div>
        }
    </div>

    @if (Loading)
    {
        <div class="ts-loading" aria-live="polite">
            <div class="ts-spinner" aria-hidden="true"></div>
            <span>Loading activity...</span>
        </div>
    }
    else if (!Events.Any())
    {
        <div class="ts-empty">
            <i class="bi bi-clock" aria-hidden="true"></i>
            <span>No activity recorded</span>
        </div>
    }
    else
    {
        var eventList = Events.ToList();
        <div class="atp-timeline">
            @for (var i = 0; i < eventList.Count; i++)
            {
                var ev      = eventList[i];
                var isLast  = i == eventList.Count - 1;
                var dotColor = ev.Color ?? "var(--brand-500)";

                <div class="atp-event">
                    <div class="atp-icon-col" aria-hidden="true">
                        <div class="atp-dot" style="background:@dotColor">
                            <i class="bi @(ev.Icon ?? "bi-circle-fill")"></i>
                        </div>
                        @if (!isLast)
                        {
                            <div class="atp-line"></div>
                        }
                    </div>
                    <div class="atp-body">
                        <div class="atp-title">@ev.Title</div>
                        @if (!string.IsNullOrEmpty(ev.Description))
                        {
                            <div class="atp-desc">@ev.Description</div>
                        }
                        <div class="atp-meta">
                            @if (!string.IsNullOrEmpty(ev.Actor))
                            {
                                <span><i class="bi bi-person" aria-hidden="true"></i> @ev.Actor</span>
                                <span class="atp-sep" aria-hidden="true">-</span>
                            }
                            <span>
                                <i class="bi bi-clock" aria-hidden="true"></i>
                                @ev.DateUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>View-model for a single timeline event.</summary>
    public record TimelineEventVm(
        string    Title,
        DateTime  DateUtc,
        string?   Description = null,
        string?   Icon        = null,
        string?   Color       = null,
        string?   Actor       = null
    );

    [Parameter] public IEnumerable<TimelineEventVm> Events { get; set; } = [];
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string Title { get; set; } = "Activity";

    /// <summary>Optional controls rendered in the panel header.</summary>
    [Parameter] public RenderFragment? HeaderActions { get; set; }
}
