@typeparam TItem

@*
    AppDataGrid<TItem> - standard AMS SfGrid wrapper with pre-configured paging, sorting,
    filtering and header style. Pass column definitions via the Columns slot.

    Usage:
        <AppDataGrid TItem="RoleDto" DataSource="_roles" Loading="_loading">
            <Columns>
                <GridColumn Field="RoleCode" HeaderText="Code" Width="150" />
                <GridColumn Field="RoleName" HeaderText="Name" />
            </Columns>
        </AppDataGrid>
*@

<div class="um-grid-card app-datagrid">
    @if (Loading)
    {
        <div class="um-loading-overlay" aria-live="polite" aria-label="@LoadingMessage">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>@LoadingMessage</span>
        </div>
    }
    <SfGrid TValue="TItem"
            DataSource="@DataSource"
            AllowPaging="@AllowPaging"
            AllowSorting="@AllowSorting"
            AllowFiltering="@AllowFiltering"
            EnableHover="@EnableHover"
            RowHeight="@RowHeight">
        <GridPageSettings PageSize="@PageSize" PageSizes="@PageSizes" />
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
        <GridColumns>
            @Columns
        </GridColumns>
    </SfGrid>
</div>

@code {
    /// <summary>Data to bind to the grid.</summary>
    [Parameter] public IEnumerable<TItem>? DataSource { get; set; }

    /// <summary>GridColumn elements to render inside the grid.</summary>
    [Parameter] public RenderFragment? Columns { get; set; }

    /// <summary>Show the loading overlay over the grid.</summary>
    [Parameter] public bool Loading { get; set; }

    [Parameter] public string LoadingMessage { get; set; } = "Loading...";
    [Parameter] public bool   AllowPaging    { get; set; } = true;
    [Parameter] public bool   AllowSorting   { get; set; } = true;
    [Parameter] public bool   AllowFiltering { get; set; } = true;
    [Parameter] public bool   EnableHover    { get; set; } = true;
    [Parameter] public int    RowHeight      { get; set; } = 52;
    [Parameter] public int    PageSize       { get; set; } = 25;
    [Parameter] public int[]  PageSizes      { get; set; } = [10, 25, 50, 100];
}
