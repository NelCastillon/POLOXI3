@*
    PermissionAwareButton — renders ChildContent inside a <button> only when HasPermission is true.
    When HasPermission is false and ShowDisabled is true, a disabled button is rendered instead of hiding it.

    Usage:
        <PermissionAwareButton HasPermission="@canEdit" CssClass="um-btn um-btn-primary" OnClick="Save">
            <i class="bi bi-floppy"></i> Save
        </PermissionAwareButton>
*@

@if (HasPermission)
{
    <button type="button"
            class="@CssClass"
            title="@Title"
            disabled="@Disabled"
            @onclick="OnClick"
            aria-label="@(AriaLabel ?? Title)">
        @ChildContent
    </button>
}
else if (ShowDisabled)
{
    <button type="button"
            class="@CssClass"
            title="@((Title ?? string.Empty) + " (insufficient permissions)")"
            disabled="true"
            aria-disabled="true"
            aria-label="@(AriaLabel ?? Title)">
        @ChildContent
    </button>
}

@code {
    /// <summary>Whether the current user has the required permission. When false, the button is hidden (or disabled if ShowDisabled=true).</summary>
    [Parameter] public bool HasPermission { get; set; } = true;

    /// <summary>When HasPermission is false and ShowDisabled is true, renders a disabled (greyed-out) button instead of hiding it completely.</summary>
    [Parameter] public bool ShowDisabled { get; set; }

    /// <summary>Prevents interaction regardless of permission state.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>CSS classes for the button. Defaults to the AMS primary button style.</summary>
    [Parameter] public string CssClass { get; set; } = "um-btn um-btn-primary";

    [Parameter] public string? Title    { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
