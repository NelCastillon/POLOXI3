@*
    AppMetricCard — single KPI tile for dashboard and detail-page metric bars.

    Supports a primary value + label, optional trend indicator, optional delta,
    optional icon, colour variants, and a click-through link or callback.

    Usage — simple:
        <AppMetricCard Label="Active Tenants" Value="142" Icon="bi-buildings" />

    Usage — with trend:
        <AppMetricCard Label="MRR" Value="$84,200" Icon="bi-cash-coin"
                       Delta="+12%" DeltaTrend="up" Variant="green" />

    Usage — with detail link:
        <AppMetricCard Label="Overdue Invoices" Value="7" Icon="bi-exclamation-circle"
                       Variant="red" Href="/billing/ar-aging" />

    Usage — loading state:
        <AppMetricCard Label="Active Tenants" Loading="true" />

    Usage — footer slot:
        <AppMetricCard Label="Storage Used" Value="4.2 GB">
            <Footer>
                <div class="amc-progress-bar">
                    <div class="amc-progress-fill" style="width:42%"></div>
                </div>
            </Footer>
        </AppMetricCard>
*@

@if (!string.IsNullOrEmpty(Href))
{
    <a class="@_cardClass" href="@Href" title="@Label">
        @CardContent
    </a>
}
else if (OnClick.HasDelegate)
{
    <button class="@_cardClass" @onclick="OnClick" type="button" aria-label="@Label">
        @CardContent
    </button>
}
else
{
    <div class="@_cardClass">
        @CardContent
    </div>
}

@* ── shared inner markup ─────────────────────────────────── *@
@code {
    private RenderFragment CardContent => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "amc-inner");

        // icon
        if (!string.IsNullOrEmpty(Icon))
        {
            __builder.OpenElement(2, "div");
            __builder.AddAttribute(3, "class", $"amc-icon-wrap amc-icon--{VariantClass}");
            __builder.AddAttribute(4, "aria-hidden", "true");
            __builder.OpenElement(5, "i");
            __builder.AddAttribute(6, "class", $"bi {Icon}");
            __builder.CloseElement();
            __builder.CloseElement();
        }

        // body
        __builder.OpenElement(7, "div");
        __builder.AddAttribute(8, "class", "amc-body");

        // value row
        __builder.OpenElement(9, "div");
        __builder.AddAttribute(10, "class", "amc-value-row");

        if (Loading)
        {
            __builder.OpenElement(11, "span");
            __builder.AddAttribute(12, "class", "amc-skeleton");
            __builder.CloseElement();
        }
        else
        {
            __builder.OpenElement(13, "span");
            __builder.AddAttribute(14, "class", $"amc-value amc-value--{VariantClass}");
            __builder.AddContent(15, Value ?? "—");
            __builder.CloseElement();

            if (!string.IsNullOrEmpty(Delta))
            {
                string trendIcon = DeltaTrend switch
                {
                    "up"   => "bi-arrow-up-short",
                    "down" => "bi-arrow-down-short",
                    _      => "bi-dash"
                };
                string trendClass = DeltaTrend switch
                {
                    "up"   => "amc-delta--up",
                    "down" => "amc-delta--down",
                    _      => "amc-delta--flat"
                };
                __builder.OpenElement(16, "span");
                __builder.AddAttribute(17, "class", $"amc-delta {trendClass}");
                __builder.OpenElement(18, "i");
                __builder.AddAttribute(19, "class", $"bi {trendIcon}");
                __builder.AddAttribute(20, "aria-hidden", "true");
                __builder.CloseElement();
                __builder.AddContent(21, Delta);
                __builder.CloseElement();
            }
        }

        __builder.CloseElement(); // amc-value-row

        // label
        __builder.OpenElement(22, "span");
        __builder.AddAttribute(23, "class", "amc-label");
        __builder.AddContent(24, Label);
        __builder.CloseElement();

        // sub-label
        if (!string.IsNullOrEmpty(SubLabel))
        {
            __builder.OpenElement(25, "span");
            __builder.AddAttribute(26, "class", "amc-sublabel");
            __builder.AddContent(27, SubLabel);
            __builder.CloseElement();
        }

        __builder.CloseElement(); // amc-body
        __builder.CloseElement(); // amc-inner

        // footer slot
        if (Footer is not null)
        {
            __builder.OpenElement(28, "div");
            __builder.AddAttribute(29, "class", "amc-footer");
            __builder.AddContent(30, Footer);
            __builder.CloseElement();
        }
    };
}

@code {
    // ── Content parameters ────────────────────────────────────

    /// <summary>Primary metric value. Accepts pre-formatted strings, e.g. "$84,200" or "99.8%".</summary>
    [Parameter] public string? Value    { get; set; }

    /// <summary>Metric label displayed below the value.</summary>
    [Parameter] public string  Label    { get; set; } = string.Empty;

    /// <summary>Optional secondary label or context line below the main label.</summary>
    [Parameter] public string? SubLabel { get; set; }

    /// <summary>Bootstrap Icon class, e.g. "bi-buildings". Rendered in a tinted icon well.</summary>
    [Parameter] public string? Icon     { get; set; }

    /// <summary>Delta / change indicator text, e.g. "+12%" or "−3".</summary>
    [Parameter] public string? Delta    { get; set; }

    /// <summary>"up", "down", or "flat". Controls delta arrow and colour.</summary>
    [Parameter] public string? DeltaTrend { get; set; }

    // ── Visual parameters ─────────────────────────────────────

    /// <summary>
    /// Colour variant for the value and icon tint.
    /// Accepts: "default" | "green" | "amber" | "red" | "blue" | "purple".
    /// </summary>
    [Parameter] public string Variant { get; set; } = "default";

    /// <summary>Show a skeleton loading state in place of the value.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>Additional CSS classes appended to the card root element.</summary>
    [Parameter] public string? CssClass { get; set; }

    // ── Interaction parameters ────────────────────────────────

    /// <summary>If set the card renders as an anchor tag navigating to this URL.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>If set the card renders as a button invoking this callback.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    // ── Slot ──────────────────────────────────────────────────

    /// <summary>Optional footer content rendered below the metric body (e.g. a progress bar).</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    // ── Computed ──────────────────────────────────────────────

    private string VariantClass => Variant switch
    {
        "green"  => "green",
        "amber"  => "amber",
        "red"    => "red",
        "blue"   => "blue",
        "purple" => "purple",
        _        => "default"
    };

    private string _cardClass =>
        "amc-card" +
        (!string.IsNullOrEmpty(Href) || OnClick.HasDelegate ? " amc-card--clickable" : "") +
        (!string.IsNullOrEmpty(CssClass) ? $" {CssClass}" : "");
}
