@typeparam TValue

@code {
    [CascadingParameter] private AppGrid<TValue>? Owner { get; set; }
    [Parameter] public EventCallback<RowSelectEventArgs<TValue>> RowSelected { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnInitialized() => Owner?.RegisterRowSelected(RowSelected);
}
