@*
    AppAuditPanel — displays a list of AuditEntryVm records in a consistent AMS audit-trail layout.
    Typically embedded as a tab content component in detail pages.

    Usage:
        <AppAuditPanel Entries="_auditEntries" Loading="_auditLoading" Title="Audit Trail" />

    Map your application AuditLogDto to AppAuditPanel.AuditEntryVm before passing.
*@

<div class="tab-section">
    <div class="ts-header">
        <h3 class="ts-title">
            <i class="bi bi-journal-text" aria-hidden="true"></i> @Title
        </h3>
        @if (HeaderActions is not null)
        {
            <div class="ts-header-right">@HeaderActions</div>
        }
    </div>

    @if (Loading)
    {
        <div class="ts-loading" aria-live="polite">
            <div class="ts-spinner" aria-hidden="true"></div>
            <span>Loading audit entries…</span>
        </div>
    }
    else if (!Entries.Any())
    {
        <div class="ts-empty">
            <i class="bi bi-journal-x" aria-hidden="true"></i>
            <span>No audit entries found</span>
        </div>
    }
    else
    {
        <div class="aap-list">
            @foreach (var entry in Entries)
            {
                <div class="aap-entry">
                    <div class="aap-entry-icon aap-icon--@entry.EventTypeCode.ToLowerInvariant()" aria-hidden="true">
                        <i class="bi @AuditIcon(entry.EventTypeCode)"></i>
                    </div>
                    <div class="aap-entry-body">
                        <div class="aap-entry-title">@entry.ActionName</div>
                        <div class="aap-entry-meta">
                            @if (!string.IsNullOrEmpty(entry.PerformedBy))
                            {
                                <span><i class="bi bi-person" aria-hidden="true"></i> @entry.PerformedBy</span>
                                <span class="aap-sep" aria-hidden="true">·</span>
                            }
                            <span>
                                <i class="bi bi-clock" aria-hidden="true"></i>
                                @entry.PerformedDateUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                            </span>
                            @if (!string.IsNullOrEmpty(entry.EntityName))
                            {
                                <span class="aap-sep" aria-hidden="true">·</span>
                                <span class="badge badge-neutral">@entry.EntityName</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(entry.OldValues) || !string.IsNullOrEmpty(entry.NewValues))
                        {
                            <div class="aap-entry-changes">
                                @if (!string.IsNullOrEmpty(entry.OldValues))
                                {
                                    <span class="aap-change aap-change--old">
                                        <i class="bi bi-dash-circle" aria-hidden="true"></i>
                                        Before: @Truncate(entry.OldValues, 120)
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(entry.NewValues))
                                {
                                    <span class="aap-change aap-change--new">
                                        <i class="bi bi-plus-circle" aria-hidden="true"></i>
                                        After: @Truncate(entry.NewValues, 120)
                                    </span>
                                }
                            </div>
                        }
                    </div>
                    <div class="aap-entry-badge">
                        <span class="badge @EventBadgeClass(entry.EventTypeCode)">@entry.EventTypeCode</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>View-model for a single audit log entry.</summary>
    public record AuditEntryVm(
        Guid     AuditLogId,
        string   EntityName,
        string   ActionName,
        string   EventTypeCode,
        string?  PerformedBy,
        DateTime PerformedDateUtc,
        string?  OldValues,
        string?  NewValues
    );

    [Parameter] public IEnumerable<AuditEntryVm> Entries { get; set; } = [];
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string Title { get; set; } = "Audit Trail";

    /// <summary>Optional controls rendered in the panel header (e.g. a date range filter).</summary>
    [Parameter] public RenderFragment? HeaderActions { get; set; }

    private static string AuditIcon(string code) => code.ToUpperInvariant() switch
    {
        "CREATE" or "INSERT"     => "bi-plus-circle-fill",
        "UPDATE" or "MODIFY"     => "bi-pencil-fill",
        "DELETE" or "REMOVE"     => "bi-trash3-fill",
        "APPROVE"                => "bi-check-circle-fill",
        "REJECT"                 => "bi-x-circle-fill",
        "LOGIN"                  => "bi-box-arrow-in-right",
        "LOGOUT"                 => "bi-box-arrow-right",
        "EXPORT"                 => "bi-download",
        _                        => "bi-activity"
    };

    private static string EventBadgeClass(string code) => code.ToUpperInvariant() switch
    {
        "CREATE" or "INSERT"     => "badge-green",
        "UPDATE" or "MODIFY"     => "badge-blue",
        "DELETE" or "REMOVE"     => "badge-red",
        "APPROVE"                => "badge-green",
        "REJECT"                 => "badge-red",
        _                        => "badge-neutral"
    };

    private static string Truncate(string s, int max) =>
        s.Length > max ? s[..max] + "…" : s;
}
