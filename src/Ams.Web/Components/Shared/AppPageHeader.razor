@*
    AppPageHeader — standard AMS page header with optional icon, breadcrumb, subtitle, and action slot.

    Usage:
        <AppPageHeader Title="Roles" Subtitle="Manage roles and permissions" Icon="bi-shield-lock">
            <Actions>
                <button class="um-btn um-btn-primary">Create Role</button>
            </Actions>
        </AppPageHeader>
*@

<div class="page-header">
    <div class="aph-left">
        @if (Breadcrumb is not null)
        {
            <div class="aph-breadcrumb">@Breadcrumb</div>
        }
        <div class="aph-title-row">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <span class="aph-icon" aria-hidden="true">
                    <i class="bi @Icon"></i>
                </span>
            }
            <div>
                <h1 class="page-title">@Title</h1>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <p class="page-subtitle">@Subtitle</p>
                }
            </div>
        </div>
    </div>
    @if (Actions is not null)
    {
        <div class="page-actions">@Actions</div>
    }
</div>

@code {
    [Parameter] public string  Title      { get; set; } = string.Empty;
    [Parameter] public string? Subtitle   { get; set; }

    /// <summary>Bootstrap Icon class without the "bi " prefix, e.g. "bi-shield-lock".</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Right-aligned action buttons / controls.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Optional breadcrumb row rendered above the title.</summary>
    [Parameter] public RenderFragment? Breadcrumb { get; set; }
}
