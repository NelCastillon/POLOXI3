@inject ConfirmationDialogService Confirmations
@implements IDisposable

<SfDialog @bind-Visible="_visible" Width="420px" CssClass="um-confirm-sfdialog" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon um-confirm-icon--danger">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                </div>
                <div class="um-confirm-content">
                    <h3>@_title</h3>
                    <p>@_message</p>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="Cancel">@_cancelText</button>
                    <button type="button" class="um-btn um-btn-danger" @onclick="Confirm">@_confirmText</button>
                </div>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private bool _visible;
    private string _title = "Confirm delete";
    private string _message = "Are you sure you want to delete this item?";
    private string _confirmText = "Delete";
    private string _cancelText = "Cancel";
    private TaskCompletionSource<bool>? _completionSource;

    protected override void OnInitialized()
    {
        Confirmations.OnShow += Show;
    }

    private void Show(ConfirmationRequest request)
    {
        _title = request.Title;
        _message = request.Message;
        _confirmText = request.ConfirmText;
        _cancelText = request.CancelText;
        _completionSource = request.CompletionSource;
        _visible = true;
        InvokeAsync(StateHasChanged);
    }

    private void Confirm()
    {
        _visible = false;
        _completionSource?.TrySetResult(true);
        _completionSource = null;
    }

    private void Cancel()
    {
        _visible = false;
        _completionSource?.TrySetResult(false);
        _completionSource = null;
    }

    public void Dispose()
    {
        Confirmations.OnShow -= Show;
        _completionSource?.TrySetResult(false);
    }
}
