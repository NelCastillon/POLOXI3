@*
    AppConfirmActionDialog — focused confirmation modal with danger / warning / primary variants.

    Usage:
        <AppConfirmActionDialog @bind-Visible="_showConfirm"
                                Title="Delete Role"
                                Message="Are you sure you want to delete this role?"
                                Detail="This action cannot be undone."
                                Variant="danger"
                                ConfirmText="Delete"
                                IsBusy="_deleting"
                                OnConfirm="DeleteAsync" />
*@

<SfDialog Visible="_visible"
          Width="440px"
          CssClass="um-confirm-sfdialog"
          IsModal="true"
          ShowCloseIcon="true"
          CloseOnEscape="true">
    <DialogEvents Closed="OnDialogClosed" />
    <DialogTemplates>
        <Header>
            <span class="acd-hd-icon acd-hd-icon--@Variant" aria-hidden="true">
                <i class="bi @VariantIcon"></i>
            </span>
            @Title
        </Header>
        <Content>
            <div class="acd-body">
                <p class="acd-message">@Message</p>
                @if (!string.IsNullOrEmpty(Detail))
                {
                    <p class="acd-detail">@Detail</p>
                }
                @if (Body is not null)
                {
                    @Body
                }
            </div>
        </Content>
        <FooterTemplate>
            <div class="dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="Cancel" disabled="@IsBusy">
                    @CancelText
                </button>
                <button class="um-btn acd-confirm--@Variant" @onclick="ConfirmAsync" disabled="@IsBusy">
                    @if (IsBusy) { <span class="um-spin" aria-hidden="true"></span> }
                    @ConfirmText
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    private bool _visible;

    [Parameter]
    public bool Visible
    {
        get => _visible;
        set => _visible = value;
    }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public string Title   { get; set; } = "Confirm Action";
    [Parameter] public string Message { get; set; } = string.Empty;

    /// <summary>Secondary explanatory text shown below the main message.</summary>
    [Parameter] public string? Detail { get; set; }

    /// <summary>Additional content rendered below the message (e.g. a list of affected items).</summary>
    [Parameter] public RenderFragment? Body { get; set; }

    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText  { get; set; } = "Cancel";

    /// <summary>Visual variant controlling icon and confirm button colour: "danger" | "warning" | "primary".</summary>
    [Parameter] public string Variant { get; set; } = "danger";

    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel  { get; set; }

    protected override void OnParametersSet() => _visible = Visible;

    private string VariantIcon => Variant switch
    {
        "danger"  => "bi-exclamation-triangle-fill",
        "warning" => "bi-exclamation-circle-fill",
        "primary" => "bi-question-circle-fill",
        _         => "bi-exclamation-triangle-fill"
    };

    private async Task OnDialogClosed(Syncfusion.Blazor.Popups.CloseEventArgs args)
    {
        _visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task ConfirmAsync()
    {
        await OnConfirm.InvokeAsync();
        _visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task Cancel()
    {
        _visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnCancel.InvokeAsync();
    }
}
