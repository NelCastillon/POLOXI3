@typeparam TValue

<input type="datetime-local" class="form-control native-control" placeholder="@Placeholder" value="@CurrentValue" @onchange="OnChanged" />

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CurrentValue => Value is DateTime date ? date.ToString("yyyy-MM-ddTHH:mm") : string.Empty;

    private Task OnChanged(ChangeEventArgs e) => ValueChanged.InvokeAsync(ParseValue(e.Value?.ToString()));

    private static TValue? ParseValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return default;

        var targetType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
        if (targetType == typeof(DateTime) && DateTime.TryParse(value, out var dateTime))
            return (TValue)(object)dateTime;

        return default;
    }
}
