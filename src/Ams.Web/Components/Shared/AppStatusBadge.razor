@*
    AppStatusBadge - maps a status/type string to a colour-coded badge with an auto-selected icon.

    Recognised status strings (case-insensitive):
        Green  - Active, Enabled, Approved, Completed, Posted, Paid, Resolved, Accepted
        Amber  - Pending, Draft, Review, Queued, In Review, Submitted, Open
        Red    - Error, Failed, Rejected, Overdue, Delinquent, Locked
        Purple - System, BuiltIn
        Blue   - Internal
        Neutral - Inactive, Disabled, Closed, Expired, Archived, Cancelled, (unknown)

    Platform rule: region, plan, and isolation mode are always surfaced - use AppStatusBadge
    alongside those values on every tenant detail summary bar.

    Usage - basic:
        <AppStatusBadge Status="Active" />

    Usage - override label:
        <AppStatusBadge Status="Pending" Label="Awaiting Approval" />

    Usage - override icon:
        <AppStatusBadge Status="Draft" Icon="bi-file-earmark" />

    Usage - extra class:
        <AppStatusBadge Status="Active" CssClass="badge-lg" />
*@
<span class="badge @BadgeClass @CssClass" title="@Status">
    @if (!string.IsNullOrEmpty(ComputedIcon))
    {
        <i class="bi @ComputedIcon" aria-hidden="true"></i>
    }
    @(Label ?? Status)
</span>

@code {
    /// <summary>Status or type string to map to a badge colour (e.g. "Active", "Pending", "Draft").</summary>
    [Parameter] public string? Status   { get; set; }

    /// <summary>Override the display text. Falls back to Status when omitted.</summary>
    [Parameter] public string? Label    { get; set; }

    /// <summary>Override the Bootstrap Icon class (e.g. "bi-star-fill"). Omit to use the default for the Status.</summary>
    [Parameter] public string? Icon     { get; set; }

    /// <summary>Additional CSS classes appended to the badge element.</summary>
    [Parameter] public string? CssClass { get; set; }

    private string BadgeClass => Status?.ToLowerInvariant() switch
    {
        "active" or "enabled" or "approved" or "completed" or "posted" or "paid" or "resolved" or "accepted"
            => "badge-green",
        "inactive" or "disabled" or "closed" or "expired" or "archived" or "cancelled"
            => "badge-neutral",
        "pending" or "draft" or "review" or "queued" or "in review" or "submitted" or "open"
            => "badge-amber",
        "error" or "failed" or "rejected" or "overdue" or "delinquent" or "locked"
            => "badge-red",
        "system" or "builtin"
            => "badge-purple",
        "internal"
            => "badge-blue",
        _ => "badge-neutral"
    };

    private string ComputedIcon => Icon ?? (Status?.ToLowerInvariant() switch
    {
        "active" or "enabled" or "approved" or "completed" or "posted" or "paid" or "resolved" or "accepted"
            => "bi-check-circle-fill",
        "inactive" or "disabled"  => "bi-dash-circle",
        "pending" or "review"     => "bi-hourglass-split",
        "submitted"               => "bi-send",
        "draft"                   => "bi-pencil",
        "open"                    => "bi-circle",
        "error" or "failed"       => "bi-x-circle-fill",
        "rejected" or "cancelled" => "bi-slash-circle",
        "overdue" or "delinquent" => "bi-exclamation-circle-fill",
        "closed" or "archived"    => "bi-archive",
        "locked"                  => "bi-lock-fill",
        _                         => string.Empty
    }) ?? string.Empty;
}
