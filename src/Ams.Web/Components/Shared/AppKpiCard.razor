@*
    AppKpiCard — standard AMS KPI metric card with icon, value, label, trend and optional action link.

    Usage:
        <AppKpiCard Label="Active Tenants"
                    Value="@_activeCount.ToString()"
                    Icon="bi-check-circle"
                    Variant="success"
                    Trend="+12% this month"
                    Href="/platform/tenants?status=active" />

    Variants: "default" | "success" | "warning" | "danger" | "info" | "purple"
*@

<div class="akc-card akc-card--@Variant @(Href is not null || OnClick.HasDelegate ? "akc-card--clickable" : "") @CssClass"
     @onclick="HandleClick"
     role="@(Href is not null || OnClick.HasDelegate ? "button" : null)"
     tabindex="@(Href is not null || OnClick.HasDelegate ? "0" : null)"
     @onkeydown="HandleKeyDown">

    <div class="akc-icon-wrap akc-icon--@Variant" aria-hidden="true">
        <i class="bi @Icon"></i>
    </div>

    <div class="akc-body">
        <div class="akc-value" title="@Value">
            @if (Loading)
            {
                <span class="akc-skeleton" aria-label="Loading" />
            }
            else
            {
                @Value
            }
        </div>
        <div class="akc-label">@Label</div>
        @if (!string.IsNullOrEmpty(Trend))
        {
            <div class="akc-trend akc-trend--@TrendVariant">
                <i class="bi @TrendIcon" aria-hidden="true"></i>
                @Trend
            </div>
        }
    </div>

    @if (Badge is not null)
    {
        <div class="akc-badge-slot">@Badge</div>
    }

    @if (Href is not null)
    {
        <a href="@Href" class="akc-link-overlay" aria-label="@Label" tabindex="-1" />
    }
</div>

@code {
    /// <summary>Bootstrap Icon class without "bi " prefix, e.g. "bi-check-circle".</summary>
    [Parameter] public string Icon    { get; set; } = "bi-circle";

    /// <summary>Metric value displayed prominently.</summary>
    [Parameter] public string? Value  { get; set; }

    /// <summary>Descriptive label shown below the value.</summary>
    [Parameter] public string Label   { get; set; } = string.Empty;

    /// <summary>Optional secondary trend line (e.g. "+12% this month").</summary>
    [Parameter] public string? Trend  { get; set; }

    /// <summary>Colour variant of the trend text: "up" | "down" | "neutral". Default: "neutral".</summary>
    [Parameter] public string TrendVariant { get; set; } = "neutral";

    /// <summary>Card colour variant: "default" | "success" | "warning" | "danger" | "info" | "purple".</summary>
    [Parameter] public string Variant { get; set; } = "default";

    /// <summary>When set, wraps the card in a navigation link.</summary>
    [Parameter] public string? Href   { get; set; }

    /// <summary>Optional click handler (used when Href is not set).</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Show a loading skeleton in place of the value.</summary>
    [Parameter] public bool Loading   { get; set; }

    /// <summary>Additional CSS classes for the root element.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Optional badge slot rendered in the top-right corner (e.g. AppStatusBadge).</summary>
    [Parameter] public RenderFragment? Badge { get; set; }

    private string TrendIcon => TrendVariant switch
    {
        "up"   => "bi-arrow-up-short",
        "down" => "bi-arrow-down-short",
        _      => "bi-dash",
    };

    private async Task HandleClick()
    {
        if (Href is null && OnClick.HasDelegate)
            await OnClick.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            await HandleClick();
    }
}
