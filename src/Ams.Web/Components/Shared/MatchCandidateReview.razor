@inject ApiClient Api

@if (Result is not null)
{
    <section class="card" aria-label="Match candidates">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Possible matches</strong>
            <span class="badge bg-secondary">@Result.Candidates.Count candidate(s)</span>
        </div>
        <div class="list-group list-group-flush">
            @foreach (var candidate in Result.Candidates)
            {
                <article class="list-group-item">
                    <div class="d-flex justify-content-between gap-3">
                        <div>
                            <strong>@candidate.DisplayName</strong>
                            @if (!string.IsNullOrWhiteSpace(candidate.SecondaryText))
                            {
                                <div class="text-muted small">@candidate.SecondaryText</div>
                            }
                            @foreach (var reason in candidate.Reasons.Where(reason => reason.WeightedScore > 0 || reason.IsDiscrepancy))
                            {
                                <div class="small @(reason.IsDiscrepancy ? "text-danger" : "text-muted")">@reason.Explanation</div>
                            }
                        </div>
                        <span class="badge @(candidate.IsExactMatch ? "bg-success" : "bg-warning text-dark")">@candidate.OverallScore.ToString("0.#")%</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => DecideAsync(candidate, MatchReviewDecisionCodes.UseExisting)">Use existing</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => DecideAsync(candidate, MatchReviewDecisionCodes.Compare)">Compare</button>
                        <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => DecideAsync(candidate, MatchReviewDecisionCodes.MergeRequest)">Merge request</button>
                        @if (!string.IsNullOrWhiteSpace(candidate.NavigationRoute))
                        {
                            <a class="btn btn-sm btn-link" href="@candidate.NavigationRoute">Open record</a>
                        }
                    </div>
                </article>
            }
        </div>
        <div class="card-footer">
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CreateNewAsync">Create new anyway</button>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public EntityMatchResult? Result { get; set; }
    [Parameter] public EventCallback<MatchReviewDecision> DecisionRecorded { get; set; }
    [Parameter] public string? Notes { get; set; }

    private Task DecideAsync(MatchCandidate candidate, string decisionCode) => SaveAsync(decisionCode, candidate.EntityId);
    private Task CreateNewAsync() => SaveAsync(MatchReviewDecisionCodes.CreateNew, null);

    private async Task SaveAsync(string decisionCode, Guid? candidateEntityId)
    {
        if (Result is null) return;
        var decision = await Api.SaveMatchReviewDecisionAsync(new MatchReviewDecisionRequest
        {
            MatchExecutionId = Result.MatchExecutionId,
            CandidateEntityId = candidateEntityId,
            DecisionCode = decisionCode,
            Notes = Notes,
            CorrelationId = $"match-review:{Result.MatchExecutionId:N}:{Guid.NewGuid():N}"
        });
        if (decision is not null) await DecisionRecorded.InvokeAsync(decision);
    }
}
