@typeparam TValue

<input type="time" class="form-control native-control" placeholder="@Placeholder" value="@CurrentValue" @onchange="OnChanged" />

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CurrentValue => Value is DateTime date ? date.ToString("HH:mm") : string.Empty;

    private Task OnChanged(ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(e.Value?.ToString()))
            return ValueChanged.InvokeAsync(default);

        var today = DateTime.Today;
        return TimeSpan.TryParse(e.Value?.ToString(), out var time)
            ? ValueChanged.InvokeAsync((TValue?)(object)today.Add(time))
            : ValueChanged.InvokeAsync(default);
    }
}
