@typeparam TValue
@implements IAppGridOwner

<CascadingValue Value="this" IsFixed="true">
    <div class="d-none">@ChildContent</div>
</CascadingValue>

<div class="table-responsive native-grid">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                @foreach (var column in _columns)
                {
                    <th class="@column.AlignmentClass" style="@column.WidthStyle">@column.HeaderText</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Rows)
            {
                <tr @onclick="() => SelectRowAsync(item)">
                    @foreach (var column in _columns)
                    {
                        <td class="@column.AlignmentClass">
                            @if (column.Template is not null)
                            {
                                @column.Template(item!)
                            }
                            else
                            {
                                @FormatValue(column.GetValue(item))
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private readonly List<GridColumn> _columns = [];
    private EventCallback<RowSelectEventArgs<TValue>> _rowSelected;

    [Parameter] public IEnumerable<TValue>? DataSource { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool AllowPaging { get; set; }
    [Parameter] public bool AllowSorting { get; set; }
    [Parameter] public bool AllowFiltering { get; set; }
    [Parameter] public bool EnableHover { get; set; } = true;
    [Parameter] public int RowHeight { get; set; } = 52;
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private IEnumerable<TValue> Rows => DataSource ?? [];

    public void AddColumn(object column)
    {
        if (column is GridColumn gridColumn && !_columns.Contains(gridColumn))
            _columns.Add(gridColumn);
    }

    internal void RegisterRowSelected(EventCallback<RowSelectEventArgs<TValue>> rowSelected) => _rowSelected = rowSelected;

    private Task SelectRowAsync(TValue item)
    {
        return _rowSelected.HasDelegate
            ? _rowSelected.InvokeAsync(new RowSelectEventArgs<TValue> { Data = item })
            : Task.CompletedTask;
    }

    private static string FormatValue(object? value) => value switch
    {
        null => string.Empty,
        DateTime date => date.ToString("MMM d, yyyy"),
        DateOnly date => date.ToString("MMM d, yyyy"),
        decimal amount => amount.ToString("N2"),
        _ => value.ToString() ?? string.Empty
    };
}
