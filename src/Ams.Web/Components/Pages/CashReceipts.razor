@page "/finance/cash-receipts"
@inject ApiClient Api
@using Ams.Application.Common.Dtos
@using Ams.Web.Services
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons

<h3>Cash Receipts</h3>

<div class="mb-3 d-flex gap-2">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="300px" />
    <SfButton OnClick="LoadAsync">Search</SfButton>
</div>

<SfGrid DataSource="_items" AllowPaging="true">
    <GridPageSettings PageSize="10" />
    <GridColumns>
        <GridColumn Field="@nameof(CashReceiptEntryDto.CashReceiptEntryId)" HeaderText="ID" Width="220" />
        <GridColumn Field="@nameof(CashReceiptEntryDto.AccountId)" HeaderText="Account ID" Width="220" />
        <GridColumn Field="@nameof(CashReceiptEntryDto.ReceiptDate)" HeaderText="Receipt Date" Width="140" />
        <GridColumn Field="@nameof(CashReceiptEntryDto.Amount)" HeaderText="Amount" Format="C2" Width="120" />
        <GridColumn Field="@nameof(CashReceiptEntryDto.PaymentMethodCode)" HeaderText="Payment Method" Width="150" />
        <GridColumn Field="@nameof(CashReceiptEntryDto.ReferenceNumber)" HeaderText="Reference #" Width="140" />
        <GridColumn Field="@nameof(CashReceiptEntryDto.StatusCode)" HeaderText="Status" Width="120" />
        <GridColumn Field="@nameof(CashReceiptEntryDto.CreatedDateUtc)" HeaderText="Created" Width="160" />
    </GridColumns>
</SfGrid>

@code {
    private List<CashReceiptEntryDto>? _items;
    private string? _searchTerm;
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.SearchCashReceiptEntriesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
