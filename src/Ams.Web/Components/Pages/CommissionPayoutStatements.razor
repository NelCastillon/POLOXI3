@page "/commissions/payout-statements"
@page "/commissions/statements"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Commission Statements — AMS</PageTitle>

<AppPageHeader Title="Commission Statements"
               Subtitle="Review, approve, and distribute producer commission payout statements by period and payee"
               Icon="bi-file-earmark-text">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/producer-ledger")'>
            <i class="bi bi-journal-text" aria-hidden="true"></i> Producer Ledger
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/payout-batches")'>
            <i class="bi bi-box-seam" aria-hidden="true"></i> Payout Batches
        </button>
        <button class="um-btn um-btn-primary" @onclick="() => _showGenerate = true">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> Generate Statements
        </button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}

<!-- KPI strip -->
<div class="cs-kpi-strip">
    <div class="cs-kpi-card cs-ki-blue"><i class="bi bi-file-earmark-text cs-kpi-icon" aria-hidden="true"></i><div><div class="cs-kpi-val">@(_items?.Count ?? 0)</div><div class="cs-kpi-lbl">Statements</div></div></div>
    <div class="cs-kpi-card cs-ki-blue"><i class="bi bi-currency-dollar cs-kpi-icon" aria-hidden="true"></i><div><div class="cs-kpi-val">@Fmt(_items?.Sum(x=>x.GrossEarnings))</div><div class="cs-kpi-lbl">Gross Earnings</div></div></div>
    <div class="cs-kpi-card cs-ki-red"><i class="bi bi-arrow-return-left cs-kpi-icon" aria-hidden="true"></i><div><div class="cs-kpi-val">@Fmt(_items?.Sum(x=>x.TotalClawbacks))</div><div class="cs-kpi-lbl">Clawbacks</div></div></div>
    <div class="cs-kpi-card cs-ki-green"><i class="bi bi-cash-stack cs-kpi-icon" aria-hidden="true"></i><div><div class="cs-kpi-val">@Fmt(_items?.Sum(x=>x.NetPayout))</div><div class="cs-kpi-lbl">Net Payout</div></div></div>
    <div class="cs-kpi-card cs-ki-amber"><i class="bi bi-hourglass cs-kpi-icon" aria-hidden="true"></i><div><div class="cs-kpi-val">@(_items?.Count(x=>x.StatusCode=="Pending") ?? 0)</div><div class="cs-kpi-lbl">Pending</div></div></div>
    <div class="cs-kpi-card cs-ki-green"><i class="bi bi-check-circle cs-kpi-icon" aria-hidden="true"></i><div><div class="cs-kpi-val">@(_items?.Count(x=>x.StatusCode=="Issued") ?? 0)</div><div class="cs-kpi-lbl">Issued</div></div></div>
    <div class="cs-kpi-card cs-ki-blue"><i class="bi bi-people cs-kpi-icon" aria-hidden="true"></i><div><div class="cs-kpi-val">@(_items?.Select(x=>x.PayeeId).Distinct().Count() ?? 0)</div><div class="cs-kpi-lbl">Payees</div></div></div>
    <div class="cs-kpi-card cs-ki-green"><i class="bi bi-calendar-range cs-kpi-icon" aria-hidden="true"></i><div><div class="cs-kpi-val">@Fmt(_items?.Where(x=>x.StatementDate>=DateOnly.FromDateTime(DateTime.Today.AddDays(-30))).Sum(x=>x.NetPayout))</div><div class="cs-kpi-lbl">This Period</div></div></div>
</div>

<!-- Sub-nav -->
<div class="cs-subnav">
    <button class="cs-snav-btn cs-snav-active"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Statements</button>
    <button class="cs-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/producer-ledger")'><i class="bi bi-journal-text" aria-hidden="true"></i> Producer Ledger</button>
    <button class="cs-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/splits")'><i class="bi bi-scissors" aria-hidden="true"></i> Split Rules</button>
    <button class="cs-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/plans")'><i class="bi bi-clipboard-check" aria-hidden="true"></i> Comp Plans</button>
    <button class="cs-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/exceptions")'><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Exceptions</button>
    <button class="cs-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/forecast")'><i class="bi bi-graph-up" aria-hidden="true"></i> Forecast</button>
    <button class="cs-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/planner")'><i class="bi bi-calculator" aria-hidden="true"></i> What-If Planner</button>
</div>

<!-- Toolbar -->
<div class="cs-toolbar">
    <SfTextBox Placeholder="Search payee, period…" @bind-Value="_searchTerm" Width="270px"></SfTextBox>
    <select class="e-input cs-sel" @bind="_filterStatus">
        <option value="">All Statuses</option>
        <option value="Draft">Draft</option>
        <option value="Pending">Pending Approval</option>
        <option value="Approved">Approved</option>
        <option value="Issued">Issued</option>
        <option value="Voided">Voided</option>
    </select>
    <SfDatePicker TValue="DateTime?" @bind-Value="_filterFrom" Placeholder="From…" Width="150px"></SfDatePicker>
    <SfDatePicker TValue="DateTime?" @bind-Value="_filterTo"   Placeholder="To…"   Width="150px"></SfDatePicker>
    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync">
        <i class="bi bi-search" aria-hidden="true"></i>
    </button>
</div>

@if (_items is null)
{
    <div style="padding:2rem"><SfSpinner Visible="true" /></div>
}
else
{
<div class="cs-grid-wrap">
    <SfGrid DataSource="FilteredItems" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="15"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(CommissionPayoutStatementDto.StatementDate)" HeaderText="Period" Type="ColumnType.Date" Format="MMM yyyy" Width="120"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutStatementDto.GrossEarnings)" HeaderText="Gross" Format="C2" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
            <GridColumn HeaderText="Clawbacks" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>
                    @{ var s = (CommissionPayoutStatementDto)context; }
                    <span class="@(s.TotalClawbacks>0?"cs-clawback":"")">@s.TotalClawbacks.ToString("C2")</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutStatementDto.NetPayout)" HeaderText="Net Payout" Format="C2" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutStatementDto.CurrencyCode)" HeaderText="Ccy" Width="70"></GridColumn>
            <GridColumn HeaderText="Status" Width="120">
                <Template>
                    @{ var s2 = (CommissionPayoutStatementDto)context; }
                    <span class="cs-status-chip cs-st-@s2.StatusCode.ToLower()">@s2.StatusCode</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutStatementDto.IssuedDateUtc)" HeaderText="Issued" Type="ColumnType.DateTime" Format="d" Width="110"></GridColumn>
            <GridColumn HeaderText="Actions" Width="130">
                <Template>
                    @{ var s3 = (CommissionPayoutStatementDto)context; }
                    <div class="cs-row-acts">
                        <button class="um-btn um-btn-ghost um-btn-xs"
                                @onclick="() => NavToDetail(s3)"
                                title="Open statement">
                            <i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>
                        </button>
                        @if (s3.StatusCode == "Pending")
                        {
                            <button class="um-btn um-btn-primary um-btn-xs" title="Approve">
                                <i class="bi bi-check-circle" aria-hidden="true"></i> Approve
                            </button>
                        }
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>
}

<!-- Generate Statements Dialog -->
<SfDialog Width="560px" IsModal="true" @bind-Visible="_showGenerate" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i><span>Generate Commission Statements</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseGenerate"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_generateEditContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Pay Period Start <span class="text-danger">*</span></label><InputDate @bind-Value="_generateForm.PayPeriodStart" class="um-input" /><ValidationMessage For="() => _generateForm.PayPeriodStart" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Pay Period End <span class="text-danger">*</span></label><InputDate @bind-Value="_generateForm.PayPeriodEnd" class="um-input" /><ValidationMessage For="() => _generateForm.PayPeriodEnd" class="validation-message text-danger" /></div>
                    <div class="um-field um-field--full"><label>Payee Filter</label><InputText @bind-Value="_generateForm.PayeeFilter" class="um-input" placeholder="Leave blank for all payees…" /><ValidationMessage For="() => _generateForm.PayeeFilter" class="validation-message text-danger" /></div>
                    <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_generateForm.IncludeClawbacks" /> Apply pending clawbacks</label></div>
                    @if (!string.IsNullOrWhiteSpace(_generateFormError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_generateFormError</div> }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseGenerate">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="GenerateStatements">Generate</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private string _filterStatus = "";
    private DateTime? _filterFrom, _filterTo;
    private bool _showGenerate;
    private GenerateStatementsForm _generateForm = new();
    private EditContext _generateEditContext = default!;
    private string? _generateFormError;
    private string? _loadError;
    private List<CommissionPayoutStatementDto>? _items;

    private IEnumerable<CommissionPayoutStatementDto> FilteredItems => (_items ?? []).Where(x =>
        (string.IsNullOrEmpty(_filterStatus) || x.StatusCode == _filterStatus) &&
        (!_filterFrom.HasValue || x.StatementDate >= DateOnly.FromDateTime(_filterFrom.Value)) &&
        (!_filterTo.HasValue   || x.StatementDate <= DateOnly.FromDateTime(_filterTo.Value)));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        _generateEditContext = new(_generateForm);
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Commissions","/commissions"), new("Statements",""));
        await LoadAsync();
    }

    private void CloseGenerate() => _showGenerate = false;

    private void GenerateStatements()
    {
        _generateFormError = null;
        if (!_generateEditContext.Validate()) return;
        if (_generateForm.PayPeriodEnd < _generateForm.PayPeriodStart)
        {
            _generateFormError = "Pay Period End must be on or after Pay Period Start.";
            return;
        }
        _showGenerate = false;
    }

    private async Task LoadAsync()
    {
        try
        {
            _loadError = null;
            var result = await Api.SearchCommissionPayoutStatementsAsync(_tenantId, _searchTerm);
            _items = result?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _items = [];
        }
    }

    static string Fmt(decimal? v) => v.HasValue ? v.Value.ToString("C0") : "$0";

    void NavToDetail(CommissionPayoutStatementDto s) =>
        Nav.NavigateTo("/commissions/statements/" + s.StatementId);

    private sealed class GenerateStatementsForm
    {
        [Required] public DateTime PayPeriodStart { get; set; } = DateTime.Today.AddDays(-14);
        [Required] public DateTime PayPeriodEnd { get; set; } = DateTime.Today;
        [StringLength(200)] public string? PayeeFilter { get; set; }
        public bool IncludeClawbacks { get; set; } = true;
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
