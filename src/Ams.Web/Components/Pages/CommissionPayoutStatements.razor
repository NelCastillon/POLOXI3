@page "/commissions/payout-statements"
@inject ApiClient Api

<PageTitle>Commission Payout Statements</PageTitle>

<h1>Commission Payout Statements</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(CommissionPayoutStatementDto.StatementDate)" HeaderText="Statement Date" Type="ColumnType.Date" Format="d" Width="150"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutStatementDto.GrossEarnings)" HeaderText="Gross Earnings" Format="C2" Width="160"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutStatementDto.TotalClawbacks)" HeaderText="Clawbacks" Format="C2" Width="130"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutStatementDto.NetPayout)" HeaderText="Net Payout" Format="C2" Width="130"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutStatementDto.CurrencyCode)" HeaderText="Currency" Width="100"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutStatementDto.StatusCode)" HeaderText="Status" Width="120"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutStatementDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="g" Width="180"></GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<CommissionPayoutStatementDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchCommissionPayoutStatementsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<CommissionPayoutStatementDto>();
    }
}
