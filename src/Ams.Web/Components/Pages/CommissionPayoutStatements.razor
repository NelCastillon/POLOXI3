@page "/commissions/statements"
@page "/commissions/payout-statements"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Commissions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject IJSRuntime Js

<PageTitle>Commission Statements — AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="cs-toast cs-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="cs-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showStatusConfirm && _statusTarget is not null && !string.IsNullOrWhiteSpace(_pendingStatus))
{
    <div class="cs-modal-backdrop" role="presentation" @onclick="CancelStatusUpdate">
        <div class="cs-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="cs-status-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon @(_pendingStatus == "Voided" ? "um-confirm-icon--danger" : null)"><i class="bi @PendingStatusIcon" aria-hidden="true"></i></div>
                <div class="um-confirm-title" id="cs-status-title">@PendingStatusTitle</div>
                <div class="um-confirm-body">Mark statement <strong>@ShortId(_statusTarget.StatementId)</strong> as <strong>@_pendingStatus</strong>?</div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CancelStatusUpdate" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn @(_pendingStatus == "Voided" ? "um-btn-danger" : "um-btn-primary")" @onclick="ExecuteStatusUpdateAsync" disabled="@_busy">@PendingStatusAction</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="cs-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="cs-modal cs-action-modal" role="dialog" aria-modal="true" aria-labelledby="cs-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                <span id="cs-form-title">@(_editingId == Guid.Empty ? "New Commission Statement" : "Edit Commission Statement")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="cs-modal-intro"><span><i class="bi bi-shield-check" aria-hidden="true"></i> Statement workflow</span><p>Create or update producer payout statements using live commission payee and payout batch data.</p></div>
                    <div class="um-form-grid">
                        <div class="um-field">
                            <label>Payee <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.PayeeId"><option value="@Guid.Empty">Select payee...</option>@foreach (var payee in _payees) { <option value="@payee.PayeeId">@PayeeLabel(payee)</option> }</InputSelect>
                            <ValidationMessage For="() => _form.PayeeId" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Statement Date <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="_form.StatementDate" />
                            <ValidationMessage For="() => _form.StatementDate" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Gross Earnings <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_form.GrossEarnings" />
                            <ValidationMessage For="() => _form.GrossEarnings" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Clawbacks <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_form.TotalClawbacks" />
                            <ValidationMessage For="() => _form.TotalClawbacks" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Net Payout <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_form.NetPayout" />
                            <ValidationMessage For="() => _form.NetPayout" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Status <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.StatusCode">@foreach (var status in _statuses) { <option value="@status">@status</option> }</InputSelect>
                            <ValidationMessage For="() => _form.StatusCode" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Currency <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.CurrencyCode" />
                            <ValidationMessage For="() => _form.CurrencyCode" class="text-danger" />
                        </div>
                        <div class="um-field um-field--full cs-balance-preview"><span>Calculated net payout</span><strong>@FormatMoney(FormNetPayout)</strong><small>@FormatMoney(_form.GrossEarnings) gross minus @FormatMoney(_form.TotalClawbacks) clawbacks</small></div>
                        @if (!string.IsNullOrWhiteSpace(_formError))
                        {
                            <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">@if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } @(_editingId == Guid.Empty ? "Create Statement" : "Save Changes")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showGenerate)
{
    <div class="cs-modal-backdrop" role="presentation" @onclick="CloseGenerate">
        <div class="cs-modal cs-action-modal" role="dialog" aria-modal="true" aria-labelledby="cs-generate-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-file-earmark-plus" aria-hidden="true"></i>
                <span id="cs-generate-title">Generate Commission Statements</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseGenerate" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_generateForm" OnValidSubmit="GenerateStatementsAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="cs-modal-intro"><span><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Period generation</span><p>Generate payout statements from earned or approved commission transactions for the selected pay period.</p></div>
                    <div class="um-form-grid">
                        <div class="um-field"><label>Pay Period Start <span class="text-danger">*</span></label><InputDate class="form-control" @bind-Value="_generateForm.PayPeriodStart" /><ValidationMessage For="() => _generateForm.PayPeriodStart" class="text-danger" /></div>
                        <div class="um-field"><label>Pay Period End <span class="text-danger">*</span></label><InputDate class="form-control" @bind-Value="_generateForm.PayPeriodEnd" /><ValidationMessage For="() => _generateForm.PayPeriodEnd" class="text-danger" /></div>
                        <div class="um-field"><label>Payee Filter</label><InputSelect class="form-select" @bind-Value="_generateForm.PayeeId"><option value="">All payees</option>@foreach (var payee in _payees) { <option value="@payee.PayeeId">@PayeeLabel(payee)</option> }</InputSelect></div>
                        <div class="um-field"><label>Clawback %</label><InputNumber class="form-control" @bind-Value="_generateForm.ClawbackPercent" /><ValidationMessage For="() => _generateForm.ClawbackPercent" class="text-danger" /></div>
                        <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="_generateForm.StatusCode">@foreach (var status in _statuses.Where(x => x != "Voided")) { <option value="@status">@status</option> }</InputSelect><ValidationMessage For="() => _generateForm.StatusCode" class="text-danger" /></div>
                        <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_generateForm.IssueImmediately" /> Issue immediately</label></div>
                        @if (!string.IsNullOrWhiteSpace(_formError))
                        {
                            <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseGenerate" disabled="@_busy">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_busy">@if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } Generate</button></div>
            </EditForm>
        </div>
    </div>
}

<div class="cs-enterprise-page">
    <section class="cs-header">
        <div class="cs-header-left"><div class="cs-lob-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></div><div class="cs-header-info"><div class="cs-title-row"><h1 class="cs-page-title">Commission Statements</h1><span class="cs-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live statement data</span><span class="cs-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span></div><div class="cs-sub-row"><span>Review, approve, issue, and distribute producer commission payout statements.</span><span class="cs-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Seed sync enabled</span><span class="cs-sub-chip"><i class="bi bi-check2-circle" aria-hidden="true"></i> @_filtered.Count active matches</span></div></div></div>
        <div class="cs-header-actions"><button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions2")'><i class="bi bi-cash-coin" aria-hidden="true"></i> Commissions</button><button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/payout-batches")'><i class="bi bi-box-seam" aria-hidden="true"></i> Batches</button><button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="@RefreshIconClass" aria-hidden="true"></i> Refresh</button><button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync" disabled="@(!_filtered.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button><button type="button" class="um-btn um-btn-primary" @onclick="OpenGenerate"><i class="bi bi-plus-circle" aria-hidden="true"></i> Generate</button></div>
    </section>

    <section class="cs-kpi-strip" aria-label="Commission statement metrics">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="@KpiClass(kpi)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)"><span class="cs-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span><span class="cs-kpi-copy"><span class="cs-kpi-label">@kpi.Label</span><span class="cs-kpi-value">@kpi.Value</span><span class="cs-kpi-caption">@kpi.Caption</span></span></button>
        }
    </section>

    <section class="cs-workflow-strip" aria-label="Statement workflow shortcuts"><button type="button" class="cs-workflow-card cs-wf-generate" @onclick="OpenGenerate"><span class="cs-workflow-icon"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i></span><span class="cs-workflow-content"><strong>1</strong><span>Generate</span><small>Create period statements.</small></span></button><button type="button" class="cs-workflow-card cs-wf-approve" @onclick="ApproveSelected" disabled="@(!CanApproveSelected)"><span class="cs-workflow-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span><span class="cs-workflow-content"><strong>2</strong><span>Approve</span><small>Validate statement totals.</small></span></button><button type="button" class="cs-workflow-card cs-wf-issue" @onclick="IssueSelected" disabled="@(!CanIssueSelected)"><span class="cs-workflow-icon"><i class="bi bi-send-check" aria-hidden="true"></i></span><span class="cs-workflow-content"><strong>3</strong><span>Issue</span><small>Distribute to payees.</small></span></button><button type="button" class="cs-workflow-card cs-wf-ledger" @onclick='() => Nav.NavigateTo("/commissions/producer-ledger")'><span class="cs-workflow-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span><span class="cs-workflow-content"><strong>4</strong><span>Ledger</span><small>Audit producer earnings.</small></span></button><button type="button" class="cs-workflow-card cs-wf-batches" @onclick='() => Nav.NavigateTo("/commissions/payout-batches")'><span class="cs-workflow-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span><span class="cs-workflow-content"><strong>5</strong><span>Batches</span><small>Manage payment runs.</small></span></button><button type="button" class="cs-workflow-card cs-wf-exceptions" @onclick='() => Nav.NavigateTo("/commissions/exceptions")'><span class="cs-workflow-icon"><i class="bi bi-exclamation-circle" aria-hidden="true"></i></span><span class="cs-workflow-content"><strong>6</strong><span>Exceptions</span><small>Resolve disputes.</small></span></button></section>

    <section class="cs-enterprise-search" aria-label="Commission statement filters"><div class="cs-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div><div class="cs-search-body"><label for="cs-search">Search statements</label><input id="cs-search" class="cs-search-input" type="search" placeholder="Search payee, status, currency, period, amount..." @bind="SearchFilter" @bind:event="oninput" /><span class="cs-search-hint">Filters apply instantly across synchronized commission statements.</span></div><select class="cs-filter-select" @bind="StatusFilter" aria-label="Status filter"><option value="">All statuses</option>@foreach (var status in _statuses) { <option value="@status">@status</option> }</select><select class="cs-filter-select" @bind="PayeeFilter" aria-label="Payee filter"><option value="">All payees</option>@foreach (var payee in _payees) { <option value="@payee.PayeeId.ToString()">@PayeeLabel(payee)</option> }</select><div class="cs-search-result"><strong>@_filtered.Count</strong><span>matches</span></div></section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger cs-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
    }

    <section class="cs-content-layout"><div class="cs-grid-wrap"><div class="cs-grid-toolbar"><div><strong>Statement register</strong><span>@ActiveFilterText</span></div><div class="cs-toolbar-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-eraser" aria-hidden="true"></i> Reset</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ApproveSelected" disabled="@(!CanApproveSelected)"><i class="bi bi-check2-circle" aria-hidden="true"></i> Approve</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="IssueSelected" disabled="@(!CanIssueSelected)"><i class="bi bi-send-check" aria-hidden="true"></i> Issue</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add</button></div></div>
        @if (_loading)
        {
            <div class="cs-loading"><i class="bi bi-arrow-repeat cs-spin" aria-hidden="true"></i><strong>Loading commission statements...</strong><span>Syncing statement schema, seed data, payees, and payout batches.</span></div>
        }
        else if (!_filtered.Any())
        {
            <div class="cs-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No commission statements found</strong><span>Adjust filters or generate statements for the selected pay period.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenGenerate">Generate Statements</button></div>
        }
        else
        {
            <div class="cs-table-scroll"><table class="cs-table"><thead><tr><th>Statement</th><th>Payee</th><th>Period</th><th class="cs-number">Gross</th><th class="cs-number">Clawbacks</th><th class="cs-number">Net</th><th>Status</th><th class="cs-actions-col">Actions</th></tr></thead><tbody>@foreach (var item in PagedItems) { <tr class="@RowClass(item)" @onclick="() => SelectStatement(item)"><td><div class="cs-entry-cell"><span class="cs-entry-icon @StatusIconTone(item.StatusCode)"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span><span><strong>@ShortId(item.StatementId)</strong><span>@(item.IssuedDateUtc?.ToLocalTime().ToString("MMM d, yyyy") ?? "Not issued")</span></span></div></td><td>@PayeeName(item.PayeeId)</td><td>@item.StatementDate.ToString("MMM yyyy")</td><td class="cs-number">@FormatMoney(item.GrossEarnings)</td><td class="@ClawbackClass(item)">@FormatMoney(item.TotalClawbacks)</td><td class="cs-number cs-net">@FormatMoney(item.NetPayout)</td><td><span class="cs-status-chip @StatusCss(item.StatusCode)">@item.StatusCode</span></td><td><div class="cs-row-acts"><button type="button" class="um-btn um-btn-primary um-btn-xs" title="Open" @onclick:stopPropagation="true" @onclick="() => NavToDetail(item)"><i class="bi bi-arrow-up-right-square" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Edit" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Approve" @onclick:stopPropagation="true" @onclick='() => ConfirmStatusUpdate(item, "Approved")' disabled="@(!CanApprove(item))"><i class="bi bi-check2-circle" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Issue" @onclick:stopPropagation="true" @onclick='() => ConfirmStatusUpdate(item, "Issued")' disabled="@(!CanIssue(item))"><i class="bi bi-send-check" aria-hidden="true"></i></button></div></td></tr> }</tbody></table></div>
            <div class="cs-pager"><span>Showing @PageStart-@PageEnd of @_filtered.Count</span><div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PrevPage" disabled="@(_page == 1)">Previous</button><span>Page @_page of @TotalPages</span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button></div></div>
        }
    </div><aside class="cs-detail-panel" aria-label="Selected statement detail">@if (_selected is null) { <div class="cs-detail-empty"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a statement</strong><span>Choose a row to inspect payee, payout totals, issue status, and workflow actions.</span></div> } else { <div class="cs-detail-head"><div><span class="cs-detail-eyebrow"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Statement detail</span><h2>@FormatMoney(_selected.NetPayout)</h2><div class="cs-detail-meta"><span>@_selected.StatementDate.ToString("MMM yyyy")</span><span class="cs-status-chip @StatusCss(_selected.StatusCode)">@_selected.StatusCode</span></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></div><div class="cs-detail-body"><div class="cs-progress-card"><div><span>Statement readiness</span><strong>@ReadinessLabel(_selected)</strong></div><div class="cs-progress-track"><span style="width:@ReadinessPercent(_selected)%"></span></div></div><div class="cs-detail-summary"><div class="cs-meta-row"><span class="cs-meta-lbl">Payee</span><span class="cs-meta-val">@PayeeName(_selected.PayeeId)</span></div><div class="cs-meta-row"><span class="cs-meta-lbl">Batch</span><span class="cs-meta-val">@BatchLabel(_selected.PayoutBatchId)</span></div><div class="cs-meta-row"><span class="cs-meta-lbl">Gross</span><span class="cs-meta-val">@FormatMoney(_selected.GrossEarnings)</span></div><div class="cs-meta-row"><span class="cs-meta-lbl">Issued</span><span class="cs-meta-val">@(_selected.IssuedDateUtc?.ToLocalTime().ToString("MMM d, yyyy h:mm tt") ?? "Not issued")</span></div></div><div class="cs-note-card"><span><i class="bi bi-calculator" aria-hidden="true"></i> Payout calculation</span><p>@FormatMoney(_selected.GrossEarnings) gross minus @FormatMoney(_selected.TotalClawbacks) clawbacks equals @FormatMoney(_selected.NetPayout) net payout.</p></div><div class="cs-detail-actions"><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="ApproveSelected" disabled="@(!CanApproveSelected)"><i class="bi bi-check2-circle" aria-hidden="true"></i> Approve</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="IssueSelected" disabled="@(!CanIssueSelected)"><i class="bi bi-send-check" aria-hidden="true"></i> Issue</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, "Voided")' disabled="@(IsVoided(_selected))"><i class="bi bi-x-octagon" aria-hidden="true"></i> Void</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => NavToDetail(_selected)"><i class="bi bi-arrow-up-right-square" aria-hidden="true"></i> Open</button></div></div> }</aside></section>
</div>

@code {
    private const int PageSize = 12;
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<CommissionPayoutStatementDto> _items = [];
    private List<CommissionPayoutStatementDto> _filtered = [];
    private List<CommissionPayeeDto> _payees = [];
    private CommissionPayoutStatementDto? _selected;
    private CommissionPayoutStatementDto? _statusTarget;
    private StatementForm _form = new();
    private GenerateStatementsForm _generateForm = new();
    private Guid _editingId = Guid.Empty;
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private string _payeeFilter = string.Empty;
    private string _kpiFilter = "all";
    private string? _pendingStatus;
    private int _page = 1;
    private bool _loading;
    private bool _busy;
    private bool _showForm;
    private bool _showGenerate;
    private bool _showStatusConfirm;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string? _formError;
    private readonly List<string> _statuses = ["Draft", "Pending", "Approved", "Issued", "Voided"];

    private IEnumerable<CommissionPayoutStatementDto> PagedItems => _filtered.Skip((_page - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
    private int PageStart => _filtered.Count == 0 ? 0 : ((_page - 1) * PageSize) + 1;
    private int PageEnd => Math.Min(_filtered.Count, _page * PageSize);
    private decimal TotalNet => _items.Where(x => x.StatusCode != "Voided").Sum(x => x.NetPayout);
    private decimal TotalGross => _items.Where(x => x.StatusCode != "Voided").Sum(x => x.GrossEarnings);
    private decimal FormNetPayout => Math.Max(0, _form.GrossEarnings - _form.TotalClawbacks);
    private bool CanApproveSelected => _selected is not null && CanApprove(_selected);
    private bool CanIssueSelected => _selected is not null && CanIssue(_selected);
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", "info" => "bi-info-circle-fill", _ => "bi-check-circle-fill" };
    private string ActiveFilterText => _kpiFilter == "all" ? "All commission statements" : $"Filtered by {_kpiFilter}";
    private string PendingStatusIcon => _pendingStatus switch { "Approved" => "bi-check2-circle", "Issued" => "bi-send-check", "Voided" => "bi-x-octagon-fill", _ => "bi-arrow-repeat" };
    private string PendingStatusTitle => _pendingStatus switch { "Approved" => "Approve Statement", "Issued" => "Issue Statement", "Voided" => "Void Statement", _ => "Update Statement" };
    private string PendingStatusAction => _pendingStatus switch { "Approved" => "Approve", "Issued" => "Issue", "Voided" => "Void", _ => "Update" };
    private string RefreshIconClass => _loading ? "bi bi-arrow-repeat cs-spin" : "bi bi-arrow-clockwise";
    private IReadOnlyList<KpiModel> Kpis => [new("all", "Statements", _items.Count.ToString("N0"), "All statements", "bi-file-earmark-text", "cs-ki-blue"), new("pending", "Pending", _items.Count(x => x.StatusCode == "Pending").ToString("N0"), "Needs approval", "bi-hourglass", "cs-ki-amber"), new("approved", "Approved", _items.Count(x => x.StatusCode == "Approved").ToString("N0"), "Ready to issue", "bi-check2-circle", "cs-ki-cyan"), new("issued", "Issued", _items.Count(x => x.StatusCode == "Issued").ToString("N0"), "Distributed", "bi-send-check", "cs-ki-green"), new("gross", "Gross", FormatMoney(TotalGross), "Gross earnings", "bi-currency-dollar", "cs-ki-purple"), new("net", "Net Payout", FormatMoney(TotalNet), "Payable amount", "bi-cash-stack", "cs-ki-green")];
    private string SearchFilter { get => _searchTerm; set { _searchTerm = value; ApplyFilters(resetPage: true); } }
    private string StatusFilter { get => _statusFilter; set { _statusFilter = value; ApplyFilters(resetPage: true); } }
    private string PayeeFilter { get => _payeeFilter; set { _payeeFilter = value; ApplyFilters(resetPage: true); } }

    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Commissions", "/commissions2"), new("Payout Statements", "/commissions/payout-statements")); await LoadAsync(); }
    private async Task LoadAsync() { _loading = true; _loadError = null; try { await Api.EnsureCommissionSeedAsync(_tenantId, _tenantAdminUserId); await Api.EnsureCommissionPayoutBatchesSeedAsync(_tenantId); await Api.EnsureCommissionPayoutStatementsSeedAsync(_tenantId, _tenantAdminUserId); var payees = await Api.SearchCommissionPayeesAsync(_tenantId, string.Empty); _payees = payees?.Items.OrderBy(x => x.PayeeTypeCode).ToList() ?? []; Guid? payeeId = Guid.TryParse(_payeeFilter, out var parsedPayeeId) ? parsedPayeeId : null; var result = await Api.SearchCommissionPayoutStatementsAsync(_tenantId, string.Empty, _statusFilter, payeeId); _items = result?.Items.OrderByDescending(x => x.StatementDate).ToList() ?? []; ApplyFilters(resetPage: true); EnsureSelectedStillVisible(); } catch (Exception ex) { _loadError = $"Commission statements failed to load: {ex.Message}"; ShowToast(_loadError, "danger"); _items = []; _filtered = []; } finally { _loading = false; } }
    private void ApplyFilters(bool resetPage) { IEnumerable<CommissionPayoutStatementDto> query = _items; if (!string.IsNullOrWhiteSpace(_searchTerm)) { var term = _searchTerm.Trim(); query = query.Where(x => Contains(x.StatusCode, term) || Contains(PayeeName(x.PayeeId), term) || Contains(x.CurrencyCode, term) || Contains(x.StatementDate.ToString("yyyy-MM-dd"), term) || x.NetPayout.ToString("N2").Contains(term, StringComparison.OrdinalIgnoreCase)); } if (!string.IsNullOrWhiteSpace(_statusFilter)) query = query.Where(x => x.StatusCode == _statusFilter); if (!string.IsNullOrWhiteSpace(_payeeFilter) && Guid.TryParse(_payeeFilter, out var payeeId)) query = query.Where(x => x.PayeeId == payeeId); query = _kpiFilter switch { "pending" => query.Where(x => x.StatusCode == "Pending"), "approved" => query.Where(x => x.StatusCode == "Approved"), "issued" => query.Where(x => x.StatusCode == "Issued"), "gross" => query.Where(x => x.GrossEarnings > 0), "net" => query.Where(x => x.NetPayout > 0), _ => query }; _filtered = query.OrderBy(x => StatusSort(x.StatusCode)).ThenByDescending(x => x.StatementDate).ToList(); if (resetPage) _page = 1; if (_page > TotalPages) _page = TotalPages; }
    private void SetKpiFilter(string filter) { _kpiFilter = _kpiFilter == filter && filter != "all" ? "all" : filter; ApplyFilters(resetPage: true); }
    private void ResetFilters() { _searchTerm = string.Empty; _statusFilter = string.Empty; _payeeFilter = string.Empty; _kpiFilter = "all"; ApplyFilters(resetPage: true); ShowToast("Statement filters reset.", "info"); }
    private void SelectStatement(CommissionPayoutStatementDto item) => _selected = item;
    private void OpenCreate() { _editingId = Guid.Empty; _formError = null; var payee = _payees.FirstOrDefault(); _form = new StatementForm { PayeeId = payee?.PayeeId ?? Guid.Empty, StatementDate = DateTime.Today, GrossEarnings = 10000, TotalClawbacks = 0, NetPayout = 10000, StatusCode = "Draft", CurrencyCode = "USD" }; _showForm = true; if (!_payees.Any()) ShowToast("No commission payees are loaded yet. Refresh will seed payees if the database is empty.", "warning"); }
    private void OpenEdit(CommissionPayoutStatementDto item) { _editingId = item.StatementId; _formError = null; _form = new StatementForm { PayeeId = item.PayeeId, PayoutBatchId = item.PayoutBatchId, StatementDate = item.StatementDate.ToDateTime(TimeOnly.MinValue), GrossEarnings = item.GrossEarnings, TotalClawbacks = item.TotalClawbacks, NetPayout = item.NetPayout, CurrencyCode = item.CurrencyCode, StatusCode = item.StatusCode, IssuedDateUtc = item.IssuedDateUtc }; _showForm = true; }
    private void CloseForm() { if (_busy) return; _showForm = false; }
    private async Task SaveAsync() { if (!ValidateStatementForm()) return; _busy = true; _formError = null; var savedId = _editingId; try { var net = _form.NetPayout > 0 ? _form.NetPayout : FormNetPayout; if (_editingId == Guid.Empty) { savedId = await Api.CreateCommissionPayoutStatementAsync(new CreateCommissionPayoutStatementRequest { TenantId = _tenantId, PayeeId = _form.PayeeId, PayoutBatchId = _form.PayoutBatchId, StatementDate = DateOnly.FromDateTime(_form.StatementDate), GrossEarnings = _form.GrossEarnings, TotalClawbacks = _form.TotalClawbacks, NetPayout = net, CurrencyCode = _form.CurrencyCode.Trim().ToUpperInvariant(), StatusCode = _form.StatusCode, IssuedDateUtc = _form.StatusCode == "Issued" ? DateTime.UtcNow : _form.IssuedDateUtc, CreatedByUserId = _tenantAdminUserId }); ShowToast("Commission statement created.", "success"); } else { await Api.UpdateCommissionPayoutStatementAsync(_editingId, new UpdateCommissionPayoutStatementRequest { TenantId = _tenantId, StatementId = _editingId, PayeeId = _form.PayeeId, PayoutBatchId = _form.PayoutBatchId, StatementDate = DateOnly.FromDateTime(_form.StatementDate), GrossEarnings = _form.GrossEarnings, TotalClawbacks = _form.TotalClawbacks, NetPayout = net, CurrencyCode = _form.CurrencyCode.Trim().ToUpperInvariant(), StatusCode = _form.StatusCode, IssuedDateUtc = _form.StatusCode == "Issued" ? (_form.IssuedDateUtc ?? DateTime.UtcNow) : _form.IssuedDateUtc, ModifiedByUserId = _tenantAdminUserId }); ShowToast("Commission statement updated.", "success"); } _showForm = false; await LoadAsync(); _selected = _items.FirstOrDefault(x => x.StatementId == savedId) ?? _selected; } catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; ShowToast(_formError, "danger"); } finally { _busy = false; } }
    private void OpenGenerate() { _formError = null; _generateForm = new GenerateStatementsForm(); _showGenerate = true; if (!_payees.Any()) ShowToast("Payees will be seeded automatically before generation if none exist.", "info"); }
    private void CloseGenerate() { if (_busy) return; _showGenerate = false; }
    private async Task GenerateStatementsAsync() { if (!ValidateGenerateForm()) return; _busy = true; _formError = null; try { var ids = await Api.GenerateCommissionPayoutStatementsAsync(new GenerateCommissionPayoutStatementsRequest { TenantId = _tenantId, PayPeriodStart = DateOnly.FromDateTime(_generateForm.PayPeriodStart), PayPeriodEnd = DateOnly.FromDateTime(_generateForm.PayPeriodEnd), PayeeId = _generateForm.PayeeId, ClawbackPercent = _generateForm.ClawbackPercent, StatusCode = _generateForm.StatusCode, IssueImmediately = _generateForm.IssueImmediately, CreatedByUserId = _tenantAdminUserId }); _showGenerate = false; ShowToast(ids?.Count > 0 ? $"Generated {ids.Count:N0} commission statements." : "Statements were already generated for that period/payee.", ids?.Count > 0 ? "success" : "info"); await LoadAsync(); } catch (Exception ex) { _formError = $"Generate failed: {ex.Message}"; ShowToast(_formError, "danger"); } finally { _busy = false; } }
    private void ApproveSelected() { if (_selected is not null) ConfirmStatusUpdate(_selected, "Approved"); }
    private void IssueSelected() { if (_selected is not null) ConfirmStatusUpdate(_selected, "Issued"); }
    private void ConfirmStatusUpdate(CommissionPayoutStatementDto item, string status) { _statusTarget = item; _pendingStatus = status; _showStatusConfirm = true; }
    private void CancelStatusUpdate() { if (_busy) return; _showStatusConfirm = false; _statusTarget = null; _pendingStatus = null; }
    private async Task ExecuteStatusUpdateAsync() { if (_statusTarget is null || string.IsNullOrWhiteSpace(_pendingStatus)) return; if (!IsAllowedStatusChange(_statusTarget, _pendingStatus)) { ShowToast($"Cannot mark a {_statusTarget.StatusCode} statement as {_pendingStatus}.", "warning"); CancelStatusUpdate(); return; } _busy = true; var selectedId = _statusTarget.StatementId; try { await Api.UpdateCommissionPayoutStatementAsync(_statusTarget.StatementId, new UpdateCommissionPayoutStatementRequest { TenantId = _tenantId, StatementId = _statusTarget.StatementId, PayeeId = _statusTarget.PayeeId, PayoutBatchId = _statusTarget.PayoutBatchId, StatementDate = _statusTarget.StatementDate, GrossEarnings = _statusTarget.GrossEarnings, TotalClawbacks = _statusTarget.TotalClawbacks, NetPayout = _statusTarget.NetPayout, CurrencyCode = _statusTarget.CurrencyCode, StatusCode = _pendingStatus, IssuedDateUtc = _pendingStatus == "Issued" ? DateTime.UtcNow : _statusTarget.IssuedDateUtc, ModifiedByUserId = _tenantAdminUserId }); ShowToast($"Statement marked {_pendingStatus.ToLowerInvariant()}.", "success"); _showStatusConfirm = false; _statusTarget = null; _pendingStatus = null; await LoadAsync(); _selected = _items.FirstOrDefault(x => x.StatementId == selectedId) ?? _selected; } catch (Exception ex) { ShowToast($"Update failed: {ex.Message}", "danger"); } finally { _busy = false; } }
    private Task NotifyValidationAsync(EditContext _) { ShowToast("Please correct validation errors before saving.", "warning"); return Task.CompletedTask; }
    private async Task ExportAsync() { if (!_filtered.Any()) { ShowToast("No commission statements are available to export.", "warning"); return; } var csv = new StringBuilder(); csv.AppendLine("StatementId,Payee,StatementDate,GrossEarnings,TotalClawbacks,NetPayout,Currency,Status,IssuedDateUtc,BatchId"); foreach (var item in _filtered) csv.AppendLine(string.Join(',', Csv(item.StatementId.ToString()), Csv(PayeeName(item.PayeeId)), Csv(item.StatementDate.ToString("yyyy-MM-dd")), item.GrossEarnings, item.TotalClawbacks, item.NetPayout, Csv(item.CurrencyCode), Csv(item.StatusCode), Csv(item.IssuedDateUtc?.ToString("O") ?? string.Empty), Csv(item.PayoutBatchId?.ToString() ?? string.Empty))); var bytes = Encoding.UTF8.GetBytes(csv.ToString()); await Js.InvokeVoidAsync("amsShell.downloadBase64", $"commission-statements-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes)); ShowToast($"Exported {_filtered.Count:N0} commission statements.", "success"); }
    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind) { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void EnsureSelectedStillVisible() => _selected = _selected is null ? _filtered.FirstOrDefault() : _items.FirstOrDefault(x => x.StatementId == _selected.StatementId) ?? _filtered.FirstOrDefault();
    private void NavToDetail(CommissionPayoutStatementDto item) => Nav.NavigateTo($"/commissions/statements/{item.StatementId}");
    private string PayeeName(Guid payeeId) { var payee = _payees.FirstOrDefault(x => x.PayeeId == payeeId); return payee is null ? ShortId(payeeId) : PayeeLabel(payee); }
    private string PayeeLabel(CommissionPayeeDto payee) => $"{payee.PayeeTypeCode} · {payee.SplitPercentage:N2}%";
    private static string BatchLabel(Guid? batchId) => batchId is null || batchId == Guid.Empty ? "No batch" : ShortId(batchId.Value);
    private static bool Contains(string? value, string term) => value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
    private static int StatusSort(string status) => status switch { "Draft" => 0, "Pending" => 1, "Approved" => 2, "Issued" => 3, "Voided" => 4, _ => 5 };
    private static bool CanApprove(CommissionPayoutStatementDto item) => item.StatusCode is "Draft" or "Pending";
    private static bool CanIssue(CommissionPayoutStatementDto item) => item.StatusCode == "Approved";
    private static bool IsVoided(CommissionPayoutStatementDto item) => item.StatusCode == "Voided";
    private static int ReadinessPercent(CommissionPayoutStatementDto item) => item.StatusCode switch { "Issued" => 100, "Approved" => 75, "Pending" => 45, "Draft" => 20, _ => 0 };
    private static string ReadinessLabel(CommissionPayoutStatementDto item) => item.StatusCode switch { "Issued" => "Issued", "Approved" => "Ready", "Pending" => "Review", "Draft" => "Draft", _ => "Blocked" };
    private static string StatusCss(string status) => $"cs-st-{status.ToLowerInvariant()}";
    private static string StatusIconTone(string status) => status switch { "Issued" => "cs-di-green", "Approved" => "cs-di-cyan", "Voided" => "cs-di-red", "Pending" => "cs-di-amber", _ => "cs-di-blue" };
    private static string FormatMoney(decimal value) => value.ToString("C0");
    private static string ShortId(Guid value) => value.ToString("N")[..8];
    private static string Csv(string value) { var quote = Convert.ToChar(34).ToString(); return string.Concat(quote, value.Replace(quote, quote + quote), quote); }
    private string KpiClass(KpiModel kpi) => $"cs-kpi-card {kpi.Tone} {(_kpiFilter == kpi.Filter ? "cs-kpi-active" : string.Empty)}";
    private string RowClass(CommissionPayoutStatementDto item) => $"cs-table-row {(_selected?.StatementId == item.StatementId ? "cs-table-row--selected" : string.Empty)}";
    private static string ClawbackClass(CommissionPayoutStatementDto item) => item.TotalClawbacks > 0 ? "cs-number cs-clawback" : "cs-number";
    private bool ValidateStatementForm() { if (_form.PayeeId == Guid.Empty) { _formError = "Payee is required."; ShowToast(_formError, "warning"); return false; } if (!_payees.Any(x => x.PayeeId == _form.PayeeId)) { _formError = "Selected payee is not available. Refresh and try again."; ShowToast(_formError, "warning"); return false; } if (_form.GrossEarnings < 0 || _form.TotalClawbacks < 0 || _form.NetPayout < 0) { _formError = "Amounts cannot be negative."; ShowToast(_formError, "warning"); return false; } if (_form.TotalClawbacks > _form.GrossEarnings) { _formError = "Clawbacks cannot exceed gross earnings."; ShowToast(_formError, "warning"); return false; } if (string.IsNullOrWhiteSpace(_form.CurrencyCode) || _form.CurrencyCode.Trim().Length != 3) { _formError = "Currency must be a three-character code."; ShowToast(_formError, "warning"); return false; } return true; }
    private bool ValidateGenerateForm() { if (_generateForm.PayPeriodEnd < _generateForm.PayPeriodStart) { _formError = "Pay Period End must be on or after Pay Period Start."; ShowToast(_formError, "warning"); return false; } if (_generateForm.ClawbackPercent < 0 || _generateForm.ClawbackPercent > 100) { _formError = "Clawback percent must be between 0 and 100."; ShowToast(_formError, "warning"); return false; } return true; }
    private static bool IsAllowedStatusChange(CommissionPayoutStatementDto item, string status) => status switch { "Approved" => CanApprove(item), "Issued" => CanIssue(item), "Voided" => !IsVoided(item), _ => true };
    private async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; }
    private sealed record KpiModel(string Filter, string Label, string Value, string Caption, string Icon, string Tone) { public string Title => $"Filter statements by {Label}"; }

    private sealed class StatementForm { [RequiredGuid(ErrorMessage = "Payee is required.")] public Guid PayeeId { get; set; } public Guid? PayoutBatchId { get; set; } [Required] public DateTime StatementDate { get; set; } = DateTime.Today; [Range(0, 100000000)] public decimal GrossEarnings { get; set; } [Range(0, 100000000)] public decimal TotalClawbacks { get; set; } [Range(0, 100000000)] public decimal NetPayout { get; set; } [Required, StringLength(3)] public string CurrencyCode { get; set; } = "USD"; [Required, StringLength(50)] public string StatusCode { get; set; } = "Draft"; public DateTime? IssuedDateUtc { get; set; } }
    private sealed class GenerateStatementsForm { [Required] public DateTime PayPeriodStart { get; set; } = DateTime.Today.AddDays(-14); [Required] public DateTime PayPeriodEnd { get; set; } = DateTime.Today; public Guid? PayeeId { get; set; } [Range(0, 100)] public decimal ClawbackPercent { get; set; } [Required, StringLength(50)] public string StatusCode { get; set; } = "Draft"; public bool IssueImmediately { get; set; } }
}
