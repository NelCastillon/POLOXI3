@page "/security"
@namespace Ams.Web.Components.Pages.SecurityAdmin
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@using Ams.Application.Features.Iam

<PageTitle>Security &amp; Access Management</PageTitle>

<AppPageHeader Title="Security & Access Management" Icon="bi-shield-lock" />

<AppTab>
    <TabItems>

        @* -- 1. Roles ------------------------------------------- *@
        <TabItem>
            <ChildContent><TabHeader Text="Roles"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <AppTextBox Placeholder="Search roles..." @bind-Value="_roleSearch" Width="280px"></AppTextBox>
                    <AppButton CssClass="e-primary" OnClick="LoadRolesAsync">Search</AppButton>
                    <AppButton CssClass="e-success" OnClick="OpenNewRole">New Role</AppButton>
                </div>
                @if (_roles is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
                else
                {
                    <AppGrid DataSource="_roles" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridEvents RowSelected="OnRoleSelected" TValue="RoleDto"></GridEvents>
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(RoleDto.RoleCode)" HeaderText="Code" Width="140"></GridColumn>
                            <GridColumn Field="@nameof(RoleDto.RoleName)" HeaderText="Name" Width="180"></GridColumn>
                            <GridColumn Field="@nameof(RoleDto.RoleTypeCode)" HeaderText="Type" Width="110"></GridColumn>
                            <GridColumn Field="@nameof(RoleDto.SortOrder)" HeaderText="Order" Width="80" TextAlign=@("Center")></GridColumn>
                            <GridColumn Field="@nameof(RoleDto.PermissionCount)" HeaderText="Permissions" Width="110" TextAlign=@("Center")></GridColumn>
                            <GridColumn Field="@nameof(RoleDto.UserCount)" HeaderText="Users" Width="80" TextAlign=@("Center")></GridColumn>
                            <GridColumn Field="@nameof(RoleDto.IsBuiltIn)" HeaderText="Built-In" Width="90" Type="ColumnType.Boolean"></GridColumn>
                            <GridColumn Field="@nameof(RoleDto.IsActive)" HeaderText="Active" Width="80" Type="ColumnType.Boolean"></GridColumn>
                            <GridColumn Field="@nameof(RoleDto.CreatedDateUtc)" HeaderText="Created"  Format="yyyy-MM-dd" Width="120"></GridColumn>
                        </GridColumns>
                    </AppGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* -- 2. Users -------------------------------------------- *@
        <TabItem>
            <ChildContent><TabHeader Text="Users"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <AppTextBox Placeholder="Search users..." @bind-Value="_userSearch" Width="280px"></AppTextBox>
                    <AppButton CssClass="e-primary" OnClick="LoadUsersAsync">Search</AppButton>
                    <AppButton CssClass="e-success" OnClick="OpenNewUser">New User</AppButton>
                </div>
                @if (_users is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
                else
                {
                    <AppGrid DataSource="_users" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridEvents RowSelected="OnUserSelected" TValue="UserDto"></GridEvents>
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(UserDto.FullName)" HeaderText="Full Name" Width="180"></GridColumn>
                            <GridColumn Field="@nameof(UserDto.UserName)" HeaderText="Username" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(UserDto.Email)" HeaderText="Email" Width="200"></GridColumn>
                            <GridColumn Field="@nameof(UserDto.UserTypeCode)" HeaderText="Type" Width="110"></GridColumn>
                            <GridColumn Field="@nameof(UserDto.Department)" HeaderText="Department" Width="140"></GridColumn>
                            <GridColumn Field="@nameof(UserDto.JobTitle)" HeaderText="Job Title" Width="140"></GridColumn>
                            <GridColumn Field="@nameof(UserDto.AssignedRoleCount)" HeaderText="Roles" Width="80" TextAlign=@("Center")></GridColumn>
                            <GridColumn Field="@nameof(UserDto.IsLockedOut)" HeaderText="Locked" Width="80" Type="ColumnType.Boolean"></GridColumn>
                            <GridColumn Field="@nameof(UserDto.StatusCode)" HeaderText="Status" Width="100"></GridColumn>
                            <GridColumn Field="@nameof(UserDto.LastLoginDateUtc)" HeaderText="Last Login"  Format="yyyy-MM-dd HH:mm" Width="150"></GridColumn>
                        </GridColumns>
                    </AppGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* -- 3. Permissions -------------------------------------- *@
        <TabItem>
            <ChildContent><TabHeader Text="Permissions"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <AppTextBox Placeholder="Search permissions..." @bind-Value="_permSearch" Width="260px"></AppTextBox>
                    <AppTextBox Placeholder="Resource code..." @bind-Value="_permResourceFilter" Width="180px"></AppTextBox>
                    <AppButton CssClass="e-primary" OnClick="LoadPermissionsAsync">Search</AppButton>
                    <AppButton CssClass="e-success" OnClick="OpenNewPermission">New Permission</AppButton>
                </div>
                @if (_permissions is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
                else
                {
                    <AppGrid DataSource="_permissions" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(PermissionDto.PermissionCode)" HeaderText="Code" Width="180"></GridColumn>
                            <GridColumn Field="@nameof(PermissionDto.PermissionName)" HeaderText="Name" Width="200"></GridColumn>
                            <GridColumn Field="@nameof(PermissionDto.ResourceCode)" HeaderText="Resource" Width="140"></GridColumn>
                            <GridColumn Field="@nameof(PermissionDto.ActionCode)" HeaderText="Action" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(PermissionDto.IsBuiltIn)" HeaderText="Built-In" Width="90" Type="ColumnType.Boolean"></GridColumn>
                            <GridColumn Field="@nameof(PermissionDto.RoleCount)" HeaderText="Roles" Width="80" TextAlign=@("Center")></GridColumn>
                            <GridColumn Field="@nameof(PermissionDto.IsActive)" HeaderText="Active" Width="80" Type="ColumnType.Boolean"></GridColumn>
                            <GridColumn Field="@nameof(PermissionDto.CreatedDateUtc)" HeaderText="Created"  Format="yyyy-MM-dd" Width="120"></GridColumn>
                        </GridColumns>
                    </AppGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* -- 4. User-Role Assignments ---------------------------- *@
        <TabItem>
            <ChildContent><TabHeader Text="User-Role Assignments"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <AppButton CssClass="e-primary" OnClick="LoadUserRolesAsync">Refresh</AppButton>
                    <AppButton CssClass="e-success" OnClick="OpenNewUserRole">Assign Role</AppButton>
                </div>
                @if (_userRoles is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
                else
                {
                    <AppGrid DataSource="_userRoles" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(UserRoleDto.UserFullName)" HeaderText="User" Width="180"></GridColumn>
                            <GridColumn Field="@nameof(UserRoleDto.UserName)" HeaderText="Username" Width="150"></GridColumn>
                            <GridColumn Field="@nameof(UserRoleDto.RoleName)" HeaderText="Role" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(UserRoleDto.RoleCode)" HeaderText="Role Code" Width="130"></GridColumn>
                            <GridColumn Field="@nameof(UserRoleDto.AssignedByFullName)" HeaderText="Assigned By" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(UserRoleDto.EffectiveStartDateUtc)" HeaderText="Effective Start"  Format="yyyy-MM-dd" Width="140"></GridColumn>
                            <GridColumn Field="@nameof(UserRoleDto.EffectiveEndDateUtc)" HeaderText="Effective End"  Format="yyyy-MM-dd" Width="130"></GridColumn>
                            <GridColumn Field="@nameof(UserRoleDto.IsActive)" HeaderText="Active" Width="80" Type="ColumnType.Boolean"></GridColumn>
                        </GridColumns>
                    </AppGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* -- 5. Scopes ------------------------------------------- *@
        <TabItem>
            <ChildContent><TabHeader Text="Scopes"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <AppTextBox Placeholder="Scope type code..." @bind-Value="_scopeTypeFilter" Width="200px"></AppTextBox>
                    <AppButton CssClass="e-primary" OnClick="LoadScopesAsync">Search</AppButton>
                    <AppButton CssClass="e-success" OnClick="OpenNewScope">Assign Scope</AppButton>
                </div>
                @if (_scopes is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
                else
                {
                    <AppGrid DataSource="_scopes" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(UserScopeDto.UserFullName)" HeaderText="User" Width="180"></GridColumn>
                            <GridColumn Field="@nameof(UserScopeDto.ScopeTypeCode)" HeaderText="Scope Type" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(UserScopeDto.ScopeValue)" HeaderText="Scope Value" Width="200"></GridColumn>
                            <GridColumn Field="@nameof(UserScopeDto.GrantedByFullName)" HeaderText="Granted By" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(UserScopeDto.GrantedDateUtc)" HeaderText="Granted"  Format="yyyy-MM-dd" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(UserScopeDto.ExpiresDateUtc)" HeaderText="Expires"  Format="yyyy-MM-dd" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(UserScopeDto.IsActive)" HeaderText="Active" Width="80" Type="ColumnType.Boolean"></GridColumn>
                        </GridColumns>
                    </AppGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* -- 6. Security Policies -------------------------------- *@
        <TabItem>
            <ChildContent><TabHeader Text="Security Policies"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <AppTextBox Placeholder="Search policies..." @bind-Value="_policySearch" Width="260px"></AppTextBox>
                    <AppTextBox Placeholder="Resource code..." @bind-Value="_policyResourceFilter" Width="180px"></AppTextBox>
                    <AppButton CssClass="e-primary" OnClick="LoadSecurityPoliciesAsync">Search</AppButton>
                    <AppButton CssClass="e-success" OnClick="OpenNewSecurityPolicy">New Policy</AppButton>
                </div>
                @if (_securityPolicies is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
                else
                {
                    <AppGrid DataSource="_securityPolicies" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(SecurityPolicyDto.PolicyCode)" HeaderText="Code" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(SecurityPolicyDto.PolicyName)" HeaderText="Name" Width="200"></GridColumn>
                            <GridColumn Field="@nameof(SecurityPolicyDto.ResourceCode)" HeaderText="Resource" Width="130"></GridColumn>
                            <GridColumn Field="@nameof(SecurityPolicyDto.ActionCode)" HeaderText="Action" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(SecurityPolicyDto.SeverityCode)" HeaderText="Severity" Width="100"></GridColumn>
                            <GridColumn Field="@nameof(SecurityPolicyDto.ConditionExpression)" HeaderText="Condition" Width="260"></GridColumn>
                            <GridColumn Field="@nameof(SecurityPolicyDto.IsSystemPolicy)" HeaderText="System" Width="85" Type="ColumnType.Boolean"></GridColumn>
                            <GridColumn Field="@nameof(SecurityPolicyDto.IsActive)" HeaderText="Active" Width="80" Type="ColumnType.Boolean"></GridColumn>
                        </GridColumns>
                    </AppGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* -- 7. Field Policies ----------------------------------- *@
        <TabItem>
            <ChildContent><TabHeader Text="Field Policies"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <AppButton CssClass="e-primary" OnClick="LoadFieldPoliciesAsync">Refresh</AppButton>
                </div>
                @if (_fieldPolicies is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
                else
                {
                    <AppGrid DataSource="_fieldPolicies" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(FieldSecurityPolicyDto.RoleName)" HeaderText="Role" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(FieldSecurityPolicyDto.EntityName)" HeaderText="Entity" Width="150"></GridColumn>
                            <GridColumn Field="@nameof(FieldSecurityPolicyDto.FieldName)" HeaderText="Field" Width="150"></GridColumn>
                            <GridColumn Field="@nameof(FieldSecurityPolicyDto.CanRead)" HeaderText="Read" Width="80" Type="ColumnType.Boolean"></GridColumn>
                            <GridColumn Field="@nameof(FieldSecurityPolicyDto.CanWrite)" HeaderText="Write" Width="80" Type="ColumnType.Boolean"></GridColumn>
                            <GridColumn Field="@nameof(FieldSecurityPolicyDto.IsHidden)" HeaderText="Hidden" Width="85" Type="ColumnType.Boolean"></GridColumn>
                            <GridColumn Field="@nameof(FieldSecurityPolicyDto.CreatedDateUtc)" HeaderText="Created"  Format="yyyy-MM-dd" Width="120"></GridColumn>
                        </GridColumns>
                    </AppGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* -- 8. Record Policies ---------------------------------- *@
        <TabItem>
            <ChildContent><TabHeader Text="Record Policies"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <AppButton CssClass="e-primary" OnClick="LoadRecordPoliciesAsync">Refresh</AppButton>
                </div>
                @if (_recordPolicies is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
                else
                {
                    <AppGrid DataSource="_recordPolicies" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(RecordSecurityPolicyDto.RoleName)" HeaderText="Role" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(RecordSecurityPolicyDto.EntityName)" HeaderText="Entity" Width="150"></GridColumn>
                            <GridColumn Field="@nameof(RecordSecurityPolicyDto.PolicyTypeCode)" HeaderText="Policy Type" Width="130"></GridColumn>
                            <GridColumn Field="@nameof(RecordSecurityPolicyDto.FilterExpression)" HeaderText="Filter Expression" Width="300"></GridColumn>
                            <GridColumn Field="@nameof(RecordSecurityPolicyDto.IsActive)" HeaderText="Active" Width="80" Type="ColumnType.Boolean"></GridColumn>
                            <GridColumn Field="@nameof(RecordSecurityPolicyDto.CreatedDateUtc)" HeaderText="Created"  Format="yyyy-MM-dd" Width="120"></GridColumn>
                        </GridColumns>
                    </AppGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* -- 9. Privileged Access -------------------------------- *@
        <TabItem>
            <ChildContent><TabHeader Text="Privileged Access"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <AppButton CssClass="e-primary" OnClick="LoadPrivilegedAccessAsync">Refresh</AppButton>
                </div>
                @if (_pamRequests is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
                else
                {
                    <AppGrid DataSource="_pamRequests" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(PrivilegedAccessRequestDto.RequestedByFullName)" HeaderText="Requested By" Width="170"></GridColumn>
                            <GridColumn Field="@nameof(PrivilegedAccessRequestDto.TargetRoleName)" HeaderText="Target Role" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(PrivilegedAccessRequestDto.JustificationText)" HeaderText="Justification" Width="240"></GridColumn>
                            <GridColumn Field="@nameof(PrivilegedAccessRequestDto.StatusCode)" HeaderText="Status" Width="110"></GridColumn>
                            <GridColumn Field="@nameof(PrivilegedAccessRequestDto.RequestedStartDateUtc)" HeaderText="Start"  Format="yyyy-MM-dd" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(PrivilegedAccessRequestDto.RequestedEndDateUtc)" HeaderText="End"  Format="yyyy-MM-dd" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(PrivilegedAccessRequestDto.ApprovedByFullName)" HeaderText="Approved By" Width="150"></GridColumn>
                            <GridColumn Field="@nameof(PrivilegedAccessRequestDto.ApprovalDateUtc)" HeaderText="Approval Date"  Format="yyyy-MM-dd" Width="130"></GridColumn>
                        </GridColumns>
                    </AppGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* -- 10. Access Reviews ---------------------------------- *@
        <TabItem>
            <ChildContent><TabHeader Text="Access Reviews"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <AppButton CssClass="e-primary" OnClick="LoadAccessReviewsAsync">Refresh</AppButton>
                </div>
                @if (_accessReviews is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
                else
                {
                    <AppGrid DataSource="_accessReviews" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(UserAccessReviewDto.SubjectFullName)" HeaderText="Subject User" Width="170"></GridColumn>
                            <GridColumn Field="@nameof(UserAccessReviewDto.ReviewerFullName)" HeaderText="Reviewer" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(UserAccessReviewDto.RoleName)" HeaderText="Role" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(UserAccessReviewDto.ReviewCycleCode)" HeaderText="Cycle" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(UserAccessReviewDto.DecisionCode)" HeaderText="Decision" Width="110"></GridColumn>
                            <GridColumn Field="@nameof(UserAccessReviewDto.StatusCode)" HeaderText="Status" Width="110"></GridColumn>
                            <GridColumn Field="@nameof(UserAccessReviewDto.DueByDateUtc)" HeaderText="Due By"  Format="yyyy-MM-dd" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(UserAccessReviewDto.ReviewedDateUtc)" HeaderText="Reviewed"  Format="yyyy-MM-dd" Width="120"></GridColumn>
                        </GridColumns>
                    </AppGrid>
                }
            </ContentTemplate>
        </TabItem>

    </TabItems>
</AppTab>

@* -- Role Dialog --------------------------------------------- *@
<AppModal Width="500px" IsModal="true" @bind-Visible="_showRoleDialog" Header="@(_isEditingRole ? "Edit Role" : "New Role")">
    <DialogTemplates>
        <Content>
            <div style="display:flex;flex-direction:column;gap:12px;padding:4px;">
                <label>Role Code</label>
                <AppTextBox @bind-Value="_roleForm.RoleCode"></AppTextBox>
                <label>Role Name</label>
                <AppTextBox @bind-Value="_roleForm.RoleName"></AppTextBox>
                <label>Role Type</label>
                <AppSelect TItem="string" TValue="string" DataSource="_roleTypes" @bind-Value="_roleForm.RoleTypeCode" Width="100%"></AppSelect>
                <label>Description</label>
                <AppTextBox @bind-Value="_roleForm.Description" Multiline="true"></AppTextBox>
                <label>Sort Order</label>
                <AppNumericTextBox TValue="int" @bind-Value="_roleForm.SortOrder" Min="0" Max="9999" Format="N0"></AppNumericTextBox>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Save" IsPrimary="true" OnClick="SaveRoleAsync"></DialogButton>
        <DialogButton Content="Cancel" OnClick="() => _showRoleDialog = false"></DialogButton>
    </DialogButtons>
</AppModal>

@* -- User Dialog --------------------------------------------- *@
<AppModal Width="560px" IsModal="true" @bind-Visible="_showUserDialog" Header="@(_isEditingUser ? "Edit User" : "New User")">
    <DialogTemplates>
        <Content>
            <div style="display:flex;flex-direction:column;gap:12px;padding:4px;">
                <label>Full Name</label>
                <AppTextBox @bind-Value="_userForm.FullName"></AppTextBox>
                <label>Username</label>
                <AppTextBox @bind-Value="_userForm.UserName"></AppTextBox>
                <label>Email</label>
                <AppTextBox @bind-Value="_userForm.Email"></AppTextBox>
                <label>Display Name</label>
                <AppTextBox @bind-Value="_userForm.DisplayName"></AppTextBox>
                <label>User Type</label>
                <AppSelect TItem="string" TValue="string" DataSource="_userTypes" @bind-Value="_userForm.UserTypeCode" Width="100%"></AppSelect>
                <label>Department</label>
                <AppTextBox @bind-Value="_userForm.Department"></AppTextBox>
                <label>Job Title</label>
                <AppTextBox @bind-Value="_userForm.JobTitle"></AppTextBox>
                <label>Phone</label>
                <AppTextBox @bind-Value="_userForm.PhoneNumber" Placeholder="(555) 123-4567" Type="InputType.Tel"></AppTextBox>
                <small class="text-muted">Use enterprise phone format: (555) 123-4567 or +1 555 123 4567 x123.</small>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Save" IsPrimary="true" OnClick="SaveUserAsync"></DialogButton>
        <DialogButton Content="Cancel" OnClick="() => _showUserDialog = false"></DialogButton>
    </DialogButtons>
</AppModal>

@* -- Permission Dialog --------------------------------------- *@
<AppModal Width="480px" IsModal="true" @bind-Visible="_showPermDialog" Header="New Permission">
    <DialogTemplates>
        <Content>
            <div style="display:flex;flex-direction:column;gap:12px;padding:4px;">
                <label>Permission Code</label>
                <AppTextBox @bind-Value="_permForm.PermissionCode"></AppTextBox>
                <label>Permission Name</label>
                <AppTextBox @bind-Value="_permForm.PermissionName"></AppTextBox>
                <label>Resource Code</label>
                <AppTextBox @bind-Value="_permForm.ResourceCode"></AppTextBox>
                <label>Action Code</label>
                <AppTextBox @bind-Value="_permForm.ActionCode"></AppTextBox>
                <label>Description</label>
                <AppTextBox @bind-Value="_permForm.Description" Multiline="true"></AppTextBox>
                <AppCheckBox @bind-Checked="_permForm.IsBuiltIn" Label="Built-In"></AppCheckBox>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Create" IsPrimary="true" OnClick="SavePermissionAsync"></DialogButton>
        <DialogButton Content="Cancel" OnClick="() => _showPermDialog = false"></DialogButton>
    </DialogButtons>
</AppModal>

@* -- Assign Role Dialog -------------------------------------- *@
<AppModal Width="480px" IsModal="true" @bind-Visible="_showUserRoleDialog" Header="Assign Role to User">
    <DialogTemplates>
        <Content>
            <div style="display:flex;flex-direction:column;gap:12px;padding:4px;">
                <label>User ID</label>
                <AppTextBox @bind-Value="_userRoleUserIdText"></AppTextBox>
                <label>Role ID</label>
                <AppTextBox @bind-Value="_userRoleRoleIdText"></AppTextBox>
                <label>Effective Start</label>
                <AppDateTimePicker TValue="DateTime?" @bind-Value="_userRoleForm.EffectiveStartDateUtc"></AppDateTimePicker>
                <label>Effective End</label>
                <AppDateTimePicker TValue="DateTime?" @bind-Value="_userRoleForm.EffectiveEndDateUtc"></AppDateTimePicker>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Assign" IsPrimary="true" OnClick="SaveUserRoleAsync"></DialogButton>
        <DialogButton Content="Cancel" OnClick="() => _showUserRoleDialog = false"></DialogButton>
    </DialogButtons>
</AppModal>

@* -- Assign Scope Dialog ------------------------------------- *@
<AppModal Width="480px" IsModal="true" @bind-Visible="_showScopeDialog" Header="Assign Scope">
    <DialogTemplates>
        <Content>
            <div style="display:flex;flex-direction:column;gap:12px;padding:4px;">
                <label>User ID</label>
                <AppTextBox @bind-Value="_scopeUserIdText"></AppTextBox>
                <label>Scope Type Code</label>
                <AppSelect TItem="string" TValue="string" DataSource="_scopeTypes" @bind-Value="_scopeForm.ScopeTypeCode" Width="100%"></AppSelect>
                <label>Scope Value</label>
                <AppTextBox @bind-Value="_scopeForm.ScopeValue"></AppTextBox>
                <label>Expires</label>
                <AppDateTimePicker TValue="DateTime?" @bind-Value="_scopeForm.ExpiresDateUtc"></AppDateTimePicker>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Assign" IsPrimary="true" OnClick="SaveScopeAsync"></DialogButton>
        <DialogButton Content="Cancel" OnClick="() => _showScopeDialog = false"></DialogButton>
    </DialogButtons>
</AppModal>

@* -- Security Policy Dialog ---------------------------------- *@
<AppModal Width="560px" IsModal="true" @bind-Visible="_showSecPolicyDialog" Header="New Security Policy">
    <DialogTemplates>
        <Content>
            <div style="display:flex;flex-direction:column;gap:12px;padding:4px;">
                <label>Policy Code</label>
                <AppTextBox @bind-Value="_secPolicyForm.PolicyCode"></AppTextBox>
                <label>Policy Name</label>
                <AppTextBox @bind-Value="_secPolicyForm.PolicyName"></AppTextBox>
                <label>Resource Code</label>
                <AppTextBox @bind-Value="_secPolicyForm.ResourceCode"></AppTextBox>
                <label>Action Code</label>
                <AppTextBox @bind-Value="_secPolicyForm.ActionCode"></AppTextBox>
                <label>Condition Expression</label>
                <AppTextBox @bind-Value="_secPolicyForm.ConditionExpression" Multiline="true"></AppTextBox>
                <label>Severity</label>
                <AppSelect TItem="string" TValue="string" DataSource="_severityCodes" @bind-Value="_secPolicyForm.SeverityCode" Width="100%"></AppSelect>
                <label>Error Message Template</label>
                <AppTextBox @bind-Value="_secPolicyForm.ErrorMessageTemplate" Multiline="true"></AppTextBox>
                <label>Description</label>
                <AppTextBox @bind-Value="_secPolicyForm.Description" Multiline="true"></AppTextBox>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Create" IsPrimary="true" OnClick="SaveSecurityPolicyAsync"></DialogButton>
        <DialogButton Content="Cancel" OnClick="() => _showSecPolicyDialog = false"></DialogButton>
    </DialogButtons>
</AppModal>

<EnterpriseToast @ref="_toast" Timeout="3000" />

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private EnterpriseToast _toast = default!;

    // -- 1. Roles --------------------------------------------
    private string? _roleSearch;
    private List<RoleDto>? _roles;
    private bool _showRoleDialog;
    private bool _isEditingRole;
    private Guid? _editingRoleId;
    private CreateRoleRequest _roleForm = new();
    private readonly List<string> _roleTypes = ["Internal", "External", "System", "Guest"];

    // -- 2. Users --------------------------------------------
    private string? _userSearch;
    private List<UserDto>? _users;
    private bool _showUserDialog;
    private bool _isEditingUser;
    private Guid? _editingUserId;
    private CreateUserRequest _userForm = new();
    private readonly List<string> _userTypes = ["Internal", "External", "ServiceAccount", "Guest"];

    // -- 3. Permissions --------------------------------------
    private string? _permSearch;
    private string? _permResourceFilter;
    private List<PermissionDto>? _permissions;
    private bool _showPermDialog;
    private CreatePermissionRequest _permForm = new();

    // -- 4. User-Role Assignments ----------------------------
    private List<UserRoleDto>? _userRoles;
    private bool _showUserRoleDialog;
    private string _userRoleUserIdText = string.Empty;
    private string _userRoleRoleIdText = string.Empty;
    private AssignUserRoleRequest _userRoleForm = new();

    // -- 5. Scopes --------------------------------------------
    private string? _scopeTypeFilter;
    private List<UserScopeDto>? _scopes;
    private bool _showScopeDialog;
    private string _scopeUserIdText = string.Empty;
    private AssignUserScopeRequest _scopeForm = new();
    private readonly List<string> _scopeTypes =
    [
        "Tenant", "Company", "Branch", "Department", "BusinessUnit",
        "OwnedRecords", "AssignedRecords", "Region", "LineOfBusiness"
    ];

    // -- 6. Security Policies ---------------------------------
    private string? _policySearch;
    private string? _policyResourceFilter;
    private List<SecurityPolicyDto>? _securityPolicies;
    private bool _showSecPolicyDialog;
    private CreateSecurityPolicyRequest _secPolicyForm = new();
    private readonly List<string> _severityCodes = ["Block", "Warn", "Log"];

    // -- 7. Field Policies ------------------------------------
    private List<FieldSecurityPolicyDto>? _fieldPolicies;

    // -- 8. Record Policies -----------------------------------
    private List<RecordSecurityPolicyDto>? _recordPolicies;

    // -- 9. Privileged Access ---------------------------------
    private List<PrivilegedAccessRequestDto>? _pamRequests;

    // -- 10. Access Reviews -----------------------------------
    private List<UserAccessReviewDto>? _accessReviews;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadRolesAsync();
    }

    // -- Load methods -----------------------------------------

    private async Task LoadRolesAsync()
    {
        var result = await Api.SearchRolesAsync(_tenantId, _roleSearch);
        _roles = result?.Items.ToList() ?? [];
    }

    private async Task LoadUsersAsync()
    {
        var result = await Api.SearchUsersAsync(_tenantId, _userSearch);
        _users = result?.Items.ToList() ?? [];
    }

    private async Task LoadPermissionsAsync()
    {
        var resource = string.IsNullOrWhiteSpace(_permResourceFilter) ? null : _permResourceFilter;
        var result = await Api.SearchPermissionsAsync(_tenantId, _permSearch, resource);
        _permissions = result?.Items.ToList() ?? [];
    }

    private async Task LoadUserRolesAsync()
    {
        var result = await Api.SearchUserRolesAsync(_tenantId);
        _userRoles = result?.Items.ToList() ?? [];
    }

    private async Task LoadScopesAsync()
    {
        var scopeType = string.IsNullOrWhiteSpace(_scopeTypeFilter) ? null : _scopeTypeFilter;
        var result = await Api.SearchUserScopesAsync(_tenantId, scopeTypeCode: scopeType);
        _scopes = result?.Items.ToList() ?? [];
    }

    private async Task LoadSecurityPoliciesAsync()
    {
        var resource = string.IsNullOrWhiteSpace(_policyResourceFilter) ? null : _policyResourceFilter;
        var result = await Api.SearchSecurityPoliciesAsync(_tenantId, _policySearch, resource);
        _securityPolicies = result?.Items.ToList() ?? [];
    }

    private async Task LoadFieldPoliciesAsync()
    {
        var result = await Api.SearchFieldSecurityPoliciesAsync(_tenantId);
        _fieldPolicies = result?.Items.ToList() ?? [];
    }

    private async Task LoadRecordPoliciesAsync()
    {
        var result = await Api.SearchRecordSecurityPoliciesAsync(_tenantId);
        _recordPolicies = result?.Items.ToList() ?? [];
    }

    private async Task LoadPrivilegedAccessAsync()
    {
        var result = await Api.SearchPrivilegedAccessRequestsAsync(_tenantId);
        _pamRequests = result?.Items.ToList() ?? [];
    }

    private async Task LoadAccessReviewsAsync()
    {
        var result = await Api.SearchAccessReviewsAsync(_tenantId);
        _accessReviews = result?.Items.ToList() ?? [];
    }

    // -- Role CRUD ---------------------------------------------

    private void OpenNewRole()
    {
        _isEditingRole = false;
        _editingRoleId = null;
        _roleForm = new CreateRoleRequest { TenantId = _tenantId, RoleTypeCode = "Internal" };
        _showRoleDialog = true;
    }

    private void OnRoleSelected(RowSelectEventArgs<RoleDto> args)
    {
        var r = args.Data;
        _isEditingRole = true;
        _editingRoleId = r.RoleId;
        _roleForm = new CreateRoleRequest
        {
            TenantId = _tenantId,
            RoleCode = r.RoleCode,
            RoleName = r.RoleName,
            RoleTypeCode = r.RoleTypeCode,
            Description = r.Description,
            SortOrder = r.SortOrder
        };
        _showRoleDialog = true;
    }

    private async Task SaveRoleAsync()
    {
        if (_isEditingRole && _editingRoleId.HasValue)
        {
            await Api.UpdateRoleAsync(_editingRoleId.Value, new UpdateRoleRequest
            {
                RoleName = _roleForm.RoleName,
                Description = _roleForm.Description,
                SortOrder = _roleForm.SortOrder
            });
        }
        else
        {
            await Api.CreateRoleAsync(_roleForm);
        }
        _showRoleDialog = false;
        await LoadRolesAsync();
        await _toast.ShowAsync(new ToastModel { Title = "Roles", Content = "Role saved.", CssClass = "enterprise-toast-success" });
    }

    // -- User CRUD ---------------------------------------------

    private void OpenNewUser()
    {
        _isEditingUser = false;
        _editingUserId = null;
        _userForm = new CreateUserRequest { TenantId = _tenantId, UserTypeCode = "Internal" };
        _showUserDialog = true;
    }

    private void OnUserSelected(RowSelectEventArgs<UserDto> args)
    {
        var u = args.Data;
        _isEditingUser = true;
        _editingUserId = u.UserId;
        _userForm = new CreateUserRequest
        {
            TenantId = _tenantId,
            UserName = u.UserName,
            Email = u.Email,
            FullName = u.FullName,
            DisplayName = u.DisplayName,
            UserTypeCode = u.UserTypeCode,
            Department = u.Department,
            JobTitle = u.JobTitle,
            PhoneNumber = u.PhoneNumber
        };
        _showUserDialog = true;
    }

    private async Task SaveUserAsync()
    {
        if (_isEditingUser && _editingUserId.HasValue)
        {
            await Api.UpdateUserAsync(_editingUserId.Value, new UpdateUserRequest
            {
                FullName = _userForm.FullName,
                DisplayName = _userForm.DisplayName,
                Department = _userForm.Department,
                JobTitle = _userForm.JobTitle,
                PhoneNumber = _userForm.PhoneNumber
            });
        }
        else
        {
            await Api.CreateUserAsync(_userForm);
        }
        _showUserDialog = false;
        await LoadUsersAsync();
        await _toast.ShowAsync(new ToastModel { Title = "Users", Content = "User saved.", CssClass = "enterprise-toast-success" });
    }

    // -- Permission CRUD ---------------------------------------

    private void OpenNewPermission()
    {
        _permForm = new CreatePermissionRequest { TenantId = _tenantId };
        _showPermDialog = true;
    }

    private async Task SavePermissionAsync()
    {
        await Api.CreatePermissionAsync(_permForm);
        _showPermDialog = false;
        await LoadPermissionsAsync();
        await _toast.ShowAsync(new ToastModel { Title = "Permissions", Content = "Permission created.", CssClass = "enterprise-toast-success" });
    }

    // -- User-Role Assignment ----------------------------------

    private void OpenNewUserRole()
    {
        _userRoleUserIdText = string.Empty;
        _userRoleRoleIdText = string.Empty;
        _userRoleForm = new AssignUserRoleRequest { TenantId = _tenantId };
        _showUserRoleDialog = true;
    }

    private async Task SaveUserRoleAsync()
    {
        if (!Guid.TryParse(_userRoleUserIdText, out var userId) || !Guid.TryParse(_userRoleRoleIdText, out var roleId))
        {
            await _toast.ShowAsync(new ToastModel { Title = "Validation", Content = "Enter valid User ID and Role ID GUIDs.", CssClass = "enterprise-toast-warning" });
            return;
        }
        _userRoleForm.UserId = userId;
        _userRoleForm.RoleId = roleId;
        await Api.AssignUserRoleAsync(_userRoleForm);
        _showUserRoleDialog = false;
        await LoadUserRolesAsync();
        await _toast.ShowAsync(new ToastModel { Title = "User Roles", Content = "Role assigned.", CssClass = "enterprise-toast-success" });
    }

    // -- Scope Assignment --------------------------------------

    private void OpenNewScope()
    {
        _scopeUserIdText = string.Empty;
        _scopeForm = new AssignUserScopeRequest { TenantId = _tenantId, ScopeTypeCode = "Tenant" };
        _showScopeDialog = true;
    }

    private async Task SaveScopeAsync()
    {
        if (!Guid.TryParse(_scopeUserIdText, out var userId))
        {
            await _toast.ShowAsync(new ToastModel { Title = "Validation", Content = "Enter a valid User ID GUID.", CssClass = "enterprise-toast-warning" });
            return;
        }
        _scopeForm.UserId = userId;
        await Api.AssignUserScopeAsync(_scopeForm);
        _showScopeDialog = false;
        await LoadScopesAsync();
        await _toast.ShowAsync(new ToastModel { Title = "Scopes", Content = "Scope assigned.", CssClass = "enterprise-toast-success" });
    }

    // -- Security Policy ---------------------------------------

    private void OpenNewSecurityPolicy()
    {
        _secPolicyForm = new CreateSecurityPolicyRequest { TenantId = _tenantId, SeverityCode = "Block" };
        _showSecPolicyDialog = true;
    }

    private async Task SaveSecurityPolicyAsync()
    {
        await Api.CreateSecurityPolicyAsync(_secPolicyForm);
        _showSecPolicyDialog = false;
        await LoadSecurityPoliciesAsync();
        await _toast.ShowAsync(new ToastModel { Title = "Security Policies", Content = "Policy created.", CssClass = "enterprise-toast-success" });
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
