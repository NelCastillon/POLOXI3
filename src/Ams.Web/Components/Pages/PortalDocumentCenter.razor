    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Portal", "/tenant/portal/users"), new("Documents", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;
            _loadError = null;
            var documentsTask = Api.SearchPortalAdminDocumentsAsync(_tenantId, _search);
            var categoriesTask = Api.SearchDocumentConfigItemsAsync(_tenantId, "DocumentCategory", pageSize: 1000);
            await Task.WhenAll(documentsTask, categoriesTask);
            var result = documentsTask.Result;
            _docs = result?.Items.ToList() ?? [];
            _documentCategories = categoriesTask.Result?.Items.Where(c => c.IsActive).OrderBy(c => c.SortOrder).ThenBy(c => c.Name).ToList() ?? [];
            if (_selected is not null)
            {
                _selected = _docs.FirstOrDefault(d => d.Id == _selected.Id);
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenShare()
    {
        _shareForm = new DocumentFormModel { Category = CategoryOptions.FirstOrDefault() ?? string.Empty, SharedAt = DateTime.Today };
        _selectedFileName = null;
        _showShare = true;
    }

    private void CloseShare()
    {
        if (_saving) return;
        _showShare = false;
        _selectedFileName = null;
        _shareForm = new DocumentFormModel { Category = CategoryOptions.FirstOrDefault() ?? string.Empty, SharedAt = DateTime.Today };
    }

    private void OpenEdit(PortalAdminDocumentDto doc)
    {
        _selected = doc;
        _editForm = DocumentFormModel.FromDto(doc);
        _showEdit = true;
    }

    private void CloseEdit()
    {
        if (_saving) return;
        _showEdit = false;
    }

    private void SelectDoc(PortalAdminDocumentDto doc) => _selected = doc;

    private void ClearFilters()
    {
        _search = string.Empty;
        _categoryFilter = string.Empty;
        _visibilityFilter = string.Empty;
        _activeFilter = string.Empty;
        _activeTab = "all";
    }

    private void SetFilter(string filter)
    {
        _activeFilter = _activeFilter == filter ? string.Empty : filter;
    }

    private void SetTab(string key) => _activeTab = key;

    private void ToggleView() => _cardView = !_cardView;

