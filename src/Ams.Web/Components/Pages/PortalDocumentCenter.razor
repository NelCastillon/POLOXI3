@page "/portal/documents"
@page "/tenant/portal/documents"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Portal Document Command Center - AMS</PageTitle>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="pd-toast pd-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @_toastIcon" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="pd-toast-close" @onclick="ClearToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showShare)
{
    <div class="pd-modal-backdrop" role="presentation" @onclick="CloseShare">
        <div class="pd-modal pd-action-modal" role="dialog" aria-modal="true" aria-labelledby="pd-share-title" @onclick:stopPropagation="true">
            <div class="pd-modal__header">
                <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                <span id="pd-share-title">Share Portal Document</span>
                <button type="button" class="pd-icon-btn pd-icon-btn--light ms-auto" @onclick="CloseShare" disabled="@_saving" aria-label="Close share document dialog"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_shareForm" OnValidSubmit="ShareDocumentAsync" OnInvalidSubmit="ShowValidationToast">
                <DataAnnotationsValidator />
                <div class="pd-modal__body">
                    <div class="pd-modal-intro">
                        <span><i class="bi bi-shield-lock" aria-hidden="true"></i> Client portal distribution</span>
                        <p>Publish a document to the insured portal and track access from this administration workspace.</p>
                    </div>
                    <div class="pd-form-grid">
                        <div class="pd-field pd-field--full">
                            <label>Document Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_shareForm.Name" placeholder="Riverside BOP policy" />
                        </div>
                        <div class="pd-field">
                            <label>Account Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_shareForm.AccountName" placeholder="Riverside Construction LLC" />
                        </div>
                        <div class="pd-field">
                            <label>Category <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_shareForm.Category">
                                @foreach (var option in CategoryOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="pd-field">
                            <label>File Type <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_shareForm.FileType">
                                @foreach (var option in FileTypeOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="pd-field">
                            <label>File Size (KB) <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_shareForm.FileSizeKb" />
                        </div>
                        <div class="pd-field">
                            <label>Visibility <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_shareForm.Visibility">
                                @foreach (var option in VisibilityOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="pd-field">
                            <label>Shared Date</label>
                            <InputDate class="form-control" @bind-Value="_shareForm.SharedAt" />
                        </div>
                        <div class="pd-field pd-field--full">
                            <label>Portal File</label>
                            <InputFile OnChange="OnFileSelected" />
                            @if (!string.IsNullOrWhiteSpace(_selectedFileName))
                            {
                                <div class="pd-file-note"><i class="bi bi-paperclip" aria-hidden="true"></i> @_selectedFileName</div>
                            }
                            else
                            {
                                <div class="pd-drop-zone">
                                    <i class="bi bi-cloud-arrow-up pd-drop-icon" aria-hidden="true"></i>
                                    <span>Select a PDF, DOCX, XLSX, or image up to 25 MB.</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="pd-modal__footer">
                    <button type="button" class="pd-btn pd-btn--ghost" @onclick="CloseShare" disabled="@_saving">Cancel</button>
                    <button type="submit" class="pd-btn pd-btn--primary" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        Share Document
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showEdit && _selected is not null)
{
    <div class="pd-modal-backdrop" role="presentation" @onclick="CloseEdit">
        <div class="pd-modal pd-action-modal" role="dialog" aria-modal="true" aria-labelledby="pd-edit-title" @onclick:stopPropagation="true">
            <div class="pd-modal__header">
                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                <span id="pd-edit-title">Edit Portal Document</span>
                <button type="button" class="pd-icon-btn pd-icon-btn--light ms-auto" @onclick="CloseEdit" disabled="@_saving" aria-label="Close edit document dialog"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_editForm" OnValidSubmit="SaveEditAsync" OnInvalidSubmit="ShowValidationToast">
                <DataAnnotationsValidator />
                <div class="pd-modal__body">
                    <div class="pd-form-grid">
                        <div class="pd-field pd-field--full">
                            <label>Document Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_editForm.Name" />
                        </div>
                        <div class="pd-field">
                            <label>Account Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_editForm.AccountName" />
                        </div>
                        <div class="pd-field">
                            <label>Category <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_editForm.Category">
                                @foreach (var option in CategoryOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="pd-field">
                            <label>File Type <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_editForm.FileType">
                                @foreach (var option in FileTypeOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="pd-field">
                            <label>File Size (KB) <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_editForm.FileSizeKb" />
                        </div>
                        <div class="pd-field">
                            <label>Visibility <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_editForm.Visibility">
                                @foreach (var option in VisibilityOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="pd-field">
                            <label>Shared Date</label>
                            <InputDate class="form-control" @bind-Value="_editForm.SharedAt" />
                        </div>
                        <div class="pd-field">
                            <label>Views <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_editForm.ViewCount" />
                        </div>
                        <div class="pd-field">
                            <label>Downloads <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_editForm.DownloadCount" />
                        </div>
                    </div>
                </div>
                <div class="pd-modal__footer">
                    <button type="button" class="pd-btn pd-btn--ghost" @onclick="CloseEdit" disabled="@_saving">Cancel</button>
                    <button type="submit" class="pd-btn pd-btn--primary" disabled="@_saving">Save Changes</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_confirmAction is not null)
{
    <div class="pd-modal-backdrop" role="presentation" @onclick="CancelConfirm">
        <div class="pd-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="pd-confirm-title" @onclick:stopPropagation="true">
            <div class="pd-confirm__body">
                <div class="pd-confirm-icon pd-confirm-icon--danger"><i class="bi @_confirmAction.Icon" aria-hidden="true"></i></div>
                <div class="pd-confirm-content">
                    <h3 id="pd-confirm-title">@_confirmAction.Title</h3>
                    <p>@_confirmAction.Message</p>
                </div>
                <div class="pd-modal__footer">
                    <button type="button" class="pd-btn pd-btn--ghost" @onclick="CancelConfirm" disabled="@_saving">Cancel</button>
                    <button type="button" class="pd-btn pd-btn--danger" @onclick="ExecuteConfirmAsync" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        @_confirmAction.ConfirmLabel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="pd-enterprise-page">
    <section class="pd-header">
        <div class="pd-hero__content">
            <div class="pd-header-left">
                <div class="pd-lob-icon"><i class="bi bi-folder2-open" aria-hidden="true"></i></div>
                <div class="pd-header-info">
                    <span class="pd-hero__eyebrow">Enterprise client document command center</span>
                    <div class="pd-title-row">
                        <h1 class="pd-page-title">Portal Document Command Center</h1>
                        <div class="pd-hero__meta">
                            <span><i class="bi bi-folder2-open" aria-hidden="true"></i> @_docs.Count documents</span>
                            <span><i class="bi bi-people" aria-hidden="true"></i> @AccountCount accounts</span>
                            <span><i class="bi bi-eye" aria-hidden="true"></i> @TotalViews views</span>
                            <span><i class="bi bi-download" aria-hidden="true"></i> @TotalDownloads downloads</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Govern client-facing documents, publish certificates and policies, monitor portal engagement, and control agency-only visibility from one tenant operations workspace.</p>
        </div>
        <div class="pd-header-actions">
            <button type="button" class="pd-btn pd-btn--light" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi @(_loading ? "bi-arrow-repeat pd-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="pd-btn pd-btn--light" @onclick="ExportAsync" disabled="@(!Filtered.Any())">
                <i class="bi bi-download" aria-hidden="true"></i> Export
            </button>
            <button type="button" class="pd-btn pd-btn--primary pd-btn--hero" @onclick="OpenShare">
                <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Share Document
            </button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger pd-load-error" style="border-left: 4px solid #dc3545; animation: pd-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError
        </div>
    }

    <section class="pd-kpi-strip" aria-label="Portal document metrics">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="pd-kpi-card @kpi.Tone @(_activeFilter == kpi.Filter ? "pd-kpi-active" : null)" title="@kpi.Title" @onclick="() => SetFilter(kpi.Filter)">
                <span class="pd-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="pd-kpi-copy">
                    <span class="pd-kpi-label">@kpi.Label</span>
                    <span class="pd-kpi-value">@kpi.Value</span>
                    <span class="pd-kpi-caption">@kpi.Caption</span>
                </span>
            </button>
        }
    </section>

    <section class="pd-enterprise-search" aria-label="Portal document filters">
        <div class="pd-search-wrap">
            <div class="pd-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
            <div class="pd-search-body">
            <label for="portal-doc-search">Search portal documents</label>
            <input id="portal-doc-search" class="pd-search-input" placeholder="Search by document, account, category, or file type..." @bind="_search" @bind:event="oninput" />
            <span class="pd-search-hint">Client-facing document inventory, visibility, and engagement tracking.</span>
        </div>
        </div>
        <select class="pd-filter-select" title="Category filter" @bind="_categoryFilter">
            <option value="">All Categories</option>
            @foreach (var option in CategoryOptions)
            {
                <option value="@option">@option</option>
            }
        </select>
        <select class="pd-filter-select" title="Visibility filter" @bind="_visibilityFilter">
            <option value="">All Visibility</option>
            @foreach (var option in VisibilityOptions)
            {
                <option value="@option">@option</option>
            }
        </select>
        <div class="pd-search-result"><strong>@Filtered.Count()</strong><span>shown</span></div>
    </section>

    <section class="pd-workflow-strip pd-workflow-strip--polished" aria-label="Portal document workflow">
        @foreach (var workflow in WorkflowCards)
        {
            <button type="button" class="pd-workflow-card @workflow.Tone @(_activeFilter == workflow.Filter ? "pd-workflow-card--active" : null)" @onclick="() => SetFilter(workflow.Filter)">
                <span class="pd-workflow-icon"><i class="bi @workflow.Icon" aria-hidden="true"></i></span>
                <span class="pd-workflow-content">
                    <strong>@WorkflowCount(workflow.Filter)</strong>
                    <span>@workflow.Title</span>
                    <small>@workflow.Status - @workflow.Detail</small>
                </span>
            </button>
        }
    </section>

    <section class="pd-tabs" aria-label="Portal document views">
        @foreach (var tab in Tabs)
        {
            <button type="button" class="pd-tab @(_activeTab == tab.Key ? "pd-tab--active" : null)" @onclick="() => SetTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </section>

    <section class="pd-dashboard">
        <div class="pd-main-column">
            <section class="pd-grid-wrap">
                <div class="pd-grid-toolbar">
                    <div>
                        <strong>@ActiveViewTitle</strong>
                        <span>@Filtered.Count() of @_docs.Count documents match the current filters, sorted by enterprise importance</span>
                    </div>
                    <div class="pd-toolbar-actions">
                        <button type="button" class="pd-btn pd-btn--ghost pd-btn--sm" @onclick="ToggleView"><i class="bi @(_cardView ? "bi-table" : "bi-grid-3x3-gap")" aria-hidden="true"></i> @(_cardView ? "Table" : "Cards")</button>
                        <button type="button" class="pd-btn pd-btn--ghost pd-btn--sm" @onclick="ClearFilters"><i class="bi bi-x-circle" aria-hidden="true"></i> Clear filters</button>
                        <button type="button" class="pd-btn pd-btn--ghost pd-btn--sm" @onclick="ExportAsync" disabled="@(!Filtered.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
                        <button type="button" class="pd-btn pd-btn--primary pd-btn--sm" @onclick="OpenShare"><i class="bi bi-plus-lg" aria-hidden="true"></i> Share</button>
                    </div>
                </div>

                @if (_loading)
                {
                    <div class="pd-loading"><i class="bi bi-arrow-repeat pd-spin" aria-hidden="true"></i><span>Loading portal documents...</span></div>
                }
                else if (!Filtered.Any())
                {
                    <div class="pd-empty-state"><i class="bi bi-folder-x" aria-hidden="true"></i><strong>No portal documents found</strong><span>Adjust filters or share a new document with client portal users.</span></div>
                }
                else if (_cardView)
                {
                    <div class="pd-card-grid">
                        @foreach (var doc in Filtered)
                        {
                            @DocumentCard(doc)
                        }
                    </div>
                }
                else
                {
                    <div class="pd-table-scroll">
                        <table class="pd-table">
                            <thead>
                                <tr>
                                    <th>Document</th>
                                    <th>Account</th>
                                    <th>Category</th>
                                    <th>Visibility</th>
                                    <th>Shared</th>
                                    <th>Views</th>
                                    <th>Downloads</th>
                                    <th class="pd-actions-col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Filtered)
                                {
                                    <tr class="pd-table-row @(_selected?.Id == doc.Id ? "pd-table-row--selected" : null)" @onclick="() => SelectDoc(doc)">
                                        <td>@DocumentCell(doc)</td>
                                        <td>@doc.AccountName</td>
                                        <td><span class="pd-cat @CatCss(doc.Category)">@doc.Category</span></td>
                                        <td><span class="pd-vis @VisCss(doc.Visibility)">@doc.Visibility</span></td>
                                        <td>@doc.SharedAt.ToString("MMM d, yyyy")</td>
                                        <td class="pd-number">@doc.ViewCount.ToString("N0")</td>
                                        <td class="pd-number">@doc.DownloadCount.ToString("N0")</td>
                                        <td class="pd-actions-col">
                                            <div class="pd-row-actions">
                                                <button type="button" class="pd-icon-btn" title="Preview" @onclick="() => SelectDoc(doc)" @onclick:stopPropagation="true"><i class="bi bi-layout-sidebar-inset-reverse" aria-hidden="true"></i></button>
                                                <button type="button" class="pd-icon-btn" title="@(doc.Visibility == "Shared" ? "Hide from portal" : "Share to portal")" @onclick="() => ConfirmToggleVisibility(doc)" @onclick:stopPropagation="true"><i class="bi @(doc.Visibility == "Shared" ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i></button>
                                                <button type="button" class="pd-icon-btn" title="Edit" @onclick="() => OpenEdit(doc)" @onclick:stopPropagation="true"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                                <button type="button" class="pd-icon-btn pd-icon-btn--danger" title="Remove" @onclick="() => ConfirmRemove(doc)" @onclick:stopPropagation="true"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            @if (_selected is not null)
            {
                <aside class="pd-detail-panel" aria-label="Selected portal document detail">
            <div class="pd-detail-head">
                <div class="pd-detail-title-block">
                    <span class="pd-detail-eyebrow"><i class="bi bi-file-earmark-check" aria-hidden="true"></i> Portal document</span>
                    <h2>@_selected.Name</h2>
                    <div class="pd-detail-meta">
                        <span><i class="bi bi-building" aria-hidden="true"></i> @_selected.AccountName</span>
                        <span><i class="bi bi-calendar2-check" aria-hidden="true"></i> Shared @_selected.SharedAt.ToString("MMM d, yyyy")</span>
                        <span><i class="bi bi-hdd" aria-hidden="true"></i> @_selected.FileType - @_selected.FileSizeKb.ToString("N0") KB</span>
                    </div>
                </div>
                <button type="button" class="pd-icon-btn" @onclick="() => _selected = null" aria-label="Close document detail"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="pd-detail-body">
                <div class="pd-detail-summary">
                    @Meta("Visibility", _selected.Visibility)
                    @Meta("Category", _selected.Category)
                    @Meta("Views", _selected.ViewCount.ToString("N0"))
                    @Meta("Downloads", _selected.DownloadCount.ToString("N0"))
                </div>
                <div class="pd-detail-actions">
                    <button type="button" class="pd-btn pd-btn--primary" @onclick="() => ConfirmDownload(_selected)"><i class="bi bi-download" aria-hidden="true"></i> Download</button>
                    <button type="button" class="pd-btn pd-btn--ghost" @onclick="() => ConfirmToggleVisibility(_selected)"><i class="bi @(_selected.Visibility == "Shared" ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i> @(_selected.Visibility == "Shared" ? "Hide" : "Share")</button>
                    <button type="button" class="pd-btn pd-btn--ghost" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                    <button type="button" class="pd-btn pd-btn--danger" @onclick="() => ConfirmRemove(_selected)"><i class="bi bi-trash" aria-hidden="true"></i> Remove</button>
                </div>
            </div>
                </aside>
            }
        </div>

        <aside class="pd-side-rail" aria-label="Portal document intelligence">
            <section class="pd-intel-card">
                <span class="pd-intel-kicker"><i class="bi bi-stars" aria-hidden="true"></i> Importance signals</span>
                <div class="pd-score"><span>Document readiness</span><strong>@ReadinessScore</strong><small>/100</small></div>
                <div class="pd-score-bar"><span style="width:@ReadinessScore%"></span></div>
                <div class="pd-signal-list">
                    @foreach (var signal in ImportanceSignals)
                    {
                        <div><i class="bi @signal.Icon" aria-hidden="true"></i><span>@signal.Text</span></div>
                    }
                </div>
            </section>
            <section class="pd-intel-card">
                <span class="pd-intel-kicker"><i class="bi bi-pie-chart" aria-hidden="true"></i> Category mix</span>
                <div class="pd-mix-list">
                    @foreach (var category in CategoryOptions)
                    {
                        <button type="button" @onclick="() => SetFilter(category)"><span>@category</span><strong>@_docs.Count(d => d.Category == category)</strong></button>
                    }
                </div>
            </section>
            <section class="pd-intel-card">
                <span class="pd-intel-kicker"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Quick actions</span>
                <div class="pd-quick-actions">
                    <button type="button" class="pd-btn pd-btn--primary" @onclick="OpenShare"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Share Document</button>
                    <button type="button" class="pd-btn pd-btn--ghost" @onclick="ShowSharedOnly"><i class="bi bi-cloud-check" aria-hidden="true"></i> Shared Queue</button>
                    <button type="button" class="pd-btn pd-btn--ghost" @onclick="OpenPortalRequests"><i class="bi bi-inbox" aria-hidden="true"></i> Requests</button>
                </div>
            </section>
        </aside>
    </section>
</div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private static readonly string[] VisibilityOptions = ["Shared", "Agency Only"];
    private static readonly string[] FileTypeOptions = ["PDF", "DOCX", "XLSX", "PNG", "JPG"];

    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<DocumentConfigItemDto> _documentCategories = [];
    private List<PortalAdminDocumentDto> _docs = [];
    private PortalAdminDocumentDto? _selected;
    private string _search = string.Empty;
    private string _categoryFilter = string.Empty;
    private string _visibilityFilter = string.Empty;
    private string _activeFilter = string.Empty;
    private string _activeTab = "all";
    private string? _loadError;
    private bool _loading;
    private bool _saving;
    private bool _cardView;
    private bool _showShare;
    private bool _showEdit;
    private string? _selectedFileName;
    private string? _toastMessage;
    private string _toastKind = "success";
    private string _toastIcon = "bi-check-circle-fill";
    private ConfirmAction? _confirmAction;
    private DocumentFormModel _shareForm = new();
    private DocumentFormModel _editForm = new();

    private IEnumerable<PortalAdminDocumentDto> Filtered => TabbedDocs
        .Where(MatchesSearch)
        .Where(d => string.IsNullOrWhiteSpace(_categoryFilter) || d.Category == _categoryFilter)
        .Where(d => string.IsNullOrWhiteSpace(_visibilityFilter) || d.Visibility == _visibilityFilter)
        .Where(MatchesActiveFilter)
        .OrderByDescending(ImportanceScore)
        .ThenByDescending(d => d.SharedAt)
        .ThenBy(d => d.AccountName)
        .ThenBy(d => d.Name);

    private IEnumerable<PortalAdminDocumentDto> TabbedDocs => _activeTab switch
    {
        "shared" => _docs.Where(d => d.Visibility == "Shared"),
        "agency" => _docs.Where(d => d.Visibility == "Agency Only"),
        "certificates" => _docs.Where(d => d.Category == "Certificate"),
        "engaged" => _docs.Where(d => d.ViewCount > 0 || d.DownloadCount > 0),
        _ => _docs
    };

    private int TotalViews => _docs.Sum(d => d.ViewCount);
    private int TotalDownloads => _docs.Sum(d => d.DownloadCount);
    private int AccountCount => _docs.Select(d => d.AccountName).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
