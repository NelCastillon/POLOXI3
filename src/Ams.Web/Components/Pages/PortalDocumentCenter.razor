    }

    private sealed record ConfirmAction(string Title, string Message, string ConfirmLabel, string Icon, Func<Task> Execute);

    private sealed class DocumentFormModel
    {
        [Required, StringLength(250)] public string Name { get; set; } = string.Empty;
        [Required, StringLength(250)] public string AccountName { get; set; } = string.Empty;
        [Required, StringLength(80)] public string Category { get; set; } = "Policy";
        [Required, StringLength(20)] public string FileType { get; set; } = "PDF";
        [Range(1, 25600)] public int FileSizeKb { get; set; } = 120;
        [Required, StringLength(80)] public string Visibility { get; set; } = "Shared";
        public DateTime SharedAt { get; set; } = DateTime.Today;
        [Range(0, int.MaxValue)] public int ViewCount { get; set; }
        [Range(0, int.MaxValue)] public int DownloadCount { get; set; }

        public PortalAdminDocumentDto ToDto(Guid id) => new()
        {
            Id = id,
            Name = Name.Trim(),
            AccountName = AccountName.Trim(),
            Category = Category,
            FileType = FileType,
            FileSizeKb = FileSizeKb,
            Visibility = Visibility,
            SharedAt = SharedAt,
            ViewCount = ViewCount,
            DownloadCount = DownloadCount
        };

        public static DocumentFormModel FromDto(PortalAdminDocumentDto doc) => new()
        {
            Name = doc.Name,
            AccountName = doc.AccountName,
            Category = doc.Category,
            FileType = doc.FileType,
            FileSizeKb = doc.FileSizeKb,
            Visibility = doc.Visibility,
            SharedAt = doc.SharedAt,
            ViewCount = doc.ViewCount,
            DownloadCount = doc.DownloadCount
        };
    }
