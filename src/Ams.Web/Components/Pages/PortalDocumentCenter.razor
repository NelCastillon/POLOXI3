    {
        _activeTab = "shared";
        _activeFilter = "Shared";
    }

    private void OpenPortalRequests() => Nav.NavigateTo("/tenant/portal/requests");

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        _selectedFileName = file.Name;
        _shareForm.FileType = ResolveFileType(file.Name);
        _shareForm.FileSizeKb = Math.Max(1, (int)Math.Ceiling(file.Size / 1024d));
        if (string.IsNullOrWhiteSpace(_shareForm.Name))
        {
            _shareForm.Name = Path.GetFileNameWithoutExtension(file.Name);
        }
    }

    private async Task ExportAsync()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Name,Account,Category,FileType,FileSizeKb,Visibility,SharedAt,Views,Downloads");
        foreach (var doc in Filtered)
        {
            csv.AppendLine(string.Join(',', Csv(doc.Name), Csv(doc.AccountName), Csv(doc.Category), Csv(doc.FileType), doc.FileSizeKb.ToString(), Csv(doc.Visibility), Csv(doc.SharedAt.ToString("s")), doc.ViewCount.ToString(), doc.DownloadCount.ToString()));
        }
        Nav.NavigateTo("data:text/csv;charset=utf-8," + Uri.EscapeDataString(csv.ToString()), forceLoad: true);
        ShowToast("Portal documents export generated.");
        await Task.CompletedTask;
    }

    private async Task ShareDocumentAsync()
    {
        try
        {
            _saving = true;
            var dto = _shareForm.ToDto(Guid.NewGuid());
            await Api.CreatePortalAdminRecordAsync(ToRequest(dto));
            _showShare = false;
            _selectedFileName = null;
            ShowToast($"Document '{dto.Name}' shared to portal.");
            await LoadAsync();
            _selected = _docs.FirstOrDefault(d => d.Name == dto.Name && d.AccountName == dto.AccountName);
        }
        catch (Exception ex)
        {
            ShowToast($"Share failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveEditAsync()
    {
        if (_selected is null) return;
        try
        {
            _saving = true;
            var dto = _editForm.ToDto(_selected.Id);
            await Api.UpdatePortalAdminRecordAsync(_selected.Id, ToRequest(dto));
            _showEdit = false;
            ShowToast($"Document '{dto.Name}' updated.");
            await LoadAsync();
            _selected = _docs.FirstOrDefault(d => d.Id == dto.Id);
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmToggleVisibility(PortalAdminDocumentDto doc)
    {
        var newVisibility = doc.Visibility == "Shared" ? "Agency Only" : "Shared";
        _confirmAction = new ConfirmAction(
            newVisibility == "Shared" ? "Share document" : "Hide document",
            $"Change '{doc.Name}' visibility to {newVisibility}?",
            newVisibility == "Shared" ? "Share" : "Hide",
            newVisibility == "Shared" ? "bi-eye" : "bi-eye-slash",
            () => ToggleVisibilityAsync(doc, newVisibility));
    }

    private async Task ToggleVisibilityAsync(PortalAdminDocumentDto doc, string visibility)
    {
        var updated = Clone(doc);
        updated.Visibility = visibility;
        await Api.UpdatePortalAdminRecordAsync(doc.Id, ToRequest(updated));
        ShowToast($"Document visibility changed to {visibility}.");
        await LoadAsync();
        _selected = _docs.FirstOrDefault(d => d.Id == doc.Id);
    }

    private void ConfirmDownload(PortalAdminDocumentDto doc)
    {
        _confirmAction = new ConfirmAction(
            "Track download",
            $"Record an administrative download for '{doc.Name}'?",
            "Download",
            "bi-download",
            () => DownloadAsync(doc));
    }

    private async Task DownloadAsync(PortalAdminDocumentDto doc)
    {
        var updated = Clone(doc);
        updated.DownloadCount++;
        await Api.UpdatePortalAdminRecordAsync(doc.Id, ToRequest(updated));
        ShowToast($"Download recorded for '{doc.Name}'.");
        await LoadAsync();
        _selected = _docs.FirstOrDefault(d => d.Id == doc.Id);
    }

    private void ConfirmRemove(PortalAdminDocumentDto doc)
    {
        _confirmAction = new ConfirmAction(
            "Remove portal document",
            $"Remove '{doc.Name}' from the client portal document center? This will hide it from future portal results.",
            "Remove",
            "bi-trash",
            () => RemoveAsync(doc));
    }

    private async Task RemoveAsync(PortalAdminDocumentDto doc)
    {
        await Api.DeletePortalAdminRecordAsync(doc.Id);
        ShowToast("Document removed from portal.", "warning");
        await LoadAsync();
        if (_selected?.Id == doc.Id)
        {
            _selected = null;
        }
    }

    private async Task ExecuteConfirmAsync()
    {
        if (_confirmAction is null) return;
        try
        {
            _saving = true;
            var action = _confirmAction;
            _confirmAction = null;
            await action.Execute();
        }
        catch (Exception ex)
        {
            ShowToast($"Action failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private void CancelConfirm()
    {
        if (_saving) return;
        _confirmAction = null;
    }

    private bool MatchesSearch(PortalAdminDocumentDto doc)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return doc.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || doc.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || doc.Category.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || doc.FileType.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || doc.Visibility.Contains(_search, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesActiveFilter(PortalAdminDocumentDto doc) => _activeFilter switch
    {
        "" => true,
        "Shared" => doc.Visibility == "Shared",
        "Agency Only" => doc.Visibility == "Agency Only",
        "Certificate" => doc.Category == "Certificate",
        "viewed" => doc.ViewCount > 0,
        "downloaded" => doc.DownloadCount > 0,
        _ => doc.Category == _activeFilter || doc.Visibility == _activeFilter
    };

    private string TabCount(string key) => key switch
    {
        "all" => _docs.Count.ToString("N0"),
        "shared" => _docs.Count(d => d.Visibility == "Shared").ToString("N0"),
        "agency" => _docs.Count(d => d.Visibility == "Agency Only").ToString("N0"),
        "certificates" => _docs.Count(d => d.Category == "Certificate").ToString("N0"),
        "engaged" => _docs.Count(d => d.ViewCount > 0 || d.DownloadCount > 0).ToString("N0"),
        _ => string.Empty
    };

    private IEnumerable<Signal> BuildImportanceSignals()
    {
        yield return new("bi-cloud-check", $"{_docs.Count(d => d.Visibility == "Shared")} documents are visible to clients.");
        yield return new("bi-lock", $"{_docs.Count(d => d.Visibility == "Agency Only")} documents are agency-only and controlled.");
        yield return new("bi-eye", $"{TotalViews:N0} client views across shared documents.");
        yield return new("bi-download", $"{TotalDownloads:N0} document downloads recorded.");
    }

    private UpsertPortalAdminRecordRequest ToRequest(PortalAdminDocumentDto doc) =>
        new(_tenantId, "PortalDocument", BuildCode(doc), doc.Name, doc.Visibility, JsonSerializer.Serialize(doc, JsonOptions));

    private static PortalAdminDocumentDto Clone(PortalAdminDocumentDto doc) => new()
    {
        Id = doc.Id,
        Name = doc.Name,
        AccountName = doc.AccountName,
        Category = doc.Category,
        FileType = doc.FileType,
        FileSizeKb = doc.FileSizeKb,
        Visibility = doc.Visibility,
        SharedAt = doc.SharedAt,
        ViewCount = doc.ViewCount,
        DownloadCount = doc.DownloadCount
    };

    private static string BuildCode(PortalAdminDocumentDto doc)
    {
        var source = $"{doc.AccountName}-{doc.Name}".ToLowerInvariant();
        var chars = source.Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray();
        var code = new string(chars).Trim('-');
        while (code.Contains("--", StringComparison.Ordinal)) code = code.Replace("--", "-", StringComparison.Ordinal);
        return string.IsNullOrWhiteSpace(code) ? $"portal-doc-{doc.Id:N}" : code[..Math.Min(code.Length, 180)];
    }

    private static string ResolveFileType(string fileName)
    {
        var ext = Path.GetExtension(fileName).TrimStart('.').ToUpperInvariant();
        return string.IsNullOrWhiteSpace(ext) ? "PDF" : ext;
    }

    private static string CategoryLabel(DocumentConfigItemDto category) => string.IsNullOrWhiteSpace(category.Name) ? category.Code : category.Name;

