    private static int ImportanceScore(PortalAdminDocumentDto doc) => (doc.Visibility == "Shared" ? 40 : 12) + (doc.Category == "Certificate" ? 30 : doc.Category == "Policy" ? 24 : 16) + Math.Min(30, doc.ViewCount + doc.DownloadCount * 2) + (doc.SharedAt >= DateTime.Today.AddDays(-14) ? 12 : 0);

    private static string Csv(string? value) => string.Concat("\"", (value ?? string.Empty).Replace("\"", "\"\""), "\"");

    private static RenderFragment DocumentCell(PortalAdminDocumentDto doc) => @<div class="pd-doc-cell">
        <div class="pd-doc-icon @DocIconCss(doc.Category)"><i class="bi @DocIcon(doc.Category)" aria-hidden="true"></i></div>
        <div>
            <strong>@doc.Name</strong>
            <span>@doc.FileType - @doc.FileSizeKb.ToString("N0") KB</span>
        </div>
    </div>;

    private RenderFragment DocumentCard(PortalAdminDocumentDto doc) => @<article class="pd-doc-card @(_selected?.Id == doc.Id ? "pd-doc-card--active" : null)" @onclick="@(() => SelectDoc(doc))">
        <div class="pd-doc-card-top">
            @DocumentCell(doc)
            <span class="pd-vis @VisCss(doc.Visibility)">@doc.Visibility</span>
        </div>
        <div class="pd-doc-card-meta">
            <span><i class="bi bi-building" aria-hidden="true"></i>@doc.AccountName</span>
            <span><i class="bi bi-calendar2-check" aria-hidden="true"></i>@doc.SharedAt.ToString("MMM d, yyyy")</span>
            <span><i class="bi bi-eye" aria-hidden="true"></i>@doc.ViewCount.ToString("N0") views</span>
            <span><i class="bi bi-download" aria-hidden="true"></i>@doc.DownloadCount.ToString("N0") downloads</span>
        </div>
        <div class="pd-doc-card-actions" @onclick:stopPropagation="true">
            <button type="button" class="pd-btn pd-btn--ghost pd-btn--sm" @onclick="@(() => ConfirmDownload(doc))"><i class="bi bi-download" aria-hidden="true"></i> Download</button>
            <button type="button" class="pd-btn pd-btn--ghost pd-btn--sm" @onclick="@(() => ConfirmToggleVisibility(doc))"><i class="bi @(doc.Visibility == "Shared" ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i> @(doc.Visibility == "Shared" ? "Hide" : "Share")</button>
            <button type="button" class="pd-btn pd-btn--ghost pd-btn--sm" @onclick="@(() => OpenEdit(doc))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
        </div>
    </article>;

    private static RenderFragment Meta(string label, string value) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "pd-meta-row");
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "pd-meta-lbl");
        builder.AddContent(sequence++, label);
        builder.CloseElement();
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "pd-meta-val");
        builder.AddContent(sequence++, value);
        builder.CloseElement();
        builder.CloseElement();
    };

    private static bool MatchesWorkflow(PortalAdminDocumentDto doc, string filter) => filter switch
    {
        "Shared" => doc.Visibility == "Shared",
        "Agency Only" => doc.Visibility == "Agency Only",
        "Certificate" => doc.Category == "Certificate",
        "viewed" => doc.ViewCount > 0,
        "downloaded" => doc.DownloadCount > 0,
        _ => true
    };

    private int WorkflowCount(string filter) => Filtered.Count(d => MatchesWorkflow(d, filter));

