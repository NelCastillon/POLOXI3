@page "/portal/documents"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject ConfirmationDialogService Confirmations

<PageTitle>Portal Document Center — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Portal Document Center"
               Subtitle="Manage documents shared with insured clients through the self-service portal"
               Icon="bi-folder2-open">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="() => _showUpload = true">
            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Share Document
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="pd-kpi-strip">
    <div class="pd-kpi-card">
        <div class="pd-kpi-icon pd-ki-blue"><i class="bi bi-file-earmark" aria-hidden="true"></i></div>
        <div><div class="pd-kv">@_docs.Count</div><div class="pd-kl">Total Documents</div></div>
    </div>
    <div class="pd-kpi-card">
        <div class="pd-kpi-icon pd-ki-green"><i class="bi bi-eye" aria-hidden="true"></i></div>
        <div><div class="pd-kv">@_docs.Sum(d => d.ViewCount)</div><div class="pd-kl">Total Views</div></div>
    </div>
    <div class="pd-kpi-card">
        <div class="pd-kpi-icon pd-ki-amber"><i class="bi bi-download" aria-hidden="true"></i></div>
        <div><div class="pd-kv">@_docs.Sum(d => d.DownloadCount)</div><div class="pd-kl">Downloads</div></div>
    </div>
    <div class="pd-kpi-card">
        <div class="pd-kpi-icon pd-ki-green"><i class="bi bi-people" aria-hidden="true"></i></div>
        <div><div class="pd-kv">@_docs.Select(d => d.AccountName).Distinct().Count()</div><div class="pd-kl">Accounts with Docs</div></div>
    </div>
</div>

<!-- Filter bar -->
<div class="pd-filter-bar">
    <div class="pd-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="pd-search" placeholder="Search documents or accounts…" @bind="_search" @bind:event="oninput" />
    </div>
    <select class="pd-sel" @bind="_catFilter">
        <option value="">All Categories</option>
        <option value="Policy">Policy</option>
        <option value="Certificate">Certificate</option>
        <option value="ID Card">ID Card</option>
        <option value="Invoice">Invoice</option>
        <option value="Form">Form</option>
        <option value="Claims">Claims</option>
    </select>
    <select class="pd-sel" @bind="_visFilter">
        <option value="">All Visibility</option>
        <option value="Shared">Shared</option>
        <option value="Agency Only">Agency Only</option>
    </select>
</div>

<!-- Grid -->
<div class="pd-grid-wrap">
    <SfGrid TValue="PortalDoc" DataSource="Filtered" AllowSorting="true" AllowFiltering="true"
            EnableHover="true" RowHeight="56">
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
        <GridColumns>
            <GridColumn HeaderText="Document" MinWidth="220" Field="@nameof(PortalDoc.Name)">
                <Template>
                    @{ var d = (PortalDoc)context; }
                    <div class="pd-doc-cell">
                        <div class="pd-doc-icon @DocIconCss(d.Category)"><i class="bi @DocIcon(d.Category)" aria-hidden="true"></i></div>
                        <div>
                            <div class="pd-doc-name">@d.Name</div>
                            <div class="pd-doc-size">@d.FileType · @d.FileSizeKb KB</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(PortalDoc.AccountName)" HeaderText="Account" MinWidth="160" />
            <GridColumn Field="@nameof(PortalDoc.Category)" HeaderText="Category" Width="130">
                <Template>@{ var d = (PortalDoc)context; }<span class="@CatBadge(d.Category)">@d.Category</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(PortalDoc.Visibility)" HeaderText="Visibility" Width="120">
                <Template>@{ var d = (PortalDoc)context; }<span class="@VisBadge(d.Visibility)">@d.Visibility</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(PortalDoc.SharedAt)" HeaderText="Shared" Width="130" Type="ColumnType.DateTime" Format="MMM d, yyyy" />
            <GridColumn Field="@nameof(PortalDoc.ViewCount)" HeaderText="Views" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
            <GridColumn Field="@nameof(PortalDoc.DownloadCount)" HeaderText="Downloads" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
            <GridColumn HeaderText="" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>
                    @{ var d = (PortalDoc)context; }
                    <div class="pd-row-actions">
                        <button class="um-btn um-btn-ghost um-btn-xs" title="Toggle visibility"
                                @onclick="() => ToggleVisibility(d)">
                            <i class="bi @(d.Visibility=="Shared" ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-ghost um-btn-xs" title="Remove" @onclick="() => RemoveDoc(d)">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<!-- Share document dialog -->
<SfDialog @bind-Visible="_showUpload" Width="680px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header">
                <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                <span>Share Document</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseUpload"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="um-field">
                        <label>Document Name <span class="um-required">*</span></label>
                        <SfTextBox Placeholder="Document name" @bind-Value="_newDoc.Name" />
                    </div>
                    <div class="um-field">
                        <label>Category</label>
                        <SfDropDownList TValue="string" TItem="Lv" DataSource="_catOpts" Placeholder="Category" Width="100%" @bind-Value="_newDoc.Category">
                            <DropDownListFieldSettings Value="V" Text="L" />
                        </SfDropDownList>
                    </div>
                    <div class="um-field">
                        <label>Account Name</label>
                        <SfTextBox Placeholder="Account name" @bind-Value="_newDoc.AccountName" />
                    </div>
                    <div class="um-field">
                        <label>Visibility</label>
                        <SfDropDownList TValue="string" TItem="Lv" DataSource="_visOpts" Placeholder="Visibility" Width="100%" @bind-Value="_newDoc.Visibility">
                            <DropDownListFieldSettings Value="V" Text="L" />
                        </SfDropDownList>
                    </div>
                    <div class="um-field um-field--full">
                        <label>File</label>
                        <div class="pd-drop-zone">
                            <i class="bi bi-cloud-arrow-up pd-drop-icon" aria-hidden="true"></i>
                            <span>Drag &amp; drop file here or <strong>browse</strong></span>
                            <span class="pd-drop-hint">PDF, DOCX, XLSX — max 25 MB</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CloseUpload">Cancel</button>
                <button type="button" class="um-btn um-btn-primary"
                        disabled="@(string.IsNullOrEmpty(_newDoc.Name))"
                        @onclick="CommitShare">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Share
                </button>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;
    private string _search = string.Empty;
    private string _catFilter = string.Empty;
    private string _visFilter = string.Empty;
    private bool _showUpload;
    private PortalDoc _newDoc = new();

    private List<PortalDoc> _docs = [];

    private static readonly List<Lv> _catOpts =
    [
        new("Policy","Policy"), new("Certificate","Certificate"), new("ID Card","ID Card"),
        new("Invoice","Invoice"), new("Form","Form"), new("Claims","Claims"),
    ];
    private static readonly List<Lv> _visOpts =
    [
        new("Shared","Shared"), new("Agency Only","Agency Only"),
    ];

    private IEnumerable<PortalDoc> Filtered => _docs.Where(d =>
        (string.IsNullOrEmpty(_search) || d.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || d.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_catFilter) || d.Category == _catFilter) &&
        (string.IsNullOrEmpty(_visFilter) || d.Visibility == _visFilter));

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Portal","/portal/users"), new("Documents",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchPortalAdminDocumentsAsync(_tenantId, _search);
        _docs = result?.Items.Select(d => new PortalDoc { Id = d.Id, Name = d.Name, AccountName = d.AccountName, Category = d.Category, FileType = d.FileType, FileSizeKb = d.FileSizeKb, Visibility = d.Visibility, SharedAt = d.SharedAt, ViewCount = d.ViewCount, DownloadCount = d.DownloadCount }).ToList() ?? [];
    }

    private async Task ToggleVisibility(PortalDoc d)
    {
        d.Visibility = d.Visibility == "Shared" ? "Agency Only" : "Shared";
        await Api.SetPortalAdminRecordStatusAsync(d.Id, d.Visibility);
        await LoadAsync();
    }

    private async Task CommitShare()
    {
        _newDoc.Id = Guid.NewGuid();
        _newDoc.SharedAt = DateTime.Today;
        _newDoc.FileType = "PDF";
        _newDoc.FileSizeKb = 120;
        var json = System.Text.Json.JsonSerializer.Serialize(new { name = _newDoc.Name, accountName = _newDoc.AccountName, category = _newDoc.Category, fileType = _newDoc.FileType, fileSizeKb = _newDoc.FileSizeKb, visibility = _newDoc.Visibility, sharedAt = _newDoc.SharedAt, viewCount = 0, downloadCount = 0 });
        await Api.CreatePortalAdminRecordAsync(new UpsertPortalAdminRecordRequest(_tenantId, "PortalDocument", _newDoc.Name, _newDoc.Name, _newDoc.Visibility, json));
        CloseUpload();
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = $"Document '{_newDoc.Name}' shared to portal.", CssClass = "e-toast-success" });
        _newDoc = new();
        await LoadAsync();
    }

    private async Task RemoveDoc(PortalDoc d)
    {
        if (!await Confirmations.ConfirmAsync("Remove document", $"Remove {d.Name} from the portal document center?", "Remove")) return;
        await Api.DeletePortalAdminRecordAsync(d.Id);
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = "Document removed from portal.", CssClass = "e-toast-success" });
        await LoadAsync();
    }

    private void CloseUpload() { _showUpload = false; _newDoc = new(); }

    private static string DocIcon(string cat) => cat switch
    {
        "Certificate" => "bi-file-earmark-text",
        "ID Card"     => "bi-person-vcard",
        "Invoice"     => "bi-receipt",
        "Form"        => "bi-clipboard",
        "Claims"      => "bi-exclamation-circle",
        _             => "bi-file-earmark-pdf",
    };

    private static string DocIconCss(string cat) => cat switch
    {
        "Certificate" => "pd-di-green",
        "ID Card"     => "pd-di-blue",
        "Invoice"     => "pd-di-amber",
        "Claims"      => "pd-di-red",
        _             => "pd-di-blue",
    };

    private static string CatBadge(string c) => c switch
    {
        "Policy"      => "pd-cat pd-cat--policy",
        "Certificate" => "pd-cat pd-cat--cert",
        "ID Card"     => "pd-cat pd-cat--id",
        "Invoice"     => "pd-cat pd-cat--inv",
        "Claims"      => "pd-cat pd-cat--claims",
        _             => "pd-cat",
    };

    private static string VisBadge(string v) =>
        v == "Shared" ? "pd-vis pd-vis--shared" : "pd-vis pd-vis--agency";

    private sealed class PortalDoc
    {
        public Guid     Id            { get; set; }
        public string   Name          { get; set; } = string.Empty;
        public string   AccountName   { get; set; } = string.Empty;
        public string   Category      { get; set; } = "Policy";
        public string   FileType      { get; set; } = "PDF";
        public int      FileSizeKb    { get; set; }
        public string   Visibility    { get; set; } = "Shared";
        public DateTime SharedAt      { get; set; }
        public int      ViewCount     { get; set; }
        public int      DownloadCount { get; set; }
    }

    private sealed record Lv(string V, string L);
}
