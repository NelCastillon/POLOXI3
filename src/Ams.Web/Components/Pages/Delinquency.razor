@page "/billing/delinquency"
@inject ApiClient Api

<PageTitle>Delinquency</PageTitle>
<h1>Delinquency Tracking</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(DelinquencyFlagDto.FlagDate)"      HeaderText="Flag Date"   Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(DelinquencyFlagDto.DaysOverdue)"   HeaderText="Days OD"     Width="100"></GridColumn>
        <GridColumn Field="@nameof(DelinquencyFlagDto.OverdueAmount)" HeaderText="Overdue Amt" Width="130" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(DelinquencyFlagDto.SeverityCode)"  HeaderText="Severity"    Width="110"></GridColumn>
        <GridColumn Field="@nameof(DelinquencyFlagDto.StatusCode)"    HeaderText="Status"      Width="110"></GridColumn>
        <GridColumn Field="@nameof(DelinquencyFlagDto.ResolvedDate)"  HeaderText="Resolved"    Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(DelinquencyFlagDto.Notes)"         HeaderText="Notes"       Width="260"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<DelinquencyFlagDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchDelinquencyFlagsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
