@page "/policies/cancellations"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.PolicyCancellations
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Policy Cancellations - AMS</PageTitle>

@if (_toastVisible)
{
    <div class="cc-toast cc-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="cc-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="mt-modal cc-action-modal" role="dialog" aria-modal="true" aria-labelledby="cc-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi @(_form.RequestType == "Reinstatement" ? "bi-arrow-counterclockwise" : "bi-slash-circle")" aria-hidden="true"></i>
                <span id="cc-form-title">@(_form.CancellationId == Guid.Empty ? _form.RequestType == "Reinstatement" ? "Request Reinstatement" : "Request Cancellation" : $"Edit {_form.CancellationNumber}")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_actionBusy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveRequestAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="cc-modal-intro">
                        <span class="cc-modal-chip"><i class="bi bi-shield-exclamation" aria-hidden="true"></i> Policy workflow</span>
                        <p>Manage cancellation, lapse, rescission, return premium, and reinstatement workflows with service and carrier audit history.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full cc-dlg-section">Policy & Account</div>
                        <div class="um-field">
                            <label>Policy Number <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.PolicyNumber" />
                            <ValidationMessage For="() => _form.PolicyNumber" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Account <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.AccountName" />
                            <ValidationMessage For="() => _form.AccountName" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Line of Business <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.LineOfBusiness">
                                <option value="">Select LOB</option>
                                @foreach (var lob in LinesOfBusiness)
                                {
                                    <option value="@lob">@lob</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.LineOfBusiness" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Carrier <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.Carrier">
                                <option value="">Select carrier</option>
                                @foreach (var carrier in Carriers)
                                {
                                    <option value="@carrier">@carrier</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.Carrier" class="text-danger" />
                        </div>

                        <div class="um-field um-field--full cc-dlg-section">Workflow Detail</div>
                        <div class="um-field">
                            <label>Request Type</label>
                            <InputSelect class="form-select" @bind-Value="_form.RequestType">
                                <option value="Cancellation">Cancellation</option>
                                <option value="Reinstatement">Reinstatement</option>
                            </InputSelect>
                            <ValidationMessage For="() => _form.RequestType" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Reason <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.CancellationReason">
                                <option value="">Select reason</option>
                                @foreach (var reason in CancellationReasons)
                                {
                                    <option value="@reason">@reason</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.CancellationReason" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Type</label>
                            <InputSelect class="form-select" @bind-Value="_form.CancellationType">
                                @foreach (var type in CancellationTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.CancellationType" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Effective Date <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="_form.EffectiveDate" />
                            <ValidationMessage For="() => _form.EffectiveDate" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Return Premium</label>
                            <InputNumber class="form-control" @bind-Value="_form.ReturnPremium" />
                            <ValidationMessage For="() => _form.ReturnPremium" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Premium Due</label>
                            <InputNumber class="form-control" @bind-Value="_form.PremiumDue" />
                            <ValidationMessage For="() => _form.PremiumDue" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Priority</label>
                            <InputSelect class="form-select" @bind-Value="_form.Priority">
                                @foreach (var priority in Priorities)
                                {
                                    <option value="@priority">@priority</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.Priority" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Assigned To <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.AssignedToName" />
                            <ValidationMessage For="() => _form.AssignedToName" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Due Date</label>
                            <InputDate class="form-control" @bind-Value="_form.DueDate" />
                        </div>
                        <div class="um-field cc-check-field">
                            <label class="cc-check-label"><InputCheckbox @bind-Value="_form.IsUrgent" /> Urgent workflow</label>
                        </div>
                        <div class="um-field um-field--full">
                            <label>Notes</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_form.Notes" />
                            <ValidationMessage For="() => _form.Notes" class="text-danger" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="um-btn @(_form.RequestType == "Reinstatement" ? "um-btn-success" : "um-btn-danger")" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        Save Request
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showActionDialog)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseActionDialog">
        <div class="mt-modal cc-action-modal" role="dialog" aria-modal="true" aria-labelledby="cc-action-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi @_actionIcon" aria-hidden="true"></i>
                <span id="cc-action-title">@_actionTitle</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseActionDialog" disabled="@_actionBusy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_actionForm" OnValidSubmit="ConfirmActionAsync" OnInvalidSubmit="NotifyActionValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="cc-modal-intro">
                        <span class="cc-modal-chip"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Workflow action</span>
                        <p>@_actionHelpText</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Request</label>
                            <input class="form-control cc-readonly-input" value="@_selected.CancellationNumber - @_selected.AccountName" disabled />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Notes @if (ActionRequiresNotes) { <span class="text-danger">*</span> }</label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_actionForm.Notes" />
                            <ValidationMessage For="() => _actionForm.Notes" class="text-danger" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseActionDialog" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="um-btn @(_pendingAction is "Deny" or "Archive" ? "um-btn-danger" : "um-btn-primary")" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @_actionButtonText
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="cc-enterprise-page" @onclick="CloseActionMenu">
    <section class="cc-hero" aria-label="Policy cancellations enterprise header">
        <div class="cc-hero-left">
            <div class="cc-hero-icon"><i class="bi bi-slash-circle" aria-hidden="true"></i></div>
            <div>
                <div class="cc-title-row">
                    <h1>Policy Cancellations</h1>
                    <span><i class="bi bi-stack" aria-hidden="true"></i>@FilteredRows.Count() active</span>
                    @if (HasFilters)
                    {
                        <span><i class="bi bi-funnel" aria-hidden="true"></i>Filtered</span>
                    }
                </div>
                <p>Enterprise cancellation, lapse, rescission, return premium, and reinstatement command center synchronized to policy service workflows.</p>
            </div>
        </div>
        <div class="cc-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "cc-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-danger" @onclick='() => OpenNew("Cancellation")'><i class="bi bi-slash-circle" aria-hidden="true"></i> Request Cancellation</button>
            <button class="um-btn um-btn-primary" @onclick='() => OpenNew("Reinstatement")'><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reinstate Policy</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger cc-load-error" style="border-left: 4px solid #dc3545; animation: cc-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div>
    }

    <section class="cc-kpi-strip" aria-label="Cancellation KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="cc-kpi-card cc-@kpi.Tone @(_kpiFilter == kpi.Filter ? "cc-kpi-card-active" : null)" title="@kpi.Tooltip" @onclick="() => ApplyKpiFromButton(kpi.Filter)">
                <span class="cc-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span><strong class="cc-kpi-val">@kpi.Value</strong><span class="cc-kpi-lbl">@kpi.Label</span><small>@kpi.Detail</small></span>
            </button>
        }
    </section>

    <section class="cc-workflow-strip" aria-label="Policy cancellation workflow shortcuts">
        @foreach (var shortcut in WorkflowShortcuts)
        {
            <button type="button" class="cc-workflow-card" @onclick="shortcut.Callback">
                <i class="bi @shortcut.Icon" aria-hidden="true"></i>
                <span><strong>@shortcut.Title</strong><small>@shortcut.Detail</small></span>
            </button>
        }
    </section>

    <section class="um-search-filter-row" role="search" aria-label="Search cancellations">
        <div class="um-search-box">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="cc-search-input" class="um-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search policy #, account, carrier, LOB, reason, type, status, assignee, workflow, notes..." />
        </div>
        <select class="cc-filter-select" aria-label="Request type filter" @bind="_requestTypeFilter" @bind:after="OnFilterChanged">
            <option value="">All request types</option>
            <option value="Cancellation">Cancellations</option>
            <option value="Reinstatement">Reinstatements</option>
        </select>
        <select class="cc-filter-select" aria-label="Priority filter" @bind="_priorityFilter" @bind:after="OnFilterChanged">
            <option value="">All priorities</option>
            @foreach (var priority in Priorities)
            {
                <option value="@priority">@priority</option>
            }
        </select>
        <select class="cc-filter-select" aria-label="Carrier filter" @bind="_carrierFilter" @bind:after="OnFilterChanged">
            <option value="">All carriers</option>
            @foreach (var carrier in CarrierOptions)
            {
                <option value="@carrier">@carrier</option>
            }
        </select>
        <div class="um-search-result"><strong>@FilteredRows.Count()</strong><span>matches</span></div>
        @if (HasFilters)
        {
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
        }
    </section>

    <div class="cc-bulk-bar">
        <span><i class="bi bi-diagram-3" aria-hidden="true"></i> @WorkflowSummary</span>
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies")'><i class="bi bi-shield-check" aria-hidden="true"></i> Policies</button>
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/endorsements")'><i class="bi bi-pen" aria-hidden="true"></i> Endorsements</button>
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/documents")'><i class="bi bi-folder2" aria-hidden="true"></i> Documents</button>
        <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => SetActiveTab("board")'><i class="bi bi-kanban" aria-hidden="true"></i> Workflow Board</button>
    </div>

    <div class="cc-view-tabs" role="tablist" aria-label="Cancellation views">
        @foreach (var tab in _tabs)
        {
            <button class="cc-view-btn @(_activeTab == tab.Key ? "cc-view-btn-active" : null)" type="button" role="tab" aria-selected="@(_activeTab == tab.Key)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label <span>@TabCount(tab.Key)</span>
            </button>
        }
    </div>

    <section class="cc-content-layout">
        <div class="cc-main-card">
            @if (_loading)
            {
                <div class="cc-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Loading cancellations...</span></div>
            }
            else if (!PagedRows.Any())
            {
                <div class="cc-empty-state"><i class="bi bi-shield-exclamation" aria-hidden="true"></i><strong>No workflows found</strong><span>Adjust the current tab, KPI, or search criteria.</span></div>
            }
            else if (_activeTab == "board")
            {
                <div class="cc-board" aria-label="Cancellation workflow board">
                    @foreach (var group in BoardGroups)
                    {
                        <section class="cc-board-col">
                            <header><strong>@group.Label</strong><span>@group.Rows.Count</span></header>
                            @foreach (var row in group.Rows.Take(8))
                            {
                                <article class="cc-board-card" @onclick="() => OpenDetail(row)">
                                    <div><strong>@row.CancellationNumber</strong><span class="cc-status @StatusClass(row.Status)">@row.Status</span></div>
                                    <span>@row.AccountName</span>
                                    <small>@row.PolicyNumber - @row.LineOfBusiness - due @(row.DueDate?.ToString("MM/dd") ?? "n/a")</small>
                                </article>
                            }
                        </section>
                    }
                </div>
            }
            else if (_activeTab == "analytics")
            {
                <div class="cc-analytics-grid">
                    <section>
                        <h3>Carrier concentration</h3>
                        @foreach (var row in CarrierBreakdown)
                        {
                            <button type="button" class="cc-stage-row @(string.Equals(_carrierFilter, row.Label, StringComparison.OrdinalIgnoreCase) ? "cc-active" : null)" @onclick="() => SetCarrierFilter(row.Label)"><span>@row.Label</span><div><i style="width:@row.Percent%"></i></div><strong>@row.Count</strong></button>
                        }
                    </section>
                    <section>
                        <h3>Reason distribution</h3>
                        @foreach (var row in ReasonBreakdown)
                        {
                            <button type="button" class="cc-stage-row" @onclick="() => SetSearch(row.Label)"><span>@row.Label</span><div><i style="width:@row.Percent%"></i></div><strong>@row.Count</strong></button>
                        }
                    </section>
                </div>
            }
            else
            {
                <div class="cc-table-scroll">
                    <table class="cc-table" aria-label="Policy cancellations register">
                        <thead>
                            <tr>
                                <th>Workflow #</th>
                                <th>Policy #</th>
                                <th>Account</th>
                                <th>LOB</th>
                                <th>Request</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th>Effective</th>
                                <th>Due</th>
                                <th class="cc-number">Return Prem</th>
                                <th class="cc-number">Premium Due</th>
                                <th>Assigned</th>
                                <th>Workflow</th>
                                <th class="cc-actions-col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in PagedRows)
                            {
                                <tr class="@(_drawerRow?.CancellationId == row.CancellationId ? "cc-row-selected" : null)" @onclick="() => OpenDetail(row)">
                                    <td><button type="button" class="cc-link-btn" @onclick:stopPropagation="true" @onclick="() => OpenDetail(row)">@row.CancellationNumber</button></td>
                                    <td><button type="button" class="cc-link-btn" @onclick:stopPropagation="true" @onclick="() => NavigateToPolicy(row)">@row.PolicyNumber</button></td>
                                    <td><div class="cc-name-cell"><span class="cc-avatar @AvatarClass(row.AccountName)">@Initials(row.AccountName)</span><div><strong>@row.AccountName</strong><small>@row.Carrier</small></div></div></td>
                                    <td><span class="cc-source-badge">@row.LineOfBusiness</span></td>
                                    <td><span class="cc-type-chip @RequestTypeClass(row.RequestType)">@row.RequestType</span></td>
                                    <td>@row.CancellationReason</td>
                                    <td><span class="cc-status @StatusClass(row.Status)">@row.Status</span></td>
                                    <td>@row.EffectiveDate.ToString("MM/dd/yyyy")</td>
                                    <td><span class="@DueClass(row)">@(row.DueDate?.ToString("MM/dd/yyyy") ?? "-")</span></td>
                                    <td class="cc-number"><span class="cc-return">@row.ReturnPremium.ToString("C0")</span></td>
                                    <td class="cc-number"><span class="cc-premdue">@row.PremiumDue.ToString("C0")</span></td>
                                    <td>@row.AssignedToName</td>
                                    <td><span class="cc-workflow-chip @PriorityClass(row.Priority)">@row.WorkflowStage</span></td>
                                    <td class="cc-actions-col"><button class="um-btn um-btn-ghost um-btn-xs cc-ctx-btn" @onclick:stopPropagation="true" @onclick="(e) => OpenActionMenu(row, e.ClientX, e.ClientY)" aria-label="Open actions"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="cc-pager">
                    <span>@PageSummary</span>
                    <div>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                    </div>
                </div>
            }
        </div>
        <aside class="cc-detail-card">
            @if (_drawerRow is null)
            {
                <div class="cc-detail-empty"><i class="bi bi-layout-sidebar-inset-reverse" aria-hidden="true"></i><strong>Select a workflow</strong><span>Click a cancellation or reinstatement row to review service actions, timeline, and linked policy data.</span></div>
            }
            else
            {
                <div class="cc-detail-head">
                    <div>
                        <span class="cc-detail-eyebrow"><i class="bi bi-diagram-3" aria-hidden="true"></i> @_drawerRow.WorkflowStage</span>
                        <h2>@_drawerRow.CancellationNumber</h2>
                        <p>@_drawerRow.PolicyNumber - @_drawerRow.AccountName</p>
                    </div>
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseDrawer" aria-label="Close details"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="cc-detail-body">
                    <div class="cc-detail-summary">
                        <div><span>Status</span><strong>@_drawerRow.Status</strong></div>
                        <div><span>Priority</span><strong>@_drawerRow.Priority</strong></div>
                        <div><span>Return premium</span><strong>@_drawerRow.ReturnPremium.ToString("C0")</strong></div>
                        <div><span>Premium due</span><strong>@_drawerRow.PremiumDue.ToString("C0")</strong></div>
                        <div><span>Effective</span><strong>@_drawerRow.EffectiveDate.ToString("MM/dd/yyyy")</strong></div>
                        <div><span>Due</span><strong>@(_drawerRow.DueDate?.ToString("MM/dd/yyyy") ?? "-")</strong></div>
                    </div>
                    <div class="cc-contact-card">
                        <strong>@_drawerRow.CancellationReason</strong>
                        <span>@(string.IsNullOrWhiteSpace(_drawerRow.Notes) ? "No notes captured." : _drawerRow.Notes)</span>
                    </div>
                    <section class="cc-detail-timeline">
                        <h3><i class="bi bi-clock-history" aria-hidden="true"></i> Activity Timeline</h3>
                        @foreach (var a in ActivitiesFor(_drawerRow.CancellationId).Take(5))
                        {
                            <div class="cc-timeline-item"><span class="cc-timeline-dot"></span><div><strong>@a.Subject</strong><span>@a.ActivityType - @a.CreatedByName - @a.ActivityDateUtc.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</span></div></div>
                        }
                    </section>
                    <div class="cc-detail-actions">
                        <div class="cc-detail-actions-row">
                            <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => OpenWorkflowAction(_drawerRow, "Review")' disabled="@IsTerminal(_drawerRow)"><i class="bi bi-search" aria-hidden="true"></i> Review</button>
                            <button class="um-btn um-btn-danger um-btn-sm" @onclick='() => OpenWorkflowAction(_drawerRow, "Approve Cancel")' disabled="@(_drawerRow.RequestType != "Cancellation" || IsTerminal(_drawerRow))"><i class="bi bi-slash-circle" aria-hidden="true"></i> Approve</button>
                            <button class="um-btn um-btn-success um-btn-sm" @onclick='() => OpenWorkflowAction(_drawerRow, "Reinstate")' disabled="@(_drawerRow.RequestType != "Reinstatement" || _drawerRow.Status == "Reinstated")"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reinstate</button>
                        </div>
                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenWorkflowAction(_drawerRow, "Add Note")'><i class="bi bi-chat-left-text" aria-hidden="true"></i> Add Note</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@if (_openActionMenuFor is not null)
{
    <div class="cc-context-menu" style="left:@_menuXpx; top:@_menuYpx" @onclick:stopPropagation="true">
        @foreach (var action in _actionItems)
        {
            <button type="button" @onclick="() => ExecuteMenuAction(action.Label)"><i class="bi @action.Icon" aria-hidden="true"></i><span>@action.Label</span></button>
        }
    </div>
}

@code {
    Guid _tenantId;
    Guid _tenantAdminUserId;
    bool _loading;
    bool _showForm;
    bool _showActionDialog;
    bool _actionBusy;
    bool _toastVisible;
    string _activeTab = "all";
    string _toastMessage = string.Empty;
    string _toastKind = "success";
    string? _kpiFilter;
    string? _loadError;
    string? _searchText;
    string? _requestTypeFilter;
    string? _priorityFilter;
    string? _carrierFilter;
    Guid? _openActionMenuFor;
    string _menuXpx = "0px";
    string _menuYpx = "0px";
    int _page = 1;
    const int PageSize = 20;

    PolicyCancellationDto _selected = new();
    PolicyCancellationDto? _drawerRow;
    CancellationForm _form = new();
    readonly CancellationActionForm _actionForm = new();
    string _pendingAction = string.Empty;
    string _actionTitle = "Cancellation Action";
    string _actionIcon = "bi-lightning-charge";
    string _actionButtonText = "Continue";
    string _actionHelpText = string.Empty;

    readonly List<PolicyCancellationDto> _rows = [];
    readonly List<PolicyCancellationActivityDto> _activities = [];

    static readonly string[] LinesOfBusiness = ["Commercial Auto", "Commercial Property", "General Liability", "Workers Comp", "Professional Liability", "Umbrella", "Cyber", "Directors & Officers", "Personal Auto", "Homeowners", "Life", "Health", "Flood"];
    static readonly string[] Carriers = ["Travelers", "Hartford", "CNA", "Liberty Mutual", "Zurich", "AIG", "Nationwide", "Cincinnati", "Chubb", "Berkshire Hathaway"];
    static readonly string[] CancellationReasons = ["Non-Payment", "Underwriting", "Insured Request", "Fraud", "Material Misrepresentation", "Risk Ineligible", "Business Closed", "Payment Received"];
    static readonly string[] CancellationTypes = ["Flat", "Pro-Rata", "Short Rate"];
    static readonly string[] Priorities = ["Low", "Normal", "High", "Critical"];

    readonly TabDef[] _tabs =
    [
        new("all", "All", "bi-stack"),
        new("open", "Open", "bi-hourglass-split"),
        new("cancellations", "Cancellations", "bi-slash-circle"),
        new("reinstatements", "Reinstatements", "bi-arrow-counterclockwise"),
        new("cancelled", "Cancelled", "bi-x-circle"),
        new("reinstated", "Reinstated", "bi-check-circle"),
        new("rescinded", "Rescinded", "bi-arrow-undo"),
        new("urgent", "Urgent", "bi-exclamation-triangle"),
        new("board", "Board", "bi-kanban"),
        new("analytics", "Analytics", "bi-bar-chart"),
    ];

    readonly ActionItem[] _actionItems =
    [
        new("View Policy", "bi-shield"),
        new("Review", "bi-search"),
        new("Edit", "bi-pencil"),
        new("Approve Cancel", "bi-slash-circle"),
        new("Deny", "bi-x-lg"),
        new("Rescind", "bi-arrow-undo"),
        new("Reinstate", "bi-arrow-counterclockwise"),
        new("Add Note", "bi-chat-left-text"),
        new("Archive", "bi-archive"),
    ];

    bool HasFilters => !string.IsNullOrWhiteSpace(_searchText) || _kpiFilter is not null || !string.IsNullOrWhiteSpace(_requestTypeFilter) || !string.IsNullOrWhiteSpace(_priorityFilter) || !string.IsNullOrWhiteSpace(_carrierFilter);
    bool ActionRequiresNotes => _pendingAction is "Deny" or "Rescind" or "Add Note";
    string? SearchText { get => _searchText; set { _searchText = value; _page = 1; } }

    IEnumerable<PolicyCancellationDto> BaseTabRows => _activeTab switch
    {
        "open" => _rows.Where(r => r.Status is "Pending" or "Under Review" or "Reinstatement Pending"),
        "cancellations" => _rows.Where(r => r.RequestType == "Cancellation"),
        "reinstatements" => _rows.Where(r => r.RequestType == "Reinstatement"),
        "cancelled" => _rows.Where(r => r.Status == "Cancelled"),
        "reinstated" => _rows.Where(r => r.Status == "Reinstated"),
        "rescinded" => _rows.Where(r => r.Status == "Rescinded"),
        "urgent" => _rows.Where(r => r.IsUrgent),
        "board" => _rows,
        "analytics" => _rows,
        _ => _rows,
    };

    IEnumerable<PolicyCancellationDto> FilteredRows => ApplyEnterpriseFilters(BaseTabRows);
    IEnumerable<PolicyCancellationDto> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize);
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)PageSize));
    string PageSummary => FilteredRows.Any() ? $"Showing {((_page - 1) * PageSize) + 1}-{Math.Min(_page * PageSize, FilteredRows.Count())} of {FilteredRows.Count()}" : "No workflows";
    IEnumerable<string> CarrierOptions => _rows.Select(r => r.Carrier).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c);
    string WorkflowSummary => $"{FilteredRows.Count()} workflows across {FilteredRows.Select(r => r.Carrier).Distinct(StringComparer.OrdinalIgnoreCase).Count()} carriers";
    IEnumerable<KpiDef> Kpis =>
    [
        new KpiDef("bi-stack", "Total", _rows.Count.ToString("N0"), "workflows", "Show all active cancellation workflows", "blue", null),
        new KpiDef("bi-hourglass-split", "Open", _rows.Count(r => r.Status is "Pending" or "Under Review" or "Reinstatement Pending").ToString("N0"), "needs service", "Filter to open cancellation and reinstatement workflows", "amber", "__open"),
        new KpiDef("bi-slash-circle", "Cancelled", _rows.Count(r => r.Status == "Cancelled").ToString("N0"), "completed", "Filter to completed policy cancellations", "red", "Cancelled"),
        new KpiDef("bi-arrow-counterclockwise", "Reinstated", _rows.Count(r => r.Status == "Reinstated").ToString("N0"), "restored", "Filter to reinstated policies", "green", "Reinstated"),
        new KpiDef("bi-arrow-undo", "Rescinded", _rows.Count(r => r.Status == "Rescinded").ToString("N0"), "withdrawn", "Filter to rescinded cancellation requests", "purple", "Rescinded"),
        new KpiDef("bi-exclamation-triangle", "Urgent", _rows.Count(r => r.IsUrgent).ToString("N0"), "escalations", "Filter to urgent workflows", "amber", "__urgent"),
        new KpiDef("bi-cash-coin", "Return Premium", _rows.Sum(r => r.ReturnPremium).ToString("C0"), "tracked", "Filter to workflows with return premium", "cyan", "__return"),
    ];
    IEnumerable<WorkflowShortcut> WorkflowShortcuts =>
    [
        new WorkflowShortcut("Open cancellation", "Start cancellation request", "bi-slash-circle", () => OpenNew("Cancellation")),
        new WorkflowShortcut("Open reinstatement", "Start reinstatement request", "bi-arrow-counterclockwise", () => OpenNew("Reinstatement")),
        new WorkflowShortcut("Review pending", "Focus on open workflows", "bi-search", () => SetActiveTab("open")),
        new WorkflowShortcut("Go to policies", "Open policy register", "bi-shield-check", () => Nav.NavigateTo("/policies")),
    ];
    IEnumerable<BoardGroup> BoardGroups =>
    [
        new("Pending", FilteredRows.Where(r => r.Status == "Pending").ToList()),
        new("Under Review", FilteredRows.Where(r => r.Status == "Under Review").ToList()),
        new("Reinstatement Pending", FilteredRows.Where(r => r.Status == "Reinstatement Pending").ToList()),
        new("Completed", FilteredRows.Where(r => r.Status is "Cancelled" or "Reinstated" or "Rescinded").ToList()),
    ];
    IEnumerable<BreakdownRow> CarrierBreakdown => BuildBreakdown(FilteredRows.Where(r => !string.IsNullOrWhiteSpace(r.Carrier)).GroupBy(r => r.Carrier).OrderByDescending(g => g.Count()).Take(8));
    IEnumerable<BreakdownRow> ReasonBreakdown => BuildBreakdown(FilteredRows.Where(r => !string.IsNullOrWhiteSpace(r.CancellationReason)).GroupBy(r => r.CancellationReason).OrderByDescending(g => g.Count()).Take(8));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policies", "/policies"), new("Cancellations", "/policies/cancellations"));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var center = await Api.GetPolicyCancellationCenterAsync(_tenantId);
            _rows.Clear();
            _activities.Clear();
            _rows.AddRange(center?.Cancellations ?? []);
            _activities.AddRange(center?.Activities ?? []);
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load cancellations: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally { _loading = false; }
    }

    IEnumerable<PolicyCancellationDto> ApplyEnterpriseFilters(IEnumerable<PolicyCancellationDto> rows)
    {
        if (_kpiFilter is not null)
        {
            rows = _kpiFilter switch
            {
                "__open" => rows.Where(r => r.Status is "Pending" or "Under Review" or "Reinstatement Pending"),
                "__urgent" => rows.Where(r => r.IsUrgent),
                "__return" => rows.Where(r => r.ReturnPremium != 0),
                _ => rows.Where(r => r.Status == _kpiFilter)
            };
        }
        if (!string.IsNullOrWhiteSpace(_requestTypeFilter))
            rows = rows.Where(r => string.Equals(r.RequestType, _requestTypeFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_priorityFilter))
            rows = rows.Where(r => string.Equals(r.Priority, _priorityFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_carrierFilter))
            rows = rows.Where(r => string.Equals(r.Carrier, _carrierFilter, StringComparison.OrdinalIgnoreCase));
        if (string.IsNullOrWhiteSpace(_searchText)) return rows;
        var term = _searchText.Trim();
        return rows.Where(r => SearchBlob(r).Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    static string SearchBlob(PolicyCancellationDto r) => string.Join(' ', r.CancellationNumber, r.PolicyNumber, r.AccountName, r.LineOfBusiness, r.Carrier, r.CancellationReason, r.CancellationType, r.RequestType, r.Status, r.Priority, r.RequestedByName, r.AssignedToName, r.Notes, r.WorkflowStage, r.EffectiveDate.ToString("MM/dd/yyyy"), r.DueDate?.ToString("MM/dd/yyyy"));
    void SetActiveTab(string tab) { _activeTab = tab; _kpiFilter = null; _page = 1; }
    void ApplyKpiFilter(string? filter) { _kpiFilter = _kpiFilter == filter ? null : filter; _page = 1; }
    void OnFilterChanged() => _page = 1;
    void SetCarrierFilter(string carrier) { _carrierFilter = carrier; _page = 1; }
    void SetSearch(string term) => SearchText = term;
    void ClearFilters() { _searchText = null; _kpiFilter = null; _requestTypeFilter = null; _priorityFilter = null; _carrierFilter = null; _page = 1; }
    void PreviousPage() { if (_page > 1) _page--; }
    void NextPage() { if (_page < TotalPages) _page++; }
    int TabCount(string key) => key switch
    {
        "open" => _rows.Count(r => r.Status is "Pending" or "Under Review" or "Reinstatement Pending"),
        "cancellations" => _rows.Count(r => r.RequestType == "Cancellation"),
        "reinstatements" => _rows.Count(r => r.RequestType == "Reinstatement"),
        "cancelled" => _rows.Count(r => r.Status == "Cancelled"),
        "reinstated" => _rows.Count(r => r.Status == "Reinstated"),
        "rescinded" => _rows.Count(r => r.Status == "Rescinded"),
        "urgent" => _rows.Count(r => r.IsUrgent),
        "board" => _rows.Count(r => r.Status is "Pending" or "Under Review" or "Reinstatement Pending"),
        "analytics" => _rows.Select(r => r.Carrier).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
        _ => _rows.Count,
    };

    void OpenNew(string requestType)
    {
        _form = new CancellationForm { RequestType = requestType, CancellationReason = requestType == "Reinstatement" ? "Payment Received" : string.Empty, EffectiveDate = DateTime.Today, DueDate = DateTime.Today.AddDays(5), RequestedByName = "Current User", AssignedToName = "Service Team", Priority = "Normal" };
        _showForm = true;
    }

    void OpenEdit(PolicyCancellationDto row) { _selected = row; _form = CancellationForm.From(row); _showForm = true; }
    void CloseForm() => _showForm = false;

    async Task SaveRequestAsync()
    {
        _actionBusy = true;
        try
        {
            if (_form.CancellationId == Guid.Empty)
            {
                await Api.CreatePolicyCancellationAsync(new CreatePolicyCancellationRequest
                {
                    TenantId = _tenantId,
                    PolicyId = _form.PolicyId,
                    AccountId = _form.AccountId,
                    PolicyNumber = _form.PolicyNumber,
                    AccountName = _form.AccountName,
                    LineOfBusiness = _form.LineOfBusiness,
                    Carrier = _form.Carrier,
                    CancellationReason = _form.CancellationReason,
                    CancellationType = _form.CancellationType,
                    RequestType = _form.RequestType,
                    EffectiveDate = _form.EffectiveDate,
                    ReturnPremium = _form.ReturnPremium,
                    PremiumDue = _form.PremiumDue,
                    Priority = _form.Priority,
                    RequestedByName = _form.RequestedByName,
                    AssignedToName = _form.AssignedToName,
                    Notes = _form.Notes,
                    DueDate = _form.DueDate,
                    IsUrgent = _form.IsUrgent,
                    CreatedByUserId = _tenantAdminUserId
                });
                ShowToast("Workflow request created.");
            }
            else
            {
                await Api.UpdatePolicyCancellationAsync(_form.CancellationId, new UpdatePolicyCancellationRequest { CancellationReason = _form.CancellationReason, CancellationType = _form.CancellationType, EffectiveDate = _form.EffectiveDate, ReturnPremium = _form.ReturnPremium, PremiumDue = _form.PremiumDue, Priority = _form.Priority, AssignedToName = _form.AssignedToName, Notes = _form.Notes, DueDate = _form.DueDate, IsUrgent = _form.IsUrgent, ModifiedByUserId = _tenantAdminUserId });
                ShowToast("Workflow request updated.");
            }
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast($"Save failed: {ex.Message}", "danger"); }
        finally { _actionBusy = false; }
    }

    void OpenDetail(PolicyCancellationDto row) => _drawerRow = row;
    void CloseDrawer() => _drawerRow = null;

    void OpenWorkflowAction(PolicyCancellationDto row, string action)
    {
        _selected = row;
        _pendingAction = action;
        _actionForm.Notes = null;
        (_actionTitle, _actionIcon, _actionButtonText, _actionHelpText) = action switch
        {
            "Review" => ("Review workflow", "bi-search", "Start Review", "Move the request into service and carrier review."),
            "Approve Cancel" => ("Approve cancellation", "bi-slash-circle", "Approve Cancellation", "Approve and complete the policy cancellation workflow."),
            "Deny" => ("Deny request", "bi-x-circle", "Deny", "Deny this workflow request and record the reason."),
            "Rescind" => ("Rescind cancellation", "bi-arrow-undo", "Rescind", "Rescind the cancellation request and close the workflow."),
            "Reinstate" => ("Reinstate policy", "bi-arrow-counterclockwise", "Reinstate", "Approve reinstatement and mark the policy as reinstated."),
            "Add Note" => ("Add workflow note", "bi-chat-left-text", "Add Note", "Add an activity note to the workflow timeline."),
            "Archive" => ("Archive workflow", "bi-archive", "Archive", "Archive this workflow from the active register."),
            _ => ("Workflow action", "bi-lightning-charge", "Continue", "Continue this workflow action.")
        };
        _showActionDialog = true;
    }

    void CloseActionDialog() => _showActionDialog = false;

    async Task ConfirmActionAsync()
    {
        if (ActionRequiresNotes && string.IsNullOrWhiteSpace(_actionForm.Notes)) { ShowToast("Notes are required for this action.", "danger"); return; }
        _actionBusy = true;
        try
        {
            switch (_pendingAction)
            {
                case "Add Note":
                    await Api.AddPolicyCancellationActivityAsync(new AddPolicyCancellationActivityRequest { CancellationId = _selected.CancellationId, ActivityType = "Note", Subject = "Workflow note added", Notes = _actionForm.Notes, CreatedByName = "Current User", CreatedByUserId = _tenantAdminUserId });
                    ShowToast("Note added.");
                    break;
                case "Archive":
                    await Api.ArchivePolicyCancellationAsync(_selected.CancellationId, _tenantAdminUserId);
                    ShowToast("Workflow archived.");
                    break;
                default:
                    await UpdateStatusAsync(_selected, StatusForAction(_pendingAction), _actionForm.Notes);
                    break;
            }
            _showActionDialog = false;
            _drawerRow = null;
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast($"Action failed: {ex.Message}", "danger"); }
        finally { _actionBusy = false; }
    }

    async Task UpdateStatusAsync(PolicyCancellationDto row, string status, string? notes = null)
    {
        await Api.UpdatePolicyCancellationStatusAsync(row.CancellationId, new UpdatePolicyCancellationStatusRequest { Status = status, Notes = notes, CreatedByName = "Current User", ModifiedByUserId = _tenantAdminUserId });
        ShowToast($"Workflow {status.ToLowerInvariant()}.");
    }

    static string StatusForAction(string action) => action switch
    {
        "Review" => "Under Review",
        "Approve Cancel" => "Cancelled",
        "Deny" => "Denied",
        "Rescind" => "Rescinded",
        "Reinstate" => "Reinstated",
        _ => "Under Review"
    };

    static string StageFor(string status) => status switch
    {
        "Pending" => "Cancellation Intake",
        "Under Review" => "Carrier / Service Review",
        "Approved" => "Approved Pending Cancellation",
        "Cancelled" => "Cancelled Policy",
        "Denied" => "Closed Denied",
        "Rescinded" => "Rescinded by Client",
        "Reinstatement Pending" => "Reinstatement Review",
        "Reinstated" => "Policy Reinstated",
        _ => "Cancellation Intake"
    };

    async Task ExecuteMenuAction(string action)
    {
        CloseActionMenu();
        switch (action)
        {
            case "View Policy": NavigateToPolicy(_selected); break;
            case "Edit": OpenEdit(_selected); break;
            case "Review": OpenWorkflowAction(_selected, "Review"); break;
            case "Approve Cancel": OpenWorkflowAction(_selected, "Approve Cancel"); break;
            case "Deny": OpenWorkflowAction(_selected, "Deny"); break;
            case "Rescind": OpenWorkflowAction(_selected, "Rescind"); break;
            case "Reinstate": OpenWorkflowAction(_selected, "Reinstate"); break;
            case "Add Note": OpenWorkflowAction(_selected, "Add Note"); break;
            case "Archive": OpenWorkflowAction(_selected, "Archive"); break;
            default: await Task.CompletedTask; break;
        }
    }

    void NavigateToPolicy(PolicyCancellationDto row) => Nav.NavigateTo(row.PolicyId is { } policyId && policyId != Guid.Empty ? $"/policies/{policyId}" : "/policies");
    IEnumerable<PolicyCancellationActivityDto> ActivitiesFor(Guid id) => _activities.Where(a => a.CancellationId == id).OrderByDescending(a => a.ActivityDateUtc);
    static bool IsTerminal(PolicyCancellationDto row) => row.Status is "Cancelled" or "Denied" or "Rescinded" or "Reinstated";
    void OpenActionMenu(PolicyCancellationDto row, double x, double y) { _selected = row; _openActionMenuFor = row.CancellationId; _menuXpx = $"{x}px"; _menuYpx = $"{y}px"; }
    void CloseActionMenu() => _openActionMenuFor = null;
    void ApplyKpiFromButton(string? filter) => ApplyKpiFilter(filter);

    static IEnumerable<BreakdownRow> BuildBreakdown(IEnumerable<IGrouping<string, PolicyCancellationDto>> groups)
    {
        var rows = groups.Select(g => new { Label = g.Key, Count = g.Count() }).OrderByDescending(g => g.Count).ThenBy(g => g.Label).Take(8).ToList();
        var max = Math.Max(1, rows.Count == 0 ? 1 : rows.Max(r => r.Count));
        return rows.Select(r => new BreakdownRow(r.Label, r.Count, Math.Clamp(r.Count * 100 / max, 8, 100)));
    }

    static string StatusClass(string status) => status.ToLowerInvariant().Replace(" ", "-") switch
    {
        "pending" => "cc-status-pending",
        "under-review" => "cc-status-review",
        "cancelled" => "cc-status-cancelled",
        "denied" => "cc-status-denied",
        "rescinded" => "cc-status-rescinded",
        "reinstatement-pending" => "cc-status-reinstate-pending",
        "reinstated" => "cc-status-reinstated",
        _ => "cc-status-pending"
    };
    static string RequestTypeClass(string requestType) => requestType == "Reinstatement" ? "cc-type-reinstate" : "cc-type-cancel";
    static string PriorityClass(string priority) => priority switch { "High" => "cc-workflow-high", "Critical" => "cc-workflow-critical", "Low" => "cc-workflow-low", _ => "cc-workflow-normal" };
    static string DueClass(PolicyCancellationDto row) { if (row.DueDate is null) return "cc-due-none"; var days = (row.DueDate.Value.Date - DateTime.Today).Days; return days < 0 ? "cc-due-overdue" : days <= 3 ? "cc-due-soon" : "cc-due-ok"; }
    static string Initials(string name) { var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length switch { 0 => "?", 1 => parts[0][0].ToString().ToUpperInvariant(), _ => string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant() }; }
    static string AvatarClass(string name) => $"cc-av{Math.Abs(name.GetHashCode()) % 6 + 1}";
    void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    void HideToast() => _toastVisible = false;
    Task NotifyValidationAsync() { ShowToast("Please correct the highlighted workflow fields.", "danger"); return Task.CompletedTask; }
    Task NotifyActionValidationAsync() { ShowToast("Please correct the highlighted action fields.", "danger"); return Task.CompletedTask; }
    async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; }

    sealed record TabDef(string Key, string Label, string Icon);
    sealed record ActionItem(string Label, string Icon);
    sealed record KpiDef(string Icon, string Label, string Value, string Detail, string Tooltip, string Tone, string? Filter);
    sealed record WorkflowShortcut(string Title, string Detail, string Icon, global::System.Action Callback);
    sealed record BoardGroup(string Label, IReadOnlyList<PolicyCancellationDto> Rows);
    sealed record BreakdownRow(string Label, int Count, int Percent);

    sealed class CancellationForm
    {
        public Guid CancellationId { get; set; }
        public Guid? PolicyId { get; set; }
        public Guid? AccountId { get; set; }
        public string CancellationNumber { get; set; } = string.Empty;
        [Required, StringLength(50)] public string PolicyNumber { get; set; } = string.Empty;
        [Required, StringLength(200)] public string AccountName { get; set; } = string.Empty;
        [Required, StringLength(100)] public string LineOfBusiness { get; set; } = string.Empty;
        [Required, StringLength(160)] public string Carrier { get; set; } = string.Empty;
        [Required, StringLength(100)] public string CancellationReason { get; set; } = string.Empty;
        [Required, StringLength(40)] public string CancellationType { get; set; } = "Pro-Rata";
        [Required, StringLength(40)] public string RequestType { get; set; } = "Cancellation";
        [Required] public DateTime EffectiveDate { get; set; } = DateTime.Today;
        [Range(-10000000, 10000000)] public decimal ReturnPremium { get; set; }
        [Range(0, 10000000)] public decimal PremiumDue { get; set; }
        [Required, StringLength(40)] public string Priority { get; set; } = "Normal";
        [Required, StringLength(160)] public string RequestedByName { get; set; } = "Current User";
        [Required, StringLength(160)] public string AssignedToName { get; set; } = string.Empty;
        [StringLength(1000)] public string? Notes { get; set; }
        public DateTime? DueDate { get; set; }
        public bool IsUrgent { get; set; }
        public static CancellationForm From(PolicyCancellationDto row) => new() { CancellationId = row.CancellationId, PolicyId = row.PolicyId, AccountId = row.AccountId, CancellationNumber = row.CancellationNumber, PolicyNumber = row.PolicyNumber, AccountName = row.AccountName, LineOfBusiness = row.LineOfBusiness, Carrier = row.Carrier, CancellationReason = row.CancellationReason, CancellationType = row.CancellationType, RequestType = row.RequestType, EffectiveDate = row.EffectiveDate, ReturnPremium = row.ReturnPremium, PremiumDue = row.PremiumDue, Priority = row.Priority, RequestedByName = row.RequestedByName, AssignedToName = row.AssignedToName, Notes = row.Notes, DueDate = row.DueDate, IsUrgent = row.IsUrgent };
    }

    sealed class CancellationActionForm
    {
        [StringLength(1000)] public string? Notes { get; set; }
    }
}
