@page "/crm/forecast"
@inject ApiClient Api

<PageTitle>Sales Forecast</PageTitle>

<h1>Sales Forecast</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search period or category..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(ForecastEntryDto.ForecastPeriod)" HeaderText="Period" Width="120"></GridColumn>
            <GridColumn Field="@nameof(ForecastEntryDto.CategoryCode)" HeaderText="Category" Width="120"></GridColumn>
            <GridColumn Field="@nameof(ForecastEntryDto.OpportunityName)" HeaderText="Opportunity" Width="200"></GridColumn>
            <GridColumn Field="@nameof(ForecastEntryDto.ForecastAmount)" HeaderText="Forecast Amount" Format="C2" Width="160"></GridColumn>
            <GridColumn Field="@nameof(ForecastEntryDto.PipelineAmount)" HeaderText="Pipeline Amount" Format="C2" Width="160"></GridColumn>
            <GridColumn Field="@nameof(ForecastEntryDto.WinProbability)" HeaderText="Win %" Format="N1" Width="100"></GridColumn>
            <GridColumn Field="@nameof(ForecastEntryDto.CloseDate)" HeaderText="Close Date" Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
            <GridColumn Field="@nameof(ForecastEntryDto.Notes)" HeaderText="Notes" Width="200"></GridColumn>
            <GridColumn Field="@nameof(ForecastEntryDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="g" Width="160"></GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<ForecastEntryDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchForecastEntriesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<ForecastEntryDto>();
    }
}
