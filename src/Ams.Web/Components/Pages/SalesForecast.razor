@page "/crm/forecast"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Pipeline Forecast — CRM</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Pipeline Forecast"
               Subtitle="Projected close amounts by period and category"
               Icon="bi-graph-up-arrow">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "pf-spin" : "")" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-ghost" @onclick="() => _showAdd = true">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Entry
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="pf-kpi-strip">
    <div class="pf-kpi-card">
        <span class="pf-ki pf-ki1"><i class="bi bi-trophy-fill" aria-hidden="true"></i></span>
        <div><div class="pf-kv">@_kpi.TotalEntries</div><div class="pf-kl">Total Entries</div></div>
    </div>
    <div class="pf-kpi-card">
        <span class="pf-ki pf-ki2"><i class="bi bi-cash-coin" aria-hidden="true"></i></span>
        <div><div class="pf-kv">@_kpi.Pipeline.ToString("C0")</div><div class="pf-kl">Pipeline</div></div>
    </div>
    <div class="pf-kpi-card">
        <span class="pf-ki pf-ki3"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
        <div><div class="pf-kv">@_kpi.Commit.ToString("C0")</div><div class="pf-kl">Commit</div></div>
    </div>
    <div class="pf-kpi-card">
        <span class="pf-ki pf-ki4"><i class="bi bi-stars" aria-hidden="true"></i></span>
        <div><div class="pf-kv">@_kpi.BestCase.ToString("C0")</div><div class="pf-kl">Best Case</div></div>
    </div>
    <div class="pf-kpi-card">
        <span class="pf-ki pf-ki5"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span>
        <div><div class="pf-kv">@_kpi.Weighted.ToString("C0")</div><div class="pf-kl">Weighted</div></div>
    </div>
</div>

<!-- Filter bar -->
<div class="pf-filter-bar">
    <div class="pf-search-wrap">
        <i class="bi bi-search pf-si" aria-hidden="true"></i>
        <input class="pf-search" type="search" placeholder="Search opportunity or period…"
               value="@_search"
               @oninput="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => { _search = e.Value?.ToString() ?? string.Empty; ApplyFilters(); })" />
    </div>
    <SfDropDownList TValue="string" TItem="LV" DataSource="_periodOpts" Placeholder="All Periods" ShowClearButton="true" Width="130px"
                    Value="_filterPeriod" ValueChanged="@((string v) => { _filterPeriod = v; ApplyFilters(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>
    <SfDropDownList TValue="string" TItem="LV" DataSource="_catOpts" Placeholder="All Categories" ShowClearButton="true" Width="150px"
                    Value="_filterCat" ValueChanged="@((string v) => { _filterCat = v; ApplyFilters(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>
</div>

<!-- Summary by period accordion -->
<SfAccordion>
    @foreach (var pg in _byPeriod)
    {
        <AccordionItem>
            <HeaderTemplate>
                <div class="pf-acc-hdr">
                    <span class="pf-acc-period">@pg.Period</span>
                    <span class="pf-acc-entries">@pg.Entries.Count entries</span>
                    <span class="pf-acc-pipeline pf-mono pf-bold">@pg.TotalForecast.ToString("C0") pipeline</span>
                    <span class="pf-acc-weighted pf-mono">@pg.TotalWeighted.ToString("C0") weighted</span>
                </div>
            </HeaderTemplate>
            <ContentTemplate>
                <div class="pf-acc-body">
                    <SfGrid TValue="ForecastRow" DataSource="pg.Entries"
                            AllowSorting="true" EnableHover="true" RowHeight="52">
                        <GridColumns>
                            <GridColumn Field="@nameof(ForecastRow.OpportunityName)" HeaderText="Opportunity" MinWidth="200" />
                            <GridColumn Field="@nameof(ForecastRow.Category)"        HeaderText="Category"    Width="130">
                                <Template>@{ var r = (ForecastRow)context; }<span class="@CatBadge(r.Category)">@r.Category</span></Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(ForecastRow.ForecastAmount)"  HeaderText="Forecast Amt" Width="150" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                <Template>@{ var r = (ForecastRow)context; }<span class="pf-mono pf-bold">@r.ForecastAmount.ToString("C0")</span></Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(ForecastRow.PipelineAmount)"  HeaderText="Pipeline Amt" Width="150" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                <Template>@{ var r = (ForecastRow)context; }<span class="pf-mono">@r.PipelineAmount.ToString("C0")</span></Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(ForecastRow.WinProbability)"  HeaderText="Win %"        Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                <Template>
                                    @{ var r = (ForecastRow)context; }
                                    <div class="pf-win-wrap">
                                        <div class="pf-win-bar" style="width:@r.WinProbability%;background:@WinColor((int)r.WinProbability)"></div>
                                        <span class="pf-win-num">@r.WinProbability.ToString("F0")%</span>
                                    </div>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(ForecastRow.CloseDate)"       HeaderText="Close Date"   Width="120">
                                <Template>@{ var r = (ForecastRow)context; }<span class="pf-mono @(r.CloseDate.HasValue && r.CloseDate < DateTime.UtcNow ? "pf-overdue" : "")">@(r.CloseDate?.ToString("d") ?? "—")</span></Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(ForecastRow.Notes)"           HeaderText="Notes"        MinWidth="120" />
                        </GridColumns>
                    </SfGrid>
                </div>
            </ContentTemplate>
        </AccordionItem>
    }
</SfAccordion>

@if (_byPeriod.Count == 0 && !_loading)
{
    <div class="pf-empty">
        <i class="bi bi-bar-chart-steps pf-empty-icon" aria-hidden="true"></i>
        <div class="pf-empty-title">No forecast entries</div>
        <div class="pf-empty-sub">Add entries or check your filters.</div>
    </div>
}

<!-- Add Entry dialog -->
<SfDialog @bind-Visible="_showAdd" Width="520px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="pf-dlg-hdr"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Forecast Entry</span></Header>
        <Content>
            <div class="pf-dlg-body">
                <SfTextBox Placeholder="Opportunity name" @bind-Value="_newEntry.OpportunityName" />
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem">
                    <SfDropDownList TValue="string" TItem="LV" DataSource="_catOpts" Placeholder="Category…" Width="100%" @bind-Value="_newEntry.Category"><DropDownListFieldSettings Value="Value" Text="Label" /></SfDropDownList>
                    <SfTextBox Placeholder="Period (e.g. 2025-Q3)" @bind-Value="_newEntry.Period" />
                    <SfNumericTextBox TValue="decimal" Placeholder="Forecast amount" @bind-Value="_newEntry.ForecastAmount" Format="C0" />
                    <SfNumericTextBox TValue="decimal" Placeholder="Pipeline amount"  @bind-Value="_newEntry.PipelineAmount"  Format="C0" />
                    <SfNumericTextBox TValue="decimal" Placeholder="Win probability %" @bind-Value="_newEntry.WinProbability" Min="0" Max="100" Format="N0" />
                    <SfDatePicker TValue="DateTime?" Placeholder="Close date" @bind-Value="_newEntry.CloseDate" />
                </div>
                <SfTextBox Placeholder="Notes (optional)" @bind-Value="_newEntry.Notes" Multiline="true" HtmlAttributes="@(new Dictionary<string,object>{{"rows","2"}})" />
            </div>
        </Content>
        <FooterTemplate>
            <div class="pf-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showAdd = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitAddAsync" disabled="@(string.IsNullOrEmpty(_newEntry.OpportunityName)||string.IsNullOrEmpty(_newEntry.Period))"><i class="bi bi-check-lg" aria-hidden="true"></i> Save</button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;
    private bool     _loading = false;
    private string   _search       = string.Empty;
    private string   _filterPeriod = string.Empty;
    private string   _filterCat    = string.Empty;
    private bool     _showAdd      = false;
    private ForecastRow _newEntry   = new();

    private List<ForecastRow>    _allRows  = [];
    private List<PeriodGroup>    _byPeriod = [];
    private ForecastKpi          _kpi      = new();

    private static readonly List<LV> _periodOpts = [new("2025-Q1","2025-Q1"),new("2025-Q2","2025-Q2"),new("2025-Q3","2025-Q3"),new("2025-Q4","2025-Q4")];
    private static readonly List<LV> _catOpts    = [new("Pipeline","Pipeline"),new("Best Case","Best Case"),new("Commit","Commit"),new("Closed","Closed")];

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"),new("CRM","/crm/forecast"),new("Forecast","/crm/forecast"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        await Task.Delay(0); // TODO: Api.SearchForecastEntriesAsync(_tenantId, _search)
        _allRows = [];
        RebuildDerived();
        _loading = false;
    }

    private void RebuildDerived()
    {
        ApplyFilters();
        _kpi = new ForecastKpi
        {
            TotalEntries = _allRows.Count,
            Pipeline     = _allRows.Where(r => r.Category == "Pipeline").Sum(r => r.ForecastAmount),
            Commit       = _allRows.Where(r => r.Category == "Commit").Sum(r => r.ForecastAmount),
            BestCase     = _allRows.Where(r => r.Category == "Best Case").Sum(r => r.ForecastAmount),
            Weighted     = _allRows.Sum(r => r.ForecastAmount * r.WinProbability / 100),
        };
    }

    private void ApplyFilters()
    {
        var rows = _allRows.Where(r =>
            (string.IsNullOrEmpty(_filterPeriod) || r.Period == _filterPeriod) &&
            (string.IsNullOrEmpty(_filterCat)    || r.Category == _filterCat) &&
            (string.IsNullOrEmpty(_search) || (r.OpportunityName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) || r.Period.Contains(_search, StringComparison.OrdinalIgnoreCase))
        ).ToList();
        _byPeriod = rows.GroupBy(r => r.Period)
            .Select(g => new PeriodGroup
            {
                Period         = g.Key,
                Entries        = g.ToList(),
                TotalForecast  = g.Sum(r => r.ForecastAmount),
                TotalWeighted  = g.Sum(r => r.ForecastAmount * r.WinProbability / 100),
            }).OrderBy(p => p.Period).ToList();
    }

    private async Task CommitAddAsync()
    {
        _allRows.Add(new ForecastRow
        {
            OpportunityName = _newEntry.OpportunityName, Category = _newEntry.Category,
            Period = _newEntry.Period, ForecastAmount = _newEntry.ForecastAmount,
            PipelineAmount = _newEntry.PipelineAmount, WinProbability = _newEntry.WinProbability,
            CloseDate = _newEntry.CloseDate, Notes = _newEntry.Notes,
        });
        _newEntry = new(); _showAdd = false;
        RebuildDerived();
        await _toast!.ShowAsync(new ToastModel { Content = "Forecast entry added.", CssClass = "e-toast-success" });
    }

    private static string CatBadge(string c) => c switch
    {
        "Pipeline"  => "pf-cat pf-cat--pipeline",
        "Best Case" => "pf-cat pf-cat--best",
        "Commit"    => "pf-cat pf-cat--commit",
        "Closed"    => "pf-cat pf-cat--closed",
        _           => "pf-cat",
    };
    private static string WinColor(int p) => p >= 70 ? "#16a34a" : p >= 40 ? "#b45309" : "#dc2626";

    private sealed class ForecastRow
    {
        public string    OpportunityName  { get; set; } = string.Empty;
        public string    Category         { get; set; } = "Pipeline";
        public string    Period           { get; set; } = string.Empty;
        public decimal   ForecastAmount   { get; set; }
        public decimal   PipelineAmount   { get; set; }
        public decimal   WinProbability   { get; set; }
        public DateTime? CloseDate        { get; set; }
        public string?   Notes            { get; set; }
    }
    private sealed class PeriodGroup { public string Period { get; set; }=string.Empty; public List<ForecastRow> Entries { get; set; }=[]; public decimal TotalForecast { get; set; } public decimal TotalWeighted { get; set; } }
    private sealed class ForecastKpi { public int TotalEntries { get; set; } public decimal Pipeline { get; set; } public decimal Commit { get; set; } public decimal BestCase { get; set; } public decimal Weighted { get; set; } }
    private sealed record LV(string Value, string Label);
}

