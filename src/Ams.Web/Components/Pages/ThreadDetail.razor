@page "/communications/thread/{ThreadId}"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Communications
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@(_thread?.Subject ?? "Thread Detail") â€” AMS</PageTitle>

@if (_toastVisible)
{
    <div class="td-toast td-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <div><strong>@_toastTitle</strong><span>@_toastMessage</span></div>
        <button type="button" class="td-toast-close" @onclick="() => _toastVisible = false" aria-label="Close notification"><i class="bi bi-x-lg"></i></button>
    </div>
}

@if (_showAssignDlg)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseAssign">
        <div class="mt-modal td-action-modal" role="dialog" aria-modal="true" aria-labelledby="td-assign-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-person-check" aria-hidden="true"></i>
                <span id="td-assign-title">Assign Conversation</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseAssign"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_assignForm" OnValidSubmit="ConfirmAssign">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="td-modal-intro"><span><i class="bi bi-diagram-3" aria-hidden="true"></i> Queue ownership</span><p>Assign this conversation to a producer, CSR, or service owner and record the handoff in the thread audit trail.</p></div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full"><label>Assign To <span class="text-danger">*</span></label><InputSelect class="um-input" @bind-Value="_assignForm.AssignTo"><option value="">Select agent or CSR</option>@foreach (var agent in _agents) { <option value="@agent">@agent</option> }</InputSelect></div>
                        <div class="um-field um-field--full"><label>Note</label><InputTextArea class="um-input" rows="3" @bind-Value="_assignForm.Note" placeholder="Optional handoff noteâ€¦" /></div>
                    </div>
                </div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseAssign">Cancel</button><button type="submit" class="um-btn um-btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> Assign</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showEscalateDlg)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseEscalate">
        <div class="mt-modal td-action-modal" role="dialog" aria-modal="true" aria-labelledby="td-escalate-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-arrow-up-circle" aria-hidden="true"></i>
                <span id="td-escalate-title">Escalate Conversation</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseEscalate"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_escalateForm" OnValidSubmit="ConfirmEscalate">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="td-modal-intro td-modal-intro-danger"><span><i class="bi bi-shield-exclamation" aria-hidden="true"></i> Supervisor escalation</span><p>Escalation moves the thread into the Escalations queue, raises priority, and writes a system note.</p></div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full"><label>Escalate To <span class="text-danger">*</span></label><InputSelect class="um-input" @bind-Value="_escalateForm.EscalateTo"><option value="">Select supervisor</option>@foreach (var supervisor in _supervisors) { <option value="@supervisor">@supervisor</option> }</InputSelect></div>
                        <div class="um-field um-field--full"><label>Reason <span class="text-danger">*</span></label><InputSelect class="um-input" @bind-Value="_escalateForm.Reason"><option value="">Select reason</option>@foreach (var reason in _escalationReasons) { <option value="@reason">@reason</option> }</InputSelect></div>
                        <div class="um-field um-field--full"><label>Notes</label><InputTextArea class="um-input" rows="3" @bind-Value="_escalateForm.Note" placeholder="Escalation contextâ€¦" /></div>
                    </div>
                </div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseEscalate">Cancel</button><button type="submit" class="um-btn um-btn-danger"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i> Escalate</button></div>
            </EditForm>
        </div>
    </div>
}

<section class="td-enterprise-page">
    <div class="td-hero">
        <div class="td-hero-left">
            <div class="td-hero-icon"><i class="bi bi-chat-left-text" aria-hidden="true"></i></div>
            <div>
                <div class="td-eyebrow">Tenant Communications Â· Thread Command View</div>
                <div class="td-title-row"><h1>@(_thread?.Subject ?? "Thread Detail")</h1>@if (_thread is not null) { <span class="td-status-pill td-status-@StatusCss(_thread.Status)">@_thread.Status</span> }</div>
                <p>@(_thread is null ? "Load a synced communications thread and manage all follow-up actions." : $"{_thread.AccountName} Â· {_thread.Channel} Â· {FormatTime(_thread.LastActivityAt)}")</p>
                @if (_thread is not null)
                {
                    <div class="td-hero-chips">
                        <span><i class="bi bi-diagram-3" aria-hidden="true"></i> @_thread.QueueName</span>
                        <span><i class="bi bi-stopwatch" aria-hidden="true"></i> @_thread.SlaStatus Â· @FormatSla(_thread)</span>
                        <span><i class="bi bi-shield-check" aria-hidden="true"></i> @_thread.ComplianceStatus</span>
                        <span><i class="bi bi-arrow-repeat" aria-hidden="true"></i> @_thread.SourceSystem Â· @FormatTime(_thread.LastSyncedDateUtc)</span>
                    </div>
                }
            </div>
        </div>
        <div class="td-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/inbox")'><i class="bi bi-arrow-left" aria-hidden="true"></i> Inbox</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
            @if (_thread is not null)
            {
                <button type="button" class="um-btn um-btn-ghost" @onclick="OpenAssign"><i class="bi bi-person-check" aria-hidden="true"></i> Assign</button>
                <button type="button" class="um-btn um-btn-ghost" @onclick="OpenEscalate"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i> Escalate</button>
                @if (!_thread.IsRead) { <button type="button" class="um-btn um-btn-ghost" @onclick="() => MarkRead()"><i class="bi bi-check2-all" aria-hidden="true"></i> Mark Read</button> }
                <button type="button" class="um-btn um-btn-primary" @onclick="ResolveConversation" disabled="@(_thread.Status == "Resolved")"><i class="bi bi-check-circle" aria-hidden="true"></i> Resolve</button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger td-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div>
    }

    @if (_loading)
    {
        <div class="td-loading"><i class="bi bi-arrow-repeat td-spin" aria-hidden="true"></i> Loading synced thread...</div>
    }
    else if (_thread is null)
    {
        <div class="td-not-found"><i class="bi bi-chat-square-x td-nf-icon" aria-hidden="true"></i><h3>Thread not found</h3><p>Thread ID <code>@ThreadId</code> could not be located. It may have been resolved, archived, or unavailable for this tenant.</p><button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/communications/inbox")'><i class="bi bi-arrow-left" aria-hidden="true"></i> Return to Inbox</button></div>
    }
    else
    {
        <div class="td-kpi-strip">
            @KpiCard("bi-chat-dots", "Messages", _thread.MessageCount.ToString(), "td-kpi-blue")
            @KpiCard("bi-stopwatch", "SLA", _thread.SlaStatus, "td-kpi-green")
            @KpiCard("bi-person-check", "Owner", string.IsNullOrWhiteSpace(_thread.AssignedTo) ? "Unassigned" : _thread.AssignedTo, "td-kpi-purple")
            @KpiCard("bi-shield-check", "Compliance", _thread.ComplianceStatus, "td-kpi-cyan")
            @KpiCard("bi-emoji-smile", "Sentiment", _thread.Sentiment, "td-kpi-amber")
        </div>

        <div class="td-layout">
            <aside class="td-meta-panel">
                <div class="td-card"><div class="td-card-hdr"><i class="bi bi-building" aria-hidden="true"></i> Account</div><div class="td-card-body"><div class="td-meta-val td-meta-bold">@_thread.AccountName</div><div class="td-meta-val"><i class="bi bi-person" aria-hidden="true"></i> @_thread.ContactName</div><div class="td-meta-val"><i class="bi bi-envelope" aria-hidden="true"></i> @_thread.ContactEmail</div><div class="td-meta-val"><i class="bi bi-phone" aria-hidden="true"></i> @_thread.ContactPhone</div>@if (_thread.OptedOut) { <div class="td-optout-row"><i class="bi bi-slash-circle" aria-hidden="true"></i>Opted Out â€” Do Not Contact Directly</div> }</div></div>
                <div class="td-card"><div class="td-card-hdr"><i class="bi bi-info-circle" aria-hidden="true"></i> Thread Info</div><div class="td-card-body">@MetaRow("Channel", _thread.Channel)@MetaRow("Priority", _thread.Priority)@MetaRow("Queue", _thread.QueueName)@MetaRow("SLA", $"{_thread.SlaStatus} Â· {FormatSla(_thread)}")@MetaRow("Last Activity", FormatTime(_thread.LastActivityAt))@if (_thread.IsEscalated) { <div class="td-escalated-row"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i> Escalated</div> }</div></div>
                <div class="td-card"><div class="td-card-hdr"><i class="bi bi-people" aria-hidden="true"></i> Ownership</div><div class="td-card-body">@MetaRow("Assigned", string.IsNullOrWhiteSpace(_thread.AssignedTo) ? "Unassigned" : _thread.AssignedTo)@MetaRow("CSR", string.IsNullOrWhiteSpace(_thread.CsrOwner) ? "â€”" : _thread.CsrOwner)@MetaRow("Producer", string.IsNullOrWhiteSpace(_thread.Producer) ? "â€”" : _thread.Producer)@MetaRow("Branch", string.IsNullOrWhiteSpace(_thread.Branch) ? "â€”" : _thread.Branch)</div></div>
                @if (!string.IsNullOrWhiteSpace(_thread.AiSummary)) { <div class="td-card td-ai-card"><div class="td-card-hdr"><i class="bi bi-stars" aria-hidden="true"></i> AI Summary <span class="td-ai-badge">Auto</span></div><div class="td-card-body"><p class="td-ai-body">@_thread.AiSummary</p></div></div> }
                <div class="td-card"><div class="td-card-hdr"><i class="bi bi-shield-check" aria-hidden="true"></i> Compliance & Sync</div><div class="td-card-body">@MetaRow("Status", _thread.ComplianceStatus)@MetaRow("Source", _thread.SourceSystem)@MetaRow("Last Sync", FormatTime(_thread.LastSyncedDateUtc))@MetaRow("Consent", _thread.OptedOut ? "Opted Out" : "On File")</div></div>
                <div class="td-card"><div class="td-card-hdr"><i class="bi bi-link-45deg" aria-hidden="true"></i> Related Actions</div><div class="td-card-body td-links"><button class="um-btn um-btn-ghost um-btn-xs td-link-btn" @onclick="OpenAccount"><i class="bi bi-building" aria-hidden="true"></i> Account Profile</button><button class="um-btn um-btn-ghost um-btn-xs td-link-btn" @onclick="OpenPolicies"><i class="bi bi-shield-check" aria-hidden="true"></i> Policy Reports</button><button class="um-btn um-btn-ghost um-btn-xs td-link-btn" @onclick="OpenClaims"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Claims Reports</button><button class="um-btn um-btn-ghost um-btn-xs td-link-btn" @onclick="ScheduleAppointment"><i class="bi bi-calendar-event" aria-hidden="true"></i> Schedule Appointment</button></div></div>
            </aside>

            <div class="td-thread-pane">
                @if (_thread.OptedOut) { <div class="td-optout-warning"><i class="bi bi-slash-circle" aria-hidden="true"></i><strong>Opt-Out / Do Not Contact</strong> â€” This contact has opted out of direct @_thread.Channel communication. Route direct outreach through approved representatives.</div> }
                <div class="td-thread-scroll">
                    @foreach (var msg in _thread.Thread.OrderBy(t => t.SentAt))
                    {
                        var isOut = msg.Direction == "Outbound";
                        <div class="td-bubble-wrap @(isOut ? "td-bubble-out" : "td-bubble-in")"><div class="td-bubble @(isOut ? "td-bubble-outbound" : "td-bubble-inbound") td-bbl-@ChannelCss(msg.Channel)"><div class="td-bubble-header"><span class="td-bubble-sender">@msg.SenderName</span><span class="td-bubble-ch"><i class="bi @ChannelIcon(msg.Channel)" aria-hidden="true"></i>@msg.Channel</span><span class="td-bubble-time">@msg.SentAt.ToString("MM/dd/yyyy h:mm tt")</span>@if (msg.IsAutomated) { <span class="td-auto-badge"><i class="bi bi-robot" aria-hidden="true"></i>Auto</span> }<span class="td-dir-badge @(isOut ? "td-dir-out" : "td-dir-in")">@msg.Direction</span></div><div class="td-bubble-body">@msg.Body</div>@if (msg.Attachments.Any()) { <div class="td-bubble-attachments">@foreach (var a in msg.Attachments) { <span class="td-attach-chip-sm"><i class="bi bi-paperclip" aria-hidden="true"></i>@a</span> }</div> }<div class="td-delivery-row"><span>@msg.DeliveryStatus</span><span>@(string.IsNullOrWhiteSpace(msg.ProviderName) ? "AMS" : msg.ProviderName)</span>@if (!string.IsNullOrWhiteSpace(msg.ExternalMessageId)) { <span>@msg.ExternalMessageId</span> }</div></div></div>
                    }
                </div>
                <div class="td-reply-box">
                    <div class="td-reply-toolbar"><div class="td-reply-ch-row">@foreach (var ch in _channels) { <button type="button" class="td-ch-pill @(_reply.Channel == ch ? "td-ch-active" : "")" @onclick="() => _reply.Channel = ch" disabled="@(_thread.OptedOut && ch != "Internal Note")"><i class="bi @ChannelIcon(ch)" aria-hidden="true"></i>@(ch == "Internal Note" ? "Note" : ch)</button> }</div><div class="td-reply-tools"><select class="td-input td-tpl-sel" @bind="_reply.Template" @bind:after="ApplyTemplate"><option value="">Use templateâ€¦</option>@foreach (var t in _templates) { <option>@t</option> }</select><button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="AddAttachment"><i class="bi bi-paperclip" aria-hidden="true"></i> Attach</button></div></div>
                    @if (_reply.Channel == "Email") { <input class="td-input td-reply-subject" @bind="_reply.Subject" placeholder="Subjectâ€¦" /> }
                    <textarea class="td-reply-textarea" rows="5" @bind="_reply.Body" @bind:event="oninput" placeholder="@ReplyPlaceholder"></textarea>
                    <div class="td-reply-footer"><div>@if (_reply.Channel == "SMS") { <span class="td-char-count @(_reply.Body.Length > 160 ? "td-char-warn" : "")">@_reply.Body.Length / 160 chars</span> } @if (_reply.Channel == "Internal Note") { <span class="td-internal-note-hint"><i class="bi bi-eye-slash" aria-hidden="true"></i> Internal only</span> }</div><div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="DiscardReply">Discard</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="SendReply" disabled="@(string.IsNullOrWhiteSpace(_reply.Body) || _actionBusy)"><i class="bi @(_reply.Channel == "Internal Note" ? "bi-sticky" : "bi-send")" aria-hidden="true"></i> @(_reply.Channel == "Internal Note" ? "Add Note" : "Send Reply")</button></div></div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    [Parameter] public string ThreadId { get; set; } = "";

    private bool _loading;
    private bool _actionBusy;
    private bool _toastVisible;
    private bool _showAssignDlg;
    private bool _showEscalateDlg;
    private string? _loadError;
    private string _toastTitle = string.Empty;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private ThreadView? _thread;
    private ReplyForm _reply = new();
    private AssignForm _assignForm = new();
    private EscalateForm _escalateForm = new();
    private const string _currentUser = "Sarah Kim";

    private readonly string[] _channels = ["Email", "SMS", "Internal Note", "Portal Message"];
    private readonly string[] _agents = ["Sarah Kim", "James Park", "Kevin Obi", "Maria Santos", "Lisa Chen"];
    private readonly string[] _supervisors = ["Diana Perez", "Robert Yamamoto"];
    private readonly string[] _escalationReasons = ["Complaint", "Coverage Dispute", "Legal Threat", "Regulatory Issue", "VIP Client", "Complex Situation", "Other"];
    private readonly string[] _templates = ["Policy Renewal Reminder", "Claim Acknowledgement", "Coverage Review Invitation", "Payment Due Reminder", "CAT Event Check-In", "Certificate Request Confirmation", "Welcome â€” New Client"];

    private string ReplyPlaceholder => _reply.Channel == "SMS" ? "Type a text messageâ€¦" : _reply.Channel == "Internal Note" ? "Internal note â€” not visible to clientâ€¦" : _reply.Channel == "Portal Message" ? "Portal messageâ€¦" : "Write your replyâ€¦";

    protected override async Task OnParametersSetAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Communications", "/communications/inbox"), new("Inbox", "/communications/inbox"), new("Thread", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            if (!Guid.TryParse(ThreadId, out var id))
            {
                _thread = null;
                _loadError = $"Invalid thread id: {ThreadId}";
                return;
            }

            var dto = await Api.GetMessageThreadByIdAsync(id);
            _thread = dto is null ? null : MapThread(dto);
            if (_thread is not null && !_thread.IsRead) await MarkRead(showToast: false);
        }
        catch (Exception ex)
        {
            _thread = null;
            _loadError = $"Unable to load thread: {ex.Message}";
            ShowToast("Load failed", $"Unable to load thread: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private static ThreadView MapThread(MessageThreadDto d) => new()
    {
        Id = d.ThreadId,
        AccountName = d.AccountName,
        ContactName = d.ContactName,
        ContactEmail = d.ContactEmail ?? string.Empty,
        ContactPhone = d.ContactPhone ?? string.Empty,
        Channel = d.Channel,
        Subject = d.Subject,
        Status = d.Status,
        Priority = d.Priority,
        Sentiment = d.Sentiment,
        AssignedTo = d.AssignedTo ?? string.Empty,
        CsrOwner = d.CsrOwner ?? string.Empty,
        Producer = d.Producer ?? string.Empty,
        Branch = d.Branch ?? string.Empty,
        AiSummary = d.AiSummary ?? string.Empty,
        IsRead = d.IsRead,
        IsEscalated = d.IsEscalated,
        OptedOut = d.OptedOut,
        MessageCount = d.MessageCount,
        LastActivityAt = d.LastActivityAt,
        QueueName = d.QueueName,
        SlaStatus = d.SlaStatus,
        SlaMinutesRemaining = d.SlaMinutesRemaining,
        DueDateUtc = d.DueDateUtc,
        ComplianceStatus = d.ComplianceStatus,
        SourceSystem = d.SourceSystem,
        LastSyncedDateUtc = d.LastSyncedDateUtc == default ? d.LastActivityAt : d.LastSyncedDateUtc,
        Thread = d.Messages.Select(m => new ThreadMessageView
        {
            SenderName = m.SenderName,
            Channel = m.Channel,
            Direction = m.Direction,
            Body = m.Body,
            SentAt = m.SentAt,
            DeliveryStatus = m.DeliveryStatus,
            IsAutomated = m.IsAutomated,
            ExternalMessageId = m.ExternalMessageId,
            ProviderName = m.ProviderName,
            DeliveredAtUtc = m.DeliveredAtUtc,
            ReadAtUtc = m.ReadAtUtc,
            Attachments = m.Attachments.ToList()
        }).ToList()
    };

    private async Task SendReply()
    {
        if (_thread is null || string.IsNullOrWhiteSpace(_reply.Body)) return;
        await ExecuteActionAsync("Reply sent", async () =>
        {
            await Api.ReplyMessageAsync(_thread.Id, new ReplyMessageRequest(_thread.Id, _currentUser, _reply.Channel, _reply.Body, null, null, null));
            _reply = new ReplyForm { Channel = _thread.Channel };
            await ReloadSelectedAsync();
        });
    }

    private async Task ConfirmAssign()
    {
        if (_thread is null || string.IsNullOrWhiteSpace(_assignForm.AssignTo)) return;
        var assignedTo = _assignForm.AssignTo;
        await ExecuteActionAsync("Conversation assigned", async () =>
        {
            await Api.AssignThreadAsync(_thread.Id, new AssignThreadRequest(_thread.Id, _assignForm.AssignTo, _assignForm.Note));
            _showAssignDlg = false;
            _assignForm = new();
            await ReloadSelectedAsync();
        }, $"Assigned to {assignedTo}.");
    }

    private async Task ConfirmEscalate()
    {
        if (_thread is null || string.IsNullOrWhiteSpace(_escalateForm.EscalateTo) || string.IsNullOrWhiteSpace(_escalateForm.Reason)) return;
        var escalatedTo = _escalateForm.EscalateTo;
        await ExecuteActionAsync("Conversation escalated", async () =>
        {
            await Api.EscalateThreadAsync(_thread.Id, new EscalateThreadRequest(_thread.Id, _escalateForm.EscalateTo, _escalateForm.Reason, _escalateForm.Note));
            _showEscalateDlg = false;
            _escalateForm = new();
            await ReloadSelectedAsync();
        }, $"Escalated to {escalatedTo}.", "warning");
    }

    private async Task ResolveConversation()
    {
        if (_thread is null) return;
        await ExecuteActionAsync("Conversation resolved", async () =>
        {
            await Api.ResolveThreadAsync(_thread.Id);
            await ReloadSelectedAsync();
        });
    }

    private async Task MarkRead(bool showToast = true)
    {
        if (_thread is null) return;
        await Api.MarkThreadReadAsync(_thread.Id);
        _thread.IsRead = true;
        if (showToast) ShowToast("Marked read", "Conversation marked as read.", "info");
    }

    private async Task ReloadSelectedAsync()
    {
        if (_thread is null) return;
        var dto = await Api.GetMessageThreadByIdAsync(_thread.Id);
        _thread = dto is null ? null : MapThread(dto);
    }

    private async Task ExecuteActionAsync(string title, Func<Task> action, string? message = null, string kind = "success")
    {
        _actionBusy = true;
        try
        {
            await action();
            ShowToast(title, message ?? title, kind);
        }
        catch (Exception ex)
        {
            ShowToast("Action failed", $"Action failed: {ex.Message}", "danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private void OpenAssign()
    {
        _assignForm = new AssignForm { AssignTo = _thread?.AssignedTo ?? string.Empty };
        _showAssignDlg = true;
    }

    private void OpenEscalate()
    {
        _escalateForm = new EscalateForm();
        _showEscalateDlg = true;
    }

    private void CloseAssign() => _showAssignDlg = false;
    private void CloseEscalate() => _showEscalateDlg = false;
    private void DiscardReply() => _reply = new ReplyForm { Channel = _thread?.Channel ?? "Email" };
    private void AddAttachment() => ShowToast("Attachment", "Attachment picker is ready for provider integration.", "info");
    private void OpenAccount() => Nav.NavigateTo("/accounts");
    private void OpenPolicies() => Nav.NavigateTo("/analytics/policies");
    private void OpenClaims() => Nav.NavigateTo("/analytics/claims");
    private void ScheduleAppointment() => Nav.NavigateTo("/communications/appointments");

    private void ApplyTemplate()
    {
        if (string.IsNullOrEmpty(_reply.Template)) return;
        _reply.Body = _reply.Template switch
        {
            "Claim Acknowledgement" => "Dear [Client Name],\n\nWe have received your claim and assigned it to our claims team. A handler will be in touch within 1 business day.\n\nBest regards,\nAMS Insurance",
            "Policy Renewal Reminder" => "Dear [Client Name],\n\nYour policy is approaching renewal. Please review the renewal proposal and contact us with any questions.\n\nBest regards,\nAMS Insurance",
            "Coverage Review Invitation" => "Dear [Client Name],\n\nWe recommend a coverage review to ensure your protection still aligns with your exposures.\n\nBest regards,\nAMS Insurance",
            _ => _reply.Body
        };
    }

    private void ShowToast(string title, string message, string kind = "success")
    {
        _toastTitle = title;
        _toastMessage = message;
        _toastKind = kind;
        _toastVisible = true;
    }

    private RenderFragment KpiCard(string icon, string label, string value, string css) => @<article class="td-kpi-card @css"><span><i class="bi @icon" aria-hidden="true"></i>@label</span><strong>@value</strong></article>;
    private RenderFragment MetaRow(string label, string value) => @<div class="td-meta-row"><span class="td-lbl">@label</span><span>@(string.IsNullOrWhiteSpace(value) ? "â€”" : value)</span></div>;

    private static int GetUnansweredHours(ThreadView t)
    {
        var lastIn = t.Thread.Where(m => m.Direction == "Inbound").MaxBy(m => m.SentAt);
        if (lastIn is null) return 0;
        return t.Thread.Any(m => m.Direction == "Outbound" && m.SentAt > lastIn.SentAt) ? 0 : (int)(DateTime.Now - lastIn.SentAt).TotalHours;
    }

    private static string FormatSla(ThreadView t) => t.SlaStatus == "Completed" ? "done" : t.SlaMinutesRemaining < 0 ? $"{Math.Abs(t.SlaMinutesRemaining)}m overdue" : t.SlaMinutesRemaining >= 60 ? $"{t.SlaMinutesRemaining / 60}h left" : $"{t.SlaMinutesRemaining}m left";
    private static string SentimentIcon(string s) => s switch { "Positive" => "ðŸ‘", "Negative" => "ðŸ‘Ž", "Urgent" => "âš ï¸", _ => "ðŸŸ¡" };
    private static string ChannelIcon(string ch) => ch switch { "Email" => "bi-envelope", "SMS" => "bi-phone", "Internal Note" => "bi-sticky", "Portal Message" => "bi-globe", _ => "bi-chat-dots" };
    private static string ChannelCss(string ch) => ch switch { "Email" => "email", "SMS" => "sms", "Internal Note" => "note", "Portal Message" => "portal", _ => "gen" };
    private static string StatusCss(string s) => s.ToLower().Replace(" ", "-");
    private static string FormatTime(DateTime dt)
    {
        var d = DateTime.Now - dt;
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalHours < 24) return $"{(int)d.TotalHours}h ago";
        if (d.TotalDays < 7) return $"{(int)d.TotalDays}d ago";
        return dt.ToString("MM/dd/yyyy");
    }

