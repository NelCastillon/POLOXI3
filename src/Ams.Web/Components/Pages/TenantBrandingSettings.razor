        [Url, StringLength(500)] public string? LogoUrl { get; set; }
        [Url, StringLength(500)] public string? FaviconUrl { get; set; }
        [Required, StringLength(7), RegularExpression("^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$", ErrorMessage = "Use a valid hex color.")] public string? PrimaryColor { get; set; } = DefaultPrimaryColor;
        [Required, StringLength(7), RegularExpression("^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$", ErrorMessage = "Use a valid hex color.")] public string? SecondaryColor { get; set; } = DefaultSecondaryColor;
        [Required, StringLength(7), RegularExpression("^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$", ErrorMessage = "Use a valid hex color.")] public string? AccentColor { get; set; } = DefaultAccentColor;
        [StringLength(255)] public string? CustomDomain { get; set; }
        [Url, StringLength(500)] public string? CustomCssUrl { get; set; }
        [EmailAddress, StringLength(254)] public string? SupportEmail { get; set; }
        [StringLength(50)] public string? SupportPhone { get; set; }
        [StringLength(500)] public string? FooterText { get; set; }

        public UpdateTenantBrandingRequest ToRequest() => new()
        {
            WhiteLabelName = WhiteLabelName,
            LogoUrl = LogoUrl,
            FaviconUrl = FaviconUrl,
            PrimaryColor = PrimaryColor,
            SecondaryColor = SecondaryColor,
            AccentColor = AccentColor,
            CustomDomain = CustomDomain,
            CustomCssUrl = CustomCssUrl,
            SupportEmail = SupportEmail,
            SupportPhone = SupportPhone,
            FooterText = FooterText
        };

        public static BrandingForm Defaults() => new()
        {
            PrimaryColor = DefaultPrimaryColor,
            SecondaryColor = DefaultSecondaryColor,
            AccentColor = DefaultAccentColor
        };

        public static BrandingForm FromDto(TenantBrandingDto? dto) => new()
        {
            WhiteLabelName = CleanValue(dto?.WhiteLabelName),
            LogoUrl = CleanValue(dto?.LogoUrl),
            FaviconUrl = CleanValue(dto?.FaviconUrl),
            PrimaryColor = NormalizeColor(dto?.PrimaryColor, DefaultPrimaryColor),
            SecondaryColor = NormalizeColor(dto?.SecondaryColor, DefaultSecondaryColor),
            AccentColor = NormalizeColor(dto?.AccentColor, DefaultAccentColor),
            CustomDomain = CleanValue(dto?.CustomDomain),
            CustomCssUrl = CleanValue(dto?.CustomCssUrl),
            SupportEmail = CleanValue(dto?.SupportEmail),
            SupportPhone = CleanValue(dto?.SupportPhone),
            FooterText = CleanValue(dto?.FooterText)
        };
    }
