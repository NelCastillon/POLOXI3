@page "/tenant/settings/branding"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>Tenant Branding — AMS</PageTitle>

<AppPageHeader Title="Tenant Branding"
               Subtitle="Manage tenant logo, colors, login experience, portal identity, and outbound brand presentation"
               Icon="bi-palette">
    <Actions>
        <button class="um-btn um-btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> Save Branding</button>
    </Actions>
</AppPageHeader>

<section class="tset-hero" aria-label="Tenant branding overview">
    <div>
        <span class="tset-eyebrow">Tenant administration</span>
        <h2>Tenant Brand Identity</h2>
        <p>Govern brand assets, accessibility, portal theme, outbound email presentation, and support contact identity.</p>
    </div>
</section>

<section class="tset-kpi-grid" aria-label="Tenant branding metrics">
    @Kpi("Completion", "96%", "Brand profile health", "bi-palette", "tset-tone-violet")
    @Kpi("Assets", "9", "Approved brand assets", "bi-images", "tset-tone-blue")
    @Kpi("Contrast", "AA", "Accessibility target", "bi-universal-access", "tset-tone-green")
    @Kpi("Review", "5 days", "Pending approval", "bi-clock", "tset-tone-amber")
</section>

<TenantSettingsWorkflowManager PageCode="branding"
                               Label="Tenant branding workflow"
                               DefaultStage="Brand"
                               DefaultCategory="Brand Approval" />

<section class="tset-admin-panel">
    <h3>Brand governance</h3>
    <div class="tset-policy-card">
        <strong>Brand approval controls</strong>
        <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Logo, color, and email brand changes require review</span>
        <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Portal and login theme checked for contrast compliance</span>
        <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Support and sender identity aligned with tenant brand</span>
    </div>
</section>

@code {
    protected override void OnInitialized() => Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tenant Branding", "/tenant/settings/branding"));

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="tset-kpi-card"><span class="tset-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span><div><strong>@value</strong><span>@label</span><small>@meta</small></div></article>;
}
