@page "/tenant/settings/branding"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Common.Models
@using Ams.Application.Features.Tenants
@using Ams.Application.Features.TenantSettings
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject IJSRuntime Js

<PageTitle>Tenant Branding - AMS</PageTitle>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="ab-toast @_toastClass" role="status">
        <i class="bi @(_toastClass == "ab-toast--danger" ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="ab-toast-close" @onclick="ClearToast" aria-label="Dismiss message"><i class="bi bi-x-lg"></i></button>
    </div>
}

<div class="ab-page">
    <section class="ab-page-header" aria-label="Tenant branding page header">
        <div class="ab-page-header__icon"><i class="bi bi-palette" aria-hidden="true"></i></div>
        <div class="ab-page-header__copy">
            <span class="ab-page-header__kicker">Tenant settings</span>
            <h1>Tenant Branding</h1>
            <p>Enterprise brand system, portal identity, support channels, and tenant-facing experience governance.</p>
        </div>
        <div class="ab-page-header__actions">
            <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
            </button>
            <button class="um-btn um-btn-ghost" type="button" @onclick="SyncBrandingAsync" disabled="@_saving">
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Sync
            </button>
            <a class="um-btn um-btn-ghost" href="/tenant/portal"><i class="bi bi-window-sidebar" aria-hidden="true"></i> Portal Preview</a>
            <button class="um-btn um-btn-primary" type="button" @onclick="OpenEditModal"><i class="bi bi-pencil-square" aria-hidden="true"></i> Edit Branding</button>
        </div>
    </section>

    <section class="ab-hero" style="@HeroStyle">
        <div class="ab-hero-main">
            <span class="ab-eyebrow"><i class="bi bi-stars" aria-hidden="true"></i> Tenant Brand Experience</span>
            <h2>@DisplayBrandName</h2>
            <p>Control the client-facing brand system used by portals, documents, communications, support workflows, and tenant identity touchpoints.</p>
            <div class="ab-hero-meta">
                <span><i class="bi bi-patch-check" aria-hidden="true"></i> @BrandStatus</span>
                <span><i class="bi bi-globe2" aria-hidden="true"></i> @DisplayValue(_branding?.CustomDomain, "Default tenant domain")</span>
                <span><i class="bi bi-headset" aria-hidden="true"></i> @SupportSummary</span>
            </div>
        </div>
        <div class="ab-hero-panel">
            <div class="ab-readiness-card">
                <span>Brand readiness</span>
                <strong>@BrandReadinessScore%</strong>
                <div class="ab-score-track"><div style="width:@BrandReadinessScore%"></div></div>
                <small>@BrandReadinessSummary</small>
            </div>
            <div class="ab-action-list">
                @foreach (var action in PriorityActions)
                {
                    <button type="button" class="ab-action-item" @onclick="() => SetTab(action.Tab)">
                        <i class="bi @action.Icon" aria-hidden="true"></i>
                        <span><strong>@action.Title</strong><small>@action.Detail</small></span>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="ab-kpi-strip" aria-label="Tenant branding KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="ab-kpi-card @(IsActiveTab(kpi.Key) ? "ab-kpi-card--active" : null)" title="@kpi.Tooltip" @onclick="() => SetTab(kpi.Key)">
                <span class="ab-kpi-icon ab-kpi-icon--@kpi.Tone"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="ab-kpi-label">@kpi.Label</span>
                <strong>@kpi.Value</strong>
                <small>@kpi.Detail</small>
            </button>
        }
    </section>

    <section class="ab-command-bar">
        <div class="ab-tabs" role="tablist" aria-label="Tenant branding sections">
            @foreach (var tab in Tabs)
            {
                <button type="button" role="tab" class="ab-tab @(IsActiveTab(tab.Key) ? "ab-tab--active" : null)" @onclick="() => SetTab(tab.Key)">
                    <i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label
                </button>
            }
        </div>
        <div class="ab-command-actions">
            <button class="um-btn um-btn-ghost" type="button" @onclick="CopyBrandSummaryAsync" disabled="@(_branding is null)"><i class="bi bi-clipboard" aria-hidden="true"></i> Copy Summary</button>
            <button class="um-btn um-btn-ghost" type="button" @onclick="SyncBrandingAsync" disabled="@_saving"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Sync Related</button>
            <button class="um-btn um-btn-ghost" type="button" @onclick="OpenResetModal"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset Defaults</button>
            <button class="um-btn um-btn-primary" type="button" @onclick="OpenEditModal"><i class="bi bi-pencil-square" aria-hidden="true"></i> Update</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger ab-load-error" style="border-left: 4px solid #dc3545; animation: ab-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError</div>
    }

    <section class="ab-content-grid">
        <div class="ab-main-panel">
            @if (_loading)
            {
                <div class="ab-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading tenant branding...</div>
            }
            else
            {
                @if (ShowTab("overview"))
                {
                    <section class="ab-section">
                        <div class="ab-section-header"><i class="bi bi-speedometer2" aria-hidden="true"></i><div><strong>Executive Overview</strong><span>Most important brand readiness signals for tenant experience.</span></div></div>
                        <div class="ab-overview-grid">
                            <div class="ab-identity-card">
                                <span class="ab-module-icon ab-module-icon--blue"><i class="bi bi-type" aria-hidden="true"></i></span>
                                <div><strong>@DisplayBrandName</strong><span>@BrandStatus</span></div>
                            </div>
                            <div class="ab-identity-card">
                                <span class="ab-module-icon ab-module-icon--green"><i class="bi bi-palette2" aria-hidden="true"></i></span>
                                <div><strong>@PaletteSummary</strong><span>@ContrastSummary</span></div>
                            </div>
                            <div class="ab-identity-card">
                                <span class="ab-module-icon ab-module-icon--purple"><i class="bi bi-life-preserver" aria-hidden="true"></i></span>
                                <div><strong>@SupportSummary</strong><span>@LastUpdatedSummary</span></div>
                            </div>
                        </div>
                    </section>
                }

                @if (ShowTab("workflow"))
                {
                    <section class="ab-section">
                        <div class="ab-section-header"><i class="bi bi-diagram-3" aria-hidden="true"></i><div><strong>Brand Workflow</strong><span>Review and approval items synced for tenant branding governance.</span></div></div>
                        @if (!_workflow.Any())
                        {
                            <div class="ab-empty-state">
                                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                <strong>No branding workflow items are open</strong>
                                <span>Use Sync Related to create the standard brand review workflow when governance data is missing.</span>
                            </div>
                        }
                        else
                        {
                            <div class="ab-workflow-list">
                                @foreach (var item in _workflow.OrderBy(w => w.SortOrder).ThenBy(w => w.DueDateUtc ?? DateTime.MaxValue))
                                {
                                    <article class="ab-workflow-item">
                                        <div>
                                            <span class="ab-workflow-stage">@item.Stage - @item.Status</span>
                                            <strong>@item.Title</strong>
                                            <small>@item.Description</small>
                                        </div>
                                        <span class="ab-workflow-priority ab-workflow-priority--@Slug(item.Priority)">@item.Priority</span>
                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => AdvanceWorkflowAsync(item)" disabled="@_saving">
                                            <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Advance
                                        </button>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                }

                @if (ShowTab("identity"))
                {
                    <section class="ab-section">
                        <div class="ab-section-header"><i class="bi bi-fingerprint" aria-hidden="true"></i><div><strong>Brand Identity</strong><span>White-label name, tenant domain, and active brand status.</span></div></div>
                        <div class="ab-fields">
                            @Field("White-label Name", _branding?.WhiteLabelName)
                            @Field("Custom Domain", _branding?.CustomDomain, true)
                            @Field("Status", BrandStatus)
                            @Field("Branding Id", _branding?.BrandingId.ToString(), true)
                            @Field("Tenant Id", _tenantId.ToString(), true)
                            @Field("Last Updated", LastUpdatedSummary)
                        </div>
                    </section>
                }

                @if (ShowTab("assets"))
                {
                    <section class="ab-section">
                        <div class="ab-section-header"><i class="bi bi-images" aria-hidden="true"></i><div><strong>Assets & Palette</strong><span>Logo, favicon, color tokens, and custom stylesheet references.</span></div></div>
                        <div class="ab-fields">
                            @if (AssetCount == 0)
                            {
                                @Field("Brand Assets", null, fallback: "No asset URLs configured")
                            }
                            else
                            {
                                @OptionalField("Logo URL", _branding?.LogoUrl, true)
                                @OptionalField("Favicon URL", _branding?.FaviconUrl, true)
                                @OptionalField("Custom CSS URL", _branding?.CustomCssUrl, true)
                            }
                            @ColorField("Primary Color", PrimaryColor)
                            @ColorField("Secondary Color", SecondaryColor)
                            @ColorField("Accent Color", AccentColor)
                        </div>
                    </section>
                }

                @if (ShowTab("support"))
                {
                    <section class="ab-section">
                        <div class="ab-section-header"><i class="bi bi-headset" aria-hidden="true"></i><div><strong>Support Experience</strong><span>Client-facing help channels and footer messaging.</span></div></div>
                        <div class="ab-fields">
                            @Field("Support Email", _branding?.SupportEmail, fallback: "Not configured")
                            @Field("Support Phone", _branding?.SupportPhone, true, "Not configured")
                            @Field("Footer Text", _branding?.FooterText, fallback: "Not configured")
                            @Field("Support Readiness", SupportSummary)
                        </div>
                    </section>
                }

                @if (ShowTab("governance"))
                {
                    <section class="ab-section">
                        <div class="ab-section-header"><i class="bi bi-shield-check" aria-hidden="true"></i><div><strong>Brand Governance</strong><span>Enterprise controls for accessibility, completeness, and workflow health.</span></div></div>
                        <div class="ab-governance-list">
                            @foreach (var item in Checklist)
                            {
                                <div class="ab-governance-item @(item.Done ? "ab-governance-item--done" : null)">
                                    <i class="bi @(item.Done ? "bi-check-circle-fill" : "bi-exclamation-circle")" aria-hidden="true"></i>
                                    <span><strong>@item.Label</strong><small>@item.Detail</small></span>
                                </div>
                            }
                        </div>
                    </section>
                }
            }
        </div>

        <aside class="ab-side-panel">
            <div class="ab-side-card ab-preview-card">
                <div class="ab-side-title"><i class="bi bi-window-sidebar" aria-hidden="true"></i><strong>Experience Preview</strong></div>
                <div class="ab-preview-shell">
                    <div class="ab-preview-topbar" style="background:@PrimaryColor"><span></span><span></span><span></span></div>
                    <div class="ab-preview-body">
                        <div class="ab-preview-logo">
                            @if (HasValue(_branding?.LogoUrl))
                            {
                                <img src="@_branding.LogoUrl" alt="@DisplayBrandName logo" />
                            }
                            else
                            {
                                <span style="background:@PrimaryColor">@BrandInitials</span>
                            }
                            <strong>@DisplayBrandName</strong>
                        </div>
                        <div class="ab-preview-copy">
                            <span>Client portal</span>
                            <strong>Your protected insurance workspace</strong>
                            <p>@DisplayValue(_branding?.FooterText, "Configure footer messaging to guide clients through the branded portal experience.")</p>
                        </div>
                        <button type="button" style="background:@AccentColor">Continue</button>
                    </div>
                </div>
            </div>

            <div class="ab-side-card">
                <div class="ab-side-title"><i class="bi bi-list-check" aria-hidden="true"></i><strong>Readiness Checklist</strong></div>
                @foreach (var item in Checklist)
                {
                    <div class="ab-check-item @(item.Done ? "ab-check-item--done" : null)">
                        <i class="bi @(item.Done ? "bi-check-circle-fill" : "bi-exclamation-circle")" aria-hidden="true"></i>
                        <span><strong>@item.Label</strong><small>@item.Detail</small></span>
                    </div>
                }
            </div>

            <div class="ab-side-card">
                <div class="ab-side-title"><i class="bi bi-lightning-charge" aria-hidden="true"></i><strong>Workflow Shortcuts</strong></div>
                <button type="button" class="ab-link-action" @onclick='() => SetTab("workflow")'><i class="bi bi-diagram-3" aria-hidden="true"></i> Brand Workflow (@_workflow.Count)</button>
                <a class="ab-link-action" href="/tenant/settings/preferences"><i class="bi bi-sliders" aria-hidden="true"></i> Preferences</a>
                <a class="ab-link-action" href="/tenant/portal-admin/branding"><i class="bi bi-window-dock" aria-hidden="true"></i> Portal Branding</a>
                <a class="ab-link-action" href="/tenant/communications/templates"><i class="bi bi-envelope-paper" aria-hidden="true"></i> Communication Templates</a>
                <a class="ab-link-action" href="/tenant/documents"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Document Library</a>
            </div>
        </aside>
    </section>
</div>

@if (_showEditModal)
{
    <div class="ab-modal-backdrop" role="presentation">
        <div class="ab-modal" role="dialog" aria-modal="true" aria-labelledby="agency-branding-edit-title">
            <EditForm EditContext="@_editContext" OnValidSubmit="SaveBrandingAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header">
                    <i class="bi bi-palette" aria-hidden="true"></i>
                    <span id="agency-branding-edit-title">Edit Tenant Branding</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseEditModal"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="um-modal-body">
                    <div class="ab-form-grid">
                        <div class="ab-form-section ab-form-section--full"><strong>Brand identity</strong><span>White-label and domain values used across tenant-facing experiences.</span></div>
                        <div class="um-field"><label>White-label Name</label><InputText class="um-input" @bind-Value="_form.WhiteLabelName" /></div>
                        <div class="um-field"><label>Custom Domain</label><InputText class="um-input ab-mono" @bind-Value="_form.CustomDomain" /></div>
                        <div class="um-field ab-form-section--full"><label>Logo URL</label><InputText class="um-input" @bind-Value="_form.LogoUrl" /></div>
                        <div class="um-field ab-form-section--full"><label>Favicon URL</label><InputText class="um-input" @bind-Value="_form.FaviconUrl" /></div>

                        <div class="ab-form-section ab-form-section--full"><strong>Enterprise palette</strong><span>Use high-contrast colors for accessible portals and branded workflows.</span></div>
                        <div class="um-field"><label>Primary Color <em>*</em></label><div class="ab-color-input"><InputText class="um-input ab-mono" @bind-Value="_form.PrimaryColor" /><input type="color" class="ab-color-picker" @bind="_form.PrimaryColor" /></div></div>
                        <div class="um-field"><label>Secondary Color <em>*</em></label><div class="ab-color-input"><InputText class="um-input ab-mono" @bind-Value="_form.SecondaryColor" /><input type="color" class="ab-color-picker" @bind="_form.SecondaryColor" /></div></div>
                        <div class="um-field"><label>Accent Color <em>*</em></label><div class="ab-color-input"><InputText class="um-input ab-mono" @bind-Value="_form.AccentColor" /><input type="color" class="ab-color-picker" @bind="_form.AccentColor" /></div></div>
                        <div class="um-field ab-form-section--full"><label>Custom CSS URL</label><InputText class="um-input" @bind-Value="_form.CustomCssUrl" /></div>

                        <div class="ab-form-section ab-form-section--full"><strong>Support and footer</strong><span>Client-facing help channels and trust messaging.</span></div>
                        <div class="um-field"><label>Support Email</label><InputText class="um-input" @bind-Value="_form.SupportEmail" /></div>
                        <div class="um-field"><label>Support Phone</label><InputText class="um-input ab-mono" @bind-Value="_form.SupportPhone" /></div>
                        <div class="um-field ab-form-section--full"><label>Footer Text</label><InputTextArea class="um-input ab-textarea" @bind-Value="_form.FooterText" /></div>

                        @if (!string.IsNullOrWhiteSpace(_formError))
                        {
                            <div class="alert alert-danger ab-load-error ab-form-section--full" style="border-left: 4px solid #dc3545; animation: ab-shake 0.3s ease;" role="alert">@_formError</div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseEditModal">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi bi-save" aria-hidden="true"></i> Save Branding</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showResetModal)
{
    <div class="ab-modal-backdrop" role="presentation">
        <div class="ab-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="agency-branding-reset-title">
            <div class="um-modal-header">
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                <span id="agency-branding-reset-title">Reset branding defaults?</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseResetModal"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-modal-body">
                <p class="ab-confirm-copy">This resets white-label values, assets, custom domain, custom CSS, support channels, footer text, and colors to enterprise defaults for this tenant.</p>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CloseResetModal">Cancel</button>
                <button type="button" class="um-btn um-btn-primary" disabled="@_saving" @onclick="ResetBrandingAsync"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset Defaults</button>
            </div>
        </div>
    </div>
}

<style>
@@keyframes ab-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }
</style>

@code {
    private const string DefaultPrimaryColor = "#0d6efd";
    private const string DefaultSecondaryColor = "#6c757d";
    private const string DefaultAccentColor = "#198754";
    private const string BrandingKind = "TenantBranding";
    private const string WorkflowPageCode = "branding";

    private static readonly TabItem[] Tabs =
    [
        new("overview", "Overview", "bi-speedometer2"),
        new("identity", "Identity", "bi-fingerprint"),
        new("assets", "Assets", "bi-images"),
        new("support", "Support", "bi-headset"),
        new("governance", "Governance", "bi-shield-check"),
        new("workflow", "Workflow", "bi-diagram-3")
    ];

    private Guid _tenantId;
    private Guid? _userId;
    private bool _loading;
    private bool _saving;
    private bool _showEditModal;
    private bool _showResetModal;
    private string _activeTab = "overview";
    private string? _loadError;
    private string? _formError;
    private string? _toastMessage;
    private string _toastClass = "ab-toast--success";
    private TenantBrandingDto? _branding;
    private readonly List<TenantConfigItemDto> _configItems = [];
    private readonly List<TenantSettingsWorkflowItemDto> _workflow = [];
    private BrandingForm _form = new();
    private EditContext _editContext = default!;

    private string DisplayBrandName => DisplayValue(_branding?.WhiteLabelName, "Brand not configured");
    private string PrimaryColor => NormalizeColor(_branding?.PrimaryColor, DefaultPrimaryColor);
    private string SecondaryColor => NormalizeColor(_branding?.SecondaryColor, DefaultSecondaryColor);
    private string AccentColor => NormalizeColor(_branding?.AccentColor, DefaultAccentColor);
    private string HeroStyle => $"--ab-primary:{PrimaryColor}; --ab-secondary:{SecondaryColor}; --ab-accent:{AccentColor};";
    private string BrandStatus => _branding is null ? "Not configured" : _branding.IsActive ? "Active brand system" : "Inactive brand system";
    private string SupportSummary => HasValue(_branding?.SupportEmail) && HasValue(_branding?.SupportPhone) ? "Email and phone configured" : HasValue(_branding?.SupportEmail) ? "Email support configured" : HasValue(_branding?.SupportPhone) ? "Phone support configured" : "Support channels missing";
    private string PaletteSummary => HasCustomPalette ? "Custom palette configured" : "Default palette active";
    private string ContrastSummary => AccessibleColorPairs >= 2 ? "Accessible color contrast" : AccessibleColorPairs == 1 ? "Review one color contrast" : "Review palette contrast";
    private string LastUpdatedSummary => _branding is null ? "No database record" : _branding.ModifiedDateUtc?.ToString("MMM d, yyyy h:mm tt") ?? _branding.CreatedDateUtc.ToString("MMM d, yyyy h:mm tt");
    private bool HasCustomPalette => !string.Equals(PrimaryColor, DefaultPrimaryColor, StringComparison.OrdinalIgnoreCase) || !string.Equals(SecondaryColor, DefaultSecondaryColor, StringComparison.OrdinalIgnoreCase) || !string.Equals(AccentColor, DefaultAccentColor, StringComparison.OrdinalIgnoreCase);
    private int AssetCount => new[] { _branding?.LogoUrl, _branding?.FaviconUrl, _branding?.CustomCssUrl }.Count(HasValue);
    private int AccessibleColorPairs => new[] { PrimaryColor, SecondaryColor, AccentColor }.Count(color => ContrastRatio(color, "#ffffff") >= 4.5 || ContrastRatio(color, "#0f172a") >= 4.5);
    private int BrandReadinessScore => Math.Clamp(Checklist.Count(c => c.Done) * 100 / Math.Max(1, Checklist.Count), 0, 100);
    private string BrandReadinessSummary => BrandReadinessScore >= 90 ? "Brand system is enterprise ready" : BrandReadinessScore >= 70 ? "Core brand is ready with some gaps" : "Complete critical brand identity, support, and asset details";
    private string BrandInitials => _branding is null ? "--" : string.Join(string.Empty, DisplayBrandName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => char.ToUpperInvariant(s[0])));

    private IReadOnlyList<ChecklistItem> Checklist =>
    [
        new("White-label identity", HasValue(_branding?.WhiteLabelName), "Client-facing brand name configured"),
        new("Logo asset", HasValue(_branding?.LogoUrl), "Primary logo URL configured"),
        new("Accessible palette", AccessibleColorPairs >= 2, "At least two brand colors meet contrast guidance"),
        new("Support channel", HasValue(_branding?.SupportEmail) || HasValue(_branding?.SupportPhone), "Email or phone support configured"),
        new("Domain governance", HasValue(_branding?.CustomDomain), "Custom domain configured for portal readiness"),
        new("Footer messaging", HasValue(_branding?.FooterText), "Trust and support messaging configured")
    ];

    private IEnumerable<KpiItem> Kpis =>
    [
        new("overview", "Readiness", "bi-speedometer2", $"{BrandReadinessScore}%", "brand score", "Show the enterprise readiness overview", BrandReadinessScore >= 80 ? "green" : "amber"),
        new("identity", "Domain", "bi-globe2", HasValue(_branding?.CustomDomain) ? "Custom" : "Default", "portal route", "Show brand identity and domain details", HasValue(_branding?.CustomDomain) ? "blue" : "amber"),
        new("assets", "Assets", "bi-images", AssetCount.ToString("N0"), "logo, favicon, css", "Show brand assets and palette details", AssetCount >= 2 ? "green" : "purple"),
        new("support", "Support", "bi-headset", SupportSummary.StartsWith("Support", StringComparison.OrdinalIgnoreCase) ? "Missing" : "Ready", "client help", "Show support channel details", SupportSummary.StartsWith("Support", StringComparison.OrdinalIgnoreCase) ? "red" : "green"),
        new("governance", "Contrast", "bi-universal-access", $"{AccessibleColorPairs}/3", "AA checks", "Show brand governance checks", AccessibleColorPairs >= 2 ? "blue" : "red"),
        new("workflow", "Workflow", "bi-diagram-3", _workflow.Count(w => !IsWorkflowComplete(w)).ToString("N0"), "open items", "Show branding workflow governance", _workflow.Any(w => IsHighRisk(w)) ? "red" : "purple")
    ];

    private IEnumerable<PriorityAction> PriorityActions => Checklist.Where(c => !c.Done).Take(3).Select(c => new PriorityAction(c.Label, c.Detail, ActionIcon(c.Label), ActionTab(c.Label))).DefaultIfEmpty(new("Review brand", "All critical branding checks are complete", "bi-check2-circle", "overview"));

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _userId = context.UserId;
        _editContext = new(_form);
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tenant Settings", "/tenant/settings"), new("Tenant Branding", "/tenant/settings/branding"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var branding = await Api.GetTenantBrandingAsync(_tenantId);
            _branding = SanitizeBranding(branding);
            var configResult = await Api.SearchTenantConfigItemsAsync(_tenantId, BrandingKind, pageSize: 100);
            _configItems.Clear();
            _configItems.AddRange(configResult?.Items ?? []);
            _workflow.Clear();
            _workflow.AddRange(await Api.GetTenantSettingsWorkflowAsync(_tenantId, WorkflowPageCode) ?? []);
        }
        catch (Exception ex)
        {
            _loadError = $"Load failed: {ex.Message}";
            ShowToast(_loadError, true);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenEditModal()
    {
        _form = BrandingForm.FromDto(_branding);
        _editContext = new(_form);
        _formError = null;
        _showEditModal = true;
    }

    private void CloseEditModal()
    {
        _showEditModal = false;
        _formError = null;
    }

    private void OpenResetModal() => _showResetModal = true;
    private void CloseResetModal() => _showResetModal = false;

    private async Task SaveBrandingAsync()
    {
        _saving = true;
        _formError = null;
        try
        {
            await Api.UpdateTenantBrandingAsync(_tenantId, _form.ToRequest());
            await SaveRelatedConfigurationAsync(_form);
            _showEditModal = false;
            ShowToast("Tenant branding saved and synced.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
            ShowToast($"Save failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResetBrandingAsync()
    {
        _saving = true;
        try
        {
            await Api.UpdateTenantBrandingAsync(_tenantId, BrandingForm.Defaults().ToRequest());
            await SaveRelatedConfigurationAsync(BrandingForm.Defaults());
            _showResetModal = false;
            ShowToast("Tenant branding reset to defaults.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Reset failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SyncBrandingAsync()
    {
        _saving = true;
        try
        {
            await SaveRelatedConfigurationAsync(BrandingForm.FromDto(_branding));
            if (!_workflow.Any())
            {
                await Api.CreateTenantSettingsWorkflowAsync(new CreateTenantSettingsWorkflowItemRequest
                {
                    TenantId = _tenantId,
                    PageCode = WorkflowPageCode,
                    Title = "Review tenant brand identity",
                    Description = "Validate logo, palette, support contacts, custom domain, and portal-facing white-label presentation.",
                    Category = "Brand Approval",
                    Stage = "Brand",
                    Status = "In Review",
                    Priority = BrandReadinessScore >= 80 ? "Medium" : "High",
                    OwnerName = "Tenant Administrator",
                    DueDateUtc = DateTime.UtcNow.AddDays(5),
                    RiskCode = BrandReadinessScore >= 80 ? "Standard" : "BrandGovernance",
                    ControlCode = "BRAND-SYNC",
                    SortOrder = 10,
                    CreatedByUserId = _userId
                });
            }

            ShowToast("Tenant branding synced into configuration and workflow.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Sync failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AdvanceWorkflowAsync(TenantSettingsWorkflowItemDto item)
    {
        _saving = true;
        try
        {
            var nextStage = item.Stage switch
            {
                "Brand" => "Review",
                "Review" => "Approved",
                _ => "Approved"
            };
            var nextStatus = nextStage == "Approved" ? "Complete" : "In Review";
            await Api.AdvanceTenantSettingsWorkflowAsync(item.WorkflowItemId, new AdvanceTenantSettingsWorkflowRequest { Stage = nextStage, Status = nextStatus, ModifiedByUserId = _userId });
            ShowToast($"Workflow advanced to {nextStage}.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Workflow update failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveRelatedConfigurationAsync(BrandingForm form)
    {
        await Api.SaveTenantConfigurationAsync(_tenantId, new[]
        {
            new UpsertTenantSettingModel { SettingKey = "Branding.WhiteLabelName", SettingValue = form.WhiteLabelName ?? string.Empty },
            new UpsertTenantSettingModel { SettingKey = "Branding.LogoUrl", SettingValue = form.LogoUrl ?? string.Empty },
            new UpsertTenantSettingModel { SettingKey = "Branding.FaviconUrl", SettingValue = form.FaviconUrl ?? string.Empty },
            new UpsertTenantSettingModel { SettingKey = "Branding.PrimaryColor", SettingValue = NormalizeColor(form.PrimaryColor, DefaultPrimaryColor) },
            new UpsertTenantSettingModel { SettingKey = "Branding.SecondaryColor", SettingValue = NormalizeColor(form.SecondaryColor, DefaultSecondaryColor) },
            new UpsertTenantSettingModel { SettingKey = "Branding.AccentColor", SettingValue = NormalizeColor(form.AccentColor, DefaultAccentColor) },
            new UpsertTenantSettingModel { SettingKey = "Branding.CustomDomain", SettingValue = form.CustomDomain ?? string.Empty },
            new UpsertTenantSettingModel { SettingKey = "Branding.CustomCssUrl", SettingValue = form.CustomCssUrl ?? string.Empty },
            new UpsertTenantSettingModel { SettingKey = "Branding.SupportEmail", SettingValue = form.SupportEmail ?? string.Empty },
            new UpsertTenantSettingModel { SettingKey = "Branding.SupportPhone", SettingValue = form.SupportPhone ?? string.Empty },
            new UpsertTenantSettingModel { SettingKey = "Branding.FooterText", SettingValue = form.FooterText ?? string.Empty }
        });
    }

    private async Task CopyBrandSummaryAsync()
    {
        if (_branding is null) return;
        var summary = $"{DisplayBrandName} | {BrandStatus} | Domain: {DisplayValue(_branding.CustomDomain, "Default tenant domain")} | Palette: {PrimaryColor}/{SecondaryColor}/{AccentColor} | Support: {SupportSummary} | Readiness: {BrandReadinessScore}%";
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", summary);
            ShowToast("Branding summary copied to clipboard.");
        }
        catch
        {
            ShowToast($"Branding summary ready: {summary}");
        }
    }

    private void SetTab(string key) => _activeTab = key;
    private bool IsActiveTab(string key) => _activeTab == key;
    private bool ShowTab(string key) => _activeTab == key;
    private void ShowToast(string message, bool danger = false) { _toastMessage = message; _toastClass = danger ? "ab-toast--danger" : "ab-toast--success"; }
    private void ClearToast() => _toastMessage = null;

    private static string DisplayValue(string? value, string fallback = "-")
    {
        var trimmed = value?.Trim();
        return IsPlaceholderValue(trimmed) ? fallback : trimmed!;
    }

    private static bool IsPlaceholderValue(string? value) =>
        string.IsNullOrWhiteSpace(value)
        || !value.Any(char.IsLetterOrDigit)
        || value.All(c => char.IsWhiteSpace(c) || c is '?' or '�' or '-' or '_' or '.');
    private static bool HasValue(string? value) => !IsPlaceholderValue(value?.Trim());
    private static string? CleanValue(string? value) => IsPlaceholderValue(value?.Trim()) ? null : value!.Trim();

    private static TenantBrandingDto? SanitizeBranding(TenantBrandingDto? dto)
    {
        if (dto is null)
        {
            return null;
        }

        dto.WhiteLabelName = CleanValue(dto.WhiteLabelName);
        dto.LogoUrl = CleanValue(dto.LogoUrl);
        dto.FaviconUrl = CleanValue(dto.FaviconUrl);
        dto.CustomDomain = CleanValue(dto.CustomDomain);
        dto.CustomCssUrl = CleanValue(dto.CustomCssUrl);
        dto.SupportEmail = CleanValue(dto.SupportEmail);
        dto.SupportPhone = CleanValue(dto.SupportPhone);
        dto.FooterText = CleanValue(dto.FooterText);
        return dto;
    }
    private static string NormalizeColor(string? value, string fallback) => !string.IsNullOrWhiteSpace(value) && value.Trim().StartsWith('#') && (value.Trim().Length is 4 or 7) ? value.Trim() : fallback;
    private static bool IsWorkflowComplete(TenantSettingsWorkflowItemDto item) => string.Equals(item.Status, "Complete", StringComparison.OrdinalIgnoreCase) || string.Equals(item.Stage, "Approved", StringComparison.OrdinalIgnoreCase);
    private static bool IsHighRisk(TenantSettingsWorkflowItemDto item) => item.Priority.Contains("High", StringComparison.OrdinalIgnoreCase) || item.RiskCode.Contains("Risk", StringComparison.OrdinalIgnoreCase) || item.RiskCode.Contains("Governance", StringComparison.OrdinalIgnoreCase);
    private static string Slug(string? value) => string.IsNullOrWhiteSpace(value) ? "standard" : value.ToLowerInvariant().Replace(" ", "-").Replace("/", "-");
    private static string ActionIcon(string label) => label.Contains("Logo", StringComparison.OrdinalIgnoreCase) ? "bi-images" : label.Contains("Support", StringComparison.OrdinalIgnoreCase) ? "bi-headset" : label.Contains("Domain", StringComparison.OrdinalIgnoreCase) ? "bi-globe2" : label.Contains("palette", StringComparison.OrdinalIgnoreCase) ? "bi-universal-access" : "bi-pencil-square";
    private static string ActionTab(string label) => label.Contains("Logo", StringComparison.OrdinalIgnoreCase) || label.Contains("palette", StringComparison.OrdinalIgnoreCase) ? "assets" : label.Contains("Support", StringComparison.OrdinalIgnoreCase) || label.Contains("Footer", StringComparison.OrdinalIgnoreCase) ? "support" : label.Contains("Domain", StringComparison.OrdinalIgnoreCase) || label.Contains("identity", StringComparison.OrdinalIgnoreCase) ? "identity" : "governance";

    private RenderFragment Field(string label, string? value, bool mono = false, string fallback = "-") => @<div class="ab-field">
        <span class="ab-field-label">@label</span>
        <span class="ab-field-value @(mono ? "ab-mono" : null)">@DisplayValue(value, fallback)</span>
    </div>;

    private RenderFragment OptionalField(string label, string? value, bool mono = false) => @<text>
        @if (HasValue(value))
        {
            @Field(label, value, mono)
        }
    </text>;

    private RenderFragment ColorField(string label, string value) => @<div class="ab-field ab-color-field">
        <span class="ab-field-label">@label</span>
        <span class="ab-color-row"><span class="ab-color-swatch" style="background:@value"></span><span class="ab-field-value ab-mono">@value</span></span>
    </div>;

    private static double ContrastRatio(string foreground, string background)
    {
        var fg = RelativeLuminance(foreground);
        var bg = RelativeLuminance(background);
        var lighter = Math.Max(fg, bg);
        var darker = Math.Min(fg, bg);
        return (lighter + 0.05) / (darker + 0.05);
    }

    private static double RelativeLuminance(string hex)
    {
        var (r, g, b) = ParseColor(hex);
        static double Channel(int c)
        {
            var value = c / 255d;
            return value <= 0.03928 ? value / 12.92 : Math.Pow((value + 0.055) / 1.055, 2.4);
        }
        return 0.2126 * Channel(r) + 0.7152 * Channel(g) + 0.0722 * Channel(b);
    }

    private static (int R, int G, int B) ParseColor(string hex)
    {
        var value = hex.Trim().TrimStart('#');
        if (value.Length == 3)
        {
            value = string.Concat(value.Select(c => new string(c, 2)));
        }

        return value.Length == 6
            && int.TryParse(value[..2], System.Globalization.NumberStyles.HexNumber, null, out var r)
            && int.TryParse(value.Substring(2, 2), System.Globalization.NumberStyles.HexNumber, null, out var g)
            && int.TryParse(value.Substring(4, 2), System.Globalization.NumberStyles.HexNumber, null, out var b)
            ? (r, g, b)
            : (13, 110, 253);
    }

