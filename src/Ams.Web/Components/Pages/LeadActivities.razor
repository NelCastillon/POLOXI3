@page "/crm/lead-activities"
@inject ApiClient Api

<PageTitle>Lead Activities</PageTitle>

<h1>Lead Activities</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(LeadActivityDto.Subject)" HeaderText="Subject" Width="220"></GridColumn>
            <GridColumn Field="@nameof(LeadActivityDto.ActivityTypeCode)" HeaderText="Type" Width="120"></GridColumn>
            <GridColumn Field="@nameof(LeadActivityDto.LeadName)" HeaderText="Lead" Width="180"></GridColumn>
            <GridColumn Field="@nameof(LeadActivityDto.OpportunityName)" HeaderText="Opportunity" Width="180"></GridColumn>
            <GridColumn Field="@nameof(LeadActivityDto.ActivityDate)" HeaderText="Date" Type="ColumnType.DateTime" Format="d" Width="120"></GridColumn>
            <GridColumn Field="@nameof(LeadActivityDto.DurationMinutes)" HeaderText="Duration (min)" Width="140"></GridColumn>
            <GridColumn Field="@nameof(LeadActivityDto.OutcomeCode)" HeaderText="Outcome" Width="120"></GridColumn>
            <GridColumn Field="@nameof(LeadActivityDto.IsCompleted)" HeaderText="Completed" DisplayAsCheckBox="true" Width="120"></GridColumn>
            <GridColumn Field="@nameof(LeadActivityDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="g" Width="160"></GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<LeadActivityDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchLeadActivitiesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<LeadActivityDto>();
    }
}
