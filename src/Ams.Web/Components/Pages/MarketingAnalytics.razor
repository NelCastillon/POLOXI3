    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Marketing", "/marketing/campaigns"), new("Analytics", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await Api.EnsureMarketingAnalyticsSeedAsync(_tenantId);
            var result = await Api.SearchMarketingAnalyticsAsync(_tenantId, _period, null);
            _metrics = result?.Items?.ToList() ?? [];
            _channelSummaries = result?.Channels?.ToList() ?? [];
            _opportunitySummaries = result?.Opportunities?.ToList() ?? [];
            ApplyFilters(resetPage: true);
            EnsureSelectedStillVisible();
        }
        catch (Exception ex)
        {
            _loadError = $"Marketing analytics failed to load: {ex.Message}";
            _metrics = [];
            _channelSummaries = [];
            _opportunitySummaries = [];
            ApplyFilters(resetPage: true);
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters(bool resetPage = false)
    {
        IEnumerable<MarketingAnalyticsMetricDto> query = _metrics;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var search = _search.Trim();
            query = query.Where(m =>
                m.CampaignName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                m.Channel.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                m.CampaignType.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                m.SegmentName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                m.Goal.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_filterChannel)) query = query.Where(m => m.Channel == _filterChannel);
        if (!string.IsNullOrWhiteSpace(_filterGoal)) query = query.Where(m => m.Goal == _filterGoal);
        if (!string.IsNullOrWhiteSpace(_filterStatus)) query = query.Where(m => m.Status == _filterStatus);
        query = _kpiFilter switch
        {
            "open" => query.Where(m => m.OpenRate >= AvgOpenRate),
            "click" => query.Where(m => m.ClickRate >= AvgClickRate),
            "conversions" => query.Where(m => m.Conversions > 0),
            "revenue" => query.Where(m => m.Revenue > 0),
            "roas" => query.Where(m => m.Roas >= 3),
            "spend" => query.Where(m => m.Spend > 0),
            "risk" => query.Where(m => m.UnsubscribeRate >= AvgUnsubscribeRate),
            _ => query
        };

        _filtered = query.OrderByDescending(m => m.Revenue).ThenByDescending(m => m.Conversions).ToList();
        if (resetPage) _page = 1;
        if (_page > TotalPages) _page = TotalPages;
        _paged = _filtered.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    }

    private void SetKpiFilter(string filter)
    {
        _kpiFilter = _kpiFilter == filter ? "all" : filter;
        ApplyFilters(resetPage: true);
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _filterChannel = string.Empty;
        _filterGoal = string.Empty;
        _filterStatus = string.Empty;
        _kpiFilter = "all";
        ApplyFilters(resetPage: true);
    }

    private void PreviousPage()
    {
        if (_page <= 1) return;
        _page--;
        ApplyFilters();
    }

    private void NextPage()
    {
        if (_page >= TotalPages) return;
        _page++;
        ApplyFilters();
    }

