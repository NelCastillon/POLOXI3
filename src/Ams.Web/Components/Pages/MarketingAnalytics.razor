@page "/marketing/analytics"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Campaign Performance — AMS</PageTitle>

<AppPageHeader Title="Campaign Performance"
               Subtitle="Revenue attribution, engagement analytics, and ROI reporting across all marketing channels"
               Icon="bi-bar-chart-line-fill">
    <Actions>
        <select class="mkа-period-sel" @bind="_period">
            <option value="30">Last 30 Days</option>
            <option value="90">Last 90 Days</option>
            <option value="ytd">Year to Date</option>
            <option value="12m">Last 12 Months</option>
        </select>
        <button class="um-btn um-btn-ghost">
            <i class="bi bi-download" aria-hidden="true"></i> Export
        </button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}

<!-- KPI strip -->
<div class="mka-kpi-strip">
    <div class="mka-kpi-card">
        <div class="mka-kpi-icon mka-ki-blue"><i class="bi bi-people" aria-hidden="true"></i></div>
        <div><div class="mka-kv">@_totalReached.ToString("N0")</div><div class="mka-kl">Total Reached</div><div class="mka-delta mka-dpos">↑ 12% vs prior</div></div>
    </div>
    <div class="mka-kpi-card">
        <div class="mka-kpi-icon mka-ki-amber"><i class="bi bi-cursor" aria-hidden="true"></i></div>
        <div><div class="mka-kv">@_avgOpenRate.ToString("N1")%</div><div class="mka-kl">Avg. Open Rate</div><div class="mka-delta mka-dpos">↑ 3.2pp vs prior</div></div>
    </div>
    <div class="mka-kpi-card">
        <div class="mka-kpi-icon mka-ki-green"><i class="bi bi-trophy" aria-hidden="true"></i></div>
        <div><div class="mka-kv">@_totalConversions.ToString("N0")</div><div class="mka-kl">Conversions</div><div class="mka-delta mka-dpos">↑ 28% vs prior</div></div>
    </div>
    <div class="mka-kpi-card">
        <div class="mka-kpi-icon mka-ki-green"><i class="bi bi-cash-coin" aria-hidden="true"></i></div>
        <div><div class="mka-kv">@_totalRevenue.ToString("C0")</div><div class="mka-kl">Revenue Attributed</div><div class="mka-delta mka-dpos">↑ 19% vs prior</div></div>
    </div>
    <div class="mka-kpi-card">
        <div class="mka-kpi-icon mka-ki-blue"><i class="bi bi-currency-dollar" aria-hidden="true"></i></div>
        <div><div class="mka-kv">@(_totalRevenue / Math.Max(_totalSpend, 1)).ToString("N1")x</div><div class="mka-kl">ROAS</div><div class="mka-delta mka-dpos">↑ 0.4x vs prior</div></div>
    </div>
    <div class="mka-kpi-card">
        <div class="mka-kpi-icon mka-ki-amber"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></div>
        <div><div class="mka-kv">@_unsubRate.ToString("N2")%</div><div class="mka-kl">Unsubscribe Rate</div><div class="mka-delta mka-dneg">↑ 0.1pp vs prior</div></div>
    </div>
</div>

<!-- Channel breakdown -->
<div class="mka-row">
    <div class="mka-card mka-card-lg">
        <div class="mka-card-hdr">Performance by Campaign</div>
        @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading analytics…</span></div> }
        <SfGrid TValue="CampPerfRow" DataSource="_rows" AllowSorting="true" EnableHover="true" RowHeight="50">
            <GridColumns>
                <GridColumn Field="@nameof(CampPerfRow.Name)" HeaderText="Campaign" MinWidth="200" />
                <GridColumn Field="@nameof(CampPerfRow.Type)" HeaderText="Type" Width="120" />
                <GridColumn Field="@nameof(CampPerfRow.Reached)" HeaderText="Reached" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                    <Template>@{ var r = (CampPerfRow)context; }<span class="mka-mono">@r.Reached.ToString("N0")</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(CampPerfRow.OpenRate)" HeaderText="Open %" Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                    <Template>@{ var r = (CampPerfRow)context; }<span class="mka-mono">@r.OpenRate.ToString("N1")%</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(CampPerfRow.ClickRate)" HeaderText="Click %" Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                    <Template>@{ var r = (CampPerfRow)context; }<span class="mka-mono">@r.ClickRate.ToString("N1")%</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(CampPerfRow.Conversions)" HeaderText="Conv." Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                    <Template>@{ var r = (CampPerfRow)context; }<span class="mka-mono mka-bold">@r.Conversions</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(CampPerfRow.Revenue)" HeaderText="Revenue" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                    <Template>@{ var r = (CampPerfRow)context; }<span class="mka-mono mka-bold">@r.Revenue.ToString("C0")</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(CampPerfRow.Roas)" HeaderText="ROAS" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                    <Template>@{ var r = (CampPerfRow)context; }<span class="mka-mono @(r.Roas >= 4m ? "mka-good" : r.Roas >= 2m ? "mka-ok" : "mka-bad")">@r.Roas.ToString("N1")x</span></Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>

    <div class="mka-col">
        <!-- Channel mix -->
        <div class="mka-card">
            <div class="mka-card-hdr">Channel Mix</div>
            <div class="mka-ch-list">
                @foreach (var ch in _channels)
                {
                    <div class="mka-ch-row">
                        <span class="mka-ch-lbl">@ch.Name</span>
                        <div class="mka-ch-bar-wrap">
                            <div class="mka-ch-bar @ch.Css" style="width:@(ch.Pct)%"></div>
                        </div>
                        <span class="mka-ch-pct">@ch.Pct%</span>
                    </div>
                }
            </div>
        </div>
        <!-- Top opportunity types -->
        <div class="mka-card">
            <div class="mka-card-hdr">Top Opportunity Types</div>
            <div class="mka-opp-list">
                @foreach (var opp in _oppTypes)
                {
                    <div class="mka-opp-row">
                        <span class="mka-opp-name">@opp.Name</span>
                        <span class="mka-opp-conv">@opp.Conversions conv.</span>
                        <span class="mka-opp-rev">@opp.Revenue.ToString("C0")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string _period = "90";
    private bool _loading;
    private string? _loadError;

    private List<CampPerfRow> _rows = [];
    private decimal _totalReached, _avgOpenRate, _totalConversions, _totalRevenue, _totalSpend;
    private decimal _unsubRate = 0.18m;

    private List<(string Name, int Pct, string Css)> _channels = [];
    private List<(string Name, int Conversions, decimal Revenue)> _oppTypes = [];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Marketing","/marketing/campaigns"), new("Analytics",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try
        {
            var campaigns = await Api.SearchCommunicationCampaignsAsync(_tenantId);
            _rows = campaigns?.Items.Select(c => new CampPerfRow(c.Name, c.Type, c.Reached, c.OpenRate, EstimateClickRate(c.OpenRate), c.Conversions, c.Revenue, EstimateSpend(c.Type, c.Reached))).ToList() ?? [];
            SyncBreakdowns();
        }
        catch (Exception ex) { _loadError = $"Failed to load analytics: {ex.Message}"; _rows = []; }

        _totalReached    = _rows.Sum(r => r.Reached);
        _avgOpenRate     = _rows.Any() ? _rows.Average(r => r.OpenRate) : 0;
        _totalConversions= _rows.Sum(r => r.Conversions);
        _totalRevenue    = _rows.Sum(r => r.Revenue);
        _totalSpend      = _rows.Sum(r => r.Spend);
        _loading = false;
    }

    private void SyncBreakdowns()
    {
        var reachedTotal = Math.Max(_rows.Sum(r => r.Reached), 1);
        _channels = _rows.GroupBy(r => r.Type).Select(g => (g.Key, (int)Math.Round(g.Sum(r => r.Reached) * 100m / reachedTotal), ChannelCss(g.Key))).ToList();
        _oppTypes = _rows.OrderByDescending(r => r.Revenue).Take(5).Select(r => (r.Name, r.Conversions, r.Revenue)).ToList();
    }

    private static string ChannelCss(string type) => type switch
    {
        "Email" => "mka-ch-blue",
        "SMS" => "mka-ch-green",
        "Multi-Channel" => "mka-ch-purple",
        "Direct Mail" => "mka-ch-amber",
        _ => "mka-ch-blue",
    };

    private static decimal EstimateClickRate(decimal openRate) => Math.Round(openRate * 0.22m, 1);
    private static decimal EstimateSpend(string type, int reached) => Math.Max(500m, reached * (type == "Direct Mail" ? 1.15m : type == "SMS" ? 0.18m : 0.42m));

    private sealed record CampPerfRow(string Name, string Type, int Reached, decimal OpenRate, decimal ClickRate, int Conversions, decimal Revenue, decimal Spend)
    {
        public decimal Roas => Spend > 0 ? Revenue / Spend : 0;
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
