@page "/marketing/analytics"
@page "/marketing/reports"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject IJSRuntime Js

<PageTitle>Marketing Analytics - AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="mka-toast mka-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="mka-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showEditor)
{
    <div class="mka-modal-backdrop" role="presentation" @onclick="CloseEditor">
        <div class="mka-modal mka-action-modal" role="dialog" aria-modal="true" aria-labelledby="mka-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-bar-chart-line-fill" aria-hidden="true"></i>
                <span id="mka-form-title">@(_editingId == Guid.Empty ? "Create Analytics Metric" : "Edit Analytics Metric")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseEditor" disabled="@_busy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveMetricAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="mka-modal-intro">
                        <span><i class="bi bi-database-check" aria-hidden="true"></i> Marketing performance metric</span>
                        <p>Maintain campaign attribution, channel performance, ROI, and conversion metrics synchronized with the marketing workflow.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Campaign Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.CampaignName" />
                        </div>
                        <div class="um-field">
                            <label>Channel <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.Channel">
                                @foreach (var channel in _channels)
                                {
                                    <option value="@channel">@channel</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Campaign Type <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.CampaignType">
                                @foreach (var type in _campaignTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Segment <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.SegmentName" />
                        </div>
                        <div class="um-field">
                            <label>Goal <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.Goal">
                                @foreach (var goal in _goals)
                                {
                                    <option value="@goal">@goal</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Period</label>
                            <InputSelect class="form-select" @bind-Value="_form.PeriodCode">
                                @foreach (var period in _periodOptions)
                                {
                                    <option value="@period.Value">@period.Label</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Status</label>
                            <InputSelect class="form-select" @bind-Value="_form.Status">
                                @foreach (var status in _statuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Period Start</label>
                            <InputDate class="form-control" @bind-Value="_form.PeriodStartDate" />
                        </div>
                        <div class="um-field">
                            <label>Period End</label>
                            <InputDate class="form-control" @bind-Value="_form.PeriodEndDate" />
                        </div>
                        <div class="um-field">
                            <label>Reached</label>
                            <InputNumber class="form-control" @bind-Value="_form.Reached" />
                        </div>
                        <div class="um-field">
                            <label>Conversions</label>
                            <InputNumber class="form-control" @bind-Value="_form.Conversions" />
                        </div>
                        <div class="um-field">
                            <label>Open Rate %</label>
                            <InputNumber class="form-control" @bind-Value="_form.OpenRate" />
                        </div>
                        <div class="um-field">
                            <label>Click Rate %</label>
                            <InputNumber class="form-control" @bind-Value="_form.ClickRate" />
                        </div>
                        <div class="um-field">
                            <label>Revenue</label>
                            <InputNumber class="form-control" @bind-Value="_form.Revenue" />
                        </div>
                        <div class="um-field">
                            <label>Spend</label>
                            <InputNumber class="form-control" @bind-Value="_form.Spend" />
                        </div>
                        <div class="um-field">
                            <label>Unsubscribe Rate %</label>
                            <InputNumber class="form-control" @bind-Value="_form.UnsubscribeRate" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseEditor" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        @(_editingId == Guid.Empty ? "Create Metric" : "Save Changes")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showArchiveConfirm && _archiveTarget is not null)
{
    <div class="mka-modal-backdrop" role="presentation" @onclick="CancelArchive">
        <div class="mka-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="mka-archive-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-archive-fill" aria-hidden="true"></i></div>
                <div class="um-confirm-title" id="mka-archive-title">Archive Analytics Metric</div>
                <div class="um-confirm-body">Archive <strong>@_archiveTarget.CampaignName</strong>? It will be removed from active marketing analytics views.</div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CancelArchive" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn um-btn-danger" @onclick="ExecuteArchiveAsync" disabled="@_busy">Archive Metric</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showDirectConfirm && _directConfirm is not null)
{
    <div class="mka-modal-backdrop" role="presentation" @onclick="CancelDirectExecution">
        <div class="mka-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="mka-direct-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon @_directConfirm.IconClass"><i class="bi @_directConfirm.Icon" aria-hidden="true"></i></div>
                <div class="um-confirm-title" id="mka-direct-title">@_directConfirm.Title</div>
                <div class="um-confirm-body">@((MarkupString)_directConfirm.Body)</div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CancelDirectExecution" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn @_directConfirm.ButtonClass" @onclick="ExecuteDirectConfirmedAsync" disabled="@_busy">@_directConfirm.ButtonText</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="mka-enterprise-page">
    <section class="mka-header">
        <div class="mka-header-left">
            <div class="mka-lob-icon"><i class="bi bi-bar-chart-line-fill" aria-hidden="true"></i></div>
            <div class="mka-header-info">
                <div class="mka-title-row">
                    <h1 class="mka-page-title">Marketing Analytics</h1>
                    <span class="mka-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live analytics data</span>
                    <span class="mka-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span>
                </div>
                <div class="mka-sub-row">
                    <span>Measure campaign reach, engagement, conversions, revenue attribution, and ROAS.</span>
                    <span class="mka-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Seed sync enabled</span>
                    <span class="mka-sub-chip"><i class="bi bi-check2-circle" aria-hidden="true"></i> @_filtered.Count active matches</span>
                </div>
            </div>
        </div>
        <div class="mka-header-actions">
            <select class="mka-period-select" @bind="PeriodFilter" aria-label="Analytics period">
                @foreach (var period in _periodOptions)
                {
                    <option value="@period.Value">@period.Label</option>
                }
            </select>
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi @(_loading ? "bi-arrow-repeat mka-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ConfirmExport" disabled="@(!_filtered.Any())">
                <i class="bi bi-download" aria-hidden="true"></i> Export
            </button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">
                <i class="bi bi-plus-circle" aria-hidden="true"></i> New Metric
            </button>
        </div>
    </section>

    <section class="mka-kpi-strip" aria-label="Marketing analytics metrics">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="mka-kpi-card @kpi.Tone @(_kpiFilter == kpi.Filter ? "mka-kpi-active" : null)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)">
                <span class="mka-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="mka-kpi-copy">
                    <span class="mka-kpi-label">@kpi.Label</span>
                    <span class="mka-kpi-value">@kpi.Value</span>
                    <span class="mka-kpi-caption">@kpi.Caption</span>
                </span>
            </button>
        }
    </section>

    <section class="mka-workflow-strip" aria-label="Marketing workflow shortcuts">
        <button type="button" class="mka-workflow-card mka-wf-campaigns" @onclick='() => Nav.NavigateTo("/marketing/campaigns")'>
            <span class="mka-workflow-icon"><i class="bi bi-megaphone" aria-hidden="true"></i></span>
            <span class="mka-workflow-content"><strong>1</strong><span>Campaigns</span><small>Plan and activate campaigns.</small></span>
        </button>
        <button type="button" class="mka-workflow-card mka-wf-email" @onclick='() => Nav.NavigateTo("/marketing/email-blasts")'>
            <span class="mka-workflow-icon"><i class="bi bi-envelope-paper" aria-hidden="true"></i></span>
            <span class="mka-workflow-content"><strong>2</strong><span>Outreach</span><small>Send email and SMS journeys.</small></span>
        </button>
        <button type="button" class="mka-workflow-card mka-wf-segments" @onclick='() => Nav.NavigateTo("/marketing/segments")'>
            <span class="mka-workflow-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
            <span class="mka-workflow-content"><strong>3</strong><span>Segments</span><small>Target audiences and lists.</small></span>
        </button>
        <button type="button" class="mka-workflow-card mka-wf-cross" @onclick='() => Nav.NavigateTo("/marketing/cross-sell")'>
            <span class="mka-workflow-icon"><i class="bi bi-bullseye" aria-hidden="true"></i></span>
            <span class="mka-workflow-content"><strong>4</strong><span>Convert</span><small>Prioritize revenue opportunities.</small></span>
        </button>
        <button type="button" class="mka-workflow-card mka-wf-pages" @onclick='() => Nav.NavigateTo("/marketing/landing-pages")'>
            <span class="mka-workflow-icon"><i class="bi bi-window-sidebar" aria-hidden="true"></i></span>
            <span class="mka-workflow-content"><strong>5</strong><span>Pages</span><small>Measure landing-page actions.</small></span>
        </button>
    </section>

    <section class="mka-enterprise-search" aria-label="Marketing analytics filters">
        <div class="mka-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
        <div class="mka-search-body">
            <label for="mka-search">Search marketing analytics</label>
            <input id="mka-search" class="mka-search-input" type="search" placeholder="Search campaign, channel, type, segment, goal..." @bind="SearchFilter" @bind:event="oninput" />
            <span class="mka-search-hint">Filters apply instantly across the synchronized analytics register.</span>
        </div>
        <select class="mka-filter-select" @bind="ChannelFilter" aria-label="Channel filter">
            <option value="">All channels</option>
            @foreach (var channel in ChannelOptions)
            {
                <option value="@channel">@channel</option>
            }
        </select>
        <select class="mka-filter-select" @bind="GoalFilter" aria-label="Goal filter">
            <option value="">All goals</option>
            @foreach (var goal in GoalOptions)
            {
                <option value="@goal">@goal</option>
            }
        </select>
        <select class="mka-filter-select" @bind="StatusFilter" aria-label="Status filter">
            <option value="">All statuses</option>
            @foreach (var status in _statuses)
            {
                <option value="@status">@status</option>
            }
        </select>
        <div class="mka-search-result"><strong>@_filtered.Count</strong><span>matches</span></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger mka-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_loadError</div>
    }

    <section class="mka-content-layout">
        <div class="mka-grid-wrap">
            <div class="mka-grid-toolbar">
                <div>
                    <strong>Marketing performance register</strong>
                    <span>@ActiveFilterText</span>
                </div>
                <div class="mka-toolbar-actions">
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-eraser" aria-hidden="true"></i> Reset</button>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/marketing/reports")'><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i> Reports</button>
                    <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add</button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="mka-loading"><i class="bi bi-arrow-repeat mka-spin" aria-hidden="true"></i><strong>Loading marketing analytics...</strong><span>Syncing schema, seed data, campaign metrics, and attribution rollups.</span></div>
            }
            else if (!_filtered.Any())
            {
                <div class="mka-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No analytics metrics found</strong><span>Adjust filters or create a metric for the selected period.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">New Metric</button></div>
            }
            else
            {
                <div class="mka-table-scroll">
                    <table class="mka-table">
                        <thead>
                            <tr>
                                <th>Campaign</th>
                                <th>Channel</th>
                                <th>Goal</th>
                                <th class="mka-number">Reached</th>
                                <th class="mka-number">Open</th>
                                <th class="mka-number">Click</th>
                                <th class="mka-number">Conv.</th>
                                <th class="mka-number">Revenue</th>
                                <th class="mka-number">ROAS</th>
                                <th>Status</th>
                                <th class="mka-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var metric in _paged)
                            {
                                <tr class="mka-table-row @(IsSelected(metric) ? "mka-table-row--selected" : null)" @onclick="() => SelectMetric(metric)">
                                    <td>
                                        <div class="mka-campaign-cell">
                                            <span class="mka-campaign-icon @ChannelIconClass(metric.Channel)"><i class="bi @ChannelIcon(metric.Channel)" aria-hidden="true"></i></span>
                                            <div>
                                                <strong>@metric.CampaignName</strong>
                                                <span>@metric.CampaignType - @metric.SegmentName</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="mka-channel-chip @ChannelCss(metric.Channel)">@metric.Channel</span></td>
                                    <td>@metric.Goal</td>
                                    <td class="mka-number">@metric.Reached.ToString("N0")</td>
                                    <td class="mka-number">@metric.OpenRate.ToString("N1")%</td>
                                    <td class="mka-number">@metric.ClickRate.ToString("N1")%</td>
                                    <td class="mka-number mka-strong">@metric.Conversions.ToString("N0")</td>
                                    <td class="mka-number mka-strong">@metric.Revenue.ToString("C0")</td>
                                    <td class="mka-number"><span class="@RoasCss(metric.Roas)">@metric.Roas.ToString("N1")x</span></td>
                                    <td><span class="mka-status-chip @StatusCss(metric.Status)">@metric.Status</span></td>
                                    <td>
                                        <div class="mka-row-acts">
                                            <button type="button" class="um-btn um-btn-primary um-btn-xs" @onclick="() => ConfirmRecalculate(metric)" @onclick:stopPropagation="true" title="Recalculate"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenEdit(metric)" @onclick:stopPropagation="true" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => ConfirmDuplicate(metric)" @onclick:stopPropagation="true" title="Duplicate"><i class="bi bi-copy" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => ConfirmArchive(metric)" @onclick:stopPropagation="true" title="Archive"><i class="bi bi-archive" aria-hidden="true"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mka-pager">
                    <span>Page @_page of @TotalPages - @_filtered.Count records</span>
                    <div>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                    </div>
                </div>
            }
        </div>

        <aside class="mka-detail-panel">
            @if (_selected is null)
            {
                <div class="mka-detail-empty"><i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i><strong>Select a metric</strong><span>Click any row to inspect campaign attribution, period, engagement, and workflow actions.</span></div>
            }
            else
            {
                <div class="mka-detail-head">
                    <div>
                        <span class="mka-detail-eyebrow"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Metric detail</span>
                        <h2>@_selected.CampaignName</h2>
                        <div class="mka-detail-meta"><span>@_selected.Channel</span><span>@_selected.Goal</span><span>@_selected.Status</span></div>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearSelection"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="mka-detail-body">
                    <div class="mka-detail-summary">
                        <div class="mka-meta-row"><span class="mka-meta-lbl">Revenue</span><span class="mka-meta-val">@_selected.Revenue.ToString("C0")</span></div>
                        <div class="mka-meta-row"><span class="mka-meta-lbl">Spend</span><span class="mka-meta-val">@_selected.Spend.ToString("C0")</span></div>
                        <div class="mka-meta-row"><span class="mka-meta-lbl">ROAS</span><span class="mka-meta-val @RoasCss(_selected.Roas)">@_selected.Roas.ToString("N1")x</span></div>
                        <div class="mka-meta-row"><span class="mka-meta-lbl">Conversions</span><span class="mka-meta-val">@_selected.Conversions.ToString("N0")</span></div>
                        <div class="mka-meta-row"><span class="mka-meta-lbl">Open rate</span><span class="mka-meta-val">@_selected.OpenRate.ToString("N1")%</span></div>
                        <div class="mka-meta-row"><span class="mka-meta-lbl">Click rate</span><span class="mka-meta-val">@_selected.ClickRate.ToString("N1")%</span></div>
                    </div>
                    <div class="mka-insight-card">
                        <strong>Attribution window</strong>
                        <span><i class="bi bi-calendar-range" aria-hidden="true"></i> @_selected.PeriodStartDate.ToString("MMM d, yyyy") - @_selected.PeriodEndDate.ToString("MMM d, yyyy")</span>
                        <span><i class="bi bi-people" aria-hidden="true"></i> @_selected.Reached.ToString("N0") reached in @_selected.SegmentName</span>
                        <span><i class="bi bi-bell-slash" aria-hidden="true"></i> @_selected.UnsubscribeRate.ToString("N2")% unsubscribe rate</span>
                    </div>
                    <div class="mka-detail-actions">
                        <button type="button" class="um-btn um-btn-primary" @onclick="() => ConfirmRecalculate(_selected)"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Recalculate</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfirmDuplicate(_selected)"><i class="bi bi-copy" aria-hidden="true"></i> Duplicate</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/marketing/campaigns")'><i class="bi bi-megaphone" aria-hidden="true"></i> Campaigns</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfirmArchive(_selected)"><i class="bi bi-archive" aria-hidden="true"></i> Archive</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }

    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string _period = "90";
    private string _search = string.Empty;
    private string _filterChannel = string.Empty;
    private string _filterGoal = string.Empty;
    private string _filterStatus = string.Empty;
    private string _kpiFilter = "all";
    private string? _loadError;
    private string? _toastMessage;
    private string _toastKind = "success";
    private int _toastVersion;
    private bool _toastVisible;
    private bool _loading;
    private bool _busy;
    private bool _showEditor;
    private bool _showArchiveConfirm;
    private bool _showDirectConfirm;
    private Guid _editingId = Guid.Empty;
    private int _page = 1;
    private const int PageSize = 10;
    private MarketingAnalyticsMetricDto? _selected;
    private MarketingAnalyticsMetricDto? _archiveTarget;
    private DirectExecutionConfirm? _directConfirm;
    private MarketingMetricForm _form = new();

    private readonly List<string> _channels = ["Email", "SMS", "Multi-Channel", "Direct Mail", "Social", "Web"];
    private readonly List<string> _campaignTypes = ["Email", "SMS", "Multi-Channel", "Direct Mail", "Social", "Landing Page"];
    private readonly List<string> _goals = ["Cross-Sell", "Win-Back", "Reviews", "Referrals", "Engagement", "Retention"];
    private readonly List<string> _statuses = ["Active", "Draft", "Paused", "Archived"];
    private readonly List<PeriodOption> _periodOptions = [new("30", "Last 30 Days"), new("90", "Last 90 Days"), new("ytd", "Year to Date"), new("12m", "Last 12 Months")];

    private List<MarketingAnalyticsMetricDto> _metrics = [];
    private List<MarketingAnalyticsMetricDto> _filtered = [];
    private List<MarketingAnalyticsMetricDto> _paged = [];
    private List<MarketingAnalyticsChannelSummaryDto> _channelSummaries = [];
    private List<MarketingAnalyticsOpportunitySummaryDto> _opportunitySummaries = [];

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", "info" => "bi-info-circle-fill", _ => "bi-check-circle-fill" };
    private string ActiveFilterText => _kpiFilter == "all" ? $"{PeriodLabel(_period)} analytics" : $"Filtered by {_kpiFilter} - {PeriodLabel(_period)}";
    private IEnumerable<string> ChannelOptions => _metrics.Select(m => m.Channel).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s);
    private IEnumerable<string> GoalOptions => _metrics.Select(m => m.Goal).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s);
    private decimal TotalReached => _metrics.Sum(m => m.Reached);
    private decimal TotalRevenue => _metrics.Sum(m => m.Revenue);
    private decimal TotalSpend => _metrics.Sum(m => m.Spend);
    private int TotalConversions => _metrics.Sum(m => m.Conversions);
    private decimal AvgOpenRate => _metrics.Any() ? _metrics.Average(m => m.OpenRate) : 0;
    private decimal AvgClickRate => _metrics.Any() ? _metrics.Average(m => m.ClickRate) : 0;
    private decimal AvgUnsubscribeRate => _metrics.Any() ? _metrics.Average(m => m.UnsubscribeRate) : 0;
    private decimal Roas => TotalSpend > 0 ? TotalRevenue / TotalSpend : 0;

