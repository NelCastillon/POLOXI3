    private void CloseEditor()
    {
        if (_busy) return;
        _showEditor = false;
        _editingId = Guid.Empty;
    }

    private async Task SaveMetricAsync()
    {
        _busy = true;
        try
        {
            var request = _form.ToDto(_tenantId);
            if (_editingId == Guid.Empty)
            {
                await Api.CreateMarketingAnalyticsMetricAsync(request);
                ShowToast("Metric created.", "success");
            }
            else
            {
                await Api.UpdateMarketingAnalyticsMetricAsync(_editingId, request);
                ShowToast("Metric saved.", "success");
            }

            _showEditor = false;
            _editingId = Guid.Empty;
            _period = request.PeriodCode;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

