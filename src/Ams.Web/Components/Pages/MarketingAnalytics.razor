        new("click", "Avg Click Rate", $"{AvgClickRate:N1}%", "CTA performance", "bi-cursor", "mka-ki-purple"),
        new("conversions", "Conversions", TotalConversions.ToString("N0"), "Bound opportunities", "bi-trophy", "mka-ki-green"),
        new("revenue", "Revenue", TotalRevenue.ToString("C0"), "Attributed premium", "bi-cash-coin", "mka-ki-green"),
        new("roas", "ROAS", $"{Roas:N1}x", "Return on spend", "bi-graph-up-arrow", "mka-ki-blue"),
        new("spend", "Spend", TotalSpend.ToString("C0"), "Campaign investment", "bi-credit-card", "mka-ki-amber"),
