    private async Task ExportAsync()
    {
        if (!_filtered.Any())
        {
            ShowToast("Nothing to export.", "warning");
            return;
        }

        var csv = new StringBuilder();
        csv.AppendLine("CampaignName,Channel,CampaignType,Segment,Goal,Period,PeriodStart,PeriodEnd,Reached,OpenRate,ClickRate,Conversions,Revenue,Spend,ROAS,UnsubscribeRate,Status,UpdatedUtc");
        foreach (var item in _filtered)
        {
            csv.AppendLine(string.Join(',',
                Csv(item.CampaignName),
                Csv(item.Channel),
                Csv(item.CampaignType),
                Csv(item.SegmentName),
                Csv(item.Goal),
                Csv(item.PeriodCode),
                Csv(item.PeriodStartDate.ToString("yyyy-MM-dd")),
                Csv(item.PeriodEndDate.ToString("yyyy-MM-dd")),
                item.Reached,
                item.OpenRate.ToString("0.00"),
                item.ClickRate.ToString("0.00"),
                item.Conversions,
                item.Revenue.ToString("0.00"),
                item.Spend.ToString("0.00"),
                item.Roas.ToString("0.00"),
                item.UnsubscribeRate.ToString("0.00"),
                Csv(item.Status),
                Csv(item.UpdatedDateUtc.ToString("O"))));
        }

        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        await Js.InvokeVoidAsync("amsDownload.downloadBase64", $"marketing-analytics-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
        ShowToast($"Exported {_filtered.Count:N0} records.", "success");
    }

    private void HideToast() => _toastVisible = false;

    private void ShowToast(string message, string kind)
    {
        var version = ++_toastVersion;
        _toastMessage = SingleLine(message);
        _toastKind = kind;
        _toastVisible = true;
        _ = HideToastAfterDelayAsync(version, ToastDelay(kind));
    }

    private async Task HideToastAfterDelayAsync(int version, int delayMs)
    {
        await Task.Delay(delayMs);
        if (version != _toastVersion) return;
        await InvokeAsync(() =>
        {
            if (version != _toastVersion) return;
            _toastVisible = false;
            StateHasChanged();
        });
    }

    private static int ToastDelay(string kind) => kind == "danger" ? 4800 : kind == "warning" ? 3800 : 2800;

    private static string SingleLine(string message)
    {
        var value = string.Join(' ', (message ?? string.Empty).Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries)).Trim();
        return value.Length <= 92 ? value : string.Concat(value.AsSpan(0, 89), "...");
    }

    private void EnsureSelectedStillVisible()
    {
        if (_selected is null) return;
        _selected = _metrics.FirstOrDefault(m => m.AnalyticsMetricId == _selected.AnalyticsMetricId);
    }

    private static string Csv(string value)
    {
        var quote = Convert.ToChar(34).ToString();
        return string.Concat(quote, value.Replace(quote, quote + quote), quote);
    }

    private static string PeriodLabel(string value) => value switch { "30" => "Last 30 days", "ytd" => "Year to date", "12m" => "Last 12 months", _ => "Last 90 days" };
    private static int PeriodDays(string value) => value switch { "30" => 30, "ytd" => Math.Max(1, DateTime.UtcNow.DayOfYear), "12m" => 365, _ => 90 };
    private static string ChannelCss(string channel) => $"mka-ch-{Slug(channel)}";
    private static string StatusCss(string status) => $"mka-st-{Slug(status)}";
    private static string ChannelIconClass(string channel) => channel switch { "SMS" => "mka-di-green", "Multi-Channel" => "mka-di-purple", "Direct Mail" => "mka-di-amber", "Social" => "mka-di-pink", "Web" => "mka-di-cyan", _ => "mka-di-blue" };
    private static string ChannelIcon(string channel) => channel switch { "SMS" => "bi-chat-dots", "Multi-Channel" => "bi-broadcast", "Direct Mail" => "bi-mailbox", "Social" => "bi-share", "Web" => "bi-window", _ => "bi-envelope" };
    private static string RoasCss(decimal roas) => roas >= 4m ? "mka-roas-good" : roas >= 2m ? "mka-roas-ok" : "mka-roas-bad";
    private static string Slug(string value) => value.ToLowerInvariant().Replace(" ", "-");

