        get => _search;
        set { _search = value; ApplyFilters(resetPage: true); }
    }

    private string ChannelFilter
    {
        get => _filterChannel;
        set { _filterChannel = value; ApplyFilters(resetPage: true); }
    }

    private string GoalFilter
    {
        get => _filterGoal;
        set { _filterGoal = value; ApplyFilters(resetPage: true); }
    }

    private string StatusFilter
    {
        get => _filterStatus;
        set { _filterStatus = value; ApplyFilters(resetPage: true); }
    }

    private string PeriodFilter
    {
        get => _period;
        set
        {
            if (_period == value) return;
            _period = value;
            _ = InvokeAsync(async () =>
            {
                await LoadAsync();
