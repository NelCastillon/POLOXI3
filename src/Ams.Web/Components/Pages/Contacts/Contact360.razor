@page "/client/contacts/{ContactId:guid}"
@namespace Ams.Web.Components.Pages.Contacts
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Contacts

<PageTitle>@(ContactPageConstants.FullName(_contact ?? new())) — Contact 360</PageTitle>

<AppPageHeader Title="Contact 360" Subtitle="Tenant Admin contact profile, roles, and account relationship" Icon="bi-person-circle"><Actions><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/client/contacts")'><i class="bi bi-arrow-left"></i> Contacts</button><button class="um-btn um-btn-primary" @onclick="OpenEdit"><i class="bi bi-pencil"></i> Edit</button></Actions></AppPageHeader>

@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }
@if (_loading) { <div class="mt-loading"><div class="um-spinner"></div><span>Loading contact…</span></div> }
else if (_contact is null) { <div class="ma-empty"><i class="bi bi-person-x ma-empty-icon"></i><span>Contact not found.</span></div> }
else
{
    <section class="ma-hero contact-hero"><div><span class="ma-eyebrow">Tenant Admin · Contact 360</span><h2>@ContactPageConstants.FullName(_contact)</h2><p>@(_contact.JobTitle ?? "Contact") · @(_contact.AccountName ?? "No account") · @_contact.ContactTypeCode</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-primary" @onclick="OpenEdit"><i class="bi bi-pencil"></i> Edit Contact</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo($"/client/contacts/{ContactId}/timeline")'><i class="bi bi-timeline"></i> Timeline</button></div></section>
    <div class="pc-kpi-strip contact-kpi-strip"><div class="pc-kpi-card"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-envelope"></i></span><div><div class="pc-kpi-value">@(_contact.Email is null ? "—" : "Yes")</div><div class="pc-kpi-label">Email</div></div></div><div class="pc-kpi-card"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-star-fill"></i></span><div><div class="pc-kpi-value">@(_contact.IsKeyContact ? "Yes" : "No")</div><div class="pc-kpi-label">Key Contact</div></div></div><div class="pc-kpi-card"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-globe"></i></span><div><div class="pc-kpi-value">@(_contact.IsPortalUser ? "Yes" : "No")</div><div class="pc-kpi-label">Portal</div></div></div><div class="pc-kpi-card"><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-receipt"></i></span><div><div class="pc-kpi-value">@(_contact.IsBillingContact ? "Yes" : "No")</div><div class="pc-kpi-label">Billing</div></div></div></div>
    <div class="acct-form-card"><div class="um-form-grid"><div class="um-field"><label>Account</label><strong>@(_contact.AccountName ?? "—")</strong></div><div class="um-field"><label>Email</label><strong>@(_contact.Email ?? "—")</strong></div><div class="um-field"><label>Phone</label><strong>@(_contact.Phone ?? "—")</strong></div><div class="um-field"><label>Preferred Method</label><strong>@(_contact.PreferredContactMethod ?? "—")</strong></div><div class="um-field"><label>Status</label><span class="@ContactPageConstants.StatusBadge(_contact.StatusCode)">@_contact.StatusCode</span></div><div class="um-field"><label>Created</label><strong>@_contact.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy")</strong></div></div></div>
}

<SfDialog @bind-Visible="_showForm" Width="720px" IsModal="true" ShowCloseIcon="false"><DialogContent><div class="um-modal-header"><i class="bi bi-person-circle"></i><span>Edit Contact</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>First Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.FirstName" class="um-input" /><ValidationMessage For="() => _form.FirstName" class="text-danger" /></div><div class="um-field"><label>Last Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.LastName" class="um-input" /><ValidationMessage For="() => _form.LastName" class="text-danger" /></div><div class="um-field"><label>Email</label><InputText @bind-Value="_form.Email" class="um-input" /><ValidationMessage For="() => _form.Email" class="text-danger" /></div><div class="um-field"><label>Phone</label><InputText @bind-Value="_form.Phone" class="um-input" /><ValidationMessage For="() => _form.Phone" class="text-danger" /></div><div class="um-field"><label>Job Title</label><InputText @bind-Value="_form.JobTitle" class="um-input" /><ValidationMessage For="() => _form.JobTitle" class="text-danger" /></div><div class="um-field"><label>Contact Type</label><InputSelect @bind-Value="_form.ContactTypeCode" class="um-input">@foreach (var type in ContactPageConstants.ContactTypes) { <option value="@type">@type</option> }</InputSelect><ValidationMessage For="() => _form.ContactTypeCode" class="text-danger" /></div><div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsKeyContact" /> Key Contact</label></div><div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsPortalUser" /> Portal User</label></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Save</button></div></EditForm></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />

@code { [Parameter] public Guid ContactId { get; set; } ContactDto? _contact; ContactFormModel _form = new(); SfToast _toast = default!; bool _loading, _saving, _showForm; string? _loadError; protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Contacts", "/client/contacts"), new("Contact 360")); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { _contact = await Api.GetContactByIdAsync(ContactId); if (_contact is not null) Breadcrumbs.SetCrumbs(new("Contacts", "/client/contacts"), new(ContactPageConstants.FullName(_contact), $"/client/contacts/{ContactId}")); } catch (Exception ex) { _loadError = $"Failed to load contact: {ex.Message}"; } finally { _loading = false; } } void OpenEdit() { if (_contact is null) return; _form = new() { AccountId = _contact.AccountId, FirstName = _contact.FirstName, LastName = _contact.LastName, Email = _contact.Email, Phone = _contact.Phone, JobTitle = _contact.JobTitle, ContactTypeCode = _contact.ContactTypeCode, PreferredContactMethod = _contact.PreferredContactMethod, StatusCode = _contact.StatusCode, IsBillingContact = _contact.IsBillingContact, IsServiceContact = _contact.IsServiceContact, IsPortalUser = _contact.IsPortalUser, IsKeyContact = _contact.IsKeyContact }; _showForm = true; } async Task SaveAsync() { _saving = true; try { await Api.UpdateContactAsync(ContactId, new UpdateContactRequest { FirstName = _form.FirstName, LastName = _form.LastName, Email = ContactPageConstants.Normalize(_form.Email), Phone = ContactPageConstants.Normalize(_form.Phone), JobTitle = ContactPageConstants.Normalize(_form.JobTitle), ContactTypeCode = _form.ContactTypeCode, IsBillingContact = _form.IsBillingContact, IsServiceContact = _form.IsServiceContact, IsPortalUser = _form.IsPortalUser, IsKeyContact = _form.IsKeyContact, PreferredContactMethod = ContactPageConstants.Normalize(_form.PreferredContactMethod), StatusCode = _form.StatusCode }); _showForm = false; await _toast.ShowAsync(new() { Content = "Contact saved", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } }
