@page "/client/contacts/{ContactId:guid}"
@namespace Ams.Web.Components.Pages.Contacts
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Contacts
@using Microsoft.AspNetCore.Components.Forms
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@(_contact is null ? "Contact" : ContactPageConstants.FullName(_contact)) - Contact 360</PageTitle>

<EnterpriseToast @ref="_toast" NewestOnTop="true" ShowCloseButton="true" Timeout="4000" />

@if (_loadError is not null)
{
    <div class="alert alert-danger c360-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError
    </div>
}

@if (_loading)
{
    <div class="mt-loading"><div class="um-spinner"></div><span>Loading contact...</span></div>
}
else if (_contact is null)
{
    <div class="ma-empty">
        <i class="bi bi-person-x ma-empty-icon" aria-hidden="true"></i>
        <span>Contact not found.</span>
        <button type="button" class="um-btn um-btn-ghost mt-2" @onclick='() => Nav.NavigateTo("/client/contacts")'>Back to Contact Directory</button>
    </div>
}
else
{
    <div class="c360-enterprise-page">
    <section class="c360-hero" aria-label="Contact 360 overview">
        <div class="c360-hero-left">
            <div class="c360-avatar">@ContactPageConstants.Initials(_contact.FirstName, _contact.LastName)</div>
            <div>
                <div class="c360-title-row">
                    <h1>@ContactPageConstants.FullName(_contact)</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live client data</span>
                    <span><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span>
                </div>
                <p>@(_contact.JobTitle ?? "Client contact") - @(_contact.AccountName ?? "No account") - @_contact.ContactTypeCode</p>
                <div class="c360-chip-row">
                    <span><i class="bi bi-person-vcard" aria-hidden="true"></i> @_contact.StatusCode</span>
                    <span><i class="bi bi-chat-dots" aria-hidden="true"></i> @(_contact.PreferredContactMethod ?? "No preference")</span>
                    <span><i class="bi bi-clock-history" aria-hidden="true"></i> @_workflowEvents.Count workflow events</span>
                </div>
            </div>
        </div>
        <div class="c360-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/client/contacts")'><i class="bi bi-arrow-left" aria-hidden="true"></i> Contacts</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="@RefreshIconClass" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenEdit"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="OpenNote"><i class="bi bi-sticky" aria-hidden="true"></i> Add Note</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="SendPortalInviteAsync"><i class="bi bi-send" aria-hidden="true"></i> Portal Invite</button>
        </div>
    </section>

    <div class="c360-kpi-strip" aria-label="Contact profile metrics">
        @KpiCard("Email", string.IsNullOrWhiteSpace(_contact.Email) ? "Missing" : "Available", "bi-envelope", string.IsNullOrWhiteSpace(_contact.Email) ? "inactive" : "active", 2)
        @KpiCard("Preferred", _contact.PreferredContactMethod ?? "Not set", "bi-chat-dots", "total", 2)
        @KpiCard("Status", _contact.StatusCode, "bi-shield-check", _contact.StatusCode == "Active" ? "active" : "inactive", 0)
        @KpiCard("Role Flags", RoleCount(_contact).ToString(), "bi-ui-checks", "total", 0)
        @KpiCard("Workflow", _workflowEvents.Count.ToString(), "bi-diagram-3", "active", 1)
    </div>

    <section class="c360-workflow-strip" aria-label="Contact workflow actions">
        <button class="c360-workflow-card" type="button" @onclick="OpenNote"><i class="bi bi-sticky" aria-hidden="true"></i><span><strong>Add service note</strong><span>Persist note to contact workflow timeline.</span></span></button>
        <button class="c360-workflow-card" type="button" @onclick="SendPortalInviteAsync"><i class="bi bi-send" aria-hidden="true"></i><span><strong>Portal invite</strong><span>Enable portal flag and write workflow event.</span></span></button>
        <button class="c360-workflow-card" type="button" @onclick="SyncWorkflowAsync"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span><strong>Sync workflow</strong><span>Sync account relationship and role context.</span></span></button>
        <button class="c360-workflow-card c360-workflow-card--danger" type="button" @onclick="ConfirmDelete"><i class="bi bi-trash" aria-hidden="true"></i><span><strong>Delete contact</strong><span>Confirm before deactivation/delete.</span></span></button>
    </section>

    <section class="c360-detail-card" aria-label="Contact detail tabs">
        <div class="c360-tab-nav" role="tablist" aria-label="Contact sections">
            <button id="c360-tab-0" type="button" class="@TabButtonClass(0)" role="tab" aria-selected="@(_tab == 0)" @onclick="() => SetTab(0)">
                <span class="c360-tab-icon"><i class="bi bi-person-lines-fill" aria-hidden="true"></i></span>
                <span><span class="c360-tab-title">Overview</span><span class="c360-tab-caption">Contact profile, account relationship, and responsibilities</span></span>
            </button>
            <button id="c360-tab-1" type="button" class="@TabButtonClass(1)" role="tab" aria-selected="@(_tab == 1)" @onclick="() => SetTab(1)">
                <span class="c360-tab-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
                <span><span class="c360-tab-title">Timeline</span><span class="c360-tab-caption">Contact workflow and activity history</span></span>
            </button>
            <button id="c360-tab-2" type="button" class="@TabButtonClass(2)" role="tab" aria-selected="@(_tab == 2)" @onclick="() => SetTab(2)">
                <span class="c360-tab-icon"><i class="bi bi-activity" aria-hidden="true"></i></span>
                <span><span class="c360-tab-title">Engagement</span><span class="c360-tab-caption">Communication readiness and service profile</span></span>
            </button>
        </div>

        <div class="c360-tab-panel" role="tabpanel" aria-labelledby="@TabId(_tab)">
            @if (_tab == 0)
            {
                <div class="a360-tab-body">
                    <div class="a360-overview-grid">
                        <div class="a360-info-card">
                            <h3 class="a360-section-hdr"><i class="bi bi-person-lines-fill" aria-hidden="true"></i> Contact Information</h3>
                            <div class="a360-field-grid">
                                @Field("Full Name", ContactPageConstants.FullName(_contact))
                                @Field("Job Title", _contact.JobTitle)
                                @Field("Contact Type", _contact.ContactTypeCode)
                                @Field("Status", _contact.StatusCode)
                                @Field("Preferred Method", _contact.PreferredContactMethod)
                                @Field("Created", _contact.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy"))
                            </div>
                        </div>
                        <div class="a360-info-card">
                            <h3 class="a360-section-hdr"><i class="bi bi-chat-dots" aria-hidden="true"></i> Communication</h3>
                            <div class="a360-field-grid">
                                @Field("Email", _contact.Email)
                                @Field("Phone", _contact.Phone)
                                @Field("Portal User", _contact.IsPortalUser ? "Yes" : "No")
                                @Field("Last Touch", TimelineItems.FirstOrDefault()?.DateUtc.ToLocalTime().ToString("g"))
                            </div>
                        </div>
                        <div class="a360-info-card">
                            <h3 class="a360-section-hdr"><i class="bi bi-building" aria-hidden="true"></i> Account Relationship</h3>
                            <div class="a360-field-grid">
                                @Field("Account", _contact.AccountName)
                                @Field("Account Id", _contact.AccountId.ToString())
                                @Field("Parent Contact", _contact.ParentContactId?.ToString())
                                @Field("Relationship", _contact.ContactTypeCode)
                            </div>
                            <div class="mt-3">
                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/accounts/{_contact.AccountId}")'>
                                    <i class="bi bi-building" aria-hidden="true"></i> Open Account 360
                                </button>
                            </div>
                        </div>
                        <div class="a360-info-card">
                            <h3 class="a360-section-hdr"><i class="bi bi-ui-checks" aria-hidden="true"></i> Responsibilities</h3>
                            <div class="contact-role-list">
                                @RoleRow("Key decision maker", _contact.IsKeyContact, "bi-star-fill")
                                @RoleRow("Billing contact", _contact.IsBillingContact, "bi-receipt")
                                @RoleRow("Service contact", _contact.IsServiceContact, "bi-headset")
                                @RoleRow("Portal enabled", _contact.IsPortalUser, "bi-globe")
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (_tab == 1)
            {
                <div class="a360-tab-body">
                    <div class="a360-tab-toolbar">
                        <span class="a360-tab-count">@TimelineItems.Count() timeline event(s)</span>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenNote"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Note</button>
                    </div>
                    <div class="a360-timeline">
                        @foreach (var item in TimelineItems)
                        {
                            <div class="a360-tl-item">
                                <div class="a360-tl-icon @TimelineTone(item.Tone)"><i class="bi @item.Icon" aria-hidden="true"></i></div>
                                <div class="a360-tl-body">
                                    <div class="a360-tl-hdr">
                                        <span class="a360-tl-type">@item.Type</span>
                                        <span class="a360-mono a360-muted">@item.DateUtc.ToLocalTime().ToString("g")</span>
                                    </div>
                                    <div class="a360-tl-subject">@item.Title</div>
                                    <p class="a360-tl-notes">@item.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="a360-tab-body">
                    <div class="a360-risk-grid">
                        <div class="a360-risk-card">
                            <div class="a360-risk-card-hdr"><i class="bi bi-envelope-open" aria-hidden="true"></i><span>Communication Readiness</span></div>
                            <div class="a360-risk-metrics">
                                @Metric("Email", string.IsNullOrWhiteSpace(_contact.Email) ? "Missing" : "Ready", "bi-envelope")
                                @Metric("Phone", string.IsNullOrWhiteSpace(_contact.Phone) ? "Missing" : "Ready", "bi-telephone")
                                @Metric("Preference", _contact.PreferredContactMethod ?? "Unset", "bi-chat-left-dots")
                                @Metric("Portal", _contact.IsPortalUser ? "Enabled" : "Not enabled", "bi-globe")
                            </div>
                        </div>
                        <div class="a360-risk-card">
                            <div class="a360-risk-card-hdr"><i class="bi bi-shield-check" aria-hidden="true"></i><span>Service Profile</span></div>
                            <div class="a360-risk-metrics">
                                @Metric("Key Contact", _contact.IsKeyContact ? "Yes" : "No", "bi-star")
                                @Metric("Billing", _contact.IsBillingContact ? "Yes" : "No", "bi-receipt")
                                @Metric("Service", _contact.IsServiceContact ? "Yes" : "No", "bi-headset")
                                @Metric("Status", _contact.StatusCode, "bi-check-circle")
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
    </div>
}

@if (_showForm)
{
    <div class="c360-modal-backdrop" role="presentation" @onclick="CloseEdit">
        <div class="c360-modal c360-edit-modal" role="dialog" aria-modal="true" aria-labelledby="c360-edit-title" @onclick:stopPropagation="true">
        <div class="um-modal-header">
            <i class="bi bi-person-circle" aria-hidden="true"></i>
            <span id="c360-edit-title">Edit Contact</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseEdit"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="NotifyValidationAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="um-field">
                        <label>First Name <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.FirstName" class="um-input" />
                    </div>
                    <div class="um-field">
                        <label>Last Name <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.LastName" class="um-input" />
                    </div>
                    <div class="um-field">
                        <label>Email</label>
                        <InputText @bind-Value="_form.Email" class="um-input" />
                        <ValidationMessage For="() => _form.Email" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Phone</label>
                        <InputText @bind-Value="_form.Phone" class="um-input" />
                        <ValidationMessage For="() => _form.Phone" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Job Title</label>
                        <InputText @bind-Value="_form.JobTitle" class="um-input" />
                        <ValidationMessage For="() => _form.JobTitle" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Contact Type <span class="text-danger">*</span></label>
                        <InputSelect @bind-Value="_form.ContactTypeCode" class="um-input">
                            @foreach (var type in ContactPageConstants.ContactTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="um-field">
                        <label>Preferred Method</label>
                        <InputSelect @bind-Value="_form.PreferredContactMethod" class="um-input">
                            <option value="">Select method</option>
                            @foreach (var method in ContactPageConstants.Methods)
                            {
                                <option value="@method">@method</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _form.PreferredContactMethod" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Status <span class="text-danger">*</span></label>
                        <InputSelect @bind-Value="_form.StatusCode" class="um-input">
                            @foreach (var status in ContactPageConstants.Statuses)
                            {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsKeyContact" /> Key Contact</label></div>
                    <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsBillingContact" /> Billing Contact</label></div>
                    <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsServiceContact" /> Service Contact</label></div>
                    <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsPortalUser" /> Portal User</label></div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CloseEdit">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi bi-check-lg" aria-hidden="true"></i> Save</button>
            </div>
        </EditForm>
        </div>
    </div>
}

@if (_showNote)
{
    <div class="c360-modal-backdrop" role="presentation" @onclick="CloseNote">
        <div class="c360-modal c360-note-modal" role="dialog" aria-modal="true" aria-labelledby="c360-note-title" @onclick:stopPropagation="true">
        <div class="um-modal-header">
            <i class="bi bi-sticky" aria-hidden="true"></i>
            <span id="c360-note-title">Add Contact Note</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseNote"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <EditForm Model="_noteForm" OnValidSubmit="SaveNoteAsync" OnInvalidSubmit="NotifyValidationAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="um-field um-field--full">
                        <label>Note Text <span class="text-danger">*</span></label>
                        <InputTextArea @bind-Value="_noteForm.Text" class="um-input" rows="5" />
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CloseNote">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi bi-check-lg" aria-hidden="true"></i> Save Note</button>
            </div>
        </EditForm>
        </div>
    </div>
}

@if (_showDelete)
{
    <div class="c360-modal-backdrop" role="presentation" @onclick="() => _showDelete = false">
        <div class="c360-modal c360-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="c360-delete-title" @onclick:stopPropagation="true">
        <div class="um-confirm-dialog">
            <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash3-fill" aria-hidden="true"></i></div>
            <div id="c360-delete-title" class="um-confirm-title">Delete Contact?</div>
            <div class="um-confirm-body">You are about to delete <strong>@(_contact is null ? "this contact" : ContactPageConstants.FullName(_contact))</strong>. This action will deactivate the contact.</div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button>
                <button type="button" class="um-btn um-btn-danger" @onclick="DeleteAsync" disabled="@_saving">Delete</button>
            </div>
        </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ContactId { get; set; }

    private ContactDto? _contact;
    private ContactFormModel _form = new();
    private NoteForm _noteForm = new();
    private EnterpriseToast? _toast;
    private List<ContactTimelineItem> _timeline = [];
    private List<ContactWorkflowEventDto> _workflowEvents = [];
    private bool _loading;
    private bool _saving;
    private bool _showForm;
    private bool _showNote;
    private bool _showDelete;
    private string? _loadError;
    private int _tab;

    private string RefreshIconClass => _loading ? "bi bi-arrow-clockwise c360-spin" : "bi bi-arrow-clockwise";

    private IEnumerable<ContactTimelineItem> TimelineItems => _workflowEvents.Count == 0
        ? _timeline.OrderByDescending(x => x.DateUtc)
        : _workflowEvents.Select(ContactTimelineItemFromWorkflow).OrderByDescending(x => x.DateUtc);

    private string LastWorkflowDateText => _workflowEvents.OrderByDescending(e => e.EventDateUtc).FirstOrDefault()?.EventDateUtc.ToLocalTime().ToString("g") ?? "Not synced";

    protected override async Task OnParametersSetAsync()
    {
        Breadcrumbs.SetCrumbs(new("Contacts", "/client/contacts"), new("Contact 360"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _contact = null;

        try
        {
            _contact = await Api.GetContactByIdAsync(ContactId);
            if (_contact is not null)
            {
                _timeline = ContactPageData.BuildTimeline(_contact);
                _workflowEvents = (await Api.GetContactWorkflowEventsAsync(ContactId))?.ToList() ?? [];
                Breadcrumbs.SetCrumbs(new("Contacts", "/client/contacts"), new(ContactPageConstants.FullName(_contact), $"/client/contacts/{ContactId}"));
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load contact: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenEdit()
    {
        if (_contact is null)
            return;

        _form = new()
        {
            AccountId = _contact.AccountId,
            FirstName = _contact.FirstName,
            LastName = _contact.LastName,
            Email = _contact.Email,
            Phone = _contact.Phone,
            JobTitle = _contact.JobTitle,
            ContactTypeCode = _contact.ContactTypeCode,
            PreferredContactMethod = _contact.PreferredContactMethod,
            StatusCode = _contact.StatusCode,
            IsBillingContact = _contact.IsBillingContact,
            IsServiceContact = _contact.IsServiceContact,
            IsPortalUser = _contact.IsPortalUser,
            IsKeyContact = _contact.IsKeyContact
        };
        _showForm = true;
    }

    private void CloseEdit() => _showForm = false;

    private async Task SaveAsync()
    {
        if (_contact is null)
            return;

        _saving = true;
        try
        {
            await Api.UpdateContactAsync(ContactId, new UpdateContactRequest
            {
                FirstName = _form.FirstName.Trim(),
                LastName = _form.LastName.Trim(),
                Email = ContactPageConstants.Normalize(_form.Email),
                Phone = ContactPageConstants.Normalize(_form.Phone),
                JobTitle = ContactPageConstants.Normalize(_form.JobTitle),
                ContactTypeCode = _form.ContactTypeCode,
                IsBillingContact = _form.IsBillingContact,
                IsServiceContact = _form.IsServiceContact,
                IsPortalUser = _form.IsPortalUser,
                IsKeyContact = _form.IsKeyContact,
                PreferredContactMethod = ContactPageConstants.Normalize(_form.PreferredContactMethod),
                StatusCode = _form.StatusCode
            });
            await CreateWorkflowEventAsync("Profile", "Contact profile updated", "Contact master profile, role flags, and communication preferences were updated from Contact 360.", "Contact", ContactId);
            _showForm = false;
            await ShowToast("Contact saved.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowToast($"Save failed: {ex.Message}", "enterprise-toast-danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task NotifyValidationAsync()
    {
        await ShowToast("Please correct the highlighted fields before continuing.", "enterprise-toast-danger");
    }

    private void OpenNote()
    {
        _noteForm = new();
        _showNote = true;
    }

    private void CloseNote()
    {
        _showNote = false;
        _noteForm = new();
    }

    private async Task SaveNoteAsync()
    {
        if (_contact is null)
            return;

        await CreateWorkflowEventAsync("Note", "Contact note added", _noteForm.Text.Trim(), "Contact", ContactId);
        CloseNote();
        await ShowToast("Note saved.");
        await LoadAsync();
    }

    private async Task SendPortalInviteAsync()
    {
        if (_contact is null)
            return;

        if (!_contact.IsPortalUser)
        {
            var form = new ContactFormModel
            {
                AccountId = _contact.AccountId,
                FirstName = _contact.FirstName,
                LastName = _contact.LastName,
                Email = _contact.Email,
                Phone = _contact.Phone,
                JobTitle = _contact.JobTitle,
                ContactTypeCode = _contact.ContactTypeCode,
                PreferredContactMethod = _contact.PreferredContactMethod,
                StatusCode = _contact.StatusCode,
                IsBillingContact = _contact.IsBillingContact,
                IsServiceContact = _contact.IsServiceContact,
                IsPortalUser = true,
                IsKeyContact = _contact.IsKeyContact
            };
            await Api.UpdateContactAsync(ContactId, new UpdateContactRequest
            {
                FirstName = form.FirstName.Trim(),
                LastName = form.LastName.Trim(),
                Email = ContactPageConstants.Normalize(form.Email),
                Phone = ContactPageConstants.Normalize(form.Phone),
                JobTitle = ContactPageConstants.Normalize(form.JobTitle),
                ContactTypeCode = form.ContactTypeCode,
                IsBillingContact = form.IsBillingContact,
                IsServiceContact = form.IsServiceContact,
                IsPortalUser = form.IsPortalUser,
                IsKeyContact = form.IsKeyContact,
                PreferredContactMethod = ContactPageConstants.Normalize(form.PreferredContactMethod),
                StatusCode = form.StatusCode
            });
        }

        await CreateWorkflowEventAsync("Portal", "Portal invite prepared", $"Portal invitation was prepared for {ContactPageConstants.FullName(_contact)} and portal readiness was synchronized.", "Contact", ContactId);
        await ShowToast("Portal invite prepared.");
        await LoadAsync();
    }

    private async Task SyncWorkflowAsync()
    {
        if (_contact is null)
            return;

        await CreateWorkflowEventAsync("Workflow", "Contact workflow synchronized", $"Contact role flags and account relationship were synchronized for {_contact.AccountName ?? "the related account"}.", "Account", _contact.AccountId);
        await ShowToast("Contact workflow synchronized.");
        await LoadAsync();
    }

    private void ConfirmDelete() => _showDelete = true;

    private async Task DeleteAsync()
    {
        if (_contact is null)
            return;

        _saving = true;
        try
        {
            await Api.DeleteContactAsync(ContactId);
            _showDelete = false;
            await ShowToast("Contact deleted.");
            Nav.NavigateTo("/client/contacts");
        }
        catch (Exception ex)
        {
            await ShowToast($"Delete failed: {ex.Message}", "enterprise-toast-danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ShowToast(string message, string css = "enterprise-toast-success")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new() { Content = message, CssClass = css });
    }

    private static int RoleCount(ContactDto c)
        => (c.IsKeyContact ? 1 : 0) + (c.IsBillingContact ? 1 : 0) + (c.IsServiceContact ? 1 : 0) + (c.IsPortalUser ? 1 : 0);

    private async Task CreateWorkflowEventAsync(string type, string title, string detail, string? relatedEntityName, Guid? relatedEntityId)
    {
        if (_contact is null)
            return;

        await Api.CreateContactWorkflowEventAsync(ContactId, new CreateContactWorkflowEventRequest
        {
            TenantId = _contact.TenantId,
            ContactId = ContactId,
            EventType = type,
            EventTitle = title,
            EventDetail = detail,
            RelatedEntityName = relatedEntityName,
            RelatedEntityId = relatedEntityId,
            EventDateUtc = DateTime.UtcNow
        });
    }

    private static ContactTimelineItem ContactTimelineItemFromWorkflow(ContactWorkflowEventDto item) => new(
        item.EventType,
        item.EventTitle,
        item.EventDetail ?? string.Empty,
        item.EventDateUtc,
        item.EventType switch
        {
            "Portal" => "bi-send",
            "Workflow" => "bi-diagram-3",
            "Profile" => "bi-person-check",
            "Note" => "bi-sticky",
            _ => "bi-lightning"
        },
        item.EventType switch
        {
            "Portal" or "Workflow" or "Profile" => "success",
            "Note" => "info",
            _ => "warning"
        });

    private static string TimelineTone(string tone) => tone switch
    {
        "success" => "a360-tl-ic--email",
        "warning" => "a360-tl-ic--meeting",
        _ => "a360-tl-ic--other"
    };

    private void SetTab(int tab) => _tab = tab;

    private static string TabId(int tab) => $"c360-tab-{tab}";

    private string TabButtonClass(int tab) => $"c360-tab-button {(_tab == tab ? "c360-tab-button--active" : string.Empty)}";

    private RenderFragment KpiCard(string label, string value, string icon, string tone, int tab) => __builder =>
    {
        <button type="button" class="@KpiCardClass(tone, tab)" @onclick="() => SetTab(tab)">
            <span class="c360-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span>
            <span><span class="c360-kpi-value">@value</span><span class="c360-kpi-label">@label</span></span>
        </button>;
    };

    private string KpiCardClass(string tone, int tab) => $"c360-kpi-card c360-kpi-{tone} {(_tab == tab ? "c360-kpi-active" : string.Empty)}";

    private static RenderFragment Field(string label, string? value) => __builder =>
    {
        <div class="a360-field-group"><span class="a360-field-lbl">@label</span><span class="a360-field-val">@(string.IsNullOrWhiteSpace(value) ? "-" : value)</span></div>;
    };

    private static RenderFragment RoleRow(string label, bool enabled, string icon) => __builder =>
    {
        <div class="a360-rm-row"><i class="bi @icon a360-rm-icon" aria-hidden="true"></i><span class="a360-rm-lbl">@label</span><span class="a360-rm-val">@(enabled ? "Yes" : "No")</span></div>;
    };

    private static RenderFragment Metric(string label, string value, string icon) => __builder =>
    {
        <div class="a360-rm-row"><i class="bi @icon a360-rm-icon" aria-hidden="true"></i><span class="a360-rm-lbl">@label</span><span class="a360-rm-val">@value</span></div>;
    };

    private sealed class NoteForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(4000, ErrorMessage = "Note text cannot exceed 4,000 characters.")]
        public string Text { get; set; } = string.Empty;
    }
}
