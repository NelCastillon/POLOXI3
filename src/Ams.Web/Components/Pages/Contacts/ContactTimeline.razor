@page "/client/contacts/{ContactId:guid}/timeline"
@namespace Ams.Web.Components.Pages.Contacts
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Contact Timeline — Tenant Admin</PageTitle>

<AppPageHeader Title="Contact Timeline" Subtitle="Tenant Admin chronology for contact activity, role, and portal events" Icon="bi-timeline"><Actions><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo($"/client/contacts/{ContactId}")'><i class="bi bi-person-circle"></i> Contact 360</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>

<section class="ma-hero contact-hero"><div><span class="ma-eyebrow">Tenant Admin · Contact Intelligence</span><h2>@(_contact is null ? "Contact" : ContactPageConstants.FullName(_contact)) Timeline</h2><p>Track contact creation, role updates, service touchpoints, and portal readiness.</p></div></section>

<div class="ma-filter-bar contact-filter-bar"><div class="ma-search-wrap"><i class="bi bi-search"></i><input class="ma-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search timeline…" /></div><button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button><span class="ma-filter-count">@Filtered.Count() events</span></div>
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }
@if (_loading) { <div class="mt-loading"><div class="um-spinner"></div><span>Loading timeline…</span></div> }
<div class="ma-content acct-timeline-card"><div class="ma-feed">@foreach (var group in Filtered.GroupBy(x => x.DateUtc.Date).OrderByDescending(x => x.Key)) { <div class="ma-date-sep"><span>@group.Key.ToString("MMM d, yyyy")</span></div>@foreach (var item in group.OrderByDescending(x => x.DateUtc)) { <div class="ma-feed-item"><div class="ma-feed-icon acct-tone-@item.Tone"><i class="bi @item.Icon"></i></div><div class="ma-feed-body"><div class="ma-feed-hdr"><span class="ma-feed-acct">@item.Title</span><span class="ma-type-chip acct-tone-@item.Tone">@item.Type</span></div><div class="ma-feed-notes">@item.Description</div><div class="ma-feed-meta"><span><i class="bi bi-clock"></i> @item.DateUtc.ToLocalTime().ToString("h:mm tt")</span></div></div></div> } } @if (!Filtered.Any()) { <div class="ma-empty"><i class="bi bi-timeline ma-empty-icon"></i><span>No contact timeline events match your filters.</span></div> }</div></div>

@code { [Parameter] public Guid ContactId { get; set; } ContactDto? _contact; List<ContactTimelineItem> _events = []; string _search = string.Empty; string? _loadError; bool _loading; IEnumerable<ContactTimelineItem> Filtered => _events.Where(x => string.IsNullOrWhiteSpace(_search) || x.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Type.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Description.Contains(_search, StringComparison.OrdinalIgnoreCase)); protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Contacts", "/client/contacts"), new("Timeline")); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { _contact = await Api.GetContactByIdAsync(ContactId); if (_contact is not null) { _events = ContactPageData.BuildTimeline(_contact); Breadcrumbs.SetCrumbs(new("Contacts", "/client/contacts"), new(ContactPageConstants.FullName(_contact), $"/client/contacts/{ContactId}"), new("Timeline")); } } catch (Exception ex) { _loadError = $"Failed to load contact timeline: {ex.Message}"; } finally { _loading = false; } } void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _search = e.Value?.ToString() ?? string.Empty; void ResetFilters() => _search = string.Empty; }
