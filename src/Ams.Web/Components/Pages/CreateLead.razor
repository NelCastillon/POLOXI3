@page "/crm/leads/new"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Navigation

<PageTitle>Create Lead</PageTitle>

<AppPageHeader Title="Create Lead" Icon="bi-funnel" />

<EnterpriseToast @ref="_toast" />

<div class="form-shell">
    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="form-grid">
            <div>
                <label>Lead Number</label>
                <InputText class="form-control" @bind-Value="_model.LeadNumber" />
            </div>
            <div>
                <label>Account Name</label>
                <InputText class="form-control" @bind-Value="_model.AccountName" />
            </div>
            <div>
                <label>First Name</label>
                <InputText class="form-control" @bind-Value="_model.FirstName" />
            </div>
            <div>
                <label>Last Name</label>
                <InputText class="form-control" @bind-Value="_model.LastName" />
            </div>
            <div>
                <label>Email</label>
                <InputText class="form-control" @bind-Value="_model.Email" />
            </div>
            <div>
                <label>Phone</label>
                <InputText type="tel" class="form-control" placeholder="(555) 123-4567" inputmode="tel" autocomplete="tel" @bind-Value="_model.Phone" />
                <small class="text-muted">Use enterprise phone format: (555) 123-4567 or +1 555 123 4567 x123.</small>
            </div>
            <div class="span-2">
                <label>Interested Service</label>
                <InputText class="form-control" @bind-Value="_model.InterestedService" />
            </div>
        </div>

        <div class="mt-3">
            <SfButton CssClass="e-primary" Type="Submit">Save Lead</SfButton>
            <SfButton CssClass="e-flat" OnClick="BackAsync">Cancel</SfButton>
        </div>
    </EditForm>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private EnterpriseToast? _toast;
    private CreateLeadRequest _model = new()
    {
        TenantId = DefaultTenantId,
        LeadNumber = $"LD-{DateTime.UtcNow:yyyyMMddHHmmss}",
        FirstName = "New",
        LastName = "Lead"
    };

    private async Task SaveAsync()
    {
        var id = await Api.CreateLeadAsync(_model);
        if (_toast is not null)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Saved", Content = $"Lead created: {id}", CssClass = "e-toast-success" });
        }
    }

    private Task BackAsync()
    {
        Navigation.NavigateTo("/crm/leads");
        return Task.CompletedTask;
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
