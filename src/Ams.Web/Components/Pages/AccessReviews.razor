@page "/iam/access-reviews"
@inject ApiClient Api

<PageTitle>Access Reviews</PageTitle>
<h1>Access Reviews &amp; SoD Rules</h1>

<h4 class="mt-3">Segregation of Duty Rules</h4>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search SoD rules..." @bind-Value="_sodSearchTerm" Width="280px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_sodItems is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_sodItems" AllowPaging="true" AllowSorting="true" Height="250px">
    <GridPageSettings PageSize="5"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(SegregationOfDutyRuleDto.RuleCode)"     HeaderText="Code"        Width="180"></GridColumn>
        <GridColumn Field="@nameof(SegregationOfDutyRuleDto.RuleName)"     HeaderText="Rule"        Width="240"></GridColumn>
        <GridColumn Field="@nameof(SegregationOfDutyRuleDto.RoleAName)"    HeaderText="Role A"      Width="160"></GridColumn>
        <GridColumn Field="@nameof(SegregationOfDutyRuleDto.RoleBName)"    HeaderText="Role B"      Width="160"></GridColumn>
        <GridColumn Field="@nameof(SegregationOfDutyRuleDto.SeverityCode)" HeaderText="Severity"    Width="100"></GridColumn>
        <GridColumn Field="@nameof(SegregationOfDutyRuleDto.IsActive)"     HeaderText="Active"      Width="80" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(SegregationOfDutyRuleDto.IsSystemDefined)" HeaderText="System"   Width="80" DisplayAsCheckBox="true"></GridColumn>
    </GridColumns>
</SfGrid>
}

<h4 class="mt-4">User Access Reviews</h4>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search reviews..." @bind-Value="_reviewSearchTerm" Width="280px"></SfTextBox>
</div>
@if (_reviewItems is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_reviewItems" AllowPaging="true" AllowSorting="true" Height="250px">
    <GridPageSettings PageSize="5"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(UserAccessReviewDto.SubjectFullName)"  HeaderText="Subject"      Width="170"></GridColumn>
        <GridColumn Field="@nameof(UserAccessReviewDto.RoleName)"         HeaderText="Role"         Width="160"></GridColumn>
        <GridColumn Field="@nameof(UserAccessReviewDto.ReviewerFullName)" HeaderText="Reviewer"     Width="160"></GridColumn>
        <GridColumn Field="@nameof(UserAccessReviewDto.ReviewCycleCode)"  HeaderText="Cycle"        Width="100"></GridColumn>
        <GridColumn Field="@nameof(UserAccessReviewDto.DecisionCode)"     HeaderText="Decision"     Width="110"></GridColumn>
        <GridColumn Field="@nameof(UserAccessReviewDto.StatusCode)"       HeaderText="Status"       Width="100"></GridColumn>
        <GridColumn Field="@nameof(UserAccessReviewDto.DueByDateUtc)"     HeaderText="Due"          Width="130" Type="ColumnType.DateTime" Format="MM/dd/yyyy"></GridColumn>
        <GridColumn Field="@nameof(UserAccessReviewDto.ReviewedDateUtc)"  HeaderText="Reviewed"     Width="130" Type="ColumnType.DateTime" Format="MM/dd/yyyy"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private static readonly Guid DefaultTenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _sodSearchTerm;
    private string? _reviewSearchTerm;
    private List<SegregationOfDutyRuleDto>? _sodItems;
    private List<UserAccessReviewDto>? _reviewItems;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var sodResult = await Api.SearchSodRulesAsync(DefaultTenantId, pageSize: 200);
        _sodItems = sodResult?.Items.ToList() ?? [];
        var reviewResult = await Api.SearchAccessReviewsAsync(DefaultTenantId, _reviewSearchTerm);
        _reviewItems = reviewResult?.Items.ToList() ?? [];
    }
}
