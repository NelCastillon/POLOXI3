    static string LogIcon(string ev)    => ev switch { "sent" => "bi-send", "open" => "bi-envelope-open", "response" => "bi-reply", "renewed" => "bi-check-circle", "scheduled" => "bi-calendar-check", _ => "bi-info-circle" };
