    static Campaign MakeCampaign(string name, string type, string channel, string status,
        string lob, string risk, string expiry, string producer, string subject,
        int recip, int sent, int opened, int responded, int renewed, DateTime? scheduled)
    {
        var log = sent > 0 ? new List<LogEntry>
        {
            new(){ Timestamp=scheduled?.AddHours(-1) ?? DateTime.Today.AddDays(-2), EventType="scheduled", Message="Campaign scheduled and audience locked.", Recipient="" },
            new(){ Timestamp=scheduled ?? DateTime.Today.AddDays(-1),               EventType="sent",      Message=$"{sent} messages dispatched via {channel}.", Recipient="" },
            new(){ Timestamp=scheduled?.AddHours(2) ?? DateTime.Today,              EventType="open",      Message=$"{opened} recipients opened the message.",  Recipient="" },
            new(){ Timestamp=scheduled?.AddHours(8) ?? DateTime.Today.AddHours(6),  EventType="response",  Message=$"{responded} recipients responded.",          Recipient="" },
            new(){ Timestamp=scheduled?.AddDays(1)  ?? DateTime.Today.AddDays(1),   EventType="renewed",   Message=$"{renewed} policies attributed to this campaign.", Recipient="" },
        } : new List<LogEntry>
        {
            new(){ Timestamp=DateTime.Today.AddDays(-1), EventType="created", Message="Campaign created as draft.", Recipient="" },
        };
        return new Campaign
        {
            Id=Guid.NewGuid(), Name=name, Type=type, Channel=channel, Status=status,
            LobFilter=lob, RiskTier=risk, ExpiryWindowLabel=expiry, ProducerFilter=producer,
            Subject=subject, ScheduledDate=scheduled, Recipients=recip, Sent=sent,
            Opened=opened, Responded=responded, Renewed=renewed, Log=log
        };
    }

    void OpenCreate()
    {
        _editCampaign = new Campaign { Id=Guid.Empty, Status="Draft", Channel="Email", Type="Renewal Notice" };
        _showCampaignDialog = true;
    }

    void OpenEdit(Campaign c)
    {
        _editCampaign = new Campaign
        {
            Id=c.Id, Name=c.Name, Type=c.Type, Channel=c.Channel, Status=c.Status,
            LobFilter=c.LobFilter, RiskTier=c.RiskTier, ExpiryWindowLabel=c.ExpiryWindowLabel,
            ProducerFilter=c.ProducerFilter, Subject=c.Subject, BodyPreview=c.BodyPreview,
            ScheduledDate=c.ScheduledDate, Recipients=c.Recipients, Sent=c.Sent,
            Opened=c.Opened, Responded=c.Responded, Renewed=c.Renewed, Log=c.Log
        };
        _showCampaignDialog = true;
    }

    async Task SaveCampaign()
    {
        if (_editCampaign is null || string.IsNullOrWhiteSpace(_editCampaign.Name)) return;
        if (_editCampaign.Id == Guid.Empty)
        {
            _editCampaign.Id = Guid.NewGuid();
            _campaigns.Add(_editCampaign);
        }
        else
        {
            var idx = _campaigns.FindIndex(c => c.Id == _editCampaign.Id);
            if (idx >= 0) _campaigns[idx] = _editCampaign;
        }
        _showCampaignDialog = false;
        await _toast.ShowAsync(new ToastModel { Title="Campaign Saved", Content=$"\"{_editCampaign.Name}\" saved.", CssClass="e-toast-success" });
    }

    void OpenDetail(Campaign c) { _detailCampaign = c; _showDetailDialog = true; }

    async Task ActivateCampaign(Campaign c)
    {
        c.Status = "Active";
        c.Sent   = c.Recipients;
        await _toast.ShowAsync(new ToastModel { Title="Campaign Sent", Content=$"\"{c.Name}\" activated and dispatched.", CssClass="e-toast-success" });
    }

    async Task PauseCampaign(Campaign c)
    {
        c.Status = "Paused";
        await _toast.ShowAsync(new ToastModel { Title="Campaign Paused", Content=$"\"{c.Name}\" has been paused.", CssClass="e-toast-info" });
    }

    void ResetFilters() { _search=""; _typeFilter=""; _statusFilter=""; }
    void Refresh() => BuildStub();

    async Task ExportAsync() =>
        await _toast.ShowAsync(new ToastModel { Title="Exported", Content="Campaigns exported.", CssClass="e-toast-success" });

