    private async Task SaveCertificateAsync(string status, string toastTitle, string toastContent)
    {
        if (string.IsNullOrWhiteSpace(_issForm.PolicyNo) || string.IsNullOrWhiteSpace(_issForm.Account) || string.IsNullOrWhiteSpace(_issForm.HolderName) || string.IsNullOrWhiteSpace(_issForm.Lob))
        {
            await _toast.ShowAsync(new ToastModel { Title = "Required fields", Content = "Policy number, account, holder, and line of business are required.", CssClass = "enterprise-toast-warning" });
            return;
        }

        try
        {
            var existingHolder = _issForm.CertificateHolderId.HasValue
                ? HolderOptions.FirstOrDefault(holder => holder.CertificateHolderId == _issForm.CertificateHolderId.Value)
                : null;
            var holderCode = existingHolder?.HolderCode ?? $"H-{Guid.NewGuid():N}"[..14].ToUpperInvariant();
            var defaultDelivery = (_workspace?.Options ?? []).FirstOrDefault(option => option.OptionGroupCode == "DeliveryMethod" && option.IsDefault && option.IsActive)
                ?? (_workspace?.Options ?? []).FirstOrDefault(option => option.OptionGroupCode == "DeliveryMethod" && option.IsActive);
            var holderId = await Api.UpsertCertificateHolderAsync(new UpsertCertificateHolderRequest(
                _tenantId,
                _issForm.CertificateHolderId,
                holderCode,
                _issForm.HolderName.Trim(),
                string.IsNullOrWhiteSpace(_issForm.HolderAddress) ? null : _issForm.HolderAddress.Trim(),
                null,
                null,
                null,
                null,
                null,
                existingHolder?.ContactName,
                existingHolder?.EmailAddress,
                existingHolder?.PhoneNumber,
                existingHolder?.PreferredDeliveryMethodCode ?? defaultDelivery?.OptionCode,
                string.IsNullOrWhiteSpace(_issForm.Description) ? null : _issForm.Description.Trim(),
                _issForm.AdditionalInsured,
                _issForm.WaiverSubrogation,
                _issForm.PrimaryNonContributory,
                true,
                _userId));
            _issForm.CertificateHolderId = holderId;

            Guid id;
            if (_editingCertificateId is { } editingId)
            {
                var request = new UpdatePolicyCertificateRequest(
                    _tenantId,
                    _editingPolicyId,
                    _issForm.PolicyNo.Trim(),
                    _issForm.Account.Trim(),
                    _issForm.HolderName.Trim(),
                    _issForm.HolderAddress.Trim(),
                    _issForm.CertType,
                    _issForm.IssuedDate,
                    _issForm.ExpDate,
                    _issForm.Lob.Trim(),
                    _userId?.ToString("D") ?? string.Empty,
                    status,
                    _issForm.AdditionalInsured,
                    _issForm.WaiverSubrogation,
                    _issForm.Description.Trim(),
                    holderId,
                    _issForm.PrimaryNonContributory,
                    string.IsNullOrWhiteSpace(_issForm.Description) ? null : _issForm.Description.Trim(),
                    _userId);
                await Api.UpdatePolicyCertificateAsync(editingId, request);
                id = editingId;
            }
            else
            {
                var request = new CreatePolicyCertificateRequest(
                    _tenantId,
                    null,
                    _issForm.PolicyNo.Trim(),
                    _issForm.Account.Trim(),
                    _issForm.HolderName.Trim(),
                    _issForm.HolderAddress.Trim(),
                    _issForm.CertType,
                    _issForm.IssuedDate,
                    _issForm.ExpDate,
                    _issForm.Lob.Trim(),
                    _userId?.ToString("D") ?? string.Empty,
                    status,
                    _issForm.AdditionalInsured,
                    _issForm.WaiverSubrogation,
                    _issForm.Description.Trim(),
                    holderId,
                    _issForm.PrimaryNonContributory,
                    string.IsNullOrWhiteSpace(_issForm.Description) ? null : _issForm.Description.Trim(),
                    _userId);
                id = await Api.CreatePolicyCertificateAsync(request);
            }

            _showIssue = false;
            _editingCertificateId = null;
            _editingPolicyId = null;
            _issForm = NewIssueForm();
            await LoadWorkspaceAsync();
            await LoadCertificatesAsync();
            _selected = _rows.FirstOrDefault(r => r.CertificateId == id) ?? _rows.FirstOrDefault();
            await LoadSelectedWorkflowAsync();
            await _toast.ShowAsync(new ToastModel { Title = toastTitle, Content = toastContent, CssClass = "enterprise-toast-success" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Save failed", Content = $"Save failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
        }
    }

    private async Task DownloadAsync(CertRow row)
    {
        try
        {
            var template = FindTemplate(row)
                ?? throw new InvalidOperationException("No active certificate template is configured for this tenant.");
            var mergeJson = JsonSerializer.Serialize(new
            {
                DocumentTitle = template.TemplateName,
                row.CertNo,
                PolicyNumber = row.PolicyNo,
                AccountName = row.Account,
                row.HolderName,
                row.HolderAddress,
                CertificateType = row.CertType,
                EffectiveDate = row.IssuedDate.ToString("yyyy-MM-dd"),
                ExpirationDate = row.ExpDate.ToString("yyyy-MM-dd"),
                LineOfBusiness = row.Lob,
                row.AdditionalInsured,
                WaiverOfSubrogation = row.WaiverSubrogation,
                row.PrimaryNonContributory,
                Body = row.Description
            });
            var generated = await Api.GenerateCertificateDocumentAsync(row.CertificateId, new GenerateCertificateDocumentRequest(_tenantId, row.CertificateId, template.DocumentTemplateDefinitionId, null, mergeJson, "Generated from Certificates Hub.", _userId));
            await JS.InvokeVoidAsync("amsDownload.downloadBase64", $"{row.CertNo}.html", generated.ContentType, Convert.ToBase64String(generated.Content));
            await LoadCertificatesAsync(preserveSelection: true);
            await _toast.ShowAsync(new ToastModel { Title = "Document generated", Content = $"A versioned document was generated for {row.CertNo}.", CssClass = "enterprise-toast-success" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Generation failed", Content = ex.Message, CssClass = "enterprise-toast-danger" });
        }
    }
    private async Task EmailAsync(CertRow row)
    {
        try
        {
            var holder = HolderOptions.FirstOrDefault(item => item.CertificateHolderId == row.CertificateHolderId)
                ?? throw new InvalidOperationException("The certificate is not linked to an active certificate holder.");
            var generatedVersionId = await Api.GetLatestGeneratedCertificateDocumentVersionIdAsync(_tenantId, row.CertificateId)
                ?? throw new InvalidOperationException("Generate a document version before queueing delivery.");
            var method = (_workspace?.Options ?? []).FirstOrDefault(option => option.OptionGroupCode == "DeliveryMethod" && option.OptionCode == holder.PreferredDeliveryMethodCode && option.IsActive)
                ?? (_workspace?.Options ?? []).FirstOrDefault(option => option.OptionGroupCode == "DeliveryMethod" && option.IsDefault && option.IsActive)
                ?? throw new InvalidOperationException("No active delivery method is configured for this tenant.");
            var recipient = method.OptionCode == "Email" ? holder.EmailAddress : holder.AddressLine1;
            if (string.IsNullOrWhiteSpace(recipient)) throw new InvalidOperationException($"{holder.LegalName} does not have a destination configured for {method.DisplayName}.");
            await Api.QueueCertificateDeliveryAsync(row.CertificateId, new QueueCertificateDeliveryRequest(_tenantId, row.CertificateId, generatedVersionId, method.OptionCode, holder.LegalName, recipient, _userId));
            await LoadSelectedWorkflowAsync();
            await _toast.ShowAsync(new ToastModel { Title = "Email queued", Content = $"{row.CertNo} queued for {row.HolderName}.", CssClass = "enterprise-toast-success" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Email failed", Content = $"Email failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
        }
    }
    private async Task ExportVisibleAsync()
    {
        if (Filtered.Count == 0)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Nothing to export", Content = "No visible certificate records are available.", CssClass = "enterprise-toast-warning" });
            return;
        }

        var rows = new List<string> { "Certificate,Policy,Account,Holder,HolderAddress,Form,Issued,Expires,LineOfBusiness,IssuedBy,Status,AdditionalInsured,WaiverOfSubrogation,PrimaryNonContributory" };
        rows.AddRange(Filtered.Select(row => string.Join(',',
            Csv(row.CertNo), Csv(row.PolicyNo), Csv(row.Account), Csv(row.HolderName), Csv(row.HolderAddress), Csv(row.CertType),
            Csv(row.IssuedDate.ToString("yyyy-MM-dd")), Csv(row.ExpDate.ToString("yyyy-MM-dd")), Csv(row.Lob), Csv(row.IssuedBy), Csv(row.Status),
            row.AdditionalInsured, row.WaiverSubrogation, row.PrimaryNonContributory)));
        var bytes = System.Text.Encoding.UTF8.GetBytes(string.Join(Environment.NewLine, rows));
        await JS.InvokeVoidAsync("amsDownload.downloadBase64", $"certificates-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
        await _toast.ShowAsync(new ToastModel { Title = "Export complete", Content = $"Exported {Filtered.Count} visible certificate row(s).", CssClass = "enterprise-toast-success" });
    }

    private void ConfirmRevoke(CertRow row)
    {
        _revokeTarget = row;
        _revokeReason = string.Empty;
        _showRevokeConfirm = true;
    }

    private void CancelRevoke()
    {
        _showRevokeConfirm = false;
        _revokeTarget = null;
        _revokeReason = null;
    }

    private async Task ExecuteRevokeAsync()
    {
        if (_revokeTarget is null)
        {
            return;
        }

        try
        {
            await Api.RevokePolicyCertificateAsync(_revokeTarget.CertificateId, new RevokePolicyCertificateRequest(_tenantId, _userId, _revokeReason));
            _showRevokeConfirm = false;
            await LoadCertificatesAsync(preserveSelection: true);
            await _toast.ShowAsync(new ToastModel { Title = "Certificate revoked", Content = $"{_revokeTarget.CertNo} was revoked in the database.", CssClass = "enterprise-toast-warning" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Revoke failed", Content = $"Revoke failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
        }
        finally
        {
            _revokeTarget = null;
            _revokeReason = null;
        }
    }

