@page "/policies/certificates"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.PolicyCertificates
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Certificates Hub - AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="3500" NewestOnTop="true" />

<div class="ch-enterprise-page">
    <section class="ch-hero">
        <div class="ch-hero-icon"><i class="bi bi-award" aria-hidden="true"></i></div>
        <div class="ch-hero-main">
            <span class="ch-eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> Policy servicing workspace</span>
            <h1>Certificates Hub</h1>
            <p>Issue, track, renew, revoke, and deliver ACORD certificates with one enterprise-native certificate register.</p>
            @if (!string.IsNullOrWhiteSpace(Certificate))
            {
                <span class="ch-query-pill"><i class="bi bi-link-45deg" aria-hidden="true"></i> Deep link: @Certificate</span>
            }
        </div>
        <div class="ch-hero-actions">
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies")'><i class="bi bi-shield" aria-hidden="true"></i> Policies</button>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFiltersAsync"><i class="bi bi-eraser" aria-hidden="true"></i> Reset</button>
            <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenIssue"><i class="bi bi-plus-lg" aria-hidden="true"></i> Issue Certificate</button>
        </div>
    </section>

    <section class="ch-kpi-strip" aria-label="Certificate KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="ch-kpi-card @kpi.CssClass @(_activeKpi == kpi.Filter ? "ch-kpi-card--active" : null)" title="@kpi.Title" @onclick="() => ApplyKpi(kpi.Filter)">
                <span class="ch-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span><strong>@kpi.Value</strong><small>@kpi.Label</small><em>@kpi.Caption</em></span>
            </button>
        }
    </section>

    <section class="ch-command-bar" aria-label="Certificate filters">
        <div class="ch-search-wrap">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" placeholder="Search cert #, policy, account, holder, LOB, issuer..." @bind="SearchText" @bind:event="oninput" />
        </div>
        <select class="form-select ch-filter-select" @bind="StatusFilter" aria-label="Status filter">
            <option value="">All statuses</option>
            @foreach (var status in Statuses)
            {
                <option value="@status">@status</option>
            }
        </select>
        <select class="form-select ch-filter-select" @bind="TypeFilter" aria-label="Type filter">
            <option value="">All forms</option>
            @foreach (var type in _certTypes)
            {
                <option value="@type">@type</option>
            }
        </select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ExportVisibleAsync"><i class="bi bi-download" aria-hidden="true"></i> Export visible</button>
        <div class="ch-result-chip"><strong>@Filtered.Count</strong><span>@(_loading ? "Loading" : "Visible")</span></div>
    </section>

    <section class="ch-layout">
        <div class="enterprise-grid-card ch-table-card">
            <div class="sr-grid-toolbar">
                <div>
                    <strong>Certificate register</strong>
                    <span class="sr-filter-note">@Filtered.Count enterprise certificate row(s)</span>
                </div>
                <div class="tset-row-actions">
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ShowPending"><i class="bi bi-hourglass" aria-hidden="true"></i> Pending</button>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ShowExpiring"><i class="bi bi-clock" aria-hidden="true"></i> Expiring</button>
                    <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenIssue"><i class="bi bi-plus-lg" aria-hidden="true"></i> Issue</button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="sr-empty-state"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><strong>Loading certificates</strong><span>Reading the certificate register from the database.</span></div>
            }
            else if (!Filtered.Any())
            {
                <div class="sr-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No certificates found</strong><span>Clear filters or issue a new certificate.</span><button type="button" class="um-btn um-btn-primary" @onclick="ResetFiltersAsync">Show all certificates</button></div>
            }
            else
            {
                <div class="sr-table-scroll">
                    <table class="sr-table ch-table">
                        <thead>
                            <tr>
                                <th>Certificate</th>
                                <th>Policy / account</th>
                                <th>Holder</th>
                                <th>Form</th>
                                <th>Issued</th>
                                <th>Expiry</th>
                                <th>LOB</th>
                                <th>Issued by</th>
                                <th>Status</th>
                                <th class="sr-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Filtered)
                            {
                                <tr class="sr-table-row @(row.CertNo == _selected?.CertNo ? "ma-table-row--selected" : null)" @onclick="() => SelectRow(row)">
                                    <td><span class="ch-cert-link">@row.CertNo</span><small>@(row.AdditionalInsured ? "Additional insured" : "Standard holder")</small></td>
                                    <td><strong>@row.PolicyNo</strong><small>@row.Account</small></td>
                                    <td><strong>@row.HolderName</strong><small>@row.HolderAddress</small></td>
                                    <td><span class="ch-type-badge">@row.CertType</span></td>
                                    <td>@row.IssuedDate.ToString("MM/dd/yyyy")</td>
                                    <td><span class="@ExpiryClass(row)">@row.ExpDate.ToString("MM/dd/yyyy")</span></td>
                                    <td>@row.Lob</td>
                                    <td>@row.IssuedBy</td>
                                    <td><span class="ch-status ch-status-@CssToken(row.Status)">@row.Status</span></td>
                                    <td class="sr-actions-col">
                                        <button type="button" class="um-btn um-btn-primary um-btn-xs" @onclick:stopPropagation="true" @onclick="() => DownloadAsync(row)"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> PDF</button>
                                        <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => EmailAsync(row)"><i class="bi bi-envelope" aria-hidden="true"></i></button>
                                        <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenEdit(row)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                        <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => ConfirmRevoke(row)" disabled="@IsRevoked(row)"><i class="bi bi-x-circle" aria-hidden="true"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <aside class="ch-detail-panel" aria-label="Selected certificate detail">
            @if (_selected is null)
            {
                <div class="ch-side-empty"><i class="bi bi-cursor" aria-hidden="true"></i><h2>Select a certificate</h2><p>Choose a row to inspect holder, policy, form, expiry, delivery, and available servicing actions.</p></div>
            }
            else
            {
                <div class="ch-detail-head">
                    <span class="ch-eyebrow"><i class="bi bi-award" aria-hidden="true"></i> Selected certificate</span>
                    <h2>@_selected.CertNo</h2>
                    <span class="ch-status ch-status-@CssToken(_selected.Status)">@_selected.Status</span>
                </div>
                <div class="ch-detail-list">
                    <div><span>Policy</span><strong>@_selected.PolicyNo</strong></div>
                    <div><span>Account</span><strong>@_selected.Account</strong></div>
                    <div><span>Holder</span><strong>@_selected.HolderName</strong></div>
                    <div><span>Form</span><strong>@_selected.CertType</strong></div>
                    <div><span>Expires</span><strong>@_selected.ExpDate.ToString("MM/dd/yyyy")</strong></div>
                    <div><span>Issued by</span><strong>@_selected.IssuedBy</strong></div>
                </div>
                <div class="ch-coverage-card">
                    <strong><i class="bi bi-card-text" aria-hidden="true"></i> Description of operations</strong>
                    <p>@_selected.Description</p>
                    <div class="ch-flag-row">
                        <span class="@(_selected.AdditionalInsured ? "ch-flag-on" : "ch-flag-off")"><i class="bi bi-person-plus" aria-hidden="true"></i> Additional insured</span>
                        <span class="@(_selected.WaiverSubrogation ? "ch-flag-on" : "ch-flag-off")"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Waiver</span>
                    </div>
                </div>
                <div class="ch-detail-actions">
                    <button type="button" class="um-btn um-btn-primary" @onclick="() => DownloadAsync(_selected)"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Download PDF</button>
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => EmailAsync(_selected)"><i class="bi bi-envelope" aria-hidden="true"></i> Email holder</button>
                    <button type="button" class="um-btn um-btn-ghost" @onclick="OpenSelectedPolicy"><i class="bi bi-shield" aria-hidden="true"></i> View policy</button>
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                    @if (IsRevoked(_selected))
                    {
                        <button type="button" class="um-btn um-btn-secondary" @onclick="() => RestoreAsync(_selected)"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Restore</button>
                    }
                    else
                    {
                        <button type="button" class="um-btn um-btn-danger" @onclick="() => ConfirmRevoke(_selected)"><i class="bi bi-x-circle" aria-hidden="true"></i> Revoke</button>
                    }
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfirmDelete(_selected)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                </div>
            }
        </aside>
    </section>
</div>

@if (_showIssue)
{
    <div class="ch-modal-backdrop" role="presentation" @onclick="CloseIssue">
        <div class="ch-modal" role="dialog" aria-modal="true" aria-labelledby="issueCertTitle" @onclick:stopPropagation="true">
            <div class="ch-modal-header">
                <div><span class="ch-eyebrow"><i class="bi bi-plus-circle" aria-hidden="true"></i> Certificate issuance</span><h2 id="issueCertTitle">@(_editingCertificateId is null ? "Issue Certificate" : "Edit Certificate")</h2></div>
                <button type="button" class="ch-modal-close" @onclick="CloseIssue" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="ch-dlg-fields">
                <label class="ch-dlg-field">Policy Number <span class="ch-req">*</span><input class="form-control" @bind="_issForm.PolicyNo" placeholder="POL-2025-..." /></label>
                <label class="ch-dlg-field">Account Name <span class="ch-req">*</span><input class="form-control" @bind="_issForm.Account" placeholder="Account name" /></label>
                <label class="ch-dlg-field">Certificate Form<select class="form-select" @bind="_issForm.CertType">@foreach (var type in _certTypes){<option value="@type">@type</option>}</select></label>
                <label class="ch-dlg-field">Line of Business <span class="ch-req">*</span><input class="form-control" @bind="_issForm.Lob" placeholder="General Liability" /></label>
                <label class="ch-dlg-field ch-dlg-full">Certificate Holder Name <span class="ch-req">*</span><input class="form-control" @bind="_issForm.HolderName" placeholder="Legal name of certificate holder" /></label>
                <label class="ch-dlg-field ch-dlg-full">Holder Address<input class="form-control" @bind="_issForm.HolderAddress" /></label>
                <label class="ch-check-row"><input type="checkbox" @bind="_issForm.AdditionalInsured" /> Add as additional insured</label>
                <label class="ch-check-row"><input type="checkbox" @bind="_issForm.WaiverSubrogation" /> Include waiver of subrogation</label>
                <label class="ch-dlg-field">Effective Date<input class="form-control" type="date" @bind="_issForm.IssuedDate" /></label>
                <label class="ch-dlg-field">Expiry Date<input class="form-control" type="date" @bind="_issForm.ExpDate" /></label>
                <label class="ch-dlg-field ch-dlg-full">Description of Operations<textarea class="form-control" rows="3" @bind="_issForm.Description"></textarea></label>
            </div>
            <div class="ch-modal-actions">
                <button class="um-btn um-btn-ghost" @onclick="CloseIssue">Cancel</button>
                <button class="um-btn um-btn-secondary" @onclick="SaveDraftAsync">@(_editingCertificateId is null ? "Save Draft" : "Save as Pending")</button>
                <button class="um-btn um-btn-primary" @onclick="IssueCertAsync">@(_editingCertificateId is null ? "Issue" : "Save Issued")</button>
            </div>
        </div>
    </div>
}

@if (_showDeleteConfirm && _deleteTarget is not null)
{
    <div class="ch-modal-backdrop" role="presentation" @onclick="CancelDelete">
        <div class="ch-modal" role="dialog" aria-modal="true" aria-labelledby="deleteCertTitle" @onclick:stopPropagation="true">
            <div class="ch-modal-header">
                <div><span class="ch-eyebrow"><i class="bi bi-trash" aria-hidden="true"></i> Confirmation required</span><h2 id="deleteCertTitle">Delete @_deleteTarget.CertNo?</h2></div>
                <button type="button" class="ch-modal-close" @onclick="CancelDelete" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="ch-dlg-fields">
                <p class="ch-dlg-full">This will remove the certificate from the database-backed register.</p>
            </div>
            <div class="ch-modal-actions">
                <button class="um-btn um-btn-ghost" @onclick="CancelDelete">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
            </div>
        </div>
    </div>
}

@if (_showRevokeConfirm && _revokeTarget is not null)
{
    <div class="ch-modal-backdrop" role="presentation" @onclick="CancelRevoke">
        <div class="ch-modal" role="dialog" aria-modal="true" aria-labelledby="revokeCertTitle" @onclick:stopPropagation="true">
            <div class="ch-modal-header">
                <div><span class="ch-eyebrow"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Confirmation required</span><h2 id="revokeCertTitle">Revoke @_revokeTarget.CertNo?</h2></div>
                <button type="button" class="ch-modal-close" @onclick="CancelRevoke" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="ch-dlg-fields">
                <p class="ch-dlg-full">This will mark the certificate as revoked in the database. You can restore it later from this page.</p>
                <label class="ch-dlg-field ch-dlg-full">Reason<textarea class="form-control" rows="3" @bind="_revokeReason" placeholder="Optional revoke reason"></textarea></label>
            </div>
            <div class="ch-modal-actions">
                <button class="um-btn um-btn-ghost" @onclick="CancelRevoke">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ExecuteRevokeAsync"><i class="bi bi-x-circle" aria-hidden="true"></i> Revoke</button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "certificate")]
    public string? Certificate { get; set; }

    private EnterpriseToast _toast = default!;
    private string _filterStatus = string.Empty;
    private string _filterType = string.Empty;
    private string _searchTerm = string.Empty;
    private string _activeKpi = "all";
    private bool _showIssue;
    private bool _loading;
    private bool _showRevokeConfirm;
    private bool _showDeleteConfirm;
    private Guid _tenantId;
    private Guid? _userId;
    private Guid? _editingCertificateId;
    private Guid? _editingPolicyId;
    private CertRow? _revokeTarget;
    private CertRow? _deleteTarget;
    private string? _revokeReason;
    private CertRow? _selected;
    private IssueForm _issForm = new();
    private readonly string[] _certTypes = ["ACORD 25", "ACORD 27", "ACORD 28", "Custom"];
    private readonly List<CertRow> _rows = [];

    private string SearchText { get => _searchTerm; set { _searchTerm = value; SelectFallback(); } }
    private string StatusFilter { get => _filterStatus; set { _filterStatus = value; _activeKpi = string.IsNullOrWhiteSpace(value) ? "all" : value.ToLowerInvariant(); SelectFallback(); } }
    private string TypeFilter { get => _filterType; set { _filterType = value; SelectFallback(); } }

    private List<CertRow> Filtered => _rows
        .Where(MatchesKpi)
        .Where(r => string.IsNullOrWhiteSpace(_filterStatus) || r.Status == _filterStatus)
        .Where(r => string.IsNullOrWhiteSpace(_filterType) || r.CertType == _filterType)
        .Where(MatchesSearch)
        .OrderBy(r => r.Status == "Pending" ? 0 : r.IsExpiring ? 1 : r.Status == "Issued" ? 2 : 3)
        .ThenBy(r => r.ExpDate)
        .ToList();

    private IReadOnlyList<string> Statuses => _rows.Select(r => r.Status).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    private int ExpiringCount => _rows.Count(r => r.IsExpiring);
    private int ActiveIssuedCount => _rows.Count(r => r.Status == "Issued");

    private IReadOnlyList<KpiModel> Kpis =>
    [
        new("all", "All", _rows.Count.ToString("N0"), "Total register", "bi-grid", "ch-kpi-all", "Show all certificates"),
        new("issued", "Issued", ActiveIssuedCount.ToString("N0"), "Active proof", "bi-award-fill", "ch-kpi-issued", "Show issued certificates"),
        new("pending", "Pending", _rows.Count(r => r.Status == "Pending").ToString("N0"), "Needs issuance", "bi-hourglass", "ch-kpi-pending", "Show pending certificates"),
        new("expiring", "Expiring", ExpiringCount.ToString("N0"), "Next 30 days", "bi-clock", "ch-kpi-exp", "Show expiring certificates"),
        new("expired", "Expired", _rows.Count(r => r.Status == "Expired").ToString("N0"), "Past expiry", "bi-x-circle", "ch-kpi-expired", "Show expired certificates"),
        new("holders", "Holders", _rows.Select(r => r.HolderName).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString("N0"), "Unique holders", "bi-person-badge", "ch-kpi-hold", "Show all certificate holders")
    ];

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policies", "/policies"), new("Certificates", "/policies/certificates"));
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _userId = context.UserId;
        await LoadCertificatesAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_rows.Count > 0 && !string.IsNullOrWhiteSpace(Certificate))
        {
            try
            {
                await SelectQueryCertificateAsync();
            }
            catch (Exception ex)
            {
                await _toast.ShowAsync(new ToastModel { Title = "Certificate lookup failed", Content = $"Certificate lookup failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
                SelectFallback();
            }
        }
    }

    private async Task LoadCertificatesAsync(bool preserveSelection = false)
    {
        _loading = true;
        var selectedId = preserveSelection ? _selected?.CertificateId : null;
        try
        {
            var result = await Api.SearchPolicyCertificatesAsync(_tenantId, pageSize: 500);
            _rows.Clear();
            _rows.AddRange((result?.Items ?? []).Select(CertRow.FromDto));
            if (!string.IsNullOrWhiteSpace(Certificate))
            {
                await SelectQueryCertificateAsync();
            }
            else if (selectedId is not null)
            {
                _selected = _rows.FirstOrDefault(r => r.CertificateId == selectedId.Value);
                SelectFallback();
            }
            else
            {
                SelectFallback();
            }
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Certificate load failed", Content = $"Certificate load failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectQueryCertificateAsync()
    {
        if (!string.IsNullOrWhiteSpace(Certificate))
        {
            _selected = _rows.FirstOrDefault(r => string.Equals(r.CertNo, Certificate.Trim(), StringComparison.OrdinalIgnoreCase));
            if (_selected is null)
            {
                var item = await Api.GetPolicyCertificateByNumberAsync(_tenantId, Certificate.Trim());
                if (item is not null)
                {
                    _selected = CertRow.FromDto(item);
                    if (!_rows.Any(r => r.CertificateId == _selected.CertificateId))
                    {
                        _rows.Insert(0, _selected);
                    }
                }
            }

            if (_selected is null)
            {
                await _toast.ShowAsync(new ToastModel { Title = "Certificate not found", Content = $"No database certificate was found for {Certificate.Trim()}.", CssClass = "enterprise-toast-warning" });
            }

            if (_selected is not null)
            {
                _searchTerm = _selected.CertNo;
            }
        }

        SelectFallback();
    }

    private void SelectFallback()
    {
        if (_selected is null || !Filtered.Any(r => r.CertNo == _selected.CertNo))
        {
            _selected = Filtered.FirstOrDefault() ?? _rows.FirstOrDefault();
        }
    }

    private bool MatchesKpi(CertRow row) => _activeKpi switch
    {
        "issued" => row.Status == "Issued",
        "pending" => row.Status == "Pending",
        "expiring" => row.IsExpiring,
        "expired" => row.Status == "Expired",
        _ => true
    };

    private bool MatchesSearch(CertRow row)
    {
        if (string.IsNullOrWhiteSpace(_searchTerm)) return true;
        var term = _searchTerm.Trim();
        return Contains(row.CertNo, term) || Contains(row.PolicyNo, term) || Contains(row.Account, term) || Contains(row.HolderName, term) || Contains(row.HolderAddress, term) || Contains(row.Lob, term) || Contains(row.IssuedBy, term);
    }

    private void ApplyKpi(string filter)
    {
        _activeKpi = _activeKpi == filter && filter != "all" ? "all" : filter;
        if (filter is "issued" or "pending" or "expired")
        {
            _filterStatus = char.ToUpperInvariant(filter[0]) + filter[1..];
        }
        else if (filter == "all" || filter == "holders" || filter == "expiring")
        {
            _filterStatus = string.Empty;
        }
        SelectFallback();
    }

    private void SelectTabAction(string action)
    {
        _activeKpi = action;
        _filterStatus = action == "pending" ? "Pending" : string.Empty;
        SelectFallback();
    }

    private void ShowPending() => SelectTabAction("pending");
    private void ShowExpiring() => SelectTabAction("expiring");

    private void OpenSelectedPolicy()
    {
        if (_selected?.PolicyId is { } policyId && policyId != Guid.Empty)
        {
            Nav.NavigateTo($"/policies/{policyId}");
        }
        else
        {
            _ = _toast.ShowAsync(new ToastModel { Title = "Policy link unavailable", Content = "This certificate is not linked to a specific policy record yet.", CssClass = "enterprise-toast-warning" });
        }
    }

    private async Task ResetFiltersAsync()
    {
        _activeKpi = "all";
        _filterStatus = string.Empty;
        _filterType = string.Empty;
        _searchTerm = string.Empty;
        await LoadCertificatesAsync();
    }

    private void SelectRow(CertRow row) => _selected = row;
    private void OpenIssue()
    {
        _editingCertificateId = null;
        _editingPolicyId = null;
        _issForm = new();
        _showIssue = true;
    }

    private void OpenEdit(CertRow row)
    {
        _editingCertificateId = row.CertificateId;
        _editingPolicyId = row.PolicyId;
        _issForm = new IssueForm
        {
            PolicyNo = row.PolicyNo,
            Account = row.Account,
            CertType = row.CertType,
            Lob = row.Lob,
            HolderName = row.HolderName,
            HolderAddress = row.HolderAddress,
            AdditionalInsured = row.AdditionalInsured,
            WaiverSubrogation = row.WaiverSubrogation,
            IssuedDate = row.IssuedDate,
            ExpDate = row.ExpDate,
            Description = row.Description
        };
        _showIssue = true;
    }

    private void CloseIssue()
    {
        _showIssue = false;
        _editingCertificateId = null;
        _editingPolicyId = null;
        _issForm = new();
    }

    private async Task SaveDraftAsync()
    {
        await SaveCertificateAsync("Pending", "Certificate draft", "Certificate draft saved to the database.");
    }

    private async Task IssueCertAsync()
    {
        await SaveCertificateAsync("Issued", "Certificate issued", "Certificate was issued and saved to the database.");
    }

    private async Task SaveCertificateAsync(string status, string toastTitle, string toastContent)
    {
        if (string.IsNullOrWhiteSpace(_issForm.PolicyNo) || string.IsNullOrWhiteSpace(_issForm.Account) || string.IsNullOrWhiteSpace(_issForm.HolderName) || string.IsNullOrWhiteSpace(_issForm.Lob))
        {
            await _toast.ShowAsync(new ToastModel { Title = "Required fields", Content = "Policy number, account, holder, and line of business are required.", CssClass = "enterprise-toast-warning" });
            return;
        }

        try
        {
            Guid id;
            if (_editingCertificateId is { } editingId)
            {
                var request = new UpdatePolicyCertificateRequest(
                    _tenantId,
                    _editingPolicyId,
                    _issForm.PolicyNo.Trim(),
                    _issForm.Account.Trim(),
                    _issForm.HolderName.Trim(),
                    _issForm.HolderAddress.Trim(),
                    _issForm.CertType,
                    _issForm.IssuedDate,
                    _issForm.ExpDate,
                    _issForm.Lob.Trim(),
                    "Tenant Admin",
                    status,
                    _issForm.AdditionalInsured,
                    _issForm.WaiverSubrogation,
                    string.IsNullOrWhiteSpace(_issForm.Description) ? "Certificate generated from enterprise issuance workflow." : _issForm.Description.Trim(),
                    _userId);
                await Api.UpdatePolicyCertificateAsync(editingId, request);
                id = editingId;
            }
            else
            {
                var request = new CreatePolicyCertificateRequest(
                    _tenantId,
                    null,
                    _issForm.PolicyNo.Trim(),
                    _issForm.Account.Trim(),
                    _issForm.HolderName.Trim(),
                    _issForm.HolderAddress.Trim(),
                    _issForm.CertType,
                    _issForm.IssuedDate,
                    _issForm.ExpDate,
                    _issForm.Lob.Trim(),
                    "Tenant Admin",
                    status,
                    _issForm.AdditionalInsured,
                    _issForm.WaiverSubrogation,
                    string.IsNullOrWhiteSpace(_issForm.Description) ? "Certificate generated from enterprise issuance workflow." : _issForm.Description.Trim(),
                    _userId);
                id = await Api.CreatePolicyCertificateAsync(request);
            }

            _showIssue = false;
            _editingCertificateId = null;
            _editingPolicyId = null;
            _issForm = new();
            await LoadCertificatesAsync();
            _selected = _rows.FirstOrDefault(r => r.CertificateId == id) ?? _rows.FirstOrDefault();
            await _toast.ShowAsync(new ToastModel { Title = toastTitle, Content = toastContent, CssClass = "enterprise-toast-success" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Save failed", Content = $"Save failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
        }
    }

    private async Task DownloadAsync(CertRow row) => await _toast.ShowAsync(new ToastModel { Title = "PDF ready", Content = $"{row.CertNo} PDF download prepared.", CssClass = "enterprise-toast-success" });
    private async Task EmailAsync(CertRow row)
    {
        try
        {
            await Api.MarkPolicyCertificateDeliveredAsync(row.CertificateId, new PolicyCertificateActionRequest(_tenantId, _userId));
            await LoadCertificatesAsync(preserveSelection: true);
            await _toast.ShowAsync(new ToastModel { Title = "Email queued", Content = $"{row.CertNo} queued for {row.HolderName}.", CssClass = "enterprise-toast-success" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Email failed", Content = $"Email failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
        }
    }
    private async Task ExportVisibleAsync() => await _toast.ShowAsync(new ToastModel { Title = "Export", Content = $"Exported {Filtered.Count} visible certificate row(s).", CssClass = "enterprise-toast-success" });

    private void ConfirmRevoke(CertRow row)
    {
        _revokeTarget = row;
        _revokeReason = string.Empty;
        _showRevokeConfirm = true;
    }

    private void CancelRevoke()
    {
        _showRevokeConfirm = false;
        _revokeTarget = null;
        _revokeReason = null;
    }

    private async Task ExecuteRevokeAsync()
    {
        if (_revokeTarget is null)
        {
            return;
        }

        try
        {
            await Api.RevokePolicyCertificateAsync(_revokeTarget.CertificateId, new RevokePolicyCertificateRequest(_tenantId, _userId, _revokeReason));
            _showRevokeConfirm = false;
            await LoadCertificatesAsync(preserveSelection: true);
            await _toast.ShowAsync(new ToastModel { Title = "Certificate revoked", Content = $"{_revokeTarget.CertNo} was revoked in the database.", CssClass = "enterprise-toast-warning" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Revoke failed", Content = $"Revoke failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
        }
        finally
        {
            _revokeTarget = null;
            _revokeReason = null;
        }
    }

    private async Task RestoreAsync(CertRow row)
    {
        try
        {
            await Api.RestorePolicyCertificateAsync(row.CertificateId, new RestorePolicyCertificateRequest(_tenantId, _userId));
            await LoadCertificatesAsync(preserveSelection: true);
            await _toast.ShowAsync(new ToastModel { Title = "Certificate restored", Content = $"{row.CertNo} was restored.", CssClass = "enterprise-toast-success" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Restore failed", Content = $"Restore failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
        }
    }

    private void ConfirmDelete(CertRow row)
    {
        _deleteTarget = row;
        _showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        _showDeleteConfirm = false;
        _deleteTarget = null;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null)
        {
            return;
        }

        try
        {
            var certNo = _deleteTarget.CertNo;
            await Api.DeletePolicyCertificateAsync(_deleteTarget.CertificateId, _tenantId, _userId);
            _showDeleteConfirm = false;
            _deleteTarget = null;
            await LoadCertificatesAsync();
            await _toast.ShowAsync(new ToastModel { Title = "Certificate deleted", Content = $"{certNo} was removed from the register.", CssClass = "enterprise-toast-success" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Delete failed", Content = $"Delete failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
        }
    }

    private static bool IsRevoked(CertRow row) => row.Status == "Revoked";
    private static bool Contains(string? value, string term) => value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
    private static string CssToken(string value) => string.IsNullOrWhiteSpace(value) ? "none" : value.ToLowerInvariant().Replace(" ", "-");
    private static string ExpiryClass(CertRow row) => row.ExpDate < DateTime.Today ? "ch-exp-past" : row.IsExpiring ? "ch-exp-soon" : string.Empty;

    private sealed record KpiModel(string Filter, string Label, string Value, string Caption, string Icon, string CssClass, string Title);

    private sealed class IssueForm
    {
        public string PolicyNo { get; set; } = "POL-2024-44821";
        public string Account { get; set; } = string.Empty;
        public string CertType { get; set; } = "ACORD 25";
        public string Lob { get; set; } = "General Liability";
        public string HolderName { get; set; } = string.Empty;
        public string HolderAddress { get; set; } = string.Empty;
        public bool AdditionalInsured { get; set; }
        public bool WaiverSubrogation { get; set; }
        public DateTime IssuedDate { get; set; } = DateTime.Today;
        public DateTime ExpDate { get; set; } = DateTime.Today.AddYears(1);
        public string Description { get; set; } = string.Empty;
    }

    private sealed class CertRow
    {
        public CertRow(Guid certificateId, Guid? policyId, string certNo, string policyNo, string account, string holderName, string holderAddress, string certType, DateTime issuedDate, DateTime expDate, string lob, string issuedBy, string status, bool additionalInsured, bool waiverSubrogation, string description)
        {
            CertificateId = certificateId;
            PolicyId = policyId;
            CertNo = certNo;
            PolicyNo = policyNo;
            Account = account;
            HolderName = holderName;
            HolderAddress = holderAddress;
            CertType = certType;
            IssuedDate = issuedDate;
            ExpDate = expDate;
            Lob = lob;
            IssuedBy = issuedBy;
            Status = status;
            AdditionalInsured = additionalInsured;
            WaiverSubrogation = waiverSubrogation;
            Description = description;
        }

        public static CertRow FromDto(PolicyCertificateDto dto) => new(
            dto.CertificateId,
            dto.PolicyId,
            dto.CertificateNumber,
            dto.PolicyNumber,
            dto.AccountName,
            dto.HolderName,
            dto.HolderAddress,
            dto.CertificateType,
            dto.IssuedDate,
            dto.ExpirationDate,
            dto.LineOfBusiness,
            dto.IssuedBy,
            dto.Status,
            dto.AdditionalInsured,
            dto.WaiverSubrogation,
            dto.Description);

        public Guid CertificateId { get; set; }
        public Guid? PolicyId { get; set; }
        public string CertNo { get; set; }
        public string PolicyNo { get; set; }
        public string Account { get; set; }
        public string HolderName { get; set; }
        public string HolderAddress { get; set; }
        public string CertType { get; set; }
        public DateTime IssuedDate { get; set; }
        public DateTime ExpDate { get; set; }
        public string Lob { get; set; }
        public string IssuedBy { get; set; }
        public string Status { get; set; }
        public bool AdditionalInsured { get; set; }
        public bool WaiverSubrogation { get; set; }
        public string Description { get; set; }
        public bool IsExpiring => Status == "Issued" && ExpDate >= DateTime.Today && ExpDate <= DateTime.Today.AddDays(30);
    }
}
