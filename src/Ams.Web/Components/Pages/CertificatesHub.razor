    private IssueForm NewIssueForm()
    {
        var defaultType = CertificateTypeOptions.FirstOrDefault(option => option.IsDefault) ?? CertificateTypeOptions.FirstOrDefault();
        return new IssueForm { CertType = defaultType?.OptionCode ?? string.Empty };
    }

    private void OnHolderChanged(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var holderId))
        {
            _issForm.CertificateHolderId = null;
            return;
        }

        var holder = HolderOptions.FirstOrDefault(item => item.CertificateHolderId == holderId);
        if (holder is null) return;
        _issForm.CertificateHolderId = holderId;
        _issForm.HolderName = holder.LegalName;
        _issForm.HolderAddress = string.Join(", ", new[] { holder.AddressLine1, holder.AddressLine2, holder.City, holder.StateProvince, holder.PostalCode }.Where(value => !string.IsNullOrWhiteSpace(value)));
        _issForm.AdditionalInsured = holder.RequiresAdditionalInsured;
        _issForm.WaiverSubrogation = holder.RequiresWaiverOfSubrogation;
        _issForm.PrimaryNonContributory = holder.RequiresPrimaryNonContributory;
        _issForm.Description = holder.DefaultWording ?? string.Empty;
    }

    private void CloseIssue()
    {
        _showIssue = false;
        _editingCertificateId = null;
        _editingPolicyId = null;
        _issForm = NewIssueForm();
    }

