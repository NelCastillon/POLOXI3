@page "/policies/certificates"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Certificates Hub — AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<SfContextMenu @ref="_ctx" TValue="CtxItem" Items="_ctxItems" ItemSelected="OnCtxSelected">
    <MenuFieldSettings Text="Text" IconCss="IconCss" />
</SfContextMenu>

<AppPageHeader Title="Certificates Hub"
               Subtitle="Issue, track and manage ACORD certificates of insurance"
               Icon="bi-award">
    <Actions>
        <div class="ch-filter-row">
            <select class="e-input ch-filter-sel" @bind="_filterStatus">
                <option value="">All Statuses</option>
                <option>Issued</option>
                <option>Pending</option>
                <option>Expired</option>
                <option>Revoked</option>
            </select>
            <select class="e-input ch-filter-sel" @bind="_filterType">
                <option value="">All Types</option>
                <option>ACORD 25</option>
                <option>ACORD 27</option>
                <option>ACORD 28</option>
                <option>Custom</option>
            </select>
        </div>
        <button class="um-btn um-btn-primary" @onclick='() => _showIssue = true'>
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Issue Certificate
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="ch-kpi-strip">
    @KpiCard("bi-award-fill",  "Issued",   _rows.Count(r=>r.Status=="Issued").ToString(),  "ch-kpi-issued")
    @KpiCard("bi-hourglass",   "Pending",  _rows.Count(r=>r.Status=="Pending").ToString(), "ch-kpi-pending")
    @KpiCard("bi-clock",       "Expiring", ExpiringCount.ToString(),                        "ch-kpi-exp")
    @KpiCard("bi-x-circle",    "Expired",  _rows.Count(r=>r.Status=="Expired").ToString(), "ch-kpi-expired")
    @KpiCard("bi-person-badge","Holders",  _rows.Select(r=>r.HolderName).Distinct().Count().ToString(), "ch-kpi-hold")
</div>

<!-- Grid -->
<div class="ch-grid-wrap">
    <SfGrid DataSource="@Filtered" AllowSorting="true" AllowPaging="true" AllowResizing="true" RowHeight="40">
        <GridPageSettings PageSize="20" />
        <GridColumns>
            <GridColumn Field="CertNo"      HeaderText="Cert #"         Width="140" />
            <GridColumn Field="PolicyNo"    HeaderText="Policy #"       Width="140" />
            <GridColumn Field="Account"     HeaderText="Account"        Width="180" />
            <GridColumn Field="HolderName"  HeaderText="Certificate Holder" Width="200" />
            <GridColumn Field="CertType"    HeaderText="Form"           Width="100"
                        Template="@(ctx => TypeBadge(((CertRow)ctx).CertType))" />
            <GridColumn Field="IssuedDate"  HeaderText="Issued"         Width="110" Format="MM/dd/yyyy" />
            <GridColumn Field="ExpDate"     HeaderText="Expiry"         Width="110"
                        Template="@(ctx => ExpCell(((CertRow)ctx).ExpDate))" />
            <GridColumn Field="Lob"         HeaderText="LOB"            Width="150" />
            <GridColumn Field="IssuedBy"    HeaderText="Issued By"      Width="130" />
            <GridColumn Field="Status"      HeaderText="Status"         Width="110"
                        Template="@(ctx => StatusChip(((CertRow)ctx).Status))" />
            <GridColumn HeaderText="" Width="50" AllowSorting="false"
                        Template="@(ctx => CtxBtn((CertRow)ctx))" />
        </GridColumns>
    </SfGrid>
</div>

<!-- Issue dialog -->
<SfDialog @bind-Visible="_showIssue" Width="560px" IsModal="true" ShowCloseIcon="true" Header="Issue Certificate">
    <DialogTemplates>
        <Content>
            <div class="ch-dlg-fields">
                <div class="ch-dlg-field">
                    <label class="ch-dlg-lbl">Policy Number <span class="ch-req">*</span></label>
                    <input class="e-input" @bind="_issForm.PolicyNo" placeholder="POL-2025-…" />
                </div>
                <div class="ch-dlg-field">
                    <label class="ch-dlg-lbl">Certificate Form</label>
                    <SfDropDownList TItem="string" TValue="string"
                        DataSource="@_certTypes" @bind-Value="_issForm.CertType" />
                </div>
                <div class="ch-dlg-field ch-dlg-full">
                    <label class="ch-dlg-lbl">Certificate Holder Name <span class="ch-req">*</span></label>
                    <input class="e-input" @bind="_issForm.HolderName" placeholder="Legal name of certificate holder" />
                </div>
                <div class="ch-dlg-field ch-dlg-full">
                    <label class="ch-dlg-lbl">Holder Address</label>
                    <input class="e-input" @bind="_issForm.HolderAddress" />
                </div>
                <div class="ch-dlg-field">
                    <label class="ch-dlg-lbl">Additional Insured?</label>
                    <SfCheckBox @bind-Checked="_issForm.AdditionalInsured" Label="Yes — add as additional insured" />
                </div>
                <div class="ch-dlg-field">
                    <label class="ch-dlg-lbl">Waiver of Subrogation?</label>
                    <SfCheckBox @bind-Checked="_issForm.WaiverSubrogation" Label="Include waiver" />
                </div>
                <div class="ch-dlg-field">
                    <label class="ch-dlg-lbl">Effective Date</label>
                    <SfDatePicker TValue="DateTime" @bind-Value="_issForm.IssuedDate" Format="MM/dd/yyyy" />
                </div>
                <div class="ch-dlg-field">
                    <label class="ch-dlg-lbl">Expiry Date</label>
                    <SfDatePicker TValue="DateTime" @bind-Value="_issForm.ExpDate" Format="MM/dd/yyyy" />
                </div>
                <div class="ch-dlg-field ch-dlg-full">
                    <label class="ch-dlg-lbl">Description of Operations</label>
                    <textarea class="e-input" rows="2" @bind="_issForm.Description"></textarea>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <button class="um-btn um-btn-ghost"   @onclick='() => _showIssue = false'>Cancel</button>
            <button class="um-btn um-btn-secondary" @onclick="SaveDraft">Save Draft</button>
            <button class="um-btn um-btn-primary"  @onclick="IssueCert">Issue</button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    EnterpriseToast _toast = default!;
    SfContextMenu<CtxItem> _ctx = default!;

    string  _filterStatus = "";
    string  _filterType   = "";
    bool    _showIssue    = false;
    CertRow _selected     = new();

    IEnumerable<CertRow> Filtered => _rows
        .Where(r => (string.IsNullOrEmpty(_filterStatus) || r.Status   == _filterStatus)
                 && (string.IsNullOrEmpty(_filterType)   || r.CertType == _filterType));

    int ExpiringCount => _rows.Count(r => r.Status == "Issued"
        && r.ExpDate >= DateTime.Today && r.ExpDate <= DateTime.Today.AddDays(30));

    readonly string[] _certTypes = new[]{ "ACORD 25","ACORD 27","ACORD 28","Custom" };

    IssueForm _issForm = new();

    sealed class IssueForm
    {
        public string   PolicyNo         { get; set; } = "";
        public string   CertType         { get; set; } = "ACORD 25";
        public string   HolderName       { get; set; } = "";
        public string   HolderAddress    { get; set; } = "";
        public bool     AdditionalInsured{ get; set; }
        public bool     WaiverSubrogation{ get; set; }
        public DateTime IssuedDate       { get; set; } = DateTime.Today;
        public DateTime ExpDate          { get; set; } = DateTime.Today.AddYears(1);
        public string   Description      { get; set; } = "";
    }

    sealed class CertRow
    {
        public string   CertNo      { get; set; } = "";
        public string   PolicyNo    { get; set; } = "";
        public string   Account     { get; set; } = "";
        public string   HolderName  { get; set; } = "";
        public string   CertType    { get; set; } = "";
        public DateTime IssuedDate  { get; set; }
        public DateTime ExpDate     { get; set; }
        public string   Lob         { get; set; } = "";
        public string   IssuedBy    { get; set; } = "";
        public string   Status      { get; set; } = "";
    }

    sealed record CtxItem(string Text, string IconCss);

    List<CtxItem> _ctxItems = new()
    {
        new("Download PDF",  "bi bi-file-earmark-pdf"),
        new("Email Holder",  "bi bi-envelope"       ),
        new("View Policy",   "bi bi-shield"         ),
        new("Revoke",        "bi bi-x-circle"       ),
    };

    readonly List<CertRow> _rows = new();

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Policies","/policies"), new("Certificates","/policies/certificates"));
        BuildStub();
    }

    void BuildStub()
    {
        var rng      = new Random(13);
        var types    = _certTypes;
        var statuses = new[]{"Issued","Pending","Expired","Revoked"};
        var lobs     = new[]{"General Liability","Commercial Property","Commercial Auto"};
        var accounts = new[]{"Sullivan Mfg. LLC","Bridgewater Hotels","Metro Freight Co.","PineCrest Builders","Nguyen, Minh T."};
        var holders  = new[]{"City of Houston","ABC Contractors LLC","First National Bank","TXDOT","Whole Foods Market","Amazon.com LLC","State Farm (as AI)","Harris County"};
        var people   = new[]{"Maria Santos","James Patel","Chen Li","Aisha Williams"};

        for (int i = 1; i <= 50; i++)
        {
            var iss    = DateTime.Today.AddDays(-rng.Next(0,365));
            var status = statuses[rng.Next(statuses.Length)];
            _rows.Add(new CertRow
            {
                CertNo     = $"CERT-2025-{i:D4}",
                PolicyNo   = $"POL-2025-{rng.Next(10000,99999)}",
                Account    = accounts[rng.Next(accounts.Length)],
                HolderName = holders[rng.Next(holders.Length)],
                CertType   = types[rng.Next(types.Length)],
                IssuedDate = iss,
                ExpDate    = iss.AddYears(1),
                Lob        = lobs[rng.Next(lobs.Length)],
                IssuedBy   = people[rng.Next(people.Length)],
                Status     = status,
            });
        }
    }

    void SaveDraft() { _rows.Insert(0, BuildCertRow("Pending")); _showIssue = false; _issForm = new(); }
    void IssueCert() { _rows.Insert(0, BuildCertRow("Issued")); _showIssue = false; _issForm = new(); }

    CertRow BuildCertRow(string status) => new()
    {
        CertNo     = $"CERT-2025-{_rows.Count+1:D4}",
        PolicyNo   = _issForm.PolicyNo,
        Account    = "—",
        HolderName = _issForm.HolderName,
        CertType   = _issForm.CertType,
        IssuedDate = _issForm.IssuedDate,
        ExpDate    = _issForm.ExpDate,
        Lob        = "—",
        IssuedBy   = "Current User",
        Status     = status,
    };

    void OnCtxSelected(MenuEventArgs<CtxItem> args)
    {
        if (args.Item.Text == "View Policy") Nav.NavigateTo($"/policies/{Guid.NewGuid()}");
        if (args.Item.Text == "Revoke") _selected.Status = "Revoked";
    }

    RenderFragment TypeBadge(string t) =>
        @<span class="ch-type-badge">@t</span>;

    RenderFragment ExpCell(DateTime d)
    {
        var days = (d - DateTime.Today).TotalDays;
        var css  = days < 0 ? "ch-exp-past" : days <= 30 ? "ch-exp-soon" : "";
        return @<span class="@css">@d.ToString("MM/dd/yyyy")</span>;
    }

    RenderFragment StatusChip(string s) =>
        @<span class="ch-status ch-status-@s.ToLower()">@s</span>;

    RenderFragment CtxBtn(CertRow row) =>
        @<button class="um-btn um-btn-ghost um-btn-xs"
                 @onclick:stopPropagation="true"
                 @onclick="(e) => { _selected = row; _ctx.Open(e.ClientX, e.ClientY); }">
            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
        </button>;

    RenderFragment KpiCard(string icon, string label, string val, string css) =>
        @<div class="ch-kpi-card @css">
            <div class="ch-kpi-val">@val</div>
            <div class="ch-kpi-lbl"><i class="bi @icon" aria-hidden="true"></i> @label</div>
        </div>;
}
