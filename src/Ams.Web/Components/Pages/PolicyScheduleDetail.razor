@page "/policies/{PolicyId:guid}/risk-items"
@page "/policies/{PolicyId:guid}/locations"
@page "/policies/{PolicyId:guid}/drivers"
@page "/policies/{PolicyId:guid}/activity"
@inject NavigationManager Nav

<PageTitle>@PageTitleText - Policy Detail</PageTitle>

<div class="psd-enterprise-page psd-route-@RouteKind">
    <section class="psd-hero">
        <div>
            <span class="psd-eyebrow"><i class="bi @PageIcon" aria-hidden="true"></i> Policy workspace</span>
            <h1>@PageTitleText</h1>
            <p>@PageSubtitle</p>
            <span class="psd-route-pill"><i class="bi bi-link-45deg" aria-hidden="true"></i> @RouteKind route - @SelectedTitle</span>
        </div>
        <div class="psd-hero-actions">
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="BackToPolicy">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Policy
            </button>
            <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="GoToCompare">
                <i class="bi bi-layout-split" aria-hidden="true"></i> Compare Coverage
            </button>
        </div>
    </section>

    <section class="psd-spotlight" aria-label="Selected schedule item spotlight">
        <div class="psd-spotlight-icon"><i class="bi @SelectedIcon" aria-hidden="true"></i></div>
        <div class="psd-spotlight-main">
            <span class="psd-spotlight-kicker">Selected from policy schedule</span>
            <h2>@SelectedTitle</h2>
            <p>@SelectedSubtitle</p>
            <div class="psd-spotlight-tags">
                <span><i class="bi bi-bookmark-star" aria-hidden="true"></i>@SelectedType</span>
                <span><i class="bi bi-geo-alt" aria-hidden="true"></i>@SelectedLocationLabel</span>
                @if (HasDirectQuery)
                {
                    <span><i class="bi bi-check2-circle" aria-hidden="true"></i>Deep link match</span>
                }
            </div>
        </div>
        <div class="psd-spotlight-value">
            <span>@SelectedPrimaryMetricLabel</span>
            <strong>@SelectedPrimaryMetric</strong>
            <small>@SelectedMeta</small>
        </div>
    </section>

    <section class="psd-kpi-strip" aria-label="@PageTitleText metrics">
        @foreach (var metric in Metrics)
        {
            <div class="psd-kpi-card">
                <i class="bi @metric.Icon psd-kpi-icon" aria-hidden="true"></i>
                <div>
                    <strong>@metric.Value</strong>
                    <span>@metric.Label</span>
                </div>
            </div>
        }
    </section>

    <section class="psd-detail-card">
        <div class="psd-detail-header">
            <div>
                <span>@SelectedLabel</span>
                <h2>@SelectedTitle</h2>
            </div>
            <span class="psd-status-chip"><i class="bi bi-stars" aria-hidden="true"></i> Enterprise detail</span>
        </div>

        <div class="psd-field-grid">
            @foreach (var field in SelectedFields)
            {
                <div class="psd-field">
                    <span>@field.Label</span>
                    <strong>@field.Value</strong>
                </div>
            }
        </div>
    </section>

    <section class="psd-list-card">
        <div class="psd-list-header">
            <h3>@ListTitle</h3>
            <span>@Rows.Count record(s)</span>
        </div>
        <div class="psd-list">
            @foreach (var row in Rows)
            {
                <button type="button" class="psd-list-row @(row.IsSelected ? "psd-list-row--selected" : null)" @onclick="() => SelectRow(row)">
                    <span class="psd-row-icon"><i class="bi @row.Icon" aria-hidden="true"></i></span>
                    <span class="psd-row-main">
                        <strong>@row.Title</strong>
                        <small>@row.Subtitle</small>
                    </span>
                    <span class="psd-row-meta">@row.Meta</span>
                </button>
            }
        </div>
    </section>
</div>

@code {
    [Parameter] public Guid PolicyId { get; set; }
    [SupplyParameterFromQuery(Name = "item")] public string? Item { get; set; }
    [SupplyParameterFromQuery(Name = "location")] public int? Location { get; set; }
    [SupplyParameterFromQuery(Name = "license")] public string? License { get; set; }
    [SupplyParameterFromQuery(Name = "subject")] public string? Subject { get; set; }

    private string RouteKind => Nav.ToBaseRelativePath(Nav.Uri).Split('?', 2)[0].Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? "risk-items";
    private string PageTitleText => RouteKind switch
    {
        "drivers" => "Policy Drivers",
        "locations" => "Policy Locations",
        "activity" => "Policy Activity Detail",
        _ => "Policy Risk Item Detail"
    };

    private string PageSubtitle => RouteKind switch
    {
        "drivers" => "Driver eligibility, licensing, violations, and fleet assignment tied to this policy.",
        "locations" => "Scheduled locations, property values, addresses, and occupancy details tied to this policy.",
        "activity" => "Policy service activity, notes, outcomes, and workflow history.",
        _ => "Scheduled equipment, vehicles, property, and other insured risk items tied to this policy."
    };

    private string PageIcon => RouteKind switch
    {
        "drivers" => "bi-person-badge",
        "locations" => "bi-pin-map",
        "activity" => "bi-lightning-charge",
        _ => "bi-boxes"
    };

    private string SelectedLabel => RouteKind switch
    {
        "drivers" => "Selected driver",
        "locations" => "Selected location",
        "activity" => "Selected activity",
        _ => "Selected risk item"
    };

    private string ListTitle => RouteKind switch
    {
        "drivers" => "Driver schedule",
        "locations" => "Location schedule",
        "activity" => "Policy activity timeline",
        _ => "Risk schedule"
    };

    private List<Metric> Metrics => RouteKind switch
    {
        "drivers" =>
        [
            new("Active Drivers", "3", "bi-people"),
            new("Eligible", "3", "bi-check-circle"),
            new("Violations", "1", "bi-exclamation-triangle"),
            new("Fleet Assigned", "2", "bi-truck")
        ],
        "locations" =>
        [
            new("Scheduled", "3", "bi-buildings"),
            new("Building TIV", "$3.25M", "bi-bank"),
            new("Contents", "$1.06M", "bi-box-seam"),
            new("Primary", "1", "bi-star")
        ],
        "activity" =>
        [
            new("Activities", "6", "bi-lightning"),
            new("Completed", "5", "bi-check-circle"),
            new("Pending", "1", "bi-clock"),
            new("Last Touch", "5d", "bi-calendar-event")
        ],
        _ =>
        [
            new("Risk Items", "6", "bi-boxes"),
            new("Equipment", "3", "bi-tools"),
            new("Vehicles", "1", "bi-truck"),
            new("Locations", "2", "bi-pin-map")
        ]
    };

    private List<ScheduleRow> Rows => BuildRows();

    private ScheduleRow SelectedRow => Rows.FirstOrDefault(r => r.IsSelected) ?? Rows.First();
    private string SelectedTitle => SelectedRow.Title;
    private string SelectedSubtitle => SelectedRow.Subtitle;
    private string SelectedMeta => SelectedRow.Meta;
    private string SelectedIcon => SelectedRow.Icon;
    private IEnumerable<FieldRow> SelectedFields => SelectedRow.Fields;
    private bool HasDirectQuery => RouteKind switch
    {
        "drivers" => !string.IsNullOrWhiteSpace(License),
        "locations" => Location.HasValue || !string.IsNullOrWhiteSpace(Item),
        "activity" => !string.IsNullOrWhiteSpace(Subject),
        _ => !string.IsNullOrWhiteSpace(Item)
    };

    private string SelectedType => FieldValue("Type") ?? FieldValue("Category") ?? RouteKind switch
    {
        "drivers" => "Driver",
        "locations" => "Location",
        "activity" => "Activity",
        _ => "Risk item"
    };

    private string SelectedLocationLabel => FieldValue("Location") ?? FieldValue("Address") ?? FieldValue("Channel") ?? "Policy schedule";

    private string SelectedPrimaryMetricLabel => RouteKind switch
    {
        "drivers" => "Experience",
        "locations" => "Building value",
        "activity" => "Activity age",
        _ => "Scheduled value"
    };

    private string SelectedPrimaryMetric => RouteKind switch
    {
        "drivers" => FieldValue("Experience") ?? SelectedMeta,
        "locations" => FieldValue("Building") ?? SelectedMeta,
        "activity" => FieldValue("Activity Date") ?? SelectedMeta,
        _ => FieldValue("Value") ?? SelectedMeta
    };

    private string? FieldValue(string label) => SelectedRow.Fields.FirstOrDefault(f => string.Equals(f.Label, label, StringComparison.OrdinalIgnoreCase))?.Value;

    private List<ScheduleRow> BuildRows()
    {
        var rows = RouteKind switch
        {
            "drivers" => DriverRows(),
            "locations" => LocationRows(),
            "activity" => ActivityRows(),
            _ => RiskRows()
        };

        if (!rows.Any(r => r.IsSelected) && rows.Count > 0)
        {
            rows[0] = rows[0] with { IsSelected = true };
        }

        return rows;
    }

    private List<ScheduleRow> RiskRows()
    {
        var selected = Item ?? string.Empty;
        return
        [
            NewRow("CNC Milling Machine #1", "Equipment - Plant A", "$125,000", "bi-tools", selected, [new("Type", "Equipment"), new("Year", "2019"), new("Make / Model", "Haas VF-2"), new("VIN / Serial", "HM-019-4421"), new("Value", "$125,000"), new("Location", "Plant A")]),
            NewRow("CNC Milling Machine #2", "Equipment - Plant A", "$148,000", "bi-tools", selected, [new("Type", "Equipment"), new("Year", "2021"), new("Make / Model", "Haas VF-4"), new("VIN / Serial", "HM-021-6109"), new("Value", "$148,000"), new("Location", "Plant A")]),
            NewRow("Forklift - Clark C30", "Equipment - Warehouse", "$28,000", "bi-truck", selected, [new("Type", "Equipment"), new("Year", "2018"), new("Make / Model", "Clark C30"), new("VIN / Serial", "CLK-018-8812"), new("Value", "$28,000"), new("Location", "Warehouse")]),
            NewRow("Delivery Van", "Vehicle - Fleet", "$38,500", "bi-truck-front", selected, [new("Type", "Vehicle"), new("Year", "2022"), new("Make / Model", "Ford Transit"), new("VIN / Serial", "1FTBR1Y82NKA12345"), new("Value", "$38,500"), new("Location", "Fleet")]),
            NewRow("Primary Manufacturing Plant", "Location - 1422 Industrial Blvd", "$2,400,000", "bi-building", selected, [new("Type", "Location"), new("Year", "-"), new("Make / Model", "-"), new("VIN / Serial", "-"), new("Value", "$2,400,000"), new("Location", "1422 Industrial Blvd")]),
            NewRow("Warehouse & Distribution", "Location - 1600 Commerce Dr", "$850,000", "bi-building", selected, [new("Type", "Location"), new("Year", "-"), new("Make / Model", "-"), new("VIN / Serial", "-"), new("Value", "$850,000"), new("Location", "1600 Commerce Dr")])
        ];
    }

    private List<ScheduleRow> DriverRows()
    {
        var selected = License ?? string.Empty;
        return
        [
            NewRow("Robert Sullivan", "IL driver - Primary", "35 yrs", "bi-person-badge", selected, [new("License", "S612-4891-20"), new("State", "IL"), new("DOB", "04/12/1968"), new("Experience", "35 years"), new("Violations", "0"), new("Eligible", "Yes")], "S612-4891-20"),
            NewRow("Mike Torres", "IL driver - Fleet Driver", "18 yrs", "bi-person-badge", selected, [new("License", "T312-8821-19"), new("State", "IL"), new("DOB", "09/22/1985"), new("Experience", "18 years"), new("Violations", "1"), new("Eligible", "Yes")], "T312-8821-19"),
            NewRow("Sandra Webb", "IL driver - Fleet Driver", "12 yrs", "bi-person-badge", selected, [new("License", "W221-4419-21"), new("State", "IL"), new("DOB", "03/07/1991"), new("Experience", "12 years"), new("Violations", "0"), new("Eligible", "Yes")], "W221-4419-21")
        ];
    }

    private List<ScheduleRow> LocationRows()
    {
        var selected = Location?.ToString() ?? Item ?? string.Empty;
        return
        [
            NewRow("Primary Manufacturing Plant", "1422 Industrial Blvd - Chicago, IL 60601", "$2.40M building", "bi-building", selected, [new("Location #", "1"), new("Address", "1422 Industrial Blvd"), new("City / State", "Chicago, IL 60601"), new("Building", "$2,400,000"), new("Contents", "$650,000"), new("Primary", "Yes")], "1"),
            NewRow("Warehouse & Distribution Hub", "1600 Commerce Dr - Chicago, IL 60607", "$850K building", "bi-building", selected, [new("Location #", "2"), new("Address", "1600 Commerce Dr"), new("City / State", "Chicago, IL 60607"), new("Building", "$850,000"), new("Contents", "$320,000"), new("Primary", "No")], "2"),
            NewRow("Administrative Office", "200 N LaSalle St - Chicago, IL 60601", "$85K contents", "bi-building", selected, [new("Location #", "3"), new("Address", "200 N LaSalle St"), new("City / State", "Chicago, IL 60601"), new("Building", "-"), new("Contents", "$85,000"), new("Primary", "No")], "3")
        ];
    }

    private List<ScheduleRow> ActivityRows()
    {
        var selected = Subject ?? string.Empty;
        return
        [
            NewRow("Renewal review call", "Phone - Completed - Amy Scott", "5 days ago", "bi-telephone", selected, [new("Category", "Call"), new("Channel", "Phone"), new("Outcome", "Completed"), new("Activity Date", "5 days ago"), new("Created By", "Amy Scott"), new("Notes", "Discussed upcoming renewal. Client wants to remarket Workers Comp.")]),
            NewRow("Sent renewal questionnaire", "Email - Completed - Amy Scott", "12 days ago", "bi-envelope", selected, [new("Category", "Email"), new("Channel", "Email"), new("Outcome", "Completed"), new("Activity Date", "12 days ago"), new("Created By", "Amy Scott"), new("Notes", "ACORD 125 renewal questionnaire sent to insured.")]),
            NewRow("Claim follow-up CLM-2024-0312", "Phone - Pending - Amy Scott", "18 days ago", "bi-exclamation-circle", selected, [new("Category", "Claim"), new("Channel", "Phone"), new("Outcome", "Pending"), new("Activity Date", "18 days ago"), new("Created By", "Amy Scott"), new("Notes", "Adjuster update pending. Reserve set at $18,500.")]),
            NewRow("Certificate issued #1001", "Portal - Completed - Amy Scott", "30 days ago", "bi-award", selected, [new("Category", "Endorsement"), new("Channel", "Portal"), new("Outcome", "Completed"), new("Activity Date", "30 days ago"), new("Created By", "Amy Scott"), new("Notes", "ACORD 25 certificate issued for ABC Contractor.")]),
            NewRow("Mid-term review meeting", "In-Person - Completed - James Miller", "60 days ago", "bi-calendar-check", selected, [new("Category", "Meeting"), new("Channel", "In-Person"), new("Outcome", "Completed"), new("Activity Date", "60 days ago"), new("Created By", "James Miller"), new("Notes", "Reviewed coverage adequacy. Recommended umbrella limit increase.")]),
            NewRow("Policy bound", "Portal - Completed - James Miller", "05/26/2024", "bi-check2-circle", selected, [new("Category", "Note"), new("Channel", "Portal"), new("Outcome", "Completed"), new("Activity Date", "05/26/2024"), new("Created By", "James Miller"), new("Notes", "Policy bound with Travelers. Binder issued.")])
        ];
    }

    private static ScheduleRow NewRow(string title, string subtitle, string meta, string icon, string selected, IReadOnlyList<FieldRow> fields, string? key = null)
    {
        var matchKey = key ?? title;
        return new(title, subtitle, meta, icon, fields, string.Equals(selected, matchKey, StringComparison.OrdinalIgnoreCase) || string.Equals(Uri.UnescapeDataString(selected), title, StringComparison.OrdinalIgnoreCase));
    }

    private void SelectRow(ScheduleRow row)
    {
        var query = RouteKind switch
        {
            "drivers" => $"license={Uri.EscapeDataString(row.Fields.First(f => f.Label == "License").Value)}",
            "locations" => $"location={Uri.EscapeDataString(row.Fields.First(f => f.Label == "Location #").Value)}",
            "activity" => $"subject={Uri.EscapeDataString(row.Title)}",
            _ => $"item={Uri.EscapeDataString(row.Title)}"
        };

        Nav.NavigateTo($"/policies/{PolicyId}/{RouteKind}?{query}");
    }

    private void BackToPolicy() => Nav.NavigateTo($"/policies/{PolicyId}");

    private void GoToCompare() => Nav.NavigateTo($"/policies/{PolicyId}/compare");

    private sealed record Metric(string Label, string Value, string Icon);
    private sealed record FieldRow(string Label, string Value);
    private sealed record ScheduleRow(string Title, string Subtitle, string Meta, string Icon, IReadOnlyList<FieldRow> Fields, bool IsSelected);
}
