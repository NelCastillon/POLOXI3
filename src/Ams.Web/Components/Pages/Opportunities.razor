@page "/opportunities"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>Opportunities</PageTitle>

<AppPageHeader Title="Opportunities" Icon="bi-graph-up-arrow" />

<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>

@if (_items is null)
{
    <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>

            <GridColumn Field="@nameof(OpportunityDto.OpportunityNumber)" HeaderText="Opportunity #" Width="150"></GridColumn>
            <GridColumn Field="@nameof(OpportunityDto.OpportunityName)" HeaderText="Opportunity Name" Width="200"></GridColumn>
            <GridColumn Field="@nameof(OpportunityDto.AccountName)" HeaderText="Account" Width="180"></GridColumn>
            <GridColumn Field="@nameof(OpportunityDto.EstimatedAmount)" HeaderText="Est. Amount" Format="C2" Width="140"></GridColumn>
            <GridColumn Field="@nameof(OpportunityDto.WinProbability)" HeaderText="Win %" Format="N1" Width="90"></GridColumn>
            <GridColumn Field="@nameof(OpportunityDto.ForecastCategoryCode)" HeaderText="Forecast" Width="120"></GridColumn>
            <GridColumn Field="@nameof(OpportunityDto.CloseDate)" HeaderText="Close Date" Type="ColumnType.DateTime" Format="d" Width="120"></GridColumn>
            <GridColumn Field="@nameof(OpportunityDto.StatusCode)" HeaderText="Status" Width="100"></GridColumn>

        </GridColumns>
    </SfGrid>
}

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private List<OpportunityDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchOpportunitiesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<OpportunityDto>();
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
