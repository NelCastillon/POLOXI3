@page "/admin/system/sla"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>SLA Policy Setup — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="3500" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="SLA Policy Setup"
               Subtitle="Define service-level targets for tasks, claims, renewals, and client communications"
               Icon="bi-stopwatch">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="()=>_showCreate=true"><i class="bi bi-plus-lg" aria-hidden="true"></i> New SLA Policy</button>
    </Actions>
</AppPageHeader>

<div class="sla-grid">
    @foreach (var policy in _policies)
    {
        <div class="sla-card @(policy.IsActive?"":"sla-inactive")">
            <div class="sla-card-hdr">
                <div class="sla-icon @CategoryCss(policy.Category)"><i class="bi bi-@CategoryIcon(policy.Category)" aria-hidden="true"></i></div>
                <div class="sla-card-meta">
                    <div class="sla-card-name">@policy.Name</div>
                    <div class="sla-card-cat">@policy.Category</div>
                </div>
                <label class="sla-toggle">
                    <input type="checkbox" @bind="policy.IsActive" />
                    <span class="sla-thumb"></span>
                </label>
            </div>
            <div class="sla-targets">
                <div class="sla-target"><div class="sla-tl">Response target</div><div class="sla-tv">@policy.ResponseTarget</div></div>
                <div class="sla-target"><div class="sla-tl">Resolution target</div><div class="sla-tv">@policy.ResolutionTarget</div></div>
                <div class="sla-target"><div class="sla-tl">Escalate after</div><div class="sla-tv">@policy.EscalationAt</div></div>
                <div class="sla-target"><div class="sla-tl">Priority</div><div class="sla-tv"><span class="sla-pri sla-pri-@policy.Priority.ToLower()">@policy.Priority</span></div></div>
            </div>
            <div class="sla-desc">@policy.Description</div>
            <div class="sla-card-footer">
                <div class="sla-compliance"><div class="sla-compliance-bar"><div class="sla-compliance-fill @ComplianceCss(policy.ComplianceRate)" style="width:@policy.ComplianceRate%"></div></div><span class="sla-compliance-pct">@policy.ComplianceRate% compliance</span></div>
                <button class="um-btn um-btn-ghost um-btn-xs"><i class="bi bi-pencil" aria-hidden="true"></i></button>
            </div>
        </div>
    }
    <div class="sla-new-card" @onclick="()=>_showCreate=true">
        <i class="bi bi-plus-circle sla-new-icon" aria-hidden="true"></i>
        <span>New SLA Policy</span>
    </div>
</div>

<SfDialog @bind-Visible="_showCreate" Width="440px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>New SLA Policy</Header>
        <Content>
            <div class="sla-dlg">
                <label class="sla-dlg-label">Policy Name</label><input class="sla-dlg-input" placeholder="e.g. Commercial Claims — High Priority" />
                <label class="sla-dlg-label">Category</label>
                <select class="sla-dlg-input"><option>Claims</option><option>Renewals</option><option>Tasks</option><option>Compliance</option><option>Communications</option></select>
                <label class="sla-dlg-label">Response Target</label><input class="sla-dlg-input" placeholder="e.g. 4 hours" />
                <label class="sla-dlg-label">Resolution Target</label><input class="sla-dlg-input" placeholder="e.g. 3 business days" />
                <label class="sla-dlg-label">Escalate After</label><input class="sla-dlg-input" placeholder="e.g. 24 hours" />
                <label class="sla-dlg-label">Priority</label>
                <select class="sla-dlg-input"><option>High</option><option>Medium</option><option>Low</option></select>
            </div>
        </Content>
        <FooterTemplate>
            <button class="um-btn um-btn-ghost" @onclick="()=>_showCreate=false">Cancel</button>
            <button class="um-btn um-btn-primary" @onclick="CommitCreate"><i class="bi bi-check2" aria-hidden="true"></i> Save Policy</button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    private SfToast? _toast;
    private bool _showCreate;

    private List<SlaPolicy> _policies = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Administration","/admin"), new("SLA Policy Setup",""));
        _policies =
        [
            new SlaPolicy { Id=1, Name="Commercial Claims — High Priority", Category="Claims",         Priority="High",   ResponseTarget="2 hours",      ResolutionTarget="5 business days",  EscalationAt="8 hours",  ComplianceRate=92, IsActive=true,  Description="Applies to commercial lines claims with reserve > $25K. Triggers CAT protocol when applicable." },
            new SlaPolicy { Id=2, Name="Personal Lines Renewals",           Category="Renewals",       Priority="Medium", ResponseTarget="24 hours",     ResolutionTarget="30 days from expiry",EscalationAt="72 hours", ComplianceRate=97, IsActive=true,  Description="Standard renewal workflow SLA for personal lines policies." },
            new SlaPolicy { Id=3, Name="Client Communication Response",     Category="Communications", Priority="High",   ResponseTarget="4 hours",      ResolutionTarget="Same business day", EscalationAt="8 hours",  ComplianceRate=88, IsActive=true,  Description="SLA for inbound client emails, portal messages, and phone inquiries." },
            new SlaPolicy { Id=4, Name="Compliance Acknowledgement Deadline",Category="Compliance",  Priority="High",   ResponseTarget="5 business days",ResolutionTarget="10 business days",EscalationAt="3 days",   ComplianceRate=99, IsActive=true,  Description="Required signature acknowledgements for compliance documents." },
            new SlaPolicy { Id=5, Name="Task Completion — Standard",        Category="Tasks",          Priority="Low",    ResponseTarget="N/A",          ResolutionTarget="5 business days",  EscalationAt="3 days",   ComplianceRate=84, IsActive=true,  Description="Default SLA for general producer and CSR tasks." },
            new SlaPolicy { Id=6, Name="New Business Application Review",   Category="Renewals",       Priority="Medium", ResponseTarget="48 hours",     ResolutionTarget="10 business days", EscalationAt="72 hours", ComplianceRate=91, IsActive=false, Description="SLA for reviewing submitted applications for new business." },
        ];
    }

    private async Task CommitCreate()
    {
        _showCreate = false;
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = "SLA policy created.", CssClass = "e-toast-success" });
    }

    private static string CategoryIcon(string c) => c switch { "Claims"=>"exclamation-circle","Renewals"=>"arrow-clockwise","Communications"=>"envelope","Compliance"=>"patch-check","Tasks"=>"check2-square",_=>"stopwatch" };
    private static string CategoryCss(string c)  => c switch { "Claims"=>"sla-ic-red","Renewals"=>"sla-ic-blue","Communications"=>"sla-ic-purple","Compliance"=>"sla-ic-green","Tasks"=>"sla-ic-amber",_=>"sla-ic-grey" };
    private static string ComplianceCss(int r)   => r >= 95 ? "sla-cf-green" : r >= 80 ? "sla-cf-amber" : "sla-cf-red";

    private sealed class SlaPolicy { public int Id{get;set;} public string Name{get;set;}=string.Empty; public string Category{get;set;}=string.Empty; public string Priority{get;set;}=string.Empty; public string ResponseTarget{get;set;}=string.Empty; public string ResolutionTarget{get;set;}=string.Empty; public string EscalationAt{get;set;}=string.Empty; public int ComplianceRate{get;set;} public bool IsActive{get;set;} public string Description{get;set;}=string.Empty; }
}
