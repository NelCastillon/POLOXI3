    private sealed class AckRow
    {
        public Guid MenuId { get; init; }
        public Guid PolicyDocumentId { get; init; }
        public string PolicyCode { get; init; } = string.Empty;
        public string PolicyTitle { get; init; } = string.Empty;
        public string PolicyTypeCode { get; init; } = string.Empty;
        public string Version { get; init; } = string.Empty;
        public DateTime? EffectiveDateUtc { get; init; }
        public DateTime? PublishedDateUtc { get; init; }
        public DateTime? AcknowledgedDateUtc { get; init; }
        public string PrimaryPerson { get; init; } = string.Empty;
        public string UserEmail { get; init; } = string.Empty;
        public string? Channel { get; init; }
        public string? IpAddress { get; init; }
        public int DaysOverdue { get; init; }
        public string State { get; init; } = string.Empty;
        public string Icon { get; init; } = string.Empty;
        public bool IsAcknowledged => AcknowledgedDateUtc is not null;
        public string LifecycleText => State switch
        {
            "Overdue" => $"{DaysOverdue} day{(DaysOverdue == 1 ? string.Empty : "s")} overdue",
            "Acknowledged" => AcknowledgedDateUtc?.ToLocalTime().ToString("MM/dd/yyyy h:mm tt") ?? "Acknowledged",
            _ => "Waiting for acknowledgement"
        };
        public string Description => State switch
        {
            "Overdue" => $"{PrimaryPerson} has not acknowledged this policy and the effective date has passed.",
            "Acknowledged" => $"{PrimaryPerson} acknowledged this policy through {Channel ?? "an unknown channel"}.",
            _ => $"{PrimaryPerson} is in the required audience and acknowledgement is pending."
        };

        public static AckRow FromPending(PendingAcknowledgementDto row) => new()
        {
            MenuId = row.AudienceId,
            PolicyDocumentId = row.PolicyDocumentId,
            PolicyCode = row.PolicyCode,
            PolicyTitle = row.PolicyTitle,
            PolicyTypeCode = row.PolicyTypeCode,
            Version = row.Version,
            EffectiveDateUtc = row.EffectiveDateUtc,
            PublishedDateUtc = row.PublishedDateUtc,
            PrimaryPerson = row.TargetName,
            DaysOverdue = row.DaysOverdue,
            State = row.DaysOverdue > 0 ? "Overdue" : "Pending",
            Icon = row.DaysOverdue > 0 ? "bi-exclamation-circle-fill" : "bi-hourglass-split"
        };

        public static AckRow FromAcknowledged(AcknowledgementDetailDto row) => new()
        {
            MenuId = row.AcknowledgementId,
            PolicyDocumentId = row.PolicyDocumentId,
            PolicyCode = row.PolicyCode,
            PolicyTitle = row.PolicyTitle,
            PolicyTypeCode = row.PolicyTypeCode,
            Version = row.Version,
            PrimaryPerson = row.UserFullName,
            UserEmail = row.UserEmail,
            AcknowledgedDateUtc = row.AcknowledgedDateUtc,
            Channel = row.Channel,
            IpAddress = row.IpAddress,
            State = "Acknowledged",
            Icon = "bi-check-circle-fill"
        };

        public static AckRow FromPolicy(PolicyDocumentDto row) => new()
        {
            MenuId = row.PolicyDocumentId,
            PolicyDocumentId = row.PolicyDocumentId,
            PolicyCode = row.PolicyCode,
            PolicyTitle = row.PolicyTitle,
            PolicyTypeCode = row.PolicyTypeCode,
            Version = row.Version,
            EffectiveDateUtc = row.EffectiveDateUtc,
            PublishedDateUtc = row.PublishedDateUtc,
            PrimaryPerson = row.OwnedByFullName ?? "Policy audience",
            State = "Policy",
            Icon = "bi-file-earmark-check-fill"
        };
    }
