@page "/compliance/acknowledgements"
@using System.Text
@using Ams.Application.Common.Dtos
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.Web
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Policy Acknowledgements - Compliance</PageTitle>

@if (_toastVisible)
{
    <div class="pa-toast pa-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="pa-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="pa-enterprise-page" @onclick="CloseActionMenu">
    <section class="pa-hero" aria-label="Policy acknowledgements dashboard header">
        <div class="pa-hero-left">
            <div class="pa-hero-icon"><i class="bi bi-check2-all" aria-hidden="true"></i></div>
            <div>
                <div class="pa-title-row">
                    <h1>Policy Acknowledgements</h1>
                    <span><i class="bi bi-list-check" aria-hidden="true"></i>@VisibleCount visible</span>
                    @if (HasFilters)
                    {
                        <span><i class="bi bi-funnel-fill" aria-hidden="true"></i>Filtered</span>
                    }
                </div>
                <p>Enterprise acknowledgement evidence center for pending obligations, overdue follow-up, completed attestations, policy audience coverage, and compliance workflow synchronization.</p>
            </div>
        </div>
        <div class="pa-hero-actions">
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="RefreshAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "pa-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => Nav.NavigateTo("/compliance/policies")'><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Compliance Policies</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger pa-load-error" style="border-left: 4px solid #dc3545; animation: pa-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError</div>
    }

    <div class="pa-kpi-strip">
        <button type="button" class="@PendingKpiClass" title="Awaiting attestation" @onclick="@(() => SetPendingView())">
            <div class="pa-kpi-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></div>
            <div><span class="pa-kpi-val">@(_summary?.TotalPending ?? 0)</span><span class="pa-kpi-lbl">Pending</span><small>Awaiting attestation</small></div>
        </button>
        <button type="button" class="@OverdueKpiClass" title="Needs follow-up" @onclick="@(() => SetOverdueView())">
            <div class="pa-kpi-icon"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i></div>
            <div><span class="pa-kpi-val">@(_summary?.TotalOverdue ?? 0)</span><span class="pa-kpi-lbl">Overdue</span><small>Needs follow-up</small></div>
        </button>
        <button type="button" class="@AcknowledgedKpiClass" title="Evidence captured" @onclick="@(() => SetAcknowledgedView())">
            <div class="pa-kpi-icon"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></div>
            <div><span class="pa-kpi-val">@(_summary?.TotalAcknowledged ?? 0)</span><span class="pa-kpi-lbl">Acknowledged</span><small>Evidence captured</small></div>
        </button>
        <button type="button" class="@PoliciesKpiClass" title="Published coverage" @onclick="@(() => SetPoliciesView())">
            <div class="pa-kpi-icon"><i class="bi bi-file-earmark-check-fill" aria-hidden="true"></i></div>
            <div><span class="pa-kpi-val">@(_summary?.TotalPoliciesWithAudience ?? 0)</span><span class="pa-kpi-lbl">Policies</span><small>Published coverage</small></div>
        </button>
        <button type="button" class="@BoardKpiClass" title="Workflow lanes" @onclick="@(() => SetBoardView())">
            <div class="pa-kpi-icon"><i class="bi bi-kanban" aria-hidden="true"></i></div>
            <div><span class="pa-kpi-val">@BoardGroups.Sum(g => g.Items.Count)</span><span class="pa-kpi-lbl">Board</span><small>Workflow lanes</small></div>
        </button>
        <button type="button" class="@AnalyticsKpiClass" title="Type insights" @onclick="@(() => SetAnalyticsView())">
            <div class="pa-kpi-icon"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></div>
            <div><span class="pa-kpi-val">@PolicyTypeBreakdown.Count</span><span class="pa-kpi-lbl">Analytics</span><small>Type insights</small></div>
        </button>
    </div>

    <div class="pa-workflow-strip" aria-label="Acknowledgement workflow shortcuts">
        @foreach (var shortcut in WorkflowShortcuts)
        {
            <button type="button" class="pa-workflow-card" @onclick="() => ExecuteShortcut(shortcut)">
                <i class="bi @shortcut.Icon" aria-hidden="true"></i>
                <span><strong>@shortcut.Title</strong><small>@shortcut.Subtitle</small></span>
            </button>
        }
    </div>

    <div class="pa-search-panel" role="search" aria-label="Search policy acknowledgements">
        <div class="pa-search-wrap">
            <div class="pa-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
            <div class="pa-search-body">
                <label for="pa-search-input">Enterprise search</label>
                <input id="pa-search-input" class="pa-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search policy, code, type, audience, user, email, channel, IP..." />
                <span class="pa-search-hint">Searches acknowledgement workflow, policy, audience, user, and completion fields as you type.</span>
            </div>
        </div>
        <select class="pa-filter-select" @bind="TypeFilter" aria-label="Filter by policy type">
            <option value="">All types</option>
            @foreach (var type in PolicyTypes)
            {
                <option value="@type">@type</option>
            }
        </select>
        <div class="pa-search-result"><strong>@VisibleCount</strong><span>matches</span></div>
        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
    </div>

    <div class="pa-bulk-bar">
        <span><i class="bi bi-sliders" aria-hidden="true"></i> @ActiveViewLabel acknowledgement workspace</span>
        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetView("overdue")'><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Overdue queue</button>
        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetView("policies")'><i class="bi bi-file-earmark-check" aria-hidden="true"></i> Coverage</button>
        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies")'><i class="bi bi-shield-check" aria-hidden="true"></i> Policy Ops</button>
    </div>

    <div class="pa-view-tabs" role="tablist" aria-label="Acknowledgement views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="pa-view-btn @(_activeView == tab.Key ? "pa-view-btn-active" : null)" role="tab" aria-selected="@(_activeView == tab.Key)" @onclick="() => SetView(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                @tab.Label
                <span>@TabCount(tab.Key)</span>
            </button>
        }
    </div>

    <div class="pa-content-layout">
        <section class="pa-main-card" aria-label="Policy acknowledgement records">
            @if (_loading)
            {
                <div class="pa-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Loading acknowledgements...</span></div>
            }
            else if (_activeView == "policies")
            {
                @PolicyOverview()
            }
            else if (_activeView == "board")
            {
                @BoardView()
            }
            else if (_activeView == "analytics")
            {
                @AnalyticsView()
            }
            else
            {
                @AcknowledgementTable()
            }
        </section>

        <aside class="pa-detail-card" aria-label="Selected acknowledgement details">
            @if (_drawerItem is null)
            {
                <div class="pa-detail-empty">
                    <i class="bi bi-check2-all" aria-hidden="true"></i>
                    <strong>Select an acknowledgement</strong>
                    <span>Click a row or board card to inspect policy, audience, evidence, and workflow actions.</span>
                </div>
            }
            else
            {
                <div class="pa-detail-head">
                    <div>
                        <span class="pa-detail-eyebrow"><i class="bi @_drawerItem.Icon" aria-hidden="true"></i>@_drawerItem.State</span>
                        <h2>@_drawerItem.PolicyTitle</h2>
                        <p>@_drawerItem.PolicyCode - @_drawerItem.PolicyTypeCode - v@_drawerItem.Version</p>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseDrawer"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="pa-detail-body">
                    <div class="pa-detail-summary">
                        <div><span>Person/Audience</span><strong>@_drawerItem.PrimaryPerson</strong></div>
                        <div><span>Lifecycle</span><strong>@_drawerItem.LifecycleText</strong></div>
                        <div><span>Effective</span><strong>@(_drawerItem.EffectiveDateUtc?.ToLocalTime().ToString("MM/dd/yyyy") ?? "None")</strong></div>
                        <div><span>Acknowledged</span><strong>@(_drawerItem.AcknowledgedDateUtc?.ToLocalTime().ToString("MM/dd/yyyy h:mm tt") ?? "Pending")</strong></div>
                    </div>
                    <section class="pa-detail-timeline">
                        <h3><i class="bi bi-card-checklist" aria-hidden="true"></i>Workflow Context</h3>
                        <p>@_drawerItem.Description</p>
                    </section>
                    <section class="pa-detail-timeline">
                        <h3><i class="bi bi-fingerprint" aria-hidden="true"></i>Evidence</h3>
                        <div class="pa-mini-item"><strong>@(_drawerItem.Channel ?? "No channel")</strong><span>@(_drawerItem.IpAddress ?? "No IP captured") - @(_drawerItem.UserEmail ?? "No email")</span></div>
                    </section>
                    <div class="pa-detail-actions">
                        <div class="pa-detail-actions-row">
                            <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenPolicy(_drawerItem.PolicyDocumentId)"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open</button>
                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => FilterByPolicy(_drawerItem.PolicyDocumentId, _drawerItem.PolicyTitle)"><i class="bi bi-funnel" aria-hidden="true"></i> Policy</button>
                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => FilterByType(_drawerItem.PolicyTypeCode)"><i class="bi bi-tags" aria-hidden="true"></i> Type</button>
                        </div>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export Current View</button>
                    </div>
                </div>
            }
        </aside>
    </div>
</div>

@if (_openActionMenuFor is not null)
{
    <div class="pa-context-menu" style="left:@_menuXpx; top:@_menuYpx" @onclick:stopPropagation="true">
        <button type="button" @onclick='() => ExecuteMenuAction("View")'><i class="bi bi-eye" aria-hidden="true"></i><span>View details</span></button>
        <button type="button" @onclick='() => ExecuteMenuAction("OpenPolicy")'><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span>Open policy</span></button>
        <button type="button" @onclick='() => ExecuteMenuAction("FilterPolicy")'><i class="bi bi-funnel" aria-hidden="true"></i><span>Filter this policy</span></button>
        <button type="button" @onclick='() => ExecuteMenuAction("FilterType")'><i class="bi bi-tags" aria-hidden="true"></i><span>Filter this type</span></button>
        <button type="button" @onclick='() => ExecuteMenuAction("Export")'><i class="bi bi-download" aria-hidden="true"></i><span>Export current view</span></button>
    </div>
}

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading = true;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string? _searchText;
    private string? _filterType;
    private Guid? _policyFilterId;
    private string? _policyFilterTitle;
    private string _activeView = "pending";
    private Guid? _openActionMenuFor;
    private string _menuXpx = "0px";
    private string _menuYpx = "0px";
    private int _page = 1;
    private int _ackedPage = 1;
    private const int PageSize = 20;

    private AcknowledgementSummaryDto? _summary;
    private List<PendingAcknowledgementDto> _pendingAll = [];
    private List<PendingAcknowledgementDto> _overdueAll = [];
    private PagedResult<AcknowledgementDetailDto> _acknowledged = new();
    private List<PolicyDocumentDto> _policies = [];
    private AckRow? _selected;
    private AckRow? _drawerItem;

    private static readonly string[] PolicyTypes = ["Information Security", "Privacy", "Human Resources", "Finance", "Operations", "Compliance", "IT Governance"];

    private readonly TabDef[] _tabs =
    [
        new("pending", "Pending", "bi-hourglass-split"),
        new("overdue", "Overdue", "bi-exclamation-circle"),
        new("acknowledged", "Acknowledged", "bi-check-circle"),
        new("policies", "Policies", "bi-file-earmark-check"),
        new("board", "Board", "bi-kanban"),
        new("analytics", "Analytics", "bi-bar-chart-line")
    ];

    private readonly ShortcutDef[] WorkflowShortcuts =
    [
        new("bi-exclamation-triangle", "Overdue follow-up", "Prioritize missed attestations", "overdue"),
        new("bi-file-earmark-text", "Policy coverage", "Inspect published policies", "policies"),
        new("bi-download", "Evidence export", "Export current workspace", "export"),
        new("bi-shield-check", "Policy operations", "Open policy workbench", "policyOps")
    ];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Compliance", "/compliance"), new("Acknowledgements", null));
        await LoadAsync();
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var summaryTask = Api.GetAcknowledgementSummaryAsync(_tenantId);
            var pendingTask = Api.GetPendingAcknowledgementsAsync(_tenantId);
            var overdueTask = Api.GetOverdueAcknowledgementsAsync(_tenantId);
            var ackedTask = Api.SearchAcknowledgedAsync(_tenantId, searchTerm: SearchOrNull, pageNumber: _ackedPage, pageSize: PageSize);
            var policiesTask = Api.SearchPolicyDocumentsAsync(_tenantId, statusCode: "Published", pageNumber: 1, pageSize: 500);

            await Task.WhenAll(summaryTask, pendingTask, overdueTask, ackedTask, policiesTask);

            _summary = await summaryTask ?? new();
            _pendingAll = (await pendingTask)?.ToList() ?? [];
            _overdueAll = (await overdueTask)?.ToList() ?? [];
            _acknowledged = await ackedTask ?? new();
            _policies = (await policiesTask)?.Items.ToList() ?? [];
            _page = 1;
        }
        catch (Exception ex)
        {
            _summary = new();
            _pendingAll = [];
            _overdueAll = [];
            _acknowledged = new();
            _policies = [];
            _loadError = $"Failed to load acknowledgements: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        _searchText = null;
        _filterType = null;
        _policyFilterId = null;
        _policyFilterTitle = null;
        _page = 1;
        _ackedPage = 1;
        await LoadAsync();
    }

    private string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            _page = 1;
            if (_activeView == "acknowledged")
            {
                _ackedPage = 1;
                _ = ReloadAckedAsync();
            }
        }
    }

    private string? SearchOrNull => string.IsNullOrWhiteSpace(_searchText) ? null : _searchText.Trim();
    private bool HasFilters => !string.IsNullOrWhiteSpace(_searchText) || !string.IsNullOrWhiteSpace(_filterType) || _policyFilterId is not null || _activeView != "pending";
    private int VisibleCount => _activeView == "policies" ? FilteredPolicies.Count : FilteredRows.Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(VisibleCount / (double)PageSize));
    private const string PendingView = "pending";
    private const string OverdueView = "overdue";
    private const string AcknowledgedView = "acknowledged";
    private const string PoliciesView = "policies";
    private const string BoardViewKey = "board";
    private const string AnalyticsViewKey = "analytics";
    private string KpiClass(string cssClass, string viewKey) => $"pa-kpi-card {cssClass} {(_activeView == viewKey ? "pa-kpi-card--active" : string.Empty)}";
    private string PendingKpiClass => KpiClass("pa-amber", PendingView);
    private string OverdueKpiClass => KpiClass("pa-red", OverdueView);
    private string AcknowledgedKpiClass => KpiClass("pa-green", AcknowledgedView);
    private string PoliciesKpiClass => KpiClass("pa-blue", PoliciesView);
    private string BoardKpiClass => KpiClass("pa-purple", BoardViewKey);
    private string AnalyticsKpiClass => KpiClass("pa-cyan", AnalyticsViewKey);
    private void SetPendingView() => SetView(PendingView);
    private void SetOverdueView() => SetView(OverdueView);
    private void SetAcknowledgedView() => SetView(AcknowledgedView);
    private void SetPoliciesView() => SetView(PoliciesView);
    private void SetBoardView() => SetView(BoardViewKey);
    private void SetAnalyticsView() => SetView(AnalyticsViewKey);
    private string ActiveViewLabel => _activeView switch
    {
        "overdue" => "Overdue",
        "acknowledged" => "Acknowledged",
        "policies" => "Active policy",
        "board" => "Workflow board",
        "analytics" => "Analytics",
        _ => "Pending"
    };
    private string ActiveViewIcon => _activeView switch
    {
        "overdue" => "bi-exclamation-circle-fill",
        "acknowledged" => "bi-check-circle-fill",
        "policies" => "bi-file-earmark-check-fill",
        "board" => "bi-kanban",
        "analytics" => "bi-bar-chart-line",
        _ => "bi-hourglass-split"
    };
    private string ActiveViewDescription => _activeView switch
    {
        "overdue" => "Prioritize overdue acknowledgement obligations by policy, audience, and target user.",
        "acknowledged" => "Review completed acknowledgements with channel, timestamp, and user evidence.",
        "policies" => "Monitor policy-level acknowledgement completion and audience coverage.",
        "board" => "Manage acknowledgement workflow lanes from pending through completed evidence.",
        "analytics" => "Analyze acknowledgement exposure by policy type and lifecycle state.",
        _ => "Review pending acknowledgement obligations and follow up by policy or audience."
    };
    private IEnumerable<AckRow> CurrentRows => _activeView switch
    {
        "overdue" => _overdueAll.Select(AckRow.FromPending),
        "acknowledged" => _acknowledged.Items.Select(AckRow.FromAcknowledged),
        _ => _pendingAll.Select(AckRow.FromPending)
    };
    private List<AckRow> FilteredRows => CurrentRows.Where(MatchesFilters).ToList();
    private List<AckRow> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    private List<PolicyDocumentDto> FilteredPolicies => _policies.Where(MatchesPolicyFilters).ToList();
    private List<PolicyDocumentDto> PagedPolicies => FilteredPolicies.Skip((_page - 1) * PageSize).Take(PageSize).ToList();

    private string? TypeFilter
    {
        get => _filterType;
        set
        {
            _filterType = string.IsNullOrWhiteSpace(value) ? null : value;
            _page = 1;
        }
    }

    private IReadOnlyList<BoardGroup> BoardGroups =>
    [
        new("Pending", _pendingAll.Select(AckRow.FromPending).Where(MatchesFilters).Where(r => r.State == "Pending").ToList()),
        new("Overdue", _overdueAll.Select(AckRow.FromPending).Where(MatchesFilters).ToList()),
        new("Acknowledged", _acknowledged.Items.Select(AckRow.FromAcknowledged).Where(MatchesFilters).ToList()),
        new("Policies", FilteredPolicies.Select(AckRow.FromPolicy).ToList())
    ];

    private IReadOnlyList<BreakdownItem> PolicyTypeBreakdown => BuildBreakdown(
        _pendingAll.Select(AckRow.FromPending)
            .Concat(_overdueAll.Select(AckRow.FromPending))
            .Concat(_acknowledged.Items.Select(AckRow.FromAcknowledged))
            .Where(MatchesFilters)
            .GroupBy(r => string.IsNullOrWhiteSpace(r.PolicyTypeCode) ? "Other" : r.PolicyTypeCode));

    private IReadOnlyList<BreakdownItem> StateBreakdown => BuildBreakdown(
        _pendingAll.Select(AckRow.FromPending)
            .Concat(_overdueAll.Select(AckRow.FromPending))
            .Concat(_acknowledged.Items.Select(AckRow.FromAcknowledged))
            .Where(MatchesFilters)
            .GroupBy(r => r.State));

    private void SetView(string key)
    {
        _activeView = key;
        _page = 1;
        if (key == "acknowledged")
        {
            _ = ReloadAckedAsync();
        }
    }

    private int TabCount(string key) => key switch
    {
        "pending" => _pendingAll.Count,
        "overdue" => _overdueAll.Count,
        "acknowledged" => _acknowledged.TotalCount,
        "policies" => _policies.Count,
        "board" => BoardGroups.Sum(g => g.Items.Count),
        "analytics" => PolicyTypeBreakdown.Count,
        _ => 0
    };

    private bool MatchesFilters(AckRow row)
    {
        if (!string.IsNullOrWhiteSpace(_filterType) && !string.Equals(row.PolicyTypeCode, _filterType, StringComparison.OrdinalIgnoreCase)) return false;
        if (_policyFilterId is not null && row.PolicyDocumentId != _policyFilterId) return false;
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        var s = _searchText.Trim();
        return Contains(row.PolicyCode, s) || Contains(row.PolicyTitle, s) || Contains(row.PolicyTypeCode, s) || Contains(row.PrimaryPerson, s) || Contains(row.UserEmail, s) || Contains(row.Channel, s) || Contains(row.IpAddress, s);
    }

    private bool MatchesPolicyFilters(PolicyDocumentDto row)
    {
        if (!string.IsNullOrWhiteSpace(_filterType) && !string.Equals(row.PolicyTypeCode, _filterType, StringComparison.OrdinalIgnoreCase)) return false;
        if (_policyFilterId is not null && row.PolicyDocumentId != _policyFilterId) return false;
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        var s = _searchText.Trim();
        return Contains(row.PolicyCode, s) || Contains(row.PolicyTitle, s) || Contains(row.PolicyTypeCode, s) || Contains(row.OwnedByFullName, s) || Contains(row.StatusCode, s);
    }

    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private void ClearFilters()
    {
        _searchText = null;
        _filterType = null;
        _policyFilterId = null;
        _policyFilterTitle = null;
        _activeView = "pending";
        _page = 1;
    }

    private void FilterByPolicy(Guid policyId, string policyTitle)
    {
        _policyFilterId = policyId;
        _policyFilterTitle = policyTitle;
        _page = 1;
        CloseDrawer();
        ShowToast($"Filtered to {policyTitle}.");
    }

    private void FilterByType(string type)
    {
        _filterType = type;
        _page = 1;
        CloseDrawer();
        ShowToast($"Filtered to {type} policies.");
    }

    private void ExecuteShortcut(ShortcutDef shortcut)
    {
        switch (shortcut.Action)
        {
            case "overdue":
                SetView("overdue");
                break;
            case "policies":
                SetView("policies");
                break;
            case "export":
                _ = ExportAsync();
                break;
            case "policyOps":
                Nav.NavigateTo("/policies");
                break;
        }
    }

    private void PreviousPage() => _page = Math.Max(1, _page - 1);
    private void NextPage() => _page = Math.Min(TotalPages, _page + 1);

    private async Task ReloadAckedAsync()
    {
        try
        {
            _acknowledged = await Api.SearchAcknowledgedAsync(_tenantId, _policyFilterId, SearchOrNull, _ackedPage, PageSize) ?? new();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load acknowledged records: {ex.Message}";
            ShowToast($"Acknowledged load failed: {ex.Message}", "danger");
        }
    }

    private void OpenDrawer(AckRow row)
    {
        _selected = row;
        _drawerItem = row;
    }

    private void CloseDrawer() => _drawerItem = null;
    private void OpenPolicy(Guid policyId) => Nav.NavigateTo($"/compliance/policies/{policyId}");

    private void OpenActionMenu(AckRow row, MouseEventArgs args)
    {
        _selected = row;
        _openActionMenuFor = row.MenuId;
        _menuXpx = $"{Math.Min(args.ClientX, 1420)}px";
        _menuYpx = $"{Math.Min(args.ClientY, 820)}px";
    }

    private void CloseActionMenu() => _openActionMenuFor = null;

    private void ExecuteMenuAction(string action)
    {
        var row = _selected;
        CloseActionMenu();
        if (row is null) return;

        switch (action)
        {
            case "View":
                OpenDrawer(row);
                break;
            case "OpenPolicy":
                OpenPolicy(row.PolicyDocumentId);
                break;
            case "FilterPolicy":
                FilterByPolicy(row.PolicyDocumentId, row.PolicyTitle);
                break;
            case "FilterType":
                FilterByType(row.PolicyTypeCode);
                break;
            case "Export":
                _ = ExportAsync();
                break;
        }
    }

    private Task ExportAsync()
    {
        var csv = new StringBuilder();
        csv.AppendLine("State,Policy Code,Policy Title,Type,Version,Person,Email,Effective,Published,Acknowledged,Channel,IP,Days Overdue");
        foreach (var row in FilteredRows)
        {
            csv.AppendLine(string.Join(',', Csv(row.State), Csv(row.PolicyCode), Csv(row.PolicyTitle), Csv(row.PolicyTypeCode), Csv(row.Version), Csv(row.PrimaryPerson), Csv(row.UserEmail), Csv(row.EffectiveDateUtc?.ToLocalTime().ToString("MM/dd/yyyy")), Csv(row.PublishedDateUtc?.ToLocalTime().ToString("MM/dd/yyyy")), Csv(row.AcknowledgedDateUtc?.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")), Csv(row.Channel), Csv(row.IpAddress), row.DaysOverdue.ToString()));
        }
        var url = "data:text/csv;charset=utf-8," + Uri.EscapeDataString(csv.ToString());
        Nav.NavigateTo(url, forceLoad: true);
        ShowToast("Acknowledgement export generated.");
        return Task.CompletedTask;
    }

