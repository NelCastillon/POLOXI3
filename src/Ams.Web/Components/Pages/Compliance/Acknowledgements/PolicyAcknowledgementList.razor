@page "/compliance/acknowledgements"
@using System.Text
@using Ams.Application.Common.Dtos
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.Web
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Policy Acknowledgements — Compliance</PageTitle>

@if (_toastVisible)
{
    <div class="pa-toast pa-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="pa-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_drawerItem is not null)
{
    <div class="pa-drawer-backdrop" @onclick="CloseDrawer"></div>
    <aside class="pa-drawer" aria-label="Acknowledgement details">
        <div class="pa-drawer-head">
            <div>
                <h2 class="pa-drawer-title">@_drawerItem.PolicyTitle</h2>
                <span class="pa-drawer-sub">@_drawerItem.PolicyCode · @_drawerItem.PolicyTypeCode · v@_drawerItem.Version</span>
            </div>
            <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="CloseDrawer"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <div class="pa-drawer-body">
            <div class="pa-drawer-banner pa-drawer-banner--@CssSafe(_drawerItem.State)">
                <i class="bi @_drawerItem.Icon" aria-hidden="true"></i>
                <span>@_drawerItem.State</span>
                <strong>@_drawerItem.LifecycleText</strong>
            </div>
            <div class="pa-drawer-meta">
                @DrawerField("Policy", _drawerItem.PolicyCode)
                @DrawerField("Type", _drawerItem.PolicyTypeCode)
                @DrawerField("Version", _drawerItem.Version)
                @DrawerField("Effective", _drawerItem.EffectiveDateUtc?.ToLocalTime().ToString("MM/dd/yyyy") ?? "—")
                @DrawerField("Published", _drawerItem.PublishedDateUtc?.ToLocalTime().ToString("MM/dd/yyyy") ?? "—")
                @DrawerField(_drawerItem.IsAcknowledged ? "Acknowledged" : "Audience", _drawerItem.PrimaryPerson)
                @DrawerField("Channel", _drawerItem.Channel ?? "—")
                @DrawerField("IP", _drawerItem.IpAddress ?? "—")
            </div>
            <section class="pa-drawer-section">
                <h3><i class="bi bi-card-checklist" aria-hidden="true"></i> Workflow Context</h3>
                <p>@_drawerItem.Description</p>
            </section>
            <section class="pa-drawer-section">
                <h3><i class="bi bi-lightning-charge" aria-hidden="true"></i> Actions</h3>
                <div class="pa-drawer-actions">
                    <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenPolicy(_drawerItem.PolicyDocumentId)"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Policy</button>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => FilterByPolicy(_drawerItem.PolicyDocumentId, _drawerItem.PolicyTitle)"><i class="bi bi-funnel" aria-hidden="true"></i> Filter Policy</button>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => FilterByType(_drawerItem.PolicyTypeCode)"><i class="bi bi-tags" aria-hidden="true"></i> Filter Type</button>
                </div>
            </section>
        </div>
    </aside>
}

<div class="pa-enterprise-page" @onclick="CloseActionMenu">
    <div class="pa-header">
        <div class="pa-header-left">
            <div class="pa-lob-icon"><i class="bi bi-check2-all" aria-hidden="true"></i></div>
            <div class="pa-header-info">
                <div class="pa-title-row">
                    <h1 class="pa-page-title">Policy Acknowledgements</h1>
                    <span class="pa-status-pill">@VisibleCount visible</span>
                    @if (HasFilters)
                    {
                        <span class="pa-filter-pill">Filtered</span>
                    }
                </div>
                <div class="pa-sub-row">
                    <span class="pa-sub-chip"><i class="bi bi-hourglass-split" aria-hidden="true"></i>@(_summary?.TotalPending ?? 0) pending</span>
                    <span class="pa-sub-chip"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@(_summary?.TotalOverdue ?? 0) overdue</span>
                    <span class="pa-sub-chip"><i class="bi bi-check-circle" aria-hidden="true"></i>@(_summary?.TotalAcknowledged ?? 0) acknowledged</span>
                    <span class="pa-sub-chip"><i class="bi bi-file-earmark-check" aria-hidden="true"></i>@(_summary?.TotalPoliciesWithAudience ?? 0) active policies</span>
                </div>
            </div>
        </div>
        <div class="pa-header-actions">
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="RefreshAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "pa-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => Nav.NavigateTo("/compliance/policies")'><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Compliance Policies</button>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies")'><i class="bi bi-shield-check" aria-hidden="true"></i> Policy Ops</button>
        </div>
    </div>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger pa-load-error" role="alert"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError</div>
    }

    <div class="pa-kpi-strip">
        @KpiCard("bi-hourglass-split", "Pending", (_summary?.TotalPending ?? 0).ToString(), "pa-kpi-pending", "pending")
        @KpiCard("bi-exclamation-circle-fill", "Overdue", (_summary?.TotalOverdue ?? 0).ToString(), "pa-kpi-overdue", "overdue")
        @KpiCard("bi-check-circle-fill", "Acknowledged", (_summary?.TotalAcknowledged ?? 0).ToString(), "pa-kpi-acked", "acknowledged")
        @KpiCard("bi-file-earmark-check-fill", "Active Policies", (_summary?.TotalPoliciesWithAudience ?? 0).ToString(), "pa-kpi-total", "policies")
    </div>

    <div class="pa-enterprise-search" role="search" aria-label="Search policy acknowledgements">
        <div class="pa-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
        <div class="pa-search-body">
            <label for="pa-search-input">Enterprise search</label>
            <input id="pa-search-input" class="pa-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search policy, code, type, audience, user, email, channel, IP…" />
            <div class="pa-search-hint">Searches acknowledgement workflow, policy, audience, user, and completion fields as you type.</div>
        </div>
        <div class="pa-search-result"><strong>@VisibleCount</strong><span>matches</span></div>
        @if (HasFilters)
        {
            <button type="button" class="um-btn um-btn-ghost um-btn-sm pa-search-clear" @onclick="ClearFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_filterType) || _policyFilterId is not null)
    {
        <div class="pa-filter-bar">
            @if (!string.IsNullOrWhiteSpace(_filterType))
            {
                <span>Type: <strong>@_filterType</strong></span>
            }
            @if (_policyFilterId is not null)
            {
                <span>Policy: <strong>@_policyFilterTitle</strong></span>
            }
            <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="ClearFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear filters</button>
        </div>
    }

    <div class="pa-grid-wrap">
        @if (_loading)
        {
            <div class="pa-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Loading acknowledgements…</span></div>
        }
        else if (_activeView == "policies")
        {
            @PolicyOverview()
        }
        else
        {
            @AcknowledgementTable()
        }
    </div>
</div>

@if (_openActionMenuFor is not null)
{
    <div class="pa-context-menu" style="left:@_menuXpx; top:@_menuYpx" @onclick:stopPropagation="true">
        <button type="button" @onclick='() => ExecuteMenuAction("View")'><i class="bi bi-eye" aria-hidden="true"></i><span>View details</span></button>
        <button type="button" @onclick='() => ExecuteMenuAction("OpenPolicy")'><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span>Open policy</span></button>
        <button type="button" @onclick='() => ExecuteMenuAction("FilterPolicy")'><i class="bi bi-funnel" aria-hidden="true"></i><span>Filter this policy</span></button>
        <button type="button" @onclick='() => ExecuteMenuAction("FilterType")'><i class="bi bi-tags" aria-hidden="true"></i><span>Filter this type</span></button>
        <button type="button" @onclick='() => ExecuteMenuAction("Export")'><i class="bi bi-download" aria-hidden="true"></i><span>Export current view</span></button>
    </div>
}

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading = true;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string? _searchText;
    private string? _filterType;
    private Guid? _policyFilterId;
    private string? _policyFilterTitle;
    private string _activeView = "pending";
    private Guid? _openActionMenuFor;
    private string _menuXpx = "0px";
    private string _menuYpx = "0px";
    private int _page = 1;
    private int _ackedPage = 1;
    private const int PageSize = 20;

    private AcknowledgementSummaryDto? _summary;
    private List<PendingAcknowledgementDto> _pendingAll = [];
    private List<PendingAcknowledgementDto> _overdueAll = [];
    private PagedResult<AcknowledgementDetailDto> _acknowledged = new();
    private List<PolicyDocumentDto> _policies = [];
    private AckRow? _selected;
    private AckRow? _drawerItem;

    private readonly TabDef[] _tabs =
    [
        new("pending", "Pending", "bi-hourglass-split"),
        new("overdue", "Overdue", "bi-exclamation-circle"),
        new("acknowledged", "Acknowledged", "bi-check-circle"),
        new("policies", "Active Policies", "bi-file-earmark-check")
    ];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Compliance", "/compliance"), new("Acknowledgements", null));
        await LoadAsync();
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var summaryTask = Api.GetAcknowledgementSummaryAsync(_tenantId);
            var pendingTask = Api.GetPendingAcknowledgementsAsync(_tenantId);
            var overdueTask = Api.GetOverdueAcknowledgementsAsync(_tenantId);
            var ackedTask = Api.SearchAcknowledgedAsync(_tenantId, searchTerm: SearchOrNull, pageNumber: _ackedPage, pageSize: PageSize);
            var policiesTask = Api.SearchPolicyDocumentsAsync(_tenantId, statusCode: "Published", pageNumber: 1, pageSize: 500);

            await Task.WhenAll(summaryTask, pendingTask, overdueTask, ackedTask, policiesTask);

            _summary = await summaryTask ?? new();
            _pendingAll = (await pendingTask)?.ToList() ?? [];
            _overdueAll = (await overdueTask)?.ToList() ?? [];
            _acknowledged = await ackedTask ?? new();
            _policies = (await policiesTask)?.Items.ToList() ?? [];
            _page = 1;
        }
        catch (Exception ex)
        {
            _summary = new();
            _pendingAll = [];
            _overdueAll = [];
            _acknowledged = new();
            _policies = [];
            _loadError = $"Failed to load acknowledgements: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        _searchText = null;
        _filterType = null;
        _policyFilterId = null;
        _policyFilterTitle = null;
        _page = 1;
        _ackedPage = 1;
        await LoadAsync();
    }

    private string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            _page = 1;
            if (_activeView == "acknowledged")
            {
                _ackedPage = 1;
                _ = ReloadAckedAsync();
            }
        }
    }

    private string? SearchOrNull => string.IsNullOrWhiteSpace(_searchText) ? null : _searchText.Trim();
    private bool HasFilters => !string.IsNullOrWhiteSpace(_searchText) || !string.IsNullOrWhiteSpace(_filterType) || _policyFilterId is not null || _activeView != "pending";
    private int VisibleCount => _activeView == "policies" ? FilteredPolicies.Count : FilteredRows.Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(VisibleCount / (double)PageSize));
    private string ActiveViewLabel => _activeView switch
    {
        "overdue" => "Overdue",
        "acknowledged" => "Acknowledged",
        "policies" => "Active policy",
        _ => "Pending"
    };
    private string ActiveViewIcon => _activeView switch
    {
        "overdue" => "bi-exclamation-circle-fill",
        "acknowledged" => "bi-check-circle-fill",
        "policies" => "bi-file-earmark-check-fill",
        _ => "bi-hourglass-split"
    };
    private string ActiveViewDescription => _activeView switch
    {
        "overdue" => "Prioritize overdue acknowledgement obligations by policy, audience, and target user.",
        "acknowledged" => "Review completed acknowledgements with channel, timestamp, and user evidence.",
        "policies" => "Monitor policy-level acknowledgement completion and audience coverage.",
        _ => "Review pending acknowledgement obligations and follow up by policy or audience."
    };
    private IEnumerable<AckRow> CurrentRows => _activeView switch
    {
        "overdue" => _overdueAll.Select(AckRow.FromPending),
        "acknowledged" => _acknowledged.Items.Select(AckRow.FromAcknowledged),
        _ => _pendingAll.Select(AckRow.FromPending)
    };
    private List<AckRow> FilteredRows => CurrentRows.Where(MatchesFilters).ToList();
    private List<AckRow> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    private List<PolicyDocumentDto> FilteredPolicies => _policies.Where(MatchesPolicyFilters).ToList();
    private List<PolicyDocumentDto> PagedPolicies => FilteredPolicies.Skip((_page - 1) * PageSize).Take(PageSize).ToList();

    private void SetView(string key)
    {
        _activeView = key;
        _page = 1;
        if (key == "acknowledged")
        {
            _ = ReloadAckedAsync();
        }
    }

    private int TabCount(string key) => key switch
    {
        "pending" => _pendingAll.Count,
        "overdue" => _overdueAll.Count,
        "acknowledged" => _acknowledged.TotalCount,
        "policies" => _policies.Count,
        _ => 0
    };

    private bool MatchesFilters(AckRow row)
    {
        if (!string.IsNullOrWhiteSpace(_filterType) && !string.Equals(row.PolicyTypeCode, _filterType, StringComparison.OrdinalIgnoreCase)) return false;
        if (_policyFilterId is not null && row.PolicyDocumentId != _policyFilterId) return false;
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        var s = _searchText.Trim();
        return Contains(row.PolicyCode, s) || Contains(row.PolicyTitle, s) || Contains(row.PolicyTypeCode, s) || Contains(row.PrimaryPerson, s) || Contains(row.UserEmail, s) || Contains(row.Channel, s) || Contains(row.IpAddress, s);
    }

    private bool MatchesPolicyFilters(PolicyDocumentDto row)
    {
        if (!string.IsNullOrWhiteSpace(_filterType) && !string.Equals(row.PolicyTypeCode, _filterType, StringComparison.OrdinalIgnoreCase)) return false;
        if (_policyFilterId is not null && row.PolicyDocumentId != _policyFilterId) return false;
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        var s = _searchText.Trim();
        return Contains(row.PolicyCode, s) || Contains(row.PolicyTitle, s) || Contains(row.PolicyTypeCode, s) || Contains(row.OwnedByFullName, s) || Contains(row.StatusCode, s);
    }

    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private void ClearFilters()
    {
        _searchText = null;
        _filterType = null;
        _policyFilterId = null;
        _policyFilterTitle = null;
        _activeView = "pending";
        _page = 1;
    }

    private void FilterByPolicy(Guid policyId, string policyTitle)
    {
        _policyFilterId = policyId;
        _policyFilterTitle = policyTitle;
        _page = 1;
        CloseDrawer();
        ShowToast($"Filtered to {policyTitle}.");
    }

    private void FilterByType(string type)
    {
        _filterType = type;
        _page = 1;
        CloseDrawer();
        ShowToast($"Filtered to {type} policies.");
    }

    private void PreviousPage() => _page = Math.Max(1, _page - 1);
    private void NextPage() => _page = Math.Min(TotalPages, _page + 1);

    private async Task ReloadAckedAsync()
    {
        try
        {
            _acknowledged = await Api.SearchAcknowledgedAsync(_tenantId, _policyFilterId, SearchOrNull, _ackedPage, PageSize) ?? new();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load acknowledged records: {ex.Message}";
            ShowToast($"Acknowledged load failed: {ex.Message}", "danger");
        }
    }

    private void OpenDrawer(AckRow row)
    {
        _selected = row;
        _drawerItem = row;
    }

    private void CloseDrawer() => _drawerItem = null;
    private void OpenPolicy(Guid policyId) => Nav.NavigateTo($"/compliance/policies/{policyId}");

    private void OpenActionMenu(AckRow row, MouseEventArgs args)
    {
        _selected = row;
        _openActionMenuFor = row.MenuId;
        _menuXpx = $"{Math.Min(args.ClientX, 1420)}px";
        _menuYpx = $"{Math.Min(args.ClientY, 820)}px";
    }

    private void CloseActionMenu() => _openActionMenuFor = null;

    private void ExecuteMenuAction(string action)
    {
        var row = _selected;
        CloseActionMenu();
        if (row is null) return;

        switch (action)
        {
            case "View":
                OpenDrawer(row);
                break;
            case "OpenPolicy":
                OpenPolicy(row.PolicyDocumentId);
                break;
            case "FilterPolicy":
                FilterByPolicy(row.PolicyDocumentId, row.PolicyTitle);
                break;
            case "FilterType":
                FilterByType(row.PolicyTypeCode);
                break;
            case "Export":
                _ = ExportAsync();
                break;
        }
    }

    private Task ExportAsync()
    {
        var csv = new StringBuilder();
        csv.AppendLine("State,Policy Code,Policy Title,Type,Version,Person,Email,Effective,Published,Acknowledged,Channel,IP,Days Overdue");
        foreach (var row in FilteredRows)
        {
            csv.AppendLine(string.Join(',', Csv(row.State), Csv(row.PolicyCode), Csv(row.PolicyTitle), Csv(row.PolicyTypeCode), Csv(row.Version), Csv(row.PrimaryPerson), Csv(row.UserEmail), Csv(row.EffectiveDateUtc?.ToLocalTime().ToString("MM/dd/yyyy")), Csv(row.PublishedDateUtc?.ToLocalTime().ToString("MM/dd/yyyy")), Csv(row.AcknowledgedDateUtc?.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")), Csv(row.Channel), Csv(row.IpAddress), row.DaysOverdue.ToString()));
        }
        var url = "data:text/csv;charset=utf-8," + Uri.EscapeDataString(csv.ToString());
        Nav.NavigateTo(url, forceLoad: true);
        ShowToast("Acknowledgement export generated.");
        return Task.CompletedTask;
    }

    private RenderFragment KpiCard(string icon, string label, string value, string cssClass, string viewKey) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", $"pa-kpi-card {cssClass} {(_activeView == viewKey ? "pa-kpi-card--active" : string.Empty)}");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => SetView(viewKey)));
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pa-kpi-val");
        builder.AddContent(seq++, value);
        builder.CloseElement();
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pa-kpi-lbl");
        builder.OpenElement(seq++, "i");
        builder.AddAttribute(seq++, "class", $"bi {icon}");
        builder.AddAttribute(seq++, "aria-hidden", "true");
        builder.CloseElement();
        builder.AddContent(seq++, label);
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment DrawerField(string label, string value) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pa-meta-row");
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "pa-meta-lbl");
        builder.AddContent(seq++, label);
        builder.CloseElement();
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "pa-meta-val");
        builder.AddContent(seq++, value);
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment AcknowledgementTable() => builder =>
    {
        var rows = PagedRows;
        var seq = 0;
        if (!rows.Any())
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "pa-empty-state");
            builder.AddMarkupContent(seq++, "<i class=\"bi bi-inbox\" aria-hidden=\"true\"></i>");
            builder.OpenElement(seq++, "strong");
            builder.AddContent(seq++, "No acknowledgement records found");
            builder.CloseElement();
            builder.OpenElement(seq++, "span");
            builder.AddContent(seq++, "Adjust the current view, policy, type, or search criteria.");
            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pa-grid-toolbar");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pa-grid-heading");
        builder.AddMarkupContent(seq++, $"<span class=\"pa-grid-icon\"><i class=\"bi {ActiveViewIcon}\" aria-hidden=\"true\"></i></span><div><h2>{ActiveViewLabel} acknowledgement register</h2><p>{ActiveViewDescription}</p></div>");
        builder.CloseElement();
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pa-grid-tools");
        builder.AddMarkupContent(seq++, $"<span class=\"pa-grid-chip\"><strong>{FilteredRows.Count}</strong> records</span><span class=\"pa-grid-chip\">Page {_page} of {TotalPages}</span>");
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", "um-btn um-btn-ghost um-btn-sm");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, ClearFilters));
        builder.AddMarkupContent(seq++, "<i class=\"bi bi-arrow-counterclockwise\" aria-hidden=\"true\"></i> Reset");
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pa-table-scroll");
        builder.OpenElement(seq++, "table");
        builder.AddAttribute(seq++, "class", "pa-table");
        builder.AddAttribute(seq++, "aria-label", "Policy acknowledgement records");
        builder.AddMarkupContent(seq++, "<thead><tr><th>Policy</th><th>Type</th><th>Audience/User</th><th>Status</th><th>Effective</th><th>Published</th><th>Acknowledged</th><th>Channel</th><th class=\"pa-actions-col\"><span class=\"visually-hidden\">Actions</span></th></tr></thead>");
        builder.OpenElement(seq++, "tbody");
        foreach (var row in rows)
        {
            builder.OpenElement(seq++, "tr");
            builder.AddAttribute(seq++, "class", "pa-table-row");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => OpenDrawer(row)));
            builder.OpenElement(seq++, "td");
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "pa-policy-cell");
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "pa-avatar");
            builder.AddMarkupContent(seq++, $"<i class=\"bi {row.Icon}\" aria-hidden=\"true\"></i>");
            builder.CloseElement();
            builder.OpenElement(seq++, "div");
            builder.OpenElement(seq++, "strong");
            builder.AddContent(seq++, row.PolicyTitle);
            builder.CloseElement();
            builder.OpenElement(seq++, "span");
            builder.AddContent(seq++, $"{row.PolicyCode} · v{row.Version}");
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
            builder.OpenElement(seq++, "td");
            builder.AddMarkupContent(seq++, $"<span class=\"pa-type-chip pa-type-{CssSafe(row.PolicyTypeCode)}\">{row.PolicyTypeCode}</span>");
            builder.CloseElement();
            builder.OpenElement(seq++, "td");
            builder.AddMarkupContent(seq++, $"<span class=\"pa-user-name\">{row.PrimaryPerson}</span><span class=\"pa-user-email\">{row.UserEmail}</span>");
            builder.CloseElement();
            builder.OpenElement(seq++, "td");
            builder.AddMarkupContent(seq++, $"<span class=\"pa-status pa-status-{CssSafe(row.State)}\">{row.State}</span>");
            builder.CloseElement();
            builder.OpenElement(seq++, "td"); builder.AddContent(seq++, row.EffectiveDateUtc?.ToLocalTime().ToString("MM/dd/yyyy") ?? "—"); builder.CloseElement();
            builder.OpenElement(seq++, "td"); builder.AddContent(seq++, row.PublishedDateUtc?.ToLocalTime().ToString("MM/dd/yyyy") ?? "—"); builder.CloseElement();
            builder.OpenElement(seq++, "td"); builder.AddContent(seq++, row.AcknowledgedDateUtc?.ToLocalTime().ToString("MM/dd/yyyy h:mm tt") ?? "—"); builder.CloseElement();
            builder.OpenElement(seq++, "td"); builder.AddContent(seq++, row.Channel ?? "—"); builder.CloseElement();
            builder.OpenElement(seq++, "td");
            builder.AddAttribute(seq++, "class", "pa-actions-col");
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "class", "um-btn um-btn-ghost um-btn-sm pa-ctx-btn");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, args => OpenActionMenu(row, args)));
            builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
            builder.AddMarkupContent(seq++, "<i class=\"bi bi-three-dots-vertical\" aria-hidden=\"true\"></i>");
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
        }
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
        Pager(builder, ref seq);
    };

    private RenderFragment PolicyOverview() => builder =>
    {
        var policies = PagedPolicies;
        var seq = 0;
        if (!policies.Any())
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "pa-empty-state");
            builder.AddMarkupContent(seq++, "<i class=\"bi bi-file-earmark-check\" aria-hidden=\"true\"></i>");
            builder.OpenElement(seq++, "strong");
            builder.AddContent(seq++, "No published policies with acknowledgement workflow found");
            builder.CloseElement();
            builder.OpenElement(seq++, "span");
            builder.AddContent(seq++, "Publish compliance policies and assign audiences to begin tracking.");
            builder.CloseElement();
            builder.CloseElement();
            return;
        }
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pa-grid-toolbar pa-grid-toolbar--policy");
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pa-grid-heading");
        builder.AddMarkupContent(seq++, "<span class=\"pa-grid-icon\"><i class=\"bi bi-file-earmark-check\" aria-hidden=\"true\"></i></span><div><h2>Active policy acknowledgement coverage</h2><p>Track acknowledgement completion, overdue exposure, and open audience work by policy.</p></div>");
        builder.CloseElement();
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pa-grid-tools");
        builder.AddMarkupContent(seq++, $"<span class=\"pa-grid-chip\"><strong>{FilteredPolicies.Count}</strong> policies</span><span class=\"pa-grid-chip\">Page {_page} of {TotalPages}</span>");
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pa-policy-grid");
        foreach (var policy in policies)
        {
            var pending = _pendingAll.Count(x => x.PolicyDocumentId == policy.PolicyDocumentId);
            var overdue = _overdueAll.Count(x => x.PolicyDocumentId == policy.PolicyDocumentId);
            var acked = policy.AcknowledgementCount;
            var total = pending + acked;
            var pct = total > 0 ? (int)Math.Round(acked * 100.0 / total) : (acked > 0 ? 100 : 0);
            builder.OpenElement(seq++, "article");
            builder.AddAttribute(seq++, "class", "pa-policy-card");
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "pa-policy-card-head");
            builder.OpenElement(seq++, "div");
            builder.OpenElement(seq++, "strong"); builder.AddContent(seq++, policy.PolicyTitle); builder.CloseElement();
            builder.OpenElement(seq++, "span"); builder.AddContent(seq++, $"{policy.PolicyCode} · {policy.PolicyTypeCode} · v{policy.Version}"); builder.CloseElement();
            builder.CloseElement();
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "class", "um-btn um-btn-ghost um-btn-sm");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => OpenPolicy(policy.PolicyDocumentId)));
            builder.AddContent(seq++, "Open");
            builder.CloseElement();
            builder.CloseElement();
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "pa-progress-wrap");
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "pa-progress-bar");
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "pa-progress-fill");
            builder.AddAttribute(seq++, "style", $"width:{pct}%");
            builder.CloseElement();
            builder.CloseElement();
            builder.OpenElement(seq++, "span"); builder.AddContent(seq++, $"{pct}% complete"); builder.CloseElement();
            builder.CloseElement();
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "pa-policy-stats");
            builder.AddMarkupContent(seq++, $"<span>{pending} pending</span><span>{overdue} overdue</span><span>{acked} acknowledged</span>");
            builder.CloseElement();
            builder.CloseElement();
        }
        builder.CloseElement();
        Pager(builder, ref seq);
    };

    private void Pager(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, ref int seq)
    {
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "pa-pager");
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", "um-btn um-btn-ghost um-btn-sm");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, PreviousPage));
        builder.AddAttribute(seq++, "disabled", _page <= 1);
        builder.AddContent(seq++, "Previous");
        builder.CloseElement();
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "pa-page-chip");
        builder.AddContent(seq++, $"Page {_page} of {TotalPages} · {VisibleCount} records");
        builder.CloseElement();
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", "um-btn um-btn-ghost um-btn-sm");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, NextPage));
        builder.AddAttribute(seq++, "disabled", _page >= TotalPages);
        builder.AddContent(seq++, "Next");
        builder.CloseElement();
        builder.CloseElement();
    }

    private static string Csv(string? value)
    {
        var text = value ?? string.Empty;
        return string.Concat("\"", text.Replace("\"", "\"\""), "\"");
    }

    private static string CssSafe(string? value) => string.IsNullOrWhiteSpace(value) ? "unknown" : value.Trim().ToLowerInvariant().Replace(" ", "-");

    private void ShowToast(string message, string kind = "success")
    {
        _toastMessage = message;
        _toastKind = kind;
        _toastVisible = true;
    }

    private void HideToast() => _toastVisible = false;

    private sealed record TabDef(string Key, string Label, string Icon);

    private sealed class AckRow
    {
        public Guid MenuId { get; init; }
        public Guid PolicyDocumentId { get; init; }
        public string PolicyCode { get; init; } = string.Empty;
        public string PolicyTitle { get; init; } = string.Empty;
        public string PolicyTypeCode { get; init; } = string.Empty;
        public string Version { get; init; } = string.Empty;
        public DateTime? EffectiveDateUtc { get; init; }
        public DateTime? PublishedDateUtc { get; init; }
        public DateTime? AcknowledgedDateUtc { get; init; }
        public string PrimaryPerson { get; init; } = string.Empty;
        public string UserEmail { get; init; } = string.Empty;
        public string? Channel { get; init; }
        public string? IpAddress { get; init; }
        public int DaysOverdue { get; init; }
        public string State { get; init; } = string.Empty;
        public string Icon { get; init; } = string.Empty;
        public bool IsAcknowledged => AcknowledgedDateUtc is not null;
        public string LifecycleText => State switch
        {
            "Overdue" => $"{DaysOverdue} day{(DaysOverdue == 1 ? string.Empty : "s")} overdue",
            "Acknowledged" => AcknowledgedDateUtc?.ToLocalTime().ToString("MM/dd/yyyy h:mm tt") ?? "Acknowledged",
            _ => "Waiting for acknowledgement"
        };
        public string Description => State switch
        {
            "Overdue" => $"{PrimaryPerson} has not acknowledged this policy and the effective date has passed.",
            "Acknowledged" => $"{PrimaryPerson} acknowledged this policy through {Channel ?? "an unknown channel"}.",
            _ => $"{PrimaryPerson} is in the required audience and acknowledgement is pending."
        };

        public static AckRow FromPending(PendingAcknowledgementDto row) => new()
        {
            MenuId = row.AudienceId,
            PolicyDocumentId = row.PolicyDocumentId,
            PolicyCode = row.PolicyCode,
            PolicyTitle = row.PolicyTitle,
            PolicyTypeCode = row.PolicyTypeCode,
            Version = row.Version,
            EffectiveDateUtc = row.EffectiveDateUtc,
            PublishedDateUtc = row.PublishedDateUtc,
            PrimaryPerson = row.TargetName,
            DaysOverdue = row.DaysOverdue,
            State = row.DaysOverdue > 0 ? "Overdue" : "Pending",
            Icon = row.DaysOverdue > 0 ? "bi-exclamation-circle-fill" : "bi-hourglass-split"
        };

        public static AckRow FromAcknowledged(AcknowledgementDetailDto row) => new()
        {
            MenuId = row.AcknowledgementId,
            PolicyDocumentId = row.PolicyDocumentId,
            PolicyCode = row.PolicyCode,
            PolicyTitle = row.PolicyTitle,
            PolicyTypeCode = row.PolicyTypeCode,
            Version = row.Version,
            PrimaryPerson = row.UserFullName,
            UserEmail = row.UserEmail,
            AcknowledgedDateUtc = row.AcknowledgedDateUtc,
            Channel = row.Channel,
            IpAddress = row.IpAddress,
            State = "Acknowledged",
            Icon = "bi-check-circle-fill"
        };
    }
}
