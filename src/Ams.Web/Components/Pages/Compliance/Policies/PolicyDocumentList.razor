    // ── Acknowledgements ───────────────────────────────────────────────────────
    private async Task OpenAcknowledgements(PolicyDocumentDto p)
    {
        _ackTarget       = p;
        _acknowledgements = [];
        _showAck         = true;
        _ackLoading      = true;
        StateHasChanged();
        try
        {
            var items = await Api.GetPolicyAcknowledgementsAsync(p.PolicyDocumentId);
            _acknowledgements = items?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _acknowledgements = [];
            await ShowToastAsync($"Acknowledgements load failed: {ex.Message}", "e-toast-danger");
        }
        finally
        {
            _ackLoading = false;
        }
    }

