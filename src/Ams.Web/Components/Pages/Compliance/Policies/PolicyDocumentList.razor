@page "/compliance/policies"
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Compliance
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Compliance Policies â€” AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="cp-toast cp-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="cp-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseFormDialog">
        <div class="mt-modal cp-action-modal" role="dialog" aria-modal="true" aria-labelledby="cp-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi @(_editTarget is null ? "bi-plus-lg" : "bi-pencil-square")" aria-hidden="true"></i>
                <span id="cp-form-title">@(_editTarget is null ? "New Compliance Policy" : "Edit Compliance Policy")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseFormDialog" disabled="@_busy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="cp-modal-intro">
                        <span class="cp-modal-chip"><i class="bi bi-shield-check" aria-hidden="true"></i> Compliance governance</span>
                        <p>Create and maintain controlled policies with ownership, versioning, publishing, retirement, and acknowledgement workflow.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field">
                            <label>Policy Code <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.PolicyCode" />
                        </div>
                        <div class="um-field">
                            <label>Version <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.Version" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Policy Title <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.PolicyTitle" />
                        </div>
                        <div class="um-field">
                            <label>Policy Type <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.PolicyTypeCode">
                                <option value="">Select typeâ€¦</option>
                                @foreach (var type in PolicyTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Effective Date</label>
                            <InputDate class="form-control" @bind-Value="_form.EffectiveDateUtc" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Description</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_form.Description" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Policy Content</label>
                            <InputTextArea class="form-control cp-content-editor" rows="7" @bind-Value="_form.Content" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseFormDialog" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        @(_editTarget is null ? "Create Policy" : "Save Changes")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showVersion)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseVersion">
        <div class="mt-modal cp-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="cp-version-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-layers" aria-hidden="true"></i>
                <span id="cp-version-title">New Version â€” @_versionTarget?.PolicyCode</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseVersion" disabled="@_busy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_versionForm" OnValidSubmit="ExecuteVersionAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field">
                            <label>New Version <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_versionForm.NewVersion" />
                        </div>
                        <div class="um-field">
                            <label>Effective Date</label>
                            <InputDate class="form-control" @bind-Value="_versionForm.EffectiveDateUtc" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Description Override</label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_versionForm.Description" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseVersion" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">Create Version</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showAck)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseAcknowledgements">
        <div class="mt-modal cp-action-modal" role="dialog" aria-modal="true" aria-labelledby="cp-ack-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-people-fill" aria-hidden="true"></i>
                <span id="cp-ack-title">Acknowledgements â€” @_ackTarget?.PolicyCode v@_ackTarget?.Version</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseAcknowledgements"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="um-modal-body">
                @if (_ackLoading)
                {
                    <div class="cp-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Loading acknowledgementsâ€¦</span></div>
                }
                else if (!_acknowledgements.Any())
                {
                    <div class="cp-empty-inline"><i class="bi bi-people" aria-hidden="true"></i><strong>No acknowledgements recorded</strong><span>Publish the policy and assign audiences to begin acknowledgement tracking.</span></div>
                }
                else
                {
                    <div class="cp-mini-table-wrap">
                        <table class="cp-mini-table" aria-label="Policy acknowledgements">
                            <thead><tr><th>User</th><th>Acknowledged</th><th>Channel</th><th>IP</th></tr></thead>
                            <tbody>
                                @foreach (var ack in _acknowledgements)
                                {
                                    <tr>
                                        <td><strong>@ack.UserFullName</strong><span>@ack.UserEmail</span></td>
                                        <td>@ack.AcknowledgedDateUtc.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</td>
                                        <td>@(ack.Channel ?? "â€”")</td>
                                        <td>@(ack.IpAddress ?? "â€”")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CloseAcknowledgements">Close</button>
            </div>
        </div>
    </div>
}

@if (_confirmAction is not null)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseConfirm">
        <div class="mt-modal cp-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="cp-confirm-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon @(_confirmAction == "Retire" ? "um-confirm-icon--warning" : "um-confirm-icon--success")"><i class="bi @(_confirmAction == "Retire" ? "bi-archive-fill" : "bi-send-check-fill")" aria-hidden="true"></i></div>
                <div class="um-confirm-message">
                    <h6 id="cp-confirm-title">@_confirmAction Policy?</h6>
                    <p>@ConfirmMessage</p>
                </div>
                <div class="um-modal-footer w-100">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseConfirm" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn @(_confirmAction == "Retire" ? "um-btn-warning" : "um-btn-success")" @onclick="ExecuteConfirmAsync" disabled="@_busy">@_confirmAction</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="cp-enterprise-page" @onclick="CloseActionMenu">
    <section class="cp-hero" aria-label="Compliance policies dashboard header">
        <div class="cp-hero-left">
            <div class="cp-hero-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></div>
            <div>
                <div class="cp-title-row">
                    <h1>Compliance Policies</h1>
                    <span><i class="bi bi-stack" aria-hidden="true"></i>@FilteredRows.Count() visible</span>
                    @if (HasFilters)
                    {
                        <span><i class="bi bi-funnel-fill" aria-hidden="true"></i>Filtered</span>
                    }
                </div>
                <p>Enterprise policy governance center for drafting, publishing, acknowledgement tracking, version control, audience evidence, retirement, and workflow synchronization.</p>
            </div>
        </div>
        <div class="cp-hero-actions">
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "cp-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Policy</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger cp-load-error" style="border-left: 4px solid #dc3545; animation: cp-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError</div>
    }

    <div class="cp-kpi-strip">
        <button type="button" class="@TotalKpiClass" title="Policy inventory" @onclick="@(() => ClearKpiFilter())">
            <div class="cp-kpi-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></div>
            <div><span class="cp-kpi-val">@_rows.Count</span><span class="cp-kpi-lbl">Total</span><small>Policy inventory</small></div>
        </button>
        <button type="button" class="@DraftKpiClass" title="In authoring" @onclick="@(() => SetDraftKpiFilter())">
            <div class="cp-kpi-icon"><i class="bi bi-pencil-fill" aria-hidden="true"></i></div>
            <div><span class="cp-kpi-val">@DraftCount</span><span class="cp-kpi-lbl">Draft</span><small>In authoring</small></div>
        </button>
        <button type="button" class="@PublishedKpiClass" title="Active governance" @onclick="@(() => SetPublishedKpiFilter())">
            <div class="cp-kpi-icon"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></div>
            <div><span class="cp-kpi-val">@PublishedCount</span><span class="cp-kpi-lbl">Published</span><small>Active governance</small></div>
        </button>
        <button type="button" class="@RetiredKpiClass" title="Audit retained" @onclick="@(() => SetRetiredKpiFilter())">
            <div class="cp-kpi-icon"><i class="bi bi-archive-fill" aria-hidden="true"></i></div>
            <div><span class="cp-kpi-val">@RetiredCount</span><span class="cp-kpi-lbl">Retired</span><small>Audit retained</small></div>
        </button>
        <button type="button" class="@AckKpiClass" title="Evidence captured" @onclick="@(() => SetAckKpiFilter())">
            <div class="cp-kpi-icon"><i class="bi bi-people-fill" aria-hidden="true"></i></div>
            <div><span class="cp-kpi-val">@AcknowledgedCount</span><span class="cp-kpi-lbl">Acknowledged</span><small>Evidence captured</small></div>
        </button>
        <button type="button" class="@EffectiveKpiClass" title="Dated controls" @onclick="@(() => SetEffectiveKpiFilter())">
            <div class="cp-kpi-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></div>
            <div><span class="cp-kpi-val">@EffectiveCount</span><span class="cp-kpi-lbl">Effective</span><small>Dated controls</small></div>
        </button>
        <button type="button" class="@NeedsKpiClass" title="Workflow focus" @onclick="@(() => SetNeedsKpiFilter())">
            <div class="cp-kpi-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></div>
            <div><span class="cp-kpi-val">@NeedsActionCount</span><span class="cp-kpi-lbl">Needs action</span><small>Workflow focus</small></div>
        </button>
    </div>

    <div class="cp-workflow-strip" aria-label="Compliance policy workflow shortcuts">
        @foreach (var shortcut in WorkflowShortcuts)
        {
            <button type="button" class="cp-workflow-card" @onclick="() => ExecuteShortcut(shortcut)">
                <i class="bi @shortcut.Icon" aria-hidden="true"></i>
                <span><strong>@shortcut.Title</strong><small>@shortcut.Subtitle</small></span>
            </button>
        }
    </div>

    <div class="cp-search-panel" role="search" aria-label="Search compliance policies">
        <div class="cp-search-wrap">
            <div class="cp-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
            <div class="cp-search-body">
                <label for="cp-search-input">Enterprise search</label>
                <input id="cp-search-input" class="cp-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search code, title, type, status, owner, content, dates..." />
                <span class="cp-search-hint">Searches policy metadata, lifecycle state, ownership, content, audience, and dates as you type.</span>
            </div>
        </div>
        <select class="cp-filter-select" @bind="TypeFilter" aria-label="Filter by policy type">
            <option value="">All types</option>
            @foreach (var type in PolicyTypes)
            {
                <option value="@type">@type</option>
            }
        </select>
        <select class="cp-filter-select" @bind="StatusFilter" aria-label="Filter by status">
            <option value="">All statuses</option>
            @foreach (var status in StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>
        <div class="cp-search-result"><strong>@FilteredRows.Count()</strong><span>matches</span></div>
        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
    </div>

    <div class="cp-bulk-bar">
        <span><i class="bi bi-sliders" aria-hidden="true"></i> @FilteredRows.Count() policies in current workspace</span>
        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetActiveTab("draft")'><i class="bi bi-pencil" aria-hidden="true"></i> Draft queue</button>
        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetActiveTab("ack")'><i class="bi bi-people" aria-hidden="true"></i> Acknowledgements</button>
        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/compliance/acknowledgements")'><i class="bi bi-check2-circle" aria-hidden="true"></i> Evidence center</button>
    </div>

    <div class="cp-view-tabs" role="tablist" aria-label="Compliance policy views">
        @foreach (var tab in _tabs)
        {
            <button class="cp-view-btn @(_activeTab == tab.Key ? "cp-view-btn-active" : null)" type="button" role="tab" aria-selected="@(_activeTab == tab.Key)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                @tab.Label
                <span>@TabCount(tab.Key)</span>
            </button>
        }
    </div>

    <div class="cp-content-layout">
        <section class="cp-main-card" aria-label="Compliance policy results">
            @if (_loading)
            {
                <div class="cp-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Loading compliance policies...</span></div>
            }
            else if (_activeTab == "board")
            {
                <div class="cp-board">
                    @foreach (var group in BoardGroups)
                    {
                        <section class="cp-board-col">
                            <header><strong>@group.Title</strong><span>@group.Items.Count</span></header>
                            @foreach (var row in group.Items.Take(8))
                            {
                                <button type="button" class="cp-board-card" @onclick="() => OpenDetailAsync(row)">
                                    <div><strong>@row.PolicyCode</strong>@StatusChip(row.StatusCode)</div>
                                    <span>@row.PolicyTitle</span>
                                    <small>@row.PolicyTypeCode - v@row.Version - @LifecycleLabel(row)</small>
                                </button>
                            }
                        </section>
                    }
                </div>
            }
            else if (_activeTab == "analytics")
            {
                <div class="cp-analytics-grid">
                    <section>
                        <h3>Policy lifecycle</h3>
                        @foreach (var item in StatusBreakdown)
                        {
                            <button type="button" class="cp-stage-row @(Equals(_statusFilter, item.Label) ? "cp-active" : null)" @onclick="() => StatusFilter = item.Label">
                                <span>@item.Label</span><div><i style="width:@item.Percent%"></i></div><strong>@item.Count</strong>
                            </button>
                        }
                    </section>
                    <section>
                        <h3>Policy types</h3>
                        @foreach (var item in TypeBreakdown)
                        {
                            <button type="button" class="cp-stage-row @(Equals(_typeFilter, item.Label) ? "cp-active" : null)" @onclick="() => TypeFilter = item.Label">
                                <span>@item.Label</span><div><i style="width:@item.Percent%"></i></div><strong>@item.Count</strong>
                            </button>
                        }
                    </section>
                </div>
            }
            else if (!PagedRows.Any())
            {
                <div class="cp-empty-state">
                    <i class="bi bi-file-earmark-x" aria-hidden="true"></i>
                    <strong>No compliance policies found</strong>
                    <span>Create a policy or adjust the current tab, KPI, or search criteria.</span>
                </div>
            }
            else
            {
                <div class="cp-table-scroll">
                    <table class="cp-table" aria-label="Compliance policies register">
                        <thead>
                            <tr>
                                <th>Policy</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Version</th>
                                <th>Effective</th>
                                <th>Owner</th>
                                <th class="cp-number">Acknowledgements</th>
                                <th>Lifecycle</th>
                                <th class="cp-actions-col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in PagedRows)
                            {
                                <tr class="@(Equals(_drawerRow?.PolicyDocumentId, row.PolicyDocumentId) ? "cp-row-selected" : null)" @onclick="() => OpenDetailAsync(row)">
                                    <td>
                                        <div class="cp-name-cell">
                                            <span class="cp-avatar @AvatarClass(row)"><i class="bi @TypeIcon(row.PolicyTypeCode)" aria-hidden="true"></i></span>
                                            <div><strong>@row.PolicyTitle</strong><small>@row.PolicyCode - @(row.Description ?? "Compliance policy")</small></div>
                                        </div>
                                    </td>
                                    <td>@TypeChip(row.PolicyTypeCode)</td>
                                    <td>@StatusChip(row.StatusCode)</td>
                                    <td><span class="cp-version">v@row.Version</span></td>
                                    <td>@(row.EffectiveDateUtc?.ToLocalTime().ToString("MM/dd/yyyy") ?? "None")</td>
                                    <td>@(row.OwnedByFullName ?? "Tenant Admin")</td>
                                    <td class="cp-number"><span class="cp-doc-count">@row.AcknowledgementCount</span></td>
                                    <td>@LifecycleCell(row)</td>
                                    <td class="cp-actions-col">@CtxBtn(row)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="cp-pager">
                    <span>@PageSummary</span>
                    <div>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                    </div>
                </div>
            }
        </section>

        <aside class="cp-detail-card" aria-label="Selected compliance policy details">
            @if (_drawerRow is null)
            {
                <div class="cp-detail-empty">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <strong>Select a policy</strong>
                    <span>Click a row or board card to inspect lifecycle, versions, audience, and workflow actions.</span>
                </div>
            }
            else
            {
                <div class="cp-detail-head">
                    <div>
                        <span class="cp-detail-eyebrow"><i class="bi @StatusIcon(_drawerRow.StatusCode)" aria-hidden="true"></i>@_drawerRow.StatusCode</span>
                        <h2>@_drawerRow.PolicyTitle</h2>
                        <p>@_drawerRow.PolicyCode - @_drawerRow.PolicyTypeCode - v@_drawerRow.Version</p>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseDrawer"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="cp-detail-body">
                    <div class="cp-detail-summary">
                        <div><span>Effective</span><strong>@(_drawerRow.EffectiveDateUtc?.ToLocalTime().ToString("MM/dd/yyyy") ?? "None")</strong></div>
                        <div><span>Owner</span><strong>@(_drawerRow.OwnedByFullName ?? "Tenant Admin")</strong></div>
                        <div><span>Published</span><strong>@(_drawerRow.PublishedDateUtc?.ToLocalTime().ToString("MM/dd/yyyy") ?? "Not published")</strong></div>
                        <div><span>Acknowledgements</span><strong>@_drawerRow.AcknowledgementCount</strong></div>
                    </div>
                    <section class="cp-detail-timeline">
                        <h3><i class="bi bi-card-text" aria-hidden="true"></i>Description</h3>
                        <p>@(string.IsNullOrWhiteSpace(_drawerRow.Description) ? "No description has been provided." : _drawerRow.Description)</p>
                    </section>
                    <section class="cp-detail-timeline">
                        <h3><i class="bi bi-layers" aria-hidden="true"></i>Version History</h3>
                        @if (_versions.Any())
                        {
                            @foreach (var version in _versions.Take(5))
                            {
                                <div class="cp-mini-item"><strong>@version.PolicyCode v@version.Version - @version.StatusCode</strong><span>@version.CreatedDateUtc.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</span></div>
                            }
                        }
                        else
                        {
                            <p>No version history is available.</p>
                        }
                    </section>
                    <section class="cp-detail-timeline">
                        <h3><i class="bi bi-person-lines-fill" aria-hidden="true"></i>Audience</h3>
                        @if (_audience.Any())
                        {
                            <div class="cp-tag-list">
                                @foreach (var audience in _audience.Take(8))
                                {
                                    <span>@audience.TargetTypeCode: @audience.TargetName</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p>No audience has been assigned.</p>
                        }
                    </section>
                    <div class="cp-detail-actions">
                        <div class="cp-detail-actions-row">
                            <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenEdit(_drawerRow)"><i class="bi bi-pencil-square" aria-hidden="true"></i> Edit</button>
                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenVersion(_drawerRow)"><i class="bi bi-layers" aria-hidden="true"></i> Version</button>
                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenAcknowledgementsAsync(_drawerRow)"><i class="bi bi-people" aria-hidden="true"></i> Acks</button>
                        </div>
                        @if (_drawerRow.StatusCode == "Draft")
                        {
                            <button type="button" class="um-btn um-btn-success um-btn-sm" @onclick="OpenDrawerPublish"><i class="bi bi-send-check" aria-hidden="true"></i> Publish Policy</button>
                        }
                        @if (_drawerRow.StatusCode == "Published")
                        {
                            <button type="button" class="um-btn um-btn-warning um-btn-sm" @onclick="OpenDrawerRetire"><i class="bi bi-archive" aria-hidden="true"></i> Retire Policy</button>
                        }
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/compliance/policies/{_drawerRow.PolicyDocumentId}")'><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Full Detail</button>
                    </div>
                </div>
            }
        </aside>
    </div>
</div>

@if (_openActionMenuFor is not null)
{
    <div class="cp-context-menu" style="left:@_menuXpx; top:@_menuYpx" @onclick:stopPropagation="true">
        <button type="button" @onclick='() => ExecuteMenuActionAsync("View")'><i class="bi bi-eye" aria-hidden="true"></i><span>View details</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Edit")' disabled="@IsSelectedRetired"><i class="bi bi-pencil-square" aria-hidden="true"></i><span>Edit policy</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Version")' disabled="@IsSelectedRetired"><i class="bi bi-layers" aria-hidden="true"></i><span>Create new version</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Acknowledgements")'><i class="bi bi-people" aria-hidden="true"></i><span>Acknowledgements</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("History")'><i class="bi bi-clock-history" aria-hidden="true"></i><span>Version history</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Publish")' disabled="@(!IsSelectedDraft)"><i class="bi bi-send-check" aria-hidden="true"></i><span>Publish</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Retire")' disabled="@(!IsSelectedPublished)"><i class="bi bi-archive" aria-hidden="true"></i><span>Retire</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("OpenDetailPage")'><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span>Open full detail</span></button>
    </div>
}

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading;
    private bool _busy;
    private bool _toastVisible;
    private bool _showForm;
    private bool _showVersion;
    private bool _showAck;
    private bool _ackLoading;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string? _searchText;
    private string? _kpiFilter;
    private string? _typeFilter;
    private string? _statusFilter;
    private string? _confirmAction;
    private string _activeTab = "all";
    private Guid? _openActionMenuFor;
    private string _menuXpx = "0px";
    private string _menuYpx = "0px";
    private int _page = 1;
    private const int PageSize = 20;

    private readonly List<PolicyDocumentDto> _rows = [];
    private readonly List<PolicyDocumentDto> _versions = [];
    private readonly List<PolicyAcknowledgementDto> _acknowledgements = [];
    private readonly List<PolicyAudienceDto> _audience = [];

    private PolicyDocumentDto? _selected;
    private PolicyDocumentDto? _drawerRow;
    private PolicyDocumentDto? _editTarget;
    private PolicyDocumentDto? _versionTarget;
    private PolicyDocumentDto? _ackTarget;
    private PolicyDocumentDto? _confirmTarget;
    private FormModel _form = new();
    private VersionFormModel _versionForm = new();

    private static readonly string[] PolicyTypes = ["Information Security", "Privacy", "Human Resources", "Finance", "Operations", "Compliance", "IT Governance"];
    private static readonly string[] StatusOptions = ["Draft", "Published", "Retired"];

    private readonly TabDef[] _tabs =
    [
        new("all", "All", "bi-stack"),
        new("draft", "Draft", "bi-pencil"),
        new("published", "Published", "bi-check-circle"),
        new("retired", "Retired", "bi-archive"),
        new("effective", "Effective", "bi-calendar-check"),
        new("ack", "Acknowledged", "bi-people"),
        new("board", "Board", "bi-kanban"),
        new("analytics", "Analytics", "bi-bar-chart-line")
    ];

    private readonly ShortcutDef[] WorkflowShortcuts =
    [
        new("bi-plus-circle", "Author policy", "Create a controlled draft", "create"),
        new("bi-send-check", "Publish queue", "Review draft policies", "draft"),
        new("bi-people", "Acknowledgement evidence", "Open compliance evidence", "acknowledgements"),
        new("bi-diagram-3", "Policy workbench", "Sync related policy workflows", "policies")
    ];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Compliance", "/compliance"), new("Compliance Policies", "/compliance/policies"));
        await LoadAsync();
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchPolicyDocumentsAsync(_tenantId, pageNumber: 1, pageSize: 500);
            _rows.Clear();
            _rows.AddRange((result?.Items ?? []).OrderBy(x => x.PolicyCode).ThenByDescending(x => x.CreatedDateUtc));
            _page = 1;
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load compliance policies: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            _page = 1;
        }
    }

    private string? TypeFilter
    {
        get => _typeFilter;
        set
        {
            _typeFilter = string.IsNullOrWhiteSpace(value) ? null : value;
            _page = 1;
        }
    }

    private string? StatusFilter
    {
        get => _statusFilter;
        set
        {
            _statusFilter = string.IsNullOrWhiteSpace(value) ? null : value;
            _page = 1;
        }
    }

    private IEnumerable<PolicyDocumentDto> FilteredRows => _rows.Where(MatchesActiveTab).Where(MatchesKpiFilter).Where(MatchesTypeFilter).Where(MatchesStatusFilter).Where(MatchesSearch).ToList();
    private IEnumerable<PolicyDocumentDto> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)PageSize));
    private bool HasFilters => !string.IsNullOrWhiteSpace(_searchText) || _activeTab != "all" || _kpiFilter is not null || _typeFilter is not null || _statusFilter is not null;
    private bool IsSelectedDraft => _selected?.StatusCode == "Draft";
    private bool IsSelectedPublished => _selected?.StatusCode == "Published";
    private bool IsSelectedRetired => _selected?.StatusCode == "Retired";
    private string PageSummary => $"Page {_page} of {TotalPages} Â· {FilteredRows.Count()} records";
    private string ConfirmMessage => _confirmTarget is null ? string.Empty : _confirmAction == "Retire"
        ? $"Retire '{_confirmTarget.PolicyTitle}' v{_confirmTarget.Version}? The policy will be inactive and retained for audit history."
        : $"Publish '{_confirmTarget.PolicyTitle}' v{_confirmTarget.Version}? The policy will become active for acknowledgement governance.";

    private bool MatchesActiveTab(PolicyDocumentDto row) => _activeTab switch
    {
        "draft" => row.StatusCode == "Draft",
        "published" => row.StatusCode == "Published",
        "retired" => row.StatusCode == "Retired",
        "effective" => row.EffectiveDateUtc is not null,
        "ack" => row.AcknowledgementCount > 0,
        _ => true
    };

    private bool MatchesKpiFilter(PolicyDocumentDto row) => _kpiFilter switch
    {
        null => true,
        "__ack" => row.AcknowledgementCount > 0,
        "__effective" => row.EffectiveDateUtc is not null,
        "__needs" => row.StatusCode == "Draft" || row.AcknowledgementCount == 0,
        _ => row.StatusCode == _kpiFilter
    };

    private bool MatchesTypeFilter(PolicyDocumentDto row) => _typeFilter is null || row.PolicyTypeCode == _typeFilter;
    private bool MatchesStatusFilter(PolicyDocumentDto row) => _statusFilter is null || row.StatusCode == _statusFilter;

    private bool MatchesSearch(PolicyDocumentDto row)
    {
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        var s = _searchText.Trim();
        return Contains(row.PolicyCode, s)
            || Contains(row.PolicyTitle, s)
            || Contains(row.PolicyTypeCode, s)
            || Contains(row.StatusCode, s)
            || Contains(row.Description, s)
            || Contains(row.Content, s)
            || Contains(row.OwnedByFullName, s)
            || Contains(row.Version, s)
            || Contains(row.CreatedDateUtc.ToLocalTime().ToString("MM/dd/yyyy"), s)
            || Contains(row.EffectiveDateUtc?.ToLocalTime().ToString("MM/dd/yyyy"), s);
    }

    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private void SetActiveTab(string key)
    {
        _activeTab = key;
        _page = 1;
    }

    private void SetKpiFilter(string? key)
    {
        _kpiFilter = Equals(_kpiFilter, key) ? null : key;
        _page = 1;
    }

    private const string DraftKpi = "Draft";
    private const string PublishedKpi = "Published";
    private const string RetiredKpi = "Retired";
    private const string AckKpi = "__ack";
    private const string EffectiveKpi = "__effective";
    private const string NeedsKpi = "__needs";
    private string KpiClass(string cssClass, string? key) => $"cp-kpi-card {cssClass} {(Equals(_kpiFilter, key) ? "cp-kpi-card--active" : string.Empty)}";
    private string TotalKpiClass => KpiClass("cp-blue", null);
    private string DraftKpiClass => KpiClass("cp-amber", DraftKpi);
    private string PublishedKpiClass => KpiClass("cp-green", PublishedKpi);
    private string RetiredKpiClass => KpiClass("cp-slate", RetiredKpi);
    private string AckKpiClass => KpiClass("cp-purple", AckKpi);
    private string EffectiveKpiClass => KpiClass("cp-cyan", EffectiveKpi);
    private string NeedsKpiClass => KpiClass("cp-red", NeedsKpi);
    private int DraftCount => _rows.Count(r => r.StatusCode == DraftKpi);
    private int PublishedCount => _rows.Count(r => r.StatusCode == PublishedKpi);
    private int RetiredCount => _rows.Count(r => r.StatusCode == RetiredKpi);
    private int AcknowledgedCount => _rows.Sum(r => r.AcknowledgementCount);
    private int EffectiveCount => _rows.Count(r => r.EffectiveDateUtc is not null);
    private int NeedsActionCount => _rows.Count(r => r.StatusCode == DraftKpi || r.AcknowledgementCount == 0);
    private void ClearKpiFilter() { SetKpiFilter(null); }
    private void SetDraftKpiFilter() { SetKpiFilter(DraftKpi); }
    private void SetPublishedKpiFilter() { SetKpiFilter(PublishedKpi); }
    private void SetRetiredKpiFilter() { SetKpiFilter(RetiredKpi); }
    private void SetAckKpiFilter() { SetKpiFilter(AckKpi); }
    private void SetEffectiveKpiFilter() { SetKpiFilter(EffectiveKpi); }
    private void SetNeedsKpiFilter() { SetKpiFilter(NeedsKpi); }

    private void ClearFilters()
    {
        _searchText = null;
        _kpiFilter = null;
        _typeFilter = null;
        _statusFilter = null;
        _activeTab = "all";
        _page = 1;
    }

    private void PreviousPage() => _page = Math.Max(1, _page - 1);
    private void NextPage() => _page = Math.Min(TotalPages, _page + 1);

    private int TabCount(string key) => key switch
    {
        "draft" => _rows.Count(r => r.StatusCode == "Draft"),
        "published" => _rows.Count(r => r.StatusCode == "Published"),
        "retired" => _rows.Count(r => r.StatusCode == "Retired"),
        "effective" => _rows.Count(r => r.EffectiveDateUtc is not null),
        "ack" => _rows.Count(r => r.AcknowledgementCount > 0),
        "board" => FilteredRows.Count(),
        "analytics" => FilteredRows.Count(),
        _ => _rows.Count
    };

    private IReadOnlyList<BoardGroup> BoardGroups =>
    [
        new("Draft", FilteredRows.Where(r => r.StatusCode == "Draft").OrderBy(r => r.EffectiveDateUtc ?? DateTime.MaxValue).ToList()),
        new("Published", FilteredRows.Where(r => r.StatusCode == "Published").OrderByDescending(r => r.PublishedDateUtc ?? r.CreatedDateUtc).ToList()),
        new("Needs Ack", FilteredRows.Where(r => r.AcknowledgementCount == 0 && r.StatusCode != "Retired").OrderBy(r => r.EffectiveDateUtc ?? DateTime.MaxValue).ToList()),
        new("Retired", FilteredRows.Where(r => r.StatusCode == "Retired").OrderByDescending(r => r.RetiredDateUtc ?? r.CreatedDateUtc).ToList())
    ];

    private IReadOnlyList<BreakdownItem> StatusBreakdown => BuildBreakdown(FilteredRows.GroupBy(r => r.StatusCode));
    private IReadOnlyList<BreakdownItem> TypeBreakdown => BuildBreakdown(FilteredRows.GroupBy(r => string.IsNullOrWhiteSpace(r.PolicyTypeCode) ? "Other" : r.PolicyTypeCode));

    private void OpenCreate()
    {
        _editTarget = null;
        _form = new FormModel { EffectiveDateUtc = DateTime.Today.AddDays(30) };
        _showForm = true;
    }

    private void ExecuteShortcut(ShortcutDef shortcut)
    {
        switch (shortcut.Action)
        {
            case "create":
                OpenCreate();
                break;
            case "draft":
                SetActiveTab("draft");
                break;
            case "acknowledgements":
                Nav.NavigateTo("/compliance/acknowledgements");
                break;
            case "policies":
                Nav.NavigateTo("/policies");
                break;
        }
    }

    private void OpenEdit(PolicyDocumentDto row)
    {
        _editTarget = row;
        _form = new FormModel
        {
            PolicyCode = row.PolicyCode,
            PolicyTitle = row.PolicyTitle,
            PolicyTypeCode = row.PolicyTypeCode,
            Version = row.Version,
            EffectiveDateUtc = row.EffectiveDateUtc,
            Description = row.Description,
            Content = row.Content
        };
        _showForm = true;
    }

    private void CloseFormDialog() => _showForm = false;

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            if (_editTarget is null)
            {
                await Api.CreatePolicyDocumentAsync(new CreatePolicyDocumentRequest
                {
                    TenantId = _tenantId,
                    PolicyCode = _form.PolicyCode,
                    PolicyTitle = _form.PolicyTitle,
                    PolicyTypeCode = _form.PolicyTypeCode,
                    Version = _form.Version,
                    EffectiveDateUtc = _form.EffectiveDateUtc,
                    Description = _form.Description,
                    OwnedByUserId = _tenantAdminUserId,
                    CreatedByUserId = _tenantAdminUserId
                });
                ShowToast("Compliance policy created.");
            }
            else
            {
                await Api.UpdatePolicyDocumentAsync(_editTarget.PolicyDocumentId, new UpdatePolicyDocumentRequest
                {
                    PolicyCode = _form.PolicyCode,
                    PolicyTitle = _form.PolicyTitle,
                    PolicyTypeCode = _form.PolicyTypeCode,
                    Version = _form.Version,
                    EffectiveDateUtc = _form.EffectiveDateUtc,
                    Description = _form.Description,
                    Content = _form.Content,
                    OwnedByUserId = _editTarget.OwnedByUserId,
                    ModifiedByUserId = _tenantAdminUserId
                });
                ShowToast("Compliance policy updated.");
            }

            _showForm = false;
            await LoadAsync();
            if (_editTarget is not null)
            {
                await RefreshDrawerAsync(_editTarget.PolicyDocumentId);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenVersion(PolicyDocumentDto row)
    {
        _versionTarget = row;
        _versionForm = new VersionFormModel { NewVersion = NextVersion(row.Version), EffectiveDateUtc = row.EffectiveDateUtc?.AddMonths(12) ?? DateTime.Today.AddMonths(12) };
        _showVersion = true;
    }

    private void CloseVersion() => _showVersion = false;

    private async Task ExecuteVersionAsync()
    {
        if (_versionTarget is null) return;
        _busy = true;
        try
        {
            await Api.CreatePolicyDocumentVersionAsync(_versionTarget.PolicyDocumentId, new VersionPolicyDocumentRequest
            {
                NewVersion = _versionForm.NewVersion,
                EffectiveDateUtc = _versionForm.EffectiveDateUtc,
                Description = _versionForm.Description,
                CreatedByUserId = _tenantAdminUserId
            });
            _showVersion = false;
            ShowToast($"Version {_versionForm.NewVersion} created as Draft.");
            await LoadAsync();
            await RefreshDrawerAsync(_versionTarget.PolicyDocumentId);
        }
        catch (Exception ex)
        {
            ShowToast($"Version creation failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenConfirm(PolicyDocumentDto row, string action)
    {
        _confirmTarget = row;
        _confirmAction = action;
    }

    private void OpenDrawerPublish()
    {
        if (_drawerRow is not null)
        {
            OpenConfirm(_drawerRow, "Publish");
        }
    }

    private void OpenDrawerRetire()
    {
        if (_drawerRow is not null)
        {
            OpenConfirm(_drawerRow, "Retire");
        }
    }

    private void CloseConfirm()
    {
        _confirmTarget = null;
        _confirmAction = null;
    }

    private async Task ExecuteConfirmAsync()
    {
        if (_confirmTarget is null || _confirmAction is null) return;
        _busy = true;
        try
        {
            if (_confirmAction == "Publish")
            {
                await Api.PublishPolicyDocumentAsync(_confirmTarget.PolicyDocumentId, _tenantAdminUserId);
                ShowToast($"'{_confirmTarget.PolicyTitle}' published.");
            }
            else
            {
                await Api.RetirePolicyDocumentAsync(_confirmTarget.PolicyDocumentId, _tenantAdminUserId);
                ShowToast($"'{_confirmTarget.PolicyTitle}' retired.", "warning");
            }

            var id = _confirmTarget.PolicyDocumentId;
            CloseConfirm();
            await LoadAsync();
            await RefreshDrawerAsync(id);
        }
        catch (Exception ex)
        {
            ShowToast($"Workflow action failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenAcknowledgementsAsync(PolicyDocumentDto row)
    {
        _ackTarget = row;
        _acknowledgements.Clear();
        _showAck = true;
        _ackLoading = true;
        try
        {
            var result = await Api.GetPolicyAcknowledgementsAsync(row.PolicyDocumentId);
            _acknowledgements.AddRange(result ?? []);
        }
        catch (Exception ex)
        {
            ShowToast($"Acknowledgements load failed: {ex.Message}", "danger");
        }
        finally
        {
            _ackLoading = false;
        }
    }

    private void CloseAcknowledgements() => _showAck = false;

    private async Task OpenDetailAsync(PolicyDocumentDto row)
    {
        _selected = row;
        _drawerRow = row;
        await LoadRelatedAsync(row.PolicyDocumentId);
    }

    private void CloseDrawer() => _drawerRow = null;

    private async Task RefreshDrawerAsync(Guid documentId)
    {
        if (_drawerRow is null) return;
        _drawerRow = _rows.FirstOrDefault(r => r.PolicyDocumentId == documentId) ?? await Api.GetPolicyDocumentByIdAsync(documentId);
        if (_drawerRow is not null)
        {
            await LoadRelatedAsync(documentId);
        }
    }

    private async Task LoadRelatedAsync(Guid documentId)
    {
        _versions.Clear();
        _audience.Clear();
        var versions = await Api.GetPolicyVersionHistoryAsync(documentId);
        var audience = await Api.GetPolicyAudienceAsync(documentId);
        _versions.AddRange(versions ?? []);
        _audience.AddRange(audience ?? []);
    }

    private void OpenActionMenu(PolicyDocumentDto row, MouseEventArgs args)
    {
        _selected = row;
        _openActionMenuFor = row.PolicyDocumentId;
        _menuXpx = $"{Math.Min(args.ClientX, 1420)}px";
        _menuYpx = $"{Math.Min(args.ClientY, 820)}px";
    }

    private void CloseActionMenu() => _openActionMenuFor = null;

    private async Task ExecuteMenuActionAsync(string action)
    {
        var row = _selected;
        CloseActionMenu();
        if (row is null) return;

        switch (action)
        {
            case "View":
            case "History":
                await OpenDetailAsync(row);
                break;
            case "Edit":
                OpenEdit(row);
                break;
            case "Version":
                OpenVersion(row);
                break;
            case "Acknowledgements":
                await OpenAcknowledgementsAsync(row);
                break;
            case "Publish":
                OpenConfirm(row, "Publish");
                break;
            case "Retire":
                OpenConfirm(row, "Retire");
                break;
            case "OpenDetailPage":
                Nav.NavigateTo($"/compliance/policies/{row.PolicyDocumentId}");
                break;
        }
    }

    private Task ExportAsync()
    {
        var csv = new StringBuilder();
        csv.AppendLine("Policy Code,Title,Type,Version,Status,Effective Date,Owner,Acknowledgements");
        foreach (var row in FilteredRows)
        {
            csv.AppendLine(string.Join(',', Csv(row.PolicyCode), Csv(row.PolicyTitle), Csv(row.PolicyTypeCode), Csv(row.Version), Csv(row.StatusCode), Csv(row.EffectiveDateUtc?.ToLocalTime().ToString("MM/dd/yyyy")), Csv(row.OwnedByFullName), row.AcknowledgementCount.ToString()));
        }

        var url = "data:text/csv;charset=utf-8," + Uri.EscapeDataString(csv.ToString());
        Nav.NavigateTo(url, forceLoad: true);
        ShowToast("Compliance policy export generated.");
        return Task.CompletedTask;
    }

    private RenderFragment CtxBtn(PolicyDocumentDto row) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", "um-btn um-btn-ghost um-btn-sm cp-ctx-btn");
        builder.AddAttribute(seq++, "title", "Actions");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, args => OpenActionMenu(row, args)));
        builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
        builder.OpenElement(seq++, "i");
        builder.AddAttribute(seq++, "class", "bi bi-three-dots-vertical");
        builder.AddAttribute(seq++, "aria-hidden", "true");
        builder.CloseElement();
        builder.CloseElement();
    };

    private static string AvatarClass(PolicyDocumentDto row)
    {
        var bucket = Math.Abs(row.PolicyDocumentId.GetHashCode()) % 6;
        return bucket switch
        {
            0 => "cp-av1",
            1 => "cp-av2",
            2 => "cp-av3",
            3 => "cp-av4",
            4 => "cp-av5",
            _ => "cp-av6"
        };
    }

    private static IReadOnlyList<BreakdownItem> BuildBreakdown(IEnumerable<IGrouping<string, PolicyDocumentDto>> groups)
    {
        var items = groups.Select(g => new { Label = g.Key, Count = g.Count() }).OrderByDescending(g => g.Count).ThenBy(g => g.Label).ToList();
        var max = Math.Max(1, items.Count == 0 ? 1 : items.Max(i => i.Count));
        return items.Select(i => new BreakdownItem(i.Label, i.Count, Math.Max(8, (int)Math.Round(i.Count * 100m / max)))).ToList();
    }

    private RenderFragment DrawerField(string label, string value) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "cp-meta-row");
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "cp-meta-lbl");
        builder.AddContent(seq++, label);
        builder.CloseElement();
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "cp-meta-val");
        builder.AddContent(seq++, value);
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment TypeChip(string type) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", $"cp-type-chip cp-type-{CssSafe(type)}");
        builder.AddContent(seq++, string.IsNullOrWhiteSpace(type) ? "Other" : type);
        builder.CloseElement();
    };

    private RenderFragment StatusChip(string status) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", $"cp-status cp-status-{CssSafe(status)}");
        builder.AddContent(seq++, string.IsNullOrWhiteSpace(status) ? "Draft" : status);
        builder.CloseElement();
    };

    private RenderFragment LifecycleCell(PolicyDocumentDto row) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", $"cp-lifecycle cp-lifecycle-{CssSafe(row.StatusCode)}");
        builder.AddContent(seq++, LifecycleLabel(row));
        builder.CloseElement();
    };

    private static string LifecycleLabel(PolicyDocumentDto row) => row.StatusCode switch
    {
        "Published" => row.PublishedDateUtc.HasValue ? $"Published {row.PublishedDateUtc.Value.ToLocalTime():MM/dd/yyyy}" : "Published",
        "Retired" => row.RetiredDateUtc.HasValue ? $"Retired {row.RetiredDateUtc.Value.ToLocalTime():MM/dd/yyyy}" : "Retired",
        "Draft" => "Draft",
        _ => row.EffectiveDateUtc.HasValue ? $"Effective {row.EffectiveDateUtc.Value.ToLocalTime():MM/dd/yyyy}" : "Draft workflow"
    };

    private static string TypeIcon(string type) => type switch
    {
        "Information Security" => "bi-shield-lock",
        "Privacy" => "bi-incognito",
        "Human Resources" => "bi-people-fill",
        "Finance" => "bi-cash-coin",
        "Operations" => "bi-gear-wide-connected",
        "IT Governance" => "bi-diagram-3",
        _ => "bi-file-earmark-text"
    };

    private static string StatusIcon(string status) => status switch
    {
        "Published" => "bi-check-circle-fill",
        "Retired" => "bi-archive-fill",
        _ => "bi-pencil-fill"
    };

    private static string CssSafe(string? value) => string.IsNullOrWhiteSpace(value) ? "unknown" : value.Trim().ToLowerInvariant().Replace(" ", "-");

    private static string NextVersion(string current)
    {
        if (decimal.TryParse(current, out var version))
        {
            return (version + 1m).ToString("0.0");
        }
        return "2.0";
    }

    private static string Csv(string? value)
    {
        var text = value ?? string.Empty;
        return string.Concat("\"", text.Replace("\"", "\"\""), "\"");
    }

    private void ShowToast(string message, string kind = "success")
    {
        _toastMessage = message;
        _toastKind = kind;
        _toastVisible = true;
    }

    private void HideToast() => _toastVisible = false;
    private Task NotifyValidationAsync() { ShowToast("Review required fields before continuing.", "danger"); return Task.CompletedTask; }

    private sealed record TabDef(string Key, string Label, string Icon);
    private sealed record ShortcutDef(string Icon, string Title, string Subtitle, string Action);
    private sealed record BoardGroup(string Title, List<PolicyDocumentDto> Items);
    private sealed record BreakdownItem(string Label, int Count, int Percent);

    private sealed class FormModel
    {
        [Required, StringLength(50)] public string PolicyCode { get; set; } = string.Empty;
        [Required, StringLength(200)] public string PolicyTitle { get; set; } = string.Empty;
        [Required, StringLength(100)] public string PolicyTypeCode { get; set; } = "Compliance";
        [Required, StringLength(50)] public string Version { get; set; } = "1.0";
        public DateTime? EffectiveDateUtc { get; set; }
        [StringLength(1000)] public string? Description { get; set; }
        [StringLength(8000)] public string? Content { get; set; }
    }

    private sealed class VersionFormModel
    {
        [Required, StringLength(50)] public string NewVersion { get; set; } = string.Empty;
        public DateTime? EffectiveDateUtc { get; set; }
        [StringLength(1000)] public string? Description { get; set; }
    }
}
