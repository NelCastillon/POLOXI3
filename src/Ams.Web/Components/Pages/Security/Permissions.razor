@page "/tenant/security/perms"
@namespace Ams.Web.Components.Pages.SecurityAdmin
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Permissions — Users &amp; Security</PageTitle>

<AppPageHeader Title="Permissions"
               Subtitle="Define and manage granular permission grants and overrides for users"
               Icon="bi-key">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenAddDrawer">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Grant Permission
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="sp-kpi-strip">
    <div class="@KpiClass1" @onclick="() => SetKpiFilter(1)" role="button" tabindex="0">
        <span class="sp-kpi-icon sp-kpi-icon--total"><i class="bi bi-key" aria-hidden="true"></i></span>
        <div><div class="sp-kpi-value">@_totalCount</div><div class="sp-kpi-label">Total Permissions</div></div>
        @if (_kpiActive == 1) { <span class="sp-kpi-active-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass2" @onclick="() => SetKpiFilter(2)" role="button" tabindex="0">
        <span class="sp-kpi-icon sp-kpi-icon--granted"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
        <div><div class="sp-kpi-value">@_activeCount</div><div class="sp-kpi-label">Active</div></div>
        @if (_kpiActive == 2) { <span class="sp-kpi-active-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass3" @onclick="() => SetKpiFilter(3)" role="button" tabindex="0">
        <span class="sp-kpi-icon sp-kpi-icon--denied"><i class="bi bi-x-circle-fill" aria-hidden="true"></i></span>
        <div><div class="sp-kpi-value">@_inactiveCount</div><div class="sp-kpi-label">Inactive</div></div>
        @if (_kpiActive == 3) { <span class="sp-kpi-active-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass4" @onclick="() => SetKpiFilter(4)" role="button" tabindex="0">
        <span class="sp-kpi-icon sp-kpi-icon--expiring"><i class="bi bi-clock" aria-hidden="true"></i></span>
        <div><div class="sp-kpi-value">@_builtInCount</div><div class="sp-kpi-label">Built-in</div></div>
        @if (_kpiActive == 4) { <span class="sp-kpi-active-dot" aria-hidden="true"></span> }
    </div>
</div>

<!-- Filter toolbar -->
<AppFilterPanel @bind-SearchValue="_search"
                OnSearch="OnSearchAsync"
                SearchPlaceholder="Search permission code, name, or resource…">
    <Filters>
        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_typeOptions"
                        Placeholder="All Types"
                        ShowClearButton="true"
                        Width="160px"
                        Value="_filterType"
                        ValueChanged="@((string v) => { _filterType = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>
        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_statusOptions"
                        Placeholder="All Status"
                        ShowClearButton="true"
                        Width="140px"
                        Value="_filterStatus"
                        ValueChanged="@((string v) => { _filterStatus = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>
    </Filters>
</AppFilterPanel>

<!-- Grid -->
<div class="um-grid-card app-datagrid">
    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading…</span>
        </div>
    }
    <SfGrid TValue="PermEntry"
            DataSource="_entries"
            AllowPaging="true"
            AllowSorting="true"
            EnableHover="true"
            RowHeight="52">
        <GridPageSettings PageSize="25" PageSizes="@(new int[] { 10, 25, 50 })" />
        <GridColumns>
            <GridColumn Field="@nameof(PermEntry.PermissionName)" HeaderText="Permission" Width="240">
                <Template>
                    @{ var e = (PermEntry)context; }
                    <div class="sp-user-cell">
                        <span class="sp-avatar" style="@AvatarStyle(e)" aria-hidden="true">@Initials(e.PermissionName)</span>
                        <div>
                            <div class="sp-user-name">@e.PermissionName</div>
                            <div class="sp-user-email">@e.Description</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(PermEntry.PermissionCode)" HeaderText="Code" Width="200">
                <Template>
                    @{ var e = (PermEntry)context; }
                    <span class="sp-perm-code">@e.PermissionCode</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(PermEntry.ResourceCode)" HeaderText="Resource" Width="170">
                <Template>
                    @{ var e = (PermEntry)context; }
                    <span class="sp-perm-code">@e.ResourceCode</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(PermEntry.ActionCode)" HeaderText="Action" Width="110">
                <Template>
                    @{ var e = (PermEntry)context; }
                    <span class="@TypeBadgeClass(e.ActionCode)">@e.ActionCode</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(PermEntry.IsActive)" HeaderText="Status" Width="110">
                <Template>
                    @{ var e = (PermEntry)context; }
                    <AppStatusBadge Status="@(e.IsActive ? "Active" : "Inactive")" />
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(PermEntry.IsBuiltIn)" HeaderText="Built-in" Width="110">
                <Template>
                    @{ var e = (PermEntry)context; }
                    <span class="@(e.IsBuiltIn ? "um-badge um-badge-warning" : "um-badge um-badge-neutral")">@(e.IsBuiltIn ? "Yes" : "No")</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(PermEntry.RoleNames)" HeaderText="Roles" Width="190" AllowSorting="false">
                <Template>
                    @{ var e = (PermEntry)context; }
                    <div class="um-role-list" title="@RoleTitle(e)">
                        @foreach (var roleName in RoleNames(e).Take(2))
                        {
                            <span class="badge badge-blue">@roleName</span>
                        }
                        @if (RoleNames(e).Count > 2)
                        {
                            <span class="um-count-pill">+@(RoleNames(e).Count - 2)</span>
                        }
                        @if (RoleNames(e).Count == 0)
                        {
                            <span class="text-muted">None</span>
                        }
                    </div>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="90" TextAlign="TextAlign.Right">
                <Template>
                    @{ var e = (PermEntry)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenDetail(e)" title="View">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<!-- Add/Edit Drawer -->
<AppCrudDrawer @bind-Visible="_showDrawer"
               Title="@(_editModel.PermissionId == Guid.Empty ? "Grant Permission" : "Edit Permission")"
               OnConfirm="SaveAsync"
               OnClose="CloseDrawer">
    <Content>
        @if (_editContext is not null)
        {
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
            @if (!string.IsNullOrWhiteSpace(_formError))
            {
                <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_formError
                </div>
            }

            <div class="um-field">
            <label>User <span class="text-danger">*</span></label>
            <SfDropDownList TValue="Guid" TItem="UserDto"
                            DataSource="_users"
                            @bind-Value="_editModel.UserId"
                            Placeholder="Select user"
                            AllowFiltering="true"
                            Width="100%">
                <DropDownListFieldSettings Value="UserId" Text="FullName" />
            </SfDropDownList>
            <ValidationMessage For="() => _editModel.UserId" class="text-danger" />
            </div>

            <div class="um-field">
            <label>Permission <span class="text-danger">*</span></label>
            <SfDropDownList TValue="Guid" TItem="PermEntry"
                            DataSource="_allEntries"
                            @bind-Value="_editModel.PermissionId"
                            Placeholder="Select permission"
                            AllowFiltering="true"
                            Width="100%">
                <DropDownListFieldSettings Value="PermissionId" Text="PermissionDisplayText" />
            </SfDropDownList>
            <ValidationMessage For="() => _editModel.PermissionValidationId" class="text-danger" />
            </div>

            <div class="um-field">
            <label>Type</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_typeOptions"
                            @bind-Value="_editModel.PermissionType"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>
            <ValidationMessage For="() => _editModel.PermissionType" class="text-danger" />
            </div>

            <div class="um-field">
            <label>Action</label>
            <SfDropDownList TValue="bool" TItem="LabelValue<bool>"
                            DataSource="_actionOptions"
                            @bind-Value="_editModel.IsGranted"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>
            </div>

            <div class="um-field">
            <label>Expires</label>
            <InputDate class="um-input" @bind-Value="_editModel.ExpiresDate" />
            <ValidationMessage For="() => _editModel.ExpiresDate" class="text-danger" />
            </div>
                </div></div>
            </EditForm>
        }
    </Content>
</AppCrudDrawer>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private SfToast? _toast;

    private List<PermEntry> _allEntries = [];
    private List<PermEntry> _entries    = [];
    private List<UserDto>   _users      = [];

    private bool _loading    = false;
    private bool _showDrawer = false;
    private bool _saving     = false;
    private string _formError = string.Empty;
    private EditContext? _editContext;

    private string _search       = string.Empty;
    private string _filterType   = string.Empty;
    private string _filterStatus = string.Empty;
    private int    _kpiActive    = 0;

    private int _totalCount   = 0;
    private int _activeCount = 0;
    private int _inactiveCount  = 0;
    private int _builtInCount = 0;

    private string KpiClass1 => "sp-kpi-card" + (_kpiActive == 1 ? " sp-kpi-card--active" : "");
    private string KpiClass2 => "sp-kpi-card" + (_kpiActive == 2 ? " sp-kpi-card--active" : "");
    private string KpiClass3 => "sp-kpi-card" + (_kpiActive == 3 ? " sp-kpi-card--active" : "");
    private string KpiClass4 => "sp-kpi-card" + (_kpiActive == 4 ? " sp-kpi-card--active" : "");

    private static readonly List<LabelValue> _typeOptions =
    [
        new("Feature",  "Feature"),
        new("Resource", "Resource"),
        new("Action",   "Action"),
    ];

    private static readonly List<LabelValue> _statusOptions =
    [
        new("Granted", "Granted"),
        new("Denied",  "Denied"),
    ];

    private static readonly List<LabelValue<bool>> _actionOptions =
    [
        new(true,  "Grant"),
        new(false, "Deny"),
    ];

    private PermEntry _editModel = new();

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(
            new("Home",              "/"),
            new("Users & Security",  "/tenant/security/users"),
            new("Permissions",       "/tenant/security/perms"));

        await Task.WhenAll(LoadUsersAsync(), LoadAsync());
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            var result = await Api.SearchUsersAsync(_tenantId, pageSize: 2000);
            _users = result?.Items.OrderBy(u => u.FullName).ToList() ?? [];
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Users failed to load: {ex.Message}", "e-toast-danger");
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var result = await Api.SearchPermissionsAsync(_tenantId, _search, pageSize: 2000);
            _allEntries = result?.Items.Select(MapPermission).ToList() ?? [];
            await LoadRoleNamesAsync();
            ComputeKpi();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Load failed: {ex.Message}", "e-toast-danger");
        }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task LoadRoleNamesAsync()
    {
        var entriesWithRoles = _allEntries.Where(e => e.RoleCount > 0).ToList();
        if (entriesWithRoles.Count == 0) return;

        await Task.WhenAll(entriesWithRoles.Select(async entry =>
        {
            try
            {
                var roles = await Api.GetPermissionRolesAsync(entry.PermissionId);
                entry.RoleNames = roles is null
                    ? string.Empty
                    : string.Join(", ", roles
                    .Select(r => r.RoleName)
                    .Where(roleName => !string.IsNullOrWhiteSpace(roleName))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(roleName => roleName));
            }
            catch
            {
                entry.RoleNames = string.Empty;
            }
        }));
    }

    private async Task OnSearchAsync(string _) => await LoadAsync();

    private void ApplyFilters()
    {
        _entries = _allEntries.Where(e =>
            (string.IsNullOrEmpty(_filterType)   || e.PermissionType == _filterType) &&
            (string.IsNullOrEmpty(_filterStatus) ||
             (_filterStatus == "Granted" && e.IsActive) ||
             (_filterStatus == "Denied"  && !e.IsActive)) &&
            (string.IsNullOrEmpty(_search) ||
             e.PermissionName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             e.PermissionCode.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             e.ResourceCode.Contains(_search, StringComparison.OrdinalIgnoreCase))
        ).ToList();

        if (_kpiActive == 2) _entries = _entries.Where(e => e.IsActive).ToList();
        if (_kpiActive == 3) _entries = _entries.Where(e => !e.IsActive).ToList();
        if (_kpiActive == 4) _entries = _entries.Where(e => e.IsBuiltIn).ToList();

        StateHasChanged();
    }

    private void SetKpiFilter(int n)
    {
        _kpiActive    = _kpiActive == n ? 0 : n;
        _filterStatus = string.Empty;
        ApplyFilters();
    }

    private void ComputeKpi()
    {
        _totalCount    = _allEntries.Count;
        _activeCount  = _allEntries.Count(e => e.IsActive);
        _inactiveCount   = _allEntries.Count(e => !e.IsActive);
        _builtInCount = _allEntries.Count(e => e.IsBuiltIn);
    }

    private void OpenAddDrawer()  { _editModel = new(); _editContext = new(_editModel); _formError = string.Empty; _showDrawer = true; }
    private void OpenEditDrawer(PermEntry e) { _editModel = new PermEntry { PermissionId = e.PermissionId, UserId = e.UserId, UserFullName = e.UserFullName, UserEmail = e.UserEmail, PermissionCode = e.PermissionCode, PermissionType = e.PermissionType, IsGranted = e.IsGranted, ExpiresDate = e.ExpiresDate, GrantedByName = e.GrantedByName }; _editContext = new(_editModel); _showDrawer = true; }
    private void CloseDrawer() { _showDrawer = false; _formError = string.Empty; }
    private void OpenDetail(PermEntry e) => Nav.NavigateTo($"/iam/permissions/{e.PermissionId}");

    private static PermEntry MapPermission(PermissionDto p) => new()
    {
        PermissionId = p.PermissionId,
        PermissionName = string.IsNullOrWhiteSpace(p.PermissionName) ? p.PermissionCode : p.PermissionName,
        PermissionCode = p.PermissionCode,
        ResourceCode = p.ResourceCode,
        ActionCode = p.ActionCode,
        Description = p.Description ?? string.Empty,
        PermissionType = p.ActionCode.ToUpperInvariant() switch
        {
            "READ" or "VIEW" => "Feature",
            "MANAGE" or "DELETE" or "ADMIN" => "Action",
            _ => "Resource",
        },
        IsGranted = p.IsActive,
        IsActive = p.IsActive,
        IsBuiltIn = p.IsBuiltIn,
        RoleCount = p.RoleCount,
        GrantedByName = p.IsBuiltIn ? "System" : "Tenant",
    };

    private async Task SaveAsync()
    {
        _formError = ValidateGrant();
        if (!string.IsNullOrWhiteSpace(_formError))
        {
            await ShowToastAsync(_formError, "e-toast-danger");
            return;
        }

        if (_editContext?.Validate() != true) return;

        _saving = true;
        try
        {
            await Api.GrantPermissionOverrideAsync(new GrantUserPermissionRequest
            {
                TenantId       = _tenantId,
                UserId         = _editModel.UserId,
                PermissionId   = _editModel.PermissionId,
                IsGranted      = _editModel.IsGranted,
                ExpiresDateUtc = _editModel.ExpiresDate?.Date,
            });

            _showDrawer = false;
            await ShowToastAsync($"Permission {(_editModel.IsGranted ? "granted" : "denied")} successfully.", "e-toast-success");
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
            await ShowToastAsync(_formError, "e-toast-danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private string ValidateGrant()
    {
        if (_saving)
            return "Save is already in progress.";
        if (_editModel.UserId == Guid.Empty)
            return "User is required.";
        if (_editModel.PermissionId == Guid.Empty)
            return "Permission is required.";
        if (_editModel.ExpiresDate.HasValue && _editModel.ExpiresDate.Value.Date <= DateTime.Today)
            return "Expires must be a future date.";
        return string.Empty;
    }

    private async Task ShowToastAsync(string msg, string cssClass = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = cssClass });
    }

    private static string Initials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : fullName.Length >= 1 ? fullName[..1] : "?";
    }

    private static string AvatarStyle(PermEntry e)
    {
        var hue = Math.Abs(e.PermissionCode.GetHashCode()) % 360;
        return $"background:hsl({hue},50%,42%);color:#fff;";
    }

    private static string TypeBadgeClass(string type) => type switch
    {
        "Feature"  => "sp-type-badge sp-type-badge--feature",
        "Resource" => "sp-type-badge sp-type-badge--resource",
        "Action"   => "sp-type-badge sp-type-badge--action",
        _          => "sp-type-badge",
    };

    private static string ExpiryClass(PermEntry e)
    {
        if (!e.ExpiresDate.HasValue) return "";
        if (e.ExpiresDate.Value < DateTime.Today)           return "sp-expiry sp-expiry--expired";
        if (e.ExpiresDate.Value < DateTime.Today.AddDays(30)) return "sp-expiry sp-expiry--expiring";
        return "sp-expiry";
    }

    private static IReadOnlyList<string> RoleNames(PermEntry entry)
        => string.IsNullOrWhiteSpace(entry.RoleNames)
            ? []
            : entry.RoleNames
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Where(roleName => !string.IsNullOrWhiteSpace(roleName))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

    private static string RoleTitle(PermEntry entry)
        => RoleNames(entry).Count == 0 ? "No assigned roles" : string.Join(", ", RoleNames(entry));

    private sealed record LabelValue(string Value, string Label);
    private sealed record LabelValue<T>(T Value, string Label);

    private sealed class PermEntry
    {
        public Guid      PermissionId    { get; set; } = Guid.Empty;
        [RequiredGuid(ErrorMessage = "Permission is required.")]
        public Guid      PermissionValidationId { get => PermissionId; set => PermissionId = value; }
        [RequiredGuid(ErrorMessage = "User is required.")]
        public Guid      UserId          { get; set; } = Guid.Empty;
        public string    UserFullName    { get; set; } = string.Empty;
        public string    UserEmail       { get; set; } = string.Empty;
        public string    PermissionName  { get; set; } = string.Empty;
        public string    PermissionCode  { get; set; } = string.Empty;
        public string    ResourceCode    { get; set; } = string.Empty;
        public string    ActionCode      { get; set; } = string.Empty;
        public string    Description     { get; set; } = string.Empty;
        [Required]
        public string    PermissionType  { get; set; } = "Feature";
        public bool      IsGranted       { get; set; } = true;
        public bool      IsActive        { get; set; } = true;
        public bool      IsBuiltIn       { get; set; }
        public int       RoleCount       { get; set; }
        public string    RoleNames       { get; set; } = string.Empty;
        public DateTime? ExpiresDate     { get; set; }
        public string    GrantedByName   { get; set; } = string.Empty;
        public string    PermissionDisplayText => $"{PermissionName} ({PermissionCode})";
    }

    private sealed class RequiredGuidAttribute : ValidationAttribute
    {
        public override bool IsValid(object? value) => value is Guid guid && guid != Guid.Empty;
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
