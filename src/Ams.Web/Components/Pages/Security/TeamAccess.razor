@page "/tenant/security/teams"
@namespace Ams.Web.Components.Pages.SecurityAdmin
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Team Access — Users &amp; Security</PageTitle>

<AppPageHeader Title="Team Access"
               Subtitle="Control which users and roles have access to each team"
               Icon="bi-people-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenAddDrawer">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Access Rule
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="sta-kpi-strip">
    <div class="sta-kpi-card">
        <span class="sta-kpi-icon sta-kpi-icon--teams"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
        <div><div class="sta-kpi-value">@_teamCount</div><div class="sta-kpi-label">Teams</div></div>
    </div>
    <div class="sta-kpi-card">
        <span class="sta-kpi-icon sta-kpi-icon--users"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
        <div><div class="sta-kpi-value">@_userCount</div><div class="sta-kpi-label">Users with Access</div></div>
    </div>
    <div class="sta-kpi-card">
        <span class="sta-kpi-icon sta-kpi-icon--restricted"><i class="bi bi-lock-fill" aria-hidden="true"></i></span>
        <div><div class="sta-kpi-value">@_restrictedCount</div><div class="sta-kpi-label">Restricted Teams</div></div>
    </div>
</div>

<!-- Filter toolbar -->
<AppFilterPanel @bind-SearchValue="_search"
                OnSearch="OnSearchAsync"
                SearchPlaceholder="Search team or user…">
    <Filters>
        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_teamOptions"
                        Placeholder="All Teams"
                        ShowClearButton="true"
                        Width="180px"
                        Value="_filterTeam"
                        ValueChanged="@((string v) => { _filterTeam = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>
    </Filters>
</AppFilterPanel>

<!-- Grid -->
<div class="um-grid-card app-datagrid">
    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading…</span>
        </div>
    }
    <SfGrid TValue="TeamAccessEntry"
            DataSource="_entries"
            AllowPaging="true"
            AllowSorting="true"
            EnableHover="true"
            RowHeight="52">
        <GridPageSettings PageSize="25" PageSizes="@(new int[] { 10, 25, 50 })" />
        <GridColumns>
            <GridColumn Field="@nameof(TeamAccessEntry.TeamName)" HeaderText="Team" Width="180">
                <Template>
                    @{ var e = (TeamAccessEntry)context; }
                    <div class="sta-team-cell">
                        <span class="sta-team-icon" aria-hidden="true"><i class="bi bi-people"></i></span>
                        <div>
                            <div class="sta-team-name">@e.TeamName</div>
                            <div class="sta-team-dept">@e.Department</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(TeamAccessEntry.UserFullName)" HeaderText="User" Width="180">
                <Template>
                    @{ var e = (TeamAccessEntry)context; }
                    <div class="sta-user-cell">
                        <span class="sta-avatar" style="@AvatarStyle(e)" aria-hidden="true">@Initials(e.UserFullName)</span>
                        <span>@e.UserFullName</span>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(TeamAccessEntry.AccessLevel)" HeaderText="Access Level" Width="140">
                <Template>
                    @{ var e = (TeamAccessEntry)context; }
                    <span class="@AccessBadgeClass(e.AccessLevel)">@e.AccessLevel</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(TeamAccessEntry.GrantedByName)" HeaderText="Granted By" Width="160" />
            <GridColumn Field="@nameof(TeamAccessEntry.GrantedDate)" HeaderText="Granted" Width="130">
                <Template>
                    @{ var e = (TeamAccessEntry)context; }
                    <span>@e.GrantedDate.ToString("d")</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Right">
                <Template>
                    @{ var e = (TeamAccessEntry)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditDrawer(e)" title="Edit">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<!-- Add/Edit Drawer -->
<AppCrudDrawer @bind-Visible="_showDrawer"
               Title="@(_editModel.AccessId == Guid.Empty ? "Add Access Rule" : "Edit Access Rule")"
               OnConfirm="SaveAsync"
               OnClose="CloseDrawer">
    <Content>
        <div class="sta-form">
            <label class="sta-form-label">Team *</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_teamOptions"
                            @bind-Value="_editModel.TeamName"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>

            <label class="sta-form-label">User *</label>
            <input class="um-input" @bind="_editModel.UserFullName" placeholder="Search user…" />

            <label class="sta-form-label">Access Level</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_accessLevelOptions"
                            @bind-Value="_editModel.AccessLevel"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>
        </div>
    </Content>
</AppCrudDrawer>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;

    private List<TeamAccessEntry> _allEntries = [];
    private List<TeamAccessEntry> _entries    = [];

    private bool _loading    = false;
    private bool _showDrawer = false;

    private string _search      = string.Empty;
    private string _filterTeam  = string.Empty;

    private int _teamCount       = 0;
    private int _userCount       = 0;
    private int _restrictedCount = 0;

    private static readonly List<LabelValue> _teamOptions = [];

    private static readonly List<LabelValue> _accessLevelOptions =
    [
        new("Full",      "Full Access"),
        new("ReadOnly",  "Read Only"),
        new("Limited",   "Limited"),
    ];

    private TeamAccessEntry _editModel = new();

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",             "/"),
            new("Users & Security", "/tenant/security/users"),
            new("Team Access",      "/tenant/security/teams"));

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            // TODO: replace with Api.GetTeamAccessAsync(_tenantId)
            await Task.Delay(0);
            _allEntries = [];
            ComputeKpi();
            ApplyFilters();
        }
        finally { _loading = false; }
    }

    private async Task OnSearchAsync(string _) => await LoadAsync();

    private void ApplyFilters()
    {
        _entries = _allEntries.Where(e =>
            (string.IsNullOrEmpty(_filterTeam) || e.TeamName == _filterTeam) &&
            (string.IsNullOrEmpty(_search) ||
             e.TeamName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             e.UserFullName.Contains(_search, StringComparison.OrdinalIgnoreCase))
        ).ToList();
        StateHasChanged();
    }

    private void ComputeKpi()
    {
        _teamCount       = _allEntries.Select(e => e.TeamName).Distinct().Count();
        _userCount       = _allEntries.Select(e => e.UserFullName).Distinct().Count();
        _restrictedCount = _allEntries.Count(e => e.AccessLevel != "Full");
    }

    private void OpenAddDrawer()  { _editModel = new(); _showDrawer = true; }
    private void OpenEditDrawer(TeamAccessEntry e) { _editModel = new TeamAccessEntry { AccessId = e.AccessId, TeamName = e.TeamName, Department = e.Department, UserFullName = e.UserFullName, AccessLevel = e.AccessLevel, GrantedByName = e.GrantedByName, GrantedDate = e.GrantedDate }; _showDrawer = true; }
    private void CloseDrawer() => _showDrawer = false;

    private async Task SaveAsync()
    {
        // TODO: Api.SaveTeamAccessAsync
        await Task.Delay(0);
        _showDrawer = false;
        await LoadAsync();
        await ShowToastAsync("Access rule saved.", "e-toast-success");
    }

    private async Task ShowToastAsync(string msg, string cssClass = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = cssClass });
    }

    private static string Initials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : fullName.Length >= 1 ? fullName[..1] : "?";
    }

    private static string AvatarStyle(TeamAccessEntry e)
    {
        var hue = Math.Abs(e.UserFullName.GetHashCode()) % 360;
        return $"background:hsl({hue},50%,42%);color:#fff;";
    }

    private static string AccessBadgeClass(string level) => level switch
    {
        "Full"     => "sta-access-badge sta-access-badge--full",
        "ReadOnly" => "sta-access-badge sta-access-badge--readonly",
        "Limited"  => "sta-access-badge sta-access-badge--limited",
        _          => "sta-access-badge",
    };

    private sealed record LabelValue(string Value, string Label);

    private sealed class TeamAccessEntry
    {
        public Guid     AccessId      { get; set; } = Guid.Empty;
        public string   TeamName      { get; set; } = string.Empty;
        public string   Department    { get; set; } = string.Empty;
        public string   UserFullName  { get; set; } = string.Empty;
        public string   AccessLevel   { get; set; } = "Full";
        public string   GrantedByName { get; set; } = string.Empty;
        public DateTime GrantedDate   { get; set; } = DateTime.Today;
    }
}
