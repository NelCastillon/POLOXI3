@page "/tenant/security/branches"
@namespace Ams.Web.Components.Pages.SecurityAdmin
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.Iam
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Branch Access — Users &amp; Security</PageTitle>

<AppPageHeader Title="Branch Access"
               Subtitle="Control which users and roles have access to each branch"
               Icon="bi-diagram-3">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenAddDrawer">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Access Rule
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="sba-kpi-strip">
    <div class="sba-kpi-card @KpiClass("branches")" @onclick='() => SetKpiFilter("branches")' role="button" tabindex="0" title="Show all branch access rules">
        <span class="sba-kpi-icon sba-kpi-icon--branches"><i class="bi bi-diagram-3-fill" aria-hidden="true"></i></span>
        <div><div class="sba-kpi-value">@_branchCount</div><div class="sba-kpi-label">Branches</div></div>
    </div>
    <div class="sba-kpi-card @KpiClass("users")" @onclick='() => SetKpiFilter("users")' role="button" tabindex="0" title="Show users with branch access">
        <span class="sba-kpi-icon sba-kpi-icon--users"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
        <div><div class="sba-kpi-value">@_userCount</div><div class="sba-kpi-label">Users with Access</div></div>
    </div>
    <div class="sba-kpi-card @KpiClass("restricted")" @onclick='() => SetKpiFilter("restricted")' role="button" tabindex="0" title="Show restricted access rules">
        <span class="sba-kpi-icon sba-kpi-icon--restricted"><i class="bi bi-lock-fill" aria-hidden="true"></i></span>
        <div><div class="sba-kpi-value">@_restrictedCount</div><div class="sba-kpi-label">Restricted Branches</div></div>
    </div>
</div>

<!-- Filter toolbar -->
<AppFilterPanel @bind-SearchValue="_search"
                OnSearch="OnSearchAsync"
                SearchPlaceholder="Search branch or user…">
    <Filters>
        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_branchOptions"
                        Placeholder="All Branches"
                        ShowClearButton="true"
                        Width="180px"
                        Value="_filterBranch"
                        ValueChanged="@((string v) => { _filterBranch = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>
    </Filters>
</AppFilterPanel>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_loadError</div>
}

<!-- Grid -->
<div class="um-grid-card app-datagrid">
    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading…</span>
        </div>
    }
    <SfGrid TValue="BranchAccessEntry"
            DataSource="_entries"
            AllowPaging="true"
            AllowSorting="true"
            EnableHover="true"
            RowHeight="52">
        <GridPageSettings PageSize="25" PageSizes="@(new int[] { 10, 25, 50 })" />
        <GridColumns>
            <GridColumn Field="@nameof(BranchAccessEntry.BranchName)" HeaderText="Branch" Width="180">
                <Template>
                    @{ var e = (BranchAccessEntry)context; }
                    <div class="sba-branch-cell">
                        <span class="sba-branch-icon" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>
                        <div>
                            <div class="sba-branch-name">@e.BranchName</div>
                            <div class="sba-branch-code">@e.BranchCode</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(BranchAccessEntry.UserFullName)" HeaderText="User" Width="180">
                <Template>
                    @{ var e = (BranchAccessEntry)context; }
                    <div class="sba-user-cell">
                        <span class="sba-avatar" style="@AvatarStyle(e)" aria-hidden="true">@Initials(e.UserFullName)</span>
                        <span>@e.UserFullName</span>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(BranchAccessEntry.AccessLevel)" HeaderText="Access Level" Width="140">
                <Template>
                    @{ var e = (BranchAccessEntry)context; }
                    <span class="@AccessBadgeClass(e.AccessLevel)">@e.AccessLevel</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(BranchAccessEntry.GrantedByName)" HeaderText="Granted By" Width="160" />
            <GridColumn Field="@nameof(BranchAccessEntry.GrantedDate)" HeaderText="Granted" Width="130">
                <Template>
                    @{ var e = (BranchAccessEntry)context; }
                    <span>@e.GrantedDate.ToString("d")</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Right">
                <Template>
                    @{ var e = (BranchAccessEntry)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditDrawer(e)" title="Edit">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => ConfirmRemove(e)" title="Remove access">
                        <i class="bi bi-trash3" aria-hidden="true"></i>
                    </button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<!-- Add/Edit Drawer -->
<AppCrudDrawer @bind-Visible="_showDrawer"
               Title="@(_editModel.AccessId == Guid.Empty ? "Add Access Rule" : "Edit Access Rule")"
               OnConfirm="SaveAsync"
               OnClose="CloseDrawer">
    <Content>
        @if (_editContext is not null)
        {
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field">
                    <label>Branch <span class="text-danger">*</span></label>
                    <SfDropDownList TValue="string" TItem="LabelValue"
                                    DataSource="_branchOptions"
                                    @bind-Value="_editModel.BranchName"
                                    Placeholder="Select branch"
                                    Width="100%">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                    <ValidationMessage For="() => _editModel.BranchName" class="text-danger" />
                    </div>

                    <div class="um-field">
                    <label>User <span class="text-danger">*</span></label>
                    <SfDropDownList TValue="Guid" TItem="UserOption"
                                    DataSource="_userOptions"
                                    @bind-Value="_editModel.UserId"
                                    Placeholder="Select user"
                                    Width="100%">
                        <DropDownListFieldSettings Value="UserId" Text="FullName" />
                    </SfDropDownList>
                    <ValidationMessage For="() => _editModel.UserValidationId" class="text-danger" />
                    </div>

                    <div class="um-field">
                    <label>Access Level <span class="text-danger">*</span></label>
                    <SfDropDownList TValue="string" TItem="LabelValue"
                                    DataSource="_accessLevelOptions"
                                    @bind-Value="_editModel.AccessLevel"
                                    Width="100%">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                    <ValidationMessage For="() => _editModel.AccessLevel" class="text-danger" />
                    </div>
                </div></div>
            </EditForm>
        }
    </Content>
</AppCrudDrawer>

<SfDialog @bind-Visible="_showRemoveConfirm" Width="440px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div>
                <div><h3>Remove branch access?</h3><p>Remove access for <strong>@_pendingRemove?.UserFullName</strong> to <strong>@_pendingRemove?.BranchName</strong>?</p></div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CloseRemoveConfirm">Cancel</button>
                <button type="button" class="um-btn um-btn-danger" @onclick="ExecuteRemoveAsync">Remove</button>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;

    private List<BranchAccessEntry> _allEntries = [];
    private List<BranchAccessEntry> _entries    = [];
    private List<LabelValue> _branchOptions = [];
    private List<UserOption> _userOptions = [];

    private bool _loading    = false;
    private bool _showDrawer = false;
    private bool _showRemoveConfirm = false;

    private string _search        = string.Empty;
    private string _filterBranch  = string.Empty;
    private string _activeFilter = string.Empty;
    private string? _loadError;

    private int _branchCount     = 0;
    private int _userCount       = 0;
    private int _restrictedCount = 0;

    private static readonly List<LabelValue> _accessLevelOptions =
    [
        new("Full",      "Full Access"),
        new("ReadOnly",  "Read Only"),
        new("Limited",   "Limited"),
    ];

    private BranchAccessEntry _editModel = new();
    private BranchAccessEntry? _pendingRemove;
    private EditContext? _editContext;

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",             "/"),
            new("Users & Security", "/tenant/security/users"),
            new("Branch Access",    "/tenant/security/branches"));

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _loadError = null;
            await LoadLookupOptionsAsync();
            var scopes = await Api.SearchUserScopesAsync(_tenantId, scopeTypeCode: "Branch", pageSize: 5000);
            _allEntries = scopes?.Items.Where(s => s.IsActive).Select(MapScope).ToList() ?? [];
            ComputeKpi();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _loadError = $"Load failed: {ex.Message}";
            await ShowToastAsync($"Load failed: {ex.Message}", "e-toast-danger");
        }
        finally { _loading = false; }
    }

    private async Task OnSearchAsync(string _) => await LoadAsync();

    private void ApplyFilters()
    {
        _entries = _allEntries.Where(e =>
            (string.IsNullOrEmpty(_filterBranch) || e.BranchName == _filterBranch) &&
            (string.IsNullOrEmpty(_search) ||
             e.BranchName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             e.UserFullName.Contains(_search, StringComparison.OrdinalIgnoreCase))
        ).ToList();
        if (_activeFilter == "restricted") _entries = _entries.Where(e => e.AccessLevel != "Full").ToList();
        if (_activeFilter == "users") _entries = _entries.Where(e => !string.IsNullOrWhiteSpace(e.UserFullName)).ToList();
        StateHasChanged();
    }

    private void SetKpiFilter(string filter)
    {
        _activeFilter = _activeFilter == filter ? string.Empty : filter;
        ApplyFilters();
    }

    private string KpiClass(string filter) => _activeFilter == filter ? "sba-kpi-card--active" : string.Empty;

    private void ComputeKpi()
    {
        _branchCount     = _allEntries.Select(e => e.BranchName).Distinct().Count();
        _userCount       = _allEntries.Select(e => e.UserFullName).Distinct().Count();
        _restrictedCount = _allEntries.Count(e => e.AccessLevel == "Limited" || e.AccessLevel == "ReadOnly");
    }

    private void OpenAddDrawer()  { _editModel = new(); _editContext = new EditContext(_editModel); _showDrawer = true; }
    private void OpenEditDrawer(BranchAccessEntry e) { _editModel = new BranchAccessEntry { AccessId = e.AccessId, BranchName = e.BranchName, BranchCode = e.BranchCode, UserId = e.UserId, UserFullName = e.UserFullName, AccessLevel = e.AccessLevel, GrantedByName = e.GrantedByName, GrantedDate = e.GrantedDate }; _editContext = new EditContext(_editModel); _showDrawer = true; }
    private void CloseDrawer() => _showDrawer = false;

    private async Task SaveAsync()
    {
        try
        {
            if (_editContext?.Validate() != true)
            {
                await ShowToastAsync("Please fix validation errors before saving.", "e-toast-danger");
                return;
            }

            if (_editModel.AccessId != Guid.Empty)
                await Api.RevokeUserScopeAsync(_editModel.AccessId);

            await Api.AssignUserScopeAsync(new AssignUserScopeRequest
            {
                TenantId = _tenantId,
                UserId = _editModel.UserId,
                ScopeTypeCode = "Branch",
                ScopeValue = $"{_editModel.BranchName}|{_editModel.AccessLevel}"
            });

            _showDrawer = false;
            await LoadAsync();
            await ShowToastAsync("Access rule saved.", "e-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Save failed: {ex.Message}", "e-toast-danger");
        }
    }

    private void ConfirmRemove(BranchAccessEntry entry) { _pendingRemove = entry; _showRemoveConfirm = true; }
    private void CloseRemoveConfirm() { _pendingRemove = null; _showRemoveConfirm = false; }
    private async Task ExecuteRemoveAsync()
    {
        if (_pendingRemove is null) return;
        try
        {
            await Api.RevokeUserScopeAsync(_pendingRemove.AccessId);
            CloseRemoveConfirm();
            await LoadAsync();
            await ShowToastAsync("Access rule removed.", "e-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Remove failed: {ex.Message}", "e-toast-danger");
        }
    }

    private async Task LoadLookupOptionsAsync()
    {
        var branches = await Api.SearchBranchesAsync(_tenantId, pageSize: 2000); // No-op context check
        _branchOptions = branches?.Items.Where(b => b.IsActive).OrderBy(b => b.BranchName).Select(b => new LabelValue(b.BranchName, b.BranchName)).ToList() ?? [];

        var users = await Api.SearchUsersAsync(_tenantId, pageSize: 5000);
        _userOptions = users?.Items.OrderBy(u => u.FullName).Select(u => new UserOption(u.UserId, u.FullName, u.Email)).ToList() ?? [];
    }

    private BranchAccessEntry MapScope(UserScopeDto scope)
    {
        var parts = scope.ScopeValue.Split('|', 2, StringSplitOptions.TrimEntries);
        var branchName = parts.ElementAtOrDefault(0) ?? scope.ScopeValue;
        var accessLevel = parts.ElementAtOrDefault(1) ?? "Full";
        return new BranchAccessEntry
        {
            AccessId = scope.UserScopeId,
            UserId = scope.UserId,
            UserFullName = scope.UserFullName ?? _userOptions.FirstOrDefault(u => u.UserId == scope.UserId)?.FullName ?? string.Empty,
            BranchName = branchName,
            BranchCode = branchName,
            AccessLevel = accessLevel,
            GrantedByName = scope.GrantedByFullName ?? "Tenant",
            GrantedDate = scope.GrantedDateUtc
        };
    }

    private async Task ShowToastAsync(string msg, string cssClass = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = cssClass });
    }

    private static string Initials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : fullName.Length >= 1 ? fullName[..1] : "?";
    }

    private static string AvatarStyle(BranchAccessEntry e)
    {
        var hue = Math.Abs(e.UserFullName.GetHashCode()) % 360;
        return $"background:hsl({hue},50%,42%);color:#fff;";
    }

    private static string AccessBadgeClass(string level) => level switch
    {
        "Full"     => "sba-access-badge sba-access-badge--full",
        "ReadOnly" => "sba-access-badge sba-access-badge--readonly",
        "Limited"  => "sba-access-badge sba-access-badge--limited",
        _          => "sba-access-badge",
    };

    private sealed record LabelValue(string Value, string Label);
    private sealed record UserOption(Guid UserId, string FullName, string Email);

    private sealed class BranchAccessEntry
    {
        public Guid     AccessId      { get; set; } = Guid.Empty;
        [Required]
        public string   BranchName    { get; set; } = string.Empty;
        public string   BranchCode    { get; set; } = string.Empty;
        [Required]
        public Guid     UserId        { get; set; } = Guid.Empty;
        [RequiredGuid(ErrorMessage = "User is required.")]
        public Guid     UserValidationId { get => UserId; set => UserId = value; }
        public string   UserFullName  { get; set; } = string.Empty;
        [Required]
        public string   AccessLevel   { get; set; } = "Full";
        public string   GrantedByName { get; set; } = string.Empty;
        public DateTime GrantedDate   { get; set; } = DateTime.Today;
    }

    private sealed class RequiredGuidAttribute : ValidationAttribute
    {
        public override bool IsValid(object? value) => value is Guid guid && guid != Guid.Empty;
    }
}
