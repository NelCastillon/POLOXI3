@page "/tenant/security/audit"
@namespace Ams.Web.Components.Pages.TenantSecurity
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Agency Audit Logs — AMS</PageTitle>

<AppPageHeader Title="Agency Audit Logs"
               Subtitle="Tenant Admin user audit trail for authentication, authorization, access changes, and sensitive field updates"
               Icon="bi-journal-text">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "ad-spin" : "")"></i> Refresh</button>
    </Actions>
</AppPageHeader>

<section class="ta-hero">
    <div>
        <span class="ta-eyebrow">Tenant Admin Security</span>
        <h2>User Audit Trail</h2>
        <p>Review sign-ins, MFA checks, permission decisions, role changes, policy updates, and field-level audit events for the current tenant.</p>
    </div>
    <div class="ta-hero-actions">
        <button class="um-btn um-btn-primary" @onclick='() => SetTab("events")'><i class="bi bi-shield-lock"></i> Security Events</button>
        <button class="um-btn um-btn-ghost" @onclick='() => SetTab("changes")'><i class="bi bi-pencil-square"></i> Field Changes</button>
    </div>
</section>

<section class="ta-kpi-section">
    <div class="ta-kpi-heading"><span>Outcome & Risk</span><small>Click a KPI to filter the audit trail.</small></div>
    <div class="ta-kpi-strip">
        @KpiCard("bi-activity", "Total", TotalCount.ToString(), "All audit events", "ta-kpi-total", null)
        @KpiCard("bi-check-circle-fill", "Success", _securityEvents.Count(x => x.IsSuccess).ToString(), "Successful security events", "ta-kpi-success", "success")
        @KpiCard("bi-exclamation-triangle-fill", "Failed", _securityEvents.Count(x => !x.IsSuccess).ToString(), "Failed security events", "ta-kpi-failed", "failed")
        @KpiCard("bi-fire", "High Risk", _securityEvents.Count(x => (x.RiskScore ?? 0) >= 70).ToString(), "High risk events", "ta-kpi-risk", "risk")
    </div>
</section>

<section class="ta-kpi-section">
    <div class="ta-kpi-heading"><span>Action Events</span><small>Authentication, authorization, policy, and data changes.</small></div>
    <div class="ta-kpi-strip ta-kpi-strip--actions">
        @KpiCard("bi-box-arrow-in-right", "Login", CountAction("Login").ToString(), "Login activity", "ta-kpi-login", "action:Login")
        @KpiCard("bi-box-arrow-right", "Logout", CountAction("Logout").ToString(), "Logout activity", "ta-kpi-logout", "action:Logout")
        @KpiCard("bi-phone-vibrate", "MFA", CountCategory("MFA").ToString(), "MFA challenges and resets", "ta-kpi-mfa", "category:MFA")
        @KpiCard("bi-shield-exclamation", "Denied", CountAction("PermissionDenied").ToString(), "Permission denied events", "ta-kpi-denied", "action:PermissionDenied")
        @KpiCard("bi-person-gear", "Roles", CountCategory("Access Control").ToString(), "Role, permission, and scope changes", "ta-kpi-roles", "category:Access Control")
        @KpiCard("bi-pencil-square", "Field Changes", _fieldChanges.Count.ToString(), "Field-level audit changes", "ta-kpi-change", "changes")
    </div>
</section>

<section class="ta-kpi-section">
    <div class="ta-kpi-heading"><span>Modules</span><small>Where user actions occurred across the enterprise platform.</small></div>
    <div class="ta-kpi-strip ta-kpi-strip--modules">
        @foreach (var module in TopModules)
        {
            @KpiCard(ModuleIcon(module.Name), module.Name, module.Count.ToString(), $"{module.Name} audit events", "ta-kpi-module", $"module:{module.Name}")
        }
    </div>
</section>

<div class="ta-command-bar">
    <div class="ta-search-wrap"><i class="bi bi-search"></i><input @bind="_search" @bind:event="oninput" placeholder="Search user, event, description, IP, entity…" /></div>
    <select class="ta-filter-sel" @bind="_eventType"><option value="">All event types</option>@foreach (var type in EventTypes) { <option value="@type">@type</option> }</select>
    <select class="ta-filter-sel" @bind="_dateFilter"><option value="0">All time</option><option value="1">Today</option><option value="7">Last 7 days</option><option value="30">Last 30 days</option><option value="90">Last 90 days</option></select>
    <select class="ta-filter-sel" @bind="_categoryFilter"><option value="">All categories</option>@foreach (var category in Categories) { <option value="@category">@category</option> }</select>
    <select class="ta-filter-sel" @bind="_moduleFilter"><option value="">All modules</option>@foreach (var module in Modules) { <option value="@module">@module</option> }</select>
    <div class="ta-view-tabs"><button class="ta-view-tab @(_activeTab == "events" ? "ta-view-tab--active" : "")" @onclick='() => SetTab("events")'><i class="bi bi-shield-lock"></i> Security <span>@FilteredEvents.Count()</span></button><button class="ta-view-tab @(_activeTab == "changes" ? "ta-view-tab--active" : "")" @onclick='() => SetTab("changes")'><i class="bi bi-pencil-square"></i> Field Changes <span>@FilteredChanges.Count()</span></button></div>
    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger mt-load-error" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div>
}
@if (_loading)
{
    <div class="mt-loading"><div class="um-spinner"></div><span>Loading audit trail…</span></div>
}

@if (_activeTab == "events")
{
    <div class="ta-layout">
        <div class="ta-feed">
            @foreach (var group in EventGroups)
            {
                <div class="ta-date-sep"><span>@group.Label</span></div>
                @foreach (var item in group.Items)
                {
                    <div class="ta-item @(!item.IsSuccess ? "ta-item-danger" : null) @(_selectedEvent?.SecurityEventId == item.SecurityEventId ? "ta-item-selected" : null)" @onclick="() => SelectEvent(item)">
                        <div class="ta-icon ta-icon-@EventCss(item.EventTypeCode)"><i class="bi @EventIcon(item.EventTypeCode)"></i></div>
                        <div class="ta-body"><div class="ta-hdr"><span class="ta-title">@item.EventDescription</span><span class="ta-chip ta-chip-@EventCss(item.EventTypeCode)">@item.EventTypeCode</span><span class="ta-chip ta-chip-category">@CategoryFor(item.EventTypeCode)</span><span class="ta-chip ta-chip-module">@ModuleFor(item)</span><span class="ta-status @(item.IsSuccess ? "ta-status-success" : "ta-status-danger")">@(item.IsSuccess ? "Success" : "Failed")</span>@if ((item.RiskScore ?? 0) >= 70) { <span class="ta-risk">High risk</span> }</div><div class="ta-meta"><span><i class="bi bi-person"></i> @(item.UserFullName ?? item.UserEmail ?? "System")</span><span><i class="bi bi-globe2"></i> @(item.IpAddress ?? "—")</span><span><i class="bi bi-clock"></i> @FormatAge(item.CreatedDateUtc)</span></div></div>
                    </div>
                }
            }
            @if (!FilteredEvents.Any()) { <div class="ta-empty"><i class="bi bi-shield-slash"></i><span>No security events match the current filters.</span></div> }
        </div>
        @if (_selectedEvent is not null)
        {
            <aside class="ta-detail-panel"><div class="ta-detail-header"><span class="ta-chip ta-chip-@EventCss(_selectedEvent.EventTypeCode)">@_selectedEvent.EventTypeCode</span><button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _selectedEvent = null"><i class="bi bi-x-lg"></i></button></div><h3>@_selectedEvent.EventDescription</h3><div class="ta-detail-grid"><div><span>User</span><strong>@(_selectedEvent.UserFullName ?? _selectedEvent.UserEmail ?? "System")</strong></div><div><span>Category</span><strong>@CategoryFor(_selectedEvent.EventTypeCode)</strong></div><div><span>Module</span><strong>@ModuleFor(_selectedEvent)</strong></div><div><span>IP Address</span><strong>@(_selectedEvent.IpAddress ?? "—")</strong></div><div><span>Risk</span><strong>@(_selectedEvent.RiskScore?.ToString() ?? "—")</strong></div><div><span>Session</span><strong>@(_selectedEvent.SessionId ?? "—")</strong></div><div><span>User Agent</span><strong>@(_selectedEvent.UserAgent ?? "—")</strong></div><div><span>Timestamp</span><strong>@_selectedEvent.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</strong></div></div></aside>
        }
    </div>
}
else
{
    <div class="ta-layout">
        <div class="ta-table-wrap"><table class="ta-table"><thead><tr><th>Changed</th><th>Entity</th><th>Field</th><th>Old</th><th>New</th><th>Source</th><th>IP</th></tr></thead><tbody>@foreach (var item in FilteredChanges.ToList()) { <tr @onclick="() => SelectChange(item)" class="@(_selectedChange?.FieldChangeLogId == item.FieldChangeLogId ? "ta-table-row-selected" : null)"><td>@item.ChangedDateUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td><td>@item.EntityName</td><td><span class="ta-chip ta-chip-change">@item.FieldName</span></td><td class="ta-diff-old">@(item.OldValue ?? "—")</td><td class="ta-diff-new">@(item.NewValue ?? "—")</td><td>@(item.ChangeSource ?? "—")</td><td>@(item.IpAddress ?? "—")</td></tr> }</tbody></table>@if (!FilteredChanges.Any()) { <div class="ta-empty"><i class="bi bi-pencil-square"></i><span>No field changes match the current filters.</span></div> }</div>
        @if (_selectedChange is not null)
        {
            <aside class="ta-detail-panel"><div class="ta-detail-header"><span class="ta-chip ta-chip-change">@_selectedChange.FieldName</span><button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _selectedChange = null"><i class="bi bi-x-lg"></i></button></div><h3>@_selectedChange.EntityName field update</h3><div class="ta-detail-grid"><div><span>Old Value</span><strong>@(_selectedChange.OldValue ?? "—")</strong></div><div><span>New Value</span><strong>@(_selectedChange.NewValue ?? "—")</strong></div><div><span>Changed By</span><strong>@(_selectedChange.ChangedByUserId?.ToString() ?? "—")</strong></div><div><span>Source</span><strong>@(_selectedChange.ChangeSource ?? "—")</strong></div><div><span>IP Address</span><strong>@(_selectedChange.IpAddress ?? "—")</strong></div><div><span>Timestamp</span><strong>@_selectedChange.ChangedDateUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</strong></div></div></aside>
        }
    </div>
}

@code {
    static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    string _search = string.Empty;
    string _eventType = string.Empty;
    string _categoryFilter = string.Empty;
    string _moduleFilter = string.Empty;
    string _activeFilter = string.Empty;
    string _activeTab = "events";
    int _dateFilter = 30;
    string? _loadError;
    bool _loading;
    List<SecurityEventLogDto> _securityEvents = [];
    List<FieldChangeLogDto> _fieldChanges = [];
    SecurityEventLogDto? _selectedEvent;
    FieldChangeLogDto? _selectedChange;

    int TotalCount => _securityEvents.Count + _fieldChanges.Count;
    string[] EventTypes => _securityEvents.Select(x => x.EventTypeCode).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Order().ToArray();
    string[] Categories => _securityEvents.Select(x => CategoryFor(x.EventTypeCode)).Concat(_fieldChanges.Select(_ => "Data Change")).Distinct(StringComparer.OrdinalIgnoreCase).Order().ToArray();
    string[] Modules => _securityEvents.Select(ModuleFor).Concat(_fieldChanges.Select(ModuleFor)).Distinct(StringComparer.OrdinalIgnoreCase).Order().ToArray();
    IEnumerable<ModuleKpi> TopModules => Modules.Select(x => new ModuleKpi(x, _securityEvents.Count(e => ModuleFor(e) == x) + _fieldChanges.Count(c => ModuleFor(c) == x))).Where(x => x.Count > 0).OrderByDescending(x => x.Count).ThenBy(x => x.Name).Take(8);
    IEnumerable<SecurityEventLogDto> FilteredEvents => _securityEvents.Where(x => (string.IsNullOrEmpty(_eventType) || x.EventTypeCode == _eventType) && (string.IsNullOrEmpty(_categoryFilter) || CategoryFor(x.EventTypeCode) == _categoryFilter) && (string.IsNullOrEmpty(_moduleFilter) || ModuleFor(x) == _moduleFilter) && MatchesDate(x.CreatedDateUtc) && MatchesEventFilter(x) && (string.IsNullOrEmpty(_search) || x.EventTypeCode.Contains(_search, StringComparison.OrdinalIgnoreCase) || CategoryFor(x.EventTypeCode).Contains(_search, StringComparison.OrdinalIgnoreCase) || ModuleFor(x).Contains(_search, StringComparison.OrdinalIgnoreCase) || x.EventDescription.Contains(_search, StringComparison.OrdinalIgnoreCase) || (x.UserFullName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) || (x.UserEmail?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) || (x.IpAddress?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))).OrderByDescending(x => x.CreatedDateUtc);
    IEnumerable<FieldChangeLogDto> FilteredChanges => _fieldChanges.Where(x => MatchesDate(x.ChangedDateUtc) && (string.IsNullOrEmpty(_categoryFilter) || _categoryFilter == "Data Change") && (string.IsNullOrEmpty(_moduleFilter) || ModuleFor(x) == _moduleFilter) && (string.IsNullOrEmpty(_activeFilter) || _activeFilter == "changes" || (_activeFilter.StartsWith("module:", StringComparison.OrdinalIgnoreCase) && ModuleFor(x) == _activeFilter[7..])) && (string.IsNullOrEmpty(_search) || ModuleFor(x).Contains(_search, StringComparison.OrdinalIgnoreCase) || x.EntityName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.FieldName.Contains(_search, StringComparison.OrdinalIgnoreCase) || (x.ChangeSource?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) || (x.OldValue?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) || (x.NewValue?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))).OrderByDescending(x => x.ChangedDateUtc);
    IEnumerable<Group<SecurityEventLogDto>> EventGroups => FilteredEvents.GroupBy(x => x.CreatedDateUtc.ToLocalTime().Date).OrderByDescending(g => g.Key).Select(g => new Group<SecurityEventLogDto>(FormatDateLabel(g.Key), g.ToList()));

    protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Home", "/"), new("Users & Security", "/tenant/security/users"), new("Agency Audit Logs", "/tenant/security/audit")); await LoadAsync(); }
    async Task LoadAsync() { _loading = true; _loadError = null; try { var security = await Api.SearchSecurityEventLogsAsync(_search, string.IsNullOrWhiteSpace(_eventType) ? null : _eventType, TenantId, pageSize: 500); var changes = await Api.SearchFieldChangeLogsAsync(TenantId, _search, pageSize: 500); _securityEvents = security?.Items.ToList() ?? []; _fieldChanges = changes?.Items.ToList() ?? []; _selectedEvent = FilteredEvents.FirstOrDefault(); _selectedChange = FilteredChanges.FirstOrDefault(); } catch (Exception ex) { _loadError = $"Failed to load audit trail: {ex.Message}"; } finally { _loading = false; } }
    void SetTab(string tab) => _activeTab = tab;
    void SelectEvent(SecurityEventLogDto item) => _selectedEvent = item;
    void SelectChange(FieldChangeLogDto item) => _selectedChange = item;
    void ResetFilters() { _search = string.Empty; _eventType = string.Empty; _categoryFilter = string.Empty; _moduleFilter = string.Empty; _activeFilter = string.Empty; _dateFilter = 30; }
    void SetFilter(string? filter) { _activeFilter = _activeFilter == (filter ?? string.Empty) ? string.Empty : filter ?? string.Empty; if (_activeFilter.StartsWith("category:", StringComparison.OrdinalIgnoreCase)) _categoryFilter = _activeFilter[9..]; if (_activeFilter.StartsWith("module:", StringComparison.OrdinalIgnoreCase)) _moduleFilter = _activeFilter[7..]; if (_activeFilter == "changes") _activeTab = "changes"; else _activeTab = "events"; }
    bool MatchesDate(DateTime utc) => _dateFilter == 0 || utc >= DateTime.UtcNow.AddDays(-_dateFilter);
    bool MatchesEventFilter(SecurityEventLogDto item) => _activeFilter switch { "success" => item.IsSuccess, "failed" => !item.IsSuccess, "access" => IsAccessEvent(item.EventTypeCode), "mfa" => item.EventTypeCode.Contains("Mfa", StringComparison.OrdinalIgnoreCase), "risk" => (item.RiskScore ?? 0) >= 70, "changes" => false, _ when _activeFilter.StartsWith("action:", StringComparison.OrdinalIgnoreCase) => item.EventTypeCode.Equals(_activeFilter[7..], StringComparison.OrdinalIgnoreCase), _ when _activeFilter.StartsWith("category:", StringComparison.OrdinalIgnoreCase) => CategoryFor(item.EventTypeCode).Equals(_activeFilter[9..], StringComparison.OrdinalIgnoreCase), _ when _activeFilter.StartsWith("module:", StringComparison.OrdinalIgnoreCase) => ModuleFor(item).Equals(_activeFilter[7..], StringComparison.OrdinalIgnoreCase), _ => true };
    static bool IsAccessEvent(string eventType) => eventType.Contains("Permission", StringComparison.OrdinalIgnoreCase) || eventType.Contains("Role", StringComparison.OrdinalIgnoreCase) || eventType.Contains("Access", StringComparison.OrdinalIgnoreCase) || eventType.Contains("Login", StringComparison.OrdinalIgnoreCase);
    int CountAction(string eventType) => _securityEvents.Count(x => x.EventTypeCode.Equals(eventType, StringComparison.OrdinalIgnoreCase));
    int CountCategory(string category) => _securityEvents.Count(x => CategoryFor(x.EventTypeCode).Equals(category, StringComparison.OrdinalIgnoreCase)) + (category == "Data Change" ? _fieldChanges.Count : 0);
    static string CategoryFor(string eventType) => eventType switch { "Login" or "Logout" or "LoginFailed" or "AccountLocked" => "Authentication", "MfaChallenge" or "MfaReset" or "MfaRequired" => "MFA", "PermissionDenied" or "RoleChanged" or "PermissionChanged" or "ScopeGranted" or "PrivilegedAccess" => "Access Control", "PolicyChanged" or "SecurityPolicyUpdated" => "Policy", _ when eventType.Contains("Export", StringComparison.OrdinalIgnoreCase) => "Data Export", _ => "System" };
    static string ModuleFor(SecurityEventLogDto item) { var text = $"{item.EventTypeCode} {item.EventDescription}"; if (text.Contains("CRM", StringComparison.OrdinalIgnoreCase) || text.Contains("lead", StringComparison.OrdinalIgnoreCase) || text.Contains("opportunity", StringComparison.OrdinalIgnoreCase)) return "CRM"; if (text.Contains("billing", StringComparison.OrdinalIgnoreCase) || text.Contains("invoice", StringComparison.OrdinalIgnoreCase)) return "Billing"; if (text.Contains("policy", StringComparison.OrdinalIgnoreCase) || text.Contains("certificate", StringComparison.OrdinalIgnoreCase)) return "Policy"; if (text.Contains("workflow", StringComparison.OrdinalIgnoreCase)) return "Workflow"; if (text.Contains("report", StringComparison.OrdinalIgnoreCase) || text.Contains("export", StringComparison.OrdinalIgnoreCase)) return "Reports"; if (text.Contains("role", StringComparison.OrdinalIgnoreCase) || text.Contains("permission", StringComparison.OrdinalIgnoreCase) || text.Contains("MFA", StringComparison.OrdinalIgnoreCase) || text.Contains("login", StringComparison.OrdinalIgnoreCase)) return "Security"; return "Platform"; }
    static string ModuleFor(FieldChangeLogDto item) { var text = $"{item.EntityName} {item.FieldName} {item.ChangeSource}"; if (text.Contains("Lead", StringComparison.OrdinalIgnoreCase) || text.Contains("Opportunity", StringComparison.OrdinalIgnoreCase) || text.Contains("CRM", StringComparison.OrdinalIgnoreCase)) return "CRM"; if (text.Contains("Invoice", StringComparison.OrdinalIgnoreCase) || text.Contains("Billing", StringComparison.OrdinalIgnoreCase) || text.Contains("Payment", StringComparison.OrdinalIgnoreCase)) return "Billing"; if (text.Contains("Policy", StringComparison.OrdinalIgnoreCase) || text.Contains("Certificate", StringComparison.OrdinalIgnoreCase)) return "Policy"; if (text.Contains("Workflow", StringComparison.OrdinalIgnoreCase)) return "Workflow"; if (text.Contains("User", StringComparison.OrdinalIgnoreCase) || text.Contains("Role", StringComparison.OrdinalIgnoreCase) || text.Contains("Permission", StringComparison.OrdinalIgnoreCase)) return "Security"; return "Platform"; }
    static string ModuleIcon(string module) => module switch { "CRM" => "bi-funnel", "Billing" => "bi-receipt", "Policy" => "bi-shield-check", "Workflow" => "bi-diagram-3", "Reports" => "bi-bar-chart-line", "Security" => "bi-shield-lock", _ => "bi-grid" };
    static string EventCss(string eventType) => eventType.ToLowerInvariant().Replace(" ", "-").Replace("/", "-");
    static string EventIcon(string eventType) => eventType switch { "Login" => "bi-box-arrow-in-right", "Logout" => "bi-box-arrow-right", "LoginFailed" => "bi-exclamation-triangle-fill", "MfaChallenge" => "bi-phone-vibrate", "PermissionDenied" => "bi-shield-exclamation", "AccountLocked" => "bi-lock-fill", "RoleChanged" => "bi-person-gear", _ => "bi-shield-lock" };
    static string FormatDateLabel(DateTime date) => date.Date == DateTime.Today ? "Today" : date.Date == DateTime.Today.AddDays(-1) ? "Yesterday" : date.ToString("dddd, MMMM d");
    static string FormatAge(DateTime utc) { var diff = DateTime.UtcNow - utc; if (diff.TotalMinutes < 60) return $"{Math.Max(1, (int)diff.TotalMinutes)}m ago"; if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago"; if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago"; return utc.ToLocalTime().ToString("MMM d"); }
    RenderFragment KpiCard(string icon, string label, string value, string title, string css, string? filter) => @<button class="ta-kpi-card @css @(_activeFilter == (filter ?? string.Empty) ? "ta-kpi-active" : "")" title="@title" @onclick="() => SetFilter(filter)"><div class="ta-kpi-val">@value</div><div class="ta-kpi-lbl"><i class="bi @icon"></i> @label</div></button>;
    sealed record Group<T>(string Label, List<T> Items);
    sealed record ModuleKpi(string Name, int Count);
}
