@page "/billing/collections"
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Delinquency &amp; Collections — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Delinquency &amp; Collections Queue"
               Subtitle="Tenant Admin view of overdue account collection actions synchronized with Billing invoices"
               Icon="bi-exclamation-triangle">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/billing/invoices")'><i class="bi bi-receipt" aria-hidden="true"></i> Invoices</button>
        <button class="um-btn um-btn-primary" @onclick="OpenAdd"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add Note</button>
    </Actions>
</AppPageHeader>

<div class="col-kpi-strip">
    <button type="button" class="col-kpi" @onclick='() => SetActionFilter("")'><i class="bi bi-exclamation-triangle col-ki red" aria-hidden="true"></i><div><div class="col-kv">@_items.Count</div><div class="col-kl">Open Cases</div></div></button>
    <button type="button" class="col-kpi" @onclick='() => SetActionFilter("Escalated")'><i class="bi bi-clock-history col-ki amber" aria-hidden="true"></i><div><div class="col-kv">@_items.Count(x => x.ActionCode == "Escalated")</div><div class="col-kl">Escalated</div></div></button>
    <button type="button" class="col-kpi" @onclick='() => SetActionFilter("Called")'><i class="bi bi-telephone col-ki blue" aria-hidden="true"></i><div><div class="col-kv">@_items.Count(x => x.ActionCode == "Called")</div><div class="col-kl">Called</div></div></button>
    <button type="button" class="col-kpi" @onclick='() => SetActionFilter("Email Sent")'><i class="bi bi-envelope col-ki blue" aria-hidden="true"></i><div><div class="col-kv">@_items.Count(x => x.ActionCode == "Email Sent")</div><div class="col-kl">Emailed</div></div></button>
    <button type="button" class="col-kpi"><i class="bi bi-calendar-check col-ki green" aria-hidden="true"></i><div><div class="col-kv">@_items.Count(x => x.NextFollowUpDate is not null && x.NextFollowUpDate.Value.ToDateTime(TimeOnly.MinValue) <= DateTime.Today)</div><div class="col-kl">Due Today</div></div></button>
    <button type="button" class="col-kpi"><i class="bi bi-shield-x col-ki red" aria-hidden="true"></i><div><div class="col-kv">@_items.Count(x => x.ActionCode == "Payment Plan")</div><div class="col-kl">Payment Plans</div></div></button>
</div>

<div class="col-subnav">
    <button class="col-snav-btn col-snav-active"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Collections</button>
    <button class="col-snav-btn" @onclick='() => Nav.NavigateTo("/billing/invoices")'><i class="bi bi-receipt" aria-hidden="true"></i> Invoices</button>
    <button class="col-snav-btn" @onclick='() => Nav.NavigateTo("/billing/payments")'><i class="bi bi-cash-coin" aria-hidden="true"></i> Payments</button>
    <button class="col-snav-btn" @onclick='() => Nav.NavigateTo("/billing/payment-experience")'><i class="bi bi-graph-up" aria-hidden="true"></i> Payment Experience</button>
</div>

<div class="col-toolbar">
    <SfTextBox Placeholder="Search notes, actions…" @bind-Value="_searchTerm" Width="280px"></SfTextBox>
    <select class="um-input col-sel" @bind="_filterAction">
        <option value="">All Actions</option>
        @foreach (var action in _actions)
        {
            <option value="@action">@action</option>
        }
    </select>
    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync"><i class="bi bi-search" aria-hidden="true"></i> Search</button>
</div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}

<div class="col-grid-wrap">
    @if (_loading)
    {
        <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading collections…</span></div>
    }
    <SfGrid TValue="CollectionsNoteDto" DataSource="FilteredItems" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridEvents TValue="CollectionsNoteDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="15"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(CollectionsNoteDto.NoteDate)" HeaderText="Date" Type="ColumnType.Date" Format="d" Width="110"></GridColumn>
            <GridColumn HeaderText="Action" Width="140"><Template>@{ var n = (CollectionsNoteDto)context; }<span class="col-action-chip col-ac-@CssKey(n.ActionCode)">@n.ActionCode</span></Template></GridColumn>
            <GridColumn Field="@nameof(CollectionsNoteDto.NoteText)" HeaderText="Note" Width="360"></GridColumn>
            <GridColumn Field="@nameof(CollectionsNoteDto.NextFollowUpDate)" HeaderText="Follow-Up" Type="ColumnType.Date" Format="d" Width="120">
                <Template>@{ var n = (CollectionsNoteDto)context; }@if (n.NextFollowUpDate.HasValue) { var overdue = n.NextFollowUpDate.Value.ToDateTime(TimeOnly.MinValue) <= DateTime.Today; <span class="@(overdue ? "col-followup-overdue" : "")">@n.NextFollowUpDate.Value.ToString("MMM d")</span> }</Template>
            </GridColumn>
            <GridColumn Field="@nameof(CollectionsNoteDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="d" Width="110"></GridColumn>
            <GridColumn HeaderText="Actions" Width="130">
                <Template>
                    @{ var n = (CollectionsNoteDto)context; }
                    <div class="col-row-acts">
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenEdit(n)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick='() => UpdateActionAsync(n, "Resolved")' title="Mark resolved"><i class="bi bi-check-circle" aria-hidden="true"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick='() => UpdateActionAsync(n, "Escalated")' title="Escalate"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i></button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog Width="620px" IsModal="true" @bind-Visible="_showForm" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>@(_editingId == Guid.Empty ? "Add Collections Note" : "Edit Collections Note")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Account <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.AccountId" class="um-input"><option value="@Guid.Empty">Select account…</option>@foreach (var account in _accounts) { <option value="@account.AccountId">@account.AccountName</option> }</InputSelect><ValidationMessage For="() => _form.AccountId" class="text-danger" /></div>
                    <div class="um-field"><label>Invoice</label><InputSelect @bind-Value="_form.InvoiceId" class="um-input"><option value="">None</option>@foreach (var invoice in _invoices) { <option value="@invoice.InvoiceId">@invoice.InvoiceNumber</option> }</InputSelect><ValidationMessage For="() => _form.InvoiceId" class="text-danger" /></div>
                    <div class="um-field"><label>Action <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.ActionCode" class="um-input">@foreach (var action in _actions) { <option value="@action">@action</option> }</InputSelect><ValidationMessage For="() => _form.ActionCode" class="text-danger" /></div>
                    <div class="um-field"><label>Note Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.NoteDate" class="um-input" /><ValidationMessage For="() => _form.NoteDate" class="text-danger" /></div>
                    <div class="um-field"><label>Follow-Up Date</label><InputDate @bind-Value="_form.NextFollowUpDate" class="um-input" /><ValidationMessage For="() => _form.NextFollowUpDate" class="text-danger" /></div>
                    <div class="um-field um-field--full"><label>Note <span class="text-danger">*</span></label><InputTextArea @bind-Value="_form.NoteText" class="um-input" rows="4" /><ValidationMessage For="() => _form.NoteText" class="text-danger" /></div>
                    @if (!string.IsNullOrWhiteSpace(_formError))
                    {
                        <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div>
                    }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Note")</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast _toast = default!;
    private List<CollectionsNoteDto> _items = [];
    private List<BillingAccountDto> _accounts = [];
    private List<InvoiceDto> _invoices = [];
    private string? _searchTerm;
    private string _filterAction = string.Empty;
    private bool _showForm, _loading, _saving;
    private string? _loadError, _formError;
    private Guid _editingId = Guid.Empty;
    private CollectionForm _form = new();
    private EditContext _editContext = default!;
    private readonly List<string> _actions = ["Called", "Email Sent", "Letter Sent", "Escalated", "Payment Plan", "Resolved", "Other"];

    private IEnumerable<CollectionsNoteDto> FilteredItems => _items.Where(x => string.IsNullOrEmpty(_filterAction) || x.ActionCode == _filterAction);

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Billing", "/billing/accounts"), new("Collections", ""));
        _editContext = new(_form);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var notes = await Api.SearchCollectionsNotesAsync(_tenantId, _searchTerm);
            var accounts = await Api.SearchBillingAccountsAsync(_tenantId, pageSize: 500);
            var invoices = await Api.SearchInvoicesAsync(_tenantId);
            _items = notes?.Items.ToList() ?? [];
            _accounts = accounts?.Items.ToList() ?? [];
            _invoices = invoices?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = $"Collections failed to load: {ex.Message}";
            await ToastAsync(_loadError, true);
        }
        finally { _loading = false; }
    }

    private void SetActionFilter(string action) => _filterAction = action;
    private void OnRowSelected(RowSelectEventArgs<CollectionsNoteDto> args) => OpenEdit(args.Data);
    private void OpenAdd() { _editingId = Guid.Empty; _form = new(); _editContext = new(_form); _formError = null; _showForm = true; }
    private void OpenEdit(CollectionsNoteDto note)
    {
        _editingId = note.CollectionsNoteId;
        _form = new CollectionForm { AccountId = note.AccountId, InvoiceId = note.InvoiceId, ActionCode = note.ActionCode, NoteDate = note.NoteDate.ToDateTime(TimeOnly.MinValue), NextFollowUpDate = note.NextFollowUpDate?.ToDateTime(TimeOnly.MinValue), NoteText = note.NoteText };
        _editContext = new(_form);
        _formError = null;
        _showForm = true;
    }
    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        if (!_editContext.Validate()) return;
        _saving = true;
        try
        {
            if (_editingId == Guid.Empty)
            {
                await Api.CreateCollectionsNoteAsync(new CreateCollectionsNoteRequest { TenantId = _tenantId, AccountId = _form.AccountId, InvoiceId = _form.InvoiceId, ActionCode = _form.ActionCode, NoteDate = DateOnly.FromDateTime(_form.NoteDate), NoteText = _form.NoteText, NextFollowUpDate = _form.NextFollowUpDate.HasValue ? DateOnly.FromDateTime(_form.NextFollowUpDate.Value) : null });
                await ToastAsync("Collections note saved.");
            }
            else
            {
                await Api.UpdateCollectionsNoteAsync(_editingId, new UpdateCollectionsNoteRequest { CollectionsNoteId = _editingId, AccountId = _form.AccountId, InvoiceId = _form.InvoiceId, ActionCode = _form.ActionCode, NoteDate = DateOnly.FromDateTime(_form.NoteDate), NoteText = _form.NoteText, NextFollowUpDate = _form.NextFollowUpDate.HasValue ? DateOnly.FromDateTime(_form.NextFollowUpDate.Value) : null });
                await ToastAsync("Collections note updated.");
            }
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
            await ToastAsync(_formError, true);
        }
        finally { _saving = false; }
    }

    private async Task UpdateActionAsync(CollectionsNoteDto note, string action)
    {
        try
        {
            await Api.UpdateCollectionsNoteAsync(note.CollectionsNoteId, new UpdateCollectionsNoteRequest { CollectionsNoteId = note.CollectionsNoteId, AccountId = note.AccountId, InvoiceId = note.InvoiceId, ActionCode = action, NoteDate = note.NoteDate, NoteText = note.NoteText, NextFollowUpDate = note.NextFollowUpDate });
            await ToastAsync($"Collection action set to {action}.");
            await LoadAsync();
        }
        catch (Exception ex) { await ToastAsync($"Update failed: {ex.Message}", true); }
    }

    private async Task ToastAsync(string message, bool isError = false) => await _toast.ShowAsync(new ToastModel { Content = message, CssClass = isError ? "e-toast-danger" : "e-toast-success" });
    private static string CssKey(string value) => value.ToLowerInvariant().Replace(" ", "-");

    private sealed class CollectionForm
    {
        [RequiredGuid(ErrorMessage = "Account is required.")]
        public Guid AccountId { get; set; }
        public Guid? InvoiceId { get; set; }
        [Required, StringLength(80)]
        public string ActionCode { get; set; } = "Called";
        [Required]
        public DateTime NoteDate { get; set; } = DateTime.Today;
        public DateTime? NextFollowUpDate { get; set; }
        [Required, StringLength(2000)]
        public string NoteText { get; set; } = string.Empty;
    }

    private sealed class RequiredGuidAttribute : ValidationAttribute
    {
        public override bool IsValid(object? value) => value is Guid guid && guid != Guid.Empty;
    }
}
