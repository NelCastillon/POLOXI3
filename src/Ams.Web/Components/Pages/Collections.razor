@page "/billing/collections"
@inject ApiClient Api

<PageTitle>Collections</PageTitle>
<h1>Collections Notes</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(CollectionsNoteDto.NoteDate)"         HeaderText="Date"          Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(CollectionsNoteDto.ActionCode)"       HeaderText="Action"        Width="140"></GridColumn>
        <GridColumn Field="@nameof(CollectionsNoteDto.NoteText)"         HeaderText="Note"          Width="360"></GridColumn>
        <GridColumn Field="@nameof(CollectionsNoteDto.NextFollowUpDate)" HeaderText="Follow-Up"     Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(CollectionsNoteDto.CreatedDateUtc)"   HeaderText="Created"       Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<CollectionsNoteDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchCollectionsNotesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
