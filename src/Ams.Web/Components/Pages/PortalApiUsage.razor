@page "/portal/api-usage"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Portal API Usage — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true"><ToastPosition X="Right" Y="Bottom" /></SfToast>

<AppPageHeader Title="Portal API Usage" Subtitle="API calls, integrations, webhooks, and portal automation usage for the last 30 days" Icon="bi-activity">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/portal/my-account")'><i class="bi bi-arrow-left" aria-hidden="true"></i> My Account</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/tenant/integrations/api")'><i class="bi bi-key" aria-hidden="true"></i> API Keys</button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div>
}

<div class="pma-kpi-strip">
    @Kpi("Total Calls", _items.Sum(x => x.Count).ToString("N0"), "bi-activity", "")
    @Kpi("Successful", _items.Where(x => x.Status == "Successful").Sum(x => x.Count).ToString("N0"), "bi-check-circle", "Successful")
    @Kpi("Warnings", _items.Where(x => x.Status == "Warning").Sum(x => x.Count).ToString("N0"), "bi-exclamation-triangle", "Warning")
    @Kpi("Errors", _items.Where(x => x.Status == "Error").Sum(x => x.Count).ToString("N0"), "bi-x-circle", "Error")
</div>

<div class="pma-panel app-datagrid">
    <div class="pma-panel-hdr"><i class="bi bi-activity" aria-hidden="true"></i> API Usage Detail</div>
    <div class="api-filter-bar"><input class="api-search" placeholder="Search endpoint, integration, or detail…" @bind="_search" @bind:event="oninput" /><select class="api-search" @bind="_filter"><option value="">All</option><option>Successful</option><option>Warning</option><option>Error</option></select></div>
    <SfGrid TValue="PortalMetricRecordDto" DataSource="Filtered" AllowSorting="true" AllowPaging="true" AllowTextWrap="true" RowHeight="56">
        <GridTextWrapSettings WrapMode="WrapMode.Content" />
        <GridPageSettings PageSize="20" />
        <GridColumns>
            <GridColumn Field="@nameof(PortalMetricRecordDto.Name)" HeaderText="Endpoint" MinWidth="220" />
            <GridColumn Field="@nameof(PortalMetricRecordDto.Category)" HeaderText="Integration" MinWidth="160" />
            <GridColumn Field="@nameof(PortalMetricRecordDto.Status)" HeaderText="Status" Width="130" />
            <GridColumn Field="@nameof(PortalMetricRecordDto.Owner)" HeaderText="API Key" MinWidth="160" />
            <GridColumn Field="@nameof(PortalMetricRecordDto.Detail)" HeaderText="Detail" MinWidth="260" />
            <GridColumn Field="@nameof(PortalMetricRecordDto.EventDateUtc)" HeaderText="Last Call" Width="145" Type="ColumnType.DateTime" Format="MMM d, h:mm tt" />
            <GridColumn Field="@nameof(PortalMetricRecordDto.Count)" HeaderText="Calls" Width="110" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
        </GridColumns>
    </SfGrid>
</div>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;
    private string _search = string.Empty;
    private string _filter = string.Empty;
    private string? _loadError;
    private List<PortalMetricRecordDto> _items = [];
    private IEnumerable<PortalMetricRecordDto> Filtered => _items.Where(i => (string.IsNullOrEmpty(_filter) || i.Status == _filter) && (string.IsNullOrEmpty(_search) || i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || i.Category.Contains(_search, StringComparison.OrdinalIgnoreCase) || i.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) || i.Detail.Contains(_search, StringComparison.OrdinalIgnoreCase)));
    protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Home", "/"), new("Portal", "/portal/users"), new("API Usage", "")); await LoadAsync(); }
    private async Task LoadAsync() { try { _loadError = null; _items = (await Api.SearchPortalMetricRecordsAsync(_tenantId, "PortalApiUsage"))?.Items.ToList() ?? []; } catch (Exception ex) { _loadError = $"Unable to load API usage: {ex.Message}"; if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = _loadError, CssClass = "e-toast-danger" }); } }
    private RenderFragment Kpi(string label, string value, string icon, string filter) => @<button type="button" class="pma-kpi-card pma-ki-gray" @onclick="() => _filter = _filter == filter ? string.Empty : filter"><i class="bi @icon pma-kpi-icon"></i><div><div class="pma-kpi-value">@value</div><div class="pma-kpi-label">@label</div><span>@(string.IsNullOrEmpty(filter) ? "all records" : "click to filter")</span></div></button>;
}
