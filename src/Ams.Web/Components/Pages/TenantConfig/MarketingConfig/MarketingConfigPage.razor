@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.MarketingConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>@Title — Marketing Setup</PageTitle>
<AppPageHeader Title="@Title" Subtitle="@Subtitle" Icon="@Icon"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> Add</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<div class="pc-kpi-strip"><div class="pc-kpi-card @(_activeFilter==""?"pc-kpi-card--active":"")" @onclick='()=>SetFilter("")' title="Show all" style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="@Icon"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total</div></div></div><div class="pc-kpi-card @(_activeFilter=="active"?"pc-kpi-card--active":"")" @onclick='()=>SetFilter("active")' title="Show active" style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x=>x.IsActive)</div><div class="pc-kpi-label">Active</div></div></div><div class="pc-kpi-card @(_activeFilter=="inactive"?"pc-kpi-card--active":"")" @onclick='()=>SetFilter("inactive")' title="Show inactive" style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-pause-circle"></i></span><div><div class="pc-kpi-value">@_items.Count(x=>!x.IsActive)</div><div class="pc-kpi-label">Inactive</div></div></div></div>
@if(_loadError is not null){<div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div>}
<AppFilterPanel @bind-SearchValue="_search" OnSearch="OnSearchAsync" SearchPlaceholder="Search code, name, or category..." />
<div class="um-grid-card">@if(_loading){<div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading...</span></div>}<SfGrid TValue="MarketingConfigItemDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52"><GridEvents TValue="MarketingConfigItemDto" RowSelected="OnRowSelected"/><GridPageSettings PageSize="25"/><GridColumns><GridColumn Field="Code" HeaderText="Code" Width="140"/><GridColumn Field="Name" HeaderText="Name" Width="220"/><GridColumn Field="Category" HeaderText="Category" Width="160"/><GridColumn Field="Description" HeaderText="Description" Width="280"/><GridColumn Field="SortOrder" HeaderText="Order" Width="80" TextAlign="TextAlign.Center"/><GridColumn Field="IsActive" HeaderText="Status" Width="100" TextAlign="TextAlign.Center"><Template>@{var r=(MarketingConfigItemDto)context;}<span class="um-badge @(r.IsActive?"um-badge-success":"um-badge-neutral")">@(r.IsActive?"Active":"Inactive")</span></Template></GridColumn><GridColumn HeaderText="" Width="90" TextAlign="TextAlign.Center"><Template>@{var r=(MarketingConfigItemDto)context;}<button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="()=>OpenEdit(r)"><i class="bi bi-pencil"></i></button><button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick:stopPropagation="true" @onclick="()=>ConfirmDelete(r)"><i class="bi bi-trash"></i></button></Template></GridColumn></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="640px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm"/><DialogContent><div class="um-modal-header"><i class="@Icon"></i><span>@(_editId.HasValue?$"Edit {Title}":$"Add {Title}")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="()=>_showForm=false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator/><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.Code" class="um-input"/></div><div class="um-field"><label>Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.Name" class="um-input"/></div><div class="um-field"><label>Category</label><InputText @bind-Value="_form.Category" class="um-input"/></div><div class="um-field"><label>Sort Order</label><InputNumber @bind-Value="_form.SortOrder" class="um-input"/></div><div class="um-field um-field--full"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="2"/></div><div class="um-field um-field--full"><label>Configuration JSON</label><InputTextArea @bind-Value="_form.ConfigurationJson" class="um-input" rows="4"/></div><div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsActive"/> Active</label></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="()=>_showForm=false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue?"Save Changes":"Create")</button></div></EditForm></DialogContent></SfDialog>
<SfDialog @bind-Visible="_showDelete" Width="420px" IsModal="true" ShowCloseIcon="false"><DialogContent><div class="um-confirm-dialog"><div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash3-fill"></i></div><div class="um-confirm-title">Delete Item</div><div class="um-confirm-body">Delete <strong>@_deleteTarget?.Name</strong>?</div><div class="um-modal-footer"><button class="um-btn um-btn-ghost" @onclick="()=>_showDelete=false">Cancel</button><button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div></div></DialogContent></SfDialog>
<EnterpriseToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" /><style>.validation-message{display:flex;align-items:center;gap:.45rem;margin-top:.55rem;color:#dc3545!important;font-size:.875rem;font-weight:700}.validation-message::before{content:"!";display:inline-flex;align-items:center;justify-content:center;width:1rem;height:1rem;min-width:1rem;flex-shrink:0;border-radius:999px;color:#fff;background:linear-gradient(135deg,#ef4444,#b91c1c);font-size:.7rem;font-weight:800}</style>
@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;[Parameter,EditorRequired]public string Kind{get;set;}=string.Empty;[Parameter,EditorRequired]public string Title{get;set;}=string.Empty;[Parameter]public string Subtitle{get;set;}="Manage marketing setup";[Parameter]public string Icon{get;set;}="bi bi-megaphone-fill";Guid TenantId { get; set; }List<MarketingConfigItemDto> _items=[];List<MarketingConfigItemDto> _filtered=[];string _activeFilter="";bool _loading,_saving,_showForm,_showDelete;string _search=string.Empty;string? _loadError;Guid? _editId;MarketingConfigItemDto? _deleteTarget;EnterpriseToast _toast=default!;FormModel _form=new();protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();Breadcrumbs.SetCrumbs(new("Home","/"),new("Marketing Setup",null),new(Title,null));await LoadAsync();}async Task LoadAsync(){_loading=true;_loadError=null;try{var r=await Api.SearchMarketingConfigItemsAsync(TenantId,Kind,_search,pageSize:200);_items=r?.Items.ToList()??[];ApplyFilter();}catch(Exception ex){_loadError=ex.Message;}finally{_loading=false;}}void SetFilter(string f){_activeFilter=f;ApplyFilter();}void ApplyFilter()=>_filtered=_activeFilter switch{"active"=>_items.Where(x=>x.IsActive).ToList(),"inactive"=>_items.Where(x=>!x.IsActive).ToList(),_=>[.._items]};Task OnSearchAsync()=>LoadAsync();void OnRowSelected(RowSelectEventArgs<MarketingConfigItemDto> args)=>OpenEdit(args.Data);void OpenCreate(){_editId=null;_form=new(){ConfigurationJson="{}"};_showForm=true;}void OpenEdit(MarketingConfigItemDto i){_editId=i.MarketingConfigItemId;_form=new(){Code=i.Code,Name=i.Name,Category=i.Category,Description=i.Description,ConfigurationJson=i.ConfigurationJson,SortOrder=i.SortOrder,IsActive=i.IsActive};_showForm=true;}async Task SaveAsync(){_saving=true;try{if(_editId.HasValue)await Api.UpdateMarketingConfigItemAsync(_editId.Value,new(_form.Code,_form.Name,_form.Category,_form.Description,_form.ConfigurationJson,_form.IsActive,_form.SortOrder));else await Api.CreateMarketingConfigItemAsync(new(TenantId,Kind,_form.Code,_form.Name,_form.Category,_form.Description,_form.ConfigurationJson,_form.SortOrder));_showForm=false;await _toast.ShowAsync(new(){Content="Saved successfully",CssClass="e-toast-success"});await LoadAsync();}catch(Exception ex){await _toast.ShowAsync(new(){Content=$"Save failed: {ex.Message}",CssClass="e-toast-danger"});}finally{_saving=false;}}void ConfirmDelete(MarketingConfigItemDto i){_deleteTarget=i;_showDelete=true;}async Task ExecuteDeleteAsync(){_saving=true;try{await Api.DeleteMarketingConfigItemAsync(_deleteTarget!.MarketingConfigItemId);_showDelete=false;await _toast.ShowAsync(new(){Content="Deleted successfully",CssClass="e-toast-success"});await LoadAsync();}catch(Exception ex){await _toast.ShowAsync(new(){Content=$"Delete failed: {ex.Message}",CssClass="e-toast-danger"});}finally{_saving=false;}}void ResetForm(){_form=new();_editId=null;}sealed class FormModel{[Required,StringLength(80)]public string Code{get;set;}=string.Empty;[Required,StringLength(200)]public string Name{get;set;}=string.Empty;[StringLength(120)]public string? Category{get;set;}[StringLength(500)]public string? Description{get;set;}[StringLength(4000)]public string? ConfigurationJson{get;set;}[Range(0,9999)]public int SortOrder{get;set;}public bool IsActive{get;set;}=true;}
    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
