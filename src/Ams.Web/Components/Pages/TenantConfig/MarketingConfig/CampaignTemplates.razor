@page "/tenant/marketing/templates"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.MarketingConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Campaign Templates Command Center - AMS</PageTitle>

<div class="cd-page" @onclick="CloseActionMenu">
    <section class="cd-hero">
        <div class="cd-hero__content">
            <div class="cd-hero-left">
                <span class="cd-hero-icon"><i class="bi bi-layout-text-sidebar" aria-hidden="true"></i></span>
                <div class="cd-hero-title">
                    <div class="cd-hero__eyebrow">Enterprise campaign templates command center</div>
                    <div class="cd-title-row">
                        <h1>Campaign Templates</h1>
                        <div class="cd-hero__meta">
                            <span><i class="bi bi-layers" aria-hidden="true"></i>@_items.Count templates</span>
                            <span><i class="bi bi-check-circle" aria-hidden="true"></i>@_items.Count(i => i.IsActive) active</span>
                            <span><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>@_items.Count(IsHighImportance) high importance</span>
                            <span><i class="bi bi-code-slash" aria-hidden="true"></i>@_items.Count(HasConfiguration) configured</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Govern reusable campaign templates, email and SMS content defaults, audience-fit messaging, lifecycle automation templates, cross-sell and win-back playbooks, compliance language, channel settings, and audit-ready marketing configuration.</p>
        </div>
        <div class="cd-hero__actions">
            <button type="button" class="cd-btn cd-btn--light" @onclick="RefreshAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "cd-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="cd-btn cd-btn--light" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="cd-btn cd-btn--light" @onclick="OpenCampaignBuilder"><i class="bi bi-megaphone" aria-hidden="true"></i> Campaign Builder</button>
            <button type="button" class="cd-btn cd-btn--primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Template</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger cd-alert" style="border-left: 4px solid #dc3545; animation: cd-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="cd-kpi-strip" aria-label="Campaign template KPIs">
        @KpiCard("all", "Templates", _items.Count.ToString(), "All reusable campaign templates", "bi-layout-text-sidebar", "blue")
        @KpiCard("active", "Active", _items.Count(i => i.IsActive).ToString(), "Templates currently enabled for campaign workflows", "bi-check-circle", "green")
        @KpiCard("importance", "Important", _items.Count(IsHighImportance).ToString(), "High-impact campaign templates", "bi-exclamation-octagon", "red")
        @KpiCard("needsconfig", "Needs Config", _items.Count(NeedsConfiguration).ToString(), "Active templates missing JSON configuration", "bi-braces", "amber")
        @KpiCard("email", "Email/SMS", _items.Count(IsChannelTemplate).ToString(), "Email, SMS, subject, preview, and channel content templates", "bi-envelope-paper", "purple")
        @KpiCard("lifecycle", "Lifecycle", _items.Count(IsLifecycleTemplate).ToString(), "Renewal, onboarding, nurture, cross-sell, and win-back templates", "bi-diagram-3", "cyan")
        @KpiCard("compliance", "Compliance", _items.Count(IsComplianceTemplate).ToString(), "Opt-out, consent, legal, brand, and approval-controlled templates", "bi-shield-check", "blue")
    </section>

    <section class="cd-workflows" aria-label="Campaign template shortcuts">
        @WorkflowButton("Template health", "Prioritize active high-impact campaign templates", "bi-activity", () => SetDashboardFocus("active", "importance"))
        @WorkflowButton("Configuration gaps", "Find active templates missing JSON", "bi-shield-exclamation", () => SetDashboardFocus("needsconfig", "importance"))
        @WorkflowButton("Channels", "Review email, SMS, subject, and preview content templates", "bi-envelope-paper", () => SetDashboardFocus("email", "importance"))
        @WorkflowButton("Lifecycle plays", "Review renewal, nurture, onboarding, cross-sell, and win-back templates", "bi-diagram-3", () => SetDashboardFocus("lifecycle", "importance"))
        @WorkflowButton("Compliance", "Review opt-out, consent, legal, brand, and approval templates", "bi-shield-check", () => SetDashboardFocus("compliance", "name"))
    </section>

    <section class="cd-filter-panel" aria-label="Campaign template filters">
        <div class="cd-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" placeholder="Search code, name, category, email, SMS, subject, lifecycle, renewal, cross-sell, compliance, consent, or configuration..." aria-label="Search campaign templates" value="@_searchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="cd-filter-grid">
            <label><span>Status</span><select class="form-select" @bind="_statusFilter" @bind:after="ApplyFilters"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option></select></label>
            <label><span>Category</span><select class="form-select" @bind="_categoryFilter" @bind:after="ApplyFilters"><option value="">All categories</option>@foreach (var category in CategoryOptions) { <option value="@category">@category</option> }</select></label>
            <label><span>Sort</span><select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters"><option value="importance">Importance</option><option value="name">Name</option><option value="category">Category</option><option value="created">Newest</option></select></label>
        </div>
        <button type="button" class="cd-btn cd-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
    </section>

    <nav class="cd-tabs" aria-label="Campaign template views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="cd-tab @(_activeTab == tab.Key ? "cd-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i><span>@tab.Label</span><strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </nav>

    <main class="cd-dashboard">
        <section class="cd-main-card">
            <div class="cd-card-header">
                <div><span class="cd-section-kicker">@ActiveViewTitle</span><h2>@FilteredItems.Count() templates</h2><p>Ranked by enterprise importance: active campaign impact, lifecycle and cross-sell coverage, channel readiness, compliance language, missing configuration, execution order, and recency.</p></div>
                <div class="cd-card-actions">
                    <button type="button" class="cd-btn cd-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="cd-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="cd-btn cd-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="cd-loading"><span class="cd-spinner"></span> Loading campaign templates...</div>
            }
            else if (!FilteredItems.Any())
            {
                <div class="cd-empty"><i class="bi bi-layout-text-sidebar" aria-hidden="true"></i><strong>No campaign templates found</strong><span>Adjust the active tab, KPI, search, or filters.</span></div>
            }
            else
            {
                <div class="cd-table-wrap">
                    <table class="cd-table" aria-label="Campaign templates">
                        <thead><tr><th>Importance</th><th>Template</th><th>Category</th><th>Status</th><th>Configuration</th><th>Order</th><th class="cd-actions-col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var item in PagedItems)
                            {
                                <tr class="@(_selected?.MarketingConfigItemId == item.MarketingConfigItemId ? "cd-row cd-row--selected" : "cd-row")" @onclick="() => SelectRow(item)">
                                    <td>@ImportanceBadge(item)</td>
                                    <td><div class="cd-rule-cell"><div class="cd-rule-icon"><i class="bi @KindIcon(item.Kind)" aria-hidden="true"></i></div><div class="cd-rule-meta"><button type="button" class="cd-link-button" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)">@item.Name</button><small>@item.Code</small></div></div></td>
                                    <td><span class="cd-pill cd-pill--blue">@Safe(item.Category, "General")</span></td>
                                    <td>@StatusBadge(item)</td>
                                    <td>@ConfigurationBadge(item)</td>
                                    <td><span class="cd-count-pill">@item.SortOrder</span></td>
                                    <td class="cd-actions-col"><button type="button" class="cd-icon-btn" title="Open action menu" @onclick:stopPropagation="true" @onclick="() => ToggleActionMenu(item)"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>@if (_openActionMenuFor == item.MarketingConfigItemId) { <div class="cd-menu" role="menu" @onclick:stopPropagation="true"><div class="cd-menu__summary"><strong>@item.Name</strong><span>Campaign Template</span></div><button type="button" class="cd-menu-item" role="menuitem" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i><span>Edit template</span></button><button type="button" class="cd-menu-item" role="menuitem" @onclick="() => OpenClone(item)"><i class="bi bi-copy" aria-hidden="true"></i><span>Clone template</span></button><button type="button" class="cd-menu-item" role="menuitem" @onclick="() => OpenCampaignBuilder()"><i class="bi bi-megaphone" aria-hidden="true"></i><span>Open campaign builder</span></button><button type="button" class="cd-menu-item" role="menuitem" @onclick="() => ConfirmToggleActive(item)"><i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i><span>@(item.IsActive ? "Pause" : "Activate")</span></button><button type="button" class="cd-menu-item cd-menu-item--danger" role="menuitem" @onclick="() => ConfirmDelete(item)"><i class="bi bi-trash3" aria-hidden="true"></i><span>Delete template</span></button></div> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="cd-side-panel">
            <section class="cd-panel-card">
                <span class="cd-section-kicker">Selected campaign template</span>
                @if (_selected is null)
                {
                    <div class="cd-empty cd-empty--compact"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a template</strong><span>Choose a campaign template to inspect marketing importance and actions.</span></div>
                }
                else
                {
                    <div class="cd-selected"><div class="cd-selected__title"><div class="cd-rule-icon cd-rule-icon--lg"><i class="bi @KindIcon(_selected.Kind)"></i></div><div><h3>@_selected.Name</h3><span>@_selected.Code</span></div></div><div class="cd-score-card cd-score-card--@ImportanceTone(_selected)"><span>Template importance score</span><strong>@ImportanceScore(_selected)</strong><small>@ImportanceLevel(_selected)</small></div><dl class="cd-detail-list"><div><dt>Category</dt><dd>@Safe(_selected.Category, "General")</dd></div><div><dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd></div><div><dt>Configuration</dt><dd>@ConfigurationText(_selected)</dd></div><div><dt>Created</dt><dd>@_selected.CreatedDateUtc.ToString("MMM d, yyyy")</dd></div></dl>@if (!string.IsNullOrWhiteSpace(_selected.Description)) { <p class="cd-selected-desc">@_selected.Description</p> }<div class="cd-selected-actions"><button type="button" class="cd-btn cd-btn--primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="cd-btn cd-btn--ghost" @onclick="() => OpenClone(_selected)"><i class="bi bi-copy" aria-hidden="true"></i> Clone</button><button type="button" class="cd-btn cd-btn--ghost" @onclick="OpenCampaignBuilder"><i class="bi bi-megaphone" aria-hidden="true"></i> Builder</button></div></div>
                }
            </section>
            <section class="cd-panel-card"><span class="cd-section-kicker">Template intelligence</span><div class="cd-insight-list">@foreach (var insight in Insights) { <div class="cd-insight"><i class="bi @insight.Icon" aria-hidden="true"></i><div><strong>@insight.Title</strong><span>@insight.Description</span></div></div> }</div></section>
        </aside>
    </main>
</div>

@if (_showForm)
{
    <div class="cd-modal-backdrop" role="presentation" @onclick="CloseForm"><div class="cd-modal" role="dialog" aria-modal="true" aria-labelledby="cd-form-title" @onclick:stopPropagation="true"><div class="cd-modal__header"><i class="bi @(_editId.HasValue ? "bi-pencil-square" : "bi-plus-circle")" aria-hidden="true"></i><span id="cd-form-title">@(_editId.HasValue ? "Edit Campaign Template" : _isClone ? "Clone Campaign Template" : "Add Campaign Template")</span><button type="button" class="cd-icon-btn cd-icon-btn--light ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div><EditForm EditContext="@_editContext" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="cd-modal__body"><div class="cd-form-grid"><label class="cd-field"><span>Code <em>*</em></span><InputText @bind-Value="_form.Code" class="form-control" /></label><label class="cd-field"><span>Name <em>*</em></span><InputText @bind-Value="_form.Name" class="form-control" /></label><label class="cd-field"><span>Category</span><InputText @bind-Value="_form.Category" class="form-control" /></label><label class="cd-field"><span>Sort Order</span><InputNumber @bind-Value="_form.SortOrder" class="form-control" /></label><label class="cd-field cd-field--full"><span>Description</span><InputTextArea @bind-Value="_form.Description" class="form-control" rows="3" /></label><label class="cd-field cd-field--full"><span>Configuration JSON</span><InputTextArea @bind-Value="_form.ConfigurationJson" class="form-control cd-json" rows="6" /></label><label class="cd-check-row"><InputCheckbox @bind-Value="_form.IsActive" /><span>Active</span></label></div>@if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger cd-form-alert" style="border-left: 4px solid #dc3545; animation: cd-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> @_formError</div> }</div><div class="cd-modal__footer"><button type="button" class="cd-btn cd-btn--ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="cd-btn cd-btn--primary" disabled="@_saving">@if (_saving) { <span class="cd-spin-sm" aria-hidden="true"></span> } @(_editId.HasValue ? "Save Changes" : _isClone ? "Clone Template" : "Create Template")</button></div></EditForm></div></div>
}

@if (_showConfirm)
{
    <div class="cd-modal-backdrop" role="presentation" @onclick="CloseConfirm"><div class="cd-confirm" role="dialog" aria-modal="true" aria-labelledby="cd-confirm-title" @onclick:stopPropagation="true"><div class="cd-modal__header"><i class="bi @_confirmIcon" aria-hidden="true"></i><span>Confirm action</span><button type="button" class="cd-icon-btn cd-icon-btn--light ms-auto" @onclick="CloseConfirm" disabled="@_saving"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div><div class="cd-confirm__body"><div class="@(_confirmDanger ? "cd-confirm-icon cd-confirm-icon--danger" : "cd-confirm-icon")"><i class="bi @_confirmIcon" aria-hidden="true"></i></div><div><h3 id="cd-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div></div><div class="cd-modal__footer"><button type="button" class="cd-btn cd-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button><button type="button" class="@(_confirmDanger ? "cd-btn cd-btn--danger" : "cd-btn cd-btn--primary")" @onclick="ExecuteConfirmedActionAsync" disabled="@_saving">@if (_saving) { <span class="cd-spin-sm" aria-hidden="true"></span> } Confirm</button></div></div></div>
}

<div class="cd-toast-stack" aria-live="polite" aria-atomic="true">@foreach (var toast in _toasts) { <div class="cd-toast @toast.CssClass"><i class="bi @(toast.CssClass.Contains("danger") ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)"><i class="bi bi-x" aria-hidden="true"></i></button></div> }</div>

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private const string Kind = "CampaignTemplate";
    private readonly KindDef[] _kinds = [new("CampaignTemplate", "Campaign Templates", "Templates", "bi-layout-text-sidebar", "/tenant/marketing/templates")];
    private readonly TabDef[] _tabs = [new("all", "All", "bi-layout-text-sidebar"), new("active", "Active", "bi-check-circle"), new("email", "Email/SMS", "bi-envelope-paper"), new("lifecycle", "Lifecycle", "bi-diagram-3"), new("compliance", "Compliance", "bi-shield-check"), new("needsconfig", "Needs Config", "bi-braces"), new("inactive", "Inactive", "bi-pause-circle")];
    private readonly InsightDef[] _baselineInsights = [new("Template readiness", "Campaign templates should stay active, configured, categorized, and aligned to campaign builder workflows.", "bi-activity"), new("Lifecycle coverage", "Renewal, onboarding, nurture, cross-sell, and win-back templates should cover the highest-value client journeys.", "bi-diagram-3"), new("Compliance safety", "Consent, opt-out, legal, brand, and approval language should remain audit-ready before templates are reused.", "bi-shield-check")];
    private List<MarketingConfigItemDto> _items = [];
    private MarketingConfigItemDto? _selected;
    private bool _loading = true;
    private string? _loadError;
    private CancellationTokenSource _cts = new();
    private string _activeTab = "all";
    private string _activeKpi = "all";
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private string _categoryFilter = string.Empty;
    private string _sortMode = "importance";
    private int _page = 1;
    private const int PageSize = 12;
    private Guid? _openActionMenuFor;
    private bool _showForm;
    private bool _saving;
    private string _formError = string.Empty;
    private Guid? _editId;
    private bool _isClone;
    private FormModel _form = new();
    private EditContext _editContext = default!;
    private bool _showConfirm;
    private bool _confirmDanger;
    private string _confirmTitle = string.Empty;
    private string _confirmMessage = string.Empty;
    private string _confirmIcon = "bi-question-circle";
    private Func<Task>? _confirmedAction;
    private readonly List<ToastMessage> _toasts = [];

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Marketing Configuration", null), new("Campaign Templates", null));
        _form = new() { Kind = Kind, ConfigurationJson = "{}", IsActive = true };
        _editContext = new(_form);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();
        try
        {
            await _cts.CancelAsync();
            _cts = new CancellationTokenSource();
            var result = await Api.SearchMarketingConfigItemsAsync(_tenantId, Kind, _searchTerm.Trim(), 1, 500, _cts.Token);
            _items = result?.Items.ToList() ?? [];
            _selected = _selected is null ? _items.OrderByDescending(ImportanceScore).FirstOrDefault() : _items.FirstOrDefault(i => i.MarketingConfigItemId == _selected.MarketingConfigItemId) ?? _items.OrderByDescending(ImportanceScore).FirstOrDefault();
            _page = 1;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _loadError = $"Failed to load campaign templates: {ex.Message}"; ShowToast($"Load failed: {ex.Message}", "cd-toast--danger"); }
        finally { _loading = false; StateHasChanged(); }
    }

    private Task RefreshAsync() => LoadAsync();
    private System.Timers.Timer? _debounce;
    private async Task OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _searchTerm = e.Value?.ToString() ?? string.Empty; _debounce?.Dispose(); _debounce = new System.Timers.Timer(360) { AutoReset = false }; _debounce.Elapsed += async (_, _) => { _debounce?.Dispose(); _debounce = null; await InvokeAsync(LoadAsync); }; _debounce.Start(); await Task.CompletedTask; }
    private void SetActiveKpi(string key) { _activeKpi = _activeKpi == key ? "all" : key; _activeTab = _activeKpi switch { "importance" => "all", "active" => "all", "needsconfig" => "needsconfig", "email" => "email", "lifecycle" => "lifecycle", "compliance" => "compliance", _ => "all" }; _page = 1; }
    private void SetActiveTab(string key) { _activeTab = key; _activeKpi = key is "needsconfig" or "email" or "lifecycle" or "compliance" ? key : "all"; _page = 1; }
    private void SetDashboardFocus(string tab, string sortMode) { _activeTab = tab; _activeKpi = tab is "needsconfig" or "email" or "lifecycle" or "compliance" ? tab : "all"; _sortMode = sortMode; _page = 1; }
    private void ApplyFilters() => _page = 1;
    private void ClearFilters() { _searchTerm = string.Empty; _statusFilter = string.Empty; _categoryFilter = string.Empty; _sortMode = "importance"; _activeTab = "all"; _activeKpi = "all"; _page = 1; _ = LoadAsync(); }
    private bool HasFilters => !string.IsNullOrEmpty(_searchTerm) || !string.IsNullOrEmpty(_statusFilter) || !string.IsNullOrEmpty(_categoryFilter) || _sortMode != "importance" || _activeTab != "all";
    private IEnumerable<MarketingConfigItemDto> TabFiltered => _activeTab switch { "active" => _items.Where(i => i.IsActive), "email" => _items.Where(IsChannelTemplate), "lifecycle" => _items.Where(IsLifecycleTemplate), "compliance" => _items.Where(IsComplianceTemplate), "needsconfig" => _items.Where(NeedsConfiguration), "inactive" => _items.Where(i => !i.IsActive), _ => _items };
    private IEnumerable<MarketingConfigItemDto> FilteredItems { get { var query = TabFiltered; if (_activeKpi == "active") query = query.Where(i => i.IsActive); if (_activeKpi == "importance") query = query.Where(IsHighImportance); if (!string.IsNullOrEmpty(_statusFilter)) query = query.Where(i => string.Equals(_statusFilter, "Active", StringComparison.OrdinalIgnoreCase) ? i.IsActive : !i.IsActive); if (!string.IsNullOrEmpty(_categoryFilter)) query = query.Where(i => string.Equals(Safe(i.Category, "General"), _categoryFilter, StringComparison.OrdinalIgnoreCase)); return _sortMode switch { "name" => query.OrderBy(i => i.Name), "category" => query.OrderBy(i => Safe(i.Category, "General")).ThenBy(i => i.Name), "created" => query.OrderByDescending(i => i.CreatedDateUtc), _ => query.OrderByDescending(ImportanceScore).ThenBy(i => i.SortOrder).ThenBy(i => i.Name) }; } }
    private IEnumerable<MarketingConfigItemDto> PagedItems => FilteredItems.Skip((_page - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredItems.Count() / (double)PageSize));
    private void PreviousPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private string ActiveViewTitle => _tabs.FirstOrDefault(t => t.Key == _activeTab)?.Label ?? "Campaign Templates";
    private int TabCount(string key) => key switch { "active" => _items.Count(i => i.IsActive), "email" => _items.Count(IsChannelTemplate), "lifecycle" => _items.Count(IsLifecycleTemplate), "compliance" => _items.Count(IsComplianceTemplate), "needsconfig" => _items.Count(NeedsConfiguration), "inactive" => _items.Count(i => !i.IsActive), _ => _items.Count };
    private IEnumerable<string> CategoryOptions => _items.Select(i => Safe(i.Category, "General")).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c);
    private void SelectRow(MarketingConfigItemDto item) { _selected = item; _openActionMenuFor = null; }
    private void ToggleActionMenu(MarketingConfigItemDto item) { _selected = item; _openActionMenuFor = _openActionMenuFor == item.MarketingConfigItemId ? null : item.MarketingConfigItemId; }
    private void CloseActionMenu() { if (!_saving) _openActionMenuFor = null; }
    private void OpenCampaignBuilder() => Nav.NavigateTo("/marketing/campaigns/new");
    private void OpenCreate() { _editId = null; _isClone = false; _form = new() { Kind = Kind, Category = _categoryFilter, ConfigurationJson = "{}", IsActive = true }; _editContext = new(_form); _formError = string.Empty; _showForm = true; _openActionMenuFor = null; }
    private void OpenEdit(MarketingConfigItemDto item) { _editId = item.MarketingConfigItemId; _isClone = false; _form = new() { Kind = item.Kind, Code = item.Code, Name = item.Name, Category = item.Category, Description = item.Description, ConfigurationJson = item.ConfigurationJson, SortOrder = item.SortOrder, IsActive = item.IsActive }; _editContext = new(_form); _formError = string.Empty; _showForm = true; _openActionMenuFor = null; }
    private void OpenClone(MarketingConfigItemDto item) { _editId = null; _isClone = true; _form = new() { Kind = item.Kind, Code = $"{item.Code}_COPY", Name = $"{item.Name} (Copy)", Category = item.Category, Description = item.Description, ConfigurationJson = item.ConfigurationJson, SortOrder = item.SortOrder, IsActive = item.IsActive }; _editContext = new(_form); _formError = string.Empty; _showForm = true; _openActionMenuFor = null; }
    private void CloseForm() { if (!_saving) { _showForm = false; _formError = string.Empty; } }
    private async Task SaveAsync() { if (_saving) return; _formError = string.Empty; _saving = true; try { if (_editId.HasValue) { await Api.UpdateMarketingConfigItemAsync(_editId.Value, new(_form.Code.Trim(), _form.Name.Trim(), _form.Category?.Trim(), _form.Description?.Trim(), _form.ConfigurationJson?.Trim(), _form.IsActive, _form.SortOrder)); ShowToast($"Campaign template '{_form.Name}' updated.", "cd-toast--success"); } else { await Api.CreateMarketingConfigItemAsync(new(_tenantId, Kind, _form.Code.Trim(), _form.Name.Trim(), _form.Category?.Trim(), _form.Description?.Trim(), _form.ConfigurationJson?.Trim(), _form.SortOrder)); ShowToast($"Campaign template '{_form.Name}' {(_isClone ? "cloned" : "created") }.", "cd-toast--success"); } _showForm = false; await LoadAsync(); } catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; ShowToast($"Save failed: {ex.Message}", "cd-toast--danger"); } finally { _saving = false; } }
    private void ConfirmToggleActive(MarketingConfigItemDto item) { OpenConfirm(item.IsActive ? "Pause campaign template?" : "Activate campaign template?", $"{(item.IsActive ? "Pause" : "Activate")} {item.Name}?", item.IsActive ? "bi-pause-circle" : "bi-play-circle", item.IsActive, () => ToggleActiveAsync(item)); }
    private async Task ToggleActiveAsync(MarketingConfigItemDto item) { try { await Api.UpdateMarketingConfigItemAsync(item.MarketingConfigItemId, new(item.Code, item.Name, item.Category, item.Description, item.ConfigurationJson, !item.IsActive, item.SortOrder)); CloseConfirm(); ShowToast($"Campaign template '{item.Name}' {(!item.IsActive ? "activated" : "paused") }.", "cd-toast--success"); await LoadAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"Status update failed: {ex.Message}", "cd-toast--danger"); } }
    private void ConfirmDelete(MarketingConfigItemDto item) => OpenConfirm("Delete campaign template?", $"Delete {item.Name}? This cannot be undone.", "bi-trash3", true, () => DeleteAsync(item));
    private async Task DeleteAsync(MarketingConfigItemDto item) { try { await Api.DeleteMarketingConfigItemAsync(item.MarketingConfigItemId); CloseConfirm(); ShowToast($"Campaign template '{item.Name}' deleted.", "cd-toast--success"); await LoadAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"Delete failed: {ex.Message}", "cd-toast--danger"); } }
    private void OpenConfirm(string title, string message, string icon, bool danger, Func<Task> action) { _confirmTitle = title; _confirmMessage = message; _confirmIcon = icon; _confirmDanger = danger; _confirmedAction = action; _showConfirm = true; _openActionMenuFor = null; }
    private void CloseConfirm() { if (!_saving) { _showConfirm = false; _confirmedAction = null; } }
    private async Task ExecuteConfirmedActionAsync() { if (_confirmedAction is null) return; _saving = true; try { await _confirmedAction.Invoke(); } finally { _saving = false; } }
    private Task ExportAsync() { ShowToast("Campaign templates export prepared from the current view.", "cd-toast--success"); return Task.CompletedTask; }
    private void ShowToast(string message, string cssClass) { var toast = new ToastMessage(Guid.NewGuid(), message, cssClass); _toasts.Add(toast); _ = Task.Run(async () => { await Task.Delay(2800); await InvokeAsync(() => DismissToast(toast.Id)); }); }
    private void DismissToast(Guid id) { _toasts.RemoveAll(t => t.Id == id); StateHasChanged(); }
    private static bool HasConfiguration(MarketingConfigItemDto item) => !string.IsNullOrWhiteSpace(item.ConfigurationJson) && item.ConfigurationJson.Trim() != "{}";
    private static bool NeedsConfiguration(MarketingConfigItemDto item) => item.IsActive && !HasConfiguration(item);
    private static bool IsHighImportance(MarketingConfigItemDto item) => ImportanceScore(item) >= 45;
    private static int ImportanceScore(MarketingConfigItemDto item) { var score = 0; if (item.IsActive) score += 18; if (NeedsConfiguration(item)) score += 35; if (HasConfiguration(item)) score += 12; score += 14; if (IsChannelTemplate(item)) score += 16; if (IsLifecycleTemplate(item)) score += 14; if (IsComplianceTemplate(item)) score += 12; if (ContainsAny(item, "campaign", "template", "email", "sms", "subject", "renewal", "cross-sell", "win-back", "consent", "opt-out", "compliance", "audience")) score += 10; if (item.SortOrder <= 10) score += 7; if ((DateTime.UtcNow - item.CreatedDateUtc).TotalDays <= 14) score += 6; return Math.Clamp(score, 0, 100); }
    private static string ImportanceLevel(MarketingConfigItemDto item) => ImportanceScore(item) switch { >= 75 => "Critical", >= 45 => "High", >= 25 => "Medium", _ => "Low" };
    private static string ImportanceTone(MarketingConfigItemDto item) => ImportanceLevel(item) switch { "Critical" => "red", "High" => "amber", "Medium" => "cyan", _ => "green" };
    private IEnumerable<InsightDef> Insights { get { var list = new List<InsightDef>(); var gaps = _items.Count(NeedsConfiguration); if (gaps > 0) list.Add(new("Configuration gaps", $"{gaps} active campaign template(s) need JSON configuration.", "bi-braces")); var lifecycle = _items.Count(IsLifecycleTemplate); if (lifecycle > 0) list.Add(new("Lifecycle coverage", $"{lifecycle} template(s) support renewal, nurture, cross-sell, onboarding, or win-back journeys.", "bi-diagram-3")); var inactive = _items.Count(i => !i.IsActive); if (inactive > 0) list.Add(new("Paused templates", $"{inactive} campaign template(s) are inactive.", "bi-pause-circle")); list.AddRange(_baselineInsights); return list.Take(5); } }
    private static bool IsChannelTemplate(MarketingConfigItemDto item) => ContainsAny(item, "email", "sms", "text", "subject", "preview", "preheader", "channel", "landing", "message", "content");
    private static bool IsLifecycleTemplate(MarketingConfigItemDto item) => ContainsAny(item, "lifecycle", "renewal", "onboarding", "nurture", "cross-sell", "cross sell", "win-back", "winback", "retention", "referral", "review");
    private static bool IsComplianceTemplate(MarketingConfigItemDto item) => ContainsAny(item, "compliance", "consent", "opt-out", "unsubscribe", "legal", "disclaimer", "approval", "brand", "review", "privacy");
    private static bool ContainsAny(MarketingConfigItemDto item, params string[] terms) { var haystack = $"{item.Kind} {item.Code} {item.Name} {item.Category} {item.Description} {item.ConfigurationJson}"; return terms.Any(term => haystack.Contains(term, StringComparison.OrdinalIgnoreCase)); }
    private string KindLabel(string kind) => _kinds.FirstOrDefault(k => k.Kind == kind)?.Label ?? kind;
    private string KindIcon(string kind) => _kinds.FirstOrDefault(k => k.Kind == kind)?.Icon ?? "bi-layout-text-sidebar";
    private static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static string ConfigurationText(MarketingConfigItemDto item) => HasConfiguration(item) ? "Configured" : "Missing";
    private RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string tone) { var cardClass = $"cd-kpi-card cd-kpi-card--{tone} {(_activeKpi == key ? "cd-kpi-card--active" : string.Empty)}"; return @<button type="button" class="@cardClass" title="@subtitle" @onclick="() => SetActiveKpi(key)"><div class="cd-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></div><div class="cd-kpi-body"><span class="cd-kpi-label">@label</span><strong class="cd-kpi-value">@value</strong><span class="cd-kpi-sub">@subtitle</span></div></button>; }
    private RenderFragment WorkflowButton(string title, string description, string icon, System.Action onClick) => @<button type="button" class="cd-workflow" @onclick="onClick"><div class="cd-workflow-icon"><i class="bi @icon" aria-hidden="true"></i></div><div class="cd-workflow-meta"><strong>@title</strong><span>@description</span></div></button>;
    private RenderFragment ImportanceBadge(MarketingConfigItemDto item) { var badgeClass = $"cd-risk-badge cd-risk-badge--{ImportanceTone(item)}"; return @<span class="@badgeClass" title="Template importance score: @ImportanceScore(item)/100"><i class="bi bi-shield-fill" aria-hidden="true"></i> @ImportanceLevel(item)</span>; }
    private RenderFragment StatusBadge(MarketingConfigItemDto item) { var badgeClass = $"cd-pill {(item.IsActive ? "cd-pill--green" : "cd-pill--neutral")}"; var icon = item.IsActive ? "bi-check-circle-fill" : "bi-pause-circle"; var text = item.IsActive ? "Active" : "Inactive"; return @<span class="@badgeClass"><i class="bi @icon" aria-hidden="true"></i>@text</span>; }
    private RenderFragment ConfigurationBadge(MarketingConfigItemDto item) { var badgeClass = $"cd-pill {(HasConfiguration(item) ? "cd-pill--purple" : "cd-pill--amber")}"; var icon = HasConfiguration(item) ? "bi-code-slash" : "bi-braces"; return @<span class="@badgeClass"><i class="bi @icon" aria-hidden="true"></i>@ConfigurationText(item)</span>; }
    private sealed class FormModel { [Required(ErrorMessage = "Kind is required.")][StringLength(80)] public string Kind { get; set; } = string.Empty; [Required(ErrorMessage = "Code is required.")][StringLength(80)] public string Code { get; set; } = string.Empty; [Required(ErrorMessage = "Name is required.")][StringLength(200)] public string Name { get; set; } = string.Empty; [StringLength(120)] public string? Category { get; set; } [StringLength(500)] public string? Description { get; set; } [StringLength(4000)] public string? ConfigurationJson { get; set; } [Range(0, 9999)] public int SortOrder { get; set; } public bool IsActive { get; set; } = true; }
    private sealed record KindDef(string Kind, string Label, string Category, string Icon, string Url);
    private sealed record TabDef(string Key, string Label, string Icon);
    private sealed record InsightDef(string Title, string Description, string Icon);
    private sealed record ToastMessage(Guid Id, string Message, string CssClass);
}
