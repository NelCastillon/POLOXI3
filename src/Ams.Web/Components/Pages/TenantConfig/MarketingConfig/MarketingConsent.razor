@page "/tenant/marketing/consent"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.MarketingConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Marketing Consent Command Center - AMS</PageTitle>

<div class="cd-page" @onclick="CloseActionMenu">
    <section class="cd-hero">
        <div class="cd-hero__content">
            <div class="cd-hero-left">
                <span class="cd-hero-icon"><i class="bi bi-toggle-on" aria-hidden="true"></i></span>
                <div class="cd-hero-title">
                    <div class="cd-hero__eyebrow">Enterprise marketing consent command center</div>
                    <div class="cd-title-row">
                        <h1>Marketing Consent</h1>
                        <div class="cd-hero__meta">
                            <span><i class="bi bi-layers" aria-hidden="true"></i>@_items.Count rules</span>
                            <span><i class="bi bi-check-circle" aria-hidden="true"></i>@_items.Count(i => i.IsActive) active</span>
                            <span><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>@_items.Count(IsHighImportance) high importance</span>
                            <span><i class="bi bi-code-slash" aria-hidden="true"></i>@_items.Count(HasConfiguration) configured</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Govern marketing consent, subscription preferences, opt-in capture, opt-out suppression, channel permissions, privacy guardrails, regulatory compliance, and audit-ready consent workflow configuration.</p>
        </div>
        <div class="cd-hero__actions">
            <button type="button" class="cd-btn cd-btn--light" @onclick="RefreshAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "cd-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="cd-btn cd-btn--light" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="cd-btn cd-btn--light" @onclick="OpenCommunicationsConsent"><i class="bi bi-toggle-on" aria-hidden="true"></i> Consent Settings</button>
            <button type="button" class="cd-btn cd-btn--primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Consent Rule</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger cd-alert" style="border-left: 4px solid #dc3545; animation: cd-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="cd-kpi-strip" aria-label="Marketing consent KPIs">
        @KpiCard("all", "Rules", _items.Count.ToString(), "All marketing consent rules", "bi-toggle-on", "blue")
        @KpiCard("active", "Active", _items.Count(i => i.IsActive).ToString(), "Consent rules currently enabled for marketing workflows", "bi-check-circle", "green")
        @KpiCard("importance", "Important", _items.Count(IsHighImportance).ToString(), "High-impact consent and compliance controls", "bi-exclamation-octagon", "red")
        @KpiCard("needsconfig", "Needs Config", _items.Count(NeedsConfiguration).ToString(), "Active consent rules missing JSON configuration", "bi-braces", "amber")
        @KpiCard("optin", "Opt-In", _items.Count(IsOptInRule).ToString(), "Permission capture, subscription, preference, and double opt-in rules", "bi-person-check", "purple")
        @KpiCard("optout", "Opt-Out", _items.Count(IsOptOutRule).ToString(), "Unsubscribe, suppression, do-not-contact, and preference revocation rules", "bi-person-dash", "cyan")
        @KpiCard("guardrail", "Guardrails", _items.Count(IsGuardrailRule).ToString(), "Eligibility, suppression, consent, exclusion, and compliance guardrails", "bi-shield-check", "blue")
    </section>

    <section class="cd-workflows" aria-label="Marketing consent shortcuts">
        @WorkflowButton("Consent health", "Prioritize active high-impact consent rules", "bi-activity", () => SetDashboardFocus("active", "importance"))
        @WorkflowButton("Configuration gaps", "Find active consent rules missing JSON", "bi-shield-exclamation", () => SetDashboardFocus("needsconfig", "importance"))
        @WorkflowButton("Opt-in readiness", "Review permission capture, subscription, preference, and double opt-in rules", "bi-person-check", () => SetDashboardFocus("optin", "importance"))
        @WorkflowButton("Opt-out safety", "Review unsubscribe, suppression, do-not-contact, and revocation rules", "bi-person-dash", () => SetDashboardFocus("optout", "importance"))
        @WorkflowButton("Guardrails", "Review eligibility, suppression, consent, exclusion, and compliance controls", "bi-shield-check", () => SetDashboardFocus("guardrail", "name"))
    </section>

    <section class="cd-filter-panel" aria-label="Marketing consent filters">
        <div class="cd-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" placeholder="Search code, name, category, consent, opt-in, opt-out, subscription, unsubscribe, suppression, DNC, privacy, compliance, channel, or configuration..." aria-label="Search marketing consent rules" value="@_searchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="cd-filter-grid">
            <label><span>Status</span><select class="form-select" @bind="_statusFilter" @bind:after="ApplyFilters"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option></select></label>
            <label><span>Category</span><select class="form-select" @bind="_categoryFilter" @bind:after="ApplyFilters"><option value="">All categories</option>@foreach (var category in CategoryOptions) { <option value="@category">@category</option> }</select></label>
            <label><span>Sort</span><select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters"><option value="importance">Importance</option><option value="name">Name</option><option value="category">Category</option><option value="created">Newest</option></select></label>
        </div>
        <button type="button" class="cd-btn cd-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
    </section>

    <nav class="cd-tabs" aria-label="Marketing consent views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="cd-tab @(_activeTab == tab.Key ? "cd-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i><span>@tab.Label</span><strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </nav>

    <main class="cd-dashboard">
        <section class="cd-main-card">
            <div class="cd-card-header">
                <div><span class="cd-section-kicker">@ActiveViewTitle</span><h2>@FilteredItems.Count() rules</h2><p>Ranked by enterprise importance: active consent impact, opt-in readiness, opt-out suppression safety, channel permission coverage, privacy/compliance guardrails, missing configuration, execution order, and recency.</p></div>
                <div class="cd-card-actions">
                    <button type="button" class="cd-btn cd-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="cd-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="cd-btn cd-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="cd-loading"><span class="cd-spinner"></span> Loading marketing consent rules...</div>
            }
            else if (!FilteredItems.Any())
            {
                <div class="cd-empty"><i class="bi bi-toggle-on" aria-hidden="true"></i><strong>No marketing consent rules found</strong><span>Adjust the active tab, KPI, search, or filters.</span></div>
            }
            else
            {
                <div class="cd-table-wrap">
                    <table class="cd-table" aria-label="Marketing consent rules">
                        <thead><tr><th>Importance</th><th>Consent Rule</th><th>Category</th><th>Status</th><th>Configuration</th><th>Order</th><th class="cd-actions-col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var item in PagedItems)
                            {
                                <tr class="@(_selected?.MarketingConfigItemId == item.MarketingConfigItemId ? "cd-row cd-row--selected" : "cd-row")" @onclick="() => SelectRow(item)">
                                    <td>@ImportanceBadge(item)</td>
                                    <td><div class="cd-rule-cell"><div class="cd-rule-icon"><i class="bi @KindIcon(item.Kind)" aria-hidden="true"></i></div><div class="cd-rule-meta"><button type="button" class="cd-link-button" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)">@item.Name</button><small>@item.Code</small></div></div></td>
                                    <td><span class="cd-pill cd-pill--blue">@Safe(item.Category, "General")</span></td>
                                    <td>@StatusBadge(item)</td>
                                    <td>@ConfigurationBadge(item)</td>
                                    <td><span class="cd-count-pill">@item.SortOrder</span></td>
                                    <td class="cd-actions-col"><button type="button" class="cd-icon-btn" title="Open action menu" @onclick:stopPropagation="true" @onclick="() => ToggleActionMenu(item)"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>@if (_openActionMenuFor == item.MarketingConfigItemId) { <div class="cd-menu" role="menu" @onclick:stopPropagation="true"><div class="cd-menu__summary"><strong>@item.Name</strong><span>Marketing Consent</span></div><button type="button" class="cd-menu-item" role="menuitem" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i><span>Edit rule</span></button><button type="button" class="cd-menu-item" role="menuitem" @onclick="() => OpenClone(item)"><i class="bi bi-copy" aria-hidden="true"></i><span>Clone rule</span></button><button type="button" class="cd-menu-item" role="menuitem" @onclick="() => OpenCommunicationsConsent()"><i class="bi bi-toggle-on" aria-hidden="true"></i><span>Open consent settings</span></button><button type="button" class="cd-menu-item" role="menuitem" @onclick="() => ConfirmToggleActive(item)"><i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i><span>@(item.IsActive ? "Pause" : "Activate")</span></button><button type="button" class="cd-menu-item cd-menu-item--danger" role="menuitem" @onclick="() => ConfirmDelete(item)"><i class="bi bi-trash3" aria-hidden="true"></i><span>Delete rule</span></button></div> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="cd-side-panel">
            <section class="cd-panel-card">
                <span class="cd-section-kicker">Selected consent rule</span>
                @if (_selected is null)
                {
                    <div class="cd-empty cd-empty--compact"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a rule</strong><span>Choose a marketing consent rule to inspect compliance importance and actions.</span></div>
                }
                else
                {
                    <div class="cd-selected"><div class="cd-selected__title"><div class="cd-rule-icon cd-rule-icon--lg"><i class="bi @KindIcon(_selected.Kind)"></i></div><div><h3>@_selected.Name</h3><span>@_selected.Code</span></div></div><div class="cd-score-card cd-score-card--@ImportanceTone(_selected)"><span>Consent importance score</span><strong>@ImportanceScore(_selected)</strong><small>@ImportanceLevel(_selected)</small></div><dl class="cd-detail-list"><div><dt>Category</dt><dd>@Safe(_selected.Category, "General")</dd></div><div><dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd></div><div><dt>Configuration</dt><dd>@ConfigurationText(_selected)</dd></div><div><dt>Created</dt><dd>@_selected.CreatedDateUtc.ToString("MMM d, yyyy")</dd></div></dl>@if (!string.IsNullOrWhiteSpace(_selected.Description)) { <p class="cd-selected-desc">@_selected.Description</p> }<div class="cd-selected-actions"><button type="button" class="cd-btn cd-btn--primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="cd-btn cd-btn--ghost" @onclick="() => OpenClone(_selected)"><i class="bi bi-copy" aria-hidden="true"></i> Clone</button><button type="button" class="cd-btn cd-btn--ghost" @onclick="OpenCommunicationsConsent"><i class="bi bi-toggle-on" aria-hidden="true"></i> Consent</button></div></div>
                }
            </section>
            <section class="cd-panel-card"><span class="cd-section-kicker">Consent intelligence</span><div class="cd-insight-list">@foreach (var insight in Insights) { <div class="cd-insight"><i class="bi @insight.Icon" aria-hidden="true"></i><div><strong>@insight.Title</strong><span>@insight.Description</span></div></div> }</div></section>
        </aside>
    </main>
</div>

@if (_showForm)
{
    <div class="cd-modal-backdrop" role="presentation" @onclick="CloseForm"><div class="cd-modal" role="dialog" aria-modal="true" aria-labelledby="cd-form-title" @onclick:stopPropagation="true"><div class="cd-modal__header"><i class="bi @(_editId.HasValue ? "bi-pencil-square" : "bi-plus-circle")" aria-hidden="true"></i><span id="cd-form-title">@(_editId.HasValue ? "Edit Consent Rule" : _isClone ? "Clone Consent Rule" : "Add Consent Rule")</span><button type="button" class="cd-icon-btn cd-icon-btn--light ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div><EditForm EditContext="@_editContext" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="cd-modal__body"><div class="cd-validation-note"><i class="bi bi-shield-check" aria-hidden="true"></i><div><strong>Enterprise marketing consent validations enabled</strong><span>Required code/name, JSON length, category metadata, and sort order checks are enforced before save.</span></div></div><div class="cd-form-grid"><label class="cd-field"><span>Code <em>*</em></span><InputText @bind-Value="_form.Code" class="form-control" /><ValidationMessage For="() => _form.Code" class="text-danger" /></label><label class="cd-field"><span>Name <em>*</em></span><InputText @bind-Value="_form.Name" class="form-control" /><ValidationMessage For="() => _form.Name" class="text-danger" /></label><label class="cd-field"><span>Category</span><InputText @bind-Value="_form.Category" class="form-control" /><ValidationMessage For="() => _form.Category" class="text-danger" /></label><label class="cd-field"><span>Sort Order</span><InputNumber @bind-Value="_form.SortOrder" class="form-control" /><ValidationMessage For="() => _form.SortOrder" class="text-danger" /></label><label class="cd-field cd-field--full"><span>Description</span><InputTextArea @bind-Value="_form.Description" class="form-control" rows="3" /><ValidationMessage For="() => _form.Description" class="text-danger" /></label><label class="cd-field cd-field--full"><span>Configuration JSON</span><InputTextArea @bind-Value="_form.ConfigurationJson" class="form-control cd-json" rows="6" /><ValidationMessage For="() => _form.ConfigurationJson" class="text-danger" /></label><label class="cd-check-row"><InputCheckbox @bind-Value="_form.IsActive" /><span>Active</span></label></div>@if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger cd-form-alert" style="border-left: 4px solid #dc3545; animation: cd-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> @_formError</div> }</div><div class="cd-modal__footer"><button type="button" class="cd-btn cd-btn--ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="cd-btn cd-btn--primary" disabled="@_saving">@if (_saving) { <span class="cd-spin-sm" aria-hidden="true"></span> } @(_editId.HasValue ? "Save Changes" : _isClone ? "Clone Rule" : "Create Rule")</button></div></EditForm></div></div>
}

@if (_showConfirm)
{
    <div class="cd-modal-backdrop" role="presentation" @onclick="CloseConfirm"><div class="cd-confirm" role="dialog" aria-modal="true" aria-labelledby="cd-confirm-title" @onclick:stopPropagation="true"><div class="cd-modal__header"><i class="bi @_confirmIcon" aria-hidden="true"></i><span>Confirm action</span><button type="button" class="cd-icon-btn cd-icon-btn--light ms-auto" @onclick="CloseConfirm" disabled="@_saving"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div><div class="cd-confirm__body"><div class="@(_confirmDanger ? "cd-confirm-icon cd-confirm-icon--danger" : "cd-confirm-icon")"><i class="bi @_confirmIcon" aria-hidden="true"></i></div><div><h3 id="cd-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div></div><div class="cd-modal__footer"><button type="button" class="cd-btn cd-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button><button type="button" class="@(_confirmDanger ? "cd-btn cd-btn--danger" : "cd-btn cd-btn--primary")" @onclick="ExecuteConfirmedActionAsync" disabled="@_saving">@if (_saving) { <span class="cd-spin-sm" aria-hidden="true"></span> } Confirm</button></div></div></div>
}

<div class="cd-toast-stack" aria-live="polite" aria-atomic="true">@foreach (var toast in _toasts) { <div class="cd-toast @toast.CssClass"><i class="bi @(toast.CssClass.Contains("danger") ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)"><i class="bi bi-x" aria-hidden="true"></i></button></div> }</div>

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private const string Kind = "MarketingConsent";
    private readonly KindDef[] _kinds = [new("MarketingConsent", "Marketing Consent", "Consent", "bi-toggle-on", "/tenant/marketing/consent")];
    private readonly TabDef[] _tabs = [new("all", "All", "bi-toggle-on"), new("active", "Active", "bi-check-circle"), new("optin", "Opt-In", "bi-person-check"), new("optout", "Opt-Out", "bi-person-dash"), new("guardrail", "Guardrails", "bi-shield-check"), new("needsconfig", "Needs Config", "bi-braces"), new("inactive", "Inactive", "bi-pause-circle")];
    private readonly InsightDef[] _baselineInsights = [new("Consent readiness", "Marketing consent rules should stay active, configured, prioritized, and aligned to subscription and permission workflows.", "bi-activity"), new("Permission coverage", "Opt-in, subscription, channel permission, and preference rules should capture valid consent before outreach runs.", "bi-person-check"), new("Compliance safety", "Opt-out, suppression, privacy, regulatory, and audit controls should remain reliable across marketing channels.", "bi-shield-check")];
    private List<MarketingConfigItemDto> _items = [];
    private MarketingConfigItemDto? _selected;
    private bool _loading = true;
    private string? _loadError;
    private CancellationTokenSource _cts = new();
    private string _activeTab = "all";
    private string _activeKpi = "all";
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private string _categoryFilter = string.Empty;
    private string _sortMode = "importance";
    private int _page = 1;
    private const int PageSize = 12;
    private Guid? _openActionMenuFor;
    private bool _showForm;
    private bool _saving;
    private string _formError = string.Empty;
    private Guid? _editId;
    private bool _isClone;
    private FormModel _form = new();
    private EditContext _editContext = default!;
    private bool _showConfirm;
    private bool _confirmDanger;
    private string _confirmTitle = string.Empty;
    private string _confirmMessage = string.Empty;
    private string _confirmIcon = "bi-question-circle";
    private Func<Task>? _confirmedAction;
    private readonly List<ToastMessage> _toasts = [];

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Marketing Configuration", null), new("Marketing Consent", null));
        _form = new() { Kind = Kind, ConfigurationJson = "{}", IsActive = true };
        _editContext = new(_form);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();
        try
        {
            await _cts.CancelAsync();
            _cts = new CancellationTokenSource();
            var result = await Api.SearchMarketingConfigItemsAsync(_tenantId, Kind, _searchTerm.Trim(), 1, 500, _cts.Token);
            _items = result?.Items.ToList() ?? [];
            _selected = _selected is null ? _items.OrderByDescending(ImportanceScore).FirstOrDefault() : _items.FirstOrDefault(i => i.MarketingConfigItemId == _selected.MarketingConfigItemId) ?? _items.OrderByDescending(ImportanceScore).FirstOrDefault();
            _page = 1;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _loadError = $"Failed to load marketing consent rules: {ex.Message}"; ShowToast($"Load failed: {ex.Message}", "cd-toast--danger"); }
        finally { _loading = false; StateHasChanged(); }
    }

    private Task RefreshAsync() => LoadAsync();
    private System.Timers.Timer? _debounce;
    private async Task OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _searchTerm = e.Value?.ToString() ?? string.Empty; _debounce?.Dispose(); _debounce = new System.Timers.Timer(360) { AutoReset = false }; _debounce.Elapsed += async (_, _) => { _debounce?.Dispose(); _debounce = null; await InvokeAsync(LoadAsync); }; _debounce.Start(); await Task.CompletedTask; }
    private void SetActiveKpi(string key) { _activeKpi = _activeKpi == key ? "all" : key; _activeTab = _activeKpi switch { "importance" => "all", "active" => "all", "needsconfig" => "needsconfig", "optin" => "optin", "optout" => "optout", "guardrail" => "guardrail", _ => "all" }; _page = 1; }
    private void SetActiveTab(string key) { _activeTab = key; _activeKpi = key is "needsconfig" or "optin" or "optout" or "guardrail" ? key : "all"; _page = 1; }
    private void SetDashboardFocus(string tab, string sortMode) { _activeTab = tab; _activeKpi = tab is "needsconfig" or "optin" or "optout" or "guardrail" ? tab : "all"; _sortMode = sortMode; _page = 1; }
    private void ApplyFilters() => _page = 1;
    private void ClearFilters() { _searchTerm = string.Empty; _statusFilter = string.Empty; _categoryFilter = string.Empty; _sortMode = "importance"; _activeTab = "all"; _activeKpi = "all"; _page = 1; _ = LoadAsync(); }
    private bool HasFilters => !string.IsNullOrEmpty(_searchTerm) || !string.IsNullOrEmpty(_statusFilter) || !string.IsNullOrEmpty(_categoryFilter) || _sortMode != "importance" || _activeTab != "all";
    private IEnumerable<MarketingConfigItemDto> TabFiltered => _activeTab switch { "active" => _items.Where(i => i.IsActive), "optin" => _items.Where(IsOptInRule), "optout" => _items.Where(IsOptOutRule), "guardrail" => _items.Where(IsGuardrailRule), "needsconfig" => _items.Where(NeedsConfiguration), "inactive" => _items.Where(i => !i.IsActive), _ => _items };
    private IEnumerable<MarketingConfigItemDto> FilteredItems { get { var query = TabFiltered; if (_activeKpi == "active") query = query.Where(i => i.IsActive); if (_activeKpi == "importance") query = query.Where(IsHighImportance); if (!string.IsNullOrEmpty(_statusFilter)) query = query.Where(i => string.Equals(_statusFilter, "Active", StringComparison.OrdinalIgnoreCase) ? i.IsActive : !i.IsActive); if (!string.IsNullOrEmpty(_categoryFilter)) query = query.Where(i => string.Equals(Safe(i.Category, "General"), _categoryFilter, StringComparison.OrdinalIgnoreCase)); return _sortMode switch { "name" => query.OrderBy(i => i.Name), "category" => query.OrderBy(i => Safe(i.Category, "General")).ThenBy(i => i.Name), "created" => query.OrderByDescending(i => i.CreatedDateUtc), _ => query.OrderByDescending(ImportanceScore).ThenBy(i => i.SortOrder).ThenBy(i => i.Name) }; } }
    private IEnumerable<MarketingConfigItemDto> PagedItems => FilteredItems.Skip((_page - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredItems.Count() / (double)PageSize));
    private void PreviousPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private string ActiveViewTitle => _tabs.FirstOrDefault(t => t.Key == _activeTab)?.Label ?? "Marketing Consent";
    private int TabCount(string key) => key switch { "active" => _items.Count(i => i.IsActive), "optin" => _items.Count(IsOptInRule), "optout" => _items.Count(IsOptOutRule), "guardrail" => _items.Count(IsGuardrailRule), "needsconfig" => _items.Count(NeedsConfiguration), "inactive" => _items.Count(i => !i.IsActive), _ => _items.Count };
    private IEnumerable<string> CategoryOptions => _items.Select(i => Safe(i.Category, "General")).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c);
    private void SelectRow(MarketingConfigItemDto item) { _selected = item; _openActionMenuFor = null; }
    private void ToggleActionMenu(MarketingConfigItemDto item) { _selected = item; _openActionMenuFor = _openActionMenuFor == item.MarketingConfigItemId ? null : item.MarketingConfigItemId; }
    private void CloseActionMenu() { if (!_saving) _openActionMenuFor = null; }
    private void OpenCommunicationsConsent() => Nav.NavigateTo("/tenant/communications/consent");
    private void OpenCreate() { _editId = null; _isClone = false; _form = new() { Kind = Kind, Category = _categoryFilter, ConfigurationJson = "{}", IsActive = true }; _editContext = new(_form); _formError = string.Empty; _showForm = true; _openActionMenuFor = null; }
    private void OpenEdit(MarketingConfigItemDto item) { _editId = item.MarketingConfigItemId; _isClone = false; _form = new() { Kind = item.Kind, Code = item.Code, Name = item.Name, Category = item.Category, Description = item.Description, ConfigurationJson = item.ConfigurationJson, SortOrder = item.SortOrder, IsActive = item.IsActive }; _editContext = new(_form); _formError = string.Empty; _showForm = true; _openActionMenuFor = null; }
    private void OpenClone(MarketingConfigItemDto item) { _editId = null; _isClone = true; _form = new() { Kind = item.Kind, Code = $"{item.Code}_COPY", Name = $"{item.Name} (Copy)", Category = item.Category, Description = item.Description, ConfigurationJson = item.ConfigurationJson, SortOrder = item.SortOrder, IsActive = item.IsActive }; _editContext = new(_form); _formError = string.Empty; _showForm = true; _openActionMenuFor = null; }
    private void CloseForm() { if (!_saving) { _showForm = false; _formError = string.Empty; } }
    private async Task SaveAsync() { if (_saving) return; _formError = string.Empty; _saving = true; try { if (_editId.HasValue) { await Api.UpdateMarketingConfigItemAsync(_editId.Value, new(_form.Code.Trim(), _form.Name.Trim(), _form.Category?.Trim(), _form.Description?.Trim(), _form.ConfigurationJson?.Trim(), _form.IsActive, _form.SortOrder)); ShowToast($"Consent rule '{_form.Name}' updated.", "cd-toast--success"); } else { await Api.CreateMarketingConfigItemAsync(new(_tenantId, Kind, _form.Code.Trim(), _form.Name.Trim(), _form.Category?.Trim(), _form.Description?.Trim(), _form.ConfigurationJson?.Trim(), _form.SortOrder)); ShowToast($"Consent rule '{_form.Name}' {(_isClone ? "cloned" : "created") }.", "cd-toast--success"); } _showForm = false; await LoadAsync(); } catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; ShowToast($"Save failed: {ex.Message}", "cd-toast--danger"); } finally { _saving = false; } }
    private void ConfirmToggleActive(MarketingConfigItemDto item) { OpenConfirm(item.IsActive ? "Pause consent rule?" : "Activate consent rule?", $"{(item.IsActive ? "Pause" : "Activate")} {item.Name}?", item.IsActive ? "bi-pause-circle" : "bi-play-circle", item.IsActive, () => ToggleActiveAsync(item)); }
    private async Task ToggleActiveAsync(MarketingConfigItemDto item) { try { await Api.UpdateMarketingConfigItemAsync(item.MarketingConfigItemId, new(item.Code, item.Name, item.Category, item.Description, item.ConfigurationJson, !item.IsActive, item.SortOrder)); CloseConfirm(); ShowToast($"Consent rule '{item.Name}' {(!item.IsActive ? "activated" : "paused") }.", "cd-toast--success"); await LoadAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"Status update failed: {ex.Message}", "cd-toast--danger"); } }
    private void ConfirmDelete(MarketingConfigItemDto item) => OpenConfirm("Delete consent rule?", $"Delete {item.Name}? This cannot be undone.", "bi-trash3", true, () => DeleteAsync(item));
    private async Task DeleteAsync(MarketingConfigItemDto item) { try { await Api.DeleteMarketingConfigItemAsync(item.MarketingConfigItemId); CloseConfirm(); ShowToast($"Consent rule '{item.Name}' deleted.", "cd-toast--success"); await LoadAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"Delete failed: {ex.Message}", "cd-toast--danger"); } }
    private void OpenConfirm(string title, string message, string icon, bool danger, Func<Task> action) { _confirmTitle = title; _confirmMessage = message; _confirmIcon = icon; _confirmDanger = danger; _confirmedAction = action; _showConfirm = true; _openActionMenuFor = null; }
    private void CloseConfirm() { if (!_saving) { _showConfirm = false; _confirmedAction = null; } }
    private async Task ExecuteConfirmedActionAsync() { if (_confirmedAction is null) return; _saving = true; try { await _confirmedAction.Invoke(); } finally { _saving = false; } }
    private Task ExportAsync() { ShowToast("Marketing consent rules export prepared from the current view.", "cd-toast--success"); return Task.CompletedTask; }
    private void ShowToast(string message, string cssClass) { var toast = new ToastMessage(Guid.NewGuid(), message, cssClass); _toasts.Add(toast); _ = Task.Run(async () => { await Task.Delay(2800); await InvokeAsync(() => DismissToast(toast.Id)); }); }
    private void DismissToast(Guid id) { _toasts.RemoveAll(t => t.Id == id); StateHasChanged(); }
    private static bool HasConfiguration(MarketingConfigItemDto item) => !string.IsNullOrWhiteSpace(item.ConfigurationJson) && item.ConfigurationJson.Trim() != "{}";
    private static bool NeedsConfiguration(MarketingConfigItemDto item) => item.IsActive && !HasConfiguration(item);
    private static bool IsHighImportance(MarketingConfigItemDto item) => ImportanceScore(item) >= 45;
    private static int ImportanceScore(MarketingConfigItemDto item) { var score = 0; if (item.IsActive) score += 18; if (NeedsConfiguration(item)) score += 35; if (HasConfiguration(item)) score += 12; score += 14; if (IsOptInRule(item)) score += 16; if (IsOptOutRule(item)) score += 16; if (IsGuardrailRule(item)) score += 14; if (ContainsAny(item, "consent", "opt-in", "opt in", "opt-out", "opt out", "unsubscribe", "subscription", "preference", "permission", "privacy", "compliance", "suppression", "dnc")) score += 10; if (item.SortOrder <= 10) score += 7; if ((DateTime.UtcNow - item.CreatedDateUtc).TotalDays <= 14) score += 6; return Math.Clamp(score, 0, 100); }
    private static string ImportanceLevel(MarketingConfigItemDto item) => ImportanceScore(item) switch { >= 75 => "Critical", >= 45 => "High", >= 25 => "Medium", _ => "Low" };
    private static string ImportanceTone(MarketingConfigItemDto item) => ImportanceLevel(item) switch { "Critical" => "red", "High" => "amber", "Medium" => "cyan", _ => "green" };
    private IEnumerable<InsightDef> Insights { get { var list = new List<InsightDef>(); var gaps = _items.Count(NeedsConfiguration); if (gaps > 0) list.Add(new("Configuration gaps", $"{gaps} active marketing consent rule(s) need JSON configuration.", "bi-braces")); var optOut = _items.Count(IsOptOutRule); if (optOut > 0) list.Add(new("Suppression coverage", $"{optOut} rule(s) influence unsubscribe, opt-out, do-not-contact, or suppression safety.", "bi-person-dash")); var inactive = _items.Count(i => !i.IsActive); if (inactive > 0) list.Add(new("Paused rules", $"{inactive} consent rule(s) are inactive.", "bi-pause-circle")); list.AddRange(_baselineInsights); return list.Take(5); } }
    private static bool IsOptInRule(MarketingConfigItemDto item) => ContainsAny(item, "opt-in", "opt in", "subscribe", "subscription", "preference", "permission", "double opt", "capture", "consent granted", "channel permission", "sms consent", "email consent");
    private static bool IsOptOutRule(MarketingConfigItemDto item) => ContainsAny(item, "opt-out", "opt out", "unsubscribe", "suppression", "suppress", "do not contact", "dnc", "revocation", "revoke", "deny", "withdraw", "blocked");
    private static bool IsGuardrailRule(MarketingConfigItemDto item) => ContainsAny(item, "eligibility", "eligible", "privacy", "compliance", "regulatory", "audit", "consent", "consent date", "timestamp", "source", "proof", "tcpA", "can-spam", "gdpr", "ccpa");
    private static bool ContainsAny(MarketingConfigItemDto item, params string[] terms) { var haystack = $"{item.Kind} {item.Code} {item.Name} {item.Category} {item.Description} {item.ConfigurationJson}"; return terms.Any(term => haystack.Contains(term, StringComparison.OrdinalIgnoreCase)); }
    private string KindLabel(string kind) => _kinds.FirstOrDefault(k => k.Kind == kind)?.Label ?? kind;
    private string KindIcon(string kind) => _kinds.FirstOrDefault(k => k.Kind == kind)?.Icon ?? "bi-toggle-on";
    private static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static string ConfigurationText(MarketingConfigItemDto item) => HasConfiguration(item) ? "Configured" : "Missing";
    private RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string tone) { var cardClass = $"cd-kpi-card cd-kpi-card--{tone} {(_activeKpi == key ? "cd-kpi-card--active" : string.Empty)}"; return @<button type="button" class="@cardClass" title="@subtitle" @onclick="() => SetActiveKpi(key)"><div class="cd-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></div><div class="cd-kpi-body"><span class="cd-kpi-label">@label</span><strong class="cd-kpi-value">@value</strong><span class="cd-kpi-sub">@subtitle</span></div></button>; }
    private RenderFragment WorkflowButton(string title, string description, string icon, System.Action onClick) => @<button type="button" class="cd-workflow" @onclick="onClick"><div class="cd-workflow-icon"><i class="bi @icon" aria-hidden="true"></i></div><div class="cd-workflow-meta"><strong>@title</strong><span>@description</span></div></button>;
    private RenderFragment ImportanceBadge(MarketingConfigItemDto item) { var badgeClass = $"cd-risk-badge cd-risk-badge--{ImportanceTone(item)}"; return @<span class="@badgeClass" title="Marketing consent importance score: @ImportanceScore(item)/100"><i class="bi bi-shield-fill" aria-hidden="true"></i> @ImportanceLevel(item)</span>; }
    private RenderFragment StatusBadge(MarketingConfigItemDto item) { var badgeClass = $"cd-pill {(item.IsActive ? "cd-pill--green" : "cd-pill--neutral")}"; var icon = item.IsActive ? "bi-check-circle-fill" : "bi-pause-circle"; var text = item.IsActive ? "Active" : "Inactive"; return @<span class="@badgeClass"><i class="bi @icon" aria-hidden="true"></i>@text</span>; }
    private RenderFragment ConfigurationBadge(MarketingConfigItemDto item) { var badgeClass = $"cd-pill {(HasConfiguration(item) ? "cd-pill--purple" : "cd-pill--amber")}"; var icon = HasConfiguration(item) ? "bi-code-slash" : "bi-braces"; return @<span class="@badgeClass"><i class="bi @icon" aria-hidden="true"></i>@ConfigurationText(item)</span>; }
    private sealed class FormModel { [Required(ErrorMessage = "Kind is required.")][StringLength(80)] public string Kind { get; set; } = string.Empty; [Required(ErrorMessage = "Code is required.")][StringLength(80)] public string Code { get; set; } = string.Empty; [Required(ErrorMessage = "Name is required.")][StringLength(200)] public string Name { get; set; } = string.Empty; [StringLength(120)] public string? Category { get; set; } [StringLength(500)] public string? Description { get; set; } [StringLength(4000)] public string? ConfigurationJson { get; set; } [Range(0, 9999)] public int SortOrder { get; set; } public bool IsActive { get; set; } = true; }
    private sealed record KindDef(string Kind, string Label, string Category, string Icon, string Url);
    private sealed record TabDef(string Key, string Label, string Icon);
    private sealed record InsightDef(string Title, string Description, string Icon);
    private sealed record ToastMessage(Guid Id, string Message, string CssClass);
}

