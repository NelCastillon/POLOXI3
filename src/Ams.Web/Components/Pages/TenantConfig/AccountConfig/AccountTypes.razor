@page "/tenant/accounts/types"
@using System.ComponentModel.DataAnnotations
@using ChangeEventArgs = Microsoft.AspNetCore.Components.ChangeEventArgs
@using Action = System.Action
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Account Type Command Center - Account Configuration</PageTitle>

<div class="aty-page">
    <section class="aty-hero">
        <div class="aty-hero__content">
            <div class="aty-hero-left">
                <span class="aty-hero-icon"><i class="bi bi-building" aria-hidden="true"></i></span>
                <div class="aty-hero-title">
                    <div class="aty-hero__eyebrow">Enterprise account configuration</div>
                    <div class="aty-title-row">
                        <h1>Account Type Command Center</h1>
                        <div class="aty-hero__meta">
                            <span><i class="bi bi-diagram-3" aria-hidden="true"></i>@_items.Count types</span>
                            <span><i class="bi bi-star-fill" aria-hidden="true"></i>@_items.Count(x => x.IsDefault) default</span>
                            <span><i class="bi bi-check-circle" aria-hidden="true"></i>@_items.Count(x => x.IsActive) active</span>
                            <span><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>@_items.Count(IsHighImportance) high importance</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Classify account records, govern defaults, and keep personal, commercial, and government account workflows aligned.</p>
        </div>
        <div class="aty-hero__actions">
            <button type="button" class="aty-btn aty-btn--light" @onclick="RefreshAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "aty-spin" : null)" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="aty-btn aty-btn--primary" @onclick="OpenCreate">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Type
            </button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger aty-alert" style="border-left: 4px solid #dc3545; animation: aty-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="aty-kpi-strip" aria-label="Account type KPIs">
        @KpiCard("all", "Total Types", _items.Count.ToString(), "All configured account classifications", "bi-diagram-3", "blue")
        @KpiCard("active", "Active", _items.Count(x => x.IsActive).ToString(), "Types available for operational workflows", "bi-check-circle", "green")
        @KpiCard("defaults", "Default Types", _items.Count(x => x.IsDefault).ToString(), "Fallback classifications used by intake workflows", "bi-star", "amber")
        @KpiCard("risk", "Needs Review", _items.Count(NeedsReview).ToString(), "Inactive defaults, missing category, or duplicate default risk", "bi-exclamation-octagon", "red")
        @KpiCard("commercial", "Commercial", _items.Count(x => IsCategory(x, "Commercial")).ToString(), "Business and organization account types", "bi-briefcase", "purple")
        @KpiCard("personal", "Personal", _items.Count(x => IsCategory(x, "Personal")).ToString(), "Individual and household account types", "bi-person", "cyan")
    </section>

    <section class="aty-workflows" aria-label="Account type workflows">
        <button type="button" class="aty-workflow" @onclick='() => SetDashboardFocus("all", "importance")'><span class="aty-workflow-icon"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></span><span class="aty-workflow-meta"><strong>Classification review</strong><span>Rank account types by operational importance</span></span></button>
        <button type="button" class="aty-workflow" @onclick='() => SetDashboardFocus("defaults", "importance")'><span class="aty-workflow-icon"><i class="bi bi-star" aria-hidden="true"></i></span><span class="aty-workflow-meta"><strong>Default governance</strong><span>Audit fallback account classifications</span></span></button>
        <button type="button" class="aty-workflow" @onclick='() => SetDashboardFocus("risk", "importance")'><span class="aty-workflow-icon"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></span><span class="aty-workflow-meta"><strong>Activation cleanup</strong><span>Review inactive or risky account types</span></span></button>
        <button type="button" class="aty-workflow" @onclick='() => SetDashboardFocus("commercial", "order")'><span class="aty-workflow-icon"><i class="bi bi-briefcase" aria-hidden="true"></i></span><span class="aty-workflow-meta"><strong>Commercial setup</strong><span>Focus on business account workflows</span></span></button>
        <button type="button" class="aty-workflow" @onclick='() => SetDashboardFocus("categories", "category")'><span class="aty-workflow-icon"><i class="bi bi-pie-chart" aria-hidden="true"></i></span><span class="aty-workflow-meta"><strong>Category coverage</strong><span>Compare type coverage by category</span></span></button>
    </section>

    <section class="aty-filter-panel" aria-label="Account type filters">
        <div class="aty-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search"
                   placeholder="Search code, name, category, or description..."
                   aria-label="Search account types"
                   value="@_searchTerm"
                   @oninput="args => OnSearchInputValue(args.Value?.ToString())" />
        </div>
        <div class="aty-filter-grid">
            <label>
                <span>Category</span>
                <select class="form-select" @bind="_categoryFilter" @bind:after="ApplyFilters">
                    <option value="">All categories</option>
                    @foreach (var category in CategoryOptions)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </label>
            <label>
                <span>Status</span>
                <select class="form-select" @bind="_statusFilter" @bind:after="ApplyFilters">
                    <option value="">All statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Default">Default</option>
                    <option value="NeedsReview">Needs review</option>
                </select>
            </label>
            <label>
                <span>Sort</span>
                <select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters">
                    <option value="importance">Importance</option>
                    <option value="order">Sort order</option>
                    <option value="name">Name</option>
                    <option value="category">Category</option>
                    <option value="created">Newest</option>
                </select>
            </label>
        </div>
        <button type="button" class="aty-btn aty-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)">
            <i class="bi bi-x-lg" aria-hidden="true"></i> Reset
        </button>
    </section>

    <nav class="aty-tabs" aria-label="Account type views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="aty-tab @(_activeTab == tab.Key ? "aty-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </nav>

    <main class="aty-dashboard">
        <section class="aty-main-card">
            <div class="aty-card-header">
                <div>
                    <span class="aty-section-kicker">@ActiveViewTitle</span>
                    <h2>@FilteredTypes.Count() account types</h2>
                    <p>Ranked by enterprise importance: default usage, activation state, category coverage, sort precedence, and configuration completeness.</p>
                </div>
                <div class="aty-card-actions">
                    @if (_selectedIds.Count > 0)
                    {
                        <span class="aty-sel-count">@_selectedIds.Count selected</span>
                        <button type="button" class="aty-btn aty-btn--ghost" @onclick="() => ConfirmBulkToggle(true)"><i class="bi bi-check-circle" aria-hidden="true"></i> Activate</button>
                        <button type="button" class="aty-btn aty-btn--ghost" @onclick="() => ConfirmBulkToggle(false)"><i class="bi bi-slash-circle" aria-hidden="true"></i> Deactivate</button>
                        <button type="button" class="aty-btn aty-btn--danger-ghost" @onclick="ConfirmBulkDelete"><i class="bi bi-trash3" aria-hidden="true"></i> Remove</button>
                    }
                    <button type="button" class="aty-btn aty-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="aty-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="aty-btn aty-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="aty-loading"><span class="aty-spinner"></span> Loading account types...</div>
            }
            else if (!FilteredTypes.Any())
            {
                <div class="aty-empty">
                    <i class="bi bi-building" aria-hidden="true"></i>
                    <strong>No account types found</strong>
                    <span>Adjust the active KPI, tab, search, or filters.</span>
                </div>
            }
            else if (_activeTab == "categories")
            {
                <div class="aty-group-grid">
                    @foreach (var group in CategoryGroups)
                    {
                        <article class="aty-group-card">
                            <div class="aty-group-icon"><i class="bi @CategoryIcon(group.Name)" aria-hidden="true"></i></div>
                            <div class="aty-group-meta">
                                <h3>@group.Name</h3>
                                <p>@group.Count types - @group.Active active - @group.DefaultCount default - @group.ReviewCount need review</p>
                                <div class="aty-mini-bar"><span style="width:@group.Percent%"></span></div>
                            </div>
                            <button type="button" class="aty-btn aty-btn--ghost" @onclick="() => FilterByCategory(group.Name)">Open</button>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="aty-table-wrap">
                    <table class="aty-table">
                        <thead>
                            <tr>
                                <th class="aty-check-col"><input type="checkbox" checked="@AllPageSelected" @onchange="args => ToggleSelectAllPageValue(args.Value is bool value && value)" aria-label="Select all account types on page" /></th>
                                <th>Importance</th>
                                <th>Account Type</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Default</th>
                                <th>Order</th>
                                <th>Created</th>
                                <th class="aty-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var type in PagedTypes)
                            {
                                <tr class="@(_selected?.AccountTypeId == type.AccountTypeId ? "aty-row aty-row--selected" : "aty-row")" @onclick="() => SelectRow(type)">
                                    <td class="aty-check-col" @onclick:stopPropagation="true">
                                        <input type="checkbox" checked="@IsSelected(type)" @onchange="() => ToggleSelect(type)" aria-label="Select account type" />
                                    </td>
                                    <td>@ImportanceBadge(type)</td>
                                    <td>
                                        <div class="aty-type-cell">
                                            <div class="aty-avatar" style="@AvatarStyle(type.TypeName)" aria-hidden="true">@Initials(type.TypeName)</div>
                                            <div class="aty-type-meta">
                                                <button type="button" class="aty-link-button" @onclick:stopPropagation="true" @onclick="() => OpenEdit(type)">@type.TypeName</button>
                                                <small>@Safe(type.TypeCode, "No code")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="aty-pill @CategoryBadgeClass(type.Category)"><i class="bi @CategoryIcon(DisplayCategory(type))" aria-hidden="true"></i>@DisplayCategory(type)</span></td>
                                    <td><span class="aty-pill @(type.IsActive ? "aty-pill--green" : "aty-pill--neutral")">@(type.IsActive ? "Active" : "Inactive")</span></td>
                                    <td class="aty-center">@if (type.IsDefault) { <i class="bi bi-star-fill aty-star" aria-label="Default"></i> } else { <span class="aty-muted">-</span> }</td>
                                    <td><span class="aty-date">@type.SortOrder</span></td>
                                    <td><span class="aty-date">@FormatDate(type.CreatedDateUtc)</span></td>
                                    <td class="aty-actions-col" @onclick:stopPropagation="true">
                                        <button type="button" class="aty-icon-btn" title="Edit account type" @onclick="() => OpenEdit(type)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                        <button type="button" class="aty-icon-btn" title="@(type.IsActive ? "Deactivate account type" : "Activate account type")" @onclick="() => ConfirmToggle(type)"><i class="bi @(type.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i></button>
                                        <button type="button" class="aty-icon-btn aty-icon-btn--danger" title="Delete account type" @onclick="() => ConfirmDelete(type)"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="aty-side-panel" aria-label="Account type insights">
            <section class="aty-panel-card">
                <span class="aty-section-kicker">Selected type</span>
                @if (_selected is null)
                {
                    <div class="aty-empty aty-empty--compact">
                        <i class="bi bi-cursor" aria-hidden="true"></i>
                        <strong>Select an account type</strong>
                        <span>Open details, recommendations, and quick actions.</span>
                    </div>
                }
                else
                {
                    <div class="aty-selected__title">
                        <div class="aty-avatar aty-avatar--lg" style="@AvatarStyle(_selected.TypeName)" aria-hidden="true">@Initials(_selected.TypeName)</div>
                        <div>
                            <h3>@_selected.TypeName</h3>
                            <span>@Safe(_selected.TypeCode, "No code") - @DisplayCategory(_selected)</span>
                        </div>
                    </div>
                    <div class="aty-score-card @ImportanceClass(_selected)">
                        <span>Importance score</span>
                        <strong>@ImportanceScore(_selected)</strong>
                        <small>@RecommendedAction(_selected)</small>
                    </div>
                    <dl class="aty-detail-list">
                        <div><dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd></div>
                        <div><dt>Default</dt><dd>@(_selected.IsDefault ? "Yes" : "No")</dd></div>
                        <div><dt>Sort order</dt><dd>@_selected.SortOrder</dd></div>
                        <div><dt>Created</dt><dd>@FormatDate(_selected.CreatedDateUtc)</dd></div>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_selected.Description))
                    {
                        <p class="aty-description">@_selected.Description</p>
                    }
                    <div class="aty-selected-actions">
                        <button type="button" class="aty-btn aty-btn--primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                        <button type="button" class="aty-btn aty-btn--ghost" @onclick="() => ConfirmToggle(_selected)"><i class="bi @(_selected.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i> @(_selected.IsActive ? "Deactivate" : "Activate")</button>
                    </div>
                }
            </section>

            <section class="aty-panel-card">
                <span class="aty-section-kicker">Enterprise insights</span>
                <div class="aty-insight-list">
                    <div class="aty-insight">
                        <i class="bi bi-star" aria-hidden="true"></i>
                        <div><strong>Default coverage</strong><span>@DefaultInsight</span></div>
                    </div>
                    <div class="aty-insight">
                        <i class="bi bi-pie-chart" aria-hidden="true"></i>
                        <div><strong>Category coverage</strong><span>@CategoryInsight</span></div>
                    </div>
                    <div class="aty-insight">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <div><strong>Workflow readiness</strong><span>@ReadinessInsight</span></div>
                    </div>
                </div>
            </section>
        </aside>
    </main>
</div>

@if (_showForm)
{
    <div class="aty-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="account-type-form-title">
        <div class="aty-modal">
            <div class="aty-modal__header">
                <i class="bi bi-building" aria-hidden="true"></i>
                <span id="account-type-form-title">@(_editId.HasValue ? "Edit Account Type" : "Add Account Type")</span>
                <button type="button" class="aty-icon-btn aty-icon-btn--light ms-auto" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="aty-modal__body">
                    <div class="aty-validation-note">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <div><strong>Account type governance</strong><span>Code and name are required. Keep one default type per operational category when possible.</span></div>
                    </div>
                    <div class="aty-form-grid">
                        <label class="aty-field">
                            <span>Type Code <em>*</em></span>
                            <InputText @bind-Value="_form.TypeCode" class="form-control" placeholder="e.g. COMMERCIAL" />
                        </label>
                        <label class="aty-field">
                            <span>Type Name <em>*</em></span>
                            <InputText @bind-Value="_form.TypeName" class="form-control" placeholder="Commercial Account" />
                        </label>
                        <label class="aty-field">
                            <span>Category</span>
                            <InputSelect @bind-Value="_form.Category" class="form-select">
                                <option value="">Uncategorized</option>
                                @foreach (var category in CategoryOptions)
                                {
                                    <option value="@category">@category</option>
                                }
                            </InputSelect>
                        </label>
                        <label class="aty-field">
                            <span>Sort Order</span>
                            <InputNumber @bind-Value="_form.SortOrder" class="form-control" />
                        </label>
                        <label class="aty-field aty-field--wide">
                            <span>Description</span>
                            <InputTextArea @bind-Value="_form.Description" class="form-control" rows="3" placeholder="Describe where this type should be used." />
                        </label>
                        <label class="aty-check-field">
                            <InputCheckbox @bind-Value="_form.IsDefault" />
                            <span>Default Type</span>
                        </label>
                        @if (_editId.HasValue)
                        {
                            <label class="aty-check-field">
                                <InputCheckbox @bind-Value="_form.IsActive" />
                                <span>Active</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="aty-modal__footer">
                    <button type="button" class="aty-btn aty-btn--ghost" @onclick="CloseForm">Cancel</button>
                    <button type="submit" class="aty-btn aty-btn--primary" disabled="@_saving">
                        @if (_saving) { <span class="aty-spin-sm"></span> }
                        @(_editId.HasValue ? "Save Changes" : "Create Type")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_confirmVisible)
{
    <div class="aty-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="account-type-confirm-title">
        <div class="aty-confirm">
            <div class="aty-confirm__body">
                <div class="aty-confirm-icon aty-confirm-icon--danger"><i class="bi @_confirmIcon" aria-hidden="true"></i></div>
                <div>
                    <h3 id="account-type-confirm-title">@_confirmTitle</h3>
                    <p>@_confirmMessage</p>
                </div>
            </div>
            <div class="aty-modal__footer">
                <button type="button" class="aty-btn aty-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button>
                <button type="button" class="aty-btn aty-btn--danger" @onclick="ExecuteConfirmedAsync" disabled="@_saving">
                    @if (_saving) { <span class="aty-spin-sm"></span> }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<div class="aty-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="aty-toast aty-toast--@toast.Kind">
            <i class="bi @(toast.Kind == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")" aria-hidden="true"></i>
            <span>@toast.Message</span>
            <button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
    }
</div>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    Guid TenantId { get; set; }

    readonly List<DashboardTab> _tabs =
    [
        new("all", "All", "bi-diagram-3"),
        new("defaults", "Defaults", "bi-star"),
        new("risk", "Needs Review", "bi-exclamation-octagon"),
        new("inactive", "Inactive", "bi-slash-circle"),
        new("commercial", "Commercial", "bi-briefcase"),
        new("personal", "Personal", "bi-person"),
        new("categories", "Categories", "bi-pie-chart")
    ];

    static readonly string[] CategoryOptions = ["Personal", "Commercial", "Government"];

    List<AccountTypeDto> _items = [];
    HashSet<Guid> _selectedIds = [];
    List<ToastItem> _toasts = [];
    AccountTypeDto? _selected;
    AccountTypeFormModel _form = new();
    Func<Task>? _confirmAction;
    Guid? _editId;
    string _activeTab = "all";
    string _searchTerm = string.Empty;
    string _categoryFilter = string.Empty;
    string _statusFilter = string.Empty;
    string _sortMode = "importance";
    string _confirmTitle = string.Empty;
    string _confirmMessage = string.Empty;
    string _confirmIcon = "bi-exclamation-triangle-fill";
    string? _loadError;
    bool _loading;
    bool _saving;
    bool _showForm;
    bool _confirmVisible;
    int _page = 1;
    const int PageSize = 12;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Account Config", null), new("Account Types", null));
        await LoadAsync();
    }

    IEnumerable<AccountTypeDto> FilteredTypes
    {
        get
        {
            IEnumerable<AccountTypeDto> query = _items;

            query = _activeTab switch
            {
                "defaults" => query.Where(x => x.IsDefault),
                "risk" => query.Where(NeedsReview),
                "inactive" => query.Where(x => !x.IsActive),
                "commercial" => query.Where(x => IsCategory(x, "Commercial")),
                "personal" => query.Where(x => IsCategory(x, "Personal")),
                _ => query
            };

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                query = query.Where(MatchesSearch);
            }

            if (!string.IsNullOrWhiteSpace(_categoryFilter))
            {
                query = query.Where(x => IsCategory(x, _categoryFilter));
            }

            query = _statusFilter switch
            {
                "Active" => query.Where(x => x.IsActive),
                "Inactive" => query.Where(x => !x.IsActive),
                "Default" => query.Where(x => x.IsDefault),
                "NeedsReview" => query.Where(NeedsReview),
                _ => query
            };

            return _sortMode switch
            {
                "order" => query.OrderBy(x => x.SortOrder).ThenBy(x => x.TypeName),
                "name" => query.OrderBy(x => x.TypeName),
                "category" => query.OrderBy(DisplayCategory).ThenBy(x => x.SortOrder).ThenBy(x => x.TypeName),
                "created" => query.OrderByDescending(x => x.CreatedDateUtc),
                _ => query.OrderByDescending(ImportanceScore).ThenBy(x => x.SortOrder).ThenBy(x => x.TypeName)
            };
        }
    }

    List<AccountTypeDto> PagedTypes => FilteredTypes.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredTypes.Count() / (double)PageSize));
    bool AllPageSelected => PagedTypes.Count > 0 && PagedTypes.All(IsSelected);
    bool HasFilters => !string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_categoryFilter) || !string.IsNullOrWhiteSpace(_statusFilter) || _activeTab != "all" || _sortMode != "importance";
    string ActiveViewTitle => _tabs.FirstOrDefault(x => x.Key == _activeTab)?.Label ?? "All";
    string DefaultInsight => _items.Count(x => x.IsDefault) switch { 0 => "No default type is configured. Intake workflows may require manual classification.", 1 => "One default type is configured for fallback classification.", var count => $"{count} default types exist. Review category-level default intent." };
    string CategoryInsight => CategoryGroups.Any() ? $"{CategoryGroups.Count} categories are covered. Largest category: {CategoryGroups.OrderByDescending(x => x.Count).First().Name}." : "No category coverage is available yet.";
    string ReadinessInsight => _items.Count == 0 ? "Create account types before enabling account intake workflows." : $"{Math.Round(_items.Count(x => x.IsActive) * 100m / _items.Count)}% of account types are active.";

    List<CategorySummary> CategoryGroups => _items
        .GroupBy(DisplayCategory)
        .Select(g => new CategorySummary(g.Key, g.Count(), g.Count(x => x.IsActive), g.Count(x => x.IsDefault), g.Count(NeedsReview), _items.Count == 0 ? 0 : Math.Round(g.Count() * 100m / _items.Count, 0)))
        .OrderByDescending(x => x.Count)
        .ToList();

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchAccountTypesAsync(TenantId, null, pageSize: 500);
            _items = result?.Items.ToList() ?? [];
            _selectedIds.RemoveWhere(id => _items.All(x => x.AccountTypeId != id));
            _selected = _selected is null ? _items.OrderByDescending(ImportanceScore).FirstOrDefault() : _items.FirstOrDefault(x => x.AccountTypeId == _selected.AccountTypeId) ?? _items.OrderByDescending(ImportanceScore).FirstOrDefault();
            NormalizePage();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load account types: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    Task RefreshAsync() => LoadAsync();

    void ApplyFilters()
    {
        _page = 1;
        NormalizePage();
    }

    void OnSearchInputValue(string? value)
    {
        _searchTerm = value ?? string.Empty;
        ApplyFilters();
    }

    void SetDashboardFocus(string tab, string sort)
    {
        _activeTab = tab;
        _sortMode = sort == "category" ? "category" : sort;
        _page = 1;
        NormalizePage();
    }

    void SetActiveTab(string tab)
    {
        _activeTab = tab;
        _page = 1;
        NormalizePage();
    }

    void ClearFilters()
    {
        _searchTerm = string.Empty;
        _categoryFilter = string.Empty;
        _statusFilter = string.Empty;
        _sortMode = "importance";
        _activeTab = "all";
        _page = 1;
    }

    void FilterByCategory(string category)
    {
        _activeTab = "all";
        _categoryFilter = category == "Uncategorized" ? string.Empty : category;
        _sortMode = "importance";
        _page = 1;
    }

    void PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
        }
    }

    void NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
        }
    }

    void NormalizePage()
    {
        if (_page > TotalPages)
        {
            _page = TotalPages;
        }
    }

    void SelectRow(AccountTypeDto item) => _selected = item;
    bool IsSelected(AccountTypeDto item) => _selectedIds.Contains(item.AccountTypeId);

    void ToggleSelect(AccountTypeDto item)
    {
        if (!_selectedIds.Add(item.AccountTypeId))
        {
            _selectedIds.Remove(item.AccountTypeId);
        }
        _selected = item;
    }

    void ToggleSelectAllPageValue(bool shouldSelect)
    {
        foreach (var item in PagedTypes)
        {
            if (shouldSelect)
            {
                _selectedIds.Add(item.AccountTypeId);
            }
            else
            {
                _selectedIds.Remove(item.AccountTypeId);
            }
        }
    }

    void OpenCreate()
    {
        _editId = null;
        _form = new() { IsActive = true, SortOrder = NextSortOrder() };
        _showForm = true;
    }

    void OpenEdit(AccountTypeDto item)
    {
        _selected = item;
        _editId = item.AccountTypeId;
        _form = new()
        {
            TypeCode = item.TypeCode,
            TypeName = item.TypeName,
            Category = item.Category,
            Description = item.Description,
            IsDefault = item.IsDefault,
            IsActive = item.IsActive,
            SortOrder = item.SortOrder
        };
        _showForm = true;
    }

    void CloseForm()
    {
        _showForm = false;
        ResetForm();
    }

    void ResetForm()
    {
        _form = new();
        _editId = null;
    }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue)
            {
                await Api.UpdateAccountTypeAsync(_editId.Value, new(_form.TypeCode.Trim(), _form.TypeName.Trim(), NormalizeNullable(_form.Category), NormalizeNullable(_form.Description), _form.IsDefault, _form.IsActive, _form.SortOrder));
            }
            else
            {
                await Api.CreateAccountTypeAsync(new(TenantId, _form.TypeCode.Trim(), _form.TypeName.Trim(), NormalizeNullable(_form.Category), NormalizeNullable(_form.Description), _form.IsDefault, _form.SortOrder));
            }

            _showForm = false;
            ShowToast("success", _editId.HasValue ? "Account type updated successfully." : "Account type created successfully.");
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast("danger", $"Save failed: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    void ConfirmToggle(AccountTypeDto item)
    {
        var enable = !item.IsActive;
        OpenConfirm(
            enable ? "Activate Account Type" : "Deactivate Account Type",
            $"Are you sure you want to {(enable ? "activate" : "deactivate")} {item.TypeName}? This changes availability for account workflows.",
            "bi-shield-exclamation",
            () => SetTypeActiveAsync(item, enable));
    }

    void ConfirmDelete(AccountTypeDto item)
    {
        OpenConfirm(
            "Delete Account Type",
            $"Are you sure you want to delete {item.TypeName}? This action cannot be undone.",
            "bi-trash3-fill",
            () => DeleteTypeAsync(item));
    }

    void ConfirmBulkToggle(bool enable)
    {
        OpenConfirm(
            enable ? "Activate Selected Types" : "Deactivate Selected Types",
            $"Are you sure you want to {(enable ? "activate" : "deactivate")} {_selectedIds.Count} selected account type(s)?",
            "bi-shield-exclamation",
            () => BulkSetActiveAsync(enable));
    }

    void ConfirmBulkDelete()
    {
        OpenConfirm(
            "Delete Selected Types",
            $"Are you sure you want to delete {_selectedIds.Count} selected account type(s)? This action cannot be undone.",
            "bi-trash3-fill",
            BulkDeleteAsync);
    }

    void OpenConfirm(string title, string message, string icon, Func<Task> action)
    {
        _confirmTitle = title;
        _confirmMessage = message;
        _confirmIcon = icon;
        _confirmAction = action;
        _confirmVisible = true;
    }

    void CloseConfirm()
    {
        _confirmVisible = false;
        _confirmAction = null;
    }

    async Task ExecuteConfirmedAsync()
    {
        if (_confirmAction is null)
        {
            return;
        }

        _saving = true;
        try
        {
            await _confirmAction();
            _confirmVisible = false;
            _confirmAction = null;
        }
        finally
        {
            _saving = false;
        }
    }

    async Task SetTypeActiveAsync(AccountTypeDto item, bool active)
    {
        try
        {
            await Api.UpdateAccountTypeAsync(item.AccountTypeId, new(item.TypeCode, item.TypeName, item.Category, item.Description, item.IsDefault, active, item.SortOrder));
            ShowToast("success", active ? "Account type activated." : "Account type deactivated.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast("danger", $"Update failed: {ex.Message}");
        }
    }

    async Task DeleteTypeAsync(AccountTypeDto item)
    {
        try
        {
            await Api.DeleteAccountTypeAsync(item.AccountTypeId);
            _selectedIds.Remove(item.AccountTypeId);
            if (_selected?.AccountTypeId == item.AccountTypeId)
            {
                _selected = null;
            }
            ShowToast("success", "Account type deleted.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast("danger", $"Delete failed: {ex.Message}");
        }
    }

    async Task BulkSetActiveAsync(bool active)
    {
        var selected = _items.Where(x => _selectedIds.Contains(x.AccountTypeId)).ToList();
        var updated = 0;
        foreach (var item in selected)
        {
            try
            {
                await Api.UpdateAccountTypeAsync(item.AccountTypeId, new(item.TypeCode, item.TypeName, item.Category, item.Description, item.IsDefault, active, item.SortOrder));
                updated++;
            }
            catch (Exception ex)
            {
                ShowToast("danger", $"Update failed for {item.TypeName}: {ex.Message}");
            }
        }

        ShowToast("success", $"{updated} account type(s) {(active ? "activated" : "deactivated")}.");
        _selectedIds.Clear();
        await LoadAsync();
    }

    async Task BulkDeleteAsync()
    {
        var selected = _items.Where(x => _selectedIds.Contains(x.AccountTypeId)).ToList();
        var deleted = 0;
        foreach (var item in selected)
        {
            try
            {
                await Api.DeleteAccountTypeAsync(item.AccountTypeId);
                deleted++;
            }
            catch (Exception ex)
            {
                ShowToast("danger", $"Delete failed for {item.TypeName}: {ex.Message}");
            }
        }

        ShowToast("success", $"{deleted} account type(s) deleted.");
        _selectedIds.Clear();
        _selected = null;
        await LoadAsync();
    }

    RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string color) => @<button type="button" class="aty-kpi-card aty-kpi-card--@color @(_activeTab == key ? "aty-kpi-card--active" : null)" title="@subtitle" @onclick="() => SetActiveTab(key)">
        <span class="aty-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span>
        <span class="aty-kpi-body"><span class="aty-kpi-label">@label</span><strong class="aty-kpi-value">@value</strong><span class="aty-kpi-sub">@subtitle</span></span>
    </button>;

    int TabCount(string key) => key switch
    {
        "defaults" => _items.Count(x => x.IsDefault),
        "risk" => _items.Count(NeedsReview),
        "inactive" => _items.Count(x => !x.IsActive),
        "commercial" => _items.Count(x => IsCategory(x, "Commercial")),
        "personal" => _items.Count(x => IsCategory(x, "Personal")),
        "categories" => CategoryGroups.Count,
        _ => _items.Count
    };

    bool MatchesSearch(AccountTypeDto item)
    {
        var term = _searchTerm.Trim();
        return Contains(item.TypeCode, term) || Contains(item.TypeName, term) || Contains(item.Category, term) || Contains(item.Description, term);
    }

    static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    static bool IsCategory(AccountTypeDto item, string category) => string.Equals(DisplayCategory(item), category, StringComparison.OrdinalIgnoreCase);
    static string DisplayCategory(AccountTypeDto item) => string.IsNullOrWhiteSpace(item.Category) ? "Uncategorized" : item.Category.Trim();
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string? NormalizeNullable(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    static string FormatDate(DateTime date) => date == default ? "-" : date.ToLocalTime().ToString("MMM d, yyyy");

    static bool NeedsReview(AccountTypeDto item) => !item.IsActive || string.IsNullOrWhiteSpace(item.Category) || (item.IsDefault && !item.IsActive) || string.IsNullOrWhiteSpace(item.TypeCode) || string.IsNullOrWhiteSpace(item.TypeName);
    static bool IsHighImportance(AccountTypeDto item) => ImportanceScore(item) >= 70;

    static int ImportanceScore(AccountTypeDto item)
    {
        var score = 35;
        if (item.IsDefault) score += 25;
        if (item.IsActive) score += 15; else score += 20;
        if (string.Equals(item.Category, "Commercial", StringComparison.OrdinalIgnoreCase)) score += 12;
        if (string.Equals(item.Category, "Personal", StringComparison.OrdinalIgnoreCase)) score += 8;
        if (string.IsNullOrWhiteSpace(item.Category)) score += 18;
        if (item.SortOrder <= 10) score += 8;
        if (string.IsNullOrWhiteSpace(item.Description)) score += 4;
        return Math.Clamp(score, 0, 100);
    }

    static string RecommendedAction(AccountTypeDto item)
    {
        if (item.IsDefault && !item.IsActive) return "Activate or replace inactive default.";
        if (string.IsNullOrWhiteSpace(item.Category)) return "Assign a category for reporting coverage.";
        if (!item.IsActive) return "Review whether this type should remain inactive.";
        if (string.IsNullOrWhiteSpace(item.Description)) return "Add usage guidance for operations.";
        return "Configuration is ready for account workflows.";
    }

    static string ImportanceClass(AccountTypeDto item) => ImportanceScore(item) switch
    {
        >= 80 => "aty-score-card--red",
        >= 65 => "aty-score-card--amber",
        >= 45 => "aty-score-card--cyan",
        _ => "aty-score-card--green"
    };

    static MarkupString ImportanceBadge(AccountTypeDto item)
    {
        var score = ImportanceScore(item);
        var css = score switch { >= 80 => "red", >= 65 => "amber", >= 45 => "cyan", _ => "green" };
        return new($"<span class=\"aty-risk-badge aty-risk-badge--{css}\">{score}</span>");
    }

    static string CategoryBadgeClass(string? category) => DisplayCategory(new AccountTypeDto { Category = category }) switch
    {
        "Commercial" => "aty-pill--purple",
        "Personal" => "aty-pill--cyan",
        "Government" => "aty-pill--amber",
        _ => "aty-pill--neutral"
    };

    static string CategoryIcon(string category) => category switch
    {
        "Commercial" => "bi-briefcase",
        "Personal" => "bi-person",
        "Government" => "bi-bank",
        _ => "bi-question-circle"
    };

    static string Initials(string? value)
    {
        var parts = (value ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => "AT",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0])))
        };
    }

    static string AvatarStyle(string? value)
    {
        var hash = Math.Abs((value ?? "AccountType").GetHashCode());
        var hue = hash % 360;
        return $"background:linear-gradient(135deg,hsl({hue},78%,48%),hsl({(hue + 35) % 360},82%,36%));";
    }

    int NextSortOrder() => _items.Count == 0 ? 10 : _items.Max(x => x.SortOrder) + 10;

    void ShowToast(string kind, string message)
    {
        _toasts.Insert(0, new(Guid.NewGuid(), kind, message));
        if (_toasts.Count > 4)
        {
            _toasts.RemoveRange(4, _toasts.Count - 4);
        }
    }

    void DismissToast(Guid id) => _toasts.RemoveAll(x => x.Id == id);

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }

    sealed class AccountTypeFormModel
    {
        [Required, StringLength(50)] public string TypeCode { get; set; } = string.Empty;
        [Required, StringLength(100)] public string TypeName { get; set; } = string.Empty;
        [StringLength(50)] public string? Category { get; set; }
        [StringLength(500)] public string? Description { get; set; }
        public bool IsDefault { get; set; }
        public bool IsActive { get; set; } = true;
        [Range(0, 9999)] public int SortOrder { get; set; }
    }

    sealed record DashboardTab(string Key, string Label, string Icon);
    sealed record CategorySummary(string Name, int Count, int Active, int DefaultCount, int ReviewCount, decimal Percent);
    sealed record ToastItem(Guid Id, string Kind, string Message);
}
