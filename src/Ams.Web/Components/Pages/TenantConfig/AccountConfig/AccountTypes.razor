@page "/tenant/accounts/types"
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Account Types — Account Configuration</PageTitle>

<AppPageHeader Title="Account Types"
               Subtitle="Define account classification types for personal, commercial, and government clients"
               Icon="bi-building">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Type
        </button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
    </Actions>
</AppPageHeader>

<div class="pc-kpi-strip">
    <div class="pc-kpi-card @(_activeFilter == "" ? "pc-kpi-card--active" : "")"
         title="Show all account types" @onclick='() => SetFilter("")' style="cursor:pointer">
        <span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-building" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total Types</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "Personal" ? "pc-kpi-card--active" : "")"
         title="Filter by Personal category" @onclick='() => SetFilter("Personal")' style="cursor:pointer">
        <span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.Category == "Personal")</div><div class="pc-kpi-label">Personal</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "Commercial" ? "pc-kpi-card--active" : "")"
         title="Filter by Commercial category" @onclick='() => SetFilter("Commercial")' style="cursor:pointer">
        <span class="pc-kpi-icon" style="background:#dbeafe"><i class="bi bi-briefcase-fill text-primary" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.Category == "Commercial")</div><div class="pc-kpi-label">Commercial</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "Government" ? "pc-kpi-card--active" : "")"
         title="Filter by Government category" @onclick='() => SetFilter("Government")' style="cursor:pointer">
        <span class="pc-kpi-icon" style="background:#fef9c3"><i class="bi bi-bank text-warning" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.Category == "Government")</div><div class="pc-kpi-label">Government</div></div>
    </div>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

<AppFilterPanel @bind-SearchValue="_search" OnSearch="OnSearchAsync" SearchPlaceholder="Search account type…" />

<div class="um-grid-card">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }
    <SfGrid TValue="AccountTypeDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
        <GridEvents TValue="AccountTypeDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" />
        <GridColumns>
            <GridColumn Field="TypeCode" HeaderText="Code" Width="120" />
            <GridColumn Field="TypeName" HeaderText="Type Name" Width="200" />
            <GridColumn Field="Category" HeaderText="Category" Width="140" />
            <GridColumn Field="IsDefault" HeaderText="Default" Width="90" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (AccountTypeDto)context; }
                    @if (r.IsDefault) { <i class="bi bi-check2-circle text-success"></i> }
                </Template>
            </GridColumn>
            <GridColumn Field="SortOrder" HeaderText="Order" Width="80" TextAlign="TextAlign.Center" />
            <GridColumn Field="IsActive" HeaderText="Status" Width="100" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (AccountTypeDto)context; }
                    <span class="um-badge @(r.IsActive ? "um-badge-success" : "um-badge-neutral")">@(r.IsActive ? "Active" : "Inactive")</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="100" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (AccountTypeDto)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEdit(r)"><i class="bi bi-pencil"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(r)"><i class="bi bi-trash"></i></button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showForm" Width="520px" IsModal="true" ShowCloseIcon="false">
    <DialogEvents Closed="ResetForm" />
    <DialogContent>
        <div class="um-modal-header">
            <i class="bi bi-building" aria-hidden="true"></i>
            <span>@(_editId.HasValue ? "Edit Account Type" : "Add Account Type")</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button>
        </div>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="um-field">
                        <label>Type Code <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.TypeCode" class="um-input" placeholder="e.g. PERSONAL" />
                        <ValidationMessage For="() => _form.TypeCode" class="validation-message text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Type Name <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.TypeName" class="um-input" />
                        <ValidationMessage For="() => _form.TypeName" class="validation-message text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Category</label>
                        <SfDropDownList TValue="string" TItem="string" @bind-Value="_form.Category"
                            DataSource="@(new[]{"Personal","Commercial","Government"})" Placeholder="Select category" />
                        <ValidationMessage For="() => _form.Category" class="validation-message text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Description</label>
                        <InputTextArea @bind-Value="_form.Description" class="um-input" rows="2" />
                        <ValidationMessage For="() => _form.Description" class="validation-message text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Sort Order</label>
                        <InputNumber @bind-Value="_form.SortOrder" class="um-input" />
                        <ValidationMessage For="() => _form.SortOrder" class="validation-message text-danger" />
                    </div>
                    <div class="um-field um-field--checkbox">
                        <label><InputCheckbox @bind-Value="_form.IsDefault" /> Default Type</label>
                    </div>
                    <div class="um-field um-field--checkbox">
                        <label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label>
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button>
            </div>
        </EditForm>
    </DialogContent>
</SfDialog>

<SfDialog @bind-Visible="_showDelete" Width="420px" IsModal="true" ShowCloseIcon="false">
    <DialogContent>
        <div class="um-confirm-dialog">
            <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash3-fill"></i></div>
            <div class="um-confirm-title">Delete Account Type</div>
            <div class="um-confirm-body">Are you sure you want to delete <strong>@_deleteTarget?.TypeName</strong>? This action cannot be undone.</div>
            <div class="um-modal-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button>
            </div>
        </div>
    </DialogContent>
</SfDialog>

<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true"><ToastPosition X="Right" Y="Bottom" /></SfToast>

<style>
    .validation-message {
        display: flex;
        align-items: center;
        gap: .45rem;
        margin-top: .55rem;
        color: #dc3545 !important;
        font-size: .875rem;
        font-weight: 700;
    }
    .validation-message::before {
        content: "!";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1rem;
        height: 1rem;
        min-width: 1rem;
        flex-shrink: 0;
        border-radius: 999px;
        color: #fff;
        background: linear-gradient(135deg, #ef4444, #b91c1c);
        font-size: .7rem;
        font-weight: 800;
    }
    .um-input.modified.invalid {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 .18rem rgba(220,53,69,.14) !important;
    }
</style>

@code {
    static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    List<AccountTypeDto> _items = [];
    List<AccountTypeDto> _filtered = [];
    string _activeFilter = "";
    bool _loading, _saving;
    string _search = string.Empty;
    string? _loadError;
    bool _showForm, _showDelete;
    Guid? _editId;
    AccountTypeDto? _deleteTarget;
    SfToast _toast = default!;
    AccountTypeFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Account Config", null), new("Account Types", null));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var r = await Api.SearchAccountTypesAsync(TenantId, _search, pageSize: 200);
            _items = r?.Items.ToList() ?? [];
            ApplyFilter();
        }
        catch (Exception ex) { _loadError = ex.Message; }
        finally { _loading = false; }
    }

    void SetFilter(string filter) { _activeFilter = filter; ApplyFilter(); }

    void ApplyFilter()
    {
        _filtered = _activeFilter switch
        {
            "Personal"   => _items.Where(x => x.Category == "Personal").ToList(),
            "Commercial" => _items.Where(x => x.Category == "Commercial").ToList(),
            "Government" => _items.Where(x => x.Category == "Government").ToList(),
            _            => [.. _items]
        };
    }

    Task OnSearchAsync() => LoadAsync();

    void OnRowSelected(RowSelectEventArgs<AccountTypeDto> args) => OpenEdit(args.Data);

    void OpenCreate() { _editId = null; _form = new(); _showForm = true; }

    void OpenEdit(AccountTypeDto item)
    {
        _editId = item.AccountTypeId;
        _form = new() { TypeCode = item.TypeCode, TypeName = item.TypeName, Category = item.Category, Description = item.Description, IsDefault = item.IsDefault, SortOrder = item.SortOrder, IsActive = item.IsActive };
        _showForm = true;
    }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue)
                await Api.UpdateAccountTypeAsync(_editId.Value, new(_form.TypeCode, _form.TypeName, _form.Category, _form.Description, _form.IsDefault, _form.IsActive, _form.SortOrder));
            else
                await Api.CreateAccountTypeAsync(new(TenantId, _form.TypeCode, _form.TypeName, _form.Category, _form.Description, _form.IsDefault, _form.SortOrder));
            _showForm = false;
            await _toast.ShowAsync(new() { Content = "Saved successfully", CssClass = "e-toast-success" });
            await LoadAsync();
        }
        catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); }
        finally { _saving = false; }
    }

    void ConfirmDelete(AccountTypeDto item) { _deleteTarget = item; _showDelete = true; }

    async Task ExecuteDeleteAsync()
    {
        _saving = true;
        try
        {
            await Api.DeleteAccountTypeAsync(_deleteTarget!.AccountTypeId);
            _showDelete = false;
            await _toast.ShowAsync(new() { Content = "Deleted successfully", CssClass = "e-toast-success" });
            await LoadAsync();
        }
        catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" }); }
        finally { _saving = false; }
    }

    void ResetForm() { _form = new(); _editId = null; }

    sealed class AccountTypeFormModel
    {
        [Required, StringLength(50)]  public string  TypeCode    { get; set; } = string.Empty;
        [Required, StringLength(100)] public string  TypeName    { get; set; } = string.Empty;
        public string? Category    { get; set; }
        [StringLength(500)] public string? Description { get; set; }
        public bool   IsDefault    { get; set; }
        [Range(0, 9999)] public int SortOrder   { get; set; }
        public bool   IsActive     { get; set; } = true;
    }
}
