@page "/tenant/accounts/contact-types"
@using System.ComponentModel.DataAnnotations
@using ChangeEventArgs = Microsoft.AspNetCore.Components.ChangeEventArgs
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Contact Type Command Center - Account Configuration</PageTitle>

<div class="cty-page">
    <section class="cty-hero">
        <div class="cty-hero__content">
            <div class="cty-hero-left">
                <span class="cty-hero-icon"><i class="bi bi-person-lines-fill" aria-hidden="true"></i></span>
                <div class="cty-hero-title">
                    <div class="cty-hero__eyebrow">Enterprise contact configuration</div>
                    <div class="cty-title-row">
                        <h1>Contact Type Command Center</h1>
                        <div class="cty-hero__meta">
                            <span><i class="bi bi-person-badge" aria-hidden="true"></i>@_items.Count types</span>
                            <span><i class="bi bi-star-fill" aria-hidden="true"></i>@_items.Count(x => x.IsDefault) default</span>
                            <span><i class="bi bi-check-circle" aria-hidden="true"></i>@_items.Count(x => x.IsActive) active</span>
                            <span><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>@_items.Count(NeedsReview) need review</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Define contact roles, defaults, operational priority, and servicing workflows across account contact management.</p>
        </div>
        <div class="cty-hero__actions">
            <button type="button" class="cty-btn cty-btn--light" @onclick="RefreshAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "cty-spin" : null)" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="cty-btn cty-btn--primary" @onclick="OpenCreate">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Type
            </button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger cty-alert" style="border-left: 4px solid #dc3545; animation: cty-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="cty-kpi-strip" aria-label="Contact type KPIs">
        @KpiCard("all", "Total Types", _items.Count.ToString(), "All configured contact role types", "bi-person-badge", "blue")
        @KpiCard("active", "Active", _items.Count(x => x.IsActive).ToString(), "Types available for account contact workflows", "bi-check-circle", "green")
        @KpiCard("defaults", "Default", _items.Count(x => x.IsDefault).ToString(), "Default contact roles used by intake workflows", "bi-star", "amber")
        @KpiCard("risk", "Needs Review", _items.Count(NeedsReview).ToString(), "Inactive defaults, missing descriptions, or incomplete definitions", "bi-exclamation-octagon", "red")
        @KpiCard("priority", "Priority", _items.Count(IsPriorityContactType).ToString(), "Primary, decision-maker, owner, or billing-oriented roles", "bi-lightning-charge", "purple")
        @KpiCard("inactive", "Inactive", _items.Count(x => !x.IsActive).ToString(), "Contact types hidden from workflow usage", "bi-slash-circle", "cyan")
    </section>

    <section class="cty-workflows" aria-label="Contact type workflows">
        <button type="button" class="cty-workflow" @onclick='() => SetDashboardFocus("all", "importance")'><span class="cty-workflow-icon"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></span><span class="cty-workflow-meta"><strong>Role review</strong><span>Rank contact types by operational importance</span></span></button>
        <button type="button" class="cty-workflow" @onclick='() => SetDashboardFocus("defaults", "importance")'><span class="cty-workflow-icon"><i class="bi bi-star" aria-hidden="true"></i></span><span class="cty-workflow-meta"><strong>Default governance</strong><span>Audit fallback contact roles</span></span></button>
        <button type="button" class="cty-workflow" @onclick='() => SetDashboardFocus("priority", "importance")'><span class="cty-workflow-icon"><i class="bi bi-lightning-charge" aria-hidden="true"></i></span><span class="cty-workflow-meta"><strong>Priority contacts</strong><span>Focus on primary, owner, decision, and billing roles</span></span></button>
        <button type="button" class="cty-workflow" @onclick='() => SetDashboardFocus("risk", "importance")'><span class="cty-workflow-icon"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></span><span class="cty-workflow-meta"><strong>Cleanup queue</strong><span>Review inactive or incomplete contact type definitions</span></span></button>
        <button type="button" class="cty-workflow" @onclick='() => SetDashboardFocus("groups", "group")'><span class="cty-workflow-icon"><i class="bi bi-pie-chart" aria-hidden="true"></i></span><span class="cty-workflow-meta"><strong>Role coverage</strong><span>Compare priority, default, inactive, and standard roles</span></span></button>
    </section>

    <section class="cty-filter-panel" aria-label="Contact type filters">
        <div class="cty-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search"
                   placeholder="Search code, name, description, or role group..."
                   aria-label="Search contact types"
                   value="@_searchTerm"
                   @oninput="args => OnSearchInputValue(args.Value?.ToString())" />
        </div>
        <div class="cty-filter-grid">
            <label>
                <span>Role Group</span>
                <select class="form-select" @bind="_groupFilter" @bind:after="ApplyFilters">
                    <option value="">All groups</option>
                    @foreach (var group in RoleGroupOptions)
                    {
                        <option value="@group">@group</option>
                    }
                </select>
            </label>
            <label>
                <span>Status</span>
                <select class="form-select" @bind="_statusFilter" @bind:after="ApplyFilters">
                    <option value="">All statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Default">Default</option>
                    <option value="NeedsReview">Needs review</option>
                </select>
            </label>
            <label>
                <span>Sort</span>
                <select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters">
                    <option value="importance">Importance</option>
                    <option value="order">Sort order</option>
                    <option value="name">Name</option>
                    <option value="group">Role group</option>
                    <option value="created">Newest</option>
                </select>
            </label>
        </div>
        <button type="button" class="cty-btn cty-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)">
            <i class="bi bi-x-lg" aria-hidden="true"></i> Reset
        </button>
    </section>

    <nav class="cty-tabs" aria-label="Contact type views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="cty-tab @(_activeTab == tab.Key ? "cty-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </nav>

    <main class="cty-dashboard">
        <section class="cty-main-card">
            <div class="cty-card-header">
                <div>
                    <span class="cty-section-kicker">@ActiveViewTitle</span>
                    <h2>@FilteredTypes.Count() contact types</h2>
                    <p>Ranked by enterprise importance: default usage, priority roles, activation state, sort precedence, and configuration completeness.</p>
                </div>
                <div class="cty-card-actions">
                    @if (_selectedIds.Count > 0)
                    {
                        <span class="cty-sel-count">@_selectedIds.Count selected</span>
                        <button type="button" class="cty-btn cty-btn--ghost" @onclick="() => ConfirmBulkToggle(true)"><i class="bi bi-check-circle" aria-hidden="true"></i> Activate</button>
                        <button type="button" class="cty-btn cty-btn--ghost" @onclick="() => ConfirmBulkToggle(false)"><i class="bi bi-slash-circle" aria-hidden="true"></i> Deactivate</button>
                        <button type="button" class="cty-btn cty-btn--danger-ghost" @onclick="ConfirmBulkDelete"><i class="bi bi-trash3" aria-hidden="true"></i> Remove</button>
                    }
                    <button type="button" class="cty-btn cty-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="cty-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="cty-btn cty-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="cty-loading"><span class="cty-spinner"></span> Loading contact types...</div>
            }
            else if (!FilteredTypes.Any())
            {
                <div class="cty-empty">
                    <i class="bi bi-person-lines-fill" aria-hidden="true"></i>
                    <strong>No contact types found</strong>
                    <span>Adjust the active KPI, tab, search, or filters.</span>
                </div>
            }
            else if (_activeTab == "groups")
            {
                <div class="cty-group-grid">
                    @foreach (var group in RoleGroups)
                    {
                        <article class="cty-group-card">
                            <div class="cty-group-icon"><i class="bi @RoleGroupIcon(group.Name)" aria-hidden="true"></i></div>
                            <div class="cty-group-meta">
                                <h3>@group.Name</h3>
                                <p>@group.Count types - @group.Active active - @group.DefaultCount default - @group.ReviewCount need review</p>
                                <div class="cty-mini-bar"><span style="width:@group.Percent%"></span></div>
                            </div>
                            <button type="button" class="cty-btn cty-btn--ghost" @onclick="() => FilterByGroup(group.Name)">Open</button>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="cty-table-wrap">
                    <table class="cty-table">
                        <thead>
                            <tr>
                                <th class="cty-check-col"><input type="checkbox" checked="@AllPageSelected" @onchange="args => ToggleSelectAllPageValue(args.Value is bool value && value)" aria-label="Select all contact types on page" /></th>
                                <th>Importance</th>
                                <th>Contact Type</th>
                                <th>Role Group</th>
                                <th>Status</th>
                                <th>Default</th>
                                <th>Order</th>
                                <th>Created</th>
                                <th class="cty-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var type in PagedTypes)
                            {
                                <tr class="@(_selected?.ContactTypeId == type.ContactTypeId ? "cty-row cty-row--selected" : "cty-row")" @onclick="() => SelectRow(type)">
                                    <td class="cty-check-col" @onclick:stopPropagation="true">
                                        <input type="checkbox" checked="@IsSelected(type)" @onchange="() => ToggleSelect(type)" aria-label="Select contact type" />
                                    </td>
                                    <td>@ImportanceBadge(type)</td>
                                    <td>
                                        <div class="cty-type-cell">
                                            <div class="cty-avatar" style="@AvatarStyle(type.TypeName)" aria-hidden="true">@Initials(type.TypeName)</div>
                                            <div class="cty-type-meta">
                                                <button type="button" class="cty-link-button" @onclick:stopPropagation="true" @onclick="() => OpenEdit(type)">@type.TypeName</button>
                                                <small>@Safe(type.TypeCode, "No code")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="cty-pill @RoleGroupBadgeClass(type)"><i class="bi @RoleGroupIcon(RoleGroup(type))" aria-hidden="true"></i>@RoleGroup(type)</span></td>
                                    <td><span class="cty-pill @(type.IsActive ? "cty-pill--green" : "cty-pill--neutral")">@(type.IsActive ? "Active" : "Inactive")</span></td>
                                    <td class="cty-center">@if (type.IsDefault) { <i class="bi bi-star-fill cty-star" aria-label="Default"></i> } else { <span class="cty-muted">-</span> }</td>
                                    <td><span class="cty-date">@type.SortOrder</span></td>
                                    <td><span class="cty-date">@FormatDate(type.CreatedDateUtc)</span></td>
                                    <td class="cty-actions-col" @onclick:stopPropagation="true">
                                        <button type="button" class="cty-icon-btn" title="Edit contact type" @onclick="() => OpenEdit(type)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                        <button type="button" class="cty-icon-btn" title="@(type.IsActive ? "Deactivate contact type" : "Activate contact type")" @onclick="() => ConfirmToggle(type)"><i class="bi @(type.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i></button>
                                        <button type="button" class="cty-icon-btn cty-icon-btn--danger" title="Delete contact type" @onclick="() => ConfirmDelete(type)"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="cty-side-panel" aria-label="Contact type insights">
            <section class="cty-panel-card">
                <span class="cty-section-kicker">Selected type</span>
                @if (_selected is null)
                {
                    <div class="cty-empty cty-empty--compact">
                        <i class="bi bi-cursor" aria-hidden="true"></i>
                        <strong>Select a contact type</strong>
                        <span>Open details, recommendations, and quick actions.</span>
                    </div>
                }
                else
                {
                    <div class="cty-selected__title">
                        <div class="cty-avatar cty-avatar--lg" style="@AvatarStyle(_selected.TypeName)" aria-hidden="true">@Initials(_selected.TypeName)</div>
                        <div>
                            <h3>@_selected.TypeName</h3>
                            <span>@Safe(_selected.TypeCode, "No code") - @RoleGroup(_selected)</span>
                        </div>
                    </div>
                    <div class="cty-score-card @ImportanceClass(_selected)">
                        <span>Importance score</span>
                        <strong>@ImportanceScore(_selected)</strong>
                        <small>@RecommendedAction(_selected)</small>
                    </div>
                    <dl class="cty-detail-list">
                        <div><dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd></div>
                        <div><dt>Default</dt><dd>@(_selected.IsDefault ? "Yes" : "No")</dd></div>
                        <div><dt>Role group</dt><dd>@RoleGroup(_selected)</dd></div>
                        <div><dt>Sort order</dt><dd>@_selected.SortOrder</dd></div>
                        <div><dt>Created</dt><dd>@FormatDate(_selected.CreatedDateUtc)</dd></div>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_selected.Description))
                    {
                        <p class="cty-description">@_selected.Description</p>
                    }
                    <div class="cty-selected-actions">
                        <button type="button" class="cty-btn cty-btn--primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                        <button type="button" class="cty-btn cty-btn--ghost" @onclick="() => ConfirmToggle(_selected)"><i class="bi @(_selected.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i> @(_selected.IsActive ? "Deactivate" : "Activate")</button>
                    </div>
                }
            </section>

            <section class="cty-panel-card">
                <span class="cty-section-kicker">Enterprise insights</span>
                <div class="cty-insight-list">
                    <div class="cty-insight">
                        <i class="bi bi-star" aria-hidden="true"></i>
                        <div><strong>Default coverage</strong><span>@DefaultInsight</span></div>
                    </div>
                    <div class="cty-insight">
                        <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                        <div><strong>Priority roles</strong><span>@PriorityInsight</span></div>
                    </div>
                    <div class="cty-insight">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <div><strong>Workflow readiness</strong><span>@ReadinessInsight</span></div>
                    </div>
                </div>
            </section>
        </aside>
    </main>
</div>

@if (_showForm)
{
    <div class="cty-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="contact-type-form-title">
        <div class="cty-modal">
            <div class="cty-modal__header">
                <i class="bi bi-person-lines-fill" aria-hidden="true"></i>
                <span id="contact-type-form-title">@(_editId.HasValue ? "Edit Contact Type" : "Add Contact Type")</span>
                <button type="button" class="cty-icon-btn cty-icon-btn--light ms-auto" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="cty-modal__body">
                    <div class="cty-validation-note">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <div><strong>Contact role governance</strong><span>Code and name are required. Default and priority contact roles affect account intake and servicing workflows.</span></div>
                    </div>
                    <div class="cty-form-grid">
                        <label class="cty-field">
                            <span>Type Code <em>*</em></span>
                            <InputText @bind-Value="_form.TypeCode" class="form-control" placeholder="e.g. PRIMARY" />
                            <ValidationMessage For="() => _form.TypeCode" class="text-danger" />
                        </label>
                        <label class="cty-field">
                            <span>Type Name <em>*</em></span>
                            <InputText @bind-Value="_form.TypeName" class="form-control" placeholder="Primary Contact" />
                            <ValidationMessage For="() => _form.TypeName" class="text-danger" />
                        </label>
                        <label class="cty-field cty-field--wide">
                            <span>Description</span>
                            <InputTextArea @bind-Value="_form.Description" class="form-control" rows="3" placeholder="Describe when this contact type should be used." />
                            <ValidationMessage For="() => _form.Description" class="text-danger" />
                        </label>
                        <label class="cty-field">
                            <span>Sort Order</span>
                            <InputNumber @bind-Value="_form.SortOrder" class="form-control" />
                            <ValidationMessage For="() => _form.SortOrder" class="text-danger" />
                        </label>
                        <label class="cty-check-field">
                            <InputCheckbox @bind-Value="_form.IsDefault" />
                            <span>Default Type</span>
                        </label>
                        @if (_editId.HasValue)
                        {
                            <label class="cty-check-field">
                                <InputCheckbox @bind-Value="_form.IsActive" />
                                <span>Active</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="cty-modal__footer">
                    <button type="button" class="cty-btn cty-btn--ghost" @onclick="CloseForm">Cancel</button>
                    <button type="submit" class="cty-btn cty-btn--primary" disabled="@_saving">
                        @if (_saving) { <span class="cty-spin-sm"></span> }
                        @(_editId.HasValue ? "Save Changes" : "Create Type")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_confirmVisible)
{
    <div class="cty-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="contact-type-confirm-title">
        <div class="cty-confirm">
            <div class="cty-confirm__body">
                <div class="cty-confirm-icon cty-confirm-icon--danger"><i class="bi @_confirmIcon" aria-hidden="true"></i></div>
                <div>
                    <h3 id="contact-type-confirm-title">@_confirmTitle</h3>
                    <p>@_confirmMessage</p>
                </div>
            </div>
            <div class="cty-modal__footer">
                <button type="button" class="cty-btn cty-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button>
                <button type="button" class="cty-btn cty-btn--danger" @onclick="ExecuteConfirmedAsync" disabled="@_saving">
                    @if (_saving) { <span class="cty-spin-sm"></span> }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<div class="cty-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="cty-toast cty-toast--@toast.Kind">
            <i class="bi @(toast.Kind == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")" aria-hidden="true"></i>
            <span>@toast.Message</span>
            <button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
    }
</div>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    Guid TenantId { get; set; }

    readonly List<DashboardTab> _tabs =
    [
        new("all", "All", "bi-person-badge"),
        new("active", "Active", "bi-check-circle"),
        new("defaults", "Default", "bi-star"),
        new("priority", "Priority", "bi-lightning-charge"),
        new("risk", "Needs Review", "bi-exclamation-octagon"),
        new("inactive", "Inactive", "bi-slash-circle"),
        new("groups", "Role Groups", "bi-pie-chart")
    ];

    List<ContactTypeDto> _items = [];
    HashSet<Guid> _selectedIds = [];
    List<ToastItem> _toasts = [];
    ContactTypeDto? _selected;
    ContactTypeFormModel _form = new();
    Func<Task>? _confirmAction;
    Guid? _editId;
    string _activeTab = "all";
    string _searchTerm = string.Empty;
    string _groupFilter = string.Empty;
    string _statusFilter = string.Empty;
    string _sortMode = "importance";
    string _confirmTitle = string.Empty;
    string _confirmMessage = string.Empty;
    string _confirmIcon = "bi-exclamation-triangle-fill";
    string? _loadError;
    bool _loading;
    bool _saving;
    bool _showForm;
    bool _confirmVisible;
    int _page = 1;
    const int PageSize = 12;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Account Config", null), new("Contact Types", null));
        await LoadAsync();
    }

    IEnumerable<ContactTypeDto> FilteredTypes
    {
        get
        {
            IEnumerable<ContactTypeDto> query = _items;

            query = _activeTab switch
            {
                "active" => query.Where(x => x.IsActive),
                "defaults" => query.Where(x => x.IsDefault),
                "priority" => query.Where(IsPriorityContactType),
                "risk" => query.Where(NeedsReview),
                "inactive" => query.Where(x => !x.IsActive),
                _ => query
            };

            if (!string.IsNullOrWhiteSpace(_searchTerm)) query = query.Where(MatchesSearch);
            if (!string.IsNullOrWhiteSpace(_groupFilter)) query = query.Where(x => string.Equals(RoleGroup(x), _groupFilter, StringComparison.OrdinalIgnoreCase));

            query = _statusFilter switch
            {
                "Active" => query.Where(x => x.IsActive),
                "Inactive" => query.Where(x => !x.IsActive),
                "Default" => query.Where(x => x.IsDefault),
                "NeedsReview" => query.Where(NeedsReview),
                _ => query
            };

            return _sortMode switch
            {
                "order" => query.OrderBy(x => x.SortOrder).ThenBy(x => x.TypeName),
                "name" => query.OrderBy(x => x.TypeName),
                "group" => query.OrderBy(RoleGroup).ThenBy(x => x.SortOrder).ThenBy(x => x.TypeName),
                "created" => query.OrderByDescending(x => x.CreatedDateUtc),
                _ => query.OrderByDescending(ImportanceScore).ThenBy(x => x.SortOrder).ThenBy(x => x.TypeName)
            };
        }
    }

    List<ContactTypeDto> PagedTypes => FilteredTypes.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredTypes.Count() / (double)PageSize));
    bool AllPageSelected => PagedTypes.Count > 0 && PagedTypes.All(IsSelected);
    bool HasFilters => !string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_groupFilter) || !string.IsNullOrWhiteSpace(_statusFilter) || _activeTab != "all" || _sortMode != "importance";
    string ActiveViewTitle => _tabs.FirstOrDefault(x => x.Key == _activeTab)?.Label ?? "All";
    IEnumerable<string> RoleGroupOptions => RoleGroups.Select(x => x.Name);
    string DefaultInsight => _items.Count(x => x.IsDefault) switch { 0 => "No default contact type is configured. Intake may require manual role selection.", 1 => "One default contact type is configured for fallback contact creation.", var count => $"{count} default contact types exist. Review default intent." };
    string PriorityInsight => _items.Any(IsPriorityContactType) ? $"{_items.Count(IsPriorityContactType)} priority roles support primary contact, owner, decision, or billing workflows." : "No priority contact role patterns were detected.";
    string ReadinessInsight => _items.Count == 0 ? "Create contact types before enabling account contact workflows." : $"{Math.Round(_items.Count(x => x.IsActive && !NeedsReview(x)) * 100m / _items.Count)}% of contact types are active with no review flags.";

    List<RoleGroupSummary> RoleGroups => _items
        .GroupBy(RoleGroup)
        .Select(g => new RoleGroupSummary(g.Key, g.Count(), g.Count(x => x.IsActive), g.Count(x => x.IsDefault), g.Count(NeedsReview), _items.Count == 0 ? 0 : Math.Round(g.Count() * 100m / _items.Count, 0)))
        .OrderByDescending(x => x.Count)
        .ToList();

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchContactTypesAsync(TenantId, null, pageSize: 500);
            _items = result?.Items.ToList() ?? [];
            _selectedIds.RemoveWhere(id => _items.All(x => x.ContactTypeId != id));
            _selected = _selected is null ? _items.OrderByDescending(ImportanceScore).FirstOrDefault() : _items.FirstOrDefault(x => x.ContactTypeId == _selected.ContactTypeId) ?? _items.OrderByDescending(ImportanceScore).FirstOrDefault();
            NormalizePage();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load contact types: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    Task RefreshAsync() => LoadAsync();
    void ApplyFilters() { _page = 1; NormalizePage(); }
    void OnSearchInputValue(string? value) { _searchTerm = value ?? string.Empty; ApplyFilters(); }
    void SetDashboardFocus(string tab, string sort) { _activeTab = tab; _sortMode = sort; _page = 1; NormalizePage(); }
    void SetActiveTab(string tab) { _activeTab = tab; _page = 1; NormalizePage(); }
    void PreviousPage() { if (_page > 1) _page--; }
    void NextPage() { if (_page < TotalPages) _page++; }
    void NormalizePage() { if (_page > TotalPages) _page = TotalPages; }
    void SelectRow(ContactTypeDto item) => _selected = item;
    bool IsSelected(ContactTypeDto item) => _selectedIds.Contains(item.ContactTypeId);

    void ToggleSelect(ContactTypeDto item)
    {
        if (!_selectedIds.Add(item.ContactTypeId)) _selectedIds.Remove(item.ContactTypeId);
        _selected = item;
    }

    void ToggleSelectAllPageValue(bool shouldSelect)
    {
        foreach (var item in PagedTypes)
        {
            if (shouldSelect) _selectedIds.Add(item.ContactTypeId);
            else _selectedIds.Remove(item.ContactTypeId);
        }
    }

    void ClearFilters()
    {
        _searchTerm = string.Empty;
        _groupFilter = string.Empty;
        _statusFilter = string.Empty;
        _sortMode = "importance";
        _activeTab = "all";
        _page = 1;
    }

    void FilterByGroup(string group)
    {
        _activeTab = "all";
        _groupFilter = group;
        _sortMode = "importance";
        _page = 1;
    }

    void OpenCreate()
    {
        _editId = null;
        _form = new() { IsActive = true, SortOrder = NextSortOrder() };
        _showForm = true;
    }

    void OpenEdit(ContactTypeDto item)
    {
        _selected = item;
        _editId = item.ContactTypeId;
        _form = new()
        {
            TypeCode = item.TypeCode,
            TypeName = item.TypeName,
            Description = item.Description,
            IsDefault = item.IsDefault,
            IsActive = item.IsActive,
            SortOrder = item.SortOrder
        };
        _showForm = true;
    }

    void CloseForm() { _showForm = false; ResetForm(); }
    void ResetForm() { _form = new(); _editId = null; }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue)
            {
                await Api.UpdateContactTypeAsync(_editId.Value, new(_form.TypeCode.Trim(), _form.TypeName.Trim(), NormalizeNullable(_form.Description), _form.IsDefault, _form.IsActive, _form.SortOrder));
            }
            else
            {
                await Api.CreateContactTypeAsync(new(TenantId, _form.TypeCode.Trim(), _form.TypeName.Trim(), NormalizeNullable(_form.Description), _form.IsDefault, _form.SortOrder));
            }

            _showForm = false;
            ShowToast("success", _editId.HasValue ? "Contact type updated successfully." : "Contact type created successfully.");
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast("danger", $"Save failed: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    void ConfirmToggle(ContactTypeDto item)
    {
        var enable = !item.IsActive;
        OpenConfirm(enable ? "Activate Contact Type" : "Deactivate Contact Type", $"Are you sure you want to {(enable ? "activate" : "deactivate")} {item.TypeName}? This changes availability for contact workflows.", "bi-shield-exclamation", () => SetTypeActiveAsync(item, enable));
    }

    void ConfirmDelete(ContactTypeDto item) => OpenConfirm("Delete Contact Type", $"Are you sure you want to delete {item.TypeName}? This action cannot be undone.", "bi-trash3-fill", () => DeleteTypeAsync(item));
    void ConfirmBulkToggle(bool enable) => OpenConfirm(enable ? "Activate Selected Types" : "Deactivate Selected Types", $"Are you sure you want to {(enable ? "activate" : "deactivate")} {_selectedIds.Count} selected contact type(s)?", "bi-shield-exclamation", () => BulkSetActiveAsync(enable));
    void ConfirmBulkDelete() => OpenConfirm("Delete Selected Types", $"Are you sure you want to delete {_selectedIds.Count} selected contact type(s)? This action cannot be undone.", "bi-trash3-fill", BulkDeleteAsync);

    void OpenConfirm(string title, string message, string icon, Func<Task> action)
    {
        _confirmTitle = title;
        _confirmMessage = message;
        _confirmIcon = icon;
        _confirmAction = action;
        _confirmVisible = true;
    }

    void CloseConfirm() { _confirmVisible = false; _confirmAction = null; }

    async Task ExecuteConfirmedAsync()
    {
        if (_confirmAction is null) return;
        _saving = true;
        try
        {
            await _confirmAction();
            _confirmVisible = false;
            _confirmAction = null;
        }
        finally
        {
            _saving = false;
        }
    }

    async Task SetTypeActiveAsync(ContactTypeDto item, bool active)
    {
        try
        {
            await Api.UpdateContactTypeAsync(item.ContactTypeId, new(item.TypeCode, item.TypeName, item.Description, item.IsDefault, active, item.SortOrder));
            ShowToast("success", active ? "Contact type activated." : "Contact type deactivated.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast("danger", $"Update failed: {ex.Message}");
        }
    }

    async Task DeleteTypeAsync(ContactTypeDto item)
    {
        try
        {
            await Api.DeleteContactTypeAsync(item.ContactTypeId);
            _selectedIds.Remove(item.ContactTypeId);
            if (_selected?.ContactTypeId == item.ContactTypeId) _selected = null;
            ShowToast("success", "Contact type deleted.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast("danger", $"Delete failed: {ex.Message}");
        }
    }

    async Task BulkSetActiveAsync(bool active)
    {
        var selected = _items.Where(x => _selectedIds.Contains(x.ContactTypeId)).ToList();
        var updated = 0;
        foreach (var item in selected)
        {
            try
            {
                await Api.UpdateContactTypeAsync(item.ContactTypeId, new(item.TypeCode, item.TypeName, item.Description, item.IsDefault, active, item.SortOrder));
                updated++;
            }
            catch (Exception ex)
            {
                ShowToast("danger", $"Update failed for {item.TypeName}: {ex.Message}");
            }
        }

        ShowToast("success", $"{updated} contact type(s) {(active ? "activated" : "deactivated")}.");
        _selectedIds.Clear();
        await LoadAsync();
    }

    async Task BulkDeleteAsync()
    {
        var selected = _items.Where(x => _selectedIds.Contains(x.ContactTypeId)).ToList();
        var deleted = 0;
        foreach (var item in selected)
        {
            try
            {
                await Api.DeleteContactTypeAsync(item.ContactTypeId);
                deleted++;
            }
            catch (Exception ex)
            {
                ShowToast("danger", $"Delete failed for {item.TypeName}: {ex.Message}");
            }
        }

        ShowToast("success", $"{deleted} contact type(s) deleted.");
        _selectedIds.Clear();
        _selected = null;
        await LoadAsync();
    }

    RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string color) => @<button type="button" class="cty-kpi-card cty-kpi-card--@color @(_activeTab == key ? "cty-kpi-card--active" : null)" title="@subtitle" @onclick="() => SetActiveTab(key)">
        <span class="cty-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span>
        <span class="cty-kpi-body"><span class="cty-kpi-label">@label</span><strong class="cty-kpi-value">@value</strong><span class="cty-kpi-sub">@subtitle</span></span>
    </button>;

    int TabCount(string key) => key switch
    {
        "active" => _items.Count(x => x.IsActive),
        "defaults" => _items.Count(x => x.IsDefault),
        "priority" => _items.Count(IsPriorityContactType),
        "risk" => _items.Count(NeedsReview),
        "inactive" => _items.Count(x => !x.IsActive),
        "groups" => RoleGroups.Count,
        _ => _items.Count
    };

    bool MatchesSearch(ContactTypeDto item)
    {
        var term = _searchTerm.Trim();
        return Contains(item.TypeCode, term) || Contains(item.TypeName, term) || Contains(item.Description, term) || Contains(RoleGroup(item), term);
    }

    static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string? NormalizeNullable(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    static string FormatDate(DateTime date) => date == default ? "-" : date.ToLocalTime().ToString("MMM d, yyyy");
    static bool NeedsReview(ContactTypeDto item) => !item.IsActive || (item.IsDefault && !item.IsActive) || string.IsNullOrWhiteSpace(item.TypeCode) || string.IsNullOrWhiteSpace(item.TypeName) || string.IsNullOrWhiteSpace(item.Description);
    static bool IsPriorityContactType(ContactTypeDto item) => Contains(item.TypeCode, "PRIMARY") || Contains(item.TypeName, "Primary") || Contains(item.TypeName, "Decision") || Contains(item.TypeName, "Owner") || Contains(item.TypeName, "Billing") || Contains(item.TypeName, "Authorized") || Contains(item.Description, "primary") || Contains(item.Description, "decision") || Contains(item.Description, "billing");

    static string RoleGroup(ContactTypeDto item)
    {
        if (item.IsDefault) return "Default";
        if (IsPriorityContactType(item)) return "Priority";
        if (!item.IsActive) return "Inactive";
        if (Contains(item.TypeName, "Billing") || Contains(item.TypeCode, "BILL")) return "Billing";
        if (Contains(item.TypeName, "Decision") || Contains(item.TypeName, "Owner") || Contains(item.TypeName, "Authorized")) return "Decision";
        return "Standard";
    }

    static string RoleGroupBadgeClass(ContactTypeDto item) => RoleGroup(item) switch
    {
        "Default" => "cty-pill--amber",
        "Priority" => "cty-pill--purple",
        "Billing" => "cty-pill--cyan",
        "Decision" => "cty-pill--blue",
        "Inactive" => "cty-pill--neutral",
        _ => "cty-pill--green"
    };

    static string RoleGroupIcon(string group) => group switch
    {
        "Default" => "bi-star",
        "Priority" => "bi-lightning-charge",
        "Billing" => "bi-receipt",
        "Decision" => "bi-person-check",
        "Inactive" => "bi-slash-circle",
        _ => "bi-person-badge"
    };

    static int ImportanceScore(ContactTypeDto item)
    {
        var score = 35;
        if (item.IsDefault) score += 24;
        if (IsPriorityContactType(item)) score += 22;
        if (item.IsActive) score += 12; else score += 18;
        if (item.SortOrder <= 10) score += 8;
        if (string.IsNullOrWhiteSpace(item.Description)) score += 10;
        return Math.Clamp(score, 0, 100);
    }

    static string RecommendedAction(ContactTypeDto item)
    {
        if (item.IsDefault && !item.IsActive) return "Activate or replace inactive default contact type.";
        if (!item.IsActive) return "Review whether this contact type should remain inactive.";
        if (string.IsNullOrWhiteSpace(item.Description)) return "Add usage guidance for account servicing teams.";
        return "Configuration is ready for account contact workflows.";
    }

    static string ImportanceClass(ContactTypeDto item) => ImportanceScore(item) switch
    {
        >= 80 => "cty-score-card--red",
        >= 65 => "cty-score-card--amber",
        >= 45 => "cty-score-card--cyan",
        _ => "cty-score-card--green"
    };

    static MarkupString ImportanceBadge(ContactTypeDto item)
    {
        var score = ImportanceScore(item);
        var css = score switch { >= 80 => "red", >= 65 => "amber", >= 45 => "cyan", _ => "green" };
        return new($"<span class=\"cty-risk-badge cty-risk-badge--{css}\">{score}</span>");
    }

    static string Initials(string? value)
    {
        var parts = (value ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => "CT",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0])))
        };
    }

    static string AvatarStyle(string? value)
    {
        var hash = Math.Abs((value ?? "ContactType").GetHashCode());
        var hue = hash % 360;
        return $"background:linear-gradient(135deg,hsl({hue},78%,48%),hsl({(hue + 35) % 360},82%,36%));";
    }

    int NextSortOrder() => _items.Count == 0 ? 10 : _items.Max(x => x.SortOrder) + 10;

    void ShowToast(string kind, string message)
    {
        _toasts.Insert(0, new(Guid.NewGuid(), kind, message));
        if (_toasts.Count > 4) _toasts.RemoveRange(4, _toasts.Count - 4);
    }

    void DismissToast(Guid id) => _toasts.RemoveAll(x => x.Id == id);

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }

    sealed class ContactTypeFormModel
    {
        [Required, StringLength(50)] public string TypeCode { get; set; } = string.Empty;
        [Required, StringLength(100)] public string TypeName { get; set; } = string.Empty;
        [StringLength(500)] public string? Description { get; set; }
        public bool IsDefault { get; set; }
        [Range(0, 9999)] public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
    }

    sealed record DashboardTab(string Key, string Label, string Icon);
    sealed record RoleGroupSummary(string Name, int Count, int Active, int DefaultCount, int ReviewCount, decimal Percent);
    sealed record ToastItem(Guid Id, string Kind, string Message);
}
