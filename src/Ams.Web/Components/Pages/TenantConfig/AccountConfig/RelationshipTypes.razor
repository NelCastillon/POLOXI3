@page "/tenant/accounts/rel-types"
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Relationship Types — Account Configuration</PageTitle>

<AppPageHeader Title="Relationship Types"
               Subtitle="Define how accounts and contacts relate to each other"
               Icon="bi-link-45deg">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Type
        </button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
    </Actions>
</AppPageHeader>

<div class="pc-kpi-strip">
    <div class="pc-kpi-card @(_activeFilter == "" ? "pc-kpi-card--active" : "")"
         title="Show all relationship types" @onclick='() => SetFilter("")' style="cursor:pointer">
        <span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-diagram-3-fill" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total Types</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "active" ? "pc-kpi-card--active" : "")"
         title="Filter active types" @onclick='() => SetFilter("active")' style="cursor:pointer">
        <span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.IsActive)</div><div class="pc-kpi-label">Active</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "bidirectional" ? "pc-kpi-card--active" : "")"
         title="Filter bidirectional types" @onclick='() => SetFilter("bidirectional")' style="cursor:pointer">
        <span class="pc-kpi-icon" style="background:#dbeafe"><i class="bi bi-arrow-left-right text-primary" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.IsBidirectional)</div><div class="pc-kpi-label">Bidirectional</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "oneway" ? "pc-kpi-card--active" : "")"
         title="Filter one-way types" @onclick='() => SetFilter("oneway")' style="cursor:pointer">
        <span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-arrow-right" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => !x.IsBidirectional)</div><div class="pc-kpi-label">One-way</div></div>
    </div>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

<AppFilterPanel @bind-SearchValue="_search" OnSearch="OnSearchAsync" SearchPlaceholder="Search relationship type…" />

<div class="um-grid-card">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }
    <SfGrid TValue="RelationshipTypeDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
        <GridEvents TValue="RelationshipTypeDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" />
        <GridColumns>
            <GridColumn Field="TypeCode" HeaderText="Code" Width="130" />
            <GridColumn Field="TypeName" HeaderText="Type Name" Width="200" />
            <GridColumn Field="IsBidirectional" HeaderText="Bidirectional" Width="130" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (RelationshipTypeDto)context; }
                    @if (r.IsBidirectional) { <i class="bi bi-arrow-left-right text-primary"></i> } else { <i class="bi bi-arrow-right text-muted"></i> }
                </Template>
            </GridColumn>
            <GridColumn Field="InverseTypeCode" HeaderText="Inverse" Width="120" />
            <GridColumn Field="IsActive" HeaderText="Status" Width="100" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (RelationshipTypeDto)context; }
                    <span class="um-badge @(r.IsActive ? "um-badge-success" : "um-badge-neutral")">@(r.IsActive ? "Active" : "Inactive")</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="100" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (RelationshipTypeDto)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEdit(r)"><i class="bi bi-pencil"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(r)"><i class="bi bi-trash"></i></button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showForm" Width="520px" IsModal="true" ShowCloseIcon="false">
    <DialogEvents Closed="ResetForm" />
    <DialogContent>
        <div class="um-modal-header">
            <i class="bi bi-link-45deg" aria-hidden="true"></i>
            <span>@(_editId.HasValue ? "Edit Relationship Type" : "Add Relationship Type")</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button>
        </div>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="um-field">
                        <label>Type Code <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.TypeCode" class="um-input" placeholder="e.g. PARENT_CO" />
                        <ValidationMessage For="() => _form.TypeCode" class="validation-message text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Type Name <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.TypeName" class="um-input" />
                        <ValidationMessage For="() => _form.TypeName" class="validation-message text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Inverse Type Code</label>
                        <InputText @bind-Value="_form.InverseTypeCode" class="um-input" placeholder="e.g. SUBSIDIARY" />
                        <ValidationMessage For="() => _form.InverseTypeCode" class="validation-message text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Description</label>
                        <InputTextArea @bind-Value="_form.Description" class="um-input" rows="2" />
                        <ValidationMessage For="() => _form.Description" class="validation-message text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Sort Order</label>
                        <InputNumber @bind-Value="_form.SortOrder" class="um-input" />
                        <ValidationMessage For="() => _form.SortOrder" class="validation-message text-danger" />
                    </div>
                    <div class="um-field um-field--checkbox">
                        <label><InputCheckbox @bind-Value="_form.IsBidirectional" /> Bidirectional</label>
                    </div>
                    <div class="um-field um-field--checkbox">
                        <label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label>
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button>
            </div>
        </EditForm>
    </DialogContent>
</SfDialog>

<SfDialog @bind-Visible="_showDelete" Width="420px" IsModal="true" ShowCloseIcon="false">
    <DialogContent>
        <div class="um-confirm-dialog">
            <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash3-fill"></i></div>
            <div class="um-confirm-title">Delete Relationship Type</div>
            <div class="um-confirm-body">Are you sure you want to delete <strong>@_deleteTarget?.TypeName</strong>? This action cannot be undone.</div>
            <div class="um-modal-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button>
            </div>
        </div>
    </DialogContent>
</SfDialog>

<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true"><ToastPosition X="Right" Y="Bottom" /></SfToast>

<style>
    .validation-message {
        display: flex;
        align-items: center;
        gap: .45rem;
        margin-top: .55rem;
        color: #dc3545 !important;
        font-size: .875rem;
        font-weight: 700;
    }
    .validation-message::before {
        content: "!";
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1rem;
        height: 1rem;
        min-width: 1rem;
        flex-shrink: 0;
        border-radius: 999px;
        color: #fff;
        background: linear-gradient(135deg, #ef4444, #b91c1c);
        font-size: .7rem;
        font-weight: 800;
    }
    .um-input.modified.invalid {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 .18rem rgba(220,53,69,.14) !important;
    }
</style>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    Guid TenantId { get; set; }
    List<RelationshipTypeDto> _items = [];
    List<RelationshipTypeDto> _filtered = [];
    string _activeFilter = "";
    bool _loading, _saving;
    string _search = string.Empty;
    string? _loadError;
    bool _showForm, _showDelete;
    Guid? _editId;
    RelationshipTypeDto? _deleteTarget;
    SfToast _toast = default!;
    RelTypeFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Account Config", null), new("Relationship Types", null));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var r = await Api.SearchRelationshipTypesAsync(TenantId, _search, pageSize: 200);
            _items = r?.Items.ToList() ?? [];
            ApplyFilter();
        }
        catch (Exception ex) { _loadError = ex.Message; }
        finally { _loading = false; }
    }

    void SetFilter(string filter) { _activeFilter = filter; ApplyFilter(); }

    void ApplyFilter()
    {
        _filtered = _activeFilter switch
        {
            "active"        => _items.Where(x => x.IsActive).ToList(),
            "bidirectional" => _items.Where(x => x.IsBidirectional).ToList(),
            "oneway"        => _items.Where(x => !x.IsBidirectional).ToList(),
            _               => [.. _items]
        };
    }

    Task OnSearchAsync() => LoadAsync();

    void OnRowSelected(RowSelectEventArgs<RelationshipTypeDto> args) => OpenEdit(args.Data);

    void OpenCreate() { _editId = null; _form = new(); _showForm = true; }

    void OpenEdit(RelationshipTypeDto item)
    {
        _editId = item.RelationshipTypeId;
        _form = new() { TypeCode = item.TypeCode, TypeName = item.TypeName, IsBidirectional = item.IsBidirectional, InverseTypeCode = item.InverseTypeCode, Description = item.Description, SortOrder = item.SortOrder, IsActive = item.IsActive };
        _showForm = true;
    }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue)
                await Api.UpdateRelationshipTypeAsync(_editId.Value, new(_form.TypeCode, _form.TypeName, _form.IsBidirectional, _form.InverseTypeCode, _form.Description, _form.IsActive, _form.SortOrder));
            else
                await Api.CreateRelationshipTypeAsync(new(TenantId, _form.TypeCode, _form.TypeName, _form.IsBidirectional, _form.InverseTypeCode, _form.Description, _form.SortOrder));
            _showForm = false;
            await _toast.ShowAsync(new() { Content = "Saved successfully", CssClass = "e-toast-success" });
            await LoadAsync();
        }
        catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); }
        finally { _saving = false; }
    }

    void ConfirmDelete(RelationshipTypeDto item) { _deleteTarget = item; _showDelete = true; }

    async Task ExecuteDeleteAsync()
    {
        _saving = true;
        try
        {
            await Api.DeleteRelationshipTypeAsync(_deleteTarget!.RelationshipTypeId);
            _showDelete = false;
            await _toast.ShowAsync(new() { Content = "Deleted successfully", CssClass = "e-toast-success" });
            await LoadAsync();
        }
        catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" }); }
        finally { _saving = false; }
    }

    void ResetForm() { _form = new(); _editId = null; }

    sealed class RelTypeFormModel
    {
        [Required, StringLength(50)]  public string  TypeCode        { get; set; } = string.Empty;
        [Required, StringLength(100)] public string  TypeName        { get; set; } = string.Empty;
        public bool    IsBidirectional  { get; set; }
        [StringLength(50)]  public string? InverseTypeCode { get; set; }
        [StringLength(500)] public string? Description     { get; set; }
        [Range(0, 9999)] public int SortOrder       { get; set; }
        public bool    IsActive         { get; set; } = true;
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
