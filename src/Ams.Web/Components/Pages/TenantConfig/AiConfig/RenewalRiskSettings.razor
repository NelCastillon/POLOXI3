    private sealed record ViewTab(string Id, string Label, string Icon);
    private sealed record WorkflowLink(string Title, string Text, string Url, string Icon);
    private sealed record AnalyticsSeed(string Label, int Count, string Tone);
    private sealed record AnalyticsRow(string Label, int Count, string Tone, decimal Percent, decimal WidthPercent);
    private sealed class RenewalRiskVm { public Guid AiConfigItemId { get; set; } public string Code { get; set; } = string.Empty; public string Name { get; set; } = string.Empty; public string CategoryLabel { get; set; } = "Core"; public string? Description { get; set; } public string DescriptionText { get; set; } = string.Empty; public string ConfigurationJson { get; set; } = "{}"; public bool IsActive { get; set; } public int SortOrder { get; set; } public DateTime CreatedDateUtc { get; set; } public string RolloutLabel { get; set; } = "General"; public string WorkflowLabel { get; set; } = "Core"; public string WorkflowUrl { get; set; } = "/tenant/ai/renewal-risk"; public string LimitLabel { get; set; } = "No limit"; }
