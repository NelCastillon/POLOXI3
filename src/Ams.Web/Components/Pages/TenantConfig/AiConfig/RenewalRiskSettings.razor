@page "/tenant/ai/renewal-risk"
@namespace Ams.Web.Components.Pages.TenantConfig.AiConfig
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text.Json
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.AiConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Renewal Risk AI</PageTitle>

@if (_toastVisible)
{
    <div class="air-toast air-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="air-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="air-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="air-risk-modal" role="dialog" aria-modal="true" aria-labelledby="aiRiskControlFormTitle" @onclick:stopPropagation="true">
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="air-modal-header">
                    <div class="air-modal-title">
                        <span class="air-modal-icon"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></span>
                        <div>
                            <h2 id="aiRiskControlFormTitle">@(_editId.HasValue ? "Edit renewal risk control" : "Add renewal risk control")</h2>
                            <p>Configure signal weights, thresholds, alerting, governance, and retention-risk workflow controls.</p>
                        </div>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_saving"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="air-modal-body">
                    <div class="air-form-banner">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <div>
                            <strong>Tenant Admin scoped AI control</strong>
                            <span>Changes are saved to AI.AiConfigItem for this tenant and reflected in renewal risk workflows.</span>
                        </div>
                    </div>
                    <div class="air-form-grid">
                        <div class="air-field">
                            <label for="airCode">Code <span>*</span></label>
                            <InputText id="airCode" class="air-input" @bind-Value="_form.Code" />
                        </div>
                        <div class="air-field">
                            <label for="airName">Name <span>*</span></label>
                            <InputText id="airName" class="air-input" @bind-Value="_form.Name" />
                        </div>
                        <div class="air-field">
                            <label for="airCategory">Category <span>*</span></label>
                            <InputSelect id="airCategory" class="air-input" @bind-Value="_form.Category">
                                @foreach (var category in _categoryOptions)
                                {
                                    <option value="@category">@category</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="air-field">
                            <label for="airSortOrder">Sort order</label>
                            <InputNumber id="airSortOrder" class="air-input" @bind-Value="_form.SortOrder" />
                        </div>
                        <div class="air-field air-field-wide">
                            <label for="airDescription">Description</label>
                            <InputTextArea id="airDescription" class="air-input" rows="3" @bind-Value="_form.Description" />
                        </div>
                        <div class="air-field air-field-wide">
                            <label for="airConfiguration">Configuration JSON</label>
                            <InputTextArea id="airConfiguration" class="air-input air-code-input" rows="8" @bind-Value="_form.ConfigurationJson" />
                        </div>
                        <div class="air-field air-check-row">
                            <label><InputCheckbox @bind-Value="_form.IsActive" /> Active risk control</label>
                        </div>
                    </div>
                </div>
                <div class="air-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_saving">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(_editId.HasValue ? "Save changes" : "Create risk control")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showDelete)
{
    <div class="air-modal-backdrop" role="presentation" @onclick="CancelDelete">
        <div class="air-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="deleteRiskControlTitle" @onclick:stopPropagation="true">
            <div class="air-confirm-icon air-confirm-danger"><i class="bi bi-trash3-fill" aria-hidden="true"></i></div>
            <h2 id="deleteRiskControlTitle">Delete renewal risk control?</h2>
            <p>Delete <strong>@_deleteTarget?.Name</strong>? This removes the risk setting from active tenant AI workflows.</p>
            <div class="air-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CancelDelete" disabled="@_saving">Cancel</button>
                <button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button>
            </div>
        </div>
    </div>
}

<div class="air-enterprise-page">
    <section class="air-hero">
        <div class="air-hero-left">
            <span class="air-hero-icon"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></span>
            <div>
                <div class="air-title-row">
                    <h1>Renewal Risk AI</h1>
                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> Tenant Admin User</span>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live AI configuration</span>
                </div>
                <p>Manage renewal risk scoring signals, thresholds, alerts, service/payment/claims workflow sync, and Tenant Admin governance.</p>
            </div>
        </div>
        <div class="air-hero-actions">
            <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_loading" title="Refresh renewal risk settings"><i class="bi @(_loading ? "bi-arrow-repeat air-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-ghost" type="button" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button class="um-btn um-btn-ghost" type="button" @onclick='() => Nav.NavigateTo("/tenant/ai/features")'><i class="bi bi-grid-1x2" aria-hidden="true"></i> AI Center</button>
            <button class="um-btn um-btn-primary" type="button" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Risk Control</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger air-error-banner" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="air-kpi-strip" aria-label="renewal risk KPI filters">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" @onclick="() => SetFilter(metric.Filter)" title="@metric.Tooltip" aria-pressed="@(metric.Filter == _activeFilter)">
                <span class="air-kpi-icon @metric.Tone"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <div>
                    <span class="air-kpi-val">@metric.Value</span>
                    <span class="air-kpi-lbl">@metric.Label</span>
                    <small>@metric.Caption</small>
                </div>
            </button>
        }
    </section>

    <section class="air-workflow-strip" aria-label="AI settings workflows">
        @foreach (var workflow in _workflows)
        {
            <button type="button" class="air-workflow-card" @onclick="() => OpenWorkflow(workflow)">
                <i class="bi @workflow.Icon" aria-hidden="true"></i>
                <span><strong>@workflow.Title</strong><span>@workflow.Text</span></span>
            </button>
        }
    </section>

    <section class="air-search-panel" aria-label="renewal risk filters">
        <div class="air-search-wrap">
            <span class="air-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="air-search-body">
                <label for="aiRiskControlSearch">Search renewal risk controls</label>
                <input id="aiRiskControlSearch" class="air-search-input" value="@_search" @oninput="OnSearchChanged" placeholder="Search code, name, category, workflow, or JSON..." />
                <span class="air-search-hint">Filters apply instantly to the active tab and KPI selection.</span>
            </div>
        </div>
        <select class="air-filter-select" value="@_categoryFilter" @onchange="OnCategoryChanged" aria-label="Category filter">
            <option value="">All categories</option>
            @foreach (var category in Categories)
            {
                <option value="@category">@category</option>
            }
        </select>
        <select class="air-filter-select" value="@_activeFilter" @onchange="OnStatusChanged" aria-label="Status filter">
            <option value="">All statuses</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
            <option value="guardrail">Guardrails</option>
            <option value="pilot">Pilot</option>
        </select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-circle" aria-hidden="true"></i> Reset</button>
        <div class="air-search-result"><strong>@FilteredItems.Count</strong><span>shown</span></div>
    </section>

    <div class="air-view-tabs" role="tablist" aria-label="renewal risk views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="@TabClass(tab.Id)" role="tab" aria-selected="@(tab.Id == _activeTab)" @onclick="() => SetTab(tab.Id)"><i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label <span>@TabCount(tab.Id)</span></button>
        }
    </div>

    <section class="air-content-layout">
        <main class="air-main-card">
            @if (_loading)
            {
                <div class="air-loading"><i class="bi bi-arrow-repeat air-spin" aria-hidden="true"></i><strong>Loading renewal risk controls...</strong><span>Syncing tenant AI configuration, scoring signals, and workflow readiness.</span></div>
            }
            else if (_activeTab == "board")
            {
                <div class="air-board">
                    @foreach (var category in BoardCategories)
                    {
                        <section class="air-board-col">
                            <header><span>@category</span><strong>@FilteredItems.Count(x => x.CategoryLabel == category)</strong></header>
                            @foreach (var item in FilteredItems.Where(x => x.CategoryLabel == category))
                            {
                                @RiskCard(item)
                            }
                        </section>
                    }
                </div>
            }
            else if (_activeTab == "governance")
            {
                <div class="air-governance-grid">
                    @foreach (var item in FilteredItems.Where(IsGovernanceRisk))
                    {
                        @RiskCard(item)
                    }
                    @if (!FilteredItems.Any(IsGovernanceRisk))
                    {
                        @EmptyState("bi-shield-check", "No governance renewal risk controls match", "Adjust filters or add safety, approval, or audit controls.")
                    }
                </div>
            }
            else if (_activeTab == "analytics")
            {
                <div class="air-analytics-grid">
                    <section><h3>Category distribution</h3>@foreach (var row in CategoryDistribution) { @AnalyticsRowTemplate(row) }</section>
                    <section><h3>Rollout status</h3>@foreach (var row in StatusDistribution) { @AnalyticsRowTemplate(row) }</section>
                    <section><h3>Workflow readiness</h3>@foreach (var row in WorkflowDistribution) { @AnalyticsRowTemplate(row) }</section>
                    <section><h3>Governance coverage</h3>@foreach (var row in GovernanceDistribution) { @AnalyticsRowTemplate(row) }</section>
                </div>
            }
            else
            {
                <div class="air-table-scroll">
                    @if (FilteredItems.Count == 0)
                    {
                        @EmptyState("bi-arrow-clockwise", "No renewal risk controls match", "Adjust filters, refresh the page, or add a new renewal risk setting.")
                    }
                    else
                    {
                        <table class="air-table">
                            <thead><tr><th>Risk Control</th><th>Category</th><th>Status</th><th>Rollout</th><th>Limits</th><th>Workflow</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var item in FilteredItems)
                                {
                                    <tr class="@(SelectedItem?.AiConfigItemId == item.AiConfigItemId ? "air-row-selected" : string.Empty)" @onclick="() => SelectItem(item)">
                                        <td><div class="air-name-cell"><span class="air-avatar @AvatarClass(item)"><i class="bi @RiskIcon(item)" aria-hidden="true"></i></span><div><strong>@item.Name</strong><small>@item.Code</small></div></div></td>
                                        <td><span class="air-lob">@item.CategoryLabel</span></td>
                                        <td><span class="@StatusBadge(item)">@(item.IsActive ? "Active" : "Inactive")</span></td>
                                        <td>@item.RolloutLabel</td>
                                        <td>@item.LimitLabel</td>
                                        <td><span class="@WorkflowBadge(item)">@item.WorkflowLabel</span></td>
                                        <td><div class="air-row-actions" @onclick:stopPropagation="true"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ToggleActiveAsync(item)" title="@(item.IsActive ? "Disable" : "Enable")"><i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDelete(item)" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            }
        </main>

        <aside class="air-detail-card">
            @if (SelectedItem is not null)
            {
                <div class="air-detail-head">
                    <div><span class="air-detail-eyebrow"><i class="bi @RiskIcon(SelectedItem)" aria-hidden="true"></i> @SelectedItem.CategoryLabel</span><h2>@SelectedItem.Name</h2><p>@SelectedItem.Code - @SelectedItem.CreatedDateUtc.ToString("MMM d, yyyy", CultureInfo.CurrentCulture)</p></div>
                    <span class="@StatusBadge(SelectedItem)">@(SelectedItem.IsActive ? "Active" : "Inactive")</span>
                </div>
                <div class="air-detail-body">
                    <div class="air-detail-summary">
                        <div><span>Rollout</span><strong>@SelectedItem.RolloutLabel</strong></div>
                        <div><span>Workflow</span><strong>@SelectedItem.WorkflowLabel</strong></div>
                        <div><span>Daily limit</span><strong>@SelectedItem.LimitLabel</strong></div>
                        <div><span>Sort order</span><strong>@SelectedItem.SortOrder</strong></div>
                    </div>
                    <div class="air-contact-card"><strong>Configuration summary</strong><span>@SelectedItem.DescriptionText</span></div>
                    <div class="air-json-card"><strong>Configuration JSON</strong><pre>@SelectedItem.ConfigurationJson</pre></div>
                    <div class="air-detail-actions">
                        <div class="air-detail-actions-row">
                            <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenEdit(SelectedItem)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                            <button type="button" class="um-btn um-btn-ghost" @onclick="() => DuplicateRisk(SelectedItem)"><i class="bi bi-copy" aria-hidden="true"></i> Duplicate</button>
                            <button type="button" class="um-btn um-btn-ghost" @onclick="() => ToggleActiveAsync(SelectedItem)"><i class="bi @(SelectedItem.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i> @(SelectedItem.IsActive ? "Disable" : "Enable")</button>
                        </div>
                        <button type="button" class="um-btn um-btn-primary air-detail-open-btn" @onclick="OpenRelatedSettings"><i class="bi bi-diagram-3" aria-hidden="true"></i> Open related AI workflow</button>
                    </div>
                </div>
            }
            else
            {
                <div class="air-detail-empty"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i><strong>Select a renewal risk control</strong><span>Review rollout, governance, workflow readiness, and configuration JSON.</span></div>
            }
        </aside>
    </section>
</div>

@code {
    private const string RiskKind = "RenewalRiskSetting";
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading;
    private bool _saving;
    private bool _showForm;
    private bool _showDelete;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string _search = string.Empty;
    private string _activeFilter = string.Empty;
    private string _categoryFilter = string.Empty;
    private string _activeTab = "list";
    private string? _loadError;
    private Guid? _editId;
    private RenewalRiskVm? _deleteTarget;
    private List<AiConfigItemDto> _items = [];
    private RenewalRiskVm? _selectedItem;
    private FormModel _form = new();

    private readonly string[] _categoryOptions = ["Signal Weights", "Thresholds", "Alerts", "Service", "Billing", "Claims", "Governance", "Automation"];
    private readonly List<ViewTab> _tabs = [new("list", "List", "bi-list-ul"), new("board", "Board", "bi-kanban"), new("governance", "Governance", "bi-shield-check"), new("analytics", "Analytics", "bi-bar-chart")];
    private readonly List<WorkflowLink> _workflows = [new("Signal Model", "Service, payment, claims, activity, and renewal signals", "/tenant/ai/renewal-risk", "bi-diagram-3"), new("Threshold Alerts", "At-risk routing and Tenant Admin review controls", "/tenant/ai/renewal-risk", "bi-bell"), new("Next Best Action", "Producer and service follow-up recommendations", "/tenant/ai/nba", "bi-lightning-charge"), new("Usage Monitoring", "Risk scoring volume, limits, and audit readiness", "/tenant/ai/usage", "bi-speedometer2")];

    private string ToastIconClass => _toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill";
    private List<RenewalRiskVm> AllRisks => _items.Select(MapRisk).ToList();
    private List<RenewalRiskVm> FilteredItems => AllRisks.Where(MatchesFilters).OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToList();
    private RenewalRiskVm? SelectedItem => _selectedItem is null ? FilteredItems.FirstOrDefault() : FilteredItems.FirstOrDefault(x => x.AiConfigItemId == _selectedItem.AiConfigItemId) ?? FilteredItems.FirstOrDefault();
    private IEnumerable<string> Categories => AllRisks.Select(x => x.CategoryLabel).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x);
    private IEnumerable<string> BoardCategories => Categories.Any() ? Categories : _categoryOptions;
    private IReadOnlyList<KpiMetric> Metrics => [new("", "Total", AllRisks.Count.ToString("N0"), "All risk controls", "bi-arrow-clockwise", "air-blue", "Show all renewal risk settings"), new("active", "Active", AllRisks.Count(x => x.IsActive).ToString("N0"), "Enabled for scoring", "bi-check-circle-fill", "air-green", "Show active risk settings"), new("inactive", "Inactive", AllRisks.Count(x => !x.IsActive).ToString("N0"), "Disabled controls", "bi-pause-circle", "air-muted", "Show inactive risk settings"), new("guardrail", "Guardrails", AllRisks.Count(IsGovernanceRisk).ToString("N0"), "Review and audit", "bi-shield-check", "air-red", "Show governance risk controls"), new("pilot", "Pilot", AllRisks.Count(x => x.RolloutLabel.Contains("Pilot", StringComparison.OrdinalIgnoreCase)).ToString("N0"), "Pilot scoring", "bi-rocket-takeoff", "air-purple", "Show pilot risk settings"), new("limits", "Limited", AllRisks.Count(x => !x.LimitLabel.Equals("No limit", StringComparison.OrdinalIgnoreCase)).ToString("N0"), "Usage limits set", "bi-speedometer2", "air-amber", "Show limited risk settings")];
    private IReadOnlyList<AnalyticsRow> CategoryDistribution => BuildAnalytics(AllRisks.GroupBy(x => x.CategoryLabel).Select(g => new AnalyticsSeed(g.Key, g.Count(), "air-dist-blue")));
    private IReadOnlyList<AnalyticsRow> StatusDistribution => BuildAnalytics([new("Active", AllRisks.Count(x => x.IsActive), "air-dist-green"), new("Inactive", AllRisks.Count(x => !x.IsActive), "air-dist-amber")]);
    private IReadOnlyList<AnalyticsRow> WorkflowDistribution => BuildAnalytics(AllRisks.GroupBy(x => x.WorkflowLabel).Select(g => new AnalyticsSeed(g.Key, g.Count(), "air-dist-purple")));
    private IReadOnlyList<AnalyticsRow> GovernanceDistribution => BuildAnalytics([new("Guardrails", AllRisks.Count(IsGovernanceRisk), "air-dist-red"), new("Standard", AllRisks.Count(x => !IsGovernanceRisk(x)), "air-dist-blue")]);

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("AI Settings", "/tenant/ai/renewal-risk"), new("Renewal Risk Settings", null));
        await ResolveCurrentUserContextAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchAiConfigItemsAsync(_tenantId, RiskKind, _search, pageSize: 250);
            _items = result?.Items.ToList() ?? [];
            SyncSelection();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load renewal risk settings: {ex.Message}";
            ShowToast(_loadError, "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private void SyncSelection()
    {
        _selectedItem = _selectedItem is null ? FilteredItems.FirstOrDefault() : FilteredItems.FirstOrDefault(x => x.AiConfigItemId == _selectedItem.AiConfigItemId) ?? FilteredItems.FirstOrDefault();
    }

    private bool MatchesFilters(RenewalRiskVm item)
    {
        var textMatch = string.IsNullOrWhiteSpace(_search) || new[] { item.Code, item.Name, item.CategoryLabel, item.DescriptionText, item.ConfigurationJson, item.WorkflowLabel, item.RolloutLabel }.Any(v => !string.IsNullOrWhiteSpace(v) && v.Contains(_search, StringComparison.OrdinalIgnoreCase));
        var categoryMatch = string.IsNullOrWhiteSpace(_categoryFilter) || item.CategoryLabel.Equals(_categoryFilter, StringComparison.OrdinalIgnoreCase);
        var filterMatch = _activeFilter switch
        {
            "active" => item.IsActive,
            "inactive" => !item.IsActive,
            "guardrail" => IsGovernanceRisk(item),
            "pilot" => item.RolloutLabel.Contains("Pilot", StringComparison.OrdinalIgnoreCase),
            "limits" => !item.LimitLabel.Equals("No limit", StringComparison.OrdinalIgnoreCase),
            _ => true
        };
        return textMatch && categoryMatch && filterMatch;
    }

    private void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        SyncSelection();
    }

    private void OnCategoryChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _categoryFilter = e.Value?.ToString() ?? string.Empty;
        SyncSelection();
    }

    private void OnStatusChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _activeFilter = e.Value?.ToString() ?? string.Empty;
        SyncSelection();
    }

    private void SetFilter(string filter)
    {
        _activeFilter = filter;
        SyncSelection();
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
        SyncSelection();
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _categoryFilter = string.Empty;
        _activeFilter = string.Empty;
        SyncSelection();
    }

    private void SelectItem(RenewalRiskVm item) => _selectedItem = item;
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;
    private Task ExportAsync() { ShowToast($"Export prepared for {FilteredItems.Count} renewal risk setting(s)."); return Task.CompletedTask; }
    private void OpenWorkflow(WorkflowLink workflow) => Nav.NavigateTo(workflow.Url);
    private void OpenRelatedSettings() => Nav.NavigateTo(SelectedItem?.WorkflowUrl ?? "/tenant/ai/renewal-risk");

    private void OpenCreate()
    {
        _editId = null;
        _form = new()
        {
            Code = BuildNextRiskCode(),
            Name = "New Renewal Risk",
            Category = "Signal Weights",
            Description = "Tenant-controlled renewal risk scoring setting.",
            ConfigurationJson = BuildDefaultJson("RenewalRisk", "Pilot", 100, true),
            SortOrder = AllRisks.Count == 0 ? 10 : AllRisks.Max(x => x.SortOrder) + 10,
            IsActive = true
        };
        _showForm = true;
    }

    private void OpenEdit(RenewalRiskVm item)
    {
        _editId = item.AiConfigItemId;
        _form = new()
        {
            Code = item.Code,
            Name = item.Name,
            Category = item.CategoryLabel,
            Description = item.Description,
            ConfigurationJson = item.ConfigurationJson,
            SortOrder = item.SortOrder,
            IsActive = item.IsActive
        };
        _showForm = true;
    }

    private void DuplicateRisk(RenewalRiskVm item)
    {
        _editId = null;
        _form = new()
        {
            Code = $"{item.Code}-COPY",
            Name = $"{item.Name} Copy",
            Category = item.CategoryLabel,
            Description = item.Description,
            ConfigurationJson = item.ConfigurationJson,
            SortOrder = item.SortOrder + 1,
            IsActive = false
        };
        _showForm = true;
    }

    private void CloseForm()
    {
        if (_saving) return;
        _showForm = false;
        _editId = null;
        _form = new();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            ValidateJson(_form.ConfigurationJson);
            if (_editId.HasValue)
            {
                await Api.UpdateAiConfigItemAsync(_editId.Value, new(_form.Code.Trim(), _form.Name.Trim(), _form.Category?.Trim(), _form.Description?.Trim(), NormalizeJson(_form.ConfigurationJson), _form.IsActive, _form.SortOrder));
                ShowToast("Renewal risk updated.");
            }
            else
            {
                var id = await Api.CreateAiConfigItemAsync(new(_tenantId, RiskKind, _form.Code.Trim(), _form.Name.Trim(), _form.Category?.Trim(), _form.Description?.Trim(), NormalizeJson(_form.ConfigurationJson), _form.SortOrder));
                _editId = id;
                ShowToast("Renewal risk created.");
            }

            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleActiveAsync(RenewalRiskVm item)
    {
        _saving = true;
        try
        {
            await Api.UpdateAiConfigItemAsync(item.AiConfigItemId, new(item.Code, item.Name, item.CategoryLabel, item.Description, item.ConfigurationJson, !item.IsActive, item.SortOrder));
            ShowToast($"{item.Name} {(item.IsActive ? "disabled" : "enabled")}.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Update failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmDelete(RenewalRiskVm item)
    {
        _deleteTarget = item;
        _showDelete = true;
    }

    private void CancelDelete()
    {
        if (_saving) return;
        _showDelete = false;
        _deleteTarget = null;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        _saving = true;
        try
        {
            await Api.DeleteAiConfigItemAsync(_deleteTarget.AiConfigItemId);
            _showDelete = false;
            ShowToast("Renewal risk deleted.");
            _deleteTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Delete failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private RenderFragment RiskCard(RenewalRiskVm item) => @<article class="air-risk-card @(SelectedItem?.AiConfigItemId == item.AiConfigItemId ? "air-risk-selected" : string.Empty)" @onclick="() => SelectItem(item)"><div class="air-card-top"><span class="air-avatar @AvatarClass(item)"><i class="bi @RiskIcon(item)" aria-hidden="true"></i></span><div><strong>@item.Name</strong><span>@item.Code</span></div></div><p>@item.DescriptionText</p><div class="air-item-meta"><span class="air-lob">@item.CategoryLabel</span><span class="@StatusBadge(item)">@(item.IsActive ? "Active" : "Inactive")</span><span class="@WorkflowBadge(item)">@item.WorkflowLabel</span></div><div class="air-item-footer"><span>@item.RolloutLabel</span><strong>@item.LimitLabel</strong></div><div class="air-row-actions" @onclick:stopPropagation="true"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ToggleActiveAsync(item)"><i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i></button></div></article>;
    private RenderFragment EmptyState(string icon, string title, string text) => @<div class="air-empty-state"><i class="bi @icon" aria-hidden="true"></i><strong>@title</strong><span>@text</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">Add Risk Control</button></div>;
    private RenderFragment AnalyticsRowTemplate(AnalyticsRow row) => @<button type="button" class="air-analytics-row"><span>@row.Label</span><div><i class="@row.Tone" style="width:@row.WidthPercent%"></i></div><strong>@row.Count</strong><small>@row.Percent.ToString("F0")%</small></button>;

    private static RenewalRiskVm MapRisk(AiConfigItemDto item)
    {
        var json = ParseJson(item.ConfigurationJson);
        var rollout = GetJsonValue(json, "rollout", item.IsActive ? "General" : "Disabled");
        var workflow = GetJsonValue(json, "workflow", item.Category ?? "Core");
        var limit = GetJsonValue(json, "dailyLimit", string.Empty);
        var workflowUrl = GetJsonValue(json, "workflowUrl", MapWorkflowUrl(workflow, item.Category));
        return new()
        {
            AiConfigItemId = item.AiConfigItemId,
            Code = item.Code,
            Name = item.Name,
            CategoryLabel = string.IsNullOrWhiteSpace(item.Category) ? "Core" : item.Category!,
            Description = item.Description,
            DescriptionText = string.IsNullOrWhiteSpace(item.Description) ? "No description configured." : item.Description!,
            ConfigurationJson = string.IsNullOrWhiteSpace(item.ConfigurationJson) ? "{}" : item.ConfigurationJson!,
            IsActive = item.IsActive,
            SortOrder = item.SortOrder,
            CreatedDateUtc = item.CreatedDateUtc,
            RolloutLabel = rollout,
            WorkflowLabel = workflow,
            WorkflowUrl = workflowUrl,
            LimitLabel = string.IsNullOrWhiteSpace(limit) ? "No limit" : $"{limit}/day"
        };
    }

    private static Dictionary<string, string> ParseJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try
        {
            using var doc = JsonDocument.Parse(json);
            return doc.RootElement.ValueKind == JsonValueKind.Object
                ? doc.RootElement.EnumerateObject().ToDictionary(x => x.Name, x => x.Value.ValueKind == JsonValueKind.String ? x.Value.GetString() ?? string.Empty : x.Value.ToString(), StringComparer.OrdinalIgnoreCase)
                : [];
        }
        catch
        {
            return [];
        }
    }

    private static string GetJsonValue(Dictionary<string, string> values, string key, string fallback) => values.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value) ? value : fallback;
    private static void ValidateJson(string? value) { if (string.IsNullOrWhiteSpace(value)) return; using var _ = JsonDocument.Parse(value); }
    private static string? NormalizeJson(string? value) => string.IsNullOrWhiteSpace(value) ? "{}" : value.Trim();
    private static string BuildDefaultJson(string workflow, string rollout, int dailyLimit, bool approvalRequired) => $"{{\"workflow\":\"{workflow}\",\"rollout\":\"{rollout}\",\"dailyLimit\":{dailyLimit},\"approvalRequired\":{approvalRequired.ToString().ToLowerInvariant()},\"workflowUrl\":\"/tenant/ai/renewal-risk\"}}";
    private string BuildNextRiskCode() => $"AI-RENEWAL-RISK-{AllRisks.Count + 1:000}";
    private int TabCount(string id) => id switch { "governance" => FilteredItems.Count(IsGovernanceRisk), "analytics" => AllRisks.Count, _ => FilteredItems.Count };
    private string MetricCardClass(KpiMetric metric) => $"air-kpi-card {(metric.Filter == _activeFilter ? "air-kpi-card-active" : string.Empty)}";
    private string TabClass(string id) => $"air-view-btn {(id == _activeTab ? "air-view-btn-active" : string.Empty)}";
    private static bool IsGovernanceRisk(RenewalRiskVm item) => item.CategoryLabel.Contains("Governance", StringComparison.OrdinalIgnoreCase) || item.Name.Contains("Approval", StringComparison.OrdinalIgnoreCase) || item.Name.Contains("Guardrail", StringComparison.OrdinalIgnoreCase) || item.ConfigurationJson.Contains("approval", StringComparison.OrdinalIgnoreCase) || item.ConfigurationJson.Contains("audit", StringComparison.OrdinalIgnoreCase) || item.ConfigurationJson.Contains("safety", StringComparison.OrdinalIgnoreCase);
    private static string StatusBadge(RenewalRiskVm item) => $"air-stage {(item.IsActive ? "air-stage-active" : "air-stage-inactive")}";
    private static string WorkflowBadge(RenewalRiskVm item) => $"air-stage air-stage-{item.WorkflowLabel.ToLowerInvariant().Replace(" ", "-").Replace("/", "-")}";
    private static string AvatarClass(RenewalRiskVm item) => item.CategoryLabel switch { "Governance" => "air-av-red", "Billing" => "air-av-purple", "Claims" => "air-av-green", "Service" => "air-av-amber", "Thresholds" => "air-av-cyan", "Alerts" => "air-av-red", _ => "air-av-blue" };
    private static string RiskIcon(RenewalRiskVm item) => item.CategoryLabel switch { "Governance" => "bi-shield-check", "Billing" => "bi-receipt", "Claims" => "bi-clipboard2-pulse", "Service" => "bi-headset", "Thresholds" => "bi-sliders", "Alerts" => "bi-bell", "Automation" => "bi-diagram-3", _ => "bi-arrow-clockwise" };
    private static string MapWorkflowUrl(string? workflow, string? category) => (workflow ?? category) switch { "RenewalRisk" or "Renewal Risk" or "Signal Model" or "Threshold Alerts" => "/tenant/ai/renewal-risk", "NextBestAction" or "Next Best Action" => "/tenant/ai/nba", "PromptTemplate" or "Prompts" or "Prompt Governance" => "/tenant/ai/prompts", "Usage" or "Usage Monitoring" => "/tenant/ai/usage", "Feedback" => "/tenant/ai/feedback", "Governance" => "/tenant/ai/renewal-risk", _ => "/tenant/ai/renewal-risk" };
    private static IReadOnlyList<AnalyticsRow> BuildAnalytics(IEnumerable<AnalyticsSeed> seeds) { var rows = seeds.Where(x => x.Count > 0).ToList(); var total = Math.Max(1, rows.Sum(x => x.Count)); return rows.Select(x => new AnalyticsRow(x.Label, x.Count, x.Tone, x.Count * 100m / total, Math.Max(5m, x.Count * 100m / total))).ToList(); }

