@page "/tenant/ai/prompts"
@namespace Ams.Web.Components.Pages.TenantConfig.AiConfig
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text.Json
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.AiConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Prompt Templates</PageTitle>

@if (_toastVisible)
{
    <div class="ptp-toast ptp-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="ptp-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="ptp-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="ptp-rule-modal" role="dialog" aria-modal="true" aria-labelledby="aiptpRuleFormTitle" @onclick:stopPropagation="true">
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="ptp-modal-header">
                    <div class="ptp-modal-title">
                        <span class="ptp-modal-icon"><i class="bi bi-chat-left-text" aria-hidden="true"></i></span>
                        <div>
                            <h2 id="aiptpRuleFormTitle">@(_editId.HasValue ? "Edit prompt template" : "Add prompt template")</h2>
                            <p>Configure reusable prompts, system instructions, output formats, approval controls, testing, and governance.</p>
                        </div>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_saving"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="ptp-modal-body">
                    <div class="ptp-form-banner">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <div>
                            <strong>Tenant Admin scoped AI control</strong>
                            <span>Changes are saved to AI.AiConfigItem for this tenant and reflected in Prompt workflows.</span>
                        </div>
                    </div>
                    <div class="ptp-form-grid">
                        <div class="ptp-field">
                            <label for="ptpCode">Code <span>*</span></label>
                            <InputText id="ptpCode" class="ptp-input" @bind-Value="_form.Code" />
                            <ValidationMessage For="() => _form.Code" class="text-danger" />
                        </div>
                        <div class="ptp-field">
                            <label for="ptpName">Name <span>*</span></label>
                            <InputText id="ptpName" class="ptp-input" @bind-Value="_form.Name" />
                            <ValidationMessage For="() => _form.Name" class="text-danger" />
                        </div>
                        <div class="ptp-field">
                            <label for="ptpCategory">Category <span>*</span></label>
                            <InputSelect id="ptpCategory" class="ptp-input" @bind-Value="_form.Category">
                                @foreach (var category in _categoryOptions)
                                {
                                    <option value="@category">@category</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.Category" class="text-danger" />
                        </div>
                        <div class="ptp-field">
                            <label for="ptpSortOrder">Sort order</label>
                            <InputNumber id="ptpSortOrder" class="ptp-input" @bind-Value="_form.SortOrder" />
                            <ValidationMessage For="() => _form.SortOrder" class="text-danger" />
                        </div>
                        <div class="ptp-field ptp-field-wide">
                            <label for="ptpDescription">Description</label>
                            <InputTextArea id="ptpDescription" class="ptp-input" rows="3" @bind-Value="_form.Description" />
                            <ValidationMessage For="() => _form.Description" class="text-danger" />
                        </div>
                        <div class="ptp-field ptp-field-wide">
                            <label for="ptpConfiguration">Configuration JSON</label>
                            <InputTextArea id="ptpConfiguration" class="ptp-input ptp-code-input" rows="8" @bind-Value="_form.ConfigurationJson" />
                            <ValidationMessage For="() => _form.ConfigurationJson" class="text-danger" />
                        </div>
                        <div class="ptp-field ptp-check-row">
                            <label><InputCheckbox @bind-Value="_form.IsActive" /> Active Prompt Template</label>
                        </div>
                    </div>
                </div>
                <div class="ptp-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_saving">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(_editId.HasValue ? "Save changes" : "Create Prompt Template")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showDelete)
{
    <div class="ptp-modal-backdrop" role="presentation" @onclick="CancelDelete">
        <div class="ptp-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="deleteActionControlTitle" @onclick:stopPropagation="true">
            <div class="ptp-confirm-icon ptp-confirm-danger"><i class="bi bi-trash3-fill" aria-hidden="true"></i></div>
            <h2 id="deleteActionControlTitle">Delete prompt template?</h2>
            <p>Delete <strong>@_deleteTarget?.Name</strong>? This removes the prompt template from active tenant AI workflows.</p>
            <div class="ptp-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CancelDelete" disabled="@_saving">Cancel</button>
                <button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button>
            </div>
        </div>
    </div>
}

<div class="ptp-enterprise-page">
    <section class="ptp-hero">
        <div class="ptp-hero-left">
            <span class="ptp-hero-icon"><i class="bi bi-chat-left-text" aria-hidden="true"></i></span>
            <div>
                <div class="ptp-title-row">
                    <h1>Prompt Templates</h1>
                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> Tenant Admin User</span>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live AI configuration</span>
                </div>
                <p>Manage reusable prompt templates, system instructions, output rules, approval workflow, testing, publishing, and Tenant Admin governance.</p>
            </div>
        </div>
        <div class="ptp-hero-actions">
            <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_loading" title="Refresh prompt templates"><i class="bi @(_loading ? "bi-arrow-repeat ptp-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-ghost" type="button" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button class="um-btn um-btn-ghost" type="button" @onclick='() => Nav.NavigateTo("/tenant/ai/features")'><i class="bi bi-grid-1x2" aria-hidden="true"></i> AI Center</button>
            <button class="um-btn um-btn-primary" type="button" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Prompt Template</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger ptp-error-banner" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="ptp-kpi-strip" aria-label="Prompt KPI filters">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" @onclick="() => SetFilter(metric.Filter)" title="@metric.Tooltip" aria-pressed="@(metric.Filter == _activeFilter)">
                <span class="ptp-kpi-icon @metric.Tone"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <div>
                    <span class="ptp-kpi-val">@metric.Value</span>
                    <span class="ptp-kpi-lbl">@metric.Label</span>
                    <small>@metric.Caption</small>
                </div>
            </button>
        }
    </section>

    <section class="ptp-workflow-strip" aria-label="AI settings workflows">
        @foreach (var workflow in _workflows)
        {
            <button type="button" class="ptp-workflow-card" @onclick="() => OpenWorkflow(workflow)">
                <i class="bi @workflow.Icon" aria-hidden="true"></i>
                <span><strong>@workflow.Title</strong><span>@workflow.Text</span></span>
            </button>
        }
    </section>

    <section class="ptp-search-panel" aria-label="Prompt filters">
        <div class="ptp-search-wrap">
            <span class="ptp-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="ptp-search-body">
                <label for="aiActionControlSearch">Search prompt templates</label>
                <input id="aiActionControlSearch" class="ptp-search-input" value="@_search" @oninput="OnSearchChanged" placeholder="Search code, name, category, workflow, or JSON..." />
                <span class="ptp-search-hint">Filters apply instantly to the active tab and KPI selection.</span>
            </div>
        </div>
        <select class="ptp-filter-select" value="@_categoryFilter" @onchange="OnCategoryChanged" aria-label="Category filter">
            <option value="">All categories</option>
            @foreach (var category in Categories)
            {
                <option value="@category">@category</option>
            }
        </select>
        <select class="ptp-filter-select" value="@_activeFilter" @onchange="OnStatusChanged" aria-label="Status filter">
            <option value="">All statuses</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
            <option value="guardrail">Guardrails</option>
            <option value="pilot">Pilot</option>
        </select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-circle" aria-hidden="true"></i> Reset</button>
        <div class="ptp-search-result"><strong>@FilteredItems.Count</strong><span>shown</span></div>
    </section>

    <div class="ptp-view-tabs" role="tablist" aria-label="Prompt views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="@TabClass(tab.Id)" role="tab" aria-selected="@(tab.Id == _activeTab)" @onclick="() => SetTab(tab.Id)"><i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label <span>@TabCount(tab.Id)</span></button>
        }
    </div>

    <section class="ptp-content-layout">
        <main class="ptp-main-card">
            @if (_loading)
            {
                <div class="ptp-loading"><i class="bi bi-arrow-repeat ptp-spin" aria-hidden="true"></i><strong>Loading prompt templates...</strong><span>Syncing tenant AI configuration, prompt library, and workflow readiness.</span></div>
            }
            else if (_activeTab == "board")
            {
                <div class="ptp-board">
                    @foreach (var category in BoardCategories)
                    {
                        <section class="ptp-board-col">
                            <header><span>@category</span><strong>@FilteredItems.Count(x => x.CategoryLabel == category)</strong></header>
                            @foreach (var item in FilteredItems.Where(x => x.CategoryLabel == category))
                            {
                                @PromptCard(item)
                            }
                        </section>
                    }
                </div>
            }
            else if (_activeTab == "governance")
            {
                <div class="ptp-governance-grid">
                    @foreach (var item in FilteredItems.Where(IsGovernanceSetting))
                    {
                        @PromptCard(item)
                    }
                    @if (!FilteredItems.Any(IsGovernanceSetting))
                    {
                        @EmptyState("bi-shield-check", "No governance prompt templates match", "Adjust filters or add safety, approval, or audit controls.")
                    }
                </div>
            }
            else if (_activeTab == "analytics")
            {
                <div class="ptp-analytics-grid">
                    <section><h3>Category distribution</h3>@foreach (var row in CategoryDistribution) { @AnalyticsRowTemplate(row) }</section>
                    <section><h3>Rollout status</h3>@foreach (var row in StatusDistribution) { @AnalyticsRowTemplate(row) }</section>
                    <section><h3>Workflow readiness</h3>@foreach (var row in WorkflowDistribution) { @AnalyticsRowTemplate(row) }</section>
                    <section><h3>Governance coverage</h3>@foreach (var row in GovernanceDistribution) { @AnalyticsRowTemplate(row) }</section>
                </div>
            }
            else
            {
                <div class="ptp-table-scroll">
                    @if (FilteredItems.Count == 0)
                    {
                        @EmptyState("bi-chat-left-text", "No prompt templates match", "Adjust filters, refresh the page, or add a new prompt template.")
                    }
                    else
                    {
                        <table class="ptp-table">
                            <thead><tr><th>Prompt Template</th><th>Category</th><th>Status</th><th>Rollout</th><th>Limits</th><th>Workflow</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var item in FilteredItems)
                                {
                                    <tr class="@(SelectedItem?.AiConfigItemId == item.AiConfigItemId ? "ptp-row-selected" : string.Empty)" @onclick="() => SelectItem(item)">
                                        <td><div class="ptp-name-cell"><span class="ptp-avatar @AvatarClass(item)"><i class="bi @PromptIcon(item)" aria-hidden="true"></i></span><div><strong>@item.Name</strong><small>@item.Code</small></div></div></td>
                                        <td><span class="ptp-lob">@item.CategoryLabel</span></td>
                                        <td><span class="@StatusBadge(item)">@(item.IsActive ? "Active" : "Inactive")</span></td>
                                        <td>@item.RolloutLabel</td>
                                        <td>@item.LimitLabel</td>
                                        <td><span class="@WorkflowBadge(item)">@item.WorkflowLabel</span></td>
                                        <td><div class="ptp-row-actions" @onclick:stopPropagation="true"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ToggleActiveAsync(item)" title="@(item.IsActive ? "Disable" : "Enable")"><i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDelete(item)" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            }
        </main>

        <aside class="ptp-detail-card">
            @if (SelectedItem is not null)
            {
                <div class="ptp-detail-head">
                    <div><span class="ptp-detail-eyebrow"><i class="bi @PromptIcon(SelectedItem)" aria-hidden="true"></i> @SelectedItem.CategoryLabel</span><h2>@SelectedItem.Name</h2><p>@SelectedItem.Code · @SelectedItem.CreatedDateUtc.ToString("MMM d, yyyy", CultureInfo.CurrentCulture)</p></div>
                    <span class="@StatusBadge(SelectedItem)">@(SelectedItem.IsActive ? "Active" : "Inactive")</span>
                </div>
                <div class="ptp-detail-body">
                    <div class="ptp-detail-summary">
                        <div><span>Rollout</span><strong>@SelectedItem.RolloutLabel</strong></div>
                        <div><span>Workflow</span><strong>@SelectedItem.WorkflowLabel</strong></div>
                        <div><span>Daily limit</span><strong>@SelectedItem.LimitLabel</strong></div>
                        <div><span>Sort order</span><strong>@SelectedItem.SortOrder</strong></div>
                    </div>
                    <div class="ptp-contact-card"><strong>Configuration summary</strong><span>@SelectedItem.DescriptionText</span></div>
                    <div class="ptp-json-card"><strong>Configuration JSON</strong><pre>@SelectedItem.ConfigurationJson</pre></div>
                    <div class="ptp-detail-actions">
                        <div class="ptp-detail-actions-row">
                            <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenEdit(SelectedItem)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                            <button type="button" class="um-btn um-btn-ghost" @onclick="() => DuplicateSetting(SelectedItem)"><i class="bi bi-copy" aria-hidden="true"></i> Duplicate</button>
                            <button type="button" class="um-btn um-btn-ghost" @onclick="() => ToggleActiveAsync(SelectedItem)"><i class="bi @(SelectedItem.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i> @(SelectedItem.IsActive ? "Disable" : "Enable")</button>
                        </div>
                        <button type="button" class="um-btn um-btn-primary ptp-detail-open-btn" @onclick="OpenRelatedSettings"><i class="bi bi-diagram-3" aria-hidden="true"></i> Open related AI workflow</button>
                    </div>
                </div>
            }
            else
            {
                <div class="ptp-detail-empty"><i class="bi bi-chat-left-text" aria-hidden="true"></i><strong>Select a prompt template</strong><span>Review rollout, governance, workflow readiness, and configuration JSON.</span></div>
            }
        </aside>
    </section>
</div>

@code {
    private const string RuleKind = "PromptTemplate";
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading;
    private bool _saving;
    private bool _showForm;
    private bool _showDelete;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string _search = string.Empty;
    private string _activeFilter = string.Empty;
    private string _categoryFilter = string.Empty;
    private string _activeTab = "list";
    private string? _loadError;
    private Guid? _editId;
    private PromptTemplateVm? _deleteTarget;
    private List<AiConfigItemDto> _items = [];
    private PromptTemplateVm? _selectedItem;
    private FormModel _form = new();

    private readonly string[] _categoryOptions = ["System Instruction", "Account Summary", "Renewal Risk", "Next Best Action", "Cross-sell", "Service Triage", "Output Format", "Governance"];
    private readonly List<ViewTab> _tabs = [new("list", "List", "bi-list-ul"), new("board", "Board", "bi-kanban"), new("governance", "Governance", "bi-shield-check"), new("analytics", "Analytics", "bi-bar-chart")];
    private readonly List<WorkflowLink> _workflows = [new("Prompt Library", "Reusable tenant prompt templates and versions", "/tenant/ai/prompts", "bi-chat-left-text"), new("Account Summaries", "Summary prompts and source-citation output rules", "/tenant/ai/summaries", "bi-person-vcard"), new("Next Best Action", "Recommendation prompts and action rationale", "/tenant/ai/nba", "bi-lightning-charge"), new("Usage Monitoring", "Prompt volume, limits, and audit readiness", "/tenant/ai/usage", "bi-speedometer2")];

    private string ToastIconClass => _toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill";
    private List<PromptTemplateVm> AllRules => _items.Select(MapPrompt).ToList();
    private List<PromptTemplateVm> FilteredItems => AllRules.Where(MatchesFilters).OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToList();
    private PromptTemplateVm? SelectedItem => _selectedItem is null ? FilteredItems.FirstOrDefault() : FilteredItems.FirstOrDefault(x => x.AiConfigItemId == _selectedItem.AiConfigItemId) ?? FilteredItems.FirstOrDefault();
    private IEnumerable<string> Categories => AllRules.Select(x => x.CategoryLabel).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x);
    private IEnumerable<string> BoardCategories => Categories.Any() ? Categories : _categoryOptions;
    private IReadOnlyList<KpiMetric> Metrics => [new("", "Total", AllRules.Count.ToString("N0"), "All prompt templates", "bi-chat-left-text", "ptp-blue", "Show all prompt templates"), new("active", "Active", AllRules.Count(x => x.IsActive).ToString("N0"), "Available to workflows", "bi-check-circle-fill", "ptp-green", "Show active prompt templates"), new("inactive", "Inactive", AllRules.Count(x => !x.IsActive).ToString("N0"), "Disabled templates", "bi-pause-circle", "ptp-muted", "Show inactive prompt templates"), new("guardrail", "Guardrails", AllRules.Count(IsGovernanceSetting).ToString("N0"), "Approval and audit", "bi-shield-check", "ptp-red", "Show governance prompt templates"), new("pilot", "Pilot", AllRules.Count(x => x.RolloutLabel.Contains("Pilot", StringComparison.OrdinalIgnoreCase)).ToString("N0"), "Pilot rollout", "bi-rocket-takeoff", "ptp-purple", "Show pilot prompt templates"), new("limits", "Limited", AllRules.Count(x => !x.LimitLabel.Equals("No limit", StringComparison.OrdinalIgnoreCase)).ToString("N0"), "Usage limits set", "bi-speedometer2", "ptp-amber", "Show limited prompt templates")];
    private IReadOnlyList<AnalyticsRow> CategoryDistribution => BuildAnalytics(AllRules.GroupBy(x => x.CategoryLabel).Select(g => new AnalyticsSeed(g.Key, g.Count(), "ptp-dist-blue")));
    private IReadOnlyList<AnalyticsRow> StatusDistribution => BuildAnalytics([new("Active", AllRules.Count(x => x.IsActive), "ptp-dist-green"), new("Inactive", AllRules.Count(x => !x.IsActive), "ptp-dist-amber")]);
    private IReadOnlyList<AnalyticsRow> WorkflowDistribution => BuildAnalytics(AllRules.GroupBy(x => x.WorkflowLabel).Select(g => new AnalyticsSeed(g.Key, g.Count(), "ptp-dist-purple")));
    private IReadOnlyList<AnalyticsRow> GovernanceDistribution => BuildAnalytics([new("Guardrails", AllRules.Count(IsGovernanceSetting), "ptp-dist-red"), new("Standard", AllRules.Count(x => !IsGovernanceSetting(x)), "ptp-dist-blue")]);

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("AI Settings", "/tenant/ai/prompts"), new("Prompt Templates", null));
        await ResolveCurrentUserContextAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchAiConfigItemsAsync(_tenantId, RuleKind, _search, pageSize: 250);
            _items = result?.Items.ToList() ?? [];
            SyncSelection();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load prompt templates: {ex.Message}";
            ShowToast(_loadError, "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private void SyncSelection()
    {
        _selectedItem = _selectedItem is null ? FilteredItems.FirstOrDefault() : FilteredItems.FirstOrDefault(x => x.AiConfigItemId == _selectedItem.AiConfigItemId) ?? FilteredItems.FirstOrDefault();
    }

    private bool MatchesFilters(PromptTemplateVm item)
    {
        var textMatch = string.IsNullOrWhiteSpace(_search) || new[] { item.Code, item.Name, item.CategoryLabel, item.DescriptionText, item.ConfigurationJson, item.WorkflowLabel, item.RolloutLabel }.Any(v => !string.IsNullOrWhiteSpace(v) && v.Contains(_search, StringComparison.OrdinalIgnoreCase));
        var categoryMatch = string.IsNullOrWhiteSpace(_categoryFilter) || item.CategoryLabel.Equals(_categoryFilter, StringComparison.OrdinalIgnoreCase);
        var filterMatch = _activeFilter switch
        {
            "active" => item.IsActive,
            "inactive" => !item.IsActive,
            "guardrail" => IsGovernanceSetting(item),
            "pilot" => item.RolloutLabel.Contains("Pilot", StringComparison.OrdinalIgnoreCase),
            "limits" => !item.LimitLabel.Equals("No limit", StringComparison.OrdinalIgnoreCase),
            _ => true
        };
        return textMatch && categoryMatch && filterMatch;
    }

    private void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        SyncSelection();
    }

    private void OnCategoryChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _categoryFilter = e.Value?.ToString() ?? string.Empty;
        SyncSelection();
    }

    private void OnStatusChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _activeFilter = e.Value?.ToString() ?? string.Empty;
        SyncSelection();
    }

    private void SetFilter(string filter)
    {
        _activeFilter = filter;
        SyncSelection();
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
        SyncSelection();
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _categoryFilter = string.Empty;
        _activeFilter = string.Empty;
        SyncSelection();
    }

    private void SelectItem(PromptTemplateVm item) => _selectedItem = item;
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;
    private Task ExportAsync() { ShowToast($"Export prepared for {FilteredItems.Count} prompt template(s)."); return Task.CompletedTask; }
    private void OpenWorkflow(WorkflowLink workflow) => Nav.NavigateTo(workflow.Url);
    private void OpenRelatedSettings() => Nav.NavigateTo(SelectedItem?.WorkflowUrl ?? "/tenant/ai/prompts");

    private void OpenCreate()
    {
        _editId = null;
        _form = new()
        {
            Code = BuildNextPromptCode(),
            Name = "New Prompt Template",
            Category = "System Instruction",
            Description = "Tenant-controlled reusable AI prompt template.",
            ConfigurationJson = BuildDefaultJson("PromptTemplate", "Pilot", 100, true),
            SortOrder = AllRules.Count == 0 ? 10 : AllRules.Max(x => x.SortOrder) + 10,
            IsActive = true
        };
        _showForm = true;
    }

    private void OpenEdit(PromptTemplateVm item)
    {
        _editId = item.AiConfigItemId;
        _form = new()
        {
            Code = item.Code,
            Name = item.Name,
            Category = item.CategoryLabel,
            Description = item.Description,
            ConfigurationJson = item.ConfigurationJson,
            SortOrder = item.SortOrder,
            IsActive = item.IsActive
        };
        _showForm = true;
    }

    private void DuplicateSetting(PromptTemplateVm item)
    {
        _editId = null;
        _form = new()
        {
            Code = $"{item.Code}-COPY",
            Name = $"{item.Name} Copy",
            Category = item.CategoryLabel,
            Description = item.Description,
            ConfigurationJson = item.ConfigurationJson,
            SortOrder = item.SortOrder + 1,
            IsActive = false
        };
        _showForm = true;
    }

    private void CloseForm()
    {
        if (_saving) return;
        _showForm = false;
        _editId = null;
        _form = new();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            ValidateJson(_form.ConfigurationJson);
            if (_editId.HasValue)
            {
                await Api.UpdateAiConfigItemAsync(_editId.Value, new(_form.Code.Trim(), _form.Name.Trim(), _form.Category?.Trim(), _form.Description?.Trim(), NormalizeJson(_form.ConfigurationJson), _form.IsActive, _form.SortOrder));
                ShowToast("Prompt updated.");
            }
            else
            {
                var id = await Api.CreateAiConfigItemAsync(new(_tenantId, RuleKind, _form.Code.Trim(), _form.Name.Trim(), _form.Category?.Trim(), _form.Description?.Trim(), NormalizeJson(_form.ConfigurationJson), _form.SortOrder));
                _editId = id;
                ShowToast("Prompt created.");
            }

            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleActiveAsync(PromptTemplateVm item)
    {
        _saving = true;
        try
        {
            await Api.UpdateAiConfigItemAsync(item.AiConfigItemId, new(item.Code, item.Name, item.CategoryLabel, item.Description, item.ConfigurationJson, !item.IsActive, item.SortOrder));
            ShowToast($"{item.Name} {(item.IsActive ? "disabled" : "enabled")}.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Update failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmDelete(PromptTemplateVm item)
    {
        _deleteTarget = item;
        _showDelete = true;
    }

    private void CancelDelete()
    {
        if (_saving) return;
        _showDelete = false;
        _deleteTarget = null;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        _saving = true;
        try
        {
            await Api.DeleteAiConfigItemAsync(_deleteTarget.AiConfigItemId);
            _showDelete = false;
            ShowToast("Prompt deleted.");
            _deleteTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Delete failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private RenderFragment PromptCard(PromptTemplateVm item) => @<article class="ptp-action-card @(SelectedItem?.AiConfigItemId == item.AiConfigItemId ? "ptp-action-selected" : string.Empty)" @onclick="() => SelectItem(item)"><div class="ptp-card-top"><span class="ptp-avatar @AvatarClass(item)"><i class="bi @PromptIcon(item)" aria-hidden="true"></i></span><div><strong>@item.Name</strong><span>@item.Code</span></div></div><p>@item.DescriptionText</p><div class="ptp-item-meta"><span class="ptp-lob">@item.CategoryLabel</span><span class="@StatusBadge(item)">@(item.IsActive ? "Active" : "Inactive")</span><span class="@WorkflowBadge(item)">@item.WorkflowLabel</span></div><div class="ptp-item-footer"><span>@item.RolloutLabel</span><strong>@item.LimitLabel</strong></div><div class="ptp-row-actions" @onclick:stopPropagation="true"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ToggleActiveAsync(item)"><i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i></button></div></article>;
    private RenderFragment EmptyState(string icon, string title, string text) => @<div class="ptp-empty-state"><i class="bi @icon" aria-hidden="true"></i><strong>@title</strong><span>@text</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">Add Prompt Template</button></div>;
    private RenderFragment AnalyticsRowTemplate(AnalyticsRow row) => @<button type="button" class="ptp-analytics-row"><span>@row.Label</span><div><i class="@row.Tone" style="width:@row.WidthPercent%"></i></div><strong>@row.Count</strong><small>@row.Percent.ToString("F0")%</small></button>;

    private static PromptTemplateVm MapPrompt(AiConfigItemDto item)
    {
        var json = ParseJson(item.ConfigurationJson);
        var rollout = GetJsonValue(json, "rollout", item.IsActive ? "General" : "Disabled");
        var workflow = GetJsonValue(json, "workflow", item.Category ?? "Core");
        var limit = GetJsonValue(json, "dailyLimit", string.Empty);
        var workflowUrl = GetJsonValue(json, "workflowUrl", MapWorkflowUrl(workflow, item.Category));
        return new()
        {
            AiConfigItemId = item.AiConfigItemId,
            Code = item.Code,
            Name = item.Name,
            CategoryLabel = string.IsNullOrWhiteSpace(item.Category) ? "Core" : item.Category!,
            Description = item.Description,
            DescriptionText = string.IsNullOrWhiteSpace(item.Description) ? "No description configured." : item.Description!,
            ConfigurationJson = string.IsNullOrWhiteSpace(item.ConfigurationJson) ? "{}" : item.ConfigurationJson!,
            IsActive = item.IsActive,
            SortOrder = item.SortOrder,
            CreatedDateUtc = item.CreatedDateUtc,
            RolloutLabel = rollout,
            WorkflowLabel = workflow,
            WorkflowUrl = workflowUrl,
            LimitLabel = string.IsNullOrWhiteSpace(limit) ? "No limit" : $"{limit}/day"
        };
    }

    private static Dictionary<string, string> ParseJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try
        {
            using var doc = JsonDocument.Parse(json);
            return doc.RootElement.ValueKind == JsonValueKind.Object
                ? doc.RootElement.EnumerateObject().ToDictionary(x => x.Name, x => x.Value.ValueKind == JsonValueKind.String ? x.Value.GetString() ?? string.Empty : x.Value.ToString(), StringComparer.OrdinalIgnoreCase)
                : [];
        }
        catch
        {
            return [];
        }
    }

    private static string GetJsonValue(Dictionary<string, string> values, string key, string fallback) => values.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value) ? value : fallback;
    private static void ValidateJson(string? value) { if (string.IsNullOrWhiteSpace(value)) return; using var _ = JsonDocument.Parse(value); }
    private static string? NormalizeJson(string? value) => string.IsNullOrWhiteSpace(value) ? "{}" : value.Trim();
    private static string BuildDefaultJson(string workflow, string rollout, int dailyLimit, bool approvalRequired) => $"{{\"workflow\":\"{workflow}\",\"rollout\":\"{rollout}\",\"dailyLimit\":{dailyLimit},\"approvalRequired\":{approvalRequired.ToString().ToLowerInvariant()},\"workflowUrl\":\"/tenant/ai/prompts\"}}";
    private string BuildNextPromptCode() => $"AI-PROMPT-{AllRules.Count + 1:000}";
    private int TabCount(string id) => id switch { "governance" => FilteredItems.Count(IsGovernanceSetting), "analytics" => AllRules.Count, _ => FilteredItems.Count };
    private string MetricCardClass(KpiMetric metric) => $"ptp-kpi-card {(metric.Filter == _activeFilter ? "ptp-kpi-card-active" : string.Empty)}";
    private string TabClass(string id) => $"ptp-view-btn {(id == _activeTab ? "ptp-view-btn-active" : string.Empty)}";
    private static bool IsGovernanceSetting(PromptTemplateVm item) => item.CategoryLabel.Contains("Governance", StringComparison.OrdinalIgnoreCase) || item.Name.Contains("Approval", StringComparison.OrdinalIgnoreCase) || item.Name.Contains("Guardrail", StringComparison.OrdinalIgnoreCase) || item.ConfigurationJson.Contains("approval", StringComparison.OrdinalIgnoreCase) || item.ConfigurationJson.Contains("audit", StringComparison.OrdinalIgnoreCase) || item.ConfigurationJson.Contains("safety", StringComparison.OrdinalIgnoreCase);
    private static string StatusBadge(PromptTemplateVm item) => $"ptp-stage {(item.IsActive ? "ptp-stage-active" : "ptp-stage-inactive")}";
    private static string WorkflowBadge(PromptTemplateVm item) => $"ptp-stage ptp-stage-{item.WorkflowLabel.ToLowerInvariant().Replace(" ", "-").Replace("/", "-")}";
    private static string AvatarClass(PromptTemplateVm item) => item.CategoryLabel switch { "Governance" => "ptp-av-red", "System Instruction" => "ptp-av-blue", "Account Summary" => "ptp-av-green", "Renewal Risk" => "ptp-av-purple", "Next Best Action" => "ptp-av-amber", "Cross-sell" => "ptp-av-cyan", "Service Triage" => "ptp-av-green", "Output Format" => "ptp-av-purple", _ => "ptp-av-blue" };
    private static string PromptIcon(PromptTemplateVm item) => item.CategoryLabel switch { "Governance" => "bi-shield-check", "System Instruction" => "bi-terminal", "Account Summary" => "bi-person-vcard", "Renewal Risk" => "bi-arrow-clockwise", "Next Best Action" => "bi-lightning-charge", "Cross-sell" => "bi-bullseye", "Service Triage" => "bi-headset", "Output Format" => "bi-braces", _ => "bi-chat-left-text" };
    private static string MapWorkflowUrl(string? workflow, string? category) => (workflow ?? category) switch { "PromptTemplate" or "Prompts" or "Prompt Governance" or "Prompt Library" or "Governance" => "/tenant/ai/prompts", "AccountSummary" or "Account Summary" or "Summaries" => "/tenant/ai/summaries", "RenewalRisk" or "Renewal Risk" => "/tenant/ai/renewal-risk", "NextBestAction" or "Next Best Action" => "/tenant/ai/nba", "CrossSell" or "Cross-sell" => "/tenant/ai/cross-sell", "Service Triage" or "Service" => "/workbench/service", "Usage" or "Usage Monitoring" => "/tenant/ai/usage", "Feedback" => "/tenant/ai/feedback", _ => "/tenant/ai/prompts" };
    private static IReadOnlyList<AnalyticsRow> BuildAnalytics(IEnumerable<AnalyticsSeed> seeds) { var rows = seeds.Where(x => x.Count > 0).ToList(); var total = Math.Max(1, rows.Sum(x => x.Count)); return rows.Select(x => new AnalyticsRow(x.Label, x.Count, x.Tone, x.Count * 100m / total, Math.Max(5m, x.Count * 100m / total))).ToList(); }

    private sealed record KpiMetric(string Filter, string Label, string Value, string Caption, string Icon, string Tone, string Tooltip);
    private sealed record ViewTab(string Id, string Label, string Icon);
    private sealed record WorkflowLink(string Title, string Text, string Url, string Icon);
    private sealed record AnalyticsSeed(string Label, int Count, string Tone);
    private sealed record AnalyticsRow(string Label, int Count, string Tone, decimal Percent, decimal WidthPercent);
    private sealed class PromptTemplateVm { public Guid AiConfigItemId { get; set; } public string Code { get; set; } = string.Empty; public string Name { get; set; } = string.Empty; public string CategoryLabel { get; set; } = "Core"; public string? Description { get; set; } public string DescriptionText { get; set; } = string.Empty; public string ConfigurationJson { get; set; } = "{}"; public bool IsActive { get; set; } public int SortOrder { get; set; } public DateTime CreatedDateUtc { get; set; } public string RolloutLabel { get; set; } = "General"; public string WorkflowLabel { get; set; } = "Core"; public string WorkflowUrl { get; set; } = "/tenant/ai/prompts"; public string LimitLabel { get; set; } = "No limit"; }
    private sealed class FormModel { [Required, StringLength(80)] public string Code { get; set; } = string.Empty; [Required, StringLength(200)] public string Name { get; set; } = string.Empty; [Required, StringLength(120)] public string? Category { get; set; } = "Core"; [StringLength(500)] public string? Description { get; set; } [StringLength(4000)] public string? ConfigurationJson { get; set; } = "{}"; [Range(0, 9999)] public int SortOrder { get; set; } public bool IsActive { get; set; } = true; }
}






