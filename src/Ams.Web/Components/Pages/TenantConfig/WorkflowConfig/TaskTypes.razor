@page "/tenant/workflows/task-types"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Operations

<PageTitle>Task Types — Workflow & SLA</PageTitle>
<AppPageHeader Title="Task Types" Subtitle="Configure tenant task types used by the Task Board and workflow operations" Icon="bi-tags"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New Task Type</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<div class="pc-kpi-strip"><div class="pc-kpi-card @(_activeFilter is null ? "pc-kpi-card--active" : "")" @onclick="() => SetFilter(null)" title="Show all task types"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-tags-fill"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total</div></div></div><div class="pc-kpi-card @(_activeFilter == "Active" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Active")' title="Show active task types"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsActive)</div><div class="pc-kpi-label">Active</div></div></div><div class="pc-kpi-card @(_activeFilter == "Inactive" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Inactive")' title="Show inactive task types"><span class="pc-kpi-icon pc-kpi-icon--warning"><i class="bi bi-pause-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x => !x.IsActive)</div><div class="pc-kpi-label">Inactive</div></div></div></div>
<AppFilterPanel @bind-SearchValue="_searchTerm" OnSearch="OnSearchAsync" SearchPlaceholder="Search task types..." />
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div> }
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }<SfGrid TValue="TaskTypeDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52"><GridEvents TValue="TaskTypeDto" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" /><GridColumns><GridColumn Field="TaskTypeCode" HeaderText="Code" Width="160" /><GridColumn Field="TaskTypeName" HeaderText="Task Type" Width="240" /><GridColumn Field="Description" HeaderText="Description" Width="320" /><GridColumn Field="SortOrder" HeaderText="Sort" Width="100" TextAlign="TextAlign.Right" /><GridColumn Field="IsActive" HeaderText="Active" Width="100" DisplayAsCheckBox="true" /><GridColumn HeaderText="Actions" Width="120" TextAlign="TextAlign.Center"><Template>@{ var item = (TaskTypeDto)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(item)" @onclick:stopPropagation="true" title="Edit"><i class="bi bi-pencil"></i></button><button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDelete(item)" @onclick:stopPropagation="true" title="Delete"><i class="bi bi-trash"></i></button></Template></GridColumn></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="560px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm" /><DialogContent><div class="um-modal-header"><i class="bi bi-tags"></i><span>@(_editId.HasValue ? "Edit Task Type" : "New Task Type")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.TaskTypeCode" class="um-input" /><ValidationMessage For="() => _form.TaskTypeCode" class="text-danger" /></div><div class="um-field"><label>Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.TaskTypeName" class="um-input" /><ValidationMessage For="() => _form.TaskTypeName" class="text-danger" /></div><div class="um-field"><label>Sort Order</label><InputNumber @bind-Value="_form.SortOrder" class="um-input" /><ValidationMessage For="() => _form.SortOrder" class="text-danger" /></div><div class="um-field"><label>Active</label><InputCheckbox @bind-Value="_form.IsActive" /><ValidationMessage For="() => _form.IsActive" class="text-danger" /></div><div class="um-field um-field--full"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="3" /><ValidationMessage For="() => _form.Description" class="text-danger" /></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button></div></EditForm></DialogContent></SfDialog>
@if (_showDelete && _deleteTarget is not null) { <div class="mt-modal-backdrop" @onclick="() => _showDelete = false"><div class="um-confirm-dialog mt-confirm" @onclick:stopPropagation="true"><div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash"></i></div><div class="um-confirm-title">Delete task type?</div><div class="um-confirm-text">This will remove <strong>@_deleteTarget.TaskTypeName</strong>.</div><div class="um-modal-footer"><button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button><button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div></div></div> }
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" /><style>@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }</style>
@code {
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId; Guid TenantId { get; set; } Guid TenantAdminUserId { get; set; } string? _searchTerm, _loadError, _activeFilter; bool _loading, _saving, _showForm, _showDelete; Guid? _editId; List<TaskTypeDto> _items = [], _filtered = []; TaskTypeDto? _deleteTarget; TaskTypeForm _form = new(); SfToast _toast = default!; protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Workflow & SLA", null), new("Task Types", null)); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchTaskTypesAsync(TenantId, _searchTerm); _items = result?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = $"Failed to load task types: {ex.Message}"; } finally { _loading = false; } } Task OnSearchAsync() => LoadAsync(); void ApplyFilter() => _filtered = _activeFilter switch { "Active" => _items.Where(x => x.IsActive).ToList(), "Inactive" => _items.Where(x => !x.IsActive).ToList(), _ => [.. _items] }; void SetFilter(string? filter) { _activeFilter = filter; ApplyFilter(); } void OnRowSelected(RowSelectEventArgs<TaskTypeDto> args) => OpenEdit(args.Data); void OpenCreate() { _editId = null; _form = new(); _showForm = true; } void OpenEdit(TaskTypeDto item) { _editId = item.TaskTypeId; _form = new() { TaskTypeCode = item.TaskTypeCode, TaskTypeName = item.TaskTypeName, Description = item.Description, SortOrder = item.SortOrder, IsActive = item.IsActive }; _showForm = true; } void ConfirmDelete(TaskTypeDto item) { _deleteTarget = item; _showDelete = true; } async Task SaveAsync() { _saving = true; try { if (_editId.HasValue) await Api.UpdateTaskTypeAsync(_editId.Value, new() { TaskTypeCode = _form.TaskTypeCode, TaskTypeName = _form.TaskTypeName, Description = _form.Description, SortOrder = _form.SortOrder, IsActive = _form.IsActive, ModifiedByUserId = TenantAdminUserId }); else await Api.CreateTaskTypeAsync(new() { TenantId = TenantId, TaskTypeCode = _form.TaskTypeCode, TaskTypeName = _form.TaskTypeName, Description = _form.Description, SortOrder = _form.SortOrder, IsActive = _form.IsActive, CreatedByUserId = TenantAdminUserId }); _showForm = false; await _toast.ShowAsync(new() { Content = _editId.HasValue ? "Task type updated" : "Task type created", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } async Task ExecuteDeleteAsync() { if (_deleteTarget is null) return; _saving = true; try { await Api.DeleteTaskTypeAsync(_deleteTarget.TaskTypeId, TenantAdminUserId); _showDelete = false; await _toast.ShowAsync(new() { Content = "Task type deleted", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } void ResetForm() { _form = new(); _editId = null; } sealed class TaskTypeForm { [Required, StringLength(50)] public string TaskTypeCode { get; set; } = string.Empty; [Required, StringLength(100)] public string TaskTypeName { get; set; } = string.Empty; [StringLength(500)] public string? Description { get; set; } [Range(0, 9999)] public int SortOrder { get; set; } = 100; public bool IsActive { get; set; } = true; } 
    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
