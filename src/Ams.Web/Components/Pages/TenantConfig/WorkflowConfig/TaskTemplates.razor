        [Required, StringLength(80)] public string Code { get; set; } = string.Empty;
        [Required, StringLength(200)] public string Name { get; set; } = string.Empty;
        [Required, StringLength(120)] public string Category { get; set; } = string.Empty;
        [Required, StringLength(120)] public string OwnerTeam { get; set; } = string.Empty;
        [StringLength(500)] public string? Description { get; set; }
        [Range(0, 720)] public int SlaHours { get; set; }
        [Required, StringLength(40)] public string Automation { get; set; } = "Manual";
        [StringLength(200)] public string? Trigger { get; set; }
        [Range(1, 100)] public int Importance { get; set; } = 60;
        [Range(0, 9999)] public int SortOrder { get; set; }
