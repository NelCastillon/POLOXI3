@page "/tenant/workflows/dashboard"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.WorkflowConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Workflow Dashboard Command Center - AMS</PageTitle>

<div class="wr-page" @onclick="CloseActionMenu">
    <section class="wr-hero">
        <div class="wr-hero__content">
            <div class="wr-hero-left">
                <span class="wr-hero-icon"><i class="bi bi-node-plus" aria-hidden="true"></i></span>
                <div class="wr-hero-title">
                    <div class="wr-hero__eyebrow">Enterprise workflow dashboard command center</div>
                    <div class="wr-title-row">
                        <h1>Workflow Dashboard</h1>
                        <div class="wr-hero__meta">
                            <span><i class="bi bi-diagram-3" aria-hidden="true"></i>@_items.Count rules</span>
                            <span><i class="bi bi-check-circle" aria-hidden="true"></i>@_items.Count(r => r.IsActive) active</span>
                            <span><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>@_items.Count(IsHighImportance) high importance</span>
                            <span><i class="bi bi-code-slash" aria-hidden="true"></i>@_items.Count(HasConfiguration) configured</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Monitor workflow rule health, automation readiness, configuration gaps, and operational controls across tenant workflows.</p>
        </div>
        <div class="wr-hero__actions">
            <button type="button" class="wr-btn wr-btn--light" @onclick="RefreshAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "wr-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="wr-btn wr-btn--light" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="wr-btn wr-btn--primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Automation</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger wr-alert" style="border-left: 4px solid #dc3545; animation: wr-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="wr-kpi-strip" aria-label="Workflow rule KPIs">
        @KpiCard("all", "Automations", _items.Count.ToString(), "All workflow automations", "bi-diagram-3", "blue")
        @KpiCard("active", "Active", _items.Count(r => r.IsActive).ToString(), "Rules currently eligible to run", "bi-check-circle", "green")
        @KpiCard("importance", "Important", _items.Count(IsHighImportance).ToString(), "High-impact automation rules", "bi-exclamation-octagon", "red")
        @KpiCard("configured", "Configured", _items.Count(HasConfiguration).ToString(), "Rules with JSON configuration", "bi-code-slash", "purple")
        @KpiCard("needsconfig", "Needs Config", _items.Count(NeedsConfiguration).ToString(), "Active rules missing configuration", "bi-braces", "amber")
        @KpiCard("inactive", "Inactive", _items.Count(r => !r.IsActive).ToString(), "Rules currently paused", "bi-pause-circle", "cyan")
    </section>

    <section class="wr-workflows" aria-label="Workflow shortcuts">
        @WorkflowButton("Command review", "Prioritize high-impact automations", "bi-shield-exclamation", () => SetDashboardFocus("importance", "importance"))
        @WorkflowButton("Configuration gaps", "Find active rules missing JSON", "bi-braces", () => SetDashboardFocus("needsconfig", "importance"))
        @WorkflowButton("Active automations", "Review running rules", "bi-play-circle", () => SetDashboardFocus("active", "sort"))
        @WorkflowButton("Paused rules", "Audit inactive rules", "bi-pause-circle", () => SetDashboardFocus("inactive", "name"))
        @WorkflowButton("SLA setup", "Open SLA policy setup", "bi-clock-history", () => Nav.NavigateTo("/tenant/workflows/sla"))
    </section>

    <section class="wr-filter-panel" aria-label="Workflow rule filters">
        <div class="wr-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" placeholder="Search code, name, category, description, or configuration..." aria-label="Search workflow dashboard" value="@_searchTerm" @oninput="OnSearchInput" />
        </div>
        <div class="wr-filter-grid">
            <label><span>Status</span><select class="form-select" @bind="_statusFilter" @bind:after="ApplyFilters"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option></select></label>
            <label><span>Category</span><select class="form-select" @bind="_categoryFilter" @bind:after="ApplyFilters"><option value="">All categories</option>@foreach (var category in CategoryOptions) { <option value="@category">@category</option> }</select></label>
            <label><span>Importance</span><select class="form-select" @bind="_importanceFilter" @bind:after="ApplyFilters"><option value="">All levels</option><option value="Critical">Critical</option><option value="High">High</option><option value="Medium">Medium</option><option value="Low">Low</option></select></label>
            <label><span>Sort</span><select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters"><option value="importance">Importance</option><option value="name">Name</option><option value="category">Category</option><option value="sort">Sort order</option><option value="created">Newest</option></select></label>
        </div>
        <button type="button" class="wr-btn wr-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
    </section>

    <nav class="wr-tabs" aria-label="Workflow rule views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="wr-tab @(_activeTab == tab.Key ? "wr-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i><span>@tab.Label</span><strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </nav>

    <main class="wr-dashboard">
        <section class="wr-main-card">
            <div class="wr-card-header">
                <div><span class="wr-section-kicker">@ActiveViewTitle</span><h2>@FilteredItems.Count() rules</h2><p>Ranked by enterprise importance: active state, missing configuration, configuration complexity, category coverage, and execution order.</p></div>
                <div class="wr-card-actions">
                    <button type="button" class="wr-btn wr-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="wr-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="wr-btn wr-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="wr-loading"><span class="wr-spinner"></span> Loading workflow rules...</div>
            }
            else if (!FilteredItems.Any())
            {
                <div class="wr-empty"><i class="bi bi-diagram-3" aria-hidden="true"></i><strong>No workflow rules found</strong><span>Adjust the active tab, KPI, search, or filters.</span></div>
            }
            else
            {
                <div class="wr-table-wrap">
                    <table class="wr-table" aria-label="Workflow rules">
                        <thead><tr><th>Importance</th><th>Automation</th><th>Category</th><th>Status</th><th>Configuration</th><th>Order</th><th>Created</th><th class="wr-actions-col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var item in PagedItems)
                            {
                                <tr class="@(_selected?.WorkflowConfigItemId == item.WorkflowConfigItemId ? "wr-row wr-row--selected" : "wr-row")" @onclick="() => SelectRow(item)">
                                    <td>@ImportanceBadge(item)</td>
                                    <td><div class="wr-rule-cell"><div class="wr-rule-icon"><i class="bi bi-node-plus" aria-hidden="true"></i></div><div class="wr-rule-meta"><button type="button" class="wr-link-button" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)">@item.Name</button><small>@item.Code</small></div></div></td>
                                    <td><span class="wr-pill wr-pill--blue">@Safe(item.Category, "General")</span></td>
                                    <td>@StatusBadge(item)</td>
                                    <td>@ConfigurationBadge(item)</td>
                                    <td><span class="wr-count-pill">@item.SortOrder</span></td>
                                    <td><span class="wr-date">@item.CreatedDateUtc.ToString("MMM d, yyyy")</span></td>
                                    <td class="wr-actions-col"><button type="button" class="wr-icon-btn" title="Open action menu" @onclick:stopPropagation="true" @onclick="() => ToggleActionMenu(item)"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>@if (_openActionMenuFor == item.WorkflowConfigItemId) { <div class="wr-menu" role="menu" @onclick:stopPropagation="true"><div class="wr-menu__summary"><strong>@item.Name</strong><span>@item.Code</span></div><button type="button" class="wr-menu-item" role="menuitem" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i><span>Edit rule</span></button><button type="button" class="wr-menu-item" role="menuitem" @onclick="() => OpenClone(item)"><i class="bi bi-copy" aria-hidden="true"></i><span>Clone rule</span></button><button type="button" class="wr-menu-item" role="menuitem" @onclick="() => ConfirmToggleActive(item)"><i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i><span>@(item.IsActive ? "Pause" : "Activate")</span></button><button type="button" class="wr-menu-item wr-menu-item--danger" role="menuitem" @onclick="() => ConfirmDelete(item)"><i class="bi bi-trash3" aria-hidden="true"></i><span>Delete rule</span></button></div> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="wr-side-panel">
            <section class="wr-panel-card">
                <span class="wr-section-kicker">Selected rule</span>
                @if (_selected is null)
                {
                    <div class="wr-empty wr-empty--compact"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a rule</strong><span>Choose a workflow rule to inspect automation importance and actions.</span></div>
                }
                else
                {
                    <div class="wr-selected"><div class="wr-selected__title"><div class="wr-rule-icon wr-rule-icon--lg"><i class="bi bi-node-plus"></i></div><div><h3>@_selected.Name</h3><span>@_selected.Code</span></div></div><div class="wr-score-card wr-score-card--@ImportanceTone(_selected)"><span>Rule importance score</span><strong>@ImportanceScore(_selected)</strong><small>@ImportanceLevel(_selected)</small></div><dl class="wr-detail-list"><div><dt>Category</dt><dd>@Safe(_selected.Category, "General")</dd></div><div><dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd></div><div><dt>Configuration</dt><dd>@ConfigurationText(_selected)</dd></div><div><dt>Sort order</dt><dd>@_selected.SortOrder</dd></div><div><dt>Created</dt><dd>@_selected.CreatedDateUtc.ToString("MMM d, yyyy")</dd></div></dl>@if (!string.IsNullOrWhiteSpace(_selected.Description)) { <p class="wr-selected-desc">@_selected.Description</p> }<div class="wr-selected-actions"><button type="button" class="wr-btn wr-btn--primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="wr-btn wr-btn--ghost" @onclick="() => OpenClone(_selected)"><i class="bi bi-copy" aria-hidden="true"></i> Clone</button><button type="button" class="wr-btn wr-btn--ghost" @onclick="() => ConfirmToggleActive(_selected)"><i class="bi @(_selected.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i> @(_selected.IsActive ? "Pause" : "Activate")</button></div></div>
                }
            </section>
            <section class="wr-panel-card"><span class="wr-section-kicker">Workflow intelligence</span><div class="wr-insight-list">@foreach (var insight in Insights) { <div class="wr-insight"><i class="bi @insight.Icon" aria-hidden="true"></i><div><strong>@insight.Title</strong><span>@insight.Description</span></div></div> }</div></section>
        </aside>
    </main>
</div>

@if (_showForm)
{
    <div class="wr-modal-backdrop" role="presentation" @onclick="CloseForm"><div class="wr-modal" role="dialog" aria-modal="true" aria-labelledby="wr-form-title" @onclick:stopPropagation="true"><div class="wr-modal__header"><i class="bi @(_editId.HasValue ? "bi-pencil-square" : "bi-plus-circle")" aria-hidden="true"></i><span id="wr-form-title">@(_editId.HasValue ? "Edit Workflow Rule" : _isClone ? "Clone Workflow Rule" : "Add Workflow Rule")</span><button type="button" class="wr-icon-btn wr-icon-btn--light ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div><EditForm EditContext="@_editContext" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="wr-modal__body"><div class="wr-form-grid"><label class="wr-field"><span>Code <em>*</em></span><InputText @bind-Value="_form.Code" class="form-control" /></label><label class="wr-field"><span>Name <em>*</em></span><InputText @bind-Value="_form.Name" class="form-control" /></label><label class="wr-field"><span>Category</span><InputText @bind-Value="_form.Category" class="form-control" /></label><label class="wr-field"><span>Sort Order</span><InputNumber @bind-Value="_form.SortOrder" class="form-control" /></label><label class="wr-field wr-field--full"><span>Description</span><InputTextArea @bind-Value="_form.Description" class="form-control" rows="3" /></label><label class="wr-field wr-field--full"><span>Configuration JSON</span><InputTextArea @bind-Value="_form.ConfigurationJson" class="form-control wr-json" rows="6" /></label><label class="wr-check-row"><InputCheckbox @bind-Value="_form.IsActive" /><span>Active</span></label></div>@if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger wr-form-alert" style="border-left: 4px solid #dc3545; animation: wr-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> @_formError</div> }</div><div class="wr-modal__footer"><button type="button" class="wr-btn wr-btn--ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="wr-btn wr-btn--primary" disabled="@_saving">@if (_saving) { <span class="wr-spin-sm" aria-hidden="true"></span> } @(_editId.HasValue ? "Save Changes" : _isClone ? "Clone Rule" : "Create Rule")</button></div></EditForm></div></div>
}

@if (_showConfirm)
{
    <div class="wr-modal-backdrop" role="presentation" @onclick="CloseConfirm"><div class="wr-confirm" role="dialog" aria-modal="true" aria-labelledby="wr-confirm-title" @onclick:stopPropagation="true"><div class="wr-modal__header"><i class="bi @_confirmIcon" aria-hidden="true"></i><span>Confirm action</span><button type="button" class="wr-icon-btn wr-icon-btn--light ms-auto" @onclick="CloseConfirm" disabled="@_saving"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div><div class="wr-confirm__body"><div class="@(_confirmDanger ? "wr-confirm-icon wr-confirm-icon--danger" : "wr-confirm-icon")"><i class="bi @_confirmIcon" aria-hidden="true"></i></div><div><h3 id="wr-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div></div><div class="wr-modal__footer"><button type="button" class="wr-btn wr-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button><button type="button" class="@(_confirmDanger ? "wr-btn wr-btn--danger" : "wr-btn wr-btn--primary")" @onclick="ExecuteConfirmedActionAsync" disabled="@_saving">@if (_saving) { <span class="wr-spin-sm" aria-hidden="true"></span> } Confirm</button></div></div></div>
}

<div class="wr-toast-stack" aria-live="polite" aria-atomic="true">@foreach (var toast in _toasts) { <div class="wr-toast @toast.CssClass"><i class="bi @(toast.CssClass.Contains("danger") ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)"><i class="bi bi-x" aria-hidden="true"></i></button></div> }</div>

@code {
    private const string Kind = "WorkflowRule";
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private readonly TabDef[] _tabs = [new("all", "All", "bi-diagram-3"), new("importance", "Important", "bi-exclamation-octagon"), new("active", "Active", "bi-check-circle"), new("needsconfig", "Needs Config", "bi-braces"), new("configured", "Configured", "bi-code-slash"), new("inactive", "Inactive", "bi-pause-circle")];
    private readonly InsightDef[] _baselineInsights = [new("Automation hygiene", "Keep active rules configured with valid JSON before publishing workflows.", "bi-braces"), new("Execution order", "Use sort order to make high-priority rules deterministic.", "bi-sort-numeric-down"), new("Lifecycle control", "Pause or delete rules that no longer support tenant operations.", "bi-arrow-left-right")];
    private List<WorkflowConfigItemDto> _items = [];
    private WorkflowConfigItemDto? _selected;
    private bool _loading = true;
    private string? _loadError;
    private CancellationTokenSource _cts = new();
    private string _activeTab = "all";
    private string _activeKpi = "all";
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private string _categoryFilter = string.Empty;
    private string _importanceFilter = string.Empty;
    private string _sortMode = "importance";
    private int _page = 1;
    private const int PageSize = 12;
    private Guid? _openActionMenuFor;
    private bool _showForm;
    private bool _saving;
    private string _formError = string.Empty;
    private Guid? _editId;
    private bool _isClone;
    private FormModel _form = new();
    private EditContext _editContext = default!;
    private bool _showConfirm;
    private bool _confirmDanger;
    private string _confirmTitle = string.Empty;
    private string _confirmMessage = string.Empty;
    private string _confirmIcon = "bi-question-circle";
    private Func<Task>? _confirmedAction;
    private readonly List<ToastMessage> _toasts = [];

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Workflow Config", null), new("Workflow Dashboard", null));
        _editContext = new(_form);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();
        try
        {
            await _cts.CancelAsync();
            _cts = new CancellationTokenSource();
            var result = await Api.SearchWorkflowConfigItemsAsync(_tenantId, Kind, _searchTerm.Trim(), 1, 500, _cts.Token);
            _items = result?.Items.ToList() ?? [];
            _selected = _selected is null ? _items.OrderByDescending(ImportanceScore).FirstOrDefault() : _items.FirstOrDefault(i => i.WorkflowConfigItemId == _selected.WorkflowConfigItemId) ?? _items.OrderByDescending(ImportanceScore).FirstOrDefault();
            _page = 1;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _loadError = $"Failed to load workflow rules: {ex.Message}"; ShowToast($"Load failed: {ex.Message}", "wr-toast--danger"); }
        finally { _loading = false; StateHasChanged(); }
    }

    private Task RefreshAsync() => LoadAsync();
    private System.Timers.Timer? _debounce;
    private async Task OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _searchTerm = e.Value?.ToString() ?? string.Empty; _debounce?.Dispose(); _debounce = new System.Timers.Timer(360) { AutoReset = false }; _debounce.Elapsed += async (_, _) => { _debounce?.Dispose(); _debounce = null; await InvokeAsync(LoadAsync); }; _debounce.Start(); await Task.CompletedTask; }
    private void SetActiveKpi(string key) { _activeKpi = _activeKpi == key ? "all" : key; _activeTab = _activeKpi switch { "importance" => "importance", "active" => "active", "needsconfig" => "needsconfig", "configured" => "configured", "inactive" => "inactive", _ => "all" }; _page = 1; }
    private void SetActiveTab(string key) { _activeTab = key; _activeKpi = key is "importance" or "active" or "needsconfig" or "configured" or "inactive" ? key : "all"; _page = 1; }
    private void SetDashboardFocus(string tab, string sortMode) { _activeTab = tab; _activeKpi = tab is "importance" or "active" or "needsconfig" or "configured" or "inactive" ? tab : "all"; _sortMode = sortMode; _page = 1; }
    private void ApplyFilters() => _page = 1;
    private void ClearFilters() { _searchTerm = string.Empty; _statusFilter = string.Empty; _categoryFilter = string.Empty; _importanceFilter = string.Empty; _sortMode = "importance"; _activeTab = "all"; _activeKpi = "all"; _page = 1; _ = LoadAsync(); }
    private bool HasFilters => !string.IsNullOrEmpty(_searchTerm) || !string.IsNullOrEmpty(_statusFilter) || !string.IsNullOrEmpty(_categoryFilter) || !string.IsNullOrEmpty(_importanceFilter) || _sortMode != "importance" || _activeTab != "all";
    private IEnumerable<WorkflowConfigItemDto> TabFiltered => _activeTab switch { "importance" => _items.Where(IsHighImportance), "active" => _items.Where(i => i.IsActive), "needsconfig" => _items.Where(NeedsConfiguration), "configured" => _items.Where(HasConfiguration), "inactive" => _items.Where(i => !i.IsActive), _ => _items };
    private IEnumerable<WorkflowConfigItemDto> FilteredItems { get { var query = TabFiltered; if (!string.IsNullOrEmpty(_statusFilter)) query = query.Where(i => string.Equals(_statusFilter, "Active", StringComparison.OrdinalIgnoreCase) ? i.IsActive : !i.IsActive); if (!string.IsNullOrEmpty(_categoryFilter)) query = query.Where(i => string.Equals(Safe(i.Category, "General"), _categoryFilter, StringComparison.OrdinalIgnoreCase)); if (!string.IsNullOrEmpty(_importanceFilter)) query = query.Where(i => ImportanceLevel(i) == _importanceFilter); return _sortMode switch { "name" => query.OrderBy(i => i.Name), "category" => query.OrderBy(i => Safe(i.Category, "General")).ThenBy(i => i.Name), "sort" => query.OrderBy(i => i.SortOrder).ThenBy(i => i.Name), "created" => query.OrderByDescending(i => i.CreatedDateUtc), _ => query.OrderByDescending(ImportanceScore).ThenBy(i => i.SortOrder).ThenBy(i => i.Name) }; } }
    private IEnumerable<WorkflowConfigItemDto> PagedItems => FilteredItems.Skip((_page - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredItems.Count() / (double)PageSize));
    private void PreviousPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private string ActiveViewTitle => _tabs.FirstOrDefault(t => t.Key == _activeTab)?.Label ?? "Workflow Rules";
    private int TabCount(string key) => key switch { "importance" => _items.Count(IsHighImportance), "active" => _items.Count(i => i.IsActive), "needsconfig" => _items.Count(NeedsConfiguration), "configured" => _items.Count(HasConfiguration), "inactive" => _items.Count(i => !i.IsActive), _ => _items.Count };
    private IEnumerable<string> CategoryOptions => _items.Select(i => Safe(i.Category, "General")).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c);
    private void SelectRow(WorkflowConfigItemDto item) { _selected = item; _openActionMenuFor = null; }
    private void ToggleActionMenu(WorkflowConfigItemDto item) { _selected = item; _openActionMenuFor = _openActionMenuFor == item.WorkflowConfigItemId ? null : item.WorkflowConfigItemId; }
    private void CloseActionMenu() { if (!_saving) _openActionMenuFor = null; }
    private void OpenCreate() { _editId = null; _isClone = false; _form = new() { ConfigurationJson = "{}", IsActive = true }; _editContext = new(_form); _formError = string.Empty; _showForm = true; _openActionMenuFor = null; }
    private void OpenEdit(WorkflowConfigItemDto item) { _editId = item.WorkflowConfigItemId; _isClone = false; _form = new() { Code = item.Code, Name = item.Name, Category = item.Category, Description = item.Description, ConfigurationJson = item.ConfigurationJson, SortOrder = item.SortOrder, IsActive = item.IsActive }; _editContext = new(_form); _formError = string.Empty; _showForm = true; _openActionMenuFor = null; }
    private void OpenClone(WorkflowConfigItemDto item) { _editId = null; _isClone = true; _form = new() { Code = $"{item.Code}_COPY", Name = $"{item.Name} (Copy)", Category = item.Category, Description = item.Description, ConfigurationJson = item.ConfigurationJson, SortOrder = item.SortOrder, IsActive = item.IsActive }; _editContext = new(_form); _formError = string.Empty; _showForm = true; _openActionMenuFor = null; }
    private void CloseForm() { if (!_saving) { _showForm = false; _formError = string.Empty; } }
    private async Task SaveAsync() { if (_saving) return; _formError = string.Empty; _saving = true; try { if (_editId.HasValue) { await Api.UpdateWorkflowConfigItemAsync(_editId.Value, new(_form.Code.Trim(), _form.Name.Trim(), _form.Category?.Trim(), _form.Description?.Trim(), _form.ConfigurationJson?.Trim(), _form.IsActive, _form.SortOrder)); ShowToast($"Workflow rule '{_form.Name}' updated.", "wr-toast--success"); } else { await Api.CreateWorkflowConfigItemAsync(new(_tenantId, Kind, _form.Code.Trim(), _form.Name.Trim(), _form.Category?.Trim(), _form.Description?.Trim(), _form.ConfigurationJson?.Trim(), _form.SortOrder)); ShowToast($"Workflow rule '{_form.Name}' {(_isClone ? "cloned" : "created")}.", "wr-toast--success"); } _showForm = false; await LoadAsync(); } catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; ShowToast($"Save failed: {ex.Message}", "wr-toast--danger"); } finally { _saving = false; } }
    private void ConfirmToggleActive(WorkflowConfigItemDto item) { OpenConfirm(item.IsActive ? "Pause workflow rule?" : "Activate workflow rule?", $"{(item.IsActive ? "Pause" : "Activate")} {item.Name}?", item.IsActive ? "bi-pause-circle" : "bi-play-circle", item.IsActive, () => ToggleActiveAsync(item)); }
    private async Task ToggleActiveAsync(WorkflowConfigItemDto item) { try { await Api.UpdateWorkflowConfigItemAsync(item.WorkflowConfigItemId, new(item.Code, item.Name, item.Category, item.Description, item.ConfigurationJson, !item.IsActive, item.SortOrder)); CloseConfirm(); ShowToast($"Workflow rule '{item.Name}' {(!item.IsActive ? "activated" : "paused")}.", "wr-toast--success"); await LoadAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"Status update failed: {ex.Message}", "wr-toast--danger"); } }
    private void ConfirmDelete(WorkflowConfigItemDto item) => OpenConfirm("Delete workflow rule?", $"Delete {item.Name}? This cannot be undone.", "bi-trash3", true, () => DeleteAsync(item));
    private async Task DeleteAsync(WorkflowConfigItemDto item) { try { await Api.DeleteWorkflowConfigItemAsync(item.WorkflowConfigItemId); CloseConfirm(); ShowToast($"Workflow rule '{item.Name}' deleted.", "wr-toast--success"); await LoadAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"Delete failed: {ex.Message}", "wr-toast--danger"); } }
    private void OpenConfirm(string title, string message, string icon, bool danger, Func<Task> action) { _confirmTitle = title; _confirmMessage = message; _confirmIcon = icon; _confirmDanger = danger; _confirmedAction = action; _showConfirm = true; _openActionMenuFor = null; }
    private void CloseConfirm() { if (!_saving) { _showConfirm = false; _confirmedAction = null; } }
    private async Task ExecuteConfirmedActionAsync() { if (_confirmedAction is null) return; _saving = true; try { await _confirmedAction.Invoke(); } finally { _saving = false; } }
    private Task ExportAsync() { ShowToast("Workflow rules export prepared from the current dashboard view.", "wr-toast--success"); return Task.CompletedTask; }
    private void ShowToast(string message, string cssClass) { var toast = new ToastMessage(Guid.NewGuid(), message, cssClass); _toasts.Add(toast); _ = Task.Run(async () => { await Task.Delay(2800); await InvokeAsync(() => DismissToast(toast.Id)); }); }
    private void DismissToast(Guid id) { _toasts.RemoveAll(t => t.Id == id); StateHasChanged(); }
    private static bool HasConfiguration(WorkflowConfigItemDto item) => !string.IsNullOrWhiteSpace(item.ConfigurationJson) && item.ConfigurationJson.Trim() != "{}";
    private static bool NeedsConfiguration(WorkflowConfigItemDto item) => item.IsActive && !HasConfiguration(item);
    private static bool IsHighImportance(WorkflowConfigItemDto item) => ImportanceScore(item) >= 40;
    private static int ImportanceScore(WorkflowConfigItemDto item) { var score = 0; if (item.IsActive) score += 20; if (NeedsConfiguration(item)) score += 35; if (HasConfiguration(item)) score += 15; if (!string.IsNullOrWhiteSpace(item.Category)) score += 8; if (item.SortOrder <= 10) score += 12; if ((DateTime.UtcNow - item.CreatedDateUtc).TotalDays <= 14) score += 8; return Math.Clamp(score, 0, 100); }
    private static string ImportanceLevel(WorkflowConfigItemDto item) => ImportanceScore(item) switch { >= 70 => "Critical", >= 40 => "High", >= 20 => "Medium", _ => "Low" };
    private static string ImportanceTone(WorkflowConfigItemDto item) => ImportanceLevel(item) switch { "Critical" => "red", "High" => "amber", "Medium" => "cyan", _ => "green" };
    private IEnumerable<InsightDef> Insights { get { var list = new List<InsightDef>(); var gaps = _items.Count(NeedsConfiguration); if (gaps > 0) list.Add(new("Configuration gaps", $"{gaps} active rule(s) need configuration JSON.", "bi-braces")); var important = _items.Count(IsHighImportance); if (important > 0) list.Add(new("High importance", $"{important} workflow rule(s) need priority review.", "bi-exclamation-octagon")); var inactive = _items.Count(i => !i.IsActive); if (inactive > 0) list.Add(new("Paused automation", $"{inactive} rule(s) are inactive.", "bi-pause-circle")); list.AddRange(_baselineInsights); return list.Take(5); } }
    private static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static string ConfigurationText(WorkflowConfigItemDto item) => HasConfiguration(item) ? "Configured" : "Missing";
    private RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string tone) { var cardClass = $"wr-kpi-card wr-kpi-card--{tone} {(_activeKpi == key ? "wr-kpi-card--active" : string.Empty)}"; return @<button type="button" class="@cardClass" title="@subtitle" @onclick="() => SetActiveKpi(key)"><div class="wr-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></div><div class="wr-kpi-body"><span class="wr-kpi-label">@label</span><strong class="wr-kpi-value">@value</strong><span class="wr-kpi-sub">@subtitle</span></div></button>; }
    private RenderFragment WorkflowButton(string title, string description, string icon, System.Action onClick) => @<button type="button" class="wr-workflow" @onclick="onClick"><div class="wr-workflow-icon"><i class="bi @icon" aria-hidden="true"></i></div><div class="wr-workflow-meta"><strong>@title</strong><span>@description</span></div></button>;
    private RenderFragment ImportanceBadge(WorkflowConfigItemDto item) { var badgeClass = $"wr-risk-badge wr-risk-badge--{ImportanceTone(item)}"; return @<span class="@badgeClass" title="Workflow importance score: @ImportanceScore(item)/100"><i class="bi bi-shield-fill" aria-hidden="true"></i> @ImportanceLevel(item)</span>; }
    private RenderFragment StatusBadge(WorkflowConfigItemDto item) { var badgeClass = $"wr-pill {(item.IsActive ? "wr-pill--green" : "wr-pill--neutral")}"; var icon = item.IsActive ? "bi-check-circle-fill" : "bi-pause-circle"; var text = item.IsActive ? "Active" : "Inactive"; return @<span class="@badgeClass"><i class="bi @icon" aria-hidden="true"></i>@text</span>; }
    private RenderFragment ConfigurationBadge(WorkflowConfigItemDto item) { var badgeClass = $"wr-pill {(HasConfiguration(item) ? "wr-pill--purple" : "wr-pill--amber")}"; var icon = HasConfiguration(item) ? "bi-code-slash" : "bi-braces"; return @<span class="@badgeClass"><i class="bi @icon" aria-hidden="true"></i>@ConfigurationText(item)</span>; }
    private sealed class FormModel { [Required(ErrorMessage = "Code is required.")][StringLength(80)] public string Code { get; set; } = string.Empty; [Required(ErrorMessage = "Name is required.")][StringLength(200)] public string Name { get; set; } = string.Empty; [StringLength(120)] public string? Category { get; set; } [StringLength(500)] public string? Description { get; set; } [StringLength(4000)] public string? ConfigurationJson { get; set; } [Range(0, 9999)] public int SortOrder { get; set; } public bool IsActive { get; set; } = true; }
    private sealed record TabDef(string Key, string Label, string Icon);
    private sealed record InsightDef(string Title, string Description, string Icon);
    private sealed record ToastMessage(Guid Id, string Message, string CssClass);
}
