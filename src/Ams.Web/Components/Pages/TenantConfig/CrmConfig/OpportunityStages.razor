@page "/tenant/crm/opp-stages"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Opportunity Stages — CRM Configuration</PageTitle>

<AppPageHeader Title="Opportunity Stages"
               Subtitle="Configure the sales pipeline stages for opportunity tracking"
               Icon="bi-bar-chart-steps">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Stage
        </button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
    </Actions>
</AppPageHeader>

<div class="pc-kpi-strip">
    <div class="pc-kpi-card @(_activeFilter == null ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter(null)' title="Show all">
        <span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-bar-chart-steps" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total Stages</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "open" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("open")' title="Filter: Open Stages">
        <span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-funnel-fill" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => !x.IsClosedStage)</div><div class="pc-kpi-label">Open Stages</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "won" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("won")' title="Filter: Won">
        <span class="pc-kpi-icon" style="background:#dcfce7"><i class="bi bi-trophy-fill text-success" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.IsWonStage)</div><div class="pc-kpi-label">Won</div></div>
    </div>
</div>

<AppFilterPanel @bind-SearchValue="_search" OnSearch="OnSearchAsync" SearchPlaceholder="Search stage name or code…" />

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

<div class="um-grid-card">
    @if (_loading)
    {
        <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div>
    }
    <SfGrid TValue="OpportunityStageDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
        <GridEvents TValue="OpportunityStageDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="50" />
        <GridColumns>
            <GridColumn Field="StageCode" HeaderText="Code" Width="130" />
            <GridColumn Field="StageName" HeaderText="Stage" Width="200" />
            <GridColumn Field="ProbabilityPercent" HeaderText="Probability %" Width="130" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (OpportunityStageDto)context; }
                    <div class="d-flex align-items-center gap-2">
                        <div class="progress flex-grow-1" style="height:6px">
                            <div class="progress-bar bg-primary" style="width:@r.ProbabilityPercent%"></div>
                        </div>
                        <span class="text-muted small">@r.ProbabilityPercent%</span>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="SortOrder" HeaderText="Order" Width="80" TextAlign="TextAlign.Center" />
            <GridColumn Field="IsClosedStage" HeaderText="Closed" Width="90" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (OpportunityStageDto)context; }
                    <span class="um-badge @(r.IsClosedStage ? "um-badge-neutral" : "um-badge-success")">@(r.IsClosedStage ? "Yes" : "No")</span>
                </Template>
            </GridColumn>
            <GridColumn Field="IsActive" HeaderText="Status" Width="100" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (OpportunityStageDto)context; }
                    <span class="um-badge @(r.IsActive ? "um-badge-success" : "um-badge-neutral")">@(r.IsActive ? "Active" : "Inactive")</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="100" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (OpportunityStageDto)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(r)" @onclick:stopPropagation="true"><i class="bi bi-pencil"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDelete(r)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showForm" Width="540px" IsModal="true" ShowCloseIcon="false">
    <DialogEvents Closed="ResetForm" />
    <DialogContent>
        <div class="um-modal-header">
            <i class="bi bi-bar-chart-steps"></i>
            <span>@(_editId.HasValue ? "Edit Stage" : "Add Opportunity Stage")</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button>
        </div>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="um-field">
                        <label>Stage Code <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.StageCode" class="um-input" />
                        <ValidationMessage For="() => _form.StageCode" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Stage Name <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.StageName" class="um-input" />
                        <ValidationMessage For="() => _form.StageName" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Probability %</label>
                        <InputNumber @bind-Value="_form.ProbabilityPercent" class="um-input" min="0" max="100" />
                    </div>
                    <div class="um-field">
                        <label>Sort Order</label>
                        <InputNumber @bind-Value="_form.SortOrder" class="um-input" />
                    </div>
                    <div class="um-field um-field--checkbox">
                        <label><InputCheckbox @bind-Value="_form.IsClosedStage" /> Closed Stage</label>
                    </div>
                    <div class="um-field um-field--checkbox">
                        <label><InputCheckbox @bind-Value="_form.IsWonStage" /> Won Stage</label>
                    </div>
                    <div class="um-field um-field--checkbox">
                        <label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label>
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button>
            </div>
        </EditForm>
    </DialogContent>
</SfDialog>

<SfDialog @bind-Visible="_showDelete" Width="440px" IsModal="true" ShowCloseIcon="false">
    <DialogContent>
        <div class="um-confirm-dialog">
            <div class="um-confirm-icon um-confirm-icon--danger">
                <i class="bi bi-trash3-fill"></i>
            </div>
            <div class="um-confirm-message">
                <h6>Delete Stage?</h6>
                <p>You are about to delete <strong>@_deleteTarget?.StageName</strong>. This action cannot be undone.</p>
            </div>
            <div class="um-modal-footer" style="width:100%">
                <button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button>
            </div>
        </div>
    </DialogContent>
</SfDialog>

<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    Guid TenantId { get; set; }
    List<OpportunityStageDto> _items = [], _filtered = [];
    string? _activeFilter;
    bool _loading, _saving;
    string _search = string.Empty;
    string? _loadError;
    bool _showForm, _showDelete;
    Guid? _editId;
    OpportunityStageDto? _deleteTarget;
    SfToast _toast = default!;
    OppStageFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM Config", null), new("Opportunity Stages", null));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try { var r = await Api.SearchOpportunityStagesAsync(TenantId, _search, pageSize: 200); _items = r?.Items.ToList() ?? []; ApplyFilter(); }
        catch (Exception ex) { _loadError = $"Failed to load opportunity stages: {ex.Message}"; }
        finally { _loading = false; }
    }

    Task OnSearchAsync() => LoadAsync();

    void ApplyFilter() => _filtered = _activeFilter switch
    {
        "open" => _items.Where(x => !x.IsClosedStage).ToList(),
        "won"  => _items.Where(x => x.IsWonStage).ToList(),
        _      => [.. _items]
    };

    void SetFilter(string? key) { _activeFilter = key; ApplyFilter(); }
    void OnRowSelected(RowSelectEventArgs<OpportunityStageDto> args) => OpenEdit(args.Data);

    void OpenCreate() { _editId = null; _form = new(); _showForm = true; }

    void OpenEdit(OpportunityStageDto item)
    {
        _editId = item.OpportunityStageId;
        _form = new() { StageCode = item.StageCode, StageName = item.StageName, SortOrder = item.SortOrder, ProbabilityPercent = item.ProbabilityPercent, IsClosedStage = item.IsClosedStage, IsWonStage = item.IsWonStage, IsActive = item.IsActive };
        _showForm = true;
    }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue)
                await Api.UpdateOpportunityStageAsync(_editId.Value, new Ams.Application.Features.CrmConfig.UpdateOpportunityStageRequest(_form.StageCode, _form.StageName, _form.SortOrder, _form.ProbabilityPercent, _form.IsClosedStage, _form.IsWonStage, _form.IsActive));
            else
                await Api.CreateOpportunityStageAsync(new(TenantId, _form.StageCode, _form.StageName, _form.SortOrder, _form.ProbabilityPercent, _form.IsClosedStage, _form.IsWonStage));
            _showForm = false;
            await _toast.ShowAsync(new() { Content = "Saved", CssClass = "e-toast-success" });
            await LoadAsync();
        }
        catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); }
        finally { _saving = false; }
    }

    void ConfirmDelete(OpportunityStageDto item) { _deleteTarget = item; _showDelete = true; }

    async Task ExecuteDeleteAsync()
    {
        _saving = true;
        try { await Api.DeleteOpportunityStageAsync(_deleteTarget!.OpportunityStageId); _showDelete = false; await _toast.ShowAsync(new() { Content = "Deleted", CssClass = "e-toast-success" }); await LoadAsync(); }
        catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" }); }
        finally { _saving = false; }
    }

    void ResetForm() { _form = new(); _editId = null; }

    sealed class OppStageFormModel
    {
        [Required(ErrorMessage = "Stage Code is required.")]
        [StringLength(80, ErrorMessage = "Stage Code cannot exceed 80 characters.")]
        public string StageCode { get; set; } = string.Empty;

        [Required(ErrorMessage = "Stage Name is required.")]
        [StringLength(200, ErrorMessage = "Stage Name cannot exceed 200 characters.")]
        public string StageName { get; set; } = string.Empty;

        [Range(0, int.MaxValue, ErrorMessage = "Sort Order must be 0 or greater.")]
        public int SortOrder { get; set; }

        [Range(0, 100, ErrorMessage = "Probability must be between 0 and 100.")]
        public int ProbabilityPercent { get; set; }

        public bool IsClosedStage { get; set; }
        public bool IsWonStage { get; set; }
        public bool IsActive { get; set; } = true;
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
