@page "/tenant/crm/lead-sources"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject IJSRuntime Js

<PageTitle>Lead Sources - CRM Configuration</PageTitle>

<AppPageHeader Title="Lead Sources"
               Subtitle="Enterprise CRM acquisition source command center for channel governance, active source readiness, and conversion configuration hygiene."
               Icon="bi-funnel">
    <Actions>
        <button class="um-btn um-btn-primary" type="button" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Lead Source</button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="CopySummaryAsync" disabled="@(!_items.Any())"><i class="bi bi-clipboard" aria-hidden="true"></i> Copy Summary</button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="ls-toast @(_toastIsError ? "ls-toast--danger" : "ls-toast--success")" role="status">
        <i class="bi @(_toastIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" @onclick="ClearToast" aria-label="Dismiss notification"><i class="bi bi-x-lg"></i></button>
    </div>
}

<div class="ls-page">
    <section class="ls-hero">
        <div class="ls-hero-left">
            <span class="ls-hero-icon"><i class="bi bi-funnel-fill" aria-hidden="true"></i></span>
            <div class="ls-hero-title">
                <span class="ls-eyebrow"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> CRM Configuration - Acquisition Channels</span>
                <h1>Lead Source Command Center</h1>
                <p>Govern lead acquisition channels, keep CRM source attribution clean, retire inactive sources safely, and maintain enterprise-ready pipeline origin data.</p>
                <div class="ls-hero-meta">
                    <span><i class="bi bi-funnel" aria-hidden="true"></i> @_items.Count sources</span>
                    <span><i class="bi bi-check-circle" aria-hidden="true"></i> @ActiveCount active</span>
                    <span><i class="bi bi-dash-circle" aria-hidden="true"></i> @InactiveCount inactive</span>
                    <span><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @NeedsReviewCount review</span>
                </div>
            </div>
        </div>
        <div class="ls-hero-actions">
            <div class="ls-score-card @ReadinessClass"><span>Source readiness</span><strong>@ReadinessScore%</strong><small>@ReadinessSummary</small></div>
            <button class="ls-workflow" type="button" @onclick='() => SetTab("review")'><i class="bi bi-exclamation-triangle"></i><span><strong>Clean source data</strong><small>@NeedsReviewCount source(s) need review</small></span></button>
            <button class="ls-workflow" type="button" @onclick="OpenCreate"><i class="bi bi-plus-circle"></i><span><strong>Add acquisition channel</strong><small>Create a new tracked lead source</small></span></button>
        </div>
    </section>

    <section class="ls-kpi-strip" aria-label="Lead source KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="ls-kpi-card ls-kpi-card--@kpi.Tone @(IsActiveTab(kpi.Key) ? "ls-kpi-card--active" : null)" title="@kpi.Tooltip" @onclick="() => SetTab(kpi.Key)">
                <span class="ls-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="ls-kpi-body"><span class="ls-kpi-label">@kpi.Label</span><strong class="ls-kpi-value">@kpi.Value</strong><small class="ls-kpi-sub">@kpi.Detail</small></span>
            </button>
        }
    </section>

    <section class="ls-workflows" aria-label="Lead source workflows">
        <button class="ls-workflow-card" type="button" @onclick='() => SetTab("active")'><span><i class="bi bi-check-circle"></i></span><strong>Operate active channels</strong><small>Confirm active sources cover current acquisition channels.</small></button>
        <button class="ls-workflow-card" type="button" @onclick='() => SetTab("inactive")'><span><i class="bi bi-archive"></i></span><strong>Review retired channels</strong><small>Keep inactive sources available for reporting history.</small></button>
        <button class="ls-workflow-card" type="button" @onclick='() => SetTab("recent")'><span><i class="bi bi-stars"></i></span><strong>Validate new sources</strong><small>Review recently created source codes and labels.</small></button>
        <button class="ls-workflow-card" type="button" @onclick='() => SetTab("review")'><span><i class="bi bi-shield-check"></i></span><strong>Fix configuration gaps</strong><small>Find missing code/name quality issues.</small></button>
        <button class="ls-workflow-card" type="button" @onclick="CopySummaryAsync"><span><i class="bi bi-clipboard-data"></i></span><strong>Brief CRM owners</strong><small>Copy acquisition-source posture summary.</small></button>
    </section>

    <section class="ls-filter-panel" aria-label="Lead source filters">
        <div class="ls-search"><i class="bi bi-search" aria-hidden="true"></i><input value="@_search" @oninput="OnSearchChanged" placeholder="Search source name or code..." /></div>
        <div class="ls-filter-grid">
            <label><span>Status</span><select class="form-select" value="@_statusFilter" @onchange="OnStatusFilterChanged"><option value="">All</option><option value="Active">Active</option><option value="Inactive">Inactive</option></select></label>
            <label><span>Quality</span><select class="form-select" value="@_qualityFilter" @onchange="OnQualityFilterChanged"><option value="">All</option><option value="Ready">Ready</option><option value="Review">Needs Review</option></select></label>
            <label><span>Age</span><select class="form-select" value="@_ageFilter" @onchange="OnAgeFilterChanged"><option value="">All</option><option value="Recent">Recent</option><option value="Established">Established</option></select></label>
        </div>
        <button type="button" class="ls-btn ls-btn--ghost" @onclick="ClearFilters"><i class="bi bi-x-circle"></i> Clear</button>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger ls-alert" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div>
    }

    <div class="ls-tabs" role="tablist" aria-label="Lead source dashboard sections">
        @foreach (var tab in Tabs)
        {
            <button type="button" role="tab" class="ls-tab @(IsActiveTab(tab.Key) ? "ls-tab--active" : null)" @onclick="() => SetTab(tab.Key)"><i class="bi @tab.Icon"></i> @tab.Label <strong>@TabCount(tab.Key)</strong></button>
        }
    </div>

    <section class="ls-dashboard">
        <main class="ls-main-card">
            <div class="ls-card-header">
                <div><span class="ls-section-kicker"><i class="bi bi-command"></i> @ActiveSectionKicker</span><h2>@ActiveSectionTitle</h2><p>@ActiveSectionDescription</p></div>
                <div class="ls-card-actions">
                    @if (_selected is not null)
                    {
                        <span class="ls-sel-count"><i class="bi bi-funnel"></i> @_selected.SourceName</span>
                    }
                    <button type="button" class="ls-btn ls-btn--ghost" @onclick="PreviousPage" disabled="@(_pageNumber <= 1)"><i class="bi bi-chevron-left"></i></button>
                    <span class="ls-page-indicator">Page @_pageNumber of @TotalPages</span>
                    <button type="button" class="ls-btn ls-btn--ghost" @onclick="NextPage" disabled="@(_pageNumber >= TotalPages)"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="ls-loading"><span class="spinner-border spinner-border-sm"></span> Loading lead sources...</div>
            }
            else if (!PagedSources.Any())
            {
                <div class="ls-empty"><i class="bi bi-funnel"></i><strong>No lead sources match this view</strong><span>Adjust filters or add a new acquisition channel.</span><button type="button" class="ls-btn ls-btn--primary" @onclick="OpenCreate">Add Lead Source</button></div>
            }
            else
            {
                <div class="ls-table-wrap">
                    <table class="ls-table">
                        <thead><tr><th>Source</th><th>Code</th><th>Status</th><th>Readiness</th><th>Created</th><th class="ls-actions-col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var item in PagedSources)
                            {
                                <tr class="ls-row @(_selected?.LeadSourceId == item.LeadSourceId ? "ls-row--selected" : null)" @onclick="() => Select(item)">
                                    <td><div class="ls-source-cell"><span class="ls-row-icon @SourceIconClass(item)"><i class="bi @SourceIcon(item)"></i></span><span><strong>@item.SourceName</strong><small>@SourceTypeLabel(item)</small></span></div></td>
                                    <td><span class="ls-code">@item.SourceCode</span></td>
                                    <td><span class="@(item.IsActive ? "ls-pill ls-pill--green" : "ls-pill ls-pill--neutral")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                                    <td><span class="@ReadinessBadgeClass(item)">@SourceReadiness(item)</span></td>
                                    <td><span class="ls-date">@FormatAge(item.CreatedDateUtc)</span></td>
                                    <td class="ls-row-actions" @onclick:stopPropagation="true"><button type="button" class="ls-icon-btn" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil"></i></button><button type="button" class="ls-icon-btn ls-icon-btn--danger" @onclick="() => ConfirmDelete(item)" title="Delete"><i class="bi bi-trash"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </main>

        <aside class="ls-side-panel">
            <section class="ls-panel-card">
                <span class="ls-section-kicker"><i class="bi bi-funnel"></i> Selected Source</span>
                @if (_selected is null)
                {
                    <p class="ls-side-copy">Select a lead source to inspect channel readiness, status, age, and available actions.</p>
                }
                else
                {
                    <div class="ls-selected-title"><span class="ls-selected-icon @SourceIconClass(_selected)"><i class="bi @SourceIcon(_selected)"></i></span><div><h3>@_selected.SourceName</h3><span>@_selected.SourceCode - @( _selected.IsActive ? "Active" : "Inactive")</span></div></div>
                    <div class="ls-selected-score @SourceScoreClass(_selected)"><span>Configuration readiness</span><strong>@SourceReadiness(_selected)</strong><small>@ReadinessDetail(_selected)</small></div>
                    <dl class="ls-detail-list"><div><dt>Code</dt><dd>@_selected.SourceCode</dd></div><div><dt>Name</dt><dd>@_selected.SourceName</dd></div><div><dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd></div><div><dt>Created</dt><dd>@_selected.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy")</dd></div><div><dt>Channel Type</dt><dd>@SourceTypeLabel(_selected)</dd></div></dl>
                    <div class="ls-selected-actions"><button type="button" class="ls-btn ls-btn--primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil"></i> Edit</button><button type="button" class="ls-btn ls-btn--danger-ghost" @onclick="() => ConfirmDelete(_selected)"><i class="bi bi-trash"></i> Delete</button></div>
                }
            </section>

            <section class="ls-panel-card">
                <span class="ls-section-kicker"><i class="bi bi-lightbulb"></i> Priority Insights</span>
                <div class="ls-insight-list">@foreach (var insight in Insights) { <button type="button" class="ls-insight" @onclick="() => SetTab(insight.Tab)"><i class="bi @insight.Icon"></i><span><strong>@insight.Title</strong><small>@insight.Detail</small></span></button> }</div>
            </section>

            <section class="ls-panel-card">
                <span class="ls-section-kicker"><i class="bi bi-list-check"></i> Governance Checklist</span>
                <div class="ls-checklist">@foreach (var item in Checklist) { <div class="ls-check-item @(item.Done ? "ls-check-item--done" : null)"><i class="bi @(item.Done ? "bi-check-circle-fill" : "bi-circle")"></i><span>@item.Text</span></div> }</div>
            </section>
        </aside>
    </section>
</div>
@if (_showForm)
{
    <div class="ls-modal-backdrop" role="presentation">
        <div class="ls-modal" role="dialog" aria-modal="true" aria-labelledby="lead-source-form-title">
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header"><i class="bi bi-funnel-fill"></i><span id="lead-source-form-title">@(_editId.HasValue ? "Edit Lead Source" : "Add Lead Source")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field"><label>Source Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.SourceCode" class="um-input" placeholder="e.g. WEBSITE" /><ValidationMessage For="() => _form.SourceCode" class="text-danger" /></div>
                        <div class="um-field"><label>Source Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.SourceName" class="um-input" placeholder="e.g. Website Form" /><ValidationMessage For="() => _form.SourceName" class="text-danger" /></div>
                        <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label></div>
                    </div>
                </div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showDelete)
{
    <div class="ls-modal-backdrop" role="presentation">
        <div class="ls-confirm" role="dialog" aria-modal="true" aria-labelledby="delete-title">
            <div class="ls-confirm-body"><div class="ls-confirm-icon"><i class="bi bi-trash3-fill"></i></div><div><h3 id="delete-title">Delete Lead Source?</h3><p>You are about to delete <strong>@_deleteTarget?.SourceName</strong>. This action cannot be undone.</p><small>Historical CRM records may still reference this source code for reporting continuity.</small></div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button><button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div>
        </div>
    </div>
}

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<LeadSourceDto> _items = [];
    private LeadSourceDto? _selected;
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private string _qualityFilter = string.Empty;
    private string _ageFilter = string.Empty;
    private string _activeTab = "overview";
    private string? _loadError;
    private string? _toastMessage;
    private bool _toastIsError;
    private bool _loading;
    private bool _saving;
    private bool _showForm;
    private bool _showDelete;
    private Guid? _editId;
    private LeadSourceDto? _deleteTarget;
    private int _pageNumber = 1;
    private const int PageSize = 12;
    private LeadSourceFormModel _form = new();

    private static readonly List<TabItem> Tabs = [new("overview", "Overview", "bi-speedometer2"), new("active", "Active", "bi-check-circle"), new("inactive", "Inactive", "bi-archive"), new("recent", "Recent", "bi-stars"), new("review", "Needs Review", "bi-exclamation-triangle")];
    private IReadOnlyList<KpiItem> Kpis => [new("overview", "Total Sources", _items.Count.ToString(), "Configured CRM acquisition channels", "bi-funnel-fill", "blue", "Show all lead sources"), new("active", "Active", ActiveCount.ToString(), "Available for current intake", "bi-check-circle-fill", "green", "Show active sources"), new("inactive", "Inactive", InactiveCount.ToString(), "Retired or historical channels", "bi-archive-fill", "amber", "Show inactive sources"), new("recent", "Recent", RecentCount.ToString(), "Created in the last 30 days", "bi-stars", "purple", "Show recent sources"), new("review", "Needs Review", NeedsReviewCount.ToString(), "Code/name readiness gaps", "bi-exclamation-triangle-fill", "red", "Show sources needing review")];
    private IEnumerable<LeadSourceDto> FilteredSources => ApplyFilters();
    private IEnumerable<LeadSourceDto> PagedSources => FilteredSources.Skip((_pageNumber - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredSources.Count() / (double)PageSize));
    private int ActiveCount => _items.Count(x => x.IsActive);
    private int InactiveCount => _items.Count(x => !x.IsActive);
    private int RecentCount => _items.Count(IsRecent);
    private int NeedsReviewCount => _items.Count(NeedsReview);
    private int ReadinessScore => _items.Count == 0 ? 0 : Math.Clamp(100 - (NeedsReviewCount * 12) - (ActiveCount == 0 ? 30 : 0) - (InactiveCount > ActiveCount && ActiveCount > 0 ? 8 : 0), 0, 100);
    private string ReadinessClass => ReadinessScore >= 90 ? "ls-score-card--green" : ReadinessScore >= 75 ? "ls-score-card--cyan" : ReadinessScore >= 55 ? "ls-score-card--amber" : "ls-score-card--red";
    private string ReadinessSummary => ReadinessScore >= 90 ? "Lead source configuration is enterprise ready." : ReadinessScore >= 75 ? "Review source hygiene and inactive channels." : "Acquisition source setup needs attention.";
    private string ActiveSectionKicker => _activeTab == "review" ? "Configuration Hygiene" : "Acquisition Governance";
    private string ActiveSectionTitle => _activeTab switch { "active" => "Active Lead Sources", "inactive" => "Inactive Lead Sources", "recent" => "Recently Added Sources", "review" => "Sources Needing Review", _ => "Lead Source Overview" };
    private string ActiveSectionDescription => _activeTab switch { "active" => "Sources available for current lead intake and attribution.", "inactive" => "Retired channels preserved for reporting continuity and audit history.", "recent" => "Newly added acquisition channels that should be validated.", "review" => "Sources with missing, weak, or inconsistent source code/name configuration.", _ => "All lead sources ranked by operational importance and configuration readiness." };
    private IReadOnlyList<InsightItem> Insights => [new("active", "Active coverage", $"{ActiveCount} source(s) are available for intake", "bi-check-circle"), new("review", "Configuration gaps", $"{NeedsReviewCount} source(s) need cleanup", "bi-exclamation-triangle"), new("inactive", "Retired channels", $"{InactiveCount} source(s) are inactive", "bi-archive"), new("recent", "Recent setup", $"{RecentCount} source(s) added recently", "bi-stars")];
    private IReadOnlyList<ChecklistItem> Checklist => [new("At least one active source is configured", ActiveCount > 0), new("All source codes are complete", _items.All(x => !string.IsNullOrWhiteSpace(x.SourceCode))), new("All source names are complete", _items.All(x => !string.IsNullOrWhiteSpace(x.SourceName))), new("No duplicate source codes", _items.GroupBy(x => x.SourceCode, StringComparer.OrdinalIgnoreCase).All(g => g.Count() == 1)), new("Review queue is clear", NeedsReviewCount == 0)];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM Configuration", null), new("Lead Sources", "/tenant/crm/lead-sources"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();
        try
        {
            var result = await Api.SearchLeadSourcesAsync(_tenantId, _search, pageSize: 5000);
            _items = result?.Items.ToList() ?? [];
            EnsureSelected();
            ClampPage();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load lead sources: {ex.Message}";
            ShowToast($"Failed to load lead sources: {ex.Message}", true);
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<LeadSourceDto> ApplyFilters()
    {
        var query = _items.AsEnumerable();
        query = _activeTab switch { "active" => query.Where(x => x.IsActive), "inactive" => query.Where(x => !x.IsActive), "recent" => query.Where(IsRecent), "review" => query.Where(NeedsReview), _ => query };
        if (!string.IsNullOrWhiteSpace(_statusFilter)) query = query.Where(x => (x.IsActive ? "Active" : "Inactive") == _statusFilter);
        if (!string.IsNullOrWhiteSpace(_qualityFilter)) query = query.Where(x => (NeedsReview(x) ? "Review" : "Ready") == _qualityFilter);
        if (!string.IsNullOrWhiteSpace(_ageFilter)) query = query.Where(x => (IsRecent(x) ? "Recent" : "Established") == _ageFilter);
        if (!string.IsNullOrWhiteSpace(_search)) query = query.Where(x => x.SourceName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.SourceCode.Contains(_search, StringComparison.OrdinalIgnoreCase));
        return query.OrderByDescending(x => x.IsActive).ThenByDescending(NeedsReview).ThenBy(x => x.SourceName);
    }

    private void EnsureSelected() => _selected = _selected is null ? FilteredSources.FirstOrDefault() : FilteredSources.FirstOrDefault(x => x.LeadSourceId == _selected.LeadSourceId) ?? FilteredSources.FirstOrDefault();
    private void Select(LeadSourceDto item) => _selected = item;
    private void SetTab(string tab) { _activeTab = tab; _pageNumber = 1; EnsureSelected(); }
    private bool IsActiveTab(string tab) => _activeTab == tab;
    private int TabCount(string tab) => tab switch { "active" => ActiveCount, "inactive" => InactiveCount, "recent" => RecentCount, "review" => NeedsReviewCount, _ => _items.Count };
    private void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args) { _search = args.Value?.ToString() ?? string.Empty; _pageNumber = 1; _ = LoadAsync(); }
    private void OnStatusFilterChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args) { _statusFilter = args.Value?.ToString() ?? string.Empty; _pageNumber = 1; }
    private void OnQualityFilterChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args) { _qualityFilter = args.Value?.ToString() ?? string.Empty; _pageNumber = 1; }
    private void OnAgeFilterChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args) { _ageFilter = args.Value?.ToString() ?? string.Empty; _pageNumber = 1; }
    private void ClearFilters() { _search = string.Empty; _statusFilter = string.Empty; _qualityFilter = string.Empty; _ageFilter = string.Empty; _activeTab = "overview"; _pageNumber = 1; _ = LoadAsync(); }
    private void PreviousPage() { if (_pageNumber > 1) _pageNumber--; }
    private void NextPage() { if (_pageNumber < TotalPages) _pageNumber++; }
    private void ClampPage() { if (_pageNumber > TotalPages) _pageNumber = TotalPages; if (_pageNumber < 1) _pageNumber = 1; }
    private void OpenCreate() { _editId = null; _form = new(); _showForm = true; }
    private void OpenEdit(LeadSourceDto item) { _selected = item; _editId = item.LeadSourceId; _form = new() { SourceCode = item.SourceCode, SourceName = item.SourceName, IsActive = item.IsActive }; _showForm = true; }
    private void CloseForm() { _showForm = false; ResetForm(); }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue) await Api.UpdateLeadSourceAsync(_editId.Value, new(_form.SourceCode.Trim(), _form.SourceName.Trim(), _form.IsActive));
            else await Api.CreateLeadSourceAsync(new(_tenantId, _form.SourceCode.Trim(), _form.SourceName.Trim()));
            _showForm = false;
            ShowToast("Lead source saved successfully.");
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast($"Save failed: {ex.Message}", true); }
        finally { _saving = false; }
    }

    private void ConfirmDelete(LeadSourceDto item) { _deleteTarget = item; _showDelete = true; }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        _saving = true;
        try
        {
            await Api.DeleteLeadSourceAsync(_deleteTarget.LeadSourceId);
            _showDelete = false;
            ShowToast("Lead source deleted.");
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast($"Delete failed: {ex.Message}", true); }
        finally { _saving = false; }
    }

    private void ResetForm() { _form = new(); _editId = null; }
    private async Task CopySummaryAsync()
    {
        var summary = $"Lead Sources Summary: {_items.Count} total, {ActiveCount} active, {InactiveCount} inactive, {RecentCount} recent, {NeedsReviewCount} needing review, readiness {ReadinessScore}%.";
        try { await Js.InvokeVoidAsync("navigator.clipboard.writeText", summary); ShowToast("Lead source summary copied."); }
        catch { ShowToast(summary); }
    }

    private static bool IsRecent(LeadSourceDto item) => item.CreatedDateUtc >= DateTime.UtcNow.AddDays(-30);
    private static bool NeedsReview(LeadSourceDto item) => string.IsNullOrWhiteSpace(item.SourceCode) || string.IsNullOrWhiteSpace(item.SourceName) || item.SourceCode.Length < 3 || item.SourceName.Length < 3;
    private static string SourceReadiness(LeadSourceDto item) => NeedsReview(item) ? "Review" : item.IsActive ? "Ready" : "Retired";
    private static string ReadinessDetail(LeadSourceDto item) => NeedsReview(item) ? "Source code or name needs cleanup before enterprise reporting." : item.IsActive ? "Source is active and ready for lead intake." : "Source is inactive but retained for historical attribution.";
    private static string ReadinessBadgeClass(LeadSourceDto item) => NeedsReview(item) ? "ls-risk-badge ls-risk-badge--red" : item.IsActive ? "ls-risk-badge ls-risk-badge--green" : "ls-risk-badge ls-risk-badge--neutral";
    private static string SourceScoreClass(LeadSourceDto item) => NeedsReview(item) ? "ls-selected-score--red" : item.IsActive ? "ls-selected-score--green" : "ls-selected-score--neutral";
    private static string SourceTypeLabel(LeadSourceDto item) => item.SourceCode.Contains("WEB", StringComparison.OrdinalIgnoreCase) ? "Digital / Web" : item.SourceCode.Contains("REF", StringComparison.OrdinalIgnoreCase) ? "Referral" : item.SourceCode.Contains("SOC", StringComparison.OrdinalIgnoreCase) ? "Social" : item.SourceCode.Contains("EMAIL", StringComparison.OrdinalIgnoreCase) ? "Email" : "General Channel";
    private static string SourceIcon(LeadSourceDto item) => SourceTypeLabel(item) switch { "Digital / Web" => "bi-globe2", "Referral" => "bi-person-heart", "Social" => "bi-share", "Email" => "bi-envelope", _ => "bi-funnel" };
    private static string SourceIconClass(LeadSourceDto item) => NeedsReview(item) ? "ls-row-icon--red" : item.IsActive ? "ls-row-icon--green" : "ls-row-icon--neutral";
    private static string FormatAge(DateTime utc) { var diff = DateTime.UtcNow - utc; if (diff.TotalDays < 1) return "Today"; if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d ago"; return utc.ToLocalTime().ToString("MMM d, yyyy"); }
    private void ShowToast(string message, bool isError = false) { _toastMessage = message; _toastIsError = isError; }
    private void ClearToast() => _toastMessage = null;
    private async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; }

    private sealed record TabItem(string Key, string Label, string Icon);
    private sealed record KpiItem(string Key, string Label, string Value, string Detail, string Icon, string Tone, string Tooltip);
    private sealed record InsightItem(string Tab, string Title, string Detail, string Icon);
    private sealed record ChecklistItem(string Text, bool Done);

    private sealed class LeadSourceFormModel
    {
        [Required(ErrorMessage = "Source Code is required.")]
        [StringLength(80, ErrorMessage = "Source Code cannot exceed 80 characters.")]
        public string SourceCode { get; set; } = string.Empty;

        [Required(ErrorMessage = "Source Name is required.")]
        [StringLength(200, ErrorMessage = "Source Name cannot exceed 200 characters.")]
        public string SourceName { get; set; } = string.Empty;

        public bool IsActive { get; set; } = true;
    }
}
