@page "/tenant/crm/custom-fields"
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>CRM Custom Fields — CRM Configuration</PageTitle>

<AppPageHeader Title="CRM Custom Fields"
               Subtitle="Extend Lead, Opportunity, and Account records with custom data fields"
               Icon="bi-layout-text-window-reverse">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Field
        </button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
    </Actions>
</AppPageHeader>

<div class="pc-kpi-strip">
    <div class="pc-kpi-card @(_activeFilter == null ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter(null)' title="Show all">
        <span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-input-cursor-text" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total Fields</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "active" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("active")' title="Filter: Active">
        <span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.IsActive)</div><div class="pc-kpi-label">Active</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "required" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("required")' title="Filter: Required">
        <span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.IsRequired)</div><div class="pc-kpi-label">Required</div></div>
    </div>
</div>

<AppFilterPanel @bind-SearchValue="_search" OnSearch="OnSearchAsync" SearchPlaceholder="Search field name or code…">
    <Filters>
        <SfDropDownList TValue="string" TItem="string" DataSource="@_entityTypes" Placeholder="All Entities"
            ShowClearButton="true" Width="150px" Value="_filterEntity"
            ValueChanged="@((string v) => { _filterEntity = v; ApplyFilter(); })" />
    </Filters>
</AppFilterPanel>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

<div class="um-grid-card">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }
    <SfGrid TValue="CrmCustomFieldDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
        <GridEvents TValue="CrmCustomFieldDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" />
        <GridColumns>
            <GridColumn Field="FieldCode" HeaderText="Field Code" Width="150" />
            <GridColumn Field="FieldName" HeaderText="Field Name" Width="200" />
            <GridColumn Field="EntityType" HeaderText="Entity" Width="120" />
            <GridColumn Field="FieldType" HeaderText="Type" Width="110">
                <Template>
                    @{ var r = (CrmCustomFieldDto)context; }
                    <span class="um-badge um-badge-neutral">@r.FieldType</span>
                </Template>
            </GridColumn>
            <GridColumn Field="IsRequired" HeaderText="Required" Width="100" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (CrmCustomFieldDto)context; }
                    @if (r.IsRequired) { <i class="bi bi-asterisk text-danger"></i> }
                </Template>
            </GridColumn>
            <GridColumn Field="IsActive" HeaderText="Status" Width="100" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (CrmCustomFieldDto)context; }
                    <span class="um-badge @(r.IsActive ? "um-badge-success" : "um-badge-neutral")">@(r.IsActive ? "Active" : "Off")</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="100" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (CrmCustomFieldDto)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(r)" @onclick:stopPropagation="true"><i class="bi bi-pencil"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDelete(r)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showForm" Width="560px" IsModal="true" ShowCloseIcon="false">
    <DialogEvents Closed="ResetForm" />
    <DialogContent>
        <div class="um-modal-header">
            <i class="bi bi-input-cursor-text"></i>
            <span>@(_editId.HasValue ? "Edit Custom Field" : "Add Custom Field")</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button>
        </div>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="um-field">
                        <label>Field Code <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.FieldCode" class="um-input" placeholder="e.g. INDUSTRY_NICHE" />
                        <ValidationMessage For="() => _form.FieldCode" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Field Name <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.FieldName" class="um-input" />
                        <ValidationMessage For="() => _form.FieldName" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Entity Type <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="string" TItem="string" @bind-Value="_form.EntityType"
                            DataSource="@(new[]{"Lead","Opportunity","Account"})" Placeholder="Select entity" />
                        <ValidationMessage For="() => _form.EntityType" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Field Type <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="string" TItem="string" @bind-Value="_form.FieldType"
                            DataSource="@(new[]{"Text","Number","Date","Dropdown","Checkbox"})" Placeholder="Select type" />
                        <ValidationMessage For="() => _form.FieldType" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Default Value</label>
                        <InputText @bind-Value="_form.DefaultValue" class="um-input" />
                    </div>
                    <div class="um-field">
                        <label>Dropdown Options</label>
                        <InputTextArea @bind-Value="_form.DropdownOptions" class="um-input" rows="2" placeholder="Comma-separated values (for Dropdown type)" />
                    </div>
                    <div class="um-field">
                        <label>Sort Order</label>
                        <InputNumber @bind-Value="_form.SortOrder" class="um-input" />
                        <ValidationMessage For="() => _form.SortOrder" class="text-danger" />
                    </div>
                    <div class="um-field um-field--checkbox">
                        <label><InputCheckbox @bind-Value="_form.IsRequired" /> Required</label>
                    </div>
                    <div class="um-field um-field--checkbox">
                        <label><InputCheckbox @bind-Value="_form.IsSearchable" /> Searchable</label>
                    </div>
                    <div class="um-field um-field--checkbox">
                        <label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label>
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button>
            </div>
        </EditForm>
    </DialogContent>
</SfDialog>

<SfDialog @bind-Visible="_showDelete" Width="440px" IsModal="true" ShowCloseIcon="false">
    <DialogContent>
        <div class="um-confirm-dialog">
            <div class="um-confirm-icon um-confirm-icon--danger">
                <i class="bi bi-trash3-fill"></i>
            </div>
            <div class="um-confirm-message">
                <h6>Delete Custom Field?</h6>
                <p>You are about to delete <strong>@_deleteTarget?.FieldName</strong>. This action cannot be undone.</p>
            </div>
            <div class="um-modal-footer" style="width:100%">
                <button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button>
            </div>
        </div>
    </DialogContent>
</SfDialog>

<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />

@code {
    static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    static readonly string[] _entityTypes = ["Lead", "Opportunity", "Account"];
    List<CrmCustomFieldDto> _items = [], _filtered = [];
    bool _loading, _saving;
    string _search = string.Empty, _filterEntity = string.Empty;
    string? _activeFilter;
    string? _loadError;
    bool _showForm, _showDelete;
    Guid? _editId;
    CrmCustomFieldDto? _deleteTarget;
    SfToast _toast = default!;
    CrmFieldFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM Config", null), new("Custom Fields", null));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try { var r = await Api.SearchCrmCustomFieldsAsync(TenantId, _search, pageSize: 200); _items = r?.Items.ToList() ?? []; ApplyFilter(); }
        catch (Exception ex) { _loadError = $"Failed to load custom fields: {ex.Message}"; }
        finally { _loading = false; }
    }

    Task OnSearchAsync() => LoadAsync();

    void ApplyFilter()
    {
        var q = string.IsNullOrEmpty(_filterEntity) ? _items : _items.Where(x => x.EntityType == _filterEntity);
        _filtered = _activeFilter switch
        {
            "active"   => q.Where(x => x.IsActive).ToList(),
            "required" => q.Where(x => x.IsRequired).ToList(),
            _          => q.ToList()
        };
    }

    void SetFilter(string? key) { _activeFilter = key; ApplyFilter(); }
    void OnRowSelected(RowSelectEventArgs<CrmCustomFieldDto> args) => OpenEdit(args.Data);

    void OpenCreate() { _editId = null; _form = new(); _showForm = true; }

    void OpenEdit(CrmCustomFieldDto item)
    {
        _editId = item.CustomFieldId;
        _form = new() { FieldCode = item.FieldCode, FieldName = item.FieldName, EntityType = item.EntityType, FieldType = item.FieldType, DefaultValue = item.DefaultValue, DropdownOptions = item.DropdownOptions, IsRequired = item.IsRequired, IsSearchable = item.IsSearchable, SortOrder = item.SortOrder, IsActive = item.IsActive };
        _showForm = true;
    }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue)
                await Api.UpdateCrmCustomFieldAsync(_editId.Value, new(_form.FieldCode, _form.FieldName, _form.EntityType, _form.FieldType, _form.DefaultValue, _form.DropdownOptions, _form.IsRequired, _form.IsSearchable, _form.IsActive, _form.SortOrder));
            else
                await Api.CreateCrmCustomFieldAsync(new(TenantId, _form.FieldCode, _form.FieldName, _form.EntityType, _form.FieldType, _form.DefaultValue, _form.DropdownOptions, _form.IsRequired, _form.IsSearchable, _form.SortOrder));
            _showForm = false;
            await _toast.ShowAsync(new() { Content = "Saved", CssClass = "e-toast-success" });
            await LoadAsync();
        }
        catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); }
        finally { _saving = false; }
    }

    void ConfirmDelete(CrmCustomFieldDto item) { _deleteTarget = item; _showDelete = true; }

    async Task ExecuteDeleteAsync()
    {
        _saving = true;
        try { await Api.DeleteCrmCustomFieldAsync(_deleteTarget!.CustomFieldId); _showDelete = false; await _toast.ShowAsync(new() { Content = "Deleted", CssClass = "e-toast-success" }); await LoadAsync(); }
        catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" }); }
        finally { _saving = false; }
    }

    void ResetForm() { _form = new(); _editId = null; }

    sealed class CrmFieldFormModel
    {
        [Required(ErrorMessage = "Field Code is required.")]
        [StringLength(80, ErrorMessage = "Field Code cannot exceed 80 characters.")]
        public string FieldCode { get; set; } = string.Empty;

        [Required(ErrorMessage = "Field Name is required.")]
        [StringLength(200, ErrorMessage = "Field Name cannot exceed 200 characters.")]
        public string FieldName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Entity Type is required.")]
        [StringLength(80, ErrorMessage = "Entity Type cannot exceed 80 characters.")]
        public string EntityType { get; set; } = string.Empty;

        [Required(ErrorMessage = "Field Type is required.")]
        [StringLength(80, ErrorMessage = "Field Type cannot exceed 80 characters.")]
        public string FieldType { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "Default Value cannot exceed 500 characters.")]
        public string? DefaultValue { get; set; }

        public string? DropdownOptions { get; set; }

        public bool IsRequired { get; set; }
        public bool IsSearchable { get; set; }

        [Range(0, int.MaxValue, ErrorMessage = "Sort Order must be 0 or greater.")]
        public int SortOrder { get; set; }

        public bool IsActive { get; set; } = true;
    }
}
