    private FeatureRow ToFeatureRow(PortalConfigItemDto dto)
    {
        var config = ParseConfig(dto.ConfigurationJson);
        var category = FirstNonEmpty(dto.Category, GetString(config, "category"), "Service");
        var name = FirstNonEmpty(dto.Name, GetString(config, "name"), "Portal Feature");
        var description = FirstNonEmpty(dto.Description, GetString(config, "description"), "Client portal self-service capability.");
        return new(dto.PortalConfigItemId, dto.Code, name, category, description, dto.ConfigurationJson ?? "{}", dto.IsActive, dto.SortOrder, GetBool(config, "requiresApproval", IsSensitive(dto.Code, name, category)), GetBool(config, "mfaRequired", IsSensitive(dto.Code, name, category) && !Contains(name, "certificate")), GetBool(config, "auditLog", true), GetString(config, "icon") ?? PickIcon(dto.Code, name, category), GetString(config, "iconCss") ?? PickIconCss(category), GetImportance(dto.Code, name, category, dto.IsActive));
    }

    private string MergeConfigJson(FeatureForm form)
    {
        var values = ParseConfig(form.ConfigurationJson);
        values["category"] = form.Category;
        values["description"] = form.Description;
        values["requiresApproval"] = form.RequiresApproval;
        values["mfaRequired"] = form.MfaRequired;
        values["auditLog"] = form.AuditLog;
        values.TryAdd("icon", PickIcon(form.Code, form.Name, form.Category));
        values.TryAdd("iconCss", PickIconCss(form.Category));
        return JsonSerializer.Serialize(values, _jsonOptions);
    }

    private Dictionary<string, object?> ParseConfig(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != JsonValueKind.Object) return [];
            var values = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
            foreach (var prop in doc.RootElement.EnumerateObject())
            {
                values[prop.Name] = prop.Value.ValueKind switch
                {
                    JsonValueKind.True => true,
                    JsonValueKind.False => false,
                    JsonValueKind.Number when prop.Value.TryGetInt32(out var i) => i,
                    JsonValueKind.String => prop.Value.GetString(),
                    _ => prop.Value.GetRawText()
                };
            }
            return values;
        }
        catch
        {
            throw new InvalidOperationException("Configuration JSON must be a valid JSON object.");
        }
    }

    private string NormalizeJson(string? json)
    {
        try { return JsonSerializer.Serialize(ParseConfig(json), _jsonOptions); }
        catch { return json ?? "{}"; }
    }

    private static string BuildConfigJson(bool requiresApproval, bool auditLog, bool enabled, string icon, string iconCss) => JsonSerializer.Serialize(new { requiresApproval, auditLog, enabled, icon, iconCss }, new JsonSerializerOptions(JsonSerializerDefaults.Web) { WriteIndented = true });
    private int NextSortOrder() => _rows.Count == 0 ? 10 : _rows.Max(r => r.SortOrder) + 10;
    private string BuildNextCode() => $"feature-{_rows.Count + 1:00}";
    private int TabCount(string tab) => ApplyTabForCount(tab).Count();
    private IEnumerable<FeatureRow> ApplyTabForCount(string tab) => tab switch
    {
        "service" => FilteredRows.Where(r => IsCategory(r, "Service") || Contains(r.Name, "request")),
        "documents" => FilteredRows.Where(r => IsCategory(r, "Documents") || Contains(r.Name, "document") || Contains(r.Name, "certificate") || Contains(r.Code, "coi")),
        "billing" => FilteredRows.Where(r => IsCategory(r, "Billing") || Contains(r.Name, "pay") || Contains(r.Name, "invoice")),
        "claims" => FilteredRows.Where(r => IsCategory(r, "Claims") || Contains(r.Name, "claim") || Contains(r.Code, "fnol")),
        "security" => FilteredRows.Where(r => r.MfaRequired || r.AuditLog || IsCategory(r, "Security") || IsSensitive(r)),
        "attention" => FilteredRows.Where(NeedsAttention),
        _ => FilteredRows
    };
    private List<Signal> BuildImportanceSignals() =>
    [
        new("bi-check-circle", $"{EnabledCount} enabled client capabilities are live."),
        new("bi-shield-lock", $"{MfaCount} sensitive features require MFA."),
        new("bi-person-check", $"{ApprovalCount} workflows route to staff approval."),
        new("bi-exclamation-triangle", AttentionCount == 0 ? "No high-priority feature gaps detected." : $"{AttentionCount} features need administrator attention.")
    ];
    private static bool NeedsAttention(FeatureRow row) => !row.IsActive && row.Importance == "High" || row.IsActive && IsSensitive(row) && (!row.MfaRequired || !row.AuditLog);
    private static bool IsSensitive(FeatureRow row) => IsSensitive(row.Code, row.Name, row.Category);
    private static bool IsSensitive(string code, string name, string category) => HighImportanceTerms.Any(t => Contains(code, t) || Contains(name, t) || Contains(category, t));
    private static string GetImportance(string code, string name, string category, bool active) => IsSensitive(code, name, category) ? "High" : active ? "Standard" : "Draft";
    private static bool IsCategory(FeatureRow row, string category) => row.Category.Equals(category, StringComparison.OrdinalIgnoreCase);
    private static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static string FirstNonEmpty(params string?[] values) => values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v))?.Trim() ?? string.Empty;
    private static string? GetString(Dictionary<string, object?> values, string key) => values.TryGetValue(key, out var value) ? value?.ToString() : null;
    private static bool GetBool(Dictionary<string, object?> values, string key, bool fallback) => values.TryGetValue(key, out var value) && value is bool b ? b : fallback;
    private static string PickIcon(string code, string name, string category) => Contains(code, "coi") || Contains(name, "certificate") ? "bi-file-earmark-text" : Contains(name, "pay") || Contains(name, "invoice") || IsText(category, "Billing") ? "bi-credit-card" : Contains(name, "claim") || IsText(category, "Claims") ? "bi-exclamation-circle" : Contains(name, "document") || IsText(category, "Documents") ? "bi-folder2-open" : Contains(name, "policy") ? "bi-pencil-square" : "bi-toggles";
    private static string PickIconCss(string category) => IsText(category, "Billing") ? "pf-feature-amber" : IsText(category, "Claims") ? "pf-feature-red" : IsText(category, "Documents") ? "pf-feature-blue" : IsText(category, "Security") ? "pf-feature-purple" : "pf-feature-green";
    private static bool IsText(string? value, string expected) => string.Equals(value, expected, StringComparison.OrdinalIgnoreCase);
    private static string ImportanceCss(string importance) => importance switch { "High" => "pf-pill--red", "Draft" => "pf-pill--muted", _ => "pf-pill--blue" };
    private static string Csv(object? value)
    {
        const string quote = "\"";
        var text = value?.ToString() ?? string.Empty;
        return quote + text.Replace(quote, quote + quote) + quote;
    }

    private sealed record KpiDefinition(string Key, string Label, string Value, string Hint, string Icon, string Css);
    private sealed record FeatureRow(Guid Id, string Code, string Name, string Category, string Description, string ConfigurationJson, bool IsActive, int SortOrder, bool RequiresApproval, bool MfaRequired, bool AuditLog, string Icon, string IconCss, string Importance);
    private sealed record TabDefinition(string Key, string Label, string Icon);
    private sealed record Signal(string Icon, string Text);
    private sealed class FeatureForm
    {
        [Required, StringLength(80)] public string Code { get; set; } = string.Empty;
        [Required, StringLength(200)] public string Name { get; set; } = string.Empty;
        [Required, StringLength(120)] public string Category { get; set; } = "Service";
        [Required, StringLength(500)] public string Description { get; set; } = string.Empty;
        [StringLength(4000)] public string? ConfigurationJson { get; set; } = "{}";
        [Range(0, 9999)] public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
        public bool RequiresApproval { get; set; }
        public bool MfaRequired { get; set; }
        public bool AuditLog { get; set; } = true;
    }
}
