        _formError = null;
        _form = new()
        {
            Code = $"{row.Code}-copy",
            Name = $"{row.Name} Copy",
            Category = row.Category,
            Description = row.Description,
            ConfigurationJson = NormalizeJson(row.ConfigurationJson),
            IsActive = false,
            RequiresApproval = row.RequiresApproval,
            MfaRequired = row.MfaRequired,
            AuditLog = row.AuditLog,
