    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Client Portal", "/portal/users"), new("Portal Features", null));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchPortalConfigItemsAsync(_tenantId, FeatureKind, pageSize: 500);
            _rows = (result?.Items ?? []).Select(ToFeatureRow).ToList();
            if (SelectedId is null || !_rows.Any(r => r.Id == SelectedId))
            {
                SelectedId = _rows.OrderBy(r => r.SortOrder).ThenBy(r => r.Name).FirstOrDefault()?.Id;
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<FeatureRow> ApplySearchAndFilters(IEnumerable<FeatureRow> rows)
    {
        var filtered = rows;
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var q = _searchText.Trim();
            filtered = filtered.Where(r => Contains(r.Name, q) || Contains(r.Code, q) || Contains(r.Category, q) || Contains(r.Description, q) || Contains(r.Importance, q) || (r.IsActive ? "enabled" : "disabled").Contains(q, StringComparison.OrdinalIgnoreCase));
        }
        if (!string.IsNullOrWhiteSpace(_categoryFilter)) filtered = filtered.Where(r => r.Category.Equals(_categoryFilter, StringComparison.OrdinalIgnoreCase));
        if (_statusFilter == "enabled") filtered = filtered.Where(r => r.IsActive);
        if (_statusFilter == "disabled") filtered = filtered.Where(r => !r.IsActive);
        filtered = _kpiFilter switch
        {
            "enabled" => filtered.Where(r => r.IsActive),
            "approval" => filtered.Where(r => r.RequiresApproval),
            "mfa" => filtered.Where(r => r.MfaRequired),
            "audit" => filtered.Where(r => r.AuditLog),
            "attention" => filtered.Where(NeedsAttention),
            "security-gap" => filtered.Where(r => r.IsActive && !r.MfaRequired && IsSensitive(r)),
            _ => filtered
        };
        return filtered;
    }

    private IEnumerable<FeatureRow> ApplyTab(IEnumerable<FeatureRow> rows) => _activeTab switch
    {
        "service" => rows.Where(r => IsCategory(r, "Service") || Contains(r.Name, "request")),
        "documents" => rows.Where(r => IsCategory(r, "Documents") || Contains(r.Name, "document") || Contains(r.Name, "certificate") || Contains(r.Code, "coi")),
        "billing" => rows.Where(r => IsCategory(r, "Billing") || Contains(r.Name, "pay") || Contains(r.Name, "invoice")),
        "claims" => rows.Where(r => IsCategory(r, "Claims") || Contains(r.Name, "claim") || Contains(r.Code, "fnol")),
        "security" => rows.Where(r => r.MfaRequired || r.AuditLog || IsCategory(r, "Security") || IsSensitive(r)),
        "attention" => rows.Where(NeedsAttention),
        _ => rows
    };

    private void SetKpiFilter(string filter)
    {
        _kpiFilter = _kpiFilter == filter ? "all" : filter;
        if (filter == "attention" || filter == "security-gap") _activeTab = "attention";
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
        if (tab != "attention" && _kpiFilter is "attention" or "security-gap") _kpiFilter = "all";
    }

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _categoryFilter = string.Empty;
        _statusFilter = string.Empty;
        _kpiFilter = "all";
        _activeTab = "all";
    }

    private void SelectRow(FeatureRow row) => SelectedId = row.Id;

