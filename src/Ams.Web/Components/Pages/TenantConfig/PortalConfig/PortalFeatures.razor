    }

    private async Task SaveAsync()
    {
        _actionBusy = true;
        _formError = null;
        try
        {
            var configJson = MergeConfigJson(_form);
            if (_editing is null)
            {
                var id = await Api.CreatePortalConfigItemAsync(new CreatePortalConfigItemRequest(_tenantId, FeatureKind, _form.Code.Trim(), _form.Name.Trim(), _form.Category, _form.Description, configJson, _form.SortOrder));
                SelectedId = id;
            }
            else if (_editing is { } editing)
            {
                await Api.UpdatePortalConfigItemAsync(editing.Id, new UpdatePortalConfigItemRequest(_form.Code.Trim(), _form.Name.Trim(), _form.Category, _form.Description, configJson, _form.IsActive, _form.SortOrder));
                SelectedId = editing.Id;
            }
            _showForm = false;
            ShowToast("success", "Portal feature saved successfully.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
            ShowToast("danger", _formError);
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private void ConfirmStatus(FeatureRow row)
    {
        _pendingRow = row;
        _pendingAction = row.IsActive ? "Disable" : "Enable";
        _confirmIcon = row.IsActive ? "bi-pause-circle" : "bi-play-circle";
        _confirmTitle = row.IsActive ? "Disable portal feature?" : "Enable portal feature?";
        _confirmMessage = row.IsActive ? $"Disable {row.Name} for client portal users?" : $"Enable {row.Name} for client portal users?";
        _showConfirm = true;
    }

    private void ConfirmDelete(FeatureRow row)
    {
        _pendingRow = row;
        _pendingAction = "Delete";
        _confirmIcon = "bi-trash3-fill";
        _confirmTitle = "Delete portal feature?";
        _confirmMessage = $"Delete {row.Name}? This removes it from the portal feature configuration list.";
        _showConfirm = true;
    }

    private async Task ExecuteConfirmedAsync()
    {
        if (_pendingRow is not { } pendingRow) return;
        _actionBusy = true;
        try
        {
            if (_pendingAction == "Delete")
            {
                await Api.DeletePortalConfigItemAsync(pendingRow.Id);
                ShowToast("success", "Portal feature deleted successfully.");
            }
            else
            {
                var enabled = _pendingAction == "Enable";
                await Api.UpdatePortalConfigItemAsync(pendingRow.Id, new UpdatePortalConfigItemRequest(pendingRow.Code, pendingRow.Name, pendingRow.Category, pendingRow.Description, pendingRow.ConfigurationJson, enabled, pendingRow.SortOrder));
                ShowToast("success", enabled ? "Portal feature enabled." : "Portal feature disabled.");
            }
            _showConfirm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast("danger", $"{_pendingAction} failed: {ex.Message}");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private void ExportCsv()
    {
        var sb = new StringBuilder();
        sb.AppendLine("Code,Name,Category,Status,Importance,RequiresApproval,MfaRequired,AuditLog,SortOrder");
        foreach (var row in VisibleRows)
        {
            sb.AppendLine(string.Join(',', Csv(row.Code), Csv(row.Name), Csv(row.Category), Csv(row.IsActive ? "Enabled" : "Disabled"), Csv(row.Importance), row.RequiresApproval, row.MfaRequired, row.AuditLog, row.SortOrder));
        }
        _exportText = sb.ToString();
        _showExport = true;
        ShowToast("success", "Portal feature export generated.");
    }

