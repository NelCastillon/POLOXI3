@page "/tenant/policies/endorsements"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.PolicyEndorsements
@using Ams.Application.Features.PolicyConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Endorsement Command Center - Policy Configuration</PageTitle>

<div class="end-page">
    <section class="end-hero">
        <div class="end-hero__content">
            <div class="end-hero-left">
                <span class="end-hero-icon"><i class="bi bi-pen" aria-hidden="true"></i></span>
                <div class="end-hero-title">
                    <div class="end-hero__eyebrow">Enterprise policy change configuration</div>
                    <div class="end-title-row">
                        <h1>Endorsement Command Center</h1>
                        <div class="end-hero__meta">
                            <span><i class="bi bi-pen" aria-hidden="true"></i>@_items.Count types</span>
                            <span><i class="bi bi-check-circle" aria-hidden="true"></i>@_items.Count(x => x.IsActive) active</span>
                            <span><i class="bi bi-lightning-charge" aria-hidden="true"></i>@_items.Count(IsPriorityEndorsement) priority</span>
                            <span><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>@_items.Count(NeedsReview) need review</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Govern endorsement transaction types used for policy changes, exposure updates, cancellations, premium-impacting changes, and servicing workflows.</p>
        </div>
        <div class="end-hero__actions">
            <button type="button" class="end-btn end-btn--light" @onclick="RefreshAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "end-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="end-btn end-btn--primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Type</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger end-alert" style="border-left: 4px solid #dc3545; animation: end-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@_loadError</span></div>
    }

    <section class="end-kpi-strip" aria-label="Endorsement type KPIs">
        @KpiCard("all", "Total Types", _items.Count.ToString(), "All configured endorsement transaction types", "bi-pen", "blue")
        @KpiCard("active", "Active", _items.Count(x => x.IsActive).ToString(), "Types available for policy change workflows", "bi-check-circle", "green")
        @KpiCard("priority", "Priority", _items.Count(IsPriorityEndorsement).ToString(), "High-impact change, cancellation, vehicle, driver, address, or premium types", "bi-lightning-charge", "purple")
        @KpiCard("change", "Change", _items.Count(IsChangeEndorsement).ToString(), "General policy change and amendment transactions", "bi-arrow-left-right", "cyan")
        @KpiCard("risk", "Needs Review", _items.Count(NeedsReview).ToString(), "Inactive, missing description, or incomplete endorsement definitions", "bi-exclamation-octagon", "amber")
        @KpiCard("inactive", "Inactive", _items.Count(x => !x.IsActive).ToString(), "Types hidden from endorsement workflows", "bi-slash-circle", "red")
    </section>

    <section class="end-workflows" aria-label="Endorsement workflows">
        <button type="button" class="end-workflow" @onclick='() => SetDashboardFocus("all", "importance")'><span class="end-workflow-icon"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></span><span class="end-workflow-meta"><strong>Transaction review</strong><span>Rank endorsement types by workflow importance and readiness</span></span></button>
        <button type="button" class="end-workflow" @onclick='() => SetDashboardFocus("priority", "importance")'><span class="end-workflow-icon"><i class="bi bi-lightning-charge" aria-hidden="true"></i></span><span class="end-workflow-meta"><strong>Priority changes</strong><span>Focus on premium-impacting or high-volume endorsement types</span></span></button>
        <button type="button" class="end-workflow" @onclick='() => SetDashboardFocus("change", "importance")'><span class="end-workflow-icon"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></span><span class="end-workflow-meta"><strong>Change catalog</strong><span>Review general policy change transaction coverage</span></span></button>
        <button type="button" class="end-workflow" @onclick='() => SetDashboardFocus("risk", "importance")'><span class="end-workflow-icon"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></span><span class="end-workflow-meta"><strong>Cleanup queue</strong><span>Find inactive or incomplete endorsement definitions</span></span></button>
        <button type="button" class="end-workflow" @onclick='() => SetDashboardFocus("patterns", "pattern")'><span class="end-workflow-icon"><i class="bi bi-pie-chart" aria-hidden="true"></i></span><span class="end-workflow-meta"><strong>Pattern mix</strong><span>Compare add, remove, change, cancel, and standard patterns</span></span></button>
    </section>

    <section class="end-filter-panel" aria-label="Endorsement type filters">
        <div class="end-search"><i class="bi bi-search" aria-hidden="true"></i><input type="search" placeholder="Search type code, name, description, or pattern..." aria-label="Search endorsement types" value="@_searchTerm" @oninput="args => OnSearchInputValue(args.Value?.ToString())" /></div>
        <div class="end-filter-grid">
            <label><span>Pattern</span><select class="form-select" @bind="_patternFilter" @bind:after="ApplyFilters"><option value="">All patterns</option>@foreach (var pattern in PatternOptions) { <option value="@pattern">@pattern</option> }</select></label>
            <label><span>Status</span><select class="form-select" @bind="_statusFilter" @bind:after="ApplyFilters"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option><option value="Priority">Priority</option><option value="NeedsReview">Needs review</option></select></label>
            <label><span>Sort</span><select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters"><option value="importance">Importance</option><option value="order">Sort order</option><option value="name">Name</option><option value="code">Code</option><option value="pattern">Pattern</option><option value="created">Newest</option></select></label>
        </div>
        <button type="button" class="end-btn end-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
    </section>

    <nav class="end-tabs" aria-label="Endorsement type views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="end-tab @(_activeTab == tab.Key ? "end-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)"><i class="bi @tab.Icon" aria-hidden="true"></i><span>@tab.Label</span><strong>@TabCount(tab.Key)</strong></button>
        }
    </nav>

    <main class="end-dashboard">
        <section class="end-main-card">
            <div class="end-card-header">
                <div><span class="end-section-kicker">@ActiveViewTitle</span><h2>@FilteredTypes.Count() endorsement types</h2><p>Prioritized by enterprise importance: active workflow usage, priority change patterns, sort precedence, and operational completeness.</p></div>
                <div class="end-card-actions">
                    @if (_selectedIds.Count > 0)
                    {
                        <span class="end-sel-count">@_selectedIds.Count selected</span>
                        <button type="button" class="end-btn end-btn--ghost" @onclick="() => ConfirmBulkToggle(true)"><i class="bi bi-check-circle" aria-hidden="true"></i> Activate</button>
                        <button type="button" class="end-btn end-btn--ghost" @onclick="() => ConfirmBulkToggle(false)"><i class="bi bi-slash-circle" aria-hidden="true"></i> Deactivate</button>
                        <button type="button" class="end-btn end-btn--danger-ghost" @onclick="ConfirmBulkDelete"><i class="bi bi-trash3" aria-hidden="true"></i> Remove</button>
                    }
                    <button type="button" class="end-btn end-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="end-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="end-btn end-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="end-loading"><span class="end-spinner"></span> Loading endorsement types...</div>
            }
            else if (!FilteredTypes.Any())
            {
                <div class="end-empty"><i class="bi bi-pen" aria-hidden="true"></i><strong>No endorsement types found</strong><span>Adjust the active KPI, tab, search, or filters.</span></div>
            }
            else if (_activeTab == "patterns")
            {
                <div class="end-group-grid">
                    @foreach (var group in PatternGroups)
                    {
                        <article class="end-group-card"><div class="end-group-icon"><i class="bi @PatternIcon(group.Name)" aria-hidden="true"></i></div><div class="end-group-meta"><h3>@group.Name</h3><p>@group.Count types - @group.Active active - @group.Priority priority - @group.ReviewCount need review</p><div class="end-mini-bar"><span style="width:@group.Percent%"></span></div></div><button type="button" class="end-btn end-btn--ghost" @onclick="() => FilterByPattern(group.Name)">Open</button></article>
                    }
                </div>
            }
            else
            {
                <div class="end-table-wrap">
                    <table class="end-table">
                        <thead><tr><th class="end-check-col"><input type="checkbox" checked="@AllPageSelected" @onchange="args => ToggleSelectAllPage(args.Value is bool value && value)" aria-label="Select all endorsement types on page" /></th><th>Importance</th><th>Endorsement Type</th><th>Pattern</th><th>Status</th><th>Readiness</th><th>Order</th><th>Created</th><th class="end-actions-col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var type in PagedTypes)
                            {
                                <tr class="@(_selected?.EndorsementTypeId == type.EndorsementTypeId ? "end-row end-row--selected" : "end-row")" @onclick="() => SelectRow(type)">
                                    <td class="end-check-col" @onclick:stopPropagation="true"><input type="checkbox" checked="@IsSelected(type)" @onchange="args => ToggleSelect(type, args.Value is bool value && value)" aria-label="Select endorsement type" /></td>
                                    <td>@ImportanceBadge(type)</td>
                                    <td><div class="end-type-cell"><div class="end-avatar" style="@AvatarStyle(type.TypeName)" aria-hidden="true">@Initials(type.TypeName)</div><div class="end-type-meta"><button type="button" class="end-link-button" @onclick:stopPropagation="true" @onclick="() => OpenEditAsync(type)">@type.TypeName</button><small>@Safe(type.TypeCode, "No code")</small></div></div></td>
                                    <td><span class="end-pill @PatternBadgeClass(type)"><i class="bi @PatternIcon(Pattern(type))" aria-hidden="true"></i>@Pattern(type)</span></td>
                                    <td><span class="end-pill @(type.IsActive ? "end-pill--green" : "end-pill--neutral")">@(type.IsActive ? "Active" : "Inactive")</span></td>
                                    <td><span class="end-pill @(NeedsReview(type) ? "end-pill--amber" : "end-pill--green")">@(NeedsReview(type) ? "Review" : "Ready")</span></td>
                                    <td><span class="end-date">@type.SortOrder</span></td>
                                    <td><span class="end-date">@FormatDate(type.CreatedDateUtc)</span></td>
                                    <td class="end-actions-col" @onclick:stopPropagation="true"><button type="button" class="end-icon-btn" title="Edit endorsement type" @onclick="() => OpenEditAsync(type)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="end-icon-btn" title="@(type.IsActive ? "Deactivate endorsement type" : "Activate endorsement type")" @onclick="() => ConfirmToggle(type)"><i class="bi @(type.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i></button><button type="button" class="end-icon-btn end-icon-btn--danger" title="Delete endorsement type" @onclick="() => ConfirmDelete(type)"><i class="bi bi-trash3" aria-hidden="true"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="end-side-panel" aria-label="Endorsement insights">
            <section class="end-panel-card">
                <span class="end-section-kicker">Selected type</span>
                @if (_selected is null)
                {
                    <div class="end-empty end-empty--compact"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select an endorsement type</strong><span>Open details, recommendations, and quick actions.</span></div>
                }
                else
                {
                    <div class="end-selected__title"><div class="end-avatar end-avatar--lg" style="@AvatarStyle(_selected.TypeName)" aria-hidden="true">@Initials(_selected.TypeName)</div><div><h3>@_selected.TypeName</h3><span>@Safe(_selected.TypeCode, "No code") - @Pattern(_selected)</span></div></div>
                    <div class="end-score-card @ImportanceClass(_selected)"><span>Importance score</span><strong>@ImportanceScore(_selected)</strong><small>@RecommendedAction(_selected)</small></div>
                    <dl class="end-detail-list"><div><dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd></div><div><dt>Pattern</dt><dd>@Pattern(_selected)</dd></div><div><dt>Priority</dt><dd>@(IsPriorityEndorsement(_selected) ? "Yes" : "No")</dd></div><div><dt>Sort order</dt><dd>@_selected.SortOrder</dd></div><div><dt>Created</dt><dd>@FormatDate(_selected.CreatedDateUtc)</dd></div></dl>
                    @if (!string.IsNullOrWhiteSpace(_selected.Description)) { <p class="end-description">@_selected.Description</p> }
                    @if (_selectedCatalog?.Profile is { } profile)
                    {
                        <dl class="end-detail-list"><div><dt>Category</dt><dd>@profile.CategoryCode</dd></div><div><dt>Operation</dt><dd>@profile.DefaultOperationCode</dd></div><div><dt>LOB scope</dt><dd>@_selectedCatalog.LinesOfBusiness.Count</dd></div><div><dt>Documents</dt><dd>@_selectedCatalog.DocumentRequirements.Count(x => x.IsRequired)</dd></div><div><dt>Workflow rules</dt><dd>@_selectedCatalog.WorkflowRules.Count</dd></div><div><dt>Carrier routes</dt><dd>@_selectedCatalog.CarrierMethods.Count</dd></div></dl>
                    }
                    <div class="end-selected-actions"><button type="button" class="end-btn end-btn--primary" @onclick="() => OpenEditAsync(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="end-btn end-btn--ghost" @onclick="() => ConfirmToggle(_selected)"><i class="bi @(_selected.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i> @(_selected.IsActive ? "Deactivate" : "Activate")</button></div>
                }
            </section>
            <section class="end-panel-card"><span class="end-section-kicker">Enterprise insights</span><div class="end-insight-list"><div class="end-insight"><i class="bi bi-lightning-charge" aria-hidden="true"></i><div><strong>Priority changes</strong><span>@PriorityInsight</span></div></div><div class="end-insight"><i class="bi bi-pie-chart" aria-hidden="true"></i><div><strong>Pattern coverage</strong><span>@PatternInsight</span></div></div><div class="end-insight"><i class="bi bi-shield-check" aria-hidden="true"></i><div><strong>Workflow readiness</strong><span>@ReadinessInsight</span></div></div></div></section>
        </aside>
    </main>
</div>

@if (_showForm)
{
    <div class="end-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="endorsement-form-title">
        <div class="end-modal end-modal--wide">
            <div class="um-modal-header"><i class="bi bi-pen" aria-hidden="true"></i><span id="endorsement-form-title">@(_editId.HasValue ? "Edit Endorsement Type" : "Add Endorsement Type")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="end-form-grid">
                <label class="end-field"><span>Type Code <em>*</em></span><InputText @bind-Value="_form.TypeCode" class="form-control" placeholder="e.g. ADD_VEHICLE" /></label>
                <label class="end-field"><span>Type Name <em>*</em></span><InputText @bind-Value="_form.TypeName" class="form-control" placeholder="Add Vehicle" /></label>
                <label class="end-field"><span>Sort Order</span><InputNumber @bind-Value="_form.SortOrder" class="form-control" /></label>
                <label class="end-field end-field--wide"><span>Description</span><InputTextArea @bind-Value="_form.Description" class="form-control" rows="3" placeholder="Describe when this endorsement transaction type should be used." /></label>
                @if (_editId.HasValue) { <label class="end-check-field"><InputCheckbox @bind-Value="_form.IsActive" /><span>Active</span></label> }
                @if (_editId.HasValue && _selectedCatalog?.Profile is not null)
                {
                    <label class="end-field"><span>Category</span><InputSelect @bind-Value="_form.CategoryCode" class="form-select">@foreach(var option in CatalogOptions("ChangeCategory")){<option value="@option.OptionCode">@option.DisplayName</option>}</InputSelect></label>
                    <label class="end-field"><span>Default Operation</span><InputSelect @bind-Value="_form.DefaultOperationCode" class="form-select">@foreach(var option in CatalogOptions("Operation")){<option value="@option.OptionCode">@option.DisplayName</option>}</InputSelect></label>
                    <label class="end-field"><span>Premium Impact</span><InputSelect @bind-Value="_form.PremiumImpactCode" class="form-select">@foreach(var option in CatalogOptions("PremiumImpact")){<option value="@option.OptionCode">@option.DisplayName</option>}</InputSelect></label>
                    <label class="end-field"><span>Billing Impact</span><InputSelect @bind-Value="_form.BillingImpactCode" class="form-select">@foreach(var option in CatalogOptions("BillingImpact")){<option value="@option.OptionCode">@option.DisplayName</option>}</InputSelect></label>
                    <label class="end-field"><span>Commission Impact</span><InputSelect @bind-Value="_form.CommissionImpactCode" class="form-select">@foreach(var option in CatalogOptions("CommissionImpact")){<option value="@option.OptionCode">@option.DisplayName</option>}</InputSelect></label>
                    <label class="end-field"><span>Authority</span><InputSelect @bind-Value="_form.AuthorityCode" class="form-select">@foreach(var option in CatalogOptions("Authority")){<option value="@option.OptionCode">@option.DisplayName</option>}</InputSelect></label>
                    <label class="end-field"><span>Approval Level</span><InputSelect @bind-Value="_form.ApprovalLevelCode" class="form-select">@foreach(var option in CatalogOptions("ApprovalLevel")){<option value="@option.OptionCode">@option.DisplayName</option>}</InputSelect></label>
                    <label class="end-field"><span>Carrier Method</span><InputSelect @bind-Value="_form.CarrierMethodCode" class="form-select">@foreach(var option in CatalogOptions("CarrierMethod")){<option value="@option.OptionCode">@option.DisplayName</option>}</InputSelect></label>
                    <label class="end-field"><span>Document Delivery</span><InputSelect @bind-Value="_form.DocumentDeliveryCode" class="form-select">@foreach(var option in CatalogOptions("DocumentDelivery")){<option value="@option.OptionCode">@option.DisplayName</option>}</InputSelect></label>
                    <label class="end-check-field"><InputCheckbox @bind-Value="_form.RequiresCarrierApproval" /><span>Carrier approval</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.RequiresUnderwritingReview" /><span>Underwriting review</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.RequiresSignedRequest" /><span>Signed request</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.RequiresClientAuthorization" /><span>Client authorization</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.RequiresCertificateReview" /><span>Certificate review</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.RequiresBrokerOfRecord" /><span>Broker of record</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.RequiresAccountingWork" /><span>Accounting work</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.RequiresCommissionWork" /><span>Commission work</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.RequiresDocumentWork" /><span>Document work</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.RequiresPolicyVersion" /><span>Policy version</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.SupportsBackdate" /><span>Supports backdate</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.SupportsReversal" /><span>Supports reversal</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.IsHighRisk" /><span>High risk</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.IsPremiumBearing" /><span>Premium bearing</span></label><label class="end-check-field"><InputCheckbox @bind-Value="_form.IsCertificateRelated" /><span>Certificate related</span></label>
                    <div class="end-field end-field--wide"><span>Line of business scope</span>@foreach (var item in _configuration.LinesOfBusiness) { <div class="input-group mb-2"><select class="form-select" @bind="item.LineOfBusinessCode"><option value="*">All lines</option>@foreach (var lob in _lobs.Where(x => x.IsActive)){<option value="@lob.LobCode">@lob.LobName (@lob.LobCode)</option>}</select><span class="input-group-text"><InputCheckbox @bind-Value="item.IsDefault" /> Default</span><button type="button" class="btn btn-outline-danger" @onclick="() => _configuration.LinesOfBusiness.Remove(item)"><i class="bi bi-trash"></i></button></div> }<button type="button" class="end-btn end-btn--ghost" @onclick="AddLineOfBusiness"><i class="bi bi-plus"></i> Add LOB scope</button></div>
                    <div class="end-field end-field--wide"><span>Document requirements</span>@foreach (var item in _configuration.DocumentRequirements) { <div class="row g-2 mb-2"><div class="col-md-3"><InputText class="form-control" @bind-Value="item.RequirementCode" placeholder="Requirement code" /></div><div class="col-md-3"><InputText class="form-control" @bind-Value="item.DocumentKindCode" placeholder="Document kind" /></div><div class="col-md-2"><InputText class="form-control" @bind-Value="item.AcordFormNumber" placeholder="ACORD form" /></div><div class="col-md-2 d-flex align-items-center gap-2"><InputCheckbox @bind-Value="item.IsRequired" /> Required</div><div class="col-md-2"><button type="button" class="btn btn-outline-danger" @onclick="() => _configuration.DocumentRequirements.Remove(item)"><i class="bi bi-trash"></i></button></div></div> }<button type="button" class="end-btn end-btn--ghost" @onclick="AddDocumentRequirement"><i class="bi bi-plus"></i> Add document</button></div>
                    <div class="end-field end-field--wide"><span>Workflow rules</span>@foreach (var item in _configuration.WorkflowRules) { <div class="row g-2 mb-2"><div class="col-md-2"><select class="form-select" @bind="item.FromStatusCode">@foreach(var option in CatalogOptions("Status")){<option value="@option.OptionCode">@option.DisplayName</option>}</select></div><div class="col-md-2"><select class="form-select" @bind="item.ToStatusCode">@foreach(var option in CatalogOptions("Status")){<option value="@option.OptionCode">@option.DisplayName</option>}</select></div><div class="col-md-3"><InputText class="form-control" @bind-Value="item.RequiredPermissionCode" placeholder="Permission code" /></div><div class="col-md-4 d-flex flex-wrap gap-2 small"><label><InputCheckbox @bind-Value="item.RequiresApproval" /> Approval</label><label><InputCheckbox @bind-Value="item.RequiresCarrierDispatch" /> Carrier</label><label><InputCheckbox @bind-Value="item.RequiresAccountingWork" /> Accounting</label><label><InputCheckbox @bind-Value="item.RequiresDocumentWork" /> Documents</label><label><InputCheckbox @bind-Value="item.RequiresPolicyVersion" /> Version</label></div><div class="col-md-1"><button type="button" class="btn btn-outline-danger" @onclick="() => _configuration.WorkflowRules.Remove(item)"><i class="bi bi-trash"></i></button></div></div> }<button type="button" class="end-btn end-btn--ghost" @onclick="AddWorkflowRule"><i class="bi bi-plus"></i> Add workflow rule</button></div>
                    <div class="end-field end-field--wide"><span>Carrier routes</span>@foreach (var item in _configuration.CarrierMethods) { <div class="row g-2 mb-2"><div class="col-md-3"><select class="form-select" @bind="item.CarrierMethodCode">@foreach(var option in CatalogOptions("CarrierMethod")){<option value="@option.OptionCode">@option.DisplayName</option>}</select></div><div class="col-md-3"><select class="form-select" @bind="item.LineOfBusinessCode"><option value="">All lines</option>@foreach (var lob in _lobs.Where(x => x.IsActive)){<option value="@lob.LobCode">@lob.LobName</option>}</select></div><div class="col-md-4"><InputText class="form-control" @bind-Value="item.PortalInstructions" placeholder="Route instructions" /></div><div class="col-md-1 d-flex align-items-center"><InputCheckbox @bind-Value="item.IsDefault" /></div><div class="col-md-1"><button type="button" class="btn btn-outline-danger" @onclick="() => _configuration.CarrierMethods.Remove(item)"><i class="bi bi-trash"></i></button></div></div> }<button type="button" class="end-btn end-btn--ghost" @onclick="AddCarrierMethod"><i class="bi bi-plus"></i> Add carrier route</button></div>
                }
            </div></div><div class="um-modal-footer"><button type="button" class="end-btn end-btn--ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="end-btn end-btn--primary" disabled="@_saving">@if (_saving) { <span class="end-spin-sm"></span> } @(_editId.HasValue ? "Save Changes" : "Create Type")</button></div></EditForm>
        </div>
    </div>
}

@if (_confirmVisible)
{
    <div class="end-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="endorsement-confirm-title"><div class="end-confirm"><div class="end-confirm__body"><div class="end-confirm-icon end-confirm-icon--danger"><i class="bi @_confirmIcon" aria-hidden="true"></i></div><div><h3 id="endorsement-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div></div><div class="end-modal__footer"><button type="button" class="end-btn end-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button><button type="button" class="end-btn end-btn--danger" @onclick="ExecuteConfirmedAsync" disabled="@_saving">@if (_saving) { <span class="end-spin-sm"></span> } Confirm</button></div></div></div>
}

<div class="end-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="end-toast end-toast--@toast.Kind"><i class="bi @(toast.Kind == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    }
</div>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    Guid TenantId { get; set; }
    readonly List<DashboardTab> _tabs = [new("all", "All", "bi-pen"), new("active", "Active", "bi-check-circle"), new("priority", "Priority", "bi-lightning-charge"), new("change", "Change", "bi-arrow-left-right"), new("risk", "Needs Review", "bi-exclamation-octagon"), new("inactive", "Inactive", "bi-slash-circle"), new("patterns", "Patterns", "bi-pie-chart")];
    List<EndorsementTypeDto> _items = [];
    PolicyEndorsementCatalogDto _catalog = new();
    PolicyEndorsementTypeCatalogDto? _selectedCatalog;
    HashSet<Guid> _selectedIds = [];
    List<ToastItem> _toasts = [];
    List<LineOfBusinessDto> _lobs = [];
    EndorsementTypeDto? _selected;
    TypeFormModel _form = new();
    ConfigurationFormModel _configuration = new();
    Func<Task>? _confirmAction;
    Guid? _editId;
    string _activeTab = "all";
    string _searchTerm = string.Empty;
    string _patternFilter = string.Empty;
    string _statusFilter = string.Empty;
    string _sortMode = "importance";
    string _confirmTitle = string.Empty;
    string _confirmMessage = string.Empty;
    string _confirmIcon = "bi-exclamation-triangle-fill";
    string? _loadError;
    bool _loading;
    bool _saving;
    bool _showForm;
    bool _confirmVisible;
    int _page = 1;
    const int PageSize = 12;

    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policy Config", null), new("Endorsement Types", null)); await LoadAsync(); }

    IEnumerable<EndorsementTypeDto> FilteredTypes
    {
        get
        {
            IEnumerable<EndorsementTypeDto> query = _items;
            query = _activeTab switch { "active" => query.Where(x => x.IsActive), "priority" => query.Where(IsPriorityEndorsement), "change" => query.Where(IsChangeEndorsement), "risk" => query.Where(NeedsReview), "inactive" => query.Where(x => !x.IsActive), _ => query };
            if (!string.IsNullOrWhiteSpace(_searchTerm)) query = query.Where(MatchesSearch);
            if (!string.IsNullOrWhiteSpace(_patternFilter)) query = query.Where(x => string.Equals(Pattern(x), _patternFilter, StringComparison.OrdinalIgnoreCase));
            query = _statusFilter switch { "Active" => query.Where(x => x.IsActive), "Inactive" => query.Where(x => !x.IsActive), "Priority" => query.Where(IsPriorityEndorsement), "NeedsReview" => query.Where(NeedsReview), _ => query };
            return _sortMode switch { "order" => query.OrderBy(x => x.SortOrder).ThenBy(x => x.TypeName), "name" => query.OrderBy(x => x.TypeName), "code" => query.OrderBy(x => x.TypeCode), "pattern" => query.OrderBy(Pattern).ThenBy(x => x.SortOrder).ThenBy(x => x.TypeName), "created" => query.OrderByDescending(x => x.CreatedDateUtc), _ => query.OrderByDescending(ImportanceScore).ThenBy(x => x.SortOrder).ThenBy(x => x.TypeName) };
        }
    }

    List<EndorsementTypeDto> PagedTypes => FilteredTypes.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredTypes.Count() / (double)PageSize));
    bool AllPageSelected => PagedTypes.Count > 0 && PagedTypes.All(IsSelected);
    bool HasFilters => !string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_patternFilter) || !string.IsNullOrWhiteSpace(_statusFilter) || _activeTab != "all" || _sortMode != "importance";
    string ActiveViewTitle => _tabs.FirstOrDefault(x => x.Key == _activeTab)?.Label ?? "All";
    IEnumerable<string> PatternOptions => PatternGroups.Select(x => x.Name);
    string PriorityInsight => _items.Any(IsPriorityEndorsement) ? $"{_items.Count(IsPriorityEndorsement)} priority endorsement types affect high-impact policy change workflows." : "No priority endorsement patterns were detected.";
    string PatternInsight => _items.Count == 0 ? "Create endorsement types to define policy change transaction coverage." : $"{PatternGroups.Count} endorsement patterns are represented across the catalog.";
    string ReadinessInsight => _items.Count == 0 ? "Create endorsement types before enabling change workflows." : $"{Math.Round(_items.Count(x => x.IsActive && !NeedsReview(x)) * 100m / _items.Count)}% of endorsement types are active with no review flags.";
    List<PatternGroupSummary> PatternGroups => _items.GroupBy(Pattern).Select(g => new PatternGroupSummary(g.Key, g.Count(), g.Count(x => x.IsActive), g.Count(IsPriorityEndorsement), g.Count(NeedsReview), _items.Count == 0 ? 0 : Math.Round(g.Count() * 100m / _items.Count, 0))).OrderByDescending(x => x.Count).ToList();

    async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchEndorsementTypesAsync(TenantId, null, pageSize: 500); var lobs = await Api.SearchLobsAsync(TenantId, pageSize: 500); _catalog = await Api.GetPolicyEndorsementCatalogAsync(TenantId) ?? new(); _lobs = lobs?.Items.ToList() ?? []; _items = result?.Items.ToList() ?? []; _selectedIds.RemoveWhere(id => _items.All(x => x.EndorsementTypeId != id)); _selected = _selected is null ? _items.OrderByDescending(ImportanceScore).FirstOrDefault() : _items.FirstOrDefault(x => x.EndorsementTypeId == _selected.EndorsementTypeId) ?? _items.OrderByDescending(ImportanceScore).FirstOrDefault(); _selectedCatalog = _selected is null ? null : _catalog.Types.FirstOrDefault(x => x.EndorsementTypeId == _selected.EndorsementTypeId); NormalizePage(); } catch (Exception ex) { _loadError = $"Failed to load endorsement types: {ex.Message}"; } finally { _loading = false; } }
    Task RefreshAsync() => LoadAsync();
    void ApplyFilters() { _page = 1; NormalizePage(); }
    void OnSearchInputValue(string? value) { _searchTerm = value ?? string.Empty; ApplyFilters(); }
    void SetDashboardFocus(string tab, string sort) { _activeTab = tab; _sortMode = sort; _page = 1; NormalizePage(); }
    void SetActiveTab(string tab) { _activeTab = tab; _page = 1; NormalizePage(); }
    void PreviousPage() { if (_page > 1) _page--; }
    void NextPage() { if (_page < TotalPages) _page++; }
    void NormalizePage() { if (_page > TotalPages) _page = TotalPages; }
    void SelectRow(EndorsementTypeDto item) { _selected = item; _selectedCatalog = _catalog.Types.FirstOrDefault(x => x.EndorsementTypeId == item.EndorsementTypeId); }
    bool IsSelected(EndorsementTypeDto item) => _selectedIds.Contains(item.EndorsementTypeId);
    void ToggleSelect(EndorsementTypeDto item, bool selected) { if (selected) _selectedIds.Add(item.EndorsementTypeId); else _selectedIds.Remove(item.EndorsementTypeId); _selected = item; }
    void ToggleSelectAllPage(bool selected) { foreach (var item in PagedTypes) { if (selected) _selectedIds.Add(item.EndorsementTypeId); else _selectedIds.Remove(item.EndorsementTypeId); } }
    void ClearFilters() { _searchTerm = string.Empty; _patternFilter = string.Empty; _statusFilter = string.Empty; _sortMode = "importance"; _activeTab = "all"; _page = 1; }
    void FilterByPattern(string pattern) { _activeTab = "all"; _patternFilter = pattern; _sortMode = "importance"; _page = 1; }

    void OpenCreate() { _editId = null; _form = new() { IsActive = true, SortOrder = NextSortOrder() }; _showForm = true; }
    async Task OpenEditAsync(EndorsementTypeDto item) { _selected = item; _selectedCatalog = await Api.GetPolicyEndorsementTypeCatalogAsync(TenantId, item.TypeCode); _editId = item.EndorsementTypeId; _form = TypeFormModel.From(item, _selectedCatalog?.Profile); _configuration = ConfigurationFormModel.From(_selectedCatalog); _showForm = true; }
    void CloseForm() { _showForm = false; ResetForm(); }
    void ResetForm() { _form = new(); _editId = null; }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue)
            {
                await Api.UpdateEndorsementTypeAsync(_editId.Value, new(_form.TypeCode.Trim(), _form.TypeName.Trim(), NormalizeNullable(_form.Description), _form.IsActive, _form.SortOrder));
                if (_selectedCatalog?.Profile is not null)
                {
                    await Api.UpdatePolicyEndorsementTypeProfileAsync(_editId.Value, _form.ToProfileRequest(TenantId, _selectedCatalog.Profile.RowVersion));
                    await Api.ReplacePolicyEndorsementTypeConfigurationAsync(_editId.Value, _configuration.ToRequest(TenantId));
                }
            }
            else await Api.CreateEndorsementTypeAsync(new(TenantId, _form.TypeCode.Trim(), _form.TypeName.Trim(), NormalizeNullable(_form.Description), _form.SortOrder));
            _showForm = false; ShowToast("success", _editId.HasValue ? "Endorsement type updated successfully." : "Endorsement type created successfully."); ResetForm(); await LoadAsync();
        }
        catch (Exception ex) { ShowToast("danger", $"Save failed: {ex.Message}"); }
        finally { _saving = false; }
    }

    void AddLineOfBusiness() => _configuration.LinesOfBusiness.Add(new() { LineOfBusinessCode = "*", IsActive = true, SortOrder = (_configuration.LinesOfBusiness.Count + 1) * 10 });
    void AddDocumentRequirement() => _configuration.DocumentRequirements.Add(new() { IsRequired = true, IsActive = true, SortOrder = (_configuration.DocumentRequirements.Count + 1) * 10 });
    void AddWorkflowRule() => _configuration.WorkflowRules.Add(new() { FromStatusCode = DefaultOption("Status"), ToStatusCode = DefaultOption("Status"), IsActive = true, SortOrder = (_configuration.WorkflowRules.Count + 1) * 10 });
    void AddCarrierMethod() => _configuration.CarrierMethods.Add(new() { CarrierMethodCode = DefaultOption("CarrierMethod"), IsDefault = _configuration.CarrierMethods.Count == 0, IsActive = true, SortOrder = (_configuration.CarrierMethods.Count + 1) * 10 });
    string DefaultOption(string group) => CatalogOptions(group).FirstOrDefault(x => x.IsDefault)?.OptionCode ?? CatalogOptions(group).FirstOrDefault()?.OptionCode ?? string.Empty;

    void ConfirmToggle(EndorsementTypeDto item) { var enable = !item.IsActive; OpenConfirm(enable ? "Activate Endorsement Type" : "Deactivate Endorsement Type", $"Are you sure you want to {(enable ? "activate" : "deactivate")} {item.TypeName}? This changes availability in endorsement workflows.", "bi-shield-exclamation", () => SetTypeActiveAsync(item, enable)); }
    void ConfirmDelete(EndorsementTypeDto item) => OpenConfirm("Delete Endorsement Type", $"Are you sure you want to delete {item.TypeName}? This action cannot be undone.", "bi-trash3-fill", () => DeleteTypeAsync(item));
    void ConfirmBulkToggle(bool enable) => OpenConfirm(enable ? "Activate Selected Types" : "Deactivate Selected Types", $"Are you sure you want to {(enable ? "activate" : "deactivate")} {_selectedIds.Count} selected endorsement type(s)?", "bi-shield-exclamation", () => BulkSetActiveAsync(enable));
    void ConfirmBulkDelete() => OpenConfirm("Delete Selected Types", $"Are you sure you want to delete {_selectedIds.Count} selected endorsement type(s)? This action cannot be undone.", "bi-trash3-fill", BulkDeleteAsync);
    void OpenConfirm(string title, string message, string icon, Func<Task> action) { _confirmTitle = title; _confirmMessage = message; _confirmIcon = icon; _confirmAction = action; _confirmVisible = true; }
    void CloseConfirm() { _confirmVisible = false; _confirmAction = null; }
    async Task ExecuteConfirmedAsync() { if (_confirmAction is null) return; _saving = true; try { await _confirmAction(); _confirmVisible = false; _confirmAction = null; } finally { _saving = false; } }

    async Task SetTypeActiveAsync(EndorsementTypeDto item, bool active) { try { await Api.UpdateEndorsementTypeAsync(item.EndorsementTypeId, new(item.TypeCode, item.TypeName, item.Description, active, item.SortOrder)); ShowToast("success", active ? "Endorsement type activated." : "Endorsement type deactivated."); await LoadAsync(); } catch (Exception ex) { ShowToast("danger", $"Update failed: {ex.Message}"); } }
    async Task DeleteTypeAsync(EndorsementTypeDto item) { try { await Api.DeleteEndorsementTypeAsync(item.EndorsementTypeId); _selectedIds.Remove(item.EndorsementTypeId); if (_selected?.EndorsementTypeId == item.EndorsementTypeId) _selected = null; ShowToast("success", "Endorsement type deleted."); await LoadAsync(); } catch (Exception ex) { ShowToast("danger", $"Delete failed: {ex.Message}"); } }
    async Task BulkSetActiveAsync(bool active) { var selected = _items.Where(x => _selectedIds.Contains(x.EndorsementTypeId)).ToList(); var updated = 0; foreach (var item in selected) { try { await Api.UpdateEndorsementTypeAsync(item.EndorsementTypeId, new(item.TypeCode, item.TypeName, item.Description, active, item.SortOrder)); updated++; } catch (Exception ex) { ShowToast("danger", $"Update failed for {item.TypeName}: {ex.Message}"); } } ShowToast("success", $"{updated} endorsement type(s) {(active ? "activated" : "deactivated")}."); _selectedIds.Clear(); await LoadAsync(); }
    async Task BulkDeleteAsync() { var selected = _items.Where(x => _selectedIds.Contains(x.EndorsementTypeId)).ToList(); var deleted = 0; foreach (var item in selected) { try { await Api.DeleteEndorsementTypeAsync(item.EndorsementTypeId); deleted++; } catch (Exception ex) { ShowToast("danger", $"Delete failed for {item.TypeName}: {ex.Message}"); } } ShowToast("success", $"{deleted} endorsement type(s) deleted."); _selectedIds.Clear(); _selected = null; await LoadAsync(); }

    RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string color) => @<button type="button" class="end-kpi-card end-kpi-card--@color @(_activeTab == key ? "end-kpi-card--active" : null)" title="@subtitle" @onclick="() => SetActiveTab(key)"><span class="end-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span><span class="end-kpi-body"><span class="end-kpi-label">@label</span><strong class="end-kpi-value">@value</strong><span class="end-kpi-sub">@subtitle</span></span></button>;
    int TabCount(string key) => key switch { "active" => _items.Count(x => x.IsActive), "priority" => _items.Count(IsPriorityEndorsement), "change" => _items.Count(IsChangeEndorsement), "risk" => _items.Count(NeedsReview), "inactive" => _items.Count(x => !x.IsActive), "patterns" => PatternGroups.Count, _ => _items.Count };
    bool MatchesSearch(EndorsementTypeDto item) { var term = _searchTerm.Trim(); return Contains(item.TypeCode, term) || Contains(item.TypeName, term) || Contains(item.Description, term) || Contains(Pattern(item), term); }
    static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string? NormalizeNullable(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    static string FormatDate(DateTime date) => date == default ? "-" : date.ToLocalTime().ToString("MMM d, yyyy");
    static bool NeedsReview(EndorsementTypeDto item) => !item.IsActive || string.IsNullOrWhiteSpace(item.TypeCode) || string.IsNullOrWhiteSpace(item.TypeName) || string.IsNullOrWhiteSpace(item.Description);
    static bool IsPriorityEndorsement(EndorsementTypeDto item) => Contains(item.TypeCode, "CANCEL") || Contains(item.TypeCode, "ADD") || Contains(item.TypeCode, "REMOVE") || Contains(item.TypeName, "Cancel") || Contains(item.TypeName, "Vehicle") || Contains(item.TypeName, "Driver") || Contains(item.TypeName, "Address") || Contains(item.TypeName, "Premium") || Contains(item.TypeName, "Coverage") || Contains(item.Description, "premium");
    static bool IsChangeEndorsement(EndorsementTypeDto item) => Contains(item.TypeCode, "CHANGE") || Contains(item.TypeCode, "AMEND") || Contains(item.TypeName, "Change") || Contains(item.TypeName, "Amend");
    static string Pattern(EndorsementTypeDto item)
    {
        if (Contains(item.TypeCode, "ADD") || Contains(item.TypeName, "Add")) return "Add";
        if (Contains(item.TypeCode, "REMOVE") || Contains(item.TypeName, "Remove") || Contains(item.TypeName, "Delete")) return "Remove";
        if (Contains(item.TypeCode, "CANCEL") || Contains(item.TypeName, "Cancel")) return "Cancel";
        if (IsChangeEndorsement(item)) return "Change";
        if (IsPriorityEndorsement(item)) return "Priority";
        return "Standard";
    }
    static string PatternIcon(string pattern) => pattern switch { "Add" => "bi-plus-circle", "Remove" => "bi-dash-circle", "Cancel" => "bi-x-octagon", "Change" => "bi-arrow-left-right", "Priority" => "bi-lightning-charge", _ => "bi-pen" };
    static string PatternBadgeClass(EndorsementTypeDto item) => Pattern(item) switch { "Add" => "end-pill--green", "Remove" => "end-pill--red", "Cancel" => "end-pill--red", "Change" => "end-pill--cyan", "Priority" => "end-pill--purple", _ => "end-pill--blue" };
    static int ImportanceScore(EndorsementTypeDto item) { var score = 30; if (item.IsActive) score += 14; else score += 18; if (IsPriorityEndorsement(item)) score += 22; if (IsChangeEndorsement(item)) score += 10; if (item.SortOrder <= 10) score += 6; if (!string.IsNullOrWhiteSpace(item.Description)) score += 6; else score += 10; return Math.Clamp(score, 0, 100); }
    static string RecommendedAction(EndorsementTypeDto item) { if (!item.IsActive) return "Review whether this endorsement type should remain inactive."; if (string.IsNullOrWhiteSpace(item.Description)) return "Add usage guidance for servicing and policy change teams."; if (IsPriorityEndorsement(item)) return "Priority change type is ready for high-impact endorsement workflows."; return "Configuration is ready for endorsement workflows."; }
    static string ImportanceClass(EndorsementTypeDto item) => ImportanceScore(item) switch { >= 80 => "end-score-card--red", >= 65 => "end-score-card--amber", >= 45 => "end-score-card--cyan", _ => "end-score-card--green" };
    static MarkupString ImportanceBadge(EndorsementTypeDto item) { var score = ImportanceScore(item); var css = score switch { >= 80 => "red", >= 65 => "amber", >= 45 => "cyan", _ => "green" }; return new($"<span class=\"end-risk-badge end-risk-badge--{css}\">{score}</span>"); }
    static string Initials(string? value) { var parts = (value ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); return parts.Length switch { 0 => "ET", 1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(), _ => string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0]))) }; }
    static string AvatarStyle(string? value) { var hash = Math.Abs((value ?? "EndorsementType").GetHashCode()); var hue = hash % 360; return $"background:linear-gradient(135deg,hsl({hue},78%,48%),hsl({(hue + 35) % 360},82%,36%));"; }
    int NextSortOrder() => _items.Count == 0 ? 10 : _items.Max(x => x.SortOrder) + 10;
    void ShowToast(string kind, string message) { _toasts.Insert(0, new(Guid.NewGuid(), kind, message)); if (_toasts.Count > 4) _toasts.RemoveRange(4, _toasts.Count - 4); }
    void DismissToast(Guid id) => _toasts.RemoveAll(x => x.Id == id);
    async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); TenantId = context.TenantId; TenantAdminUserId = context.UserId; DevTenantId = context.TenantId; DevUserId = context.UserId; }
    IEnumerable<PolicyEndorsementOptionDto> CatalogOptions(string group) => _catalog.Options.Where(x => x.IsActive && string.Equals(x.OptionGroupCode, group, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.SortOrder);
    sealed class TypeFormModel
    {
        [Required, StringLength(50)] public string TypeCode { get; set; } = string.Empty;
        [Required, StringLength(100)] public string TypeName { get; set; } = string.Empty;
        [StringLength(500)] public string? Description { get; set; }
        [Range(0, 9999)] public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
        [Required, StringLength(50)] public string CategoryCode { get; set; } = string.Empty;
        [Required, StringLength(50)] public string DefaultOperationCode { get; set; } = string.Empty;
        [Required, StringLength(50)] public string PremiumImpactCode { get; set; } = string.Empty;
        [Required, StringLength(50)] public string BillingImpactCode { get; set; } = string.Empty;
        [Required, StringLength(50)] public string CommissionImpactCode { get; set; } = string.Empty;
        [Required, StringLength(50)] public string AuthorityCode { get; set; } = string.Empty;
        [Required, StringLength(50)] public string ApprovalLevelCode { get; set; } = string.Empty;
        [Required, StringLength(50)] public string CarrierMethodCode { get; set; } = string.Empty;
        [Required, StringLength(50)] public string DocumentDeliveryCode { get; set; } = string.Empty;
        public bool RequiresCarrierApproval { get; set; }
        public bool RequiresUnderwritingReview { get; set; }
        public bool RequiresSignedRequest { get; set; }
        public bool RequiresClientAuthorization { get; set; }
        public bool RequiresCertificateReview { get; set; }
        public bool RequiresBrokerOfRecord { get; set; }
        public bool RequiresAccountingWork { get; set; }
        public bool RequiresCommissionWork { get; set; }
        public bool RequiresDocumentWork { get; set; }
        public bool RequiresPolicyVersion { get; set; }
        public bool SupportsBackdate { get; set; }
        public bool SupportsReversal { get; set; }
        public bool IsHighRisk { get; set; }
        public bool IsPremiumBearing { get; set; }
        public bool IsCertificateRelated { get; set; }

        public static TypeFormModel From(EndorsementTypeDto type, PolicyEndorsementTypeProfileDto? profile) => new() { TypeCode=type.TypeCode,TypeName=type.TypeName,Description=type.Description,SortOrder=type.SortOrder,IsActive=type.IsActive,CategoryCode=profile?.CategoryCode??string.Empty,DefaultOperationCode=profile?.DefaultOperationCode??string.Empty,PremiumImpactCode=profile?.PremiumImpactCode??string.Empty,BillingImpactCode=profile?.BillingImpactCode??string.Empty,CommissionImpactCode=profile?.CommissionImpactCode??string.Empty,AuthorityCode=profile?.AuthorityCode??string.Empty,ApprovalLevelCode=profile?.ApprovalLevelCode??string.Empty,CarrierMethodCode=profile?.CarrierMethodCode??string.Empty,DocumentDeliveryCode=profile?.DocumentDeliveryCode??string.Empty,RequiresCarrierApproval=profile?.RequiresCarrierApproval??false,RequiresUnderwritingReview=profile?.RequiresUnderwritingReview??false,RequiresSignedRequest=profile?.RequiresSignedRequest??false,RequiresClientAuthorization=profile?.RequiresClientAuthorization??false,RequiresCertificateReview=profile?.RequiresCertificateReview??false,RequiresBrokerOfRecord=profile?.RequiresBrokerOfRecord??false,RequiresAccountingWork=profile?.RequiresAccountingWork??false,RequiresCommissionWork=profile?.RequiresCommissionWork??false,RequiresDocumentWork=profile?.RequiresDocumentWork??false,RequiresPolicyVersion=profile?.RequiresPolicyVersion??false,SupportsBackdate=profile?.SupportsBackdate??false,SupportsReversal=profile?.SupportsReversal??false,IsHighRisk=profile?.IsHighRisk??false,IsPremiumBearing=profile?.IsPremiumBearing??false,IsCertificateRelated=profile?.IsCertificateRelated??false};
        public UpdatePolicyEndorsementTypeProfileRequest ToProfileRequest(Guid tenantId, byte[] rowVersion) => new(){TenantId=tenantId,CategoryCode=CategoryCode,DefaultOperationCode=DefaultOperationCode,PremiumImpactCode=PremiumImpactCode,BillingImpactCode=BillingImpactCode,CommissionImpactCode=CommissionImpactCode,AuthorityCode=AuthorityCode,ApprovalLevelCode=ApprovalLevelCode,CarrierMethodCode=CarrierMethodCode,DocumentDeliveryCode=DocumentDeliveryCode,RequiresCarrierApproval=RequiresCarrierApproval,RequiresUnderwritingReview=RequiresUnderwritingReview,RequiresSignedRequest=RequiresSignedRequest,RequiresClientAuthorization=RequiresClientAuthorization,RequiresCertificateReview=RequiresCertificateReview,RequiresBrokerOfRecord=RequiresBrokerOfRecord,RequiresAccountingWork=RequiresAccountingWork,RequiresCommissionWork=RequiresCommissionWork,RequiresDocumentWork=RequiresDocumentWork,RequiresPolicyVersion=RequiresPolicyVersion,SupportsBackdate=SupportsBackdate,SupportsReversal=SupportsReversal,IsHighRisk=IsHighRisk,IsPremiumBearing=IsPremiumBearing,IsCertificateRelated=IsCertificateRelated,IsActive=IsActive,SortOrder=SortOrder,RowVersion=rowVersion};
    }
    sealed class ConfigurationFormModel
    {
        public List<PolicyEndorsementTypeLineOfBusinessInput> LinesOfBusiness { get; set; } = [];
        public List<PolicyEndorsementTypeDocumentRequirementInput> DocumentRequirements { get; set; } = [];
        public List<PolicyEndorsementTypeWorkflowRuleInput> WorkflowRules { get; set; } = [];
        public List<PolicyEndorsementTypeCarrierMethodInput> CarrierMethods { get; set; } = [];

        public static ConfigurationFormModel From(PolicyEndorsementTypeCatalogDto? catalog) => catalog is null ? new() : new()
        {
            LinesOfBusiness = catalog.LinesOfBusiness.Select(x => new PolicyEndorsementTypeLineOfBusinessInput { LineOfBusinessCode=x.LineOfBusinessCode,IsDefault=x.IsDefault,IsActive=x.IsActive,SortOrder=x.SortOrder }).ToList(),
            DocumentRequirements = catalog.DocumentRequirements.Select(x => new PolicyEndorsementTypeDocumentRequirementInput { RequirementCode=x.RequirementCode,DocumentGroupCode=x.DocumentGroupCode,DocumentKindCode=x.DocumentKindCode,AcordFormNumber=x.AcordFormNumber,IsRequired=x.IsRequired,AppliesWhenJson=x.AppliesWhenJson,IsActive=x.IsActive,SortOrder=x.SortOrder }).ToList(),
