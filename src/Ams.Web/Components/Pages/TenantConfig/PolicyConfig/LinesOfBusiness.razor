@page "/tenant/policies/lobs"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.Lobs
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Lines of Business — Policy Configuration</PageTitle>

<AppPageHeader Title="Lines of Business"
               Subtitle="Configure policy lines used for submissions, policies, renewals, and reporting"
               Icon="bi-list-check">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Line</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
    </Actions>
</AppPageHeader>

<div class="pc-kpi-strip">
    <div class="pc-kpi-card @(_activeFilter == "" ? "pc-kpi-card--active" : "")" title="Show all lines of business" @onclick='() => SetFilter("")' style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-list-check" aria-hidden="true"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total Lines</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "active" ? "pc-kpi-card--active" : "")" title="Filter active lines" @onclick='() => SetFilter("active")' style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsActive)</div><div class="pc-kpi-label">Active</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "inactive" ? "pc-kpi-card--active" : "")" title="Filter inactive lines" @onclick='() => SetFilter("inactive")' style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-slash-circle" aria-hidden="true"></i></span><div><div class="pc-kpi-value">@_items.Count(x => !x.IsActive)</div><div class="pc-kpi-label">Inactive</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "commercial" ? "pc-kpi-card--active" : "")" title="Filter commercial lines" @onclick='() => SetFilter("commercial")' style="cursor:pointer"><span class="pc-kpi-icon" style="background:#dbeafe"><i class="bi bi-briefcase-fill text-primary" aria-hidden="true"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.Category == "Commercial")</div><div class="pc-kpi-label">Commercial</div></div></div>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div>
}

<AppFilterPanel @bind-SearchValue="_search" OnSearch="OnSearchAsync" SearchPlaceholder="Search line or code…" />

<div class="um-grid-card">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }
    <SfGrid TValue="LineOfBusinessDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
        <GridEvents TValue="LineOfBusinessDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" />
        <GridColumns>
            <GridColumn Field="LobCode" HeaderText="Code" Width="130" />
            <GridColumn Field="LobName" HeaderText="Line of Business" Width="240" />
            <GridColumn Field="Category" HeaderText="Category" Width="150" />
            <GridColumn Field="Description" HeaderText="Description" Width="260" />
            <GridColumn Field="IsActive" HeaderText="Status" Width="100" TextAlign="TextAlign.Center"><Template>@{ var r = (LineOfBusinessDto)context; }<span class="um-badge @(r.IsActive ? "um-badge-success" : "um-badge-neutral")">@(r.IsActive ? "Active" : "Inactive")</span></Template></GridColumn>
            <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Center"><Template>@{ var r = (LineOfBusinessDto)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEdit(r)"><i class="bi bi-pencil"></i></button></Template></GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showForm" Width="540px" IsModal="true" ShowCloseIcon="false">
    <DialogEvents Closed="ResetForm" />
    <DialogContent>
        <div class="um-modal-header"><i class="bi bi-list-check" aria-hidden="true"></i><span>@(_editId.HasValue ? "Edit Line of Business" : "Add Line of Business")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field"><label>LOB Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.LobCode" class="um-input" placeholder="e.g. COMM_AUTO" /><ValidationMessage For="() => _form.LobCode" class="validation-message text-danger" /></div>
                <div class="um-field"><label>LOB Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.LobName" class="um-input" /><ValidationMessage For="() => _form.LobName" class="validation-message text-danger" /></div>
                <div class="um-field"><label>Category <span class="text-danger">*</span></label><SfDropDownList TValue="string" TItem="string" @bind-Value="_form.Category" DataSource="@_categories" Placeholder="Select category" /><ValidationMessage For="() => _form.Category" class="validation-message text-danger" /></div>
                <div class="um-field"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="2" /><ValidationMessage For="() => _form.Description" class="validation-message text-danger" /></div>
                <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label></div>
            </div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button></div>
        </EditForm>
    </DialogContent>
</SfDialog>

<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true"><ToastPosition X="Right" Y="Bottom" /></SfToast>

<style>.validation-message{display:flex;align-items:center;gap:.45rem;margin-top:.55rem;color:#dc3545!important;font-size:.875rem;font-weight:700}.validation-message::before{content:"!";display:inline-flex;align-items:center;justify-content:center;width:1rem;height:1rem;min-width:1rem;flex-shrink:0;border-radius:999px;color:#fff;background:linear-gradient(135deg,#ef4444,#b91c1c);font-size:.7rem;font-weight:800}.um-input.modified.invalid{border-color:#dc3545!important;box-shadow:0 0 0 .18rem rgba(220,53,69,.14)!important}</style>

@code {
    static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    static readonly string[] _categories = ["Commercial", "Personal", "Specialty", "Employee Benefits", "Life & Health"];
    List<LineOfBusinessDto> _items = [];
    List<LineOfBusinessDto> _filtered = [];
    string _activeFilter = "";
    bool _loading, _saving, _showForm;
    string _search = string.Empty;
    string? _loadError;
    Guid? _editId;
    SfToast _toast = default!;
    LobFormModel _form = new();

    protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policy Config", null), new("Lines of Business", null)); await LoadAsync(); }
    async Task LoadAsync() { _loading = true; _loadError = null; try { var r = await Api.SearchLobsAsync(TenantId, _search, pageSize: 200); _items = r?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = ex.Message; } finally { _loading = false; } }
    void SetFilter(string filter) { _activeFilter = filter; ApplyFilter(); }
    void ApplyFilter() => _filtered = _activeFilter switch { "active" => _items.Where(x => x.IsActive).ToList(), "inactive" => _items.Where(x => !x.IsActive).ToList(), "commercial" => _items.Where(x => x.Category == "Commercial").ToList(), _ => [.. _items] };
    Task OnSearchAsync() => LoadAsync();
    void OnRowSelected(RowSelectEventArgs<LineOfBusinessDto> args) => OpenEdit(args.Data);
    void OpenCreate() { _editId = null; _form = new(); _showForm = true; }
    void OpenEdit(LineOfBusinessDto item) { _editId = item.LobId; _form = new() { LobCode = item.LobCode, LobName = item.LobName, Category = item.Category, Description = item.Description, IsActive = item.IsActive }; _showForm = true; }
    async Task SaveAsync() { _saving = true; try { if (_editId.HasValue) await Api.UpdateLobAsync(_editId.Value, new(_form.LobCode, _form.LobName, _form.Category, _form.Description, _form.IsActive)); else await Api.CreateLobAsync(new(TenantId, _form.LobCode, _form.LobName, _form.Category, _form.Description)); _showForm = false; await _toast.ShowAsync(new() { Content = "Saved successfully", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } }
    void ResetForm() { _form = new(); _editId = null; }
    sealed class LobFormModel { [Required, StringLength(50)] public string LobCode { get; set; } = string.Empty; [Required, StringLength(100)] public string LobName { get; set; } = string.Empty; [Required, StringLength(100)] public string Category { get; set; } = string.Empty; [StringLength(500)] public string? Description { get; set; } public bool IsActive { get; set; } = true; }
}
