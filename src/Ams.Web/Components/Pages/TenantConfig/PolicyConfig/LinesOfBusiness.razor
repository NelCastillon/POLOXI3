@page "/tenant/policies/lobs"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.Lobs
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>LOB Command Center - Policy Configuration</PageTitle>

<div class="lob-page">
    <section class="lob-hero">
        <div class="lob-hero__content">
            <div class="lob-hero-left">
                <span class="lob-hero-icon"><i class="bi bi-list-check" aria-hidden="true"></i></span>
                <div class="lob-hero-title">
                    <div class="lob-hero__eyebrow">Enterprise policy configuration</div>
                    <div class="lob-title-row">
                        <h1>LOB Command Center</h1>
                        <div class="lob-hero__meta">
                            <span><i class="bi bi-collection" aria-hidden="true"></i>@_items.Count lines</span>
                            <span><i class="bi bi-check-circle" aria-hidden="true"></i>@_items.Count(x => x.IsActive) active</span>
                            <span><i class="bi bi-briefcase" aria-hidden="true"></i>@_items.Count(x => IsCategory(x, "Commercial")) commercial</span>
                            <span><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>@_items.Count(NeedsReview) need review</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Govern lines of business used across submissions, policy administration, renewal workflows, reporting, segmentation, and servicing operations.</p>
        </div>
        <div class="lob-hero__actions">
            <button type="button" class="lob-btn lob-btn--light" @onclick="RefreshAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "lob-spin" : null)" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="lob-btn lob-btn--primary" @onclick="OpenCreate">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Line
            </button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger lob-alert" style="border-left: 4px solid #dc3545; animation: lob-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="lob-kpi-strip" aria-label="Line of business KPIs">
        @KpiCard("all", "Total Lines", _items.Count.ToString(), "All configured lines of business", "bi-collection", "blue")
        @KpiCard("active", "Active", _items.Count(x => x.IsActive).ToString(), "LOBs available for policy workflows", "bi-check-circle", "green")
        @KpiCard("commercial", "Commercial", _items.Count(x => IsCategory(x, "Commercial")).ToString(), "Commercial policy lines", "bi-briefcase", "purple")
        @KpiCard("personal", "Personal", _items.Count(x => IsCategory(x, "Personal")).ToString(), "Personal policy lines", "bi-house-heart", "cyan")
        @KpiCard("risk", "Needs Review", _items.Count(NeedsReview).ToString(), "Inactive or incomplete LOB definitions", "bi-exclamation-octagon", "amber")
        @KpiCard("inactive", "Inactive", _items.Count(x => !x.IsActive).ToString(), "LOBs hidden from workflow usage", "bi-slash-circle", "red")
    </section>

    <section class="lob-workflows" aria-label="LOB workflows">
        <button type="button" class="lob-workflow" @onclick='() => SetDashboardFocus("all", "importance")'><span class="lob-workflow-icon"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></span><span class="lob-workflow-meta"><strong>Portfolio review</strong><span>Rank LOBs by workflow importance and readiness</span></span></button>
        <button type="button" class="lob-workflow" @onclick='() => SetDashboardFocus("commercial", "importance")'><span class="lob-workflow-icon"><i class="bi bi-briefcase" aria-hidden="true"></i></span><span class="lob-workflow-meta"><strong>Commercial focus</strong><span>Review revenue-critical commercial policy lines</span></span></button>
        <button type="button" class="lob-workflow" @onclick='() => SetDashboardFocus("personal", "importance")'><span class="lob-workflow-icon"><i class="bi bi-house-heart" aria-hidden="true"></i></span><span class="lob-workflow-meta"><strong>Personal lines</strong><span>Validate personal and household policy coverage</span></span></button>
        <button type="button" class="lob-workflow" @onclick='() => SetDashboardFocus("risk", "importance")'><span class="lob-workflow-icon"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></span><span class="lob-workflow-meta"><strong>Cleanup queue</strong><span>Find inactive or incomplete LOB definitions</span></span></button>
        <button type="button" class="lob-workflow" @onclick='() => SetDashboardFocus("categories", "category")'><span class="lob-workflow-icon"><i class="bi bi-pie-chart" aria-hidden="true"></i></span><span class="lob-workflow-meta"><strong>Category mix</strong><span>Compare commercial, personal, specialty, benefits, and health coverage</span></span></button>
    </section>

    <section class="lob-filter-panel" aria-label="LOB filters">
        <div class="lob-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" placeholder="Search LOB code, name, category, or description..." aria-label="Search lines of business" value="@_searchTerm" @oninput="args => OnSearchInputValue(args.Value?.ToString())" />
        </div>
        <div class="lob-filter-grid">
            <label>
                <span>Category</span>
                <select class="form-select" @bind="_categoryFilter" @bind:after="ApplyFilters">
                    <option value="">All categories</option>
                    @foreach (var category in _categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </label>
            <label>
                <span>Status</span>
                <select class="form-select" @bind="_statusFilter" @bind:after="ApplyFilters">
                    <option value="">All statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="NeedsReview">Needs review</option>
                </select>
            </label>
            <label>
                <span>Sort</span>
                <select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters">
                    <option value="importance">Importance</option>
                    <option value="name">Name</option>
                    <option value="code">Code</option>
                    <option value="category">Category</option>
                    <option value="created">Newest</option>
                </select>
            </label>
        </div>
        <button type="button" class="lob-btn lob-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
    </section>

    <nav class="lob-tabs" aria-label="LOB views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="lob-tab @(_activeTab == tab.Key ? "lob-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </nav>

    <main class="lob-dashboard">
        <section class="lob-main-card">
            <div class="lob-card-header">
                <div>
                    <span class="lob-section-kicker">@ActiveViewTitle</span>
                    <h2>@FilteredLobs.Count() lines of business</h2>
                    <p>Prioritized by enterprise importance: active workflow use, category impact, configuration completeness, and reporting readiness.</p>
                </div>
                <div class="lob-card-actions">
                    @if (_selectedIds.Count > 0)
                    {
                        <span class="lob-sel-count">@_selectedIds.Count selected</span>
                        <button type="button" class="lob-btn lob-btn--ghost" @onclick="() => ConfirmBulkToggle(true)"><i class="bi bi-check-circle" aria-hidden="true"></i> Activate</button>
                        <button type="button" class="lob-btn lob-btn--danger-ghost" @onclick="() => ConfirmBulkToggle(false)"><i class="bi bi-archive" aria-hidden="true"></i> Archive</button>
                    }
                    <button type="button" class="lob-btn lob-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="lob-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="lob-btn lob-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="lob-loading"><span class="lob-spinner"></span> Loading lines of business...</div>
            }
            else if (!FilteredLobs.Any())
            {
                <div class="lob-empty"><i class="bi bi-list-check" aria-hidden="true"></i><strong>No lines of business found</strong><span>Adjust the active KPI, tab, search, or filters.</span></div>
            }
            else if (_activeTab == "categories")
            {
                <div class="lob-group-grid">
                    @foreach (var group in CategoryGroups)
                    {
                        <article class="lob-group-card">
                            <div class="lob-group-icon"><i class="bi @CategoryIcon(group.Name)" aria-hidden="true"></i></div>
                            <div class="lob-group-meta">
                                <h3>@group.Name</h3>
                                <p>@group.Count lines - @group.Active active - @group.ReviewCount need review</p>
                                <div class="lob-mini-bar"><span style="width:@group.Percent%"></span></div>
                            </div>
                            <button type="button" class="lob-btn lob-btn--ghost" @onclick="() => FilterByCategory(group.Name)">Open</button>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="lob-table-wrap">
                    <table class="lob-table">
                        <thead>
                            <tr>
                                <th class="lob-check-col"><input type="checkbox" checked="@AllPageSelected" @onchange="args => ToggleSelectAllPage(args.Value is bool value && value)" aria-label="Select all LOBs on page" /></th>
                                <th>Importance</th>
                                <th>Line of Business</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Readiness</th>
                                <th>Created</th>
                                <th class="lob-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lob in PagedLobs)
                            {
                                <tr class="@(_selected?.LobId == lob.LobId ? "lob-row lob-row--selected" : "lob-row")" @onclick="() => SelectRow(lob)">
                                    <td class="lob-check-col" @onclick:stopPropagation="true"><input type="checkbox" checked="@IsSelected(lob)" @onchange="args => ToggleSelect(lob, args.Value is bool value && value)" aria-label="Select line of business" /></td>
                                    <td>@ImportanceBadge(lob)</td>
                                    <td>
                                        <div class="lob-line-cell">
                                            <div class="lob-avatar" style="@AvatarStyle(lob.LobName)" aria-hidden="true">@Initials(lob.LobName)</div>
                                            <div class="lob-line-meta">
                                                <button type="button" class="lob-link-button" @onclick:stopPropagation="true" @onclick="() => OpenEdit(lob)">@lob.LobName</button>
                                                <small>@Safe(lob.LobCode, "No code")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="lob-pill @CategoryBadgeClass(lob.Category)"><i class="bi @CategoryIcon(lob.Category)" aria-hidden="true"></i>@lob.Category</span></td>
                                    <td><span class="lob-pill @(lob.IsActive ? "lob-pill--green" : "lob-pill--neutral")">@(lob.IsActive ? "Active" : "Inactive")</span></td>
                                    <td><span class="lob-pill @(NeedsReview(lob) ? "lob-pill--amber" : "lob-pill--green")">@(NeedsReview(lob) ? "Review" : "Ready")</span></td>
                                    <td><span class="lob-date">@FormatDate(lob.CreatedDateUtc)</span></td>
                                    <td class="lob-actions-col" @onclick:stopPropagation="true">
                                        <button type="button" class="lob-icon-btn" title="Edit LOB" @onclick="() => OpenEdit(lob)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                        <button type="button" class="lob-icon-btn @(lob.IsActive ? "lob-icon-btn--danger" : null)" title="@(lob.IsActive ? "Archive LOB" : "Activate LOB")" @onclick="() => ConfirmToggle(lob)"><i class="bi @(lob.IsActive ? "bi-archive" : "bi-check-circle")" aria-hidden="true"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="lob-side-panel" aria-label="LOB insights">
            <section class="lob-panel-card">
                <span class="lob-section-kicker">Selected line</span>
                @if (_selected is null)
                {
                    <div class="lob-empty lob-empty--compact"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a line of business</strong><span>Open details, recommendations, and quick actions.</span></div>
                }
                else
                {
                    <div class="lob-selected__title">
                        <div class="lob-avatar lob-avatar--lg" style="@AvatarStyle(_selected.LobName)" aria-hidden="true">@Initials(_selected.LobName)</div>
                        <div><h3>@_selected.LobName</h3><span>@Safe(_selected.LobCode, "No code") - @_selected.Category</span></div>
                    </div>
                    <div class="lob-score-card @ImportanceClass(_selected)"><span>Importance score</span><strong>@ImportanceScore(_selected)</strong><small>@RecommendedAction(_selected)</small></div>
                    <dl class="lob-detail-list">
                        <div><dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd></div>
                        <div><dt>Category</dt><dd>@_selected.Category</dd></div>
                        <div><dt>Code</dt><dd>@_selected.LobCode</dd></div>
                        <div><dt>Created</dt><dd>@FormatDate(_selected.CreatedDateUtc)</dd></div>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_selected.Description))
                    {
                        <p class="lob-description">@_selected.Description</p>
                    }
                    <div class="lob-selected-actions">
                        <button type="button" class="lob-btn lob-btn--primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                        <button type="button" class="lob-btn lob-btn--ghost" @onclick="() => ConfirmToggle(_selected)"><i class="bi @(_selected.IsActive ? "bi-archive" : "bi-check-circle")" aria-hidden="true"></i> @(_selected.IsActive ? "Archive" : "Activate")</button>
                    </div>
                }
            </section>

            <section class="lob-panel-card">
                <span class="lob-section-kicker">Enterprise insights</span>
                <div class="lob-insight-list">
                    <div class="lob-insight"><i class="bi bi-briefcase" aria-hidden="true"></i><div><strong>Commercial footprint</strong><span>@CommercialInsight</span></div></div>
                    <div class="lob-insight"><i class="bi bi-pie-chart" aria-hidden="true"></i><div><strong>Category coverage</strong><span>@CategoryInsight</span></div></div>
                    <div class="lob-insight"><i class="bi bi-shield-check" aria-hidden="true"></i><div><strong>Workflow readiness</strong><span>@ReadinessInsight</span></div></div>
                </div>
            </section>
        </aside>
    </main>
</div>

@if (_showForm)
{
    <div class="lob-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="lob-form-title">
        <div class="lob-modal">
            <div class="lob-modal__header"><i class="bi bi-list-check" aria-hidden="true"></i><span id="lob-form-title">@(_editId.HasValue ? "Edit Line of Business" : "Add Line of Business")</span><button type="button" class="lob-icon-btn lob-icon-btn--light ms-auto" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="lob-modal__body">
                    
                    <div class="lob-form-grid">
                        <label class="lob-field"><span>LOB Code <em>*</em></span><InputText @bind-Value="_form.LobCode" class="form-control" placeholder="e.g. COMM_AUTO" /></label>
                        <label class="lob-field"><span>LOB Name <em>*</em></span><InputText @bind-Value="_form.LobName" class="form-control" placeholder="Commercial Auto" /></label>
                        <label class="lob-field"><span>Category <em>*</em></span><InputSelect @bind-Value="_form.Category" class="form-select"><option value="">Select category</option>@foreach (var category in _categories) { <option value="@category">@category</option> }</InputSelect></label>
                        <label class="lob-field lob-field--wide"><span>Description</span><InputTextArea @bind-Value="_form.Description" class="form-control" rows="3" placeholder="Describe policy usage, intake context, or reporting guidance." /></label>
                        @if (_editId.HasValue)
                        {
                            <label class="lob-check-field"><InputCheckbox @bind-Value="_form.IsActive" /><span>Active</span></label>
                        }
                    </div>
                </div>
                <div class="lob-modal__footer"><button type="button" class="lob-btn lob-btn--ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="lob-btn lob-btn--primary" disabled="@_saving">@if (_saving) { <span class="lob-spin-sm"></span> } @(_editId.HasValue ? "Save Changes" : "Create Line")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_confirmVisible)
{
    <div class="lob-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="lob-confirm-title">
        <div class="lob-confirm">
            <div class="lob-confirm__body"><div class="lob-confirm-icon lob-confirm-icon--danger"><i class="bi @_confirmIcon" aria-hidden="true"></i></div><div><h3 id="lob-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div></div>
            <div class="lob-modal__footer"><button type="button" class="lob-btn lob-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button><button type="button" class="lob-btn lob-btn--danger" @onclick="ExecuteConfirmedAsync" disabled="@_saving">@if (_saving) { <span class="lob-spin-sm"></span> } Confirm</button></div>
        </div>
    </div>
}

<div class="lob-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="lob-toast lob-toast--@toast.Kind"><i class="bi @(toast.Kind == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    }
</div>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    Guid TenantId { get; set; }

    static readonly string[] _categories = ["Commercial", "Personal", "Specialty", "Employee Benefits", "Life & Health"];
    readonly List<DashboardTab> _tabs = [new("all", "All", "bi-collection"), new("active", "Active", "bi-check-circle"), new("commercial", "Commercial", "bi-briefcase"), new("personal", "Personal", "bi-house-heart"), new("specialty", "Specialty", "bi-gem"), new("risk", "Needs Review", "bi-exclamation-octagon"), new("inactive", "Inactive", "bi-slash-circle"), new("categories", "Categories", "bi-pie-chart")];

    List<LineOfBusinessDto> _items = [];
    HashSet<Guid> _selectedIds = [];
    List<ToastItem> _toasts = [];
    LineOfBusinessDto? _selected;
    LobFormModel _form = new();
    Func<Task>? _confirmAction;
    Guid? _editId;
    string _activeTab = "all";
    string _searchTerm = string.Empty;
    string _categoryFilter = string.Empty;
    string _statusFilter = string.Empty;
    string _sortMode = "importance";
    string _confirmTitle = string.Empty;
    string _confirmMessage = string.Empty;
    string _confirmIcon = "bi-exclamation-triangle-fill";
    string? _loadError;
    bool _loading;
    bool _saving;
    bool _showForm;
    bool _confirmVisible;
    int _page = 1;
    const int PageSize = 12;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policy Config", null), new("Lines of Business", null));
        await LoadAsync();
    }

    IEnumerable<LineOfBusinessDto> FilteredLobs
    {
        get
        {
            IEnumerable<LineOfBusinessDto> query = _items;
            query = _activeTab switch
            {
                "active" => query.Where(x => x.IsActive),
                "commercial" => query.Where(x => IsCategory(x, "Commercial")),
                "personal" => query.Where(x => IsCategory(x, "Personal")),
                "specialty" => query.Where(x => IsCategory(x, "Specialty")),
                "risk" => query.Where(NeedsReview),
                "inactive" => query.Where(x => !x.IsActive),
                _ => query
            };

            if (!string.IsNullOrWhiteSpace(_searchTerm)) query = query.Where(MatchesSearch);
            if (!string.IsNullOrWhiteSpace(_categoryFilter)) query = query.Where(x => string.Equals(x.Category, _categoryFilter, StringComparison.OrdinalIgnoreCase));
            query = _statusFilter switch { "Active" => query.Where(x => x.IsActive), "Inactive" => query.Where(x => !x.IsActive), "NeedsReview" => query.Where(NeedsReview), _ => query };

            return _sortMode switch
            {
                "name" => query.OrderBy(x => x.LobName),
                "code" => query.OrderBy(x => x.LobCode),
                "category" => query.OrderBy(x => x.Category).ThenBy(x => x.LobName),
                "created" => query.OrderByDescending(x => x.CreatedDateUtc),
                _ => query.OrderByDescending(ImportanceScore).ThenBy(x => x.Category).ThenBy(x => x.LobName)
            };
        }
    }

    List<LineOfBusinessDto> PagedLobs => FilteredLobs.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredLobs.Count() / (double)PageSize));
    bool AllPageSelected => PagedLobs.Count > 0 && PagedLobs.All(IsSelected);
    bool HasFilters => !string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_categoryFilter) || !string.IsNullOrWhiteSpace(_statusFilter) || _activeTab != "all" || _sortMode != "importance";
    string ActiveViewTitle => _tabs.FirstOrDefault(x => x.Key == _activeTab)?.Label ?? "All";
    string CommercialInsight => _items.Any(x => IsCategory(x, "Commercial")) ? $"{_items.Count(x => IsCategory(x, "Commercial"))} commercial LOBs support submission and policy workflows." : "No commercial LOBs are configured.";
    string CategoryInsight => _items.Count == 0 ? "Create LOBs to define policy portfolio coverage." : $"{CategoryGroups.Count} categories are represented across the policy portfolio.";
    string ReadinessInsight => _items.Count == 0 ? "Create LOBs before enabling policy workflows." : $"{Math.Round(_items.Count(x => x.IsActive && !NeedsReview(x)) * 100m / _items.Count)}% of LOBs are active with no review flags.";
    List<CategoryGroupSummary> CategoryGroups => _items.GroupBy(x => Safe(x.Category, "Unassigned")).Select(g => new CategoryGroupSummary(g.Key, g.Count(), g.Count(x => x.IsActive), g.Count(NeedsReview), _items.Count == 0 ? 0 : Math.Round(g.Count() * 100m / _items.Count, 0))).OrderByDescending(x => x.Count).ToList();

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchLobsAsync(TenantId, null, pageSize: 500);
            _items = result?.Items.ToList() ?? [];
            _selectedIds.RemoveWhere(id => _items.All(x => x.LobId != id));
            _selected = _selected is null ? _items.OrderByDescending(ImportanceScore).FirstOrDefault() : _items.FirstOrDefault(x => x.LobId == _selected.LobId) ?? _items.OrderByDescending(ImportanceScore).FirstOrDefault();
            NormalizePage();
        }
        catch (Exception ex) { _loadError = $"Failed to load lines of business: {ex.Message}"; }
        finally { _loading = false; }
    }

    Task RefreshAsync() => LoadAsync();
    void ApplyFilters() { _page = 1; NormalizePage(); }
    void OnSearchInputValue(string? value) { _searchTerm = value ?? string.Empty; ApplyFilters(); }
    void SetDashboardFocus(string tab, string sort) { _activeTab = tab; _sortMode = sort; _page = 1; NormalizePage(); }
    void SetActiveTab(string tab) { _activeTab = tab; _page = 1; NormalizePage(); }
    void PreviousPage() { if (_page > 1) _page--; }
    void NextPage() { if (_page < TotalPages) _page++; }
    void NormalizePage() { if (_page > TotalPages) _page = TotalPages; }
    void SelectRow(LineOfBusinessDto item) => _selected = item;
    bool IsSelected(LineOfBusinessDto item) => _selectedIds.Contains(item.LobId);
    void ToggleSelect(LineOfBusinessDto item, bool selected) { if (selected) _selectedIds.Add(item.LobId); else _selectedIds.Remove(item.LobId); _selected = item; }
    void ToggleSelectAllPage(bool selected) { foreach (var item in PagedLobs) { if (selected) _selectedIds.Add(item.LobId); else _selectedIds.Remove(item.LobId); } }
    void ClearFilters() { _searchTerm = string.Empty; _categoryFilter = string.Empty; _statusFilter = string.Empty; _sortMode = "importance"; _activeTab = "all"; _page = 1; }
    void FilterByCategory(string category) { _activeTab = "all"; _categoryFilter = category; _sortMode = "importance"; _page = 1; }

    void OpenCreate() { _editId = null; _form = new() { Category = "Commercial", IsActive = true }; _showForm = true; }
    void OpenEdit(LineOfBusinessDto item) { _selected = item; _editId = item.LobId; _form = new() { LobCode = item.LobCode, LobName = item.LobName, Category = item.Category, Description = item.Description, IsActive = item.IsActive }; _showForm = true; }
    void CloseForm() { _showForm = false; ResetForm(); }
    void ResetForm() { _form = new(); _editId = null; }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue) await Api.UpdateLobAsync(_editId.Value, new(_form.LobCode.Trim(), _form.LobName.Trim(), _form.Category.Trim(), NormalizeNullable(_form.Description), _form.IsActive));
            else await Api.CreateLobAsync(new(TenantId, _form.LobCode.Trim(), _form.LobName.Trim(), _form.Category.Trim(), NormalizeNullable(_form.Description)));
            _showForm = false;
            ShowToast("success", _editId.HasValue ? "Line of business updated successfully." : "Line of business created successfully.");
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast("danger", $"Save failed: {ex.Message}"); }
        finally { _saving = false; }
    }

    void ConfirmToggle(LineOfBusinessDto item)
    {
        var enable = !item.IsActive;
        OpenConfirm(enable ? "Activate Line of Business" : "Archive Line of Business", $"Are you sure you want to {(enable ? "activate" : "archive")} {item.LobName}? This changes availability in policy workflows.", enable ? "bi-check-circle" : "bi-archive-fill", () => SetLobActiveAsync(item, enable));
    }

    void ConfirmBulkToggle(bool enable) => OpenConfirm(enable ? "Activate Selected Lines" : "Archive Selected Lines", $"Are you sure you want to {(enable ? "activate" : "archive")} {_selectedIds.Count} selected line(s) of business?", enable ? "bi-check-circle" : "bi-archive-fill", () => BulkSetActiveAsync(enable));

    void OpenConfirm(string title, string message, string icon, Func<Task> action) { _confirmTitle = title; _confirmMessage = message; _confirmIcon = icon; _confirmAction = action; _confirmVisible = true; }
    void CloseConfirm() { _confirmVisible = false; _confirmAction = null; }
    async Task ExecuteConfirmedAsync() { if (_confirmAction is null) return; _saving = true; try { await _confirmAction(); _confirmVisible = false; _confirmAction = null; } finally { _saving = false; } }

    async Task SetLobActiveAsync(LineOfBusinessDto item, bool active)
    {
        try
        {
            await Api.UpdateLobAsync(item.LobId, new(item.LobCode, item.LobName, item.Category, item.Description, active));
            ShowToast("success", active ? "Line of business activated." : "Line of business archived.");
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast("danger", $"Update failed: {ex.Message}"); }
    }

    async Task BulkSetActiveAsync(bool active)
    {
        var selected = _items.Where(x => _selectedIds.Contains(x.LobId)).ToList();
        var updated = 0;
        foreach (var item in selected)
        {
            try { await Api.UpdateLobAsync(item.LobId, new(item.LobCode, item.LobName, item.Category, item.Description, active)); updated++; }
            catch (Exception ex) { ShowToast("danger", $"Update failed for {item.LobName}: {ex.Message}"); }
        }
        ShowToast("success", $"{updated} line(s) of business {(active ? "activated" : "archived")}.");
        _selectedIds.Clear();
        await LoadAsync();
    }

    RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string color) => @<button type="button" class="lob-kpi-card lob-kpi-card--@color @(_activeTab == key ? "lob-kpi-card--active" : null)" title="@subtitle" @onclick="() => SetActiveTab(key)"><span class="lob-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span><span class="lob-kpi-body"><span class="lob-kpi-label">@label</span><strong class="lob-kpi-value">@value</strong><span class="lob-kpi-sub">@subtitle</span></span></button>;

    int TabCount(string key) => key switch { "active" => _items.Count(x => x.IsActive), "commercial" => _items.Count(x => IsCategory(x, "Commercial")), "personal" => _items.Count(x => IsCategory(x, "Personal")), "specialty" => _items.Count(x => IsCategory(x, "Specialty")), "risk" => _items.Count(NeedsReview), "inactive" => _items.Count(x => !x.IsActive), "categories" => CategoryGroups.Count, _ => _items.Count };
    bool MatchesSearch(LineOfBusinessDto item) { var term = _searchTerm.Trim(); return Contains(item.LobCode, term) || Contains(item.LobName, term) || Contains(item.Category, term) || Contains(item.Description, term); }
    static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    static bool IsCategory(LineOfBusinessDto item, string category) => string.Equals(item.Category, category, StringComparison.OrdinalIgnoreCase);
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string? NormalizeNullable(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    static string FormatDate(DateTime date) => date == default ? "-" : date.ToLocalTime().ToString("MMM d, yyyy");
    static bool NeedsReview(LineOfBusinessDto item) => !item.IsActive || string.IsNullOrWhiteSpace(item.LobCode) || string.IsNullOrWhiteSpace(item.LobName) || string.IsNullOrWhiteSpace(item.Category) || string.IsNullOrWhiteSpace(item.Description);
    static string CategoryIcon(string? category) => category switch { "Commercial" => "bi-briefcase", "Personal" => "bi-house-heart", "Specialty" => "bi-gem", "Employee Benefits" => "bi-people", "Life & Health" => "bi-heart-pulse", _ => "bi-tags" };
    static string CategoryBadgeClass(string? category) => category switch { "Commercial" => "lob-pill--purple", "Personal" => "lob-pill--cyan", "Specialty" => "lob-pill--amber", "Employee Benefits" => "lob-pill--blue", "Life & Health" => "lob-pill--green", _ => "lob-pill--neutral" };

    static int ImportanceScore(LineOfBusinessDto item)
    {
        var score = 35;
        if (item.IsActive) score += 18; else score += 18;
        if (IsCategory(item, "Commercial")) score += 18;
        if (IsCategory(item, "Employee Benefits") || IsCategory(item, "Life & Health")) score += 10;
        if (!string.IsNullOrWhiteSpace(item.Description)) score += 8; else score += 12;
        if (string.IsNullOrWhiteSpace(item.LobCode) || string.IsNullOrWhiteSpace(item.Category)) score += 12;
        return Math.Clamp(score, 0, 100);
    }

    static string RecommendedAction(LineOfBusinessDto item)
    {
        if (!item.IsActive) return "Review whether this LOB should remain archived or be reactivated.";
        if (string.IsNullOrWhiteSpace(item.Description)) return "Add workflow guidance for submissions, renewals, and reporting.";
        if (string.IsNullOrWhiteSpace(item.LobCode)) return "Add a stable code for downstream policy integrations.";
        return "Configuration is ready for policy workflows.";
    }

    static string ImportanceClass(LineOfBusinessDto item) => ImportanceScore(item) switch { >= 80 => "lob-score-card--red", >= 65 => "lob-score-card--amber", >= 45 => "lob-score-card--cyan", _ => "lob-score-card--green" };
    static MarkupString ImportanceBadge(LineOfBusinessDto item) { var score = ImportanceScore(item); var css = score switch { >= 80 => "red", >= 65 => "amber", >= 45 => "cyan", _ => "green" }; return new($"<span class=\"lob-risk-badge lob-risk-badge--{css}\">{score}</span>"); }
    static string Initials(string? value) { var parts = (value ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); return parts.Length switch { 0 => "LB", 1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(), _ => string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0]))) }; }
    static string AvatarStyle(string? value) { var hash = Math.Abs((value ?? "LineOfBusiness").GetHashCode()); var hue = hash % 360; return $"background:linear-gradient(135deg,hsl({hue},78%,48%),hsl({(hue + 35) % 360},82%,36%));"; }
    void ShowToast(string kind, string message) { _toasts.Insert(0, new(Guid.NewGuid(), kind, message)); if (_toasts.Count > 4) _toasts.RemoveRange(4, _toasts.Count - 4); }
    void DismissToast(Guid id) => _toasts.RemoveAll(x => x.Id == id);

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }

    sealed class LobFormModel
    {
        [Required, StringLength(50)] public string LobCode { get; set; } = string.Empty;
        [Required, StringLength(100)] public string LobName { get; set; } = string.Empty;
        [Required, StringLength(100)] public string Category { get; set; } = string.Empty;
        [StringLength(500)] public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }

    sealed record DashboardTab(string Key, string Label, string Icon);
    sealed record CategoryGroupSummary(string Name, int Count, int Active, int ReviewCount, decimal Percent);
    sealed record ToastItem(Guid Id, string Kind, string Message);
}
