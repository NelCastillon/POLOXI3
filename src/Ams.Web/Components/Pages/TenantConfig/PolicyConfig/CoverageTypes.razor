@page "/tenant/policies/coverage"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.PolicyConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Coverage Command Center — Policy Configuration</PageTitle>

<div class="cov-page">
    <section class="cov-hero">
        <div class="cov-hero__content">
            <div class="cov-hero-left">
                <span class="cov-hero-icon"><i class="bi bi-umbrella" aria-hidden="true"></i></span>
                <div class="cov-hero-title">
                    <div class="cov-hero__eyebrow">Enterprise coverage configuration</div>
                    <div class="cov-title-row">
                        <h1>Coverage Command Center</h1>
                        <div class="cov-hero__meta">
                            <span><i class="bi bi-shield-check" aria-hidden="true"></i>@_items.Count types</span>
                            <span><i class="bi bi-check-circle" aria-hidden="true"></i>@_items.Count(x => x.IsActive) active</span>
                            <span><i class="bi bi-diagram-3" aria-hidden="true"></i>@_items.Count(x => !string.IsNullOrWhiteSpace(x.LobCode)) mapped</span>
                            <span><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>@_items.Count(NeedsReview) need review</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Govern policy coverage definitions by LOB mapping, operational importance, workflow readiness, sort priority, and reporting completeness.</p>
        </div>
        <div class="cov-hero__actions">
            <button type="button" class="cov-btn cov-btn--light" @onclick="RefreshAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "cov-spin" : null)" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="cov-btn cov-btn--primary" @onclick="OpenCreate">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Coverage
            </button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger cov-alert" style="border-left: 4px solid #dc3545; animation: cov-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="cov-kpi-strip" aria-label="Coverage type KPIs">
        @KpiCard("all", "Total Types", _items.Count.ToString(), "All configured policy coverage types", "bi-shield-check", "blue")
        @KpiCard("active", "Active", _items.Count(x => x.IsActive).ToString(), "Coverage types available for policy workflows", "bi-check-circle", "green")
        @KpiCard("mapped", "LOB Mapped", _items.Count(x => !string.IsNullOrWhiteSpace(x.LobCode)).ToString(), "Coverage types mapped to a line of business", "bi-diagram-3", "purple")
        @KpiCard("unmapped", "Unmapped", _items.Count(x => string.IsNullOrWhiteSpace(x.LobCode)).ToString(), "Coverage types needing LOB mapping", "bi-question-circle", "amber")
        @KpiCard("priority", "Priority", _items.Count(IsPriorityCoverage).ToString(), "High-impact liability, property, auto, umbrella, and workers coverage", "bi-lightning-charge", "cyan")
        @KpiCard("inactive", "Inactive", _items.Count(x => !x.IsActive).ToString(), "Coverage types hidden from workflow usage", "bi-slash-circle", "red")
    </section>

    <section class="cov-workflows" aria-label="Coverage workflows">
        <button type="button" class="cov-workflow" @onclick='() => SetDashboardFocus("all", "importance")'><span class="cov-workflow-icon"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></span><span class="cov-workflow-meta"><strong>Coverage review</strong><span>Rank coverage by workflow importance and readiness</span></span></button>
        <button type="button" class="cov-workflow" @onclick='() => SetDashboardFocus("mapped", "importance")'><span class="cov-workflow-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span><span class="cov-workflow-meta"><strong>LOB mapping</strong><span>Validate coverage-to-line-of-business relationships</span></span></button>
        <button type="button" class="cov-workflow" @onclick='() => SetDashboardFocus("priority", "importance")'><span class="cov-workflow-icon"><i class="bi bi-lightning-charge" aria-hidden="true"></i></span><span class="cov-workflow-meta"><strong>Priority coverage</strong><span>Focus on liability, property, auto, umbrella, and WC coverage</span></span></button>
        <button type="button" class="cov-workflow" @onclick='() => SetDashboardFocus("risk", "importance")'><span class="cov-workflow-icon"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></span><span class="cov-workflow-meta"><strong>Cleanup queue</strong><span>Find inactive, unmapped, or incomplete coverage definitions</span></span></button>
        <button type="button" class="cov-workflow" @onclick='() => SetDashboardFocus("lobs", "lob")'><span class="cov-workflow-icon"><i class="bi bi-pie-chart" aria-hidden="true"></i></span><span class="cov-workflow-meta"><strong>LOB coverage</strong><span>Compare coverage availability across line mappings</span></span></button>
    </section>

    <section class="cov-filter-panel" aria-label="Coverage filters">
        <div class="cov-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" placeholder="Search coverage code, name, LOB code, or description…" aria-label="Search coverage types" value="@_searchTerm" @oninput="args => OnSearchInputValue(args.Value?.ToString())" />
        </div>
        <div class="cov-filter-grid">
            <label>
                <span>LOB Code</span>
                <select class="form-select" @bind="_lobFilter" @bind:after="ApplyFilters">
                    <option value="">All LOBs</option>
                    @foreach (var lob in LobOptions)
                    {
                        <option value="@lob">@lob</option>
                    }
                </select>
            </label>
            <label>
                <span>Status</span>
                <select class="form-select" @bind="_statusFilter" @bind:after="ApplyFilters">
                    <option value="">All statuses</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Mapped">Mapped</option>
                    <option value="Unmapped">Unmapped</option>
                    <option value="NeedsReview">Needs review</option>
                </select>
            </label>
            <label>
                <span>Sort</span>
                <select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters">
                    <option value="importance">Importance</option>
                    <option value="order">Sort order</option>
                    <option value="name">Name</option>
                    <option value="code">Code</option>
                    <option value="lob">LOB code</option>
                    <option value="created">Newest</option>
                </select>
            </label>
        </div>
        <button type="button" class="cov-btn cov-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
    </section>

    <nav class="cov-tabs" aria-label="Coverage views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="cov-tab @(_activeTab == tab.Key ? "cov-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </nav>

    <main class="cov-dashboard">
        <section class="cov-main-card">
            <div class="cov-card-header">
                <div>
                    <span class="cov-section-kicker">@ActiveViewTitle</span>
                    <h2>@FilteredCoverages.Count() coverage types</h2>
                    <p>Prioritized by enterprise importance: active workflow use, LOB mapping, critical coverage keywords, sort precedence, and completeness.</p>
                </div>
                <div class="cov-card-actions">
                    @if (_selectedIds.Count > 0)
                    {
                        <span class="cov-sel-count">@_selectedIds.Count selected</span>
                        <button type="button" class="cov-btn cov-btn--ghost" @onclick="() => ConfirmBulkToggle(true)"><i class="bi bi-check-circle" aria-hidden="true"></i> Activate</button>
                        <button type="button" class="cov-btn cov-btn--danger-ghost" @onclick="() => ConfirmBulkToggle(false)"><i class="bi bi-archive" aria-hidden="true"></i> Archive</button>
                    }
                    <button type="button" class="cov-btn cov-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="cov-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="cov-btn cov-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="cov-loading"><span class="cov-spinner"></span> Loading coverage types…</div>
            }
            else if (!FilteredCoverages.Any())
            {
                <div class="cov-empty"><i class="bi bi-umbrella" aria-hidden="true"></i><strong>No coverage types found</strong><span>Adjust the active KPI, tab, search, or filters.</span></div>
            }
            else if (_activeTab == "lobs")
            {
                <div class="cov-group-grid">
                    @foreach (var group in LobGroups)
                    {
                        <article class="cov-group-card">
                            <div class="cov-group-icon"><i class="bi @LobIcon(group.Name)" aria-hidden="true"></i></div>
                            <div class="cov-group-meta">
                                <h3>@group.Name</h3>
                                <p>@group.Count types • @group.Active active • @group.Priority priority • @group.ReviewCount need review</p>
                                <div class="cov-mini-bar"><span style="width:@group.Percent%"></span></div>
                            </div>
                            <button type="button" class="cov-btn cov-btn--ghost" @onclick="() => FilterByLob(group.Name)">Open</button>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="cov-table-wrap">
                    <table class="cov-table">
                        <thead>
                            <tr>
                                <th class="cov-check-col"><input type="checkbox" checked="@AllPageSelected" @onchange="args => ToggleSelectAllPage(args.Value is bool value && value)" aria-label="Select all coverage types on page" /></th>
                                <th>Importance</th>
                                <th>Coverage Type</th>
                                <th>LOB</th>
                                <th>Status</th>
                                <th>Readiness</th>
                                <th>Order</th>
                                <th>Created</th>
                                <th class="cov-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var coverage in PagedCoverages)
                            {
                                <tr class="@(_selected?.CoverageTypeId == coverage.CoverageTypeId ? "cov-row cov-row--selected" : "cov-row")" @onclick="() => SelectRow(coverage)">
                                    <td class="cov-check-col" @onclick:stopPropagation="true"><input type="checkbox" checked="@IsSelected(coverage)" @onchange="args => ToggleSelect(coverage, args.Value is bool value && value)" aria-label="Select coverage type" /></td>
                                    <td>@ImportanceBadge(coverage)</td>
                                    <td>
                                        <div class="cov-line-cell">
                                            <div class="cov-avatar" style="@AvatarStyle(coverage.CoverageName)" aria-hidden="true">@Initials(coverage.CoverageName)</div>
                                            <div class="cov-line-meta">
                                                <button type="button" class="cov-link-button" @onclick:stopPropagation="true" @onclick="() => OpenEdit(coverage)">@coverage.CoverageName</button>
                                                <small>@Safe(coverage.CoverageCode, "No code")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="cov-pill @(string.IsNullOrWhiteSpace(coverage.LobCode) ? "cov-pill--amber" : "cov-pill--purple")"><i class="bi @(string.IsNullOrWhiteSpace(coverage.LobCode) ? "bi-question-circle" : "bi-diagram-3")" aria-hidden="true"></i>@Safe(coverage.LobCode, "Unmapped")</span></td>
                                    <td><span class="cov-pill @(coverage.IsActive ? "cov-pill--green" : "cov-pill--neutral")">@(coverage.IsActive ? "Active" : "Inactive")</span></td>
                                    <td><span class="cov-pill @(NeedsReview(coverage) ? "cov-pill--amber" : "cov-pill--green")">@(NeedsReview(coverage) ? "Review" : "Ready")</span></td>
                                    <td><span class="cov-date">@coverage.SortOrder</span></td>
                                    <td><span class="cov-date">@FormatDate(coverage.CreatedDateUtc)</span></td>
                                    <td class="cov-actions-col" @onclick:stopPropagation="true">
                                        <button type="button" class="cov-icon-btn" title="Edit coverage type" @onclick="() => OpenEdit(coverage)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                        <button type="button" class="cov-icon-btn @(coverage.IsActive ? "cov-icon-btn--danger" : null)" title="@(coverage.IsActive ? "Archive coverage type" : "Activate coverage type")" @onclick="() => ConfirmToggle(coverage)"><i class="bi @(coverage.IsActive ? "bi-archive" : "bi-check-circle")" aria-hidden="true"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="cov-side-panel" aria-label="Coverage insights">
            <section class="cov-panel-card">
                <span class="cov-section-kicker">Selected coverage</span>
                @if (_selected is null)
                {
                    <div class="cov-empty cov-empty--compact"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a coverage type</strong><span>Open details, recommendations, and quick actions.</span></div>
                }
                else
                {
                    <div class="cov-selected__title">
                        <div class="cov-avatar cov-avatar--lg" style="@AvatarStyle(_selected.CoverageName)" aria-hidden="true">@Initials(_selected.CoverageName)</div>
                        <div><h3>@_selected.CoverageName</h3><span>@Safe(_selected.CoverageCode, "No code") • @Safe(_selected.LobCode, "Unmapped")</span></div>
                    </div>
                    <div class="cov-score-card @ImportanceClass(_selected)"><span>Importance score</span><strong>@ImportanceScore(_selected)</strong><small>@RecommendedAction(_selected)</small></div>
                    <dl class="cov-detail-list">
                        <div><dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd></div>
                        <div><dt>LOB code</dt><dd>@Safe(_selected.LobCode, "Unmapped")</dd></div>
                        <div><dt>Coverage code</dt><dd>@_selected.CoverageCode</dd></div>
                        <div><dt>Sort order</dt><dd>@_selected.SortOrder</dd></div>
                        <div><dt>Created</dt><dd>@FormatDate(_selected.CreatedDateUtc)</dd></div>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(_selected.Description))
                    {
                        <p class="cov-description">@_selected.Description</p>
                    }
                    <div class="cov-selected-actions">
                        <button type="button" class="cov-btn cov-btn--primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                        <button type="button" class="cov-btn cov-btn--ghost" @onclick="() => ConfirmToggle(_selected)"><i class="bi @(_selected.IsActive ? "bi-archive" : "bi-check-circle")" aria-hidden="true"></i> @(_selected.IsActive ? "Archive" : "Activate")</button>
                    </div>
                }
            </section>

            <section class="cov-panel-card">
                <span class="cov-section-kicker">Enterprise insights</span>
                <div class="cov-insight-list">
                    <div class="cov-insight"><i class="bi bi-diagram-3" aria-hidden="true"></i><div><strong>LOB mapping</strong><span>@MappingInsight</span></div></div>
                    <div class="cov-insight"><i class="bi bi-lightning-charge" aria-hidden="true"></i><div><strong>Priority coverage</strong><span>@PriorityInsight</span></div></div>
                    <div class="cov-insight"><i class="bi bi-shield-check" aria-hidden="true"></i><div><strong>Workflow readiness</strong><span>@ReadinessInsight</span></div></div>
                </div>
            </section>
        </aside>
    </main>
</div>

@if (_showForm)
{
    <div class="cov-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="coverage-form-title">
        <div class="cov-modal">
            <div class="cov-modal__header"><i class="bi bi-umbrella" aria-hidden="true"></i><span id="coverage-form-title">@(_editId.HasValue ? "Edit Coverage Type" : "Add Coverage Type")</span><button type="button" class="cov-icon-btn cov-icon-btn--light ms-auto" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="cov-modal__body">
                    <div class="cov-validation-note"><i class="bi bi-info-circle" aria-hidden="true"></i><div><strong>Coverage governance</strong><span>Map coverage types to LOB codes when possible and keep descriptions aligned to quote, policy, and reporting workflows.</span></div></div>
                    <div class="cov-form-grid">
                        <label class="cov-field"><span>Coverage Code <em>*</em></span><InputText @bind-Value="_form.CoverageCode" class="form-control" placeholder="e.g. LIABILITY" /><ValidationMessage For="() => _form.CoverageCode" class="text-danger" /></label>
                        <label class="cov-field"><span>Coverage Name <em>*</em></span><InputText @bind-Value="_form.CoverageName" class="form-control" placeholder="General Liability" /><ValidationMessage For="() => _form.CoverageName" class="text-danger" /></label>
                        <label class="cov-field"><span>LOB Code</span><InputText @bind-Value="_form.LobCode" class="form-control" placeholder="e.g. BOP" /><ValidationMessage For="() => _form.LobCode" class="text-danger" /></label>
                        <label class="cov-field"><span>Sort Order</span><InputNumber @bind-Value="_form.SortOrder" class="form-control" /><ValidationMessage For="() => _form.SortOrder" class="text-danger" /></label>
                        <label class="cov-field cov-field--wide"><span>Description</span><InputTextArea @bind-Value="_form.Description" class="form-control" rows="3" placeholder="Describe coverage usage, eligibility, quote context, or reporting guidance." /><ValidationMessage For="() => _form.Description" class="text-danger" /></label>
                        @if (_editId.HasValue)
                        {
                            <label class="cov-check-field"><InputCheckbox @bind-Value="_form.IsActive" /><span>Active</span></label>
                        }
                    </div>
                </div>
                <div class="cov-modal__footer"><button type="button" class="cov-btn cov-btn--ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="cov-btn cov-btn--primary" disabled="@_saving">@if (_saving) { <span class="cov-spin-sm"></span> } @(_editId.HasValue ? "Save Changes" : "Create Coverage")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_confirmVisible)
{
    <div class="cov-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="coverage-confirm-title">
        <div class="cov-confirm">
            <div class="cov-confirm__body"><div class="cov-confirm-icon cov-confirm-icon--danger"><i class="bi @_confirmIcon" aria-hidden="true"></i></div><div><h3 id="coverage-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div></div>
            <div class="cov-modal__footer"><button type="button" class="cov-btn cov-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button><button type="button" class="cov-btn cov-btn--danger" @onclick="ExecuteConfirmedAsync" disabled="@_saving">@if (_saving) { <span class="cov-spin-sm"></span> } Confirm</button></div>
        </div>
    </div>
}

<div class="cov-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="cov-toast cov-toast--@toast.Kind"><i class="bi @(toast.Kind == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    }
</div>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    Guid TenantId { get; set; }

    readonly List<DashboardTab> _tabs = [new("all", "All", "bi-shield-check"), new("active", "Active", "bi-check-circle"), new("mapped", "Mapped", "bi-diagram-3"), new("unmapped", "Unmapped", "bi-question-circle"), new("priority", "Priority", "bi-lightning-charge"), new("risk", "Needs Review", "bi-exclamation-octagon"), new("inactive", "Inactive", "bi-slash-circle"), new("lobs", "LOBs", "bi-pie-chart")];

    List<CoverageTypeDto> _items = [];
    HashSet<Guid> _selectedIds = [];
    List<ToastItem> _toasts = [];
    CoverageTypeDto? _selected;
    CoverageFormModel _form = new();
    Func<Task>? _confirmAction;
    Guid? _editId;
    string _activeTab = "all";
    string _searchTerm = string.Empty;
    string _lobFilter = string.Empty;
    string _statusFilter = string.Empty;
    string _sortMode = "importance";
    string _confirmTitle = string.Empty;
    string _confirmMessage = string.Empty;
    string _confirmIcon = "bi-exclamation-triangle-fill";
    string? _loadError;
    bool _loading;
    bool _saving;
    bool _showForm;
    bool _confirmVisible;
    int _page = 1;
    const int PageSize = 12;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policy Config", null), new("Coverage Types", null));
        await LoadAsync();
    }

    IEnumerable<CoverageTypeDto> FilteredCoverages
    {
        get
        {
            IEnumerable<CoverageTypeDto> query = _items;
            query = _activeTab switch
            {
                "active" => query.Where(x => x.IsActive),
                "mapped" => query.Where(x => !string.IsNullOrWhiteSpace(x.LobCode)),
                "unmapped" => query.Where(x => string.IsNullOrWhiteSpace(x.LobCode)),
                "priority" => query.Where(IsPriorityCoverage),
                "risk" => query.Where(NeedsReview),
                "inactive" => query.Where(x => !x.IsActive),
                _ => query
            };

            if (!string.IsNullOrWhiteSpace(_searchTerm)) query = query.Where(MatchesSearch);
            if (!string.IsNullOrWhiteSpace(_lobFilter)) query = query.Where(x => string.Equals(Safe(x.LobCode, "Unmapped"), _lobFilter, StringComparison.OrdinalIgnoreCase));
            query = _statusFilter switch
            {
                "Active" => query.Where(x => x.IsActive),
                "Inactive" => query.Where(x => !x.IsActive),
                "Mapped" => query.Where(x => !string.IsNullOrWhiteSpace(x.LobCode)),
                "Unmapped" => query.Where(x => string.IsNullOrWhiteSpace(x.LobCode)),
                "NeedsReview" => query.Where(NeedsReview),
                _ => query
            };

            return _sortMode switch
            {
                "order" => query.OrderBy(x => x.SortOrder).ThenBy(x => x.CoverageName),
                "name" => query.OrderBy(x => x.CoverageName),
                "code" => query.OrderBy(x => x.CoverageCode),
                "lob" => query.OrderBy(x => Safe(x.LobCode, "Unmapped")).ThenBy(x => x.SortOrder).ThenBy(x => x.CoverageName),
                "created" => query.OrderByDescending(x => x.CreatedDateUtc),
                _ => query.OrderByDescending(ImportanceScore).ThenBy(x => x.SortOrder).ThenBy(x => x.CoverageName)
            };
        }
    }

    List<CoverageTypeDto> PagedCoverages => FilteredCoverages.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCoverages.Count() / (double)PageSize));
    bool AllPageSelected => PagedCoverages.Count > 0 && PagedCoverages.All(IsSelected);
    bool HasFilters => !string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_lobFilter) || !string.IsNullOrWhiteSpace(_statusFilter) || _activeTab != "all" || _sortMode != "importance";
    string ActiveViewTitle => _tabs.FirstOrDefault(x => x.Key == _activeTab)?.Label ?? "All";
    IEnumerable<string> LobOptions => LobGroups.Select(x => x.Name);
    string MappingInsight => _items.Count == 0 ? "Create coverage types before mapping policy coverage." : $"{_items.Count(x => !string.IsNullOrWhiteSpace(x.LobCode))} of {_items.Count} coverage types are mapped to a LOB.";
    string PriorityInsight => _items.Any(IsPriorityCoverage) ? $"{_items.Count(IsPriorityCoverage)} priority coverage definitions support high-impact quoting and servicing workflows." : "No priority coverage keywords were detected.";
    string ReadinessInsight => _items.Count == 0 ? "Create coverage types before enabling policy coverage workflows." : $"{Math.Round(_items.Count(x => x.IsActive && !NeedsReview(x)) * 100m / _items.Count)}% of coverage types are active with no review flags.";
    List<LobGroupSummary> LobGroups => _items.GroupBy(x => Safe(x.LobCode, "Unmapped")).Select(g => new LobGroupSummary(g.Key, g.Count(), g.Count(x => x.IsActive), g.Count(IsPriorityCoverage), g.Count(NeedsReview), _items.Count == 0 ? 0 : Math.Round(g.Count() * 100m / _items.Count, 0))).OrderByDescending(x => x.Count).ToList();

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchCoverageTypesAsync(TenantId, null, pageSize: 500);
            _items = result?.Items.ToList() ?? [];
            _selectedIds.RemoveWhere(id => _items.All(x => x.CoverageTypeId != id));
            _selected = _selected is null ? _items.OrderByDescending(ImportanceScore).FirstOrDefault() : _items.FirstOrDefault(x => x.CoverageTypeId == _selected.CoverageTypeId) ?? _items.OrderByDescending(ImportanceScore).FirstOrDefault();
            NormalizePage();
        }
        catch (Exception ex) { _loadError = $"Failed to load coverage types: {ex.Message}"; }
        finally { _loading = false; }
    }

    Task RefreshAsync() => LoadAsync();
    void ApplyFilters() { _page = 1; NormalizePage(); }
    void OnSearchInputValue(string? value) { _searchTerm = value ?? string.Empty; ApplyFilters(); }
    void SetDashboardFocus(string tab, string sort) { _activeTab = tab; _sortMode = sort; _page = 1; NormalizePage(); }
    void SetActiveTab(string tab) { _activeTab = tab; _page = 1; NormalizePage(); }
    void PreviousPage() { if (_page > 1) _page--; }
    void NextPage() { if (_page < TotalPages) _page++; }
    void NormalizePage() { if (_page > TotalPages) _page = TotalPages; }
    void SelectRow(CoverageTypeDto item) => _selected = item;
    bool IsSelected(CoverageTypeDto item) => _selectedIds.Contains(item.CoverageTypeId);
    void ToggleSelect(CoverageTypeDto item, bool selected) { if (selected) _selectedIds.Add(item.CoverageTypeId); else _selectedIds.Remove(item.CoverageTypeId); _selected = item; }
    void ToggleSelectAllPage(bool selected) { foreach (var item in PagedCoverages) { if (selected) _selectedIds.Add(item.CoverageTypeId); else _selectedIds.Remove(item.CoverageTypeId); } }
    void ClearFilters() { _searchTerm = string.Empty; _lobFilter = string.Empty; _statusFilter = string.Empty; _sortMode = "importance"; _activeTab = "all"; _page = 1; }
    void FilterByLob(string lobCode) { _activeTab = "all"; _lobFilter = lobCode; _sortMode = "importance"; _page = 1; }

    void OpenCreate() { _editId = null; _form = new() { IsActive = true, SortOrder = NextSortOrder() }; _showForm = true; }
    void OpenEdit(CoverageTypeDto item) { _selected = item; _editId = item.CoverageTypeId; _form = new() { CoverageCode = item.CoverageCode, CoverageName = item.CoverageName, LobCode = item.LobCode, Description = item.Description, IsActive = item.IsActive, SortOrder = item.SortOrder }; _showForm = true; }
    void CloseForm() { _showForm = false; ResetForm(); }
    void ResetForm() { _form = new(); _editId = null; }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue) await Api.UpdateCoverageTypeAsync(_editId.Value, new(_form.CoverageCode.Trim(), _form.CoverageName.Trim(), NormalizeNullable(_form.LobCode), NormalizeNullable(_form.Description), _form.IsActive, _form.SortOrder));
            else await Api.CreateCoverageTypeAsync(new(TenantId, _form.CoverageCode.Trim(), _form.CoverageName.Trim(), NormalizeNullable(_form.LobCode), NormalizeNullable(_form.Description), _form.SortOrder));
            _showForm = false;
            ShowToast("success", _editId.HasValue ? "Coverage type updated successfully." : "Coverage type created successfully.");
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast("danger", $"Save failed: {ex.Message}"); }
        finally { _saving = false; }
    }

    void ConfirmToggle(CoverageTypeDto item)
    {
        var enable = !item.IsActive;
        OpenConfirm(enable ? "Activate Coverage Type" : "Archive Coverage Type", $"Are you sure you want to {(enable ? "activate" : "archive")} {item.CoverageName}? This changes availability in policy workflows.", enable ? "bi-check-circle" : "bi-archive-fill", () => SetCoverageActiveAsync(item, enable));
    }

    void ConfirmBulkToggle(bool enable) => OpenConfirm(enable ? "Activate Selected Coverage" : "Archive Selected Coverage", $"Are you sure you want to {(enable ? "activate" : "archive")} {_selectedIds.Count} selected coverage type(s)?", enable ? "bi-check-circle" : "bi-archive-fill", () => BulkSetActiveAsync(enable));
    void OpenConfirm(string title, string message, string icon, Func<Task> action) { _confirmTitle = title; _confirmMessage = message; _confirmIcon = icon; _confirmAction = action; _confirmVisible = true; }
    void CloseConfirm() { _confirmVisible = false; _confirmAction = null; }
    async Task ExecuteConfirmedAsync() { if (_confirmAction is null) return; _saving = true; try { await _confirmAction(); _confirmVisible = false; _confirmAction = null; } finally { _saving = false; } }

    async Task SetCoverageActiveAsync(CoverageTypeDto item, bool active)
    {
        try
        {
            await Api.UpdateCoverageTypeAsync(item.CoverageTypeId, new(item.CoverageCode, item.CoverageName, item.LobCode, item.Description, active, item.SortOrder));
            ShowToast("success", active ? "Coverage type activated." : "Coverage type archived.");
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast("danger", $"Update failed: {ex.Message}"); }
    }

    async Task BulkSetActiveAsync(bool active)
    {
        var selected = _items.Where(x => _selectedIds.Contains(x.CoverageTypeId)).ToList();
        var updated = 0;
        foreach (var item in selected)
        {
            try { await Api.UpdateCoverageTypeAsync(item.CoverageTypeId, new(item.CoverageCode, item.CoverageName, item.LobCode, item.Description, active, item.SortOrder)); updated++; }
            catch (Exception ex) { ShowToast("danger", $"Update failed for {item.CoverageName}: {ex.Message}"); }
        }
        ShowToast("success", $"{updated} coverage type(s) {(active ? "activated" : "archived")}.");
        _selectedIds.Clear();
        await LoadAsync();
    }

    RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string color) => @<button type="button" class="cov-kpi-card cov-kpi-card--@color @(_activeTab == key ? "cov-kpi-card--active" : null)" title="@subtitle" @onclick="() => SetActiveTab(key)"><span class="cov-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span><span class="cov-kpi-body"><span class="cov-kpi-label">@label</span><strong class="cov-kpi-value">@value</strong><span class="cov-kpi-sub">@subtitle</span></span></button>;

    int TabCount(string key) => key switch { "active" => _items.Count(x => x.IsActive), "mapped" => _items.Count(x => !string.IsNullOrWhiteSpace(x.LobCode)), "unmapped" => _items.Count(x => string.IsNullOrWhiteSpace(x.LobCode)), "priority" => _items.Count(IsPriorityCoverage), "risk" => _items.Count(NeedsReview), "inactive" => _items.Count(x => !x.IsActive), "lobs" => LobGroups.Count, _ => _items.Count };
    bool MatchesSearch(CoverageTypeDto item) { var term = _searchTerm.Trim(); return Contains(item.CoverageCode, term) || Contains(item.CoverageName, term) || Contains(item.LobCode, term) || Contains(item.Description, term); }
    static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string? NormalizeNullable(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    static string FormatDate(DateTime date) => date == default ? "—" : date.ToLocalTime().ToString("MMM d, yyyy");
    static bool NeedsReview(CoverageTypeDto item) => !item.IsActive || string.IsNullOrWhiteSpace(item.CoverageCode) || string.IsNullOrWhiteSpace(item.CoverageName) || string.IsNullOrWhiteSpace(item.LobCode) || string.IsNullOrWhiteSpace(item.Description);
    static bool IsPriorityCoverage(CoverageTypeDto item) => Contains(item.CoverageCode, "LIAB") || Contains(item.CoverageName, "Liability") || Contains(item.CoverageName, "Property") || Contains(item.CoverageName, "Auto") || Contains(item.CoverageName, "Umbrella") || Contains(item.CoverageName, "Workers") || Contains(item.CoverageName, "Cyber") || Contains(item.Description, "critical");
    static string LobIcon(string? lob) => string.IsNullOrWhiteSpace(lob) || lob == "Unmapped" ? "bi-question-circle" : "bi-diagram-3";

    static int ImportanceScore(CoverageTypeDto item)
    {
        var score = 32;
        if (item.IsActive) score += 16; else score += 18;
        if (!string.IsNullOrWhiteSpace(item.LobCode)) score += 16; else score += 18;
        if (IsPriorityCoverage(item)) score += 18;
        if (item.SortOrder <= 10) score += 6;
        if (!string.IsNullOrWhiteSpace(item.Description)) score += 6; else score += 10;
        return Math.Clamp(score, 0, 100);
    }

    static string RecommendedAction(CoverageTypeDto item)
    {
        if (!item.IsActive) return "Review whether this coverage should remain archived or be reactivated.";
        if (string.IsNullOrWhiteSpace(item.LobCode)) return "Map this coverage to a LOB code for policy and reporting workflows.";
        if (string.IsNullOrWhiteSpace(item.Description)) return "Add usage guidance for quoting, policy, and servicing teams.";
        return "Configuration is ready for policy coverage workflows.";
    }

    static string ImportanceClass(CoverageTypeDto item) => ImportanceScore(item) switch { >= 80 => "cov-score-card--red", >= 65 => "cov-score-card--amber", >= 45 => "cov-score-card--cyan", _ => "cov-score-card--green" };
    static MarkupString ImportanceBadge(CoverageTypeDto item) { var score = ImportanceScore(item); var css = score switch { >= 80 => "red", >= 65 => "amber", >= 45 => "cyan", _ => "green" }; return new($"<span class=\"cov-risk-badge cov-risk-badge--{css}\">{score}</span>"); }
    static string Initials(string? value) { var parts = (value ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); return parts.Length switch { 0 => "CV", 1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(), _ => string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0]))) }; }
    static string AvatarStyle(string? value) { var hash = Math.Abs((value ?? "CoverageType").GetHashCode()); var hue = hash % 360; return $"background:linear-gradient(135deg,hsl({hue},78%,48%),hsl({(hue + 35) % 360},82%,36%));"; }
    int NextSortOrder() => _items.Count == 0 ? 10 : _items.Max(x => x.SortOrder) + 10;
    void ShowToast(string kind, string message) { _toasts.Insert(0, new(Guid.NewGuid(), kind, message)); if (_toasts.Count > 4) _toasts.RemoveRange(4, _toasts.Count - 4); }
    void DismissToast(Guid id) => _toasts.RemoveAll(x => x.Id == id);

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }

    sealed class CoverageFormModel
    {
        [Required, StringLength(50)] public string CoverageCode { get; set; } = string.Empty;
        [Required, StringLength(100)] public string CoverageName { get; set; } = string.Empty;
        [StringLength(80)] public string? LobCode { get; set; }
        [StringLength(500)] public string? Description { get; set; }
        [Range(0, 9999)] public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
    }

    sealed record DashboardTab(string Key, string Label, string Icon);
    sealed record LobGroupSummary(string Name, int Count, int Active, int Priority, int ReviewCount, decimal Percent);
    sealed record ToastItem(Guid Id, string Kind, string Message);
}
