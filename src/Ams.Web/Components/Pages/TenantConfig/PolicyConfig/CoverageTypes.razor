@page "/tenant/policies/coverage"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.PolicyConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Coverage Types â€” Policy Configuration</PageTitle>

<AppPageHeader Title="Coverage Types"
               Subtitle="Configure policy coverage types by line of business"
               Icon="bi-umbrella">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Coverage</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
    </Actions>
</AppPageHeader>

<div class="pc-kpi-strip">
    <div class="pc-kpi-card @(_activeFilter == "" ? "pc-kpi-card--active" : "")" title="Show all coverage types" @onclick='() => SetFilter("")' style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-umbrella" aria-hidden="true"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total Types</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "active" ? "pc-kpi-card--active" : "")" title="Filter active coverage types" @onclick='() => SetFilter("active")' style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsActive)</div><div class="pc-kpi-label">Active</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "inactive" ? "pc-kpi-card--active" : "")" title="Filter inactive coverage types" @onclick='() => SetFilter("inactive")' style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-slash-circle" aria-hidden="true"></i></span><div><div class="pc-kpi-value">@_items.Count(x => !x.IsActive)</div><div class="pc-kpi-label">Inactive</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "unmapped" ? "pc-kpi-card--active" : "")" title="Filter unmapped coverage types" @onclick='() => SetFilter("unmapped")' style="cursor:pointer"><span class="pc-kpi-icon" style="background:#dbeafe"><i class="bi bi-question-circle text-primary" aria-hidden="true"></i></span><div><div class="pc-kpi-value">@_items.Count(x => string.IsNullOrWhiteSpace(x.LobCode))</div><div class="pc-kpi-label">Unmapped</div></div></div>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div>
}

<AppFilterPanel @bind-SearchValue="_search" OnSearch="OnSearchAsync" SearchPlaceholder="Search coverage type or codeâ€¦" />

<div class="um-grid-card">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loadingâ€¦</span></div> }
    <SfGrid TValue="CoverageTypeDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
        <GridEvents TValue="CoverageTypeDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" />
        <GridColumns>
            <GridColumn Field="CoverageCode" HeaderText="Code" Width="130" />
            <GridColumn Field="CoverageName" HeaderText="Coverage Type" Width="240" />
            <GridColumn Field="LobCode" HeaderText="LOB Code" Width="130" />
            <GridColumn Field="Description" HeaderText="Description" Width="260" />
            <GridColumn Field="SortOrder" HeaderText="Order" Width="80" TextAlign="TextAlign.Center" />
            <GridColumn Field="IsActive" HeaderText="Status" Width="100" TextAlign="TextAlign.Center"><Template>@{ var r = (CoverageTypeDto)context; }<span class="um-badge @(r.IsActive ? "um-badge-success" : "um-badge-neutral")">@(r.IsActive ? "Active" : "Inactive")</span></Template></GridColumn>
            <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Center"><Template>@{ var r = (CoverageTypeDto)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEdit(r)"><i class="bi bi-pencil"></i></button></Template></GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showForm" Width="540px" IsModal="true" ShowCloseIcon="false">
    <DialogEvents Closed="ResetForm" />
    <DialogContent>
        <div class="um-modal-header"><i class="bi bi-umbrella" aria-hidden="true"></i><span>@(_editId.HasValue ? "Edit Coverage Type" : "Add Coverage Type")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field"><label>Coverage Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.CoverageCode" class="um-input" placeholder="e.g. LIABILITY" /></div>
                <div class="um-field"><label>Coverage Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.CoverageName" class="um-input" /></div>
                <div class="um-field"><label>LOB Code</label><InputText @bind-Value="_form.LobCode" class="um-input" placeholder="e.g. BOP" /></div>
                <div class="um-field"><label>Sort Order</label><InputNumber @bind-Value="_form.SortOrder" class="um-input" /></div>
                <div class="um-field"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="2" /></div>
                <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label></div>
            </div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button></div>
        </EditForm>
    </DialogContent>
</SfDialog>

<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true"><ToastPosition X="Right" Y="Bottom" /></SfToast>
<style>.validation-message{display:flex;align-items:center;gap:.45rem;margin-top:.55rem;color:#dc3545!important;font-size:.875rem;font-weight:700}.validation-message::before{content:"!";display:inline-flex;align-items:center;justify-content:center;width:1rem;height:1rem;min-width:1rem;flex-shrink:0;border-radius:999px;color:#fff;background:linear-gradient(135deg,#ef4444,#b91c1c);font-size:.7rem;font-weight:800}.um-input.modified.invalid{border-color:#dc3545!important;box-shadow:0 0 0 .18rem rgba(220,53,69,.14)!important}</style>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    Guid TenantId { get; set; }
    List<CoverageTypeDto> _items = [];
    List<CoverageTypeDto> _filtered = [];
    string _activeFilter = "";
    bool _loading, _saving, _showForm;
    string _search = string.Empty;
    string? _loadError;
    Guid? _editId;
    SfToast _toast = default!;
    CoverageFormModel _form = new();

    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policy Config", null), new("Coverage Types", null)); await LoadAsync(); }
    async Task LoadAsync() { _loading = true; _loadError = null; try { var r = await Api.SearchCoverageTypesAsync(TenantId, _search, pageSize: 200); _items = r?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = ex.Message; } finally { _loading = false; } }
    void SetFilter(string filter) { _activeFilter = filter; ApplyFilter(); }
    void ApplyFilter() => _filtered = _activeFilter switch { "active" => _items.Where(x => x.IsActive).ToList(), "inactive" => _items.Where(x => !x.IsActive).ToList(), "unmapped" => _items.Where(x => string.IsNullOrWhiteSpace(x.LobCode)).ToList(), _ => [.. _items] };
    Task OnSearchAsync() => LoadAsync();
    void OnRowSelected(RowSelectEventArgs<CoverageTypeDto> args) => OpenEdit(args.Data);
    void OpenCreate() { _editId = null; _form = new(); _showForm = true; }
    void OpenEdit(CoverageTypeDto item) { _editId = item.CoverageTypeId; _form = new() { CoverageCode = item.CoverageCode, CoverageName = item.CoverageName, LobCode = item.LobCode, Description = item.Description, SortOrder = item.SortOrder, IsActive = item.IsActive }; _showForm = true; }
    async Task SaveAsync() { _saving = true; try { if (_editId.HasValue) await Api.UpdateCoverageTypeAsync(_editId.Value, new(_form.CoverageCode, _form.CoverageName, _form.LobCode, _form.Description, _form.IsActive, _form.SortOrder)); else await Api.CreateCoverageTypeAsync(new(TenantId, _form.CoverageCode, _form.CoverageName, _form.LobCode, _form.Description, _form.SortOrder)); _showForm = false; await _toast.ShowAsync(new() { Content = "Saved successfully", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } }
    void ResetForm() { _form = new(); _editId = null; }
    sealed class CoverageFormModel { [Required, StringLength(50)] public string CoverageCode { get; set; } = string.Empty; [Required, StringLength(100)] public string CoverageName { get; set; } = string.Empty; [StringLength(80)] public string? LobCode { get; set; } [StringLength(500)] public string? Description { get; set; } [Range(0, 9999)] public int SortOrder { get; set; } public bool IsActive { get; set; } = true; }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
