    async Task SetFieldActiveAsync(PolicyCustomFieldDto item, bool active) { try { await Api.UpdatePolicyCustomFieldAsync(item.CustomFieldId, new(item.FieldCode, item.FieldName, item.EntityType, item.FieldType, item.DefaultValue, item.DropdownOptions, item.IsRequired, item.IsSearchable, active, item.SortOrder)); ShowToast("success", active ? "Custom field activated." : "Custom field deactivated."); await LoadAsync(); } catch (Exception ex) { ShowToast("danger", $"Update failed: {ex.Message}"); } }
    async Task DeleteFieldAsync(PolicyCustomFieldDto item) { try { await Api.DeletePolicyCustomFieldAsync(item.CustomFieldId); _selectedIds.Remove(item.CustomFieldId); if (_selected?.CustomFieldId == item.CustomFieldId) _selected = null; ShowToast("success", "Custom field deleted."); await LoadAsync(); } catch (Exception ex) { ShowToast("danger", $"Delete failed: {ex.Message}"); } }
    async Task BulkSetActiveAsync(bool active) { var selected = _items.Where(x => _selectedIds.Contains(x.CustomFieldId)).ToList(); var updated = 0; foreach (var item in selected) { try { await Api.UpdatePolicyCustomFieldAsync(item.CustomFieldId, new(item.FieldCode, item.FieldName, item.EntityType, item.FieldType, item.DefaultValue, item.DropdownOptions, item.IsRequired, item.IsSearchable, active, item.SortOrder)); updated++; } catch (Exception ex) { ShowToast("danger", $"Update failed for {item.FieldName}: {ex.Message}"); } } ShowToast("success", $"{updated} custom field(s) {(active ? "activated" : "deactivated")}. "); _selectedIds.Clear(); await LoadAsync(); }
    async Task BulkDeleteAsync() { var selected = _items.Where(x => _selectedIds.Contains(x.CustomFieldId)).ToList(); var deleted = 0; foreach (var item in selected) { try { await Api.DeletePolicyCustomFieldAsync(item.CustomFieldId); deleted++; } catch (Exception ex) { ShowToast("danger", $"Delete failed for {item.FieldName}: {ex.Message}"); } } ShowToast("success", $"{deleted} custom field(s) deleted."); _selectedIds.Clear(); _selected = null; await LoadAsync(); }

    RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string color) => @<button type="button" class="pcf-kpi-card pcf-kpi-card--@color @(_activeTab == key ? "pcf-kpi-card--active" : null)" title="@subtitle" @onclick="() => SetActiveTab(key)"><span class="pcf-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span><span class="pcf-kpi-body"><span class="pcf-kpi-label">@label</span><strong class="pcf-kpi-value">@value</strong><span class="pcf-kpi-sub">@subtitle</span></span></button>;
    int TabCount(string key) => key switch { "active" => _items.Count(x => x.IsActive), "required" => _items.Count(x => x.IsRequired), "searchable" => _items.Count(x => x.IsSearchable), "dropdown" => _items.Count(IsDropdownField), "review" => _items.Count(NeedsReview), "entities" => EntityGroups.Count, _ => _items.Count };
    bool MatchesSearch(PolicyCustomFieldDto item) { var term = _searchTerm.Trim(); return Contains(item.FieldCode, term) || Contains(item.FieldName, term) || Contains(item.EntityType, term) || Contains(item.FieldType, term) || Contains(item.DefaultValue, term) || Contains(item.DropdownOptions, term); }
    static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string? NormalizeNullable(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    static string FormatDate(DateTime date) => date == default ? "-" : date.ToLocalTime().ToString("MMM d, yyyy");
    static bool IsDropdownField(PolicyCustomFieldDto item) => item.FieldType.Equals("Dropdown", StringComparison.OrdinalIgnoreCase);
    static bool NeedsReview(PolicyCustomFieldDto item) => !item.IsActive || string.IsNullOrWhiteSpace(item.FieldCode) || string.IsNullOrWhiteSpace(item.FieldName) || string.IsNullOrWhiteSpace(item.EntityType) || string.IsNullOrWhiteSpace(item.FieldType) || (IsDropdownField(item) && string.IsNullOrWhiteSpace(item.DropdownOptions));
    static string EntityIcon(string entity) => entity switch { "Policy" => "bi-file-earmark-text", "Coverage" => "bi-shield-check", "Endorsement" => "bi-pencil-square", "Certificate" => "bi-patch-check", "IDCard" => "bi-card-text", _ => "bi-diagram-3" };
    static string EntityBadgeClass(string entity) => entity switch { "Policy" => "pcf-pill--blue", "Coverage" => "pcf-pill--green", "Endorsement" => "pcf-pill--purple", "Certificate" => "pcf-pill--amber", "IDCard" => "pcf-pill--cyan", _ => "pcf-pill--neutral" };
    static string FieldTypeBadgeClass(string type) => type switch { "Text" => "pcf-pill--blue", "Number" => "pcf-pill--green", "Date" => "pcf-pill--purple", "Dropdown" => "pcf-pill--amber", "Checkbox" => "pcf-pill--cyan", _ => "pcf-pill--neutral" };
    static int ImportanceScore(PolicyCustomFieldDto item) { var score = 30; if (item.IsActive) score += 12; else score += 16; if (item.IsRequired) score += 20; if (item.IsSearchable) score += 14; if (IsDropdownField(item)) score += 10; if (item.EntityType is "Policy" or "Coverage") score += 8; if (item.SortOrder <= 10) score += 4; if (NeedsReview(item)) score += 12; return Math.Clamp(score, 0, 100); }
    static string RecommendedAction(PolicyCustomFieldDto item) { if (!item.IsActive) return "Review whether this custom field should remain inactive."; if (IsDropdownField(item) && string.IsNullOrWhiteSpace(item.DropdownOptions)) return "Add dropdown options before using this field in production."; if (item.IsRequired && string.IsNullOrWhiteSpace(item.DefaultValue)) return "Consider a default value if workflow users need guidance."; if (item.IsSearchable) return "Search-enabled field is ready for servicing and reporting workflows."; return "Configuration is ready for policy data workflows."; }
    static string ImportanceClass(PolicyCustomFieldDto item) => ImportanceScore(item) switch { >= 80 => "pcf-score-card--red", >= 65 => "pcf-score-card--amber", >= 45 => "pcf-score-card--cyan", _ => "pcf-score-card--green" };
    static string ImportanceBadgeClass(PolicyCustomFieldDto item) => ImportanceScore(item) switch { >= 80 => "pcf-risk-badge--red", >= 65 => "pcf-risk-badge--amber", >= 45 => "pcf-risk-badge--cyan", _ => "pcf-risk-badge--green" };
    static string Initials(string? value) { var parts = (value ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); return parts.Length switch { 0 => "CF", 1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(), _ => string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0]))) }; }
    static string AvatarStyle(string? value) { var hash = Math.Abs((value ?? "PolicyCustomField").GetHashCode()); var hue = hash % 360; return $"background:linear-gradient(135deg,hsl({hue},78%,48%),hsl({(hue + 35) % 360},82%,36%));"; }
    int NextSortOrder() => _items.Count == 0 ? 10 : _items.Max(x => x.SortOrder) + 10;
