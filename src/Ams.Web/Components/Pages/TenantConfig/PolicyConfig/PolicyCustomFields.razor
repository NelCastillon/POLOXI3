@page "/tenant/policies/custom-fields"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.PolicyConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Policy Custom Fields Command Center - Policy Configuration</PageTitle>

<div class="pcf-page">
    <section class="pcf-hero">
        <div class="pcf-hero__content">
            <div class="pcf-hero-left">
                <span class="pcf-hero-icon"><i class="bi bi-input-cursor-text" aria-hidden="true"></i></span>
                <div class="pcf-hero-title">
                    <div class="pcf-hero__eyebrow">Enterprise policy data configuration</div>
                    <div class="pcf-title-row">
                        <h1>Policy Custom Fields Command Center</h1>
                        <div class="pcf-hero__meta">
                            <span><i class="bi bi-input-cursor-text" aria-hidden="true"></i>@_items.Count fields</span>
                            <span><i class="bi bi-check-circle" aria-hidden="true"></i>@_items.Count(x => x.IsActive) active</span>
                            <span><i class="bi bi-asterisk" aria-hidden="true"></i>@_items.Count(x => x.IsRequired) required</span>
                            <span><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>@_items.Count(NeedsReview) need review</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Govern tenant-specific policy, coverage, endorsement, certificate, and ID card data capture with operational priority, validation readiness, searchability, and workflow controls.</p>
        </div>
        <div class="pcf-hero__actions">
            <button type="button" class="pcf-btn pcf-btn--light" @onclick="RefreshAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "pcf-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="pcf-btn pcf-btn--primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Field</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger pcf-alert" style="border-left: 4px solid #dc3545; animation: pcf-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@_loadError</span></div>
    }

    <section class="pcf-kpi-strip" aria-label="Policy custom field KPIs">
        @KpiCard("all", "Total Fields", _items.Count.ToString(), "All configured policy custom fields", "bi-input-cursor-text", "blue")
        @KpiCard("active", "Active", _items.Count(x => x.IsActive).ToString(), "Fields available in policy workflows", "bi-check-circle", "green")
        @KpiCard("required", "Required", _items.Count(x => x.IsRequired).ToString(), "Mandatory data capture fields", "bi-asterisk", "red")
        @KpiCard("searchable", "Searchable", _items.Count(x => x.IsSearchable).ToString(), "Fields indexed for workflow search", "bi-search", "cyan")
        @KpiCard("dropdown", "Dropdowns", _items.Count(IsDropdownField).ToString(), "Fields requiring option governance", "bi-list-check", "purple")
        @KpiCard("review", "Needs Review", _items.Count(NeedsReview).ToString(), "Inactive, incomplete, or misconfigured fields", "bi-exclamation-octagon", "amber")
    </section>

    <section class="pcf-workflows" aria-label="Policy custom field workflows">
        <button type="button" class="pcf-workflow" @onclick='() => SetDashboardFocus("all", "importance")'><span class="pcf-workflow-icon"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></span><span class="pcf-workflow-meta"><strong>Priority review</strong><span>Rank fields by validation, search, and entity impact</span></span></button>
        <button type="button" class="pcf-workflow" @onclick='() => SetDashboardFocus("required", "importance")'><span class="pcf-workflow-icon"><i class="bi bi-asterisk" aria-hidden="true"></i></span><span class="pcf-workflow-meta"><strong>Required data</strong><span>Audit mandatory policy data capture</span></span></button>
        <button type="button" class="pcf-workflow" @onclick='() => SetDashboardFocus("searchable", "importance")'><span class="pcf-workflow-icon"><i class="bi bi-search" aria-hidden="true"></i></span><span class="pcf-workflow-meta"><strong>Search enablement</strong><span>Review fields that drive servicing lookup</span></span></button>
        <button type="button" class="pcf-workflow" @onclick='() => SetDashboardFocus("review", "importance")'><span class="pcf-workflow-icon"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i></span><span class="pcf-workflow-meta"><strong>Cleanup queue</strong><span>Resolve missing options and inactive fields</span></span></button>
        <button type="button" class="pcf-workflow" @onclick='() => SetDashboardFocus("entities", "entity")'><span class="pcf-workflow-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span><span class="pcf-workflow-meta"><strong>Entity mix</strong><span>Compare Policy, Coverage, Certificate, and ID Card fields</span></span></button>
    </section>

    <section class="pcf-filter-panel" aria-label="Policy custom field filters">
        <div class="pcf-search"><i class="bi bi-search" aria-hidden="true"></i><input type="search" placeholder="Search field code, name, entity, type, default value, or options..." aria-label="Search policy custom fields" value="@_searchTerm" @oninput="args => OnSearchInputValue(args.Value?.ToString())" /></div>
        <div class="pcf-filter-grid">
            <label><span>Entity</span><select class="form-select" @bind="_entityFilter" @bind:after="ApplyFilters"><option value="">All entities</option>@foreach (var entity in _entityTypes) { <option value="@entity">@entity</option> }</select></label>
            <label><span>Field Type</span><select class="form-select" @bind="_fieldTypeFilter" @bind:after="ApplyFilters"><option value="">All types</option>@foreach (var type in _fieldTypes) { <option value="@type">@type</option> }</select></label>
            <label><span>Sort</span><select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters"><option value="importance">Importance</option><option value="order">Sort order</option><option value="entity">Entity</option><option value="name">Name</option><option value="type">Field type</option><option value="created">Newest</option></select></label>
        </div>
        <button type="button" class="pcf-btn pcf-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
    </section>

    <nav class="pcf-tabs" aria-label="Policy custom field views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="pcf-tab @(_activeTab == tab.Key ? "pcf-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)"><i class="bi @tab.Icon" aria-hidden="true"></i><span>@tab.Label</span><strong>@TabCount(tab.Key)</strong></button>
        }
    </nav>

    <main class="pcf-dashboard">
        <section class="pcf-main-card">
            <div class="pcf-card-header">
                <div><span class="pcf-section-kicker">@ActiveViewTitle</span><h2>@FilteredFields.Count() custom fields</h2><p>Prioritized by enterprise importance: required capture, searchable data, entity scope, dropdown readiness, active state, and configuration completeness.</p></div>
                <div class="pcf-card-actions">
                    @if (_selectedIds.Count > 0)
                    {
                        <span class="pcf-sel-count">@_selectedIds.Count selected</span>
                        <button type="button" class="pcf-btn pcf-btn--ghost" @onclick="() => ConfirmBulkToggle(true)"><i class="bi bi-check-circle" aria-hidden="true"></i> Activate</button>
                        <button type="button" class="pcf-btn pcf-btn--ghost" @onclick="() => ConfirmBulkToggle(false)"><i class="bi bi-slash-circle" aria-hidden="true"></i> Deactivate</button>
                        <button type="button" class="pcf-btn pcf-btn--danger-ghost" @onclick="ConfirmBulkDelete"><i class="bi bi-trash3" aria-hidden="true"></i> Remove</button>
                    }
                    <button type="button" class="pcf-btn pcf-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="pcf-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="pcf-btn pcf-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="pcf-loading"><span class="pcf-spinner"></span> Loading policy custom fields...</div>
            }
            else if (!FilteredFields.Any())
            {
                <div class="pcf-empty"><i class="bi bi-input-cursor-text" aria-hidden="true"></i><strong>No custom fields found</strong><span>Adjust the active KPI, tab, search, or filters.</span></div>
            }
            else if (_activeTab == "entities")
            {
                <div class="pcf-group-grid">
                    @foreach (var group in EntityGroups)
                    {
                        <article class="pcf-group-card"><div class="pcf-group-icon"><i class="bi @EntityIcon(group.Name)" aria-hidden="true"></i></div><div class="pcf-group-meta"><h3>@group.Name</h3><p>@group.Count fields - @group.Active active - @group.Required required - @group.ReviewCount need review</p><div class="pcf-mini-bar"><span style="width:@group.Percent%"></span></div></div><button type="button" class="pcf-btn pcf-btn--ghost" @onclick="() => FilterByEntity(group.Name)">Open</button></article>
                    }
                </div>
            }
            else
            {
                <div class="pcf-table-wrap">
                    <table class="pcf-table">
                        <thead><tr><th class="pcf-check-col"><input type="checkbox" checked="@AllPageSelected" @onchange="args => ToggleSelectAllPage(args.Value is bool value && value)" aria-label="Select all custom fields on page" /></th><th>Importance</th><th>Field</th><th>Entity</th><th>Type</th><th>Rules</th><th>Status</th><th>Order</th><th class="pcf-actions-col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var field in PagedFields)
                            {
                                <tr class="@(_selected?.CustomFieldId == field.CustomFieldId ? "pcf-row pcf-row--selected" : "pcf-row")" @onclick="() => SelectRow(field)">
                                    <td class="pcf-check-col" @onclick:stopPropagation="true"><input type="checkbox" checked="@IsSelected(field)" @onchange="args => ToggleSelect(field, args.Value is bool value && value)" aria-label="Select custom field" /></td>
                                    <td><span class="pcf-risk-badge @ImportanceBadgeClass(field)">@ImportanceScore(field)</span></td>
                                    <td><div class="pcf-field-cell"><div class="pcf-avatar" style="@AvatarStyle(field.FieldName)" aria-hidden="true">@Initials(field.FieldName)</div><div class="pcf-field-meta"><button type="button" class="pcf-link-button" @onclick:stopPropagation="true" @onclick="() => OpenEdit(field)">@field.FieldName</button><small>@field.FieldCode</small></div></div></td>
                                    <td><span class="pcf-pill @EntityBadgeClass(field.EntityType)"><i class="bi @EntityIcon(field.EntityType)" aria-hidden="true"></i>@field.EntityType</span></td>
                                    <td><span class="pcf-pill @FieldTypeBadgeClass(field.FieldType)">@field.FieldType</span></td>
                                    <td><div class="pcf-rule-stack">@if (field.IsRequired) { <span class="pcf-rule pcf-rule--required">Required</span> } @if (field.IsSearchable) { <span class="pcf-rule pcf-rule--search">Searchable</span> } @if (NeedsReview(field)) { <span class="pcf-rule pcf-rule--review">Review</span> }</div></td>
                                    <td><span class="pcf-pill @(field.IsActive ? "pcf-pill--green" : "pcf-pill--neutral")">@(field.IsActive ? "Active" : "Inactive")</span></td>
                                    <td><span class="pcf-date">@field.SortOrder</span></td>
                                    <td class="pcf-actions-col" @onclick:stopPropagation="true"><button type="button" class="pcf-icon-btn" title="Edit custom field" @onclick="() => OpenEdit(field)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="pcf-icon-btn" title="@(field.IsActive ? "Deactivate custom field" : "Activate custom field")" @onclick="() => ConfirmToggle(field)"><i class="bi @(field.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i></button><button type="button" class="pcf-icon-btn pcf-icon-btn--danger" title="Delete custom field" @onclick="() => ConfirmDelete(field)"><i class="bi bi-trash3" aria-hidden="true"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="pcf-side-panel" aria-label="Policy custom field insights">
            <section class="pcf-panel-card">
                <span class="pcf-section-kicker">Selected field</span>
                @if (_selected is null)
                {
                    <div class="pcf-empty pcf-empty--compact"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a custom field</strong><span>Open details, recommendations, and quick actions.</span></div>
                }
                else
                {
                    <div class="pcf-selected__title"><div class="pcf-avatar pcf-avatar--lg" style="@AvatarStyle(_selected.FieldName)" aria-hidden="true">@Initials(_selected.FieldName)</div><div><h3>@_selected.FieldName</h3><span>@_selected.FieldCode - @_selected.EntityType</span></div></div>
                    <div class="pcf-score-card @ImportanceClass(_selected)"><span>Importance score</span><strong>@ImportanceScore(_selected)</strong><small>@RecommendedAction(_selected)</small></div>
                    <dl class="pcf-detail-list"><div><dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd></div><div><dt>Entity</dt><dd>@_selected.EntityType</dd></div><div><dt>Field type</dt><dd>@_selected.FieldType</dd></div><div><dt>Required</dt><dd>@(_selected.IsRequired ? "Yes" : "No")</dd></div><div><dt>Searchable</dt><dd>@(_selected.IsSearchable ? "Yes" : "No")</dd></div><div><dt>Created</dt><dd>@FormatDate(_selected.CreatedDateUtc)</dd></div></dl>
                    @if (!string.IsNullOrWhiteSpace(_selected.DefaultValue)) { <p class="pcf-description"><strong>Default:</strong> @_selected.DefaultValue</p> }
                    @if (!string.IsNullOrWhiteSpace(_selected.DropdownOptions)) { <p class="pcf-description"><strong>Options:</strong> @_selected.DropdownOptions</p> }
                    <div class="pcf-selected-actions"><button type="button" class="pcf-btn pcf-btn--primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="pcf-btn pcf-btn--ghost" @onclick="() => ConfirmToggle(_selected)"><i class="bi @(_selected.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i> @(_selected.IsActive ? "Deactivate" : "Activate")</button></div>
                }
            </section>
            <section class="pcf-panel-card"><span class="pcf-section-kicker">Enterprise insights</span><div class="pcf-insight-list"><div class="pcf-insight"><i class="bi bi-asterisk" aria-hidden="true"></i><div><strong>Required capture</strong><span>@RequiredInsight</span></div></div><div class="pcf-insight"><i class="bi bi-search" aria-hidden="true"></i><div><strong>Search coverage</strong><span>@SearchInsight</span></div></div><div class="pcf-insight"><i class="bi bi-list-check" aria-hidden="true"></i><div><strong>Dropdown readiness</strong><span>@DropdownInsight</span></div></div></div></section>
        </aside>
    </main>
</div>

@if (_showForm)
{
    <div class="pcf-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="custom-field-form-title">
        <div class="pcf-modal">
            <div class="pcf-modal__header"><i class="bi bi-input-cursor-text" aria-hidden="true"></i><span id="custom-field-form-title">@(_editId.HasValue ? "Edit Custom Field" : "Add Custom Field")</span><button type="button" class="pcf-icon-btn pcf-icon-btn--light ms-auto" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator />
                <div class="pcf-modal__body"><div class="pcf-form-grid">
                    <label class="pcf-field"><span>Field Code <em>*</em></span><InputText @bind-Value="_form.FieldCode" class="form-control" placeholder="e.g. ADDITIONAL_INTEREST" /></label>
                    <label class="pcf-field"><span>Field Name <em>*</em></span><InputText @bind-Value="_form.FieldName" class="form-control" placeholder="Additional Interest" /></label>
                    <label class="pcf-field"><span>Entity Type <em>*</em></span><InputSelect @bind-Value="_form.EntityType" class="form-select"><option value="">Select entity</option>@foreach (var entity in _entityTypes) { <option value="@entity">@entity</option> }</InputSelect></label>
                    <label class="pcf-field"><span>Field Type <em>*</em></span><InputSelect @bind-Value="_form.FieldType" class="form-select"><option value="">Select type</option>@foreach (var type in _fieldTypes) { <option value="@type">@type</option> }</InputSelect></label>
                    <label class="pcf-field"><span>Default Value</span><InputText @bind-Value="_form.DefaultValue" class="form-control" placeholder="Optional default" /></label>
                    <label class="pcf-field"><span>Sort Order</span><InputNumber @bind-Value="_form.SortOrder" class="form-control" /></label>
                    <label class="pcf-field pcf-field--wide"><span>Dropdown Options</span><InputTextArea @bind-Value="_form.DropdownOptions" class="form-control" rows="3" placeholder="Comma-separated options for Dropdown fields" /></label>
                    <label class="pcf-check-field"><InputCheckbox @bind-Value="_form.IsRequired" /><span>Required</span></label>
                    <label class="pcf-check-field"><InputCheckbox @bind-Value="_form.IsSearchable" /><span>Searchable</span></label>
                    @if (_editId.HasValue) { <label class="pcf-check-field"><InputCheckbox @bind-Value="_form.IsActive" /><span>Active</span></label> }
                </div></div>
                <div class="pcf-modal__footer"><button type="button" class="pcf-btn pcf-btn--ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="pcf-btn pcf-btn--primary" disabled="@_saving">@if (_saving) { <span class="pcf-spin-sm"></span> } @(_editId.HasValue ? "Save Changes" : "Create Field")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_confirmVisible)
{
    <div class="pcf-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="custom-field-confirm-title"><div class="pcf-confirm"><div class="pcf-confirm__body"><div class="pcf-confirm-icon pcf-confirm-icon--danger"><i class="bi @_confirmIcon" aria-hidden="true"></i></div><div><h3 id="custom-field-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div></div><div class="pcf-modal__footer"><button type="button" class="pcf-btn pcf-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button><button type="button" class="pcf-btn pcf-btn--danger" @onclick="ExecuteConfirmedAsync" disabled="@_saving">@if (_saving) { <span class="pcf-spin-sm"></span> } Confirm</button></div></div></div>
}

<div class="pcf-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="pcf-toast pcf-toast--@toast.Kind"><i class="bi @(toast.Kind == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    }
</div>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    Guid TenantId { get; set; }
    static readonly string[] _entityTypes = ["Policy", "Coverage", "Endorsement", "Certificate", "IDCard"];
    static readonly string[] _fieldTypes = ["Text", "Number", "Date", "Dropdown", "Checkbox"];
    readonly List<DashboardTab> _tabs = [new("all", "All", "bi-input-cursor-text"), new("active", "Active", "bi-check-circle"), new("required", "Required", "bi-asterisk"), new("searchable", "Searchable", "bi-search"), new("dropdown", "Dropdowns", "bi-list-check"), new("review", "Needs Review", "bi-exclamation-octagon"), new("entities", "Entities", "bi-diagram-3")];
    List<PolicyCustomFieldDto> _items = [];
    HashSet<Guid> _selectedIds = [];
    List<ToastItem> _toasts = [];
    PolicyCustomFieldDto? _selected;
    FieldFormModel _form = new();
    Func<Task>? _confirmAction;
    Guid? _editId;
    string _activeTab = "all";
    string _searchTerm = string.Empty;
    string _entityFilter = string.Empty;
    string _fieldTypeFilter = string.Empty;
    string _sortMode = "importance";
    string _confirmTitle = string.Empty;
    string _confirmMessage = string.Empty;
    string _confirmIcon = "bi-exclamation-triangle-fill";
    string? _loadError;
    bool _loading;
    bool _saving;
    bool _showForm;
    bool _confirmVisible;
    int _page = 1;
    const int PageSize = 12;

    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policy Config", null), new("Policy Custom Fields", null)); await LoadAsync(); }

    IEnumerable<PolicyCustomFieldDto> FilteredFields
    {
        get
        {
            IEnumerable<PolicyCustomFieldDto> query = _items;
            query = _activeTab switch { "active" => query.Where(x => x.IsActive), "required" => query.Where(x => x.IsRequired), "searchable" => query.Where(x => x.IsSearchable), "dropdown" => query.Where(IsDropdownField), "review" => query.Where(NeedsReview), _ => query };
            if (!string.IsNullOrWhiteSpace(_searchTerm)) query = query.Where(MatchesSearch);
            if (!string.IsNullOrWhiteSpace(_entityFilter)) query = query.Where(x => string.Equals(x.EntityType, _entityFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(_fieldTypeFilter)) query = query.Where(x => string.Equals(x.FieldType, _fieldTypeFilter, StringComparison.OrdinalIgnoreCase));
            return _sortMode switch { "order" => query.OrderBy(x => x.SortOrder).ThenBy(x => x.FieldName), "entity" => query.OrderBy(x => x.EntityType).ThenBy(x => x.SortOrder).ThenBy(x => x.FieldName), "name" => query.OrderBy(x => x.FieldName), "type" => query.OrderBy(x => x.FieldType).ThenBy(x => x.FieldName), "created" => query.OrderByDescending(x => x.CreatedDateUtc), _ => query.OrderByDescending(ImportanceScore).ThenBy(x => x.EntityType).ThenBy(x => x.SortOrder).ThenBy(x => x.FieldName) };
        }
    }

    List<PolicyCustomFieldDto> PagedFields => FilteredFields.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredFields.Count() / (double)PageSize));
    bool AllPageSelected => PagedFields.Count > 0 && PagedFields.All(IsSelected);
    bool HasFilters => !string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_entityFilter) || !string.IsNullOrWhiteSpace(_fieldTypeFilter) || _activeTab != "all" || _sortMode != "importance";
    string ActiveViewTitle => _tabs.FirstOrDefault(x => x.Key == _activeTab)?.Label ?? "All";
    string RequiredInsight => _items.Count == 0 ? "Create custom fields before enabling required policy data capture." : $"{_items.Count(x => x.IsRequired)} required fields enforce mandatory data collection.";
    string SearchInsight => _items.Count == 0 ? "No searchable custom fields are configured." : $"{_items.Count(x => x.IsSearchable)} fields are searchable for servicing and reporting.";
    string DropdownInsight => _items.Any(IsDropdownField) ? $"{_items.Count(x => IsDropdownField(x) && !string.IsNullOrWhiteSpace(x.DropdownOptions))} of {_items.Count(IsDropdownField)} dropdown fields include configured options." : "No dropdown fields are configured.";
    List<EntityGroupSummary> EntityGroups => _items.GroupBy(x => Safe(x.EntityType, "Unassigned")).Select(g => new EntityGroupSummary(g.Key, g.Count(), g.Count(x => x.IsActive), g.Count(x => x.IsRequired), g.Count(NeedsReview), _items.Count == 0 ? 0 : Math.Round(g.Count() * 100m / _items.Count, 0))).OrderByDescending(x => x.Count).ToList();

    async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchPolicyCustomFieldsAsync(TenantId, null, pageSize: 500); _items = result?.Items.ToList() ?? []; _selectedIds.RemoveWhere(id => _items.All(x => x.CustomFieldId != id)); _selected = _selected is null ? _items.OrderByDescending(ImportanceScore).FirstOrDefault() : _items.FirstOrDefault(x => x.CustomFieldId == _selected.CustomFieldId) ?? _items.OrderByDescending(ImportanceScore).FirstOrDefault(); NormalizePage(); } catch (Exception ex) { _loadError = $"Failed to load policy custom fields: {ex.Message}"; } finally { _loading = false; } }
    Task RefreshAsync() => LoadAsync();
    void ApplyFilters() { _page = 1; NormalizePage(); }
    void OnSearchInputValue(string? value) { _searchTerm = value ?? string.Empty; ApplyFilters(); }
    void SetDashboardFocus(string tab, string sort) { _activeTab = tab; _sortMode = sort; _page = 1; NormalizePage(); }
    void SetActiveTab(string tab) { _activeTab = tab; _page = 1; NormalizePage(); }
    void PreviousPage() { if (_page > 1) _page--; }
    void NextPage() { if (_page < TotalPages) _page++; }
    void NormalizePage() { if (_page > TotalPages) _page = TotalPages; }
    void SelectRow(PolicyCustomFieldDto item) => _selected = item;
