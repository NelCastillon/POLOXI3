@page "/tenant/policies/statuses"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.PolicyConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Policy Statuses — Policy Configuration</PageTitle>

<AppPageHeader Title="Policy Statuses" Subtitle="Define policy lifecycle statuses and default status behavior" Icon="bi-tags">
    <Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Status</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button></Actions>
</AppPageHeader>

<div class="pc-kpi-strip">
    <div class="pc-kpi-card @(_activeFilter == "" ? "pc-kpi-card--active" : "")" title="Show all statuses" @onclick='() => SetFilter("")' style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-tags" aria-hidden="true"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total Statuses</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "active" ? "pc-kpi-card--active" : "")" title="Filter active statuses" @onclick='() => SetFilter("active")' style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsActive)</div><div class="pc-kpi-label">Active</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "default" ? "pc-kpi-card--active" : "")" title="Filter default statuses" @onclick='() => SetFilter("default")' style="cursor:pointer"><span class="pc-kpi-icon" style="background:#fef9c3"><i class="bi bi-star-fill text-warning" aria-hidden="true"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsDefault)</div><div class="pc-kpi-label">Default</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "inactive" ? "pc-kpi-card--active" : "")" title="Filter inactive statuses" @onclick='() => SetFilter("inactive")' style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-slash-circle" aria-hidden="true"></i></span><div><div class="pc-kpi-value">@_items.Count(x => !x.IsActive)</div><div class="pc-kpi-label">Inactive</div></div></div>
</div>

@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div> }

<AppFilterPanel @bind-SearchValue="_search" OnSearch="OnSearchAsync" SearchPlaceholder="Search status name or code…" />

<div class="um-grid-card">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }
    <SfGrid TValue="PolicyStatusDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
        <GridEvents TValue="PolicyStatusDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" />
        <GridColumns>
            <GridColumn Field="StatusCode" HeaderText="Code" Width="130" />
            <GridColumn Field="StatusName" HeaderText="Status Name" Width="220" />
            <GridColumn Field="StatusType" HeaderText="Type" Width="130" />
            <GridColumn Field="ColorHex" HeaderText="Color" Width="90" TextAlign="TextAlign.Center"><Template>@{ var r = (PolicyStatusDto)context; }<span style="display:inline-block;width:18px;height:18px;border-radius:999px;background:@(string.IsNullOrWhiteSpace(r.ColorHex) ? "#cbd5e1" : r.ColorHex);border:1px solid #cbd5e1"></span></Template></GridColumn>
            <GridColumn Field="IsDefault" HeaderText="Default" Width="90" TextAlign="TextAlign.Center"><Template>@{ var r = (PolicyStatusDto)context; }@if (r.IsDefault) { <i class="bi bi-check2-circle text-success"></i> }</Template></GridColumn>
            <GridColumn Field="SortOrder" HeaderText="Order" Width="80" TextAlign="TextAlign.Center" />
            <GridColumn Field="IsActive" HeaderText="Status" Width="100" TextAlign="TextAlign.Center"><Template>@{ var r = (PolicyStatusDto)context; }<span class="um-badge @(r.IsActive ? "um-badge-success" : "um-badge-neutral")">@(r.IsActive ? "Active" : "Inactive")</span></Template></GridColumn>
            <GridColumn HeaderText="" Width="100" TextAlign="TextAlign.Center"><Template>@{ var r = (PolicyStatusDto)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEdit(r)"><i class="bi bi-pencil"></i></button><button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(r)"><i class="bi bi-trash"></i></button></Template></GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showForm" Width="560px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm" /><DialogContent><div class="um-modal-header"><i class="bi bi-tags" aria-hidden="true"></i><span>@(_editId.HasValue ? "Edit Policy Status" : "Add Policy Status")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Status Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.StatusCode" class="um-input" placeholder="e.g. ACTIVE" /><ValidationMessage For="() => _form.StatusCode" class="validation-message text-danger" /></div><div class="um-field"><label>Status Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.StatusName" class="um-input" /><ValidationMessage For="() => _form.StatusName" class="validation-message text-danger" /></div><div class="um-field"><label>Status Type</label><SfDropDownList TValue="string" TItem="string" @bind-Value="_form.StatusType" DataSource="@_statusTypes" Placeholder="Select type" /><ValidationMessage For="() => _form.StatusType" class="validation-message text-danger" /></div><div class="um-field"><label>Color Hex</label><InputText @bind-Value="_form.ColorHex" class="um-input" placeholder="#3b82f6" /><ValidationMessage For="() => _form.ColorHex" class="validation-message text-danger" /></div><div class="um-field"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="2" /><ValidationMessage For="() => _form.Description" class="validation-message text-danger" /></div><div class="um-field"><label>Sort Order</label><InputNumber @bind-Value="_form.SortOrder" class="um-input" /><ValidationMessage For="() => _form.SortOrder" class="validation-message text-danger" /></div><div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsDefault" /> Default</label></div><div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button></div></EditForm></DialogContent></SfDialog>

<SfDialog @bind-Visible="_showDelete" Width="420px" IsModal="true" ShowCloseIcon="false"><DialogContent><div class="um-confirm-dialog"><div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash3-fill"></i></div><div class="um-confirm-title">Delete Policy Status</div><div class="um-confirm-body">Are you sure you want to delete <strong>@_deleteTarget?.StatusName</strong>?</div><div class="um-modal-footer"><button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button><button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div></div></DialogContent></SfDialog>

<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true"><ToastPosition X="Right" Y="Bottom" /></SfToast>
<style>.validation-message{display:flex;align-items:center;gap:.45rem;margin-top:.55rem;color:#dc3545!important;font-size:.875rem;font-weight:700}.validation-message::before{content:"!";display:inline-flex;align-items:center;justify-content:center;width:1rem;height:1rem;min-width:1rem;flex-shrink:0;border-radius:999px;color:#fff;background:linear-gradient(135deg,#ef4444,#b91c1c);font-size:.7rem;font-weight:800}.um-input.modified.invalid{border-color:#dc3545!important;box-shadow:0 0 0 .18rem rgba(220,53,69,.14)!important}</style>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    Guid TenantId { get; set; }
    static readonly string[] _statusTypes = ["Active", "Pending", "Cancelled", "Expired", "Renewed"];
    List<PolicyStatusDto> _items = [];
    List<PolicyStatusDto> _filtered = [];
    string _activeFilter = "";
    bool _loading, _saving, _showForm, _showDelete;
    string _search = string.Empty;
    string? _loadError;
    Guid? _editId;
    PolicyStatusDto? _deleteTarget;
    SfToast _toast = default!;
    StatusFormModel _form = new();
    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policy Config", null), new("Policy Statuses", null)); await LoadAsync(); }
    async Task LoadAsync() { _loading = true; _loadError = null; try { var r = await Api.SearchPolicyStatusesAsync(TenantId, _search, pageSize: 200); _items = r?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = ex.Message; } finally { _loading = false; } }
    void SetFilter(string filter) { _activeFilter = filter; ApplyFilter(); }
    void ApplyFilter() => _filtered = _activeFilter switch { "active" => _items.Where(x => x.IsActive).ToList(), "inactive" => _items.Where(x => !x.IsActive).ToList(), "default" => _items.Where(x => x.IsDefault).ToList(), _ => [.. _items] };
    Task OnSearchAsync() => LoadAsync();
    void OnRowSelected(RowSelectEventArgs<PolicyStatusDto> args) => OpenEdit(args.Data);
    void OpenCreate() { _editId = null; _form = new(); _showForm = true; }
    void OpenEdit(PolicyStatusDto item) { _editId = item.PolicyStatusId; _form = new() { StatusCode = item.StatusCode, StatusName = item.StatusName, StatusType = item.StatusType, Description = item.Description, ColorHex = item.ColorHex, IsDefault = item.IsDefault, SortOrder = item.SortOrder, IsActive = item.IsActive }; _showForm = true; }
    async Task SaveAsync() { _saving = true; try { if (_editId.HasValue) await Api.UpdatePolicyStatusAsync(_editId.Value, new(_form.StatusCode, _form.StatusName, _form.StatusType, _form.Description, _form.ColorHex, _form.IsDefault, _form.IsActive, _form.SortOrder)); else await Api.CreatePolicyStatusAsync(new(TenantId, _form.StatusCode, _form.StatusName, _form.StatusType, _form.Description, _form.ColorHex, _form.IsDefault, _form.SortOrder)); _showForm = false; await _toast.ShowAsync(new() { Content = "Saved successfully", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } }
    void ConfirmDelete(PolicyStatusDto item) { _deleteTarget = item; _showDelete = true; }
    async Task ExecuteDeleteAsync() { _saving = true; try { await Api.DeletePolicyStatusAsync(_deleteTarget!.PolicyStatusId); _showDelete = false; await _toast.ShowAsync(new() { Content = "Deleted successfully", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } }
    void ResetForm() { _form = new(); _editId = null; }
    sealed class StatusFormModel { [Required, StringLength(50)] public string StatusCode { get; set; } = string.Empty; [Required, StringLength(100)] public string StatusName { get; set; } = string.Empty; [StringLength(50)] public string? StatusType { get; set; } [StringLength(500)] public string? Description { get; set; } [StringLength(20)] public string? ColorHex { get; set; } public bool IsDefault { get; set; } [Range(0, 9999)] public int SortOrder { get; set; } public bool IsActive { get; set; } = true; }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
