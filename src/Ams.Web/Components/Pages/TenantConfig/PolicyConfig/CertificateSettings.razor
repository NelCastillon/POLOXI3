@page "/tenant/policies/certs"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Certificate Command Center - Policy Configuration</PageTitle>

<div class="crt-page">
    <section class="crt-hero">
        <div class="crt-hero__content">
            <div class="crt-hero-left">
                <span class="crt-hero-icon"><i class="bi bi-patch-check" aria-hidden="true"></i></span>
                <div class="crt-hero-title">
                    <div class="crt-hero__eyebrow">Enterprise certificate configuration</div>
                    <div class="crt-title-row">
                        <h1>Certificate Command Center</h1>
                        <div class="crt-hero__meta">
                            <span><i class="bi bi-sliders" aria-hidden="true"></i>@_settings.Count settings</span>
                            <span><i class="bi bi-toggle-on" aria-hidden="true"></i>@_settings.Count(x => IsBoolean(x) && IsTrue(x.SettingValue)) enabled</span>
                            <span><i class="bi bi-send-check" aria-hidden="true"></i>@_settings.Count(IsDeliverySetting) delivery</span>
                            <span><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>@_settings.Count(NeedsReview) need review</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Govern certificate defaults, delivery options, template controls, compliance language, holder handling, and servicing readiness from one enterprise workspace.</p>
        </div>
        <div class="crt-hero__actions">
            <button type="button" class="crt-btn crt-btn--light" @onclick="RefreshAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "crt-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="crt-btn crt-btn--primary" @onclick="SaveDirtyAsync" disabled="@(!_dirtyValues.Any() || _saving)"><i class="bi bi-cloud-check" aria-hidden="true"></i> Save Changes</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger crt-alert" style="border-left: 4px solid #dc3545; animation: crt-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@_loadError</span></div>
    }

    <section class="crt-kpi-strip" aria-label="Certificate settings KPIs">
        @KpiCard("all", "Total Settings", _settings.Count.ToString(), "All certificate configuration controls", "bi-sliders", "blue")
        @KpiCard("enabled", "Enabled", _settings.Count(x => IsBoolean(x) && IsTrue(x.SettingValue)).ToString(), "Boolean settings currently enabled", "bi-toggle-on", "green")
        @KpiCard("delivery", "Delivery", _settings.Count(IsDeliverySetting).ToString(), "Certificate delivery and distribution controls", "bi-send-check", "cyan")
        @KpiCard("templates", "Templates", _settings.Count(IsTemplateSetting).ToString(), "Template, format, display, and branding controls", "bi-file-earmark-richtext", "purple")
        @KpiCard("compliance", "Compliance", _settings.Count(IsComplianceSetting).ToString(), "Legal, holder, coverage, and audit-sensitive controls", "bi-shield-check", "amber")
        @KpiCard("review", "Needs Review", _settings.Count(NeedsReview).ToString(), "Blank, disabled, or incomplete high-value settings", "bi-exclamation-octagon", "red")
    </section>

    <section class="crt-workflows" aria-label="Certificate workflows">
        <button type="button" class="crt-workflow" @onclick='() => SetDashboardFocus("all", "importance")'><span class="crt-workflow-icon"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></span><span class="crt-workflow-meta"><strong>Priority review</strong><span>Rank settings by enterprise impact and readiness</span></span></button>
        <button type="button" class="crt-workflow" @onclick='() => SetDashboardFocus("delivery", "importance")'><span class="crt-workflow-icon"><i class="bi bi-send-check" aria-hidden="true"></i></span><span class="crt-workflow-meta"><strong>Delivery readiness</strong><span>Review email, portal, download, and print defaults</span></span></button>
        <button type="button" class="crt-workflow" @onclick='() => SetDashboardFocus("templates", "importance")'><span class="crt-workflow-icon"><i class="bi bi-file-earmark-richtext" aria-hidden="true"></i></span><span class="crt-workflow-meta"><strong>Document design</strong><span>Control template, format, branding, and display settings</span></span></button>
        <button type="button" class="crt-workflow" @onclick='() => SetDashboardFocus("compliance", "importance")'><span class="crt-workflow-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span><span class="crt-workflow-meta"><strong>Compliance controls</strong><span>Focus holder, language, coverage, and audit-sensitive settings</span></span></button>
        <button type="button" class="crt-workflow" @onclick='() => SetDashboardFocus("groups", "category")'><span class="crt-workflow-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span><span class="crt-workflow-meta"><strong>Setting groups</strong><span>Compare delivery, template, compliance, and automation mix</span></span></button>
    </section>

    <section class="crt-filter-panel" aria-label="Certificate settings filters">
        <div class="crt-search"><i class="bi bi-search" aria-hidden="true"></i><input type="search" placeholder="Search setting key, value, type, category, or description..." aria-label="Search certificate settings" value="@_searchTerm" @oninput="args => OnSearchInputValue(args.Value?.ToString())" /></div>
        <div class="crt-filter-grid">
            <label><span>Category</span><select class="form-select" @bind="_categoryFilter" @bind:after="ApplyFilters"><option value="">All categories</option>@foreach (var category in CategoryOptions) { <option value="@category">@category</option> }</select></label>
            <label><span>Value Type</span><select class="form-select" @bind="_typeFilter" @bind:after="ApplyFilters"><option value="">All types</option>@foreach (var type in TypeOptions) { <option value="@type">@type</option> }</select></label>
            <label><span>Sort</span><select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters"><option value="importance">Importance</option><option value="category">Category</option><option value="key">Setting key</option><option value="type">Type</option><option value="created">Newest</option></select></label>
        </div>
        <button type="button" class="crt-btn crt-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
    </section>

    @if (_dirtyValues.Any())
    {
        <section class="crt-change-bar" aria-label="Pending certificate setting changes">
            <div><i class="bi bi-pencil-square" aria-hidden="true"></i><strong>@_dirtyValues.Count pending change(s)</strong><span>Review and save changes to sync certificate workflows.</span></div>
            <div class="crt-change-actions"><button type="button" class="crt-btn crt-btn--ghost" @onclick="DiscardDirtyChanges" disabled="@_saving">Discard</button><button type="button" class="crt-btn crt-btn--primary" @onclick="SaveDirtyAsync" disabled="@_saving">@if (_saving) { <span class="crt-spin-sm"></span> } Save All</button></div>
        </section>
    }

    <nav class="crt-tabs" aria-label="Certificate setting views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="crt-tab @(_activeTab == tab.Key ? "crt-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)"><i class="bi @tab.Icon" aria-hidden="true"></i><span>@tab.Label</span><strong>@TabCount(tab.Key)</strong></button>
        }
    </nav>

    <main class="crt-dashboard">
        <section class="crt-main-card">
            <div class="crt-card-header">
                <div><span class="crt-section-kicker">@ActiveViewTitle</span><h2>@FilteredSettings.Count() certificate settings</h2><p>Prioritized by certificate delivery impact, compliance sensitivity, template readiness, enabled state, and configuration completeness.</p></div>
                <div class="crt-card-actions">
                    <button type="button" class="crt-btn crt-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="crt-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="crt-btn crt-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="crt-loading"><span class="crt-spinner"></span> Loading certificate settings...</div>
            }
            else if (!FilteredSettings.Any())
            {
                <div class="crt-empty"><i class="bi bi-patch-check" aria-hidden="true"></i><strong>No certificate settings found</strong><span>Adjust the active KPI, tab, search, or filters.</span></div>
            }
            else if (_activeTab == "groups")
            {
                <div class="crt-group-grid">
                    @foreach (var group in CategoryGroups)
                    {
                        <article class="crt-group-card"><div class="crt-group-icon"><i class="bi @CategoryIcon(group.Name)" aria-hidden="true"></i></div><div class="crt-group-meta"><h3>@group.Name</h3><p>@group.Count settings - @group.Enabled enabled - @group.ReviewCount need review - @group.DirtyCount pending</p><div class="crt-mini-bar"><span style="width:@group.Percent%"></span></div></div><button type="button" class="crt-btn crt-btn--ghost" @onclick="() => FilterByCategory(group.Name)">Open</button></article>
                    }
                </div>
            }
            else
            {
                <div class="crt-table-wrap">
                    <table class="crt-table">
                        <thead><tr><th>Importance</th><th>Setting</th><th>Category</th><th>Value</th><th>Type</th><th>Readiness</th><th>Updated</th><th class="crt-actions-col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var setting in PagedSettings)
                            {
                                <tr class="@(_selected?.CertificateSettingId == setting.CertificateSettingId ? "crt-row crt-row--selected" : "crt-row")" @onclick="() => SelectRow(setting)">
                                    <td>@ImportanceBadge(setting)</td>
                                    <td><div class="crt-setting-cell"><div class="crt-avatar" style="@AvatarStyle(setting.SettingKey)" aria-hidden="true">@Initials(setting.SettingKey)</div><div class="crt-setting-meta"><button type="button" class="crt-link-button" @onclick:stopPropagation="true" @onclick="() => OpenEdit(setting)">@FormatKey(setting.SettingKey)</button><small>@setting.SettingKey</small></div></div></td>
                                    <td><span class="crt-pill @CategoryBadgeClass(setting)"><i class="bi @CategoryIcon(Category(setting))" aria-hidden="true"></i>@Category(setting)</span></td>
                                    <td @onclick:stopPropagation="true">@SettingValueEditor(setting)</td>
                                    <td><span class="crt-pill crt-pill--neutral">@Safe(setting.SettingType, "Text")</span></td>
                                    <td><span class="crt-pill @(NeedsReview(setting) ? "crt-pill--amber" : "crt-pill--green")">@(NeedsReview(setting) ? "Review" : "Ready")</span></td>
                                    <td><span class="crt-date">@FormatDate(setting.CreatedDateUtc)</span></td>
                                    <td class="crt-actions-col" @onclick:stopPropagation="true"><button type="button" class="crt-icon-btn" title="Edit certificate setting" @onclick="() => OpenEdit(setting)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="crt-icon-btn" title="Reset pending value" @onclick="() => ResetSetting(setting)" disabled="@(!IsDirty(setting))"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button><button type="button" class="crt-icon-btn crt-icon-btn--success" title="Save setting" @onclick="() => SaveSingleAsync(setting)" disabled="@(!IsDirty(setting) || _saving)"><i class="bi bi-cloud-check" aria-hidden="true"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="crt-side-panel" aria-label="Certificate insights">
            <section class="crt-panel-card">
                <span class="crt-section-kicker">Selected setting</span>
                @if (_selected is null)
                {
                    <div class="crt-empty crt-empty--compact"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a certificate setting</strong><span>Open details, recommendations, and quick actions.</span></div>
                }
                else
                {
                    <div class="crt-selected__title"><div class="crt-avatar crt-avatar--lg" style="@AvatarStyle(_selected.SettingKey)" aria-hidden="true">@Initials(_selected.SettingKey)</div><div><h3>@FormatKey(_selected.SettingKey)</h3><span>@_selected.SettingKey - @Category(_selected)</span></div></div>
                    <div class="crt-score-card @ImportanceClass(_selected)"><span>Importance score</span><strong>@ImportanceScore(_selected)</strong><small>@RecommendedAction(_selected)</small></div>
                    <dl class="crt-detail-list"><div><dt>Current value</dt><dd>@Safe(CurrentValue(_selected), "Blank")</dd></div><div><dt>Type</dt><dd>@Safe(_selected.SettingType, "Text")</dd></div><div><dt>Category</dt><dd>@Category(_selected)</dd></div><div><dt>Pending change</dt><dd>@(IsDirty(_selected) ? "Yes" : "No")</dd></div><div><dt>Created</dt><dd>@FormatDate(_selected.CreatedDateUtc)</dd></div></dl>
                    @if (!string.IsNullOrWhiteSpace(_selected.Description)) { <p class="crt-description">@_selected.Description</p> }
                    <div class="crt-selected-actions"><button type="button" class="crt-btn crt-btn--primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="crt-btn crt-btn--ghost" @onclick="() => SaveSingleAsync(_selected)" disabled="@(!IsDirty(_selected) || _saving)"><i class="bi bi-cloud-check" aria-hidden="true"></i> Save</button><button type="button" class="crt-btn crt-btn--ghost" @onclick="() => ResetSetting(_selected)" disabled="@(!IsDirty(_selected))"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset</button></div>
                }
            </section>
            <section class="crt-panel-card"><span class="crt-section-kicker">Enterprise insights</span><div class="crt-insight-list"><div class="crt-insight"><i class="bi bi-send-check" aria-hidden="true"></i><div><strong>Delivery readiness</strong><span>@DeliveryInsight</span></div></div><div class="crt-insight"><i class="bi bi-shield-check" aria-hidden="true"></i><div><strong>Compliance posture</strong><span>@ComplianceInsight</span></div></div><div class="crt-insight"><i class="bi bi-cloud-check" aria-hidden="true"></i><div><strong>Change control</strong><span>@ChangeInsight</span></div></div></div></section>
        </aside>
    </main>
</div>

@if (_showEditor && _editingSetting is not null)
{
    <div class="crt-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="certificate-form-title">
        <div class="crt-modal">
            <div class="crt-modal__header"><i class="bi bi-patch-check" aria-hidden="true"></i><span id="certificate-form-title">Edit Certificate Setting</span><button type="button" class="crt-icon-btn crt-icon-btn--light ms-auto" @onclick="CloseEditor" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="crt-modal__body">
                
                <div class="crt-form-grid">
                    <label class="crt-field"><span>Setting Key</span><input class="form-control" value="@_editingSetting.SettingKey" disabled /></label>
                    <label class="crt-field"><span>Category</span><input class="form-control" value="@Category(_editingSetting)" disabled /></label>
                    <label class="crt-field"><span>Type</span><input class="form-control" value="@Safe(_editingSetting.SettingType, "Text")" disabled /></label>
                    <label class="crt-field"><span>Value</span>@ModalValueEditor(_editingSetting)<span class="text-danger">@_editorError</span></label>
                    <label class="crt-field crt-field--wide"><span>Description</span><textarea class="form-control" rows="3" disabled>@_editingSetting.Description</textarea></label>
                </div>
            </div>
            <div class="crt-modal__footer"><button type="button" class="crt-btn crt-btn--ghost" @onclick="CloseEditor">Close</button><button type="button" class="crt-btn crt-btn--ghost" @onclick="() => ResetSetting(_editingSetting)" disabled="@(!IsDirty(_editingSetting))">Reset</button><button type="button" class="crt-btn crt-btn--primary" @onclick="() => SaveSingleAsync(_editingSetting)" disabled="@(!IsDirty(_editingSetting) || _saving)">@if (_saving) { <span class="crt-spin-sm"></span> } Save Setting</button></div>
        </div>
    </div>
}

@if (_confirmVisible)
{
    <div class="crt-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="certificate-confirm-title"><div class="crt-confirm"><div class="crt-confirm__body"><div class="crt-confirm-icon crt-confirm-icon--danger"><i class="bi @_confirmIcon" aria-hidden="true"></i></div><div><h3 id="certificate-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div></div><div class="crt-modal__footer"><button type="button" class="crt-btn crt-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button><button type="button" class="crt-btn crt-btn--danger" @onclick="ExecuteConfirmedAsync" disabled="@_saving">@if (_saving) { <span class="crt-spin-sm"></span> } Confirm</button></div></div></div>
}

<div class="crt-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="crt-toast crt-toast--@toast.Kind"><i class="bi @(toast.Kind == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    }
</div>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    Guid TenantId { get; set; }

    readonly List<DashboardTab> _tabs = [new("all", "All", "bi-sliders"), new("enabled", "Enabled", "bi-toggle-on"), new("delivery", "Delivery", "bi-send-check"), new("templates", "Templates", "bi-file-earmark-richtext"), new("compliance", "Compliance", "bi-shield-check"), new("review", "Needs Review", "bi-exclamation-octagon"), new("groups", "Groups", "bi-diagram-3")];
    readonly Dictionary<Guid, string?> _dirtyValues = [];
    readonly List<ToastItem> _toasts = [];
    List<CertificateSettingDto> _settings = [];
    CertificateSettingDto? _selected;
    CertificateSettingDto? _editingSetting;
    Func<Task>? _confirmAction;
    string _activeTab = "all";
    string _searchTerm = string.Empty;
    string _categoryFilter = string.Empty;
    string _typeFilter = string.Empty;
    string _sortMode = "importance";
    string _editorValue = string.Empty;
    string _editorError = string.Empty;
    string _confirmTitle = string.Empty;
    string _confirmMessage = string.Empty;
    string _confirmIcon = "bi-exclamation-triangle-fill";
    string? _loadError;
    bool _loading;
    bool _saving;
    bool _showEditor;
    bool _confirmVisible;
    int _page = 1;
    const int PageSize = 12;

    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policy Config", null), new("Certificate Settings", null)); await LoadAsync(); }

    IEnumerable<CertificateSettingDto> FilteredSettings
    {
        get
        {
            IEnumerable<CertificateSettingDto> query = _settings;
            query = _activeTab switch { "enabled" => query.Where(x => IsBoolean(x) && IsTrue(CurrentValue(x))), "delivery" => query.Where(IsDeliverySetting), "templates" => query.Where(IsTemplateSetting), "compliance" => query.Where(IsComplianceSetting), "review" => query.Where(NeedsReview), _ => query };
            if (!string.IsNullOrWhiteSpace(_searchTerm)) query = query.Where(MatchesSearch);
            if (!string.IsNullOrWhiteSpace(_categoryFilter)) query = query.Where(x => string.Equals(Category(x), _categoryFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(_typeFilter)) query = query.Where(x => string.Equals(Safe(x.SettingType, "Text"), _typeFilter, StringComparison.OrdinalIgnoreCase));
            return _sortMode switch { "category" => query.OrderBy(Category).ThenBy(x => x.SettingKey), "key" => query.OrderBy(x => x.SettingKey), "type" => query.OrderBy(x => Safe(x.SettingType, "Text")).ThenBy(x => x.SettingKey), "created" => query.OrderByDescending(x => x.CreatedDateUtc), _ => query.OrderByDescending(ImportanceScore).ThenBy(Category).ThenBy(x => x.SettingKey) };
        }
    }

    List<CertificateSettingDto> PagedSettings => FilteredSettings.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredSettings.Count() / (double)PageSize));
    bool HasFilters => !string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_categoryFilter) || !string.IsNullOrWhiteSpace(_typeFilter) || _activeTab != "all" || _sortMode != "importance";
    string ActiveViewTitle => _tabs.FirstOrDefault(x => x.Key == _activeTab)?.Label ?? "All";
    IEnumerable<string> CategoryOptions => CategoryGroups.Select(x => x.Name);
    IEnumerable<string> TypeOptions => _settings.Select(x => Safe(x.SettingType, "Text")).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);
    string DeliveryInsight => _settings.Any(IsDeliverySetting) ? $"{_settings.Count(IsDeliverySetting)} delivery settings control certificate distribution channels." : "No delivery settings were detected.";
    string ComplianceInsight => _settings.Any(IsComplianceSetting) ? $"{_settings.Count(IsComplianceSetting)} compliance-sensitive settings should be reviewed before production rollout." : "No compliance-sensitive settings were detected.";
    string ChangeInsight => _dirtyValues.Count == 0 ? "All certificate settings are synced with the current tenant configuration." : $"{_dirtyValues.Count} setting change(s) are pending save.";
    List<CategoryGroupSummary> CategoryGroups => _settings.GroupBy(Category).Select(g => new CategoryGroupSummary(g.Key, g.Count(), g.Count(x => IsBoolean(x) && IsTrue(CurrentValue(x))), g.Count(NeedsReview), g.Count(IsDirty), _settings.Count == 0 ? 0 : Math.Round(g.Count() * 100m / _settings.Count, 0))).OrderByDescending(x => x.Count).ToList();

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _settings = await Api.GetCertificateSettingsAsync(TenantId) ?? [];
            _dirtyValues.Clear();
            _selected = _selected is null ? _settings.OrderByDescending(ImportanceScore).FirstOrDefault() : _settings.FirstOrDefault(x => x.CertificateSettingId == _selected.CertificateSettingId) ?? _settings.OrderByDescending(ImportanceScore).FirstOrDefault();
            NormalizePage();
        }
        catch (Exception ex) { _loadError = $"Failed to load certificate settings: {ex.Message}"; }
        finally { _loading = false; }
    }

    Task RefreshAsync()
    {
        if (!_dirtyValues.Any()) return LoadAsync();
        OpenConfirm("Discard Pending Certificate Changes", "Refreshing will discard unsaved certificate setting changes. Continue?", "bi-arrow-clockwise", LoadAsync);
        return Task.CompletedTask;
    }

    void ApplyFilters() { _page = 1; NormalizePage(); }
    void OnSearchInputValue(string? value) { _searchTerm = value ?? string.Empty; ApplyFilters(); }
    void SetDashboardFocus(string tab, string sort) { _activeTab = tab; _sortMode = sort; _page = 1; NormalizePage(); }
    void SetActiveTab(string tab) { _activeTab = tab; _page = 1; NormalizePage(); }
    void PreviousPage() { if (_page > 1) _page--; }
    void NextPage() { if (_page < TotalPages) _page++; }
    void NormalizePage() { if (_page > TotalPages) _page = TotalPages; }
    void SelectRow(CertificateSettingDto item) => _selected = item;
    void ClearFilters() { _searchTerm = string.Empty; _categoryFilter = string.Empty; _typeFilter = string.Empty; _sortMode = "importance"; _activeTab = "all"; _page = 1; }
    void FilterByCategory(string category) { _activeTab = "all"; _categoryFilter = category; _sortMode = "importance"; _page = 1; }
    void OpenEdit(CertificateSettingDto setting) { _selected = setting; _editingSetting = setting; _editorValue = CurrentValue(setting) ?? string.Empty; _editorError = string.Empty; _showEditor = true; }
    void CloseEditor() { _showEditor = false; _editingSetting = null; _editorValue = string.Empty; _editorError = string.Empty; }

    void SetPendingValue(CertificateSettingDto setting, string? value)
    {
        if (string.Equals(setting.SettingValue, value, StringComparison.Ordinal)) _dirtyValues.Remove(setting.CertificateSettingId);
        else _dirtyValues[setting.CertificateSettingId] = value;
        if (_editingSetting?.CertificateSettingId == setting.CertificateSettingId) _editorValue = value ?? string.Empty;
    }

    void ResetSetting(CertificateSettingDto setting)
    {
        _dirtyValues.Remove(setting.CertificateSettingId);
        if (_editingSetting?.CertificateSettingId == setting.CertificateSettingId) _editorValue = setting.SettingValue ?? string.Empty;
    }

    void DiscardDirtyChanges()
    {
        if (!_dirtyValues.Any()) return;
        OpenConfirm("Discard Certificate Changes", $"Discard {_dirtyValues.Count} pending certificate setting change(s)?", "bi-arrow-counterclockwise", () => { _dirtyValues.Clear(); if (_editingSetting is not null) _editorValue = _editingSetting.SettingValue ?? string.Empty; ShowToast("success", "Pending certificate changes discarded."); return Task.CompletedTask; });
    }

    async Task SaveSingleAsync(CertificateSettingDto setting)
    {
        if (!IsDirty(setting)) return;
        _saving = true;
        try
        {
            var value = CurrentValue(setting);
            await Api.UpdateCertificateSettingAsync(setting.CertificateSettingId, new(value));
            setting.SettingValue = value;
            _dirtyValues.Remove(setting.CertificateSettingId);
            ShowToast("success", $"{FormatKey(setting.SettingKey)} updated.");
        }
        catch (Exception ex) { ShowToast("danger", $"Update failed: {ex.Message}"); }
        finally { _saving = false; }
    }

    async Task SaveDirtyAsync()
    {
        if (!_dirtyValues.Any()) return;
        _saving = true;
        var saved = 0;
        try
        {
            foreach (var pending in _dirtyValues.ToList())
            {
                var setting = _settings.FirstOrDefault(x => x.CertificateSettingId == pending.Key);
                if (setting is null) continue;
                try
                {
                    await Api.UpdateCertificateSettingAsync(setting.CertificateSettingId, new(pending.Value));
                    setting.SettingValue = pending.Value;
                    _dirtyValues.Remove(setting.CertificateSettingId);
                    saved++;
                }
                catch (Exception ex) { ShowToast("danger", $"Update failed for {FormatKey(setting.SettingKey)}: {ex.Message}"); }
            }
            if (saved > 0) ShowToast("success", $"{saved} certificate setting(s) saved.");
        }
        finally { _saving = false; }
    }

    void OpenConfirm(string title, string message, string icon, Func<Task> action) { _confirmTitle = title; _confirmMessage = message; _confirmIcon = icon; _confirmAction = action; _confirmVisible = true; }
    void CloseConfirm() { _confirmVisible = false; _confirmAction = null; }
    async Task ExecuteConfirmedAsync() { if (_confirmAction is null) return; _saving = true; try { await _confirmAction(); _confirmVisible = false; _confirmAction = null; } finally { _saving = false; } }

    RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string color) => @<button type="button" class="crt-kpi-card crt-kpi-card--@color @(_activeTab == key ? "crt-kpi-card--active" : null)" title="@subtitle" @onclick="() => SetActiveTab(key)"><span class="crt-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span><span class="crt-kpi-body"><span class="crt-kpi-label">@label</span><strong class="crt-kpi-value">@value</strong><span class="crt-kpi-sub">@subtitle</span></span></button>;
    RenderFragment SettingValueEditor(CertificateSettingDto setting) => @<div class="crt-value-editor @(IsDirty(setting) ? "crt-value-editor--dirty" : null)">@if (IsBoolean(setting)) { <label class="crt-switch"><input type="checkbox" checked="@IsTrue(CurrentValue(setting))" @onchange="args => SetPendingValue(setting, BoolStr(args.Value))" /><span></span></label> <small>@(IsTrue(CurrentValue(setting)) ? "Enabled" : "Disabled")</small> } else if (IsDeliverySetting(setting)) { <select class="form-select form-select-sm" value="@CurrentValue(setting)" @onchange="args => SetPendingValue(setting, args.Value?.ToString())"><option value="Email">Email</option><option value="Portal">Portal</option><option value="Download">Download</option><option value="Print">Print</option><option value="EmailAndPortal">Email + Portal</option></select> } else if (IsTemplateSetting(setting) && Contains(setting.SettingKey, "Format")) { <select class="form-select form-select-sm" value="@CurrentValue(setting)" @onchange="args => SetPendingValue(setting, args.Value?.ToString())"><option value="Standard">Standard</option><option value="Compact">Compact</option><option value="StateSpecific">State Specific</option><option value="CarrierTemplate">Carrier Template</option><option value="Custom">Custom</option></select> } else { <input class="form-control form-control-sm" value="@CurrentValue(setting)" @onchange="args => SetPendingValue(setting, args.Value?.ToString())" /> }</div>;
    RenderFragment ModalValueEditor(CertificateSettingDto setting) => @<div>@if (IsBoolean(setting)) { <label class="crt-switch crt-switch--modal"><input type="checkbox" checked="@IsTrue(_editorValue)" @onchange="args => SetPendingValue(setting, BoolStr(args.Value))" /><span></span><strong>@(IsTrue(_editorValue) ? "Enabled" : "Disabled")</strong></label> } else if (IsDeliverySetting(setting)) { <select class="form-select" value="@_editorValue" @onchange="args => SetPendingValue(setting, args.Value?.ToString())"><option value="Email">Email</option><option value="Portal">Portal</option><option value="Download">Download</option><option value="Print">Print</option><option value="EmailAndPortal">Email + Portal</option></select> } else { <input class="form-control" value="@_editorValue" @onchange="args => SetPendingValue(setting, args.Value?.ToString())" /> }</div>;

    int TabCount(string key) => key switch { "enabled" => _settings.Count(x => IsBoolean(x) && IsTrue(CurrentValue(x))), "delivery" => _settings.Count(IsDeliverySetting), "templates" => _settings.Count(IsTemplateSetting), "compliance" => _settings.Count(IsComplianceSetting), "review" => _settings.Count(NeedsReview), "groups" => CategoryGroups.Count, _ => _settings.Count };
    bool MatchesSearch(CertificateSettingDto item) { var term = _searchTerm.Trim(); return Contains(item.SettingKey, term) || Contains(item.SettingValue, term) || Contains(CurrentValue(item), term) || Contains(item.SettingType, term) || Contains(item.Description, term) || Contains(Category(item), term); }
    bool IsDirty(CertificateSettingDto item) => _dirtyValues.ContainsKey(item.CertificateSettingId);
    string? CurrentValue(CertificateSettingDto item) => _dirtyValues.TryGetValue(item.CertificateSettingId, out var value) ? value : item.SettingValue;
    static bool IsBoolean(CertificateSettingDto setting) => setting.SettingType?.Equals("Boolean", StringComparison.OrdinalIgnoreCase) == true;
    static bool IsTrue(string? value) => value?.Equals("true", StringComparison.OrdinalIgnoreCase) == true;
    static string BoolStr(object? val) => val?.ToString()?.Equals("true", StringComparison.OrdinalIgnoreCase) == true ? "true" : "false";
    static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string FormatDate(DateTime date) => date == default ? "-" : date.ToLocalTime().ToString("MMM d, yyyy");
    static string FormatKey(string key) => System.Text.RegularExpressions.Regex.Replace(key, "(?<=[a-z])(?=[A-Z])", " ");
    static bool IsDeliverySetting(CertificateSettingDto item) => Contains(item.SettingKey, "Delivery") || Contains(item.SettingKey, "Email") || Contains(item.SettingKey, "Portal") || Contains(item.SettingKey, "Download") || Contains(item.SettingKey, "Print") || Contains(item.Description, "delivery");
    static bool IsTemplateSetting(CertificateSettingDto item) => Contains(item.SettingKey, "Template") || Contains(item.SettingKey, "Format") || Contains(item.SettingKey, "Display") || Contains(item.SettingKey, "Logo") || Contains(item.SettingKey, "Brand") || Contains(item.Description, "template");
    static bool IsComplianceSetting(CertificateSettingDto item) => Contains(item.SettingKey, "Compliance") || Contains(item.SettingKey, "Holder") || Contains(item.SettingKey, "Coverage") || Contains(item.SettingKey, "Legal") || Contains(item.SettingKey, "Audit") || Contains(item.Description, "compliance") || Contains(item.Description, "holder");
    static bool IsAutomationSetting(CertificateSettingDto item) => Contains(item.SettingKey, "Auto") || Contains(item.SettingKey, "Default") || Contains(item.SettingKey, "Renewal") || Contains(item.Description, "automatic");
    static string Category(CertificateSettingDto item) { if (IsDeliverySetting(item)) return "Delivery"; if (IsTemplateSetting(item)) return "Template"; if (IsComplianceSetting(item)) return "Compliance"; if (IsAutomationSetting(item)) return "Automation"; if (Contains(item.SettingKey, "Security") || Contains(item.SettingKey, "Permission")) return "Security"; return "General"; }
    bool NeedsReview(CertificateSettingDto item) => string.IsNullOrWhiteSpace(CurrentValue(item)) || string.IsNullOrWhiteSpace(item.Description) || (IsBoolean(item) && !IsTrue(CurrentValue(item)) && (IsDeliverySetting(item) || IsComplianceSetting(item)));
    static string CategoryIcon(string category) => category switch { "Delivery" => "bi-send-check", "Template" => "bi-file-earmark-richtext", "Compliance" => "bi-shield-check", "Automation" => "bi-magic", "Security" => "bi-lock", _ => "bi-sliders" };
    static string CategoryBadgeClass(CertificateSettingDto item) => Category(item) switch { "Delivery" => "crt-pill--cyan", "Template" => "crt-pill--purple", "Compliance" => "crt-pill--amber", "Automation" => "crt-pill--green", "Security" => "crt-pill--red", _ => "crt-pill--blue" };
    int ImportanceScore(CertificateSettingDto item) { var score = 30; if (IsDeliverySetting(item)) score += 18; if (IsComplianceSetting(item)) score += 22; if (IsTemplateSetting(item)) score += 14; if (IsAutomationSetting(item)) score += 10; if (IsBoolean(item) && IsTrue(CurrentValue(item))) score += 8; if (IsDirty(item)) score += 12; if (string.IsNullOrWhiteSpace(CurrentValue(item))) score += 14; if (!string.IsNullOrWhiteSpace(item.Description)) score += 4; return Math.Clamp(score, 0, 100); }
    string RecommendedAction(CertificateSettingDto item) { if (IsDirty(item)) return "Save or discard the pending setting change."; if (string.IsNullOrWhiteSpace(CurrentValue(item))) return "Provide a value before relying on this certificate workflow."; if (IsBoolean(item) && !IsTrue(CurrentValue(item)) && IsDeliverySetting(item)) return "Review disabled delivery behavior before production use."; if (IsComplianceSetting(item)) return "Compliance-sensitive setting should be reviewed with certificate governance."; return "Setting is ready for certificate workflows."; }
    string ImportanceClass(CertificateSettingDto item) => ImportanceScore(item) switch { >= 80 => "crt-score-card--red", >= 65 => "crt-score-card--amber", >= 45 => "crt-score-card--cyan", _ => "crt-score-card--green" };
    MarkupString ImportanceBadge(CertificateSettingDto item) { var score = ImportanceScore(item); var css = score switch { >= 80 => "red", >= 65 => "amber", >= 45 => "cyan", _ => "green" }; return new($"<span class=\"crt-risk-badge crt-risk-badge--{css}\">{score}</span>"); }
    static string Initials(string? value) { var parts = FormatKey(value ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); return parts.Length switch { 0 => "CS", 1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(), _ => string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0]))) }; }
    static string AvatarStyle(string? value) { var hash = Math.Abs((value ?? "CertificateSetting").GetHashCode()); var hue = hash % 360; return $"background:linear-gradient(135deg,hsl({hue},78%,48%),hsl({(hue + 35) % 360},82%,36%));"; }
    void ShowToast(string kind, string message) { _toasts.Insert(0, new(Guid.NewGuid(), kind, message)); if (_toasts.Count > 4) _toasts.RemoveRange(4, _toasts.Count - 4); }
    void DismissToast(Guid id) => _toasts.RemoveAll(x => x.Id == id);
    async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); TenantId = context.TenantId; TenantAdminUserId = context.UserId; DevTenantId = context.TenantId; DevUserId = context.UserId; }
    sealed record DashboardTab(string Key, string Label, string Icon);
    sealed record CategoryGroupSummary(string Name, int Count, int Enabled, int ReviewCount, int DirtyCount, decimal Percent);
    sealed record ToastItem(Guid Id, string Kind, string Message);
