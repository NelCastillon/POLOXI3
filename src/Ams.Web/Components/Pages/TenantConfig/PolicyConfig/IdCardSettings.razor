@page "/tenant/policies/id-cards"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>ID Card Settings — Policy Configuration</PageTitle>

<AppPageHeader Title="ID Card Settings"
               Subtitle="Configure insurance ID card generation, delivery, and display defaults"
               Icon="bi-card-text">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
    </Actions>
</AppPageHeader>

<div class="pc-kpi-strip">
    <div class="pc-kpi-card" title="Total ID card settings">
        <span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-card-text" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_settings.Count</div><div class="pc-kpi-label">Total Settings</div></div>
    </div>
    <div class="pc-kpi-card" title="Boolean settings enabled">
        <span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-toggle-on" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_settings.Count(s => IsBoolean(s) && IsTrue(s.SettingValue))</div><div class="pc-kpi-label">Enabled</div></div>
    </div>
    <div class="pc-kpi-card" title="Boolean settings disabled">
        <span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-toggle-off" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_settings.Count(s => IsBoolean(s) && !IsTrue(s.SettingValue))</div><div class="pc-kpi-label">Disabled</div></div>
    </div>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

<div class="um-settings-container">
    @if (_loading)
    {
        <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var setting in _settings)
            {
                <div class="col-md-6">
                    <div class="um-settings-card">
                        <div class="um-settings-card__header">
                            <div>
                                <div class="fw-semibold">@FormatKey(setting.SettingKey)</div>
                                <div class="text-muted small">@setting.Description</div>
                            </div>
                        </div>
                        <div class="um-settings-card__body">
                            @if (IsBoolean(setting))
                            {
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox"
                                           checked="@IsTrue(setting.SettingValue)"
                                           @onchange="async e => await UpdateAsync(setting, BoolStr(e.Value))" />
                                    <label class="form-check-label">@(IsTrue(setting.SettingValue) ? "Enabled" : "Disabled")</label>
                                </div>
                            }
                            else if (setting.SettingKey.Contains("Format", StringComparison.OrdinalIgnoreCase))
                            {
                                <select class="um-input" value="@setting.SettingValue" @onchange="async e => await UpdateAsync(setting, e.Value?.ToString())">
                                    <option value="Standard">Standard</option>
                                    <option value="Compact">Compact</option>
                                    <option value="StateSpecific">State Specific</option>
                                    <option value="CarrierTemplate">Carrier Template</option>
                                </select>
                            }
                            else
                            {
                                <div class="d-flex gap-2">
                                    <input class="um-input flex-grow-1" value="@setting.SettingValue" @onchange="async e => await UpdateAsync(setting, e.Value?.ToString())" />
                                    <span class="text-muted align-self-center small">@setting.SettingType</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true"><ToastPosition X="Right" Y="Bottom" /></SfToast>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    Guid TenantId { get; set; }
    List<IdCardSettingDto> _settings = [];
    bool _loading;
    string? _loadError;
    SfToast _toast = default!;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policy Config", null), new("ID Card Settings", null));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try { _settings = await Api.GetIdCardSettingsAsync(TenantId) ?? []; }
        catch (Exception ex) { _loadError = ex.Message; }
        finally { _loading = false; }
    }

    async Task UpdateAsync(IdCardSettingDto setting, string? newValue)
    {
        var oldValue = setting.SettingValue;
        try
        {
            setting.SettingValue = newValue;
            await Api.UpdateIdCardSettingAsync(setting.IdCardSettingId, new(newValue));
            await _toast.ShowAsync(new() { Content = $"{FormatKey(setting.SettingKey)} updated", CssClass = "e-toast-success" });
        }
        catch (Exception ex)
        {
            setting.SettingValue = oldValue;
            await _toast.ShowAsync(new() { Content = $"Update failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    static bool IsBoolean(IdCardSettingDto setting) => setting.SettingType?.Equals("Boolean", StringComparison.OrdinalIgnoreCase) == true;
    static bool IsTrue(string? value) => value?.Equals("true", StringComparison.OrdinalIgnoreCase) == true;
    static string BoolStr(object? val) => val?.ToString()?.Equals("true", StringComparison.OrdinalIgnoreCase) == true ? "true" : "false";
    static string FormatKey(string key) => System.Text.RegularExpressions.Regex.Replace(key, "(?<=[a-z])(?=[A-Z])", " ");

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
