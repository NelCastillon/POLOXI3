@page "/tenant/carriers/mgas"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.CarrierConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>MGA / Wholesalers — Carrier Configuration</PageTitle>
<AppPageHeader Title="MGAs / Wholesalers" Subtitle="Manage managing general agencies and wholesale market partners" Icon="bi-shop"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> Add MGA</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<div class="pc-kpi-strip"><div class="pc-kpi-card @(_activeFilter == "" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("")' title="Show all MGAs / wholesalers" style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-shop"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total Types</div></div></div><div class="pc-kpi-card @(_activeFilter == "active" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("active")' title="Filter active types" style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsActive)</div><div class="pc-kpi-label">Active</div></div></div><div class="pc-kpi-card @(_activeFilter == "inactive" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("inactive")' title="Filter inactive types" style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-slash-circle"></i></span><div><div class="pc-kpi-value">@_items.Count(x => !x.IsActive)</div><div class="pc-kpi-label">Inactive</div></div></div></div>
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div> }
<AppFilterPanel @bind-SearchValue="_search" OnSearch="OnSearchAsync" SearchPlaceholder="Search endorsement type…" />
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }<SfGrid TValue="MgaWholesalerDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52"><GridEvents TValue="MgaWholesalerDto" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" /><GridColumns><GridColumn Field="MgaCode" HeaderText="Code" Width="130" /><GridColumn Field="MgaName" HeaderText="MGA Name" Width="220" /><GridColumn Field="Type" HeaderText="Type" Width="130" /><GridColumn Field="Website" HeaderText="Website" Width="240" /><GridColumn Field="SortOrder" HeaderText="Order" Width="80" TextAlign="TextAlign.Center" /><GridColumn Field="IsActive" HeaderText="Status" Width="100" TextAlign="TextAlign.Center"><Template>@{ var r = (MgaWholesalerDto)context; }<span class="um-badge @(r.IsActive ? "um-badge-success" : "um-badge-neutral")">@(r.IsActive ? "Active" : "Inactive")</span></Template></GridColumn><GridColumn HeaderText="" Width="100" TextAlign="TextAlign.Center"><Template>@{ var r = (MgaWholesalerDto)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEdit(r)"><i class="bi bi-shopcil"></i></button><button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(r)"><i class="bi bi-trash"></i></button></Template></GridColumn></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="520px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm" /><DialogContent><div class="um-modal-header"><i class="bi bi-shop"></i><span>@(_editId.HasValue ? "Edit MGA / Wholesaler" : "Add MGA / Wholesaler")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>MGA Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.MgaCode" class="um-input" placeholder="e.g. ADD_VEHICLE" /><ValidationMessage For="() => _form.MgaCode" class="validation-message text-danger" /></div><div class="um-field"><label>MGA Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.MgaName" class="um-input" /><ValidationMessage For="() => _form.MgaName" class="validation-message text-danger" /></div><div class="um-field"><label>Type</label><SfDropDownList TValue="string" TItem="string" @bind-Value="_form.Type" DataSource="@(new[]{"MGA","Wholesaler","Program Administrator"})" Placeholder="Select type" /><ValidationMessage For="() => _form.Type" class="validation-message text-danger" /></div><div class="um-field"><label>Website</label><InputText @bind-Value="_form.Website" class="um-input" /><ValidationMessage For="() => _form.Website" class="validation-message text-danger" /></div><div class="um-field"><label>Sort Order</label><InputNumber @bind-Value="_form.SortOrder" class="um-input" /><ValidationMessage For="() => _form.SortOrder" class="validation-message text-danger" /></div><div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button></div></EditForm></DialogContent></SfDialog>
<SfDialog @bind-Visible="_showDelete" Width="420px" IsModal="true" ShowCloseIcon="false"><DialogContent><div class="um-confirm-dialog"><div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash3-fill"></i></div><div class="um-confirm-title">Delete MGA / Wholesaler</div><div class="um-confirm-body">Are you sure you want to delete <strong>@_deleteTarget?.MgaName</strong>?</div><div class="um-modal-footer"><button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button><button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div></div></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true"><ToastPosition X="Right" Y="Bottom" /></SfToast><style>.validation-message{display:flex;align-items:center;gap:.45rem;margin-top:.55rem;color:#dc3545!important;font-size:.875rem;font-weight:700}.validation-message::before{content:"!";display:inline-flex;align-items:center;justify-content:center;width:1rem;height:1rem;min-width:1rem;flex-shrink:0;border-radius:999px;color:#fff;background:linear-gradient(135deg,#ef4444,#b91c1c);font-size:.7rem;font-weight:800}.um-input.modified.invalid{border-color:#dc3545!important;box-shadow:0 0 0 .18rem rgba(220,53,69,.14)!important}</style>
@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId; Guid TenantId { get; set; } List<MgaWholesalerDto> _items=[]; List<MgaWholesalerDto> _filtered=[]; string _activeFilter=""; bool _loading,_saving,_showForm,_showDelete; string _search=string.Empty; string? _loadError; Guid? _editId; MgaWholesalerDto? _deleteTarget; SfToast _toast=default!; MgaFormModel _form=new(); protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();Breadcrumbs.SetCrumbs(new("Home","/"),new("Carrier Config",null),new("MGA / Wholesalers",null)); await LoadAsync();} async Task LoadAsync(){_loading=true;_loadError=null;try{var r=await Api.SearchMgaWholesalersAsync(TenantId,_search,pageSize:200);_items=r?.Items.ToList()??[];ApplyFilter();}catch(Exception ex){_loadError=ex.Message;}finally{_loading=false;}} void SetFilter(string f){_activeFilter=f;ApplyFilter();} void ApplyFilter()=>_filtered=_activeFilter switch{"active"=>_items.Where(x=>x.IsActive).ToList(),"inactive"=>_items.Where(x=>!x.IsActive).ToList(),_=>[.._items]}; Task OnSearchAsync()=>LoadAsync(); void OnRowSelected(RowSelectEventArgs<MgaWholesalerDto> args)=>OpenEdit(args.Data); void OpenCreate(){_editId=null;_form=new();_showForm=true;} void OpenEdit(MgaWholesalerDto item){_editId=item.MgaWholesalerId;_form=new(){MgaCode=item.MgaCode,MgaName=item.MgaName,Type=item.Type,Website=item.Website,SortOrder=item.SortOrder,IsActive=item.IsActive};_showForm=true;} async Task SaveAsync(){_saving=true;try{if(_editId.HasValue)await Api.UpdateMgaWholesalerAsync(_editId.Value,new(_form.MgaCode,_form.MgaName,_form.Type,_form.Website,_form.IsActive,_form.SortOrder));else await Api.CreateMgaWholesalerAsync(new(TenantId,_form.MgaCode,_form.MgaName,_form.Type,_form.Website,_form.SortOrder));_showForm=false;await _toast.ShowAsync(new(){Content="Saved successfully",CssClass="e-toast-success"});await LoadAsync();}catch(Exception ex){await _toast.ShowAsync(new(){Content=$"Save failed: {ex.Message}",CssClass="e-toast-danger"});}finally{_saving=false;}} void ConfirmDelete(MgaWholesalerDto item){_deleteTarget=item;_showDelete=true;} async Task ExecuteDeleteAsync(){_saving=true;try{await Api.DeleteMgaWholesalerAsync(_deleteTarget!.MgaWholesalerId);_showDelete=false;await _toast.ShowAsync(new(){Content="Deleted successfully",CssClass="e-toast-success"});await LoadAsync();}catch(Exception ex){await _toast.ShowAsync(new(){Content=$"Delete failed: {ex.Message}",CssClass="e-toast-danger"});}finally{_saving=false;}} void ResetForm(){_form=new();_editId=null;} sealed class MgaFormModel{[Required,StringLength(50)]public string MgaCode{get;set;}=string.Empty;[Required,StringLength(100)]public string MgaName{get;set;}=string.Empty;[StringLength(80)]public string? Type{get;set;}[StringLength(300)]public string? Website{get;set;}[Range(0,9999)]public int SortOrder{get;set;}public bool IsActive{get;set;}=true;} 
    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}

