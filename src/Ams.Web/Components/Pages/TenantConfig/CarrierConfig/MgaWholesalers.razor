@page "/tenant/carriers/mgas"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.CarrierConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>MGA / Wholesaler Command Center - Carrier Configuration</PageTitle>

<div class="mga-page">
    <section class="mga-hero">
        <div class="mga-hero__content">
            <div class="mga-hero-left">
                <span class="mga-hero-icon"><i class="bi bi-shop" aria-hidden="true"></i></span>
                <div class="mga-hero-title">
                    <div class="mga-hero__eyebrow">Enterprise wholesale market access</div>
                    <div class="mga-title-row">
                        <h1>MGA / Wholesaler Command Center</h1>
                        <div class="mga-hero__meta">
                            <span><i class="bi bi-shop" aria-hidden="true"></i>@_items.Count partners</span>
                            <span><i class="bi bi-check-circle" aria-hidden="true"></i>@_items.Count(x => x.IsActive) active</span>
                            <span><i class="bi bi-diagram-3" aria-hidden="true"></i>@TypeGroups.Count types</span>
                            <span><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>@_items.Count(NeedsReview) need review</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Govern MGA, wholesaler, and program administrator partners for specialty market access, submission routing, partner readiness, website availability, and carrier distribution workflows.</p>
        </div>
        <div class="mga-hero__actions">
            <button type="button" class="mga-btn mga-btn--light" @onclick="RefreshAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "mga-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="mga-btn mga-btn--primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Partner</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger mga-alert" style="border-left: 4px solid #dc3545; animation: mga-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@_loadError</span></div>
    }

    <section class="mga-kpi-strip" aria-label="MGA and wholesaler KPIs">
        @KpiCard("all", "Total Partners", _items.Count.ToString(), "All configured MGA and wholesale partners", "bi-shop", "blue")
        @KpiCard("active", "Active", _items.Count(x => x.IsActive).ToString(), "Partners available for market workflows", "bi-check-circle", "green")
        @KpiCard("mga", "MGAs", _items.Count(IsMga).ToString(), "Managing general agency partners", "bi-building-check", "cyan")
        @KpiCard("wholesaler", "Wholesalers", _items.Count(IsWholesaler).ToString(), "Wholesale broker market access", "bi-globe-americas", "purple")
        @KpiCard("webready", "Web Ready", _items.Count(HasWebsite).ToString(), "Partners with websites configured", "bi-link-45deg", "amber")
        @KpiCard("review", "Needs Review", _items.Count(NeedsReview).ToString(), "Inactive, untyped, missing website, or incomplete partners", "bi-exclamation-octagon", "red")
    </section>

    <section class="mga-workflows" aria-label="MGA workflows">
        <button type="button" class="mga-workflow" @onclick='() => SetDashboardFocus("all", "importance")'><span class="mga-workflow-icon"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></span><span class="mga-workflow-meta"><strong>Priority review</strong><span>Rank partners by market value and readiness</span></span></button>
        <button type="button" class="mga-workflow" @onclick='() => SetDashboardFocus("mga", "importance")'><span class="mga-workflow-icon"><i class="bi bi-building-check" aria-hidden="true"></i></span><span class="mga-workflow-meta"><strong>MGA markets</strong><span>Focus delegated authority and specialty underwriting access</span></span></button>
        <button type="button" class="mga-workflow" @onclick='() => SetDashboardFocus("wholesaler", "importance")'><span class="mga-workflow-icon"><i class="bi bi-globe-americas" aria-hidden="true"></i></span><span class="mga-workflow-meta"><strong>Wholesale access</strong><span>Review wholesale broker and E&S market partners</span></span></button>
        <button type="button" class="mga-workflow" @onclick='() => SetDashboardFocus("review", "importance")'><span class="mga-workflow-icon"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i></span><span class="mga-workflow-meta"><strong>Cleanup queue</strong><span>Resolve inactive, incomplete, and missing website partners</span></span></button>
        <button type="button" class="mga-workflow" @onclick='() => SetDashboardFocus("types", "type")'><span class="mga-workflow-icon"><i class="bi bi-pie-chart" aria-hidden="true"></i></span><span class="mga-workflow-meta"><strong>Partner mix</strong><span>Compare MGA, wholesaler, and program administrator groups</span></span></button>
    </section>

    <section class="mga-filter-panel" aria-label="MGA and wholesaler filters">
        <div class="mga-search"><i class="bi bi-search" aria-hidden="true"></i><input type="search" placeholder="Search code, name, type, website, or readiness..." aria-label="Search MGA and wholesaler partners" value="@_searchTerm" @oninput="args => OnSearchInputValue(args.Value?.ToString())" /></div>
        <div class="mga-filter-grid">
            <label><span>Partner Type</span><select class="form-select" @bind="_typeFilter" @bind:after="ApplyFilters"><option value="">All types</option>@foreach (var type in TypeOptions) { <option value="@type">@type</option> }</select></label>
            <label><span>Status</span><select class="form-select" @bind="_statusFilter" @bind:after="ApplyFilters"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option><option value="WebReady">Web ready</option><option value="NeedsReview">Needs review</option></select></label>
            <label><span>Sort</span><select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters"><option value="importance">Importance</option><option value="order">Sort order</option><option value="name">Name</option><option value="code">Code</option><option value="type">Partner type</option><option value="created">Newest</option></select></label>
        </div>
        <button type="button" class="mga-btn mga-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
    </section>

    <nav class="mga-tabs" aria-label="MGA partner views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="mga-tab @(_activeTab == tab.Key ? "mga-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)"><i class="bi @tab.Icon" aria-hidden="true"></i><span>@tab.Label</span><strong>@TabCount(tab.Key)</strong></button>
        }
    </nav>

    <main class="mga-dashboard">
        <section class="mga-main-card">
            <div class="mga-card-header">
                <div><span class="mga-section-kicker">@ActiveViewTitle</span><h2>@FilteredPartners.Count() partners</h2><p>Prioritized by enterprise importance: active market availability, partner type, web readiness, sort precedence, specialty access value, and configuration completeness.</p></div>
                <div class="mga-card-actions">
                    @if (_selectedIds.Count > 0)
                    {
                        <span class="mga-sel-count">@_selectedIds.Count selected</span>
                        <button type="button" class="mga-btn mga-btn--ghost" @onclick="() => ConfirmBulkToggle(true)"><i class="bi bi-check-circle" aria-hidden="true"></i> Activate</button>
                        <button type="button" class="mga-btn mga-btn--ghost" @onclick="() => ConfirmBulkToggle(false)"><i class="bi bi-slash-circle" aria-hidden="true"></i> Deactivate</button>
                        <button type="button" class="mga-btn mga-btn--danger-ghost" @onclick="ConfirmBulkDelete"><i class="bi bi-trash3" aria-hidden="true"></i> Remove</button>
                    }
                    <button type="button" class="mga-btn mga-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="mga-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="mga-btn mga-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="mga-loading"><span class="mga-spinner"></span> Loading MGA and wholesaler partners...</div>
            }
            else if (!FilteredPartners.Any())
            {
                <div class="mga-empty"><i class="bi bi-shop" aria-hidden="true"></i><strong>No MGA / wholesaler partners found</strong><span>Adjust the active KPI, tab, search, or filters.</span></div>
            }
            else if (_activeTab == "types")
            {
                <div class="mga-group-grid">
                    @foreach (var group in TypeGroups)
                    {
                        <article class="mga-group-card"><div class="mga-group-icon"><i class="bi @PartnerTypeIcon(group.Name)" aria-hidden="true"></i></div><div class="mga-group-meta"><h3>@group.Name</h3><p>@group.Count partners - @group.Active active - @group.WebReady web ready - @group.ReviewCount need review</p><div class="mga-mini-bar"><span style="width:@group.Percent%"></span></div></div><button type="button" class="mga-btn mga-btn--ghost" @onclick="() => FilterByType(group.Name)">Open</button></article>
                    }
                </div>
            }
            else
            {
                <div class="mga-table-wrap">
                    <table class="mga-table">
                        <thead><tr><th class="mga-check-col"><input type="checkbox" checked="@AllPageSelected" @onchange="args => ToggleSelectAllPage(args.Value is bool value && value)" aria-label="Select all partners on page" /></th><th>Importance</th><th>Partner</th><th>Type</th><th>Website</th><th>Status</th><th>Readiness</th><th>Order</th><th class="mga-actions-col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var partner in PagedPartners)
                            {
                                <tr class="@(_selected?.MgaWholesalerId == partner.MgaWholesalerId ? "mga-row mga-row--selected" : "mga-row")" @onclick="() => SelectRow(partner)">
                                    <td class="mga-check-col" @onclick:stopPropagation="true"><input type="checkbox" checked="@IsSelected(partner)" @onchange="args => ToggleSelect(partner, args.Value is bool value && value)" aria-label="Select partner" /></td>
                                    <td><span class="mga-risk-badge @ImportanceBadgeClass(partner)">@ImportanceScore(partner)</span></td>
                                    <td><div class="mga-partner-cell"><div class="mga-avatar" style="@AvatarStyle(partner.MgaName)" aria-hidden="true">@Initials(partner.MgaName)</div><div class="mga-partner-meta"><button type="button" class="mga-link-button" @onclick:stopPropagation="true" @onclick="() => OpenEdit(partner)">@partner.MgaName</button><small>@Safe(partner.MgaCode, "No code")</small></div></div></td>
                                    <td><span class="mga-pill @PartnerTypeBadgeClass(partner)"><i class="bi @PartnerTypeIcon(PartnerType(partner))" aria-hidden="true"></i>@PartnerType(partner)</span></td>
                                    <td>@if (HasWebsite(partner)) { <a class="mga-link" href="@WebsiteUrl(partner.Website)" target="_blank" rel="noopener" @onclick:stopPropagation="true"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open</a> } else { <span class="mga-date">Missing</span> }</td>
                                    <td><span class="mga-pill @(partner.IsActive ? "mga-pill--green" : "mga-pill--neutral")">@(partner.IsActive ? "Active" : "Inactive")</span></td>
                                    <td><span class="mga-pill @(NeedsReview(partner) ? "mga-pill--amber" : "mga-pill--green")">@(NeedsReview(partner) ? "Review" : "Ready")</span></td>
                                    <td><span class="mga-date">@partner.SortOrder</span></td>
                                    <td class="mga-actions-col" @onclick:stopPropagation="true"><button type="button" class="mga-icon-btn" title="Edit partner" @onclick="() => OpenEdit(partner)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="mga-icon-btn" title="@(partner.IsActive ? "Deactivate partner" : "Activate partner")" @onclick="() => ConfirmToggle(partner)"><i class="bi @(partner.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i></button><button type="button" class="mga-icon-btn mga-icon-btn--danger" title="Delete partner" @onclick="() => ConfirmDelete(partner)"><i class="bi bi-trash3" aria-hidden="true"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="mga-side-panel" aria-label="MGA insights">
            <section class="mga-panel-card">
                <span class="mga-section-kicker">Selected partner</span>
                @if (_selected is null)
                {
                    <div class="mga-empty mga-empty--compact"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a partner</strong><span>Open details, recommendations, and quick actions.</span></div>
                }
                else
                {
                    <div class="mga-selected__title"><div class="mga-avatar mga-avatar--lg" style="@AvatarStyle(_selected.MgaName)" aria-hidden="true">@Initials(_selected.MgaName)</div><div><h3>@_selected.MgaName</h3><span>@Safe(_selected.MgaCode, "No code") - @PartnerType(_selected)</span></div></div>
                    <div class="mga-score-card @ImportanceClass(_selected)"><span>Importance score</span><strong>@ImportanceScore(_selected)</strong><small>@RecommendedAction(_selected)</small></div>
                    <dl class="mga-detail-list"><div><dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd></div><div><dt>Type</dt><dd>@PartnerType(_selected)</dd></div><div><dt>Website</dt><dd>@(HasWebsite(_selected) ? "Configured" : "Missing")</dd></div><div><dt>Sort order</dt><dd>@_selected.SortOrder</dd></div><div><dt>Created</dt><dd>@FormatDate(_selected.CreatedDateUtc)</dd></div></dl>
                    <div class="mga-selected-actions"><button type="button" class="mga-btn mga-btn--primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="mga-btn mga-btn--ghost" @onclick="() => ConfirmToggle(_selected)"><i class="bi @(_selected.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i> @(_selected.IsActive ? "Deactivate" : "Activate")</button></div>
                }
            </section>
            <section class="mga-panel-card"><span class="mga-section-kicker">Enterprise insights</span><div class="mga-insight-list"><div class="mga-insight"><i class="bi bi-building-check" aria-hidden="true"></i><div><strong>MGA access</strong><span>@MgaInsight</span></div></div><div class="mga-insight"><i class="bi bi-globe-americas" aria-hidden="true"></i><div><strong>Wholesale access</strong><span>@WholesaleInsight</span></div></div><div class="mga-insight"><i class="bi bi-link-45deg" aria-hidden="true"></i><div><strong>Web readiness</strong><span>@WebsiteInsight</span></div></div></div></section>
        </aside>
    </main>
</div>

@if (_showForm)
{
    <div class="mga-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="mga-form-title">
        <div class="mga-modal">
            <div class="mga-modal__header"><i class="bi bi-shop" aria-hidden="true"></i><span id="mga-form-title">@(_editId.HasValue ? "Edit MGA / Wholesaler" : "Add MGA / Wholesaler")</span><button type="button" class="mga-icon-btn mga-icon-btn--light ms-auto" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator />
                <div class="mga-modal__body"><div class="mga-validation-note"><i class="bi bi-info-circle" aria-hidden="true"></i><div><strong>Wholesale partner governance</strong><span>Partner configuration drives specialty market access, submission routing, and downstream carrier placement workflows.</span></div></div><div class="mga-form-grid">
                    <label class="mga-field"><span>MGA Code <em>*</em></span><InputText @bind-Value="_form.MgaCode" class="form-control" placeholder="e.g. RT_SPECIALTY" /><ValidationMessage For="() => _form.MgaCode" class="text-danger" /></label>
                    <label class="mga-field"><span>MGA Name <em>*</em></span><InputText @bind-Value="_form.MgaName" class="form-control" placeholder="Partner name" /><ValidationMessage For="() => _form.MgaName" class="text-danger" /></label>
                    <label class="mga-field"><span>Type</span><InputSelect @bind-Value="_form.Type" class="form-select"><option value="">Select type</option>@foreach (var type in _partnerTypes) { <option value="@type">@type</option> }</InputSelect><ValidationMessage For="() => _form.Type" class="text-danger" /></label>
                    <label class="mga-field"><span>Website</span><InputText @bind-Value="_form.Website" class="form-control" placeholder="https://partner.example.com" /><ValidationMessage For="() => _form.Website" class="text-danger" /></label>
                    <label class="mga-field"><span>Sort Order</span><InputNumber @bind-Value="_form.SortOrder" class="form-control" /><ValidationMessage For="() => _form.SortOrder" class="text-danger" /></label>
                    @if (_editId.HasValue) { <label class="mga-check-field"><InputCheckbox @bind-Value="_form.IsActive" /><span>Active</span></label> }
                </div></div>
                <div class="mga-modal__footer"><button type="button" class="mga-btn mga-btn--ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="mga-btn mga-btn--primary" disabled="@_saving">@if (_saving) { <span class="mga-spin-sm"></span> } @(_editId.HasValue ? "Save Changes" : "Create Partner")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_confirmVisible)
{
    <div class="mga-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="mga-confirm-title"><div class="mga-confirm"><div class="mga-confirm__body"><div class="mga-confirm-icon mga-confirm-icon--danger"><i class="bi @_confirmIcon" aria-hidden="true"></i></div><div><h3 id="mga-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div></div><div class="mga-modal__footer"><button type="button" class="mga-btn mga-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button><button type="button" class="mga-btn mga-btn--danger" @onclick="ExecuteConfirmedAsync" disabled="@_saving">@if (_saving) { <span class="mga-spin-sm"></span> } Confirm</button></div></div></div>
}

<div class="mga-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="mga-toast mga-toast--@toast.Kind"><i class="bi @(toast.Kind == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    }
</div>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    Guid TenantId { get; set; }
    static readonly string[] _partnerTypes = ["MGA", "Wholesaler", "Program Administrator"];
    readonly List<DashboardTab> _tabs = [new("all", "All", "bi-shop"), new("active", "Active", "bi-check-circle"), new("mga", "MGAs", "bi-building-check"), new("wholesaler", "Wholesalers", "bi-globe-americas"), new("webready", "Web Ready", "bi-link-45deg"), new("review", "Needs Review", "bi-exclamation-octagon"), new("types", "Types", "bi-pie-chart")];
    List<MgaWholesalerDto> _items = [];
    HashSet<Guid> _selectedIds = [];
    List<ToastItem> _toasts = [];
    MgaWholesalerDto? _selected;
    MgaFormModel _form = new();
    Func<Task>? _confirmAction;
    Guid? _editId;
    string _activeTab = "all";
    string _searchTerm = string.Empty;
    string _typeFilter = string.Empty;
    string _statusFilter = string.Empty;
    string _sortMode = "importance";
    string _confirmTitle = string.Empty;
    string _confirmMessage = string.Empty;
    string _confirmIcon = "bi-exclamation-triangle-fill";
    string? _loadError;
    bool _loading;
    bool _saving;
    bool _showForm;
    bool _confirmVisible;
    int _page = 1;
    const int PageSize = 12;

    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Carrier Config", null), new("MGA / Wholesalers", null)); await LoadAsync(); }

    IEnumerable<MgaWholesalerDto> FilteredPartners
    {
        get
        {
            IEnumerable<MgaWholesalerDto> query = _items;
            query = _activeTab switch { "active" => query.Where(x => x.IsActive), "mga" => query.Where(IsMga), "wholesaler" => query.Where(IsWholesaler), "webready" => query.Where(HasWebsite), "review" => query.Where(NeedsReview), _ => query };
            if (!string.IsNullOrWhiteSpace(_searchTerm)) query = query.Where(MatchesSearch);
            if (!string.IsNullOrWhiteSpace(_typeFilter)) query = query.Where(x => string.Equals(PartnerType(x), _typeFilter, StringComparison.OrdinalIgnoreCase));
            query = _statusFilter switch { "Active" => query.Where(x => x.IsActive), "Inactive" => query.Where(x => !x.IsActive), "WebReady" => query.Where(HasWebsite), "NeedsReview" => query.Where(NeedsReview), _ => query };
            return _sortMode switch { "order" => query.OrderBy(x => x.SortOrder).ThenBy(x => x.MgaName), "name" => query.OrderBy(x => x.MgaName), "code" => query.OrderBy(x => x.MgaCode), "type" => query.OrderBy(PartnerType).ThenBy(x => x.SortOrder).ThenBy(x => x.MgaName), "created" => query.OrderByDescending(x => x.CreatedDateUtc), _ => query.OrderByDescending(ImportanceScore).ThenBy(x => x.SortOrder).ThenBy(x => x.MgaName) };
        }
    }

    List<MgaWholesalerDto> PagedPartners => FilteredPartners.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredPartners.Count() / (double)PageSize));
    bool AllPageSelected => PagedPartners.Count > 0 && PagedPartners.All(IsSelected);
    bool HasFilters => !string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_typeFilter) || !string.IsNullOrWhiteSpace(_statusFilter) || _activeTab != "all" || _sortMode != "importance";
    string ActiveViewTitle => _tabs.FirstOrDefault(x => x.Key == _activeTab)?.Label ?? "All";
    IEnumerable<string> TypeOptions => TypeGroups.Select(x => x.Name);
    string MgaInsight => _items.Any(IsMga) ? $"{_items.Count(IsMga)} MGA partners support delegated underwriting and specialty access." : "No MGA partners were detected.";
    string WholesaleInsight => _items.Any(IsWholesaler) ? $"{_items.Count(IsWholesaler)} wholesale partners support E&S and specialty market access." : "No wholesaler partners were detected.";
    string WebsiteInsight => _items.Count == 0 ? "Create partners before configuring website readiness." : $"{_items.Count(HasWebsite)} of {_items.Count} partners include websites.";
    List<TypeGroupSummary> TypeGroups => _items.GroupBy(PartnerType).Select(g => new TypeGroupSummary(g.Key, g.Count(), g.Count(x => x.IsActive), g.Count(HasWebsite), g.Count(NeedsReview), _items.Count == 0 ? 0 : Math.Round(g.Count() * 100m / _items.Count, 0))).OrderByDescending(x => x.Count).ToList();

    async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchMgaWholesalersAsync(TenantId, null, pageSize: 500); _items = result?.Items.ToList() ?? []; _selectedIds.RemoveWhere(id => _items.All(x => x.MgaWholesalerId != id)); _selected = _selected is null ? _items.OrderByDescending(ImportanceScore).FirstOrDefault() : _items.FirstOrDefault(x => x.MgaWholesalerId == _selected.MgaWholesalerId) ?? _items.OrderByDescending(ImportanceScore).FirstOrDefault(); NormalizePage(); } catch (Exception ex) { _loadError = $"Failed to load MGA / wholesaler partners: {ex.Message}"; } finally { _loading = false; } }
    Task RefreshAsync() => LoadAsync();
    void ApplyFilters() { _page = 1; NormalizePage(); }
    void OnSearchInputValue(string? value) { _searchTerm = value ?? string.Empty; ApplyFilters(); }
    void SetDashboardFocus(string tab, string sort) { _activeTab = tab; _sortMode = sort; _page = 1; NormalizePage(); }
    void SetActiveTab(string tab) { _activeTab = tab; _page = 1; NormalizePage(); }
    void PreviousPage() { if (_page > 1) _page--; }
    void NextPage() { if (_page < TotalPages) _page++; }
    void NormalizePage() { if (_page > TotalPages) _page = TotalPages; }
    void SelectRow(MgaWholesalerDto item) => _selected = item;
    bool IsSelected(MgaWholesalerDto item) => _selectedIds.Contains(item.MgaWholesalerId);
    void ToggleSelect(MgaWholesalerDto item, bool selected) { if (selected) _selectedIds.Add(item.MgaWholesalerId); else _selectedIds.Remove(item.MgaWholesalerId); _selected = item; }
    void ToggleSelectAllPage(bool selected) { foreach (var item in PagedPartners) { if (selected) _selectedIds.Add(item.MgaWholesalerId); else _selectedIds.Remove(item.MgaWholesalerId); } }
    void ClearFilters() { _searchTerm = string.Empty; _typeFilter = string.Empty; _statusFilter = string.Empty; _sortMode = "importance"; _activeTab = "all"; _page = 1; }
    void FilterByType(string type) { _activeTab = "all"; _typeFilter = type; _sortMode = "importance"; _page = 1; }
    void OpenCreate() { _editId = null; _form = new() { Type = "MGA", IsActive = true, SortOrder = NextSortOrder() }; _showForm = true; }
    void OpenEdit(MgaWholesalerDto item) { _selected = item; _editId = item.MgaWholesalerId; _form = new() { MgaCode = item.MgaCode, MgaName = item.MgaName, Type = item.Type, Website = item.Website, SortOrder = item.SortOrder, IsActive = item.IsActive }; _showForm = true; }
    void CloseForm() { _showForm = false; ResetForm(); }
    void ResetForm() { _form = new(); _editId = null; }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue) await Api.UpdateMgaWholesalerAsync(_editId.Value, new(_form.MgaCode.Trim(), _form.MgaName.Trim(), NormalizeNullable(_form.Type), NormalizeNullable(_form.Website), _form.IsActive, _form.SortOrder));
            else await Api.CreateMgaWholesalerAsync(new(TenantId, _form.MgaCode.Trim(), _form.MgaName.Trim(), NormalizeNullable(_form.Type), NormalizeNullable(_form.Website), _form.SortOrder));
            _showForm = false; ShowToast("success", _editId.HasValue ? "MGA / wholesaler partner updated successfully." : "MGA / wholesaler partner created successfully."); ResetForm(); await LoadAsync();
        }
        catch (Exception ex) { ShowToast("danger", $"Save failed: {ex.Message}"); }
        finally { _saving = false; }
    }

    void ConfirmToggle(MgaWholesalerDto item) { var enable = !item.IsActive; OpenConfirm(enable ? "Activate Partner" : "Deactivate Partner", $"Are you sure you want to {(enable ? "activate" : "deactivate")} {item.MgaName}? This changes availability in market workflows.", "bi-shield-exclamation", () => SetPartnerActiveAsync(item, enable)); }
    void ConfirmDelete(MgaWholesalerDto item) => OpenConfirm("Delete Partner", $"Are you sure you want to delete {item.MgaName}? This action cannot be undone.", "bi-trash3-fill", () => DeletePartnerAsync(item));
    void ConfirmBulkToggle(bool enable) => OpenConfirm(enable ? "Activate Selected Partners" : "Deactivate Selected Partners", $"Are you sure you want to {(enable ? "activate" : "deactivate")} {_selectedIds.Count} selected partner(s)?", "bi-shield-exclamation", () => BulkSetActiveAsync(enable));
    void ConfirmBulkDelete() => OpenConfirm("Delete Selected Partners", $"Are you sure you want to delete {_selectedIds.Count} selected partner(s)? This action cannot be undone.", "bi-trash3-fill", BulkDeleteAsync);
    void OpenConfirm(string title, string message, string icon, Func<Task> action) { _confirmTitle = title; _confirmMessage = message; _confirmIcon = icon; _confirmAction = action; _confirmVisible = true; }
    void CloseConfirm() { _confirmVisible = false; _confirmAction = null; }
    async Task ExecuteConfirmedAsync() { if (_confirmAction is null) return; _saving = true; try { await _confirmAction(); _confirmVisible = false; _confirmAction = null; } finally { _saving = false; } }
    async Task SetPartnerActiveAsync(MgaWholesalerDto item, bool active) { try { await Api.UpdateMgaWholesalerAsync(item.MgaWholesalerId, new(item.MgaCode, item.MgaName, item.Type, item.Website, active, item.SortOrder)); ShowToast("success", active ? "Partner activated." : "Partner deactivated."); await LoadAsync(); } catch (Exception ex) { ShowToast("danger", $"Update failed: {ex.Message}"); } }
    async Task DeletePartnerAsync(MgaWholesalerDto item) { try { await Api.DeleteMgaWholesalerAsync(item.MgaWholesalerId); _selectedIds.Remove(item.MgaWholesalerId); if (_selected?.MgaWholesalerId == item.MgaWholesalerId) _selected = null; ShowToast("success", "Partner deleted."); await LoadAsync(); } catch (Exception ex) { ShowToast("danger", $"Delete failed: {ex.Message}"); } }
    async Task BulkSetActiveAsync(bool active) { var selected = _items.Where(x => _selectedIds.Contains(x.MgaWholesalerId)).ToList(); var updated = 0; foreach (var item in selected) { try { await Api.UpdateMgaWholesalerAsync(item.MgaWholesalerId, new(item.MgaCode, item.MgaName, item.Type, item.Website, active, item.SortOrder)); updated++; } catch (Exception ex) { ShowToast("danger", $"Update failed for {item.MgaName}: {ex.Message}"); } } ShowToast("success", $"{updated} partner(s) {(active ? "activated" : "deactivated")}. "); _selectedIds.Clear(); await LoadAsync(); }
    async Task BulkDeleteAsync() { var selected = _items.Where(x => _selectedIds.Contains(x.MgaWholesalerId)).ToList(); var deleted = 0; foreach (var item in selected) { try { await Api.DeleteMgaWholesalerAsync(item.MgaWholesalerId); deleted++; } catch (Exception ex) { ShowToast("danger", $"Delete failed for {item.MgaName}: {ex.Message}"); } } ShowToast("success", $"{deleted} partner(s) deleted."); _selectedIds.Clear(); _selected = null; await LoadAsync(); }

    RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string color) => @<button type="button" class="mga-kpi-card mga-kpi-card--@color @(_activeTab == key ? "mga-kpi-card--active" : null)" title="@subtitle" @onclick="() => SetActiveTab(key)"><span class="mga-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span><span class="mga-kpi-body"><span class="mga-kpi-label">@label</span><strong class="mga-kpi-value">@value</strong><span class="mga-kpi-sub">@subtitle</span></span></button>;
    int TabCount(string key) => key switch { "active" => _items.Count(x => x.IsActive), "mga" => _items.Count(IsMga), "wholesaler" => _items.Count(IsWholesaler), "webready" => _items.Count(HasWebsite), "review" => _items.Count(NeedsReview), "types" => TypeGroups.Count, _ => _items.Count };
    bool MatchesSearch(MgaWholesalerDto item) { var term = _searchTerm.Trim(); return Contains(item.MgaCode, term) || Contains(item.MgaName, term) || Contains(item.Type, term) || Contains(item.Website, term) || Contains(PartnerType(item), term); }
    static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string? NormalizeNullable(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    static string FormatDate(DateTime date) => date == default ? "-" : date.ToLocalTime().ToString("MMM d, yyyy");
    static string PartnerType(MgaWholesalerDto item) => Safe(item.Type, "Unclassified");
    static bool IsMga(MgaWholesalerDto item) => Contains(item.Type, "MGA") || Contains(item.MgaName, "MGA") || Contains(item.MgaName, "General Agency");
    static bool IsWholesaler(MgaWholesalerDto item) => Contains(item.Type, "Wholesaler") || Contains(item.MgaName, "Wholesale") || Contains(item.MgaName, "Broker");
    static bool HasWebsite(MgaWholesalerDto item) => !string.IsNullOrWhiteSpace(item.Website);
    static bool NeedsReview(MgaWholesalerDto item) => !item.IsActive || string.IsNullOrWhiteSpace(item.MgaCode) || string.IsNullOrWhiteSpace(item.MgaName) || string.IsNullOrWhiteSpace(item.Type) || !HasWebsite(item);
    static string WebsiteUrl(string? website) => string.IsNullOrWhiteSpace(website) ? "#" : website.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? website : $"https://{website}";
    static string PartnerTypeIcon(string type) => type switch { "MGA" => "bi-building-check", "Wholesaler" => "bi-globe-americas", "Program Administrator" => "bi-kanban", "Unclassified" => "bi-question-circle", _ => "bi-shop" };
    static string PartnerTypeBadgeClass(MgaWholesalerDto item) => PartnerType(item) switch { "MGA" => "mga-pill--cyan", "Wholesaler" => "mga-pill--purple", "Program Administrator" => "mga-pill--amber", _ => "mga-pill--blue" };
    static int ImportanceScore(MgaWholesalerDto item) { var score = 30; if (item.IsActive) score += 14; else score += 18; if (IsMga(item)) score += 18; if (IsWholesaler(item)) score += 14; if (Contains(item.Type, "Program")) score += 12; if (HasWebsite(item)) score += 10; else score += 10; if (item.SortOrder <= 10) score += 6; if (!string.IsNullOrWhiteSpace(item.Type)) score += 6; return Math.Clamp(score, 0, 100); }
    static string RecommendedAction(MgaWholesalerDto item) { if (!item.IsActive) return "Review whether this partner should remain inactive."; if (string.IsNullOrWhiteSpace(item.Type)) return "Assign a partner type for market routing and reporting."; if (!HasWebsite(item)) return "Add a website to improve submission and market access readiness."; if (IsMga(item)) return "MGA partner is ready for delegated authority and specialty workflows."; if (IsWholesaler(item)) return "Wholesaler partner is ready for E&S market access workflows."; return "Partner configuration is ready for market workflows."; }
    static string ImportanceClass(MgaWholesalerDto item) => ImportanceScore(item) switch { >= 80 => "mga-score-card--red", >= 65 => "mga-score-card--amber", >= 45 => "mga-score-card--cyan", _ => "mga-score-card--green" };
    static string ImportanceBadgeClass(MgaWholesalerDto item) => ImportanceScore(item) switch { >= 80 => "mga-risk-badge--red", >= 65 => "mga-risk-badge--amber", >= 45 => "mga-risk-badge--cyan", _ => "mga-risk-badge--green" };
    static string Initials(string? value) { var parts = (value ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); return parts.Length switch { 0 => "MG", 1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(), _ => string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0]))) }; }
    static string AvatarStyle(string? value) { var hash = Math.Abs((value ?? "MgaPartner").GetHashCode()); var hue = hash % 360; return $"background:linear-gradient(135deg,hsl({hue},78%,48%),hsl({(hue + 35) % 360},82%,36%));"; }
    int NextSortOrder() => _items.Count == 0 ? 10 : _items.Max(x => x.SortOrder) + 10;
    void ShowToast(string kind, string message) { _toasts.Insert(0, new(Guid.NewGuid(), kind, message)); if (_toasts.Count > 4) _toasts.RemoveRange(4, _toasts.Count - 4); }
    void DismissToast(Guid id) => _toasts.RemoveAll(x => x.Id == id);
    async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); TenantId = context.TenantId; TenantAdminUserId = context.UserId; DevTenantId = context.TenantId; DevUserId = context.UserId; }
    sealed class MgaFormModel { [Required, StringLength(50)] public string MgaCode { get; set; } = string.Empty; [Required, StringLength(100)] public string MgaName { get; set; } = string.Empty; [StringLength(80)] public string? Type { get; set; } [StringLength(300)] public string? Website { get; set; } [Range(0, 9999)] public int SortOrder { get; set; } public bool IsActive { get; set; } = true; }
    sealed record DashboardTab(string Key, string Label, string Icon);
    sealed record TypeGroupSummary(string Name, int Count, int Active, int WebReady, int ReviewCount, decimal Percent);
    sealed record ToastItem(Guid Id, string Kind, string Message);
}
