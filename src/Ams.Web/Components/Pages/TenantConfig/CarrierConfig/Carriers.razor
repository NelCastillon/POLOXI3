@page "/tenant/carriers"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.Carriers
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Carriers â€” Carrier Configuration</PageTitle>
<AppPageHeader Title="Carriers" Subtitle="Manage appointed carriers, NAIC codes, AM Best ratings, and admitted status" Icon="bi-shield-check"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> Add Carrier</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<div class="pc-kpi-strip"><div class="pc-kpi-card @(_activeFilter==""?"pc-kpi-card--active":"")" title="Show all carriers" @onclick='()=>SetFilter("")' style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-shield-check"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total Carriers</div></div></div><div class="pc-kpi-card @(_activeFilter=="admitted"?"pc-kpi-card--active":"")" title="Filter admitted carriers" @onclick='()=>SetFilter("admitted")' style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x=>x.IsAdmitted)</div><div class="pc-kpi-label">Admitted</div></div></div><div class="pc-kpi-card @(_activeFilter=="nonadmitted"?"pc-kpi-card--active":"")" title="Filter non-admitted carriers" @onclick='()=>SetFilter("nonadmitted")' style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-slash-circle"></i></span><div><div class="pc-kpi-value">@_items.Count(x=>!x.IsAdmitted)</div><div class="pc-kpi-label">Non-Admitted</div></div></div><div class="pc-kpi-card @(_activeFilter=="arated"?"pc-kpi-card--active":"")" title="Filter A-rated carriers" @onclick='()=>SetFilter("arated")' style="cursor:pointer"><span class="pc-kpi-icon" style="background:#fef9c3"><i class="bi bi-star-fill text-warning"></i></span><div><div class="pc-kpi-value">@_items.Count(x=>x.AmBestRating.StartsWith("A"))</div><div class="pc-kpi-label">A-Rated</div></div></div></div>
@if(_loadError is not null){<div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div>}
<AppFilterPanel @bind-SearchValue="_search" OnSearch="OnSearchAsync" SearchPlaceholder="Search carrier name or NAIC..." />
<div class="um-grid-card">@if(_loading){<div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading...</span></div>}<SfGrid TValue="CarrierDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52"><GridEvents TValue="CarrierDto" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" /><GridColumns><GridColumn Field="CarrierName" HeaderText="Carrier" Width="240" /><GridColumn Field="NaicCode" HeaderText="NAIC" Width="110" /><GridColumn Field="AmBestRating" HeaderText="AM Best" Width="110" /><GridColumn Field="IsAdmitted" HeaderText="Type" Width="130"><Template>@{var r=(CarrierDto)context;}<span class="um-badge @(r.IsAdmitted?"um-badge-info":"um-badge-neutral")">@(r.IsAdmitted?"Admitted":"Non-Admitted")</span></Template></GridColumn><GridColumn Field="AppointmentDate" HeaderText="Appointed" Width="130" Format="d" /><GridColumn Field="IsActive" HeaderText="Status" Width="100" TextAlign="TextAlign.Center"><Template>@{var r=(CarrierDto)context;}<span class="um-badge @(r.IsActive?"um-badge-success":"um-badge-neutral")">@(r.IsActive?"Active":"Inactive")</span></Template></GridColumn><GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Center"><Template>@{var r=(CarrierDto)context;}<button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="()=>OpenEdit(r)"><i class="bi bi-pencil"></i></button></Template></GridColumn></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="560px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm"/><DialogContent><div class="um-modal-header"><i class="bi bi-shield-check"></i><span>@(_editId.HasValue?"Edit Carrier":"Add Carrier")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="()=>_showForm=false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator/><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Carrier Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.CarrierName" class="um-input"/></div><div class="um-field"><label>NAIC Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.NaicCode" class="um-input"/></div><div class="um-field"><label>AM Best Rating</label><SfDropDownList TValue="string" TItem="string" @bind-Value="_form.AmBestRating" DataSource="@_ratings"/></div><div class="um-field"><label>Appointment Date</label><InputDate @bind-Value="_form.AppointmentDate" class="um-input"/></div><div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsAdmitted"/> Admitted</label></div><div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsActive"/> Active</label></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="()=>_showForm=false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue?"Save Changes":"Create")</button></div></EditForm></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true"><ToastPosition X="Right" Y="Bottom"/></SfToast><style>.validation-message{display:flex;align-items:center;gap:.45rem;margin-top:.55rem;color:#dc3545!important;font-size:.875rem;font-weight:700}.validation-message::before{content:"!";display:inline-flex;align-items:center;justify-content:center;width:1rem;height:1rem;min-width:1rem;flex-shrink:0;border-radius:999px;color:#fff;background:linear-gradient(135deg,#ef4444,#b91c1c);font-size:.7rem;font-weight:800}</style>
@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;Guid TenantId { get; set; }static readonly string[] _ratings=["A++","A+","A","A-","B++","B+","NR"];List<CarrierDto> _items=[];List<CarrierDto> _filtered=[];string _activeFilter="";bool _loading,_saving,_showForm;string _search=string.Empty;string? _loadError;Guid? _editId;SfToast _toast=default!;CarrierForm _form=new();protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();Breadcrumbs.SetCrumbs(new("Home","/"),new("Carrier Config",null),new("Carriers",null));await LoadAsync();}async Task LoadAsync(){_loading=true;_loadError=null;try{var r=await Api.SearchCarriersAsync(TenantId,_search,pageSize:200);_items=r?.Items.ToList()??[];ApplyFilter();}catch(Exception ex){_loadError=ex.Message;}finally{_loading=false;}}void SetFilter(string f){_activeFilter=f;ApplyFilter();}void ApplyFilter()=>_filtered=_activeFilter switch{"admitted"=>_items.Where(x=>x.IsAdmitted).ToList(),"nonadmitted"=>_items.Where(x=>!x.IsAdmitted).ToList(),"arated"=>_items.Where(x=>x.AmBestRating.StartsWith("A")).ToList(),_=>[.._items]};Task OnSearchAsync()=>LoadAsync();void OnRowSelected(RowSelectEventArgs<CarrierDto> args)=>OpenEdit(args.Data);void OpenCreate(){_editId=null;_form=new();_showForm=true;}void OpenEdit(CarrierDto i){_editId=i.CarrierId;_form=new(){CarrierName=i.CarrierName,NaicCode=i.NaicCode,AmBestRating=i.AmBestRating,IsAdmitted=i.IsAdmitted,AppointmentDate=i.AppointmentDate,IsActive=i.IsActive};_showForm=true;}async Task SaveAsync(){_saving=true;try{if(_editId.HasValue)await Api.UpdateCarrierAsync(_editId.Value,new(_form.CarrierName,_form.NaicCode,_form.AmBestRating,_form.IsAdmitted,_form.AppointmentDate,_form.IsActive));else await Api.CreateCarrierAsync(new(TenantId,_form.CarrierName,_form.NaicCode,_form.AmBestRating,_form.IsAdmitted,_form.AppointmentDate));_showForm=false;await _toast.ShowAsync(new(){Content="Saved successfully",CssClass="e-toast-success"});await LoadAsync();}catch(Exception ex){await _toast.ShowAsync(new(){Content=$"Save failed: {ex.Message}",CssClass="e-toast-danger"});}finally{_saving=false;}}void ResetForm(){_form=new();_editId=null;}sealed class CarrierForm{[Required,StringLength(200)]public string CarrierName{get;set;}=string.Empty;[Required,StringLength(20)]public string NaicCode{get;set;}=string.Empty;[Required,StringLength(20)]public string AmBestRating{get;set;}="NR";public bool IsAdmitted{get;set;}=true;public DateTime? AppointmentDate{get;set;}public bool IsActive{get;set;}=true;}
    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
