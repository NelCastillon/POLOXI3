@page "/tenant/carriers/settings"
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text.Json
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.AutomationJobs
@using Ams.Application.Features.CarrierConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Carrier Settings - AMS</PageTitle>

@if (_toastVisible)
{
    <div class="cs-toast cs-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="cs-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showConfirm && _confirmAction is not null)
{
    <div class="cs-modal-backdrop" role="presentation" @onclick="CancelConfirm">
        <div class="cs-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="carrierSettingConfirmTitle" @onclick:stopPropagation="true">
            <div class="cs-confirm-icon cs-confirm-@_confirmAction.Kind"><i class="bi @_confirmAction.Icon" aria-hidden="true"></i></div>
            <h2 id="carrierSettingConfirmTitle">@_confirmAction.Title</h2>
            <p>@_confirmAction.Message</p>
            <div class="cs-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CancelConfirm" disabled="@_busy">Cancel</button>
                <button type="button" class="um-btn @_confirmAction.ButtonClass" @onclick="ExecuteConfirmedAsync" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    @_confirmAction.ButtonText
                </button>
            </div>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="cs-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="cs-setting-modal" role="dialog" aria-modal="true" aria-labelledby="carrierSettingFormTitle" @onclick:stopPropagation="true">
            <div class="cs-modal-header">
                <div class="cs-modal-title">
                    <span class="cs-modal-icon"><i class="bi bi-sliders2" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="carrierSettingFormTitle">@(_editId.HasValue ? "Edit carrier setting" : "Create carrier setting")</h2>
                        <p>Configure module-level carrier behavior, worker executor parameters, validation schema, and UI metadata.</p>
                    </div>
                </div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseForm" disabled="@_busy" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmitAsync">
                <DataAnnotationsValidator />
                <div class="cs-modal-body">
                    <div class="cs-form-banner">
                        <i class="bi bi-database-check" aria-hidden="true"></i>
                        <div>
                            <strong>Database source of truth</strong>
                            <span>Settings save into Agency.CarrierSetting and can be synced into the carrier download automation workflow.</span>
                        </div>
                    </div>
                    <div class="cs-form-grid">
                        <div class="cs-field">
                            <label>Setting code <span>*</span></label>
                            <InputText class="cs-input" @bind-Value="_form.SettingCode" placeholder="DOWNLOAD_ENABLED" />
                        </div>
                        <div class="cs-field">
                            <label>Setting name <span>*</span></label>
                            <InputText class="cs-input" @bind-Value="_form.SettingName" placeholder="Carrier Download Enabled" />
                        </div>
                        <div class="cs-field">
                            <label>Category <span>*</span></label>
                            <InputSelect class="cs-input" @bind-Value="_form.CategoryCode">
                                @foreach (var category in CategoryChoices)
                                {
                                    <option value="@category">@category</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="cs-field">
                            <label>Scope <span>*</span></label>
                            <InputSelect class="cs-input" @bind-Value="_form.ScopeCode">
                                @foreach (var scope in ScopeChoices)
                                {
                                    <option value="@scope">@scope</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="cs-field">
                            <label>Data type <span>*</span></label>
                            <InputSelect class="cs-input" @bind-Value="_form.DataTypeCode">
                                @foreach (var type in TypeChoices)
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="cs-field">
                            <label>Sort order</label>
                            <InputNumber class="cs-input" @bind-Value="_form.SortOrder" />
                        </div>
                        <div class="cs-field cs-field-wide">
                            <label>Applies to executor</label>
                            <InputSelect class="cs-input" @bind-Value="_form.AppliesToExecutorType">
                                <option value="">Module setting</option>
                                @foreach (var executor in ExecutorChoices)
                                {
                                    <option value="@executor">@executor</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="cs-field cs-field-wide">
                            <label>Description</label>
                            <InputTextArea class="cs-input" rows="3" @bind-Value="_form.Description" placeholder="Explain how this setting controls carrier setup or automation." />
                        </div>
                        <div class="cs-field cs-field-wide">
                            <label>Setting value</label>
                            <InputTextArea class="cs-input" rows="3" @bind-Value="_form.SettingValue" placeholder="Current value" />
                        </div>
                        <div class="cs-field cs-field-wide">
                            <label>Default value</label>
                            <InputTextArea class="cs-input" rows="2" @bind-Value="_form.DefaultValue" placeholder="Fallback value" />
                        </div>
                        <div class="cs-field cs-field-wide">
                            <label>Validation JSON <span>*</span></label>
                            <InputTextArea class="cs-input cs-code-input" rows="4" @bind-Value="_form.ValidationJson" />
                        </div>
                        <div class="cs-field cs-field-wide">
                            <label>UI schema JSON <span>*</span></label>
                            <InputTextArea class="cs-input cs-code-input" rows="4" @bind-Value="_form.UiSchemaJson" />
                        </div>
                        <div class="cs-check-row cs-field-wide">
                            <label><InputCheckbox @bind-Value="_form.IsRequired" /> Required</label>
                            <label><InputCheckbox @bind-Value="_form.IsSecret" /> Secret</label>
                            <label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label>
                        </div>
                    </div>
                </div>
                <div class="cs-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(_editId.HasValue ? "Save changes" : "Create setting")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="cs-enterprise-page">
    <section class="cs-hero">
        <div class="cs-hero-left">
            <span class="cs-hero-icon"><i class="bi bi-sliders2" aria-hidden="true"></i></span>
            <div>
                <div class="cs-title-row">
                    <h1>Carrier Settings</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Agency.CarrierSetting</span>
                    <span><i class="bi bi-diagram-3" aria-hidden="true"></i> Workflow synced</span>
                </div>
                <p>Manage carrier module settings, worker executor parameters, validation schema, secret controls, and automation sync from live tenant data.</p>
            </div>
        </div>
        <div class="cs-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh carrier settings"><i class="bi @(_loading ? "bi-arrow-repeat cs-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-ghost" @onclick="ConfirmSyncWorkflow" disabled="@_loading" title="Sync carrier settings to automation workflow"><i class="bi bi-diagram-3" aria-hidden="true"></i> Sync workflow</button>
            <button class="um-btn um-btn-primary" @onclick="OpenCreate" title="Create carrier setting"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Setting</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="cs-error-banner" style="border-left: 4px solid #dc3545; animation: cs-shake 0.3s ease;"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="cs-kpi-strip" aria-label="Carrier setting metrics">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" title="@metric.Caption" @onclick="@(() => SetQuickFilter(metric.Filter))">
                <span class="cs-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span><span class="cs-kpi-val">@metric.Value</span><span class="cs-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
            </button>
        }
    </section>

    <section class="cs-workflow-strip" aria-label="Carrier settings workflow actions">
        <button class="cs-workflow-card" @onclick="ShowCategoriesView"><i class="bi bi-columns-gap" aria-hidden="true"></i><span><strong>Category view</strong><span>Group settings by module area.</span></span></button>
        <button class="cs-workflow-card" @onclick="ShowWorkflowView"><i class="bi bi-diagram-3" aria-hidden="true"></i><span><strong>Executor sync</strong><span>Review workflow-bound settings.</span></span></button>
        <button class="cs-workflow-card" @onclick="ShowSecurityView"><i class="bi bi-shield-lock" aria-hidden="true"></i><span><strong>Secret review</strong><span>Audit security-sensitive values.</span></span></button>
        <button class="cs-workflow-card" @onclick="ShowRequiredSettings"><i class="bi bi-asterisk" aria-hidden="true"></i><span><strong>Required setup</strong><span>Complete required module settings.</span></span></button>
    </section>

    <section class="cs-search-panel">
        <div class="cs-search-wrap">
            <span class="cs-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="cs-search-body">
                <label for="carrierSettingSearchInput">Search carrier settings</label>
                <input id="carrierSettingSearchInput" class="cs-search-input" value="@_search" @oninput="@(e => OnSearchChanged(e))" placeholder="Search setting, code, category, scope, type, executor, value, or description..." />
                <span class="cs-search-hint">Filters are applied instantly against the loaded tenant settings.</span>
            </div>
        </div>
        <select class="cs-filter-select" value="@_categoryFilter" @onchange="@(e => OnCategoryFilterChanged(e))"><option value="">All categories</option>@foreach (var option in CategoryOptions) { <option value="@option">@option</option> }</select>
        <select class="cs-filter-select" value="@_scopeFilter" @onchange="@(e => OnScopeFilterChanged(e))"><option value="">All scopes</option>@foreach (var option in ScopeOptions) { <option value="@option">@option</option> }</select>
        <select class="cs-filter-select" value="@_typeFilter" @onchange="@(e => OnTypeFilterChanged(e))"><option value="">All types</option>@foreach (var option in TypeOptions) { <option value="@option">@option</option> }</select>
        <select class="cs-filter-select" value="@_executorFilter" @onchange="@(e => OnExecutorFilterChanged(e))"><option value="">All executors</option>@foreach (var option in ExecutorOptions) { <option value="@option">@option</option> }</select>
        <div class="cs-search-result"><strong>@_filtered.Count</strong><span>matches</span></div>
    </section>

    @if (_selected.Count > 0)
    {
        <section class="cs-bulk-bar">
            <span>@_selected.Count selected</span>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="ConfirmBulkActivate"><i class="bi bi-check-circle" aria-hidden="true"></i> Activate</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="ConfirmBulkDeactivate"><i class="bi bi-pause-circle" aria-hidden="true"></i> Deactivate</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="ConfirmBulkReset"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset values</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearSelection" title="Clear selection"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </section>
    }

    <section class="cs-view-tabs" aria-label="Carrier setting views">
        @foreach (var view in Views)
        {
            <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label</button>
        }
    </section>

    <section class="cs-content-layout">
        <main class="cs-main-card">
            @if (_loading)
            {
                <div class="cs-loading"><i class="bi bi-arrow-repeat cs-spin" aria-hidden="true"></i><strong>Loading carrier setting workspace...</strong></div>
            }
            else if (_filtered.Count == 0)
            {
                <div class="cs-empty-state"><i class="bi bi-sliders2" aria-hidden="true"></i><strong>No carrier settings match this view</strong><span>Adjust filters, run migrations, or create a setting.</span><button class="um-btn um-btn-primary" @onclick="OpenCreate">Create setting</button></div>
            }
            else if (_view == "table")
            {
                <div class="cs-table-scroll">
                    <table class="cs-table">
                        <thead>
                            <tr><th><input type="checkbox" checked="@AllPageSelected" @onchange="@(e => ToggleCurrentPageSelection(e))" aria-label="Select all settings on this page" /></th><th>Setting</th><th>Category</th><th>Scope</th><th>Type</th><th>Value</th><th>Executor</th><th>Status</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _paged)
                            {
                                <tr class="@RowClass(item)" @onclick="@(() => OpenDetail(item))">
                                    <td @onclick:stopPropagation="true"><input type="checkbox" checked="@IsSelected(item)" @onchange="@(() => ToggleSelection(item))" aria-label="Select setting" /></td>
                                    <td><div class="cs-name-cell"><span class="cs-avatar @AvatarColor(item.CategoryCode)" aria-hidden="true">@Initials(item.SettingName)</span><span><strong>@item.SettingName</strong><small><code>@item.SettingCode</code> - @AgeLabel(item)</small></span></div></td>
                                    <td><button class="cs-category-badge" @onclick:stopPropagation="true" @onclick="@(() => FilterCategory(item.CategoryCode))"><i class="bi @CategoryIcon(item.CategoryCode)" aria-hidden="true"></i> @item.CategoryCode</button></td>
                                    <td><span class="cs-pill cs-pill-scope">@item.ScopeCode</span></td>
                                    <td><span class="cs-pill cs-pill-type">@item.DataTypeCode</span></td>
                                    <td class="cs-value-cell">@DisplayValue(item)</td>
                                    <td><small>@(item.AppliesToExecutorType ?? "Module")</small></td>
                                    <td><span class="@StatusBadge(item)">@(item.IsActive ? "Active" : "Inactive")</span></td>
                                    <td @onclick:stopPropagation="true"><div class="cs-row-actions"><button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenEdit(item))" title="Edit setting"><i class="bi bi-pencil" aria-hidden="true"></i></button><button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ConfirmToggleActive(item))" title="@(item.IsActive ? "Deactivate" : "Activate")"><i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-check-circle")" aria-hidden="true"></i></button><button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ConfirmReset(item))" title="Reset to default"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button><button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="@(() => ConfirmDelete(item))" title="Delete setting"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="cs-pager"><span>@PageSummary</span><div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_pageIndex <= 1)" title="Previous page"><i class="bi bi-chevron-left" aria-hidden="true"></i></button><span>Page @_pageIndex of @TotalPages</span><button class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_pageIndex >= TotalPages)" title="Next page"><i class="bi bi-chevron-right" aria-hidden="true"></i></button></div></div>
            }
            else if (_view == "categories")
            {
                <div class="cs-category-grid">
                    @foreach (var row in CategoryRows)
                    {
                        <article class="cs-category-card" @onclick="@(() => FilterCategory(row.Category))"><div><span class="cs-category-icon"><i class="bi @CategoryIcon(row.Category)" aria-hidden="true"></i></span><span><strong>@row.Category</strong><small>@row.Total settings - @row.Active active</small></span></div><strong>@row.Required required</strong><div class="cs-meter"><i style="width:@row.ActivePercent.ToString("F0", CultureInfo.InvariantCulture)%"></i></div></article>
                    }
                </div>
            }
            else if (_view == "workflow")
            {
                <div class="cs-workflow-grid">
                    @foreach (var row in ExecutorRows)
                    {
                        <article class="cs-executor-card" @onclick="@(() => FilterExecutor(row.Executor))"><div><span class="cs-category-icon"><i class="bi bi-cpu" aria-hidden="true"></i></span><span><strong>@row.Executor</strong><small>@row.Total settings - @row.Secret secrets</small></span></div><strong>@row.Required required</strong><div class="cs-meter"><i style="width:@row.RequiredPercent.ToString("F0", CultureInfo.InvariantCulture)%"></i></div></article>
                    }
                </div>
            }
            else
            {
                <div class="cs-security-grid">
                    @foreach (var item in _filtered.Where(x => x.IsSecret || x.CategoryCode.Equals("Security", StringComparison.OrdinalIgnoreCase) || x.IsRequired))
                    {
                        <article class="cs-security-card" @onclick="@(() => OpenDetail(item))"><div><span class="cs-category-icon"><i class="bi @(item.IsSecret ? "bi-shield-lock" : "bi-patch-check")" aria-hidden="true"></i></span><span><strong>@item.SettingName</strong><small>@item.CategoryCode - @(item.IsSecret ? "secret" : "required")</small></span></div><span class="@StatusBadge(item)">@(item.IsActive ? "Active" : "Inactive")</span></article>
                    }
                </div>
            }
        </main>

        <aside class="cs-detail-card">
            @if (_detail is null)
            {
                <div class="cs-detail-empty"><i class="bi bi-sliders" aria-hidden="true"></i><strong>Select a setting</strong><span>Review schema, value, executor mapping, and related workflow actions.</span></div>
            }
            else
            {
                <div class="cs-detail-head"><div><span class="cs-detail-eyebrow"><i class="bi @CategoryIcon(_detail.CategoryCode)" aria-hidden="true"></i> @_detail.CategoryCode</span><h2>@_detail.SettingName</h2><p><code>@_detail.SettingCode</code></p></div><span class="@StatusBadge(_detail)">@(_detail.IsActive ? "Active" : "Inactive")</span></div>
                <div class="cs-detail-body">
                    <div class="cs-detail-summary"><div><span>Scope</span><strong>@_detail.ScopeCode</strong></div><div><span>Type</span><strong>@_detail.DataTypeCode</strong></div><div><span>Required</span><strong>@(_detail.IsRequired ? "Yes" : "No")</strong></div><div><span>Secret</span><strong>@(_detail.IsSecret ? "Yes" : "No")</strong></div></div>
                    <div class="cs-info-card"><span><i class="bi bi-info-circle" aria-hidden="true"></i> @(_detail.Description ?? "No description captured.")</span><span><i class="bi bi-cpu" aria-hidden="true"></i> @(_detail.AppliesToExecutorType ?? "Module setting")</span><span><i class="bi bi-database" aria-hidden="true"></i> Value: @DisplayValue(_detail)</span></div>
                    <div class="cs-schema-card"><strong>Validation JSON</strong><code>@_detail.ValidationJson</code><strong>UI schema JSON</strong><code>@_detail.UiSchemaJson</code><strong>Default</strong><code>@(_detail.DefaultValue ?? "-")</code></div>
                    <div class="cs-detail-actions"><div class="cs-detail-actions-row"><button class="um-btn um-btn-ghost" @onclick="@(() => OpenEdit(_detail))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button class="um-btn um-btn-ghost" @onclick="@(() => ConfirmToggleActive(_detail))"><i class="bi @(_detail.IsActive ? "bi-pause-circle" : "bi-check-circle")" aria-hidden="true"></i> @(_detail.IsActive ? "Deactivate" : "Activate")</button><button class="um-btn um-btn-danger" @onclick="@(() => ConfirmDelete(_detail))"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div><button class="um-btn um-btn-primary cs-detail-sync-btn" @onclick="ConfirmSyncWorkflow"><i class="bi bi-diagram-3" aria-hidden="true"></i> Sync related workflow</button></div>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    private const string CarrierDownloadJobCode = "CARRIER_DOWNLOAD_INGESTION";
    private Guid _tenantId;
    private bool _loading;
    private bool _busy;
    private bool _showForm;
    private bool _showConfirm;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "info";
    private string _search = string.Empty;
    private string _categoryFilter = string.Empty;
    private string _scopeFilter = string.Empty;
    private string _typeFilter = string.Empty;
    private string _executorFilter = string.Empty;
    private string _quickFilter = string.Empty;
    private string _view = "table";
    private string? _loadError;
    private Guid? _editId;
    private int _pageIndex = 1;
    private const int PageSize = 12;
    private CarrierSettingDto? _detail;
    private ConfirmAction? _confirmAction;
    private CancellationTokenSource? _toastCts;
    private List<CarrierSettingDto> _items = [];
    private List<CarrierSettingDto> _filtered = [];
    private List<CarrierSettingDto> _paged = [];
    private List<CarrierSettingDto> _selected = [];
    private SettingForm _form = new();

    private static readonly string[] CategoryChoices = ["Download", "Storage", "Matching", "ApplyUpdates", "Notifications", "Security", "Workflow", "Integration"];
    private static readonly string[] ScopeChoices = ["Tenant", "Carrier", "Executor", "Workflow"];
    private static readonly string[] TypeChoices = ["Text", "Number", "Boolean", "Json", "Secret", "Date", "Url"];
    private static readonly string[] ExecutorChoices = ["FileIngestionStepExecutor", "CarrierDownloadStepExecutor", "CarrierDownloadMatchStepExecutor", "CarrierDownloadApplyUpdatesStepExecutor", "NotificationStepExecutor"];
    private static readonly List<ViewDef> Views = [new("table", "Table", "bi-table"), new("categories", "Categories", "bi-columns-gap"), new("workflow", "Workflow", "bi-diagram-3"), new("security", "Security", "bi-shield-lock")];

    private IEnumerable<string> CategoryOptions => _items.Select(x => x.CategoryCode).Concat(CategoryChoices).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);
    private IEnumerable<string> ScopeOptions => _items.Select(x => x.ScopeCode).Concat(ScopeChoices).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);
    private IEnumerable<string> TypeOptions => _items.Select(x => x.DataTypeCode).Concat(TypeChoices).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);
    private IEnumerable<string> ExecutorOptions => _items.Select(x => x.AppliesToExecutorType ?? string.Empty).Concat(ExecutorChoices).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
    private bool AllPageSelected => _paged.Count > 0 && _paged.All(IsSelected);
    private string PageSummary => _filtered.Count == 0 ? "No settings" : $"Showing {((_pageIndex - 1) * PageSize) + 1}-{Math.Min(_pageIndex * PageSize, _filtered.Count)} of {_filtered.Count}";
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-octagon", "warning" => "bi-exclamation-triangle", "success" => "bi-check2-circle", _ => "bi-info-circle" };

    private IEnumerable<KpiModel> Metrics =>
    [
        new("Total", _items.Count.ToString(CultureInfo.CurrentCulture), "All settings", "bi-sliders2", "cs-blue", string.Empty),
        new("Active", _items.Count(x => x.IsActive).ToString(CultureInfo.CurrentCulture), "Enabled values", "bi-check-circle-fill", "cs-green", "active"),
        new("Required", _items.Count(x => x.IsRequired).ToString(CultureInfo.CurrentCulture), "Must be configured", "bi-asterisk", "cs-amber", "required"),
        new("Secrets", _items.Count(x => x.IsSecret).ToString(CultureInfo.CurrentCulture), "Masked values", "bi-shield-lock", "cs-red", "secret"),
        new("Executors", _items.Count(x => !string.IsNullOrWhiteSpace(x.AppliesToExecutorType)).ToString(CultureInfo.CurrentCulture), "Worker-bound", "bi-cpu", "cs-purple", "executor"),
        new("Missing", _items.Count(x => x.IsRequired && string.IsNullOrWhiteSpace(x.SettingValue)).ToString(CultureInfo.CurrentCulture), "Needs value", "bi-exclamation-triangle", "cs-cyan", "missing")
    ];

    private IEnumerable<CategoryRow> CategoryRows
    {
        get
        {
            return _filtered.GroupBy(x => x.CategoryCode).OrderBy(g => g.Key).Select(g =>
            {
                var total = g.Count();
                var active = g.Count(x => x.IsActive);
                return new CategoryRow(g.Key, total, active, g.Count(x => x.IsRequired), total == 0 ? 0 : active / (double)total * 100);
            });
        }
    }

    private IEnumerable<ExecutorRow> ExecutorRows
    {
        get
        {
            return _filtered.Where(x => !string.IsNullOrWhiteSpace(x.AppliesToExecutorType)).GroupBy(x => x.AppliesToExecutorType!).OrderBy(g => g.Key).Select(g =>
            {
                var total = g.Count();
                var required = g.Count(x => x.IsRequired);
                return new ExecutorRow(g.Key, total, required, g.Count(x => x.IsSecret), total == 0 ? 0 : required / (double)total * 100);
            });
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
