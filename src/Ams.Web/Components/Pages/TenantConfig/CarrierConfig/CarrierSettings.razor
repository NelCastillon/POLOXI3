    private async Task DeleteAsync(CarrierSettingDto item)
    {
        try
        {
            await Api.DeleteCarrierSettingAsync(item.CarrierSettingId);
            _selected.RemoveAll(x => x.CarrierSettingId == item.CarrierSettingId);
            if (_detail?.CarrierSettingId == item.CarrierSettingId) _detail = null;
            await ShowToastAsync("Carrier setting deleted.", "success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Delete failed: {ex.Message}", "danger");
        }
    }

    private async Task ToggleActiveAsync(CarrierSettingDto item) => await UpdateSettingAsync(item, CloneSetting(item, isActive: !item.IsActive), item.IsActive ? "Carrier setting deactivated." : "Carrier setting activated.");
    private async Task ResetAsync(CarrierSettingDto item) => await UpdateSettingAsync(item, CloneSetting(item, settingValue: item.DefaultValue), "Carrier setting reset to default.");

    private async Task BulkSetActiveAsync(bool isActive)
    {
        foreach (var item in _selected.ToList()) await UpdateSettingAsync(item, CloneSetting(item, isActive: isActive), null, reload: false);
        ClearSelection();
        await ShowToastAsync(isActive ? "Selected settings activated." : "Selected settings deactivated.", "success");
        await LoadAsync();
    }

    private async Task BulkResetAsync()
    {
        foreach (var item in _selected.ToList()) await UpdateSettingAsync(item, CloneSetting(item, settingValue: item.DefaultValue), null, reload: false);
        ClearSelection();
        await ShowToastAsync("Selected settings reset to defaults.", "success");
        await LoadAsync();
    }

    private async Task UpdateSettingAsync(CarrierSettingDto original, CarrierSettingDto updated, string? successMessage, bool reload = true)
    {
        try
        {
            await Api.UpdateCarrierSettingAsync(original.CarrierSettingId, new UpdateCarrierSettingRequest(updated.CarrierId, updated.SettingCode, updated.SettingName, updated.CategoryCode, updated.ScopeCode, updated.DataTypeCode, Normalize(updated.SettingValue), Normalize(updated.DefaultValue), Normalize(updated.Description), updated.ValidationJson, updated.UiSchemaJson, Normalize(updated.AppliesToExecutorType), updated.IsRequired, updated.IsSecret, updated.IsActive, updated.SortOrder));
            if (!string.IsNullOrWhiteSpace(successMessage)) await ShowToastAsync(successMessage, "success");
            if (reload) await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Update failed: {ex.Message}", "danger");
        }
    }

    private async Task SyncWorkflowAsync()
    {
        try
        {
            var jobs = await Api.SearchAutomationJobsAsync(_tenantId, CarrierDownloadJobCode, null, null, 1, 25);
            var job = jobs?.Items.FirstOrDefault(x => x.JobCode.Equals(CarrierDownloadJobCode, StringComparison.OrdinalIgnoreCase));
            if (job is null)
            {
                await ShowToastAsync("Sync failed: Carrier download automation job was not found. Run automation seed migrations first.", "danger");
                return;
            }

            var settings = _items.Count == 0 ? _filtered : _items;
            var jobSchema = BuildJobDynamicSchema(settings);
            var jobDefaults = BuildDefaultParameterJson(settings.Where(x => string.IsNullOrWhiteSpace(x.AppliesToExecutorType)));
            await Api.UpdateAutomationJobAsync(job.JobDefinitionId, new UpdateJobDefinitionRequest(job.JobName, job.Description, job.JobTypeCode, job.CategoryCode, job.StatusCode, job.OwnerTeam, job.ConcurrencyPolicy, job.MaxRetryCount, job.TimeoutSeconds, job.Tags, job.ConfigurationJson, jobSchema, jobDefaults, job.IsActive));

            var steps = await Api.GetAutomationJobStepsAsync(job.JobDefinitionId);
            foreach (var step in steps.Where(x => !string.IsNullOrWhiteSpace(x.StepExecutorType)))
            {
                var stepSettings = settings.Where(x => string.Equals(x.AppliesToExecutorType, step.StepExecutorType, StringComparison.OrdinalIgnoreCase)).ToList();
                if (stepSettings.Count == 0) continue;
                await Api.SaveAutomationJobStepAsync(job.JobDefinitionId, step.JobStepId, new UpsertJobStepRequest(step.TenantId, step.JobDefinitionId, step.StepOrder, step.StepCode, step.StepName, step.StepExecutorType, step.Description, step.InputMappingJson, step.OutputMappingJson, step.RetryPolicyJson, BuildStepDynamicSchema(stepSettings), BuildDefaultParameterJson(stepSettings), step.OutputContractJson, step.DependsOnStepCodes, step.TimeoutSeconds, step.ContinueOnError, step.IsEnabled));
            }

            await ShowToastAsync("Carrier settings synced to automation workflow.", "success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Sync failed: {ex.Message}", "danger");
        }
    }

    private async Task ShowToastAsync(string message, string kind = "info")
    {
        _toastCts?.Cancel();
        _toastMessage = message;
        _toastKind = kind;
        _toastVisible = true;
        var cts = new CancellationTokenSource();
        _toastCts = cts;
        try
        {
            await Task.Delay(4200, cts.Token);
            if (!cts.IsCancellationRequested) HideToast();
        }
        catch (TaskCanceledException) { }
    }

    private void HideToast() => _toastVisible = false;

    private CreateCarrierSettingRequest ToCreateRequest(SettingForm f) => new(_tenantId, null, f.SettingCode.Trim(), f.SettingName.Trim(), f.CategoryCode.Trim(), f.ScopeCode.Trim(), f.DataTypeCode.Trim(), Normalize(f.SettingValue), Normalize(f.DefaultValue), Normalize(f.Description), f.ValidationJson.Trim(), f.UiSchemaJson.Trim(), Normalize(f.AppliesToExecutorType), f.IsRequired, f.IsSecret, f.SortOrder);
    private UpdateCarrierSettingRequest ToUpdateRequest(SettingForm f) => new(null, f.SettingCode.Trim(), f.SettingName.Trim(), f.CategoryCode.Trim(), f.ScopeCode.Trim(), f.DataTypeCode.Trim(), Normalize(f.SettingValue), Normalize(f.DefaultValue), Normalize(f.Description), f.ValidationJson.Trim(), f.UiSchemaJson.Trim(), Normalize(f.AppliesToExecutorType), f.IsRequired, f.IsSecret, f.IsActive, f.SortOrder);

    private static string BuildJobDynamicSchema(IEnumerable<CarrierSettingDto> settings) => JsonSerializer.Serialize(settings.Where(x => x.IsActive && x.IsRequired).OrderBy(x => x.SortOrder).Select(x => new { name = ToCamel(x.SettingCode), label = x.SettingName, dataType = x.DataTypeCode, required = x.IsRequired, category = x.CategoryCode, scope = x.ScopeCode }));
    private static string BuildStepDynamicSchema(IEnumerable<CarrierSettingDto> settings) => JsonSerializer.Serialize(settings.Where(x => x.IsActive).OrderBy(x => x.SortOrder).Select(x => new { name = ToCamel(x.SettingCode), label = x.SettingName, dataType = x.DataTypeCode, required = x.IsRequired, category = x.CategoryCode }));
    private static string BuildDefaultParameterJson(IEnumerable<CarrierSettingDto> settings) => JsonSerializer.Serialize(settings.Where(x => x.IsActive).OrderBy(x => x.SortOrder).ToDictionary(x => ToCamel(x.SettingCode), x => (object?)(x.SettingValue ?? x.DefaultValue)));
    private static bool IsValidJson(string value) { try { using var _ = JsonDocument.Parse(string.IsNullOrWhiteSpace(value) ? "{}" : value); return true; } catch { return false; } }
    private static string ToCamel(string value) { var parts = value.Split('_', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); if (parts.Length == 0) return value; return parts[0].ToLowerInvariant() + string.Concat(parts.Skip(1).Select(x => CultureInfo.InvariantCulture.TextInfo.ToTitleCase(x.ToLowerInvariant()))); }
    private static bool Contains(string? source, string value) => !string.IsNullOrWhiteSpace(source) && source.Contains(value, StringComparison.OrdinalIgnoreCase);
    private static string? Normalize(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string DisplayValue(CarrierSettingDto item) => item.IsSecret ? "--------" : string.IsNullOrWhiteSpace(item.SettingValue) ? "-" : item.SettingValue.Length > 56 ? item.SettingValue[..56] + "..." : item.SettingValue;
    private static string Initials(string value) => string.Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => char.ToUpperInvariant(x[0]))).PadRight(1, 'S');
    private static string AgeLabel(CarrierSettingDto item) => item.ModifiedDateUtc.HasValue ? $"updated {item.ModifiedDateUtc.Value.ToLocalTime():MMM d, yyyy}" : $"created {item.CreatedDateUtc.ToLocalTime():MMM d, yyyy}";
    private static CarrierSettingDto CloneSetting(CarrierSettingDto item, bool? isActive = null, string? settingValue = null) => new()
    {
        CarrierSettingId = item.CarrierSettingId,
        TenantId = item.TenantId,
        CarrierId = item.CarrierId,
        SettingCode = item.SettingCode,
        SettingName = item.SettingName,
        CategoryCode = item.CategoryCode,
        ScopeCode = item.ScopeCode,
        DataTypeCode = item.DataTypeCode,
        SettingValue = settingValue ?? item.SettingValue,
        DefaultValue = item.DefaultValue,
        Description = item.Description,
        ValidationJson = item.ValidationJson,
        UiSchemaJson = item.UiSchemaJson,
        AppliesToExecutorType = item.AppliesToExecutorType,
        IsRequired = item.IsRequired,
        IsSecret = item.IsSecret,
        IsActive = isActive ?? item.IsActive,
        SortOrder = item.SortOrder,
        CreatedDateUtc = item.CreatedDateUtc,
        ModifiedDateUtc = item.ModifiedDateUtc
    };

    private static string AvatarColor(string value) => (Math.Abs(value.GetHashCode()) % 6) switch { 0 => "cs-av1", 1 => "cs-av2", 2 => "cs-av3", 3 => "cs-av4", 4 => "cs-av5", _ => "cs-av6" };
    private static string CategoryIcon(string category) => category.ToLowerInvariant() switch { "download" => "bi-arrow-down-circle", "storage" => "bi-hdd", "matching" => "bi-intersect", "applyupdates" => "bi-pencil-square", "notifications" => "bi-bell", "security" => "bi-shield-lock", "workflow" => "bi-diagram-3", _ => "bi-sliders2" };
    private static string StatusBadge(CarrierSettingDto item) => item.IsActive ? "cs-status cs-status-active" : "cs-status cs-status-inactive";
    private string RowClass(CarrierSettingDto item) => (_detail?.CarrierSettingId == item.CarrierSettingId ? "cs-row-selected " : string.Empty) + (IsSelected(item) ? "cs-row-checked" : string.Empty);
    private string MetricCardClass(KpiModel metric) => $"cs-kpi-card {metric.Tone} {(_quickFilter == metric.Filter ? "cs-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewDef view) => $"cs-view-btn {(_view == view.Id ? "cs-view-btn-active" : string.Empty)}";

