    private void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; ApplyFilter(resetPage: true); }
    private void OnCategoryFilterChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _categoryFilter = e.Value?.ToString() ?? string.Empty; ApplyFilter(resetPage: true); }
    private void OnScopeFilterChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _scopeFilter = e.Value?.ToString() ?? string.Empty; ApplyFilter(resetPage: true); }
    private void OnTypeFilterChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _typeFilter = e.Value?.ToString() ?? string.Empty; ApplyFilter(resetPage: true); }
    private void OnExecutorFilterChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _executorFilter = e.Value?.ToString() ?? string.Empty; ApplyFilter(resetPage: true); }
    private void SetQuickFilter(string value) { _quickFilter = value; ApplyFilter(resetPage: true); }
    private void SetView(string value) { _view = value; _pageIndex = 1; ApplyPaging(); }
    private void ShowCategoriesView() => SetView("categories");
    private void ShowWorkflowView() { _quickFilter = "executor"; SetView("workflow"); ApplyFilter(resetPage: true); }
    private void ShowSecurityView() { _quickFilter = "secret"; SetView("security"); ApplyFilter(resetPage: true); }
    private void ShowRequiredSettings() { _quickFilter = "required"; ApplyFilter(resetPage: true); }
    private void FilterCategory(string category) { _categoryFilter = category; _quickFilter = string.Empty; SetView("table"); ApplyFilter(resetPage: true); }
    private void FilterExecutor(string executor) { _executorFilter = executor; _quickFilter = "executor"; SetView("table"); ApplyFilter(resetPage: true); }

    private void ApplyFilter(bool resetPage = false)
    {
        IEnumerable<CarrierSettingDto> query = _items;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim();
            query = query.Where(x => Contains(x.SettingName, s) || Contains(x.SettingCode, s) || Contains(x.CategoryCode, s) || Contains(x.ScopeCode, s) || Contains(x.DataTypeCode, s) || Contains(x.AppliesToExecutorType, s) || Contains(x.Description, s) || Contains(x.SettingValue, s));
        }
        if (!string.IsNullOrWhiteSpace(_categoryFilter)) query = query.Where(x => x.CategoryCode.Equals(_categoryFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_scopeFilter)) query = query.Where(x => x.ScopeCode.Equals(_scopeFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_typeFilter)) query = query.Where(x => x.DataTypeCode.Equals(_typeFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_executorFilter)) query = query.Where(x => string.Equals(x.AppliesToExecutorType, _executorFilter, StringComparison.OrdinalIgnoreCase));
        query = _quickFilter switch
        {
            "active" => query.Where(x => x.IsActive),
            "required" => query.Where(x => x.IsRequired),
            "secret" => query.Where(x => x.IsSecret),
            "executor" => query.Where(x => !string.IsNullOrWhiteSpace(x.AppliesToExecutorType)),
            "missing" => query.Where(x => x.IsRequired && string.IsNullOrWhiteSpace(x.SettingValue)),
            _ => query
        };
        _filtered = query.OrderBy(x => x.CategoryCode).ThenBy(x => x.SortOrder).ThenBy(x => x.SettingName).ToList();
        if (resetPage) _pageIndex = 1;
        if (_detail is not null && !_filtered.Any(x => x.CarrierSettingId == _detail.CarrierSettingId)) _detail = _filtered.FirstOrDefault();
        ApplyPaging();
    }

    private void ApplyPaging()
    {
        _pageIndex = Math.Clamp(_pageIndex, 1, TotalPages);
        _paged = _filtered.Skip((_pageIndex - 1) * PageSize).Take(PageSize).ToList();
    }

    private void PreviousPage() { if (_pageIndex > 1) { _pageIndex--; ApplyPaging(); } }
    private void NextPage() { if (_pageIndex < TotalPages) { _pageIndex++; ApplyPaging(); } }
    private void OpenDetail(CarrierSettingDto item) => _detail = item;
    private bool IsSelected(CarrierSettingDto item) => _selected.Any(x => x.CarrierSettingId == item.CarrierSettingId);
    private void ToggleSelection(CarrierSettingDto item) { if (IsSelected(item)) _selected.RemoveAll(x => x.CarrierSettingId == item.CarrierSettingId); else _selected.Add(item); }
    private void ClearSelection() => _selected.Clear();

    private void ToggleCurrentPageSelection(Microsoft.AspNetCore.Components.ChangeEventArgs _)
    {
        if (AllPageSelected)
        {
            _selected.RemoveAll(x => _paged.Any(p => p.CarrierSettingId == x.CarrierSettingId));
            return;
        }
        foreach (var item in _paged.Where(x => !IsSelected(x))) _selected.Add(item);
    }

