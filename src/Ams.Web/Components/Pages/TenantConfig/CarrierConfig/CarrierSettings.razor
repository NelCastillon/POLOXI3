    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchCarrierSettingsAsync(_tenantId, null, 1, 1000);
            _items = result?.Items.ToList() ?? [];
            ApplyFilter();
            if (_detail is null && _filtered.Count > 0)
            {
                _detail = _filtered[0];
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Load failed: {ex.Message}";
