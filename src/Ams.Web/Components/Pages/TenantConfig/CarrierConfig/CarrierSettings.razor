    private async Task HandleInvalidSubmitAsync()
    {
        await ShowToastAsync("Review required fields and validation messages before saving.", "warning");
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            if (!IsValidJson(_form.ValidationJson) || !IsValidJson(_form.UiSchemaJson))
            {
                await ShowToastAsync("Save failed: Validation JSON and UI schema JSON must be valid JSON.", "danger");
                return;
            }

            if (_editId.HasValue)
            {
                await Api.UpdateCarrierSettingAsync(_editId.Value, ToUpdateRequest(_form));
            }
            else
            {
                await Api.CreateCarrierSettingAsync(ToCreateRequest(_form));
            }
            _showForm = false;
            await ShowToastAsync("Carrier setting saved.", "success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void ConfirmDelete(CarrierSettingDto item) => ShowConfirm(new("Delete carrier setting", $"Delete {item.SettingName}? This action soft-deletes the setting after confirmation.", "Delete", "um-btn-danger", "danger", "bi-trash3-fill", () => DeleteAsync(item)));
    private void ConfirmToggleActive(CarrierSettingDto item) => ShowConfirm(new(item.IsActive ? "Deactivate carrier setting" : "Activate carrier setting", $"{(item.IsActive ? "Deactivate" : "Activate")} {item.SettingName}?", item.IsActive ? "Deactivate" : "Activate", item.IsActive ? "um-btn-warning" : "um-btn-primary", item.IsActive ? "warning" : "success", item.IsActive ? "bi-pause-circle" : "bi-check-circle", () => ToggleActiveAsync(item)));
    private void ConfirmReset(CarrierSettingDto item) => ShowConfirm(new("Reset setting value", $"Reset {item.SettingName} to its default value?", "Reset value", "um-btn-warning", "warning", "bi-arrow-counterclockwise", () => ResetAsync(item)));
    private void ConfirmBulkActivate() => ShowConfirm(new("Activate selected settings", $"Activate {_selected.Count} selected carrier setting(s)?", "Activate", "um-btn-primary", "success", "bi-check-circle", () => BulkSetActiveAsync(true)));
    private void ConfirmBulkDeactivate() => ShowConfirm(new("Deactivate selected settings", $"Deactivate {_selected.Count} selected carrier setting(s)?", "Deactivate", "um-btn-warning", "warning", "bi-pause-circle", () => BulkSetActiveAsync(false)));
    private void ConfirmBulkReset() => ShowConfirm(new("Reset selected values", $"Reset {_selected.Count} selected carrier setting value(s) to defaults?", "Reset values", "um-btn-warning", "warning", "bi-arrow-counterclockwise", BulkResetAsync));
    private void ConfirmSyncWorkflow() => ShowConfirm(new("Sync carrier workflow", "Sync current carrier setting schema and executor parameters into the carrier download automation job and steps.", "Sync workflow", "um-btn-primary", "success", "bi-diagram-3", SyncWorkflowAsync));

    private void ShowConfirm(ConfirmAction action) { _confirmAction = action; _showConfirm = true; }
    private void CancelConfirm() { if (_busy) return; _showConfirm = false; _confirmAction = null; }

    private async Task ExecuteConfirmedAsync()
    {
        if (_confirmAction is null) return;
        _busy = true;
        try
        {
            await _confirmAction.ExecuteAsync();
            _showConfirm = false;
            _confirmAction = null;
