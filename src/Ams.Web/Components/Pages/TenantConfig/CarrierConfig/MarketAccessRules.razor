@page "/tenant/carriers/access"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.CarrierRules
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Market Access Command Center - Carrier Configuration</PageTitle>

<div class="mac-page">
    <section class="mac-hero">
        <div class="mac-hero__content">
            <div class="mac-hero-left">
                <span class="mac-hero-icon"><i class="bi bi-key" aria-hidden="true"></i></span>
                <div class="mac-hero-title">
                    <div class="mac-hero__eyebrow">Enterprise market access governance</div>
                    <div class="mac-title-row">
                        <h1>Market Access Command Center</h1>
                        <div class="mac-hero__meta">
                            <span><i class="bi bi-key" aria-hidden="true"></i>@_items.Count rules</span>
                            <span><i class="bi bi-check-circle" aria-hidden="true"></i>@_items.Count(x => x.IsActive) active</span>
                            <span><i class="bi bi-unlock" aria-hidden="true"></i>@_items.Count(IsOpenAccess) open</span>
                            <span><i class="bi bi-lock" aria-hidden="true"></i>@_items.Count(IsRestrictedAccess) restricted</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Govern carrier market access by state, line of business, carrier NAIC, access level, appointment requirements, and underwriting readiness.</p>
        </div>
        <div class="mac-hero__actions">
            <button type="button" class="mac-btn mac-btn--light" @onclick="RefreshAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "mac-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="mac-btn mac-btn--primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Rule</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger mac-alert" style="border-left: 4px solid #dc3545; animation: mac-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@_loadError</span></div>
    }

    <section class="mac-kpi-strip" aria-label="Market access KPIs">
        @KpiCard("all", "Total Rules", _items.Count.ToString(), "All configured market access rules", "bi-key", "blue")
        @KpiCard("active", "Active", _items.Count(x => x.IsActive).ToString(), "Rules available for market access workflows", "bi-check-circle", "green")
        @KpiCard("open", "Open", _items.Count(IsOpenAccess).ToString(), "Open or broadly available market access", "bi-unlock", "cyan")
        @KpiCard("restricted", "Restricted", _items.Count(IsRestrictedAccess).ToString(), "Restricted, closed, or appointment-required access", "bi-lock", "red")
        @KpiCard("targeted", "Targeted", _items.Count(IsTargeted).ToString(), "Rules scoped to carrier, state, or LOB", "bi-bullseye", "amber")
        @KpiCard("review", "Needs Review", _items.Count(NeedsReview).ToString(), "Inactive, incomplete, or weak access definitions", "bi-exclamation-octagon", "purple")
    </section>

    <section class="mac-workflows" aria-label="Market access workflows">
        <button type="button" class="mac-workflow" @onclick='() => SetDashboardFocus("all", "importance")'><span class="mac-workflow-icon"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></span><span class="mac-workflow-meta"><strong>Priority review</strong><span>Rank rules by access risk, market impact, and priority</span></span></button>
        <button type="button" class="mac-workflow" @onclick='() => SetDashboardFocus("open", "priority")'><span class="mac-workflow-icon"><i class="bi bi-unlock" aria-hidden="true"></i></span><span class="mac-workflow-meta"><strong>Open markets</strong><span>Focus available markets for faster placement routing</span></span></button>
        <button type="button" class="mac-workflow" @onclick='() => SetDashboardFocus("restricted", "priority")'><span class="mac-workflow-icon"><i class="bi bi-lock" aria-hidden="true"></i></span><span class="mac-workflow-meta"><strong>Restriction review</strong><span>Audit appointment-required, restricted, and closed access</span></span></button>
        <button type="button" class="mac-workflow" @onclick='() => SetDashboardFocus("review", "importance")'><span class="mac-workflow-icon"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i></span><span class="mac-workflow-meta"><strong>Cleanup queue</strong><span>Resolve incomplete state, LOB, or requirement definitions</span></span></button>
        <button type="button" class="mac-workflow" @onclick='() => SetDashboardFocus("states", "state")'><span class="mac-workflow-icon"><i class="bi bi-map" aria-hidden="true"></i></span><span class="mac-workflow-meta"><strong>State coverage</strong><span>Compare market access coverage by state</span></span></button>
    </section>

    <section class="mac-filter-panel" aria-label="Market access filters">
        <div class="mac-search"><i class="bi bi-search" aria-hidden="true"></i><input type="search" placeholder="Search rule name, state, LOB, carrier NAIC, access level, or requirements..." aria-label="Search market access rules" value="@_searchTerm" @oninput="args => OnSearchInputValue(args.Value?.ToString())" /></div>
        <div class="mac-filter-grid">
            <label><span>Access Level</span><select class="form-select" @bind="_accessFilter" @bind:after="ApplyFilters"><option value="">All levels</option>@foreach (var level in _accessLevels) { <option value="@level">@level</option> }</select></label>
            <label><span>Status</span><select class="form-select" @bind="_statusFilter" @bind:after="ApplyFilters"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option><option value="Targeted">Targeted</option><option value="NeedsReview">Needs review</option></select></label>
            <label><span>Sort</span><select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters"><option value="importance">Importance</option><option value="priority">Priority</option><option value="state">State</option><option value="name">Rule name</option><option value="lob">LOB</option><option value="level">Access level</option><option value="created">Newest</option></select></label>
        </div>
        <button type="button" class="mac-btn mac-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
    </section>

    <nav class="mac-tabs" aria-label="Market access views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="mac-tab @(_activeTab == tab.Key ? "mac-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)"><i class="bi @tab.Icon" aria-hidden="true"></i><span>@tab.Label</span><strong>@TabCount(tab.Key)</strong></button>
        }
    </nav>

    <main class="mac-dashboard">
        <section class="mac-main-card">
            <div class="mac-card-header">
                <div><span class="mac-section-kicker">@ActiveViewTitle</span><h2>@FilteredRules.Count() access rules</h2><p>Prioritized by enterprise importance: active state, restriction posture, state/LOB targeting, requirements completeness, carrier scope, and priority.</p></div>
                <div class="mac-card-actions">
                    @if (_selectedIds.Count > 0)
                    {
                        <span class="mac-sel-count">@_selectedIds.Count selected</span>
                        <button type="button" class="mac-btn mac-btn--ghost" @onclick="() => ConfirmBulkToggle(true)"><i class="bi bi-check-circle" aria-hidden="true"></i> Activate</button>
                        <button type="button" class="mac-btn mac-btn--danger-ghost" @onclick="() => ConfirmBulkToggle(false)"><i class="bi bi-slash-circle" aria-hidden="true"></i> Deactivate</button>
                        <button type="button" class="mac-btn mac-btn--danger-ghost" @onclick="ConfirmBulkDelete"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                    }
                    <button type="button" class="mac-btn mac-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="mac-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="mac-btn mac-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="mac-loading"><span class="mac-spinner"></span> Loading market access rules...</div>
            }
            else if (!FilteredRules.Any())
            {
                <div class="mac-empty"><i class="bi bi-key" aria-hidden="true"></i><strong>No market access rules found</strong><span>Adjust the active KPI, tab, search, or filters.</span></div>
            }
            else if (_activeTab == "states")
            {
                <div class="mac-group-grid">
                    @foreach (var group in StateGroups)
                    {
                        <article class="mac-group-card"><div class="mac-group-icon"><i class="bi bi-map" aria-hidden="true"></i></div><div class="mac-group-meta"><h3>@group.Name</h3><p>@group.Count rules - @group.Active active - @group.Restricted restricted - @group.ReviewCount need review</p><div class="mac-mini-bar"><span style="width:@group.Percent%"></span></div></div><button type="button" class="mac-btn mac-btn--ghost" @onclick="() => FilterByState(group.Name)">Open</button></article>
                    }
                </div>
            }
            else
            {
                <div class="mac-table-wrap">
                    <table class="mac-table">
                        <thead><tr><th class="mac-check-col"><input type="checkbox" checked="@AllPageSelected" @onchange="args => ToggleSelectAllPage(args.Value is bool value && value)" aria-label="Select all market access rules on page" /></th><th>Importance</th><th>Rule</th><th>State</th><th>LOB</th><th>Carrier</th><th>Access</th><th>Priority</th><th>Status</th><th class="mac-actions-col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var rule in PagedRules)
                            {
                                <tr class="@(_selected?.MarketAccessRuleId == rule.MarketAccessRuleId ? "mac-row mac-row--selected" : "mac-row")" @onclick="() => SelectRow(rule)">
                                    <td class="mac-check-col" @onclick:stopPropagation="true"><input type="checkbox" checked="@IsSelected(rule)" @onchange="args => ToggleSelect(rule, args.Value is bool value && value)" aria-label="Select market access rule" /></td>
                                    <td><span class="mac-risk-badge @ImportanceBadgeClass(rule)">@ImportanceScore(rule)</span></td>
                                    <td><div class="mac-rule-cell"><div class="mac-avatar" style="@AvatarStyle(rule.RuleName)" aria-hidden="true">@Initials(rule.RuleName)</div><div class="mac-rule-meta"><button type="button" class="mac-link-button" @onclick:stopPropagation="true" @onclick="() => OpenEdit(rule)">@rule.RuleName</button><small>@RuleSignal(rule)</small></div></div></td>
                                    <td><span class="mac-pill mac-pill--blue">@Safe(rule.StateCode, "All states")</span></td>
                                    <td><span class="mac-pill mac-pill--cyan">@Safe(rule.LobCode, "All LOB")</span></td>
                                    <td><span class="mac-date">@Safe(rule.CarrierNaic, "All carriers")</span></td>
                                    <td><span class="mac-pill @AccessBadgeClass(rule)"><i class="bi @AccessIcon(rule.AccessLevel)" aria-hidden="true"></i>@Safe(rule.AccessLevel, "Unspecified")</span></td>
                                    <td><span class="mac-date">@rule.Priority</span></td>
                                    <td><span class="mac-pill @(rule.IsActive ? "mac-pill--green" : "mac-pill--neutral")">@(rule.IsActive ? "Active" : "Inactive")</span></td>
                                    <td class="mac-actions-col" @onclick:stopPropagation="true"><button type="button" class="mac-icon-btn" title="Edit market access rule" @onclick="() => OpenEdit(rule)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="mac-icon-btn @(rule.IsActive ? "mac-icon-btn--danger" : "")" title="@(rule.IsActive ? "Deactivate rule" : "Activate rule")" @onclick="() => ConfirmToggle(rule)"><i class="bi @(rule.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i></button><button type="button" class="mac-icon-btn mac-icon-btn--danger" title="Delete market access rule" @onclick="() => ConfirmDelete(rule)"><i class="bi bi-trash" aria-hidden="true"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="mac-side-panel" aria-label="Market access insights">
            <section class="mac-panel-card">
                <span class="mac-section-kicker">Selected rule</span>
                @if (_selected is null)
                {
                    <div class="mac-empty mac-empty--compact"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select an access rule</strong><span>Open details, recommendations, and quick actions.</span></div>
                }
                else
                {
                    <div class="mac-selected__title"><div class="mac-avatar mac-avatar--lg" style="@AvatarStyle(_selected.RuleName)" aria-hidden="true">@Initials(_selected.RuleName)</div><div><h3>@_selected.RuleName</h3><span>@Safe(_selected.StateCode, "All states") - @Safe(_selected.LobCode, "All LOB")</span></div></div>
                    <div class="mac-score-card @ImportanceClass(_selected)"><span>Importance score</span><strong>@ImportanceScore(_selected)</strong><small>@RecommendedAction(_selected)</small></div>
                    <dl class="mac-detail-list"><div><dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd></div><div><dt>Access</dt><dd>@Safe(_selected.AccessLevel, "Unspecified")</dd></div><div><dt>State</dt><dd>@Safe(_selected.StateCode, "All states")</dd></div><div><dt>LOB</dt><dd>@Safe(_selected.LobCode, "All LOB")</dd></div><div><dt>Carrier</dt><dd>@Safe(_selected.CarrierNaic, "All carriers")</dd></div><div><dt>Priority</dt><dd>@_selected.Priority</dd></div><div><dt>Created</dt><dd>@FormatDate(_selected.CreatedDateUtc)</dd></div></dl>
                    <p class="mac-description"><strong>Requirements:</strong> @Safe(_selected.Requirements, "No special requirements recorded.")</p>
                    <div class="mac-selected-actions"><button type="button" class="mac-btn mac-btn--primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="mac-btn mac-btn--ghost" @onclick="() => ConfirmToggle(_selected)"><i class="bi @(_selected.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i> @(_selected.IsActive ? "Deactivate" : "Activate")</button><button type="button" class="mac-btn mac-btn--danger-ghost" @onclick="() => ConfirmDelete(_selected)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                }
            </section>
            <section class="mac-panel-card"><span class="mac-section-kicker">Enterprise insights</span><div class="mac-insight-list"><div class="mac-insight"><i class="bi bi-unlock" aria-hidden="true"></i><div><strong>Open access</strong><span>@OpenInsight</span></div></div><div class="mac-insight"><i class="bi bi-lock" aria-hidden="true"></i><div><strong>Restriction posture</strong><span>@RestrictionInsight</span></div></div><div class="mac-insight"><i class="bi bi-bullseye" aria-hidden="true"></i><div><strong>Targeting readiness</strong><span>@TargetingInsight</span></div></div></div></section>
        </aside>
    </main>
</div>

@if (_showForm)
{
    <div class="mac-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="market-access-form-title">
        <div class="mac-modal">
            <div class="mac-modal__header"><i class="bi bi-key" aria-hidden="true"></i><span id="market-access-form-title">@(_editId.HasValue ? "Edit Market Access Rule" : "Add Market Access Rule")</span><button type="button" class="mac-icon-btn mac-icon-btn--light ms-auto" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator />
                <div class="mac-modal__body"><div class="mac-form-grid">
                    <label class="mac-field"><span>Rule Name <em>*</em></span><InputText @bind-Value="_form.RuleName" class="form-control" placeholder="CA Commercial Auto Access" /></label>
                    <label class="mac-field"><span>Carrier NAIC</span><InputText @bind-Value="_form.CarrierNaic" class="form-control" placeholder="Optional carrier NAIC" /></label>
                    <label class="mac-field"><span>State Code</span><InputText @bind-Value="_form.StateCode" class="form-control" placeholder="CA" /></label>
                    <label class="mac-field"><span>LOB Code</span><InputText @bind-Value="_form.LobCode" class="form-control" placeholder="AUTO" /></label>
                    <label class="mac-field"><span>Access Level</span><InputSelect @bind-Value="_form.AccessLevel" class="form-select"><option value="">Unspecified</option>@foreach (var level in _accessLevels) { <option value="@level">@level</option> }</InputSelect></label>
                    <label class="mac-field"><span>Priority</span><InputNumber @bind-Value="_form.Priority" class="form-control" /></label>
                    <label class="mac-field mac-field--wide"><span>Requirements</span><InputTextArea @bind-Value="_form.Requirements" class="form-control" rows="4" placeholder="Appointment, state filing, underwriting, or eligibility requirements" /></label>
                    @if (_editId.HasValue) { <label class="mac-check-field"><InputCheckbox @bind-Value="_form.IsActive" /><span>Active</span></label> }
                </div></div>
                <div class="mac-modal__footer"><button type="button" class="mac-btn mac-btn--ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="mac-btn mac-btn--primary" disabled="@_saving">@if (_saving) { <span class="mac-spin-sm"></span> } @(_editId.HasValue ? "Save Changes" : "Create Rule")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_confirmVisible)
{
    <div class="mac-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="market-access-confirm-title"><div class="mac-confirm"><div class="mac-confirm__body"><div class="mac-confirm-icon mac-confirm-icon--danger"><i class="bi @_confirmIcon" aria-hidden="true"></i></div><div><h3 id="market-access-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div></div><div class="mac-modal__footer"><button type="button" class="mac-btn mac-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button><button type="button" class="mac-btn mac-btn--danger" @onclick="ExecuteConfirmedAsync" disabled="@_saving">@if (_saving) { <span class="mac-spin-sm"></span> } Confirm</button></div></div></div>
}

<div class="mac-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="mac-toast mac-toast--@toast.Kind"><i class="bi @(toast.Kind == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    }
</div>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    Guid TenantId { get; set; }
    static readonly string[] _accessLevels = ["Open", "Restricted", "Appointment Required", "Closed"];
    readonly List<DashboardTab> _tabs = [new("all", "All", "bi-key"), new("active", "Active", "bi-check-circle"), new("open", "Open", "bi-unlock"), new("restricted", "Restricted", "bi-lock"), new("targeted", "Targeted", "bi-bullseye"), new("review", "Needs Review", "bi-exclamation-octagon"), new("states", "States", "bi-map")];
    List<MarketAccessRuleDto> _items = [];
    HashSet<Guid> _selectedIds = [];
    List<ToastItem> _toasts = [];
    MarketAccessRuleDto? _selected;
    AccessForm _form = new();
    Func<Task>? _confirmAction;
    Guid? _editId;
    string _activeTab = "all";
    string _searchTerm = string.Empty;
    string _accessFilter = string.Empty;
    string _statusFilter = string.Empty;
    string _sortMode = "importance";
    string _confirmTitle = string.Empty;
    string _confirmMessage = string.Empty;
    string _confirmIcon = "bi-exclamation-triangle-fill";
    string? _loadError;
    bool _loading;
    bool _saving;
    bool _showForm;
    bool _confirmVisible;
    int _page = 1;
    const int PageSize = 12;

    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Carrier Config", null), new("Market Access Rules", null)); await LoadAsync(); }

    IEnumerable<MarketAccessRuleDto> FilteredRules
    {
        get
        {
            IEnumerable<MarketAccessRuleDto> query = _items;
            query = _activeTab switch { "active" => query.Where(x => x.IsActive), "open" => query.Where(IsOpenAccess), "restricted" => query.Where(IsRestrictedAccess), "targeted" => query.Where(IsTargeted), "review" => query.Where(NeedsReview), _ => query };
            if (!string.IsNullOrWhiteSpace(_searchTerm)) query = query.Where(MatchesSearch);
            if (!string.IsNullOrWhiteSpace(_accessFilter)) query = query.Where(x => string.Equals(x.AccessLevel, _accessFilter, StringComparison.OrdinalIgnoreCase));
            query = _statusFilter switch { "Active" => query.Where(x => x.IsActive), "Inactive" => query.Where(x => !x.IsActive), "Targeted" => query.Where(IsTargeted), "NeedsReview" => query.Where(NeedsReview), _ => query };
            return _sortMode switch { "priority" => query.OrderBy(x => x.Priority).ThenBy(x => x.RuleName), "state" => query.OrderBy(x => x.StateCode).ThenBy(x => x.Priority), "name" => query.OrderBy(x => x.RuleName), "lob" => query.OrderBy(x => x.LobCode).ThenBy(x => x.Priority), "level" => query.OrderBy(x => x.AccessLevel).ThenBy(x => x.Priority), "created" => query.OrderByDescending(x => x.CreatedDateUtc), _ => query.OrderByDescending(ImportanceScore).ThenBy(x => x.Priority).ThenBy(x => x.RuleName) };
        }
    }

    List<MarketAccessRuleDto> PagedRules => FilteredRules.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRules.Count() / (double)PageSize));
    bool AllPageSelected => PagedRules.Count > 0 && PagedRules.All(IsSelected);
    bool HasFilters => !string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_accessFilter) || !string.IsNullOrWhiteSpace(_statusFilter) || _activeTab != "all" || _sortMode != "importance";
    string ActiveViewTitle => _tabs.FirstOrDefault(x => x.Key == _activeTab)?.Label ?? "All";
    string OpenInsight => _items.Any(IsOpenAccess) ? $"{_items.Count(IsOpenAccess)} open rules can support immediate placement routing." : "No open market access rules are configured.";
    string RestrictionInsight => _items.Any(IsRestrictedAccess) ? $"{_items.Count(IsRestrictedAccess)} restricted or closed rules require appointment governance." : "No restricted access posture was detected.";
    string TargetingInsight => _items.Count == 0 ? "Create market access rules before measuring targeting readiness." : $"{_items.Count(IsTargeted)} of {_items.Count} rules are scoped to carrier, state, or LOB.";
    List<StateGroupSummary> StateGroups => _items.GroupBy(x => Safe(x.StateCode, "All states")).Select(g => new StateGroupSummary(g.Key, g.Count(), g.Count(x => x.IsActive), g.Count(IsRestrictedAccess), g.Count(NeedsReview), _items.Count == 0 ? 0 : Math.Round(g.Count() * 100m / _items.Count, 0))).OrderByDescending(x => x.Count).ToList();

    async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchMarketAccessRulesAsync(TenantId, null, pageSize: 500); _items = result?.Items.ToList() ?? []; _selectedIds.RemoveWhere(id => _items.All(x => x.MarketAccessRuleId != id)); _selected = _selected is null ? _items.OrderByDescending(ImportanceScore).FirstOrDefault() : _items.FirstOrDefault(x => x.MarketAccessRuleId == _selected.MarketAccessRuleId) ?? _items.OrderByDescending(ImportanceScore).FirstOrDefault(); NormalizePage(); } catch (Exception ex) { _loadError = $"Failed to load market access rules: {ex.Message}"; } finally { _loading = false; } }
    Task RefreshAsync() => LoadAsync();
    void ApplyFilters() { _page = 1; NormalizePage(); }
    void OnSearchInputValue(string? value) { _searchTerm = value ?? string.Empty; ApplyFilters(); }
    void SetDashboardFocus(string tab, string sort) { _activeTab = tab; _sortMode = sort; _page = 1; NormalizePage(); }
    void SetActiveTab(string tab) { _activeTab = tab; _page = 1; NormalizePage(); }
    void PreviousPage() { if (_page > 1) _page--; }
    void NextPage() { if (_page < TotalPages) _page++; }
    void NormalizePage() { if (_page > TotalPages) _page = TotalPages; }
    void SelectRow(MarketAccessRuleDto item) => _selected = item;
    bool IsSelected(MarketAccessRuleDto item) => _selectedIds.Contains(item.MarketAccessRuleId);
    void ToggleSelect(MarketAccessRuleDto item, bool selected) { if (selected) _selectedIds.Add(item.MarketAccessRuleId); else _selectedIds.Remove(item.MarketAccessRuleId); _selected = item; }
    void ToggleSelectAllPage(bool selected) { foreach (var item in PagedRules) { if (selected) _selectedIds.Add(item.MarketAccessRuleId); else _selectedIds.Remove(item.MarketAccessRuleId); } }
    void ClearFilters() { _searchTerm = string.Empty; _accessFilter = string.Empty; _statusFilter = string.Empty; _sortMode = "importance"; _activeTab = "all"; _page = 1; }
    void FilterByState(string state) { _activeTab = "all"; _searchTerm = state == "All states" ? string.Empty : state; _sortMode = "importance"; _page = 1; }
    void OpenCreate() { _editId = null; _form = new() { AccessLevel = "Open", Priority = 100, IsActive = true }; _showForm = true; }
    void OpenEdit(MarketAccessRuleDto item) { _selected = item; _editId = item.MarketAccessRuleId; _form = new() { RuleName = item.RuleName, CarrierNaic = item.CarrierNaic, StateCode = item.StateCode, LobCode = item.LobCode, AccessLevel = item.AccessLevel, Requirements = item.Requirements, Priority = item.Priority, IsActive = item.IsActive }; _showForm = true; }
    void CloseForm() { _showForm = false; ResetForm(); }
    void ResetForm() { _form = new(); _editId = null; }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue) await Api.UpdateMarketAccessRuleAsync(_editId.Value, new(_form.RuleName.Trim(), NormalizeNullable(_form.CarrierNaic), NormalizeNullable(_form.StateCode), NormalizeNullable(_form.LobCode), NormalizeNullable(_form.AccessLevel), NormalizeNullable(_form.Requirements), _form.Priority, _form.IsActive));
            else await Api.CreateMarketAccessRuleAsync(new(TenantId, _form.RuleName.Trim(), NormalizeNullable(_form.CarrierNaic), NormalizeNullable(_form.StateCode), NormalizeNullable(_form.LobCode), NormalizeNullable(_form.AccessLevel), NormalizeNullable(_form.Requirements), _form.Priority));
            _showForm = false; ShowToast("success", _editId.HasValue ? "Market access rule updated successfully." : "Market access rule created successfully."); ResetForm(); await LoadAsync();
        }
        catch (Exception ex) { ShowToast("danger", $"Save failed: {ex.Message}"); }
        finally { _saving = false; }
    }

    void ConfirmToggle(MarketAccessRuleDto item) { var enable = !item.IsActive; OpenConfirm(enable ? "Activate Market Access Rule" : "Deactivate Market Access Rule", $"Are you sure you want to {(enable ? "activate" : "deactivate")} {item.RuleName}? This changes availability in carrier access workflows.", "bi-shield-exclamation", () => SetRuleActiveAsync(item, enable)); }
    void ConfirmBulkToggle(bool enable) => OpenConfirm(enable ? "Activate Selected Rules" : "Deactivate Selected Rules", $"Are you sure you want to {(enable ? "activate" : "deactivate")} {_selectedIds.Count} selected market access rule(s)?", "bi-shield-exclamation", () => BulkSetActiveAsync(enable));
    void ConfirmDelete(MarketAccessRuleDto item) => OpenConfirm("Delete Market Access Rule", $"Delete {item.RuleName}? This cannot be undone.", "bi-trash", () => DeleteRuleAsync(item));
    void ConfirmBulkDelete() => OpenConfirm("Delete Selected Rules", $"Delete {_selectedIds.Count} selected market access rule(s)? This cannot be undone.", "bi-trash", BulkDeleteAsync);
    void OpenConfirm(string title, string message, string icon, Func<Task> action) { _confirmTitle = title; _confirmMessage = message; _confirmIcon = icon; _confirmAction = action; _confirmVisible = true; }
    void CloseConfirm() { _confirmVisible = false; _confirmAction = null; }
    async Task ExecuteConfirmedAsync() { if (_confirmAction is null) return; _saving = true; try { await _confirmAction(); _confirmVisible = false; _confirmAction = null; } finally { _saving = false; } }
    async Task SetRuleActiveAsync(MarketAccessRuleDto item, bool active) { try { await Api.UpdateMarketAccessRuleAsync(item.MarketAccessRuleId, new(item.RuleName, item.CarrierNaic, item.StateCode, item.LobCode, item.AccessLevel, item.Requirements, item.Priority, active)); ShowToast("success", active ? "Market access rule activated." : "Market access rule deactivated."); await LoadAsync(); } catch (Exception ex) { ShowToast("danger", $"Update failed: {ex.Message}"); } }
    async Task BulkSetActiveAsync(bool active) { var selected = _items.Where(x => _selectedIds.Contains(x.MarketAccessRuleId)).ToList(); var updated = 0; foreach (var item in selected) { try { await Api.UpdateMarketAccessRuleAsync(item.MarketAccessRuleId, new(item.RuleName, item.CarrierNaic, item.StateCode, item.LobCode, item.AccessLevel, item.Requirements, item.Priority, active)); updated++; } catch (Exception ex) { ShowToast("danger", $"Update failed for {item.RuleName}: {ex.Message}"); } } ShowToast("success", $"{updated} market access rule(s) {(active ? "activated" : "deactivated")}. "); _selectedIds.Clear(); await LoadAsync(); }
    async Task DeleteRuleAsync(MarketAccessRuleDto item) { try { await Api.DeleteMarketAccessRuleAsync(item.MarketAccessRuleId); ShowToast("success", "Market access rule deleted."); _selectedIds.Remove(item.MarketAccessRuleId); if (_selected?.MarketAccessRuleId == item.MarketAccessRuleId) _selected = null; await LoadAsync(); } catch (Exception ex) { ShowToast("danger", $"Delete failed: {ex.Message}"); } }
    async Task BulkDeleteAsync() { var selected = _items.Where(x => _selectedIds.Contains(x.MarketAccessRuleId)).ToList(); var deleted = 0; foreach (var item in selected) { try { await Api.DeleteMarketAccessRuleAsync(item.MarketAccessRuleId); deleted++; } catch (Exception ex) { ShowToast("danger", $"Delete failed for {item.RuleName}: {ex.Message}"); } } ShowToast("success", $"{deleted} market access rule(s) deleted."); _selectedIds.Clear(); _selected = null; await LoadAsync(); }

    RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string color) => @<button type="button" class="mac-kpi-card mac-kpi-card--@color @(_activeTab == key ? "mac-kpi-card--active" : null)" title="@subtitle" @onclick="() => SetActiveTab(key)"><span class="mac-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span><span class="mac-kpi-body"><span class="mac-kpi-label">@label</span><strong class="mac-kpi-value">@value</strong><span class="mac-kpi-sub">@subtitle</span></span></button>;
    int TabCount(string key) => key switch { "active" => _items.Count(x => x.IsActive), "open" => _items.Count(IsOpenAccess), "restricted" => _items.Count(IsRestrictedAccess), "targeted" => _items.Count(IsTargeted), "review" => _items.Count(NeedsReview), "states" => StateGroups.Count, _ => _items.Count };
    bool MatchesSearch(MarketAccessRuleDto item) { var term = _searchTerm.Trim(); return Contains(item.RuleName, term) || Contains(item.StateCode, term) || Contains(item.LobCode, term) || Contains(item.CarrierNaic, term) || Contains(item.AccessLevel, term) || Contains(item.Requirements, term) || Contains(RuleSignal(item), term); }
    static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string? NormalizeNullable(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    static string FormatDate(DateTime date) => date == default ? "-" : date.ToLocalTime().ToString("MMM d, yyyy");
    static bool IsOpenAccess(MarketAccessRuleDto item) => string.Equals(item.AccessLevel, "Open", StringComparison.OrdinalIgnoreCase);
    static bool IsRestrictedAccess(MarketAccessRuleDto item) => item.AccessLevel is "Restricted" or "Appointment Required" or "Closed";
    static bool IsTargeted(MarketAccessRuleDto item) => !string.IsNullOrWhiteSpace(item.CarrierNaic) || !string.IsNullOrWhiteSpace(item.StateCode) || !string.IsNullOrWhiteSpace(item.LobCode);
    static bool HasRequirements(MarketAccessRuleDto item) => !string.IsNullOrWhiteSpace(item.Requirements);
    static bool NeedsReview(MarketAccessRuleDto item) => !item.IsActive || string.IsNullOrWhiteSpace(item.RuleName) || string.IsNullOrWhiteSpace(item.StateCode) || string.IsNullOrWhiteSpace(item.AccessLevel) || (IsRestrictedAccess(item) && !HasRequirements(item));
    static string RuleSignal(MarketAccessRuleDto item) { if (IsRestrictedAccess(item)) return "Restriction"; if (IsOpenAccess(item)) return "Open access"; if (NeedsReview(item)) return "Needs review"; if (IsTargeted(item)) return "Targeted"; return "Standard"; }
    static string AccessIcon(string? level) => level switch { "Open" => "bi-unlock", "Restricted" => "bi-lock", "Appointment Required" => "bi-calendar-check", "Closed" => "bi-slash-circle", _ => "bi-question-circle" };
    static string AccessBadgeClass(MarketAccessRuleDto item) => item.AccessLevel switch { "Open" => "mac-pill--green", "Restricted" => "mac-pill--purple", "Appointment Required" => "mac-pill--amber", "Closed" => "mac-pill--red", _ => "mac-pill--blue" };
    static int ImportanceScore(MarketAccessRuleDto item) { var score = 30; if (item.IsActive) score += 12; else score += 16; if (IsRestrictedAccess(item)) score += 24; if (IsOpenAccess(item)) score += 14; if (IsTargeted(item)) score += 10; if (HasRequirements(item)) score += 8; else if (IsRestrictedAccess(item)) score += 10; if (item.Priority <= 25) score += 8; else if (item.Priority <= 100) score += 4; return Math.Clamp(score, 0, 100); }
    static string RecommendedAction(MarketAccessRuleDto item) { if (!item.IsActive) return "Review whether this market access rule should remain inactive."; if (IsRestrictedAccess(item) && !HasRequirements(item)) return "Add requirements for restricted or appointment-required access."; if (IsRestrictedAccess(item)) return "Restricted rule should be reviewed for appointment governance."; if (IsOpenAccess(item)) return "Open access rule is ready for placement routing workflows."; if (!IsTargeted(item)) return "Consider state, LOB, or carrier targeting for more precise access matching."; return "Rule is ready for market access workflows."; }
    static string ImportanceClass(MarketAccessRuleDto item) => ImportanceScore(item) switch { >= 80 => "mac-score-card--red", >= 65 => "mac-score-card--amber", >= 45 => "mac-score-card--cyan", _ => "mac-score-card--green" };
    static string ImportanceBadgeClass(MarketAccessRuleDto item) => ImportanceScore(item) switch { >= 80 => "mac-risk-badge--red", >= 65 => "mac-risk-badge--amber", >= 45 => "mac-risk-badge--cyan", _ => "mac-risk-badge--green" };
    static string Initials(string? value) { var parts = (value ?? string.Empty).Split(' ', '-', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); return parts.Length switch { 0 => "MA", 1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(), _ => string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0]))) }; }
    static string AvatarStyle(string? value) { var hash = Math.Abs((value ?? "MarketAccess").GetHashCode()); var hue = hash % 360; return $"background:linear-gradient(135deg,hsl({hue},78%,48%),hsl({(hue + 35) % 360},82%,36%));"; }
    void ShowToast(string kind, string message) { _toasts.Insert(0, new(Guid.NewGuid(), kind, message)); if (_toasts.Count > 4) _toasts.RemoveRange(4, _toasts.Count - 4); }
    void DismissToast(Guid id) => _toasts.RemoveAll(x => x.Id == id);
    async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); TenantId = context.TenantId; TenantAdminUserId = context.UserId; DevTenantId = context.TenantId; DevUserId = context.UserId; }
    sealed class AccessForm { [Required, StringLength(160)] public string RuleName { get; set; } = string.Empty; [StringLength(20)] public string? CarrierNaic { get; set; } [StringLength(10)] public string? StateCode { get; set; } [StringLength(100)] public string? LobCode { get; set; } [StringLength(80)] public string? AccessLevel { get; set; } = "Open"; [StringLength(500)] public string? Requirements { get; set; } [Range(0, 9999)] public int Priority { get; set; } = 100; public bool IsActive { get; set; } = true; }
    sealed record DashboardTab(string Key, string Label, string Icon);
    sealed record StateGroupSummary(string Name, int Count, int Active, int Restricted, int ReviewCount, decimal Percent);
    sealed record ToastItem(Guid Id, string Kind, string Message);
}