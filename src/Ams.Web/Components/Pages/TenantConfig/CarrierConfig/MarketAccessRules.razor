@page "/tenant/carriers/access"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.CarrierRules
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
<PageTitle>Market Access Rules — Carrier Configuration</PageTitle>
<AppPageHeader Title="Market Access Rules" Subtitle="Configure carrier market access by state, line of business, and requirements" Icon="bi-key"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> Add Rule</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<div class="pc-kpi-strip"><div class="pc-kpi-card @(_activeFilter==""?"pc-kpi-card--active":"")" @onclick='()=>SetFilter("")' title="Show all appointments" style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-key"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total</div></div></div><div class="pc-kpi-card @(_activeFilter=="active"?"pc-kpi-card--active":"")" @onclick='()=>SetFilter("active")' title="Filter active appointments" style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x=>x.IsActive)</div><div class="pc-kpi-label">Active</div></div></div><div class="pc-kpi-card @(_activeFilter=="restricted"?"pc-kpi-card--active":"")" @onclick='()=>SetFilter("restricted")' title="Filter restricted access rules" style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-lock"></i></span><div><div class="pc-kpi-value">@_items.Count(x=>x.AccessLevel=="Restricted"||x.AccessLevel=="Closed")</div><div class="pc-kpi-label">Restricted</div></div></div></div>
@if(_loadError is not null){<div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div>}
<AppFilterPanel @bind-SearchValue="_search" OnSearch="OnSearchAsync" SearchPlaceholder="Search access rule, state, or LOB..." />
<div class="um-grid-card">@if(_loading){<div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading...</span></div>}<SfGrid TValue="MarketAccessRuleDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52"><GridEvents TValue="MarketAccessRuleDto" RowSelected="OnRowSelected"/><GridPageSettings PageSize="25"/><GridColumns><GridColumn Field="RuleName" HeaderText="Rule" Width="220"/><GridColumn Field="StateCode" HeaderText="State" Width="90"/><GridColumn Field="LobCode" HeaderText="LOB" Width="100"/><GridColumn Field="AccessLevel" HeaderText="Access" Width="130"/><GridColumn Field="Priority" HeaderText="Priority" Width="90" TextAlign="TextAlign.Center"/><GridColumn Field="IsActive" HeaderText="Status" Width="100" TextAlign="TextAlign.Center"><Template>@{var r=(MarketAccessRuleDto)context;}<span class="um-badge @(r.IsActive?"um-badge-success":"um-badge-neutral")">@(r.IsActive?"Active":"Inactive")</span></Template></GridColumn><GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Center"><Template>@{var r=(MarketAccessRuleDto)context;}<button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="()=>OpenEdit(r)"><i class="bi bi-pencil"></i></button></Template></GridColumn></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="580px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm"/><DialogContent><div class="um-modal-header"><i class="bi bi-key"></i><span>@(_editId.HasValue?"Edit Appointment":"Add Rule")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="()=>_showForm=false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator/><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Rule Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.RuleName" class="um-input"/><ValidationMessage For="()=>_form.RuleName" class="validation-message text-danger"/></div><div class="um-field"><label>State <span class="text-danger">*</span></label><InputText @bind-Value="_form.StateCode" class="um-input"/><ValidationMessage For="()=>_form.StateCode" class="validation-message text-danger"/></div><div class="um-field"><label>LOB Code</label><InputText @bind-Value="_form.LobCode" class="um-input"/><ValidationMessage For="()=>_form.LobCode" class="validation-message text-danger"/></div><div class="um-field"><label>Appointment Date</label><SfDropDownList TValue="string" TItem="string" @bind-Value="_form.AccessLevel" DataSource="@(new[]{"Open","Restricted","Appointment Required","Closed"})"/><ValidationMessage For="()=>_form.AccessLevel" class="validation-message text-danger"/></div><div class="um-field"><label>Expiration Date</label><InputTextArea @bind-Value="_form.Requirements" class="um-input" rows="2"/><ValidationMessage For="()=>_form.Requirements" class="validation-message text-danger"/></div><div class="um-field"><label>Priority</label><InputNumber @bind-Value="_form.Priority" class="um-input"/><ValidationMessage For="()=>_form.Priority" class="validation-message text-danger"/></div><div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsActive"/> Active</label></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="()=>_showForm=false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue?"Save Changes":"Create")</button></div></EditForm></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true"><ToastPosition X="Right" Y="Bottom"/></SfToast><style>.validation-message{display:flex;align-items:center;gap:.45rem;margin-top:.55rem;color:#dc3545!important;font-size:.875rem;font-weight:700}.validation-message::before{content:"!";display:inline-flex;align-items:center;justify-content:center;width:1rem;height:1rem;min-width:1rem;flex-shrink:0;border-radius:999px;color:#fff;background:linear-gradient(135deg,#ef4444,#b91c1c);font-size:.7rem;font-weight:800}</style>
@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;Guid TenantId { get; set; }List<MarketAccessRuleDto> _items=[];List<MarketAccessRuleDto> _filtered=[];string _activeFilter="";bool _loading,_saving,_showForm;string _search=string.Empty;string? _loadError;Guid? _editId;SfToast _toast=default!;AccessForm _form=new();protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();Breadcrumbs.SetCrumbs(new("Home","/"),new("Carrier Config",null),new("Market Access Rules",null));await LoadAsync();}async Task LoadAsync(){_loading=true;_loadError=null;try{var r=await Api.SearchMarketAccessRulesAsync(TenantId,_search,pageSize:200);_items=r?.Items.ToList()??[];ApplyFilter();}catch(Exception ex){_loadError=ex.Message;}finally{_loading=false;}}void SetFilter(string f){_activeFilter=f;ApplyFilter();}void ApplyFilter()=>_filtered=_activeFilter switch{"active"=>_items.Where(x=>x.IsActive).ToList(),"restricted"=>_items.Where(x=>x.AccessLevel=="Restricted"||x.AccessLevel=="Closed").ToList(),_=>[.._items]};Task OnSearchAsync()=>LoadAsync();void OnRowSelected(RowSelectEventArgs<MarketAccessRuleDto> args)=>OpenEdit(args.Data);void OpenCreate(){_editId=null;_form=new();_showForm=true;}void OpenEdit(MarketAccessRuleDto i){_editId=i.MarketAccessRuleId;_form=new(){CarrierNaic=i.CarrierNaic,RuleName=i.RuleName,StateCode=i.StateCode,LobCode=i.LobCode,AccessLevel=i.AccessLevel,Requirements=i.Requirements,Priority=i.Priority,IsActive=i.IsActive};_showForm=true;}async Task SaveAsync(){_saving=true;try{if(_editId.HasValue)await Api.UpdateMarketAccessRuleAsync(_editId.Value,new(_form.RuleName,_form.CarrierNaic,_form.StateCode,_form.LobCode,_form.AccessLevel,_form.Requirements,_form.Priority,_form.IsActive));else await Api.CreateMarketAccessRuleAsync(new(TenantId,_form.RuleName,_form.CarrierNaic,_form.StateCode,_form.LobCode,_form.AccessLevel,_form.Requirements,_form.Priority));_showForm=false;await _toast.ShowAsync(new(){Content="Saved successfully",CssClass="e-toast-success"});await LoadAsync();}catch(Exception ex){await _toast.ShowAsync(new(){Content=$"Save failed: {ex.Message}",CssClass="e-toast-danger"});}finally{_saving=false;}}void ResetForm(){_form=new();_editId=null;}sealed class AccessForm{[Required,StringLength(160)]public string RuleName{get;set;}=string.Empty;[StringLength(20)]public string? CarrierNaic{get;set;}[StringLength(10)]public string? StateCode{get;set;}[StringLength(100)]public string? LobCode{get;set;}[StringLength(80)]public string? AccessLevel{get;set;}[StringLength(500)]public string? Requirements{get;set;}[Range(0,9999)]public int Priority{get;set;}=100;public bool IsActive{get;set;}=true;}
    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}


