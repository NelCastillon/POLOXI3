@page "/tenant/carriers/appointments"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.CarrierConfig
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
<PageTitle>Carrier Appointments — Carrier Configuration</PageTitle>
<AppPageHeader Title="Carrier Appointments" Subtitle="Manage carrier appointments by state and line of business" Icon="bi-calendar-check"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> Add Appointment</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<div class="pc-kpi-strip"><div class="pc-kpi-card @(_activeFilter==""?"pc-kpi-card--active":"")" @onclick='()=>SetFilter("")' title="Show all appointments" style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-calendar-check"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total</div></div></div><div class="pc-kpi-card @(_activeFilter=="active"?"pc-kpi-card--active":"")" @onclick='()=>SetFilter("active")' title="Filter active appointments" style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x=>x.IsActive)</div><div class="pc-kpi-label">Active</div></div></div><div class="pc-kpi-card @(_activeFilter=="expiring"?"pc-kpi-card--active":"")" @onclick='()=>SetFilter("expiring")' title="Filter expiring appointments" style="cursor:pointer"><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-hourglass-split"></i></span><div><div class="pc-kpi-value">@_items.Count(x=>x.ExpirationDate.HasValue&&x.ExpirationDate.Value<=DateTime.Today.AddDays(60))</div><div class="pc-kpi-label">Expiring</div></div></div></div>
@if(_loadError is not null){<div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div>}
<AppFilterPanel @bind-SearchValue="_search" OnSearch="OnSearchAsync" SearchPlaceholder="Search appointment, state, or LOB..." />
<div class="um-grid-card">@if(_loading){<div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading...</span></div>}<SfGrid TValue="CarrierAppointmentDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52"><GridEvents TValue="CarrierAppointmentDto" RowSelected="OnRowSelected"/><GridPageSettings PageSize="25"/><GridColumns><GridColumn Field="AppointmentCode" HeaderText="Code" Width="160"/><GridColumn Field="StateCode" HeaderText="State" Width="90"/><GridColumn Field="LineOfBusiness" HeaderText="Line of Business" Width="190"/><GridColumn Field="AppointmentDate" HeaderText="Appointed" Width="130" Format="d"/><GridColumn Field="ExpirationDate" HeaderText="Expires" Width="130" Format="d"/><GridColumn Field="IsActive" HeaderText="Status" Width="100" TextAlign="TextAlign.Center"><Template>@{var r=(CarrierAppointmentDto)context;}<span class="um-badge @(r.IsActive?"um-badge-success":"um-badge-neutral")">@(r.IsActive?"Active":"Inactive")</span></Template></GridColumn><GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Center"><Template>@{var r=(CarrierAppointmentDto)context;}<button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="()=>OpenEdit(r)"><i class="bi bi-pencil"></i></button></Template></GridColumn></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="580px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm"/><DialogContent><div class="um-modal-header"><i class="bi bi-calendar-check"></i><span>@(_editId.HasValue?"Edit Appointment":"Add Appointment")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="()=>_showForm=false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator/><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Appointment Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.AppointmentCode" class="um-input"/><ValidationMessage For="()=>_form.AppointmentCode" class="validation-message text-danger"/></div><div class="um-field"><label>State <span class="text-danger">*</span></label><InputText @bind-Value="_form.StateCode" class="um-input"/><ValidationMessage For="()=>_form.StateCode" class="validation-message text-danger"/></div><div class="um-field"><label>Line of Business</label><InputText @bind-Value="_form.LineOfBusiness" class="um-input"/><ValidationMessage For="()=>_form.LineOfBusiness" class="validation-message text-danger"/></div><div class="um-field"><label>Appointment Date</label><InputDate @bind-Value="_form.AppointmentDate" class="um-input"/><ValidationMessage For="()=>_form.AppointmentDate" class="validation-message text-danger"/></div><div class="um-field"><label>Expiration Date</label><InputDate @bind-Value="_form.ExpirationDate" class="um-input"/><ValidationMessage For="()=>_form.ExpirationDate" class="validation-message text-danger"/></div><div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsActive"/> Active</label></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="()=>_showForm=false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue?"Save Changes":"Create")</button></div></EditForm></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true"><ToastPosition X="Right" Y="Bottom"/></SfToast><style>.validation-message{display:flex;align-items:center;gap:.45rem;margin-top:.55rem;color:#dc3545!important;font-size:.875rem;font-weight:700}.validation-message::before{content:"!";display:inline-flex;align-items:center;justify-content:center;width:1rem;height:1rem;min-width:1rem;flex-shrink:0;border-radius:999px;color:#fff;background:linear-gradient(135deg,#ef4444,#b91c1c);font-size:.7rem;font-weight:800}</style>
@code{static readonly Guid TenantId=Guid.Parse("00000000-0000-0000-0000-000000000001");List<CarrierAppointmentDto> _items=[];List<CarrierAppointmentDto> _filtered=[];string _activeFilter="";bool _loading,_saving,_showForm;string _search=string.Empty;string? _loadError;Guid? _editId;SfToast _toast=default!;AppointmentForm _form=new();protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Carrier Config",null),new("Carrier Appointments",null));await LoadAsync();}async Task LoadAsync(){_loading=true;_loadError=null;try{var r=await Api.SearchCarrierAppointmentsAsync(TenantId,_search,pageSize:200);_items=r?.Items.ToList()??[];ApplyFilter();}catch(Exception ex){_loadError=ex.Message;}finally{_loading=false;}}void SetFilter(string f){_activeFilter=f;ApplyFilter();}void ApplyFilter()=>_filtered=_activeFilter switch{"active"=>_items.Where(x=>x.IsActive).ToList(),"expiring"=>_items.Where(x=>x.ExpirationDate.HasValue&&x.ExpirationDate.Value<=DateTime.Today.AddDays(60)).ToList(),_=>[.._items]};Task OnSearchAsync()=>LoadAsync();void OnRowSelected(RowSelectEventArgs<CarrierAppointmentDto> args)=>OpenEdit(args.Data);void OpenCreate(){_editId=null;_form=new();_showForm=true;}void OpenEdit(CarrierAppointmentDto i){_editId=i.CarrierAppointmentId;_form=new(){CarrierId=i.CarrierId,AppointmentCode=i.AppointmentCode,StateCode=i.StateCode,LineOfBusiness=i.LineOfBusiness,AppointmentDate=i.AppointmentDate,ExpirationDate=i.ExpirationDate,IsActive=i.IsActive};_showForm=true;}async Task SaveAsync(){_saving=true;try{if(_editId.HasValue)await Api.UpdateCarrierAppointmentAsync(_editId.Value,new(_form.CarrierId,_form.AppointmentCode,_form.StateCode,_form.LineOfBusiness,_form.AppointmentDate,_form.ExpirationDate,_form.IsActive));else await Api.CreateCarrierAppointmentAsync(new(TenantId,_form.CarrierId,_form.AppointmentCode,_form.StateCode,_form.LineOfBusiness,_form.AppointmentDate,_form.ExpirationDate));_showForm=false;await _toast.ShowAsync(new(){Content="Saved successfully",CssClass="e-toast-success"});await LoadAsync();}catch(Exception ex){await _toast.ShowAsync(new(){Content=$"Save failed: {ex.Message}",CssClass="e-toast-danger"});}finally{_saving=false;}}void ResetForm(){_form=new();_editId=null;}sealed class AppointmentForm{public Guid? CarrierId{get;set;}[Required,StringLength(80)]public string AppointmentCode{get;set;}=string.Empty;[Required,StringLength(10)]public string StateCode{get;set;}=string.Empty;[StringLength(100)]public string? LineOfBusiness{get;set;}public DateTime? AppointmentDate{get;set;}public DateTime? ExpirationDate{get;set;}public bool IsActive{get;set;}=true;}}
