@page "/tenant/carriers/appetite"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.Appetite
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Carrier Appetite Command Center — Carrier Configuration</PageTitle>

<div class="apt-page">
    <section class="apt-hero">
        <div class="apt-hero__content">
            <div class="apt-hero-left">
                <span class="apt-hero-icon"><i class="bi bi-grid-3x3" aria-hidden="true"></i></span>
                <div class="apt-hero-title">
                    <div class="apt-hero__eyebrow">Enterprise appetite governance</div>
                    <div class="apt-title-row">
                        <h1>Carrier Appetite Command Center</h1>
                        <div class="apt-hero__meta">
                            <span><i class="bi bi-grid-3x3" aria-hidden="true"></i>@_items.Count rules</span>
                            <span><i class="bi bi-check-circle" aria-hidden="true"></i>@_items.Count(x => x.IsActive) active</span>
                            <span><i class="bi bi-star-fill" aria-hidden="true"></i>@_items.Count(IsPreferred) preferred</span>
                            <span><i class="bi bi-lock" aria-hidden="true"></i>@_items.Count(IsRestricted) restricted</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Govern carrier appetite by line of business, carrier NAIC, rule logic, priority, restriction risk, and underwriting readiness for market selection workflows.</p>
        </div>
        <div class="apt-hero__actions">
            <button type="button" class="apt-btn apt-btn--light" @onclick="RefreshAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "apt-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="apt-btn apt-btn--primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Rule</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger apt-alert" style="border-left: 4px solid #dc3545; animation: apt-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@_loadError</span></div>
    }

    <section class="apt-kpi-strip" aria-label="Carrier appetite KPIs">
        @KpiCard("all", "Total Rules", _items.Count.ToString(), "All configured appetite rules", "bi-grid-3x3", "blue")
        @KpiCard("active", "Active", _items.Count(x => x.IsActive).ToString(), "Rules available for appetite matching", "bi-check-circle", "green")
        @KpiCard("preferred", "Preferred", _items.Count(IsPreferred).ToString(), "Preferred carrier appetite rules", "bi-star-fill", "amber")
        @KpiCard("restricted", "Restricted", _items.Count(IsRestricted).ToString(), "Restricted, closed, or declined appetite", "bi-lock", "red")
        @KpiCard("targeted", "Targeted", _items.Count(IsTargeted).ToString(), "Rules scoped to carrier or LOB", "bi-bullseye", "cyan")
        @KpiCard("review", "Needs Review", _items.Count(NeedsReview).ToString(), "Inactive, incomplete, or weak rule definitions", "bi-exclamation-octagon", "purple")
    </section>

    <section class="apt-workflows" aria-label="Carrier appetite workflows">
        <button type="button" class="apt-workflow" @onclick='() => SetDashboardFocus("all", "importance")'><span class="apt-workflow-icon"><i class="bi bi-bar-chart-line" aria-hidden="true"></i></span><span class="apt-workflow-meta"><strong>Priority review</strong><span>Rank rules by market impact, restriction risk, and priority</span></span></button>
        <button type="button" class="apt-workflow" @onclick='() => SetDashboardFocus("preferred", "priority")'><span class="apt-workflow-icon"><i class="bi bi-star-fill" aria-hidden="true"></i></span><span class="apt-workflow-meta"><strong>Preferred markets</strong><span>Focus appetite rules that should drive placement</span></span></button>
        <button type="button" class="apt-workflow" @onclick='() => SetDashboardFocus("restricted", "priority")'><span class="apt-workflow-icon"><i class="bi bi-lock" aria-hidden="true"></i></span><span class="apt-workflow-meta"><strong>Restriction review</strong><span>Audit restricted and declined market access rules</span></span></button>
        <button type="button" class="apt-workflow" @onclick='() => SetDashboardFocus("review", "importance")'><span class="apt-workflow-icon"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i></span><span class="apt-workflow-meta"><strong>Cleanup queue</strong><span>Resolve inactive, incomplete, and weak rule definitions</span></span></button>
        <button type="button" class="apt-workflow" @onclick='() => SetDashboardFocus("levels", "level")'><span class="apt-workflow-icon"><i class="bi bi-pie-chart" aria-hidden="true"></i></span><span class="apt-workflow-meta"><strong>Appetite mix</strong><span>Compare preferred, standard, restricted, and declined rules</span></span></button>
    </section>

    <section class="apt-filter-panel" aria-label="Carrier appetite filters">
        <div class="apt-search"><i class="bi bi-search" aria-hidden="true"></i><input type="search" placeholder="Search rule name, LOB, carrier NAIC, appetite level, or rule JSON…" aria-label="Search carrier appetite rules" value="@_searchTerm" @oninput="args => OnSearchInputValue(args.Value?.ToString())" /></div>
        <div class="apt-filter-grid">
            <label><span>Appetite Level</span><select class="form-select" @bind="_levelFilter" @bind:after="ApplyFilters"><option value="">All levels</option>@foreach (var level in _appetiteLevels) { <option value="@level">@level</option> }</select></label>
            <label><span>Status</span><select class="form-select" @bind="_statusFilter" @bind:after="ApplyFilters"><option value="">All statuses</option><option value="Active">Active</option><option value="Inactive">Inactive</option><option value="Targeted">Targeted</option><option value="NeedsReview">Needs review</option></select></label>
            <label><span>Sort</span><select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters"><option value="importance">Importance</option><option value="priority">Priority</option><option value="name">Rule name</option><option value="lob">LOB</option><option value="level">Appetite level</option><option value="created">Newest</option></select></label>
        </div>
        <button type="button" class="apt-btn apt-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
    </section>

    <nav class="apt-tabs" aria-label="Carrier appetite views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="apt-tab @(_activeTab == tab.Key ? "apt-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)"><i class="bi @tab.Icon" aria-hidden="true"></i><span>@tab.Label</span><strong>@TabCount(tab.Key)</strong></button>
        }
    </nav>

    <main class="apt-dashboard">
        <section class="apt-main-card">
            <div class="apt-card-header">
                <div><span class="apt-section-kicker">@ActiveViewTitle</span><h2>@FilteredRules.Count() appetite rules</h2><p>Prioritized by enterprise importance: active state, appetite level, priority, carrier/LOB targeting, rule JSON readiness, and restriction risk.</p></div>
                <div class="apt-card-actions">
                    @if (_selectedIds.Count > 0)
                    {
                        <span class="apt-sel-count">@_selectedIds.Count selected</span>
                        <button type="button" class="apt-btn apt-btn--ghost" @onclick="() => ConfirmBulkToggle(true)"><i class="bi bi-check-circle" aria-hidden="true"></i> Activate</button>
                        <button type="button" class="apt-btn apt-btn--danger-ghost" @onclick="() => ConfirmBulkToggle(false)"><i class="bi bi-slash-circle" aria-hidden="true"></i> Deactivate</button>
                    }
                    <button type="button" class="apt-btn apt-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="apt-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="apt-btn apt-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="apt-loading"><span class="apt-spinner"></span> Loading carrier appetite rules…</div>
            }
            else if (!FilteredRules.Any())
            {
                <div class="apt-empty"><i class="bi bi-grid-3x3" aria-hidden="true"></i><strong>No appetite rules found</strong><span>Adjust the active KPI, tab, search, or filters.</span></div>
            }
            else if (_activeTab == "levels")
            {
                <div class="apt-group-grid">
                    @foreach (var group in LevelGroups)
                    {
                        <article class="apt-group-card"><div class="apt-group-icon"><i class="bi @AppetiteIcon(group.Name)" aria-hidden="true"></i></div><div class="apt-group-meta"><h3>@group.Name</h3><p>@group.Count rules • @group.Active active • @group.Targeted targeted • @group.ReviewCount need review</p><div class="apt-mini-bar"><span style="width:@group.Percent%"></span></div></div><button type="button" class="apt-btn apt-btn--ghost" @onclick="() => FilterByLevel(group.Name)">Open</button></article>
                    }
                </div>
            }
            else
            {
                <div class="apt-table-wrap">
                    <table class="apt-table">
                        <thead><tr><th class="apt-check-col"><input type="checkbox" checked="@AllPageSelected" @onchange="args => ToggleSelectAllPage(args.Value is bool value && value)" aria-label="Select all appetite rules on page" /></th><th>Importance</th><th>Rule</th><th>LOB</th><th>Carrier</th><th>Appetite</th><th>Priority</th><th>Status</th><th class="apt-actions-col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var rule in PagedRules)
                            {
                                <tr class="@(_selected?.AppetiteRuleId == rule.AppetiteRuleId ? "apt-row apt-row--selected" : "apt-row")" @onclick="() => SelectRow(rule)">
                                    <td class="apt-check-col" @onclick:stopPropagation="true"><input type="checkbox" checked="@IsSelected(rule)" @onchange="args => ToggleSelect(rule, args.Value is bool value && value)" aria-label="Select appetite rule" /></td>
                                    <td><span class="apt-risk-badge @ImportanceBadgeClass(rule)">@ImportanceScore(rule)</span></td>
                                    <td><div class="apt-rule-cell"><div class="apt-avatar" style="@AvatarStyle(rule.RuleName)" aria-hidden="true">@Initials(rule.RuleName)</div><div class="apt-rule-meta"><button type="button" class="apt-link-button" @onclick:stopPropagation="true" @onclick="() => OpenEdit(rule)">@rule.RuleName</button><small>@RuleSignal(rule)</small></div></div></td>
                                    <td><span class="apt-pill apt-pill--cyan">@Safe(rule.LobCode, "All LOB")</span></td>
                                    <td><span class="apt-date">@Safe(rule.CarrierNaic, "All carriers")</span></td>
                                    <td><span class="apt-pill @AppetiteBadgeClass(rule)"><i class="bi @AppetiteIcon(rule.AppetiteLevel)" aria-hidden="true"></i>@rule.AppetiteLevel</span></td>
                                    <td><span class="apt-date">@rule.Priority</span></td>
                                    <td><span class="apt-pill @(rule.IsActive ? "apt-pill--green" : "apt-pill--neutral")">@(rule.IsActive ? "Active" : "Inactive")</span></td>
                                    <td class="apt-actions-col" @onclick:stopPropagation="true"><button type="button" class="apt-icon-btn" title="Edit appetite rule" @onclick="() => OpenEdit(rule)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="apt-icon-btn @(rule.IsActive ? "apt-icon-btn--danger" : "")" title="@(rule.IsActive ? "Deactivate rule" : "Activate rule")" @onclick="() => ConfirmToggle(rule)"><i class="bi @(rule.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="apt-side-panel" aria-label="Carrier appetite insights">
            <section class="apt-panel-card">
                <span class="apt-section-kicker">Selected rule</span>
                @if (_selected is null)
                {
                    <div class="apt-empty apt-empty--compact"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select an appetite rule</strong><span>Open details, recommendations, and quick actions.</span></div>
                }
                else
                {
                    <div class="apt-selected__title"><div class="apt-avatar apt-avatar--lg" style="@AvatarStyle(_selected.RuleName)" aria-hidden="true">@Initials(_selected.RuleName)</div><div><h3>@_selected.RuleName</h3><span>@Safe(_selected.LobCode, "All LOB") • @Safe(_selected.CarrierNaic, "All carriers")</span></div></div>
                    <div class="apt-score-card @ImportanceClass(_selected)"><span>Importance score</span><strong>@ImportanceScore(_selected)</strong><small>@RecommendedAction(_selected)</small></div>
                    <dl class="apt-detail-list"><div><dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd></div><div><dt>Level</dt><dd>@_selected.AppetiteLevel</dd></div><div><dt>LOB</dt><dd>@Safe(_selected.LobCode, "All LOB")</dd></div><div><dt>Carrier</dt><dd>@Safe(_selected.CarrierNaic, "All carriers")</dd></div><div><dt>Priority</dt><dd>@_selected.Priority</dd></div><div><dt>Created</dt><dd>@FormatDate(_selected.CreatedDateUtc)</dd></div></dl>
                    <p class="apt-description"><strong>Rule JSON:</strong> @ShortRuleJson(_selected.RuleJson)</p>
                    <div class="apt-selected-actions"><button type="button" class="apt-btn apt-btn--primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="apt-btn apt-btn--ghost" @onclick="() => ConfirmToggle(_selected)"><i class="bi @(_selected.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i> @(_selected.IsActive ? "Deactivate" : "Activate")</button></div>
                }
            </section>
            <section class="apt-panel-card"><span class="apt-section-kicker">Enterprise insights</span><div class="apt-insight-list"><div class="apt-insight"><i class="bi bi-star-fill" aria-hidden="true"></i><div><strong>Preferred access</strong><span>@PreferredInsight</span></div></div><div class="apt-insight"><i class="bi bi-lock" aria-hidden="true"></i><div><strong>Restriction posture</strong><span>@RestrictionInsight</span></div></div><div class="apt-insight"><i class="bi bi-bullseye" aria-hidden="true"></i><div><strong>Targeting readiness</strong><span>@TargetingInsight</span></div></div></div></section>
        </aside>
    </main>
</div>

@if (_showForm)
{
    <div class="apt-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="carrier-appetite-form-title">
        <div class="apt-modal">
            <div class="apt-modal__header"><i class="bi bi-grid-3x3" aria-hidden="true"></i><span id="carrier-appetite-form-title">@(_editId.HasValue ? "Edit Appetite Rule" : "Add Appetite Rule")</span><button type="button" class="apt-icon-btn apt-icon-btn--light ms-auto" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator />
                <div class="apt-modal__body"><div class="apt-validation-note"><i class="bi bi-info-circle" aria-hidden="true"></i><div><strong>Appetite governance</strong><span>Rules drive appetite matching, market recommendations, carrier restrictions, and underwriting routing.</span></div></div><div class="apt-form-grid">
                    <label class="apt-field"><span>Rule Name <em>*</em></span><InputText @bind-Value="_form.RuleName" class="form-control" placeholder="Preferred Commercial Auto" /><ValidationMessage For="() => _form.RuleName" class="text-danger" /></label>
                    <label class="apt-field"><span>Carrier NAIC</span><InputText @bind-Value="_form.CarrierNaic" class="form-control" placeholder="Optional carrier NAIC" /><ValidationMessage For="() => _form.CarrierNaic" class="text-danger" /></label>
                    <label class="apt-field"><span>LOB Code <em>*</em></span><InputText @bind-Value="_form.LobCode" class="form-control" placeholder="AUTO" /><ValidationMessage For="() => _form.LobCode" class="text-danger" /></label>
                    <label class="apt-field"><span>Appetite Level <em>*</em></span><InputSelect @bind-Value="_form.AppetiteLevel" class="form-select">@foreach (var level in _appetiteLevels) { <option value="@level">@level</option> }</InputSelect><ValidationMessage For="() => _form.AppetiteLevel" class="text-danger" /></label>
                    <label class="apt-field"><span>Priority</span><InputNumber @bind-Value="_form.Priority" class="form-control" /><ValidationMessage For="() => _form.Priority" class="text-danger" /></label>
                    <label class="apt-field apt-field--wide"><span>Rule JSON <em>*</em></span><InputTextArea @bind-Value="_form.RuleJson" class="form-control" rows="4" placeholder="{}" /><ValidationMessage For="() => _form.RuleJson" class="text-danger" /></label>
                    @if (_editId.HasValue) { <label class="apt-check-field"><InputCheckbox @bind-Value="_form.IsActive" /><span>Active</span></label> }
                </div></div>
                <div class="apt-modal__footer"><button type="button" class="apt-btn apt-btn--ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="apt-btn apt-btn--primary" disabled="@_saving">@if (_saving) { <span class="apt-spin-sm"></span> } @(_editId.HasValue ? "Save Changes" : "Create Rule")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_confirmVisible)
{
    <div class="apt-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="carrier-appetite-confirm-title"><div class="apt-confirm"><div class="apt-confirm__body"><div class="apt-confirm-icon apt-confirm-icon--danger"><i class="bi @_confirmIcon" aria-hidden="true"></i></div><div><h3 id="carrier-appetite-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div></div><div class="apt-modal__footer"><button type="button" class="apt-btn apt-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button><button type="button" class="apt-btn apt-btn--danger" @onclick="ExecuteConfirmedAsync" disabled="@_saving">@if (_saving) { <span class="apt-spin-sm"></span> } Confirm</button></div></div></div>
}

<div class="apt-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="apt-toast apt-toast--@toast.Kind"><i class="bi @(toast.Kind == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
    }
</div>

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    Guid TenantId { get; set; }
    static readonly string[] _appetiteLevels = ["Preferred", "Standard", "Restricted", "Declined", "Closed"];
    readonly List<DashboardTab> _tabs = [new("all", "All", "bi-grid-3x3"), new("active", "Active", "bi-check-circle"), new("preferred", "Preferred", "bi-star-fill"), new("restricted", "Restricted", "bi-lock"), new("targeted", "Targeted", "bi-bullseye"), new("review", "Needs Review", "bi-exclamation-octagon"), new("levels", "Levels", "bi-pie-chart")];
    List<AppetiteRuleDto> _items = [];
    HashSet<Guid> _selectedIds = [];
    List<ToastItem> _toasts = [];
    AppetiteRuleDto? _selected;
    AppetiteForm _form = new();
    Func<Task>? _confirmAction;
    Guid? _editId;
    string _activeTab = "all";
    string _searchTerm = string.Empty;
    string _levelFilter = string.Empty;
    string _statusFilter = string.Empty;
    string _sortMode = "importance";
    string _confirmTitle = string.Empty;
    string _confirmMessage = string.Empty;
    string _confirmIcon = "bi-exclamation-triangle-fill";
    string? _loadError;
    bool _loading;
    bool _saving;
    bool _showForm;
    bool _confirmVisible;
    int _page = 1;
    const int PageSize = 12;

    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Carrier Config", null), new("Carrier Appetite Rules", null)); await LoadAsync(); }

    IEnumerable<AppetiteRuleDto> FilteredRules
    {
        get
        {
            IEnumerable<AppetiteRuleDto> query = _items;
            query = _activeTab switch { "active" => query.Where(x => x.IsActive), "preferred" => query.Where(IsPreferred), "restricted" => query.Where(IsRestricted), "targeted" => query.Where(IsTargeted), "review" => query.Where(NeedsReview), _ => query };
            if (!string.IsNullOrWhiteSpace(_searchTerm)) query = query.Where(MatchesSearch);
            if (!string.IsNullOrWhiteSpace(_levelFilter)) query = query.Where(x => string.Equals(x.AppetiteLevel, _levelFilter, StringComparison.OrdinalIgnoreCase));
            query = _statusFilter switch { "Active" => query.Where(x => x.IsActive), "Inactive" => query.Where(x => !x.IsActive), "Targeted" => query.Where(IsTargeted), "NeedsReview" => query.Where(NeedsReview), _ => query };
            return _sortMode switch { "priority" => query.OrderBy(x => x.Priority).ThenBy(x => x.RuleName), "name" => query.OrderBy(x => x.RuleName), "lob" => query.OrderBy(x => x.LobCode).ThenBy(x => x.Priority), "level" => query.OrderBy(x => x.AppetiteLevel).ThenBy(x => x.Priority), "created" => query.OrderByDescending(x => x.CreatedDateUtc), _ => query.OrderByDescending(ImportanceScore).ThenBy(x => x.Priority).ThenBy(x => x.RuleName) };
        }
    }

    List<AppetiteRuleDto> PagedRules => FilteredRules.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRules.Count() / (double)PageSize));
    bool AllPageSelected => PagedRules.Count > 0 && PagedRules.All(IsSelected);
    bool HasFilters => !string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_levelFilter) || !string.IsNullOrWhiteSpace(_statusFilter) || _activeTab != "all" || _sortMode != "importance";
    string ActiveViewTitle => _tabs.FirstOrDefault(x => x.Key == _activeTab)?.Label ?? "All";
    string PreferredInsight => _items.Any(IsPreferred) ? $"{_items.Count(IsPreferred)} preferred rules can drive market recommendations." : "No preferred appetite rules are configured.";
    string RestrictionInsight => _items.Any(IsRestricted) ? $"{_items.Count(IsRestricted)} restricted or closed rules require underwriting governance." : "No restricted appetite rules were detected.";
    string TargetingInsight => _items.Count == 0 ? "Create appetite rules before measuring targeting readiness." : $"{_items.Count(IsTargeted)} of {_items.Count} rules are scoped to carrier or LOB.";
    List<LevelGroupSummary> LevelGroups => _items.GroupBy(x => Safe(x.AppetiteLevel, "Unclassified")).Select(g => new LevelGroupSummary(g.Key, g.Count(), g.Count(x => x.IsActive), g.Count(IsTargeted), g.Count(NeedsReview), _items.Count == 0 ? 0 : Math.Round(g.Count() * 100m / _items.Count, 0))).OrderByDescending(x => x.Count).ToList();

    async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchAppetiteRulesAsync(TenantId, null, pageSize: 500); _items = result?.Items.ToList() ?? []; _selectedIds.RemoveWhere(id => _items.All(x => x.AppetiteRuleId != id)); _selected = _selected is null ? _items.OrderByDescending(ImportanceScore).FirstOrDefault() : _items.FirstOrDefault(x => x.AppetiteRuleId == _selected.AppetiteRuleId) ?? _items.OrderByDescending(ImportanceScore).FirstOrDefault(); NormalizePage(); } catch (Exception ex) { _loadError = $"Failed to load carrier appetite rules: {ex.Message}"; } finally { _loading = false; } }
    Task RefreshAsync() => LoadAsync();
    void ApplyFilters() { _page = 1; NormalizePage(); }
    void OnSearchInputValue(string? value) { _searchTerm = value ?? string.Empty; ApplyFilters(); }
    void SetDashboardFocus(string tab, string sort) { _activeTab = tab; _sortMode = sort; _page = 1; NormalizePage(); }
    void SetActiveTab(string tab) { _activeTab = tab; _page = 1; NormalizePage(); }
    void PreviousPage() { if (_page > 1) _page--; }
    void NextPage() { if (_page < TotalPages) _page++; }
    void NormalizePage() { if (_page > TotalPages) _page = TotalPages; }
    void SelectRow(AppetiteRuleDto item) => _selected = item;
    bool IsSelected(AppetiteRuleDto item) => _selectedIds.Contains(item.AppetiteRuleId);
    void ToggleSelect(AppetiteRuleDto item, bool selected) { if (selected) _selectedIds.Add(item.AppetiteRuleId); else _selectedIds.Remove(item.AppetiteRuleId); _selected = item; }
    void ToggleSelectAllPage(bool selected) { foreach (var item in PagedRules) { if (selected) _selectedIds.Add(item.AppetiteRuleId); else _selectedIds.Remove(item.AppetiteRuleId); } }
    void ClearFilters() { _searchTerm = string.Empty; _levelFilter = string.Empty; _statusFilter = string.Empty; _sortMode = "importance"; _activeTab = "all"; _page = 1; }
    void FilterByLevel(string level) { _activeTab = "all"; _levelFilter = level; _sortMode = "importance"; _page = 1; }
    void OpenCreate() { _editId = null; _form = new() { AppetiteLevel = "Standard", RuleJson = "{}", Priority = 100, IsActive = true }; _showForm = true; }
    void OpenEdit(AppetiteRuleDto item) { _selected = item; _editId = item.AppetiteRuleId; _form = new() { RuleName = item.RuleName, LobCode = item.LobCode, CarrierNaic = item.CarrierNaic, RuleJson = item.RuleJson, AppetiteLevel = item.AppetiteLevel, Priority = item.Priority, IsActive = item.IsActive }; _showForm = true; }
    void CloseForm() { _showForm = false; ResetForm(); }
    void ResetForm() { _form = new(); _editId = null; }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue) await Api.UpdateAppetiteRuleAsync(_editId.Value, new(_form.RuleName.Trim(), _form.LobCode.Trim(), NormalizeNullable(_form.CarrierNaic), _form.RuleJson.Trim(), _form.AppetiteLevel, _form.Priority, _form.IsActive));
            else await Api.CreateAppetiteRuleAsync(new(TenantId, _form.RuleName.Trim(), _form.LobCode.Trim(), NormalizeNullable(_form.CarrierNaic), _form.RuleJson.Trim(), _form.AppetiteLevel, _form.Priority));
            _showForm = false; ShowToast("success", _editId.HasValue ? "Carrier appetite rule updated successfully." : "Carrier appetite rule created successfully."); ResetForm(); await LoadAsync();
        }
        catch (Exception ex) { ShowToast("danger", $"Save failed: {ex.Message}"); }
        finally { _saving = false; }
    }

    void ConfirmToggle(AppetiteRuleDto item) { var enable = !item.IsActive; OpenConfirm(enable ? "Activate Appetite Rule" : "Deactivate Appetite Rule", $"Are you sure you want to {(enable ? "activate" : "deactivate")} {item.RuleName}? This changes availability in appetite matching workflows.", "bi-shield-exclamation", () => SetRuleActiveAsync(item, enable)); }
    void ConfirmBulkToggle(bool enable) => OpenConfirm(enable ? "Activate Selected Rules" : "Deactivate Selected Rules", $"Are you sure you want to {(enable ? "activate" : "deactivate")} {_selectedIds.Count} selected appetite rule(s)?", "bi-shield-exclamation", () => BulkSetActiveAsync(enable));
    void OpenConfirm(string title, string message, string icon, Func<Task> action) { _confirmTitle = title; _confirmMessage = message; _confirmIcon = icon; _confirmAction = action; _confirmVisible = true; }
    void CloseConfirm() { _confirmVisible = false; _confirmAction = null; }
    async Task ExecuteConfirmedAsync() { if (_confirmAction is null) return; _saving = true; try { await _confirmAction(); _confirmVisible = false; _confirmAction = null; } finally { _saving = false; } }
    async Task SetRuleActiveAsync(AppetiteRuleDto item, bool active) { try { await Api.UpdateAppetiteRuleAsync(item.AppetiteRuleId, new(item.RuleName, item.LobCode, item.CarrierNaic, item.RuleJson, item.AppetiteLevel, item.Priority, active)); ShowToast("success", active ? "Appetite rule activated." : "Appetite rule deactivated."); await LoadAsync(); } catch (Exception ex) { ShowToast("danger", $"Update failed: {ex.Message}"); } }
    async Task BulkSetActiveAsync(bool active) { var selected = _items.Where(x => _selectedIds.Contains(x.AppetiteRuleId)).ToList(); var updated = 0; foreach (var item in selected) { try { await Api.UpdateAppetiteRuleAsync(item.AppetiteRuleId, new(item.RuleName, item.LobCode, item.CarrierNaic, item.RuleJson, item.AppetiteLevel, item.Priority, active)); updated++; } catch (Exception ex) { ShowToast("danger", $"Update failed for {item.RuleName}: {ex.Message}"); } } ShowToast("success", $"{updated} appetite rule(s) {(active ? "activated" : "deactivated")}. "); _selectedIds.Clear(); await LoadAsync(); }

    RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string color) => @<button type="button" class="apt-kpi-card apt-kpi-card--@color @(_activeTab == key ? "apt-kpi-card--active" : null)" title="@subtitle" @onclick="() => SetActiveTab(key)"><span class="apt-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span><span class="apt-kpi-body"><span class="apt-kpi-label">@label</span><strong class="apt-kpi-value">@value</strong><span class="apt-kpi-sub">@subtitle</span></span></button>;
    int TabCount(string key) => key switch { "active" => _items.Count(x => x.IsActive), "preferred" => _items.Count(IsPreferred), "restricted" => _items.Count(IsRestricted), "targeted" => _items.Count(IsTargeted), "review" => _items.Count(NeedsReview), "levels" => LevelGroups.Count, _ => _items.Count };
    bool MatchesSearch(AppetiteRuleDto item) { var term = _searchTerm.Trim(); return Contains(item.RuleName, term) || Contains(item.LobCode, term) || Contains(item.CarrierNaic, term) || Contains(item.AppetiteLevel, term) || Contains(item.RuleJson, term) || Contains(RuleSignal(item), term); }
    static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string? NormalizeNullable(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    static string FormatDate(DateTime date) => date == default ? "—" : date.ToLocalTime().ToString("MMM d, yyyy");
    static bool IsPreferred(AppetiteRuleDto item) => item.AppetiteLevel.Equals("Preferred", StringComparison.OrdinalIgnoreCase);
    static bool IsRestricted(AppetiteRuleDto item) => item.AppetiteLevel is "Restricted" or "Declined" or "Closed";
    static bool IsTargeted(AppetiteRuleDto item) => !string.IsNullOrWhiteSpace(item.CarrierNaic) || !string.IsNullOrWhiteSpace(item.LobCode);
    static bool HasRuleJson(AppetiteRuleDto item) => !string.IsNullOrWhiteSpace(item.RuleJson) && item.RuleJson.Trim() != "{}";
    static bool NeedsReview(AppetiteRuleDto item) => !item.IsActive || string.IsNullOrWhiteSpace(item.RuleName) || string.IsNullOrWhiteSpace(item.LobCode) || string.IsNullOrWhiteSpace(item.AppetiteLevel) || !HasRuleJson(item);
    static string RuleSignal(AppetiteRuleDto item) { if (IsRestricted(item)) return "Restriction"; if (IsPreferred(item)) return "Preferred"; if (NeedsReview(item)) return "Needs review"; if (IsTargeted(item)) return "Targeted"; return "Standard"; }
    static string AppetiteIcon(string level) => level switch { "Preferred" => "bi-star-fill", "Standard" => "bi-check2-circle", "Restricted" => "bi-lock", "Declined" => "bi-x-octagon", "Closed" => "bi-slash-circle", _ => "bi-question-circle" };
    static string AppetiteBadgeClass(AppetiteRuleDto item) => item.AppetiteLevel switch { "Preferred" => "apt-pill--amber", "Standard" => "apt-pill--green", "Restricted" => "apt-pill--purple", "Declined" => "apt-pill--red", "Closed" => "apt-pill--neutral", _ => "apt-pill--blue" };
    static int ImportanceScore(AppetiteRuleDto item) { var score = 30; if (item.IsActive) score += 12; else score += 16; if (IsRestricted(item)) score += 24; if (IsPreferred(item)) score += 18; if (IsTargeted(item)) score += 10; if (HasRuleJson(item)) score += 8; else score += 10; if (item.Priority <= 25) score += 8; else if (item.Priority <= 100) score += 4; return Math.Clamp(score, 0, 100); }
    static string RecommendedAction(AppetiteRuleDto item) { if (!item.IsActive) return "Review whether this appetite rule should remain inactive."; if (!HasRuleJson(item)) return "Add rule JSON conditions before relying on appetite matching."; if (IsRestricted(item)) return "Restricted rule should be reviewed for underwriting governance."; if (IsPreferred(item)) return "Preferred appetite rule is ready for market recommendation workflows."; if (!IsTargeted(item)) return "Consider carrier or LOB targeting for more precise appetite matching."; return "Rule is ready for appetite workflows."; }
    static string ImportanceClass(AppetiteRuleDto item) => ImportanceScore(item) switch { >= 80 => "apt-score-card--red", >= 65 => "apt-score-card--amber", >= 45 => "apt-score-card--cyan", _ => "apt-score-card--green" };
    static string ImportanceBadgeClass(AppetiteRuleDto item) => ImportanceScore(item) switch { >= 80 => "apt-risk-badge--red", >= 65 => "apt-risk-badge--amber", >= 45 => "apt-risk-badge--cyan", _ => "apt-risk-badge--green" };
    static string ShortRuleJson(string? json) { var value = Safe(json, "{}").Trim(); return value.Length <= 160 ? value : $"{value[..160]}…"; }
    static string Initials(string? value) { var parts = (value ?? string.Empty).Split(' ', '-', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries); return parts.Length switch { 0 => "AR", 1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(), _ => string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0]))) }; }
    static string AvatarStyle(string? value) { var hash = Math.Abs((value ?? "AppetiteRule").GetHashCode()); var hue = hash % 360; return $"background:linear-gradient(135deg,hsl({hue},78%,48%),hsl({(hue + 35) % 360},82%,36%));"; }
    void ShowToast(string kind, string message) { _toasts.Insert(0, new(Guid.NewGuid(), kind, message)); if (_toasts.Count > 4) _toasts.RemoveRange(4, _toasts.Count - 4); }
    void DismissToast(Guid id) => _toasts.RemoveAll(x => x.Id == id);
    async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); TenantId = context.TenantId; TenantAdminUserId = context.UserId; DevTenantId = context.TenantId; DevUserId = context.UserId; }
    sealed class AppetiteForm { [Required, StringLength(160)] public string RuleName { get; set; } = string.Empty; [Required, StringLength(80)] public string LobCode { get; set; } = string.Empty; [StringLength(20)] public string? CarrierNaic { get; set; } [Required, StringLength(4000)] public string RuleJson { get; set; } = "{}"; [Required, StringLength(80)] public string AppetiteLevel { get; set; } = "Standard"; [Range(0, 9999)] public int Priority { get; set; } = 100; public bool IsActive { get; set; } = true; }
    sealed record DashboardTab(string Key, string Label, string Icon);
    sealed record LevelGroupSummary(string Name, int Count, int Active, int Targeted, int ReviewCount, decimal Percent);
    sealed record ToastItem(Guid Id, string Kind, string Message);
}
