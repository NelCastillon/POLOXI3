@page "/documents/storage"
@page "/tenant/documents/storage"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.DocumentConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Document Storage Settings</PageTitle>

@if (_toastVisible)
{
    <div class="st-toast st-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIcon" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="st-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="st-enterprise-page">
    <section class="st-hero">
        <div class="st-hero-left">
            <span class="st-hero-icon"><i class="bi bi-hdd-network" aria-hidden="true"></i></span>
            <div>
                <div class="st-title-row">
                    <h1>Document Storage Settings</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> DB synced</span>
                    <span><i class="bi bi-shield-lock" aria-hidden="true"></i> Encrypted workflow</span>
                </div>
                <p>Enterprise storage setup workspace for document providers, encryption posture, regions, capacity, archive tiers, lifecycle storage, and audit-ready storage governance.</p>
            </div>
        </div>
        <div class="st-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "st-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync" disabled="@(!_items.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="RunStorageAudit"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Audit</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Storage</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="st-error-banner" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@_loadError</span></div>
    }

    <section class="st-kpi-strip" aria-label="Storage setting KPIs">
        <button type="button" class="@AllKpiClass" @onclick="ShowAll"><span class="st-kpi-icon"><i class="bi bi-hdd-network" aria-hidden="true"></i></span><span><strong>@_items.Count</strong><em>Total Settings</em><small>Configured storage records</small></span></button>
        <button type="button" class="@ActiveKpiClass" @onclick="ShowActive"><span class="st-kpi-icon"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span><span><strong>@ActiveCount</strong><em>Active</em><small>Available to documents</small></span></button>
        <button type="button" class="@EncryptedKpiClass" @onclick="ShowEncrypted"><span class="st-kpi-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span><span><strong>@EncryptedCount</strong><em>Encrypted</em><small>Encryption enabled</small></span></button>
        <button type="button" class="@CapacityKpiClass" @onclick="ShowCapacity"><span class="st-kpi-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span><span><strong>@HighUsageCount</strong><em>High Usage</em><small>At or above 80%</small></span></button>
        <button type="button" class="@ArchiveKpiClass" @onclick="ShowArchive"><span class="st-kpi-icon"><i class="bi bi-archive" aria-hidden="true"></i></span><span><strong>@ArchiveReadyCount</strong><em>Archive Ready</em><small>Tier configured</small></span></button>
        <button type="button" class="@ReviewKpiClass" @onclick="ShowReview"><span class="st-kpi-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></span><span><strong>@NeedsReviewCount</strong><em>Needs Review</em><small>Storage risk or gaps</small></span></button>
    </section>

    <section class="st-workflow-strip" aria-label="Storage workflows">
        <button type="button" class="st-workflow-card" @onclick="ShowLibrary"><i class="bi bi-kanban" aria-hidden="true"></i><span><strong>Library</strong><small>Storage register</small></span></button>
        <button type="button" class="st-workflow-card" @onclick="ShowCapacityView"><i class="bi bi-speedometer2" aria-hidden="true"></i><span><strong>Capacity</strong><small>Usage and tiers</small></span></button>
        <button type="button" class="st-workflow-card" @onclick="ShowGovernance"><i class="bi bi-shield-check" aria-hidden="true"></i><span><strong>Governance</strong><small>Encryption and audit</small></span></button>
        <button type="button" class="st-workflow-card" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i><span><strong>Create</strong><small>Add provider setup</small></span></button>
    </section>

    <section class="st-search-panel">
        <div class="st-search-wrap">
            <span class="st-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="st-search-body">
                <label for="st-search">Storage search</label>
                <input id="st-search" class="st-search-input" @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="Search provider, region, encryption, tier, capacity, JSON..." />
                <span class="st-search-hint">Filters real tenant document storage configuration records.</span>
            </div>
        </div>
        <select class="st-filter-select" @bind="_statusFilter" @bind:after="ApplyFilter" aria-label="Status filter">
            <option value="all">All statuses</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
        <select class="st-filter-select" @bind="_readinessFilter" @bind:after="ApplyFilter" aria-label="Storage readiness filter">
            <option value="all">All readiness</option>
            <option value="encrypted">Encrypted</option>
            <option value="capacity">High usage</option>
            <option value="archive">Archive ready</option>
            <option value="review">Needs review</option>
        </select>
        <select class="st-filter-select" @bind="_providerFilter" @bind:after="ApplyFilter" aria-label="Provider filter">
            <option value="all">All providers</option>
            @foreach (var provider in ProviderOptions)
            {
                <option value="@provider">@provider</option>
            }
        </select>
        <div class="st-search-result"><strong>@_filtered.Count</strong><span>records</span></div>
    </section>

    <nav class="st-view-tabs" aria-label="Storage views">
        @foreach (var view in _views)
        {
            <button type="button" class="st-view-btn @(_activeView == view ? "st-view-btn-active" : null)" @onclick="() => SetView(view)">@view</button>
        }
    </nav>

    <section class="st-content-layout">
        <div class="st-main-card">
            @if (_loading)
            {
                <div class="st-loading"><i class="bi bi-arrow-repeat st-spin" aria-hidden="true"></i><span>Loading storage settings...</span></div>
            }
            else if (_filtered.Count == 0)
            {
                <div class="st-empty-state"><i class="bi bi-hdd-network" aria-hidden="true"></i><h2>No storage settings found</h2><p>Adjust filters or create the first document storage setup record.</p><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Storage</button></div>
            }
            else if (_activeView == "Capacity")
            {
                <div class="st-governance-grid">
                    <section class="st-panel">
                        <header><div><i class="bi bi-speedometer2" aria-hidden="true"></i><strong>Storage Readiness</strong></div><span>@StorageScore.ToString("F0")%</span></header>
                        <div class="st-panel-body st-metric-list">
                            <div class="st-metric-row"><span>Encrypted</span><div><i style="@WidthStyle(EncryptedCount, SafeTotal)"></i></div><strong>@EncryptedCount</strong></div>
                            <div class="st-metric-row"><span>Archive ready</span><div><i style="@WidthStyle(ArchiveReadyCount, SafeTotal)"></i></div><strong>@ArchiveReadyCount</strong></div>
                            <div class="st-metric-row"><span>High usage</span><div><i style="@WidthStyle(HighUsageCount, SafeTotal)"></i></div><strong>@HighUsageCount</strong></div>
                            <div class="st-metric-row"><span>Needs review</span><div><i style="@WidthStyle(NeedsReviewCount, SafeTotal)"></i></div><strong>@NeedsReviewCount</strong></div>
                        </div>
                    </section>
                    <section class="st-panel">
                        <header><div><i class="bi bi-cloud" aria-hidden="true"></i><strong>Providers</strong></div><span>@ProviderOptions.Count</span></header>
                        <div class="st-panel-body st-group-list">
                            @foreach (var provider in ProviderSummaries)
                            {
                                <button type="button" class="st-group-row" @onclick="() => FilterProvider(provider.Name)"><span>@provider.Name</span><div><i style="@WidthStyle(provider.Count, SafeTotal)"></i></div><strong>@provider.Count</strong></button>
                            }
                        </div>
                    </section>
                    <section class="st-panel st-panel-wide">
                        <header><div><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><strong>Storage Review Queue</strong></div><span>@NeedsReviewItems.Count</span></header>
                        <div class="st-panel-body st-review-list">
                            @foreach (var item in NeedsReviewItems.Take(8))
                            {
                                <button type="button" class="st-review-row" @onclick="() => SelectItem(item)"><strong>@item.Name</strong><span>@ReviewReason(item)</span><em>@ReadinessLabel(item)</em></button>
                            }
                        </div>
                    </section>
                </div>
            }
            else if (_activeView == "Governance")
            {
                <div class="st-board">
                    @foreach (var lane in GovernanceLanes)
                    {
                        <section class="st-board-col">
                            <header><strong>@lane.Title</strong><span>@lane.Items.Count</span></header>
                            @foreach (var item in lane.Items)
                            {
                                var meta = ReadMeta(item);
                                <button type="button" class="st-board-card" @onclick="() => SelectItem(item)">
                                    <div><strong>@item.Name</strong><span>@meta.Provider</span></div>
                                    <small>@meta.Region - @meta.Tier - @meta.UsagePercent% used</small>
                                    <em>@ReadinessLabel(item)</em>
                                </button>
                            }
                        </section>
                    }
                </div>
            }
            else
            {
                <div class="st-table-scroll">
                    <table class="st-table">
                        <thead><tr><th>Storage Setting</th><th>Provider</th><th>Region</th><th>Tier</th><th>Usage</th><th>Readiness</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var item in _filtered)
                            {
                                var meta = ReadMeta(item);
                                <tr @onclick="() => SelectItem(item)">
                                    <td><div class="st-name-cell"><span class="st-avatar @AvatarClass(item)">@Initials(item.Name)</span><span><strong>@item.Name</strong><small>@item.Code - @(item.Description ?? "No description provided")</small></span></div></td>
                                    <td><span class="st-code-pill">@meta.Provider</span></td>
                                    <td>@meta.Region</td>
                                    <td>@meta.Tier</td>
                                    <td><div class="st-usage"><span style="@WidthStyle(meta.UsagePercent, 100)"></span></div><small>@meta.UsagePercent%</small></td>
                                    <td><span class="@ReadinessClass(item)">@ReadinessLabel(item)</span></td>
                                    <td><span class="@StatusClass(item)">@StatusLabel(item)</span></td>
                                    <td><div class="st-row-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => TestStorage(item)" title="Validate"><i class="bi bi-wifi" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(item)" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <aside class="st-detail-card" aria-label="Selected storage setting">
            @if (_selected is null)
            {
                <div class="st-detail-empty"><i class="bi bi-hdd-network" aria-hidden="true"></i><h2>Storage command brief</h2><p>Select a storage setting to review provider readiness, capacity, encryption posture, archive tier, and actions.</p></div>
            }
            else
            {
                var selectedMeta = ReadMeta(_selected);
                <div class="st-detail-head"><div><span class="st-detail-eyebrow"><i class="bi bi-hdd-network" aria-hidden="true"></i> @selectedMeta.Provider</span><h2>@_selected.Name</h2><p>@_selected.Code</p></div><span class="@StatusClass(_selected)">@StatusLabel(_selected)</span></div>
                <div class="st-detail-body">
                    <div class="st-detail-summary">
                        <div><span>Readiness</span><strong>@ReadinessLabel(_selected)</strong></div>
                        <div><span>Region</span><strong>@selectedMeta.Region</strong></div>
                        <div><span>Usage</span><strong>@selectedMeta.UsagePercent%</strong></div>
                        <div><span>Tier</span><strong>@selectedMeta.Tier</strong></div>
                    </div>
                    <div class="st-policy-card"><span>Storage controls</span><strong>Encryption: @(selectedMeta.Encrypted ? "Enabled" : "Needs review")</strong><strong>Configuration: @(HasConfiguration(_selected) ? "Present" : "Missing")</strong></div>
                    <div class="st-config-card"><span>Configuration JSON</span><code>@DisplayConfig(_selected)</code></div>
                    <div class="st-detail-actions">
                        <button type="button" class="um-btn um-btn-primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit Storage</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => TestStorage(_selected)"><i class="bi bi-wifi" aria-hidden="true"></i> Validate</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="DuplicateSelected"><i class="bi bi-files" aria-hidden="true"></i> Duplicate</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="ToggleSelectedStatus"><i class="bi bi-power" aria-hidden="true"></i> @(_selected.IsActive ? "Deactivate" : "Activate")</button>
                        <button type="button" class="um-btn um-btn-ghost text-danger" @onclick="() => ConfirmDelete(_selected)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@if (_showForm)
{
    <div class="st-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="st-form-title">
        <div class="st-modal">
            <div class="st-modal-header"><div class="st-modal-title"><span class="st-modal-icon"><i class="bi bi-hdd-network" aria-hidden="true"></i></span><div><h2 id="st-form-title">@(_editId.HasValue ? "Edit Storage Setting" : "Add Storage Setting")</h2><p>Configure provider, region, encryption, capacity, archive tier, and document workflow storage controls.</p></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="ShowValidationToast">
                <DataAnnotationsValidator />
                <div class="st-modal-body">
                    <div class="st-form-banner"><i class="bi bi-info-circle" aria-hidden="true"></i><span><strong>Storage governance</strong> Use stable codes and JSON metadata for provider, region, usagePercent, encrypted, tier, retention, archive, and workflow routing.</span></div>
                    <div class="st-form-grid">
                        <div class="st-field"><label>Code <span>*</span></label><InputText @bind-Value="_form.Code" class="st-input" placeholder="PRIMARY_DOCUMENT_STORE" /></div>
                        <div class="st-field"><label>Name <span>*</span></label><InputText @bind-Value="_form.Name" class="st-input" placeholder="Primary Document Storage" /></div>
                        <div class="st-field"><label>Group</label><InputText @bind-Value="_form.Category" class="st-input" placeholder="Primary, Archive, Compliance..." /></div>
                        <div class="st-field"><label>Sort Order</label><InputNumber @bind-Value="_form.SortOrder" class="st-input" /></div>
                        <div class="st-field st-field-wide"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="st-input" rows="3" /></div>
                        <div class="st-field st-field-wide"><label>Configuration JSON</label><InputTextArea @bind-Value="_form.ConfigurationJson" class="st-input st-code-input" rows="6" placeholder='{"provider":"AzureBlob","region":"East US","usagePercent":42,"encrypted":true,"tier":"Hot"}' /></div>
                        <div class="st-field st-field-wide st-check-row"><label><InputCheckbox @bind-Value="_form.IsActive" /> Active for document storage workflows</label><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ValidateJson" disabled="@_saving"><i class="bi bi-braces" aria-hidden="true"></i> Validate JSON</button></div>
                    </div>
                </div>
                <div class="st-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi bi-check2" aria-hidden="true"></i> @(_editId.HasValue ? "Save Changes" : "Create Storage")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showDelete)
{
    <div class="st-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="st-delete-title">
        <div class="st-confirm-modal">
            <div class="st-confirm-icon"><i class="bi bi-trash3-fill" aria-hidden="true"></i></div>
            <h2 id="st-delete-title">Delete Storage Setting</h2>
            <p>Delete <strong>@_deleteTarget?.Name</strong>? Existing documents may still reference this storage setup historically.</p>
            <div class="st-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CancelDelete">Cancel</button><button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div>
        </div>
    </div>
}

@code {
    private const string ConfigKind = "StorageSetting";
    private const string DefaultConfigurationJson = "{\"provider\":\"AzureBlob\",\"region\":\"Primary\",\"usagePercent\":0,\"encrypted\":true,\"tier\":\"Hot\"}";
    private Guid _tenantId;
    private bool _loading;
    private bool _saving;
    private bool _showForm;
    private bool _showDelete;
    private bool _toastVisible;
    private string _search = string.Empty;
    private string _statusFilter = "all";
    private string _readinessFilter = "all";
    private string _providerFilter = "all";
    private string _activeView = "Library";
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private Guid? _editId;
    private DocumentConfigItemDto? _selected;
    private DocumentConfigItemDto? _deleteTarget;
    private readonly string[] _views = ["Library", "Capacity", "Governance"];
    private List<DocumentConfigItemDto> _items = [];
    private List<DocumentConfigItemDto> _filtered = [];
    private FormModel _form = new();

    private int ActiveCount => _items.Count(x => x.IsActive);
    private int EncryptedCount => _items.Count(IsEncryptedReady);
    private int HighUsageCount => _items.Count(IsHighUsage);
    private int ArchiveReadyCount => _items.Count(IsArchiveReady);
    private int NeedsReviewCount => _items.Count(NeedsReview);
    private int SafeTotal => Math.Max(_items.Count, 1);
    private double StorageScore => _items.Count == 0 ? 0 : (EncryptedCount + ArchiveReadyCount + ActiveCount - NeedsReviewCount) * 100d / Math.Max(_items.Count * 3, 1);
    private List<string> ProviderOptions => _items.Select(x => ReadMeta(x).Provider).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    private List<GroupSummary> ProviderSummaries => _items.GroupBy(x => ReadMeta(x).Provider, StringComparer.OrdinalIgnoreCase).Select(g => new GroupSummary(g.Key, g.Count())).OrderByDescending(x => x.Count).ToList();
    private List<DocumentConfigItemDto> NeedsReviewItems => _items.Where(NeedsReview).OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToList();
    private List<GovernanceLane> GovernanceLanes =>
    [
        new("Encrypted", _filtered.Where(IsEncryptedReady).ToList()),
        new("Archive Ready", _filtered.Where(IsArchiveReady).ToList()),
        new("Needs Review", _filtered.Where(NeedsReview).ToList()),
    ];
    private string ToastIcon => _toastKind == "success" ? "bi-check-circle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-exclamation-triangle-fill";
    private string AllKpiClass => KpiClass("all", "st-blue");
    private string ActiveKpiClass => KpiClass("active", "st-green");
    private string EncryptedKpiClass => KpiClass("encrypted", "st-purple");
    private string CapacityKpiClass => KpiClass("capacity", "st-amber");
    private string ArchiveKpiClass => KpiClass("archive", "st-cyan");
    private string ReviewKpiClass => KpiClass("review", "st-slate");

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Documents & Forms", null), new("Storage Settings", "/tenant/documents/storage"));
        _search = GetQueryValue("searchTerm") ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchDocumentConfigItemsAsync(_tenantId, ConfigKind, _search, pageSize: 1000);
            _items = result?.Items.OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToList() ?? [];
            ApplyFilter();
            _selected ??= _filtered.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilter()
    {
        IEnumerable<DocumentConfigItemDto> query = _items;
        if (!string.IsNullOrWhiteSpace(_search)) query = query.Where(MatchesSearch);
        if (_statusFilter == "active") query = query.Where(x => x.IsActive);
        else if (_statusFilter == "inactive") query = query.Where(x => !x.IsActive);
        if (_readinessFilter == "encrypted") query = query.Where(IsEncryptedReady);
        else if (_readinessFilter == "capacity") query = query.Where(IsHighUsage);
        else if (_readinessFilter == "archive") query = query.Where(IsArchiveReady);
        else if (_readinessFilter == "review") query = query.Where(NeedsReview);
        if (_providerFilter != "all") query = query.Where(x => string.Equals(ReadMeta(x).Provider, _providerFilter, StringComparison.OrdinalIgnoreCase));
        _filtered = query.OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToList();
        if (_selected is not null && !_filtered.Any(x => x.DocumentConfigItemId == _selected.DocumentConfigItemId)) _selected = _filtered.FirstOrDefault();
    }

    private void ShowAll() { _statusFilter = "all"; _readinessFilter = "all"; _providerFilter = "all"; ApplyFilter(); }
    private void ShowActive() { _statusFilter = "active"; _readinessFilter = "all"; ApplyFilter(); }
    private void ShowEncrypted() { _statusFilter = "all"; _readinessFilter = "encrypted"; ApplyFilter(); }
    private void ShowCapacity() { _statusFilter = "all"; _readinessFilter = "capacity"; ApplyFilter(); }
    private void ShowArchive() { _statusFilter = "all"; _readinessFilter = "archive"; ApplyFilter(); }
    private void ShowReview() { _statusFilter = "all"; _readinessFilter = "review"; ApplyFilter(); }
    private void ShowLibrary() => SetView("Library");
    private void ShowCapacityView() => SetView("Capacity");
    private void ShowGovernance() => SetView("Governance");
    private void SetView(string view) => _activeView = view;
    private void FilterProvider(string provider) { _providerFilter = provider; ApplyFilter(); }
    private void SelectItem(DocumentConfigItemDto item) => _selected = item;

    private void OpenCreate()
    {
        _editId = null;
        _form = new() { Category = "Storage", ConfigurationJson = DefaultConfigurationJson, IsActive = true, SortOrder = NextSortOrder };
        _showForm = true;
    }

    private void OpenEdit(DocumentConfigItemDto item)
    {
        _editId = item.DocumentConfigItemId;
        _form = new()
        {
            Code = item.Code,
            Name = item.Name,
            Category = item.Category,
            Description = item.Description,
            ConfigurationJson = string.IsNullOrWhiteSpace(item.ConfigurationJson) ? "{}" : item.ConfigurationJson,
            SortOrder = item.SortOrder,
            IsActive = item.IsActive,
        };
        _showForm = true;
    }

    private async Task SaveAsync()
    {
        if (!IsJsonValid(_form.ConfigurationJson, out var error))
        {
            ShowToast($"Save failed: {error}", "danger");
            return;
        }

        _saving = true;
        try
        {
            var json = NormalizeJson(_form.ConfigurationJson);
            if (_editId.HasValue)
            {
                await Api.UpdateDocumentConfigItemAsync(_editId.Value, new(_form.Code.Trim(), _form.Name.Trim(), Clean(_form.Category), Clean(_form.Description), json, _form.IsActive, _form.SortOrder));
                ShowToast("Storage setting updated.");
            }
            else
            {
                var id = await Api.CreateDocumentConfigItemAsync(new(_tenantId, ConfigKind, _form.Code.Trim(), _form.Name.Trim(), Clean(_form.Category), Clean(_form.Description), json, _form.SortOrder));
                ShowToast("Storage setting created.");
                _editId = id;
            }
            _showForm = false;
            await LoadAsync();
            _selected = _items.FirstOrDefault(x => x.DocumentConfigItemId == _editId) ?? _selected;
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmDelete(DocumentConfigItemDto item) { _deleteTarget = item; _showDelete = true; }
    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        _saving = true;
        try
        {
            await Api.DeleteDocumentConfigItemAsync(_deleteTarget.DocumentConfigItemId);
            ShowToast("Storage setting deleted.");
            if (_selected?.DocumentConfigItemId == _deleteTarget.DocumentConfigItemId) _selected = null;
            _showDelete = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Delete failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private void DuplicateSelected()
    {
        if (_selected is null) return;
        _editId = null;
        _form = new()
        {
            Code = $"{_selected.Code}-COPY",
            Name = $"{_selected.Name} Copy",
            Category = _selected.Category,
            Description = _selected.Description,
            ConfigurationJson = string.IsNullOrWhiteSpace(_selected.ConfigurationJson) ? DefaultConfigurationJson : _selected.ConfigurationJson,
            SortOrder = NextSortOrder,
            IsActive = false,
        };
        _showForm = true;
    }

    private async Task ToggleSelectedStatus()
    {
        if (_selected is null) return;
        _saving = true;
        try
        {
            await Api.UpdateDocumentConfigItemAsync(_selected.DocumentConfigItemId, new(_selected.Code, _selected.Name, _selected.Category, _selected.Description, _selected.ConfigurationJson, !_selected.IsActive, _selected.SortOrder));
            ShowToast(_selected.IsActive ? "Storage setting deactivated." : "Storage setting activated.");
            await LoadAsync();
            _selected = _items.FirstOrDefault(x => x.DocumentConfigItemId == _selected.DocumentConfigItemId) ?? _selected;
        }
        catch (Exception ex)
        {
            ShowToast($"Status update failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private Task ExportAsync()
    {
        var rows = new List<string> { "Code,Name,Provider,Region,Tier,UsagePercent,Encrypted,Status,Readiness,Created" };
        rows.AddRange(_filtered.Select(x =>
        {
            var meta = ReadMeta(x);
            return string.Join(',', Csv(x.Code), Csv(x.Name), Csv(meta.Provider), Csv(meta.Region), Csv(meta.Tier), meta.UsagePercent, meta.Encrypted, Csv(StatusLabel(x)), Csv(ReadinessLabel(x)), Csv(x.CreatedDateUtc.ToString("O")));
        }));
        Nav.NavigateTo("data:text/csv;charset=utf-8," + Uri.EscapeDataString(string.Join(Environment.NewLine, rows)), forceLoad: true);
        ShowToast("Storage settings export generated.");
        return Task.CompletedTask;
    }

    private void TestStorage(DocumentConfigItemDto item)
    {
        var meta = ReadMeta(item);
        if (!item.IsActive) ShowToast($"Validation warning: {item.Name} is inactive.", "warning");
        else if (!HasConfiguration(item)) ShowToast($"Validation warning: {item.Name} has no configuration JSON.", "warning");
        else if (!meta.Encrypted) ShowToast($"Validation warning: {item.Name} is not marked encrypted.", "warning");
        else ShowToast($"Storage validation passed for {meta.Provider} in {meta.Region}.");
    }

    private void RunStorageAudit()
    {
        var reviewCount = _filtered.Count(NeedsReview);
        ShowToast(reviewCount == 0 ? "Storage audit passed for all visible settings." : $"Storage audit completed: {reviewCount} visible setting(s) need review.", reviewCount == 0 ? "success" : "warning");
    }

    private void ValidateJson()
    {
        if (IsJsonValid(_form.ConfigurationJson, out var error)) ShowToast("Configuration JSON is valid.");
        else ShowToast($"JSON validation failed: {error}", "danger");
    }

    private void ShowValidationToast() => ShowToast("Please fix validation errors before saving.", "danger");
    private void CloseForm() { _showForm = false; _form = new(); _editId = null; }
    private void CancelDelete() { _showDelete = false; _deleteTarget = null; }
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }

    private int NextSortOrder => _items.Count == 0 ? 10 : _items.Max(x => x.SortOrder) + 10;
    private string KpiClass(string key, string tone)
    {
        var active = false;
        if (key == "all") active = _statusFilter == "all" && _readinessFilter == "all" && _providerFilter == "all";
        else if (key == "active") active = _statusFilter == "active";
        else if (key == "encrypted") active = _readinessFilter == "encrypted";
        else if (key == "capacity") active = _readinessFilter == "capacity";
        else if (key == "archive") active = _readinessFilter == "archive";
        else if (key == "review") active = _readinessFilter == "review";
        return $"st-kpi-card {tone}{(active ? " st-kpi-card-active" : string.Empty)}";
    }

    private bool MatchesSearch(DocumentConfigItemDto item)
    {
        var q = _search.Trim();
        var meta = ReadMeta(item);
        return Contains(item.Code, q) || Contains(item.Name, q) || Contains(item.Category, q) || Contains(item.Description, q) || Contains(item.ConfigurationJson, q) || Contains(meta.Provider, q) || Contains(meta.Region, q) || Contains(meta.Tier, q);
    }

    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;
    private static string StatusLabel(DocumentConfigItemDto item) => item.IsActive ? "Active" : "Inactive";
    private static string StatusClass(DocumentConfigItemDto item) => item.IsActive ? "st-status st-status-active" : "st-status st-status-inactive";
    private static bool HasConfiguration(DocumentConfigItemDto item) => !string.IsNullOrWhiteSpace(item.ConfigurationJson) && item.ConfigurationJson.Trim() != "{}";
    private static bool IsEncryptedReady(DocumentConfigItemDto item) => ReadMeta(item).Encrypted || Contains(item.ConfigurationJson, "encryption") || Contains(item.Description, "encrypted");
    private static bool IsHighUsage(DocumentConfigItemDto item) => ReadMeta(item).UsagePercent >= 80;
    private static bool IsArchiveReady(DocumentConfigItemDto item) => !string.IsNullOrWhiteSpace(ReadMeta(item).Tier) && !string.Equals(ReadMeta(item).Tier, "Review", StringComparison.OrdinalIgnoreCase) || Contains(item.ConfigurationJson, "archive");
    private static bool NeedsReview(DocumentConfigItemDto item) => !item.IsActive || !HasConfiguration(item) || !IsEncryptedReady(item) || string.Equals(ReadMeta(item).Provider, "Invalid JSON", StringComparison.OrdinalIgnoreCase);
    private static string ReadinessLabel(DocumentConfigItemDto item) => NeedsReview(item) ? "Needs Review" : IsHighUsage(item) ? "High Usage" : IsArchiveReady(item) ? "Archive Ready" : IsEncryptedReady(item) ? "Encrypted" : "Standard";
    private static string ReadinessClass(DocumentConfigItemDto item) => NeedsReview(item) ? "st-readiness st-readiness-review" : IsHighUsage(item) ? "st-readiness st-readiness-capacity" : IsArchiveReady(item) ? "st-readiness st-readiness-archive" : IsEncryptedReady(item) ? "st-readiness st-readiness-encrypted" : "st-readiness st-readiness-standard";
    private static string ReviewReason(DocumentConfigItemDto item)
    {
        var meta = ReadMeta(item);
        if (!item.IsActive) return "Inactive storage setting is not available to workflows.";
        if (!HasConfiguration(item)) return "Missing provider, encryption, region, and capacity metadata.";
        if (string.Equals(meta.Provider, "Invalid JSON", StringComparison.OrdinalIgnoreCase)) return "Configuration JSON cannot be parsed.";
        if (!meta.Encrypted) return "Encryption is not enabled in storage metadata.";
        if (meta.UsagePercent >= 80) return "Capacity usage is at or above enterprise warning threshold.";
        return "Review recommended.";
    }

    private static StorageMeta ReadMeta(DocumentConfigItemDto item)
    {
        if (string.IsNullOrWhiteSpace(item.ConfigurationJson)) return new("Unassigned", "Primary", 0, false, "Hot");
        try
        {
            using var doc = JsonDocument.Parse(item.ConfigurationJson);
            var root = doc.RootElement;
            return new(GetString(root, "provider", "Unassigned"), GetString(root, "region", "Primary"), GetInt(root, "usagePercent", 0), GetBool(root, "encrypted", string.Equals(GetString(root, "provider", string.Empty), "AzureBlob", StringComparison.OrdinalIgnoreCase)), GetString(root, "tier", "Hot"));
        }
        catch (JsonException)
        {
            return new("Invalid JSON", "Review", 0, false, "Review");
        }
    }

    private static string GetString(JsonElement root, string property, string fallback) => root.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() ?? fallback : fallback;
    private static int GetInt(JsonElement root, string property, int fallback) => root.TryGetProperty(property, out var value) && value.TryGetInt32(out var result) ? result : fallback;
    private static bool GetBool(JsonElement root, string property, bool fallback) => root.TryGetProperty(property, out var value) && value.ValueKind is JsonValueKind.True or JsonValueKind.False ? value.GetBoolean() : fallback;
    private static string DisplayConfig(DocumentConfigItemDto item) => string.IsNullOrWhiteSpace(item.ConfigurationJson) ? "{}" : item.ConfigurationJson;
    private static string WidthStyle(int value, int max) => $"width:{Math.Clamp((int)Math.Round(value * 100d / Math.Max(max, 1)), 0, 100)}%;";
    private static string AvatarClass(DocumentConfigItemDto item)
    {
        var index = Math.Abs(item.Code.GetHashCode()) % 6;
        if (index == 0) return "st-av1";
        if (index == 1) return "st-av2";
        if (index == 2) return "st-av3";
        if (index == 3) return "st-av4";
        if (index == 4) return "st-av5";
        return "st-av6";
    }
    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant() : name.Length > 0 ? name[..1].ToUpperInvariant() : "?";
    }
    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string Csv(string? value) => string.Concat("\"", (value ?? string.Empty).Replace("\"", "\"\""), "\"");
    private static string NormalizeJson(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "{}";
        using var document = JsonDocument.Parse(value);
        return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = false });
    }
    private static bool IsJsonValid(string? json, out string? error)
    {
        error = null;
        if (string.IsNullOrWhiteSpace(json)) return true;
        try
        {
            using var _ = JsonDocument.Parse(json);
            return true;
        }
        catch (JsonException ex)
        {
            error = ex.Message;
            return false;
        }
    }
    private string? GetQueryValue(string key)
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query;
        if (string.IsNullOrWhiteSpace(query)) return null;
        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && string.Equals(Uri.UnescapeDataString(pair[0]), key, StringComparison.OrdinalIgnoreCase)) return Uri.UnescapeDataString(pair[1].Replace('+', ' '));
        }
        return null;
    }

    private sealed record StorageMeta(string Provider, string Region, int UsagePercent, bool Encrypted, string Tier);
    private sealed record GroupSummary(string Name, int Count);
    private sealed record GovernanceLane(string Title, List<DocumentConfigItemDto> Items);
    private sealed class FormModel
    {
        [Required, StringLength(80)] public string Code { get; set; } = string.Empty;
        [Required, StringLength(200)] public string Name { get; set; } = string.Empty;
        [StringLength(120)] public string? Category { get; set; }
        [StringLength(500)] public string? Description { get; set; }
        [StringLength(4000)] public string? ConfigurationJson { get; set; } = DefaultConfigurationJson;
        [Range(0, 9999)] public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
