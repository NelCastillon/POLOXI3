    private void ShowExportSummary() => ShowToast($"Export summary prepared for {FilteredItems.Count} storage setting records.", "success", "bi-download");

    private void EnsureSelectedStillVisible()
    {
        if (_selected is not null && FilteredItems.Any(x => x.DocumentConfigItemId == _selected.DocumentConfigItemId))
            return;

        _selected = FilteredItems.FirstOrDefault();
    }

    private bool MatchesSearch(DocumentConfigItemDto item)
    {
        if (string.IsNullOrWhiteSpace(_search))
            return true;

        var meta = ReadMeta(item);
        return Contains(item.Code, _search) || Contains(item.Name, _search) || Contains(item.Category, _search) || Contains(item.Description, _search) || Contains(item.ConfigurationJson, _search) || Contains(meta.Provider, _search) || Contains(meta.Region, _search) || Contains(meta.Tier, _search);
    }

    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private static bool HasConfiguration(DocumentConfigItemDto item) => !string.IsNullOrWhiteSpace(item.ConfigurationJson) && item.ConfigurationJson.Trim() != "{}";

    private static bool NeedsReview(DocumentConfigItemDto item) => !item.IsActive || !HasConfiguration(item) || !ReadMeta(item).Encrypted;

    private static StorageMeta ReadMeta(DocumentConfigItemDto item)
    {
        if (string.IsNullOrWhiteSpace(item.ConfigurationJson))
            return new("Unassigned", "Primary", 0, false, "Hot");

        try
        {
            using var doc = JsonDocument.Parse(item.ConfigurationJson);
            var root = doc.RootElement;
            return new(
                GetString(root, "provider", "Unassigned"),
                GetString(root, "region", "Primary"),
                GetInt(root, "usagePercent", 0),
                GetBool(root, "encrypted", string.Equals(GetString(root, "provider", string.Empty), "AzureBlob", StringComparison.OrdinalIgnoreCase)),
                GetString(root, "tier", "Hot"));
        }
        catch (JsonException)
        {
            return new("Invalid JSON", "Review", 0, false, "Review");
        }
    }

    private static string GetString(JsonElement root, string property, string fallback) => root.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.String ? value.GetString() ?? fallback : fallback;

    private static int GetInt(JsonElement root, string property, int fallback) => root.TryGetProperty(property, out var value) && value.TryGetInt32(out var result) ? result : fallback;

    private static bool GetBool(JsonElement root, string property, bool fallback) => root.TryGetProperty(property, out var value) && value.ValueKind is JsonValueKind.True or JsonValueKind.False ? value.GetBoolean() : fallback;

    private static string? Normalize(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string NormalizeJson(string? value) => string.IsNullOrWhiteSpace(value) ? "{}" : value.Trim();

    private static bool IsJsonValid(string? json, out string? error)
    {
        error = null;
        if (string.IsNullOrWhiteSpace(json))
            return true;

        try
        {
            using var _ = JsonDocument.Parse(json);
            return true;
        }
        catch (JsonException ex)
        {
            error = ex.Message;
            return false;
        }
    }

