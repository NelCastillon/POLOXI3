@page "/tenant/documents/acord"
@page "/documents/acord"
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.DocumentConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>ACORD Forms</PageTitle>

@if (_toastVisible)
{
    <div class="af-toast af-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIcon" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="af-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="af-enterprise-page">
    <section class="af-hero">
        <div class="af-hero-left">
            <span class="af-hero-icon"><i class="bi bi-file-earmark-medical" aria-hidden="true"></i></span>
            <div>
                <div class="af-title-row">
                    <h1>ACORD Forms</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> DB synced</span>
                    <span><i class="bi bi-input-cursor-text" aria-hidden="true"></i> Mapping controlled</span>
                </div>
                <p>Enterprise ACORD setup workspace for form availability, field mappings, prefill defaults, e-sign readiness, submission packets, and compliance governance.</p>
            </div>
        </div>
        <div class="af-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "af-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync" disabled="@(!_items.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add ACORD Form</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="af-error-banner" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@_loadError</span></div>
    }

    <section class="af-kpi-strip" aria-label="ACORD form KPIs">
        <button type="button" class="@AllKpiClass" @onclick="ShowAll"><span class="af-kpi-icon"><i class="bi bi-file-earmark-medical" aria-hidden="true"></i></span><span><strong>@_items.Count</strong><em>Total Forms</em><small>Configured ACORD library</small></span></button>
        <button type="button" class="@ActiveKpiClass" @onclick="ShowActive"><span class="af-kpi-icon"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span><span><strong>@ActiveCount</strong><em>Active</em><small>Available to workflows</small></span></button>
        <button type="button" class="@MappingKpiClass" @onclick="ShowMapping"><span class="af-kpi-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span><span><strong>@MappingReadyCount</strong><em>Mapped</em><small>Field mappings configured</small></span></button>
        <button type="button" class="@PrefillKpiClass" @onclick="ShowPrefill"><span class="af-kpi-icon"><i class="bi bi-magic" aria-hidden="true"></i></span><span><strong>@PrefillReadyCount</strong><em>Prefill Ready</em><small>Defaults or data sources</small></span></button>
        <button type="button" class="@ESignKpiClass" @onclick="ShowESign"><span class="af-kpi-icon"><i class="bi bi-pen" aria-hidden="true"></i></span><span><strong>@ESignReadyCount</strong><em>E-Sign Ready</em><small>Signer routing enabled</small></span></button>
        <button type="button" class="@ReviewKpiClass" @onclick="ShowReview"><span class="af-kpi-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></span><span><strong>@NeedsReviewCount</strong><em>Needs Review</em><small>Missing setup metadata</small></span></button>
    </section>

    <section class="af-workflow-strip" aria-label="ACORD setup workflows">
        <button type="button" class="af-workflow-card" @onclick="ShowLibrary"><i class="bi bi-kanban" aria-hidden="true"></i><span><strong>Library</strong><small>Form availability</small></span></button>
        <button type="button" class="af-workflow-card" @onclick="ShowMappingView"><i class="bi bi-diagram-3" aria-hidden="true"></i><span><strong>Mapping</strong><small>Fields and defaults</small></span></button>
        <button type="button" class="af-workflow-card" @onclick="ShowWorkflow"><i class="bi bi-send-check" aria-hidden="true"></i><span><strong>Workflow</strong><small>E-sign and packets</small></span></button>
        <button type="button" class="af-workflow-card" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i><span><strong>Create</strong><small>Add form setup</small></span></button>
    </section>

    <section class="af-search-panel">
        <div class="af-search-wrap">
            <span class="af-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="af-search-body">
                <label for="af-search">ACORD search</label>
                <input id="af-search" class="af-search-input" @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="Search form number, line, mapping, prefill, e-sign, JSON..." />
                <span class="af-search-hint">Filters real tenant ACORD configuration records.</span>
            </div>
        </div>
        <select class="af-filter-select" @bind="_statusFilter" @bind:after="ApplyFilter" aria-label="Status filter">
            <option value="all">All statuses</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
        <select class="af-filter-select" @bind="_readinessFilter" @bind:after="ApplyFilter" aria-label="Readiness filter">
            <option value="all">All readiness</option>
            <option value="mapping">Mapped</option>
            <option value="prefill">Prefill ready</option>
            <option value="esign">E-sign ready</option>
            <option value="review">Needs review</option>
        </select>
        <select class="af-filter-select" @bind="_categoryFilter" @bind:after="ApplyFilter" aria-label="Line filter">
            <option value="all">All lines/groups</option>
            @foreach (var category in CategoryGroups)
            {
                <option value="@category">@category</option>
            }
        </select>
        <div class="af-search-result"><strong>@_filtered.Count</strong><span>records</span></div>
    </section>

    <nav class="af-view-tabs" aria-label="ACORD views">
        @foreach (var view in _views)
        {
            <button type="button" class="af-view-btn @(_activeView == view ? "af-view-btn-active" : null)" @onclick="() => SetView(view)">@view</button>
        }
    </nav>

    <section class="af-content-layout">
        <div class="af-main-card">
            @if (_loading)
            {
                <div class="af-loading"><i class="bi bi-arrow-repeat af-spin" aria-hidden="true"></i><span>Loading ACORD forms...</span></div>
            }
            else if (_filtered.Count == 0)
            {
                <div class="af-empty-state"><i class="bi bi-file-earmark-x" aria-hidden="true"></i><h2>No ACORD forms found</h2><p>Adjust filters or create the first ACORD form setup record.</p><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add ACORD Form</button></div>
            }
            else if (_activeView == "Mapping")
            {
                <div class="af-governance-grid">
                    <section class="af-panel">
                        <header><div><i class="bi bi-diagram-3" aria-hidden="true"></i><strong>Mapping Readiness</strong></div><span>@MappingScore.ToString("F0")%</span></header>
                        <div class="af-panel-body af-metric-list">
                            <div class="af-metric-row"><span>Mapped forms</span><div><i style="@WidthStyle(MappingReadyCount, SafeTotal)"></i></div><strong>@MappingReadyCount</strong></div>
                            <div class="af-metric-row"><span>Prefill ready</span><div><i style="@WidthStyle(PrefillReadyCount, SafeTotal)"></i></div><strong>@PrefillReadyCount</strong></div>
                            <div class="af-metric-row"><span>E-sign ready</span><div><i style="@WidthStyle(ESignReadyCount, SafeTotal)"></i></div><strong>@ESignReadyCount</strong></div>
                            <div class="af-metric-row"><span>Needs review</span><div><i style="@WidthStyle(NeedsReviewCount, SafeTotal)"></i></div><strong>@NeedsReviewCount</strong></div>
                        </div>
                    </section>
                    <section class="af-panel">
                        <header><div><i class="bi bi-tags" aria-hidden="true"></i><strong>Lines / Groups</strong></div><span>@CategoryGroups.Count</span></header>
                        <div class="af-panel-body af-group-list">
                            @foreach (var group in GroupSummaries)
                            {
                                <button type="button" class="af-group-row" @onclick="() => FilterCategory(group.Name)"><span>@group.Name</span><div><i style="@WidthStyle(group.Count, SafeTotal)"></i></div><strong>@group.Count</strong></button>
                            }
                        </div>
                    </section>
                    <section class="af-panel af-panel-wide">
                        <header><div><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><strong>ACORD Review Queue</strong></div><span>@NeedsReviewItems.Count</span></header>
                        <div class="af-panel-body af-review-list">
                            @foreach (var item in NeedsReviewItems.Take(8))
                            {
                                <button type="button" class="af-review-row" @onclick="() => SelectItem(item)"><strong>@item.Name</strong><span>@ReviewReason(item)</span><em>@ReadinessLabel(item)</em></button>
                            }
                        </div>
                    </section>
                </div>
            }
            else if (_activeView == "Workflow")
            {
                <div class="af-board">
                    @foreach (var lane in WorkflowLanes)
                    {
                        <section class="af-board-col">
                            <header><strong>@lane.Title</strong><span>@lane.Items.Count</span></header>
                            @foreach (var item in lane.Items)
                            {
                                <button type="button" class="af-board-card" @onclick="() => SelectItem(item)">
                                    <div><strong>@item.Name</strong><span>@item.Code</span></div>
                                    <small>@(item.Description ?? "No description provided")</small>
                                    <em>@ReadinessLabel(item)</em>
                                </button>
                            }
                        </section>
                    }
                </div>
            }
            else
            {
                <div class="af-table-scroll">
                    <table class="af-table">
                        <thead><tr><th>ACORD Form</th><th>Code</th><th>Line / Group</th><th>Readiness</th><th>Order</th><th>Status</th><th>Created</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var item in _filtered)
                            {
                                <tr @onclick="() => SelectItem(item)">
                                    <td><div class="af-name-cell"><span class="af-avatar @AvatarClass(item)">@Initials(item.Name)</span><span><strong>@item.Name</strong><small>@(item.Description ?? "No description provided")</small></span></div></td>
                                    <td><span class="af-code-pill">@item.Code</span></td>
                                    <td>@GroupLabel(item)</td>
                                    <td><span class="@ReadinessClass(item)">@ReadinessLabel(item)</span></td>
                                    <td class="af-number">@item.SortOrder</td>
                                    <td><span class="@StatusClass(item)">@StatusLabel(item)</span></td>
                                    <td>@item.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                                    <td><div class="af-row-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(item)" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <aside class="af-detail-card" aria-label="Selected ACORD form">
            @if (_selected is null)
            {
                <div class="af-detail-empty"><i class="bi bi-file-earmark-medical" aria-hidden="true"></i><h2>ACORD command brief</h2><p>Select a form to review mapping readiness, workflow status, governance gaps, and actions.</p></div>
            }
            else
            {
                <div class="af-detail-head"><div><span class="af-detail-eyebrow"><i class="bi bi-file-earmark-medical" aria-hidden="true"></i> @GroupLabel(_selected)</span><h2>@_selected.Name</h2><p>@_selected.Code</p></div><span class="@StatusClass(_selected)">@StatusLabel(_selected)</span></div>
                <div class="af-detail-body">
                    <div class="af-detail-summary">
                        <div><span>Readiness</span><strong>@ReadinessLabel(_selected)</strong></div>
                        <div><span>Mapping</span><strong>@(IsMappingReady(_selected) ? "Ready" : "Review")</strong></div>
                        <div><span>Prefill</span><strong>@(IsPrefillReady(_selected) ? "Ready" : "Manual")</strong></div>
                        <div><span>E-Sign</span><strong>@(IsESignReady(_selected) ? "Ready" : "Optional")</strong></div>
                    </div>
                    <div class="af-config-card"><span>Configuration JSON</span><code>@DisplayConfig(_selected)</code></div>
                    <div class="af-detail-actions">
                        <button type="button" class="um-btn um-btn-primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit ACORD Form</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="DuplicateSelected"><i class="bi bi-files" aria-hidden="true"></i> Duplicate</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="ToggleSelectedStatus"><i class="bi bi-power" aria-hidden="true"></i> @(_selected.IsActive ? "Deactivate" : "Activate")</button>
                        <button type="button" class="um-btn um-btn-ghost text-danger" @onclick="() => ConfirmDelete(_selected)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@if (_showForm)
{
    <div class="af-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="af-form-title">
        <div class="af-modal">
            <div class="af-modal-header"><div class="af-modal-title"><span class="af-modal-icon"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i></span><div><h2 id="af-form-title">@(_editId.HasValue ? "Edit ACORD Form" : "Add ACORD Form")</h2><p>Configure availability, mapping, prefill defaults, and workflow metadata.</p></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="af-modal-body">
                    <div class="af-form-banner"><i class="bi bi-info-circle" aria-hidden="true"></i><span><strong>ACORD setup standard</strong> Use stable form codes and JSON metadata for mappings, prefill, e-sign, packet, and line-of-business behavior.</span></div>
                    <div class="af-form-grid">
                        <div class="af-field"><label>Code <span>*</span></label><InputText @bind-Value="_form.Code" class="af-input" placeholder="ACORD_125" /></div>
                        <div class="af-field"><label>Name <span>*</span></label><InputText @bind-Value="_form.Name" class="af-input" placeholder="ACORD 125 Commercial Insurance Application" /></div>
                        <div class="af-field"><label>Line / Group</label><InputText @bind-Value="_form.Category" class="af-input" placeholder="Commercial Lines, Personal Lines, Claims..." /></div>
                        <div class="af-field"><label>Sort Order</label><InputNumber @bind-Value="_form.SortOrder" class="af-input" /></div>
                        <div class="af-field af-field-wide"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="af-input" rows="3" /></div>
                        <div class="af-field af-field-wide"><label>Configuration JSON</label><InputTextArea @bind-Value="_form.ConfigurationJson" class="af-input af-code-input" rows="6" placeholder='{"mapping":true,"prefill":true,"esign":true,"packet":true}' /></div>
                        <div class="af-field af-field-wide af-check-row"><label><InputCheckbox @bind-Value="_form.IsActive" /> Active for ACORD workflows</label></div>
                    </div>
                </div>
                <div class="af-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi bi-check2" aria-hidden="true"></i> @(_editId.HasValue ? "Save Changes" : "Create ACORD Form")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showDelete)
{
    <div class="af-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="af-delete-title">
        <div class="af-confirm-modal">
            <div class="af-confirm-icon"><i class="bi bi-trash3-fill" aria-hidden="true"></i></div>
            <h2 id="af-delete-title">Delete ACORD Form</h2>
            <p>Delete <strong>@_deleteTarget?.Name</strong>? Existing submissions may still reference this setup historically.</p>
            <div class="af-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CancelDelete">Cancel</button><button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div>
        </div>
    </div>
}

@code {
    private const string ConfigKind = "AcordForm";
    private Guid _tenantId;
    private bool _loading;
    private bool _saving;
    private bool _showForm;
    private bool _showDelete;
    private bool _toastVisible;
    private string _search = string.Empty;
    private string _statusFilter = "all";
    private string _readinessFilter = "all";
    private string _categoryFilter = "all";
    private string _activeView = "Library";
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private Guid? _editId;
    private DocumentConfigItemDto? _selected;
    private DocumentConfigItemDto? _deleteTarget;
    private readonly string[] _views = ["Library", "Mapping", "Workflow"];
    private List<DocumentConfigItemDto> _items = [];
    private List<DocumentConfigItemDto> _filtered = [];
    private FormModel _form = new();

    private int ActiveCount => _items.Count(x => x.IsActive);
    private int MappingReadyCount => _items.Count(IsMappingReady);
    private int PrefillReadyCount => _items.Count(IsPrefillReady);
    private int ESignReadyCount => _items.Count(IsESignReady);
    private int NeedsReviewCount => _items.Count(NeedsReview);
    private int SafeTotal => Math.Max(_items.Count, 1);
    private double MappingScore => _items.Count == 0 ? 0 : (MappingReadyCount + PrefillReadyCount + ESignReadyCount - NeedsReviewCount) * 100d / Math.Max(_items.Count * 3, 1);
    private List<string> CategoryGroups => _items.Select(GroupLabel).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    private List<GroupSummary> GroupSummaries => _items.GroupBy(GroupLabel, StringComparer.OrdinalIgnoreCase).Select(g => new GroupSummary(g.Key, g.Count())).OrderByDescending(x => x.Count).ToList();
    private List<DocumentConfigItemDto> NeedsReviewItems => _items.Where(NeedsReview).OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToList();
    private List<WorkflowLane> WorkflowLanes =>
    [
        new("Mapped", _filtered.Where(IsMappingReady).ToList()),
        new("Prefill Ready", _filtered.Where(IsPrefillReady).ToList()),
        new("E-Sign Ready", _filtered.Where(IsESignReady).ToList()),
    ];
    private string ToastIcon => _toastKind == "success" ? "bi-check-circle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-exclamation-triangle-fill";
    private string AllKpiClass => KpiClass("all", "af-blue");
    private string ActiveKpiClass => KpiClass("active", "af-green");
    private string MappingKpiClass => KpiClass("mapping", "af-cyan");
    private string PrefillKpiClass => KpiClass("prefill", "af-purple");
    private string ESignKpiClass => KpiClass("esign", "af-slate");
    private string ReviewKpiClass => KpiClass("review", "af-amber");

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Documents & Forms", null), new("ACORD Forms", "/tenant/documents/acord"));
        _search = GetQueryValue("searchTerm") ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchDocumentConfigItemsAsync(_tenantId, ConfigKind, _search, pageSize: 500);
            _items = result?.Items.OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToList() ?? [];
            ApplyFilter();
            _selected ??= _filtered.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilter()
    {
        IEnumerable<DocumentConfigItemDto> query = _items;
        if (!string.IsNullOrWhiteSpace(_search)) query = query.Where(MatchesSearch);
        if (_statusFilter == "active") query = query.Where(x => x.IsActive);
        else if (_statusFilter == "inactive") query = query.Where(x => !x.IsActive);
        if (_readinessFilter == "mapping") query = query.Where(IsMappingReady);
        else if (_readinessFilter == "prefill") query = query.Where(IsPrefillReady);
        else if (_readinessFilter == "esign") query = query.Where(IsESignReady);
        else if (_readinessFilter == "review") query = query.Where(NeedsReview);
        if (_categoryFilter != "all") query = query.Where(x => string.Equals(GroupLabel(x), _categoryFilter, StringComparison.OrdinalIgnoreCase));
        _filtered = query.OrderBy(x => x.SortOrder).ThenBy(x => x.Name).ToList();
        if (_selected is not null && !_filtered.Any(x => x.DocumentConfigItemId == _selected.DocumentConfigItemId)) _selected = _filtered.FirstOrDefault();
    }

    private void ShowAll() { _statusFilter = "all"; _readinessFilter = "all"; _categoryFilter = "all"; ApplyFilter(); }
    private void ShowActive() { _statusFilter = "active"; _readinessFilter = "all"; ApplyFilter(); }
    private void ShowMapping() { _statusFilter = "all"; _readinessFilter = "mapping"; ApplyFilter(); }
    private void ShowPrefill() { _statusFilter = "all"; _readinessFilter = "prefill"; ApplyFilter(); }
    private void ShowESign() { _statusFilter = "all"; _readinessFilter = "esign"; ApplyFilter(); }
    private void ShowReview() { _statusFilter = "all"; _readinessFilter = "review"; ApplyFilter(); }
    private void ShowLibrary() => SetView("Library");
    private void ShowMappingView() => SetView("Mapping");
    private void ShowWorkflow() => SetView("Workflow");
    private void SetView(string view) => _activeView = view;
    private void FilterCategory(string category) { _categoryFilter = category; ApplyFilter(); }
    private void SelectItem(DocumentConfigItemDto item) => _selected = item;

    private void OpenCreate()
    {
        _editId = null;
        _form = new() { ConfigurationJson = "{}", IsActive = true, SortOrder = NextSortOrder };
        _showForm = true;
    }

    private void OpenEdit(DocumentConfigItemDto item)
    {
        _editId = item.DocumentConfigItemId;
        _form = new()
        {
            Code = item.Code,
            Name = item.Name,
            Category = item.Category,
            Description = item.Description,
            ConfigurationJson = string.IsNullOrWhiteSpace(item.ConfigurationJson) ? "{}" : item.ConfigurationJson,
            SortOrder = item.SortOrder,
            IsActive = item.IsActive,
        };
        _showForm = true;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var json = NormalizeJson(_form.ConfigurationJson);
            if (_editId.HasValue)
            {
                await Api.UpdateDocumentConfigItemAsync(_editId.Value, new(_form.Code.Trim(), _form.Name.Trim(), Clean(_form.Category), Clean(_form.Description), json, _form.IsActive, _form.SortOrder));
                ShowToast("ACORD form updated.");
            }
            else
            {
                var id = await Api.CreateDocumentConfigItemAsync(new(_tenantId, ConfigKind, _form.Code.Trim(), _form.Name.Trim(), Clean(_form.Category), Clean(_form.Description), json, _form.SortOrder));
                ShowToast("ACORD form created.");
                _editId = id;
            }
            _showForm = false;
            await LoadAsync();
            _selected = _items.FirstOrDefault(x => x.DocumentConfigItemId == _editId) ?? _selected;
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmDelete(DocumentConfigItemDto item) { _deleteTarget = item; _showDelete = true; }
    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        _saving = true;
        try
        {
            await Api.DeleteDocumentConfigItemAsync(_deleteTarget.DocumentConfigItemId);
            ShowToast("ACORD form deleted.");
            if (_selected?.DocumentConfigItemId == _deleteTarget.DocumentConfigItemId) _selected = null;
            _showDelete = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Delete failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private void DuplicateSelected()
    {
        if (_selected is null) return;
        _editId = null;
        _form = new()
        {
            Code = $"{_selected.Code}-COPY",
            Name = $"{_selected.Name} Copy",
            Category = _selected.Category,
            Description = _selected.Description,
            ConfigurationJson = string.IsNullOrWhiteSpace(_selected.ConfigurationJson) ? "{}" : _selected.ConfigurationJson,
            SortOrder = NextSortOrder,
            IsActive = false,
        };
        _showForm = true;
    }

    private async Task ToggleSelectedStatus()
    {
        if (_selected is null) return;
        _saving = true;
        try
        {
            await Api.UpdateDocumentConfigItemAsync(_selected.DocumentConfigItemId, new(_selected.Code, _selected.Name, _selected.Category, _selected.Description, _selected.ConfigurationJson, !_selected.IsActive, _selected.SortOrder));
            ShowToast(_selected.IsActive ? "ACORD form deactivated." : "ACORD form activated.");
            await LoadAsync();
            _selected = _items.FirstOrDefault(x => x.DocumentConfigItemId == _selected.DocumentConfigItemId) ?? _selected;
        }
        catch (Exception ex)
        {
            ShowToast($"Status update failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private Task ExportAsync()
    {
        var rows = new List<string> { "Code,Name,Line,Status,Readiness,SortOrder,Created" };
        rows.AddRange(_filtered.Select(x => string.Join(',', Csv(x.Code), Csv(x.Name), Csv(GroupLabel(x)), Csv(StatusLabel(x)), Csv(ReadinessLabel(x)), x.SortOrder, Csv(x.CreatedDateUtc.ToString("O")))));
        Nav.NavigateTo("data:text/csv;charset=utf-8," + Uri.EscapeDataString(string.Join(Environment.NewLine, rows)), forceLoad: true);
        ShowToast("ACORD forms export generated.");
        return Task.CompletedTask;
    }

    private void CloseForm() { _showForm = false; _form = new(); _editId = null; }
    private void CancelDelete() { _showDelete = false; _deleteTarget = null; }
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }

    private int NextSortOrder => _items.Count == 0 ? 10 : _items.Max(x => x.SortOrder) + 10;
    private string KpiClass(string key, string tone)
    {
        var active = false;
        if (key == "all") active = _statusFilter == "all" && _readinessFilter == "all" && _categoryFilter == "all";
        else if (key == "active") active = _statusFilter == "active";
        else if (key == "mapping") active = _readinessFilter == "mapping";
        else if (key == "prefill") active = _readinessFilter == "prefill";
        else if (key == "esign") active = _readinessFilter == "esign";
        else if (key == "review") active = _readinessFilter == "review";
        return $"af-kpi-card {tone}{(active ? " af-kpi-card-active" : string.Empty)}";
    }

    private bool MatchesSearch(DocumentConfigItemDto item)
    {
        var q = _search.Trim();
        return Contains(item.Code, q) || Contains(item.Name, q) || Contains(item.Category, q) || Contains(item.Description, q) || Contains(item.ConfigurationJson, q);
    }

    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;
    private static string GroupLabel(DocumentConfigItemDto item) => string.IsNullOrWhiteSpace(item.Category) ? "Unassigned" : item.Category.Trim();
    private static string StatusLabel(DocumentConfigItemDto item) => item.IsActive ? "Active" : "Inactive";
    private static string StatusClass(DocumentConfigItemDto item) => item.IsActive ? "af-status af-status-active" : "af-status af-status-inactive";
    private static bool IsMappingReady(DocumentConfigItemDto item) => Contains(item.ConfigurationJson, "mapping") || Contains(item.ConfigurationJson, "field") || Contains(item.ConfigurationJson, "map") || Contains(item.Description, "mapping");
    private static bool IsPrefillReady(DocumentConfigItemDto item) => Contains(item.ConfigurationJson, "prefill") || Contains(item.ConfigurationJson, "default") || Contains(item.ConfigurationJson, "dataSource") || Contains(item.Description, "prefill");
    private static bool IsESignReady(DocumentConfigItemDto item) => Contains(item.ConfigurationJson, "esign") || Contains(item.ConfigurationJson, "signature") || Contains(item.ConfigurationJson, "signer") || Contains(item.Description, "sign");
    private static bool NeedsReview(DocumentConfigItemDto item) => !item.IsActive || string.IsNullOrWhiteSpace(item.Description) || string.IsNullOrWhiteSpace(item.Category) || string.IsNullOrWhiteSpace(item.ConfigurationJson) || item.ConfigurationJson == "{}";
    private static string ReadinessLabel(DocumentConfigItemDto item) => NeedsReview(item) ? "Needs Review" : IsESignReady(item) ? "E-Sign Ready" : IsPrefillReady(item) ? "Prefill Ready" : IsMappingReady(item) ? "Mapped" : "Standard";
    private static string ReadinessClass(DocumentConfigItemDto item) => NeedsReview(item) ? "af-readiness af-readiness-review" : IsESignReady(item) ? "af-readiness af-readiness-esign" : IsPrefillReady(item) ? "af-readiness af-readiness-prefill" : IsMappingReady(item) ? "af-readiness af-readiness-mapping" : "af-readiness af-readiness-standard";
    private static string ReviewReason(DocumentConfigItemDto item)
    {
        if (!item.IsActive) return "Inactive ACORD form is not available to workflows.";
        if (string.IsNullOrWhiteSpace(item.Category)) return "Missing line or group assignment.";
        if (string.IsNullOrWhiteSpace(item.Description)) return "Missing operational description.";
        if (string.IsNullOrWhiteSpace(item.ConfigurationJson) || item.ConfigurationJson == "{}") return "Missing mapping or workflow metadata.";
        return "Review recommended.";
    }
    private static string DisplayConfig(DocumentConfigItemDto item) => string.IsNullOrWhiteSpace(item.ConfigurationJson) ? "{}" : item.ConfigurationJson;
    private static string WidthStyle(int value, int max) => $"width:{Math.Clamp((int)Math.Round(value * 100d / Math.Max(max, 1)), 0, 100)}%;";
    private static string AvatarClass(DocumentConfigItemDto item)
    {
        var index = Math.Abs(item.Code.GetHashCode()) % 6;
        if (index == 0) return "af-av1";
        if (index == 1) return "af-av2";
        if (index == 2) return "af-av3";
        if (index == 3) return "af-av4";
        if (index == 4) return "af-av5";
        return "af-av6";
    }
    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant() : name.Length > 0 ? name[..1].ToUpperInvariant() : "?";
    }
    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string Csv(string? value) => string.Concat("\"", (value ?? string.Empty).Replace("\"", "\"\""), "\"");
    private static string NormalizeJson(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "{}";
        using var document = JsonDocument.Parse(value);
        return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = false });
    }
    private string? GetQueryValue(string key)
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query;
        if (string.IsNullOrWhiteSpace(query)) return null;
        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && string.Equals(Uri.UnescapeDataString(pair[0]), key, StringComparison.OrdinalIgnoreCase)) return Uri.UnescapeDataString(pair[1].Replace('+', ' '));
        }
        return null;
    }

    private sealed record GroupSummary(string Name, int Count);
    private sealed record WorkflowLane(string Title, List<DocumentConfigItemDto> Items);
    private sealed class FormModel
    {
        [Required, StringLength(80)] public string Code { get; set; } = string.Empty;
        [Required, StringLength(200)] public string Name { get; set; } = string.Empty;
        [StringLength(120)] public string? Category { get; set; }
        [StringLength(500)] public string? Description { get; set; }
        [StringLength(4000)] public string? ConfigurationJson { get; set; } = "{}";
        [Range(0, 9999)] public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
