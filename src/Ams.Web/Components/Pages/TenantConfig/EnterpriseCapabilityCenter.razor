@page "/tenant/enterprise/capabilities"
@namespace Ams.Web.Components.Pages.TenantConfig
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Enterprise
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Enterprise AMS Capability Center - AMS</PageTitle>

<AppPageHeader Title="Enterprise AMS Capability Center"
               Subtitle="Compare this AMS against enterprise market capabilities, link to existing modules, and track remaining gaps from DB-backed data"
               Icon="bi-building-check">
    <Actions>
        <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Refresh</button>
    </Actions>
</AppPageHeader>

@if (_loading)
{
    <div class="um-empty"><i class="bi bi-hourglass-split" aria-hidden="true"></i><strong>Loading enterprise capability data...</strong></div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger">@_loadError</div>
}
else
{
    <section class="ec-hero">
        <div class="ec-score">
            <span>Enterprise readiness</span>
            <strong>@_page.Summary.AverageMaturityScore%</strong>
            <small>@_page.Summary.ImplementedCount implemented · @_page.Summary.PartialCount partial · @_page.Summary.GapCount gaps</small>
        </div>
        <div class="ec-kpis">
            <button type="button" class="ec-kpi" @onclick='() => SetStatusFilter("")'><span>Total</span><strong>@_page.Summary.TotalCount</strong></button>
            <button type="button" class="ec-kpi ec-ok" @onclick='() => SetStatusFilter("Implemented")'><span>Implemented</span><strong>@_page.Summary.ImplementedCount</strong></button>
            <button type="button" class="ec-kpi ec-warn" @onclick='() => SetStatusFilter("Partial")'><span>Partial</span><strong>@_page.Summary.PartialCount</strong></button>
            <button type="button" class="ec-kpi ec-gap" @onclick='() => SetStatusFilter("Gap")'><span>Gaps</span><strong>@_page.Summary.GapCount</strong></button>
            <button type="button" class="ec-kpi ec-critical" @onclick='() => SetPriorityFilter("Critical")'><span>Critical</span><strong>@_page.Summary.CriticalCount</strong></button>
        </div>
    </section>

    <section class="ec-toolbar">
        <input class="um-input" placeholder="Search capability, benchmark, or current state" @bind="_search" @bind:event="oninput" />
        <select class="um-input" @bind="_domainFilter">
            <option value="">All domains</option>
            @foreach (var domain in _page.Summary.Domains)
            {
                <option value="@domain.DomainCode">@domain.DomainName</option>
            }
        </select>
        <select class="um-input" @bind="_statusFilter">
            <option value="">All statuses</option>
            <option value="Implemented">Implemented</option>
            <option value="Partial">Partial</option>
            <option value="Gap">Gap</option>
        </select>
        <select class="um-input" @bind="_priorityFilter">
            <option value="">All priorities</option>
            <option value="Critical">Critical</option>
            <option value="High">High</option>
            <option value="Medium">Medium</option>
        </select>
        <button type="button" class="um-btn um-btn-primary" @onclick="LoadAsync"><i class="bi bi-funnel" aria-hidden="true"></i> Apply</button>
    </section>

    <section class="ec-domain-grid">
        @foreach (var domain in _page.Summary.Domains)
        {
            <button type="button" class="ec-domain" @onclick="() => SelectDomain(domain.DomainCode)">
                <strong>@domain.DomainName</strong>
                <span>@domain.TotalCount capabilities</span>
                <div class="ec-progress"><div style="width:@domain.AverageMaturityScore%"></div></div>
                <small>@domain.AverageMaturityScore% maturity · @domain.GapCount gaps</small>
            </button>
        }
    </section>

    <section class="ec-card-grid">
        @foreach (var item in _page.Items)
        {
            <article class="ec-card">
                <div class="ec-card-head">
                    <span class="ec-domain-pill">@item.DomainName</span>
                    <span class="@StatusClass(item.StatusCode)">@item.StatusCode</span>
                </div>
                <h2>@item.CapabilityName</h2>
                <p>@item.MarketBenchmark</p>
                <div class="ec-current"><strong>Current:</strong> @item.CurrentState</div>
                <div class="ec-action"><strong>Next:</strong> @item.RecommendedAction</div>
                <div class="ec-meta">
                    <span><i class="bi bi-speedometer2" aria-hidden="true"></i> @item.MaturityScore%</span>
                    <span><i class="bi bi-database" aria-hidden="true"></i> @item.RelatedRecordCount related</span>
                    <span class="@PriorityClass(item.PriorityCode)">@item.PriorityCode</span>
                </div>
                <div class="ec-card-actions">
                    @if (!string.IsNullOrWhiteSpace(item.ExistingModuleRoute))
                    {
                        <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => Nav.NavigateTo(item.ExistingModuleRoute)"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open module</button>
                    }
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i> Update</button>
                </div>
            </article>
        }
    </section>
}

@if (_editItem is not null)
{
    <div class="ec-modal-backdrop" role="dialog" aria-modal="true">
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="ec-modal">
                <header><h2>Update capability</h2><button type="button" class="um-btn um-btn-ghost" @onclick="CloseEdit">×</button></header>
                <label>Status</label>
                <select class="um-input" @bind="_form.StatusCode"><option>Implemented</option><option>Partial</option><option>Gap</option></select>
                <label>Priority</label>
                <select class="um-input" @bind="_form.PriorityCode"><option>Critical</option><option>High</option><option>Medium</option></select>
                <label>Maturity score</label>
                <InputNumber class="um-input" @bind-Value="_form.MaturityScore" />
                <label>Existing module route</label>
                <InputText class="um-input" @bind-Value="_form.ExistingModuleRoute" />
                <label>Current state</label>
                <InputTextArea class="um-input" @bind-Value="_form.CurrentState" />
                <label>Recommended action</label>
                <InputTextArea class="um-input" @bind-Value="_form.RecommendedAction" />
                <label>Data source</label>
                <InputText class="um-input" @bind-Value="_form.DataSource" />
                <label>Configuration JSON</label>
                <InputTextArea class="um-input" @bind-Value="_form.ConfigurationJson" />
                <footer><button type="button" class="um-btn um-btn-ghost" @onclick="CloseEdit">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Save</button></footer>
            </div>
        </EditForm>
    </div>
}

@code {
    private Guid _tenantId;
    private bool _loading;
    private bool _saving;
    private string? _loadError;
    private string _domainFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private string _priorityFilter = string.Empty;
    private string _search = string.Empty;
    private AmsCapabilityPageDto _page = new();
    private AmsCapabilityDto? _editItem;
    private EditModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Administration", "/admin"), new("Enterprise Capabilities", "/tenant/enterprise/capabilities"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _page = await Api.SearchAmsCapabilitiesAsync(_tenantId, Clean(_domainFilter), Clean(_statusFilter), Clean(_priorityFilter), Clean(_search)) ?? new();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SetStatusFilter(string status) { _statusFilter = status; await LoadAsync(); }
    private async Task SetPriorityFilter(string priority) { _priorityFilter = priority; await LoadAsync(); }
    private async Task SelectDomain(string domain) { _domainFilter = _domainFilter == domain ? string.Empty : domain; await LoadAsync(); }

    private void OpenEdit(AmsCapabilityDto item)
    {
        _editItem = item;
        _form = new()
        {
            CurrentState = item.CurrentState,
            StatusCode = item.StatusCode,
            PriorityCode = item.PriorityCode,
            MaturityScore = item.MaturityScore,
            ExistingModuleRoute = item.ExistingModuleRoute,
            RecommendedAction = item.RecommendedAction,
            DataSource = item.DataSource,
            ConfigurationJson = item.ConfigurationJson ?? "{}",
            IsActive = item.IsActive,
        };
    }

    private async Task SaveAsync()
    {
        if (_editItem is null) return;
        _saving = true;
        try
        {
            await Api.UpdateAmsCapabilityAsync(_editItem.CapabilityId, new UpdateAmsCapabilityRequest(_form.CurrentState, _form.StatusCode, _form.PriorityCode, Math.Clamp(_form.MaturityScore, 0, 100), _form.ExistingModuleRoute, _form.RecommendedAction, _form.DataSource, Clean(_form.ConfigurationJson), _form.IsActive));
            CloseEdit();
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private void CloseEdit()
    {
        _editItem = null;
        _form = new();
    }

    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string StatusClass(string status) => status == "Implemented" ? "ec-status ec-status-ok" : status == "Gap" ? "ec-status ec-status-gap" : "ec-status ec-status-partial";
    private static string PriorityClass(string priority) => priority == "Critical" ? "ec-priority ec-critical" : priority == "High" ? "ec-priority ec-high" : "ec-priority ec-medium";

    private sealed class EditModel
    {
        public string CurrentState { get; set; } = string.Empty;
        public string StatusCode { get; set; } = "Partial";
        public string PriorityCode { get; set; } = "High";
        public int MaturityScore { get; set; }
        public string ExistingModuleRoute { get; set; } = string.Empty;
        public string RecommendedAction { get; set; } = string.Empty;
        public string DataSource { get; set; } = "Database";
        public string? ConfigurationJson { get; set; } = "{}";
        public bool IsActive { get; set; } = true;
    }
}
