@page "/platform/notification-templates"
@inject ApiClient Api

<PageTitle>Notification Templates</PageTitle>
<AppPageHeader Title="Notification Templates" Icon="bi-bell" />
<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading...</span></div> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(NotificationTemplateDto.TemplateCode)"  HeaderText="Code"         Width="160"></GridColumn>
        <GridColumn Field="@nameof(NotificationTemplateDto.TemplateName)"  HeaderText="Name"         Width="220"></GridColumn>
        <GridColumn Field="@nameof(NotificationTemplateDto.ChannelCode)"   HeaderText="Channel"      Width="100"></GridColumn>
        <GridColumn Field="@nameof(NotificationTemplateDto.SubjectTemplate)" HeaderText="Subject"    Width="250"></GridColumn>
        <GridColumn Field="@nameof(NotificationTemplateDto.IsSystemTemplate)" HeaderText="System"    Width="80"  DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(NotificationTemplateDto.IsActive)"      HeaderText="Active"       Width="80"  DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(NotificationTemplateDto.CreatedDateUtc)" HeaderText="Created"     Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private string? _searchTerm;
    private List<NotificationTemplateDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchNotificationTemplatesAsync(_searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
