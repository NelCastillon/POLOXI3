@page "/claims/catastrophe"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject ApiClient Api

<PageTitle>Catastrophe &amp; Event View — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="5000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<!-- ── DECLARE CAT EVENT DIALOG ─────────────────────────────────── -->
<SfDialog @bind-Visible="_showNewEventDlg" Width="1120px" ShowCloseIcon="false" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header">
                <i class="bi bi-cloud-lightning" aria-hidden="true"></i>
                <span>Declare CAT Event</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showNewEventDlg = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="um-field um-field--full"><label>Event Name *</label><SfTextBox @bind-Value="_newEvent.Name" Placeholder="e.g. Texas May 2025 Hailstorm" /></div>
                    <div class="um-field"><label>Event Type *</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@_eventTypes" @bind-Value="_newEvent.EventType" Placeholder="Select type" />
                    </div>
                    <div class="um-field"><label>Severity</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@(new[]{"Critical","High","Medium","Low"})" @bind-Value="_newEvent.Severity" Placeholder="High" />
                    </div>
                    <div class="um-field"><label>Start Date *</label><SfDatePicker TValue="DateTime?" @bind-Value="_newEvent.StartDate" Placeholder="MM/DD/YYYY" /></div>
                    <div class="um-field"><label>End Date</label><SfDatePicker TValue="DateTime?" @bind-Value="_newEvent.EndDate" Placeholder="MM/DD/YYYY" /></div>
                    <div class="um-field"><label>Affected States</label><SfTextBox @bind-Value="_newEvent.AffectedStates" Placeholder="e.g. TX, LA, OK" /></div>
                    <div class="um-field"><label>CAT Code *</label><SfTextBox @bind-Value="_newEvent.CatCode" Placeholder="e.g. CAT-2025-TX-001" /></div>
                    <div class="um-field um-field--full"><label>Description</label>
                        <SfTextBox @bind-Value="_newEvent.Description" Placeholder="Brief description of the event…" Multiline="true" />
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showNewEventDlg = false">Cancel</button>
                <button type="button" class="um-btn um-btn-primary" @onclick="SaveNewEvent">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Declare Event
                </button>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<!-- ── CAMPAIGN BLAST DIALOG ────────────────────────────────────── -->
<SfDialog @bind-Visible="_showBlastDlg" Width="1120px" ShowCloseIcon="false" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header">
                <i class="bi bi-megaphone" aria-hidden="true"></i>
                <span>Campaign Blast — @_selectedEvent?.Name</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showBlastDlg = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="um-modal-body">
                <div class="cat-blast-target">
                    <i class="bi bi-people-fill" aria-hidden="true"></i>
                    <span><strong>@_blastTargetCount</strong> insured(s) selected — @_blastChannelSummary</span>
                </div>
                <div class="um-form-grid" style="margin-top:.75rem;">
                    <div class="um-field"><label>Channel *</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@(new[]{"Email","SMS","Email + SMS","Portal Notification","Letter"})" @bind-Value="_blast.Channel" Placeholder="Select channel" />
                    </div>
                    <div class="um-field"><label>Template</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@_blastTemplates" @bind-Value="_blast.Template" Placeholder="Select template" />
                    </div>
                    <div class="um-field um-field--full"><label>Subject *</label>
                        <SfTextBox @bind-Value="_blast.Subject" Placeholder="Message subject or headline…" />
                    </div>
                    <div class="um-field um-field--full"><label>Message Body</label>
                        <SfTextBox @bind-Value="_blast.Body" Placeholder="Message body…" Multiline="true"
                                   HtmlAttributes='@(new() {{"rows","5"}})' />
                    </div>
                    <div class="um-field"><label>Schedule</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@(new[]{"Send Now","Schedule for Later"})" @bind-Value="_blast.Schedule" Placeholder="Send Now" />
                    </div>
                    @if (_blast.Schedule == "Schedule for Later")
                    {
                        <div class="um-field"><label>Send At</label>
                            <SfDateTimePicker TValue="DateTime" @bind-Value="_blast.ScheduledAt" />
                        </div>
                    }
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showBlastDlg = false">Cancel</button>
                <button type="button" class="um-btn um-btn-primary" @onclick="SendBlast">
                    <i class="bi bi-send" aria-hidden="true"></i>
                    @(_blast.Schedule == "Schedule for Later" ? "Schedule Blast" : "Send Now")
                </button>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<!-- ── GEO-TAG DIALOG ────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showGeoTagDlg" Width="1120px" ShowCloseIcon="false" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header">
                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                <span>Geo-Tag Affected Insureds</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showGeoTagDlg = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="um-modal-body">
                <p class="cat-geo-desc">Select the geographic footprint of <strong>@_selectedEvent?.Name</strong> to identify and tag affected insureds.</p>
                <div class="um-form-grid">
                    <div class="um-field"><label>Filter by State(s)</label>
                        <SfTextBox @bind-Value="_geoTag.States" Placeholder="e.g. TX, OK, LA" />
                    </div>
                    <div class="um-field"><label>ZIP Code Range / List</label>
                        <SfTextBox @bind-Value="_geoTag.Zips" Placeholder="e.g. 77001-77099 or 77001,77025" />
                    </div>
                    <div class="um-field"><label>County List</label>
                        <SfTextBox @bind-Value="_geoTag.Counties" Placeholder="e.g. Harris, Fort Bend, Montgomery" />
                    </div>
                    <div class="um-field"><label>Radius from Epicenter (miles)</label>
                        <SfNumericTextBox TValue="int?" @bind-Value="_geoTag.RadiusMiles" Placeholder="50" />
                    </div>
                    <div class="um-field"><label>Line of Business Filter</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@_lobOpts" @bind-Value="_geoTag.LobFilter" Placeholder="All LOBs" />
                    </div>
                    <div class="um-field"><label>Minimum TIV Threshold</label>
                        <SfNumericTextBox TValue="decimal?" @bind-Value="_geoTag.MinTiv" Format="C0" Placeholder="$0" />
                    </div>
                </div>
                <div class="cat-geo-preview">
                    <i class="bi bi-map" aria-hidden="true"></i>
                    <span>Preview: <strong>@_geoTag.PreviewCount</strong> insured(s) match these criteria</span>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="PreviewGeoTag">
                        <i class="bi bi-search" aria-hidden="true"></i> Preview
                    </button>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showGeoTagDlg = false">Cancel</button>
                <button type="button" class="um-btn um-btn-primary" @onclick="ApplyGeoTag">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i> Tag @_geoTag.PreviewCount Insured(s)
                </button>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<!-- ── FAST FNOL DIALOG ──────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showFastFnolDlg" Width="920px" ShowCloseIcon="false" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header">
                <i class="bi bi-clipboard-plus" aria-hidden="true"></i>
                <span>Fast FNOL — @_selectedEvent?.CatCode</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showFastFnolDlg = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="um-modal-body">
                <div class="cat-fast-fnol-hint">
                    <i class="bi bi-lightning-fill" aria-hidden="true"></i>
                    Streamlined intake for high-volume CAT events. Full FNOL details captured post-triage.
                </div>
                <div class="um-form-grid" style="margin-top:.75rem;">
                    <div class="um-field"><label>Policy Number *</label>
                        <SfTextBox @bind-Value="_fastFnol.PolicyNumber" Placeholder="Policy number" />
                    </div>
                    <div class="um-field"><label>Insured / Contact Name *</label>
                        <SfTextBox @bind-Value="_fastFnol.InsuredName" Placeholder="Insured or contact name" />
                    </div>
                    <div class="um-field"><label>Contact Phone *</label>
                        <SfTextBox @bind-Value="_fastFnol.Phone" Placeholder="(555) 000-0000" />
                    </div>
                    <div class="um-field"><label>Loss Type</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@_catLossTypes" @bind-Value="_fastFnol.LossType" Placeholder="Select loss type" />
                    </div>
                    <div class="um-field"><label>Estimated Damage</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@(new[]{"< $10K","$10K – $50K","$50K – $100K","$100K – $500K","> $500K","Unknown"})" @bind-Value="_fastFnol.EstimatedRange" Placeholder="Unknown" />
                    </div>
                    <div class="um-field um-field--full"><label>Brief Description</label>
                        <SfTextBox @bind-Value="_fastFnol.Description" Placeholder="Brief loss description…" Multiline="true" />
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showFastFnolDlg = false">Cancel</button>
                <button type="button" class="um-btn um-btn-primary" @onclick="SubmitFastFnol">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Submit FNOL
                </button>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<AppPageHeader Title="Catastrophe Administration"
               Subtitle="Tenant admin CAT event management for geo-tagging, campaign blasts, fast FNOL, surge monitoring, and team capacity"
               Icon="bi-cloud-lightning">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/claims")'>
            <i class="bi bi-list-ul" aria-hidden="true"></i> Claims Register
        </button>
        <button class="um-btn um-btn-primary" @onclick="() => { _newEvent = new(); _showNewEventDlg = true; }">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Declare CAT Event
        </button>
    </Actions>
</AppPageHeader>

<section class="ma-hero clm-hero">
    <div>
        <span class="ma-eyebrow">Tenant Administration · Catastrophe Claims</span>
        <h2>Tenant Catastrophe Command Center</h2>
        <p>Coordinate tenant-wide CAT response, event declaration, affected insured tagging, mass communication, fast FNOL intake, and adjuster capacity.</p>
    </div>
    <div class="ma-hero-actions">
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/claims")'><i class="bi bi-list-ul"></i> Claims Register</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/claims/new")'><i class="bi bi-clipboard-plus"></i> FNOL Intake</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/claims/follow-up")'><i class="bi bi-list-check"></i> Follow-Up Queue</button>
    </div>
</section>

<!-- ── CAT EVENT SELECTOR STRIP ─────────────────────────────────── -->
<div class="cat-event-strip">
    <div class="cat-event-strip-lbl">Active CAT Events</div>
    <div class="cat-event-list">
        @foreach (var ev in _events)
        {
            <button class="cat-ev-btn @(ev.CatCode == _selectedEvent?.CatCode ? "cat-ev-active" : "") cat-ev-@SeverityCss(ev.Severity)"
                    @onclick="() => SelectEvent(ev)">
                <i class="bi @EventIcon(ev.EventType)" aria-hidden="true"></i>
                <div>
                    <div class="cat-ev-name">@ev.Name</div>
                    <div class="cat-ev-meta">@ev.CatCode · @ev.AffectedStates · @ev.StartDate.ToString("MM/dd/yy")</div>
                </div>
                <span class="cat-ev-sev cat-sev-@SeverityCss(ev.Severity)">@ev.Severity</span>
            </button>
        }
    </div>
</div>

@if (_selectedEvent is null)
{
    <div class="cat-no-selection">
        <i class="bi bi-cloud-lightning cat-ns-icon" aria-hidden="true"></i>
        <h3>Select a CAT event above to view the surge dashboard</h3>
        <p>Or declare a new event using the button in the top right.</p>
    </div>
}
else
{
    <!-- ── SURGE DASHBOARD KPI ────────────────────────────────────── -->
    <div class="cat-surge-header">
        <div class="cat-surge-title">
            <i class="bi @EventIcon(_selectedEvent.EventType) cat-sth-icon" aria-hidden="true"></i>
            <div>
                <h2 class="cat-sth-name">@_selectedEvent.Name</h2>
                <div class="cat-sth-meta">
                    <span class="cat-ev-sev cat-sev-@SeverityCss(_selectedEvent.Severity)">@_selectedEvent.Severity</span>
                    <span class="cat-sth-chip"><i class="bi bi-geo-alt" aria-hidden="true"></i>@_selectedEvent.AffectedStates</span>
                    <span class="cat-sth-chip"><i class="bi bi-calendar-event" aria-hidden="true"></i>@_selectedEvent.StartDate.ToString("MM/dd/yyyy")@(_selectedEvent.EndDate.HasValue ? " – " + _selectedEvent.EndDate.Value.ToString("MM/dd/yyyy") : " — ongoing")</span>
                    <span class="cat-sth-chip"><i class="bi bi-tag" aria-hidden="true"></i>@_selectedEvent.CatCode</span>
                </div>
            </div>
        </div>
        <!-- Mass workflow action bar -->
        <div class="cat-mass-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showGeoTagDlg = true">
                <i class="bi bi-geo-alt" aria-hidden="true"></i> Geo-Tag Insureds
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenBlast">
                <i class="bi bi-megaphone" aria-hidden="true"></i> Campaign Blast
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => { _fastFnol = new(); _showFastFnolDlg = true; }">
                <i class="bi bi-clipboard-plus" aria-hidden="true"></i> Fast FNOL
            </button>
            <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => Nav.NavigateTo("/claims/new")'>
                <i class="bi bi-clipboard-check" aria-hidden="true"></i> Full FNOL
            </button>
        </div>
    </div>

    <!-- Surge KPI cards -->
    <div class="cat-kpi-grid">
        @CatKpi("bi-people-fill",        "Affected Insureds",    _ev.AffectedInsureds.ToString("N0"),   "cat-ki-blue",   "Insureds affected by event footprint")
        @CatKpi("bi-geo-alt-fill",        "Geo-Tagged",           _ev.GeoTagged.ToString("N0"),          "cat-ki-purple", "Insureds tagged in this event")
        @CatKpi("bi-clipboard-plus",      "FNOLs Received",       _ev.FnolReceived.ToString("N0"),       "cat-ki-amber",  "First notices of loss filed")
        @CatKpi("bi-telephone-fill",      "Pending Contact",      _ev.PendingContact.ToString("N0"),     "cat-ki-red",    "Tagged insureds not yet contacted")
        @CatKpi("bi-exclamation-circle",  "Claims Opened",        _ev.ClaimsOpened.ToString("N0"),       "cat-ki-red",    "Claims created under this event")
        @CatKpi("bi-safe",                "Est. TIV at Risk",     _ev.EstTivAtRisk.ToString("C0"),       "cat-ki-amber",  "Total insured value in event footprint")
        @CatKpi("bi-currency-dollar",     "Projected Incurred",   _ev.ProjectedIncurred.ToString("C0"),  "cat-ki-red",    "Aggregate projected loss estimate")
        @CatKpi("bi-calculator",          "Avg Claim Amount",     _ev.AvgClaimAmount.ToString("C0"),     "cat-ki-gray",   "Average claim incurred to date")
        @CatKpi("bi-person-gear",         "CAT Team Assigned",    _ev.CatTeamCount.ToString(),           "cat-ki-blue",   "Handlers assigned to this event")
        @CatKpi("bi-megaphone",           "Campaigns Sent",       _ev.CampaignsSent.ToString(),          "cat-ki-purple", "Outbound communications sent")
        @CatKpi("bi-envelope-check",      "Blast Reach",          _ev.BlastReach.ToString("N0"),         "cat-ki-blue",   "Insureds reached via campaign blast")
        @CatKpi("bi-graph-up-arrow",      "Daily Intake Peak",    _ev.DailyIntakePeak.ToString("N0") + "/day", "cat-ki-amber", "Peak FNOL intake rate")
    </div>

    <!-- Surge alert -->
    @if (_ev.SurgeAlert)
    {
        <div class="cat-surge-alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <div>
                <strong>SURGE ALERT:</strong> FNOL intake is at <strong>@_ev.DailyIntakePeak/day</strong> — exceeding handler capacity threshold of @_ev.CapacityThreshold/day.
                Recommend activating overflow team or TPA escalation.
            </div>
            <button class="um-btn um-btn-danger um-btn-sm" @onclick="EscalateSurge">Escalate to TPA</button>
        </div>
    }

    <!-- ── 4-TAB BODY ────────────────────────────────────────────── -->
    <AppDetailTabs SelectedTab="_tab" SelectedTabChanged="t => _tab = t">
        <Tabs>

            <!-- TAB 0 — AFFECTED INSUREDS ──────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Affected Insureds" IconCss="bi bi-people" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="cat-ins-toolbar">
                            <div class="cat-ins-filter-row">
                                <input class="e-input cat-ins-search" @bind="_insuredSearch" @bind:event="oninput" placeholder="Search name, ZIP, county, policy #…" />
                                <select class="e-input cat-ins-sel" @bind="_insuredLobFilter">
                                    <option value="">All LOBs</option>
                                    @foreach (var l in _lobOpts) { <option>@l</option> }
                                </select>
                                <select class="e-input cat-ins-sel" @bind="_insuredTagFilter">
                                    <option value="">All</option>
                                    <option value="Tagged">Geo-Tagged</option>
                                    <option value="Contacted">Contacted</option>
                                    <option value="FNOL Filed">FNOL Filed</option>
                                    <option value="No Contact">No Contact</option>
                                </select>
                                <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetInsuredFilters">Reset</button>
                                <span class="cr-filter-count">@FilteredInsureds.Count() insured(s)</span>
                            </div>
                            <div class="cat-ins-actions">
                                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showGeoTagDlg = true">
                                    <i class="bi bi-geo-alt" aria-hidden="true"></i> Geo-Tag
                                </button>
                                <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenBlast">
                                    <i class="bi bi-megaphone" aria-hidden="true"></i> Blast Selected
                                </button>
                            </div>
                        </div>

                        <SfGrid TValue="AffectedInsured" DataSource="@FilteredInsureds.ToList()"
                                AllowSorting="true" AllowPaging="true" AllowResizing="true"
                                AllowFiltering="true" EnableHover="true" RowHeight="58">
                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                            <GridPageSettings PageSize="20" />
                            <GridColumns>
                                <GridColumn Field="@nameof(AffectedInsured.AccountName)" HeaderText="Insured / Account" MinWidth="190">
                                    <Template>
                                        @{ var a = (AffectedInsured)context; }
                                        <div class="cr-acct-cell">
                                            <button class="cr-acct-link" @onclick='() => Nav.NavigateTo($"/accounts/{a.AccountId}")'>@a.AccountName</button>
                                            <div class="cr-acct-meta">@a.PolicyNumber · @a.Lob</div>
                                        </div>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(AffectedInsured.ContactStatus)" HeaderText="Status" Width="130">
                                    <Template>
                                        @{ var a = (AffectedInsured)context; }
                                        <span class="cat-ins-status cat-iss-@ContactStatusCss(a.ContactStatus)">@a.ContactStatus</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(AffectedInsured.GeoTagged)" HeaderText="Tagged" Width="90">
                                    <Template>
                                        @{ var a = (AffectedInsured)context; }
                                        <i class="bi @(a.GeoTagged ? "bi-geo-alt-fill cat-geo-yes" : "bi-geo-alt cat-geo-no")" aria-hidden="true"></i>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(AffectedInsured.County)"     HeaderText="County"  Width="130" />
                                <GridColumn Field="@nameof(AffectedInsured.ZipCode)"    HeaderText="ZIP"     Width="90" />
                                <GridColumn Field="@nameof(AffectedInsured.Lob)"        HeaderText="LOB"     Width="160" />
                                <GridColumn Field="@nameof(AffectedInsured.TivAtRisk)"  HeaderText="TIV at Risk" Width="135"
                                            TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>
                                        @{ var a = (AffectedInsured)context; }
                                        <span class="pd-mono @(a.TivAtRisk > 500_000 ? "pd-viol-warn" : "")">@a.TivAtRisk.ToString("C0")</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(AffectedInsured.FnolFiled)"  HeaderText="FNOL Filed" Width="105">
                                    <Template>
                                        @{ var a = (AffectedInsured)context; }
                                        <i class="bi @(a.FnolFiled ? "bi-check-circle-fill pd-chk-yes" : "bi-dash-circle pd-chk-no")" aria-hidden="true"></i>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(AffectedInsured.BlastSent)"  HeaderText="Blast Sent" Width="105">
                                    <Template>
                                        @{ var a = (AffectedInsured)context; }
                                        <i class="bi @(a.BlastSent ? "bi-envelope-check-fill pd-chk-yes" : "bi-envelope pd-chk-no")" aria-hidden="true"></i>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(AffectedInsured.Handler)"    HeaderText="Handler" Width="140" />
                                <GridColumn HeaderText="Actions" Width="165" AllowSorting="false" AllowFiltering="false">
                                    <Template>
                                        @{ var a = (AffectedInsured)context; }
                                        <div class="rdb-row-actions">
                                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenFastFnol(a.PolicyNumber)" title="Fast FNOL">
                                                <i class="bi bi-clipboard-plus" aria-hidden="true"></i> FNOL
                                            </button>
                                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => MarkContacted(a)" title="Mark contacted">
                                                <i class="bi bi-telephone-fill" aria-hidden="true"></i>
                                            </button>
                                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => Nav.NavigateTo($"/accounts/{a.AccountId}")' title="Open account">
                                                <i class="bi bi-arrow-right-circle" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>

                        <!-- Geo heatmap summary by county -->
                        <div class="cat-county-hdr" style="margin-top:1rem;">
                            <i class="bi bi-map" aria-hidden="true"></i> County / ZIP Concentration
                        </div>
                        <div class="cat-county-grid">
                            @foreach (var grp in _affectedInsureds.GroupBy(a => a.County).OrderByDescending(g => g.Count()))
                            {
                                var pct = (double)grp.Count() / Math.Max(_affectedInsureds.Count,1) * 100;
                                <div class="cat-county-row">
                                    <span class="cat-county-name">@grp.Key</span>
                                    <div class="cat-county-bar-wrap">
                                        <div class="cat-county-bar" style="width:@pct.ToString("F0")%"></div>
                                    </div>
                                    <span class="cat-county-count">@grp.Count()</span>
                                    <span class="cat-county-tiv pd-mono">@grp.Sum(a => a.TivAtRisk).ToString("C0")</span>
                                </div>
                            }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- TAB 1 — FNOL TRACKER ─────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="FNOL Tracker" IconCss="bi bi-clipboard-pulse" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <!-- Pipeline stages -->
                        <div class="cat-pipeline">
                            @foreach (var stage in _fnolStages)
                            {
                                var count = _catClaims.Count(c => c.Stage == stage.Key);
                                <div class="cat-pipe-col">
                                    <div class="cat-pipe-hdr cat-pipe-@stage.Value">
                                        <span class="cat-pipe-label">@stage.Key</span>
                                        <span class="cat-pipe-count">@count</span>
                                    </div>
                                    @foreach (var c in _catClaims.Where(cl => cl.Stage == stage.Key))
                                    {
                                        <div class="cat-pipe-card" @onclick="() => GoToClaim(c.ClaimId)">
                                            <div class="cat-pc-num">@c.ClaimNumber</div>
                                            <div class="cat-pc-acct">@c.AccountName</div>
                                            <div class="cat-pc-meta">@c.LossType · @c.DaysOpen d</div>
                                            <div class="cat-pc-incurred pd-mono">@c.TotalIncurred.ToString("C0")</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- FNOL grid -->
                        <div class="pd-tab-toolbar" style="margin-top:1rem;">
                            <span class="pd-tab-count">@_catClaims.Count FNOL(s) under @_selectedEvent!.CatCode</span>
                            <button class="um-btn um-btn-primary um-btn-sm" @onclick="() => { _fastFnol = new(); _showFastFnolDlg = true; }">
                                <i class="bi bi-clipboard-plus" aria-hidden="true"></i> Fast FNOL
                            </button>
                        </div>
                        <SfGrid TValue="CatClaimRow" DataSource="_catClaims"
                                AllowSorting="true" AllowFiltering="true" AllowResizing="true" EnableHover="true" RowHeight="54">
                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                            <GridColumns>
                                <GridColumn Field="@nameof(CatClaimRow.ClaimNumber)" HeaderText="Claim #" Width="155">
                                    <Template>
                                        @{ var c = (CatClaimRow)context; }
                                        <button class="cr-claim-link" @onclick="() => GoToClaim(c.ClaimId)">@c.ClaimNumber</button>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CatClaimRow.AccountName)"  HeaderText="Account"     MinWidth="180" />
                                <GridColumn Field="@nameof(CatClaimRow.Stage)"         HeaderText="Stage"       Width="140">
                                    <Template>
                                        @{ var c = (CatClaimRow)context; }
                                        <span class="cat-stage-chip cat-stage-@_fnolStages.GetValueOrDefault(c.Stage,"gen")">@c.Stage</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CatClaimRow.LossType)"     HeaderText="Loss Type"   Width="155" />
                                <GridColumn Field="@nameof(CatClaimRow.DateOfLoss)"   HeaderText="Date of Loss" Width="125">
                                    <Template>@{ var c = (CatClaimRow)context; }<span class="pd-mono">@c.DateOfLoss.ToString("MM/dd/yyyy")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CatClaimRow.DaysOpen)"      HeaderText="Days Open"   Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                                <GridColumn Field="@nameof(CatClaimRow.TotalIncurred)" HeaderText="Incurred"    Width="125" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (CatClaimRow)context; }<span class="pd-mono">@c.TotalIncurred.ToString("C0")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CatClaimRow.AssignedHandler)" HeaderText="Handler"  Width="140" />
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- TAB 2 — CAMPAIGN BLAST ──────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Campaign Blast" IconCss="bi bi-megaphone" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_campaigns.Count campaign(s) for this event</span>
                            <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenBlast">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> New Blast
                            </button>
                        </div>
                        @foreach (var camp in _campaigns.OrderByDescending(c => c.SentAt))
                        {
                            <div class="cat-camp-card">
                                <div class="cat-camp-top">
                                    <div class="cat-camp-info">
                                        <div class="cat-camp-subject">@camp.Subject</div>
                                        <div class="cat-camp-meta">
                                            <span class="cat-camp-channel cat-ch-@camp.Channel.ToLower().Replace(" ","").Replace("+","")">@camp.Channel</span>
                                            <span>@camp.SentAt.ToString("MM/dd/yyyy h:mm tt")</span>
                                            <span>by @camp.SentBy</span>
                                            <span class="cat-camp-status cat-cst-@camp.Status.ToLower()">@camp.Status</span>
                                        </div>
                                    </div>
                                    <div class="cat-camp-stats">
                                        @CampStat("bi-send", camp.TotalSent.ToString("N0"), "Sent")
                                        @CampStat("bi-envelope-check", camp.Delivered.ToString("N0"), "Delivered")
                                        @CampStat("bi-eye", camp.Opened.ToString("N0"), "Opened")
                                        @CampStat("bi-cursor", camp.Responded.ToString("N0"), "Responded")
                                    </div>
                                </div>
                                <div class="cat-camp-bar-wrap">
                                    <div class="cat-camp-bar" style="width:@((double)camp.Delivered/Math.Max(camp.TotalSent,1)*100)%"></div>
                                </div>
                                <div class="cat-camp-rates">
                                    <span>Delivery rate: <strong>@(((double)camp.Delivered/Math.Max(camp.TotalSent,1)*100).ToString("F0"))%</strong></span>
                                    <span>Open rate: <strong>@(((double)camp.Opened/Math.Max(camp.Delivered,1)*100).ToString("F0"))%</strong></span>
                                    <span>Response rate: <strong>@(((double)camp.Responded/Math.Max(camp.Delivered,1)*100).ToString("F0"))%</strong></span>
                                </div>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- TAB 3 — TEAM & RESOURCES ────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Team &amp; Resources" IconCss="bi bi-people-fill" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <!-- Daily intake chart proxy -->
                        <div class="cat-intake-hdr"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Daily FNOL Intake vs Capacity</div>
                        <div class="cat-intake-chart">
                            @foreach (var day in _dailyIntake)
                            {
                                var pct     = (double)day.FnolCount / Math.Max(_ev.CapacityThreshold, 1) * 100;
                                var overCap = day.FnolCount > _ev.CapacityThreshold;
                                <div class="cat-day-col">
                                    <div class="cat-day-bar-wrap">
                                        <div class="cat-cap-line" style="bottom:@(Math.Min(100,100))%"></div>
                                        <div class="cat-day-bar @(overCap ? "cat-day-over" : "")"
                                             style="height:@Math.Min(pct,100).ToString("F0")%"
                                             title="@day.Date.ToString("MM/dd"): @day.FnolCount FNOLs">
                                        </div>
                                    </div>
                                    <div class="cat-day-lbl">@day.Date.ToString("M/d")</div>
                                    <div class="cat-day-num @(overCap ? "cat-day-over-txt" : "")">@day.FnolCount</div>
                                </div>
                            }
                            <div class="cat-cap-legend">
                                <span class="cat-cap-line-lbl">— Capacity (@_ev.CapacityThreshold/day)</span>
                            </div>
                        </div>

                        <!-- Team roster -->
                        <div class="pd-tab-toolbar" style="margin-top:1rem;">
                            <div class="cat-intake-hdr" style="margin:0;">
                                <i class="bi bi-people-fill" aria-hidden="true"></i> CAT Team Roster
                            </div>
                        </div>
                        <div class="cat-team-grid">
                            @foreach (var member in _catTeam)
                            {
                                var assignedCount = _catClaims.Count(c => c.AssignedHandler == member.Name);
                                var capacityPct   = (double)assignedCount / Math.Max(member.DailyCapacity, 1) * 100;
                                <div class="cat-team-card">
                                    <div class="cat-tm-avatar">@member.Name[0]</div>
                                    <div class="cat-tm-info">
                                        <div class="cat-tm-name">@member.Name</div>
                                        <div class="cat-tm-role">@member.Role</div>
                                        <div class="cat-tm-loc"><i class="bi bi-geo-alt" aria-hidden="true"></i>@member.Location</div>
                                    </div>
                                    <div class="cat-tm-stats">
                                        <div class="cat-tm-stat">
                                            <span class="cat-tm-st-val @(capacityPct > 90 ? "cat-day-over-txt" : "")">@assignedCount</span>
                                            <span class="cat-tm-st-lbl">Assigned</span>
                                        </div>
                                        <div class="cat-tm-stat">
                                            <span class="cat-tm-st-val">@member.DailyCapacity</span>
                                            <span class="cat-tm-st-lbl">Daily Cap</span>
                                        </div>
                                        <div class="cat-tm-stat">
                                            <span class="cat-tm-st-val">@member.Region</span>
                                            <span class="cat-tm-st-lbl">Region</span>
                                        </div>
                                    </div>
                                    <div class="cat-tm-bar-wrap" title="@capacityPct.ToString("F0")% capacity">
                                        <div class="cat-tm-bar @(capacityPct > 90 ? "cat-tm-bar-over" : "")"
                                             style="width:@Math.Min(capacityPct,100).ToString("F0")%"></div>
                                    </div>
                                    <div class="cat-tm-type">
                                        <span class="cat-type-chip cat-type-@member.AdjusterType.ToLower().Replace(" ","-")">@member.AdjusterType</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

        </Tabs>
    </AppDetailTabs>
}

@code {
    SfToast _toast = default!;
    int     _tab   = 0;
    readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    bool          _showNewEventDlg = false;
    bool          _showBlastDlg    = false;
    bool          _showGeoTagDlg   = false;
    bool          _showFastFnolDlg = false;

    string _insuredSearch    = "";
    string _insuredLobFilter = "";
    string _insuredTagFilter = "";

    CatEvent?      _selectedEvent = null;
    CatEventStats  _ev            = new();

    // ── Form objects ─────────────────────────────────────────────
    NewEventForm  _newEvent  = new();
    BlastForm     _blast     = new();
    GeoTagForm    _geoTag    = new();
    FastFnolForm  _fastFnol  = new();

    int    _blastTargetCount    = 0;
    string _blastChannelSummary = "";

    // ── Lookup data ───────────────────────────────────────────────
    readonly string[] _eventTypes    = { "Hurricane","Wildfire","Hailstorm","Winter Storm","Flooding","Tornado","Earthquake","Tsunami","Other" };
    readonly string[] _lobOpts       = { "All","Commercial Property","Commercial Auto","General Liability","Workers Comp","Home/Dwelling","Personal Auto","Umbrella" };
    readonly string[] _catLossTypes  = { "Wind/Hail","Fire","Water/Flood","Vehicle Damage","Building Damage","Debris Removal","Loss of Use","Other" };
    readonly string[] _blastTemplates= { "CAT Acknowledgement — Property","CAT Check-In — Auto","Disaster Relief Contacts","File a Claim — Next Steps","CAT Team Introduction","Emergency Hotline Notice" };

    readonly Dictionary<string,string> _fnolStages = new()
    {
        { "FNOL Received",     "received" },
        { "Acknowledged",      "ack"      },
        { "Field Inspection",  "inspect"  },
        { "Reserved",          "reserved" },
        { "Closed",            "closed"   },
    };

    // ── Data ─────────────────────────────────────────────────────
    List<CatEvent>        _events          = new();
    List<AffectedInsured> _affectedInsureds= new();
    List<CatClaimRow>     _catClaims       = new();
    List<CampaignEntry>   _campaigns       = new();
    List<CatTeamMember>   _catTeam         = new();
    List<DailyIntakeRow>  _dailyIntake     = new();

    // ── Models ────────────────────────────────────────────────────
    sealed class CatEvent
    {
        public Guid      CatEventId     { get; set; }
        public string    Name           { get; set; } = "";
        public string    CatCode        { get; set; } = "";
        public string    EventType      { get; set; } = "";
        public string    Severity       { get; set; } = "";
        public string    AffectedStates { get; set; } = "";
        public DateTime  StartDate      { get; set; }
        public DateTime? EndDate        { get; set; }
        public string    Description    { get; set; } = "";
    }

    sealed class CatEventStats
    {
        public int     AffectedInsureds  { get; set; }
        public int     GeoTagged         { get; set; }
        public int     FnolReceived      { get; set; }
        public int     PendingContact    { get; set; }
        public int     ClaimsOpened      { get; set; }
        public decimal EstTivAtRisk      { get; set; }
        public decimal ProjectedIncurred { get; set; }
        public decimal AvgClaimAmount    { get; set; }
        public int     CatTeamCount      { get; set; }
        public int     CampaignsSent     { get; set; }
        public int     BlastReach        { get; set; }
        public int     DailyIntakePeak   { get; set; }
        public int     CapacityThreshold { get; set; }
        public bool    SurgeAlert        { get; set; }
    }

    sealed class AffectedInsured
    {
        public Guid    AffectedInsuredId { get; set; }
        public Guid    AccountId      { get; set; }
        public string  AccountName    { get; set; } = "";
        public string  PolicyNumber   { get; set; } = "";
        public string  Lob            { get; set; } = "";
        public string  County         { get; set; } = "";
        public string  ZipCode        { get; set; } = "";
        public decimal TivAtRisk      { get; set; }
        public bool    GeoTagged      { get; set; }
        public bool    FnolFiled      { get; set; }
        public bool    BlastSent      { get; set; }
        public string  ContactStatus  { get; set; } = "";
        public string  Handler        { get; set; } = "";
    }

    sealed class CatClaimRow
    {
        public Guid    ClaimId         { get; set; }
        public string  ClaimNumber     { get; set; } = "";
        public string  AccountName     { get; set; } = "";
        public string  LossType        { get; set; } = "";
        public string  Stage           { get; set; } = "";
        public DateTime DateOfLoss     { get; set; }
        public int     DaysOpen        { get; set; }
        public decimal TotalIncurred   { get; set; }
        public string  AssignedHandler { get; set; } = "";
    }

    sealed class CampaignEntry
    {
        public string   Subject    { get; set; } = "";
        public string   Channel    { get; set; } = "";
        public string   Status     { get; set; } = "";
        public DateTime SentAt     { get; set; }
        public string   SentBy     { get; set; } = "";
        public int      TotalSent  { get; set; }
        public int      Delivered  { get; set; }
        public int      Opened     { get; set; }
        public int      Responded  { get; set; }
    }

    sealed class CatTeamMember
    {
        public string Name          { get; set; } = "";
        public string Role          { get; set; } = "";
        public string AdjusterType  { get; set; } = "";
        public string Location      { get; set; } = "";
        public string Region        { get; set; } = "";
        public int    DailyCapacity { get; set; }
    }

    sealed class DailyIntakeRow { public DateTime Date; public int FnolCount; }

    sealed class NewEventForm { public string Name=""; public string EventType=""; public string Severity="High"; public DateTime? StartDate; public DateTime? EndDate; public string AffectedStates=""; public string CatCode=""; public string Description=""; }
    sealed class BlastForm    { public string Channel="Email"; public string Template=""; public string Subject=""; public string Body=""; public string Schedule="Send Now"; public DateTime ScheduledAt=DateTime.Now.AddHours(1); }
    sealed class GeoTagForm   { public string States=""; public string Zips=""; public string Counties=""; public int? RadiusMiles; public string LobFilter=""; public decimal? MinTiv; public int PreviewCount; }
    sealed class FastFnolForm { public string PolicyNumber=""; public string InsuredName=""; public string Phone=""; public string LossType=""; public string EstimatedRange="Unknown"; public string Description=""; }

    IEnumerable<AffectedInsured> FilteredInsureds => _affectedInsureds.Where(a =>
        (string.IsNullOrEmpty(_insuredSearch) ||
         a.AccountName.Contains(_insuredSearch,StringComparison.OrdinalIgnoreCase) ||
         a.PolicyNumber.Contains(_insuredSearch,StringComparison.OrdinalIgnoreCase) ||
         a.County.Contains(_insuredSearch,StringComparison.OrdinalIgnoreCase) ||
         a.ZipCode.Contains(_insuredSearch,StringComparison.OrdinalIgnoreCase))
     && (string.IsNullOrEmpty(_insuredLobFilter) || _insuredLobFilter=="All" || a.Lob == _insuredLobFilter)
     && (_insuredTagFilter == "" ||
        (_insuredTagFilter == "Tagged"    && a.GeoTagged) ||
        (_insuredTagFilter == "Contacted" && a.ContactStatus == "Contacted") ||
        (_insuredTagFilter == "FNOL Filed"&& a.FnolFiled) ||
        (_insuredTagFilter == "No Contact"&& a.ContactStatus == "No Contact")));

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Claims","/claims"), new("Catastrophe View",""));
        await LoadPageAsync();
    }

    async Task LoadPageAsync(Guid? catEventId = null)
    {
        var page = await Api.GetCatastrophePageAsync(_tenantId, catEventId);
        _events = page?.Events.Select(e => new CatEvent { CatEventId=e.CatEventId, Name=e.Name, CatCode=e.CatCode, EventType=e.EventType, Severity=e.Severity, AffectedStates=e.AffectedStates, StartDate=e.StartDate, EndDate=e.EndDate, Description=e.Description }).ToList() ?? [];
        _selectedEvent = _events.FirstOrDefault(e => e.CatEventId == catEventId) ?? _events.FirstOrDefault();
        BuildEventData(page ?? new CatastrophePageDto());
    }

    async Task SelectEvent(CatEvent ev)
    {
        _tab = 0;
        await LoadPageAsync(ev.CatEventId);
    }

    void BuildEventData(CatastrophePageDto page)
    {
        _affectedInsureds = page.AffectedInsureds.Select(a => new AffectedInsured { AffectedInsuredId=a.AffectedInsuredId, AccountId=a.AccountId, AccountName=a.AccountName, PolicyNumber=a.PolicyNumber, Lob=a.Lob, County=a.County, ZipCode=a.ZipCode, TivAtRisk=a.TivAtRisk, GeoTagged=a.GeoTagged, FnolFiled=a.FnolFiled, BlastSent=a.BlastSent, ContactStatus=a.ContactStatus, Handler=a.Handler }).ToList();
        _catClaims = page.Claims.Select(c => new CatClaimRow { ClaimId=c.ClaimId, ClaimNumber=c.ClaimNumber, AccountName=c.AccountName, LossType=c.LossType, Stage=ClaimStage(c), DateOfLoss=c.DateOfLoss, DaysOpen=c.DaysOpen, TotalIncurred=c.TotalIncurred, AssignedHandler=c.AssignedHandler }).ToList();
        _campaigns = page.Campaigns.Select(c => new CampaignEntry { Subject=c.Title, Channel=string.IsNullOrWhiteSpace(c.Category) ? "Email" : c.Category, Status="Delivered", SentAt=c.ActivityDate, SentBy=c.CreatedBy, TotalSent=Convert.ToInt32(c.Amount ?? 0), Delivered=Convert.ToInt32(c.Amount ?? 0), Opened=0, Responded=0 }).ToList();

        var affectedCount = _affectedInsureds.Count;
        var claimsCount = _catClaims.Count;
        var handlers = _affectedInsureds.Select(a => a.Handler).Where(h => !string.IsNullOrWhiteSpace(h)).Distinct().Count();
        var dailyPeak = _catClaims.GroupBy(c => c.DateOfLoss.Date).Select(g => g.Count()).DefaultIfEmpty(0).Max();
        _ev = new CatEventStats
        {
            AffectedInsureds=affectedCount, GeoTagged=_affectedInsureds.Count(a => a.GeoTagged), FnolReceived=_affectedInsureds.Count(a => a.FnolFiled), PendingContact=_affectedInsureds.Count(a => a.ContactStatus == "No Contact"),
            ClaimsOpened=claimsCount, EstTivAtRisk=_affectedInsureds.Sum(a => a.TivAtRisk), ProjectedIncurred=_catClaims.Sum(c => c.TotalIncurred),
            AvgClaimAmount=claimsCount == 0 ? 0 : _catClaims.Average(c => c.TotalIncurred), CatTeamCount=handlers, CampaignsSent=_campaigns.Count, BlastReach=_affectedInsureds.Count(a => a.BlastSent),
            DailyIntakePeak=dailyPeak,
            CapacityThreshold=18,
            SurgeAlert=dailyPeak > 18
        };

        _catTeam.Clear();
        _catTeam.AddRange(new[]
        {
            new CatTeamMember { Name="Sarah Kim",   Role="Lead Handler",    AdjusterType="Staff Adjuster",  Location="Houston, TX",     Region="Gulf Coast",  DailyCapacity=20 },
            new CatTeamMember { Name="Kevin Obi",   Role="Handler",         AdjusterType="Staff Adjuster",  Location="Houston, TX",     Region="Gulf Coast",  DailyCapacity=18 },
            new CatTeamMember { Name="Lisa Chen",   Role="Property Specialist",AdjusterType="Staff Adjuster",Location="Dallas, TX",     Region="North TX",    DailyCapacity=15 },
            new CatTeamMember { Name="James Park",  Role="Handler",         AdjusterType="Staff Adjuster",  Location="San Antonio, TX", Region="Central TX",  DailyCapacity=18 },
            new CatTeamMember { Name="Maria Santos",Role="Supervisor",      AdjusterType="Supervisor",      Location="Austin, TX",      Region="All",         DailyCapacity=8  },
            new CatTeamMember { Name="TPA — Crawford",Role="Field Adjuster",AdjusterType="TPA",            Location="Field — TX",      Region="Statewide",   DailyCapacity=30 },
        });

        _dailyIntake = Enumerable.Range(0, 15).Select(i => DateTime.Today.AddDays(i - 14)).Select(d => new DailyIntakeRow { Date=d, FnolCount=_catClaims.Count(c => c.DateOfLoss.Date == d) }).ToList();
    }

    void OpenBlast()
    {
        _blastTargetCount    = _affectedInsureds.Count(a => a.GeoTagged);
        _blastChannelSummary = $"{_blastTargetCount} geo-tagged insured(s)";
        _blast               = new();
        _showBlastDlg        = true;
    }

    void PreviewGeoTag()
    {
        _geoTag.PreviewCount = string.IsNullOrEmpty(_geoTag.States) && string.IsNullOrEmpty(_geoTag.Counties)
            ? 142 : new Random().Next(30,120);
    }

    async Task ApplyGeoTag()
    {
        if (_selectedEvent is null) return;
        var count = await Api.ApplyGeoTagAsync(_selectedEvent.CatEventId, _geoTag.States, _geoTag.Counties, _geoTag.Zips, _geoTag.LobFilter, _geoTag.MinTiv);
        await LoadPageAsync(_selectedEvent.CatEventId);
        _showGeoTagDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Geo-Tagged", Content=$"{count} insured(s) tagged under {_selectedEvent?.CatCode}.", CssClass="e-toast-success" });
    }

    async Task MarkContacted(AffectedInsured a)
    {
        await Api.MarkAffectedInsuredContactedAsync(a.AffectedInsuredId);
        a.ContactStatus = "Contacted";
        await _toast.ShowAsync(new ToastModel { Title="Marked Contacted", Content=$"{a.AccountName} marked as contacted.", CssClass="e-toast-success" });
    }

    async Task SendBlast()
    {
        if (_selectedEvent is null || string.IsNullOrWhiteSpace(_blast.Subject)) return;
        var count = await Api.SendCatBlastAsync(new CatBlastRequest { TenantId=_tenantId, CatEventId=_selectedEvent.CatEventId, Channel=_blast.Channel, Template=_blast.Template, Subject=_blast.Subject, Body=_blast.Body, Status=_blast.Schedule=="Send Now" ? "Delivered" : "Scheduled", SentAt=_blast.Schedule=="Send Now" ? DateTime.UtcNow : _blast.ScheduledAt.ToUniversalTime() });
        await LoadPageAsync(_selectedEvent.CatEventId);
        _showBlastDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Blast Sent", Content=$"Campaign sent to {count} insured(s).", CssClass="e-toast-success" });
    }

    async Task SubmitFastFnol()
    {
        if (_selectedEvent is null || string.IsNullOrWhiteSpace(_fastFnol.PolicyNumber) || string.IsNullOrWhiteSpace(_fastFnol.InsuredName) || string.IsNullOrWhiteSpace(_fastFnol.Phone)) return;
        var claimId = await Api.CreateFastCatFnolAsync(new FastCatFnolRequest { TenantId=_tenantId, CatEventId=_selectedEvent.CatEventId, PolicyNumber=_fastFnol.PolicyNumber, InsuredName=_fastFnol.InsuredName, Phone=_fastFnol.Phone, LossType=_fastFnol.LossType, EstimatedRange=_fastFnol.EstimatedRange, Description=_fastFnol.Description });
        await LoadPageAsync(_selectedEvent.CatEventId);
        _showFastFnolDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Fast FNOL Submitted", Content=$"Claim created under {_selectedEvent?.CatCode}.", CssClass="e-toast-success" });
        Nav.NavigateTo($"/claims/{claimId}");
    }

    async Task SaveNewEvent()
    {
        if (string.IsNullOrWhiteSpace(_newEvent.Name) || string.IsNullOrWhiteSpace(_newEvent.CatCode) || string.IsNullOrWhiteSpace(_newEvent.EventType) || _newEvent.StartDate is null) return;
        var id = await Api.CreateCatEventAsync(new CreateCatEventRequest { TenantId=_tenantId, Name=_newEvent.Name, CatCode=_newEvent.CatCode, EventType=_newEvent.EventType, Severity=_newEvent.Severity, AffectedStates=_newEvent.AffectedStates, StartDate=_newEvent.StartDate.Value, EndDate=_newEvent.EndDate, Description=_newEvent.Description });
        await LoadPageAsync(id);
        _showNewEventDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="CAT Event Declared", Content=$"{_newEvent.Name} ({_newEvent.CatCode}) declared.", CssClass="e-toast-success" });
    }

    async Task EscalateSurge()
    {
        _ev.SurgeAlert = false;
        await _toast.ShowAsync(new ToastModel { Title="Escalated to TPA", Content="Overflow escalation sent to Crawford TPA.", CssClass="e-toast-warning" });
    }

    async Task Refresh() => await LoadPageAsync(_selectedEvent?.CatEventId);

    void GoToClaim(Guid id)      => Nav.NavigateTo($"/claims/{id}");
    void ResetInsuredFilters()   { _insuredSearch=""; _insuredLobFilter=""; _insuredTagFilter=""; }
    void OpenFastFnol(string policyNumber) { _fastFnol = new() { PolicyNumber=policyNumber }; _showFastFnolDlg = true; }
    static string ClaimStage(ClaimDto claim) => claim.Status == "Closed" ? "Closed" : claim.TotalReserves > 0 ? "Reserved" : claim.DaysOpen > 2 ? "Acknowledged" : "FNOL Received";

    // ── Render helpers ────────────────────────────────────────────
    RenderFragment CatKpi(string icon, string label, string val, string color, string tooltip) => __builder =>
    {
        <div class="cat-kpi-card @color" title="@tooltip">
            <i class="bi @icon cat-kpi-icon" aria-hidden="true"></i>
            <div>
                <div class="cat-kpi-val">@val</div>
                <div class="cat-kpi-lbl">@label</div>
            </div>
        </div>
    };

    RenderFragment CampStat(string icon, string val, string label) => __builder =>
    {
        <div class="cat-camp-stat">
            <i class="bi @icon" aria-hidden="true"></i>
            <div class="cat-camp-sv">@val</div>
            <div class="cat-camp-sl">@label</div>
        </div>
    };

    static string SeverityCss(string s) => s.ToLower();
    static string ContactStatusCss(string s) => s.ToLower().Replace(" ","-").Replace("/","-");
    static string EventIcon(string t) => t switch
    {
        "Hurricane"    => "bi-tornado",
        "Wildfire"     => "bi-fire",
        "Hailstorm"    => "bi-cloud-hail",
        "Winter Storm" => "bi-snow2",
        "Flooding"     => "bi-water",
        "Tornado"      => "bi-tornado",
        "Earthquake"   => "bi-activity",
        _              => "bi-cloud-lightning"
    };
}
