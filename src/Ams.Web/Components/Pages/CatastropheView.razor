    void OpenBlast()
    {
        _blastTargetCount    = _affectedInsureds.Count(a => a.GeoTagged);
        _blastChannelSummary = $"{_blastTargetCount} geo-tagged insured(s)";
        _blast               = new();
        _showBlastDlg        = true;
    }

    void PreviewGeoTag()
    {
        _geoTag.PreviewCount = string.IsNullOrEmpty(_geoTag.States) && string.IsNullOrEmpty(_geoTag.Counties)
            ? 142 : new Random().Next(30,120);
    }

    async Task ApplyGeoTag()
    {
        foreach (var a in _affectedInsureds) a.GeoTagged = true;
        _showGeoTagDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Geo-Tagged", Content=$"{_geoTag.PreviewCount} insured(s) tagged under {_selectedEvent?.CatCode}.", CssClass="e-toast-success" });
    }

    async Task MarkContacted(AffectedInsured a)
    {
        a.ContactStatus = "Contacted";
        await _toast.ShowAsync(new ToastModel { Title="Marked Contacted", Content=$"{a.AccountName} marked as contacted.", CssClass="e-toast-success" });
    }

    async Task SendBlast()
    {
        if (string.IsNullOrEmpty(_blast.Subject)) return;
        _campaigns.Insert(0, new CampaignEntry
        {
            Subject=_blast.Subject, Channel=_blast.Channel,
            Status=_blast.Schedule=="Send Now" ? "Delivered" : "Scheduled",
            SentAt=_blast.Schedule=="Send Now" ? DateTime.Now : _blast.ScheduledAt,
            SentBy="Current User", TotalSent=_blastTargetCount,
            Delivered=_blast.Schedule=="Send Now" ? (int)(_blastTargetCount*.96) : 0,
            Opened=0, Responded=0
        });
        _ev.CampaignsSent++;
        _showBlastDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Blast Sent", Content=$"Campaign sent to {_blastTargetCount} insured(s).", CssClass="e-toast-success" });
    }

    async Task SubmitFastFnol()
    {
        if (string.IsNullOrEmpty(_fastFnol.PolicyNumber)) return;
        var claimNum = $"CLM-{DateTime.Today.Year}-{new Random().Next(10000,99999)}";
        _catClaims.Insert(0, new CatClaimRow { ClaimId=Guid.NewGuid(), ClaimNumber=claimNum, AccountName=_fastFnol.InsuredName, LossType=_fastFnol.LossType, Stage="FNOL Received", DateOfLoss=DateTime.Today, DaysOpen=0, TotalIncurred=0m, AssignedHandler="Sarah Kim" });
        _ev.FnolReceived++;
        _ev.ClaimsOpened++;
        _showFastFnolDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Fast FNOL Submitted", Content=$"Claim {claimNum} created under {_selectedEvent?.CatCode}.", CssClass="e-toast-success" });
    }

    async Task SaveNewEvent()
    {
        if (string.IsNullOrEmpty(_newEvent.Name)) return;
        _events.Insert(0, new CatEvent { Name=_newEvent.Name, CatCode=_newEvent.CatCode, EventType=_newEvent.EventType, Severity=_newEvent.Severity, AffectedStates=_newEvent.AffectedStates, StartDate=_newEvent.StartDate??DateTime.Today, EndDate=_newEvent.EndDate, Description=_newEvent.Description });
        _showNewEventDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="CAT Event Declared", Content=$"{_newEvent.Name} ({_newEvent.CatCode}) declared.", CssClass="e-toast-success" });
    }

    async Task EscalateSurge()
    {
        _ev.SurgeAlert = false;
        await _toast.ShowAsync(new ToastModel { Title="Escalated to TPA", Content="Overflow escalation sent to Crawford TPA.", CssClass="e-toast-warning" });
    }

    void Refresh() { if (_selectedEvent is not null) BuildEventData(_selectedEvent); }

    void GoToClaim(Guid id)      => Nav.NavigateTo($"/claims/{id}");
    void ResetInsuredFilters()   { _insuredSearch=""; _insuredLobFilter=""; _insuredTagFilter=""; }
    void OpenFastFnol(string policyNumber) { _fastFnol = new() { PolicyNumber=policyNumber }; _showFastFnolDlg = true; }

    // ── Render helpers ────────────────────────────────────────────
    RenderFragment CatKpi(string icon, string label, string val, string color, string tooltip) => __builder =>
    {
        <div class="cat-kpi-card @color" title="@tooltip">
            <i class="bi @icon cat-kpi-icon" aria-hidden="true"></i>
            <div>
                <div class="cat-kpi-val">@val</div>
                <div class="cat-kpi-lbl">@label</div>
            </div>
        </div>
    };

    RenderFragment CampStat(string icon, string val, string label) => __builder =>
    {
        <div class="cat-camp-stat">
            <i class="bi @icon" aria-hidden="true"></i>
            <div class="cat-camp-sv">@val</div>
            <div class="cat-camp-sl">@label</div>
        </div>
    };

    static string SeverityCss(string s) => s.ToLower();
    static string ContactStatusCss(string s) => s.ToLower().Replace(" ","-").Replace("/","-");
    static string EventIcon(string t) => t switch
    {
        "Hurricane"    => "bi-tornado",
        "Wildfire"     => "bi-fire",
        "Hailstorm"    => "bi-cloud-hail",
        "Winter Storm" => "bi-snow2",
        "Flooding"     => "bi-water",
        "Tornado"      => "bi-tornado",
        "Earthquake"   => "bi-activity",
        _              => "bi-cloud-lightning"
    };
}
