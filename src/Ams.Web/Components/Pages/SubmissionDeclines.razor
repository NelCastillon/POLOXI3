@page "/submissions/declines"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Submissions
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject CurrentUserContext CurrentUser

<PageTitle>Decline Command Center â€” AMS</PageTitle>

<div class="sd-page">
    <section class="sd-hero">
        <div class="sd-hero__content">
            <div class="sd-hero__eyebrow"><i class="bi bi-x-octagon" aria-hidden="true"></i> Enterprise decline intelligence</div>
            <h1>Decline Intelligence Center</h1>
            <p>Prioritize declined submissions, recover lost premium, trigger remarketing, assign follow-up ownership, and turn declined risks into actionable opportunities.</p>
            <div class="sd-hero__meta">
                <span><i class="bi bi-stack" aria-hidden="true"></i>@ActiveDeclineCount active declines</span>
                <span><i class="bi bi-exclamation-diamond" aria-hidden="true"></i>@PriorityDeclineCount priority</span>
                <span><i class="bi bi-cash-stack" aria-hidden="true"></i>@LostPremium.ToString("C0") lost premium</span>
                <span><i class="bi bi-arrow-repeat" aria-hidden="true"></i>@RemarketingCount remarketing</span>
            </div>
        </div>
        <div class="sd-hero__actions">
            <button type="button" class="sd-btn sd-btn--light" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @_refreshIconClass" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="sd-btn sd-btn--primary" @onclick='() => Nav.NavigateTo("/submissions/new")'>
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Re-submit
            </button>
            <button type="button" class="sd-btn sd-btn--light" @onclick='() => Nav.NavigateTo("/submissions")'>
                <i class="bi bi-send" aria-hidden="true"></i> Submissions
            </button>
            <button type="button" class="sd-btn sd-btn--light" @onclick='() => Nav.NavigateTo("/submissions/applications")'>
                <i class="bi bi-clipboard-check" aria-hidden="true"></i> Applications
            </button>
            <button type="button" class="sd-btn sd-btn--light" @onclick='() => Nav.NavigateTo("/submissions/quotes")'>
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Quotes
            </button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger sd-alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="sd-kpi-strip" aria-label="Decline KPIs">
        @KpiCard("all", "Total Declines", ActiveDeclineCount.ToString(), "Active declined or withdrawn submissions", "bi-stack", "red")
        @KpiCard("priority", "Priority", PriorityDeclineCount.ToString(), "High-value, recent, or remarketing-ready declines", "bi-exclamation-octagon", "orange")
        @KpiCard("carrier", "Carrier", CarrierDeclineCount.ToString(), "Declines from carrier or market response", "bi-building-x", "amber")
        @KpiCard("remarket", "Remarketing", RemarketingCount.ToString(), "Declines pending or in remarketing", "bi-arrow-repeat", "cyan")
        @KpiCard("trend30", "30-Day Trend", Trend30Count.ToString(), "Declines received in the last 30 days", "bi-graph-down-arrow", "blue")
        @KpiCard("lost", "Lost Premium", LostPremium.ToString("C0"), "Total target premium attached to declines", "bi-cash-stack", "emerald")
    </section>

    <section class="sd-workflows" aria-label="Decline workflows">
        <button type="button" class="sd-workflow" @onclick="ShowPriorityQueue">
            <i class="bi bi-lightning-charge" aria-hidden="true"></i>
            <span><strong>Priority recovery</strong><small>Open highest-impact decline work</small></span>
        </button>
        <button type="button" class="sd-workflow" @onclick="ShowRemarketingQueue">
            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
            <span><strong>Remarketing</strong><small>Review risks that can be placed again</small></span>
        </button>
        <button type="button" class="sd-workflow" @onclick="ShowRecentDeclines">
            <i class="bi bi-calendar-range" aria-hidden="true"></i>
            <span><strong>Recent declines</strong><small>Analyze the last 30 days of losses</small></span>
        </button>
        <button type="button" class="sd-workflow" @onclick="ShowProducerView">
            <i class="bi bi-person-workspace" aria-hidden="true"></i>
            <span><strong>Producer view</strong><small>Track ownership and follow-up</small></span>
        </button>
        <button type="button" class="sd-workflow" @onclick="ShowLobView">
            <i class="bi bi-layers" aria-hidden="true"></i>
            <span><strong>LOB view</strong><small>Find decline patterns by line</small></span>
        </button>
    </section>

    <section class="sd-filter-panel" aria-label="Decline filters">
        <div class="sd-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input @bind="SearchText" @bind:event="oninput" placeholder="Search submission, account, LOB, carrier, type, reason, producer, premium, date, priorityâ€¦" />
        </div>
        <div class="sd-filter-grid">
            <label>
                <span>Decline Type</span>
                <select class="form-select" @bind="TypeFilter">
                    <option value="">All types</option>
                    @foreach (var type in TypeOptions)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </label>
            <label>
                <span>Remarketing</span>
                <select class="form-select" @bind="RemarketingFilter">
                    <option value="">All statuses</option>
                    @foreach (var status in RemarketingOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </label>
            <label>
                <span>Producer</span>
                <select class="form-select" @bind="ProducerFilter">
                    <option value="">All producers</option>
                    @foreach (var producer in ProducerOptions)
                    {
                        <option value="@producer">@producer</option>
                    }
                </select>
            </label>
            <label>
                <span>Sort</span>
                <select class="form-select" @bind="SortMode">
                    <option value="importance">Importance</option>
                    <option value="recent">Most recent</option>
                    <option value="premium">Lost premium</option>
                    <option value="remarketing">Remarketing</option>
                    <option value="producer">Producer</option>
                </select>
            </label>
        </div>
        <button type="button" class="sd-btn sd-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)">
            <i class="bi bi-x-lg" aria-hidden="true"></i> Reset
        </button>
    </section>

    <nav class="sd-tabs" aria-label="Decline views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="@TabClass(tab.Key)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </nav>

    <main class="sd-dashboard">
        <section class="sd-main-card">
            <div class="sd-card-header">
                <div>
                    <span class="sd-section-kicker">@ActiveViewTitle</span>
                    <h2>@FilteredRows.Count() declines</h2>
                    <p>Ranked by enterprise importance: recency, lost premium, decline type, priority, remarketing readiness, and market history.</p>
                </div>
                <div class="sd-card-actions">
                    <button type="button" class="sd-btn sd-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i> Previous
                    </button>
                    <span class="sd-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="sd-btn sd-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">
                        Next <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="sd-loading"><span class="sd-spinner"></span> Loading declinesâ€¦</div>
            }
            else if (!FilteredRows.Any())
            {
                <div class="sd-empty">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <strong>No declines found</strong>
                    <span>Adjust filters or refresh the decline register.</span>
                </div>
            }
            else if (_activeTab == "producer")
            {
                <div class="sd-producer-grid">
                    @foreach (var group in ProducerRows)
                    {
                        <article class="sd-producer-card">
                            <div class="sd-producer-card__head">
                                <div>
                                    <span>Producer</span>
                                    <h3>@group.Name</h3>
                                </div>
                                <strong>@group.Count</strong>
                            </div>
                            <p>@group.Premium.ToString("C0") lost premium â€¢ @group.Priority priority â€¢ @group.Remarketing remarketing</p>
                            <div class="sd-mini-bar"><span style="width:@group.Percent%"></span></div>
                            <button type="button" class="sd-btn sd-btn--ghost" @onclick="() => FilterByProducer(group.Name)">View producer</button>
                        </article>
                    }
                </div>
            }
            else if (_activeTab == "lob")
            {
                <div class="sd-lob-grid">
                    @foreach (var group in LobRows)
                    {
                        <article class="sd-lob-card">
                            <div class="sd-lob-icon"><i class="bi bi-layers" aria-hidden="true"></i></div>
                            <div>
                                <h3>@group.Name</h3>
                                <p>@group.Count declines â€¢ @group.Premium.ToString("C0") lost â€¢ @group.Priority priority</p>
                                <div class="sd-mini-bar"><span style="width:@group.Percent%"></span></div>
                            </div>
                            <button type="button" class="sd-btn sd-btn--ghost" @onclick="() => FilterByLob(group.Name)">Open</button>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="sd-table-wrap">
                    <table class="sd-table">
                        <thead>
                            <tr>
                                <th>Importance</th>
                                <th>Submission</th>
                                <th>Account</th>
                                <th>LOB</th>
                                <th>Carrier</th>
                                <th>Type</th>
                                <th>Reason</th>
                                <th>Declined</th>
                                <th>Lost Premium</th>
                                <th>Remarketing</th>
                                <th>Producer</th>
                                <th class="sd-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in PagedRows)
                            {
                                <tr class="@RowClass(row)" @onclick="() => SelectRow(row)">
                                    <td>@ImportanceBadge(row)</td>
                                    <td>
                                        <button type="button" class="sd-link-button" @onclick:stopPropagation="true" @onclick="() => OpenDecline(row)">@row.SubmissionNo</button>
                                        <small>@row.Priority priority</small>
                                    </td>
                                    <td><strong>@row.Account</strong></td>
                                    <td><span class="sd-lob-pill">@Safe(row.Lob, "Unknown")</span></td>
                                    <td>@Safe(row.Carrier, "Internal")</td>
                                    <td>@TypeBadge(row.DeclineType)</td>
                                    <td><span class="sd-reason" title="@row.DeclineReason">@row.DeclineReason</span></td>
                                    <td>@DateBadge(row.DeclineDate)</td>
                                    <td>@PremiumCell(row.LostPremium)</td>
                                    <td>@RemarketingBadge(row.RemarketingStatus)</td>
                                    <td>@Safe(row.Producer, "Unassigned")</td>
                                    <td class="sd-actions-col">
                                        <button type="button" class="sd-icon-btn" title="Open action menu" @onclick:stopPropagation="true" @onclick="() => ToggleActionMenu(row)">
                                            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                        </button>
                                        @if (_openActionMenuFor == row.DeclineId)
                                        {
                                            <div class="sd-menu" role="menu" @onclick:stopPropagation="true">
                                                <div class="sd-menu__summary">
                                                    <strong>@row.SubmissionNo</strong>
                                                    <span>@row.DeclineType</span>
                                                </div>
                                                @foreach (var action in _actions)
                                                {
                                                    <button type="button" class="@ActionMenuItemClass(action)" role="menuitem" @onclick="() => HandleActionAsync(action.Key)">
                                                        <i class="bi @action.Icon" aria-hidden="true"></i>
                                                        <span>@action.Label</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="sd-side-panel">
            <section class="sd-panel-card">
                <span class="sd-section-kicker">Selected decline</span>
                @if (_selected is null)
                {
                    <div class="sd-empty sd-empty--compact">
                        <i class="bi bi-cursor" aria-hidden="true"></i>
                        <strong>Select a decline</strong>
                        <span>Choose a decline to review reason, premium impact, and recovery actions.</span>
                    </div>
                }
                else
                {
                    <div class="sd-selected">
                        <div class="sd-selected__title">
                            <h3>@_selected.SubmissionNo</h3>
                            @RemarketingBadge(_selected.RemarketingStatus)
                        </div>
                        <p>@_selected.Account â€¢ @_selected.DeclineType</p>
                        <div class="sd-score-card">
                            <span>Importance score</span>
                            <strong>@ImportanceScore(_selected)</strong>
                            <small>@ImportanceLevel(_selected)</small>
                        </div>
                        <div class="sd-detail-list">
                            <div><span>Reason</span><strong>@_selected.DeclineReason</strong></div>
                            <div><span>LOB</span><strong>@Safe(_selected.Lob, "Unknown")</strong></div>
                            <div><span>Carrier</span><strong>@Safe(_selected.Carrier, "Internal")</strong></div>
                            <div><span>Lost Premium</span><strong>@_selected.LostPremium.ToString("C0")</strong></div>
                            <div><span>Declined</span><strong>@_selected.DeclineDate.ToString("MMM d, yyyy")</strong></div>
                            <div><span>Effective</span><strong>@_selected.EffectiveDate.ToString("MMM d, yyyy")</strong></div>
                            <div><span>Markets</span><strong>@_selected.MarketCount</strong></div>
                            <div><span>Quotes</span><strong>@_selected.QuoteCount</strong></div>
                            <div><span>Producer</span><strong>@Safe(_selected.Producer, "Unassigned")</strong></div>
                        </div>
                        <div class="sd-selected-actions">
                            <button type="button" class="sd-btn sd-btn--primary" @onclick="() => OpenDecline(_selected)"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Submission</button>
                            <button type="button" class="sd-btn sd-btn--ghost" @onclick='() => OpenActionDialog("Start Remarketing")'><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Remarket</button>
                            <button type="button" class="sd-btn sd-btn--ghost" @onclick='() => OpenActionDialog("Re-submit")'><i class="bi bi-send-plus" aria-hidden="true"></i> Re-submit</button>
                        </div>
                    </div>
                }
            </section>

            <section class="sd-panel-card">
                <span class="sd-section-kicker">Decline intelligence</span>
                <div class="sd-insight-list">
                    @foreach (var insight in Insights)
                    {
                        <div class="sd-insight">
                            <i class="bi @insight.Icon" aria-hidden="true"></i>
                            <div>
                                <strong>@insight.Title</strong>
                                <span>@insight.Description</span>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </aside>
    </main>
</div>

@if (_showActionDialog && _selected is not null)
{
    <div class="sd-modal-backdrop" role="presentation" @onclick="CloseActionDialog">
        <div class="sd-modal" role="dialog" aria-modal="true" aria-labelledby="sd-action-title" @onclick:stopPropagation="true">
            <div class="sd-modal__header">
                <i class="bi @_actionIcon" aria-hidden="true"></i>
                <span id="sd-action-title">@_actionTitle</span>
                <button type="button" class="sd-icon-btn sd-icon-btn--light ms-auto" @onclick="CloseActionDialog" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_actionForm" OnValidSubmit="ConfirmActionAsync" OnInvalidSubmit="NotifyActionValidationAsync">
                <DataAnnotationsValidator />
                <div class="sd-modal__body">
                    <div class="sd-modal-intro">
                        <strong>@_actionHelpText</strong>
                        <span>@_selected.SubmissionNo â€” @_selected.Account â€” @_selected.DeclineType</span>
                    </div>
                    <div class="sd-form-grid">
                        @if (_pendingAction == "Assign Producer")
                        {
                            <label class="sd-field sd-field--full">
                                <span>Producer / Owner <em>*</em></span>
                                <InputText class="form-control" @bind-Value="_actionForm.Producer" />
                            </label>
                        }
                        @if (_pendingAction is "Re-submit" or "Start Remarketing")
                        {
                            <label class="sd-field">
                                <span>Target Effective Date <em>*</em></span>
                                <InputDate class="form-control" @bind-Value="_actionForm.EffectiveDate" />
                            </label>
                            <label class="sd-field">
                                <span>Target Premium</span>
                                <InputNumber class="form-control" @bind-Value="_actionForm.TargetPremium" />
                            </label>
                        }
                        <label class="sd-field sd-field--full">
                            <span>@ActionNotesLabel</span>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_actionForm.Notes" />
                        </label>
                    </div>
                </div>
                <div class="sd-modal__footer">
                    <button type="button" class="sd-btn sd-btn--ghost" @onclick="CloseActionDialog" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="sd-btn sd-btn--primary" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @_actionButtonText
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showConfirmDialog)
{
    <div class="sd-modal-backdrop" role="presentation" @onclick="CloseConfirmDialog">
        <div class="sd-confirm" role="dialog" aria-modal="true" aria-labelledby="sd-confirm-title" @onclick:stopPropagation="true">
            <div class="sd-modal__header">
                <i class="bi @_confirmIcon" aria-hidden="true"></i>
                <span>Confirm decline action</span>
                <button type="button" class="sd-icon-btn sd-icon-btn--light ms-auto" @onclick="CloseConfirmDialog" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="sd-confirm__body">
                <div class="@ConfirmIconClass">
                    <i class="bi @_confirmIcon" aria-hidden="true"></i>
                </div>
                <div>
                    <h3 id="sd-confirm-title">@_confirmTitle</h3>
                    <p>@_confirmMessage</p>
                </div>
            </div>
            <div class="sd-modal__footer">
                <button type="button" class="sd-btn sd-btn--ghost" @onclick="CloseConfirmDialog" disabled="@_actionBusy">Cancel</button>
                <button type="button" class="@ConfirmButtonClass" @onclick="ExecuteConfirmedActionAsync" disabled="@_actionBusy">
                    @if (_actionBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<div class="sd-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="sd-toast @toast.CssClass">
            <i class="bi @ToastIconClass(toast)" aria-hidden="true"></i>
            <span>@toast.Message</span>
            <button type="button" @onclick="() => DismissToast(toast.Id)"><i class="bi bi-x" aria-hidden="true"></i></button>
        </div>
    }
</div>

@code {
    bool _loading;
    bool _showActionDialog;
    bool _showConfirmDialog;
    bool _actionBusy;
    string _activeTab = "all";
    string _activeKpi = "all";
    string _sortMode = "importance";
    string? _loadError;
    string? _searchText;
    string? _typeFilter;
    string? _remarketingFilter;
    string? _producerFilter;
    string? _lobFilter;
    string _refreshIconClass = string.Empty;
    Guid? _openActionMenuFor;
    Guid _tenantId;
    int _page = 1;
    const int PageSize = 18;

    DeclineRow? _selected;
    readonly DeclineActionForm _actionForm = new();
    readonly List<DeclineRow> _rows = [];
    readonly List<ToastMessage> _toasts = [];
    List<SubmissionOption> _declineTypeOptions = [];
    string _pendingAction = string.Empty;
    string _actionTitle = "Decline Action";
    string _actionIcon = "bi-x-circle";
    string _actionButtonText = "Continue";
    string _actionHelpText = string.Empty;
    string _confirmTitle = "Confirm action";
    string _confirmMessage = "Confirm this decline action?";
    string _confirmIcon = "bi-question-circle";

    readonly TabDef[] _tabs =
    [
        new("all", "All", "bi-stack"),
        new("priority", "Priority", "bi-lightning-charge"),
        new("carrier", "Carrier", "bi-building-x"),
        new("withdrawn", "Withdrawn", "bi-person-x"),
        new("nonrenew", "Non-Renewal", "bi-clipboard-x"),
        new("remarket", "Remarketing", "bi-arrow-repeat"),
        new("30days", "30 Days", "bi-calendar-range"),
        new("producer", "Producer", "bi-person-workspace"),
        new("lob", "LOB", "bi-layers"),
    ];

    readonly ActionDef[] _actions =
    [
        new("Open", "Open Submission", "bi-box-arrow-up-right", false),
        new("Re-submit", "Re-submit", "bi-arrow-repeat", false),
        new("Start Remarketing", "Start Remarketing", "bi-megaphone", false),
        new("Assign Producer", "Assign Producer", "bi-person-check", false),
        new("View Submission", "View Submission", "bi-send", false),
        new("Archive", "Archive", "bi-archive", true),
    ];

    int ActiveDeclineCount => _rows.Count(r => !r.Archived);
    int PriorityDeclineCount => PriorityRows.Count();
    int CarrierDeclineCount => _rows.Count(r => !r.Archived && r.DeclineType == "Carrier");
    int RemarketingCount => _rows.Count(r => !r.Archived && r.RemarketingStatus is "Pending" or "In Progress");
    int Trend30Count => _rows.Count(r => !r.Archived && r.DeclineDate >= DateTime.Today.AddDays(-30));
    decimal LostPremium => _rows.Where(r => !r.Archived).Sum(r => r.LostPremium);
    bool HasFilters => _activeKpi != "all" || !string.IsNullOrWhiteSpace(_searchText) || !string.IsNullOrWhiteSpace(_typeFilter) || !string.IsNullOrWhiteSpace(_remarketingFilter) || !string.IsNullOrWhiteSpace(_producerFilter) || !string.IsNullOrWhiteSpace(_lobFilter);
    string ActiveViewTitle => _tabs.FirstOrDefault(t => t.Key == _activeTab)?.Label ?? "All";
    string ConfirmIconClass => _pendingAction == "Archive" ? "sd-confirm-icon sd-confirm-icon--danger" : "sd-confirm-icon";
    string ConfirmButtonClass => _pendingAction == "Archive" ? "sd-btn sd-btn--danger" : "sd-btn sd-btn--primary";
    string ActionNotesLabel => _pendingAction switch
    {
        "Re-submit" => "Resubmission Notes",
        "Start Remarketing" => "Remarketing Strategy",
        "Assign Producer" => "Assignment Notes",
        "Archive" => "Archive Reason",
        _ => "Notes"
    };

    string? SearchText { get => _searchText; set { _searchText = value; _page = 1; } }
    string? TypeFilter { get => _typeFilter; set { _typeFilter = value; _page = 1; } }
    string? RemarketingFilter { get => _remarketingFilter; set { _remarketingFilter = value; _page = 1; } }
    string? ProducerFilter { get => _producerFilter; set { _producerFilter = value; _page = 1; } }
    string SortMode { get => _sortMode; set { _sortMode = value; _page = 1; } }

    IEnumerable<string> TypeOptions => MergeOptions(_declineTypeOptions.Select(o => o.Code), _rows.Select(r => r.DeclineType));
    IEnumerable<string> RemarketingOptions => _rows.Select(r => r.RemarketingStatus).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);
    IEnumerable<string> ProducerOptions => _rows.Select(r => Safe(r.Producer, "Unassigned")).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);
    IEnumerable<DeclineRow> PriorityRows => _rows.Where(r => !r.Archived && ImportanceLevel(r) is "Critical" or "High");

    IEnumerable<DeclineRow> TabRows => _activeTab switch
    {
        "priority" => PriorityRows,
        "carrier" => _rows.Where(r => !r.Archived && r.DeclineType == "Carrier"),
        "withdrawn" => _rows.Where(r => !r.Archived && r.DeclineType == "Withdrawn"),
        "nonrenew" => _rows.Where(r => !r.Archived && r.DeclineType == "Non-Renewal"),
        "remarket" => _rows.Where(r => !r.Archived && r.RemarketingStatus is "Pending" or "In Progress"),
        "30days" => _rows.Where(r => !r.Archived && r.DeclineDate >= DateTime.Today.AddDays(-30)),
        "producer" => _rows.Where(r => !r.Archived),
        "lob" => _rows.Where(r => !r.Archived),
        _ => _rows.Where(r => !r.Archived)
    };

    IEnumerable<DeclineRow> FilteredRows => SortRows(ApplyFilters(TabRows));
    IEnumerable<DeclineRow> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize);
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)PageSize));

    IEnumerable<GroupSummary> ProducerRows
    {
        get
        {
            var groups = FilteredRows.GroupBy(r => Safe(r.Producer, "Unassigned")).ToList();
            var max = Math.Max(1, groups.Count == 0 ? 1 : groups.Max(g => g.Count()));
            return groups.Select(g => new GroupSummary(g.Key, g.Count(), g.Sum(x => x.LostPremium), g.Count(x => ImportanceLevel(x) is "Critical" or "High"), g.Count(x => x.RemarketingStatus is "Pending" or "In Progress"), Math.Max(8, (int)Math.Round(g.Count() * 100m / max))))
                .OrderByDescending(g => g.Priority)
                .ThenByDescending(g => g.Premium);
        }
    }

    IEnumerable<GroupSummary> LobRows
    {
        get
        {
            var groups = FilteredRows.GroupBy(r => Safe(r.Lob, "Unknown")).ToList();
            var max = Math.Max(1, groups.Count == 0 ? 1 : groups.Max(g => g.Count()));
            return groups.Select(g => new GroupSummary(g.Key, g.Count(), g.Sum(x => x.LostPremium), g.Count(x => ImportanceLevel(x) is "Critical" or "High"), g.Count(x => x.RemarketingStatus is "Pending" or "In Progress"), Math.Max(8, (int)Math.Round(g.Count() * 100m / max))))
                .OrderByDescending(g => g.Premium);
        }
    }

    IEnumerable<InsightDef> Insights =>
    [
        new("Recovery pipeline", $"{RemarketingCount} declines are pending or in remarketing.", "bi-arrow-repeat"),
        new("Premium at risk", $"{LostPremium:C0} in lost premium is represented in active declines.", "bi-cash-stack"),
        new("Recent trend", $"{Trend30Count} declines were recorded in the last 30 days.", "bi-graph-down-arrow"),
        new("Carrier appetite", $"{CarrierDeclineCount} active declines came from carrier or market response.", "bi-building-x")
    ];

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Submissions", "/submissions"), new("Declines", "/submissions/declines"));
        await LoadReferenceDataAsync();
        await LoadAsync();
    }

    async Task LoadReferenceDataAsync()
    {
        var options = await Api.GetSubmissionReferenceOptionsAsync(_tenantId, "DeclineType");
        _declineTypeOptions = options?.Where(o => o.IsActive).OrderBy(o => o.SortOrder).ThenBy(o => o.OptionName).Select(o => new SubmissionOption(o.OptionCode, o.OptionName, o.IsDefault)).ToList() ?? [];
    }

    async Task LoadAsync()
    {
        _loading = true;
        _refreshIconClass = "sd-spin";
        _loadError = null;
        try
        {
            var result = await Api.SearchSubmissionsAsync(_tenantId, pageSize: 500);
            _rows.Clear();
            _rows.AddRange((result?.Items ?? [])
                .Where(s => s.Status is "Declined" or "Withdrawn")
                .Select(ToDeclineRow));

            _selected = _selected is null ? _rows.OrderByDescending(ImportanceScore).FirstOrDefault() : _rows.FirstOrDefault(r => r.DeclineId == _selected.DeclineId) ?? _rows.OrderByDescending(ImportanceScore).FirstOrDefault();
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load declines: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "sd-toast--danger");
        }
        finally
        {
            _loading = false;
            _refreshIconClass = string.Empty;
        }
    }

    static DeclineRow ToDeclineRow(SubmissionDto dto)
    {
        var row = ToDeclineRegisterRow(dto);
        return new DeclineRow
        {
            DeclineId = row.DeclineId,
            SubmissionNo = row.SubmissionNo,
            SubId = row.SubId,
            Account = row.Account,
            Lob = row.Lob,
            Carrier = dto.MarketCount > 1 ? "Multiple Markets" : row.Carrier,
            DeclineType = DeriveDeclineType(dto),
            DeclineReason = DeriveDeclineReason(dto),
            DeclineDate = row.DeclineDate,
            LostPremium = row.LostPremium,
            RemarketingStatus = dto.Status == "Declined" ? "Pending" : "Not Started",
            Producer = row.Producer,
            EffectiveDate = dto.EffectiveDate,
            ExpirationDate = dto.ExpirationDate,
            Priority = string.IsNullOrWhiteSpace(dto.Priority) ? "Normal" : dto.Priority,
            MarketCount = dto.MarketCount,
            QuoteCount = dto.QuoteCount
        };
    }

    static string DeriveDeclineType(SubmissionDto dto) => dto.Status switch
    {
        "Withdrawn" => "Withdrawn",
        _ when dto.LineOfBusiness.Contains("Renew", StringComparison.OrdinalIgnoreCase) => "Non-Renewal",
        _ => "Carrier"
    };

    static string DeriveDeclineReason(SubmissionDto dto)
    {
        if (dto.Status == "Withdrawn") return "Client withdrawn before binding.";
        if (dto.MarketCount == 0) return "Internal underwriting declined before market submission.";
        if (dto.QuoteCount == 0) return "Carrier declined based on underwriting appetite.";
        return "Market response not competitive for current placement.";
    }

    IEnumerable<DeclineRow> ApplyFilters(IEnumerable<DeclineRow> rows)
    {
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim();
            rows = rows.Where(r => Contains(r.SubmissionNo, term)
                || Contains(r.Account, term)
                || Contains(r.Lob, term)
                || Contains(r.Carrier, term)
                || Contains(r.DeclineType, term)
                || Contains(r.DeclineReason, term)
                || Contains(r.RemarketingStatus, term)
                || Contains(r.Producer, term)
                || Contains(r.Priority, term)
                || Contains(r.DeclineId.ToString(), term)
                || Contains(r.SubId.ToString(), term)
                || Contains(r.DeclineDate.ToString("MM/dd/yyyy"), term)
                || Contains(r.EffectiveDate.ToString("MM/dd/yyyy"), term)
                || Contains(r.ExpirationDate.ToString("MM/dd/yyyy"), term)
                || Contains(r.LostPremium.ToString("C0"), term)
                || Contains(r.LostPremium.ToString("0.##"), term)
                || Contains(r.MarketCount.ToString(), term)
                || Contains(r.QuoteCount.ToString(), term));
        }

        if (!string.IsNullOrWhiteSpace(_typeFilter))
        {
            rows = rows.Where(r => string.Equals(r.DeclineType, _typeFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_remarketingFilter))
        {
            rows = rows.Where(r => string.Equals(r.RemarketingStatus, _remarketingFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_producerFilter))
        {
            rows = rows.Where(r => string.Equals(Safe(r.Producer, "Unassigned"), _producerFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_lobFilter))
        {
            rows = rows.Where(r => string.Equals(Safe(r.Lob, "Unknown"), _lobFilter, StringComparison.OrdinalIgnoreCase));
        }

        rows = _activeKpi switch
        {
            "priority" => rows.Where(r => ImportanceLevel(r) is "Critical" or "High"),
            "carrier" => rows.Where(r => r.DeclineType == "Carrier"),
            "remarket" => rows.Where(r => r.RemarketingStatus is "Pending" or "In Progress"),
            "trend30" => rows.Where(r => r.DeclineDate >= DateTime.Today.AddDays(-30)),
            "lost" => rows.Where(r => r.LostPremium > 0),
            _ => rows
        };

        return rows;
    }

    IEnumerable<DeclineRow> SortRows(IEnumerable<DeclineRow> rows) => _sortMode switch
    {
        "recent" => rows.OrderByDescending(r => r.DeclineDate),
        "premium" => rows.OrderByDescending(r => r.LostPremium),
        "remarketing" => rows.OrderBy(r => r.RemarketingStatus).ThenByDescending(r => r.DeclineDate),
        "producer" => rows.OrderBy(r => Safe(r.Producer, "Unassigned")).ThenByDescending(r => r.LostPremium),
        _ => rows.OrderByDescending(ImportanceScore).ThenByDescending(r => r.DeclineDate)
    };

    int ImportanceScore(DeclineRow row)
    {
        var score = 0;
        score += row.RemarketingStatus switch
        {
            "Pending" => 26,
            "In Progress" => 22,
            "Not Started" => 14,
            "Completed" => 6,
            "Archived" => 0,
            _ => 10
        };

        var age = DaysSinceDecline(row);
        score += age switch
        {
            <= 7 => 24,
            <= 30 => 18,
            <= 60 => 10,
            _ => 4
        };

        score += row.DeclineType switch
        {
            "Carrier" => 12,
            "Non-Renewal" => 10,
            "Withdrawn" => 6,
            _ => 5
        };

        if (row.Priority.Contains("Critical", StringComparison.OrdinalIgnoreCase)) score += 20;
        else if (row.Priority.Contains("High", StringComparison.OrdinalIgnoreCase)) score += 14;
        if (row.LostPremium >= 100000) score += 14;
        else if (row.LostPremium >= 50000) score += 8;
        if (row.MarketCount > 0) score += 5;
        if (row.QuoteCount == 0 && row.DeclineType == "Carrier") score += 5;

        return Math.Clamp(score, 0, 100);
    }

    string ImportanceLevel(DeclineRow row) => ImportanceScore(row) switch
    {
        >= 78 => "Critical",
        >= 58 => "High",
        >= 36 => "Medium",
        _ => "Standard"
    };

    int DaysSinceDecline(DeclineRow row) => (int)Math.Floor((DateTime.Today - row.DeclineDate.Date).TotalDays);

    string TabCount(string key) => key switch
    {
        "all" => ActiveDeclineCount.ToString(),
        "priority" => PriorityDeclineCount.ToString(),
        "carrier" => CarrierDeclineCount.ToString(),
        "withdrawn" => _rows.Count(r => !r.Archived && r.DeclineType == "Withdrawn").ToString(),
        "nonrenew" => _rows.Count(r => !r.Archived && r.DeclineType == "Non-Renewal").ToString(),
        "remarket" => RemarketingCount.ToString(),
        "30days" => Trend30Count.ToString(),
        "producer" => _rows.Where(r => !r.Archived).Select(r => Safe(r.Producer, "Unassigned")).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString(),
        "lob" => _rows.Where(r => !r.Archived).Select(r => Safe(r.Lob, "Unknown")).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString(),
        _ => string.Empty
    };

