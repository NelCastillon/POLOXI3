    async Task HandleActionAsync(string action)
    {
        _openActionMenuFor = null;
        if (_selected is null)
        {
            ShowToast("Select a decline before running an action.", "sd-toast--danger");
            return;
        }

        switch (action)
        {
            case "Open":
            case "View Submission":
                OpenDecline(_selected);
                break;
            case "Re-submit":
            case "Start Remarketing":
            case "Assign Producer":
            case "Archive":
                OpenActionDialog(action);
                break;
        }

        await Task.CompletedTask;
    }

    void OpenActionDialog(string action)
    {
        if (_selected is null)
        {
            ShowToast("Select a decline before running an action.", "sd-toast--danger");
            return;
        }

        _pendingAction = action;
        _actionForm.Reset(_selected, action);
        (_actionTitle, _actionIcon, _actionButtonText) = action switch
        {
            "Re-submit" => ($"Re-submit {_selected.SubmissionNo}", "bi-arrow-repeat", "Prepare Re-submit"),
            "Start Remarketing" => ($"Start remarketing {_selected.SubmissionNo}", "bi-megaphone", "Start Remarketing"),
            "Assign Producer" => ($"Assign producer for {_selected.SubmissionNo}", "bi-person-check", "Assign Producer"),
            "Archive" => ($"Archive {_selected.SubmissionNo}", "bi-archive", "Continue"),
            _ => ("Decline Action", "bi-x-circle", "Continue")
        };
        _actionHelpText = action switch
        {
            "Re-submit" => "Create a copied submission with a refreshed effective date and updated premium target.",
            "Start Remarketing" => "Mark this decline for remarketing follow-up and capture the placement strategy.",
            "Assign Producer" => "Assign an owner responsible for follow-up, client communication, or remarketing.",
            "Archive" => "Archive this decline from the active worklist while preserving historical reporting.",
            _ => "Review the decline action details and confirm before changes are applied."
        };
        _showActionDialog = true;
    }

    void CloseActionDialog()
    {
        if (_actionBusy) return;
        _showActionDialog = false;
    }

    Task ConfirmActionAsync()
    {
        OpenConfirmDialog(_pendingAction);
        return Task.CompletedTask;
    }

    Task NotifyActionValidationAsync()
    {
        ShowToast("Please correct the highlighted fields before continuing.", "sd-toast--danger");
        return Task.CompletedTask;
    }

    void OpenConfirmDialog(string action)
    {
        if (_selected is null) return;

        _pendingAction = action;
        (_confirmTitle, _confirmMessage, _confirmIcon) = action switch
        {
            "Re-submit" => ($"Re-submit {_selected.SubmissionNo}?", "This will copy the declined submission into a new submission workflow for remarketing or refreshed placement.", "bi-arrow-repeat"),
            "Start Remarketing" => ($"Start remarketing {_selected.SubmissionNo}?", "This will mark the decline for remarketing follow-up and keep it visible in remarketing views.", "bi-megaphone"),
            "Assign Producer" => ($"Assign producer to {_selected.SubmissionNo}?", "This will update the visible owner for this decline work item.", "bi-person-check"),
            "Archive" => ($"Archive {_selected.SubmissionNo}?", "This removes the decline from the active worklist but keeps the record in historical reporting.", "bi-archive"),
            _ => ("Confirm action", "Confirm this decline action?", "bi-question-circle")
        };
        _showConfirmDialog = true;
    }

    void CloseConfirmDialog()
    {
        if (_actionBusy) return;
        _showConfirmDialog = false;
    }

    async Task ExecuteConfirmedActionAsync()
    {
        if (_selected is null) return;

        _actionBusy = true;
        try
        {
            var message = _pendingAction switch
            {
                "Re-submit" => await ResubmitAsync(),
                "Start Remarketing" => StartRemarketing(),
                "Assign Producer" => AssignProducer(),
                "Archive" => ArchiveDecline(),
                _ => "No action executed."
            };

            _showActionDialog = false;
            _showConfirmDialog = false;
            ShowToast(message, "sd-toast--success");
        }
        catch (Exception ex)
        {
            ShowToast($"Action failed: {ex.Message}", "sd-toast--danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    async Task<string> ResubmitAsync()
    {
        if (_selected is null) return "No decline selected.";
        var response = await Api.CopySubmissionAsync(_selected.SubId, new CopySubmissionRequest(_tenantId, _actionForm.EffectiveDate, _selected.Lob, _selected.Priority));
        return response.Message;
    }

    string StartRemarketing()
    {
        if (_selected is null) return "No decline selected.";
        _selected.RemarketingStatus = "In Progress";
        if (_selected.LostPremium == 0 && _actionForm.TargetPremium is > 0)
            _selected.LostPremium = _actionForm.TargetPremium.Value;
        Nav.NavigateTo("/renewals/remarketing");
        return $"Remarketing started for {_selected.SubmissionNo}.";
    }

    string AssignProducer()
    {
        if (_selected is null) return "No decline selected.";
        _selected.Producer = _actionForm.Producer ?? _selected.Producer;
        return $"Producer assigned to {_selected.SubmissionNo}.";
    }

    string ArchiveDecline()
    {
        if (_selected is null) return "No decline selected.";
        _selected.Archived = true;
        _selected.RemarketingStatus = "Archived";
        _page = Math.Min(_page, TotalPages);
        return $"{_selected.SubmissionNo} archived.";
    }

    void ShowToast(string message, string cssClass)
    {
        var toast = new ToastMessage(Guid.NewGuid(), message, cssClass);
        _toasts.Add(toast);
        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            await InvokeAsync(() => DismissToast(toast.Id));
        });
    }

    void DismissToast(Guid id) => _toasts.RemoveAll(t => t.Id == id);

    string TabClass(string key) => _activeTab == key ? "sd-tab sd-tab--active" : "sd-tab";
    string RowClass(DeclineRow row) => _selected?.DeclineId == row.DeclineId ? "sd-row sd-row--selected" : "sd-row";
    static string ActionMenuItemClass(ActionDef action) => action.IsDanger ? "sd-menu-item sd-menu-item--danger" : "sd-menu-item";
    static string ToastIconClass(ToastMessage toast) => toast.CssClass.Contains("danger", StringComparison.OrdinalIgnoreCase) ? "bi-exclamation-triangle" : "bi-check-circle";

    RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string tone)
    {
        var active = _activeKpi == key;
        var cardClass = active ? $"sd-kpi sd-kpi--{tone} sd-kpi--active" : $"sd-kpi sd-kpi--{tone}";
        var title = active ? "Clear KPI filter" : subtitle;
        return @<button type="button" class="@cardClass" @onclick="() => SetKpi(key)" title="@title">
            <span><i class="bi @icon" aria-hidden="true"></i>@label</span>
            <strong>@value</strong>
            <small>@subtitle</small>
        </button>;
    }

    RenderFragment TypeBadge(string type) => @<span class="sd-type sd-type--@Slug(type)">@type</span>;
    RenderFragment RemarketingBadge(string status) => @<span class="sd-remarket sd-remarket--@Slug(status)">@status</span>;
    RenderFragment ImportanceBadge(DeclineRow row) => @<span class="sd-importance sd-importance--@Slug(ImportanceLevel(row))">@ImportanceLevel(row)<small>@ImportanceScore(row)</small></span>;
    RenderFragment PremiumCell(decimal value) => @<strong class="sd-premium">@value.ToString("C0")</strong>;

    RenderFragment DateBadge(DateTime date)
    {
        var age = (DateTime.Today - date.Date).TotalDays;
        var css = age <= 7 ? "recent" : age <= 30 ? "month" : "normal";
        return @<span class="sd-date sd-date--@css">@date.ToString("MMM d, yyyy")</span>;
    }

    static bool Contains(string? source, string term) => !string.IsNullOrWhiteSpace(source) && source.Contains(term, StringComparison.OrdinalIgnoreCase);
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string Slug(string value) => value.ToLowerInvariant().Replace(" ", "-").Replace("/", "-");
    static IEnumerable<string> MergeOptions(IEnumerable<string> configured, IEnumerable<string> observed) => configured.Concat(observed).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);
    static DeclineRegisterRow ToDeclineRegisterRow(SubmissionDto dto) => new()
    {
        DeclineId = dto.SubmissionId,
        SubmissionNo = dto.SubmissionNumber,
        SubId = dto.SubmissionId,
        Account = dto.AccountName,
        Lob = dto.LineOfBusiness,
        Carrier = dto.MarketCount > 0 ? "Market Response" : "Internal",
        DeclineType = dto.Status == "Withdrawn" ? "Withdrawn" : "Carrier",
        DeclineReason = dto.Status == "Withdrawn" ? "Client withdrawn" : "Underwriting declined",
        DeclineDate = dto.ModifiedDateUtc ?? dto.CreatedDateUtc,
        LostPremium = dto.TargetPremium ?? 0,
        RemarketingStatus = dto.Status == "Declined" ? "Pending" : "Not Started",
        Producer = dto.AssignedToUserName ?? "Unassigned"
    };

    sealed record SubmissionOption(string Code, string Name, bool IsDefault);

    class DeclineRegisterRow
    {
        public Guid DeclineId { get; set; }
        public string SubmissionNo { get; set; } = string.Empty;
        public Guid SubId { get; set; }
        public string Account { get; set; } = string.Empty;
        public string Lob { get; set; } = string.Empty;
        public string Carrier { get; set; } = string.Empty;
        public string DeclineType { get; set; } = string.Empty;
        public string DeclineReason { get; set; } = string.Empty;
        public DateTime DeclineDate { get; set; }
        public decimal LostPremium { get; set; }
        public string RemarketingStatus { get; set; } = string.Empty;
        public string Producer { get; set; } = string.Empty;
    }

    sealed class DeclineRow : DeclineRegisterRow
    {
        public DateTime EffectiveDate { get; set; }
        public DateTime ExpirationDate { get; set; }
        public string Priority { get; set; } = "Normal";
        public int MarketCount { get; set; }
        public int QuoteCount { get; set; }
        public bool Archived { get; set; }
    }

    sealed class DeclineActionForm : IValidatableObject
    {
        [StringLength(120)] public string? Producer { get; set; }
        [Range(0, 999999999999)] public decimal? TargetPremium { get; set; }
        public DateTime? EffectiveDate { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
        string _action = string.Empty;

        public void Reset(DeclineRow row, string action)
        {
            _action = action;
            Producer = row.Producer;
            TargetPremium = row.LostPremium > 0 ? row.LostPremium : null;
            EffectiveDate = row.EffectiveDate == default ? DateTime.Today.AddDays(30) : row.EffectiveDate;
            Notes = action switch
            {
                "Re-submit" => "Prepare a revised submission package and address prior decline reason before market approach.",
                "Start Remarketing" => "Remarket with updated underwriting details and target alternate carrier appetite.",
                "Assign Producer" => "Producer assigned for decline follow-up and remarketing coordination.",
                "Archive" => "Archived after review; no additional action required at this time.",
                _ => string.Empty
            };
        }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (_action == "Assign Producer" && string.IsNullOrWhiteSpace(Producer))
                yield return new ValidationResult("Producer is required.", [nameof(Producer)]);

            if ((_action is "Re-submit" or "Start Remarketing") && EffectiveDate is null)
                yield return new ValidationResult("Target effective date is required.", [nameof(EffectiveDate)]);

            if ((_action is "Re-submit" or "Start Remarketing" or "Assign Producer" or "Archive") && string.IsNullOrWhiteSpace(Notes))
                yield return new ValidationResult("Notes are required for this action.", [nameof(Notes)]);
        }
    }

    sealed record TabDef(string Key, string Label, string Icon);
    sealed record ActionDef(string Key, string Label, string Icon, bool IsDanger);
    sealed record GroupSummary(string Name, int Count, decimal Premium, int Priority, int Remarketing, int Percent);
    sealed record InsightDef(string Title, string Description, string Icon);
    sealed record ToastMessage(Guid Id, string Message, string CssClass);
