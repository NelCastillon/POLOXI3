    private string ConfirmTitle => _confirmAction switch { ConfirmAction.Send => "Configure Send", ConfirmAction.Pause => "Configure Pause", ConfirmAction.Archive => "Configure Archive", ConfirmAction.Resume => "Configure Resume", ConfirmAction.Duplicate => "Configure Duplicate", ConfirmAction.Sync => "Configure Seed Sync", ConfirmAction.Export => "Configure Export", _ => "Confirm Action" };
    private string ConfirmBody => _confirmAction switch { ConfirmAction.Send when _confirmTarget is not null => $"Review send settings for <strong>{_confirmTarget.Name}</strong> before delivering to {_confirmTarget.RecipientCount:N0} recipients.", ConfirmAction.Pause when _confirmTarget is not null => $"Configure pause details for <strong>{_confirmTarget.Name}</strong> before execution.", ConfirmAction.Archive when _confirmTarget is not null => $"Configure archive settings for <strong>{_confirmTarget.Name}</strong>. It will be removed from active email blast views.", ConfirmAction.Resume when _confirmTarget is not null => $"Configure resume settings for <strong>{_confirmTarget.Name}</strong> before restarting workflow.", ConfirmAction.Duplicate when _confirmTarget is not null => $"Configure copy settings for <strong>{_confirmTarget.Name}</strong> before creating a duplicate.", ConfirmAction.Sync => "Configure seed synchronization before repairing schema or adding missing sample records.", ConfirmAction.Export => $"Configure export settings for {_filtered.Count:N0} current email blast matches.", _ => string.Empty };
    private string ConfirmButtonText => _confirmAction switch { ConfirmAction.Send => "Execute Send", ConfirmAction.Pause => "Execute Pause", ConfirmAction.Archive => "Execute Archive", ConfirmAction.Resume => "Execute Resume", ConfirmAction.Duplicate => "Create Copy", ConfirmAction.Sync => "Run Sync", ConfirmAction.Export => "Export File", _ => "Execute" };
    private string ConfirmButtonClass => _confirmAction == ConfirmAction.Archive ? "um-btn-danger" : "um-btn-primary";
    private string ConfirmIcon => _confirmAction switch { ConfirmAction.Send => "bi-send-fill", ConfirmAction.Pause => "bi-pause-circle-fill", ConfirmAction.Archive => "bi-archive-fill", ConfirmAction.Resume => "bi-play-circle-fill", ConfirmAction.Duplicate => "bi-copy", ConfirmAction.Sync => "bi-cloud-arrow-down-fill", ConfirmAction.Export => "bi-download", _ => "bi-question-circle-fill" };
    private string ConfirmIconTone => _confirmAction == ConfirmAction.Archive ? "um-confirm-icon--danger" : string.Empty;

    private IEnumerable<KpiModel> Kpis =>
    [
        new("all", "Total", _items.Count.ToString("N0"), "All active blasts", "bi-envelope-paper", "meb-ki-blue"),
        new("sent", "Sent", CountStatus("Sent").ToString("N0"), "Delivered campaigns", "bi-send-check", "meb-ki-green"),
        new("scheduled", "Scheduled", CountStatus("Scheduled").ToString("N0"), "Queued sends", "bi-calendar-check", "meb-ki-amber"),
        new("draft", "Drafts", CountStatus("Draft").ToString("N0"), "Needs review", "bi-file-earmark", "meb-ki-purple"),
        new("engaged", "Open Rate", $"{PortfolioOpenRate:N1}%", "Portfolio average", "bi-cursor", "meb-ki-cyan"),
