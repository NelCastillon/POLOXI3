@page "/marketing/email"
@page "/marketing/email-blasts"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Email Blasts â€” AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="meb-toast meb-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="meb-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="meb-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="meb-modal meb-action-modal" role="dialog" aria-modal="true" aria-labelledby="meb-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-envelope-plus" aria-hidden="true"></i>
                <span id="meb-form-title">@(_editingId == Guid.Empty ? "Create Email Blast" : "Edit Email Blast")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="meb-modal-intro">
                        <span><i class="bi bi-shield-check" aria-hidden="true"></i> Email workflow</span>
                        <p>Define sender identity, audience, schedule, and operational metrics for tenant-scoped email campaign sends.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field">
                            <label>Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.Name" />
                        </div>
                        <div class="um-field">
                            <label>Status <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.Status">
                                @foreach (var status in _statuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field um-field--full">
                            <label>Subject <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.Subject" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Preview Text</label>
                            <InputTextArea class="form-control" @bind-Value="_form.PreviewText" />
                        </div>
                        <div class="um-field">
                            <label>Audience Segment <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.AudienceSegment" />
                        </div>
                        <div class="um-field">
                            <label>Recipients <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_form.RecipientCount" />
                        </div>
                        <div class="um-field">
                            <label>Sender Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.SenderName" />
                        </div>
                        <div class="um-field">
                            <label>Sender Email <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.SenderEmail" />
                        </div>
                        <div class="um-field">
                            <label>Scheduled Date</label>
                            <InputDate class="form-control" @bind-Value="_form.ScheduledDateUtc" />
                        </div>
                        <div class="um-field">
                            <label>Opens</label>
                            <InputNumber class="form-control" @bind-Value="_form.OpenCount" />
                        </div>
                        <div class="um-field">
                            <label>Clicks</label>
                            <InputNumber class="form-control" @bind-Value="_form.ClickCount" />
                        </div>
                        <div class="um-field">
                            <label>Bounces</label>
                            <InputNumber class="form-control" @bind-Value="_form.BounceCount" />
                        </div>
                        <div class="um-field">
                            <label>Unsubscribes</label>
                            <InputNumber class="form-control" @bind-Value="_form.UnsubscribeCount" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        @(_editingId == Guid.Empty ? "Create Blast" : "Save Changes")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showConfirm && _confirmTarget is not null)
{
    <div class="meb-modal-backdrop" role="presentation" @onclick="CancelConfirm">
        <div class="meb-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="meb-confirm-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon @ConfirmIconTone"><i class="bi @ConfirmIcon"></i></div>
                <div class="um-confirm-title" id="meb-confirm-title">@ConfirmTitle</div>
                <div class="um-confirm-body">@((MarkupString)ConfirmBody)</div>
                <div class="meb-config-panel">
                    <span class="meb-config-eyebrow"><i class="bi bi-sliders" aria-hidden="true"></i> Configuration required</span>
                    @if (_confirmAction == ConfirmAction.Send)
                    {
                        <div class="meb-config-grid">
                            <label><span>Execution mode</span><select class="form-select" @bind="_actionConfig.ExecutionMode"><option value="Immediate">Send immediately</option><option value="Scheduled">Honor scheduled date</option></select></label>
                            <label><span>Audit note</span><input class="form-control" @bind="_actionConfig.Note" placeholder="Reason for send" /></label>
                            <label class="meb-config-check"><input type="checkbox" @bind="_actionConfig.SuppressUnsubscribed" /> Suppress unsubscribed contacts</label>
                            <label class="meb-config-check"><input type="checkbox" @bind="_actionConfig.RequireComplianceCheck" /> Confirm compliance review completed</label>
                        </div>
                    }
                    else if (_confirmAction == ConfirmAction.Pause || _confirmAction == ConfirmAction.Archive)
                    {
                        <div class="meb-config-grid">
                            <label class="meb-config-full"><span>Reason</span><input class="form-control" @bind="_actionConfig.Reason" placeholder="Document why this action is being executed" /></label>
                            <label class="meb-config-check"><input type="checkbox" @bind="_actionConfig.NotifyStakeholders" /> Notify stakeholders</label>
                            @if (_confirmAction == ConfirmAction.Archive)
                            {
                                <label class="meb-config-check"><input type="checkbox" @bind="_actionConfig.ExportBeforeArchive" /> Export current results before archiving</label>
                            }
                        </div>
                    }
                    else if (_confirmAction == ConfirmAction.Resume)
                    {
                        <div class="meb-config-grid">
                            <label><span>Resume mode</span><select class="form-select" @bind="_actionConfig.ExecutionMode"><option value="Scheduled">Resume scheduled workflow</option><option value="Draft">Return to draft review</option></select></label>
                            <label><span>Owner note</span><input class="form-control" @bind="_actionConfig.Note" placeholder="Optional resume note" /></label>
                        </div>
                    }
                    else if (_confirmAction == ConfirmAction.Duplicate)
                    {
                        <div class="meb-config-grid">
                            <label class="meb-config-full"><span>New blast label</span><input class="form-control" @bind="_actionConfig.NewName" placeholder="Used as the copy planning label" /></label>
                            <label><span>Starting status</span><select class="form-select" @bind="_actionConfig.ExecutionMode"><option value="Draft">Draft</option><option value="Scheduled">Scheduled planning</option></select></label>
                            <label class="meb-config-check"><input type="checkbox" @bind="_actionConfig.CopyMetrics" /> Copy planning metrics for reference</label>
                        </div>
                    }
                    else if (_confirmAction == ConfirmAction.Sync)
                    {
                        <div class="meb-config-grid">
                            <label><span>Seed mode</span><select class="form-select" @bind="_actionConfig.ExecutionMode"><option value="MissingOnly">Add missing seed data only</option><option value="RepairSchema">Repair schema and seed data</option></select></label>
                            <label class="meb-config-check"><input type="checkbox" @bind="_actionConfig.RefreshAfterAction" /> Refresh the page after sync</label>
                        </div>
                    }
                    else if (_confirmAction == ConfirmAction.Export)
                    {
                        <div class="meb-config-grid">
                            <label><span>Export scope</span><select class="form-select" @bind="_actionConfig.ExecutionMode"><option value="Filtered">Current filtered results</option><option value="All">All active email blasts</option></select></label>
                            <label class="meb-config-check"><input type="checkbox" @bind="_actionConfig.IncludeMetrics" /> Include engagement metrics</label>
                        </div>
                    }
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CancelConfirm" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn @ConfirmButtonClass" @onclick="ExecuteConfirmAsync" disabled="@_busy">@ConfirmButtonText</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="meb-enterprise-page">
    <section class="meb-header">
        <div class="meb-header-left">
            <div class="meb-lob-icon"><i class="bi bi-envelope-paper" aria-hidden="true"></i></div>
            <div class="meb-header-info">
                <div class="meb-title-row">
                    <h1 class="meb-page-title">Email Blasts</h1>
                    <span class="meb-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live marketing data</span>
                    <span class="meb-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span>
                </div>
                <div class="meb-sub-row">
                    <span>Manage sends, scheduling, engagement, compliance health, and email campaign workflow.</span>
                    <span class="meb-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Seed sync enabled</span>
                    <span class="meb-sub-chip"><i class="bi bi-check2-circle" aria-hidden="true"></i> @_filtered.Count active matches</span>
                </div>
            </div>
        </div>
        <div class="meb-header-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi @(_loading ? "bi-arrow-repeat meb-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ConfigureSync" disabled="@_busy"><i class="bi bi-cloud-arrow-down" aria-hidden="true"></i> Sync Seed</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ConfigureExport" disabled="@(!_filtered.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Blast</button>
        </div>
    </section>

    <section class="meb-kpi-strip" aria-label="Email blast metrics">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="meb-kpi-card @kpi.Tone @(_kpiFilter == kpi.Filter ? "meb-kpi-active" : null)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)">
                <span class="meb-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="meb-kpi-copy">
                    <span class="meb-kpi-label">@kpi.Label</span>
                    <span class="meb-kpi-value">@kpi.Value</span>
                    <span class="meb-kpi-caption">@kpi.Caption</span>
                </span>
            </button>
        }
    </section>

    <section class="meb-workflow-strip" aria-label="Marketing workflow shortcuts">
        <button type="button" class="meb-workflow-card meb-wf-campaign" @onclick='() => Nav.NavigateTo("/marketing/campaigns")'>
            <span class="meb-workflow-icon"><i class="bi bi-megaphone" aria-hidden="true"></i></span>
            <span class="meb-workflow-content"><strong>1</strong><span>Campaigns</span><small>Plan tenant marketing initiatives.</small></span>
        </button>
        <button type="button" class="meb-workflow-card meb-wf-builder" @onclick='() => Nav.NavigateTo("/marketing/campaigns/new")'>
            <span class="meb-workflow-icon"><i class="bi bi-magic" aria-hidden="true"></i></span>
            <span class="meb-workflow-content"><strong>2</strong><span>Builder</span><small>Compose audience, content, and schedule.</small></span>
        </button>
        <button type="button" class="meb-workflow-card meb-wf-audience" @onclick='() => Nav.NavigateTo("/marketing/segments")'>
            <span class="meb-workflow-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
            <span class="meb-workflow-content"><strong>3</strong><span>Audience</span><small>Sync dynamic segments.</small></span>
        </button>
        <button type="button" class="meb-workflow-card meb-wf-pages" @onclick='() => Nav.NavigateTo("/marketing/landing-pages")'>
            <span class="meb-workflow-icon"><i class="bi bi-window-sidebar" aria-hidden="true"></i></span>
            <span class="meb-workflow-content"><strong>4</strong><span>Pages</span><small>Review linked landing pages.</small></span>
        </button>
        <button type="button" class="meb-workflow-card meb-wf-review" @onclick='() => Nav.NavigateTo("/marketing/reviews")'>
            <span class="meb-workflow-icon"><i class="bi bi-star" aria-hidden="true"></i></span>
            <span class="meb-workflow-content"><strong>5</strong><span>Reviews</span><small>Activate review requests.</small></span>
        </button>
    </section>

    <section class="meb-enterprise-search" aria-label="Email blast filters">
        <div class="meb-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
        <div class="meb-search-body">
            <label for="meb-search">Search email blasts</label>
            <input id="meb-search" class="meb-search-input" type="search" placeholder="Search name, subject, audience, sender..." @bind="SearchFilter" @bind:event="oninput" />
            <span class="meb-search-hint">Filters apply instantly across synchronized marketing email data.</span>
        </div>
        <select class="meb-filter-select" @bind="StatusFilter" aria-label="Status filter">
            <option value="">All statuses</option>
            @foreach (var status in _statuses)
            {
                <option value="@status">@status</option>
            }
        </select>
        <select class="meb-filter-select" @bind="AudienceFilter" aria-label="Audience filter">
            <option value="">All audiences</option>
            @foreach (var audience in AudienceOptions)
            {
                <option value="@audience">@audience</option>
            }
        </select>
        <select class="meb-filter-select" @bind="EngagementFilter" aria-label="Engagement filter">
            <option value="">Engagement: all</option>
            <option value="high">Open rate: 25%+</option>
            <option value="clicks">Has clicks</option>
            <option value="risk">Compliance risk</option>
        </select>
        <div class="meb-search-result"><strong>@_filtered.Count</strong><span>matches</span></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger meb-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
        </div>
    }

    <section class="meb-content-layout">
        <div class="meb-grid-wrap">
            <div class="meb-grid-toolbar">
                <div>
                    <strong>Email blast command center</strong>
                    <span>@ActiveFilterText</span>
                </div>
                <div class="meb-toolbar-actions">
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-eraser" aria-hidden="true"></i> Reset</button>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/marketing/campaigns")'><i class="bi bi-megaphone" aria-hidden="true"></i> Campaigns</button>
                    <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add</button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="meb-loading"><i class="bi bi-arrow-repeat meb-spin" aria-hidden="true"></i><strong>Loading email blasts...</strong><span>Syncing schema, seed data, campaign sends, and engagement metrics.</span></div>
            }
            else if (!_filtered.Any())
            {
                <div class="meb-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No email blasts found</strong><span>Adjust filters or create a DB-backed email blast.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">New Email Blast</button></div>
            }
            else
            {
                <div class="meb-table-scroll">
                    <table class="meb-table">
                        <thead>
                            <tr>
                                <th>Email Blast</th>
                                <th>Status</th>
                                <th>Audience</th>
                                <th class="meb-number">Recipients</th>
                                <th class="meb-number">Open</th>
                                <th class="meb-number">Click</th>
                                <th>Send Date</th>
                                <th class="meb-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var blast in _paged)
                            {
                                <tr class="meb-table-row @(IsSelected(blast) ? "meb-table-row--selected" : null)" @onclick="() => SelectBlast(blast)">
                                    <td>
                                        <div class="meb-email-cell">
                                            <span class="meb-email-icon @StatusIconClass(blast.Status)"><i class="bi bi-envelope-paper" aria-hidden="true"></i></span>
                                            <div>
                                                <strong>@blast.Name</strong>
                                                <span>@blast.Subject</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="meb-status-chip @StatusCss(blast.Status)">@blast.Status</span></td>
                                    <td>@blast.AudienceSegment</td>
                                    <td class="meb-number">@blast.RecipientCount.ToString("N0")</td>
                                    <td class="meb-number"><span class="@(OpenRate(blast) >= 25 ? "meb-rate-good" : "meb-rate-muted")">@OpenRate(blast).ToString("N1")%</span></td>
                                    <td class="meb-number">@ClickRate(blast).ToString("N1")%</td>
                                    <td>@DisplaySendDate(blast)</td>
                                    <td>
                                        <div class="meb-row-acts">
                                            <button type="button" class="um-btn um-btn-primary um-btn-xs" @onclick="() => ConfirmSend(blast)" @onclick:stopPropagation="true" title="Send blast" disabled="@(blast.Status == "Sent")"><i class="bi bi-send" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenEdit(blast)" @onclick:stopPropagation="true" title="Edit blast"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => ConfigureDuplicate(blast)" @onclick:stopPropagation="true" title="Duplicate blast"><i class="bi bi-copy" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => ConfirmArchive(blast)" @onclick:stopPropagation="true" title="Archive blast"><i class="bi bi-archive" aria-hidden="true"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="meb-pager">
                    <span>Page @_page of @TotalPages Â· @_filtered.Count records</span>
                    <div>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                    </div>
                </div>
            }
        </div>

        <aside class="meb-detail-panel">
            @if (_selected is null)
            {
                <div class="meb-detail-empty"><i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i><strong>Select an email blast</strong><span>Click any row to inspect schedule, sender, engagement, and workflow actions.</span></div>
            }
            else
            {
                <div class="meb-detail-head">
                    <div>
                        <span class="meb-detail-eyebrow"><i class="bi bi-envelope-check" aria-hidden="true"></i> Blast detail</span>
                        <h2>@_selected.Name</h2>
                        <div class="meb-detail-meta"><span>@_selected.Status</span><span>@_selected.AudienceSegment</span><span>@DisplaySendDate(_selected)</span></div>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearSelection"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="meb-detail-body">
                    <div class="meb-detail-summary">
                        <div class="meb-meta-row"><span class="meb-meta-lbl">Recipients</span><span class="meb-meta-val">@_selected.RecipientCount.ToString("N0")</span></div>
                        <div class="meb-meta-row"><span class="meb-meta-lbl">Sent</span><span class="meb-meta-val">@_selected.SentCount.ToString("N0")</span></div>
                        <div class="meb-meta-row"><span class="meb-meta-lbl">Open rate</span><span class="meb-meta-val">@OpenRate(_selected).ToString("N1")%</span></div>
                        <div class="meb-meta-row"><span class="meb-meta-lbl">Click rate</span><span class="meb-meta-val">@ClickRate(_selected).ToString("N1")%</span></div>
                        <div class="meb-meta-row"><span class="meb-meta-lbl">Bounces</span><span class="meb-meta-val">@_selected.BounceCount.ToString("N0")</span></div>
                        <div class="meb-meta-row"><span class="meb-meta-lbl">Unsubscribes</span><span class="meb-meta-val">@_selected.UnsubscribeCount.ToString("N0")</span></div>
                    </div>
                    <div class="meb-contact-card">
                        <strong>Sender and content</strong>
                        <span><i class="bi bi-person-badge" aria-hidden="true"></i> @_selected.SenderName</span>
                        <span><i class="bi bi-envelope" aria-hidden="true"></i> @_selected.SenderEmail</span>
                        <span><i class="bi bi-chat-quote" aria-hidden="true"></i> @_selected.Subject</span>
                        <small>@(string.IsNullOrWhiteSpace(_selected.PreviewText) ? "No preview text configured." : _selected.PreviewText)</small>
                    </div>
                    <div class="meb-detail-actions">
                        <button type="button" class="um-btn um-btn-primary" @onclick="() => ConfirmSend(_selected)" disabled="@(_selected.Status == "Sent")"><i class="bi bi-send" aria-hidden="true"></i> Send</button>
                        @if (_selected.Status == "Paused")
                        {
                            <button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfigureResume(_selected)"><i class="bi bi-play-circle" aria-hidden="true"></i> Resume</button>
                        }
                        else if (_selected.Status == "Scheduled")
                        {
                            <button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfirmPause(_selected)"><i class="bi bi-pause-circle" aria-hidden="true"></i> Pause</button>
                        }
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfigureDuplicate(_selected)"><i class="bi bi-copy" aria-hidden="true"></i> Duplicate</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfirmArchive(_selected)"><i class="bi bi-archive" aria-hidden="true"></i> Archive</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    private const int PageSize = 10;
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
