@page "/marketing/email"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Email Blasts — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Email Blasts"
               Subtitle="DB-backed email campaign sends, scheduling, engagement, and compliance health"
               Icon="bi-envelope-paper">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/marketing/campaigns")'><i class="bi bi-megaphone"></i> Campaigns</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </Actions>
</AppPageHeader>

<div class="mkc-kpi-strip">
    @Kpi(null, "bi-envelope-paper", "Total", _items.Count.ToString(), "mkc-ki-blue")
    @Kpi("Sent", "bi-send-check", "Sent", _items.Count(x => x.Status == "Sent").ToString(), "mkc-ki-green")
    @Kpi("Scheduled", "bi-calendar-check", "Scheduled", _items.Count(x => x.Status == "Scheduled").ToString(), "mkc-ki-amber")
    @Kpi("Draft", "bi-file-earmark", "Drafts", _items.Count(x => x.Status == "Draft").ToString(), "mkc-ki-blue")
    @Kpi("Paused", "bi-pause-circle", "Paused", _items.Count(x => x.Status == "Paused").ToString(), "mkc-ki-amber")
    @Kpi("Engaged", "bi-cursor", "Open Rate", $"{OpenRate:N1}%", "mkc-ki-green")
</div>

<div class="mkc-filter-bar">
    <div class="mkc-search-wrap">
        <i class="bi bi-search mkc-si"></i>
        <input class="mkc-search" placeholder="Search email blasts..." @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" />
    </div>
    <select class="mkc-sel" @bind="_statusFilter" @bind:after="ApplyFilter">
        <option value="">All Status</option>
        <option>Sent</option><option>Scheduled</option><option>Draft</option><option>Paused</option>
    </select>
    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i></button>
    <span class="ms-auto" style="font-size:.75rem;color:var(--um-muted,#64748b)"><strong>@_filtered.Count</strong> blast(s)</span>
</div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

<div class="mkc-grid-card app-datagrid position-relative">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading email blasts…</span></div> }
    <SfGrid CssClass="marketing-grid" TValue="MarketingEmailBlastDto" DataSource="_filtered" AllowPaging="true" AllowSorting="true" AllowTextWrap="true" EnableHover="true" RowHeight="64">
        <GridTextWrapSettings WrapMode="WrapMode.Content" />
        <GridEvents TValue="MarketingEmailBlastDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="20" PageSizes="@(new[] { 10, 20, 50 })" />
        <GridColumns>
            <GridColumn HeaderText="Email Blast" MinWidth="340" Field="@nameof(MarketingEmailBlastDto.Name)">
                <Template>
                    @{ var e = (MarketingEmailBlastDto)context; }
                    <div class="mkc-name-cell"><div class="mkc-type-icon mkc-ti-email"><i class="bi bi-envelope-paper"></i></div><div><div class="mkc-item-name">@e.Name</div><div class="mkc-item-sub">@e.Subject</div></div></div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(MarketingEmailBlastDto.Status)" HeaderText="Status" Width="120"><Template>@{ var e=(MarketingEmailBlastDto)context; }<span class="@StatusBadge(e.Status)">@e.Status</span></Template></GridColumn>
            <GridColumn Field="@nameof(MarketingEmailBlastDto.AudienceSegment)" HeaderText="Audience" Width="190" />
            <GridColumn HeaderText="Recipients" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"><Template>@{ var e=(MarketingEmailBlastDto)context; }<span class="mkc-mono">@e.RecipientCount.ToString("N0")</span></Template></GridColumn>
            <GridColumn HeaderText="Open %" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"><Template>@{ var e=(MarketingEmailBlastDto)context; }<span class="mkc-mono mkc-bold">@Rate(e.OpenCount, e.SentCount).ToString("N1")%</span></Template></GridColumn>
            <GridColumn HeaderText="Click %" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"><Template>@{ var e=(MarketingEmailBlastDto)context; }<span class="mkc-mono">@Rate(e.ClickCount, e.SentCount).ToString("N1")%</span></Template></GridColumn>
            <GridColumn HeaderText="Send Date" Width="150"><Template>@{ var e=(MarketingEmailBlastDto)context; }@(e.SentDateUtc?.ToString("MMM d, yyyy") ?? e.ScheduledDateUtc?.ToString("MMM d, yyyy") ?? "—")</Template></GridColumn>
            <GridColumn HeaderText="Actions" Width="170" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>
                    @{ var e=(MarketingEmailBlastDto)context; }
                    @if (e.Status is "Draft" or "Scheduled" or "Paused")
                    { <button class="um-btn um-btn-primary um-btn-xs" @onclick:stopPropagation="true" @onclick="() => SendAsync(e)"><i class="bi bi-send"></i></button> }
                    @if (e.Status == "Scheduled")
                    { <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => PauseAsync(e)"><i class="bi bi-pause-circle"></i></button> }
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => Preview(e)"><i class="bi bi-eye"></i></button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<style>@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }</style>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;
    private bool _loading;
    private string? _loadError;
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private string? _activeFilter;
    private List<MarketingEmailBlastDto> _items = [];
    private List<MarketingEmailBlastDto> _filtered = [];

    private decimal OpenRate => Rate(_items.Sum(x => x.OpenCount), _items.Sum(x => x.SentCount));

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Marketing", "/marketing/campaigns"), new("Email Blasts", null));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try
        {
            var result = await Api.SearchMarketingEmailBlastsAsync(_tenantId, _search);
            _items = result?.Items.ToList() ?? [];
            ApplyFilter();
        }
        catch (Exception ex) { _loadError = $"Failed to load email blasts: {ex.Message}"; _items = []; _filtered = []; }
        finally { _loading = false; }
    }

    private void SetKpiFilter(string? filter) { _activeFilter = _activeFilter == filter ? null : filter; ApplyFilter(); }
    private void ApplyFilter()
    {
        var q = _items.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_search)) q = q.Where(x => x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Subject.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.AudienceSegment.Contains(_search, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_statusFilter)) q = q.Where(x => x.Status == _statusFilter);
        q = _activeFilter switch { "Engaged" => q.Where(x => Rate(x.OpenCount, x.SentCount) >= 25), null => q, _ => q.Where(x => x.Status == _activeFilter) };
        _filtered = q.ToList();
    }
    private void ResetFilters() { _search = string.Empty; _statusFilter = string.Empty; _activeFilter = null; ApplyFilter(); }
    private void OnRowSelected(RowSelectEventArgs<MarketingEmailBlastDto> args) => Preview(args.Data);
    private async Task SendAsync(MarketingEmailBlastDto e) { await Api.SendMarketingEmailBlastAsync(e.EmailBlastId); await LoadAsync(); if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Sent {e.Name}.", CssClass = "e-toast-success" }); }
    private async Task PauseAsync(MarketingEmailBlastDto e) { await Api.PauseMarketingEmailBlastAsync(e.EmailBlastId); await LoadAsync(); if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Paused {e.Name}.", CssClass = "e-toast-warning" }); }
    private async void Preview(MarketingEmailBlastDto e) { if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Preview: {e.Subject}", CssClass = "e-toast-info" }); }
    private static decimal Rate(int numerator, int denominator) => denominator <= 0 ? 0 : Math.Round(numerator * 100m / denominator, 1);
    private static string StatusBadge(string s) => s switch { "Sent" => "mkc-status mkc-st--completed", "Scheduled" => "mkc-status mkc-st--scheduled", "Paused" => "mkc-status mkc-st--paused", _ => "mkc-status mkc-st--draft" };
    private RenderFragment Kpi(string? filter, string icon, string label, string value, string color) => @<button type="button" class="mkc-kpi-card @(_activeFilter == filter ? "pc-kpi-card--active" : "")" @onclick="() => SetKpiFilter(filter)"><i class="bi @icon mkc-ki @color"></i><div><div class="mkc-kv">@value</div><div class="mkc-kl">@label</div></div></button>;
}
