    private decimal PortfolioOpenRate => Rate(_items.Sum(x => x.OpenCount), _items.Sum(x => x.SentCount));
    private int ComplianceRiskCount => _items.Count(x => x.BounceCount > 25 || x.UnsubscribeCount > 10);

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Marketing", "/marketing/campaigns"), new("Email Blasts", null));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchMarketingEmailBlastsAsync(_tenantId, _search);
            _items = result?.Items.ToList() ?? [];
            ApplyFilters();
            EnsureSelectedStillVisible();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load email blasts: {ex.Message}";
            _items = [];
            _filtered = [];
            _paged = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters(bool resetPage = false)
    {
        var query = _items.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_search))
        {
            query = query.Where(x => x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Subject.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.AudienceSegment.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.SenderName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.SenderEmail.Contains(_search, StringComparison.OrdinalIgnoreCase));
        }
        if (!string.IsNullOrWhiteSpace(_statusFilter)) query = query.Where(x => x.Status == _statusFilter);
        if (!string.IsNullOrWhiteSpace(_audienceFilter)) query = query.Where(x => x.AudienceSegment.Equals(_audienceFilter, StringComparison.OrdinalIgnoreCase));
        query = _engagementFilter switch { "high" => query.Where(x => OpenRate(x) >= 25), "clicks" => query.Where(x => x.ClickCount > 0), "risk" => query.Where(x => x.BounceCount > 25 || x.UnsubscribeCount > 10), _ => query };
        query = _kpiFilter switch { "sent" => query.Where(x => x.Status == "Sent"), "scheduled" => query.Where(x => x.Status == "Scheduled"), "draft" => query.Where(x => x.Status == "Draft"), "engaged" => query.Where(x => OpenRate(x) >= 25), "risk" => query.Where(x => x.BounceCount > 25 || x.UnsubscribeCount > 10), _ => query };
        _filtered = query.OrderByDescending(x => x.SentDateUtc ?? x.ScheduledDateUtc ?? x.CreatedDateUtc).ToList();
        if (resetPage) _page = 1;
        if (_page > TotalPages) _page = TotalPages;
        _paged = _filtered.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    }

    private void SetKpiFilter(string filter)
    {
        _kpiFilter = _kpiFilter == filter ? "all" : filter;
        ApplyFilters(resetPage: true);
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _statusFilter = string.Empty;
        _audienceFilter = string.Empty;
        _engagementFilter = string.Empty;
        _kpiFilter = "all";
        ApplyFilters(resetPage: true);
    }

    private void PreviousPage() { if (_page <= 1) return; _page--; ApplyFilters(); }
    private void NextPage() { if (_page >= TotalPages) return; _page++; ApplyFilters(); }
    private void SelectBlast(MarketingEmailBlastDto item) => _selected = item;
    private void ClearSelection() => _selected = null;
    private bool IsSelected(MarketingEmailBlastDto item) => _selected?.EmailBlastId == item.EmailBlastId;

    private void OpenCreate()
    {
        _editingId = Guid.Empty;
        _saveAttempted = false;
        _form = new EmailBlastForm { Status = "Draft", SenderName = "AgencyBinder Team", SenderEmail = "marketing@agencybinder.local", ScheduledDateUtc = DateTime.UtcNow.Date.AddDays(7), RecipientCount = 100 };
        _showForm = true;
    }

    private void OpenEdit(MarketingEmailBlastDto item)
    {
        _editingId = item.EmailBlastId;
        _saveAttempted = false;
        _form = new()
        {
            Name = item.Name,
            Subject = item.Subject,
            PreviewText = item.PreviewText,
            AudienceSegment = item.AudienceSegment,
            SenderName = item.SenderName,
            SenderEmail = item.SenderEmail,
            Status = string.IsNullOrWhiteSpace(item.Status) ? "Draft" : item.Status,
            ScheduledDateUtc = item.ScheduledDateUtc,
            RecipientCount = item.RecipientCount,
            OpenCount = item.OpenCount,
            ClickCount = item.ClickCount,
            BounceCount = item.BounceCount,
            UnsubscribeCount = item.UnsubscribeCount
        };
        _showForm = true;
    }

    private void CloseForm()
    {
        if (_busy) return;
        _showForm = false;
        _editingId = Guid.Empty;
        _saveAttempted = false;
    }

    private async Task SaveAsync()
    {
        _saveAttempted = true;
        _busy = true;
        try
        {
            var request = ToDto();
            if (_editingId == Guid.Empty)
            {
                await Api.CreateMarketingEmailBlastAsync(request);
                ShowToast("Email blast created.", "success");
            }
            else
            {
                await Api.UpdateMarketingEmailBlastAsync(_editingId, request);
                ShowToast("Email blast saved.", "success");
            }
            _showForm = false;
            _editingId = Guid.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private Task NotifyValidationAsync(EditContext _)
    {
        _saveAttempted = true;
        ShowToast("Please correct the validation errors before saving.", "warning");
        return Task.CompletedTask;
    }

    private MarketingEmailBlastDto ToDto()
    {
        var sentCount = _form.Status == "Sent" ? Math.Max(_form.RecipientCount, 0) : 0;
        return new MarketingEmailBlastDto
        {
            EmailBlastId = _editingId,
            TenantId = _tenantId,
            Name = _form.Name.Trim(),
            Subject = _form.Subject.Trim(),
            PreviewText = _form.PreviewText.Trim(),
            AudienceSegment = _form.AudienceSegment.Trim(),
            SenderName = _form.SenderName.Trim(),
            SenderEmail = _form.SenderEmail.Trim(),
            Status = _form.Status,
            ScheduledDateUtc = _form.Status is "Scheduled" or "Paused" ? _form.ScheduledDateUtc : null,
            SentDateUtc = _form.Status == "Sent" ? DateTime.UtcNow : null,
            RecipientCount = _form.RecipientCount,
            SentCount = sentCount,
            OpenCount = _form.OpenCount,
            ClickCount = _form.ClickCount,
            BounceCount = _form.BounceCount,
            UnsubscribeCount = _form.UnsubscribeCount
        };
    }

    private void ConfirmSend(MarketingEmailBlastDto item) => ShowConfirm(item, ConfirmAction.Send);
    private void ConfirmPause(MarketingEmailBlastDto item) => ShowConfirm(item, ConfirmAction.Pause);
    private void ConfirmArchive(MarketingEmailBlastDto item) => ShowConfirm(item, ConfirmAction.Archive);
    private void ConfigureResume(MarketingEmailBlastDto item) => ShowConfirm(item, ConfirmAction.Resume);
    private void ConfigureDuplicate(MarketingEmailBlastDto item) => ShowConfirm(item, ConfirmAction.Duplicate);
    private void ConfigureSync() => ShowConfirm(null, ConfirmAction.Sync);
    private void ConfigureExport()
    {
        if (!_filtered.Any())
        {
            ShowToast("No email blasts are available to export.", "warning");
            return;
        }

        ShowConfirm(null, ConfirmAction.Export);
    }

    private void ShowConfirm(MarketingEmailBlastDto? item, ConfirmAction action)
    {
        _confirmTarget = item;
        _confirmAction = action;
        _actionConfig = CreateDefaultConfiguration(item, action);
        _showConfirm = true;
    }

    private void CancelConfirm() { if (_busy) return; _showConfirm = false; _confirmTarget = null; }

    private async Task ExecuteConfirmAsync()
    {
        if (_confirmTarget is null && _confirmAction is not (ConfirmAction.Sync or ConfirmAction.Export)) return;
        _busy = true;
        try
        {
            if (_confirmAction == ConfirmAction.Send)
            {
                await Api.SendMarketingEmailBlastAsync(_confirmTarget!.EmailBlastId);
                ShowToast($"Sent {_confirmTarget.Name}.", "success");
            }
            else if (_confirmAction == ConfirmAction.Pause)
            {
                await Api.PauseMarketingEmailBlastAsync(_confirmTarget!.EmailBlastId);
                ShowToast($"Paused {_confirmTarget.Name}.", "success");
            }
            else if (_confirmAction == ConfirmAction.Archive)
            {
                if (_actionConfig.ExportBeforeArchive)
                {
                    await ExportCoreAsync([_confirmTarget!]);
                }
                await Api.ArchiveMarketingEmailBlastAsync(_confirmTarget!.EmailBlastId);
                ShowToast($"Archived {_confirmTarget.Name}.", "success");
            }
            else if (_confirmAction == ConfirmAction.Resume)
            {
                await Api.ResumeMarketingEmailBlastAsync(_confirmTarget!.EmailBlastId);
                ShowToast($"Resumed {_confirmTarget.Name}.", "success");
            }
            else if (_confirmAction == ConfirmAction.Duplicate)
            {
                await Api.DuplicateMarketingEmailBlastAsync(_confirmTarget!.EmailBlastId);
                ShowToast($"Duplicated {_confirmTarget.Name}.", "success");
            }
            else if (_confirmAction == ConfirmAction.Sync)
            {
                await Api.EnsureMarketingEmailBlastSeedAsync(_tenantId);
                ShowToast("Email blast seed data synchronized.", "success");
            }
            else if (_confirmAction == ConfirmAction.Export)
            {
                var exportItems = _actionConfig.ExecutionMode == "All" ? _items : _filtered;
                await ExportCoreAsync(exportItems);
                ShowToast($"Exported {exportItems.Count:N0} email blasts.", "success");
            }
            _showConfirm = false;
            _confirmTarget = null;
            if (_confirmAction != ConfirmAction.Export && _actionConfig.RefreshAfterAction)
            {
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Action failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportCoreAsync(IReadOnlyCollection<MarketingEmailBlastDto> items)
    {
        if (!items.Any()) return;

        var csv = new StringBuilder();
        csv.AppendLine(_actionConfig.IncludeMetrics ? "Name,Subject,Audience,SenderName,SenderEmail,Status,Recipients,Sent,Opens,Clicks,Bounces,Unsubscribes,ScheduledDate,SentDate" : "Name,Subject,Audience,SenderName,SenderEmail,Status,Recipients,ScheduledDate,SentDate");
        foreach (var item in items)
        {
            if (_actionConfig.IncludeMetrics)
            {
                csv.AppendLine(string.Join(',', Csv(item.Name), Csv(item.Subject), Csv(item.AudienceSegment), Csv(item.SenderName), Csv(item.SenderEmail), Csv(item.Status), item.RecipientCount, item.SentCount, item.OpenCount, item.ClickCount, item.BounceCount, item.UnsubscribeCount, Csv(item.ScheduledDateUtc?.ToString("yyyy-MM-dd") ?? string.Empty), Csv(item.SentDateUtc?.ToString("yyyy-MM-dd") ?? string.Empty)));
            }
            else
            {
                csv.AppendLine(string.Join(',', Csv(item.Name), Csv(item.Subject), Csv(item.AudienceSegment), Csv(item.SenderName), Csv(item.SenderEmail), Csv(item.Status), item.RecipientCount, Csv(item.ScheduledDateUtc?.ToString("yyyy-MM-dd") ?? string.Empty), Csv(item.SentDateUtc?.ToString("yyyy-MM-dd") ?? string.Empty)));
            }
        }
        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        await Js.InvokeVoidAsync("amsShell.downloadBase64", $"marketing-email-blasts-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
    }

    private static ActionConfiguration CreateDefaultConfiguration(MarketingEmailBlastDto? item, ConfirmAction action) => action switch
    {
        ConfirmAction.Send => new() { ExecutionMode = item?.ScheduledDateUtc is null ? "Immediate" : "Scheduled", SuppressUnsubscribed = true, RequireComplianceCheck = true, RefreshAfterAction = true, Note = "Approved for marketing send" },
        ConfirmAction.Pause => new() { NotifyStakeholders = true, RefreshAfterAction = true, Reason = "Schedule adjustment" },
        ConfirmAction.Archive => new() { NotifyStakeholders = true, ExportBeforeArchive = false, RefreshAfterAction = true, Reason = "Campaign lifecycle complete" },
        ConfirmAction.Resume => new() { ExecutionMode = item?.ScheduledDateUtc is null ? "Draft" : "Scheduled", RefreshAfterAction = true, Note = "Resume approved" },
        ConfirmAction.Duplicate => new() { ExecutionMode = "Draft", NewName = item is null ? string.Empty : $"{item.Name} Copy", CopyMetrics = false, RefreshAfterAction = true },
        ConfirmAction.Sync => new() { ExecutionMode = "MissingOnly", RefreshAfterAction = true },
        ConfirmAction.Export => new() { ExecutionMode = "Filtered", IncludeMetrics = true, RefreshAfterAction = false },
        _ => new()
    };

    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind) { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void EnsureSelectedStillVisible() { if (_selected is null) return; _selected = _items.FirstOrDefault(x => x.EmailBlastId == _selected.EmailBlastId); }
    private int CountStatus(string status) => _items.Count(x => x.Status == status);
    private static decimal OpenRate(MarketingEmailBlastDto item) => Rate(item.OpenCount, item.SentCount);
    private static decimal ClickRate(MarketingEmailBlastDto item) => Rate(item.ClickCount, item.SentCount);
    private static decimal Rate(int numerator, int denominator) => denominator <= 0 ? 0 : Math.Round(numerator * 100m / denominator, 1);
    private static string DisplaySendDate(MarketingEmailBlastDto item) => item.SentDateUtc?.ToString("MMM d, yyyy") ?? item.ScheduledDateUtc?.ToString("MMM d, yyyy") ?? "Not scheduled";
    private static string StatusCss(string status) => $"meb-st-{status.ToLowerInvariant()}";
    private static string StatusIconClass(string status) => status switch { "Sent" => "meb-di-green", "Scheduled" => "meb-di-amber", "Paused" => "meb-di-red", _ => "meb-di-blue" };
    private static string Csv(string value) { var quote = Convert.ToChar(34).ToString(); return string.Concat(quote, value.Replace(quote, quote + quote), quote); }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }

    private sealed record KpiModel(string Filter, string Label, string Value, string Caption, string Icon, string Tone)
    {
        public string Title => $"Filter by {Label}";
    }

    private enum ConfirmAction { Send, Pause, Archive, Resume, Duplicate, Sync, Export }

    private sealed class ActionConfiguration
    {
        public string ExecutionMode { get; set; } = string.Empty;
        public string Note { get; set; } = string.Empty;
        public string Reason { get; set; } = string.Empty;
        public string NewName { get; set; } = string.Empty;
        public bool SuppressUnsubscribed { get; set; }
        public bool RequireComplianceCheck { get; set; }
        public bool NotifyStakeholders { get; set; }
        public bool ExportBeforeArchive { get; set; }
        public bool CopyMetrics { get; set; }
        public bool IncludeMetrics { get; set; } = true;
        public bool RefreshAfterAction { get; set; } = true;
    }

    private sealed class EmailBlastForm
    {
        [Required, StringLength(200)]
