@page "/commissions/forecast2"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Commissions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject IJSRuntime Js

<PageTitle>Commission Forecast - AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="cf-toast cf-toast-@_toastKind" role="status" aria-live="polite"><i class="bi @ToastIconClass" aria-hidden="true"></i><span>@_toastMessage</span><button type="button" class="cf-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
}

@if (_showStatusConfirm && _statusTarget is not null && !string.IsNullOrWhiteSpace(_pendingStatus))
{
    <div class="cf-modal-backdrop" role="presentation" @onclick="CancelStatusUpdate"><div class="cf-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="cf-status-title" @onclick:stopPropagation="true"><div class="um-confirm-dialog"><div class="um-confirm-icon @(_pendingStatus == "Closed" ? "um-confirm-icon--danger" : null)"><i class="bi @PendingStatusIcon" aria-hidden="true"></i></div><div class="um-confirm-title" id="cf-status-title">@PendingStatusTitle</div><div class="um-confirm-body">Mark forecast <strong>@_statusTarget.ForecastNumber</strong> as <strong>@_pendingStatus</strong>?</div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CancelStatusUpdate" disabled="@_busy">Cancel</button><button type="button" class="um-btn @(_pendingStatus == "Closed" ? "um-btn-danger" : "um-btn-primary")" @onclick="ExecuteStatusUpdateAsync" disabled="@_busy">@PendingStatusAction</button></div></div></div></div>
}

@if (_showForm)
{
    <div class="cf-modal-backdrop" role="presentation" @onclick="CloseForm"><div class="cf-modal cf-action-modal" role="dialog" aria-modal="true" aria-labelledby="cf-form-title" @onclick:stopPropagation="true"><div class="um-modal-header"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span id="cf-form-title">@(_editingId == Guid.Empty ? "New Commission Forecast" : "Edit Commission Forecast")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="NotifyValidationAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="cf-modal-intro"><span><i class="bi bi-shield-check" aria-hidden="true"></i> Forecast workflow</span><p>Model upcoming commission exposure by scenario, plan, payee, period, expected revenue, and confidence.</p></div><div class="um-form-grid">
        <div class="um-field"><label>Forecast Number <span class="text-danger">*</span></label><InputText class="form-control" @bind-Value="_form.ForecastNumber" /></div>
        <div class="um-field"><label>Scenario <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="_form.ScenarioCode">@foreach (var scenario in _scenarios) { <option value="@scenario">@scenario</option> }</InputSelect></div>
        <div class="um-field um-field--full"><label>Forecast Name <span class="text-danger">*</span></label><InputText class="form-control" @bind-Value="_form.ForecastName" /></div>
        <div class="um-field"><label>Period Start <span class="text-danger">*</span></label><InputDate class="form-control" @bind-Value="_form.PeriodStart" /></div>
        <div class="um-field"><label>Period End <span class="text-danger">*</span></label><InputDate class="form-control" @bind-Value="_form.PeriodEnd" /></div>
        <div class="um-field"><label>Plan</label><InputSelect class="form-select" @bind-Value="_form.CommissionPlanId"><option value="">All plans</option>@foreach (var plan in _plans) { <option value="@plan.CommissionPlanId">@plan.PlanName</option> }</InputSelect></div>
        <div class="um-field"><label>Payee</label><InputSelect class="form-select" @bind-Value="_form.PayeeId"><option value="">All payees</option>@foreach (var payee in _payees) { <option value="@payee.PayeeId">@PayeeLabel(payee)</option> }</InputSelect></div>
        <div class="um-field"><label>Pipeline Premium <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.PipelinePremium" /></div>
        <div class="um-field"><label>Weighted Premium <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.WeightedPremium" /></div>
        <div class="um-field"><label>Expected Revenue <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.ExpectedRevenue" /></div>
        <div class="um-field"><label>Forecast Commission <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.ForecastCommission" /></div>
        <div class="um-field"><label>Confidence % <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.ConfidencePct" /></div>
        <div class="um-field"><label>Actual Commission</label><InputNumber class="form-control" @bind-Value="_form.ActualCommission" /></div>
        <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="_form.StatusCode">@foreach (var status in _statuses) { <option value="@status">@status</option> }</InputSelect></div>
        <div class="um-field um-field--full"><label>Notes</label><InputTextArea class="form-control" rows="3" @bind-Value="_form.Notes" /></div>
        <div class="um-field um-field--full cf-forecast-preview"><span>Model preview</span><strong>@_form.ForecastCommission.ToString("C2")</strong><small>@_form.ConfidencePct.ToString("N0")% confidence - @VariancePreview.ToString("C2") variance</small><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CalculateFormForecast">Calculate</button></div>
        @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
    </div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_busy">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_busy">@if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } @(_editingId == Guid.Empty ? "Create Forecast" : "Save Changes")</button></div></EditForm></div></div>
}

<div class="cf-enterprise-page">
    <section class="cf-header"><div class="cf-header-left"><div class="cf-lob-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></div><div class="cf-header-info"><div class="cf-title-row"><h1 class="cf-page-title">Commission Forecast</h1><span class="cf-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live forecast data</span><span class="cf-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span></div><div class="cf-sub-row"><span>Project commissions by plan, payee, scenario, confidence, and payout period.</span><span class="cf-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Seed sync enabled</span><span class="cf-sub-chip"><i class="bi bi-check2-circle" aria-hidden="true"></i> @_filtered.Count active matches</span></div></div></div><div class="cf-header-actions"><button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions2")'><i class="bi bi-cash-coin" aria-hidden="true"></i> Commissions</button><button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="@RefreshIconClass" aria-hidden="true"></i> Refresh</button><button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync" disabled="@(!_filtered.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Forecast</button></div></section>

    <section class="cf-kpi-strip" aria-label="Commission forecast metrics">@foreach (var kpi in Kpis) { <button type="button" class="@KpiClass(kpi)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)"><span class="cf-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span><span class="cf-kpi-copy"><span class="cf-kpi-label">@kpi.Label</span><span class="cf-kpi-value">@kpi.Value</span><span class="cf-kpi-caption">@kpi.Caption</span></span></button> }</section>

    <section class="cf-workflow-strip" aria-label="Commission forecast workflow shortcuts"><button type="button" class="cf-workflow-card cf-wf-create" @onclick="OpenCreate"><span class="cf-workflow-icon"><i class="bi bi-plus-circle" aria-hidden="true"></i></span><span class="cf-workflow-content"><strong>1</strong><span>Model</span><small>Create forecast.</small></span></button><button type="button" class="cf-workflow-card cf-wf-plans" @onclick='() => Nav.NavigateTo("/commissions/plans")'><span class="cf-workflow-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span><span class="cf-workflow-content"><strong>2</strong><span>Plans</span><small>Review rates.</small></span></button><button type="button" class="cf-workflow-card cf-wf-ledger" @onclick='() => Nav.NavigateTo("/commissions/producer-ledger")'><span class="cf-workflow-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span><span class="cf-workflow-content"><strong>3</strong><span>Ledger</span><small>Compare actuals.</small></span></button><button type="button" class="cf-workflow-card cf-wf-statements" @onclick='() => Nav.NavigateTo("/commissions/statements")'><span class="cf-workflow-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span><span class="cf-workflow-content"><strong>4</strong><span>Statements</span><small>Reconcile payout.</small></span></button><button type="button" class="cf-workflow-card cf-wf-exceptions" @onclick='() => Nav.NavigateTo("/commissions/exceptions2")'><span class="cf-workflow-icon"><i class="bi bi-exclamation-circle" aria-hidden="true"></i></span><span class="cf-workflow-content"><strong>5</strong><span>Exceptions</span><small>Resolve blockers.</small></span></button><button type="button" class="cf-workflow-card cf-wf-calc" @onclick="RecalculateSelected" disabled="@(_selected is null)"><span class="cf-workflow-icon"><i class="bi bi-calculator" aria-hidden="true"></i></span><span class="cf-workflow-content"><strong>6</strong><span>Recalc</span><small>Update selected.</small></span></button></section>

    <section class="cf-enterprise-search" aria-label="Commission forecast filters"><div class="cf-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div><div class="cf-search-body"><label for="cf-search">Search forecasts</label><input id="cf-search" class="cf-search-input" type="search" placeholder="Search forecast, scenario, status, payee, plan, notes..." @bind="SearchFilter" @bind:event="oninput" /><span class="cf-search-hint">Filters apply instantly across synchronized commission forecasts.</span></div><select class="cf-filter-select" @bind="ScenarioFilter" aria-label="Scenario filter"><option value="">All scenarios</option>@foreach (var scenario in _scenarios) { <option value="@scenario">@scenario</option> }</select><select class="cf-filter-select" @bind="StatusFilter" aria-label="Status filter"><option value="">All statuses</option>@foreach (var status in _statuses) { <option value="@status">@status</option> }</select><div class="cf-search-result"><strong>@_filtered.Count</strong><span>matches</span></div></section>

    @if (!string.IsNullOrWhiteSpace(_loadError)) { <div class="alert alert-danger cf-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div> }

    <section class="cf-content-layout"><div class="cf-grid-wrap"><div class="cf-grid-toolbar"><div><strong>Forecast register</strong><span>@ActiveFilterText</span></div><div class="cf-toolbar-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-eraser" aria-hidden="true"></i> Reset</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ActivateSelected" disabled="@(!CanActivateSelected)"><i class="bi bi-play-circle" aria-hidden="true"></i> Activate</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseSelected" disabled="@(!CanCloseSelected)"><i class="bi bi-lock" aria-hidden="true"></i> Close</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add</button></div></div>
        @if (_loading) { <div class="cf-loading"><i class="bi bi-arrow-repeat cf-spin" aria-hidden="true"></i><strong>Loading commission forecasts...</strong><span>Syncing schema, seed data, payees, plans, and forecast records.</span></div> }
        else if (!_filtered.Any()) { <div class="cf-empty-state"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><strong>No forecasts found</strong><span>Adjust filters or create a commission forecast model.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">New Forecast</button></div> }
        else { <div class="cf-table-scroll"><table class="cf-table"><thead><tr><th>Forecast</th><th>Scenario</th><th>Period</th><th>Plan</th><th class="cf-number">Forecast</th><th class="cf-number">Actual</th><th class="cf-number">Variance</th><th>Confidence</th><th>Status</th><th class="cf-actions-col">Actions</th></tr></thead><tbody>@foreach (var item in PagedItems) { <tr class="@RowClass(item)" @onclick="() => SelectForecast(item)"><td><div class="cf-entry-cell"><span class="cf-entry-icon @ScenarioIconTone(item.ScenarioCode)"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span><span><strong>@item.ForecastName</strong><span>@item.ForecastNumber - @item.PayeeName</span></span></div></td><td><span class="cf-scenario-chip @ScenarioCss(item.ScenarioCode)">@item.ScenarioCode</span></td><td>@PeriodLabel(item)</td><td>@item.PlanName</td><td class="cf-number cf-net">@item.ForecastCommission.ToString("C0")</td><td class="cf-number">@item.ActualCommission.ToString("C0")</td><td class="cf-number @VarianceCss(item)">@item.VarianceAmount.ToString("C0")</td><td>@item.ConfidencePct.ToString("N0")%</td><td><span class="cf-status-chip @StatusCss(item.StatusCode)">@item.StatusCode</span></td><td><div class="cf-row-acts"><button type="button" class="um-btn um-btn-primary um-btn-xs" title="Inspect" @onclick:stopPropagation="true" @onclick="() => SelectForecast(item)"><i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Edit" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Activate" @onclick:stopPropagation="true" @onclick='() => ConfirmStatusUpdate(item, "Active")' disabled="@(item.StatusCode == "Active")"><i class="bi bi-play-circle" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Statements" @onclick:stopPropagation="true" @onclick='() => Nav.NavigateTo("/commissions/statements")'><i class="bi bi-file-earmark-text" aria-hidden="true"></i></button></div></td></tr> }</tbody></table></div><div class="cf-pager"><span>Showing @PageStart-@PageEnd of @_filtered.Count</span><div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PrevPage" disabled="@(_page == 1)">Previous</button><span>Page @_page of @TotalPages</span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button></div></div> }
    </div><aside class="cf-detail-panel" aria-label="Selected forecast detail">@if (_selected is null) { <div class="cf-detail-empty"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a forecast</strong><span>Choose a row to inspect revenue assumptions, confidence, variance, plan, payee, and workflow actions.</span></div> } else { <div class="cf-detail-head"><div><span class="cf-detail-eyebrow"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Forecast detail</span><h2>@_selected.ForecastName</h2><div class="cf-detail-meta"><span>@_selected.ForecastNumber</span><span class="cf-scenario-chip @ScenarioCss(_selected.ScenarioCode)">@_selected.ScenarioCode</span><span class="cf-status-chip @StatusCss(_selected.StatusCode)">@_selected.StatusCode</span></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></div><div class="cf-detail-body"><div class="cf-progress-card"><div><span>Confidence</span><strong>@_selected.ConfidencePct.ToString("N0")%</strong></div><div class="cf-progress-track"><span style="width:@ConfidencePercent(_selected)%"></span></div></div><div class="cf-detail-summary"><div class="cf-meta-row"><span class="cf-meta-lbl">Forecast</span><span class="cf-meta-val">@_selected.ForecastCommission.ToString("C2")</span></div><div class="cf-meta-row"><span class="cf-meta-lbl">Actual</span><span class="cf-meta-val">@_selected.ActualCommission.ToString("C2")</span></div><div class="cf-meta-row"><span class="cf-meta-lbl">Variance</span><span class="cf-meta-val @VarianceCss(_selected)">@_selected.VarianceAmount.ToString("C2")</span></div><div class="cf-meta-row"><span class="cf-meta-lbl">Expected Revenue</span><span class="cf-meta-val">@_selected.ExpectedRevenue.ToString("C2")</span></div><div class="cf-meta-row"><span class="cf-meta-lbl">Weighted Premium</span><span class="cf-meta-val">@_selected.WeightedPremium.ToString("C2")</span></div><div class="cf-meta-row"><span class="cf-meta-lbl">Period</span><span class="cf-meta-val">@PeriodLabel(_selected)</span></div></div><div class="cf-note-card"><span><i class="bi bi-card-text" aria-hidden="true"></i> Workflow context</span><p>@(string.IsNullOrWhiteSpace(_selected.Notes) ? "No forecast notes have been captured." : _selected.Notes)</p></div><div class="cf-detail-actions"><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="RecalculateSelected"><i class="bi bi-calculator" aria-hidden="true"></i> Recalc</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, "Active")' disabled="@(_selected.StatusCode == "Active")"><i class="bi bi-play-circle" aria-hidden="true"></i> Activate</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, "Closed")' disabled="@(_selected.StatusCode == "Closed")"><i class="bi bi-lock" aria-hidden="true"></i> Close</button></div></div> }</aside></section>
</div>

@code {
    private const int PageSize = 12;
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<CommissionForecastDto> _items = [];
    private List<CommissionForecastDto> _filtered = [];
    private List<CommissionPlanDto> _plans = [];
    private List<CommissionPayeeDto> _payees = [];
    private CommissionForecastDto? _selected;
    private CommissionForecastDto? _statusTarget;
    private ForecastForm _form = new();
    private Guid _editingId = Guid.Empty;
    private string _searchTerm = string.Empty;
    private string _scenarioFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private string _kpiFilter = "all";
    private string? _pendingStatus;
    private int _page = 1;
    private bool _loading, _busy, _showForm, _showStatusConfirm, _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError, _formError;
    private readonly List<string> _scenarios = ["Base", "Upside", "Downside", "Stretch", "Conservative"];
    private readonly List<string> _statuses = ["Draft", "Active", "Approved", "Closed", "Archived"];

    private IEnumerable<CommissionForecastDto> PagedItems => _filtered.Skip((_page - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
    private int PageStart => _filtered.Count == 0 ? 0 : ((_page - 1) * PageSize) + 1;
    private int PageEnd => Math.Min(_filtered.Count, _page * PageSize);
    private bool CanActivateSelected => _selected is not null && _selected.StatusCode != "Active";
    private bool CanCloseSelected => _selected is not null && _selected.StatusCode != "Closed";
    private decimal VariancePreview => _form.ForecastCommission - _form.ActualCommission;
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", "info" => "bi-info-circle-fill", _ => "bi-check-circle-fill" };
    private string ActiveFilterText => _kpiFilter == "all" ? "All commission forecasts" : $"Filtered by {_kpiFilter}";
    private string PendingStatusIcon => _pendingStatus switch { "Active" => "bi-play-circle", "Approved" => "bi-check2-circle", "Closed" => "bi-lock-fill", _ => "bi-arrow-repeat" };
    private string PendingStatusTitle => _pendingStatus switch { "Active" => "Activate Forecast", "Approved" => "Approve Forecast", "Closed" => "Close Forecast", _ => "Update Forecast" };
    private string PendingStatusAction => _pendingStatus switch { "Active" => "Activate", "Approved" => "Approve", "Closed" => "Close", _ => "Update" };
    private string RefreshIconClass => _loading ? "bi bi-arrow-repeat cf-spin" : "bi bi-arrow-clockwise";
    private IReadOnlyList<KpiModel> Kpis => [new("all", "Forecasts", _items.Count.ToString("N0"), "All records", "bi-graph-up-arrow", "cf-ki-blue"), new("active", "Active", _items.Count(x => x.StatusCode == "Active").ToString("N0"), "In flight", "bi-play-circle", "cf-ki-green"), new("upside", "Upside", _items.Count(x => x.ScenarioCode == "Upside").ToString("N0"), "Growth case", "bi-arrow-up-right", "cf-ki-purple"), new("risk", "Risk", _items.Count(x => x.ScenarioCode == "Downside" || x.ConfidencePct < 60).ToString("N0"), "Low confidence", "bi-exclamation-triangle", "cf-ki-amber"), new("closed", "Closed", _items.Count(x => x.StatusCode == "Closed").ToString("N0"), "Actualized", "bi-lock", "cf-ki-cyan"), new("amount", "Forecast", _items.Sum(x => x.ForecastCommission).ToString("C0"), "Total commission", "bi-currency-dollar", "cf-ki-blue")];
    private string SearchFilter { get => _searchTerm; set { _searchTerm = value; ApplyFilters(resetPage: true); } }
    private string ScenarioFilter { get => _scenarioFilter; set { _scenarioFilter = value; ApplyFilters(resetPage: true); } }
    private string StatusFilter { get => _statusFilter; set { _statusFilter = value; ApplyFilters(resetPage: true); } }

    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Commissions", "/commissions2"), new("Forecast", "/commissions/forecast")); await LoadAsync(); }
    private async Task LoadAsync() { _loading = true; _loadError = null; try { await Api.EnsureCommissionSeedAsync(_tenantId, _tenantAdminUserId); await Api.EnsureCommissionForecastsSeedAsync(_tenantId); var forecasts = await Api.SearchCommissionForecastsAsync(_tenantId, string.Empty); var plans = await Api.SearchCommissionPlansAsync(_tenantId, string.Empty); var payees = await Api.SearchCommissionPayeesAsync(_tenantId, string.Empty); _items = forecasts?.Items.OrderBy(x => StatusSort(x.StatusCode)).ThenByDescending(x => x.PeriodStart).ToList() ?? []; _plans = plans?.Items.OrderBy(x => x.PlanName).ToList() ?? []; _payees = payees?.Items.OrderBy(x => x.PayeeTypeCode).ToList() ?? []; ApplyFilters(resetPage: true); EnsureSelectedStillVisible(); } catch (Exception ex) { _loadError = $"Commission forecasts failed to load: {ex.Message}"; ShowToast(_loadError, "danger"); _items = []; _filtered = []; } finally { _loading = false; } }
    private void ApplyFilters(bool resetPage) { IEnumerable<CommissionForecastDto> query = _items; if (!string.IsNullOrWhiteSpace(_searchTerm)) { var term = _searchTerm.Trim(); query = query.Where(x => Contains(x.ForecastNumber, term) || Contains(x.ForecastName, term) || Contains(x.ScenarioCode, term) || Contains(x.StatusCode, term) || Contains(x.Notes, term) || Contains(x.PayeeName, term) || Contains(x.PlanName, term)); } if (!string.IsNullOrWhiteSpace(_scenarioFilter)) query = query.Where(x => x.ScenarioCode == _scenarioFilter); if (!string.IsNullOrWhiteSpace(_statusFilter)) query = query.Where(x => x.StatusCode == _statusFilter); query = _kpiFilter switch { "active" => query.Where(x => x.StatusCode == "Active"), "upside" => query.Where(x => x.ScenarioCode == "Upside"), "risk" => query.Where(x => x.ScenarioCode == "Downside" || x.ConfidencePct < 60), "closed" => query.Where(x => x.StatusCode == "Closed"), "amount" => query.Where(x => x.ForecastCommission > 0), _ => query }; _filtered = query.OrderBy(x => StatusSort(x.StatusCode)).ThenByDescending(x => x.PeriodStart).ToList(); if (resetPage) _page = 1; if (_page > TotalPages) _page = TotalPages; }
    private void SetKpiFilter(string filter) { _kpiFilter = _kpiFilter == filter && filter != "all" ? "all" : filter; ApplyFilters(resetPage: true); }
    private void ResetFilters() { _searchTerm = string.Empty; _scenarioFilter = string.Empty; _statusFilter = string.Empty; _kpiFilter = "all"; ApplyFilters(resetPage: true); ShowToast("Forecast filters reset.", "info"); }
    private void SelectForecast(CommissionForecastDto item) => _selected = item;
    private void OpenCreate() { _editingId = Guid.Empty; _formError = null; var start = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1); _form = new ForecastForm { ForecastNumber = $"FC-{DateTime.UtcNow:yyyyMM}-{(_items.Count + 1):000}", ForecastName = "New Commission Forecast", PeriodStart = start, PeriodEnd = start.AddMonths(1).AddDays(-1), CommissionPlanId = _plans.FirstOrDefault()?.CommissionPlanId, PayeeId = _payees.FirstOrDefault()?.PayeeId, PipelinePremium = 250000, WeightedPremium = 175000, ExpectedRevenue = 26250, ForecastCommission = 7875, ConfidencePct = 75, ScenarioCode = "Base", StatusCode = "Draft" }; _showForm = true; }
    private void OpenEdit(CommissionForecastDto item) { _editingId = item.ForecastId; _formError = null; _form = new ForecastForm { CommissionPlanId = item.CommissionPlanId, PayeeId = item.PayeeId, ForecastNumber = item.ForecastNumber, ForecastName = item.ForecastName, PeriodStart = item.PeriodStart.ToDateTime(TimeOnly.MinValue), PeriodEnd = item.PeriodEnd.ToDateTime(TimeOnly.MinValue), PipelinePremium = item.PipelinePremium, WeightedPremium = item.WeightedPremium, ExpectedRevenue = item.ExpectedRevenue, ForecastCommission = item.ForecastCommission, ConfidencePct = item.ConfidencePct, ActualCommission = item.ActualCommission, ScenarioCode = item.ScenarioCode, StatusCode = item.StatusCode, Notes = item.Notes }; _showForm = true; }
    private void CloseForm() { if (_busy) return; _showForm = false; }
    private void CalculateFormForecast() { _form.WeightedPremium = Math.Round(_form.PipelinePremium * (_form.ConfidencePct / 100m), 2); _form.ExpectedRevenue = Math.Round(_form.WeightedPremium * 0.15m, 2); _form.ForecastCommission = Math.Round(_form.ExpectedRevenue * 0.30m, 2); ShowToast("Forecast model recalculated.", "info"); }
    private async Task SaveAsync() { if (!ValidateForm()) return; _busy = true; _formError = null; var savedId = _editingId; try { if (_editingId == Guid.Empty) { savedId = await Api.CreateCommissionForecastAsync(ToCreateRequest()); ShowToast("Commission forecast created.", "success"); } else { await Api.UpdateCommissionForecastAsync(_editingId, ToUpdateRequest()); ShowToast("Commission forecast updated.", "success"); } _showForm = false; await LoadAsync(); _selected = _items.FirstOrDefault(x => x.ForecastId == savedId) ?? _selected; } catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; ShowToast(_formError, "danger"); } finally { _busy = false; } }
    private CreateCommissionForecastRequest ToCreateRequest() => new() { TenantId = _tenantId, CommissionPlanId = _form.CommissionPlanId, PayeeId = _form.PayeeId, ForecastNumber = _form.ForecastNumber.Trim(), ForecastName = _form.ForecastName.Trim(), PeriodStart = DateOnly.FromDateTime(_form.PeriodStart), PeriodEnd = DateOnly.FromDateTime(_form.PeriodEnd), PipelinePremium = _form.PipelinePremium, WeightedPremium = _form.WeightedPremium, ExpectedRevenue = _form.ExpectedRevenue, ForecastCommission = _form.ForecastCommission, ConfidencePct = _form.ConfidencePct, ActualCommission = _form.ActualCommission, ScenarioCode = _form.ScenarioCode, StatusCode = _form.StatusCode, Notes = _form.Notes, CreatedByUserId = _tenantAdminUserId };
    private UpdateCommissionForecastRequest ToUpdateRequest() => new() { TenantId = _tenantId, ForecastId = _editingId, CommissionPlanId = _form.CommissionPlanId, PayeeId = _form.PayeeId, ForecastNumber = _form.ForecastNumber.Trim(), ForecastName = _form.ForecastName.Trim(), PeriodStart = DateOnly.FromDateTime(_form.PeriodStart), PeriodEnd = DateOnly.FromDateTime(_form.PeriodEnd), PipelinePremium = _form.PipelinePremium, WeightedPremium = _form.WeightedPremium, ExpectedRevenue = _form.ExpectedRevenue, ForecastCommission = _form.ForecastCommission, ConfidencePct = _form.ConfidencePct, ActualCommission = _form.ActualCommission, ScenarioCode = _form.ScenarioCode, StatusCode = _form.StatusCode, Notes = _form.Notes, ModifiedByUserId = _tenantAdminUserId };
    private void ActivateSelected() { if (_selected is not null) ConfirmStatusUpdate(_selected, "Active"); }
    private void CloseSelected() { if (_selected is not null) ConfirmStatusUpdate(_selected, "Closed"); }
    private void ConfirmStatusUpdate(CommissionForecastDto item, string status) { _statusTarget = item; _pendingStatus = status; _showStatusConfirm = true; }
    private void CancelStatusUpdate() { if (_busy) return; _showStatusConfirm = false; _statusTarget = null; _pendingStatus = null; }
    private async Task ExecuteStatusUpdateAsync() { if (_statusTarget is null || string.IsNullOrWhiteSpace(_pendingStatus)) return; _busy = true; var selectedId = _statusTarget.ForecastId; try { await Api.UpdateCommissionForecastAsync(_statusTarget.ForecastId, new UpdateCommissionForecastRequest { TenantId = _tenantId, ForecastId = _statusTarget.ForecastId, CommissionPlanId = _statusTarget.CommissionPlanId, PayeeId = _statusTarget.PayeeId, ForecastNumber = _statusTarget.ForecastNumber, ForecastName = _statusTarget.ForecastName, PeriodStart = _statusTarget.PeriodStart, PeriodEnd = _statusTarget.PeriodEnd, PipelinePremium = _statusTarget.PipelinePremium, WeightedPremium = _statusTarget.WeightedPremium, ExpectedRevenue = _statusTarget.ExpectedRevenue, ForecastCommission = _statusTarget.ForecastCommission, ConfidencePct = _statusTarget.ConfidencePct, ActualCommission = _statusTarget.ActualCommission, ScenarioCode = _statusTarget.ScenarioCode, StatusCode = _pendingStatus, Notes = _statusTarget.Notes, ModifiedByUserId = _tenantAdminUserId }); ShowToast($"Forecast marked {_pendingStatus.ToLowerInvariant()}.", "success"); _showStatusConfirm = false; _statusTarget = null; _pendingStatus = null; await LoadAsync(); _selected = _items.FirstOrDefault(x => x.ForecastId == selectedId) ?? _selected; } catch (Exception ex) { ShowToast($"Update failed: {ex.Message}", "danger"); } finally { _busy = false; } }
    private async Task RecalculateSelected() { if (_selected is null) return; _busy = true; try { var weighted = Math.Round(_selected.PipelinePremium * (_selected.ConfidencePct / 100m), 2); var expected = Math.Round(weighted * 0.15m, 2); var forecast = Math.Round(expected * 0.30m, 2); await Api.UpdateCommissionForecastAsync(_selected.ForecastId, new UpdateCommissionForecastRequest { TenantId = _tenantId, ForecastId = _selected.ForecastId, CommissionPlanId = _selected.CommissionPlanId, PayeeId = _selected.PayeeId, ForecastNumber = _selected.ForecastNumber, ForecastName = _selected.ForecastName, PeriodStart = _selected.PeriodStart, PeriodEnd = _selected.PeriodEnd, PipelinePremium = _selected.PipelinePremium, WeightedPremium = weighted, ExpectedRevenue = expected, ForecastCommission = forecast, ConfidencePct = _selected.ConfidencePct, ActualCommission = _selected.ActualCommission, ScenarioCode = _selected.ScenarioCode, StatusCode = _selected.StatusCode, Notes = _selected.Notes, ModifiedByUserId = _tenantAdminUserId }); ShowToast("Selected forecast recalculated.", "success"); await LoadAsync(); _selected = _items.FirstOrDefault(x => x.ForecastId == _selected.ForecastId); } catch (Exception ex) { ShowToast($"Recalculate failed: {ex.Message}", "danger"); } finally { _busy = false; } }
    private Task NotifyValidationAsync(EditContext _) { ShowToast("Please correct validation errors before saving.", "warning"); return Task.CompletedTask; }
    private async Task ExportAsync() { if (!_filtered.Any()) { ShowToast("No forecasts are available to export.", "warning"); return; } var csv = new StringBuilder(); csv.AppendLine("ForecastId,ForecastNumber,ForecastName,Scenario,Status,PeriodStart,PeriodEnd,Payee,Plan,PipelinePremium,WeightedPremium,ExpectedRevenue,ForecastCommission,ActualCommission,Variance,Confidence,Notes"); foreach (var item in _filtered) csv.AppendLine(string.Join(',', Csv(item.ForecastId.ToString()), Csv(item.ForecastNumber), Csv(item.ForecastName), Csv(item.ScenarioCode), Csv(item.StatusCode), Csv(item.PeriodStart.ToString("yyyy-MM-dd")), Csv(item.PeriodEnd.ToString("yyyy-MM-dd")), Csv(item.PayeeName), Csv(item.PlanName), item.PipelinePremium, item.WeightedPremium, item.ExpectedRevenue, item.ForecastCommission, item.ActualCommission, item.VarianceAmount, item.ConfidencePct, Csv(item.Notes))); var bytes = Encoding.UTF8.GetBytes(csv.ToString()); await Js.InvokeVoidAsync("amsShell.downloadBase64", $"commission-forecasts-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes)); ShowToast($"Exported {_filtered.Count:N0} forecasts.", "success"); }
    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind) { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void EnsureSelectedStillVisible() => _selected = _selected is null ? _filtered.FirstOrDefault() : _items.FirstOrDefault(x => x.ForecastId == _selected.ForecastId) ?? _filtered.FirstOrDefault();
    private string PayeeLabel(CommissionPayeeDto payee) => $"{payee.PayeeTypeCode} - {payee.SplitPercentage:N2}%";
    private bool ValidateForm() { if (string.IsNullOrWhiteSpace(_form.ForecastNumber)) { _formError = "Forecast Number is required."; ShowToast(_formError, "warning"); return false; } if (string.IsNullOrWhiteSpace(_form.ForecastName)) { _formError = "Forecast Name is required."; ShowToast(_formError, "warning"); return false; } if (_form.PeriodEnd < _form.PeriodStart) { _formError = "Period End must be on or after Period Start."; ShowToast(_formError, "warning"); return false; } if (_form.ConfidencePct is < 0 or > 100) { _formError = "Confidence must be between 0 and 100."; ShowToast(_formError, "warning"); return false; } return true; }
    private static bool Contains(string? value, string term) => value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
    private static int StatusSort(string status) => status switch { "Active" => 0, "Approved" => 1, "Draft" => 2, "Closed" => 3, "Archived" => 4, _ => 5 };
    private static int ConfidencePercent(CommissionForecastDto item) => (int)Math.Clamp(item.ConfidencePct, 0, 100);
    private static string PeriodLabel(CommissionForecastDto item) => $"{item.PeriodStart:MMM d} - {item.PeriodEnd:MMM d, yyyy}";
    private static string StatusCss(string status) => $"cf-st-{status.ToLowerInvariant()}";
    private static string ScenarioCss(string scenario) => $"cf-sc-{scenario.ToLowerInvariant()}";
    private static string ScenarioIconTone(string scenario) => scenario switch { "Upside" => "cf-di-green", "Downside" => "cf-di-amber", "Stretch" => "cf-di-purple", "Conservative" => "cf-di-cyan", _ => "cf-di-blue" };
    private static string VarianceCss(CommissionForecastDto item) => item.VarianceAmount >= 0 ? "cf-var-positive" : "cf-var-negative";
    private static string Csv(string value) { var quote = Convert.ToChar(34).ToString(); return string.Concat(quote, value.Replace(quote, quote + quote), quote); }
    private string KpiClass(KpiModel kpi) => $"cf-kpi-card {kpi.Tone} {(_kpiFilter == kpi.Filter ? "cf-kpi-active" : string.Empty)}";
    private string RowClass(CommissionForecastDto item) => $"cf-table-row {(_selected?.ForecastId == item.ForecastId ? "cf-table-row--selected" : string.Empty)}";
    private async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; }
    private sealed record KpiModel(string Filter, string Label, string Value, string Caption, string Icon, string Tone) { public string Title => $"Filter forecasts by {Label}"; }
    private sealed class ForecastForm { public Guid? CommissionPlanId { get; set; } public Guid? PayeeId { get; set; } [Required, StringLength(80)] public string ForecastNumber { get; set; } = string.Empty; [Required, StringLength(200)] public string ForecastName { get; set; } = string.Empty; [Required] public DateTime PeriodStart { get; set; } = DateTime.Today; [Required] public DateTime PeriodEnd { get; set; } = DateTime.Today.AddMonths(1); [Range(0, 100000000)] public decimal PipelinePremium { get; set; } [Range(0, 100000000)] public decimal WeightedPremium { get; set; } [Range(0, 100000000)] public decimal ExpectedRevenue { get; set; } [Range(0, 100000000)] public decimal ForecastCommission { get; set; } [Range(0, 100)] public decimal ConfidencePct { get; set; } = 75; [Range(0, 100000000)] public decimal ActualCommission { get; set; } [Required, StringLength(50)] public string ScenarioCode { get; set; } = "Base"; [Required, StringLength(50)] public string StatusCode { get; set; } = "Draft"; [StringLength(1000)] public string? Notes { get; set; } }
