@page "/claims/follow-up"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject Ams.Web.Services.ApiClient Api

<PageTitle>Claim Follow-Up Queue — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<!-- ── SNOOZE DIALOG ─────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showSnoozeDlg" Width="380px" ShowCloseIcon="true" IsModal="true">
    <DialogTemplates>
        <Header><div class="pd-dlg-hdr"><i class="bi bi-alarm" aria-hidden="true"></i> Snooze Follow-Up</div></Header>
        <Content>
            <div class="pd-dlg-body">
                <div class="fq-snooze-claim">
                    @if (_snoozeTarget is not null)
                    {
                        <span class="fq-snooze-num">@_snoozeTarget.ClaimNumber</span>
                        <span class="fq-snooze-acct">@_snoozeTarget.AccountName</span>
                    }
                </div>
                <div class="pd-dlg-grid-1" style="margin-top:.75rem;">
                    <div>
                        <label class="cd-dlg-lbl">Snooze until</label>
                        <SfDatePicker TValue="DateTime?" @bind-Value="_snoozeDate" Min="DateTime.Today.AddDays(1)" Placeholder="MM/DD/YYYY" />
                    </div>
                    <div>
                        <label class="cd-dlg-lbl">Reason</label>
                        <SfDropDownList TValue="string" TItem="string"
                                        DataSource="@(new[]{"Waiting on insured","Waiting on carrier","Waiting on medical records","Waiting on legal","Pending investigation","Scheduled follow-up","Other"})"
                                        @bind-Value="_snoozeReason" Placeholder="Select reason" />
                    </div>
                    <div>
                        <label class="cd-dlg-lbl">Notes</label>
                        <SfTextBox @bind-Value="_snoozeNote" Placeholder="Optional note…" Multiline="true" />
                    </div>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="pd-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showSnoozeDlg = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="ConfirmSnooze">
                    <i class="bi bi-alarm" aria-hidden="true"></i> Snooze
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ── LOG ACTION DIALOG ─────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showActionDlg" Width="440px" ShowCloseIcon="true" IsModal="true">
    <DialogTemplates>
        <Header><div class="pd-dlg-hdr"><i class="bi bi-check2-square" aria-hidden="true"></i> Log Follow-Up Action</div></Header>
        <Content>
            <div class="pd-dlg-body">
                @if (_actionTarget is not null)
                {
                    <div class="fq-snooze-claim">
                        <span class="fq-snooze-num">@_actionTarget.ClaimNumber</span>
                        <span class="fq-snooze-acct">@_actionTarget.AccountName — @_actionTarget.FollowUpReason</span>
                    </div>
                }
                <div class="pd-dlg-grid-1" style="margin-top:.75rem;">
                    <div>
                        <label class="cd-dlg-lbl">Action Taken *</label>
                        <SfDropDownList TValue="string" TItem="string"
                                        DataSource="@(new[]{"Called claimant","Called carrier adjuster","Emailed claimant","Emailed carrier","Requested medical records","Sent demand to carrier","Filed suit response","Updated reserves","Spoke with attorney","Sent status update to insured","Other"})"
                                        @bind-Value="_actionTaken" Placeholder="Select action" />
                    </div>
                    <div>
                        <label class="cd-dlg-lbl">Outcome</label>
                        <SfDropDownList TValue="string" TItem="string"
                                        DataSource="@(new[]{"Resolved — closing","Follow-up again","Waiting on response","Escalated","No contact — voicemail","Other"})"
                                        @bind-Value="_actionOutcome" Placeholder="Select outcome" />
                    </div>
                    <div>
                        <label class="cd-dlg-lbl">Notes</label>
                        <SfTextBox @bind-Value="_actionNote" Placeholder="Action notes…" Multiline="true" />
                    </div>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="pd-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showActionDlg = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="ConfirmAction">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Save &amp; Close
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<AppPageHeader Title="Claim Follow-Up Administration"
               Subtitle="Tenant admin work queue for overdue follow-ups, handler assignments, litigation updates, and carrier status checks"
               Icon="bi-list-check">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-ghost" @onclick="ExportAsync">
            <i class="bi bi-download" aria-hidden="true"></i> Export
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/claims/new")'>
            <i class="bi bi-clipboard-plus" aria-hidden="true"></i> New FNOL
        </button>
    </Actions>
</AppPageHeader>

<section class="ma-hero clm-hero">
    <div>
        <span class="ma-eyebrow">Tenant Administration · Claim Follow-Up</span>
        <h2>Tenant Claims Follow-Up Queue</h2>
        <p>Administer claim tasks by due date, handler, priority, reason, severity, litigation status, and catastrophe response requirements.</p>
    </div>
    <div class="ma-hero-actions">
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/claims")'><i class="bi bi-list-ul"></i> Claims Register</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/claims/new")'><i class="bi bi-clipboard-plus"></i> FNOL Intake</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/claims/catastrophe")'><i class="bi bi-cloud-lightning"></i> Catastrophe View</button>
    </div>
</section>

<!-- ── KPI STRIP ─────────────────────────────────────────────────── -->
<div class="fq-kpi-strip">
    @FqKpi("bi-list-check",          "In Queue",         _queue.Count.ToString(),                                              "fq-ki-blue",   null)
    @FqKpi("bi-exclamation-triangle","Overdue",          _queue.Count(q => q.IsOverdue).ToString(),                           "fq-ki-red",    "Overdue")
    @FqKpi("bi-calendar-event",      "Due Today",        _queue.Count(q => q.DueDate.Date == DateTime.Today && !q.IsOverdue).ToString(), "fq-ki-amber", "Today")
    @FqKpi("bi-calendar-week",       "Due This Week",    _queue.Count(q => q.DueDate.Date <= DateTime.Today.AddDays(7) && q.DueDate.Date > DateTime.Today).ToString(), "fq-ki-blue", "Week")
    @FqKpi("bi-alarm",               "Snoozed",          _queue.Count(q => q.IsSnoozed).ToString(),                           "fq-ki-gray",   "Snoozed")
    @FqKpi("bi-fire",                "Urgent",           _queue.Count(q => q.Priority == "Urgent").ToString(),                "fq-ki-red",    "Urgent")
    @FqKpi("bi-person-check",        "Assigned to Me",   _queue.Count(q => q.AssignedHandler == _currentUser).ToString(),     "fq-ki-purple", "Mine")
    @FqKpi("bi-currency-dollar",     "Total Incurred",   _queue.Sum(q => q.TotalIncurred).ToString("C0"),                    "fq-ki-gray",   null)
</div>

<!-- ── FILTER BAR ────────────────────────────────────────────────── -->
<div class="fq-filter-bar">
    <input class="e-input fq-search" @bind="_search" @bind:event="oninput"
           placeholder="Search claim #, account, claimant, reason…" />

    <div class="fq-pill-group">
        <button class="cr-pill @(_dueFilter=="" ? "cr-pill-active" : "")" @onclick='()=>_dueFilter=""'>All</button>
        <button class="cr-pill @(_dueFilter=="Overdue" ? "cr-pill-active" : "")" @onclick='()=>_dueFilter="Overdue"'>Overdue</button>
        <button class="cr-pill @(_dueFilter=="Today" ? "cr-pill-active" : "")" @onclick='()=>_dueFilter="Today"'>Due Today</button>
        <button class="cr-pill @(_dueFilter=="Week" ? "cr-pill-active" : "")" @onclick='()=>_dueFilter="Week"'>Due This Week</button>
        <button class="cr-pill @(_dueFilter=="Urgent" ? "cr-pill-active" : "")" @onclick='()=>_dueFilter="Urgent"'>Urgent</button>
        <button class="cr-pill @(_dueFilter=="Mine" ? "cr-pill-active" : "")" @onclick='()=>_dueFilter="Mine"'>My Queue</button>
        <button class="cr-pill @(_dueFilter=="Snoozed" ? "cr-pill-active" : "")" @onclick='()=>_dueFilter="Snoozed"'>Snoozed</button>
    </div>

    <select class="e-input fq-sel" @bind="_handlerFilter">
        <option value="">All Handlers</option>
        @foreach (var h in _queue.Select(q => q.AssignedHandler).Distinct().OrderBy(x => x))
        { <option>@h</option> }
    </select>
    <select class="e-input fq-sel" @bind="_reasonFilter">
        <option value="">All Reasons</option>
        @foreach (var r in _followUpReasons) { <option>@r</option> }
    </select>
    <select class="e-input fq-sel" @bind="_priorityFilter">
        <option value="">All Priorities</option>
        <option>Urgent</option><option>High</option><option>Medium</option><option>Low</option>
    </select>

    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters">
        <i class="bi bi-x" aria-hidden="true"></i> Reset
    </button>
    <span class="cr-filter-count">@FilteredQueue.Count() item(s)</span>
</div>

<!-- ── VIEW TOGGLE ───────────────────────────────────────────────── -->
<div class="fq-view-toggle">
    <button class="fq-view-btn @(_view=="grid"?"fq-view-active":"")" @onclick='()=>_view="grid"'>
        <i class="bi bi-table" aria-hidden="true"></i> Grid
    </button>
    <button class="fq-view-btn @(_view=="cards"?"fq-view-active":"")" @onclick='()=>_view="cards"'>
        <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> Cards
    </button>
    <button class="fq-view-btn @(_view=="handler"?"fq-view-active":"")" @onclick='()=>_view="handler"'>
        <i class="bi bi-people" aria-hidden="true"></i> By Handler
    </button>
</div>

<!-- ── GRID VIEW ─────────────────────────────────────────────────── -->
@if (_view == "grid")
{
    <div class="fq-grid-wrap">
        <SfGrid TValue="FollowUpItem" DataSource="@FilteredQueue.ToList()"
                AllowSorting="true" AllowPaging="true" AllowResizing="true"
                AllowFiltering="true" EnableHover="true" RowHeight="60">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
            <GridPageSettings PageSize="20" />
            <GridColumns>

                <GridColumn Field="@nameof(FollowUpItem.Priority)" HeaderText="Pri." Width="90">
                    <Template>
                        @{ var q = (FollowUpItem)context; }
                        <span class="cd-pri cd-pri-@q.Priority.ToLower()">@q.Priority</span>
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(FollowUpItem.ClaimNumber)" HeaderText="Claim #" Width="155">
                    <Template>
                        @{ var q = (FollowUpItem)context; }
                        <button class="cr-claim-link" @onclick="() => GoToClaim(q.ClaimId)">@q.ClaimNumber</button>
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(FollowUpItem.AccountName)" HeaderText="Account" MinWidth="180">
                    <Template>
                        @{ var q = (FollowUpItem)context; }
                        <div class="cr-acct-cell">
                            <span class="fq-acct-name">@q.AccountName</span>
                            <div class="cr-acct-meta">@q.Lob · @q.LossType</div>
                        </div>
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(FollowUpItem.FollowUpReason)" HeaderText="Follow-Up Reason" MinWidth="195">
                    <Template>
                        @{ var q = (FollowUpItem)context; }
                        <span class="fq-reason fq-reason-@ReasonCss(q.FollowUpReason)">@q.FollowUpReason</span>
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(FollowUpItem.DueDate)" HeaderText="Due Date" Width="120">
                    <Template>
                        @{ var q = (FollowUpItem)context; }
                        <div class="fq-due-cell">
                            <span class="pd-mono @DueCss(q)">@q.DueDate.ToString("MM/dd/yyyy")</span>
                            @if (q.IsOverdue) { <span class="fq-overdue-badge">Overdue</span> }
                            @if (q.DueDate.Date == DateTime.Today && !q.IsOverdue) { <span class="fq-today-badge">Today</span> }
                        </div>
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(FollowUpItem.DaysOpen)" HeaderText="Days Open" Width="105"
                            TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                    <Template>
                        @{ var q = (FollowUpItem)context; }
                        <span class="pd-mono @(q.DaysOpen > 180 ? "pd-viol-warn" : q.DaysOpen > 90 ? "cr-days-warn" : "")">@q.DaysOpen</span>
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(FollowUpItem.ClaimStatus)" HeaderText="Status" Width="130">
                    <Template>
                        @{ var q = (FollowUpItem)context; }
                        <span class="cr-status cr-st-@StatusCss(q.ClaimStatus)">@q.ClaimStatus</span>
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(FollowUpItem.TotalIncurred)" HeaderText="Incurred" Width="125"
                            TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                    <Template>
                        @{ var q = (FollowUpItem)context; }
                        <span class="pd-mono @(q.TotalIncurred > 100_000 ? "pd-viol-warn" : "")">@q.TotalIncurred.ToString("C0")</span>
                    </Template>
                </GridColumn>

                <GridColumn Field="@nameof(FollowUpItem.AssignedHandler)" HeaderText="Handler" Width="140" />

                <GridColumn HeaderText="Flags" Width="90" AllowSorting="false" AllowFiltering="false">
                    <Template>
                        @{ var q = (FollowUpItem)context; }
                        <div class="cr-flags">
                            @if (q.IsLitigation)  { <span class="cr-flag cr-flag-lit" title="Litigation"><i class="bi bi-gavel" aria-hidden="true"></i></span> }
                            @if (q.IsCatastrophe) { <span class="cr-flag cr-flag-cat" title="CAT"><i class="bi bi-cloud-lightning" aria-hidden="true"></i></span> }
                            @if (q.IsSnoozed)     { <span class="cr-flag fq-flag-snz" title="Snoozed"><i class="bi bi-alarm" aria-hidden="true"></i></span> }
                        </div>
                    </Template>
                </GridColumn>

                <GridColumn HeaderText="Actions" Width="195" AllowSorting="false" AllowFiltering="false">
                    <Template>
                        @{ var q = (FollowUpItem)context; }
                        <div class="rdb-row-actions">
                            <button class="um-btn um-btn-primary um-btn-xs" @onclick="() => OpenLogAction(q)">
                                <i class="bi bi-check2-square" aria-hidden="true"></i> Done
                            </button>
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenSnooze(q)" title="Snooze">
                                <i class="bi bi-alarm" aria-hidden="true"></i>
                            </button>
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => GoToClaim(q.ClaimId)" title="Open claim">
                                <i class="bi bi-arrow-right-circle" aria-hidden="true"></i>
                            </button>
                        </div>
                    </Template>
                </GridColumn>

            </GridColumns>
        </SfGrid>
    </div>
}

<!-- ── CARDS VIEW ────────────────────────────────────────────────── -->
@if (_view == "cards")
{
    <div class="fq-cards-wrap">
        @foreach (var q in FilteredQueue.OrderByDescending(x => x.IsOverdue).ThenBy(x => x.DueDate))
        {
            <div class="fq-card fq-card-@(q.IsOverdue ? "overdue" : q.DueDate.Date == DateTime.Today ? "today" : "normal")">
                <div class="fq-card-top">
                    <button class="cr-claim-link" @onclick="() => GoToClaim(q.ClaimId)">@q.ClaimNumber</button>
                    <span class="cd-pri cd-pri-@q.Priority.ToLower()">@q.Priority</span>
                    @if (q.IsOverdue) { <span class="fq-overdue-badge">Overdue</span> }
                    @if (q.IsSnoozed) { <span class="cr-flag fq-flag-snz"><i class="bi bi-alarm" aria-hidden="true"></i></span> }
                </div>
                <div class="fq-card-acct">@q.AccountName</div>
                <div class="fq-card-meta">@q.Lob · @q.LossType</div>
                <div class="fq-card-reason">
                    <span class="fq-reason fq-reason-@ReasonCss(q.FollowUpReason)">@q.FollowUpReason</span>
                </div>
                <div class="fq-card-footer">
                    <span class="fq-card-due @DueCss(q)">
                        <i class="bi bi-calendar-event" aria-hidden="true"></i>
                        @q.DueDate.ToString("MM/dd/yyyy")
                    </span>
                    <span class="fq-card-handler"><i class="bi bi-person" aria-hidden="true"></i>@q.AssignedHandler</span>
                    <span class="fq-card-incurred pd-mono">@q.TotalIncurred.ToString("C0")</span>
                </div>
                <div class="fq-card-actions">
                    <button class="um-btn um-btn-primary um-btn-xs" @onclick="() => OpenLogAction(q)">
                        <i class="bi bi-check2-square" aria-hidden="true"></i> Log Action
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenSnooze(q)">
                        <i class="bi bi-alarm" aria-hidden="true"></i> Snooze
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- ── BY HANDLER VIEW ───────────────────────────────────────────── -->
@if (_view == "handler")
{
    <div class="fq-handler-wrap">
        @foreach (var handler in FilteredQueue.Select(q => q.AssignedHandler).Distinct().OrderBy(h => h))
        {
            var items     = FilteredQueue.Where(q => q.AssignedHandler == handler).ToList();
            var overdue   = items.Count(q => q.IsOverdue);
            var dueToday  = items.Count(q => q.DueDate.Date == DateTime.Today && !q.IsOverdue);
            <div class="fq-handler-section">
                <div class="fq-handler-hdr">
                    <div class="fq-handler-avatar">@handler[0]</div>
                    <div class="fq-handler-info">
                        <div class="fq-handler-name">@handler</div>
                        <div class="fq-handler-meta">
                            <span class="fq-hm-chip fq-hm-total">@items.Count total</span>
                            @if (overdue > 0) { <span class="fq-hm-chip fq-hm-overdue">@overdue overdue</span> }
                            @if (dueToday > 0){ <span class="fq-hm-chip fq-hm-today">@dueToday due today</span> }
                            <span class="fq-hm-chip">@items.Sum(q => q.TotalIncurred).ToString("C0") incurred</span>
                        </div>
                    </div>
                </div>
                <div class="fq-handler-rows">
                    @foreach (var q in items.OrderByDescending(x => x.IsOverdue).ThenBy(x => x.DueDate))
                    {
                        <div class="fq-handler-row fq-hr-@(q.IsOverdue ? "overdue" : q.DueDate.Date == DateTime.Today ? "today" : "normal")">
                            <button class="cr-claim-link" @onclick="() => GoToClaim(q.ClaimId)">@q.ClaimNumber</button>
                            <span class="fq-hr-acct">@q.AccountName</span>
                            <span class="fq-reason fq-reason-@ReasonCss(q.FollowUpReason)">@q.FollowUpReason</span>
                            <span class="pd-mono @DueCss(q)">@q.DueDate.ToString("MM/dd/yyyy")</span>
                            <span class="cd-pri cd-pri-@q.Priority.ToLower()">@q.Priority</span>
                            <div class="rdb-row-actions">
                                <button class="um-btn um-btn-primary um-btn-xs" @onclick="() => OpenLogAction(q)">
                                    <i class="bi bi-check2-square" aria-hidden="true"></i>
                                </button>
                                <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenSnooze(q)">
                                    <i class="bi bi-alarm" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    SfToast _toast = default!;
    Guid TenantId { get; set; }

    string _view           = "grid";
    string _search         = "";
    string _dueFilter      = "";
    string _handlerFilter  = "";
    string _reasonFilter   = "";
    string _priorityFilter = "";

    bool   _showSnoozeDlg  = false;
    bool   _showActionDlg  = false;
    DateTime? _snoozeDate  = DateTime.Today.AddDays(3);
    string _snoozeReason   = "";
    string _snoozeNote     = "";
    string _actionTaken    = "";
    string _actionOutcome  = "";
    string _actionNote     = "";

    FollowUpItem? _snoozeTarget = null;
    FollowUpItem? _actionTarget = null;

    const string _currentUser = "Sarah Kim";

    readonly string[] _followUpReasons = {
        "Reserve Review Due","Medical Records Pending","Demand Letter Response","Attorney Contact",
        "Carrier Status Check","Investigation Update","IME Scheduled","Settlement Negotiation",
        "Coverage Decision Pending","Litigation Update","Subrogation Action","Payment Confirmation",
        "Insured Update","CAT Field Inspection"
    };

    sealed class FollowUpItem
    {
        public Guid     ClaimId          { get; set; }
        public string   ClaimNumber      { get; set; } = "";
        public string   AccountName      { get; set; } = "";
        public string   Lob              { get; set; } = "";
        public string   LossType         { get; set; } = "";
        public string   ClaimStatus      { get; set; } = "";
        public string   FollowUpReason   { get; set; } = "";
        public string   Priority         { get; set; } = "";
        public DateTime DueDate          { get; set; }
        public int      DaysOpen         { get; set; }
        public decimal  TotalIncurred    { get; set; }
        public string   AssignedHandler  { get; set; } = "";
        public bool     IsOverdue        { get; set; }
        public bool     IsSnoozed        { get; set; }
        public bool     IsLitigation     { get; set; }
        public bool     IsCatastrophe    { get; set; }
    }

    readonly List<FollowUpItem> _queue = new();

    IEnumerable<FollowUpItem> FilteredQueue => _queue.Where(q =>
        (string.IsNullOrEmpty(_search) ||
         q.ClaimNumber.Contains(_search,StringComparison.OrdinalIgnoreCase) ||
         q.AccountName.Contains(_search,StringComparison.OrdinalIgnoreCase) ||
         q.FollowUpReason.Contains(_search,StringComparison.OrdinalIgnoreCase))
     && (_dueFilter == "" || _dueFilter switch {
            "Overdue" => q.IsOverdue,
            "Today"   => q.DueDate.Date == DateTime.Today && !q.IsOverdue,
            "Week"    => q.DueDate.Date <= DateTime.Today.AddDays(7) && q.DueDate.Date > DateTime.Today,
            "Urgent"  => q.Priority == "Urgent",
            "Mine"    => q.AssignedHandler == _currentUser,
            "Snoozed" => q.IsSnoozed,
            _         => true
        })
     && (string.IsNullOrEmpty(_handlerFilter)  || q.AssignedHandler  == _handlerFilter)
     && (string.IsNullOrEmpty(_reasonFilter)   || q.FollowUpReason   == _reasonFilter)
     && (string.IsNullOrEmpty(_priorityFilter) || q.Priority         == _priorityFilter));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Claims","/claims"), new("Follow-Up Queue",""));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        var result = await Api.SearchClaimsAsync(TenantId, pageSize: 500);
        _queue.Clear();
        _queue.AddRange((result?.Items ?? [])
            .Where(c => c.Status != "Closed")
            .Select(ToFollowUpItem));
    }

    void BuildStub()
    {
        _queue.Clear();
