    static FollowUpItem MakeItem(string claimNum, string acct, string lob, string lossType, string status,
        string reason, string priority, DateTime due, int daysOpen, decimal incurred, string handler,
        bool lit, bool sub, bool isLit, bool isCat) => new()
    {
        ClaimId=Guid.NewGuid(), ClaimNumber=claimNum, AccountName=acct, Lob=lob, LossType=lossType,
        ClaimStatus=status, FollowUpReason=reason, Priority=priority, DueDate=due, DaysOpen=daysOpen,
        TotalIncurred=incurred, AssignedHandler=handler, IsOverdue=due < DateTime.Today,
        IsSnoozed=false, IsLitigation=isLit, IsCatastrophe=isCat
    };

    static FollowUpItem ToFollowUpItem(Ams.Application.Common.Dtos.ClaimDto c) => new()
    {
        ClaimId = c.ClaimId,
        ClaimNumber = c.ClaimNumber,
        AccountName = c.AccountName,
        Lob = c.Lob,
        LossType = c.LossType,
        ClaimStatus = c.Status,
        FollowUpReason = string.IsNullOrWhiteSpace(c.FollowUpReason) ? "Initial follow-up" : c.FollowUpReason,
        Priority = string.IsNullOrWhiteSpace(c.Priority) ? "Medium" : c.Priority,
        DueDate = c.FollowUpDueDate ?? DateTime.Today.AddDays(7),
        DaysOpen = c.DaysOpen,
        TotalIncurred = c.TotalIncurred,
        AssignedHandler = c.AssignedHandler,
        IsOverdue = (c.FollowUpDueDate ?? DateTime.Today.AddDays(7)).Date < DateTime.Today,
        IsSnoozed = c.IsSnoozed,
        IsLitigation = c.IsLitigation,
        IsCatastrophe = c.IsCatastrophe
    };

    void OpenSnooze(FollowUpItem q)   { _snoozeTarget=q; _snoozeDate=DateTime.Today.AddDays(3); _snoozeReason=""; _snoozeNote=""; _showSnoozeDlg=true; }
    void OpenLogAction(FollowUpItem q){ _actionTarget=q; _actionTaken=""; _actionOutcome=""; _actionNote=""; _showActionDlg=true; }
    void ResetFilters() { _search=""; _dueFilter=""; _handlerFilter=""; _reasonFilter=""; _priorityFilter=""; }
    async Task Refresh() => await LoadAsync();

    async Task ConfirmSnooze()
    {
        if (_snoozeTarget is null) return;
        await Api.UpdateClaimFollowUpAsync(_snoozeTarget.ClaimId, new Ams.Application.Features.Claims.UpdateClaimFollowUpRequest
        {
            FollowUpDueDate = _snoozeDate ?? DateTime.Today.AddDays(3),
            IsSnoozed = true
        });
        _snoozeTarget.IsSnoozed = true;
        _snoozeTarget.DueDate   = _snoozeDate ?? DateTime.Today.AddDays(3);
        _snoozeTarget.IsOverdue = false;
        _showSnoozeDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Snoozed", Content=$"{_snoozeTarget.ClaimNumber} snoozed until {_snoozeTarget.DueDate:MM/dd/yyyy}.", CssClass="e-toast-info" });
    }

    async Task ConfirmAction()
    {
        if (_actionTarget is null || string.IsNullOrEmpty(_actionTaken)) return;
        await Api.AddClaimActivityAsync(new Ams.Application.Features.Claims.CreateClaimActivityRequest
        {
            ClaimId = _actionTarget.ClaimId,
            ActivityType = "FollowUp",
            Title = _actionTaken,
            Category = _actionOutcome,
            Notes = _actionNote,
            ActivityDate = DateTime.UtcNow,
            CreatedBy = _currentUser
        });
        await Api.UpdateClaimFollowUpAsync(_actionTarget.ClaimId, new Ams.Application.Features.Claims.UpdateClaimFollowUpRequest
        {
            FollowUpReason = "Follow-up again",
            FollowUpDueDate = DateTime.Today.AddDays(7),
            IsSnoozed = false
        });
        _queue.Remove(_actionTarget);
        _showActionDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Action Logged", Content=$"{_actionTarget.ClaimNumber} — follow-up closed.", CssClass="e-toast-success" });
    }

    async Task ExportAsync() =>
        await _toast.ShowAsync(new ToastModel { Title="Exported", Content="Follow-up queue exported.", CssClass="e-toast-success" });

    void GoToClaim(Guid id)              => Nav.NavigateTo($"/claims/{id}");
    void ToggleDueFilter(string? filter) => _dueFilter = filter is null ? "" : (_dueFilter == filter ? "" : filter);

    RenderFragment FqKpi(string icon, string label, string val, string color, string? filter) => __builder =>
    {
        <div class="fq-kpi-card @color @(filter is not null ? "cr-kpi-clickable" : "")"
             @onclick="() => ToggleDueFilter(filter)">
            <i class="bi @icon fq-kpi-icon" aria-hidden="true"></i>
            <div><div class="fq-kpi-val">@val</div><div class="fq-kpi-lbl">@label</div></div>
        </div>
    };

    static string StatusCss(string s)  => s.ToLower().Replace(" ","-").Replace("/","-");
    static string DueCss(FollowUpItem q) =>
        q.IsOverdue ? "pd-viol-warn" :
        q.DueDate.Date == DateTime.Today ? "cr-days-warn" : "";

    static string ReasonCss(string r) => r switch
    {
        "Litigation Update"        or "Settlement Negotiation" or "Attorney Contact" => "lit",
        "Reserve Review Due"       or "Coverage Decision Pending"                    => "cov",
        "Medical Records Pending"  or "IME Scheduled"                                => "med",
        "Carrier Status Check"     or "Payment Confirmation"                         => "car",
        "CAT Field Inspection"     or "Investigation Update"                         => "cat",
        "Subrogation Action"                                                          => "sub",
        _                                                                             => "gen",
    };

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
