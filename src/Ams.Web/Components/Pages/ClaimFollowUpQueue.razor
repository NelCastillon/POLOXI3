@page "/claims/follow-up"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Claims
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject Ams.Web.Services.ApiClient Api
@inject IJSRuntime Js

<PageTitle>Claim Follow-Up Command Center - AMS</PageTitle>

<div class="fq-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="fq-toast @toast.CssClass">
            <i class="bi @toast.Icon" aria-hidden="true"></i>
            <span>@toast.Content</span>
            <button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
    }
</div>

@if (_showSnoozeDialog && _snoozeTarget is not null)
{
    <div class="fq-modal-backdrop" role="presentation" @onclick="CloseSnoozeDialog">
        <div class="fq-follow-modal" role="dialog" aria-modal="true" aria-labelledby="snoozeTitle" @onclick:stopPropagation="true">
            <div class="fq-modal-header">
                <div class="fq-modal-title">
                    <span class="fq-modal-icon"><i class="bi bi-alarm" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="snoozeTitle">Snooze follow-up</h2>
                        <p>@_snoozeTarget.ClaimNumber - @_snoozeTarget.AccountName</p>
                    </div>
                </div>
                <button type="button" class="fq-btn fq-btn-light" @onclick="CloseSnoozeDialog" disabled="@_savingSnooze" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_snoozeForm" OnValidSubmit="ConfirmSnoozeAsync" OnInvalidSubmit="NotifyInvalidSnoozeAsync">
                <DataAnnotationsValidator />
                <div class="fq-modal-body">
                    <div class="fq-form-banner">
                        <i class="bi bi-calendar2-week" aria-hidden="true"></i>
                        <div>
                            <strong>Keep the claim in workflow</strong>
                            <span>Snooze updates the follow-up due date and records an activity note for audit history.</span>
                        </div>
                    </div>
                    <div class="fq-form-grid fq-form-grid-1">
                        <div class="fq-field">
                            <label>Snooze until <span>*</span></label>
                            <InputDate class="fq-input" @bind-Value="_snoozeForm.SnoozeUntil" />
                            
                        </div>
                        <div class="fq-field">
                            <label>Reason <span>*</span></label>
                            <InputSelect class="fq-input" @bind-Value="_snoozeForm.Reason">
                                <option value="">Select reason</option>
                                @foreach (var reason in _snoozeReasons)
                                {
                                    <option value="@reason">@reason</option>
                                }
                            </InputSelect>
                            
                        </div>
                        <div class="fq-field">
                            <label>Notes</label>
                            <InputTextArea class="fq-input fq-textarea" @bind-Value="_snoozeForm.Notes" placeholder="Optional handling note" />
                            
                        </div>
                    </div>
                </div>
                <div class="fq-modal-footer">
                    <button type="button" class="fq-btn fq-btn-light" @onclick="CloseSnoozeDialog" disabled="@_savingSnooze">Cancel</button>
                    <button type="submit" class="fq-btn fq-btn-blue" disabled="@_savingSnooze"><i class="bi bi-alarm" aria-hidden="true"></i> @(_savingSnooze ? "Saving..." : "Snooze")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showActionDialog && _actionTarget is not null)
{
    <div class="fq-modal-backdrop" role="presentation" @onclick="CloseActionDialog">
        <div class="fq-follow-modal" role="dialog" aria-modal="true" aria-labelledby="actionTitle" @onclick:stopPropagation="true">
            <div class="fq-modal-header">
                <div class="fq-modal-title">
                    <span class="fq-modal-icon"><i class="bi bi-check2-square" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="actionTitle">Log follow-up action</h2>
                        <p>@_actionTarget.ClaimNumber - @FollowUpReason(_actionTarget)</p>
                    </div>
                </div>
                <button type="button" class="fq-btn fq-btn-light" @onclick="CloseActionDialog" disabled="@_savingAction" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_actionForm" OnValidSubmit="ConfirmActionAsync" OnInvalidSubmit="NotifyInvalidActionAsync">
                <DataAnnotationsValidator />
                <div class="fq-modal-body">
                    <div class="fq-form-banner">
                        <i class="bi bi-journal-check" aria-hidden="true"></i>
                        <div>
                            <strong>Audit-ready follow-up activity</strong>
                            <span>Action details are saved as claim activity, and the next follow-up date is synchronized to the claim workflow.</span>
                        </div>
                    </div>
                    <div class="fq-form-grid">
                        <div class="fq-field">
                            <label>Action taken <span>*</span></label>
                            <InputSelect class="fq-input" @bind-Value="_actionForm.ActionTaken">
                                <option value="">Select action</option>
                                @foreach (var action in _actionTypes)
                                {
                                    <option value="@action">@action</option>
                                }
                            </InputSelect>
                            
                        </div>
                        <div class="fq-field">
                            <label>Outcome <span>*</span></label>
                            <InputSelect class="fq-input" @bind-Value="_actionForm.Outcome">
                                <option value="">Select outcome</option>
                                @foreach (var outcome in _outcomes)
                                {
                                    <option value="@outcome">@outcome</option>
                                }
                            </InputSelect>
                            
                        </div>
                        <div class="fq-field">
                            <label>Next follow-up</label>
                            <InputDate class="fq-input" @bind-Value="_actionForm.NextFollowUp" />
                            
                        </div>
                        <div class="fq-field">
                            <label>Priority</label>
                            <InputSelect class="fq-input" @bind-Value="_actionForm.Priority">
                                @foreach (var priority in _priorities)
                                {
                                    <option value="@priority">@priority</option>
                                }
                            </InputSelect>
                            
                        </div>
                        <div class="fq-field fq-field-wide">
                            <label>Notes</label>
                            <InputTextArea class="fq-input fq-textarea" @bind-Value="_actionForm.Notes" placeholder="Action notes, commitments, blockers, or next steps" />
                            
                        </div>
                    </div>
                </div>
                <div class="fq-modal-footer">
                    <button type="button" class="fq-btn fq-btn-light" @onclick="CloseActionDialog" disabled="@_savingAction">Cancel</button>
                    <button type="submit" class="fq-btn fq-btn-blue" disabled="@_savingAction"><i class="bi bi-check-lg" aria-hidden="true"></i> @(_savingAction ? "Saving..." : "Save action")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="fq-enterprise-page">
    <section class="fq-hero">
        <div class="fq-hero-left">
            <div class="fq-hero-icon"><i class="bi bi-list-check" aria-hidden="true"></i></div>
            <div>
                <div class="fq-title-row">
                    <h1>Claim Follow-Up Command Center</h1>
                    <span><i class="bi bi-building-check" aria-hidden="true"></i> @DisplayValue(_userContext?.TenantName, "Tenant workspace")</span>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> DB-backed</span>
                </div>
                <p>Prioritize overdue claim work, litigation/CAT exceptions, handler capacity, carrier tasks, and next-best follow-up actions.</p>
            </div>
        </div>
        <div class="fq-hero-actions">
            <button type="button" class="fq-btn fq-btn-ghost" @onclick="RefreshAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="fq-btn fq-btn-ghost" @onclick="ExportAsync" disabled="@(!_claims.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="fq-btn fq-btn-primary" @onclick='() => Nav.NavigateTo("/claims/new")'><i class="bi bi-clipboard-plus" aria-hidden="true"></i> New FNOL</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="fq-error-banner"><i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="fq-kpi-strip" aria-label="Claim follow-up KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="@KpiClass(kpi)" title="@kpi.Title" @onclick="() => ApplyKpi(kpi)">
                <span class="fq-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span>
                    <strong>@kpi.Value</strong>
                    <small>@kpi.Label</small>
                    <em>@kpi.Detail</em>
                </span>
            </button>
        }
    </section>

    <section class="fq-workflow-strip" aria-label="Claim follow-up workflow filters">
        @foreach (var lane in WorkflowLanes)
        {
            <button type="button" class="@WorkflowClass(lane)" title="@lane.Title" @onclick="() => ApplyWorkflow(lane)">
                <i class="bi @lane.Icon" aria-hidden="true"></i>
                <span>
                    <strong>@lane.Label</strong>
                    <small>@lane.Count item(s) - @lane.Detail</small>
                </span>
            </button>
        }
    </section>

    <section class="fq-search-panel" aria-label="Claim follow-up search and filters">
        <div class="fq-search-wrap">
            <span class="fq-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="fq-search-body">
                <label>Search queue</label>
                <input class="fq-search-input" @bind="_search" @bind:event="oninput" placeholder="Claim #, insured, claimant, carrier, reason, handler" />
                <span class="fq-search-hint">Filtered from @_claims.Count active claim(s)</span>
            </div>
        </div>
        <select class="fq-filter-select" @bind="_handlerFilter" aria-label="Handler filter">
            <option value="">All handlers</option>
            @foreach (var handler in HandlerOptions)
            {
                <option value="@handler">@handler</option>
            }
        </select>
        <select class="fq-filter-select" @bind="_reasonFilter" aria-label="Reason filter">
            <option value="">All reasons</option>
            @foreach (var reason in ReasonOptions)
            {
                <option value="@reason">@reason</option>
            }
        </select>
        <select class="fq-filter-select" @bind="_priorityFilter" aria-label="Priority filter">
            <option value="">All priorities</option>
            @foreach (var priority in PriorityOptions)
            {
                <option value="@priority">@priority</option>
            }
        </select>
        <button type="button" class="fq-btn fq-btn-light" @onclick="ResetFilters"><i class="bi bi-x-circle" aria-hidden="true"></i> Reset</button>
        <div class="fq-search-result"><strong>@FilteredClaims.Count</strong><span>Visible</span></div>
    </section>

    <div class="fq-view-tabs" role="tablist" aria-label="Follow-up views">
        <button type="button" class="@TabClass("queue")" @onclick='() => SelectTab("queue")'><i class="bi bi-table" aria-hidden="true"></i> Queue <strong>@FilteredClaims.Count</strong></button>
        <button type="button" class="@TabClass("cards")" @onclick='() => SelectTab("cards")'><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> Cards <strong>@FilteredClaims.Count</strong></button>
        <button type="button" class="@TabClass("handlers")" @onclick='() => SelectTab("handlers")'><i class="bi bi-people" aria-hidden="true"></i> Handlers <strong>@HandlerGroups.Count</strong></button>
        <button type="button" class="@TabClass("analytics")" @onclick='() => SelectTab("analytics")'><i class="bi bi-bar-chart" aria-hidden="true"></i> Analytics <strong>@_claims.Count</strong></button>
    </div>

    <section class="fq-content-layout">
        <div class="fq-main-card">
            <header class="fq-card-head">
                <div>
                    <h2>@ActiveViewTitle</h2>
                    <p>@ActiveViewSubtitle</p>
                </div>
                <span>@_kpiFilter</span>
            </header>

            @if (_loading)
            {
                <div class="fq-loading"><i class="bi bi-arrow-repeat fq-spin" aria-hidden="true"></i><strong>Loading claim follow-up queue</strong><span>Synchronizing current tenant claim workflow data.</span></div>
            }
            else if (!FilteredClaims.Any())
            {
                <div class="fq-empty-state"><i class="bi bi-inboxes" aria-hidden="true"></i><strong>No follow-ups match the current filters</strong><span>Adjust filters, refresh, or open the claims register to review all claim activity.</span></div>
            }
            else if (_activeTab == "queue")
            {
                <div class="fq-table-scroll">
                    <table class="fq-table">
                        <thead>
                            <tr>
                                <th>Claim</th>
                                <th>Insured / Loss</th>
                                <th>Reason</th>
                                <th>Due</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th class="text-end">Incurred</th>
                                <th>Handler</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var claim in FilteredClaims.OrderByDescending(IsOverdue).ThenBy(DueDate).ThenByDescending(SeverityScore))
                            {
                                <tr class="@RowClass(claim)" @onclick="() => SelectClaim(claim)">
                                    <td data-label="Claim"><button type="button" class="fq-link" @onclick="() => OpenClaim(claim)" @onclick:stopPropagation="true">@claim.ClaimNumber</button><small>@claim.PolicyNumber</small></td>
                                    <td data-label="Insured"><strong>@claim.AccountName</strong><small>@claim.Lob - @claim.LossType - @claim.PrimaryClaimant</small></td>
                                    <td data-label="Reason"><span class="@ReasonClass(claim)">@FollowUpReason(claim)</span></td>
                                    <td data-label="Due"><strong class="@DueTextClass(claim)">@DueDate(claim).ToString("MM/dd/yyyy")</strong><small>@DueLabel(claim)</small></td>
                                    <td data-label="Priority"><span class="@PriorityClass(claim)">@PriorityLabel(claim)</span></td>
                                    <td data-label="Status"><span class="@StatusClass(claim.Status)">@claim.Status</span></td>
                                    <td data-label="Incurred" class="text-end"><strong>@claim.TotalIncurred.ToString("C0")</strong><small>@claim.DaysOpen.ToString("N0")d open</small></td>
                                    <td data-label="Handler"><strong>@DisplayValue(claim.AssignedHandler, "Unassigned")</strong><small>@FlagSummary(claim)</small></td>
                                    <td data-label="Actions" class="text-end">
                                        <div class="fq-row-actions">
                                            <button type="button" class="fq-icon-btn fq-icon-primary" title="Log action" @onclick="() => OpenActionDialog(claim)" @onclick:stopPropagation="true"><i class="bi bi-check2-square" aria-hidden="true"></i></button>
                                            <button type="button" class="fq-icon-btn" title="Snooze" @onclick="() => OpenSnoozeDialog(claim)" @onclick:stopPropagation="true"><i class="bi bi-alarm" aria-hidden="true"></i></button>
                                            <button type="button" class="fq-icon-btn" title="Open claim" @onclick="() => OpenClaim(claim)" @onclick:stopPropagation="true"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (_activeTab == "cards")
            {
                <div class="fq-card-grid">
                    @foreach (var claim in FilteredClaims.OrderByDescending(IsOverdue).ThenBy(DueDate).ThenByDescending(SeverityScore))
                    {
                        <button type="button" class="@QueueCardClass(claim)" @onclick="() => SelectClaim(claim)">
                            <span class="fq-card-top"><strong>@claim.ClaimNumber</strong><em class="@PriorityClass(claim)">@PriorityLabel(claim)</em></span>
                            <span class="fq-card-account">@claim.AccountName</span>
                            <span class="fq-card-meta">@claim.Lob - @claim.LossType - @claim.Status</span>
                            <span class="@ReasonClass(claim)">@FollowUpReason(claim)</span>
                            <span class="fq-card-footer"><span class="@DueTextClass(claim)"><i class="bi bi-calendar-event" aria-hidden="true"></i> @DueDate(claim).ToString("MM/dd/yyyy")</span><span><i class="bi bi-person" aria-hidden="true"></i> @DisplayValue(claim.AssignedHandler, "Unassigned")</span><strong>@claim.TotalIncurred.ToString("C0")</strong></span>
                            <span class="fq-card-actions">
                                <span class="fq-btn fq-btn-blue" @onclick="() => OpenActionDialog(claim)" @onclick:stopPropagation="true"><i class="bi bi-check2-square" aria-hidden="true"></i> Log action</span>
                                <span class="fq-btn fq-btn-light" @onclick="() => OpenSnoozeDialog(claim)" @onclick:stopPropagation="true"><i class="bi bi-alarm" aria-hidden="true"></i> Snooze</span>
                            </span>
                        </button>
                    }
                </div>
            }
            else if (_activeTab == "handlers")
            {
                <div class="fq-handler-wrap">
                    @foreach (var group in HandlerGroups)
                    {
                        <section class="fq-handler-section">
                            <header class="fq-handler-head">
                                <div class="fq-handler-avatar">@Initial(group.Handler)</div>
                                <div>
                                    <strong>@group.Handler</strong>
                                    <span>@group.Items.Count item(s) - @group.Overdue overdue - @group.TotalIncurred.ToString("C0") incurred</span>
                                </div>
                            </header>
                            <div class="fq-handler-rows">
                                @foreach (var claim in group.Items.OrderByDescending(IsOverdue).ThenBy(DueDate))
                                {
                                    <button type="button" class="@HandlerRowClass(claim)" @onclick="() => SelectClaim(claim)">
                                        <strong>@claim.ClaimNumber</strong>
                                        <span>@claim.AccountName</span>
                                        <em class="@ReasonClass(claim)">@FollowUpReason(claim)</em>
                                        <span class="@DueTextClass(claim)">@DueDate(claim).ToString("MM/dd/yyyy")</span>
                                        <span class="@PriorityClass(claim)">@PriorityLabel(claim)</span>
                                        <span class="fq-row-actions"><span class="fq-icon-btn fq-icon-primary" @onclick="() => OpenActionDialog(claim)" @onclick:stopPropagation="true"><i class="bi bi-check2-square" aria-hidden="true"></i></span><span class="fq-icon-btn" @onclick="() => OpenSnoozeDialog(claim)" @onclick:stopPropagation="true"><i class="bi bi-alarm" aria-hidden="true"></i></span></span>
                                    </button>
                                }
                            </div>
                        </section>
                    }
                </div>
            }
            else
            {
                <div class="fq-analytics-grid">
                    @Metric("Overdue work", OverdueClaims.Count.ToString("N0"), "bi-exclamation-triangle")
                    @Metric("Due today", DueTodayClaims.Count.ToString("N0"), "bi-calendar-event")
                    @Metric("High severity", HighSeverityClaims.Count.ToString("N0"), "bi-fire")
                    @Metric("Litigation/CAT", _claims.Count(c => c.IsLitigation || c.IsCatastrophe).ToString("N0"), "bi-shield-exclamation")
                    @Metric("Total incurred", _claims.Sum(c => c.TotalIncurred).ToString("C0"), "bi-currency-dollar")
                    @Metric("Avg days open", (_claims.Any() ? _claims.Average(c => c.DaysOpen) : 0).ToString("N0"), "bi-hourglass-split")
                </div>
            }
        </div>

        <aside class="fq-detail-card">
            @if (_selected is null)
            {
                <div class="fq-empty-state"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a follow-up</strong><span>Choose a queue row or card to inspect claim workflow priority and next action.</span></div>
            }
            else
            {
                <div class="fq-detail-head">
                    <span class="fq-detail-eyebrow"><i class="bi bi-clipboard-pulse" aria-hidden="true"></i> Selected follow-up</span>
                    <h2>@_selected.ClaimNumber</h2>
                    <p>@_selected.AccountName</p>
                </div>
                <div class="fq-detail-body">
                    <div class="fq-detail-summary">
                        <div><span>Due</span><strong class="@DueTextClass(_selected)">@DueDate(_selected).ToString("MM/dd/yyyy")</strong></div>
                        <div><span>Priority</span><strong>@PriorityLabel(_selected)</strong></div>
                        <div><span>Reason</span><strong>@FollowUpReason(_selected)</strong></div>
                        <div><span>Incurred</span><strong>@_selected.TotalIncurred.ToString("C0")</strong></div>
                    </div>
                    <div class="fq-contact-card">
                        <strong>@_selected.Lob - @_selected.LossType</strong>
                        <span>@DisplayValue(_selected.Carrier, "Carrier not assigned")</span>
                        <span>@DisplayValue(_selected.PrimaryClaimant, "Claimant not captured")</span>
                    </div>
                    <div class="fq-flag-grid">
                        @FlagChip(_selected.IsLitigation, "Litigation", "bi-gavel")
                        @FlagChip(_selected.IsCatastrophe, "CAT", "bi-cloud-lightning")
                        @FlagChip(_selected.IsDisputed, "Disputed", "bi-shield-exclamation")
                        @FlagChip(_selected.HasSubrogation, "Subrogation", "bi-arrow-left-right")
                    </div>
                    <div class="fq-detail-actions">
                        <button type="button" class="fq-btn fq-btn-blue" @onclick="() => OpenActionDialog(_selected)"><i class="bi bi-check2-square" aria-hidden="true"></i> Log action</button>
                        <button type="button" class="fq-btn fq-btn-light" @onclick="() => OpenSnoozeDialog(_selected)"><i class="bi bi-alarm" aria-hidden="true"></i> Snooze follow-up</button>
                        <button type="button" class="fq-btn fq-btn-light" @onclick="() => OpenClaim(_selected)"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Open claim detail</button>
                        <button type="button" class="fq-btn fq-btn-light" @onclick='() => Nav.NavigateTo("/claims")'><i class="bi bi-list-ul" aria-hidden="true"></i> Claims register</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    private CurrentUserContextModel? _userContext;
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading;
    private bool _savingSnooze;
    private bool _savingAction;
    private bool _showSnoozeDialog;
    private bool _showActionDialog;
    private string? _loadError;
    private string _activeTab = "queue";
    private string _kpiFilter = "All";
    private string _search = string.Empty;
    private string _handlerFilter = string.Empty;
    private string _reasonFilter = string.Empty;
    private string _priorityFilter = string.Empty;
    private ClaimDto? _selected;
    private ClaimDto? _snoozeTarget;
    private ClaimDto? _actionTarget;
    private SnoozeForm _snoozeForm = new();
    private ActionForm _actionForm = new();
    private readonly List<ClaimDto> _claims = [];
    private readonly List<FollowToast> _toasts = [];

    private readonly string[] _snoozeReasons = ["Waiting on insured", "Waiting on carrier", "Waiting on medical records", "Waiting on legal", "Pending investigation", "Scheduled follow-up", "Other"];
    private readonly string[] _actionTypes = ["Called claimant", "Called carrier adjuster", "Emailed claimant", "Emailed carrier", "Requested medical records", "Sent demand to carrier", "Filed suit response", "Updated reserves", "Spoke with attorney", "Sent status update to insured", "Other"];
    private readonly string[] _outcomes = ["Resolved - closing", "Follow-up again", "Waiting on response", "Escalated", "No contact - voicemail", "Other"];
    private readonly string[] _priorities = ["Low", "Medium", "High", "Urgent", "Critical", "Standard"];

    private List<ClaimDto> FilteredClaims => _claims.Where(MatchesFilters).ToList();
    private List<ClaimDto> OverdueClaims => _claims.Where(IsOverdue).ToList();
    private List<ClaimDto> DueTodayClaims => _claims.Where(c => DueDate(c).Date == DateTime.Today && !IsOverdue(c)).ToList();
    private List<ClaimDto> DueWeekClaims => _claims.Where(c => DueDate(c).Date > DateTime.Today && DueDate(c).Date <= DateTime.Today.AddDays(7)).ToList();
    private List<ClaimDto> HighSeverityClaims => _claims.Where(c => SeverityScore(c) >= 4 || IsHighPriority(c)).ToList();
    private List<string> HandlerOptions => _claims.Select(c => DisplayValue(c.AssignedHandler, "Unassigned")).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    private List<string> ReasonOptions => _claims.Select(FollowUpReason).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    private List<string> PriorityOptions => _claims.Select(PriorityLabel).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    private List<HandlerGroup> HandlerGroups => FilteredClaims.GroupBy(c => DisplayValue(c.AssignedHandler, "Unassigned")).Select(g => new HandlerGroup(g.Key, g.ToList(), g.Count(IsOverdue), g.Sum(c => c.TotalIncurred))).OrderByDescending(g => g.Overdue).ThenByDescending(g => g.Items.Count).ToList();

