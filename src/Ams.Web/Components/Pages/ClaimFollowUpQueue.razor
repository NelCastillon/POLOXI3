        new("In Queue", _claims.Count.ToString("N0"), "bi-list-check", "blue", "All", "Active open claim work", "Show all active follow-ups"),
        new("Overdue", OverdueClaims.Count.ToString("N0"), "bi-exclamation-triangle", "red", "Overdue", "Past due commitments", "Show overdue claim follow-ups"),
        new("Due Today", DueTodayClaims.Count.ToString("N0"), "bi-calendar-event", "amber", "Today", "Must touch today", "Show items due today"),
        new("High Severity", HighSeverityClaims.Count.ToString("N0"), "bi-fire", "red", "Severity", "Urgent, large, or complex", "Show high-severity follow-ups"),
        new("Litigation", _claims.Count(c => c.IsLitigation).ToString("N0"), "bi-gavel", "purple", "Litigation", "Attorney-driven activity", "Show litigation follow-ups"),
        new("Total Incurred", _claims.Sum(c => c.TotalIncurred).ToString("C0"), "bi-currency-dollar", "green", "All", "Open queue exposure", "Show all active follow-ups")
    ];

    private IEnumerable<WorkflowLane> WorkflowLanes =>
    [
        new("Triage", "Overdue & urgent", "bi-exclamation-octagon", "Overdue", "queue", OverdueClaims.Count + _claims.Count(IsHighPriority), "Critical touchpoints", "Triage overdue and urgent work"),
        new("Today", "Daily desk", "bi-calendar-check", "Today", "queue", DueTodayClaims.Count, "Claims due today", "Focus today's claim follow-ups"),
        new("Carrier", "Carrier status", "bi-building", "Carrier", "cards", _claims.Count(c => FollowUpReason(c).Contains("Carrier", StringComparison.OrdinalIgnoreCase) || FollowUpReason(c).Contains("Payment", StringComparison.OrdinalIgnoreCase)), "Adjuster dependencies", "Show carrier-driven follow-ups"),
        new("Legal", "Litigation", "bi-gavel", "Litigation", "handlers", _claims.Count(c => c.IsLitigation), "Attorney-managed claims", "Show litigation follow-ups by handler"),
        new("Analytics", "Workload health", "bi-bar-chart", "All", "analytics", _claims.Count, "Queue metrics", "Review follow-up analytics")
    ];

    private string ActiveViewTitle => _activeTab switch { "cards" => "Follow-up cards", "handlers" => "Handler workload", "analytics" => "Queue analytics", _ => "Prioritized follow-up queue" };
    private string ActiveViewSubtitle => _activeTab switch { "cards" => "Card view optimized for desk review and quick action.", "handlers" => "Capacity, overdue work, and exposure grouped by assigned handler.", "analytics" => "Operational signals ranked by importance for tenant claim administration.", _ => "Native table with claim, loss, due date, priority, handler, and action workflow." };

    protected override async Task OnInitializedAsync()
    {
        _userContext = await CurrentUser.RequireAsync();
        _tenantId = _userContext.TenantId;
        _tenantAdminUserId = _userContext.UserId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Claims", "/claims"), new("Follow-Up", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchClaimsAsync(_tenantId, pageSize: 500);
            _claims.Clear();
            _claims.AddRange((result?.Items ?? []).Where(c => !IsClosed(c)).OrderByDescending(IsOverdue).ThenBy(DueDate).ThenByDescending(SeverityScore));
            _selected = _claims.Contains(_selected) ? _selected : _claims.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            await ShowToast($"Load failed: {ex.Message}", true);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        await LoadAsync();
        if (string.IsNullOrWhiteSpace(_loadError))
        {
            await ShowToast("Follow-up queue refreshed.");
        }
    }

    private bool MatchesFilters(ClaimDto claim)
    {
        var searchMatch = string.IsNullOrWhiteSpace(_search) || Contains(claim.ClaimNumber, _search) || Contains(claim.PolicyNumber, _search) || Contains(claim.AccountName, _search) || Contains(claim.PrimaryClaimant, _search) || Contains(claim.Carrier, _search) || Contains(claim.AssignedHandler, _search) || Contains(FollowUpReason(claim), _search);
        return searchMatch
            && MatchesKpi(claim)
            && (string.IsNullOrWhiteSpace(_handlerFilter) || string.Equals(DisplayValue(claim.AssignedHandler, "Unassigned"), _handlerFilter, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrWhiteSpace(_reasonFilter) || string.Equals(FollowUpReason(claim), _reasonFilter, StringComparison.OrdinalIgnoreCase))
            && (string.IsNullOrWhiteSpace(_priorityFilter) || string.Equals(PriorityLabel(claim), _priorityFilter, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesKpi(ClaimDto claim) => _kpiFilter switch
    {
        "Overdue" => IsOverdue(claim),
        "Today" => DueDate(claim).Date == DateTime.Today && !IsOverdue(claim),
        "Week" => DueDate(claim).Date > DateTime.Today && DueDate(claim).Date <= DateTime.Today.AddDays(7),
        "Severity" => SeverityScore(claim) >= 4 || IsHighPriority(claim),
        "Litigation" => claim.IsLitigation,
        "Carrier" => FollowUpReason(claim).Contains("Carrier", StringComparison.OrdinalIgnoreCase) || FollowUpReason(claim).Contains("Payment", StringComparison.OrdinalIgnoreCase),
        "CAT" => claim.IsCatastrophe,
        "Snoozed" => claim.IsSnoozed,
        _ => true
    };

    private void ApplyKpi(KpiTile kpi) => _kpiFilter = _kpiFilter == kpi.Filter ? "All" : kpi.Filter;
    private void ApplyWorkflow(WorkflowLane lane) { _kpiFilter = lane.Filter; _activeTab = lane.Tab; }
    private void SelectTab(string tab) => _activeTab = tab;
    private void SelectClaim(ClaimDto claim) => _selected = claim;
    private void ResetFilters() { _search = string.Empty; _handlerFilter = string.Empty; _reasonFilter = string.Empty; _priorityFilter = string.Empty; _kpiFilter = "All"; }
    private void OpenClaim(ClaimDto claim) => Nav.NavigateTo($"/claims/{claim.ClaimId}");

    private void OpenSnoozeDialog(ClaimDto claim)
    {
        _snoozeTarget = claim;
        _snoozeForm = new SnoozeForm { SnoozeUntil = DueDate(claim).Date <= DateTime.Today ? DateTime.Today.AddDays(3) : DueDate(claim).AddDays(3), Reason = "Scheduled follow-up" };
        _showSnoozeDialog = true;
    }

    private void CloseSnoozeDialog() => _showSnoozeDialog = false;

    private void OpenActionDialog(ClaimDto claim)
    {
        _actionTarget = claim;
        _actionForm = new ActionForm { NextFollowUp = DateTime.Today.AddDays(7), Priority = PriorityLabel(claim) };
        _showActionDialog = true;
    }

    private void CloseActionDialog() => _showActionDialog = false;

    private async Task ConfirmSnoozeAsync()
    {
        if (_snoozeTarget is null) return;
        _savingSnooze = true;
        try
        {
            await Api.UpdateClaimFollowUpAsync(_snoozeTarget.ClaimId, new UpdateClaimFollowUpRequest
            {
                FollowUpReason = _snoozeForm.Reason,
                FollowUpDueDate = _snoozeForm.SnoozeUntil,
                IsSnoozed = true,
                ModifiedByUserId = _tenantAdminUserId
            });
            await Api.AddClaimActivityAsync(new CreateClaimActivityRequest
            {
                ClaimId = _snoozeTarget.ClaimId,
                ActivityType = "FollowUp",
                Title = "Follow-up snoozed",
                Category = _snoozeForm.Reason,
                Notes = _snoozeForm.Notes ?? string.Empty,
                ActivityDate = DateTime.UtcNow,
                CreatedBy = CurrentUserName
            });
            _showSnoozeDialog = false;
            await LoadAsync();
            await ShowToast($"{_snoozeTarget.ClaimNumber} snoozed until {_snoozeForm.SnoozeUntil:MM/dd/yyyy}.");
        }
        catch (Exception ex)
        {
            await ShowToast($"Snooze failed: {ex.Message}", true);
        }
        finally
        {
            _savingSnooze = false;
        }
    }

    private async Task ConfirmActionAsync()
    {
        if (_actionTarget is null) return;
        _savingAction = true;
        try
        {
            await Api.AddClaimActivityAsync(new CreateClaimActivityRequest
            {
                ClaimId = _actionTarget.ClaimId,
                ActivityType = "FollowUp",
                Title = _actionForm.ActionTaken,
                Category = _actionForm.Outcome,
                Notes = _actionForm.Notes ?? string.Empty,
                ActivityDate = DateTime.UtcNow,
                CreatedBy = CurrentUserName,
                IsPinned = IsHighPriority(_actionTarget) || _actionTarget.IsLitigation
            });
            await Api.UpdateClaimFollowUpAsync(_actionTarget.ClaimId, new UpdateClaimFollowUpRequest
            {
                FollowUpReason = _actionForm.Outcome,
                Priority = _actionForm.Priority,
                FollowUpDueDate = _actionForm.NextFollowUp,
                IsSnoozed = false,
                ModifiedByUserId = _tenantAdminUserId
            });
            _showActionDialog = false;
            await LoadAsync();
            await ShowToast($"Action logged for {_actionTarget.ClaimNumber}.");
        }
        catch (Exception ex)
        {
            await ShowToast($"Save action failed: {ex.Message}", true);
        }
        finally
        {
            _savingAction = false;
        }
    }

    private async Task ExportAsync()
    {
        try
        {
            var rows = FilteredClaims;
            var csv = new StringBuilder();
            csv.AppendLine("ClaimNumber,PolicyNumber,AccountName,Status,Lob,Carrier,LossType,Claimant,FollowUpReason,DueDate,Priority,DaysOpen,TotalIncurred,Handler,Flags");
            foreach (var c in rows)
            {
                csv.AppendLine(string.Join(',', Csv(c.ClaimNumber), Csv(c.PolicyNumber), Csv(c.AccountName), Csv(c.Status), Csv(c.Lob), Csv(c.Carrier), Csv(c.LossType), Csv(c.PrimaryClaimant), Csv(FollowUpReason(c)), Csv(DueDate(c).ToString("yyyy-MM-dd")), Csv(PriorityLabel(c)), c.DaysOpen, c.TotalIncurred, Csv(DisplayValue(c.AssignedHandler, "Unassigned")), Csv(FlagSummary(c))));
            }
            var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(csv.ToString()));
            var script = $"(() => {{ const a = document.createElement(\"a\"); a.href = \"data:text/csv;base64,{base64}\"; a.download = \"claims-follow-up-queue.csv\"; document.body.appendChild(a); a.click(); a.remove(); }})()";
            await Js.InvokeVoidAsync("eval", script);
            await ShowToast($"Exported {rows.Count:N0} follow-up item(s).");
        }
        catch (Exception ex)
        {
            await ShowToast($"Export failed: {ex.Message}", true);
        }
    }

    private async Task NotifyInvalidSnoozeAsync() => await ShowToast("Please fix snooze validation errors before saving.", true);
    private async Task NotifyInvalidActionAsync() => await ShowToast("Please fix action validation errors before saving.", true);

    private string CurrentUserName => DisplayValue(_userContext?.TenantName, "Tenant user");
    private string TabClass(string key) => _activeTab == key ? "fq-view-btn fq-view-btn-active" : "fq-view-btn";
    private string KpiClass(KpiTile kpi) => _kpiFilter == kpi.Filter ? $"fq-kpi-card fq-{kpi.Tone} fq-kpi-card-active" : $"fq-kpi-card fq-{kpi.Tone}";
    private string WorkflowClass(WorkflowLane lane) => _kpiFilter == lane.Filter && _activeTab == lane.Tab ? "fq-workflow-card fq-active" : "fq-workflow-card";
    private string QueueCardClass(ClaimDto claim) => _selected?.ClaimId == claim.ClaimId ? $"fq-queue-card fq-queue-card-active {RowClass(claim)}" : $"fq-queue-card {RowClass(claim)}";
    private static string RowClass(ClaimDto claim) => IsOverdue(claim) ? "fq-row-overdue" : DueDate(claim).Date == DateTime.Today ? "fq-row-today" : SeverityScore(claim) >= 4 ? "fq-row-high" : string.Empty;
    private static string HandlerRowClass(ClaimDto claim) => $"fq-handler-row {RowClass(claim)}";
    private static string StatusClass(string status) => $"fq-status fq-stage-{CssToken(status)}";
    private static string PriorityClass(ClaimDto claim) => $"fq-priority fq-priority-{CssToken(PriorityLabel(claim))}";
    private static string ReasonClass(ClaimDto claim) => $"fq-reason fq-reason-{ReasonCss(FollowUpReason(claim))}";
    private static string DueTextClass(ClaimDto claim) => IsOverdue(claim) ? "fq-due-overdue" : DueDate(claim).Date == DateTime.Today ? "fq-due-today" : "";
    private static string DueLabel(ClaimDto claim) => IsOverdue(claim) ? $"{(DateTime.Today - DueDate(claim).Date).Days:N0}d overdue" : DueDate(claim).Date == DateTime.Today ? "Due today" : $"Due in {(DueDate(claim).Date - DateTime.Today).Days:N0}d";
    private static DateTime DueDate(ClaimDto claim) => (claim.FollowUpDueDate ?? claim.DateReported.AddDays(IsHighPriority(claim) ? 2 : 7)).Date;
    private static bool IsOverdue(ClaimDto claim) => DueDate(claim) < DateTime.Today;
    private static bool IsClosed(ClaimDto claim) => string.Equals(claim.Status, "Closed", StringComparison.OrdinalIgnoreCase) || string.Equals(claim.Status, "Denied", StringComparison.OrdinalIgnoreCase);
    private static bool IsHighPriority(ClaimDto claim) => PriorityLabel(claim) is "Urgent" or "Critical" or "High";
    private static string PriorityLabel(ClaimDto claim) => string.IsNullOrWhiteSpace(claim.Priority) ? (SeverityScore(claim) >= 4 ? "High" : "Medium") : claim.Priority;
    private static string FollowUpReason(ClaimDto claim) => !string.IsNullOrWhiteSpace(claim.FollowUpReason) ? claim.FollowUpReason : claim.IsLitigation ? "Litigation Update" : claim.IsCatastrophe ? "CAT Field Inspection" : claim.HasSubrogation ? "Subrogation Action" : claim.TotalIncurred >= 100000 ? "Reserve Review Due" : "Carrier Status Check";
    private static int SeverityScore(ClaimDto claim) => (claim.TotalIncurred >= 250000 ? 2 : claim.TotalIncurred >= 100000 ? 1 : 0) + (claim.IsLitigation ? 2 : 0) + (claim.IsDisputed ? 1 : 0) + (claim.IsCatastrophe ? 1 : 0) + (claim.DaysOpen >= 120 && !IsClosed(claim) ? 1 : 0);
    private static bool Contains(string? value, string search) => !string.IsNullOrWhiteSpace(value) && value.Contains(search, StringComparison.OrdinalIgnoreCase);
    private static string DisplayValue(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static string FlagSummary(ClaimDto claim) => string.Join(" / ", new[] { claim.IsLitigation ? "Litigation" : null, claim.HasSubrogation ? "Subrogation" : null, claim.IsCatastrophe ? "CAT" : null, claim.IsDisputed ? "Disputed" : null }.Where(v => !string.IsNullOrWhiteSpace(v)).DefaultIfEmpty("No flags"));
    private static string Initial(string value) => string.IsNullOrWhiteSpace(value) ? "?" : value.Trim()[0].ToString().ToUpperInvariant();
    private static string CssToken(string value) => string.IsNullOrWhiteSpace(value) ? "none" : value.ToLowerInvariant().Replace(" ", "-").Replace("/", "-");
    private static string Csv(string? value) => "\"" + (value ?? string.Empty).Replace("\"", "\"\"") + "\"";

    private static string ReasonCss(string reason) => reason switch
    {
        "Litigation Update" or "Settlement Negotiation" or "Attorney Contact" => "lit",
        "Reserve Review Due" or "Coverage Decision Pending" => "cov",
        "Medical Records Pending" or "IME Scheduled" => "med",
        "Carrier Status Check" or "Payment Confirmation" or "Waiting on carrier" => "car",
        "CAT Field Inspection" or "Investigation Update" => "cat",
        "Subrogation Action" => "sub",
        _ => "gen"
    };

    private static RenderFragment Metric(string label, string value, string icon) => builder =>
    {
        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class", "fq-metric");
        builder.OpenElement(2, "i");
        builder.AddAttribute(3, "class", $"bi {icon}");
        builder.AddAttribute(4, "aria-hidden", "true");
        builder.CloseElement();
        builder.OpenElement(5, "span");
        builder.AddContent(6, label);
        builder.CloseElement();
        builder.OpenElement(7, "strong");
        builder.AddContent(8, value);
        builder.CloseElement();
        builder.CloseElement();
    };

    private static RenderFragment FlagChip(bool active, string label, string icon) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", active ? "fq-flag-chip fq-flag-chip-active" : "fq-flag-chip");
        builder.OpenElement(2, "i");
        builder.AddAttribute(3, "class", $"bi {icon}");
        builder.AddAttribute(4, "aria-hidden", "true");
        builder.CloseElement();
        builder.AddContent(5, label);
        builder.CloseElement();
    };

    private async Task ShowToast(string content, bool danger = false)
    {
        var toast = new FollowToast(Guid.NewGuid(), content, danger ? "fq-toast-danger" : "fq-toast-success", danger ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill");
        _toasts.Add(toast);
        await InvokeAsync(StateHasChanged);
        _ = Task.Run(async () =>
        {
            await Task.Delay(4500);
            await InvokeAsync(() => DismissToast(toast.Id));
        });
    }

    private void DismissToast(Guid id)
    {
        _toasts.RemoveAll(t => t.Id == id);
        StateHasChanged();
    }

    private sealed class SnoozeForm
    {
        [Required] public DateTime? SnoozeUntil { get; set; } = DateTime.Today.AddDays(3);
        [Required, StringLength(120)] public string Reason { get; set; } = string.Empty;
        [StringLength(2000)] public string? Notes { get; set; }
    }

    private sealed class ActionForm
    {
        [Required, StringLength(120)] public string ActionTaken { get; set; } = string.Empty;
        [Required, StringLength(120)] public string Outcome { get; set; } = string.Empty;
        public DateTime? NextFollowUp { get; set; } = DateTime.Today.AddDays(7);
        [StringLength(40)] public string Priority { get; set; } = "Medium";
        [StringLength(2000)] public string? Notes { get; set; }
    }

    private sealed record FollowToast(Guid Id, string Content, string CssClass, string Icon);
    private sealed record KpiTile(string Label, string Value, string Icon, string Tone, string Filter, string Detail, string Title);
    private sealed record WorkflowLane(string Label, string Detail, string Icon, string Filter, string Tab, int Count, string Subtitle, string Title);
    private sealed record HandlerGroup(string Handler, List<ClaimDto> Items, int Overdue, decimal TotalIncurred);
}
