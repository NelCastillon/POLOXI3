@page "/billing/modes"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Direct Bill / Agency Bill Dashboard - AMS</PageTitle>

<AppPageHeader Title="Direct Bill &amp; Agency Bill Dashboard"
               Subtitle="Monitor billing mode distribution, remittance schedules, and carrier payment flows across the book"
               Icon="bi-diagram-3">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/billing/accounts")'>
            <i class="bi bi-building" aria-hidden="true"></i> Billing Accounts
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/billing/reconciliation")'>
            <i class="bi bi-ui-checks-grid" aria-hidden="true"></i> Reconciliation
        </button>
    </Actions>
</AppPageHeader>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        @_loadError
    </div>
}

<!-- Mode selector -->
<div class="bm-mode-selector">
    <button class="bm-mode-btn @(_activeMode=="all"?"bm-mode-active":"")" @onclick='()=>_activeMode="all"'>
        <i class="bi bi-grid-3x2-gap" aria-hidden="true"></i> All Modes
    </button>
    <button class="bm-mode-btn @(_activeMode=="direct"?"bm-mode-active":"")" @onclick='()=>_activeMode="direct"'>
        <i class="bi bi-building" aria-hidden="true"></i> Direct Bill
        <span class="bm-cnt">@_accounts.Count(x=>x.Mode=="Direct Bill")</span>
    </button>
    <button class="bm-mode-btn @(_activeMode=="agency"?"bm-mode-active":"")" @onclick='()=>_activeMode="agency"'>
        <i class="bi bi-diagram-3" aria-hidden="true"></i> Agency Bill
        <span class="bm-cnt">@_accounts.Count(x=>x.Mode=="Agency Bill")</span>
    </button>
    <button class="bm-mode-btn @(_activeMode=="eft"?"bm-mode-active":"")" @onclick='()=>_activeMode="eft"'>
        <i class="bi bi-arrow-repeat" aria-hidden="true"></i> EFT / ACH
        <span class="bm-cnt">@_accounts.Count(x=>x.Mode=="EFT")</span>
    </button>
</div>

<!-- Summary cards -->
<div class="bm-summary-grid">
    <!-- Direct Bill card -->
    <div class="bm-card bm-card-direct">
        <div class="bm-card-header">
            <i class="bi bi-building" aria-hidden="true"></i> Direct Bill
        </div>
        <div class="bm-card-body">
            <div class="bm-card-stat"><span class="bm-stat-v">@_accounts.Count(x=>x.Mode=="Direct Bill")</span><span class="bm-stat-l">Accounts</span></div>
            <div class="bm-card-stat"><span class="bm-stat-v">@Fmt(_accounts.Where(x=>x.Mode=="Direct Bill").Sum(x=>x.BilledAmount))</span><span class="bm-stat-l">Billed Premium</span></div>
            <div class="bm-card-stat"><span class="bm-stat-v">@Fmt(_accounts.Where(x=>x.Mode=="Direct Bill").Sum(x=>x.Outstanding))</span><span class="bm-stat-l">Outstanding</span></div>
            <div class="bm-card-stat"><span class="bm-stat-v">@_accounts.Count(x=>x.Mode=="Direct Bill" && x.Delinquent)</span><span class="bm-stat-l">Delinquent</span></div>
        </div>
        <div class="bm-card-footer">
            <span class="bm-pill bm-pill-blue">Carrier collects directly from insured</span>
        </div>
    </div>

    <!-- Agency Bill card -->
    <div class="bm-card bm-card-agency">
        <div class="bm-card-header">
            <i class="bi bi-diagram-3" aria-hidden="true"></i> Agency Bill
        </div>
        <div class="bm-card-body">
            <div class="bm-card-stat"><span class="bm-stat-v">@_accounts.Count(x=>x.Mode=="Agency Bill")</span><span class="bm-stat-l">Accounts</span></div>
            <div class="bm-card-stat"><span class="bm-stat-v">@Fmt(_accounts.Where(x=>x.Mode=="Agency Bill").Sum(x=>x.BilledAmount))</span><span class="bm-stat-l">Billed Premium</span></div>
            <div class="bm-card-stat"><span class="bm-stat-v">@Fmt(_accounts.Where(x=>x.Mode=="Agency Bill").Sum(x=>x.Outstanding))</span><span class="bm-stat-l">Remittance Due</span></div>
            <div class="bm-card-stat"><span class="bm-stat-v">@(_nextRemittance?.ToString("MMM d") ?? "Not scheduled")</span><span class="bm-stat-l">Next Remittance</span></div>
        </div>
        <div class="bm-card-footer">
            <span class="bm-pill bm-pill-purple">Agency invoices and remits to carrier</span>
        </div>
    </div>

    <!-- EFT card -->
    <div class="bm-card bm-card-eft">
        <div class="bm-card-header">
            <i class="bi bi-arrow-repeat" aria-hidden="true"></i> EFT / ACH
        </div>
        <div class="bm-card-body">
            <div class="bm-card-stat"><span class="bm-stat-v">@_accounts.Count(x=>x.Mode=="EFT")</span><span class="bm-stat-l">Accounts</span></div>
            <div class="bm-card-stat"><span class="bm-stat-v">@Fmt(_accounts.Where(x=>x.Mode=="EFT").Sum(x=>x.BilledAmount))</span><span class="bm-stat-l">Billed Premium</span></div>
            <div class="bm-card-stat"><span class="bm-stat-v">@_accounts.Count(x=>x.Mode=="EFT" && x.AutopayEnrolled)</span><span class="bm-stat-l">Autopay Active</span></div>
            <div class="bm-card-stat"><span class="bm-stat-v">@_accounts.Count(x=>x.Mode=="EFT" && x.Delinquent)</span><span class="bm-stat-l">NSF / Failed</span></div>
        </div>
        <div class="bm-card-footer">
            <span class="bm-pill bm-pill-green">Automated electronic funds transfer</span>
        </div>
    </div>
</div>

<!-- Distribution chart (visual bar) -->
<div class="bm-dist-section">
    <div class="bm-dist-title">Billed Premium Distribution by Billing Mode</div>
    <div class="bm-dist-bar-wrap">
        @{ var total = _accounts.Sum(x=>(double)x.BilledAmount); }
        <div class="bm-dist-seg bm-seg-direct"  style="flex:@_accounts.Where(x=>x.Mode=="Direct Bill").Sum(x=>(double)x.BilledAmount)" title="Direct Bill">Direct Bill</div>
        <div class="bm-dist-seg bm-seg-agency"  style="flex:@_accounts.Where(x=>x.Mode=="Agency Bill").Sum(x=>(double)x.BilledAmount)" title="Agency Bill">Agency Bill</div>
        <div class="bm-dist-seg bm-seg-eft"     style="flex:@_accounts.Where(x=>x.Mode=="EFT").Sum(x=>(double)x.BilledAmount)"        title="EFT">EFT</div>
    </div>
    <div class="bm-dist-legend">
        <span class="bm-leg-dot bm-ld-direct" aria-hidden="true"></span> Direct Bill (@ModePercent("Direct Bill", total)%)
        &nbsp;&nbsp;
        <span class="bm-leg-dot bm-ld-agency" aria-hidden="true"></span> Agency Bill (@ModePercent("Agency Bill", total)%)
        &nbsp;&nbsp;
        <span class="bm-leg-dot bm-ld-eft"    aria-hidden="true"></span> EFT (@ModePercent("EFT", total)%)
    </div>
</div>

<!-- Remittance schedule -->
<div class="bm-rem-section">
    <div class="bm-rem-title"><i class="bi bi-calendar-range" aria-hidden="true"></i> Agency Bill Remittance Schedule</div>
    @if (_loading)
    {
        <div class="alert alert-info" role="status"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Loading billing mode data...</div>
    }
    else
    {
    <SfGrid DataSource="FilteredAccounts" AllowSorting="true" AllowPaging="true" Height="380px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(BillingModeRow.AccountName)" HeaderText="Account" Width="200"></GridColumn>
            <GridColumn HeaderText="Mode" Width="120">
                <Template>
                    @{ var r = (BillingModeRow)context; }
                    <span class="bm-mode-chip bm-mc-@r.Mode.ToLower().Replace(" ","-")">@r.Mode</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(BillingModeRow.BilledAmount)" HeaderText="Billed Premium" Format="C2" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
            <GridColumn Field="@nameof(BillingModeRow.Outstanding)" HeaderText="Outstanding" Format="C2" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
            <GridColumn Field="@nameof(BillingModeRow.RemittanceDue)" HeaderText="Remittance Due" Type="ColumnType.Date" Format="d" Width="140"></GridColumn>
            <GridColumn HeaderText="Autopay" Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                <Template>
                    @{ var r2 = (BillingModeRow)context; }
                    @if (r2.AutopayEnrolled) { <i class="bi bi-check-circle-fill" style="color:#059669" aria-hidden="true"></i> }
                    else { <i class="bi bi-dash-circle" style="color:#cbd5e1" aria-hidden="true"></i> }
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Status" Width="120">
                <Template>
                    @{ var r3 = (BillingModeRow)context; }
                    <span class="bm-acct-status bm-as-@(r3.Delinquent?"delinquent":"active")">@(r3.Delinquent?"Delinquent":"Active")</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Actions" Width="110">
                <Template>
                    @{ var r4 = (BillingModeRow)context; }
                    <div style="display:flex;gap:.2rem">
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => Nav.NavigateTo($"/billing/accounts/{r4.Id}")' title="Open account">
                            <i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>
                        </button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
    }
</div>

@code {
    private string _activeMode = "all";
    private Guid _tenantId;
    private bool _loading = true;
    private string? _loadError;

    private List<BillingModeRow> _accounts = [];

    private DateTime? _nextRemittance => _accounts.Where(x => x.Mode == "Agency Bill" && x.RemittanceDue.HasValue)
        .Select(x => x.RemittanceDue!.Value)
        .Cast<DateTime?>()
        .Min();

    private IEnumerable<BillingModeRow> FilteredAccounts => _accounts.Where(a =>
        _activeMode == "all" ||
        (_activeMode == "direct" && a.Mode == "Direct Bill") ||
        (_activeMode == "agency" && a.Mode == "Agency Bill") ||
        (_activeMode == "eft"    && a.Mode == "EFT"));

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Billing","/billing/accounts"), new("Billing Modes",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            var context = await CurrentUser.RequireAsync();
            _tenantId = context.TenantId;

            await Api.EnsureBillingAccountsSeedAsync(_tenantId);
            var result = await Api.GetBillingModeDashboardAsync(_tenantId);
            _accounts = result?.Select(ToRow).ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load billing modes: {ex.Message}";
            _accounts = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Fmt(decimal v) => v.ToString("C0");

    private int ModePercent(string mode, double total)
        => total <= 0 ? 0 : (int)(_accounts.Where(x => x.Mode == mode).Sum(x => (double)x.BilledAmount) / total * 100);

    private static BillingModeRow ToRow(BillingModeDashboardRowDto account)
    {
        var mode = string.IsNullOrWhiteSpace(account.BillingModeCode) ? "Unassigned" : account.BillingModeCode;
        return new(
            account.AccountId,
            account.AccountName,
            mode,
            account.BilledAmount,
            account.OutstandingAmount,
            account.NextRemittanceDueDate,
            account.AutopayEnrolled,
            string.Equals(account.StatusCode, "Delinquent", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(account.StatusCode, "Suspended", StringComparison.OrdinalIgnoreCase));
    }

    private sealed record BillingModeRow(Guid Id, string AccountName, string Mode, decimal BilledAmount, decimal Outstanding,
        DateTime? RemittanceDue, bool AutopayEnrolled, bool Delinquent);
}
