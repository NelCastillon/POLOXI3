@page "/tenant/communications/email2"
@page "/tenant/communications/sms2"
@page "/tenant/communications/templates2"
@page "/tenant/communications/rules2"
@page "/tenant/communications/appts2"
@page "/tenant/communications/consent2"
@page "/tenant/communications/senders2"
@page "/tenant/communications/audit2"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Communications Setup - AMS</PageTitle>

<AppPageHeader Title="Communications Setup"
               Subtitle="Tenant admin control center for email, SMS, message templates, notification rules, appointment settings, consent, sender profiles, and communication audit"
               Icon="bi-chat-square-dots-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/tenant/communications/email")'>
            <i class="bi bi-envelope-gear" aria-hidden="true"></i> Email Settings
        </button>
    </Actions>
</AppPageHeader>

<section class="comcfg-hero" aria-label="Communications setup overview">
    <div>
        <span class="comcfg-eyebrow">Tenant administration</span>
        <h2>Communications Setup Workflow</h2>
        <p>Configure tenant communications across email delivery, SMS provider policy, message templates, notification routing, appointment automation, consent, sender identity, and audit evidence.</p>
    </div>
    <div class="comcfg-hero-grid">
        @foreach (var action in _quickActions)
        {
            <button class="comcfg-quick-action" @onclick="() => Nav.NavigateTo(action.Url)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
</section>

<section class="comcfg-kpi-grid" aria-label="Communications setup metrics">
    @Kpi("Email Health", "98.7%", "Delivery success", "bi-envelope-check", "comcfg-tone-green")
    @Kpi("SMS Consent", "94%", "Marketable mobile contacts", "bi-toggle-on", "comcfg-tone-blue")
    @Kpi("Templates", "56", "Approved messages", "bi-layout-text-sidebar", "comcfg-tone-violet")
    @Kpi("Audit Items", "13", "Need admin review", "bi-journal-text", "comcfg-tone-red")
</section>

<section class="comcfg-command-bar" aria-label="Communications setup filters">
    <div class="comcfg-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search"
               placeholder="Search communications setup, owner, control, module..."
               @bind="_search"
               @bind:event="oninput" />
    </div>
    <div class="comcfg-pill-group" role="group" aria-label="Communications workflow filter">
        @foreach (var filter in _filters)
        {
            <button class="comcfg-pill @(_filter == filter.Key ? "comcfg-pill--active" : "")"
                    @onclick="() => _filter = filter.Key">
                @filter.Label
                <span>@FilterCount(filter.Key)</span>
            </button>
        }
    </div>
</section>

<section class="comcfg-layout">
    <div class="comcfg-flow" aria-label="Communications setup workflow lanes">
        @foreach (var lane in _lanes)
        {
            var laneItems = FilteredWorkflow.Where(x => x.Stage == lane.Key).ToList();
            <article class="comcfg-lane">
                <header class="comcfg-lane-header">
                    <div>
                        <span class="comcfg-lane-title">@lane.Label</span>
                        <span class="comcfg-lane-subtitle">@lane.Description</span>
                    </div>
                    <span class="comcfg-lane-count">@laneItems.Count</span>
                </header>

                <div class="comcfg-lane-list">
                    @if (laneItems.Count == 0)
                    {
                        <div class="comcfg-empty-mini">No visible workflow items.</div>
                    }
                    else
                    {
                        @foreach (var item in laneItems)
                        {
                            <button class="comcfg-work-card @(item.Risk == "High" ? "comcfg-work-card--risk" : "")"
                                    @onclick="() => _selected = item">
                                <div class="comcfg-work-topline">
                                    <span class="comcfg-chip @ToneCss(item.Domain)">@item.Domain</span>
                                    <span class="comcfg-status @RiskCss(item.Risk)">@item.Risk</span>
                                </div>
                                <strong>@item.Title</strong>
                                <p>@item.Summary</p>
                                <div class="comcfg-work-meta">
                                    <span><i class="bi bi-person" aria-hidden="true"></i> @item.Owner</span>
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> @item.Sla</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            </article>
        }
    </div>

    <aside class="comcfg-admin-panel" aria-label="Tenant communications administration controls">
        @if (_selected is null)
        {
            <div class="comcfg-side-empty">
                <i class="bi bi-chat-square-dots-fill" aria-hidden="true"></i>
                <h3>Communication governance</h3>
                <p>Select a workflow item to inspect owner, SLA, risk, communication control, and setup module.</p>
            </div>
        }
        else
        {
            <div class="comcfg-detail-header">
                <span class="comcfg-chip @ToneCss(_selected.Domain)">@_selected.Domain</span>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close details">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h3>@_selected.Title</h3>
            <p>@_selected.Summary</p>

            <dl class="comcfg-detail-list">
                <div><dt>Owner</dt><dd>@_selected.Owner</dd></div>
                <div><dt>Stage</dt><dd>@_selected.Stage</dd></div>
                <div><dt>Risk</dt><dd><span class="comcfg-status @RiskCss(_selected.Risk)">@_selected.Risk</span></dd></div>
                <div><dt>SLA</dt><dd>@_selected.Sla</dd></div>
                <div><dt>Control</dt><dd>@_selected.Control</dd></div>
            </dl>

            <div class="comcfg-policy-card">
                <strong>Tenant communication controls</strong>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Email, SMS, sender, and provider health governed</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Message templates, notifications, appointments, and consent auditable</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Opt-out enforcement, routing, and audit evidence retained</span>
            </div>

            <div class="comcfg-detail-actions">
                <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selected.Url)">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Module
                </button>
                <button class="um-btn um-btn-ghost" @onclick="() => Advance(_selected)">
                    <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Advance
                </button>
            </div>
        }
    </aside>
</section>

<section class="comcfg-module-grid" aria-label="Communications setup modules">
    @foreach (var module in _modules)
    {
        <button class="comcfg-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
            <span class="comcfg-module-icon @ToneCss(module.Domain)"><i class="bi @module.Icon" aria-hidden="true"></i></span>
            <span class="comcfg-module-content">
                <strong>@module.Title</strong>
                <small>@module.Description</small>
            </span>
            <i class="bi bi-chevron-right comcfg-module-arrow" aria-hidden="true"></i>
        </button>
    }
</section>

@code {
    private string _search = string.Empty;
    private string _filter = string.Empty;
    private CommunicationWorkflowItem? _selected;
    private readonly List<CommunicationWorkflowItem> _workflow = [];

    private readonly Lane[] _lanes =
    [
        new("Connect", "Connect", "Providers and senders"),
        new("Author", "Author", "Templates and content"),
        new("Route", "Route", "Notifications and appointments"),
        new("Comply", "Comply", "Consent and opt-outs"),
        new("Audit", "Audit", "Logs and evidence")
    ];

    private readonly Filter[] _filters =
    [
        new("", "All"),
        new("risk", "High Risk"),
        new("templates", "Templates"),
        new("consent", "Consent"),
        new("audit", "Audit")
    ];

    private readonly CommunicationModule[] _modules =
    [
        new("Email Settings", "Configure email provider, authenticated domains, bounce handling, suppression, and delivery health.", "/tenant/communications/email", "bi-envelope-gear", "Email"),
        new("SMS Settings", "Manage SMS provider, throughput, consent enforcement, opt-out callbacks, and delivery windows.", "/tenant/communications/sms", "bi-phone-vibrate", "SMS"),
        new("Message Templates", "Create and approve email, SMS, notification, and appointment templates with merge fields.", "/tenant/communications/templates", "bi-layout-text-sidebar", "Templates"),
        new("Notification Rules", "Control event routing, recipient rules, escalation paths, digest schedules, and channel policy.", "/tenant/communications/rules", "bi-bell-gear", "Notifications"),
        new("Appointment Settings", "Configure scheduling links, reminders, no-show rules, calendar sync, and confirmation flows.", "/tenant/communications/appts", "bi-calendar-event", "Appointments"),
        new("Opt-In / Opt-Out", "Govern channel consent, suppression lists, unsubscribe handling, and compliance evidence.", "/tenant/communications/consent", "bi-toggle-on", "Consent"),
        new("Sender Profiles", "Manage agency, branch, producer, support, and system sender identities and signatures.", "/tenant/communications/senders", "bi-person-check", "Senders"),
        new("Communication Audit", "Review delivery logs, consent history, template approvals, rule changes, and outbound events.", "/tenant/communications/audit", "bi-journal-text", "Audit")
    ];

    private readonly CommunicationModule[] _quickActions =
    [
        new("Email", "", "/tenant/communications/email", "bi-envelope-gear", "Email"),
        new("SMS", "", "/tenant/communications/sms", "bi-phone-vibrate", "SMS"),
        new("Templates", "", "/tenant/communications/templates", "bi-layout-text-sidebar", "Templates"),
        new("Audit", "", "/tenant/communications/audit", "bi-journal-text", "Audit")
    ];

    private IEnumerable<CommunicationWorkflowItem> FilteredWorkflow => _workflow.Where(item =>
        (string.IsNullOrWhiteSpace(_filter) || _filter switch
        {
            "risk" => item.Risk == "High",
            "templates" => item.Domain == "Templates",
            "consent" => item.Domain == "Consent",
            "audit" => item.Domain == "Audit",
            _ => true
        }) &&
        (string.IsNullOrWhiteSpace(_search) ||
         item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Domain.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Control.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(x => x.Risk == "High")
        .ThenBy(x => x.Stage)
        .ThenBy(x => x.Title);

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Communications Setup", "/tenant/communications/email"));
        BuildWorkflow();
        _selected = _workflow.FirstOrDefault(x => x.Risk == "High") ?? _workflow.FirstOrDefault();
    }

    private void BuildWorkflow()
    {
        _workflow.Clear();
        _workflow.AddRange(
        [
            new("Email domain authentication", "Primary sender domain requires DKIM and SPF verification after DNS update.", "Email", "High", "Connect", "Diana Perez", "Today", "Email authentication", "/tenant/communications/email"),
            new("SMS provider callback validation", "SMS opt-out callback delivery needs retry and signature validation before rollout.", "SMS", "High", "Connect", "Kevin Obi", "24h", "SMS callback control", "/tenant/communications/sms"),
            new("Sender profile refresh", "Branch and producer sender signatures need standardization for outbound service messages.", "Senders", "Medium", "Connect", "Sarah Kim", "This week", "Sender identity governance", "/tenant/communications/senders"),
            new("Renewal message template approval", "Renewal reminder template v5 requires compliance approval and merge-field validation.", "Templates", "High", "Author", "James Park", "48h", "Template approval", "/tenant/communications/templates"),
            new("Notification escalation routing", "Claims and billing notification rules need updated escalation paths after team changes.", "Notifications", "Medium", "Route", "Maria Santos", "5 days", "Notification routing", "/tenant/communications/rules"),
            new("Appointment reminder cadence", "No-show reminder and follow-up cadence needs tenant default review.", "Appointments", "Low", "Route", "Lisa Chen", "Monthly", "Appointment automation", "/tenant/communications/appts"),
            new("Consent exception cleanup", "SMS and email campaigns contain contacts missing verified consent or suppression state.", "Consent", "High", "Comply", "Robert Yamamoto", "Same day", "Consent enforcement", "/tenant/communications/consent"),
            new("Outbound audit review", "Recent outbound communication audit has delivery failures and template approval exceptions.", "Audit", "High", "Audit", "Diana Perez", "Today", "Communication audit evidence", "/tenant/communications/audit")
        ]);
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _filter = string.Empty;
    }

    private void Advance(CommunicationWorkflowItem item)
    {
        item.Stage = item.Stage switch
        {
            "Connect" => "Author",
            "Author" => "Route",
            "Route" => "Comply",
            "Comply" => "Audit",
            _ => "Audit"
        };
    }

    private int FilterCount(string key) => key switch
    {
        "risk" => _workflow.Count(x => x.Risk == "High"),
        "templates" => _workflow.Count(x => x.Domain == "Templates"),
        "consent" => _workflow.Count(x => x.Domain == "Consent"),
        "audit" => _workflow.Count(x => x.Domain == "Audit"),
        _ => _workflow.Count
    };

    private static string ToneCss(string domain) => domain switch
    {
        "Email" => "comcfg-tone-blue",
        "SMS" => "comcfg-tone-green",
        "Templates" => "comcfg-tone-violet",
        "Notifications" => "comcfg-tone-amber",
        "Appointments" => "comcfg-tone-cyan",
        "Consent" => "comcfg-tone-green",
        "Senders" => "comcfg-tone-blue",
        "Audit" => "comcfg-tone-red",
        _ => "comcfg-tone-neutral"
    };

    private static string RiskCss(string risk) => risk switch
    {
        "High" => "comcfg-status-high",
        "Medium" => "comcfg-status-medium",
        _ => "comcfg-status-low"
    };

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="comcfg-kpi-card">
        <span class="comcfg-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span>
        <div>
            <strong>@value</strong>
            <span>@label</span>
            <small>@meta</small>
        </div>
    </article>;

    private sealed record Lane(string Key, string Label, string Description);
    private sealed record Filter(string Key, string Label);
    private sealed record CommunicationModule(string Title, string Description, string Url, string Icon, string Domain)
    {
        public string Label => Title;
    }

    private sealed class CommunicationWorkflowItem(string title, string summary, string domain, string risk, string stage, string owner, string sla, string control, string url)
    {
        public string Title { get; set; } = title;
        public string Summary { get; set; } = summary;
        public string Domain { get; set; } = domain;
        public string Risk { get; set; } = risk;
        public string Stage { get; set; } = stage;
        public string Owner { get; set; } = owner;
        public string Sla { get; set; } = sla;
        public string Control { get; set; } = control;
        public string Url { get; set; } = url;
    }
}
