@page "/finance"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>Finance</PageTitle>
<AppPageHeader Title="Accounting & Finance" Icon="bi-buildings" />

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}

<AppTab>
    <TabItems>
        <TabItem>
            <ChildContent><TabHeader Text="GL Accounts"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="margin-top:12px">
                    <AppTextBox Placeholder="Search..." @bind-Value="_glSearch" Width="320px"></AppTextBox>
                    <AppButton CssClass="e-primary" OnClick="LoadGLAsync">Refresh</AppButton>
                </div>
                @if (_glAccounts is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
                else {
                <AppGrid DataSource="_glAccounts" AllowPaging="true" AllowSorting="true" Height="460px">
                    <GridPageSettings PageSize="10"></GridPageSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(GLAccountDto.AccountCode)"     HeaderText="Code"   Width="120"></GridColumn>
                        <GridColumn Field="@nameof(GLAccountDto.AccountName)"     HeaderText="Name"   Width="240"></GridColumn>
                        <GridColumn Field="@nameof(GLAccountDto.AccountTypeCode)" HeaderText="Type"   Width="130"></GridColumn>
                        <GridColumn Field="@nameof(GLAccountDto.IsActive)"        HeaderText="Active" Width="90" DisplayAsCheckBox="true"></GridColumn>
                    </GridColumns>
                </AppGrid>
                }
            </ContentTemplate>
        </TabItem>
        <TabItem>
            <ChildContent><TabHeader Text="Journal Entries"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="margin-top:12px">
                    <AppTextBox Placeholder="Search..." @bind-Value="_jeSearch" Width="320px"></AppTextBox>
                    <AppButton CssClass="e-primary" OnClick="LoadJEAsync">Refresh</AppButton>
                </div>
                @if (_journalEntries is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
                else {
                <AppGrid DataSource="_journalEntries" AllowPaging="true" AllowSorting="true" Height="460px">
                    <GridPageSettings PageSize="10"></GridPageSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(JournalEntryDto.EntryNumber)" HeaderText="Entry #"    Width="140"></GridColumn>
                        <GridColumn Field="@nameof(JournalEntryDto.EntryDate)"     HeaderText="Date"         Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
                        <GridColumn Field="@nameof(JournalEntryDto.Description)"   HeaderText="Description"  Width="300"></GridColumn>
                        <GridColumn Field="@nameof(JournalEntryDto.TotalDebit)"    HeaderText="Debit"        Format="C2" Width="120"></GridColumn>
                        <GridColumn Field="@nameof(JournalEntryDto.TotalCredit)"   HeaderText="Credit"       Format="C2" Width="120"></GridColumn>
                        <GridColumn Field="@nameof(JournalEntryDto.StatusCode)"    HeaderText="Status"       Width="120"></GridColumn>
                    </GridColumns>
                </AppGrid>
                }
            </ContentTemplate>
        </TabItem>
    </TabItems>
</AppTab>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _glSearch;
    private string? _jeSearch;
    private string? _loadError;
    private List<GLAccountDto>? _glAccounts;
    private List<JournalEntryDto>? _journalEntries;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await Task.WhenAll(LoadGLAsync(), LoadJEAsync());
    }

    private async Task LoadGLAsync()
    {
        _loadError = null;
        try
        {
            var result = await Api.SearchGLAccountsAsync(_tenantId, _glSearch);
            _glAccounts = result?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = $"GL accounts failed to load: {ex.Message}";
            _glAccounts = [];
        }
    }

    private async Task LoadJEAsync()
    {
        _loadError = null;
        try
        {
            var result = await Api.SearchJournalEntriesAsync(_tenantId, _jeSearch);
            _journalEntries = result?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = $"Journal entries failed to load: {ex.Message}";
            _journalEntries = [];
        }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
