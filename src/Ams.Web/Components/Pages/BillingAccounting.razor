@page "/billing"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Billing & Accounting - AMS</PageTitle>

<AppPageHeader Title="Billing & Accounting"
               Subtitle="Tenant admin command center for AR, billing operations, payments, reconciliation, AP, GL, period close, and financial controls"
               Icon="bi-receipt">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/billing/accounts")'>
            <i class="bi bi-building" aria-hidden="true"></i> Billing Accounts
        </button>
    </Actions>
</AppPageHeader>

<section class="bill-hero" aria-label="Billing and accounting overview">
    <div>
        <span class="bill-eyebrow">Tenant administration</span>
        <h2>Billing & Accounting Workflow</h2>
        <p>Control agency bill, direct bill, receivables, payments, credits, collections, reconciliation, GL, AP, period close, deferred revenue, and audit-ready finance operations.</p>
    </div>
    <div class="bill-hero-grid">
        @foreach (var action in _quickActions)
        {
            <button class="bill-quick-action" @onclick="() => Nav.NavigateTo(action.Url)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
</section>

<section class="bill-kpi-grid" aria-label="Billing and accounting metrics">
    @Kpi("AR Balance", "$1.84M", "Open receivables", "bi-currency-dollar", "bill-tone-blue")
    @Kpi("Past Due", "$286K", "30+ day exposure", "bi-exclamation-triangle", "bill-tone-red")
    @Kpi("Cash Today", "$142K", "Receipts posted", "bi-cash-coin", "bill-tone-green")
    @Kpi("Close Tasks", _workflow.Count(x => x.Stage == "Close").ToString(), "Period close controls", "bi-lock", "bill-tone-violet")
</section>

<section class="bill-command-bar" aria-label="Billing workflow filters">
    <div class="bill-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search"
               placeholder="Search billing, finance, owner, control, module..."
               @bind="_search"
               @bind:event="oninput" />
    </div>
    <div class="bill-pill-group" role="group" aria-label="Billing workflow filter">
        @foreach (var filter in _filters)
        {
            <button class="bill-pill @(_filter == filter.Key ? "bill-pill--active" : "")"
                    @onclick="() => _filter = filter.Key">
                @filter.Label
                <span>@FilterCount(filter.Key)</span>
            </button>
        }
    </div>
</section>

<section class="bill-layout">
    <div class="bill-flow" aria-label="Billing and accounting workflow lanes">
        @foreach (var lane in _lanes)
        {
            var laneItems = FilteredWorkflow.Where(x => x.Stage == lane.Key).ToList();
            <article class="bill-lane">
                <header class="bill-lane-header">
                    <div>
                        <span class="bill-lane-title">@lane.Label</span>
                        <span class="bill-lane-subtitle">@lane.Description</span>
                    </div>
                    <span class="bill-lane-count">@laneItems.Count</span>
                </header>

                <div class="bill-lane-list">
                    @if (laneItems.Count == 0)
                    {
                        <div class="bill-empty-mini">No visible workflow items.</div>
                    }
                    else
                    {
                        @foreach (var item in laneItems)
                        {
                            <button class="bill-work-card @(item.Risk == "High" ? "bill-work-card--risk" : "")"
                                    @onclick="() => _selected = item">
                                <div class="bill-work-topline">
                                    <span class="bill-chip @ToneCss(item.Domain)">@item.Domain</span>
                                    <span class="bill-status @RiskCss(item.Risk)">@item.Risk</span>
                                </div>
                                <strong>@item.Title</strong>
                                <p>@item.Summary</p>
                                <div class="bill-work-meta">
                                    <span><i class="bi bi-person" aria-hidden="true"></i> @item.Owner</span>
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> @item.Sla</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            </article>
        }
    </div>

    <aside class="bill-admin-panel" aria-label="Tenant billing administration controls">
        @if (_selected is null)
        {
            <div class="bill-side-empty">
                <i class="bi bi-bank" aria-hidden="true"></i>
                <h3>Finance governance</h3>
                <p>Select a workflow item to inspect owner, SLA, risk, finance control, and downstream module action.</p>
            </div>
        }
        else
        {
            <div class="bill-detail-header">
                <span class="bill-chip @ToneCss(_selected.Domain)">@_selected.Domain</span>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close details">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h3>@_selected.Title</h3>
            <p>@_selected.Summary</p>

            <dl class="bill-detail-list">
                <div><dt>Owner</dt><dd>@_selected.Owner</dd></div>
                <div><dt>Stage</dt><dd>@_selected.Stage</dd></div>
                <div><dt>Risk</dt><dd><span class="bill-status @RiskCss(_selected.Risk)">@_selected.Risk</span></dd></div>
                <div><dt>SLA</dt><dd>@_selected.Sla</dd></div>
                <div><dt>Control</dt><dd>@_selected.Control</dd></div>
            </dl>

            <div class="bill-policy-card">
                <strong>Tenant finance controls</strong>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Segregation of duties and approval controls enabled</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Cash, credits, write-offs, and refunds require audit trail</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Reconciliation, GL posting, and period close monitored</span>
            </div>

            <div class="bill-detail-actions">
                <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selected.Url)">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Module
                </button>
                <button class="um-btn um-btn-ghost" @onclick="() => Advance(_selected)">
                    <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Advance
                </button>
            </div>
        }
    </aside>
</section>

<section class="bill-module-grid" aria-label="Billing and accounting modules">
    @foreach (var module in _modules)
    {
        <button class="bill-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
            <span class="bill-module-icon @ToneCss(module.Domain)"><i class="bi @module.Icon" aria-hidden="true"></i></span>
            <span class="bill-module-content">
                <strong>@module.Title</strong>
                <small>@module.Description</small>
            </span>
            <i class="bi bi-chevron-right bill-module-arrow" aria-hidden="true"></i>
        </button>
    }
</section>

@code {
    private string _search = string.Empty;
    private string _filter = string.Empty;
    private FinanceWorkflowItem? _selected;
    private readonly List<FinanceWorkflowItem> _workflow = [];

    private readonly Lane[] _lanes =
    [
        new("Bill", "Bill", "Accounts, invoices, and charges"),
        new("Collect", "Collect", "Payments, aging, collections"),
        new("Reconcile", "Reconcile", "Cash, bank, and subledger matching"),
        new("Post", "Post", "GL, AP, deferred revenue"),
        new("Close", "Close", "Period close and controls")
    ];

    private readonly Filter[] _filters =
    [
        new("", "All"),
        new("risk", "High Risk"),
        new("ar", "AR"),
        new("gl", "GL"),
        new("close", "Close")
    ];

    private readonly FinanceModule[] _modules =
    [
        new("Billing Accounts", "Manage billing relationships, terms, credit limits, autopay, and account status.", "/billing/accounts", "bi-building", "AR"),
        new("Invoices", "Issue, track, void, and collect policy invoices.", "/billing/invoices", "bi-receipt", "AR"),
        new("Payments", "Post client payments, cash receipts, and payment allocations.", "/billing/payments", "bi-cash-coin", "Cash"),
        new("Credits & Refunds", "Control refunds, credits, write-offs, and adjustments.", "/billing/credits", "bi-arrow-counterclockwise", "AR"),
        new("Reconciliation", "Match payments, invoices, deposits, carrier statements, and exceptions.", "/billing/reconciliation", "bi-ui-checks-grid", "Reconciliation"),
        new("Collections Queue", "Prioritize delinquency, dunning, promises-to-pay, and escalations.", "/billing/collections", "bi-exclamation-triangle", "Collections"),
        new("Payment Experience", "Monitor client payment journey, success rate, failures, and channels.", "/billing/payment-experience", "bi-graph-up", "Cash"),
        new("AR Aging", "Analyze current, 30, 60, 90, and 90+ receivables exposure.", "/billing/ar-aging", "bi-hourglass", "Collections"),
        new("Time Entries", "Track billable time and internal work capture.", "/timeentries", "bi-clock", "Expense"),
        new("Expenses", "Manage employee expenses, reimbursements, and approvals.", "/expenses", "bi-credit-card", "Expense"),
        new("GL Accounts", "Maintain chart of accounts and account status.", "/finance/glaccounts", "bi-journals", "GL"),
        new("Journal Entries", "Review balanced journal entries and posting status.", "/finance/journalentries", "bi-journal-text", "GL"),
        new("Bank Reconciliation", "Reconcile bank activity, deposits, withdrawals, and adjustments.", "/finance/bank-reconciliation", "bi-bank", "Reconciliation"),
        new("Vendors", "Manage vendor profiles, tax details, and payment defaults.", "/finance/vendors", "bi-truck", "AP"),
        new("AP Invoices", "Capture vendor invoices and approval status.", "/finance/ap-invoices", "bi-receipt", "AP"),
        new("AP Payments", "Issue vendor payments and monitor clearing state.", "/finance/ap-payments", "bi-cash-stack", "AP"),
        new("Accounting Periods", "Maintain fiscal calendars and close status.", "/finance/accounting-periods", "bi-calendar-range", "Close"),
        new("Period Close", "Coordinate close checklist, validations, and lock controls.", "/finance/period-close", "bi-lock", "Close"),
        new("Deferred Revenue", "Recognize revenue schedules and deferral balances.", "/finance/deferred-revenue", "bi-hourglass-split", "GL"),
        new("Trial Balance", "Review debits, credits, and account balances.", "/finance/trial-balance", "bi-calculator", "GL"),
        new("Cash Receipts", "Review receipts, deposits, and unmatched cash.", "/finance/cash-receipts", "bi-currency-dollar", "Cash")
    ];

    private readonly FinanceModule[] _quickActions =
    [
        new("Invoices", "", "/billing/invoices", "bi-receipt", "AR"),
        new("Payments", "", "/billing/payments", "bi-cash-coin", "Cash"),
        new("Collections", "", "/billing/collections", "bi-exclamation-triangle", "Collections"),
        new("Period Close", "", "/finance/period-close", "bi-lock", "Close")
    ];

    private IEnumerable<FinanceWorkflowItem> FilteredWorkflow => _workflow.Where(item =>
        (string.IsNullOrWhiteSpace(_filter) || _filter switch
        {
            "risk" => item.Risk == "High",
            "ar" => item.Domain is "AR" or "Collections",
            "gl" => item.Domain == "GL",
            "close" => item.Stage == "Close" || item.Domain == "Close",
            _ => true
        }) &&
        (string.IsNullOrWhiteSpace(_search) ||
         item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Domain.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Control.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(x => x.Risk == "High")
        .ThenBy(x => x.Stage)
        .ThenBy(x => x.Title);

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Billing & Accounting", "/billing"));
        BuildWorkflow();
        _selected = _workflow.FirstOrDefault(x => x.Risk == "High") ?? _workflow.FirstOrDefault();
    }

    private void BuildWorkflow()
    {
        _workflow.Clear();
        _workflow.AddRange(
        [
            new("Agency bill invoice run", "Monthly commercial lines invoice batch requires tenant admin review before release.", "AR", "Medium", "Bill", "Maria Santos", "Today", "Invoice approval", "/billing/invoices"),
            new("Delinquent account escalation", "90+ day AR exposure exceeds threshold and requires collection action.", "Collections", "High", "Collect", "Kevin Obi", "Same day", "Collections policy", "/billing/collections"),
            new("Payment allocation exception", "Client payment could not auto-match invoice and requires manual allocation.", "Cash", "High", "Collect", "Sarah Kim", "4h", "Cash application", "/billing/payments"),
            new("Carrier statement reconciliation", "Carrier download totals do not match subledger activity.", "Reconciliation", "High", "Reconcile", "James Park", "Today", "Reconciliation variance", "/billing/reconciliation"),
            new("Bank deposit reconciliation", "Cash receipts batch is pending bank statement match.", "Reconciliation", "Medium", "Reconcile", "Lisa Chen", "24h", "Bank reconciliation", "/finance/bank-reconciliation"),
            new("AP invoice approval", "Vendor invoice is awaiting coding and approval before payment run.", "AP", "Medium", "Post", "Diana Perez", "2 days", "AP approval", "/finance/ap-invoices"),
            new("Deferred revenue recognition", "Revenue schedule requires validation before GL posting.", "GL", "Medium", "Post", "Robert Yamamoto", "Close cycle", "Revenue recognition", "/finance/deferred-revenue"),
            new("Trial balance review", "Debits and credits require final review before period lock.", "GL", "Medium", "Close", "Diana Perez", "Month end", "Trial balance control", "/finance/trial-balance"),
            new("Period close checklist", "Open close tasks must be completed before locking accounting period.", "Close", "High", "Close", "Robert Yamamoto", "Month end", "Close certification", "/finance/period-close")
        ]);
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _filter = string.Empty;
    }

    private void Advance(FinanceWorkflowItem item)
    {
        item.Stage = item.Stage switch
        {
            "Bill" => "Collect",
            "Collect" => "Reconcile",
            "Reconcile" => "Post",
            "Post" => "Close",
            _ => "Close"
        };
    }

    private int FilterCount(string key) => key switch
    {
        "risk" => _workflow.Count(x => x.Risk == "High"),
        "ar" => _workflow.Count(x => x.Domain is "AR" or "Collections"),
        "gl" => _workflow.Count(x => x.Domain == "GL"),
        "close" => _workflow.Count(x => x.Stage == "Close" || x.Domain == "Close"),
        _ => _workflow.Count
    };

    private static string ToneCss(string domain) => domain switch
    {
        "AR" => "bill-tone-blue",
        "Cash" => "bill-tone-green",
        "Collections" => "bill-tone-red",
        "Reconciliation" => "bill-tone-cyan",
        "GL" => "bill-tone-violet",
        "AP" => "bill-tone-amber",
        "Expense" => "bill-tone-neutral",
        "Close" => "bill-tone-violet",
        _ => "bill-tone-neutral"
    };

    private static string RiskCss(string risk) => risk switch
    {
        "High" => "bill-status-high",
        "Medium" => "bill-status-medium",
        _ => "bill-status-low"
    };

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="bill-kpi-card">
        <span class="bill-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span>
        <div>
            <strong>@value</strong>
            <span>@label</span>
            <small>@meta</small>
        </div>
    </article>;

    private sealed record Lane(string Key, string Label, string Description);
    private sealed record Filter(string Key, string Label);
    private sealed record FinanceModule(string Title, string Description, string Url, string Icon, string Domain)
    {
        public string Label => Title;
    }

    private sealed class FinanceWorkflowItem(string title, string summary, string domain, string risk, string stage, string owner, string sla, string control, string url)
    {
        public string Title { get; set; } = title;
        public string Summary { get; set; } = summary;
        public string Domain { get; set; } = domain;
        public string Risk { get; set; } = risk;
        public string Stage { get; set; } = stage;
        public string Owner { get; set; } = owner;
        public string Sla { get; set; } = sla;
        public string Control { get; set; } = control;
        public string Url { get; set; } = url;
    }
}
