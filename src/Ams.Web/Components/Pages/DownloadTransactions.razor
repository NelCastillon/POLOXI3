@page "/integrations/downloads"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Download Transactions - AMS</PageTitle>

<AppPageHeader Title="Download Transactions"
               Subtitle="All carrier download transactions - policy, claims, and endorsement records received and processed"
               Icon="bi-arrow-down-circle-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='()=>Nav.NavigateTo("/integrations/download-exceptions")'>
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Exception Queue
        </button>
        <button class="um-btn um-btn-ghost"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
    </Actions>
</AppPageHeader>

<!-- Summary strip -->
<div class="dt-kpi-strip">
    <div class="dt-kpi-card"><div class="dt-kpi-icon dt-ki-blue"><i class="bi bi-arrow-down-circle" aria-hidden="true"></i></div><div><div class="dt-kv">1,842</div><div class="dt-kl">Downloaded Today</div></div></div>
    <div class="dt-kpi-card"><div class="dt-kpi-icon dt-ki-green"><i class="bi bi-check-circle" aria-hidden="true"></i></div><div><div class="dt-kv">1,804</div><div class="dt-kl">Applied (98.0%)</div></div></div>
    <div class="dt-kpi-card"><div class="dt-kpi-icon dt-ki-amber"><i class="bi bi-hourglass-split" aria-hidden="true"></i></div><div><div class="dt-kv">21</div><div class="dt-kl">Pending Match</div></div></div>
    <div class="dt-kpi-card"><div class="dt-kpi-icon dt-ki-red"><i class="bi bi-exclamation-circle" aria-hidden="true"></i></div><div><div class="dt-kv">17</div><div class="dt-kl">Exceptions</div></div></div>
</div>

<!-- Filter bar -->
<div class="dt-filter-bar">
    <div class="dt-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="dt-search" placeholder="Search by carrier, policy #, account..." @bind="_search" @bind:event="oninput" />
    </div>
    <select class="dt-sel" @bind="_carrierFilter">
        <option value="">All Carriers</option>
        <option value="Safeco">Safeco</option>
        <option value="Progressive">Progressive</option>
        <option value="Travelers">Travelers</option>
        <option value="Berkley">Berkley</option>
    </select>
    <select class="dt-sel" @bind="_typeFilter">
        <option value="">All Types</option>
        <option value="Policy">Policy</option>
        <option value="Endorsement">Endorsement</option>
        <option value="Cancellation">Cancellation</option>
        <option value="Reinstatement">Reinstatement</option>
        <option value="Claims">Claims</option>
    </select>
    <select class="dt-sel" @bind="_statusFilter">
        <option value="">All Statuses</option>
        <option value="Applied">Applied</option>
        <option value="Pending">Pending</option>
        <option value="Exception">Exception</option>
        <option value="Skipped">Skipped</option>
    </select>
</div>

<!-- Transactions grid -->
<div class="dt-grid-wrap">
    <AppGrid TValue="DownloadTx" DataSource="Filtered.ToList()" AllowSorting="true" AllowPaging="true" EnableHover="true" RowHeight="52">
        
        <GridColumns>
            <GridColumn Field="@nameof(DownloadTx.ReceivedAt)" HeaderText="Received" Width="150"  Format="MMM d h:mm tt" />
            <GridColumn Field="@nameof(DownloadTx.Carrier)"    HeaderText="Carrier" Width="130" />
            <GridColumn Field="@nameof(DownloadTx.TxType)"     HeaderText="Type" Width="120">
                <Template>@{ var t = (DownloadTx)context; }<span class="@TypeBadge(t.TxType)">@t.TxType</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(DownloadTx.PolicyNo)"   HeaderText="Policy #" Width="140" />
            <GridColumn Field="@nameof(DownloadTx.Account)"    HeaderText="Account" MinWidth="160" />
            <GridColumn Field="@nameof(DownloadTx.PremiumChange)" HeaderText="Premium Î”" Width="120" TextAlign=@("Right")>
                <Template>@{ var t = (DownloadTx)context; }
                    <span class="@(t.PremiumChangeDelta>0?"dt-up":t.PremiumChangeDelta<0?"dt-dn":"")">@t.PremiumChange</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(DownloadTx.Status)"     HeaderText="Status" Width="120">
                <Template>@{ var t = (DownloadTx)context; }<span class="@StatusBadge(t.Status)">@t.Status</span></Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="80" TextAlign=@("Right")>
                <Template>@{ var t = (DownloadTx)context; }
                    <div class="dt-row-actions">
                        <button class="um-btn um-btn-ghost um-btn-xs" title="View detail"><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                        @if (t.Status == "Exception") {
                            <button class="um-btn um-btn-ghost um-btn-xs dt-exc-btn" title="Resolve" @onclick='()=>Nav.NavigateTo("/integrations/download-exceptions")'><i class="bi bi-tools" aria-hidden="true"></i></button>
                        }
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </AppGrid>
</div>

@code {
    private string _search = string.Empty;
    private string _carrierFilter = string.Empty;
    private string _typeFilter = string.Empty;
    private string _statusFilter = string.Empty;

    private List<DownloadTx> _transactions = [];

    private IEnumerable<DownloadTx> Filtered => _transactions.Where(t =>
        (string.IsNullOrEmpty(_search) || t.PolicyNo.Contains(_search, StringComparison.OrdinalIgnoreCase) || t.Account.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_carrierFilter) || t.Carrier.Contains(_carrierFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_typeFilter) || t.TxType == _typeFilter) &&
        (string.IsNullOrEmpty(_statusFilter) || t.Status == _statusFilter));

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Integrations","/integrations"), new("Download Transactions",""));
        var rng = new Random(42);
        var carriers = new[]{"Safeco","Progressive","Travelers","Berkley One","National General"};
        var types    = new[]{"Policy","Endorsement","Cancellation","Reinstatement","Claims"};
        var statuses = new[]{"Applied","Applied","Applied","Applied","Pending","Exception","Skipped"};
        var accounts = new[]{"Apex Logistics LLC","Castillo Auto Group","Kim Realty LLC","Ortega Construction","Vega Foods Inc","Sullivan Manufacturing","Rivera Roofing LLC","Mesa Contractors","Blue Harbor Marina","Summit Tech Partners"};
        for (var i = 0; i < 80; i++)
        {
            var delta = rng.Next(-500, 1500);
            _transactions.Add(new DownloadTx
            {
                ReceivedAt     = DateTime.Now.AddMinutes(-rng.Next(1, 1440)),
                Carrier        = carriers[rng.Next(carriers.Length)],
                TxType         = types[rng.Next(types.Length)],
                PolicyNo       = $"PLY-{rng.Next(10000,99999)}",
                Account        = accounts[rng.Next(accounts.Length)],
                PremiumChange  = delta == 0 ? "-" : $"{(delta>0?"+":"")}${Math.Abs(delta):N0}",
                PremiumChangeDelta = delta,
                Status         = statuses[rng.Next(statuses.Length)],
            });
        }
        _transactions = [.. _transactions.OrderByDescending(t => t.ReceivedAt)];
    }

    private static string TypeBadge(string t) => t switch { "Policy"=>"dt-ty dt-ty--pol","Endorsement"=>"dt-ty dt-ty--end","Cancellation"=>"dt-ty dt-ty--can","Reinstatement"=>"dt-ty dt-ty--rei","Claims"=>"dt-ty dt-ty--clm",_=>"dt-ty" };
    private static string StatusBadge(string s) => s switch { "Applied"=>"dt-st dt-st--ok","Pending"=>"dt-st dt-st--pend","Exception"=>"dt-st dt-st--exc","Skipped"=>"dt-st dt-st--skip",_=>"dt-st" };

    private sealed class DownloadTx { public DateTime ReceivedAt{get;set;} public string Carrier{get;set;}=string.Empty; public string TxType{get;set;}=string.Empty; public string PolicyNo{get;set;}=string.Empty; public string Account{get;set;}=string.Empty; public string PremiumChange{get;set;}=string.Empty; public int PremiumChangeDelta{get;set;} public string Status{get;set;}=string.Empty; }
}
