@page "/submissions/new"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Submissions
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>New Submission â€” AMS</PageTitle>

<div class="nsw-page">
    <section class="nsw-hero">
        <div class="nsw-hero__content">
            <div class="nsw-hero__eyebrow"><i class="bi bi-send-plus" aria-hidden="true"></i> Enterprise submission intake</div>
            <h1>New Submission Command Center</h1>
            <p>Create market-ready submissions from opportunity data, prioritize by importance, select target markets, assemble ACORD packets, and launch the existing submission workflow.</p>
            <div class="nsw-hero__meta">
                <span><i class="bi bi-trophy" aria-hidden="true"></i>@(_form.OpportunityName.Length > 0 ? _form.OpportunityName : "Opportunity pending")</span>
                <span><i class="bi bi-layers" aria-hidden="true"></i>@Safe(_form.LineOfBusiness, "LOB pending")</span>
                <span><i class="bi bi-cash-stack" aria-hidden="true"></i>@TargetPremiumDisplay</span>
                <span><i class="bi bi-speedometer2" aria-hidden="true"></i>@ImportanceLabel importance</span>
            </div>
        </div>
        <div class="nsw-hero__actions">
            <button type="button" class="nsw-btn nsw-btn--light" @onclick="LoadOpportunitiesAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @_refreshIconClass" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="nsw-btn nsw-btn--light" @onclick='() => Nav.NavigateTo("/submissions")'>
                <i class="bi bi-list-check" aria-hidden="true"></i> Submissions
            </button>
            <button type="button" class="nsw-btn nsw-btn--light" @onclick='() => Nav.NavigateTo("/crm/opportunities")'>
                <i class="bi bi-kanban" aria-hidden="true"></i> Opportunities
            </button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger nsw-alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="nsw-kpi-strip" aria-label="Submission intake KPIs">
        @KpiCard("all", "Readiness", $"{ReadinessPercent}%", "Completion quality across all intake stages", "bi-clipboard2-check", "blue")
        @KpiCard("importance", "Importance", ImportanceLabel, "Priority based on premium, timing, rush, and markets", "bi-lightning-charge", "red")
        @KpiCard("opportunity", "Opportunities", OpportunityCount.ToString(), "Available opportunities from CRM pipeline", "bi-trophy", "cyan")
        @KpiCard("markets", "Markets", _selectedCarrierIds.Count.ToString(), "Selected carriers for post-create submission workflow", "bi-bank", "emerald")
        @KpiCard("forms", "Forms", _selectedFormIds.Count.ToString(), "ACORD forms staged for the submission packet", "bi-file-earmark-text", "amber")
        @KpiCard("premium", "Target Premium", TargetPremiumDisplay, "Premium target that drives importance ranking", "bi-cash-stack", "green")
    </section>

    <section class="nsw-workflows" aria-label="Submission creation shortcuts">
        <button type="button" class="nsw-workflow" @onclick="GoToCriticalFields">
            <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
            <span><strong>Critical fields</strong><small>Jump to missing required data</small></span>
        </button>
        <button type="button" class="nsw-workflow" @onclick="ApplyRushWorkflow">
            <i class="bi bi-lightning" aria-hidden="true"></i>
            <span><strong>Rush setup</strong><small>Mark urgent and advance dates</small></span>
        </button>
        <button type="button" class="nsw-workflow" @onclick="SelectRecommendedMarkets">
            <i class="bi bi-bank" aria-hidden="true"></i>
            <span><strong>Best markets</strong><small>Select preferred appetite matches</small></span>
        </button>
        <button type="button" class="nsw-workflow" @onclick="SelectRequiredForms">
            <i class="bi bi-file-earmark-check" aria-hidden="true"></i>
            <span><strong>Required packet</strong><small>Add ACORD forms by LOB</small></span>
        </button>
        <button type="button" class="nsw-workflow" @onclick="ReviewSubmission">
            <i class="bi bi-clipboard-check" aria-hidden="true"></i>
            <span><strong>Review</strong><small>Validate and prepare to create</small></span>
        </button>
    </section>

    <section class="nsw-tabs" aria-label="Submission intake steps">
        @foreach (var step in _steps)
        {
            <button type="button" class="@StepClass(step.Index)" title="@step.Description" @onclick="() => SetStep(step.Index)">
                <i class="bi @step.Icon" aria-hidden="true"></i>
                <span>@step.Label</span>
                <strong>@StepStateText(step.Index)</strong>
            </button>
        }
    </section>

    <EditForm Model="_form" OnValidSubmit="OpenCreateConfirm" OnInvalidSubmit="HandleInvalidSubmit">
        <DataAnnotationsValidator />
        <div class="nsw-dashboard">
            <main class="nsw-main-card">
                <div class="nsw-card-header">
                    <div>
                        <span class="nsw-section-kicker">@CurrentStep.Kicker</span>
                        <h2>@CurrentStep.Title</h2>
                        <p>@CurrentStep.Description</p>
                    </div>
                    <div class="nsw-card-actions">
                        <span class="nsw-page-indicator">Step @(_step + 1) of @_steps.Length</span>
                        <button type="button" class="nsw-btn nsw-btn--ghost" disabled="@(_step == 0)" @onclick="GoPrev"><i class="bi bi-chevron-left" aria-hidden="true"></i> Back</button>
                        @if (_step < _steps.Length - 1)
                        {
                            <button type="button" class="nsw-btn nsw-btn--primary" disabled="@(!CanAdvanceCurrentStep)" @onclick="GoNext">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                        }
                        else
                        {
                            <button type="submit" class="nsw-btn nsw-btn--primary" disabled="@(_submitting || !CanCreate)">
                                @if (_submitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                }
                                Create Submission
                            </button>
                        }
                    </div>
                </div>

                <div class="nsw-step-body">
                    @if (_step == 0)
                    {
                        <section class="nsw-step-panel">
                            <div class="nsw-filter-panel">
                                <div class="nsw-search">
                                    <i class="bi bi-search" aria-hidden="true"></i>
                                    <input placeholder="Search opportunities or accounts..." @bind="_searchText" @bind:event="oninput" />
                                </div>
                                <button type="button" class="nsw-btn nsw-btn--ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities/new")'>
                                    <i class="bi bi-plus-lg" aria-hidden="true"></i> New Opportunity
                                </button>
                            </div>

                            @if (_loading)
                            {
                                <div class="nsw-loading"><span class="nsw-spinner"></span><span>Loading opportunities...</span></div>
                            }
                            else if (!FilteredOpportunities.Any())
                            {
                                <div class="nsw-empty"><i class="bi bi-search" aria-hidden="true"></i><strong>No opportunities found</strong><span>Create an opportunity first or refine your search.</span></div>
                            }
                            else
                            {
                                <div class="nsw-opportunity-grid">
                                    @foreach (var opportunity in FilteredOpportunities)
                                    {
                                        var selected = _form.OpportunityId == opportunity.OpportunityId;
                                        <button type="button" class="nsw-opportunity-card @(selected ? "nsw-opportunity-card--active" : string.Empty)" @onclick="() => SelectOpportunity(opportunity)">
                                            <span class="nsw-opportunity-icon"><i class="bi bi-trophy" aria-hidden="true"></i></span>
                                            <span class="nsw-opportunity-main">
                                                <strong>@opportunity.OpportunityName</strong>
                                                <small>@Safe(opportunity.AccountName, "Account pending")</small>
                                                <em>@Safe(opportunity.StageName, "Pipeline") â€¢ @opportunity.WinProbability.ToString("0")% probability</em>
                                            </span>
                                            <span class="nsw-opportunity-value">@opportunity.EstimatedAmount.ToString("C0")</span>
                                            @if (selected)
                                            {
                                                <i class="bi bi-check-circle-fill nsw-card-check" aria-hidden="true"></i>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                        </section>
                    }
                    else if (_step == 1)
                    {
                        <section class="nsw-step-panel">
                            <div class="nsw-lob-grid">
                                @foreach (var lob in _lobCards)
                                {
                                    var selected = _form.LineOfBusiness == lob.Key;
                                    <button type="button" class="nsw-lob-card @(selected ? "nsw-lob-card--active" : string.Empty)" style="--nsw-lob-color:@lob.Color" @onclick="() => SelectLob(lob.Key)">
                                        <span class="nsw-lob-icon"><i class="bi @lob.Icon" aria-hidden="true"></i></span>
                                        <strong>@lob.Label</strong>
                                        <small>@lob.Description</small>
                                        @if (selected)
                                        {
                                            <i class="bi bi-check-circle-fill nsw-card-check" aria-hidden="true"></i>
                                        }
                                    </button>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_form.LineOfBusiness))
                            {
                                <div class="nsw-subline-panel">
                                    <span>Coverage focus</span>
                                    <div class="nsw-pill-row">
                                        @foreach (var subline in SelectedLobSublines)
                                        {
                                            <button type="button" class="nsw-pill @(_form.SubLine == subline ? "nsw-pill--active" : string.Empty)" @onclick="() => _form.SubLine = _form.SubLine == subline ? string.Empty : subline">@subline</button>
                                        }
                                    </div>
                                </div>
                            }
                        </section>
                    }
                    else if (_step == 2)
                    {
                        <section class="nsw-form-grid">
                            <label class="nsw-field">
                                <span>Effective Date <em>*</em></span>
                                <InputDate class="form-control" @bind-Value="_form.EffectiveDate" />
                            </label>
                            <label class="nsw-field">
                                <span>Expiration Date <em>*</em></span>
                                <InputDate class="form-control" @bind-Value="_form.ExpirationDate" />
                            </label>
                            <label class="nsw-field">
                                <span>Priority <em>*</em></span>
                                <InputSelect class="form-select" @bind-Value="_form.Priority">
                                    @foreach (var priority in _priorities)
                                    {
                                        <option value="@priority">@priority</option>
                                    }
                                </InputSelect>
                            </label>
                            <label class="nsw-field nsw-check-field">
                                <span>Rush Submission</span>
                                <input type="checkbox" class="form-check-input" @bind="_form.IsRush" />
                                <small>@(_form.IsRush ? "Rush workflow enabled" : "Standard service level")</small>
                            </label>
                            <label class="nsw-field">
                                <span>Target Premium</span>
                                <InputNumber class="form-control" @bind-Value="_form.TargetPremium" />
                            </label>
                            <label class="nsw-field">
                                <span>Primary Risk State <em>*</em></span>
                                <InputSelect class="form-select" @bind-Value="_form.RiskState">
                                    @foreach (var state in _states)
                                    {
                                        <option value="@state">@state</option>
                                    }
                                </InputSelect>
                            </label>
                            <label class="nsw-field nsw-field--full">
                                <span>Named Insured</span>
                                <InputText class="form-control" @bind-Value="_form.NamedInsured" placeholder="Legal named insured if different from account" />
                            </label>
                            <label class="nsw-field">
                                <span>Producer</span>
                                <InputSelect class="form-select" @bind-Value="_form.ProducerName">
                                    <option value="">Unassigned</option>
                                    @foreach (var producer in _producers)
                                    {
                                        <option value="@producer">@producer</option>
                                    }
                                </InputSelect>
                            </label>
                            <label class="nsw-field">
                                <span>Assigned CSR</span>
                                <InputSelect class="form-select" @bind-Value="_form.CsrName">
                                    <option value="">Unassigned</option>
                                    @foreach (var csr in _csrs)
                                    {
                                        <option value="@csr">@csr</option>
                                    }
                                </InputSelect>
                            </label>
                            <label class="nsw-field nsw-field--full">
                                <span>Submission Description</span>
                                <InputTextArea class="form-control" rows="4" @bind-Value="_form.Description" placeholder="Risk summary, coverage needs, loss context, or underwriting notes" />
                            </label>
                            <label class="nsw-field nsw-field--full">
                                <span>Internal Notes</span>
                                <InputTextArea class="form-control" rows="3" @bind-Value="_form.InternalNotes" placeholder="Internal team notes not shared with carrier" />
                            </label>
                        </section>
                    }
                    else if (_step == 3)
                    {
                        <section class="nsw-step-panel">
                            <div class="nsw-market-summary">
                                <span><strong>@_selectedCarrierIds.Count</strong> selected markets</span>
                                <div>
                                    <button type="button" class="nsw-btn nsw-btn--ghost" @onclick="SelectRecommendedMarkets">Select recommended</button>
                                    <button type="button" class="nsw-btn nsw-btn--ghost" @onclick="() => _selectedCarrierIds.Clear()">Clear</button>
                                </div>
                            </div>
                            <div class="nsw-carrier-grid">
                                @foreach (var carrier in SortedCarriers)
                                {
                                    var selected = _selectedCarrierIds.Contains(carrier.Id);
                                    <button type="button" class="nsw-carrier-card @(selected ? "nsw-carrier-card--active" : string.Empty)" @onclick="() => ToggleCarrier(carrier.Id)">
                                        <span class="nsw-carrier-top">
                                            <strong>@carrier.Name</strong>
                                            @if (carrier.Preferred)
                                            {
                                                <em>Preferred</em>
                                            }
                                        </span>
                                        <small>AM Best @carrier.AMBest â€¢ @string.Join(", ", carrier.States.Take(3))@(carrier.States.Length > 3 ? "â€¦" : string.Empty)</small>
                                        <span class="nsw-appetite">@CarrierAppetiteText(carrier)</span>
                                        @if (selected)
                                        {
                                            <i class="bi bi-check-circle-fill nsw-card-check" aria-hidden="true"></i>
                                        }
                                    </button>
                                }
                            </div>
                        </section>
                    }
                    else if (_step == 4)
                    {
                        <section class="nsw-step-panel">
                            <div class="nsw-market-summary">
                                <span><strong>@_selectedFormIds.Count</strong> selected ACORD forms</span>
                                <button type="button" class="nsw-btn nsw-btn--ghost" @onclick="SelectRequiredForms">Select required</button>
                            </div>
                            <div class="nsw-forms-list">
                                @foreach (var form in _acordForms)
                                {
                                    var selected = _selectedFormIds.Contains(form.Id);
                                    <button type="button" class="nsw-form-row @(selected ? "nsw-form-row--active" : string.Empty)" @onclick="() => ToggleForm(form.Id)">
                                        <span class="nsw-form-num">@form.Number</span>
                                        <span class="nsw-form-info"><strong>@form.Title</strong><small>@form.Lobs</small></span>
                                        @if (form.Required)
                                        {
                                            <span class="nsw-required-pill">Required</span>
                                        }
                                        @if (selected)
                                        {
                                            <i class="bi bi-check-circle-fill nsw-card-check" aria-hidden="true"></i>
                                        }
                                    </button>
                                }
                            </div>
                            <div class="nsw-upload-zone" @onclick="SimulateUpload">
                                <i class="bi bi-cloud-upload" aria-hidden="true"></i>
                                <strong>Stage supporting documents</strong>
                                <span>Click to add a document placeholder. Upload persistence can be completed from the submission detail workflow.</span>
                            </div>
                            @if (_uploadedFiles.Any())
                            {
                                <div class="nsw-uploaded-list">
                                    @foreach (var file in _uploadedFiles)
                                    {
                                        <div class="nsw-uploaded-file">
                                            <i class="bi bi-file-earmark" aria-hidden="true"></i>
                                            <span>@file</span>
                                            <button type="button" class="nsw-icon-btn" @onclick="() => ConfirmRemoveFile(file)"><i class="bi bi-x" aria-hidden="true"></i></button>
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    }
                    else
                    {
                        <section class="nsw-review-grid">
                            @ReviewCard("Opportunity", "bi-trophy", 0, _form.OpportunityName, _form.AccountName)
                            @ReviewCard("Line of Business", "bi-layers", 1, _form.LineOfBusiness, Safe(_form.SubLine, "No sub-line selected"))
                            @ReviewCard("Timing", "bi-calendar-range", 2, $"{_form.EffectiveDate:MMM d, yyyy} - {_form.ExpirationDate:MMM d, yyyy}", $"{_form.Priority} priority â€¢ {TargetPremiumDisplay}")
                            @ReviewCard("Team", "bi-people", 2, Safe(_form.ProducerName, "Producer unassigned"), Safe(_form.CsrName, "CSR unassigned"))
                            @ReviewCard("Markets", "bi-bank", 3, $"{_selectedCarrierIds.Count} markets selected", string.Join(", ", SelectedCarrierNames.Take(3)))
                            @ReviewCard("Packet", "bi-paperclip", 4, $"{_selectedFormIds.Count} ACORD forms", $"{_uploadedFiles.Count} staged documents")
                        </section>
                    }
                </div>
            </main>

            <aside class="nsw-side-panel">
                <section class="nsw-panel-card">
                    <span class="nsw-section-kicker">Importance score</span>
                    <div class="nsw-score-card">
                        <span>Submission priority</span>
                        <strong>@ImportanceScore</strong>
                        <small>@ImportanceLabel</small>
                    </div>
                    <div class="nsw-importance-list">
                        @foreach (var reason in ImportanceReasons)
                        {
                            <div><i class="bi bi-check2-circle" aria-hidden="true"></i><span>@reason</span></div>
                        }
                    </div>
                </section>

                <section class="nsw-panel-card">
                    <span class="nsw-section-kicker">Readiness</span>
                    <div class="nsw-readiness">
                        <span style="width:@ReadinessPercent%"></span>
                    </div>
                    <dl class="nsw-detail-list">
                        <div><span>Opportunity</span><strong>@StepStateText(0)</strong></div>
                        <div><span>LOB</span><strong>@StepStateText(1)</strong></div>
                        <div><span>Details</span><strong>@StepStateText(2)</strong></div>
                        <div><span>Markets</span><strong>@_selectedCarrierIds.Count</strong></div>
                        <div><span>Forms</span><strong>@_selectedFormIds.Count</strong></div>
                    </dl>
                </section>

                <section class="nsw-panel-card">
                    <span class="nsw-section-kicker">Actions</span>
                    <div class="nsw-selected-actions">
                        <button type="button" class="nsw-btn nsw-btn--primary" disabled="@(!CanCreate || _submitting)" @onclick="OpenCreateConfirm"><i class="bi bi-send-fill" aria-hidden="true"></i> Create Submission</button>
                        <button type="button" class="nsw-btn nsw-btn--ghost" @onclick="SaveDraft"><i class="bi bi-floppy" aria-hidden="true"></i> Save Draft</button>
                        <button type="button" class="nsw-btn nsw-btn--ghost" @onclick="ConfirmCancel"><i class="bi bi-arrow-left" aria-hidden="true"></i> Cancel</button>
                    </div>
                </section>
            </aside>
        </div>
    </EditForm>
</div>

@if (_showConfirmDialog)
{
    <div class="nsw-modal-backdrop" role="presentation" @onclick="CloseConfirmDialog">
        <div class="nsw-confirm" role="dialog" aria-modal="true" aria-labelledby="nsw-confirm-title" @onclick:stopPropagation="true">
            <div class="nsw-modal__header">
                <i class="bi @_confirmIcon" aria-hidden="true"></i>
                <span id="nsw-confirm-title">@_confirmTitle</span>
                <button type="button" class="nsw-icon-btn nsw-icon-btn--light ms-auto" @onclick="CloseConfirmDialog" disabled="@_submitting"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="nsw-confirm__body">
                <div class="@ConfirmIconClass"><i class="bi @_confirmIcon" aria-hidden="true"></i></div>
                <div><h3>@_confirmTitle</h3><p>@_confirmMessage</p></div>
            </div>
            <div class="nsw-modal__footer">
                <button type="button" class="nsw-btn nsw-btn--ghost" @onclick="CloseConfirmDialog" disabled="@_submitting">Cancel</button>
                <button type="button" class="@ConfirmButtonClass" @onclick="ExecuteConfirmedActionAsync" disabled="@_submitting">
                    @if (_submitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    @_confirmButtonText
                </button>
            </div>
        </div>
    </div>
}

<div class="nsw-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="nsw-toast @toast.CssClass">
            <i class="bi @ToastIconClass(toast)" aria-hidden="true"></i>
            <span>@toast.Message</span>
            <button type="button" @onclick="() => DismissToast(toast.Id)"><i class="bi bi-x" aria-hidden="true"></i></button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "opportunityId")]
    public Guid? OpportunityId { get; set; }

    [SupplyParameterFromQuery(Name = "accountId")]
    public Guid? AccountId { get; set; }

    [SupplyParameterFromQuery(Name = "accountName")]
    public string? AccountName { get; set; }

    Guid _tenantId;
    Guid _tenantAdminUserId;
    bool _loading;
    bool _submitting;
    bool _showConfirmDialog;
    int _step;
    string _activeKpi = "all";
    string _refreshIconClass = string.Empty;
    string? _loadError;
    string? _searchText;
    string? _pendingAction;
    string _confirmTitle = string.Empty;
    string _confirmMessage = string.Empty;
    string _confirmButtonText = "Confirm";
    string _confirmIcon = "bi-question-circle";
    string _confirmKind = "primary";
    string? _pendingFileRemoval;

    readonly SubmissionIntakeForm _form = new();
    readonly List<OpportunityOption> _opportunities = [];
    readonly HashSet<string> _selectedCarrierIds = [];
    readonly HashSet<string> _selectedFormIds = [];
    readonly List<string> _uploadedFiles = [];
    readonly List<ToastMessage> _toasts = [];

    readonly StepDef[] _steps =
    [
        new(0, "Opportunity", "Account source", "Select Opportunity", "Choose the CRM opportunity and account that will anchor this submission.", "bi-trophy"),
        new(1, "LOB", "Coverage", "Line of Business", "Select the coverage line and optional coverage focus for market appetite.", "bi-layers"),
        new(2, "Details", "Risk profile", "Submission Details", "Enter dates, priority, premium target, risk state, and team assignment.", "bi-clipboard2-check"),
        new(3, "Markets", "Distribution", "Target Markets", "Select recommended carriers based on appetite, state, and line of business.", "bi-bank"),
        new(4, "Packet", "Documents", "Forms & Documents", "Stage ACORD forms and document placeholders for the submission detail workflow.", "bi-paperclip"),
        new(5, "Review", "Create", "Review & Create", "Validate the intake and create the submission through the existing API workflow.", "bi-check2-square")
    ];

    readonly LobCard[] _lobCards =
    [
        new("General Liability", "General Liability", "bi-shield-check", "#2563eb", "Premises, operations, products, and completed ops", ["Commercial General Liability", "Products-Completed Ops", "Premises Ops"]),
        new("Commercial Property", "Commercial Property", "bi-building", "#7c3aed", "Buildings, BPP, BI, equipment, and schedules", ["Building Only", "Contents Only", "Building & Contents", "BOP"]),
        new("Commercial Auto", "Commercial Auto", "bi-truck", "#d97706", "Fleet, hired/non-owned, symbols, and filings", ["Business Auto", "Hired & Non-Owned", "Fleet Auto"]),
        new("Workers Comp", "Workers Comp", "bi-person-badge", "#059669", "Payroll, class codes, experience mods, and states", ["Standard WC", "USL&H", "Employers Liability"]),
        new("Umbrella / Excess", "Umbrella / Excess", "bi-umbrella", "#dc2626", "Layered liability towers and attachment points", ["Commercial Umbrella", "Excess Liability"]),
        new("Professional Liab.", "Professional Liab.", "bi-briefcase", "#0891b2", "E&O, cyber, EPLI, D&O, and management liability", ["E&O", "D&O", "Cyber", "EPLI"]),
        new("Home / Dwelling", "Home / Dwelling", "bi-house", "#65a30d", "Personal residential property placements", ["Homeowners", "Dwelling Fire", "Renters"]),
        new("Personal Auto", "Personal Auto", "bi-car-front", "#f59e0b", "Personal auto, motorcycles, and collector cars", ["Personal Auto", "Motorcycle", "Collector Car"])
    ];

