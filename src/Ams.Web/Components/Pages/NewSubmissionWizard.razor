    StepDef CurrentStep => _steps[_step];
    int OpportunityCount => _opportunities.Count;
    string TargetPremiumDisplay => _form.TargetPremium.GetValueOrDefault() > 0 ? _form.TargetPremium.GetValueOrDefault().ToString("C0") : "Not set";
    bool HasOpportunity => _form.OpportunityId.HasValue && _form.AccountId.HasValue;
    bool HasLob => !string.IsNullOrWhiteSpace(_form.LineOfBusiness);
    bool HasDetails => _form.EffectiveDate != default && _form.ExpirationDate > _form.EffectiveDate && !string.IsNullOrWhiteSpace(_form.Priority) && !string.IsNullOrWhiteSpace(_form.RiskState);
    bool CanCreate => HasOpportunity && HasLob && HasDetails;
    bool CanAdvanceCurrentStep => _step switch
    {
        0 => HasOpportunity,
        1 => HasLob,
        2 => HasDetails,
        _ => true
    };
    int ReadinessPercent => Math.Min(100, (HasOpportunity ? 20 : 0) + (HasLob ? 20 : 0) + (HasDetails ? 25 : 0) + (_selectedCarrierIds.Any() ? 20 : 0) + (_selectedFormIds.Any() ? 15 : 0));
    int ImportanceScore => CalculateImportanceScore();
    string ImportanceLabel => ImportanceScore >= 85 ? "Critical" : ImportanceScore >= 70 ? "High" : ImportanceScore >= 50 ? "Medium" : "Standard";
    IEnumerable<string> SelectedLobSublines => _lobCards.FirstOrDefault(x => x.Key == _form.LineOfBusiness)?.SubLines ?? [];
    IEnumerable<OpportunityOption> FilteredOpportunities => string.IsNullOrWhiteSpace(_searchText)
        ? _opportunities
        : _opportunities.Where(x => x.OpportunityName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) || Safe(x.AccountName, string.Empty).Contains(_searchText, StringComparison.OrdinalIgnoreCase));
    IEnumerable<CarrierRow> SortedCarriers => _carriers.OrderByDescending(c => c.AppetiteLobs.Contains(_form.LineOfBusiness)).ThenByDescending(c => c.Preferred).ThenBy(c => c.Name);
    IEnumerable<string> SelectedCarrierNames => _selectedCarrierIds.Select(id => _carriers.FirstOrDefault(c => c.Id == id)?.Name).Where(name => !string.IsNullOrWhiteSpace(name))!;
    IEnumerable<string> ImportanceReasons => BuildImportanceReasons();
    string ConfirmIconClass => _confirmKind == "danger" ? "nsw-confirm-icon nsw-confirm-icon--danger" : "nsw-confirm-icon";
    string ConfirmButtonClass => _confirmKind == "danger" ? "nsw-btn nsw-btn--danger" : "nsw-btn nsw-btn--primary";

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Submissions", "/submissions"), new("New Submission", "/submissions/new"));
        _form.EffectiveDate = DateTime.Today.AddDays(30);
        _form.ExpirationDate = DateTime.Today.AddDays(395);
        _form.Priority = "Standard";
        _form.RiskState = "TX";
        await ResolveCurrentUserContextAsync();
        await LoadOpportunitiesAsync();
    }

    protected override void OnParametersSet()
    {
        if (OpportunityId.HasValue && _form.OpportunityId is null)
        {
            _form.OpportunityId = OpportunityId.Value;
            _form.AccountId = AccountId;
            _form.OpportunityName = "Selected opportunity";
            _form.AccountName = AccountName ?? "Selected account";
        }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    async Task LoadOpportunitiesAsync()
    {
        _loading = true;
        _refreshIconClass = "nsw-spin";
        _loadError = null;
        try
        {
            var result = await Api.SearchOpportunitiesAsync(_tenantId, _searchText, 1, 100);
            _opportunities.Clear();
            foreach (var opportunity in result?.Items ?? [])
            {
                _opportunities.Add(new OpportunityOption(opportunity.OpportunityId, opportunity.AccountId, opportunity.AccountName ?? "Account pending", opportunity.OpportunityName, opportunity.EstimatedAmount, opportunity.StageName, opportunity.WinProbability, opportunity.CloseDate, opportunity.OwnerName));
            }

            if (OpportunityId.HasValue)
            {
                var match = _opportunities.FirstOrDefault(x => x.OpportunityId == OpportunityId.Value);
                if (match is not null)
                {
                    SelectOpportunity(match);
                }
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Unable to load opportunities: {ex.Message}";
            ShowToast(_loadError, true);
        }
        finally
        {
            _loading = false;
            _refreshIconClass = string.Empty;
        }
    }

    void SetStep(int step) => _step = Math.Clamp(step, 0, _steps.Length - 1);
    void GoPrev() { if (_step > 0) _step--; }
    void GoNext() { if (CanAdvanceCurrentStep && _step < _steps.Length - 1) _step++; }
    void GoToCriticalFields() => _step = !HasOpportunity ? 0 : !HasLob ? 1 : !HasDetails ? 2 : 5;
    void ReviewSubmission() => _step = 5;

    void SelectOpportunity(OpportunityOption opportunity)
    {
        _form.OpportunityId = opportunity.OpportunityId;
        _form.AccountId = opportunity.AccountId;
        _form.OpportunityName = opportunity.OpportunityName;
        _form.AccountName = opportunity.AccountName;
        if (_form.TargetPremium.GetValueOrDefault() <= 0 && opportunity.EstimatedAmount > 0)
        {
            _form.TargetPremium = opportunity.EstimatedAmount;
        }
    }

    void SelectLob(string lob)
    {
        _form.LineOfBusiness = lob;
        _form.SubLine = string.Empty;
        SelectRequiredForms();
    }

    void ToggleCarrier(string id)
    {
        if (!_selectedCarrierIds.Add(id)) _selectedCarrierIds.Remove(id);
    }

    void SelectRecommendedMarkets()
    {
        _selectedCarrierIds.Clear();
        foreach (var carrier in SortedCarriers.Where(c => c.AppetiteLobs.Contains(_form.LineOfBusiness)).Take(4))
        {
            _selectedCarrierIds.Add(carrier.Id);
        }
        ShowToast("Recommended markets selected.");
    }

    void ToggleForm(string id)
    {
        if (!_selectedFormIds.Add(id)) _selectedFormIds.Remove(id);
    }

    void SelectRequiredForms()
    {
        _selectedFormIds.Add("af-125");
        foreach (var form in _acordForms.Where(f => f.Lobs.Contains(_form.LineOfBusiness, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedFormIds.Add(form.Id);
        }
        ShowToast("Required forms selected.");
    }

    void ApplyRushWorkflow()
    {
        _form.IsRush = true;
        _form.Priority = "Urgent";
        _form.EffectiveDate = DateTime.Today.AddDays(14);
        _form.ExpirationDate = _form.EffectiveDate.AddYears(1);
        ShowToast("Rush workflow applied.");
        _step = 2;
    }

    void SimulateUpload()
    {
        var name = $"Supporting document {_uploadedFiles.Count + 1}.pdf";
        _uploadedFiles.Add(name);
        ShowToast($"{name} staged for detail upload.");
    }

    void ConfirmRemoveFile(string fileName)
    {
        _pendingAction = "remove-file";
        _pendingFileRemoval = fileName;
        _confirmTitle = "Remove staged document";
        _confirmMessage = $"Remove {fileName} from this intake packet?";
        _confirmButtonText = "Remove";
        _confirmIcon = "bi-trash";
        _confirmKind = "danger";
        _showConfirmDialog = true;
    }

    void SaveDraft() => ShowToast("Draft retained in this browser session.");

    void ConfirmCancel()
    {
        if (ReadinessPercent > 0)
        {
            _pendingAction = "cancel";
            _confirmTitle = "Discard submission intake";
            _confirmMessage = "Leave this page and discard the current intake data?";
            _confirmButtonText = "Discard";
            _confirmIcon = "bi-exclamation-triangle";
            _confirmKind = "danger";
            _showConfirmDialog = true;
        }
        else
        {
            Nav.NavigateTo("/submissions");
        }
    }

    void OpenCreateConfirm()
    {
        if (!CanCreate)
        {
            HandleInvalidSubmit();
            return;
        }
        _pendingAction = "create";
        _confirmTitle = "Create submission";
        _confirmMessage = $"Create a {_form.Priority} {_form.LineOfBusiness} submission for {_form.AccountName}? Markets and documents can be finalized from the submission detail workflow after creation.";
        _confirmButtonText = "Create Submission";
        _confirmIcon = "bi-send-fill";
        _confirmKind = "primary";
        _showConfirmDialog = true;
    }

    void CloseConfirmDialog()
    {
        if (_submitting) return;
        _showConfirmDialog = false;
        _pendingAction = null;
        _pendingFileRemoval = null;
    }

    async Task ExecuteConfirmedActionAsync()
    {
        if (_pendingAction == "create")
        {
            await SubmitAsync();
        }
        else if (_pendingAction == "remove-file" && _pendingFileRemoval is not null)
        {
            _uploadedFiles.Remove(_pendingFileRemoval);
            ShowToast($"{_pendingFileRemoval} removed.");
            CloseConfirmDialog();
        }
        else if (_pendingAction == "cancel")
        {
            Nav.NavigateTo("/submissions");
        }
    }

    async Task SubmitAsync()
    {
        _submitting = true;
        try
        {
            var request = new CreateSubmissionRequest(
                TenantId: _tenantId,
                AccountId: _form.AccountId!.Value,
                OpportunityId: _form.OpportunityId!.Value,
                LineOfBusiness: _form.LineOfBusiness,
                Priority: _form.Priority,
                EffectiveDate: _form.EffectiveDate,
                ExpirationDate: _form.ExpirationDate,
                TargetPremium: _form.TargetPremium > 0 ? _form.TargetPremium : null,
                AssignedToUserId: null);

            var newId = await Api.CreateSubmissionAsync(request);
            ShowToast("Submission created successfully.");
            await Task.Delay(700);
            Nav.NavigateTo($"/submissions/{newId}");
        }
        catch (Exception ex)
        {
            ShowToast($"Create failed: {ex.Message}", true);
        }
        finally
        {
            _submitting = false;
            _showConfirmDialog = false;
        }
    }

    void HandleInvalidSubmit()
    {
        GoToCriticalFields();
        ShowToast("Complete required submission fields before creating.", true);
    }

    int CalculateImportanceScore()
    {
        var score = 35;
        if (_form.TargetPremium >= 100000) score += 25;
        else if (_form.TargetPremium >= 50000) score += 18;
        else if (_form.TargetPremium >= 25000) score += 10;
        if (_form.Priority == "Urgent") score += 20;
        else if (_form.Priority == "High") score += 12;
        if (_form.IsRush) score += 10;
        if ((_form.EffectiveDate - DateTime.Today).TotalDays <= 21) score += 10;
        if (_selectedCarrierIds.Count >= 4) score += 8;
        return Math.Min(100, score);
    }

    IEnumerable<string> BuildImportanceReasons()
    {
        if (_form.TargetPremium > 0) yield return $"Premium target {TargetPremiumDisplay}";
        if (_form.Priority is "High" or "Urgent") yield return $"{_form.Priority} priority selected";
        if (_form.IsRush) yield return "Rush workflow enabled";
        if ((_form.EffectiveDate - DateTime.Today).TotalDays <= 21) yield return "Near-term effective date";
        if (_selectedCarrierIds.Any()) yield return $"{_selectedCarrierIds.Count} market targets selected";
        if (!_selectedCarrierIds.Any() && _form.TargetPremium <= 0 && _form.Priority is "Low" or "Standard") yield return "Standard intake profile";
    }

    string StepClass(int index) => index == _step ? "nsw-tab nsw-tab--active" : index < _step ? "nsw-tab nsw-tab--done" : "nsw-tab";
    string StepStateText(int index) => index switch
    {
        0 => HasOpportunity ? "Done" : "Open",
        1 => HasLob ? "Done" : "Open",
        2 => HasDetails ? "Done" : "Open",
        3 => _selectedCarrierIds.Count.ToString(),
        4 => _selectedFormIds.Count.ToString(),
        _ => CanCreate ? "Ready" : "Open"
    };

    string KpiClass(string key, string color) => _activeKpi == key ? $"nsw-kpi nsw-kpi--{color} nsw-kpi--active" : $"nsw-kpi nsw-kpi--{color}";
    RenderFragment KpiCard(string key, string label, string value, string description, string icon, string color) => @<button type="button" class="@KpiClass(key, color)" title="@description" @onclick="() => SetKpi(key)"><span><i class="bi @icon" aria-hidden="true"></i>@label</span><strong>@value</strong><small>@description</small></button>;
    void SetKpi(string key)
    {
        _activeKpi = key;
        if (key == "opportunity") _step = 0;
        else if (key == "markets") _step = 3;
        else if (key == "forms") _step = 4;
        else if (key is "importance" or "premium") _step = 2;
    }

    RenderFragment ReviewCard(string title, string icon, int editStep, string value, string subValue) => @<div class="nsw-review-card"><div class="nsw-review-card__head"><span><i class="bi @icon" aria-hidden="true"></i>@title</span><button type="button" class="nsw-link-button" @onclick="() => _step = editStep">Edit</button></div><strong>@Safe(value, "â€”")</strong><small>@Safe(subValue, "â€”")</small></div>;

    string CarrierAppetiteText(CarrierRow carrier) => carrier.AppetiteLobs.Contains(_form.LineOfBusiness) ? "Appetite match" : "Available market";
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string ToastIconClass(ToastMessage toast) => toast.CssClass.Contains("danger", StringComparison.OrdinalIgnoreCase) ? "bi-exclamation-triangle" : "bi-check-circle";

    void ShowToast(string message, bool danger = false)
    {
        var toast = new ToastMessage(Guid.NewGuid(), message, danger ? "nsw-toast--danger" : "nsw-toast--success");
        _toasts.Insert(0, toast);
        if (_toasts.Count > 4) _toasts.RemoveAt(_toasts.Count - 1);
    }

    void DismissToast(Guid id) => _toasts.RemoveAll(t => t.Id == id);

    sealed class SubmissionIntakeForm
    {
        [Required]
        public Guid? OpportunityId { get; set; }

        [Required]
        public Guid? AccountId { get; set; }

        [Required, StringLength(200)]
        public string OpportunityName { get; set; } = string.Empty;

        [Required, StringLength(200)]
        public string AccountName { get; set; } = string.Empty;

        [Required, StringLength(100)]
        public string LineOfBusiness { get; set; } = string.Empty;

        [StringLength(100)]
        public string SubLine { get; set; } = string.Empty;

        [Required, StringLength(50)]
        public string Priority { get; set; } = "Standard";

        [Required]
        public DateTime EffectiveDate { get; set; }

        [Required]
        public DateTime ExpirationDate { get; set; }

        [Range(0, 999999999999)]
        public decimal? TargetPremium { get; set; }

        [Required, StringLength(2)]
        public string RiskState { get; set; } = "TX";

        [StringLength(200)]
        public string NamedInsured { get; set; } = string.Empty;

        [StringLength(150)]
        public string ProducerName { get; set; } = string.Empty;

        [StringLength(150)]
        public string CsrName { get; set; } = string.Empty;

        [StringLength(1000)]
        public string Description { get; set; } = string.Empty;

        [StringLength(1000)]
        public string InternalNotes { get; set; } = string.Empty;

        public bool IsRush { get; set; }
    }

    sealed record StepDef(int Index, string Label, string Kicker, string Title, string Description, string Icon);
    sealed record LobCard(string Key, string Label, string Icon, string Color, string Description, string[] SubLines);
    sealed record CarrierRow(string Id, string Name, string AMBest, string[] AppetiteLobs, bool Preferred, string[] States);
    sealed record AcordForm(string Id, string Number, string Title, string Lobs, bool Required);
    sealed record OpportunityOption(Guid OpportunityId, Guid AccountId, string AccountName, string OpportunityName, decimal EstimatedAmount, string? StageName, decimal WinProbability, DateTime? CloseDate, string? OwnerName);
    sealed record ToastMessage(Guid Id, string Message, string CssClass);
}
