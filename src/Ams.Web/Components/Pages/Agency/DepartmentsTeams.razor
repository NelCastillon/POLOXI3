@page "/admin/agency/teams"
@page "/tenant/agency/teams"
@namespace Ams.Web.Components.Pages.AgencyAdmin
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject IJSRuntime Js

<PageTitle>Teams â€” Agency Setup</PageTitle>

<AppPageHeader Title="Teams"
               Subtitle="Enterprise team ownership, department alignment, member capacity, and operating status."
               Icon="bi-people-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_loading" title="Refresh teams">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <a class="um-btn um-btn-ghost" href="/tenant/agency/branches"><i class="bi bi-diagram-3" aria-hidden="true"></i> Branches</a>
        <a class="um-btn um-btn-ghost" href="/tenant/agency/departments"><i class="bi bi-building" aria-hidden="true"></i> Departments</a>
        <button class="um-btn um-btn-primary" type="button" @onclick="OpenAddModal">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Team
        </button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="dt-toast @_toastClass" role="status">
        <i class="bi @(_toastClass == "dt-toast--danger" ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="dt-toast-close" @onclick="ClearToast" aria-label="Dismiss message"><i class="bi bi-x-lg"></i></button>
    </div>
}

<div class="dt-page">
    <section class="dt-hero">
        <div class="dt-hero-main">
            <span class="dt-eyebrow"><i class="bi bi-command" aria-hidden="true"></i> Tenant Â· Agency Structure</span>
            <h2>Team Command Center</h2>
            <p>Coordinate team ownership, department alignment, workload capacity, and operating status for service, sales, underwriting, claims, and support workflows.</p>
            <div class="dt-hero-meta">
                <span><i class="bi bi-people" aria-hidden="true"></i> @_totalCount teams</span>
                <span><i class="bi bi-check-circle" aria-hidden="true"></i> @_activeCount active</span>
                <span><i class="bi bi-person-lines-fill" aria-hidden="true"></i> @_memberCount members</span>
            </div>
        </div>
        <div class="dt-hero-panel">
            <div class="dt-readiness-card">
                <span>Team readiness</span>
                <strong>@ReadinessScore%</strong>
                <div class="dt-score-track"><div style="width:@ReadinessScore%"></div></div>
                <small>@ReadinessSummary</small>
            </div>
            <div class="dt-action-list">
                @foreach (var action in PriorityActions)
                {
                    <button type="button" class="dt-action-item" @onclick="() => RunPriorityAction(action)">
                        <i class="bi @action.Icon" aria-hidden="true"></i>
                        <span><strong>@action.Title</strong><small>@action.Detail</small></span>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="dt-kpi-strip" aria-label="Team KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="dt-kpi-card @(IsActiveTab(kpi.Key) ? "dt-kpi-card--active" : null)" title="@kpi.Tooltip" @onclick="() => SetTab(kpi.Key)">
                <span class="dt-kpi-icon dt-kpi-icon--@kpi.Tone"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="dt-kpi-label">@kpi.Label</span>
                <strong>@kpi.Value</strong>
                <small>@kpi.Detail</small>
            </button>
        }
    </section>

    <section class="dt-command-bar">
        <div class="dt-tabs" role="tablist" aria-label="Team sections">
            @foreach (var tab in Tabs)
            {
                <button type="button" role="tab" class="dt-tab @(IsActiveTab(tab.Key) ? "dt-tab--active" : null)" @onclick="() => SetTab(tab.Key)">
                    <i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label
                </button>
            }
        </div>
        <div class="dt-command-actions">
            <button class="um-btn um-btn-ghost" type="button" @onclick="CopySummaryAsync" disabled="@(!_allEntries.Any())"><i class="bi bi-clipboard" aria-hidden="true"></i> Copy Summary</button>
            <button class="um-btn um-btn-ghost" type="button" @onclick="ClearFilters"><i class="bi bi-x-circle" aria-hidden="true"></i> Clear Filters</button>
            <button class="um-btn um-btn-primary" type="button" @onclick="OpenAddModal"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Team</button>
        </div>
    </section>

    <section class="dt-filter-bar" aria-label="Team filters">
        <div class="dt-search-box">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input class="um-input" value="@_search" @oninput="@(args => { _search = args.Value?.ToString() ?? string.Empty; ApplyFilters(); })" placeholder="Search team name, code, department, lead, description, or statusâ€¦" />
        </div>
        <select class="um-input dt-department-filter" value="@_filterDepartment" @onchange="@(args => { _filterDepartment = args.Value?.ToString() ?? string.Empty; ApplyFilters(); })" aria-label="Filter by department">
            <option value="">All Departments</option>
            @foreach (var department in DepartmentFilterOptions)
            {
                <option value="@department">@department</option>
            }
        </select>
        <label class="dt-toggle-label">
            <input type="checkbox" checked="@_activeOnly" @onchange="@(args => ToggleActiveOnly(args.Value is bool value && value))" />
            Active only
        </label>
        <span class="dt-result-count">@FilteredEntries.Count team(s) shown</span>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger dt-load-error" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError
        </div>
    }

    <section class="dt-content-grid">
        <div class="dt-main-panel">
            @if (_loading)
            {
                <div class="dt-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading teams...</div>
            }
            else if (!_allEntries.Any())
            {
                <div class="dt-empty-state">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <strong>No teams configured</strong>
                    <span>Create the first operating team to coordinate department capacity and workflow ownership.</span>
                    <button class="um-btn um-btn-primary" type="button" @onclick="OpenAddModal"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Team</button>
                </div>
            }
            else
            {
                @if (ShowTab("overview"))
                {
                    <section class="dt-section">
                        <div class="dt-section-header"><i class="bi bi-speedometer2" aria-hidden="true"></i><div><strong>Executive Overview</strong><span>Most important team governance and capacity signals.</span></div></div>
                        <div class="dt-overview-grid">
                            <div class="dt-identity-card"><span class="dt-module-icon dt-module-icon--blue"><i class="bi bi-people-fill"></i></span><div><strong>@_totalCount teams</strong><span>@_activeCount active Â· @_inactiveCount inactive</span></div></div>
                            <div class="dt-identity-card"><span class="dt-module-icon dt-module-icon--green"><i class="bi bi-person-lines-fill"></i></span><div><strong>@_memberCount members</strong><span>@TeamsWithMembers team(s) with capacity</span></div></div>
                            <div class="dt-identity-card"><span class="dt-module-icon dt-module-icon--purple"><i class="bi bi-building"></i></span><div><strong>@_deptCount departments</strong><span>@TeamsWithoutDepartments team(s) unassigned</span></div></div>
                        </div>
                        <div class="dt-team-board">
                            @foreach (var team in FilteredEntries.Take(6))
                            {
                                <button type="button" class="dt-team-card @(SelectedTeam?.TeamId == team.TeamId ? "dt-team-card--selected" : null)" @onclick="() => SelectTeam(team)">
                                    <span class="dt-team-avatar">@Initials(team.TeamName)</span>
                                    <span class="dt-team-content"><strong>@team.TeamName</strong><small>@CodeText(team) Â· @DepartmentText(team)</small></span>
                                    <span class="dt-status @(team.IsActive ? "dt-status--active" : "dt-status--inactive")">@(team.IsActive ? "Active" : "Inactive")</span>
                                </button>
                            }
                        </div>
                    </section>
                }

                @if (ShowTab("directory") || ShowTab("active") || ShowTab("inactive") || ShowTab("members") || ShowTab("departments") || ShowTab("leads"))
                {
                    <section class="dt-section">
                        <div class="dt-section-header"><i class="bi bi-list-ul" aria-hidden="true"></i><div><strong>@DirectoryTitle</strong><span>Native team directory with clickable rows and inline actions.</span></div></div>
                        <div class="dt-table-wrap">
                            <table class="dt-table">
                                <thead>
                                    <tr>
                                        <th>Team</th>
                                        <th>Department</th>
                                        <th>Lead</th>
                                        <th>Members</th>
                                        <th>Status</th>
                                        <th class="dt-actions-col">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var team in FilteredEntries)
                                    {
                                        <tr class="@(SelectedTeam?.TeamId == team.TeamId ? "dt-row--selected" : null)" @onclick="() => SelectTeam(team)">
                                            <td><div class="dt-name-cell"><span class="dt-icon" aria-hidden="true"><i class="bi bi-people"></i></span><div><strong>@team.TeamName</strong><small>@CodeText(team)</small></div></div></td>
                                            <td>@DepartmentText(team)</td>
                                            <td>@LeadText(team)</td>
                                            <td><span class="dt-pill"><i class="bi bi-person-lines-fill" aria-hidden="true"></i> @team.MemberCount</span></td>
                                            <td><span class="dt-status @(team.IsActive ? "dt-status--active" : "dt-status--inactive")">@(team.IsActive ? "Active" : "Inactive")</span></td>
                                            <td class="dt-row-actions" @onclick:stopPropagation="true">
                                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditModal(team)" title="Edit team"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ConfirmDelete(team)" title="Delete team"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            }
        </div>

        <aside class="dt-side-panel" aria-label="Team details and governance">
            <div class="dt-side-card">
                <div class="dt-side-header"><i class="bi bi-people-fill" aria-hidden="true"></i><div><strong>Selected team</strong><span>@(SelectedTeam is null ? "Choose a row or card" : SelectedTeam.TeamName)</span></div></div>
                @if (SelectedTeam is null)
                {
                    <p class="dt-side-copy">Select a team to review department alignment, lead ownership, member capacity, and available actions.</p>
                }
                else
                {
                    <div class="dt-selected-summary">
                        <span class="dt-selected-avatar">@Initials(SelectedTeam.TeamName)</span>
                        <div><strong>@SelectedTeam.TeamName</strong><small>@CodeText(SelectedTeam)</small></div>
                    </div>
                    <dl class="dt-detail-list">
                        <div><dt>Department</dt><dd>@DepartmentText(SelectedTeam)</dd></div>
                        <div><dt>Team Lead</dt><dd>@LeadText(SelectedTeam)</dd></div>
                        <div><dt>Members</dt><dd>@SelectedTeam.MemberCount</dd></div>
                        <div><dt>Status</dt><dd>@(SelectedTeam.IsActive ? "Active" : "Inactive")</dd></div>
                    </dl>
                    <div class="dt-selected-actions">
                        <button type="button" class="um-btn um-btn-primary" @onclick="() => OpenEditModal(SelectedTeam)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                        <a class="um-btn um-btn-ghost" href="/tenant/agency/departments"><i class="bi bi-building" aria-hidden="true"></i> Departments</a>
                    </div>
                }
            </div>
            <div class="dt-side-card">
                <div class="dt-side-header"><i class="bi bi-list-check" aria-hidden="true"></i><div><strong>Readiness checklist</strong><span>@ChecklistComplete of @Checklist.Count complete</span></div></div>
                <div class="dt-checklist">
                    @foreach (var item in Checklist)
                    {
                        <div class="dt-check-item @(item.Done ? "dt-check-item--done" : null)"><i class="bi @(item.Done ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i><span>@item.Text</span></div>
                    }
                </div>
            </div>
            <div class="dt-side-card">
                <div class="dt-side-header"><i class="bi bi-diagram-3" aria-hidden="true"></i><div><strong>Workflow impact</strong><span>Where team data matters</span></div></div>
                <div class="dt-impact-list">
                    <span><i class="bi bi-router" aria-hidden="true"></i> Work queue routing</span>
                    <span><i class="bi bi-person-check" aria-hidden="true"></i> Ownership assignment</span>
                    <span><i class="bi bi-bar-chart" aria-hidden="true"></i> Capacity reporting</span>
                    <span><i class="bi bi-clock-history" aria-hidden="true"></i> SLA operations</span>
                </div>
            </div>
        </aside>
    </section>
</div>

@if (_showForm)
{
    <div class="dt-modal-backdrop" role="presentation">
        <div class="dt-modal" role="dialog" aria-modal="true" aria-labelledby="team-form-title">
            <EditForm EditContext="@_editContext" OnValidSubmit="SaveTeamAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header">
                    <i class="bi bi-people-fill" aria-hidden="true"></i>
                    <span id="team-form-title">@(_form.TeamId == Guid.Empty ? "New Team" : "Edit Team")</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div>
                            <label class="dt-form-label">Team Name *</label>
                            <InputText class="um-input" @bind-Value="_form.TeamName" placeholder="Commercial Service Team" />
                        </div>
                        <div>
                            <label class="dt-form-label">Team Code</label>
                            <InputText class="um-input dt-mono" @bind-Value="_form.TeamCode" placeholder="COMM-SVC" />
                        </div>
                        <div>
                            <label class="dt-form-label">Department</label>
                            <InputSelect class="um-input" @bind-Value="_form.DepartmentId">
                                <option value="">Select department</option>
                                @foreach (var department in _departmentOptions)
                                {
                                    <option value="@department.DepartmentId">@department.DepartmentName</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <label class="dt-form-label">Team Lead</label>
                            <InputText class="um-input" @bind-Value="_form.TeamLead" placeholder="Full name" />
                        </div>
                        <div>
                            <label class="dt-form-label">Member Count</label>
                            <InputNumber class="um-input" @bind-Value="_form.MemberCount" />
                        </div>
                        <div>
                            <label class="dt-toggle-card">
                                <InputCheckbox @bind-Value="_form.IsActive" />
                                <span><strong>Active team</strong><small>Available for workflow assignment and reporting.</small></span>
                            </label>
                        </div>
                        <div class="dt-form-section dt-form-section--full">
                            <label class="dt-form-label">Description</label>
                            <InputTextArea class="um-input" @bind-Value="_form.Description" placeholder="Describe team responsibilities, service scope, or workflow ownership." />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="um-spinner um-spinner-sm" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-floppy" aria-hidden="true"></i>
                        }
                        Save Team
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_deleteTarget is not null)
{
    <div class="dt-modal-backdrop" role="presentation">
        <div class="dt-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="delete-team-title">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash" aria-hidden="true"></i></div>
                <div>
                    <h3 id="delete-team-title">Delete team?</h3>
                    <p class="dt-confirm-copy">This will remove <strong>@_deleteTarget.TeamName</strong> from agency team assignments and reporting.</p>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="um-btn um-btn-danger" @onclick="DeleteTeamAsync" disabled="@_deleting"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<TeamEntry> _allEntries = [];
    private List<TeamEntry> _entries = [];
    private List<DepartmentOption> _departmentOptions = [];
    private bool _loading;
    private bool _saving;
    private bool _deleting;
    private bool _showForm;
    private string _search = string.Empty;
    private string _filterDepartment = string.Empty;
    private bool _activeOnly;
    private string _activeTab = "overview";
    private string? _loadError;
    private string? _toastMessage;
    private string _toastClass = string.Empty;
    private TeamEntry? SelectedTeam;
    private TeamEntry? _deleteTarget;
    private TeamForm _form = new();
    private EditContext _editContext = default!;

    private IReadOnlyList<TeamEntry> FilteredEntries => _entries;
    private int _totalCount => _allEntries.Count;
    private int _activeCount => _allEntries.Count(e => e.IsActive);
    private int _inactiveCount => _totalCount - _activeCount;
    private int _memberCount => _allEntries.Sum(e => e.MemberCount);
    private int _deptCount => _allEntries.Where(e => !string.IsNullOrWhiteSpace(e.Department)).Select(e => e.Department).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private int TeamsWithMembers => _allEntries.Count(e => e.MemberCount > 0);
    private int TeamsWithoutDepartments => _allEntries.Count(e => string.IsNullOrWhiteSpace(e.Department));
    private int TeamsWithLeads => _allEntries.Count(e => !string.IsNullOrWhiteSpace(e.TeamLead));
    private int TeamsMissingLeads => _allEntries.Count(e => string.IsNullOrWhiteSpace(e.TeamLead));
    private int ChecklistComplete => Checklist.Count(i => i.Done);
    private int ReadinessScore => Math.Clamp((ChecklistComplete * 100) / Math.Max(Checklist.Count, 1), 0, 100);
    private string ReadinessSummary => ReadinessScore switch
    {
        >= 90 => "Team structure is enterprise ready.",
        >= 70 => "Minor capacity cleanup recommended.",
        >= 40 => "Team governance needs attention.",
        _ => "Create core operating teams."
    };

    private IReadOnlyList<string> DepartmentFilterOptions => _allEntries
        .Where(e => !string.IsNullOrWhiteSpace(e.Department))
        .Select(e => e.Department)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private string DirectoryTitle => _activeTab switch
    {
        "active" => "Active Teams",
        "inactive" => "Inactive Teams",
        "members" => "Teams With Members",
        "departments" => "Department-Aligned Teams",
        "leads" => "Team Lead Coverage",
        _ => "Team Directory"
    };

    private IReadOnlyList<KpiCard> Kpis =>
    [
        new("overview", "Teams", _totalCount.ToString(), "Total operating teams", "bi-people-fill", "blue", "Show team overview"),
        new("active", "Active", _activeCount.ToString(), "Available for assignment", "bi-check-circle-fill", "green", "Show active teams"),
        new("members", "Members", _memberCount.ToString(), $"{TeamsWithMembers} team(s) staffed", "bi-person-lines-fill", "purple", "Show teams with members"),
        new("departments", "Departments", _deptCount.ToString(), $"{TeamsWithoutDepartments} unassigned", "bi-building", TeamsWithoutDepartments > 0 ? "amber" : "slate", "Show department aligned teams"),
        new("leads", "Leads", TeamsWithLeads.ToString(), $"{TeamsMissingLeads} missing lead", "bi-person-badge", TeamsMissingLeads > 0 ? "red" : "slate", "Show lead ownership")
    ];

    private IReadOnlyList<NavTab> Tabs =>
    [
        new("overview", "Overview", "bi-speedometer2"),
        new("directory", "Directory", "bi-list-ul"),
        new("active", "Active", "bi-check-circle"),
        new("inactive", "Inactive", "bi-dash-circle"),
        new("members", "Members", "bi-person-lines-fill"),
        new("departments", "Departments", "bi-building"),
        new("leads", "Leads", "bi-person-badge")
    ];

    private IReadOnlyList<PriorityAction> PriorityActions =>
    [
        new("Add team", "Create a workflow unit", "bi-plus-circle", "add"),
        new("Review leads", "Identify missing ownership", "bi-person-badge", "leads"),
        new("Review departments", "Confirm team alignment", "bi-building", "departments")
    ];

    private IReadOnlyList<ChecklistItem> Checklist =>
    [
        new(_totalCount > 0, "At least one team is configured"),
        new(_activeCount > 0, "At least one active team is available"),
        new(TeamsWithLeads == _totalCount && _totalCount > 0, "Every team has a lead"),
        new(TeamsWithoutDepartments == 0 && _totalCount > 0, "Every team is assigned to a department"),
        new(TeamsWithMembers > 0, "At least one team has member capacity")
    ];

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_form);
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;

        Breadcrumbs.SetCrumbs(
            new("Home", "/"),
            new("Agency Setup", "/tenant/agency/profile"),
            new("Teams", "/tenant/agency/teams"));

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var departments = await Api.GetDepartmentsAsync(_tenantId);
            _departmentOptions = (departments ?? [])
                .Where(d => d.IsActive)
                .OrderBy(d => d.DepartmentName)
                .Select(d => new DepartmentOption(d.DepartmentId, d.DepartmentName))
                .ToList();

            var teams = await Api.GetTeamsAsync(_tenantId);
            _allEntries = teams?.Select(TeamEntry.FromDto).OrderBy(e => e.Department).ThenBy(e => e.TeamName).ToList() ?? [];
            ApplyFilters();
            SelectedTeam = SelectedTeam is null
                ? _entries.FirstOrDefault()
                : _allEntries.FirstOrDefault(e => e.TeamId == SelectedTeam.TeamId) ?? _entries.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Load failed: {ex.Message}";
            ShowToast($"Error loading teams: {ex.Message}", true);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters()
    {
        _entries = _allEntries.Where(e =>
            (_activeTab switch
            {
                "active" => e.IsActive,
                "inactive" => !e.IsActive,
                "members" => e.MemberCount > 0,
                "departments" => !string.IsNullOrWhiteSpace(e.Department),
                "leads" => !string.IsNullOrWhiteSpace(e.TeamLead),
                _ => true
            }) &&
            (string.IsNullOrWhiteSpace(_filterDepartment) || string.Equals(e.Department, _filterDepartment, StringComparison.OrdinalIgnoreCase)) &&
            (!_activeOnly || e.IsActive) &&
            (string.IsNullOrWhiteSpace(_search) ||
             e.TeamName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             e.TeamCode.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             e.Department.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             e.TeamLead.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             (e.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (e.IsActive ? "Active" : "Inactive").Contains(_search, StringComparison.OrdinalIgnoreCase))
        ).OrderByDescending(e => e.IsActive).ThenBy(e => e.Department).ThenBy(e => e.TeamName).ToList();

        if (SelectedTeam is not null && !_entries.Any(e => e.TeamId == SelectedTeam.TeamId))
        {
            SelectedTeam = _entries.FirstOrDefault();
        }
    }

    private void SetTab(string tab)
    {
        _activeTab = _activeTab == tab && tab != "overview" ? "overview" : tab;
        _activeOnly = _activeTab == "active";
        ApplyFilters();
    }

    private bool IsActiveTab(string tab) => string.Equals(_activeTab, tab, StringComparison.OrdinalIgnoreCase);
    private bool ShowTab(string tab) => IsActiveTab("overview") || IsActiveTab(tab);

    private void ToggleActiveOnly(bool value)
    {
        _activeOnly = value;
        ApplyFilters();
    }

    private void ClearFilters()
    {
        _search = string.Empty;
        _filterDepartment = string.Empty;
        _activeOnly = false;
        _activeTab = "overview";
        ApplyFilters();
    }

    private void SelectTeam(TeamEntry team) => SelectedTeam = team;

    private void RunPriorityAction(PriorityAction action)
    {
        if (action.TabKey == "add")
        {
            OpenAddModal();
            return;
        }
        SetTab(action.TabKey);
    }

    private void OpenAddModal()
    {
        _form = new TeamForm();
        _editContext = new EditContext(_form);
        _showForm = true;
    }

    private void OpenEditModal(TeamEntry team)
    {
        _form = TeamForm.FromEntry(team);
        _editContext = new EditContext(_form);
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private async Task SaveTeamAsync()
    {
        _saving = true;
        try
        {
            var team = _form.ToDto(_tenantId, _departmentOptions);
            if (_form.TeamId == Guid.Empty)
            {
                await Api.CreateTeamAsync(team, _tenantId);
            }
            else
            {
                await Api.UpdateTeamAsync(_form.TeamId, team);
            }

            _showForm = false;
            await LoadAsync();
            ShowToast("Team saved.");
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmDelete(TeamEntry team) => _deleteTarget = team;
    private void CancelDelete() => _deleteTarget = null;

    private async Task DeleteTeamAsync()
    {
        if (_deleteTarget is null)
        {
            return;
        }

        _deleting = true;
        try
        {
            await Api.DeleteTeamAsync(_deleteTarget.TeamId);
            _deleteTarget = null;
            await LoadAsync();
            ShowToast("Team deleted.");
        }
        catch (Exception ex)
        {
            ShowToast($"Delete failed: {ex.Message}", true);
        }
        finally
        {
            _deleting = false;
        }
    }

    private async Task CopySummaryAsync()
    {
        var summary = $"Teams: {_totalCount} total; {_activeCount} active; {_inactiveCount} inactive; {_memberCount} members; {_deptCount} departments; {TeamsWithLeads} lead-owned.";
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", summary);
        ShowToast("Team summary copied.");
    }

    private void ShowToast(string message, bool danger = false)
    {
        _toastMessage = message;
        _toastClass = danger ? "dt-toast--danger" : string.Empty;
    }

    private void ClearToast() => _toastMessage = null;

    private static string Initials(string value)
    {
        var words = value.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return words.Length switch
        {
            0 => "T",
            1 => words[0][0].ToString().ToUpperInvariant(),
            _ => string.Concat(words.Take(2).Select(w => char.ToUpperInvariant(w[0])))
        };
    }

    private static string CodeText(TeamEntry team) => string.IsNullOrWhiteSpace(team.TeamCode) ? "No code" : team.TeamCode;
    private static string DepartmentText(TeamEntry team) => string.IsNullOrWhiteSpace(team.Department) ? "Unassigned" : team.Department;
    private static string LeadText(TeamEntry team) => string.IsNullOrWhiteSpace(team.TeamLead) ? "Unassigned" : team.TeamLead;

    private sealed record KpiCard(string Key, string Label, string Value, string Detail, string Icon, string Tone, string Tooltip);
    private sealed record NavTab(string Key, string Label, string Icon);
    private sealed record PriorityAction(string Title, string Detail, string Icon, string TabKey);
    private sealed record ChecklistItem(bool Done, string Text);
    private sealed record DepartmentOption(Guid DepartmentId, string DepartmentName);

    private sealed class TeamEntry
    {
        public Guid TeamId { get; set; } = Guid.Empty;
        public Guid? DepartmentId { get; set; }
        public string TeamCode { get; set; } = string.Empty;
        public string TeamName { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string Department { get; set; } = string.Empty;
        public string TeamLead { get; set; } = string.Empty;
        public int MemberCount { get; set; }
        public bool IsActive { get; set; } = true;

        public static TeamEntry FromDto(DepartmentTeamDto dto)
            => new()
            {
                TeamId = dto.TeamId,
                DepartmentId = dto.DepartmentId,
                TeamCode = dto.TeamCode ?? string.Empty,
                TeamName = dto.TeamName,
                Description = dto.Description,
                Department = dto.DepartmentName ?? string.Empty,
                TeamLead = dto.ManagerName ?? string.Empty,
                MemberCount = dto.MemberCount,
                IsActive = dto.IsActive
            };
    }

    private sealed class TeamForm
    {
        public Guid TeamId { get; set; } = Guid.Empty;

        [Required, StringLength(200)]
        public string TeamName { get; set; } = string.Empty;

        [StringLength(50)]
        public string TeamCode { get; set; } = string.Empty;

        public Guid? DepartmentId { get; set; }

        [StringLength(1000)]
        public string? Description { get; set; }

        [StringLength(200)]
        public string TeamLead { get; set; } = string.Empty;

        [Range(0, 10000)]
        public int MemberCount { get; set; }

        public bool IsActive { get; set; } = true;

        public static TeamForm FromEntry(TeamEntry entry)
            => new()
            {
                TeamId = entry.TeamId,
                TeamName = entry.TeamName,
                TeamCode = entry.TeamCode,
                DepartmentId = entry.DepartmentId,
                Description = entry.Description,
                TeamLead = entry.TeamLead,
                MemberCount = entry.MemberCount,
                IsActive = entry.IsActive
            };

        public DepartmentTeamDto ToDto(Guid tenantId, IReadOnlyList<DepartmentOption> departments)
        {
            var departmentName = departments.FirstOrDefault(d => d.DepartmentId == DepartmentId)?.DepartmentName;
            return new DepartmentTeamDto
            {
                TeamId = TeamId,
                TenantId = tenantId,
                TeamName = TeamName.Trim(),
                TeamCode = string.IsNullOrWhiteSpace(TeamCode) ? null : TeamCode.Trim(),
                Description = string.IsNullOrWhiteSpace(Description) ? null : Description.Trim(),
                DepartmentId = DepartmentId,
                DepartmentName = departmentName,
                ManagerName = string.IsNullOrWhiteSpace(TeamLead) ? null : TeamLead.Trim(),
                MemberCount = MemberCount,
                IsActive = IsActive,
                Status = IsActive ? "Active" : "Inactive"
            };
        }
    }
}
