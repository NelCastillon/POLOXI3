@page "/admin/agency/teams"
@page "/tenant/agency/teams"
@namespace Ams.Web.Components.Pages.AgencyAdmin
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Departments &amp; Teams — Agency Setup</PageTitle>

<AppPageHeader Title="Departments &amp; Teams"
               Subtitle="Manage organisational units, departments and their team assignments"
               Icon="bi-diagram-3">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenAddDrawer">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Team
        </button>
    </Actions>
</AppPageHeader>

<section class="ma-hero as-tenant-hero">
    <div>
        <span class="ma-eyebrow">Tenant · Agency Structure</span>
        <h2>Team Command Center</h2>
        <p>Coordinate team ownership, department alignment, member capacity, and operating status across the agency.</p>
    </div>
    <div class="ma-hero-actions">
        <a class="um-btn um-btn-ghost" href="/tenant/agency/branches"><i class="bi bi-diagram-3" aria-hidden="true"></i> Branches</a>
        <a class="um-btn um-btn-ghost" href="/tenant/agency/departments"><i class="bi bi-grid" aria-hidden="true"></i> Departments</a>
        <button class="um-btn um-btn-primary" @onclick="OpenAddDrawer"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Team</button>
    </div>
</section>

<!-- KPI strip -->
<div class="as-kpi-strip" aria-label="Team filters">
    <button type="button" class='as-kpi-card @KpiClass("Overview")' @onclick='() => SetKpiFilter("Overview")' title="Show all teams">
        <span class="as-kpi-icon"><i class="bi bi-diagram-3-fill" aria-hidden="true"></i></span>
        <div>
            <div class="dt-kpi-value">@_totalCount</div>
            <div class="dt-kpi-label">Total Teams</div>
        </div>
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Active")' @onclick='() => SetKpiFilter("Active")' title="Show active teams">
        <span class="as-kpi-icon as-kpi-icon--success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
        <div>
            <div class="dt-kpi-value">@_activeCount</div>
            <div class="dt-kpi-label">Active</div>
        </div>
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Members")' @onclick='() => SetKpiFilter("Members")' title="Show teams with assigned members">
        <span class="as-kpi-icon as-kpi-icon--violet"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
        <div>
            <div class="dt-kpi-value">@_memberCount</div>
            <div class="dt-kpi-label">Total Members</div>
        </div>
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Departments")' @onclick='() => SetKpiFilter("Departments")' title="Show teams assigned to departments">
        <span class="as-kpi-icon as-kpi-icon--warning"><i class="bi bi-building" aria-hidden="true"></i></span>
        <div>
            <div class="dt-kpi-value">@_deptCount</div>
            <div class="dt-kpi-label">Departments</div>
        </div>
    </button>
</div>

<!-- Filter toolbar -->
<AppFilterPanel @bind-SearchValue="_search"
                OnSearch="OnSearchAsync"
                SearchPlaceholder="Search team or department…">
    <Filters>
        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_deptOptions"
                        Placeholder="All Departments"
                        ShowClearButton="true"
                        Width="180px"
                        Value="_filterDept"
                        ValueChanged="@((string v) => { _filterDept = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>

        <label class="dt-toggle-label">
            <input type="checkbox" @bind="_filterActiveOnly" @bind:after="ApplyFilters" />
            Active only
        </label>
    </Filters>
</AppFilterPanel>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
        @_loadError
    </div>
}

<!-- Grid -->
<div class="um-grid-card app-datagrid">
    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading…</span>
        </div>
    }
    <SfGrid TValue="TeamEntry"
            DataSource="_entries"
            AllowPaging="true"
            AllowSorting="true"
            EnableHover="true"
            RowHeight="52">
        <GridEvents TValue="TeamEntry" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" PageSizes="@(new int[] { 10, 25, 50 })" />
        <GridColumns>
            <GridColumn Field="@nameof(TeamEntry.TeamName)" HeaderText="Team Name" Width="200">
                <Template>
                    @{ var e = (TeamEntry)context; }
                    <div class="dt-name-cell">
                        <span class="dt-team-icon" aria-hidden="true"><i class="bi bi-people"></i></span>
                        <div>
                            <div class="dt-team-name">@e.TeamName</div>
                            <div class="dt-team-code">@e.TeamCode</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(TeamEntry.Department)" HeaderText="Department" Width="180" />
            <GridColumn Field="@nameof(TeamEntry.TeamLead)" HeaderText="Team Lead" Width="180" />
            <GridColumn Field="@nameof(TeamEntry.MemberCount)" HeaderText="Members" Width="100" />
            <GridColumn Field="@nameof(TeamEntry.IsActive)" HeaderText="Status" Width="110">
                <Template>
                    @{ var e = (TeamEntry)context; }
                    <AppStatusBadge Status="@(e.IsActive ? "Active" : "Inactive")"
                                    Label="@(e.IsActive ? "Active" : "Inactive")" />
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="120" TextAlign="TextAlign.Right">
                <Template>
                    @{ var e = (TeamEntry)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEditDrawer(e)" title="Edit">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(e)" title="Delete">
                        <i class="bi bi-trash" aria-hidden="true"></i>
                    </button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<!-- Add/Edit Drawer -->
<AppCrudDrawer @bind-Visible="_showDrawer"
               Title="@(_editModel.TeamId == Guid.Empty ? "New Team" : "Edit Team")"
               OnConfirm="SaveTeamAsync"
               OnClose="CloseDrawer">
    <Content>
        <EditForm EditContext="_editContext" OnValidSubmit="SaveTeamAsync">
            <DataAnnotationsValidator />
        <div class="dt-form">
            <label class="dt-form-label">Team Name *</label>
            <InputText class="um-input" @bind-Value="_editModel.TeamName" placeholder="Team name" />
            <ValidationMessage For="() => _editModel.TeamName" class="text-danger" />

            <label class="dt-form-label">Team Code</label>
            <InputText class="um-input dt-mono" @bind-Value="_editModel.TeamCode" placeholder="Short code" />
            <ValidationMessage For="() => _editModel.TeamCode" class="text-danger" />

            <label class="dt-form-label">Department</label>
            <SfDropDownList TValue="Guid?" TItem="DepartmentOption"
                            DataSource="_departmentOptions"
                            Placeholder="Select department"
                            ShowClearButton="true"
                            @bind-Value="_editModel.DepartmentId">
                <DropDownListFieldSettings Value="DepartmentId" Text="DepartmentName" />
            </SfDropDownList>
            <ValidationMessage For="() => _editModel.DepartmentId" class="text-danger" />

            <label class="dt-form-label">Description</label>
            <InputTextArea class="um-input" @bind-Value="_editModel.Description" placeholder="Optional description" />
            <ValidationMessage For="() => _editModel.Description" class="text-danger" />

            <label class="dt-form-label">Team Lead</label>
            <InputText class="um-input" @bind-Value="_editModel.TeamLead" placeholder="Full name" />
            <ValidationMessage For="() => _editModel.TeamLead" class="text-danger" />

            <label class="dt-form-label">Team Type</label>
            <InputText class="um-input" @bind-Value="_editModel.TeamType" placeholder="e.g. Service, Sales" />
            <ValidationMessage For="() => _editModel.TeamType" class="text-danger" />

            <label class="dt-form-label">Active</label>
            <SfSwitch @bind-Checked="_editModel.IsActive" />
        </div>
        </EditForm>
    </Content>
</AppCrudDrawer>

<SfDialog Width="420px" IsModal="true" ShowCloseIcon="false" Visible="_showDeleteDialog">
    <DialogTemplates>
        <Content>
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash"></i></div>
                <div class="um-confirm-message">
                    <h6>Delete team?</h6>
                    <p>This will remove <strong>@_deleteTarget?.TeamName</strong> from the agency team list.</p>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showDeleteDialog = false">Cancel</button>
                    <button type="button" class="um-btn um-btn-danger" @onclick="DeleteTeamAsync">Delete</button>
                </div>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private SfToast? _toast;

    private List<TeamEntry> _allEntries = [];
    private List<TeamEntry> _entries    = [];

    private bool _loading    = false;
    private bool _showDrawer = false;

    private string _search         = string.Empty;
    private string _filterDept     = string.Empty;
    private bool   _filterActiveOnly = false;
    private string _activeFilter = "Overview";
    private string? _loadError;

    private int _totalCount  = 0;
    private int _activeCount = 0;
    private int _memberCount = 0;
    private int _deptCount   = 0;

    private readonly List<LabelValue> _deptOptions = [];
    private readonly List<DepartmentOption> _departmentOptions = [];

    private TeamEntry _editModel = new();
    private EditContext _editContext = default!;
    private bool _showDeleteDialog;
    private TeamEntry? _deleteTarget;

    public DepartmentsTeams()
    {
        _editContext = new EditContext(_editModel);
    }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(
            new("Home",        "/"),
            new("Agency Setup","/tenant/agency/profile"),
            new("Teams",       "/tenant/agency/teams"));

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _loadError = null;
            var departments = await Api.GetDepartmentsAsync(_tenantId);
            _departmentOptions.Clear();
            _departmentOptions.AddRange((departments ?? [])
                .Where(d => d.IsActive)
                .OrderBy(d => d.DepartmentName)
                .Select(d => new DepartmentOption(d.DepartmentId, d.DepartmentName)));

            var teams = await Api.GetTeamsAsync(_tenantId);
            _allEntries = teams?.Select(t => new TeamEntry
            {
                TeamId = t.TeamId,
                DepartmentId = t.DepartmentId,
                TeamCode = t.TeamCode ?? string.Empty,
                TeamName = t.TeamName,
                Description = t.Description,
                Department = t.DepartmentName ?? string.Empty,
                TeamLead = t.ManagerName ?? string.Empty,
                TeamType = string.Empty,
                MemberCount = t.MemberCount,
                IsActive = t.IsActive
            }).ToList() ?? [];
            ComputeKpi();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _loadError = $"Load failed: {ex.Message}";
            await ShowToastAsync($"Error loading teams: {ex.Message}", "e-toast-danger");
        }
        finally { _loading = false; }
    }

    private async Task OnSearchAsync(string _) => await LoadAsync();

    private void ApplyFilters()
    {
        _entries = _allEntries.Where(e =>
            (_activeFilter switch
            {
                "Active" => e.IsActive,
                "Members" => e.MemberCount > 0,
                "Departments" => !string.IsNullOrWhiteSpace(e.Department),
                _ => true
            }) &&
            (string.IsNullOrEmpty(_filterDept) || e.Department == _filterDept) &&
            (!_filterActiveOnly || e.IsActive) &&
            (string.IsNullOrEmpty(_search) ||
             e.TeamName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             e.Department.Contains(_search, StringComparison.OrdinalIgnoreCase))
        ).ToList();

        StateHasChanged();
    }

    private void SetKpiFilter(string filter)
    {
        _activeFilter = _activeFilter == filter && filter != "Overview" ? "Overview" : filter;
        _filterActiveOnly = _activeFilter == "Active";
        ApplyFilters();
    }

    private string KpiClass(string filter) => _activeFilter == filter ? "as-kpi-card--active" : string.Empty;

    private void OnRowSelected(RowSelectEventArgs<TeamEntry> args) => OpenEditDrawer(args.Data);

    private void ComputeKpi()
    {
        _totalCount  = _allEntries.Count;
        _activeCount = _allEntries.Count(e => e.IsActive);
        _memberCount = _allEntries.Sum(e => e.MemberCount);
        _deptCount   = _allEntries.Where(e => !string.IsNullOrWhiteSpace(e.Department)).Select(e => e.Department).Distinct().Count();
        _deptOptions.Clear();
        _deptOptions.AddRange(_allEntries
            .Where(e => !string.IsNullOrWhiteSpace(e.Department))
            .Select(e => e.Department)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .Select(x => new LabelValue(x, x)));
    }

    private void OpenAddDrawer()  { _editModel = new(); _editContext = new EditContext(_editModel); _showDrawer = true; }
    private void OpenEditDrawer(TeamEntry e) { _editModel = new TeamEntry { TeamId = e.TeamId, DepartmentId = e.DepartmentId, TeamCode = e.TeamCode, TeamName = e.TeamName, Description = e.Description, Department = e.Department, TeamLead = e.TeamLead, TeamType = e.TeamType, MemberCount = e.MemberCount, IsActive = e.IsActive }; _editContext = new EditContext(_editModel); _showDrawer = true; }
    private void CloseDrawer() => _showDrawer = false;

    private async Task SaveTeamAsync()
    {
        try
        {
            var departmentName = _departmentOptions.FirstOrDefault(d => d.DepartmentId == _editModel.DepartmentId)?.DepartmentName ?? _editModel.Department;
            var team = new DepartmentTeamDto
            {
                TeamId = _editModel.TeamId,
                TenantId = _tenantId,
                TeamName = _editModel.TeamName,
                TeamCode = _editModel.TeamCode,
                Description = _editModel.Description,
                DepartmentId = _editModel.DepartmentId,
                DepartmentName = departmentName,
                ManagerName = _editModel.TeamLead,
                MemberCount = _editModel.MemberCount,
                IsActive = _editModel.IsActive,
                Status = _editModel.IsActive ? "Active" : "Inactive"
            };

            if (_editModel.TeamId == Guid.Empty)
                await Api.CreateTeamAsync(team, _tenantId);
            else
                await Api.UpdateTeamAsync(_editModel.TeamId, team);

            _showDrawer = false;
            await LoadAsync();
            await ShowToastAsync("Team saved.", "e-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Save failed: {ex.Message}", "e-toast-danger");
        }
    }

    private void ConfirmDelete(TeamEntry entry)
    {
        _deleteTarget = entry;
        _showDeleteDialog = true;
    }

    private async Task DeleteTeamAsync()
    {
        if (_deleteTarget is null)
            return;

        try
        {
            await Api.DeleteTeamAsync(_deleteTarget.TeamId);
            _showDeleteDialog = false;
            await LoadAsync();
            await ShowToastAsync("Team deleted.", "e-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Delete failed: {ex.Message}", "e-toast-danger");
        }
    }

    private async Task ShowToastAsync(string msg, string cssClass = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = cssClass });
    }

    private sealed record LabelValue(string Value, string Label);
    private sealed record DepartmentOption(Guid DepartmentId, string DepartmentName);

    private sealed class TeamEntry
    {
        public Guid   TeamId      { get; set; } = Guid.Empty;
        public Guid?  DepartmentId { get; set; }
        [StringLength(50)]
        public string TeamCode    { get; set; } = string.Empty;
        [Required, StringLength(200)]
        public string TeamName    { get; set; } = string.Empty;
        [StringLength(1000)]
        public string? Description { get; set; }
        public string Department  { get; set; } = string.Empty;
        [StringLength(200)]
        public string TeamLead    { get; set; } = string.Empty;
        [StringLength(100)]
        public string? TeamType    { get; set; }
        public int    MemberCount { get; set; }
        public bool   IsActive    { get; set; } = true;
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
