@page "/tenant/agency/branding"
@namespace Ams.Web.Components.Pages.AgencyAdmin
@using Ams.Application.Features.Tenants
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Agency Branding — Agency Setup</PageTitle>

<AppPageHeader Title="Agency Branding"
               Subtitle="Customize your agency logo, colors, domain and portal appearance"
               Icon="bi-palette">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-ghost" @onclick="ResetToDefaultsAsync" title="Reset to defaults">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset Defaults
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenEditDrawer">
            <i class="bi bi-pencil" aria-hidden="true"></i> Edit Branding
        </button>
    </Actions>
</AppPageHeader>

<div class="as-kpi-strip" aria-label="Agency branding filters">
    <button type="button" class='as-kpi-card @KpiClass("Colors")' @onclick='() => SetFilter("Colors")' title="Show color palette and preview">
        <span class="as-kpi-icon"><i class="bi bi-palette-fill" aria-hidden="true"></i></span>
        <div>
            <div class="as-kpi-value">@(_branding?.PrimaryColor ?? "—")</div>
            <div class="as-kpi-label">Primary Color</div>
        </div>
        @if (_branding is not null)
        {
            <span class="as-color-swatch" style="background:@_branding.PrimaryColor" title="@_branding.PrimaryColor"></span>
        }
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Identity")' @onclick='() => SetFilter("Identity")' title="Show logo, domain, and identity settings">
        <span class="as-kpi-icon as-kpi-icon--violet"><i class="bi bi-palette2" aria-hidden="true"></i></span>
        <div>
            <div class="as-kpi-value">@(_branding?.SecondaryColor ?? "—")</div>
            <div class="as-kpi-label">Secondary Color</div>
        </div>
        @if (_branding is not null)
        {
            <span class="as-color-swatch" style="background:@_branding.SecondaryColor" title="@_branding.SecondaryColor"></span>
        }
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Support")' @onclick='() => SetFilter("Support")' title="Show support and footer settings">
        <span class="as-kpi-icon as-kpi-icon--warning"><i class="bi bi-stars" aria-hidden="true"></i></span>
        <div>
            <div class="as-kpi-value">@(_branding?.AccentColor ?? "—")</div>
            <div class="as-kpi-label">Accent Color</div>
        </div>
        @if (_branding is not null)
        {
            <span class="as-color-swatch" style="background:@_branding.AccentColor" title="@_branding.AccentColor"></span>
        }
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Record")' @onclick='() => SetFilter("Record")' title="Show status and record information">
        <span class="as-kpi-icon @(_branding?.IsActive == true ? "as-kpi-icon--success" : "as-kpi-icon--danger")">
            <i class="@(_branding?.IsActive == true ? "bi bi-check-circle-fill" : "bi bi-dash-circle")" aria-hidden="true"></i>
        </span>
        <div>
            <div class="as-kpi-value">@(_branding?.IsActive == true ? "Active" : "Not Set")</div>
            <div class="as-kpi-label">Branding Status</div>
        </div>
    </button>
</div>

<div class="as-card">
    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading…</span>
        </div>
    }

    @if (_branding is not null)
    {
        <div class="as-layout as-layout--split">

            @if (ShowSection("Colors") || ShowSection("Identity"))
            {
            <div class="as-preview-panel">
                <h3 class="as-section-title"><i class="bi bi-window" aria-hidden="true"></i> Brand Preview</h3>
                <div class="as-logo-preview" style="background:@_branding.PrimaryColor">
                    @if (!string.IsNullOrEmpty(_branding.LogoUrl))
                    {
                        <img src="@_branding.LogoUrl" alt="Agency Logo" class="as-logo-img" />
                    }
                    else
                    {
                        <div class="as-logo-placeholder">
                            <i class="bi bi-image" aria-hidden="true"></i>
                            <span>No logo uploaded</span>
                        </div>
                    }
                </div>
                <div class="as-palette-list">
                    <div class="as-palette-item">
                        <span class="as-palette-swatch" style="background:@_branding.PrimaryColor"></span>
                        <div>
                            <div class="as-field-label">Primary</div>
                            <div class="as-field-value as-mono">@_branding.PrimaryColor</div>
                        </div>
                    </div>
                    <div class="as-palette-item">
                        <span class="as-palette-swatch" style="background:@_branding.SecondaryColor"></span>
                        <div>
                            <div class="as-field-label">Secondary</div>
                            <div class="as-field-value as-mono">@_branding.SecondaryColor</div>
                        </div>
                    </div>
                    <div class="as-palette-item">
                        <span class="as-palette-swatch" style="background:@_branding.AccentColor"></span>
                        <div>
                            <div class="as-field-label">Accent</div>
                            <div class="as-field-value as-mono">@_branding.AccentColor</div>
                        </div>
                    </div>
                </div>
            </div>
            }

            <div>
                @if (ShowSection("Identity"))
                {
                <div class="as-section">
                    <h3 class="as-section-title"><i class="bi bi-card-text" aria-hidden="true"></i> Identity</h3>
                    <div class="as-fields">
                        <div class="as-field"><span class="as-field-label">White-Label Name</span><span class="as-field-value">@(_branding.WhiteLabelName ?? "—")</span></div>
                        <div class="as-field"><span class="as-field-label">Logo URL</span><span class="as-field-value as-mono as-truncate">@(_branding.LogoUrl ?? "—")</span></div>
                        <div class="as-field"><span class="as-field-label">Favicon URL</span><span class="as-field-value as-mono as-truncate">@(_branding.FaviconUrl ?? "—")</span></div>
                        <div class="as-field"><span class="as-field-label">Custom Domain</span><span class="as-field-value as-mono">@(_branding.CustomDomain ?? "—")</span></div>
                        <div class="as-field"><span class="as-field-label">Custom CSS URL</span><span class="as-field-value as-mono as-truncate">@(_branding.CustomCssUrl ?? "—")</span></div>
                    </div>
                </div>
                }
                @if (ShowSection("Support"))
                {
                <div class="as-section">
                    <h3 class="as-section-title"><i class="bi bi-headset" aria-hidden="true"></i> Support & Footer</h3>
                    <div class="as-fields">
                        <div class="as-field"><span class="as-field-label">Support Email</span><span class="as-field-value">@(_branding.SupportEmail ?? "—")</span></div>
                        <div class="as-field"><span class="as-field-label">Support Phone</span><span class="as-field-value as-mono">@(_branding.SupportPhone ?? "—")</span></div>
                        <div class="as-field as-field--full"><span class="as-field-label">Footer Text</span><span class="as-field-value">@(_branding.FooterText ?? "—")</span></div>
                    </div>
                </div>
                }
                @if (ShowSection("Record"))
                {
                <div class="as-section">
                    <h3 class="as-section-title"><i class="bi bi-clock-history" aria-hidden="true"></i> Record Info</h3>
                    <div class="as-fields">
                        <div class="as-field"><span class="as-field-label">Created</span><span class="as-field-value">@_branding.CreatedDateUtc.ToLocalTime().ToString("g")</span></div>
                        <div class="as-field"><span class="as-field-label">Last Modified</span><span class="as-field-value">@(_branding.ModifiedDateUtc.HasValue ? _branding.ModifiedDateUtc.Value.ToLocalTime().ToString("g") : "—")</span></div>
                        <div class="as-field"><span class="as-field-label">Status</span>
                            <span><AppStatusBadge Status="@(_branding.IsActive ? "Active" : "Inactive")" Label="@(_branding.IsActive ? "Active" : "Inactive")" /></span>
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>
    }
    else if (!_loading)
    {
        <div class="as-empty-state">
            <i class="bi bi-palette as-empty-icon" aria-hidden="true"></i>
            <p>No branding configuration found. Click <strong>Edit Branding</strong> to configure your agency's visual identity.</p>
        </div>
    }
</div>

<!-- Edit Drawer -->
<AppCrudDrawer @bind-Visible="_showEditDrawer"
               Title="Edit Agency Branding"
               OnConfirm="SaveBrandingAsync"
               OnClose="CloseEditDrawer">
    <Content>
        <div class="as-form">
            <h4 class="ab-form-section-heading">Identity</h4>

            <label class="ab-form-label">White-Label Name</label>
            <input class="um-input" @bind="_editModel.WhiteLabelName" placeholder="e.g. MyAgency Portal" />

            <label class="ab-form-label">Logo URL</label>
            <input class="um-input ab-mono" @bind="_editModel.LogoUrl" placeholder="https://…/logo.png" />

            <label class="ab-form-label">Favicon URL</label>
            <input class="um-input ab-mono" @bind="_editModel.FaviconUrl" placeholder="https://…/favicon.ico" />

            <label class="ab-form-label">Custom Domain</label>
            <input class="um-input ab-mono" @bind="_editModel.CustomDomain" placeholder="portal.myagency.com" />

            <label class="ab-form-label">Custom CSS URL</label>
            <input class="um-input ab-mono" @bind="_editModel.CustomCssUrl" placeholder="https://…/custom.css" />

            <h4 class="ab-form-section-heading">Colors</h4>

            <div class="ab-form-color-row">
                <div class="ab-form-color-item">
                    <label class="ab-form-label">Primary Color</label>
                    <div class="ab-color-input-wrap">
                        <input type="color" class="ab-color-picker" @bind="_editModel.PrimaryColor" />
                        <input class="um-input ab-mono" @bind="_editModel.PrimaryColor" placeholder="#0d6efd" />
                    </div>
                </div>
                <div class="ab-form-color-item">
                    <label class="ab-form-label">Secondary Color</label>
                    <div class="ab-color-input-wrap">
                        <input type="color" class="ab-color-picker" @bind="_editModel.SecondaryColor" />
                        <input class="um-input ab-mono" @bind="_editModel.SecondaryColor" placeholder="#6c757d" />
                    </div>
                </div>
                <div class="ab-form-color-item">
                    <label class="ab-form-label">Accent Color</label>
                    <div class="ab-color-input-wrap">
                        <input type="color" class="ab-color-picker" @bind="_editModel.AccentColor" />
                        <input class="um-input ab-mono" @bind="_editModel.AccentColor" placeholder="#198754" />
                    </div>
                </div>
            </div>

            <h4 class="ab-form-section-heading">Support & Footer</h4>

            <label class="ab-form-label">Support Email</label>
            <input class="um-input" type="email" @bind="_editModel.SupportEmail" placeholder="support@myagency.com" />

            <label class="ab-form-label">Support Phone</label>
            <input class="um-input ab-mono" @bind="_editModel.SupportPhone" placeholder="+1 (800) 000-0000" />

            <label class="ab-form-label">Footer Text</label>
            <textarea class="um-input ab-textarea" @bind="_editModel.FooterText" rows="2" placeholder="© 2025 My Agency. All rights reserved."></textarea>
        </div>
    </Content>
</AppCrudDrawer>

<!-- Toast -->
<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    private SfToast? _toast;
    private bool _loading = false;
    private bool _showEditDrawer = false;
    private string _activeFilter = "Colors";

    private TenantBrandingDto? _branding;
    private EditBrandingModel _editModel = new();

    private sealed class EditBrandingModel
    {
        public string? WhiteLabelName { get; set; }
        public string? LogoUrl        { get; set; }
        public string? FaviconUrl     { get; set; }
        public string? CustomDomain   { get; set; }
        public string? CustomCssUrl   { get; set; }
        public string  PrimaryColor   { get; set; } = "#0d6efd";
        public string  SecondaryColor { get; set; } = "#6c757d";
        public string  AccentColor    { get; set; } = "#198754";
        public string? SupportEmail   { get; set; }
        public string? SupportPhone   { get; set; }
        public string? FooterText     { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",           "/"),
            new("Agency Setup",   "/tenant/agency/profile"),
            new("Agency Branding","/tenant/agency/branding"));

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _branding = await Api.GetTenantBrandingAsync(_tenantId);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenEditDrawer()
    {
        _editModel = _branding is not null
            ? new EditBrandingModel
            {
                WhiteLabelName = _branding.WhiteLabelName,
                LogoUrl        = _branding.LogoUrl,
                FaviconUrl     = _branding.FaviconUrl,
                CustomDomain   = _branding.CustomDomain,
                CustomCssUrl   = _branding.CustomCssUrl,
                PrimaryColor   = _branding.PrimaryColor,
                SecondaryColor = _branding.SecondaryColor,
                AccentColor    = _branding.AccentColor,
                SupportEmail   = _branding.SupportEmail,
                SupportPhone   = _branding.SupportPhone,
                FooterText     = _branding.FooterText,
            }
            : new();
        _showEditDrawer = true;
    }

    private void CloseEditDrawer() => _showEditDrawer = false;

    private async Task SaveBrandingAsync()
    {
        try
        {
            await Api.UpdateTenantBrandingAsync(_tenantId, new UpdateTenantBrandingRequest
            {
                WhiteLabelName = _editModel.WhiteLabelName,
                LogoUrl        = _editModel.LogoUrl,
                FaviconUrl     = _editModel.FaviconUrl,
                PrimaryColor   = _editModel.PrimaryColor,
                SecondaryColor = _editModel.SecondaryColor,
                AccentColor    = _editModel.AccentColor,
                CustomCssUrl   = _editModel.CustomCssUrl,
                SupportEmail   = _editModel.SupportEmail,
                SupportPhone   = _editModel.SupportPhone,
                FooterText     = _editModel.FooterText,
            });
            _showEditDrawer = false;
            await LoadAsync();
            await _toast!.ShowAsync(new ToastModel
            {
                Title   = "Saved",
                Content = "Agency branding updated successfully.",
                CssClass = "e-toast-success",
            });
        }
        catch (Exception ex)
        {
            await _toast!.ShowAsync(new ToastModel
            {
                Title    = "Error",
                Content  = $"Failed to save branding: {ex.Message}",
                CssClass = "e-toast-danger",
            });
        }
    }

    private async Task ResetToDefaultsAsync()
    {
        try
        {
            await Api.ResetTenantBrandingToDefaultsAsync(_tenantId);
            await LoadAsync();
            await _toast!.ShowAsync(new ToastModel
            {
                Title    = "Reset",
                Content  = "Branding reset to defaults.",
                CssClass = "e-toast-success",
            });
        }
        catch (Exception ex)
        {
            await _toast!.ShowAsync(new ToastModel
            {
                Title    = "Error",
                Content  = $"Failed to reset branding: {ex.Message}",
                CssClass = "e-toast-danger",
            });
        }
    }

    private void SetFilter(string filter) => _activeFilter = _activeFilter == filter && filter != "Colors" ? "Colors" : filter;

    private bool ShowSection(string section) => _activeFilter == section;

    private string KpiClass(string filter) => _activeFilter == filter ? "as-kpi-card--active" : string.Empty;
}
