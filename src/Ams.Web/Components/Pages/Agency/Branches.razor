@page "/branches"
@page "/admin/agency/branches"
@page "/tenant/agency/branches"
@namespace Ams.Web.Components.Pages.AgencyAdmin
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Branches — Agency Setup</PageTitle>

<AppPageHeader Title="Branches"
               Subtitle="Agency office locations and branch codes used system-wide"
               Icon="bi-diagram-3-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenAddDrawer">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Branch
        </button>
    </Actions>
</AppPageHeader>

<section class="ma-hero as-tenant-hero">
    <div>
        <span class="ma-eyebrow">Tenant · Agency Structure</span>
        <h2>Branch Network Command Center</h2>
        <p>Manage office locations, branch codes, and active operating sites used across users, routing, accounting, and reporting.</p>
    </div>
    <div class="ma-hero-actions">
        <a class="um-btn um-btn-ghost" href="/tenant/agency/departments"><i class="bi bi-grid" aria-hidden="true"></i> Departments</a>
        <a class="um-btn um-btn-ghost" href="/tenant/agency/teams"><i class="bi bi-people" aria-hidden="true"></i> Teams</a>
        <button class="um-btn um-btn-primary" @onclick="OpenAddDrawer"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Branch</button>
    </div>
</section>

<!-- KPI strip -->
<div class="as-kpi-strip" aria-label="Branch filters">
    <button type="button" class='as-kpi-card @KpiClass("Overview")' @onclick='() => SetKpiFilter("Overview")' title="Show all branches">
        <span class="as-kpi-icon"><i class="bi bi-diagram-3-fill" aria-hidden="true"></i></span>
        <div><div class="br-kpi-value">@_totalCount</div><div class="br-kpi-label">Total Branches</div></div>
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Active")' @onclick='() => SetKpiFilter("Active")' title="Show active branches">
        <span class="as-kpi-icon as-kpi-icon--success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
        <div><div class="br-kpi-value">@_activeCount</div><div class="br-kpi-label">Active</div></div>
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Inactive")' @onclick='() => SetKpiFilter("Inactive")' title="Show inactive branches">
        <span class="as-kpi-icon as-kpi-icon--warning"><i class="bi bi-dash-circle" aria-hidden="true"></i></span>
        <div><div class="br-kpi-value">@(_totalCount - _activeCount)</div><div class="br-kpi-label">Inactive</div></div>
    </button>
</div>

<!-- Filter toolbar -->
<AppFilterPanel @bind-SearchValue="_search"
                OnSearch="OnSearchAsync"
                SearchPlaceholder="Search branch name or code…">
    <Filters>
        <label class="br-toggle-label">
            <input type="checkbox" @bind="_filterActiveOnly" @bind:after="ApplyFilters" />
            Active only
        </label>
    </Filters>
</AppFilterPanel>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
        @_loadError
    </div>
}

<!-- Grid -->
<div class="um-grid-card app-datagrid">
    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading…</span>
        </div>
    }
    <SfGrid TValue="BranchEntry"
            DataSource="_entries"
            AllowPaging="true"
            AllowSorting="true"
            EnableHover="true"
            RowHeight="52">
        <GridEvents TValue="BranchEntry" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" PageSizes="@(new int[] { 10, 25, 50 })" />
        <GridColumns>
            <GridColumn Field="@nameof(BranchEntry.BranchCode)" HeaderText="Code" Width="130">
                <Template>
                    @{ var e = (BranchEntry)context; }
                    <span class="br-mono">@e.BranchCode</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(BranchEntry.BranchName)" HeaderText="Branch Name" Width="220" />
            <GridColumn Field="@nameof(BranchEntry.City)" HeaderText="City" Width="140" />
            <GridColumn Field="@nameof(BranchEntry.StateProvince)" HeaderText="State" Width="110" />
            <GridColumn Field="@nameof(BranchEntry.CountryCode)" HeaderText="Country" Width="100" />
            <GridColumn Field="@nameof(BranchEntry.IsActive)" HeaderText="Status" Width="110">
                <Template>
                    @{ var e = (BranchEntry)context; }
                    <AppStatusBadge Status="@(e.IsActive ? "Active" : "Inactive")" Label="@(e.IsActive ? "Active" : "Inactive")" />
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="120" TextAlign="TextAlign.Right">
                <Template>
                    @{ var e = (BranchEntry)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEditDrawer(e)" title="Edit">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(e)" title="Delete">
                        <i class="bi bi-trash" aria-hidden="true"></i>
                    </button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<!-- Add/Edit Drawer -->
<AppCrudDrawer @bind-Visible="_showDrawer"
               Title="@(_editModel.BranchId == Guid.Empty ? "Add Branch" : "Edit Branch")"
               OnConfirm="SaveBranchAsync"
               OnClose="CloseDrawer">
    <Content>
        <EditForm EditContext="_editContext" OnValidSubmit="SaveBranchAsync">
            <DataAnnotationsValidator />
        <div class="br-form">
            <label class="br-form-label">Branch Code *</label>
            <InputText class="um-input br-mono" @bind-Value="_editModel.BranchCode" placeholder="e.g. HQ, WEST-01" />
            <ValidationMessage For="() => _editModel.BranchCode" class="text-danger" />

            <label class="br-form-label">Branch Name *</label>
            <InputText class="um-input" @bind-Value="_editModel.BranchName" placeholder="Full branch name" />
            <ValidationMessage For="() => _editModel.BranchName" class="text-danger" />

            <label class="br-form-label">City</label>
            <InputText class="um-input" @bind-Value="_editModel.City" />
            <ValidationMessage For="() => _editModel.City" class="text-danger" />

            <label class="br-form-label">State / Province</label>
            <InputText class="um-input" @bind-Value="_editModel.StateProvince" placeholder="e.g. CA, TX" />
            <ValidationMessage For="() => _editModel.StateProvince" class="text-danger" />

            <label class="br-form-label">Country Code</label>
            <InputText class="um-input br-mono" @bind-Value="_editModel.CountryCode" placeholder="e.g. US" />
            <ValidationMessage For="() => _editModel.CountryCode" class="text-danger" />

            @if (_editModel.BranchId != Guid.Empty)
            {
                <label class="br-form-label">Active</label>
                <SfSwitch @bind-Checked="_editModel.IsActive" />
            }
        </div>
        </EditForm>
    </Content>
</AppCrudDrawer>

<SfDialog Width="420px" IsModal="true" ShowCloseIcon="false" Visible="_showDeleteDialog" CssClass="um-confirm-dialog">
    <DialogTemplates>
        <Content>
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash"></i></div>
                <div class="um-confirm-message">
                    <h6>Delete branch?</h6>
                    <p>This will remove <strong>@_deleteTarget?.BranchName</strong> from the active branch list.</p>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showDeleteDialog = false">Cancel</button>
                    <button type="button" class="um-btn um-btn-danger" @onclick="DeleteBranchAsync">Delete</button>
                </div>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;

    private List<BranchEntry> _allEntries = [];
    private List<BranchEntry> _entries    = [];

    private bool _loading        = false;
    private bool _showDrawer     = false;
    private bool _filterActiveOnly = false;
    private string _search       = string.Empty;
    private string _activeFilter = "Overview";
    private string? _loadError;

    private int _totalCount  = 0;
    private int _activeCount = 0;

    private BranchEntry _editModel = new();
    private EditContext _editContext = default!;
    private bool _showDeleteDialog;
    private BranchEntry? _deleteTarget;

    public Branches()
    {
        _editContext = new EditContext(_editModel);
    }

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",        "/"),
            new("Agency Setup", "/tenant/agency/profile"),
            new("Branches",    "/tenant/agency/branches"));

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _loadError = null;
            var result = await Api.SearchBranchesAsync(_tenantId, _search, pageSize: 500);
            _allEntries = result?.Items.Select(d => new BranchEntry
            {
                BranchId      = d.BranchId,
                BranchCode    = d.BranchCode,
                BranchName    = d.BranchName,
                City          = d.City,
                StateProvince = d.StateProvince,
                CountryCode   = d.CountryCode,
                IsActive      = d.IsActive,
            }).ToList() ?? [];

            _totalCount  = _allEntries.Count;
            _activeCount = _allEntries.Count(e => e.IsActive);
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _loadError = $"Load failed: {ex.Message}";
            await ShowToastAsync($"Error loading branches: {ex.Message}", "e-toast-danger");
        }
        finally { _loading = false; }
    }

    private Task OnSearchAsync(string _) => LoadAsync();

    private void ApplyFilters()
    {
        _entries = _allEntries.Where(e =>
            (_activeFilter switch
            {
                "Active" => e.IsActive,
                "Inactive" => !e.IsActive,
                _ => true
            }) &&
            (!_filterActiveOnly || e.IsActive) &&
            (string.IsNullOrEmpty(_search) ||
             e.BranchName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             e.BranchCode.Contains(_search, StringComparison.OrdinalIgnoreCase))
        ).ToList();
        StateHasChanged();
    }

    private void SetKpiFilter(string filter)
    {
        _activeFilter = _activeFilter == filter && filter != "Overview" ? "Overview" : filter;
        _filterActiveOnly = _activeFilter == "Active";
        ApplyFilters();
    }

    private string KpiClass(string filter) => _activeFilter == filter ? "as-kpi-card--active" : string.Empty;

    private void OnRowSelected(RowSelectEventArgs<BranchEntry> args) => OpenEditDrawer(args.Data);

    private void OpenAddDrawer()  { _editModel = new(); _editContext = new EditContext(_editModel); _showDrawer = true; }
    private void OpenEditDrawer(BranchEntry e)
    {
        _editModel = new BranchEntry
        {
            BranchId      = e.BranchId,
            BranchCode    = e.BranchCode,
            BranchName    = e.BranchName,
            City          = e.City,
            StateProvince = e.StateProvince,
            CountryCode   = e.CountryCode,
            IsActive      = e.IsActive,
        };
        _editContext = new EditContext(_editModel);
        _showDrawer = true;
    }
    private void CloseDrawer() => _showDrawer = false;

    private async Task SaveBranchAsync()
    {
        try
        {
            if (_editModel.BranchId == Guid.Empty)
            {
                await Api.CreateBranchAsync(new(
                    _tenantId,
                    _editModel.BranchCode,
                    _editModel.BranchName,
                    _editModel.City,
                    _editModel.StateProvince,
                    _editModel.CountryCode));
            }
            else
            {
                await Api.UpdateBranchAsync(_editModel.BranchId, new(
                    _editModel.BranchCode,
                    _editModel.BranchName,
                    _editModel.City,
                    _editModel.StateProvince,
                    _editModel.CountryCode,
                    _editModel.IsActive));
            }
            _showDrawer = false;
            await LoadAsync();
            await ShowToastAsync("Branch saved.", "e-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Failed to save branch: {ex.Message}", "e-toast-danger");
        }
    }

    private void ConfirmDelete(BranchEntry entry)
    {
        _deleteTarget = entry;
        _showDeleteDialog = true;
    }

    private async Task DeleteBranchAsync()
    {
        if (_deleteTarget is null)
            return;

        try
        {
            await Api.DeleteBranchAsync(_deleteTarget.BranchId);
            _showDeleteDialog = false;
            await LoadAsync();
            await ShowToastAsync("Branch deleted.", "e-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Delete failed: {ex.Message}", "e-toast-danger");
        }
    }

    private async Task ShowToastAsync(string msg, string cssClass = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = cssClass });
    }

    private sealed class BranchEntry
    {
        public Guid    BranchId      { get; set; } = Guid.Empty;
        [Required, StringLength(50)]
        public string  BranchCode    { get; set; } = string.Empty;
        [Required, StringLength(200)]
        public string  BranchName    { get; set; } = string.Empty;
        [StringLength(100)]
        public string? City          { get; set; }
        [StringLength(100)]
        public string? StateProvince { get; set; }
        [StringLength(10)]
        public string? CountryCode   { get; set; }
        public bool    IsActive      { get; set; } = true;
    }
}
