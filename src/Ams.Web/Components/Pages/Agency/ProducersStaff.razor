@page "/admin/agency/staff"
@page "/tenant/agency/producers"
@namespace Ams.Web.Components.Pages.AgencyAdmin
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.Iam
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Producers — Agency Setup</PageTitle>

<AppPageHeader Title="Producers"
               Subtitle="Licensed producers, appointments, and license renewal readiness"
               Icon="bi-person-badge">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenAddDrawer">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Producer
        </button>
    </Actions>
</AppPageHeader>

<section class="ma-hero as-tenant-hero">
    <div>
        <span class="ma-eyebrow">Tenant · Agency Staff</span>
        <h2>Producer Command Center</h2>
        <p>Monitor licensed producers, appointments, license expirations, and staff readiness across the agency.</p>
    </div>
    <div class="ma-hero-actions">
        <a class="um-btn um-btn-ghost" href="/tenant/agency/csrs"><i class="bi bi-headset" aria-hidden="true"></i> CSRs</a>
        <a class="um-btn um-btn-ghost" href="/tenant/agency/branches"><i class="bi bi-diagram-3" aria-hidden="true"></i> Branches</a>
        <button class="um-btn um-btn-primary" @onclick="OpenAddDrawer"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Producer</button>
    </div>
</section>

<!-- KPI strip -->
<div class="as-kpi-strip" aria-label="Producer filters">
    <button type="button" class='as-kpi-card @KpiClass("Overview")' @onclick='() => SetKpiFilter("Overview")' title="Show all producers">
        <span class="as-kpi-icon"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
        <div><div class="ps-kpi-value">@_producerCount</div><div class="ps-kpi-label">Producers</div></div>
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Active")' @onclick='() => SetKpiFilter("Active")' title="Show active producers">
        <span class="as-kpi-icon as-kpi-icon--success"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
        <div><div class="ps-kpi-value">@_activeProducerCount</div><div class="ps-kpi-label">Active</div></div>
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Expiring")' @onclick='() => SetKpiFilter("Expiring")' title="Show producer licenses expiring in 90 days">
        <span class="as-kpi-icon as-kpi-icon--warning"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></span>
        <div><div class="ps-kpi-value">@_licenseExpiringCount</div><div class="ps-kpi-label">License Expiring</div></div>
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Expired")' @onclick='() => SetKpiFilter("Expired")' title="Show expired producer licenses">
        <span class="as-kpi-icon as-kpi-icon--danger"><i class="bi bi-x-circle-fill" aria-hidden="true"></i></span>
        <div><div class="ps-kpi-value">@_licenseExpiredCount</div><div class="ps-kpi-label">Expired</div></div>
    </button>
</div>

<!-- Filter toolbar -->
<AppFilterPanel @bind-SearchValue="_search"
                OnSearch="OnSearchAsync"
                SearchPlaceholder="Search name, NPN or email…">
    <Filters>
        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_roleOptions"
                        Placeholder="Role"
                        ShowClearButton="true"
                        Width="150px"
                        Value="_filterRole"
                        ValueChanged="@((string v) => { _filterRole = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>

        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_licenseStatusOptions"
                        Placeholder="License Status"
                        ShowClearButton="true"
                        Width="160px"
                        Value="_filterLicenseStatus"
                        ValueChanged="@((string v) => { _filterLicenseStatus = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>

        <label class="ps-toggle-label">
            <input type="checkbox" @bind="_filterActiveOnly" @bind:after="ApplyFilters" />
            Active only
        </label>
    </Filters>
</AppFilterPanel>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
        @_loadError
    </div>
}

<!-- Grid -->
<div class="um-grid-card app-datagrid">
    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading…</span>
        </div>
    }
    <SfGrid TValue="StaffEntry"
            DataSource="_entries"
            AllowPaging="true"
            AllowSorting="true"
            EnableHover="true"
            RowHeight="52">
        <GridEvents TValue="StaffEntry" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" PageSizes="@(new int[] { 10, 25, 50, 100 })" />
        <GridColumns>
            <GridColumn Field="@nameof(StaffEntry.FullName)" HeaderText="Name" Width="200">
                <Template>
                    @{ var e = (StaffEntry)context; }
                    <div class="ps-name-cell">
                        <span class="ps-avatar" style="@AvatarStyle(e)" aria-hidden="true">@Initials(e)</span>
                        <div>
                            <div class="ps-full-name">@e.FullName</div>
                            <div class="ps-email">@e.Email</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(StaffEntry.Role)" HeaderText="Role" Width="120">
                <Template>
                    @{ var e = (StaffEntry)context; }
                    <span class="@RoleBadgeClass(e.Role)">@e.Role</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(StaffEntry.Npn)" HeaderText="NPN" Width="130">
                <Template>
                    @{ var e = (StaffEntry)context; }
                    <span class="ps-mono">@e.Npn</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(StaffEntry.LicenseState)" HeaderText="Lic. State" Width="100" />
            <GridColumn Field="@nameof(StaffEntry.LicenseExpiry)" HeaderText="Lic. Expiry" Width="130">
                <Template>
                    @{ var e = (StaffEntry)context; }
                    <span class="@LicenseExpiryClass(e)">
                        @(e.LicenseExpiry.HasValue ? e.LicenseExpiry.Value.ToString("d") : "—")
                    </span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(StaffEntry.AppointmentCount)" HeaderText="Appointments" Width="130" />
            <GridColumn Field="@nameof(StaffEntry.Department)" HeaderText="Department" Width="160" />
            <GridColumn Field="@nameof(StaffEntry.TeamName)" HeaderText="Team" Width="150" />
            <GridColumn Field="@nameof(StaffEntry.IsActive)" HeaderText="Status" Width="100">
                <Template>
                    @{ var e = (StaffEntry)context; }
                    <AppStatusBadge Status="@(e.IsActive ? "Active" : "Inactive")" Label="@(e.IsActive ? "Active" : "Inactive")" />
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Right">
                <Template>
                    @{ var e = (StaffEntry)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEditDrawer(e)" title="Edit">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => ConfirmRemoveProducerRole(e)" title="Remove Producer role">
                        <i class="bi bi-trash3" aria-hidden="true"></i>
                    </button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<!-- Add/Edit Drawer -->
<AppCrudDrawer @bind-Visible="_showDrawer"
               Title="@(_editModel.StaffId == Guid.Empty ? "Add Producer" : "Edit Producer")"
               OnConfirm="SaveStaffAsync"
               OnClose="CloseDrawer">
    <Content>
        @if (_editContext is not null)
        {
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="ps-form">
                    <label class="ps-form-label">First Name *</label>
                    <InputText class="um-input" @bind-Value="_editModel.FirstName" />
                    <ValidationMessage For="() => _editModel.FirstName" class="text-danger" />

                    <label class="ps-form-label">Last Name *</label>
                    <InputText class="um-input" @bind-Value="_editModel.LastName" />
                    <ValidationMessage For="() => _editModel.LastName" class="text-danger" />

                    <label class="ps-form-label">Email *</label>
                    <InputText class="um-input" type="email" @bind-Value="_editModel.Email" />
                    <ValidationMessage For="() => _editModel.Email" class="text-danger" />

                    <label class="ps-form-label">Department *</label>
                    <SfDropDownList TValue="string" TItem="LabelValue"
                                    DataSource="_departmentOptions"
                                    @bind-Value="_editModel.Department"
                                    Placeholder="Select department"
                                    Width="100%">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                    <ValidationMessage For="() => _editModel.Department" class="text-danger" />

                    <label class="ps-form-label">Team *</label>
                    <SfDropDownList TValue="string" TItem="LabelValue"
                                    DataSource="_teamOptions"
                                    @bind-Value="_editModel.TeamName"
                                    Placeholder="Select team"
                                    Width="100%">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                    <ValidationMessage For="() => _editModel.TeamName" class="text-danger" />

                    <label class="ps-form-label">NPN</label>
                    <InputText class="um-input ps-mono" @bind-Value="_editModel.Npn" />

                    <label class="ps-form-label">License State</label>
                    <InputText class="um-input" @bind-Value="_editModel.LicenseState" />

                    <label class="ps-form-label">License Expiry</label>
                    <InputDate class="um-input" @bind-Value="_editModel.LicenseExpiry" />

                    <label class="ps-form-label">Active</label>
                    <SfSwitch @bind-Checked="_editModel.IsActive" />
                </div>
            </EditForm>
        }
    </Content>
</AppCrudDrawer>

<SfDialog @bind-Visible="_showRemoveConfirm"
          Width="440px"
          IsModal="true"
          ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon um-confirm-icon--danger">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                </div>
                <div>
                    <h3>Remove Producer role?</h3>
                    <p>This will remove the Producer role from <strong>@_pendingRemove?.FullName</strong>. The user account will remain active unless changed separately.</p>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CloseRemoveConfirm">Cancel</button>
                <button type="button" class="um-btn um-btn-danger" @onclick="ExecuteRemoveProducerRoleAsync">Remove role</button>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;

    private List<StaffEntry> _allEntries = [];
    private List<StaffEntry> _entries    = [];
    private List<LabelValue> _departmentOptions = [];
    private List<LabelValue> _teamOptions = [];

    private bool _loading    = false;
    private bool _showDrawer = false;
    private bool _showRemoveConfirm = false;

    private string _search               = string.Empty;
    private string _filterRole           = string.Empty;
    private string _filterLicenseStatus  = string.Empty;
    private bool   _filterActiveOnly     = false;
    private string _activeFilter         = "Overview";
    private string? _loadError;
    private EditContext? _editContext;
    private StaffEntry? _pendingRemove;

    private int _totalCount          = 0;
    private int _producerCount       = 0;
    private int _activeProducerCount = 0;
    private int _licenseExpiringCount = 0;
    private int _licenseExpiredCount = 0;

    private static readonly List<LabelValue> _roleOptions =
    [
        new("Producer", "Producer"),
        new("CSR",      "CSR"),
        new("Manager",  "Manager"),
    ];

    private static readonly List<LabelValue> _licenseStatusOptions =
    [
        new("Active",   "Active"),
        new("Expiring", "Expiring (90 days)"),
        new("Expired",  "Expired"),
    ];

    private StaffEntry _editModel = new();

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",          "/"),
            new("Agency Setup",  "/tenant/agency/profile"),
            new("Producers", "/tenant/agency/producers"));

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _loadError = null;
            await LoadLookupOptionsAsync();
            var users = await Api.SearchUsersAsync(_tenantId, pageSize: 1000);
            var producerRoleUserIds = await GetUserIdsByRoleAsync("Producer");
            _allEntries = users?.Items.Where(u => producerRoleUserIds.Contains(u.UserId) || HasAssignedRole(u, "Producer")).Select(u => new StaffEntry
            {
                StaffId = u.UserId,
                FirstName = FirstName(u.FullName),
                LastName = LastName(u.FullName),
                Email = u.Email,
                Role = "Producer",
                Department = u.Department ?? string.Empty,
                TeamName = u.JobTitle ?? string.Empty,
                Npn = string.Empty,
                LicenseState = u.Region ?? string.Empty,
                LicenseExpiry = null,
                AppointmentCount = 0,
                IsActive = IsActiveUser(u)
            }).ToList() ?? [];
            ComputeKpi();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _loadError = $"Load failed: {ex.Message}";
            await ShowToastAsync($"Error loading staff: {ex.Message}", "e-toast-danger");
        }
        finally { _loading = false; }
    }

    private async Task OnSearchAsync(string _) => await LoadAsync();

    private void ApplyFilters()
    {
        var cutoffExpiry = DateTime.Today.AddDays(90);
        _entries = _allEntries.Where(e =>
            RoleEquals(e.Role, "Producer") &&
            (_activeFilter switch
            {
                "Active" => e.IsActive,
                "Expiring" => e.LicenseExpiry.HasValue && e.LicenseExpiry.Value <= cutoffExpiry && e.LicenseExpiry.Value >= DateTime.Today,
                "Expired" => e.LicenseExpiry.HasValue && e.LicenseExpiry.Value < DateTime.Today,
                _ => true
            }) &&
            (string.IsNullOrEmpty(_filterRole) || RoleEquals(e.Role, _filterRole)) &&
            (!_filterActiveOnly || e.IsActive) &&
            (string.IsNullOrEmpty(_filterLicenseStatus) ||
             (_filterLicenseStatus == "Active"   && e.LicenseExpiry > cutoffExpiry) ||
             (_filterLicenseStatus == "Expiring" && e.LicenseExpiry.HasValue && e.LicenseExpiry.Value <= cutoffExpiry && e.LicenseExpiry.Value >= DateTime.Today) ||
             (_filterLicenseStatus == "Expired"  && e.LicenseExpiry < DateTime.Today)) &&
            (string.IsNullOrEmpty(_search) ||
             e.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             e.Email.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             e.Npn.Contains(_search, StringComparison.OrdinalIgnoreCase))
        ).ToList();

        StateHasChanged();
    }

    private void SetKpiFilter(string filter)
    {
        _activeFilter = _activeFilter == filter && filter != "Overview" ? "Overview" : filter;
        _filterRole = "Producer";
        _filterActiveOnly = _activeFilter == "Active";
        ApplyFilters();
    }

    private string KpiClass(string filter) => _activeFilter == filter ? "as-kpi-card--active" : string.Empty;

    private void OnRowSelected(RowSelectEventArgs<StaffEntry> args) => OpenEditDrawer(args.Data);

    private void ComputeKpi()
    {
        var cutoff = DateTime.Today.AddDays(90);
        _totalCount          = _allEntries.Count;
        _producerCount       = _allEntries.Count(e => RoleEquals(e.Role, "Producer"));
        _activeProducerCount = _allEntries.Count(e => RoleEquals(e.Role, "Producer") && e.IsActive);
        _licenseExpiringCount = _allEntries.Count(e => RoleEquals(e.Role, "Producer") && e.LicenseExpiry.HasValue && e.LicenseExpiry.Value <= cutoff && e.LicenseExpiry.Value >= DateTime.Today);
        _licenseExpiredCount = _allEntries.Count(e => RoleEquals(e.Role, "Producer") && e.LicenseExpiry.HasValue && e.LicenseExpiry.Value < DateTime.Today);
    }

    private void OpenAddDrawer()  { _editModel = new() { Role = "Producer" }; _editContext = new EditContext(_editModel); _showDrawer = true; }
    private void OpenEditDrawer(StaffEntry e) { _editModel = new StaffEntry { StaffId = e.StaffId, FirstName = e.FirstName, LastName = e.LastName, Email = e.Email, Role = e.Role, Department = e.Department, TeamName = e.TeamName, Npn = e.Npn, LicenseState = e.LicenseState, LicenseExpiry = e.LicenseExpiry, AppointmentCount = e.AppointmentCount, IsActive = e.IsActive }; _editContext = new EditContext(_editModel); _showDrawer = true; }
    private void CloseDrawer() => _showDrawer = false;

    private async Task SaveStaffAsync()
    {
        try
        {
            if (_editContext?.Validate() != true)
            {
                await ShowToastAsync("Please fix validation errors before saving.", "e-toast-danger");
                return;
            }

            var fullName = $"{_editModel.FirstName} {_editModel.LastName}".Trim();
            if (_editModel.StaffId == Guid.Empty)
            {
                var userId = await Api.CreateUserAsync(new CreateUserRequest
                {
                    TenantId = _tenantId,
                    UserName = string.IsNullOrWhiteSpace(_editModel.Email) ? $"{_editModel.FirstName}.{_editModel.LastName}".Trim('.').ToLowerInvariant() : _editModel.Email,
                    Email = _editModel.Email,
                    FullName = fullName,
                    DisplayName = fullName,
                    UserTypeCode = "Internal",
                    StatusCode = _editModel.IsActive ? "Active" : "Inactive",
                    Department = _editModel.Department,
                    Region = _editModel.LicenseState,
                    JobTitle = _editModel.TeamName,
                    TimeZoneCode = "UTC",
                    LocaleCode = "en-US"
                });
                await EnsureUserRoleAsync(userId, "Producer");
            }
            else
            {
                await Api.UpdateUserAsync(_editModel.StaffId, new UpdateUserRequest
                {
                    UserId = _editModel.StaffId,
                    FullName = fullName,
                    DisplayName = fullName,
                    Department = _editModel.Department,
                    Region = _editModel.LicenseState,
                    JobTitle = _editModel.TeamName,
                    TimeZoneCode = "UTC",
                    LocaleCode = "en-US"
                });
                await EnsureUserRoleAsync(_editModel.StaffId, "Producer");
                await Api.SetUserActiveAsync(_editModel.StaffId, _editModel.IsActive);
            }

            _showDrawer = false;
            await LoadAsync();
            await ShowToastAsync("Producer record saved.", "e-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Save failed: {ex.Message}", "e-toast-danger");
        }
    }

    private void ConfirmRemoveProducerRole(StaffEntry entry)
    {
        _pendingRemove = entry;
        _showRemoveConfirm = true;
    }

    private void CloseRemoveConfirm()
    {
        _showRemoveConfirm = false;
        _pendingRemove = null;
    }

    private async Task ExecuteRemoveProducerRoleAsync()
    {
        if (_pendingRemove is null)
            return;

        try
        {
            var assignment = await GetUserRoleAssignmentAsync(_pendingRemove.StaffId, "Producer");
            if (assignment is not null)
            {
                await Api.RevokeUserRoleAsync(new RevokeUserRoleRequest { UserRoleId = assignment.UserRoleId, Reason = "Removed from Producer page" });
            }

            CloseRemoveConfirm();
            await LoadAsync();
            await ShowToastAsync("Producer role removed.", "e-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Remove failed: {ex.Message}", "e-toast-danger");
        }
    }

    private async Task LoadLookupOptionsAsync()
    {
        var departments = await Api.GetDepartmentsAsync(_tenantId);
        _departmentOptions = departments?.Where(d => d.IsActive).OrderBy(d => d.DepartmentName).Select(d => new LabelValue(d.DepartmentName, d.DepartmentName)).ToList() ?? [];

        var teams = await Api.GetTeamsAsync(_tenantId);
        _teamOptions = teams?.Where(t => t.IsActive).OrderBy(t => t.TeamName).Select(t => new LabelValue(t.TeamName, t.TeamName)).ToList() ?? [];
    }

    private async Task ShowToastAsync(string msg, string cssClass = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = cssClass });
    }

    private static string Initials(StaffEntry e)
    {
        var parts = e.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : e.FullName.Length >= 1 ? e.FullName[..1] : "?";
    }

    private static string AvatarStyle(StaffEntry e)
    {
        var hue = Math.Abs(e.Email.GetHashCode()) % 360;
        return $"background:hsl({hue},50%,42%);color:#fff;";
    }

    private static string RoleBadgeClass(string role) => role switch
    {
        "Producer" => "ps-role-badge ps-role-badge--producer",
        "CSR"      => "ps-role-badge ps-role-badge--csr",
        "Manager"  => "ps-role-badge ps-role-badge--manager",
        _          => "ps-role-badge",
    };

    private static string LicenseExpiryClass(StaffEntry e)
    {
        if (!e.LicenseExpiry.HasValue) return "";
        if (e.LicenseExpiry.Value < DateTime.Today)     return "ps-expiry ps-expiry--expired";
        if (e.LicenseExpiry.Value < DateTime.Today.AddDays(90)) return "ps-expiry ps-expiry--expiring";
        return "ps-expiry";
    }

    private static bool RoleEquals(string? actual, string expected) => string.Equals(actual?.Trim(), expected, StringComparison.OrdinalIgnoreCase);
    private async Task<HashSet<Guid>> GetUserIdsByRoleAsync(string roleName)
    {
        var assignments = await Api.SearchUserRolesAsync(_tenantId, isActive: true, pageSize: 5000);
        return assignments?.Items
            .Where(role => RoleEquals(role.RoleName, roleName) || RoleEquals(role.RoleCode, roleName))
            .Select(role => role.UserId)
            .ToHashSet() ?? [];
    }

    private async Task<UserRoleDto?> GetUserRoleAssignmentAsync(Guid userId, string roleName)
    {
        var assignments = await Api.SearchUserRolesAsync(_tenantId, userId: userId, isActive: true, pageSize: 100);
        return assignments?.Items.FirstOrDefault(role => RoleEquals(role.RoleName, roleName) || RoleEquals(role.RoleCode, roleName));
    }

    private async Task EnsureUserRoleAsync(Guid userId, string roleName)
    {
        if (await GetUserRoleAssignmentAsync(userId, roleName) is not null)
            return;

        var roles = await Api.SearchRolesAsync(_tenantId, roleName);
        var role = roles?.Items.FirstOrDefault(r => RoleEquals(r.RoleName, roleName) || RoleEquals(r.RoleCode, roleName));
        if (role is null)
            throw new InvalidOperationException($"The {roleName} role was not found.");

        await Api.AssignUserRoleAsync(new AssignUserRoleRequest
        {
            TenantId = _tenantId,
            UserId = userId,
            RoleId = role.RoleId,
            Source = "Agency Staff",
            Reason = $"Assigned from {roleName} page"
        });
    }

    private static bool HasAssignedRole(UserDto user, string roleName) => HasRoleToken(user.AssignedRoleNames, roleName) || HasRoleToken(user.AssignedRoleCodes, roleName);
    private static bool HasRoleToken(string? roles, string roleName) => (roles ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Any(role => RoleEquals(role, roleName));
    private static bool IsActiveUser(UserDto user) => string.Equals(user.StatusCode, "Active", StringComparison.OrdinalIgnoreCase) && !user.IsLockedOut;
    private static string FirstName(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? string.Empty : parts[0];
    }
    private static string LastName(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length <= 1 ? string.Empty : string.Join(' ', parts.Skip(1));
    }

    private sealed record LabelValue(string Value, string Label);

    private sealed class StaffEntry
    {
        public Guid      StaffId          { get; set; } = Guid.Empty;
        [Required]
        [StringLength(100)]
        public string    FirstName        { get; set; } = string.Empty;
        [Required]
        [StringLength(100)]
        public string    LastName         { get; set; } = string.Empty;
        public string    FullName         => $"{FirstName} {LastName}".Trim();
        [Required]
        [EmailAddress]
