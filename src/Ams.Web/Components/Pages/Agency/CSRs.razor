@page "/tenant/agency/csrs"
@namespace Ams.Web.Components.Pages.AgencyAdmin
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>CSRs — Agency Setup</PageTitle>

<AppPageHeader Title="Customer Service Representatives"
               Subtitle="Customer service representatives and their assignments"
               Icon="bi-headset">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenAddDrawer">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add CSR
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="csr-kpi-strip">
    <div class="@KpiClass1" @onclick="() => SetKpiFilter(1)" role="button" tabindex="0">
        <span class="csr-kpi-icon csr-kpi-icon--total"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
        <div><div class="csr-kpi-value">@_totalCount</div><div class="csr-kpi-label">Total CSRs</div></div>
        @if (_kpiActive == 1) { <span class="csr-kpi-active-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass2" @onclick="() => SetKpiFilter(2)" role="button" tabindex="0">
        <span class="csr-kpi-icon csr-kpi-icon--active"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
        <div><div class="csr-kpi-value">@_activeCount</div><div class="csr-kpi-label">Active</div></div>
        @if (_kpiActive == 2) { <span class="csr-kpi-active-dot" aria-hidden="true"></span> }
    </div>
</div>

<!-- Filter toolbar -->
<AppFilterPanel @bind-SearchValue="_search"
                OnSearch="OnSearchAsync"
                SearchPlaceholder="Search name or email…">
    <Filters>
        <label class="csr-toggle-label">
            <input type="checkbox" @bind="_filterActiveOnly" @bind:after="ApplyFilters" />
            Active only
        </label>
    </Filters>
</AppFilterPanel>

<!-- Grid -->
<div class="um-grid-card app-datagrid">
    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading…</span>
        </div>
    }
    <SfGrid TValue="CsrEntry"
            DataSource="_entries"
            AllowPaging="true"
            AllowSorting="true"
            EnableHover="true"
            RowHeight="52">
        <GridPageSettings PageSize="25" PageSizes="@(new int[] { 10, 25, 50, 100 })" />
        <GridColumns>
            <GridColumn Field="@nameof(CsrEntry.FullName)" HeaderText="Name" Width="220">
                <Template>
                    @{ var e = (CsrEntry)context; }
                    <div class="csr-name-cell">
                        <span class="csr-avatar" style="@AvatarStyle(e)" aria-hidden="true">@Initials(e)</span>
                        <div>
                            <div class="csr-full-name">@e.FullName</div>
                            <div class="csr-email">@e.Email</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(CsrEntry.Department)" HeaderText="Department" Width="180" />
            <GridColumn Field="@nameof(CsrEntry.TeamName)" HeaderText="Team" Width="160" />
            <GridColumn Field="@nameof(CsrEntry.IsActive)" HeaderText="Status" Width="110">
                <Template>
                    @{ var e = (CsrEntry)context; }
                    <AppStatusBadge Status="@(e.IsActive ? "Active" : "Inactive")"
                                    Label="@(e.IsActive ? "Active" : "Inactive")" />
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Right">
                <Template>
                    @{ var e = (CsrEntry)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditDrawer(e)" title="Edit">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<!-- Add/Edit Drawer -->
<AppCrudDrawer @bind-Visible="_showDrawer"
               Title="@(_editModel.StaffId == Guid.Empty ? "Add CSR" : "Edit CSR")"
               OnConfirm="SaveAsync"
               OnClose="CloseDrawer">
    <Content>
        <div class="csr-form">
            <label class="csr-form-label">First Name *</label>
            <input class="um-input" @bind="_editModel.FirstName" />

            <label class="csr-form-label">Last Name *</label>
            <input class="um-input" @bind="_editModel.LastName" />

            <label class="csr-form-label">Email *</label>
            <input class="um-input" type="email" @bind="_editModel.Email" />

            <label class="csr-form-label">Department</label>
            <input class="um-input" @bind="_editModel.Department" />

            <label class="csr-form-label">Team</label>
            <input class="um-input" @bind="_editModel.TeamName" />

            <label class="csr-form-label">Active</label>
            <SfSwitch @bind-Checked="_editModel.IsActive" />
        </div>
    </Content>
</AppCrudDrawer>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;

    private List<CsrEntry> _allEntries = [];
    private List<CsrEntry> _entries    = [];

    private bool _loading    = false;
    private bool _showDrawer = false;

    private string _search          = string.Empty;
    private bool   _filterActiveOnly = false;
    private int    _kpiActive       = 0;

    private int _totalCount  = 0;
    private int _activeCount = 0;

    private string KpiClass1 => "csr-kpi-card" + (_kpiActive == 1 ? " csr-kpi-card--active" : "");
    private string KpiClass2 => "csr-kpi-card" + (_kpiActive == 2 ? " csr-kpi-card--active" : "");

    private CsrEntry _editModel = new();

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",         "/"),
            new("Agency Setup", "/tenant/agency/profile"),
            new("CSRs",         "/tenant/agency/csrs"));

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var staff = await Api.GetStaffAsync(_tenantId);
            _allEntries = staff?.Where(s => s.Role == "CSR")
                .Select(s => new CsrEntry
                {
                    StaffId = s.StaffId,
                    FirstName = s.FirstName,
                    LastName = s.LastName,
                    Email = s.Email ?? string.Empty,
                    Department = s.Department ?? string.Empty,
                    TeamName = s.TeamName ?? string.Empty,
                    IsActive = s.IsActive
                }).ToList() ?? [];
            ComputeKpi();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Error loading CSRs: {ex.Message}", "e-toast-danger");
        }
        finally { _loading = false; }
    }

    private async Task OnSearchAsync(string _) => await LoadAsync();

    private void ApplyFilters()
    {
        _entries = _allEntries.Where(e =>
            (!_filterActiveOnly || e.IsActive) &&
            (string.IsNullOrEmpty(_search) ||
             e.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             e.Email.Contains(_search, StringComparison.OrdinalIgnoreCase))
        ).ToList();

        if (_kpiActive == 2) _entries = _entries.Where(e => e.IsActive).ToList();

        StateHasChanged();
    }

    private void SetKpiFilter(int n)
    {
        _kpiActive       = _kpiActive == n ? 0 : n;
        _filterActiveOnly = _kpiActive == 2;
        ApplyFilters();
    }

    private void ComputeKpi()
    {
        _totalCount  = _allEntries.Count;
        _activeCount = _allEntries.Count(e => e.IsActive);
    }

    private void OpenAddDrawer()  { _editModel = new(); _showDrawer = true; }
    private void OpenEditDrawer(CsrEntry e) { _editModel = new CsrEntry { StaffId = e.StaffId, FirstName = e.FirstName, LastName = e.LastName, Email = e.Email, Department = e.Department, TeamName = e.TeamName, IsActive = e.IsActive }; _showDrawer = true; }
    private void CloseDrawer() => _showDrawer = false;

    private async Task SaveAsync()
    {
        // TODO: Api.SaveCsrAsync
        await Task.Delay(0);
        _showDrawer = false;
        await LoadAsync();
        await ShowToastAsync("CSR saved.", "e-toast-success");
    }

    private async Task ShowToastAsync(string msg, string cssClass = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = cssClass });
    }

    private static string Initials(CsrEntry e)
    {
        var parts = e.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : e.FullName.Length >= 1 ? e.FullName[..1] : "?";
    }

    private static string AvatarStyle(CsrEntry e)
    {
        var hue = Math.Abs(e.Email.GetHashCode()) % 360;
        return $"background:hsl({hue},50%,42%);color:#fff;";
    }

    private sealed class CsrEntry
    {
        public Guid   StaffId    { get; set; } = Guid.Empty;
        public string FirstName  { get; set; } = string.Empty;
        public string LastName   { get; set; } = string.Empty;
        public string FullName   => $"{FirstName} {LastName}".Trim();
        public string Email      { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string TeamName   { get; set; } = string.Empty;
        public bool   IsActive   { get; set; } = true;
    }
}
