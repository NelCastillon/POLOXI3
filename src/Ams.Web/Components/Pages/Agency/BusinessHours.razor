    private sealed class BusinessHoursModel
    {
        public string TimeZoneId { get; set; } = "Eastern Standard Time";
        public bool EmergencyClosing { get; set; }
        public string? EmergencyMessage { get; set; }
        public List<BusinessDayModel> WeeklySchedule { get; set; } = [];
        public List<HolidayClosureModel> HolidayClosures { get; set; } = [];

        public static BusinessHoursModel FromDto(AgencyBusinessHoursDto? dto)
        {
            if (dto is null)
            {
                return CreateDefault();
            }

            return new BusinessHoursModel
            {
                TimeZoneId = string.IsNullOrWhiteSpace(dto.TimeZoneId) ? "Eastern Standard Time" : dto.TimeZoneId,
                EmergencyClosing = dto.EmergencyClosing,
                EmergencyMessage = dto.EmergencyMessage,
                WeeklySchedule = NormalizeSchedule(dto.WeeklySchedule.Select(BusinessDayModel.FromDto)),
                HolidayClosures = dto.HolidayClosures.OrderBy(h => h.Date).Select(HolidayClosureModel.FromDto).ToList()
            };
        }

        public static BusinessHoursModel CreateDefault()
            => new()
            {
                WeeklySchedule = NormalizeSchedule([]),
                HolidayClosures =
                [
                    new() { Date = new DateOnly(DateTime.Today.Year, 1, 1), Name = "New Year's Day" },
                    new() { Date = new DateOnly(DateTime.Today.Year, 7, 4), Name = "Independence Day" },
                    new() { Date = new DateOnly(DateTime.Today.Year, 12, 25), Name = "Christmas Day" }
                ]
            };

        public UpdateAgencyBusinessHoursRequest ToRequest()
            => new()
            {
                TimeZoneId = TimeZoneId,
                EmergencyClosing = EmergencyClosing,
                EmergencyMessage = EmergencyMessage,
                WeeklySchedule = WeeklySchedule.Select(d => d.ToDto()).ToList(),
                HolidayClosures = HolidayClosures.OrderBy(h => h.Date).Select(h => h.ToDto()).ToList()
            };

        private static List<BusinessDayModel> NormalizeSchedule(IEnumerable<BusinessDayModel> source)
        {
            var byDay = source.GroupBy(d => d.DayOfWeek).ToDictionary(g => g.Key, g => g.First());
            var days = new List<BusinessDayModel>(7);
            for (var i = 0; i < 7; i++)
            {
                if (byDay.TryGetValue(i, out var existing))
                {
                    existing.DayName = Enum.GetName((DayOfWeek)i) ?? i.ToString();
                    existing.DayOfWeek = i;
                    days.Add(existing);
                }
                else
                {
                    days.Add(new BusinessDayModel { DayOfWeek = i, DayName = Enum.GetName((DayOfWeek)i) ?? i.ToString(), IsOpen = i is >= 1 and <= 5 });
                }
            }
            return days;
        }
    }

    private sealed class BusinessDayModel
    {
        public string DayName { get; set; } = string.Empty;
        public int DayOfWeek { get; set; }
        public bool IsOpen { get; set; }
        public TimeOnly OpenTime { get; set; } = new(8, 0);
        public TimeOnly CloseTime { get; set; } = new(17, 0);
        public bool HasLunchBreak { get; set; }
        public TimeOnly LunchStart { get; set; } = new(12, 0);
        public TimeOnly LunchEnd { get; set; } = new(13, 0);

        public static BusinessDayModel FromDto(AgencyBusinessDayDto dto)
            => new()
            {
                DayName = dto.DayName,
                DayOfWeek = dto.DayOfWeek,
                IsOpen = dto.IsOpen,
                OpenTime = dto.OpenTime,
                CloseTime = dto.CloseTime,
                HasLunchBreak = dto.HasLunchBreak,
                LunchStart = dto.LunchStart ?? new TimeOnly(12, 0),
                LunchEnd = dto.LunchEnd ?? new TimeOnly(13, 0)
            };

        public AgencyBusinessDayDto ToDto()
            => new()
            {
                DayName = DayName,
                DayOfWeek = DayOfWeek,
                IsOpen = IsOpen,
                OpenTime = OpenTime,
                CloseTime = CloseTime,
                HasLunchBreak = HasLunchBreak,
                LunchStart = HasLunchBreak ? LunchStart : null,
                LunchEnd = HasLunchBreak ? LunchEnd : null
            };
    }

    private sealed class HolidayClosureModel
    {
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public string Name { get; set; } = string.Empty;

        public static HolidayClosureModel FromDto(AgencyHolidayClosureDto dto)
            => new() { Date = dto.Date, Name = dto.Name };

        public AgencyHolidayClosureDto ToDto()
            => new() { Date = Date, Name = Name.Trim() };
    }
