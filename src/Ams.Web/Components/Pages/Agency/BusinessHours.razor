@page "/tenant/agency/hours"
@namespace Ams.Web.Components.Pages.AgencyAdmin
@using Ams.Application.Features.Agency
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject IJSRuntime Js

<PageTitle>Business Hours — Agency Setup</PageTitle>

<AppPageHeader Title="Business Hours"
               Subtitle="Enterprise operating schedule, routing availability, holiday closures, and emergency agency status."
               Icon="bi-clock-history">
    <Actions>
        <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <a class="um-btn um-btn-ghost" href="/tenant/agency/profile"><i class="bi bi-building-check" aria-hidden="true"></i> Profile</a>
        <a class="um-btn um-btn-ghost" href="/tenant/agency/branches"><i class="bi bi-diagram-3" aria-hidden="true"></i> Branches</a>
        <button class="um-btn um-btn-primary" type="button" @onclick="SaveChangesAsync" disabled="@(_saving || _loading)">
            @if (_saving)
            {
                <span class="um-spinner um-spinner-sm" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-floppy" aria-hidden="true"></i>
            }
            Save Hours
        </button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="bh-toast @_toastClass" role="status">
        <i class="bi @(_toastClass == "bh-toast--danger" ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="bh-toast-close" @onclick="ClearToast" aria-label="Dismiss message"><i class="bi bi-x-lg"></i></button>
    </div>
}

<div class="bh-page">
    <section class="bh-hero">
        <div class="bh-hero-main">
            <span class="bh-eyebrow"><i class="bi bi-command" aria-hidden="true"></i> Tenant · Operating Model</span>
            <h2>Business Hours Command Center</h2>
            <p>Control the canonical availability data used by intake routing, client portal messaging, SLA expectations, branch handoffs, and emergency closure workflows.</p>
            <div class="bh-hero-meta">
                <span><i class="bi bi-calendar-week" aria-hidden="true"></i> @_openDays open day(s)</span>
                <span><i class="bi bi-globe-americas" aria-hidden="true"></i> @TimezoneLabel</span>
                <span><i class="bi @(_model.EmergencyClosing ? "bi-exclamation-octagon" : "bi-check-circle")" aria-hidden="true"></i> @(_model.EmergencyClosing ? "Emergency closed" : "Normal operations")</span>
            </div>
        </div>
        <div class="bh-hero-panel">
            <div class="bh-readiness-card">
                <span>Hours readiness</span>
                <strong>@ReadinessScore%</strong>
                <div class="bh-score-track"><div style="width:@ReadinessScore%"></div></div>
                <small>@ReadinessSummary</small>
            </div>
            <div class="bh-action-list">
                @foreach (var action in PriorityActions)
                {
                    <button type="button" class="bh-action-item" @onclick="() => RunPriorityAction(action)">
                        <i class="bi @action.Icon" aria-hidden="true"></i>
                        <span><strong>@action.Title</strong><small>@action.Detail</small></span>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="bh-kpi-strip" aria-label="Business hours KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="bh-kpi-card @(IsActiveTab(kpi.Key) ? "bh-kpi-card--active" : null)" title="@kpi.Tooltip" @onclick="() => SetTab(kpi.Key)">
                <span class="bh-kpi-icon bh-kpi-icon--@kpi.Tone"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="bh-kpi-label">@kpi.Label</span>
                <strong>@kpi.Value</strong>
                <small>@kpi.Detail</small>
            </button>
        }
    </section>

    <section class="bh-command-bar">
        <div class="bh-tabs" role="tablist" aria-label="Business hours sections">
            @foreach (var tab in Tabs)
            {
                <button type="button" role="tab" class="bh-tab @(IsActiveTab(tab.Key) ? "bh-tab--active" : null)" @onclick="() => SetTab(tab.Key)">
                    <i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label
                </button>
            }
        </div>
        <div class="bh-command-actions">
            <button class="um-btn um-btn-ghost" type="button" @onclick="CopySummaryAsync" disabled="@_loading"><i class="bi bi-clipboard" aria-hidden="true"></i> Copy Summary</button>
            <button class="um-btn um-btn-ghost" type="button" @onclick="ResetToDefaults" disabled="@_loading"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset Defaults</button>
            <button class="um-btn um-btn-primary" type="button" @onclick="SaveChangesAsync" disabled="@(_saving || _loading)"><i class="bi bi-floppy" aria-hidden="true"></i> Save Hours</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger bh-load-error" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError
        </div>
    }

    <section class="bh-content-grid">
        <div class="bh-main-panel">
            @if (_loading)
            {
                <div class="bh-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading business hours...</div>
            }
            else
            {
                @if (ShowTab("overview"))
                {
                    <section class="bh-section">
                        <div class="bh-section-header"><i class="bi bi-speedometer2" aria-hidden="true"></i><div><strong>Executive Overview</strong><span>Most important operating availability signals by workflow impact.</span></div></div>
                        <div class="bh-overview-grid">
                            <div class="bh-identity-card"><span class="bh-module-icon bh-module-icon--blue"><i class="bi bi-calendar-week"></i></span><div><strong>@_openDays open day(s)</strong><span>@WeeklyCoverageSummary</span></div></div>
                            <div class="bh-identity-card"><span class="bh-module-icon bh-module-icon--green"><i class="bi bi-clock"></i></span><div><strong>@TotalWeeklyHours.ToString("0.#") hours/week</strong><span>@LongestDaySummary</span></div></div>
                            <div class="bh-identity-card"><span class="bh-module-icon bh-module-icon--purple"><i class="bi bi-shield-check"></i></span><div><strong>@ReadinessScore% ready</strong><span>@ReadinessSummary</span></div></div>
                        </div>
                        <div class="bh-day-board">
                            @foreach (var day in _model.WeeklySchedule)
                            {
                                <button type="button" class="bh-day-card @(day.IsOpen ? "bh-day-card--open" : "bh-day-card--closed")" @onclick="() => FocusScheduleDay(day)">
                                    <span class="bh-day-card-day">@day.DayName[..3]</span>
                                    <strong>@(day.IsOpen ? $"{FormatTime(day.OpenTime)} - {FormatTime(day.CloseTime)}" : "Closed")</strong>
                                    <small>@(day.HasLunchBreak ? $"Lunch {FormatTime(day.LunchStart)} - {FormatTime(day.LunchEnd)}" : day.IsOpen ? "Continuous coverage" : "No routing")</small>
                                </button>
                            }
                        </div>
                    </section>
                }

                @if (ShowTab("schedule"))
                {
                    <section class="bh-section">
                        <div class="bh-section-header"><i class="bi bi-calendar-week" aria-hidden="true"></i><div><strong>Weekly Schedule</strong><span>Set standard opening, closing, lunch, and closed-day rules.</span></div></div>
                        <div class="bh-schedule-grid">
                            @foreach (var day in _model.WeeklySchedule)
                            {
                                <div class="bh-day-row @(day.IsOpen ? "bh-day-open" : "bh-day-closed") @(ReferenceEquals(day, _focusedDay) ? "bh-day-focused" : null)">
                                    <label class="bh-day-toggle">
                                        <input type="checkbox" @bind="day.IsOpen" class="bh-toggle-input" />
                                        <span class="bh-toggle-track" aria-hidden="true"><span class="bh-toggle-knob"></span></span>
                                        <span class="bh-day-name">@day.DayName</span>
                                    </label>
                                    @if (day.IsOpen)
                                    {
                                        <div class="bh-time-inputs">
                                            <div class="bh-time-group">
                                                <label class="bh-time-label">Opens</label>
                                                <input type="time" class="um-input bh-time-input" @bind="day.OpenTime" />
                                            </div>
                                            <span class="bh-time-sep">—</span>
                                            <div class="bh-time-group">
                                                <label class="bh-time-label">Closes</label>
                                                <input type="time" class="um-input bh-time-input" @bind="day.CloseTime" />
                                            </div>
                                            <label class="bh-lunch-label">
                                                <input type="checkbox" @bind="day.HasLunchBreak" />
                                                Lunch break
                                            </label>
                                            @if (day.HasLunchBreak)
                                            {
                                                <div class="bh-time-group">
                                                    <label class="bh-time-label">From</label>
                                                    <input type="time" class="um-input bh-time-input" @bind="day.LunchStart" />
                                                </div>
                                                <span class="bh-time-sep">—</span>
                                                <div class="bh-time-group">
                                                    <label class="bh-time-label">To</label>
                                                    <input type="time" class="um-input bh-time-input" @bind="day.LunchEnd" />
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="bh-closed-badge">Closed</span>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (ShowTab("timezone"))
                {
                    <section class="bh-section">
                        <div class="bh-section-header"><i class="bi bi-globe-americas" aria-hidden="true"></i><div><strong>Time Zone & Routing</strong><span>Align client-facing hours and automation cutoffs to the correct agency time zone.</span></div></div>
                        <div class="bh-timezone-panel">
                            <label class="bh-field-label" for="timezone-select">Agency Time Zone</label>
                            <select id="timezone-select" class="um-input bh-select" @bind="_model.TimeZoneId">
                                @foreach (var timezone in Timezones)
                                {
                                    <option value="@timezone.Value">@timezone.Label</option>
                                }
                            </select>
                            <p>Current operating windows, client portal availability notices, and after-hours routing are evaluated against <strong>@TimezoneLabel</strong>.</p>
                        </div>
                    </section>
                }

                @if (ShowTab("holidays"))
                {
                    <section class="bh-section">
                        <div class="bh-section-header"><i class="bi bi-calendar-x" aria-hidden="true"></i><div><strong>Holiday Closures</strong><span>Maintain agency-wide closure dates used by intake and client messaging.</span></div><button class="um-btn um-btn-ghost um-btn-sm" type="button" @onclick="AddHoliday"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Holiday</button></div>
                        @if (!_model.HolidayClosures.Any())
                        {
                            <div class="bh-empty-state"><i class="bi bi-calendar-plus" aria-hidden="true"></i><strong>No holiday closures configured</strong><span>Add dates when agency-wide service should be shown as closed.</span><button class="um-btn um-btn-primary" type="button" @onclick="AddHoliday"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Holiday</button></div>
                        }
                        else
                        {
                            <div class="bh-holiday-list">
                                @foreach (var holiday in _model.HolidayClosures)
                                {
                                    <div class="bh-holiday-row">
                                        <input type="date" class="um-input bh-holiday-date" @bind="holiday.Date" />
                                        <input type="text" class="um-input bh-holiday-name" @bind="holiday.Name" placeholder="Holiday name" maxlength="120" />
                                        <button class="bh-holiday-remove" type="button" @onclick="() => RequestRemoveHoliday(holiday)" aria-label="Remove holiday"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </div>
                                }
                            </div>
                        }
                    </section>
                }

                @if (ShowTab("emergency"))
                {
                    <section class="bh-section">
                        <div class="bh-section-header"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><div><strong>Emergency Closure</strong><span>Override standard hours during storms, outages, or agency-wide operational incidents.</span></div></div>
                        <div class="bh-emergency-panel @(_model.EmergencyClosing ? "bh-emergency-panel--active" : null)">
                            <label class="bh-emergency-toggle">
                                <input type="checkbox" @bind="_model.EmergencyClosing" />
                                <span>
                                    <strong>@(_model.EmergencyClosing ? "Emergency closure enabled" : "Normal operating status")</strong>
                                    <small>@(_model.EmergencyClosing ? "All client-facing availability should display emergency closure messaging." : "Standard weekly and holiday rules are active.")</small>
                                </span>
                            </label>
                            @if (_model.EmergencyClosing)
                            {
                                <div class="bh-emergency-message-wrap">
                                    <label class="bh-field-label" for="emergency-message">Closure Message</label>
                                    <textarea id="emergency-message" class="um-input bh-textarea" @bind="_model.EmergencyMessage" rows="3" maxlength="1000" placeholder="Example: Our office is temporarily closed due to severe weather. Claims emergencies are still being routed."></textarea>
                                </div>
                            }
                        </div>
                    </section>
                }
            }
        </div>

        <aside class="bh-side-panel" aria-label="Business hours governance">
            <div class="bh-side-card">
                <div class="bh-side-header"><i class="bi bi-activity" aria-hidden="true"></i><div><strong>Workflow impact</strong><span>Where these settings are used</span></div></div>
                <div class="bh-impact-list">
                    <span><i class="bi bi-router" aria-hidden="true"></i> Intake routing</span>
                    <span><i class="bi bi-chat-dots" aria-hidden="true"></i> Client portal notices</span>
                    <span><i class="bi bi-alarm" aria-hidden="true"></i> SLA expectations</span>
                    <span><i class="bi bi-telephone-forward" aria-hidden="true"></i> After-hours handoffs</span>
                </div>
            </div>
            <div class="bh-side-card">
                <div class="bh-side-header"><i class="bi bi-list-check" aria-hidden="true"></i><div><strong>Readiness checklist</strong><span>@ChecklistComplete of @Checklist.Count complete</span></div></div>
                <div class="bh-checklist">
                    @foreach (var item in Checklist)
                    {
                        <div class="bh-check-item @(item.Done ? "bh-check-item--done" : null)"><i class="bi @(item.Done ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i><span>@item.Text</span></div>
                    }
                </div>
            </div>
            <div class="bh-side-card">
                <div class="bh-side-header"><i class="bi bi-info-circle" aria-hidden="true"></i><div><strong>Last synced</strong><span>@LastSyncedText</span></div></div>
                <p class="bh-side-copy">Saving publishes the tenant-wide source of truth for business hours immediately through the agency API.</p>
            </div>
        </aside>
    </section>
</div>

@if (_holidayToRemove is not null)
{
    <div class="bh-modal-backdrop" role="presentation">
        <div class="bh-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="remove-holiday-title">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash" aria-hidden="true"></i></div>
                <div>
                    <h3 id="remove-holiday-title">Remove holiday closure?</h3>
                    <p class="bh-confirm-copy">Remove <strong>@_holidayToRemove.Name</strong> from agency-wide closure dates. Save hours to persist this change.</p>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CancelRemoveHoliday">Cancel</button>
                <button type="button" class="um-btn um-btn-danger" @onclick="ConfirmRemoveHoliday"><i class="bi bi-trash" aria-hidden="true"></i> Remove</button>
            </div>
        </div>
    </div>
}

@code {
    private Guid _tenantId;
    private bool _loading = true;
    private bool _saving;
    private string? _loadError;
    private string? _toastMessage;
    private string _toastClass = string.Empty;
    private string _activeTab = "overview";
    private DateTime? _lastSyncedUtc;
    private BusinessHoursModel _model = BusinessHoursModel.CreateDefault();
    private BusinessDayModel? _focusedDay;
    private HolidayClosureModel? _holidayToRemove;

    private int _openDays => _model.WeeklySchedule.Count(d => d.IsOpen);
    private double TotalWeeklyHours => _model.WeeklySchedule.Where(d => d.IsOpen).Sum(d => Math.Max(0, (d.CloseTime - d.OpenTime).TotalHours - (d.HasLunchBreak ? Math.Max(0, (d.LunchEnd - d.LunchStart).TotalHours) : 0)));
    private int ChecklistComplete => Checklist.Count(i => i.Done);
    private string TimezoneLabel => Timezones.FirstOrDefault(t => t.Value == _model.TimeZoneId)?.ShortLabel ?? _model.TimeZoneId;
    private string LastSyncedText => _lastSyncedUtc is null ? "Not synced this session" : $"{_lastSyncedUtc.Value.ToLocalTime():MMM d, yyyy h:mm tt}";
    private string WeeklyCoverageSummary => _openDays == 0 ? "No standard operating days" : _openDays == 7 ? "Every day coverage" : "Weekday and selected day coverage";
    private string LongestDaySummary => _model.WeeklySchedule.Where(d => d.IsOpen).OrderByDescending(d => d.CloseTime - d.OpenTime).Select(d => $"Longest window: {d.DayName}").FirstOrDefault() ?? "No open days configured";
    private int ReadinessScore => Math.Clamp((ChecklistComplete * 100) / Math.Max(Checklist.Count, 1), 0, 100);
    private string ReadinessSummary => ReadinessScore switch
    {
        >= 90 => "Schedule is enterprise ready.",
        >= 70 => "Minor cleanup recommended.",
        >= 40 => "Routing data needs attention.",
        _ => "Configure core operating data."
    };

    private IReadOnlyList<KpiCard> Kpis =>
    [
        new("overview", "Overview", _model.EmergencyClosing ? "Closed" : "Open", _model.EmergencyClosing ? "Emergency override active" : "Normal operating mode", "bi-speedometer2", _model.EmergencyClosing ? "red" : "blue", "Show operating overview"),
        new("schedule", "Open Days", _openDays.ToString(), $"{TotalWeeklyHours:0.#} coverage hours/week", "bi-calendar-week", "green", "Filter to the weekly schedule"),
        new("timezone", "Time Zone", TimezoneLabel, "Routing clock source", "bi-globe-americas", "purple", "Filter to time-zone settings"),
        new("holidays", "Holidays", _model.HolidayClosures.Count.ToString(), NextHolidaySummary, "bi-calendar-x", "amber", "Filter to holiday closures"),
        new("emergency", "Status", _model.EmergencyClosing ? "Closed" : "Normal", _model.EmergencyClosing ? "Closure message enabled" : "Standard rules apply", "bi-exclamation-octagon", _model.EmergencyClosing ? "red" : "slate", "Filter to emergency status")
    ];

    private IReadOnlyList<NavTab> Tabs =>
    [
        new("overview", "Overview", "bi-speedometer2"),
        new("schedule", "Schedule", "bi-calendar-week"),
        new("timezone", "Time Zone", "bi-globe-americas"),
        new("holidays", "Holidays", "bi-calendar-x"),
        new("emergency", "Emergency", "bi-exclamation-octagon")
    ];

    private IReadOnlyList<PriorityAction> PriorityActions =>
    [
        new("Review weekly schedule", "Validate service windows before publishing", "bi-calendar-check", "schedule"),
        new("Add holiday closures", "Protect SLA and portal messaging", "bi-calendar-plus", "holidays"),
        new("Emergency status", "Manage immediate agency availability", "bi-exclamation-triangle", "emergency")
    ];

    private IReadOnlyList<ChecklistItem> Checklist =>
    [
        new(_openDays > 0, "At least one operating day is open"),
        new(_model.WeeklySchedule.Where(d => d.IsOpen).All(d => d.CloseTime > d.OpenTime), "All open days have valid time windows"),
        new(!string.IsNullOrWhiteSpace(_model.TimeZoneId), "Agency time zone is selected"),
        new(!_model.EmergencyClosing || !string.IsNullOrWhiteSpace(_model.EmergencyMessage), "Emergency closure has clear client messaging"),
        new(_model.HolidayClosures.All(h => h.Date != default && !string.IsNullOrWhiteSpace(h.Name)), "Holiday closure entries are complete")
    ];

    private string NextHolidaySummary => _model.HolidayClosures.Where(h => h.Date >= DateOnly.FromDateTime(DateTime.Today)).OrderBy(h => h.Date).Select(h => $"Next: {h.Name}").FirstOrDefault() ?? "No upcoming closures";

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home", "/"),
            new("Agency Setup", "/tenant/agency/profile"),
            new("Business Hours", "/tenant/agency/hours"));

        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            var dto = await Api.GetAgencyBusinessHoursAsync(_tenantId);
            _model = BusinessHoursModel.FromDto(dto);
            _lastSyncedUtc = DateTime.UtcNow;
            _focusedDay = null;
        }
        catch (Exception ex)
        {
            _loadError = $"Business hours failed to load: {ex.Message}";
            ShowToast($"Business hours failed to load: {ex.Message}", true);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveChangesAsync()
    {
        var validationError = ValidateModel();
        if (!string.IsNullOrWhiteSpace(validationError))
        {
            ShowToast(validationError, true);
            return;
        }

        _saving = true;
        try
        {
            await Api.UpdateAgencyBusinessHoursAsync(_tenantId, _model.ToRequest());
            _lastSyncedUtc = DateTime.UtcNow;
            ShowToast("Business hours saved successfully.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetToDefaults()
    {
        _model = BusinessHoursModel.CreateDefault();
        _focusedDay = null;
        _activeTab = "overview";
        ShowToast("Default business hours restored. Save hours to publish changes.");
    }

    private void AddHoliday()
    {
        _model.HolidayClosures.Add(new HolidayClosureModel { Date = DateOnly.FromDateTime(DateTime.Today.AddDays(1)), Name = "New closure" });
        _activeTab = "holidays";
    }

    private void RequestRemoveHoliday(HolidayClosureModel holiday) => _holidayToRemove = holiday;
    private void CancelRemoveHoliday() => _holidayToRemove = null;

    private void ConfirmRemoveHoliday()
    {
        if (_holidayToRemove is not null)
        {
            _model.HolidayClosures.Remove(_holidayToRemove);
            ShowToast("Holiday closure removed. Save hours to publish changes.");
        }
        _holidayToRemove = null;
    }

    private async Task CopySummaryAsync()
    {
        var summary = $"Business Hours: {TimezoneLabel}; {_openDays} open days; {TotalWeeklyHours:0.#} weekly hours; {_model.HolidayClosures.Count} holiday closures; status {(_model.EmergencyClosing ? "Emergency Closed" : "Normal")}.";
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", summary);
        ShowToast("Business hours summary copied.");
    }

    private void RunPriorityAction(PriorityAction action) => SetTab(action.TabKey);
    private void FocusScheduleDay(BusinessDayModel day) { _focusedDay = day; _activeTab = "schedule"; }
    private void SetTab(string tab) => _activeTab = tab;
    private bool IsActiveTab(string tab) => string.Equals(_activeTab, tab, StringComparison.OrdinalIgnoreCase);
    private bool ShowTab(string tab) => IsActiveTab("overview") || IsActiveTab(tab);
    private void ClearToast() => _toastMessage = null;

    private void ShowToast(string message, bool danger = false)
    {
        _toastMessage = message;
        _toastClass = danger ? "bh-toast--danger" : string.Empty;
    }

    private string? ValidateModel()
    {
        if (_openDays == 0)
        {
            return "At least one operating day must be open.";
        }

        foreach (var day in _model.WeeklySchedule.Where(d => d.IsOpen))
        {
            if (day.CloseTime <= day.OpenTime)
            {
                return $"{day.DayName} close time must be after open time.";
            }

            if (day.HasLunchBreak && (day.LunchEnd <= day.LunchStart || day.LunchStart < day.OpenTime || day.LunchEnd > day.CloseTime))
            {
                return $"{day.DayName} lunch break must be inside operating hours.";
            }
        }

        if (_model.EmergencyClosing && string.IsNullOrWhiteSpace(_model.EmergencyMessage))
        {
            return "Emergency closure requires a client-facing message.";
        }

        if (_model.HolidayClosures.Any(h => h.Date == default || string.IsNullOrWhiteSpace(h.Name)))
        {
            return "Holiday closures require a date and name.";
        }

        return null;
    }

