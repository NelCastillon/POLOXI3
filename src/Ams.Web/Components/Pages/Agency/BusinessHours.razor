@page "/tenant/agency/hours"
@namespace Ams.Web.Components.Pages.AgencyAdmin
@inject BreadcrumbService Breadcrumbs

<PageTitle>Business Hours — Agency Setup</PageTitle>

<AppPageHeader Title="Business Hours"
               Subtitle="Configure your agency's operating hours shown to clients and used by workflow routing"
               Icon="bi-clock">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ResetToDefaults" title="Reset to defaults">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset Defaults
        </button>
        <button class="um-btn um-btn-primary" @onclick="SaveChanges" disabled="@_saving">
            @if (_saving)
            {
                <span class="um-spinner um-spinner-sm" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-floppy" aria-hidden="true"></i>
            }
            Save Hours
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="bh-kpi-strip">
    <div class="bh-kpi-card">
        <span class="bh-kpi-icon bh-kpi-icon--open"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
        <div>
            <div class="bh-kpi-value">@_openDays</div>
            <div class="bh-kpi-label">Open Days / Week</div>
        </div>
    </div>
    <div class="bh-kpi-card">
        <span class="bh-kpi-icon bh-kpi-icon--tz"><i class="bi bi-globe" aria-hidden="true"></i></span>
        <div>
            <div class="bh-kpi-value">@_selectedTimezone</div>
            <div class="bh-kpi-label">Time Zone</div>
        </div>
    </div>
    <div class="bh-kpi-card">
        <span class="bh-kpi-icon bh-kpi-icon--holiday"><i class="bi bi-calendar-x" aria-hidden="true"></i></span>
        <div>
            <div class="bh-kpi-value">@_holidays.Count</div>
            <div class="bh-kpi-label">Holiday Closures</div>
        </div>
    </div>
    <div class="bh-kpi-card">
        <span class="bh-kpi-icon bh-kpi-icon--status"><i class="bi bi-toggle-on" aria-hidden="true"></i></span>
        <div>
            <div class="bh-kpi-value">@(_emergencyClosing ? "Closed" : "Normal")</div>
            <div class="bh-kpi-label">Current Status</div>
        </div>
    </div>
</div>

<!-- Main card -->
<div class="um-grid-card bh-main-card">
    @if (_saved)
    {
        <div class="bh-save-banner" role="alert">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            Business hours saved successfully.
        </div>
    }

    <!-- Timezone selector -->
    <div class="bh-section bh-section-top">
        <div class="bh-section-head">
            <h3 class="bh-section-title"><i class="bi bi-globe" aria-hidden="true"></i> Time Zone</h3>
        </div>
        <div class="bh-tz-row">
            <label class="bh-field-label" for="tz-select">Agency Time Zone</label>
            <SfDropDownList TValue="string" TItem="TzOption"
                            DataSource="_timezones"
                            @bind-Value="_selectedTimezone"
                            Width="320px"
                            ID="tz-select">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>
        </div>
    </div>

    <!-- Weekly schedule grid -->
    <div class="bh-section">
        <div class="bh-section-head">
            <h3 class="bh-section-title"><i class="bi bi-calendar-week" aria-hidden="true"></i> Weekly Schedule</h3>
            <span class="bh-section-hint">Toggle each day on or off and set open/close times</span>
        </div>
        <div class="bh-schedule-grid">
            @foreach (var day in _schedule)
            {
                <div class="bh-day-row @(day.IsOpen ? "bh-day-open" : "bh-day-closed")">
                    <label class="bh-day-toggle">
                        <input type="checkbox" @bind="day.IsOpen" class="bh-toggle-input" />
                        <span class="bh-toggle-track" aria-hidden="true"><span class="bh-toggle-knob"></span></span>
                        <span class="bh-day-name">@day.DayName</span>
                    </label>
                    @if (day.IsOpen)
                    {
                        <div class="bh-time-inputs">
                            <div class="bh-time-group">
                                <label class="bh-time-label">Opens</label>
                                <input type="time" class="um-input bh-time-input" @bind="day.OpenTime" />
                            </div>
                            <span class="bh-time-sep">—</span>
                            <div class="bh-time-group">
                                <label class="bh-time-label">Closes</label>
                                <input type="time" class="um-input bh-time-input" @bind="day.CloseTime" />
                            </div>
                            <label class="bh-lunch-label">
                                <input type="checkbox" @bind="day.HasLunchBreak" />
                                Lunch break
                            </label>
                            @if (day.HasLunchBreak)
                            {
                                <div class="bh-time-group">
                                    <label class="bh-time-label">From</label>
                                    <input type="time" class="um-input bh-time-input" @bind="day.LunchStart" />
                                </div>
                                <span class="bh-time-sep">—</span>
                                <div class="bh-time-group">
                                    <label class="bh-time-label">To</label>
                                    <input type="time" class="um-input bh-time-input" @bind="day.LunchEnd" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="bh-closed-badge">Closed</span>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Emergency closing -->
    <div class="bh-section">
        <div class="bh-section-head">
            <h3 class="bh-section-title"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Emergency Closing</h3>
        </div>
        <div class="bh-emergency-row">
            <label class="bh-emergency-toggle">
                <input type="checkbox" @bind="_emergencyClosing" />
                <span class="bh-emergency-label">
                    <strong>Enable emergency closure</strong>
                    <span>Overrides all hours and shows your agency as closed to clients</span>
                </span>
            </label>
            @if (_emergencyClosing)
            {
                <div class="bh-emergency-message-wrap">
                    <label class="bh-field-label">Closure Message</label>
                    <textarea class="um-input bh-textarea" @bind="_emergencyMessage" rows="2"
                              placeholder="e.g. Our office is temporarily closed due to severe weather."></textarea>
                </div>
            }
        </div>
    </div>

    <!-- Holiday closures -->
    <div class="bh-section">
        <div class="bh-section-head">
            <h3 class="bh-section-title"><i class="bi bi-calendar-x" aria-hidden="true"></i> Holiday Closures</h3>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="AddHoliday">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Holiday
            </button>
        </div>
        @if (_holidays.Count == 0)
        {
            <p class="bh-no-holidays">No holiday closures configured.</p>
        }
        else
        {
            <div class="bh-holiday-list">
                @foreach (var h in _holidays)
                {
                    <div class="bh-holiday-row">
                        <input type="date" class="um-input bh-holiday-date" @bind="h.Date" />
                        <input type="text" class="um-input bh-holiday-name" @bind="h.Name" placeholder="Holiday name…" />
                        <button class="bh-holiday-remove" @onclick="() => _holidays.Remove(h)" aria-label="Remove holiday">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool _saving = false;
    private bool _saved  = false;
    private string _selectedTimezone = "Eastern Standard Time";
    private bool _emergencyClosing   = false;
    private string _emergencyMessage = string.Empty;

    private int _openDays => _schedule.Count(d => d.IsOpen);

    private sealed class DaySchedule
    {
        public string DayName      { get; set; } = string.Empty;
        public bool   IsOpen       { get; set; }
        public TimeOnly OpenTime   { get; set; } = new(8, 0);
        public TimeOnly CloseTime  { get; set; } = new(17, 0);
        public bool   HasLunchBreak { get; set; }
        public TimeOnly LunchStart { get; set; } = new(12, 0);
        public TimeOnly LunchEnd   { get; set; } = new(13, 0);
    }

    private sealed class HolidayClosure
    {
        public DateOnly Date { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public string   Name { get; set; } = string.Empty;
    }

    private readonly List<DaySchedule> _schedule =
    [
        new() { DayName = "Monday",    IsOpen = true  },
        new() { DayName = "Tuesday",   IsOpen = true  },
        new() { DayName = "Wednesday", IsOpen = true  },
        new() { DayName = "Thursday",  IsOpen = true  },
        new() { DayName = "Friday",    IsOpen = true  },
        new() { DayName = "Saturday",  IsOpen = false },
        new() { DayName = "Sunday",    IsOpen = false },
    ];

    private readonly List<HolidayClosure> _holidays = [];

    private sealed record TzOption(string Value, string Label);

    private static readonly List<TzOption> _timezones =
    [
        new("Eastern Standard Time",  "Eastern (ET) — UTC-5/4"),
        new("Central Standard Time",  "Central (CT) — UTC-6/5"),
        new("Mountain Standard Time", "Mountain (MT) — UTC-7/6"),
        new("Pacific Standard Time",  "Pacific (PT) — UTC-8/7"),
        new("Alaskan Standard Time",  "Alaska (AKT) — UTC-9/8"),
        new("Hawaiian Standard Time", "Hawaii (HT) — UTC-10"),
        new("UTC",                    "UTC — Coordinated Universal Time"),
        new("GMT Standard Time",      "London (GMT/BST)"),
        new("Central European Standard Time", "Central European (CET/CEST)"),
    ];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",           "/"),
            new("Agency Setup",   "/tenant/agency/profile"),
            new("Business Hours", "/tenant/agency/hours"));
    }

    private void AddHoliday() => _holidays.Add(new HolidayClosure());

    private void ResetToDefaults()
    {
        foreach (var d in _schedule)
        {
            d.IsOpen        = d.DayName is "Monday" or "Tuesday" or "Wednesday" or "Thursday" or "Friday";
            d.OpenTime      = new TimeOnly(8, 0);
            d.CloseTime     = new TimeOnly(17, 0);
            d.HasLunchBreak = false;
        }
        _emergencyClosing  = false;
        _emergencyMessage  = string.Empty;
        _selectedTimezone  = "Eastern Standard Time";
        _saved             = false;
    }

    private async Task SaveChanges()
    {
        _saving = true;
        _saved  = false;
        StateHasChanged();
        await Task.Delay(600); // simulate async save
        _saving = false;
        _saved  = true;
        StateHasChanged();
        await Task.Delay(3500);
        _saved = false;
        StateHasChanged();
    }
}
