@page "/admin/agency/profile"
@page "/tenant/agency/profile"
@namespace Ams.Web.Components.Pages.AgencyAdmin
@using Ams.Application.Features.Agency
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Agency Profile - Agency Setup</PageTitle>

<AppPageHeader Title="Agency Profile"
               Subtitle="Enterprise agency identity, compliance, contact, operating footprint, and workflow readiness."
               Icon="bi-building-check">
    <Actions>
        <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <a class="um-btn um-btn-ghost" href="/tenant/agency/branding"><i class="bi bi-palette" aria-hidden="true"></i> Branding</a>
        <a class="um-btn um-btn-ghost" href="/tenant/agency/hours"><i class="bi bi-clock" aria-hidden="true"></i> Hours</a>
        <button class="um-btn um-btn-primary" type="button" @onclick="OpenEditModal"><i class="bi bi-pencil-square" aria-hidden="true"></i> Edit Profile</button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="ap-toast @_toastClass" role="status">
        <i class="bi @(_toastClass == "ap-toast--danger" ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="ap-toast-close" @onclick="ClearToast" aria-label="Dismiss message"><i class="bi bi-x-lg"></i></button>
    </div>
}

<div class="ap-page">
    <section class="ap-hero">
        <div class="ap-hero-main">
            <span class="ap-eyebrow"><i class="bi bi-command" aria-hidden="true"></i> Tenant - Agency Setup</span>
            <h2>@DisplayAgencyName</h2>
            <p>Maintain the agency record used by client servicing, staff workflows, carrier relationships, compliance evidence, and portal-facing experiences.</p>
            <div class="ap-hero-meta">
                <span><i class="bi bi-upc-scan" aria-hidden="true"></i> @DisplayValue(_profile?.AgencyCode)</span>
                <span><i class="bi bi-geo-alt" aria-hidden="true"></i> @LocationSummary</span>
                <span><i class="bi bi-shield-check" aria-hidden="true"></i> @ComplianceSummary</span>
            </div>
        </div>
        <div class="ap-hero-panel">
            <div class="ap-readiness-card">
                <span>Profile readiness</span>
                <strong>@ProfileReadinessScore%</strong>
                <div class="ap-score-track"><div style="width:@ProfileReadinessScore%"></div></div>
                <small>@ProfileReadinessSummary</small>
            </div>
            <div class="ap-action-list">
                @foreach (var action in PriorityActions)
                {
                    <button type="button" class="ap-action-item" @onclick="() => SetTab(action.Tab)">
                        <i class="bi @action.Icon" aria-hidden="true"></i>
                        <span><strong>@action.Title</strong><small>@action.Detail</small></span>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="ap-kpi-strip" aria-label="Agency profile KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="ap-kpi-card @(IsActiveTab(kpi.Key) ? "ap-kpi-card--active" : null)" title="@kpi.Tooltip" @onclick="() => SetTab(kpi.Key)">
                <span class="ap-kpi-icon ap-kpi-icon--@kpi.Tone"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="ap-kpi-label">@kpi.Label</span>
                <strong>@kpi.Value</strong>
                <small>@kpi.Detail</small>
            </button>
        }
    </section>

    <section class="ap-command-bar">
        <div class="ap-tabs" role="tablist" aria-label="Agency profile sections">
            @foreach (var tab in Tabs)
            {
                <button type="button" role="tab" class="ap-tab @(IsActiveTab(tab.Key) ? "ap-tab--active" : null)" @onclick="() => SetTab(tab.Key)">
                    <i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label
                </button>
            }
        </div>
        <div class="ap-command-actions">
            <button class="um-btn um-btn-ghost" type="button" @onclick="CopyProfileSummaryAsync" disabled="@(_profile is null)"><i class="bi bi-clipboard" aria-hidden="true"></i> Copy Summary</button>
            <button class="um-btn um-btn-primary" type="button" @onclick="OpenEditModal"><i class="bi bi-pencil-square" aria-hidden="true"></i> Update</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger ap-load-error" role="alert"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError</div>
    }

    <section class="ap-content-grid">
        <div class="ap-main-panel">
            @if (_loading)
            {
                <div class="ap-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading agency profile...</div>
            }
            else if (_profile is null)
            {
                <div class="ap-empty-state">
                    <i class="bi bi-building" aria-hidden="true"></i>
                    <strong>No agency profile found</strong>
                    <span>Create the agency identity record used by tenant operations.</span>
                    <button class="um-btn um-btn-primary" type="button" @onclick="OpenEditModal"><i class="bi bi-plus-lg" aria-hidden="true"></i> Create Profile</button>
                </div>
            }
            else
            {
                @if (ShowTab("overview"))
                {
                    <section class="ap-section">
                        <div class="ap-section-header"><i class="bi bi-speedometer2" aria-hidden="true"></i><div><strong>Executive Overview</strong><span>Most important profile information for tenant operations.</span></div></div>
                        <div class="ap-overview-grid">
                            <div class="ap-identity-card">
                                <span class="ap-module-icon ap-module-icon--blue"><i class="bi bi-building-check" aria-hidden="true"></i></span>
                                <div><strong>@DisplayAgencyName</strong><span>@DisplayValue(_profile.DbaName, "No DBA configured")</span></div>
                            </div>
                            <div class="ap-identity-card">
                                <span class="ap-module-icon ap-module-icon--green"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                                <div><strong>@ComplianceSummary</strong><span>@EoDetail</span></div>
                            </div>
                            <div class="ap-identity-card">
                                <span class="ap-module-icon ap-module-icon--purple"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                                <div><strong>@_branchCount branch(es)</strong><span>@_staffCount staff - @_carrierCount carriers</span></div>
                            </div>
                        </div>
                    </section>
                }

                @if (ShowTab("legal"))
                {
                    <section class="ap-section">
                        <div class="ap-section-header"><i class="bi bi-bank" aria-hidden="true"></i><div><strong>Legal & Licensing</strong><span>Agency identity, tax, entity, and licensing data.</span></div></div>
                        <div class="ap-fields">
                            @Field("Legal Name", _profile.AgencyName)
                            @Field("DBA / Trade Name", _profile.DbaName)
                            @Field("Agency Code", _profile.AgencyCode, true)
                            @Field("NPN", _profile.Npn, true)
                            @Field("FEIN / Tax ID", _profile.Fein, true)
                            @Field("License Number", _profile.LicenseNumber, true)
                            @Field("Entity Type", _profile.EntityType)
                            @Field("Domicile State", _profile.DomicileState)
                        </div>
                    </section>
                }

                @if (ShowTab("contact"))
                {
                    <section class="ap-section">
                        <div class="ap-section-header"><i class="bi bi-geo-alt" aria-hidden="true"></i><div><strong>Contact & Location</strong><span>Client-facing contact and agency headquarters data.</span></div></div>
                        <div class="ap-fields">
                            @Field("Address Line 1", _profile.AddressLine1)
                            @Field("Address Line 2", _profile.AddressLine2)
                            @Field("City", _profile.City)
                            @Field("State", _profile.StateProvince)
                            @Field("Postal Code", _profile.PostalCode, true)
                            @Field("Country", _profile.CountryCode)
                            @Field("Phone", _profile.Phone, true)
                            @Field("Email", _profile.Email)
                            @Field("Website", _profile.Website)
                        </div>
                    </section>
                }

                @if (ShowTab("compliance"))
                {
                    <section class="ap-section">
                        <div class="ap-section-header"><i class="bi bi-file-earmark-check" aria-hidden="true"></i><div><strong>E&O Coverage</strong><span>Errors and omissions coverage readiness.</span></div></div>
                        <div class="ap-fields">
                            @Field("Carrier", _profile.EoCarrier)
                            @Field("Policy Number", _profile.EoPolicyNumber, true)
                            @Field("Coverage Limit", _profile.EoCoverageLimit.HasValue ? _profile.EoCoverageLimit.Value.ToString("C0") : null)
                            @Field("Expiry Date", _profile.EoExpiryDate.HasValue ? _profile.EoExpiryDate.Value.ToString("MMM d, yyyy") : null)
                            @Field("Coverage Status", ComplianceSummary)
                            @Field("Renewal Window", EoRenewalWindow)
                        </div>
                    </section>
                }

                @if (ShowTab("operations"))
                {
                    <section class="ap-section">
                        <div class="ap-section-header"><i class="bi bi-gear-wide-connected" aria-hidden="true"></i><div><strong>Operating Standards</strong><span>Regionalization, locale, currency, and workflow support.</span></div></div>
                        <div class="ap-fields">
                            @Field("Locale", _profile.Locale)
                            @Field("Currency", _profile.CurrencyCode)
                            @Field("Time Zone", _profile.TimeZoneId)
                            @Field("Branches", _branchCount.ToString("N0"))
                            @Field("Staff", _staffCount.ToString("N0"))
                            @Field("Appointed Carriers", _carrierCount.ToString("N0"))
                        </div>
                    </section>
                }
            }
        </div>

        <aside class="ap-side-panel">
            <div class="ap-side-card">
                <div class="ap-side-title"><i class="bi bi-list-check" aria-hidden="true"></i><strong>Readiness Checklist</strong></div>
                @foreach (var item in Checklist)
                {
                    <div class="ap-check-item @(item.Done ? "ap-check-item--done" : null)">
                        <i class="bi @(item.Done ? "bi-check-circle-fill" : "bi-exclamation-circle")" aria-hidden="true"></i>
                        <span><strong>@item.Label</strong><small>@item.Detail</small></span>
                    </div>
                }
            </div>
            <div class="ap-side-card">
                <div class="ap-side-title"><i class="bi bi-lightning-charge" aria-hidden="true"></i><strong>Workflow Shortcuts</strong></div>
                <a class="ap-link-action" href="/tenant/agency/branches"><i class="bi bi-diagram-3" aria-hidden="true"></i> Manage Branches</a>
                <a class="ap-link-action" href="/tenant/agency/producers"><i class="bi bi-person-badge" aria-hidden="true"></i> Manage Producers</a>
                <a class="ap-link-action" href="/tenant/agency/carriers"><i class="bi bi-shield-check" aria-hidden="true"></i> Manage Carriers</a>
                <a class="ap-link-action" href="/tenant/agency/branding"><i class="bi bi-palette" aria-hidden="true"></i> Branding Settings</a>
            </div>
        </aside>
    </section>
</div>

@if (_showEditModal)
{
    <div class="ap-modal-backdrop" role="presentation" @onclick="CloseEditModal">
        <div class="ap-modal" role="dialog" aria-modal="true" aria-labelledby="agency-profile-edit-title" @onclick:stopPropagation="true">
            <EditForm EditContext="@_editContext" OnValidSubmit="SaveProfileAsync" OnInvalidSubmit="NotifyInvalidProfileAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header">
                    <span class="ap-modal-icon"><i class="bi bi-building-check" aria-hidden="true"></i></span>
                    <div class="ap-modal-title">
                        <span id="agency-profile-edit-title">Edit Agency Profile</span>
                        <small>Polish the tenant identity, contact, compliance, and operating defaults used across AMS.</small>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseEditModal" disabled="@_saving" aria-label="Close edit agency profile"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="um-modal-body">
                    <div class="ap-form-intro">
                        <div>
                            <span><i class="bi bi-database-check" aria-hidden="true"></i> Tenant source of truth</span>
                            <strong>@DisplayAgencyName</strong>
                            
                        </div>
                        <div class="ap-form-score">
                            <span>Readiness</span>
                            <strong>@ProfileReadinessScore%</strong>
                        </div>
                    </div>
                    <div class="ap-form-grid">
                        <div class="ap-form-section ap-form-section--full"><i class="bi bi-bank" aria-hidden="true"></i><span><strong>Legal identity</strong><small>Core identity data used across tenant workflows.</small></span></div>
                        <div class="um-field ap-form-section--full">
                            <label>Agency Name <span class="text-danger">*</span></label>
                            <InputText class="um-input" @bind-Value="_form.AgencyName" />
                        </div>
                        <div class="um-field">
                            <label>DBA / Trade Name</label>
                            <InputText class="um-input" @bind-Value="_form.DbaName" />
                        </div>
                        <div class="um-field">
                            <label>NPN</label>
                            <InputText class="um-input ap-mono" @bind-Value="_form.Npn" />
                        </div>
                        <div class="um-field">
                            <label>FEIN / Tax ID</label>
                            <InputText class="um-input ap-mono" @bind-Value="_form.Fein" />
                        </div>
                        <div class="um-field">
                            <label>Entity Type</label>
                            <InputSelect class="um-input" @bind-Value="_form.EntityType">
                                @foreach (var option in EntityTypeOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>License Number</label>
                            <InputText class="um-input ap-mono" @bind-Value="_form.LicenseNumber" />
                        </div>
                        <div class="um-field">
                            <label>Domicile State</label>
                            <InputText class="um-input" @bind-Value="_form.DomicileState" />
                        </div>

                        <div class="ap-form-section ap-form-section--full"><i class="bi bi-geo-alt" aria-hidden="true"></i><span><strong>Contact & address</strong><small>Primary contact and headquarters information.</small></span></div>
                        <div class="um-field ap-form-section--full">
                            <label>Address Line 1</label>
                            <InputText class="um-input" @bind-Value="_form.AddressLine1" />
                        </div>
                        <div class="um-field ap-form-section--full">
                            <label>Address Line 2</label>
                            <InputText class="um-input" @bind-Value="_form.AddressLine2" />
                        </div>
                        <div class="um-field">
                            <label>City</label>
                            <InputText class="um-input" @bind-Value="_form.City" />
                        </div>
                        <div class="um-field">
                            <label>State</label>
                            <InputText class="um-input" @bind-Value="_form.StateProvince" />
                        </div>
                        <div class="um-field">
                            <label>Postal Code</label>
                            <InputText class="um-input ap-mono" @bind-Value="_form.PostalCode" />
                        </div>
                        <div class="um-field">
                            <label>Country</label>
                            <InputText class="um-input" @bind-Value="_form.CountryCode" />
                        </div>
                        <div class="um-field">
                            <label>Phone</label>
                            <InputText class="um-input ap-mono" @bind-Value="_form.Phone" />
                        </div>
                        <div class="um-field">
                            <label>Email</label>
                            <InputText class="um-input" @bind-Value="_form.Email" />
                        </div>
                        <div class="um-field ap-form-section--full">
                            <label>Website</label>
                            <InputText class="um-input" @bind-Value="_form.Website" />
                        </div>

                        <div class="ap-form-section ap-form-section--full"><i class="bi bi-shield-check" aria-hidden="true"></i><span><strong>E&O coverage and operating standards</strong><small>Compliance and default tenant localization settings.</small></span></div>
                        <div class="um-field">
                            <label>E&O Carrier</label>
                            <InputText class="um-input" @bind-Value="_form.EoCarrier" />
                        </div>
                        <div class="um-field">
                            <label>Policy Number</label>
                            <InputText class="um-input ap-mono" @bind-Value="_form.EoPolicyNumber" />
                        </div>
                        <div class="um-field">
                            <label>Coverage Limit</label>
                            <InputNumber class="um-input ap-mono" @bind-Value="_form.EoCoverageLimit" />
                        </div>
                        <div class="um-field">
                            <label>Expiry Date</label>
                            <InputDate class="um-input" @bind-Value="_form.EoExpiryDate" />
                        </div>
                        <div class="um-field">
                            <label>Locale <span class="text-danger">*</span></label>
                            <InputText class="um-input" @bind-Value="_form.Locale" />
                        </div>
                        <div class="um-field">
                            <label>Currency <span class="text-danger">*</span></label>
                            <InputText class="um-input" @bind-Value="_form.CurrencyCode" />
                        </div>
                        <div class="um-field ap-form-section--full">
                            <label>Time Zone <span class="text-danger">*</span></label>
                            <InputText class="um-input" @bind-Value="_form.TimeZoneId" />
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_formError))
                        {
                            <div class="alert alert-danger ap-load-error ap-form-section--full" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_formError</div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseEditModal" disabled="@_saving">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-save" aria-hidden="true"></i>
                        }
                        Save Profile
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<style>
@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }
</style>

@code {
    private static readonly string[] EntityTypeOptions = ["", "Corporation", "LLC", "Partnership", "Sole Proprietor", "Nonprofit", "Other"];
    private static readonly TabItem[] Tabs =
    [
        new("overview", "Overview", "bi-speedometer2"),
        new("legal", "Legal", "bi-bank"),
        new("contact", "Contact", "bi-geo-alt"),
        new("compliance", "Compliance", "bi-shield-check"),
        new("operations", "Operations", "bi-gear-wide-connected")
    ];

    private Guid _tenantId;
    private Guid? _currentUserId;
    private bool _loading;
    private bool _saving;
    private bool _showEditModal;
    private int _branchCount;
    private int _staffCount;
    private int _carrierCount;
    private string _activeTab = "overview";
    private string? _loadError;
    private string? _formError;
    private string? _toastMessage;
    private string _toastClass = "ap-toast--success";
    private Ams.Application.Common.Dtos.AgencyProfileDto? _profile;
    private AgencyProfileForm _form = new();
    private EditContext _editContext = default!;

    private string DisplayAgencyName => DisplayValue(_profile?.AgencyName, "Agency Profile");
    private string LocationSummary
    {
        get
        {
            var location = string.Join(", ", new[] { _profile?.City, _profile?.StateProvince }.Where(s => !string.IsNullOrWhiteSpace(s)));
            return string.IsNullOrWhiteSpace(location) ? "Location incomplete" : location;
        }
    }
    private bool EoIsExpired => _profile?.EoExpiryDate is DateTime expiry && expiry.Date < DateTime.Today;
    private bool EoExpiresSoon => _profile?.EoExpiryDate is DateTime expiry && expiry.Date >= DateTime.Today && expiry.Date <= DateTime.Today.AddDays(45);
    private string ComplianceSummary => EoIsExpired ? "E&O expired" : EoExpiresSoon ? "E&O renewal due" : _profile?.EoExpiryDate is null ? "E&O missing" : "E&O active";
    private string EoDetail => _profile?.EoExpiryDate is DateTime expiry ? $"Expires {expiry:MMM d, yyyy}" : "No expiration date configured";
    private string EoRenewalWindow => _profile?.EoExpiryDate is DateTime expiry ? (expiry.Date - DateTime.Today).TotalDays switch { < 0 => "Expired", <= 45 => "Renewal due now", <= 90 => "Renewal upcoming", _ => "Outside renewal window" } : "Unknown";
    private int ProfileReadinessScore => _profile is null ? 0 : Math.Clamp(Checklist.Count(c => c.Done) * 100 / Math.Max(1, Checklist.Count), 0, 100);
    private string ProfileReadinessSummary => ProfileReadinessScore >= 90 ? "Agency profile is enterprise ready" : ProfileReadinessScore >= 70 ? "Core profile is ready with some gaps" : "Complete missing identity and compliance details";

    private IReadOnlyList<ChecklistItem> Checklist =>
    [
        new("Legal identity", !string.IsNullOrWhiteSpace(_profile?.AgencyName) && !string.IsNullOrWhiteSpace(_profile?.EntityType), "Agency name and entity type"),
        new("Tax and licensing", !string.IsNullOrWhiteSpace(_profile?.Fein) || !string.IsNullOrWhiteSpace(_profile?.LicenseNumber), "FEIN or license number"),
        new("Primary contact", !string.IsNullOrWhiteSpace(_profile?.Phone) || !string.IsNullOrWhiteSpace(_profile?.Email), "Phone or email configured"),
        new("Headquarters", !string.IsNullOrWhiteSpace(_profile?.AddressLine1) && !string.IsNullOrWhiteSpace(_profile?.City), "Address and city configured"),
        new("E&O coverage", _profile?.EoExpiryDate is not null && !EoIsExpired, "Active E&O expiration date"),
        new("Operating footprint", _branchCount > 0 && _staffCount > 0, "Branches and staff loaded")
    ];

    private IEnumerable<KpiItem> Kpis =>
    [
        new("overview", "Readiness", "bi-speedometer2", $"{ProfileReadinessScore}%", "profile score", "Show the enterprise readiness overview", ProfileReadinessScore >= 80 ? "green" : "amber"),
        new("legal", "Branches", "bi-diagram-3", _branchCount.ToString("N0"), "operating footprint", "Show legal profile details", "blue"),
        new("contact", "Staff", "bi-people", _staffCount.ToString("N0"), "active users", "Show contact and headquarters details", "purple"),
        new("compliance", "E&O", "bi-shield-check", _profile?.EoExpiryDate?.ToString("MMM d") ?? "Missing", ComplianceSummary, "Show E&O compliance details", EoIsExpired || EoExpiresSoon ? "red" : "green"),
        new("operations", "Carriers", "bi-building-gear", _carrierCount.ToString("N0"), "appointed markets", "Show operating standards", "slate")
    ];

    private IEnumerable<PriorityAction> PriorityActions => Checklist.Where(c => !c.Done).Take(3).Select(c => new PriorityAction(c.Label, c.Detail, ActionIcon(c.Label), ActionTab(c.Label))).DefaultIfEmpty(new("Review profile", "All critical profile checks are complete", "bi-check2-circle", "overview"));

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _currentUserId = context.UserId;
        _editContext = new(_form);
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Agency Setup", "/tenant/agency/profile"), new("Agency Profile", "/tenant/agency/profile"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var profileTask = Api.GetAgencyProfileAsync(_tenantId);
            var branchesTask = Api.SearchBranchesAsync(_tenantId, null, pageSize: 1);
            var carriersTask = Api.SearchCarriersAsync(_tenantId, null, pageSize: 1);
            var staffTask = Api.GetStaffAsync(_tenantId);
            await Task.WhenAll(profileTask, branchesTask, carriersTask, staffTask);

            _profile = await profileTask;
            _branchCount = (await branchesTask)?.TotalCount ?? 0;
            _carrierCount = (await carriersTask)?.TotalCount ?? 0;
            _staffCount = (await staffTask)?.Count ?? 0;
        }
        catch (Exception ex)
        {
            _loadError = $"Load failed: {ex.Message}";
            ShowToast(_loadError, true);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenEditModal()
    {
        _form = AgencyProfileForm.FromDto(_profile);
        _editContext = new(_form);
        _formError = null;
        _showEditModal = true;
    }

    private void CloseEditModal()
    {
        if (_saving) return;
        _showEditModal = false;
        _formError = null;
    }

    private Task NotifyInvalidProfileAsync()
    {
        _formError = "Review the highlighted fields before saving.";
        ShowToast(_formError, true);
        return Task.CompletedTask;
    }

    private async Task SaveProfileAsync()
    {
        _saving = true;
        _formError = null;
        try
        {
            await Api.UpdateAgencyProfileAsync(_tenantId, new Ams.Application.Features.Agency.UpdateAgencyProfileRequest(
                _form.AgencyName,
                _form.DbaName,
                _form.Npn,
                _form.Fein,
                _form.EntityType,
                _form.LicenseNumber,
                _form.DomicileState,
                _form.Phone,
                _form.Email,
                _form.Website,
                _form.AddressLine1,
                _form.AddressLine2,
                _form.City,
                _form.StateProvince,
                _form.PostalCode,
                _form.CountryCode,
                _form.EoCarrier,
                _form.EoPolicyNumber,
                _form.EoCoverageLimit,
                _form.EoExpiryDate,
                _form.Locale,
                _form.CurrencyCode,
                _form.TimeZoneId));
            _showEditModal = false;
            ShowToast("Agency profile saved.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
            ShowToast($"Save failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private Task CopyProfileSummaryAsync()
    {
        if (_profile is null) return Task.CompletedTask;
        var summary = $"{_profile.AgencyName} | {_profile.City}, {_profile.StateProvince} | {ComplianceSummary} | Branches: {_branchCount} | Staff: {_staffCount} | Carriers: {_carrierCount}";
        ShowToast($"Profile summary ready: {summary}");
        return Task.CompletedTask;
    }

    private void SetTab(string key) => _activeTab = key;
    private bool IsActiveTab(string key) => _activeTab == key;
    private bool ShowTab(string key) => _activeTab == key;
    private void ShowToast(string message, bool danger = false) { _toastMessage = message; _toastClass = danger ? "ap-toast--danger" : "ap-toast--success"; }
    private void ClearToast() => _toastMessage = null;

    private static string DisplayValue(string? value, string fallback = "-") => string.IsNullOrWhiteSpace(value?.Trim()) || value.Trim().All(c => c == '?' || c == '�') ? fallback : value.Trim();
    private static string ActionIcon(string label) => label.Contains("E&O", StringComparison.OrdinalIgnoreCase) ? "bi-shield-exclamation" : label.Contains("contact", StringComparison.OrdinalIgnoreCase) ? "bi-telephone" : label.Contains("Headquarters", StringComparison.OrdinalIgnoreCase) ? "bi-geo-alt" : "bi-pencil-square";
    private static string ActionTab(string label) => label.Contains("E&O", StringComparison.OrdinalIgnoreCase) ? "compliance" : label.Contains("contact", StringComparison.OrdinalIgnoreCase) || label.Contains("Headquarters", StringComparison.OrdinalIgnoreCase) ? "contact" : label.Contains("footprint", StringComparison.OrdinalIgnoreCase) ? "operations" : "legal";

    private RenderFragment Field(string label, string? value, bool mono = false) => @<div class="ap-field">
        <span class="ap-field-label">@label</span>
        <span class="ap-field-value @(mono ? "ap-mono" : null)">@DisplayValue(value)</span>
    </div>;

    private sealed record TabItem(string Key, string Label, string Icon);
    private sealed record KpiItem(string Key, string Label, string Icon, string Value, string Detail, string Tooltip, string Tone);
    private sealed record ChecklistItem(string Label, bool Done, string Detail);
    private sealed record PriorityAction(string Title, string Detail, string Icon, string Tab);

