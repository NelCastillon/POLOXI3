@page "/admin/agency/profile"
@page "/tenant/agency/profile"
@namespace Ams.Web.Components.Pages.AgencyAdmin
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Agency Profile — Agency Setup</PageTitle>

<AppPageHeader Title="Agency Profile"
               Subtitle="Legal name, address, licensing, E&amp;O coverage and branding settings"
               Icon="bi-building">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenEditDrawer">
            <i class="bi bi-pencil" aria-hidden="true"></i> Edit Profile
        </button>
    </Actions>
</AppPageHeader>

<section class="ma-hero as-tenant-hero">
    <div>
        <span class="ma-eyebrow">Tenant · Agency Setup</span>
        <h2>Agency Profile Command Center</h2>
        <p>Maintain the agency record clients, staff, carriers, workflows, and portal experiences depend on.</p>
    </div>
    <div class="ma-hero-actions">
        <a class="um-btn um-btn-ghost" href="/tenant/agency/branding"><i class="bi bi-palette" aria-hidden="true"></i> Branding</a>
        <a class="um-btn um-btn-ghost" href="/tenant/agency/hours"><i class="bi bi-clock" aria-hidden="true"></i> Business Hours</a>
        <button class="um-btn um-btn-primary" @onclick="OpenEditDrawer"><i class="bi bi-pencil" aria-hidden="true"></i> Edit Profile</button>
    </div>
</section>

<div class="as-kpi-strip" aria-label="Agency profile filters">
    <button type="button" class='as-kpi-card @KpiClass("Overview")' @onclick='() => SetFilter("Overview")' title="Show all profile sections">
        <span class="as-kpi-icon"><i class="bi bi-diagram-3-fill" aria-hidden="true"></i></span>
        <div>
            <div class="as-kpi-value">@_branchCount</div>
            <div class="as-kpi-label">Branches</div>
        </div>
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Legal")' @onclick='() => SetFilter("Legal")' title="Show legal and licensing details">
        <span class="as-kpi-icon as-kpi-icon--success"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
        <div>
            <div class="as-kpi-value">@_staffCount</div>
            <div class="as-kpi-label">Staff</div>
        </div>
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Address")' @onclick='() => SetFilter("Address")' title="Show contact and address details">
        <span class="as-kpi-icon as-kpi-icon--violet"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
        <div>
            <div class="as-kpi-value">@_carrierCount</div>
            <div class="as-kpi-label">Appointed Carriers</div>
        </div>
    </button>
    <button type="button" class='as-kpi-card @KpiClass("Coverage")' @onclick='() => SetFilter("Coverage")' title="Show E&O coverage details">
        <span class="as-kpi-icon @EoIconClass"><i class="bi bi-file-earmark-check" aria-hidden="true"></i></span>
        <div>
            <div class="as-kpi-value">@(_profile?.EoExpiryDate.HasValue == true ? _profile.EoExpiryDate.Value.ToString("d") : "—")</div>
            <div class="as-kpi-label">E&amp;O Expiry</div>
        </div>
    </button>
</div>

<div class="as-card">
    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite" aria-label="Loading agency profile…">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading…</span>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
            @_loadError
        </div>
    }
    @if (_profile is not null)
    {
        @if (ShowSection("Legal"))
        {
            <div class="as-section">
                <h3 class="as-section-title"><i class="bi bi-building" aria-hidden="true"></i> Legal Information</h3>
                <div class="as-fields">
                    <div class="as-field"><span class="as-field-label">Legal Name</span><span class="as-field-value">@_profile.LegalName</span></div>
                    <div class="as-field"><span class="as-field-label">DBA / Trade Name</span><span class="as-field-value">@(_profile.DbaName ?? "—")</span></div>
                    <div class="as-field"><span class="as-field-label">NPN</span><span class="as-field-value as-mono">@_profile.Npn</span></div>
                    <div class="as-field"><span class="as-field-label">FEIN / Tax ID</span><span class="as-field-value as-mono">@_profile.Fein</span></div>
                    <div class="as-field"><span class="as-field-label">Entity Type</span><span class="as-field-value">@_profile.EntityType</span></div>
                    <div class="as-field"><span class="as-field-label">Domicile State</span><span class="as-field-value">@_profile.DomicileState</span></div>
                </div>
            </div>
        }
        @if (ShowSection("Address"))
        {
            <div class="as-section">
                <h3 class="as-section-title"><i class="bi bi-geo-alt" aria-hidden="true"></i> Primary Address</h3>
                <div class="as-fields">
                    <div class="as-field"><span class="as-field-label">Address Line 1</span><span class="as-field-value">@_profile.Address1</span></div>
                    <div class="as-field"><span class="as-field-label">Address Line 2</span><span class="as-field-value">@(_profile.Address2 ?? "—")</span></div>
                    <div class="as-field"><span class="as-field-label">City</span><span class="as-field-value">@_profile.City</span></div>
                    <div class="as-field"><span class="as-field-label">State</span><span class="as-field-value">@_profile.State</span></div>
                    <div class="as-field"><span class="as-field-label">ZIP</span><span class="as-field-value as-mono">@_profile.Zip</span></div>
                    <div class="as-field"><span class="as-field-label">Phone</span><span class="as-field-value as-mono">@_profile.Phone</span></div>
                    <div class="as-field"><span class="as-field-label">Website</span><span class="as-field-value">@(_profile.Website ?? "—")</span></div>
                </div>
            </div>
        }
        @if (ShowSection("Coverage"))
        {
            <div class="as-section">
                <h3 class="as-section-title"><i class="bi bi-file-earmark-check" aria-hidden="true"></i> E&amp;O Coverage</h3>
                <div class="as-fields">
                    <div class="as-field"><span class="as-field-label">Carrier</span><span class="as-field-value">@(_profile.EoCarrier ?? "—")</span></div>
                    <div class="as-field"><span class="as-field-label">Policy #</span><span class="as-field-value as-mono">@(_profile.EoPolicyNumber ?? "—")</span></div>
                    <div class="as-field"><span class="as-field-label">Coverage Limit</span><span class="as-field-value">@(_profile.EoCoverageLimit.HasValue ? _profile.EoCoverageLimit.Value.ToString("C0") : "—")</span></div>
                    <div class="as-field"><span class="as-field-label">Expiry Date</span><span class="as-field-value">@(_profile.EoExpiryDate.HasValue ? _profile.EoExpiryDate.Value.ToString("d") : "—")</span></div>
                </div>
            </div>
        }
    }
    else if (!_loading)
    {
        <div class="as-empty-state">
            <i class="bi bi-building as-empty-icon" aria-hidden="true"></i>
            <p>No agency profile data loaded. Click <strong>Edit Profile</strong> to get started.</p>
        </div>
    }
</div>

<!-- Edit Drawer -->
<AppCrudDrawer @bind-Visible="_showEditDrawer"
               Title="Edit Agency Profile"
               OnConfirm="SaveProfileAsync"
               OnClose="CloseEditDrawer">
    <Content>
        <div class="as-form">
            <label class="ap-form-label">Legal Name</label>
            <input class="um-input" @bind="_editModel.LegalName" placeholder="Agency legal name" />

            <label class="ap-form-label">DBA / Trade Name</label>
            <input class="um-input" @bind="_editModel.DbaName" placeholder="Optional trade name" />

            <label class="ap-form-label">NPN</label>
            <input class="um-input ap-mono" @bind="_editModel.Npn" placeholder="National Producer Number" />

            <label class="ap-form-label">FEIN / Tax ID</label>
            <input class="um-input ap-mono" @bind="_editModel.Fein" placeholder="Federal Employer ID" />

            <label class="ap-form-label">Entity Type</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_entityTypeOptions"
                            @bind-Value="_editModel.EntityType"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>

            <label class="ap-form-label">Domicile State</label>
            <input class="um-input" @bind="_editModel.DomicileState" placeholder="State abbreviation" />

            <label class="ap-form-label">Address Line 1</label>
            <input class="um-input" @bind="_editModel.Address1" />

            <label class="ap-form-label">Address Line 2</label>
            <input class="um-input" @bind="_editModel.Address2" />

            <div class="ap-form-row">
                <div>
                    <label class="ap-form-label">City</label>
                    <input class="um-input" @bind="_editModel.City" />
                </div>
                <div>
                    <label class="ap-form-label">State</label>
                    <input class="um-input" @bind="_editModel.State" />
                </div>
                <div>
                    <label class="ap-form-label">ZIP</label>
                    <input class="um-input ap-mono" @bind="_editModel.Zip" />
                </div>
            </div>

            <label class="ap-form-label">Phone</label>
            <input class="um-input ap-mono" @bind="_editModel.Phone" />

            <label class="ap-form-label">Website</label>
            <input class="um-input" @bind="_editModel.Website" />

            <h4 class="ap-form-section-heading">E&amp;O Coverage</h4>

            <label class="ap-form-label">E&amp;O Carrier</label>
            <input class="um-input" @bind="_editModel.EoCarrier" />

            <label class="ap-form-label">Policy Number</label>
            <input class="um-input ap-mono" @bind="_editModel.EoPolicyNumber" />

            <label class="ap-form-label">Coverage Limit</label>
            <input class="um-input ap-mono" type="number" @bind="_editModel.EoCoverageLimit" />

            <label class="ap-form-label">Expiry Date</label>
            <input class="um-input" type="date" @bind="_editModel.EoExpiryDate" />
        </div>
    </Content>
</AppCrudDrawer>

<!-- Toast -->
<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;

    private SfToast? _toast;
    private bool _loading      = false;
    private bool _showEditDrawer = false;

    private int _branchCount  = 0;
    private int _staffCount   = 0;
    private int _carrierCount = 0;
    private string _activeFilter = "Overview";
    private string? _loadError;

    private AgencyProfileDto? _profile;
    private AgencyProfileDto  _editModel = new();

    private static readonly List<LabelValue> _entityTypeOptions =
    [
        new("Corporation",    "Corporation"),
        new("LLC",            "LLC"),
        new("Partnership",    "Partnership"),
        new("SoleProprietor", "Sole Proprietor"),
    ];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(
            new("Home",          "/"),
            new("Agency Setup",  "/admin/agency/profile"),
            new("Agency Profile", "/admin/agency/profile"));

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _loadError = null;
            var dto = await Api.GetAgencyProfileAsync(_tenantId);
            if (dto is not null)
            {
                _profile = new AgencyProfileDto
                {
                    LegalName       = dto.AgencyName,
                    DbaName         = dto.DbaName,
                    Npn             = dto.Npn,
                    Fein            = dto.Fein,
                    EntityType      = dto.EntityType,
                    DomicileState   = dto.DomicileState,
                    Address1        = dto.AddressLine1,
                    Address2        = dto.AddressLine2,
                    City            = dto.City,
                    State           = dto.StateProvince,
                    Zip             = dto.PostalCode,
                    Phone           = dto.Phone,
                    Website         = dto.Website,
                    EoCarrier       = dto.EoCarrier,
                    EoPolicyNumber  = dto.EoPolicyNumber,
                    EoCoverageLimit = dto.EoCoverageLimit,
                    EoExpiryDate    = dto.EoExpiryDate,
                };
            }
            else
            {
                _profile = null;
            }

            var branches = await Api.SearchBranchesAsync(_tenantId, null, pageSize: 1);
            _branchCount = branches?.TotalCount ?? 0;

            var carriers = await Api.SearchCarriersAsync(_tenantId, null, pageSize: 1);
            _carrierCount = carriers?.TotalCount ?? 0;

            var staff = await Api.GetStaffAsync(_tenantId);
            _staffCount = staff?.Count ?? 0;
        }
        catch (Exception ex)
        {
            _loadError = $"Load failed: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenEditDrawer()
    {
        _editModel = _profile is not null
            ? new AgencyProfileDto
            {
                LegalName       = _profile.LegalName,
                DbaName         = _profile.DbaName,
                Npn             = _profile.Npn,
                Fein            = _profile.Fein,
                EntityType      = _profile.EntityType,
                DomicileState   = _profile.DomicileState,
                Address1        = _profile.Address1,
                Address2        = _profile.Address2,
                City            = _profile.City,
                State           = _profile.State,
                Zip             = _profile.Zip,
                Phone           = _profile.Phone,
                Website         = _profile.Website,
                EoCarrier       = _profile.EoCarrier,
                EoPolicyNumber  = _profile.EoPolicyNumber,
                EoCoverageLimit = _profile.EoCoverageLimit,
                EoExpiryDate    = _profile.EoExpiryDate,
            }
            : new();
        _showEditDrawer = true;
    }

    private void CloseEditDrawer() => _showEditDrawer = false;

    private async Task SaveProfileAsync()
    {
        try
        {
            await Api.UpdateAgencyProfileAsync(_tenantId, new(
                AgencyName:     _editModel.LegalName,
                DbaName:        _editModel.DbaName,
                Npn:            _editModel.Npn,
                Fein:           _editModel.Fein,
                EntityType:     _editModel.EntityType,
                LicenseNumber:  null,
                DomicileState:  _editModel.DomicileState,
                Phone:          _editModel.Phone,
                Email:          null,
                Website:        _editModel.Website,
                AddressLine1:   _editModel.Address1,
                AddressLine2:   _editModel.Address2,
                City:           _editModel.City,
                StateProvince:  _editModel.State,
                PostalCode:     _editModel.Zip,
                CountryCode:    null,
                EoCarrier:      _editModel.EoCarrier,
                EoPolicyNumber: _editModel.EoPolicyNumber,
                EoCoverageLimit: _editModel.EoCoverageLimit,
                EoExpiryDate:   _editModel.EoExpiryDate,
                Locale:         "en-US",
                CurrencyCode:   "USD",
                TimeZoneId:     "UTC"));
            _profile = _editModel;
            _showEditDrawer = false;
            await LoadAsync();
            await ShowToastAsync("Agency profile saved.", "e-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Failed to save agency profile: {ex.Message}", "e-toast-danger");
        }
    }

    private void SetFilter(string filter) => _activeFilter = _activeFilter == filter && filter != "Overview" ? "Overview" : filter;

    private bool ShowSection(string section) => _activeFilter == "Overview" || _activeFilter == section;

    private string KpiClass(string filter) => _activeFilter == filter ? "as-kpi-card--active" : string.Empty;

    private string EoIconClass => _profile?.EoExpiryDate is DateTime expiry && expiry < DateTime.Today.AddDays(45)
        ? "as-kpi-icon--warning"
        : "as-kpi-icon--success";

    private async Task ShowToastAsync(string msg, string cssClass = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = cssClass });
    }

    // ── Inner models ──────────────────────────────────────────────────────────────
    private sealed record LabelValue(string Value, string Label);

    private sealed class AgencyProfileDto
    {
        public string  LegalName       { get; set; } = string.Empty;
        public string? DbaName         { get; set; }
        public string  Npn             { get; set; } = string.Empty;
        public string  Fein            { get; set; } = string.Empty;
        public string  EntityType      { get; set; } = string.Empty;
        public string  DomicileState   { get; set; } = string.Empty;
        public string  Address1        { get; set; } = string.Empty;
        public string? Address2        { get; set; }
        public string  City            { get; set; } = string.Empty;
        public string  State           { get; set; } = string.Empty;
        public string  Zip             { get; set; } = string.Empty;
        public string  Phone           { get; set; } = string.Empty;
        public string? Website         { get; set; }
        public string? EoCarrier       { get; set; }
        public string? EoPolicyNumber  { get; set; }
        public decimal? EoCoverageLimit { get; set; }
        public DateTime? EoExpiryDate  { get; set; }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
