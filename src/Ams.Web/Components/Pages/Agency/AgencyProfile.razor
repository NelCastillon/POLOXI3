@page "/admin/agency/profile"
@namespace Ams.Web.Components.Pages.AgencyAdmin
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Agency Profile — Agency Setup</PageTitle>

<AppPageHeader Title="Agency Profile"
               Subtitle="Legal name, address, licensing, E&amp;O coverage and branding settings"
               Icon="bi-building">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenEditDrawer">
            <i class="bi bi-pencil" aria-hidden="true"></i> Edit Profile
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="ap-kpi-strip">
    <div class="ap-kpi-card">
        <span class="ap-kpi-icon ap-kpi-icon--branches"><i class="bi bi-diagram-3-fill" aria-hidden="true"></i></span>
        <div>
            <div class="ap-kpi-value">@_branchCount</div>
            <div class="ap-kpi-label">Branches</div>
        </div>
    </div>
    <div class="ap-kpi-card">
        <span class="ap-kpi-icon ap-kpi-icon--staff"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
        <div>
            <div class="ap-kpi-value">@_staffCount</div>
            <div class="ap-kpi-label">Staff</div>
        </div>
    </div>
    <div class="ap-kpi-card">
        <span class="ap-kpi-icon ap-kpi-icon--carriers"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
        <div>
            <div class="ap-kpi-value">@_carrierCount</div>
            <div class="ap-kpi-label">Appointed Carriers</div>
        </div>
    </div>
    <div class="ap-kpi-card">
        <span class="ap-kpi-icon ap-kpi-icon--eo"><i class="bi bi-file-earmark-check" aria-hidden="true"></i></span>
        <div>
            <div class="ap-kpi-value">@(_profile?.EoExpiryDate.HasValue == true ? _profile.EoExpiryDate.Value.ToString("d") : "—")</div>
            <div class="ap-kpi-label">E&amp;O Expiry</div>
        </div>
    </div>
</div>

<!-- Profile card -->
<div class="um-grid-card ap-profile-card">
    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite" aria-label="Loading agency profile…">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading…</span>
        </div>
    }
    @if (_profile is not null)
    {
        <div class="ap-section">
            <h3 class="ap-section-title"><i class="bi bi-building" aria-hidden="true"></i> Legal Information</h3>
            <div class="ap-fields">
                <div class="ap-field"><span class="ap-field-label">Legal Name</span><span class="ap-field-value">@_profile.LegalName</span></div>
                <div class="ap-field"><span class="ap-field-label">DBA / Trade Name</span><span class="ap-field-value">@(_profile.DbaName ?? "—")</span></div>
                <div class="ap-field"><span class="ap-field-label">NPN</span><span class="ap-field-value ap-mono">@_profile.Npn</span></div>
                <div class="ap-field"><span class="ap-field-label">FEIN / Tax ID</span><span class="ap-field-value ap-mono">@_profile.Fein</span></div>
                <div class="ap-field"><span class="ap-field-label">Entity Type</span><span class="ap-field-value">@_profile.EntityType</span></div>
                <div class="ap-field"><span class="ap-field-label">Domicile State</span><span class="ap-field-value">@_profile.DomicileState</span></div>
            </div>
        </div>
        <div class="ap-section">
            <h3 class="ap-section-title"><i class="bi bi-geo-alt" aria-hidden="true"></i> Primary Address</h3>
            <div class="ap-fields">
                <div class="ap-field"><span class="ap-field-label">Address Line 1</span><span class="ap-field-value">@_profile.Address1</span></div>
                <div class="ap-field"><span class="ap-field-label">Address Line 2</span><span class="ap-field-value">@(_profile.Address2 ?? "—")</span></div>
                <div class="ap-field"><span class="ap-field-label">City</span><span class="ap-field-value">@_profile.City</span></div>
                <div class="ap-field"><span class="ap-field-label">State</span><span class="ap-field-value">@_profile.State</span></div>
                <div class="ap-field"><span class="ap-field-label">ZIP</span><span class="ap-field-value ap-mono">@_profile.Zip</span></div>
                <div class="ap-field"><span class="ap-field-label">Phone</span><span class="ap-field-value ap-mono">@_profile.Phone</span></div>
                <div class="ap-field"><span class="ap-field-label">Website</span><span class="ap-field-value">@(_profile.Website ?? "—")</span></div>
            </div>
        </div>
        <div class="ap-section">
            <h3 class="ap-section-title"><i class="bi bi-file-earmark-check" aria-hidden="true"></i> E&amp;O Coverage</h3>
            <div class="ap-fields">
                <div class="ap-field"><span class="ap-field-label">Carrier</span><span class="ap-field-value">@(_profile.EoCarrier ?? "—")</span></div>
                <div class="ap-field"><span class="ap-field-label">Policy #</span><span class="ap-field-value ap-mono">@(_profile.EoPolicyNumber ?? "—")</span></div>
                <div class="ap-field"><span class="ap-field-label">Coverage Limit</span><span class="ap-field-value">@(_profile.EoCoverageLimit.HasValue ? _profile.EoCoverageLimit.Value.ToString("C0") : "—")</span></div>
                <div class="ap-field"><span class="ap-field-label">Expiry Date</span><span class="ap-field-value">@(_profile.EoExpiryDate.HasValue ? _profile.EoExpiryDate.Value.ToString("d") : "—")</span></div>
            </div>
        </div>
    }
    else if (!_loading)
    {
        <div class="ap-empty-state">
            <i class="bi bi-building ap-empty-icon" aria-hidden="true"></i>
            <p>No agency profile data loaded. Click <strong>Edit Profile</strong> to get started.</p>
        </div>
    }
</div>

<!-- Edit Drawer -->
<AppCrudDrawer @bind-Visible="_showEditDrawer"
               Title="Edit Agency Profile"
               OnSave="SaveProfileAsync"
               OnCancel="CloseEditDrawer">
    <Body>
        <div class="ap-form">
            <label class="ap-form-label">Legal Name</label>
            <input class="um-input" @bind="_editModel.LegalName" placeholder="Agency legal name" />

            <label class="ap-form-label">DBA / Trade Name</label>
            <input class="um-input" @bind="_editModel.DbaName" placeholder="Optional trade name" />

            <label class="ap-form-label">NPN</label>
            <input class="um-input ap-mono" @bind="_editModel.Npn" placeholder="National Producer Number" />

            <label class="ap-form-label">FEIN / Tax ID</label>
            <input class="um-input ap-mono" @bind="_editModel.Fein" placeholder="Federal Employer ID" />

            <label class="ap-form-label">Entity Type</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_entityTypeOptions"
                            @bind-Value="_editModel.EntityType"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>

            <label class="ap-form-label">Domicile State</label>
            <input class="um-input" @bind="_editModel.DomicileState" placeholder="State abbreviation" />

            <label class="ap-form-label">Address Line 1</label>
            <input class="um-input" @bind="_editModel.Address1" />

            <label class="ap-form-label">Address Line 2</label>
            <input class="um-input" @bind="_editModel.Address2" />

            <div class="ap-form-row">
                <div>
                    <label class="ap-form-label">City</label>
                    <input class="um-input" @bind="_editModel.City" />
                </div>
                <div>
                    <label class="ap-form-label">State</label>
                    <input class="um-input" @bind="_editModel.State" />
                </div>
                <div>
                    <label class="ap-form-label">ZIP</label>
                    <input class="um-input ap-mono" @bind="_editModel.Zip" />
                </div>
            </div>

            <label class="ap-form-label">Phone</label>
            <input class="um-input ap-mono" @bind="_editModel.Phone" />

            <label class="ap-form-label">Website</label>
            <input class="um-input" @bind="_editModel.Website" />

            <h4 class="ap-form-section-heading">E&amp;O Coverage</h4>

            <label class="ap-form-label">E&amp;O Carrier</label>
            <input class="um-input" @bind="_editModel.EoCarrier" />

            <label class="ap-form-label">Policy Number</label>
            <input class="um-input ap-mono" @bind="_editModel.EoPolicyNumber" />

            <label class="ap-form-label">Coverage Limit</label>
            <input class="um-input ap-mono" type="number" @bind="_editModel.EoCoverageLimit" />

            <label class="ap-form-label">Expiry Date</label>
            <input class="um-input" type="date" @bind="_editModel.EoExpiryDate" />
        </div>
    </Body>
</AppCrudDrawer>

<!-- Toast -->
<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    private SfToast? _toast;
    private bool _loading      = false;
    private bool _showEditDrawer = false;

    private int _branchCount  = 0;
    private int _staffCount   = 0;
    private int _carrierCount = 0;

    private AgencyProfileDto? _profile;
    private AgencyProfileDto  _editModel = new();

    private static readonly List<LabelValue> _entityTypeOptions =
    [
        new("Corporation",    "Corporation"),
        new("LLC",            "LLC"),
        new("Partnership",    "Partnership"),
        new("SoleProprietor", "Sole Proprietor"),
    ];

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",          "/"),
            new("Agency Setup",  "/admin/agency/profile"),
            new("Agency Profile", "/admin/agency/profile"));

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            // TODO: replace with Api.GetAgencyProfileAsync(_tenantId)
            await Task.Delay(0);
            _profile      = null;
            _branchCount  = 0;
            _staffCount   = 0;
            _carrierCount = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenEditDrawer()
    {
        _editModel = _profile is not null
            ? new AgencyProfileDto
            {
                LegalName       = _profile.LegalName,
                DbaName         = _profile.DbaName,
                Npn             = _profile.Npn,
                Fein            = _profile.Fein,
                EntityType      = _profile.EntityType,
                DomicileState   = _profile.DomicileState,
                Address1        = _profile.Address1,
                Address2        = _profile.Address2,
                City            = _profile.City,
                State           = _profile.State,
                Zip             = _profile.Zip,
                Phone           = _profile.Phone,
                Website         = _profile.Website,
                EoCarrier       = _profile.EoCarrier,
                EoPolicyNumber  = _profile.EoPolicyNumber,
                EoCoverageLimit = _profile.EoCoverageLimit,
                EoExpiryDate    = _profile.EoExpiryDate,
            }
            : new();
        _showEditDrawer = true;
    }

    private void CloseEditDrawer() => _showEditDrawer = false;

    private async Task SaveProfileAsync()
    {
        // TODO: replace with Api.SaveAgencyProfileAsync(_tenantId, _editModel)
        await Task.Delay(0);
        _profile = _editModel;
        _showEditDrawer = false;
        await ShowToastAsync("Agency profile saved.", "e-toast-success");
    }

    private async Task ShowToastAsync(string msg, string cssClass = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = cssClass });
    }

    // ── Inner models ──────────────────────────────────────────────────────────────
    private sealed record LabelValue(string Value, string Label);

    private sealed class AgencyProfileDto
    {
        public string  LegalName       { get; set; } = string.Empty;
        public string? DbaName         { get; set; }
        public string  Npn             { get; set; } = string.Empty;
        public string  Fein            { get; set; } = string.Empty;
        public string  EntityType      { get; set; } = string.Empty;
        public string  DomicileState   { get; set; } = string.Empty;
        public string  Address1        { get; set; } = string.Empty;
        public string? Address2        { get; set; }
        public string  City            { get; set; } = string.Empty;
        public string  State           { get; set; } = string.Empty;
        public string  Zip             { get; set; } = string.Empty;
        public string  Phone           { get; set; } = string.Empty;
        public string? Website         { get; set; }
        public string? EoCarrier       { get; set; }
        public string? EoPolicyNumber  { get; set; }
        public decimal? EoCoverageLimit { get; set; }
        public DateTime? EoExpiryDate  { get; set; }
    }
}
