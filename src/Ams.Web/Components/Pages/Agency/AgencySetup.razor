@page "/admin/agency/setup"
@namespace Ams.Web.Components.Pages.AgencyAdmin
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Agency Setup - Administration</PageTitle>

<div class="ap-page-container">
    <!-- Professional Header -->
    <div class="ap-page-header">
        <div>
            <h1 class="ap-page-header__title">
                <i class="bi bi-building" style="margin-right: 0.75rem;"></i>Agency Setup
            </h1>
            <p class="ap-page-header__subtitle">
                Configure your agency profile, branches, teams, and staff
            </p>
        </div>
    </div>

    <!-- Content Area -->
    <div class="ap-content">
        <!-- Setup Menu Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
            <!-- Agency Profile Card -->
            <div class="ap-card ap-setup-card" @onclick="@(() => Nav.NavigateTo("/admin/agency/profile"))" role="button" tabindex="0">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
                    <span style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #3b82f6, #1d4ed8); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.5rem;">
                        <i class="bi bi-building-fill"></i>
                    </span>
                    <i class="bi bi-chevron-right" style="color: #d1d5db; font-size: 1.5rem;"></i>
                </div>
                <h3 style="margin: 0 0 0.5rem 0; color: #111827; font-weight: 600;">Agency Profile</h3>
                <p style="margin: 0; color: #6b7280; font-size: 0.875rem; line-height: 1.5;">
                    Configure agency legal information, contact details, and E&O coverage settings
                </p>
                <div style="display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap;">
                    <span class="ap-badge ap-badge--info">Legal Info</span>
                    <span class="ap-badge ap-badge--info">Licensing</span>
                    <span class="ap-badge ap-badge--info">E&O</span>
                </div>
            </div>

            <!-- Branches Card -->
            <div class="ap-card ap-setup-card" @onclick="@(() => Nav.NavigateTo("/admin/agency/branches"))" role="button" tabindex="0">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
                    <span style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #10b981, #059669); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.5rem;">
                        <i class="bi bi-diagram-3-fill"></i>
                    </span>
                    <i class="bi bi-chevron-right" style="color: #d1d5db; font-size: 1.5rem;"></i>
                </div>
                <h3 style="margin: 0 0 0.5rem 0; color: #111827; font-weight: 600;">Branches</h3>
                <p style="margin: 0; color: #6b7280; font-size: 0.875rem; line-height: 1.5;">
                    Manage office locations, branch codes, and branch-specific settings
                </p>
                <div style="display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap;">
                    <span class="ap-badge ap-badge--success">Locations</span>
                    <span class="ap-badge ap-badge--success">Codes</span>
                </div>
            </div>

            <!-- Teams Card -->
            <div class="ap-card ap-setup-card" @onclick="@(() => Nav.NavigateTo("/admin/agency/teams"))" role="button" tabindex="0">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
                    <span style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #f59e0b, #d97706); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.5rem;">
                        <i class="bi bi-people-fill"></i>
                    </span>
                    <i class="bi bi-chevron-right" style="color: #d1d5db; font-size: 1.5rem;"></i>
                </div>
                <h3 style="margin: 0 0 0.5rem 0; color: #111827; font-weight: 600;">Teams</h3>
                <p style="margin: 0; color: #6b7280; font-size: 0.875rem; line-height: 1.5;">
                    Organize departments and teams within your agency
                </p>
                <div style="display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap;">
                    <span class="ap-badge ap-badge--warning">Departments</span>
                    <span class="ap-badge ap-badge--warning">Teams</span>
                </div>
            </div>

            <!-- Producers / CSRs Card -->
            <div class="ap-card ap-setup-card" @onclick="@(() => Nav.NavigateTo("/admin/agency/staff"))" role="button" tabindex="0">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
                    <span style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, #8b5cf6, #7c3aed); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.5rem;">
                        <i class="bi bi-person-badge-fill"></i>
                    </span>
                    <i class="bi bi-chevron-right" style="color: #d1d5db; font-size: 1.5rem;"></i>
                </div>
                <h3 style="margin: 0 0 0.5rem 0; color: #111827; font-weight: 600;">Producers / CSRs</h3>
                <p style="margin: 0; color: #6b7280; font-size: 0.875rem; line-height: 1.5;">
                    Manage producers, CSRs, licenses, and staff appointments
                </p>
                <div style="display: flex; gap: 0.5rem; margin-top: 1rem; flex-wrap: wrap;">
                    <span class="ap-badge ap-badge--neutral">Producers</span>
                    <span class="ap-badge ap-badge--neutral">Licenses</span>
                </div>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="ap-card">
            <div style="padding: 1.5rem; border-bottom: 1px solid #e5e7eb;">
                <h2 style="margin: 0; font-size: 1.125rem; font-weight: 600; color: #111827;">Setup Progress</h2>
            </div>
            <div style="padding: 1.5rem;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
                    <div>
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
                            <span style="color: #6b7280; font-size: 0.875rem; font-weight: 500;">Agency Profile</span>
                            <span style="color: #059669; font-weight: 600; font-size: 0.875rem;">100%</span>
                        </div>
                        <div style="width: 100%; height: 6px; background: #e5e7eb; border-radius: 9999px; overflow: hidden;">
                            <div style="width: 100%; height: 100%; background: #10b981;"></div>
                        </div>
                    </div>
                    <div>
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
                            <span style="color: #6b7280; font-size: 0.875rem; font-weight: 500;">Branches</span>
                            <span style="color: #dc2626; font-weight: 600; font-size: 0.875rem;">0%</span>
                        </div>
                        <div style="width: 100%; height: 6px; background: #e5e7eb; border-radius: 9999px; overflow: hidden;">
                            <div style="width: 0%; height: 100%; background: #ef4444;"></div>
                        </div>
                    </div>
                    <div>
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
                            <span style="color: #6b7280; font-size: 0.875rem; font-weight: 500;">Teams</span>
                            <span style="color: #dc2626; font-weight: 600; font-size: 0.875rem;">0%</span>
                        </div>
                        <div style="width: 100%; height: 6px; background: #e5e7eb; border-radius: 9999px; overflow: hidden;">
                            <div style="width: 0%; height: 100%; background: #ef4444;"></div>
                        </div>
                    </div>
                    <div>
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem;">
                            <span style="color: #6b7280; font-size: 0.875rem; font-weight: 500;">Staff</span>
                            <span style="color: #dc2626; font-weight: 600; font-size: 0.875rem;">0%</span>
                        </div>
                        <div style="width: 100%; height: 6px; background: #e5e7eb; border-radius: 9999px; overflow: hidden;">
                            <div style="width: 0%; height: 100%; background: #ef4444;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .ap-setup-card {
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .ap-setup-card:hover {
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        transform: translateY(-2px);
    }

    .ap-setup-card:active {
        transform: translateY(0);
    }
</style>

@code {
    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Administration", "/admin"), new("Agency Setup", "/admin/agency/setup"));
    }
}
