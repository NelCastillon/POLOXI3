@page "/portal/white-label"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>White-Label Portal — AMS</PageTitle>

<AppPageHeader Title="White-Label Portal &amp; Embedded Experience"
               Subtitle="Enterprise control center for client portal branding, mobile apps, embedded chat, access policy, and launch readiness."
               Icon="bi-stars">
    <Actions>
        <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_busy">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="() => _showPublishConfirm = true" disabled="@(_busy || _form.TenantId == Guid.Empty)">
            <i class="bi bi-cloud-upload" aria-hidden="true"></i> Publish
        </button>
        <button class="um-btn um-btn-primary" type="button" @onclick="SaveAsync" disabled="@_busy">
            <i class="bi bi-check-lg" aria-hidden="true"></i> Save configuration
        </button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="pwl-toast @_toastClass" role="status">
        <i class="bi @(_toastClass == "pwl-toast--danger" ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="pwl-toast-close" @onclick="ClearToast" aria-label="Dismiss message"><i class="bi bi-x-lg"></i></button>
    </div>
}

<div class="pwl-page">
    <section class="pwl-hero" style="--pwl-primary:@_form.PrimaryColor; --pwl-accent:@_form.AccentColor; --pwl-nav:@_form.NavBackgroundColor; --pwl-nav-text:@_form.NavTextColor">
        <div class="pwl-hero-main">
            <div class="pwl-eyebrow"><i class="bi bi-broadcast-pin" aria-hidden="true"></i> Live enterprise experience</div>
            <h2>@_form.DisplayName</h2>
            <p>@_form.WelcomeMessage</p>
            <div class="pwl-hero-meta">
                <span><i class="bi bi-globe2"></i> @_form.PortalDomain</span>
                <span><i class="bi bi-shield-check"></i> @_form.DomainStatus</span>
                <span><i class="bi bi-cloud-check"></i> @_form.PublishStatus</span>
                <span><i class="bi bi-clock-history"></i> @LastPublishedText</span>
            </div>
        </div>
        <div class="pwl-hero-preview">
            <div class="pwl-browser">
                <div class="pwl-browser-bar"><span></span><span></span><span></span><strong>@_form.PortalDomain</strong></div>
                <div class="pwl-preview-nav">
                    <div class="pwl-preview-logo">@Initials</div>
                    <span>Dashboard</span><span>Policies</span><span>Requests</span><span>Documents</span>
                </div>
                <div class="pwl-preview-body">
                    <div>
                        <small>Welcome back</small>
                        <strong>@_account.AgencyName Client Portal</strong>
                        <p>Manage policies, request certificates, upload documents, and chat with support.</p>
                    </div>
                    <div class="pwl-preview-card"><i class="bi bi-file-earmark-text"></i><span>Request certificate</span></div>
                    <div class="pwl-preview-card"><i class="bi bi-cloud-arrow-up"></i><span>Upload documents</span></div>
                </div>
            </div>
        </div>
    </section>

    <section class="pwl-kpi-strip" aria-label="White-label performance filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="pwl-kpi-card @(IsActiveKpi(kpi.Key) ? "pwl-kpi-card--active" : null)" title="@kpi.Tooltip" @onclick="() => SetKpi(kpi.Key)">
                <span class="pwl-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="pwl-kpi-label">@kpi.Label</span>
                <strong>@kpi.Value</strong>
                <small>@kpi.Detail</small>
            </button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger pwl-load-error" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            @_loadError
        </div>
    }

    <section class="pwl-command-bar">
        <div>
            <strong>Enterprise workflow</strong>
            <span>@WorkflowSummary</span>
        </div>
        <div class="pwl-command-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => RunActionAsync("verify-domain")' disabled="@_busy"><i class="bi bi-patch-check"></i> Verify domain</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => RunActionAsync("enable-sso")' disabled="@_busy"><i class="bi bi-shield-lock"></i> Enable SSO</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => RunActionAsync("enable-chat")' disabled="@_busy"><i class="bi bi-robot"></i> Enable chat</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => RunActionAsync("force-mobile-update")' disabled="@_busy"><i class="bi bi-phone-vibrate"></i> Force mobile update</button>
        </div>
    </section>

    <div class="pwl-tabs" role="tablist" aria-label="White-label configuration tabs">
        @foreach (var tab in _tabs)
        {
            <button type="button" role="tab" class="pwl-tab @(_activeTab == tab.Key ? "pwl-tab--active" : null)" @onclick="() => _activeTab = tab.Key">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
            </button>
        }
    </div>

    @if (_loading)
    {
        <div class="pwl-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading white-label configuration...</div>
    }
    else
    {
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            @if (_activeTab == "overview")
            {
                <section class="pwl-grid pwl-grid--overview">
                    <article class="pwl-panel pwl-panel--large">
                        <div class="pwl-panel-header"><i class="bi bi-activity"></i><div><strong>Readiness by importance</strong><span>Highest-impact launch items first.</span></div></div>
                        <div class="pwl-readiness-list">
                            @foreach (var item in ReadinessItems)
                            {
                                <button type="button" class="pwl-readiness-item" @onclick="() => _activeTab = item.TargetTab">
                                    <span class="pwl-score @item.Css">@item.Score</span>
                                    <div><strong>@item.Title</strong><span>@item.Detail</span></div>
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            }
                        </div>
                    </article>
                    <article class="pwl-panel">
                        <div class="pwl-panel-header"><i class="bi bi-list-check"></i><div><strong>Self-service capabilities</strong><span>Client-facing portal functions.</span></div></div>
                        <div class="pwl-capabilities">
                            @foreach (var cap in Capabilities)
                            {
                                <label class="pwl-toggle-card @(cap.Enabled ? "pwl-toggle-card--on" : null)">
                                    <input type="checkbox" checked="@cap.Enabled" @onchange="() => cap.Enabled = !cap.Enabled" />
                                    <i class="bi @cap.Icon"></i>
                                    <span>@cap.Name</span>
                                    <small>@(cap.Enabled ? "Active" : "Off")</small>
                                </label>
                            }
                        </div>
                    </article>
                    <article class="pwl-panel">
                        <div class="pwl-panel-header"><i class="bi bi-clock-history"></i><div><strong>Workflow activity</strong><span>Synced from portal data.</span></div></div>
                        <div class="pwl-metric-list">
                            @foreach (var metric in WorkflowMetrics)
                            {
                                <div class="pwl-metric-row"><span>@metric.Label</span><strong>@metric.Value</strong></div>
                            }
                        </div>
                    </article>
                </section>
            }
            else if (_activeTab == "portal")
            {
                <section class="pwl-grid">
                    <article class="pwl-panel pwl-panel--large">
                        <div class="pwl-panel-header"><i class="bi bi-palette"></i><div><strong>Portal brand system</strong><span>Domain, color, navigation, logo, and core messaging.</span></div></div>
                        <div class="pwl-form-grid">
                            <div class="pwl-field pwl-field--full"><label>Portal title</label><InputText class="pwl-input" @bind-Value="_form.DisplayName" /><ValidationMessage For="() => _form.DisplayName" class="text-danger" /></div>
                            <div class="pwl-field"><label>Custom domain</label><InputText class="pwl-input" @bind-Value="_form.PortalDomain" /><ValidationMessage For="() => _form.PortalDomain" class="text-danger" /><small>CNAME to tenant.agencybinder.com</small></div>
                            <div class="pwl-field"><label>Domain status</label><InputSelect class="pwl-input" @bind-Value="_form.DomainStatus"><option>Pending DNS</option><option>Verified</option><option>Needs Review</option></InputSelect><ValidationMessage For="() => _form.DomainStatus" class="text-danger" /></div>
                            <div class="pwl-field"><label>Primary color</label><div class="pwl-color-row"><input type="color" @bind="_form.PrimaryColor" /><InputText class="pwl-input" @bind-Value="_form.PrimaryColor" /></div><ValidationMessage For="() => _form.PrimaryColor" class="text-danger" /></div>
                            <div class="pwl-field"><label>Accent color</label><div class="pwl-color-row"><input type="color" @bind="_form.AccentColor" /><InputText class="pwl-input" @bind-Value="_form.AccentColor" /></div><ValidationMessage For="() => _form.AccentColor" class="text-danger" /></div>
                            <div class="pwl-field"><label>Navigation background</label><div class="pwl-color-row"><input type="color" @bind="_form.NavBackgroundColor" /><InputText class="pwl-input" @bind-Value="_form.NavBackgroundColor" /></div><ValidationMessage For="() => _form.NavBackgroundColor" class="text-danger" /></div>
                            <div class="pwl-field"><label>Navigation text</label><div class="pwl-color-row"><input type="color" @bind="_form.NavTextColor" /><InputText class="pwl-input" @bind-Value="_form.NavTextColor" /></div><ValidationMessage For="() => _form.NavTextColor" class="text-danger" /></div>
                            <div class="pwl-field"><label>Logo URL</label><InputText class="pwl-input" @bind-Value="_form.LogoUrl" /><ValidationMessage For="() => _form.LogoUrl" class="text-danger" /></div>
                            <div class="pwl-field"><label>Favicon URL</label><InputText class="pwl-input" @bind-Value="_form.FaviconUrl" /><ValidationMessage For="() => _form.FaviconUrl" class="text-danger" /></div>
                            <div class="pwl-field pwl-field--full"><label>Welcome message</label><InputTextArea class="pwl-input pwl-textarea" @bind-Value="_form.WelcomeMessage" /><ValidationMessage For="() => _form.WelcomeMessage" class="text-danger" /></div>
                            <div class="pwl-field"><label>Support email</label><InputText class="pwl-input" @bind-Value="_form.SupportEmail" /><ValidationMessage For="() => _form.SupportEmail" class="text-danger" /></div>
                            <div class="pwl-field"><label>Support phone</label><InputText class="pwl-input" @bind-Value="_form.SupportPhone" /><ValidationMessage For="() => _form.SupportPhone" class="text-danger" /></div>
                        </div>
                    </article>
                    <article class="pwl-panel"><div class="pwl-panel-header"><i class="bi bi-sliders"></i><div><strong>Portal modules</strong><span>Launch-ready client experience toggles.</span></div></div><div class="pwl-switch-list">@PortalSwitches</div></article>
                </section>
            }
            else if (_activeTab == "mobile")
            {
                <section class="pwl-grid">
                    <article class="pwl-panel pwl-panel--large">
                        <div class="pwl-panel-header"><i class="bi bi-phone"></i><div><strong>Native mobile app</strong><span>Store configuration, version gating, and device capabilities.</span></div></div>
                        <div class="pwl-form-grid">
                            <div class="pwl-field pwl-field--full"><label>App name</label><InputText class="pwl-input" @bind-Value="_form.MobileAppName" /><ValidationMessage For="() => _form.MobileAppName" class="text-danger" /></div>
                            <div class="pwl-field"><label>Bundle / package ID</label><InputText class="pwl-input" @bind-Value="_form.MobileBundleId" /><ValidationMessage For="() => _form.MobileBundleId" class="text-danger" /></div>
                            <div class="pwl-field"><label>Current version</label><InputText class="pwl-input" @bind-Value="_form.MobileVersion" /><ValidationMessage For="() => _form.MobileVersion" class="text-danger" /></div>
                            <div class="pwl-field"><label>Minimum version</label><InputText class="pwl-input" @bind-Value="_form.MinimumMobileVersion" /><ValidationMessage For="() => _form.MinimumMobileVersion" class="text-danger" /></div>
                            <div class="pwl-field"><label>iOS App Store URL</label><InputText class="pwl-input" @bind-Value="_form.IosStoreUrl" /><ValidationMessage For="() => _form.IosStoreUrl" class="text-danger" /></div>
                            <div class="pwl-field"><label>Google Play URL</label><InputText class="pwl-input" @bind-Value="_form.AndroidStoreUrl" /><ValidationMessage For="() => _form.AndroidStoreUrl" class="text-danger" /></div>
                        </div>
                    </article>
                    <article class="pwl-panel"><div class="pwl-panel-header"><i class="bi bi-phone-vibrate"></i><div><strong>Mobile controls</strong><span>Security and offline features.</span></div></div><div class="pwl-switch-list">@MobileSwitches</div></article>
                </section>
            }
            else if (_activeTab == "chat")
            {
                <section class="pwl-grid">
                    <article class="pwl-panel pwl-panel--large">
                        <div class="pwl-panel-header"><i class="bi bi-robot"></i><div><strong>Embedded chat assistant</strong><span>AI support, live handoff, and conversation controls.</span></div></div>
                        <div class="pwl-form-grid">
                            <div class="pwl-field"><label>Assistant name</label><InputText class="pwl-input" @bind-Value="_form.AssistantName" /><ValidationMessage For="() => _form.AssistantName" class="text-danger" /></div>
                            <div class="pwl-field"><label>Widget position</label><InputSelect class="pwl-input" @bind-Value="_form.ChatPosition"><option value="bottom-right">Bottom right</option><option value="bottom-left">Bottom left</option></InputSelect><ValidationMessage For="() => _form.ChatPosition" class="text-danger" /></div>
                            <div class="pwl-field"><label>Widget color</label><div class="pwl-color-row"><input type="color" @bind="_form.ChatWidgetColor" /><InputText class="pwl-input" @bind-Value="_form.ChatWidgetColor" /></div><ValidationMessage For="() => _form.ChatWidgetColor" class="text-danger" /></div>
                            <div class="pwl-field"><label>Escalation email</label><InputText class="pwl-input" @bind-Value="_form.ChatEscalationEmail" /><ValidationMessage For="() => _form.ChatEscalationEmail" class="text-danger" /></div>
                            <div class="pwl-field"><label>Office hours</label><InputText class="pwl-input" @bind-Value="_form.OfficeHours" /><ValidationMessage For="() => _form.OfficeHours" class="text-danger" /></div>
                            <div class="pwl-field pwl-field--full"><label>Assistant welcome message</label><InputTextArea class="pwl-input pwl-textarea" @bind-Value="_form.AssistantWelcomeMessage" /><ValidationMessage For="() => _form.AssistantWelcomeMessage" class="text-danger" /></div>
                        </div>
                    </article>
                    <article class="pwl-panel"><div class="pwl-panel-header"><i class="bi bi-chat-dots"></i><div><strong>Chat preview</strong><span>Client-facing widget state.</span></div></div>@ChatPreview<div class="pwl-switch-list pwl-switch-list--compact">@ChatSwitches</div></article>
                </section>
            }
            else if (_activeTab == "access")
            {
                <section class="pwl-grid">
                    <article class="pwl-panel pwl-panel--large">
                        <div class="pwl-panel-header"><i class="bi bi-shield-lock"></i><div><strong>Access and SSO</strong><span>Identity provider, redirect URIs, MFA, and provisioning.</span></div></div>
                        <div class="pwl-form-grid">
                            <div class="pwl-field"><label>Identity provider</label><InputSelect class="pwl-input" @bind-Value="_form.IdentityProvider"><option value="none">None — password only</option><option value="okta">Okta</option><option value="azure">Microsoft Entra ID</option><option value="google">Google Workspace</option><option value="saml">Generic SAML 2.0</option><option value="oidc">Generic OIDC</option></InputSelect><ValidationMessage For="() => _form.IdentityProvider" class="text-danger" /></div>
                            <div class="pwl-field"><label>SSO client ID</label><InputText class="pwl-input" @bind-Value="_form.SsoClientId" /><ValidationMessage For="() => _form.SsoClientId" class="text-danger" /></div>
                            <div class="pwl-field pwl-field--full"><label>SSO metadata URL</label><InputText class="pwl-input" @bind-Value="_form.SsoMetadataUrl" /><ValidationMessage For="() => _form.SsoMetadataUrl" class="text-danger" /></div>
                            <div class="pwl-field pwl-field--full"><label>Allowed redirect URIs</label><InputTextArea class="pwl-input pwl-textarea" @bind-Value="_form.RedirectUris" /><ValidationMessage For="() => _form.RedirectUris" class="text-danger" /></div>
                        </div>
                    </article>
                    <article class="pwl-panel"><div class="pwl-panel-header"><i class="bi bi-key"></i><div><strong>Security policy</strong><span>Password, session, and account lockout rules.</span></div></div><div class="pwl-form-grid pwl-form-grid--single"><div class="pwl-field"><label>Password minimum length</label><InputNumber class="pwl-input" @bind-Value="_form.PasswordMinLength" /><ValidationMessage For="() => _form.PasswordMinLength" class="text-danger" /></div><div class="pwl-field"><label>Session timeout minutes</label><InputNumber class="pwl-input" @bind-Value="_form.SessionTimeoutMinutes" /><ValidationMessage For="() => _form.SessionTimeoutMinutes" class="text-danger" /></div><div class="pwl-field"><label>Max failed attempts</label><InputNumber class="pwl-input" @bind-Value="_form.MaxFailedLoginAttempts" /><ValidationMessage For="() => _form.MaxFailedLoginAttempts" class="text-danger" /></div><div class="pwl-field"><label>Lockout minutes</label><InputNumber class="pwl-input" @bind-Value="_form.LockoutMinutes" /><ValidationMessage For="() => _form.LockoutMinutes" class="text-danger" /></div></div><div class="pwl-switch-list pwl-switch-list--compact">@AccessSwitches</div></article>
                </section>
            }
        </EditForm>
    }
</div>

@if (_showPublishConfirm)
{
    <div class="pwl-modal-backdrop" role="presentation">
        <div class="pwl-modal" role="dialog" aria-modal="true" aria-labelledby="publish-title">
            <div class="um-modal-header">
                <i class="bi bi-cloud-upload" aria-hidden="true"></i>
                <span id="publish-title">Publish white-label configuration</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showPublishConfirm = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-modal-body">
                <p>Publish the saved portal, mobile, chat, and access configuration to the live client experience.</p>
                <div class="pwl-publish-summary"><span>Domain</span><strong>@_form.PortalDomain</strong><span>Status</span><strong>@_form.DomainStatus</strong></div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showPublishConfirm = false">Cancel</button>
                <button type="button" class="um-btn um-btn-primary" @onclick="PublishAsync" disabled="@_busy"><i class="bi bi-cloud-upload"></i> Publish now</button>
            </div>
        </div>
    </div>
}

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading = true;
    private bool _busy;
    private bool _showPublishConfirm;
    private string? _loadError;
    private string? _toastMessage;
    private string _toastClass = "pwl-toast--success";
    private string _activeTab = "overview";
    private string _activeKpi = "all";
    private PortalMyAccountDto _account = new();
    private PortalWhiteLabelConfigurationDto? _configuration;
    private UpdatePortalWhiteLabelConfigurationRequest _form = new();

    private readonly List<TabItem> _tabs =
    [
        new("overview", "Overview", "bi-speedometer2"),
        new("portal", "Portal", "bi-globe2"),
        new("mobile", "Mobile", "bi-phone"),
        new("chat", "Chat", "bi-robot"),
        new("access", "Access & SSO", "bi-shield-lock")
    ];

    private List<CapabilityItem> Capabilities { get; } =
    [
        new("Certificate requests", "bi-file-earmark-text", true),
        new("Policy changes", "bi-pencil-square", true),
        new("Document upload", "bi-cloud-arrow-up", true),
        new("Invoice payment", "bi-credit-card", true),
        new("ID card download", "bi-person-vcard", true),
        new("Secure messaging", "bi-chat-lock", true),
        new("Renewal questionnaires", "bi-clipboard-check", true),
        new("Claim intake", "bi-exclamation-circle", false)
    ];

    private IEnumerable<KpiItem> Kpis =>
    [
        new("all", "Launch readiness", $"{ReadinessScore}%", "Portal, mobile, chat, access", "bi-rocket-takeoff", "Show the full enterprise launch picture."),
        new("portal", "Active portal users", ActivePortalUsers.ToString("N0"), $"{PendingInvites:N0} pending invites", "bi-people", "Focus the dashboard on portal adoption."),
        new("mobile", "Mobile installs", MobileInstalls.ToString("N0"), _form.MobilePublished ? "Published" : "Draft", "bi-phone-vibrate", "Focus the dashboard on mobile performance."),
        new("chat", "AI resolution", $"{AiResolutionRate}%", $"{LiveHandoffs30d:N0} handoffs", "bi-robot", "Focus the dashboard on chat and AI performance."),
        new("risk", "Open service load", OpenRequests.ToString("N0"), $"{UrgentRequests:N0} urgent", "bi-exclamation-diamond", "Focus the dashboard on client service risk.")
    ];

    private IEnumerable<ReadinessItem> ReadinessItems =>
    [
        new("Domain and publishing", _form.DomainStatus == "Verified" && _form.PublishStatus == "Live" ? 100 : 72, $"{_form.DomainStatus} / {_form.PublishStatus}", "portal"),
        new("Client adoption", Math.Min(100, ActivePortalUsers > 0 ? 88 : 55), $"{ActivePortalUsers:N0} active users and {PendingInvites:N0} pending invites", "overview"),
        new("Security posture", SecurityScore, $"MFA {(_form.MfaRequired ? "required" : "optional")}, SSO {(_form.SsoEnabled ? "enabled" : "off")}", "access"),
        new("Mobile readiness", _form.MobilePublished && !_form.ForceMobileUpdate ? 94 : 78, $"Version {_form.MobileVersion}, minimum {_form.MinimumMobileVersion}", "mobile"),
        new("Chat containment", _form.ChatEnabled ? Math.Max(50, AiResolutionRate) : 35, $"{ChatSessions30d:N0} sessions, {AiResolutionRate}% AI resolution", "chat")
    ];

    private IEnumerable<MetricItem> WorkflowMetrics =>
    [
        new("Open requests", OpenRequests.ToString("N0")),
        new("Urgent requests", UrgentRequests.ToString("N0")),
        new("Shared documents", SharedDocuments.ToString("N0")),
        new("API calls 30d", ApiCalls30d.ToString("N0")),
        new("CSAT", CsATScore.ToString("0.00")),
        new("Average response", $"{AverageResponseSeconds}s")
    ];

    private int SecurityScore => (_form.SsoEnabled ? 25 : 0) + (_form.MfaRequired ? 25 : 0) + (_form.RequireUppercase ? 15 : 0) + (_form.RequireSpecialCharacter ? 15 : 0) + (_form.PasswordMinLength >= 10 ? 10 : 0) + (_form.MaxFailedLoginAttempts <= 5 ? 10 : 0);
    private int ReadinessScore => (ReadinessItems.Sum(x => x.Score) / Math.Max(1, ReadinessItems.Count()));
    private int ActivePortalUsers => _configuration?.ActivePortalUsers ?? _account.ActivePortalUsers;
    private int PendingInvites => _configuration?.PendingInvites ?? _account.PendingInvites;
    private int MobileInstalls => _configuration?.MobileInstalls ?? _account.MobileInstalls;
    private int ChatSessions30d => _configuration?.ChatSessions30d ?? _account.ChatSessions30d;
    private int OpenRequests => _configuration?.OpenRequests ?? _account.OpenRequests;
    private int UrgentRequests => _configuration?.UrgentRequests ?? _account.UrgentRequests;
    private int SharedDocuments => _configuration?.SharedDocuments ?? _account.SharedDocuments;
    private int ApiCalls30d => _configuration?.ApiCalls30d ?? _account.ApiCalls30d;
    private decimal CsATScore => _configuration?.CsATScore ?? 4.60m;
    private int AiResolutionRate => _configuration?.AiResolutionRate ?? 74;
    private int LiveHandoffs30d => _configuration?.LiveHandoffs30d ?? 18;
    private int AverageResponseSeconds => _configuration?.AverageResponseSeconds ?? 108;
    private string Initials => string.Join(string.Empty, (_form.DisplayName.Length == 0 ? "AMS" : _form.DisplayName).Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
    private string LastPublishedText => _configuration?.LastPublishedDateUtc is DateTime value ? value.ToLocalTime().ToString("MMM d, yyyy h:mm tt") : "Not published";
    private string WorkflowSummary => _activeKpi switch { "portal" => "Portal adoption and invite workflow selected.", "mobile" => "Mobile app publishing and device readiness selected.", "chat" => "AI assistant and live handoff workflow selected.", "risk" => "Service risk and urgent requests selected.", _ => "Full launch readiness workflow selected." };

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Portal", "/portal/users"), new("White-Label", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _account = await Api.GetPortalMyAccountAsync(_tenantId) ?? new PortalMyAccountDto();
            _configuration = await Api.GetPortalWhiteLabelConfigurationAsync(_tenantId);
            _form = ToRequest(_configuration, _account);
        }
        catch (Exception ex)
        {
            _loadError = $"Unable to load white-label configuration: {ex.Message}";
            ShowToast(_loadError, danger: true);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            await Api.UpdatePortalWhiteLabelConfigurationAsync(_form);
            _configuration = await Api.GetPortalWhiteLabelConfigurationAsync(_tenantId);
            _form = ToRequest(_configuration, _account);
            ShowToast("White-label configuration saved.");
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", danger: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PublishAsync()
    {
        _busy = true;
        _showPublishConfirm = false;
        try
        {
            await Api.PublishPortalWhiteLabelAsync(_tenantId);
            await LoadAsync();
            ShowToast("White-label configuration published to the live portal.");
        }
        catch (Exception ex)
        {
            ShowToast($"Publish failed: {ex.Message}", danger: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunActionAsync(string action)
    {
        _busy = true;
        try
        {
            await Api.RunPortalWhiteLabelActionAsync(_tenantId, action);
            await LoadAsync();
            ShowToast(ActionMessage(action));
        }
        catch (Exception ex)
        {
            ShowToast($"Action failed: {ex.Message}", danger: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void SetKpi(string key)
    {
        _activeKpi = key;
        _activeTab = key switch { "portal" => "portal", "mobile" => "mobile", "chat" => "chat", "risk" => "overview", _ => "overview" };
    }

    private bool IsActiveKpi(string key) => _activeKpi == key;
    private void ShowToast(string message, bool danger = false) { _toastMessage = message; _toastClass = danger ? "pwl-toast--danger" : "pwl-toast--success"; }
    private void ClearToast() => _toastMessage = null;

    private static string ActionMessage(string action) => action switch
    {
        "verify-domain" => "Domain verification workflow completed.",
        "enable-sso" => "SSO has been enabled for the client portal.",
        "enable-chat" => "Embedded chat has been enabled.",
        "force-mobile-update" => "Mobile force-update workflow enabled.",
        _ => "White-label action completed."
    };

    private static UpdatePortalWhiteLabelConfigurationRequest ToRequest(PortalWhiteLabelConfigurationDto? dto, PortalMyAccountDto account)
    {
        var agency = string.IsNullOrWhiteSpace(account.AgencyName) ? "Agency" : account.AgencyName;
        return new()
        {
            TenantId = dto?.TenantId == Guid.Empty || dto is null ? account.TenantId : dto.TenantId,
            DisplayName = dto?.DisplayName ?? $"{agency} Client Portal",
            PortalDomain = dto?.PortalDomain ?? account.PortalDomain,
            DomainStatus = dto?.DomainStatus ?? "Pending DNS",
            PublishStatus = dto?.PublishStatus ?? "Draft",
            PrimaryColor = dto?.PrimaryColor ?? "#1d4ed8",
            AccentColor = dto?.AccentColor ?? "#059669",
            NavBackgroundColor = dto?.NavBackgroundColor ?? "#1e293b",
            NavTextColor = dto?.NavTextColor ?? "#f8fafc",
            LogoUrl = dto?.LogoUrl ?? string.Empty,
            FaviconUrl = dto?.FaviconUrl ?? string.Empty,
            WelcomeMessage = dto?.WelcomeMessage ?? $"Manage policies, request certificates, upload documents, and message {agency} in one secure place.",
            SupportEmail = dto?.SupportEmail ?? account.SupportEmail,
            SupportPhone = dto?.SupportPhone ?? account.SupportPhone,
            ShowAgencyLogo = dto?.ShowAgencyLogo ?? true,
            HidePoweredBy = dto?.HidePoweredBy ?? false,
            ShowNewsWidget = dto?.ShowNewsWidget ?? true,
            ShowSupportChat = dto?.ShowSupportChat ?? true,
            EnableAnnouncements = dto?.EnableAnnouncements ?? true,
            EnableCrossSellWidget = dto?.EnableCrossSellWidget ?? true,
            MobileAppName = dto?.MobileAppName ?? $"{agency} Mobile",
            MobileBundleId = dto?.MobileBundleId ?? string.Empty,
            IosStoreUrl = dto?.IosStoreUrl ?? string.Empty,
            AndroidStoreUrl = dto?.AndroidStoreUrl ?? string.Empty,
            MobileVersion = dto?.MobileVersion ?? "2.4.1",
            MinimumMobileVersion = dto?.MinimumMobileVersion ?? "2.0.0",
            MobilePublished = dto?.MobilePublished ?? account.MobileAppPublished,
            BiometricLogin = dto?.BiometricLogin ?? true,
            PushNotifications = dto?.PushNotifications ?? true,
            OfflinePolicyView = dto?.OfflinePolicyView ?? true,
            ForceMobileUpdate = dto?.ForceMobileUpdate ?? false,
            RequireMfaOnMobile = dto?.RequireMfaOnMobile ?? true,
            AssistantName = dto?.AssistantName ?? "Aria",
            AssistantWelcomeMessage = dto?.AssistantWelcomeMessage ?? $"Hi there! I'm Aria, your {agency} assistant. I can help with COI requests, policy questions, payments, and more.",
            ChatWidgetColor = dto?.ChatWidgetColor ?? "#1d4ed8",
            ChatPosition = dto?.ChatPosition ?? "bottom-right",
            ChatEscalationEmail = dto?.ChatEscalationEmail ?? account.SupportEmail,
            OfficeHours = dto?.OfficeHours ?? "Mon-Fri, 8am-5pm CT",
            ChatEnabled = dto?.ChatEnabled ?? account.ChatEnabled,
            AiResponsesEnabled = dto?.AiResponsesEnabled ?? true,
            LiveHandoffEnabled = dto?.LiveHandoffEnabled ?? true,
            ShowChatOnMobile = dto?.ShowChatOnMobile ?? true,
            AllowFileAttachments = dto?.AllowFileAttachments ?? true,
            TranscriptEmailEnabled = dto?.TranscriptEmailEnabled ?? true,
            IdentityProvider = dto?.IdentityProvider ?? "none",
            SsoClientId = dto?.SsoClientId ?? string.Empty,
            SsoMetadataUrl = dto?.SsoMetadataUrl ?? string.Empty,
            RedirectUris = dto?.RedirectUris ?? string.Empty,
            SsoEnabled = dto?.SsoEnabled ?? account.SsoEnabled,
            MfaRequired = dto?.MfaRequired ?? account.MfaEnabled,
            AllowSocialLogin = dto?.AllowSocialLogin ?? true,
            AutoProvisionUsers = dto?.AutoProvisionUsers ?? false,
            PasswordMinLength = dto?.PasswordMinLength > 0 ? dto.PasswordMinLength : 10,
            SessionTimeoutMinutes = dto?.SessionTimeoutMinutes > 0 ? dto.SessionTimeoutMinutes : 30,
            MaxFailedLoginAttempts = dto?.MaxFailedLoginAttempts > 0 ? dto.MaxFailedLoginAttempts : 5,
            LockoutMinutes = dto?.LockoutMinutes > 0 ? dto.LockoutMinutes : 15,
            RequireUppercase = dto?.RequireUppercase ?? true,
            RequireSpecialCharacter = dto?.RequireSpecialCharacter ?? true,
            IpWhitelistEnabled = dto?.IpWhitelistEnabled ?? false,
            ConfigurationJson = dto?.ConfigurationJson ?? "{}"
        };
    }

