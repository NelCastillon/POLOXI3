    private sealed record TabItem(string Key, string Label, string Icon);
    private sealed record KpiItem(string Key, string Label, string Value, string Detail, string Icon, string Tooltip);
    private sealed record ReadinessItem(string Title, int Score, string Detail, string TargetTab)
    {
        public string Css => Score >= 90 ? "pwl-score--good" : Score >= 70 ? "pwl-score--warn" : "pwl-score--bad";
    }
    private sealed record MetricItem(string Label, string Value);
    private sealed class CapabilityItem(string name, string icon, bool enabled)
    {
        public string Name { get; } = name;
        public string Icon { get; } = icon;
        public bool Enabled { get; set; } = enabled;
    }
