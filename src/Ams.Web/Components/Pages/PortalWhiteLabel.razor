@page "/portal/white-label"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>White-Label &amp; Embedded Experience — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Top" />
</SfToast>

<AppPageHeader Title="White-Label Portal &amp; Embedded Experience"
               Subtitle="Full agency-branded insured portal, native mobile app, and embedded AI chat assistant — unified configuration"
               Icon="bi-stars">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="() => _showPublishConfirm = true">
            <i class="bi bi-cloud-upload" aria-hidden="true"></i> Publish Changes
        </button>
        <button class="um-btn um-btn-primary" @onclick="SaveAsync">
            <i class="bi bi-check-lg" aria-hidden="true"></i> Save All
        </button>
    </Actions>
</AppPageHeader>

<!-- Status strip -->
<div class="pwl-status-strip">
    <div class="pwl-status-card pwl-status-card--@(_portalStatus == "Live" ? "live" : "draft")">
        <i class="bi bi-globe2" aria-hidden="true"></i>
        <div>
            <div class="pwl-sv">Insured Portal</div>
            <span class="pwl-sl">@_portalStatus</span>
        </div>
    </div>
    <div class="pwl-status-card pwl-status-card--@(_appStatus == "Published" ? "live" : "draft")">
        <i class="bi bi-phone" aria-hidden="true"></i>
        <div>
            <div class="pwl-sv">Mobile App</div>
            <span class="pwl-sl">@_appStatus</span>
        </div>
    </div>
    <div class="pwl-status-card pwl-status-card--@(_chatStatus == "Active" ? "live" : "draft")">
        <i class="bi bi-robot" aria-hidden="true"></i>
        <div>
            <div class="pwl-sv">Chat Assistant</div>
            <span class="pwl-sl">@_chatStatus</span>
        </div>
    </div>
    <div class="pwl-status-card">
        <i class="bi bi-people" aria-hidden="true"></i>
        <div>
            <div class="pwl-sv">1,240</div>
            <span class="pwl-sl">Active Portal Users</span>
        </div>
    </div>
    <div class="pwl-status-card">
        <i class="bi bi-phone-vibrate" aria-hidden="true"></i>
        <div>
            <div class="pwl-sv">847</div>
            <span class="pwl-sl">Mobile App Installs</span>
        </div>
    </div>
    <div class="pwl-status-card">
        <i class="bi bi-chat-dots" aria-hidden="true"></i>
        <div>
            <div class="pwl-sv">@_chatSessions</div>
            <span class="pwl-sl">Chat Sessions (30d)</span>
        </div>
    </div>
</div>

<!-- Section tabs -->
<div class="pwl-tabs">
    <button class="pwl-tab @(_activeTab=="portal"?"pwl-tab--active":"")" @onclick='()=>_activeTab="portal"'>
        <i class="bi bi-globe2" aria-hidden="true"></i> Insured Portal
    </button>
    <button class="pwl-tab @(_activeTab=="mobile"?"pwl-tab--active":"")" @onclick='()=>_activeTab="mobile"'>
        <i class="bi bi-phone" aria-hidden="true"></i> Mobile App
    </button>
    <button class="pwl-tab @(_activeTab=="chat"?"pwl-tab--active":"")" @onclick='()=>_activeTab="chat"'>
        <i class="bi bi-robot" aria-hidden="true"></i> Chat &amp; Help Assistant
    </button>
    <button class="pwl-tab @(_activeTab=="access"?"pwl-tab--active":"")" @onclick='()=>_activeTab="access"'>
        <i class="bi bi-shield-lock" aria-hidden="true"></i> Access &amp; SSO
    </button>
</div>

@if (_activeTab == "portal")
{
    <div class="pwl-tab-content">
        <div class="pwl-two-col">
            <div class="pwl-panel">
                <div class="pwl-panel-hdr"><i class="bi bi-palette" aria-hidden="true"></i> Portal White-Label Settings</div>
                <div class="pwl-form-grid">
                    <div class="pwl-field pwl-field--full">
                        <label class="pwl-lbl">Custom Domain</label>
                        <SfTextBox @bind-Value="_portal.Domain" Placeholder="portal.youragency.com" />
                        <div class="pwl-hint">Add CNAME: portal.youragency.com → <code>tenant.agencybinder.com</code></div>
                    </div>
                    <div class="pwl-field pwl-field--full">
                        <label class="pwl-lbl">Portal Title</label>
                        <SfTextBox @bind-Value="_portal.Title" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Primary Brand Color</label>
                        <div class="pwl-color-row">
                            <input type="color" class="pwl-color-inp" @bind="_portal.PrimaryColor" />
                            <SfTextBox @bind-Value="_portal.PrimaryColor" />
                        </div>
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Accent Color</label>
                        <div class="pwl-color-row">
                            <input type="color" class="pwl-color-inp" @bind="_portal.AccentColor" />
                            <SfTextBox @bind-Value="_portal.AccentColor" />
                        </div>
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Favicon URL</label>
                        <SfTextBox @bind-Value="_portal.FaviconUrl" Placeholder="https://…/favicon.ico" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Logo URL</label>
                        <SfTextBox @bind-Value="_portal.LogoUrl" Placeholder="https://…/logo.png" />
                    </div>
                </div>
                <div class="pwl-toggle-section">
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_portal.HidePoweredBy" /> Hide "Powered by AgencyBinder" branding</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_portal.EnableAnnouncements" /> Enable agency announcement banner</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_portal.EnableNewsFeed" /> Show agency news feed on dashboard</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_portal.EnableCrossSellWidget" /> Show cross-sell recommendation widget</label>
                </div>
            </div>
            <div class="pwl-panel">
                <div class="pwl-panel-hdr"><i class="bi bi-list-check" aria-hidden="true"></i> Enabled Self-Service Capabilities</div>
                <div class="pwl-cap-list">
                    @foreach (var cap in _portalCaps)
                    {
                        <label class="pwl-cap-row @(cap.On ? "pwl-cap-row--on" : "")">
                            <input type="checkbox" class="pwl-chk" checked="@cap.On" @onchange="() => cap.On = !cap.On" />
                            <i class="bi @cap.Icon pwl-cap-icon" aria-hidden="true"></i>
                            <span>@cap.Name</span>
                            @if (cap.On) { <span class="pwl-cap-on">Active</span> }
                        </label>
                    }
                </div>
            </div>
        </div>
    </div>
}
else if (_activeTab == "mobile")
{
    <div class="pwl-tab-content">
        <div class="pwl-two-col">
            <div class="pwl-panel">
                <div class="pwl-panel-hdr"><i class="bi bi-phone" aria-hidden="true"></i> Native Mobile App — Agency Branded</div>
                <div class="pwl-form-grid">
                    <div class="pwl-field pwl-field--full">
                        <label class="pwl-lbl">App Name (stores)</label>
                        <SfTextBox @bind-Value="_mobile.AppName" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">iOS Bundle ID</label>
                        <SfTextBox @bind-Value="_mobile.IosBundleId" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Android Package</label>
                        <SfTextBox @bind-Value="_mobile.AndroidPackage" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">iOS App Store Link</label>
                        <SfTextBox @bind-Value="_mobile.IosLink" Placeholder="https://apps.apple.com/…" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Google Play Link</label>
                        <SfTextBox @bind-Value="_mobile.AndroidLink" Placeholder="https://play.google.com/…" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Current Version</label>
                        <SfTextBox @bind-Value="_mobile.Version" Placeholder="2.4.1" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Min Required Version</label>
                        <SfTextBox @bind-Value="_mobile.MinVersion" Placeholder="2.0.0" />
                    </div>
                </div>
                <div class="pwl-toggle-section">
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_mobile.BiometricEnabled" /> Enable biometric login</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_mobile.PushEnabled" /> Enable push notifications</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_mobile.OfflineMode" /> Enable offline policy view</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_mobile.ForceUpdate" /> Force update when min version not met</label>
                </div>
            </div>
            <div class="pwl-panel">
                <div class="pwl-panel-hdr"><i class="bi bi-bar-chart" aria-hidden="true"></i> Mobile App Metrics</div>
                <div class="pwl-metric-list">
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">Total Installs</span><span class="pwl-metric-val">847</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">iOS / Android Split</span><span class="pwl-metric-val">61% / 39%</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">DAU (Last 30d avg)</span><span class="pwl-metric-val">214</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">Push Opt-In Rate</span><span class="pwl-metric-val">78%</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">Biometric Adoption</span><span class="pwl-metric-val">64%</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">Avg Session Length</span><span class="pwl-metric-val">3m 12s</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">COI Requests via App</span><span class="pwl-metric-val">312</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">Payments via App</span><span class="pwl-metric-val">$148,200</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">App Store Rating (iOS)</span><span class="pwl-metric-val">4.8 ★</span></div>
                </div>
            </div>
        </div>
    </div>
}
else if (_activeTab == "chat")
{
    <div class="pwl-tab-content">
        <div class="pwl-two-col">
            <div class="pwl-panel">
                <div class="pwl-panel-hdr"><i class="bi bi-robot" aria-hidden="true"></i> Embedded Chat &amp; AI Help Assistant</div>
                <div class="pwl-form-grid">
                    <div class="pwl-field pwl-field--full">
                        <label class="pwl-lbl">Assistant Name</label>
                        <SfTextBox @bind-Value="_chat.AssistantName" Placeholder="e.g. Aria, Alex, Agency Assistant" />
                    </div>
                    <div class="pwl-field pwl-field--full">
                        <label class="pwl-lbl">Welcome Message</label>
                        <SfTextBox @bind-Value="_chat.WelcomeMessage" Multiline="true" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Chat Widget Color</label>
                        <div class="pwl-color-row">
                            <input type="color" class="pwl-color-inp" @bind="_chat.WidgetColor" />
                            <SfTextBox @bind-Value="_chat.WidgetColor" />
                        </div>
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Widget Position</label>
                        <SfDropDownList TValue="string" TItem="Lv" DataSource="_posOpts" Width="100%" @bind-Value="_chat.Position">
                            <DropDownListFieldSettings Value="V" Text="L" />
                        </SfDropDownList>
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Escalation Email</label>
                        <SfTextBox @bind-Value="_chat.EscalationEmail" Placeholder="support@agency.com" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Office Hours (for live handoff)</label>
                        <SfTextBox @bind-Value="_chat.OfficeHours" Placeholder="Mon–Fri, 8am–5pm CT" />
                    </div>
                </div>
                <div class="pwl-toggle-section">
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_chat.Enabled" /> Enable chat widget on portal</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_chat.AiEnabled" /> Enable AI-powered responses (AgencyBinder AI)</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_chat.LiveHandoff" /> Enable live agent handoff</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_chat.ShowOnMobile" /> Show on mobile app</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_chat.AllowFileAttachments" /> Allow file attachments in chat</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_chat.TranscriptEmail" /> Email chat transcript to client after session</label>
                </div>
                <div class="pwl-panel-sub-hdr">AI Knowledge Base Sources</div>
                <div class="pwl-cap-list">
                    @foreach (var kb in _kbSources)
                    {
                        <label class="pwl-cap-row @(kb.On ? "pwl-cap-row--on" : "")">
                            <input type="checkbox" class="pwl-chk" checked="@kb.On" @onchange="() => kb.On = !kb.On" />
                            <i class="bi @kb.Icon pwl-cap-icon" aria-hidden="true"></i>
                            <span>@kb.Name</span>
                        </label>
                    }
                </div>
            </div>
            <div class="pwl-panel">
                <div class="pwl-panel-hdr"><i class="bi bi-bar-chart" aria-hidden="true"></i> Chat Performance (Last 30 Days)</div>
                <div class="pwl-metric-list">
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">Total Sessions</span><span class="pwl-metric-val">@_chatSessions</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">AI Resolved (no handoff)</span><span class="pwl-metric-val">74%</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">Live Handoffs</span><span class="pwl-metric-val">182</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">Avg. Resolution Time</span><span class="pwl-metric-val">1m 48s</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">CSAT Score</span><span class="pwl-metric-val">4.6 / 5.0</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">Top Topic — COI Request</span><span class="pwl-metric-val">28%</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">Top Topic — Policy Question</span><span class="pwl-metric-val">22%</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">Top Topic — Billing</span><span class="pwl-metric-val">19%</span></div>
                    <div class="pwl-metric-row"><span class="pwl-metric-lbl">Containment Rate</span><span class="pwl-metric-val">74%</span></div>
                </div>
                <div class="pwl-chat-preview">
                    <div class="pwl-cp-hdr" style="background:@_chat.WidgetColor">
                        <i class="bi bi-robot" aria-hidden="true"></i> @_chat.AssistantName
                    </div>
                    <div class="pwl-cp-body">
                        <div class="pwl-cp-bubble pwl-cp-bubble--bot">@_chat.WelcomeMessage</div>
                        <div class="pwl-cp-bubble pwl-cp-bubble--user">How do I request a certificate?</div>
                        <div class="pwl-cp-bubble pwl-cp-bubble--bot">I can help! Go to <strong>Requests → COI Request</strong> in the portal or tap the button below. I'll pre-fill your account info. 🎉</div>
                    </div>
                    <div class="pwl-cp-footer"><input class="pwl-cp-input" placeholder="Type a message…" readonly /></div>
                </div>
            </div>
        </div>
    </div>
}
else if (_activeTab == "access")
{
    <div class="pwl-tab-content">
        <div class="pwl-two-col">
            <div class="pwl-panel">
                <div class="pwl-panel-hdr"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> SSO &amp; Authentication</div>
                <div class="pwl-form-grid">
                    <div class="pwl-field pwl-field--full">
                        <label class="pwl-lbl">Identity Provider</label>
                        <SfDropDownList TValue="string" TItem="Lv" DataSource="_idpOpts" Width="100%" @bind-Value="_access.Idp">
                            <DropDownListFieldSettings Value="V" Text="L" />
                        </SfDropDownList>
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">SSO Entity / Client ID</label>
                        <SfTextBox @bind-Value="_access.ClientId" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">SSO Metadata URL</label>
                        <SfTextBox @bind-Value="_access.MetadataUrl" Placeholder="https://idp.example.com/metadata" />
                    </div>
                    <div class="pwl-field pwl-field--full">
                        <label class="pwl-lbl">Allowed Redirect URIs (comma-separated)</label>
                        <SfTextBox @bind-Value="_access.RedirectUris" Multiline="true" />
                    </div>
                </div>
                <div class="pwl-toggle-section">
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_access.SsoEnabled" /> Enable SSO for portal login</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_access.MfaRequired" /> Require MFA for all portal users</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_access.AllowSocialLogin" /> Allow Google / Microsoft social login</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_access.AutoProvision" /> Auto-provision portal users from SSO claims</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_access.SessionTimeout" /> Enable session timeout (30 min inactivity)</label>
                </div>
            </div>
            <div class="pwl-panel">
                <div class="pwl-panel-hdr"><i class="bi bi-shield-check" aria-hidden="true"></i> Security Policies</div>
                <div class="pwl-form-grid">
                    <div class="pwl-field">
                        <label class="pwl-lbl">Password Min. Length</label>
                        <SfNumericTextBox TValue="int" @bind-Value="_access.PwdMinLength" Min="8" Max="32" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Session Timeout (minutes)</label>
                        <SfNumericTextBox TValue="int" @bind-Value="_access.SessionTimeoutMins" Min="10" Max="480" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Max Failed Login Attempts</label>
                        <SfNumericTextBox TValue="int" @bind-Value="_access.MaxFailedAttempts" Min="3" Max="10" />
                    </div>
                    <div class="pwl-field">
                        <label class="pwl-lbl">Account Lockout Duration (min)</label>
                        <SfNumericTextBox TValue="int" @bind-Value="_access.LockoutMins" Min="5" Max="1440" />
                    </div>
                </div>
                <div class="pwl-toggle-section">
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_access.RequireUppercase" /> Require uppercase in passwords</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_access.RequireSpecialChar" /> Require special character in passwords</label>
                    <label class="pwl-toggle-row"><input type="checkbox" class="pwl-chk" @bind="_access.IpWhitelistEnabled" /> Enable IP whitelist for admin portal users</label>
                </div>
            </div>
        </div>
    </div>
}

<!-- Publish confirm dialog -->
<SfDialog @bind-Visible="_showPublishConfirm" Width="420px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="pwl-dlg-hdr"><i class="bi bi-cloud-upload" aria-hidden="true"></i> Publish Portal Changes</span></Header>
        <Content>
            <p style="padding:.4rem .2rem">This will apply all saved branding, capability, and chat settings to your <strong>live</strong> insured portal. Clients will see the new configuration immediately.</p>
        </Content>
        <FooterTemplate>
            <div class="pwl-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showPublishConfirm = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="PublishAsync">
                    <i class="bi bi-cloud-upload" aria-hidden="true"></i> Publish Now
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    private SfToast? _toast;
    private string _activeTab = "portal";
    private bool _showPublishConfirm;

    private string _portalStatus = "Live";
    private string _appStatus    = "Published";
    private string _chatStatus   = "Active";
    private int    _chatSessions = 704;

    private PortalConfig  _portal = new();
    private MobileAppCfg  _mobile = new();
    private ChatConfig    _chat   = new();
    private AccessConfig  _access = new();

    private List<CapItem> _portalCaps = [];
    private List<CapItem> _kbSources  = [];

    private static readonly List<Lv> _posOpts = [new("bottom-right","Bottom Right"), new("bottom-left","Bottom Left")];
    private static readonly List<Lv> _idpOpts = [new("none","None — Password only"), new("okta","Okta"), new("azure","Microsoft Entra ID"), new("google","Google Workspace"), new("saml","Generic SAML 2.0"), new("oidc","Generic OIDC")];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Portal","/portal/users"), new("White-Label",""));
        _portal = new PortalConfig { Domain="portal.sullivanagency.com", Title="Sullivan Agency Client Portal", PrimaryColor="#1d4ed8", AccentColor="#059669", HidePoweredBy=true, EnableAnnouncements=true, EnableCrossSellWidget=true };
        _mobile = new MobileAppCfg { AppName="Sullivan Agency App", IosBundleId="com.sullivanagency.client", AndroidPackage="com.sullivanagency.client", Version="2.4.1", MinVersion="2.0.0", BiometricEnabled=true, PushEnabled=true, OfflineMode=true };
        _chat   = new ChatConfig { AssistantName="Aria", WelcomeMessage="Hi there! I'm Aria, your agency assistant. I can help with COI requests, policy questions, payments, and more. How can I help today?", WidgetColor="#1d4ed8", Position="bottom-right", Enabled=true, AiEnabled=true, LiveHandoff=true, ShowOnMobile=true, EscalationEmail="support@sullivanagency.com", OfficeHours="Mon–Fri, 8am–5pm CT" };
        _access = new AccessConfig { Idp="none", MfaRequired=false, AllowSocialLogin=true, SessionTimeout=true, PwdMinLength=10, SessionTimeoutMins=30, MaxFailedAttempts=5, LockoutMins=15, RequireUppercase=true, RequireSpecialChar=true };
        _portalCaps =
        [
            new CapItem("Request COI",              "bi-file-earmark-text",   On:true),
            new CapItem("Request Policy Change",    "bi-pencil-square",        On:true),
            new CapItem("Upload Documents",          "bi-cloud-arrow-up",       On:true),
            new CapItem("Pay Invoice",              "bi-credit-card",          On:true),
            new CapItem("Download ID Card",         "bi-person-vcard",         On:true),
            new CapItem("Secure Messaging",         "bi-chat-lock",            On:true),
            new CapItem("Renewal Questionnaire",    "bi-clipboard-check",      On:true),
            new CapItem("E-Sign Documents",         "bi-pen",                  On:true),
            new CapItem("Claim Intake (FNOL)",      "bi-exclamation-circle",   On:false),
            new CapItem("View Billing History",     "bi-receipt",              On:true),
            new CapItem("Track Service Requests",   "bi-list-check",           On:true),
        ];
        _kbSources =
        [
            new CapItem("Policy FAQs",               "bi-question-circle",     On:true),
            new CapItem("Coverage Definitions",      "bi-book",                On:true),
            new CapItem("Agency Documents Library",  "bi-folder2",             On:true),
            new CapItem("Carrier Knowledge Articles","bi-shield-check",        On:true),
            new CapItem("Billing & Payment Help",    "bi-receipt",             On:true),
            new CapItem("Claims Process Guide",      "bi-exclamation-circle",  On:false),
        ];
    }

    private async Task SaveAsync()
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = "All portal settings saved.", CssClass = "e-toast-success" });
    }

    private async Task PublishAsync()
    {
        _showPublishConfirm = false;
        _portalStatus = "Live";
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = "Portal changes published — clients see your new configuration now.", CssClass = "e-toast-success" });
    }

