@using Ams.Application.Common.Dtos

<div class="profile-shell">
    <header class="profile-header">
        <div>
            <span class="profile-eyebrow">Customer risk inventory</span>
            <h2>Account Risk Profile</h2>
            <p>Account-owned exposures and open service work synchronized from the customer record.</p>
        </div>
        <div class="profile-total">
            <span>Total scheduled value</span>
            <strong>@Data.Metrics.TotalScheduledValue.ToString("C0")</strong>
        </div>
    </header>

    <section class="metric-grid" aria-label="Account exposure summary">
        <Account360ProfileMetric Label="Locations" Value="Data.Metrics.LocationCount" Icon="bi-geo-alt" />
        <Account360ProfileMetric Label="Properties" Value="Data.Metrics.PropertyCount" Icon="bi-buildings" />
        <Account360ProfileMetric Label="Vehicles" Value="Data.Metrics.VehicleCount" Icon="bi-truck" />
        <Account360ProfileMetric Label="Drivers" Value="Data.Metrics.DriverCount" Icon="bi-person-vcard" />
        <Account360ProfileMetric Label="Scheduled items" Value="Data.Metrics.ScheduleItemCount" Icon="bi-list-check" />
        <Account360ProfileMetric Label="Open tasks" Value="Data.Metrics.OpenTaskCount" Icon="bi-check2-square" />
    </section>

    <div class="profile-grid">
        <Account360ProfileCard Title="Locations" Icon="bi-geo-alt" Count="Data.Locations.Count">
        @if (Data.Locations.Count == 0)
        {
            <Account360ProfileEmpty Title="No locations recorded" Detail="Operating, mailing, garaging, and insured locations appear here." />
        }
        else
        {
            @foreach (var item in Data.Locations.OrderBy(x => x.LocationNumber))
            {
                <Account360ProfileRow Title="@($"{item.LocationNumber} · {item.LocationName}")" Detail="@($"{item.AddressLine1}, {item.City}, {item.StateCode} {item.PostalCode}")" Meta="@OptionName("LocationType", item.LocationTypeCode)" Highlighted="item.IsPrimary" />
            }
        }
        </Account360ProfileCard>

        <Account360ProfileCard Title="Properties" Icon="bi-buildings" Count="Data.Properties.Count">
        @if (Data.Properties.Count == 0)
        {
            <Account360ProfileEmpty Title="No property exposures" Detail="Buildings, contents, business income, and protection details appear here." />
        }
        else
        {
            @foreach (var item in Data.Properties.OrderBy(x => x.PropertyNumber))
            {
                <Account360ProfileRow Title="@($"{item.PropertyNumber} · {OptionName("PropertyType", item.PropertyTypeCode)}")" Detail="@($"Building {Money(item.BuildingValue)} · Contents {Money(item.ContentsValue)}")" Meta="@(item.YearBuilt.HasValue ? $"Built {item.YearBuilt} · {item.SquareFeet?.ToString("N0") ?? "-"} sq ft" : "Property exposure")" />
            }
        }
        </Account360ProfileCard>

        <Account360ProfileCard Title="Vehicles" Icon="bi-truck" Count="Data.Vehicles.Count">
        @if (Data.Vehicles.Count == 0)
        {
            <Account360ProfileEmpty Title="No vehicle exposures" Detail="Customer-owned and scheduled vehicles appear here." />
        }
        else
        {
            @foreach (var item in Data.Vehicles.OrderBy(x => x.VehicleNumber))
            {
                <Account360ProfileRow Title="@($"{item.VehicleNumber} · {item.ModelYear} {item.Make} {item.Model}")" Detail="@($"VIN {item.Vin}")" Meta="@OptionName("VehicleUse", item.UseTypeCode)" Highlighted="item.IsActive" />
            }
        }
        </Account360ProfileCard>

        <Account360ProfileCard Title="Drivers" Icon="bi-person-vcard" Count="Data.Drivers.Count">
        @if (Data.Drivers.Count == 0)
        {
            <Account360ProfileEmpty Title="No drivers recorded" Detail="Licensed and excluded drivers associated with the account appear here." />
        }
        else
        {
            @foreach (var item in Data.Drivers.OrderBy(x => x.DriverNumber))
            {
                <Account360ProfileRow Title="@($"{item.DriverNumber} · {item.FirstName} {item.LastName}")" Detail="@($"{item.LicenseStateCode} {item.LicenseNumber}")" Meta="@OptionName("DriverStatus", item.DriverStatusCode)" Highlighted="item.IsExcluded" Badge="@(item.IsExcluded ? "Excluded" : null)" />
            }
        }
        </Account360ProfileCard>

        <Account360ProfileCard Title="Scheduled Items" Icon="bi-list-check" Count="Data.ScheduleItems.Count">
        @if (Data.ScheduleItems.Count == 0)
        {
            <Account360ProfileEmpty Title="No scheduled items" Detail="Equipment, inland marine, fine arts, jewelry, and other scheduled property appear here." />
        }
        else
        {
            @foreach (var item in Data.ScheduleItems.OrderBy(x => x.ItemNumber))
            {
                <Account360ProfileRow Title="@($"{item.ItemNumber} · {item.ItemDescription}")" Detail="@item.ScheduledValue.ToString("C0")" Meta="@OptionName("ScheduleType", item.ScheduleTypeCode)" Highlighted="item.IsActive" />
            }
        }
        </Account360ProfileCard>

        <Account360ProfileCard Title="Open Work" Icon="bi-check2-square" Count="OpenTasks.Count">
        @if (OpenTasks.Count == 0)
        {
            <Account360ProfileEmpty Title="No open account tasks" Detail="Service, claims, billing, certificate, and renewal tasks appear here." />
        }
        else
        {
            @foreach (var item in OpenTasks)
            {
                <Account360ProfileRow Title="@($"{item.TaskNumber} · {item.Title}")" Detail="@($"Due {item.DueDate?.ToString("d") ?? "not set"}")" Meta="@($"{item.PriorityCode} · {item.StatusCode}")" />
            }
        }
        </Account360ProfileCard>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Account360Dto Data { get; set; } = default!;
    [Parameter] public Func<string, string, string>? ResolveOptionName { get; set; }

    private IReadOnlyList<TaskItemDto> OpenTasks => Data.Tasks
        .Where(task => task.StatusCode is not ("Completed" or "Cancelled" or "Closed"))
        .OrderBy(task => task.DueDate)
        .ToList();

    private string OptionName(string group, string code) => ResolveOptionName?.Invoke(group, code) ?? code;
    private static string Money(decimal? value) => value?.ToString("C0") ?? "-";

}
