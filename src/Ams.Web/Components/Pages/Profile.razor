            _editEmergency = false;
            await ReloadAndNotify("Emergency contact updated.");
        }
        catch (Exception ex) { _eError = ex.Message; }
        finally { _saving = false; }
    }

    // ── Avatar URL ────────────────────────────────────────────────
    private async Task SaveAvatarUrlAsync()
    {
        if (_user is null || _saving) return;
        _saving = true;
        try
        {
            var req = CurrentProfileRequest();
            req.AvatarUrl = string.IsNullOrWhiteSpace(_avatarUrlInput) ? null : _avatarUrlInput.Trim();
            await Api.UpdateUserProfileAsync(_user.UserId, req);
            _editAvatarUrl = false;
            await ReloadAndNotify("Avatar image updated.");
        }
        catch { /* swallow — cosmetic field */ }
        finally { _saving = false; }
    }

    // ── Helpers ───────────────────────────────────────────────────
    private async Task ReloadAndNotify(string msg)
    {
        await LoadAsync();
        _globalMsg = msg; _globalErr = false;
        _ = Task.Delay(4000).ContinueWith(_ => InvokeAsync(() => { _globalMsg = string.Empty; StateHasChanged(); }));
    }

    private UpdateUserProfileRequest CurrentProfileRequest() => new()
    {
        UserId                = _user!.UserId,
        PhoneNumber           = _profile?.PhoneNumber,
        MobileNumber          = _profile?.MobileNumber,
        CountryCode           = _profile?.CountryCode,
        AddressLine1          = _profile?.AddressLine1,
        AddressLine2          = _profile?.AddressLine2,
        City                  = _profile?.City,
        StateProvince         = _profile?.StateProvince,
        PostalCode            = _profile?.PostalCode,
        AvatarUrl             = _profile?.AvatarUrl,
        EmergencyContactName  = _profile?.EmergencyContactName,
        EmergencyContactPhone = _profile?.EmergencyContactPhone,
    };

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : name.Length >= 1 ? name[..Math.Min(2, name.Length)].ToUpper() : "?";
    }

    private static string TypeBadge(string t) => t.ToLowerInvariant() switch
    {
        "internal" => "badge-blue",
        "external" => "badge-neutral",
        "system"   => "badge-red",
        _          => "badge-neutral",
    };

    private static string StatusBadge(string s) => s.ToLowerInvariant() switch
    {
        "active"   => "badge-green",
        "inactive" => "badge-neutral",
        "pending"  => "badge-amber",
        "locked"   => "badge-red",
        _          => "badge-neutral",
    };

    private static string? TimeZoneLabel(string? code) => _timeZones.FirstOrDefault(t => t.Code == code)?.Label;
    private static string? LocaleLabel(string? code)   => _locales.FirstOrDefault(l => l.Code == code)?.Label;

