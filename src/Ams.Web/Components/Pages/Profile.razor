@page "/profile"
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject IJSRuntime JS
@inject CurrentUserContext CurrentUser

<PageTitle>My Profile | AMS Enterprise</PageTitle>

@if (_loading)
{
    <div class="pf-loading">
        <div class="pf-spinner" aria-hidden="true"></div>
        <span>Loading profile...</span>
    </div>
}
else if (_user is null || !string.IsNullOrWhiteSpace(_loadError))
{
    <div class="pf-error">
        <i class="bi bi-person-x" aria-hidden="true"></i>
        <p>@(string.IsNullOrWhiteSpace(_loadError) ? "Profile could not be loaded." : _loadError)</p>
        <button class="ts-btn-ghost" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Retry
        </button>
    </div>
}
else
{
    <div class="pf-page">

        <!-- -- Page Header ------------------------------------ -->
        <div class="page-header">
            <div>
                <h1 class="page-title">
                    <i class="bi bi-person-circle" aria-hidden="true"></i> My Profile
                </h1>
                <p class="page-subtitle">Manage your DB-backed personal information, contact details, security status, and preferences.</p>
            </div>
            <div class="page-actions">
                @if (_anyEditing)
                {
                    <span class="pf-editing-badge">
                        <i class="bi bi-pencil" aria-hidden="true"></i> Editing in progress
                    </span>
                }
            </div>
        </div>

        <!-- -- Global save feedback --------------------------- -->
        @if (!string.IsNullOrEmpty(_globalMsg))
        {
            <div class="pf-global-bar ts-feedback @(_globalErr ? "ts-feedback-err" : "ts-feedback-ok")"
                 role="status">
                <i class="bi @(_globalErr ? "bi-x-circle" : "bi-check-circle-fill")" aria-hidden="true"></i>
                @_globalMsg
            </div>
        }

        <!-- -- Two-column layout ------------------------------ -->
        <div class="pf-layout">

            <!-- --- Sidebar ----------------------------------- -->
            <aside class="pf-sidebar">

                <!-- Avatar card -->
                <div class="pf-avatar-card card">
                    <div class="pf-avatar-display">
                        <div class="pf-avatar-circle"
                             style="background:@_avatarColor;"
                             aria-label="Avatar for @_user.FullName">
                            @Initials(_user.FullName)
                        </div>
                        <div class="pf-avatar-meta">
                            <div class="pf-av-name">@_user.FullName</div>
                            @if (!string.IsNullOrEmpty(_user.DisplayName) && _user.DisplayName != _user.FullName)
                            {
                                <div class="pf-av-sub">@_user.DisplayName</div>
                            }
                            @if (!string.IsNullOrEmpty(_user.JobTitle))
                            {
                                <div class="pf-av-sub">@_user.JobTitle</div>
                            }
                            <div class="pf-av-badges">
                                <span class="badge @TypeBadge(_user.UserTypeCode)">@_user.UserTypeCode</span>
                                <span class="badge @StatusBadge(_user.StatusCode)">@_user.StatusCode</span>
                            </div>
                        </div>
                    </div>

                    <div class="pf-color-section">
                        <span class="pf-color-label">Avatar color</span>
                        @if (!_editAvatarColor)
                        {
                            <div class="pf-avatar-url-row">
                                <span class="pf-avatar-url-val">@DisplayValue(_profile?.AvatarColor)</span>
                                <button class="pf-url-edit-btn"
                                        title="Edit avatar color"
                                        @onclick="OpenAvatarColor">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <EditForm Model="_avatarColorForm" OnValidSubmit="SaveAvatarColorAsync" class="pf-avatar-url-edit pf-validated-form">
                                <DataAnnotationsValidator />
                                <input class="um-input" type="color" @bind="_avatarColorForm.AvatarColor" />
                                <ValidationMessage For="() => _avatarColorForm.AvatarColor" class="text-danger" />
                                <div class="pf-avatar-url-actions">
                                    <button type="button" class="ts-btn-ghost" @onclick="() => _editAvatarColor = false">Cancel</button>
                                    <button type="submit" class="ts-btn-primary" disabled="@_saving">
                                        @if (_saving) { <span class="ts-spin" aria-hidden="true"></span> }
                                        Save
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>

                    <div class="pf-avatar-url-section">
                        <span class="pf-color-label">Avatar image URL <span class="pf-optional">(optional)</span></span>
                        @if (!_editAvatarUrl)
                        {
                            <div class="pf-avatar-url-row">
                                <span class="pf-avatar-url-val pf-ellipsis" title="@(_profile?.AvatarUrl ?? "")">
                                    @(string.IsNullOrEmpty(_profile?.AvatarUrl) ? "None set" : _profile.AvatarUrl)
                                </span>
                                <button class="pf-url-edit-btn"
                                        title="Edit avatar URL"
                                         @onclick="OpenAvatarUrl">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <EditForm Model="_avatarUrlForm" OnValidSubmit="SaveAvatarUrlAsync" class="pf-avatar-url-edit pf-validated-form">
                                <DataAnnotationsValidator />
                                <InputText class="ld-input pf-enterprise-input" type="url" @bind-Value="_avatarUrlForm.AvatarUrl" placeholder="https://example.com/avatar.png" />
                                <ValidationMessage For="() => _avatarUrlForm.AvatarUrl" class="text-danger" />
                                <div class="pf-avatar-url-actions">
                                    <button type="button" class="ts-btn-ghost" @onclick="() => _editAvatarUrl = false">Cancel</button>
                                    <button type="submit" class="ts-btn-primary" disabled="@_saving">
                                        @if (_saving) { <span class="ts-spin" aria-hidden="true"></span> }
                                        Save
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>
                </div>

                <!-- Account summary card -->
                <div class="pf-info-card card">
                    <div class="pf-card-hd">
                        <i class="bi bi-shield" aria-hidden="true"></i> Account
                    </div>
                    <dl class="ts-dl">
                        <div class="ts-dl-row">
                            <dt>Username</dt>
                            <dd><code class="ts-id">@_user.UserName</code></dd>
                        </div>
                        <div class="ts-dl-row">
                            <dt>Email</dt>
                            <dd>
                                <span class="pf-ellipsis" title="@_user.Email">@_user.Email</span>
                            </dd>
                        </div>
                        <div class="ts-dl-row">
                            <dt>Member Since</dt>
                            <dd>@_user.CreatedDateUtc.ToString("MMMM yyyy")</dd>
                        </div>
                        <div class="ts-dl-row">
                            <dt>Last Login</dt>
                            <dd>@(_user.LastLoginDateUtc?.ToString("MMM d, yyyy") ?? "Never")</dd>
                        </div>
                        <div class="ts-dl-row">
                            <dt>SMS 2FA</dt>
                            <dd>
                                <span class="badge @(_user.MfaEnabled ? "badge-green" : "badge-amber")">
                                    @(_user.MfaEnabled ? "Required" : "Optional")
                                </span>
                            </dd>
                        </div>
                        <div class="ts-dl-row">
                            <dt>Password</dt>
                            <dd>@(_user.PasswordChangedDateUtc?.ToString("MMM d, yyyy") ?? "Not recorded")</dd>
                        </div>
                        <div class="ts-dl-row">
                            <dt>Lockout</dt>
                            <dd>@(_user.IsLockedOut ? $"Locked until {_user.LockoutEndDateUtc?.ToString("MMM d, yyyy h:mm tt")}" : "Not locked")</dd>
                        </div>
                        <div class="ts-dl-row">
                            <dt>Roles</dt>
                            <dd>
                                @_user.AssignedRoleCount assigned
                            </dd>
                        </div>
                    </dl>
                </div>

            </aside>

            <!-- --- Main ---------------------------------------- -->
            <div class="pf-main">

                <!-- -- Personal Information --------------------- -->
                <section class="pf-section card" aria-label="Personal Information">
                    <div class="pf-card-hd">
                        <div class="pf-card-title">
                            <i class="bi bi-person" aria-hidden="true"></i> Personal Information
                        </div>
                        @if (!_editPersonal)
                        {
                            <button class="ts-edit-btn" @onclick="OpenPersonal">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                            </button>
                        }
                    </div>
                    <div class="card-body">
                        @if (!_editPersonal)
                        {
                            <div class="pf-field-grid">
                                <div class="pf-field">
                                    <div class="pf-field-label">Full Name</div>
                                    <div class="pf-field-value">@_user.FullName</div>
                                </div>
                                <div class="pf-field">
                                    <div class="pf-field-label">Display Name</div>
                                    <div class="pf-field-value">@DisplayValue(_user.DisplayName)</div>
                                </div>
                                <div class="pf-field">
                                    <div class="pf-field-label">Username</div>
                                    <div class="pf-field-value">
                                        <code class="ts-id">@_user.UserName</code>
                                        <span class="pf-ro-tag">read-only</span>
                                    </div>
                                </div>
                                <div class="pf-field">
                                    <div class="pf-field-label">Email</div>
                                    <div class="pf-field-value">
                                        <a href="mailto:@_user.Email">@_user.Email</a>
                                        <span class="pf-ro-tag">read-only</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <EditForm Model="_pForm" OnValidSubmit="SavePersonalAsync" class="ts-edit-form pf-validated-form">
                                <DataAnnotationsValidator />
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Full Name <span class="req" aria-hidden="true">*</span></label>
                                        <InputText class="ld-input pf-enterprise-input" @bind-Value="_pForm.FullName" placeholder="John Doe" />
                                        <ValidationMessage For="() => _pForm.FullName" class="text-danger" />
                                    </div>
                                    <div class="form-group">
                                        <label>Display Name <span class="pf-optional">(optional)</span></label>
                                        <InputText class="ld-input pf-enterprise-input" @bind-Value="_pForm.DisplayName" placeholder="e.g. Johnny" />
                                        <ValidationMessage For="() => _pForm.DisplayName" class="text-danger" />
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Username</label>
                                        <input class="ld-input pf-enterprise-input" value="@_user.UserName" disabled />
                                        <span class="field-hint">Username cannot be changed here.</span>
                                    </div>
                                    <div class="form-group">
                                        <label>Email</label>
                                        <input class="ld-input pf-enterprise-input" type="email" value="@_user.Email" disabled />
                                        <span class="field-hint">Contact your administrator to update your email.</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(_pError))
                                {
                                    <div class="form-alert" role="alert">
                                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i> @_pError
                                    </div>
                                }
                                <div class="ts-edit-actions">
                                    <button type="button" class="ts-btn-ghost" @onclick="CancelPersonal">Cancel</button>
                                    <button type="submit" class="ts-btn-primary" disabled="@_saving">
                                        @if (_saving) { <span class="ts-spin" aria-hidden="true"></span> }
                                        Save Changes
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>
                </section>

                <!-- -- Contact Information ---------------------- -->
                <section class="pf-section card" aria-label="Contact Information">
                    <div class="pf-card-hd">
                        <div class="pf-card-title">
                            <i class="bi bi-telephone" aria-hidden="true"></i> Contact Information
                        </div>
                        @if (!_editContact)
                        {
                            <button class="ts-edit-btn" @onclick="OpenContact">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                            </button>
                        }
                    </div>
                    <div class="card-body">
                        @if (!_editContact)
                        {
                            <div class="pf-field-grid">
                                <div class="pf-field">
                                    <div class="pf-field-label">Phone Number</div>
                                    <div class="pf-field-value">
                                        @if (!string.IsNullOrEmpty(_user.PhoneNumber))
                                        {
                                            <i class="bi bi-telephone" aria-hidden="true"></i>
                                            <a href="tel:@_user.PhoneNumber">@_user.PhoneNumber</a>
                                        }
                                        else
                                        {
                                            <span class="pf-no-val">Not provided</span>
                                        }
                                    </div>
                                </div>
                                <div class="pf-field">
                                    <div class="pf-field-label">Mobile Number</div>
                                    <div class="pf-field-value">
                                        @if (!string.IsNullOrEmpty(_profile?.MobileNumber))
                                        {
                                            <i class="bi bi-phone" aria-hidden="true"></i>
                                            <a href="tel:@_profile.MobileNumber">@_profile.MobileNumber</a>
                                        }
                                        else
                                        {
                                            <span class="pf-no-val">Not provided</span>
                                        }
                                    </div>
                                </div>
                                <div class="pf-field">
                                    <div class="pf-field-label">Email Address</div>
                                    <div class="pf-field-value">
                                        <i class="bi bi-envelope" aria-hidden="true"></i>
                                        <a href="mailto:@_user.Email">@_user.Email</a>
                                        <span class="pf-ro-tag">read-only</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <EditForm Model="_cForm" OnValidSubmit="SaveContactAsync" class="ts-edit-form pf-validated-form">
                                <DataAnnotationsValidator />
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Phone Number</label>
                                        <InputText class="ld-input pf-enterprise-input" type="tel" @bind-Value="_cForm.PhoneNumber" @bind-Value:after="OnProfilePhoneChanged" placeholder="(555) 123-4567" />
                                        @if (!string.IsNullOrWhiteSpace(_cForm.PhoneNumber))
                                        {
                                            <span class="@PhoneHintClass(_cForm.PhoneNumber)">@PhoneStatusText(_cForm.PhoneNumber)</span>
                                        }
                                    </div>
                                    <div class="form-group">
                                        <label>Mobile Number <span class="pf-optional">(optional)</span></label>
                                        <InputText class="ld-input pf-enterprise-input" type="tel" @bind-Value="_cForm.MobileNumber" @bind-Value:after="OnProfileMobileChanged" placeholder="(555) 123-4567" />
                                        @if (!string.IsNullOrWhiteSpace(_cForm.MobileNumber))
                                        {
                                            <span class="@PhoneHintClass(_cForm.MobileNumber)">@PhoneStatusText(_cForm.MobileNumber)</span>
                                        }
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Email</label>
                                        <InputText class="ld-input pf-enterprise-input" type="email" @bind-Value="_cForm.Email" disabled />
                                        <ValidationMessage For="() => _cForm.Email" class="text-danger" />
                                        <span class="field-hint">Contact your administrator to update your email.</span>
                                    </div>
                                    <div class="form-group"></div>
                                </div>
                                @if (!string.IsNullOrEmpty(_cError))
                                {
                                    <div class="form-alert" role="alert">
                                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i> @_cError
                                    </div>
                                }
                                <div class="ts-edit-actions">
                                    <button type="button" class="ts-btn-ghost" @onclick="CancelContact">Cancel</button>
                                    <button type="submit" class="ts-btn-primary" disabled="@_saving">
                                        @if (_saving) { <span class="ts-spin" aria-hidden="true"></span> }
                                        Save Changes
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>
                </section>

                <!-- -- Address ---------------------------------- -->
                <section class="pf-section card" aria-label="Address">
                    <div class="pf-card-hd">
                        <div class="pf-card-title">
                            <i class="bi bi-house" aria-hidden="true"></i> Address
                        </div>
                        @if (!_editAddress)
                        {
                            <button class="ts-edit-btn" @onclick="OpenAddress">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                            </button>
                        }
                    </div>
                    <div class="card-body">
                        @if (!_editAddress)
                        {
                            <div class="pf-field-grid">
                                <div class="pf-field pf-field-wide">
                                    <div class="pf-field-label">Street Address</div>
                                    <div class="pf-field-value pf-field-value-block">
                                        @if (!string.IsNullOrEmpty(_profile?.AddressLine1))
                                        {
                                            <div>@_profile.AddressLine1</div>
                                            @if (!string.IsNullOrEmpty(_profile.AddressLine2))
                                            {
                                                <div>@_profile.AddressLine2</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="pf-no-val">Not provided</span>
                                        }
                                    </div>
                                </div>
                                <div class="pf-field">
                                    <div class="pf-field-label">City</div>
                                    <div class="pf-field-value">@DisplayValue(_profile?.City)</div>
                                </div>
                                <div class="pf-field">
                                    <div class="pf-field-label">State / Province</div>
                                    <div class="pf-field-value">@DisplayValue(_profile?.StateProvince)</div>
                                </div>
                                <div class="pf-field">
                                    <div class="pf-field-label">Postal Code</div>
                                    <div class="pf-field-value">@DisplayValue(_profile?.PostalCode)</div>
                                </div>
                                <div class="pf-field">
                                    <div class="pf-field-label">Country</div>
                                    <div class="pf-field-value">@DisplayValue(_profile?.CountryCode)</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <EditForm Model="_aForm" OnValidSubmit="SaveAddressAsync" class="ts-edit-form pf-validated-form">
                                <DataAnnotationsValidator />
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Address Line 1</label>
                                        <InputText class="ld-input pf-enterprise-input" @bind-Value="_aForm.AddressLine1" placeholder="Street address" />
                                        <ValidationMessage For="() => _aForm.AddressLine1" class="text-danger" />
                                    </div>
                                    <div class="form-group">
                                        <label>Address Line 2 <span class="pf-optional">(optional)</span></label>
                                        <InputText class="ld-input pf-enterprise-input" @bind-Value="_aForm.AddressLine2" placeholder="Suite, unit, etc." />
                                        <ValidationMessage For="() => _aForm.AddressLine2" class="text-danger" />
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>City</label>
                                        <InputText class="ld-input pf-enterprise-input" @bind-Value="_aForm.City" placeholder="City" />
                                        <ValidationMessage For="() => _aForm.City" class="text-danger" />
                                    </div>
                                    <div class="form-group">
                                        <label>State / Province</label>
                                        <InputText class="ld-input pf-enterprise-input" @bind-Value="_aForm.StateProvince" placeholder="State or province" />
                                        <ValidationMessage For="() => _aForm.StateProvince" class="text-danger" />
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Postal Code</label>
                                        <InputText class="ld-input pf-enterprise-input" @bind-Value="_aForm.PostalCode" placeholder="00000" />
                                        <ValidationMessage For="() => _aForm.PostalCode" class="text-danger" />
                                    </div>
                                    <div class="form-group">
                                        <label>Country Code</label>
                                        <InputText class="ld-input pf-enterprise-input" @bind-Value="_aForm.CountryCode" placeholder="US" />
                                        <ValidationMessage For="() => _aForm.CountryCode" class="text-danger" />
                                        <span class="field-hint">2-letter ISO country code (e.g. US, GB, AU)</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(_aError))
                                {
                                    <div class="form-alert" role="alert">
                                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i> @_aError
                                    </div>
                                }
                                <div class="ts-edit-actions">
                                    <button type="button" class="ts-btn-ghost" @onclick="CancelAddress">Cancel</button>
                                    <button type="submit" class="ts-btn-primary" disabled="@_saving">
                                        @if (_saving) { <span class="ts-spin" aria-hidden="true"></span> }
                                        Save Changes
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>
                </section>

                <!-- -- Work & Organization ---------------------- -->
                <section class="pf-section card" aria-label="Work and Organization">
                    <div class="pf-card-hd">
                        <div class="pf-card-title">
                            <i class="bi bi-building" aria-hidden="true"></i> Work &amp; Organization
                        </div>
                        @if (!_editOrg)
                        {
                            <button class="ts-edit-btn" @onclick="OpenOrg">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                            </button>
                        }
                    </div>
                    <div class="card-body">
                        @if (!_editOrg)
                        {
                            <div class="pf-field-grid">
                                <div class="pf-field">
                                    <div class="pf-field-label">Job Title</div>
                                    <div class="pf-field-value">@DisplayValue(_user.JobTitle)</div>
                                </div>
                                <div class="pf-field">
                                    <div class="pf-field-label">Department</div>
                                    <div class="pf-field-value">@DisplayValue(_user.Department)</div>
                                </div>
                                <div class="pf-field pf-field-wide">
                                    <div class="pf-field-label">Branch</div>
                                    <div class="pf-field-value pf-field-value-block">
                                        @if (_branch is not null)
                                        {
                                            <div class="pf-branch-chip">
                                                <div class="pf-branch-icon">
                                                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                                </div>
                                                <div class="pf-branch-body">
                                                    <div class="pf-branch-name">@_branch.BranchName</div>
                                                    @{
                                                        var loc = string.Join(", ", new[] { _branch.City, _branch.StateProvince }
                                                            .Where(x => !string.IsNullOrEmpty(x)));
                                                    }
                                                    @if (!string.IsNullOrEmpty(loc))
                                                    {
                                                        <div class="pf-branch-sub">
                                                            @loc
                                                            @if (!string.IsNullOrEmpty(_branch.CountryCode))
                                                            { <span class="pf-branch-cc">@_branch.CountryCode</span> }
                                                        </div>
                                                    }
                                                </div>
                                                <span class="pf-ro-tag">read-only</span>
                                            </div>
                                        }
                                        else if (_user.BranchId.HasValue)
                                        {
                                            <code class="ts-id">@_user.BranchId</code>
                                            <span class="pf-ro-tag">read-only</span>
                                        }
                                        else
                                        {
                                            <span class="pf-no-val">No branch assigned</span>
                                        }
                                    </div>
                                </div>
                                @if (_branch is not null && !string.IsNullOrEmpty(_branch.StateProvince))
                                {
                                    <div class="pf-field">
                                        <div class="pf-field-label">Region</div>
                                        <div class="pf-field-value">
                                            <i class="bi bi-map" aria-hidden="true"></i>
                                            @_branch.StateProvince
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <EditForm Model="_oForm" OnValidSubmit="SaveOrgAsync" class="ts-edit-form pf-validated-form">
                                <DataAnnotationsValidator />
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Job Title</label>
                                        <InputText class="ld-input pf-enterprise-input" @bind-Value="_oForm.JobTitle" placeholder="e.g. Senior Account Manager" />
                                        <ValidationMessage For="() => _oForm.JobTitle" class="text-danger" />
                                    </div>
                                    <div class="form-group">
                                        <label>Department</label>
                                        <InputText class="ld-input pf-enterprise-input" @bind-Value="_oForm.Department" placeholder="e.g. Sales" />
                                        <ValidationMessage For="() => _oForm.Department" class="text-danger" />
                                    </div>
                                </div>
                                @if (_branch is not null)
                                {
                                    <div class="pf-org-branch-row">
                                        <div class="pf-org-branch-lbl">
                                            Branch <span class="pf-ro-tag">assigned by administrator</span>
                                        </div>
                                        <div class="pf-branch-chip">
                                            <div class="pf-branch-icon">
                                                <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                            </div>
                                            <div class="pf-branch-body">
                                                <div class="pf-branch-name">@_branch.BranchName</div>
                                                @{
                                                    var locEdit = string.Join(", ", new[] { _branch.City, _branch.StateProvince }
                                                        .Where(x => !string.IsNullOrEmpty(x)));
                                                }
                                                @if (!string.IsNullOrEmpty(locEdit))
                                                {
                                                    <div class="pf-branch-sub">@locEdit</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_oError))
                                {
                                    <div class="form-alert" role="alert">
                                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i> @_oError
                                    </div>
                                }
                                <div class="ts-edit-actions">
                                    <button type="button" class="ts-btn-ghost" @onclick="CancelOrg">Cancel</button>
                                    <button type="submit" class="ts-btn-primary" disabled="@_saving">
                                        @if (_saving) { <span class="ts-spin" aria-hidden="true"></span> }
                                        Save Changes
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>
                </section>

                <!-- -- Localization ----------------------------- -->
                <section class="pf-section card" aria-label="Localization">
                    <div class="pf-card-hd">
                        <div class="pf-card-title">
                            <i class="bi bi-globe" aria-hidden="true"></i> Localization &amp; Preferences
                        </div>
                        @if (!_editLocale)
                        {
                            <button class="ts-edit-btn" @onclick="OpenLocale">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                            </button>
                        }
                    </div>
                    <div class="card-body">
                        @if (!_editLocale)
                        {
                            <div class="pf-field-grid">
                                <div class="pf-field">
                                    <div class="pf-field-label">Time Zone</div>
                                    <div class="pf-field-value">
                                        <i class="bi bi-clock" aria-hidden="true"></i>
                                        @DisplayValue(_user.TimeZoneCode)
                                    </div>
                                </div>
                                <div class="pf-field">
                                    <div class="pf-field-label">Locale</div>
                                    <div class="pf-field-value">
                                        <i class="bi bi-translate" aria-hidden="true"></i>
                                        @DisplayValue(LocaleLabel(_user.LocaleCode) ?? _user.LocaleCode)
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <EditForm Model="_lForm" OnValidSubmit="SaveLocaleAsync" class="ts-edit-form pf-validated-form">
                                <DataAnnotationsValidator />
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Time Zone</label>
                                        <InputSelect class="ld-input pf-enterprise-input" @bind-Value="_lForm.TimeZoneCode">
                                            <option value="">Select time zone</option>
                                            @foreach (var timeZone in _timeZones)
                                            {
                                                <option value="@timeZone.Code">@timeZone.Label</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="() => _lForm.TimeZoneCode" class="text-danger" />
                                    </div>
                                    <div class="form-group">
                                        <label>Locale</label>
                                        <InputSelect class="ld-input pf-enterprise-input" @bind-Value="_lForm.LocaleCode">
                                            <option value="">Select locale</option>
                                            @foreach (var locale in _localeOptions)
                                            {
                                                <option value="@locale.Code">@locale.Label</option>
                                            }
                                        </InputSelect>
                                        <ValidationMessage For="() => _lForm.LocaleCode" class="text-danger" />
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(_lError))
                                {
                                    <div class="form-alert" role="alert">
                                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i> @_lError
                                    </div>
                                }
                                <div class="ts-edit-actions">
                                    <button type="button" class="ts-btn-ghost" @onclick="CancelLocale">Cancel</button>
                                    <button type="submit" class="ts-btn-primary" disabled="@_saving">
                                        @if (_saving) { <span class="ts-spin" aria-hidden="true"></span> }
                                        Save Preferences
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>
                </section>

                <!-- -- Emergency Contact ----------------------- -->
                <section class="pf-section card" aria-label="Emergency Contact">
                    <div class="pf-card-hd">
                        <div class="pf-card-title">
                            <i class="bi bi-heart-pulse" aria-hidden="true"></i> Emergency Contact
                        </div>
                        @if (!_editEmergency)
                        {
                            <button class="ts-edit-btn" @onclick="OpenEmergency">
                                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                            </button>
                        }
                    </div>
                    <div class="card-body">
                        @if (!_editEmergency)
                        {
                            <div class="pf-field-grid">
                                <div class="pf-field">
                                    <div class="pf-field-label">Contact Name</div>
                                    <div class="pf-field-value">
                                        @if (!string.IsNullOrEmpty(_profile?.EmergencyContactName))
                                        {
                                            <i class="bi bi-person" aria-hidden="true"></i>
                                            @_profile.EmergencyContactName
                                        }
                                        else
                                        {
                                            <span class="pf-no-val">Not provided</span>
                                        }
                                    </div>
                                </div>
                                <div class="pf-field">
                                    <div class="pf-field-label">Contact Phone</div>
                                    <div class="pf-field-value">
                                        @if (!string.IsNullOrEmpty(_profile?.EmergencyContactPhone))
                                        {
                                            <i class="bi bi-telephone" aria-hidden="true"></i>
                                            <a href="tel:@_profile.EmergencyContactPhone">@_profile.EmergencyContactPhone</a>
                                        }
                                        else
                                        {
                                            <span class="pf-no-val">Not provided</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <EditForm Model="_eForm" OnValidSubmit="SaveEmergencyAsync" class="ts-edit-form pf-validated-form">
                                <DataAnnotationsValidator />
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Contact Name</label>
                                        <InputText class="ld-input pf-enterprise-input" @bind-Value="_eForm.Name" placeholder="Full name" />
                                        <ValidationMessage For="() => _eForm.Name" class="text-danger" />
                                    </div>
                                    <div class="form-group">
                                        <label>Contact Phone</label>
                                        <InputText class="ld-input pf-enterprise-input" type="tel" @bind-Value="_eForm.Phone" @bind-Value:after="OnEmergencyPhoneChanged" placeholder="(555) 123-4567" />
                                        @if (!string.IsNullOrWhiteSpace(_eForm.Phone))
                                        {
                                            <span class="@PhoneHintClass(_eForm.Phone)">@PhoneStatusText(_eForm.Phone)</span>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(_eError))
                                {
                                    <div class="form-alert" role="alert">
                                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i> @_eError
                                    </div>
                                }
                                <div class="ts-edit-actions">
                                    <button type="button" class="ts-btn-ghost" @onclick="CancelEmergency">Cancel</button>
                                    <button type="submit" class="ts-btn-primary" disabled="@_saving">
                                        @if (_saving) { <span class="ts-spin" aria-hidden="true"></span> }
                                        Save Changes
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>
                </section>

            </div>
        </div>
    </div>
}

@code {
    private Guid? _currentUserId;
    private Guid? _tenantId;

    // -- Page state ------------------------------------------------
    private UserDto?        _user;
    private BranchDto?      _branch;
    private UserProfileDto? _profile;
    private List<LocaleItem> _localeOptions = [];
    private bool            _loading     = true;
    private bool            _saving;
    private string          _avatarColor = "#2563eb";
    private string?         _loadError;

    // -- Edit section toggles --------------------------------------
    private bool   _editPersonal;
    private bool   _editContact;
    private bool   _editOrg;
    private bool   _editLocale;
    private bool   _editAddress;
    private bool   _editEmergency;
    private bool   _editAvatarUrl;
    private bool   _editAvatarColor;
    private AvatarUrlForm _avatarUrlForm = new();
    private AvatarColorForm _avatarColorForm = new();
    private bool   _anyEditing => _editPersonal || _editContact || _editOrg || _editLocale || _editAddress || _editEmergency;

    // -- Per-section error messages --------------------------------
    private string _pError    = string.Empty;
    private string _cError    = string.Empty;
    private string _oError    = string.Empty;
    private string _lError    = string.Empty;
    private string _aError    = string.Empty;
    private string _eError    = string.Empty;
    private string _globalMsg = string.Empty;
    private bool   _globalErr;

    // -- Section form models ---------------------------------------
    private PersonalForm         _pForm = new();
    private ContactForm          _cForm = new();
    private OrgForm              _oForm = new();
    private LocaleForm           _lForm = new();
    private AddressForm          _aForm = new();
    private EmergencyContactForm _eForm = new();

    // -- Lifecycle -------------------------------------------------
    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var context = await CurrentUser.GetAsync();
            if (context is null)
            {
                _user = null;
                _profile = null;
                _branch = null;
                return;
            }

            _currentUserId = context.UserId;
            _tenantId = context.TenantId;
            _user    = await Api.GetUserByIdAsync(context.UserId);
            _profile = await Api.GetUserProfileAsync(context.UserId);
            _avatarColor = NormalizeAvatarColor(_profile?.AvatarColor);
            _avatarColorForm.AvatarColor = _avatarColor;
            if (_user is not null && _user.BranchId.HasValue)
            {
                var branches = await Api.SearchBranchesAsync(context.TenantId);
                _branch = branches?.Items.FirstOrDefault(b => b.BranchId == _user.BranchId);
            }

            var localeResult = await Api.SearchSupportedLocalesAsync(pageSize: 500);
            _localeOptions = localeResult?.Items
                .Where(l => l.IsActive)
                .OrderBy(l => l.LocaleName)
                .Select(l => new LocaleItem(l.LocaleCode, string.IsNullOrWhiteSpace(l.NativeName) ? l.LocaleName : $"{l.LocaleName} ({l.NativeName})"))
                .ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = $"Profile load failed: {ex.Message}";
            _globalMsg = _loadError;
            _globalErr = true;
        }
        finally { _loading = false; }
    }

    // -- Personal section ------------------------------------------
    private void OpenPersonal()
    {
        _pForm        = new() { FullName = _user!.FullName, DisplayName = _user.DisplayName };
        _pError       = string.Empty;
        _editPersonal = true;
    }
    private void CancelPersonal() { _editPersonal = false; _pError = string.Empty; }

    private async Task SavePersonalAsync()
    {
        if (_user is null || _saving) return;
        if (string.IsNullOrWhiteSpace(_pForm.FullName)) { _pError = "Full Name is required."; return; }
        _saving = true;
        try
        {
            await Api.UpdateUserAsync(_user.UserId, new UpdateUserRequest
            {
                UserId       = _user.UserId,
                FullName     = _pForm.FullName.Trim(),
                DisplayName  = _pForm.DisplayName?.Trim(),
                PhoneNumber  = _user.PhoneNumber,
                JobTitle     = _user.JobTitle,
                Department   = _user.Department,
                TimeZoneCode = _user.TimeZoneCode,
                LocaleCode   = _user.LocaleCode,
            });
            _editPersonal = false;
            await ReloadAndNotify("Personal information updated.");
        }
        catch (Exception ex) { _pError = ex.Message; }
        finally { _saving = false; }
    }

    // -- Contact section -------------------------------------------
    private void OpenContact()
    {
        _cForm       = new() { PhoneNumber = _user!.PhoneNumber, MobileNumber = _profile?.MobileNumber, Email = _user.Email };
        _cError      = string.Empty;
        _editContact = true;
    }
    private void CancelContact() { _editContact = false; _cError = string.Empty; }

    private async Task SaveContactAsync()
    {
        if (_user is null || _saving) return;
        _saving = true;
        try
        {
            await Api.UpdateUserAsync(_user.UserId, new UpdateUserRequest
            {
                UserId       = _user.UserId,
                FullName     = _user.FullName,
                DisplayName  = _user.DisplayName,
                PhoneNumber  = NormalizePhone(_cForm.PhoneNumber),
                JobTitle     = _user.JobTitle,
                Department   = _user.Department,
                TimeZoneCode = _user.TimeZoneCode,
                LocaleCode   = _user.LocaleCode,
            });
            var req = CurrentProfileRequest();
            req.MobileNumber = NormalizePhone(_cForm.MobileNumber);
            await Api.UpdateUserProfileAsync(_user.UserId, req);
            _editContact = false;
            await ReloadAndNotify("Contact information updated.");
        }
        catch (Exception ex) { _cError = ex.Message; }
        finally { _saving = false; }
    }

    // -- Organization section --------------------------------------
    private void OpenOrg()
    {
        _oForm   = new() { JobTitle = _user!.JobTitle, Department = _user.Department };
        _oError  = string.Empty;
        _editOrg = true;
    }
    private void CancelOrg() { _editOrg = false; _oError = string.Empty; }

    private async Task SaveOrgAsync()
    {
        if (_user is null || _saving) return;
        _saving = true;
        try
        {
            await Api.UpdateUserAsync(_user.UserId, new UpdateUserRequest
            {
                UserId       = _user.UserId,
                FullName     = _user.FullName,
                DisplayName  = _user.DisplayName,
                PhoneNumber  = _user.PhoneNumber,
                JobTitle     = _oForm.JobTitle?.Trim(),
                Department   = _oForm.Department?.Trim(),
                TimeZoneCode = _user.TimeZoneCode,
                LocaleCode   = _user.LocaleCode,
            });
            _editOrg = false;
            await ReloadAndNotify("Work information updated.");
        }
        catch (Exception ex) { _oError = ex.Message; }
        finally { _saving = false; }
    }

    // -- Localization section --------------------------------------
    private void OpenLocale()
    {
        _lForm      = new() { TimeZoneCode = _user!.TimeZoneCode ?? "UTC", LocaleCode = _user.LocaleCode ?? "en-US" };
        _lError     = string.Empty;
        _editLocale = true;
    }
    private void CancelLocale() { _editLocale = false; _lError = string.Empty; }

    private async Task SaveLocaleAsync()
    {
        if (_user is null || _saving) return;
        _saving = true;
        try
        {
            await Api.UpdateUserAsync(_user.UserId, new UpdateUserRequest
            {
                UserId       = _user.UserId,
                FullName     = _user.FullName,
                DisplayName  = _user.DisplayName,
                PhoneNumber  = _user.PhoneNumber,
                JobTitle     = _user.JobTitle,
                Department   = _user.Department,
                TimeZoneCode = _lForm.TimeZoneCode,
                LocaleCode   = _lForm.LocaleCode,
            });
            _editLocale = false;
            await ReloadAndNotify("Localization preferences updated.");
        }
        catch (Exception ex) { _lError = ex.Message; }
        finally { _saving = false; }
    }

    // -- Address section -------------------------------------------
    private void OpenAddress()
    {
        _aForm = new()
        {
            AddressLine1  = _profile?.AddressLine1,
            AddressLine2  = _profile?.AddressLine2,
            City          = _profile?.City,
            StateProvince = _profile?.StateProvince,
            PostalCode    = _profile?.PostalCode,
            CountryCode   = _profile?.CountryCode,
        };
        _aError      = string.Empty;
        _editAddress = true;
    }
    private void CancelAddress() { _editAddress = false; _aError = string.Empty; }

    private async Task SaveAddressAsync()
    {
        if (_user is null || _saving) return;
        _saving = true;
        try
        {
            var req = CurrentProfileRequest();
            req.AddressLine1  = _aForm.AddressLine1?.Trim();
            req.AddressLine2  = _aForm.AddressLine2?.Trim();
            req.City          = _aForm.City?.Trim();
            req.StateProvince = _aForm.StateProvince?.Trim();
            req.PostalCode    = _aForm.PostalCode?.Trim();
            req.CountryCode   = _aForm.CountryCode?.Trim();
            await Api.UpdateUserProfileAsync(_user.UserId, req);
            _editAddress = false;
            await ReloadAndNotify("Address updated.");
        }
        catch (Exception ex) { _aError = ex.Message; }
        finally { _saving = false; }
    }

    // -- Emergency Contact section ---------------------------------
    private void OpenEmergency()
    {
        _eForm = new() { Name = _profile?.EmergencyContactName, Phone = _profile?.EmergencyContactPhone };
        _eError        = string.Empty;
        _editEmergency = true;
    }
    private void CancelEmergency() { _editEmergency = false; _eError = string.Empty; }

    private async Task SaveEmergencyAsync()
    {
        if (_user is null || _saving) return;
        _saving = true;
        try
        {
            var req = CurrentProfileRequest();
            req.EmergencyContactName  = _eForm.Name?.Trim();
            req.EmergencyContactPhone = NormalizePhone(_eForm.Phone);
            await Api.UpdateUserProfileAsync(_user.UserId, req);
            _editEmergency = false;
            await ReloadAndNotify("Emergency contact updated.");
        }
        catch (Exception ex) { _eError = ex.Message; }
        finally { _saving = false; }
    }

    // -- Avatar URL ------------------------------------------------
    private void OpenAvatarUrl()
    {
        _avatarUrlForm = new() { AvatarUrl = _profile?.AvatarUrl ?? string.Empty };
        _globalMsg = string.Empty;
        _editAvatarUrl = true;
    }

    private void OpenAvatarColor()
    {
        _avatarColorForm = new() { AvatarColor = NormalizeAvatarColor(_profile?.AvatarColor ?? _avatarColor) };
        _globalMsg = string.Empty;
        _editAvatarColor = true;
    }

    private async Task SaveAvatarUrlAsync()
    {
        if (_user is null || _saving) return;
        _saving = true;
        try
        {
            var req = CurrentProfileRequest();
            req.AvatarUrl = string.IsNullOrWhiteSpace(_avatarUrlForm.AvatarUrl) ? null : _avatarUrlForm.AvatarUrl.Trim();
            await Api.UpdateUserProfileAsync(_user.UserId, req);
            _editAvatarUrl = false;
            await ReloadAndNotify("Avatar image updated.");
        }
        catch (Exception ex) { _globalMsg = $"Avatar image update failed: {ex.Message}"; _globalErr = true; }
        finally { _saving = false; }
    }

    private async Task SaveAvatarColorAsync()
    {
        if (_user is null || _saving) return;
        _saving = true;
        try
        {
            var req = CurrentProfileRequest();
            req.AvatarColor = NormalizeAvatarColor(_avatarColorForm.AvatarColor);
            await Api.UpdateUserProfileAsync(_user.UserId, req);
            _editAvatarColor = false;
            await ReloadAndNotify("Avatar color updated.");
        }
        catch (Exception ex) { _globalMsg = $"Avatar color update failed: {ex.Message}"; _globalErr = true; }
        finally { _saving = false; }
    }

    // -- Helpers ---------------------------------------------------
    private async Task ReloadAndNotify(string msg)
    {
        await LoadAsync();
        _globalMsg = msg; _globalErr = false;
        _ = Task.Delay(4000).ContinueWith(_ => InvokeAsync(() => { _globalMsg = string.Empty; StateHasChanged(); }));
    }

    private UpdateUserProfileRequest CurrentProfileRequest() => new()
    {
        UserId                = _user!.UserId,
        PhoneNumber           = _profile?.PhoneNumber,
        MobileNumber          = _profile?.MobileNumber,
        CountryCode           = _profile?.CountryCode,
        AddressLine1          = _profile?.AddressLine1,
        AddressLine2          = _profile?.AddressLine2,
        City                  = _profile?.City,
        StateProvince         = _profile?.StateProvince,
        PostalCode            = _profile?.PostalCode,
        AvatarUrl             = _profile?.AvatarUrl,
        AvatarColor           = _profile?.AvatarColor,
        EmergencyContactName  = _profile?.EmergencyContactName,
        EmergencyContactPhone = _profile?.EmergencyContactPhone,
    };

    private static string DisplayValue(string? value) => string.IsNullOrWhiteSpace(value) ? "Not provided" : value;

    private static string NormalizeAvatarColor(string? value) =>
        !string.IsNullOrWhiteSpace(value) && value.StartsWith('#') && value.Length is 4 or 7 ? value : "#2563eb";

    private void OnProfilePhoneChanged()
    {
        if (IsPhoneValid(_cForm.PhoneNumber))
        {
            _cForm.PhoneNumber = NormalizePhone(_cForm.PhoneNumber) ?? string.Empty;
        }
    }

    private void OnProfileMobileChanged()
    {
        if (IsPhoneValid(_cForm.MobileNumber))
        {
            _cForm.MobileNumber = NormalizePhone(_cForm.MobileNumber) ?? string.Empty;
        }
    }

    private void OnEmergencyPhoneChanged()
    {
        if (IsPhoneValid(_eForm.Phone))
        {
            _eForm.Phone = NormalizePhone(_eForm.Phone) ?? string.Empty;
        }
    }

    private static string PhoneStatusText(string? value) => IsPhoneValid(value)
        ? $"Phone formatted as {NormalizePhone(value)}"
        : "Enter a valid 10-digit phone number.";

    private static string PhoneHintClass(string? value) => IsPhoneValid(value)
        ? "ld-field-hint ld-hint-good"
        : "ld-field-hint ld-hint-bad";

    private static bool IsPhoneValid(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return true;
        var digits = new string(value.Where(char.IsDigit).ToArray());
        if (digits.Length == 11 && digits[0] == '1') digits = digits[1..];
        return digits.Length == 10;
    }

    private static string? NormalizePhone(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        var digits = new string(value.Where(char.IsDigit).ToArray());
        if (digits.Length == 11 && digits[0] == '1') digits = digits[1..];
        return digits.Length == 10 ? $"({digits[..3]}) {digits.Substring(3, 3)}-{digits[6..]}" : value.Trim();
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : name.Length >= 1 ? name[..Math.Min(2, name.Length)].ToUpper() : "?";
    }

    private static string TypeBadge(string t) => t.ToLowerInvariant() switch
    {
        "internal" => "badge-blue",
        "external" => "badge-neutral",
        "system"   => "badge-red",
        _          => "badge-neutral",
    };

    private static string StatusBadge(string s) => s.ToLowerInvariant() switch
    {
        "active"   => "badge-green",
        "inactive" => "badge-neutral",
        "pending"  => "badge-amber",
        "locked"   => "badge-red",
        _          => "badge-neutral",
    };

    private static string? TimeZoneLabel(string? code) => _timeZones.FirstOrDefault(t => t.Code == code)?.Label;
    private string? LocaleLabel(string? code)   => _localeOptions.FirstOrDefault(l => l.Code == code)?.Label;

    // -- Form models -----------------------------------------------
    private sealed class PersonalForm
    {
        [Required, StringLength(200)] public string FullName { get; set; } = string.Empty;
        [StringLength(200)] public string? DisplayName { get; set; }
    }

    private sealed class ContactForm
    {
        [Required, AmsEmailAddress, StringLength(200)] public string Email { get; set; } = string.Empty;
        [AmsPhone, StringLength(30)] public string? PhoneNumber { get; set; }
        [AmsPhone, StringLength(30)] public string? MobileNumber { get; set; }
    }

    private sealed class OrgForm
    {
        [StringLength(150)] public string? JobTitle { get; set; }
        [StringLength(150)] public string? Department { get; set; }
    }

    private sealed class LocaleForm
    {
        [Required, StringLength(100)] public string TimeZoneCode { get; set; } = "UTC";
        [Required, StringLength(20)] public string LocaleCode { get; set; } = "en-US";
    }

    private sealed class AddressForm
    {
        [StringLength(300)] public string? AddressLine1 { get; set; }
        [StringLength(300)] public string? AddressLine2 { get; set; }
        [StringLength(150)] public string? City { get; set; }
        [StringLength(150)] public string? StateProvince { get; set; }
        [StringLength(30)] public string? PostalCode { get; set; }
        [StringLength(10)] public string? CountryCode { get; set; }
    }

    private sealed class EmergencyContactForm
    {
        [StringLength(200)] public string? Name { get; set; }
        [AmsPhone, StringLength(40)] public string? Phone { get; set; }
    }

    private sealed class AvatarUrlForm
    {
        [Url, StringLength(1000)] public string? AvatarUrl { get; set; }
    }

    private sealed class AvatarColorForm
    {
        [Required, RegularExpression("^#[0-9A-Fa-f]{6}$", ErrorMessage = "Enter a valid 6-digit hex color.")]
        public string AvatarColor { get; set; } = "#2563eb";
    }

    private sealed record TzItem(string Code, string Label);
    private sealed record LocaleItem(string Code, string Label);

