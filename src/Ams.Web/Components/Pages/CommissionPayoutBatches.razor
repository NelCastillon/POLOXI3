@page "/commissions/payout-batches"
@inject ApiClient Api

<PageTitle>Commission Payout Batches</PageTitle>

<h1>Commission Payout Batches</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(CommissionPayoutBatchDto.BatchReference)" HeaderText="Batch Reference" Width="200"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutBatchDto.PayPeriodStart)" HeaderText="Period Start" Type="ColumnType.Date" Format="d" Width="140"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutBatchDto.PayPeriodEnd)" HeaderText="Period End" Type="ColumnType.Date" Format="d" Width="140"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutBatchDto.TotalAmount)" HeaderText="Total Amount" Format="C2" Width="150"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutBatchDto.PayoutCount)" HeaderText="Count" Width="100"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutBatchDto.StatusCode)" HeaderText="Status" Width="120"></GridColumn>
            <GridColumn Field="@nameof(CommissionPayoutBatchDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="g" Width="180"></GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<CommissionPayoutBatchDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchCommissionPayoutBatchesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<CommissionPayoutBatchDto>();
    }
}
