@page "/renewals/review"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Renewal Review Board ? AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<AppPageHeader Title="Renewal Review Board"
               Subtitle="Team kanban view ? move accounts through the renewal pipeline"
               Icon="bi-kanban">
    <Actions>
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => _viewMode = "board"'
                title="Board view">
            <i class="bi bi-kanban @(_viewMode == "board" ? "rrb-view-active" : "")" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => _viewMode = "list"'
                title="List view">
            <i class="bi bi-list-ul @(_viewMode == "list" ? "rrb-view-active" : "")" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-ghost" @onclick="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-ghost" @onclick="ExportAsync">
            <i class="bi bi-download" aria-hidden="true"></i> Export
        </button>
    </Actions>
</AppPageHeader>

<!-- -- SUMMARY KPI STRIP -------------------------------------------- -->
<div class="rrb-kpi-strip">
    <div class="rrb-kpi-card">
        <div class="rrb-kpi-val">@_items.Count</div>
        <div class="rrb-kpi-lbl"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Total Active</div>
    </div>
    <div class="rrb-kpi-card rrb-kpi-urgent">
        <div class="rrb-kpi-val">@_items.Count(i => i.DaysToExpiry <= 30 && i.Stage is not "Renewed" and not "Lost" and not "Non-Renewed")</div>
        <div class="rrb-kpi-lbl"><i class="bi bi-alarm-fill" aria-hidden="true"></i> Expires &lt; 30 days</div>
    </div>
    <div class="rrb-kpi-card rrb-kpi-risk">
        <div class="rrb-kpi-val">@_items.Count(i => i.RiskScore >= 70)</div>
        <div class="rrb-kpi-lbl"><i class="bi bi-shield-exclamation" aria-hidden="true"></i> High Risk</div>
    </div>
    <div class="rrb-kpi-card rrb-kpi-prem">
        <div class="rrb-kpi-val">@_items.Where(i => i.Stage is not "Renewed" and not "Lost" and not "Non-Renewed").Sum(i => i.CurrentPremium).ToString("C0")</div>
        <div class="rrb-kpi-lbl"><i class="bi bi-currency-dollar" aria-hidden="true"></i> Premium at Stake</div>
    </div>
    <div class="rrb-kpi-card rrb-kpi-renewed">
        <div class="rrb-kpi-val">@RetentionPct%</div>
        <div class="rrb-kpi-lbl"><i class="bi bi-graph-up" aria-hidden="true"></i> Retention Rate</div>
    </div>
    <div class="rrb-kpi-card">
        <div class="rrb-kpi-val">@_items.Count(i => i.OpenTasks > 0)</div>
        <div class="rrb-kpi-lbl"><i class="bi bi-list-check" aria-hidden="true"></i> With Open Tasks</div>
    </div>
</div>

<!-- -- FILTER BAR -------------------------------------------------- -->
<div class="rrb-filter-bar">
    <input class="e-input rrb-search" @bind="_search" @bind:event="oninput"
           placeholder="Search account, policy #, producer?" />
    <select class="e-input rrb-filter-sel" @bind="_lobFilter">
        <option value="">All Lines</option>
        @foreach (var l in _lobs) { <option>@l</option> }
    </select>
    <select class="e-input rrb-filter-sel" @bind="_producerFilter">
        <option value="">All Producers</option>
        @foreach (var p in _producers) { <option>@p</option> }
    </select>
    <select class="e-input rrb-filter-sel" @bind="_branchFilter">
        <option value="">All Branches</option>
        @foreach (var b in _branches) { <option>@b</option> }
    </select>
    <select class="e-input rrb-filter-sel" @bind="_riskFilter">
        <option value="">All Risk Levels</option>
        <option value="high">High Risk (70+)</option>
        <option value="med">Medium Risk (40?69)</option>
        <option value="low">Low Risk (&lt;40)</option>
    </select>
    <label class="rrb-filter-lbl">Expiry:</label>
    <select class="e-input rrb-filter-sel rrb-days-sel" @bind="_daysFilter">
        <option value="0">All</option>
        <option value="30">= 30 days</option>
        <option value="60">= 60 days</option>
        <option value="90">= 90 days</option>
    </select>
    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters">
        <i class="bi bi-x" aria-hidden="true"></i> Reset
    </button>
    <span class="rrb-filter-count">@Filtered.Count() record(s)</span>
</div>

@if (_viewMode == "board")
{
    <!-- -- KANBAN BOARD -------------------------------------------- -->
    <div class="rrb-board">
        @foreach (var col in _columns)
        {
            var colItems = Filtered.Where(i => i.Stage == col.Stage).ToList();
            <div class="rrb-col">
                <div class="rrb-col-hdr rrb-col-hdr-@col.CssKey">
                    <span class="rrb-col-title">@col.Stage</span>
                    <span class="rrb-col-badge">@colItems.Count</span>
                    @if (col.PremLabel)
                    {
                        <span class="rrb-col-prem">@colItems.Sum(i => i.CurrentPremium).ToString("C0")</span>
                    }
                </div>
                <div class="rrb-col-body">
                    @foreach (var item in colItems.OrderBy(i => i.DaysToExpiry))
                    {
                        <div class="rrb-card @(item.RiskScore >= 70 ? "rrb-card-high" : item.RiskScore >= 40 ? "rrb-card-med" : "")
                                   @(item.DaysToExpiry <= 30 ? "rrb-card-urgent" : "")">
                            <!-- Card top row -->
                            <div class="rrb-card-top">
                                <div class="rrb-card-lob rrb-lob-@LobKey(item.Lob)">
                                    <i class="bi @LobIcon(item.Lob)" aria-hidden="true"></i>
                                </div>
                                <div class="rrb-card-info">
                                    <button class="rrb-card-acct" @onclick="() => OpenRenewal(item)">@item.AccountName</button>
                                    <div class="rrb-card-pol">@item.PolicyNumber</div>
                                </div>
                                <span class="rrb-risk-badge rrb-risk-@RiskCss(item.RiskScore)" title="AI Risk Score">
                                    @item.RiskScore
                                </span>
                            </div>
                            <!-- Expiry + premium row -->
                            <div class="rrb-card-meta-row">
                                <span class="rrb-days-chip rrb-days-@DaysCss(item.DaysToExpiry)">
                                    <i class="bi bi-clock" aria-hidden="true"></i>@DaysLabel(item.DaysToExpiry)
                                </span>
                                <span class="rrb-card-prem">@item.CurrentPremium.ToString("C0")</span>
                            </div>
                            <!-- Signal dots row -->
                            <div class="rrb-card-signals">
                                @foreach (var sig in item.SignalSummary)
                                {
                                    <span class="rrb-sig-dot rrb-sig-@sig.Level" title="@sig.Label: @sig.Score"></span>
                                }
                            </div>
                            <!-- Footer: producer + tasks + actions -->
                            <div class="rrb-card-footer">
                                <span class="rrb-card-producer">
                                    <i class="bi bi-person-badge" aria-hidden="true"></i>@item.Producer
                                </span>
                                @if (item.OpenTasks > 0)
                                {
                                    <span class="rrb-task-badge @(item.HasOverdueTasks ? "rrb-task-overdue" : "")">
                                        <i class="bi bi-list-check" aria-hidden="true"></i>@item.OpenTasks
                                    </span>
                                }
                                <div class="rrb-card-actions">
                                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenRenewal(item)"
                                            title="Open renewal"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i></button>
                                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => MoveStage(item, col.NextStage)"
                                            title="Advance stage" disabled="@string.IsNullOrEmpty(col.NextStage)">
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    @if (!colItems.Any())
                    {
                        <div class="rrb-col-empty">
                            <i class="bi bi-inbox" aria-hidden="true"></i>
                            <span>No renewals</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- -- LIST VIEW ----------------------------------------------- -->
    <div class="rrb-list-wrap">
        <AppGrid TValue="BoardItem" DataSource="@Filtered.ToList()"
                AllowSorting="true" AllowPaging="true" AllowResizing="true"
                AllowFiltering="true" EnableHover="true" RowHeight="56">
            
            
            <GridColumns>
                <GridColumn Field="@nameof(BoardItem.AccountName)" HeaderText="Account" MinWidth="200">
                    <Template>
                        @{ var i = (BoardItem)context; }
                        <div class="rdb-acct-cell">
                            <button class="rdb-acct-link" @onclick="() => OpenRenewal(i)">@i.AccountName</button>
                            <div class="rdb-acct-meta">@i.PolicyNumber ? @i.Lob</div>
                        </div>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(BoardItem.Stage)" HeaderText="Stage" Width="145">
                    <Template>
                        @{ var i = (BoardItem)context; }
                        <span class="rd-stage rd-st-@StageCss(i.Stage)">@i.Stage</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(BoardItem.DaysToExpiry)" HeaderText="Expiry" Width="115">
                    <Template>
                        @{ var i = (BoardItem)context; }
                        <div class="rdb-exp-cell">
                            <span class="rdb-exp-date">@i.ExpiryDate.ToString("MM/dd/yyyy")</span>
                            <span class="rdb-days-badge @DaysBadgeCss(i.DaysToExpiry)">@DaysLabel(i.DaysToExpiry)</span>
                        </div>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(BoardItem.RiskScore)" HeaderText="AI Risk" Width="110">
                    <Template>
                        @{ var i = (BoardItem)context; }
                        <div class="rdb-risk-cell">
                            <div class="rdb-risk-bar-wrap">
                                <div class="rdb-risk-bar rdb-risk-@RiskCss(i.RiskScore)" style="width:@i.RiskScore%"></div>
                            </div>
                            <span class="rdb-risk-val rdb-risk-val-@RiskCss(i.RiskScore)">@i.RiskScore</span>
                        </div>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(BoardItem.CurrentPremium)" HeaderText="Premium" Width="125"
                            TextAlign=@("Right")>
                    <Template>@{ var i = (BoardItem)context; }<span class="pd-mono">@i.CurrentPremium.ToString("C0")</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(BoardItem.LossRatio)" HeaderText="Loss Ratio" Width="110"
                            TextAlign=@("Right")>
                    <Template>
                        @{ var i = (BoardItem)context; }
                        <span class="pd-mono @(i.LossRatio >= 70 ? "pd-viol-warn" : i.LossRatio >= 40 ? "rdb-lr-warn" : "")">
                            @i.LossRatio.ToString("F0")%
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(BoardItem.Producer)"  HeaderText="Producer"  Width="140" />
                <GridColumn Field="@nameof(BoardItem.Branch)"    HeaderText="Branch"    Width="140" />
                <GridColumn Field="@nameof(BoardItem.OpenTasks)" HeaderText="Tasks"     Width="80"
                            TextAlign=@("Right")>
                    <Template>
                        @{ var i = (BoardItem)context; }
                        <span class="@(i.HasOverdueTasks ? "pd-viol-warn" : "")">@i.OpenTasks</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Move Stage" Width="145" AllowSorting="false" AllowFiltering="false">
                    <Template>
                        @{ var i = (BoardItem)context; var col = _columns.FirstOrDefault(c => c.Stage == i.Stage); }
                        <div class="rdb-row-actions">
                            <button class="um-btn um-btn-primary um-btn-xs" @onclick="() => OpenRenewal(i)">
                                <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Open
                            </button>
                            @if (!string.IsNullOrEmpty(col?.NextStage))
                            {
                                <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => MoveStage(i, col.NextStage)"
                                        title="Advance to @col.NextStage">
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </button>
                            }
                        </div>
                    </Template>
                </GridColumn>
            </GridColumns>
        </AppGrid>
    </div>
}

<!-- -- MOVE STAGE CONFIRM DIALOG -------------------------------- -->
<AppModal @bind-Visible="_showMoveDialog" Width="420px" ShowCloseIcon="true" IsModal="true">
    <DialogTemplates>
        <Header>
            <div class="pd-dlg-hdr">
                <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Advance Stage
            </div>
        </Header>
        <Content>
            <div class="pd-dlg-body">
                @if (_moveTarget is not null)
                {
                    <p class="pd-dlg-lead">
                        Move <strong>@_moveTarget.AccountName</strong> from
                        <span class="rd-stage rd-st-@StageCss(_moveTarget.Stage)">@_moveTarget.Stage</span>
                        to
                        <span class="rd-stage rd-st-@StageCss(_moveNextStage)">@_moveNextStage</span>?
                    </p>
                    <div class="pd-dlg-grid-1">
                        <label class="rrb-dlg-lbl">Notes (optional)</label>
                        <AppTextBox @bind-Value="_moveNotes" Placeholder="Stage advancement reason?" Multiline="true" />
                    </div>
                }
            </div>
        </Content>
        <FooterTemplate>
            <div class="pd-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showMoveDialog = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="ConfirmMove">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Confirm
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</AppModal>

@code {
    EnterpriseToast _toast = default!;

    string _search         = "";
    string _lobFilter      = "";
    string _producerFilter = "";
    string _branchFilter   = "";
    string _riskFilter     = "";
    int    _daysFilter     = 0;
    string _viewMode       = "board";

    bool       _showMoveDialog = false;
    BoardItem? _moveTarget     = null;
    string     _moveNextStage  = "";
    string     _moveNotes      = "";

    readonly string[] _lobs      = { "General Liability","Commercial Auto","Commercial Property","Workers Comp","Umbrella","Professional Liab.","Home/Dwelling","Personal Auto" };
    readonly string[] _producers = { "Maria Santos","James Park","Kevin Obi","Sarah Kim","Lisa Chen" };
    readonly string[] _branches  = { "Houston South","Houston North","Dallas","Austin","San Antonio" };

    sealed record ColumnDef(string Stage, string CssKey, string? NextStage, bool PremLabel);
    readonly ColumnDef[] _columns =
    {
        new("Not Started", "ns", "In Progress",      true),
        new("In Progress", "ip", "Quoted",            true),
        new("Quoted",      "qt", "Decision Pending",  true),
        new("Decision Pending","dp","Renewed",        true),
        new("Renewed",     "rn", null,                false),
        new("Lost",        "lo", null,                false),
    };

    sealed class SignalDot { public string Label { get; set; } = ""; public int Score { get; set; } public string Level => Score >= 70 ? "high" : Score >= 40 ? "med" : "low"; }

    sealed class BoardItem
    {
        public Guid     RenewalId        { get; set; }
        public Guid     PolicyId         { get; set; }
        public string   AccountName      { get; set; } = "";
        public string   PolicyNumber     { get; set; } = "";
        public string   Lob              { get; set; } = "";
        public string   Carrier          { get; set; } = "";
        public DateTime ExpiryDate       { get; set; }
        public int      DaysToExpiry     { get; set; }
        public string   Stage            { get; set; } = "";
        public int      RiskScore        { get; set; }
        public decimal  CurrentPremium   { get; set; }
        public decimal  LossRatio        { get; set; }
        public string   Producer         { get; set; } = "";
        public string   Branch           { get; set; } = "";
        public int      OpenTasks        { get; set; }
        public bool     HasOverdueTasks  { get; set; }
        public List<SignalDot> SignalSummary { get; set; } = new();
    }

    readonly List<BoardItem> _items = new();

    int RetentionPct
    {
        get
        {
            var settled = _items.Count(i => i.Stage is "Renewed" or "Lost");
            if (settled == 0) return 0;
            return _items.Count(i => i.Stage == "Renewed") * 100 / settled;
        }
    }

    IEnumerable<BoardItem> Filtered => _items.Where(i =>
        (string.IsNullOrEmpty(_search) ||
         i.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         i.PolicyNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         i.Producer.Contains(_search, StringComparison.OrdinalIgnoreCase))
     && (string.IsNullOrEmpty(_lobFilter)      || i.Lob == _lobFilter)
     && (string.IsNullOrEmpty(_producerFilter) || i.Producer == _producerFilter)
     && (string.IsNullOrEmpty(_branchFilter)   || i.Branch == _branchFilter)
     && (_riskFilter == "" || (_riskFilter == "high" && i.RiskScore >= 70) || (_riskFilter == "med" && i.RiskScore is >= 40 and < 70) || (_riskFilter == "low" && i.RiskScore < 40))
     && (_daysFilter == 0 || i.DaysToExpiry <= _daysFilter));

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Renewals","/renewals"), new("Review Board","/renewals/review"));
        await Task.Delay(0);
        BuildStub();
    }

    void BuildStub()
    {
        _items.Clear();
        _items.AddRange(new[]
        {
            MakeItem("Sullivan Mfg. LLC",    "TRV-GL-2024-00421","General Liability",  "Travelers Indemnity",  18,  "In Progress",     65, 17_250m, 28m, "Maria Santos","Houston South", 3, false, new[]{65,28,20,70,10,30,40}),
            MakeItem("Metro Freight Co.",    "HFD-CA-2024-14822","Commercial Auto",    "Hartford Fire & Cas.", 24,  "Quoted",          40, 31_500m, 55m, "James Park",  "Dallas",         1, false, new[]{40,55,35,20,15,10,25}),
            MakeItem("Bridgewater Hotels",   "LIB-GL-2024-77210","General Liability",  "Liberty Mutual",       37,  "Not Started",     82, 24_800m, 71m, "Maria Santos","Houston South", 5, true,  new[]{82,71,60,85,40,55,70}),
            MakeItem("Dallas Roofing LLC",   "CNA-WC-2024-55102","Workers Comp",       "CNA Commercial",       45,  "In Progress",     55, 9_400m,  33m, "Kevin Obi",   "Dallas",         2, false, new[]{55,33,25,60,20,45,30}),
            MakeItem("Greenleaf Nurseries",  "TRV-CP-2024-62011","Commercial Property","Travelers Indemnity",  52,  "Renewed",         20, 6_750m,  12m, "Sarah Kim",   "Austin",         0, false, new[]{20,12,10,15,5,10,8}),
            MakeItem("Apex Medical Group",   "MKL-PL-2024-28004","Professional Liab.", "Markel Corporation",   61,  "Not Started",     48, 14_200m, 5m,  "Maria Santos","Houston North",  4, true,  new[]{48,5,30,55,25,60,35}),
            MakeItem("Sun Valley Resort",    "HFD-UMB-2024-38810","Umbrella",          "Hartford Fire & Cas.", 75,  "In Progress",     35, 8_200m,  0m,  "James Park",  "San Antonio",    2, false, new[]{35,0,20,30,10,20,15}),
            MakeItem("Coastal Seafood Dist.","CNA-GL-2024-71004","General Liability",  "CNA Commercial",       88,  "Not Started",     72, 11_600m, 44m, "Kevin Obi",   "Houston South",  6, true,  new[]{72,44,55,80,35,65,60}),
            MakeItem("Pioneer Automotive",   "TRV-CA-2024-90221","Commercial Auto",    "Travelers Indemnity",  95,  "Not Started",     28, 19_800m, 22m, "Sarah Kim",   "Dallas",         0, false, new[]{28,22,15,20,5,10,12}),
            MakeItem("Crestview Elementary", "LIB-GL-2023-44008","General Liability",  "Liberty Mutual",       -5,  "Lost",            90, 7_400m,  62m, "Maria Santos","Houston North",  0, false, new[]{90,62,75,95,55,70,80}),
            MakeItem("Laredo Steel Works",   "ZUR-GL-2023-18820","General Liability",  "Zurich American",      -15, "Decision Pending",78, 22_100m, 85m, "Kevin Obi",   "San Antonio",    3, true,  new[]{78,85,65,80,45,60,70}),
            MakeItem("Harbor Tech Inc.",     "TRV-CP-2024-18801","Commercial Property","Travelers Indemnity",  28,  "Decision Pending",60, 13_500m, 38m, "James Park",  "Houston South",  2, false, new[]{60,38,40,55,20,35,45}),
        });
    }

    static BoardItem MakeItem(string acct, string polNum, string lob, string carrier,
        int days, string stage, int risk, decimal prem, decimal lr,
        string producer, string branch, int tasks, bool overdue, int[] signals)
    {
        var sigLabels = new[]{ "Prem Increase","Claims","Comm Sentiment","Outreach","Payments","Svc Backlog","Cov Gaps" };
        return new BoardItem
        {
            RenewalId    = Guid.NewGuid(), PolicyId = Guid.NewGuid(),
            AccountName  = acct, PolicyNumber = polNum, Lob = lob, Carrier = carrier,
            ExpiryDate   = DateTime.Today.AddDays(days), DaysToExpiry = days,
            Stage = stage, RiskScore = risk, CurrentPremium = prem, LossRatio = lr,
            Producer = producer, Branch = branch, OpenTasks = tasks, HasOverdueTasks = overdue,
            SignalSummary = signals.Select((s, idx) => new SignalDot { Label = sigLabels[idx], Score = s }).ToList()
        };
    }

    void ResetFilters() { _search=""; _lobFilter=""; _producerFilter=""; _branchFilter=""; _riskFilter=""; _daysFilter=0; }
    void Refresh() => BuildStub();

    void OpenRenewal(BoardItem item) => Nav.NavigateTo($"/renewals/{item.RenewalId}");

    void MoveStage(BoardItem item, string? next)
    {
        if (string.IsNullOrEmpty(next)) return;
        _moveTarget    = item;
        _moveNextStage = next;
        _moveNotes     = "";
        _showMoveDialog = true;
    }

    async Task ConfirmMove()
    {
        if (_moveTarget is null) return;
        _moveTarget.Stage = _moveNextStage;
        _showMoveDialog   = false;
        await _toast.ShowAsync(new ToastModel
        {
            Title    = "Stage Updated",
            Content  = $"{_moveTarget.AccountName} moved to {_moveNextStage}.",
            CssClass = "e-toast-success"
        });
    }

    async Task ExportAsync() =>
        await _toast.ShowAsync(new ToastModel { Title="Exported", Content="Review board exported.", CssClass="e-toast-success" });

    static string LobKey(string lob)  => lob.ToLower().Replace(" ","").Replace("/","").Replace("&","").Replace(".","").Replace("-","");
    static string LobIcon(string lob) => lob switch
    {
        "General Liability"   => "bi-shield-check",
        "Commercial Auto"     => "bi-truck",
        "Commercial Property" => "bi-building",
        "Workers Comp"        => "bi-person-fill-gear",
        "Umbrella"            => "bi-umbrella",
        "Professional Liab."  => "bi-briefcase",
        "Home/Dwelling"       => "bi-house",
        "Personal Auto"       => "bi-car-front",
        _                     => "bi-shield-half"
    };
    static string StageCss(string stage) => stage switch
    {
        "Not Started"     => "ns",
        "In Progress"     => "ip",
        "Quoted"          => "qt",
        "Decision Pending"=> "dp",
        "Renewed"         => "rn",
        "Lost"            => "lo",
        "Non-Renewed"     => "nr",
        _                 => "ns"
    };
    static string RiskCss(int score)       => score >= 70 ? "high" : score >= 40 ? "med" : "low";
    static string DaysCss(int days)        => days <= 0 ? "expired" : days <= 30 ? "red" : days <= 60 ? "amber" : "blue";
    static string DaysBadgeCss(int days)   => days <= 0 ? "rdb-db-expired" : days <= 30 ? "rdb-db-red" : days <= 60 ? "rdb-db-amber" : "rdb-db-blue";
    static string DaysLabel(int days)      => days <= 0 ? $"Expired {Math.Abs(days)}d ago" : days == 1 ? "1 day left" : $"{days}d left";
}
