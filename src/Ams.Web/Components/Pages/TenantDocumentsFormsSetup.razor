@page "/tenant/documents/categories2"
@page "/tenant/documents/templates2"
@page "/tenant/documents/acord2"
@page "/tenant/documents/esign2"
@page "/tenant/documents/packets2"
@page "/tenant/documents/retention2"
@page "/tenant/documents/ocr2"
@page "/tenant/documents/storage2"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Ams.Application.Features.DocumentConfig
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@CurrentModule.Title — AMS</PageTitle>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="tds-toast tds-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @_toastIcon" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="tds-toast-close" @onclick="ClearToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="tds-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="tds-modal" role="dialog" aria-modal="true" aria-labelledby="tds-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi @CurrentModule.Icon" aria-hidden="true"></i>
                <span id="tds-form-title">@(_editId.HasValue ? $"Edit {CurrentModule.SingularTitle}" : $"Add {CurrentModule.SingularTitle}")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_saving"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="ShowValidationToast">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="tds-modal-intro">
                        <span><i class="bi bi-database-check" aria-hidden="true"></i> Persisted in Documents.DocumentConfigItem</span>
                        <p>Update the tenant source-of-truth record used by document workflow, portal, and operations modules.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field">
                            <label>Code <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.Code" placeholder="COMMERCIAL" />
                            <ValidationMessage For="() => _form.Code" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.Name" placeholder="Commercial Lines" />
                            <ValidationMessage For="() => _form.Name" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Category</label>
                            <InputText class="form-control" @bind-Value="_form.Category" placeholder="Operations" />
                            <ValidationMessage For="() => _form.Category" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Sort Order <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_form.SortOrder" />
                            <ValidationMessage For="() => _form.SortOrder" class="text-danger" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Description</label>
                            <InputTextArea class="form-control" @bind-Value="_form.Description" rows="3" placeholder="Describe the workflow purpose and controls." />
                            <ValidationMessage For="() => _form.Description" class="text-danger" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Configuration JSON</label>
                            <InputTextArea class="form-control tds-json-input" @bind-Value="_form.ConfigurationJson" rows="6" placeholder="{}" />
                            <ValidationMessage For="() => _form.ConfigurationJson" class="text-danger" />
                        </div>
                        <div class="um-field tds-switch-field">
                            <label>
                                <InputCheckbox @bind-Value="_form.IsActive" />
                                Active record
                            </label>
                            <span>Inactive records remain visible as high-risk governance items.</span>
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_saving">Cancel</button>
                    <button type="button" class="um-btn um-btn-ghost" @onclick="ValidateJson" disabled="@_saving"><i class="bi bi-braces" aria-hidden="true"></i> Validate JSON</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        @(_editId.HasValue ? "Save Changes" : "Create")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_confirmAction is not null)
{
    <div class="tds-modal-backdrop" role="presentation" @onclick="CancelConfirm">
        <div class="tds-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="tds-confirm-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi @_confirmAction.Icon" aria-hidden="true"></i></div>
                <div class="um-confirm-content">
                    <h3 id="tds-confirm-title">@_confirmAction.Title</h3>
                    <p>@_confirmAction.Message</p>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CancelConfirm" disabled="@_saving">Cancel</button>
                    <button type="button" class="um-btn um-btn-danger" @onclick="ExecuteConfirmAsync" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        @_confirmAction.ConfirmLabel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="tds-enterprise-page">
    <section class="tds-header" aria-label="Documents and forms setup header">
        <div class="tds-header-left">
            <span class="tds-lob-icon"><i class="bi @CurrentModule.Icon" aria-hidden="true"></i></span>
            <div class="tds-header-info">
                <div class="tds-title-row">
                    <h1 class="tds-page-title">@CurrentModule.Title</h1>
                    <span class="tds-status-pill"><i class="bi bi-shield-check" aria-hidden="true"></i> Tenant source of truth</span>
                    <span class="tds-status-pill"><i class="bi bi-database" aria-hidden="true"></i> @CurrentModule.Kind</span>
                </div>
                <div class="tds-sub-row">
                    <span class="tds-sub-chip"><i class="bi bi-folder-gear" aria-hidden="true"></i> Documents & Forms Setup</span>
                    <span class="tds-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> API synced</span>
                    <span class="tds-filter-note"><i class="bi bi-funnel" aria-hidden="true"></i> @FilterLabel</span>
                </div>
                <p>@CurrentModule.Description</p>
            </div>
        </div>
        <div class="tds-header-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "tds-spin" : "")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add @CurrentModule.SingularTitle</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger tds-load-error" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i> @_loadError
        </div>
    }

    <section class="tds-kpi-strip" aria-label="Document setup metrics">
        @KpiCard("Total", FilteredBySearch.Count.ToString(), "Records in this module", CurrentModule.Icon, "tds-ki-blue", "")
        @KpiCard("Active", FilteredBySearch.Count(x => x.IsActive).ToString(), "Available in workflow", "bi-check-circle-fill", "tds-ki-green", "active")
        @KpiCard("Inactive", FilteredBySearch.Count(x => !x.IsActive).ToString(), "Needs tenant review", "bi-pause-circle", "tds-ki-amber", "inactive")
        @KpiCard("Configured", FilteredBySearch.Count(x => HasConfiguration(x)).ToString(), "JSON controls present", "bi-braces", "tds-ki-purple", "configured")
        @KpiCard("Needs Setup", FilteredBySearch.Count(x => !HasConfiguration(x)).ToString(), "Missing JSON controls", "bi-exclamation-triangle", "tds-ki-red", "needs-setup")
        @KpiCard("Categories", FilteredBySearch.Select(x => x.Category ?? "Unassigned").Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString(), "Owner/control groups", "bi-tags", "tds-ki-cyan", "")
    </section>

    <section class="tds-workflow-strip tds-workflow-strip--polished" aria-label="Documents and forms setup workflow">
        @foreach (var module in Modules)
        {
            <button type="button" class="tds-workflow-card @module.WorkflowCss @(CurrentModule.Kind == module.Kind ? "tds-workflow-card--active" : "")" @onclick="() => NavigateModule(module)">
                <span class="tds-workflow-icon"><i class="bi @module.Icon" aria-hidden="true"></i></span>
                <span class="tds-workflow-content">
                    <strong>@ModuleCount(module.Kind)</strong>
                    <span>@module.ShortTitle</span>
                    <small>@module.WorkflowCaption</small>
                </span>
            </button>
        }
    </section>

    <section class="tds-enterprise-search" aria-label="Search and filters">
        <span class="tds-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
        <div class="tds-search-body">
            <label for="tds-search">Search @CurrentModule.ShortTitle</label>
            <input id="tds-search" class="tds-search-input" type="search" placeholder="Search code, name, category, description, or JSON..." @bind="_search" @bind:event="oninput" />
            <span class="tds-search-hint">Search updates the custom table, KPI cards, and selected detail panel.</span>
        </div>
        <select class="tds-filter-select" @bind="_activeFilter" aria-label="Status filter">
            <option value="">All records</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
            <option value="configured">Configured</option>
            <option value="needs-setup">Needs setup</option>
        </select>
        <select class="tds-filter-select" @bind="_categoryFilter" aria-label="Category filter">
            <option value="">All categories</option>
            @foreach (var category in CategoryOptions)
            {
                <option value="@category">@category</option>
            }
        </select>
        <div class="tds-search-result">
            <strong>@FilteredItems.Count</strong>
            <span>visible</span>
        </div>
    </section>

    <section class="tds-content-layout">
        <div class="tds-grid-wrap">
            <div class="tds-grid-toolbar">
                <div>
                    <strong>@CurrentModule.Title Register</strong>
                    <span>Plain Blazor table backed by api/document-config</span>
                </div>
                <div class="tds-toolbar-actions">
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="SelectFirst" disabled="@(FilteredItems.Count == 0)"><i class="bi bi-cursor" aria-hidden="true"></i> Select First</button>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ShowExportSummary" disabled="@(FilteredItems.Count == 0)"><i class="bi bi-download" aria-hidden="true"></i> Export Summary</button>
                    <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add</button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="tds-loading"><i class="bi bi-arrow-repeat tds-spin" aria-hidden="true"></i><strong>Loading document setup records…</strong></div>
            }
            else if (FilteredItems.Count == 0)
            {
                <div class="tds-empty-state">
                    <i class="bi bi-inboxes" aria-hidden="true"></i>
                    <strong>No records found</strong>
                    <span>Adjust filters or add a new @CurrentModule.SingularTitle record.</span>
                    <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add @CurrentModule.SingularTitle</button>
                </div>
            }
            else
            {
                <div class="tds-table-scroll">
                    <table class="tds-table">
                        <thead>
                            <tr>
                                <th>Record</th>
                                <th>Code</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Config</th>
                                <th class="tds-number">Order</th>
                                <th class="tds-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in FilteredItems)
                            {
                                <tr class="tds-table-row @(_selected?.DocumentConfigItemId == item.DocumentConfigItemId ? "tds-table-row--selected" : "")" @onclick="() => SelectItem(item)">
                                    <td>
                                        <div class="tds-record-cell">
                                            <span class="tds-record-icon @CurrentModule.IconCss"><i class="bi @CurrentModule.Icon" aria-hidden="true"></i></span>
                                            <div>
                                                <strong>@item.Name</strong>
                                                <span>@(string.IsNullOrWhiteSpace(item.Description) ? "No description supplied." : item.Description)</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="tds-code">@item.Code</span></td>
                                    <td><span class="tds-category">@(item.Category ?? "Unassigned")</span></td>
                                    <td><span class="tds-status @(item.IsActive ? "tds-status-active" : "tds-status-inactive")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                                    <td><span class="tds-status @(HasConfiguration(item) ? "tds-status-configured" : "tds-status-warning")">@(HasConfiguration(item) ? "Configured" : "Needs setup")</span></td>
                                    <td class="tds-number">@item.SortOrder</td>
                                    <td>
                                        <div class="tds-row-actions">
                                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => ConfirmToggle(item)" title="Toggle active"><i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => ConfirmDuplicate(item)" title="Duplicate"><i class="bi bi-files" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(item)" title="Delete"><i class="bi bi-trash3" aria-hidden="true"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <aside class="tds-detail-panel" aria-label="Selected document setup record">
            @if (_selected is null)
            {
                <div class="tds-detail-empty">
                    <i class="bi @CurrentModule.Icon" aria-hidden="true"></i>
                    <h2>Select a setup record</h2>
                    <p>Choose a row to inspect configuration JSON, controls, and workflow health.</p>
                </div>
            }
            else
            {
                <div class="tds-detail-head">
                    <div class="tds-detail-title-block">
                        <span class="tds-detail-eyebrow"><i class="bi @CurrentModule.Icon" aria-hidden="true"></i> @CurrentModule.ShortTitle</span>
                        <h2>@_selected.Name</h2>
                        <div class="tds-detail-meta">
                            <span><i class="bi bi-hash" aria-hidden="true"></i> @_selected.Code</span>
                            <span><i class="bi bi-tag" aria-hidden="true"></i> @(_selected.Category ?? "Unassigned")</span>
                        </div>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close details"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="tds-detail-body">
                    <div class="tds-detail-summary">
                        <div class="tds-meta-row"><span class="tds-meta-lbl">Status</span><span class="tds-meta-val">@(_selected.IsActive ? "Active" : "Inactive")</span></div>
                        <div class="tds-meta-row"><span class="tds-meta-lbl">Configuration</span><span class="tds-meta-val">@(HasConfiguration(_selected) ? "Present" : "Missing")</span></div>
                        <div class="tds-meta-row"><span class="tds-meta-lbl">Sort Order</span><span class="tds-meta-val">@_selected.SortOrder</span></div>
                        <div class="tds-meta-row"><span class="tds-meta-lbl">Created</span><span class="tds-meta-val">@_selected.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy")</span></div>
                    </div>
                    <div class="tds-detail-description">
                        <strong>Workflow description</strong>
                        <p>@(string.IsNullOrWhiteSpace(_selected.Description) ? "No description has been configured for this record." : _selected.Description)</p>
                    </div>
                    <div class="tds-json-card">
                        <div>
                            <strong>Configuration JSON</strong>
                            <span>@(HasConfiguration(_selected) ? "Controls are stored with this record." : "Add JSON controls to complete setup.")</span>
                        </div>
                        <pre>@(string.IsNullOrWhiteSpace(_selected.ConfigurationJson) ? "{}" : _selected.ConfigurationJson)</pre>
                    </div>
                    <div class="tds-detail-actions">
                        <button type="button" class="um-btn um-btn-primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil-square" aria-hidden="true"></i> Edit</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfirmToggle(_selected)"><i class="bi @(_selected.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i> @(_selected.IsActive ? "Deactivate" : "Activate")</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfirmDuplicate(_selected)"><i class="bi bi-files" aria-hidden="true"></i> Duplicate</button>
                        <button type="button" class="um-btn um-btn-danger" @onclick="() => ConfirmDelete(_selected)"><i class="bi bi-trash3" aria-hidden="true"></i> Delete</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    private Guid TenantAdminUserId { get; set; }
    private Guid DevTenantId { get; set; }
    private Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private Guid TenantId { get; set; }
    private string _search = string.Empty;
    private string _activeFilter = string.Empty;
    private string _categoryFilter = string.Empty;
    private bool _loading;
    private bool _saving;
    private bool _showForm;
    private string? _loadError;
    private string? _toastMessage;
    private string _toastKind = "success";
    private string _toastIcon = "bi-check-circle-fill";
    private Guid? _editId;
    private DocumentConfigItemDto? _selected;
    private ConfirmAction? _confirmAction;
    private ConfigFormModel _form = new();
    private readonly List<DocumentConfigItemDto> _items = [];

    private ModuleDefinition CurrentModule => Modules.FirstOrDefault(x => Nav.ToBaseRelativePath(Nav.Uri).Split('?', 2)[0].Equals(x.Route.TrimStart('/'), StringComparison.OrdinalIgnoreCase)) ?? Modules[0];

    private List<DocumentConfigItemDto> FilteredBySearch => _items
        .Where(MatchesSearch)
        .OrderBy(x => x.SortOrder)
        .ThenBy(x => x.Name)
        .ToList();

    private List<DocumentConfigItemDto> FilteredItems => FilteredBySearch
        .Where(x => string.IsNullOrWhiteSpace(_categoryFilter) || string.Equals(x.Category ?? "Unassigned", _categoryFilter, StringComparison.OrdinalIgnoreCase))
        .Where(x => _activeFilter switch
        {
            "active" => x.IsActive,
            "inactive" => !x.IsActive,
            "configured" => HasConfiguration(x),
            "needs-setup" => !HasConfiguration(x),
            _ => true
        })
        .ToList();

    private List<string> CategoryOptions => _items
        .Select(x => string.IsNullOrWhiteSpace(x.Category) ? "Unassigned" : x.Category!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private string FilterLabel => _activeFilter switch
    {
        "active" => "Active records",
        "inactive" => "Inactive records",
        "configured" => "Configured records",
        "needs-setup" => "Needs setup",
        _ => "All records"
    };

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Documents & Forms", null), new(CurrentModule.Title, null));
        _search = GetQueryValue("searchTerm") ?? string.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchDocumentConfigItemsAsync(TenantId, CurrentModule.Kind, pageSize: 1000);
            _items.Clear();
            _items.AddRange(result?.Items ?? []);
            EnsureSelectedStillVisible();
        }
        catch (Exception ex)
        {
            _loadError = $"Error loading document configuration: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger", "bi-exclamation-triangle-fill");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _activeFilter = string.Empty;
        _categoryFilter = string.Empty;
        EnsureSelectedStillVisible();
    }

    private void SetFilter(string filter)
    {
        _activeFilter = _activeFilter == filter ? string.Empty : filter;
        EnsureSelectedStillVisible();
    }

    private void NavigateModule(ModuleDefinition module) => Nav.NavigateTo(module.Route);

    private int ModuleCount(string kind) => CurrentModule.Kind == kind ? _items.Count : 0;

    private void SelectItem(DocumentConfigItemDto item) => _selected = item;

    private void SelectFirst()
    {
        _selected = FilteredItems.FirstOrDefault();
        if (_selected is null)
            ShowToast("No records are available to select.", "warning", "bi-exclamation-triangle-fill");
    }

    private void OpenCreate()
    {
        _editId = null;
        _form = new ConfigFormModel
        {
            ConfigurationJson = DefaultConfigurationJson,
            SortOrder = NextSortOrder,
            IsActive = true
        };
        _showForm = true;
    }

    private void OpenEdit(DocumentConfigItemDto item)
    {
        _editId = item.DocumentConfigItemId;
        _form = new ConfigFormModel
        {
            Code = item.Code,
            Name = item.Name,
            Category = item.Category,
            Description = item.Description,
            ConfigurationJson = string.IsNullOrWhiteSpace(item.ConfigurationJson) ? "{}" : item.ConfigurationJson,
            SortOrder = item.SortOrder,
            IsActive = item.IsActive
        };
        _showForm = true;
    }

    private void CloseForm()
    {
        if (_saving)
            return;

        _showForm = false;
        _editId = null;
        _form = new();
    }

    private async Task SaveAsync()
    {
        if (!IsJsonValid(_form.ConfigurationJson, out var jsonError))
        {
            ShowToast($"Save failed: {jsonError}", "danger", "bi-exclamation-triangle-fill");
            return;
        }

        _saving = true;
        try
        {
            if (_editId.HasValue)
            {
                await Api.UpdateDocumentConfigItemAsync(_editId.Value, new UpdateDocumentConfigItemRequest(_form.Code.Trim(), _form.Name.Trim(), Normalize(_form.Category), Normalize(_form.Description), NormalizeJson(_form.ConfigurationJson), _form.IsActive, _form.SortOrder));
                ShowToast("Record updated successfully.", "success", "bi-check-circle-fill");
            }
            else
            {
                var id = await Api.CreateDocumentConfigItemAsync(new CreateDocumentConfigItemRequest(TenantId, CurrentModule.Kind, _form.Code.Trim(), _form.Name.Trim(), Normalize(_form.Category), Normalize(_form.Description), NormalizeJson(_form.ConfigurationJson), _form.SortOrder));
                ShowToast("Record created successfully.", "success", "bi-check-circle-fill");
                _editId = id;
            }

            _showForm = false;
            await LoadAsync();
            _selected = _editId.HasValue ? _items.FirstOrDefault(x => x.DocumentConfigItemId == _editId.Value) ?? FilteredItems.FirstOrDefault() : FilteredItems.FirstOrDefault();
            _editId = null;
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger", "bi-exclamation-triangle-fill");
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmToggle(DocumentConfigItemDto item)
    {
        _confirmAction = new ConfirmAction(
            item.IsActive ? "Deactivate Setup Record" : "Activate Setup Record",
            $"{(item.IsActive ? "Deactivate" : "Activate")} {item.Name}? This updates workflow availability for this tenant.",
            item.IsActive ? "Deactivate" : "Activate",
            "bi-pause-circle",
            async () => await ToggleActiveAsync(item));
    }

    private async Task ToggleActiveAsync(DocumentConfigItemDto item)
    {
        await Api.UpdateDocumentConfigItemAsync(item.DocumentConfigItemId, new UpdateDocumentConfigItemRequest(item.Code, item.Name, item.Category, item.Description, item.ConfigurationJson, !item.IsActive, item.SortOrder));
        ShowToast($"{item.Name} {(item.IsActive ? "deactivated" : "activated")} successfully.", "success", "bi-check-circle-fill");
        await LoadAsync();
        _selected = _items.FirstOrDefault(x => x.DocumentConfigItemId == item.DocumentConfigItemId);
    }

    private void ConfirmDuplicate(DocumentConfigItemDto item)
    {
        _confirmAction = new ConfirmAction(
            "Duplicate Setup Record",
            $"Create a duplicate copy of {item.Name}? A new record will be created with a unique code and copied configuration.",
            "Duplicate",
            "bi-files",
            async () => await DuplicateAsync(item));
    }

    private async Task DuplicateAsync(DocumentConfigItemDto item)
    {
        _saving = true;
        try
        {
            var suffix = DateTime.UtcNow.ToString("HHmmss");
            var copyCode = $"{item.Code}_COPY_{suffix}";
            var id = await Api.CreateDocumentConfigItemAsync(new CreateDocumentConfigItemRequest(TenantId, CurrentModule.Kind, copyCode, $"{item.Name} Copy", item.Category, item.Description, item.ConfigurationJson, item.SortOrder + 10));
            ShowToast("Duplicate record created successfully.", "success", "bi-files");
            await LoadAsync();
            _selected = _items.FirstOrDefault(x => x.DocumentConfigItemId == id);
        }
        catch (Exception ex)
        {
            ShowToast($"Duplicate failed: {ex.Message}", "danger", "bi-exclamation-triangle-fill");
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmDelete(DocumentConfigItemDto item)
    {
        _confirmAction = new ConfirmAction(
            "Delete Setup Record",
            $"Delete {item.Name}? This soft-deletes the tenant document setup record after confirmation.",
            "Delete",
            "bi-trash3-fill",
            async () => await DeleteAsync(item));
    }

    private async Task DeleteAsync(DocumentConfigItemDto item)
    {
        await Api.DeleteDocumentConfigItemAsync(item.DocumentConfigItemId);
        ShowToast("Record deleted successfully.", "success", "bi-check-circle-fill");
        await LoadAsync();
        if (_selected?.DocumentConfigItemId == item.DocumentConfigItemId)
            _selected = FilteredItems.FirstOrDefault();
    }

    private async Task ExecuteConfirmAsync()
    {
        if (_confirmAction is null)
            return;

        _saving = true;
        try
        {
            var action = _confirmAction;
            _confirmAction = null;
            await action.ExecuteAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Action failed: {ex.Message}", "danger", "bi-exclamation-triangle-fill");
        }
        finally
        {
            _saving = false;
        }
    }

    private void CancelConfirm()
    {
        if (_saving)
            return;

        _confirmAction = null;
    }

