@page "/tenant/documents/categories2"
@page "/tenant/documents/templates2"
@page "/tenant/documents/acord2"
@page "/tenant/documents/esign2"
@page "/tenant/documents/packets2"
@page "/tenant/documents/retention2"
@page "/tenant/documents/ocr2"
@page "/tenant/documents/storage2"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Documents & Forms Setup — AMS</PageTitle>

<AppPageHeader Title="Documents & Forms Setup"
               Subtitle="Tenant admin control center for document categories, templates, ACORD forms, e-sign templates, packet templates, retention, OCR/indexing, and storage settings"
               Icon="bi-folder-gear">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/tenant/documents/templates")'>
            <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Document Templates
        </button>
    </Actions>
</AppPageHeader>

<section class="doccfg-hero" aria-label="Documents and forms setup overview">
    <div>
        <span class="doccfg-eyebrow">Tenant administration</span>
        <h2>Documents & Forms Workflow</h2>
        <p>Configure the tenant document ecosystem across categories, document templates, ACORD libraries, e-sign templates, packets, retention, OCR/indexing automation, and storage governance.</p>
    </div>
    <div class="doccfg-hero-grid">
        @foreach (var action in _quickActions)
        {
            <button class="doccfg-quick-action" @onclick="() => Nav.NavigateTo(action.Url)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
</section>

<section class="doccfg-kpi-grid" aria-label="Documents and forms setup metrics">
    @Kpi("Templates", "84", "Active document templates", "bi-file-earmark-text", "doccfg-tone-blue")
    @Kpi("ACORD Forms", "312", "Mapped form library", "bi-file-earmark-medical", "doccfg-tone-green")
    @Kpi("OCR Rules", "42", "Indexing automations", "bi-upc-scan", "doccfg-tone-violet")
    @Kpi("Storage", "74%", "Tenant allocation used", "bi-hdd", "doccfg-tone-amber")
</section>

<section class="doccfg-command-bar" aria-label="Documents and forms setup filters">
    <div class="doccfg-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search"
               placeholder="Search document setup, owner, control, module..."
               @bind="_search"
               @bind:event="oninput" />
    </div>
    <div class="doccfg-pill-group" role="group" aria-label="Documents workflow filter">
        @foreach (var filter in _filters)
        {
            <button class="doccfg-pill @(_filter == filter.Key ? "doccfg-pill--active" : "")"
                    @onclick="() => _filter = filter.Key">
                @filter.Label
                <span>@FilterCount(filter.Key)</span>
            </button>
        }
    </div>
</section>

<section class="doccfg-layout">
    <div class="doccfg-flow" aria-label="Documents and forms workflow lanes">
        @foreach (var lane in _lanes)
        {
            var laneItems = FilteredWorkflow.Where(x => x.Stage == lane.Key).ToList();
            <article class="doccfg-lane">
                <header class="doccfg-lane-header">
                    <div>
                        <span class="doccfg-lane-title">@lane.Label</span>
                        <span class="doccfg-lane-subtitle">@lane.Description</span>
                    </div>
                    <span class="doccfg-lane-count">@laneItems.Count</span>
                </header>

                <div class="doccfg-lane-list">
                    @if (laneItems.Count == 0)
                    {
                        <div class="doccfg-empty-mini">No visible workflow items.</div>
                    }
                    else
                    {
                        @foreach (var item in laneItems)
                        {
                            <button class="doccfg-work-card @(item.Risk == "High" ? "doccfg-work-card--risk" : "")"
                                    @onclick="() => _selected = item">
                                <div class="doccfg-work-topline">
                                    <span class="doccfg-chip @ToneCss(item.Domain)">@item.Domain</span>
                                    <span class="doccfg-status @RiskCss(item.Risk)">@item.Risk</span>
                                </div>
                                <strong>@item.Title</strong>
                                <p>@item.Summary</p>
                                <div class="doccfg-work-meta">
                                    <span><i class="bi bi-person" aria-hidden="true"></i> @item.Owner</span>
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> @item.Sla</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            </article>
        }
    </div>

    <aside class="doccfg-admin-panel" aria-label="Tenant documents and forms administration controls">
        @if (_selected is null)
        {
            <div class="doccfg-side-empty">
                <i class="bi bi-folder-gear" aria-hidden="true"></i>
                <h3>Document governance</h3>
                <p>Select a workflow item to inspect owner, SLA, risk, document control, and setup module.</p>
            </div>
        }
        else
        {
            <div class="doccfg-detail-header">
                <span class="doccfg-chip @ToneCss(_selected.Domain)">@_selected.Domain</span>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close details">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h3>@_selected.Title</h3>
            <p>@_selected.Summary</p>

            <dl class="doccfg-detail-list">
                <div><dt>Owner</dt><dd>@_selected.Owner</dd></div>
                <div><dt>Stage</dt><dd>@_selected.Stage</dd></div>
                <div><dt>Risk</dt><dd><span class="doccfg-status @RiskCss(_selected.Risk)">@_selected.Risk</span></dd></div>
                <div><dt>SLA</dt><dd>@_selected.Sla</dd></div>
                <div><dt>Control</dt><dd>@_selected.Control</dd></div>
            </dl>

            <div class="doccfg-policy-card">
                <strong>Tenant document controls</strong>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Categories, templates, ACORD, and packet governance enforced</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> E-sign, OCR/indexing, and retention rules auditable</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Storage allocation, legal hold, and lifecycle controls monitored</span>
            </div>

            <div class="doccfg-detail-actions">
                <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selected.Url)">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Module
                </button>
                <button class="um-btn um-btn-ghost" @onclick="() => Advance(_selected)">
                    <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Advance
                </button>
            </div>
        }
    </aside>
</section>

<section class="doccfg-module-grid" aria-label="Documents and forms setup modules">
    @foreach (var module in _modules)
    {
        <button class="doccfg-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
            <span class="doccfg-module-icon @ToneCss(module.Domain)"><i class="bi @module.Icon" aria-hidden="true"></i></span>
            <span class="doccfg-module-content">
                <strong>@module.Title</strong>
                <small>@module.Description</small>
            </span>
            <i class="bi bi-chevron-right doccfg-module-arrow" aria-hidden="true"></i>
        </button>
    }
</section>

@code {
    private string _search = string.Empty;
    private string _filter = string.Empty;
    private DocumentWorkflowItem? _selected;
    private readonly List<DocumentWorkflowItem> _workflow = [];

    private readonly Lane[] _lanes =
    [
        new("Classify", "Classify", "Categories and metadata"),
        new("Author", "Author", "Templates and forms"),
        new("Package", "Package", "E-sign and packets"),
        new("Index", "Index", "OCR and automation"),
        new("Govern", "Govern", "Retention and storage")
    ];

    private readonly Filter[] _filters =
    [
        new("", "All"),
        new("risk", "High Risk"),
        new("templates", "Templates"),
        new("ocr", "OCR"),
        new("govern", "Governance")
    ];

    private readonly DocumentModule[] _modules =
    [
        new("Document Categories", "Configure categories, metadata, access policy, required fields, and lifecycle class.", "/tenant/documents/categories", "bi-folder2", "Categories"),
        new("Document Templates", "Manage templates, merge fields, versions, approvals, and output naming conventions.", "/tenant/documents/templates", "bi-file-earmark-text", "Templates"),
        new("ACORD Forms", "Configure form library, prefill mappings, validation rules, and form availability.", "/tenant/documents/acord", "bi-file-earmark-medical", "Forms"),
        new("E-Sign Templates", "Manage signing templates, signer roles, routing, reminders, and completion callbacks.", "/tenant/documents/esign", "bi-pen", "Signing"),
        new("Packet Templates", "Build packet templates, document bundles, conditional inclusions, and delivery rules.", "/tenant/documents/packets", "bi-collection", "Packets"),
        new("Retention Rules", "Define retention schedules, legal holds, archive eligibility, and purge approvals.", "/tenant/documents/retention", "bi-clock-history", "Governance"),
        new("OCR / Indexing Rules", "Configure OCR extraction, confidence thresholds, exception routing, and indexing fields.", "/tenant/documents/ocr", "bi-upc-scan", "OCR"),
        new("Storage Settings", "Control storage quotas, encryption, region policy, archive tiering, and growth alerts.", "/tenant/documents/storage", "bi-hdd", "Storage")
    ];

    private readonly DocumentModule[] _quickActions =
    [
        new("Templates", "", "/tenant/documents/templates", "bi-file-earmark-text", "Templates"),
        new("ACORD", "", "/tenant/documents/acord", "bi-file-earmark-medical", "Forms"),
        new("OCR", "", "/tenant/documents/ocr", "bi-upc-scan", "OCR"),
        new("Storage", "", "/tenant/documents/storage", "bi-hdd", "Storage")
    ];

    private IEnumerable<DocumentWorkflowItem> FilteredWorkflow => _workflow.Where(item =>
        (string.IsNullOrWhiteSpace(_filter) || _filter switch
        {
            "risk" => item.Risk == "High",
            "templates" => item.Domain is "Templates" or "Forms",
            "ocr" => item.Domain == "OCR",
            "govern" => item.Domain is "Governance" or "Storage",
            _ => true
        }) &&
        (string.IsNullOrWhiteSpace(_search) ||
         item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Domain.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Control.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(x => x.Risk == "High")
        .ThenBy(x => x.Stage)
        .ThenBy(x => x.Title);

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Documents & Forms Setup", "/tenant/documents/templates"));
        BuildWorkflow();
        _selected = _workflow.FirstOrDefault(x => x.Risk == "High") ?? _workflow.FirstOrDefault();
    }

    private void BuildWorkflow()
    {
        _workflow.Clear();
        _workflow.AddRange(
        [
            new("Category access review", "Commercial document categories require branch and role access review before rollout.", "Categories", "High", "Classify", "Diana Perez", "Today", "Category access policy", "/tenant/documents/categories"),
            new("Renewal template versioning", "Renewal proposal template v7 has pending merge-field and approval workflow updates.", "Templates", "High", "Author", "Sarah Kim", "48h", "Template approval", "/tenant/documents/templates"),
            new("ACORD mapping update", "ACORD 125 and 140 prefill mappings need validation against updated account fields.", "Forms", "Medium", "Author", "James Park", "This week", "Form mapping validation", "/tenant/documents/acord"),
            new("E-sign routing exception", "Certificate holder and named insured signer roles need updated routing rules.", "Signing", "Medium", "Package", "Maria Santos", "3 days", "Signer routing policy", "/tenant/documents/esign"),
            new("Policy packet checklist", "Commercial package policy packet needs conditional document inclusions by line of business.", "Packets", "Medium", "Package", "Lisa Chen", "5 days", "Packet assembly governance", "/tenant/documents/packets"),
            new("OCR confidence threshold", "Low OCR confidence exceptions increased after carrier download document changes.", "OCR", "High", "Index", "Kevin Obi", "Today", "OCR exception routing", "/tenant/documents/ocr"),
            new("Retention legal hold", "Litigation hold and purge approvals need review for archived claims documents.", "Governance", "High", "Govern", "Robert Yamamoto", "24h", "Retention and legal hold", "/tenant/documents/retention"),
            new("Storage growth alert", "Tenant storage usage reached 74% and archive tier policy should be reviewed.", "Storage", "Medium", "Govern", "Diana Perez", "This week", "Storage quota policy", "/tenant/documents/storage")
        ]);
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _filter = string.Empty;
    }

    private void Advance(DocumentWorkflowItem item)
    {
        item.Stage = item.Stage switch
        {
            "Classify" => "Author",
            "Author" => "Package",
            "Package" => "Index",
            "Index" => "Govern",
            _ => "Govern"
        };
    }

    private int FilterCount(string key) => key switch
    {
        "risk" => _workflow.Count(x => x.Risk == "High"),
        "templates" => _workflow.Count(x => x.Domain is "Templates" or "Forms"),
        "ocr" => _workflow.Count(x => x.Domain == "OCR"),
        "govern" => _workflow.Count(x => x.Domain is "Governance" or "Storage"),
        _ => _workflow.Count
    };

    private static string ToneCss(string domain) => domain switch
    {
        "Categories" => "doccfg-tone-blue",
        "Templates" => "doccfg-tone-violet",
        "Forms" => "doccfg-tone-green",
        "Signing" => "doccfg-tone-cyan",
        "Packets" => "doccfg-tone-amber",
        "OCR" => "doccfg-tone-red",
        "Governance" => "doccfg-tone-blue",
        "Storage" => "doccfg-tone-neutral",
        _ => "doccfg-tone-neutral"
    };

    private static string RiskCss(string risk) => risk switch
    {
        "High" => "doccfg-status-high",
        "Medium" => "doccfg-status-medium",
        _ => "doccfg-status-low"
    };

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="doccfg-kpi-card">
        <span class="doccfg-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span>
        <div>
            <strong>@value</strong>
            <span>@label</span>
            <small>@meta</small>
        </div>
    </article>;

    private sealed record Lane(string Key, string Label, string Description);
    private sealed record Filter(string Key, string Label);
    private sealed record DocumentModule(string Title, string Description, string Url, string Icon, string Domain)
    {
        public string Label => Title;
    }

    private sealed class DocumentWorkflowItem(string title, string summary, string domain, string risk, string stage, string owner, string sla, string control, string url)
    {
        public string Title { get; set; } = title;
        public string Summary { get; set; } = summary;
        public string Domain { get; set; } = domain;
        public string Risk { get; set; } = risk;
        public string Stage { get; set; } = stage;
        public string Owner { get; set; } = owner;
        public string Sla { get; set; } = sla;
        public string Control { get; set; } = control;
        public string Url { get; set; } = url;
    }
}
