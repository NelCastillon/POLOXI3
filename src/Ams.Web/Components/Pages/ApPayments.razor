@page "/finance/ap-payments"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Common.Validation
@using Ams.Application.Features.Finance
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>AP Payments - AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="app-toast app-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="app-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showStatusConfirm && _statusTarget is not null && !string.IsNullOrWhiteSpace(_pendingStatus))
{
    <div class="app-modal-backdrop" role="presentation" @onclick="CancelStatusUpdate">
        <div class="app-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="app-status-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon @(_pendingStatus == "Void" ? "um-confirm-icon--danger" : null)"><i class="bi @StatusActionIcon(_pendingStatus)"></i></div>
                <div class="um-confirm-title" id="app-status-title">@StatusActionTitle(_pendingStatus)</div>
                <div class="um-confirm-body">Update payment <strong>@PaymentReference(_statusTarget)</strong> for <strong>@VendorName(_statusTarget.VendorId)</strong> to <strong>@_pendingStatus</strong>?</div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CancelStatusUpdate" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn @(_pendingStatus == "Void" ? "um-btn-danger" : "um-btn-primary")" @onclick="ExecuteStatusUpdateAsync" disabled="@_busy">@StatusActionButton(_pendingStatus)</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="app-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="app-modal app-action-modal" role="dialog" aria-modal="true" aria-labelledby="app-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-cash-stack" aria-hidden="true"></i>
                <span id="app-form-title">@(_editingId == Guid.Empty ? "New AP Payment" : "Edit AP Payment")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="app-modal-intro"><span><i class="bi bi-shield-check" aria-hidden="true"></i> AP payment workflow</span><p>Schedule vendor disbursements, connect payments to invoices, and track payment status.</p></div>
                    <div class="um-form-grid">
                        <div class="um-field"><label>Vendor <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.VendorId" class="form-select"><option value="@Guid.Empty">Select vendor...</option>@foreach (var vendor in _vendors) { <option value="@vendor.VendorId">@vendor.VendorName</option> }</InputSelect></div>
                        <div class="um-field"><label>AP Invoice</label><InputSelect @bind-Value="_form.ApInvoiceId" class="form-select"><option value="">None</option>@foreach (var invoice in _invoices) { <option value="@invoice.ApInvoiceId">@invoice.InvoiceNumber - @VendorName(invoice.VendorId) - @Fmt(Balance(invoice)) due</option> }</InputSelect></div>
                        <div class="um-field"><label>Payment Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.PaymentDate" class="form-control" /></div>
                        <div class="um-field"><label>Amount <span class="text-danger">*</span></label><InputNumber @bind-Value="_form.Amount" class="form-control" /></div>
            <div class="um-field"><label>Payment Method <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.PaymentMethodCode" class="form-select">@foreach (var method in PaymentMethodOptions) { <option value="@method">@method</option> }</InputSelect></div>
            <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="form-select">@foreach (var status in StatusOptions) { <option value="@status">@status</option> }</InputSelect></div>
                        <div class="um-field"><label>Reference #</label><InputText @bind-Value="_form.ReferenceNumber" class="form-control" /></div>
                        <div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_form.Notes" class="form-control" rows="3" /></div>
                        @if (!string.IsNullOrWhiteSpace(_formError))
                        {
                            <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">@if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } @(_editingId == Guid.Empty ? "Create Payment" : "Save Changes")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="app-enterprise-page">
    <section class="app-header">
        <div class="app-header-left">
            <div class="app-lob-icon"><i class="bi bi-credit-card-2-front" aria-hidden="true"></i></div>
            <div class="app-header-info">
                <div class="app-title-row"><h1 class="app-page-title">AP Payments</h1><span class="app-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live payment data</span><span class="app-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span></div>
                <div class="app-sub-row"><span>Track vendor disbursements, payment references, methods, and processing status.</span><span class="app-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Seed sync enabled</span><span class="app-sub-chip"><i class="bi bi-check2-circle" aria-hidden="true"></i> @_filtered.Count active matches</span></div>
            </div>
        </div>
        <div class="app-header-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/finance/vendors")'><i class="bi bi-shop" aria-hidden="true"></i> Vendors</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/finance/ap-invoices")'><i class="bi bi-receipt" aria-hidden="true"></i> Invoices</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi @(_loading ? "bi-arrow-repeat app-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync" disabled="@(!_filtered.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Payment</button>
        </div>
    </section>

    <section class="app-kpi-strip" aria-label="AP payment metrics">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="app-kpi-card @kpi.Tone @(_kpiFilter == kpi.Filter ? "app-kpi-active" : null)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)">
                <span class="app-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span><span class="app-kpi-copy"><span class="app-kpi-label">@kpi.Label</span><span class="app-kpi-value">@kpi.Value</span><span class="app-kpi-caption">@kpi.Caption</span></span>
            </button>
        }
    </section>

    <section class="app-workflow-strip" aria-label="AP payment workflow shortcuts">
        <button type="button" class="app-workflow-card app-wf-vendor" @onclick='() => Nav.NavigateTo("/finance/vendors")'><span class="app-workflow-icon"><i class="bi bi-shop" aria-hidden="true"></i></span><span class="app-workflow-content"><strong>1</strong><span>Vendor</span><small>Verify payee.</small></span></button>
        <button type="button" class="app-workflow-card app-wf-invoice" @onclick='() => Nav.NavigateTo("/finance/ap-invoices")'><span class="app-workflow-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span><span class="app-workflow-content"><strong>2</strong><span>Invoice</span><small>Review payable.</small></span></button>
        <button type="button" class="app-workflow-card app-wf-payment" @onclick="OpenCreate"><span class="app-workflow-icon"><i class="bi bi-credit-card" aria-hidden="true"></i></span><span class="app-workflow-content"><strong>3</strong><span>Payment</span><small>Create disbursement.</small></span></button>
        <button type="button" class="app-workflow-card app-wf-process" @onclick='() => SetKpiFilter("pending")'><span class="app-workflow-icon"><i class="bi bi-check2-square" aria-hidden="true"></i></span><span class="app-workflow-content"><strong>4</strong><span>Process</span><small>Clear pending.</small></span></button>
        <button type="button" class="app-workflow-card app-wf-ledger" @onclick='() => Nav.NavigateTo("/finance/journalentries")'><span class="app-workflow-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span><span class="app-workflow-content"><strong>5</strong><span>Post</span><small>Update ledger.</small></span></button>
    </section>

    <section class="app-enterprise-search" aria-label="AP payment filters">
        <div class="app-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
        <div class="app-search-body"><label for="app-search">Search AP payments</label><input id="app-search" class="app-search-input" type="search" placeholder="Search reference, vendor, invoice, method, status..." @bind="SearchFilter" @bind:event="oninput" /><span class="app-search-hint">Filters apply instantly across synchronized AP payment records.</span></div>
        <select class="app-filter-select" @bind="MethodFilter" aria-label="Payment method filter"><option value="">All methods</option>@foreach (var method in PaymentMethodOptions) { <option value="@method">@method</option> }</select>
        <select class="app-filter-select" @bind="StatusFilter" aria-label="Status filter"><option value="">All statuses</option>@foreach (var status in StatusOptions) { <option value="@status">@status</option> }</select>
        <div class="app-search-result"><strong>@_filtered.Count</strong><span>matches</span></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger app-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
    }

    <section class="app-content-layout">
        <div class="app-grid-wrap">
            <div class="app-grid-toolbar"><div><strong>AP payment register</strong><span>@ActiveFilterText</span></div><div class="app-toolbar-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-eraser" aria-hidden="true"></i> Reset</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/finance/ap-invoices")'><i class="bi bi-receipt" aria-hidden="true"></i> Invoices</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add</button></div></div>
            @if (_loading)
            {
                <div class="app-loading"><i class="bi bi-arrow-repeat app-spin" aria-hidden="true"></i><strong>Loading AP payments...</strong><span>Syncing schema, seed data, vendors, invoices, and payment entries.</span></div>
            }
            else if (!_filtered.Any())
            {
                <div class="app-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No AP payments found</strong><span>Adjust filters or create a new payment.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">New Payment</button></div>
            }
            else
            {
                <div class="app-table-scroll"><table class="app-table"><thead><tr><th>Payment</th><th>Vendor</th><th>Invoice</th><th>Method</th><th class="app-number">Amount</th><th>Status</th><th class="app-actions-col">Actions</th></tr></thead><tbody>@foreach (var item in PagedItems) { <tr class="app-table-row @(_selected?.ApPaymentId == item.ApPaymentId ? "app-table-row--selected" : null)" @onclick="() => SelectPayment(item)"><td><div class="app-entry-cell"><span class="app-entry-icon @StatusIconTone(item.StatusCode)"><i class="bi bi-credit-card" aria-hidden="true"></i></span><span><strong>@PaymentReference(item)</strong><span>@item.PaymentDate.ToString("MMM d, yyyy") - @item.CreatedDateUtc.ToLocalTime().ToString("MMM d")</span></span></div></td><td>@VendorName(item.VendorId)</td><td>@InvoiceNumber(item.ApInvoiceId)</td><td><span class="app-method-chip @MethodCss(item.PaymentMethodCode)">@item.PaymentMethodCode</span></td><td class="app-number">@Fmt(item.Amount)</td><td><span class="app-status-chip @StatusCss(item.StatusCode)">@item.StatusCode</span></td><td><div class="app-row-acts"><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Edit" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Process" disabled="@(item.StatusCode == "Processed")" @onclick:stopPropagation="true" @onclick='() => ConfirmStatusUpdate(item, "Processed")'><i class="bi bi-check-circle" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Void" disabled="@(item.StatusCode == "Void")" @onclick:stopPropagation="true" @onclick='() => ConfirmStatusUpdate(item, "Void")'><i class="bi bi-slash-circle" aria-hidden="true"></i></button></div></td></tr> }</tbody></table></div>
                <div class="app-pager"><span>Showing @PageStart-@PageEnd of @_filtered.Count</span><div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PrevPage" disabled="@(_page == 1)">Previous</button><span>Page @_page of @TotalPages</span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button></div></div>
            }
        </div>
        <aside class="app-detail-panel" aria-label="Selected AP payment detail">
            @if (_selected is null)
            {
                <div class="app-detail-empty"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a payment</strong><span>Choose a row to inspect vendor, invoice, method, status, and workflow actions.</span></div>
            }
            else
            {
                <div class="app-detail-head"><div><span class="app-detail-eyebrow"><i class="bi bi-credit-card" aria-hidden="true"></i> AP payment</span><h2>@PaymentReference(_selected)</h2><div class="app-detail-meta"><span>@VendorName(_selected.VendorId)</span><span class="app-status-chip @StatusCss(_selected.StatusCode)">@_selected.StatusCode</span></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></div>
                <div class="app-detail-body"><div class="app-detail-summary"><div class="app-meta-row"><span class="app-meta-lbl">Amount</span><span class="app-meta-val">@Fmt(_selected.Amount)</span></div><div class="app-meta-row"><span class="app-meta-lbl">Method</span><span class="app-meta-val">@_selected.PaymentMethodCode</span></div><div class="app-meta-row"><span class="app-meta-lbl">Payment Date</span><span class="app-meta-val">@_selected.PaymentDate.ToString("MMM d, yyyy")</span></div><div class="app-meta-row"><span class="app-meta-lbl">Invoice</span><span class="app-meta-val">@InvoiceNumber(_selected.ApInvoiceId)</span></div></div><div class="app-note-card"><span><i class="bi bi-card-text" aria-hidden="true"></i> Payment detail</span><p>@(string.IsNullOrWhiteSpace(_selected.Notes) ? "No notes recorded." : _selected.Notes)</p></div><div class="app-detail-actions"><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, "Processed")' disabled="@(_selected.StatusCode == "Processed")"><i class="bi bi-check-circle" aria-hidden="true"></i> Process</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, _selected.StatusCode == "Void" ? "Pending" : "Void")'><i class="bi @(_selected.StatusCode == "Void" ? "bi-arrow-counterclockwise" : "bi-slash-circle")" aria-hidden="true"></i> @(_selected.StatusCode == "Void" ? "Reopen" : "Void")</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/finance/ap-invoices")'><i class="bi bi-receipt" aria-hidden="true"></i> Invoices</button></div></div>
            }
        </aside>
    </section>
</div>

@code {
    private const int PageSize = 12;
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<ApPaymentDto> _items = [];
    private List<ApPaymentDto> _filtered = [];
    private List<VendorDto> _vendors = [];
    private List<ApInvoiceDto> _invoices = [];
    private ApPaymentDto? _selected;
    private ApPaymentDto? _statusTarget;
    private ApPaymentForm _form = new();
    private Guid _editingId = Guid.Empty;
    private string _searchTerm = string.Empty;
    private string _methodFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private string _kpiFilter = "all";
    private string? _pendingStatus;
    private int _page = 1;
    private bool _loading;
    private bool _busy;
    private bool _showForm;
    private bool _showStatusConfirm;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string? _formError;
    private IEnumerable<string> PaymentMethodOptions => DistinctOptions(_items.Select(x => x.PaymentMethodCode), _form.PaymentMethodCode, _methodFilter);
    private IEnumerable<string> StatusOptions => DistinctOptions(_items.Select(x => x.StatusCode), _form.StatusCode, _statusFilter, _pendingStatus);

    private IEnumerable<ApPaymentDto> PagedItems => _filtered.Skip((_page - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
    private int PageStart => _filtered.Count == 0 ? 0 : ((_page - 1) * PageSize) + 1;
    private int PageEnd => Math.Min(_filtered.Count, _page * PageSize);
    private decimal TotalProcessed => _items.Where(x => x.StatusCode == "Processed").Sum(x => x.Amount);
    private decimal PendingAmount => _items.Where(x => x.StatusCode == "Pending").Sum(x => x.Amount);
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", "info" => "bi-info-circle-fill", _ => "bi-check-circle-fill" };
    private string ActiveFilterText => _kpiFilter == "all" ? "All AP payments" : $"Filtered by {_kpiFilter}";
    private IReadOnlyList<KpiModel> Kpis =>
    [
        new("all", "Payments", _items.Count.ToString("N0"), "All disbursements", "bi-credit-card", "app-ki-blue"),
        new("processed", "Processed", _items.Count(x => x.StatusCode == "Processed").ToString("N0"), "Completed", "bi-check-circle", "app-ki-green"),
        new("pending", "Pending", _items.Count(x => x.StatusCode == "Pending").ToString("N0"), "Needs action", "bi-hourglass", "app-ki-amber"),
        new("amount", "Processed", Fmt(TotalProcessed), "Paid out", "bi-cash-stack", "app-ki-green"),
        new("pendingAmount", "Pending $", Fmt(PendingAmount), "Scheduled", "bi-clock-history", "app-ki-red"),
        new("methods", "Methods", _items.Select(x => x.PaymentMethodCode).Distinct().Count().ToString("N0"), "In use", "bi-diagram-3", "app-ki-purple")
    ];

    private string SearchFilter { get => _searchTerm; set { _searchTerm = value; ApplyFilters(resetPage: true); } }
    private string MethodFilter { get => _methodFilter; set { _methodFilter = value; ApplyFilters(resetPage: true); } }
    private string StatusFilter { get => _statusFilter; set { _statusFilter = value; ApplyFilters(resetPage: true); } }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Finance", "/finance"), new("AP Payments", "/finance/ap-payments"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchApPaymentsAsync(_tenantId, string.Empty);
            var vendors = await Api.SearchVendorsAsync(_tenantId, pageSize: 500);
            var invoices = await Api.SearchApInvoicesAsync(_tenantId);
            _items = result?.Items.OrderByDescending(x => x.PaymentDate).ThenBy(x => x.ReferenceNumber).ToList() ?? [];
            _vendors = vendors?.Items.OrderBy(x => x.VendorName).ToList() ?? [];
            _invoices = invoices?.Items.OrderByDescending(x => x.InvoiceDate).ToList() ?? [];
            ApplyFilters(resetPage: true);
            EnsureSelectedStillVisible();
        }
        catch (Exception ex)
        {
            _loadError = $"AP payments failed to load: {ex.Message}";
            ShowToast(_loadError, "danger");
            _items = [];
            _filtered = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters(bool resetPage)
    {
        IEnumerable<ApPaymentDto> query = _items;
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(x => Contains(x.ReferenceNumber, term) || Contains(x.Notes, term) || Contains(x.PaymentMethodCode, term) || Contains(x.StatusCode, term) || Contains(VendorName(x.VendorId), term) || Contains(InvoiceNumber(x.ApInvoiceId), term));
        }

        if (!string.IsNullOrWhiteSpace(_methodFilter)) query = query.Where(x => x.PaymentMethodCode == _methodFilter);
        if (!string.IsNullOrWhiteSpace(_statusFilter)) query = query.Where(x => x.StatusCode == _statusFilter);
        query = _kpiFilter switch
        {
            "processed" => query.Where(x => x.StatusCode == "Processed"),
            "pending" => query.Where(x => x.StatusCode == "Pending"),
            "amount" => query.Where(x => x.StatusCode == "Processed"),
            "pendingAmount" => query.Where(x => x.StatusCode == "Pending"),
            "methods" => query.Where(x => !string.IsNullOrWhiteSpace(x.PaymentMethodCode)),
            _ => query
        };

        _filtered = query.OrderByDescending(x => x.PaymentDate).ThenBy(x => x.ReferenceNumber).ToList();
        if (resetPage) _page = 1;
        if (_page > TotalPages) _page = TotalPages;
    }

    private void SetKpiFilter(string filter) { _kpiFilter = filter; ApplyFilters(resetPage: true); }
    private void ResetFilters() { _searchTerm = string.Empty; _methodFilter = string.Empty; _statusFilter = string.Empty; _kpiFilter = "all"; ApplyFilters(resetPage: true); ShowToast("AP payment filters reset.", "info"); }
    private void SelectPayment(ApPaymentDto item) => _selected = item;
    private void OpenCreate() { _editingId = Guid.Empty; _formError = null; _form = new ApPaymentForm { PaymentDate = DateTime.Today }; _showForm = true; }
    private void OpenEdit(ApPaymentDto payment) { _editingId = payment.ApPaymentId; _formError = null; _form = new ApPaymentForm { VendorId = payment.VendorId, ApInvoiceId = payment.ApInvoiceId, PaymentDate = payment.PaymentDate.ToDateTime(TimeOnly.MinValue), Amount = payment.Amount, PaymentMethodCode = payment.PaymentMethodCode, ReferenceNumber = payment.ReferenceNumber, Notes = payment.Notes, StatusCode = payment.StatusCode }; _showForm = true; }
    private void CloseForm() { if (_busy) return; _showForm = false; }

    private async Task SaveAsync()
    {
        _busy = true;
        _formError = null;
        try
        {
            if (_editingId == Guid.Empty)
            {
                await Api.CreateApPaymentAsync(new CreateApPaymentRequest { TenantId = _tenantId, VendorId = _form.VendorId, ApInvoiceId = _form.ApInvoiceId, PaymentDate = DateOnly.FromDateTime(_form.PaymentDate), Amount = _form.Amount, PaymentMethodCode = _form.PaymentMethodCode, ReferenceNumber = _form.ReferenceNumber, Notes = _form.Notes, StatusCode = _form.StatusCode, CreatedByUserId = _tenantAdminUserId });
                ShowToast("AP payment created.", "success");
            }
            else
            {
                await Api.UpdateApPaymentAsync(_editingId, new UpdateApPaymentRequest { TenantId = _tenantId, ApPaymentId = _editingId, VendorId = _form.VendorId, ApInvoiceId = _form.ApInvoiceId, PaymentDate = DateOnly.FromDateTime(_form.PaymentDate), Amount = _form.Amount, PaymentMethodCode = _form.PaymentMethodCode, ReferenceNumber = _form.ReferenceNumber, Notes = _form.Notes, StatusCode = _form.StatusCode, ModifiedByUserId = _tenantAdminUserId });
                ShowToast("AP payment updated.", "success");
            }

            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
            ShowToast(_formError, "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void ConfirmStatusUpdate(ApPaymentDto item, string status) { _statusTarget = item; _pendingStatus = status; _showStatusConfirm = true; }
    private void CancelStatusUpdate() { if (_busy) return; _showStatusConfirm = false; _statusTarget = null; _pendingStatus = null; }
    private async Task ExecuteStatusUpdateAsync()
    {
        if (_statusTarget is null || string.IsNullOrWhiteSpace(_pendingStatus)) return;
        _busy = true;
        try
        {
            await Api.UpdateApPaymentAsync(_statusTarget.ApPaymentId, new UpdateApPaymentRequest { TenantId = _tenantId, ApPaymentId = _statusTarget.ApPaymentId, VendorId = _statusTarget.VendorId, ApInvoiceId = _statusTarget.ApInvoiceId, PaymentDate = _statusTarget.PaymentDate, Amount = _statusTarget.Amount, PaymentMethodCode = _statusTarget.PaymentMethodCode, ReferenceNumber = _statusTarget.ReferenceNumber, Notes = _statusTarget.Notes, StatusCode = _pendingStatus, ModifiedByUserId = _tenantAdminUserId });
            ShowToast($"AP payment marked {_pendingStatus.ToLowerInvariant()}.", "success");
            _showStatusConfirm = false;
            _statusTarget = null;
            _pendingStatus = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Update failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private Task NotifyValidationAsync(EditContext _) { ShowToast("Please correct validation errors before saving the AP payment.", "warning"); return Task.CompletedTask; }
    private async Task ExportAsync()
    {
        if (!_filtered.Any()) { ShowToast("No AP payments are available to export.", "warning"); return; }
        var csv = new StringBuilder();
        csv.AppendLine("PaymentDate,Vendor,Invoice,Amount,Method,ReferenceNumber,Status,Notes,ApPaymentId");
        foreach (var item in _filtered) csv.AppendLine(string.Join(',', Csv(item.PaymentDate.ToString("yyyy-MM-dd")), Csv(VendorName(item.VendorId)), Csv(InvoiceNumber(item.ApInvoiceId)), item.Amount.ToString("0.00"), Csv(item.PaymentMethodCode), Csv(item.ReferenceNumber ?? string.Empty), Csv(item.StatusCode), Csv(item.Notes ?? string.Empty), Csv(item.ApPaymentId.ToString())));
        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        await Js.InvokeVoidAsync("amsDownload.downloadBase64", $"ap-payments-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
        ShowToast($"Exported {_filtered.Count:N0} AP payments.", "success");
    }

    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind) { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void EnsureSelectedStillVisible() => _selected = _selected is null ? _filtered.FirstOrDefault() : _items.FirstOrDefault(x => x.ApPaymentId == _selected.ApPaymentId) ?? _filtered.FirstOrDefault();
    private string VendorName(Guid vendorId) => _vendors.FirstOrDefault(x => x.VendorId == vendorId)?.VendorName ?? "Unknown vendor";
    private string InvoiceNumber(Guid? invoiceId) => invoiceId is null ? "Unapplied" : _invoices.FirstOrDefault(x => x.ApInvoiceId == invoiceId)?.InvoiceNumber ?? "Invoice";
    private static decimal Balance(ApInvoiceDto item) => Math.Max(0, item.Amount - item.AmountPaid);
    private static string PaymentReference(ApPaymentDto item) => string.IsNullOrWhiteSpace(item.ReferenceNumber) ? $"PAY-{item.ApPaymentId.ToString()[..8]}" : item.ReferenceNumber;
    private static string Fmt(decimal value) => value.ToString("C0");
    private static bool Contains(string? value, string term) => value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
    private static IReadOnlyList<string> DistinctOptions(IEnumerable<string?> values, params string?[] additionalValues) => values.Concat(additionalValues).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    private static string StatusCss(string status) => $"app-st-{status.ToLowerInvariant()}";
    private static string MethodCss(string method) => method switch { "ACH" => "app-mt-ach", "Check" => "app-mt-check", "Wire" => "app-mt-wire", "Credit Card" => "app-mt-card", _ => "app-mt-other" };
    private static string StatusIconTone(string status) => status switch { "Processed" => "app-di-green", "Void" => "app-di-slate", _ => "app-di-amber" };
    private static string StatusActionIcon(string status) => status switch { "Processed" => "bi-check-circle", "Void" => "bi-slash-circle", "Pending" => "bi-arrow-counterclockwise", _ => "bi-hourglass" };
    private static string StatusActionTitle(string status) => status switch { "Processed" => "Process Payment", "Void" => "Void Payment", "Pending" => "Reopen Payment", _ => $"Mark {status}" };
    private static string StatusActionButton(string status) => status switch { "Processed" => "Process", "Void" => "Void", "Pending" => "Reopen", _ => $"Mark {status}" };
    private static string Csv(string value) { var quote = Convert.ToChar(34).ToString(); return string.Concat(quote, value.Replace(quote, quote + quote), quote); }
    private async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; }
    private sealed record KpiModel(string Filter, string Label, string Value, string Caption, string Icon, string Tone) { public string Title => $"Filter AP payments by {Label}"; }

    private sealed class ApPaymentForm
    {
        [RequiredGuid(ErrorMessage = "Vendor is required.")] public Guid VendorId { get; set; }
        public Guid? ApInvoiceId { get; set; }
        [Required] public DateTime PaymentDate { get; set; } = DateTime.Today;
        [Range(0.01, 100000000)] public decimal Amount { get; set; }
        [Required, StringLength(50)] public string PaymentMethodCode { get; set; } = "ACH";
        [StringLength(100)] public string? ReferenceNumber { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
        [Required, StringLength(50)] public string StatusCode { get; set; } = "Pending";
    }
}
