@page "/finance/ap-payments"
@inject ApiClient Api

<PageTitle>AP Payments</PageTitle>
<h1>AP Payments</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(ApPaymentDto.PaymentDate)"       HeaderText="Date"          Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(ApPaymentDto.Amount)"            HeaderText="Amount"        Format="C2" Width="120"></GridColumn>
        <GridColumn Field="@nameof(ApPaymentDto.PaymentMethodCode)" HeaderText="Method"        Width="110"></GridColumn>
        <GridColumn Field="@nameof(ApPaymentDto.ReferenceNumber)"   HeaderText="Reference"     Width="160"></GridColumn>
        <GridColumn Field="@nameof(ApPaymentDto.StatusCode)"        HeaderText="Status"        Width="100"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<ApPaymentDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchApPaymentsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
