@page "/finance/ap-payments"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>AP Payments</PageTitle>

<AppPageHeader Title="Accounts Payable Payments"
               Subtitle="Track vendor payments and payment history"
               Icon="bi-arrow-up-right-circle">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "fa-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Payment
        </button>
    </Actions>
</AppPageHeader>

<!-- -- Search & Filter ---------------------------------------------------- -->
<div class="fin-toolbar">
    <div class="fin-search-box">
        <i class="bi bi-search fin-search-icon" aria-hidden="true"></i>
        <input class="e-input fin-search-input"
               placeholder="Search payments…"
               @bind="_searchTerm"
               @bind:event="oninput"
               @onkeyup="@(e => e.Key == "Enter" ? LoadAsync() : Task.CompletedTask)" />
    </div>
    <div class="fin-filter-buttons">
        <button class="um-btn um-btn-ghost um-btn-sm @(_filterActive ? "um-btn-active" : "")"
                @onclick="() => _filterActive = !_filterActive">
            <i class="bi bi-funnel" aria-hidden="true"></i> Filter
        </button>
    </div>
</div>

@if (_filterActive)
{
    <div class="fin-filter-panel">
        <div class="fin-filter-group">
            <label class="fin-filter-label">Payment Method</label>
            <select class="e-input" @bind="_filterMethod">
                <option value="">All Methods</option>
                <option value="ACH">ACH</option>
                <option value="Check">Check</option>
                <option value="Wire">Wire Transfer</option>
                <option value="Credit Card">Credit Card</option>
            </select>
        </div>
        <div class="fin-filter-group">
            <label class="fin-filter-label">Status</label>
            <select class="e-input" @bind="_filterStatus">
                <option value="">All</option>
                <option value="Pending">Pending</option>
                <option value="Processed">Processed</option>
            </select>
        </div>
    </div>
}

<!-- -- KPI Cards -------------------------------------------------------- -->
@if (_stats is not null)
{
    <div class="fin-kpi-strip">
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #d1fae5; color: #047857;"><i class="bi bi-cash-flow" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.TotalPayments</div>
                <div class="fin-kpi-label">Total Payments</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #ede9fe; color: #6d28d9;"><i class="bi bi-currency-dollar" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.TotalAmount.ToString("C0")</div>
                <div class="fin-kpi-label">Total Amount</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #fef3c7; color: #b45309;"><i class="bi bi-hourglass-split" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.PendingPayments</div>
                <div class="fin-kpi-label">Pending</div>
            </div>
        </div>
    </div>
}

<!-- -- Content -------------------------------------------------------- -->
@if (_error is not null)
{
    <div class="fin-alert fin-alert-warning">
        <div class="fin-alert-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></div>
        <div class="fin-alert-body">
            <div class="fin-alert-title">?? Database Schema Issue</div>
            <p>Finance schema initialization required. Run: <strong>sql/01_Finance_Schema.sql</strong></p>
        </div>
    </div>
}
else if (_loading)
{
    <div class="fin-loading">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading AP Payments…</span>
    </div>
}
else if (_items?.Count == 0)
{
    <div class="fin-empty-state">
        <i class="bi bi-inbox fin-empty-icon" aria-hidden="true"></i>
        <h3>No Payments Found</h3>
        <p>@(_searchTerm != null ? $"No payments match \"{_searchTerm}\"." : "No payments have been processed yet.")</p>
    </div>
}
else
{
    <div class="fin-grid-container">
        <SfGrid TValue="ApPaymentDto" DataSource="_items" AllowPaging="true" AllowSorting="true" Height="600px">
            <GridEvents TValue="ApPaymentDto" RowSelected="OnRowSelected" />
            <GridPageSettings PageSize="12"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(ApPaymentDto.PaymentDate)" HeaderText="Date" Type="ColumnType.Date" Format="d" Width="110" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(ApPaymentDto.Amount)" HeaderText="Amount" Format="C2" Width="120" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(ApPaymentDto.PaymentMethodCode)" HeaderText="Method" Width="110" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(ApPaymentDto.ReferenceNumber)" HeaderText="Reference" Width="140"></GridColumn>
                <GridColumn Field="@nameof(ApPaymentDto.StatusCode)" HeaderText="Status" Width="100" AllowSorting="true">
                    <Template>
                        @{
                            var payment = context as ApPaymentDto;
                            var badgeClass = payment?.StatusCode switch
                            {
                                "Processed" => "fin-badge-success",
                                "Pending" => "fin-badge-warning",
                                _ => "fin-badge-secondary"
                            };
                        }
                        <span class="fin-badge @badgeClass">@payment?.StatusCode</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Actions" Width="90">
                    <Template>
                        @{ var payment = (ApPaymentDto)context; }
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenEdit(payment)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
}

<SfDialog @bind-Visible="_showForm" Width="720px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-cash-stack" aria-hidden="true"></i><span>@(_editingId == Guid.Empty ? "New AP Payment" : "Edit AP Payment")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Vendor <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.VendorId" class="um-input"><option value="@Guid.Empty">Select vendor…</option>@foreach (var vendor in _vendors) { <option value="@vendor.VendorId">@vendor.VendorName</option> }</InputSelect><ValidationMessage For="() => _form.VendorId" class="text-danger" /></div>
                    <div class="um-field"><label>AP Invoice</label><InputSelect @bind-Value="_form.ApInvoiceId" class="um-input"><option value="">None</option>@foreach (var invoice in _invoices) { <option value="@invoice.ApInvoiceId">@invoice.InvoiceNumber</option> }</InputSelect><ValidationMessage For="() => _form.ApInvoiceId" class="text-danger" /></div>
                    <div class="um-field"><label>Payment Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.PaymentDate" class="um-input" /><ValidationMessage For="() => _form.PaymentDate" class="text-danger" /></div>
                    <div class="um-field"><label>Amount <span class="text-danger">*</span></label><InputNumber @bind-Value="_form.Amount" class="um-input" /><ValidationMessage For="() => _form.Amount" class="text-danger" /></div>
                    <div class="um-field"><label>Payment Method <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.PaymentMethodCode" class="um-input"><option value="ACH">ACH</option><option value="Check">Check</option><option value="Wire">Wire</option><option value="Credit Card">Credit Card</option></InputSelect><ValidationMessage For="() => _form.PaymentMethodCode" class="text-danger" /></div>
                    <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input"><option value="Pending">Pending</option><option value="Processed">Processed</option><option value="Void">Void</option></InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
                    <div class="um-field"><label>Reference #</label><InputText @bind-Value="_form.ReferenceNumber" class="um-input" /><ValidationMessage For="() => _form.ReferenceNumber" class="text-danger" /></div>
                    <div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_form.Notes" class="um-input" rows="3" /><ValidationMessage For="() => _form.Notes" class="text-danger" /></div>
                    @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Payment")</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private string _filterMethod = "";
    private string _filterStatus = "";
    private bool _filterActive = false;
    private bool _loading = false;
    private bool _showForm;
    private bool _saving;
    private List<ApPaymentDto>? _items;
    private List<VendorDto> _vendors = [];
    private List<ApInvoiceDto> _invoices = [];
    private string? _error;
    private string? _formError;
    private Guid _editingId = Guid.Empty;
    private ApPaymentForm _form = new();
    private EditContext _editContext = default!;

    private class Stats
    {
        public int TotalPayments { get; set; }
        public decimal TotalAmount { get; set; }
        public int PendingPayments { get; set; }
    }

    private Stats? _stats;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(
            new("Home", "/"),
            new("Finance", "/finance"),
            new("AP Payments", "/finance/ap-payments"));
        _editContext = new(_form);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _items = null;
        try
        {
            var result = await Api.SearchApPaymentsAsync(_tenantId, _searchTerm);
            var vendors = await Api.SearchVendorsAsync(_tenantId, pageSize: 500);
            var invoices = await Api.SearchApInvoicesAsync(_tenantId);
            _items = result?.Items.ToList() ?? [];
            _vendors = vendors?.Items.ToList() ?? [];
            _invoices = invoices?.Items.ToList() ?? [];

            if (!string.IsNullOrEmpty(_filterMethod))
                _items = _items.Where(x => x.PaymentMethodCode == _filterMethod).ToList();

            if (!string.IsNullOrEmpty(_filterStatus))
                _items = _items.Where(x => x.StatusCode == _filterStatus).ToList();

            _stats = new Stats
            {
                TotalPayments = _items.Count,
                TotalAmount = _items.Sum(x => x.Amount),
                PendingPayments = _items.Count(x => x.StatusCode == "Pending")
            };
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            if (ex.Message.Contains("Invalid column name") || ex.Message.Contains("ApPayment"))
            {
                _error = "Database schema mismatch. Please ensure 00_schema_migration.sql has been applied to your database. See db/README.md for setup instructions.";
            }
            _items = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnRowSelected(RowSelectEventArgs<ApPaymentDto> args) => OpenEdit(args.Data);
    private void OpenCreate() { _editingId = Guid.Empty; _form = new(); _editContext = new(_form); _formError = null; _showForm = true; }
    private void OpenEdit(ApPaymentDto payment) { _editingId = payment.ApPaymentId; _form = new ApPaymentForm { VendorId = payment.VendorId, ApInvoiceId = payment.ApInvoiceId, PaymentDate = payment.PaymentDate.ToDateTime(TimeOnly.MinValue), Amount = payment.Amount, PaymentMethodCode = payment.PaymentMethodCode, ReferenceNumber = payment.ReferenceNumber, Notes = payment.Notes, StatusCode = payment.StatusCode }; _editContext = new(_form); _formError = null; _showForm = true; }
    private void CloseForm() => _showForm = false;
    private async Task SaveAsync()
    {
        if (!_editContext.Validate()) return;
        _saving = true;
        try
        {
            if (_editingId == Guid.Empty)
                await Api.CreateApPaymentAsync(new CreateApPaymentRequest { TenantId = _tenantId, VendorId = _form.VendorId, ApInvoiceId = _form.ApInvoiceId, PaymentDate = DateOnly.FromDateTime(_form.PaymentDate), Amount = _form.Amount, PaymentMethodCode = _form.PaymentMethodCode, ReferenceNumber = _form.ReferenceNumber, Notes = _form.Notes, StatusCode = _form.StatusCode });
            else
                await Api.UpdateApPaymentAsync(_editingId, new UpdateApPaymentRequest { TenantId = _tenantId, ApPaymentId = _editingId, VendorId = _form.VendorId, ApInvoiceId = _form.ApInvoiceId, PaymentDate = DateOnly.FromDateTime(_form.PaymentDate), Amount = _form.Amount, PaymentMethodCode = _form.PaymentMethodCode, ReferenceNumber = _form.ReferenceNumber, Notes = _form.Notes, StatusCode = _form.StatusCode });
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; }
        finally { _saving = false; }
    }

    private sealed class ApPaymentForm
    {
        [RequiredGuid(ErrorMessage = "Vendor is required.")] public Guid VendorId { get; set; }
        public Guid? ApInvoiceId { get; set; }
        [Required] public DateTime PaymentDate { get; set; } = DateTime.Today;
        [Range(0.01, 100000000)] public decimal Amount { get; set; }
        [Required, StringLength(50)] public string PaymentMethodCode { get; set; } = "ACH";
        [StringLength(100)] public string? ReferenceNumber { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
        [Required, StringLength(50)] public string StatusCode { get; set; } = "Pending";
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
