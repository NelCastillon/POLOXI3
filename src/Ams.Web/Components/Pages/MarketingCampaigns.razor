@page "/marketing/campaigns"
@page "/communications/campaigns"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Marketing Campaigns — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Campaigns Administration"
               Subtitle="Tenant admin campaign control for launch readiness, channel performance, reach, conversions, and attributed revenue"
               Icon="bi-megaphone-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/marketing/analytics")'>
            <i class="bi bi-bar-chart" aria-hidden="true"></i> Analytics
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/marketing/rules-engine")'>
            <i class="bi bi-lightning-charge" aria-hidden="true"></i> Rules Engine
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/marketing/campaigns/new")'>
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Campaign
        </button>
    </Actions>
</AppPageHeader>

<section class="ma-hero comm-hero">
    <div>
        <span class="ma-eyebrow">Tenant Administration · Campaigns</span>
        <h2>Tenant Campaign Control Center</h2>
        <p>Administer tenant-wide communication campaigns, segments, launch status, channel mix, engagement performance, conversions, and compliance readiness.</p>
    </div>
    <div class="ma-hero-actions">
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/inbox")'><i class="bi bi-inbox"></i> Inbox</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/templates")'><i class="bi bi-layout-text-sidebar"></i> Templates</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/outreach")'><i class="bi bi-telephone-outbound"></i> Outreach Queue</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/notifications")'><i class="bi bi-bell"></i> Notifications</button>
    </div>
</section>

<!-- Sub-nav -->
<div class="mkc-subnav">
    <button class="mkc-snav-btn mkc-snav-active"><i class="bi bi-megaphone" aria-hidden="true"></i> Campaigns</button>
    <button class="mkc-snav-btn" @onclick='() => Nav.NavigateTo("/marketing/segments")'><i class="bi bi-pie-chart" aria-hidden="true"></i> Segments</button>
    <button class="mkc-snav-btn" @onclick='() => Nav.NavigateTo("/marketing/cross-sell")'><i class="bi bi-arrows-expand" aria-hidden="true"></i> Cross-Sell</button>
    <button class="mkc-snav-btn" @onclick='() => Nav.NavigateTo("/marketing/win-back")'><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Win-Back</button>
    <button class="mkc-snav-btn" @onclick='() => Nav.NavigateTo("/marketing/referrals")'><i class="bi bi-person-plus" aria-hidden="true"></i> Referrals</button>
    <button class="mkc-snav-btn" @onclick='() => Nav.NavigateTo("/marketing/reviews")'><i class="bi bi-star" aria-hidden="true"></i> Reviews</button>
    <button class="mkc-snav-btn" @onclick='() => Nav.NavigateTo("/marketing/rules-engine")'><i class="bi bi-lightning-charge" aria-hidden="true"></i> Rules Engine</button>
</div>

<!-- KPI strip -->
<div class="mkc-kpi-strip">
    <div class="mkc-kpi-card">
        <i class="bi bi-megaphone mkc-ki mkc-ki-blue" aria-hidden="true"></i>
        <div><div class="mkc-kv">@_campaigns.Count</div><div class="mkc-kl">Total Campaigns</div></div>
    </div>
    <div class="mkc-kpi-card">
        <i class="bi bi-play-circle mkc-ki mkc-ki-green" aria-hidden="true"></i>
        <div><div class="mkc-kv">@_campaigns.Count(c => c.Status == "Active")</div><div class="mkc-kl">Active</div></div>
    </div>
    <div class="mkc-kpi-card">
        <i class="bi bi-people mkc-ki mkc-ki-blue" aria-hidden="true"></i>
        <div><div class="mkc-kv">@_campaigns.Sum(c => c.Reached).ToString("N0")</div><div class="mkc-kl">Total Reached</div></div>
    </div>
    <div class="mkc-kpi-card">
        <i class="bi bi-cursor mkc-ki mkc-ki-amber" aria-hidden="true"></i>
        <div><div class="mkc-kv">@(_campaigns.Any() ? (_campaigns.Average(c => c.OpenRate)).ToString("N1") : "0.0")%</div><div class="mkc-kl">Avg. Open Rate</div></div>
    </div>
    <div class="mkc-kpi-card">
        <i class="bi bi-trophy mkc-ki mkc-ki-green" aria-hidden="true"></i>
        <div><div class="mkc-kv">@_campaigns.Sum(c => c.Conversions).ToString("N0")</div><div class="mkc-kl">Conversions</div></div>
    </div>
    <div class="mkc-kpi-card">
        <i class="bi bi-cash-coin mkc-ki mkc-ki-green" aria-hidden="true"></i>
        <div><div class="mkc-kv">@_campaigns.Sum(c => c.Revenue).ToString("C0")</div><div class="mkc-kl">Revenue Attributed</div></div>
    </div>
</div>

<!-- Filters -->
<div class="mkc-filter-bar">
    <div class="mkc-search-wrap">
        <i class="bi bi-search mkc-si" aria-hidden="true"></i>
        <input class="mkc-search" type="search" placeholder="Search campaigns…"
               @oninput="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => { _search = e.Value?.ToString() ?? ""; ApplyFilters(); })" />
    </div>
    <select class="mkc-sel" @bind="_filterStatus" @bind:after="ApplyFilters">
        <option value="">All Statuses</option>
        <option value="Draft">Draft</option>
        <option value="Scheduled">Scheduled</option>
        <option value="Active">Active</option>
        <option value="Paused">Paused</option>
        <option value="Completed">Completed</option>
    </select>
    <select class="mkc-sel" @bind="_filterType" @bind:after="ApplyFilters">
        <option value="">All Types</option>
        <option value="Email">Email</option>
        <option value="SMS">SMS</option>
        <option value="Direct Mail">Direct Mail</option>
        <option value="Multi-Channel">Multi-Channel</option>
    </select>
</div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

<!-- Grid -->
<div class="mkc-grid-card app-datagrid">
    <SfGrid CssClass="marketing-grid" TValue="CampaignRow" DataSource="_filtered" AllowPaging="true" AllowSorting="true" AllowFiltering="true"
            AllowTextWrap="true" EnableHover="true" RowHeight="64">
        <GridTextWrapSettings WrapMode="WrapMode.Content" />
        <GridEvents TValue="CampaignRow" RowSelected="OnRowSelected" />
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
        <GridPageSettings PageSize="20" PageSizes="@(new int[]{10,20,50})" />
        <GridColumns>
            <GridColumn HeaderText="Campaign" MinWidth="340" Field="@nameof(CampaignRow.Name)">
                <Template>
                    @{ var c = (CampaignRow)context; }
                    <div class="mkc-name-cell">
                        <div class="mkc-type-icon @TypeIconCss(c.Type)"><i class="bi @TypeIcon(c.Type)" aria-hidden="true"></i></div>
                        <div>
                            <div class="mkc-item-name">@c.Name</div>
                            <div class="mkc-item-sub">@c.Type · @c.Segment</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(CampaignRow.Status)" HeaderText="Status" Width="120">
                <Template>@{ var c = (CampaignRow)context; }<span class="@StatusBadge(c.Status)">@c.Status</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(CampaignRow.StartDate)" HeaderText="Start" Width="110" Type="ColumnType.Date" Format="MMM d, yyyy" />
            <GridColumn Field="@nameof(CampaignRow.Reached)" HeaderText="Reached" Width="110" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>@{ var c = (CampaignRow)context; }<span class="mkc-mono">@c.Reached.ToString("N0")</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(CampaignRow.OpenRate)" HeaderText="Open %" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>@{ var c = (CampaignRow)context; }<span class="mkc-mono">@c.OpenRate.ToString("N1")%</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(CampaignRow.Conversions)" HeaderText="Conv." Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>@{ var c = (CampaignRow)context; }<span class="mkc-mono mkc-bold">@c.Conversions</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(CampaignRow.Revenue)" HeaderText="Revenue" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>@{ var c = (CampaignRow)context; }<span class="mkc-mono mkc-bold">@c.Revenue.ToString("C0")</span></Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="96" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>
                    @{ var c = (CampaignRow)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm"
                            @onclick:stopPropagation="true"
                            @onclick='() => Nav.NavigateTo($"/marketing/campaigns/{c.Id}")'>
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private SfToast? _toast;
    private Guid _tenantId;
    private string _search = "";
    private string _filterStatus = "";
    private string _filterType = "";
    private string? _loadError;

    private List<CampaignRow> _campaigns = [];
    private List<CampaignRow> _filtered  = [];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Communications","/communications/inbox"), new("Campaigns",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            var result = await Api.SearchCommunicationCampaignsAsync(_tenantId, _search);
            _campaigns = result?.Items.Select(c => new CampaignRow(c.CampaignId, c.Name, c.Type, c.Status, c.Segment, c.StartDate, c.Reached, c.OpenRate, c.Conversions, c.Revenue)).ToList() ?? [];
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load campaigns: {ex.Message}";
            _campaigns = [];
            _filtered = [];
        }
    }

    private void ApplyFilters()
    {
        _filtered = _campaigns.Where(c =>
            (string.IsNullOrEmpty(_filterStatus) || c.Status == _filterStatus) &&
            (string.IsNullOrEmpty(_filterType)   || c.Type   == _filterType) &&
            (string.IsNullOrEmpty(_search) ||
             c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             c.Segment.Contains(_search, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    private void OnRowSelected(RowSelectEventArgs<CampaignRow> args) => Nav.NavigateTo($"/marketing/campaigns/{args.Data.Id}");

    private static string StatusBadge(string s) => s switch
    {
        "Active"    => "mkc-status mkc-st--active",
        "Scheduled" => "mkc-status mkc-st--scheduled",
        "Paused"    => "mkc-status mkc-st--paused",
        "Completed" => "mkc-status mkc-st--completed",
        _           => "mkc-status mkc-st--draft",
    };
    private static string TypeIconCss(string t) => t switch
    {
        "Email"        => "mkc-ti-email",
        "SMS"          => "mkc-ti-sms",
        "Direct Mail"  => "mkc-ti-dm",
        _              => "mkc-ti-multi",
    };
    private static string TypeIcon(string t) => t switch
    {
        "Email"       => "bi-envelope",
        "SMS"         => "bi-phone",
        "Direct Mail" => "bi-mailbox",
        _             => "bi-diagram-3",
    };

    private sealed record CampaignRow(Guid Id, string Name, string Type, string Status, string Segment,
        DateTime StartDate, int Reached, decimal OpenRate, int Conversions, decimal Revenue);

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
