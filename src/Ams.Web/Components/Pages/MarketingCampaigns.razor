    private IReadOnlyList<KpiModel> Kpis => [new("all", "Campaigns", _items.Count.ToString("N0"), "All records", "bi-megaphone", "mkc-ki-blue"), new("Active", "Active", ActiveCount.ToString("N0"), "Live now", "bi-play-circle", "mkc-ki-green"), new("Scheduled", "Scheduled", ScheduledCount.ToString("N0"), "Queued", "bi-calendar-check", "mkc-ki-blue"), new("Paused", "Paused", PausedCount.ToString("N0"), "On hold", "bi-pause-circle", "mkc-ki-amber"), new("converting", "Conversions", TotalConversions.ToString("N0"), "Attributed wins", "bi-trophy", "mkc-ki-purple"), new("revenue", "Revenue", TotalRevenue.ToString("C0"), "Pipeline value", "bi-cash-coin", "mkc-ki-green")];
    private string SearchFilter { get => _searchTerm; set { _searchTerm = value; ApplyFilters(resetPage: true); } }
    private string StatusFilter { get => _statusFilter; set { _statusFilter = value; ApplyFilters(resetPage: true); } }
    private string TypeFilter { get => _typeFilter; set { _typeFilter = value; ApplyFilters(resetPage: true); } }

    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Marketing", "/marketing/campaigns"), new("Campaigns", "/marketing/campaigns")); await LoadAsync(); }
    private async Task LoadAsync() { _loading = true; _loadError = null; try { await Api.EnsureCommunicationCampaignSeedAsync(_tenantId); var result = await Api.SearchCommunicationCampaignsAsync(_tenantId, string.Empty); _items = result?.Items.OrderBy(x => StatusSort(x.Status)).ThenByDescending(x => x.StartDate).ToList() ?? []; ApplyFilters(resetPage: true); EnsureSelectedStillVisible(); } catch (Exception ex) { _loadError = $"Marketing campaigns failed to load: {ex.Message}"; ShowToast(_loadError, "danger"); _items = []; _filtered = []; _selected = null; } finally { _loading = false; } }
    private void ApplyFilters(bool resetPage) { IEnumerable<CommunicationCampaignDto> query = _items; if (!string.IsNullOrWhiteSpace(_searchTerm)) { var term = _searchTerm.Trim(); query = query.Where(x => Contains(x.Name, term) || Contains(x.Segment, term) || Contains(x.Type, term) || Contains(x.Status, term) || Contains(x.Goal, term) || Contains(x.Subject, term) || Contains(x.CampaignId.ToString(), term)); } if (!string.IsNullOrWhiteSpace(_statusFilter)) query = query.Where(x => x.Status == _statusFilter); if (!string.IsNullOrWhiteSpace(_typeFilter)) query = query.Where(x => x.Type == _typeFilter); query = _kpiFilter switch { "Active" => query.Where(x => x.Status == "Active"), "Scheduled" => query.Where(x => x.Status == "Scheduled"), "Paused" => query.Where(x => x.Status == "Paused"), "converting" => query.Where(x => x.Conversions > 0), "revenue" => query.Where(x => x.Revenue > 0), _ => query }; _filtered = query.OrderBy(x => StatusSort(x.Status)).ThenByDescending(x => x.StartDate).ToList(); if (resetPage) _page = 1; if (_page > TotalPages) _page = TotalPages; }
    private void SetKpiFilter(string filter) { _kpiFilter = _kpiFilter == filter && filter != "all" ? "all" : filter; if (_statuses.Contains(_kpiFilter)) _statusFilter = _kpiFilter; else if (_kpiFilter != "all") _statusFilter = string.Empty; ApplyFilters(resetPage: true); }
    private void ResetFilters() { _searchTerm = string.Empty; _statusFilter = string.Empty; _typeFilter = string.Empty; _kpiFilter = "all"; ApplyFilters(resetPage: true); ShowToast("Campaign filters reset.", "info"); }
    private void SelectCampaign(CommunicationCampaignDto item) => _selected = item;
    private void OpenCreate() { _editingId = Guid.Empty; _formError = null; _form = new CampaignForm { Name = $"Campaign {DateTime.UtcNow:MMM yyyy}", Type = "Email", Status = "Draft", Segment = "Active Commercial Clients", Goal = "Cross-Sell", Description = "Targeted campaign for tenant marketing workflow.", Subject = "Coverage opportunities for your business", SenderName = "AgencyBinder Team", ReplyToEmail = "marketing@agencybinder.local", TemplateName = "Insurance Benefit Card", CtaLabel = "Get a Quote", SendMode = "Scheduled", Timezone = "Eastern", StartDate = DateTime.Today.AddDays(7), EndDate = DateTime.Today.AddDays(21), ScheduledDateUtc = DateTime.Today.AddDays(7), FollowUpDays = 7, SendFollowUp = true, SuppressRecentContacts = true, SuppressOptOut = true }; _showForm = true; }
    private void OpenEdit(CommunicationCampaignDto item) { _editingId = item.CampaignId; _formError = null; _form = CampaignForm.FromDto(item); _showForm = true; }
    private void CloseForm() { if (_busy) return; _showForm = false; }
    private async Task SaveAsync() { if (!ValidateForm()) return; _busy = true; _formError = null; var savedId = _editingId; try { if (_editingId == Guid.Empty) { savedId = await Api.CreateCommunicationCampaignAsync(ToDto(Guid.Empty)); ShowToast("Marketing campaign created.", "success"); } else { await Api.UpdateCommunicationCampaignAsync(_editingId, ToDto(_editingId)); ShowToast("Marketing campaign updated.", "success"); } _showForm = false; await LoadAsync(); _selected = _items.FirstOrDefault(x => x.CampaignId == savedId) ?? _selected; } catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; ShowToast(_formError, "danger"); } finally { _busy = false; } }
    private Task NotifyValidationAsync(EditContext _) { ShowToast("Please correct validation errors before saving.", "warning"); return Task.CompletedTask; }
    private CommunicationCampaignDto ToDto(Guid id) => new() { CampaignId = id, TenantId = _tenantId, Name = _form.Name, Type = _form.Type, Status = _form.Status, Segment = _form.Segment, Goal = _form.Goal, Description = _form.Description ?? string.Empty, Subject = _form.Subject ?? string.Empty, SenderName = _form.SenderName ?? string.Empty, ReplyToEmail = _form.ReplyToEmail ?? string.Empty, TemplateName = _form.TemplateName ?? string.Empty, CtaLabel = _form.CtaLabel ?? string.Empty, SendMode = _form.SendMode ?? string.Empty, Timezone = _form.Timezone ?? string.Empty, FollowUpDays = _form.FollowUpDays, SendFollowUp = _form.SendFollowUp, SuppressRecentContacts = _form.SuppressRecentContacts, SuppressOptOut = _form.SuppressOptOut, AbTestSubject = _form.AbTestSubject, EndDate = _form.EndDate, ScheduledDateUtc = _form.ScheduledDateUtc, LandingPageSlug = Slug(_form.Name), LandingPageUrl = _form.LandingPageUrl ?? string.Empty, StartDate = _form.StartDate, Reached = _form.Reached, OpenRate = _form.OpenRate, Conversions = _form.Conversions, Revenue = _form.Revenue };
    private void ActivateSelected() { if (_selected is not null) ConfirmStatusUpdate(_selected, "Active"); }
    private void PauseSelected() { if (_selected is not null) ConfirmStatusUpdate(_selected, "Paused"); }
    private void ScheduleSelected() { if (_selected is not null) ConfirmStatusUpdate(_selected, "Scheduled"); }
    private void OpenBuilder() { if (_selected is not null) Nav.NavigateTo($"/marketing/campaigns/new?campaignId={_selected.CampaignId}&mode=edit"); }
    private void ConfirmStatusUpdate(CommunicationCampaignDto item, string status) { _statusTarget = item; _pendingStatus = status; _showStatusConfirm = true; }
    private void CancelStatusUpdate() { if (_busy) return; _showStatusConfirm = false; _statusTarget = null; _pendingStatus = null; }
    private async Task ExecuteStatusUpdateAsync() { if (_statusTarget is null || string.IsNullOrWhiteSpace(_pendingStatus)) return; _busy = true; var selectedId = _statusTarget.CampaignId; try { var updated = CloneCampaign(_statusTarget); updated.Status = _pendingStatus; if (_pendingStatus == "Scheduled") updated.ScheduledDateUtc = updated.ScheduledDateUtc ?? DateTime.UtcNow.AddDays(1); if (_pendingStatus == "Active") updated.StartDate = DateTime.Today; await Api.UpdateCommunicationCampaignAsync(updated.CampaignId, updated); ShowToast($"Campaign marked {_pendingStatus.ToLowerInvariant()}.", "success"); _showStatusConfirm = false; _statusTarget = null; _pendingStatus = null; await LoadAsync(); _selected = _items.FirstOrDefault(x => x.CampaignId == selectedId) ?? _selected; } catch (Exception ex) { ShowToast($"Update failed: {ex.Message}", "danger"); } finally { _busy = false; } }
    private async Task DuplicateCampaignAsync(CommunicationCampaignDto item) { _busy = true; try { var copy = CloneCampaign(item); copy.CampaignId = Guid.Empty; copy.Name = $"{item.Name} Copy"; copy.Status = "Draft"; copy.StartDate = DateTime.Today.AddDays(7); copy.ScheduledDateUtc = null; var id = await Api.CreateCommunicationCampaignAsync(copy); ShowToast("Campaign duplicated.", "success"); await LoadAsync(); _selected = _items.FirstOrDefault(x => x.CampaignId == id) ?? _selected; } catch (Exception ex) { ShowToast($"Duplicate failed: {ex.Message}", "danger"); } finally { _busy = false; } }
    private async Task ExportAsync() { if (!_filtered.Any()) { ShowToast("No campaigns are available to export.", "warning"); return; } var csv = new StringBuilder(); csv.AppendLine("CampaignId,Name,Type,Status,Segment,Goal,StartDate,Reached,OpenRate,Conversions,Revenue"); foreach (var item in _filtered) csv.AppendLine(string.Join(',', Csv(item.CampaignId.ToString()), Csv(item.Name), Csv(item.Type), Csv(item.Status), Csv(item.Segment), Csv(item.Goal), Csv(item.StartDate.ToString("yyyy-MM-dd")), item.Reached, item.OpenRate, item.Conversions, item.Revenue)); var bytes = Encoding.UTF8.GetBytes(csv.ToString()); await Js.InvokeVoidAsync("amsShell.downloadBase64", $"marketing-campaigns-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes)); ShowToast($"Exported {_filtered.Count:N0} campaigns.", "success"); }
    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void HideToast() => _toastVisible = false;
