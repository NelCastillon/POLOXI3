    private static string Blank(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string Csv(string value) { var quote = Convert.ToChar(34).ToString(); return string.Concat(quote, value.Replace(quote, quote + quote), quote); }
    private static string Slug(string value) => string.Join('-', value.ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
    private string KpiClass(KpiModel kpi) => $"mkc-kpi-card {kpi.Tone} {(_kpiFilter == kpi.Filter || (_kpiFilter == "all" && kpi.Filter == "all") ? "mkc-kpi-active" : string.Empty)}";
