@page "/marketing/campaigns"
@page "/communications/campaigns"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Communications Campaigns — AMS</PageTitle>

@if (_toastVisible)
{
    <div class="mkc-toast mkc-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : _toastKind == "info" ? "bi-info-circle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <div>
            <strong>@_toastTitle</strong>
            <span>@_toastMessage</span>
        </div>
        <button type="button" class="mkc-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showScheduleDialog && _selected is not null)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseScheduleDialog">
        <div class="mt-modal mkc-schedule-modal" role="dialog" aria-modal="true" aria-labelledby="mkc-schedule-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-calendar-check" aria-hidden="true"></i>
                <span id="mkc-schedule-title">Schedule campaign</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseScheduleDialog"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_schedule" OnValidSubmit="ConfirmScheduleAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="mkc-modal-intro">
                        <span class="mkc-modal-chip"><i class="bi bi-megaphone" aria-hidden="true"></i> @_selected.Name</span>
                        <p>Choose the launch window and owner for this campaign schedule. This opens a campaign scheduling workflow without changing the current KPI filter.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field">
                            <label>Launch Date <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="_schedule.LaunchDate" />
                            <ValidationMessage For="() => _schedule.LaunchDate" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Launch Time <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_schedule.LaunchTime" placeholder="09:00 AM" />
                            <ValidationMessage For="() => _schedule.LaunchTime" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Owner <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_schedule.Owner" />
                            <ValidationMessage For="() => _schedule.Owner" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Channel</label>
                            <InputSelect class="form-select" @bind-Value="_schedule.Channel">
                                <option>Email</option>
                                <option>SMS</option>
                                <option>Direct Mail</option>
                                <option>Multi-Channel</option>
                            </InputSelect>
                            <ValidationMessage For="() => _schedule.Channel" class="text-danger" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Schedule Notes</label>
                            <InputTextArea class="form-control" @bind-Value="_schedule.Notes" rows="4" placeholder="Launch checklist, approval notes, or timing instructions…" />
                            <ValidationMessage For="() => _schedule.Notes" class="text-danger" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseScheduleDialog">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary"><i class="bi bi-calendar-check" aria-hidden="true"></i> Confirm Schedule</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<section class="mkc-enterprise-page">
    <div class="mkc-hero">
        <div class="mkc-hero-left">
            <div class="mkc-hero-icon"><i class="bi bi-megaphone-fill" aria-hidden="true"></i></div>
            <div class="mkc-hero-info">
                <div class="mkc-eyebrow">Tenant Administration · Communications Campaigns</div>
                <div class="mkc-title-row">
                    <h1>Tenant Campaign Control Center</h1>
                    <span class="mkc-status-pill">@Filtered.Count() campaigns</span>
                    @if (HasFilters)
                    {
                        <span class="mkc-filter-pill">Filtered</span>
                    }
                </div>
                <p>Administer tenant-wide communication campaigns, segments, launch status, channel mix, engagement performance, conversions, and compliance readiness.</p>
            </div>
        </div>
        <div class="mkc-hero-actions">
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="Refresh"><i class="bi bi-arrow-clockwise @(_loading ? "mkc-spin" : "")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="NewCampaign"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Campaign</button>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/communications/inbox")'><i class="bi bi-inbox" aria-hidden="true"></i> Inbox</button>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/communications/templates")'><i class="bi bi-layout-text-sidebar" aria-hidden="true"></i> Templates</button>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/communications/outreach")'><i class="bi bi-telephone-outbound" aria-hidden="true"></i> Outreach Queue</button>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/communications/notifications")'><i class="bi bi-bell" aria-hidden="true"></i> Notifications</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger mkc-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError
        </div>
    }

    <div class="mkc-subnav" aria-label="Campaign modules">
        <button class="mkc-snav-btn mkc-snav-active" type="button"><i class="bi bi-megaphone" aria-hidden="true"></i> Campaigns</button>
        <button class="mkc-snav-btn" type="button" @onclick='() => Nav.NavigateTo("/marketing/segments")'><i class="bi bi-pie-chart" aria-hidden="true"></i> Segments</button>
        <button class="mkc-snav-btn" type="button" @onclick='() => Nav.NavigateTo("/marketing/cross-sell")'><i class="bi bi-arrows-expand" aria-hidden="true"></i> Cross-Sell</button>
        <button class="mkc-snav-btn" type="button" @onclick='() => Nav.NavigateTo("/marketing/win-back")'><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Win-Back</button>
        <button class="mkc-snav-btn" type="button" @onclick='() => Nav.NavigateTo("/marketing/referrals")'><i class="bi bi-person-plus" aria-hidden="true"></i> Referrals</button>
        <button class="mkc-snav-btn" type="button" @onclick='() => Nav.NavigateTo("/marketing/reviews")'><i class="bi bi-star" aria-hidden="true"></i> Reviews</button>
        <button class="mkc-snav-btn" type="button" @onclick='() => Nav.NavigateTo("/marketing/rules-engine")'><i class="bi bi-lightning-charge" aria-hidden="true"></i> Rules Engine</button>
    </div>

    <div class="mkc-kpi-strip">
        @KpiCard("bi-megaphone", "Total Campaigns", _campaigns.Count.ToString(), "mkc-ki-blue", "all")
        @KpiCard("bi-play-circle", "Active", _campaigns.Count(c => c.Status == "Active").ToString(), "mkc-ki-green", "Active")
        @KpiCard("bi-calendar-check", "Scheduled", _campaigns.Count(c => c.Status == "Scheduled").ToString(), "mkc-ki-blue", "Scheduled")
        @KpiCard("bi-pause-circle", "Paused", _campaigns.Count(c => c.Status == "Paused").ToString(), "mkc-ki-amber", "Paused")
        @KpiCard("bi-trophy", "Conversions", _campaigns.Sum(c => c.Conversions).ToString("N0"), "mkc-ki-green", "converting")
        @KpiCard("bi-cash-coin", "Revenue", _campaigns.Sum(c => c.Revenue).ToString("C0"), "mkc-ki-green", "revenue")
    </div>

    <div class="mkc-enterprise-search" role="search" aria-label="Search campaigns">
        <div class="mkc-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
        <div class="mkc-search-body">
            <label for="mkc-search-input">Enterprise search</label>
            <input id="mkc-search-input" class="mkc-search" type="search" placeholder="Search campaigns, segment, type, status, performance…" @bind="SearchText" @bind:event="oninput" />
            <div class="mkc-search-hint">Searches campaign name, segment, status, type, dates, reach, conversions, revenue, and campaign IDs.</div>
        </div>
        <select class="mkc-sel" @bind="_filterStatus" @bind:after="ApplyFilters" aria-label="Filter by status">
            <option value="">All Statuses</option>
            <option value="Draft">Draft</option>
            <option value="Scheduled">Scheduled</option>
            <option value="Active">Active</option>
            <option value="Paused">Paused</option>
            <option value="Completed">Completed</option>
        </select>
        <select class="mkc-sel" @bind="_filterType" @bind:after="ApplyFilters" aria-label="Filter by type">
            <option value="">All Types</option>
            <option value="Email">Email</option>
            <option value="SMS">SMS</option>
            <option value="Direct Mail">Direct Mail</option>
            <option value="Multi-Channel">Multi-Channel</option>
        </select>
        <div class="mkc-search-result"><strong>@Filtered.Count()</strong><span>matches</span></div>
        <button type="button" class="um-btn um-btn-ghost um-btn-sm mkc-search-clear" @onclick="ResetFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
    </div>

    <div class="mkc-layout">
        <div class="mkc-list-pane">
            <div class="mkc-grid-toolbar">
                <div>
                    <strong>@Filtered.Count()</strong> campaigns
                    @if (HasFilters)
                    {
                        <span class="mkc-filter-note">filtered</span>
                    }
                </div>
                <div class="mkc-grid-tools">
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ExportAsync" disabled="@(!Filtered.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="mkc-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading campaigns…</span></div>
            }
            else
            {
                <div class="mkc-table-scroll">
                    <table class="mkc-table" aria-label="Communications campaigns">
                        <thead>
                            <tr>
                                <th>Campaign</th>
                                <th>Status</th>
                                <th>Start</th>
                                <th class="mkc-num">Reached</th>
                                <th class="mkc-num">Open %</th>
                                <th class="mkc-num">Conv.</th>
                                <th class="mkc-num">Revenue</th>
                                <th class="mkc-actions-col"><span class="visually-hidden">Details</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Filtered.Any())
                            {
                                <tr>
                                    <td colspan="8">
                                        <div class="mkc-empty-state">
                                            <i class="bi bi-megaphone" aria-hidden="true"></i>
                                            <strong>No campaigns found</strong>
                                            <span>Adjust KPI, status, type, or search criteria.</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var campaign in Filtered)
                                {
                                    <tr class="mkc-table-row @(_selected?.Id == campaign.Id ? "mkc-table-row--selected" : "")" @onclick="() => SelectCampaign(campaign)">
                                        <td>@CampaignCell(campaign)</td>
                                        <td><span class="@StatusBadge(campaign.Status)">@campaign.Status</span></td>
                                        <td>@campaign.StartDate.ToString("MMM d, yyyy")</td>
                                        <td class="mkc-num mkc-mono">@campaign.Reached.ToString("N0")</td>
                                        <td class="mkc-num mkc-mono">@campaign.OpenRate.ToString("N1")%</td>
                                        <td class="mkc-num mkc-mono mkc-bold">@campaign.Conversions.ToString("N0")</td>
                                        <td class="mkc-num mkc-mono mkc-bold mkc-revenue">@campaign.Revenue.ToString("C0")</td>
                                        <td class="mkc-actions-col">
                                            <button type="button" class="um-btn um-btn-ghost um-btn-sm mkc-arrow-btn" title="Open details" @onclick:stopPropagation="true" @onclick="() => SelectCampaign(campaign)">
                                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <aside class="mkc-detail-pane @(_selected is null ? "mkc-detail-empty" : "")" aria-label="Campaign details">
            @if (_selected is null)
            {
                <div class="mkc-detail-placeholder">
                    <i class="bi bi-arrow-right-circle mkc-dp-icon" aria-hidden="true"></i>
                    <h3>Select a campaign</h3>
                    <p>Use the row arrow to inspect campaign readiness, channel performance, revenue, and workflow actions.</p>
                </div>
            }
            else
            {
                <div class="mkc-detail-header">
                    <div class="mkc-dh-left">
                        <div class="mkc-type-icon @TypeIconCss(_selected.Type)"><i class="bi @TypeIcon(_selected.Type)" aria-hidden="true"></i></div>
                        <div>
                            <div class="mkc-dh-title">@_selected.Name</div>
                            <div class="mkc-dh-meta">@_selected.Type · @_selected.Segment · @_selected.StartDate.ToString("MMM d, yyyy")</div>
                        </div>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close details"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>

                <div class="mkc-detail-body">
                    <span class="@StatusBadge(_selected.Status)">@_selected.Status</span>
                    <div class="mkc-detail-grid">
                        <div><span>Reached</span><strong>@_selected.Reached.ToString("N0")</strong></div>
                        <div><span>Open Rate</span><strong>@_selected.OpenRate.ToString("N1")%</strong></div>
                        <div><span>Conversions</span><strong>@_selected.Conversions.ToString("N0")</strong></div>
                        <div><span>Revenue</span><strong>@_selected.Revenue.ToString("C0")</strong></div>
                    </div>

                    <div class="mkc-policy-card">
                        <strong>Campaign controls</strong>
                        <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Opt-out and consent policy required</span>
                        <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Template governance and channel readiness tracked</span>
                        <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Revenue and conversion attribution monitored</span>
                    </div>

                    <div class="mkc-detail-actions">
                        <button type="button" class="um-btn um-btn-primary" @onclick="OpenCampaign"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Campaign</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="OpenMessaging"><i class="bi bi-chat-dots" aria-hidden="true"></i> Messaging</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="DuplicateCampaign"><i class="bi bi-files" aria-hidden="true"></i> Duplicate</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="ScheduleCampaign"><i class="bi bi-calendar-check" aria-hidden="true"></i> Schedule</button>
                    </div>
                </div>
            }
        </aside>
    </div>
</section>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string _search = string.Empty;
    private string _filterStatus = string.Empty;
    private string _filterType = string.Empty;
    private string? _activeKpi;
    private string? _loadError;
    private bool _loading;
    private bool _toastVisible;
    private bool _showScheduleDialog;
    private string _toastTitle = string.Empty;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private CampaignScheduleForm _schedule = new();

    private List<CampaignRow> _campaigns = [];
    private CampaignRow? _selected;

    IEnumerable<CampaignRow> Filtered => _campaigns.Where(MatchesFilters);
    bool HasFilters => !string.IsNullOrWhiteSpace(_search) || !string.IsNullOrWhiteSpace(_filterStatus) || !string.IsNullOrWhiteSpace(_filterType) || _activeKpi is not null;

    string SearchText
    {
        get => _search;
        set => _search = value ?? string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Communications", "/communications/inbox"), new("Campaigns", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchCommunicationCampaignsAsync(_tenantId, _search);
            _campaigns = result?.Items.Select(c => new CampaignRow(c.CampaignId, c.Name, c.Type, c.Status, c.Segment, c.StartDate, c.Reached, c.OpenRate, c.Conversions, c.Revenue)).ToList() ?? [];
            _selected = _selected is null ? null : _campaigns.FirstOrDefault(c => c.Id == _selected.Id);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load campaigns: {ex.Message}";
            ShowToast("Campaigns unavailable", $"Failed to load campaigns: {ex.Message}", "danger");
            _campaigns = [];
            _selected = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private bool MatchesFilters(CampaignRow c)
    {
        if (!string.IsNullOrEmpty(_filterStatus) && c.Status != _filterStatus) return false;
        if (!string.IsNullOrEmpty(_filterType) && c.Type != _filterType) return false;
        if (_activeKpi is not null && !MatchesKpi(c)) return false;
        if (string.IsNullOrWhiteSpace(_search)) return true;

        var term = _search.Trim();
        return Contains(c.Name, term)
            || Contains(c.Segment, term)
            || Contains(c.Type, term)
            || Contains(c.Status, term)
            || Contains(c.Id.ToString(), term)
            || Contains(c.StartDate.ToString("MMM d, yyyy"), term)
            || Contains(c.StartDate.ToString("yyyy-MM-dd"), term)
            || Contains(c.Reached.ToString(), term)
            || Contains(c.Conversions.ToString(), term)
            || Contains(c.Revenue.ToString("C0"), term);
    }

    private bool MatchesKpi(CampaignRow c) => _activeKpi switch
    {
        "Active" => c.Status == "Active",
        "Scheduled" => c.Status == "Scheduled",
        "Paused" => c.Status == "Paused",
        "converting" => c.Conversions > 0,
        "revenue" => c.Revenue > 0,
        null or "all" => true,
        _ => true
    };

    private static bool Contains(string? source, string term) => !string.IsNullOrWhiteSpace(source) && source.Contains(term, StringComparison.OrdinalIgnoreCase);

    private void ApplyFilters() => _selected = _selected is null || Filtered.Any(c => c.Id == _selected.Id) ? _selected : null;

    private void SetKpiFilter(string key)
    {
        _activeKpi = _activeKpi == key || key == "all" ? null : key;
        if (key is "Active" or "Scheduled" or "Paused")
        {
            _filterStatus = _activeKpi == key ? key : string.Empty;
        }
        else
        {
            _filterStatus = string.Empty;
        }
        ApplyFilters();
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _filterStatus = string.Empty;
        _filterType = string.Empty;
        _activeKpi = null;
        _selected = null;
    }

    private async Task Refresh() => await LoadAsync();
    private void SelectCampaign(CampaignRow campaign) => _selected = campaign;
    private void NewCampaign() => Nav.NavigateTo("/marketing/campaigns/new");
    private void OpenCampaign() { if (_selected is not null) Nav.NavigateTo($"/marketing/campaigns/new?campaignId={_selected.Id}&mode=edit"); }
    private void OpenMessaging() { if (_selected is not null) Nav.NavigateTo($"/communications/campaigns2?campaignId={_selected.Id}"); }
    private void ScheduleCampaign()
    {
        if (_selected is null) return;
        _schedule = new CampaignScheduleForm
        {
            LaunchDate = _selected.StartDate.Date < DateTime.Today ? DateTime.Today : _selected.StartDate.Date,
            LaunchTime = "09:00 AM",
            Owner = "Tenant Admin",
            Channel = _selected.Type,
            Notes = $"Schedule launch workflow for {_selected.Name}."
        };
        _showScheduleDialog = true;
    }

    private void CloseScheduleDialog() => _showScheduleDialog = false;

    private Task ConfirmScheduleAsync()
    {
        if (_selected is null) return Task.CompletedTask;
        _showScheduleDialog = false;
        ShowToast("Schedule confirmed", $"{_selected.Name} schedule prepared for {_schedule.LaunchDate:MMM d, yyyy} at {_schedule.LaunchTime}.", "success");
        return Task.CompletedTask;
    }

    private void DuplicateCampaign()
    {
        if (_selected is null) return;
        Nav.NavigateTo($"/marketing/campaigns/new?sourceCampaignId={_selected.Id}&mode=duplicate");
    }

    private Task ExportAsync()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Campaign,Type,Status,Segment,Start,Reached,Open Rate,Conversions,Revenue");
        foreach (var c in Filtered)
        {
            csv.AppendLine(string.Join(',', Csv(c.Name), Csv(c.Type), Csv(c.Status), Csv(c.Segment), Csv(c.StartDate.ToString("yyyy-MM-dd")), Csv(c.Reached.ToString()), Csv(c.OpenRate.ToString("N1")), Csv(c.Conversions.ToString()), Csv(c.Revenue.ToString("F2"))));
        }
        Nav.NavigateTo("data:text/csv;charset=utf-8," + Uri.EscapeDataString(csv.ToString()), forceLoad: true);
        ShowToast("Export generated", "Campaign export generated.", "success");
        return Task.CompletedTask;
    }

    private static string Csv(string? value)
    {
        var text = value ?? string.Empty;
        return string.Concat("\"", text.Replace("\"", "\"\""), "\"");
    }

    private void ShowToast(string title, string message, string kind = "success")
    {
        _toastTitle = title;
        _toastMessage = message;
        _toastKind = kind;
        _toastVisible = true;
    }

    private void HideToast() => _toastVisible = false;

    private static string StatusBadge(string s) => s switch
    {
        "Active" => "mkc-status mkc-st--active",
        "Scheduled" => "mkc-status mkc-st--scheduled",
        "Paused" => "mkc-status mkc-st--paused",
        "Completed" => "mkc-status mkc-st--completed",
        _ => "mkc-status mkc-st--draft",
    };

    private static string TypeIconCss(string t) => t switch
    {
        "Email" => "mkc-ti-email",
        "SMS" => "mkc-ti-sms",
        "Direct Mail" => "mkc-ti-dm",
        _ => "mkc-ti-multi",
    };

    private static string TypeIcon(string t) => t switch
    {
        "Email" => "bi-envelope",
        "SMS" => "bi-phone",
        "Direct Mail" => "bi-mailbox",
        _ => "bi-diagram-3",
    };

    RenderFragment CampaignCell(CampaignRow campaign) => @<div class="mkc-name-cell">
        <div class="mkc-type-icon @TypeIconCss(campaign.Type)"><i class="bi @TypeIcon(campaign.Type)" aria-hidden="true"></i></div>
        <div>
            <div class="mkc-item-name">@campaign.Name</div>
            <div class="mkc-item-sub">@campaign.Type · @campaign.Segment</div>
        </div>
    </div>;

    RenderFragment KpiCard(string icon, string label, string val, string color, string key)
    {
        var isActive = _activeKpi == key || (key == "all" && _activeKpi is null && !HasFilters);
        return @<button type="button" class="mkc-kpi-card @color @(isActive ? "mkc-kpi-active" : "")" @onclick="() => SetKpiFilter(key)" title="@(isActive ? "Clear filter" : $"Filter by {label}")">
            <i class="bi @icon mkc-kpi-icon" aria-hidden="true"></i>
            <div><div class="mkc-kv">@val</div><div class="mkc-kl">@label</div></div>
        </button>;
    }

    private sealed record CampaignRow(Guid Id, string Name, string Type, string Status, string Segment,
        DateTime StartDate, int Reached, decimal OpenRate, int Conversions, decimal Revenue);

    private sealed class CampaignScheduleForm
    {
        [Required(ErrorMessage = "Launch Date is required.")]
        public DateTime LaunchDate { get; set; } = DateTime.Today;

        [Required(ErrorMessage = "Launch Time is required.")]
        [StringLength(20, ErrorMessage = "Launch Time cannot exceed 20 characters.")]
        public string LaunchTime { get; set; } = "09:00 AM";

        [Required(ErrorMessage = "Owner is required.")]
        [StringLength(120, ErrorMessage = "Owner cannot exceed 120 characters.")]
        public string Owner { get; set; } = "Tenant Admin";

        [StringLength(50, ErrorMessage = "Channel cannot exceed 50 characters.")]
        public string Channel { get; set; } = "Email";

        [StringLength(500, ErrorMessage = "Schedule Notes cannot exceed 500 characters.")]
        public string? Notes { get; set; }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
