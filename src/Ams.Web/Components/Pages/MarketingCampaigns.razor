    private static string StatusCss(string status) => $"mkc-st-{status.ToLowerInvariant()}";
    private static string TypeIconCss(string type) => type switch { "Email" => "mkc-ti-email", "SMS" => "mkc-ti-sms", "Direct Mail" => "mkc-ti-dm", _ => "mkc-ti-multi" };
