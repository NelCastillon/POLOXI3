    private void EnsureSelectedStillVisible() => _selected = _selected is null ? _filtered.FirstOrDefault() : _items.FirstOrDefault(x => x.CampaignId == _selected.CampaignId) ?? _filtered.FirstOrDefault();
    private bool ValidateForm() { if (_form.EndDate.HasValue && _form.EndDate.Value < _form.StartDate) { _formError = "End Date must be on or after Start Date."; ShowToast(_formError, "warning"); return false; } if (_form.ScheduledDateUtc.HasValue && _form.ScheduledDateUtc.Value.Date < DateTime.Today.AddYears(-1)) { _formError = "Scheduled Date is outside the allowed campaign window."; ShowToast(_formError, "warning"); return false; } return true; }
    private static CommunicationCampaignDto CloneCampaign(CommunicationCampaignDto item) => new() { CampaignId = item.CampaignId, TenantId = item.TenantId, Name = item.Name, Type = item.Type, Status = item.Status, Segment = item.Segment, Goal = item.Goal, Description = item.Description, Subject = item.Subject, SenderName = item.SenderName, ReplyToEmail = item.ReplyToEmail, TemplateName = item.TemplateName, CtaLabel = item.CtaLabel, SendMode = item.SendMode, Timezone = item.Timezone, FollowUpDays = item.FollowUpDays, SendFollowUp = item.SendFollowUp, SuppressRecentContacts = item.SuppressRecentContacts, SuppressOptOut = item.SuppressOptOut, AbTestSubject = item.AbTestSubject, EndDate = item.EndDate, ScheduledDateUtc = item.ScheduledDateUtc, LandingPageSlug = item.LandingPageSlug, LandingPageUrl = item.LandingPageUrl, StartDate = item.StartDate, Reached = item.Reached, OpenRate = item.OpenRate, Conversions = item.Conversions, Revenue = item.Revenue };
