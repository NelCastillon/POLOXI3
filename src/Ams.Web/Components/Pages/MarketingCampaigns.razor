@page "/marketing/campaigns"
@page "/communications/campaigns"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject IJSRuntime Js

<PageTitle>Marketing Campaigns — AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="mkc-toast mkc-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="mkc-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showStatusConfirm && _statusTarget is not null && !string.IsNullOrWhiteSpace(_pendingStatus))
{
    <div class="mkc-modal-backdrop" role="presentation" @onclick="CancelStatusUpdate">
        <div class="mkc-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="mkc-status-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon @(_pendingStatus == "Paused" ? "um-confirm-icon--danger" : null)"><i class="bi @PendingStatusIcon" aria-hidden="true"></i></div>
                <div class="um-confirm-title" id="mkc-status-title">@PendingStatusTitle</div>
                <div class="um-confirm-body">Update campaign <strong>@_statusTarget.Name</strong> to <strong>@_pendingStatus</strong>?</div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CancelStatusUpdate" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn @(_pendingStatus == "Paused" ? "um-btn-danger" : "um-btn-primary")" @onclick="ExecuteStatusUpdateAsync" disabled="@_busy">@PendingStatusAction</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="mkc-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="mkc-modal mkc-action-modal" role="dialog" aria-modal="true" aria-labelledby="mkc-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-megaphone" aria-hidden="true"></i>
                <span id="mkc-form-title">@(_editingId == Guid.Empty ? "New Marketing Campaign" : "Edit Marketing Campaign")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="mkc-modal-intro">
                        <span><i class="bi bi-shield-check" aria-hidden="true"></i> Campaign workflow</span>
                        <p>Create or update campaign strategy, audience, schedule, channel, attribution metrics, and compliance controls.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full"><label>Campaign Name <span class="text-danger">*</span></label><InputText class="form-control" @bind-Value="_form.Name" /><ValidationMessage For="() => _form.Name" class="text-danger" /></div>
                        <div class="um-field"><label>Type <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="_form.Type">@foreach (var type in _types) { <option value="@type">@type</option> }</InputSelect><ValidationMessage For="() => _form.Type" class="text-danger" /></div>
                        <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="_form.Status">@foreach (var status in _statuses) { <option value="@status">@status</option> }</InputSelect><ValidationMessage For="() => _form.Status" class="text-danger" /></div>
                        <div class="um-field"><label>Segment <span class="text-danger">*</span></label><InputText class="form-control" @bind-Value="_form.Segment" /><ValidationMessage For="() => _form.Segment" class="text-danger" /></div>
                        <div class="um-field"><label>Goal <span class="text-danger">*</span></label><InputText class="form-control" @bind-Value="_form.Goal" /><ValidationMessage For="() => _form.Goal" class="text-danger" /></div>
                        <div class="um-field"><label>Start Date <span class="text-danger">*</span></label><InputDate class="form-control" @bind-Value="_form.StartDate" /><ValidationMessage For="() => _form.StartDate" class="text-danger" /></div>
                        <div class="um-field"><label>End Date</label><InputDate class="form-control" @bind-Value="_form.EndDate" /><ValidationMessage For="() => _form.EndDate" class="text-danger" /></div>
                        <div class="um-field"><label>Scheduled Date</label><InputDate class="form-control" @bind-Value="_form.ScheduledDateUtc" /><ValidationMessage For="() => _form.ScheduledDateUtc" class="text-danger" /></div>
                        <div class="um-field um-field--full"><label>Description</label><InputTextArea class="form-control" rows="3" @bind-Value="_form.Description" /><ValidationMessage For="() => _form.Description" class="text-danger" /></div>
                        <div class="um-field"><label>Subject</label><InputText class="form-control" @bind-Value="_form.Subject" /><ValidationMessage For="() => _form.Subject" class="text-danger" /></div>
                        <div class="um-field"><label>Template</label><InputText class="form-control" @bind-Value="_form.TemplateName" /><ValidationMessage For="() => _form.TemplateName" class="text-danger" /></div>
                        <div class="um-field"><label>Sender Name</label><InputText class="form-control" @bind-Value="_form.SenderName" /><ValidationMessage For="() => _form.SenderName" class="text-danger" /></div>
                        <div class="um-field"><label>Reply-To Email</label><InputText class="form-control" @bind-Value="_form.ReplyToEmail" /><ValidationMessage For="() => _form.ReplyToEmail" class="text-danger" /></div>
                        <div class="um-field"><label>CTA Label</label><InputText class="form-control" @bind-Value="_form.CtaLabel" /><ValidationMessage For="() => _form.CtaLabel" class="text-danger" /></div>
                        <div class="um-field"><label>Send Mode</label><InputSelect class="form-select" @bind-Value="_form.SendMode"><option>Scheduled</option><option>Immediate</option><option>Triggered</option><option>Drip</option></InputSelect><ValidationMessage For="() => _form.SendMode" class="text-danger" /></div>
                        <div class="um-field"><label>Timezone</label><InputText class="form-control" @bind-Value="_form.Timezone" /><ValidationMessage For="() => _form.Timezone" class="text-danger" /></div>
                        <div class="um-field"><label>Follow-up Days</label><InputNumber class="form-control" @bind-Value="_form.FollowUpDays" /><ValidationMessage For="() => _form.FollowUpDays" class="text-danger" /></div>
                        <div class="um-field"><label>Reached</label><InputNumber class="form-control" @bind-Value="_form.Reached" /><ValidationMessage For="() => _form.Reached" class="text-danger" /></div>
                        <div class="um-field"><label>Open Rate %</label><InputNumber class="form-control" @bind-Value="_form.OpenRate" /><ValidationMessage For="() => _form.OpenRate" class="text-danger" /></div>
                        <div class="um-field"><label>Conversions</label><InputNumber class="form-control" @bind-Value="_form.Conversions" /><ValidationMessage For="() => _form.Conversions" class="text-danger" /></div>
                        <div class="um-field"><label>Revenue</label><InputNumber class="form-control" @bind-Value="_form.Revenue" /><ValidationMessage For="() => _form.Revenue" class="text-danger" /></div>
                        <div class="um-field um-field--full"><label>Landing Page URL</label><InputText class="form-control" @bind-Value="_form.LandingPageUrl" /><ValidationMessage For="() => _form.LandingPageUrl" class="text-danger" /></div>
                        <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.SendFollowUp" /> Send follow-up</label></div>
                        <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.SuppressRecentContacts" /> Suppress recent contacts</label></div>
                        <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.SuppressOptOut" /> Honor opt-outs</label></div>
                        <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.AbTestSubject" /> A/B test subject</label></div>
                        <div class="um-field um-field--full mkc-campaign-preview"><span>Campaign preview</span><strong>@_form.Name</strong><small>@_form.Type · @_form.Status · @_form.Segment · @_form.Revenue.ToString("C0") attribution</small></div>
                        @if (!string.IsNullOrWhiteSpace(_formError))
                        {
                            <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">@if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } @(_editingId == Guid.Empty ? "Create Campaign" : "Save Changes")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="mkc-enterprise-page">
    <section class="mkc-header">
        <div class="mkc-header-left">
            <div class="mkc-lob-icon"><i class="bi bi-megaphone-fill" aria-hidden="true"></i></div>
            <div class="mkc-header-info">
                <div class="mkc-title-row"><h1 class="mkc-page-title">Marketing Campaigns</h1><span class="mkc-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live campaign data</span><span class="mkc-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span></div>
                <div class="mkc-sub-row"><span>Create, schedule, launch, pause, complete, and export tenant marketing campaigns.</span><span class="mkc-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Seed sync enabled</span><span class="mkc-sub-chip"><i class="bi bi-check2-circle" aria-hidden="true"></i> @_filtered.Count active matches</span></div>
            </div>
        </div>
        <div class="mkc-header-actions"><button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi @(_loading ? "bi-arrow-repeat mkc-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button><button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync" disabled="@(!_filtered.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Campaign</button></div>
    </section>

    <section class="mkc-kpi-strip" aria-label="Campaign metrics">@foreach (var kpi in Kpis) { <button type="button" class="@KpiClass(kpi)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)"><span class="mkc-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span><span class="mkc-kpi-copy"><span class="mkc-kpi-label">@kpi.Label</span><span class="mkc-kpi-value">@kpi.Value</span><span class="mkc-kpi-caption">@kpi.Caption</span></span></button> }</section>

    <section class="mkc-workflow-strip" aria-label="Campaign workflow shortcuts"><button type="button" class="mkc-workflow-card mkc-wf-create" @onclick="OpenCreate"><span class="mkc-workflow-icon"><i class="bi bi-plus-circle" aria-hidden="true"></i></span><span class="mkc-workflow-content"><strong>1</strong><span>Create</span><small>Build campaign.</small></span></button><button type="button" class="mkc-workflow-card mkc-wf-segment" @onclick='() => Nav.NavigateTo("/marketing/segments")'><span class="mkc-workflow-icon"><i class="bi bi-pie-chart" aria-hidden="true"></i></span><span class="mkc-workflow-content"><strong>2</strong><span>Segment</span><small>Select audience.</small></span></button><button type="button" class="mkc-workflow-card mkc-wf-template" @onclick='() => Nav.NavigateTo("/communications/templates")'><span class="mkc-workflow-icon"><i class="bi bi-layout-text-sidebar" aria-hidden="true"></i></span><span class="mkc-workflow-content"><strong>3</strong><span>Template</span><small>Prepare content.</small></span></button><button type="button" class="mkc-workflow-card mkc-wf-schedule" @onclick="ScheduleSelected" disabled="@(_selected is null)"><span class="mkc-workflow-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></span><span class="mkc-workflow-content"><strong>4</strong><span>Schedule</span><small>Queue launch.</small></span></button><button type="button" class="mkc-workflow-card mkc-wf-launch" @onclick="ActivateSelected" disabled="@(!CanActivateSelected)"><span class="mkc-workflow-icon"><i class="bi bi-play-circle" aria-hidden="true"></i></span><span class="mkc-workflow-content"><strong>5</strong><span>Launch</span><small>Activate.</small></span></button><button type="button" class="mkc-workflow-card mkc-wf-outreach" @onclick='() => Nav.NavigateTo("/communications/outreach")'><span class="mkc-workflow-icon"><i class="bi bi-telephone-outbound" aria-hidden="true"></i></span><span class="mkc-workflow-content"><strong>6</strong><span>Outreach</span><small>Follow up.</small></span></button></section>

    <section class="mkc-enterprise-search" aria-label="Campaign filters"><div class="mkc-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div><div class="mkc-search-body"><label for="mkc-search">Search campaigns</label><input id="mkc-search" class="mkc-search-input" type="search" placeholder="Search campaign, segment, status, type, goal..." @bind="SearchFilter" @bind:event="oninput" /><span class="mkc-search-hint">Filters apply instantly across synchronized marketing campaign data.</span></div><select class="mkc-filter-select" @bind="StatusFilter" aria-label="Status filter"><option value="">All statuses</option>@foreach (var status in _statuses) { <option value="@status">@status</option> }</select><select class="mkc-filter-select" @bind="TypeFilter" aria-label="Type filter"><option value="">All types</option>@foreach (var type in _types) { <option value="@type">@type</option> }</select><div class="mkc-search-result"><strong>@_filtered.Count</strong><span>matches</span></div></section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger mkc-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
    }

    <section class="mkc-content-layout">
        <div class="mkc-grid-wrap">
            <div class="mkc-grid-toolbar"><div><strong>Campaign register</strong><span>@ActiveFilterText</span></div><div class="mkc-toolbar-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-eraser" aria-hidden="true"></i> Reset</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ActivateSelected" disabled="@(!CanActivateSelected)"><i class="bi bi-play-circle" aria-hidden="true"></i> Launch</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PauseSelected" disabled="@(!CanPauseSelected)"><i class="bi bi-pause-circle" aria-hidden="true"></i> Pause</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add</button></div></div>
            @if (_loading)
            {
                <div class="mkc-loading"><i class="bi bi-arrow-repeat mkc-spin" aria-hidden="true"></i><strong>Loading campaigns...</strong><span>Syncing schema, seed data, and campaign register.</span></div>
            }
            else if (!_filtered.Any())
            {
                <div class="mkc-empty-state"><i class="bi bi-megaphone" aria-hidden="true"></i><strong>No campaigns found</strong><span>Adjust filters or create a new marketing campaign.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">New Campaign</button></div>
            }
            else
            {
                <div class="mkc-table-scroll">
                    <table class="mkc-table">
                        <thead>
                            <tr>
                                <th>Campaign</th>
                                <th>Audience</th>
                                <th>Start</th>
                                <th class="mkc-number">Reached</th>
                                <th class="mkc-number">Open %</th>
                                <th class="mkc-number">Revenue</th>
                                <th>Status</th>
                                <th class="mkc-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PagedItems)
                            {
                                <tr class="@RowClass(item)" @onclick="() => SelectCampaign(item)">
                                    <td>
                                        <div class="mkc-campaign-cell">
                                            <span class="mkc-type-icon @TypeIconCss(item.Type)"><i class="bi @TypeIcon(item.Type)" aria-hidden="true"></i></span>
                                            <span><strong>@item.Name</strong><small>@item.Type · @item.Goal</small></span>
                                        </div>
                                    </td>
                                    <td><span class="mkc-audience">@item.Segment</span></td>
                                    <td>@item.StartDate.ToString("MMM d, yyyy")</td>
                                    <td class="mkc-number">@item.Reached.ToString("N0")</td>
                                    <td class="mkc-number">@item.OpenRate.ToString("N1")%</td>
                                    <td class="mkc-number mkc-revenue">@item.Revenue.ToString("C0")</td>
                                    <td><span class="mkc-status-chip @StatusCss(item.Status)">@item.Status</span></td>
                                    <td>
                                        <div class="mkc-row-acts">
                                            <button type="button" class="um-btn um-btn-primary um-btn-xs" title="Inspect" @onclick:stopPropagation="true" @onclick="() => SelectCampaign(item)"><i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Edit" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Duplicate" @onclick:stopPropagation="true" @onclick="() => DuplicateCampaignAsync(item)"><i class="bi bi-files" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Launch" @onclick:stopPropagation="true" @onclick="() => ConfirmStatusUpdate(item, ActiveStatus)" disabled="@(!CanActivate(item))"><i class="bi bi-play-circle" aria-hidden="true"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mkc-pager"><span>Showing @PageStart-@PageEnd of @_filtered.Count</span><div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PrevPage" disabled="@(_page == 1)">Previous</button><span>Page @_page of @TotalPages</span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button></div></div>
            }
        </div>
        <aside class="mkc-detail-panel" aria-label="Selected campaign detail">
            @if (_selected is null)
            {
                <div class="mkc-detail-empty"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a campaign</strong><span>Choose a row to inspect readiness, engagement metrics, attribution, and workflow actions.</span></div>
            }
            else
            {
                <div class="mkc-detail-head"><div><span class="mkc-detail-eyebrow"><i class="bi bi-megaphone" aria-hidden="true"></i> Campaign detail</span><h2>@_selected.Name</h2><div class="mkc-detail-meta"><span>@_selected.Type · @_selected.Segment</span><span class="mkc-status-chip @StatusCss(_selected.Status)">@_selected.Status</span></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></div>
                <div class="mkc-detail-body">
                    <div class="mkc-impact-card">
                        <span>Attributed revenue</span>
                        <strong>@_selected.Revenue.ToString("C2")</strong>
                        <small>@_selected.Conversions.ToString("N0") conversions · @_selected.OpenRate.ToString("N1")% open rate</small>
                    </div>
                    <div class="mkc-detail-summary">
                        <div class="mkc-meta-row"><span class="mkc-meta-lbl">Start Date</span><span class="mkc-meta-val">@_selected.StartDate.ToString("MMM d, yyyy")</span></div>
                        <div class="mkc-meta-row"><span class="mkc-meta-lbl">Scheduled</span><span class="mkc-meta-val">@(_selected.ScheduledDateUtc?.ToLocalTime().ToString("MMM d, yyyy") ?? "Not scheduled")</span></div>
                        <div class="mkc-meta-row"><span class="mkc-meta-lbl">Reached</span><span class="mkc-meta-val">@_selected.Reached.ToString("N0")</span></div>
                        <div class="mkc-meta-row"><span class="mkc-meta-lbl">Template</span><span class="mkc-meta-val">@Blank(_selected.TemplateName)</span></div>
                    </div>
                    <div class="mkc-policy-card"><span><i class="bi bi-shield-check" aria-hidden="true"></i> Governance controls</span><p>Opt-out suppression, recent-contact suppression, template readiness, and attribution tracking are synchronized with the campaign workflow.</p></div>
                    <div class="mkc-detail-actions">
                        <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => DuplicateCampaignAsync(_selected)"><i class="bi bi-files" aria-hidden="true"></i> Duplicate</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ScheduleSelected"><i class="bi bi-calendar-check" aria-hidden="true"></i> Schedule</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ActivateSelected" disabled="@(!CanActivateSelected)"><i class="bi bi-play-circle" aria-hidden="true"></i> Launch</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PauseSelected" disabled="@(!CanPauseSelected)"><i class="bi bi-pause-circle" aria-hidden="true"></i> Pause</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenBuilder"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Builder</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    private const int PageSize = 12;
    private const string ActiveStatus = "Active";
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<CommunicationCampaignDto> _items = [];
    private List<CommunicationCampaignDto> _filtered = [];
    private CommunicationCampaignDto? _selected;
    private CommunicationCampaignDto? _statusTarget;
    private CampaignForm _form = new();
    private Guid _editingId = Guid.Empty;
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private string _typeFilter = string.Empty;
    private string _kpiFilter = "all";
    private string? _pendingStatus;
    private int _page = 1;
    private bool _loading, _busy, _showForm, _showStatusConfirm, _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError, _formError;
    private readonly List<string> _statuses = ["Draft", "Scheduled", "Active", "Paused", "Completed"];
    private readonly List<string> _types = ["Email", "SMS", "Direct Mail", "Multi-Channel"];

    private IEnumerable<CommunicationCampaignDto> PagedItems => _filtered.Skip((_page - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
    private int PageStart => _filtered.Count == 0 ? 0 : ((_page - 1) * PageSize) + 1;
    private int PageEnd => Math.Min(_filtered.Count, _page * PageSize);
    private int ActiveCount => _items.Count(x => x.Status == "Active");
    private int ScheduledCount => _items.Count(x => x.Status == "Scheduled");
    private int PausedCount => _items.Count(x => x.Status == "Paused");
    private int DraftCount => _items.Count(x => x.Status == "Draft");
    private int TotalConversions => _items.Sum(x => x.Conversions);
    private decimal TotalRevenue => _items.Sum(x => x.Revenue);
    private bool CanActivateSelected => _selected is not null && CanActivate(_selected);
    private bool CanPauseSelected => _selected is not null && _selected.Status == "Active";
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", "info" => "bi-info-circle-fill", _ => "bi-check-circle-fill" };
    private string ActiveFilterText => _kpiFilter == "all" ? "All marketing campaigns" : $"Filtered by {_kpiFilter}";
    private string PendingStatusIcon => _pendingStatus switch { "Active" => "bi-play-circle", "Paused" => "bi-pause-circle", "Completed" => "bi-check2-circle", "Scheduled" => "bi-calendar-check", _ => "bi-arrow-repeat" };
