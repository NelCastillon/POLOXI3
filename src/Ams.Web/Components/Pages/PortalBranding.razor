@page "/portal/branding"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Portal Branding — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Portal Branding"
               Subtitle="White-label the client portal with your agency's colors, logo, and messaging"
               Icon="bi-palette-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ResetDefaults">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset Defaults
        </button>
        <button class="um-btn um-btn-primary" @onclick="SaveAsync">
            <i class="bi bi-check-lg" aria-hidden="true"></i> Save Branding
        </button>
    </Actions>
</AppPageHeader>

<div class="pb-layout">

    <!-- Left: settings panels -->
    <div class="pb-settings-col">

        <!-- Identity -->
        <div class="pb-panel">
            <div class="pb-panel-hdr"><i class="bi bi-building" aria-hidden="true"></i> Agency Identity</div>
            <div class="pb-form-grid">
                <div class="pb-field pb-field--full">
                    <label class="pb-lbl">Portal Display Name</label>
                    <SfTextBox @bind-Value="_brand.DisplayName" Placeholder="e.g. First Insurance Client Portal" />
                </div>
                <div class="pb-field pb-field--full">
                    <label class="pb-lbl">Custom Domain</label>
                    <SfTextBox @bind-Value="_brand.Domain" Placeholder="e.g. portal.firstinsurance.com" />
                    <span class="pb-hint">Requires DNS CNAME pointing to portal.agencybinder.com</span>
                </div>
                <div class="pb-field">
                    <label class="pb-lbl">Support Email</label>
                    <SfTextBox @bind-Value="_brand.SupportEmail" Placeholder="support@yourагенcy.com" />
                </div>
                <div class="pb-field">
                    <label class="pb-lbl">Support Phone</label>
                    <SfTextBox @bind-Value="_brand.SupportPhone" Placeholder="(555) 000-0000" />
                </div>
                <div class="pb-field pb-field--full">
                    <label class="pb-lbl">Welcome Message</label>
                    <SfTextBox @bind-Value="_brand.WelcomeMessage" Multiline="true" />
                </div>
            </div>
        </div>

        <!-- Colors -->
        <div class="pb-panel">
            <div class="pb-panel-hdr"><i class="bi bi-palette" aria-hidden="true"></i> Brand Colors</div>
            <div class="pb-color-grid">
                <div class="pb-color-field">
                    <label class="pb-lbl">Primary Color</label>
                    <div class="pb-color-row">
                        <input type="color" class="pb-color-input" @bind="_brand.PrimaryColor" />
                        <SfTextBox @bind-Value="_brand.PrimaryColor" CssClass="pb-hex-input" />
                    </div>
                </div>
                <div class="pb-color-field">
                    <label class="pb-lbl">Accent Color</label>
                    <div class="pb-color-row">
                        <input type="color" class="pb-color-input" @bind="_brand.AccentColor" />
                        <SfTextBox @bind-Value="_brand.AccentColor" CssClass="pb-hex-input" />
                    </div>
                </div>
                <div class="pb-color-field">
                    <label class="pb-lbl">Nav Background</label>
                    <div class="pb-color-row">
                        <input type="color" class="pb-color-input" @bind="_brand.NavBg" />
                        <SfTextBox @bind-Value="_brand.NavBg" CssClass="pb-hex-input" />
                    </div>
                </div>
                <div class="pb-color-field">
                    <label class="pb-lbl">Nav Text Color</label>
                    <div class="pb-color-row">
                        <input type="color" class="pb-color-input" @bind="_brand.NavText" />
                        <SfTextBox @bind-Value="_brand.NavText" CssClass="pb-hex-input" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Email sender -->
        <div class="pb-panel">
            <div class="pb-panel-hdr"><i class="bi bi-envelope" aria-hidden="true"></i> Email Sender Identity</div>
            <div class="pb-form-grid">
                <div class="pb-field">
                    <label class="pb-lbl">From Name</label>
                    <SfTextBox @bind-Value="_brand.EmailFromName" Placeholder="First Insurance" />
                </div>
                <div class="pb-field">
                    <label class="pb-lbl">Reply-To Address</label>
                    <SfTextBox @bind-Value="_brand.EmailReplyTo" Placeholder="noreply@firstinsurance.com" />
                </div>
                <div class="pb-field pb-field--full">
                    <label class="pb-lbl">Email Footer Text</label>
                    <SfTextBox @bind-Value="_brand.EmailFooter" Multiline="true" />
                </div>
            </div>
        </div>

        <!-- Toggles -->
        <div class="pb-panel">
            <div class="pb-panel-hdr"><i class="bi bi-toggles" aria-hidden="true"></i> Display Options</div>
            <div class="pb-toggle-list">
                <label class="pb-toggle-row"><SfCheckBox @bind-Checked="_brand.ShowAgencyLogo" /><span>Show agency logo in portal header</span></label>
                <label class="pb-toggle-row"><SfCheckBox @bind-Checked="_brand.ShowPoweredBy" /><span>Show "Powered by AgencyBinder" footer</span></label>
                <label class="pb-toggle-row"><SfCheckBox @bind-Checked="_brand.ShowSupportChat" /><span>Enable support chat bubble</span></label>
                <label class="pb-toggle-row"><SfCheckBox @bind-Checked="_brand.ShowNewsWidget" /><span>Show agency news / announcements widget</span></label>
            </div>
        </div>
    </div>

    <!-- Right: live preview -->
    <div class="pb-preview-col">
        <div class="pb-preview-card">
            <div class="pb-preview-hdr">Live Preview</div>
            <div class="pb-portal-mock" style="--mock-primary:@_brand.PrimaryColor; --mock-nav-bg:@_brand.NavBg; --mock-nav-text:@_brand.NavText; --mock-accent:@_brand.AccentColor">
                <div class="pb-mock-nav">
                    <div class="pb-mock-logo">
                        <div class="pb-mock-logo-box" style="background:var(--mock-primary)">A</div>
                        <span class="pb-mock-brand-name" style="color:var(--mock-nav-text)">@_brand.DisplayName</span>
                    </div>
                    <div class="pb-mock-nav-links">
                        <span class="pb-mock-link pb-mock-link--active" style="color:var(--mock-primary)">Dashboard</span>
                        <span class="pb-mock-link">Policies</span>
                        <span class="pb-mock-link">Documents</span>
                        <span class="pb-mock-link">Requests</span>
                    </div>
                </div>
                <div class="pb-mock-body">
                    <div class="pb-mock-welcome">
                        <div class="pb-mock-greet">Welcome back, <strong>Client</strong> 👋</div>
                        <div class="pb-mock-sub">@(_brand.WelcomeMessage.Length > 80 ? _brand.WelcomeMessage[..80] + "…" : _brand.WelcomeMessage)</div>
                    </div>
                    <div class="pb-mock-cards">
                        <div class="pb-mock-card" style="border-top:3px solid var(--mock-primary)">
                            <div class="pb-mock-card-icon" style="background:var(--mock-primary)20; color:var(--mock-primary)"><i class="bi bi-shield-check" aria-hidden="true"></i></div>
                            <div class="pb-mock-card-lbl">Active Policies</div>
                            <div class="pb-mock-card-val">4</div>
                        </div>
                        <div class="pb-mock-card" style="border-top:3px solid var(--mock-accent)">
                            <div class="pb-mock-card-icon" style="background:var(--mock-accent)20; color:var(--mock-accent)"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></div>
                            <div class="pb-mock-card-lbl">Documents</div>
                            <div class="pb-mock-card-val">12</div>
                        </div>
                        <div class="pb-mock-card" style="border-top:3px solid var(--mock-primary)">
                            <div class="pb-mock-card-icon" style="background:var(--mock-primary)20; color:var(--mock-primary)"><i class="bi bi-receipt" aria-hidden="true"></i></div>
                            <div class="pb-mock-card-lbl">Open Invoices</div>
                            <div class="pb-mock-card-val">1</div>
                        </div>
                    </div>
                    <button class="pb-mock-btn" style="background:var(--mock-primary)">Request a Certificate</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;
    private Guid _recordId;

    private BrandSettings _brand = new();

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Portal","/portal/users"), new("Branding",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var settings = await Api.GetPortalBrandingSettingsAsync(_tenantId);
        var records = await Api.SearchPortalAdminRecordsAsync(_tenantId, "PortalBranding");
        _recordId = records?.Items.FirstOrDefault()?.PortalAdminRecordId ?? Guid.Empty;
        if (settings is null) { ResetDefaults(); return; }
        _brand = new BrandSettings
        {
            DisplayName = settings.DisplayName,
            Domain = settings.Domain,
            SupportEmail = settings.SupportEmail,
            SupportPhone = settings.SupportPhone,
            WelcomeMessage = settings.WelcomeMessage,
            PrimaryColor = settings.PrimaryColor,
            AccentColor = settings.AccentColor,
            NavBg = settings.NavBg,
            NavText = settings.NavText,
            EmailFromName = settings.EmailFromName,
            EmailReplyTo = settings.EmailReplyTo,
            EmailFooter = settings.EmailFooter,
            ShowAgencyLogo = settings.ShowAgencyLogo,
            ShowPoweredBy = settings.ShowPoweredBy,
            ShowSupportChat = settings.ShowSupportChat,
            ShowNewsWidget = settings.ShowNewsWidget
        };
    }

    private void ResetDefaults()
    {
        _brand = new BrandSettings
        {
            DisplayName    = "First Insurance Client Portal",
            Domain         = "portal.firstinsurance.com",
            SupportEmail   = "support@firstinsurance.com",
            SupportPhone   = "(555) 234-5678",
            WelcomeMessage = "Manage your policies, request certificates, upload documents, and more — all in one place.",
            PrimaryColor   = "#1d4ed8",
            AccentColor    = "#059669",
            NavBg          = "#1e293b",
            NavText        = "#f8fafc",
            EmailFromName  = "First Insurance",
            EmailReplyTo   = "noreply@firstinsurance.com",
            EmailFooter    = "First Insurance · Client Portal Support · (555) 234-5678",
            ShowAgencyLogo = true,
            ShowPoweredBy  = false,
            ShowSupportChat= true,
            ShowNewsWidget = true,
        };
    }

    private async Task SaveAsync()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(_brand);
        if (_recordId != Guid.Empty)
            await Api.UpdatePortalAdminRecordAsync(_recordId, new UpsertPortalAdminRecordRequest(_tenantId, "PortalBranding", "branding", _brand.DisplayName, "Active", json));
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = "Portal branding saved successfully.", CssClass = "e-toast-success" });
    }

    private sealed class BrandSettings
    {
        public string DisplayName    { get; set; } = string.Empty;
        public string Domain         { get; set; } = string.Empty;
        public string SupportEmail   { get; set; } = string.Empty;
        public string SupportPhone   { get; set; } = string.Empty;
        public string WelcomeMessage { get; set; } = string.Empty;
        public string PrimaryColor   { get; set; } = "#1d4ed8";
        public string AccentColor    { get; set; } = "#059669";
        public string NavBg          { get; set; } = "#1e293b";
        public string NavText        { get; set; } = "#f8fafc";
        public string EmailFromName  { get; set; } = string.Empty;
        public string EmailReplyTo   { get; set; } = string.Empty;
        public string EmailFooter    { get; set; } = string.Empty;
        public bool   ShowAgencyLogo  { get; set; } = true;
        public bool   ShowPoweredBy   { get; set; }
        public bool   ShowSupportChat { get; set; } = true;
        public bool   ShowNewsWidget  { get; set; } = true;
    }
}
