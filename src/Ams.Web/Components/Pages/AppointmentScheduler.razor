    void OpenCreate() { _edit = new Appointment { Id = Guid.Empty, SendConfirmation = true, SendReminder = true, Duration = "30 min", Channel = "Phone Call" }; _showDlg = true; }
    void OpenEdit(Appointment a) { _edit = Clone(a); _showDlg = true; }
    void OpenLog(Appointment a)  { _logTarget = a; _logOutcome = ""; _logFollowUp = "None"; _logNotes = ""; _showLogDlg = true; }

    static Appointment Clone(Appointment a) => new()
    {
        Id=a.Id, AccountName=a.AccountName, ContactName=a.ContactName, Type=a.Type,
        Channel=a.Channel, Status=a.Status, Duration=a.Duration, Producer=a.Producer,
        CsrOwner=a.CsrOwner, Branch=a.Branch, Notes=a.Notes,
        SendConfirmation=a.SendConfirmation, SendReminder=a.SendReminder,
        ScheduledDate=a.ScheduledDate, ScheduledTime=a.ScheduledTime
    };

    async Task SaveAppointment()
    {
        if (_edit is null || string.IsNullOrWhiteSpace(_edit.AccountName)) return;
        if (_edit.Id == Guid.Empty)
        {
            _edit.Id = Guid.NewGuid();
            _edit.Status = "Scheduled";
            _appts.Insert(0, _edit);
        }
        else
        {
            var idx = _appts.FindIndex(a => a.Id == _edit.Id);
            if (idx >= 0) _appts[idx] = _edit;
        }
        _showDlg = false;
        await _toast.ShowAsync(new ToastModel { Title = "Saved", Content = $"Appointment for {_edit.AccountName} saved.", CssClass = "e-toast-success" });
    }

    async Task ConfirmLog()
    {
        if (_logTarget is null || string.IsNullOrEmpty(_logOutcome)) return;
        _logTarget.Status       = _logOutcome.StartsWith("Completed") ? "Completed" : _logOutcome.StartsWith("No Answer") ? "No Answer" : _logOutcome.StartsWith("Rescheduled") ? "Rescheduled" : "Cancelled";
        _logTarget.Outcome      = _logOutcome;
        _logTarget.OutcomeNotes = _logNotes;
        _logTarget.FollowUp     = _logFollowUp;
        _showLogDlg = false;
        await _toast.ShowAsync(new ToastModel { Title = "Outcome Logged", Content = $"Outcome recorded for {_logTarget.AccountName}.", CssClass = "e-toast-success" });
    }

    async Task Reschedule(Appointment a)
    {
        a.Status = "Rescheduled";
        _edit    = Clone(a);
        _edit.Id = Guid.Empty;
        _edit.Status = "Scheduled";
        _showDlg = true;
        await _toast.ShowAsync(new ToastModel { Title = "Reschedule", Content = "Original appointment marked as Rescheduled. Set a new time below.", CssClass = "e-toast-info" });
    }

    async Task CancelAppt(Appointment a)
    {
        a.Status = "Cancelled";
        await _toast.ShowAsync(new ToastModel { Title = "Cancelled", Content = $"Appointment with {a.AccountName} cancelled.", CssClass = "e-toast-warning" });
    }

    async Task SendReminderNow()
    {
        if (_selectedAppt is null) return;
        await _toast.ShowAsync(new ToastModel { Title = "Reminder Sent", Content = $"Reminder sent to {_selectedAppt.ContactName}.", CssClass = "e-toast-info" });
    }

    static bool IsThisWeek(Appointment a)
    {
        if (!a.ScheduledDate.HasValue) return false;
        var today = DateTime.Today;
        var monday = today.AddDays(-(int)today.DayOfWeek + (today.DayOfWeek == DayOfWeek.Sunday ? -6 : 1));
        return a.ScheduledDate.Value.Date >= monday && a.ScheduledDate.Value.Date < monday.AddDays(7);
    }

    static string StatusCss(string s) => s.ToLower().Replace(" ", "-");
    static string ApptChannelIcon(string ch) => ch switch { "Phone Call" => "bi-telephone", "Video Call" => "bi-camera-video", "In-Person" => "bi-geo-alt", "Email Follow-Up" => "bi-envelope", "SMS Reminder" => "bi-phone", _ => "bi-chat-dots" };

    RenderFragment Kpi(string icon, string label, string val, string color) => __builder =>
    {
        <div class="as-kpi-card @color">
            <i class="bi @icon as-kpi-icon" aria-hidden="true"></i>
            <div><div class="as-kpi-val">@val</div><div class="as-kpi-lbl">@label</div></div>
        </div>
    };

    RenderFragment Tab(string id, string label, int count) => __builder =>
    {
        <button class="as-tab @(_tab == id ? "as-tab-active" : "")" @onclick='() => { _tab = id; _selectedAppt = null; }'>
            @label @if (count > 0) { <span class="as-tab-badge">@count</span> }
        </button>
    };
}
