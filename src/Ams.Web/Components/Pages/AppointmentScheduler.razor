@page "/communications/appointments"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Appointment Scheduler — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<!-- ── SCHEDULE / EDIT DIALOG ────────────────────────────────────── -->
<SfDialog @bind-Visible="_showDlg" Width="1120px" ShowCloseIcon="false" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header">
                <i class="bi bi-calendar-plus" aria-hidden="true"></i>
                <span>@(_edit?.Id == Guid.Empty ? "Schedule Appointment" : "Edit Appointment")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showDlg = false">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            @if (_edit is not null)
            {
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field"><label>Account *</label>
                            <SfDropDownList TValue="string" TItem="string" DataSource="@_accountNames" @bind-Value="_edit.AccountName" Placeholder="Select account" />
                        </div>
                        <div class="um-field"><label>Contact Name *</label>
                            <SfTextBox @bind-Value="_edit.ContactName" Placeholder="Insured contact name" />
                        </div>
                        <div class="um-field"><label>Appointment Type *</label>
                            <SfDropDownList TValue="string" TItem="string" DataSource="@_apptTypes" @bind-Value="_edit.Type" Placeholder="Select type" />
                        </div>
                        <div class="um-field"><label>Channel</label>
                            <SfDropDownList TValue="string" TItem="string"
                                            DataSource="@(new[]{"Phone Call","Video Call","In-Person","Email Follow-Up","SMS Reminder"})"
                                            @bind-Value="_edit.Channel" Placeholder="Phone Call" />
                        </div>
                        <div class="um-field"><label>Date *</label>
                            <SfDatePicker TValue="DateTime?" @bind-Value="_edit.ScheduledDate" Placeholder="MM/DD/YYYY" Min="DateTime.Today" />
                        </div>
                        <div class="um-field"><label>Time *</label>
                            <SfTimePicker TValue="DateTime?" @bind-Value="_edit.ScheduledTime" Placeholder="HH:MM AM/PM" />
                        </div>
                        <div class="um-field"><label>Duration</label>
                            <SfDropDownList TValue="string" TItem="string"
                                            DataSource="@(new[]{"15 min","30 min","45 min","60 min","90 min","2 hours"})"
                                            @bind-Value="_edit.Duration" Placeholder="30 min" />
                        </div>
                        <div class="um-field"><label>Assigned Producer</label>
                            <SfDropDownList TValue="string" TItem="string" DataSource="@_producers" @bind-Value="_edit.Producer" Placeholder="Select producer" />
                        </div>
                        <div class="um-field"><label>Assigned CSR</label>
                            <SfDropDownList TValue="string" TItem="string" DataSource="@_csrs" @bind-Value="_edit.CsrOwner" Placeholder="Select CSR" />
                        </div>
                        <div class="um-field"><label>Branch</label>
                            <SfDropDownList TValue="string" TItem="string" DataSource="@_branches" @bind-Value="_edit.Branch" Placeholder="Select branch" />
                        </div>
                        <div class="um-field um-field--full"><label>Notes</label>
                            <SfTextBox @bind-Value="_edit.Notes" Placeholder="Agenda, prep notes, context…" Multiline="true" />
                        </div>
                        <div class="um-field"><label>Send Confirmation</label>
                            <SfCheckBox @bind-Checked="_edit.SendConfirmation" Label="Send confirmation message to client" />
                        </div>
                        <div class="um-field"><label>Send Reminder</label>
                            <SfCheckBox @bind-Checked="_edit.SendReminder" Label="Send reminder 24 hours before" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showDlg = false">Cancel</button>
                    <button type="button" class="um-btn um-btn-primary" @onclick="SaveAppointment">
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        @(_edit?.Id == Guid.Empty ? "Schedule" : "Save Changes")
                    </button>
                </div>
            }
        </Content>
    </DialogTemplates>
</SfDialog>

<!-- ── LOG OUTCOME DIALOG ─────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showLogDlg" Width="720px" ShowCloseIcon="false" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header">
                <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                <span>Log Outcome</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showLogDlg = false">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            @if (_logTarget is not null)
            {
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field">
                            <label>Outcome *</label>
                            <SfDropDownList TValue="string" TItem="string"
                                            DataSource="@(new[]{"Completed — Client Reached","Completed — No Decision","Rescheduled","No Answer — Voicemail Left","No Answer — No Voicemail","Cancelled by Client","Cancelled by Agent"})"
                                            @bind-Value="_logOutcome" Placeholder="Select outcome" />
                        </div>
                        <div class="um-field">
                            <label>Follow-Up Required</label>
                            <SfDropDownList TValue="string" TItem="string"
                                            DataSource="@(new[]{"None","Call Back","Send Proposal","Schedule Another Meeting","Send Certificate","File Claim"})"
                                            @bind-Value="_logFollowUp" Placeholder="None" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Notes</label>
                            <SfTextBox @bind-Value="_logNotes" Placeholder="Summary of the conversation / outcome…" Multiline="true" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showLogDlg = false">Cancel</button>
                    <button type="button" class="um-btn um-btn-primary" @onclick="ConfirmLog">
                        <i class="bi bi-check-lg" aria-hidden="true"></i> Log Outcome
                    </button>
                </div>
            }
        </Content>
    </DialogTemplates>
</SfDialog>

<AppPageHeader Title="Appointments Administration"
               Subtitle="Tenant admin scheduling for client calls, meetings, follow-ups, reminders, outcomes, producers, and CSR ownership"
               Icon="bi-calendar-event">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/outreach")'>
            <i class="bi bi-telephone-outbound" aria-hidden="true"></i> Outreach Queue
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Schedule Appointment
        </button>
    </Actions>
</AppPageHeader>

<section class="ma-hero comm-hero">
    <div>
        <span class="ma-eyebrow">Tenant Administration · Appointments</span>
        <h2>Tenant Appointment Control Center</h2>
        <p>Administer appointment scheduling, confirmations, reminders, owner assignments, outcome logging, reschedules, and follow-up workflow readiness.</p>
    </div>
    <div class="ma-hero-actions">
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/inbox")'><i class="bi bi-inbox"></i> Inbox</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/outreach")'><i class="bi bi-telephone-outbound"></i> Outreach Queue</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/templates")'><i class="bi bi-layout-text-sidebar"></i> Templates</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/notifications")'><i class="bi bi-bell"></i> Notifications</button>
    </div>
</section>

<!-- ── KPI STRIP ─────────────────────────────────────────────────── -->
<div class="as-kpi-strip">
    @Kpi("bi-calendar-check","Today",        _appts.Count(a => a.ScheduledDate.HasValue && a.ScheduledDate.Value.Date == DateTime.Today).ToString(),              "as-ki-blue")
    @Kpi("bi-calendar-week", "This Week",    _appts.Count(a => IsThisWeek(a)).ToString(),                                                                         "as-ki-blue")
    @Kpi("bi-clock",         "Pending",      _appts.Count(a => a.Status == "Scheduled").ToString(),                                                               "as-ki-amber")
    @Kpi("bi-hourglass",     "Awaiting Conf",_appts.Count(a => a.Status == "Awaiting Confirmation").ToString(),                                                   "as-ki-amber")
    @Kpi("bi-check-circle",  "Completed",    _appts.Count(a => a.Status == "Completed").ToString(),                                                               "as-ki-green")
    @Kpi("bi-x-circle",      "Cancelled",    _appts.Count(a => a.Status == "Cancelled").ToString(),                                                               "as-ki-red")
    @Kpi("bi-arrow-repeat",  "Rescheduled",  _appts.Count(a => a.Status == "Rescheduled").ToString(),                                                             "as-ki-gray")
    @Kpi("bi-graph-up",      "Show Rate",    $"{(_appts.Count(a=>a.Status is "Completed" or "Cancelled") > 0 ? _appts.Count(a=>a.Status=="Completed")*100/_appts.Count(a=>a.Status is "Completed" or "Cancelled") : 0)}%","as-ki-green")
</div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

<!-- ── TWO-PANEL LAYOUT ───────────────────────────────────────────── -->
<div class="as-layout">

    <!-- TODAY / UPCOMING STRIP -->
    <div class="as-today-panel">

        <!-- Tabs -->
        <div class="as-tabs">
            @Tab("today",    "Today",    _appts.Count(a => a.ScheduledDate?.Date == DateTime.Today))
            @Tab("upcoming", "Upcoming", _appts.Count(a => a.ScheduledDate.HasValue && a.ScheduledDate.Value.Date > DateTime.Today && a.Status == "Scheduled"))
            @Tab("all",      "All",      _appts.Count)
        </div>

        <!-- Filters -->
        <div class="as-list-toolbar">
            <input class="e-input as-search" @bind="_search" @bind:event="oninput" placeholder="Search…" />
            <select class="e-input as-sel" @bind="_typeFilter">
                <option value="">All Types</option>
                @foreach (var t in _apptTypes) { <option>@t</option> }
            </select>
            <select class="e-input as-sel" @bind="_statusFilter">
                <option value="">All Status</option>
                <option>Scheduled</option><option>Awaiting Confirmation</option>
                <option>Completed</option><option>Cancelled</option><option>Rescheduled</option><option>No Answer</option>
            </select>
        </div>

        <!-- List -->
        <div class="as-appt-list">
            @{
                var list = FilteredAppts.ToList();
                if (!list.Any())
                {
                    <div class="as-empty">
                        <i class="bi bi-calendar2-x as-empty-icon" aria-hidden="true"></i>
                        <span>No appointments in this view.</span>
                        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> Schedule One
                        </button>
                    </div>
                }
                @foreach (var a in list.OrderBy(x => x.ScheduledDate).ThenBy(x => x.ScheduledTime))
                {
                    <div class="as-appt-row @(_selectedAppt?.Id == a.Id ? "as-appt-selected" : "") @(a.ScheduledDate?.Date == DateTime.Today ? "as-appt-today" : "")"
                         @onclick="() => _selectedAppt = a">

                        <div class="as-appt-time-col">
                            <div class="as-appt-date">@(a.ScheduledDate?.ToString("MM/dd") ?? "TBD")</div>
                            <div class="as-appt-tod">@(a.ScheduledTime?.ToString("h:mm tt") ?? "—")</div>
                            <div class="as-appt-dur">@a.Duration</div>
                        </div>

                        <div class="as-appt-body-col">
                            <div class="as-appt-account">@a.AccountName</div>
                            <div class="as-appt-contact"><i class="bi bi-person" aria-hidden="true"></i>@a.ContactName</div>
                            <div class="as-appt-type-row">
                                <span class="as-type-chip">@a.Type</span>
                                <span class="as-ch-chip">
                                    <i class="bi @ApptChannelIcon(a.Channel)" aria-hidden="true"></i>@a.Channel
                                </span>
                            </div>
                            <div class="as-appt-meta">
                                @if (!string.IsNullOrEmpty(a.CsrOwner))
                                { <span class="ci-meta-chip ci-mc-csr"><i class="bi bi-headset" aria-hidden="true"></i>@a.CsrOwner</span> }
                                @if (!string.IsNullOrEmpty(a.Producer))
                                { <span class="ci-meta-chip"><i class="bi bi-person-badge" aria-hidden="true"></i>@a.Producer</span> }
                            </div>
                        </div>

                        <div class="as-appt-status-col">
                            <span class="as-status-badge as-st-@StatusCss(a.Status)">@a.Status</span>
                        </div>

                    </div>
                }
            }
        </div>
    </div>

    <!-- DETAIL PANEL -->
    <div class="as-detail-panel @(_selectedAppt is null ? "as-detail-empty" : "")">
        @if (_selectedAppt is null)
        {
            <div class="as-detail-placeholder">
                <i class="bi bi-calendar-event as-dp-icon" aria-hidden="true"></i>
                <h3>Select an appointment</h3>
                <p>Choose an appointment on the left to view details and take action.</p>
            </div>
        }
        else
        {
            var a = _selectedAppt;
            <div class="as-detail-header">
                <div>
                    <div class="as-detail-title">@a.Type</div>
                    <div class="as-detail-sub">@a.AccountName · @a.ContactName</div>
                </div>
                <div class="as-detail-actions">
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenEdit(a)" title="Edit">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenLog(a)" title="Log outcome">
                        <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => Reschedule(a)" title="Reschedule">
                        <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => CancelAppt(a)" title="Cancel">
                        <i class="bi bi-x-circle" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <div class="as-detail-body">

                <div class="as-detail-grid">
                    <div class="as-dg-cell"><div class="as-dg-lbl">Date</div><div class="as-dg-val">@(a.ScheduledDate?.ToString("dddd, MMMM d, yyyy") ?? "TBD")</div></div>
                    <div class="as-dg-cell"><div class="as-dg-lbl">Time</div><div class="as-dg-val">@(a.ScheduledTime?.ToString("h:mm tt") ?? "TBD")</div></div>
                    <div class="as-dg-cell"><div class="as-dg-lbl">Duration</div><div class="as-dg-val">@a.Duration</div></div>
                    <div class="as-dg-cell"><div class="as-dg-lbl">Channel</div>
                        <div class="as-dg-val"><i class="bi @ApptChannelIcon(a.Channel)" aria-hidden="true"></i> @a.Channel</div>
                    </div>
                    <div class="as-dg-cell"><div class="as-dg-lbl">Status</div>
                        <span class="as-status-badge as-st-@StatusCss(a.Status)">@a.Status</span>
                    </div>
                    <div class="as-dg-cell"><div class="as-dg-lbl">CSR</div>
                        <div class="as-dg-val">@(string.IsNullOrEmpty(a.CsrOwner) ? "—" : a.CsrOwner)</div>
                    </div>
                    <div class="as-dg-cell"><div class="as-dg-lbl">Producer</div>
                        <div class="as-dg-val">@(string.IsNullOrEmpty(a.Producer) ? "—" : a.Producer)</div>
                    </div>
                    <div class="as-dg-cell"><div class="as-dg-lbl">Branch</div>
                        <div class="as-dg-val">@(string.IsNullOrEmpty(a.Branch) ? "—" : a.Branch)</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(a.Notes))
                {
                    <div class="as-notes-box">
                        <div class="as-notes-lbl"><i class="bi bi-sticky" aria-hidden="true"></i> Notes</div>
                        <div class="as-notes-body">@a.Notes</div>
                    </div>
                }

                <div class="as-confirm-row">
                    <span class="@(a.SendConfirmation ? "as-conf-ok" : "as-conf-no")">
                        <i class="bi @(a.SendConfirmation ? "bi-check-circle" : "bi-x-circle")" aria-hidden="true"></i>
                        Confirmation @(a.SendConfirmation ? "will be sent" : "not sent")
                    </span>
                    <span class="@(a.SendReminder ? "as-conf-ok" : "as-conf-no")">
                        <i class="bi @(a.SendReminder ? "bi-check-circle" : "bi-x-circle")" aria-hidden="true"></i>
                        Reminder 24h @(a.SendReminder ? "enabled" : "disabled")
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(a.Outcome))
                {
                    <div class="as-outcome-box">
                        <div class="as-notes-lbl"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Outcome</div>
                        <div class="as-outcome-val">@a.Outcome</div>
                        @if (!string.IsNullOrEmpty(a.OutcomeNotes))
                        {
                            <div class="as-outcome-notes">@a.OutcomeNotes</div>
                        }
                        @if (!string.IsNullOrEmpty(a.FollowUp) && a.FollowUp != "None")
                        {
                            <div class="as-followup-row">
                                <i class="bi bi-arrow-return-right" aria-hidden="true"></i>
                                Follow-up: @a.FollowUp
                            </div>
                        }
                    </div>
                }

                <!-- Quick actions -->
                <div class="as-quick-actions">
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="SendReminderNow">
                        <i class="bi bi-bell" aria-hidden="true"></i> Send Reminder Now
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/communications/inbox")'>
                        <i class="bi bi-chat-dots" aria-hidden="true"></i> Open Inbox Thread
                    </button>
                    <button class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenLog(a)"
                            disabled="@(a.Status is "Completed" or "Cancelled")">
                        <i class="bi bi-clipboard-check" aria-hidden="true"></i> Log Outcome
                    </button>
                </div>
            </div>
        }
    </div>

</div>

@code {
    SfToast _toast = default!;
    readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    string _tab          = "today";
    string _search       = "";
    string _typeFilter   = "";
    string _statusFilter = "";
    string? _loadError;

    bool         _showDlg  = false;
    bool         _showLogDlg = false;
    Appointment? _edit;
    Appointment? _logTarget;
    Appointment? _selectedAppt;
    string       _logOutcome  = "";
    string       _logFollowUp = "";
    string       _logNotes    = "";

    readonly string[] _apptTypes    = { "Coverage Review","Renewal Discussion","Claims Follow-Up","New Business Quote","Policy Service","Audit Prep","CAT Site Visit","Welcome Call","Risk Assessment","Payment Arrangement" };
    readonly string[] _accountNames = { "Sullivan Mfg. LLC","Bridgewater Hotels","Metro Freight Co.","Apex Medical Group","Dallas Roofing LLC","Harbor View Marina","Greenleaf Nurseries","Sunrise Healthcare","Pacific Coast Builders","Harbor Logistics" };
    readonly string[] _producers    = { "Maria Santos","Robert Yamamoto","Diana Perez","James Park" };
    readonly string[] _csrs         = { "Sarah Kim","Kevin Obi","Lisa Chen","James Park" };
    readonly string[] _branches     = { "Gulf Coast","North Texas","Northeast","Central TX","Southwest" };

    sealed class Appointment
    {
        public Guid      Id                { get; set; }
        public string    AccountName       { get; set; } = "";
        public string    ContactName       { get; set; } = "";
        public string    Type              { get; set; } = "";
        public string    Channel           { get; set; } = "Phone Call";
        public string    Status            { get; set; } = "Scheduled";
        public string    Duration          { get; set; } = "30 min";
        public string    Producer          { get; set; } = "";
        public string    CsrOwner          { get; set; } = "";
        public string    Branch            { get; set; } = "";
        public string    Notes             { get; set; } = "";
        public string    Outcome           { get; set; } = "";
        public string    OutcomeNotes      { get; set; } = "";
        public string    FollowUp          { get; set; } = "";
        public bool      SendConfirmation  { get; set; } = true;
        public bool      SendReminder      { get; set; } = true;
        public DateTime? ScheduledDate     { get; set; }
        public DateTime? ScheduledTime     { get; set; }
    }

    List<Appointment> _appts = new();

    IEnumerable<Appointment> FilteredAppts => _appts.Where(a =>
        MatchTab(a)
     && (string.IsNullOrEmpty(_search)      || a.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase) || a.ContactName.Contains(_search, StringComparison.OrdinalIgnoreCase) || a.Type.Contains(_search, StringComparison.OrdinalIgnoreCase))
     && (string.IsNullOrEmpty(_typeFilter)  || a.Type   == _typeFilter)
     && (string.IsNullOrEmpty(_statusFilter)|| a.Status == _statusFilter));

    bool MatchTab(Appointment a) => _tab switch
    {
        "today"    => a.ScheduledDate?.Date == DateTime.Today,
        "upcoming" => a.ScheduledDate.HasValue && a.ScheduledDate.Value.Date > DateTime.Today && a.Status == "Scheduled",
        _          => true
    };

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Communications","/communications/inbox"), new("Appointments",""));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            var result = await Api.SearchCommunicationAppointmentsAsync(_tenantId, _search);
            _appts = result?.Items.Select(a => new Appointment
            {
                Id = a.AppointmentId,
                AccountName = a.AccountName,
                ContactName = a.ContactName,
                Type = a.Type,
                Channel = a.Channel,
                Status = a.Status,
                Duration = a.Duration,
                Producer = a.Producer,
                CsrOwner = a.CsrOwner,
                Branch = a.Branch,
                Notes = a.Notes,
                Outcome = a.Outcome,
                OutcomeNotes = a.OutcomeNotes,
                FollowUp = a.FollowUp,
                SendConfirmation = a.SendConfirmation,
                SendReminder = a.SendReminder,
                ScheduledDate = a.ScheduledDate,
                ScheduledTime = a.ScheduledTime
            }).ToList() ?? [];
            _selectedAppt ??= _appts.FirstOrDefault(a => a.ScheduledDate?.Date == DateTime.Today) ?? _appts.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load appointments: {ex.Message}";
            _appts = [];
            _selectedAppt = null;
        }
    }

    void BuildStub()
    {
        var d = DateTime.Today;
        _appts = new List<Appointment>
        {
