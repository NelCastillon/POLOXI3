    private sealed class AppointmentForm
    {
        public Guid Id { get; set; }
        [Required, StringLength(200)] public string AccountName { get; set; } = string.Empty;
        [Required, StringLength(160)] public string ContactName { get; set; } = string.Empty;
        [Required, StringLength(80)] public string Type { get; set; } = string.Empty;
        [Required, StringLength(80)] public string Channel { get; set; } = "Phone Call";
        [Required, StringLength(50)] public string Status { get; set; } = "Scheduled";
        [Required, StringLength(40)] public string Duration { get; set; } = "30 min";
        [StringLength(160)] public string Producer { get; set; } = string.Empty;
        [StringLength(160)] public string CsrOwner { get; set; } = string.Empty;
        [StringLength(120)] public string Branch { get; set; } = string.Empty;
        [StringLength(2000)] public string Notes { get; set; } = string.Empty;
        public bool SendConfirmation { get; set; }
        public bool SendReminder { get; set; }
        [Required] public DateTime? ScheduledDate { get; set; }
        [Required] public string ScheduledTimeText { get; set; } = string.Empty;

        public static AppointmentForm From(Appointment a) => new() { Id = a.Id, AccountName = a.AccountName, ContactName = a.ContactName, Type = a.Type, Channel = a.Channel, Status = a.Status, Duration = a.Duration, Producer = a.Producer, CsrOwner = a.CsrOwner, Branch = a.Branch, Notes = a.Notes, SendConfirmation = a.SendConfirmation, SendReminder = a.SendReminder, ScheduledDate = a.ScheduledDate, ScheduledTimeText = a.ScheduledTime?.ToString("HH:mm") ?? string.Empty };
        public UpsertCommunicationAppointmentRequest ToRequest(Guid tenantId)
        {
            DateTime? scheduledTime = null;
            if (ScheduledDate.HasValue && TimeOnly.TryParse(ScheduledTimeText, out var time))
            {
                scheduledTime = ScheduledDate.Value.Date.Add(time.ToTimeSpan());
            }
            return new UpsertCommunicationAppointmentRequest { AppointmentId = Id, TenantId = tenantId, AccountName = AccountName, ContactName = ContactName, Type = Type, Channel = Channel, Status = Status, Duration = Duration, Producer = Producer, CsrOwner = CsrOwner, Branch = Branch, Notes = Notes, SendConfirmation = SendConfirmation, SendReminder = SendReminder, ScheduledDate = ScheduledDate, ScheduledTime = scheduledTime };
        }
    }
}
