@page "/commissions/split-rules"
@page "/commissions/splits"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>Commission Split Rules</PageTitle>

<AppPageHeader Title="Commission Split Rules" Icon="bi-scissors">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Rule</button>
    </Actions>
</AppPageHeader>

<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
</div>

@if (_loading)
{
    <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_loadError</div>
}
else
{
    <SfGrid TValue="CommissionSplitRuleDto" DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridEvents TValue="CommissionSplitRuleDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(CommissionSplitRuleDto.RuleName)" HeaderText="Rule Name" Width="240"></GridColumn>
            <GridColumn Field="@nameof(CommissionSplitRuleDto.SplitTypeCode)" HeaderText="Split Type" Width="130"></GridColumn>
            <GridColumn Field="@nameof(CommissionSplitRuleDto.SplitPct)" HeaderText="Split %" Format="N4" Width="110"></GridColumn>
            <GridColumn Field="@nameof(CommissionSplitRuleDto.Priority)" HeaderText="Priority" Width="100"></GridColumn>
            <GridColumn Field="@nameof(CommissionSplitRuleDto.EffectiveStartDate)" HeaderText="Effective Start" Type="ColumnType.Date" Format="d" Width="150"></GridColumn>
            <GridColumn Field="@nameof(CommissionSplitRuleDto.StatusCode)" HeaderText="Status" Width="120"></GridColumn>
            <GridColumn Field="@nameof(CommissionSplitRuleDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="g" Width="180"></GridColumn>
            <GridColumn HeaderText="Actions" Width="90"><Template>@{ var item = (CommissionSplitRuleDto)context; }<button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button></Template></GridColumn>
        </GridColumns>
    </SfGrid>
}

<SfDialog @bind-Visible="_showForm" Width="680px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates><Content>
        <div class="um-modal-header"><i class="bi bi-scissors" aria-hidden="true"></i><span>@(_editingId == Guid.Empty ? "New Split Rule" : "Edit Split Rule")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
        <EditForm EditContext="_editContext"><DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field"><label>Plan <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.CommissionPlanId" class="um-input"><option value="@Guid.Empty">Select plan…</option>@foreach (var plan in _plans) { <option value="@plan.CommissionPlanId">@plan.PlanName</option> }</InputSelect><ValidationMessage For="() => _form.CommissionPlanId" class="validation-message text-danger" /></div>
                <div class="um-field"><label>Rule Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.RuleName" class="um-input" /><ValidationMessage For="() => _form.RuleName" class="validation-message text-danger" /></div>
                <div class="um-field"><label>Split Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.SplitTypeCode" class="um-input"><option value="Producer">Producer</option><option value="CSR">CSR</option><option value="House Account">House Account</option><option value="Override">Override</option></InputSelect><ValidationMessage For="() => _form.SplitTypeCode" class="validation-message text-danger" /></div>
                <div class="um-field"><label>Split %</label><InputNumber @bind-Value="_form.SplitPct" class="um-input" /><ValidationMessage For="() => _form.SplitPct" class="validation-message text-danger" /></div>
                <div class="um-field"><label>Override Rate %</label><InputNumber @bind-Value="_form.OverrideRatePct" class="um-input" /><ValidationMessage For="() => _form.OverrideRatePct" class="validation-message text-danger" /></div>
                <div class="um-field"><label>Priority</label><InputNumber @bind-Value="_form.Priority" class="um-input" /><ValidationMessage For="() => _form.Priority" class="validation-message text-danger" /></div>
                <div class="um-field"><label>Effective Start <span class="text-danger">*</span></label><InputDate @bind-Value="_form.EffectiveStartDate" class="um-input" /><ValidationMessage For="() => _form.EffectiveStartDate" class="validation-message text-danger" /></div>
                <div class="um-field"><label>Effective End</label><InputDate @bind-Value="_form.EffectiveEndDate" class="um-input" /><ValidationMessage For="() => _form.EffectiveEndDate" class="validation-message text-danger" /></div>
                <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input"><option value="Active">Active</option><option value="Inactive">Inactive</option><option value="Draft">Draft</option></InputSelect><ValidationMessage For="() => _form.StatusCode" class="validation-message text-danger" /></div>
                @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
            </div></div>
        </EditForm>
        <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Rule")</button></div>
    </Content></DialogTemplates>
</SfDialog>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm, _loadError, _formError;
    private bool _loading, _showForm, _saving;
    private List<CommissionSplitRuleDto> _items = [];
    private List<CommissionPlanDto> _plans = [];
    private Guid _editingId = Guid.Empty;
    private SplitRuleForm _form = new();
    private EditContext _editContext = default!;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        _editContext = new(_form);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchCommissionSplitRulesAsync(_tenantId, _searchTerm);
            var plans = await Api.SearchCommissionPlansAsync(_tenantId);
            _items = result?.Items.ToList() ?? [];
            _plans = plans?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _items = [];
        }
        finally { _loading = false; }
    }

    private void OnRowSelected(RowSelectEventArgs<CommissionSplitRuleDto> args) => OpenEdit(args.Data);
    private void OpenCreate() { _editingId = Guid.Empty; _form = new(); _editContext = new(_form); _formError = null; _showForm = true; }
    private void OpenEdit(CommissionSplitRuleDto item) { _editingId = item.SplitRuleId; _form = new SplitRuleForm { CommissionPlanId = item.CommissionPlanId, RuleName = item.RuleName, SplitTypeCode = item.SplitTypeCode, SplitPct = item.SplitPct, OverrideRatePct = item.OverrideRatePct, Priority = item.Priority, EffectiveStartDate = item.EffectiveStartDate.ToDateTime(TimeOnly.MinValue), EffectiveEndDate = item.EffectiveEndDate?.ToDateTime(TimeOnly.MinValue), StatusCode = item.StatusCode }; _editContext = new(_form); _formError = null; _showForm = true; }
    private void CloseForm() => _showForm = false;
    private async Task SaveAsync() { if (!_editContext.Validate()) return; if (_form.EffectiveEndDate.HasValue && _form.EffectiveEndDate.Value < _form.EffectiveStartDate) { _formError = "Effective End must be on or after Effective Start."; return; } _saving = true; try { if (_editingId == Guid.Empty) await Api.CreateCommissionSplitRuleAsync(new CreateCommissionSplitRuleRequest { TenantId = _tenantId, CommissionPlanId = _form.CommissionPlanId, RuleName = _form.RuleName, SplitTypeCode = _form.SplitTypeCode, SplitPct = _form.SplitPct, OverrideRatePct = _form.OverrideRatePct, Priority = _form.Priority, EffectiveStartDate = DateOnly.FromDateTime(_form.EffectiveStartDate), EffectiveEndDate = _form.EffectiveEndDate.HasValue ? DateOnly.FromDateTime(_form.EffectiveEndDate.Value) : null, StatusCode = _form.StatusCode }); else await Api.UpdateCommissionSplitRuleAsync(_editingId, new UpdateCommissionSplitRuleRequest { TenantId = _tenantId, SplitRuleId = _editingId, CommissionPlanId = _form.CommissionPlanId, RuleName = _form.RuleName, SplitTypeCode = _form.SplitTypeCode, SplitPct = _form.SplitPct, OverrideRatePct = _form.OverrideRatePct, Priority = _form.Priority, EffectiveStartDate = DateOnly.FromDateTime(_form.EffectiveStartDate), EffectiveEndDate = _form.EffectiveEndDate.HasValue ? DateOnly.FromDateTime(_form.EffectiveEndDate.Value) : null, StatusCode = _form.StatusCode }); _showForm = false; await LoadAsync(); } catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; } finally { _saving = false; } }
    private sealed class SplitRuleForm { [RequiredGuid(ErrorMessage = "Commission Plan is required.")] public Guid CommissionPlanId { get; set; } [Required, StringLength(200)] public string RuleName { get; set; } = string.Empty; [Required, StringLength(50)] public string SplitTypeCode { get; set; } = "Producer"; [Range(0, 100)] public decimal SplitPct { get; set; } [Range(0, 100)] public decimal? OverrideRatePct { get; set; } [Range(0, 9999)] public int Priority { get; set; } = 100; [Required] public DateTime EffectiveStartDate { get; set; } = DateTime.Today; public DateTime? EffectiveEndDate { get; set; } [Required, StringLength(50)] public string StatusCode { get; set; } = "Active"; }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
