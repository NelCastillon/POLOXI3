@page "/billing/recurring"
@inject ApiClient Api

<PageTitle>Recurring Billing</PageTitle>
<h1>Recurring Billing Schedules</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(RecurringBillingScheduleDto.ScheduleName)"    HeaderText="Schedule"   Width="220"></GridColumn>
        <GridColumn Field="@nameof(RecurringBillingScheduleDto.FrequencyCode)"   HeaderText="Frequency"  Width="120"></GridColumn>
        <GridColumn Field="@nameof(RecurringBillingScheduleDto.BillingAmount)"   HeaderText="Amount"     Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(RecurringBillingScheduleDto.StartDate)"       HeaderText="Start"      Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(RecurringBillingScheduleDto.NextBillingDate)" HeaderText="Next Bill"  Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(RecurringBillingScheduleDto.StatusCode)"      HeaderText="Status"     Width="110"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<RecurringBillingScheduleDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchRecurringBillingSchedulesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
