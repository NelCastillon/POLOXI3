@page "/billing/credits"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Credits &amp; Refunds — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Credits &amp; Refunds"
               Subtitle="Tenant Admin view of billing credits, refunds, and adjustment approvals synchronized with Billing and Accounting"
               Icon="bi-arrow-counterclockwise">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/billing/invoices")'><i class="bi bi-receipt" aria-hidden="true"></i> Invoices</button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> Issue Credit</button>
    </Actions>
</AppPageHeader>

<div class="cr-kpi-strip">
    <button type="button" class="cr-kpi" @onclick='() => SetFilter("")'><i class="bi bi-arrow-counterclockwise cr-ki blue" aria-hidden="true"></i><div><div class="cr-kv">@_items.Count</div><div class="cr-kl">Total Credits</div></div></button>
    <button type="button" class="cr-kpi" @onclick='() => SetFilter("Pending")'><i class="bi bi-hourglass cr-ki amber" aria-hidden="true"></i><div><div class="cr-kv">@_items.Count(x => x.StatusCode == "Pending")</div><div class="cr-kl">Pending</div></div></button>
    <button type="button" class="cr-kpi" @onclick='() => SetFilter("Approved")'><i class="bi bi-check-circle cr-ki green" aria-hidden="true"></i><div><div class="cr-kv">@_items.Count(x => x.StatusCode == "Approved")</div><div class="cr-kl">Approved</div></div></button>
    <button type="button" class="cr-kpi" @onclick='() => SetFilter("Applied")'><i class="bi bi-arrow-return-left cr-ki green" aria-hidden="true"></i><div><div class="cr-kv">@_items.Count(x => x.StatusCode == "Applied")</div><div class="cr-kl">Applied</div></div></button>
    <button type="button" class="cr-kpi"><i class="bi bi-currency-dollar cr-ki blue" aria-hidden="true"></i><div><div class="cr-kv">@Fmt(_items.Sum(x => x.Amount))</div><div class="cr-kl">Total Value</div></div></button>
    <button type="button" class="cr-kpi"><i class="bi bi-bank cr-ki purple" aria-hidden="true"></i><div><div class="cr-kv">Finance</div><div class="cr-kl">GL Synced</div></div></button>
</div>

<div class="cr-toolbar">
    <SfTextBox Placeholder="Search reason, type, invoice..." @bind-Value="_search" Width="280px"></SfTextBox>
    <select class="um-input cr-sel" @bind="_filterType">
        <option value="">All Types</option>
        @foreach (var type in _creditTypes)
        {
            <option value="@type">@type</option>
        }
    </select>
    <select class="um-input cr-sel" @bind="_filterStatus">
        <option value="">All Statuses</option>
        @foreach (var status in _statuses)
        {
            <option value="@status">@status</option>
        }
    </select>
    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync"><i class="bi bi-search" aria-hidden="true"></i> Search</button>
</div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}

<div class="cr-grid-wrap">
    @if (_loading)
    {
        <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading credits…</span></div>
    }
    <SfGrid TValue="BillingAdjustmentDto" DataSource="FilteredItems" AllowSorting="true" AllowPaging="true" Height="520px">
        <GridEvents TValue="BillingAdjustmentDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="15"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(BillingAdjustmentDto.AdjustmentDate)" HeaderText="Date" Type="ColumnType.Date" Format="d" Width="110"></GridColumn>
            <GridColumn Field="@nameof(BillingAdjustmentDto.AdjustmentTypeCode)" HeaderText="Type" Width="170">
                <Template>@{ var item = (BillingAdjustmentDto)context; }<span class="cr-type-chip cr-t-@CssKey(item.AdjustmentTypeCode)">@item.AdjustmentTypeCode</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(BillingAdjustmentDto.Amount)" HeaderText="Amount" Format="C2" Width="130" TextAlign="TextAlign.Right"></GridColumn>
            <GridColumn Field="@nameof(BillingAdjustmentDto.Reason)" HeaderText="Reason" Width="300"></GridColumn>
            <GridColumn Field="@nameof(BillingAdjustmentDto.StatusCode)" HeaderText="Status" Width="120">
                <Template>@{ var item = (BillingAdjustmentDto)context; }<span class="cr-status-chip cr-st-@CssKey(item.StatusCode)">@item.StatusCode</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(BillingAdjustmentDto.ApprovedDateUtc)" HeaderText="Approved" Type="ColumnType.DateTime" Format="d" Width="120"></GridColumn>
            <GridColumn HeaderText="Actions" Width="150">
                <Template>
                    @{ var item = (BillingAdjustmentDto)context; }
                    <div style="display:flex;gap:.25rem">
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                        @if (item.StatusCode == "Pending")
                        {
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick='() => UpdateStatusAsync(item, "Approved")' title="Approve"><i class="bi bi-check-circle" aria-hidden="true"></i></button>
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick='() => UpdateStatusAsync(item, "Denied")' title="Deny"><i class="bi bi-x-circle" aria-hidden="true"></i></button>
                        }
                        @if (item.StatusCode == "Approved")
                        {
                            <button class="um-btn um-btn-primary um-btn-xs" @onclick:stopPropagation="true" @onclick='() => UpdateStatusAsync(item, "Applied")' title="Apply">Apply</button>
                        }
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showForm" Width="620px" ShowCloseIcon="false" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i><span>@(_editingId == Guid.Empty ? "Issue Credit / Refund" : "Edit Credit / Refund")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Account <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.AccountId" class="um-input"><option value="@Guid.Empty">Select account…</option>@foreach (var account in _accounts) { <option value="@account.AccountId">@account.AccountName</option> }</InputSelect><ValidationMessage For="() => _form.AccountId" class="text-danger" /></div>
                    <div class="um-field"><label>Invoice <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.InvoiceId" class="um-input"><option value="@Guid.Empty">Select invoice…</option>@foreach (var invoice in _invoices) { <option value="@invoice.InvoiceId">@invoice.InvoiceNumber (@invoice.BalanceAmount.ToString("C0"))</option> }</InputSelect><ValidationMessage For="() => _form.InvoiceId" class="text-danger" /></div>
                    <div class="um-field"><label>Credit Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.AdjustmentTypeCode" class="um-input">@foreach (var type in _creditTypes) { <option value="@type">@type</option> }</InputSelect><ValidationMessage For="() => _form.AdjustmentTypeCode" class="text-danger" /></div>
                    <div class="um-field"><label>Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.AdjustmentDate" class="um-input" /><ValidationMessage For="() => _form.AdjustmentDate" class="text-danger" /></div>
                    <div class="um-field"><label>Amount <span class="text-danger">*</span></label><InputNumber @bind-Value="_form.Amount" class="um-input" /><ValidationMessage For="() => _form.Amount" class="text-danger" /></div>
                    <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input">@foreach (var status in _statuses) { <option value="@status">@status</option> }</InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
                    <div class="um-field um-field--full"><label>Reason <span class="text-danger">*</span></label><InputTextArea @bind-Value="_form.Reason" class="um-input" rows="3" /><ValidationMessage For="() => _form.Reason" class="text-danger" /></div>
                    @if (!string.IsNullOrWhiteSpace(_formError))
                    {
                        <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div>
                    }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Credit")</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private SfToast _toast = default!;
    private List<BillingAdjustmentDto> _items = [];
    private List<BillingAccountDto> _accounts = [];
    private List<InvoiceDto> _invoices = [];
    private string _search = string.Empty, _filterType = string.Empty, _filterStatus = string.Empty;
    private bool _loading, _showForm, _saving;
    private string? _loadError, _formError;
    private Guid _editingId = Guid.Empty;
    private CreditForm _form = new();
    private EditContext _editContext = default!;

    private readonly List<string> _creditTypes = ["Premium Refund", "Endorsement Credit", "Cancellation Return", "Billing Adjustment", "Duplicate Payment", "Carrier Credit", "Other"];
    private readonly List<string> _statuses = ["Pending", "Approved", "Applied", "Refunded", "Denied"];

    private IEnumerable<BillingAdjustmentDto> FilteredItems => _items.Where(i =>
        (string.IsNullOrWhiteSpace(_search) || i.Reason.Contains(_search, StringComparison.OrdinalIgnoreCase) || i.AdjustmentTypeCode.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_filterType) || i.AdjustmentTypeCode == _filterType) &&
        (string.IsNullOrWhiteSpace(_filterStatus) || i.StatusCode == _filterStatus));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Billing", "/billing/accounts"), new("Credits & Refunds", ""));
        _editContext = new(_form);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var credits = await Api.SearchBillingAdjustmentsAsync(_tenantId, _search);
            var accounts = await Api.SearchBillingAccountsAsync(_tenantId, pageSize: 500);
            var invoices = await Api.SearchInvoicesAsync(_tenantId);
            _items = credits?.Items.ToList() ?? [];
            _accounts = accounts?.Items.ToList() ?? [];
            _invoices = invoices?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = $"Credits failed to load: {ex.Message}";
            await ToastAsync(_loadError, true);
        }
        finally { _loading = false; }
    }

    private void SetFilter(string status) => _filterStatus = status;
    private void OnRowSelected(RowSelectEventArgs<BillingAdjustmentDto> args) => OpenEdit(args.Data);
    private void OpenCreate() { _editingId = Guid.Empty; _form = new(); _editContext = new(_form); _formError = null; _showForm = true; }
    private void OpenEdit(BillingAdjustmentDto item)
    {
        _editingId = item.AdjustmentId;
        _form = new CreditForm { AccountId = item.AccountId, InvoiceId = item.InvoiceId, AdjustmentTypeCode = item.AdjustmentTypeCode, AdjustmentDate = item.AdjustmentDate.ToDateTime(TimeOnly.MinValue), Amount = item.Amount, Reason = item.Reason, StatusCode = item.StatusCode };
        _editContext = new(_form);
        _formError = null;
        _showForm = true;
    }
    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        if (!_editContext.Validate()) return;
        _saving = true;
        try
        {
            if (_editingId == Guid.Empty)
            {
                await Api.CreateBillingAdjustmentAsync(new CreateBillingAdjustmentRequest { TenantId = _tenantId, AccountId = _form.AccountId, InvoiceId = _form.InvoiceId, AdjustmentTypeCode = _form.AdjustmentTypeCode, AdjustmentDate = DateOnly.FromDateTime(_form.AdjustmentDate), Amount = _form.Amount, Reason = _form.Reason, StatusCode = _form.StatusCode });
                await ToastAsync("Credit issued.");
            }
            else
            {
                await Api.UpdateBillingAdjustmentAsync(_editingId, new UpdateBillingAdjustmentRequest { AdjustmentId = _editingId, AccountId = _form.AccountId, InvoiceId = _form.InvoiceId, AdjustmentTypeCode = _form.AdjustmentTypeCode, AdjustmentDate = DateOnly.FromDateTime(_form.AdjustmentDate), Amount = _form.Amount, Reason = _form.Reason, StatusCode = _form.StatusCode });
                await ToastAsync("Credit updated.");
            }
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
            await ToastAsync(_formError, true);
        }
        finally { _saving = false; }
    }

    private async Task UpdateStatusAsync(BillingAdjustmentDto item, string status)
    {
        try
        {
            await Api.UpdateBillingAdjustmentAsync(item.AdjustmentId, new UpdateBillingAdjustmentRequest { AdjustmentId = item.AdjustmentId, AccountId = item.AccountId, InvoiceId = item.InvoiceId, AdjustmentTypeCode = item.AdjustmentTypeCode, AdjustmentDate = item.AdjustmentDate, Amount = item.Amount, Reason = item.Reason, StatusCode = status, ApprovedDateUtc = status == "Approved" ? DateTime.UtcNow : item.ApprovedDateUtc });
            await ToastAsync($"Credit {status.ToLowerInvariant()}.");
            await LoadAsync();
        }
        catch (Exception ex) { await ToastAsync($"Update failed: {ex.Message}", true); }
    }

    private async Task ToastAsync(string message, bool isError = false) => await _toast.ShowAsync(new ToastModel { Content = message, CssClass = isError ? "e-toast-danger" : "e-toast-success" });
    private static string Fmt(decimal v) => v.ToString("C0");
    private static string CssKey(string value) => value.ToLowerInvariant().Replace(" ", "-").Replace("/", "-");

    private sealed class CreditForm
    {
        [RequiredGuid(ErrorMessage = "Account is required.")]
        public Guid AccountId { get; set; }
        [RequiredGuid(ErrorMessage = "Invoice is required.")]
        public Guid InvoiceId { get; set; }
        [Required, StringLength(80)]
        public string AdjustmentTypeCode { get; set; } = "Premium Refund";
        [Required]
        public DateTime AdjustmentDate { get; set; } = DateTime.Today;
        [Range(0.01, 100000000)]
        public decimal Amount { get; set; }
        [Required, StringLength(1000)]
        public string Reason { get; set; } = string.Empty;
        [Required, StringLength(50)]
        public string StatusCode { get; set; } = "Pending";
    }

    private sealed class RequiredGuidAttribute : ValidationAttribute
    {
        public override bool IsValid(object? value) => value is Guid guid && guid != Guid.Empty;
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
