<div class="intake-workspace">
    <nav class="intake-nav" aria-label="Document intake navigation">
        <div class="intake-brand">
            <span><i class="bi bi-stars"></i></span>
            <div>
                <strong>AI Document Intake</strong>
                <small>Governed evidence to draft data</small>
            </div>
        </div>
        <NavLink href="/operations/document-intake" Match="NavLinkMatch.All"><i class="bi bi-inboxes"></i> Intake Center</NavLink>
        <NavLink href="/operations/document-intake/review"><i class="bi bi-ui-checks-grid"></i> Review Queue</NavLink>
        <NavLink href="/operations/document-intake/exceptions"><i class="bi bi-exclamation-octagon"></i> Exceptions</NavLink>
        <NavLink href="/operations/document-intake/history"><i class="bi bi-clock-history"></i> History</NavLink>
        <NavLink href="/operations/document-intake/ai-processing"><i class="bi bi-cpu"></i> AI Processing</NavLink>
        <AuthorizeView Policy="@Ams.Web.Security.DocumentIntakePolicies.Admin"><NavLink href="/operations/document-intake/operations"><i class="bi bi-activity"></i> Operations</NavLink></AuthorizeView>
        <NavLink href="/documents"><i class="bi bi-folder2-open"></i> Documents Hub</NavLink>
    </nav>
    <main class="intake-content">@ChildContent</main>
</div>
@code { [Parameter] public RenderFragment? ChildContent { get; set; } }
