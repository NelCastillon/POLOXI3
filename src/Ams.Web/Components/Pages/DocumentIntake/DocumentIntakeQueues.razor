@page "/operations/document-intake/review"
@page "/operations/document-intake/exceptions"
@page "/operations/document-intake/history"
@attribute [Authorize(Policy=Ams.Web.Security.DocumentIntakePolicies.Read)]
@using Ams.Application.Features.DocumentIntake
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@Title</PageTitle>

<DocumentIntakeWorkspace>
    <section class="di-queue-hero" aria-labelledby="di-queue-title">
        <div class="di-queue-hero__icon"><i class="bi @Icon"></i></div>
        <div>
            <span>@Eyebrow</span>
            <h1 id="di-queue-title">@Title</h1>
            <p>@Subtitle</p>
        </div>
    </section>

    <section class="di-queue-shell" aria-label="@Title sessions">
        <DocumentIntakeQueue Status="@Status" LockStatus="@LockStatus" />
    </section>
</DocumentIntakeWorkspace>

@code {
    private string Title => Mode switch { "review" => "AI Review Queue", "exceptions" => "Document Intake Exceptions", _ => "Document Intake History" };
    private string Subtitle => Mode switch { "review" => "Review, correct, approve, or reject extracted insurance data", "exceptions" => "Resolve failed processing and blocking validation issues", _ => "Trace completed, cancelled, and governed intake sessions" };
    private string Eyebrow => Mode switch { "review" => "Human-in-the-loop validation", "exceptions" => "Operational exception handling", _ => "Governed intake audit trail" };
    private string Icon => Mode switch { "review" => "bi-ui-checks-grid", "exceptions" => "bi-exclamation-octagon", _ => "bi-clock-history" };
    private string? Status => Mode switch { "review" => DocumentIntakeStatuses.ReviewRequired, "exceptions" => DocumentIntakeStatuses.Failed, _ => null };
    private bool LockStatus => Mode != "history";
    private string Mode => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').Split('/').Last();

    protected override void OnInitialized() => Breadcrumbs.SetCrumbs(new("Home", "/"), new("Document Intake", "/operations/document-intake"), new(Title));
}
