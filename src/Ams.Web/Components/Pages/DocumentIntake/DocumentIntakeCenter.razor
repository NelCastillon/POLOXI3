@page "/operations/document-intake"
@attribute [Authorize(Policy=Ams.Web.Security.DocumentIntakePolicies.Read)]
@using Ams.Application.Features.DocumentIntake
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject NotificationService Notifications
<PageTitle>AI Document Intake</PageTitle><DocumentIntakeWorkspace><AppPageHeader Title="AI Document Intake Center" Subtitle="Transform legal evidence into reviewed, validated business drafts" Icon="bi-stars"><Actions><AuthorizeView Policy="@Ams.Web.Security.DocumentIntakePolicies.Upload"><button class="um-btn um-btn-primary" @onclick="()=>_drawer=true"><i class="bi bi-plus-lg"></i> New intake</button></AuthorizeView></Actions></AppPageHeader><div class="intake-kpis"><div class="intake-kpi"><strong>@_review</strong><span>Awaiting review</span></div><div class="intake-kpi"><strong>@_processing</strong><span>Processing</span></div><div class="intake-kpi"><strong>@_failed</strong><span>Exceptions</span></div><div class="intake-kpi"><strong>@_ready</strong><span>Ready to promote</span></div></div><DocumentIntakeQueue @ref="_queue"/></DocumentIntakeWorkspace>
<AppCrudDrawer @bind-Visible="_drawer" Title="Create document intake" Icon="bi-stars" IsBusy="_saving"><Content><EditForm Model="_form" OnValidSubmit="CreateAsync"><DataAnnotationsValidator/><ValidationSummary/><div class="knowledge-form-grid"><div class="knowledge-field"><label>Module</label><InputSelect class="knowledge-input" @bind-Value="_form.ModuleCode">@foreach(var module in DocumentIntakeModules.All.Order()){<option value="@module">@module.Replace('_',' ')</option>}</InputSelect></div><div class="knowledge-field"><label>Entry point</label><InputSelect class="knowledge-input" @bind-Value="_form.EntryPointCode"><option>MANUAL_UPLOAD</option><option>EMAIL</option><option>ZIP_PACKAGE</option><option>CARRIER_DOWNLOAD</option><option>CLIENT_PORTAL</option><option>API</option></InputSelect></div><div class="knowledge-field"><label>Priority</label><InputSelect class="knowledge-input" @bind-Value="_form.PriorityCode"><option>NORMAL</option><option>HIGH</option><option>LOW</option></InputSelect></div><div class="knowledge-field knowledge-field-wide"><label>Idempotency key</label><InputText class="knowledge-input" @bind-Value="_form.IdempotencyKey"/><small>Use the source message, package, or transaction identifier to prevent duplicates.</small></div></div></EditForm></Content></AppCrudDrawer>
@code{private DocumentIntakeQueue?_queue;private bool _drawer,_saving;private int _review,_processing,_failed,_ready;private FormModel _form=new();protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Documents","/documents"),new("Document Intake","/operations/document-intake"));await LoadKpisAsync();}private async Task LoadKpisAsync(){var rows=(await Api.SearchDocumentIntakeAsync(pageSize:500))?.Items??[];_review=rows.Count(x=>x.StatusCode==DocumentIntakeStatuses.ReviewRequired);_processing=rows.Count(x=>x.StatusCode is DocumentIntakeStatuses.Processing or DocumentIntakeStatuses.Queued);_failed=rows.Count(x=>x.StatusCode==DocumentIntakeStatuses.Failed);_ready=rows.Count(x=>x.StatusCode==DocumentIntakeStatuses.Ready);}private async Task CreateAsync(){_saving=true;try{var user=await CurrentUser.RequireAsync();var id=await Api.CreateDocumentIntakeAsync(new(user.TenantId,_form.IdempotencyKey,_form.ModuleCode,_form.EntryPointCode,_form.PriorityCode,null,null,Guid.NewGuid().ToString("N"),user.UserId));_drawer=false;Nav.NavigateTo($"/operations/document-intake/{id}");}catch(Exception ex){Notifications.Add(new(Guid.NewGuid(),"Intake creation failed",ex.Message,"bi-exclamation-triangle","danger"));}finally{_saving=false;}}private sealed class FormModel{[Required]public string ModuleCode{get;set;}=DocumentIntakeModules.Submission;[Required]public string EntryPointCode{get;set;}="MANUAL_UPLOAD";[Required]public string PriorityCode{get;set;}="NORMAL";[Required,StringLength(200)]public string IdempotencyKey{get;set;}=$"manual-{Guid.NewGuid():N}";}}
