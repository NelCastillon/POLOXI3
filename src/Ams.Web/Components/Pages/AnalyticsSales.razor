@page "/analytics/sales"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject ConfirmationDialogService Confirmations
@inject IJSRuntime Js

<PageTitle>Sales Analytics — AMS</PageTitle>

<AppPageHeader Title="Sales Analytics"
               Subtitle="Enterprise sales command center for pipeline, conversion, producers, risks, plays, reports, exports, and scheduled delivery."
               Icon="bi-graph-up-arrow">
    <Actions>
        <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_busy"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="OpenScheduleForSelected" disabled="@(_selectedReport is null || _busy)"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Schedule Report</button>
        <button class="um-btn um-btn-primary" type="button" @onclick="ExportSalesViewAsync" disabled="@(!_salesReports.Any() || _busy)"><i class="bi bi-download" aria-hidden="true"></i> Export Sales Pack</button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="as-toast @_toastClass" role="status">
        <i class="bi @(_toastClass == "as-toast--danger" ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="as-toast-close" @onclick="ClearToast" aria-label="Dismiss message"><i class="bi bi-x-lg"></i></button>
    </div>
}

<div class="as-page">
    <section class="as-hero">
        <div class="as-hero-main">
            <div class="as-eyebrow"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i> Sales performance cockpit</div>
            <h2>@FormatCurrency(NewBusinessPremium) new business pipeline command</h2>
            <p>Prioritize revenue by sales impact: active pipeline, quote-to-bind conversion, producer goal attainment, stalled deal risk, cross-sell plays, report execution, and scheduled executive delivery.</p>
            <div class="as-hero-meta">
                <span><i class="bi bi-funnel"></i> @TotalPipelineCount.ToString("N0") active opportunities</span>
                <span><i class="bi bi-cash-stack"></i> @FormatCurrency(PipelineAmount) pipeline value</span>
                <span><i class="bi bi-bullseye"></i> @AverageConversion.ToString("N1")% avg conversion</span>
                <span><i class="bi bi-person-badge"></i> @TopProducerName top producer</span>
            </div>
        </div>
        <div class="as-hero-panel">
            <div class="as-score-card">
                <span>Sales readiness score</span>
                <strong>@SalesReadinessScore%</strong>
                <div class="as-score-track"><div style="width:@SalesReadinessScore%"></div></div>
                <small>@SalesReadinessSummary</small>
            </div>
            <div class="as-priority-list">
                @foreach (var item in PriorityItems)
                {
                    <button type="button" class="as-priority-item" @onclick="() => SelectSalesItem(item)">
                        <span class="as-risk as-risk--@PriorityCss(item.Priority)">@ItemScore(item)</span>
                        <div><strong>@item.Title</strong><small>@item.NextAction</small></div>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="as-kpi-strip" aria-label="Sales KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="as-kpi-card @(IsActiveKpi(kpi.Key) ? "as-kpi-card--active" : null)" title="@kpi.Tooltip" @onclick="() => SetKpi(kpi.Key)">
                <span class="as-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="as-kpi-label">@kpi.Label</span>
                <strong>@kpi.Value</strong>
                <small>@kpi.Detail</small>
            </button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger as-load-error" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError
        </div>
    }

    <section class="as-command-bar">
        <div class="as-search-wrap">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input class="as-search" placeholder="Search sales analytics, owners, stages, producers, campaigns, or reports…" @bind="_search" @bind:event="oninput" />
        </div>
        <select class="as-select" @bind="_segmentFilter">
            <option value="">All segments</option>
            @foreach (var segment in Segments)
            {
                <option value="@segment">@segment</option>
            }
        </select>
        <select class="as-select" @bind="_priorityFilter">
            <option value="">All priorities</option>
            <option value="Critical">Critical</option>
            <option value="High">High</option>
            <option value="Normal">Normal</option>
        </select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
        <button type="button" class="um-btn um-btn-ghost" @onclick="RunSalesReportsAsync" disabled="@(!_salesReports.Any() || _busy)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run Sales Reports</button>
    </section>

    <div class="as-tabs" role="tablist" aria-label="Sales analytics views">
        @foreach (var tab in _tabs)
        {
            <button type="button" role="tab" class="as-tab @(_activeTab == tab.Key ? "as-tab--active" : null)" @onclick="() => SetTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </div>

    @if (_loading)
    {
        <div class="as-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading sales analytics...</div>
    }
    else
    {
        <section class="as-grid">
            <article class="as-panel as-panel--main">
                <div class="as-panel-header"><i class="bi @ActiveIcon" aria-hidden="true"></i><div><strong>@ActiveListTitle</strong><span>@FilteredItemCount.ToString("N0") sales records sorted by revenue importance.</span></div></div>
                @if (!FilteredItems.Any())
                {
                    <div class="as-empty"><i class="bi bi-graph-up" aria-hidden="true"></i><strong>No sales records match this view</strong><span>Adjust filters or refresh seeded sales analytics.</span></div>
                }
                else
                {
                    <div class="as-item-list">
                        @foreach (var item in FilteredItems)
                        {
                            <button type="button" class="as-item-row @(_selectedItem?.Title == item.Title ? "as-item-row--active" : null)" @onclick="() => SelectSalesItem(item)">
                                <span class="as-module-icon as-module-icon--@CategoryCss(item.Category)"><i class="bi @CategoryIcon(item.Category)" aria-hidden="true"></i></span>
                                <div class="as-item-main">
                                    <div class="as-item-title"><strong>@item.Title</strong><span class="as-badge as-badge--@CategoryCss(item.Category)">@item.Category</span><span class="as-badge as-badge--type">@item.Stage</span></div>
                                    <p>@item.Insight</p>
                                    <div class="as-item-meta"><span>@item.Owner</span><span>@item.Segment</span><span>@item.Count.ToString("N0") records</span><span>@item.ConversionPct.ToString("N1")% conversion</span><span>due @FormatDate(item.DueDateUtc)</span></div>
                                </div>
                                <span class="as-row-score">@ItemScore(item)</span>
                            </button>
                        }
                    </div>
                }
            </article>

            <aside class="as-side">
                @if (_selectedItem is null)
                {
                    <div class="as-panel"><div class="as-empty as-empty--side"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a sales priority</strong><span>Choose a pipeline, risk, play, or producer action to inspect next steps and reporting workflow.</span></div></div>
                }
                else
                {
                    <article class="as-panel">
                        <div class="as-panel-header"><i class="bi @CategoryIcon(_selectedItem.Category)" aria-hidden="true"></i><div><strong>Sales command</strong><span>@_selectedItem.Priority · @_selectedItem.Status</span></div></div>
                        <div class="as-detail">
                            <div class="as-detail-head">
                                <span class="as-module-icon as-module-icon--@CategoryCss(_selectedItem.Category)"><i class="bi @CategoryIcon(_selectedItem.Category)" aria-hidden="true"></i></span>
                                <div><strong>@_selectedItem.Title</strong><span>@_selectedItem.Insight</span></div>
                            </div>
                            <dl>
                                <dt>Pipeline value</dt><dd>@FormatCurrency(_selectedItem.Amount)</dd>
                                <dt>Owner</dt><dd>@_selectedItem.Owner</dd>
                                <dt>Segment</dt><dd>@_selectedItem.Segment</dd>
                                <dt>Stage</dt><dd>@_selectedItem.Stage</dd>
                                <dt>Conversion</dt><dd>@_selectedItem.ConversionPct.ToString("N1")%</dd>
                                <dt>Trend</dt><dd class="@TrendCss(_selectedItem.TrendPct)">@FormatSigned(_selectedItem.TrendPct)%</dd>
                                <dt>Next action</dt><dd>@_selectedItem.NextAction</dd>
                            </dl>
                            <div class="as-detail-actions">
                                <button type="button" class="um-btn um-btn-ghost" @onclick="FocusSalesReport" disabled="@(_selectedReport is null)"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i> Focus Report</button>
                                <button type="button" class="um-btn um-btn-ghost" @onclick="RunSelectedReportAsync" disabled="@(_selectedReport is null || _busy)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run</button>
                                <button type="button" class="um-btn um-btn-ghost" @onclick="OpenScheduleForSelected" disabled="@(_selectedReport is null || _busy)"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Schedule</button>
                                <button type="button" class="um-btn um-btn-primary" @onclick="ExportSelectedReportAsync" disabled="@(_selectedReport is null || _busy)"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
                            </div>
                        </div>
                    </article>
                }

                <article class="as-panel">
                    <div class="as-panel-header"><i class="bi bi-people" aria-hidden="true"></i><div><strong>Producer leaderboard</strong><span>Goal and premium contribution.</span></div></div>
                    <div class="as-leader-list">
                        @foreach (var producer in ProducersByImportance.Take(5))
                        {
                            <div class="as-leader-row">
                                <div><strong>@producer.ProducerName</strong><span>@producer.Branch · @producer.Lob</span></div>
                                <div class="as-leader-metrics"><strong>@FormatCurrency(producer.WrittenPremium)</strong><span class="@(producer.GoalPct >= 100 ? "as-positive" : "as-negative")">@producer.GoalPct.ToString("N0")% goal</span></div>
                            </div>
                        }
                    </div>
                </article>

                <article class="as-panel">
                    <div class="as-panel-header"><i class="bi bi-megaphone" aria-hidden="true"></i><div><strong>Campaign conversion</strong><span>Lead-to-bind production impact.</span></div></div>
                    <div class="as-campaign-list">
                        @foreach (var campaign in CampaignsByImportance.Take(4))
                        {
                            <div class="as-campaign-row">
                                <div><strong>@campaign.Name</strong><span>@campaign.Leads.ToString("N0") leads · @campaign.Quoted.ToString("N0") quoted · @campaign.Bound.ToString("N0") bound</span></div>
                                <div class="as-progress"><div style="width:@Math.Clamp(campaign.ConversionPct, 0, 100)%"></div></div>
                                <strong>@campaign.ConversionPct.ToString("N1")%</strong>
                            </div>
                        }
                    </div>
                </article>
            </aside>
        </section>

        <section class="as-lower-grid">
            <article class="as-panel">
                <div class="as-panel-header"><i class="bi bi-bar-chart" aria-hidden="true"></i><div><strong>New business trend</strong><span>Monthly new business versus renewals.</span></div></div>
                <div class="as-trend-grid">
                    @foreach (var point in NewBusinessTrend)
                    {
                        <div class="as-trend-col">
                            <div class="as-trend-bar-wrap"><div class="as-trend-bar as-trend-bar--new" style="height:@TrendHeight(point.NewBiz)%"></div></div>
                            <div class="as-trend-bar-wrap"><div class="as-trend-bar as-trend-bar--renewal" style="height:@TrendHeight(point.Renewal)%"></div></div>
                            <span>@point.Label</span>
                        </div>
                    }
                </div>
            </article>

            <article class="as-panel">
                <div class="as-panel-header"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i><div><strong>Sales report workflow</strong><span>Preview, run, export, and scheduled delivery.</span></div></div>
                <div class="as-report-list">
                    @foreach (var report in SalesReportsByImportance.Take(5))
                    {
                        <button type="button" class="as-report-row @(_selectedReport?.ReportDefinitionId == report.ReportDefinitionId ? "as-report-row--active" : null)" @onclick="() => SelectReport(report)">
                            <div><strong>@report.ReportName</strong><span>@report.ReportTypeCode · @report.OutputFormats · @LastRunLabel(report.ReportDefinitionId)</span></div>
                            <span>@ReportScore(report)</span>
                        </button>
                    }
                    @if (!_salesReports.Any())
                    {
                        <div class="as-empty as-empty--compact"><i class="bi bi-file-earmark-x" aria-hidden="true"></i><strong>No Sales module reports found</strong><span>Sales analytics still uses seeded pipeline and executive dashboard data.</span></div>
                    }
                </div>
            </article>
        </section>
    }
</div>

@if (_showSchedule)
{
    <div class="as-modal-backdrop" role="presentation" @onclick="CloseSchedule">
        <div class="as-modal" role="dialog" aria-modal="true" aria-label="Schedule sales report" @onclick:stopPropagation="true">
            <EditForm EditContext="_scheduleEditContext" OnValidSubmit="ScheduleAsync">
                <DataAnnotationsValidator />
                <div class="as-modal-header">
                    <i class="bi bi-calendar-plus" aria-hidden="true"></i>
                    <span>Schedule sales report</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseSchedule"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="as-modal-body">
                    @if (!string.IsNullOrWhiteSpace(_formError))
                    {
                        <div class="alert alert-danger as-load-error" role="alert">@_formError</div>
                    }
                    <div class="as-form-grid">
                        <label>Report
                            <select class="as-input" @bind="_scheduleForm.ReportDefinitionId">
                                @foreach (var report in SalesReportsByImportance)
                                {
                                    <option value="@report.ReportDefinitionId">@report.ReportName</option>
                                }
                            </select>
                            <ValidationMessage For="() => _scheduleForm.ReportDefinitionId" class="text-danger" />
                        </label>
                        <label>Frequency
                            <select class="as-input" @bind="_scheduleForm.FrequencyCode">
                                @foreach (var frequency in _frequencyOptions)
                                {
                                    <option value="@frequency">@frequency</option>
                                }
                            </select>
                            <ValidationMessage For="() => _scheduleForm.FrequencyCode" class="text-danger" />
                        </label>
                        <label>Output format
                            <select class="as-input" @bind="_scheduleForm.OutputFormat">
                                @foreach (var format in _formatOptions)
                                {
                                    <option value="@format">@format</option>
                                }
                            </select>
                            <ValidationMessage For="() => _scheduleForm.OutputFormat" class="text-danger" />
                        </label>
                        <label>Delivery email
                            <input class="as-input" @bind="_scheduleForm.DeliveryEmail" />
                            <ValidationMessage For="() => _scheduleForm.DeliveryEmail" class="text-danger" />
                        </label>
                    </div>
                </div>
                <div class="as-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseSchedule">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi bi-check2" aria-hidden="true"></i> Schedule</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private readonly TabItem[] _tabs =
    [
        new("all", "Command", "bi-speedometer2"),
        new("pipeline", "Pipeline", "bi-funnel"),
        new("risk", "Risks", "bi-exclamation-triangle"),
        new("producer", "Producers", "bi-person-badge"),
        new("play", "Sales Plays", "bi-lightning-charge"),
        new("reports", "Reports", "bi-file-earmark-bar-graph")
    ];

    private readonly string[] _frequencyOptions = ["Daily", "Weekly", "Monthly", "Quarterly"];
    private readonly string[] _formatOptions = ["PDF", "Excel", "CSV"];

    private Guid _tenantId;
    private Guid? _currentUserId;
    private bool _loading;
    private bool _saving;
    private bool _showSchedule;
    private string _search = string.Empty;
    private string _activeKpi = "all";
    private string _activeTab = "all";
    private string _segmentFilter = string.Empty;
    private string _priorityFilter = string.Empty;
    private string? _loadError;
    private string? _formError;
    private string? _toastMessage;
    private string _toastClass = "as-toast--success";
    private ExecutiveDashboardPageDto _dashboard = new();
    private List<SalesAnalyticsRecord> _salesItems = [];
    private List<ReportDefinitionDto> _salesReports = [];
    private List<ReportExecutionDto> _executions = [];
    private List<ReportScheduleDto> _schedules = [];
    private SalesAnalyticsRecord? _selectedItem;
    private ReportDefinitionDto? _selectedReport;
    private ScheduleForm _scheduleForm = new();
    private EditContext _scheduleEditContext = default!;
    private bool _busy => _loading || _saving;

    private decimal NewBusinessPremium => _dashboard.Kpi.NewBusinessPremium;
    private decimal PipelineAmount => _salesItems.Where(i => i.Category is "Pipeline" or "Risk" or "Play").Sum(i => i.Amount);
    private int TotalPipelineCount => _salesItems.Where(i => i.Category is "Pipeline" or "Risk" or "Play").Sum(i => i.Count);
    private double AverageConversion => _salesItems.Count == 0 ? 0 : _salesItems.Average(i => i.ConversionPct);
    private string TopProducerName => ProducersByImportance.FirstOrDefault()?.ProducerName ?? "No producer data";
    private int CriticalCount => _salesItems.Count(i => i.Priority == "Critical");
    private int RiskCount => _salesItems.Count(i => i.Category == "Risk" || i.Status is "At Risk" or "Escalate");
    private int ActiveReportCount => _salesReports.Count;
    private int ScheduledReportCount => _salesReports.Count(r => IsScheduled(r.ReportDefinitionId));
    private int SalesReadinessScore => Math.Clamp(68 + Math.Min(12, _salesItems.Count * 2) + Math.Min(10, ScheduledReportCount * 4) + Math.Min(10, _executions.Count(e => _salesReports.Any(r => r.ReportDefinitionId == e.ReportDefinitionId))), 0, 100);
    private string SalesReadinessSummary => SalesReadinessScore >= 90 ? "Sales workflow is executive ready" : SalesReadinessScore >= 80 ? "Pipeline command is healthy with follow-up opportunities" : "Run and schedule sales reports to improve readiness";
    private IEnumerable<string> Segments => _salesItems.Select(i => i.Segment).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s);
    private IEnumerable<SalesAnalyticsRecord> PriorityItems => _salesItems.OrderByDescending(ItemScore).ThenBy(i => i.DueDateUtc).Take(4);
    private IEnumerable<DashboardProducerRowDto> ProducersByImportance => _dashboard.Producers.OrderByDescending(p => p.GoalPct >= 100).ThenByDescending(p => p.WrittenPremium);
    private IEnumerable<DashboardCampaignRowDto> CampaignsByImportance => _dashboard.Campaigns.OrderByDescending(c => c.Premium).ThenByDescending(c => c.ConversionPct);
    private IEnumerable<DashboardNewBusinessPointDto> NewBusinessTrend => _dashboard.NewBusinessTrend;
    private IEnumerable<ReportDefinitionDto> SalesReportsByImportance => _salesReports.OrderByDescending(ReportScore).ThenBy(r => r.ReportName);
    private IEnumerable<SalesAnalyticsRecord> FilteredItems => _salesItems
        .Where(MatchesSearch)
        .Where(i => string.IsNullOrWhiteSpace(_segmentFilter) || i.Segment == _segmentFilter)
        .Where(i => string.IsNullOrWhiteSpace(_priorityFilter) || i.Priority == _priorityFilter)
        .Where(MatchesActiveView)
        .OrderByDescending(ItemScore)
        .ThenBy(i => i.DueDateUtc)
        .ToList();
    private int FilteredItemCount => FilteredItems.Count();

    private IEnumerable<KpiItem> Kpis =>
    [
        new("all", "Pipeline", "bi-cash-stack", FormatCurrency(PipelineAmount), $"{TotalPipelineCount:N0} active records", "Show all sales command records"),
        new("pipeline", "New Business", "bi-graph-up-arrow", FormatCurrency(NewBusinessPremium), $"{_dashboard.Kpi.NewBusinessDelta:N1}% delta", "Filter new business and pipeline priorities"),
        new("risk", "Risks", "bi-exclamation-triangle", RiskCount.ToString("N0"), "need escalation", "Filter stalled or at-risk sales records"),
        new("producer", "Producers", "bi-person-badge", _dashboard.Producers.Count.ToString("N0"), "goal scorecards", "Show producer performance priorities"),
        new("play", "Sales Plays", "bi-lightning-charge", _salesItems.Count(i => i.Category == "Play").ToString("N0"), "ready motions", "Filter cross-sell and campaign plays"),
        new("reports", "Reports", "bi-file-earmark-bar-graph", ActiveReportCount.ToString("N0"), $"{ScheduledReportCount:N0} scheduled", "Filter Sales module reports")
    ];

    private string ActiveListTitle => _activeTab switch
    {
        "pipeline" => "Pipeline and new business priorities",
        "risk" => "Revenue risks requiring escalation",
        "producer" => "Producer coaching and goal priorities",
        "play" => "Sales plays ready for execution",
        "reports" => "Sales reporting workflow",
        _ => "Enterprise sales command queue"
    };

    private string ActiveIcon => _activeTab switch
    {
        "pipeline" => "bi-funnel",
        "risk" => "bi-exclamation-triangle",
        "producer" => "bi-person-badge",
        "play" => "bi-lightning-charge",
        "reports" => "bi-file-earmark-bar-graph",
        _ => "bi-speedometer2"
    };

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _currentUserId = context.UserId;
        _scheduleEditContext = new(_scheduleForm);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var dashboard = await Api.GetExecutiveDashboardPageAsync(_tenantId);
            var records = await Api.SearchDashboardRecordsAsync(_tenantId, "SalesAnalytics", _search);
            var definitions = await Api.SearchReportDefinitionsAsync("Sales");
            var executions = await Api.SearchReportExecutionsAsync(_tenantId, null);
            var schedules = await Api.SearchReportSchedulesAsync(_tenantId, "Sales");

            _dashboard = dashboard ?? new();
            _salesItems = records?.Items.Select(r => DeserializeSalesRecord(r.Id, r.JsonData)).Where(r => r is not null).Cast<SalesAnalyticsRecord>().ToList() ?? [];
            _salesReports = definitions?.Items.Where(r => r.ModuleCode == "Sales").ToList() ?? [];
            _executions = executions?.Items.Where(e => _salesReports.Any(r => r.ReportDefinitionId == e.ReportDefinitionId)).ToList() ?? [];
            _schedules = schedules?.Items.Where(s => _salesReports.Any(r => r.ReportDefinitionId == s.ReportDefinitionId)).ToList() ?? [];
            _selectedItem = _selectedItem is null ? FilteredItems.FirstOrDefault() : _salesItems.FirstOrDefault(i => i.Title == _selectedItem.Title) ?? FilteredItems.FirstOrDefault();
            _selectedReport = _selectedReport is null ? SalesReportsByImportance.FirstOrDefault() : _salesReports.FirstOrDefault(r => r.ReportDefinitionId == _selectedReport.ReportDefinitionId) ?? SalesReportsByImportance.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load sales analytics: {ex.Message}";
            _salesItems = [];
            _salesReports = [];
            _executions = [];
            _schedules = [];
            ShowToast(_loadError, true);
        }
        finally
        {
            _loading = false;
        }
    }

    private static SalesAnalyticsRecord? DeserializeSalesRecord(Guid id, string json)
    {
        try
        {
            var item = System.Text.Json.JsonSerializer.Deserialize<SalesAnalyticsRecord>(json, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
            if (item is not null) item.Id = id;
            return item;
        }
        catch
        {
            return null;
        }
    }

    private bool MatchesSearch(SalesAnalyticsRecord item)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || item.Category.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || item.Segment.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || item.Stage.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || item.Status.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || item.Insight.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || _dashboard.Producers.Any(p => p.ProducerName.Contains(_search, StringComparison.OrdinalIgnoreCase) || p.Branch.Contains(_search, StringComparison.OrdinalIgnoreCase))
            || _dashboard.Campaigns.Any(c => c.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
            || _salesReports.Any(r => r.ReportName.Contains(_search, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesActiveView(SalesAnalyticsRecord item) => _activeTab switch
    {
        "pipeline" => item.Category == "Pipeline",
        "risk" => item.Category == "Risk" || item.Status is "At Risk" or "Escalate",
        "producer" => item.Category == "Producer",
        "play" => item.Category == "Play",
        "reports" => _salesReports.Any(),
        _ => true
    };

    private void SetKpi(string key)
    {
        _activeKpi = key;
        _activeTab = key;
    }

    private void SetTab(string key)
    {
        _activeTab = key;
        _activeKpi = key;
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _segmentFilter = string.Empty;
        _priorityFilter = string.Empty;
        _activeKpi = "all";
        _activeTab = "all";
    }

    private bool IsActiveKpi(string key) => _activeKpi == key;
    private void SelectSalesItem(SalesAnalyticsRecord item) => _selectedItem = item;
    private void SelectReport(ReportDefinitionDto report) => _selectedReport = report;
    private void FocusSalesReport()
    {
        if (_selectedReport is null) return;
        _activeTab = "reports";
        _activeKpi = "reports";
        ShowToast($"Focused report workflow: {_selectedReport.ReportName}");
    }

    private int TabCount(string key) => key switch
    {
        "pipeline" => _salesItems.Count(i => i.Category == "Pipeline"),
        "risk" => RiskCount,
        "producer" => _dashboard.Producers.Count,
        "play" => _salesItems.Count(i => i.Category == "Play"),
        "reports" => _salesReports.Count,
        _ => _salesItems.Count
    };

    private async Task RunSelectedReportAsync()
    {
        if (_selectedReport is not null)
        {
            await RunReportAsync(_selectedReport);
        }
    }

    private async Task ExportSelectedReportAsync()
    {
        if (_selectedReport is not null)
        {
            await ExportReportAsync(_selectedReport);
        }
    }

    private async Task RunSalesReportsAsync()
    {
        var candidates = SalesReportsByImportance.Take(2).ToList();
        foreach (var report in candidates)
        {
            await RunReportAsync(report);
        }
        if (candidates.Count > 0)
        {
            ShowToast($"Sales report run completed for {candidates.Count} report(s).");
        }
    }

    private async Task RunReportAsync(ReportDefinitionDto report)
    {
        _saving = true;
        try
        {
            await Api.RunReportAsync(report.ReportDefinitionId, new RunReportRequest(_tenantId, PreferredFormat(report), _currentUserId));
            ShowToast($"Sales report run completed: {report.ReportName}");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Run failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ExportReportAsync(ReportDefinitionDto report)
    {
        _saving = true;
        try
        {
            var file = await Api.DownloadReportExcelAsync(report.ReportDefinitionId, _tenantId);
            await DownloadFileAsync(file);
            ShowToast($"Sales export downloaded: {report.ReportName}");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Export failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ExportSalesViewAsync()
    {
        _saving = true;
        try
        {
            var file = await Api.DownloadReportsExcelAsync(new DownloadReportsRequest
            {
                TenantId = _tenantId,
                ReportDefinitionIds = _salesReports.Select(r => r.ReportDefinitionId).ToList(),
                SearchTerm = _search,
                ModuleCode = "Sales",
                Format = "Excel"
            });
            await DownloadFileAsync(file);
            ShowToast($"Sales analytics pack downloaded for {_salesReports.Count} report(s).");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Export sales pack failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private void OpenScheduleForSelected()
    {
        if (_selectedReport is not null)
        {
            OpenSchedule(_selectedReport);
        }
    }

    private void OpenSchedule(ReportDefinitionDto report)
    {
        _scheduleForm = new ScheduleForm
        {
            ReportDefinitionId = report.ReportDefinitionId,
            OutputFormat = PreferredFormat(report),
            FrequencyCode = "Weekly",
            DeliveryEmail = "sales-ops@agencybinder.local"
        };
        _scheduleEditContext = new(_scheduleForm);
        _formError = null;
        _showSchedule = true;
    }

    private void CloseSchedule()
    {
        _showSchedule = false;
        _formError = null;
    }

    private async Task ScheduleAsync()
    {
        _formError = null;
        if (!_scheduleEditContext.Validate()) return;
        _saving = true;
        try
        {
            await Api.ScheduleReportAsync(new ScheduleReportRequest(_tenantId, _scheduleForm.ReportDefinitionId, _scheduleForm.FrequencyCode, _scheduleForm.OutputFormat, _scheduleForm.DeliveryEmail));
            _showSchedule = false;
            ShowToast($"Sales report scheduled for {_scheduleForm.DeliveryEmail}.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = $"Schedule failed: {ex.Message}";
            ShowToast($"Schedule failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DownloadFileAsync(ReportDownloadFile file)
    {
        var fileName = file.FileName.Replace("'", string.Empty).Replace("\"", string.Empty);
        var base64 = Convert.ToBase64String(file.Content);
        var script = $"(() => {{ const a = document.createElement(\"a\"); a.href = \"data:application/vnd.ms-excel;base64,{base64}\"; a.download = \"{fileName}\"; document.body.appendChild(a); a.click(); a.remove(); }})()";
        await Js.InvokeVoidAsync("eval", script);
    }

    private void ShowToast(string message, bool danger = false)
    {
        _toastMessage = message;
        _toastClass = danger ? "as-toast--danger" : "as-toast--success";
    }

    private void ClearToast() => _toastMessage = null;

    private bool IsScheduled(Guid reportDefinitionId) => _schedules.Any(s => s.ReportDefinitionId == reportDefinitionId && s.IsActive);
    private static bool IsExportable(ReportDefinitionDto report) => report.OutputFormats.Contains("Excel", StringComparison.OrdinalIgnoreCase) || report.OutputFormats.Contains("CSV", StringComparison.OrdinalIgnoreCase);
    private static string PreferredFormat(ReportDefinitionDto report) => report.OutputFormats.Contains("Excel", StringComparison.OrdinalIgnoreCase) ? "Excel" : report.OutputFormats.Contains("CSV", StringComparison.OrdinalIgnoreCase) ? "CSV" : "PDF";

    private int ReportScore(ReportDefinitionDto report)
    {
        var score = 35;
        if (report.ReportTypeCode == "Analytics") score += 20;
        if (report.ReportTypeCode == "Detail") score += 12;
        if (IsScheduled(report.ReportDefinitionId)) score += 18;
        if (_executions.Any(e => e.ReportDefinitionId == report.ReportDefinitionId)) score += 16;
        if (IsExportable(report)) score += 8;
        return Math.Clamp(score, 0, 100);
    }

    private int ItemScore(SalesAnalyticsRecord item)
    {
        var score = item.Priority switch { "Critical" => 40, "High" => 28, "Normal" => 16, _ => 10 };
        score += item.Category switch { "Risk" => 18, "Pipeline" => 16, "Play" => 12, "Producer" => 10, _ => 6 };
        score += Math.Min(24, (int)(item.Amount / 30000m));
        if (item.DueDateUtc <= DateTime.UtcNow.AddDays(7)) score += 12;
        return Math.Clamp(score, 0, 100);
    }

    private string LastRunLabel(Guid reportDefinitionId)
        => _executions.Where(e => e.ReportDefinitionId == reportDefinitionId).OrderByDescending(e => e.CreatedDateUtc).FirstOrDefault() is { } execution
            ? $"Run {FormatRelative(execution.CompletedDateUtc ?? execution.CreatedDateUtc)}"
            : "Never run";

    private static decimal MaxTrendValue(IEnumerable<DashboardNewBusinessPointDto> points)
        => points.SelectMany(p => new[] { p.NewBiz, p.Renewal }).DefaultIfEmpty(1).Max();

    private decimal TrendHeight(decimal value)
    {
        var max = MaxTrendValue(NewBusinessTrend);
        return max <= 0 ? 5 : Math.Clamp(value / max * 100m, 5m, 100m);
    }

    private static string FormatCurrency(decimal value) => value >= 1000000 ? $"${value / 1000000m:N1}M" : $"${value / 1000m:N0}K";
    private static string FormatDate(DateTime value) => value.ToLocalTime().ToString("MMM d");
    private static string FormatRelative(DateTime? utc)
    {
        if (utc is null || utc == default) return "never";
        var diff = DateTime.UtcNow - utc.Value.ToUniversalTime();
        if (diff.TotalMinutes < 60) return $"{Math.Max(1, (int)diff.TotalMinutes)}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }

    private static string FormatSigned(double value) => value >= 0 ? $"+{value:N1}" : value.ToString("N1");
    private static string TrendCss(double value) => value >= 0 ? "as-positive" : "as-negative";
    private static string PriorityCss(string value) => value.ToLowerInvariant();
    private static string CategoryCss(string value) => value switch { "Risk" => "red", "Play" => "amber", "Producer" => "purple", "Pipeline" => "blue", _ => "slate" };
    private static string CategoryIcon(string value) => value switch { "Risk" => "bi-exclamation-triangle", "Play" => "bi-lightning-charge", "Producer" => "bi-person-badge", "Pipeline" => "bi-funnel", _ => "bi-graph-up" };

    private sealed record TabItem(string Key, string Label, string Icon);
    private sealed record KpiItem(string Key, string Label, string Icon, string Value, string Detail, string Tooltip);

    private sealed class SalesAnalyticsRecord
    {
        public Guid Id { get; set; }
        public string Category { get; set; } = string.Empty;
        public string Priority { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Owner { get; set; } = string.Empty;
        public string Segment { get; set; } = string.Empty;
        public string Stage { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public int Count { get; set; }
        public double ConversionPct { get; set; }
        public double TrendPct { get; set; }
        public DateTime DueDateUtc { get; set; }
        public string NextAction { get; set; } = string.Empty;
        public string Insight { get; set; } = string.Empty;
    }

    private sealed class ScheduleForm
    {
        [Required] public Guid ReportDefinitionId { get; set; }
        [Required, StringLength(40)] public string FrequencyCode { get; set; } = "Weekly";
        [Required, StringLength(20)] public string OutputFormat { get; set; } = "Excel";
        [Required, EmailAddress, StringLength(254)] public string DeliveryEmail { get; set; } = "sales-ops@agencybinder.local";
    }
}
