@page "/payments"
@inject ApiClient Api

<PageTitle>Payments</PageTitle>
<h1>Payments &amp; Collections</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(PaymentDto.PaymentDate)"       HeaderText="Date"    Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(PaymentDto.Amount)"            HeaderText="Amount"  Width="130" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(PaymentDto.PaymentMethodCode)" HeaderText="Method"  Width="130"></GridColumn>
        <GridColumn Field="@nameof(PaymentDto.ReferenceNumber)"   HeaderText="Ref #"   Width="160"></GridColumn>
        <GridColumn Field="@nameof(PaymentDto.StatusCode)"        HeaderText="Status"  Width="120"></GridColumn>
        <GridColumn Field="@nameof(PaymentDto.Notes)"             HeaderText="Notes"   Width="280"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<PaymentDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchPaymentsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
