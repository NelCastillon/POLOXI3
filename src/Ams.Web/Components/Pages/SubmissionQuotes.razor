    IEnumerable<GroupSummary> CarrierRows
    {
        get
        {
            var groups = FilteredRows.GroupBy(r => Safe(r.Carrier, "Pending Market")).ToList();
            var max = Math.Max(1, groups.Max(g => g.Count()));
            return groups.Select(g => new GroupSummary(g.Key, g.Count(), g.Sum(x => x.QuotedPremium), g.Count(x => x.Status == "Accepted"), g.Count(x => DaysToExpire(x) is >= 0 and <= 7), Math.Max(8, (int)Math.Round(g.Count() * 100m / max))))
                .OrderByDescending(g => g.Premium);
        }
    }

    IEnumerable<GroupSummary> LobRows
    {
        get
        {
            var groups = FilteredRows.GroupBy(r => Safe(r.Lob, "Unknown")).ToList();
            var max = Math.Max(1, groups.Max(g => g.Count()));
            return groups.Select(g => new GroupSummary(g.Key, g.Count(), g.Sum(x => x.QuotedPremium), g.Count(x => x.Status == "Accepted"), g.Count(x => DaysToExpire(x) is >= 0 and <= 7), Math.Max(8, (int)Math.Round(g.Count() * 100m / max))))
                .OrderByDescending(g => g.Premium);
        }
    }

