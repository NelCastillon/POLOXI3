    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Submissions", "/submissions"), new("Quotes", "/submissions/quotes"));
        await Task.WhenAll(LoadReferenceDataAsync(), LoadAsync());
    }

    async Task LoadReferenceDataAsync()
    {
        var options = await Api.GetSubmissionReferenceOptionsAsync(_tenantId);
        var activeOptions = options?.Where(o => o.IsActive).ToList() ?? [];
        _quoteStatusOptions = ToOptions(activeOptions, "QuoteStatus");
        _lobOptions = ToOptions(activeOptions, "LineOfBusiness");
    }

    async Task LoadAsync()
    {
        _loading = true;
        _refreshIconClass = "qde-spin";
        _loadError = null;
        try
        {
            var quotes = await Api.GetSubmissionQuoteRegisterAsync(_tenantId) ?? [];
            _rows.Clear();
            _rows.AddRange(quotes.Select(q => new QuoteRow
            {
                QuoteId = q.QuoteId,
                QuoteNo = q.QuoteNumber,
                SubmissionNo = q.SubmissionNumber,
                SubId = q.SubmissionId,
                Account = q.AccountName,
                Lob = q.LineOfBusiness,
                CarrierId = q.CarrierId,
                SubmissionMarketId = q.SubmissionMarketId,
                Carrier = q.CarrierName,
                Status = NormalizeQuoteStatus(q.Status, q.ExpiresDateUtc),
                QuotedPremium = q.AnnualPremium,
                Deductible = q.Deductible,
                Limit = q.Limit,
                CoverageNotes = q.CoverageNotes,
                QuotedDateUtc = q.QuoteReceivedDateUtc ?? q.QuotedDateUtc,
                EffDate = q.EffectiveDate,
                ExpiryDate = q.ExpiresDateUtc,
                Producer = q.AssignedToUserName ?? "Unassigned",
                Lines = q.Lines
            }));

            _selected = _selected is null ? _rows.OrderByDescending(ImportanceScore).FirstOrDefault() : _rows.FirstOrDefault(r => r.QuoteId == _selected.QuoteId) ?? _rows.OrderByDescending(ImportanceScore).FirstOrDefault();
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load quotes: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "qde-toast--danger");
        }
        finally
        {
            _loading = false;
            _refreshIconClass = string.Empty;
        }
    }

    IEnumerable<QuoteRow> ApplyFilters(IEnumerable<QuoteRow> rows)
    {
        if (ShowBlockedReadinessOnly)
            rows = rows.Where(row => !row.IsProposalReady);
        rows = _activeKpi switch
        {
            "priority" => rows.Where(r => ImportanceLevel(r) is "Critical" or "High"),
            "pending" => rows.Where(r => r.Status == "Pending"),
            "accepted" => rows.Where(r => r.Status == "Accepted"),
            "expiring" => rows.Where(r => DaysToExpire(r) is >= 0 and <= 7),
            "premium" => rows.Where(r => r.QuotedPremium > 0),
            _ => rows
        };

        if (!string.IsNullOrWhiteSpace(_statusFilter))
            rows = rows.Where(r => string.Equals(r.Status, _statusFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_carrierFilter))
            rows = rows.Where(r => string.Equals(Safe(r.Carrier, "Pending Market"), _carrierFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_lobFilter))
            rows = rows.Where(r => string.Equals(Safe(r.Lob, "Unknown"), _lobFilter, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim();
            rows = rows.Where(r => Contains(r.QuoteNo, term)
                || Contains(r.SubmissionNo, term)
                || Contains(r.Account, term)
                || Contains(r.Lob, term)
                || Contains(r.Carrier, term)
                || Contains(r.Status, term)
                || Contains(r.Producer, term)
                || Contains(r.QuoteId.ToString(), term)
                || Contains(r.SubId.ToString(), term)
                || Contains(r.CarrierId.ToString(), term)
                || Contains(r.QuotedPremium.ToString("C0"), term)
                || Contains(r.QuotedPremium.ToString("0.##"), term)
                || Contains(r.Deductible?.ToString("C0"), term)
                || Contains(r.Deductible?.ToString("0.##"), term)
                || Contains(r.Limit?.ToString("C0"), term)
                || Contains(r.Limit?.ToString("0.##"), term)
                || Contains(r.EffDate.ToString("MM/dd/yyyy"), term)
                || Contains(r.EffDate.ToString("yyyy-MM-dd"), term)
                || Contains(r.ExpiryDate.ToString("MM/dd/yyyy"), term)
                || Contains(r.ExpiryDate.ToString("yyyy-MM-dd"), term)
                || Contains(r.QuotedDateUtc.ToString("MM/dd/yyyy"), term)
                || Contains(r.QuotedDateUtc.ToString("yyyy-MM-dd"), term)
                || Contains(r.CoverageNotes, term));
        }

        return rows;
    }

    IEnumerable<QuoteRow> SortRows(IEnumerable<QuoteRow> rows) => _sortMode switch
    {
        "expiration" => rows.OrderBy(r => r.ExpiryDate),
        "premium" => rows.OrderByDescending(r => r.QuotedPremium),
        "status" => rows.OrderBy(r => r.Status).ThenBy(r => r.ExpiryDate),
        "carrier" => rows.OrderBy(r => r.Carrier).ThenByDescending(ImportanceScore),
        _ => rows.OrderByDescending(ImportanceScore).ThenBy(r => r.ExpiryDate)
    };

    int ImportanceScore(QuoteRow row)
    {
        var score = 0;
        var days = DaysToExpire(row);
        score += row.Status switch
        {
            "Accepted" => 34,
            "Pending" => 26,
            "Expired" => 8,
            "Declined" => 6,
            _ => 12
        };
        score += days < 0 ? 4 : days <= 3 ? 30 : days <= 7 ? 22 : days <= 21 ? 12 : 5;
        score += row.QuotedPremium >= 100000 ? 24 : row.QuotedPremium >= 50000 ? 16 : row.QuotedPremium > 0 ? 8 : 0;
        score += (row.Limit ?? 0) >= 1000000 ? 6 : 0;
        score += string.IsNullOrWhiteSpace(row.Carrier) ? 5 : 0;
        return Math.Min(score, 100);
    }

    string ImportanceLevel(QuoteRow row) => ImportanceScore(row) switch
    {
        >= 78 => "Critical",
        >= 60 => "High",
        >= 40 => "Medium",
        _ => "Standard"
    };

    int DaysToExpire(QuoteRow row) => (row.ExpiryDate.Date - DateTime.Today).Days;

