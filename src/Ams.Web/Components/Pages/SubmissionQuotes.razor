        v == 0 ? @<span class="sq-prem-none">—</span> : @<span class="sq-prem">@v.ToString("C0")</span>;

    RenderFragment ExpiryCell(DateTime d)
    {
        var days = (d - DateTime.Today).TotalDays;
        var css = days < 0 ? "sq-exp-late" : days <= 7 ? "sq-exp-soon" : string.Empty;
        return @<span class="@css">@d.ToString("MM/dd/yyyy")</span>;
    }

    RenderFragment CtxBtn(QuoteRow row) =>
        @<div class="um-action-menu-wrap sq-action-menu-wrap" @onclick:stopPropagation="true">
            <button type="button"
                    class="um-btn um-btn-ghost um-btn-xs sq-ctx-btn"
                    aria-haspopup="menu"
                    aria-expanded="@(_openActionMenuFor == row.QuoteId)"
                    title="Quote actions"
                    @onclick="() => ToggleActionMenu(row)">
                <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
            </button>
            @if (_openActionMenuFor == row.QuoteId)
            {
                <div class="sq-action-menu" role="menu" aria-label="Quote actions">
                    <div class="sq-action-menu-summary">
                        <strong>@row.QuoteNo</strong>
                        <span>@row.Carrier</span>
                    </div>
                    @foreach (var item in _actionItems)
                    {
                        <button type="button"
                                class="um-action-menu-item @(item.Text == "Decline Quote" ? "um-action-menu-item--danger" : null)"
                                role="menuitem"
                                @onclick="() => HandleActionAsync(item.Text)">
                            <i class="@item.IconCss" aria-hidden="true"></i>
                            <span>@item.Text</span>
                        </button>
                    }
                </div>
            }
        </div>;

    void ToggleActionMenu(QuoteRow row)
    {
        _selected = row;
        _openActionMenuFor = _openActionMenuFor == row.QuoteId ? null : row.QuoteId;
    }

    RenderFragment KpiCard(string icon, string label, string val, string css, string? filterKey)
    {
        var isActive = _kpiFilter == filterKey;
        var cardClass = $"sq-kpi-card {css} {(isActive ? "sq-kpi-active" : string.Empty)}";
        var title = filterKey is null ? "Show all" : isActive ? "Clear filter" : $"Filter by {label}";
        return @<button type="button"
                        class="@cardClass"
                        @onclick="() => ToggleKpiFilter(filterKey)"
                        title="@title">
            <div class="sq-kpi-val">@val</div>
            <div class="sq-kpi-lbl"><i class="bi @icon" aria-hidden="true"></i> @label</div>
        </button>;
    }

    static string Initials(string value)
    {
        var words = value.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (words.Length == 0) return "Q";
        if (words.Length == 1) return words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant();
        return string.Concat(words.Take(2).Select(w => char.ToUpperInvariant(w[0])));
    }

    sealed class QuoteActionForm : IValidatableObject
    {
        [Range(0, 999999999999)] public decimal? AnnualPremium { get; set; }
        public DateTime? EffectiveDate { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
        string _action = string.Empty;

        public void Reset(QuoteRow row, string action)
        {
            _action = action;
            AnnualPremium = row.QuotedPremium > 0 ? row.QuotedPremium : null;
            EffectiveDate = row.EffDate == default ? DateTime.Today.AddDays(30) : row.EffDate;
            Notes = action == "Request Revision" ? "Please revise terms and confirm updated premium." : string.Empty;
        }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (_action is "Accept Quote" or "Request Revision" or "Bind" or "Download PDF")
            {
                if (AnnualPremium is null or <= 0)
                    yield return new ValidationResult("Annual premium is required and must be greater than zero.", [nameof(AnnualPremium)]);
            }
            if (_action is "Accept Quote" or "Bind" or "Download PDF")
            {
                if (EffectiveDate is null)
                    yield return new ValidationResult("Effective date is required.", [nameof(EffectiveDate)]);
            }
            if (_action == "Request Revision" && string.IsNullOrWhiteSpace(Notes))
                yield return new ValidationResult("Revision instructions are required.", [nameof(Notes)]);
        }
    }
}
