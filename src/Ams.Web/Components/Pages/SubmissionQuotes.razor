@page "/submissions/quotes"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Submissions
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject CurrentUserContext CurrentUser

<PageTitle>Quote Command Center - AMS</PageTitle>

<div class="qde-page">
    <section class="qde-hero">
        <div class="qde-hero__content">
            <div class="qde-hero__eyebrow"><i class="bi bi-file-earmark-check" aria-hidden="true"></i> Enterprise quote command center</div>
            <h1>Quote Comparison Center</h1>
            <p>Compare market terms, prioritize expiring quotes, generate proposal packages, and convert winning quotes into bound policies.</p>
            <div class="qde-hero__meta">
                <span><i class="bi bi-stack" aria-hidden="true"></i>@_rows.Count quote options</span>
                <span><i class="bi bi-exclamation-diamond" aria-hidden="true"></i>@CriticalRows.Count() priority</span>
                <span><i class="bi bi-cash-stack" aria-hidden="true"></i>@QuotedPremium.ToString("C0") quoted premium</span>
                <span><i class="bi bi-building" aria-hidden="true"></i>@CarrierCount carriers</span>
            </div>
        </div>
        <div class="qde-hero__actions">
            <button type="button" class="qde-btn qde-btn--light" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @_refreshIconClass" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="qde-btn qde-btn--primary" @onclick='() => Nav.NavigateTo("/submissions/new")'>
                <i class="bi bi-plus-lg" aria-hidden="true"></i> New Submission
            </button>
            <button type="button" class="qde-btn qde-btn--light" @onclick='() => Nav.NavigateTo("/submissions")'>
                <i class="bi bi-send" aria-hidden="true"></i> Submissions
            </button>
            <button type="button" class="qde-btn qde-btn--light" @onclick='() => Nav.NavigateTo("/submissions/applications")'>
                <i class="bi bi-clipboard-check" aria-hidden="true"></i> Applications
            </button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger qde-alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="quote-kpi-strip" aria-label="Quote KPIs">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" title="@metric.Tooltip" @onclick="() => SetKpi(metric.Filter)">
                <span class="quote-kpi__icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span class="quote-kpi__body">
                    <span class="quote-kpi__val">@metric.Value</span>
                    <span class="quote-kpi__lbl">@metric.Label</span>
                    <small>@metric.Caption</small>
                </span>
            </button>
        }
    </section>

    <section class="qde-workflows" aria-label="Quote workflows">
        <button type="button" class="qde-workflow" @onclick="ShowPriorityQueue">
            <i class="bi bi-lightning-charge" aria-hidden="true"></i>
            <span><strong>Priority queue</strong><small>Open highest-importance quote work</small></span>
        </button>
        <button type="button" class="qde-workflow" @onclick="ShowExpiringQuotes">
            <i class="bi bi-clock-history" aria-hidden="true"></i>
            <span><strong>Expiring quotes</strong><small>Review options nearing expiration</small></span>
        </button>
        <button type="button" class="qde-workflow" @onclick="ShowBindQueue">
            <i class="bi bi-shield-plus" aria-hidden="true"></i>
            <span><strong>Bind queue</strong><small>Convert accepted quote options</small></span>
        </button>
        <button type="button" class="qde-workflow" @onclick="ShowCarrierView">
            <i class="bi bi-building" aria-hidden="true"></i>
            <span><strong>Carrier view</strong><small>Analyze quote options by market</small></span>
        </button>
        <button type="button" class="qde-workflow" @onclick="ShowLobView">
            <i class="bi bi-layers" aria-hidden="true"></i>
            <span><strong>LOB view</strong><small>Review quote quality by line</small></span>
        </button>
    </section>

    <section class="qde-search-row" aria-label="Quote filters">
        <div class="qde-search-wrap">
            <span class="qde-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="qde-search-body">
                <input class="qde-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search quote #, submission, account, LOB, carrier, status, producer, premium, deductible, limits..." aria-label="Search quotes" />
            </div>
        </div>
        <div class="qde-filter-grid">
            <label>
                <span>Status</span>
                <select class="form-select" @bind="StatusFilter">
                    <option value="">All statuses</option>
                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </label>
            <label>
                <span>Carrier</span>
                <select class="form-select" @bind="CarrierFilter">
                    <option value="">All carriers</option>
                    @foreach (var carrier in CarrierOptions)
                    {
                        <option value="@carrier">@carrier</option>
                    }
                </select>
            </label>
            <label>
                <span>Line of Business</span>
                <select class="form-select" @bind="LobFilter">
                    <option value="">All lines</option>
                    @foreach (var lob in LobOptions)
                    {
                        <option value="@lob">@lob</option>
                    }
                </select>
            </label>
            <label>
                <span>Sort</span>
                <select class="form-select" @bind="SortMode">
                    <option value="importance">Importance</option>
                    <option value="expiration">Expiration</option>
                    <option value="premium">Premium</option>
                    <option value="status">Status</option>
                    <option value="carrier">Carrier</option>
                </select>
            </label>
        </div>
    </section>

    <nav class="qde-tabs" aria-label="Quote views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="@TabClass(tab.Key)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </nav>

    <main class="qde-dashboard">
        <section class="qde-main-card">
            <div class="qde-card-header">
                <div>
                    <span class="qde-section-kicker">@ActiveViewTitle</span>
                    <h2>@FilteredRows.Count() quote options</h2>
                    <p>Ranked by enterprise importance: expiration risk, premium value, quote status, market competitiveness, and bind readiness.</p>
                </div>
                <div class="qde-card-actions">
                    <button type="button" class="qde-btn qde-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i> Previous
                    </button>
                    <span class="qde-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="qde-btn qde-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">
                        Next <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="qde-loading"><span class="qde-spinner"></span> Loading quotes...</div>
            }
            else if (!FilteredRows.Any())
            {
                <div class="qde-empty">
                    <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                    <strong>No quotes found</strong>
                    <span>Adjust filters or request a quote from an active submission.</span>
                </div>
            }
            else if (_activeTab == "carrier")
            {
                <div class="qde-carrier-grid">
                    @foreach (var group in CarrierRows)
                    {
                        <article class="qde-carrier-card">
                            <div class="qde-carrier-card__head">
                                <div>
                                    <span>Carrier market</span>
                                    <h3>@group.Name</h3>
                                </div>
                                <strong>@group.Count</strong>
                            </div>
                            <p>@group.Premium.ToString("C0") quoted premium - @group.Accepted accepted - @group.Expiring expiring</p>
                            <div class="qde-mini-bar"><span style="width:@group.Percent%"></span></div>
                            <button type="button" class="qde-btn qde-btn--ghost" @onclick="() => FilterByCarrier(group.Name)">View carrier</button>
                        </article>
                    }
                </div>
            }
            else if (_activeTab == "lob")
            {
                <div class="qde-lob-grid">
                    @foreach (var group in LobRows)
                    {
                        <article class="qde-lob-card">
                            <div class="qde-lob-icon"><i class="bi bi-layers" aria-hidden="true"></i></div>
                            <div>
                                <h3>@group.Name</h3>
                                <p>@group.Count quotes - @group.Premium.ToString("C0") premium - @group.Accepted accepted</p>
                                <div class="qde-mini-bar"><span style="width:@group.Percent%"></span></div>
                            </div>
                            <button type="button" class="qde-btn qde-btn--ghost" @onclick="() => FilterByLob(group.Name)">Open</button>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="qde-table-wrap">
                    <table class="qde-table">
                        <thead>
                            <tr>
                                <th>Importance</th>
                                <th>Quote</th>
                                <th>Submission</th>
                                <th>Account</th>
                                <th>LOB</th>
                                <th>Carrier</th>
                                <th>Status</th>
                                <th>Premium</th>
                                <th>Deductible</th>
                                <th>Limit</th>
                                <th>Effective</th>
                                <th>Expires</th>
                                <th>Producer</th>
                                <th class="qde-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in PagedRows)
                            {
                                <tr class="@RowClass(row)" @onclick="() => SelectRow(row)" @ondblclick="() => OpenQuote(row)" title="Double-click to open quote">
                                    <td>@ImportanceBadge(row)</td>
                                    <td>
                                        <button type="button" class="qde-link-button" @onclick:stopPropagation="true" @onclick="() => OpenQuote(row)">@row.QuoteNo</button>
                                        <small>Quoted @row.QuotedDateUtc.ToString("MMM d, yyyy")</small>
                                    </td>
                                    <td>
                                        <button type="button" class="qde-sub-link" @onclick:stopPropagation="true" @onclick="() => OpenSubmission(row)">@row.SubmissionNo</button>
                                    </td>
                                    <td><strong>@row.Account</strong></td>
                                    <td><span class="qde-lob-pill">@Safe(row.Lob, "Unknown")</span></td>
                                    <td>@Safe(row.Carrier, "Pending Market")</td>
                                    <td>@StatusBadge(row.Status)</td>
                                    <td>@PremiumCell(row.QuotedPremium)</td>
                                    <td>@MoneyOrDash(row.Deductible)</td>
                                    <td>@MoneyOrDash(row.Limit)</td>
                                    <td>@row.EffDate.ToString("MMM d, yyyy")</td>
                                    <td>@ExpiryBadge(row)</td>
                                    <td>@Safe(row.Producer, "Unassigned")</td>
                                    <td class="qde-actions-col">
                                        <button type="button" class="qde-icon-btn" title="Open action menu" @onclick:stopPropagation="true" @onclick="() => ToggleActionMenu(row)">
                                            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                        </button>
                                        @if (_openActionMenuFor == row.QuoteId)
                                        {
                                            <div class="qde-menu" role="menu" @onclick:stopPropagation="true">
                                                <div class="qde-menu__summary">
                                                    <strong>@row.QuoteNo</strong>
                                                    <span>@row.Carrier</span>
                                                </div>
                                                @foreach (var action in _actions)
                                                {
                                                    <button type="button" class="@ActionMenuItemClass(action)" role="menuitem" @onclick="() => HandleActionAsync(action.Key)">
                                                        <i class="bi @action.Icon" aria-hidden="true"></i>
                                                        <span>@action.Label</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="qde-side-panel">
            <section class="qde-panel-card">
                <span class="qde-section-kicker">Selected quote</span>
                @if (_selected is null)
                {
                    <div class="qde-empty qde-empty--compact">
                        <i class="bi bi-cursor" aria-hidden="true"></i>
                        <strong>Select a quote</strong>
                        <span>Choose a quote option to compare terms or run actions.</span>
                    </div>
                }
                else
                {
                    <div class="qde-selected">
                        <div class="qde-selected__title">
                            <h3>@_selected.QuoteNo</h3>
                            @StatusBadge(_selected.Status)
                        </div>
                        <p>@_selected.Account - @_selected.Carrier</p>
                        <div class="qde-score-card">
                            <span>Importance score</span>
                            <strong>@ImportanceScore(_selected)</strong>
                            <small>@ImportanceLevel(_selected)</small>
                        </div>
                        <dl class="qde-detail-list">
                            <div><dt>Submission</dt><dd>@_selected.SubmissionNo</dd></div>
                            <div><dt>LOB</dt><dd>@Safe(_selected.Lob, "Unknown")</dd></div>
                            <div><dt>Premium</dt><dd>@_selected.QuotedPremium.ToString("C0")</dd></div>
                            <div><dt>Deductible</dt><dd>@FormatMoney(_selected.Deductible)</dd></div>
                            <div><dt>Limit</dt><dd>@FormatMoney(_selected.Limit)</dd></div>
                            <div><dt>Effective</dt><dd>@_selected.EffDate.ToString("MMM d, yyyy")</dd></div>
                            <div><dt>Expires</dt><dd>@_selected.ExpiryDate.ToString("MMM d, yyyy")</dd></div>
                            <div><dt>Producer</dt><dd>@Safe(_selected.Producer, "Unassigned")</dd></div>
                        </dl>
                        @if (_selected.Lines.Count > 0)
                        {
                            <details class="qde-line-package">
                                <summary><span><i class="bi bi-layers" aria-hidden="true"></i> Coverage lines</span><strong>@_selected.Lines.Count</strong></summary>
                                <div class="qde-line-package__list">
                                    @foreach (var line in _selected.Lines.OrderBy(line => line.SortOrder).ThenBy(line => line.LineOfBusiness))
                                    {
                                        <article>
                                            <header><strong>@Safe(line.LineOfBusiness, "Coverage line")</strong><span>@Safe(line.Status, "Quoted")</span></header>
                                            <dl>
                                                <div><dt>Premium</dt><dd>@line.QuotedPremium.ToString("C0")</dd></div>
                                                <div><dt>Deductible</dt><dd>@MoneyOrDash(line.Deductible)</dd></div>
                                                <div><dt>Limit</dt><dd>@MoneyOrDash(line.Limit)</dd></div>
                                                <div><dt>Commission</dt><dd>@FormatPercent(line.CommissionPercent)</dd></div>
                                            </dl>
                                        </article>
                                    }
                                </div>
                            </details>
                        }
                        <div class="qde-selected-actions">
                            <button type="button" class="qde-btn qde-btn--primary" @onclick="() => OpenQuote(_selected)"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Quote</button>
                            <button type="button" class="qde-btn qde-btn--ghost" @onclick="() => OpenSubmission(_selected)"><i class="bi bi-send" aria-hidden="true"></i> Open Submission</button>
                            <button type="button" class="qde-btn qde-btn--ghost" @onclick="OpenCompareDialogAsync"><i class="bi bi-columns-gap" aria-hidden="true"></i> Compare</button>
                            <button type="button" class="qde-btn qde-btn--ghost" @onclick='() => OpenActionDialog("Bind")'><i class="bi bi-shield-check" aria-hidden="true"></i> Bind</button>
                        </div>
                    </div>
                }
            </section>

            <section class="qde-panel-card">
                <span class="qde-section-kicker">Quote intelligence</span>
                <div class="qde-insight-list">
                    @foreach (var insight in Insights)
                    {
                        <div class="qde-insight">
                            <i class="bi @insight.Icon" aria-hidden="true"></i>
                            <div>
                                <strong>@insight.Title</strong>
                                <span>@insight.Description</span>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </aside>
    </main>
</div>

@if (_showActionDialog && _selected is not null)
{
    <div class="qde-modal-backdrop" role="presentation" @onclick="CloseActionDialog">
        <div class="qde-modal" role="dialog" aria-modal="true" aria-labelledby="qde-action-title" @onclick:stopPropagation="true">
            <div class="qde-modal__header">
                <i class="bi @_actionIcon" aria-hidden="true"></i>
                <span id="qde-action-title">@_actionTitle</span>
                <button type="button" class="qde-icon-btn qde-icon-btn--light ms-auto" @onclick="CloseActionDialog" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_actionForm" OnValidSubmit="ConfirmActionAsync" OnInvalidSubmit="NotifyActionValidationAsync">
                <DataAnnotationsValidator />
                <div class="qde-modal__body">
                    <div class="qde-modal-intro">
                        <strong>@_actionHelpText</strong>
                        <span>@_selected.QuoteNo - @_selected.Account - @_selected.Carrier</span>
                    </div>
                    <div class="qde-form-grid">
                        @if (_pendingAction is "Accept Quote" or "Request Revision" or "Bind" or "Download PDF")
                        {
                            <label class="qde-field">
                                <span>Annual Premium <em>*</em></span>
                                <InputNumber class="form-control" @bind-Value="_actionForm.AnnualPremium" />
                            </label>
                        }
                        @if (_pendingAction is "Accept Quote" or "Bind" or "Download PDF")
                        {
                            <label class="qde-field">
                                <span>Effective Date <em>*</em></span>
                                <InputDate class="form-control" @bind-Value="_actionForm.EffectiveDate" />
                            </label>
                        }
                        @if (_pendingAction is "Request Revision" or "Accept Quote" or "Bind" or "Download PDF")
                        {
                            <label class="qde-field qde-field--full">
                                <span>@ActionNotesLabel @if (_pendingAction == "Request Revision") { <em>*</em> }</span>
                                <InputTextArea class="form-control" rows="4" @bind-Value="_actionForm.Notes" />
                            </label>
                        }
                    </div>
                </div>
                <div class="qde-modal__footer">
                    <button type="button" class="qde-btn qde-btn--ghost" @onclick="CloseActionDialog" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="qde-btn qde-btn--primary" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @_actionButtonText
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showConfirmDialog)
{
    <div class="qde-modal-backdrop" role="presentation" @onclick="CloseConfirmDialog">
        <div class="qde-confirm" role="dialog" aria-modal="true" aria-labelledby="qde-confirm-title" @onclick:stopPropagation="true">
            <div class="qde-modal__header">
                <i class="bi @_confirmIcon" aria-hidden="true"></i>
                <span>Confirm quote action</span>
                <button type="button" class="qde-icon-btn qde-icon-btn--light ms-auto" @onclick="CloseConfirmDialog" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="qde-confirm__body">
                <div class="@ConfirmIconClass">
                    <i class="bi @_confirmIcon" aria-hidden="true"></i>
                </div>
                <div>
                    <h3 id="qde-confirm-title">@_confirmTitle</h3>
                    <p>@_confirmMessage</p>
                </div>
            </div>
            <div class="qde-modal__footer">
                <button type="button" class="qde-btn qde-btn--ghost" @onclick="CloseConfirmDialog" disabled="@_actionBusy">Cancel</button>
                <button type="button" class="@ConfirmButtonClass" @onclick="ExecuteConfirmedActionAsync" disabled="@_actionBusy">
                    @if (_actionBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

@if (_showCompareDialog && _selected is not null)
{
    <div class="qde-modal-backdrop" role="presentation" @onclick="CloseCompareDialog">
        <div class="qde-compare-modal" role="dialog" aria-modal="true" aria-labelledby="qde-compare-title" @onclick:stopPropagation="true">
            <div class="qde-modal__header">
                <i class="bi bi-columns-gap" aria-hidden="true"></i>
                <span id="qde-compare-title">Compare quotes for @_selected.SubmissionNo</span>
                <button type="button" class="qde-icon-btn qde-icon-btn--light ms-auto" @onclick="CloseCompareDialog"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="qde-modal__body">
                @if (_compareRows.Count == 0)
                {
                    <div class="qde-empty qde-empty--compact"><i class="bi bi-journal-text" aria-hidden="true"></i><span>No additional quote options are available for this submission.</span></div>
                }
                else
                {
                    <div class="qde-compare-grid">
                        @foreach (var row in _compareRows.OrderBy(r => r.QuotedPremium))
                        {
                            <article class="@CompareCardClass(row)">
                                <div class="qde-compare-card__head">
                                    <strong>@row.Carrier</strong>
                                    @StatusBadge(row.Status)
                                </div>
                                <div class="qde-compare-premium">@row.QuotedPremium.ToString("C0")</div>
                                <div class="qde-compare-meta">
                                    <span><i class="bi bi-receipt" aria-hidden="true"></i> @row.QuoteNo</span>
                                    <span><i class="bi bi-cash" aria-hidden="true"></i> Deductible @FormatMoney(row.Deductible)</span>
                                    <span><i class="bi bi-shield" aria-hidden="true"></i> Limit @FormatMoney(row.Limit)</span>
                                    <span><i class="bi bi-clock-history" aria-hidden="true"></i> Expires @row.ExpiryDate.ToString("MMM d, yyyy")</span>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
            <div class="qde-modal__footer">
                <button type="button" class="qde-btn qde-btn--ghost" @onclick="CloseCompareDialog">Close</button>
                <button type="button" class="qde-btn qde-btn--primary" @onclick="OpenSelectedSubmission">Open Submission</button>
            </div>
        </div>
    </div>
}

<div class="qde-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="qde-toast @toast.CssClass">
            <i class="bi @ToastIconClass(toast)" aria-hidden="true"></i>
            <span>@toast.Message</span>
            <button type="button" @onclick="() => DismissToast(toast.Id)"><i class="bi bi-x" aria-hidden="true"></i></button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "readiness")]
    public string? RequestedReadiness { get; set; }

    bool _loading;
    bool _showActionDialog;
    bool _showConfirmDialog;
    bool _showCompareDialog;
    bool _actionBusy;
    string _activeTab = "all";
    string _activeKpi = "all";
    string _sortMode = "importance";
    string? _loadError;
    string? _searchText;
    string? _statusFilter;
    string? _carrierFilter;
    string? _lobFilter;
    string _refreshIconClass = string.Empty;
    Guid? _openActionMenuFor;
    Guid _tenantId;
    int _page = 1;
    const int PageSize = 18;

    QuoteRow? _selected;
    readonly QuoteActionForm _actionForm = new();
    string _pendingAction = string.Empty;
    string _actionTitle = "Quote Action";
    string _actionIcon = "bi-file-earmark-text";
    string _actionButtonText = "Continue";
    string _actionHelpText = string.Empty;
    string _confirmTitle = "Confirm action";
