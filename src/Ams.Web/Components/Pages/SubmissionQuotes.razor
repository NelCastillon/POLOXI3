    Task OpenCompareDialogAsync()
    {
        if (_selected is null) return Task.CompletedTask;

        _compareRows.Clear();
        _compareRows.AddRange(_rows.Where(row => row.SubId == _selected.SubId));

        if (_compareRows.Count == 0)
            _compareRows.Add(_selected);

        _showCompareDialog = true;
        return Task.CompletedTask;
    }

    async Task ExecuteConfirmedActionAsync()
    {
        if (_selected is null || _selected.SubId == Guid.Empty) return;

        _actionBusy = true;
        try
        {
            SubmissionActionResult result;
            if (_pendingAction == "Accept Quote")
            {
                await Api.UpdateSubmissionQuoteAsync(_selected.SubId, _selected.QuoteId, new UpdateSubmissionQuoteRequest(_tenantId, "Received", _actionForm.AnnualPremium ?? _selected.QuotedPremium, _selected.Deductible, _selected.Limit, null, null, null, null, null, null, null, null, null, null, _actionForm.Notes ?? _selected.CoverageNotes, _selected.ExpiryDate, _currentUserId, "ManualEntry", null, _currentUserId, _selected.SubmissionMarketId));
                await Api.SelectSubmissionQuoteAsync(_selected.SubId, new SelectSubmissionQuoteRequest(_tenantId, _selected.QuoteId, true, _actionForm.Notes ?? $"Accepted quote {_selected.QuoteNo} from quote command center.", _currentUserId));
                result = new SubmissionActionResult(_selected.SubId, $"Quote {_selected.QuoteNo} accepted and selected.");
            }
            else if (_pendingAction == "Request Revision")
            {
                result = await Api.RequestSubmissionQuoteAsync(_selected.SubId, new RequestSubmissionQuoteRequest(_tenantId, _selected.CarrierId == Guid.Empty ? null : _selected.CarrierId, _actionForm.AnnualPremium, _selected.Deductible, _selected.Limit, _actionForm.Notes, _currentUserId, null, _selected.SubmissionMarketId));
            }
            else if (_pendingAction == "Bind")
            {
                await Api.SelectSubmissionQuoteAsync(_selected.SubId, new SelectSubmissionQuoteRequest(_tenantId, _selected.QuoteId, true, _actionForm.Notes ?? $"Selected for bind request from quote command center: {_selected.QuoteNo}.", _currentUserId));
                result = new SubmissionActionResult(_selected.SubId, $"Quote {_selected.QuoteNo} selected. Complete proposal presentation and customer acceptance before requesting bind.");
                Nav.NavigateTo($"/submissions/{_selected.SubId}/proposals");
            }
            else if (_pendingAction == "Decline Quote")
            {
                await Api.UpdateSubmissionQuoteAsync(_selected.SubId, _selected.QuoteId, new UpdateSubmissionQuoteRequest(_tenantId, "Declined", _actionForm.AnnualPremium ?? _selected.QuotedPremium, _selected.Deductible, _selected.Limit, null, null, null, null, null, null, null, null, null, null, _actionForm.Notes ?? _selected.CoverageNotes, _selected.ExpiryDate, _currentUserId, "ManualEntry", null, _currentUserId, _selected.SubmissionMarketId));
                result = await Api.DeclineSubmissionAsync(_selected.SubId, new DeclineSubmissionRequest(_tenantId, $"Quote declined from quote command center: {_selected.QuoteNo}."));
            }
            else if (_pendingAction == "Download PDF")
            {
                result = await GenerateProposalAsync();
            }
            else
            {
                result = new SubmissionActionResult(_selected.SubId, "No action executed.");
            }

            _showActionDialog = false;
            _showConfirmDialog = false;
            ShowToast(result.Message, "qde-toast--success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Action failed: {ex.Message}", "qde-toast--danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    async Task<SubmissionActionResult> GenerateProposalAsync()
    {
        if (_selected is null) return new SubmissionActionResult(Guid.Empty, "No quote selected.");

        var quoteIds = _selected.QuoteId == Guid.Empty ? Array.Empty<Guid>() : new[] { _selected.QuoteId };
        var proposalId = await Api.GenerateProposalAsync(new GenerateProposalRequest(_selected.SubId, _tenantId, $"Quote Proposal - {_selected.QuoteNo}", quoteIds, _actionForm.Notes));
        return new SubmissionActionResult(proposalId, "Quote proposal generated.");
    }

    void ShowToast(string message, string cssClass)
    {
        var toast = new ToastMessage(Guid.NewGuid(), message, cssClass);
        _toasts.Add(toast);
        _ = Task.Run(async () =>
        {
            await Task.Delay(2800);
            await InvokeAsync(() => DismissToast(toast.Id));
        });
    }

    void DismissToast(Guid id) => _toasts.RemoveAll(t => t.Id == id);

