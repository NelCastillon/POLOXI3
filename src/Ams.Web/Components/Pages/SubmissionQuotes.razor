    RenderFragment ExpiryBadge(QuoteRow row)
    {
        var days = DaysToExpire(row);
        var label = days < 0 ? $"{Math.Abs(days)}d expired" : days == 0 ? "Today" : $"{days}d";
        var css = days < 0 ? "expired" : days <= 7 ? "soon" : "normal";
        return @<span class="qde-expiry qde-expiry--@css">@label</span>;
    }

    RenderFragment PremiumCell(decimal value) => value <= 0 ? @<span class="qde-muted">-</span> : @<strong class="qde-premium">@value.ToString("C0")</strong>;

    RenderFragment MoneyOrDash(decimal? value) => value is > 0 ? @<span>@value.Value.ToString("C0")</span> : @<span class="qde-muted">-</span>;

    string FormatMoney(decimal? value) => value is > 0 ? value.Value.ToString("C0") : "-";

    string FormatPercent(decimal? value) => value.HasValue ? $"{value.Value:0.##}%" : "-";

    string ToastIconClass(ToastMessage toast) => toast.CssClass.Contains("danger", StringComparison.OrdinalIgnoreCase) ? "bi-exclamation-triangle" : "bi-check-circle";

    string CompareCardClass(QuoteRow row) => _selected?.QuoteId == row.QuoteId ? "qde-compare-card qde-compare-card--active" : "qde-compare-card";

    static string NormalizeQuoteStatus(string status, DateTime expires) => status switch
    {
        "Accepted" or "Bound" or "Presented" => expires < DateTime.Today ? "Expired" : "Accepted",
        "Declined" => "Declined",
        "Expired" => "Expired",
        _ => expires < DateTime.Today ? "Expired" : "Pending"
    };

    static bool Contains(string? source, string term) => !string.IsNullOrWhiteSpace(source) && source.Contains(term, StringComparison.OrdinalIgnoreCase);
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string Slug(string value) => value.ToLowerInvariant().Replace(" ", "-").Replace("/", "-");
    static IEnumerable<string> MergeOptions(IEnumerable<string> configured, IEnumerable<string> observed) => configured.Concat(observed).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);
    static List<SubmissionOption> ToOptions(IEnumerable<SubmissionReferenceOptionDto> options, string group) => options.Where(o => string.Equals(o.OptionGroup, group, StringComparison.OrdinalIgnoreCase)).OrderBy(o => o.SortOrder).ThenBy(o => o.OptionName).Select(o => new SubmissionOption(o.OptionCode, o.OptionName, o.IsDefault)).ToList();

    sealed record SubmissionOption(string Code, string Name, bool IsDefault);

