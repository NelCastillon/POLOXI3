            "Request Revision" => ($"Request revision for {_selected.QuoteNo}?", "This will create a new quote request with the revision notes entered.", "bi-pencil"),
            "Bind" => ($"Continue {_selected.QuoteNo} to proposal workflow?", "This selects the quote and opens the governed proposal and customer acceptance workflow required before bind.", "bi-file-earmark-richtext"),
            "Download PDF" => ($"Generate proposal for {_selected.QuoteNo}?", "This will create a proposal record for the selected quote and keep you on the quote register.", "bi-file-earmark-pdf"),
