@page "/client/segments"
@inject ApiClient Api

<PageTitle>Account Segments</PageTitle>
<h1>Account Segments</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(AccountSegmentDto.SegmentCode)" HeaderText="Code"        Width="120"></GridColumn>
        <GridColumn Field="@nameof(AccountSegmentDto.SegmentName)" HeaderText="Segment"     Width="220"></GridColumn>
        <GridColumn Field="@nameof(AccountSegmentDto.Description)" HeaderText="Description" Width="360"></GridColumn>
        <GridColumn Field="@nameof(AccountSegmentDto.IsActive)"    HeaderText="Active"      Width="90"  DisplayAsCheckBox="true"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private string? _searchTerm;
    private List<AccountSegmentDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchAccountSegmentsAsync(_searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
