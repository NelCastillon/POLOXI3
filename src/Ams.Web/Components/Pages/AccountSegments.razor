@page "/client/segments"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos
@using Ams.Web.Components.Pages.Accounts

<PageTitle>Account Segments — Tenant Admin</PageTitle>

<AppPageHeader Title="Account Segments" Subtitle="Tenant Admin segmentation intelligence and account targeting" Icon="bi-pie-chart"><Actions><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<section class="ma-hero acct-hero"><div><span class="ma-eyebrow">Tenant Admin · Account Intelligence</span><h2>Segmentation Workspace</h2><p>Review segment definitions, active targeting groups, and account distribution.</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/accounts")'><i class="bi bi-building"></i> Accounts</button></div></section>
<div class="pc-kpi-strip acct-kpi-strip"><div class="pc-kpi-card @(_activeFilter is null ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter(null)'><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-pie-chart"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Segments</div></div></div><div class="pc-kpi-card @(_activeFilter == "active" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("active")'><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsActive)</div><div class="pc-kpi-label">Active</div></div></div><div class="pc-kpi-card @(_activeFilter == "inactive" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("inactive")'><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-pause-circle"></i></span><div><div class="pc-kpi-value">@_items.Count(x => !x.IsActive)</div><div class="pc-kpi-label">Inactive</div></div></div><div class="pc-kpi-card"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-building"></i></span><div><div class="pc-kpi-value">@_accounts.Count</div><div class="pc-kpi-label">Accounts</div></div></div></div>
<div class="ma-filter-bar acct-filter-bar"><div class="ma-search-wrap"><i class="bi bi-search"></i><input class="ma-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search segments…" /></div><button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button><span class="ma-filter-count">@Filtered.Count() segments</span></div>
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading segments…</span></div> }<SfGrid TValue="AccountSegmentDto" DataSource="@Filtered.ToList()" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="56"><GridEvents TValue="AccountSegmentDto" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" /><GridColumns><GridColumn HeaderText="Segment" MinWidth="220"><Template>@{ var s=(AccountSegmentDto)context; }<div class="acct-name-cell"><div class="acct-avatar">@AccountPageConstants.Initials(s.SegmentName)</div><div><strong>@s.SegmentName</strong><div class="text-muted">@s.SegmentCode</div></div></div></Template></GridColumn><GridColumn Field="Description" HeaderText="Description" MinWidth="260" /><GridColumn HeaderText="Accounts" Width="120" TextAlign="TextAlign.Center"><Template>@{ var s=(AccountSegmentDto)context; }@_accounts.Count(a => a.SegmentCode == s.SegmentCode)</Template></GridColumn><GridColumn Field="IsActive" HeaderText="Status" Width="110"><Template>@{ var s=(AccountSegmentDto)context; }<span class="um-badge @(s.IsActive ? "um-badge-success" : "um-badge-neutral")">@(s.IsActive ? "Active" : "Inactive")</span></Template></GridColumn></GridColumns></SfGrid></div>
@code { List<AccountSegmentDto> _items = []; List<AccountDto> _accounts = []; string _search = string.Empty; string? _activeFilter, _loadError; bool _loading; IEnumerable<AccountSegmentDto> Filtered => _items.Where(x => (_activeFilter switch { "active" => x.IsActive, "inactive" => !x.IsActive, _ => true }) && (string.IsNullOrWhiteSpace(_search) || x.SegmentName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.SegmentCode.Contains(_search, StringComparison.OrdinalIgnoreCase) || (x.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))); protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Accounts", "/accounts"), new("Segments")); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { _items = (await Api.SearchAccountSegmentsAsync())?.Items.ToList() ?? []; _accounts = (await Api.SearchAccountsAsync(AccountPageConstants.TenantId))?.Items.ToList() ?? []; } catch (Exception ex) { _loadError = $"Failed to load segments: {ex.Message}"; } finally { _loading = false; } } void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; } void SetFilter(string? key) { _activeFilter = key; } void ResetFilters() { _activeFilter = null; _search = string.Empty; } void OnRowSelected(RowSelectEventArgs<AccountSegmentDto> args) { if (!string.IsNullOrWhiteSpace(args.Data.SegmentCode)) Nav.NavigateTo($"/accounts?segment={Uri.EscapeDataString(args.Data.SegmentCode)}"); } }
