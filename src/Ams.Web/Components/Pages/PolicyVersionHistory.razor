@page "/policies/{PolicyId:guid}/versions"
@namespace Ams.Web.Components.Pages
@using Ams.Web.Components.Shared
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Policy Version History ? AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

@if (_loading)
{
    <div class="pvh-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading history?</span></div>
}
else
{
    <!-- -- HEADER --------------------------------------------------- -->
    <div class="pvh-header">
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="GoBack">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Policy
        </button>
        <div class="pvh-header-info">
            <div class="pvh-pol-icon pvh-lob-@_lobKey"><i class="bi @_lobIcon" aria-hidden="true"></i></div>
            <div>
                <div class="pvh-pol-num">@_policyNo</div>
                <div class="pvh-pol-sub">@_account ? @_lob ? @_carrier</div>
            </div>
        </div>
        <div class="pvh-header-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="GoCompare">
                <i class="bi bi-layout-split" aria-hidden="true"></i> Compare Versions
            </button>
        </div>
    </div>

    <!-- -- KPI STRIP ----------------------------------------------- -->
    <div class="pvh-kpi-strip">
        @KpiCard("bi-stack",                "Versions",          _events.Count.ToString(),                                       "pvh-kpi-v")
        @KpiCard("bi-pen",                  "Endorsements",      _events.Count(e=>e.EventType=="Endorsement").ToString(),        "pvh-kpi-end")
        @KpiCard("bi-arrow-repeat",         "Renewals",          _events.Count(e=>e.EventType=="Renewal").ToString(),           "pvh-kpi-ren")
        @KpiCard("bi-cash-stack",           "Premium Today",     _premiumCurrent.ToString("C0"),                                 "pvh-kpi-prem")
        @KpiCard("bi-arrow-up-right-circle","Lifetime Change",   _lifetimePremDelta.ToString("+$#,##0;-$#,##0;$0"),             "pvh-kpi-chg")
    </div>

    <!-- -- VIEW TOGGLE --------------------------------------------- -->
    <div class="pvh-view-bar">
        <button class="pvh-view-btn @(_view=="timeline" ? "pvh-view-active":"")" @onclick='() => _view = "timeline"'>
            <i class="bi bi-clock-history" aria-hidden="true"></i> Timeline
        </button>
        <button class="pvh-view-btn @(_view=="table" ? "pvh-view-active":"")" @onclick='() => _view = "table"'>
            <i class="bi bi-table" aria-hidden="true"></i> Version Table
        </button>
        <div class="pvh-view-spacer"></div>
        <label class="pvh-filter-lbl">Filter</label>
        <select class="e-input pvh-filter-sel" @bind="_filterType">
            <option value="">All Events</option>
            <option>New Business</option>
            <option>Endorsement</option>
            <option>Renewal</option>
            <option>Cancellation</option>
            <option>Reinstatement</option>
            <option>Remarket</option>
        </select>
    </div>

    <!-- -- TIMELINE VIEW ------------------------------------------- -->
    @if (_view == "timeline")
    {
        <div class="pvh-timeline-wrap">
            <PolicyChangeTimeline Events="@FilteredEvents" />
        </div>
    }
    else
    {
        <!-- -- TABLE VIEW ----------------------------------------- -->
        <div class="pvh-table-wrap">
            <AppGrid DataSource="@FilteredEvents.ToList()" AllowSorting="true" AllowPaging="true" RowHeight="40">
                
                <GridColumns>
                    <GridColumn Field="EventDate"    HeaderText="Date"         Width="120" Format="MM/dd/yyyy" />
                    <GridColumn Field="EventType"    HeaderText="Event"        Width="140"
                                Template="@(ctx => EvTypeBadge(((PolicyChangeTimeline.PolicyTimelineEvent)ctx).EventType))" />
                    <GridColumn Field="RefNumber"    HeaderText="Ref #"        Width="140" />
                    <GridColumn Field="Title"        HeaderText="Description"  Width="260" />
                    <GridColumn Field="PremiumDelta" HeaderText="Prem ?"       Width="110"
                                Template="@(ctx => DeltaCell(((PolicyChangeTimeline.PolicyTimelineEvent)ctx).PremiumDelta))" />
                    <GridColumn Field="Carrier"      HeaderText="Carrier"      Width="160" />
                    <GridColumn Field="PerformedBy"  HeaderText="By"           Width="130" />
                    <GridColumn HeaderText="" Width="100" AllowSorting="false"
                                Template="@(ctx => GridActions((PolicyChangeTimeline.PolicyTimelineEvent)ctx))" />
                </GridColumns>
            </AppGrid>
        </div>
    }
}

@code {
    [Parameter] public Guid PolicyId { get; set; }

    EnterpriseToast _toast = default!;

    bool   _loading = true;
    string _view    = "timeline";
    string _filterType = "";

    string  _policyNo        = "";
    string  _account         = "";
    string  _lob             = "";
    string  _carrier         = "";
    string  _lobKey          = "gl";
    string  _lobIcon         = "bi-shield";
    decimal _premiumCurrent  = 0;
    decimal _lifetimePremDelta = 0;

    List<PolicyChangeTimeline.PolicyTimelineEvent> _events = new();

    IReadOnlyList<PolicyChangeTimeline.PolicyTimelineEvent> FilteredEvents =>
        string.IsNullOrEmpty(_filterType)
            ? _events
