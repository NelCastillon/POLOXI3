@page "/policies/{PolicyId:guid}/versions"
@namespace Ams.Web.Components.Pages
@using System.Text.Json
@using Ams.Application.Common.Dtos
@using Ams.Web.Components.Shared
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Policy Version History ? AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

@if (_loading)
{
    <div class="pvh-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading history?</span></div>
}
else
{
    <!-- -- HEADER --------------------------------------------------- -->
    <div class="pvh-header">
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="GoBack">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Policy
        </button>
        <div class="pvh-header-info">
            <div class="pvh-pol-icon pvh-lob-@_lobKey"><i class="bi @_lobIcon" aria-hidden="true"></i></div>
            <div>
                <div class="pvh-pol-num">@_policyNo</div>
                <div class="pvh-pol-sub">@_account ? @_lob ? @_carrier</div>
            </div>
        </div>
        <div class="pvh-header-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="GoCompare">
                <i class="bi bi-layout-split" aria-hidden="true"></i> Compare Versions
            </button>
        </div>
    </div>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError
        </div>
    }

    <!-- -- KPI STRIP ----------------------------------------------- -->
    <div class="pvh-kpi-strip">
        @KpiCard("bi-stack",                "Versions",          _events.Count.ToString(),                                       "pvh-kpi-v", "")
        @KpiCard("bi-pen",                  "Endorsements",      _events.Count(e=>e.EventType=="Endorsement").ToString(),        "pvh-kpi-end", "Endorsement")
        @KpiCard("bi-arrow-repeat",         "Renewals",          _events.Count(e=>e.EventType=="Renewal").ToString(),           "pvh-kpi-ren", "Renewal")
        @KpiCard("bi-cash-stack",           "Premium Today",     _premiumCurrent.ToString("C0"),                                 "pvh-kpi-prem", "premium")
        @KpiCard("bi-arrow-up-right-circle","Lifetime Change",   _lifetimePremDelta.ToString("+$#,##0;-$#,##0;$0"),             "pvh-kpi-chg", "premium")
    </div>

    <!-- -- VIEW TOGGLE --------------------------------------------- -->
    <div class="pvh-view-bar">
        <button class="pvh-view-btn @(_view=="timeline" ? "pvh-view-active":"")" @onclick='() => _view = "timeline"'>
            <i class="bi bi-clock-history" aria-hidden="true"></i> Timeline
        </button>
        <button class="pvh-view-btn @(_view=="table" ? "pvh-view-active":"")" @onclick='() => _view = "table"'>
            <i class="bi bi-table" aria-hidden="true"></i> Version Table
        </button>
        <div class="pvh-view-spacer"></div>
        <label class="pvh-filter-lbl">Filter</label>
        <select class="e-input pvh-filter-sel" @bind="_filterType">
            <option value="">All Events</option>
            <option value="premium">Premium Changes</option>
            @foreach (var eventType in EventTypes)
            {
                <option value="@eventType">@eventType</option>
            }
        </select>
    </div>

    <!-- -- TIMELINE VIEW ------------------------------------------- -->
    @if (_view == "timeline")
    {
        <div class="pvh-timeline-wrap">
            <PolicyChangeTimeline Events="@FilteredEvents" />
        </div>
    }
    else
    {
        <!-- -- TABLE VIEW ----------------------------------------- -->
        <div class="pvh-table-wrap">
            <AppGrid DataSource="@FilteredEvents.ToList()" AllowSorting="true" AllowPaging="true" RowHeight="40">
                
                <GridColumns>
                    <GridColumn Field="EventDate"    HeaderText="Date"         Width="120" Format="MM/dd/yyyy" />
                    <GridColumn Field="EventType"    HeaderText="Event"        Width="140"
                                Template="@(ctx => EvTypeBadge(((PolicyChangeTimeline.PolicyTimelineEvent)ctx).EventType))" />
                    <GridColumn Field="RefNumber"    HeaderText="Ref #"        Width="140" />
                    <GridColumn Field="Title"        HeaderText="Description"  Width="260" />
                    <GridColumn Field="PremiumDelta" HeaderText="Prem ?"       Width="110"
                                Template="@(ctx => DeltaCell(((PolicyChangeTimeline.PolicyTimelineEvent)ctx).PremiumDelta))" />
                    <GridColumn Field="Carrier"      HeaderText="Carrier"      Width="160" />
                    <GridColumn Field="PerformedBy"  HeaderText="By"           Width="130" />
                    <GridColumn HeaderText="" Width="100" AllowSorting="false"
                                Template="@(ctx => GridActions((PolicyChangeTimeline.PolicyTimelineEvent)ctx))" />
                </GridColumns>
            </AppGrid>
        </div>
    }
}

@code {
    [Parameter] public Guid PolicyId { get; set; }

    EnterpriseToast? _toast;

    bool   _loading = true;
    string? _loadError;
    Guid _tenantId;
    string _view    = "timeline";
    string _filterType = "";

    string  _policyNo        = "";
    string  _account         = "";
    string  _lob             = "";
    string  _carrier         = "";
    string  _lobKey          = "gl";
    string  _lobIcon         = "bi-shield";
    decimal _premiumCurrent  = 0;
    decimal _lifetimePremDelta = 0;

    List<PolicyChangeTimeline.PolicyTimelineEvent> _events = new();

    IReadOnlyList<PolicyChangeTimeline.PolicyTimelineEvent> FilteredEvents =>
        _filterType switch
        {
            "" => _events,
            "premium" => _events.Where(e => e.PremiumDelta != 0).ToList(),
            _ => _events.Where(e => e.EventType == _filterType).ToList()
        };
    string[] EventTypes => _events.Select(e => e.EventType).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Order().ToArray();

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home","/"), new("Policies","/policies"),
            new("Policy Detail", $"/policies/{PolicyId}"),
            new("Version History", $"/policies/{PolicyId}/versions"));

        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var context = await CurrentUser.RequireAsync();
            _tenantId = context.TenantId;

            var detail = await Api.GetPolicyLifecycleDetailAsync(_tenantId, PolicyId);
            BuildFromLifecycle(detail);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load policy lifecycle history: {ex.Message}";
            _events = [];
            if (_toast is not null)
            {
                await _toast.ShowAsync(new ToastModel { Title = "Policy Version History", Content = $"Load failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
            }
        }
        finally
        {
            _loading = false;
        }
    }

    void BuildFromLifecycle(PolicyLifecycleDetailDto? detail)
    {
        _policyNo = PolicyId.ToString("N")[..8].ToUpperInvariant();
        _account = "Policy lifecycle";
        _lob = "Policy";
        _carrier = string.Empty;
        _lobKey = "policy";
        _lobIcon = "bi-shield";
        _premiumCurrent = 0m;
        _lifetimePremDelta = 0m;
        _events = [];

        if (detail is null)
        {
            _loadError = "No lifecycle history was found for this policy.";
            return;
        }

        _policyNo = detail.Policy.PolicyNumber;
        _account = detail.Policy.AccountName;
        _lob = detail.Policy.LineOfBusiness;
        _carrier = detail.Policy.CarrierName;
        _premiumCurrent = detail.Policy.AnnualPremium;
        _lobKey = _lob.ToLowerInvariant().Replace(" ", "-");
        _lobIcon = _lob.Contains("auto", StringComparison.OrdinalIgnoreCase) ? "bi-car-front" : _lob.Contains("property", StringComparison.OrdinalIgnoreCase) ? "bi-building" : "bi-shield";

        var latestSnapshot = detail.Versions.OrderByDescending(x => x.VersionNumber).FirstOrDefault()?.SnapshotJson;
        ApplySnapshotHeader(latestSnapshot);

        var lineChangesByTransaction = detail.LineChanges
            .GroupBy(x => x.PolicyTransactionId)
            .ToDictionary(x => x.Key, x => x.ToList());

        _events = detail.Transactions
            .OrderBy(x => x.EffectiveDate)
            .ThenBy(x => x.CreatedDateUtc)
            .Select(tx => ToTimelineEvent(tx, lineChangesByTransaction.GetValueOrDefault(tx.PolicyTransactionId) ?? []))
            .ToList();

        if (_events.Count == 0)
        {
            _events = detail.StatusHistory
                .OrderBy(x => x.ChangedDateUtc)
                .Select(ToTimelineEvent)
                .ToList();
        }

        _premiumCurrent = detail.Transactions
            .OrderByDescending(x => x.EffectiveDate)
            .ThenByDescending(x => x.CreatedDateUtc)
            .Select(x => x.NewWrittenPremium ?? x.PriorWrittenPremium ?? 0m)
            .FirstOrDefault(x => x > 0m, _premiumCurrent);
        _lifetimePremDelta = _events.Sum(e => e.PremiumDelta);
    }

    void ApplySnapshotHeader(string? snapshotJson)
    {
        if (string.IsNullOrWhiteSpace(snapshotJson))
        {
            return;
        }

        try
        {
            using var document = JsonDocument.Parse(snapshotJson);
            var root = document.RootElement;
            _policyNo = ReadString(root, "PolicyNumber") ?? _policyNo;
            _lob = ReadString(root, "LineOfBusiness") ?? _lob;
            _carrier = ReadString(root, "Carrier") ?? _carrier;
            _premiumCurrent = ReadDecimal(root, "AnnualPremium") ?? _premiumCurrent;
            _lobKey = _lob.ToLowerInvariant().Replace(" ", "-");
            _lobIcon = _lob.Contains("auto", StringComparison.OrdinalIgnoreCase) ? "bi-car-front" : _lob.Contains("property", StringComparison.OrdinalIgnoreCase) ? "bi-building" : "bi-shield";
        }
        catch (JsonException)
        {
        }
    }

    static PolicyChangeTimeline.PolicyTimelineEvent ToTimelineEvent(PolicyTransactionDto transaction, IReadOnlyList<PolicyTransactionLineChangeDto> lineChanges)
    {
        var eventType = DisplayCode(transaction.TransactionTypeCode);
        var priorPremium = transaction.PriorWrittenPremium ?? 0m;
        var newPremium = transaction.NewWrittenPremium ?? priorPremium + (transaction.PremiumChange ?? 0m);
        var deltas = new List<PolicyChangeTimeline.ExposureDelta>();

        if (transaction.PremiumChange.HasValue || transaction.NewWrittenPremium.HasValue || transaction.PriorWrittenPremium.HasValue)
        {
            deltas.Add(PolicyChangeTimeline.ExposureDelta.Money("Written Premium", priorPremium, newPremium));
        }

        deltas.AddRange(lineChanges.Select(line => PolicyChangeTimeline.ExposureDelta.Money(line.LineOfBusinessName, line.PriorPremium ?? 0m, line.NewPremium ?? (line.PriorPremium ?? 0m) + (line.PremiumChange ?? 0m))));

        return new PolicyChangeTimeline.PolicyTimelineEvent
        {
            EventType = eventType,
            Title = string.IsNullOrWhiteSpace(transaction.Description) ? $"{eventType} - {DisplayCode(transaction.TransactionStatusCode)}" : transaction.Description,
            Description = string.IsNullOrWhiteSpace(transaction.Notes) ? $"Status: {DisplayCode(transaction.TransactionStatusCode)}" : transaction.Notes,
            EventDate = transaction.EffectiveDate,
            PerformedBy = transaction.IssuedByUserId?.ToString("N")[..8] ?? transaction.ApprovedByUserId?.ToString("N")[..8] ?? transaction.RequestedByUserId?.ToString("N")[..8] ?? "System",
            PremiumDelta = transaction.PremiumChange ?? newPremium - priorPremium,
            Carrier = string.Empty,
            RefNumber = transaction.TransactionNumber,
            ExposureDeltas = deltas
        };
    }

    static PolicyChangeTimeline.PolicyTimelineEvent ToTimelineEvent(PolicyStatusHistoryDto status)
        => new()
        {
            EventType = "Audit",
            Title = $"{DisplayCode(status.StatusScopeCode)} status changed to {DisplayCode(status.NewStatusCode)}",
            Description = status.Notes ?? status.ReasonCode ?? string.Empty,
            EventDate = status.ChangedDateUtc,
            PerformedBy = status.ChangedByUserId?.ToString("N")[..8] ?? "System",
            RefNumber = status.PolicyStatusHistoryId.ToString("N")[..8].ToUpperInvariant(),
            ExposureDeltas = string.IsNullOrWhiteSpace(status.OldStatusCode)
                ? []
                : [PolicyChangeTimeline.ExposureDelta.Text("Status", DisplayCode(status.OldStatusCode), DisplayCode(status.NewStatusCode))]
        };

    static string DisplayCode(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var spaced = System.Text.RegularExpressions.Regex.Replace(value.Trim(), "(?<!^)([A-Z])", " $1");
        return spaced.Replace("  ", " ");
    }

    static string? ReadString(JsonElement element, string propertyName)
        => element.TryGetProperty(propertyName, out var property) && property.ValueKind == JsonValueKind.String ? property.GetString() : null;

    static decimal? ReadDecimal(JsonElement element, string propertyName)
        => element.TryGetProperty(propertyName, out var property) && property.TryGetDecimal(out var value) ? value : null;

    void GoBack()    => Nav.NavigateTo($"/policies/{PolicyId}");
    void GoCompare() => Nav.NavigateTo($"/policies/{PolicyId}/compare");

    RenderFragment EvTypeBadge(string t) =>
        @<span class="pvh-et pvh-et-@t.ToLower().Replace(" ","-")">@t</span>;

    RenderFragment DeltaCell(decimal d) =>
        d == 0 ? @<span class="pvh-d0">?</span>
               : d > 0 ? @<span class="pvh-dp">+@d.ToString("C0")</span>
                       : @<span class="pvh-dn">@d.ToString("C0")</span>;

    RenderFragment GridActions(PolicyChangeTimeline.PolicyTimelineEvent ev) =>
        @<button class="um-btn um-btn-ghost um-btn-xs" title="Compare with previous"
                 @onclick='() => Nav.NavigateTo($"/policies/{PolicyId}/compare")'>
            <i class="bi bi-layout-split" aria-hidden="true"></i> Compare
        </button>;

    RenderFragment KpiCard(string icon, string label, string val, string css, string filter) =>
        @<button type="button" class="pvh-kpi-card @css @(_filterType == filter ? "pvh-kpi-card--active" : null)" title="Filter by @label" @onclick="() => _filterType = _filterType == filter ? string.Empty : filter">
            <div class="pvh-kpi-val">@val</div>
            <div class="pvh-kpi-lbl"><i class="bi @icon" aria-hidden="true"></i> @label</div>
        </button>;
}
