    void GoBack()    => Nav.NavigateTo($"/policies/{PolicyId}");
    void GoCompare() => Nav.NavigateTo($"/policies/{PolicyId}/compare");

    RenderFragment EvTypeBadge(string t) =>
        @<span class="pvh-et pvh-et-@t.ToLower().Replace(" ","-")">@t</span>;

    RenderFragment DeltaCell(decimal d) =>
        d == 0 ? @<span class="pvh-d0">?</span>
               : d > 0 ? @<span class="pvh-dp">+@d.ToString("C0")</span>
                       : @<span class="pvh-dn">@d.ToString("C0")</span>;

    RenderFragment GridActions(PolicyChangeTimeline.PolicyTimelineEvent ev) =>
        @<button class="um-btn um-btn-ghost um-btn-xs" title="Compare with previous"
                 @onclick='() => Nav.NavigateTo($"/policies/{PolicyId}/compare")'>
            <i class="bi bi-layout-split" aria-hidden="true"></i> Compare
        </button>;

    RenderFragment KpiCard(string icon, string label, string val, string css) =>
        @<div class="pvh-kpi-card @css">
            <div class="pvh-kpi-val">@val</div>
            <div class="pvh-kpi-lbl"><i class="bi @icon" aria-hidden="true"></i> @label</div>
        </div>;
}
