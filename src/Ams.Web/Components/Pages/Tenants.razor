@page "/platform/tenants"
@inject ApiClient Api

<PageTitle>Tenants</PageTitle>
<h1>Platform Tenants</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(TenantDto.TenantCode)"   HeaderText="Code"      Width="120"></GridColumn>
        <GridColumn Field="@nameof(TenantDto.TenantName)"   HeaderText="Name"      Width="220"></GridColumn>
        <GridColumn Field="@nameof(TenantDto.PlanCode)"     HeaderText="Plan"      Width="120"></GridColumn>
        <GridColumn Field="@nameof(TenantDto.CurrencyCode)" HeaderText="Currency"  Width="100"></GridColumn>
        <GridColumn Field="@nameof(TenantDto.Locale)"       HeaderText="Locale"    Width="120"></GridColumn>
        <GridColumn Field="@nameof(TenantDto.IsActive)"     HeaderText="Active"    Width="90"  DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(TenantDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="d" Width="140"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private string? _searchTerm;
    private List<TenantDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchTenantsAsync(_searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
