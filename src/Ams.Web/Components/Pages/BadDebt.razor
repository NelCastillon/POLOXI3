@page "/finance/bad-debt"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@using Ams.Application.Common.Dtos
@using Ams.Web.Services

<h3>Bad Debt Entries</h3>

<div class="mb-3 d-flex gap-2">
    <AppTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="300px" />
    <AppButton OnClick="LoadAsync">Search</AppButton>
</div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}

<AppGrid DataSource="_items" AllowPaging="true">
    
    <GridColumns>
        <GridColumn Field="@nameof(BadDebtEntryDto.BadDebtEntryId)" HeaderText="ID" Width="220" />
        <GridColumn Field="@nameof(BadDebtEntryDto.AccountId)" HeaderText="Account ID" Width="220" />
        <GridColumn Field="@nameof(BadDebtEntryDto.WriteOffDate)" HeaderText="Write-Off Date" Width="140" />
        <GridColumn Field="@nameof(BadDebtEntryDto.Amount)" HeaderText="Amount" Format="C2" Width="120" />
        <GridColumn Field="@nameof(BadDebtEntryDto.Reason)" HeaderText="Reason" Width="200" />
        <GridColumn Field="@nameof(BadDebtEntryDto.StatusCode)" HeaderText="Status" Width="120" />
        <GridColumn Field="@nameof(BadDebtEntryDto.CreatedDateUtc)" HeaderText="Created" Width="160" />
    </GridColumns>
</AppGrid>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private List<BadDebtEntryDto>? _items;
    private string? _searchTerm;
    private string? _loadError;
    private Guid _tenantId;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            var result = await Api.SearchBadDebtEntriesAsync(_tenantId, _searchTerm);
            _items = result?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = $"Bad debt entries failed to load: {ex.Message}";
            _items = [];
        }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
