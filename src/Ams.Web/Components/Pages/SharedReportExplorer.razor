@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject ConfirmationDialogService Confirmations
@inject IJSRuntime Js

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="@Title" Subtitle="@Subtitle" Icon="@Icon">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-ghost" @onclick="() => _showSchedule = true">
            <i class="bi bi-calendar-plus" aria-hidden="true"></i> Schedule
        </button>
        <button class="um-btn um-btn-primary" @onclick="ExportVisibleAsync" disabled="@(!_filtered.Any())">
            <i class="bi bi-download" aria-hidden="true"></i> Export View
        </button>
    </Actions>
</AppPageHeader>

<div class="rl-kpi-strip pc-kpi-strip">
    @KpiCard(null, "bi-file-earmark-bar-graph", "Reports", _reports.Count.ToString(), "rl-ki-blue")
    @KpiCard("Scheduled", "bi-calendar-check", "Scheduled", _reports.Count(r => IsScheduled(r.ReportDefinitionId)).ToString(), "rl-ki-green")
    @KpiCard("Active", "bi-check-circle", "Active", _reports.Count(r => r.IsActive).ToString(), "rl-ki-green")
    @KpiCard("Recent", "bi-play-circle", "Run 30d", _executions.Count.ToString(), "rl-ki-amber")
    @KpiCard("Exportable", "bi-download", "Exportable", _reports.Count(r => r.OutputFormats.Contains("Excel") || r.OutputFormats.Contains("CSV")).ToString(), "rl-ki-blue")
</div>

<div class="rl-filter-bar">
    <div class="rl-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="rl-search" placeholder="Search reportsâ€¦" @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" />
    </div>
    <select class="rl-sel" @bind="_moduleFilter" @bind:after="ApplyFilter">
        <option value="">All Modules</option>
        @foreach (var module in _reports.Select(r => r.ModuleCode).Distinct().Order())
        {
            <option value="@module">@module</option>
        }
    </select>
    <select class="rl-sel" @bind="_formatFilter" @bind:after="ApplyFilter">
        <option value="">All Formats</option>
        <option value="PDF">PDF</option>
        <option value="Excel">Excel</option>
        <option value="CSV">CSV</option>
    </select>
    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters">
        <i class="bi bi-x" aria-hidden="true"></i>
    </button>
    <span class="ms-auto rl-result-count"><strong>@_filtered.Count</strong> report(s)</span>
</div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

@if (IsScheduledPage)
{
    <div class="rl-list-wrap position-relative app-datagrid">
        @if (_loading)
        {
            <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading schedulesâ€¦</span></div>
        }
        <SfGrid TValue="ReportScheduleDto" DataSource="_schedules" AllowSorting="true" AllowPaging="true" EnableHover="true" RowHeight="52">
            <GridPageSettings PageSize="25" PageSizes="@(new[] { 10, 25, 50 })" />
            <GridColumns>
                <GridColumn Field="@nameof(ReportScheduleDto.ReportName)" HeaderText="Report" MinWidth="260" />
                <GridColumn Field="@nameof(ReportScheduleDto.ModuleCode)" HeaderText="Module" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                <GridColumn Field="@nameof(ReportScheduleDto.FrequencyCode)" HeaderText="Frequency" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                <GridColumn Field="@nameof(ReportScheduleDto.OutputFormat)" HeaderText="Format" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                <GridColumn Field="@nameof(ReportScheduleDto.DeliveryEmail)" HeaderText="Delivery" MinWidth="220" />
                <GridColumn HeaderText="Active" Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center"><Template>@{ var s = (ReportScheduleDto)context; }<i class="bi @(s.IsActive ? "bi-check-circle-fill rl-yes" : "bi-dash-circle rl-no")" aria-hidden="true"></i></Template></GridColumn>
                <GridColumn Field="@nameof(ReportScheduleDto.NextRunDateUtc)" HeaderText="Next Run" Width="150" Type="ColumnType.DateTime" Format="MMM d, yyyy" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                <GridColumn HeaderText="Actions" Width="170" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" AllowSorting="false">
                    <Template>
                        @{ var s = (ReportScheduleDto)context; }
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenPreviewAsync(s.ReportDefinitionId)" title="View actual report"><i class="bi bi-eye" aria-hidden="true"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => ToggleScheduleAsync(s)" title="@(s.IsActive ? "Pause" : "Activate")"><i class="bi @(s.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => DeleteScheduleAsync(s)" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
}
else if (IsExportCenter)
{
    <div class="rl-list-wrap position-relative app-datagrid">
        @if (_loading)
        {
            <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading exportsâ€¦</span></div>
        }
        <SfGrid TValue="ReportExecutionDto" DataSource="_executions" AllowSorting="true" AllowPaging="true" EnableHover="true" RowHeight="52">
            <GridPageSettings PageSize="25" PageSizes="@(new[] { 10, 25, 50 })" />
            <GridColumns>
                <GridColumn Field="@nameof(ReportExecutionDto.ReportName)" HeaderText="Report" MinWidth="260" />
                <GridColumn Field="@nameof(ReportExecutionDto.StatusCode)" HeaderText="Status" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                <GridColumn Field="@nameof(ReportExecutionDto.OutputFormat)" HeaderText="Format" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                <GridColumn Field="@nameof(ReportExecutionDto.RowCount)" HeaderText="Rows" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                <GridColumn Field="@nameof(ReportExecutionDto.FileSizeBytes)" HeaderText="Size" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"><Template>@{ var e = (ReportExecutionDto)context; }@FormatBytes(e.FileSizeBytes)</Template></GridColumn>
                <GridColumn Field="@nameof(ReportExecutionDto.CompletedDateUtc)" HeaderText="Completed" Width="150" Type="ColumnType.DateTime" Format="MMM d, yyyy" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                <GridColumn Field="@nameof(ReportExecutionDto.StoragePath)" HeaderText="Storage Path" MinWidth="260" />
                <GridColumn HeaderText="Actions" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" AllowSorting="false">
                    <Template>
                        @{ var e = (ReportExecutionDto)context; }
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenPreviewAsync(e.ReportDefinitionId)" title="View actual report"><i class="bi bi-eye" aria-hidden="true"></i></button>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
}
else
{
<div class="rl-list-wrap position-relative app-datagrid">
    @if (_loading)
    {
        <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading reportsâ€¦</span></div>
    }
    <SfGrid TValue="ReportDefinitionDto" DataSource="_filtered" AllowSorting="true" AllowPaging="true" EnableHover="true" RowHeight="52">
        <GridEvents TValue="ReportDefinitionDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" PageSizes="@(new[] { 10, 25, 50 })" />
        <GridColumns>
            <GridColumn HeaderText="Report" MinWidth="280" Field="@nameof(ReportDefinitionDto.ReportName)">
                <Template>
                    @{ var r = (ReportDefinitionDto)context; }
                    <div class="rl-list-name-cell">
                        <div class="rl-list-icon @CatIconCss(r.ModuleCode)"><i class="bi @CatIcon(r.ModuleCode)" aria-hidden="true"></i></div>
                        <div>
                            <div class="rl-ln">@r.ReportName</div>
                            <div class="rl-ld">@r.Description</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(ReportDefinitionDto.ModuleCode)" HeaderText="Module" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                <Template>@{ var r = (ReportDefinitionDto)context; }<span class="@CatBadge(r.ModuleCode)">@r.ModuleCode</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(ReportDefinitionDto.ReportTypeCode)" HeaderText="Type" Width="110" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
            <GridColumn Field="@nameof(ReportDefinitionDto.OutputFormats)" HeaderText="Formats" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
            <GridColumn HeaderText="Scheduled" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                <Template>@{ var r = (ReportDefinitionDto)context; }<i class="bi @(IsScheduled(r.ReportDefinitionId) ? "bi-check-circle-fill rl-yes" : "bi-dash rl-no")" aria-hidden="true"></i></Template>
            </GridColumn>
            <GridColumn HeaderText="Last Run" Width="140" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                <Template>@{ var r = (ReportDefinitionDto)context; }@LastRunLabel(r.ReportDefinitionId)</Template>
            </GridColumn>
            <GridColumn HeaderText="Actions" Width="170" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" AllowSorting="false">
                <Template>
                    @{ var r = (ReportDefinitionDto)context; }
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenPreviewAsync(r)" title="View report"><i class="bi bi-eye" aria-hidden="true"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => RunReportAsync(r)" title="Run now"><i class="bi bi-play-fill" aria-hidden="true"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenSchedule(r)" title="Schedule"><i class="bi bi-calendar-plus" aria-hidden="true"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => ExportReportAsync(r)" title="Export"><i class="bi bi-download" aria-hidden="true"></i></button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>
}

<SfDialog @bind-Visible="_showSchedule" Width="480px" IsModal="true" ShowCloseIcon="false">
    <DialogContent>
        <div class="um-modal-header">
            <i class="bi bi-calendar-plus"></i><span>Schedule Report</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showSchedule = false"><i class="bi bi-x-lg"></i></button>
        </div>
        <EditForm EditContext="@_scheduleEditContext">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="um-form-grid">
                <div class="um-field um-field--full">
                    <label>Report <span class="text-danger">*</span></label>
                    <InputSelect @bind-Value="_scheduleForm.ReportDefinitionId" class="um-input">
                        @foreach (var report in _reports)
                        {
                            <option value="@report.ReportDefinitionId">@report.ReportName</option>
                        }
                    </InputSelect>
                </div>
                <div class="um-field">
                    <label>Frequency</label>
                    <InputSelect @bind-Value="_scheduleForm.FrequencyCode" class="um-input">
                        @foreach (var frequency in _freqOpts) { <option>@frequency</option> }
                    </InputSelect>
                </div>
                <div class="um-field">
                    <label>Format</label>
                    <InputSelect @bind-Value="_scheduleForm.OutputFormat" class="um-input">
                        @foreach (var format in _fmtOpts) { <option>@format</option> }
                    </InputSelect>
                </div>
                <div class="um-field um-field--full">
                    <label>Deliver to <span class="text-danger">*</span></label>
                    <InputText @bind-Value="_scheduleForm.DeliveryEmail" class="um-input" placeholder="ops@agencybinder.local" />
                </div>
                @if (!string.IsNullOrWhiteSpace(_formError))
                {
                    <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div>
                }
                </div>
            </div>
        </EditForm>
        <div class="um-modal-footer">
            <button class="um-btn um-btn-ghost" @onclick="() => _showSchedule = false">Cancel</button>
            <button class="um-btn um-btn-primary" @onclick="ScheduleAsync">Schedule</button>
        </div>
    </DialogContent>
</SfDialog>

<SfDialog @bind-Visible="_showPreview" Width="min(1120px, 96vw)" IsModal="true" ShowCloseIcon="false">
    <DialogContent>
        <div class="um-modal-header rl-preview-header">
            <i class="bi @(string.IsNullOrWhiteSpace(_preview?.ModuleCode) ? "bi-file-earmark-bar-graph" : CatIcon(_preview.ModuleCode))"></i>
            <div>
                <span>@(_preview?.ReportName ?? "Report Preview")</span>
                <small>@_preview?.Description</small>
            </div>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="ClosePreview"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="um-modal-body rl-preview-body">
            @if (_previewLoading)
            {
                <div class="rl-preview-loading"><div class="um-spinner" aria-hidden="true"></div><span>Generating report previewâ€¦</span></div>
            }
            else if (!string.IsNullOrWhiteSpace(_previewError))
            {
                <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @_previewError
                </div>
            }
            else if (_preview is not null)
            {
                <div class="rl-preview-summary">
                    <div><span>Module</span><strong>@_preview.ModuleCode</strong></div>
                    <div><span>Type</span><strong>@_preview.ReportTypeCode</strong></div>
                    <div><span>Rows</span><strong>@_preview.RowCount</strong></div>
                    <div><span>Generated</span><strong>@_preview.GeneratedDateUtc.ToString("MMM d, yyyy h:mm tt")</strong></div>
                </div>
                <div class="rl-preview-table-wrap">
                    <table class="rl-preview-table">
                        <thead>
                            <tr>
                                @foreach (var column in _preview.Columns)
                                {
                                    <th class="@PreviewCellCss(column.DataType)">@column.Header</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _preview.Rows)
                            {
                                <tr>
                                    @foreach (var column in _preview.Columns)
                                    {
                                        <td class="@PreviewCellCss(column.DataType)">@row.GetValueOrDefault(column.Field)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="um-modal-footer">
            <button class="um-btn um-btn-ghost" @onclick="ClosePreview">Close</button>
            @if (_previewReport is not null)
            {
                <button class="um-btn um-btn-ghost" @onclick="() => OpenSchedule(_previewReport)"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Schedule</button>
                <button class="um-btn um-btn-ghost" @onclick="() => RunReportAsync(_previewReport)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run</button>
                <button class="um-btn um-btn-primary" @onclick="() => ExportReportAsync(_previewReport)"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Download Excel</button>
            }
        </div>
    </DialogContent>
</SfDialog>

<style>
@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }
</style>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    [Parameter] public string Title { get; set; } = "Reports";
    [Parameter] public string Subtitle { get; set; } = "Run, schedule, and export reports";
    [Parameter] public string Icon { get; set; } = "bi-collection-fill";
    [Parameter] public string? Module { get; set; }

    private Guid _tenantId;
    private SfToast? _toast;
    private bool _loading;
    private bool _showSchedule;
    private bool _showPreview;
    private bool _previewLoading;
    private string? _loadError, _formError;
    private string? _previewError;
    private string _search = string.Empty;
    private string _moduleFilter = string.Empty;
    private string _formatFilter = string.Empty;
    private string? _activeFilter;
    private ScheduleForm _scheduleForm = new();
    private EditContext _scheduleEditContext;

    private readonly string[] _freqOpts = ["Daily", "Weekly", "Monthly", "Quarterly"];
    private readonly string[] _fmtOpts = ["PDF", "Excel", "CSV"];
    private List<ReportDefinitionDto> _reports = [];
    private List<ReportDefinitionDto> _filtered = [];
    private List<ReportExecutionDto> _executions = [];
    private List<ReportScheduleDto> _schedules = [];
    private ReportDefinitionDto? _previewReport;
    private ReportPreviewDto? _preview;

    private bool IsScheduledPage => Title.Contains("Scheduled", StringComparison.OrdinalIgnoreCase);
    private bool IsExportCenter => Title.Contains("Export Center", StringComparison.OrdinalIgnoreCase);

    public SharedReportExplorer()
    {
        _scheduleEditContext = new EditContext(_scheduleForm);
    }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var defs = await Api.SearchReportDefinitionsAsync(null);
            var execs = await Api.SearchReportExecutionsAsync(_tenantId, null);
            var schedules = await Api.SearchReportSchedulesAsync(_tenantId, null);
            _reports = defs?.Items.Where(r => string.IsNullOrEmpty(Module) || r.ModuleCode.Equals(Module, StringComparison.OrdinalIgnoreCase)).ToList() ?? [];
            _executions = execs?.Items.Where(e => _reports.Any(r => r.ReportDefinitionId == e.ReportDefinitionId)).ToList() ?? [];
            _schedules = schedules?.Items.Where(s => _reports.Any(r => r.ReportDefinitionId == s.ReportDefinitionId)).ToList() ?? [];
            _scheduleForm.ReportDefinitionId = _reports.FirstOrDefault()?.ReportDefinitionId ?? Guid.Empty;
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load report data: {ex.Message}";
            _reports = [];
            _filtered = [];
            _executions = [];
            _schedules = [];
        }
        finally { _loading = false; }
    }

    private void SetKpiFilter(string? filter)
    {
        _activeFilter = _activeFilter == filter ? null : filter;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = _reports.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(r => r.ReportName.Contains(_search, StringComparison.OrdinalIgnoreCase) || (r.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
        if (!string.IsNullOrWhiteSpace(_moduleFilter)) q = q.Where(r => r.ModuleCode == _moduleFilter);
        if (!string.IsNullOrWhiteSpace(_formatFilter)) q = q.Where(r => r.OutputFormats.Contains(_formatFilter, StringComparison.OrdinalIgnoreCase));
        q = _activeFilter switch
        {
            "Scheduled" => q.Where(r => IsScheduled(r.ReportDefinitionId)),
            "Active" => q.Where(r => r.IsActive),
            "Recent" => q.Where(r => _executions.Any(e => e.ReportDefinitionId == r.ReportDefinitionId)),
            "Exportable" => q.Where(r => r.OutputFormats.Contains("Excel") || r.OutputFormats.Contains("CSV")),
            _ => q
        };
        _filtered = q.OrderBy(r => r.ModuleCode).ThenBy(r => r.ReportName).ToList();
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _moduleFilter = string.Empty;
        _formatFilter = string.Empty;
        _activeFilter = null;
        ApplyFilter();
    }

    private async Task OnRowSelected(RowSelectEventArgs<ReportDefinitionDto> args) => await OpenPreviewAsync(args.Data);

    private async Task OpenPreviewAsync(Guid reportDefinitionId)
    {
        var report = _reports.FirstOrDefault(r => r.ReportDefinitionId == reportDefinitionId);
        if (report is not null)
        {
            await OpenPreviewAsync(report);
        }
    }

    private async Task OpenPreviewAsync(ReportDefinitionDto report)
    {
        _previewReport = report;
        _preview = null;
        _previewError = null;
        _previewLoading = true;
        _showPreview = true;
        try
        {
            _preview = await Api.GetReportPreviewAsync(report.ReportDefinitionId, _tenantId);
        }
        catch (Exception ex)
        {
            _previewError = $"Preview failed: {ex.Message}";
        }
        finally
        {
            _previewLoading = false;
        }
    }

    private void ClosePreview()
    {
        _showPreview = false;
        _previewError = null;
        _previewLoading = false;
    }

    private void OpenSchedule(ReportDefinitionDto report)
    {
        _scheduleForm = new ScheduleForm
        {
            ReportDefinitionId = report.ReportDefinitionId,
            OutputFormat = report.OutputFormats.Contains("Excel") ? "Excel" : report.OutputFormats.Contains("CSV") ? "CSV" : "PDF",
            FrequencyCode = "Weekly",
            DeliveryEmail = "ops@agencybinder.local"
        };
        _scheduleEditContext = new(_scheduleForm);
        _formError = null;
        _showSchedule = true;
    }

    private async Task RunReportAsync(ReportDefinitionDto report)
    {
        try
        {
            var format = report.OutputFormats.Contains("Excel") ? "Excel" : report.OutputFormats.Contains("CSV") ? "CSV" : "PDF";
            await Api.RunReportAsync(report.ReportDefinitionId, new RunReportRequest(_tenantId, format));
            await LoadAsync();
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Report run completed: {report.ReportName}", CssClass = "e-toast-success" });
        }
        catch (Exception ex)
        {
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Run failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    private async Task ExportReportAsync(ReportDefinitionDto report)
    {
        try
        {
            var file = await Api.DownloadReportExcelAsync(report.ReportDefinitionId, _tenantId);
            await DownloadFileAsync(file);
            await LoadAsync();
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Excel downloaded: {report.ReportName}", CssClass = "e-toast-success" });
        }
        catch (Exception ex)
        {
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Export failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    private async Task ExportVisibleAsync()
    {
        try
        {
            var file = await Api.DownloadReportsExcelAsync(new DownloadReportsRequest
            {
                TenantId = _tenantId,
                ReportDefinitionIds = _filtered.Select(r => r.ReportDefinitionId).ToList(),
                SearchTerm = _search,
                ModuleCode = _moduleFilter,
                Format = _formatFilter
            });
            await DownloadFileAsync(file);
            await LoadAsync();
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Excel downloaded for {_filtered.Count} report(s).", CssClass = "e-toast-success" });
        }
        catch (Exception ex)
        {
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Export view failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    private async Task DownloadFileAsync(ReportDownloadFile file)
    {
        var fileName = file.FileName.Replace("'", string.Empty);
        var base64 = Convert.ToBase64String(file.Content);
        var script = $"(() => {{ const a = document.createElement(\"a\"); a.href = \"data:application/vnd.ms-excel;base64,{base64}\"; a.download = \"{fileName}\"; document.body.appendChild(a); a.click(); a.remove(); }})()";
        await Js.InvokeVoidAsync("eval", script);
    }

    private async Task ScheduleAsync()
    {
        _formError = null;
        if (!_scheduleEditContext.Validate()) return;
        try
        {
            await Api.ScheduleReportAsync(new ScheduleReportRequest(_tenantId, _scheduleForm.ReportDefinitionId, _scheduleForm.FrequencyCode, _scheduleForm.OutputFormat, _scheduleForm.DeliveryEmail));
            _showSchedule = false;
            await LoadAsync();
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Report scheduled for {_scheduleForm.DeliveryEmail}.", CssClass = "e-toast-success" });
        }
        catch (Exception ex)
        {
            _formError = $"Schedule failed: {ex.Message}";
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Schedule failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    private async Task ToggleScheduleAsync(ReportScheduleDto schedule)
    {
        try
        {
            await Api.SetReportScheduleStatusAsync(schedule.ReportScheduleId, !schedule.IsActive);
            await LoadAsync();
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = schedule.IsActive ? "Schedule paused." : "Schedule activated.", CssClass = "e-toast-success" });
        }
        catch (Exception ex)
        {
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Update failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    private async Task DeleteScheduleAsync(ReportScheduleDto schedule)
    {
        if (!await Confirmations.ConfirmAsync("Delete schedule", $"Delete scheduled delivery for {schedule.ReportName}?", "Delete")) return;
        try
        {
            await Api.DeleteReportScheduleAsync(schedule.ReportScheduleId);
            await LoadAsync();
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = "Schedule deleted.", CssClass = "e-toast-success" });
        }
        catch (Exception ex)
        {
            if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    private bool IsScheduled(Guid id) => _schedules.Any(s => s.ReportDefinitionId == id && s.IsActive);
    private string LastRunLabel(Guid id) => _executions.Where(e => e.ReportDefinitionId == id).OrderByDescending(e => e.CreatedDateUtc).FirstOrDefault()?.CreatedDateUtc.ToString("MMM d, yyyy") ?? "Never";
    private static string FormatBytes(long? bytes) => bytes is null ? "â€”" : bytes < 1024 * 1024 ? $"{bytes / 1024m:N1} KB" : $"{bytes / 1024m / 1024m:N1} MB";
    private static string PreviewCellCss(string dataType) => dataType is "Currency" or "Number" ? "rl-preview-num" : string.Empty;

    private RenderFragment KpiCard(string? filter, string icon, string label, string value, string color) => @<button type="button" class="rl-kpi-card @(_activeFilter == filter ? "pc-kpi-card--active" : "")" @onclick="() => SetKpiFilter(filter)">
        <div class="rl-kpi-icon @color"><i class="bi @icon" aria-hidden="true"></i></div>
        <div><div class="rl-kv">@value</div><div class="rl-kl">@label</div></div>
    </button>;

    private static string CatIcon(string c) => c switch
    {
        "Sales" => "bi-graph-up-arrow",
        "Policy" => "bi-shield-check",
        "Retention" => "bi-arrow-clockwise",
        "Claims" => "bi-exclamation-circle",
        "Finance" => "bi-bank",
        "Producer" => "bi-person-badge",
        "Marketing" => "bi-megaphone",
        "Compliance" => "bi-patch-check",
        _ => "bi-file-earmark-bar-graph"
    };

    private static string CatIconCss(string c) => c switch
    {
        "Claims" => "rl-ci-red",
        "Finance" or "Retention" => "rl-ci-green",
        "Producer" => "rl-ci-purple",
        "Marketing" => "rl-ci-amber",
        _ => "rl-ci-blue"
    };

    private static string CatBadge(string c) => c switch
    {
        "Claims" => "rl-badge rl-badge--red",
        "Finance" or "Retention" => "rl-badge rl-badge--green",
        "Producer" => "rl-badge rl-badge--purple",
        "Marketing" => "rl-badge rl-badge--amber",
        _ => "rl-badge rl-badge--blue"
    };

    private sealed class ScheduleForm
    {
        [Required] public Guid ReportDefinitionId { get; set; }
        [Required, StringLength(40)] public string FrequencyCode { get; set; } = "Weekly";
        [Required, StringLength(20)] public string OutputFormat { get; set; } = "PDF";
        [Required, EmailAddress, StringLength(254)] public string DeliveryEmail { get; set; } = "ops@agencybinder.local";
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
