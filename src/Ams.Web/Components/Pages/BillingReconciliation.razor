    private static List<RecException> BuildExceptions(List<RecRun> runs)
    {
        var exceptions = new List<RecException>();
        foreach (var run in runs.Where(r => r.Exceptions > 0))
        {
            for (var i = 1; i <= run.Exceptions; i++)
            {
                var type = i % 3 == 0 ? "Duplicate" : i % 2 == 0 ? "Missing Payment" : "Amount Mismatch";
                exceptions.Add(new(Guid.NewGuid(), run.Id, type, run.Carrier, run.RunDate.ToString("MMM yyyy"), $"{type} exception requires review for {run.Carrier}.", run.Variance / Math.Max(1, run.Exceptions)));
            }
        }
        return exceptions;
    }

    private static string NormalizeStatus(string status) => status switch { "Pending" => "In Progress", "Closed" => "Reconciled", _ => status };
    private static string Fmt(decimal v) => v.ToString("C0");
    private static string StatusCss(string status) => $"rec-st-{CssKey(status)}";
    private static string TypeCss(string type) => $"rec-typ-{CssKey(type)}";
    private static string ExceptionCss(string type) => $"rec-et-{CssKey(type)}";
    private static string StatusIconClass(string status) => status switch { "Reconciled" => "rec-di-green", "Pending Review" => "rec-di-amber", "Disputed" => "rec-di-red", _ => "rec-di-blue" };
    private static string CssKey(string value) => value.ToLowerInvariant().Replace(" ", "-").Replace("/", "-");
    private static string Csv(string value)
    {
        var quote = Convert.ToChar(34).ToString();
        return string.Concat(quote, value.Replace(quote, quote + quote), quote);
    }

