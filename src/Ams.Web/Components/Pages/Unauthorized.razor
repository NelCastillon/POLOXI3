@page "/unauthorized"

<PageTitle>Access denied</PageTitle>

<div class="unauth-page">
    <div class="unauth-card">
        <div class="unauth-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></div>
        <div>
            <h1>Access denied</h1>
            <p>Your current role or permissions do not allow access to this page. Contact your tenant administrator if you need additional access.</p>
            <div class="unauth-actions">
                <a class="um-btn um-btn-primary" href="/">Go home</a>
                <a class="um-btn um-btn-ghost" href="/auth/sign-out">Sign out</a>
            </div>
        </div>
    </div>
</div>
