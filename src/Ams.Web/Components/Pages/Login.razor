@page "/login"
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Sign in | AgencyBinder AMS Enterprise Platform</PageTitle>

<div class="login-shell">
    <section class="login-brand-panel" aria-label="AMS enterprise platform overview">
        <div class="login-brand-top">
            <div class="login-logo" aria-hidden="true">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
                <div class="login-brand-name">AGENCYBINDER AMS Enterprise</div>
                <div class="login-brand-kicker">Insurance operations platform</div>
            </div>
        </div>

        <div class="login-hero-copy">
            <span class="login-eyebrow"><i class="bi bi-stars" aria-hidden="true"></i> Enterprise SaaS workspace</span>
            <h1>Secure access for agencies, carriers, and service teams.</h1>
            <p>
                Manage CRM, policies, renewals, submissions, claims, commissions, billing, and governance from one trusted operating system.
            </p>
        </div>

        <div class="login-proof-grid" aria-label="Platform capabilities">
            <div class="login-proof-card">
                <i class="bi bi-building-check" aria-hidden="true"></i>
                <span>Tenant-aware</span>
                <strong>Isolated org context</strong>
            </div>
            <div class="login-proof-card">
                <i class="bi bi-person-lock" aria-hidden="true"></i>
                <span>IAM-ready</span>
                <strong>Roles & permissions</strong>
            </div>
            <div class="login-proof-card">
                <i class="bi bi-activity" aria-hidden="true"></i>
                <span>Operational</span>
                <strong>Real-time workbenches</strong>
            </div>
            <div class="login-proof-card">
                <i class="bi bi-journal-check" aria-hidden="true"></i>
                <span>Compliant</span>
                <strong>Audit trail support</strong>
            </div>
        </div>

        <div class="login-security-strip">
            <span><i class="bi bi-lock-fill" aria-hidden="true"></i> TLS protected</span>
            <span><i class="bi bi-cookie" aria-hidden="true"></i> Secure session cookie</span>
            <span><i class="bi bi-clock-history" aria-hidden="true"></i> Session timeout</span>
        </div>
    </section>

    <section class="login-form-panel" aria-label="Sign in">
        <div class="login-form-card">
            <div class="login-form-header">
                <div>
                    <div class="login-form-kicker">Welcome back</div>
                    <h2>Sign in to your workspace</h2>
                    <p>Use your organization code or domain and your enterprise account.</p>
                </div>
                <span class="login-secure-badge"><i class="bi bi-shield-check" aria-hidden="true"></i> Secure</span>
            </div>

            @if (_signedOut)
            {
                <div class="login-alert login-alert-success" role="status">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    You have been signed out securely.
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="login-alert login-alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    @_error
                </div>
            }

            <form method="post" action="/auth/sign-in" class="login-form" autocomplete="on">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@_returnUrl" />

                <div class="login-field">
                    <label for="tenant">Organization</label>
                    <div class="login-input-wrap">
                        <i class="bi bi-buildings" aria-hidden="true"></i>
                        <input id="tenant" name="Tenant" type="text" value="@_tenant" placeholder="enterprise.com or ENT-001" autocomplete="organization" required maxlength="253" />
                    </div>
                    <span class="login-field-hint">Use your tenant domain, code, or organization name.</span>
                </div>

                <div class="login-field">
                    <label for="email">Email or username</label>
                    <div class="login-input-wrap">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <input id="email" name="Email" type="email" value="@_email" placeholder="admin@enterprise.com" autocomplete="username" required maxlength="320" />
                    </div>
                </div>

                <div class="login-field">
                    <div class="login-label-row">
                        <label for="password">Password</label>
                        <a href="/password-recovery">Forgot password?</a>
                    </div>
                    <div class="login-input-wrap">
                        <i class="bi bi-key" aria-hidden="true"></i>
                        <input id="password" name="Password" type="password" placeholder="Enter your password" autocomplete="current-password" required maxlength="128" />
                    </div>
                </div>

                <div class="login-options-row">
                    <label class="login-check">
                        <input type="checkbox" name="RememberMe" value="true" />
                        <span>Keep me signed in</span>
                    </label>
                    <span class="login-options-note">Use only on trusted devices.</span>
                </div>

                <button type="submit" class="login-submit">
                    <span>Sign in</span>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </form>

            <div class="login-divider"><span>or</span></div>

            <div class="login-sso-grid">
                <button type="button" class="login-sso-btn" disabled title="SSO integration placeholder">
                    <i class="bi bi-microsoft" aria-hidden="true"></i>
                    Continue with Microsoft Entra ID
                </button>
                <button type="button" class="login-sso-btn" disabled title="SSO integration placeholder">
                    <i class="bi bi-key-fill" aria-hidden="true"></i>
                    Continue with SAML / OIDC
                </button>
            </div>

            <div class="login-footer-note">
                By signing in, you agree to your organization’s acceptable use, audit, and data protection policies.
            </div>
        </div>

        <div class="login-support-card">
            <div>
                <strong>Need access?</strong>
                <span>Create a tenant-scoped login account or contact your administrator.</span>
            </div>
            <a href="/register"><i class="bi bi-person-plus" aria-hidden="true"></i> Register</a>
        </div>
    </section>
</div>

@code {
    private string _tenant = string.Empty;
    private string _email = string.Empty;
    private string _error = string.Empty;
    private string _returnUrl = "/";
    private bool _signedOut;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo(GetSafeReturnUrl(), replace: true);
            return;
        }

        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        _tenant = query.TryGetValue("tenant", out var tenant) ? tenant.ToString() : string.Empty;
        _email = query.TryGetValue("email", out var email) ? email.ToString() : string.Empty;
        _error = query.TryGetValue("error", out var error) ? error.ToString() : string.Empty;
        _signedOut = query.TryGetValue("signedOut", out var signedOut) && string.Equals(signedOut.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        _returnUrl = GetSafeReturnUrl();
    }

    private string GetSafeReturnUrl()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        var returnUrl = query.TryGetValue("returnUrl", out var value) ? value.ToString() : "/";

        if (string.IsNullOrWhiteSpace(returnUrl) || !returnUrl.StartsWith("/", StringComparison.Ordinal) || returnUrl.StartsWith("//", StringComparison.Ordinal))
        {
            return "/";
        }

        return returnUrl;
    }
}
