@page "/iam/user-groups"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>User Groups</PageTitle>
<AppPageHeader Title="User Groups" Icon="bi-people" />
<div class="toolbar">
    <AppTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></AppTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
else {
<AppGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(UserGroupDto.GroupCode)"     HeaderText="Code"       Width="130"></GridColumn>
        <GridColumn Field="@nameof(UserGroupDto.GroupName)"     HeaderText="Name"       Width="220"></GridColumn>
        <GridColumn Field="@nameof(UserGroupDto.GroupTypeCode)" HeaderText="Type"       Width="130"></GridColumn>
        <GridColumn Field="@nameof(UserGroupDto.Description)"   HeaderText="Description" Width="260"></GridColumn>
        <GridColumn Field="@nameof(UserGroupDto.ManagerFullName)" HeaderText="Manager"  Width="180"></GridColumn>
        <GridColumn Field="@nameof(UserGroupDto.IsActive)"      HeaderText="Active"     Width="80" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(UserGroupDto.CreatedDateUtc)" HeaderText="Created"   Width="140"  Format="MM/dd/yyyy"></GridColumn>
    </GridColumns>
</AppGrid>
}
@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private Guid DefaultTenantId { get; set; }
    private string? _searchTerm;
    private List<UserGroupDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchUserGroupsAsync(DefaultTenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
