@page "/platform/configuration"
@inject ApiClient Api

<PageTitle>Platform Configuration</PageTitle>
<AppPageHeader Title="Configuration Settings" Icon="bi-gear" />
<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading...</span></div> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(ConfigurationSettingDto.ScopeCode)"    HeaderText="Scope"       Width="100"></GridColumn>
        <GridColumn Field="@nameof(ConfigurationSettingDto.SettingKey)"   HeaderText="Key"         Width="250"></GridColumn>
        <GridColumn Field="@nameof(ConfigurationSettingDto.SettingValue)" HeaderText="Value"       Width="150"></GridColumn>
        <GridColumn Field="@nameof(ConfigurationSettingDto.DataTypeCode)" HeaderText="Type"        Width="90"></GridColumn>
        <GridColumn Field="@nameof(ConfigurationSettingDto.ModuleCode)"   HeaderText="Module"      Width="100"></GridColumn>
        <GridColumn Field="@nameof(ConfigurationSettingDto.Description)"  HeaderText="Description" Width="280"></GridColumn>
        <GridColumn Field="@nameof(ConfigurationSettingDto.IsReadOnly)"   HeaderText="Read Only"   Width="90" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(ConfigurationSettingDto.IsEncrypted)"  HeaderText="Encrypted"   Width="90" DisplayAsCheckBox="true"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private string? _searchTerm;
    private List<ConfigurationSettingDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchConfigurationSettingsAsync(_searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
