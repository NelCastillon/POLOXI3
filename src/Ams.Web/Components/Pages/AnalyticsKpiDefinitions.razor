@page "/analytics/kpis"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>KPI Definitions ? AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<AppPageHeader Title="KPI Definitions"
               Subtitle="Define, configure, and manage the agency's key performance indicators ? what is measured and how"
               Icon="bi-speedometer2">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="OpenNew">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New KPI
        </button>
    </Actions>
</AppPageHeader>

<!-- Filter bar -->
<div class="kd-filter-bar">
    <div class="kd-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="kd-search" placeholder="Search KPIs?" @bind="_search" @bind:event="oninput" />
    </div>
    <select class="kd-sel" @bind="_domainFilter">
        <option value="">All Domains</option>
        <option value="Sales">Sales</option>
        <option value="Retention">Retention</option>
        <option value="Claims">Claims</option>
        <option value="Finance">Finance</option>
        <option value="Service">Service</option>
        <option value="Producer">Producer</option>
    </select>
</div>

<!-- KPI cards -->
<div class="kd-kpi-grid">
    @foreach (var kpi in Filtered)
    {
        <div class="kd-kpi-card @(kpi.IsActive ? "" : "kd-kpi-card--off")">
            <div class="kd-card-hdr">
                <div class="kd-card-icon @DomainCss(kpi.Domain)"><i class="bi @DomainIcon(kpi.Domain)" aria-hidden="true"></i></div>
                <span class="@DomainBadge(kpi.Domain)">@kpi.Domain</span>
                <label class="kd-toggle ms-auto">
                    <input type="checkbox" checked="@kpi.IsActive" @onchange="() => ToggleActiveAsync(kpi)" />
                    <span class="kd-toggle-sl"></span>
                </label>
            </div>
            <div class="kd-name">@kpi.Name</div>
            <div class="kd-desc">@kpi.Description</div>
            <div class="kd-formula-row">
                <span class="kd-formula-lbl">Formula:</span>
                <code class="kd-formula">@kpi.Formula</code>
            </div>
            <div class="kd-targets">
                <div class="kd-target"><span class="kd-tlbl">Target</span><span class="kd-tval kd-t-green">@kpi.Target</span></div>
                <div class="kd-target"><span class="kd-tlbl">Warning</span><span class="kd-tval kd-t-amber">@kpi.Warning</span></div>
                <div class="kd-target"><span class="kd-tlbl">Critical</span><span class="kd-tval kd-t-red">@kpi.Critical</span></div>
                <div class="kd-target"><span class="kd-tlbl">Direction</span><span class="kd-tval">@kpi.Direction</span></div>
            </div>
            <div class="kd-card-footer">
                <span class="kd-freq">@kpi.Frequency ?? @kpi.Owner</span>
                <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => EditKpi(kpi)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
            </div>
        </div>
    }
</div>

<!-- New / Edit KPI dialog -->
<SfDialog @bind-Visible="_showNew" Width="540px" IsModal="true" ShowCloseIcon="false">
    <DialogContent>
        <div class="um-modal-header"><i class="bi bi-speedometer2" aria-hidden="true"></i><span>@(_editKpi is null ? "New KPI" : "Edit KPI")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseKpi"><i class="bi bi-x-lg"></i></button></div>
        <EditForm EditContext="@_editContext">
            <DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field"><label>KPI name <span class="text-danger">*</span></label><InputText @bind-Value="_form.Name" class="um-input" /></div>
                <div class="um-field"><label>Domain</label><InputSelect @bind-Value="_form.Domain" class="um-input">@foreach (var o in _domainOpts){<option value="@o.V">@o.L</option>}</InputSelect></div>
                <div class="um-field um-field--full"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" /></div>
                <div class="um-field um-field--full"><label>Formula</label><InputText @bind-Value="_form.Formula" class="um-input" /></div>
                <div class="um-field"><label>Target</label><InputText @bind-Value="_form.Target" class="um-input" /></div>
                <div class="um-field"><label>Warning</label><InputText @bind-Value="_form.Warning" class="um-input" /></div>
                <div class="um-field"><label>Critical</label><InputText @bind-Value="_form.Critical" class="um-input" /></div>
                <div class="um-field"><label>Direction</label><InputSelect @bind-Value="_form.Direction" class="um-input">@foreach (var o in _dirOpts){<option value="@o.V">@o.L</option>}</InputSelect></div>
                <div class="um-field"><label>Frequency</label><InputSelect @bind-Value="_form.Frequency" class="um-input">@foreach (var o in _freqOpts){<option value="@o.V">@o.L</option>}</InputSelect></div>
                <div class="um-field"><label>Owner</label><InputText @bind-Value="_form.Owner" class="um-input" /></div>
            </div></div>
        </EditForm>
        <div class="um-modal-footer"><button class="um-btn um-btn-ghost" @onclick="CloseKpi">Cancel</button><button class="um-btn um-btn-primary" @onclick="CommitKpi"><i class="bi bi-check-lg" aria-hidden="true"></i> Save KPI</button></div>
    </DialogContent>
</SfDialog>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private EnterpriseToast? _toast;
    private Guid _tenantId;
    private string _search = string.Empty;
    private string _domainFilter = string.Empty;
    private bool _showNew;
    private KpiDef? _editKpi;
    private KpiForm _form = new();
    private EditContext _editContext = default!;

    private List<KpiDef> _kpis = [];

    private static readonly List<Lv> _domainOpts = [new("Sales","Sales"),new("Retention","Retention"),new("Claims","Claims"),new("Finance","Finance"),new("Service","Service"),new("Producer","Producer")];
    private static readonly List<Lv> _dirOpts    = [new("Higher is better","Higher is better"),new("Lower is better","Lower is better")];
    private static readonly List<Lv> _freqOpts   = [new("Daily","Daily"),new("Weekly","Weekly"),new("Monthly","Monthly"),new("Quarterly","Quarterly")];

    private IEnumerable<KpiDef> Filtered => _kpis.Where(k =>
        (string.IsNullOrEmpty(_search) || k.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_domainFilter) || k.Domain == _domainFilter));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        _editContext = new(_form);
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Analytics","/analytics/reports"), new("KPI Definitions",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var records = await Api.SearchDashboardRecordsAsync(_tenantId, "KpiDefinition");
        var recordItems = records?.Items.ToList() ?? [];
        _kpis = recordItems.Select(r => (Record: r, Kpi: System.Text.Json.JsonSerializer.Deserialize<DashboardKpiDefinitionDto>(r.JsonData, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web))!))
            .Select(x => new KpiDef { Id = x.Kpi.Id == Guid.Empty ? Guid.NewGuid() : x.Kpi.Id, RecordId = x.Record.Id, Name = x.Kpi.Name, Domain = x.Kpi.Domain, Description = x.Kpi.Description, Formula = x.Kpi.Formula, Target = x.Kpi.Target, Warning = x.Kpi.Warning, Critical = x.Kpi.Critical, Direction = x.Kpi.Direction, Frequency = x.Kpi.Frequency, Owner = x.Kpi.Owner, IsActive = x.Kpi.IsActive }).ToList();
    }

    private void OpenNew() { _form = new(); _editContext = new(_form); _editKpi = null; _showNew = true; }

    private void EditKpi(KpiDef k)
    {
        _editKpi = k;
        _form = new KpiForm { Name=k.Name, Domain=k.Domain, Description=k.Description, Formula=k.Formula, Target=k.Target, Warning=k.Warning, Critical=k.Critical, Direction=k.Direction, Frequency=k.Frequency, Owner=k.Owner };
        _editContext = new(_form);
        _showNew = true;
    }

    private async Task CommitKpi()
    {
        if (!_editContext.Validate()) return;
        var dto = new DashboardKpiDefinitionDto { Name = _form.Name, Domain = _form.Domain, Description = _form.Description, Formula = _form.Formula, Target = _form.Target, Warning = _form.Warning, Critical = _form.Critical, Direction = _form.Direction, Frequency = _form.Frequency, Owner = _form.Owner, IsActive = _editKpi?.IsActive ?? true };
        var json = System.Text.Json.JsonSerializer.Serialize(dto, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
        if (_editKpi is not null)
        {
            await Api.UpdateDashboardRecordAsync(_editKpi.RecordId, new UpsertDashboardRecordRequest(_tenantId, "KpiDefinition", _form.Name.ToLowerInvariant().Replace(" ", "-"), _form.Name, dto.IsActive ? "Active" : "Inactive", json));
        }
        else
        {
            await Api.CreateDashboardRecordAsync(new UpsertDashboardRecordRequest(_tenantId, "KpiDefinition", _form.Name.ToLowerInvariant().Replace(" ", "-"), _form.Name, "Active", json));
        }
        CloseKpi();
        await LoadAsync();
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = "KPI saved.", CssClass = "e-toast-success" });
    }

    private async Task ToggleActiveAsync(KpiDef kpi)
    {
        kpi.IsActive = !kpi.IsActive;
        var dto = new DashboardKpiDefinitionDto { Name = kpi.Name, Domain = kpi.Domain, Description = kpi.Description, Formula = kpi.Formula, Target = kpi.Target, Warning = kpi.Warning, Critical = kpi.Critical, Direction = kpi.Direction, Frequency = kpi.Frequency, Owner = kpi.Owner, IsActive = kpi.IsActive };
        await Api.UpdateDashboardRecordAsync(kpi.RecordId, new UpsertDashboardRecordRequest(_tenantId, "KpiDefinition", kpi.Name.ToLowerInvariant().Replace(" ", "-"), kpi.Name, kpi.IsActive ? "Active" : "Inactive", System.Text.Json.JsonSerializer.Serialize(dto, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web))));
    }

    private void CloseKpi() { _showNew = false; _editKpi = null; _form = new(); }

    private static string DomainIcon(string d) => d switch { "Sales"=>"bi-graph-up-arrow","Retention"=>"bi-arrow-clockwise","Claims"=>"bi-exclamation-circle","Finance"=>"bi-bank","Service"=>"bi-headset","Producer"=>"bi-person-badge",_=>"bi-speedometer" };
    private static string DomainCss(string d)  => d switch { "Sales"=>"kd-di-blue","Retention"=>"kd-di-green","Claims"=>"kd-di-red","Finance"=>"kd-di-green","Service"=>"kd-di-blue","Producer"=>"kd-di-purple",_=>"kd-di-blue" };
    private static string DomainBadge(string d)=> d switch { "Sales"=>"kd-dom kd-dom--sales","Retention"=>"kd-dom kd-dom--ret","Claims"=>"kd-dom kd-dom--claims","Finance"=>"kd-dom kd-dom--fin","Service"=>"kd-dom kd-dom--svc","Producer"=>"kd-dom kd-dom--prod",_=>"kd-dom" };

    private sealed class KpiDef { public Guid Id{get;set;} public Guid RecordId{get;set;} public string Name{get;set;}=string.Empty; public string Domain{get;set;}=string.Empty; public string Description{get;set;}=string.Empty; public string Formula{get;set;}=string.Empty; public string Target{get;set;}=string.Empty; public string Warning{get;set;}=string.Empty; public string Critical{get;set;}=string.Empty; public string Direction{get;set;}="Higher is better"; public string Frequency{get;set;}=string.Empty; public string Owner{get;set;}=string.Empty; public bool IsActive{get;set;}=true; }
    private sealed class KpiForm { [Required, StringLength(200)] public string Name{get;set;}=string.Empty; [Required, StringLength(80)] public string Domain{get;set;}="Sales"; [StringLength(1000)] public string Description{get;set;}=string.Empty; [Required, StringLength(500)] public string Formula{get;set;}=string.Empty; [StringLength(80)] public string Target{get;set;}=string.Empty; [StringLength(80)] public string Warning{get;set;}=string.Empty; [StringLength(80)] public string Critical{get;set;}=string.Empty; [Required, StringLength(40)] public string Direction{get;set;}="Higher is better"; [Required, StringLength(40)] public string Frequency{get;set;}="Monthly"; [StringLength(120)] public string Owner{get;set;}=string.Empty; }
    private sealed record Lv(string V, string L);

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
