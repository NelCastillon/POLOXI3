@page "/communications/outreach"
@page "/communications/outreachs"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Tenant Outreach Control Center — AMS</PageTitle>

@if (_toast is not null)
{
    <div class="oq-toast @_toast.CssClass" role="status">
        <strong>@_toast.Title</strong>
        <span>@_toast.Message</span>
        <button type="button" class="oq-icon-btn" @onclick="() => _toast = null" aria-label="Dismiss toast"><i class="bi bi-x-lg"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="oq-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="oq-modal" role="dialog" aria-modal="true" aria-labelledby="oq-form-title" @onclick:stopPropagation="true">
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header">
                    <i class="bi bi-telephone-outbound" aria-hidden="true"></i>
                    <span id="oq-form-title">@(_form.Id == Guid.Empty ? "Create Outreach Record" : "Edit Outreach Record")</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field"><label>Account Name *</label><InputText class="um-input" @bind-Value="_form.AccountName" /><ValidationMessage For="() => _form.AccountName" class="text-danger" /></div>
                        <div class="um-field"><label>Contact Name *</label><InputText class="um-input" @bind-Value="_form.ContactName" /><ValidationMessage For="() => _form.ContactName" class="text-danger" /></div>
                        <div class="um-field"><label>Email</label><InputText class="um-input" @bind-Value="_form.Email" /><ValidationMessage For="() => _form.Email" class="text-danger" /></div>
                        <div class="um-field"><label>Phone</label><InputText class="um-input" @bind-Value="_form.Phone" /><ValidationMessage For="() => _form.Phone" class="text-danger" /></div>
                        <div class="um-field"><label>Reason *</label><InputSelect class="um-input" @bind-Value="_form.Reason"><option value="">Select reason</option>@foreach (var reason in _reasons) { <option>@reason</option> }</InputSelect><ValidationMessage For="() => _form.Reason" class="text-danger" /></div>
                        <div class="um-field"><label>Priority *</label><InputSelect class="um-input" @bind-Value="_form.Priority">@foreach (var priority in _priorities) { <option>@priority</option> }</InputSelect><ValidationMessage For="() => _form.Priority" class="text-danger" /></div>
                        <div class="um-field"><label>Status *</label><InputSelect class="um-input" @bind-Value="_form.Status">@foreach (var status in _statuses) { <option>@status</option> }</InputSelect><ValidationMessage For="() => _form.Status" class="text-danger" /></div>
                        <div class="um-field"><label>Assigned To</label><InputSelect class="um-input" @bind-Value="_form.AssignedTo"><option value="">Unassigned</option>@foreach (var agent in Agents) { <option>@agent</option> }</InputSelect><ValidationMessage For="() => _form.AssignedTo" class="text-danger" /></div>
                        <div class="um-field"><label>Producer</label><InputSelect class="um-input" @bind-Value="_form.Producer"><option value="">Select producer</option>@foreach (var agent in Agents) { <option>@agent</option> }</InputSelect><ValidationMessage For="() => _form.Producer" class="text-danger" /></div>
                        <div class="um-field"><label>Branch</label><InputText class="um-input" @bind-Value="_form.Branch" /><ValidationMessage For="() => _form.Branch" class="text-danger" /></div>
                        <div class="um-field"><label>Next Contact</label><InputDate class="um-input" @bind-Value="_form.NextContactDate" /><ValidationMessage For="() => _form.NextContactDate" class="text-danger" /></div>
                        <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.OptedOut" /> Opted out</label><ValidationMessage For="() => _form.OptedOut" class="text-danger" /></div>
                        <div class="um-field um-field-full"><label>Notes</label><InputTextArea class="um-input" @bind-Value="_form.Notes" /><ValidationMessage For="() => _form.Notes" class="text-danger" /></div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_actionBusy"><i class="bi bi-check-lg"></i> Save Outreach</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showLog && _selected is not null)
{
    <div class="oq-modal-backdrop" role="presentation" @onclick="CloseLog">
        <div class="oq-modal oq-modal-sm" role="dialog" aria-modal="true" aria-labelledby="oq-log-title" @onclick:stopPropagation="true">
            <EditForm Model="_logForm" OnValidSubmit="SaveLogAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header"><i class="bi bi-telephone" aria-hidden="true"></i><span id="oq-log-title">Log Contact Attempt</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseLog"><i class="bi bi-x-lg"></i></button></div>
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field um-field-full"><label>Outcome *</label><InputSelect class="um-input" @bind-Value="_logForm.Outcome"><option value="">Select outcome</option>@foreach (var outcome in _outcomes) { <option>@outcome</option> }</InputSelect><ValidationMessage For="() => _logForm.Outcome" class="text-danger" /></div>
                    <div class="um-field"><label>Next Action</label><InputSelect class="um-input" @bind-Value="_logForm.NextAction"><option>None</option>@foreach (var action in _nextActions) { <option>@action</option> }</InputSelect><ValidationMessage For="() => _logForm.NextAction" class="text-danger" /></div>
                    <div class="um-field"><label>Next Contact</label><InputDate class="um-input" @bind-Value="_logForm.NextContactDate" /><ValidationMessage For="() => _logForm.NextContactDate" class="text-danger" /></div>
                    <div class="um-field um-field-full"><label>Notes</label><InputTextArea class="um-input" @bind-Value="_logForm.Notes" /><ValidationMessage For="() => _logForm.Notes" class="text-danger" /></div>
                </div></div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseLog" disabled="@_actionBusy">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_actionBusy"><i class="bi bi-check-lg"></i> Log Attempt</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showAssign)
{
    <div class="oq-modal-backdrop" role="presentation" @onclick="CloseAssign">
        <div class="oq-modal oq-modal-sm" role="dialog" aria-modal="true" aria-labelledby="oq-assign-title" @onclick:stopPropagation="true">
            <EditForm Model="_assignForm" OnValidSubmit="AskAssignAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header"><i class="bi bi-person-check" aria-hidden="true"></i><span id="oq-assign-title">Assign Outreach Records</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseAssign"><i class="bi bi-x-lg"></i></button></div>
                <div class="um-modal-body"><div class="um-form-grid"><div class="um-field um-field-full"><label>Assign To *</label><InputSelect class="um-input" @bind-Value="_assignForm.AssignedTo"><option value="">Select owner</option>@foreach (var agent in Agents) { <option>@agent</option> }</InputSelect><ValidationMessage For="() => _assignForm.AssignedTo" class="text-danger" /></div><div class="oq-modal-note"><strong>@_selectedIds.Count</strong> selected record(s) will be reassigned after confirmation.</div></div></div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseAssign" disabled="@_actionBusy">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_actionBusy"><i class="bi bi-person-check"></i> Continue</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showSms)
{
    <div class="oq-modal-backdrop" role="presentation" @onclick="CloseSms">
        <div class="oq-modal oq-modal-sm" role="dialog" aria-modal="true" aria-labelledby="oq-sms-title" @onclick:stopPropagation="true">
            <EditForm Model="_smsForm" OnValidSubmit="AskSmsAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header"><i class="bi bi-phone" aria-hidden="true"></i><span id="oq-sms-title">Batch SMS Outreach</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseSms"><i class="bi bi-x-lg"></i></button></div>
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field um-field-full"><label>Template</label><InputSelect class="um-input" @bind-Value="_smsForm.TemplateName"><option value="">No template</option>@foreach (var template in _smsTemplates) { <option>@template</option> }</InputSelect><ValidationMessage For="() => _smsForm.TemplateName" class="text-danger" /></div>
                    <div class="um-field um-field-full"><label>Message *</label><InputTextArea class="um-input" @bind-Value="_smsForm.Message" /><ValidationMessage For="() => _smsForm.Message" class="text-danger" /><div class="oq-char-count @(_smsForm.Message.Length > 160 ? "oq-char-warn" : string.Empty)">@_smsForm.Message.Length / 160 chars</div></div>
                    <div class="um-field um-field-full um-field--checkbox"><label><InputCheckbox @bind-Value="_smsForm.TcpaConsentConfirmed" /> TCPA consent confirmed for selected recipients</label><ValidationMessage For="() => _smsForm.TcpaConsentConfirmed" class="text-danger" /></div>
                    <div class="um-field um-field-full um-field--checkbox"><label><InputCheckbox @bind-Value="_smsForm.HonorOptOut" /> Honor opt-outs automatically</label><ValidationMessage For="() => _smsForm.HonorOptOut" class="text-danger" /></div>
                </div></div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseSms" disabled="@_actionBusy">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_actionBusy"><i class="bi bi-send"></i> Continue</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_confirm is not null)
{
    <div class="oq-modal-backdrop" role="presentation" @onclick="CloseConfirm">
        <div class="oq-modal oq-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="oq-confirm-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog"><div class="um-confirm-icon @(_confirm.Danger ? "um-confirm-icon--danger" : string.Empty)"><i class="bi @_confirm.Icon" aria-hidden="true"></i></div><div><h3 id="oq-confirm-title">@_confirm.Title</h3><p>@_confirm.Message</p></div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseConfirm" disabled="@_actionBusy">Cancel</button><button type="button" class="um-btn @(_confirm.Danger ? "um-btn-danger" : "um-btn-primary")" @onclick="ExecuteConfirmAsync" disabled="@_actionBusy"><i class="bi @_confirm.Icon"></i> @_confirm.ButtonText</button></div>
        </div>
    </div>
}

<section class="oq-page">
    <div class="oq-hero">
        <div class="oq-hero-left"><div class="oq-hero-icon"><i class="bi bi-broadcast-pin" aria-hidden="true"></i></div><div><div class="oq-eyebrow">Tenant Communications · Outreach Governance</div><div class="oq-title-row"><h1>Tenant Outreach Control Center</h1><span>@Filtered.Count() synced records</span></div><p>Prioritize client outreach, assign ownership, log contact attempts, enforce consent, sync batch SMS activity, and close follow-ups from one tenant control plane.</p><div class="oq-hero-chips"><span><i class="bi bi-bullseye"></i>@ReachRate.ToString("0")% reach rate</span><span><i class="bi bi-exclamation-triangle"></i>@OverdueCount overdue</span><span><i class="bi bi-arrow-repeat"></i>@LastSyncLabel</span></div></div></div>
        <div class="oq-hero-actions"><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/inbox")'><i class="bi bi-inbox"></i> Inbox</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/appointments")'><i class="bi bi-calendar-event"></i> Appointments</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/templates")'><i class="bi bi-layout-text-sidebar"></i> Templates</button><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New Outreach</button></div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger oq-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div>
    }

    <div class="oq-kpi-strip">
        @Kpi("all", "bi-list-task", "Total Queue", _items.Count.ToString(), "oq-ki-blue")
        @Kpi("due", "bi-alarm", "Due Today", DueTodayCount.ToString(), "oq-ki-amber")
        @Kpi("overdue", "bi-hourglass-split", "Overdue", OverdueCount.ToString(), "oq-ki-red")
        @Kpi("contacted", "bi-telephone-outbound", "Contacted", _items.Count(x => x.Attempts > 0).ToString(), "oq-ki-cyan")
        @Kpi("completed", "bi-check2-all", "Completed", _items.Count(x => x.Status == "Completed").ToString(), "oq-ki-green")
        @Kpi("unassigned", "bi-person-x", "Unassigned", _items.Count(x => string.IsNullOrWhiteSpace(x.AssignedTo)).ToString(), "oq-ki-purple")
    </div>

    <div class="oq-toolbar">
        <div class="oq-search-wrap"><i class="bi bi-search" aria-hidden="true"></i><input class="oq-search" @bind="_search" @bind:event="oninput" placeholder="Search accounts, contacts, reasons…" /></div>
        <select class="oq-sel" @bind="_reasonFilter"><option value="">All Reasons</option>@foreach (var reason in _reasons) { <option>@reason</option> }</select>
        <select class="oq-sel" @bind="_statusFilter"><option value="">All Status</option>@foreach (var status in _statuses) { <option>@status</option> }</select>
        <select class="oq-sel" @bind="_priorityFilter"><option value="">All Priority</option>@foreach (var priority in _priorities) { <option>@priority</option> }</select>
        <select class="oq-sel" @bind="_assignedFilter"><option value="">All Owners</option>@foreach (var owner in Agents) { <option>@owner</option> }</select>
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-x"></i> Clear</button>
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </div>

    <div class="oq-action-bar">
        <span><strong>@Filtered.Count()</strong> visible · <strong>@_selectedIds.Count</strong> selected</span>
        <div>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenAssign" disabled="@(!_selectedIds.Any())"><i class="bi bi-person-check"></i> Assign</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenSms" disabled="@(!_selectedIds.Any())"><i class="bi bi-phone"></i> Batch SMS</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="AskBatchComplete" disabled="@(!_selectedIds.Any())"><i class="bi bi-check2-all"></i> Complete</button>
        </div>
    </div>

    <div class="oq-layout">
        <section class="oq-list-panel">
            @if (_loading)
            {
                <div class="oq-empty"><i class="bi bi-arrow-repeat oq-spin"></i><span>Loading tenant outreach…</span></div>
            }
            else if (!Filtered.Any())
            {
                <div class="oq-empty"><i class="bi bi-inbox"></i><span>No outreach records match this view.</span></div>
            }
            else
            {
                <div class="oq-list-head"><label><input type="checkbox" checked="@(Filtered.Any() && _selectedIds.Count == Filtered.Count())" @onchange="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => OnToggleAll(e.Value))" /> Select visible</label><span>@_kpiFilterLabel</span></div>
                @foreach (var item in Filtered.OrderBy(PriorityOrder).ThenBy(x => x.NextContactDate ?? DateTime.MaxValue))
                {
                    <article class="oq-row @(_selected?.Id == item.Id ? "oq-row-active" : string.Empty) @(IsOverdue(item) ? "oq-row-risk" : string.Empty)" @onclick="() => Select(item)">
                        <input type="checkbox" checked="@_selectedIds.Contains(item.Id)" @onclick:stopPropagation="true" @onchange="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => ToggleRow(item.Id, e.Value))" />
                        <div class="oq-row-main"><div class="oq-row-title"><strong>@item.AccountName</strong><span class="oq-pri oq-pri-@Css(item.Priority)">@item.Priority</span></div><div class="oq-row-meta"><span><i class="bi bi-person"></i>@item.ContactName</span><span><i class="bi bi-tag"></i>@item.Reason</span></div><div class="oq-row-meta"><span><i class="bi bi-headset"></i>@(string.IsNullOrWhiteSpace(item.AssignedTo) ? "Unassigned" : item.AssignedTo)</span><span><i class="bi bi-calendar2"></i>@FormatDate(item.NextContactDate)</span></div></div>
                        <span class="oq-status oq-st-@Css(item.Status)">@item.Status</span>
                    </article>
                }
            }
        </section>

        <aside class="oq-detail-panel">
            @if (_selected is null)
            {
                <div class="oq-detail-empty"><i class="bi bi-broadcast"></i><h2>Select an outreach record</h2><p>Review account context, contact history, sync status, and action controls.</p></div>
            }
            else
            {
                <div class="oq-detail-header"><div><span class="oq-eyebrow">@_selected.Reason</span><h2>@_selected.AccountName</h2><p>@_selected.ContactName · @_selected.Phone · @_selected.Email</p></div><span class="oq-status oq-st-@Css(_selected.Status)">@_selected.Status</span></div>
                <div class="oq-command-strip"><button class="um-btn um-btn-primary" @onclick="() => OpenLog(_selected)" disabled="@(_selected.OptedOut || _selected.Status == "Completed")"><i class="bi bi-telephone-outbound"></i> Log Attempt</button><button class="um-btn um-btn-ghost" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil"></i> Edit</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/appointments")'><i class="bi bi-calendar-plus"></i> Appointment</button><button class="um-btn um-btn-danger" @onclick="() => AskDelete(_selected)"><i class="bi bi-trash"></i> Delete</button></div>
                <div class="oq-detail-grid"><div><span>Priority</span><strong>@_selected.Priority</strong></div><div><span>Owner</span><strong>@(string.IsNullOrWhiteSpace(_selected.AssignedTo) ? "Unassigned" : _selected.AssignedTo)</strong></div><div><span>Producer</span><strong>@NullDash(_selected.Producer)</strong></div><div><span>Branch</span><strong>@NullDash(_selected.Branch)</strong></div><div><span>Attempts</span><strong>@_selected.Attempts</strong></div><div><span>Last Contact</span><strong>@FormatDate(_selected.LastContactDate)</strong></div><div><span>Next Contact</span><strong>@FormatDate(_selected.NextContactDate)</strong></div><div><span>Sync</span><strong>@_selected.SyncStatus</strong></div></div>
                <div class="oq-notes"><h3>Latest Outcome</h3><p>@NullDash(_selected.LastOutcome)</p><h3>Notes</h3><p>@NullDash(_selected.Notes)</p></div>
            }
        </aside>
    </div>
</section>

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading;
    private bool _actionBusy;
    private bool _showForm;
    private bool _showLog;
    private bool _showAssign;
    private bool _showSms;
    private string? _loadError;
    private string _search = string.Empty;
    private string _reasonFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private string _priorityFilter = string.Empty;
    private string _assignedFilter = string.Empty;
    private string _kpiFilter = "all";
    private string _kpiFilterLabel = "All outreach";
    private OutreachItem? _selected;
    private ToastState? _toast;
    private ConfirmState? _confirm;
    private readonly HashSet<Guid> _selectedIds = [];
    private List<OutreachItem> _items = [];
    private OutreachForm _form = new();
    private LogForm _logForm = new();
    private AssignForm _assignForm = new();
    private SmsForm _smsForm = new();

    private readonly string[] _reasons = ["Renewal — 90 Days", "Renewal — 60 Days", "Renewal — 30 Days", "At-Risk / Cancellation", "Non-Payment", "New Business Follow-Up", "Claims Follow-Up", "CAT Outreach", "Win-Back", "Coverage Gap Identified", "Audit Due", "Certificate Expiring", "General Follow-Up"];
    private readonly string[] _priorities = ["Critical", "High", "Medium", "Low"];
    private readonly string[] _statuses = ["Open", "In Progress", "Completed", "Deferred", "Opted Out"];
    private readonly string[] _outcomes = ["Reached — Completed", "Reached — Call Back Requested", "No Answer — Voicemail Left", "No Answer — No Voicemail", "Line Disconnected", "Wrong Number", "Opted Out", "Referred to Producer"];
    private readonly string[] _nextActions = ["Call Again Tomorrow", "Call Again This Week", "Send Email Follow-Up", "Send SMS", "Schedule Meeting", "Assign to Producer", "Remove from Queue"];
    private readonly string[] _smsTemplates = ["Renewal Reminder", "Payment Due", "CAT Check-In", "Coverage Review", "Win-Back Offer"];

    private IEnumerable<string> Agents => _items.SelectMany(x => new[] { x.AssignedTo, x.Producer }).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x => x).DefaultIfEmpty("Sarah Kim");
    private IEnumerable<OutreachItem> Filtered => _items.Where(MatchesFilters).Where(MatchesKpi);
    private int DueTodayCount => _items.Count(x => x.NextContactDate?.Date <= DateTime.Today && x.Status == "Open");
    private int OverdueCount => _items.Count(IsOverdue);
    private decimal ReachRate => _items.Count == 0 ? 0 : _items.Count(x => x.LastOutcome.StartsWith("Reached", StringComparison.OrdinalIgnoreCase)) * 100m / _items.Count;
    private string LastSyncLabel => _items.Count == 0 ? "Ready" : $"Synced {FormatAge(_items.Max(x => x.LastSyncedDateUtc ?? x.CreatedDateUtc))}";

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Communications", "/communications/inbox"), new("Outreach", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchCommunicationOutreachAsync(_tenantId, _search);
            _items = result?.Items.Select(OutreachItem.FromDto).ToList() ?? [];
            _selectedIds.RemoveWhere(id => _items.All(x => x.Id != id));
            _selected = _selected is null ? _items.FirstOrDefault() : _items.FirstOrDefault(x => x.Id == _selected.Id) ?? _items.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load outreach queue: {ex.Message}";
            ShowToast("Load failed", _loadError, true);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool MatchesFilters(OutreachItem item) =>
        (string.IsNullOrWhiteSpace(_search) || item.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.ContactName.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.Reason.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_reasonFilter) || item.Reason == _reasonFilter) &&
        (string.IsNullOrWhiteSpace(_statusFilter) || item.Status == _statusFilter) &&
        (string.IsNullOrWhiteSpace(_priorityFilter) || item.Priority == _priorityFilter) &&
        (string.IsNullOrWhiteSpace(_assignedFilter) || item.AssignedTo == _assignedFilter);

    private bool MatchesKpi(OutreachItem item) => _kpiFilter switch
    {
        "due" => item.NextContactDate?.Date <= DateTime.Today && item.Status == "Open",
        "overdue" => IsOverdue(item),
        "contacted" => item.Attempts > 0,
        "completed" => item.Status == "Completed",
        "unassigned" => string.IsNullOrWhiteSpace(item.AssignedTo),
        _ => true
    };

    private void SetKpi(string filter, string label) { _kpiFilter = filter; _kpiFilterLabel = label; _selected = Filtered.FirstOrDefault(); }
    private void Select(OutreachItem item) => _selected = item;
    private void ResetFilters() { _search = string.Empty; _reasonFilter = string.Empty; _statusFilter = string.Empty; _priorityFilter = string.Empty; _assignedFilter = string.Empty; SetKpi("all", "All outreach"); }
    private void OpenCreate() { _form = new(); _showForm = true; }
    private void OpenEdit(OutreachItem item) { _form = OutreachForm.From(item); _showForm = true; }
    private void CloseForm() => _showForm = false;
    private void OpenLog(OutreachItem item) { _selected = item; _logForm = new(); _showLog = true; }
    private void CloseLog() => _showLog = false;
    private void OpenAssign() { _assignForm = new(); _showAssign = true; }
    private void CloseAssign() => _showAssign = false;
    private void OpenSms() { _smsForm = new(); _showSms = true; }
    private void CloseSms() => _showSms = false;
    private void CloseConfirm() => _confirm = null;

    private async Task SaveAsync()
    {
        try
        {
            _actionBusy = true;
            if (_form.Id == Guid.Empty)
            {
                var id = await Api.CreateCommunicationOutreachAsync(_form.ToRequest(_tenantId));
                ShowToast("Created", "Outreach record created.");
                _selected = null;
            }
            else
            {
                await Api.UpdateCommunicationOutreachAsync(_form.Id, _form.ToRequest(_tenantId));
                ShowToast("Updated", "Outreach record updated.");
            }
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast("Save failed", $"Save failed: {ex.Message}", true);
        }
        finally { _actionBusy = false; }
    }

    private async Task SaveLogAsync()
    {
        if (_selected is null) return;
        try
        {
            _actionBusy = true;
            await Api.LogCommunicationOutreachAttemptAsync(_tenantId, _selected.Id, new OutreachLogAttemptRequest(_logForm.Outcome, _logForm.NextAction, _logForm.NextContactDate, _logForm.Notes));
            _showLog = false;
            ShowToast("Logged", "Contact attempt logged and synced.");
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast("Log failed", $"Log failed: {ex.Message}", true); }
        finally { _actionBusy = false; }
    }

    private Task AskAssignAsync()
    {
        _confirm = new("Confirm Assignment", $"Assign {_selectedIds.Count} outreach record(s) to {_assignForm.AssignedTo}?", "Assign", "bi-person-check", false, ExecuteAssignAsync);
        _showAssign = false;
        return Task.CompletedTask;
    }

    private Task AskSmsAsync()
    {
        _confirm = new("Confirm Batch SMS", $"Send SMS to {_selectedIds.Count} selected outreach record(s)? Opt-outs will {(_smsForm.HonorOptOut ? "be honored" : "not be excluded") }.", "Send SMS", "bi-send", false, ExecuteSmsAsync);
        _showSms = false;
        return Task.CompletedTask;
    }

    private void AskBatchComplete() => _confirm = new("Mark Outreach Complete", $"Mark {_selectedIds.Count} selected outreach record(s) complete?", "Complete", "bi-check2-all", false, ExecuteBatchCompleteAsync);
    private void AskDelete(OutreachItem item) { _selected = item; _confirm = new("Delete Outreach Record", $"Remove {item.AccountName} from the active outreach queue?", "Delete", "bi-trash", true, ExecuteDeleteAsync); }

    private async Task ExecuteConfirmAsync()
    {
        if (_confirm is null) return;
        await _confirm.Action();
        _confirm = null;
    }

    private async Task ExecuteAssignAsync()
    {
        try
        {
            _actionBusy = true;
            await Api.AssignCommunicationOutreachAsync(_tenantId, new OutreachAssignRequest(_selectedIds.ToArray(), _assignForm.AssignedTo));
            var count = _selectedIds.Count;
            _selectedIds.Clear();
            ShowToast("Assigned", $"{count} outreach record(s) assigned.");
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast("Assign failed", $"Assign failed: {ex.Message}", true); }
        finally { _actionBusy = false; }
    }

    private async Task ExecuteSmsAsync()
    {
        try
        {
            _actionBusy = true;
            await Api.SendCommunicationOutreachBatchSmsAsync(_tenantId, new OutreachBatchSmsRequest(_selectedIds.ToArray(), _smsForm.Message, _smsForm.TemplateName, _smsForm.TcpaConsentConfirmed, _smsForm.HonorOptOut));
            var count = _selectedIds.Count;
            _selectedIds.Clear();
            ShowToast("SMS synced", $"Batch SMS activity synced for {count} record(s).");
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast("SMS failed", $"SMS failed: {ex.Message}", true); }
        finally { _actionBusy = false; }
    }

    private async Task ExecuteBatchCompleteAsync()
    {
        try
        {
            _actionBusy = true;
            foreach (var id in _selectedIds.ToArray())
            {
                await Api.UpdateCommunicationOutreachStatusAsync(_tenantId, id, new OutreachStatusRequest("Completed", "Batch completed from Tenant Outreach Control Center."));
            }
            var count = _selectedIds.Count;
            _selectedIds.Clear();
            ShowToast("Completed", $"{count} outreach record(s) completed.");
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast("Complete failed", $"Complete failed: {ex.Message}", true); }
        finally { _actionBusy = false; }
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_selected is null) return;
        try
        {
            _actionBusy = true;
            await Api.DeleteCommunicationOutreachAsync(_tenantId, _selected.Id);
            ShowToast("Deleted", "Outreach record removed.");
            _selected = null;
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast("Delete failed", $"Delete failed: {ex.Message}", true); }
        finally { _actionBusy = false; }
    }

    private void ToggleRow(Guid id, object? value) { if (IsChecked(value)) _selectedIds.Add(id); else _selectedIds.Remove(id); }
    private void OnToggleAll(object? value) { if (IsChecked(value)) foreach (var item in Filtered) _selectedIds.Add(item.Id); else _selectedIds.Clear(); }
    private static bool IsChecked(object? value) => value is bool selected && selected;
    private void ShowToast(string title, string message, bool danger = false) => _toast = new(title, message, danger ? "oq-toast-danger" : "oq-toast-success");

    private RenderFragment Kpi(string filter, string icon, string label, string value, string color) => @<button type="button" class="oq-kpi-card @color @(_kpiFilter == filter ? "oq-kpi-active" : string.Empty)" title="Filter by @label" @onclick="() => SetKpi(filter, label)"><span class="oq-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span><span><span class="oq-kpi-label">@label</span><strong class="oq-kpi-value">@value</strong></span></button>;

    private static bool IsOverdue(OutreachItem item) => item.NextContactDate?.Date < DateTime.Today && item.Status == "Open";
    private static int PriorityOrder(OutreachItem item) => item.Priority switch { "Critical" => 0, "High" => 1, "Medium" => 2, _ => 3 };
    private static string Css(string value) => value.ToLowerInvariant().Replace(" ", "-").Replace("/", "");
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("MMM d, yyyy") : "—";
    private static string NullDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string FormatAge(DateTime value) { var span = DateTime.UtcNow - value.ToUniversalTime(); if (span.TotalMinutes < 60) return $"{Math.Max(0, (int)span.TotalMinutes)}m ago"; if (span.TotalDays < 1) return "today"; return $"{(int)span.TotalDays}d ago"; }

    private sealed record ToastState(string Title, string Message, string CssClass);
    private sealed record ConfirmState(string Title, string Message, string ButtonText, string Icon, bool Danger, Func<Task> Action);

    private sealed class OutreachItem
    {
        public Guid Id { get; set; }
        public string AccountName { get; set; } = string.Empty;
        public string ContactName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Reason { get; set; } = string.Empty;
        public string Priority { get; set; } = "Medium";
        public string AssignedTo { get; set; } = string.Empty;
        public string Producer { get; set; } = string.Empty;
        public string Branch { get; set; } = string.Empty;
        public string Status { get; set; } = "Open";
        public string LastOutcome { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
        public int Attempts { get; set; }
        public bool OptedOut { get; set; }
        public DateTime? LastContactDate { get; set; }
        public DateTime? NextContactDate { get; set; }
        public string SyncStatus { get; set; } = string.Empty;
        public DateTime? LastSyncedDateUtc { get; set; }
        public DateTime CreatedDateUtc { get; set; }
        public static OutreachItem FromDto(CommunicationOutreachContactDto dto) => new() { Id = dto.OutreachContactId, AccountName = dto.AccountName, ContactName = dto.ContactName, Email = dto.Email, Phone = dto.Phone, Reason = dto.Reason, Priority = dto.Priority, AssignedTo = dto.AssignedTo, Producer = dto.Producer, Branch = dto.Branch, Status = dto.Status, LastOutcome = dto.LastOutcome, Notes = dto.Notes, Attempts = dto.Attempts, OptedOut = dto.OptedOut, LastContactDate = dto.LastContactDate, NextContactDate = dto.NextContactDate, SyncStatus = dto.SyncStatus, LastSyncedDateUtc = dto.LastSyncedDateUtc, CreatedDateUtc = dto.CreatedDateUtc };
    }

    private sealed class OutreachForm
    {
        public Guid Id { get; set; }
        [Required, StringLength(200)] public string AccountName { get; set; } = string.Empty;
        [Required, StringLength(160)] public string ContactName { get; set; } = string.Empty;
        [EmailAddress, StringLength(254)] public string Email { get; set; } = string.Empty;
        [StringLength(50)] public string Phone { get; set; } = string.Empty;
        [Required, StringLength(120)] public string Reason { get; set; } = string.Empty;
        [Required, StringLength(40)] public string Priority { get; set; } = "Medium";
        [StringLength(160)] public string AssignedTo { get; set; } = string.Empty;
        [StringLength(160)] public string Producer { get; set; } = string.Empty;
        [StringLength(120)] public string Branch { get; set; } = string.Empty;
        [Required, StringLength(50)] public string Status { get; set; } = "Open";
        [StringLength(2000)] public string Notes { get; set; } = string.Empty;
        public bool OptedOut { get; set; }
        public DateTime? NextContactDate { get; set; }
        public static OutreachForm From(OutreachItem item) => new() { Id = item.Id, AccountName = item.AccountName, ContactName = item.ContactName, Email = item.Email, Phone = item.Phone, Reason = item.Reason, Priority = item.Priority, AssignedTo = item.AssignedTo, Producer = item.Producer, Branch = item.Branch, Status = item.Status, Notes = item.Notes, OptedOut = item.OptedOut, NextContactDate = item.NextContactDate };
        public UpsertCommunicationOutreachRequest ToRequest(Guid tenantId) => new() { OutreachContactId = Id, TenantId = tenantId, AccountName = AccountName, ContactName = ContactName, Email = Email, Phone = Phone, Reason = Reason, Priority = Priority, AssignedTo = AssignedTo, Producer = Producer, Branch = Branch, Status = Status, Notes = Notes, OptedOut = OptedOut, NextContactDate = NextContactDate };
    }

    private sealed class LogForm
    {
        [Required, StringLength(160)] public string Outcome { get; set; } = string.Empty;
        [StringLength(160)] public string NextAction { get; set; } = "None";
        public DateTime? NextContactDate { get; set; }
        [StringLength(2000)] public string Notes { get; set; } = string.Empty;
    }

    private sealed class AssignForm { [Required, StringLength(160)] public string AssignedTo { get; set; } = string.Empty; }

    private sealed class SmsForm
    {
        [StringLength(160)] public string TemplateName { get; set; } = string.Empty;
        [Required, StringLength(1000)] public string Message { get; set; } = string.Empty;
        [Range(typeof(bool), "true", "true", ErrorMessage = "TCPA consent must be confirmed.")] public bool TcpaConsentConfirmed { get; set; }
        public bool HonorOptOut { get; set; } = true;
    }
}
