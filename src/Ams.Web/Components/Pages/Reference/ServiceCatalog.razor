@page "/admin/reference/service-catalog"
@namespace Ams.Web.Components.Pages.ReferenceAdmin
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Service Catalog - Reference Data</PageTitle>

<AppPageHeader Title="Service Request Types / SLA Rules"
               Subtitle="Service request categories, SLA targets, escalation rules and resolution workflows"
               Icon="bi-headset">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenAddDrawer">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Request Type
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="sc-kpi-strip">
    <div class="sc-kpi-card">
        <span class="sc-kpi-icon sc-kpi-icon--total"><i class="bi bi-headset" aria-hidden="true"></i></span>
        <div><div class="sc-kpi-value">@_totalCount</div><div class="sc-kpi-label">Request Types</div></div>
    </div>
    <div class="@KpiClass2" @onclick="() => SetKpiFilter(2)" role="button" tabindex="0">
        <span class="sc-kpi-icon sc-kpi-icon--active"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
        <div><div class="sc-kpi-value">@_activeCount</div><div class="sc-kpi-label">Active</div></div>
        @if (_kpiActive == 2) { <span class="sc-kpi-active-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass3" @onclick="() => SetKpiFilter(3)" role="button" tabindex="0">
        <span class="sc-kpi-icon sc-kpi-icon--urgent"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></span>
        <div><div class="sc-kpi-value">@_urgentCount</div><div class="sc-kpi-label">Urgent Priority</div></div>
        @if (_kpiActive == 3) { <span class="sc-kpi-active-dot" aria-hidden="true"></span> }
    </div>
    <div class="sc-kpi-card">
        <span class="sc-kpi-icon sc-kpi-icon--sla"><i class="bi bi-clock-fill" aria-hidden="true"></i></span>
        <div><div class="sc-kpi-value">@_avgSlaHours<span class="sc-kpi-unit">h</span></div><div class="sc-kpi-label">Avg SLA Target</div></div>
    </div>
</div>

<!-- Filter toolbar -->
<AppFilterPanel @bind-SearchValue="_search"
                OnSearch="OnSearchAsync"
                SearchPlaceholder="Search request type or category...">
    <Filters>
        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_categoryOptions"
                        Placeholder="All Categories"
                        ShowClearButton="true"
                        Width="180px"
                        Value="_filterCategory"
                        ValueChanged="@((string v) => { _filterCategory = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>

        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_priorityOptions"
                        Placeholder="All Priorities"
                        ShowClearButton="true"
                        Width="160px"
                        Value="_filterPriority"
                        ValueChanged="@((string v) => { _filterPriority = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>

        <label class="sc-toggle-label">
            <input type="checkbox" @bind="_filterActiveOnly" @bind:after="ApplyFilters" />
            Active only
        </label>
    </Filters>
</AppFilterPanel>

<!-- Grid -->
<div class="um-grid-card app-datagrid">
    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading...</span>
        </div>
    }
    <SfGrid TValue="ServiceRequestType"
            DataSource="_entries"
            AllowPaging="true"
            AllowSorting="true"
            EnableHover="true"
            RowHeight="52">
        <GridPageSettings PageSize="25" PageSizes="@(new int[] { 10, 25, 50 })" />
        <GridColumns>
            <GridColumn Field="@nameof(ServiceRequestType.TypeName)" HeaderText="Request Type" Width="220">
                <Template>
                    @{ var e = (ServiceRequestType)context; }
                    <div class="sc-name-cell">
                        <span class="sc-type-icon @PriorityIconBg(e.Priority)" aria-hidden="true">
                            <i class="@PriorityIcon(e.Priority)"></i>
                        </span>
                        <div>
                            <div class="sc-type-name">@e.TypeName</div>
                            <div class="sc-type-category">@e.Category</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(ServiceRequestType.Priority)" HeaderText="Priority" Width="120">
                <Template>
                    @{ var e = (ServiceRequestType)context; }
                    <span class="@PriorityBadgeClass(e.Priority)">@e.Priority</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(ServiceRequestType.SlaResponseHours)" HeaderText="Response SLA" Width="140">
                <Template>
                    @{ var e = (ServiceRequestType)context; }
                    <span class="sc-sla-cell">
                        <i class="bi bi-clock sc-sla-icon" aria-hidden="true"></i>
                        @e.SlaResponseHours h
                    </span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(ServiceRequestType.SlaResolutionHours)" HeaderText="Resolution SLA" Width="140">
                <Template>
                    @{ var e = (ServiceRequestType)context; }
                    <span class="sc-sla-cell">
                        <i class="bi bi-clock-history sc-sla-icon" aria-hidden="true"></i>
                        @e.SlaResolutionHours h
                    </span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(ServiceRequestType.EscalationHours)" HeaderText="Escalate After" Width="130">
                <Template>
                    @{ var e = (ServiceRequestType)context; }
                    <span class="sc-mono">@(e.EscalationHours.HasValue ? $"{e.EscalationHours.Value}h" : "-")</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(ServiceRequestType.AssignedTeam)" HeaderText="Assigned Team" Width="160" />
            <GridColumn Field="@nameof(ServiceRequestType.IsActive)" HeaderText="Status" Width="100">
                <Template>
                    @{ var e = (ServiceRequestType)context; }
                    <AppStatusBadge Status="@(e.IsActive ? "Active" : "Inactive")" Label="@(e.IsActive ? "Active" : "Inactive")" />
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Right">
                <Template>
                    @{ var e = (ServiceRequestType)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditDrawer(e)" title="Edit">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<!-- Add/Edit Drawer -->
<AppCrudDrawer @bind-Visible="_showDrawer"
               Title="@(_editModel.TypeId == Guid.Empty ? "Add Request Type" : "Edit Request Type")"
               OnConfirm="SaveAsync"
               OnClose="CloseDrawer">
    <Content>
        <div class="sc-form">
            <label class="sc-form-label">Type Name *</label>
            <input class="um-input" @bind="_editModel.TypeName" placeholder="e.g. Policy Change Request" />

            <label class="sc-form-label">Category</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_categoryOptions"
                            @bind-Value="_editModel.Category"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>

            <label class="sc-form-label">Priority</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_priorityOptions"
                            @bind-Value="_editModel.Priority"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>

            <div class="sc-form-row">
                <div>
                    <label class="sc-form-label">Response SLA (hours)</label>
                    <input class="um-input sc-mono" type="number" min="1" @bind="_editModel.SlaResponseHours" />
                </div>
                <div>
                    <label class="sc-form-label">Resolution SLA (hours)</label>
                    <input class="um-input sc-mono" type="number" min="1" @bind="_editModel.SlaResolutionHours" />
                </div>
            </div>

            <label class="sc-form-label">Escalate After (hours)</label>
            <input class="um-input sc-mono" type="number" @bind="_editModel.EscalationHours" placeholder="Optional" />

            <label class="sc-form-label">Assigned Team</label>
            <input class="um-input" @bind="_editModel.AssignedTeam" placeholder="Team name" />

            <label class="sc-form-label">Description / Instructions</label>
            <textarea class="um-input" rows="3" @bind="_editModel.Description"></textarea>

            <label class="sc-form-label">Requires Approval</label>
            <SfSwitch @bind-Checked="_editModel.RequiresApproval" />

            <label class="sc-form-label">Active</label>
            <SfSwitch @bind-Checked="_editModel.IsActive" />
        </div>
    </Content>
</AppCrudDrawer>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private EnterpriseToast? _toast;

    private List<ServiceRequestType> _allEntries = [];
    private List<ServiceRequestType> _entries    = [];

    private bool _loading    = false;
    private bool _showDrawer = false;

    private string _search           = string.Empty;
    private string _filterCategory   = string.Empty;
    private string _filterPriority   = string.Empty;
    private bool   _filterActiveOnly = false;
    private int    _kpiActive        = 0;

    private int _totalCount  = 0;
    private int _activeCount = 0;
    private int _urgentCount = 0;
    private int _avgSlaHours = 0;

    private string KpiClass2 => "sc-kpi-card" + (_kpiActive == 2 ? " sc-kpi-card--active" : "");
    private string KpiClass3 => "sc-kpi-card" + (_kpiActive == 3 ? " sc-kpi-card--active" : "");

    private static readonly List<LabelValue> _categoryOptions =
    [
        new("PolicyService",  "Policy Service"),
        new("Billing",        "Billing"),
        new("Claims",         "Claims"),
        new("NewBusiness",    "New Business"),
        new("Endorsement",    "Endorsement"),
        new("Cancellation",   "Cancellation"),
        new("Reinstatement",  "Reinstatement"),
        new("Compliance",     "Compliance"),
    ];

    private static readonly List<LabelValue> _priorityOptions =
    [
        new("Critical", "Critical"),
        new("Urgent",   "Urgent"),
        new("High",     "High"),
        new("Normal",   "Normal"),
        new("Low",      "Low"),
    ];

    private ServiceRequestType _editModel = new();

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(
            new("Home",           "/"),
            new("Reference Data", "/admin/reference/carriers"),
            new("Service Catalog","/admin/reference/service-catalog"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            // TODO: Api.GetServiceRequestTypesAsync(_tenantId)
            await Task.Delay(0);
            _allEntries = [];
            ComputeKpi();
            ApplyFilters();
        }
        finally { _loading = false; }
    }

    private async Task OnSearchAsync(string _) => await LoadAsync();

    private void ApplyFilters()
    {
        _entries = _allEntries.Where(e =>
            (string.IsNullOrEmpty(_filterCategory) || e.Category == _filterCategory) &&
            (string.IsNullOrEmpty(_filterPriority) || e.Priority == _filterPriority) &&
            (!_filterActiveOnly || e.IsActive) &&
            (string.IsNullOrEmpty(_search) ||
             e.TypeName.Contains(_search,  StringComparison.OrdinalIgnoreCase) ||
             e.Category.Contains(_search,  StringComparison.OrdinalIgnoreCase))
        ).ToList();

        if (_kpiActive == 2) _entries = _entries.Where(e => e.IsActive).ToList();
        if (_kpiActive == 3) _entries = _entries.Where(e => e.Priority is "Urgent" or "Critical").ToList();

        StateHasChanged();
    }

    private void SetKpiFilter(int n)
    {
        _kpiActive      = _kpiActive == n ? 0 : n;
        _filterPriority = string.Empty;
        _filterActiveOnly = false;
        ApplyFilters();
    }

    private void ComputeKpi()
    {
        _totalCount  = _allEntries.Count;
        _activeCount = _allEntries.Count(e => e.IsActive);
        _urgentCount = _allEntries.Count(e => e.Priority is "Urgent" or "Critical");
        _avgSlaHours = _allEntries.Count > 0 ? (int)_allEntries.Average(e => e.SlaResolutionHours) : 0;
    }

    private void OpenAddDrawer()  { _editModel = new(); _showDrawer = true; }
    private void OpenEditDrawer(ServiceRequestType e)
    {
        _editModel = new ServiceRequestType
        {
            TypeId             = e.TypeId,
            TypeName           = e.TypeName,
            Category           = e.Category,
            Priority           = e.Priority,
            SlaResponseHours   = e.SlaResponseHours,
            SlaResolutionHours = e.SlaResolutionHours,
            EscalationHours    = e.EscalationHours,
            AssignedTeam       = e.AssignedTeam,
            Description        = e.Description,
            RequiresApproval   = e.RequiresApproval,
            IsActive           = e.IsActive,
        };
        _showDrawer = true;
    }
    private void CloseDrawer() => _showDrawer = false;

    private async Task SaveAsync()
    {
        // TODO: Api.SaveServiceRequestTypeAsync(_tenantId, _editModel)
        await Task.Delay(0);
        _showDrawer = false;
        await LoadAsync();
        await ShowToastAsync("Request type saved.", "e-toast-success");
    }

    private async Task ShowToastAsync(string msg, string cssClass = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = cssClass });
    }

    private static string PriorityBadgeClass(string p) => p switch
    {
        "Critical" => "sc-priority-badge sc-priority-badge--critical",
        "Urgent"   => "sc-priority-badge sc-priority-badge--urgent",
        "High"     => "sc-priority-badge sc-priority-badge--high",
        "Normal"   => "sc-priority-badge sc-priority-badge--normal",
        _          => "sc-priority-badge sc-priority-badge--low",
    };

    private static string PriorityIcon(string p) => p switch
    {
        "Critical" => "bi bi-lightning-charge-fill",
        "Urgent"   => "bi bi-exclamation-triangle-fill",
        "High"     => "bi bi-arrow-up-circle-fill",
        "Normal"   => "bi bi-dash-circle",
        _          => "bi bi-arrow-down-circle",
    };

    private static string PriorityIconBg(string p) => p switch
    {
        "Critical" => "sc-type-icon--critical",
        "Urgent"   => "sc-type-icon--urgent",
        "High"     => "sc-type-icon--high",
        _          => "sc-type-icon--normal",
    };

    private sealed record LabelValue(string Value, string Label);

    private sealed class ServiceRequestType
    {
        public Guid    TypeId             { get; set; } = Guid.Empty;
        public string  TypeName           { get; set; } = string.Empty;
        public string  Category           { get; set; } = "PolicyService";
        public string  Priority           { get; set; } = "Normal";
        public int     SlaResponseHours   { get; set; } = 4;
        public int     SlaResolutionHours { get; set; } = 24;
        public int?    EscalationHours    { get; set; }
        public string  AssignedTeam       { get; set; } = string.Empty;
        public string? Description        { get; set; }
        public bool    RequiresApproval   { get; set; }
        public bool    IsActive           { get; set; } = true;
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
