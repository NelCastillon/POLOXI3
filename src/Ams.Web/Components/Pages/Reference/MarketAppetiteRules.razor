@page "/admin/reference/market-appetite-rules"
@namespace Ams.Web.Components.Pages.ReferenceAdmin
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Market Appetite Rules Engine — Reference Data</PageTitle>

<AppPageHeader Title="Market Appetite Rules Engine"
               Subtitle="Define risk criteria rules to surface the best carrier and market targets before submission"
               Icon="bi-lightning-charge">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="() => _showRuleDrawer = true">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Rule
        </button>
        <button class="um-btn um-btn-primary" @onclick="RunMatchAsync">
            <i class="bi bi-search" aria-hidden="true"></i> Find Markets
        </button>
    </Actions>
</AppPageHeader>

<div class="mar-layout">

    <!-- ── Left: criteria panel ── -->
    <div class="mar-criteria-panel um-grid-card">
        <h3 class="mar-panel-title"><i class="bi bi-funnel-fill" aria-hidden="true"></i> Submission Criteria</h3>

        <div class="mar-criteria-form">
            <label class="mar-form-label">Line of Business *</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_lobOptions"
                            @bind-Value="_criteria.LobCode"
                            Placeholder="Select line…"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>

            <label class="mar-form-label">State</label>
            <input class="um-input" @bind="_criteria.State" placeholder="e.g. CA, TX, NY" />

            <label class="mar-form-label">Estimated Annual Premium</label>
            <input class="um-input mar-mono" type="number" @bind="_criteria.EstimatedPremium" placeholder="0" />

            <label class="mar-form-label">Risk Class</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_riskClassOptions"
                            @bind-Value="_criteria.RiskClass"
                            Placeholder="Any class…"
                            ShowClearButton="true"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>

            <label class="mar-form-label">Business Type</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_bizTypeOptions"
                            @bind-Value="_criteria.BusinessType"
                            Placeholder="Any type…"
                            ShowClearButton="true"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>

            <label class="mar-form-label">Years in Business</label>
            <input class="um-input mar-mono" type="number" @bind="_criteria.YearsInBusiness" min="0" />

            <label class="mar-form-label">Loss Ratio (%)</label>
            <input class="um-input mar-mono" type="number" @bind="_criteria.LossRatio" min="0" max="100" />

            <label class="mar-form-label">AM Best Minimum</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_amBestOptions"
                            @bind-Value="_criteria.MinAmBest"
                            Placeholder="Any rating…"
                            ShowClearButton="true"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>

            <label class="mar-form-label">
                <input type="checkbox" @bind="_criteria.AdmittedOnly" />
                Admitted carriers only
            </label>

            <button class="um-btn um-btn-primary mar-run-btn" @onclick="RunMatchAsync">
                <i class="bi bi-search" aria-hidden="true"></i> Find Best Markets
            </button>
        </div>
    </div>

    <!-- ── Right: results panel ── -->
    <div class="mar-results-panel">

        @if (_running)
        {
            <div class="mar-running-banner" aria-live="polite">
                <div class="um-spinner um-spinner--sm" aria-hidden="true"></div>
                <span>Evaluating rules against @_ruleCount active rules…</span>
            </div>
        }

        @if (!_running && _results.Count == 0 && _hasRun)
        {
            <div class="um-grid-card mar-no-results">
                <i class="bi bi-search mar-no-results-icon" aria-hidden="true"></i>
                <p>No markets matched the specified criteria.</p>
                <p class="mar-no-results-hint">Try relaxing state, risk class, or premium range constraints.</p>
            </div>
        }

        @if (_results.Count > 0)
        {
            <div class="mar-results-header">
                <span class="mar-results-count">@_results.Count market@(_results.Count == 1 ? "" : "s") matched</span>
                <span class="mar-results-hint">Ranked by appetite score</span>
            </div>

            @foreach (var r in _results)
            {
                <div class="um-grid-card mar-result-card @ScoreClass(r.Score)">
                    <div class="mar-result-header">
                        <div class="mar-result-rank">
                            <span class="mar-rank-num">@r.Rank</span>
                        </div>
                        <div class="mar-result-identity">
                            <div class="mar-result-name">@r.MarketName</div>
                            <div class="mar-result-type">@r.MarketType · @r.LobName</div>
                        </div>
                        <div class="mar-result-score-block">
                            <div class="mar-score-bar-wrap" aria-label="Appetite score @r.Score out of 100">
                                <div class="mar-score-bar" style="width:@r.Score%"></div>
                            </div>
                            <span class="mar-score-label">@r.Score / 100</span>
                        </div>
                        <span class="@AppetiteClass(r.AppetiteLevel)">
                            <i class="@AppetiteIcon(r.AppetiteLevel)" aria-hidden="true"></i> @r.AppetiteLevel
                        </span>
                    </div>
                    <div class="mar-result-body">
                        <div class="mar-result-tags">
                            @foreach (var tag in r.MatchedRuleTags)
                            {
                                <span class="mar-rule-tag"><i class="bi bi-check2" aria-hidden="true"></i> @tag</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(r.Notes))
                        {
                            <p class="mar-result-notes">@r.Notes</p>
                        }
                    </div>
                    <div class="mar-result-footer">
                        @if (r.MinPremium.HasValue)
                        {
                            <span class="mar-result-meta"><i class="bi bi-cash-coin" aria-hidden="true"></i> Min @r.MinPremium.Value.ToString("C0")</span>
                        }
                        @if (r.MaxPremium.HasValue)
                        {
                            <span class="mar-result-meta"><i class="bi bi-cash-coin" aria-hidden="true"></i> Max @r.MaxPremium.Value.ToString("C0")</span>
                        }
                        <span class="mar-result-meta"><i class="bi bi-person" aria-hidden="true"></i> @r.ContactName</span>
                    </div>
                </div>
            }
        }

        <!-- Active rules list -->
        <div class="um-grid-card mar-rules-card">
            <div class="mar-rules-header">
                <h3 class="mar-panel-title"><i class="bi bi-sliders" aria-hidden="true"></i> Active Appetite Rules</h3>
                <span class="mar-rules-count">@_ruleCount rules</span>
            </div>
            <SfGrid TValue="AppetiteRule"
                    DataSource="_rules"
                    AllowPaging="true"
                    AllowSorting="true"
                    EnableHover="true"
                    RowHeight="48">
                <GridPageSettings PageSize="10" />
                <GridColumns>
                    <GridColumn Field="@nameof(AppetiteRule.RuleName)" HeaderText="Rule" Width="200" />
                    <GridColumn Field="@nameof(AppetiteRule.LobCode)" HeaderText="LoB" Width="80" />
                    <GridColumn Field="@nameof(AppetiteRule.MarketName)" HeaderText="Market" Width="180" />
                    <GridColumn Field="@nameof(AppetiteRule.AppetiteLevel)" HeaderText="Appetite" Width="120">
                        <Template>
                            @{ var r = (AppetiteRule)context; }
                            <span class="@AppetiteClass(r.AppetiteLevel)">@r.AppetiteLevel</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(AppetiteRule.Priority)" HeaderText="Priority" Width="90" />
                    <GridColumn Field="@nameof(AppetiteRule.IsActive)" HeaderText="Active" Width="80">
                        <Template>
                            @{ var r = (AppetiteRule)context; }
                            <SfSwitch @bind-Checked="r.IsActive" />
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Right">
                        <Template>
                            @{ var r = (AppetiteRule)context; }
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditRuleDrawer(r)" title="Edit">
                                <i class="bi bi-pencil" aria-hidden="true"></i>
                            </button>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    </div>
</div>

<!-- Rule Add/Edit Drawer -->
<AppCrudDrawer @bind-Visible="_showRuleDrawer"
               Title="@(_ruleEdit.RuleId == Guid.Empty ? "New Appetite Rule" : "Edit Rule")"
               OnConfirm="SaveRuleAsync"
               OnClose="() => _showRuleDrawer = false">
    <Content>
        <div class="mar-form">
            <label class="mar-form-label">Rule Name *</label>
            <input class="um-input" @bind="_ruleEdit.RuleName" placeholder="Descriptive rule name" />

            <label class="mar-form-label">Line of Business</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_lobOptions"
                            @bind-Value="_ruleEdit.LobCode"
                            ShowClearButton="true"
                            Placeholder="Any line…"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>

            <label class="mar-form-label">Market / Carrier</label>
            <input class="um-input" @bind="_ruleEdit.MarketName" placeholder="Market or carrier name" />

            <label class="mar-form-label">Appetite Level</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_appetiteLevelOptions"
                            @bind-Value="_ruleEdit.AppetiteLevel"
                            Width="100%">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>

            <label class="mar-form-label">Min Premium</label>
            <input class="um-input mar-mono" type="number" @bind="_ruleEdit.MinPremium" />

            <label class="mar-form-label">Max Premium</label>
            <input class="um-input mar-mono" type="number" @bind="_ruleEdit.MaxPremium" />

            <label class="mar-form-label">Min Years in Business</label>
            <input class="um-input mar-mono" type="number" @bind="_ruleEdit.MinYearsInBusiness" />

            <label class="mar-form-label">Max Loss Ratio (%)</label>
            <input class="um-input mar-mono" type="number" @bind="_ruleEdit.MaxLossRatio" />

            <label class="mar-form-label">Priority (lower = higher priority)</label>
            <input class="um-input mar-mono" type="number" @bind="_ruleEdit.Priority" min="1" />

            <label class="mar-form-label">Notes</label>
            <textarea class="um-input" rows="3" @bind="_ruleEdit.Notes"></textarea>

            <label class="mar-form-label">Active</label>
            <SfSwitch @bind-Checked="_ruleEdit.IsActive" />
        </div>
    </Content>
</AppCrudDrawer>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;

    private bool _running      = false;
    private bool _hasRun       = false;
    private bool _showRuleDrawer = false;

    private int _ruleCount = 0;

    private List<MatchResult>  _results = [];
    private List<AppetiteRule> _rules   = [];

    private SubmissionCriteria _criteria  = new();
    private AppetiteRule       _ruleEdit  = new();

    // ── Static options ────────────────────────────────────────────────────────────
    private static readonly List<LabelValue> _lobOptions =
    [
        new("BOP", "BOP – Business Owners Policy"),
        new("GL",  "GL – General Liability"),
        new("WC",  "WC – Workers Comp"),
        new("CA",  "CA – Commercial Auto"),
        new("CPP", "CPP – Commercial Package"),
        new("PL",  "PL – Professional Liability"),
        new("CY",  "CY – Cyber Liability"),
        new("IM",  "IM – Inland Marine"),
    ];

    private static readonly List<LabelValue> _riskClassOptions =
    [
        new("Preferred",  "Preferred"),
        new("Standard",   "Standard"),
        new("SubStandard","Sub-Standard"),
        new("Specialty",  "Specialty / E&S"),
    ];

    private static readonly List<LabelValue> _bizTypeOptions =
    [
        new("Retail",       "Retail"),
        new("Restaurant",   "Restaurant"),
        new("Contractor",   "Contractor"),
        new("Manufacturing","Manufacturing"),
        new("Professional", "Professional Services"),
        new("Healthcare",   "Healthcare"),
        new("Technology",   "Technology"),
    ];

    private static readonly List<LabelValue> _amBestOptions =
    [
        new("A++","A++ (Superior)"),
        new("A+", "A+ (Superior)"),
        new("A",  "A (Excellent)"),
        new("A-", "A- (Excellent)"),
        new("B++","B++ (Good)"),
    ];

    private static readonly List<LabelValue> _appetiteLevelOptions =
    [
        new("Preferred","Preferred"),
        new("Standard", "Standard"),
        new("Limited",  "Limited"),
        new("Declined", "Declined"),
    ];

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",                "/"),
            new("Reference Data",      "/admin/reference/carriers"),
            new("Appetite Rules Engine","/admin/reference/market-appetite-rules"));

        await LoadRulesAsync();
    }

    private async Task LoadRulesAsync()
    {
        // TODO: replace with Api.GetAppetiteRulesAsync(_tenantId)
        await Task.Delay(0);
        _rules     = [];
        _ruleCount = _rules.Count(r => r.IsActive);
    }

    private async Task RunMatchAsync()
    {
        if (string.IsNullOrEmpty(_criteria.LobCode))
        {
            await ShowToastAsync("Select a Line of Business to run the match.", "e-toast-warning");
            return;
        }

        _running = true;
        _hasRun  = true;
        StateHasChanged();
        try
        {
            // TODO: replace with Api.MatchAppetiteRulesAsync(_tenantId, _criteria)
            await Task.Delay(300);
            _results = [];
        }
        finally
        {
            _running = false;
        }
    }

    private void OpenEditRuleDrawer(AppetiteRule r)
    {
        _ruleEdit = new AppetiteRule { RuleId = r.RuleId, RuleName = r.RuleName, LobCode = r.LobCode, MarketName = r.MarketName, AppetiteLevel = r.AppetiteLevel, MinPremium = r.MinPremium, MaxPremium = r.MaxPremium, MinYearsInBusiness = r.MinYearsInBusiness, MaxLossRatio = r.MaxLossRatio, Priority = r.Priority, Notes = r.Notes, IsActive = r.IsActive };
        _showRuleDrawer = true;
    }

    private async Task SaveRuleAsync()
    {
        // TODO: Api.SaveAppetiteRuleAsync(_tenantId, _ruleEdit)
        await Task.Delay(0);
        _showRuleDrawer = false;
        await LoadRulesAsync();
        await ShowToastAsync("Rule saved.", "e-toast-success");
    }

    private async Task ShowToastAsync(string msg, string cssClass = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = cssClass });
    }

    private static string AppetiteClass(string level) => level switch
    {
        "Preferred" => "mar-appetite mar-appetite--preferred",
        "Standard"  => "mar-appetite mar-appetite--standard",
        "Limited"   => "mar-appetite mar-appetite--limited",
        "Declined"  => "mar-appetite mar-appetite--declined",
        _           => "mar-appetite mar-appetite--na",
    };

    private static string AppetiteIcon(string level) => level switch
    {
        "Preferred" => "bi bi-star-fill",
        "Standard"  => "bi bi-check-circle",
        "Limited"   => "bi bi-dash-circle",
        "Declined"  => "bi bi-x-circle-fill",
        _           => "bi bi-slash-circle",
    };

    private static string ScoreClass(int score) => score switch
    {
        >= 80 => "mar-result-card--high",
        >= 50 => "mar-result-card--medium",
        _     => "mar-result-card--low",
    };

    // ── Inner models ──────────────────────────────────────────────────────────────
    private sealed record LabelValue(string Value, string Label);

    private sealed class SubmissionCriteria
    {
        public string  LobCode           { get; set; } = string.Empty;
        public string  State             { get; set; } = string.Empty;
        public decimal EstimatedPremium  { get; set; }
        public string  RiskClass         { get; set; } = string.Empty;
        public string  BusinessType      { get; set; } = string.Empty;
        public int     YearsInBusiness   { get; set; }
        public decimal LossRatio         { get; set; }
        public string  MinAmBest         { get; set; } = string.Empty;
        public bool    AdmittedOnly      { get; set; }
    }

    private sealed record MatchResult
    {
        public int          Rank            { get; init; }
        public string       MarketName      { get; init; } = string.Empty;
        public string       MarketType      { get; init; } = string.Empty;
        public string       LobName         { get; init; } = string.Empty;
        public int          Score           { get; init; }
        public string       AppetiteLevel   { get; init; } = "Standard";
        public List<string> MatchedRuleTags { get; init; } = [];
        public decimal?     MinPremium      { get; init; }
        public decimal?     MaxPremium      { get; init; }
        public string       ContactName     { get; init; } = string.Empty;
        public string?      Notes           { get; init; }
    }

    private sealed class AppetiteRule
    {
        public Guid    RuleId             { get; set; } = Guid.Empty;
        public string  RuleName           { get; set; } = string.Empty;
        public string  LobCode            { get; set; } = string.Empty;
        public string  MarketName         { get; set; } = string.Empty;
        public string  AppetiteLevel      { get; set; } = "Standard";
        public decimal? MinPremium        { get; set; }
        public decimal? MaxPremium        { get; set; }
        public int      MinYearsInBusiness { get; set; }
        public decimal  MaxLossRatio      { get; set; }
        public int      Priority          { get; set; } = 10;
        public string?  Notes             { get; set; }
        public bool     IsActive          { get; set; } = true;
    }
}
