    // ── Reset MFA ──────────────────────────────────────────────────────────────
    private void OpenReset(UserMfaStatusDto user) { _actionTarget = user; _showReset = true; }

    private async Task ExecuteResetAsync()
    {
        if (_actionTarget is null) return;
        _confirming = true;
        try
        {
            await Api.ResetMfaAsync(_actionTarget.UserId);
            await ShowToastAsync($"MFA reset for {_actionTarget.UserFullName}.", "e-toast-warning");
            await LoadAsync();
            if (_view == "detail") await LoadUserDevicesAsync();
        }
        catch (Exception ex) { await ShowToastAsync($"Error: {ex.Message}", "e-toast-danger"); }
        finally { _confirming = false; _actionTarget = null; }
    }

    // ── Require MFA ────────────────────────────────────────────────────────────
    private void OpenRequire(UserMfaStatusDto user) { _actionTarget = user; _showRequire = true; }

    private async Task ExecuteRequireAsync()
    {
        if (_actionTarget is null) return;
        _confirming = true;
        try
        {
            var setRequired = !_actionTarget.MfaRequired;
            await Api.RequireMfaAsync(_actionTarget.UserId, setRequired);
            var msg = setRequired
                ? $"MFA is now required for {_actionTarget.UserFullName}."
                : $"MFA requirement removed for {_actionTarget.UserFullName}.";
            await ShowToastAsync(msg, setRequired ? "e-toast-success" : "e-toast-warning");
            await LoadAsync();
            if (_view == "detail" && _detailUser?.UserId == _actionTarget.UserId)
            {
                _detailUser = _allWithUsers.FirstOrDefault(u => u.UserId == _actionTarget.UserId)
                           ?? _allWithoutUsers.FirstOrDefault(u => u.UserId == _actionTarget.UserId)
                           ?? _detailUser;
            }
        }
        catch (Exception ex) { await ShowToastAsync($"Error: {ex.Message}", "e-toast-danger"); }
        finally { _confirming = false; _actionTarget = null; }
    }

