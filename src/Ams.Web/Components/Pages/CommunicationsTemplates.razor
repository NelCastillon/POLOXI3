@page "/communications/templates"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject ApiClient Api
@using Ams.Application.Features.Communications

<PageTitle>Communication Templates — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<!-- ── CREATE / EDIT DIALOG ──────────────────────────────────────── -->
<SfDialog @bind-Visible="_showDlg" Width="680px" ShowCloseIcon="true" IsModal="true">
    <DialogTemplates>
        <Header>
            <div class="pd-dlg-hdr">
                <i class="bi bi-layout-text-sidebar" aria-hidden="true"></i>
                @(_edit?.Id == Guid.Empty ? "New Template" : "Edit Template")
            </div>
        </Header>
        <Content>
            @if (_edit is not null)
            {
                <div class="pd-dlg-body">
                    <div class="pd-dlg-grid">
                        <div style="grid-column:1/-1"><label class="cd-dlg-lbl">Template Name *</label>
                            <SfTextBox @bind-Value="_edit.Name" Placeholder="e.g. Policy Renewal Reminder — Email" />
                        </div>
                        <div><label class="cd-dlg-lbl">Channel *</label>
                            <SfDropDownList TValue="string" TItem="string"
                                            DataSource="@(new[]{"Email","SMS","Portal Message","Internal Note"})"
                                            @bind-Value="_edit.Channel" Placeholder="Select channel" />
                        </div>
                        <div><label class="cd-dlg-lbl">Category *</label>
                            <SfDropDownList TValue="string" TItem="string"
                                            DataSource="@_categories"
                                            @bind-Value="_edit.Category" Placeholder="Select category" />
                        </div>
                        <div><label class="cd-dlg-lbl">Language</label>
                            <SfDropDownList TValue="string" TItem="string"
                                            DataSource="@(new[]{"English","Spanish","Bilingual"})"
                                            @bind-Value="_edit.Language" Placeholder="English" />
                        </div>
                        <div><label class="cd-dlg-lbl">Status</label>
                            <SfDropDownList TValue="string" TItem="string"
                                            DataSource="@(new[]{"Active","Draft","Archived"})"
                                            @bind-Value="_edit.Status" Placeholder="Active" />
                        </div>
                        @if (_edit.Channel is "Email" or "Portal Message")
                        {
                            <div style="grid-column:1/-1"><label class="cd-dlg-lbl">Subject Line *</label>
                                <SfTextBox @bind-Value="_edit.Subject" Placeholder="Email subject — use [variables] for merge fields" />
                            </div>
                        }
                        <div style="grid-column:1/-1"><label class="cd-dlg-lbl">Body *</label>
                            <SfTextBox @bind-Value="_edit.Body" Placeholder="Template body — use [Client Name], [Policy #], [Agent Name], [Date], [Amount] etc."
                                       Multiline="true" HtmlAttributes='@(new() {{"rows","8"}})' />
                        </div>
                        <div style="grid-column:1/-1">
                            <label class="cd-dlg-lbl">Merge Variables in Use</label>
                            <div class="tpl-var-chips">
                                @foreach (var v in DetectVariables(_edit.Body))
                                {
                                    <span class="tpl-var-chip"><i class="bi bi-braces" aria-hidden="true"></i>@v</span>
                                }
                                @if (!DetectVariables(_edit.Body).Any())
                                {
                                    <span style="font-size:.72rem;color:var(--um-muted,#94a3b8)">No variables detected — use [Variable Name] syntax</span>
                                }
                            </div>
                        </div>
                        <div><label class="cd-dlg-lbl">Opt-Out Footer</label>
                            <SfCheckBox @bind-Checked="_edit.IncludeOptOutFooter" Label="Append unsubscribe / opt-out footer" />
                        </div>
                        <div><label class="cd-dlg-lbl">TCPA Notice</label>
                            <SfCheckBox @bind-Checked="_edit.TcpaNotice" Label="Include TCPA consent notice (SMS)" />
                        </div>
                    </div>
                </div>
            }
        </Content>
        <FooterTemplate>
            <div class="pd-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showDlg = false">Cancel</button>
                <button class="um-btn um-btn-ghost" @onclick="PreviewTemplate">
                    <i class="bi bi-eye" aria-hidden="true"></i> Preview
                </button>
                <button class="um-btn um-btn-primary" @onclick="SaveTemplate">
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                    @(_edit?.Id == Guid.Empty ? "Create Template" : "Save Changes")
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ── PREVIEW DIALOG ────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showPreviewDlg" Width="560px" ShowCloseIcon="true" IsModal="true">
    <DialogTemplates>
        <Header><div class="pd-dlg-hdr"><i class="bi bi-eye" aria-hidden="true"></i> Template Preview</div></Header>
        <Content>
            @if (_previewTemplate is not null)
            {
                <div class="pd-dlg-body">
                    <div class="tpl-preview-meta">
                        <span class="ci-ch-icon ci-ch-@ChannelCss(_previewTemplate.Channel)">
                            <i class="bi @ChannelIcon(_previewTemplate.Channel)" aria-hidden="true"></i>
                        </span>
                        <div>
                            <div style="font-weight:800;font-size:.85rem">@_previewTemplate.Name</div>
                            <div style="font-size:.72rem;color:var(--um-muted,#64748b)">@_previewTemplate.Channel · @_previewTemplate.Category · @_previewTemplate.Language</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_previewTemplate.Subject))
                    {
                        <div class="tpl-preview-subject"><strong>Subject:</strong> @_previewTemplate.Subject</div>
                    }
                    <div class="tpl-preview-body">@_previewTemplate.Body</div>
                    @if (_previewTemplate.IncludeOptOutFooter)
                    {
                        <div class="tpl-preview-footer">
                            <i class="bi bi-slash-circle" aria-hidden="true"></i>
                            To opt out of these communications, reply STOP or click Unsubscribe.
                        </div>
                    }
                </div>
            }
        </Content>
        <FooterTemplate>
            <div class="pd-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showPreviewDlg = false">Close</button>
                <button class="um-btn um-btn-primary" @onclick="UseInCompose">
                    <i class="bi bi-send" aria-hidden="true"></i> Use in Compose
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<AppPageHeader Title="Communication Templates"
               Subtitle="Reusable templates for email, SMS, portal messages and internal notes"
               Icon="bi-layout-text-sidebar">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/inbox")'>
            <i class="bi bi-inbox" aria-hidden="true"></i> Inbox
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Template
        </button>
    </Actions>
</AppPageHeader>

<!-- ── FILTER BAR ─────────────────────────────────────────────────── -->
<div class="tpl-toolbar">
    <input class="e-input tpl-search" @bind="_search" @bind:event="oninput" placeholder="Search templates…" />
    <select class="e-input tpl-sel" @bind="_channelFilter">
        <option value="">All Channels</option>
        <option>Email</option><option>SMS</option><option>Portal Message</option><option>Internal Note</option>
    </select>
    <select class="e-input tpl-sel" @bind="_categoryFilter">
        <option value="">All Categories</option>
        @foreach (var cat in _categories) { <option>@cat</option> }
    </select>
    <select class="e-input tpl-sel" @bind="_statusFilter">
        <option value="">All Status</option>
        <option>Active</option><option>Draft</option><option>Archived</option>
    </select>
    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters">
        <i class="bi bi-x" aria-hidden="true"></i>
    </button>
    <div style="margin-left:auto;font-size:.75rem;color:var(--um-muted,#64748b);">
        <strong>@Filtered.Count()</strong> template(s)
    </div>
</div>

<!-- ── TEMPLATE GRID ─────────────────────────────────────────────── -->
<div class="tpl-grid-wrap">
    <div class="tpl-grid">
        @if (!Filtered.Any())
        {
            <div class="tpl-empty">
                <i class="bi bi-layout-text-sidebar tpl-empty-icon" aria-hidden="true"></i>
                <span>No templates match your filters.</span>
            </div>
        }
        @foreach (var t in Filtered.OrderBy(x => x.Category).ThenBy(x => x.Name))
        {
            <div class="tpl-card @(t.Status=="Archived" ? "tpl-card-archived" : "")">
                <div class="tpl-card-header">
                    <span class="ci-ch-icon ci-ch-@ChannelCss(t.Channel) tpl-ch-icon">
                        <i class="bi @ChannelIcon(t.Channel)" aria-hidden="true"></i>
                    </span>
                    <div class="tpl-card-title-col">
                        <div class="tpl-card-name">@t.Name</div>
                        <div class="tpl-card-meta">
                            <span class="tpl-cat-chip">@t.Category</span>
                            @if (t.Language != "English")
                            {
                                <span class="tpl-lang-chip"><i class="bi bi-globe2" aria-hidden="true"></i>@t.Language</span>
                            }
                            <span class="tpl-status-badge tpl-st-@t.Status.ToLower()">@t.Status</span>
                        </div>
                    </div>
                    <div class="tpl-card-actions">
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => PreviewById(t)" title="Preview">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenEdit(t)" title="Edit">
                            <i class="bi bi-pencil" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => CloneTemplate(t)" title="Clone">
                            <i class="bi bi-copy" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(t.Subject))
                {
                    <div class="tpl-subject-row"><i class="bi bi-chat-square-quote" aria-hidden="true"></i> @t.Subject</div>
                }

                <div class="tpl-body-preview">@t.Body[..Math.Min(180, t.Body.Length)]@(t.Body.Length > 180 ? "…" : "")</div>

                <div class="tpl-footer-row">
                    <div class="tpl-vars">
                        @foreach (var v in DetectVariables(t.Body + " " + t.Subject).Take(4))
                        {
                            <span class="tpl-var-chip tpl-var-sm"><i class="bi bi-braces" aria-hidden="true"></i>@v</span>
                        }
                    </div>
                    <div class="tpl-compliance-row">
                        @if (t.IncludeOptOutFooter)
                        { <span class="tpl-comp-chip tpl-cc-ok"><i class="bi bi-check" aria-hidden="true"></i>Opt-Out</span> }
                        @if (t.TcpaNotice)
                        { <span class="tpl-comp-chip tpl-cc-ok"><i class="bi bi-check" aria-hidden="true"></i>TCPA</span> }
                    </div>
                    <div class="tpl-usage-row">
                        <i class="bi bi-send" aria-hidden="true"></i> Used @t.UsageCount× &nbsp;
                        <i class="bi bi-clock" aria-hidden="true"></i> @FormatAge(t.UpdatedAt)
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    SfToast _toast = default!;
    string _search         = "";
    string _channelFilter  = "";
    string _categoryFilter = "";
    string _statusFilter   = "";

    bool      _showDlg        = false;
    bool      _showPreviewDlg = false;
    Template? _edit;
    Template? _previewTemplate;

    readonly string[] _categories = { "Renewal","Claims","Billing / Payment","Policy Service","CAT / Emergency","Compliance","Marketing","Welcome / Onboarding","Internal / Staff" };

    sealed class Template
    {
        public Guid     Id                 { get; set; }
        public string   Name               { get; set; } = "";
        public string   Channel            { get; set; } = "";
        public string   Category           { get; set; } = "";
        public string   Language           { get; set; } = "English";
        public string   Status             { get; set; } = "Active";
        public string   Subject            { get; set; } = "";
        public string   Body               { get; set; } = "";
        public bool     IncludeOptOutFooter{ get; set; }
        public bool     TcpaNotice         { get; set; }
        public int      UsageCount         { get; set; }
        public DateTime UpdatedAt          { get; set; }
    }

    List<Template> _templates = new();

    IEnumerable<Template> Filtered => _templates.Where(t =>
        (string.IsNullOrEmpty(_search)         || t.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || t.Body.Contains(_search, StringComparison.OrdinalIgnoreCase))
     && (string.IsNullOrEmpty(_channelFilter)  || t.Channel  == _channelFilter)
     && (string.IsNullOrEmpty(_categoryFilter) || t.Category == _categoryFilter)
     && (string.IsNullOrEmpty(_statusFilter)   || t.Status   == _statusFilter));

    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Communications","/communications/inbox"), new("Templates",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var dtos = await Api.GetCommTemplatesAsync(_tenantId);
        _templates = (dtos ?? []).Select(d => new Template
        {
            Id                  = d.TemplateId,
            Name                = d.Name,
            Channel             = d.Channel,
            Category            = d.Category,
            Language            = d.Language,
            Status              = d.Status,
            Subject             = d.Subject ?? string.Empty,
            Body                = d.Body,
            IncludeOptOutFooter = d.IncludeOptOutFooter,
            TcpaNotice          = d.TcpaNotice,
            UsageCount          = d.UsageCount,
            UpdatedAt           = d.UpdatedAt
        }).ToList();
    }

    void OpenCreate()
    {
        _edit    = new Template { Id = Guid.Empty, Channel = "Email", Category = "Policy Service", Language = "English", Status = "Active" };
        _showDlg = true;
    }

    void OpenEdit(Template t)
    {
        _edit    = new Template { Id=t.Id, Name=t.Name, Channel=t.Channel, Category=t.Category, Language=t.Language, Status=t.Status, Subject=t.Subject, Body=t.Body, IncludeOptOutFooter=t.IncludeOptOutFooter, TcpaNotice=t.TcpaNotice };
        _showDlg = true;
    }

    async Task SaveTemplate()
    {
        if (_edit is null || string.IsNullOrWhiteSpace(_edit.Name) || string.IsNullOrWhiteSpace(_edit.Body)) return;
        if (_edit.Id == Guid.Empty)
        {
            await Api.CreateCommTemplateAsync(new CreateCommTemplateRequest(
                _tenantId, _edit.Name, _edit.Channel, _edit.Category, _edit.Language, _edit.Status,
                string.IsNullOrEmpty(_edit.Subject) ? null : _edit.Subject,
                _edit.Body, _edit.IncludeOptOutFooter, _edit.TcpaNotice));
        }
        else
        {
            await Api.UpdateCommTemplateAsync(_edit.Id, new UpdateCommTemplateRequest(
                _edit.Id, _edit.Name, _edit.Channel, _edit.Category, _edit.Language, _edit.Status,
                string.IsNullOrEmpty(_edit.Subject) ? null : _edit.Subject,
                _edit.Body, _edit.IncludeOptOutFooter, _edit.TcpaNotice));
        }
        var name = _edit.Name;
        _showDlg = false;
        await LoadAsync();
        await _toast.ShowAsync(new ToastModel { Title = "Saved", Content = $"Template '{name}' saved.", CssClass = "e-toast-success" });
    }

    void PreviewTemplate()    { _previewTemplate = _edit; _showPreviewDlg = true; }
    void PreviewById(Template t) { _previewTemplate = t; _showPreviewDlg = true; }

    void UseInCompose()
    {
        _showPreviewDlg = false;
        Nav.NavigateTo("/communications/inbox");
    }

    async Task CloneTemplate(Template t)
    {
        await Api.CreateCommTemplateAsync(new CreateCommTemplateRequest(
            _tenantId, $"Copy of {t.Name}", t.Channel, t.Category, t.Language, "Draft",
            string.IsNullOrEmpty(t.Subject) ? null : t.Subject,
            t.Body, t.IncludeOptOutFooter, t.TcpaNotice));
        await LoadAsync();
        await _toast.ShowAsync(new ToastModel { Title = "Cloned", Content = $"Draft copy of '{t.Name}' created.", CssClass = "e-toast-info" });
    }

    void ResetFilters() { _search = ""; _channelFilter = ""; _categoryFilter = ""; _statusFilter = ""; }

    static IEnumerable<string> DetectVariables(string text)
    {
        var matches = System.Text.RegularExpressions.Regex.Matches(text ?? "", @"\[([^\[\]]+)\]");
        return matches.Select(m => m.Groups[1].Value).Distinct().Take(8);
    }

    static string FormatAge(DateTime dt)
    {
        var d = DateTime.Now - dt;
        if (d.TotalDays < 1)   return "Today";
        if (d.TotalDays < 7)   return $"{(int)d.TotalDays}d ago";
        if (d.TotalDays < 30)  return $"{(int)(d.TotalDays/7)}w ago";
        return dt.ToString("MM/dd/yyyy");
    }

    static string ChannelIcon(string ch) => ch switch { "Email" => "bi-envelope", "SMS" => "bi-phone", "Internal Note" => "bi-sticky", "Portal Message" => "bi-globe", _ => "bi-chat-dots" };
    static string ChannelCss(string ch)  => ch switch { "Email" => "email", "SMS" => "sms", "Internal Note" => "note", "Portal Message" => "portal", _ => "gen" };
}
