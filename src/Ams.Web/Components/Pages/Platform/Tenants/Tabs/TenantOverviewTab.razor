@using Ams.Application.Common.Dtos

@if (_loading)
{
    <div class="um-loading-overlay" aria-live="polite">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading overview…</span>
    </div>
}
else if (_tenant is null)
{
    <div class="tot-empty-hint">
        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
        <span>Could not load tenant data.</span>
    </div>
}
else
{
    <div class="tab-section">

        <!-- ── Row 1: Identity + Plan ───────────────────────────────────── -->
        <div class="tot-grid tot-grid--2">

            <!-- Identity -->
            <div class="tot-card">
                <div class="tot-card-hdr">
                    <i class="bi bi-buildings" aria-hidden="true"></i>
                    <span>Tenant Identity</span>
                </div>
                <div class="tot-card-body">
                    <div class="tot-field">
                        <span class="tot-fl">Tenant ID</span>
                        <span class="tot-fv tot-mono">@_tenant.TenantId</span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Code</span>
                        <span class="tot-fv tot-mono">@_tenant.TenantCode</span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Name</span>
                        <span class="tot-fv">@_tenant.TenantName</span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Status</span>
                        <span class="tot-fv"><AppStatusBadge Status="@_tenant.StatusCode" /></span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Primary Domain</span>
                        <span class="tot-fv tot-domain-summary">
                            @if (!string.IsNullOrEmpty(_tenant.PrimaryDomain))
                            {
                                <span class="tot-domain-pill">@_tenant.PrimaryDomain</span>
                                <button class="um-btn um-btn-xs um-btn-primary tot-domain-manage" @onclick='() => Nav.NavigateTo($"/platform/tenants/{_tenant.TenantId}/domains")'>
                                    <i class="bi bi-globe" aria-hidden="true"></i> Manage Domains
                                </button>
                            }
                            else
                            {
                                <span class="tot-muted">—
                                    <button class="tot-ql" @onclick='() => Nav.NavigateTo($"/platform/tenants/{_tenant.TenantId}/domains")'>
                                        <i class="bi bi-plus-circle" aria-hidden="true"></i> Add domain
                                    </button>
                                </span>
                            }
                        </span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Created</span>
                        <span class="tot-fv">@_tenant.CreatedDateUtc.ToString("d")</span>
                    </div>
                    @if (_tenant.GoLiveDateUtc.HasValue)
                    {
                        <div class="tot-field">
                            <span class="tot-fl">Go-Live</span>
                            <span class="tot-fv">@_tenant.GoLiveDateUtc.Value.ToString("d")</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Subscription / Plan -->
            <div class="tot-card">
                <div class="tot-card-hdr">
                    <i class="bi bi-award" aria-hidden="true"></i>
                    <span>Subscription &amp; Plan</span>
                </div>
                <div class="tot-card-body">
                    <div class="tot-plan-hero">
                        @if (!string.IsNullOrEmpty(_tenant.PlanCode))
                        {
                            <span class="badge badge-blue tot-plan-badge">
                                <i class="bi bi-award" aria-hidden="true"></i> @_tenant.PlanCode
                            </span>
                        }
                        else
                        {
                            <span class="tot-muted">No plan assigned</span>
                        }
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Locale</span>
                        <span class="tot-fv">@(_tenant.Locale.Length > 0 ? _tenant.Locale : "—")</span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Currency</span>
                        <span class="tot-fv">@(_tenant.CurrencyCode.Length > 0 ? _tenant.CurrencyCode : "—")</span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Time Zone</span>
                        <span class="tot-fv">@(_tenant.TimeZoneId.Length > 0 ? _tenant.TimeZoneId : "—")</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- ── Row 2: Region + Features ─────────────────────────────────── -->
        <div class="tot-grid tot-grid--2">

            <!-- Region & Deployment -->
            <div class="tot-card">
                <div class="tot-card-hdr">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                    <span>Region &amp; Deployment</span>
                    <button class="tot-ql-hdr" @onclick='() => JumpTo(7)'>
                        <i class="bi bi-arrow-right-circle" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="tot-card-body">
                    <div class="tot-field">
                        <span class="tot-fl">Region</span>
                        <span class="tot-fv">
                            @if (!string.IsNullOrEmpty(_tenant.RegionCode))
                            {
                                <span class="td-stat-chip">
                                    <i class="bi bi-geo-alt" aria-hidden="true"></i> @_tenant.RegionCode
                                </span>
                            }
                            else
                            {
                                <span class="tot-muted">—</span>
                            }
                        </span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Isolation</span>
                        <span class="tot-fv">
                            @if (!string.IsNullOrEmpty(_tenant.IsolationMode))
                            {
                                <span class="td-stat-chip">
                                    <i class="bi bi-layers" aria-hidden="true"></i> @_tenant.IsolationMode
                                </span>
                            }
                            else
                            {
                                <span class="tot-muted">—</span>
                            }
                        </span>
                    </div>
                </div>
                <div class="tot-card-footer">
                    <button class="tot-ql" @onclick='() => JumpTo(7)'>
                        <i class="bi bi-geo-alt" aria-hidden="true"></i> Region &amp; Deployment details
                    </button>
                </div>
            </div>

            <!-- Feature Summary -->
            <div class="tot-card">
                <div class="tot-card-hdr">
                    <i class="bi bi-toggles" aria-hidden="true"></i>
                    <span>Feature Flags</span>
                    <button class="tot-ql-hdr" @onclick='() => JumpTo(5)'>
                        <i class="bi bi-arrow-right-circle" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="tot-card-body">
                    <div class="tot-empty-hint">
                        <i class="bi bi-toggles2" aria-hidden="true"></i>
                        <span>Feature flag details are managed in the Features tab.</span>
                    </div>
                </div>
                <div class="tot-card-footer">
                    <button class="tot-ql" @onclick='() => JumpTo(5)'>
                        <i class="bi bi-toggles" aria-hidden="true"></i> View feature flags
                    </button>
                </div>
            </div>

        </div>

        <!-- ── Row 3: Usage + Alerts ─────────────────────────────────────── -->
        <div class="tot-grid tot-grid--2">

            <!-- Usage Summary -->
            <div class="tot-card">
                <div class="tot-card-hdr">
                    <i class="bi bi-bar-chart" aria-hidden="true"></i>
                    <span>Usage Summary</span>
                    <button class="tot-ql-hdr" @onclick='() => JumpTo(9)'>
                        <i class="bi bi-arrow-right-circle" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="tot-card-body">
                    <div class="tot-metric-row">
                        <div class="tot-metric">
                            <span class="tot-metric-value">@_tenant.ActiveUsers</span>
                            <span class="tot-metric-label">Active Users</span>
                        </div>
                        <div class="tot-metric">
                            <span class="tot-metric-value @StatusMetricClass">@_tenant.StatusCode</span>
                            <span class="tot-metric-label">Status</span>
                        </div>
                    </div>
                    <div class="tot-bar-group">
                        <div class="tot-bar-label">
                            <span>User Adoption</span>
                            <span>@_tenant.ActiveUsers users</span>
                        </div>
                        <div class="tot-bar-track">
                            <div class="tot-bar-fill tot-bar-fill--blue"
                                 style="width: @UserBarWidth%"></div>
                        </div>
                    </div>
                </div>
                <div class="tot-card-footer">
                    <button class="tot-ql" @onclick='() => JumpTo(9)'>
                        <i class="bi bi-bar-chart" aria-hidden="true"></i> Full usage &amp; metrics
                    </button>
                </div>
            </div>

            <!-- Alert Summary -->
            <div class="tot-card">
                <div class="tot-card-hdr">
                    <i class="bi bi-bell" aria-hidden="true"></i>
                    <span>Alerts &amp; Notices</span>
                    <button class="tot-ql-hdr" @onclick='() => JumpTo(11)'>
                        <i class="bi bi-arrow-right-circle" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="tot-card-body">
                    @if (_tenant.StatusCode == "Suspended")
                    {
                        <div class="tot-alert tot-alert--warning">
                            <i class="bi bi-pause-circle" aria-hidden="true"></i>
                            <span>This tenant is <strong>suspended</strong>. Users cannot access the platform.</span>
                        </div>
                    }
                    else if (_tenant.StatusCode == "Terminated")
                    {
                        <div class="tot-alert tot-alert--danger">
                            <i class="bi bi-x-octagon" aria-hidden="true"></i>
                            <span>This tenant has been <strong>terminated</strong>.</span>
                        </div>
                    }
                    else if (string.IsNullOrEmpty(_tenant.RegionCode))
                    {
                        <div class="tot-alert tot-alert--info">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            <span>No region assigned. Configure region before provisioning.</span>
                        </div>
                    }
                    else if (string.IsNullOrEmpty(_tenant.PlanCode))
                    {
                        <div class="tot-alert tot-alert--info">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            <span>No subscription plan assigned to this tenant.</span>
                        </div>
                    }
                    else
                    {
                        <div class="tot-alert tot-alert--ok">
                            <i class="bi bi-check-circle" aria-hidden="true"></i>
                            <span>No active alerts. Tenant is operating normally.</span>
                        </div>
                    }
                </div>
                <div class="tot-card-footer">
                    <button class="tot-ql" @onclick='() => JumpTo(11)'>
                        <i class="bi bi-journal-text" aria-hidden="true"></i> View audit log
                    </button>
                </div>
            </div>

        </div>

    </div>
}

@code {
    [Parameter, EditorRequired] public Guid TenantId { get; set; }
    [Parameter] public EventCallback<int> OnJumpToTab { get; set; }
    [Inject] ApiClient Api { get; set; } = null!;
    [Inject] NavigationManager Nav { get; set; } = null!;

    private TenantDto? _tenant;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (_tenant?.TenantId == TenantId) return;
        await LoadAsync();
    }

    public async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _tenant = await Api.GetTenantByIdAsync(TenantId);
        }
        catch
        {
            _tenant = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private string StatusMetricClass => _tenant?.StatusCode switch
    {
        "Active"     => "tot-metric-value--green",
        "Suspended"  => "tot-metric-value--amber",
        "Terminated" => "tot-metric-value--red",
        _            => string.Empty
    };

    private int UserBarWidth => Math.Min((_tenant?.ActiveUsers ?? 0) * 5, 100);

    private async Task JumpTo(int tab) => await OnJumpToTab.InvokeAsync(tab);
}
