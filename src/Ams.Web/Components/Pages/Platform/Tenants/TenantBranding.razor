@page "/platform/tenants/{TenantId:guid}/branding"
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Tenants
@using Ams.Application.Common.Validation
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Branding — @_tenantName</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Branding Configuration"
               Subtitle="@_tenantName"
               Icon="bi-palette">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="NavigateBack">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Tenant
        </button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-ghost text-warning" @onclick="OpenResetDialog" title="Reset to Defaults">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset Defaults
        </button>
        <button class="um-btn um-btn-primary" @onclick="SaveBrandingAsync" disabled="@_saving">
            <i class="bi bi-check-lg" aria-hidden="true"></i> Save Branding
        </button>
    </Actions>
</AppPageHeader>

@if (_loading)
{
    <div class="um-loading-overlay" aria-live="polite">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading branding…</span>
    </div>
}
else
{
    <div class="tb-layout">
        <!-- ── Left: Settings ────────────────────────────────── -->
        <div class="tb-settings">

            <!-- Logos -->
            <section class="tb-section">
                <h3 class="tb-section-title"><i class="bi bi-image" aria-hidden="true"></i> Logos</h3>
                <div class="tb-field">
                    <label class="um-label">Main Logo URL</label>
                    <SfTextBox @bind-Value="_form.LogoUrl" Placeholder="https://cdn.example.com/logo.png" />
                </div>
                <div class="tb-field">
                    <label class="um-label">Favicon URL</label>
                    <SfTextBox @bind-Value="_form.FaviconUrl" Placeholder="https://cdn.example.com/favicon.ico" />
                </div>
            </section>

            <!-- Colors -->
            <section class="tb-section">
                <h3 class="tb-section-title"><i class="bi bi-palette" aria-hidden="true"></i> Colors</h3>
                <div class="tb-color-row">
                    <div class="tb-field tb-field--color">
                        <label class="um-label">Primary Color</label>
                        <div class="tb-color-input">
                            <input type="color" @bind="_form.PrimaryColor" />
                            <SfTextBox @bind-Value="_form.PrimaryColor" Placeholder="#0d6efd" />
                        </div>
                    </div>
                    <div class="tb-field tb-field--color">
                        <label class="um-label">Secondary Color</label>
                        <div class="tb-color-input">
                            <input type="color" @bind="_form.SecondaryColor" />
                            <SfTextBox @bind-Value="_form.SecondaryColor" Placeholder="#6c757d" />
                        </div>
                    </div>
                    <div class="tb-field tb-field--color">
                        <label class="um-label">Accent Color</label>
                        <div class="tb-color-input">
                            <input type="color" @bind="_form.AccentColor" />
                            <SfTextBox @bind-Value="_form.AccentColor" Placeholder="#198754" />
                        </div>
                    </div>
                </div>
            </section>

            <!-- Theme -->
            <section class="tb-section">
                <h3 class="tb-section-title"><i class="bi bi-brightness-high" aria-hidden="true"></i> Theme</h3>
                <div class="tb-field">
                    <label class="um-label">Custom CSS URL</label>
                    <SfTextBox @bind-Value="_form.CustomCssUrl" Placeholder="https://cdn.example.com/theme.css" />
                </div>
            </section>

            <!-- Email Branding -->
            <section class="tb-section">
                <h3 class="tb-section-title"><i class="bi bi-envelope" aria-hidden="true"></i> Email Branding</h3>
                <div class="tb-field">
                    <label class="um-label">Support Email</label>
                    <SfTextBox @bind-Value="_form.SupportEmail" Placeholder="support@example.com" />
                </div>
                <div class="tb-field">
                    <label class="um-label">Support Phone</label>
                    <SfTextBox @bind-Value="_form.SupportPhone" Placeholder="(555) 123-4567" Type="InputType.Tel" />
                    <small class="text-muted">Use enterprise phone format: (555) 123-4567 or +1 555 123 4567 x123.</small>
                </div>
                <div class="tb-field">
                    <label class="um-label">Email Footer Text</label>
                    <SfTextBox @bind-Value="_form.FooterText" Multiline="true" Placeholder="© 2025 Acme Inc. All rights reserved." />
                </div>
            </section>

            <!-- Portal Display Name -->
            <section class="tb-section">
                <h3 class="tb-section-title"><i class="bi bi-window" aria-hidden="true"></i> Portal Display Name</h3>
                <div class="tb-field">
                    <label class="um-label">White-Label Name</label>
                    <SfTextBox @bind-Value="_form.WhiteLabelName" Placeholder="Acme Portal" />
                </div>
            </section>
        </div>

        <!-- ── Right: Preview ────────────────────────────────── -->
        <div class="tb-preview">
            <h3 class="tb-section-title"><i class="bi bi-eye" aria-hidden="true"></i> Preview</h3>
            <div class="tb-preview-card" style="--tb-primary: @(_form.PrimaryColor ?? "#0d6efd"); --tb-secondary: @(_form.SecondaryColor ?? "#6c757d"); --tb-accent: @(_form.AccentColor ?? "#198754");">
                <div class="tb-preview-header" style="background: var(--tb-primary);">
                    <div class="tb-preview-logo-area">
                        @if (!string.IsNullOrWhiteSpace(_form.LogoUrl))
                        {
                            <img src="@_form.LogoUrl" alt="Logo" class="tb-preview-logo" />
                        }
                        else
                        {
                            <i class="bi bi-building" style="font-size:1.5rem;color:#fff;"></i>
                        }
                        <span class="tb-preview-brand-name">@(string.IsNullOrWhiteSpace(_form.WhiteLabelName) ? "Portal" : _form.WhiteLabelName)</span>
                    </div>
                </div>
                <div class="tb-preview-body">
                    <div class="tb-preview-nav">
                        <span class="tb-preview-nav-item active" style="border-color: var(--tb-accent);">Dashboard</span>
                        <span class="tb-preview-nav-item">Settings</span>
                        <span class="tb-preview-nav-item">Reports</span>
                    </div>
                    <div class="tb-preview-content">
                        <div class="tb-preview-btn" style="background: var(--tb-primary);">Primary Action</div>
                        <div class="tb-preview-btn tb-preview-btn--secondary" style="background: var(--tb-secondary);">Secondary</div>
                        <div class="tb-preview-btn tb-preview-btn--accent" style="background: var(--tb-accent);">Accent</div>
                    </div>
                </div>
                <div class="tb-preview-footer" style="background: var(--tb-secondary); color: #fff;">
                    @(string.IsNullOrWhiteSpace(_form.FooterText) ? "© Footer text" : _form.FooterText)
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_form.FaviconUrl))
            {
                <div class="tb-favicon-preview">
                    <span class="um-label">Favicon:</span>
                    <img src="@_form.FaviconUrl" alt="Favicon" class="tb-favicon-img" />
                </div>
            }
        </div>
    </div>
}

<!-- Reset to Defaults Dialog -->
<SfDialog @bind-Visible="_showResetDialog" Width="440px" IsModal="true" ShowCloseIcon="true" Header="Reset Branding" CssClass="td-dialog">
    <DialogTemplates>
        <Content>
            <div class="td-dialog-body">
                <div class="td-warning-notice">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    <span>Reset all branding settings to plan defaults? This cannot be undone.</span>
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Cancel" CssClass="um-btn um-btn-ghost" OnClick="() => _showResetDialog = false" />
        <DialogButton Content="Reset to Defaults" CssClass="um-btn um-btn-danger" OnClick="ConfirmResetAsync" Disabled="_saving" />
    </DialogButtons>
</SfDialog>

@code {
    [Parameter] public Guid TenantId { get; set; }

    private SfToast? _toast;
    private bool _loading = true;
    private bool _saving;
    private bool _showResetDialog;
    private string _tenantName = "";
    private BrandingForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        await EnsureTenantContextAsync();
        Breadcrumbs.SetCrumbs(
            new BreadcrumbService.BreadcrumbItem("Platform", "/platform"),
            new BreadcrumbService.BreadcrumbItem("Tenants", "/platform/tenants"),
            new BreadcrumbService.BreadcrumbItem("Branding")
        );
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var tenant = await Api.GetTenantByIdAsync(TenantId);
            _tenantName = tenant?.TenantName ?? "Unknown Tenant";

            var branding = await Api.GetTenantBrandingAsync(TenantId);
            if (branding is not null)
            {
                _form = new BrandingForm
                {
                    WhiteLabelName = branding.WhiteLabelName ?? "",
                    LogoUrl        = branding.LogoUrl ?? "",
                    FaviconUrl     = branding.FaviconUrl ?? "",
                    PrimaryColor   = branding.PrimaryColor,
                    SecondaryColor = branding.SecondaryColor,
                    AccentColor    = branding.AccentColor,
                    CustomCssUrl   = branding.CustomCssUrl ?? "",
                    SupportEmail   = branding.SupportEmail ?? "",
                    SupportPhone   = branding.SupportPhone ?? "",
                    FooterText     = branding.FooterText ?? "",
                };
            }
            else
            {
                _form = new BrandingForm();
            }
        }
        catch
        {
            _tenantName = "Error loading tenant";
            _form = new BrandingForm();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SaveBrandingAsync()
    {
        _saving = true;
        try
        {
            await Api.UpdateTenantBrandingAsync(TenantId, new UpdateTenantBrandingRequest
            {
                WhiteLabelName = NullIfEmpty(_form.WhiteLabelName),
                LogoUrl        = NullIfEmpty(_form.LogoUrl),
                FaviconUrl     = NullIfEmpty(_form.FaviconUrl),
                PrimaryColor   = NullIfEmpty(_form.PrimaryColor),
                SecondaryColor = NullIfEmpty(_form.SecondaryColor),
                AccentColor    = NullIfEmpty(_form.AccentColor),
                CustomCssUrl   = NullIfEmpty(_form.CustomCssUrl),
                SupportEmail   = NullIfEmpty(_form.SupportEmail),
                SupportPhone   = NullIfEmpty(_form.SupportPhone),
                FooterText     = NullIfEmpty(_form.FooterText),
            });
            await ShowToast("Branding Saved", "All branding settings have been saved.", "e-toast-success");
        }
        catch
        {
            await ShowToast("Save Failed", "Could not save branding settings.", "e-toast-danger");
        }
        finally { _saving = false; }
    }

    private void OpenResetDialog() => _showResetDialog = true;

    private async Task ConfirmResetAsync()
    {
        _saving = true;
        try
        {
            await Api.ResetTenantBrandingToDefaultsAsync(TenantId);
            _showResetDialog = false;
            await ShowToast("Branding Reset", "All settings have been reset to plan defaults.", "e-toast-warning");
            await LoadAsync();
        }
        catch
        {
            await ShowToast("Reset Failed", "Could not reset branding settings.", "e-toast-danger");
        }
        finally { _saving = false; }
    }

    private void NavigateBack() => Nav.NavigateTo($"/platform/tenants/{TenantId}");

    private static string? NullIfEmpty(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();

    private async Task ShowToast(string title, string content, string cssClass)
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Title = title, Content = content, CssClass = cssClass });
    }

    private sealed class BrandingForm
    {
        public string WhiteLabelName { get; set; } = "";
        public string LogoUrl { get; set; } = "";
        public string FaviconUrl { get; set; } = "";
        public string PrimaryColor { get; set; } = "#0d6efd";
        public string SecondaryColor { get; set; } = "#6c757d";
        public string AccentColor { get; set; } = "#198754";
        public string CustomCssUrl { get; set; } = "";
        [AmsEmailAddress]
        public string SupportEmail { get; set; } = "";
        [AmsPhone]
        public string SupportPhone { get; set; } = "";
        public string FooterText { get; set; } = "";
    }

    private async Task EnsureTenantContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        if (TenantId == Guid.Empty) TenantId = context.TenantId;
    }
}
