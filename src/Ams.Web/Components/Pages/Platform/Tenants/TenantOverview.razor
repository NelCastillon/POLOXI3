@using Ams.Application.Common.Dtos

@if (_loading)
{
    <div class="um-loading-overlay" aria-live="polite">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading overview…</span>
    </div>
}
else if (_tenant is null)
{
    <div class="tot-empty-hint">
        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
        <span>Could not load tenant data.</span>
    </div>
}
else
{
    <div class="tab-section">

        <!-- ── Row 1: Identity Summary + Commercial Summary ─────────────── -->
        <div class="tot-grid tot-grid--2">

            <!-- Identity Summary -->
            <div class="tot-card">
                <div class="tot-card-hdr">
                    <i class="bi bi-buildings" aria-hidden="true"></i>
                    <span>Identity Summary</span>
                </div>
                <div class="tot-card-body">
                    <div class="tot-field">
                        <span class="tot-fl">Tenant ID</span>
                        <span class="tot-fv tot-mono">@_tenant.TenantId</span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Code</span>
                        <span class="tot-fv tot-mono">@_tenant.TenantCode</span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Name</span>
                        <span class="tot-fv"><strong>@_tenant.TenantName</strong></span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Status</span>
                        <span class="tot-fv"><AppStatusBadge Status="@_tenant.StatusCode" /></span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Primary Domain</span>
                        <span class="tot-fv tot-domain-summary">
                            @if (!string.IsNullOrEmpty(_tenant.PrimaryDomain))
                            {
                                <span class="tot-domain-pill">@_tenant.PrimaryDomain</span>
                                <button class="um-btn um-btn-xs um-btn-primary tot-domain-manage" @onclick='() => Nav.NavigateTo($"/platform/tenants/{_tenant.TenantId}/domains")'>
                                    <i class="bi bi-globe" aria-hidden="true"></i> Manage
                                </button>
                            }
                            else
                            {
                                <span class="tot-muted">—
                                    <button class="tot-ql" @onclick='() => Nav.NavigateTo($"/platform/tenants/{_tenant.TenantId}/domains")'>
                                        <i class="bi bi-plus-circle" aria-hidden="true"></i> Add domain
                                    </button>
                                </span>
                            }
                        </span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Isolation Mode</span>
                        <span class="tot-fv">
                            @if (!string.IsNullOrEmpty(_tenant.IsolationMode))
                            {
                                <span class="td-stat-chip"><i class="bi bi-layers" aria-hidden="true"></i> @_tenant.IsolationMode</span>
                            }
                            else
                            {
                                <span class="tot-muted">—</span>
                            }
                        </span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Created</span>
                        <span class="tot-fv">@_tenant.CreatedDateUtc.ToString("d MMM yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- Commercial Summary -->
            <div class="tot-card">
                <div class="tot-card-hdr">
                    <i class="bi bi-award" aria-hidden="true"></i>
                    <span>Commercial Summary</span>
                    <button class="tot-ql-hdr" @onclick='() => JumpTo(4)'>
                        <i class="bi bi-arrow-right-circle" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="tot-card-body">
                    <div class="tot-plan-hero">
                        @if (!string.IsNullOrEmpty(_tenant.PlanCode))
                        {
                            <span class="badge badge-blue tot-plan-badge">
                                <i class="bi bi-award" aria-hidden="true"></i> @_tenant.PlanCode
                            </span>
                        }
                        else
                        {
                            <span class="tot-muted">No plan assigned</span>
                        }
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Billing Status</span>
                        <span class="tot-fv">
                            @if (_tenant.IsActive)
                            {
                                <span class="td-stat-chip td-stat-chip--ok"><i class="bi bi-check-circle" aria-hidden="true"></i> Active</span>
                            }
                            else
                            {
                                <span class="td-stat-chip td-stat-chip--warn"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Inactive</span>
                            }
                        </span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Go-Live Date</span>
                        <span class="tot-fv">
                            @if (_tenant.GoLiveDateUtc.HasValue)
                            {
                                <strong>@_tenant.GoLiveDateUtc.Value.ToString("d MMM yyyy")</strong>
                            }
                            else
                            {
                                <span class="tot-muted">Not scheduled</span>
                            }
                        </span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Locale</span>
                        <span class="tot-fv">@(_tenant.Locale.Length > 0 ? _tenant.Locale : "—")</span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Currency</span>
                        <span class="tot-fv">@(_tenant.CurrencyCode.Length > 0 ? _tenant.CurrencyCode : "—")</span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Time Zone</span>
                        <span class="tot-fv">@(_tenant.TimeZoneId.Length > 0 ? _tenant.TimeZoneId : "—")</span>
                    </div>
                </div>
                <div class="tot-card-footer">
                    <button class="tot-ql" @onclick='() => JumpTo(4)'>
                        <i class="bi bi-card-checklist" aria-hidden="true"></i> Subscription details
                    </button>
                </div>
            </div>

        </div>

        <!-- ── Row 2: Region / Deployment + Feature Summary ─────────────── -->
        <div class="tot-grid tot-grid--2">

            <!-- Region & Deployment Summary -->
            <div class="tot-card">
                <div class="tot-card-hdr">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                    <span>Region &amp; Deployment</span>
                    <button class="tot-ql-hdr" @onclick='() => JumpTo(7)'>
                        <i class="bi bi-arrow-right-circle" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="tot-card-body">
                    <div class="tot-field">
                        <span class="tot-fl">Region</span>
                        <span class="tot-fv">
                            @if (!string.IsNullOrEmpty(_tenant.RegionCode))
                            {
                                <span class="td-stat-chip">
                                    <i class="bi bi-geo-alt" aria-hidden="true"></i> @_tenant.RegionCode
                                </span>
                            }
                            else
                            {
                                <span class="tot-muted">— not assigned</span>
                            }
                        </span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Isolation</span>
                        <span class="tot-fv">
                            @if (!string.IsNullOrEmpty(_tenant.IsolationMode))
                            {
                                <span class="td-stat-chip">
                                    <i class="bi bi-layers" aria-hidden="true"></i> @_tenant.IsolationMode
                                </span>
                            }
                            else
                            {
                                <span class="tot-muted">—</span>
                            }
                        </span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Database</span>
                        <span class="tot-fv tot-muted">—</span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Storage</span>
                        <span class="tot-fv tot-muted">—</span>
                    </div>
                </div>
                <div class="tot-card-footer">
                    <button class="tot-ql" @onclick='() => JumpTo(7)'>
                        <i class="bi bi-geo-alt" aria-hidden="true"></i> Region &amp; Deployment details
                    </button>
                </div>
            </div>

            <!-- Feature Summary -->
            <div class="tot-card">
                <div class="tot-card-hdr">
                    <i class="bi bi-toggles" aria-hidden="true"></i>
                    <span>Feature Summary</span>
                    <button class="tot-ql-hdr" @onclick='() => JumpTo(5)'>
                        <i class="bi bi-arrow-right-circle" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="tot-card-body">
                    <div class="tot-field">
                        <span class="tot-fl">Plan</span>
                        <span class="tot-fv">
                            @if (!string.IsNullOrEmpty(_tenant.PlanCode))
                            {
                                <span class="badge badge-blue"><i class="bi bi-award" aria-hidden="true"></i> @_tenant.PlanCode</span>
                            }
                            else
                            {
                                <span class="tot-muted">No plan</span>
                            }
                        </span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">CRM &amp; Sales</span>
                        <span class="tot-fv"><span class="td-pill td-pill--green">Included</span></span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Finance</span>
                        <span class="tot-fv"><span class="td-pill td-pill--green">Included</span></span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Workflows</span>
                        <span class="tot-fv"><span class="td-pill td-pill--green">Included</span></span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">AI Assistant</span>
                        <span class="tot-fv"><span class="td-pill td-pill--yellow">Plan dependent</span></span>
                    </div>
                    <div class="tot-field">
                        <span class="tot-fl">Overrides</span>
                        <span class="tot-fv tot-muted">None — using plan defaults</span>
                    </div>
                </div>
                <div class="tot-card-footer">
                    <button class="tot-ql" @onclick='() => JumpTo(5)'>
                        <i class="bi bi-toggles" aria-hidden="true"></i> Manage feature flags
                    </button>
                    <a class="tot-ql" href="/platform/tenants/@_tenant.TenantId/features">
                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Feature overrides
                    </a>
                </div>
            </div>

        </div>

        <!-- ── Row 3: Usage Summary + Platform Alerts Summary ────────────── -->
        <div class="tot-grid tot-grid--2">

            <!-- Usage Summary -->
            <div class="tot-card">
                <div class="tot-card-hdr">
                    <i class="bi bi-bar-chart" aria-hidden="true"></i>
                    <span>Usage Summary</span>
                    <button class="tot-ql-hdr" @onclick='() => JumpTo(6)'>
                        <i class="bi bi-arrow-right-circle" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="tot-card-body">
                    <div class="tot-metric-row">
                        <div class="tot-metric">
                            <span class="tot-metric-value">@_tenant.ActiveUsers</span>
                            <span class="tot-metric-label">Active Users</span>
                        </div>
                        <div class="tot-metric">
                            <span class="tot-metric-value tot-muted">—</span>
                            <span class="tot-metric-label">Storage Used</span>
                        </div>
                        <div class="tot-metric">
                            <span class="tot-metric-value @StatusMetricClass">@_tenant.StatusCode</span>
                            <span class="tot-metric-label">Status</span>
                        </div>
                    </div>
                    <div class="tot-bar-group">
                        <div class="tot-bar-label">
                            <span>User Adoption</span>
                            <span>@_tenant.ActiveUsers users</span>
                        </div>
                        <div class="tot-bar-track">
                            <div class="tot-bar-fill tot-bar-fill--blue"
                                 style="width: @UserBarWidth%"></div>
                        </div>
                    </div>
                    <div class="tot-bar-group">
                        <div class="tot-bar-label">
                            <span>Storage</span>
                            <span class="tot-muted">No data</span>
                        </div>
                        <div class="tot-bar-track">
                            <div class="tot-bar-fill tot-bar-fill--blue" style="width: 0%"></div>
                        </div>
                    </div>
                </div>
                <div class="tot-card-footer">
                    <button class="tot-ql" @onclick='() => JumpTo(6)'>
                        <i class="bi bi-bar-chart" aria-hidden="true"></i> Full usage &amp; metrics
                    </button>
                    <button class="tot-ql" @onclick='() => JumpTo(8)'>
                        <i class="bi bi-speedometer" aria-hidden="true"></i> Quotas
                    </button>
                </div>
            </div>

            <!-- Platform Alerts Summary -->
            <div class="tot-card">
                <div class="tot-card-hdr">
                    <i class="bi bi-bell" aria-hidden="true"></i>
                    <span>Platform Alerts</span>
                    <button class="tot-ql-hdr" @onclick='() => JumpTo(9)'>
                        <i class="bi bi-arrow-right-circle" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="tot-card-body">
                    @if (_tenant.StatusCode == "Suspended")
                    {
                        <div class="tot-alert tot-alert--warning">
                            <i class="bi bi-pause-circle" aria-hidden="true"></i>
                            <span>This tenant is <strong>suspended</strong>. Users cannot access the platform.</span>
                        </div>
                    }
                    else if (_tenant.StatusCode == "Terminated")
                    {
                        <div class="tot-alert tot-alert--danger">
                            <i class="bi bi-x-octagon" aria-hidden="true"></i>
                            <span>This tenant has been <strong>terminated</strong>.</span>
                        </div>
                    }

                    @if (string.IsNullOrEmpty(_tenant.RegionCode))
                    {
                        <div class="tot-alert tot-alert--info">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            <span>No region assigned. Configure region before provisioning.</span>
                        </div>
                    }

                    @if (string.IsNullOrEmpty(_tenant.PlanCode))
                    {
                        <div class="tot-alert tot-alert--info">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            <span>No subscription plan assigned to this tenant.</span>
                        </div>
                    }

                    @if (!_tenant.IsActive && _tenant.StatusCode == "Active")
                    {
                        <div class="tot-alert tot-alert--warning">
                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                            <span>Billing is <strong>inactive</strong> while tenant status is Active. Verify billing configuration.</span>
                        </div>
                    }

                    @if (string.IsNullOrEmpty(_tenant.PrimaryDomain))
                    {
                        <div class="tot-alert tot-alert--info">
                            <i class="bi bi-globe2" aria-hidden="true"></i>
                            <span>No primary domain configured.</span>
                        </div>
                    }

                    @if (!_tenant.GoLiveDateUtc.HasValue)
                    {
                        <div class="tot-alert tot-alert--info">
                            <i class="bi bi-calendar-x" aria-hidden="true"></i>
                            <span>Go-live date has not been scheduled.</span>
                        </div>
                    }

                    @if (_tenant.StatusCode is not ("Suspended" or "Terminated")
                         && !string.IsNullOrEmpty(_tenant.RegionCode)
                         && !string.IsNullOrEmpty(_tenant.PlanCode)
                         && _tenant.IsActive
                         && !string.IsNullOrEmpty(_tenant.PrimaryDomain)
                         && _tenant.GoLiveDateUtc.HasValue)
                    {
                        <div class="tot-alert tot-alert--ok">
                            <i class="bi bi-check-circle" aria-hidden="true"></i>
                            <span>No active alerts. Tenant is operating normally.</span>
                        </div>
                    }
                </div>
                <div class="tot-card-footer">
                    <a class="tot-ql" href="/platform/alerts?tenantId=@_tenant.TenantId">
                        <i class="bi bi-bell" aria-hidden="true"></i> View platform alerts
                    </a>
                    <button class="tot-ql" @onclick='() => JumpTo(9)'>
                        <i class="bi bi-journal-text" aria-hidden="true"></i> Audit log
                    </button>
                </div>
            </div>

        </div>

    </div>
}

@code {
    [Parameter, EditorRequired] public Guid TenantId { get; set; }
    [Parameter] public EventCallback<int> OnJumpToTab { get; set; }
    [Inject] ApiClient Api { get; set; } = null!;
    [Inject] NavigationManager Nav { get; set; } = null!;

    private TenantDto? _tenant;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (_tenant?.TenantId == TenantId) return;
        await LoadAsync();
    }

    public async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _tenant = await Api.GetTenantByIdAsync(TenantId);
        }
        catch
        {
            _tenant = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private string StatusMetricClass => _tenant?.StatusCode switch
    {
        "Active"     => "tot-metric-value--green",
        "Suspended"  => "tot-metric-value--amber",
        "Terminated" => "tot-metric-value--red",
        _            => string.Empty
    };

    private int UserBarWidth => Math.Min((_tenant?.ActiveUsers ?? 0) * 5, 100);

    private async Task JumpTo(int tab) => await OnJumpToTab.InvokeAsync(tab);
}
