    // ── Lifecycle actions ─────────────────────────────────────────────────────
    private async Task ExecuteSuspendAsync()
    {
        if (_tenant is null) return;
        _confirming = true;
        try
        {
            await Api.SuspendTenantAsync(_tenant.TenantId);
            _showSuspend = false;
            await ShowToastAsync($"\"{_tenant.TenantName}\" suspended.", "Success");
            await LoadAsync();
        }
        catch { await ShowToastAsync("Failed to suspend tenant.", "Error"); }
        finally { _confirming = false; }
    }

    private async Task ExecuteActivateAsync()
    {
        if (_tenant is null) return;
        _confirming = true;
        try
        {
            await Api.ActivateTenantAsync(_tenant.TenantId);
            _showActivate = false;
            await ShowToastAsync($"\"{_tenant.TenantName}\" activated.", "Success");
            await LoadAsync();
        }
        catch { await ShowToastAsync("Failed to activate tenant.", "Error"); }
        finally { _confirming = false; }
    }

