                            </div>
                            <div class="tot-metric">
                                <span class="tot-metric-value tot-muted">—</span>
                                <span class="tot-metric-label">Storage Used</span>
                            </div>
                            <div class="tot-metric">
                                <span class="tot-metric-value tot-muted">—</span>
                                <span class="tot-metric-label">API Calls Today</span>
                            </div>
                            <div class="tot-metric">
                                <span class="tot-metric-value tot-muted">—</span>
                                <span class="tot-metric-label">Events This Month</span>
                            </div>
                        </div>
                        <div class="tot-grid tot-grid--2">
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-people" aria-hidden="true"></i>
                                    <span>User &amp; Storage</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-field">
                                        <span class="tot-fl">Active Users</span>
                                        <span class="tot-fv"><strong>@_tenant.ActiveUsers</strong></span>
                                    </div>
                                    <div class="tot-field">
