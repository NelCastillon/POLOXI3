                                        </span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Storage Used</span>
                                        <span class="tot-fv tot-muted">—</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Storage Limit</span>
                                        <span class="tot-fv tot-muted">—</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Storage Utilisation</span>
                                        <span class="tot-fv">
                                            <div class="td-quota-bar"><div class="td-quota-fill" style="width:0%"></div></div>
                                        </span>
