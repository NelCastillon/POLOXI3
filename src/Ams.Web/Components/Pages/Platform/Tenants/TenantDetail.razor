            </TabItem>

            <!-- 6: Usage -->
            <TabItem>
                <ChildContent><TabHeader Text="Usage" IconCss="bi bi-bar-chart-line" /></ChildContent>
                <ContentTemplate>
                    <div class="tab-section">
                        <div class="tot-metric-row">
                            <div class="tot-metric">
                                <span class="tot-metric-value">@_tenant.ActiveUsers</span>
                                <span class="tot-metric-label">Active Users</span>
                            </div>
                            <div class="tot-metric">
                                <span class="tot-metric-value tot-muted">?</span>
                                <span class="tot-metric-label">Storage Used</span>
                            </div>
                            <div class="tot-metric">
                                <span class="tot-metric-value tot-muted">?</span>
                                <span class="tot-metric-label">API Calls Today</span>
                            </div>
                            <div class="tot-metric">
                                <span class="tot-metric-value tot-muted">?</span>
                                <span class="tot-metric-label">Events This Month</span>
                            </div>
                        </div>

                        <!-- Activity trend chart -->
                        <div class="tot-card td-chart-card">
                            <div class="tot-card-hdr">
                                <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                                <span>Activity Trend ? Last 6 Months</span>
                            </div>
                            <div class="tot-card-body td-chart-wrap">
                                <SfChart Height="220px" Background="transparent">
                                    <ChartPrimaryXAxis ValueType="Syncfusion.Blazor.Charts.ValueType.Category" />
                                    <ChartPrimaryYAxis />
                                    <ChartSeriesCollection>
                                        <ChartSeries DataSource="_activityData" XName="Month" YName="ApiCalls"
                                                     Name="API Calls" Type="ChartSeriesType.SplineArea"
                                                     Opacity="0.4" />
                                        <ChartSeries DataSource="_activityData" XName="Month" YName="AutomationRuns"
                                                     Name="Automation Runs" Type="ChartSeriesType.SplineArea"
                                                     Opacity="0.4" />
                                    </ChartSeriesCollection>
                                    <ChartLegendSettings Visible="true" />
                                </SfChart>
                            </div>
                        </div>

                        <div class="tot-grid tot-grid--2">
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-people" aria-hidden="true"></i>
                                    <span>User &amp; Storage</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-field">
                                        <span class="tot-fl">Active Users</span>
                                        <span class="tot-fv"><strong>@_tenant.ActiveUsers</strong></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">User Limit</span>
                                        <span class="tot-fv tot-muted">?</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">User Utilisation</span>
                                        <span class="tot-fv">
                                            <div class="td-quota-bar"><div class="td-quota-fill" style="width:0%"></div></div>
                                        </span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Storage Used</span>
                                        <span class="tot-fv tot-muted">?</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Storage Limit</span>
                                        <span class="tot-fv tot-muted">?</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Storage Utilisation</span>
                                        <span class="tot-fv">
                                            <div class="td-quota-bar"><div class="td-quota-fill" style="width:0%"></div></div>
                                        </span>
                                    </div>
                                </div>
                                <div class="tot-card-footer">
                                    <a class="tot-ql" href="/platform/usage?tenantId=@_tenant.TenantId">
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Full usage report
                                    </a>
                                </div>
                            </div>
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-graph-up" aria-hidden="true"></i>
                                    <span>API &amp; Platform Activity</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-alert tot-alert--info">
                                        <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                                        <span>Real-time API call volume, module activity and storage trend charts are available in <strong>Platform Usage Analytics</strong>.</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">API Calls Today</span>
                                        <span class="tot-fv tot-muted">?</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">API Limit / Day</span>
                                        <span class="tot-fv tot-muted">?</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Events This Month</span>
                                        <span class="tot-fv tot-muted">?</span>
                                    </div>
                                </div>
                                <div class="tot-card-footer">
                                    <a class="tot-ql" href="/platform/usage?tenantId=@_tenant.TenantId">
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Usage analytics
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 7: Region & Deployment -->
            <TabItem>
                <ChildContent><TabHeader Text="Region &amp; Deployment" IconCss="bi bi-geo-alt" /></ChildContent>
                <ContentTemplate>
                    <div class="tab-section">
                        <div class="tot-grid tot-grid--2">
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-geo-alt" aria-hidden="true"></i>
                                    <span>Region &amp; Isolation</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-field">
                                        <span class="tot-fl">Region</span>
                                        <span class="tot-fv">
                                            @if (!string.IsNullOrEmpty(_tenant.RegionCode))
                                            {
                                                <span class="td-stat-chip"><i class="bi bi-geo-alt" aria-hidden="true"></i> @_tenant.RegionCode</span>
                                            }
                                            else { <span class="tot-muted">? not assigned</span> }
                                        </span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Isolation Mode</span>
                                        <span class="tot-fv">
                                            @if (!string.IsNullOrEmpty(_tenant.IsolationMode))
                                            {
                                                <span class="td-stat-chip"><i class="bi bi-layers" aria-hidden="true"></i> @_tenant.IsolationMode</span>
                                            }
                                            else { <span class="tot-muted">?</span> }
                                        </span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Database Placement</span>
                                        <span class="tot-fv tot-muted">?</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Storage Placement</span>
                                        <span class="tot-fv tot-muted">?</span>
                                    </div>
                                </div>
                                <div class="tot-card-footer">
                                    <button class="tot-ql" @onclick="OpenChangeRegion">
                                        <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Move region
                                    </button>
                                    <a class="tot-ql" href="/platform/tenants/@TenantId/deployment">
                                        <i class="bi bi-diagram-3" aria-hidden="true"></i> Manage deployment assignment
                                    </a>
                                </div>
                            </div>
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-diagram-2" aria-hidden="true"></i>
                                    <span>Deployment Bindings</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-alert tot-alert--info">
                                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                                        <span><strong>Shared</strong> ? data co-located with other tenants. <strong>Dedicated</strong> ? isolated database and storage. Moving regions may require a data migration.</span>
                                    </div>
                                    <div class="tot-empty-hint">
                                        <i class="bi bi-diagram-2" aria-hidden="true"></i>
                                        <span>Active infrastructure bindings for this tenant are managed via Deployment Bindings.</span>
                                    </div>
                                </div>
                                <div class="tot-card-footer">
                                    <a class="tot-ql" href="/platform/deployment-bindings">
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> View deployment bindings
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 8: Quotas -->
            <TabItem>
                <ChildContent><TabHeader Text="Quotas" IconCss="bi bi-speedometer" /></ChildContent>
                <ContentTemplate>
                    <div class="tab-section">
                        <div class="tot-grid tot-grid--2">
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-people" aria-hidden="true"></i>
                                    <span>User Quota</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-field">
                                        <span class="tot-fl">Active Users</span>
                                        <span class="tot-fv">@_tenant.ActiveUsers</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Plan Limit</span>
                                        <span class="tot-fv tot-muted">?</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Utilisation</span>
                                        <span class="tot-fv">
                                            <div class="td-quota-bar"><div class="td-quota-fill" style="width:0%"></div></div>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-database" aria-hidden="true"></i>
                                    <span>Storage Quota</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-field">
                                        <span class="tot-fl">Used</span>
                                        <span class="tot-fv tot-muted">?</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Plan Limit</span>
                                        <span class="tot-fv tot-muted">?</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Utilisation</span>
                                        <span class="tot-fv">
                                            <div class="td-quota-bar"><div class="td-quota-fill" style="width:0%"></div></div>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tot-grid tot-grid--2">
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                                    <span>API Calls / Day</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-field">
                                        <span class="tot-fl">Today</span>
                                        <span class="tot-fv tot-muted">?</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Plan Limit</span>
                                        <span class="tot-fv tot-muted">?</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Utilisation</span>
                                        <span class="tot-fv">
                                            <div class="td-quota-bar"><div class="td-quota-fill" style="width:0%"></div></div>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-speedometer2" aria-hidden="true"></i>
                                    <span>Quota Management</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-empty-hint">
                                        <i class="bi bi-speedometer" aria-hidden="true"></i>
                                        <span>Quota limits and current usage are managed via Platform Quotas.</span>
                                    </div>
                                </div>
                                <div class="tot-card-footer">
                                    <button class="tot-ql" @onclick="OpenResetQuotas">
                                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset quota counters
                                    </button>
                                    <a class="tot-ql" href="/platform/quotas">
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Platform Quotas
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 9: Audit -->
            <TabItem>
                <ChildContent><TabHeader Text="Audit" IconCss="bi bi-journal-text" /></ChildContent>
                <ContentTemplate>
                    <div class="tab-section">
                        <div class="tot-grid tot-grid--2">
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-journal-text" aria-hidden="true"></i>
                                    <span>Audit Log</span>
                                </div>
                                <div class="tot-card-body">
                                    <SfGrid TValue="AuditEntryItem" DataSource="@_auditEntries"
                                            AllowPaging="true" AllowSorting="true"
                                            CssClass="td-sfgrid">
                                        <GridLoadingIndicator Type="LoadingType.Spinner" />
                                        <GridPageSettings PageSize="20" />
                                        <GridColumns>
                                            <GridColumn Field="@nameof(AuditEntryItem.PerformedDateUtc)"
                                                        HeaderText="Date" Width="180" Format="d MMM yyyy, HH:mm" />
                                            <GridColumn Field="@nameof(AuditEntryItem.ActionName)" HeaderText="Action" />
                                            <GridColumn HeaderText="Performed By" Width="160">
                                                <Template>
                                                    @{ var _ae = (context as AuditEntryItem)!; }
                                                    <span>@(_ae.PerformedByUserId.HasValue ? "User" : "System")</span>
                                                </Template>
                                            </GridColumn>
                                        </GridColumns>
                                    </SfGrid>
                                </div>
                                <div class="tot-card-footer">
                                    <button class="tot-ql" @onclick="GoToAudit">
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Full audit trail
                                    </button>
                                </div>
                            </div>
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                                    <span>Tenant Lifecycle</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-field">
                                        <span class="tot-fl">Name</span>
                                        <span class="tot-fv"><strong>@_tenant.TenantName</strong></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Code</span>
                                        <span class="tot-fv"><span class="tot-mono">@_tenant.TenantCode</span></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Current Status</span>
                                        <span class="tot-fv"><AppStatusBadge Status="@_tenant.StatusCode" /></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Created</span>
                                        <span class="tot-fv">@_tenant.CreatedDateUtc.ToString("d MMM yyyy")</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Tenant Age</span>
                                        <span class="tot-fv">@((DateTime.UtcNow - _tenant.CreatedDateUtc).Days) days</span>
                                    </div>
                                    @if (_tenant.GoLiveDateUtc.HasValue)
                                    {
                                        <div class="tot-field">
                                            <span class="tot-fl">Go-Live</span>
                                            <span class="tot-fv">@_tenant.GoLiveDateUtc.Value.ToString("d MMM yyyy")</span>
                                        </div>
                                    }
                                    <div class="tot-field">
                                        <span class="tot-fl">Active Users</span>
                                        <span class="tot-fv"><strong>@_tenant.ActiveUsers</strong></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Domains</span>
                                        <span class="tot-fv"><strong>@_tenantDomains.Count</strong> configured</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Audit Entries</span>
                                        <span class="tot-fv"><strong>@_auditEntries.Count</strong> recent</span>
                                    </div>
                                </div>
                                <div class="tot-card-footer">
                                    <button class="tot-ql" @onclick="GoToAudit">
                                        <i class="bi bi-journal-text" aria-hidden="true"></i> Full audit trail
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 10: Security -->
            <TabItem>
                <ChildContent><TabHeader Text="Security" IconCss="bi bi-shield-lock" /></ChildContent>
                <ContentTemplate>
                    <div class="tab-section">
                        <div class="tot-grid tot-grid--2">
                            <SfCard>
                                <CardHeader Title="Authentication &amp; MFA" />
                                <CardContent>
                                    <div class="tot-card-body">
                                        <div class="tot-field">
                                            <span class="tot-fl">MFA Policy</span>
                                            <span class="tot-fv tot-muted">?</span>
                                        </div>
                                        <div class="tot-field">
                                            <span class="tot-fl">MFA Adoption</span>
                                            <span class="tot-fv tot-muted">?</span>
                                        </div>
                                        <div class="tot-field">
                                            <span class="tot-fl">SSO Provider</span>
                                            <span class="tot-fv tot-muted">?</span>
                                        </div>
                                        <div class="tot-field">
                                            <span class="tot-fl">Password Policy</span>
                                            <span class="tot-fv tot-muted">?</span>
                                        </div>
                                    </div>
                                </CardContent>
                            </SfCard>
                            <SfCard>
                                <CardHeader Title="Session Policy" />
                                <CardContent>
                                    <div class="tot-card-body">
                                        <div class="tot-field">
                                            <span class="tot-fl">Session Timeout</span>
                                            <span class="tot-fv tot-muted">?</span>
                                        </div>
                                        <div class="tot-field">
                                            <span class="tot-fl">Idle Timeout</span>
                                            <span class="tot-fv tot-muted">?</span>
                                        </div>
                                        <div class="tot-field">
                                            <span class="tot-fl">Max Active Sessions</span>
                                            <span class="tot-fv tot-muted">?</span>
                                        </div>
                                        <div class="tot-field">
                                            <span class="tot-fl">IP Restrictions</span>
                                            <span class="tot-fv tot-muted">None configured</span>
                                        </div>
                                    </div>
                                </CardContent>
                            </SfCard>
                        </div>
                        <div class="tot-card" style="margin-top:var(--sp-4)">
                            <div class="tot-card-hdr">
                                <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                                <span>Security Events</span>
                            </div>
                            <div class="tot-card-body">
                                @if (_securityLoading)
                                {
                                    <div class="um-loading-overlay" aria-live="polite">
                                        <div class="um-spinner" aria-hidden="true"></div>
                                        <span>Loading security events?</span>
                                    </div>
                                }
                                else
                                {
                                    <SfGrid TValue="SecurityEventItem" DataSource="@_securityEvents"
                                            AllowPaging="true" AllowSorting="true"
                                            CssClass="td-sfgrid">
                                        <GridPageSettings PageSize="10" />
                                        <GridColumns>
                                            <GridColumn Field="@nameof(SecurityEventItem.OccurredUtc)"
                                                        HeaderText="Date" Width="180" Format="d MMM yyyy, HH:mm" />
                                            <GridColumn Field="@nameof(SecurityEventItem.EventType)" HeaderText="Event" />
                                            <GridColumn Field="@nameof(SecurityEventItem.Severity)" HeaderText="Severity" Width="110" />
                                            <GridColumn Field="@nameof(SecurityEventItem.Actor)" HeaderText="User" Width="160" />
                                        </GridColumns>
                                    </SfGrid>
                                }
                            </div>
                            <div class="tot-card-footer">
                                <a class="tot-ql" href="/platform/security?tenantId=@_tenant.TenantId">
                                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Full security report
                                </a>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 11: Storage -->
            <TabItem>
                <ChildContent><TabHeader Text="Storage" IconCss="bi bi-database" /></ChildContent>
                <ContentTemplate>
                    <div class="tab-section">
                        @if (_storageLoading)
                        {
                            <div class="um-loading-overlay" aria-live="polite">
                                <div class="um-spinner" aria-hidden="true"></div>
                                <span>Loading storage data?</span>
                            </div>
                        }
                        else
                        {
                            <div class="tot-grid tot-grid--2">
                                <SfCard>
                                    <CardHeader Title="Storage Consumption" />
                                    <CardContent>
                                        <div class="tot-card-body">
                                            <div class="td-chart-wrap">
                                                <SfAccumulationChart EnableSmartLabels="true" Height="220px" Background="transparent">
                                                    <AccumulationChartSeriesCollection>
                                                        <AccumulationChartSeries DataSource="@_storageBreakdown"
                                                                                 XName="Category" YName="SizeGb"
                                                                                 InnerRadius="55%" Name="Storage">
                                                            <AccumulationDataLabelSettings Visible="true"
                                                                                           Position="AccumulationLabelPosition.Outside" />
                                                        </AccumulationChartSeries>
                                                    </AccumulationChartSeriesCollection>
                                                    <AccumulationChartLegendSettings Visible="true" />
                                                </SfAccumulationChart>
                                            </div>
                                            <div class="tot-field" style="margin-top:var(--sp-2)">
                                                <span class="tot-fl">Total Used</span>
                                                <span class="tot-fv"><strong>@(_kpiStorageGb is not null ? $"{_kpiStorageGb:F1} GB" : "?")</strong></span>
                                            </div>
                                            <div class="tot-field">
                                                <span class="tot-fl">Plan Limit</span>
                                                <span class="tot-fv tot-muted">?</span>
                                            </div>
                                            <div class="tot-field">
                                                <span class="tot-fl">Utilisation</span>
                                                <span class="tot-fv">
                                                    <div class="td-quota-bar"><div class="td-quota-fill" style="width:0%"></div></div>
                                                </span>
                                            </div>
                                        </div>
                                    </CardContent>
                                </SfCard>
                                <SfCard>
                                    <CardHeader Title="Storage Breakdown" />
                                    <CardContent>
                                        <div class="tot-card-body">
                                            <SfGrid TValue="StorageBreakdownItem" DataSource="@_storageBreakdown"
                                                    AllowSorting="true" CssClass="td-sfgrid">
                                                <GridColumns>
                                                    <GridColumn Field="@nameof(StorageBreakdownItem.Category)" HeaderText="Category" />
                                                    <GridColumn Field="@nameof(StorageBreakdownItem.SizeGb)" HeaderText="Used (GB)" Width="120" Format="N2" />
                                                    <GridColumn Field="@nameof(StorageBreakdownItem.FileCount)" HeaderText="Files" Width="100" />
                                                </GridColumns>
                                            </SfGrid>
                                        </div>
                                    </CardContent>
                                </SfCard>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 12: Integrations -->
            <TabItem>
                <ChildContent><TabHeader Text="Integrations" IconCss="bi bi-plug" /></ChildContent>
                <ContentTemplate>
                    <div class="tab-section">
                        @if (_integrationsLoading)
                        {
                            <div class="um-loading-overlay" aria-live="polite">
                                <div class="um-spinner" aria-hidden="true"></div>
                                <span>Loading integrations?</span>
                            </div>
                        }
                        else
                        {
                            <div class="tot-grid tot-grid--2">
                                <SfCard>
                                    <CardHeader Title="API Keys" />
                                    <CardContent>
                                        <div class="tot-card-body">
                                            <SfGrid TValue="ApiKeyItem" DataSource="@_apiKeys"
                                                    AllowPaging="true" AllowSorting="true"
                                                    CssClass="td-sfgrid">
                                                <GridPageSettings PageSize="5" />
                                                <GridColumns>
                                                    <GridColumn Field="@nameof(ApiKeyItem.Name)" HeaderText="Name" />
                                                    <GridColumn Field="@nameof(ApiKeyItem.Prefix)" HeaderText="Key Prefix" Width="130" />
                                                    <GridColumn Field="@nameof(ApiKeyItem.CreatedUtc)" HeaderText="Created" Width="130" Format="d MMM yyyy" />
                                                    <GridColumn Field="@nameof(ApiKeyItem.Status)" HeaderText="Status" Width="100" />
                                                </GridColumns>
                                            </SfGrid>
                                        </div>
                                    </CardContent>
                                </SfCard>
                                <SfCard>
                                    <CardHeader Title="Webhooks" />
                                    <CardContent>
                                        <div class="tot-card-body">
                                            <SfGrid TValue="WebhookItem" DataSource="@_webhooks"
                                                    AllowPaging="true" AllowSorting="true"
                                                    CssClass="td-sfgrid">
                                                <GridPageSettings PageSize="5" />
                                                <GridColumns>
                                                    <GridColumn Field="@nameof(WebhookItem.Url)" HeaderText="Endpoint URL" />
                                                    <GridColumn Field="@nameof(WebhookItem.Events)" HeaderText="Events" Width="160" />
                                                    <GridColumn Field="@nameof(WebhookItem.Active)" HeaderText="Active" Width="80" DisplayAsCheckBox="true" />
                                                </GridColumns>
                                            </SfGrid>
                                        </div>
                                    </CardContent>
                                </SfCard>
                            </div>
                            <div class="tot-card" style="margin-top:var(--sp-4)">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-app-indicator" aria-hidden="true"></i>
                                    <span>Connected Applications</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-empty-hint">
                                        <i class="bi bi-plug" aria-hidden="true"></i>
                                        <span>No connected applications configured for this tenant.</span>
                                    </div>
                                </div>
                                <div class="tot-card-footer">
                                    <a class="tot-ql" href="/platform/integrations?tenantId=@_tenant!.TenantId">
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Manage integrations
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

        </Tabs>
    </AppDetailTabs>
}

<!-- Upgrade Plan drawer -->
<AppCrudDrawer @bind-Visible="_showUpgradePlan"
               Title="Change Plan"
               Icon="bi-arrow-up-circle"
               OnConfirm="ExecuteUpgradePlanAsync"
               IsBusy="_confirming">
    <Content>
        <p class="td-drawer-hint">Select the new plan for <strong>@_tenant?.TenantName</strong>.</p>
        <div class="form-row">
            <label class="form-label">New Plan <span class="form-required">*</span></label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_planOptions"
                            @bind-Value="_upgradeNewPlan"
                            Placeholder="Select plan">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>
        </div>
    </Content>
</AppCrudDrawer>

<!-- Reset Quotas confirm -->
<AppConfirmActionDialog @bind-Visible="_showResetQuotas"
                        Title="Reset Quotas"
                        Message="@($"Reset all quota counters for \"{_tenant?.TenantName}\"?")"
                        Detail="Quota usage counters will be reset to zero. Hard limits defined by the plan remain unchanged."
                        Variant="warning"
                        ConfirmText="Reset Quotas"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteResetQuotasAsync" />

<!-- Edit drawer -->
<TenantEditDrawer @bind-Visible="_showEdit"
                  Tenant="_tenant"
                  OnSaved="OnEditSavedAsync" />

<!-- Provisioning confirm -->
<AppConfirmActionDialog @bind-Visible="_showProvisioning"
                        Title="Start Provisioning"
                        Message="@($"Start provisioning for \"{_tenant?.TenantName}\"?")"
                        Detail="This will initialise the tenant environment. Ensure all settings are correct before proceeding."
                        Variant="primary"
                        ConfirmText="Proceed"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteProvisioningAsync" />

<!-- Change Region confirm -->
<AppConfirmActionDialog @bind-Visible="_showChangeRegion"
                        Title="Change Region"
                        Message="@($"Change region for \"{_tenant?.TenantName}\"?")"
                        Detail="Changing the region may trigger a data migration. Please confirm this change with the infrastructure team."
                        Variant="warning"
                        ConfirmText="Change Region"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteChangeRegionAsync" />

<!-- Change Isolation confirm -->
<AppConfirmActionDialog @bind-Visible="_showChangeIsolation"
                        Title="Change Isolation Mode"
                        Message="@($"Change isolation mode for \"{_tenant?.TenantName}\"?")"
                        Detail="Switching isolation modes requires infrastructure changes. Confirm with the platform team before proceeding."
                        Variant="warning"
                        ConfirmText="Change Isolation"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteChangeIsolationAsync" />

<!-- Update Features confirm -->
<AppConfirmActionDialog @bind-Visible="_showUpdateFeatures"
                        Title="Update Features"
                        Message="@($"Update feature flags for \"{_tenant?.TenantName}\"?")"
                        Detail="Feature flag changes take effect immediately for all users in this tenant."
                        Variant="primary"
                        ConfirmText="Update"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteUpdateFeaturesAsync" />

<!-- Suspend confirm -->
<AppConfirmActionDialog @bind-Visible="_showSuspend"
                        Title="Suspend Tenant"
                        Message="@($"Suspend \"{_tenant?.TenantName}\"?")"
                        Detail="The tenant and all its users will lose platform access until reactivated."
                        Variant="warning"
                        ConfirmText="Suspend"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteSuspendAsync" />

<!-- Activate confirm -->
<AppConfirmActionDialog @bind-Visible="_showActivate"
                        Title="Activate Tenant"
                        Message="@($"Activate \"{_tenant?.TenantName}\"?")"
                        Detail="The tenant will regain full platform access."
                        Variant="primary"
                        ConfirmText="Activate"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteActivateAsync" />

@code {
    // -- Route parameter -------------------------------------------------------
    [Parameter] public Guid TenantId { get; set; }

    // -- Refs ------------------------------------------------------------------
    private EnterpriseToast? _toast;
    private TenantOverview? _overviewRef;

    // -- Page state ------------------------------------------------------------
    private TenantDto? _tenant;
    private int        _tab;

    // -- Loading flags ---------------------------------------------------------
    private bool _loading             = true;
    private bool _confirming          = false;
    private bool _usersLoading        = false;
    private bool _statusHistoryLoading = false;
    private bool _auditLoading        = false;
    private bool _domainsLoading       = false;
    private bool _brandingLoading      = false;
    private bool _kpiLoading           = false;
    private bool _securityLoading      = false;
    private bool _storageLoading       = false;
    private bool _integrationsLoading  = false;

    // -- Dialog visibility -----------------------------------------------------
    private bool _showEdit            = false;
    private bool _showUpgradePlan      = false;
    private bool _showResetQuotas      = false;
    private bool _showProvisioning    = false;
    private bool _showChangeRegion    = false;
    private bool _showChangeIsolation = false;
    private bool _showUpdateFeatures  = false;
    private bool _showSuspend         = false;
    private bool _showActivate        = false;
    private string _upgradeNewPlan    = string.Empty;

    // -- Tab data --------------------------------------------------------------
    private List<UserListItem>     _users         = [];
    private List<StatusHistoryItem> _statusHistory = [];
    private List<AuditEntryItem>   _auditEntries  = [];
    private List<TenantDomainDto>   _tenantDomains = [];
    private List<BrandingItem>      _tenantBranding = [];

    // -- KPI data -------------------------------------------------------------------------------------
    private int?    _kpiPolicyCount    = null;
    private double? _kpiStorageGb      = null;
    private int?    _kpiAutomationRuns = null;
    private long?   _kpiApiCalls       = null;
    private int?    _kpiPortalUsage    = null;

    // -- Security tab data --------------------------------------------------------------------------
    private List<SecurityEventItem> _securityEvents = [];

    // -- Storage tab data --------------------------------------------------------------------------
    private List<StorageBreakdownItem> _storageBreakdown = [];

    // -- Integrations tab data ----------------------------------------------------------------------
    private List<ApiKeyItem>  _apiKeys  = [];
    private List<WebhookItem> _webhooks = [];

    // -- Activity chart data -----------------------------------------------------------------------
    private List<ActivityPoint> _activityData = [];

    // -- Options ---------------------------------------------------------------
    private static readonly List<LabelValue> _isolationOptions =
    [
        new("Shared",    "Shared"),
        new("Dedicated", "Dedicated"),
    ];
    private static readonly List<LabelValue> _planOptions =
    [
        new("Starter",    "Starter"),
        new("Growth",     "Growth"),
        new("Enterprise", "Enterprise"),
    ];

    // -- Computed --------------------------------------------------------------
    private string PageTitle       => _tenant?.TenantName ?? "Tenant Detail";
    private string StatusMetricClass => _tenant?.StatusCode switch
    {
        "Active"     => "td-metric-value--green",
        "Suspended"  => "td-metric-value--amber",
        "Terminated" => "td-metric-value--red",
        _            => string.Empty
    };

    // -- Lifecycle -------------------------------------------------------------
    protected override async Task OnParametersSetAsync()
    {
        await EnsureTenantContextAsync();
        if (_tenant?.TenantId == TenantId) return;
        await LoadAsync();
    }

    private void NavigateToBranding() => Nav.NavigateTo($"/platform/tenants/{TenantId}/branding");

    private async Task LoadBrandingAsync()
    {
        _brandingLoading = true;
        StateHasChanged();
        try
        {
            // TODO: replace with Api.GetTenantBrandingAsync(TenantId) when available
            _tenantBranding = [];
        }
        catch
        {
            _tenantBranding = [];
        }
        finally
        {
            _brandingLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadKpisAsync()
    {
        _kpiLoading = true;
        StateHasChanged();
        try
        {
            // TODO: wire to real API endpoints when available
            await Task.Delay(0);
            _kpiPolicyCount    = null;
            _kpiStorageGb      = null;
            _kpiAutomationRuns = null;
            _kpiApiCalls       = null;
            _kpiPortalUsage    = null;
            _activityData      = [];
        }
        catch { /* swallow */ }
        finally
        {
            _kpiLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadSecurityTabAsync()
    {
        _securityLoading = true;
        StateHasChanged();
        try
        {
            // TODO: replace with Api.GetTenantSecurityEventsAsync(TenantId)
            _securityEvents = [];
        }
        catch { _securityEvents = []; }
        finally
        {
            _securityLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadStorageTabAsync()
    {
        _storageLoading = true;
        StateHasChanged();
        try
        {
            // TODO: replace with Api.GetTenantStorageBreakdownAsync(TenantId)
            await Task.Delay(0);
            _storageBreakdown = [];
        }
        catch { _storageBreakdown = []; }
        finally
        {
            _storageLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadIntegrationsTabAsync()
    {
        _integrationsLoading = true;
        StateHasChanged();
        try
        {
            // TODO: replace with Api.GetTenantApiKeysAsync / GetTenantWebhooksAsync
            await Task.Delay(0);
            _apiKeys  = [];
            _webhooks = [];
        }
        catch { _apiKeys = []; _webhooks = []; }
        finally
        {
            _integrationsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _tenant  = null;
        _users.Clear();
        _statusHistory.Clear();
        _auditEntries.Clear();
        _tenantDomains.Clear();
        StateHasChanged();

        try
        {
            _tenant = await Api.GetTenantByIdAsync(TenantId);
            SetCrumbs();
            if (_overviewRef is not null)
                await _overviewRef.LoadAsync();
            _ = LoadKpisAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetCrumbs()
    {
        Breadcrumbs.SetCrumbs(
            new BreadcrumbService.BreadcrumbItem("Home",     "/"),
            new BreadcrumbService.BreadcrumbItem("Platform", "/platform"),
            new BreadcrumbService.BreadcrumbItem("Tenants",  "/platform/tenants"),
            new BreadcrumbService.BreadcrumbItem(_tenant?.TenantName ?? "Detail", null));
    }

    // -- Tab handling ----------------------------------------------------------
    private async Task OnTabChangedAsync(int tab)
    {
        _tab = tab;
        await LoadTabDataAsync(tab);
    }

    private async Task LoadTabDataAsync(int tab)
    {
        switch (tab)
        {
            case 2 when _tenantBranding.Count == 0:
                    await LoadBrandingAsync();
                    break;
                case 3 when _tenantDomains.Count == 0:
                    await LoadDomainsAsync();
                    break;
            case 9 when _auditEntries.Count == 0:
                await LoadAuditTabAsync();
                break;
            case 10 when _securityEvents.Count == 0:
                await LoadSecurityTabAsync();
                break;
            case 11 when _storageBreakdown.Count == 0:
                await LoadStorageTabAsync();
                break;
            case 12 when _apiKeys.Count == 0:
                await LoadIntegrationsTabAsync();
                break;
        }
    }

    private async Task LoadUsersTabAsync()
    {
        _usersLoading = true;
        StateHasChanged();
        try
        {
            var result = await Api.SearchUsersAsync(TenantId);
            _users = result?.Items
                .Select(u => new UserListItem(u.UserId, u.FullName, u.Email, u.StatusCode))
                .ToList() ?? [];
        }
        finally
        {
            _usersLoading = false;
        }
    }

    private async Task LoadDomainsAsync()
    {
        _domainsLoading = true;
        StateHasChanged();
        try
        {
            var result = await Api.SearchTenantDomainsAsync(TenantId, pageSize: 200);
            _tenantDomains = result?.Items?.ToList() ?? [];
        }
        catch
        {
            _tenantDomains = [];
        }
        finally
        {
            _domainsLoading = false;
            StateHasChanged();
        }
    }

    private static string DomainSslPillClass(string status) => status switch
    {
        "Active" => "td-pill--success",
        "Provisioning" => "td-pill--info",
        "Expired" => "td-pill--danger",
        _ => "td-pill--muted"
    };

    private static string DomainVerificationPillClass(string status) => status switch
    {
        "Verified" => "td-pill--success",
        "Pending" => "td-pill--warning",
        "Failed" => "td-pill--danger",
        _ => "td-pill--muted"
    };

    private void NavigateToDomains() => Nav.NavigateTo($"/platform/tenants/{TenantId}/domains");

    private async Task LoadStatusHistoryTabAsync()
    {
        _statusHistoryLoading = true;
        StateHasChanged();
        try
        {
            // Status history will be populated from audit log when endpoint is available
            _statusHistory = [];
        }
        finally
        {
            _statusHistoryLoading = false;
        }
    }

    private async Task LoadAuditTabAsync()
    {
        _auditLoading = true;
        StateHasChanged();
        try
        {
            // Audit entries will be populated when endpoint is available
            _auditEntries = [];
        }
        finally
        {
            _auditLoading = false;
        }
    }

    // -- Openers ---------------------------------------------------------------
    private void OpenEdit()
    {
        if (_tenant is null) return;
        _showEdit = true;
    }

    private async Task OnEditSavedAsync(bool _)
    {
        await ShowToastAsync("Tenant updated.", "Success");
        await LoadAsync();
    }

    private void OpenSuspend()         => _showSuspend         = true;
    private void OpenActivate()        => _showActivate        = true;
    private void OpenProvisioning()    => _showProvisioning    = true;
    private void OpenChangeRegion()    => _showChangeRegion    = true;
    private void OpenChangeIsolation() => _showChangeIsolation = true;
    private void OpenUpdateFeatures()  => _showUpdateFeatures  = true;

    private void OpenUpgradePlan()
    {
        if (_tenant is null) return;
        _upgradeNewPlan  = _tenant.PlanCode;
        _showUpgradePlan = true;
    }

    private void OpenResetQuotas() => _showResetQuotas = true;

    private void GoToAudit()
    {
        _tab = 9;
        StateHasChanged();
    }

    private void NavigateToList() => Nav.NavigateTo("/platform/tenants");

    // -- Lifecycle actions -----------------------------------------------------
    private async Task ExecuteSuspendAsync()
    {
        if (_tenant is null) return;
        _confirming = true;
        try
        {
            await Api.SuspendTenantAsync(_tenant.TenantId);
            _showSuspend = false;
            await ShowToastAsync($"\"{_tenant.TenantName}\" suspended.", "Success");
            await LoadAsync();
        }
        catch { await ShowToastAsync("Failed to suspend tenant.", "Error"); }
        finally { _confirming = false; }
    }

    private async Task ExecuteActivateAsync()
    {
        if (_tenant is null) return;
        _confirming = true;
        try
        {
            await Api.ActivateTenantAsync(_tenant.TenantId);
            _showActivate = false;
            await ShowToastAsync($"\"{_tenant.TenantName}\" activated.", "Success");
            await LoadAsync();
        }
        catch { await ShowToastAsync("Failed to activate tenant.", "Error"); }
        finally { _confirming = false; }
    }

    private async Task ExecuteProvisioningAsync()
    {
        _confirming = true;
        try
        {
            _showProvisioning = false;
            await ShowToastAsync("Provisioning initiated.", "Success");
        }
        finally { _confirming = false; }
    }

    private async Task ExecuteChangeRegionAsync()
    {
        _confirming = true;
        try
        {
            _showChangeRegion = false;
            await ShowToastAsync("Region change request submitted.", "Success");
        }
        finally { _confirming = false; }
    }

    private async Task ExecuteChangeIsolationAsync()
    {
        _confirming = true;
        try
        {
            _showChangeIsolation = false;
            await ShowToastAsync("Isolation mode change request submitted.", "Success");
        }
        finally { _confirming = false; }
    }

    private async Task ExecuteUpdateFeaturesAsync()
    {
        _confirming = true;
        try
        {
            _showUpdateFeatures = false;
            await ShowToastAsync("Feature flags updated.", "Success");
        }
        finally { _confirming = false; }
    }

    private async Task ExecuteUpgradePlanAsync()
    {
        if (_tenant is null || string.IsNullOrWhiteSpace(_upgradeNewPlan)) return;
        _confirming = true;
        try
        {
            await Api.UpdateTenantAsync(_tenant.TenantId, new UpdateTenantRequest
            {
                TenantName    = _tenant.TenantName,
                PlanCode      = _upgradeNewPlan,
                RegionCode    = _tenant.RegionCode,
                IsolationMode = _tenant.IsolationMode,
                PrimaryDomain = _tenant.PrimaryDomain,
                Locale        = _tenant.Locale,
                CurrencyCode  = _tenant.CurrencyCode,
                TimeZoneId    = _tenant.TimeZoneId,
                GoLiveDateUtc = _tenant.GoLiveDateUtc,
            });
            _showUpgradePlan = false;
            await ShowToastAsync($"Plan changed to {_upgradeNewPlan}.", "Success");
            await LoadAsync();
        }
        catch { await ShowToastAsync("Failed to update plan.", "Error"); }
        finally { _confirming = false; }
    }

    private async Task ExecuteResetQuotasAsync()
    {
        _confirming = true;
        try
        {
            _showResetQuotas = false;
            await ShowToastAsync("Quota counters reset.", "Success");
        }
        finally { _confirming = false; }
    }

    // -- Helpers ---------------------------------------------------------------
    private static string UserInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : name[..Math.Min(2, name.Length)].ToUpper();
    }

    private async Task ShowToastAsync(string message, string type)
    {
        if (_toast is null) return;
        await _toast.ShowAsync(new ToastModel
        {
            Content      = message,
            CssClass     = type == "Error" ? "e-toast-danger" : "e-toast-success",
            Icon         = type == "Error" ? "e-error toast-icons" : "e-success toast-icons",
            ShowCloseButton = true,
        });
    }

    // -- View models -----------------------------------------------------------
    private record LabelValue(string Label, string Value);

    private record UserListItem(Guid UserId, string FullName, string Email, string StatusCode);

    private record StatusHistoryItem(string ActionCode, DateTime Date, string Actor, string? Notes);

    private record AuditEntryItem(string ActionName, DateTime PerformedDateUtc, Guid? PerformedByUserId);

    private sealed record BrandingItem(
        string Category,
        string CategoryIcon,
        string Setting,
        string CurrentValue,
        bool   IsColor,
        bool   IsLongText,
        string Placeholder);

    private record SecurityEventItem(DateTime OccurredUtc, string EventType, string Severity, string Actor);

    private record StorageBreakdownItem(string Category, double SizeGb, int FileCount);

    private record ActivityPoint(string Month, int ApiCalls, int AutomationRuns);

    private record ApiKeyItem(string Name, string Prefix, DateTime CreatedUtc, string Status);

    private record WebhookItem(string Url, string Events, bool Active);

    
    private async Task EnsureTenantContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        if (TenantId == Guid.Empty) TenantId = context.TenantId;
    }
}
