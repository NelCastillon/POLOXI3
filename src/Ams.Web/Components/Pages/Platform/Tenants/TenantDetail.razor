            <!-- 7: Region & Deployment -->
            <TabItem>
                <ChildContent><TabHeader Text="Region &amp; Deployment" IconCss="bi bi-geo-alt" /></ChildContent>
                <ContentTemplate>
                    <div class="tab-section">
                        <div class="tot-grid tot-grid--2">
