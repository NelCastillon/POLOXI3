@page "/platform/tenants/{TenantId:guid}"
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Tenants
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@PageTitle — Platform</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@if (_loading)
{
    <div class="td-loading">
        <span class="um-spin td-loading-spin" aria-hidden="true"></span>
        <span>Loading tenant…</span>
    </div>
}
else if (_tenant is null)
{
    <div class="td-not-found">
        <i class="bi bi-buildings td-not-found-icon" aria-hidden="true"></i>
        <h2>Tenant not found</h2>
        <p>The requested tenant could not be loaded.</p>
        <button class="um-btn um-btn-ghost" @onclick="NavigateToList">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Tenants
        </button>
    </div>
}
else
{
    <AppPageHeader Title="@PageTitle"
                   Subtitle="@_tenant.TenantCode"
                   Icon="bi-buildings">
        <Actions>
            <button class="um-btn um-btn-ghost" @onclick="OpenEdit">
                <i class="bi bi-pencil" aria-hidden="true"></i> Edit Tenant
            </button>
            @if (_tenant.StatusCode == "Active")
            {
                <button class="um-btn um-btn-warning" @onclick="OpenSuspend">
                    <i class="bi bi-pause-circle" aria-hidden="true"></i> Suspend
                </button>
            }
            else if (_tenant.StatusCode == "Suspended")
            {
                <button class="um-btn um-btn-primary" @onclick="OpenActivate">
                    <i class="bi bi-play-circle" aria-hidden="true"></i> Activate
                </button>
            }
            <button class="um-btn um-btn-ghost" @onclick="OpenUpgradePlan">
                <i class="bi bi-arrow-up-circle" aria-hidden="true"></i> Upgrade Plan
            </button>
            <button class="um-btn um-btn-ghost" @onclick="OpenChangeRegion">
                <i class="bi bi-geo-alt" aria-hidden="true"></i> Move Region
            </button>
            <button class="um-btn um-btn-ghost" @onclick="OpenResetQuotas">
                <i class="bi bi-speedometer" aria-hidden="true"></i> Reset Quotas
            </button>
            <button class="um-btn um-btn-ghost" @onclick="GoToAudit">
                <i class="bi bi-journal-text" aria-hidden="true"></i> Open Audit
            </button>
        </Actions>
    </AppPageHeader>

    <!-- Stats bar -->
    <div class="td-stats-bar">
        <div class="td-stats-icon-wrap" aria-hidden="true">
            <i class="bi bi-buildings td-stats-icon"></i>
        </div>
        <div class="td-stats">
            <AppStatusBadge Status="@_tenant.StatusCode" />
            @if (!string.IsNullOrEmpty(_tenant.PlanCode))
            {
                <span class="badge badge-blue">
                    <i class="bi bi-award" aria-hidden="true"></i> @_tenant.PlanCode
                </span>
            }
            @if (!string.IsNullOrEmpty(_tenant.RegionCode))
            {
                <span class="td-stat-chip">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i> @_tenant.RegionCode
                </span>
            }
            @if (!string.IsNullOrEmpty(_tenant.IsolationMode))
            {
                <span class="td-stat-chip">
                    <i class="bi bi-layers" aria-hidden="true"></i> @_tenant.IsolationMode
                </span>
            }
            @if (!string.IsNullOrEmpty(_tenant.PrimaryDomain))
            {
                <span class="td-stat-chip">
                    <i class="bi bi-globe" aria-hidden="true"></i> @_tenant.PrimaryDomain
                </span>
            }
            <span class="td-stat-chip">
                <i class="bi bi-people" aria-hidden="true"></i> @_tenant.ActiveUsers users
            </span>
            <span class="td-stat-chip">
                <i class="bi bi-calendar3" aria-hidden="true"></i> Created @_tenant.CreatedDateUtc.ToString("d")
            </span>
        </div>
    </div>

    <!-- Tabs: 0 Overview · 1 Configuration · 2 Branding · 3 Domains · 4 Subscription · 5 Features · 6 Usage · 7 Region & Deployment · 8 Quotas · 9 Audit -->
    <AppDetailTabs SelectedTab="_tab" SelectedTabChanged="OnTabChangedAsync">
        <Tabs>

            <!-- 0: Overview -->
            <TabItem>
                <ChildContent><TabHeader Text="Overview" IconCss="bi bi-grid-1x2" /></ChildContent>
                <ContentTemplate>
                    <TenantOverview TenantId="TenantId" OnJumpToTab="OnTabChangedAsync" @ref="_overviewRef" />
                </ContentTemplate>
            </TabItem>

            <!-- 1: Configuration -->
            <TabItem>
                <ChildContent><TabHeader Text="Configuration" IconCss="bi bi-sliders" /></ChildContent>
                <ContentTemplate>
                    <div class="tab-section">
                        @if (_tenant.StatusCode != "Active")
                        {
                            <div class="tot-alert tot-alert--info">
                                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                <span>This tenant is currently <strong>@_tenant.StatusCode</strong>. Configuration changes can be saved, but users will not have platform access until the tenant is reactivated.</span>
                            </div>
                        }
                        <div class="tot-grid tot-grid--2">
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-translate" aria-hidden="true"></i>
                                    <span>Localisation &amp; Internationalisation</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-field">
                                        <span class="tot-fl">Locale</span>
                                        <span class="tot-fv"><span class="tot-mono">@(_tenant.Locale.Length > 0 ? _tenant.Locale : "—")</span></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Currency</span>
                                        <span class="tot-fv"><span class="tot-mono">@(_tenant.CurrencyCode.Length > 0 ? _tenant.CurrencyCode : "—")</span></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Time Zone</span>
                                        <span class="tot-fv"><span class="tot-mono">@(_tenant.TimeZoneId.Length > 0 ? _tenant.TimeZoneId : "—")</span></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Go-Live Date</span>
                                        <span class="tot-fv">
                                            @if (_tenant.GoLiveDateUtc.HasValue)
                                            { <strong>@_tenant.GoLiveDateUtc.Value.ToString("d MMM yyyy")</strong> }
                                            else { <span class="tot-muted">Not scheduled</span> }
                                        </span>
                                    </div>
                                </div>
                                <div class="tot-card-footer">
                                    <button class="tot-ql" @onclick="OpenEdit">
                                        <i class="bi bi-pencil" aria-hidden="true"></i> Edit settings
                                    </button>
                                </div>
                            </div>
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-buildings" aria-hidden="true"></i>
                                    <span>Tenant Identity</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-field">
                                        <span class="tot-fl">Name</span>
                                        <span class="tot-fv"><strong>@_tenant.TenantName</strong></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Code</span>
                                        <span class="tot-fv"><span class="tot-mono">@_tenant.TenantCode</span></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Status</span>
                                        <span class="tot-fv"><AppStatusBadge Status="@_tenant.StatusCode" /></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Plan</span>
                                        <span class="tot-fv">
                                            @if (!string.IsNullOrEmpty(_tenant.PlanCode))
                                            { <span class="badge badge-blue"><i class="bi bi-award" aria-hidden="true"></i> @_tenant.PlanCode</span> }
                                            else { <span class="tot-muted">No plan assigned</span> }
                                        </span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Primary Domain</span>
                                        <span class="tot-fv">
                                            @if (!string.IsNullOrEmpty(_tenant.PrimaryDomain))
                                            { <span class="tot-mono">@_tenant.PrimaryDomain</span> }
                                            else { <span class="tot-muted">—</span> }
                                        </span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Active Users</span>
                                        <span class="tot-fv"><strong>@_tenant.ActiveUsers</strong></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Created</span>
                                        <span class="tot-fv">@_tenant.CreatedDateUtc.ToString("d MMM yyyy")</span>
                                    </div>
                                </div>
                                <div class="tot-card-footer">
                                    <button class="tot-ql" @onclick="OpenEdit">
                                        <i class="bi bi-pencil" aria-hidden="true"></i> Edit tenant
                                    </button>
                                    <a class="tot-ql" href="/platform/configuration">
                                        <i class="bi bi-sliders" aria-hidden="true"></i> Platform Configuration
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 2: Branding -->
            <TabItem>
                <ChildContent><TabHeader Text="Branding" IconCss="bi bi-palette" /></ChildContent>
                <ContentTemplate>
                    <div class="tab-section">
                        @if (_brandingLoading)
                        {
                            <div class="um-loading-overlay" aria-live="polite">
                                <div class="um-spinner" aria-hidden="true"></div>
                                <span>Loading branding…</span>
                            </div>
                        }
                        else
                        {
                            <div class="tot-grid tot-grid--2">
                                <div class="tot-card">
                                    <div class="tot-card-hdr">
                                        <i class="bi bi-card-text" aria-hidden="true"></i>
                                        <span>Brand Identity</span>
                                    </div>
                                    <div class="tot-card-body">
                                        @{ var _brandIdentity = _tenantBranding.Where(b => b.Category == "Identity").ToList(); }
                                        @if (_brandIdentity.Count > 0)
                                        {
                                            @foreach (var b in _brandIdentity)
                                            {
                                                <div class="tot-field">
                                                    <span class="tot-fl">@b.Setting</span>
                                                    <span class="tot-fv">@(string.IsNullOrEmpty(b.CurrentValue) ? "—" : b.CurrentValue)</span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="tot-empty-hint">
                                                <i class="bi bi-palette2" aria-hidden="true"></i>
                                                <span>No branding configured for this tenant.</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="tot-card-footer">
                                        <button class="tot-ql" @onclick="NavigateToBranding">
                                            <i class="bi bi-palette" aria-hidden="true"></i> Manage branding
                                        </button>
                                    </div>
                                </div>
                                <div class="tot-card">
                                    <div class="tot-card-hdr">
                                        <i class="bi bi-droplet-half" aria-hidden="true"></i>
                                        <span>Colours &amp; Assets</span>
                                    </div>
                                    <div class="tot-card-body">
                                        @{ var _brandColours = _tenantBranding.Where(b => b.IsColor || b.Category == "Assets").ToList(); }
                                        @if (_brandColours.Count > 0)
                                        {
                                            @foreach (var b in _brandColours)
                                            {
                                                <div class="tot-field">
                                                    <span class="tot-fl">@b.Setting</span>
                                                    <span class="tot-fv">
                                                        @if (b.IsColor && !string.IsNullOrEmpty(b.CurrentValue))
                                                        {
                                                            <span style="display:inline-flex;align-items:center;gap:6px;">
                                                                <span style="display:inline-block;width:14px;height:14px;border-radius:3px;background:@b.CurrentValue;border:1px solid #ccc;"></span>
                                                                <span class="tot-mono">@b.CurrentValue</span>
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span>@(string.IsNullOrEmpty(b.CurrentValue) ? "—" : b.CurrentValue)</span>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="tot-empty-hint">
                                                <i class="bi bi-droplet" aria-hidden="true"></i>
                                                <span>No colour or asset settings found.</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="tot-card-footer">
                                        <button class="tot-ql" @onclick="NavigateToBranding">
                                            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Configure colours &amp; assets
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 3: Domains -->
            <TabItem>
                <ChildContent><TabHeader Text="Domains" IconCss="bi bi-globe" /></ChildContent>
                <ContentTemplate>
                    <div class="tab-section">
                        @if (_domainsLoading)
                        {
                            <div class="um-loading-overlay" aria-live="polite">
                                <div class="um-spinner" aria-hidden="true"></div>
                                <span>Loading domains…</span>
                            </div>
                        }
                        else if (_tenantDomains.Count == 0)
                        {
                            <div class="tot-grid tot-grid--2">
                                <div class="tot-card">
                                    <div class="tot-card-hdr">
                                        <i class="bi bi-globe" aria-hidden="true"></i>
                                        <span>Domain Configuration</span>
                                    </div>
                                    <div class="tot-card-body">
                                        <div class="tot-empty-hint">
                                            <i class="bi bi-globe2" aria-hidden="true"></i>
                                            <span>No domains configured for this tenant.</span>
                                        </div>
                                    </div>
                                    <div class="tot-card-footer">
                                        <a class="tot-ql" href="/platform/tenants/@TenantId/domains">
                                            <i class="bi bi-plus-circle" aria-hidden="true"></i> Add a domain
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="tot-grid tot-grid--2">
                                <div class="tot-card">
                                    <div class="tot-card-hdr">
                                        <i class="bi bi-globe" aria-hidden="true"></i>
                                        <span>Domains &nbsp;<span class="td-stat-chip">@_tenantDomains.Count</span></span>
                                    </div>
                                    <div class="tot-card-body">
                                        <div class="td-audit-list">
                                            @foreach (var domain in _tenantDomains)
                                            {
                                                <div class="td-audit-row">
                                                    <span class="td-audit-icon" aria-hidden="true">
                                                        <i class="bi @(domain.IsPrimary ? "bi-star-fill" : "bi-globe2")"></i>
                                                    </span>
                                                    <div class="td-audit-info">
                                                        <span class="td-audit-action"><span class="tot-mono">@domain.DomainName</span></span>
                                                        <span class="td-audit-meta">
                                                            Added @domain.CreatedDateUtc.ToString("d MMM yyyy")
                                                            @if (!string.IsNullOrEmpty(domain.RedirectTarget))
                                                            {
                                                                <span>&nbsp;· Redirects to <span class="tot-mono">@domain.RedirectTarget</span></span>
                                                            }
                                                        </span>
                                                    </div>
                                                    <span style="display:flex;gap:4px;flex-shrink:0;align-items:center;flex-wrap:wrap;justify-content:flex-end;">
                                                        @if (domain.IsPrimary) { <span class="badge badge-blue">Primary</span> }
                                                        <span class="td-pill @DomainVerificationPillClass(domain.VerificationStatusCode)">@domain.VerificationStatusCode</span>
                                                        <span class="td-pill @DomainSslPillClass(domain.SslStatusCode)">SSL: @domain.SslStatusCode</span>
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="tot-card-footer">
                                        <button class="tot-ql" @onclick="NavigateToDomains">
                                            <i class="bi bi-globe" aria-hidden="true"></i> Manage domains
                                        </button>
                                        <a class="tot-ql" href="/platform/tenants/@TenantId/domains">
                                            <i class="bi bi-plus-circle" aria-hidden="true"></i> Add domain
                                        </a>
                                    </div>
                                </div>
                                <div class="tot-card">
                                    <div class="tot-card-hdr">
                                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                                        <span>Domain Health</span>
                                    </div>
                                    <div class="tot-card-body">
                                        <div class="tot-field">
                                            <span class="tot-fl">Total</span>
                                            <span class="tot-fv"><strong>@_tenantDomains.Count</strong> domain@(_tenantDomains.Count == 1 ? "" : "s")</span>
                                        </div>
                                        <div class="tot-field">
                                            <span class="tot-fl">Verified</span>
                                            <span class="tot-fv"><strong>@_tenantDomains.Count(d => d.VerificationStatusCode == "Verified")</strong> of @_tenantDomains.Count</span>
                                        </div>
                                        <div class="tot-field">
                                            <span class="tot-fl">SSL Active</span>
                                            <span class="tot-fv"><strong>@_tenantDomains.Count(d => d.SslStatusCode == "Active")</strong> of @_tenantDomains.Count</span>
                                        </div>
                                        <div class="tot-field">
                                            <span class="tot-fl">Primary Domain</span>
                                            <span class="tot-fv">
                                                @{ var _primaryDomain = _tenantDomains.FirstOrDefault(d => d.IsPrimary); }
                                                @if (_primaryDomain is not null)
                                                { <span class="tot-mono">@_primaryDomain.DomainName</span> }
                                                else { <span class="tot-muted">None designated</span> }
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 4: Subscription -->
            <TabItem>
                <ChildContent><TabHeader Text="Subscription" IconCss="bi bi-card-checklist" /></ChildContent>
                <ContentTemplate>
                    <div class="tab-section">
                        <div class="tot-grid tot-grid--2">
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-award" aria-hidden="true"></i>
                                    <span>Plan &amp; Billing</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-plan-hero">
                                        @if (!string.IsNullOrEmpty(_tenant.PlanCode))
                                        { <span class="badge badge-blue"><i class="bi bi-award" aria-hidden="true"></i> @_tenant.PlanCode</span> }
                                        else { <span class="tot-muted">No plan assigned</span> }
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Tenant Status</span>
                                        <span class="tot-fv"><AppStatusBadge Status="@_tenant.StatusCode" /></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Go-Live Date</span>
                                        <span class="tot-fv">
                                            @if (_tenant.GoLiveDateUtc.HasValue)
                                            { <strong>@_tenant.GoLiveDateUtc.Value.ToString("d MMM yyyy")</strong> }
                                            else { <span class="tot-muted">Not scheduled</span> }
                                        </span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Tenant ID</span>
                                        <span class="tot-fv"><span class="tot-mono">@_tenant.TenantId</span></span>
                                    </div>
                                </div>
                                <div class="tot-card-footer">
                                    <button class="tot-ql" @onclick="OpenUpgradePlan">
                                        <i class="bi bi-arrow-up-circle" aria-hidden="true"></i> Change plan
                                    </button>
                                </div>
                            </div>
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-receipt" aria-hidden="true"></i>
                                    <span>Billing &amp; Invoicing</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-field">
                                        <span class="tot-fl">Billing Currency</span>
                                        <span class="tot-fv"><span class="tot-mono">@(_tenant.CurrencyCode.Length > 0 ? _tenant.CurrencyCode : "—")</span></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Subscription</span>
                                        <span class="tot-fv tot-muted">Managed via Platform</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Payment Method</span>
                                        <span class="tot-fv tot-muted">—</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Billing Frequency</span>
                                        <span class="tot-fv tot-muted">—</span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Next Renewal</span>
                                        <span class="tot-fv tot-muted">—</span>
                                    </div>
                                </div>
                                <div class="tot-card-footer">
                                    <a class="tot-ql" href="/platform/subscriptions?tenantId=@_tenant.TenantId">
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> View subscriptions
                                    </a>
                                    <a class="tot-ql" href="/platform/invoices?tenantId=@_tenant.TenantId">
                                        <i class="bi bi-receipt" aria-hidden="true"></i> View invoices
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 5: Features -->
            <TabItem>
                <ChildContent><TabHeader Text="Features" IconCss="bi bi-toggles" /></ChildContent>
                <ContentTemplate>
                    <div class="tab-section">
                        <div class="tot-grid tot-grid--2">
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-toggles" aria-hidden="true"></i>
                                    <span>Feature Flags</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-alert tot-alert--info">
                                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                                        <span>Feature flags control which platform modules and capabilities are available to this tenant's users.</span>
                                    </div>
                                    <div class="tot-empty-hint">
                                        <i class="bi bi-toggles2" aria-hidden="true"></i>
                                        <span>No overrides configured. All capabilities follow the <strong>@(_tenant.PlanCode.Length > 0 ? _tenant.PlanCode : "default")</strong> plan defaults.</span>
                                    </div>
                                </div>
                                <div class="tot-card-footer">
                                    <a class="tot-ql" href="/platform/tenants/@_tenant.TenantId/features">
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Manage feature flags
                                    </a>
                                </div>
                            </div>
                            <div class="tot-card">
                                <div class="tot-card-hdr">
                                    <i class="bi bi-check2-all" aria-hidden="true"></i>
                                    <span>Platform Capabilities</span>
                                </div>
                                <div class="tot-card-body">
                                    <div class="tot-field">
                                        <span class="tot-fl">Active Plan</span>
                                        <span class="tot-fv">
                                            @if (!string.IsNullOrEmpty(_tenant.PlanCode))
                                            { <span class="badge badge-blue"><i class="bi bi-award" aria-hidden="true"></i> @_tenant.PlanCode</span> }
                                            else { <span class="tot-muted">No plan</span> }
                                        </span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">CRM &amp; Sales</span>
                                        <span class="tot-fv"><span class="td-pill td-pill--green">Included</span></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Finance &amp; Billing</span>
                                        <span class="tot-fv"><span class="td-pill td-pill--green">Included</span></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Workflow &amp; Approvals</span>
                                        <span class="tot-fv"><span class="td-pill td-pill--green">Included</span></span>
                                    </div>
                                    <div class="tot-field">
                                        <span class="tot-fl">Document Management</span>
                                        <span class="tot-fv"><span class="td-pill td-pill--green">Included</span></span>
                                    </div>
                                    <div class="tot-field">
