    private async Task ExecuteUpgradePlanAsync()
    {
        if (_tenant is null || string.IsNullOrWhiteSpace(_upgradeNewPlan)) return;
        _confirming = true;
        try
        {
            await Api.UpdateTenantAsync(_tenant.TenantId, new UpdateTenantRequest
            {
                TenantName    = _tenant.TenantName,
                PlanCode      = _upgradeNewPlan,
                RegionCode    = _tenant.RegionCode,
                IsolationMode = _tenant.IsolationMode,
                PrimaryDomain = _tenant.PrimaryDomain,
                Locale        = _tenant.Locale,
                CurrencyCode  = _tenant.CurrencyCode,
                TimeZoneId    = _tenant.TimeZoneId,
                GoLiveDateUtc = _tenant.GoLiveDateUtc,
            });
            _showUpgradePlan = false;
            await ShowToastAsync($"Plan changed to {_upgradeNewPlan}.", "Success");
            await LoadAsync();
        }
        catch { await ShowToastAsync("Failed to update plan.", "Error"); }
        finally { _confirming = false; }
    }

