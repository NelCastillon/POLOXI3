        if (_form.HipaaReady)
            notes.Add(new("HIPAA-ready mode enables encrypted PHI storage, enhanced audit logging, and automatic session timeouts.", "info", "bi-lock"));

        if (!string.IsNullOrWhiteSpace(_form.SecondaryRegionCode))
            notes.Add(new($"DR region assigned ? automated failover routing to {_regionOptions.FirstOrDefault(r => r.Value == _form.SecondaryRegionCode)?.Label ?? _form.SecondaryRegionCode} will be configured.", "info", "bi-arrow-repeat"));

        if (_form.DataResidencyRequirement is "EU" or "US" or "AU" or "CA")
            notes.Add(new($"{_form.DataResidencyRequirement} data residency ? all data will be pinned to {_form.DataResidencyRequirement}-based infrastructure. Cross-region replication outside this zone is disabled.", "warning", "bi-pin-map"));

