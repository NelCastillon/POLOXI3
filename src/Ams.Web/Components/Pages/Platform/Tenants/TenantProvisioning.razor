    private async Task ShowToastAsync(string message, string type)
    {
        if (_toast is null) return;
        await _toast.ShowAsync(new ToastModel
        {
            Content         = message,
            CssClass        = type == "Error" ? "e-toast-danger" : "e-toast-success",
            Icon            = type == "Error" ? "e-error toast-icons" : "e-success toast-icons",
            ShowCloseButton = true,
        });
    }

