            notes.Add(new("Custom branding is set ? logo and white-label name will be applied on first portal load after provisioning.", "info", "bi-palette"));
        if (!string.IsNullOrWhiteSpace(_form.FaviconUrl))
            notes.Add(new("Custom favicon set ? browser tab icon will update within 24 hours due to browser caching.", "info", "bi-image"));
        if (_form.EmailBrandingProfile == "Custom")
            notes.Add(new("Custom email branding profile selected ? an email template must be configured in Settings before the first outgoing email.", "warning", "bi-envelope"));

        if (_form.EnabledAddons.Contains("AI_ASSIST"))
            notes.Add(new("AI Assistant requires consent acknowledgement from the tenant admin on first login.", "info", "bi-robot"));

        if (_form.TrialEnabled)
            notes.Add(new("Trial period enabled ? billing will not commence until the trial ends. Ensure the trial duration is configured in the billing system post-provisioning.", "info", "bi-clock"));
        if (_form.RenewalType == "Auto")
            notes.Add(new("Auto-renewal is active ? the subscription will renew automatically unless cancelled before the end of the term.", "info", "bi-arrow-repeat"));
        if (_form.RenewalType == "Manual")
            notes.Add(new("Manual renewal is set ? an administrator must manually renew this subscription before expiry to avoid service interruption.", "warning", "bi-exclamation-circle"));
        if (_form.PlanAddons.Count > 0)
            notes.Add(new($"{_form.PlanAddons.Count} add-on{(_form.PlanAddons.Count == 1 ? "" : "s")} selected ? additional charges will apply per the plan add-on schedule.", "info", "bi-plus-circle"));

