            notes.Add(new("Dedicated Deployment Stamp provisions isolated compute, network, and storage ? significantly higher cost and provisioning time (~15 min).", "warning", "bi-server"));
        if (_form.IsolationMode == "Premium")
            notes.Add(new("Premium Isolated Environment includes dedicated SLA, private networking, and VNet injection. Requires platform ops approval before provisioning.", "warning", "bi-shield-fill-exclamation"));

        if (!string.IsNullOrWhiteSpace(_form.RegionCode))
        {
            if (_form.RegionCode.StartsWith("eu"))
                notes.Add(new("EU region selected ? GDPR data residency requirements will apply.", "info", "bi-shield-check"));
