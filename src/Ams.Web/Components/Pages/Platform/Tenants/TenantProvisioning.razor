    // -- Actions ---------------------------------------------------------------
    private void OpenConfirm()
    {
        if (!ValidateAll()) return;
        _showConfirm = true;
    }

    private async Task ProvisionAsync()
    {
        if (!ValidateAll()) { _showConfirm = false; return; }
        _provisioning = true;
        _showConfirm = false;
        try
        {
            var primaryDomain = _form.CustomDomainIsPrimary && !string.IsNullOrWhiteSpace(_form.CustomDomain)
                ? _form.CustomDomain.Trim()
                : string.IsNullOrWhiteSpace(_form.Subdomain) ? null : _form.Subdomain.Trim();

            // Build provisioning steps
            _provisioningState = BuildProvisioningState();
            StateHasChanged();

            var newId = await Api.CreateTenantAsync(new CreateTenantRequest
            {
                TenantCode    = _form.TenantCode.Trim().ToUpper(),
                TenantName    = _form.TenantName.Trim(),
                PlanCode      = _form.PlanCode,
                RegionCode    = _form.RegionCode,
                IsolationMode = _form.IsolationMode,
                PrimaryDomain = primaryDomain,
                Locale        = _form.Locale,
                CurrencyCode  = _form.CurrencyCode,
                TimeZoneId    = _form.TimeZoneId,
                GoLiveDateUtc = _form.GoLiveDateUtc,
            });
            _provisionedTenantId = newId;

            // Simulate provisioning step execution
            await RunProvisioningStepsAsync();
        }
        catch (Exception ex)
        {
            if (_provisioningState is not null)
            {
                var running = _provisioningState.Steps.FirstOrDefault(s => s.Status == "Running");
                if (running is not null)
                {
                    running.Status = "Failed";
                    running.Error  = ex.Message;
                }
                _provisioningState.OverallStatus = "Failed";
                _provisioningState.ProgressPercent = CalcProgress();
            }
            else
            {
                await ShowToastAsync("Provisioning failed. Please check your inputs and try again.", "Error");
            }
            _provisioning = false;
        }
    }

    private ProvisioningState BuildProvisioningState()
    {
        var steps = new List<ProvisioningStep>
        {
            new("create_tenant",    "Create Tenant Record"),
            new("provision_admin",  "Provision Admin Account"),
        };

        if (_form.IsolationMode is "DedicatedDatabase" or "DedicatedStamp" or "Premium")
            steps.Add(new("provision_db", "Provision Dedicated Database"));
        else
            steps.Add(new("assign_db", "Assign Shared Database"));

        if (_form.IsolationMode == "DedicatedStamp")
            steps.Add(new("deploy_stamp", "Deploy Dedicated Stamp"));

        if (!string.IsNullOrWhiteSpace(_form.Subdomain))
            steps.Add(new("setup_subdomain", $"Configure Subdomain ({_form.Subdomain})"));

        if (!string.IsNullOrWhiteSpace(_form.CustomDomain))
            steps.Add(new("setup_domain", $"Configure Custom Domain ({_form.CustomDomain})"));

        var enabledFeatures = _form.FeatureOverrides.Any()
            ? _form.FeatureOverrides.Where(kv => kv.Value.Enabled).Select(kv => kv.Key).ToList()
            : _form.EnabledFeatures;
        if (enabledFeatures.Count > 0)
            steps.Add(new("apply_features", $"Apply Feature Flags ({enabledFeatures.Count} modules)"));

        if (!string.IsNullOrWhiteSpace(_form.LogoUrl) || !string.IsNullOrWhiteSpace(_form.WhiteLabelName) || !string.IsNullOrWhiteSpace(_form.Theme))
            steps.Add(new("apply_branding", "Apply Branding"));

        steps.Add(new("send_welcome", "Send Welcome Email"));

        return new ProvisioningState
        {
            OverallStatus  = "Running",
            ProgressPercent = 0,
            Steps          = steps,
        };
    }

    private async Task RunProvisioningStepsAsync()
    {
        if (_provisioningState is null) return;

        foreach (var step in _provisioningState.Steps)
        {
            step.Status = "Running";
            StateHasChanged();

            try
            {
                var sw = System.Diagnostics.Stopwatch.StartNew();
                // Simulate step execution with varying durations
                var delay = step.StepKey switch
                {
                    "deploy_stamp"  => 3000,
                    "provision_db"  => 2000,
                    "setup_domain"  => 1500,
                    _               => Random.Shared.Next(400, 1200),
                };
                await Task.Delay(delay);
                sw.Stop();

                step.Status     = "Completed";
                step.DurationMs = (int)sw.ElapsedMilliseconds;
                step.Detail     = "Completed successfully";
            }
            catch (Exception ex)
            {
                step.Status = "Failed";
                step.Error  = ex.Message;
                _provisioningState.OverallStatus  = "Failed";
                _provisioningState.ProgressPercent = CalcProgress();
                _provisioning = false;
                StateHasChanged();
                return;
            }

            _provisioningState.ProgressPercent = CalcProgress();
            StateHasChanged();
        }

        _provisioningState.OverallStatus  = "Completed";
        _provisioningState.ProgressPercent = 100;
        _provisioning = false;
        StateHasChanged();
        await ShowToastAsync($"Tenant \"{_form.TenantName}\" provisioned successfully!", "Success");
    }

    private int CalcProgress()
    {
        if (_provisioningState is null) return 0;
        var total     = _provisioningState.Steps.Count;
        var completed = _provisioningState.Steps.Count(s => s.Status == "Completed");
        return total == 0 ? 0 : (int)Math.Round(100.0 * completed / total);
    }

    private async Task RetryStepAsync(string stepKey)
    {
        if (_provisioningState is null) return;
        _retrying = true;
        var step = _provisioningState.Steps.FirstOrDefault(s => s.StepKey == stepKey);
        if (step is null) { _retrying = false; return; }

        step.Status = "Running";
        step.Error  = null;
        StateHasChanged();

        try
        {
            var sw = System.Diagnostics.Stopwatch.StartNew();
            await Task.Delay(Random.Shared.Next(600, 1500));
            sw.Stop();

            step.Status     = "Completed";
            step.DurationMs = (int)sw.ElapsedMilliseconds;
            step.Detail     = "Completed on retry";

            // If all done, continue remaining steps
            var remaining = _provisioningState.Steps.Where(s => s.Status is "Pending" or "Failed").ToList();
            if (remaining.Count == 0)
            {
                _provisioningState.OverallStatus  = "Completed";
                _provisioningState.ProgressPercent = 100;
                await ShowToastAsync($"Tenant \"{_form.TenantName}\" provisioned successfully!", "Success");
            }
            else
            {
                _provisioningState.OverallStatus  = remaining.Any(s => s.Status == "Failed") ? "Failed" : "Running";
                _provisioningState.ProgressPercent = CalcProgress();
                // Continue remaining pending steps
                if (!remaining.Any(s => s.Status == "Failed"))
                {
                    _retrying = false;
                    StateHasChanged();
                    await RunRemainingStepsAsync();
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            step.Status = "Failed";
            step.Error  = ex.Message;
        }

        _retrying = false;
        _provisioningState.ProgressPercent = CalcProgress();
        StateHasChanged();
    }

    private async Task RetryAllFailedAsync()
    {
        if (_provisioningState is null) return;
        _retrying = true;

        foreach (var step in _provisioningState.Steps.Where(s => s.Status == "Failed").ToList())
        {
            step.Status = "Running";
            step.Error  = null;
            StateHasChanged();

            try
            {
                var sw = System.Diagnostics.Stopwatch.StartNew();
                await Task.Delay(Random.Shared.Next(600, 1500));
                sw.Stop();

                step.Status     = "Completed";
                step.DurationMs = (int)sw.ElapsedMilliseconds;
                step.Detail     = "Completed on retry";
            }
            catch (Exception ex)
            {
                step.Status = "Failed";
                step.Error  = ex.Message;
                _provisioningState.OverallStatus  = "Failed";
                _provisioningState.ProgressPercent = CalcProgress();
                _retrying = false;
                StateHasChanged();
                return;
            }

            _provisioningState.ProgressPercent = CalcProgress();
            StateHasChanged();
        }

        // Continue remaining pending steps
        _retrying = false;
        await RunRemainingStepsAsync();
    }

    private async Task RunRemainingStepsAsync()
    {
        if (_provisioningState is null) return;

        foreach (var step in _provisioningState.Steps.Where(s => s.Status == "Pending"))
        {
            step.Status = "Running";
            StateHasChanged();

            try
            {
                var sw = System.Diagnostics.Stopwatch.StartNew();
                await Task.Delay(Random.Shared.Next(400, 1200));
                sw.Stop();

                step.Status     = "Completed";
                step.DurationMs = (int)sw.ElapsedMilliseconds;
                step.Detail     = "Completed successfully";
            }
            catch (Exception ex)
            {
                step.Status = "Failed";
                step.Error  = ex.Message;
                _provisioningState.OverallStatus  = "Failed";
                _provisioningState.ProgressPercent = CalcProgress();
                StateHasChanged();
                return;
            }

            _provisioningState.ProgressPercent = CalcProgress();
            StateHasChanged();
        }

        _provisioningState.OverallStatus  = "Completed";
        _provisioningState.ProgressPercent = 100;
        StateHasChanged();
        await ShowToastAsync($"Tenant \"{_form.TenantName}\" provisioned successfully!", "Success");
    }

