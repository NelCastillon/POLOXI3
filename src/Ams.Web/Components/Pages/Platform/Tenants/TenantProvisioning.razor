            notes.Add(new("Enterprise pricing is enabled ? standard plan rates will not apply. Ensure contract is in place.", "warning", "bi-currency-dollar"));

        if (_form.MfaRequired)
            notes.Add(new("MFA will be enforced for the admin account on first login.", "info", "bi-phone-vibrate"));

        return notes;
    }

    // -- Validation results ----------------------------------------------------
    private sealed record ValidationResults(
        List<string> Blockers,
        List<string> Warnings,
        bool RequiredComplete,
        bool ComplianceOk,
        string? CostImpact);

    private ValidationResults GetValidationResults()
    {
        var blockers = new List<string>();
        var warnings = new List<string>();

        // Required fields
        if (string.IsNullOrWhiteSpace(_form.TenantCode)) blockers.Add("Tenant Code is required.");
        if (string.IsNullOrWhiteSpace(_form.TenantName)) blockers.Add("Tenant Name is required.");
        if (string.IsNullOrWhiteSpace(_form.RegionCode)) blockers.Add("Primary Region must be selected.");
        if (string.IsNullOrWhiteSpace(_form.IsolationMode)) blockers.Add("Isolation Mode must be selected.");
        if (string.IsNullOrWhiteSpace(_form.PlanCode)) blockers.Add("A subscription plan must be selected.");
        if (string.IsNullOrWhiteSpace(_form.AdminFullName)) blockers.Add("Admin full name is required.");
        if (string.IsNullOrWhiteSpace(_form.AdminEmail)) blockers.Add("Admin email is required.");

        // Warnings
        if (string.IsNullOrWhiteSpace(_form.Subdomain) && string.IsNullOrWhiteSpace(_form.CustomDomain))
            warnings.Add("No domain configured ? tenant will not be reachable via a custom URL.");
        if (!string.IsNullOrWhiteSpace(_form.CustomDomain) && !_form.DomainVerified)
            warnings.Add("Custom domain has not been verified ? DNS propagation may delay portal access.");
        if (_form.GoLiveDateUtc == null)
            warnings.Add("No go-live date set ? defaults to immediately after provisioning.");
        if (string.IsNullOrWhiteSpace(_form.LogoUrl))
            warnings.Add("No logo uploaded ? default platform branding will be used.");
        if (_form.TrialEnabled && _form.SubscriptionStartDate == null)
            warnings.Add("Trial enabled but no subscription start date set.");
        if (string.IsNullOrWhiteSpace(_form.SecondaryRegionCode))
            warnings.Add("No disaster recovery region selected ? failover will not be available.");

        bool requiredComplete = blockers.Count == 0;

        // Compliance
        bool complianceOk = true;
        if (_form.HipaaReady)
        {
            var region = _regionOptions.FirstOrDefault(r => r.Value == _form.RegionCode);
            if (region != null && !region.HipaaEligible)
            {
                blockers.Add($"Region {region.Label} does not support HIPAA. Select a HIPAA-enabled region.");
                complianceOk = false;
            }
        }

        // Cost impact
        string? costImpact = null;
        if (_form.IsolationMode is "DedicatedDatabase" or "DedicatedStamp" or "Premium")
            costImpact = "Dedicated isolation ? elevated infrastructure cost will apply immediately.";
        else if (_form.EnterprisePricing)
            costImpact = "Enterprise pricing active ? custom contract rates apply.";

        return new ValidationResults(blockers, warnings, requiredComplete, complianceOk, costImpact);
    }

