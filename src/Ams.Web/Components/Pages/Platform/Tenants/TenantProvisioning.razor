@page "/platform/tenants/provision"
@using Ams.Application.Features.Tenants
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Provision New Tenant ? Platform</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="5000" NewestOnTop="true" />

<AppPageHeader Title="Provision New Tenant"
               Subtitle="Complete all steps to create and initialise a tenant"
               Icon="bi-building-add">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="Cancel">
            <i class="bi bi-x-lg" aria-hidden="true"></i> Cancel
        </button>
    </Actions>
</AppPageHeader>

<!-- -- Stepper ------------------------------------------------ -->
@if (_provisioningState is null)
{
<div class="tpw-stepper">
    @for (int i = 0; i < _steps.Length; i++)
    {
        int idx = i;
        string cls = idx == _step ? "tpw-step tpw-step--active"
                   : idx < _step  ? "tpw-step tpw-step--done"
                   :                "tpw-step";
        <div class="@cls" @onclick="() => TryGoToStep(idx)" role="button" tabindex="0"
             @onkeydown="@(e => { if (e.Key == "Enter") TryGoToStep(idx); })">
            <div class="tpw-step-circle">
                @if (idx < _step)
                {
                    <i class="bi bi-check-lg" aria-hidden="true"></i>
                }
                else
                {
                    <span>@(idx + 1)</span>
                }
            </div>
            <span class="tpw-step-label">@_steps[idx]</span>
        </div>
        @if (idx < _steps.Length - 1)
        {
            <div class="tpw-step-connector @(idx < _step ? "tpw-step-connector--done" : "")"></div>
        }
    }
</div>

<!-- -- Two-column wizard layout ------------------------------- -->
<div class="tpw-layout">

    <!-- -- Left: step form ------------------------------------ -->
    <div class="tpw-main">

        <!-- -- Validation banner -------------------------------- -->
        @if (_touched && _validationErrors.Count > 0)
        {
            <div class="tpw-validation-banner" role="alert" aria-live="polite">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <div class="tpw-validation-messages">
                    <strong>Please correct the following before continuing:</strong>
                    <ul>
                        @foreach (var err in _validationErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            </div>
        }

        <!-- Step 0: Tenant Core -->
        @if (_step == 0)
        {
            <div class="tpw-panel-body">
                <h2 class="tpw-panel-title">
                    <i class="bi bi-buildings" aria-hidden="true"></i> Tenant Core
                </h2>
                <p class="tpw-panel-hint">Define the unique identity, legal name, type, status, and localisation settings for this tenant.</p>
                <div class="tpw-form-grid">
                    <div class="form-row tpw-required">
                        <label class="form-label">Tenant Code <span class="form-required">*</span></label>
                        <SfTextBox @bind-Value="_form.TenantCode" Placeholder="e.g. ACME" MaxLength="50" />
                        <span class="tpw-field-hint">Uppercase alphanumeric, unique across the platform.</span>
                    </div>
                    <div class="form-row tpw-required">
                        <label class="form-label">Tenant Name <span class="form-required">*</span></label>
                        <SfTextBox @bind-Value="_form.TenantName" Placeholder="e.g. Acme Corporation" MaxLength="200" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Legal Name</label>
                        <SfTextBox @bind-Value="_form.LegalName" Placeholder="e.g. Acme Corporation Ltd." MaxLength="300" />
                    </div>
                    <div class="form-row tpw-required">
                        <label class="form-label">Tenant Type <span class="form-required">*</span></label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_tenantTypeOptions"
                                        @bind-Value="_form.TenantType"
                                        Placeholder="Select tenant type">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row tpw-required">
                        <label class="form-label">Status <span class="form-required">*</span></label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_tenantStatusOptions"
                                        @bind-Value="_form.Status"
                                        Placeholder="Select status">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row tpw-required">
                        <label class="form-label">Default Timezone <span class="form-required">*</span></label>
                        <SfComboBox TValue="string" TItem="LabelValue"
                                    DataSource="_timeZoneOptions"
                                    @bind-Value="_form.TimeZoneId"
                                    Placeholder="Search or select time zone"
                                    AllowFiltering="true">
                            <ComboBoxFieldSettings Value="Value" Text="Label" />
                        </SfComboBox>
                    </div>
                    <div class="form-row tpw-required">
                        <label class="form-label">Default Currency <span class="form-required">*</span></label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_currencyOptions"
                                        @bind-Value="_form.CurrencyCode"
                                        Placeholder="Select currency">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row tpw-required">
                        <label class="form-label">Default Locale <span class="form-required">*</span></label>
                        <SfComboBox TValue="string" TItem="LabelValue"
                                    DataSource="_localeOptions"
                                    @bind-Value="_form.Locale"
                                    Placeholder="Search or select locale"
                                    AllowFiltering="true">
                            <ComboBoxFieldSettings Value="Value" Text="Label" />
                        </SfComboBox>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Go-Live Date</label>
                        <SfDatePicker TValue="DateTime?" @bind-Value="_form.GoLiveDateUtc" Format="dd MMM yyyy" />
                    </div>
                </div>
            </div>
        }

        <!-- Step 1: Region Assignment -->
        @if (_step == 1)
        {
            <div class="tpw-panel-body">
                <h2 class="tpw-panel-title">
                    <i class="bi bi-geo-alt" aria-hidden="true"></i> Region Assignment
                </h2>
                <p class="tpw-panel-hint">Assign the primary and disaster-recovery deployment regions, compliance profile, and data residency requirements for this tenant.</p>

                <div class="tpw-form-grid">
                    <div class="form-row tpw-required">
                        <label class="form-label">Primary Region <span class="form-required">*</span></label>
                        <SfComboBox TValue="string" TItem="RegionOption"
                                    DataSource="_regionOptions"
                                    @bind-Value="_form.RegionCode"
                                    Placeholder="Search or select primary region"
                                    AllowFiltering="true">
                            <ComboBoxFieldSettings Value="Value" Text="Label" />
                        </SfComboBox>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Secondary / DR Region</label>
                        <SfComboBox TValue="string" TItem="RegionOption"
                                    DataSource="_regionOptions"
                                    @bind-Value="_form.SecondaryRegionCode"
                                    Placeholder="Search or select DR region"
                                    AllowFiltering="true">
                            <ComboBoxFieldSettings Value="Value" Text="Label" />
                        </SfComboBox>
                        <span class="tpw-field-hint">Optional. Used for failover and disaster recovery routing.</span>
                    </div>
                    <div class="form-row tpw-required">
                        <label class="form-label">Compliance Profile <span class="form-required">*</span></label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_complianceOptions"
                                        @bind-Value="_form.ComplianceProfile"
                                        Placeholder="Select compliance profile">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row tpw-required">
                        <label class="form-label">Data Residency Requirement <span class="form-required">*</span></label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_dataResidencyOptions"
                                        @bind-Value="_form.DataResidencyRequirement"
                                        Placeholder="Select residency requirement">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row tpw-switch-row">
                        <div class="tpw-switch-label-group">
                            <span class="form-label">HIPAA-Ready Infrastructure</span>
                            <span class="tpw-hint-text">Enables HIPAA-compliant storage, encryption at rest, and audit controls</span>
                        </div>
                        <SfSwitch @bind-Checked="_form.HipaaReady" />
                    </div>
                </div>

                @* -- Region capability summary ---------------- *@
                @{
                    var primaryMeta  = _regionOptions.FirstOrDefault(r => r.Value == _form.RegionCode);
                    var secondaryMeta = _regionOptions.FirstOrDefault(r => r.Value == _form.SecondaryRegionCode);
                }
                @if (primaryMeta is not null)
                {
                    <div class="tpw-region-capability">
                        <div class="tpw-region-cap-hd">
                            <i class="bi bi-hdd-network" aria-hidden="true"></i>
                            <span>Region Capability ? @primaryMeta.Label</span>
                        </div>
                        <div class="tpw-region-cap-grid">
                            <div class="tpw-cap-item @(primaryMeta.HasMultiAz ? "tpw-cap--ok" : "tpw-cap--no")">
                                <i class="bi @(primaryMeta.HasMultiAz ? "bi-check-circle-fill" : "bi-x-circle")" aria-hidden="true"></i>
                                <span>Multi-AZ</span>
                            </div>
                            <div class="tpw-cap-item @(primaryMeta.GdprCompliant ? "tpw-cap--ok" : "tpw-cap--no")">
                                <i class="bi @(primaryMeta.GdprCompliant ? "bi-check-circle-fill" : "bi-x-circle")" aria-hidden="true"></i>
                                <span>GDPR</span>
                            </div>
                            <div class="tpw-cap-item @(primaryMeta.HipaaEligible ? "tpw-cap--ok" : "tpw-cap--no")">
                                <i class="bi @(primaryMeta.HipaaEligible ? "bi-check-circle-fill" : "bi-x-circle")" aria-hidden="true"></i>
                                <span>HIPAA Eligible</span>
                            </div>
                            <div class="tpw-cap-item @(primaryMeta.FedRampEligible ? "tpw-cap--ok" : "tpw-cap--no")">
                                <i class="bi @(primaryMeta.FedRampEligible ? "bi-check-circle-fill" : "bi-x-circle")" aria-hidden="true"></i>
                                <span>FedRAMP</span>
                            </div>
                            <div class="tpw-cap-item">
                                <i class="bi bi-speedometer2" aria-hidden="true"></i>
                                <span>Latency: @primaryMeta.TypicalLatencyMs ms</span>
                            </div>
                            <div class="tpw-cap-item">
                                <i class="bi bi-shield-check" aria-hidden="true"></i>
                                <span>SLA: @primaryMeta.Sla</span>
                            </div>
                        </div>
                        @if (secondaryMeta is not null)
                        {
                            <div class="tpw-cap-dr-row">
                                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                                <span>DR Region: <strong>@secondaryMeta.Label</strong> ? @(secondaryMeta.GdprCompliant ? "GDPR ?" : "GDPR ?")&nbsp;&nbsp;Multi-AZ: @(secondaryMeta.HasMultiAz ? "Yes" : "No")</span>
                            </div>
                        }
                    </div>
                }

                @* -- Compliance notes ------------------------- *@
                @if (!string.IsNullOrWhiteSpace(_form.ComplianceProfile))
                {
                    <div class="tpw-compliance-notes">
                        <div class="tpw-compliance-notes-hd">
                            <i class="bi bi-patch-check" aria-hidden="true"></i>
                            <span>Compliance Notes ? @_form.ComplianceProfile</span>
                        </div>
                        <p class="tpw-compliance-notes-body">
                            @GetComplianceNote(_form.ComplianceProfile)
                        </p>
                    </div>
                }

                @* -- Data residency warning panel -------------- *@
                @if (!string.IsNullOrWhiteSpace(_form.DataResidencyRequirement) &&
                     _form.DataResidencyRequirement != "None" &&
                     primaryMeta is not null)
                {
                    var residencyMismatch = _form.DataResidencyRequirement == "EU" && !primaryMeta.GdprCompliant;
                    var hipaaConflict     = _form.HipaaReady && !primaryMeta.HipaaEligible;
                    @if (residencyMismatch || hipaaConflict)
                    {
                        <div class="tpw-residency-warning" role="alert">
                            <div class="tpw-residency-warning-hd">
                                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                <span>Data Residency Conflict Detected</span>
                            </div>
                            <ul class="tpw-residency-warning-list">
                                @if (residencyMismatch)
                                {
                                    <li>EU residency is required but the selected primary region (<strong>@primaryMeta.Label</strong>) is not GDPR-compliant. Please choose an EU region.</li>
                                }
                                @if (hipaaConflict)
                                {
                                    <li>HIPAA-ready infrastructure is enabled but the selected primary region (<strong>@primaryMeta.Label</strong>) is not HIPAA eligible. Please choose a HIPAA-eligible region.</li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="tpw-residency-ok">
                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                            <span>Data residency requirements are satisfied by the selected region.</span>
                        </div>
                    }
                }

            </div>
        }

        <!-- Step 2: Isolation Mode -->
        @if (_step == 2)
        {
            var selIso = _isolationModeOptions.FirstOrDefault(o => o.Value == _form.IsolationMode);
            <div class="tpw-panel-body">
                <h2 class="tpw-panel-title">
                    <i class="bi bi-layers" aria-hidden="true"></i> Isolation Mode
                </h2>
                <p class="tpw-panel-hint">Choose the tenant isolation strategy and configure database, storage, cache, and noisy-neighbour protection levels.</p>

                <!-- -- Isolation mode selection cards -- -->
                <div class="tpw-isolation-cards">
                    @foreach (var iso in _isolationModeOptions)
                    {
                        var isSelected = _form.IsolationMode == iso.Value;
                        <div class="tpw-isolation-card @(isSelected ? "tpw-isolation-card--selected" : "")"
                             @onclick="() => _form.IsolationMode = iso.Value"
                             role="radio" aria-checked="@isSelected" tabindex="0"
                             @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") _form.IsolationMode = iso.Value; })">
                            <div class="tpw-isolation-card-hd">
                                <div class="tpw-isolation-icon">
                                    <i class="bi @iso.Icon" aria-hidden="true"></i>
                                </div>
                                <div class="tpw-isolation-card-title">
                                    <span class="tpw-isolation-name">@iso.Label</span>
                                    <span class="tpw-isolation-cost @iso.CostClass">@iso.CostLabel</span>
                                </div>
                                @if (isSelected)
                                {
                                    <i class="bi bi-check-circle-fill tpw-isolation-check" aria-hidden="true"></i>
                                }
                            </div>
                            <p class="tpw-isolation-desc">@iso.Description</p>
                            <div class="tpw-isolation-badges">
                                @foreach (var badge in iso.Badges)
                                {
                                    <span class="tpw-isolation-badge">@badge</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- -- Sub-configuration fields -- -->
                <div class="tpw-form-grid" style="margin-top: var(--sp-5);">
                    <div class="form-row">
                        <label class="form-label">Database Tier</label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_databaseTierOptions"
                                        @bind-Value="_form.DatabaseTier"
                                        Placeholder="Select database tier">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Storage</label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_storageModeOptions"
                                        @bind-Value="_form.StorageMode"
                                        Placeholder="Select storage model">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Cache</label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_cacheModeOptions"
                                        @bind-Value="_form.CacheMode"
                                        Placeholder="Select cache model">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Noisy Neighbour Protection</label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_noisyNeighborOptions"
                                        @bind-Value="_form.NoisyNeighborLevel"
                                        Placeholder="Select protection level">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                </div>

                @* -- Impact summaries ------------------------------ *@
                @if (selIso is not null)
                {
                    <!-- Cost impact -->
                    <div class="tpw-impact-summary tpw-impact-summary--cost">
                        <div class="tpw-impact-summary-hd">
                            <i class="bi bi-currency-dollar" aria-hidden="true"></i>
                            <span>Cost Impact</span>
                        </div>
                        <p class="tpw-impact-summary-body">@selIso.CostImpact</p>
                        <div class="tpw-impact-meter">
                            @for (int dot = 1; dot <= 4; dot++)
                            {
                                int d = dot;
                                <div class="tpw-impact-dot @(d <= selIso.CostLevel ? "tpw-impact-dot--filled" : "")"></div>
                            }
                            <span class="tpw-impact-meter-label">@selIso.CostLabel</span>
                        </div>
                    </div>

                    <!-- Operational impact -->
                    <div class="tpw-impact-summary tpw-impact-summary--ops">
                        <div class="tpw-impact-summary-hd">
                            <i class="bi bi-gear" aria-hidden="true"></i>
                            <span>Operational Impact</span>
                        </div>
                        <p class="tpw-impact-summary-body">@selIso.OpsImpact</p>
                    </div>

                    <!-- Compliance guidance -->
                    <div class="tpw-impact-summary tpw-impact-summary--compliance">
                        <div class="tpw-impact-summary-hd">
                            <i class="bi bi-patch-check" aria-hidden="true"></i>
                            <span>Compliance Guidance</span>
                        </div>
                        <p class="tpw-impact-summary-body">@selIso.ComplianceGuidance</p>
                    </div>
                }

            </div>
        }

        <!-- Step 3: Subscription -->
        @if (_step == 3)
        {
            <div class="tpw-panel-body">
                <h2 class="tpw-panel-title">
                    <i class="bi bi-award" aria-hidden="true"></i> Subscription
                </h2>
                <p class="tpw-panel-hint">Choose the subscription plan, billing frequency, and any contract or pricing overrides.</p>
                <div class="tpw-plan-cards">
                    @foreach (var plan in _planOptions)
                    {
                        <div class="tpw-plan-card @(_form.PlanCode == plan.Value ? "tpw-plan-card--selected" : "")"
                             @onclick="() => _form.PlanCode = plan.Value"
                             role="radio" aria-checked="@(_form.PlanCode == plan.Value)" tabindex="0"
                             @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") _form.PlanCode = plan.Value; })">
                            <div class="tpw-plan-check">
                                @if (_form.PlanCode == plan.Value)
                                {
                                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle" aria-hidden="true"></i>
                                }
                            </div>
                            <div class="tpw-plan-info">
                                <span class="tpw-plan-name">@plan.Label</span>
                                <span class="tpw-plan-desc">@plan.Description</span>
                            </div>
                        </div>
                    }
                </div>
                <div class="tpw-form-grid" style="margin-top: var(--sp-5);">
                    <div class="form-row">
                        <label class="form-label">Billing Frequency</label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_billingFrequencyOptions"
                                        @bind-Value="_form.BillingFrequency"
                                        Placeholder="Select billing frequency">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Contract Reference</label>
                        <SfTextBox @bind-Value="_form.ContractRef" Placeholder="e.g. CONTRACT-2025-001" MaxLength="200" />
                    </div>
                    <div class="form-row tpw-switch-row">
                        <div class="tpw-switch-label-group">
                            <span class="form-label">Enterprise / Custom Pricing</span>
                            <span class="tpw-hint-text">Overrides standard plan rates</span>
                        </div>
                        <SfSwitch @bind-Checked="_form.EnterprisePricing" />
                    </div>
                </div>
            </div>
        }

        <!-- Step 4: Plan Selection -->
        @if (_step == 4)
        {
            var selPlan = _planSummaryData.FirstOrDefault(p => p.PlanCode == _form.PlanCode);
            <div class="tpw-panel-body">
                <h2 class="tpw-panel-title">
                    <i class="bi bi-card-checklist" aria-hidden="true"></i> Plan Selection
                </h2>
                <p class="tpw-panel-hint">Configure subscription terms, contract type, trial settings, and initial add-ons for this tenant.</p>

                <!-- -- Plan summary display -- -->
                @if (selPlan is not null)
                {
                    <div class="tpw-plan-summary-panel">
                        <div class="tpw-plan-summary-hd">
                            <i class="bi bi-award" aria-hidden="true"></i>
                            <span class="tpw-plan-summary-name">@selPlan.PlanCode Plan</span>
                        </div>
                        <div class="tpw-plan-summary-stats">
                            <div class="tpw-plan-stat">
                                <span class="tpw-plan-stat-value">@(selPlan.IncludedUsers == int.MaxValue ? "8" : selPlan.IncludedUsers.ToString("N0"))</span>
                                <span class="tpw-plan-stat-label">Users</span>
                            </div>
                            <div class="tpw-plan-stat">
                                <span class="tpw-plan-stat-value">@selPlan.StorageGb GB</span>
                                <span class="tpw-plan-stat-label">Storage</span>
                            </div>
                            <div class="tpw-plan-stat">
                                <span class="tpw-plan-stat-value">@FormatApiCalls(selPlan.ApiCallsPerMonth)</span>
                                <span class="tpw-plan-stat-label">API calls / mo</span>
                            </div>
                            <div class="tpw-plan-stat">
                                <span class="tpw-plan-stat-value">@selPlan.Modules.Length</span>
                                <span class="tpw-plan-stat-label">Modules</span>
                            </div>
                        </div>
                        <div class="tpw-plan-summary-modules">
                            @foreach (var mod in selPlan.Modules)
                            {
                                <span class="tpw-plan-module-badge">@mod</span>
                            }
                        </div>
                        <div class="tpw-plan-summary-cost">
                            <span class="tpw-plan-cost-label">Estimated monthly cost</span>
                            <span class="tpw-plan-cost-value">@(selPlan.EstimatedMonthlyCost == 0m ? "Custom pricing" : selPlan.EstimatedMonthlyCost.ToString("C0"))</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="tpw-info-notice">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <span>Go back to Step 3 to select a subscription plan first, then configure contract terms here.</span>
                    </div>
                }

                <div class="tpw-form-grid" style="margin-top: var(--sp-5);">
                    <div class="form-row">
                        <label class="form-label">Contract Type</label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_contractTypeOptions"
                                        @bind-Value="_form.ContractType"
                                        Placeholder="Select contract type">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Subscription Start Date</label>
                        <SfDatePicker TValue="DateTime?" @bind-Value="_form.SubscriptionStartDate"
                                      Placeholder="Select start date"
                                      Min="DateTime.Today" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Renewal Type</label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_renewalTypeOptions"
                                        @bind-Value="_form.RenewalType"
                                        Placeholder="Select renewal type">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row tpw-switch-row">
                        <div class="tpw-switch-label-group">
                            <span class="form-label">Trial Period Enabled</span>
                            <span class="tpw-hint-text">Tenant will not be billed until the trial ends</span>
                        </div>
                        <SfSwitch @bind-Checked="_form.TrialEnabled" />
                    </div>
                </div>

                <!-- -- Initial add-ons -- -->
                <h3 class="tpw-subsection-title" style="margin-top: var(--sp-5);">Initial Add-ons</h3>
                <p class="tpw-panel-hint" style="margin-top: 0; margin-bottom: var(--sp-3);">These add-ons will be activated immediately on provisioning.</p>
                <div class="tpw-feature-grid">
                    @foreach (var addon in _planAddonOptions)
                    {
                        var isOn = _form.PlanAddons.Contains(addon.Value);
                        <div class="tpw-feature-card @(isOn ? "tpw-feature-card--on" : "")"
                             @onclick="() => TogglePlanAddon(addon.Value)"
                             role="checkbox" aria-checked="@isOn" tabindex="0"
                             @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") TogglePlanAddon(addon.Value); })">
                            <div class="tpw-feature-icon">
                                <i class="bi @addon.Icon" aria-hidden="true"></i>
                            </div>
                            <div class="tpw-feature-info">
                                <span class="tpw-feature-name">@addon.Label</span>
                                <span class="tpw-feature-desc">@addon.Description</span>
                            </div>
                            <div class="tpw-feature-toggle">
                                @if (isOn)
                                {
                                    <i class="bi bi-toggle2-on tpw-toggle-on" aria-hidden="true"></i>
                                }
                                else
                                {
                                    <i class="bi bi-toggle2-off tpw-toggle-off" aria-hidden="true"></i>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Step 5: Domain Setup -->
        @if (_step == 5)
        {
            var platformBase = "platform.com";
            var subPreview   = string.IsNullOrWhiteSpace(_form.Subdomain)
                                   ? $"<tenantcode>.{platformBase}"
                                   : $"{_form.Subdomain.Trim()}.{platformBase}";
            var customPreview = string.IsNullOrWhiteSpace(_form.CustomDomain)
                                   ? null
                                   : _form.CustomDomain.Trim();
            <div class="tpw-panel-body">
                <h2 class="tpw-panel-title">
                    <i class="bi bi-globe2" aria-hidden="true"></i> Domain Setup
                </h2>
                <p class="tpw-panel-hint">Assign tenant routing and domain identity. Configure subdomains, custom domains, SSL, and verification.</p>

                <!-- -- URL preview -- -->
                <div class="tpw-url-preview">
                    <div class="tpw-url-preview-hd">
                        <i class="bi bi-link-45deg" aria-hidden="true"></i>
                        <span>Generated URL Preview</span>
                    </div>
                    <div class="tpw-url-preview-rows">
                        <div class="tpw-url-row">
                            <span class="tpw-url-badge tpw-url-badge--platform">Platform</span>
                            <code class="tpw-url-value">https://@subPreview</code>
                        </div>
                        @if (customPreview is not null)
                        {
                            <div class="tpw-url-row">
                                <span class="tpw-url-badge @(_form.CustomDomainIsPrimary ? "tpw-url-badge--primary" : "tpw-url-badge--custom")">@(_form.CustomDomainIsPrimary ? "Primary" : "Custom")</span>
                                <code class="tpw-url-value">https://@customPreview</code>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_form.RedirectDomain))
                        {
                            <div class="tpw-url-row">
                                <span class="tpw-url-badge tpw-url-badge--redirect">Redirect</span>
                                <code class="tpw-url-value">https://@_form.RedirectDomain.Trim() ? @(customPreview ?? subPreview)</code>
                            </div>
                        }
                    </div>
                </div>

                <div class="tpw-form-grid">
                    <div class="form-row">
                        <label class="form-label">Subdomain</label>
                        <SfTextBox @bind-Value="_form.Subdomain" Placeholder="e.g. acme" MaxLength="100" />
                        <span class="tpw-field-hint">Results in <strong>@subPreview</strong> on the platform.</span>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Custom Domain</label>
                        <SfTextBox @bind-Value="_form.CustomDomain" Placeholder="e.g. app.acme.com" MaxLength="253" />
                        <span class="tpw-field-hint">A fully qualified domain. Requires external DNS setup.</span>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Redirect Domain</label>
                        <SfTextBox @bind-Value="_form.RedirectDomain" Placeholder="e.g. old.acme.com" MaxLength="253" />
                        <span class="tpw-field-hint">Requests to this domain will be 301-redirected to the primary domain.</span>
                    </div>
                    <div class="form-row">
                        <label class="form-label">SSL Requirement</label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_sslRequirementOptions"
                                        @bind-Value="_form.SslRequirement"
                                        Placeholder="Select SSL mode">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Domain Verification Mode</label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_domainVerificationModeOptions"
                                        @bind-Value="_form.DomainVerificationMode"
                                        Placeholder="Select verification mode">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row tpw-switch-row">
                        <div class="tpw-switch-label-group">
                            <span class="form-label">Set Custom Domain as Primary</span>
                            <span class="tpw-hint-text">Used in invitation emails and redirect links</span>
                        </div>
                        <SfSwitch @bind-Checked="_form.CustomDomainIsPrimary" />
                    </div>
                </div>

                <!-- -- DNS instruction note -- -->
                <div class="tpw-dns-note">
                    <div class="tpw-dns-note-hd">
                        <i class="bi bi-server" aria-hidden="true"></i>
                        <span>DNS Configuration Instructions</span>
                    </div>
                    <div class="tpw-dns-note-body">
                        @if (!string.IsNullOrWhiteSpace(_form.CustomDomain))
                        {
                            <p>Add the following DNS records for <strong>@_form.CustomDomain.Trim()</strong>:</p>
                            <table class="tpw-dns-table">
                                <thead><tr><th>Type</th><th>Name</th><th>Value</th><th>TTL</th></tr></thead>
                                <tbody>
                                    <tr><td>CNAME</td><td>@(string.IsNullOrWhiteSpace(_form.CustomDomain) ? "@" : _form.CustomDomain.Trim().Split('.')[0])</td><td>@subPreview</td><td>300</td></tr>
                                    @if (_form.DomainVerificationMode == "TXT")
                                    {
                                        <tr><td>TXT</td><td>_verify.@(_form.CustomDomain?.Trim() ?? "")</td><td>ams-verify=@(_form.TenantCode.ToUpper())</td><td>300</td></tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="tpw-dns-note-empty">Enter a custom domain above to see DNS configuration instructions.</p>
                        }
                    </div>
                </div>

                <!-- -- Domain verification checklist -- -->
                <div class="tpw-verify-checklist">
                    <div class="tpw-verify-checklist-hd">
                        <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
                        <span>Domain Verification Checklist</span>
                    </div>
                    <ul class="tpw-verify-list">
                        <li class="tpw-verify-item @(!string.IsNullOrWhiteSpace(_form.Subdomain) ? "tpw-verify-item--ok" : "")">
                            <i class="bi @(!string.IsNullOrWhiteSpace(_form.Subdomain) ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                            <span>Subdomain configured</span>
                        </li>
                        <li class="tpw-verify-item @(!string.IsNullOrWhiteSpace(_form.CustomDomain) ? "tpw-verify-item--ok" : "")">
                            <i class="bi @(!string.IsNullOrWhiteSpace(_form.CustomDomain) ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                            <span>Custom domain entered</span>
                        </li>
                        <li class="tpw-verify-item @(_form.SslRequirement != "None" ? "tpw-verify-item--ok" : "")">
                            <i class="bi @(_form.SslRequirement != "None" ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                            <span>SSL mode selected</span>
                        </li>
                        <li class="tpw-verify-item @(_form.DomainVerified ? "tpw-verify-item--ok" : "")">
                            <i class="bi @(_form.DomainVerified ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                            <span>Domain verified</span>
                        </li>
                    </ul>
                    <div class="tpw-verify-action">
                        <button class="um-btn @(_form.DomainVerified ? "um-btn-success" : "um-btn-secondary")"
                                @onclick="ValidateDomainAsync"
                                disabled="@(_validatingDomain || string.IsNullOrWhiteSpace(_form.CustomDomain))">
                            @if (_validatingDomain)
                            {
                                <span class="um-spin" aria-hidden="true"></span>
                                <span>Validating?</span>
                            }
                            else if (_form.DomainVerified)
                            {
                                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                                <span>Domain Verified</span>
                            }
                            else
                            {
                                <i class="bi bi-shield-check" aria-hidden="true"></i>
                                <span>Validate Domain</span>
                            }
                        </button>
                        @if (!_form.DomainVerified && !string.IsNullOrWhiteSpace(_form.CustomDomain))
                        {
                            <span class="tpw-field-hint" style="margin-left: var(--sp-3);">Checks DNS propagation and CNAME resolution.</span>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Step 6: Feature Defaults -->
        @if (_step == 6)
        {
            <div class="tpw-panel-body">
                <h2 class="tpw-panel-title">
                    <i class="bi bi-toggles" aria-hidden="true"></i> Feature Defaults
                </h2>
                <p class="tpw-panel-hint">Enable modules and configure platform entitlements. Plan defaults are pre-selected based on your chosen subscription plan.</p>

                @{
                    var planDefs   = GetPlanDefaultFeatures();
                    var premWarn   = _featureOptions.Where(f => f.IsPremium).Any(f => GetFeatureOverride(f.Code).Enabled);
                    var depWarn    = _featureOptions.Any(f => f.DependsOn != null && GetFeatureOverride(f.Code).Enabled
                                         && f.DependsOn.Any(d => !GetFeatureOverride(d).Enabled));
                }

                @if (premWarn)
                {
                    <div class="tpw-fdef-warning tpw-fdef-warning--premium">
                        <i class="bi bi-stars" aria-hidden="true"></i>
                        <span>One or more <strong>premium features</strong> are enabled. Confirm the subscription plan includes them or that an add-on has been purchased.</span>
                    </div>
                }

                @if (depWarn)
                {
                    <div class="tpw-fdef-warning tpw-fdef-warning--dep">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        <span><strong>Dependency warning:</strong> Some enabled features require other modules to be active. See the warnings below.</span>
                    </div>
                }

                <div class="tpw-fdef-list">
                    @foreach (var f in _featureOptions)
                    {
                        var ov     = GetFeatureOverride(f.Code);
                        var isPD   = planDefs.Contains(f.Code);
                        var depsOk = f.DependsOn == null || f.DependsOn.All(d => GetFeatureOverride(d).Enabled);

                        <div class="tpw-fdef-row @(ov.Enabled ? "is-on" : "") @(!depsOk && ov.Enabled ? "has-dep-warn" : "")">
                            <div class="tpw-fdef-main">
                                <div class="tpw-fdef-icon">
                                    <i class="bi @f.Icon" aria-hidden="true"></i>
                                </div>
                                <div class="tpw-fdef-meta">
                                    <div class="tpw-fdef-name-row">
                                        <span class="tpw-fdef-name">@f.Name</span>
                                        @if (isPD)
                                        {
                                            <span class="tpw-fdef-badge tpw-fdef-badge--plan">Plan Default</span>
                                        }
                                        @if (!isPD && ov.Enabled)
                                        {
                                            <span class="tpw-fdef-badge tpw-fdef-badge--override">Tenant Override</span>
                                        }
                                        @if (f.IsPremium)
                                        {
                                            <span class="tpw-fdef-badge tpw-fdef-badge--premium">Premium</span>
                                        }
                                    </div>
                                    <span class="tpw-fdef-desc">@f.Description</span>
                                </div>
                                <div class="tpw-fdef-switch">
                                    <SfSwitch TChecked="bool" Checked="ov.Enabled"
                                              ValueChange="@(e => ToggleFeatureDefault(f.Code, e.Checked))" />
                                </div>
                            </div>

                            @if (ov.Enabled)
                            {
                                <div class="tpw-fdef-detail">
                                    <div class="tpw-fdef-field">
                                        <label class="tpw-fdef-lbl">Source</label>
                                        <SfDropDownList TValue="string" TItem="LabelValue"
                                                        DataSource="_sourceTypeOptions"
                                                        @bind-Value="ov.SourceType"
                                                        Placeholder="Source type">
                                            <DropDownListFieldSettings Value="Value" Text="Label" />
                                        </SfDropDownList>
                                    </div>
                                    <div class="tpw-fdef-field">
                                        <label class="tpw-fdef-lbl">Effective Date</label>
                                        <SfTextBox @bind-Value="ov.EffectiveDate" Placeholder="YYYY-MM-DD" MaxLength="10" />
                                    </div>
                                    <div class="tpw-fdef-field tpw-fdef-field--notes">
                                        <label class="tpw-fdef-lbl">Notes</label>
                                        <SfTextBox @bind-Value="ov.Notes" Placeholder="Optional override notes?" MaxLength="500" />
                                    </div>
                                </div>
                            }

                            @if (!depsOk && ov.Enabled)
                            {
                                <div class="tpw-fdef-dep-warn">
                                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                    Requires @string.Join(", ", f.DependsOn!.Where(d => !GetFeatureOverride(d).Enabled).Select(d => _featureOptions.FirstOrDefault(x => x.Code == d)?.Name ?? d)) to be enabled first.
                                </div>
                            }
                        </div>
                    }
                </div>

                @{
                    var enabledCount   = _featureOptions.Count(f => GetFeatureOverride(f.Code).Enabled);
                    var overrideCount  = _featureOptions.Count(f => GetFeatureOverride(f.Code).SourceType == "TenantOverride");
                }
                <div class="tpw-entitlement-summary">
                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                    <span>
                        <strong>@enabledCount</strong> module@(enabledCount == 1 ? "" : "s") enabled
                        @if (overrideCount > 0)
                        {
                            <span> &mdash; <strong>@overrideCount</strong> tenant override@(overrideCount == 1 ? "" : "s")</span>
                        }
                    </span>
                    <button class="um-btn um-btn-ghost um-btn-sm" style="margin-left: auto;" @onclick="ResetToPlanDefaults">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset to Plan Defaults
                    </button>
                </div>
            </div>
        }

        <!-- Step 7: Branding Defaults -->
        @if (_step == 7)
        {
            <div class="tpw-panel-body">
                <h2 class="tpw-panel-title">
                    <i class="bi bi-palette" aria-hidden="true"></i> Branding Defaults
                </h2>
                <p class="tpw-panel-hint">Set tenant-specific visual defaults. All fields are optional and can be updated after provisioning.</p>

                <div class="tpw-branding-layout">
                    <!-- -- Form column -- -->
                    <div class="tpw-branding-form">
                        <div class="tpw-form-grid">
                            <div class="form-row">
                                <label class="form-label">Portal Display Name</label>
                                <SfTextBox @bind-Value="_form.PortalDisplayName" Placeholder="e.g. Acme Partner Portal" MaxLength="200" />
                                <span class="tpw-field-hint">Shown in the portal header and browser tab title.</span>
                            </div>
                            <div class="form-row">
                                <label class="form-label">White-Label Name</label>
                                <SfTextBox @bind-Value="_form.WhiteLabelName" Placeholder="e.g. Acme Platform" MaxLength="200" />
                                <span class="tpw-field-hint">Replaces &ldquo;AgencyBinder&rdquo; across all UI surfaces.</span>
                            </div>
                            <div class="form-row">
                                <label class="form-label">Logo</label>
                                <div class="tpw-upload-row">
                                    @if (!string.IsNullOrWhiteSpace(_form.LogoUrl))
                                    {
                                        <img src="@_form.LogoUrl" class="tpw-logo-preview" alt="Logo preview" />
                                    }
                                    <div class="tpw-upload-inputs">
                                        <label class="tpw-upload-btn">
                                            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                                            <span>@(_logoFileName ?? "Choose file?")</span>
                                            <InputFile OnChange="OnLogoSelected" accept="image/*" class="tpw-upload-hidden" />
                                        </label>
                                        <SfTextBox @bind-Value="_form.LogoUrl" Placeholder="or paste image URL?" MaxLength="1000" />
                                    </div>
                                </div>
                                <span class="tpw-field-hint">PNG, SVG, or WebP recommended. Max 2 MB.</span>
                            </div>
                            <div class="form-row">
                                <label class="form-label">Favicon</label>
                                <div class="tpw-upload-row">
                                    @if (!string.IsNullOrWhiteSpace(_form.FaviconUrl))
                                    {
                                        <img src="@_form.FaviconUrl" class="tpw-favicon-preview" alt="Favicon preview" />
                                    }
                                    <div class="tpw-upload-inputs">
                                        <label class="tpw-upload-btn">
                                            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
                                            <span>@(_faviconFileName ?? "Choose file?")</span>
                                            <InputFile OnChange="OnFaviconSelected" accept="image/*" class="tpw-upload-hidden" />
                                        </label>
                                        <SfTextBox @bind-Value="_form.FaviconUrl" Placeholder="or paste image URL?" MaxLength="1000" />
                                    </div>
                                </div>
                                <span class="tpw-field-hint">ICO or PNG, 16?16 or 32?32 recommended.</span>
                            </div>
                            <div class="form-row">
                                <label class="form-label">Theme</label>
                                <SfDropDownList TValue="string" TItem="LabelValue"
                                                DataSource="_themeOptions"
                                                @bind-Value="_form.Theme"
                                                Placeholder="Select theme">
                                    <DropDownListFieldSettings Value="Value" Text="Label" />
                                </SfDropDownList>
                            </div>
                            <div class="form-row">
                                <label class="form-label">Primary Colour</label>
                                <div class="tpw-colour-row">
                                    <input type="color" class="tpw-colour-picker" @bind="_form.PrimaryColor" />
                                    <SfTextBox @bind-Value="_form.PrimaryColor" Placeholder="#0d6efd" MaxLength="20" />
                                </div>
                            </div>
                            <div class="form-row">
                                <label class="form-label">Secondary Colour</label>
                                <div class="tpw-colour-row">
                                    <input type="color" class="tpw-colour-picker" @bind="_form.SecondaryColor" />
                                    <SfTextBox @bind-Value="_form.SecondaryColor" Placeholder="#6c757d" MaxLength="20" />
                                </div>
                            </div>
                            <div class="form-row">
                                <label class="form-label">Email Branding Profile</label>
                                <SfDropDownList TValue="string" TItem="LabelValue"
                                                DataSource="_emailBrandingProfileOptions"
                                                @bind-Value="_form.EmailBrandingProfile"
                                                Placeholder="Select profile">
                                    <DropDownListFieldSettings Value="Value" Text="Label" />
                                </SfDropDownList>
                                <span class="tpw-field-hint">Controls the header and footer style used in all outgoing emails.</span>
                            </div>
                            <div class="form-row">
                                <label class="form-label">Support Email</label>
                                <SfTextBox @bind-Value="_form.SupportEmail" Placeholder="e.g. support@acme.com" MaxLength="300" />
                            </div>
                            <div class="form-row">
                                <label class="form-label">Portal Footer Text</label>
                                <SfTextBox @bind-Value="_form.FooterText" Placeholder="? Acme. All rights reserved." MaxLength="500" />
                            </div>
                        </div>
                        <div class="tpw-branding-reset">
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetBrandingDefaults">
                                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                Reset to Default
                            </button>
                        </div>
                    </div>

                    <!-- -- Preview column -- -->
                    <div class="tpw-branding-previews">
                        <!-- Portal Header Preview -->
                        <div class="tpw-brand-preview">
                            <div class="tpw-brand-preview-label">
                                <i class="bi bi-window" aria-hidden="true"></i> Portal Header Preview
                            </div>
                            <div class="tpw-preview-header" style="background:@_form.PrimaryColor;">
                                @if (!string.IsNullOrWhiteSpace(_form.LogoUrl))
                                {
                                    <img src="@_form.LogoUrl" class="tpw-prev-logo" alt="Logo" />
                                }
                                else
                                {
                                    <span class="tpw-prev-logo-placeholder"><i class="bi bi-image" aria-hidden="true"></i></span>
                                }
                                <span class="tpw-prev-portal-name">@(string.IsNullOrWhiteSpace(_form.PortalDisplayName) ? (string.IsNullOrWhiteSpace(_form.WhiteLabelName) ? "Your Portal" : _form.WhiteLabelName) : _form.PortalDisplayName)</span>
                                <div class="tpw-prev-nav-dots"><span></span><span></span><span></span></div>
                            </div>
                        </div>

                        <!-- Login Screen Preview -->
                        <div class="tpw-brand-preview">
                            <div class="tpw-brand-preview-label">
                                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Login Screen Preview
                            </div>
                            <div class="tpw-preview-login">
                                <div class="tpw-preview-login-card">
                                    @if (!string.IsNullOrWhiteSpace(_form.LogoUrl))
                                    {
                                        <img src="@_form.LogoUrl" class="tpw-prev-login-logo" alt="Logo" />
                                    }
                                    else
                                    {
                                        <span class="tpw-prev-login-logo-placeholder"><i class="bi bi-building" aria-hidden="true"></i></span>
                                    }
                                    <p class="tpw-prev-login-title">@(string.IsNullOrWhiteSpace(_form.WhiteLabelName) ? "AgencyBinder" : _form.WhiteLabelName)</p>
                                    <div class="tpw-prev-login-field"></div>
                                    <div class="tpw-prev-login-field"></div>
                                    <div class="tpw-prev-login-btn" style="background:@_form.PrimaryColor;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Brand Colours -->
                        <div class="tpw-brand-preview">
                            <div class="tpw-brand-preview-label">
                                <i class="bi bi-palette2" aria-hidden="true"></i> Brand Colours
                            </div>
                            <div class="tpw-preview-colours">
                                <div class="tpw-prev-colour-swatch" style="background:@_form.PrimaryColor;">
                                    <span>Primary</span>
                                    <code>@_form.PrimaryColor</code>
                                </div>
                                <div class="tpw-prev-colour-swatch" style="background:@_form.SecondaryColor;">
                                    <span>Secondary</span>
                                    <code>@_form.SecondaryColor</code>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Step 8: Admin User -->
        @if (_step == 8)
        {
            <div class="tpw-panel-body">
                <h2 class="tpw-panel-title">
                    <i class="bi bi-person-badge" aria-hidden="true"></i> Admin User
                </h2>
                <p class="tpw-panel-hint">Create the first administrator account for this tenant.</p>
                <div class="tpw-form-grid">
                    <div class="form-row tpw-required">
                        <label class="form-label">Full Name <span class="form-required">*</span></label>
                        <SfTextBox @bind-Value="_form.AdminFullName" Placeholder="e.g. Jane Smith" MaxLength="300" />
                    </div>
                    <div class="form-row tpw-required">
                        <label class="form-label">Email <span class="form-required">*</span></label>
                        <SfTextBox @bind-Value="_form.AdminEmail" Placeholder="admin@acme.com" MaxLength="300" />
                    </div>
                    <div class="form-row">
                        <label class="form-label">Admin Username</label>
                        <SfTextBox @bind-Value="_form.AdminUsername" Placeholder="e.g. jsmith" MaxLength="100" />
                        <span class="tpw-field-hint">Leave blank to auto-generate from email address.</span>
                    </div>
                    <div class="form-row">
                        <label class="form-label">Invite Method</label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_inviteMethodOptions"
                                        @bind-Value="_form.InviteMethod"
                                        Placeholder="Select invite method">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="form-row tpw-switch-row">
                        <div class="tpw-switch-label-group">
                            <span class="form-label">Require MFA on First Login</span>
                            <span class="tpw-hint-text">Enforces multi-factor authentication for the admin account</span>
                        </div>
                        <SfSwitch @bind-Checked="_form.MfaRequired" />
                    </div>
                </div>
            </div>
        }

        <!-- Step 9: Review & Provision -->
        @if (_step == 9)
        {
            <div class="tpw-panel-body">
                <h2 class="tpw-panel-title">
                    <i class="bi bi-clipboard2-check" aria-hidden="true"></i> Review &amp; Provision
                </h2>
                <p class="tpw-panel-hint">Review all settings before provisioning. Use the Edit buttons to jump back to any step.</p>

                <div class="tpw-review-grid">

                    <SfCard CssClass="tpw-review-card">
                        <CardHeader>
                            <div class="tpw-review-card-hd">
                                <span><i class="bi bi-buildings" aria-hidden="true"></i> Tenant Identity</span>
                                <button class="um-btn um-btn-sm um-btn-ghost" @onclick="() => GoToStep(0)">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                                </button>
                            </div>
                        </CardHeader>
                        <CardContent>
                            <div class="tpw-field-grid">
                                <div class="tpw-field-group"><span class="ts-label">Code</span><span class="ts-value tpw-monospace">@_form.TenantCode</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Name</span><span class="ts-value">@_form.TenantName</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Legal Name</span><span class="ts-value">@(string.IsNullOrEmpty(_form.LegalName) ? "?" : _form.LegalName)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Type</span><span class="ts-value">@(string.IsNullOrEmpty(_form.TenantType) ? "?" : _form.TenantType)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Status</span><span class="ts-value">@_form.Status</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Time Zone</span><span class="ts-value">@_form.TimeZoneId</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Currency</span><span class="ts-value">@_form.CurrencyCode</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Locale</span><span class="ts-value">@_form.Locale</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Go-Live</span><span class="ts-value">@(_form.GoLiveDateUtc?.ToString("d") ?? "?")</span></div>
                            </div>
                        </CardContent>
                    </SfCard>

                    <SfCard CssClass="tpw-review-card">
                        <CardHeader>
                            <div class="tpw-review-card-hd">
                                <span><i class="bi bi-geo-alt" aria-hidden="true"></i> Region Assignment</span>
                                <button class="um-btn um-btn-sm um-btn-ghost" @onclick="() => GoToStep(1)">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                                </button>
                            </div>
                        </CardHeader>
                        <CardContent>
                            <div class="tpw-field-grid">
                                <div class="tpw-field-group"><span class="ts-label">Primary Region</span><span class="ts-value">@(_regionOptions.FirstOrDefault(r => r.Value == _form.RegionCode)?.Label ?? (string.IsNullOrEmpty(_form.RegionCode) ? "?" : _form.RegionCode))</span></div>
                                <div class="tpw-field-group"><span class="ts-label">DR Region</span><span class="ts-value">@(_regionOptions.FirstOrDefault(r => r.Value == _form.SecondaryRegionCode)?.Label ?? (string.IsNullOrEmpty(_form.SecondaryRegionCode) ? "?" : _form.SecondaryRegionCode))</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Compliance</span><span class="ts-value">@(string.IsNullOrEmpty(_form.ComplianceProfile) ? "?" : _form.ComplianceProfile)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Data Residency</span><span class="ts-value">@(string.IsNullOrEmpty(_form.DataResidencyRequirement) ? "?" : _form.DataResidencyRequirement)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">HIPAA-Ready</span><span class="ts-value">@(_form.HipaaReady ? "Yes" : "No")</span></div>
                            </div>
                        </CardContent>
                    </SfCard>

                    <SfCard CssClass="tpw-review-card">
                        <CardHeader>
                            <div class="tpw-review-card-hd">
                                <span><i class="bi bi-layers" aria-hidden="true"></i> Isolation Mode</span>
                                <button class="um-btn um-btn-sm um-btn-ghost" @onclick="() => GoToStep(2)">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                                </button>
                            </div>
                        </CardHeader>
                        <CardContent>
                            <div class="tpw-field-grid">
                                <div class="tpw-field-group"><span class="ts-label">Isolation</span><span class="ts-value">@(_isolationModeOptions.FirstOrDefault(o => o.Value == _form.IsolationMode)?.Label ?? _form.IsolationMode)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">DB Tier</span><span class="ts-value">@(string.IsNullOrEmpty(_form.DatabaseTier) ? "?" : _form.DatabaseTier)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Storage</span><span class="ts-value">@(string.IsNullOrEmpty(_form.StorageMode) ? "?" : _form.StorageMode)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Cache</span><span class="ts-value">@(string.IsNullOrEmpty(_form.CacheMode) ? "?" : _form.CacheMode)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Noisy Neighbour</span><span class="ts-value">@(string.IsNullOrEmpty(_form.NoisyNeighborLevel) ? "?" : _form.NoisyNeighborLevel)</span></div>
                            </div>
                        </CardContent>
                    </SfCard>

                    <SfCard CssClass="tpw-review-card">
                        <CardHeader>
                            <div class="tpw-review-card-hd">
                                <span><i class="bi bi-award" aria-hidden="true"></i> Subscription</span>
                                <button class="um-btn um-btn-sm um-btn-ghost" @onclick="() => GoToStep(3)">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                                </button>
                            </div>
                        </CardHeader>
                        <CardContent>
                            <div class="tpw-field-grid">
                                <div class="tpw-field-group"><span class="ts-label">Plan</span><span class="ts-value">@(string.IsNullOrEmpty(_form.PlanCode) ? "?" : _form.PlanCode)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Billing</span><span class="ts-value">@(string.IsNullOrEmpty(_form.BillingFrequency) ? "?" : _form.BillingFrequency)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Contract Ref</span><span class="ts-value">@(string.IsNullOrEmpty(_form.ContractRef) ? "?" : _form.ContractRef)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Enterprise Pricing</span><span class="ts-value">@(_form.EnterprisePricing ? "Yes" : "No")</span></div>
                            </div>
                        </CardContent>
                    </SfCard>

                    <SfCard CssClass="tpw-review-card">
                        <CardHeader>
                            <div class="tpw-review-card-hd">
                                <span><i class="bi bi-card-checklist" aria-hidden="true"></i> Plan Selection</span>
                                <button class="um-btn um-btn-sm um-btn-ghost" @onclick="() => GoToStep(4)">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                                </button>
                            </div>
                        </CardHeader>
                        <CardContent>
                            <div class="tpw-field-grid">
                                <div class="tpw-field-group"><span class="ts-label">Contract Type</span><span class="ts-value">@(string.IsNullOrEmpty(_form.ContractType) ? "?" : _form.ContractType)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Start Date</span><span class="ts-value">@(_form.SubscriptionStartDate?.ToString("d") ?? "?")</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Renewal</span><span class="ts-value">@(string.IsNullOrEmpty(_form.RenewalType) ? "?" : _form.RenewalType)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Trial</span><span class="ts-value">@(_form.TrialEnabled ? "Yes" : "No")</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Add-ons</span><span class="ts-value">@(_form.PlanAddons.Count == 0 ? "None" : string.Join(", ", _form.PlanAddons))</span></div>
                            </div>
                        </CardContent>
                    </SfCard>

                    <SfCard CssClass="tpw-review-card">
                        <CardHeader>
                            <div class="tpw-review-card-hd">
                                <span><i class="bi bi-globe2" aria-hidden="true"></i> Domain Setup</span>
                                <button class="um-btn um-btn-sm um-btn-ghost" @onclick="() => GoToStep(5)">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                                </button>
                            </div>
                        </CardHeader>
                        <CardContent>
                            <div class="tpw-field-grid">
                                <div class="tpw-field-group"><span class="ts-label">Subdomain</span><span class="ts-value">@(string.IsNullOrEmpty(_form.Subdomain) ? "?" : _form.Subdomain)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Custom Domain</span><span class="ts-value">@(string.IsNullOrEmpty(_form.CustomDomain) ? "?" : _form.CustomDomain)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Redirect Domain</span><span class="ts-value">@(string.IsNullOrEmpty(_form.RedirectDomain) ? "?" : _form.RedirectDomain)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">SSL</span><span class="ts-value">@(string.IsNullOrEmpty(_form.SslRequirement) ? "?" : _form.SslRequirement)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Verification</span><span class="ts-value">@(string.IsNullOrEmpty(_form.DomainVerificationMode) ? "?" : _form.DomainVerificationMode)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Verified</span><span class="ts-value">@(_form.DomainVerified ? "? Yes" : "Pending")</span></div>
                            </div>
                        </CardContent>
                    </SfCard>

                    <SfCard CssClass="tpw-review-card">
                        <CardHeader>
                            <div class="tpw-review-card-hd">
                                <span><i class="bi bi-toggles" aria-hidden="true"></i> Feature Defaults</span>
                                <button class="um-btn um-btn-sm um-btn-ghost" @onclick="() => GoToStep(6)">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                                </button>
                            </div>
                        </CardHeader>
                        <CardContent>
                            @{
                                var revEnabled   = _form.FeatureOverrides.Any() ? _form.FeatureOverrides.Where(kv => kv.Value.Enabled).Select(kv => kv.Key).ToList() : _form.EnabledFeatures;
                                var revOverrides = _form.FeatureOverrides.Where(kv => kv.Value.SourceType == "TenantOverride" && kv.Value.Enabled).Select(kv => kv.Key).ToList();
                            }
                            @if (revEnabled.Count == 0)
                            {
                                <span class="ts-value" style="color: var(--text-muted);">No modules selected</span>
                            }
                            else
                            {
                                <div class="tpw-field-group">
                                    <span class="ts-label">Enabled Modules</span>
                                    <div class="tpw-review-tags">
                                        @foreach (var code in revEnabled)
                                        {
                                            var isOverride = revOverrides.Contains(code);
                                            <span class="badge @(isOverride ? "badge-purple" : "badge-blue")" title="@(isOverride ? "Tenant Override" : "Plan Default")">@(_featureOptions.FirstOrDefault(x => x.Code == code)?.Name ?? code)</span>
                                        }
                                    </div>
                                </div>
                                @if (revOverrides.Count > 0)
                                {
                                    <div class="tpw-field-group" style="margin-top: var(--sp-2);">
                                        <span class="ts-label">Tenant Overrides</span>
                                        <span class="ts-value">@revOverrides.Count module@(revOverrides.Count == 1 ? "" : "s") deviate from plan defaults</span>
                                    </div>
                                }
                            }
                        </CardContent>
                    </SfCard>

                    <SfCard CssClass="tpw-review-card">
                        <CardHeader>
                            <div class="tpw-review-card-hd">
                                <span><i class="bi bi-palette" aria-hidden="true"></i> Branding</span>
                                <button class="um-btn um-btn-sm um-btn-ghost" @onclick="() => GoToStep(7)">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                                </button>
                            </div>
                        </CardHeader>
                        <CardContent>
                            <div class="tpw-field-grid">
                                <div class="tpw-field-group"><span class="ts-label">Portal Name</span><span class="ts-value">@(string.IsNullOrEmpty(_form.PortalDisplayName) ? "?" : _form.PortalDisplayName)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">White-Label</span><span class="ts-value">@(string.IsNullOrEmpty(_form.WhiteLabelName) ? "?" : _form.WhiteLabelName)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Logo</span><span class="ts-value">@(string.IsNullOrEmpty(_form.LogoUrl) ? ("?") : ("? Set"))</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Favicon</span><span class="ts-value">@(string.IsNullOrEmpty(_form.FaviconUrl) ? ("?") : ("? Set"))</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Theme</span><span class="ts-value">@(string.IsNullOrEmpty(_form.Theme) ? "?" : _form.Theme)</span></div>
                                <div class="tpw-field-group">
                                    <span class="ts-label">Primary</span>
                                    <span class="ts-value tpw-colour-swatch-row">
                                        <span class="tpw-colour-swatch" style="background:@_form.PrimaryColor;"></span>
                                        @_form.PrimaryColor
                                    </span>
                                </div>
                                <div class="tpw-field-group">
                                    <span class="ts-label">Secondary</span>
                                    <span class="ts-value tpw-colour-swatch-row">
                                        <span class="tpw-colour-swatch" style="background:@_form.SecondaryColor;"></span>
                                        @_form.SecondaryColor
                                    </span>
                                </div>
                                <div class="tpw-field-group"><span class="ts-label">Email Profile</span><span class="ts-value">@(string.IsNullOrEmpty(_form.EmailBrandingProfile) ? "?" : _form.EmailBrandingProfile)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Support Email</span><span class="ts-value">@(string.IsNullOrEmpty(_form.SupportEmail) ? "?" : _form.SupportEmail)</span></div>
                            </div>
                        </CardContent>
                    </SfCard>

                    <SfCard CssClass="tpw-review-card">
                        <CardHeader>
                            <div class="tpw-review-card-hd">
                                <span><i class="bi bi-person-badge" aria-hidden="true"></i> Admin User</span>
                                <button class="um-btn um-btn-sm um-btn-ghost" @onclick="() => GoToStep(8)">
                                    <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                                </button>
                            </div>
                        </CardHeader>
                        <CardContent>
                            <div class="tpw-field-grid">
                                <div class="tpw-field-group"><span class="ts-label">Full Name</span><span class="ts-value">@(string.IsNullOrEmpty(_form.AdminFullName) ? "?" : _form.AdminFullName)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Email</span><span class="ts-value">@(string.IsNullOrEmpty(_form.AdminEmail) ? "?" : _form.AdminEmail)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Username</span><span class="ts-value">@(string.IsNullOrEmpty(_form.AdminUsername) ? "Auto" : _form.AdminUsername)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">Invite Method</span><span class="ts-value">@(string.IsNullOrEmpty(_form.InviteMethod) ? "?" : _form.InviteMethod)</span></div>
                                <div class="tpw-field-group"><span class="ts-label">MFA Required</span><span class="ts-value">@(_form.MfaRequired ? "Yes" : "No")</span></div>
                            </div>
                        </CardContent>
                    </SfCard>

                </div>

                <!-- -- Validation Status -- -->
                <div class="tpw-review-validation">
                    <h3 class="tpw-review-section-title">
                        <i class="bi bi-shield-check" aria-hidden="true"></i> Validation Status
                    </h3>
                    @{
                        var valResults = GetValidationResults();
                    }
                    @if (valResults.Blockers.Count == 0 && valResults.Warnings.Count == 0)
                    {
                        <div class="tpw-val-banner tpw-val-banner--success">
                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                            <span>All required items are complete. Ready to provision.</span>
                        </div>
                    }
                    else
                    {
                        @if (valResults.Blockers.Count > 0)
                        {
                            <div class="tpw-val-banner tpw-val-banner--error">
                                <i class="bi bi-x-circle-fill" aria-hidden="true"></i>
                                <span><strong>@valResults.Blockers.Count blocker@(valResults.Blockers.Count == 1 ? "" : "s")</strong> must be resolved before provisioning.</span>
                            </div>
                            <ul class="tpw-val-list tpw-val-list--error">
                                @foreach (var b in valResults.Blockers)
                                {
                                    <li><i class="bi bi-x-circle" aria-hidden="true"></i> @b</li>
                                }
                            </ul>
                        }
                        @if (valResults.Warnings.Count > 0)
                        {
                            <div class="tpw-val-banner tpw-val-banner--warning">
                                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                <span><strong>@valResults.Warnings.Count warning@(valResults.Warnings.Count == 1 ? "" : "s")</strong> ? provisioning can proceed but review recommended.</span>
                            </div>
                            <ul class="tpw-val-list tpw-val-list--warning">
                                @foreach (var w in valResults.Warnings)
                                {
                                    <li><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @w</li>
                                }
                            </ul>
                        }
                    }
                    <div class="tpw-val-checklist">
                        <div class="tpw-val-check @(valResults.RequiredComplete ? "tpw-val-check--pass" : "tpw-val-check--fail")">
                            <i class="bi @(valResults.RequiredComplete ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                            <span>All required fields complete</span>
                        </div>
                        <div class="tpw-val-check @(valResults.ComplianceOk ? "tpw-val-check--pass" : "tpw-val-check--warn")">
                            <i class="bi @(valResults.ComplianceOk ? "bi-check-circle-fill" : "bi-exclamation-circle")" aria-hidden="true"></i>
                            <span>Compliance requirements met</span>
                        </div>
                        <div class="tpw-val-check @(valResults.CostImpact == null ? "tpw-val-check--pass" : "tpw-val-check--warn")">
                            <i class="bi @(valResults.CostImpact == null ? "bi-check-circle-fill" : "bi-info-circle")" aria-hidden="true"></i>
                            <span>@(valResults.CostImpact ?? "Standard cost tier")</span>
                        </div>
                    </div>
                </div>

                <!-- -- Estimated Provisioning Actions -- -->
                <div class="tpw-review-actions">
                    <h3 class="tpw-review-section-title">
                        <i class="bi bi-list-check" aria-hidden="true"></i> Estimated Provisioning Actions
                    </h3>
                    <div class="tpw-prov-actions-list">
                        @foreach (var action in GetEstimatedProvisioningActions())
                        {
                            <div class="tpw-prov-action">
                                <span class="tpw-prov-action-icon">
                                    <i class="bi @action.Icon" aria-hidden="true"></i>
                                </span>
                                <div class="tpw-prov-action-body">
                                    <span class="tpw-prov-action-title">@action.Title</span>
                                    <span class="tpw-prov-action-desc">@action.Description</span>
                                </div>
                                <span class="badge @action.BadgeCss">@action.Badge</span>
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_reviewError))
                {
                    <div class="tpw-info-notice tpw-info-notice--warning" style="margin-top: var(--sp-4);">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        <span>@_reviewError</span>
                    </div>
                }
            </div>
        }

        <!-- -- Footer nav ---------------------------------------- -->
        <div class="tpw-footer">
            <div class="tpw-footer-left">
                @if (_step > 0)
                {
                    <button class="um-btn um-btn-ghost" @onclick="PrevStep" disabled="@_provisioning">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i> Back
                    </button>
                }
            </div>
            <div class="tpw-footer-right">
                <span class="tpw-footer-hint">Step @(_step + 1) of @_steps.Length</span>
                <button class="um-btn um-btn-ghost" @onclick="SaveDraftAsync" disabled="@(_provisioning || _savingDraft)"
                        title="Save progress as a draft">
                    @if (_savingDraft)
                    {
                        <span class="um-spin" aria-hidden="true"></span>
                        <span>Saving?</span>
                    }
                    else
                    {
                        <i class="bi bi-floppy" aria-hidden="true"></i>
                        <span>Save Draft</span>
                    }
                </button>
                @if (_step < _steps.Length - 1)
                {
                    <button class="um-btn um-btn-primary" @onclick="NextStep" disabled="@_provisioning">
                        Next <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </button>
                }
                else
                {
                    <button class="um-btn um-btn-primary" @onclick="OpenConfirm" disabled="@_provisioning">
                        @if (_provisioning)
                        {
                            <span class="um-spin" aria-hidden="true"></span>
                            <span>Provisioning?</span>
                        }
                        else
                        {
                            <i class="bi bi-building-add" aria-hidden="true"></i>
                            <span>Provision Tenant</span>
                        }
                    </button>
                }
            </div>
        </div>

    </div>

    <!-- -- Right: live summary sidebar ------------------------ -->
    <aside class="tpw-sidebar" aria-label="Provisioning summary">

        <!-- Live summary -->
        <SfCard CssClass="tpw-sidebar-card">
            <CardHeader>
                <div class="tpw-sidebar-card-title">
                    <i class="bi bi-card-checklist" aria-hidden="true"></i>
                    <span>Summary</span>
                </div>
            </CardHeader>
            <CardContent>
                <div class="tpw-summary-rows">

                    @if (!string.IsNullOrWhiteSpace(_form.TenantCode))
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-buildings" aria-hidden="true"></i> Code</span>
                            <span class="tpw-summary-value tpw-monospace">@_form.TenantCode</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.TenantName))
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-tag" aria-hidden="true"></i> Name</span>
                            <span class="tpw-summary-value">@_form.TenantName</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.TenantType))
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-diagram-2" aria-hidden="true"></i> Type</span>
                            <span class="tpw-summary-value">@_form.TenantType</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.Status))
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-circle-half" aria-hidden="true"></i> Status</span>
                            <span class="tpw-summary-value">@_form.Status</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.RegionCode))
                    {
