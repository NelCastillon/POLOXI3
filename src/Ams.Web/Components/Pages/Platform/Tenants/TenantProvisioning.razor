    private HashSet<string> GetPlanDefaultFeatures()
    {
        if (_planDefaultFeatureMap.TryGetValue(_form.PlanCode ?? "Starter", out var codes))
            return new HashSet<string>(codes, StringComparer.OrdinalIgnoreCase);
        return new HashSet<string>(["CRM", "ACCOUNTS"], StringComparer.OrdinalIgnoreCase);
    }

    private FeatureOverride GetFeatureOverride(string code)
    {
        if (!_form.FeatureOverrides.TryGetValue(code, out var ov))
        {
            var planDefs = GetPlanDefaultFeatures();
            var enabled  = planDefs.Contains(code);
            ov = new FeatureOverride { Enabled = enabled, SourceType = enabled ? "PlanDefault" : "NotIncluded" };
            _form.FeatureOverrides[code] = ov;
        }
        return ov;
    }

    private void ToggleFeatureDefault(string code, bool enabled)
    {
        var ov       = GetFeatureOverride(code);
        ov.Enabled   = enabled;
        var planDefs = GetPlanDefaultFeatures();
        ov.SourceType = enabled == planDefs.Contains(code) ? "PlanDefault" : "TenantOverride";
        if (enabled) { if (!_form.EnabledFeatures.Contains(code)) _form.EnabledFeatures.Add(code); }
        else _form.EnabledFeatures.Remove(code);
    }

    private void ResetToPlanDefaults()
    {
        _form.FeatureOverrides.Clear();
        _form.EnabledFeatures.Clear();
        var planDefs = GetPlanDefaultFeatures();
        foreach (var f in _featureOptions)
        {
            var enabled = planDefs.Contains(f.Code);
            _form.FeatureOverrides[f.Code] = new FeatureOverride { Enabled = enabled, SourceType = enabled ? "PlanDefault" : "NotIncluded" };
            if (enabled) _form.EnabledFeatures.Add(f.Code);
        }
    }

    private void ToggleFeature(string code)
    {
        if (_form.EnabledFeatures.Contains(code)) _form.EnabledFeatures.Remove(code);
        else _form.EnabledFeatures.Add(code);
    }

    private void ToggleAddon(string code)
    {
        if (_form.EnabledAddons.Contains(code)) _form.EnabledAddons.Remove(code);
        else _form.EnabledAddons.Add(code);
    }

    private void TogglePlanAddon(string value)
    {
        if (_form.PlanAddons.Contains(value)) _form.PlanAddons.Remove(value);
        else _form.PlanAddons.Add(value);
    }

