    };

    private static string FormatApiCalls(long calls) =>
        calls == long.MaxValue  ? "Unlimited" :
        calls >= 1_000_000L     ? $"{calls / 1_000_000M:0.#}M" :
        calls >= 1_000L         ? $"{calls / 1_000M:0.#}K" : calls.ToString();

