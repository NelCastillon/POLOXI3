    private async Task ValidateDomainAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.CustomDomain)) return;
        _validatingDomain = true;
        try
        {
            // Simulate DNS lookup / CNAME resolution check.
            // Replace with a real ApiClient call when the endpoint is available.
            await Task.Delay(1500);
            _form.DomainVerified = true;
            await ShowToastAsync($"Domain '{_form.CustomDomain.Trim()}' verified successfully.", "Success");
