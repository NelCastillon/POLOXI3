                            <span class="tpw-summary-value">@_form.DataResidencyRequirement</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.IsolationMode))
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-layers" aria-hidden="true"></i> Isolation</span>
                            <span class="tpw-summary-value">@(_isolationModeOptions.FirstOrDefault(o => o.Value == _form.IsolationMode)?.Label ?? _form.IsolationMode)</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.PlanCode))
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-award" aria-hidden="true"></i> Plan</span>
                            <span class="tpw-summary-value">@_form.PlanCode</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.BillingFrequency))
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-calendar3" aria-hidden="true"></i> Billing</span>
                            <span class="tpw-summary-value">@_form.BillingFrequency</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.ContractType))
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-file-text" aria-hidden="true"></i> Contract</span>
                            <span class="tpw-summary-value">@_form.ContractType</span>
                        </div>
                    }
                    @if (_form.TrialEnabled)
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-clock" aria-hidden="true"></i> Trial</span>
                            <span class="tpw-summary-value">Enabled</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.RenewalType))
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Renewal</span>
                            <span class="tpw-summary-value">@_form.RenewalType</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.Subdomain))
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-globe2" aria-hidden="true"></i> Subdomain</span>
                            <span class="tpw-summary-value tpw-monospace">@_form.Subdomain</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.CustomDomain))
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-link-45deg" aria-hidden="true"></i> Custom Domain</span>
                            <span class="tpw-summary-value tpw-monospace">@_form.CustomDomain @(_form.DomainVerified ? "?" : "??")</span>
                        </div>
                    }
                    @if (_form.EnabledFeatures.Count > 0 || _form.EnabledAddons.Count > 0)
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-toggles" aria-hidden="true"></i> Modules</span>
                            <span class="tpw-summary-value">@(_form.EnabledFeatures.Count + _form.EnabledAddons.Count) selected</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.PortalDisplayName) || !string.IsNullOrWhiteSpace(_form.WhiteLabelName))
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-palette" aria-hidden="true"></i> Branding</span>
                            <span class="tpw-summary-value">@(string.IsNullOrWhiteSpace(_form.PortalDisplayName) ? _form.WhiteLabelName : _form.PortalDisplayName)</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_form.AdminEmail))
                    {
                        <div class="tpw-summary-row">
                            <span class="tpw-summary-label"><i class="bi bi-person" aria-hidden="true"></i> Admin</span>
                            <span class="tpw-summary-value">@_form.AdminEmail</span>
                        </div>
                    }

                    @if (string.IsNullOrWhiteSpace(_form.TenantCode) && string.IsNullOrWhiteSpace(_form.TenantName))
                    {
                        <p class="tpw-summary-empty">Complete the steps on the left to see a live summary here.</p>
                    }

                </div>
            </CardContent>
        </SfCard>

        <!-- Provisioning impact notes -->
        @{
            var impacts = GetImpactNotes();
        }
        @if (impacts.Count > 0)
        {
            <SfCard CssClass="tpw-sidebar-card tpw-impact-card">
                <CardHeader>
                    <div class="tpw-sidebar-card-title">
                        <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                        <span>Provisioning Impact</span>
                    </div>
                </CardHeader>
                <CardContent>
                    <ul class="tpw-impact-list">
                        @foreach (var note in impacts)
                        {
                            <li class="tpw-impact-item tpw-impact-item--@note.Level">
                                <i class="bi @note.Icon" aria-hidden="true"></i>
                                <span>@note.Text</span>
                            </li>
                        }
                    </ul>
                </CardContent>
            </SfCard>
        }

        <!-- Step progress -->
        <SfCard CssClass="tpw-sidebar-card">
            <CardContent>
                <div class="tpw-progress-list">
                    @for (int i = 0; i < _steps.Length; i++)
                    {
                        string pCls = i < _step  ? "tpw-progress-item tpw-progress-item--done"
                                    : i == _step ? "tpw-progress-item tpw-progress-item--active"
                                    :              "tpw-progress-item";
                        <div class="@pCls">
                            <div class="tpw-progress-dot">
                                @if (i < _step)
                                {
                                    <i class="bi bi-check" aria-hidden="true"></i>
                                }
                            </div>
                            <span>@_steps[i]</span>
                        </div>
                    }
                </div>
            </CardContent>
        </SfCard>

    </aside>

</div>
} @* end _provisioningState is null *@

<!-- -- Provisioning Progress Panel -------------------------------- -->
@if (_provisioningState is not null)
{
    <div class="tpw-provision-progress">
        <div class="tpw-provision-progress-hd">
            <div class="tpw-provision-progress-icon @($"tpw-provision-progress-icon--{_provisioningState.OverallStatus.ToLower()}")">
                @if (_provisioningState.OverallStatus == "Running")
                {
                    <span class="um-spin" aria-hidden="true"></span>
                }
                else if (_provisioningState.OverallStatus == "Completed")
                {
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                }
                else
                {
                    <i class="bi bi-x-circle-fill" aria-hidden="true"></i>
                }
            </div>
            <div class="tpw-provision-progress-title">
                <h2>@(_provisioningState.OverallStatus switch
                {
                    "Running"   => "Provisioning in Progress?",
                    "Completed" => "Provisioning Complete",
                    _           => "Provisioning Failed"
                })</h2>
                <span class="tpw-provision-progress-sub">Tenant: <strong>@_form.TenantCode</strong> ? @_form.TenantName</span>
            </div>
        </div>

        <!-- Progress bar -->
        <div class="tpw-provision-bar-wrapper">
            <div class="tpw-provision-bar">
                <div class="tpw-provision-bar-fill @($"tpw-provision-bar-fill--{_provisioningState.OverallStatus.ToLower()}")"
                     style="width: @(_provisioningState.ProgressPercent)%"></div>
            </div>
            <span class="tpw-provision-bar-label">@_provisioningState.ProgressPercent% complete</span>
        </div>

        <!-- Step log -->
        <div class="tpw-provision-log">
            <div class="tpw-provision-log-hd">
                <i class="bi bi-list-check" aria-hidden="true"></i>
                <span>Provisioning Steps</span>
                <span class="tpw-provision-log-count">
                    @_provisioningState.Steps.Count(s => s.Status == "Completed") / @_provisioningState.Steps.Count
                </span>
            </div>
            <div class="tpw-provision-steps">
                @foreach (var ps in _provisioningState.Steps)
                {
                    <div class="tpw-provision-step-row tpw-provision-step-row--@ps.Status.ToLower()">
                        <div class="tpw-provision-step-icon">
                            @if (ps.Status == "Completed")
                            {
                                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                            }
                            else if (ps.Status == "Running")
                            {
                                <span class="um-spin um-spin-sm" aria-hidden="true"></span>
                            }
                            else if (ps.Status == "Failed")
                            {
                                <i class="bi bi-x-circle-fill" aria-hidden="true"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle" aria-hidden="true"></i>
                            }
                        </div>
                        <div class="tpw-provision-step-body">
                            <span class="tpw-provision-step-name">@ps.Name</span>
                            @if (!string.IsNullOrWhiteSpace(ps.Detail))
                            {
                                <span class="tpw-provision-step-detail">@ps.Detail</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(ps.Error))
                            {
                                <span class="tpw-provision-step-error">@ps.Error</span>
                            }
                        </div>
                        <div class="tpw-provision-step-meta">
                            @if (ps.DurationMs > 0)
                            {
                                <span class="tpw-provision-step-duration">@(ps.DurationMs < 1000 ? $"{ps.DurationMs}ms" : $"{ps.DurationMs / 1000.0:F1}s")</span>
                            }
                            @if (ps.Status == "Failed")
                            {
                                <button class="um-btn um-btn-sm um-btn-ghost" @onclick="() => RetryStepAsync(ps.StepKey)" disabled="@_retrying">
                                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Retry
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Actions -->
        <div class="tpw-provision-actions">
            @if (_provisioningState.OverallStatus == "Completed")
            {
                <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo($"/platform/tenants/{_provisionedTenantId}")'>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i> Go to Tenant
                </button>
                <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/platform/tenants")'>
                    <i class="bi bi-list" aria-hidden="true"></i> Back to Tenants
                </button>
            }
            else if (_provisioningState.OverallStatus == "Failed")
            {
                <button class="um-btn um-btn-primary" @onclick="RetryAllFailedAsync" disabled="@_retrying">
                    @if (_retrying)
                    {
                        <span class="um-spin" aria-hidden="true"></span>
                        <span>Retrying?</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                        <span>Retry Failed Steps</span>
                    }
                </button>
                <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/platform/tenants")'>
                    <i class="bi bi-x-lg" aria-hidden="true"></i> Cancel
                </button>
            }
        </div>
    </div>
}

<!-- -- Confirm SfDialog ----------------------------------------- -->
<SfDialog @bind-Visible="_showConfirm"
          Width="600px"
          IsModal="true"
          ShowCloseIcon="true"
          Header="Confirm Provisioning">
    <DialogTemplates>
        <Content>
            <div class="tpw-dialog-body">
                <div class="tpw-dialog-icon">
                    <i class="bi bi-building-add" aria-hidden="true"></i>
                </div>
                <p class="tpw-dialog-message">
                    You are about to provision tenant <strong>@_form.TenantName</strong>.
                    Please confirm the details below.
                </p>

                <div class="tpw-confirm-summary">
                    <div class="tpw-confirm-row">
                        <span class="tpw-confirm-label">Tenant Code</span>
                        <span class="tpw-confirm-value tpw-monospace">@_form.TenantCode</span>
                    </div>
                    <div class="tpw-confirm-row">
                        <span class="tpw-confirm-label">Region</span>
                        <span class="tpw-confirm-value">@(_regionOptions.FirstOrDefault(r => r.Value == _form.RegionCode)?.Label ?? _form.RegionCode)</span>
                    </div>
                    <div class="tpw-confirm-row">
                        <span class="tpw-confirm-label">Isolation Mode</span>
                        <span class="tpw-confirm-value">@(_isolationModeOptions.FirstOrDefault(o => o.Value == _form.IsolationMode)?.Label ?? _form.IsolationMode)</span>
                    </div>
                    <div class="tpw-confirm-row">
                        <span class="tpw-confirm-label">Plan</span>
                        <span class="tpw-confirm-value">@(string.IsNullOrEmpty(_form.PlanCode) ? "?" : _form.PlanCode)</span>
                    </div>
                    <div class="tpw-confirm-row">
                        <span class="tpw-confirm-label">Admin</span>
                        <span class="tpw-confirm-value">@_form.AdminEmail</span>
                    </div>
                </div>

                <div class="tpw-confirm-actions-section">
                    <span class="tpw-confirm-actions-title">Provisioning actions to be executed:</span>
                    <ul class="tpw-confirm-actions-list">
                        @foreach (var action in GetEstimatedProvisioningActions())
                        {
                            <li><i class="bi @action.Icon" aria-hidden="true"></i> @action.Title</li>
                        }
                    </ul>
                </div>

                @if (_form.IsolationMode == "Dedicated")
                {
                    <div class="tpw-dialog-notice">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                        <span>Dedicated isolation will provision a new database instance. Infrastructure costs will begin immediately.</span>
                    </div>
                }

                <p class="tpw-dialog-detail">
                    This action cannot be undone. An invitation will be sent to <strong>@_form.AdminEmail</strong>.
                </p>
            </div>
        </Content>
        <FooterTemplate>
            <div class="tpw-dialog-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showConfirm = false" disabled="@_provisioning">
                    Cancel
                </button>
                <button class="um-btn um-btn-primary" @onclick="ProvisionAsync" disabled="@_provisioning">
                    @if (_provisioning)
                    {
                        <span class="um-spin" aria-hidden="true"></span>
                        <span>Provisioning?</span>
                    }
                    else
                    {
                        <i class="bi bi-building-add" aria-hidden="true"></i>
                        <span>Submit Provisioning</span>
                    }
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

