    // -- Navigation ------------------------------------------------------------
    private void NextStep()
    {
        _touched = true;
        _validationErrors = BuildStepErrors(_step);
        if (_validationErrors.Count > 0) return;
        _touched = false;
        _step = Math.Min(_step + 1, _steps.Length - 1);
    }

    private void PrevStep()
    {
        _touched = false;
        _validationErrors = [];
        _step = Math.Max(_step - 1, 0);
    }

    private void GoToStep(int target)
    {
        _touched = false;
        _validationErrors = [];
        _step = target;
    }

    private void TryGoToStep(int target)
    {
        if (target <= _step) GoToStep(target);
    }

    // -- Validation ------------------------------------------------------------
    private List<string> BuildStepErrors(int step)
    {
        List<string> errs = [];
        switch (step)
        {
            case 0:
                if (string.IsNullOrWhiteSpace(_form.TenantCode))
                    errs.Add("Tenant code is required.");
                else if (!System.Text.RegularExpressions.Regex.IsMatch(_form.TenantCode.Trim(), @"^[A-Za-z0-9_\-]{2,50}$"))
                    errs.Add("Tenant code must be 2?50 alphanumeric characters (hyphens and underscores allowed).");
                if (string.IsNullOrWhiteSpace(_form.TenantName))  errs.Add("Tenant name is required.");
                if (string.IsNullOrWhiteSpace(_form.TenantType))  errs.Add("Tenant type is required.");
                if (string.IsNullOrWhiteSpace(_form.Status))      errs.Add("Status is required.");
                if (string.IsNullOrWhiteSpace(_form.TimeZoneId))  errs.Add("Default timezone is required.");
                if (string.IsNullOrWhiteSpace(_form.CurrencyCode)) errs.Add("Default currency is required.");
                if (string.IsNullOrWhiteSpace(_form.Locale))      errs.Add("Default locale is required.");
                break;
            case 1:
                if (string.IsNullOrWhiteSpace(_form.RegionCode))
                    errs.Add("Primary region is required.");
                if (string.IsNullOrWhiteSpace(_form.ComplianceProfile))
                    errs.Add("Compliance profile is required.");
                if (string.IsNullOrWhiteSpace(_form.DataResidencyRequirement))
                    errs.Add("Data residency requirement is required.");
                // Cross-validate residency vs region
                if (!string.IsNullOrWhiteSpace(_form.RegionCode) && _form.DataResidencyRequirement == "EU")
                {
                    var reg = _regionOptions.FirstOrDefault(r => r.Value == _form.RegionCode);
                    if (reg is not null && !reg.GdprCompliant)
                        errs.Add("EU data residency requires a GDPR-compliant region. Please select an EU region.");
                }
                if (_form.HipaaReady && !string.IsNullOrWhiteSpace(_form.RegionCode))
                {
                    var reg = _regionOptions.FirstOrDefault(r => r.Value == _form.RegionCode);
                    if (reg is not null && !reg.HipaaEligible)
                        errs.Add("HIPAA-ready infrastructure requires a HIPAA-eligible region.");
                }
                if (!string.IsNullOrWhiteSpace(_form.SecondaryRegionCode) &&
                    _form.SecondaryRegionCode == _form.RegionCode)
                    errs.Add("Secondary / DR region must differ from the primary region.");
                break;
            case 2:
                // All isolation fields have defaults; validate cross-constraints only
                if (_form.IsolationMode is "DedicatedDatabase" or "DedicatedStamp" or "Premium"
                    && _form.DatabaseTier == "Shared")
                    errs.Add("A Dedicated or higher isolation mode requires a dedicated or higher database tier.");
                break;
            case 3:
                if (string.IsNullOrWhiteSpace(_form.PlanCode)) errs.Add("A subscription plan is required.");
                break;
            case 8:
                if (string.IsNullOrWhiteSpace(_form.AdminFullName)) errs.Add("Admin full name is required.");
                if (string.IsNullOrWhiteSpace(_form.AdminEmail))    errs.Add("Admin email is required.");
                break;
        }
        return errs;
    }

    private bool ValidateAll()
    {
        if (string.IsNullOrWhiteSpace(_form.TenantCode) || string.IsNullOrWhiteSpace(_form.TenantName))
        {
            _reviewError = "Tenant code and name are required. Go back to Step 1.";
            return false;
        }
        if (string.IsNullOrWhiteSpace(_form.RegionCode))
        {
            _reviewError = "Primary region is required. Go back to Step 2.";
            return false;
        }
        if (string.IsNullOrWhiteSpace(_form.PlanCode))
        {
            _reviewError = "A subscription plan is required. Go back to Step 4.";
            return false;
        }
        if (string.IsNullOrWhiteSpace(_form.AdminFullName) || string.IsNullOrWhiteSpace(_form.AdminEmail))
        {
            _reviewError = "Admin user full name and email are required. Go back to Step 9.";
            return false;
        }
        _reviewError = string.Empty;
        return true;
    }

