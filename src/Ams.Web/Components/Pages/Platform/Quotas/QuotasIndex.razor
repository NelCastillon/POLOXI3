@page "/platform/quotas"
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Quotas — Platform</PageTitle>

<AppPageHeader Title="Quotas"
               Subtitle="Manage quota rules, tenant-level overrides, and violation tracking"
               Icon="bi-speedometer2" />

<div class="qi-cards">
    <div class="qi-card" @onclick='() => Nav.NavigateTo("/platform/quotas/rules")'>
        <div class="qi-card-icon"><i class="bi bi-list-check"></i></div>
        <div class="qi-card-body">
            <span class="qi-card-value">@_ruleCount</span>
            <span class="qi-card-label">Quota Rules</span>
        </div>
        <i class="bi bi-chevron-right qi-card-arrow"></i>
    </div>
    <div class="qi-card" @onclick='() => Nav.NavigateTo("/platform/quotas/tenant")'>
        <div class="qi-card-icon"><i class="bi bi-people"></i></div>
        <div class="qi-card-body">
            <span class="qi-card-value">@_tenantQuotaCount</span>
            <span class="qi-card-label">Tenant Quota Overrides</span>
        </div>
        <i class="bi bi-chevron-right qi-card-arrow"></i>
    </div>
    <div class="qi-card qi-card--alert" @onclick='() => Nav.NavigateTo("/platform/quotas/violations")'>
        <div class="qi-card-icon"><i class="bi bi-exclamation-triangle"></i></div>
        <div class="qi-card-body">
            <span class="qi-card-value">@_openViolations</span>
            <span class="qi-card-label">Open Violations</span>
        </div>
        <i class="bi bi-chevron-right qi-card-arrow"></i>
    </div>
</div>

@code {
    int _ruleCount;
    int _tenantQuotaCount;
    int _openViolations;

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new BreadcrumbService.BreadcrumbItem("Platform", "/platform"),
            new BreadcrumbService.BreadcrumbItem("Quotas", "/platform/quotas"));

        var rulesTask = Api.SearchQuotaRulesAsync(pageSize: 1);
        var tenantTask = Api.SearchTenantQuotasAsync(pageSize: 1);
        var violationsTask = Api.GetQuotaViolationOpenCountAsync();

        await Task.WhenAll(rulesTask, tenantTask, violationsTask);

        _ruleCount = rulesTask.Result?.TotalCount ?? 0;
        _tenantQuotaCount = tenantTask.Result?.TotalCount ?? 0;
        _openViolations = violationsTask.Result;
    }
}
