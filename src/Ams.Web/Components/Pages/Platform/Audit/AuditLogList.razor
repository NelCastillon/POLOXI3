@page "/audit"
@page "/platform/audit2"
@page "/admin/security/audit2"
@page "/tenant/security/audit2"
@using Ams.Application.Common.Dtos
@using System.Text.Json
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Audit Log - AMS Enterprise</PageTitle>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="al-toast al-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @_toastIcon" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="al-toast-close" @onclick="ClearToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_detailVisible && _selected is not null)
{
    <div class="al-modal-backdrop" role="presentation" @onclick="CloseDetail">
        <div class="al-modal" role="dialog" aria-modal="true" aria-labelledby="al-detail-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <span id="al-detail-title">Audit Event Detail</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseDetail"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="um-modal-body">
                <div class="al-modal-intro"><span><i class="bi bi-fingerprint" aria-hidden="true"></i> Immutable audit evidence</span><p>Review actor, tenant, entity, source, and correlation metadata for the selected audit event.</p></div>
                <div class="al-detail-grid">
                    <div><span>Audit Log ID</span><strong class="al-mono">@_selected.AuditLogId</strong></div>
                    <div><span>Timestamp</span><strong>@_selected.PerformedDateUtc.ToLocalTime().ToString("g")</strong></div>
                    <div><span>Actor</span><strong class="al-mono">@ShortGuid(_selected.PerformedByUserId)</strong></div>
                    <div><span>Tenant</span><strong class="al-mono">@ShortGuid(_selected.TenantId)</strong></div>
                    <div><span>Action</span><strong>@_selected.ActionName</strong></div>
                    <div><span>Event Type</span><strong><span class="al-status @EventTypeCss(_selected.EventTypeCode)">@_selected.EventTypeCode</span></strong></div>
                    <div><span>Entity</span><strong>@_selected.EntityName</strong></div>
                    <div><span>Entity ID</span><strong class="al-mono">@_selected.EntityId</strong></div>
                    <div><span>Region</span><strong>@(_selected.RegionCode ?? "-")</strong></div>
                    <div><span>IP Address</span><strong>@(_selected.IpAddress ?? "-")</strong></div>
                    <div class="al-detail-wide"><span>Correlation ID</span><strong class="al-mono">@(_selected.CorrelationId ?? "-")</strong></div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => CopyCorrelation(_selected)"><i class="bi bi-clipboard" aria-hidden="true"></i> Copy Correlation</button>
                <button type="button" class="um-btn um-btn-primary" @onclick="() => OpenCompare(_selected)" disabled="@(!HasDiff(_selected))"><i class="bi bi-arrows-expand" aria-hidden="true"></i> Compare</button>
            </div>
        </div>
    </div>
}

@if (_compareVisible && _selected is not null)
{
    <div class="al-modal-backdrop" role="presentation" @onclick="CloseCompare">
        <div class="al-modal al-compare-modal" role="dialog" aria-modal="true" aria-labelledby="al-compare-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-arrows-expand" aria-hidden="true"></i>
                <span id="al-compare-title">Compare Before / After</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseCompare"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="um-modal-body">
                <div class="al-compare-container">
                    <div class="al-compare-pane"><h3>Before</h3><pre>@FormatJson(_selected.OldValues)</pre></div>
                    <div class="al-compare-pane"><h3>After</h3><pre>@FormatJson(_selected.NewValues)</pre></div>
                </div>
            </div>
        </div>
    </div>
}

<div class="al-enterprise-page">
    <section class="al-header" aria-label="Audit page header">
        <div class="al-header-left">
            <span class="al-lob-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
            <div class="al-header-info">
                <div class="al-title-row">
                    <h1 class="al-page-title">Audit Log</h1>
                    <span class="al-status-pill"><i class="bi bi-database-lock" aria-hidden="true"></i> Audit.AuditLog</span>
                    <span class="al-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Governance evidence</span>
                </div>
                <div class="al-sub-row">
                    <span class="al-sub-chip"><i class="bi bi-clock-history" aria-hidden="true"></i> Platform timeline</span>
                    <span class="al-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> API synced</span>
                    <span class="al-filter-note"><i class="bi bi-funnel" aria-hidden="true"></i> @FilterLabel</span>
                </div>
                <p>Search, review, compare, export, and monitor enterprise audit events across tenant activity, security actions, document workflow, reports, and configuration changes.</p>
            </div>
        </div>
        <div class="al-header-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "al-spin" : "")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ClearFilters"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger al-load-error" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i> @_loadError
        </div>
    }

    <section class="al-kpi-strip" aria-label="Audit metrics">
        @KpiCard("Total", _totalCount.ToString(), "Matching audit events", "bi-stack", "al-ki-blue", "")
        @KpiCard("Creates", CountType("Create").ToString(), "New records", "bi-plus-circle", "al-ki-green", "Create")
        @KpiCard("Updates", CountType("Update").ToString(), "Changed records", "bi-pencil-square", "al-ki-purple", "Update")
        @KpiCard("Deletes", CountType("Delete").ToString(), "Removal events", "bi-trash3", "al-ki-red", "Delete")
        @KpiCard("Logins", CountType("Login").ToString(), "Security events", "bi-box-arrow-in-right", "al-ki-amber", "Login")
        @KpiCard("Exports", CountType("Export").ToString(), "Evidence exports", "bi-download", "al-ki-cyan", "Export")
    </section>

    <section class="al-workflow-strip al-workflow-strip--polished" aria-label="Audit workflow">
        <button type="button" class="al-workflow-card al-wf-capture" @onclick='() => SetActionFilter("")'><span class="al-workflow-icon"><i class="bi bi-record-circle" aria-hidden="true"></i></span><span class="al-workflow-content"><strong>@_items.Count</strong><span>Capture</span><small>Current page events</small></span></button>
        <button type="button" class="al-workflow-card al-wf-review" @onclick='() => SetActionFilter("Update")'><span class="al-workflow-icon"><i class="bi bi-search" aria-hidden="true"></i></span><span class="al-workflow-content"><strong>@CountType("Update")</strong><span>Review</span><small>Changed records</small></span></button>
        <button type="button" class="al-workflow-card al-wf-secure" @onclick='() => SetActionFilter("Login")'><span class="al-workflow-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span><span class="al-workflow-content"><strong>@CountType("Login")</strong><span>Secure</span><small>Login activity</small></span></button>
        <button type="button" class="al-workflow-card al-wf-compare" @onclick="OpenFirstComparable"><span class="al-workflow-icon"><i class="bi bi-arrows-expand" aria-hidden="true"></i></span><span class="al-workflow-content"><strong>@_items.Count(HasDiff)</strong><span>Compare</span><small>Before/after evidence</small></span></button>
        <button type="button" class="al-workflow-card al-wf-export" @onclick="ExportAsync"><span class="al-workflow-icon"><i class="bi bi-file-earmark-arrow-down" aria-hidden="true"></i></span><span class="al-workflow-content"><strong>@_totalCount</strong><span>Export</span><small>Evidence package</small></span></button>
    </section>

    <section class="al-search-panel" role="search" aria-label="Search audit trail">
        <div class="al-search-wrap">
            <div class="al-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
            <div class="al-search-body">
                <label for="al-search-input">Enterprise search</label>
                <input id="al-search-input" class="al-search-input" type="search" aria-label="Search audit trail" placeholder="Search action, entity, IP address, correlation ID..." @bind="_searchTerm" @bind:event="oninput" />
                <span class="al-search-hint">Searches audit action, entity, network, actor, and correlation metadata.</span>
            </div>
        </div>
        <select class="al-filter-select form-select" @bind="_actionFilter" aria-label="Action filter">
            @foreach (var option in ActionOptions)
            {
                <option value="@option.Value">@option.Text</option>
            }
        </select>
        <div class="al-search-result um-search-result"><strong>@_totalCount</strong><span>matches</span></div>
        <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="ApplyFilters"><i class="bi bi-search" aria-hidden="true"></i> Search</button>
    </section>

    <section class="al-advanced-filters" aria-label="Advanced audit filters">
        <input class="al-filter-input" type="search" placeholder="Entity" @bind="_entityFilter" @bind:event="oninput" />
        <input class="al-filter-input" type="search" placeholder="Actor ID" @bind="_actorFilter" @bind:event="oninput" />
        <input class="al-filter-input" type="search" placeholder="Tenant ID" @bind="_tenantFilter" />
        <label><span>From</span><InputDate class="form-control al-date-input" @bind-Value="_fromDate" /></label>
        <label><span>To</span><InputDate class="form-control al-date-input" @bind-Value="_toDate" /></label>
        <select class="al-filter-select" @bind="_pageSize" @bind:after="OnPageSizeChanged" aria-label="Page size"><option value="10">10 rows</option><option value="25">25 rows</option><option value="50">50 rows</option><option value="100">100 rows</option></select>
        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
    </section>

    <section class="al-content-layout">
        <div class="al-grid-wrap">
            <div class="al-grid-toolbar">
                <div><strong>Audit Event Register</strong><span>Plain Blazor table backed by api/audit-logs</span></div>
                <div class="al-toolbar-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="SelectFirst" disabled="@(!_items.Any())"><i class="bi bi-cursor" aria-hidden="true"></i> Select First</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenFirstComparable" disabled="@(!_items.Any(HasDiff))"><i class="bi bi-arrows-expand" aria-hidden="true"></i> Compare First</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button></div>
            </div>

            @if (_loading)
            {
                <div class="al-loading"><i class="bi bi-arrow-repeat al-spin" aria-hidden="true"></i><strong>Loading audit events...</strong></div>
            }
            else if (!_items.Any())
            {
                <div class="al-empty-state"><i class="bi bi-journal-x" aria-hidden="true"></i><strong>No audit events found</strong><span>Adjust filters or run the migration seed to populate representative audit events.</span></div>
            }
            else
            {
                <div class="al-table-scroll">
                    <table class="al-table">
                        <thead><tr><th>Event</th><th>Action</th><th>Entity</th><th>Actor</th><th>Region</th><th>Correlation</th><th class="al-actions-col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var item in _items)
                            {
                                <tr class="al-table-row @(_selected?.AuditLogId == item.AuditLogId ? "al-table-row--selected" : "")" @onclick="() => SelectItem(item)">
                                    <td><div class="al-event-cell"><span class="al-event-icon @EventIconCss(item.EventTypeCode)"><i class="bi @EventIcon(item.EventTypeCode)" aria-hidden="true"></i></span><div><strong>@item.ActionName</strong><span>@item.PerformedDateUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span></div></div></td>
                                    <td><span class="al-status @EventTypeCss(item.EventTypeCode)">@item.EventTypeCode</span></td>
                                    <td><span class="al-entity">@item.EntityName</span></td>
                                    <td><span class="al-mono">@ShortGuid(item.PerformedByUserId)</span></td>
                                    <td>@(item.RegionCode ?? "-")</td>
                                    <td><span class="al-mono">@ShortText(item.CorrelationId, 12)</span></td>
                                    <td><div class="al-row-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => ShowDetail(item)" title="View detail"><i class="bi bi-eye" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenCompare(item)" disabled="@(!HasDiff(item))" title="Compare"><i class="bi bi-arrows-expand" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => CopyCorrelation(item)" title="Copy correlation"><i class="bi bi-clipboard" aria-hidden="true"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="al-pager"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_pageNumber <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</button><span>Page @_pageNumber of @TotalPages - @_totalCount records</span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_pageNumber >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button></div>
            }
        </div>

        <aside class="al-detail-panel" aria-label="Selected audit event">
            @if (_selected is null)
            {
                <div class="al-detail-empty"><i class="bi bi-shield-check" aria-hidden="true"></i><h2>Select an audit event</h2><p>Choose a row to inspect event details, actor, tenant, source, and compare before/after values.</p></div>
            }
            else
            {
                <div class="al-detail-head"><div class="al-detail-title-block"><span class="al-detail-eyebrow"><i class="bi @EventIcon(_selected.EventTypeCode)" aria-hidden="true"></i> @_selected.EventTypeCode</span><h2>@_selected.ActionName</h2><div class="al-detail-meta"><span><i class="bi bi-diagram-3" aria-hidden="true"></i> @_selected.EntityName</span><span><i class="bi bi-clock" aria-hidden="true"></i> @_selected.PerformedDateUtc.ToLocalTime().ToString("g")</span></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close details"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
                <div class="al-detail-body">
                    <div class="al-detail-summary"><div class="al-meta-row"><span class="al-meta-lbl">Actor</span><span class="al-meta-val al-mono">@ShortGuid(_selected.PerformedByUserId)</span></div><div class="al-meta-row"><span class="al-meta-lbl">Tenant</span><span class="al-meta-val al-mono">@ShortGuid(_selected.TenantId)</span></div><div class="al-meta-row"><span class="al-meta-lbl">IP Address</span><span class="al-meta-val">@(_selected.IpAddress ?? "-")</span></div><div class="al-meta-row"><span class="al-meta-lbl">Region</span><span class="al-meta-val">@(_selected.RegionCode ?? "-")</span></div></div>
                    <div class="al-policy-card"><strong>Evidence controls</strong><span><i class="bi bi-check2-circle" aria-hidden="true"></i> Correlation: @(_selected.CorrelationId ?? "-")</span><span><i class="bi bi-check2-circle" aria-hidden="true"></i> Before/after: @(HasDiff(_selected) ? "Available" : "Not supplied")</span><span><i class="bi bi-check2-circle" aria-hidden="true"></i> Source: Audit.AuditLog</span></div>
                    <div class="al-json-card"><div><strong>After values</strong><span>New values captured for this audit event.</span></div><pre>@FormatJson(_selected.NewValues)</pre></div>
                    <div class="al-detail-actions"><button type="button" class="um-btn um-btn-primary" @onclick="() => ShowDetail(_selected)"><i class="bi bi-eye" aria-hidden="true"></i> Full Detail</button><button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenCompare(_selected)" disabled="@(!HasDiff(_selected))"><i class="bi bi-arrows-expand" aria-hidden="true"></i> Compare</button><button type="button" class="um-btn um-btn-ghost" @onclick="() => CopyCorrelation(_selected)"><i class="bi bi-clipboard" aria-hidden="true"></i> Copy Correlation</button></div>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    private List<AuditLogDto> _items = [];
    private bool _loading;
    private string? _loadError;
    private int _totalCount;
    private int _pageNumber = 1;
    private int _pageSize = 25;
    private string _searchTerm = string.Empty;
    private string _actorFilter = string.Empty;
    private string _entityFilter = string.Empty;
    private string _actionFilter = string.Empty;
    private string _tenantFilter = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private AuditLogDto? _selected;
    private bool _detailVisible;
    private bool _compareVisible;
    private string? _toastMessage;
    private string _toastKind = "success";
    private string _toastIcon = "bi-check-circle-fill";

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));

    private string FilterLabel => string.IsNullOrWhiteSpace(_actionFilter) ? "All events" : _actionFilter;

    private static readonly FilterOption[] ActionOptions =
    [
        new("", "All Actions"),
        new("Create", "Create"),
        new("Update", "Update"),
        new("Delete", "Delete"),
        new("Login", "Login"),
        new("Export", "Export")
    ];

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Audit", null), new("Audit Log", "/audit"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchAuditLogsAsync(_searchTerm, _actionFilter, _actorFilter, _entityFilter, _tenantFilter, _fromDate, _toDate, _pageNumber, _pageSize);
            _items = result?.Items.ToList() ?? [];
            _totalCount = result?.TotalCount ?? 0;
            EnsureSelectedStillVisible();
        }
        catch (Exception ex)
        {
            _loadError = $"Error loading audit log: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger", "bi-exclamation-triangle-fill");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task ClearFilters()
    {
        _searchTerm = string.Empty;
        _actorFilter = string.Empty;
        _entityFilter = string.Empty;
        _actionFilter = string.Empty;
        _tenantFilter = string.Empty;
        _fromDate = null;
        _toDate = null;
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged()
    {
        _pageNumber = 1;
        await LoadAsync();
    }

    private async Task PreviousPage()
    {
        if (_pageNumber <= 1)
            return;

        _pageNumber--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (_pageNumber >= TotalPages)
            return;

        _pageNumber++;
        await LoadAsync();
    }

    private async Task SetActionFilter(string action)
    {
        _actionFilter = _actionFilter == action ? string.Empty : action;
        _pageNumber = 1;
        await LoadAsync();
    }

    private void SelectItem(AuditLogDto item) => _selected = item;

    private void SelectFirst()
    {
        _selected = _items.FirstOrDefault();
        if (_selected is null)
            ShowToast("No audit event is available to select.", "warning", "bi-exclamation-triangle-fill");
    }

    private void ShowDetail(AuditLogDto row)
    {
        _selected = row;
        _detailVisible = true;
    }

    private void CloseDetail() => _detailVisible = false;

    private void OpenCompare(AuditLogDto row)
    {
        if (!HasDiff(row))
        {
            ShowToast("No before/after values are available for this audit event.", "warning", "bi-exclamation-triangle-fill");
            return;
        }

        _selected = row;
        _compareVisible = true;
    }

    private void CloseCompare() => _compareVisible = false;

    private void OpenFirstComparable()
    {
        var row = _items.FirstOrDefault(HasDiff);
        if (row is null)
        {
            ShowToast("No comparable audit event is visible on this page.", "warning", "bi-exclamation-triangle-fill");
            return;
        }

        OpenCompare(row);
    }

    private Task ExportAsync()
    {
        if (!_items.Any())
        {
            ShowToast("No data to export.", "warning", "bi-exclamation-triangle-fill");
            return Task.CompletedTask;
        }

        ShowToast($"Export summary prepared for {_totalCount} audit records.", "success", "bi-download");
        return Task.CompletedTask;
    }

    private void CopyCorrelation(AuditLogDto row)
    {
        ShowToast(string.IsNullOrWhiteSpace(row.CorrelationId) ? "No correlation ID is available for this event." : $"Correlation ID ready to copy: {row.CorrelationId}", string.IsNullOrWhiteSpace(row.CorrelationId) ? "warning" : "success", string.IsNullOrWhiteSpace(row.CorrelationId) ? "bi-exclamation-triangle-fill" : "bi-clipboard-check");
    }

    private void EnsureSelectedStillVisible()
    {
        if (_selected is not null && _items.Any(x => x.AuditLogId == _selected.AuditLogId))
            return;

        _selected = _items.FirstOrDefault();
    }

    private int CountType(string type) => _items.Count(x => string.Equals(x.EventTypeCode, type, StringComparison.OrdinalIgnoreCase));

    private static bool HasDiff(AuditLogDto item) => !string.IsNullOrWhiteSpace(item.OldValues) || !string.IsNullOrWhiteSpace(item.NewValues);

    private static string FormatJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return "(empty)";

        try
        {
            using var doc = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return json;
        }
    }

    private static string EventIcon(string type) => type switch
    {
        "Create" => "bi-plus-circle",
        "Update" => "bi-pencil-square",
        "Delete" => "bi-trash3",
        "Login" => "bi-box-arrow-in-right",
        "Export" => "bi-download",
        _ => "bi-shield-check"
    };

    private static string EventIconCss(string type) => type switch
    {
        "Create" => "al-di-green",
        "Update" => "al-di-purple",
        "Delete" => "al-di-red",
        "Login" => "al-di-amber",
        "Export" => "al-di-cyan",
        _ => "al-di-blue"
    };

    private static string EventTypeCss(string type) => type switch
    {
        "Create" => "al-status-create",
        "Update" => "al-status-update",
        "Delete" => "al-status-delete",
        "Login" => "al-status-login",
        "Export" => "al-status-export",
        _ => "al-status-neutral"
    };

    private static string ShortGuid(Guid? value) => value.HasValue ? $"{value.Value:N}"[..8] + "..." : "-";

    private static string ShortText(string? value, int length) => string.IsNullOrWhiteSpace(value) ? "-" : value.Length > length ? value[..length] + "..." : value;

    private void ShowToast(string message, string kind, string icon)
    {
        _toastMessage = message;
        _toastKind = kind;
        _toastIcon = icon;
    }

    private void ClearToast() => _toastMessage = null;

    private RenderFragment KpiCard(string label, string value, string caption, string icon, string tone, string filterKey) => @<button type="button" class="al-kpi-card @tone @(_actionFilter == filterKey && !string.IsNullOrWhiteSpace(filterKey) ? "al-kpi-active" : "")" @onclick="() => SetActionFilter(filterKey)" title="Filter by @label"><span class="al-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span><span class="al-kpi-copy"><span class="al-kpi-label">@label</span><strong class="al-kpi-value">@value</strong><span class="al-kpi-caption">@caption</span></span></button>;

    private sealed record FilterOption(string Value, string Text);
}
