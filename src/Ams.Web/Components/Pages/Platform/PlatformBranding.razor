@page "/platform/branding"
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Tenant Branding - Platform</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<AppPageHeader Title="Tenant Branding"
               Subtitle="Branding configuration across tenants"
               Icon="bi-palette">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
    </Actions>
</AppPageHeader>

<!-- Search -->
<div class="um-grid-card app-datagrid">
    <div class="td-search-bar">
        <AppTextBox @bind-Value="_searchTerm" Placeholder="Search tenants..." @onkeyup="OnSearchKeyUp" />
        <button class="um-btn um-btn-primary um-btn-sm" @onclick="LoadAsync">
            <i class="bi bi-search" aria-hidden="true"></i> Search
        </button>
    </div>

    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite" aria-label="Loading...">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading branding...</span>
        </div>
    }
    <AppGrid @ref="_grid"
            TValue="TenantBrandingSummary"
            DataSource="@_items"
            AllowPaging="true"
            AllowSorting="true"
            EnableHover="true"
            RowHeight="52">
        
        
        <GridColumns>
            <GridColumn Field="@nameof(TenantBrandingSummary.TenantName)" HeaderText="Tenant" Width="200">
                <Template>
                    @{ var row = (TenantBrandingSummary)context; }
                    <a href="/platform/tenants/@row.TenantId" class="td-tenant-link">@(row.TenantName ?? "-")</a>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(TenantBrandingSummary.MainLogoUrl)" HeaderText="Logo" Width="120" AllowSorting="false">
                <Template>
                    @{ var row = (TenantBrandingSummary)context; }
                    @if (!string.IsNullOrEmpty(row.MainLogoUrl))
                    {
                        <img src="@row.MainLogoUrl" alt="Logo" style="height:28px;max-width:80px;vertical-align:middle;" />
                    }
                    else
                    {
                        <span class="td-muted">-</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(TenantBrandingSummary.PrimaryColor)" HeaderText="Primary Color" Width="160">
                <Template>
                    @{ var row = (TenantBrandingSummary)context; }
                    @if (!string.IsNullOrEmpty(row.PrimaryColor))
                    {
                        <span style="display:inline-flex;align-items:center;gap:6px;">
                            <span style="display:inline-block;width:18px;height:18px;border-radius:3px;background:@row.PrimaryColor;border:1px solid #ccc;"></span>
                            <span class="td-monospace">@row.PrimaryColor</span>
                        </span>
                    }
                    else
                    {
                        <span class="td-muted">-</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(TenantBrandingSummary.ThemeStyle)" HeaderText="Theme" Width="120">
                <Template>
                    @{ var row = (TenantBrandingSummary)context; }
                    @if (!string.IsNullOrEmpty(row.ThemeStyle))
                    {
                        <span class="td-stat-chip">
                            <i class="bi bi-brightness-high" aria-hidden="true"></i> @row.ThemeStyle
                        </span>
                    }
                    else
                    {
                        <span class="td-muted">-</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(TenantBrandingSummary.PortalTitle)" HeaderText="Portal Title" Width="180">
                <Template>
                    @{ var row = (TenantBrandingSummary)context; }
                    <span>@(string.IsNullOrEmpty(row.PortalTitle) ? "-" : row.PortalTitle)</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(TenantBrandingSummary.EmailSenderName)" HeaderText="Email Sender" Width="160">
                <Template>
                    @{ var row = (TenantBrandingSummary)context; }
                    <span>@(string.IsNullOrEmpty(row.EmailSenderName) ? "-" : row.EmailSenderName)</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="110" AllowSorting="false">
                <Template>
                    @{ var row = (TenantBrandingSummary)context; }
                    <div class="td-row-actions">
                        <button class="um-btn um-btn-xs um-btn-primary" title="Manage" @onclick="() => NavigateToManage(row.TenantId)">
                            <i class="bi bi-pencil-square" aria-hidden="true"></i> Manage
                        </button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </AppGrid>
</div>

@code {
    private AppGrid<TenantBrandingSummary>? _grid;
    private EnterpriseToast? _toast;

    private bool _loading = true;
    private string? _searchTerm;
    private List<TenantBrandingSummary> _items = [];

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new BreadcrumbService.BreadcrumbItem("Platform", "/platform"),
            new BreadcrumbService.BreadcrumbItem("Tenant Branding")
        );
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            // TODO: replace with Api.SearchAllTenantBrandingAsync(_searchTerm) when available
            _items = [];
        }
        catch
        {
            _items = [];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void NavigateToManage(Guid tenantId) => Nav.NavigateTo($"/platform/tenants/{tenantId}/branding");

    private async Task OnSearchKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadAsync();
    }

    private sealed record TenantBrandingSummary(
        Guid    TenantId,
        string  TenantName,
        string? MainLogoUrl,
        string? PrimaryColor,
        string? ThemeStyle,
        string? PortalTitle,
        string? EmailSenderName);
}
