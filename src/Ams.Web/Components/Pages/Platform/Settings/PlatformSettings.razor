@page "/platform/settings"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Platform Settings</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<AppPageHeader Title="Platform Settings"
               Subtitle="Manage global platform defaults and configuration"
               Icon="bi-gear">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="SaveAllAsync">
            <i class="bi bi-check-lg" aria-hidden="true"></i> Save Changes
        </button>
    </Actions>
</AppPageHeader>

@if (_loading)
{
    <div class="um-loading-overlay" aria-live="polite">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading settings...</span>
    </div>
}
else
{
    <div class="ps-container">
        @if (!string.IsNullOrWhiteSpace(_loadError))
        {
            <div class="alert alert-danger" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
                @_loadError
            </div>
        }

        <AppTab @bind-SelectedItem="_selectedTab" CssClass="ps-tabs">
            <TabItems>
                <TabItem>
                    <ChildContent>
                        <TabHeader Text="General" IconCss="bi bi-sliders" />
                    </ChildContent>
                    <ContentTemplate>
                        <div class="ps-tab-content">
                            <h6 class="ps-section-title">General Defaults</h6>
                            <p class="ps-section-desc">Platform-wide defaults applied globally - default time zone, currency, and locale used across all tenants.</p>
                            @foreach (var s in GetByModule("Core"))
                            {
                                <div class="ps-field-row">
                                    <label class="ps-label" title="@s.SettingKey">@FriendlyName(s.SettingKey)</label>
                                    <div class="ps-input">@RenderInput(s)</div>
                                    <span class="ps-desc">@s.Description</span>
                                    @if (!string.IsNullOrEmpty(s.DefaultValue))
                                    {
                                        <span class="ps-default-badge" title="Default value">Default: @s.DefaultValue</span>
                                    }
                                </div>
                            }
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent>
                        <TabHeader Text="Tenant Defaults" IconCss="bi bi-building" />
                    </ChildContent>
                    <ContentTemplate>
                        <div class="ps-tab-content">
                            <h6 class="ps-section-title">Tenant Defaults</h6>
                            <p class="ps-section-desc">Default isolation mode, onboarding configuration, and data-retention settings applied when a new tenant is provisioned.</p>
                            @foreach (var s in GetByModule("Tenant"))
                            {
                                <div class="ps-field-row">
                                    <label class="ps-label" title="@s.SettingKey">@FriendlyName(s.SettingKey)</label>
                                    <div class="ps-input">@RenderInput(s)</div>
                                    <span class="ps-desc">@s.Description</span>
                                    @if (!string.IsNullOrEmpty(s.DefaultValue))
                                    {
                                        <span class="ps-default-badge" title="Default value">Default: @s.DefaultValue</span>
                                    }
                                </div>
                            }
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent>
                        <TabHeader Text="Billing Defaults" IconCss="bi bi-receipt" />
                    </ChildContent>
                    <ContentTemplate>
                        <div class="ps-tab-content">
                            <h6 class="ps-section-title">Billing Defaults</h6>
                            <p class="ps-section-desc">Default billing cycle, invoice grace period, and overage handling behaviour for new subscriptions.</p>
                            @foreach (var s in GetByModule("Billing"))
                            {
                                <div class="ps-field-row">
                                    <label class="ps-label" title="@s.SettingKey">@FriendlyName(s.SettingKey)</label>
                                    <div class="ps-input">@RenderInput(s)</div>
                                    <span class="ps-desc">@s.Description</span>
                                    @if (!string.IsNullOrEmpty(s.DefaultValue))
                                    {
                                        <span class="ps-default-badge" title="Default value">Default: @s.DefaultValue</span>
                                    }
                                </div>
                            }
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent>
                        <TabHeader Text="Security" IconCss="bi bi-shield-lock" />
                    </ChildContent>
                    <ContentTemplate>
                        <div class="ps-tab-content">
                            <h6 class="ps-section-title">Security Defaults</h6>
                            <p class="ps-section-desc">MFA enforcement, session timeout, and password policy applied as platform-wide security baselines.</p>
                            @foreach (var s in GetByModule("IAM"))
                            {
                                <div class="ps-field-row">
                                    <label class="ps-label" title="@s.SettingKey">@FriendlyName(s.SettingKey)</label>
                                    <div class="ps-input">@RenderInput(s)</div>
                                    <span class="ps-desc">@s.Description</span>
                                    @if (!string.IsNullOrEmpty(s.DefaultValue))
                                    {
                                        <span class="ps-default-badge" title="Default value">Default: @s.DefaultValue</span>
                                    }
                                </div>
                            }
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent>
                        <TabHeader Text="Feature Defaults" IconCss="bi bi-toggles" />
                    </ChildContent>
                    <ContentTemplate>
                        <div class="ps-tab-content">
                            <h6 class="ps-section-title">Feature Defaults</h6>
                            <p class="ps-section-desc">Modules enabled by default for all newly provisioned tenants. Toggle individual modules on or off to control the default feature set.</p>
                            @foreach (var s in GetByModule("Feature"))
                            {
                                <div class="ps-field-row">
                                    <label class="ps-label" title="@s.SettingKey">@FriendlyName(s.SettingKey)</label>
                                    <div class="ps-input">@RenderInput(s)</div>
                                    <span class="ps-desc">@s.Description</span>
                                    @if (!string.IsNullOrEmpty(s.DefaultValue))
                                    {
                                        <span class="ps-default-badge" title="Default value">Default: @s.DefaultValue</span>
                                    }
                                </div>
                            }
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent>
                        <TabHeader Text="Usage Defaults" IconCss="bi bi-graph-up" />
                    </ChildContent>
                    <ContentTemplate>
                        <div class="ps-tab-content">
                            <h6 class="ps-section-title">Usage Defaults</h6>
                            <p class="ps-section-desc">Default user count caps, storage limits, API call quotas, and alert thresholds applied to new tenants.</p>
                            @foreach (var s in GetByModule("Usage"))
                            {
                                <div class="ps-field-row">
                                    <label class="ps-label" title="@s.SettingKey">@FriendlyName(s.SettingKey)</label>
                                    <div class="ps-input">@RenderInput(s)</div>
                                    <span class="ps-desc">@s.Description</span>
                                    @if (!string.IsNullOrEmpty(s.DefaultValue))
                                    {
                                        <span class="ps-default-badge" title="Default value">Default: @s.DefaultValue</span>
                                    }
                                </div>
                            }
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent>
                        <TabHeader Text="Regional Defaults" IconCss="bi bi-globe" />
                    </ChildContent>
                    <ContentTemplate>
                        <div class="ps-tab-content">
                            <h6 class="ps-section-title">Regional Defaults</h6>
                            <p class="ps-section-desc">Default deployment region, environment tier, and multi-region / disaster recovery options.</p>
                            @foreach (var s in GetByModule("Regional"))
                            {
                                <div class="ps-field-row">
                                    <label class="ps-label" title="@s.SettingKey">@FriendlyName(s.SettingKey)</label>
                                    <div class="ps-input">@RenderInput(s)</div>
                                    <span class="ps-desc">@s.Description</span>
                                    @if (!string.IsNullOrEmpty(s.DefaultValue))
                                    {
                                        <span class="ps-default-badge" title="Default value">Default: @s.DefaultValue</span>
                                    }
                                </div>
                            }
                        </div>
                    </ContentTemplate>
                </TabItem>

                <TabItem>
                    <ChildContent>
                        <TabHeader Text="Marketing Notifications" IconCss="bi bi-envelope-at" />
                    </ChildContent>
                    <ContentTemplate>
                        <div class="ps-tab-content">
                            <h6 class="ps-section-title">Marketing Notifications</h6>
                            <p class="ps-section-desc">Configure recipients for public website contact and demo request notifications.</p>
                            @foreach (var s in GetByModule("Marketing"))
                            {
                                <div class="ps-field-row">
                                    <label class="ps-label" title="@s.SettingKey">@FriendlyName(s.SettingKey)</label>
                                    <div class="ps-input">
                                        @RenderInput(s)
                                        @if (TryGetValidationError(s.SettingId, out var validationError))
                                        {
                                            <div class="text-danger">@validationError</div>
                                        }
                                    </div>
                                    <span class="ps-desc">@s.Description</span>
                                    @if (!string.IsNullOrEmpty(s.DefaultValue))
                                    {
                                        <span class="ps-default-badge" title="Default value">Default: @s.DefaultValue</span>
                                    }
                                </div>
                            }
                        </div>
                    </ContentTemplate>
                </TabItem>
            </TabItems>
        </AppTab>
    </div>
}

@code {
    private EnterpriseToast _toast = null!;
    private int _selectedTab;
    private bool _loading = true;
    private string? _loadError;
    private List<ConfigurationSettingDto> _settings = new();
    private readonly Dictionary<Guid, string?> _editedValues = new();
    private readonly Dictionary<Guid, string> _validationErrors = new();

    // Known enum-type fields rendered as dropdowns instead of free-text inputs
    private static readonly Dictionary<string, List<string>> KnownDropdownOptions = new()
    {
        ["Platform.DefaultBillingCycle"]    = ["Monthly", "Quarterly", "Annual"],
        ["Platform.OverageHandling"]        = ["Notify", "Block", "Allow"],
        ["Platform.DefaultIsolationMode"]   = ["Shared", "Dedicated"],
        ["Platform.DefaultRegionCode"]      = ["US-EAST", "US-WEST", "EU-WEST", "EU-NORTH", "APAC"],
        ["Platform.DefaultEnvironmentCode"] = ["Production", "Staging", "Development"],
        ["Platform.DefaultPlanCode"]        = ["Starter", "Standard", "Professional", "Enterprise"],
    };

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new BreadcrumbService.BreadcrumbItem("Platform", "/platform"),
            new BreadcrumbService.BreadcrumbItem("Settings"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _editedValues.Clear();
        try
        {
            _loadError = null;
            var result = await Api.GetConfigurationByScopeAsync("Platform");
            _settings = result ?? new();
            foreach (var s in _settings)
                _editedValues[s.SettingId] = s.SettingValue;
        }
        catch (Exception ex)
        {
            _loadError = $"Settings failed to load: {ex.Message}";
            _settings = new();
        }
        _loading = false;
    }

    private List<ConfigurationSettingDto> GetByModule(string moduleCode)
        => _settings.Where(s => string.Equals(s.ModuleCode, moduleCode, StringComparison.OrdinalIgnoreCase)).ToList();

    private RenderFragment RenderInput(ConfigurationSettingDto setting) => builder =>
    {
        var currentValue = _editedValues.GetValueOrDefault(setting.SettingId, setting.SettingValue);

        // Enum-type fields: render a dropdown
        if (KnownDropdownOptions.TryGetValue(setting.SettingKey, out var options))
        {
            builder.OpenComponent<AppSelect<string, string>>(0);
            builder.AddAttribute(1, "Value", currentValue ?? options[0]);
            builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v =>
            {
                _editedValues[setting.SettingId] = v;
            }));
            builder.AddAttribute(3, "DataSource", options);
            builder.AddAttribute(4, "CssClass", "ps-text-input");
            builder.AddAttribute(5, "Readonly", setting.IsReadOnly);
            builder.CloseComponent();
        }
        else if (setting.DataTypeCode == "Boolean")
        {
            var isChecked = string.Equals(currentValue, "true", StringComparison.OrdinalIgnoreCase);
            builder.OpenComponent<AppCheckBox>(0);
            builder.AddAttribute(1, "Checked", isChecked);
            builder.AddAttribute(2, "CheckedChanged", EventCallback.Factory.Create<bool>(this, v =>
            {
                _editedValues[setting.SettingId] = v ? "true" : "false";
            }));
            builder.AddAttribute(3, "Disabled", setting.IsReadOnly);
            builder.AddAttribute(4, "Label", "");
            builder.CloseComponent();
        }
        else if (setting.DataTypeCode == "Integer" || setting.DataTypeCode == "Decimal")
        {
            builder.OpenComponent<AppTextBox>(0);
            builder.AddAttribute(1, "Value", currentValue ?? "");
            builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v =>
            {
                _editedValues[setting.SettingId] = v;
            }));
            builder.AddAttribute(3, "Readonly", setting.IsReadOnly);
            builder.AddAttribute(4, "CssClass", "ps-text-input");
            builder.AddAttribute(5, "Type", "number");
            builder.CloseComponent();
        }
        else
        {
            builder.OpenComponent<AppTextBox>(0);
            builder.AddAttribute(1, "Value", currentValue ?? "");
            builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v =>
            {
                _editedValues[setting.SettingId] = v;
            }));
            builder.AddAttribute(3, "Readonly", setting.IsReadOnly);
            builder.AddAttribute(4, "CssClass", "ps-text-input");
            builder.CloseComponent();
        }
    };

    private async Task SaveAllAsync()
    {
        var changedCount = 0;
        try
        {
            _validationErrors.Clear();
            ValidateSettings();

            if (_validationErrors.Count > 0)
            {
                await _toast.ShowAsync(new ToastModel { Title = "Validation", Content = "Fix validation errors before saving.", CssClass = "e-toast-danger" });
                return;
            }

            foreach (var s in _settings)
            {
                if (_editedValues.TryGetValue(s.SettingId, out var newValue) && newValue != s.SettingValue)
                {
                    await Api.UpdateConfigurationValueAsync(s.SettingId, newValue);
                    s.SettingValue = newValue;
                    changedCount++;
                }
            }

            if (changedCount > 0)
                await _toast.ShowAsync(new ToastModel { Title = "Saved", Content = $"{changedCount} setting(s) updated successfully.", CssClass = "e-toast-success" });
            else
                await _toast.ShowAsync(new ToastModel { Title = "No Changes", Content = "No settings were modified.", CssClass = "e-toast-info" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Error", Content = $"Failed to save: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    private void ValidateSettings()
    {
        foreach (var setting in _settings)
        {
            if (!string.Equals(setting.SettingKey, "Platform.ContactIntakeNotificationRecipientEmail", StringComparison.OrdinalIgnoreCase))
                continue;

            var value = _editedValues.GetValueOrDefault(setting.SettingId, setting.SettingValue)?.Trim();
            if (string.IsNullOrWhiteSpace(value))
            {
                _validationErrors[setting.SettingId] = "Recipient email is required.";
                continue;
            }

            if (value.Length > 256)
            {
                _validationErrors[setting.SettingId] = "Recipient email cannot exceed 256 characters.";
                continue;
            }

            if (!new EmailAddressAttribute().IsValid(value))
                _validationErrors[setting.SettingId] = "Enter a valid recipient email address.";
        }
    }

    private bool TryGetValidationError(Guid settingId, out string validationError)
        => _validationErrors.TryGetValue(settingId, out validationError!);

    private static string FriendlyName(string settingKey)
    {
        var name = settingKey;
        if (name.StartsWith("Platform."))
            name = name["Platform.".Length..];
        if (name.StartsWith("ContactIntake"))
            name = name["ContactIntake".Length..];

        // Insert spaces before capital letters
        var result = new System.Text.StringBuilder();
        foreach (var ch in name)
        {
            if (char.IsUpper(ch) && result.Length > 0 && !char.IsUpper(result[^1]))
                result.Append(' ');
            result.Append(ch);
        }

        // Normalise well-known acronyms
        return result.ToString()
            .Replace("Mfa ",  "MFA ")
            .Replace(" Mfa",  " MFA")
            .Replace("Api ",  "API ")
            .Replace(" Api",  " API")
            .Replace("Dms ",  "DMS ")
            .Replace(" Dms",  " DMS")
            .Replace("Crm ",  "CRM ")
            .Replace(" Crm",  " CRM")
            .Replace("Smtp ", "SMTP ")
            .Replace(" Smtp", " SMTP")
            .Replace("Gb",    "GB")
            .Replace("Url",   "URL")
            .Replace("Pct",   "%");
    }
}

<style>
    @@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }
</style>
