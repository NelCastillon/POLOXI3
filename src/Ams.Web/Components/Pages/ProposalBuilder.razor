@page "/quotes/proposal/{SubmissionId:guid}"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Submissions
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject Ams.Web.Services.CurrentUserContext CurrentUser

<PageTitle>Proposal Workflow - AMS</PageTitle>
<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<AppPageHeader Icon="bi-file-earmark-richtext" Title="Proposal Workflow" Subtitle="Generate, deliver, present, and record customer acceptance using submission and quote data." OnBack="GoBack" OnRefresh="LoadAsync" />

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_loadError</div>
}
else if (_loading)
{
    <div class="um-loading"><div class="um-spinner"></div><span>Loading proposal workflow...</span></div>
}
else
{
    <div class="pc-kpi-strip">
        @Kpi("Versions", _proposals.Count.ToString(), "bi-layers")
        @Kpi("Generated", _proposals.Count(x => x.Status == "Generated").ToString(), "bi-file-earmark-check")
        @Kpi("Delivered", _proposals.Count(x => x.Status == "Delivered").ToString(), "bi-send-check")
        @Kpi("Accepted", _proposals.Count(x => x.Status == "Accepted").ToString(), "bi-check-circle")
    </div>

    <div class="um-card mb-3">
        <div class="um-card-header"><div><h2>Submission</h2><p>@_submission?.SubmissionNumber · @_submission?.AccountName · @_submission?.LineOfBusiness</p></div></div>
        <div class="um-card-body d-flex gap-2 flex-wrap">
            <button class="um-btn um-btn-primary" @onclick="OpenGenerate" disabled="@(!_quotes.Any())"><i class="bi bi-plus-lg"></i> Generate Proposal</button>
            <button class="um-btn um-btn-ghost" @onclick="OpenQuoteComparison"><i class="bi bi-columns-gap"></i> Compare Quotes</button>
            <button class="um-btn um-btn-ghost" @onclick="GoBack"><i class="bi bi-journal-text"></i> Submission</button>
        </div>
    </div>

    <div class="um-card">
        <div class="um-card-header"><div><h2>Proposal Versions</h2><p>Each version preserves its quote selection and lifecycle history.</p></div></div>
        <div class="um-card-body">
            @if (_proposals.Count == 0)
            {
                <div class="um-empty-state"><i class="bi bi-file-earmark-richtext"></i><strong>No proposals generated</strong><span>Generate a proposal from approved presentation-ready quotes.</span></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table enterprise-table align-middle">
                        <thead><tr><th>Proposal</th><th>Status</th><th>Delivery</th><th>Decision</th><th class="text-end">Actions</th></tr></thead>
                        <tbody>
                        @foreach (var item in _proposals)
                        {
                            <tr @ondblclick="() => ViewAsync(item.ProposalId)">
                                <td><strong>@item.Title</strong><div class="text-muted small">@item.DocumentFileName</div></td>
                                <td><span class="um-status-pill">@item.Status</span></td>
                                <td>@(item.SentDateUtc?.ToLocalTime().ToString("g") ?? "Not delivered")<div class="text-muted small">@item.DeliveryMethod @item.Recipient</div></td>
                                <td>@(item.ClientDecision ?? "Pending")</td>
                                <td class="text-end">
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ViewAsync(item.ProposalId)"><i class="bi bi-eye"></i> View</button>
                                    <button class="um-btn um-btn-ghost um-btn-sm" disabled="@(!HasStatus(item, "Generated"))" @onclick="() => OpenDeliver(item)"><i class="bi bi-send"></i> Deliver</button>
                                    <button class="um-btn um-btn-ghost um-btn-sm" disabled="@(!HasStatus(item, "Delivered"))" @onclick="() => PresentAsync(item)"><i class="bi bi-person-video3"></i> Present</button>
                                    <button class="um-btn um-btn-success um-btn-sm" disabled="@(!HasStatus(item, "Presented"))" @onclick="() => OpenDecision(item)"><i class="bi bi-check2-circle"></i> Decision</button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (_selected is not null)
    {
        <div class="um-card mt-3">
            <div class="um-card-header"><div><h2>@_selected.Title · Version @_selected.VersionNumber</h2><p>@_selected.Status · Generated @_selected.GeneratedDateUtc?.ToLocalTime().ToString("g")</p></div></div>
            <div class="um-card-body">
                <div class="row g-3">
                    <div class="col-lg-8"><div class="border rounded p-3">@((MarkupString)(_selected.HtmlContent ?? ""))</div></div>
                    <div class="col-lg-4">
                        <h3 class="h6">Included Quotes</h3>
                        @foreach (var quote in _selected.Quotes)
                        {
                            <div class="border rounded p-2 mb-2"><strong>@quote.CarrierName</strong><div>@quote.QuoteNumber · @quote.AnnualPremium.ToString("C0")</div><small>Limit @quote.Limit?.ToString("C0") · Deductible @quote.Deductible?.ToString("C0")</small></div>
                        }
                        <h3 class="h6 mt-3">Lifecycle</h3>
                        @foreach (var evt in _selected.Events)
                        {
                            <div class="border-start ps-2 mb-2"><strong>@evt.EventCode</strong><div class="small">@evt.EventDateUtc.ToLocalTime().ToString("g")</div><div class="small text-muted">@evt.EventDetail</div></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

@if (_dialog is not null)
{
    <div class="um-modal-backdrop" @onclick="CloseDialog"></div>
    <div class="um-modal" role="dialog" aria-modal="true">
        <div class="um-modal-header"><i class="bi bi-file-earmark-richtext"></i><span>@_dialog</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseDialog"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_form" OnValidSubmit="SaveDialogAsync"><DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                @if (_dialog == "Generate Proposal")
                {
                    <div class="um-form-field"><label>Title</label><InputText class="form-control" @bind-Value="_form.Title" /></div>
                    <div class="um-form-field um-form-field--full"><label>Introduction</label><InputTextArea class="form-control" rows="4" @bind-Value="_form.Notes" /></div>
                    <div class="um-form-field um-form-field--full"><label>Quotes</label>@foreach (var quote in _quotes){<label class="d-block"><input type="checkbox" checked="@_form.QuoteIds.Contains(quote.QuoteId)" @onchange="e => ToggleQuote(quote.QuoteId, (bool)e.Value!)" /> @quote.CarrierName · @quote.QuoteNumber · @quote.AnnualPremium.ToString("C0")</label>}</div>
                }
                else if (_dialog == "Deliver Proposal")
                {
                    <div class="um-form-field"><label>Delivery Method</label><InputSelect class="form-select" @bind-Value="_form.OptionCode">@foreach(var option in Options("DeliveryMethod")){<option value="@option.OptionCode">@option.DisplayName</option>}</InputSelect></div>
                    <div class="um-form-field"><label>Recipient</label><InputText class="form-control" @bind-Value="_form.Recipient" /></div>
                }
                else
                {
                    <div class="um-form-field"><label>Decision</label><InputSelect class="form-select" @bind-Value="_form.OptionCode">@foreach(var option in Options("Decision")){<option value="@option.OptionCode">@option.DisplayName</option>}</InputSelect></div>
                    @if (_form.OptionCode == "Accepted")
                    {
                        <div class="um-form-field"><label>Selected Quote</label><InputSelect class="form-select" @bind-Value="_form.SelectedQuoteId">@foreach(var quote in _selected?.Quotes ?? []){<option value="@quote.QuoteId">@quote.CarrierName · @quote.QuoteNumber</option>}</InputSelect></div>
                        <div class="um-form-field"><label>Authorization Method</label><InputSelect class="form-select" @bind-Value="_form.AuthorizationMethodCode">@foreach(var option in _authorizationMethods){<option value="@option.OptionCode">@option.OptionName</option>}</InputSelect></div>
                        <div class="um-form-field"><label>Authorized By</label><InputText class="form-control" @bind-Value="_form.AuthorizedByName" /></div>
                        <div class="um-form-field"><label>Reference</label><InputText class="form-control" @bind-Value="_form.Recipient" /></div>
                    }
                    <div class="um-form-field um-form-field--full"><label>Notes</label><InputTextArea class="form-control" rows="3" @bind-Value="_form.Notes" /></div>
                }
            </div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseDialog">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Save</button></div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public Guid SubmissionId { get; set; }
    SubmissionDto? _submission; List<QuoteComparisonDto> _quotes=[]; List<ProposalWorkflowDto> _proposals=[]; List<ProposalWorkflowOptionDto> _options=[]; List<SubmissionReferenceOptionDto> _authorizationMethods=[];
    ProposalDto? _selected; ProposalWorkflowDto? _target; Ams.Web.Services.CurrentUserContextModel? _currentUser; EnterpriseToast? _toast; bool _loading=true,_saving; string? _loadError,_dialog; FormModel _form=new();

    protected override async Task OnInitializedAsync(){ Breadcrumbs.SetCrumbs(new("Home","/"),new("Submissions","/submissions"),new("Submission",$"/submissions/{SubmissionId}"),new("Proposal Workflow",$"/quotes/proposal/{SubmissionId}")); await LoadAsync(); }
    async Task LoadAsync(){ try{_loading=true;_loadError=null;_currentUser??=await CurrentUser.RequireAsync();_submission=await Api.GetSubmissionByIdAsync(SubmissionId); _quotes=(await Api.GetSubmissionQuoteComparisonAsync(SubmissionId)??[]).ToList(); _proposals=(await Api.GetSubmissionProposalsAsync(SubmissionId)??[]).ToList(); _options=(await Api.GetProposalWorkflowOptionsAsync(_currentUser.TenantId)??[]).ToList(); _authorizationMethods=(await Api.GetSubmissionReferenceOptionsAsync(_currentUser.TenantId,"CustomerAuthorizationMethod")??[]).ToList(); if(_selected is not null) _selected=await Api.GetProposalByIdAsync(_selected.ProposalId); }catch(Exception ex){_loadError=ex.Message;}finally{_loading=false;} }
    RenderFragment Kpi(string label,string value,string icon)=>b=>{b.OpenElement(0,"div");b.AddAttribute(1,"class","pc-kpi-card");b.AddMarkupContent(2,$"<i class='bi {icon}'></i><strong>{value}</strong><span>{label}</span>");b.CloseElement();};
    IEnumerable<ProposalWorkflowOptionDto> Options(string group)=>_options.Where(x=>x.OptionGroupCode==group).OrderBy(x=>x.SortOrder);
    static bool HasStatus(ProposalWorkflowDto item, string status) => string.Equals(item.Status, status, StringComparison.OrdinalIgnoreCase);
    void OpenGenerate(){_target=null;_form=new(){Title=$"{_submission?.AccountName} Insurance Proposal",QuoteIds=_quotes.Where(x=>x.IsProposalReady).Select(x=>x.QuoteId).ToHashSet()};_dialog="Generate Proposal";}
    void OpenDeliver(ProposalWorkflowDto item){_target=item;_form=new(){OptionCode=Options("DeliveryMethod").FirstOrDefault(x=>x.IsDefault)?.OptionCode??Options("DeliveryMethod").FirstOrDefault()?.OptionCode??"",Recipient=item.Recipient??""};_dialog="Deliver Proposal";}
    async Task OpenDecision(ProposalWorkflowDto item){await ViewAsync(item.ProposalId);_target=item;_form=new(){OptionCode=Options("Decision").FirstOrDefault()?.OptionCode??"Accepted",SelectedQuoteId=_selected?.Quotes.FirstOrDefault(x=>x.IsSelected)?.QuoteId??_selected?.Quotes.FirstOrDefault()?.QuoteId,AuthorizationMethodCode=_authorizationMethods.FirstOrDefault(x=>x.IsDefault)?.OptionCode??_authorizationMethods.FirstOrDefault()?.OptionCode??""};_dialog="Customer Decision";}
    async Task ViewAsync(Guid id)=>_selected=await Api.GetProposalByIdAsync(id);
    async Task PresentAsync(ProposalWorkflowDto item){try{var user=_currentUser??=await CurrentUser.RequireAsync();await Api.PresentProposalAsync(item.ProposalId,new(user.TenantId,"Proposal presented to customer.",user.UserId));await LoadAsync();await Success("Proposal presented.");}catch(Exception ex){await Error(ex.Message);}}
    async Task SaveDialogAsync(){try{_saving=true;var user=_currentUser??=await CurrentUser.RequireAsync();if(_dialog=="Generate Proposal")await Api.GenerateProposalAsync(new(SubmissionId,user.TenantId,_form.Title,_form.QuoteIds.ToArray(),_form.Notes,user.UserId));else if(_dialog=="Deliver Proposal"&&_target is not null)await Api.DeliverProposalAsync(_target.ProposalId,new(user.TenantId,_form.OptionCode,_form.Recipient,user.UserId));else if(_target is not null)await Api.RecordProposalDecisionAsync(_target.ProposalId,new(user.TenantId,_form.OptionCode,_form.Notes,user.UserId,_form.SelectedQuoteId,_form.AuthorizationMethodCode,_form.Recipient,_form.AuthorizedByName,DateTime.UtcNow));CloseDialog();await LoadAsync();await Success("Proposal workflow updated.");}catch(Exception ex){await Error(ex.Message);}finally{_saving=false;}}
    void ToggleQuote(Guid id,bool selected){if(selected)_form.QuoteIds.Add(id);else _form.QuoteIds.Remove(id);} void CloseDialog(){_dialog=null;_target=null;} void GoBack()=>Nav.NavigateTo($"/submissions/{SubmissionId}"); void OpenQuoteComparison()=>Nav.NavigateTo($"/quotes/compare/{SubmissionId}");
    Task Success(string text)=>_toast!.ShowAsync(new(){Title="Success",Content=text,CssClass="enterprise-toast-success"}); Task Error(string text)=>_toast!.ShowAsync(new(){Title="Error",Content=text,CssClass="enterprise-toast-danger"});
    sealed class FormModel{[Required,StringLength(200)]public string Title{get;set;}="";public HashSet<Guid> QuoteIds{get;set;}=[];[Required]public string OptionCode{get;set;}="";[Required,StringLength(320)]public string Recipient{get;set;}="";public string? Notes{get;set;}public Guid? SelectedQuoteId{get;set;}public string? AuthorizationMethodCode{get;set;}public string? AuthorizedByName{get;set;}}
}
