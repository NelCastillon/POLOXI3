@page "/workbench/accounting"
@namespace Ams.Web.Components.Pages.Workbench
@using System.Globalization
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@inject ConfirmationDialogService Confirmations

<PageTitle>Enterprise Accounting Workbench</PageTitle>

@if (_toastVisible)
{
    <div class="acw-toast acw-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="acw-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="acw-enterprise-page">
    <section class="acw-hero">
        <div class="acw-hero-left">
            <span class="acw-hero-icon"><i class="bi bi-calculator-fill" aria-hidden="true"></i></span>
            <div>
                <div class="acw-title-row">
                    <h1>Accounting Workbench</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live finance data</span>
                    <span><i class="bi bi-cash-stack" aria-hidden="true"></i> Reconciliation governed</span>
                </div>
                <p>Manage premium reconciliation, AR aging, unapplied payments, commission adjustments, direct-bill exceptions, and month-end tasks in one enterprise command center.</p>
            </div>
        </div>
        <div class="acw-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh accounting workbench"><i class="bi @(_loading ? "bi-arrow-repeat acw-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-ghost" @onclick="GenerateAiSummaryAsync" disabled="@_aiLoading"><i class="bi @(_aiLoading ? "bi-arrow-repeat acw-spin" : "bi-stars")" aria-hidden="true"></i> AI Summary</button>
            <button class="um-btn um-btn-ghost" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/billing/accounting")'><i class="bi bi-journal-check" aria-hidden="true"></i> Billing</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger acw-error-banner" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="acw-insight-strip" aria-label="Accounting insights">
        <article class="acw-insight-card acw-insight-primary"><span class="acw-insight-icon acw-tone-warning"><i class="bi bi-bullseye" aria-hidden="true"></i></span><div><small>Accounting Focus</small><strong>@AccountingFocusText</strong></div></article>
        <article class="acw-insight-card"><span class="acw-insight-icon acw-tone-danger"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span><div><small>AR Exposure</small><strong>@_c.ArAmount.ToString("C0", CultureInfo.CurrentCulture)</strong></div></article>
        <article class="acw-insight-card"><span class="acw-insight-icon acw-tone-success"><i class="bi bi-cash-coin" aria-hidden="true"></i></span><div><small>Unapplied Cash</small><strong>@_c.UnappliedAmount.ToString("C0", CultureInfo.CurrentCulture)</strong></div></article>
        <article class="acw-insight-card"><span class="acw-insight-icon acw-tone-purple"><i class="bi bi-calendar-check" aria-hidden="true"></i></span><div><small>Month-end</small><strong>@MonthEndProgressText</strong></div></article>
    </section>

    <section class="acw-ops-strip">
        <article class="acw-scope-card">
            <div class="acw-scope-head"><span><i class="bi bi-funnel" aria-hidden="true"></i> Finance Scope</span><strong>@(_scope.Equals("team", StringComparison.OrdinalIgnoreCase) ? "Team" : "Me")</strong></div>
            <div class="acw-scope-grid">
                <label><span>Scope</span><select class="acw-filter-select" value="@_scope" @onchange="ScopeChangedCallback"><option value="me">My queue</option><option value="team">Team queue</option></select></label>
                <label><span>Branch</span><input class="acw-filter-input" value="@_branchId" @onchange="BranchChangedCallback" placeholder="All branches" /></label>
                <label><span>Team</span><input class="acw-filter-input" value="@_teamId" @onchange="TeamChangedCallback" placeholder="All teams" /></label>
            </div>
        </article>
        <article class="acw-ai-card">
            <div class="acw-ai-head"><span><i class="bi bi-stars" aria-hidden="true"></i> Accounting Intelligence</span>@if (_aiGeneratedAt.HasValue) { <small>@FormatAge(_aiGeneratedAt.Value)</small> }</div>
            <p>@(_aiSummary ?? "Generate a finance summary to prioritize reconciliation variance, overdue AR, unapplied cash, direct-bill exceptions, and month-end close tasks.")</p>
        </article>
    </section>

    <section class="acw-kpi-strip" aria-label="Accounting queue metrics">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" title="@metric.Caption" @onclick="@(() => SetActiveQueue(metric.QueueId))">
                <span class="acw-kpi-icon @metric.Tone"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span><span class="acw-kpi-val">@metric.Value</span><span class="acw-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
            </button>
        }
    </section>

    <section class="acw-workflow-strip" aria-label="Accounting workflow actions">
        <button class="acw-workflow-card" @onclick="ShowReconciliation"><i class="bi bi-arrow-left-right" aria-hidden="true"></i><span><strong>Reconcile variance</strong><span>Open premium reconciliation items.</span></span></button>
        <button class="acw-workflow-card" @onclick="ShowAging"><i class="bi bi-hourglass-split" aria-hidden="true"></i><span><strong>Collect AR</strong><span>Focus overdue receivables.</span></span></button>
        <button class="acw-workflow-card" @onclick="ShowUnapplied"><i class="bi bi-cash-coin" aria-hidden="true"></i><span><strong>Apply cash</strong><span>Clear unapplied payments.</span></span></button>
        <button class="acw-workflow-card" @onclick="ShowMonthEnd"><i class="bi bi-calendar-check" aria-hidden="true"></i><span><strong>Close month</strong><span>Review close checklist.</span></span></button>
    </section>

    <section class="acw-search-panel">
        <div class="acw-search-wrap">
            <span class="acw-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="acw-search-body">
                <label for="accountingSearchInput">Search accounting queue</label>
                <input id="accountingSearchInput" class="acw-search-input" value="@_search" @oninput="SearchChangedCallback" placeholder="Search item, account, ref, policy, carrier, producer, category, method, reason, or notes..." />
                <span class="acw-search-hint">Filters apply to the active queue while preserving the synced accounting aggregate.</span>
            </div>
        </div>
        <select class="acw-filter-select" value="@_filterPriority" @onchange="PriorityChangedCallback" title="Filter priority">
            <option value="">All priorities</option>
            @foreach (var option in _priorityOptions) { <option value="@option.Value">@option.Label</option> }
        </select>
        <select class="acw-filter-select" value="@_filterSla" @onchange="SlaChangedCallback" title="Filter SLA">
            <option value="">All SLA</option>
            @foreach (var option in _slaOptions) { <option value="@option.Value">@option.Label</option> }
        </select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
        <div class="acw-search-result"><strong>@ActiveQueueCount</strong><span>@ActiveQueueLabel</span></div>
    </section>

    <section class="acw-view-tabs" aria-label="Accounting queue tabs">
        @foreach (var q in Queues)
        {
            <button type="button" class="@QueueTabClass(q.Id)" @onclick="@(() => SetActiveQueue(q.Id))"><i class="@q.Icon" aria-hidden="true"></i> @q.Label @if (q.Badge > 0) { <span class="@(q.IsAlert ? "acw-tab-alert" : string.Empty)">@q.Badge</span> }</button>
        }
        <button type="button" class="@QueueTabClass("analytics")" @onclick='() => SetActiveQueue("analytics")'><i class="bi bi-bar-chart" aria-hidden="true"></i> Analytics</button>
        <button type="button" class="@QueueTabClass("views")" @onclick='() => SetActiveQueue("views")'><i class="bi bi-bookmark-star" aria-hidden="true"></i> Saved Views @if (_savedViews.Count > 0) { <span>@_savedViews.Count</span> }</button>
    </section>

    <section class="acw-content-layout">
        <main class="acw-main-card">
            @if (_loading)
            {
                <div class="acw-loading"><i class="bi bi-arrow-repeat acw-spin" aria-hidden="true"></i><strong>Loading accounting workbench...</strong></div>
            }
            else if (_activeQueue == "analytics")
            {
                <div class="acw-section-head"><div><h2>Accounting analytics</h2><p>Monitor accounting queue mix, exposure, SLA health, and month-end progress.</p></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-x-lg"></i> Reset</button></div>
                <div class="acw-analytics-grid"><section><h3>Queue distribution</h3>@foreach (var row in QueueDistribution) { @AnalyticsItem(row) }</section><section><h3>Exposure by queue</h3>@foreach (var row in ExposureDistribution) { @AnalyticsItem(row) }</section><section><h3>SLA health</h3>@foreach (var row in SlaDistribution) { @AnalyticsItem(row) }</section><section><h3>Priority mix</h3>@foreach (var row in PriorityDistribution) { @AnalyticsItem(row) }</section></div>
            }
            else if (_activeQueue == "views")
            {
                <div class="acw-section-head"><div><h2>Saved views</h2><p>Save, load, and delete accounting workbench view state for your current queue and scope.</p></div><button class="um-btn um-btn-primary um-btn-sm" @onclick="SaveCurrentViewAsync"><i class="bi bi-bookmark-plus"></i> Save Current View</button></div>
                @if (_savedViews.Count == 0) { @EmptyState("bi-bookmark-star", "No saved views yet", "Save the current scope, queue, and filters for quick access.") } else { <div class="acw-card-grid">@foreach (var view in _savedViews) { <article class="acw-view-card"><div><strong>@view.Name</strong><span>@view.QueueId ? @view.Scope</span><small>@(string.IsNullOrWhiteSpace(view.BranchId) ? "All branches" : view.BranchId) ? @(string.IsNullOrWhiteSpace(view.TeamId) ? "All teams" : view.TeamId)</small></div><div class="acw-item-actions"><button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => LoadViewAsync(view.Name))">Load</button><button class="um-btn um-btn-danger um-btn-sm" @onclick="@(() => DeleteViewAsync(view.Name))">Delete</button></div></article> }</div> }
            }
            else
            {
                <div class="acw-section-head"><div><h2>@ActiveQueueTitle</h2><p>@ActiveQueueSubtitle</p></div><button class="um-btn um-btn-primary um-btn-sm" @onclick='() => Nav.NavigateTo("/billing/accounting")'><i class="bi bi-journal-check"></i> Billing</button></div>
                @if (ActiveItems.Count == 0) { @EmptyState(ActiveQueueIcon, "No records match this queue", "Adjust filters, refresh the workbench, or open billing.") } else { <div class="acw-card-grid">@foreach (var item in ActiveItems) { @QueueCard(item) }</div> }
            }
        </main>

        <aside class="acw-detail-card">
            @if (_selected is not null)
            {
                <div class="acw-detail-head"><div><span class="acw-detail-eyebrow"><i class="bi @ActiveQueueIcon" aria-hidden="true"></i> @_selected.Category</span><h2>@_selected.Title</h2><p>@_selected.AccountName</p></div><span class="@PriBadge(_selected.Priority)">@_selected.Priority</span></div>
                <div class="acw-detail-body"><div class="acw-detail-summary"><div><span>Ref</span><strong>@_selected.RefNumber</strong></div><div><span>SLA</span><strong class="@SlaTextClass(_selected.SlaStatus)">@_selected.SlaStatus</strong></div><div><span>Amount</span><strong class="@AmtTextClass(_selected.Amount)">@_selected.Amount.ToString("C0")</strong></div><div><span>Variance</span><strong class="@AmtTextClass(_selected.Variance)">@_selected.Variance.ToString("C0")</strong></div><div><span>Due</span><strong>@_selected.DueDate.ToString("d", CultureInfo.CurrentCulture)</strong></div><div><span>Status</span><strong>@_selected.Status</strong></div></div>@if (!string.IsNullOrWhiteSpace(_selected.Notes) || !string.IsNullOrWhiteSpace(_selected.Reason)) { <p class="acw-detail-note">@DetailNote(_selected)</p> }<div class="acw-detail-actions"><button class="um-btn um-btn-ghost" @onclick="MarkReviewedAsync"><i class="bi bi-check2-circle"></i> Mark Reviewed</button><button class="um-btn um-btn-primary" @onclick="@(() => Nav.NavigateTo(_selected.DetailUrl))">Open Record <i class="bi bi-arrow-right"></i></button></div></div>
            }
            else
            {
                <div class="acw-detail-empty"><i class="bi bi-calculator-fill" aria-hidden="true"></i><strong>Select an accounting item</strong><span>Review amount, variance, AR aging, month-end status, and source-record context.</span></div>
            }
        </aside>
    </section>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;

    private bool _loading;
    private bool _toastVisible;
    private string? _loadError;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string _scope = "me";
    private string _branchId = string.Empty;
    private string _teamId = string.Empty;
    private string _activeQueue = "reconciliation";
    private AcctItem? _selected;

    private string _search = string.Empty;
    private string _filterPriority = string.Empty;
    private string _filterSla = string.Empty;

    private string? _aiSummary;
    private bool _aiLoading;
    private DateTime? _aiGeneratedAt;
    private List<SavedViewVm> _savedViews = [];
    private List<SlaHeatItemVm> _slaItems = [];
    private AcctCounts _c = new();

    private List<AcctItem> _reconciliation = [];
    private List<AcctItem> _arAging = [];
    private List<AcctItem> _unappliedPayments = [];
    private List<AcctItem> _commissionAdj = [];
    private List<AcctItem> _directBill = [];
    private List<AcctItem> _monthEnd = [];

    private readonly List<LabelValue> _priorityOptions = [new("Critical", "Critical"), new("Urgent", "Urgent"), new("High", "High"), new("Normal", "Normal"), new("Low", "Low")];
    private readonly List<LabelValue> _slaOptions = [new("On Track", "On Track"), new("At Risk", "At Risk"), new("Breached", "Breached")];
    private List<QDef> Queues => [new("reconciliation", "Reconciliation", "bi bi-arrow-left-right", _c.ReconciliationItems, _c.ReconciliationItems > 0), new("ar-aging", "AR Aging", "bi bi-hourglass-split", _c.ArOverdue, _c.ArOverdue > 0), new("unapplied-payments", "Unapplied Payments", "bi bi-cash-coin", _c.UnappliedPayments, _c.UnappliedPayments > 0), new("commission-adj", "Comm. Adjustments", "bi bi-percent", _c.CommissionAdj, false), new("direct-bill", "Direct-Bill Exceptions", "bi bi-exclamation-triangle-fill", _c.DirectBillExceptions, _c.DirectBillExceptions > 0), new("month-end", "Month-end Tasks", "bi bi-calendar-check-fill", _c.MonthEndOpen, false)];
    private IReadOnlyList<KpiMetric> Metrics => [new("reconciliation", "Reconciliation", _c.ReconciliationItems.ToString("N0"), $"{_c.ReconciliationAmount:C0} variance", "bi-arrow-left-right", _c.ReconciliationItems > 0 ? "acw-tone-warning" : "acw-tone-muted"), new("ar-aging", "AR Overdue", _c.ArOverdue.ToString("N0"), _c.ArAmount.ToString("C0"), "bi-hourglass-split", _c.ArOverdue > 0 ? "acw-tone-danger" : "acw-tone-success"), new("unapplied-payments", "Unapplied", _c.UnappliedPayments.ToString("N0"), _c.UnappliedAmount.ToString("C0"), "bi-cash-coin", _c.UnappliedPayments > 0 ? "acw-tone-warning" : "acw-tone-success"), new("commission-adj", "Commissions", _c.CommissionAdj.ToString("N0"), "Adjustments", "bi-percent", "acw-tone-purple"), new("direct-bill", "Direct-Bill", _c.DirectBillExceptions.ToString("N0"), "Exceptions", "bi-exclamation-triangle-fill", _c.DirectBillExceptions > 0 ? "acw-tone-danger" : "acw-tone-muted"), new("month-end", "Month-end", _c.MonthEndOpen.ToString("N0"), $"{_c.MonthEndComplete} complete", "bi-calendar-check-fill", "acw-tone-success")];

    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> SearchChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _search = e.Value?.ToString() ?? string.Empty);
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> PriorityChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _filterPriority = e.Value?.ToString() ?? string.Empty);
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> SlaChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _filterSla = e.Value?.ToString() ?? string.Empty);
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> ScopeChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, async e => { _scope = e.Value?.ToString() ?? "me"; await LoadAsync(); });
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> BranchChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, async e => { _branchId = e.Value?.ToString() ?? string.Empty; await LoadAsync(); });
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> TeamChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, async e => { _teamId = e.Value?.ToString() ?? string.Empty; await LoadAsync(); });

    private string ToastIconClass => _toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill";
    private IEnumerable<AcctItem> AllItems => _reconciliation.Concat(_arAging).Concat(_unappliedPayments).Concat(_commissionAdj).Concat(_directBill).Concat(_monthEnd);
    private List<AcctItem> ActiveItems => ActiveSource.Where(Matches).ToList();
    private List<AcctItem> ActiveSource => _activeQueue switch { "ar-aging" => _arAging, "unapplied-payments" => _unappliedPayments, "commission-adj" => _commissionAdj, "direct-bill" => _directBill, "month-end" => _monthEnd, _ => _reconciliation };
    private int ActiveQueueCount => _activeQueue == "analytics" ? AllItems.Count() : _activeQueue == "views" ? _savedViews.Count : ActiveItems.Count;
    private string ActiveQueueLabel => _activeQueue == "analytics" ? "records" : _activeQueue == "views" ? "views" : "items";
    private string ActiveQueueTitle => _activeQueue switch { "ar-aging" => "AR aging queue", "unapplied-payments" => "Unapplied payment queue", "commission-adj" => "Commission adjustment queue", "direct-bill" => "Direct-bill exception queue", "month-end" => "Month-end close queue", _ => "Reconciliation queue" };
    private string ActiveQueueSubtitle => _activeQueue switch { "ar-aging" => "Prioritize overdue receivables, aging buckets, and collection exposure.", "unapplied-payments" => "Clear unapplied cash by matching receipts to accounts, policies, and invoices.", "commission-adj" => "Review producer commission adjustments, reasons, and policy context.", "direct-bill" => "Resolve carrier/direct-bill exceptions and protect reconciliation accuracy.", "month-end" => "Track month-end close tasks, blocked work, due dates, and completion status.", _ => "Work premium reconciliation variances by priority, carrier, account, and due date." };
    private string ActiveQueueIcon => _activeQueue switch { "ar-aging" => "bi-hourglass-split", "unapplied-payments" => "bi-cash-coin", "commission-adj" => "bi-percent", "direct-bill" => "bi-exclamation-triangle-fill", "month-end" => "bi-calendar-check-fill", _ => "bi-arrow-left-right" };
    private string AccountingFocusText => _c.DirectBillExceptions > 0 ? $"{_c.DirectBillExceptions} direct-bill exception(s)" : _c.ReconciliationItems > 0 ? $"{_c.ReconciliationItems} reconciliation variance(s)" : "No critical accounting exceptions";
    private string MonthEndProgressText => (_c.MonthEndOpen + _c.MonthEndComplete) == 0 ? "No close checklist" : $"{_c.MonthEndComplete}/{_c.MonthEndOpen + _c.MonthEndComplete} tasks complete";
    private IReadOnlyList<MetricBar> QueueDistribution => BuildAnalytics([new("Recon", _reconciliation.Count, "acw-dist-amber"), new("AR", _arAging.Count, "acw-dist-red"), new("Cash", _unappliedPayments.Count, "acw-dist-green"), new("Comm", _commissionAdj.Count, "acw-dist-purple"), new("Direct", _directBill.Count, "acw-dist-blue"), new("Close", _monthEnd.Count, "acw-dist-pink")]);
    private IReadOnlyList<MetricBar> ExposureDistribution => BuildAnalytics([new("Recon", (int)(_reconciliation.Sum(x => Math.Abs(x.Variance)) / 100), "acw-dist-amber"), new("AR", (int)(_arAging.Sum(x => x.Amount) / 100), "acw-dist-red"), new("Unapplied", (int)(_unappliedPayments.Sum(x => x.Amount) / 100), "acw-dist-green"), new("Direct", (int)(_directBill.Sum(x => x.Amount) / 100), "acw-dist-blue")]);
    private IReadOnlyList<MetricBar> SlaDistribution => BuildAnalytics(AllItems.GroupBy(x => x.SlaStatus).Select(g => new AnalyticsSeed(g.Key, g.Count(), g.Key == "Breached" ? "acw-dist-red" : g.Key == "At Risk" ? "acw-dist-amber" : "acw-dist-green")));
    private IReadOnlyList<MetricBar> PriorityDistribution => BuildAnalytics(AllItems.GroupBy(x => x.Priority).Select(g => new AnalyticsSeed(g.Key, g.Count(), g.Key is "Critical" or "Urgent" ? "acw-dist-red" : g.Key == "High" ? "acw-dist-purple" : "acw-dist-blue")));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Workbench", "/workbench"), new("Accounting", "/workbench/accounting"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _loadError = null;
            var teamScope = _scope.Equals("team", StringComparison.OrdinalIgnoreCase);
            var context = await CurrentUser.RequireAsync();
            var dto = await Api.GetAccountingWorkbenchAsync(_tenantId, context.UserScopeId, teamScope || context.IsTenantAdministrator, _branchId, _teamId);
            if (dto is null) return;
            _c = MapCounts(dto.Counts);
            _reconciliation = dto.Reconciliation.Select(MapItem).ToList();
            _arAging = dto.ArAging.Select(MapItem).ToList();
            _unappliedPayments = dto.UnappliedPayments.Select(MapItem).ToList();
            _commissionAdj = dto.CommissionAdjustments.Select(MapItem).ToList();
            _directBill = dto.DirectBillExceptions.Select(MapItem).ToList();
            _monthEnd = dto.MonthEnd.Select(MapItem).ToList();
            RebuildSla();
            _selected = ActiveItems.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Accounting workbench load failed: {ex.Message}";
            _reconciliation = []; _arAging = []; _unappliedPayments = []; _commissionAdj = []; _directBill = []; _monthEnd = [];
            _c = new();
            RebuildSla();
            ShowToast(_loadError, "danger");
        }
        finally { _loading = false; }
    }

    private void RebuildSla() => _slaItems = [new("Reconciliation", _reconciliation.Count(x => x.SlaStatus != "Breached"), _reconciliation.Count(x => x.SlaStatus == "Breached")), new("AR Aging", _arAging.Count(x => x.SlaStatus != "Breached"), _arAging.Count(x => x.SlaStatus == "Breached")), new("Unapplied Payments", _unappliedPayments.Count(x => x.SlaStatus != "Breached"), _unappliedPayments.Count(x => x.SlaStatus == "Breached")), new("Direct-Bill Exc.", _directBill.Count(x => x.SlaStatus != "Breached"), _directBill.Count(x => x.SlaStatus == "Breached"))];

    private async Task GenerateAiSummaryAsync()
    {
        _aiLoading = true;
        await Task.Delay(0);
        _aiSummary = $"Accounting operations: {_c.ReconciliationItems} reconciliation item(s) with {_c.ReconciliationAmount:C0} variance, {_c.ArOverdue} overdue AR item(s) totaling {_c.ArAmount:C0}, and {_c.UnappliedPayments} unapplied payment(s) totaling {_c.UnappliedAmount:C0}. Prioritize direct-bill exceptions and breached AR buckets first.";
        _aiGeneratedAt = DateTime.Now;
        _aiLoading = false;
        ShowToast("Accounting intelligence summary generated.");
    }

    private Task ExportAsync() => Task.Run(() => ShowToast($"Export prepared for {AllItems.Count()} accounting workbench rows."));
    private void SetActiveQueue(string id) { _activeQueue = id; _selected = id is "analytics" or "views" ? null : ActiveItems.FirstOrDefault(); }
    private void ShowReconciliation() { _filterSla = string.Empty; SetActiveQueue("reconciliation"); }
    private void ShowAging() { _filterSla = string.Empty; SetActiveQueue("ar-aging"); }
    private void ShowUnapplied() { _filterSla = string.Empty; SetActiveQueue("unapplied-payments"); }
    private void ShowMonthEnd() { _filterSla = string.Empty; SetActiveQueue("month-end"); }
    private void ResetFilters() { _search = string.Empty; _filterPriority = string.Empty; _filterSla = string.Empty; }
    private void OpenDetail(AcctItem item) => _selected = item;
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;
    private Task MarkReviewedAsync() { if (_selected is not null) ShowToast($"{_selected.RefNumber} marked reviewed."); return Task.CompletedTask; }

    private Task SaveCurrentViewAsync()
    {
        var name = $"{ActiveQueueTitle} ? {DateTime.Now:MMM d h:mm tt}";
        _savedViews.RemoveAll(x => x.Name == name);
        _savedViews.Add(new(name, _activeQueue, _scope, _branchId, _teamId, _search, _filterPriority, _filterSla));
        ShowToast($"View \"{name}\" saved.");
        return Task.CompletedTask;
    }

    private Task LoadViewAsync(string name)
    {
        var v = _savedViews.FirstOrDefault(x => x.Name == name);
        if (v is null) return Task.CompletedTask;
        _activeQueue = v.QueueId; _scope = v.Scope; _branchId = v.BranchId; _teamId = v.TeamId; _search = v.Search; _filterPriority = v.Priority; _filterSla = v.Sla;
        _selected = _activeQueue is "analytics" or "views" ? null : ActiveItems.FirstOrDefault();
        ShowToast($"View \"{name}\" loaded.");
        return Task.CompletedTask;
    }

    private async Task DeleteViewAsync(string name)
    {
        if (!await Confirmations.ConfirmAsync("Delete saved view", $"Delete saved view {name}?", "Delete")) return;
        _savedViews.RemoveAll(x => x.Name == name);
        ShowToast($"View \"{name}\" deleted.", "warning");
    }

    private bool Matches(AcctItem i) => (string.IsNullOrWhiteSpace(_filterPriority) || i.Priority == _filterPriority) && (string.IsNullOrWhiteSpace(_filterSla) || i.SlaStatus == _filterSla) && (string.IsNullOrWhiteSpace(_search) || new[] { i.Title, i.AccountName, i.RefNumber, i.PolicyNumber, i.CarrierName, i.ProducerName, i.Category, i.AssignedTo, i.PaymentMethod, i.Reason, i.AgingBucket, i.Status, i.Notes ?? string.Empty }.Any(v => !string.IsNullOrWhiteSpace(v) && v.Contains(_search, StringComparison.OrdinalIgnoreCase)));
    private RenderFragment QueueCard(AcctItem item) => @<article class="acw-item-card @(ReferenceEquals(_selected, item) ? "acw-item-selected" : string.Empty)" @onclick="@(() => OpenDetail(item))"><div class="acw-item-top"><span class="acw-avatar" style="@AvatarStyle(item.AccountName)">@Initials(item.AccountName)</span><div><strong>@item.Title</strong><span>@item.AccountName</span></div></div><div class="acw-item-meta"><span class="@PriBadge(item.Priority)">@item.Priority</span><span class="@SlaBadge(item.SlaStatus)">@item.SlaStatus</span>@if (!string.IsNullOrWhiteSpace(item.AgingBucket)) { <span class="@BucketBadge(item.AgingBucket)">@item.AgingBucket</span> }@if (!string.IsNullOrWhiteSpace(item.Status)) { <span class="@StatusBadge(item.Status)">@item.Status</span> }</div><div class="acw-item-footer"><strong>@item.RefNumber</strong><span class="@AmtTextClass(item.Amount != 0 ? item.Amount : item.Variance)">@((item.Amount != 0 ? item.Amount : item.Variance).ToString("C0"))</span></div><div class="acw-item-actions" @onclick:stopPropagation="true"><button class="acw-card-open" @onclick="@(() => OpenDetail(item))" title="Preview details" aria-label="Preview details">???</button><button class="acw-card-open" @onclick="@(() => Nav.NavigateTo(item.DetailUrl))" title="Open record" aria-label="Open record">??</button></div></article>;
    private RenderFragment EmptyState(string icon, string title, string text) => @<div class="acw-empty-state"><i class="bi @icon" aria-hidden="true"></i><strong>@title</strong><span>@text</span><button class="um-btn um-btn-primary" @onclick="LoadAsync">Refresh</button></div>;
    private RenderFragment AnalyticsItem(MetricBar row) => @<button class="acw-analytics-row"><span>@row.Label</span><div><i class="@row.Tone" style="width:@row.WidthPercent%"></i></div><strong>@row.Count</strong><small>@row.Percent.ToString("F0")%</small></button>;
    private IReadOnlyList<MetricBar> BuildAnalytics(IEnumerable<AnalyticsSeed> seeds) { var items = seeds.ToList(); var total = Math.Max(1, items.Sum(x => x.Count)); return items.Select(x => new MetricBar(x.Label, x.Count, x.Tone, x.Count * 100m / total, Math.Max(4m, x.Count * 100m / total))).ToList(); }
    private string MetricCardClass(KpiMetric metric) => $"acw-kpi-card {(metric.QueueId == _activeQueue ? "acw-kpi-card-active" : string.Empty)}";
    private string QueueTabClass(string id) => $"acw-view-btn {(id == _activeQueue ? "acw-view-btn-active" : string.Empty)}";
    private static AcctCounts MapCounts(AccountingWorkbenchCountsDto dto) => new() { ReconciliationItems = dto.ReconciliationItems, ReconciliationAmount = dto.ReconciliationAmount, ArOverdue = dto.ArOverdue, ArAmount = dto.ArAmount, UnappliedPayments = dto.UnappliedPayments, UnappliedAmount = dto.UnappliedAmount, CommissionAdj = dto.CommissionAdj, DirectBillExceptions = dto.DirectBillExceptions, MonthEndOpen = dto.MonthEndOpen, MonthEndComplete = dto.MonthEndComplete };
    private static AcctItem MapItem(AccountingWorkbenchItemDto dto) => new() { ItemId = dto.ItemId, QueueCode = dto.QueueCode, Title = dto.Title, RefNumber = dto.RefNumber, AccountName = dto.AccountName, PolicyNumber = dto.PolicyNumber, CarrierName = dto.CarrierName, ProducerName = dto.ProducerName, Category = dto.Category, AssignedTo = dto.AssignedTo, Priority = dto.Priority, SlaStatus = dto.SlaStatus, Status = dto.Status, AgingBucket = dto.AgingBucket, PaymentMethod = dto.PaymentMethod, Reason = dto.Reason, Amount = dto.Amount, Variance = dto.Variance, DueDate = dto.DueDate, ReceivedDate = dto.ReceivedDate, CompletedAt = dto.CompletedAt, AgeDays = dto.AgeDays, Notes = dto.Notes, DetailUrl = dto.DetailUrl };
    private static string DetailNote(AcctItem i) => !string.IsNullOrWhiteSpace(i.Reason) ? i.Reason : i.Notes ?? string.Empty;
    private static string PriBadge(string p) => p switch { "Critical" => "acw-pri acw-pri-critical", "Urgent" => "acw-pri acw-pri-urgent", "High" => "acw-pri acw-pri-high", "Normal" => "acw-pri acw-pri-normal", _ => "acw-pri acw-pri-low" };
    private static string SlaBadge(string s) => s switch { "On Track" => "acw-sla acw-sla-ok", "At Risk" => "acw-sla acw-sla-warn", _ => "acw-sla acw-sla-breach" };
    private static string SlaTextClass(string s) => s == "Breached" ? "acw-text-danger" : s == "At Risk" ? "acw-text-warning" : "acw-text-success";
    private static string StatusBadge(string s) => s switch { "Complete" => "acw-status acw-status-approved", "In Progress" => "acw-status acw-status-review", "Pending" => "acw-status acw-status-pending", "Blocked" => "acw-status acw-status-rejected", _ => "acw-status acw-status-open" };
    private static string AmtTextClass(decimal v) => v < 0 ? "acw-text-danger" : v > 0 ? "acw-text-success" : "";
    private static string BucketBadge(string b) => b switch { "Current" => "acw-sla acw-sla-ok", "1-30" => "acw-sla acw-sla-warn", "31-60" => "acw-sla acw-sla-breach", "61-90" => "acw-pri acw-pri-urgent", "90+" => "acw-pri acw-pri-critical", _ => "acw-sla" };
    private static string FormatAge(DateTime dt) { var diff = DateTime.Now - dt; if (diff.TotalMinutes < 1) return "Just now"; if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m ago"; if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago"; if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d ago"; return dt.ToString("d", CultureInfo.CurrentCulture); }
    private static string Initials(string name) { var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length >= 1 ? name[..1] : "?"; }
    private static string AvatarStyle(string name) { var hue = Math.Abs(name.GetHashCode()) % 360; return $"background:hsl({hue},70%,94%);color:hsl({hue},45%,32%);border:1px solid hsl({hue},55%,86%);box-shadow:inset 0 1px 0 rgba(255,255,255,.85);"; }
    async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); TenantId = context.TenantId; TenantAdminUserId = context.UserId; _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; DevTenantId = context.TenantId; DevUserId = context.UserId; }

    private sealed record LabelValue(string Value, string Label);
    private sealed record QDef(string Id, string Label, string Icon, int Badge, bool IsAlert);
    private sealed record KpiMetric(string QueueId, string Label, string Value, string Caption, string Icon, string Tone);
    private sealed record AnalyticsSeed(string Label, int Count, string Tone);
    private sealed record MetricBar(string Label, int Count, string Tone, decimal Percent, decimal WidthPercent);
    private sealed record SavedViewVm(string Name, string QueueId, string Scope, string BranchId, string TeamId, string Search, string Priority, string Sla);
    private sealed record SlaHeatItemVm(string QueueName, int InSla, int Breached);
    private sealed class AcctCounts { public int ReconciliationItems { get; set; } public decimal ReconciliationAmount { get; set; } public int ArOverdue { get; set; } public decimal ArAmount { get; set; } public int UnappliedPayments { get; set; } public decimal UnappliedAmount { get; set; } public int CommissionAdj { get; set; } public int DirectBillExceptions { get; set; } public int MonthEndOpen { get; set; } public int MonthEndComplete { get; set; } }
    private sealed class AcctItem { public Guid ItemId { get; set; } = Guid.NewGuid(); public string QueueCode { get; set; } = string.Empty; public string Title { get; set; } = string.Empty; public string RefNumber { get; set; } = string.Empty; public string AccountName { get; set; } = string.Empty; public string PolicyNumber { get; set; } = string.Empty; public string CarrierName { get; set; } = string.Empty; public string ProducerName { get; set; } = string.Empty; public string Category { get; set; } = string.Empty; public string AssignedTo { get; set; } = string.Empty; public string Priority { get; set; } = "Normal"; public string SlaStatus { get; set; } = "On Track"; public string Status { get; set; } = "Open"; public string AgingBucket { get; set; } = "Current"; public string PaymentMethod { get; set; } = string.Empty; public string Reason { get; set; } = string.Empty; public decimal Amount { get; set; } public decimal Variance { get; set; } public DateTime DueDate { get; set; } = DateTime.Today; public DateTime? ReceivedDate { get; set; } public DateTime? CompletedAt { get; set; } public int AgeDays { get; set; } public string? Notes { get; set; } public string DetailUrl { get; set; } = "/workbench/accounting"; }
}
