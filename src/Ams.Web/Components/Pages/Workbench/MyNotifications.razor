    private bool MatchesFilters(NotificationDto item)
    {
        if (!MatchesSearch(item.Subject, item.Body, item.Category, item.ChannelCode, item.StatusCode, item.Priority, item.DeliveryProvider, item.EntityName, item.ErrorMessage)) return false;
        if (!string.IsNullOrWhiteSpace(_channelFilter) && !string.Equals(item.ChannelCode, _channelFilter, StringComparison.OrdinalIgnoreCase)) return false;
        if (!string.IsNullOrWhiteSpace(_statusFilter) && !string.Equals(item.StatusCode, _statusFilter, StringComparison.OrdinalIgnoreCase)) return false;
        if (!string.IsNullOrWhiteSpace(_priorityFilter) && !string.Equals(item.Priority, _priorityFilter, StringComparison.OrdinalIgnoreCase)) return false;
        if (!string.IsNullOrWhiteSpace(_categoryFilter) && !string.Equals(item.Category, _categoryFilter, StringComparison.OrdinalIgnoreCase)) return false;
        return _activeFilter switch
        {
            "unread" => !item.IsRead,
            "read" => item.IsRead,
            "failed" => IsFailure(item),
            "queued" => IsQueued(item),
            "critical" => IsPriority(item, "Critical"),
            "synced" => string.Equals(item.SyncStatus, "Synced", StringComparison.OrdinalIgnoreCase),
            _ => true
        };
    }

    private bool MatchesSearch(params string?[] values) => string.IsNullOrWhiteSpace(_searchTerm) || values.Any(v => !string.IsNullOrWhiteSpace(v) && v.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
    private string MetricCardClass(KpiMetric metric) => $"ntf-kpi-card {(metric.Filter == _activeFilter ? "ntf-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewOption view) => $"ntf-view-btn {(view.Id == _view ? "ntf-view-btn-active" : string.Empty)}";
    private string ItemClass(NotificationDto item) => $"ntf-item-card {(item.IsRead ? "ntf-item-read" : string.Empty)} {(SelectedId == item.NotificationId ? "ntf-item-selected" : string.Empty)}";
    private int ViewCount(string view) => view switch { "delivery" => Filtered.Count(n => !IsFailure(n) && !IsQueued(n)), "failures" => Filtered.Count(n => IsFailure(n) || IsQueued(n)), "analytics" => Filtered.Count, _ => Filtered.Count };
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind) { _toastMessage = message; _toastKind = kind; _toastVisible = true; }

    private static string Title(NotificationDto item) => string.IsNullOrWhiteSpace(item.Subject) ? DisplayCode(item.Category) : item.Subject!;
    private static bool IsFailure(NotificationDto item) => ContainsAny(item.StatusCode, "fail") || ContainsAny(item.DeliveryStatus, "fail") || ContainsAny(item.PolicyStatus, "review") || !string.IsNullOrWhiteSpace(item.ErrorMessage);
    private static bool IsQueued(NotificationDto item) => ContainsAny(item.StatusCode, "queue") || ContainsAny(item.DeliveryStatus, "queue") || ContainsAny(item.DeliveryStatus, "retry") || ContainsAny(item.SyncStatus, "action");
    private static bool IsPriority(NotificationDto item, string priority) => string.Equals(item.Priority, priority, StringComparison.OrdinalIgnoreCase);
    private static bool ContainsAny(string? value, string token) => !string.IsNullOrWhiteSpace(value) && value.Contains(token, StringComparison.OrdinalIgnoreCase);
    private static string DisplayCode(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Replace("_", " ").Replace("-", " ");
    private static string NotificationIcon(NotificationDto item) => IsFailure(item) ? "bi-exclamation-triangle-fill" : item.IsRead ? "bi-envelope-open" : item.ChannelCode.ToLowerInvariant() switch { "email" => "bi-envelope-fill", "sms" => "bi-chat-dots-fill", "portal" => "bi-window-sidebar", _ => "bi-bell-fill" };
    private static string ChannelTone(string? value) => $"ntf-tone-{(string.IsNullOrWhiteSpace(value) ? "info" : value.ToLowerInvariant())}";
    private static string StatusTone(string? value) => ContainsAny(value, "fail") ? "ntf-tone-danger" : ContainsAny(value, "queue") ? "ntf-tone-warning" : ContainsAny(value, "sent") || ContainsAny(value, "deliver") ? "ntf-tone-success" : "ntf-tone-info";
    private static string PriorityTone(string? value) => value?.ToLowerInvariant() switch { "critical" => "ntf-tone-danger", "high" => "ntf-tone-warning", "low" => "ntf-tone-muted", _ => "ntf-tone-info" };
    private static string FormatDate(DateTime value) => value.ToLocalTime().ToString("MMM d, yyyy h:mm tt", CultureInfo.CurrentCulture);

    private static string FormatAge(DateTime dt)
    {
        var diff = DateTime.UtcNow - (dt.Kind == DateTimeKind.Local ? dt.ToUniversalTime() : dt);
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }

    private static IReadOnlyList<DistRow> Distribution(IEnumerable<NotificationDto> source, Func<NotificationDto, string?> selector, string tone)
        => source.GroupBy(i => string.IsNullOrWhiteSpace(selector(i)) ? "Unknown" : selector(i)!, StringComparer.OrdinalIgnoreCase).Select(g => new DistRow(g.Key, g.Count(), $"ntf-dist-{tone}")).OrderByDescending(r => r.Count).ThenBy(r => r.Label).ToList();
    private static string WidthStyle(int value, int total) => $"width:{Math.Clamp(total == 0 ? 0 : value * 100 / total, 5, 100).ToString(CultureInfo.InvariantCulture)}%";
    private static string PercentLabel(int value, int total) => string.Concat((total == 0 ? 0 : value * 100 / Math.Max(1, total)).ToString("0", CultureInfo.InvariantCulture), Convert.ToChar(37));

    private sealed record KpiMetric(string Filter, string Label, int Value, string Caption, string Icon, string Tone);
    private sealed record ViewOption(string Id, string Label, string Icon);
    private sealed record DistRow(string Label, int Count, string Tone);

    private sealed class NotificationFormModel
    {
        [StringLength(200)]
        public string? Subject { get; set; }

        [Required, StringLength(50)]
        public string ChannelCode { get; set; } = "InApp";

        [Required, StringLength(40)]
        public string Priority { get; set; } = "Normal";

        [Required, StringLength(80)]
        public string Category { get; set; } = "General";

        [Required, StringLength(50)]
        public string StatusCode { get; set; } = "Delivered";

        [StringLength(100)]
        public string? EntityName { get; set; }

        [Required, StringLength(2000)]
        public string Body { get; set; } = string.Empty;

        [StringLength(1000)]
        public string? ErrorMessage { get; set; }
    }
