    private sealed record QDef(string Id, string Label, string Icon, int Badge, bool IsAlert);
    private sealed record KpiMetric(string QueueId, string Label, string Value, string Caption, string Icon, string Tone);
    private sealed record AnalyticsSeed(string Label, int Count, string Tone);
    private sealed record MetricBar(string Label, int Count, string Tone, decimal Percent, decimal WidthPercent);
    private sealed record SavedViewVm(string Name, string QueueId, string Scope, string BranchId, string TeamId, string Search, string Priority, string Sla);
    private sealed record SlaHeatItemVm(string QueueName, int InSla, int Breached);
    private sealed class MktCounts { public int ActiveCampaigns { get; set; } public int CampaignLeads { get; set; } public int OutreachTasks { get; set; } public int OutreachOverdue { get; set; } public int Referrals { get; set; } public int ReferralsConverted { get; set; } public int UpcomingEvents { get; set; } public int EventFollowUps { get; set; } public int ContentPendingApproval { get; set; } public int TotalLeads { get; set; } public int LeadsConverted { get; set; } public double ConversionRate { get; set; } public decimal CostPerLead { get; set; } }
    private sealed class MktItem { public Guid ItemId { get; set; } = Guid.NewGuid(); public string QueueCode { get; set; } = string.Empty; public string Title { get; set; } = string.Empty; public string RefNumber { get; set; } = string.Empty; public string ContactName { get; set; } = string.Empty; public string CampaignName { get; set; } = string.Empty; public string Channel { get; set; } = string.Empty; public string ContentType { get; set; } = string.Empty; public string TargetAudience { get; set; } = string.Empty; public string AssignedTo { get; set; } = string.Empty; public string ReviewedBy { get; set; } = string.Empty; public string Location { get; set; } = string.Empty; public string Priority { get; set; } = "Normal"; public string SlaStatus { get; set; } = "On Track"; public string Status { get; set; } = "Active"; public decimal Budget { get; set; } public decimal EstPremium { get; set; } public int Leads { get; set; } public int Conversions { get; set; } public int Attendees { get; set; } public DateTime DueDate { get; set; } = DateTime.Today; public DateTime EndDate { get; set; } = DateTime.Today.AddDays(30); public DateTime? EventDate { get; set; } public DateTime? ReceivedDate { get; set; } public string? Notes { get; set; } public string DetailUrl { get; set; } = "/workbench/marketing"; }
    private sealed class LeadSource { public string SourceName { get; set; } = string.Empty; public int Leads { get; set; } public int Converted { get; set; } public decimal AvgPremium { get; set; } }
