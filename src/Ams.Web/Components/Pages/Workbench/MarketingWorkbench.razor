@page "/workbench/marketing"
@namespace Ams.Web.Components.Pages.Workbench
@using System.Globalization
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@inject ConfirmationDialogService Confirmations

<PageTitle>Enterprise Marketing Workbench</PageTitle>

@if (_toastVisible)
{
    <div class="mkw-toast mkw-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="mkw-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="mkw-enterprise-page">
    <section class="mkw-hero">
        <div class="mkw-hero-left">
            <span class="mkw-hero-icon"><i class="bi bi-megaphone-fill" aria-hidden="true"></i></span>
            <div>
                <div class="mkw-title-row">
                    <h1>Marketing Workbench</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live growth data</span>
                    <span><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Conversion focused</span>
                </div>
                <p>Manage campaigns, outreach tasks, referrals, event follow-ups, content approvals, and lead-source performance in one enterprise command center.</p>
            </div>
        </div>
        <div class="mkw-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh marketing workbench"><i class="bi @(_loading ? "bi-arrow-repeat mkw-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-ghost" @onclick="GenerateAiSummaryAsync" disabled="@_aiLoading"><i class="bi @(_aiLoading ? "bi-arrow-repeat mkw-spin" : "bi-stars")" aria-hidden="true"></i> AI Summary</button>
            <button class="um-btn um-btn-ghost" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/campaigns/new")'><i class="bi bi-plus-lg" aria-hidden="true"></i> New Campaign</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger mkw-error-banner" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="mkw-insight-strip" aria-label="Marketing insights">
        <article class="mkw-insight-card mkw-insight-primary"><span class="mkw-insight-icon mkw-tone-info"><i class="bi bi-bullseye" aria-hidden="true"></i></span><div><small>Marketing Focus</small><strong>@MarketingFocusText</strong></div></article>
        <article class="mkw-insight-card"><span class="mkw-insight-icon mkw-tone-success"><i class="bi bi-people-fill" aria-hidden="true"></i></span><div><small>Lead Volume</small><strong>@_c.TotalLeads.ToString("N0", CultureInfo.CurrentCulture)</strong></div></article>
        <article class="mkw-insight-card"><span class="mkw-insight-icon mkw-tone-purple"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span><div><small>Converted</small><strong>@_c.LeadsConverted.ToString("N0", CultureInfo.CurrentCulture)</strong></div></article>
        <article class="mkw-insight-card"><span class="mkw-insight-icon mkw-tone-warning"><i class="bi bi-cash-coin" aria-hidden="true"></i></span><div><small>Cost / Lead</small><strong>@_c.CostPerLead.ToString("C0", CultureInfo.CurrentCulture)</strong></div></article>
    </section>

    <section class="mkw-ops-strip">
        <article class="mkw-scope-card">
            <div class="mkw-scope-head"><span><i class="bi bi-funnel" aria-hidden="true"></i> Growth Scope</span><strong>@(_scope.Equals("team", StringComparison.OrdinalIgnoreCase) ? "Team" : "Me")</strong></div>
            <div class="mkw-scope-grid">
                <label><span>Scope</span><select class="mkw-filter-select" value="@_scope" @onchange="ScopeChangedCallback"><option value="me">My queue</option><option value="team">Team queue</option></select></label>
                <label><span>Branch</span><input class="mkw-filter-input" value="@_branchId" @onchange="BranchChangedCallback" placeholder="All branches" /></label>
                <label><span>Team</span><input class="mkw-filter-input" value="@_teamId" @onchange="TeamChangedCallback" placeholder="All teams" /></label>
            </div>
        </article>
        <article class="mkw-ai-card">
            <div class="mkw-ai-head"><span><i class="bi bi-stars" aria-hidden="true"></i> Growth Intelligence</span>@if (_aiGeneratedAt.HasValue) { <small>@FormatAge(_aiGeneratedAt.Value)</small> }</div>
            <p>@(_aiSummary ?? "Generate a marketing summary to prioritize overdue outreach, content approvals, campaign conversion, referral follow-up, and event lead capture.")</p>
        </article>
    </section>

    <section class="mkw-kpi-strip" aria-label="Marketing queue metrics">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" title="@metric.Caption" @onclick="@(() => SetActiveQueue(metric.QueueId))">
                <span class="mkw-kpi-icon @metric.Tone"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span><span class="mkw-kpi-val">@metric.Value</span><span class="mkw-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
            </button>
        }
    </section>

    <section class="mkw-workflow-strip" aria-label="Marketing workflow actions">
        <button class="mkw-workflow-card" @onclick="ShowCampaigns"><i class="bi bi-megaphone" aria-hidden="true"></i><span><strong>Optimize campaigns</strong><span>Review active campaign performance.</span></span></button>
        <button class="mkw-workflow-card" @onclick="ShowOutreach"><i class="bi bi-envelope" aria-hidden="true"></i><span><strong>Clear outreach</strong><span>Focus overdue marketing touches.</span></span></button>
        <button class="mkw-workflow-card" @onclick="ShowReferrals"><i class="bi bi-share" aria-hidden="true"></i><span><strong>Work referrals</strong><span>Convert referral opportunities.</span></span></button>
        <button class="mkw-workflow-card" @onclick="ShowContent"><i class="bi bi-file-richtext" aria-hidden="true"></i><span><strong>Approve content</strong><span>Publish pending assets.</span></span></button>
    </section>

    <section class="mkw-search-panel">
        <div class="mkw-search-wrap">
            <span class="mkw-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="mkw-search-body">
                <label for="marketingSearchInput">Search marketing queue</label>
                <input id="marketingSearchInput" class="mkw-search-input" value="@_search" @oninput="SearchChangedCallback" placeholder="Search campaign, contact, source, channel, audience, owner, content, location, or notes..." />
                <span class="mkw-search-hint">Filters apply to the active queue while preserving the synced marketing aggregate.</span>
            </div>
        </div>
        <select class="mkw-filter-select" value="@_filterPriority" @onchange="PriorityChangedCallback" title="Filter priority">
            <option value="">All priorities</option>
            @foreach (var option in _priorityOptions) { <option value="@option.Value">@option.Label</option> }
        </select>
        <select class="mkw-filter-select" value="@_filterSla" @onchange="SlaChangedCallback" title="Filter SLA">
            <option value="">All SLA</option>
            @foreach (var option in _slaOptions) { <option value="@option.Value">@option.Label</option> }
        </select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
        <div class="mkw-search-result"><strong>@ActiveQueueCount</strong><span>@ActiveQueueLabel</span></div>
    </section>

    <section class="mkw-view-tabs" aria-label="Marketing queue tabs">
        @foreach (var q in Queues)
        {
            <button type="button" class="@QueueTabClass(q.Id)" @onclick="@(() => SetActiveQueue(q.Id))"><i class="@q.Icon" aria-hidden="true"></i> @q.Label @if (q.Badge > 0) { <span class="@(q.IsAlert ? "mkw-tab-alert" : string.Empty)">@q.Badge</span> }</button>
        }
        <button type="button" class="@QueueTabClass("views")" @onclick='() => SetActiveQueue("views")'><i class="bi bi-bookmark-star" aria-hidden="true"></i> Saved Views @if (_savedViews.Count > 0) { <span>@_savedViews.Count</span> }</button>
    </section>

    <section class="mkw-content-layout">
        <main class="mkw-main-card">
            @if (_loading)
            {
                <div class="mkw-loading"><i class="bi bi-arrow-repeat mkw-spin" aria-hidden="true"></i><strong>Loading marketing workbench...</strong></div>
            }
            else if (_activeQueue == "analytics")
            {
                <div class="mkw-section-head"><div><h2>Marketing analytics</h2><p>Monitor campaign mix, lead sources, conversions, and growth funnel performance.</p></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-x-lg"></i> Reset</button></div>
                <div class="mkw-analytics-grid"><section><h3>Queue distribution</h3>@foreach (var row in QueueDistribution) { @AnalyticsItem(row) }</section><section><h3>Lead sources</h3>@foreach (var row in SourceDistribution) { @AnalyticsItem(row) }</section><section><h3>Conversion mix</h3>@foreach (var row in ConversionDistribution) { @AnalyticsItem(row) }</section><section><h3>Channel mix</h3>@foreach (var row in ChannelDistribution) { @AnalyticsItem(row) }</section></div>
                <div class="mkw-source-grid">@foreach (var source in _leadSources) { @LeadSourceCard(source) }</div>
            }
            else if (_activeQueue == "views")
            {
                <div class="mkw-section-head"><div><h2>Saved views</h2><p>Save, load, and delete marketing workbench view state for your current queue and scope.</p></div><button class="um-btn um-btn-primary um-btn-sm" @onclick="SaveCurrentViewAsync"><i class="bi bi-bookmark-plus"></i> Save Current View</button></div>
                @if (_savedViews.Count == 0) { @EmptyState("bi-bookmark-star", "No saved views yet", "Save the current scope, queue, and filters for quick access.") } else { <div class="mkw-card-grid">@foreach (var view in _savedViews) { <article class="mkw-view-card"><div><strong>@view.Name</strong><span>@view.QueueId · @view.Scope</span><small>@(string.IsNullOrWhiteSpace(view.BranchId) ? "All branches" : view.BranchId) · @(string.IsNullOrWhiteSpace(view.TeamId) ? "All teams" : view.TeamId)</small></div><div class="mkw-item-actions"><button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => LoadViewAsync(view.Name))">Load</button><button class="um-btn um-btn-danger um-btn-sm" @onclick="@(() => DeleteViewAsync(view.Name))">Delete</button></div></article> }</div> }
            }
            else
            {
                <div class="mkw-section-head"><div><h2>@ActiveQueueTitle</h2><p>@ActiveQueueSubtitle</p></div><button class="um-btn um-btn-primary um-btn-sm" @onclick='() => Nav.NavigateTo("/campaigns/new")'><i class="bi bi-plus-lg"></i> New Campaign</button></div>
                @if (ActiveItems.Count == 0) { @EmptyState(ActiveQueueIcon, "No records match this queue", "Adjust filters, refresh the workbench, or create a new campaign.") } else { <div class="mkw-card-grid">@foreach (var item in ActiveItems) { @QueueCard(item) }</div> }
            }
        </main>

        <aside class="mkw-detail-card">
            @if (_selected is not null)
            {
                <div class="mkw-detail-head"><div><span class="mkw-detail-eyebrow"><i class="bi @ActiveQueueIcon" aria-hidden="true"></i> @_selected.QueueCode</span><h2>@_selected.Title</h2><p>@DetailSubhead(_selected)</p></div><span class="@StatusBadge(_selected.Status)">@_selected.Status</span></div>
                <div class="mkw-detail-body"><div class="mkw-detail-summary"><div><span>Ref</span><strong>@_selected.RefNumber</strong></div><div><span>Channel</span><strong>@(_selected.Channel == string.Empty ? "—" : _selected.Channel)</strong></div><div><span>Leads</span><strong>@_selected.Leads</strong></div><div><span>Conversions</span><strong>@_selected.Conversions</strong></div><div><span>Budget</span><strong>@_selected.Budget.ToString("C0")</strong></div><div><span>Due</span><strong>@_selected.DueDate.ToString("d", CultureInfo.CurrentCulture)</strong></div></div>@if (!string.IsNullOrWhiteSpace(_selected.Notes)) { <p class="mkw-detail-note">@_selected.Notes</p> }<div class="mkw-detail-actions"><button class="um-btn um-btn-ghost" @onclick="@(() => ApproveAsync(_selected))" disabled="@(_selected.QueueCode != "content" || _selected.Status == "Approved")"><i class="bi bi-check2-circle"></i> Approve</button><button class="um-btn um-btn-primary" @onclick="@(() => Nav.NavigateTo(_selected.DetailUrl))">Open Record <i class="bi bi-arrow-right"></i></button></div></div>
            }
            else
            {
                <div class="mkw-detail-empty"><i class="bi bi-megaphone-fill" aria-hidden="true"></i><strong>Select a marketing item</strong><span>Review campaign, outreach, referral, event, content, and source-record context.</span></div>
            }
        </aside>
    </section>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;

    private bool _loading;
    private bool _toastVisible;
    private string? _loadError;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string _scope = "me";
    private string _branchId = string.Empty;
    private string _teamId = string.Empty;
    private string _activeQueue = "campaigns";
    private MktItem? _selected;

    private string _search = string.Empty;
    private string _filterPriority = string.Empty;
    private string _filterSla = string.Empty;

    private string? _aiSummary;
    private bool _aiLoading;
    private DateTime? _aiGeneratedAt;
    private List<SavedViewVm> _savedViews = [];
    private List<SlaHeatItemVm> _slaItems = [];
    private MktCounts _c = new();

    private List<MktItem> _campaigns = [];
    private List<MktItem> _outreach = [];
    private List<MktItem> _referrals = [];
    private List<MktItem> _events = [];
    private List<MktItem> _content = [];
    private List<LeadSource> _leadSources = [];

    private readonly List<LabelValue> _priorityOptions = [new("Critical", "Critical"), new("Urgent", "Urgent"), new("High", "High"), new("Normal", "Normal"), new("Low", "Low")];
    private readonly List<LabelValue> _slaOptions = [new("On Track", "On Track"), new("At Risk", "At Risk"), new("Breached", "Breached")];
    private List<QDef> Queues => [new("campaigns", "Campaigns", "bi bi-megaphone-fill", _c.ActiveCampaigns, false), new("outreach", "Outreach Tasks", "bi bi-envelope-fill", _c.OutreachTasks, _c.OutreachOverdue > 0), new("referrals", "Referrals", "bi bi-share-fill", _c.Referrals, false), new("events", "Events", "bi bi-calendar-event-fill", _c.UpcomingEvents, false), new("content", "Content Approvals", "bi bi-file-richtext-fill", _c.ContentPendingApproval, _c.ContentPendingApproval > 0), new("analytics", "Analytics", "bi bi-graph-up-arrow", 0, false)];
    private IReadOnlyList<KpiMetric> Metrics => [new("campaigns", "Campaigns", _c.ActiveCampaigns.ToString("N0"), $"{_c.CampaignLeads:N0} leads generated", "bi-megaphone-fill", "mkw-tone-info"), new("outreach", "Outreach", _c.OutreachTasks.ToString("N0"), $"{_c.OutreachOverdue} overdue", "bi-envelope-fill", _c.OutreachOverdue > 0 ? "mkw-tone-warning" : "mkw-tone-success"), new("referrals", "Referrals", _c.Referrals.ToString("N0"), $"{_c.ReferralsConverted} converted", "bi-share-fill", "mkw-tone-success"), new("events", "Events", _c.UpcomingEvents.ToString("N0"), $"{_c.EventFollowUps} follow-ups", "bi-calendar-event-fill", "mkw-tone-warning"), new("content", "Content", _c.ContentPendingApproval.ToString("N0"), "Pending approval", "bi-file-richtext-fill", _c.ContentPendingApproval > 0 ? "mkw-tone-purple" : "mkw-tone-muted"), new("analytics", "Conversion", _c.ConversionRate.ToString("F1") + "%", $"{_c.TotalLeads:N0} total leads", "bi-graph-up-arrow", "mkw-tone-info")];

    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> SearchChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _search = e.Value?.ToString() ?? string.Empty);
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> PriorityChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _filterPriority = e.Value?.ToString() ?? string.Empty);
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> SlaChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _filterSla = e.Value?.ToString() ?? string.Empty);
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> ScopeChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, async e => { _scope = e.Value?.ToString() ?? "me"; await LoadAsync(); });
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> BranchChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, async e => { _branchId = e.Value?.ToString() ?? string.Empty; await LoadAsync(); });
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> TeamChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, async e => { _teamId = e.Value?.ToString() ?? string.Empty; await LoadAsync(); });

    private string ToastIconClass => _toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill";
    private IEnumerable<MktItem> AllItems => _campaigns.Concat(_outreach).Concat(_referrals).Concat(_events).Concat(_content);
    private List<MktItem> ActiveItems => ActiveSource.Where(Matches).ToList();
    private List<MktItem> ActiveSource => _activeQueue switch { "outreach" => _outreach, "referrals" => _referrals, "events" => _events, "content" => _content, _ => _campaigns };
    private int ActiveQueueCount => _activeQueue == "analytics" ? AllItems.Count() : _activeQueue == "views" ? _savedViews.Count : ActiveItems.Count;
    private string ActiveQueueLabel => _activeQueue == "analytics" ? "records" : _activeQueue == "views" ? "views" : "items";
    private string ActiveQueueTitle => _activeQueue switch { "outreach" => "Outreach task queue", "referrals" => "Referral queue", "events" => "Event follow-up queue", "content" => "Content approval queue", _ => "Campaign queue" };
    private string ActiveQueueSubtitle => _activeQueue switch { "outreach" => "Prioritize marketing touches, overdue follow-ups, and contact engagement.", "referrals" => "Track referred prospects, converted referrals, estimated premium, and assigned producers.", "events" => "Manage upcoming events, attendance, lead capture, and post-event follow-up.", "content" => "Review pending content, campaign assets, authors, reviewers, and publish readiness.", _ => "Monitor active campaigns by audience, budget, leads, conversion, owner, and end date." };
    private string ActiveQueueIcon => _activeQueue switch { "outreach" => "bi-envelope-fill", "referrals" => "bi-share-fill", "events" => "bi-calendar-event-fill", "content" => "bi-file-richtext-fill", "analytics" => "bi-graph-up-arrow", _ => "bi-megaphone-fill" };
    private string MarketingFocusText => _c.OutreachOverdue > 0 ? $"{_c.OutreachOverdue} overdue outreach task(s)" : _c.ContentPendingApproval > 0 ? $"{_c.ContentPendingApproval} content approval(s)" : _c.EventFollowUps > 0 ? $"{_c.EventFollowUps} event follow-up(s)" : "Campaign optimization";
    private IReadOnlyList<MetricBar> QueueDistribution => BuildAnalytics([new("Campaigns", _campaigns.Count, "mkw-dist-blue"), new("Outreach", _outreach.Count, "mkw-dist-amber"), new("Referrals", _referrals.Count, "mkw-dist-green"), new("Events", _events.Count, "mkw-dist-purple"), new("Content", _content.Count, "mkw-dist-pink")]);
    private IReadOnlyList<MetricBar> SourceDistribution => BuildAnalytics(_leadSources.Take(8).Select(s => new AnalyticsSeed(s.SourceName, s.Leads, "mkw-dist-blue")));
    private IReadOnlyList<MetricBar> ConversionDistribution => BuildAnalytics([new("Converted", _c.LeadsConverted, "mkw-dist-green"), new("Open", Math.Max(0, _c.TotalLeads - _c.LeadsConverted), "mkw-dist-amber"), new("Referrals", _c.ReferralsConverted, "mkw-dist-purple")]);
    private IReadOnlyList<MetricBar> ChannelDistribution => BuildAnalytics(AllItems.Where(x => !string.IsNullOrWhiteSpace(x.Channel)).GroupBy(x => x.Channel).Select(g => new AnalyticsSeed(g.Key, g.Count(), "mkw-dist-pink")));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Workbench", "/workbench"), new("Marketing", "/workbench/marketing"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _loadError = null;
            var context = await CurrentUser.RequireAsync();
            var result = await Api.GetMarketingWorkbenchAsync(_tenantId, context.UserScopeId, _scope == "team" || context.IsTenantAdministrator, _branchId, _teamId);
            _campaigns = result?.Campaigns.Select(ToMktItem).ToList() ?? [];
            _outreach = result?.Outreach.Select(ToMktItem).ToList() ?? [];
            _referrals = result?.Referrals.Select(ToMktItem).ToList() ?? [];
            _events = result?.Events.Select(ToMktItem).ToList() ?? [];
            _content = result?.Content.Select(ToMktItem).ToList() ?? [];
            _leadSources = result?.LeadSources.Select(ToLeadSource).ToList() ?? [];
            _c = ToCounts(result?.Counts);
            RebuildSla();
            _selected = ActiveItems.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load marketing workbench: {ex.Message}";
            _campaigns = []; _outreach = []; _referrals = []; _events = []; _content = []; _leadSources = [];
            _c = new();
            RebuildSla();
            ShowToast(_loadError, "danger");
        }
        finally { _loading = false; }
    }

    private void RebuildSla() => _slaItems = [new("Campaigns", _c.ActiveCampaigns, 0), new("Outreach", Math.Max(0, _c.OutreachTasks - _c.OutreachOverdue), _c.OutreachOverdue), new("Content", _c.ContentPendingApproval, 0)];

    private async Task GenerateAiSummaryAsync()
    {
        _aiLoading = true;
        await Task.Delay(0);
        _aiSummary = $"Marketing has {_c.ActiveCampaigns} active campaigns generating {_c.CampaignLeads:N0} leads. {_c.OutreachOverdue} outreach tasks are overdue, {_c.ContentPendingApproval} content items need approval, and lead conversion is {_c.ConversionRate:F1}%.";
        _aiGeneratedAt = DateTime.Now;
        _aiLoading = false;
        ShowToast("Marketing intelligence summary generated.");
    }

    private async Task ApproveAsync(MktItem i)
    {
        try
        {
            if (i.QueueCode != "content") { ShowToast("Only content items can be approved from this action.", "warning"); return; }
            await Api.ApproveMarketingWorkbenchContentAsync(_tenantId, i.ItemId);
            await LoadAsync();
            ShowToast($"\"{i.Title}\" approved.");
        }
        catch (Exception ex)
        {
            ShowToast($"Approval failed: {ex.Message}", "danger");
        }
    }

    private Task ExportAsync() => Task.Run(() => ShowToast($"Export prepared for {AllItems.Count()} marketing workbench rows and {_leadSources.Count} lead sources."));
    private void SetActiveQueue(string id) { _activeQueue = id; _selected = id is "analytics" or "views" ? null : ActiveItems.FirstOrDefault(); }
    private void ShowCampaigns() { _filterSla = string.Empty; SetActiveQueue("campaigns"); }
    private void ShowOutreach() { _filterSla = string.Empty; SetActiveQueue("outreach"); }
    private void ShowReferrals() { _filterSla = string.Empty; SetActiveQueue("referrals"); }
    private void ShowContent() { _filterSla = string.Empty; SetActiveQueue("content"); }
    private void ResetFilters() { _search = string.Empty; _filterPriority = string.Empty; _filterSla = string.Empty; }
    private void OpenDetail(MktItem i) => _selected = i;
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;

    private Task SaveCurrentViewAsync()
    {
        var name = $"{ActiveQueueTitle} · {DateTime.Now:MMM d h:mm tt}";
        _savedViews.RemoveAll(x => x.Name == name);
        _savedViews.Add(new(name, _activeQueue, _scope, _branchId, _teamId, _search, _filterPriority, _filterSla));
        ShowToast($"View \"{name}\" saved.");
        return Task.CompletedTask;
    }

    private Task LoadViewAsync(string name)
    {
        var v = _savedViews.FirstOrDefault(x => x.Name == name);
        if (v is null) return Task.CompletedTask;
        _activeQueue = v.QueueId; _scope = v.Scope; _branchId = v.BranchId; _teamId = v.TeamId; _search = v.Search; _filterPriority = v.Priority; _filterSla = v.Sla;
        _selected = _activeQueue is "analytics" or "views" ? null : ActiveItems.FirstOrDefault();
        ShowToast($"View \"{name}\" loaded.");
        return Task.CompletedTask;
    }

    private async Task DeleteViewAsync(string name)
    {
        if (!await Confirmations.ConfirmAsync("Delete saved view", $"Delete saved view {name}?", "Delete")) return;
        _savedViews.RemoveAll(x => x.Name == name);
        ShowToast($"View \"{name}\" deleted.", "warning");
    }

    private bool Matches(MktItem i) => (string.IsNullOrWhiteSpace(_filterPriority) || i.Priority == _filterPriority) && (string.IsNullOrWhiteSpace(_filterSla) || i.SlaStatus == _filterSla) && (string.IsNullOrWhiteSpace(_search) || new[] { i.Title, i.ContactName, i.CampaignName, i.RefNumber, i.Channel, i.ContentType, i.TargetAudience, i.AssignedTo, i.ReviewedBy, i.Location, i.Status, i.Notes ?? string.Empty }.Any(v => !string.IsNullOrWhiteSpace(v) && v.Contains(_search, StringComparison.OrdinalIgnoreCase)));
    private RenderFragment QueueCard(MktItem item) => @<article class="mkw-item-card @(ReferenceEquals(_selected, item) ? "mkw-item-selected" : string.Empty)" @onclick="@(() => OpenDetail(item))"><div class="mkw-item-top"><span class="mkw-avatar" style="@AvatarStyle(DetailSubhead(item))">@Initials(DetailSubhead(item))</span><div><strong>@item.Title</strong><span>@DetailSubhead(item)</span></div></div><div class="mkw-item-meta"><span class="@StatusBadge(item.Status)">@item.Status</span><span class="@PriBadge(item.Priority)">@item.Priority</span>@if (!string.IsNullOrWhiteSpace(item.Channel)) { <span class="@ChanBadge(item.Channel)">@item.Channel</span> }@if (item.SlaStatus != "On Track") { <span class="@SlaBadge(item.SlaStatus)">@item.SlaStatus</span> }</div><div class="mkw-item-footer"><strong>@(item.Leads > 0 ? $"{item.Leads:N0} leads" : item.RefNumber)</strong><span>@(item.EventDate?.ToString("MMM d", CultureInfo.CurrentCulture) ?? item.DueDate.ToString("MMM d", CultureInfo.CurrentCulture))</span></div><div class="mkw-item-actions" @onclick:stopPropagation="true">@if (item.QueueCode == "content" && item.Status != "Approved") { <button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ApproveAsync(item))"><i class="bi bi-check-lg"></i></button> }<button class="mkw-card-open" @onclick="@(() => OpenDetail(item))" title="Preview details" aria-label="Preview details">👁️</button><button class="mkw-card-open" @onclick="@(() => Nav.NavigateTo(item.DetailUrl))" title="Open record" aria-label="Open record">↗️</button></div></article>;
    private RenderFragment LeadSourceCard(LeadSource source) => @<article class="mkw-source-card"><div><strong>@source.SourceName</strong><span>@source.Leads leads · @source.Converted converted</span></div><div class="mkw-source-rate"><strong>@(source.Leads > 0 ? ((double)source.Converted / source.Leads * 100).ToString("F1") : "0.0")%</strong><span>@source.AvgPremium.ToString("C0") avg premium</span></div></article>;
    private RenderFragment EmptyState(string icon, string title, string text) => @<div class="mkw-empty-state"><i class="bi @icon" aria-hidden="true"></i><strong>@title</strong><span>@text</span><button class="um-btn um-btn-primary" @onclick="LoadAsync">Refresh</button></div>;
    private RenderFragment AnalyticsItem(MetricBar row) => @<button class="mkw-analytics-row"><span>@row.Label</span><div><i class="@row.Tone" style="width:@row.WidthPercent%"></i></div><strong>@row.Count</strong><small>@row.Percent.ToString("F0")%</small></button>;
    private IReadOnlyList<MetricBar> BuildAnalytics(IEnumerable<AnalyticsSeed> seeds) { var items = seeds.ToList(); var total = Math.Max(1, items.Sum(x => x.Count)); return items.Select(x => new MetricBar(x.Label, x.Count, x.Tone, x.Count * 100m / total, Math.Max(4m, x.Count * 100m / total))).ToList(); }
    private string MetricCardClass(KpiMetric metric) => $"mkw-kpi-card {(metric.QueueId == _activeQueue ? "mkw-kpi-card-active" : string.Empty)}";
    private string QueueTabClass(string id) => $"mkw-view-btn {(id == _activeQueue ? "mkw-view-btn-active" : string.Empty)}";
    private static MktCounts ToCounts(MarketingWorkbenchCountsDto? c) => c is null ? new() : new() { ActiveCampaigns = c.ActiveCampaigns, CampaignLeads = c.CampaignLeads, OutreachTasks = c.OutreachTasks, OutreachOverdue = c.OutreachOverdue, Referrals = c.Referrals, ReferralsConverted = c.ReferralsConverted, UpcomingEvents = c.UpcomingEvents, EventFollowUps = c.EventFollowUps, ContentPendingApproval = c.ContentPendingApproval, TotalLeads = c.TotalLeads, LeadsConverted = c.LeadsConverted, ConversionRate = c.ConversionRate, CostPerLead = c.CostPerLead };
    private static MktItem ToMktItem(MarketingWorkbenchItemDto i) => new() { ItemId = i.ItemId, QueueCode = i.QueueCode, Title = i.Title, RefNumber = i.RefNumber, ContactName = i.ContactName, CampaignName = i.CampaignName, Channel = i.Channel, ContentType = i.ContentType, TargetAudience = i.TargetAudience, AssignedTo = i.AssignedTo, ReviewedBy = i.ReviewedBy, Location = i.Location, Priority = i.Priority, SlaStatus = i.SlaStatus, Status = i.Status, Budget = i.Budget, EstPremium = i.EstPremium, Leads = i.Leads, Conversions = i.Conversions, Attendees = i.Attendees, DueDate = i.DueDate, EndDate = i.EndDate, EventDate = i.EventDate, ReceivedDate = i.ReceivedDate, Notes = i.Notes, DetailUrl = i.DetailUrl };
    private static LeadSource ToLeadSource(MarketingWorkbenchLeadSourceDto s) => new() { SourceName = s.SourceName, Leads = s.Leads, Converted = s.Converted, AvgPremium = s.AvgPremium };
    private static string DetailSubhead(MktItem i) => !string.IsNullOrWhiteSpace(i.CampaignName) ? i.CampaignName : !string.IsNullOrWhiteSpace(i.ContactName) ? i.ContactName : !string.IsNullOrWhiteSpace(i.TargetAudience) ? i.TargetAudience : !string.IsNullOrWhiteSpace(i.Location) ? i.Location : "Marketing";
    private static string PriBadge(string p) => p switch { "Critical" => "mkw-pri mkw-pri-critical", "Urgent" => "mkw-pri mkw-pri-urgent", "High" => "mkw-pri mkw-pri-high", "Normal" => "mkw-pri mkw-pri-normal", _ => "mkw-pri mkw-pri-low" };
    private static string SlaBadge(string s) => s switch { "On Track" => "mkw-sla mkw-sla-ok", "At Risk" => "mkw-sla mkw-sla-warn", _ => "mkw-sla mkw-sla-breach" };
    private static string StatusBadge(string s) => s switch { "Active" => "mkw-status mkw-status-approved", "Draft" => "mkw-status mkw-status-pending", "Paused" => "mkw-status mkw-status-review", "Complete" => "mkw-status mkw-status-open", "Pending Approval" => "mkw-status mkw-status-review", "Approved" => "mkw-status mkw-status-approved", "Rejected" => "mkw-status mkw-status-rejected", "Converted" => "mkw-status mkw-status-approved", _ => "mkw-status" };
    private static string ChanBadge(string c) => c switch { "Email" => "mkw-chan mkw-chan-email", "Phone" => "mkw-chan mkw-chan-phone", "Social" => "mkw-chan mkw-chan-social", "Event" => "mkw-chan mkw-chan-event", "Referral" => "mkw-chan mkw-chan-event", _ => "mkw-chan" };
    private static string FormatAge(DateTime dt) { var diff = DateTime.Now - dt; if (diff.TotalMinutes < 1) return "Just now"; if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m ago"; if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago"; if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d ago"; return dt.ToString("d", CultureInfo.CurrentCulture); }
    private static string Initials(string name) { var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length >= 1 ? name[..1] : "?"; }
    private static string AvatarStyle(string name) { var hue = Math.Abs(name.GetHashCode()) % 360; return $"background:hsl({hue},70%,94%);color:hsl({hue},45%,32%);border:1px solid hsl({hue},55%,86%);box-shadow:inset 0 1px 0 rgba(255,255,255,.85);"; }
    async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); TenantId = context.TenantId; TenantAdminUserId = context.UserId; _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; DevTenantId = context.TenantId; DevUserId = context.UserId; }

