@page "/workbench/operations"
@namespace Ams.Web.Components.Pages.Workbench
@using System.Globalization
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@inject ConfirmationDialogService ConfirmationDialog

<PageTitle>Operations Workbench</PageTitle>

<div class="opw-enterprise-page">
    @if (_toastVisible)
    {
        <div class="opw-toast opw-toast-@_toastKind" role="status" aria-live="polite">
            <i class="@ToastIcon" aria-hidden="true"></i>
            <span>@_toastMessage</span>
            <button type="button" class="opw-toast-close" @onclick="HideToast" aria-label="Dismiss notification">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
    }

    <section class="opw-hero" aria-labelledby="operations-title">
        <div class="opw-hero-left">
            <span class="opw-hero-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
            <div>
                <div class="opw-title-row">
                    <h1 id="operations-title">Operations Workbench</h1>
                    <span><i class="bi bi-broadcast-pin" aria-hidden="true"></i> Live operations command center</span>
                </div>
                <p>Coordinate agency service queues, endorsements, certificates, renewals, document exceptions, carrier downloads, and automation recovery from one full-width enterprise workspace.</p>
            </div>
        </div>
        <div class="opw-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="SaveCurrentViewAsync">
                <i class="bi bi-bookmark-plus" aria-hidden="true"></i> Save view
            </button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync">
                <i class="bi bi-download" aria-hidden="true"></i> Export
            </button>
            <button type="button" class="um-btn um-btn-primary" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "opw-spin" : null)" aria-hidden="true"></i> Refresh
            </button>
        </div>
    </section>

    <section class="opw-insight-strip" aria-label="Operations summary">
        <article class="opw-insight-card opw-insight-primary">
            <span class="opw-insight-icon"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i></span>
            <div><small>Operational risk</small><strong>@RiskScoreLabel</strong></div>
        </article>
        <article class="opw-insight-card">
            <span class="opw-insight-icon opw-tone-info"><i class="bi bi-list-task" aria-hidden="true"></i></span>
            <div><small>Open queue items</small><strong>@AllItems.Count()</strong></div>
        </article>
        <article class="opw-insight-card">
            <span class="opw-insight-icon opw-tone-success"><i class="bi bi-person-check" aria-hidden="true"></i></span>
            <div><small>Assigned to me</small><strong>@AllItems.Count(i => i.IsAssignedToMe)</strong></div>
        </article>
        <article class="opw-insight-card">
            <span class="opw-insight-icon opw-tone-warning"><i class="bi bi-alarm" aria-hidden="true"></i></span>
            <div><small>Past due</small><strong>@AllItems.Count(i => i.DueDate.Date < DateTime.Today)</strong></div>
        </article>
    </section>

    <section class="opw-ops-strip" aria-label="Operations controls">
        <div class="opw-scope-card">
            <div class="opw-scope-head">
                <span><i class="bi bi-funnel" aria-hidden="true"></i> Work scope</span>
                <strong>@(string.IsNullOrWhiteSpace(_filterAssignee) ? "All assignees" : AssigneeLabel(_filterAssignee))</strong>
            </div>
            <div class="opw-scope-grid">
                <label>
                    Assignee
                    <select class="opw-filter-select" value="@_filterAssignee" @onchange="@OnAssigneeSelectChangedAsync">
                        <option value="">All assignees</option>
                        @foreach (var option in _assigneeOptions)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                </label>
                <label>
                    Priority
                    <select class="opw-filter-select" value="@_filterPriority" @onchange="@OnPrioritySelectChanged">
                        <option value="">All priorities</option>
                        @foreach (var option in _priorityOptions)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                </label>
                <label>
                    Age
                    <select class="opw-filter-select" value="@_filterAge" @onchange="@OnAgeSelectChanged">
                        <option value="">Any age</option>
                        @foreach (var option in _ageOptions)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                </label>
                <label class="opw-check-filter">
                    <input type="checkbox" checked="@_filterMyItems" @onchange="@OnMyItemsChanged" />
                    <span>My items only</span>
                </label>
            </div>
        </div>

        <div class="opw-ai-card">
            <div class="opw-ai-head">
                <span><i class="bi bi-stars" aria-hidden="true"></i> Operations brief</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="GenerateOperationsBriefAsync">
                    <i class="bi bi-magic" aria-hidden="true"></i> Generate
                </button>
            </div>
            <p>@_operationsBrief</p>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger opw-error-banner" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="opw-kpi-strip" aria-label="Operations KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="@KpiClass(kpi.Id)" @onclick="() => SetQueueFocus(kpi.Id)" title="@kpi.Tooltip">
                <span class="opw-kpi-icon @kpi.Tone"><i class="@kpi.Icon" aria-hidden="true"></i></span>
                <span>
                    <strong class="opw-kpi-val @kpi.ValueClass">@kpi.Value</strong>
                    <span class="opw-kpi-lbl">@kpi.Label</span>
                    <small>@kpi.Subtitle</small>
                </span>
            </button>
        }
    </section>

    <section class="opw-workflow-strip" aria-label="Workflow shortcuts">
        <button type="button" class="opw-workflow-card" @onclick="ShowRecoveryQueue">
            <i class="bi bi-life-preserver" aria-hidden="true"></i>
            <span><strong>Recovery queue</strong><span>@RecoveryItems.Count() retryable items</span></span>
        </button>
        <button type="button" class="opw-workflow-card" @onclick="ShowRenewals">
            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
            <span><strong>Renewal follow-up</strong><span>@_renewalFollowups.Count expiring workflows</span></span>
        </button>
        <button type="button" class="opw-workflow-card" @onclick="ShowClientService">
            <i class="bi bi-people" aria-hidden="true"></i>
            <span><strong>Client service</strong><span>@(_pendingEndorsements.Count + _certRequests.Count) service requests</span></span>
        </button>
        <button type="button" class="opw-workflow-card" @onclick="ClearFilters">
            <i class="bi bi-eraser" aria-hidden="true"></i>
            <span><strong>Clear filters</strong><span>Reset queue, search, priority, and age</span></span>
        </button>
    </section>

    <section class="opw-search-panel" aria-label="Search and filter operations queue">
        <div class="opw-search-wrap">
            <span class="opw-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="opw-search-body">
                <label for="operations-search">Search operations queue</label>
                <input id="operations-search" class="opw-search-input" type="search" placeholder="Search title, account, reference, policy, assignee, or error…" value="@_search" @oninput="@OnSearchChanged" />
                <span class="opw-search-hint">Results update across the active queue and detail panel.</span>
            </div>
        </div>
        <div class="opw-search-result">
            <strong>@ActiveItems.Count</strong>
            <span>visible</span>
        </div>
    </section>

    <section class="opw-view-tabs" role="tablist" aria-label="Operations queue tabs">
        @foreach (var queue in Queues)
        {
            <button type="button" class="opw-view-btn @(queue.Id == _activeQueue ? "opw-view-btn-active" : null)" role="tab" aria-selected="@(queue.Id == _activeQueue)" @onclick="() => SetActiveQueue(queue.Id)">
                <i class="@queue.Icon" aria-hidden="true"></i>
                @queue.Label
                @if (queue.Badge > 0)
                {
                    <span class="@(queue.IsAlert ? "opw-tab-alert" : null)">@queue.Badge</span>
                }
            </button>
        }
    </section>

    <section class="opw-content-layout">
        <main class="opw-main-card" aria-live="polite">
            <div class="opw-section-head">
                <div>
                    <h2>@ActiveQueueTitle</h2>
                    <p>@ActiveQueueSubtitle</p>
                </div>
                <span class="opw-status opw-status-open">@ActiveItems.Count active</span>
            </div>

            @if (_loading)
            {
                <div class="opw-loading">
                    <i class="bi bi-arrow-repeat opw-spin" aria-hidden="true"></i>
                    <strong>Loading operations queue…</strong>
                    <span>Synchronizing tasks, admin records, and recovery workflows.</span>
                </div>
            }
            else if (_activeQueue == "analytics")
            {
                <div class="opw-analytics-grid">
                    <section>
                        <h3>Queue distribution</h3>
                        @foreach (var item in QueueDistribution)
                        {
                            <button type="button" class="opw-analytics-row" @onclick="() => SetActiveQueue(item.QueueId)">
                                <span>@item.Label</span>
                                <div><i class="@item.Tone" style="@WidthStyle(item.Count, AllItems.Count())"></i></div>
                                <strong>@item.Count</strong>
                                <small>@PercentLabel(item.Count, AllItems.Count())</small>
                            </button>
                        }
                    </section>
                    <section>
                        <h3>Priority mix</h3>
                        @foreach (var item in PriorityDistribution)
                        {
                            <button type="button" class="opw-analytics-row" @onclick="() => FilterByPriority(item.Label)">
                                <span>@item.Label</span>
                                <div><i class="@item.Tone" style="@WidthStyle(item.Count, AllItems.Count())"></i></div>
                                <strong>@item.Count</strong>
                                <small>@PercentLabel(item.Count, AllItems.Count())</small>
                            </button>
                        }
                    </section>
                    <section>
                        <h3>Age pressure</h3>
                        @foreach (var item in AgeDistribution)
                        {
                            <button type="button" class="opw-analytics-row" @onclick="() => FilterByAge(item.Filter)">
                                <span>@item.Label</span>
                                <div><i class="@item.Tone" style="@WidthStyle(item.Count, AllItems.Count())"></i></div>
                                <strong>@item.Count</strong>
                                <small>@PercentLabel(item.Count, AllItems.Count())</small>
                            </button>
                        }
                    </section>
                    <section>
                        <h3>Recovery readiness</h3>
                        <div class="opw-stat-stack">
                            <div><span>Retryable</span><strong>@RecoveryItems.Count()</strong></div>
                            <div><span>Failed downloads</span><strong>@_failedDownloads.Count</strong></div>
                            <div><span>Failed automations</span><strong>@_failedAutomations.Count</strong></div>
                            <div><span>Doc exceptions</span><strong>@_docExceptions.Count</strong></div>
                        </div>
                    </section>
                </div>
            }
            else if (ActiveItems.Count == 0)
            {
                <div class="opw-empty-state">
                    <i class="bi bi-inbox" aria-hidden="true"></i>
                    <strong>No operations items match this view</strong>
                    <span>Try clearing filters or selecting another KPI queue.</span>
                    <button type="button" class="um-btn um-btn-primary" @onclick="ClearFilters">
                        <i class="bi bi-eraser" aria-hidden="true"></i> Clear filters
                    </button>
                </div>
            }
            else
            {
                <div class="opw-card-grid">
                    @foreach (var item in ActiveItems)
                    {
                        <article class="opw-item-card @(ReferenceEquals(item, _selectedItem) ? "opw-item-selected" : null)" @onclick="() => OpenItem(item)">
                            <div class="opw-item-top">
                                <div class="opw-item-title-wrap">
                                    <span class="opw-avatar @QueueTone(item.QueueCode)">@Initials(item)</span>
                                    <div>
                                        <strong>@ItemPrimaryTitle(item)</strong>
                                        <span>@ItemSecondaryText(item)</span>
                                    </div>
                                </div>
                                <span class="@PriBadge(item.Priority)">@item.Priority</span>
                            </div>
                            <div class="opw-item-meta">
                                <span class="opw-status opw-status-open">@item.QueueName</span>
                                <span class="opw-age @AgeBadgeClass(item.AgeDays)">@item.AgeDays d</span>
                                @if (item.DueDate.Date < DateTime.Today)
                                {
                                    <span class="opw-sla opw-sla-breach">Overdue</span>
                                }
                                else
                                {
                                    <span class="opw-sla opw-sla-ok">On track</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.RenewalStage))
                                {
                                    <span class="@StageBadge(item.RenewalStage)">@item.RenewalStage</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.ErrorMessage))
                            {
                                <p class="opw-error-snippet"><i class="bi bi-bug" aria-hidden="true"></i> @item.ErrorMessage</p>
                            }
                            <div class="opw-item-footer">
                                <div>
                                    <strong>@item.AssignedTo</strong>
                                    <span>@DueLabel(item)</span>
                                </div>
                                <div class="opw-item-actions">
                                    @if (item.CanRetry)
                                    {
                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ConfirmRetryAsync(item)" @onclick:stopPropagation="true" title="Retry item">
                                            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
                                        </button>
                                    }
                                    @if (item.QueueCode == "failed-automations")
                                    {
                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ConfirmSkipAsync(item)" @onclick:stopPropagation="true" title="Skip failed step">
                                            <i class="bi bi-skip-forward" aria-hidden="true"></i>
                                        </button>
                                    }
                                    <button type="button" class="opw-card-open" @onclick="() => OpenItem(item)" @onclick:stopPropagation="true" title="Open details" aria-label="Open details">
                                        👁️
                                    </button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </main>

        <aside class="opw-detail-card" aria-label="Operations item detail">
            @if (_selectedItem is null)
            {
                <div class="opw-detail-empty">
                    <i class="bi bi-layout-sidebar-inset-reverse" aria-hidden="true"></i>
                    <strong>Select an operations item</strong>
                    <span>Open any card to review assignment, SLA, notes, errors, and available workflow actions.</span>
                </div>
            }
            else
            {
                <div class="opw-detail-head">
                    <div>
                        <span class="opw-detail-eyebrow"><i class="bi bi-crosshair" aria-hidden="true"></i> @_selectedItem.QueueName</span>
                        <h2>@ItemPrimaryTitle(_selectedItem)</h2>
                        <p>@ItemSecondaryText(_selectedItem)</p>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseDetail" aria-label="Close detail">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="opw-detail-body">
                    <div class="opw-detail-summary">
                        <div><span>Reference</span><strong>@_selectedItem.RefNumber</strong></div>
                        <div><span>Priority</span><strong>@_selectedItem.Priority</strong></div>
                        <div><span>Assigned to</span><strong>@_selectedItem.AssignedTo</strong></div>
                        <div><span>Age</span><strong>@_selectedItem.AgeDays days</strong></div>
                        <div><span>Due date</span><strong>@_selectedItem.DueDate.ToString("d", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Retries</span><strong>@_selectedItem.RetryCount</strong></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_selectedItem.PolicyNumber) || !string.IsNullOrWhiteSpace(_selectedItem.CertHolder) || _selectedItem.Premium > 0)
                    {
                        <div class="opw-detail-summary">
                            @if (!string.IsNullOrWhiteSpace(_selectedItem.PolicyNumber))
                            {
                                <div><span>Policy</span><strong>@_selectedItem.PolicyNumber</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_selectedItem.CertHolder))
                            {
                                <div><span>Certificate holder</span><strong>@_selectedItem.CertHolder</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_selectedItem.LobCode))
                            {
                                <div><span>Line of business</span><strong>@_selectedItem.LobCode</strong></div>
                            }
                            @if (_selectedItem.Premium > 0)
                            {
                                <div><span>Premium</span><strong>@_selectedItem.Premium.ToString("C0", CultureInfo.CurrentCulture)</strong></div>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_selectedItem.AutomationStep))
                    {
                        <p class="opw-detail-note"><strong>Failed step:</strong> @_selectedItem.AutomationStep</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_selectedItem.ErrorMessage))
                    {
                        <p class="opw-detail-note opw-detail-error"><strong>Error:</strong> @_selectedItem.ErrorMessage</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_selectedItem.Notes))
                    {
                        <p class="opw-detail-note"><strong>Notes:</strong> @_selectedItem.Notes</p>
                    }
                    <div class="opw-detail-actions">
                        @if (_selectedItem.CanRetry)
                        {
                            <button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfirmRetryAsync(_selectedItem)">
                                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Retry
                            </button>
                        }
                        @if (_selectedItem.QueueCode == "failed-automations")
                        {
                            <button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfirmSkipAsync(_selectedItem)">
                                <i class="bi bi-skip-forward" aria-hidden="true"></i> Skip step
                            </button>
                        }
                        <button type="button" class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selectedItem.DetailUrl)">
                            Open record <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            }
        </aside>
    </section>

    <section class="opw-saved-views" aria-label="Saved operations views">
        <div class="opw-section-head">
            <div>
                <h2>Saved command views</h2>
                <p>Quickly restore high-priority operational scopes for daily standups and recovery reviews.</p>
            </div>
        </div>
        <div class="opw-source-grid">
            @foreach (var view in _savedViews)
            {
                <article class="opw-view-card">
                    <div>
                        <strong>@view.Name</strong>
                        <span>@view.Description</span>
                        <small>@view.Summary</small>
                    </div>
                    <div class="opw-item-actions">
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => LoadView(view)">Load</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => DeleteView(view)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                    </div>
                </article>
            }
        </div>
    </section>
</div>

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;

    private bool _loading;
    private string? _loadError;
    private string _activeQueue = "overdue-tasks";
    private int _queueFocus;
    private OpsItem? _selectedItem;

    private string _search = string.Empty;
    private string _filterPriority = string.Empty;
    private string _filterAge = string.Empty;
    private string _filterAssignee = string.Empty;
    private bool _filterMyItems;

    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string _operationsBrief = "Generate an operations brief to summarize queue pressure, recovery blockers, overdue work, and recommended next actions.";

    private QueueCounts _counts = new();
    private List<OpsItem> _overdueTasks = [];
    private List<OpsItem> _pendingEndorsements = [];
    private List<OpsItem> _certRequests = [];
    private List<OpsItem> _renewalFollowups = [];
    private List<OpsItem> _docExceptions = [];
    private List<OpsItem> _failedDownloads = [];
    private List<OpsItem> _failedAutomations = [];
    private List<SavedViewVm> _savedViews = [];

    private readonly List<LabelValue> _priorityOptions = [new("Critical", "Critical"), new("Urgent", "Urgent"), new("High", "High"), new("Normal", "Normal"), new("Low", "Low")];
    private readonly List<LabelValue> _ageOptions = [new("1", "< 1 day"), new("3", "1–3 days"), new("7", "4–7 days"), new("30", "> 7 days")];
    private readonly List<LabelValue> _assigneeOptions = [new("me", "Me"), new("team", "My Team")];
    private static readonly string[] _distributionTones = ["opw-dist-blue", "opw-dist-amber", "opw-dist-green", "opw-dist-purple", "opw-dist-pink"];

    private IEnumerable<OpsItem> AllItems => _overdueTasks.Concat(_pendingEndorsements).Concat(_certRequests).Concat(_renewalFollowups).Concat(_docExceptions).Concat(_failedDownloads).Concat(_failedAutomations);
    private IEnumerable<OpsItem> RecoveryItems => _docExceptions.Concat(_failedDownloads).Concat(_failedAutomations).Where(i => i.CanRetry);
    private List<OpsItem> ActiveItems => _activeQueue switch
    {
        "overdue-tasks" => FilteredItems(_overdueTasks),
        "endorsements" => FilteredItems(_pendingEndorsements),
        "certificates" => FilteredItems(_certRequests),
        "renewal-followups" => FilteredItems(_renewalFollowups),
        "doc-exceptions" => FilteredItems(_docExceptions),
        "failed-downloads" => FilteredItems(_failedDownloads),
        "failed-automations" => FilteredItems(_failedAutomations),
        _ => FilteredItems(AllItems.ToList()),
    };

    private Microsoft.AspNetCore.Components.EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> OnAssigneeSelectChangedAsync => Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, async e =>
    {
        _filterAssignee = e.Value?.ToString() ?? string.Empty;
        await LoadAsync();
    });

    private Microsoft.AspNetCore.Components.EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> OnPrioritySelectChanged => Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e =>
    {
        _filterPriority = e.Value?.ToString() ?? string.Empty;
        ApplyFilters();
    });

    private Microsoft.AspNetCore.Components.EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> OnAgeSelectChanged => Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e =>
    {
        _filterAge = e.Value?.ToString() ?? string.Empty;
        ApplyFilters();
    });

    private Microsoft.AspNetCore.Components.EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> OnMyItemsChanged => Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e =>
    {
        _filterMyItems = e.Value is bool selected && selected;
        ApplyFilters();
    });

    private Microsoft.AspNetCore.Components.EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> OnSearchChanged => Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e =>
    {
        _search = e.Value?.ToString() ?? string.Empty;
        ApplyFilters();
    });

    private string ToastIcon => _toastKind switch { "danger" => "bi bi-exclamation-triangle-fill", "warning" => "bi bi-exclamation-circle-fill", _ => "bi bi-check-circle-fill" };
    private string RiskScoreLabel => (_counts.OverdueTasks + _counts.FailedDownloads + _counts.FailedAutomations + _counts.DocIndexingExceptions) switch { >= 20 => "Critical", >= 10 => "Elevated", >= 1 => "Watch", _ => "Healthy" };
    private string ActiveQueueTitle => Queues.FirstOrDefault(q => q.Id == _activeQueue)?.Label ?? "Operations analytics";
    private string ActiveQueueSubtitle => _activeQueue switch
    {
        "overdue-tasks" => "Tasks past SLA or due date that need immediate triage.",
        "endorsements" => "Pending endorsement requests requiring service follow-up.",
        "certificates" => "Certificate requests waiting for processing or delivery.",
        "renewal-followups" => "Renewal workflows that need outreach, quoting, or producer action.",
        "doc-exceptions" => "Document indexing exceptions that need correction or retry.",
        "failed-downloads" => "Carrier download failures and mapping issues for recovery.",
        "failed-automations" => "Automation steps that failed and need retry or skip decisions.",
        "analytics" => "Operational queue distribution, priority pressure, and recovery readiness.",
