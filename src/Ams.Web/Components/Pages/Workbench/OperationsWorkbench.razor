    private IEnumerable<AnalyticsVm> QueueDistribution => Queues.Where(q => q.Id != "analytics").Select((q, index) => new AnalyticsVm(q.Label, q.Badge, q.Id, string.Empty, DistTone(index)));
    private IEnumerable<AnalyticsVm> PriorityDistribution => AllItems.GroupBy(i => string.IsNullOrWhiteSpace(i.Priority) ? "Normal" : i.Priority).OrderByDescending(g => g.Count()).Select((g, index) => new AnalyticsVm(g.Key, g.Count(), string.Empty, string.Empty, DistTone(index)));
    private IEnumerable<AnalyticsVm> AgeDistribution => [new("< 1 day", AllItems.Count(i => i.AgeDays < 1), string.Empty, "1", "opw-dist-green"), new("1–3 days", AllItems.Count(i => i.AgeDays >= 1 && i.AgeDays <= 3), string.Empty, "3", "opw-dist-blue"), new("4–7 days", AllItems.Count(i => i.AgeDays >= 4 && i.AgeDays <= 7), string.Empty, "7", "opw-dist-amber"), new("> 7 days", AllItems.Count(i => i.AgeDays > 7), string.Empty, "30", "opw-dist-pink")];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Operations Workbench", "/workbench/operations"));
        SeedSavedViews();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _loadError = null;
            var context = await CurrentUser.RequireAsync();
            var myItemsOnly = !context.IsTenantAdministrator && (_filterMyItems || _filterAssignee == "me");
            var assigneeFilter = context.IsTenantAdministrator && _filterAssignee == "me" ? null : _filterAssignee;
            var result = await Api.GetOperationsWorkbenchAsync(_tenantId, context.UserScopeId, myItemsOnly, assigneeFilter);
            _overdueTasks = result?.OverdueTasks.Select(ToOpsItem).ToList() ?? [];
            _pendingEndorsements = result?.PendingEndorsements.Select(ToOpsItem).ToList() ?? [];
            _certRequests = result?.CertificateRequests.Select(ToOpsItem).ToList() ?? [];
            _renewalFollowups = result?.RenewalFollowups.Select(ToOpsItem).ToList() ?? [];
            _docExceptions = result?.DocExceptions.Select(ToOpsItem).ToList() ?? [];
            _failedDownloads = result?.FailedDownloads.Select(ToOpsItem).ToList() ?? [];
            _failedAutomations = result?.FailedAutomations.Select(ToOpsItem).ToList() ?? [];
            _counts = ToCounts(result?.Counts);
            _selectedItem = ActiveItems.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load operations workbench: {ex.Message}";
            _overdueTasks = [];
            _pendingEndorsements = [];
            _certRequests = [];
            _renewalFollowups = [];
            _docExceptions = [];
            _failedDownloads = [];
            _failedAutomations = [];
            RefreshCounts();
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters() { if (_selectedItem is not null && !ActiveItems.Contains(_selectedItem)) _selectedItem = ActiveItems.FirstOrDefault(); StateHasChanged(); }

    private List<OpsItem> FilteredItems(List<OpsItem> source) => source.Where(i =>
        (string.IsNullOrEmpty(_filterPriority) || string.Equals(i.Priority, _filterPriority, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterAge) || MatchAge(i.AgeDays, _filterAge)) &&
        (!_filterMyItems || i.IsAssignedToMe) &&
        (string.IsNullOrEmpty(_search) || MatchesSearch(i, _search))).ToList();

    private static bool MatchesSearch(OpsItem i, string search) =>
        i.Title.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        i.AccountName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        i.RefNumber.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        i.PolicyNumber.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        i.AssignedTo.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        (i.ErrorMessage?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false);

    private static bool MatchAge(int days, string bucket) => bucket switch { "1" => days < 1, "3" => days >= 1 && days <= 3, "7" => days >= 4 && days <= 7, "30" => days > 7, _ => true };

    private void SetActiveQueue(string id) { _activeQueue = id; _queueFocus = 0; _selectedItem = ActiveItems.FirstOrDefault(); }
    private void SetQueueFocus(int n) { _queueFocus = _queueFocus == n ? 0 : n; _activeQueue = QueueIdForKpi(n); _selectedItem = ActiveItems.FirstOrDefault(); }
    private void OpenItem(OpsItem item) => _selectedItem = item;
    private void CloseDetail() => _selectedItem = null;
    private void ShowRecoveryQueue() { _filterPriority = string.Empty; _filterAge = string.Empty; SetActiveQueue(_failedAutomations.Count > 0 ? "failed-automations" : _failedDownloads.Count > 0 ? "failed-downloads" : "doc-exceptions"); }
    private void ShowRenewals() { _filterPriority = string.Empty; SetActiveQueue("renewal-followups"); }
    private void ShowClientService() { _filterPriority = string.Empty; SetActiveQueue(_pendingEndorsements.Count >= _certRequests.Count ? "endorsements" : "certificates"); }
    private void FilterByPriority(string priority) { _filterPriority = priority; _activeQueue = "analytics"; ApplyFilters(); }
    private void FilterByAge(string age) { _filterAge = age; _activeQueue = "analytics"; ApplyFilters(); }

    private void ClearFilters()
    {
        _search = string.Empty;
        _filterPriority = string.Empty;
        _filterAge = string.Empty;
        _filterAssignee = string.Empty;
        _filterMyItems = false;
        _queueFocus = 0;
        _activeQueue = "overdue-tasks";
        _selectedItem = ActiveItems.FirstOrDefault();
    }

    private Task ExportAsync()
    {
        ShowToast($"Export prepared for {AllItems.Count()} operations rows across {Queues.Count() - 1} queues.");
        return Task.CompletedTask;
    }

    private Task SaveCurrentViewAsync()
    {
        var view = new SavedViewVm($"{ActiveQueueTitle} view", $"Saved {DateTime.Now:g}", $"{ActiveItems.Count} rows · {(_filterPriority.Length == 0 ? "all priorities" : _filterPriority)}", _activeQueue, _filterPriority, _filterAge, _search, _filterMyItems);
        _savedViews.Insert(0, view);
        ShowToast("Operations command view saved.");
        return Task.CompletedTask;
    }

    private void LoadView(SavedViewVm view)
    {
        _activeQueue = view.QueueId;
        _filterPriority = view.Priority;
        _filterAge = view.Age;
        _search = view.Search;
        _filterMyItems = view.MyItemsOnly;
        _selectedItem = ActiveItems.FirstOrDefault();
        ShowToast($"Loaded view: {view.Name}");
    }

    private void DeleteView(SavedViewVm view)
    {
        _savedViews.Remove(view);
        ShowToast($"Deleted view: {view.Name}", "warning");
    }

    private Task GenerateOperationsBriefAsync()
    {
        var riskItems = _counts.OverdueTasks + _counts.FailedDownloads + _counts.FailedAutomations + _counts.DocIndexingExceptions;
        _operationsBrief = riskItems == 0
            ? "Operations are healthy. No failed automation, download, or document recovery queues are currently pressuring the team. Keep monitoring renewal follow-ups and certificate demand."
            : $"Focus today on {riskItems} risk items: {_counts.OverdueTasks} overdue tasks, {_counts.DocIndexingExceptions} document exceptions, {_counts.FailedDownloads} failed downloads, and {_counts.FailedAutomations} automation failures. Prioritize retryable recovery items first, then service requests by due date.";
        ShowToast("Operations brief generated.");
        return Task.CompletedTask;
    }

    private async Task ConfirmRetryAsync(OpsItem item)
    {
        var confirmed = await ConfirmationDialog.ConfirmAsync("Retry operations item", $"Queue a retry for '{item.Title}'?", "Retry", "Cancel");
        if (!confirmed) return;
        await RetryItemAsync(item);
    }

    private async Task ConfirmSkipAsync(OpsItem item)
    {
        var confirmed = await ConfirmationDialog.ConfirmAsync("Skip failed automation step", $"Skip the failed step for '{item.Title}'?", "Skip step", "Cancel");
        if (!confirmed) return;
        await SkipStepAsync(item);
    }

    private async Task RetryItemAsync(OpsItem item)
    {
        try
        {
            await Api.RetryOperationsWorkbenchItemAsync(_tenantId, item.ItemId);
            await LoadAsync();
            ShowToast($"Retry queued: {item.Title}");
        }
        catch (Exception ex)
        {
            ShowToast($"Retry failed: {ex.Message}", "danger");
        }
    }

    private async Task SkipStepAsync(OpsItem item)
    {
        try
        {
            await Api.SkipOperationsWorkbenchStepAsync(_tenantId, item.ItemId);
            await LoadAsync();
            ShowToast($"Step skipped: {item.Title}");
        }
        catch (Exception ex)
        {
            ShowToast($"Skip failed: {ex.Message}", "danger");
        }
    }

    private void RefreshCounts() => _counts = new QueueCounts { OverdueTasks = _overdueTasks.Count, PendingEndorsements = _pendingEndorsements.Count, CertificateRequests = _certRequests.Count, RenewalFollowups = _renewalFollowups.Count, DocIndexingExceptions = _docExceptions.Count, FailedDownloads = _failedDownloads.Count, FailedAutomations = _failedAutomations.Count };
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;

    private void SeedSavedViews()
    {
        _savedViews =
        [
            new("Recovery standup", "Failures and retryable automation work", "Downloads · automations · doc exceptions", "failed-automations", string.Empty, string.Empty, string.Empty, false),
            new("High-priority service", "Critical and urgent operational work", "Priority filtered command view", "overdue-tasks", "Critical", string.Empty, string.Empty, false),
            new("My renewal desk", "Renewals assigned to me", "Renewal follow-ups · my items", "renewal-followups", string.Empty, string.Empty, string.Empty, true),
        ];
    }

    private static string QueueIdForKpi(int n) => n switch { 1 => "overdue-tasks", 2 => "endorsements", 3 => "certificates", 4 => "renewal-followups", 5 => "doc-exceptions", 6 => "failed-downloads", 7 => "failed-automations", _ => "overdue-tasks" };
    private string KpiClass(int n) => "opw-kpi-card" + (_queueFocus == n || (_queueFocus == 0 && _activeQueue == QueueIdForKpi(n)) ? " opw-kpi-card-active" : string.Empty);
    private static string AssigneeLabel(string value) => value == "me" ? "Me" : value == "team" ? "My Team" : "All assignees";
    private static decimal Percent(int value, int total) => total <= 0 ? 0 : Math.Min(100, Math.Round((decimal)value / total * 100, 1));
    private static string WidthStyle(int value, int total) => $"width:{Percent(value, Math.Max(1, total)):0.#}{Convert.ToChar(37)}";
    private static string PercentLabel(int value, int total) => $"{Percent(value, Math.Max(1, total)):0}{Convert.ToChar(37)}";
    private static string DistTone(int index) => _distributionTones[Math.Abs(index) % _distributionTones.Length];
    private static string ItemPrimaryTitle(OpsItem i) => !string.IsNullOrWhiteSpace(i.AccountName) && i.QueueCode == "renewal-followups" ? i.AccountName : i.Title;
    private static string ItemSecondaryText(OpsItem i) => !string.IsNullOrWhiteSpace(i.PolicyNumber) ? $"{i.RefNumber} · {i.PolicyNumber}" : !string.IsNullOrWhiteSpace(i.AccountName) ? $"{i.RefNumber} · {i.AccountName}" : i.RefNumber;
    private static string DueLabel(OpsItem i) => i.FollowUpDate.HasValue ? $"Follow-up {i.FollowUpDate.Value:d}" : i.DueDate.Date < DateTime.Today ? $"Due {i.DueDate:d}" : $"Due {i.DueDate:d}";
    private static string Initials(OpsItem i) => string.Join(string.Empty, (string.IsNullOrWhiteSpace(i.AccountName) ? i.Title : i.AccountName).Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpperInvariant();
    private static string QueueTone(string queueCode) => queueCode switch { "overdue-tasks" => "opw-tone-danger", "endorsements" => "opw-tone-purple", "certificates" => "opw-tone-success", "renewal-followups" => "opw-tone-info", "doc-exceptions" => "opw-tone-warning", "failed-downloads" => "opw-tone-pink", "failed-automations" => "opw-tone-danger", _ => "opw-tone-muted" };
    private static string PriBadge(string p) => p switch { "Critical" => "opw-pri opw-pri-critical", "Urgent" => "opw-pri opw-pri-urgent", "High" => "opw-pri opw-pri-high", "Normal" => "opw-pri opw-pri-normal", _ => "opw-pri opw-pri-low" };
    private static string AgeBadgeClass(int days) => days > 7 ? "opw-age-old" : days > 3 ? "opw-age-mid" : "opw-age-fresh";
    private static string StageBadge(string? stage) => stage switch { "Quoted" => "opw-stage opw-stage-quoted", "Presented" => "opw-stage opw-stage-presented", "Negotiating" => "opw-stage opw-stage-negotiating", "Won" => "opw-stage opw-stage-won", "Lost" => "opw-stage opw-stage-lost", _ => "opw-stage" };

    private static QueueCounts ToCounts(OperationsWorkbenchCountsDto? c) => c is null ? new() : new() { OverdueTasks = c.OverdueTasks, PendingEndorsements = c.PendingEndorsements, CertificateRequests = c.CertificateRequests, RenewalFollowups = c.RenewalFollowups, DocIndexingExceptions = c.DocIndexingExceptions, FailedDownloads = c.FailedDownloads, FailedAutomations = c.FailedAutomations };
    private static OpsItem ToOpsItem(OperationsWorkbenchItemDto i) => new() { ItemId = i.ItemId, QueueCode = i.QueueCode, QueueName = i.QueueName, Title = i.Title, RefNumber = i.RefNumber, AccountName = i.AccountName, PolicyNumber = i.PolicyNumber, CertHolder = i.CertHolder, LobCode = i.LobCode, AssignedTo = i.AssignedTo, Priority = i.Priority, DueDate = i.DueDate, FollowUpDate = i.FollowUpDate, CreatedAt = i.CreatedAt, AgeDays = i.AgeDays, Premium = i.Premium, ErrorMessage = i.ErrorMessage, RetryCount = i.RetryCount, AutomationStep = i.AutomationStep, RenewalStage = i.RenewalStage, Notes = i.Notes, CanRetry = i.CanRetry, IsAssignedToMe = i.IsAssignedToMe, DetailUrl = i.DetailUrl };

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

