        <div class="pw-detail-body pw-msg-viewer">
            <p>@_selectedMessage.Body</p>
        </div>
        <div class="pw-detail-footer">
            <button class="um-btn um-btn-ghost" @onclick="CloseMessage">Close</button>
            <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selectedMessage.AccountUrl)">
