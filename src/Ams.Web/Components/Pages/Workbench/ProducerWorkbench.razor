@page "/workbench/producer"
@namespace Ams.Web.Components.Pages.Workbench
@inject ProducerWorkbenchApiClient WorkbenchApi
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Producer Workbench</PageTitle>

<AppPageHeader Title="Producer Workbench"
               Subtitle="Your personal revenue pipeline — leads, opportunities, quotes, renewals, cross-sell targets and unread messages"
               Icon="bi-person-badge">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "pw-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-ghost" @onclick="ExportAsync">
            <i class="bi bi-download" aria-hidden="true"></i> Export
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/crm/leads")'>
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Lead
        </button>
    </Actions>
</AppPageHeader>

<div class="pw-insight-strip">
    <div class="pw-insight-card pw-insight-card--primary">
        <div class="pw-insight-icon"><i class="bi bi-stars" aria-hidden="true"></i></div>
        <div>
            <div class="pw-insight-label">Priority Focus</div>
            <div class="pw-insight-value">@PriorityFocusText</div>
        </div>
    </div>
    <div class="pw-insight-card">
        <div class="pw-insight-icon pw-insight-icon--green"><i class="bi bi-cash-coin" aria-hidden="true"></i></div>
        <div>
            <div class="pw-insight-label">Weighted Pipeline</div>
            <div class="pw-insight-value">@WeightedPipeline.ToString("C0")</div>
        </div>
    </div>
    <div class="pw-insight-card">
        <div class="pw-insight-icon pw-insight-icon--amber"><i class="bi bi-alarm" aria-hidden="true"></i></div>
        <div>
            <div class="pw-insight-label">Due Today / Overdue</div>
            <div class="pw-insight-value">@DueTodayOrOverdue</div>
        </div>
    </div>
    <div class="pw-insight-card">
        <div class="pw-insight-icon pw-insight-icon--purple"><i class="bi bi-lightning-charge" aria-hidden="true"></i></div>
        <div>
            <div class="pw-insight-label">Best Cross-sell</div>
            <div class="pw-insight-value">@BestCrossSellText</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
        @_loadError
    </div>
}

<!-- ── Goal progress bar ─────────────────────────────────────────────────── -->
<div class="pw-goal-strip">
    <div class="pw-goal-card">
        <div class="pw-goal-header">
            <span class="pw-goal-label"><i class="bi bi-trophy-fill pw-icon-gold" aria-hidden="true"></i> Written Premium Goal</span>
            <span class="pw-goal-pct">@_goal.WrittenPct.ToString("F0")% of goal</span>
        </div>
        <div class="pw-goal-bar-track">
            <div class="pw-goal-bar-fill" style="width:@Math.Min(_goal.WrittenPct, 100).ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%;background:@GoalBarColor(_goal.WrittenPct)"></div>
        </div>
        <div class="pw-goal-nums">
            <span class="pw-goal-achieved">@_goal.WrittenPremium.ToString("C0")</span>
            <span class="pw-goal-target">of @_goal.GoalPremium.ToString("C0")</span>
        </div>
    </div>
    <div class="pw-goal-kpis">
        <div class="pw-mini-kpi">
            <span class="pw-mini-value">@_goal.NewPolicies</span>
            <span class="pw-mini-label">New Policies</span>
        </div>
        <div class="pw-mini-kpi">
            <span class="pw-mini-value">@_goal.RetentionRate.ToString("F1")%</span>
            <span class="pw-mini-label">Retention</span>
        </div>
        <div class="pw-mini-kpi">
            <span class="pw-mini-value">@_goal.PipelineValue.ToString("C0")</span>
            <span class="pw-mini-label">Pipeline</span>
        </div>
        <div class="pw-mini-kpi @(_goal.UnreadMessages > 0 ? "pw-mini-kpi--alert" : "")">
            <span class="pw-mini-value">@_goal.UnreadMessages</span>
            <span class="pw-mini-label">Unread Messages</span>
        </div>
    </div>
</div>

<!-- ── KPI strip ─────────────────────────────────────────────────────────── -->
<div class="pw-kpi-strip">
    <div class="@KpiClass(1)" @onclick="() => SetQueueFocus(1)" role="button" tabindex="0" aria-label="Assigned Leads">
        <span class="pw-kpi-icon pw-kpi-icon--leads"><i class="bi bi-person-plus-fill" aria-hidden="true"></i></span>
        <div class="pw-kpi-body">
            <div class="pw-kpi-value">@_counts.AssignedLeads</div>
            <div class="pw-kpi-label">Leads</div>
            <div class="pw-kpi-sub">@_counts.HotLeads hot</div>
        </div>
        @if (_queueFocus == 1) { <span class="pw-kpi-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass(2)" @onclick="() => SetQueueFocus(2)" role="button" tabindex="0" aria-label="Open Opportunities">
        <span class="pw-kpi-icon pw-kpi-icon--opps"><i class="bi bi-trophy-fill" aria-hidden="true"></i></span>
        <div class="pw-kpi-body">
            <div class="pw-kpi-value">@_counts.OpenOpportunities</div>
            <div class="pw-kpi-label">Opportunities</div>
            <div class="pw-kpi-sub">@_counts.OppsPremium.ToString("C0") pipeline</div>
        </div>
        @if (_queueFocus == 2) { <span class="pw-kpi-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass(3)" @onclick="() => SetQueueFocus(3)" role="button" tabindex="0" aria-label="Quote Follow-up">
        <span class="pw-kpi-icon pw-kpi-icon--quotes"><i class="bi bi-file-earmark-text-fill" aria-hidden="true"></i></span>
        <div class="pw-kpi-body">
            <div class="pw-kpi-value @(_counts.OverdueQuotes > 0 ? "pw-kpi-value--warn" : "")">@_counts.QuoteFollowups</div>
            <div class="pw-kpi-label">Quote Follow-ups</div>
            <div class="pw-kpi-sub @(_counts.OverdueQuotes > 0 ? "pw-sub--warn" : "")">@_counts.OverdueQuotes overdue</div>
        </div>
        @if (_queueFocus == 3) { <span class="pw-kpi-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass(4)" @onclick="() => SetQueueFocus(4)" role="button" tabindex="0" aria-label="Renewal Call List">
        <span class="pw-kpi-icon pw-kpi-icon--renewals"><i class="bi bi-telephone-fill" aria-hidden="true"></i></span>
        <div class="pw-kpi-body">
            <div class="pw-kpi-value">@_counts.RenewalCallList</div>
            <div class="pw-kpi-label">Renewal Calls</div>
            <div class="pw-kpi-sub">@_counts.RenewalsThisMonth this month</div>
        </div>
        @if (_queueFocus == 4) { <span class="pw-kpi-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass(5)" @onclick="() => SetQueueFocus(5)" role="button" tabindex="0" aria-label="Cross-sell List">
        <span class="pw-kpi-icon pw-kpi-icon--crosssell"><i class="bi bi-arrows-expand" aria-hidden="true"></i></span>
        <div class="pw-kpi-body">
            <div class="pw-kpi-value">@_counts.CrossSellList</div>
            <div class="pw-kpi-label">Cross-sell</div>
            <div class="pw-kpi-sub">@_counts.CrossSellPremium.ToString("C0") potential</div>
        </div>
        @if (_queueFocus == 5) { <span class="pw-kpi-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass(6)" @onclick="() => SetQueueFocus(6)" role="button" tabindex="0" aria-label="Unread Messages">
        <span class="pw-kpi-icon pw-kpi-icon--msgs @(_counts.UnreadMessages > 0 ? "pw-kpi-icon--msgs-alert" : "")">
            <i class="bi bi-chat-dots-fill" aria-hidden="true"></i>
        </span>
        <div class="pw-kpi-body">
            <div class="pw-kpi-value @(_counts.UnreadMessages > 0 ? "pw-kpi-value--alert" : "")">@_counts.UnreadMessages</div>
            <div class="pw-kpi-label">Unread Messages</div>
        </div>
        @if (_queueFocus == 6) { <span class="pw-kpi-dot" aria-hidden="true"></span> }
    </div>
</div>

<!-- ── Queue tab bar ──────────────────────────────────────────────────────── -->
<div class="pw-queue-tabs" role="tablist" aria-label="Producer queue selector">
    @foreach (var q in _queues)
    {
        <button class="pw-queue-tab @(q.Id == _activeQueue ? "pw-queue-tab--active" : "")"
                role="tab"
                aria-selected="@(q.Id == _activeQueue)"
                @onclick="() => SetActiveQueue(q.Id)">
            <i class="@q.Icon" aria-hidden="true"></i>
            <span>@q.Label</span>
            @if (q.Badge > 0)
            {
                <span class="pw-tab-badge @(q.IsAlert ? "pw-tab-badge--alert" : "")">@q.Badge</span>
            }
        </button>
    }
</div>

<!-- ── Shared filter row ──────────────────────────────────────────────────── -->
<div class="pw-filter-row">
    <div class="pw-search-box">
        <i class="bi bi-search pw-search-icon" aria-hidden="true"></i>
        <input class="pw-search-input" type="text" placeholder="Search in queue…"
               value="@_search" @oninput="OnSearchInput" />
    </div>
    <SfDropDownList TValue="string" TItem="LabelValue"
                    DataSource="_lobOptions"
                    Placeholder="All Lines"
                    ShowClearButton="true"
                    Width="150px"
                    Value="_filterLob"
                    ValueChanged="@((string v) => { _filterLob = v; StateHasChanged(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>
    <SfDropDownList TValue="string" TItem="LabelValue"
                    DataSource="_stageOptions"
                    Placeholder="All Stages"
                    ShowClearButton="true"
                    Width="155px"
                    Value="_filterStage"
                    ValueChanged="@((string v) => { _filterStage = v; StateHasChanged(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>
    <label class="pw-toggle-label">
        <input type="checkbox" @bind="_filterHotOnly" @bind:after="StateHasChanged" />
        Hot / urgent only
    </label>
</div>

<!-- ── Queue panels ───────────────────────────────────────────────────────── -->
<div class="pw-queue-panel">

    @if (_loading)
    {
        <div class="pw-loading" aria-live="polite">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading queue…</span>
        </div>
    }
    else
    {
        <!-- ── 1 · Assigned Leads ─────────────────────────────────────────── -->
        @if (_activeQueue == "leads")
        {
            <div class="pw-grid-card app-datagrid">
                <SfGrid TValue="WorkbenchLeadItemVm"
                        DataSource="@FilteredLeads()"
                        AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
                    <GridPageSettings PageSize="20" PageSizes="@(new int[] { 10, 20, 50 })" />
                    <GridColumns>
                        <GridColumn HeaderText="Heat" Width="90">
                            <Template>
                                @{ var i = (WorkbenchLeadItemVm)context; }
                                <span class="@HeatBadge(i.HeatScore)">@HeatLabel(i.HeatScore)</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(WorkbenchLeadItemVm.Name)" HeaderText="Lead" Width="220">
                            <Template>
                                @{ var i = (WorkbenchLeadItemVm)context; }
                                <div class="pw-name-cell">
                                    <span class="pw-avatar" style="@AvatarStyle(i.Name)" aria-hidden="true">@Initials(i.Name)</span>
                                    <div>
                                        <div class="pw-item-name">@i.Name</div>
                                        <div class="pw-item-sub">@i.CompanyName</div>
                                    </div>
                                </div>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(WorkbenchLeadItemVm.LobCode)"    HeaderText="LoB"      Width="90" />
                        <GridColumn Field="@nameof(WorkbenchLeadItemVm.Source)"     HeaderText="Source"   Width="120" />
                        <GridColumn Field="@nameof(WorkbenchLeadItemVm.EstPremium)" HeaderText="Est. Premium" Width="130" TextAlign="TextAlign.Right">
                            <Template>@{ var i = (WorkbenchLeadItemVm)context; }<span class="pw-mono">@i.EstPremium.ToString("C0")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(WorkbenchLeadItemVm.LastContact)" HeaderText="Last Contact" Width="130">
                            <Template>@{ var i = (WorkbenchLeadItemVm)context; }<span>@(i.LastContact.HasValue ? FormatAge(i.LastContact.Value) : "—")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(WorkbenchLeadItemVm.NextAction)" HeaderText="Next Action" Width="160" />
                        <GridColumn Field="@nameof(WorkbenchLeadItemVm.NextActionDate)" HeaderText="Due" Width="110">
                            <Template>
                                @{ var i = (WorkbenchLeadItemVm)context; }
                                <span class="@(i.NextActionDate.HasValue && i.NextActionDate.Value < DateTime.Today ? "pw-overdue" : "")">
                                    @(i.NextActionDate.HasValue ? i.NextActionDate.Value.ToString("d") : "—")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Right">
                            <Template>@{ var i = (WorkbenchLeadItemVm)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenDetail(i)" title="Open"><i class="bi bi-arrow-right" aria-hidden="true"></i></button></Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        }

        <!-- ── 2 · Open Opportunities (Pipeline) ────────────────────────────── -->
        @if (_activeQueue == "opportunities")
        {
            <!-- view toggle -->
            <div class="pw-view-toggle" role="group" aria-label="Pipeline view">
                <button class="pw-view-btn @(_oppView == "kanban" ? "pw-view-btn--active" : "")"
                        @onclick='() => _oppView = "kanban"'>
                    <i class="bi bi-kanban" aria-hidden="true"></i> Board
                </button>
                <button class="pw-view-btn @(_oppView == "grid" ? "pw-view-btn--active" : "")"
                        @onclick='() => _oppView = "grid"'>
                    <i class="bi bi-table" aria-hidden="true"></i> Grid
                </button>
            </div>

            @if (_oppView == "kanban")
            {
                <div class="pw-kanban-wrap">
                    <SfKanban TValue="WorkbenchOppItemVm" KeyField="@nameof(WorkbenchOppItemVm.Stage)" DataSource="@FilteredOpps()">
                        <KanbanColumns>
                            @foreach (var col in _pipelineCols)
                            {
                                <KanbanColumn HeaderText="@col.Label" KeyField="@(new List<string>{ col.Value })"
                                              AllowDrop="true" AllowDrag="true" ShowItemCount="true" />
                            }
                        </KanbanColumns>
                        <KanbanCardSettings HeaderField="@nameof(WorkbenchOppItemVm.RefNumber)" ContentField="@nameof(WorkbenchOppItemVm.Name)">
                            <Template Context="kCtx">
                                @{ var i = (WorkbenchOppItemVm)kCtx; }
                                <div class="pw-kcard" @onclick="() => OpenDetail(i)">
                                    <div class="pw-kcard-hdr">
                                        <span class="@HeatBadge(i.HeatScore)">@HeatLabel(i.HeatScore)</span>
                                        <span class="@WinProbClass(i.WinProbPct) pw-kcard-win">@i.WinProbPct.ToString("F0")%</span>
                                    </div>
                                    <div class="pw-kcard-name">@i.Name</div>
                                    <div class="pw-kcard-acct">@i.CompanyName</div>
                                    <div class="pw-kcard-footer">
                                        <span class="pw-mono pw-bold">@i.EstPremium.ToString("C0")</span>
                                        @if (i.CloseDate.HasValue)
                                        {
                                            <span class="pw-kcard-close @(i.CloseDate.Value < DateTime.Today ? "pw-overdue" : "")">
                                                <i class="bi bi-calendar3" aria-hidden="true"></i> @i.CloseDate.Value.ToString("d")
                                            </span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(i.LobCode))
                                    {
                                        <div class="pw-kcard-lob"><span class="pw-lob-badge">@i.LobCode</span></div>
                                    }
                                </div>
                            </Template>
                        </KanbanCardSettings>
                    </SfKanban>
                </div>
            }
            else
            {
                <div class="pw-grid-card app-datagrid">
                    <SfGrid TValue="WorkbenchOppItemVm"
                            DataSource="@FilteredOpps()"
                            AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
                        <GridPageSettings PageSize="20" PageSizes="@(new int[] { 10, 20, 50 })" />
                        <GridColumns>
                            <GridColumn Field="@nameof(WorkbenchOppItemVm.Stage)" HeaderText="Stage" Width="140">
                                <Template>@{ var i = (WorkbenchOppItemVm)context; }<span class="@StageBadge(i.Stage)">@i.Stage</span></Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(WorkbenchOppItemVm.Name)" HeaderText="Opportunity" Width="220">
                                <Template>
                                    @{ var i = (WorkbenchOppItemVm)context; }
                                    <div class="pw-name-cell">
                                        <span class="pw-avatar" style="@AvatarStyle(i.CompanyName)" aria-hidden="true">@Initials(i.CompanyName)</span>
                                        <div>
                                            <div class="pw-item-name">@i.Name</div>
                                            <div class="pw-item-sub">@i.CompanyName</div>
                                        </div>
                                    </div>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(WorkbenchOppItemVm.LobCode)"    HeaderText="LoB"          Width="90" />
                            <GridColumn Field="@nameof(WorkbenchOppItemVm.EstPremium)" HeaderText="Est. Premium" Width="130" TextAlign="TextAlign.Right">
                                <Template>@{ var i = (WorkbenchOppItemVm)context; }<span class="pw-mono pw-bold">@i.EstPremium.ToString("C0")</span></Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(WorkbenchOppItemVm.WinProbPct)" HeaderText="Win %" Width="90" TextAlign="TextAlign.Right">
                                <Template>
                                    @{ var i = (WorkbenchOppItemVm)context; }
                                    <span class="@WinProbClass(i.WinProbPct)">@i.WinProbPct.ToString("F0")%</span>
                                </Template>
                            </GridColumn>
                            <GridColumn HeaderText="Weighted" Width="130" TextAlign="TextAlign.Right">
                                <Template>
                                    @{ var i = (WorkbenchOppItemVm)context; }
                                    <span class="pw-mono">@((i.EstPremium * (decimal)(i.WinProbPct / 100)).ToString("C0"))</span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(WorkbenchOppItemVm.CloseDate)" HeaderText="Target Close" Width="130">
                                <Template>
                                    @{ var i = (WorkbenchOppItemVm)context; }
                                    <span class="@(i.CloseDate.HasValue && i.CloseDate.Value < DateTime.Today ? "pw-overdue" : "")">
                                        @(i.CloseDate.HasValue ? i.CloseDate.Value.ToString("d") : "—")
                                    </span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(WorkbenchOppItemVm.NextAction)" HeaderText="Next Step" Width="160" />
                            <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Right">
                                <Template>@{ var i = (WorkbenchOppItemVm)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenDetail(i)" title="Open"><i class="bi bi-arrow-right" aria-hidden="true"></i></button></Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                </div>
            }
        }

        <!-- ── 3 · Quote Follow-up ──────────────────────────────────────────── -->
        @if (_activeQueue == "quotes")
        {
            <div class="pw-grid-card app-datagrid">
                <SfGrid TValue="WorkbenchQuoteItemVm"
                        DataSource="@FilteredQuotes()"
                        AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
                    <GridPageSettings PageSize="20" PageSizes="@(new int[] { 10, 20, 50 })" />
                    <GridColumns>
                        <GridColumn Field="@nameof(WorkbenchQuoteItemVm.RefNumber)" HeaderText="Quote #" Width="130">
                            <Template>@{ var i = (WorkbenchQuoteItemVm)context; }<span class="pw-mono">@i.RefNumber</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(WorkbenchQuoteItemVm.Name)" HeaderText="Prospect / Account" Width="220">
                            <Template>
                                @{ var i = (WorkbenchQuoteItemVm)context; }
                                <div class="pw-name-cell">
                                    <span class="pw-avatar" style="@AvatarStyle(i.CompanyName)" aria-hidden="true">@Initials(i.CompanyName)</span>
                                    <div>
                                        <div class="pw-item-name">@i.CompanyName</div>
                                        <div class="pw-item-sub">@i.Name</div>
                                    </div>
                                </div>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(WorkbenchQuoteItemVm.LobCode)"    HeaderText="LoB"     Width="90" />
                        <GridColumn Field="@nameof(WorkbenchQuoteItemVm.EstPremium)" HeaderText="Premium" Width="130" TextAlign="TextAlign.Right">
                            <Template>@{ var i = (WorkbenchQuoteItemVm)context; }<span class="pw-mono pw-bold">@i.EstPremium.ToString("C0")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(WorkbenchQuoteItemVm.QuoteExpiryDate)" HeaderText="Expires" Width="120">
                            <Template>
                                @{ var i = (WorkbenchQuoteItemVm)context; }
                                <span class="@(i.QuoteExpiryDate.HasValue && i.QuoteExpiryDate.Value <= DateTime.Today.AddDays(7) ? "pw-expiring" : "") @(i.QuoteExpiryDate.HasValue && i.QuoteExpiryDate.Value < DateTime.Today ? "pw-overdue" : "")">
                                    @(i.QuoteExpiryDate.HasValue ? i.QuoteExpiryDate.Value.ToString("d") : "—")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(WorkbenchQuoteItemVm.LastContact)" HeaderText="Last Contact" Width="130">
                            <Template>@{ var i = (WorkbenchQuoteItemVm)context; }<span>@(i.LastContact.HasValue ? FormatAge(i.LastContact.Value) : "—")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(WorkbenchQuoteItemVm.NextActionDate)" HeaderText="Follow-up By" Width="130">
                            <Template>
                                @{ var i = (WorkbenchQuoteItemVm)context; }
                                <span class="@(i.NextActionDate.HasValue && i.NextActionDate.Value < DateTime.Today ? "pw-overdue" : "")">
                                    @(i.NextActionDate.HasValue ? i.NextActionDate.Value.ToString("d") : "—")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn HeaderText="" Width="100" TextAlign="TextAlign.Right">
                            <Template>
                                @{ var i = (WorkbenchQuoteItemVm)context; }
                                <div class="pw-row-actions">
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => LogContactAsync(i)" title="Log contact">
                                        <i class="bi bi-telephone" aria-hidden="true"></i>
                                    </button>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenDetail(i)" title="Open">
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        }

        <!-- ── 4 · Renewal Call List ────────────────────────────────────────── -->
        @if (_activeQueue == "renewals")
        {
            <div class="pw-grid-card app-datagrid">
                <SfGrid TValue="WorkbenchRenewalItemVm"
                        DataSource="@FilteredRenewals()"
                        AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
                    <GridPageSettings PageSize="20" PageSizes="@(new int[] { 10, 20, 50 })" />
                    <GridColumns>
                        <GridColumn Field="@nameof(WorkbenchRenewalItemVm.RenewalStage)" HeaderText="Stage" Width="140">
                            <Template>@{ var i = (WorkbenchRenewalItemVm)context; }<span class="@StageBadge(i.RenewalStage)">@i.RenewalStage</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(WorkbenchRenewalItemVm.CompanyName)" HeaderText="Account" Width="210">
                            <Template>
                                @{ var i = (WorkbenchRenewalItemVm)context; }
                                <div class="pw-name-cell">
                                    <span class="pw-avatar" style="@AvatarStyle(i.CompanyName)" aria-hidden="true">@Initials(i.CompanyName)</span>
                                    <div>
                                        <div class="pw-item-name">@i.CompanyName</div>
                                        <div class="pw-item-sub pw-mono">@i.PolicyNumber</div>
                                    </div>
                                </div>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(WorkbenchRenewalItemVm.LobCode)"    HeaderText="LoB"     Width="90" />
                        <GridColumn Field="@nameof(WorkbenchRenewalItemVm.EstPremium)" HeaderText="Premium" Width="130" TextAlign="TextAlign.Right">
                            <Template>@{ var i = (WorkbenchRenewalItemVm)context; }<span class="pw-mono pw-bold">@i.EstPremium.ToString("C0")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(WorkbenchRenewalItemVm.ExpiryDate)" HeaderText="Renewal Date" Width="130">
                            <Template>
                                @{ var i = (WorkbenchRenewalItemVm)context; }
                                @if (i.ExpiryDate.HasValue)
                                {
                                    var daysToExp = (i.ExpiryDate.Value - DateTime.Today).Days;
                                    <span class="@(daysToExp <= 30 ? "pw-expiring" : "")">
                                        @i.ExpiryDate.Value.ToString("d")
                                        <small class="pw-days-away">(@daysToExp d)</small>
                                    </span>
                                }
                                else { <span>—</span> }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(WorkbenchRenewalItemVm.LastContact)" HeaderText="Last Contact" Width="130">
                            <Template>@{ var i = (WorkbenchRenewalItemVm)context; }<span>@(i.LastContact.HasValue ? FormatAge(i.LastContact.Value) : "—")</span></Template>
                        </GridColumn>
                        <GridColumn HeaderText="" Width="100" TextAlign="TextAlign.Right">
                            <Template>
                                @{ var i = (WorkbenchRenewalItemVm)context; }
                                <div class="pw-row-actions">
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => LogContactAsync(i)" title="Log call">
                                        <i class="bi bi-telephone" aria-hidden="true"></i>
                                    </button>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenDetail(i)" title="Open">
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        }

        <!-- ── 5 · Cross-sell List ──────────────────────────────────────────── -->
        @if (_activeQueue == "cross-sell")
        {
            @if (_crossSellList.Count == 0)
            {
                <div class="pw-empty">
                    <i class="bi bi-arrows-expand pw-empty-icon" aria-hidden="true"></i>
                    <span>No cross-sell opportunities identified yet</span>
                </div>
            }
            else
            {
                <div class="pw-grid-card app-datagrid">
                    <SfGrid TValue="WorkbenchCrossSellItemVm"
                            DataSource="@FilteredCrossSell()"
                            AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
                        <GridPageSettings PageSize="20" PageSizes="@(new int[] { 10, 20, 50 })" />
                        <GridColumns>
                            <GridColumn Field="@nameof(WorkbenchCrossSellItemVm.CompanyName)" HeaderText="Account" Width="220">
                                <Template>
                                    @{ var i = (WorkbenchCrossSellItemVm)context; }
                                    <div class="pw-name-cell">
                                        <span class="pw-avatar" style="@AvatarStyle(i.CompanyName)" aria-hidden="true">@Initials(i.CompanyName)</span>
                                        <div>
                                            <div class="pw-item-name">@i.CompanyName</div>
                                            <div class="pw-item-sub">@i.Name</div>
                                        </div>
                                    </div>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(WorkbenchCrossSellItemVm.CurrentLobs)"     HeaderText="Current LoBs" Width="160" />
                            <GridColumn Field="@nameof(WorkbenchCrossSellItemVm.LobCode)"         HeaderText="Target LoB"   Width="130">
                                <Template>@{ var i = (WorkbenchCrossSellItemVm)context; }<span class="pw-lob-badge">@i.LobCode</span></Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(WorkbenchCrossSellItemVm.EstPremium)"      HeaderText="Opp. Premium" Width="140" TextAlign="TextAlign.Right">
                                <Template>@{ var i = (WorkbenchCrossSellItemVm)context; }<span class="pw-mono pw-bold">@i.EstPremium.ToString("C0")</span></Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(WorkbenchCrossSellItemVm.CrossSellScore)"  HeaderText="Score"        Width="100" TextAlign="TextAlign.Right">
                                <Template>
                                    @{ var i = (WorkbenchCrossSellItemVm)context; }
                                    <div class="pw-score-wrap" title="Propensity score: @i.CrossSellScore">
                                        <div class="pw-score-bar" style="width:@i.CrossSellScore.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%;background:@ScoreColor(i.CrossSellScore)"></div>
                                        <span class="pw-score-val">@i.CrossSellScore.ToString("F0")</span>
                                    </div>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(WorkbenchCrossSellItemVm.CrossSellReason)" HeaderText="Trigger"      Width="200" />
                            <GridColumn Field="@nameof(WorkbenchCrossSellItemVm.LastContact)"     HeaderText="Last Contact" Width="130">
                                <Template>@{ var i = (WorkbenchCrossSellItemVm)context; }<span>@(i.LastContact.HasValue ? FormatAge(i.LastContact.Value) : "—")</span></Template>
                            </GridColumn>
                            <GridColumn HeaderText="" Width="100" TextAlign="TextAlign.Right">
                                <Template>
                                    @{ var i = (WorkbenchCrossSellItemVm)context; }
                                    <div class="pw-row-actions">
                                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => LogContactAsync(i)" title="Log contact">
                                            <i class="bi bi-telephone" aria-hidden="true"></i>
                                        </button>
                                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenDetail(i)" title="Open">
                                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                </div>
            }
        }

        <!-- ── 6 · Unread Messages ───────────────────────────────────────────── -->
        @if (_activeQueue == "messages")
        {
            <div class="pw-message-list">
                @if (_messages.Count == 0)
                {
                    <div class="pw-empty">
                        <i class="bi bi-chat-dots pw-empty-icon" aria-hidden="true"></i>
                        <span>No unread messages</span>
                    </div>
                }
                else
                {
                    @foreach (var msg in FilteredMessages())
                    {
                        <div class="pw-message-row @(msg.IsUnread ? "pw-message-row--unread" : "")"
                             @onclick="() => OpenMessage(msg)"
                             role="button" tabindex="0">
                            <span class="pw-msg-avatar" style="@AvatarStyle(msg.SenderName)" aria-hidden="true">@Initials(msg.SenderName)</span>
                            <div class="pw-msg-body">
                                <div class="pw-msg-header">
                                    <span class="pw-msg-sender">@msg.SenderName</span>
                                    <span class="@MessageTypeBadge(msg.MessageType)">@msg.MessageType</span>
                                    <span class="pw-msg-time">@FormatAge(msg.ReceivedAt)</span>
                                </div>
                                <div class="pw-msg-subject">@msg.Subject</div>
                                <div class="pw-msg-preview">@msg.Preview</div>
                            </div>
                            @if (msg.IsUnread)
                            {
                                <span class="pw-unread-dot" aria-label="Unread" aria-hidden="true"></span>
                            }
                        </div>
                    }
                }
            </div>
        }
    }
</div>

<!-- ── Item Detail Side Panel ────────────────────────────────────────────── -->
@if (_selectedItem is not null)
{
    <div class="pw-detail-overlay" @onclick="CloseDetail" role="button" tabindex="-1" aria-label="Close"></div>
    <div class="pw-detail-panel" role="complementary" aria-label="Item detail">
        <div class="pw-detail-header">
            <div class="pw-detail-header-top">
                @if (!string.IsNullOrEmpty(_selectedItem.Stage))
                {
                    <span class="@StageBadge(_selectedItem.Stage)">@_selectedItem.Stage</span>
                }
                @if (_selectedItem.HeatScore > 0)
                {
                    <span class="@HeatBadge(_selectedItem.HeatScore)">@HeatLabel(_selectedItem.HeatScore)</span>
                }
                <button class="um-btn um-btn-ghost um-btn-sm pw-detail-close" @onclick="CloseDetail" aria-label="Close">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h2 class="pw-detail-title">@_selectedItem.CompanyName</h2>
            <p class="pw-detail-subtitle">@_selectedItem.Name</p>
        </div>
        <div class="pw-detail-body">
            @if (!string.IsNullOrEmpty(_selectedItem.RefNumber))
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Ref</span><span class="pw-mono">@_selectedItem.RefNumber</span></div>
            }
            @if (!string.IsNullOrEmpty(_selectedItem.LobCode))
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Line of Business</span><span class="pw-lob-badge">@_selectedItem.LobCode</span></div>
            }
            @if (_selectedItem.EstPremium > 0)
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Est. Premium</span><span class="pw-mono pw-bold">@_selectedItem.EstPremium.ToString("C0")</span></div>
            }
            @if (_selectedItem.WinProbPct > 0)
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Win Probability</span><span class="@WinProbClass(_selectedItem.WinProbPct)">@_selectedItem.WinProbPct.ToString("F0")%</span></div>
            }
            @if (_selectedItem.CloseDate.HasValue)
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Target Close</span><span>@_selectedItem.CloseDate.Value.ToString("d")</span></div>
            }
            @if (_selectedItem.ExpiryDate.HasValue)
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Renewal Date</span><span>@_selectedItem.ExpiryDate.Value.ToString("d")</span></div>
            }
            @if (_selectedItem.QuoteExpiryDate.HasValue)
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Quote Expires</span><span class="@(_selectedItem.QuoteExpiryDate.Value < DateTime.Today ? "pw-overdue" : "")">@_selectedItem.QuoteExpiryDate.Value.ToString("d")</span></div>
            }
            @if (_selectedItem.LastContact.HasValue)
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Last Contact</span><span>@FormatAge(_selectedItem.LastContact.Value)</span></div>
            }
            @if (_selectedItem.NextActionDate.HasValue)
            {
                <div class="pw-detail-row">
                    <span class="pw-detail-label">Next Action</span>
                    <span class="@(_selectedItem.NextActionDate.Value < DateTime.Today ? "pw-overdue" : "")">
                        @_selectedItem.NextActionDate.Value.ToString("d")
                    </span>
                </div>
            }
            @if (!string.IsNullOrEmpty(_selectedItem.NextAction))
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Action</span><span>@_selectedItem.NextAction</span></div>
            }
            @if (!string.IsNullOrEmpty(_selectedItem.CrossSellReason))
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Trigger</span><span>@_selectedItem.CrossSellReason</span></div>
            }
            @if (!string.IsNullOrEmpty(_selectedItem.Notes))
            {
                <div class="pw-detail-row pw-detail-row--col">
                    <span class="pw-detail-label">Notes</span>
                    <p class="pw-detail-notes">@_selectedItem.Notes</p>
                </div>
            }
        </div>
        <div class="pw-detail-footer">
            <button class="um-btn um-btn-ghost" @onclick="() => LogContactAsync(_selectedItem)">
                <i class="bi bi-telephone" aria-hidden="true"></i> Log Contact
            </button>
            <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selectedItem.DetailUrl)">
                Open Record <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </div>
    </div>
}

<!-- ── Message viewer ─────────────────────────────────────────────────────── -->
@if (_selectedMessage is not null)
{
    <div class="pw-detail-overlay" @onclick="CloseMessage" role="button" tabindex="-1" aria-label="Close message"></div>
    <div class="pw-detail-panel" role="complementary" aria-label="Message">
        <div class="pw-detail-header">
            <div class="pw-detail-header-top">
                <span class="@MessageTypeBadge(_selectedMessage.MessageType)">@_selectedMessage.MessageType</span>
                <button class="um-btn um-btn-ghost um-btn-sm pw-detail-close" @onclick="CloseMessage" aria-label="Close">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h2 class="pw-detail-title">@_selectedMessage.Subject</h2>
            <p class="pw-detail-subtitle">From: @_selectedMessage.SenderName · @FormatAge(_selectedMessage.ReceivedAt)</p>
