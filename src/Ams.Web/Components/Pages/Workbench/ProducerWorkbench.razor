@page "/workbench/producer"
@namespace Ams.Web.Components.Pages.Workbench
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Producer Workbench</PageTitle>

<AppPageHeader Title="Producer Workbench"
               Subtitle="Your personal revenue pipeline — leads, opportunities, quotes, renewals, cross-sell targets and unread messages"
               Icon="bi-person-badge">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "pw-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-ghost" @onclick="ExportAsync">
            <i class="bi bi-download" aria-hidden="true"></i> Export
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/leads/new")'>
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Lead
        </button>
    </Actions>
</AppPageHeader>

<!-- ── Goal progress bar ─────────────────────────────────────────────────── -->
<div class="pw-goal-strip">
    <div class="pw-goal-card">
        <div class="pw-goal-header">
            <span class="pw-goal-label"><i class="bi bi-trophy-fill pw-icon-gold" aria-hidden="true"></i> Written Premium Goal</span>
            <span class="pw-goal-pct">@_goal.WrittenPct.ToString("F0")% of goal</span>
        </div>
        <div class="pw-goal-bar-track">
            <div class="pw-goal-bar-fill" style="width:@Math.Min(_goal.WrittenPct, 100).ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%;background:@GoalBarColor(_goal.WrittenPct)"></div>
        </div>
        <div class="pw-goal-nums">
            <span class="pw-goal-achieved">@_goal.WrittenPremium.ToString("C0")</span>
            <span class="pw-goal-target">of @_goal.GoalPremium.ToString("C0")</span>
        </div>
    </div>
    <div class="pw-goal-kpis">
        <div class="pw-mini-kpi">
            <span class="pw-mini-value">@_goal.NewPolicies</span>
            <span class="pw-mini-label">New Policies</span>
        </div>
        <div class="pw-mini-kpi">
            <span class="pw-mini-value">@_goal.RetentionRate.ToString("F1")%</span>
            <span class="pw-mini-label">Retention</span>
        </div>
        <div class="pw-mini-kpi">
            <span class="pw-mini-value">@_goal.PipelineValue.ToString("C0")</span>
            <span class="pw-mini-label">Pipeline</span>
        </div>
        <div class="pw-mini-kpi @(_goal.UnreadMessages > 0 ? "pw-mini-kpi--alert" : "")">
            <span class="pw-mini-value">@_goal.UnreadMessages</span>
            <span class="pw-mini-label">Unread Messages</span>
        </div>
    </div>
</div>

<!-- ── KPI strip ─────────────────────────────────────────────────────────── -->
<div class="pw-kpi-strip">
    <div class="@KpiClass(1)" @onclick="() => SetQueueFocus(1)" role="button" tabindex="0" aria-label="Assigned Leads">
        <span class="pw-kpi-icon pw-kpi-icon--leads"><i class="bi bi-person-plus-fill" aria-hidden="true"></i></span>
        <div class="pw-kpi-body">
            <div class="pw-kpi-value">@_counts.AssignedLeads</div>
            <div class="pw-kpi-label">Leads</div>
            <div class="pw-kpi-sub">@_counts.HotLeads hot</div>
        </div>
        @if (_queueFocus == 1) { <span class="pw-kpi-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass(2)" @onclick="() => SetQueueFocus(2)" role="button" tabindex="0" aria-label="Open Opportunities">
        <span class="pw-kpi-icon pw-kpi-icon--opps"><i class="bi bi-trophy-fill" aria-hidden="true"></i></span>
        <div class="pw-kpi-body">
            <div class="pw-kpi-value">@_counts.OpenOpportunities</div>
            <div class="pw-kpi-label">Opportunities</div>
            <div class="pw-kpi-sub">@_counts.OppsPremium.ToString("C0") pipeline</div>
        </div>
        @if (_queueFocus == 2) { <span class="pw-kpi-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass(3)" @onclick="() => SetQueueFocus(3)" role="button" tabindex="0" aria-label="Quote Follow-up">
        <span class="pw-kpi-icon pw-kpi-icon--quotes"><i class="bi bi-file-earmark-text-fill" aria-hidden="true"></i></span>
        <div class="pw-kpi-body">
            <div class="pw-kpi-value @(_counts.OverdueQuotes > 0 ? "pw-kpi-value--warn" : "")">@_counts.QuoteFollowups</div>
            <div class="pw-kpi-label">Quote Follow-ups</div>
            <div class="pw-kpi-sub @(_counts.OverdueQuotes > 0 ? "pw-sub--warn" : "")">@_counts.OverdueQuotes overdue</div>
        </div>
        @if (_queueFocus == 3) { <span class="pw-kpi-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass(4)" @onclick="() => SetQueueFocus(4)" role="button" tabindex="0" aria-label="Renewal Call List">
        <span class="pw-kpi-icon pw-kpi-icon--renewals"><i class="bi bi-telephone-fill" aria-hidden="true"></i></span>
        <div class="pw-kpi-body">
            <div class="pw-kpi-value">@_counts.RenewalCallList</div>
            <div class="pw-kpi-label">Renewal Calls</div>
            <div class="pw-kpi-sub">@_counts.RenewalsThisMonth this month</div>
        </div>
        @if (_queueFocus == 4) { <span class="pw-kpi-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass(5)" @onclick="() => SetQueueFocus(5)" role="button" tabindex="0" aria-label="Cross-sell List">
        <span class="pw-kpi-icon pw-kpi-icon--crosssell"><i class="bi bi-arrows-expand" aria-hidden="true"></i></span>
        <div class="pw-kpi-body">
            <div class="pw-kpi-value">@_counts.CrossSellList</div>
            <div class="pw-kpi-label">Cross-sell</div>
            <div class="pw-kpi-sub">@_counts.CrossSellPremium.ToString("C0") potential</div>
        </div>
        @if (_queueFocus == 5) { <span class="pw-kpi-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass(6)" @onclick="() => SetQueueFocus(6)" role="button" tabindex="0" aria-label="Unread Messages">
        <span class="pw-kpi-icon pw-kpi-icon--msgs @(_counts.UnreadMessages > 0 ? "pw-kpi-icon--msgs-alert" : "")">
            <i class="bi bi-chat-dots-fill" aria-hidden="true"></i>
        </span>
        <div class="pw-kpi-body">
            <div class="pw-kpi-value @(_counts.UnreadMessages > 0 ? "pw-kpi-value--alert" : "")">@_counts.UnreadMessages</div>
            <div class="pw-kpi-label">Unread Messages</div>
        </div>
        @if (_queueFocus == 6) { <span class="pw-kpi-dot" aria-hidden="true"></span> }
    </div>
</div>

<!-- ── Queue tab bar ──────────────────────────────────────────────────────── -->
<div class="pw-queue-tabs" role="tablist" aria-label="Producer queue selector">
    @foreach (var q in _queues)
    {
        <button class="pw-queue-tab @(q.Id == _activeQueue ? "pw-queue-tab--active" : "")"
                role="tab"
                aria-selected="@(q.Id == _activeQueue)"
                @onclick="() => SetActiveQueue(q.Id)">
            <i class="@q.Icon" aria-hidden="true"></i>
            <span>@q.Label</span>
            @if (q.Badge > 0)
            {
                <span class="pw-tab-badge @(q.IsAlert ? "pw-tab-badge--alert" : "")">@q.Badge</span>
            }
        </button>
    }
</div>

<!-- ── Shared filter row ──────────────────────────────────────────────────── -->
<div class="pw-filter-row">
    <div class="pw-search-box">
        <i class="bi bi-search pw-search-icon" aria-hidden="true"></i>
        <input class="pw-search-input" type="text" placeholder="Search in queue…"
               value="@_search" @oninput="OnSearchInput" />
    </div>
    <SfDropDownList TValue="string" TItem="LabelValue"
                    DataSource="_lobOptions"
                    Placeholder="All Lines"
                    ShowClearButton="true"
                    Width="150px"
                    Value="_filterLob"
                    ValueChanged="@((string v) => { _filterLob = v; StateHasChanged(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>
    <SfDropDownList TValue="string" TItem="LabelValue"
                    DataSource="_stageOptions"
                    Placeholder="All Stages"
                    ShowClearButton="true"
                    Width="155px"
                    Value="_filterStage"
                    ValueChanged="@((string v) => { _filterStage = v; StateHasChanged(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>
    <label class="pw-toggle-label">
        <input type="checkbox" @bind="_filterHotOnly" @bind:after="StateHasChanged" />
        Hot / urgent only
    </label>
</div>

<!-- ── Queue panels ───────────────────────────────────────────────────────── -->
<div class="pw-queue-panel">

    @if (_loading)
    {
        <div class="pw-loading" aria-live="polite">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading queue…</span>
        </div>
    }
    else
    {
        <!-- ── 1 · Assigned Leads ─────────────────────────────────────────── -->
        @if (_activeQueue == "leads")
        {
            <div class="pw-grid-card app-datagrid">
                <SfGrid TValue="ProducerItem"
                        DataSource="@Filtered(_leads)"
                        AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
                    <GridPageSettings PageSize="20" PageSizes="@(new int[] { 10, 20, 50 })" />
                    <GridColumns>
                        <GridColumn HeaderText="Heat" Width="90">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <span class="@HeatBadge(i.HeatScore)">@HeatLabel(i.HeatScore)</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.Name)" HeaderText="Lead" Width="220">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <div class="pw-name-cell">
                                    <span class="pw-avatar" style="@AvatarStyle(i.Name)" aria-hidden="true">@Initials(i.Name)</span>
                                    <div>
                                        <div class="pw-item-name">@i.Name</div>
                                        <div class="pw-item-sub">@i.CompanyName</div>
                                    </div>
                                </div>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.LobCode)"    HeaderText="LoB"      Width="90" />
                        <GridColumn Field="@nameof(ProducerItem.Source)"     HeaderText="Source"   Width="120" />
                        <GridColumn Field="@nameof(ProducerItem.EstPremium)" HeaderText="Est. Premium" Width="130" TextAlign="TextAlign.Right">
                            <Template>@{ var i = (ProducerItem)context; }<span class="pw-mono">@i.EstPremium.ToString("C0")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.LastContact)" HeaderText="Last Contact" Width="130">
                            <Template>@{ var i = (ProducerItem)context; }<span>@(i.LastContact.HasValue ? FormatAge(i.LastContact.Value) : "—")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.NextAction)" HeaderText="Next Action" Width="160" />
                        <GridColumn Field="@nameof(ProducerItem.NextActionDate)" HeaderText="Due" Width="110">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <span class="@(i.NextActionDate.HasValue && i.NextActionDate.Value < DateTime.Today ? "pw-overdue" : "")">
                                    @(i.NextActionDate.HasValue ? i.NextActionDate.Value.ToString("d") : "—")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Right">
                            <Template>@{ var i = (ProducerItem)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenDetail(i)" title="Open"><i class="bi bi-arrow-right" aria-hidden="true"></i></button></Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        }

        <!-- ── 2 · Open Opportunities ──────────────────────────────────────── -->
        @if (_activeQueue == "opportunities")
        {
            <div class="pw-grid-card app-datagrid">
                <SfGrid TValue="ProducerItem"
                        DataSource="@Filtered(_opportunities)"
                        AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
                    <GridPageSettings PageSize="20" PageSizes="@(new int[] { 10, 20, 50 })" />
                    <GridColumns>
                        <GridColumn Field="@nameof(ProducerItem.Stage)" HeaderText="Stage" Width="140">
                            <Template>@{ var i = (ProducerItem)context; }<span class="@StageBadge(i.Stage)">@i.Stage</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.Name)" HeaderText="Opportunity" Width="220">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <div class="pw-name-cell">
                                    <span class="pw-avatar" style="@AvatarStyle(i.CompanyName)" aria-hidden="true">@Initials(i.CompanyName)</span>
                                    <div>
                                        <div class="pw-item-name">@i.Name</div>
                                        <div class="pw-item-sub">@i.CompanyName</div>
                                    </div>
                                </div>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.LobCode)"    HeaderText="LoB"        Width="90" />
                        <GridColumn Field="@nameof(ProducerItem.EstPremium)" HeaderText="Est. Premium" Width="130" TextAlign="TextAlign.Right">
                            <Template>@{ var i = (ProducerItem)context; }<span class="pw-mono pw-bold">@i.EstPremium.ToString("C0")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.WinProbPct)" HeaderText="Win %" Width="90" TextAlign="TextAlign.Right">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <span class="@WinProbClass(i.WinProbPct)">@i.WinProbPct.ToString("F0")%</span>
                            </Template>
                        </GridColumn>
                        <GridColumn HeaderText="Weighted" Width="130" TextAlign="TextAlign.Right">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <span class="pw-mono">@((i.EstPremium * (decimal)(i.WinProbPct / 100)).ToString("C0"))</span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.CloseDate)" HeaderText="Target Close" Width="130">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <span class="@(i.CloseDate.HasValue && i.CloseDate.Value < DateTime.Today ? "pw-overdue" : "")">
                                    @(i.CloseDate.HasValue ? i.CloseDate.Value.ToString("d") : "—")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.NextAction)" HeaderText="Next Step" Width="160" />
                        <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Right">
                            <Template>@{ var i = (ProducerItem)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenDetail(i)" title="Open"><i class="bi bi-arrow-right" aria-hidden="true"></i></button></Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        }

        <!-- ── 3 · Quote Follow-up ──────────────────────────────────────────── -->
        @if (_activeQueue == "quotes")
        {
            <div class="pw-grid-card app-datagrid">
                <SfGrid TValue="ProducerItem"
                        DataSource="@Filtered(_quoteFollowups)"
                        AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
                    <GridPageSettings PageSize="20" PageSizes="@(new int[] { 10, 20, 50 })" />
                    <GridColumns>
                        <GridColumn Field="@nameof(ProducerItem.RefNumber)" HeaderText="Quote #" Width="130">
                            <Template>@{ var i = (ProducerItem)context; }<span class="pw-mono">@i.RefNumber</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.Name)" HeaderText="Prospect / Account" Width="220">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <div class="pw-name-cell">
                                    <span class="pw-avatar" style="@AvatarStyle(i.CompanyName)" aria-hidden="true">@Initials(i.CompanyName)</span>
                                    <div>
                                        <div class="pw-item-name">@i.CompanyName</div>
                                        <div class="pw-item-sub">@i.Name</div>
                                    </div>
                                </div>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.LobCode)"    HeaderText="LoB"      Width="90" />
                        <GridColumn Field="@nameof(ProducerItem.EstPremium)" HeaderText="Premium"  Width="130" TextAlign="TextAlign.Right">
                            <Template>@{ var i = (ProducerItem)context; }<span class="pw-mono pw-bold">@i.EstPremium.ToString("C0")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.QuoteExpiryDate)" HeaderText="Expires" Width="120">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <span class="@(i.QuoteExpiryDate.HasValue && i.QuoteExpiryDate.Value <= DateTime.Today.AddDays(7) ? "pw-expiring" : "")">
                                    @(i.QuoteExpiryDate.HasValue ? i.QuoteExpiryDate.Value.ToString("d") : "—")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.LastContact)" HeaderText="Last Contact" Width="130">
                            <Template>@{ var i = (ProducerItem)context; }<span>@(i.LastContact.HasValue ? FormatAge(i.LastContact.Value) : "—")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.NextActionDate)" HeaderText="Follow-up By" Width="130">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <span class="@(i.NextActionDate.HasValue && i.NextActionDate.Value < DateTime.Today ? "pw-overdue" : "")">
                                    @(i.NextActionDate.HasValue ? i.NextActionDate.Value.ToString("d") : "—")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn HeaderText="" Width="100" TextAlign="TextAlign.Right">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <div class="pw-row-actions">
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => LogContactAsync(i)" title="Log contact">
                                        <i class="bi bi-telephone" aria-hidden="true"></i>
                                    </button>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenDetail(i)" title="Open">
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        }

        <!-- ── 4 · Renewal Call List ────────────────────────────────────────── -->
        @if (_activeQueue == "renewals")
        {
            <div class="pw-grid-card app-datagrid">
                <SfGrid TValue="ProducerItem"
                        DataSource="@Filtered(_renewalCallList)"
                        AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
                    <GridPageSettings PageSize="20" PageSizes="@(new int[] { 10, 20, 50 })" />
                    <GridColumns>
                        <GridColumn Field="@nameof(ProducerItem.RenewalStage)" HeaderText="Stage" Width="140">
                            <Template>@{ var i = (ProducerItem)context; }<span class="@StageBadge(i.RenewalStage)">@i.RenewalStage</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.CompanyName)" HeaderText="Account" Width="210">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <div class="pw-name-cell">
                                    <span class="pw-avatar" style="@AvatarStyle(i.CompanyName)" aria-hidden="true">@Initials(i.CompanyName)</span>
                                    <div>
                                        <div class="pw-item-name">@i.CompanyName</div>
                                        <div class="pw-item-sub pw-mono">@i.PolicyNumber</div>
                                    </div>
                                </div>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.LobCode)"    HeaderText="LoB"      Width="90" />
                        <GridColumn Field="@nameof(ProducerItem.EstPremium)" HeaderText="Premium"  Width="130" TextAlign="TextAlign.Right">
                            <Template>@{ var i = (ProducerItem)context; }<span class="pw-mono pw-bold">@i.EstPremium.ToString("C0")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.ExpiryDate)" HeaderText="Expiry" Width="120">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                @if (i.ExpiryDate.HasValue)
                                {
                                    var daysToExp = (i.ExpiryDate.Value - DateTime.Today).Days;
                                    <span class="@(daysToExp <= 30 ? "pw-expiring" : "")">
                                        @i.ExpiryDate.Value.ToString("d")
                                        <small class="pw-days-away">(@daysToExp d)</small>
                                    </span>
                                }
                                else { <span>—</span> }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.LastContact)" HeaderText="Last Contact" Width="130">
                            <Template>@{ var i = (ProducerItem)context; }<span>@(i.LastContact.HasValue ? FormatAge(i.LastContact.Value) : "—")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.NextActionDate)" HeaderText="Call By" Width="110">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <span class="@(i.NextActionDate.HasValue && i.NextActionDate.Value < DateTime.Today ? "pw-overdue" : "")">
                                    @(i.NextActionDate.HasValue ? i.NextActionDate.Value.ToString("d") : "—")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn HeaderText="" Width="100" TextAlign="TextAlign.Right">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <div class="pw-row-actions">
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => LogContactAsync(i)" title="Log call">
                                        <i class="bi bi-telephone" aria-hidden="true"></i>
                                    </button>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenDetail(i)" title="Open">
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        }

        <!-- ── 5 · Cross-sell List ──────────────────────────────────────────── -->
        @if (_activeQueue == "cross-sell")
        {
            <div class="pw-grid-card app-datagrid">
                <SfGrid TValue="ProducerItem"
                        DataSource="@Filtered(_crossSellList)"
                        AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
                    <GridPageSettings PageSize="20" PageSizes="@(new int[] { 10, 20, 50 })" />
                    <GridColumns>
                        <GridColumn Field="@nameof(ProducerItem.CompanyName)" HeaderText="Account" Width="220">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <div class="pw-name-cell">
                                    <span class="pw-avatar" style="@AvatarStyle(i.CompanyName)" aria-hidden="true">@Initials(i.CompanyName)</span>
                                    <div>
                                        <div class="pw-item-name">@i.CompanyName</div>
                                        <div class="pw-item-sub">@i.Name</div>
                                    </div>
                                </div>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.CurrentLobs)" HeaderText="Current LoBs" Width="160" />
                        <GridColumn Field="@nameof(ProducerItem.LobCode)" HeaderText="Target LoB" Width="130">
                            <Template>@{ var i = (ProducerItem)context; }<span class="pw-lob-badge">@i.LobCode</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.EstPremium)" HeaderText="Opp. Premium" Width="140" TextAlign="TextAlign.Right">
                            <Template>@{ var i = (ProducerItem)context; }<span class="pw-mono pw-bold">@i.EstPremium.ToString("C0")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.CrossSellScore)" HeaderText="Score" Width="100" TextAlign="TextAlign.Right">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <div class="pw-score-wrap" title="Propensity score: @i.CrossSellScore">
                                    <div class="pw-score-bar" style="width:@i.CrossSellScore.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%;background:@ScoreColor(i.CrossSellScore)"></div>
                                    <span class="pw-score-val">@i.CrossSellScore.ToString("F0")</span>
                                </div>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(ProducerItem.CrossSellReason)" HeaderText="Trigger" Width="200" />
                        <GridColumn Field="@nameof(ProducerItem.LastContact)" HeaderText="Last Contact" Width="130">
                            <Template>@{ var i = (ProducerItem)context; }<span>@(i.LastContact.HasValue ? FormatAge(i.LastContact.Value) : "—")</span></Template>
                        </GridColumn>
                        <GridColumn HeaderText="" Width="100" TextAlign="TextAlign.Right">
                            <Template>
                                @{ var i = (ProducerItem)context; }
                                <div class="pw-row-actions">
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => LogContactAsync(i)" title="Log contact">
                                        <i class="bi bi-telephone" aria-hidden="true"></i>
                                    </button>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenDetail(i)" title="Open">
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        }

        <!-- ── 6 · Unread Messages ───────────────────────────────────────────── -->
        @if (_activeQueue == "messages")
        {
            <div class="pw-message-list">
                @if (_messages.Count == 0)
                {
                    <div class="pw-empty">
                        <i class="bi bi-chat-dots pw-empty-icon" aria-hidden="true"></i>
                        <span>No unread messages</span>
                    </div>
                }
                else
                {
                    @foreach (var msg in FilteredMessages())
                    {
                        <div class="pw-message-row @(msg.IsUnread ? "pw-message-row--unread" : "")"
                             @onclick="() => OpenMessage(msg)"
                             role="button" tabindex="0">
                            <span class="pw-msg-avatar" style="@AvatarStyle(msg.SenderName)" aria-hidden="true">@Initials(msg.SenderName)</span>
                            <div class="pw-msg-body">
                                <div class="pw-msg-header">
                                    <span class="pw-msg-sender">@msg.SenderName</span>
                                    <span class="@MessageTypeBadge(msg.MessageType)">@msg.MessageType</span>
                                    <span class="pw-msg-time">@FormatAge(msg.ReceivedAt)</span>
                                </div>
                                <div class="pw-msg-subject">@msg.Subject</div>
                                <div class="pw-msg-preview">@msg.Preview</div>
                            </div>
                            @if (msg.IsUnread)
                            {
                                <span class="pw-unread-dot" aria-label="Unread" aria-hidden="true"></span>
                            }
                        </div>
                    }
                }
            </div>
        }
    }
</div>

<!-- ── Item Detail Side Panel ────────────────────────────────────────────── -->
@if (_selectedItem is not null)
{
    <div class="pw-detail-overlay" @onclick="CloseDetail" role="button" tabindex="-1" aria-label="Close"></div>
    <div class="pw-detail-panel" role="complementary" aria-label="Item detail">
        <div class="pw-detail-header">
            <div class="pw-detail-header-top">
                @if (!string.IsNullOrEmpty(_selectedItem.Stage))
                {
                    <span class="@StageBadge(_selectedItem.Stage)">@_selectedItem.Stage</span>
                }
                <span class="@HeatBadge(_selectedItem.HeatScore)">@HeatLabel(_selectedItem.HeatScore)</span>
                <button class="um-btn um-btn-ghost um-btn-sm pw-detail-close" @onclick="CloseDetail" aria-label="Close">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h2 class="pw-detail-title">@_selectedItem.CompanyName</h2>
            <p class="pw-detail-subtitle">@_selectedItem.Name</p>
        </div>
        <div class="pw-detail-body">
            @if (!string.IsNullOrEmpty(_selectedItem.RefNumber))
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Ref</span><span class="pw-mono">@_selectedItem.RefNumber</span></div>
            }
            @if (!string.IsNullOrEmpty(_selectedItem.LobCode))
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Line of Business</span><span class="pw-lob-badge">@_selectedItem.LobCode</span></div>
            }
            @if (_selectedItem.EstPremium > 0)
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Est. Premium</span><span class="pw-mono pw-bold">@_selectedItem.EstPremium.ToString("C0")</span></div>
            }
            @if (_selectedItem.WinProbPct > 0)
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Win Probability</span><span class="@WinProbClass(_selectedItem.WinProbPct)">@_selectedItem.WinProbPct.ToString("F0")%</span></div>
            }
            @if (_selectedItem.CloseDate.HasValue)
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Target Close</span><span>@_selectedItem.CloseDate.Value.ToString("d")</span></div>
            }
            @if (_selectedItem.ExpiryDate.HasValue)
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Policy Expiry</span><span>@_selectedItem.ExpiryDate.Value.ToString("d")</span></div>
            }
            @if (_selectedItem.LastContact.HasValue)
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Last Contact</span><span>@FormatAge(_selectedItem.LastContact.Value)</span></div>
            }
            @if (_selectedItem.NextActionDate.HasValue)
            {
                <div class="pw-detail-row">
                    <span class="pw-detail-label">Next Action</span>
                    <span class="@(_selectedItem.NextActionDate.Value < DateTime.Today ? "pw-overdue" : "")">
                        @_selectedItem.NextActionDate.Value.ToString("d")
                    </span>
                </div>
            }
            @if (!string.IsNullOrEmpty(_selectedItem.NextAction))
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Action</span><span>@_selectedItem.NextAction</span></div>
            }
            @if (!string.IsNullOrEmpty(_selectedItem.CrossSellReason))
            {
                <div class="pw-detail-row"><span class="pw-detail-label">Trigger</span><span>@_selectedItem.CrossSellReason</span></div>
            }
            @if (!string.IsNullOrEmpty(_selectedItem.Notes))
            {
                <div class="pw-detail-row pw-detail-row--col">
                    <span class="pw-detail-label">Notes</span>
                    <p class="pw-detail-notes">@_selectedItem.Notes</p>
                </div>
            }
        </div>
        <div class="pw-detail-footer">
            <button class="um-btn um-btn-ghost" @onclick="() => LogContactAsync(_selectedItem)">
                <i class="bi bi-telephone" aria-hidden="true"></i> Log Contact
            </button>
            <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selectedItem.DetailUrl)">
                Open Record <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </div>
    </div>
}

<!-- ── Message viewer ─────────────────────────────────────────────────────── -->
@if (_selectedMessage is not null)
{
    <div class="pw-detail-overlay" @onclick="CloseMessage" role="button" tabindex="-1" aria-label="Close message"></div>
    <div class="pw-detail-panel" role="complementary" aria-label="Message">
        <div class="pw-detail-header">
            <div class="pw-detail-header-top">
                <span class="@MessageTypeBadge(_selectedMessage.MessageType)">@_selectedMessage.MessageType</span>
                <button class="um-btn um-btn-ghost um-btn-sm pw-detail-close" @onclick="CloseMessage" aria-label="Close">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h2 class="pw-detail-title">@_selectedMessage.Subject</h2>
            <p class="pw-detail-subtitle">From: @_selectedMessage.SenderName · @FormatAge(_selectedMessage.ReceivedAt)</p>
        </div>
        <div class="pw-detail-body pw-msg-viewer">
            <p>@_selectedMessage.Body</p>
        </div>
        <div class="pw-detail-footer">
            <button class="um-btn um-btn-ghost" @onclick="CloseMessage">Close</button>
            <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selectedMessage.AccountUrl)">
                Open Account <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </div>
    </div>
}

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;

    // ── State ─────────────────────────────────────────────────────────────────────
    private bool          _loading         = false;
    private string        _activeQueue     = "leads";
    private int           _queueFocus      = 0;
    private ProducerItem? _selectedItem    = null;
    private MessageItem?  _selectedMessage = null;

    // ── Filters ───────────────────────────────────────────────────────────────────
    private string _search       = string.Empty;
    private string _filterLob    = string.Empty;
    private string _filterStage  = string.Empty;
    private bool   _filterHotOnly = false;

    // ── Goal / KPI data ───────────────────────────────────────────────────────────
    private ProducerGoal _goal = new();
    private QueueCounts  _counts = new();

    // ── Queue data ────────────────────────────────────────────────────────────────
    private List<ProducerItem> _leads          = [];
    private List<ProducerItem> _opportunities  = [];
    private List<ProducerItem> _quoteFollowups = [];
    private List<ProducerItem> _renewalCallList = [];
    private List<ProducerItem> _crossSellList  = [];
    private List<MessageItem>  _messages       = [];

    // ── Queue tab definitions ─────────────────────────────────────────────────────
    private List<QueueTab> _queues => [
        new("leads",         "Leads",            "bi bi-person-plus-fill",       _counts.AssignedLeads,      false),
        new("opportunities", "Opportunities",    "bi bi-trophy-fill",             _counts.OpenOpportunities,  false),
        new("quotes",        "Quote Follow-ups", "bi bi-file-earmark-text-fill",  _counts.QuoteFollowups,     _counts.OverdueQuotes > 0),
        new("renewals",      "Renewal Calls",    "bi bi-telephone-fill",          _counts.RenewalCallList,    false),
        new("cross-sell",    "Cross-sell",       "bi bi-arrows-expand",           _counts.CrossSellList,      false),
        new("messages",      "Messages",         "bi bi-chat-dots-fill",          _counts.UnreadMessages,     _counts.UnreadMessages > 0),
    ];

    // ── Static options ────────────────────────────────────────────────────────────
    private static readonly List<LabelValue> _lobOptions =
    [
        new("BOP", "BOP"), new("GL", "GL"), new("WC", "WC"),
        new("CA",  "CA"),  new("CPP","CPP"),new("PL", "PL"),
        new("CY",  "CY"),  new("IM", "IM"),
    ];

    private static readonly List<LabelValue> _stageOptions =
    [
        new("Prospect",    "Prospect"),
        new("Quoted",      "Quoted"),
        new("Presented",   "Presented"),
        new("Negotiating", "Negotiating"),
        new("Won",         "Won"),
        new("Lost",        "Lost"),
    ];

    // ── Lifecycle ─────────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",               "/"),
            new("Producer Workbench", "/workbench/producer"));
        await LoadAsync();
    }

    // ── Loading ───────────────────────────────────────────────────────────────────
    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            // TODO: Api.GetProducerWorkbenchAsync(_tenantId)
            await Task.Delay(0);

            _leads           = [];
            _opportunities   = [];
            _quoteFollowups  = [];
            _renewalCallList = [];
            _crossSellList   = [];
            _messages        = [];

            _goal   = new();
            _counts = new();
        }
        finally { _loading = false; }
    }

    private async Task ExportAsync() =>
        await ShowToastAsync("Export: not yet implemented.", "e-toast-info");

    // ── Filtering ─────────────────────────────────────────────────────────────────
    private List<ProducerItem> Filtered(List<ProducerItem> src) => src.Where(i =>
        (string.IsNullOrEmpty(_filterLob)   || i.LobCode == _filterLob) &&
        (string.IsNullOrEmpty(_filterStage) || i.Stage == _filterStage || i.RenewalStage == _filterStage) &&
        (!_filterHotOnly || i.HeatScore >= 70) &&
        (string.IsNullOrEmpty(_search) ||
         i.Name.Contains(_search,        StringComparison.OrdinalIgnoreCase) ||
         i.CompanyName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         i.RefNumber.Contains(_search,   StringComparison.OrdinalIgnoreCase))
    ).ToList();

    private List<MessageItem> FilteredMessages() => _messages.Where(m =>
        string.IsNullOrEmpty(_search) ||
        m.SenderName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        m.Subject.Contains(_search,    StringComparison.OrdinalIgnoreCase) ||
        m.Preview.Contains(_search,    StringComparison.OrdinalIgnoreCase)
    ).ToList();

    private void OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    // ── Queue navigation ──────────────────────────────────────────────────────────
    private void SetActiveQueue(string id)
    {
        _activeQueue     = id;
        _queueFocus      = 0;
        _selectedItem    = null;
        _selectedMessage = null;
    }

    private void SetQueueFocus(int n)
    {
        _queueFocus      = _queueFocus == n ? 0 : n;
        _activeQueue     = n switch { 1 => "leads", 2 => "opportunities", 3 => "quotes", 4 => "renewals", 5 => "cross-sell", 6 => "messages", _ => _activeQueue };
        _selectedItem    = null;
        _selectedMessage = null;
    }

    private string KpiClass(int n) =>
        "pw-kpi-card" + (_queueFocus == n || (_queueFocus == 0 && _activeQueue == QueueIdForKpi(n)) ? " pw-kpi-card--active" : "");

    private static string QueueIdForKpi(int n) => n switch
    {
        1 => "leads", 2 => "opportunities", 3 => "quotes",
        4 => "renewals", 5 => "cross-sell", 6 => "messages",
        _ => string.Empty,
    };

    // ── Item / message actions ────────────────────────────────────────────────────
    private void OpenDetail(ProducerItem item)    { _selectedItem    = item; _selectedMessage = null; }
    private void CloseDetail()                    => _selectedItem    = null;
    private void OpenMessage(MessageItem msg)     { _selectedMessage = msg;  _selectedItem    = null; msg.IsUnread = false; }
    private void CloseMessage()                   => _selectedMessage = null;

    private async Task LogContactAsync(ProducerItem item)
    {
        // TODO: Api.LogProducerContactAsync(_tenantId, item.ItemId)
        await Task.Delay(0);
        await ShowToastAsync($"Contact logged for {item.CompanyName}.", "e-toast-success");
    }

    // ── Toast ─────────────────────────────────────────────────────────────────────
    private async Task ShowToastAsync(string msg, string cssClass = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = cssClass });
    }

    // ── Helpers ───────────────────────────────────────────────────────────────────
    private static string HeatBadge(double score) => score >= 80
        ? "pw-heat-badge pw-heat-badge--hot"
        : score >= 50 ? "pw-heat-badge pw-heat-badge--warm" : "pw-heat-badge pw-heat-badge--cold";

    private static string HeatLabel(double score) =>
        score >= 80 ? "🔥 Hot" : score >= 50 ? "Warm" : "Cold";

    private static string StageBadge(string? s) => s switch
    {
        "Prospect"    => "pw-stage-badge pw-stage-badge--prospect",
        "Quoted"      => "pw-stage-badge pw-stage-badge--quoted",
        "Presented"   => "pw-stage-badge pw-stage-badge--presented",
        "Negotiating" => "pw-stage-badge pw-stage-badge--negotiating",
        "Won"         => "pw-stage-badge pw-stage-badge--won",
        "Lost"        => "pw-stage-badge pw-stage-badge--lost",
        _             => "pw-stage-badge",
    };

    private static string WinProbClass(double p) =>
        p >= 70 ? "pw-prob-high" : p >= 40 ? "pw-prob-mid" : "pw-prob-low";

    private static string ScoreColor(double s) =>
        s >= 75 ? "#22c55e" : s >= 50 ? "#eab308" : "#f97316";

    private static string GoalBarColor(double p) =>
        p >= 100 ? "#22c55e" : p >= 75 ? "#3b82f6" : p >= 50 ? "#eab308" : "#f97316";

    private static string MessageTypeBadge(string t) => t switch
    {
        "Email"  => "pw-msg-type pw-msg-type--email",
        "Portal" => "pw-msg-type pw-msg-type--portal",
        "SMS"    => "pw-msg-type pw-msg-type--sms",
        "Note"   => "pw-msg-type pw-msg-type--note",
        _        => "pw-msg-type",
    };

    private static string FormatAge(DateTime dt)
    {
        var diff = DateTime.Now - dt;
        if (diff.TotalMinutes < 1)  return "Just now";
        if (diff.TotalHours   < 1)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays    < 1)  return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 30) return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("d");
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length >= 1 ? name[..1] : "?";
    }

    private static string AvatarStyle(string name)
    {
        var hue = Math.Abs(name.GetHashCode()) % 360;
        return $"background:hsl({hue},50%,40%);color:#fff;";
    }

    // ── Models ────────────────────────────────────────────────────────────────────
    private sealed record LabelValue(string Value, string Label);
    private sealed record QueueTab(string Id, string Label, string Icon, int Badge, bool IsAlert);

    private sealed class ProducerGoal
    {
        public decimal WrittenPremium  { get; set; }
        public decimal GoalPremium     { get; set; } = 1;
        public double  WrittenPct      => GoalPremium == 0 ? 0 : (double)(WrittenPremium / GoalPremium * 100);
        public int     NewPolicies     { get; set; }
        public double  RetentionRate   { get; set; }
        public decimal PipelineValue   { get; set; }
        public int     UnreadMessages  { get; set; }
    }

    private sealed class QueueCounts
    {
        public int     AssignedLeads      { get; set; }
        public int     HotLeads           { get; set; }
        public int     OpenOpportunities  { get; set; }
        public decimal OppsPremium        { get; set; }
        public int     QuoteFollowups     { get; set; }
        public int     OverdueQuotes      { get; set; }
        public int     RenewalCallList    { get; set; }
        public int     RenewalsThisMonth  { get; set; }
        public int     CrossSellList      { get; set; }
        public decimal CrossSellPremium   { get; set; }
        public int     UnreadMessages     { get; set; }
    }

    private sealed class ProducerItem
    {
        public Guid      ItemId           { get; set; } = Guid.NewGuid();
        public string    Name             { get; set; } = string.Empty;
        public string    CompanyName      { get; set; } = string.Empty;
        public string    RefNumber        { get; set; } = string.Empty;
        public string    PolicyNumber     { get; set; } = string.Empty;
        public string    LobCode          { get; set; } = string.Empty;
        public string    CurrentLobs      { get; set; } = string.Empty;
        public string    Source           { get; set; } = string.Empty;
        public string    Stage            { get; set; } = string.Empty;
        public string    RenewalStage     { get; set; } = string.Empty;
        public decimal   EstPremium       { get; set; }
        public double    WinProbPct       { get; set; }
        public double    HeatScore        { get; set; }
        public double    CrossSellScore   { get; set; }
        public string    CrossSellReason  { get; set; } = string.Empty;
        public DateTime? LastContact      { get; set; }
        public DateTime? NextActionDate   { get; set; }
        public string    NextAction       { get; set; } = string.Empty;
        public DateTime? CloseDate        { get; set; }
        public DateTime? ExpiryDate       { get; set; }
        public DateTime? QuoteExpiryDate  { get; set; }
        public string?   Notes            { get; set; }
        public string    DetailUrl        { get; set; } = "/workbench/producer";
    }

    private sealed class MessageItem
    {
        public Guid     MessageId   { get; set; } = Guid.NewGuid();
        public string   SenderName  { get; set; } = string.Empty;
        public string   Subject     { get; set; } = string.Empty;
        public string   Preview     { get; set; } = string.Empty;
        public string   Body        { get; set; } = string.Empty;
        public string   MessageType { get; set; } = "Email";   // Email | Portal | SMS | Note
        public DateTime ReceivedAt  { get; set; } = DateTime.Now;
        public bool     IsUnread    { get; set; } = true;
        public string   AccountUrl  { get; set; } = "/workbench/producer";
    }
}
