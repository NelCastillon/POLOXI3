    </div>
}

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private readonly Guid _tenantAdminUserId = Guid.Parse("00000000-0000-0000-0000-000000000002");
    private SfToast? _toast;

    // ── State ─────────────────────────────────────────────────────────────────────
    private bool   _loading         = false;
    private string? _loadError;
    private string _activeQueue     = "leads";
    private string _oppView         = "kanban";
    private int    _queueFocus      = 0;

    private WorkbenchLeadItemVm?        _selectedItem    = null;
    private WorkbenchNotificationItemVm? _selectedMessage = null;

    // ── Filters ───────────────────────────────────────────────────────────────────
    private string _search        = string.Empty;
    private string _filterLob     = string.Empty;
    private string _filterStage   = string.Empty;
    private bool   _filterHotOnly = false;

    // ── View-model data ───────────────────────────────────────────────────────────
    private WorkbenchGoalVm    _goal   = new();
    private WorkbenchCountsVm  _counts = new();

    private List<WorkbenchLeadItemVm>         _leads          = [];
    private List<WorkbenchOppItemVm>          _opportunities  = [];
    private List<WorkbenchQuoteItemVm>        _quoteFollowups = [];
    private List<WorkbenchRenewalItemVm>      _renewalCallList = [];
    private List<WorkbenchCrossSellItemVm>    _crossSellList  = [];
    private List<WorkbenchNotificationItemVm> _messages       = [];

    // ── Queue tab definitions ─────────────────────────────────────────────────────
    private List<QueueTab> _queues => [
        new("leads",         "Leads",            "bi bi-person-plus-fill",       _counts.AssignedLeads,      false),
        new("opportunities", "Opportunities",    "bi bi-trophy-fill",             _counts.OpenOpportunities,  false),
        new("quotes",        "Quote Follow-ups", "bi bi-file-earmark-text-fill",  _counts.QuoteFollowups,     _counts.OverdueQuotes > 0),
        new("renewals",      "Renewal Calls",    "bi bi-telephone-fill",          _counts.RenewalCallList,    false),
        new("cross-sell",    "Cross-sell",       "bi bi-arrows-expand",           _counts.CrossSellList,      false),
        new("messages",      "Messages",         "bi bi-chat-dots-fill",          _counts.UnreadMessages,     _counts.UnreadMessages > 0),
    ];

    // ── Static options ────────────────────────────────────────────────────────────
    private static readonly List<LabelValue> _lobOptions =
    [
        new("BOP", "BOP"), new("GL", "GL"), new("WC", "WC"),
        new("CA",  "CA"),  new("CPP","CPP"),new("PL", "PL"),
        new("CY",  "CY"),  new("IM", "IM"),
    ];

    private static readonly List<LabelValue> _stageOptions =
    [
        new("New",         "New"),
        new("Contacted",   "Contacted"),
        new("Qualified",   "Qualified"),
        new("Prospect",    "Prospect"),
        new("Quoted",      "Quoted"),
        new("Presented",   "Presented"),
        new("Negotiating", "Negotiating"),
        new("Won",         "Won"),
        new("Lost",        "Lost"),
    ];

    private decimal WeightedPipeline => _opportunities.Sum(o => o.EstPremium * (decimal)(o.WinProbPct / 100));
    private int DueTodayOrOverdue => _leads.Count(i => i.NextActionDate.HasValue && i.NextActionDate.Value.Date <= DateTime.Today)
        + _quoteFollowups.Count(i => i.NextActionDate.HasValue && i.NextActionDate.Value.Date <= DateTime.Today)
        + _renewalCallList.Count(i => i.ExpiryDate.HasValue && i.ExpiryDate.Value.Date <= DateTime.Today.AddDays(30));
    private string BestCrossSellText => _crossSellList.OrderByDescending(x => x.CrossSellScore).FirstOrDefault() is { } item
        ? $"{item.CompanyName} · {item.LobCode}"
        : "No target yet";
    private string PriorityFocusText => _counts.OverdueQuotes > 0
        ? $"{_counts.OverdueQuotes} overdue quote follow-up(s)"
        : _counts.HotLeads > 0 ? $"{_counts.HotLeads} hot lead(s)" : "Pipeline hygiene";

    private static readonly List<LabelValue> _pipelineCols =
    [
        new("Prospect",    "Prospect"),
        new("Quoted",      "Quoted"),
        new("Presented",   "Presented"),
        new("Negotiating", "Negotiating"),
        new("Won",         "Won"),
        new("Lost",        "Lost"),
    ];

    // ── Lifecycle ─────────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",               "/"),
            new("Producer Workbench", "/workbench/producer"));
        await LoadAsync();
    }

    // ── Loading ───────────────────────────────────────────────────────────────────
    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _loadError = null;
            var dto = await WorkbenchApi.GetWorkbenchAsync(_tenantId, _tenantAdminUserId);
            if (dto is null) return;

            // ── Goal ──────────────────────────────────────────────────────
            _goal = new()
            {
                WrittenPremium = dto.Goal.WrittenPremium,
                GoalPremium    = dto.Goal.GoalPremium,
                NewPolicies    = dto.Goal.NewPolicies,
                RetentionRate  = dto.Goal.RetentionRate,
                PipelineValue  = dto.Goal.PipelineValue,
                UnreadMessages = dto.Goal.UnreadMessages,
            };

            // ── KPI counts ────────────────────────────────────────────────
            _counts = new()
            {
                AssignedLeads      = dto.Counts.AssignedLeads,
                HotLeads           = dto.Counts.HotLeads,
                OpenOpportunities  = dto.Counts.OpenOpportunities,
                OppsPremium        = dto.Counts.OppsPremium,
                QuoteFollowups     = dto.Counts.QuoteFollowups,
                OverdueQuotes      = dto.Counts.OverdueQuotes,
                RenewalCallList    = dto.Counts.RenewalCallList,
                RenewalsThisMonth  = dto.Counts.RenewalsThisMonth,
                CrossSellList      = dto.Counts.CrossSellList,
                CrossSellPremium   = dto.Counts.CrossSellPremium,
                UnreadMessages     = dto.Counts.UnreadMessages,
            };

            // ── Leads ─────────────────────────────────────────────────────
            _leads = dto.MyLeads.Select(l => new WorkbenchLeadItemVm
            {
                ItemId         = l.LeadId,
                Name           = l.FullName,
                CompanyName    = l.AccountName ?? string.Empty,
                RefNumber      = l.LeadNumber,
                LobCode        = l.InterestedService ?? string.Empty,
                Source         = l.SourceCode ?? string.Empty,
                Stage          = MapLeadStatus(l.StatusCodeId),
                EstPremium     = EstimateLeadPremium(l.InterestedService, l.Score),
                HeatScore      = l.Score ?? 0,
                LastContact    = l.LastActivityDate,
                NextAction     = l.NextAction ?? string.Empty,
                NextActionDate = l.NextActionDate,
                DetailUrl      = $"/crm/leads/{l.LeadId}",
            }).ToList();

            // ── Opportunities ─────────────────────────────────────────────
            _opportunities = dto.MyOpportunities.Select(o => new WorkbenchOppItemVm
            {
                ItemId       = o.OpportunityId,
                Name         = o.OpportunityName,
                CompanyName  = o.AccountName ?? string.Empty,
                RefNumber    = o.OpportunityNumber,
                LobCode      = MapLobFromText(o.OpportunityName),
                Stage        = NormalizePipelineStage(o.StageName, o.ForecastCategoryCode, o.StatusCodeId),
                EstPremium   = o.EstimatedAmount,
                WinProbPct   = o.WinProbability,
                CloseDate    = o.CloseDate,
                NextAction   = o.NextAction ?? string.Empty,
                DetailUrl    = $"/crm/opportunities/{o.OpportunityId}",
            }).ToList();

            // ── Quote follow-ups ──────────────────────────────────────────
            _quoteFollowups = dto.QuoteFollowups.Select(q => new WorkbenchQuoteItemVm
            {
                ItemId          = q.QuoteId,
                Name            = q.OpportunityName ?? string.Empty,
                CompanyName     = q.AccountName ?? string.Empty,
                RefNumber       = q.QuoteNumber,
                EstPremium      = q.TotalAmount,
                LobCode         = MapLobFromText(q.OpportunityName ?? q.AccountName ?? string.Empty),
                Stage           = q.StatusCode,
                QuoteExpiryDate = q.ValidUntilDate,
                NextActionDate  = q.ValidUntilDate?.AddDays(-3),
                NextAction      = q.IsExpired ? "Recover expired quote" : q.IsExpiringSoon ? "Call before quote expires" : "Follow up on presented quote",
                DetailUrl       = $"/submissions/quotes/{q.QuoteId}",
            }).ToList();

            // ── Renewals ──────────────────────────────────────────────────
            _renewalCallList = dto.RenewalCallList.Select(r => new WorkbenchRenewalItemVm
            {
                ItemId        = r.RenewalId,
                CompanyName   = r.AccountName ?? string.Empty,
                RefNumber     = r.AgreementNumber ?? string.Empty,
                PolicyNumber  = r.RenewalNumber,
                EstPremium    = r.TotalContractValue ?? 0,
                RenewalStage  = r.StatusCode,
                Stage         = r.StatusCode,
                LobCode       = MapLobFromText(r.AccountName ?? r.AgreementNumber ?? string.Empty),
                ExpiryDate    = r.NewStartDate,
                NextAction    = r.IsUrgent ? "Schedule renewal review" : "Prepare renewal touchpoint",
                NextActionDate = r.NewStartDate.AddDays(-30),
                DetailUrl     = $"/renewals/{r.RenewalId}",
            }).ToList();

            // ── Cross-sell ────────────────────────────────────────────────
            _crossSellList = dto.CrossSellList.Select(c => new WorkbenchCrossSellItemVm
            {
                ItemId           = c.AccountId,
                CompanyName      = c.AccountName,
                Name             = string.Empty,
                CurrentLobs      = c.CurrentLobs ?? string.Empty,
                LobCode          = c.TargetLob ?? string.Empty,
                EstPremium       = c.OppPremium,
                CrossSellScore   = c.Score,
                CrossSellReason  = c.Reason ?? string.Empty,
                LastContact      = c.LastContact,
                DetailUrl        = $"/accounts/{c.AccountId}",
            }).ToList();

            // ── Messages ──────────────────────────────────────────────────
            _messages = dto.Messages.Select(n => new WorkbenchNotificationItemVm
            {
                MessageId   = n.NotificationId,
                SenderName  = n.EntityName ?? "System",
                Subject     = n.Subject ?? "(no subject)",
                Preview     = n.Body.Length > 120 ? n.Body[..120] + "…" : n.Body,
                Body        = n.Body,
                MessageType = MapChannel(n.ChannelCode),
                ReceivedAt  = n.CreatedDateUtc,
                IsUnread    = !n.IsRead,
                AccountUrl  = n.EntityId.HasValue ? $"/accounts/{n.EntityId}" : "/accounts",
            }).ToList();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load producer workbench: {ex.Message}";
            await ShowToastAsync(_loadError, "e-toast-danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ExportAsync() =>
        await ShowToastAsync($"Export prepared for {_leads.Count + _opportunities.Count + _quoteFollowups.Count + _renewalCallList.Count + _crossSellList.Count} workbench rows.", "e-toast-success");

    // ── Filtering ─────────────────────────────────────────────────────────────────
    private List<WorkbenchLeadItemVm> FilteredLeads() => _leads.Where(i =>
        (string.IsNullOrEmpty(_filterLob)   || i.LobCode.Contains(_filterLob, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterStage) || i.Stage == _filterStage) &&
        (!_filterHotOnly || i.HeatScore >= 70) &&
        MatchSearch(i.Name, i.CompanyName, i.RefNumber)
    ).ToList();

    private List<WorkbenchOppItemVm> FilteredOpps() => _opportunities.Where(i =>
        (string.IsNullOrEmpty(_filterLob)   || i.LobCode.Contains(_filterLob, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterStage) || i.Stage == _filterStage) &&
        MatchSearch(i.Name, i.CompanyName, i.RefNumber)
    ).ToList();

    private List<WorkbenchQuoteItemVm> FilteredQuotes() => _quoteFollowups.Where(i =>
        (string.IsNullOrEmpty(_filterStage) || i.Stage == _filterStage) &&
        MatchSearch(i.Name, i.CompanyName, i.RefNumber)
    ).ToList();

    private List<WorkbenchRenewalItemVm> FilteredRenewals() => _renewalCallList.Where(i =>
        (string.IsNullOrEmpty(_filterStage) || i.RenewalStage == _filterStage) &&
        MatchSearch(string.Empty, i.CompanyName, i.PolicyNumber)
    ).ToList();

    private List<WorkbenchCrossSellItemVm> FilteredCrossSell() => _crossSellList.Where(i =>
        (string.IsNullOrEmpty(_filterLob) || i.LobCode.Contains(_filterLob, StringComparison.OrdinalIgnoreCase)) &&
        MatchSearch(i.Name, i.CompanyName, string.Empty)
    ).ToList();

    private List<WorkbenchNotificationItemVm> FilteredMessages() => _messages.Where(m =>
        string.IsNullOrEmpty(_search) ||
        m.SenderName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        m.Subject.Contains(_search,    StringComparison.OrdinalIgnoreCase) ||
        m.Preview.Contains(_search,    StringComparison.OrdinalIgnoreCase)
    ).ToList();

    private bool MatchSearch(string name, string company, string refNum) =>
        string.IsNullOrEmpty(_search) ||
        name.Contains(_search,    StringComparison.OrdinalIgnoreCase) ||
        company.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        refNum.Contains(_search,  StringComparison.OrdinalIgnoreCase);

    private void OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    // ── Queue navigation ──────────────────────────────────────────────────────────
    private void SetActiveQueue(string id)
    {
        _activeQueue     = id;
        _queueFocus      = 0;
        _selectedItem    = null;
        _selectedMessage = null;
    }

    private void SetQueueFocus(int n)
    {
        _queueFocus   = _queueFocus == n ? 0 : n;
        _activeQueue  = n switch { 1 => "leads", 2 => "opportunities", 3 => "quotes", 4 => "renewals", 5 => "cross-sell", 6 => "messages", _ => _activeQueue };
        _selectedItem    = null;
        _selectedMessage = null;
    }

    private string KpiClass(int n) =>
        "pw-kpi-card" + (_queueFocus == n || (_queueFocus == 0 && _activeQueue == QueueIdForKpi(n)) ? " pw-kpi-card--active" : "");

    private static string QueueIdForKpi(int n) => n switch
    {
        1 => "leads", 2 => "opportunities", 3 => "quotes",
        4 => "renewals", 5 => "cross-sell", 6 => "messages",
        _ => string.Empty,
    };

    // ── Item / message actions ────────────────────────────────────────────────────
    private void OpenDetail(WorkbenchLeadItemVm item)    { _selectedItem    = item; _selectedMessage = null; }
    private void CloseDetail()                           => _selectedItem    = null;
    private void OpenMessage(WorkbenchNotificationItemVm msg) { _selectedMessage = msg; _selectedItem = null; msg.IsUnread = false; }
    private void CloseMessage()                          => _selectedMessage = null;

    private async Task LogContactAsync(WorkbenchLeadItemVm item)
    {
        try
        {
            await WorkbenchApi.LogContactAsync(_tenantId, item.ItemId, item.ItemType);
            await ShowToastAsync($"Contact logged for {item.CompanyName}.", "e-toast-success");
        }
