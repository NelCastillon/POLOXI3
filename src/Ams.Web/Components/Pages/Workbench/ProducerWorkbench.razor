@page "/workbench/producer"
@namespace Ams.Web.Components.Pages.Workbench
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject ProducerWorkbenchApiClient WorkbenchApi
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject LeadDialogService LeadDialogs

<PageTitle>Enterprise Producer Workbench</PageTitle>

@if (_toastVisible)
{
    <div class="pwe-toast pwe-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="pwe-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showLogContact && _contactItem is not null)
{
    <div class="pwe-modal-backdrop" role="presentation" @onclick="CloseLogContact">
        <div class="pwe-modal" role="dialog" aria-modal="true" aria-labelledby="pweLogContactTitle" @onclick:stopPropagation="true">
            <EditForm Model="_contactForm" OnValidSubmit="SaveContactAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header">
                    <i class="bi bi-telephone-outbound" aria-hidden="true"></i>
                    <span id="pweLogContactTitle">Log producer contact</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseLogContact"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="um-modal-body">
                    <div class="pwe-contact-context">
                        <strong>@ContactTargetName</strong>
                        <span>@_contactItem.ItemType - @(_contactItem.RefNumber == string.Empty ? "No reference" : _contactItem.RefNumber)</span>
                        <small>Use Log Contact to record a completed producer touchpoint on the CRM lead/opportunity or account activity timeline.</small>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-form-field">
                            <label for="pweContactMethod">Contact method</label>
                            <InputSelect id="pweContactMethod" class="form-select" @bind-Value="_contactForm.ContactMethod">
                                <option value="Call">Call</option>
                                <option value="Email">Email</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Note">Note</option>
                                <option value="Other">Other</option>
                            </InputSelect>
                            <ValidationMessage For="() => _contactForm.ContactMethod" class="text-danger" />
                        </div>
                        <div class="um-form-field">
                            <label for="pweContactOutcome">Outcome</label>
                            <InputSelect id="pweContactOutcome" class="form-select" @bind-Value="_contactForm.OutcomeCode">
                                <option value="Contacted">Contacted</option>
                                <option value="Left Message">Left Message</option>
                                <option value="No Answer">No Answer</option>
                                <option value="Follow-up Needed">Follow-up Needed</option>
                                <option value="Not Interested">Not Interested</option>
                            </InputSelect>
                            <ValidationMessage For="() => _contactForm.OutcomeCode" class="text-danger" />
                        </div>
                        <div class="um-form-field um-form-field--span-2">
                            <label for="pweContactSubject">Subject</label>
                            <InputText id="pweContactSubject" class="form-control" @bind-Value="_contactForm.Subject" />
                            <ValidationMessage For="() => _contactForm.Subject" class="text-danger" />
                        </div>
                        <div class="um-form-field">
                            <label for="pweContactDuration">Duration minutes</label>
                            <InputNumber id="pweContactDuration" class="form-control" @bind-Value="_contactForm.DurationMinutes" />
                            <ValidationMessage For="() => _contactForm.DurationMinutes" class="text-danger" />
                        </div>
                        <div class="um-form-field um-form-field--span-2">
                            <label for="pweContactNotes">Notes</label>
                            <InputTextArea id="pweContactNotes" class="form-control" rows="4" @bind-Value="_contactForm.Notes" />
                            <ValidationMessage For="() => _contactForm.Notes" class="text-danger" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseLogContact" disabled="@_savingContact">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_savingContact"><i class="bi @(_savingContact ? "bi-arrow-repeat pwe-spin" : "bi-check2-circle")" aria-hidden="true"></i> Save contact</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="pwe-enterprise-page">
    <section class="pwe-hero">
        <div class="pwe-hero-left">
            <span class="pwe-hero-icon"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
            <div>
                <div class="pwe-title-row">
                    <h1>Producer Workbench</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live revenue data</span>
                    <span><i class="bi bi-person-check" aria-hidden="true"></i> Tenant Admin scoped</span>
                </div>
                <p>Manage leads, opportunities, quote follow-ups, renewals, cross-sell targets, and producer messages in one enterprise command center.</p>
            </div>
        </div>
        <div class="pwe-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh producer workbench"><i class="bi @(_loading ? "bi-arrow-repeat pwe-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-ghost" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/workbench")'><i class="bi bi-grid-1x2" aria-hidden="true"></i> Workbench</button>
            <button class="um-btn um-btn-primary" @onclick="OpenCreateLeadAsync"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Lead</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger pwe-error-banner" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="pwe-insight-strip" aria-label="Producer insights">
        <article class="pwe-insight-card pwe-insight-primary"><span class="pwe-insight-icon"><i class="bi bi-stars" aria-hidden="true"></i></span><div><small>Priority Focus</small><strong>@PriorityFocusText</strong></div></article>
        <article class="pwe-insight-card"><span class="pwe-insight-icon pwe-tone-success"><i class="bi bi-cash-coin" aria-hidden="true"></i></span><div><small>Weighted Pipeline</small><strong>@WeightedPipeline.ToString("C0", CultureInfo.CurrentCulture)</strong></div></article>
        <article class="pwe-insight-card"><span class="pwe-insight-icon pwe-tone-warning"><i class="bi bi-alarm" aria-hidden="true"></i></span><div><small>Due / Urgent</small><strong>@DueTodayOrOverdue</strong></div></article>
        <article class="pwe-insight-card"><span class="pwe-insight-icon pwe-tone-purple"><i class="bi bi-lightning-charge" aria-hidden="true"></i></span><div><small>Best Cross-sell</small><strong>@BestCrossSellText</strong></div></article>
    </section>

    <section class="pwe-goal-strip">
        <article class="pwe-goal-card">
            <div class="pwe-goal-head"><span><i class="bi bi-trophy-fill" aria-hidden="true"></i> Written Premium Goal</span><strong class="pwe-goal-pct">@GoalPercentText</strong></div>
            <div class="pwe-goal-track"><i style="width:@GoalTrackWidth;background:#f97316"></i></div>
            <div class="pwe-goal-numbers"><strong>@_goal.WrittenPremium.ToString("C0", CultureInfo.CurrentCulture)</strong><span>of @_goal.GoalPremium.ToString("C0", CultureInfo.CurrentCulture)</span></div>
        </article>
        <div class="pwe-mini-kpis">
            <article><strong>@_goal.NewPolicies</strong><span>New Policies</span></article>
            <article><strong>@_goal.RetentionRate.ToString("F1", CultureInfo.CurrentCulture)%</strong><span>Retention</span></article>
            <article><strong>@_goal.PipelineValue.ToString("C0", CultureInfo.CurrentCulture)</strong><span>Pipeline</span></article>
            <article class="@(_goal.UnreadMessages > 0 ? "pwe-mini-alert" : string.Empty)"><strong>@_goal.UnreadMessages</strong><span>Unread</span></article>
        </div>
    </section>

    <section class="pwe-kpi-strip" aria-label="Producer queue metrics">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" title="@metric.Caption" @onclick="@(() => SetActiveQueue(metric.QueueId))">
                <span class="pwe-kpi-icon @metric.Tone"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span><span class="pwe-kpi-val">@metric.Value</span><span class="pwe-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
            </button>
        }
    </section>

    <section class="pwe-workflow-strip" aria-label="Producer workflow actions">
        <button class="pwe-workflow-card" @onclick="ShowHotLeads"><i class="bi bi-fire" aria-hidden="true"></i><span><strong>Work hot leads</strong><span>Prioritize top heat scores.</span></span></button>
        <button class="pwe-workflow-card" @onclick="ShowPipeline"><i class="bi bi-kanban" aria-hidden="true"></i><span><strong>Review pipeline</strong><span>Open opportunity board.</span></span></button>
        <button class="pwe-workflow-card" @onclick="ShowOverdueQuotes"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i><span><strong>Recover quotes</strong><span>Focus overdue follow-ups.</span></span></button>
        <button class="pwe-workflow-card" @onclick="ShowMessages"><i class="bi bi-chat-dots" aria-hidden="true"></i><span><strong>Clear messages</strong><span>Review producer inbox.</span></span></button>
    </section>

    <section class="pwe-search-panel">
        <div class="pwe-search-wrap">
            <i class="bi bi-search pwe-search-icon" aria-hidden="true"></i>
            <div class="pwe-search-body">
                <label for="producerSearchInput">Search producer queue</label>
                <input id="producerSearchInput" class="pwe-search-input" value="@_search" @oninput="SearchChangedCallback" placeholder="Search names, companies, reference numbers, LoB, source, stage, action, or message..." />
                <span class="pwe-search-hint">Filters are applied to the active queue while preserving the synced producer aggregate.</span>
            </div>
        </div>
        <select class="pwe-filter-select" value="@_filterLob" @onchange="LobChangedCallback" title="Filter line of business">
            <option value="">All lines</option>
            @foreach (var option in _lobOptions)
            {
                <option value="@option.Value">@option.Label</option>
            }
        </select>
        <select class="pwe-filter-select" value="@_filterStage" @onchange="StageChangedCallback" title="Filter stage">
            <option value="">All stages</option>
            @foreach (var option in _stageOptions)
            {
                <option value="@option.Value">@option.Label</option>
            }
        </select>
        <label class="pwe-toggle"><input type="checkbox" checked="@_filterHotOnly" @onchange="HotOnlyChangedCallback" /> Hot / urgent only</label>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
        <div class="pwe-search-result"><strong>@ActiveQueueCount</strong><span>@ActiveQueueLabel</span></div>
    </section>

    <section class="pwe-view-tabs" aria-label="Producer queue tabs">
        @foreach (var q in _queues)
        {
            <button type="button" class="@QueueTabClass(q.Id)" @onclick="@(() => SetActiveQueue(q.Id))"><i class="@q.Icon" aria-hidden="true"></i> @q.Label @if (q.Badge > 0) { <span class="@(q.IsAlert ? "pwe-tab-alert" : string.Empty)">@q.Badge</span> }</button>
        }
    </section>

    <section class="pwe-content-layout">
        <main class="pwe-main-card">
            @if (_loading)
            {
                <div class="pwe-loading"><i class="bi bi-arrow-repeat pwe-spin" aria-hidden="true"></i><strong>Loading producer workbench...</strong></div>
            }
            else if (_activeQueue == "opportunities")
            {
                <div class="pwe-section-head"><div><h2>Opportunity pipeline</h2><p>Use the native board or table view to review pipeline value, stage, close date, and next action.</p></div><div class="pwe-view-switch"><button class="@PipelineViewClass("board")" @onclick='() => _oppView = "board"'><i class="bi bi-kanban"></i> Board</button><button class="@PipelineViewClass("table")" @onclick='() => _oppView = "table"'><i class="bi bi-table"></i> Table</button></div></div>
                @if (_oppView == "board")
                {
                    <div class="pwe-board">@foreach (var col in _pipelineCols) { <section><header><span>@col.Label</span><strong>@FilteredOpps.Count(o => o.Stage == col.Value)</strong></header>@foreach (var item in FilteredOpps.Where(o => o.Stage == col.Value)) { @QueueCard(item) }</section> }</div>
                }
                else
                {
                    @QueueTable(FilteredOpps.Cast<WorkbenchLeadItemVm>().ToList())
                }
            }
            else if (_activeQueue == "messages")
            {
                <div class="pwe-section-head"><div><h2>Producer messages</h2><p>Review unread and recent client or system messages.</p></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="ShowMessages"><i class="bi bi-chat-dots"></i> Messages</button></div>
                @if (FilteredMessages.Count == 0) { @EmptyState("bi-chat-dots", "No messages match this view", "Adjust filters or refresh the producer workbench.") } else { <div class="pwe-message-list">@foreach (var msg in FilteredMessages) { <article class="pwe-message-item @(msg.IsUnread ? "pwe-message-unread" : string.Empty)" @onclick="@(() => OpenMessage(msg))"><span class="pwe-avatar" style="@AvatarStyle(msg.SenderName)">@Initials(msg.SenderName)</span><div><div><strong>@msg.SenderName</strong><span class="@MessageTypeBadge(msg.MessageType)">@msg.MessageType</span><small>@FormatAge(msg.ReceivedAt)</small></div><b>@msg.Subject</b><p>@msg.Preview</p></div>@if (msg.IsUnread) { <i class="pwe-unread-dot" aria-hidden="true"></i> }</article> }</div> }
            }
            else if (_activeQueue == "analytics")
            {
                <div class="pwe-section-head"><div><h2>Producer analytics</h2><p>Monitor queue mix, pipeline distribution, and revenue opportunities.</p></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-x-lg"></i> Reset</button></div>
                <div class="pwe-analytics-grid"><section><h3>Queue distribution</h3>@foreach (var row in QueueDistribution) { @AnalyticsItem(row) }</section><section><h3>Pipeline stages</h3>@foreach (var row in StageDistribution) { @AnalyticsItem(row) }</section><section><h3>Line of business</h3>@foreach (var row in LobDistribution) { @AnalyticsItem(row) }</section><section><h3>Revenue sources</h3>@foreach (var row in RevenueDistribution) { @AnalyticsItem(row) }</section></div>
            }
            else
            {
                <div class="pwe-section-head"><div><h2>@ActiveQueueTitle</h2><p>@ActiveQueueSubtitle</p></div><button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreateLeadAsync"><i class="bi bi-plus-lg"></i> New Lead</button></div>
                @if (ActiveItems.Count == 0) { @EmptyState(ActiveQueueIcon, "No records match this queue", "Adjust filters, refresh the workbench, or open the source workspace.") } else { <div class="pwe-card-grid">@foreach (var item in ActiveItems) { @QueueCard(item) }</div> }
            }
        </main>

        <aside class="pwe-detail-card">
            @if (_selectedItem is not null)
            {
                <div class="pwe-detail-head"><div><span class="pwe-detail-eyebrow"><i class="bi @ActiveQueueIcon" aria-hidden="true"></i> @_selectedItem.ItemType</span><h2>@_selectedItem.CompanyName</h2><p>@_selectedItem.Name</p></div>@if (_selectedItem.HeatScore > 0) { <span class="@HeatBadge(_selectedItem.HeatScore)">@HeatLabel(_selectedItem.HeatScore)</span> }</div>
                <div class="pwe-detail-body"><div class="pwe-detail-summary"><div><span>Ref</span><strong>@(_selectedItem.RefNumber == string.Empty ? "-" : _selectedItem.RefNumber)</strong></div><div><span>LoB</span><strong>@(_selectedItem.LobCode == string.Empty ? "-" : _selectedItem.LobCode)</strong></div><div><span>Premium</span><strong>@_selectedItem.EstPremium.ToString("C0")</strong></div><div><span>Stage</span><strong>@(_selectedItem.Stage == string.Empty ? "-" : _selectedItem.Stage)</strong></div><div><span>Win %</span><strong>@(_selectedItem.WinProbPct > 0 ? _selectedItem.WinProbPct.ToString("F0") + "%" : "-")</strong></div><div><span>Last contact</span><strong>@(_selectedItem.LastContact.HasValue ? FormatAge(_selectedItem.LastContact.Value) : "-")</strong></div></div>@if (!string.IsNullOrWhiteSpace(_selectedItem.NextAction) || !string.IsNullOrWhiteSpace(_selectedItem.CrossSellReason)) { <p class="pwe-detail-note">@(!string.IsNullOrWhiteSpace(_selectedItem.NextAction) ? _selectedItem.NextAction : _selectedItem.CrossSellReason)</p> }<section class="pwe-contact-panel" aria-label="Producer contact timeline"><div class="pwe-contact-panel-head"><span><i class="bi bi-clock-history" aria-hidden="true"></i> Contact timeline</span><strong>@ContactHealthLabel(_selectedItem)</strong></div><div class="pwe-contact-panel-body"><span class="pwe-contact-dot @ContactHealthClass(_selectedItem)"></span><div><strong>@ContactSummary(_selectedItem)</strong><small>@ContactInstruction(_selectedItem)</small></div></div></section><div class="pwe-detail-actions"><button class="um-btn um-btn-ghost" @onclick="@(() => OpenLogContact(_selectedItem))" title="Record a completed producer touchpoint"><i class="bi bi-telephone"></i> Log Contact</button><button class="um-btn um-btn-primary" @onclick="@(() => OpenRecord(_selectedItem))">@ActiveOpenRecordLabel <i class="bi bi-arrow-right"></i></button></div></div>
            }
            else if (_selectedMessage is not null)
            {
                <div class="pwe-detail-head"><div><span class="pwe-detail-eyebrow"><i class="bi bi-chat-dots"></i> Message</span><h2>@_selectedMessage.Subject</h2><p>From @_selectedMessage.SenderName - @FormatAge(_selectedMessage.ReceivedAt)</p></div><span class="@MessageTypeBadge(_selectedMessage.MessageType)">@_selectedMessage.MessageType</span></div>
                <div class="pwe-detail-body"><p class="pwe-detail-note">@_selectedMessage.Body</p><div class="pwe-detail-actions"><button class="um-btn um-btn-ghost" @onclick="CloseMessage">Close</button><button class="um-btn um-btn-primary" @onclick="@(() => OpenMessageAccount(_selectedMessage))">Open Account <i class="bi bi-arrow-right"></i></button></div></div>
            }
            else
            {
                <div class="pwe-detail-empty"><i class="bi bi-person-badge" aria-hidden="true"></i><strong>Select a producer item</strong><span>Review queue details, log contact, and open the source record.</span></div>
            }
        </aside>
    </section>
</div>

@code {
    private Guid? _tenantId;
    private Guid? _tenantAdminUserId;
    private bool _loading;
    private bool _savingContact;
    private bool _showLogContact;
    private bool _toastVisible;
    private string? _loadError;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string _activeQueue = "leads";
    private string _oppView = "board";
    private WorkbenchLeadItemVm? _selectedItem;
    private WorkbenchNotificationItemVm? _selectedMessage;
    private WorkbenchLeadItemVm? _contactItem;
    private ContactLogForm _contactForm = new();
    private string _search = string.Empty;
    private string _filterLob = string.Empty;
    private string _filterStage = string.Empty;
    private bool _filterHotOnly;
    private WorkbenchGoalVm _goal = new();
    private WorkbenchCountsVm _counts = new();
    private List<WorkbenchLeadItemVm> _leads = [];
    private List<WorkbenchOppItemVm> _opportunities = [];
    private List<WorkbenchQuoteItemVm> _quoteFollowups = [];
    private List<WorkbenchRenewalItemVm> _renewalCallList = [];
    private List<WorkbenchCrossSellItemVm> _crossSellList = [];
    private List<WorkbenchNotificationItemVm> _messages = [];

    private readonly List<LabelValue> _lobOptions = [new("BOP", "BOP"), new("GL", "GL"), new("WC", "WC"), new("CA", "CA"), new("CPP", "CPP"), new("PL", "PL"), new("CY", "CY"), new("IM", "IM")];
    private readonly List<LabelValue> _stageOptions = [new("New", "New"), new("Contacted", "Contacted"), new("Qualified", "Qualified"), new("Prospect", "Prospect"), new("Quoted", "Quoted"), new("Presented", "Presented"), new("Negotiating", "Negotiating"), new("Won", "Won"), new("Lost", "Lost")];
    private readonly List<LabelValue> _pipelineCols = [new("Prospect", "Prospect"), new("Quoted", "Quoted"), new("Presented", "Presented"), new("Negotiating", "Negotiating"), new("Won", "Won"), new("Lost", "Lost")];

    private List<QueueTab> _queues => [new("leads", "Leads", "bi bi-person-plus-fill", _counts.AssignedLeads, false), new("opportunities", "Opportunities", "bi bi-trophy-fill", _counts.OpenOpportunities, false), new("quotes", "Quote Follow-ups", "bi bi-file-earmark-text-fill", _counts.QuoteFollowups, _counts.OverdueQuotes > 0), new("renewals", "Renewal Calls", "bi bi-telephone-fill", _counts.RenewalCallList, false), new("cross-sell", "Cross-sell", "bi bi-arrows-expand", _counts.CrossSellList, false), new("messages", "Messages", "bi bi-chat-dots-fill", _counts.UnreadMessages, _counts.UnreadMessages > 0), new("analytics", "Analytics", "bi bi-bar-chart", 0, false)];
    private IReadOnlyList<KpiMetric> Metrics => [new("leads", "Leads", _counts.AssignedLeads.ToString("N0"), $"{_counts.HotLeads} hot", "bi-person-plus-fill", "pwe-tone-info"), new("opportunities", "Opportunities", _counts.OpenOpportunities.ToString("N0"), $"{_counts.OppsPremium:C0} pipeline", "bi-trophy-fill", "pwe-tone-warning"), new("quotes", "Quote Follow-ups", _counts.QuoteFollowups.ToString("N0"), $"{_counts.OverdueQuotes} overdue", "bi-file-earmark-text-fill", _counts.OverdueQuotes > 0 ? "pwe-tone-danger" : "pwe-tone-purple"), new("renewals", "Renewal Calls", _counts.RenewalCallList.ToString("N0"), $"{_counts.RenewalsThisMonth} this month", "bi-telephone-fill", "pwe-tone-success"), new("cross-sell", "Cross-sell", _counts.CrossSellList.ToString("N0"), $"{_counts.CrossSellPremium:C0} potential", "bi-arrows-expand", "pwe-tone-pink"), new("messages", "Unread", _counts.UnreadMessages.ToString("N0"), "Producer messages", "bi-chat-dots-fill", _counts.UnreadMessages > 0 ? "pwe-tone-danger" : "pwe-tone-muted")];

    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> SearchChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _search = e.Value?.ToString() ?? string.Empty);
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> LobChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _filterLob = e.Value?.ToString() ?? string.Empty);
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> StageChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _filterStage = e.Value?.ToString() ?? string.Empty);
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> HotOnlyChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _filterHotOnly = e.Value is bool value && value);
    private string ToastIconClass => _toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill";
    private decimal WeightedPipeline => _opportunities.Sum(o => o.EstPremium * (decimal)(o.WinProbPct / 100));
    private int DueTodayOrOverdue => _leads.Count(i => i.NextActionDate.HasValue && i.NextActionDate.Value.Date <= DateTime.Today) + _quoteFollowups.Count(i => i.NextActionDate.HasValue && i.NextActionDate.Value.Date <= DateTime.Today) + _renewalCallList.Count(i => i.ExpiryDate.HasValue && i.ExpiryDate.Value.Date <= DateTime.Today.AddDays(30));
    private string BestCrossSellText => _crossSellList.OrderByDescending(x => x.CrossSellScore).FirstOrDefault() is { } item ? $"{item.CompanyName} - {item.LobCode}" : "No target yet";
    private string PriorityFocusText => _counts.OverdueQuotes > 0 ? $"{_counts.OverdueQuotes} overdue quote follow-up(s)" : _counts.HotLeads > 0 ? $"{_counts.HotLeads} hot lead(s)" : "Pipeline hygiene";
    private List<WorkbenchLeadItemVm> ActiveItems => _activeQueue switch { "leads" => FilteredLeads.Cast<WorkbenchLeadItemVm>().ToList(), "quotes" => FilteredQuotes.Cast<WorkbenchLeadItemVm>().ToList(), "renewals" => FilteredRenewals.Cast<WorkbenchLeadItemVm>().ToList(), "cross-sell" => FilteredCrossSell.Cast<WorkbenchLeadItemVm>().ToList(), _ => FilteredLeads.Cast<WorkbenchLeadItemVm>().ToList() };
    private int ActiveQueueCount => _activeQueue switch { "opportunities" => FilteredOpps.Count, "messages" => FilteredMessages.Count, "analytics" => _leads.Count + _opportunities.Count + _quoteFollowups.Count + _renewalCallList.Count + _crossSellList.Count, _ => ActiveItems.Count };
    private string ActiveQueueLabel => _activeQueue == "messages" ? "messages" : _activeQueue == "analytics" ? "records" : "items";
    private string ActiveQueueTitle => _activeQueue switch { "quotes" => "Quote follow-up queue", "renewals" => "Renewal call list", "cross-sell" => "Cross-sell targets", _ => "Assigned leads" };
    private string ActiveQueueSubtitle => _activeQueue switch { "quotes" => "Prioritize presented quotes, expirations, and follow-up calls.", "renewals" => "Work upcoming renewals and policy review touchpoints.", "cross-sell" => "Identify accounts with complementary coverage opportunities.", _ => "Work assigned leads by heat, source, next action, and premium potential." };
    private string ActiveQueueIcon => _activeQueue switch { "quotes" => "bi-file-earmark-text-fill", "renewals" => "bi-telephone-fill", "cross-sell" => "bi-arrows-expand", "messages" => "bi-chat-dots-fill", "opportunities" => "bi-trophy-fill", _ => "bi-person-plus-fill" };
    private string ActiveOpenRecordLabel => _activeQueue switch { "opportunities" => "Open Opportunity", "quotes" => "Open Quote Follow-up", "renewals" => "Open Renewal Call", "cross-sell" => "Open Cross-sell", _ => "Open Lead" };
    private string ContactTargetName => _contactItem is null ? "Selected record" : string.IsNullOrWhiteSpace(_contactItem.CompanyName) ? _contactItem.Name : _contactItem.CompanyName;

    private List<WorkbenchLeadItemVm> FilteredLeads => _leads.Where(i => MatchesCommon(i) && (!_filterHotOnly || i.HeatScore >= 70)).ToList();
    private List<WorkbenchOppItemVm> FilteredOpps => _opportunities.Where(MatchesCommon).ToList();
    private List<WorkbenchQuoteItemVm> FilteredQuotes => _quoteFollowups.Where(i => MatchesCommon(i) && (!_filterHotOnly || IsUrgent(i))).ToList();
    private List<WorkbenchRenewalItemVm> FilteredRenewals => _renewalCallList.Where(i => MatchesCommon(i) && (!_filterHotOnly || IsUrgent(i))).ToList();
    private List<WorkbenchCrossSellItemVm> FilteredCrossSell => _crossSellList.Where(MatchesCommon).ToList();
    private List<WorkbenchNotificationItemVm> FilteredMessages => _messages.Where(m => string.IsNullOrWhiteSpace(_search) || m.SenderName.Contains(_search, StringComparison.OrdinalIgnoreCase) || m.Subject.Contains(_search, StringComparison.OrdinalIgnoreCase) || m.Preview.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
    private IReadOnlyList<ProducerMetricBar> QueueDistribution => BuildAnalytics([new("Leads", _leads.Count, "pwe-dist-blue"), new("Opportunities", _opportunities.Count, "pwe-dist-amber"), new("Quotes", _quoteFollowups.Count, "pwe-dist-purple"), new("Renewals", _renewalCallList.Count, "pwe-dist-green"), new("Cross-sell", _crossSellList.Count, "pwe-dist-pink")]);
    private IReadOnlyList<ProducerMetricBar> StageDistribution => BuildAnalytics(_opportunities.GroupBy(x => x.Stage).Select(g => new AnalyticsSeed(g.Key, g.Count(), "pwe-dist-blue")));
    private IReadOnlyList<ProducerMetricBar> LobDistribution => BuildAnalytics(_leads.Cast<WorkbenchLeadItemVm>().Concat(_opportunities).Concat(_quoteFollowups).Concat(_renewalCallList).Concat(_crossSellList).Where(x => !string.IsNullOrWhiteSpace(x.LobCode)).GroupBy(x => x.LobCode).Select(g => new AnalyticsSeed(g.Key, g.Count(), "pwe-dist-green")));
    private IReadOnlyList<ProducerMetricBar> RevenueDistribution => BuildAnalytics([new("Pipeline", _opportunities.Sum(x => (int)(x.EstPremium / 1000)), "pwe-dist-blue"), new("Quotes", _quoteFollowups.Sum(x => (int)(x.EstPremium / 1000)), "pwe-dist-purple"), new("Renewals", _renewalCallList.Sum(x => (int)(x.EstPremium / 1000)), "pwe-dist-green"), new("Cross-sell", _crossSellList.Sum(x => (int)(x.EstPremium / 1000)), "pwe-dist-pink")]);

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Workbench", "/workbench"), new("Producer", "/workbench/producer"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _loadError = null;
            if (!await ResolveTenantAdminContextAsync()) return;
            var context = await CurrentUser.RequireAsync();
            var dto = await WorkbenchApi.GetWorkbenchAsync(_tenantId!.Value, context.UserScopeId);
            if (dto is null) return;
            MapDto(dto);
            _selectedItem = ActiveItems.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load producer workbench: {ex.Message}";
            ShowToast(_loadError, "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void MapDto(ProducerWorkbenchDto dto)
    {
        _goal = new() { WrittenPremium = dto.Goal.WrittenPremium, GoalPremium = dto.Goal.GoalPremium, NewPolicies = dto.Goal.NewPolicies, RetentionRate = dto.Goal.RetentionRate, PipelineValue = dto.Goal.PipelineValue, UnreadMessages = dto.Goal.UnreadMessages };
        _counts = new() { AssignedLeads = dto.Counts.AssignedLeads, HotLeads = dto.Counts.HotLeads, OpenOpportunities = dto.Counts.OpenOpportunities, OppsPremium = dto.Counts.OppsPremium, QuoteFollowups = dto.Counts.QuoteFollowups, OverdueQuotes = dto.Counts.OverdueQuotes, RenewalCallList = dto.Counts.RenewalCallList, RenewalsThisMonth = dto.Counts.RenewalsThisMonth, CrossSellList = dto.Counts.CrossSellList, CrossSellPremium = dto.Counts.CrossSellPremium, UnreadMessages = dto.Counts.UnreadMessages };
        _leads = dto.MyLeads.Select(l => new WorkbenchLeadItemVm { ItemId = l.LeadId, Name = l.FullName, CompanyName = l.AccountName ?? string.Empty, RefNumber = l.LeadNumber, LobCode = l.InterestedService ?? string.Empty, Source = l.SourceCode ?? string.Empty, Stage = MapLeadStatus(l.StatusCodeId), EstPremium = EstimateLeadPremium(l.InterestedService, l.Score), HeatScore = l.Score ?? 0, LastContact = l.LastActivityDate, NextAction = l.NextAction ?? string.Empty, NextActionDate = l.NextActionDate, DetailUrl = $"/crm/leads/{l.LeadId}" }).ToList();
        _opportunities = dto.MyOpportunities.Select(o => new WorkbenchOppItemVm { ItemId = o.OpportunityId, AccountId = o.AccountId, Name = o.OpportunityName, CompanyName = o.AccountName ?? string.Empty, RefNumber = o.OpportunityNumber, LobCode = MapLobFromText(o.OpportunityName), Stage = NormalizePipelineStage(o.StageName, o.ForecastCategoryCode, o.StatusCodeId), EstPremium = o.EstimatedAmount, WinProbPct = o.WinProbability, LastContact = o.LastActivityDate, CloseDate = o.CloseDate, NextAction = o.NextAction ?? string.Empty, DetailUrl = $"/crm/opportunities/{o.OpportunityId}" }).ToList();
        _quoteFollowups = dto.QuoteFollowups.Select(q => new WorkbenchQuoteItemVm { ItemId = q.QuoteId, AccountId = q.AccountId, OpportunityId = q.OpportunityId, Name = q.OpportunityName ?? string.Empty, CompanyName = q.AccountName ?? string.Empty, RefNumber = q.QuoteNumber, EstPremium = q.TotalAmount, LobCode = MapLobFromText(q.OpportunityName ?? q.AccountName ?? string.Empty), Stage = q.StatusCode, QuoteExpiryDate = q.ValidUntilDate, NextActionDate = q.ValidUntilDate?.AddDays(-3), NextAction = q.IsExpired ? "Recover expired quote" : q.IsExpiringSoon ? "Call before quote expires" : "Follow up on presented quote", DetailUrl = $"/quotes/{q.QuoteId}" }).ToList();
        _renewalCallList = dto.RenewalCallList.Select(r => new WorkbenchRenewalItemVm { ItemId = r.RenewalId, CompanyName = r.AccountName ?? string.Empty, RefNumber = r.AgreementNumber ?? string.Empty, PolicyNumber = r.RenewalNumber, EstPremium = r.TotalContractValue ?? 0, RenewalStage = r.StatusCode, Stage = r.StatusCode, LobCode = MapLobFromText(r.AccountName ?? r.AgreementNumber ?? string.Empty), ExpiryDate = r.NewStartDate, NextAction = r.IsUrgent ? "Schedule renewal review" : "Prepare renewal touchpoint", NextActionDate = r.NewStartDate.AddDays(-30), DetailUrl = $"/workbench/producer/renewal-calls/{r.RenewalId}" }).ToList();
        _crossSellList = dto.CrossSellList.Select(c => new WorkbenchCrossSellItemVm { ItemId = c.AccountId, CompanyName = c.AccountName, CurrentLobs = c.CurrentLobs ?? string.Empty, LobCode = c.TargetLob ?? string.Empty, EstPremium = c.OppPremium, CrossSellScore = c.Score, CrossSellReason = c.Reason ?? string.Empty, LastContact = c.LastContact, DetailUrl = $"/marketing/cross-sell/{c.AccountId}?accountName={Uri.EscapeDataString(c.AccountName)}" }).ToList();
        _messages = dto.Messages.Select(n => new WorkbenchNotificationItemVm { MessageId = n.NotificationId, SenderName = n.EntityName ?? "System", Subject = n.Subject ?? "(no subject)", Preview = n.Body.Length > 120 ? n.Body[..120] + "..." : n.Body, Body = n.Body, MessageType = MapChannel(n.ChannelCode), ReceivedAt = n.CreatedDateUtc, IsUnread = !n.IsRead, AccountUrl = n.EntityId.HasValue ? $"/accounts/{n.EntityId}" : "/accounts" }).ToList();
        _goal.UnreadMessages = _counts.UnreadMessages;
    }

    private async Task ExportAsync() => await Task.Run(() => ShowToast($"Export prepared for {_leads.Count + _opportunities.Count + _quoteFollowups.Count + _renewalCallList.Count + _crossSellList.Count} workbench rows."));
    private void SetActiveQueue(string id) { _activeQueue = id; _selectedItem = id == "messages" || id == "analytics" ? null : ActiveItems.FirstOrDefault(); _selectedMessage = null; }

    private async Task OpenCreateLeadAsync()
    {
        if ((!_tenantId.HasValue || !_tenantAdminUserId.HasValue) && !await ResolveTenantAdminContextAsync()) return;
        await LeadDialogs.OpenCreateAsync(_tenantId, _tenantAdminUserId, OnLeadCreatedAsync);
    }

    private async Task OnLeadCreatedAsync()
    {
        ShowToast("Lead created from producer workbench.");
        await LoadAsync();
    }
    private void ShowHotLeads() { _filterHotOnly = true; SetActiveQueue("leads"); }
    private void ShowPipeline() { _oppView = "board"; SetActiveQueue("opportunities"); }
    private void ShowOverdueQuotes() { _filterHotOnly = true; SetActiveQueue("quotes"); }
    private void ShowMessages() => SetActiveQueue("messages");
    private void ResetFilters() { _search = string.Empty; _filterLob = string.Empty; _filterStage = string.Empty; _filterHotOnly = false; }
    private void OpenDetail(WorkbenchLeadItemVm item) { _selectedItem = item; _selectedMessage = null; }
    private void OpenMessage(WorkbenchNotificationItemVm msg) { _selectedMessage = msg; _selectedItem = null; msg.IsUnread = false; }
    private void CloseMessage() => _selectedMessage = null;
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;

    private void OpenLogContact(WorkbenchLeadItemVm item)
    {
        _contactItem = item;
        _contactForm = new ContactLogForm
        {
            ContactMethod = SuggestedContactMethod(item),
            OutcomeCode = "Contacted",
            Subject = BuildContactSubject(item),
            Notes = BuildContactNotes(item),
            DurationMinutes = 15
        };
        _showLogContact = true;
    }

    private void CloseLogContact()
    {
        if (_savingContact) return;
        _showLogContact = false;
        _contactItem = null;
        _contactForm = new();
    }

    private async Task SaveContactAsync()
    {
        if (_contactItem is null) return;

        try
        {
            _savingContact = true;
            if (!_tenantId.HasValue && !await ResolveTenantAdminContextAsync()) return;
            await WorkbenchApi.LogContactAsync(new ProducerWorkbenchLogContactRequest
            {
                TenantId = _tenantId!.Value,
                ItemId = _contactItem.ItemId,
                ItemType = _contactItem.ItemType,
                ContactMethod = _contactForm.ContactMethod,
                Subject = _contactForm.Subject,
                Notes = _contactForm.Notes,
                OutcomeCode = _contactForm.OutcomeCode,
                DurationMinutes = _contactForm.DurationMinutes,
                CreatedByUserId = _tenantAdminUserId
            });
            ShowToast($"Contact logged for {ContactTargetName}.");
            _showLogContact = false;
            _contactItem = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Failed to log contact: {ex.Message}", "danger");
        }
        finally
        {
            _savingContact = false;
        }
    }

    private void OpenRecord(WorkbenchLeadItemVm item)
    {
        if (string.IsNullOrWhiteSpace(item.DetailUrl))
        {
            ShowToast("No source record route is available for this workbench item.", "warning");
            return;
        }

        Nav.NavigateTo(item.DetailUrl);
    }

    private void OpenMessageAccount(WorkbenchNotificationItemVm msg)
    {
        if (string.IsNullOrWhiteSpace(msg.AccountUrl) || msg.AccountUrl == "/accounts")
        {
            ShowToast("This message is not linked to a specific account record.", "warning");
            return;
        }

        Nav.NavigateTo(msg.AccountUrl);
    }

    private async Task<bool> ResolveTenantAdminContextAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true) { _loadError = "Unable to load producer workbench: user is not authenticated."; ShowToast(_loadError, "danger"); return false; }
        _tenantId = GetClaimGuid(user, "tenant_id", "tenantId", "TenantId");
        _tenantAdminUserId = GetClaimGuid(user, ClaimTypes.NameIdentifier, "sub", "user_id", "userId", "UserId");
        if (!_tenantId.HasValue || !_tenantAdminUserId.HasValue) { _loadError = "Unable to load producer workbench: tenant or user context is missing."; ShowToast(_loadError, "danger"); return false; }
        return true;
    }

    private bool MatchesCommon(WorkbenchLeadItemVm item) => (string.IsNullOrWhiteSpace(_filterLob) || item.LobCode.Contains(_filterLob, StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrWhiteSpace(_filterStage) || item.Stage.Equals(_filterStage, StringComparison.OrdinalIgnoreCase) || item.RenewalStage.Equals(_filterStage, StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrWhiteSpace(_search) || new[] { item.Name, item.CompanyName, item.RefNumber, item.PolicyNumber, item.LobCode, item.Source, item.Stage, item.NextAction, item.CrossSellReason }.Any(v => !string.IsNullOrWhiteSpace(v) && v.Contains(_search, StringComparison.OrdinalIgnoreCase)));
    private static bool IsUrgent(WorkbenchLeadItemVm item) => (item.NextActionDate.HasValue && item.NextActionDate.Value.Date <= DateTime.Today) || (item.QuoteExpiryDate.HasValue && item.QuoteExpiryDate.Value.Date <= DateTime.Today.AddDays(7)) || (item.ExpiryDate.HasValue && item.ExpiryDate.Value.Date <= DateTime.Today.AddDays(30));
    private RenderFragment QueueCard(WorkbenchLeadItemVm item) => @<article class="pwe-item-card @(ReferenceEquals(_selectedItem, item) ? "pwe-item-selected" : string.Empty)" @onclick="@(() => OpenDetail(item))"><div class="pwe-item-top"><span class="pwe-avatar" style="@AvatarStyle(item.CompanyName)">@Initials(item.CompanyName)</span><div><strong>@(string.IsNullOrWhiteSpace(item.CompanyName) ? item.Name : item.CompanyName)</strong><span>@(string.IsNullOrWhiteSpace(item.Name) ? item.RefNumber : item.Name)</span></div></div><div class="pwe-item-meta">@if (!string.IsNullOrWhiteSpace(item.LobCode)) { <span class="pwe-lob">@item.LobCode</span> } @if (!string.IsNullOrWhiteSpace(item.Stage)) { <span class="@StageBadge(item.Stage)">@item.Stage</span> } @if (item.HeatScore > 0) { <span class="@HeatBadge(item.HeatScore)">@HeatLabel(item.HeatScore)</span> }</div><div class="pwe-item-footer"><strong>@item.EstPremium.ToString("C0")</strong><span>@(item.NextActionDate?.ToString("MMM d", CultureInfo.CurrentCulture) ?? item.CloseDate?.ToString("MMM d", CultureInfo.CurrentCulture) ?? item.ExpiryDate?.ToString("MMM d", CultureInfo.CurrentCulture) ?? "No date")</span></div><div class="pwe-item-actions" @onclick:stopPropagation="true"><button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenLogContact(item))" title="Log contact" aria-label="Log contact"><i class="bi bi-telephone"></i></button><button class="pwe-card-open" @onclick="@(() => OpenRecord(item))" title="Open record" aria-label="Open record"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></button></div></article>;
    private RenderFragment QueueTable(List<WorkbenchLeadItemVm> items) => @<div class="pwe-table-wrap"><table class="pwe-table"><thead><tr><th>Name</th><th>Ref</th><th>LoB</th><th>Stage</th><th>Premium</th><th>Next</th><th></th></tr></thead><tbody>@foreach (var item in items) { <tr @onclick="@(() => OpenDetail(item))"><td><strong>@(string.IsNullOrWhiteSpace(item.CompanyName) ? item.Name : item.CompanyName)</strong><small>@item.Name</small></td><td>@item.RefNumber</td><td>@item.LobCode</td><td><span class="@StageBadge(item.Stage)">@item.Stage</span></td><td>@item.EstPremium.ToString("C0")</td><td>@(item.NextActionDate?.ToString("MMM d") ?? item.CloseDate?.ToString("MMM d") ?? "-")</td><td @onclick:stopPropagation="true"><button class="um-btn um-btn-primary um-btn-sm" @onclick="@(() => OpenRecord(item))">Open</button></td></tr> }</tbody></table></div>;
    private RenderFragment EmptyState(string icon, string title, string text) => @<div class="pwe-empty-state"><i class="bi @icon" aria-hidden="true"></i><strong>@title</strong><span>@text</span><button class="um-btn um-btn-primary" @onclick="LoadAsync">Refresh</button></div>;
    private RenderFragment AnalyticsItem(ProducerMetricBar row) => @<button class="pwe-analytics-row"><span>@row.Label</span><div><i class="@row.Tone" style="width:@row.WidthPercent%"></i></div><strong>@row.Count</strong><small>@row.Percent.ToString("F0")%</small></button>;

    private static Guid? GetClaimGuid(ClaimsPrincipal user, params string[] claimTypes) { foreach (var claimType in claimTypes) { var value = user.FindFirst(claimType)?.Value; if (Guid.TryParse(value, out var id)) return id; } return null; }
    private string MetricCardClass(KpiMetric metric) => $"pwe-kpi-card {(metric.QueueId == _activeQueue ? "pwe-kpi-card-active" : string.Empty)}";
    private string QueueTabClass(string id) => $"pwe-view-btn {(id == _activeQueue ? "pwe-view-btn-active" : string.Empty)}";
    private string PipelineViewClass(string id) => $"pwe-view-mini {(id == _oppView ? "pwe-view-mini-active" : string.Empty)}";
    private string GoalPercentText => $"{_goal.WrittenPct.ToString("F0", CultureInfo.CurrentCulture)}% of total";
    private string GoalTrackWidth => $"{Math.Min(_goal.WrittenPct, 100).ToString("F0", CultureInfo.InvariantCulture)}%";
    private IReadOnlyList<ProducerMetricBar> BuildAnalytics(IEnumerable<AnalyticsSeed> seeds) { var items = seeds.ToList(); var total = Math.Max(1, items.Sum(x => x.Count)); return items.Select(x => new ProducerMetricBar(x.Label, x.Count, x.Tone, x.Count * 100m / total, Math.Max(4m, x.Count * 100m / total))).ToList(); }
    private static string HeatBadge(double score) => score >= 80 ? "pwe-heat pwe-heat-hot" : score >= 50 ? "pwe-heat pwe-heat-warm" : "pwe-heat pwe-heat-cold";
    private static string HeatLabel(double score) => score >= 80 ? "Hot" : score >= 50 ? "Warm" : "Cold";
    private static string StageBadge(string? s) => $"pwe-stage pwe-stage-{(string.IsNullOrWhiteSpace(s) ? "default" : s.ToLowerInvariant().Replace(" ", "-"))}";
    private static string MessageTypeBadge(string t) => $"pwe-msg-type pwe-msg-type-{t.ToLowerInvariant()}";
    private static string FormatAge(DateTime dt) { var diff = DateTime.Now - dt; if (diff.TotalMinutes < 1) return "Just now"; if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m ago"; if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago"; if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d ago"; return dt.ToString("d", CultureInfo.CurrentCulture); }
    private static string Initials(string name) { var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length >= 1 ? name[..1] : "?"; }
    private static string AvatarStyle(string name) { var hue = Math.Abs(name.GetHashCode()) % 360; return $"background:hsl({hue},70%,94%);color:hsl({hue},45%,32%);border:1px solid hsl({hue},55%,86%);box-shadow:inset 0 1px 0 rgba(255,255,255,.85);"; }
    private static string MapLeadStatus(int code) => code switch { 1 => "New", 2 => "Contacted", 3 => "Qualified", _ => "Prospect" };
    private static string MapChannel(string channel) => channel switch { "Email" => "Email", "SMS" => "SMS", "InApp" => "Portal", _ => "Note" };
    private static decimal EstimateLeadPremium(string? lob, int? score) => MapLobFromText(lob ?? string.Empty) switch { "WC" => 42000 + (score ?? 0) * 225, "BOP" => 18500 + (score ?? 0) * 140, "GL" => 24000 + (score ?? 0) * 160, "CY" => 15000 + (score ?? 0) * 110, "CA" => 36000 + (score ?? 0) * 190, "PL" => 27000 + (score ?? 0) * 150, _ => 12000 + (score ?? 0) * 100 };
    private static string MapLobFromText(string text) { if (text.Contains("Worker", StringComparison.OrdinalIgnoreCase) || text.Contains(" WC", StringComparison.OrdinalIgnoreCase)) return "WC"; if (text.Contains("Cyber", StringComparison.OrdinalIgnoreCase)) return "CY"; if (text.Contains("Auto", StringComparison.OrdinalIgnoreCase) || text.Contains("Fleet", StringComparison.OrdinalIgnoreCase)) return "CA"; if (text.Contains("Umbrella", StringComparison.OrdinalIgnoreCase)) return "UMB"; if (text.Contains("Professional", StringComparison.OrdinalIgnoreCase) || text.Contains("E&O", StringComparison.OrdinalIgnoreCase)) return "PL"; if (text.Contains("Property", StringComparison.OrdinalIgnoreCase) || text.Contains("Package", StringComparison.OrdinalIgnoreCase)) return "CPP"; if (text.Contains("BOP", StringComparison.OrdinalIgnoreCase) || text.Contains("Business", StringComparison.OrdinalIgnoreCase)) return "BOP"; if (text.Contains("General", StringComparison.OrdinalIgnoreCase) || text.Contains("GL", StringComparison.OrdinalIgnoreCase)) return "GL"; return string.Empty; }
    private static string ContactHealthLabel(WorkbenchLeadItemVm item) => !item.LastContact.HasValue ? "No touchpoint" : (DateTime.Now - item.LastContact.Value).TotalDays <= 7 ? "Current" : (DateTime.Now - item.LastContact.Value).TotalDays <= 21 ? "Follow-up soon" : "Needs contact";
    private static string ContactHealthClass(WorkbenchLeadItemVm item) => !item.LastContact.HasValue ? "pwe-contact-dot-muted" : (DateTime.Now - item.LastContact.Value).TotalDays <= 7 ? "pwe-contact-dot-success" : (DateTime.Now - item.LastContact.Value).TotalDays <= 21 ? "pwe-contact-dot-warning" : "pwe-contact-dot-danger";
    private static string ContactSummary(WorkbenchLeadItemVm item) => item.LastContact.HasValue ? $"Last producer touchpoint {FormatAge(item.LastContact.Value)}" : "No producer contact logged yet";
    private static string ContactInstruction(WorkbenchLeadItemVm item) => item.ItemType == "Lead" || item.ItemType == "Opportunity" ? "Log Contact writes to the CRM lead/opportunity activity timeline and refreshes this panel." : "Log Contact writes to the account activity timeline when an account can be resolved.";
    private static string NormalizePipelineStage(string? stageName, string? forecastCategory, int statusCode) => (stageName ?? forecastCategory) switch { "Pipeline" => "Prospect", "BestCase" => "Quoted", "Commit" => "Presented", "Closed" when statusCode == 2 => "Won", "Closed" when statusCode == 3 => "Lost", "Won" => "Won", "Lost" => "Lost", "Negotiating" => "Negotiating", "Presented" => "Presented", "Quoted" => "Quoted", "Prospect" => "Prospect", _ => statusCode == 2 ? "Won" : statusCode == 3 ? "Lost" : "Prospect" };
    private static string SuggestedContactMethod(WorkbenchLeadItemVm item) => item.ItemType == "Quote" || item.ItemType == "Renewal" ? "Call" : "Call";
    private static string BuildContactSubject(WorkbenchLeadItemVm item) => $"{SuggestedContactMethod(item)} logged from producer workbench - {(string.IsNullOrWhiteSpace(item.CompanyName) ? item.Name : item.CompanyName)}";
    private static string? BuildContactNotes(WorkbenchLeadItemVm item) => string.IsNullOrWhiteSpace(item.NextAction) && string.IsNullOrWhiteSpace(item.CrossSellReason) ? null : !string.IsNullOrWhiteSpace(item.NextAction) ? item.NextAction : item.CrossSellReason;

    private sealed record LabelValue(string Value, string Label);
    private sealed record QueueTab(string Id, string Label, string Icon, int Badge, bool IsAlert);
    private sealed record KpiMetric(string QueueId, string Label, string Value, string Caption, string Icon, string Tone);
