    private static string HeatBadge(double score) => score >= 80
        ? "pw-heat-badge pw-heat-badge--hot"
        : score >= 50 ? "pw-heat-badge pw-heat-badge--warm" : "pw-heat-badge pw-heat-badge--cold";

    private static string HeatLabel(double score) =>
        score >= 80 ? "🔥 Hot" : score >= 50 ? "Warm" : "Cold";

    private static string StageBadge(string? s) => s switch
    {
        "Prospect"    => "pw-stage-badge pw-stage-badge--prospect",
        "Quoted"      => "pw-stage-badge pw-stage-badge--quoted",
        "Presented"   => "pw-stage-badge pw-stage-badge--presented",
        "Negotiating" => "pw-stage-badge pw-stage-badge--negotiating",
        "Won"         => "pw-stage-badge pw-stage-badge--won",
        "Lost"        => "pw-stage-badge pw-stage-badge--lost",
        _             => "pw-stage-badge",
    };

    private static string WinProbClass(double p) =>
        p >= 70 ? "pw-prob-high" : p >= 40 ? "pw-prob-mid" : "pw-prob-low";

    private static string ScoreColor(double s) =>
        s >= 75 ? "#22c55e" : s >= 50 ? "#eab308" : "#f97316";

    private static string GoalBarColor(double p) =>
        p >= 100 ? "#22c55e" : p >= 75 ? "#3b82f6" : p >= 50 ? "#eab308" : "#f97316";

    private static string MessageTypeBadge(string t) => t switch
    {
        "Email"  => "pw-msg-type pw-msg-type--email",
        "Portal" => "pw-msg-type pw-msg-type--portal",
        "SMS"    => "pw-msg-type pw-msg-type--sms",
        "Note"   => "pw-msg-type pw-msg-type--note",
        _        => "pw-msg-type",
    };

    private static string FormatAge(DateTime dt)
    {
        var diff = DateTime.Now - dt;
        if (diff.TotalMinutes < 1)  return "Just now";
        if (diff.TotalHours   < 1)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays    < 1)  return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 30) return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("d");
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length >= 1 ? name[..1] : "?";
    }

    private static string AvatarStyle(string name)
    {
        var hue = Math.Abs(name.GetHashCode()) % 360;
        return $"background:hsl({hue},50%,40%);color:#fff;";
    }

    private static string MapLeadStatus(int code) => code switch
    {
        1 => "New",
        2 => "Contacted",
        3 => "Qualified",
        _ => "Prospect",
    };

    private static string MapChannel(string channel) => channel switch
    {
        "Email" => "Email",
        "SMS"   => "SMS",
        "InApp" => "Portal",
        _       => "Note",
    };

    private static decimal EstimateLeadPremium(string? lob, int? score) => MapLobFromText(lob ?? string.Empty) switch
    {
        "WC" => 42000 + (score ?? 0) * 225,
        "BOP" => 18500 + (score ?? 0) * 140,
        "GL" => 24000 + (score ?? 0) * 160,
        "CY" => 15000 + (score ?? 0) * 110,
        "CA" => 36000 + (score ?? 0) * 190,
        "PL" => 27000 + (score ?? 0) * 150,
        _ => 12000 + (score ?? 0) * 100,
    };

    private static string MapLobFromText(string text)
    {
        if (text.Contains("Worker", StringComparison.OrdinalIgnoreCase) || text.Contains(" WC", StringComparison.OrdinalIgnoreCase)) return "WC";
        if (text.Contains("Cyber", StringComparison.OrdinalIgnoreCase)) return "CY";
        if (text.Contains("Auto", StringComparison.OrdinalIgnoreCase) || text.Contains("Fleet", StringComparison.OrdinalIgnoreCase)) return "CA";
        if (text.Contains("Umbrella", StringComparison.OrdinalIgnoreCase)) return "UMB";
        if (text.Contains("Professional", StringComparison.OrdinalIgnoreCase) || text.Contains("E&O", StringComparison.OrdinalIgnoreCase)) return "PL";
        if (text.Contains("Property", StringComparison.OrdinalIgnoreCase) || text.Contains("Package", StringComparison.OrdinalIgnoreCase)) return "CPP";
        if (text.Contains("BOP", StringComparison.OrdinalIgnoreCase) || text.Contains("Business", StringComparison.OrdinalIgnoreCase)) return "BOP";
        if (text.Contains("General", StringComparison.OrdinalIgnoreCase) || text.Contains("GL", StringComparison.OrdinalIgnoreCase)) return "GL";
        return string.Empty;
    }

    private static string NormalizePipelineStage(string? stageName, string? forecastCategory, int statusCode) => (stageName ?? forecastCategory) switch
    {
        "Pipeline" => "Prospect",
        "BestCase" => "Quoted",
        "Commit" => "Presented",
        "Closed" when statusCode == 2 => "Won",
        "Closed" when statusCode == 3 => "Lost",
        "Won" => "Won",
        "Lost" => "Lost",
        "Negotiating" => "Negotiating",
        "Presented" => "Presented",
        "Quoted" => "Quoted",
        "Prospect" => "Prospect",
        _ => statusCode == 2 ? "Won" : statusCode == 3 ? "Lost" : "Prospect",
    };

