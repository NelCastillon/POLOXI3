@page "/workbench"
@namespace Ams.Web.Components.Pages.Workbench
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>My Workbench — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="My Workbench"
               Subtitle="Your personalised hub — tasks, activities, schedule and quick access to every role workbench"
               Icon="bi-grid-1x2">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="Refresh" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/workbench/tasks")'>
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Task
        </button>
    </Actions>
</AppPageHeader>

<!-- ── KPI summary strip ─────────────────────────────────────────── -->
<div class="mw-kpi-strip">
    @KpiCard("bi-check2-square",  "Open Tasks",        _kpis.OpenTasks.ToString(),        "mw-kpi-tasks",   "/workbench/tasks")
    @KpiCard("bi-alarm-fill",     "Overdue",           _kpis.OverdueTasks.ToString(),     "mw-kpi-overdue", "/workbench/tasks")
    @KpiCard("bi-lightning-fill", "Activities Today",  _kpis.ActivitiesToday.ToString(),  "mw-kpi-act",     "/workbench/activities")
    @KpiCard("bi-bell-fill",      "Unread Notifs.",    _kpis.Unread.ToString(),           "mw-kpi-notif",   "/workbench/notifications")
    @KpiCard("bi-arrow-clockwise","Renewals Due",      _kpis.RenewalsDue.ToString(),      "mw-kpi-ren",     "/renewals")
    @KpiCard("bi-headset",        "Open Requests",     _kpis.OpenServiceRequests.ToString(),"mw-kpi-sr",    "/ops/service-requests")
</div>

<!-- ── Main body ─────────────────────────────────────────────────── -->
<div class="mw-body">

    <!-- Left column: tasks + schedule -->
    <div class="mw-col mw-col-main">

        <!-- Today's Tasks -->
        <div class="mw-card">
            <div class="mw-card-hdr">
                <div class="mw-card-title">
                    <i class="bi bi-check2-square" aria-hidden="true"></i> Today's Tasks
                    @if (_kpis.OverdueTasks > 0)
                    {
                        <span class="mw-badge-red">@_kpis.OverdueTasks overdue</span>
                    }
                </div>
                <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => Nav.NavigateTo("/workbench/tasks")'>
                    View All <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
            <div class="mw-task-list">
                @foreach (var t in _tasks.Take(6))
                {
                    <div class="mw-task-row @(t.IsOverdue ? "mw-task-overdue" : "")">
                        <button class="mw-task-check @(t.Done ? "mw-task-check--done" : "")"
                                @onclick="() => t.Done = !t.Done" title="Toggle complete">
                            <i class="bi @(t.Done ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                        </button>
                        <div class="mw-task-body">
                            <span class="mw-task-title @(t.Done ? "mw-task-done" : "")">@t.Title</span>
                            <span class="mw-task-meta">@t.Category · @t.DueLabel</span>
                        </div>
                        <span class="mw-pri-badge mw-pri-@t.Priority.ToLower()">@t.Priority</span>
                    </div>
                }
                @if (!_tasks.Any())
                {
                    <div class="mw-empty"><i class="bi bi-check2-all" aria-hidden="true"></i> All clear — no tasks today!</div>
                }
            </div>
        </div>

        <!-- Today's Schedule -->
        <div class="mw-card">
            <div class="mw-card-hdr">
                <div class="mw-card-title">
                    <i class="bi bi-calendar3" aria-hidden="true"></i> Today's Schedule
                    <span class="mw-date-chip">@DateTime.Today.ToString("ddd, MMM d")</span>
                </div>
                <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => Nav.NavigateTo("/workbench/calendar")'>
                    Calendar <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
            <div class="mw-schedule-list">
                @foreach (var e in _events)
                {
                    <div class="mw-sched-row mw-sched-@e.Type.ToLower()">
                        <div class="mw-sched-time">@e.StartTime.ToString("h:mm tt")</div>
                        <div class="mw-sched-dot"></div>
                        <div class="mw-sched-body">
                            <span class="mw-sched-title">@e.Title</span>
                            @if (!string.IsNullOrEmpty(e.Account))
                            {
                                <span class="mw-sched-acct">@e.Account</span>
                            }
                        </div>
                        <span class="mw-sched-chip mw-sched-chip-@e.Type.ToLower()">@e.Type</span>
                    </div>
                }
                @if (!_events.Any())
                {
                    <div class="mw-empty"><i class="bi bi-calendar-check" aria-hidden="true"></i> Nothing scheduled today.</div>
                }
            </div>
        </div>

    </div>

    <!-- Right column: recent activity + workbench links -->
    <div class="mw-col mw-col-side">

        <!-- Recent Activity Feed -->
        <div class="mw-card">
            <div class="mw-card-hdr">
                <div class="mw-card-title">
                    <i class="bi bi-lightning" aria-hidden="true"></i> Recent Activity
                </div>
                <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => Nav.NavigateTo("/workbench/activities")'>
                    View All <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
            <div class="mw-activity-feed">
                @foreach (var a in _activities.Take(7))
                {
                    <div class="mw-activity-row">
                        <div class="mw-act-icon mw-act-@a.Type.ToLower()">
                            <i class="bi @ActivityIcon(a.Type)" aria-hidden="true"></i>
                        </div>
                        <div class="mw-act-body">
                            <span class="mw-act-title">@a.Subject</span>
                            <span class="mw-act-meta">@a.Account · @FormatAge(a.LoggedAt)</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Role Workbench quick links -->
        <div class="mw-card">
            <div class="mw-card-hdr">
                <div class="mw-card-title">
                    <i class="bi bi-grid" aria-hidden="true"></i> Role Workbenches
                </div>
            </div>
            <div class="mw-wb-grid">
                @foreach (var wb in _workbenches)
                {
                    <button class="mw-wb-tile" @onclick="() => Nav.NavigateTo(wb.Url)">
                        <i class="bi @wb.Icon mw-wb-icon" aria-hidden="true"></i>
                        <span class="mw-wb-label">@wb.Label</span>
                    </button>
                }
            </div>
        </div>

    </div>
</div>

@code {
    SfToast _toast = default!;

    sealed record KpiSummary(int OpenTasks, int OverdueTasks, int ActivitiesToday,
                             int Unread, int RenewalsDue, int OpenServiceRequests);
    sealed record TaskItem(string Title, string Category, string Priority, string DueLabel, bool IsOverdue)
    {
        public bool Done { get; set; }
    }
    sealed record ScheduleEvent(string Title, string Account, string Type, DateTime StartTime);
    sealed record ActivityItem(string Subject, string Account, string Type, DateTime LoggedAt);
    sealed record WbLink(string Label, string Icon, string Url);

    KpiSummary _kpis = new(0,0,0,0,0,0);

    List<TaskItem>      _tasks      = new();
    List<ScheduleEvent> _events     = new();
    List<ActivityItem>  _activities = new();

    readonly WbLink[] _workbenches =
    [
        new("Producer",       "bi-person-badge",     "/workbench/producer"),
        new("CSR",            "bi-headset",           "/workbench/csr"),
        new("Service Mgr",    "bi-diagram-3-fill",    "/workbench/service-manager"),
        new("Accounting",     "bi-calculator-fill",   "/workbench/accounting"),
        new("Marketing",      "bi-megaphone-fill",    "/workbench/marketing"),
        new("Operations",     "bi-tools",             "/workbench/operations"),
    ];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Workbench", "/workbench"));
        BuildStub();
    }

    void BuildStub()
    {
        _kpis = new(14, 3, 7, 5, 9, 4);

        _tasks = new()
        {
            new("Follow up on Hartford quote — Sullivan Mfg.",  "Quote Follow-up", "High",   "Today",        false),
            new("Send cert of insurance to Metro Freight",       "Certificate",     "High",   "Today",        false),
            new("Review renewal proposal — Apex Medical",        "Renewal",         "Medium", "Today",        false),
            new("Call back Bridgewater Hotels re: premium",      "Call",            "High",   "Overdue 2d",   true),
            new("Prepare ACORD 25 — Dallas Roofing",             "Document",        "Low",    "Tomorrow",     false),
            new("Update pipeline forecast Q2",                   "Admin",           "Low",    "This week",    false),
        };

        _events = new()
        {
            new("Renewal Review Call — Sullivan Mfg.",   "Sullivan Mfg. LLC",    "Call",     DateTime.Today.AddHours(9)),
            new("Quote Presentation — Metro Freight",    "Metro Freight Co.",    "Meeting",  DateTime.Today.AddHours(10.5)),
            new("Team Standup",                          "",                     "Meeting",  DateTime.Today.AddHours(11)),
            new("Follow-up: Apex Medical",               "Apex Medical Group",   "Task",     DateTime.Today.AddHours(14)),
            new("Webinar: E&S Market Update",            "",                     "Event",    DateTime.Today.AddHours(15)),
        };

        var rnd = new Random(42);
        var types  = new[]{ "Call","Email","Meeting","Note","Task" };
        var accts  = new[]{ "Sullivan Mfg. LLC","Metro Freight Co.","Apex Medical Group","Dallas Roofing LLC","Sun Valley Resort" };
        var subjs  = new[]{ "Discussed renewal options","Sent proposal document","Left voicemail","Policy review completed","Reviewed coverage gap","Confirmed effective date","Emailed quote summary" };

        _activities = Enumerable.Range(0, 12).Select(i => new ActivityItem(
            subjs[rnd.Next(subjs.Length)],
            accts[rnd.Next(accts.Length)],
            types[rnd.Next(types.Length)],
            DateTime.Now.AddMinutes(-rnd.Next(5, 480))
        )).OrderByDescending(a => a.LoggedAt).ToList();
    }

    void Refresh() => BuildStub();

    RenderFragment KpiCard(string icon, string label, string val, string css, string href) =>
        @<button class="mw-kpi-card @css" @onclick="() => Nav.NavigateTo(href)">
            <div class="mw-kpi-val">@val</div>
            <div class="mw-kpi-lbl"><i class="bi @icon" aria-hidden="true"></i> @label</div>
        </button>;

    static string ActivityIcon(string t) => t switch
    {
        "Call"    => "bi-telephone-fill",
        "Email"   => "bi-envelope-fill",
        "Meeting" => "bi-calendar-event-fill",
        "Task"    => "bi-check2-square",
        _         => "bi-sticky-fill"
    };

    static string FormatAge(DateTime dt)
    {
        var diff = DateTime.Now - dt;
        if (diff.TotalMinutes < 60)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours   < 24)  return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }
}
