@page "/workbench/activities"
@namespace Ams.Web.Components.Pages.Workbench
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Operations
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>My Activities — AMS</PageTitle>

@if (_toastMessage is not null)
{
    <div class="mt-toast @(_toastIsError ? "mt-toast--danger" : "mt-toast--success")" role="status">
        <i class="bi @(_toastIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" @onclick="ClearToast" aria-label="Close notification"><i class="bi bi-x-lg"></i></button>
    </div>
}

<AppPageHeader Title="My Activities"
               Subtitle="Tenant Admin activity stream for calls, emails, meetings, tasks, notes and workflow follow-through"
               Icon="bi-lightning">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh activities">
            <i class="bi bi-arrow-clockwise @(_loading ? "ad-spin" : "")" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-primary" @onclick="LogActivity">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Log Activity
        </button>
    </Actions>
</AppPageHeader>

<section class="ma-hero">
    <div>
        <span class="ma-eyebrow">Tenant Admin Workbench</span>
        <h2>Activity Command Stream</h2>
        <p>Review tenant admin touchpoints, filter by activity type or date, and keep operational follow-through documented.</p>
    </div>
    <div class="ma-hero-actions">
        <button class="um-btn um-btn-primary" @onclick="LogActivity"><i class="bi bi-plus-lg"></i> Log Activity</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/ops/activities")'><i class="bi bi-clock-history"></i> Activity History</button>
    </div>
</section>

<div class="ma-kpi-strip">
    @KpiCard("bi-lightning-charge", "Total", _rows.Count.ToString(), "All activities", "ma-kpi-total", null)
    @KpiCard("bi-calendar-check", "Today", _rows.Count(IsToday).ToString(), "Activities logged today", "ma-kpi-today", "__today")
    @KpiCard("bi-telephone", "Calls", _rows.Count(r => r.ActivityTypeCode == "Call").ToString(), "Call activities", "ma-kpi-call", "Call")
    @KpiCard("bi-envelope", "Emails", _rows.Count(r => r.ActivityTypeCode == "Email").ToString(), "Email activities", "ma-kpi-email", "Email")
    @KpiCard("bi-calendar-event", "Meetings", _rows.Count(r => r.ActivityTypeCode == "Meeting").ToString(), "Meeting activities", "ma-kpi-meet", "Meeting")
    @KpiCard("bi-check2-square", "Tasks", _rows.Count(r => r.ActivityTypeCode == "Task").ToString(), "Task activities", "ma-kpi-task", "Task")
    @KpiCard("bi-sticky", "Notes", _rows.Count(r => r.ActivityTypeCode == "Note").ToString(), "Note activities", "ma-kpi-note", "Note")
</div>

<div class="ma-filter-bar">
    <div class="ma-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="ma-search" @bind="_search" @bind:event="oninput" placeholder="Search subject, notes, type…" />
    </div>
    <div class="ma-type-pills">
        @foreach (var t in ActivityTypes)
        {
            <button class="ma-pill @(_activeFilter == t ? "ma-pill-active" : "")" @onclick="() => SetFilter(t)">@t</button>
        }
    </div>
    <select class="ma-filter-sel" @bind="_dateFilter">
        <option value="0">All dates</option>
        <option value="7">Last 7 days</option>
        <option value="14">Last 14 days</option>
        <option value="30">Last 30 days</option>
    </select>
    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button>
    <span class="ma-filter-count">@Filtered.Count() activities</span>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger mt-load-error" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

@if (_loading)
{
    <div class="mt-loading" aria-live="polite"><div class="um-spinner" aria-hidden="true"></div><span>Loading Tenant Admin activities…</span></div>
}

<div class="ma-view-tabs">
    @foreach (var tab in _tabs)
    {
        <button class="ma-view-tab @(_activeTab == tab.Key ? "ma-view-tab--active" : "")" @onclick="() => _activeTab = tab.Key">
            <i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label <span class="ma-tab-count">@Filtered.Count()</span>
        </button>
    }
</div>

<div class="ma-content">
    @if (_activeTab == "feed")
    {
        <div class="ma-feed">
            @foreach (var grp in Filtered.GroupBy(r => r.ActivityDate).OrderByDescending(g => g.Key))
            {
                <div class="ma-date-sep"><span>@FormatDateGroup(grp.Key)</span></div>
                @foreach (var r in grp.OrderByDescending(x => x.CreatedDateUtc))
                {
                    <div class="ma-feed-item @(_selected?.ActivityId == r.ActivityId ? "ma-feed-item--selected" : null)" @onclick="() => SelectActivity(r)">
                        <div class="ma-feed-icon ma-type-@TypeCss(r.ActivityTypeCode)"><i class="bi @TypeIcon(r.ActivityTypeCode)" aria-hidden="true"></i></div>
                        <div class="ma-feed-body">
                            <div class="ma-feed-hdr">
                                <span class="ma-feed-acct">@r.Subject</span>
                                <span class="ma-type-chip ma-tc-@TypeCss(r.ActivityTypeCode)">@r.ActivityTypeCode</span>
                                @if (r.PerformedByUserId == TenantAdminUserId)
                                {
                                    <span class="ma-done-chip"><i class="bi bi-person-check"></i> Tenant Admin</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(r.Notes))
                            {
                                <div class="ma-feed-notes">@r.Notes</div>
                            }
                            <div class="ma-feed-meta">
                                <span><i class="bi bi-calendar3"></i> @r.ActivityDate.ToString("MMM d, yyyy")</span>
                                <span><i class="bi bi-clock"></i> Logged @r.CreatedDateUtc.ToLocalTime().ToString("h:mm tt")</span>
                            </div>
                        </div>
                        <div class="ma-row-actions" @onclick:stopPropagation="true">
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenDetail(r)"><i class="bi bi-arrow-up-right-square"></i></button>
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenEdit(r)"><i class="bi bi-pencil"></i></button>
                            <button class="um-btn um-btn-ghost um-btn-xs ma-danger" @onclick="() => ShowDelete(r)"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>
                }
            }
            @if (!Filtered.Any())
            {
                <div class="ma-empty"><i class="bi bi-lightning ma-empty-icon" aria-hidden="true"></i><span>No activities match the current filters.</span></div>
            }
        </div>
    }
    else
    {
        <div class="ma-table-wrap">
            <table class="ma-table">
                <thead><tr><th>Date</th><th>Type</th><th>Subject</th><th>Notes</th><th>Logged</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in Filtered.ToList())
                    {
                        <tr class="@(_selected?.ActivityId == r.ActivityId ? "ma-table-row--selected" : null)" @onclick="() => SelectActivity(r)">
                            <td>@r.ActivityDate.ToString("MM/dd/yyyy")</td>
                            <td><span class="ma-type-chip ma-tc-@TypeCss(r.ActivityTypeCode)"><i class="bi @TypeIcon(r.ActivityTypeCode)"></i> @r.ActivityTypeCode</span></td>
                            <td>@r.Subject</td>
                            <td>@(string.IsNullOrWhiteSpace(r.Notes) ? "—" : r.Notes)</td>
                            <td>@r.CreatedDateUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                            <td class="ma-table-actions" @onclick:stopPropagation="true">
                                <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenDetail(r)"><i class="bi bi-arrow-up-right-square"></i></button>
                                <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenEdit(r)"><i class="bi bi-pencil"></i></button>
                                <button class="um-btn um-btn-ghost um-btn-xs ma-danger" @onclick="() => ShowDelete(r)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_selected is not null)
{
    <aside class="ma-detail-panel">
        <div class="ma-detail-header"><span class="ma-type-chip ma-tc-@TypeCss(_selected.ActivityTypeCode)">@_selected.ActivityTypeCode</span><button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _selected = null"><i class="bi bi-x-lg"></i></button></div>
        <h3>@_selected.Subject</h3>
        <p>@(string.IsNullOrWhiteSpace(_selected.Notes) ? "No notes recorded." : _selected.Notes)</p>
        <div class="ma-detail-grid">
            <div><span>Date</span><strong>@_selected.ActivityDate.ToString("MMM d, yyyy")</strong></div>
            <div><span>Logged</span><strong>@_selected.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</strong></div>
            <div><span>Performed By</span><strong>@(_selected.PerformedByUserId == TenantAdminUserId ? "Tenant Admin" : "Assigned user")</strong></div>
        </div>
        <div class="ma-detail-actions"><button class="um-btn um-btn-primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil"></i> Edit</button><button class="um-btn um-btn-ghost" @onclick="() => OpenDetail(_selected)"><i class="bi bi-arrow-up-right-square"></i> Detail</button><button class="um-btn um-btn-danger" @onclick="() => ShowDelete(_selected)"><i class="bi bi-trash"></i> Delete</button></div>
    </aside>
}

@if (_showForm)
{
    <div class="mt-modal-backdrop" @onclick="CloseForm">
        <div class="mt-modal" @onclick:stopPropagation="true">
            <div class="um-modal-header"><i class="bi bi-lightning"></i><span>@(_editId.HasValue ? "Edit Activity" : "Log Activity")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.ActivityDate" class="um-input" /><ValidationMessage For="() => _form.ActivityDate" class="text-danger" /></div>
                    <div class="um-field"><label>Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.ActivityTypeCode" class="um-input">@foreach (var type in ActivityTypes) { <option>@type</option> }</InputSelect><ValidationMessage For="() => _form.ActivityTypeCode" class="text-danger" /></div>
                    <div class="um-field um-field--full"><label>Subject <span class="text-danger">*</span></label><InputText @bind-Value="_form.Subject" class="um-input" /><ValidationMessage For="() => _form.Subject" class="text-danger" /></div>
                    <div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_form.Notes" class="um-input" rows="4" /><ValidationMessage For="() => _form.Notes" class="text-danger" /></div>
                </div></div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Save</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showDelete && _selected is not null)
{
    <div class="mt-modal-backdrop" @onclick="() => _showDelete = false">
        <div class="um-confirm-dialog mt-confirm" @onclick:stopPropagation="true">
            <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash"></i></div>
            <div class="um-confirm-title">Delete activity?</div>
            <div class="um-confirm-text">This will remove <strong>@_selected.Subject</strong> from the Tenant Admin activity stream.</div>
            <div class="um-modal-footer"><button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button><button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div>
        </div>
    </div>
}

@code {
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    static readonly string[] ActivityTypes = ["Call", "Email", "Meeting", "Task", "Note", "Workflow"];

    string _search = string.Empty;
    string _activeFilter = string.Empty;
    int _dateFilter;
    string _activeTab = "feed";
    string? _loadError;
    string? _toastMessage;
    bool _toastIsError;
    bool _loading;
    bool _saving;
    bool _showForm;
    bool _showDelete;
    Guid? _editId;
    OperationalActivityLogDto? _selected;
    ActivityForm _form = new();
    readonly List<OperationalActivityLogDto> _rows = [];
    readonly TabDef[] _tabs = [new("feed", "Activity Feed", "bi-rss"), new("table", "Table View", "bi-table")];

    IEnumerable<OperationalActivityLogDto> Filtered => _rows.Where(r =>
        (string.IsNullOrEmpty(_search) || r.Subject.Contains(_search, StringComparison.OrdinalIgnoreCase) || r.ActivityTypeCode.Contains(_search, StringComparison.OrdinalIgnoreCase) || (r.Notes?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
        && (string.IsNullOrEmpty(_activeFilter) || _activeFilter switch { "__today" => IsToday(r), _ => r.ActivityTypeCode == _activeFilter })
        && (_dateFilter == 0 || r.ActivityDate >= DateOnly.FromDateTime(DateTime.Today.AddDays(-_dateFilter)))
    ).OrderByDescending(r => r.ActivityDate).ThenByDescending(r => r.CreatedDateUtc);

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Workbench", "/workbench"), new("My Activities", "/workbench/activities"));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchOperationalActivitiesAsync(TenantId, searchTerm: _search, pageSize: 250);
            _rows.Clear();
            _rows.AddRange(result?.Items ?? []);
            _selected = _selected is null ? Filtered.FirstOrDefault() : Filtered.FirstOrDefault(x => x.ActivityId == _selected.ActivityId) ?? Filtered.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load activities: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    void SetFilter(string? filter) => _activeFilter = _activeFilter == (filter ?? string.Empty) ? string.Empty : (filter ?? string.Empty);
    void ResetFilters() { _search = string.Empty; _activeFilter = string.Empty; _dateFilter = 0; }
    void SelectActivity(OperationalActivityLogDto item) => _selected = item;
    void OpenDetail(OperationalActivityLogDto item) => Nav.NavigateTo($"/workbench/activities/{item.ActivityId}");
    void LogActivity() { _editId = null; _form = new() { ActivityDate = DateOnly.FromDateTime(DateTime.Today), ActivityTypeCode = "Note" }; _showForm = true; }
    void OpenEdit(OperationalActivityLogDto item) { _editId = item.ActivityId; _form = new() { ActivityDate = item.ActivityDate, ActivityTypeCode = item.ActivityTypeCode, Subject = item.Subject, Notes = item.Notes }; _showForm = true; }
    void ShowDelete(OperationalActivityLogDto item) { _selected = item; _showDelete = true; }
    void CloseForm() { _showForm = false; ResetForm(); }
    void ResetForm() => _form = new();
    void ShowToast(string message, bool isError = false) { _toastMessage = message; _toastIsError = isError; }
    void ClearToast() => _toastMessage = null;

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue)
                await Api.UpdateOperationalActivityAsync(_editId.Value, new() { ActivityDate = _form.ActivityDate, ActivityTypeCode = _form.ActivityTypeCode, Subject = _form.Subject, Notes = _form.Notes, PerformedByUserId = TenantAdminUserId, ModifiedByUserId = TenantAdminUserId });
            else
                await Api.CreateOperationalActivityAsync(new() { TenantId = TenantId, ActivityDate = _form.ActivityDate, ActivityTypeCode = _form.ActivityTypeCode, Subject = _form.Subject, Notes = _form.Notes, PerformedByUserId = TenantAdminUserId, CreatedByUserId = TenantAdminUserId });

            _showForm = false;
            ShowToast("Activity saved");
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast($"Save failed: {ex.Message}", isError: true); }
        finally { _saving = false; }
    }

    async Task ExecuteDeleteAsync()
    {
        if (_selected is null) return;
        _saving = true;
        try { await Api.DeleteOperationalActivityAsync(_selected.ActivityId, TenantAdminUserId); _showDelete = false; ShowToast("Activity deleted"); await LoadAsync(); }
        catch (Exception ex) { ShowToast($"Delete failed: {ex.Message}", isError: true); }
        finally { _saving = false; }
    }

    static bool IsToday(OperationalActivityLogDto item) => item.ActivityDate == DateOnly.FromDateTime(DateTime.Today);
    static string TypeCss(string type) => type.ToLowerInvariant().Replace(" ", "-");
    static string TypeIcon(string type) => type switch { "Call" => "bi-telephone-fill", "Email" => "bi-envelope-fill", "Meeting" => "bi-calendar-event-fill", "Task" => "bi-check2-square", "Workflow" => "bi-diagram-3-fill", _ => "bi-sticky-fill" };
    static string FormatDateGroup(DateOnly date) => date == DateOnly.FromDateTime(DateTime.Today) ? "Today" : date == DateOnly.FromDateTime(DateTime.Today.AddDays(-1)) ? "Yesterday" : date.ToString("dddd, MMMM d");

    RenderFragment KpiCard(string icon, string label, string val, string title, string css, string? filter) => @<button class="ma-kpi-card @css @(_activeFilter == (filter ?? string.Empty) ? "ma-kpi-active" : "")" title="@title" @onclick="() => SetFilter(filter)"><div class="ma-kpi-val">@val</div><div class="ma-kpi-lbl"><i class="bi @icon" aria-hidden="true"></i> @label</div></button>;
    sealed record TabDef(string Key, string Label, string Icon);
    sealed class ActivityForm { [Required] public DateOnly ActivityDate { get; set; } = DateOnly.FromDateTime(DateTime.Today); [Required, StringLength(50)] public string ActivityTypeCode { get; set; } = "Note"; [Required, StringLength(200)] public string Subject { get; set; } = string.Empty; [StringLength(2000)] public string? Notes { get; set; } }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
