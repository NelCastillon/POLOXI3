@page "/workbench/activities"
@namespace Ams.Web.Components.Pages.Workbench
@using System.Globalization
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Operations
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>My Activities ? AMS</PageTitle>

<div class="act-enterprise-page">
    @if (_toastMessage is not null)
    {
        <div class="act-toast @(_toastIsError ? "act-toast-danger" : "act-toast-success")" role="status" aria-live="polite">
            <i class="bi @(_toastIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
            <span>@_toastMessage</span>
            <button type="button" class="act-toast-close" @onclick="ClearToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
    }

    <section class="act-hero" aria-labelledby="activities-title">
        <div class="act-hero-left">
            <span class="act-hero-icon"><i class="bi bi-lightning-charge" aria-hidden="true"></i></span>
            <div>
                <div class="act-title-row">
                    <h1 id="activities-title">My Activities</h1>
                    <span><i class="bi bi-person-check" aria-hidden="true"></i> Tenant Admin command stream</span>
                </div>
                <p>Track calls, emails, meetings, tasks, notes, and workflow follow-through in a polished enterprise workspace synced to operational activity history.</p>
            </div>
        </div>
        <div class="act-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/ops/activities")'>
                <i class="bi bi-clock-history" aria-hidden="true"></i> Activity History
            </button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync">
                <i class="bi bi-download" aria-hidden="true"></i> Export
            </button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "act-spin" : null)" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="um-btn um-btn-primary" @onclick="LogActivity">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Log Activity
            </button>
        </div>
    </section>

    <section class="act-insight-strip" aria-label="Activity summary">
        <article class="act-insight-card act-insight-primary">
            <span class="act-insight-icon"><i class="bi bi-activity" aria-hidden="true"></i></span>
            <div><small>Activity pulse</small><strong>@ActivityPulse</strong></div>
        </article>
        <article class="act-insight-card">
            <span class="act-insight-icon act-tone-info"><i class="bi bi-calendar-check" aria-hidden="true"></i></span>
            <div><small>Today</small><strong>@_rows.Count(IsToday)</strong></div>
        </article>
        <article class="act-insight-card">
            <span class="act-insight-icon act-tone-success"><i class="bi bi-person-lines-fill" aria-hidden="true"></i></span>
            <div><small>Tenant Admin</small><strong>@_rows.Count(r => r.PerformedByUserId == TenantAdminUserId)</strong></div>
        </article>
        <article class="act-insight-card">
            <span class="act-insight-icon act-tone-warning"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
            <div><small>Last 7 days</small><strong>@_rows.Count(IsLastSevenDays)</strong></div>
        </article>
    </section>

    <section class="act-ops-strip" aria-label="Activity controls">
        <div class="act-scope-card">
            <div class="act-scope-head">
                <span><i class="bi bi-funnel" aria-hidden="true"></i> Work scope</span>
                <strong>@(string.IsNullOrWhiteSpace(_activeFilter) ? "All activities" : FilterLabel)</strong>
            </div>
            <div class="act-scope-grid">
                <label>
                    Type
                    <select class="act-filter-select" @bind="_activeFilter">
                        <option value="">All types</option>
                        @foreach (var type in _activityTypes)
                        {
                            <option value="@type.OptionCode">@type.DisplayName</option>
                        }
                    </select>
                </label>
                <label>
                    Date range
                    <select class="act-filter-select" @bind="_dateFilter">
                        <option value="0">All dates</option>
                        <option value="7">Last 7 days</option>
                        <option value="14">Last 14 days</option>
                        <option value="30">Last 30 days</option>
                    </select>
                </label>
                <label>
                    View
                    <select class="act-filter-select" @bind="_activeTab">
                        @foreach (var tab in _tabs)
                        {
                            <option value="@tab.Key">@tab.Label</option>
                        }
                    </select>
                </label>
                <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters">
                    <i class="bi bi-eraser" aria-hidden="true"></i> Reset
                </button>
            </div>
        </div>

        <div class="act-ai-card">
            <div class="act-ai-head">
                <span><i class="bi bi-stars" aria-hidden="true"></i> Activity brief</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="GenerateBriefAsync">
                    <i class="bi bi-magic" aria-hidden="true"></i> Generate
                </button>
            </div>
            <p>@_activityBrief</p>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger act-error-banner" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="act-kpi-strip" aria-label="Activity KPI filters">
        @foreach (var metric in Kpis)
        {
            <button type="button" class="@MetricCardClass(metric)" title="@metric.Title" @onclick="() => SetFilter(metric.Filter)">
                <span class="act-kpi-icon @metric.Tone"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span>
                    <strong class="act-kpi-val">@metric.Value</strong>
                    <span class="act-kpi-lbl">@metric.Label</span>
                    <small>@metric.Caption</small>
                </span>
            </button>
        }
    </section>

    <section class="act-workflow-strip" aria-label="Activity workflow shortcuts">
        <button type="button" class="act-workflow-card" @onclick="LogActivity">
            <i class="bi bi-plus-circle" aria-hidden="true"></i>
            <span><strong>Log activity</strong><span>Create a call, email, meeting, task, note, or workflow entry</span></span>
        </button>
        <button type="button" class="act-workflow-card" @onclick='() => SetFilter("__today")'>
            <i class="bi bi-calendar-day" aria-hidden="true"></i>
            <span><strong>Today's stream</strong><span>@_rows.Count(IsToday) items logged today</span></span>
        </button>
        <button type="button" class="act-workflow-card" @onclick='() => { _dateFilter = 7; _activeFilter = string.Empty; }'>
            <i class="bi bi-clock-history" aria-hidden="true"></i>
            <span><strong>Recent follow-through</strong><span>@_rows.Count(IsLastSevenDays) activities in the last 7 days</span></span>
        </button>
        <button type="button" class="act-workflow-card" @onclick='() => Nav.NavigateTo("/ops/activities")'>
            <i class="bi bi-journal-text" aria-hidden="true"></i>
            <span><strong>Activity ledger</strong><span>Open tenant-wide activity history</span></span>
        </button>
    </section>

    <section class="act-search-panel" aria-label="Search activities">
        <div class="act-search-wrap">
            <i class="bi bi-search act-search-icon" aria-hidden="true"></i>
            <div class="act-search-body">
                <label for="activity-search">Search activity stream</label>
                <input id="activity-search" class="act-search-input" type="search" placeholder="Search subject, notes, activity type, or logged context?" @bind="_search" @bind:event="oninput" />
                <span class="act-search-hint">Cards, table, analytics, and detail panel update from the active filters.</span>
            </div>
        </div>
        <div class="act-search-result">
            <strong>@Filtered.Count()</strong>
            <span>visible</span>
        </div>
    </section>

    <section class="act-view-tabs" role="tablist" aria-label="Activity views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="act-view-btn @(_activeTab == tab.Key ? "act-view-btn-active" : null)" role="tab" aria-selected="@(_activeTab == tab.Key)" @onclick="() => _activeTab = tab.Key">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                @tab.Label
                <span>@TabCount(tab.Key)</span>
            </button>
        }
    </section>

    <section class="act-content-layout">
        <main class="act-main-card" aria-live="polite">
            <div class="act-section-head">
                <div>
                    <h2>@ActiveViewTitle</h2>
                    <p>@ActiveViewSubtitle</p>
                </div>
                <span class="act-status act-status-open">@Filtered.Count() active</span>
            </div>

            @if (_loading)
            {
                <div class="act-loading">
                    <i class="bi bi-arrow-repeat act-spin" aria-hidden="true"></i>
                    <strong>Loading Tenant Admin activities?</strong>
                    <span>Synchronizing operational activity history.</span>
                </div>
            }
            else if (_activeTab == "analytics")
            {
                <div class="act-analytics-grid">
                    <section>
                        <h3>Type distribution</h3>
                        @foreach (var row in TypeDistribution)
                        {
                            <button type="button" class="act-analytics-row" @onclick="() => SetFilter(row.Filter)">
                                <span>@row.Label</span>
                                <div><i class="@row.Tone" style="@WidthStyle(row.Count, _rows.Count)"></i></div>
                                <strong>@row.Count</strong>
                                <small>@PercentLabel(row.Count, _rows.Count)</small>
                            </button>
                        }
                    </section>
                    <section>
                        <h3>Date pressure</h3>
                        @foreach (var row in DateDistribution)
                        {
                            <button type="button" class="act-analytics-row" @onclick="() => SetDateFilter(row.DateFilter)">
                                <span>@row.Label</span>
                                <div><i class="@row.Tone" style="@WidthStyle(row.Count, _rows.Count)"></i></div>
                                <strong>@row.Count</strong>
                                <small>@PercentLabel(row.Count, _rows.Count)</small>
                            </button>
                        }
                    </section>
                    <section>
                        <h3>Productivity</h3>
                        <div class="act-stat-stack">
                            <div><span>Today</span><strong>@_rows.Count(IsToday)</strong></div>
                            <div><span>This week</span><strong>@_rows.Count(IsLastSevenDays)</strong></div>
                            <div><span>Notes</span><strong>@_rows.Count(r => r.ActivityTypeCode == "Note")</strong></div>
                            <div><span>Workflow</span><strong>@_rows.Count(r => r.ActivityTypeCode == "Workflow")</strong></div>
                        </div>
                    </section>
                </div>
            }
            else if (_activeTab == "table")
            {
                <div class="act-table-wrap">
                    <table class="act-table">
                        <thead><tr><th>Date</th><th>Type</th><th>Subject</th><th>Notes</th><th>Logged</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var item in Filtered.ToList())
                            {
                                <tr class="@(_selected?.ActivityId == item.ActivityId ? "act-table-row-selected" : null)" @onclick="() => SelectActivity(item)">
                                    <td>@item.ActivityDate.ToString("MM/dd/yyyy", CultureInfo.CurrentCulture)</td>
                                    <td><span class="@TypeChip(item.ActivityTypeCode)"><i class="bi @TypeIcon(item.ActivityTypeCode)" aria-hidden="true"></i> @item.ActivityTypeCode</span></td>
                                    <td><strong>@item.Subject</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "?" : item.Notes)</td>
                                    <td>@item.CreatedDateUtc.ToLocalTime().ToString("MMM d, h:mm tt", CultureInfo.CurrentCulture)</td>
                                    <td class="act-table-actions" @onclick:stopPropagation="true">
                                        <button type="button" class="act-card-open" @onclick="() => SelectActivity(item)" title="Preview details" aria-label="Preview details">???</button>
                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm act-danger" @onclick="() => ShowDelete(item)" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                @if (!Filtered.Any())
                {
                    <div class="act-empty-state">
                        <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                        <strong>No activities match this view</strong>
                        <span>Try clearing filters or logging a new activity.</span>
                        <button type="button" class="um-btn um-btn-primary" @onclick="LogActivity"><i class="bi bi-plus-lg" aria-hidden="true"></i> Log Activity</button>
                    </div>
                }
                else
                {
                    <div class="act-feed">
                        @foreach (var grp in Filtered.GroupBy(r => r.ActivityDate).OrderByDescending(g => g.Key))
                        {
                            <div class="act-date-sep"><span>@FormatDateGroup(grp.Key)</span></div>
                            <div class="act-card-grid">
                                @foreach (var item in grp.OrderByDescending(x => x.CreatedDateUtc))
                                {
                                    <article class="act-item-card @(_selected?.ActivityId == item.ActivityId ? "act-item-selected" : null)" @onclick="() => SelectActivity(item)">
                                        <div class="act-item-top">
                                            <span class="act-avatar @TypeTone(item.ActivityTypeCode)"><i class="bi @TypeIcon(item.ActivityTypeCode)" aria-hidden="true"></i></span>
                                            <div>
                                                <strong>@item.Subject</strong>
                                                <span>@(string.IsNullOrWhiteSpace(item.Notes) ? "No notes recorded" : item.Notes)</span>
                                            </div>
                                        </div>
                                        <div class="act-item-meta">
                                            <span class="@TypeChip(item.ActivityTypeCode)">@item.ActivityTypeCode</span>
                                            @if (item.PerformedByUserId == TenantAdminUserId)
                                            {
                                                <span class="act-status act-status-approved"><i class="bi bi-person-check" aria-hidden="true"></i> Tenant Admin</span>
                                            }
                                            <span class="act-age">@FormatAge(item.CreatedDateUtc.ToLocalTime())</span>
                                        </div>
                                        <div class="act-item-footer">
                                            <div>
                                                <strong>@item.ActivityDate.ToString("MMM d, yyyy", CultureInfo.CurrentCulture)</strong>
                                                <span>Logged @item.CreatedDateUtc.ToLocalTime().ToString("h:mm tt", CultureInfo.CurrentCulture)</span>
                                            </div>
                                            <div class="act-item-actions" @onclick:stopPropagation="true">
                                                <button type="button" class="act-card-open" @onclick="() => SelectActivity(item)" title="Preview details" aria-label="Preview details">???</button>
                                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                                <button type="button" class="um-btn um-btn-ghost um-btn-sm act-danger" @onclick="() => ShowDelete(item)" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                            </div>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </main>

        <aside class="act-detail-card" aria-label="Activity detail">
            @if (_selected is null)
            {
                <div class="act-detail-empty">
                    <i class="bi bi-layout-sidebar-inset-reverse" aria-hidden="true"></i>
                    <strong>Select an activity</strong>
                    <span>Preview notes, activity type, logged details, and available actions.</span>
                </div>
            }
            else
            {
                <div class="act-detail-head">
                    <div>
                        <span class="act-detail-eyebrow"><i class="bi @TypeIcon(_selected.ActivityTypeCode)" aria-hidden="true"></i> @_selected.ActivityTypeCode</span>
                        <h2>@_selected.Subject</h2>
                        <p>@(string.IsNullOrWhiteSpace(_selected.Notes) ? "No notes recorded." : _selected.Notes)</p>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close detail"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="act-detail-body">
                    <div class="act-detail-summary">
                        <div><span>Date</span><strong>@_selected.ActivityDate.ToString("MMM d, yyyy", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Logged</span><strong>@_selected.CreatedDateUtc.ToLocalTime().ToString("MMM d, h:mm tt", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Performed by</span><strong>@(_selected.PerformedByUserId == TenantAdminUserId ? "Tenant Admin" : "Assigned user")</strong></div>
                        <div><span>Type</span><strong>@_selected.ActivityTypeCode</strong></div>
                    </div>
                    <p class="act-detail-note"><strong>Notes:</strong> @(string.IsNullOrWhiteSpace(_selected.Notes) ? "No notes recorded." : _selected.Notes)</p>
                    <div class="act-detail-actions">
                        <button type="button" class="um-btn um-btn-primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/ops/activities")'><i class="bi bi-clock-history" aria-hidden="true"></i> Ledger</button>
                        <button type="button" class="um-btn um-btn-danger" @onclick="() => ShowDelete(_selected)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@if (_showForm)
{
    <div class="act-modal-backdrop" @onclick="CloseForm">
        <div class="act-modal" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                <span>@(_editId.HasValue ? "Edit Activity" : "Log Activity")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field"><label>Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.ActivityDate" class="um-input" /></div>
                        <div class="um-field"><label>Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.ActivityTypeCode" class="um-input">@foreach (var type in _activityTypes) { <option value="@type.OptionCode">@type.DisplayName</option> }</InputSelect></div>
                        <div class="um-field um-field--full"><label>Subject <span class="text-danger">*</span></label><InputText @bind-Value="_form.Subject" class="um-input" /></div>
                        <div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_form.Notes" class="um-input" rows="4" /></div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_saving ? "Saving?" : "Save")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showDelete && _selected is not null)
{
    <div class="act-modal-backdrop" @onclick="() => _showDelete = false">
        <div class="um-confirm-dialog act-confirm" @onclick:stopPropagation="true">
            <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash" aria-hidden="true"></i></div>
            <div class="um-confirm-title">Delete activity?</div>
            <div class="um-confirm-text">This will remove <strong>@_selected.Subject</strong> from the Tenant Admin activity stream.</div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button><button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div>
        </div>
    </div>
}

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private Guid TenantId { get; set; }
    private Guid TenantAdminUserId { get; set; }
    private static readonly string[] DistributionTones = ["act-dist-blue", "act-dist-amber", "act-dist-green", "act-dist-purple", "act-dist-pink"];

    private string _search = string.Empty;
    private string _activeFilter = string.Empty;
    private int _dateFilter;
    private string _activeTab = "feed";
    private string? _loadError;
    private string? _toastMessage;
    private bool _toastIsError;
    private bool _loading;
    private bool _saving;
    private bool _showForm;
    private bool _showDelete;
    private Guid? _editId;
    private OperationalActivityLogDto? _selected;
    private ActivityForm _form = new();
    private readonly List<OperationalActivityLogDto> _rows = [];
    private readonly List<OperationalOptionDto> _activityTypes = [];
    private readonly TabDef[] _tabs = [new("feed", "Activity Feed", "bi-rss"), new("table", "Table View", "bi-table"), new("analytics", "Analytics", "bi-bar-chart-line")];
    private string _activityBrief = "Generate an activity brief to summarize today's touchpoints, recent follow-through, and activity mix.";

    private IEnumerable<OperationalActivityLogDto> Filtered => _rows.Where(r =>
        (string.IsNullOrEmpty(_search) || r.Subject.Contains(_search, StringComparison.OrdinalIgnoreCase) || r.ActivityTypeCode.Contains(_search, StringComparison.OrdinalIgnoreCase) || (r.Notes?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false))
        && (string.IsNullOrEmpty(_activeFilter) || _activeFilter switch { "__today" => IsToday(r), _ => r.ActivityTypeCode == _activeFilter })
        && (_dateFilter == 0 || r.ActivityDate >= DateOnly.FromDateTime(DateTime.Today.AddDays(-_dateFilter)))
    ).OrderByDescending(r => r.ActivityDate).ThenByDescending(r => r.CreatedDateUtc);

    private string ActivityPulse => _rows.Count(IsToday) switch { >= 12 => "High touch", >= 6 => "Active", >= 1 => "Steady", _ => "Quiet" };
    private string FilterLabel => _activeFilter == "__today" ? "Today" : _activeFilter;
    private string ActiveViewTitle => _activeTab switch { "table" => "Activity table", "analytics" => "Activity analytics", _ => "Activity feed" };
    private string ActiveViewSubtitle => _activeTab switch { "table" => "Structured view of activity records with inline actions.", "analytics" => "Type distribution, date pressure, and productivity mix.", _ => "Timeline-style activity stream grouped by activity date." };

    private IEnumerable<KpiMetric> Kpis =>
    [
        new(null, "Total", _rows.Count.ToString(CultureInfo.CurrentCulture), "All activities", "bi-lightning-charge", "act-tone-info", "All logged activity records"),
        new("__today", "Today", _rows.Count(IsToday).ToString(CultureInfo.CurrentCulture), "Logged today", "bi-calendar-check", "act-tone-success", "Activities logged today"),
        new("Call", "Calls", _rows.Count(r => r.ActivityTypeCode == "Call").ToString(CultureInfo.CurrentCulture), "Phone touchpoints", "bi-telephone", "act-tone-info", "Call activities"),
        new("Email", "Emails", _rows.Count(r => r.ActivityTypeCode == "Email").ToString(CultureInfo.CurrentCulture), "Email follow-up", "bi-envelope", "act-tone-purple", "Email activities"),
        new("Meeting", "Meetings", _rows.Count(r => r.ActivityTypeCode == "Meeting").ToString(CultureInfo.CurrentCulture), "Scheduled meetings", "bi-calendar-event", "act-tone-warning", "Meeting activities"),
        new("Task", "Tasks", _rows.Count(r => r.ActivityTypeCode == "Task").ToString(CultureInfo.CurrentCulture), "Task follow-through", "bi-check2-square", "act-tone-success", "Task activities"),
        new("Note", "Notes", _rows.Count(r => r.ActivityTypeCode == "Note").ToString(CultureInfo.CurrentCulture), "Documentation", "bi-sticky", "act-tone-muted", "Note activities"),
    ];

    private IEnumerable<AnalyticsRow> TypeDistribution => _activityTypes.Select((type, index) => new AnalyticsRow(type.DisplayName, _rows.Count(r => r.ActivityTypeCode == type.OptionCode), type.OptionCode, 0, DistTone(index)));
    private IEnumerable<AnalyticsRow> DateDistribution => [new("Today", _rows.Count(IsToday), "__today", 0, "act-dist-green"), new("Last 7 days", _rows.Count(IsLastSevenDays), string.Empty, 7, "act-dist-blue"), new("Last 14 days", _rows.Count(r => r.ActivityDate >= DateOnly.FromDateTime(DateTime.Today.AddDays(-14))), string.Empty, 14, "act-dist-amber"), new("Last 30 days", _rows.Count(r => r.ActivityDate >= DateOnly.FromDateTime(DateTime.Today.AddDays(-30))), string.Empty, 30, "act-dist-purple")];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Workbench", "/workbench"), new("My Activities", "/workbench/activities"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var activityTypes = await Api.GetOperationalOptionsAsync(TenantId, "ActivityType");
            _activityTypes.Clear();
            _activityTypes.AddRange(activityTypes ?? []);
            var result = await Api.SearchOperationalActivitiesAsync(TenantId, searchTerm: _search, pageSize: 250);
            _rows.Clear();
            _rows.AddRange(result?.Items ?? []);
            _selected = _selected is null ? Filtered.FirstOrDefault() : Filtered.FirstOrDefault(x => x.ActivityId == _selected.ActivityId) ?? Filtered.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load activities: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", isError: true);
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetFilter(string? filter) => _activeFilter = _activeFilter == (filter ?? string.Empty) ? string.Empty : (filter ?? string.Empty);
    private void SetDateFilter(int days) { _dateFilter = days; _activeFilter = string.Empty; }
    private void ResetFilters() { _search = string.Empty; _activeFilter = string.Empty; _dateFilter = 0; }
    private void SelectActivity(OperationalActivityLogDto item) => _selected = item;
    private void LogActivity() { _editId = null; _form = new() { ActivityDate = DateOnly.FromDateTime(DateTime.Today), ActivityTypeCode = _activityTypes.FirstOrDefault(x => x.IsDefault)?.OptionCode ?? string.Empty }; _showForm = true; }
    private void OpenEdit(OperationalActivityLogDto item) { _editId = item.ActivityId; _form = new() { ActivityDate = item.ActivityDate, ActivityTypeCode = item.ActivityTypeCode, Subject = item.Subject, Notes = item.Notes }; _showForm = true; }
    private void ShowDelete(OperationalActivityLogDto item) { _selected = item; _showDelete = true; }
    private void CloseForm() { _showForm = false; ResetForm(); }
    private void ResetForm() => _form = new();
    private void ShowToast(string message, bool isError = false) { _toastMessage = message; _toastIsError = isError; }
    private void ClearToast() => _toastMessage = null;

    private Task ExportAsync()
    {
        ShowToast($"Export prepared for {Filtered.Count()} activities.");
        return Task.CompletedTask;
    }

    private Task GenerateBriefAsync()
    {
        _activityBrief = Filtered.Any()
            ? $"There are {Filtered.Count()} visible activities, including {_rows.Count(IsToday)} logged today and {_rows.Count(IsLastSevenDays)} in the last 7 days. The leading activity type is {TopActivityType}."
            : "No visible activities match the current filters. Clear filters or log a new activity to restart the command stream.";
        ShowToast("Activity brief generated.");
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue)
                await Api.UpdateOperationalActivityAsync(_editId.Value, new() { ActivityDate = _form.ActivityDate, ActivityTypeCode = _form.ActivityTypeCode, Subject = _form.Subject, Notes = _form.Notes, PerformedByUserId = TenantAdminUserId, ModifiedByUserId = TenantAdminUserId });
            else
                await Api.CreateOperationalActivityAsync(new() { TenantId = TenantId, ActivityDate = _form.ActivityDate, ActivityTypeCode = _form.ActivityTypeCode, Subject = _form.Subject, Notes = _form.Notes, PerformedByUserId = TenantAdminUserId, CreatedByUserId = TenantAdminUserId });

            _showForm = false;
            ShowToast("Activity saved");
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast($"Save failed: {ex.Message}", isError: true); }
        finally { _saving = false; }
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_selected is null) return;
        _saving = true;
        try
        {
            await Api.DeleteOperationalActivityAsync(_selected.ActivityId, TenantAdminUserId);
            _showDelete = false;
            ShowToast("Activity deleted");
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast($"Delete failed: {ex.Message}", isError: true); }
        finally { _saving = false; }
    }

    private string TopActivityType => TypeDistribution.OrderByDescending(x => x.Count).FirstOrDefault(x => x.Count > 0)?.Label ?? "none";
    private int TabCount(string key) => key == "analytics" ? _rows.Count : Filtered.Count();
    private string MetricCardClass(KpiMetric metric) => $"act-kpi-card {(_activeFilter == (metric.Filter ?? string.Empty) ? "act-kpi-card-active" : string.Empty)}";
    private static bool IsToday(OperationalActivityLogDto item) => item.ActivityDate == DateOnly.FromDateTime(DateTime.Today);
    private static bool IsLastSevenDays(OperationalActivityLogDto item) => item.ActivityDate >= DateOnly.FromDateTime(DateTime.Today.AddDays(-7));
    private static string TypeCss(string type) => type.ToLowerInvariant().Replace(" ", "-");
    private static string TypeChip(string type) => $"act-type-chip act-type-{TypeCss(type)}";
    private static string TypeTone(string type) => $"act-type-tone act-type-tone-{TypeCss(type)}";
    private static string TypeIcon(string type) => type switch { "Call" => "bi-telephone-fill", "Email" => "bi-envelope-fill", "Meeting" => "bi-calendar-event-fill", "Task" => "bi-check2-square", "Workflow" => "bi-diagram-3-fill", _ => "bi-sticky-fill" };
    private static string FormatDateGroup(DateOnly date) => date == DateOnly.FromDateTime(DateTime.Today) ? "Today" : date == DateOnly.FromDateTime(DateTime.Today.AddDays(-1)) ? "Yesterday" : date.ToString("dddd, MMMM d", CultureInfo.CurrentCulture);
    private static string FormatAge(DateTime dt) { var diff = DateTime.Now - dt; if (diff.TotalMinutes < 1) return "Just now"; if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m ago"; if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago"; if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d ago"; return dt.ToString("d", CultureInfo.CurrentCulture); }
    private static decimal Percent(int value, int total) => total <= 0 ? 0 : Math.Min(100, Math.Round((decimal)value / total * 100, 1));
    private static string WidthStyle(int value, int total) => string.Concat("width:", Percent(value, Math.Max(1, total)).ToString("0.#", CultureInfo.InvariantCulture), Convert.ToChar(37));
    private static string PercentLabel(int value, int total) => string.Concat(Percent(value, Math.Max(1, total)).ToString("0", CultureInfo.InvariantCulture), Convert.ToChar(37));
    private static string DistTone(int index) => DistributionTones[Math.Abs(index) % DistributionTones.Length];

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private sealed record TabDef(string Key, string Label, string Icon);
    private sealed record KpiMetric(string? Filter, string Label, string Value, string Caption, string Icon, string Tone, string Title);
    private sealed record AnalyticsRow(string Label, int Count, string Filter, int DateFilter, string Tone);
    private sealed class ActivityForm { [Required] public DateOnly ActivityDate { get; set; } = DateOnly.FromDateTime(DateTime.Today); [Required, StringLength(50)] public string ActivityTypeCode { get; set; } = string.Empty; [Required, StringLength(200)] public string Subject { get; set; } = string.Empty; [StringLength(2000)] public string? Notes { get; set; } }
}
