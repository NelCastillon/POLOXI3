@page "/workbench/csr"
@namespace Ams.Web.Components.Pages.Workbench
@using System.Globalization
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@inject ConfirmationDialogService Confirmations

<PageTitle>Enterprise CSR Workbench</PageTitle>

@if (_toastVisible)
{
    <div class="csrw-toast csrw-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="csrw-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="csrw-enterprise-page">
    <section class="csrw-hero">
        <div class="csrw-hero-left">
            <span class="csrw-hero-icon"><i class="bi bi-headset" aria-hidden="true"></i></span>
            <div>
                <div class="csrw-title-row">
                    <h1>CSR Workbench</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live service data</span>
                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> SLA governed</span>
                </div>
                <p>Manage service requests, endorsements, certificates, billing enquiries, complaints, and follow-ups from one full-width enterprise command center.</p>
            </div>
        </div>
        <div class="csrw-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh CSR workbench"><i class="bi @(_loading ? "bi-arrow-repeat csrw-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-ghost" @onclick="GenerateAiSummaryAsync" disabled="@_aiLoading"><i class="bi @(_aiLoading ? "bi-arrow-repeat csrw-spin" : "bi-stars")" aria-hidden="true"></i> AI Summary</button>
            <button class="um-btn um-btn-ghost" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/ops/service-requests?new=true")'><i class="bi bi-plus-lg" aria-hidden="true"></i> New Request</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger csrw-error-banner" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="csrw-insight-strip" aria-label="CSR service insights">
        <article class="csrw-insight-card csrw-insight-primary"><span class="csrw-insight-icon"><i class="bi bi-bullseye" aria-hidden="true"></i></span><div><small>Priority Focus</small><strong>@PriorityFocusText</strong></div></article>
        <article class="csrw-insight-card"><span class="csrw-insight-icon csrw-tone-danger"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i></span><div><small>Breached SLA</small><strong>@BreachedCount</strong></div></article>
        <article class="csrw-insight-card"><span class="csrw-insight-icon csrw-tone-warning"><i class="bi bi-alarm" aria-hidden="true"></i></span><div><small>At Risk</small><strong>@AtRiskCount</strong></div></article>
        <article class="csrw-insight-card"><span class="csrw-insight-icon csrw-tone-success"><i class="bi bi-check2-circle" aria-hidden="true"></i></span><div><small>On Track</small><strong>@OnTrackCount</strong></div></article>
    </section>

    <section class="csrw-ops-strip">
        <article class="csrw-scope-card">
            <div class="csrw-scope-head"><span><i class="bi bi-funnel" aria-hidden="true"></i> Workbench Scope</span><strong>@(_scope.Equals("team", StringComparison.OrdinalIgnoreCase) ? "Team" : "Me")</strong></div>
            <div class="csrw-scope-grid">
                <label><span>Scope</span><select class="csrw-filter-select" value="@_scope" @onchange="ScopeChangedCallback"><option value="me">My queue</option><option value="team">Team queue</option></select></label>
                <label><span>Branch</span><input class="csrw-filter-input" value="@_branchId" @onchange="BranchChangedCallback" placeholder="All branches" /></label>
                <label><span>Team</span><input class="csrw-filter-input" value="@_teamId" @onchange="TeamChangedCallback" placeholder="All teams" /></label>
            </div>
        </article>
        <article class="csrw-ai-card">
            <div class="csrw-ai-head"><span><i class="bi bi-stars" aria-hidden="true"></i> Service Intelligence</span>@if (_aiGeneratedAt.HasValue) { <small>@FormatAge(_aiGeneratedAt.Value)</small> }</div>
            <p>@(_aiSummary ?? "Generate an AI-style service queue summary to prioritize urgent work, SLA breaches, complaints, and overdue follow-ups.")</p>
        </article>
    </section>

    <section class="csrw-kpi-strip" aria-label="CSR queue metrics">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" title="@metric.Caption" @onclick="@(() => SetActiveQueue(metric.QueueId))">
                <span class="csrw-kpi-icon @metric.Tone"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span><span class="csrw-kpi-val">@metric.Value</span><span class="csrw-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
            </button>
        }
    </section>

    <section class="csrw-workflow-strip" aria-label="CSR workflow actions">
        <button class="csrw-workflow-card" @onclick="ShowBreached"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span><strong>Work breaches</strong><span>Filter to breached SLA items.</span></span></button>
        <button class="csrw-workflow-card" @onclick="ShowComplaints"><i class="bi bi-shield-exclamation" aria-hidden="true"></i><span><strong>Resolve complaints</strong><span>Open escalated client issues.</span></span></button>
        <button class="csrw-workflow-card" @onclick="ShowCertificates"><i class="bi bi-patch-check" aria-hidden="true"></i><span><strong>Issue certificates</strong><span>Prioritize COI requests.</span></span></button>
        <button class="csrw-workflow-card" @onclick="ShowFollowUps"><i class="bi bi-alarm" aria-hidden="true"></i><span><strong>Clear follow-ups</strong><span>Focus overdue callbacks.</span></span></button>
    </section>

    <section class="csrw-search-panel">
        <div class="csrw-search-wrap">
            <span class="csrw-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="csrw-search-body">
                <label for="csrSearchInput">Search CSR queue</label>
                <input id="csrSearchInput" class="csrw-search-input" value="@_search" @oninput="SearchChangedCallback" placeholder="Search title, account, ref, policy, holder, channel, category, notes, or assignee..." />
                <span class="csrw-search-hint">Filters apply to the active queue while preserving the synced CSR aggregate.</span>
            </div>
        </div>
        <select class="csrw-filter-select" value="@_filterPriority" @onchange="PriorityChangedCallback" title="Filter priority">
            <option value="">All priorities</option>
            @foreach (var option in _priorityOptions) { <option value="@option.Value">@option.Label</option> }
        </select>
        <select class="csrw-filter-select" value="@_filterSla" @onchange="SlaChangedCallback" title="Filter SLA">
            <option value="">All SLA</option>
            @foreach (var option in _slaOptions) { <option value="@option.Value">@option.Label</option> }
        </select>
        <input class="csrw-filter-input" value="@_filterCategory" @oninput="CategoryChangedCallback" placeholder="Category" title="Filter category" />
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
        <div class="csrw-search-result"><strong>@ActiveQueueCount</strong><span>@ActiveQueueLabel</span></div>
    </section>

    <section class="csrw-view-tabs" aria-label="CSR queue tabs">
        @foreach (var q in Queues)
        {
            <button type="button" class="@QueueTabClass(q.Id)" @onclick="@(() => SetActiveQueue(q.Id))"><i class="@q.Icon" aria-hidden="true"></i> @q.Label @if (q.Badge > 0) { <span class="@(q.IsAlert ? "csrw-tab-alert" : string.Empty)">@q.Badge</span> }</button>
        }
        <button type="button" class="@QueueTabClass("analytics")" @onclick='() => SetActiveQueue("analytics")'><i class="bi bi-bar-chart" aria-hidden="true"></i> Analytics</button>
        <button type="button" class="@QueueTabClass("views")" @onclick='() => SetActiveQueue("views")'><i class="bi bi-bookmark-star" aria-hidden="true"></i> Saved Views @if (_savedViews.Count > 0) { <span>@_savedViews.Count</span> }</button>
    </section>

    <section class="csrw-content-layout">
        <main class="csrw-main-card">
            @if (_loading)
            {
                <div class="csrw-loading"><i class="bi bi-arrow-repeat csrw-spin" aria-hidden="true"></i><strong>Loading CSR workbench...</strong></div>
            }
            else if (_activeQueue == "analytics")
            {
                <div class="csrw-section-head"><div><h2>CSR analytics</h2><p>Monitor queue mix, SLA health, priority distribution, and channel pressure.</p></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-x-lg"></i> Reset</button></div>
                <div class="csrw-analytics-grid"><section><h3>Queue distribution</h3>@foreach (var row in QueueDistribution) { @AnalyticsItem(row) }</section><section><h3>SLA health</h3>@foreach (var row in SlaDistribution) { @AnalyticsItem(row) }</section><section><h3>Priority mix</h3>@foreach (var row in PriorityDistribution) { @AnalyticsItem(row) }</section><section><h3>Channel mix</h3>@foreach (var row in ChannelDistribution) { @AnalyticsItem(row) }</section></div>
            }
            else if (_activeQueue == "views")
            {
                <div class="csrw-section-head"><div><h2>Saved views</h2><p>Save, load, and delete CSR workbench view state for your current queue and scope.</p></div><button class="um-btn um-btn-primary um-btn-sm" @onclick="SaveCurrentViewAsync"><i class="bi bi-bookmark-plus"></i> Save Current View</button></div>
                @if (_savedViews.Count == 0) { @EmptyState("bi-bookmark-star", "No saved views yet", "Save the current scope, queue, and filters for quick access.") } else { <div class="csrw-card-grid">@foreach (var view in _savedViews) { <article class="csrw-view-card"><div><strong>@view.Name</strong><span>@view.QueueId · @view.Scope</span><small>@(string.IsNullOrWhiteSpace(view.BranchId) ? "All branches" : view.BranchId) · @(string.IsNullOrWhiteSpace(view.TeamId) ? "All teams" : view.TeamId)</small></div><div class="csrw-item-actions"><button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => LoadViewAsync(view.Name))">Load</button><button class="um-btn um-btn-danger um-btn-sm" @onclick="@(() => DeleteViewAsync(view.Name))">Delete</button></div></article> }</div> }
            }
            else
            {
                <div class="csrw-section-head"><div><h2>@ActiveQueueTitle</h2><p>@ActiveQueueSubtitle</p></div><button class="um-btn um-btn-primary um-btn-sm" @onclick='() => Nav.NavigateTo("/ops/service-requests?new=true")'><i class="bi bi-plus-lg"></i> New Request</button></div>
                @if (ActiveItems.Count == 0) { @EmptyState(ActiveQueueIcon, "No records match this queue", "Adjust filters, refresh the workbench, or create a new service request.") } else { <div class="csrw-card-grid">@foreach (var item in ActiveItems) { @QueueCard(item) }</div> }
            }
        </main>

        <aside class="csrw-detail-card">
            @if (_selected is not null)
            {
                <div class="csrw-detail-head"><div><span class="csrw-detail-eyebrow"><i class="bi @ActiveQueueIcon" aria-hidden="true"></i> @_selected.QueueLabel</span><h2>@_selected.Title</h2><p>@_selected.AccountName</p></div><span class="@PriBadge(_selected.Priority)">@_selected.Priority</span></div>
                <div class="csrw-detail-body"><div class="csrw-detail-summary"><div><span>Ref</span><strong>@_selected.RefNumber</strong></div><div><span>SLA</span><strong class="@SlaTextClass(_selected.SlaStatus)">@_selected.SlaStatus</strong></div><div><span>Policy</span><strong>@(string.IsNullOrWhiteSpace(_selected.PolicyNumber) ? "—" : _selected.PolicyNumber)</strong></div><div><span>Channel</span><strong>@_selected.Channel</strong></div><div><span>Due</span><strong>@_selected.DueDate.ToString("d", CultureInfo.CurrentCulture)</strong></div><div><span>Age</span><strong>@_selected.AgeDays d</strong></div></div>@if (!string.IsNullOrWhiteSpace(_selected.Notes)) { <p class="csrw-detail-note">@_selected.Notes</p> }<div class="csrw-detail-actions"><button class="um-btn um-btn-ghost" @onclick="MarkTouchedAsync"><i class="bi bi-check2-circle"></i> Mark Reviewed</button><button class="um-btn um-btn-primary" @onclick="@(() => Nav.NavigateTo(_selected.DetailUrl))">Open Record <i class="bi bi-arrow-right"></i></button></div></div>
            }
            else
            {
                <div class="csrw-detail-empty"><i class="bi bi-headset" aria-hidden="true"></i><strong>Select a CSR item</strong><span>Review service details, SLA status, priority, and source record navigation.</span></div>
            }
        </aside>
    </section>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;

    private bool _loading;
    private bool _toastVisible;
    private string? _loadError;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string _scope = "me";
    private string _branchId = string.Empty;
    private string _teamId = string.Empty;
    private string _activeQueue = "service-requests";
    private WbItem? _selected;

    private string _search = string.Empty;
    private string _filterPriority = string.Empty;
    private string _filterCategory = string.Empty;
    private string _filterSla = string.Empty;

    private string? _aiSummary;
    private bool _aiLoading;
    private DateTime? _aiGeneratedAt;
    private List<SavedViewVm> _savedViews = [];
    private List<SlaHeatItemVm> _slaItems = [];
    private CsrCounts _c = new();

    private List<WbItem> _serviceRequests = [];
    private List<WbItem> _endorsements = [];
    private List<WbItem> _certificates = [];
    private List<WbItem> _billingEnquiries = [];
    private List<WbItem> _complaints = [];
    private List<WbItem> _followUps = [];

    private readonly List<LabelValue> _priorityOptions = [new("Critical", "Critical"), new("Urgent", "Urgent"), new("High", "High"), new("Normal", "Normal"), new("Low", "Low")];
    private readonly List<LabelValue> _slaOptions = [new("On Track", "On Track"), new("At Risk", "At Risk"), new("Breached", "Breached")];
    private List<QDef> Queues => [new("service-requests", "Service Requests", "bi bi-headset", _c.ServiceRequests, false), new("endorsements", "Endorsements", "bi bi-pen-fill", _c.Endorsements, false), new("certificates", "Certificates", "bi bi-patch-check-fill", _c.Certificates, false), new("billing-enquiries", "Billing Enquiries", "bi bi-receipt", _c.BillingEnquiries, false), new("complaints", "Complaints", "bi bi-exclamation-octagon-fill", _c.Complaints, _c.Complaints > 0), new("follow-ups", "Follow-ups", "bi bi-alarm-fill", _c.FollowUps, _c.OverdueFollowUps > 0)];
    private IReadOnlyList<KpiMetric> Metrics => [new("service-requests", "Service Requests", _c.ServiceRequests.ToString("N0"), $"{UrgentCount} urgent", "bi-headset", _c.ServiceRequests > 0 ? "csrw-tone-info" : "csrw-tone-muted"), new("endorsements", "Endorsements", _c.Endorsements.ToString("N0"), "Policy changes", "bi-pen-fill", "csrw-tone-purple"), new("certificates", "Certificates", _c.Certificates.ToString("N0"), "COI requests", "bi-patch-check-fill", "csrw-tone-success"), new("billing-enquiries", "Billing", _c.BillingEnquiries.ToString("N0"), BillingAmount.ToString("C0"), "bi-receipt", "csrw-tone-warning"), new("complaints", "Complaints", _c.Complaints.ToString("N0"), $"{EscalatedCount} escalated", "bi-exclamation-octagon-fill", _c.Complaints > 0 ? "csrw-tone-danger" : "csrw-tone-muted"), new("follow-ups", "Follow-ups", _c.FollowUps.ToString("N0"), $"{_c.OverdueFollowUps} overdue", "bi-alarm-fill", _c.OverdueFollowUps > 0 ? "csrw-tone-danger" : "csrw-tone-pink")];

    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> SearchChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _search = e.Value?.ToString() ?? string.Empty);
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> PriorityChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _filterPriority = e.Value?.ToString() ?? string.Empty);
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> SlaChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _filterSla = e.Value?.ToString() ?? string.Empty);
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> CategoryChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => _filterCategory = e.Value?.ToString() ?? string.Empty);
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> ScopeChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, async e => { _scope = e.Value?.ToString() ?? "me"; await LoadAsync(); });
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> BranchChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, async e => { _branchId = e.Value?.ToString() ?? string.Empty; await LoadAsync(); });
    private EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> TeamChangedCallback => EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, async e => { _teamId = e.Value?.ToString() ?? string.Empty; await LoadAsync(); });

    private string ToastIconClass => _toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill";
    private IEnumerable<WbItem> AllItems => _serviceRequests.Concat(_endorsements).Concat(_certificates).Concat(_billingEnquiries).Concat(_complaints).Concat(_followUps);
    private List<WbItem> ActiveItems => ActiveSource.Where(Matches).ToList();
    private List<WbItem> ActiveSource => _activeQueue switch { "endorsements" => _endorsements, "certificates" => _certificates, "billing-enquiries" => _billingEnquiries, "complaints" => _complaints, "follow-ups" => _followUps, _ => _serviceRequests };
    private int ActiveQueueCount => _activeQueue == "analytics" ? AllItems.Count() : _activeQueue == "views" ? _savedViews.Count : ActiveItems.Count;
    private string ActiveQueueLabel => _activeQueue == "analytics" ? "records" : _activeQueue == "views" ? "views" : "items";
    private string ActiveQueueTitle => _activeQueue switch { "endorsements" => "Endorsement queue", "certificates" => "Certificate queue", "billing-enquiries" => "Billing enquiry queue", "complaints" => "Complaint queue", "follow-ups" => "Follow-up queue", _ => "Service request queue" };
    private string ActiveQueueSubtitle => _activeQueue switch { "endorsements" => "Process policy changes, endorsement requests, and needed-by dates.", "certificates" => "Issue certificate requests, validate holders, and protect SLA commitments.", "billing-enquiries" => "Resolve invoice, payment, premium, and accounting-related client questions.", "complaints" => "Prioritize escalations, high severity complaints, and breached service expectations.", "follow-ups" => "Clear overdue callbacks, renewal touchpoints, and client service follow-ups.", _ => "Work incoming service requests by priority, SLA, channel, and account context." };
    private string ActiveQueueIcon => _activeQueue switch { "endorsements" => "bi-pen-fill", "certificates" => "bi-patch-check-fill", "billing-enquiries" => "bi-receipt", "complaints" => "bi-exclamation-octagon-fill", "follow-ups" => "bi-alarm-fill", _ => "bi-headset" };
    private int BreachedCount => AllItems.Count(x => x.SlaStatus == "Breached");
    private int AtRiskCount => AllItems.Count(x => x.SlaStatus == "At Risk");
    private int OnTrackCount => AllItems.Count(x => x.SlaStatus == "On Track");
    private int UrgentCount => AllItems.Count(x => x.Priority is "Critical" or "Urgent");
    private int EscalatedCount => _complaints.Count(x => x.EscalationLevel >= 2);
    private decimal BillingAmount => _billingEnquiries.Sum(x => x.Amount);
    private string PriorityFocusText => BreachedCount > 0 ? $"{BreachedCount} breached SLA item(s)" : UrgentCount > 0 ? $"{UrgentCount} critical/urgent item(s)" : _c.OverdueFollowUps > 0 ? $"{_c.OverdueFollowUps} overdue follow-up(s)" : "Queue hygiene";
    private IReadOnlyList<MetricBar> QueueDistribution => BuildAnalytics([new("Service", _serviceRequests.Count, "csrw-dist-blue"), new("Endorse", _endorsements.Count, "csrw-dist-purple"), new("Certs", _certificates.Count, "csrw-dist-green"), new("Billing", _billingEnquiries.Count, "csrw-dist-amber"), new("Complaints", _complaints.Count, "csrw-dist-red"), new("Follow-ups", _followUps.Count, "csrw-dist-pink")]);
    private IReadOnlyList<MetricBar> SlaDistribution => BuildAnalytics(AllItems.GroupBy(x => x.SlaStatus).Select(g => new AnalyticsSeed(g.Key, g.Count(), g.Key == "Breached" ? "csrw-dist-red" : g.Key == "At Risk" ? "csrw-dist-amber" : "csrw-dist-green")));
    private IReadOnlyList<MetricBar> PriorityDistribution => BuildAnalytics(AllItems.GroupBy(x => x.Priority).Select(g => new AnalyticsSeed(g.Key, g.Count(), g.Key is "Critical" or "Urgent" ? "csrw-dist-red" : g.Key == "High" ? "csrw-dist-purple" : "csrw-dist-blue")));
    private IReadOnlyList<MetricBar> ChannelDistribution => BuildAnalytics(AllItems.Where(x => !string.IsNullOrWhiteSpace(x.Channel)).GroupBy(x => x.Channel).Select(g => new AnalyticsSeed(g.Key, g.Count(), "csrw-dist-blue")));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Workbench", "/workbench"), new("CSR", "/workbench/csr"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _loadError = null;
            var teamScope = _scope.Equals("team", StringComparison.OrdinalIgnoreCase);
            var context = await CurrentUser.RequireAsync();
            var data = await Api.GetCsrWorkbenchAsync(_tenantId, context.UserScopeId, teamScope || context.IsTenantAdministrator, _branchId, _teamId);
            _serviceRequests = data?.ServiceRequests.Select(x => MapItem(x, "Service Request")).ToList() ?? [];
            _endorsements = data?.Endorsements.Select(x => MapItem(x, "Endorsement")).ToList() ?? [];
            _certificates = data?.Certificates.Select(x => MapItem(x, "Certificate")).ToList() ?? [];
            _billingEnquiries = data?.BillingEnquiries.Select(x => MapItem(x, "Billing Enquiry")).ToList() ?? [];
            _complaints = data?.Complaints.Select(x => MapItem(x, "Complaint")).ToList() ?? [];
            _followUps = data?.FollowUps.Select(x => MapItem(x, "Follow-up")).ToList() ?? [];
            _c = MapCounts(data?.Counts);
            RebuildSla();
            _selected = ActiveItems.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"CSR workbench load failed: {ex.Message}";
            _serviceRequests = []; _endorsements = []; _certificates = []; _billingEnquiries = []; _complaints = []; _followUps = [];
            _c = new();
            RebuildSla();
            ShowToast(_loadError, "danger");
        }
        finally { _loading = false; }
    }

    private static CsrCounts MapCounts(CsrWorkbenchCountsDto? dto) => dto is null ? new CsrCounts() : new CsrCounts { ServiceRequests = dto.ServiceRequests, Endorsements = dto.Endorsements, Certificates = dto.Certificates, BillingEnquiries = dto.BillingEnquiries, Complaints = dto.Complaints, FollowUps = dto.FollowUps, OverdueFollowUps = dto.OverdueFollowUps };
    private static WbItem MapItem(CsrWorkbenchItemDto dto, string queueLabel) => new() { ItemId = dto.ItemId, QueueLabel = queueLabel, Title = dto.Title, RefNumber = dto.RefNumber, AccountName = dto.AccountName, PolicyNumber = dto.PolicyNumber, CertHolder = dto.CertHolder, Category = dto.Category, Channel = dto.Channel, AssignedTo = dto.AssignedTo, Priority = dto.Priority, SlaStatus = dto.SlaStatus, EscalationLevel = dto.EscalationLevel, DueDate = dto.DueDate, CreatedAt = dto.CreatedAt, AgeDays = dto.AgeDays, Amount = dto.Amount, Notes = dto.Notes, DetailUrl = dto.DetailUrl };
    private void RebuildSla() => _slaItems = [new("Service Requests", _serviceRequests.Count(x => x.SlaStatus != "Breached"), _serviceRequests.Count(x => x.SlaStatus == "Breached")), new("Endorsements", _endorsements.Count(x => x.SlaStatus != "Breached"), _endorsements.Count(x => x.SlaStatus == "Breached")), new("Certificates", _certificates.Count(x => x.SlaStatus != "Breached"), _certificates.Count(x => x.SlaStatus == "Breached")), new("Billing Enquiries", _billingEnquiries.Count(x => x.SlaStatus != "Breached"), _billingEnquiries.Count(x => x.SlaStatus == "Breached")), new("Complaints", _complaints.Count(x => x.SlaStatus != "Breached"), _complaints.Count(x => x.SlaStatus == "Breached")), new("Follow-ups", _followUps.Count(x => x.SlaStatus != "Breached"), _followUps.Count(x => x.SlaStatus == "Breached"))];

    private async Task GenerateAiSummaryAsync()
    {
        _aiLoading = true;
        await Task.Delay(0);
        _aiSummary = $"Tenant Admin CSR queue has {AllItems.Count()} open items: {UrgentCount} critical/urgent, {BreachedCount} breached SLA, and {AtRiskCount} at risk. Prioritize complaints, overdue follow-ups, and certificate requests needed today.";
        _aiGeneratedAt = DateTime.Now;
        _aiLoading = false;
        ShowToast("CSR service intelligence summary generated.");
    }

    private Task ExportAsync() => Task.Run(() => ShowToast($"Export prepared for {AllItems.Count()} CSR workbench rows."));
    private void SetActiveQueue(string id) { _activeQueue = id; _selected = id is "analytics" or "views" ? null : ActiveItems.FirstOrDefault(); }
    private void ShowBreached() { _filterSla = "Breached"; SetActiveQueue(BreachedCount > _complaints.Count ? "service-requests" : "complaints"); }
    private void ShowComplaints() { _filterSla = string.Empty; SetActiveQueue("complaints"); }
    private void ShowCertificates() { _filterSla = string.Empty; SetActiveQueue("certificates"); }
    private void ShowFollowUps() { _filterSla = string.Empty; SetActiveQueue("follow-ups"); }
    private void ResetFilters() { _search = string.Empty; _filterPriority = string.Empty; _filterCategory = string.Empty; _filterSla = string.Empty; }
    private void OpenDetail(WbItem item) => _selected = item;
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;
    private Task MarkTouchedAsync() { if (_selected is not null) ShowToast($"{_selected.RefNumber} marked reviewed."); return Task.CompletedTask; }

    private Task SaveCurrentViewAsync()
    {
        var name = $"{ActiveQueueTitle} · {DateTime.Now:MMM d h:mm tt}";
        _savedViews.RemoveAll(x => x.Name == name);
        _savedViews.Add(new(name, _activeQueue, _scope, _branchId, _teamId, _search, _filterPriority, _filterCategory, _filterSla));
        ShowToast($"View \"{name}\" saved.");
        return Task.CompletedTask;
    }

    private Task LoadViewAsync(string name)
    {
        var v = _savedViews.FirstOrDefault(x => x.Name == name);
        if (v is null) return Task.CompletedTask;
        _activeQueue = v.QueueId; _scope = v.Scope; _branchId = v.BranchId; _teamId = v.TeamId; _search = v.Search; _filterPriority = v.Priority; _filterCategory = v.Category; _filterSla = v.Sla;
        _selected = ActiveItems.FirstOrDefault();
        ShowToast($"View \"{name}\" loaded.");
        return Task.CompletedTask;
    }

    private async Task DeleteViewAsync(string name)
    {
        if (!await Confirmations.ConfirmAsync("Delete saved view", $"Delete saved view {name}?", "Delete")) return;
        _savedViews.RemoveAll(x => x.Name == name);
        ShowToast($"View \"{name}\" deleted.", "warning");
    }

    private bool Matches(WbItem i) => (string.IsNullOrWhiteSpace(_filterPriority) || i.Priority == _filterPriority) && (string.IsNullOrWhiteSpace(_filterSla) || i.SlaStatus == _filterSla) && (string.IsNullOrWhiteSpace(_filterCategory) || i.Category.Contains(_filterCategory, StringComparison.OrdinalIgnoreCase)) && (string.IsNullOrWhiteSpace(_search) || new[] { i.Title, i.AccountName, i.RefNumber, i.PolicyNumber, i.CertHolder, i.Category, i.Channel, i.AssignedTo, i.Notes ?? string.Empty }.Any(v => !string.IsNullOrWhiteSpace(v) && v.Contains(_search, StringComparison.OrdinalIgnoreCase)));
    private RenderFragment QueueCard(WbItem item) => @<article class="csrw-item-card @(ReferenceEquals(_selected, item) ? "csrw-item-selected" : string.Empty)" @onclick="@(() => OpenDetail(item))"><div class="csrw-item-top"><span class="csrw-avatar" style="@AvatarStyle(item.AccountName)">@Initials(item.AccountName)</span><div><strong>@item.Title</strong><span>@item.AccountName</span></div></div><div class="csrw-item-meta"><span class="@PriBadge(item.Priority)">@item.Priority</span><span class="@SlaBadge(item.SlaStatus)">@item.SlaStatus</span>@if (!string.IsNullOrWhiteSpace(item.Channel)) { <span class="@ChanBadge(item.Channel)">@item.Channel</span> }@if (item.EscalationLevel > 1) { <span class="@EscBadge(item.EscalationLevel)">L@item.EscalationLevel</span> }</div><div class="csrw-item-footer"><strong>@item.RefNumber</strong><span class="@(item.DueDate.Date < DateTime.Today ? "csrw-overdue" : string.Empty)">@item.DueDate.ToString("MMM d", CultureInfo.CurrentCulture)</span></div><div class="csrw-item-actions" @onclick:stopPropagation="true"><button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenDetail(item))"><i class="bi bi-layout-sidebar-inset"></i></button><button class="um-btn um-btn-primary um-btn-sm" @onclick="@(() => Nav.NavigateTo(item.DetailUrl))">Open</button></div></article>;
    private RenderFragment EmptyState(string icon, string title, string text) => @<div class="csrw-empty-state"><i class="bi @icon" aria-hidden="true"></i><strong>@title</strong><span>@text</span><button class="um-btn um-btn-primary" @onclick="LoadAsync">Refresh</button></div>;
    private RenderFragment AnalyticsItem(MetricBar row) => @<button class="csrw-analytics-row"><span>@row.Label</span><div><i class="@row.Tone" style="width:@row.WidthPercent%"></i></div><strong>@row.Count</strong><small>@row.Percent.ToString("F0")%</small></button>;
    private IReadOnlyList<MetricBar> BuildAnalytics(IEnumerable<AnalyticsSeed> seeds) { var items = seeds.ToList(); var total = Math.Max(1, items.Sum(x => x.Count)); return items.Select(x => new MetricBar(x.Label, x.Count, x.Tone, x.Count * 100m / total, Math.Max(4m, x.Count * 100m / total))).ToList(); }
    private string MetricCardClass(KpiMetric metric) => $"csrw-kpi-card {(metric.QueueId == _activeQueue ? "csrw-kpi-card-active" : string.Empty)}";
    private string QueueTabClass(string id) => $"csrw-view-btn {(id == _activeQueue ? "csrw-view-btn-active" : string.Empty)}";
    private static string PriBadge(string p) => p switch { "Critical" => "csrw-pri csrw-pri-critical", "Urgent" => "csrw-pri csrw-pri-urgent", "High" => "csrw-pri csrw-pri-high", "Normal" => "csrw-pri csrw-pri-normal", _ => "csrw-pri csrw-pri-low" };
    private static string SlaBadge(string s) => s switch { "On Track" => "csrw-sla csrw-sla-ok", "At Risk" => "csrw-sla csrw-sla-warn", _ => "csrw-sla csrw-sla-breach" };
    private static string SlaTextClass(string s) => s == "Breached" ? "csrw-text-danger" : s == "At Risk" ? "csrw-text-warning" : "csrw-text-success";
    private static string ChanBadge(string c) => c switch { "Email" => "csrw-chan csrw-chan-email", "Phone" => "csrw-chan csrw-chan-phone", "Portal" => "csrw-chan csrw-chan-portal", "Chat" => "csrw-chan csrw-chan-chat", _ => "csrw-chan" };
    private static string EscBadge(int l) => l >= 3 ? "csrw-esc csrw-esc-3" : l == 2 ? "csrw-esc csrw-esc-2" : "csrw-esc csrw-esc-1";
    private static string FormatAge(DateTime dt) { var diff = DateTime.Now - dt; if (diff.TotalMinutes < 1) return "Just now"; if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m ago"; if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago"; if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d ago"; return dt.ToString("d", CultureInfo.CurrentCulture); }
    private static string Initials(string name) { var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length >= 1 ? name[..1] : "?"; }
    private static string AvatarStyle(string name) { var hue = Math.Abs(name.GetHashCode()) % 360; return $"background:hsl({hue},50%,40%);color:#fff;"; }

    async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); TenantId = context.TenantId; TenantAdminUserId = context.UserId; _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; DevTenantId = context.TenantId; DevUserId = context.UserId; }

    private sealed record LabelValue(string Value, string Label);
    private sealed record QDef(string Id, string Label, string Icon, int Badge, bool IsAlert);
    private sealed record KpiMetric(string QueueId, string Label, string Value, string Caption, string Icon, string Tone);
    private sealed record AnalyticsSeed(string Label, int Count, string Tone);
    private sealed record MetricBar(string Label, int Count, string Tone, decimal Percent, decimal WidthPercent);
    private sealed record SavedViewVm(string Name, string QueueId, string Scope, string BranchId, string TeamId, string Search, string Priority, string Category, string Sla);
    private sealed record SlaHeatItemVm(string QueueName, int InSla, int Breached);
    private sealed class CsrCounts { public int ServiceRequests { get; set; } public int Endorsements { get; set; } public int Certificates { get; set; } public int BillingEnquiries { get; set; } public int Complaints { get; set; } public int FollowUps { get; set; } public int OverdueFollowUps { get; set; } }
    private sealed class WbItem { public Guid ItemId { get; set; } = Guid.NewGuid(); public string QueueLabel { get; set; } = string.Empty; public string Title { get; set; } = string.Empty; public string RefNumber { get; set; } = string.Empty; public string AccountName { get; set; } = string.Empty; public string PolicyNumber { get; set; } = string.Empty; public string CertHolder { get; set; } = string.Empty; public string Category { get; set; } = string.Empty; public string Channel { get; set; } = string.Empty; public string AssignedTo { get; set; } = string.Empty; public string Priority { get; set; } = "Normal"; public string SlaStatus { get; set; } = "On Track"; public int EscalationLevel { get; set; } = 1; public DateTime DueDate { get; set; } = DateTime.Today; public DateTime CreatedAt { get; set; } = DateTime.UtcNow; public int AgeDays { get; set; } public decimal Amount { get; set; } public string? Notes { get; set; } public string DetailUrl { get; set; } = "/workbench/csr"; }
}
