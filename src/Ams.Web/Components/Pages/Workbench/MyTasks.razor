@page "/workbench/tasks"
@namespace Ams.Web.Components.Pages.Workbench
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>My Tasks — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<SfContextMenu @ref="_ctx" TValue="CtxItem" Items="_ctxItems" ItemSelected="OnCtxSelected">
    <MenuFieldSettings Text="Text" IconCss="IconCss" />
</SfContextMenu>

<AppPageHeader Title="My Tasks"
               Subtitle="All tasks assigned to you — due today, upcoming, overdue and completed"
               Icon="bi-check2-square">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-primary" @onclick="NewTask">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Task
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="mt-kpi-strip">
    @KpiCard("bi-list-check",     "All",       _rows.Count.ToString(),                                           "mt-kpi-all",     null)
    @KpiCard("bi-sun",            "Due Today", _rows.Count(r => !r.Done && r.DueDate.Date == DateTime.Today).ToString(), "mt-kpi-today",   "today")
    @KpiCard("bi-alarm-fill",     "Overdue",   _rows.Count(r => !r.Done && r.DueDate < DateTime.Today).ToString(),"mt-kpi-overdue", "overdue")
    @KpiCard("bi-calendar-week",  "This Week", _rows.Count(r => !r.Done && r.DueDate.Date <= DateTime.Today.AddDays(7)).ToString(), "mt-kpi-week", "week")
    @KpiCard("bi-check-circle",   "Completed", _rows.Count(r => r.Done).ToString(),                              "mt-kpi-done",    "completed")
</div>

<!-- Filter bar -->
<div class="mt-filter-bar">
    <input class="e-input mt-search" @bind="_search" @bind:event="oninput"
           placeholder="Search tasks, account, notes…" />
    <div class="mt-pill-group">
        @foreach (var p in _duePills)
        {
            <button class="mt-pill @(_dueFilter == p.Key ? "mt-pill-active" : "")"
                    @onclick="() => _dueFilter = p.Key">@p.Label</button>
        }
    </div>
    <select class="e-input mt-filter-sel" @bind="_priFilter">
        <option value="">All Priorities</option>
        <option>High</option><option>Medium</option><option>Low</option>
    </select>
    <select class="e-input mt-filter-sel" @bind="_catFilter">
        <option value="">All Categories</option>
        @foreach (var c in _categories) { <option>@c</option> }
    </select>
    <label class="mt-toggle">
        <input type="checkbox" @bind="_showDone" /> Show completed
    </label>
    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters">
        <i class="bi bi-x" aria-hidden="true"></i> Reset
    </button>
    <span class="mt-filter-count">@Filtered.Count() tasks</span>
</div>

<!-- Task board view tabs -->
<div class="mt-view-tabs">
    @foreach (var t in _tabs)
    {
        <button class="mt-view-tab @(_activeTab == t.Key ? "mt-view-tab--active" : "")"
                @onclick="() => _activeTab = t.Key">
            <i class="bi @t.Icon" aria-hidden="true"></i> @t.Label
            <span class="mt-tab-count">@TabCount(t.Key)</span>
        </button>
    }
</div>

<!-- Content -->
<div class="mt-content">

    @if (_activeTab == "list")
    {
        <!-- List view: grouped by due section -->
        @foreach (var grp in GroupedFiltered)
        {
            <div class="mt-group-hd">
                <span class="mt-group-lbl @grp.Css">@grp.Label</span>
                <span class="mt-group-count">@grp.Items.Count</span>
            </div>
            @foreach (var r in grp.Items)
            {
                <div class="mt-task-row @(r.IsOverdue && !r.Done ? "mt-row-overdue" : "")">
                    <button class="mt-check @(r.Done ? "mt-check--done" : "")"
                            @onclick="() => ToggleDone(r)">
                        <i class="bi @(r.Done ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                    </button>
                    <div class="mt-row-body">
                        <span class="mt-row-title @(r.Done ? "mt-done-text" : "")">@r.Title</span>
                        <div class="mt-row-meta">
                            @if (!string.IsNullOrEmpty(r.Account))
                            {
                                <span><i class="bi bi-building" aria-hidden="true"></i> @r.Account</span>
                            }
                            <span><i class="bi bi-tag" aria-hidden="true"></i> @r.Category</span>
                            @if (!string.IsNullOrEmpty(r.Notes))
                            {
                                <span class="mt-row-notes">@r.Notes</span>
                            }
                        </div>
                    </div>
                    <div class="mt-row-right">
                        <span class="mt-pri mt-pri-@r.Priority.ToLower()">@r.Priority</span>
                        <span class="mt-due @(r.IsOverdue && !r.Done ? "mt-due-red" : "")">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                            @r.DueDate.ToString("MMM d")
                        </span>
                        <button class="um-btn um-btn-ghost um-btn-xs"
                                @onclick:stopPropagation="true"
                                @onclick="(e) => { _selected = r; _ctx.Open(e.ClientX, e.ClientY); }">
                            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            }
        }
        @if (!Filtered.Any())
        {
            <div class="mt-empty">
                <i class="bi bi-check2-all mt-empty-icon" aria-hidden="true"></i>
                <span>No tasks match the current filters.</span>
            </div>
        }
    }
    else
    {
        <!-- Grid view -->
        <SfGrid DataSource="@Filtered.ToList()" AllowSorting="true" AllowPaging="true"
                AllowResizing="true" RowHeight="46" @ref="_grid">
            <GridPageSettings PageSize="25" />
            <GridColumns>
                <GridColumn HeaderText="Done" Width="65">
                    <Template>
                        @{ var r = (TaskRow)context; }
                        <button class="mt-check @(r.Done ? "mt-check--done" : "")" @onclick="() => ToggleDone(r)">
                            <i class="bi @(r.Done ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                        </button>
                    </Template>
                </GridColumn>
                <GridColumn Field="Title"    HeaderText="Task"      MinWidth="220">
                    <Template>
                        @{ var r = (TaskRow)context; }
                        <span class="@(r.Done ? "mt-done-text" : "") @(r.IsOverdue && !r.Done ? "mt-overdue-text" : "")">@r.Title</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="Account"  HeaderText="Account"   Width="175" />
                <GridColumn Field="Category" HeaderText="Category"  Width="145" />
                <GridColumn Field="Priority" HeaderText="Priority"  Width="100">
                    <Template>
                        @{ var r = (TaskRow)context; }
                        <span class="mt-pri mt-pri-@r.Priority.ToLower()">@r.Priority</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="DueDate"  HeaderText="Due"       Width="115">
                    <Template>
                        @{ var r = (TaskRow)context; }
                        <span class="@(r.IsOverdue && !r.Done ? "mt-due-red" : "")">
                            @r.DueDate.ToString("MM/dd/yyyy")
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn Field="AssignedBy" HeaderText="Assigned By" Width="145" />
                <GridColumn HeaderText="" Width="52" AllowSorting="false">
                    <Template>
                        @{ var r = (TaskRow)context; }
                        <button class="um-btn um-btn-ghost um-btn-xs"
                                @onclick:stopPropagation="true"
                                @onclick="(e) => { _selected = r; _ctx.Open(e.ClientX, e.ClientY); }">
                            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                        </button>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    }

</div>

@code {
    SfToast _toast = default!;
    SfContextMenu<CtxItem> _ctx = default!;
    SfGrid<TaskRow>? _grid;

    string _search    = "";
    string _dueFilter = "";
    string _priFilter = "";
    string _catFilter = "";
    bool   _showDone  = false;
    string _activeTab = "list";

    TaskRow? _selected;

    sealed record TabDef(string Key, string Label, string Icon);
    readonly TabDef[] _tabs =
    [
        new("list",  "List",       "bi-list-ul"),
        new("grid",  "Grid View",  "bi-table"),
    ];

    sealed record DuePill(string Key, string Label);
    readonly DuePill[] _duePills =
    [
        new("",          "All"),
        new("today",     "Today"),
        new("overdue",   "Overdue"),
        new("week",      "This Week"),
        new("completed", "Completed"),
    ];

    readonly string[] _categories = { "Renewal", "Quote Follow-up", "Certificate", "Endorsement", "Call", "Document", "Admin", "Billing", "Claim" };

    sealed class TaskRow
    {
        public Guid     TaskId     { get; set; }
        public string   Title      { get; set; } = "";
        public string   Account    { get; set; } = "";
        public string   Category   { get; set; } = "";
        public string   Priority   { get; set; } = "";
        public DateTime DueDate    { get; set; }
        public string   AssignedBy { get; set; } = "";
        public string   Notes      { get; set; } = "";
        public bool     Done       { get; set; }
        public bool     IsOverdue  => !Done && DueDate.Date < DateTime.Today;
    }

    sealed record CtxItem(string Text, string IconCss);
    readonly List<CtxItem> _ctxItems =
    [
        new("Open",          "bi bi-arrow-right-circle"),
        new("Mark Complete", "bi bi-check-circle"),
        new("Edit",          "bi bi-pencil"),
        new("Reassign",      "bi bi-person-fill-gear"),
        new("Delete",        "bi bi-trash"),
    ];

    readonly List<TaskRow> _rows = new();

    IEnumerable<TaskRow> Filtered => _rows.Where(r =>
        (string.IsNullOrEmpty(_search) ||
         r.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         r.Account.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         r.Notes.Contains(_search, StringComparison.OrdinalIgnoreCase))
        && (_showDone || !r.Done)
        && (string.IsNullOrEmpty(_priFilter) || r.Priority == _priFilter)
        && (string.IsNullOrEmpty(_catFilter) || r.Category == _catFilter)
        && _dueFilter switch
        {
            "today"     => r.DueDate.Date == DateTime.Today,
            "overdue"   => r.IsOverdue,
            "week"      => !r.Done && r.DueDate.Date <= DateTime.Today.AddDays(7),
            "completed" => r.Done,
            _           => true
        }
    ).OrderBy(r => r.Done).ThenBy(r => r.DueDate);

    sealed record TaskGroup(string Label, string Css, List<TaskRow> Items);
    IEnumerable<TaskGroup> GroupedFiltered
    {
        get
        {
            var rows = Filtered.ToList();
            var groups = new List<TaskGroup>();
            var overdue = rows.Where(r => r.IsOverdue).ToList();
            var today   = rows.Where(r => !r.IsOverdue && !r.Done && r.DueDate.Date == DateTime.Today).ToList();
            var upcoming= rows.Where(r => !r.IsOverdue && !r.Done && r.DueDate.Date > DateTime.Today).ToList();
            var done    = rows.Where(r => r.Done).ToList();
            if (overdue.Any())  groups.Add(new("Overdue",  "mt-grp-overdue",  overdue));
            if (today.Any())    groups.Add(new("Due Today","mt-grp-today",    today));
            if (upcoming.Any()) groups.Add(new("Upcoming", "mt-grp-upcoming", upcoming));
            if (done.Any())     groups.Add(new("Completed","mt-grp-done",     done));
            return groups;
        }
    }

    int TabCount(string key) => key switch
    {
        "list" => Filtered.Count(),
        "grid" => Filtered.Count(),
        _      => 0
    };

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Workbench", "/workbench"), new("My Tasks", "/workbench/tasks"));
        BuildStub();
    }

    void BuildStub()
    {
        var rnd = new Random(7);
        var titles = new[]
        {
            "Follow up on Hartford quote — Sullivan Mfg.",
            "Send cert of insurance to Metro Freight",
            "Review renewal proposal — Apex Medical",
            "Call back Bridgewater Hotels re: premium change",
            "Prepare ACORD 25 — Dallas Roofing LLC",
            "Update pipeline forecast Q2",
            "Process endorsement request — Pioneer Automotive",
            "Verify loss runs received — Laredo Steel Works",
            "Confirm effective date — Greenleaf Nurseries",
            "Request updated financials — Sun Valley Resort",
            "Schedule renewal meeting — Coastal Seafood",
            "Review claims report — Metro Freight Co.",
            "Send non-renewal notice — Crestview Elementary",
            "Set up new client portal — Dallas Roofing",
            "Complete ACORD 140 — Apex Medical Group",
        };
        var accounts  = new[]{ "Sullivan Mfg. LLC","Metro Freight Co.","Apex Medical Group","Dallas Roofing LLC","Bridgewater Hotels","Pioneer Automotive","Laredo Steel Works","Greenleaf Nurseries","Sun Valley Resort","Coastal Seafood Dist.","Crestview Elementary" };
        var assignees = new[]{ "Maria Santos","James Park","Sarah Kim","Kevin Obi","Lisa Chen" };
        var notes     = new[]{ "","Urgent — client called twice","Waiting on underwriter","Documents attached","",  "Client prefers morning calls" };
        var pris      = new[]{ "High","High","Medium","Low","Medium" };

        _rows.Clear();
        for (int i = 0; i < titles.Length; i++)
        {
            var offsetDays = i < 3 ? -rnd.Next(1, 4) : i < 6 ? 0 : rnd.Next(1, 14);
            _rows.Add(new TaskRow
            {
                TaskId     = Guid.NewGuid(),
                Title      = titles[i],
                Account    = accounts[rnd.Next(accounts.Length)],
                Category   = _categories[rnd.Next(_categories.Length)],
                Priority   = pris[rnd.Next(pris.Length)],
                DueDate    = DateTime.Today.AddDays(offsetDays),
                AssignedBy = assignees[rnd.Next(assignees.Length)],
                Notes      = notes[rnd.Next(notes.Length)],
                Done       = i >= 13,
            });
        }
    }

    void ToggleDone(TaskRow r) => r.Done = !r.Done;
    void Refresh()              => BuildStub();
    void ResetFilters()         { _search=""; _dueFilter=""; _priFilter=""; _catFilter=""; _showDone=false; }

    async Task NewTask()
    {
        await _toast.ShowAsync(new ToastModel { Title="New Task", Content="Task creation form coming soon.", CssClass="e-toast-info" });
    }

    async Task OnCtxSelected(MenuEventArgs<CtxItem> args)
    {
        if (_selected is null) return;
        switch (args.Item.Text)
        {
            case "Mark Complete": ToggleDone(_selected); break;
            default:
                await _toast.ShowAsync(new ToastModel { Title=args.Item.Text, Content=$"Action on: {_selected.Title}", CssClass="e-toast-info" });
                break;
        }
    }

    RenderFragment KpiCard(string icon, string label, string val, string css, string? filter) =>
        @<button class="mt-kpi-card @css @(_dueFilter == (filter ?? "") ? "mt-kpi-active" : "")"
                 @onclick="() => _dueFilter = (filter ?? _dueFilter)">
            <div class="mt-kpi-val">@val</div>
            <div class="mt-kpi-lbl"><i class="bi @icon" aria-hidden="true"></i> @label</div>
        </button>;
}
