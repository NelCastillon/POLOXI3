@page "/workbench/calendar"
@namespace Ams.Web.Components.Pages.Workbench
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Operations
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>My Calendar — AMS</PageTitle>

@if (_toastMessage is not null)
{
    <div class="mt-toast @(_toastIsError ? "mt-toast--danger" : "mt-toast--success")" role="status">
        <i class="bi @(_toastIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" @onclick="ClearToast" aria-label="Close notification"><i class="bi bi-x-lg"></i></button>
    </div>
}

<AppPageHeader Title="My Calendar"
               Subtitle="Tenant Admin schedule for calls, meetings, tasks, agency events and critical deadlines"
               Icon="bi-calendar3">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="PrevPeriod" title="Previous period"><i class="bi bi-chevron-left"></i></button>
        <span class="mc-month-label">@PeriodLabel</span>
        <button class="um-btn um-btn-ghost" @onclick="NextPeriod" title="Next period"><i class="bi bi-chevron-right"></i></button>
        <button class="um-btn um-btn-ghost" @onclick="GoToday">Today</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh calendar"><i class="bi bi-arrow-clockwise @(_loading ? "ad-spin" : "")"></i></button>
        <button class="um-btn um-btn-primary" @onclick="NewEvent"><i class="bi bi-plus-lg"></i> New Event</button>
    </Actions>
</AppPageHeader>

<section class="mc-hero">
    <div>
        <span class="mc-eyebrow">Tenant Admin Calendar</span>
        <h2>Schedule Command Center</h2>
        <p>Coordinate renewal reviews, producer follow-ups, service deadlines, workflow milestones and tenant administration events from one modern calendar workspace.</p>
    </div>
    <div class="mc-hero-actions">
        <button class="um-btn um-btn-primary" @onclick="NewEvent"><i class="bi bi-plus-lg"></i> Schedule Event</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/workbench/activities")'><i class="bi bi-lightning"></i> Activity Stream</button>
    </div>
</section>

<div class="mc-kpi-strip">
    @KpiCard("bi-calendar-event", "Today", EventsForToday.Count().ToString(), "Events today", "mc-kpi-today", "__today")
    @KpiCard("bi-calendar-week", "This Week", EventsForWeek.Count().ToString(), "Upcoming this week", "mc-kpi-week", "__week")
    @KpiCard("bi-calendar3", "This Month", EventsForMonth.Count().ToString(), "Visible month events", "mc-kpi-month", "__month")
    @KpiCard("bi-telephone-fill", "Calls", _events.Count(e => e.Type == "Call").ToString(), "Call events", "mc-kpi-call", "Call")
    @KpiCard("bi-calendar-event-fill", "Meetings", _events.Count(e => e.Type == "Meeting").ToString(), "Meetings", "mc-kpi-meet", "Meeting")
    @KpiCard("bi-check2-square", "Tasks", _events.Count(e => e.Type == "Task").ToString(), "Tasks", "mc-kpi-task", "Task")
    @KpiCard("bi-flag-fill", "Deadlines", _events.Count(e => e.Type == "Deadline").ToString(), "Deadlines", "mc-kpi-dead", "Deadline")
</div>

<div class="mc-command-bar">
    <div class="mc-search-wrap">
        <i class="bi bi-search"></i>
        <input @bind="_search" @bind:event="oninput" placeholder="Search title, notes, type…" />
    </div>
    <div class="mc-view-tabs">
        @foreach (var tab in _tabs)
        {
            <button class="mc-view-tab @(_activeTab == tab.Key ? "mc-view-tab--active" : "")" @onclick="() => _activeTab = tab.Key"><i class="bi @tab.Icon"></i> @tab.Label</button>
        }
    </div>
    <div class="mc-type-pills">
        @foreach (var type in CalendarTypes)
        {
            <button class="mc-pill @(_activeFilter == type ? "mc-pill-active" : "")" @onclick="() => SetFilter(type)">@type</button>
        }
    </div>
    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger mt-load-error" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div>
}

@if (_loading)
{
    <div class="mt-loading" aria-live="polite"><div class="um-spinner"></div><span>Loading Tenant Admin calendar…</span></div>
}

<div class="mc-body">
    @if (_activeTab == "month")
    {
        <div class="mc-month-wrap">
            <div class="mc-month-grid-wrap">
                <div class="mc-dow-row">
                    @foreach (var d in DaysOfWeek)
                    {
                        <div class="mc-dow">@d</div>
                    }
                </div>
                <div class="mc-month-grid">
                    @foreach (var day in CalendarDays)
                    {
                        var date = DateOnly.FromDateTime(day);
                        var dayEvents = EventsOn(date).ToList();
                        <button class="mc-day @(day.Month == _viewDate.Month ? "" : "mc-day-other") @(date == Today ? "mc-day-today" : "") @(date == _selectedDate ? "mc-day-sel" : "")" @onclick="() => SelectDay(date)">
                            <span class="mc-day-num">@day.Day</span>
                            <span class="mc-day-events">
                                @foreach (var item in dayEvents.Take(4))
                                {
                                    <span class="mc-day-evt mc-evt-@TypeCss(item.Type)" title="@item.Title"><span class="mc-evt-dot"></span><span class="mc-evt-lbl">@item.Title</span></span>
                                }
                                @if (dayEvents.Count > 4)
                                {
                                    <span class="mc-day-more">+@(dayEvents.Count - 4) more</span>
                                }
                            </span>
                        </button>
                    }
                </div>
            </div>

            <aside class="mc-day-panel">
                <div class="mc-day-panel-hdr">
                    <span class="mc-day-panel-date">@_selectedDate.ToString("dddd, MMMM d") @if (_selectedDate == Today) { <span class="mc-today-badge">Today</span> }</span>
                    <span class="mc-day-panel-count">@SelectedDayEvents.Count() event(s)</span>
                </div>
                <div class="mc-day-event-list">
                    @foreach (var item in SelectedDayEvents)
                    {
                        <div class="mc-day-event-row mc-der-@TypeCss(item.Type)" @onclick="() => SelectEvent(item)">
                            <div class="mc-der-time">@DisplayTime(item)</div>
                            <div class="mc-der-dot"></div>
                            <div class="mc-der-body"><div class="mc-der-title">@item.Title</div><div class="mc-der-acct">@DisplayOwner(item)</div></div>
                            <span class="mc-type-chip mc-tc-@TypeCss(item.Type)">@item.Type</span>
                        </div>
                    }
                    @if (!SelectedDayEvents.Any())
                    {
                        <div class="mc-day-empty"><i class="bi bi-calendar-check"></i> Nothing scheduled.</div>
                    }
                </div>
            </aside>
        </div>
    }
    else if (_activeTab == "week")
    {
        <div class="mc-week-wrap">
            <div class="mc-week-grid">
                @foreach (var day in WeekDays)
                {
                    var date = DateOnly.FromDateTime(day);
                    var dayEvents = EventsOn(date).ToList();
                    <section class="mc-week-col @(date == Today ? "mc-week-col-today" : "")">
                        <header class="mc-week-col-hdr"><span class="mc-week-dow">@day.ToString("ddd")</span><span class="mc-week-daynum @(date == Today ? "mc-week-daynum-today" : "")">@day.Day</span><span class="mc-week-badge">@dayEvents.Count</span></header>
                        <div class="mc-week-events">
                            @foreach (var item in dayEvents)
                            {
                                <button class="mc-week-evt mc-evt-@TypeCss(item.Type)" @onclick="() => SelectEvent(item)"><span class="mc-week-evt-time">@DisplayTime(item)</span><span class="mc-week-evt-title">@item.Title</span><span class="mc-week-evt-acct">@item.Type</span></button>
                            }
                            @if (!dayEvents.Any())
                            {
                                <div class="mc-week-empty-day">Open</div>
                            }
                        </div>
                    </section>
                }
            </div>
        </div>
    }
    else
    {
        <div class="mc-agenda-wrap">
            @foreach (var group in AgendaGroups)
            {
                <div class="mc-agenda-date-sep"><span>@group.Label</span></div>
                @foreach (var item in group.Events)
                {
                    <div class="mc-agenda-row @(item.Date < Today ? "mc-agenda-past" : "")" @onclick="() => SelectEvent(item)">
                        <div class="mc-agenda-time"><div class="mc-agenda-tod">@DisplayTime(item)</div><div class="mc-agenda-dur">@item.Type</div></div>
                        <div class="mc-agenda-icon mc-ai-@TypeCss(item.Type)"><i class="bi @TypeIcon(item.Type)"></i></div>
                        <div class="mc-agenda-body"><div class="mc-agenda-title">@item.Title</div><div class="mc-agenda-acct"><i class="bi bi-person-check"></i> @DisplayOwner(item)</div>@if (!string.IsNullOrWhiteSpace(item.Notes)) { <div class="mc-agenda-notes">@item.Notes</div> }</div>
                        <span class="mc-type-chip mc-tc-@TypeCss(item.Type)">@item.Type</span>
                    </div>
                }
            }
            @if (!AgendaGroups.Any())
            {
                <div class="mc-empty"><i class="bi bi-calendar-x mc-empty-icon"></i><span>No events to show.</span></div>
            }
        </div>
    }
</div>

@if (_selected is not null)
{
    <aside class="mc-event-panel">
        <div class="mc-event-panel-hdr"><span class="mc-type-chip mc-tc-@TypeCss(_selected.Type)">@_selected.Type</span><button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _selected = null"><i class="bi bi-x-lg"></i></button></div>
        <h3>@_selected.Title</h3>
        <p>@(string.IsNullOrWhiteSpace(_selected.Notes) ? "No notes recorded." : _selected.Notes)</p>
        <div class="mc-event-meta"><div><span>Date</span><strong>@_selected.Date.ToString("MMM d, yyyy")</strong></div><div><span>Time</span><strong>@DisplayTime(_selected)</strong></div><div><span>Status</span><strong>@_selected.Status</strong></div><div><span>Time Zone</span><strong>@_selected.TimeZoneId</strong></div><div><span>Owner</span><strong>@DisplayOwner(_selected)</strong></div></div>
        <div class="mc-event-actions"><button class="um-btn um-btn-primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil"></i> Edit</button><button class="um-btn um-btn-ghost" @onclick="() => OpenDetail(_selected)"><i class="bi bi-arrow-up-right-square"></i> Detail</button><button class="um-btn um-btn-danger" @onclick="() => ShowDelete(_selected)"><i class="bi bi-trash"></i> Delete</button></div>
    </aside>
}

@if (_showForm)
{
    <div class="mt-modal-backdrop" @onclick="CloseForm">
        <div class="mt-modal" @onclick:stopPropagation="true">
            <div class="um-modal-header"><i class="bi bi-calendar3"></i><span>@(_editId.HasValue ? "Edit Calendar Event" : "New Calendar Event")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Start <span class="text-danger">*</span></label><InputDate Type="InputDateType.DateTimeLocal" @bind-Value="_form.StartLocal" class="um-input" /><ValidationMessage For="() => _form.StartLocal" class="text-danger" /></div>
                    <div class="um-field"><label>End</label><InputDate Type="InputDateType.DateTimeLocal" @bind-Value="_form.EndLocal" class="um-input" /><ValidationMessage For="() => _form.EndLocal" class="text-danger" /></div>
                    <div class="um-field"><label>Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.Type" class="um-input">@foreach (var type in CalendarTypes) { <option>@type</option> }</InputSelect><ValidationMessage For="() => _form.Type" class="text-danger" /></div>
                    <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.Status" class="um-input">@foreach (var status in StatusCodes) { <option>@status</option> }</InputSelect><ValidationMessage For="() => _form.Status" class="text-danger" /></div>
                    <div class="um-field"><label>Time Zone <span class="text-danger">*</span></label><InputText @bind-Value="_form.TimeZoneId" class="um-input" /><ValidationMessage For="() => _form.TimeZoneId" class="text-danger" /></div>
                    <div class="um-field"><label class="mc-check"><InputCheckbox @bind-Value="_form.AllDay" /> All day</label></div>
                    <div class="um-field um-field--full"><label>Title <span class="text-danger">*</span></label><InputText @bind-Value="_form.Title" class="um-input" /><ValidationMessage For="() => _form.Title" class="text-danger" /></div>
                    <div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_form.Notes" class="um-input" rows="4" /><ValidationMessage For="() => _form.Notes" class="text-danger" /></div>
                </div></div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Save</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showDelete && _selected is not null)
{
    <div class="mt-modal-backdrop" @onclick="() => _showDelete = false">
        <div class="um-confirm-dialog mt-confirm" @onclick:stopPropagation="true">
            <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash"></i></div>
            <div class="um-confirm-title">Delete calendar event?</div>
            <div class="um-confirm-text">This will remove <strong>@_selected.Title</strong> from your Tenant Admin calendar.</div>
            <div class="um-modal-footer"><button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button><button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div>
        </div>
    </div>
}

@code {
    static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    static readonly Guid TenantAdminUserId = Guid.Parse("00000000-0000-0000-0000-000000000002");
    static readonly string[] CalendarTypes = ["Call", "Meeting", "Task", "Event", "Deadline", "Note"];
    static readonly string[] StatusCodes = ["Scheduled", "Completed", "Cancelled", "Rescheduled"];
    static readonly string[] DaysOfWeek = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    DateTime _viewDate = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    DateOnly _selectedDate = Today;
    string _activeTab = "month";
    string _activeFilter = string.Empty;
    string _search = string.Empty;
    string? _loadError;
    string? _toastMessage;
    bool _toastIsError;
    bool _loading;
    bool _saving;
    bool _showForm;
    bool _showDelete;
    Guid? _editId;
    CalEvent? _selected;
    EventForm _form = new();
    readonly List<CalEvent> _events = [];
    readonly TabDef[] _tabs = [new("month", "Month", "bi-calendar3"), new("week", "Week", "bi-calendar-week"), new("agenda", "Agenda", "bi-list-ul")];

    string PeriodLabel => _activeTab == "week" ? $"Week of {WeekStart:MMM d}" : _viewDate.ToString("MMMM yyyy");
    IEnumerable<CalEvent> FilteredEvents => _events.Where(e =>
        (string.IsNullOrEmpty(_search) || e.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || e.Type.Contains(_search, StringComparison.OrdinalIgnoreCase) || e.Notes.Contains(_search, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrEmpty(_activeFilter) || _activeFilter switch { "__today" => e.Date == Today, "__week" => e.Date >= Today && e.Date <= DateOnly.FromDateTime(DateTime.Today.AddDays(7)), "__month" => e.Date.Year == _viewDate.Year && e.Date.Month == _viewDate.Month, _ => e.Type == _activeFilter }));
    IEnumerable<CalEvent> EventsForToday => _events.Where(e => e.Date == Today);
    IEnumerable<CalEvent> EventsForWeek => _events.Where(e => e.Date >= Today && e.Date <= DateOnly.FromDateTime(DateTime.Today.AddDays(7)));
    IEnumerable<CalEvent> EventsForMonth => _events.Where(e => e.Date.Year == _viewDate.Year && e.Date.Month == _viewDate.Month);
    IEnumerable<CalEvent> SelectedDayEvents => EventsOn(_selectedDate);
    IEnumerable<CalEvent> EventsOn(DateOnly date) => FilteredEvents.Where(e => e.Date == date).OrderBy(e => e.StartLocal);
    DateTime WeekStart => _selectedDate.ToDateTime(TimeOnly.MinValue).AddDays(-(int)_selectedDate.ToDateTime(TimeOnly.MinValue).DayOfWeek);
    IEnumerable<DateTime> WeekDays => Enumerable.Range(0, 7).Select(i => WeekStart.AddDays(i));
    IEnumerable<DateTime> CalendarDays { get { var first = new DateTime(_viewDate.Year, _viewDate.Month, 1); var start = first.AddDays(-(int)first.DayOfWeek); var end = first.AddMonths(1).AddDays(-1).AddDays(6 - (int)first.AddMonths(1).AddDays(-1).DayOfWeek); for (var day = start; day <= end; day = day.AddDays(1)) yield return day; } }
    IEnumerable<AgendaGroup> AgendaGroups => FilteredEvents.OrderBy(e => e.Date).ThenBy(e => e.StartLocal).GroupBy(e => e.Date).Select(g => new AgendaGroup(FormatDateLabel(g.Key), g.ToList()));

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Workbench", "/workbench"), new("My Calendar", "/workbench/calendar"));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var rangeStart = new DateTime(_viewDate.Year, _viewDate.Month, 1).AddMonths(-1).ToUniversalTime();
            var rangeEnd = new DateTime(_viewDate.Year, _viewDate.Month, 1).AddMonths(2).AddDays(7).ToUniversalTime();
            var result = await Api.SearchCalendarEventsAsync(TenantId, startUtc: rangeStart, endUtc: rangeEnd, pageSize: 500);
            _events.Clear();
            _events.AddRange((result?.Items ?? []).Select(ToEvent));
            _selected = _selected is null ? FilteredEvents.FirstOrDefault(e => e.Date == _selectedDate) : FilteredEvents.FirstOrDefault(e => e.Id == _selected.Id) ?? FilteredEvents.FirstOrDefault();
        }
        catch (Exception ex) { _loadError = $"Failed to load calendar: {ex.Message}"; }
        finally { _loading = false; }
    }

    void SelectDay(DateOnly date) { _selectedDate = date; _selected = EventsOn(date).FirstOrDefault(); }
    void SelectEvent(CalEvent item) { _selected = item; _selectedDate = item.Date; }
    void PrevPeriod() { if (_activeTab == "week") _selectedDate = DateOnly.FromDateTime(_selectedDate.ToDateTime(TimeOnly.MinValue).AddDays(-7)); else _viewDate = _viewDate.AddMonths(-1); }
    void NextPeriod() { if (_activeTab == "week") _selectedDate = DateOnly.FromDateTime(_selectedDate.ToDateTime(TimeOnly.MinValue).AddDays(7)); else _viewDate = _viewDate.AddMonths(1); }
    void GoToday() { _viewDate = new(DateTime.Today.Year, DateTime.Today.Month, 1); _selectedDate = Today; _activeFilter = string.Empty; }
    void SetFilter(string? filter) => _activeFilter = _activeFilter == (filter ?? string.Empty) ? string.Empty : (filter ?? string.Empty);
    void ResetFilters() { _activeFilter = string.Empty; _search = string.Empty; }
    void NewEvent() { _editId = null; var start = _selectedDate.ToDateTime(new TimeOnly(9, 0)); _form = new() { StartLocal = start, EndLocal = start.AddHours(1), Type = "Meeting", Status = "Scheduled" }; _showForm = true; }
    void OpenEdit(CalEvent item) { _editId = item.Id; _form = new() { StartLocal = item.StartLocal, EndLocal = item.EndLocal, Type = item.Type, Status = item.Status, Title = item.Title, Notes = item.Notes, AllDay = item.AllDay, TimeZoneId = item.TimeZoneId }; _showForm = true; }
    void OpenDetail(CalEvent item) => SelectEvent(item);
    void ShowDelete(CalEvent item) { _selected = item; _showDelete = true; }
    void CloseForm() { _showForm = false; _form = new(); }
    void ShowToast(string message, bool isError = false) { _toastMessage = message; _toastIsError = isError; }
    void ClearToast() => _toastMessage = null;

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue)
                await Api.UpdateCalendarEventAsync(_editId.Value, new() { Title = _form.Title, Notes = _form.Notes, EventTypeCode = _form.Type, StatusCode = _form.Status, StartDateTimeUtc = _form.StartLocal.ToUniversalTime(), EndDateTimeUtc = _form.EndLocal?.ToUniversalTime(), AllDay = _form.AllDay, TimeZoneId = _form.TimeZoneId, OrganizerUserId = TenantAdminUserId, AssignedToUserId = TenantAdminUserId, ModifiedByUserId = TenantAdminUserId });
            else
                await Api.CreateCalendarEventAsync(new() { TenantId = TenantId, Title = _form.Title, Notes = _form.Notes, EventTypeCode = _form.Type, StatusCode = _form.Status, StartDateTimeUtc = _form.StartLocal.ToUniversalTime(), EndDateTimeUtc = _form.EndLocal?.ToUniversalTime(), AllDay = _form.AllDay, TimeZoneId = _form.TimeZoneId, OrganizerUserId = TenantAdminUserId, AssignedToUserId = TenantAdminUserId, CreatedByUserId = TenantAdminUserId });
            _showForm = false;
            ShowToast("Calendar event saved");
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast($"Save failed: {ex.Message}", isError: true); }
        finally { _saving = false; }
    }

    async Task ExecuteDeleteAsync()
    {
        if (_selected is null) return;
        _saving = true;
        try { await Api.DeleteCalendarEventAsync(_selected.Id, TenantAdminUserId); _showDelete = false; ShowToast("Calendar event deleted"); await LoadAsync(); }
        catch (Exception ex) { ShowToast($"Delete failed: {ex.Message}", isError: true); }
        finally { _saving = false; }
    }

    static CalEvent ToEvent(CalendarEventDto item) => new(item.EventId, item.Title, item.EventTypeCode, item.StatusCode, item.Notes ?? string.Empty, DateOnly.FromDateTime(item.StartDateTimeUtc.ToLocalTime()), item.StartDateTimeUtc.ToLocalTime(), item.EndDateTimeUtc?.ToLocalTime(), item.AllDay, item.TimeZoneId, item.AssignedToUserId ?? item.OrganizerUserId);
    static string DisplayTime(CalEvent item) => item.AllDay ? "All day" : item.EndLocal is null ? item.StartLocal.ToString("h:mm tt") : $"{item.StartLocal:h:mm tt}–{item.EndLocal:h:mm tt}";
    static string DisplayOwner(CalEvent item) => item.AssignedToUserId == TenantAdminUserId ? "Tenant Admin" : "Assigned user";
    static string TypeCss(string type) => type.ToLowerInvariant().Replace(" ", "-");
    static string TypeIcon(string type) => type switch { "Call" => "bi-telephone-fill", "Meeting" => "bi-calendar-event-fill", "Task" => "bi-check2-square", "Deadline" => "bi-flag-fill", "Event" => "bi-star-fill", _ => "bi-calendar3" };
    static string FormatDateLabel(DateOnly date) => date == Today ? "Today" : date == DateOnly.FromDateTime(DateTime.Today.AddDays(1)) ? "Tomorrow" : date.ToString("dddd, MMMM d");
    RenderFragment KpiCard(string icon, string label, string val, string title, string css, string? filter) => @<button class="mc-kpi-card @css @(_activeFilter == (filter ?? string.Empty) ? "mc-kpi-active" : "")" title="@title" @onclick="() => SetFilter(filter)"><div class="mc-kpi-val">@val</div><div class="mc-kpi-lbl"><i class="bi @icon"></i> @label</div></button>;

    sealed record TabDef(string Key, string Label, string Icon);
    sealed record CalEvent(Guid Id, string Title, string Type, string Status, string Notes, DateOnly Date, DateTime StartLocal, DateTime? EndLocal, bool AllDay, string TimeZoneId, Guid? AssignedToUserId);
    sealed record AgendaGroup(string Label, List<CalEvent> Events);
    sealed class EventForm { [Required] public DateTime StartLocal { get; set; } = DateTime.Today.AddHours(9); public DateTime? EndLocal { get; set; } = DateTime.Today.AddHours(10); public bool AllDay { get; set; } [Required, StringLength(50)] public string Type { get; set; } = "Meeting"; [Required, StringLength(50)] public string Status { get; set; } = "Scheduled"; [Required, StringLength(100)] public string TimeZoneId { get; set; } = "America/Chicago"; [Required, StringLength(200)] public string Title { get; set; } = string.Empty; [StringLength(2000)] public string? Notes { get; set; } }
}
