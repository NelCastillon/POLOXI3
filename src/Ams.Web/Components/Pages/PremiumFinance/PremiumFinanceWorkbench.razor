@page "/premium-finance"
@namespace Ams.Web.Components.Pages.PremiumFinance
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.PremiumFinance
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Premium Finance - AgencyBinder</PageTitle>

@if (!string.IsNullOrWhiteSpace(_toast))
{
    <div class="pf-toast pf-toast--@_toastKind" role="status"><i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle" : "bi-check-circle")"></i>@_toast<button @onclick="() => _toast = null"><i class="bi bi-x-lg"></i></button></div>
}

<div class="pf-page">
    <header class="pf-hero">
        <div class="pf-hero-left">
            <div class="pf-hero-icon"><i class="bi bi-bank2" aria-hidden="true"></i></div>
            <div class="pf-header-info">
                <div class="pf-title-row"><h1>Premium Finance</h1><span>@FilteredRequests.Count() matches</span>@if(AccountId is not null){<span>Account scoped</span>}</div>
                <p>Enterprise command center for provider terms, finance agreements, signatures, funding, payment schedules, and account attention.</p>
                <div class="pf-sub-row"><span><i class="bi bi-stack"></i>@_summary.TotalRequests total requests</span><span><i class="bi bi-check-circle"></i>@_summary.ActiveFinancing active</span><span><i class="bi bi-exclamation-diamond"></i>@_summary.AttentionRequired attention</span><span><i class="bi bi-cash-stack"></i>@_summary.TotalAmountFinanced.ToString("C0") financed</span></div>
            </div>
        </div>
        <div class="pf-actions"><button class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "pf-spin" : "")"></i> Refresh</button><button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetTab("providers")'><i class="bi bi-buildings"></i> Providers</button><button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetTab("reports")'><i class="bi bi-bar-chart"></i> Reports</button><button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenRequest"><i class="bi bi-plus-lg"></i> Finance Premium</button></div>
    </header>

    @if (_loading)
    {
        <div class="pf-state"><span class="spinner-border"></span><strong>Synchronizing premium finance records...</strong></div>
    }
    else if (_loadError is not null)
    {
        <div class="pf-state pf-state--error"><i class="bi bi-exclamation-triangle"></i><strong>Premium Finance could not be loaded</strong><span>@_loadError</span><button class="um-btn um-btn-primary" @onclick="LoadAsync">Retry</button></div>
    }
    else
    {
        <section class="pf-kpis">
            @Metric("Requests", _summary.TotalRequests.ToString(), "bi-inboxes", "pf-kpi-total", "all")
            @Metric("Options Pending", _summary.OptionsPending.ToString(), "bi-hourglass-split", "pf-kpi-pending", "requests")
            @Metric("Pending Signatures", _summary.PendingSignatures.ToString(), "bi-pen", "pf-kpi-signatures", "signatures")
            @Metric("Pending Approval", _summary.PendingApprovals.ToString(), "bi-patch-check", "pf-kpi-approval", "approval")
            @Metric("Active", _summary.ActiveFinancing.ToString(), "bi-check-circle", "pf-kpi-active", "active")
            @Metric("Attention", _summary.AttentionRequired.ToString(), "bi-exclamation-diamond", "pf-kpi-attention", "attention")
        </section>

        <section class="pf-workflows" aria-label="Premium finance workflow shortcuts">
            <button type="button" @onclick='() => SetTab("quotes")'><i class="bi bi-ui-radios-grid"></i><div><strong>Compare Terms</strong><span>Review provider options, down payments, APR, and installments</span></div></button>
            <button type="button" @onclick='() => SetTab("signatures")'><i class="bi bi-pen"></i><div><strong>Signatures</strong><span>Track customer delivery, signature, and agreement completion</span></div></button>
            <button type="button" @onclick='() => SetTab("active")'><i class="bi bi-calendar2-check"></i><div><strong>Payment Schedules</strong><span>Monitor financed accounts, installments, and provider status</span></div></button>
            <button type="button" @onclick='() => SetTab("attention")'><i class="bi bi-exclamation-triangle"></i><div><strong>Account Attention</strong><span>Resolve past-due accounts and cancellation-pending notices</span></div></button>
        </section>

        <div class="pf-search-row" role="search" aria-label="Search premium finance">
            <div class="pf-global-search"><i class="bi bi-search"></i><input @bind="_search" @bind:event="oninput" placeholder="Search every finance field: request, insured, policy, carrier, line of business, or provider..." /></div>
            <div class="pf-search-result"><strong>@FilteredRequests.Count()</strong><span>matches</span></div>
            @if(!string.IsNullOrWhiteSpace(_search)){<button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearSearch"><i class="bi bi-x-lg"></i> Clear</button>}
        </div>

        <nav class="pf-tabs" aria-label="Premium finance workbench views">
            @foreach (var tab in Tabs)
            {
                <button class="@(_tab == tab.Code ? "active" : null)" @onclick="() => SetTab(tab.Code)"><i class="bi @tab.Icon"></i>@tab.Label <span>@TabCount(tab.Code)</span></button>
            }
        </nav>

        @if (_tab == "providers")
        {
            <section class="pf-panel"><div class="pf-panel-head"><div><span>Provider network</span><h2>Premium Finance Companies</h2></div><button class="um-btn um-btn-primary" @onclick="OpenProvider"><i class="bi bi-plus-lg"></i> Add Provider</button></div>
                <div class="pf-provider-grid">@foreach (var provider in _providers){<article class="pf-provider"><div><span class="pf-provider-icon"><i class="bi bi-building"></i></span><div><h3>@provider.CompanyName</h3><span>@provider.CompanyCode · @OptionName("IntegrationLevel", provider.IntegrationLevelCode)</span></div><span class="pf-status @StatusCss(provider.IsActive ? "Active" : "Inactive")">@(provider.IsActive ? "Active" : "Inactive")</span></div><dl><dt>Contact</dt><dd>@Text(provider.ContactName)</dd><dt>Email</dt><dd>@Text(provider.EmailAddress)</dd><dt>Phone</dt><dd>@Text(provider.PhoneNumber)</dd></dl><div class="pf-capabilities"><span class="@(provider.SupportsQuotes ? "on" : null)">Quotes</span><span class="@(provider.SupportsApplications ? "on" : null)">Applications</span><span class="@(provider.SupportsAgreements ? "on" : null)">Agreements</span><span class="@(provider.SupportsPaymentSchedules ? "on" : null)">Schedules</span><span class="@(provider.SupportsPayoff ? "on" : null)">Payoff</span></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => EditProvider(provider)"><i class="bi bi-pencil"></i> Edit</button></article>}</div>
            </section>
        }
        else if (_tab == "reports")
        {
            <section class="pf-report-grid"><article><span>Total financed</span><strong>@_summary.TotalAmountFinanced.ToString("C0")</strong><small>Across recorded agreements</small></article><article><span>Outstanding scheduled</span><strong>@_summary.TotalOutstandingScheduled.ToString("C0")</strong><small>Provider schedule balance</small></article><article><span>Renewals due</span><strong>@_summary.RenewalsDue</strong><small>Within 90 days</small></article><article><span>Conversion</span><strong>@ConversionRate.ToString("P0")</strong><small>Requests reaching active financing</small></article></section>
        }
        else
        {
            <section class="pf-panel">
                <div class="pf-panel-head"><div><span>Agency work queue</span><h2>@TabTitle</h2></div><div class="pf-grid-meta"><strong>@FilteredRequests.Count()</strong><span>records</span></div></div>
                @if (!FilteredRequests.Any())
                {
                    <div class="pf-empty"><i class="bi bi-bank"></i><h3>No premium finance records</h3><p>The selected queue has no database records.</p></div>
                }
                else
                {
                    <div class="pf-table-wrap"><table class="pf-table"><thead><tr><th>Request</th><th>Insured / Policy</th><th>Provider</th><th>Premium</th><th>Financed</th><th>Next Due</th><th>Status</th><th></th></tr></thead><tbody>
                    @foreach (var request in FilteredRequests)
                    {
                        var agreement = AgreementFor(request);
                        <tr @onclick="() => OpenDetailAsync(request)"><td><strong>@request.RequestNumber</strong><small>@request.SourceTypeCode · @request.CreatedDateUtc.ToString("MMM d, yyyy")</small></td><td><strong>@request.InsuredName</strong><small>@request.PolicyOrQuoteNumber · @request.LineOfBusiness</small></td><td>@(agreement?.FinanceCompanyName ?? ProviderName(request.PreferredFinanceCompanyId))</td><td>@request.TotalCostAmount.ToString("C0")</td><td>@(agreement?.FinancedAmount.ToString("C0") ?? "—")</td><td>@(agreement?.NextPaymentDate?.ToString("MMM d, yyyy") ?? "—")</td><td><span class="pf-status @StatusCss(request.StatusCode)">@OptionName("RequestStatus", request.StatusCode)</span></td><td><button type="button" class="pf-open" aria-label="Open request" @onclick:stopPropagation="true" @onclick="() => OpenDetailAsync(request)"><i class="bi bi-chevron-right"></i></button></td></tr>
                    }
                    </tbody></table></div>
                }
            </section>
        }
    }
</div>

@if (_detail is not null)
{
    <div class="pf-drawer-backdrop" @onclick="CloseDetail"><aside class="pf-drawer" @onclick:stopPropagation="true"><header><div><span>@_detail.Request.RequestNumber</span><h2>@_detail.Request.InsuredName</h2><small>@_detail.Request.PolicyOrQuoteNumber · @_detail.Request.LineOfBusiness</small></div><button @onclick="CloseDetail"><i class="bi bi-x-lg"></i></button></header>
        <div class="pf-drawer-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenEditRequest" disabled="@_busy"><i class="bi bi-pencil"></i> Edit Request</button>
            @if(_detail.Agreement is null){<button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenOption" disabled="@_busy"><i class="bi bi-plus"></i> Record Option</button>}
            @if(_detail.Request.SelectedQuoteOptionId is not null && _detail.Agreement is null){<button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenApplication" disabled="@_busy"><i class="bi bi-send"></i> Submit Application</button>}
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenStatus" disabled="@_busy"><i class="bi bi-arrow-repeat"></i> Update Status</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenActivity" disabled="@_busy"><i class="bi bi-journal-plus"></i> Add Activity</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenDocument" disabled="@_busy"><i class="bi bi-paperclip"></i> Link Document</button>
            @if(_detail.Agreement is not null){<button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenAgreement" disabled="@_busy"><i class="bi bi-file-earmark-check"></i> Update Agreement</button><button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenSchedule" disabled="@_busy"><i class="bi bi-calendar3"></i> Sync Schedule</button>}
            @if(_detail.Request.StatusCode is not "Active" and not "Cancelled"){<button class="um-btn um-btn-danger um-btn-sm" @onclick="OpenCancel" disabled="@_busy"><i class="bi bi-x-circle"></i> Cancel Request</button>}
        </div>
        <section class="pf-detail-summary"><div><span>Total premium</span><strong>@_detail.Request.TotalCostAmount.ToString("C")</strong></div><div><span>Effective</span><strong>@_detail.Request.EffectiveDate.ToString("MMM d, yyyy")</strong></div><div><span>Status</span><strong>@OptionName("RequestStatus", _detail.Request.StatusCode)</strong></div></section>
        <section class="pf-detail-section"><h3>Finance options</h3>@if(!_detail.QuoteOptions.Any()){<p class="pf-muted">No provider terms recorded.</p>}else{<div class="pf-options">@foreach(var option in _detail.QuoteOptions){<article class="@(option.IsSelected ? "selected" : null)"><header><div><strong>@option.OptionName</strong><small>@option.FinanceCompanyName</small></div>@if(option.IsSelected){<span>Selected</span>}</header><dl><div><dt>Down payment</dt><dd>@option.DownPaymentAmount.ToString("C0") (@option.DownPaymentPercent.ToString("0.##")%)</dd></div><div><dt>APR</dt><dd>@option.AprPercent.ToString("0.###")%</dd></div><div><dt>Payments</dt><dd>@option.PaymentCount × @option.PaymentAmount.ToString("C")</dd></div><div><dt>Financed</dt><dd>@option.AmountFinanced.ToString("C0")</dd></div></dl>@if(!option.IsSelected && _detail.Agreement is null){<button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => SelectOptionAsync(option)">Select option</button>}</article>}</div>}</section>
        @if(_detail.Agreement is not null){<section class="pf-detail-section"><h3>Agreement</h3><dl class="pf-agreement"><div><dt>Provider</dt><dd>@_detail.Agreement.FinanceCompanyName</dd></div><div><dt>Agreement</dt><dd>@_detail.Agreement.AgreementNumber</dd></div><div><dt>Amount financed</dt><dd>@_detail.Agreement.FinancedAmount.ToString("C")</dd></div><div><dt>Signature</dt><dd>@Text(_detail.Agreement.SignatureStatusCode)</dd></div><div><dt>Account status</dt><dd>@Text(_detail.Agreement.AccountStatusCode)</dd></div><div><dt>Next payment</dt><dd>@(_detail.Agreement.NextPaymentDate?.ToString("MMM d, yyyy") ?? "Not recorded")</dd></div></dl></section>
        <section class="pf-detail-section"><h3>Provider payment schedule</h3>@if(!_detail.PaymentSchedule.Any()){<p class="pf-muted">No provider payment schedule recorded.</p>}else{<table class="pf-mini-table"><thead><tr><th>#</th><th>Due</th><th>Amount</th><th>Status</th></tr></thead><tbody>@foreach(var item in _detail.PaymentSchedule){<tr><td>@item.InstallmentNumber</td><td>@item.DueDate.ToString("MMM d, yyyy")</td><td>@item.ScheduledAmount.ToString("C")</td><td>@item.StatusCode</td></tr>}</tbody></table>}</section>}
        <section class="pf-detail-section"><h3>Activity</h3><div class="pf-timeline">@foreach(var activity in _detail.Activities){<article><span><i class="bi bi-circle-fill"></i></span><div><strong>@activity.Subject</strong><small>@activity.ActivityDateUtc.ToString("MMM d, yyyy h:mm tt") · @Text(activity.CreatedByName)</small>@if(!string.IsNullOrWhiteSpace(activity.Notes)){<p>@activity.Notes</p>}</div></article>}</div></section>
    </aside></div>
}

@if (_modal is not null)
{
    <div class="pf-modal-backdrop"><div class="pf-modal"><header><h2>@ModalTitle</h2><button @onclick="CloseModal"><i class="bi bi-x-lg"></i></button></header>
        @if(_modal == "request")
        {
            <EditForm Model="_requestForm" OnValidSubmit="SaveRequestAsync"><DataAnnotationsValidator/><ValidationSummary class="pf-validation"/><div class="pf-form"><label>Source type<InputSelect @bind-Value="_requestForm.SourceType"><option value="Quote">Selected / accepted quote</option><option value="Policy">Bound policy</option><option value="Renewal">Renewal</option></InputSelect></label><label>Source record ID<InputText @bind-Value="_requestForm.SourceIdText" placeholder="Paste the quote, policy, or renewal ID"/></label><button type="button" class="um-btn um-btn-ghost" @onclick="LoadSourceAsync" disabled="@_busy">Load source</button>@if(_source is not null){<div class="pf-source"><strong>@_source.InsuredName</strong><span>@_source.PolicyOrQuoteNumber · @_source.CarrierName</span><span>@_source.PremiumAmount.ToString("C") premium + @((_source.TaxAmount+_source.FeeAmount).ToString("C")) taxes/fees</span>@if(!_source.IsEligible){<em>@_source.IneligibilityReason</em>}</div>}<label>Preferred provider<InputSelect @bind-Value="_requestForm.ProviderId"><option value="">No preference</option>@foreach(var p in _providers.Where(x=>x.IsActive)){<option value="@p.FinanceCompanyId">@p.CompanyName</option>}</InputSelect></label><label>Requested down payment<InputNumber @bind-Value="_requestForm.DownPayment"/></label><label>Requested payments<InputNumber @bind-Value="_requestForm.PaymentCount"/></label><label class="full">Notes<InputTextArea @bind-Value="_requestForm.Notes"/></label></div><footer><button type="button" class="um-btn um-btn-ghost" @onclick="CloseModal" disabled="@_busy">Cancel</button><button class="um-btn um-btn-primary" disabled="@(_busy || _source?.IsEligible != true)">Create Request</button></footer></EditForm>
        }
        else if(_modal == "option")
        {
            <EditForm Model="_optionForm" OnValidSubmit="SaveOptionAsync"><DataAnnotationsValidator/><ValidationSummary class="pf-validation"/><div class="pf-form"><label>Provider<InputSelect @bind-Value="_optionForm.ProviderId"><option value="">Select provider</option>@foreach(var p in _providers.Where(x=>x.IsActive&&x.SupportsQuotes)){<option value="@p.FinanceCompanyId">@p.CompanyName</option>}</InputSelect></label><label>Option name<InputText @bind-Value="_optionForm.Name"/></label><label>Down payment %<InputNumber @bind-Value="_optionForm.DownPercent"/></label><label>Down payment amount<InputNumber @bind-Value="_optionForm.DownAmount"/></label><label>Amount financed<InputNumber @bind-Value="_optionForm.Financed"/></label><label>APR %<InputNumber @bind-Value="_optionForm.Apr"/></label><label>Finance charge<InputNumber @bind-Value="_optionForm.FinanceCharge"/></label><label>Payment count<InputNumber @bind-Value="_optionForm.PaymentCount"/></label><label>Payment amount<InputNumber @bind-Value="_optionForm.PaymentAmount"/></label><label>First payment<InputDate @bind-Value="_optionForm.FirstPayment"/></label><label>Option expires<InputDate @bind-Value="_optionForm.Expires"/></label><label class="full">Terms summary<InputTextArea @bind-Value="_optionForm.Terms"/></label></div><footer><button type="button" class="um-btn um-btn-ghost" @onclick="CloseModal" disabled="@_busy">Cancel</button><button class="um-btn um-btn-primary" disabled="@_busy">Record Provider Terms</button></footer></EditForm>
        }
        else if(_modal == "application")
        {
            <EditForm Model="_applicationForm" OnValidSubmit="SaveApplicationAsync"><DataAnnotationsValidator/><ValidationSummary class="pf-validation"/><div class="pf-form"><label>Agreement number<InputText @bind-Value="_applicationForm.AgreementNumber"/></label><label>Provider application reference<InputText @bind-Value="_applicationForm.ProviderReference"/></label><label>Expected funding date<InputDate @bind-Value="_applicationForm.ExpectedFunding"/></label><label>Cancellation protection date<InputDate @bind-Value="_applicationForm.CancellationProtection"/></label></div><footer><button type="button" class="um-btn um-btn-ghost" @onclick="CloseModal" disabled="@_busy">Cancel</button><button class="um-btn um-btn-primary" disabled="@_busy">Record Submission</button></footer></EditForm>
        }
        else if(_modal == "status")
        {
            <EditForm Model="_statusForm" OnValidSubmit="SaveStatusAsync"><DataAnnotationsValidator/><ValidationSummary class="pf-validation"/><div class="pf-form"><label>Status<InputSelect @bind-Value="_statusForm.Status"><option value="">Select status</option>@foreach(var s in Options("RequestStatus")){<option value="@s.OptionCode">@s.DisplayName</option>}</InputSelect></label><label class="full">Notes<InputTextArea @bind-Value="_statusForm.Notes"/></label></div><footer><button type="button" class="um-btn um-btn-ghost" @onclick="CloseModal" disabled="@_busy">Cancel</button><button class="um-btn um-btn-primary" disabled="@_busy">Update Status</button></footer></EditForm>
        }
        else if(_modal == "provider")
        {
            <EditForm Model="_providerForm" OnValidSubmit="SaveProviderAsync"><DataAnnotationsValidator/><ValidationSummary class="pf-validation"/><div class="pf-form"><label>Code<InputText @bind-Value="_providerForm.Code"/></label><label>Company name<InputText @bind-Value="_providerForm.Name"/></label><label>Integration level<InputSelect @bind-Value="_providerForm.Level">@foreach(var level in Options("IntegrationLevel")){<option value="@level.OptionCode">@level.DisplayName</option>}</InputSelect></label><label>Contact<InputText @bind-Value="_providerForm.Contact"/></label><label>Email<InputText @bind-Value="_providerForm.Email"/></label><label>Phone<InputText @bind-Value="_providerForm.Phone"/></label><label>Website<InputText @bind-Value="_providerForm.Website"/></label><label>Portal<InputText @bind-Value="_providerForm.Portal"/></label><label class="pf-check"><InputCheckbox @bind-Value="_providerForm.Active"/> Active</label><div class="pf-checks full"><label><InputCheckbox @bind-Value="_providerForm.Quotes"/> Quotes</label><label><InputCheckbox @bind-Value="_providerForm.Applications"/> Applications</label><label><InputCheckbox @bind-Value="_providerForm.Agreements"/> Agreements</label><label><InputCheckbox @bind-Value="_providerForm.Schedules"/> Schedules</label><label><InputCheckbox @bind-Value="_providerForm.AccountStatus"/> Account status</label><label><InputCheckbox @bind-Value="_providerForm.Payoff"/> Payoff</label></div><label class="full">Remittance instructions<InputTextArea @bind-Value="_providerForm.Remittance"/></label></div><footer><button type="button" class="um-btn um-btn-ghost" @onclick="CloseModal" disabled="@_busy">Cancel</button><button class="um-btn um-btn-primary" disabled="@_busy">Save Provider</button></footer></EditForm>
        }
        else if(_modal == "edit-request")
        {
            <EditForm Model="_editRequestForm" OnValidSubmit="SaveRequestChangesAsync"><DataAnnotationsValidator/><ValidationSummary class="pf-validation"/><div class="pf-form"><label>Preferred provider<InputSelect @bind-Value="_editRequestForm.ProviderId"><option value="">No preference</option>@foreach(var p in _providers.Where(x=>x.IsActive)){<option value="@p.FinanceCompanyId">@p.CompanyName</option>}</InputSelect></label><label>Requested down payment<InputNumber @bind-Value="_editRequestForm.DownPayment"/></label><label>Requested payments<InputNumber @bind-Value="_editRequestForm.PaymentCount"/></label><label>Email<InputText @bind-Value="_editRequestForm.Email"/></label><label>Phone<InputText @bind-Value="_editRequestForm.Phone"/></label><label class="full">Notes<InputTextArea @bind-Value="_editRequestForm.Notes"/></label></div><footer><button type="button" class="um-btn um-btn-ghost" @onclick="CloseModal" disabled="@_busy">Cancel</button><button class="um-btn um-btn-primary" disabled="@_busy">Save Request</button></footer></EditForm>
        }
        else if(_modal == "activity")
        {
            <EditForm Model="_activityForm" OnValidSubmit="SaveActivityAsync"><DataAnnotationsValidator/><ValidationSummary class="pf-validation"/><div class="pf-form"><label>Activity type<InputSelect @bind-Value="_activityForm.Type"><option value="">Select activity</option>@foreach(var x in Options("ActivityType")){<option value="@x.OptionCode">@x.DisplayName</option>}</InputSelect></label><label>Provider reference<InputText @bind-Value="_activityForm.ProviderReference"/></label><label class="full">Subject<InputText @bind-Value="_activityForm.Subject"/></label><label class="full">Notes<InputTextArea @bind-Value="_activityForm.Notes"/></label></div><footer><button type="button" class="um-btn um-btn-ghost" @onclick="CloseModal" disabled="@_busy">Cancel</button><button class="um-btn um-btn-primary" disabled="@_busy">Add Activity</button></footer></EditForm>
        }
        else if(_modal == "document")
        {
            <EditForm Model="_documentForm" OnValidSubmit="SaveDocumentAsync"><DataAnnotationsValidator/><ValidationSummary class="pf-validation"/><div class="pf-form"><label class="full">Existing DMS document ID<InputText @bind-Value="_documentForm.DocumentIdText"/></label><label>Document role<InputSelect @bind-Value="_documentForm.Role"><option value="">Select role</option>@foreach(var x in Options("DocumentRole")){<option value="@x.OptionCode">@x.DisplayName</option>}</InputSelect></label></div><footer><button type="button" class="um-btn um-btn-ghost" @onclick="CloseModal" disabled="@_busy">Cancel</button><button class="um-btn um-btn-primary" disabled="@_busy">Link Document</button></footer></EditForm>
        }
        else if(_modal == "agreement")
        {
            <EditForm Model="_agreementForm" OnValidSubmit="SaveAgreementAsync"><DataAnnotationsValidator/><ValidationSummary class="pf-validation"/><div class="pf-form"><label>Application status<InputSelect @bind-Value="_agreementForm.ApplicationStatus"><option value="">No change</option>@foreach(var x in Options("ApplicationStatus")){<option value="@x.OptionCode">@x.DisplayName</option>}</InputSelect></label><label>Signature status<InputSelect @bind-Value="_agreementForm.SignatureStatus"><option value="">No change</option>@foreach(var x in Options("SignatureStatus")){<option value="@x.OptionCode">@x.DisplayName</option>}</InputSelect></label><label>Funding status<InputSelect @bind-Value="_agreementForm.FundingStatus"><option value="">No change</option>@foreach(var x in Options("FundingStatus")){<option value="@x.OptionCode">@x.DisplayName</option>}</InputSelect></label><label>Account status<InputSelect @bind-Value="_agreementForm.AccountStatus"><option value="">No change</option>@foreach(var x in Options("AccountStatus")){<option value="@x.OptionCode">@x.DisplayName</option>}</InputSelect></label><label>Agreement status<InputSelect @bind-Value="_agreementForm.Status"><option value="">No change</option>@foreach(var x in Options("AgreementStatus")){<option value="@x.OptionCode">@x.DisplayName</option>}</InputSelect></label><label>Funded date<InputDate @bind-Value="_agreementForm.FundedDate"/></label><label>Next payment<InputDate @bind-Value="_agreementForm.NextPaymentDate"/></label><label>Payoff amount<InputNumber @bind-Value="_agreementForm.PayoffAmount"/></label><label>Payoff good through<InputDate @bind-Value="_agreementForm.PayoffGoodThrough"/></label><label class="full">Notes<InputTextArea @bind-Value="_agreementForm.Notes"/></label></div><footer><button type="button" class="um-btn um-btn-ghost" @onclick="CloseModal" disabled="@_busy">Cancel</button><button class="um-btn um-btn-primary" disabled="@_busy">Update Agreement</button></footer></EditForm>
        }
        else if(_modal == "schedule")
        {
