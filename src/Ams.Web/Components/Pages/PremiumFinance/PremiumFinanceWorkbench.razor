    IEnumerable<PremiumFinanceRequestDto> FilteredRequests{get{var rows=_requests.AsEnumerable();if(AccountId is not null)rows=rows.Where(x=>x.AccountId==AccountId);rows=_tab switch{"requests"=>rows.Where(x=>x.StatusCode is "Draft" or "OptionsRequested" or "OptionsReceived" or "OptionSelected"),"quotes"=>rows.Where(x=>x.StatusCode is "OptionsReceived" or "OptionSelected"),"agreements"=>rows.Where(x=>AgreementFor(x) is not null),"active"=>rows.Where(x=>x.StatusCode=="Active"),"signatures"=>rows.Where(x=>x.StatusCode=="PendingSignature"),"approval"=>rows.Where(x=>x.StatusCode=="PendingApproval"),"attention"=>rows.Where(x=>AgreementFor(x)?.AccountStatusCode is "PastDue" or "CancellationPending"),"renewals"=>rows.Where(x=>x.RenewalId is not null),_=>rows};if(!string.IsNullOrWhiteSpace(_search))rows=rows.Where(x=>string.Join(' ',x.RequestNumber,x.InsuredName,x.PolicyOrQuoteNumber,x.CarrierName,x.LineOfBusiness,ProviderName(x.PreferredFinanceCompanyId)).Contains(_search,StringComparison.OrdinalIgnoreCase));return rows;}}
