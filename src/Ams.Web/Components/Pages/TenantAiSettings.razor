@page "/tenant/ai/features2"
@page "/tenant/ai/summaries2"
@page "/tenant/ai/renewal-risk2"
@page "/tenant/ai/nba2"
@page "/tenant/ai/cross-sell2"
@page "/tenant/ai/prompts2"
@page "/tenant/ai/usage2"
@page "/tenant/ai/feedback2"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>AI Settings — AMS</PageTitle>

<AppPageHeader Title="AI Settings"
               Subtitle="Tenant admin control center for AI features, summaries, renewal risk, next best actions, cross-sell, prompts, usage, and feedback"
               Icon="bi-stars">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/tenant/ai/features")'>
            <i class="bi bi-toggles" aria-hidden="true"></i> Feature Settings
        </button>
    </Actions>
</AppPageHeader>

<section class="aiset-hero" aria-label="AI settings overview">
    <div>
        <span class="aiset-eyebrow">Tenant administration</span>
        <h2>AI Governance Workflow</h2>
        <p>Configure AI availability, model-assisted account summaries, renewal risk scoring, next best action rules, cross-sell intelligence, prompt templates, usage controls, and feedback loops.</p>
    </div>
    <div class="aiset-hero-grid">
        @foreach (var action in _quickActions)
        {
            <button class="aiset-quick-action" @onclick="() => Nav.NavigateTo(action.Url)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
</section>

<section class="aiset-kpi-grid" aria-label="AI settings metrics">
    @Kpi("Enabled Features", "14", "Tenant AI capabilities", "bi-toggles", "aiset-tone-blue")
    @Kpi("Usage", "68%", "Monthly AI budget", "bi-bar-chart-line", "aiset-tone-amber")
    @Kpi("Prompt Health", "97%", "Approved templates", "bi-chat-left-text", "aiset-tone-green")
    @Kpi("Feedback", "42", "Items pending review", "bi-hand-thumbs-up", "aiset-tone-red")
</section>

<section class="aiset-command-bar" aria-label="AI settings filters">
    <div class="aiset-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search"
               placeholder="Search AI workflow, feature, owner, control, module..."
               @bind="_search"
               @bind:event="oninput" />
    </div>
    <div class="aiset-pill-group" role="group" aria-label="AI workflow filter">
        @foreach (var filter in _filters)
        {
            <button class="aiset-pill @(_filter == filter.Key ? "aiset-pill--active" : "")"
                    @onclick="() => _filter = filter.Key">
                @filter.Label
                <span>@FilterCount(filter.Key)</span>
            </button>
        }
    </div>
</section>

<section class="aiset-layout">
    <div class="aiset-flow" aria-label="AI settings workflow lanes">
        @foreach (var lane in _lanes)
        {
            var laneItems = FilteredWorkflow.Where(x => x.Stage == lane.Key).ToList();
            <article class="aiset-lane">
                <header class="aiset-lane-header">
                    <div>
                        <span class="aiset-lane-title">@lane.Label</span>
                        <span class="aiset-lane-subtitle">@lane.Description</span>
                    </div>
                    <span class="aiset-lane-count">@laneItems.Count</span>
                </header>

                <div class="aiset-lane-list">
                    @if (laneItems.Count == 0)
                    {
                        <div class="aiset-empty-mini">No visible workflow items.</div>
                    }
                    else
                    {
                        @foreach (var item in laneItems)
                        {
                            <button class="aiset-work-card @(item.Risk == "High" ? "aiset-work-card--risk" : "")"
                                    @onclick="() => _selected = item">
                                <div class="aiset-work-topline">
                                    <span class="aiset-chip @ToneCss(item.Domain)">@item.Domain</span>
                                    <span class="aiset-status @RiskCss(item.Risk)">@item.Risk</span>
                                </div>
                                <strong>@item.Title</strong>
                                <p>@item.Summary</p>
                                <div class="aiset-work-meta">
                                    <span><i class="bi bi-person" aria-hidden="true"></i> @item.Owner</span>
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> @item.Sla</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            </article>
        }
    </div>

    <aside class="aiset-admin-panel" aria-label="Tenant AI administration controls">
        @if (_selected is null)
        {
            <div class="aiset-side-empty">
                <i class="bi bi-stars" aria-hidden="true"></i>
                <h3>AI governance</h3>
                <p>Select a workflow item to inspect ownership, risk, SLA, approval policy, model governance, and module action.</p>
            </div>
        }
        else
        {
            <div class="aiset-detail-header">
                <span class="aiset-chip @ToneCss(_selected.Domain)">@_selected.Domain</span>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close details">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h3>@_selected.Title</h3>
            <p>@_selected.Summary</p>

            <dl class="aiset-detail-list">
                <div><dt>Owner</dt><dd>@_selected.Owner</dd></div>
                <div><dt>Stage</dt><dd>@_selected.Stage</dd></div>
                <div><dt>Risk</dt><dd><span class="aiset-status @RiskCss(_selected.Risk)">@_selected.Risk</span></dd></div>
                <div><dt>SLA</dt><dd>@_selected.Sla</dd></div>
                <div><dt>Control</dt><dd>@_selected.Control</dd></div>
            </dl>

            <div class="aiset-policy-card">
                <strong>Tenant AI controls</strong>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Human review and escalation policies enforced</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Prompt templates, AI usage, and feedback auditable</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Risk scoring and recommendation thresholds governed</span>
            </div>

            <div class="aiset-detail-actions">
                <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selected.Url)">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Module
                </button>
                <button class="um-btn um-btn-ghost" @onclick="() => Advance(_selected)">
                    <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Advance
                </button>
            </div>
        }
    </aside>
</section>

<section class="aiset-module-grid" aria-label="AI settings modules">
    @foreach (var module in _modules)
    {
        <button class="aiset-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
            <span class="aiset-module-icon @ToneCss(module.Domain)"><i class="bi @module.Icon" aria-hidden="true"></i></span>
            <span class="aiset-module-content">
                <strong>@module.Title</strong>
                <small>@module.Description</small>
            </span>
            <i class="bi bi-chevron-right aiset-module-arrow" aria-hidden="true"></i>
        </button>
    }
</section>

@code {
    private string _search = string.Empty;
    private string _filter = string.Empty;
    private AiWorkflowItem? _selected;
    private readonly List<AiWorkflowItem> _workflow = [];

    private readonly Lane[] _lanes =
    [
        new("Enable", "Enable", "Features and model guardrails"),
        new("Tune", "Tune", "Scoring and prompt controls"),
        new("Operate", "Operate", "Usage and monitoring"),
        new("Review", "Review", "Feedback and quality review"),
        new("Audit", "Audit", "Governance and evidence")
    ];

    private readonly Filter[] _filters =
    [
        new("", "All"),
        new("risk", "High Risk"),
        new("prompts", "Prompts"),
        new("usage", "Usage"),
        new("feedback", "Feedback")
    ];

    private readonly AiModule[] _modules =
    [
        new("AI Feature Settings", "Enable tenant AI capabilities, rollout groups, safety toggles, and feature gates.", "/tenant/ai/features", "bi-toggles", "Features"),
        new("Account Summary Settings", "Control account summary generation, source data, recency, and review thresholds.", "/tenant/ai/summaries", "bi-person-vcard", "Summaries"),
        new("Renewal Risk Settings", "Configure renewal risk signals, scoring thresholds, actions, and escalation rules.", "/tenant/ai/renewal-risk", "bi-arrow-clockwise", "Risk"),
        new("Next Best Action Rules", "Govern AI-prioritized recommendations, business rules, suppression, and routing.", "/tenant/ai/nba", "bi-lightning-charge", "Actions"),
        new("Cross-Sell AI Settings", "Tune product affinity signals, eligibility, exclusions, and producer review requirements.", "/tenant/ai/cross-sell", "bi-arrows-expand", "Cross-Sell"),
        new("Prompt Templates", "Approve, version, test, and publish tenant prompt templates and system instructions.", "/tenant/ai/prompts", "bi-chat-left-text", "Prompts"),
        new("AI Usage", "Monitor token usage, costs, model calls, automation runs, errors, and monthly budgets.", "/tenant/ai/usage", "bi-bar-chart-line", "Usage"),
        new("AI Feedback", "Review thumbs up/down, outcome feedback, drift signals, and improvement backlog.", "/tenant/ai/feedback", "bi-hand-thumbs-up", "Feedback")
    ];

    private readonly AiModule[] _quickActions =
    [
        new("Features", "", "/tenant/ai/features", "bi-toggles", "Features"),
        new("Prompts", "", "/tenant/ai/prompts", "bi-chat-left-text", "Prompts"),
        new("Usage", "", "/tenant/ai/usage", "bi-bar-chart-line", "Usage"),
        new("Feedback", "", "/tenant/ai/feedback", "bi-hand-thumbs-up", "Feedback")
    ];

    private IEnumerable<AiWorkflowItem> FilteredWorkflow => _workflow.Where(item =>
        (string.IsNullOrWhiteSpace(_filter) || _filter switch
        {
            "risk" => item.Risk == "High",
            "prompts" => item.Domain == "Prompts",
            "usage" => item.Domain == "Usage",
            "feedback" => item.Domain == "Feedback",
            _ => true
        }) &&
        (string.IsNullOrWhiteSpace(_search) ||
         item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Domain.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Control.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(x => x.Risk == "High")
        .ThenBy(x => x.Stage)
        .ThenBy(x => x.Title);

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("AI Settings", "/tenant/ai/features"));
        BuildWorkflow();
        _selected = _workflow.FirstOrDefault(x => x.Risk == "High") ?? _workflow.FirstOrDefault();
    }

    private void BuildWorkflow()
    {
        _workflow.Clear();
        _workflow.AddRange(
        [
            new("AI feature rollout review", "Account summaries and next best actions are enabled for pilot teams and require tenant admin approval.", "Features", "High", "Enable", "Diana Perez", "Today", "Feature rollout approval", "/tenant/ai/features"),
            new("Account summary source policy", "Summary generation must use policy, claims, billing, activity, and document context with freshness controls.", "Summaries", "Medium", "Enable", "Sarah Kim", "This week", "Source data governance", "/tenant/ai/summaries"),
            new("Renewal risk threshold tuning", "Commercial package renewal model is flagging too many medium-risk accounts for producer review.", "Risk", "High", "Tune", "James Park", "48h", "Risk threshold policy", "/tenant/ai/renewal-risk"),
            new("Next best action suppression", "Recommendation rules need suppression windows for recently contacted accounts.", "Actions", "Medium", "Tune", "Maria Santos", "5 days", "Recommendation governance", "/tenant/ai/nba"),
            new("Cross-sell eligibility review", "Umbrella and cyber cross-sell recommendations require updated appetite and exclusion rules.", "Cross-Sell", "Medium", "Tune", "Kevin Obi", "This week", "Eligibility policy", "/tenant/ai/cross-sell"),
            new("Prompt template approval", "Renewal summary prompt v4 is awaiting compliance approval before publishing.", "Prompts", "High", "Review", "Robert Yamamoto", "Today", "Prompt version approval", "/tenant/ai/prompts"),
            new("AI usage budget monitor", "Monthly AI usage is at 68% with projected overage risk if automation volume increases.", "Usage", "Medium", "Operate", "Lisa Chen", "Weekly", "Budget and usage controls", "/tenant/ai/usage"),
            new("Negative feedback analysis", "42 AI feedback items are pending review for low-confidence summaries and irrelevant recommendations.", "Feedback", "High", "Review", "Diana Perez", "72h", "Feedback review loop", "/tenant/ai/feedback"),
            new("AI governance evidence", "Quarterly audit packet needs feature, prompt, usage, and feedback evidence for tenant leadership.", "Usage", "Low", "Audit", "Robert Yamamoto", "Quarterly", "AI audit evidence", "/tenant/ai/usage")
        ]);
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _filter = string.Empty;
    }

    private void Advance(AiWorkflowItem item)
    {
        item.Stage = item.Stage switch
        {
            "Enable" => "Tune",
            "Tune" => "Operate",
            "Operate" => "Review",
            "Review" => "Audit",
            _ => "Audit"
        };
    }

    private int FilterCount(string key) => key switch
    {
        "risk" => _workflow.Count(x => x.Risk == "High"),
        "prompts" => _workflow.Count(x => x.Domain == "Prompts"),
        "usage" => _workflow.Count(x => x.Domain == "Usage"),
        "feedback" => _workflow.Count(x => x.Domain == "Feedback"),
        _ => _workflow.Count
    };

    private static string ToneCss(string domain) => domain switch
    {
        "Features" => "aiset-tone-blue",
        "Summaries" => "aiset-tone-cyan",
        "Risk" => "aiset-tone-red",
        "Actions" => "aiset-tone-amber",
        "Cross-Sell" => "aiset-tone-green",
        "Prompts" => "aiset-tone-violet",
        "Usage" => "aiset-tone-blue",
        "Feedback" => "aiset-tone-red",
        _ => "aiset-tone-neutral"
    };

    private static string RiskCss(string risk) => risk switch
    {
        "High" => "aiset-status-high",
        "Medium" => "aiset-status-medium",
        _ => "aiset-status-low"
    };

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="aiset-kpi-card">
        <span class="aiset-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span>
        <div>
            <strong>@value</strong>
            <span>@label</span>
            <small>@meta</small>
        </div>
    </article>;

    private sealed record Lane(string Key, string Label, string Description);
    private sealed record Filter(string Key, string Label);
    private sealed record AiModule(string Title, string Description, string Url, string Icon, string Domain)
    {
        public string Label => Title;
    }

    private sealed class AiWorkflowItem(string title, string summary, string domain, string risk, string stage, string owner, string sla, string control, string url)
    {
        public string Title { get; set; } = title;
        public string Summary { get; set; } = summary;
        public string Domain { get; set; } = domain;
        public string Risk { get; set; } = risk;
        public string Stage { get; set; } = stage;
        public string Owner { get; set; } = owner;
        public string Sla { get; set; } = sla;
        public string Control { get; set; } = control;
        public string Url { get; set; } = url;
    }
}
