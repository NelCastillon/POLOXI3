@page "/commissions/plan-versions"
@inject ApiClient Api

<PageTitle>Commission Plan Versions</PageTitle>

<h1>Commission Plan Versions</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(CommissionPlanVersionDto.PlanName)" HeaderText="Plan Name" Width="240"></GridColumn>
            <GridColumn Field="@nameof(CommissionPlanVersionDto.VersionNumber)" HeaderText="Version" Width="100"></GridColumn>
            <GridColumn Field="@nameof(CommissionPlanVersionDto.BaseRatePct)" HeaderText="Base Rate %" Format="N4" Width="130"></GridColumn>
            <GridColumn Field="@nameof(CommissionPlanVersionDto.EffectiveStartDate)" HeaderText="Effective Start" Type="ColumnType.Date" Format="d" Width="150"></GridColumn>
            <GridColumn Field="@nameof(CommissionPlanVersionDto.StatusCode)" HeaderText="Status" Width="120"></GridColumn>
            <GridColumn Field="@nameof(CommissionPlanVersionDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="g" Width="180"></GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<CommissionPlanVersionDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchCommissionPlanVersionsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<CommissionPlanVersionDto>();
    }
}
