@page "/finance/deferred-revenue"
@inject ApiClient Api

<PageTitle>Deferred Revenue</PageTitle>
<AppPageHeader Title="Deferred Revenue Schedules" Icon="bi-grid" />
<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.StartDate)"         HeaderText="Start"       Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.EndDate)"           HeaderText="End"         Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.TotalAmount)"       HeaderText="Total"       Format="C2" Width="120"></GridColumn>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.RecognizedAmount)"  HeaderText="Recognized"  Format="C2" Width="120"></GridColumn>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.RemainingAmount)"   HeaderText="Remaining"   Format="C2" Width="120"></GridColumn>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.FrequencyCode)"     HeaderText="Frequency"   Width="110"></GridColumn>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.StatusCode)"        HeaderText="Status"      Width="100"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<DeferredRevenueScheduleDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchDeferredRevenueSchedulesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
