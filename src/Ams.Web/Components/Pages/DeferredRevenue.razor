@page "/finance/deferred-revenue"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Deferred Revenue — AMS</PageTitle>

<AppPageHeader Title="Deferred Revenue Schedules"
               Subtitle="Tenant Admin revenue recognition schedules and balances"
               Icon="bi-hourglass-split">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/finance/glaccounts")'><i class="bi bi-journals" aria-hidden="true"></i> GL Accounts</button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Schedule</button>
    </Actions>
</AppPageHeader>

<div class="fin-kpi-strip">
    <div class="fin-kpi-card"><div class="fin-kpi-icon"><i class="bi bi-hourglass-split"></i></div><div><div class="fin-kpi-value">@_items.Count</div><div class="fin-kpi-label">Schedules</div></div></div>
    <div class="fin-kpi-card"><div class="fin-kpi-icon"><i class="bi bi-currency-dollar"></i></div><div><div class="fin-kpi-value">@Fmt(_items.Sum(x => x.TotalAmount))</div><div class="fin-kpi-label">Total</div></div></div>
    <div class="fin-kpi-card"><div class="fin-kpi-icon"><i class="bi bi-check-circle"></i></div><div><div class="fin-kpi-value">@Fmt(_items.Sum(x => x.RecognizedAmount))</div><div class="fin-kpi-label">Recognized</div></div></div>
    <div class="fin-kpi-card"><div class="fin-kpi-icon"><i class="bi bi-clock-history"></i></div><div><div class="fin-kpi-value">@Fmt(_items.Sum(x => x.RemainingAmount))</div><div class="fin-kpi-label">Remaining</div></div></div>
</div>

<div class="fin-toolbar">
    <div class="fin-search-box"><i class="bi bi-search fin-search-icon" aria-hidden="true"></i><input class="e-input fin-search-input" placeholder="Search frequency or status…" @bind="_searchTerm" @bind:event="oninput" @onkeyup="@(e => e.Key == "Enter" ? LoadAsync() : Task.CompletedTask)" /></div>
    <select class="um-input" @bind="_statusFilter"><option value="">All Statuses</option><option value="Active">Active</option><option value="Completed">Completed</option><option value="Paused">Paused</option></select>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-search" aria-hidden="true"></i> Search</button>
</div>

@if (!string.IsNullOrWhiteSpace(_error)) { <div class="fin-alert"><div class="fin-alert-icon"><i class="bi bi-exclamation-triangle-fill"></i></div><div><div class="fin-alert-title">Deferred revenue failed to load</div><div>@_error</div></div></div> }
else if (_loading) { <div class="fin-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading deferred revenue…</span></div> }
else {
<div class="fin-grid-container"><SfGrid TValue="DeferredRevenueScheduleDto" DataSource="FilteredItems" AllowPaging="true" AllowSorting="true" Height="600px">
    <GridEvents TValue="DeferredRevenueScheduleDto" RowSelected="OnRowSelected" />
    <GridPageSettings PageSize="15"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.StartDate)" HeaderText="Start" Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.EndDate)" HeaderText="End" Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.TotalAmount)" HeaderText="Total" Format="C2" Width="120"></GridColumn>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.RecognizedAmount)" HeaderText="Recognized" Format="C2" Width="120"></GridColumn>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.RemainingAmount)" HeaderText="Remaining" Format="C2" Width="120"></GridColumn>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.FrequencyCode)" HeaderText="Frequency" Width="110"></GridColumn>
        <GridColumn Field="@nameof(DeferredRevenueScheduleDto.StatusCode)" HeaderText="Status" Width="110"><Template>@{ var item = (DeferredRevenueScheduleDto)context; }<span class="fin-chip @StatusClass(item.StatusCode)">@item.StatusCode</span></Template></GridColumn>
        <GridColumn HeaderText="Actions" Width="90"><Template>@{ var item = (DeferredRevenueScheduleDto)context; }<button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button></Template></GridColumn>
    </GridColumns>
</SfGrid></div>
}

<SfDialog @bind-Visible="_showForm" Width="720px" IsModal="true" ShowCloseIcon="false"><DialogTemplates><Content>
    <div class="um-modal-header"><i class="bi bi-hourglass-split" aria-hidden="true"></i><span>@(_editingId == Guid.Empty ? "New Deferred Revenue Schedule" : "Edit Deferred Revenue Schedule")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
    <EditForm EditContext="_editContext"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid">
        <div class="um-field"><label>Account <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.AccountId" class="um-input"><option value="@Guid.Empty">Select account…</option>@foreach (var account in _accounts) { <option value="@account.AccountId">@account.AccountName</option> }</InputSelect><ValidationMessage For="() => _form.AccountId" class="text-danger" /></div>
        <div class="um-field"><label>Invoice</label><InputSelect @bind-Value="_form.InvoiceId" class="um-input"><option value="">None</option>@foreach (var invoice in _invoices) { <option value="@invoice.InvoiceId">@invoice.InvoiceNumber</option> }</InputSelect><ValidationMessage For="() => _form.InvoiceId" class="text-danger" /></div>
        <div class="um-field"><label>Total Amount <span class="text-danger">*</span></label><InputNumber @bind-Value="_form.TotalAmount" class="um-input" /><ValidationMessage For="() => _form.TotalAmount" class="text-danger" /></div>
        <div class="um-field"><label>Recognized</label><InputNumber @bind-Value="_form.RecognizedAmount" class="um-input" /><ValidationMessage For="() => _form.RecognizedAmount" class="text-danger" /></div>
        <div class="um-field"><label>Start Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.StartDate" class="um-input" /><ValidationMessage For="() => _form.StartDate" class="text-danger" /></div>
        <div class="um-field"><label>End Date</label><InputDate @bind-Value="_form.EndDate" class="um-input" /><ValidationMessage For="() => _form.EndDate" class="text-danger" /></div>
        <div class="um-field"><label>Frequency <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.FrequencyCode" class="um-input"><option value="Monthly">Monthly</option><option value="Quarterly">Quarterly</option><option value="Annual">Annual</option></InputSelect><ValidationMessage For="() => _form.FrequencyCode" class="text-danger" /></div>
        <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input"><option value="Active">Active</option><option value="Completed">Completed</option><option value="Paused">Paused</option></InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
        <div class="um-field"><label>Revenue GL</label><InputSelect @bind-Value="_form.GLAccountId" class="um-input"><option value="">None</option>@foreach (var account in _glAccounts) { <option value="@account.GLAccountId">@account.AccountCode - @account.AccountName</option> }</InputSelect><ValidationMessage For="() => _form.GLAccountId" class="text-danger" /></div>
        <div class="um-field"><label>Deferred GL</label><InputSelect @bind-Value="_form.DeferredGLAccountId" class="um-input"><option value="">None</option>@foreach (var account in _glAccounts) { <option value="@account.GLAccountId">@account.AccountCode - @account.AccountName</option> }</InputSelect><ValidationMessage For="() => _form.DeferredGLAccountId" class="text-danger" /></div>
        @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
    </div></div></EditForm>
    <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Schedule")</button></div>
</Content></DialogTemplates></SfDialog>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm, _error, _formError;
    private string _statusFilter = string.Empty;
    private bool _loading, _showForm, _saving;
    private List<DeferredRevenueScheduleDto> _items = [];
    private List<BillingAccountDto> _accounts = [];
    private List<InvoiceDto> _invoices = [];
    private List<GLAccountDto> _glAccounts = [];
    private Guid _editingId = Guid.Empty;
    private DeferredRevenueForm _form = new();
    private EditContext _editContext = default!;
    private IEnumerable<DeferredRevenueScheduleDto> FilteredItems => _items.Where(x => string.IsNullOrWhiteSpace(_statusFilter) || x.StatusCode == _statusFilter);
    protected override async Task OnInitializedAsync() { _editContext = new(_form); await LoadAsync(); }
    private async Task LoadAsync() { _loading = true; _error = null; try { var result = await Api.SearchDeferredRevenueSchedulesAsync(_tenantId, _searchTerm); var accounts = await Api.SearchBillingAccountsAsync(_tenantId); var invoices = await Api.SearchInvoicesAsync(_tenantId); var gl = await Api.SearchGLAccountsAsync(_tenantId, pageSize: 500); _items = result?.Items.ToList() ?? []; _accounts = accounts?.Items.ToList() ?? []; _invoices = invoices?.Items.ToList() ?? []; _glAccounts = gl?.Items.ToList() ?? []; } catch (Exception ex) { _error = ex.Message; _items = []; } finally { _loading = false; } }
    private void OnRowSelected(RowSelectEventArgs<DeferredRevenueScheduleDto> args) => OpenEdit(args.Data);
    private void OpenCreate() { _editingId = Guid.Empty; _form = new(); _editContext = new(_form); _formError = null; _showForm = true; }
    private void OpenEdit(DeferredRevenueScheduleDto item) { _editingId = item.DeferredRevenueScheduleId; _form = new DeferredRevenueForm { AccountId = item.AccountId, InvoiceId = item.InvoiceId, TotalAmount = item.TotalAmount, RecognizedAmount = item.RecognizedAmount, StartDate = item.StartDate.ToDateTime(TimeOnly.MinValue), EndDate = item.EndDate?.ToDateTime(TimeOnly.MinValue), FrequencyCode = item.FrequencyCode, StatusCode = item.StatusCode, GLAccountId = item.GLAccountId, DeferredGLAccountId = item.DeferredGLAccountId }; _editContext = new(_form); _formError = null; _showForm = true; }
    private void CloseForm() => _showForm = false;
    private async Task SaveAsync() { if (!_editContext.Validate()) return; if (_form.RecognizedAmount > _form.TotalAmount) { _formError = "Recognized Amount cannot exceed Total Amount."; return; } if (_form.EndDate.HasValue && _form.EndDate.Value < _form.StartDate) { _formError = "End Date must be on or after Start Date."; return; } _saving = true; try { if (_editingId == Guid.Empty) await Api.CreateDeferredRevenueScheduleAsync(new CreateDeferredRevenueScheduleRequest { TenantId = _tenantId, AccountId = _form.AccountId, InvoiceId = _form.InvoiceId, TotalAmount = _form.TotalAmount, RecognizedAmount = _form.RecognizedAmount, StartDate = DateOnly.FromDateTime(_form.StartDate), EndDate = _form.EndDate.HasValue ? DateOnly.FromDateTime(_form.EndDate.Value) : null, FrequencyCode = _form.FrequencyCode, StatusCode = _form.StatusCode, GLAccountId = _form.GLAccountId, DeferredGLAccountId = _form.DeferredGLAccountId }); else await Api.UpdateDeferredRevenueScheduleAsync(_editingId, new UpdateDeferredRevenueScheduleRequest { TenantId = _tenantId, DeferredRevenueScheduleId = _editingId, AccountId = _form.AccountId, InvoiceId = _form.InvoiceId, TotalAmount = _form.TotalAmount, RecognizedAmount = _form.RecognizedAmount, StartDate = DateOnly.FromDateTime(_form.StartDate), EndDate = _form.EndDate.HasValue ? DateOnly.FromDateTime(_form.EndDate.Value) : null, FrequencyCode = _form.FrequencyCode, StatusCode = _form.StatusCode, GLAccountId = _form.GLAccountId, DeferredGLAccountId = _form.DeferredGLAccountId }); _showForm = false; await LoadAsync(); } catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; } finally { _saving = false; } }
    private static string Fmt(decimal value) => value.ToString("C0");
    private static string StatusClass(string status) => status switch { "Active" => "fin-chip-success", "Completed" => "fin-chip-info", "Paused" => "fin-chip-warning", _ => "fin-chip-neutral" };
    private sealed class DeferredRevenueForm { [RequiredGuid(ErrorMessage = "Account is required.")] public Guid AccountId { get; set; } public Guid? InvoiceId { get; set; } [Range(0.01, 100000000)] public decimal TotalAmount { get; set; } [Range(0, 100000000)] public decimal RecognizedAmount { get; set; } [Required] public DateTime StartDate { get; set; } = DateTime.Today; public DateTime? EndDate { get; set; } [Required, StringLength(50)] public string FrequencyCode { get; set; } = "Monthly"; [Required, StringLength(50)] public string StatusCode { get; set; } = "Active"; public Guid? GLAccountId { get; set; } public Guid? DeferredGLAccountId { get; set; } }
}
