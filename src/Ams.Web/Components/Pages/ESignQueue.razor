@page "/documents/esign"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject ApiClient Api
@using Ams.Application.Features.Documents

<PageTitle>E-Signature Queue — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<!-- ── REQUEST E-SIGN DIALOG ──────────────────────────────────────── -->
<SfDialog @bind-Visible="_showRequest" Width="980px" ShowCloseIcon="false" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header">
                <i class="bi bi-pen" aria-hidden="true"></i>
                <span>Request E-Signature</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showRequest = false">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <div class="um-modal-body">
                <div class="um-form-grid">
                <div class="um-field"><label>Document</label>
                    <SfDropDownList TValue="string" TItem="string" DataSource="_docOptions" @bind-Value="_reqDoc" Placeholder="Select document…" Width="100%"></SfDropDownList>
                </div>
                <div class="um-field"><label>Signer Name</label>
                    <SfTextBox @bind-Value="_reqSigner" Placeholder="Full name…"></SfTextBox>
                </div>
                <div class="um-field"><label>Signer Email</label>
                    <SfTextBox @bind-Value="_reqEmail" Placeholder="email@example.com"></SfTextBox>
                </div>
                <div class="um-field"><label>Due Date</label>
                    <SfDatePicker TValue="DateTime" @bind-Value="_reqDue" Width="100%"></SfDatePicker>
                </div>
                <div class="um-field"><label>Priority</label>
                    <SfDropDownList TValue="string" TItem="string" DataSource='new[]{"Normal","High","Urgent"}' @bind-Value="_reqPriority" Width="100%"></SfDropDownList>
                </div>
                <div class="um-field um-field--full"><label>Message to Signer</label>
                    <SfTextBox @bind-Value="_reqMessage" Multiline="true" Placeholder="Optional message…"></SfTextBox>
                </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showRequest = false">Cancel</button>
                <button type="button" class="um-btn um-btn-primary" @onclick="SendRequestAsync">Send Request</button>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<!-- ── VOID DIALOG ─────────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showVoid" Width="620px" ShowCloseIcon="false" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header">
                <i class="bi bi-x-circle" aria-hidden="true"></i>
                <span>Void Request</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showVoid = false">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <div class="um-modal-body">
                <p class="eq-void-warn">Are you sure you want to void <strong>@_voidTarget?.Document</strong>? The signer will be notified.</p>
                <div class="um-form-grid">
                    <div class="um-field um-field--full"><label>Reason</label>
                        <SfTextBox @bind-Value="_voidReason" Multiline="true" Placeholder="Reason for voiding…"></SfTextBox>
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showVoid = false">Cancel</button>
                <button type="button" class="um-btn um-btn-danger" @onclick="ConfirmVoidAsync">Void Request</button>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

<AppPageHeader Title="E-Signature Queue"
               Subtitle="Track, send, and manage electronic signature requests across policies and ACORD forms"
               Icon="bi-pen">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/documents")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Documents
        </button>
        <button class="um-btn um-btn-primary" @onclick="() => _showRequest = true">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> Request Signature
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="eq-kpi-strip">
    <div class="eq-kpi"><i class="bi bi-send eq-ki blue" aria-hidden="true"></i><div><div class="eq-kv">@_items.Count</div><div class="eq-kl">Total Requests</div></div></div>
    <div class="eq-kpi"><i class="bi bi-hourglass-split eq-ki amber" aria-hidden="true"></i><div><div class="eq-kv">@_items.Count(x=>x.Status=="Sent")</div><div class="eq-kl">Awaiting Signature</div></div></div>
    <div class="eq-kpi"><i class="bi bi-eye eq-ki blue" aria-hidden="true"></i><div><div class="eq-kv">@_items.Count(x=>x.Status=="Viewed")</div><div class="eq-kl">Viewed</div></div></div>
    <div class="eq-kpi"><i class="bi bi-check-circle eq-ki green" aria-hidden="true"></i><div><div class="eq-kv">@_items.Count(x=>x.Status=="Signed")</div><div class="eq-kl">Signed</div></div></div>
    <div class="eq-kpi"><i class="bi bi-clock-history eq-ki red" aria-hidden="true"></i><div><div class="eq-kv">@_items.Count(x=>x.IsOverdue)</div><div class="eq-kl">Overdue</div></div></div>
    <div class="eq-kpi"><i class="bi bi-x-circle eq-ki gray" aria-hidden="true"></i><div><div class="eq-kv">@_items.Count(x=>x.Status=="Voided")</div><div class="eq-kl">Voided</div></div></div>
</div>

<!-- Toolbar -->
<div class="eq-toolbar">
    <SfTextBox Placeholder="Search by document, signer, policy…" @bind-Value="_search" Width="280px"></SfTextBox>
    <select class="e-input eq-sel" @bind="_filterStatus">
        <option value="">All Statuses</option>
        <option value="Sent">Sent</option>
        <option value="Viewed">Viewed</option>
        <option value="Signed">Signed</option>
        <option value="Declined">Declined</option>
        <option value="Voided">Voided</option>
        <option value="Expired">Expired</option>
    </select>
    <select class="e-input eq-sel" @bind="_filterPriority">
        <option value="">All Priorities</option>
        <option value="Urgent">Urgent</option>
        <option value="High">High</option>
        <option value="Normal">Normal</option>
    </select>
    <div style="margin-left:auto;display:flex;gap:.35rem;">
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="RemindAll" title="Remind all pending">
            <i class="bi bi-bell" aria-hidden="true"></i> Remind All
        </button>
    </div>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

<!-- Queue grid -->
<div class="eq-grid-wrap">
    <SfGrid DataSource="FilteredItems" AllowSorting="true" AllowPaging="true" Height="520px">
        <GridPageSettings PageSize="12"></GridPageSettings>
        <GridColumns>
            <GridColumn HeaderText="Document" Width="230">
                <Template>
                    @{ var r = (ESignRow)context; }
                    <div class="eq-doc-cell">
                        <i class="bi bi-file-earmark-text eq-doc-icon" aria-hidden="true"></i>
                        <div>
                            <div class="eq-doc-name">@r.Document</div>
                            <div class="eq-doc-sub">@r.PolicyNumber</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Signer" Width="180">
                <Template>
                    @{ var r2 = (ESignRow)context; }
                    <div class="eq-signer-cell">
                        <div class="eq-signer-name">@r2.SignerName</div>
                        <div class="eq-signer-email">@r2.SignerEmail</div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Priority" Width="90">
                <Template>
                    @{ var r3 = (ESignRow)context; }
                    <span class="eq-pri-chip eq-pri-@r3.Priority.ToLower()">@r3.Priority</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Status" Width="120">
                <Template>
                    @{ var r4 = (ESignRow)context; }
                    <div>
                        <span class="eq-status-chip eq-st-@r4.Status.ToLower()">@r4.Status</span>
                        @if (r4.IsOverdue) { <span class="eq-overdue-badge">OVERDUE</span> }
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(ESignRow.SentDate)" HeaderText="Sent" Type="ColumnType.DateTime" Format="g" Width="140"></GridColumn>
            <GridColumn Field="@nameof(ESignRow.DueDate)" HeaderText="Due" Type="ColumnType.DateTime" Format="d" Width="100"></GridColumn>
            <GridColumn Field="@nameof(ESignRow.CompletedDate)" HeaderText="Completed" Type="ColumnType.DateTime" Format="g" Width="140"></GridColumn>
            <GridColumn HeaderText="Actions" Width="130">
                <Template>
                    @{ var r5 = (ESignRow)context; }
                    <div style="display:flex;gap:.2rem">
                        @if (r5.Status is "Sent" or "Viewed")
                        {
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => Remind(r5)" title="Send reminder">
                                <i class="bi bi-bell" aria-hidden="true"></i>
                            </button>
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenVoid(r5)" title="Void">
                                <i class="bi bi-x-circle" aria-hidden="true"></i>
                            </button>
                        }
                        @if (r5.Status == "Signed")
                        {
                            <button class="um-btn um-btn-ghost um-btn-xs" title="Download signed document">
                                <i class="bi bi-download" aria-hidden="true"></i>
                            </button>
                        }
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => Nav.NavigateTo($"/documents/{r5.ESignRequestId}")'
                                title="View document">
                            <i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>
                        </button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private SfToast _toast = default!;
    private string _search = "", _filterStatus = "", _filterPriority = "";
    private bool _showRequest, _showVoid;
    private string? _loadError;
    private string? _reqDoc, _reqSigner, _reqEmail, _reqPriority = "Normal", _reqMessage;
    private DateTime _reqDue = DateTime.Today.AddDays(5);
    private ESignRow? _voidTarget;
    private string? _voidReason;

    private Guid _tenantId;

    private readonly List<string> _docOptions = [
        "ACORD 25 — Certificate of Liability",
        "ACORD 126 — Commercial GL Section",
        "Policy Endorsement — POL-2025-00142",
        "Renewal Agreement — POL-2024-99310",
        "Cancellation Notice — POL-2024-88204"
    ];

    private List<ESignRow> _items = [];

    private List<ESignRow> Items => _items.Select(r =>
        r.IsOverdue == false && r.DueDate < DateTime.Today && r.Status is "Sent" or "Viewed"
            ? r with { IsOverdue = true }
            : r).ToList();

    private IEnumerable<ESignRow> FilteredItems => Items.Where(r =>
        (string.IsNullOrEmpty(_search) || r.Document.Contains(_search, StringComparison.OrdinalIgnoreCase) || r.SignerName.Contains(_search, StringComparison.OrdinalIgnoreCase) || (r.PolicyNumber?.Contains(_search) ?? false)) &&
        (string.IsNullOrEmpty(_filterStatus)   || r.Status   == _filterStatus) &&
        (string.IsNullOrEmpty(_filterPriority) || r.Priority == _filterPriority));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Documents","/documents"), new("E-Sign Queue",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            var dtos = await Api.GetESignRequestsAsync(_tenantId);
            _items = (dtos ?? []).Select(d => new ESignRow(
                d.ESignRequestId, d.Document, d.PolicyNumber,
                d.SignerName, d.SignerEmail, d.Priority, d.Status,
                d.IsOverdue, d.SentDate, d.DueDate, d.CompletedDate)).ToList();
        }
        catch (Exception ex)
        {
            _items = [];
            _loadError = $"Failed to load e-signature requests: {ex.Message}";
        }
    }

    async Task SendRequestAsync()
    {
        try
        {
            var docId = Guid.NewGuid(); // placeholder until doc selector is wired to real DocumentId
            await Api.SendESignRequestAsync(new SendESignRequest(
                _tenantId, docId,
                _reqSigner ?? string.Empty,
                _reqEmail ?? string.Empty,
                _reqDue,
                _reqPriority ?? "Normal",
                _reqMessage));
            _showRequest = false;
            _reqDoc = _reqSigner = _reqEmail = _reqMessage = null; _reqPriority = "Normal";
            await LoadAsync();
            await _toast.ShowAsync(new ToastModel { Content = "Signature request sent.", CssClass = "e-toast-success" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Content = $"Send failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    void OpenVoid(ESignRow r) { _voidTarget = r; _voidReason = null; _showVoid = true; }

    async Task ConfirmVoidAsync()
    {
        if (_voidTarget is null) return;
        try
        {
            await Api.VoidESignRequestAsync(_voidTarget.ESignRequestId, _voidReason);
            _showVoid = false;
            await LoadAsync();
            await _toast.ShowAsync(new ToastModel { Content = "Request voided.", CssClass = "e-toast-warning" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Content = $"Void failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    async Task Remind(ESignRow r)
    {
        try
        {
            await Api.RemindESignRequestAsync(r.ESignRequestId);
            await _toast.ShowAsync(new ToastModel { Content = $"Reminder sent to {r.SignerName}.", CssClass = "e-toast-success" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Content = $"Reminder failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    async Task RemindAll()
    {
        var pending = Items.Where(r => r.Status is "Sent" or "Viewed").ToList();
        try
        {
            foreach (var r in pending)
                await Api.RemindESignRequestAsync(r.ESignRequestId);
            await _toast.ShowAsync(new ToastModel { Content = $"Reminders sent to {pending.Count} pending signers.", CssClass = "e-toast-success" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Content = $"Reminder failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    record ESignRow(Guid ESignRequestId, string Document, string? PolicyNumber, string SignerName, string SignerEmail,
                    string Priority, string Status, bool IsOverdue, DateTime SentDate, DateTime DueDate, DateTime? CompletedDate);

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
