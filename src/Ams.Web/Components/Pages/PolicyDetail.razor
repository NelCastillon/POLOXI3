@page "/policies/{PolicyId:guid}"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Ams.Application.Features.PolicyCoverages
@using Ams.Application.Features.PolicyEndorsements
@using Ams.Application.Features.PolicyLifecycle
@using Ams.Application.Features.Claims
@using Ams.Application.Features.PolicyCertificates
@using Ams.Application.Features.RenewalRetention
@using Microsoft.AspNetCore.Components.Forms
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject BreadcrumbService Breadcrumbs

<PageTitle>@(_policy is null ? "Policy" : _policy.PolicyNumber) ? Policy Detail</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<EnterpriseDocumentUpload @bind-IsOpen="_showDocumentUpload"
                          TenantId="_tenantId"
                          CreatedByUserId="_currentUserId"
                          EntityName="Policy"
                          EntityId="PolicyId"
                          Title="Upload Policy Document"
                          IntroText="Upload and classify declarations, certificates, endorsements, binders, and other supporting policy documents."
                          DefaultDocumentTypeCode="POLICY"
                          DefaultCategoryCode="POLICY"
                          DefaultTags="Policy"
                          OnUploaded="HandlePolicyDocumentUploadedAsync"
                          OnUploadFailed="HandlePolicyDocumentUploadFailed" />

@if (_loading)
{
    <div class="pd-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading policy?</span></div>
}
else if (_policy is null)
{
    <div class="pd-not-found">
        <i class="bi bi-shield-x pd-nf-icon" aria-hidden="true"></i>
        <h2>Policy not found</h2>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/policies")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Policies
        </button>
    </div>
}
else
{
    <div class="pd-enterprise-page">
    <!-- -- HEADER --------------------------------------------------------- -->
    <div class="page-header">
        <div class="aph-left">
            <div class="aph-icon pd-lob-@LobKey(_policy.Lob)">
                <i class="bi @LobIcon(_policy.Lob)" aria-hidden="true"></i>
            </div>
            <div>
                <div class="aph-title-row">
                    <h1 class="page-title">@_policy.PolicyNumber</h1>
                    <span class="badge badge-green pd-status-@_policy.Status.ToLower()">@_policy.Status</span>
                    <span class="badge badge-blue pd-lob-@LobKey(_policy.Lob)">@_policy.Lob</span>
                </div>
                <div class="page-subtitle pd-global-header-meta">
                    <button class="badge badge-neutral" @onclick='() => Nav.NavigateTo($"/accounts/{_policy.AccountId}")'>
                        <i class="bi bi-building" aria-hidden="true"></i>@_policy.Account
                    </button>
                    <span class="badge badge-neutral"><i class="bi bi-building-fill" aria-hidden="true"></i>@_policy.Carrier</span>
                    <span class="badge badge-neutral"><i class="bi bi-calendar" aria-hidden="true"></i>@_policy.EffDate.ToString("MM/dd/yyyy") ? @_policy.ExpDate.ToString("MM/dd/yyyy")</span>
                    <span class="badge badge-neutral @ExpChipCss(_policy.ExpDate)">
                        <i class="bi bi-clock" aria-hidden="true"></i>
                        @DaysLabel(_policy.ExpDate)
                    </span>
                </div>
            </div>
        </div>
        <div class="page-actions">
            <button class="um-btn um-btn-ghost um-btn-sm pd-back-btn" title="Back to policies" aria-label="Back to policies" @onclick='() => Nav.NavigateTo("/policies")'>
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("endorse")'>
                <i class="bi bi-pen" aria-hidden="true"></i> Endorse
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("remarket")'>
                <i class="bi bi-arrow-left-right" aria-hidden="true"></i> Remarket
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("rewrite")'>
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Rewrite
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("certificate")'>
                <i class="bi bi-award" aria-hidden="true"></i> Issue Cert
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("esign")'>
                <i class="bi bi-pen-fill" aria-hidden="true"></i> E-Sign
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("message")'>
                <i class="bi bi-chat" aria-hidden="true"></i> Message
            </button>
            @if (_policy.Status == "Cancelled")
            {
                <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => OpenAction("reinstate")'>
                    <i class="bi bi-shield-check" aria-hidden="true"></i> Reinstate
                </button>
            }
            else
            {
                <button class="um-btn um-btn-danger um-btn-sm" @onclick='() => OpenAction("cancel")'>
                    <i class="bi bi-x-circle" aria-hidden="true"></i> Cancel
                </button>
            }
        </div>
    </div>

    <div class="pd-command-strip" aria-label="Policy executive summary">
        <div class="pd-command-card @PolicyHealthCss()">
            <span class="pd-command-icon"><i class="bi bi-activity" aria-hidden="true"></i></span>
            <div>
                <span>Policy Health</span>
                <strong>@PolicyHealthLabel()</strong>
                <small>@PolicyHealthSummary()</small>
            </div>
        </div>
        <div class="pd-command-card">
            <span class="pd-command-icon"><i class="bi bi-calendar2-week" aria-hidden="true"></i></span>
            <div>
                <span>Term Window</span>
                <strong>@_policy.EffDate.ToString("MMM d") ? @_policy.ExpDate.ToString("MMM d, yyyy")</strong>
                <small>@DaysLabel(_policy.ExpDate)</small>
            </div>
        </div>
        <div class="pd-command-card @(_policy.BalanceDue > 0 ? "pd-command-card--attention" : "pd-command-card--success")">
            <span class="pd-command-icon"><i class="bi bi-wallet2" aria-hidden="true"></i></span>
            <div>
                <span>Receivable</span>
                <strong>@_policy.BalanceDue.ToString("C0")</strong>
                <small>@(_policy.BalanceDue > 0 ? "Balance due requires follow-up" : "Account is current")</small>
            </div>
        </div>
        <div class="pd-command-card">
            <span class="pd-command-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
            <div>
                <span>Latest Activity</span>
                <strong>@(_activities.FirstOrDefault()?.Subject ?? "No activity")</strong>
                <small>@(_activities.FirstOrDefault()?.ActivityDate.ToString("MMM d, h:mm tt") ?? "Add an activity to start tracking")</small>
            </div>
        </div>
    </div>

    @if (_accounting is not null)
    {
        <section class="pd-cockpit" aria-label="Policy financial status">
            <div class="pd-cockpit-head">
                <span><i class="bi bi-bank" aria-hidden="true"></i> Policy accounting</span>
                <strong>@_accounting.StatusCode</strong>
            </div>
            <div class="pd-cockpit-grid">
                @CockpitCard("Invoice", _accounting.InvoiceAmount.ToString("C0"), _accounting.BillingTypeCode, "bi-receipt", "info")
                @CockpitCard("Outstanding balance", _accounting.OutstandingBalance.ToString("C0"), _accounting.OutstandingBalance > 0 ? "Customer receivable open" : "Account current", "bi-wallet2", _accounting.OutstandingBalance > 0 ? "attention" : "success")
                @CockpitCard("Commission", _accounting.CommissionAmount.ToString("C0"), $"{_accounting.CommissionRatePct:N2}% expected", "bi-percent", "success")
                @CockpitCard("Carrier payable", _accounting.CarrierPayableAmount.ToString("C0"), _accounting.BillingTypeCode == "AgencyBill" ? "Pending remittance" : "Carrier bills insured", "bi-building", "neutral")
                @CockpitCard("Installments", _accounting.InstallmentCount.ToString(), _accounting.InstallmentCount > 0 ? "Scheduled from billing plan" : "Not agency billed", "bi-calendar3", "info")
                @CockpitCard("Fees and taxes", (_accounting.FeeAmount + _accounting.TaxAmount).ToString("C0"), $"Fees {_accounting.FeeAmount:C0} / Taxes {_accounting.TaxAmount:C0}", "bi-calculator", "neutral")
            </div>
            <div class="pd-cockpit-actions" aria-label="Policy accounting actions">
                <span>Accounting actions</span>
                <button type="button" @onclick='() => Nav.NavigateTo("/billing/payments")'><i class="bi bi-cash-coin" aria-hidden="true"></i><strong>Receive payment</strong><small>Record and apply insured funds.</small></button>
                <button type="button" @onclick='() => Nav.NavigateTo("/billing/invoices")'><i class="bi bi-receipt" aria-hidden="true"></i><strong>View invoice</strong><small>Review invoice and line detail.</small></button>
                <button type="button" @onclick="PrintInvoiceAsync" disabled="@(!_accounting.Invoices.Any())"><i class="bi bi-printer" aria-hidden="true"></i><strong>Print invoice</strong><small>Print the persisted invoice view.</small></button>
                <button type="button" @onclick="OpenInvoiceEmail" disabled="@(!_accounting.Invoices.Any())"><i class="bi bi-envelope" aria-hidden="true"></i><strong>Email invoice</strong><small>@InvoiceDeliveryActionText</small></button>
                <button type="button" @onclick='() => Nav.NavigateTo("/billing")'><i class="bi bi-calendar3" aria-hidden="true"></i><strong>Payment schedule</strong><small>Review installments and trust activity.</small></button>
                <button type="button" @onclick='() => Nav.NavigateTo("/workbench/accounting")'><i class="bi bi-clipboard-data" aria-hidden="true"></i><strong>View accounting</strong><small>Open the accounting work queue.</small></button>
                <button type="button" @onclick='() => Nav.NavigateTo("/finance/journalentries")'><i class="bi bi-journal-text" aria-hidden="true"></i><strong>View ledger</strong><small>Open posted general ledger entries.</small></button>
            </div>
        </section>
    }

    @if (_showInvoiceEmail)
    {
        <div class="mt-modal-backdrop" role="presentation" @onclick="CloseInvoiceEmail">
            <div class="mt-modal pd-form-modal" role="dialog" aria-modal="true" aria-labelledby="invoice-email-title" @onclick:stopPropagation="true">
                <div class="um-modal-header"><i class="bi bi-envelope" aria-hidden="true"></i><span id="invoice-email-title">Email policy invoice</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseInvoiceEmail"><i class="bi bi-x-lg"></i></button></div>
                <div class="um-modal-body">
                    <div class="pd-modal-intro"><span class="pd-modal-chip"><i class="bi bi-send"></i> Proposal delivery system</span><p>The invoice will use the tenant email provider, retry policy, and delivery audit queue.</p></div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full"><label>Invoice</label><select class="form-select" @bind="_invoiceEmailInvoiceId">@foreach (var invoice in _accounting!.Invoices) { <option value="@invoice.InvoiceId">@invoice.InvoiceNumber — @invoice.BalanceAmount.ToString("C2")</option> }</select></div>
                        <div class="um-field um-field--full"><label>Recipient email <span class="text-danger">*</span></label><input class="form-control" type="email" @bind="_invoiceEmailRecipient" /></div>
                    </div>
                </div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseInvoiceEmail">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="EmailInvoiceAsync" disabled="@_emailingInvoice"><i class="bi bi-send"></i> @(_emailingInvoice ? "Queueing…" : "Queue email")</button></div>
            </div>
        </div>
    }

    @if (_loadError is not null)
    {
        <div class="alert alert-danger pd-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError
        </div>
    }

    <section class="pd-cockpit" aria-label="Policy cockpit">
        <div class="pd-cockpit-primary">
            <div class="pd-cockpit-head">
                <span><i class="bi bi-speedometer2" aria-hidden="true"></i> Policy cockpit</span>
                <strong>@PolicyHealthLabel()</strong>
            </div>
            <p>@PolicyHealthSummary()</p>
            <div class="pd-cockpit-term">
                <div>
                    <span>Term progress</span>
                    <strong>@TermProgressPercent%</strong>
                </div>
                <div class="pd-cockpit-track" aria-hidden="true"><i style="width:@TermProgressPercent%"></i></div>
                <small>@_policy.EffDate.ToString("MMM d, yyyy") - @_policy.ExpDate.ToString("MMM d, yyyy")</small>
            </div>
        </div>
        <div class="pd-cockpit-grid">
            @CockpitCard("Premium posture", _policy.WrittenPremium.ToString("C0"), $"Annual {_policy.AnnualPremium:C0} / Balance {_policy.BalanceDue:C0}", "bi-cash-coin", _policy.BalanceDue > 0 ? "attention" : "success")
            @CockpitCard("Coverage operations", _coverages.Count.ToString(), $"{_endorsements.Count} endorsement(s), {_documents.Count} document(s)", "bi-shield-check", "info")
            @CockpitCard("Claims exposure", _policy.OpenClaims.ToString(), _policy.OpenClaims > 0 ? "Open claim monitoring required" : "No active claim exceptions", "bi-exclamation-diamond", _policy.OpenClaims > 0 ? "attention" : "success")
            @CockpitCard("Service owner", _policy.Producer, $"CSR: {_policy.Csr} / Branch: {_policy.Branch}", "bi-person-workspace", "neutral")
        </div>
        <div class="pd-cockpit-actions" aria-label="Recommended actions">
            <span>Recommended next actions</span>
            @foreach (var action in RecommendedActions)
            {
                <button type="button" @onclick='() => OpenAction(action.ActionKey)'>
                    <i class="bi @action.Icon" aria-hidden="true"></i>
                    <strong>@action.Title</strong>
                    <small>@action.Description</small>
                </button>
            }
        </div>
    </section>

    <section class="pd-workspace-panel" aria-label="Policy workspace">
        <!-- -- 13-TAB BODY ---------------------------------------------------- -->
        <div class="pd-native-tabs" role="tablist" aria-label="Policy detail sections">
            @for (var i = 0; i < _detailTabs.Length; i++)
            {
                var tab = _detailTabs[i];
                <button type="button" class="pd-native-tab @(_tab == i ? "pd-native-tab--active" : null)" role="tab" aria-selected="@(_tab == i)" @onclick="() => _tab = tab.Index">
                    <i class="bi @tab.Icon" aria-hidden="true"></i>
                    <span>@tab.Label</span>
                </button>
            }
        </div>
    </section>
    @switch (_tab)
    {
        case 0:
            <!-- 0 -- SUMMARY ----------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-summary-grid">

                            <div class="pd-info-card">
                                <h3 class="pd-card-hdr">Policy Identity</h3>
                                <div class="pd-field-grid">
                                    @F("Policy Number",   _policy.PolicyNumber)
                                    @F("Line of Business",_policy.Lob)
                                    @F("Carrier",         _policy.Carrier)
                                    @F("Program",         _policy.Program)
                                    @F("Status",          _policy.Status)
                                    @F("Policy Type",     _policy.PolicyType)
                                    @F("Package",         _policy.IsPackage ? "Yes" : "No")
                                    @F("Master Policy",   _policy.MasterPolicy ?? "?")
                                </div>
                            </div>

                            <div class="pd-info-card">
                                <h3 class="pd-card-hdr">Dates &amp; Term</h3>
                                <div class="pd-field-grid">
                                    @F("Effective Date",   _policy.EffDate.ToString("MM/dd/yyyy"))
                                    @F("Expiration Date",  _policy.ExpDate.ToString("MM/dd/yyyy"))
                                    @F("Issue Date",       _policy.IssueDate?.ToString("MM/dd/yyyy") ?? "?")
                                    @F("Bind Date",        _policy.BindDate?.ToString("MM/dd/yyyy") ?? "?")
                                    @F("Cancel Date",      _policy.CancelDate?.ToString("MM/dd/yyyy") ?? "?")
                                    @F("Reinstate Date",   _policy.ReinstateDate?.ToString("MM/dd/yyyy") ?? "?")
                                    @F("Days to Expiry",   DaysLabel(_policy.ExpDate))
                                    @F("Term (months)",    _policy.TermMonths.ToString())
                                </div>
                            </div>

                            <div class="pd-info-card">
                                <h3 class="pd-card-hdr">Premium &amp; Billing</h3>
                                <div class="pd-field-grid">
                                    @F("Written Premium",  _policy.WrittenPremium.ToString("C2"))
                                    @F("Annual Premium",   _policy.AnnualPremium.ToString("C2"))
                                    @F("Agency Fee",       _policy.AgencyFee.ToString("C2"))
                                    @F("Taxes &amp; Fees", _policy.TaxesFees.ToString("C2"))
                                    @F("Total Cost",       (_policy.WrittenPremium + _policy.AgencyFee + _policy.TaxesFees).ToString("C2"))
                                    @F("Balance Due",      _policy.BalanceDue.ToString("C2"))
                                    @F("Billing Plan",     _policy.BillingPlan)
                                    @F("Payment Method",   _policy.PaymentMethod)
                                </div>
                            </div>

                            <div class="pd-info-card">
                                <h3 class="pd-card-hdr">Named Insured</h3>
                                <div class="pd-field-grid">
                                    @F("Primary Insured",  _policy.PrimaryInsured)
                                    @F("Insured Type",     _policy.InsuredType)
                                    @F("Address",          _policy.InsuredAddress)
                                    @F("City / State",     $"{_policy.InsuredCity}, {_policy.InsuredState} {_policy.InsuredZip}")
                                    @F("FEIN / SSN",       _policy.InsuredTaxId ?? "?")
                                    @F("DBA",              _policy.InsuredDba ?? "?")
                                    @F("Entity Type",      _policy.EntityType ?? "?")
                                    @F("SIC Code",         _policy.SicCode ?? "?")
                                </div>
                            </div>

                            <div class="pd-info-card">
                                <h3 class="pd-card-hdr">Service Assignment</h3>
                                <div class="pd-field-grid">
                                    @F("Producer",         _policy.Producer)
                                    @F("CSR",              _policy.Csr)
                                    @F("Branch",           _policy.Branch)
                                    @F("Account Manager",  _policy.AccountManager ?? "?")
                                    @F("Underwriter",      _policy.Underwriter ?? "?")
                                    @F("UW Contact Email", _policy.UwEmail ?? "?")
                                    @F("UW Phone",         _policy.UwPhone ?? "?")
                                </div>
                            </div>

                            <div class="pd-info-card">
                                <h3 class="pd-card-hdr">Submission &amp; Source</h3>
                                <div class="pd-field-grid">
                                    @F("Source",           _policy.Source)
                                    @F("Sub Ref #",        _policy.SubmissionRef ?? "?")
                                    @F("Prior Carrier",    _policy.PriorCarrier ?? "?")
                                    @F("Prior Premium",    _policy.PriorPremium?.ToString("C0") ?? "?")
                                    @F("Quote #",          _policy.QuoteNumber ?? "?")
                                    @F("ACORD Form",       _policy.AcordForm ?? "?")
                                    @F("Created By",       _policy.CreatedBy)
                                    @F("Created",          _policy.CreatedAt.ToString("MM/dd/yyyy"))
                                </div>
                            </div>
                        </div>
                    </div>
            break;
        case 1:
            <!-- 1 -- COVERAGES --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_coverages.Count coverage(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenCoverageForm">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Coverage
                            </button>
                        </div>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--coverage">
                                    <span>Code</span><span>Coverage</span><span>Category</span><span>Limit</span><span>Premium</span><span>Included</span><span>Actions</span>
                            </div>
                            @foreach (var c in _coverages)
                            {
                                <button type="button" class="pd-list-row pd-list-row--coverage" @ondblclick="() => OpenCoverageDetails(c)">
                                    <span class="pd-mono">@c.CovCode</span>
                                    <span><strong>@c.CovName</strong><small>@(c.Notes ?? "Coverage schedule")</small></span>
                                    <span class="pd-cov-type">@EmptyDash(c.CoverageCategoryCode)</span>
                                    <span class="pd-mono">@(c.Limit.HasValue ? c.Limit.Value.ToString("C0") : "Occurrence")</span>
                                    <span class="pd-mono">@c.Premium.ToString("C2")</span>
                                    <span><i class="bi @(c.IsIncluded ? "bi-check-circle-fill pd-chk-yes" : "bi-dash-circle pd-chk-no")" aria-hidden="true"></i></span>
                                    <span class="pd-open-cell pd-row-actions">@CoverageOpenLink(c) @CoverageComparisonLink(c)</span>
                                </button>
                            }
                        </div>
                    </div>
            break;
        case 2:
            <!-- 2 -- RISK ITEMS --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_riskItems.Count item(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenRiskForm">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Item
                            </button>
                        </div>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--risk">
                                <span>Type</span><span>Description</span><span>Make / VIN</span><span>Value</span><span>Location</span><span>Active</span><span></span>
                            </div>
                            @foreach (var r in _riskItems)
                            {
                                <button type="button" class="pd-list-row pd-list-row--risk" @ondblclick="() => OpenDetails(r)">
                                    <span class="pd-risk-type">@r.ItemType</span>
                                    <span><strong>@r.Description</strong><small>@(r.Year?.ToString() ?? "Unscheduled year")</small></span>
                                    <span><strong>@(r.Make ?? "?")</strong><small>@(r.Vin ?? "?")</small></span>
                                    <span class="pd-mono">@(r.Value.HasValue ? r.Value.Value.ToString("C0") : "?")</span>
                                    <span>@(r.Location ?? "?")</span>
                                    <span><i class="bi @(r.IsActive ? "bi-check-circle-fill pd-chk-yes" : "bi-x-circle pd-chk-no")" aria-hidden="true"></i></span>
                                    <span class="pd-open-cell">@OpenDetailsLink(r)</span>
                                </button>
                            }
                        </div>
                    </div>
            break;
        case 3:
            <!-- 3 -- DRIVERS / LOCATIONS --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-dl-tabs">
                            <button class="pd-dl-tab @(_dlTab=="drivers"?"pd-dl-tab--active":"")" @onclick='()=>_dlTab="drivers"'>
                                <i class="bi bi-person-badge" aria-hidden="true"></i> Drivers (@_drivers.Count)
                            </button>
                            <button class="pd-dl-tab @(_dlTab=="locations"?"pd-dl-tab--active":"")" @onclick='()=>_dlTab="locations"'>
                                <i class="bi bi-pin-map" aria-hidden="true"></i> Locations (@_locations.Count)
                            </button>
                        </div>

                        @if (_dlTab == "drivers")
                        {
                            <div class="pd-enterprise-list">
                                <div class="pd-list-head pd-list-head--drivers">
                                    <span>Driver</span><span>License</span><span>DOB</span><span>Experience</span><span>Type</span><span>Eligible</span><span></span>
                                </div>
                                @foreach (var d in _drivers)
                                {
                                    <button type="button" class="pd-list-row pd-list-row--drivers" @ondblclick="() => OpenDetails(d)">
                                        <span><strong>@d.Name</strong><small>@d.State driver</small></span>
                                        <span class="pd-mono">@d.LicenseNum</span>
                                        <span class="pd-mono">@d.Dob.ToString("MM/dd/yyyy")</span>
                                        <span><strong>@d.YearsExp yrs</strong><small class="@(d.Violations > 0 ? "pd-viol-warn" : null)">@d.Violations violation(s)</small></span>
                                        <span>@d.Type</span>
                                        <span><i class="bi @(d.IsExcluded ? "bi-x-circle pd-chk-no" : "bi-check-circle-fill pd-chk-yes")" aria-hidden="true"></i></span>
                                        <span class="pd-open-cell">@OpenDetailsLink(d)</span>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="pd-enterprise-list">
                                <div class="pd-list-head pd-list-head--locations">
                                    <span>Location</span><span>Address</span><span>City / State</span><span>Building</span><span>Contents</span><span>Primary</span><span></span>
                                </div>
                                @foreach (var l in _locations)
                                {
                                    <button type="button" class="pd-list-row pd-list-row--locations" @ondblclick="() => OpenDetails(l)">
                                        <span><strong>@l.Description</strong><small>Location @l.LocNumber</small></span>
                                        <span>@l.Address</span>
                                        <span>@l.City, @l.State @l.Zip</span>
                                        <span class="pd-mono">@(l.Building.HasValue ? l.Building.Value.ToString("C0") : "?")</span>
                                        <span class="pd-mono">@(l.Contents.HasValue ? l.Contents.Value.ToString("C0") : "?")</span>
                                        <span><i class="bi @(l.IsPrimary ? "bi-star-fill pd-star" : "bi-star")" aria-hidden="true"></i></span>
                                        <span class="pd-open-cell">@OpenDetailsLink(l)</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
            break;
        case 4:
            <!-- 4 -- DOCUMENTS --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_documents.Count document(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenDocumentUpload">
                                <i class="bi bi-upload" aria-hidden="true"></i> Upload
                            </button>
                        </div>
                        <div class="pd-doc-grid">
                            @foreach (var doc in _documents)
                            {
                                <div class="pd-doc-card" @ondblclick="() => OpenDetails(doc)">
                                    <div class="pd-doc-icon pd-doc-@doc.FileType.ToLower()">
                                        <i class="bi @DocIcon(doc.FileType)" aria-hidden="true"></i>
                                    </div>
                                    <div class="pd-doc-info">
                                        <div class="pd-doc-name">@doc.Name</div>
                                        <div class="pd-doc-meta">@doc.Category ? @doc.UploadedAt.ToString("MM/dd/yyyy") ? @doc.FileSize</div>
                                        <div class="pd-doc-uploader">@doc.UploadedBy</div>
                                    </div>
                                    <div class="pd-doc-actions">
                                        @OpenDetailsLink(doc)
                                        @if (doc.HasStoredContent)
                                        {
                                            <button class="um-btn um-btn-ghost um-btn-sm" title="Download" @onclick="() => DownloadDocumentAsync(doc)"><i class="bi bi-download" aria-hidden="true"></i></button>
                                            <button class="um-btn um-btn-ghost um-btn-sm" title="Preview" @onclick="() => PreviewDocumentAsync(doc)"><i class="bi bi-eye" aria-hidden="true"></i></button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
            break;
        case 5:
            <!-- 5 -- ACTIVITIES --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_activities.Count activity(ies)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => { _actForm = new(); _showActForm = true; }">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Log Activity
                            </button>
                        </div>
                        <div class="pd-timeline">
                            @foreach (var a in _activities.OrderByDescending(a => a.ActivityDate))
                            {
                                <div class="pd-tl-item" @ondblclick="() => OpenDetails(a)">
                                    <div class="pd-tl-dot pd-tl-@a.Category.ToLower()">
                                        <i class="bi @ActivityIcon(a.Category)" aria-hidden="true"></i>
                                    </div>
                                    <div class="pd-tl-line"></div>
                                    <div class="pd-tl-body">
                                        <div class="pd-tl-header">
                                            <span class="pd-tl-title">@a.Subject</span>
                                            <span class="pd-tl-cat pd-cat-@a.Category.ToLower()">@a.Category</span>
                                             @OpenDetailsLink(a)
                                            <span class="pd-tl-date">@a.ActivityDate.ToString("MM/dd/yyyy hh:mm tt")</span>
                                        </div>
                                        <div class="pd-tl-meta">
                                            <span>@a.Channel</span>
                                            <span>@a.Outcome</span>
                                            <span>by @a.CreatedBy</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(a.Notes))
                                        {
                                            <div class="pd-tl-notes">@a.Notes</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
            break;
        case 6:
            <!-- 6 -- COMMUNICATIONS --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_comms.Count message(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => { _commForm = new(); _showCommForm = true; }">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> New Message
                            </button>
                        </div>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--communications">
                                <span>Date</span><span>Channel</span><span>Direction</span><span>Subject</span><span>Participants</span><span>Status</span><span></span>
                            </div>
                            @foreach (var c in _comms)
                            {
                                <button type="button" class="pd-list-row pd-list-row--communications" @ondblclick="() => OpenDetails(c)">
                                    <span class="pd-mono">@c.SentAt.ToString("MM/dd/yyyy")</span>
                                    <span class="pd-comm-chip pd-comm-@c.Channel.ToLower()">@c.Channel</span>
                                    <span class="pd-dir-chip @(c.Direction=="Inbound"?"pd-dir-in":"pd-dir-out")">@c.Direction</span>
                                    <span><strong>@c.Subject</strong><small>@c.ThreadId</small></span>
                                    <span><strong>@c.From</strong><small>@c.To</small></span>
                                    <span class="pd-comm-status pd-cstat-@c.Status.ToLower()">@c.Status</span>
                                    <span class="pd-open-cell">@OpenDetailsLink(c)</span>
                                </button>
                            }
                        </div>
                    </div>
            break;
        case 7:
            <!-- 7 -- BILLING --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-billing-summary">
                            <div class="pd-bill-kpi pd-bill-kpi--prem">
                                <div class="pd-bill-val">@_policy.WrittenPremium.ToString("C2")</div>
                                <div class="pd-bill-lbl">Total Billed</div>
                            </div>
                            <div class="pd-bill-kpi pd-bill-kpi--paid">
                                <div class="pd-bill-val">@_invoices.Where(i => i.Status == "Paid").Sum(i => i.Amount).ToString("C2")</div>
                                <div class="pd-bill-lbl">Total Paid</div>
                            </div>
                            <div class="pd-bill-kpi @(_policy.BalanceDue > 0 ? "pd-bill-kpi--due" : "pd-bill-kpi--ok")">
                                <div class="pd-bill-val">@_policy.BalanceDue.ToString("C2")</div>
                                <div class="pd-bill-lbl">Balance Due</div>
                            </div>
                            <div class="pd-bill-kpi">
                                <div class="pd-bill-val">@_policy.BillingPlan</div>
                                <div class="pd-bill-lbl">Billing Plan</div>
                            </div>
                        </div>

                        <h4 class="pd-section-hdr2">Installment Schedule</h4>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--billing">
                                <span>Invoice</span><span>Due</span><span>Amount</span><span>Paid</span><span>Balance</span><span>Status</span><span></span>
                            </div>
                            @foreach (var i in _invoices)
                            {
                                <button type="button" class="pd-list-row pd-list-row--billing" @ondblclick="() => OpenDetails(i)">
                                    <span class="pd-mono">@i.InvoiceNum</span>
                                    <span class="pd-mono @(i.Status == "Overdue" ? "pd-exp-30" : null)">@i.DueDate.ToString("MM/dd/yyyy")</span>
                                    <span class="pd-mono">@i.Amount.ToString("C2")</span>
                                    <span class="pd-mono">@i.AmountPaid.ToString("C2")</span>
                                    <span class="pd-mono @(i.Balance > 0 ? "pd-bill-red" : null)">@i.Balance.ToString("C2")</span>
                                    <span class="pd-inv-status pd-inv-@i.Status.ToLower()">@i.Status</span>
                                    <span class="pd-open-cell">@OpenDetailsLink(i)</span>
                                </button>
                            }
                        </div>
                    </div>
            break;
        case 8:
            <!-- 8 -- CLAIMS --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_claims.Count claim(s) ? @_claims.Count(c => c.Status == "Open") open</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenClaimForm">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Report Claim
                            </button>
                        </div>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--claims">
                                <span>Claim</span><span>Loss</span><span>Description</span><span>Status</span><span>Reserve</span><span>Paid</span><span></span>
                            </div>
                            @foreach (var c in _claims)
                            {
                                <button type="button" class="pd-list-row pd-list-row--claims" @ondblclick="() => OpenDetails(c)">
                                    <span><strong>@c.ClaimNum</strong><small>@c.LossType</small></span>
                                    <span class="pd-mono">@c.LossDate.ToString("MM/dd/yyyy")</span>
                                    <span><strong>@c.Description</strong><small>@c.Adjuster</small></span>
                                    <span class="pd-claim-status pd-cs-@c.Status.ToLower()">@c.Status</span>
                                    <span class="pd-mono">@c.Reserve.ToString("C0")</span>
                                    <span class="pd-mono">@c.Paid.ToString("C0")</span>
                                    <span class="pd-open-cell">@OpenDetailsLink(c)</span>
                                </button>
                            }
                        </div>
                    </div>
            break;
        case 9:
            <!-- 9 -- ENDORSEMENTS --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_endorsements.Count endorsement(s)</span>
                            <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => OpenAction("endorse")'>
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> New Endorsement
                            </button>
                        </div>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--endorsements">
                                <span>Endorsement</span><span>Effective</span><span>Type</span><span>Description</span><span>Premium Δ</span><span>Status</span><span></span>
                            </div>
                            @foreach (var e in _endorsements)
                            {
                                <button type="button" class="pd-list-row pd-list-row--endorsements" @ondblclick="() => OpenDetails(e)">
                                    <span class="pd-mono">@e.EndNum</span>
                                    <span class="pd-mono">@e.EffDate.ToString("MM/dd/yyyy")</span>
                                    <span>@e.Type</span>
                                    <span><strong>@e.Description</strong><small>@e.IssuedBy</small></span>
                                    <span class="pd-mono @(e.PremChange > 0 ? "pd-prem-up" : e.PremChange < 0 ? "pd-prem-dn" : null)">@(_canViewEndorsementFinancial ? $"{(e.PremChange >= 0 ? "+" : "")}{e.PremChange:C2}" : "Restricted")</span>
                                    <span class="pd-end-status pd-es-@e.Status.ToLower()">@e.Status</span>
                                    <span class="pd-open-cell">@OpenDetailsLink(e)</span>
                                </button>
                            }
                        </div>
                    </div>
            break;
        case 10:
            <!-- 10 -- RENEWALS --------------------------------------------- -->
                    <div class="pd-tab-body">
                        @if (_renewal is not null)
                        {
                            <div class="pd-renewal-banner pd-renewal-@RenewalUrgency(_policy.ExpDate)">
                                <div class="pd-ren-info">
                                    <i class="bi bi-arrow-repeat pd-ren-icon" aria-hidden="true"></i>
                                    <div>
                                        <div class="pd-ren-title">Renewal Due @_policy.ExpDate.ToString("MMMM dd, yyyy")</div>
                                        <div class="pd-ren-sub">@DaysLabel(_policy.ExpDate) ? Status: <strong>@_renewal.Status</strong></div>
                                    </div>
                                </div>
                                <div class="pd-ren-actions">
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("remarket")'>
                                        <i class="bi bi-arrow-left-right" aria-hidden="true"></i> Remarket
                                    </button>
                                    <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => OpenAction("bindRenewal")'>
                                        <i class="bi bi-check-lg" aria-hidden="true"></i> Bind Renewal
                                    </button>
                                </div>
                            </div>
                            <div class="pd-summary-grid" style="margin-top:1rem">
                                <div class="pd-info-card">
                                    <h3 class="pd-card-hdr">Renewal Pipeline</h3>
                                    <div class="pd-field-grid">
                                        @F("Status",           _renewal.Status)
                                        @F("Quoted Premium",   _renewal.QuotedPremium?.ToString("C0") ?? "?")
                                        @F("Expiring Premium", _policy.WrittenPremium.ToString("C0"))
                                        @F("Change",           _renewal.QuotedPremium.HasValue ? $"{(_renewal.QuotedPremium.Value - _policy.WrittenPremium):+#,##0.00;-#,##0.00;$0}" : "?")
                                        @F("Remarketed",       _renewal.Remarketed ? "Yes" : "No")
                                        @F("Carriers Quoted",  _renewal.CarriersQuoted.ToString())
                                        @F("Follow-Up Date",   _renewal.FollowUpDate?.ToString("MM/dd/yyyy") ?? "?")
                                        @F("Assigned To",      _renewal.AssignedTo)
                                    </div>
                                </div>
                            </div>
                        }

                        <h4 class="pd-section-hdr2" style="margin-top:1.5rem">Renewal History</h4>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--renewals">
                                <span>Policy</span><span>Term</span><span>Carrier</span><span>Premium</span><span>? vs Prior</span><span>Outcome</span>
                            </div>
                            @foreach (var r in _renewalHistory)
                            {
                                <div class="pd-list-row pd-list-row--renewals">
                                    <span class="pd-mono">@r.PolicyNum</span>
                                    <span><strong>@r.EffDate.ToString("MM/dd/yyyy")</strong><small>@r.ExpDate.ToString("MM/dd/yyyy")</small></span>
                                    <span>@r.Carrier</span>
                                    <span class="pd-mono">@r.Premium.ToString("C0")</span>
                                    <span class="pd-mono @(r.Change > 0 ? "pd-prem-up" : r.Change < 0 ? "pd-prem-dn" : null)">@(r.Change >= 0 ? "+" : "")@r.Change.ToString("C0")</span>
                                    <span class="pd-end-status pd-es-@r.Outcome.ToLower()">@r.Outcome</span>
                                </div>
                            }
                        </div>
                    </div>
            break;
        case 11:
            <!-- 11 -- COMMISSIONS --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-enterprise-hero pd-enterprise-hero--commissions">
                            <div>
                                <span class="pd-hero-eyebrow"><i class="bi bi-percent" aria-hidden="true"></i> DB-backed commission ledger</span>
                                <h3>Policy commission earnings, producer split, statements, and payout status synchronized from the ledger</h3>
                            </div>
                            <div class="pd-ren-actions">
                                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadPolicyCommissionsAsync">
                                    <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
                                </button>
                                <button class="um-btn um-btn-primary um-btn-sm" @onclick="SyncPolicyCommissionsAsync">
                                    <i class="bi bi-database-check" aria-hidden="true"></i> Sync Commission Data
                                </button>
                            </div>
                        </div>
                        <div class="pd-billing-summary">
                            <div class="pd-bill-kpi pd-bill-kpi--prem">
                                <div class="pd-bill-val">@_commissions.Sum(c => c.GrossAmt).ToString("C2")</div>
                                <div class="pd-bill-lbl">Ledger Gross</div>
                            </div>
                            <div class="pd-bill-kpi pd-bill-kpi--paid">
                                <div class="pd-bill-val">@_commissions.Sum(c => c.AgencyAmt).ToString("C2")</div>
                                <div class="pd-bill-lbl">Agency Net</div>
                            </div>
                            <div class="pd-bill-kpi">
                                <div class="pd-bill-val">@_commissions.Sum(c => c.ProducerAmt).ToString("C2")</div>
                                <div class="pd-bill-lbl">Producer Split</div>
                            </div>
                            <div class="pd-bill-kpi">
                                <div class="pd-bill-val">@(_commissions.Count > 0 ? $"{_commissions.Average(c => c.CommPct):P1}" : "—")</div>
                                <div class="pd-bill-lbl">Avg DB Rate</div>
                            </div>
                        </div>

                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--commissions">
                                <span>Period</span><span>Type</span><span>Producer</span><span>Comm %</span><span>Gross</span><span>Agency Net</span><span>Status</span><span>Open</span>
                            </div>
                            @if (_commissions.Count == 0)
                            {
                                <div class="pd-empty-state">
                                    <i class="bi bi-database-x" aria-hidden="true"></i>
                                    <strong>No commission ledger rows found for this policy.</strong>
                                    <span>Use Sync Commission Data to create policy commission ledger rows from DB-backed coverage detail records.</span>
                                </div>
                            }
                            @foreach (var c in _commissions)
                            {
                                <button type="button" class="pd-list-row pd-list-row--commissions" @ondblclick="() => OpenDetails(c)">
                                    <span><strong>@c.Period</strong><small>@c.TransactionDate.ToString("MM/dd/yyyy")</small></span>
                                    <span><strong>@c.Type</strong><small>@EmptyDash(c.LineOfBusiness)</small></span>
                                    <span><strong>@c.Producer</strong><small>@EmptyDash(c.Carrier)</small></span>
                                    <span class="pd-mono">@c.CommPct.ToString("P1")</span>
                                    <span class="pd-mono">@c.GrossAmt.ToString("C2")</span>
                                    <span><strong class="pd-mono">@c.AgencyAmt.ToString("C2")</strong><small>@c.ProducerAmt.ToString("C2") producer · @EmptyDash(c.StatementNumber)</small></span>
                                    <span class="pd-inv-status pd-inv-@c.Status.ToLower()">@c.Status</span>
                                    <span class="pd-open-cell">@OpenDetailsLink(c)</span>
                                </button>
                            }
                        </div>
                    </div>
            break;
        case 12:
            <!-- 12 -- AUDIT --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_auditLog.Count event(s)</span>
                        </div>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--audit">
                                <span>Timestamp</span><span>Action</span><span>Field</span><span>Change</span><span>Changed By</span><span>IP</span>
                            </div>
                            @foreach (var a in _auditLog)
                            {
                                <div class="pd-list-row pd-list-row--audit">
                                    <span class="pd-mono">@a.Timestamp.ToString("MM/dd/yy hh:mm tt")</span>
                                    <span class="pd-audit-action pd-aa-@a.Action.ToLower().Replace(" ","-")">@a.Action</span>
                                    <span>@a.Field</span>
                                    <span><strong>@a.NewValue</strong><small>from @a.OldValue</small></span>
                                    <span>@a.ChangedBy</span>
                                    <span class="pd-mono">@a.IpAddress</span>
                                </div>
                            }
                        </div>
                    </div>
            break;
        case 13:
            <!-- 13 -- CERTIFICATES --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-enterprise-hero pd-enterprise-hero--certs">
                            <div>
                                <span class="pd-hero-eyebrow"><i class="bi bi-award" aria-hidden="true"></i> Certificate operations</span>
                                <h3>Certificate issuance, holders, delivery, and expiration monitoring</h3>
                            </div>
                            <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => OpenAction("certificate")'>
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Issue Certificate
                            </button>
                        </div>
                        <div class="pd-module-kpis">
                            @ModuleKpi("Active Certificates", _certificates.Count(c => c.Status == "Active").ToString(), "bi-award", "pd-ki--green")
                            @ModuleKpi("Expiring 30 Days", _certificates.Count(c => c.ExpirationDate <= DateTime.Today.AddDays(30)).ToString(), "bi-clock", "pd-ki--amber")
                            @ModuleKpi("Portal Delivery", _certificates.Count(c => c.Delivery == "Portal").ToString(), "bi-person-lines-fill", "pd-ki--blue")
                        </div>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--certificates">
                                <span>Certificate</span><span>Holder</span><span>Type</span><span>Issued</span><span>Expires</span><span>Status</span><span></span>
                            </div>
                            @foreach (var c in _certificates)
                            {
                                <button type="button" class="pd-list-row pd-list-row--certificates" @ondblclick="() => OpenDetails(c)">
                                    <span class="pd-mono">@c.CertificateNum</span>
                                    <span><strong>@c.Holder</strong><small>@c.RequestedBy</small></span>
                                    <span>@c.Type</span>
                                    <span class="pd-mono">@c.IssuedDate.ToString("MM/dd/yyyy")</span>
                                    <span class="pd-mono @(c.ExpirationDate <= DateTime.Today.AddDays(30) ? "pd-exp-30" : null)">@c.ExpirationDate.ToString("MM/dd/yyyy")</span>
                                    <span>@StatusPill(c.Status)</span>
                                    <span class="pd-open-cell">@OpenDetailsLink(c)</span>
                                </button>
                            }
                        </div>
                    </div>
            break;
        case 14:
            <!-- 14 -- COMPLIANCE --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-enterprise-hero pd-enterprise-hero--compliance">
                            <div>
                                <span class="pd-hero-eyebrow"><i class="bi bi-patch-check" aria-hidden="true"></i> Compliance workspace</span>
                                <h3>Forms, evidence, acknowledgements, notices, and regulatory exceptions tied to this policy</h3>
                            </div>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/compliance")'>
                                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Compliance Center
                            </button>
                        </div>
                        <div class="pd-module-kpis">
                            @ModuleKpi("Compliant", _compliance.Count(c => c.Status == "Compliant").ToString(), "bi-check-circle", "pd-ki--green")
                            @ModuleKpi("Action Required", _compliance.Count(c => c.Status is "Due" or "Exception").ToString(), "bi-exclamation-triangle", "pd-ki--red")
                            @ModuleKpi("Due This Month", _compliance.Count(c => c.DueDate <= DateTime.Today.AddDays(30)).ToString(), "bi-calendar-event", "pd-ki--amber")
                        </div>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--compliance">
                                <span>Requirement</span><span>Category</span><span>Status</span><span>Due</span><span>Owner</span><span>Evidence</span><span></span>
                            </div>
                            @foreach (var c in _compliance)
                            {
                                <button type="button" class="pd-list-row pd-list-row--compliance" @ondblclick="() => OpenDetails(c)">
                                    <span><strong>@c.Requirement</strong></span>
                                    <span>@c.Category</span>
                                    <span>@StatusPill(c.Status)</span>
                                    <span class="pd-mono @(c.DueDate <= DateTime.Today.AddDays(14) && c.Status != "Compliant" ? "pd-exp-30" : null)">@c.DueDate.ToString("MM/dd/yyyy")</span>
                                    <span>@c.Owner</span>
                                    <span>@c.Evidence</span>
                                    <span class="pd-open-cell">@OpenDetailsLink(c)</span>
                                </button>
                            }
                        </div>
                    </div>
            break;
        case 15:
            <!-- 15 -- TASKS --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-enterprise-hero pd-enterprise-hero--tasks">
                            <div>
                                <span class="pd-hero-eyebrow"><i class="bi bi-check2-square" aria-hidden="true"></i> Service task board</span>
                                <h3>Policy service, renewal, billing, compliance, and claims follow-up work</h3>
                            </div>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/tasks")'>
                                <i class="bi bi-kanban" aria-hidden="true"></i> Task Board
                            </button>
                        </div>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--tasks">
                                <span>Task</span><span>Type</span><span>Priority</span><span>Status</span><span>Due</span><span>Assigned</span><span></span>
                            </div>
                            @foreach (var t in _serviceTasks)
                            {
                                <button type="button" class="pd-list-row pd-list-row--tasks" @ondblclick="() => OpenDetails(t)">
                                    <span><strong>@t.TaskNumber</strong><small>@t.Title</small></span>
                                    <span>@t.Type</span>
                                    <span>@PriorityPill(t.Priority)</span>
                                    <span>@StatusPill(t.Status)</span>
                                    <span class="pd-mono @(t.DueDate <= DateTime.Today.AddDays(7) && t.Status != "Completed" ? "pd-exp-30" : null)">@t.DueDate.ToString("MM/dd/yyyy")</span>
                                    <span>@t.AssignedTo</span>
                                    <span class="pd-open-cell">@OpenDetailsLink(t)</span>
                                </button>
                            }
                        </div>
                    </div>
            break;
        case 16:
            <!-- 16 -- SUBMISSIONS --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-enterprise-hero pd-enterprise-hero--submissions">
                            <div>
                                <span class="pd-hero-eyebrow"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i> Submission lineage</span>
                                <h3>Source submissions, quotes, markets, declines, and bound policy lineage</h3>
                            </div>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/submissions")'>
                                <i class="bi bi-inbox" aria-hidden="true"></i> Submission Register
                            </button>
                        </div>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--submissions">
                                <span>Submission</span><span>Opportunity</span><span>Market</span><span>Stage</span><span>Submitted</span><span>Quoted</span><span></span>
                            </div>
                            @foreach (var s in _submissions)
                            {
                                <button type="button" class="pd-list-row pd-list-row--submissions" @ondblclick="() => OpenDetails(s)">
                                    <span class="pd-mono">@s.SubmissionNo</span>
                                    <span>@s.Opportunity</span>
                                    <span>@s.Market</span>
                                    <span>@s.Stage</span>
                                    <span class="pd-mono">@s.SubmittedOn.ToString("MM/dd/yyyy")</span>
                                    <span><strong class="pd-mono">@s.QuotedPremium.ToString("C0")</strong><small>@s.Outcome</small></span>
                                    <span class="pd-open-cell">@OpenDetailsLink(s)</span>
                                </button>
                            }
                        </div>
                    </div>
            break;
        case 17:
            <!-- 17 -- CARRIER / UNDERWRITING --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-enterprise-hero pd-enterprise-hero--carrier">
                            <div>
                                <span class="pd-hero-eyebrow"><i class="bi bi-building-check" aria-hidden="true"></i> Carrier and underwriting desk</span>
                                <h3>Underwriting requirements, carrier contacts, appetite, downloads, and market servicing</h3>
                            </div>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/admin/reference/carriers")'>
                                <i class="bi bi-broadcast" aria-hidden="true"></i> Carrier Directory
                            </button>
                        </div>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--carrier">
                                <span>Item</span><span>Type</span><span>Status</span><span>Owner</span><span>Updated</span><span>Notes</span><span></span>
                            </div>
                            @foreach (var c in _carrierUw)
                            {
                                <button type="button" class="pd-list-row pd-list-row--carrier" @ondblclick="() => OpenDetails(c)">
                                    <span>@c.Item</span>
                                    <span>@c.Type</span>
                                    <span>@StatusPill(c.Status)</span>
                                    <span>@c.Owner</span>
                                    <span class="pd-mono">@c.LastUpdate.ToString("MM/dd/yyyy")</span>
                                    <span>@c.Notes</span>
                                    <span class="pd-open-cell">@OpenDetailsLink(c)</span>
                                </button>
                            }
                        </div>
                    </div>
            break;
        case 18:
            <!-- 18 -- RELATIONSHIPS --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-enterprise-hero pd-enterprise-hero--relationships">
                            <div>
                                <span class="pd-hero-eyebrow"><i class="bi bi-diagram-3" aria-hidden="true"></i> Relationship map</span>
                                <h3>Account, contacts, decision makers, additional insureds, mortgagees, lienholders, and service teams</h3>
                            </div>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/accounts/{_policy?.AccountId}/relationships")'>
                                <i class="bi bi-link-45deg" aria-hidden="true"></i> Account Relationships
                            </button>
                        </div>
                        <div class="pd-relationship-grid">
                            @foreach (var rel in _relationships)
                            {
                                <button type="button" class="pd-relationship-card" @ondblclick="() => OpenDetails(rel)" @onclick="() => OpenDetails(rel)">
                                    <span class="pd-rel-icon"><i class="bi @RelationshipIcon(rel.Role)" aria-hidden="true"></i></span>
                                    <span class="pd-rel-body">
                                        <strong>@rel.Entity</strong>
                                        <small>@rel.Role ? @rel.Relationship</small>
                                        <span>@rel.Contact</span>
                                    </span>
                                    @StatusPill(rel.Status)
                                    <span class="pd-open-action pd-open-action--static">Open <i class="bi bi-arrow-right-short" aria-hidden="true"></i></span>
                                </button>
                            }
                        </div>
                    </div>
            break;
        case 19:
            <!-- 19 -- REINSURANCE --------------------------------------------- -->
                    <div class="pd-tab-body">
                        <div class="pd-enterprise-hero pd-enterprise-hero--reinsurance">
                            <div>
                                <span class="pd-hero-eyebrow"><i class="bi bi-layers" aria-hidden="true"></i> Reinsurance and risk finance</span>
                                <h3>Treaties, facultative layers, ceded exposure, retention, and carrier risk transfer</h3>
                            </div>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/analytics/policies")'>
                                <i class="bi bi-bar-chart-line" aria-hidden="true"></i> Policy Analytics
                            </button>
                        </div>
                        <div class="pd-enterprise-list">
                            <div class="pd-list-head pd-list-head--reinsurance">
                                <span>Treaty</span><span>Layer</span><span>Attachment</span><span>Limit</span><span>Ceded</span><span>Status</span><span></span>
                            </div>
                            @foreach (var r in _reinsurance)
                            {
                                <button type="button" class="pd-list-row pd-list-row--reinsurance" @ondblclick="() => OpenDetails(r)">
                                    <span>@r.Treaty</span>
                                    <span>@r.Layer</span>
                                    <span class="pd-mono">@r.Attachment.ToString("C0")</span>
                                    <span class="pd-mono">@r.Limit.ToString("C0")</span>
                                    <span><strong class="pd-mono">@r.CededPct.ToString("P0")</strong><small>@r.Reinsurer</small></span>
                                    <span>@StatusPill(r.Status)</span>
                                    <span class="pd-open-cell">@OpenDetailsLink(r)</span>
                                </button>
                            }
                        </div>
                    </div>
            break;
    }
    </div>
}

<!-- -- ACTION DIALOGS ---------------------------------------------------- -->
@if (_selectedCoverage is not null)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseCoverageDetails">
        <div class="mt-modal pd-form-modal pd-coverage-detail-modal" role="dialog" aria-modal="true" aria-labelledby="pd-coverage-detail-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <span id="pd-coverage-detail-title">Coverage Details</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseCoverageDetails"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-modal-body">
                <div class="pd-coverage-detail-hero">
                    <div class="pd-coverage-detail-mark" aria-hidden="true">
                        <i class="bi bi-shield-half"></i>
                    </div>
                    <div class="pd-coverage-detail-summary">
                        <span class="pd-modal-chip"><i class="bi bi-database-check" aria-hidden="true"></i> DB-backed coverage workflow</span>
                        <h3>@_selectedCoverage.CovName</h3>
                        <div class="pd-coverage-detail-meta">
                            <span>@_selectedCoverage.CovCode</span>
                            <span>@_selectedCoverage.LineOfBusinessCode</span>
                            <span>@EmptyDash(_selectedCoverage.StatusCode)</span>
                        </div>
                    </div>
                    <div class="pd-coverage-detail-premium">
                        <span>Premium</span>
                        <strong>@_selectedCoverage.Premium.ToString("C2")</strong>
                    </div>
                </div>
                <div class="pd-coverage-detail-kpis" aria-label="Coverage summary">
                    <div>
                        <span>Occurrence</span>
                        <strong>@MoneyOrDash(_selectedCoverage.OccurrenceLimit)</strong>
                    </div>
                    <div>
                        <span>Aggregate</span>
                        <strong>@MoneyOrDash(_selectedCoverage.AggregateLimit)</strong>
                    </div>
                    <div>
                        <span>Deductible</span>
                        <strong>@MoneyOrDash(_selectedCoverage.Deductible)</strong>
                    </div>
                    <div>
                        <span>Effective</span>
                        <strong>@_selectedCoverage.EffectiveDate.ToString("MM/dd/yyyy")</strong>
                    </div>
                </div>
                <div class="pd-modal-intro pd-coverage-detail-note">
                    <p>Review policy coverage terms, rating metadata, servicing instructions, and dynamic fields stored for this policy.</p>
                </div>
                <div class="pd-coverage-detail-sections">
                    <section class="pd-coverage-detail-section">
                        <h4><i class="bi bi-card-checklist" aria-hidden="true"></i> Coverage Identity</h4>
                        <div class="pd-field-grid pd-field-grid--coverage-detail">
                            @F("Coverage Code", _selectedCoverage.CovCode)
                            @F("Coverage Name", _selectedCoverage.CovName)
                            @F("Line of Business", _selectedCoverage.LineOfBusinessCode)
                            @F("Category", _selectedCoverage.CoverageCategoryCode)
                            @F("Form", _selectedCoverage.CoverageFormCode)
                            @F("Trigger", _selectedCoverage.CoverageTriggerCode)
                            @F("Valuation", EmptyDash(_selectedCoverage.ValuationBasisCode))
                            @F("Territory", EmptyDash(_selectedCoverage.TerritoryCode))
                        </div>
                    </section>
                    <section class="pd-coverage-detail-section">
                        <h4><i class="bi bi-cash-coin" aria-hidden="true"></i> Limits &amp; Rating</h4>
                        <div class="pd-field-grid pd-field-grid--coverage-detail">
                            @F("Occurrence Limit", MoneyOrDash(_selectedCoverage.OccurrenceLimit))
                            @F("Aggregate Limit", MoneyOrDash(_selectedCoverage.AggregateLimit))
                            @F("Sublimit", MoneyOrDash(_selectedCoverage.Sublimit))
                            @F("Deductible", MoneyOrDash(_selectedCoverage.Deductible))
                            @F("Retention", MoneyOrDash(_selectedCoverage.Retention))
                            @F("Premium", _selectedCoverage.Premium.ToString("C2"))
                            @F("Rate", _selectedCoverage.Rate?.ToString("0.######") ?? "—")
                            @F("Exposure Base", MoneyOrDash(_selectedCoverage.ExposureBase))
                            @F("Exposure Basis", EmptyDash(_selectedCoverage.ExposureBasisCode))
                        </div>
                    </section>
                    <section class="pd-coverage-detail-section">
                        <h4><i class="bi bi-calendar2-week" aria-hidden="true"></i> Term &amp; Servicing</h4>
                        <div class="pd-field-grid pd-field-grid--coverage-detail">
                            @F("Effective", _selectedCoverage.EffectiveDate.ToString("MM/dd/yyyy"))
                            @F("Expiration", _selectedCoverage.ExpirationDate.ToString("MM/dd/yyyy"))
                            @F("Carrier", EmptyDash(_selectedCoverage.CarrierName))
                            @F("Writing Company", EmptyDash(_selectedCoverage.WritingCompanyName))
                            @F("Underwriter", EmptyDash(_selectedCoverage.UnderwriterName))
                            @F("Status", EmptyDash(_selectedCoverage.StatusCode))
                        </div>
                    </section>
                    <section class="pd-coverage-detail-section">
                        <h4><i class="bi bi-ui-checks" aria-hidden="true"></i> Flags</h4>
                        <div class="pd-field-grid pd-field-grid--coverage-detail">
                            @F("Included", _selectedCoverage.IsIncluded ? "Yes" : "No")
                            @F("Auditable", _selectedCoverage.IsAuditable ? "Yes" : "No")
                            @F("Claims Made", _selectedCoverage.IsClaimsMade ? "Yes" : "No")
                            @F("Schedule Required", _selectedCoverage.RequiresSchedule ? "Yes" : "No")
                            @F("Certificate Review", _selectedCoverage.RequiresCertificateReview ? "Yes" : "No")
                        </div>
                    </section>
                </div>
                <div class="pd-detail-panels">
                    @CoverageTextPanel("Forms & Endorsements", _selectedCoverage.FormsAndEndorsements)
                    @CoverageTextPanel("Coinsurance / Blanket", FirstNonEmpty(_selectedCoverage.CoinsuranceClause, _selectedCoverage.BlanketOrSpecificCode))
                    @CoverageTextPanel("Covered Operations", _selectedCoverage.CoveredOperations)
                    @CoverageTextPanel("Exclusions", _selectedCoverage.Exclusions)
                    @CoverageTextPanel("Conditions", _selectedCoverage.Conditions)
                    @CoverageTextPanel("Rating Notes", _selectedCoverage.RatingNotes)
                    @CoverageTextPanel("Service Instructions", _selectedCoverage.ServiceInstructions)
                    @CoverageTextPanel("Audit Instructions", _selectedCoverage.AuditInstructions)
                    @CoverageTextPanel("Certificate Instructions", _selectedCoverage.CertificateInstructions)
                </div>
                @if (_selectedCoverage.Fields.Count > 0)
                {
                    <div class="pd-field-list">
                        <h4>Dynamic Coverage Fields</h4>
                        @foreach (var field in _selectedCoverage.Fields)
                        {
                            <div class="pd-field-list-row">
                                <span><strong>@field.FieldLabel</strong><small>@field.FieldGroupCode / @field.FieldCode</small></span>
                                <span>@EmptyDash(field.FieldValue) @(string.IsNullOrWhiteSpace(field.UnitOfMeasureCode) ? string.Empty : field.UnitOfMeasureCode)</span>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CloseCoverageDetails">Close</button>
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenCoverageEdit(_selectedCoverage)">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i> Edit
                </button>
                <button type="button" class="um-btn um-btn-danger" @onclick="() => DeleteCoverageAsync(_selectedCoverage)">
                    <i class="bi bi-trash" aria-hidden="true"></i> Delete
                </button>
                <button type="button" class="um-btn um-btn-primary" @onclick="() => OpenCoverageComparison(_selectedCoverage)">
                    <i class="bi bi-layout-split" aria-hidden="true"></i> Comparison
                </button>
            </div>
        </div>
    </div>
}

@if (_showActionDlg)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseActionDialog">
        <div class="mt-modal pd-form-modal pd-action-modal" role="dialog" aria-modal="true" aria-labelledby="pd-action-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi @_actionIcon" aria-hidden="true"></i>
                <span id="pd-action-title">@_actionTitle</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseActionDialog"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_actionForm" OnValidSubmit="ExecuteActionAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="pd-modal-intro @(_activeAction == "cancel" ? "pd-modal-intro--danger" : null)">
                        <span class="pd-modal-chip"><i class="bi @_actionIcon" aria-hidden="true"></i> Policy workflow</span>
                        <p>@_actionDesc</p>
                    </div>
                    <div class="um-form-grid">
                        @if (_activeAction is "endorse" or "rewrite" or "cancel" or "reinstate" or "certificate" or "bindRenewal")
                        {
                            <div class="um-field">
                                <label>@ActionDateLabel <span class="text-danger">*</span></label>
                                <InputDate class="form-control" @bind-Value="_actionForm.ActionDate" />
                            </div>
                        }
                        @if (_activeAction is "endorse" or "rewrite")
                        {
                            <div class="um-field">
                                <label>Endorsement Type <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="_actionForm.EndorsementType">
                                    <option value="">Select type</option>
                                    @foreach (var opt in EndorsementTypeOptions)
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="um-field">
                                <label>Change Category</label>
                                <InputSelect class="form-select" @bind-Value="_actionForm.ChangeCategoryCode">
                                    @foreach (var opt in EndorsementOptionValues("ChangeCategory"))
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="um-field">
                                <label>Request Source</label>
                                <InputSelect class="form-select" @bind-Value="_actionForm.RequestSourceCode">
                                    @foreach (var opt in EndorsementOptionValues("RequestSource"))
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="um-field">
                                <label>Priority</label>
                                <InputSelect class="form-select" @bind-Value="_actionForm.Priority">
                                    @foreach (var opt in EndorsementOptionValues("Priority"))
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="um-field">
                                <label>Premium Change</label>
                                <InputNumber class="form-control" @bind-Value="_actionForm.PremiumDelta" />
                            </div>
                            <div class="um-field">
                                <label>Taxes / Fees Change</label>
                                <InputNumber class="form-control" @bind-Value="_actionForm.TaxFeeDelta" />
                            </div>
                            <div class="um-field">
                                <label>Billing Impact</label>
                                <InputSelect class="form-select" @bind-Value="_actionForm.BillingImpactCode">
                                    @foreach (var opt in EndorsementOptionValues("BillingImpact"))
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="um-field">
                                <label>Approval Level</label>
                                <InputSelect class="form-select" @bind-Value="_actionForm.ApprovalLevelCode">
                                    @foreach (var opt in EndorsementOptionValues("ApprovalLevel"))
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="um-field">
                                <label>Carrier Reference</label>
                                <InputText class="form-control" @bind-Value="_actionForm.CarrierReferenceNumber" />
                            </div>
                            <div class="um-field">
                                <label>Client Contact</label>
                                <InputText class="form-control" @bind-Value="_actionForm.ClientContactName" />
                            </div>
                            <div class="um-field um-field--full">
                                <label>Required Documents</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="_actionForm.RequiredDocuments" />
                            </div>
                        }
                        @if (_activeAction == "cancel")
                        {
                            <div class="um-field">
                                <label>Cancellation Reason <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="_actionForm.Reason">
                                    <option value="">Select reason</option>
                                    @foreach (var opt in _cancelReasonOpts)
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                        @if (_activeAction == "certificate")
                        {
                            <div class="um-field">
                                <label>Certificate Holder <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_actionForm.PartyName" />
                            </div>
                            <div class="um-field">
                                <label>Certificate Type</label>
                                <InputSelect class="form-select" @bind-Value="_actionForm.Reason">
                                    @foreach (var opt in _certTypeOpts)
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="um-field um-field--full">
                                <label>Holder Address</label>
                                <InputText class="form-control" @bind-Value="_actionForm.PartyAddress" />
                            </div>
                        }
                        @if (_activeAction == "esign")
                        {
                            <div class="um-field">
                                <label>Signer Name <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_actionForm.PartyName" />
                            </div>
                            <div class="um-field">
                                <label>Signer Email <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_actionForm.PartyAddress" />
                            </div>
                            <div class="um-field um-field--full">
                                <label>Document To Sign <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="_actionForm.Reason">
                                    <option value="">Select document</option>
                                    @foreach (var opt in _esignDocOpts)
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                        @if (_activeAction == "message")
                        {
                            <div class="um-field">
                                <label>Channel <span class="text-danger">*</span></label>
                                <InputSelect class="form-select" @bind-Value="_actionForm.Reason">
                                    @foreach (var opt in _msgChannelOpts)
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="um-field">
                                <label>Recipient <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_actionForm.PartyName" />
                            </div>
                            <div class="um-field um-field--full">
                                <label>Subject</label>
                                <InputText class="form-control" @bind-Value="_actionForm.PartyAddress" />
                            </div>
                        }
                        <div class="um-field um-field--full">
                            <label>Notes / Reason @if (_activeAction is "cancel" or "remarket" or "rewrite") { <span class="text-danger">*</span> }</label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_actionForm.Note" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseActionDialog">Cancel</button>
                    <button type="submit" class="um-btn @(_activeAction == "cancel" ? "um-btn-danger" : "um-btn-primary")">
                        <i class="bi bi-check-lg" aria-hidden="true"></i> Confirm
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showCovForm)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseCoverageForm">
        <div class="mt-modal pd-form-modal pd-coverage-edit-modal" role="dialog" aria-modal="true" aria-labelledby="pd-coverage-title" @onclick:stopPropagation="true">
