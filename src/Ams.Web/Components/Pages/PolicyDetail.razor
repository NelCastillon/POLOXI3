    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(
            new("Home", "/"), new("Policies", "/policies"),
            new("Policy Detail", $"/policies/{PolicyId}"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();
        try
        {
            await LoadPolicyRecordAsync();
            if (_policy is null)
            {
                ClearPolicyDetailCollections();
                return;
            }

            await LoadPolicyRelatedDataAsync();
            _servicingWorkspace = await Api.GetPolicyServicingWorkspaceAsync(_tenantId, PolicyId);
            LoadServicingWorkspaceRows();
            _accounting = await Api.GetPolicyAccountingDashboardAsync(_tenantId, PolicyId);
            LoadAccountingRows();
            await LoadPolicyCoveragesAsync();
            await LoadCoverageLookupsAsync();
            await LoadEndorsementTypesAsync();
            await LoadPolicyLifecycleOptionsAsync();
            await LoadPolicyCommissionsAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load policy detail: {ex.Message}";
            await ShowErrorToast($"Load failed: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadPolicyRecordAsync()
    {
        var registerPolicy = await Api.GetPolicyRegisterByIdAsync(PolicyId);
        _policy = registerPolicy is null ? null : MapPolicyRecord(registerPolicy);
        if (_policy is not null)
        {
            Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policies", "/policies"), new(_policy.PolicyNumber, $"/policies/{PolicyId}"));
        }
    }

    private async Task LoadPolicyRelatedDataAsync()
    {
        if (_policy is null) return;

        var endorsementsTask = Api.GetPolicyEndorsementWorkspaceAsync(_tenantId, PolicyId);
        var cancellationsTask = Api.GetPolicyCancellationCenterAsync(_tenantId);
        var certificatesTask = Api.SearchPolicyCertificatesAsync(_tenantId, _policy.PolicyNumber, pageSize: 200);
        var documentsTask = Api.SearchPolicyDocumentsAsync(_tenantId, _policy.PolicyNumber, pageSize: 200);
        var enterpriseDocumentsTask = Api.GetDocumentsByEntityAsync(_tenantId, "Policy", PolicyId);
        var submissionsTask = Api.SearchSubmissionsAsync(_tenantId, _policy.SubmissionRef, pageSize: 25);
        var claimsTask = Api.SearchClaimsAsync(_tenantId, _policy.PolicyNumber, pageSize: 200);
        var renewalsTask = Api.GetRenewalRetentionCenterAsync(_tenantId);

        await Task.WhenAll(endorsementsTask, cancellationsTask, certificatesTask, documentsTask, enterpriseDocumentsTask, submissionsTask, claimsTask, renewalsTask);

        var endorsements = endorsementsTask.Result?.Endorsements
            .OrderByDescending(x => x.RequestedDateUtc)
            .ToList() ?? [];
        _endorsements = endorsements.Select(MapEndorsementRow).ToList();
        _endorsementOptions = endorsementsTask.Result?.Options.ToList() ?? [];

        var cancellationActivities = cancellationsTask.Result?.Activities ?? [];
        var cancellations = cancellationsTask.Result?.Cancellations
            .Where(x => x.PolicyId == PolicyId || string.Equals(x.PolicyNumber, _policy.PolicyNumber, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.RequestDateUtc)
            .ToList() ?? [];

        _certificates = (certificatesTask.Result?.Items ?? [])
            .Where(x => x.PolicyId == PolicyId || string.Equals(x.PolicyNumber, _policy.PolicyNumber, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.IssuedDate)
            .Select(MapCertificateRow)
            .ToList();

        _claims = (claimsTask.Result?.Items ?? [])
            .Where(x => x.PolicyId == PolicyId)
            .OrderByDescending(x => x.DateReported)
            .Select(x => new ClaimRow
            {
                ClaimId = x.ClaimId,
                ClaimNum = x.ClaimNumber,
                LossDate = x.DateOfLoss,
                LossType = x.LossType,
                Description = x.LossDescription ?? string.Empty,
                Status = x.Status,
                Reserve = x.TotalReserves,
                Paid = x.TotalPaid,
                Adjuster = x.AssignedHandler,
                ClosedDate = x.ClosedDate
            }).ToList();

        var renewalCase = (renewalsTask.Result?.Cases ?? []).FirstOrDefault(x => x.PolicyId == PolicyId);
        _renewal = renewalCase is null ? null : new RenewalPipeline
        {
            Status = renewalCase.Stage,
            QuotedPremium = renewalCase.ProposedPremium,
            Remarketed = renewalCase.RenewalSubmissionId.HasValue,
            CarriersQuoted = renewalCase.RenewalSubmissionId.HasValue ? 1 : 0,
            FollowUpDate = renewalCase.NextActionDueDate,
            AssignedTo = renewalCase.AssignedToName ?? renewalCase.Csr
        };

        _documents = (documentsTask.Result?.Items ?? [])
            .Where(x => string.Equals(x.PolicyCode, _policy.PolicyNumber, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.CreatedDateUtc)
            .Select(MapDocumentRow)
            .ToList();
        _documents.AddRange((enterpriseDocumentsTask.Result ?? []).Select(MapEnterpriseDocumentRow));
        _documents = _documents.OrderByDescending(x => x.UploadedAt).ToList();

        _submissions = (submissionsTask.Result?.Items ?? [])
            .Where(x => x.SubmissionId.ToString().Equals(_policy.SubmissionRef, StringComparison.OrdinalIgnoreCase) || string.Equals(x.SubmissionNumber, _policy.SubmissionRef, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.CreatedDateUtc)
            .Select(MapSubmissionRow)
            .ToList();

        _activities = BuildActivityRows(cancellations, cancellationActivities, endorsements);
        _auditLog = BuildAuditRows();
        BuildDerivedPolicyRows(cancellations);
    }

