    private static int  DaysToExp(DateTime exp)   => (int)(exp.Date - DateTime.Today).TotalDays;
    private static string DaysLabel(DateTime exp)
    {
        var d = DaysToExp(exp);
        return d < 0 ? $"Expired {-d}d ago" : d == 0 ? "Expires today" : $"{d}d remaining";
    }
    private static string ExpChipCss(DateTime exp)
    {
        var d = DaysToExp(exp);
        return d < 0 ? "pd-sub-chip--expired" : d <= 30 ? "pd-sub-chip--exp30" : d <= 60 ? "pd-sub-chip--exp60" : string.Empty;
    }
    private static string RenewalUrgency(DateTime exp)
    {
        var d = DaysToExp(exp);
        return d < 0 ? "past" : d <= 30 ? "urgent" : d <= 60 ? "soon" : "normal";
    }
