    private string PolicyHealthLabel()
    {
        if (_policy is null) return "Unknown";
        if (_policy.Status == "Cancelled") return "Cancelled";
        if (_policy.ExpDate < DateTime.Today) return "Expired";
        if (_policy.OpenClaims > 0) return "Claims Active";
        if (_policy.BalanceDue > 0) return "Billing Attention";
        if ((_policy.ExpDate - DateTime.Today).TotalDays <= 60) return "Renewal Focus";
        return "Healthy";
    }

    private string PolicyHealthSummary()
    {
        if (_policy is null) return "Policy record is unavailable.";
        if (_policy.Status == "Cancelled") return "Policy is cancelled; review reinstatement options.";
        if (_policy.ExpDate < DateTime.Today) return "Policy term has expired.";
        if (_policy.OpenClaims > 0) return $"{_policy.OpenClaims} open claim(s) need monitoring.";
        if (_policy.BalanceDue > 0) return $"{_policy.BalanceDue:C0} open receivable.";
        if ((_policy.ExpDate - DateTime.Today).TotalDays <= 60) return "Renewal workflow should stay active.";
        return "No immediate exceptions detected.";
    }

    private string PolicyHealthCss() => PolicyHealthLabel() switch
    {
        "Healthy" => "pd-command-card--success",
        "Renewal Focus" => "pd-command-card--info",
        "Billing Attention" or "Claims Active" => "pd-command-card--attention",
        _ => "pd-command-card--danger",
    };

    private int TermProgressPercent
    {
        get
        {
            if (_policy is null || _policy.ExpDate <= _policy.EffDate) return 100;
            var total = (_policy.ExpDate - _policy.EffDate).TotalDays;
            var elapsed = (DateTime.Today - _policy.EffDate).TotalDays;
            return Math.Clamp((int)Math.Round(elapsed * 100d / total), 0, 100);
        }
    }

    private IEnumerable<CockpitAction> RecommendedActions
    {
        get
        {
            if (_policy is null) yield break;
            if (_policy.BalanceDue > 0) yield return new("message", "Follow up receivable", $"{_policy.BalanceDue:C0} balance due", "bi-wallet2");
            if (_policy.OpenClaims > 0) yield return new("message", "Review claims", $"{_policy.OpenClaims} open claim(s)", "bi-exclamation-diamond");
            if ((_policy.ExpDate - DateTime.Today).TotalDays <= 90) yield return new("remarket", "Start renewal review", DaysLabel(_policy.ExpDate), "bi-arrow-repeat");
            yield return new("endorse", "Create endorsement", "Update limits, insureds, or schedules", "bi-pen");
        }
    }

    private RenderFragment CockpitCard(string label, string value, string description, string icon, string tone) => __builder =>
    {
        __builder.OpenElement(0, "article");
        __builder.AddAttribute(1, "class", $"pd-cockpit-card pd-cockpit-card--{tone}");
        __builder.OpenElement(2, "i");
        __builder.AddAttribute(3, "class", $"bi {icon}");
        __builder.AddAttribute(4, "aria-hidden", "true");
        __builder.CloseElement();
        __builder.OpenElement(5, "div");
        __builder.AddAttribute(6, "class", "pd-cockpit-card-body");
        __builder.OpenElement(7, "span");
        __builder.AddAttribute(8, "class", "pd-cockpit-card-label");
        __builder.AddContent(9, label);
        __builder.CloseElement();
        __builder.OpenElement(10, "strong");
        __builder.AddAttribute(11, "class", "pd-cockpit-card-value");
        __builder.AddContent(12, value);
        __builder.CloseElement();
        __builder.OpenElement(13, "small");
        __builder.AddAttribute(14, "class", "pd-cockpit-card-desc");
        __builder.AddContent(15, description);
        __builder.CloseElement();
        __builder.CloseElement();
        __builder.CloseElement();
    };

