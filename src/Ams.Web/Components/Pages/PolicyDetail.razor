    private sealed class PolicyActionForm : IValidatableObject
    {
        public string Action { get; set; } = string.Empty;
        [Required]
        public DateTime ActionDate { get; set; } = DateTime.Today;
        [StringLength(80)]
        public string? Reason { get; set; }
        [StringLength(180)]
        public string? PartyName { get; set; }
        [StringLength(240)]
        public string? PartyAddress { get; set; }
        [Range(-999999999, 999999999)]
        public decimal PremiumDelta { get; set; }
        [StringLength(2000)]
        public string? Note { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Action == "cancel" && string.IsNullOrWhiteSpace(Reason))
                yield return new ValidationResult("Cancellation reason is required.", [nameof(Reason)]);
            if (Action is "cancel" or "remarket" or "rewrite" && string.IsNullOrWhiteSpace(Note))
                yield return new ValidationResult("Notes are required for this workflow.", [nameof(Note)]);
            if (Action == "certificate" && string.IsNullOrWhiteSpace(PartyName))
                yield return new ValidationResult("Certificate holder is required.", [nameof(PartyName)]);
            if (Action == "esign" && string.IsNullOrWhiteSpace(PartyName))
                yield return new ValidationResult("Signer name is required.", [nameof(PartyName)]);
            if (Action == "esign" && string.IsNullOrWhiteSpace(PartyAddress))
                yield return new ValidationResult("Signer email is required.", [nameof(PartyAddress)]);
            if (Action == "esign" && string.IsNullOrWhiteSpace(Reason))
                yield return new ValidationResult("Document to sign is required.", [nameof(Reason)]);
            if (Action == "message" && string.IsNullOrWhiteSpace(PartyName))
                yield return new ValidationResult("Recipient is required.", [nameof(PartyName)]);
            if (Action == "message" && string.IsNullOrWhiteSpace(Reason))
                yield return new ValidationResult("Channel is required.", [nameof(Reason)]);
        }
    }

