    private void BuildDerivedPolicyRows(IReadOnlyList<PolicyCancellationDto> cancellations)
    {
        if (_policy is null) return;

        _renewal ??= new RenewalPipeline
        {
            Status = DaysLabel(_policy.ExpDate).Contains("Expired", StringComparison.OrdinalIgnoreCase) ? "Expired" : "In Progress",
            QuotedPremium = _policy.AnnualPremium,
            Remarketed = _activities.Any(a => a.Subject.Contains("Remarket", StringComparison.OrdinalIgnoreCase)),
            CarriersQuoted = _submissions.Count,
            FollowUpDate = _policy.ExpDate.AddDays(-60),
            AssignedTo = _policy.Csr
        };

        _renewalHistory = _submissions.Select(s => new RenewalHistRow { PolicyNum = _policy.PolicyNumber, EffDate = _policy.EffDate, ExpDate = _policy.ExpDate, Carrier = _policy.Carrier, Premium = s.QuotedPremium, Change = 0m, Outcome = s.Outcome }).ToList();
        _commissions = [];
        if (_compliance.Count == 0)
            _compliance = _documents.Select(d => new ComplianceRow { ComplianceDocumentId = d.DocumentId, Requirement = d.Name, Category = d.Category, Status = "On File", DueDate = d.UploadedAt, Owner = d.UploadedBy, Evidence = d.FileSize }).ToList();
        if (_serviceTasks.Count == 0)
            _serviceTasks = cancellations.Where(c => !string.Equals(c.Status, "Completed", StringComparison.OrdinalIgnoreCase)).Select(c => new ServiceTaskRow { TaskNumber = c.CancellationNumber, Title = c.CancellationReason, Type = c.RequestType, Priority = c.Priority, Status = c.Status, DueDate = c.DueDate ?? c.EffectiveDate, AssignedTo = c.AssignedToName, RelatedTo = c.PolicyNumber }).ToList();
        _relationships = [new RelationshipRow { Entity = _policy.Account, Role = "Named Insured", Relationship = "Policy owner", Contact = _policy.PrimaryInsured, Status = _policy.Status, Route = $"/accounts/{_policy.AccountId}" }, new RelationshipRow { Entity = _policy.Carrier, Role = "Carrier", Relationship = "Issuing carrier", Contact = _policy.Underwriter ?? _policy.Carrier, Status = "Active", Route = $"/admin/reference/carriers?carrier={Uri.EscapeDataString(_policy.Carrier)}" }];
        _carrierUw = [new CarrierUwRow { Item = _policy.Carrier, Type = "Carrier", Status = "Active", Owner = _policy.Underwriter ?? _policy.Carrier, LastUpdate = _policy.BindDate ?? _policy.CreatedAt, Notes = _policy.Lob }];
        _riskItems = [];
        _drivers = [];
        _locations = [];
        _reinsurance = [];
    }

