    private void ApplyCoverageLookup(CoverageLookup? selectedLookup, string? value, bool matchByCode)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _coverageForm.CovCode = string.Empty;
            _coverageForm.CovName = string.Empty;
            _coverageForm.CoverageTypeId = null;
            NotifyCoverageLookupFieldsChanged();
            return;
        }

        var lookup = selectedLookup ?? (matchByCode
            ? CoverageLookupOptions.FirstOrDefault(x => string.Equals(x.CovCode, value, StringComparison.OrdinalIgnoreCase))
            : CoverageLookupOptions.FirstOrDefault(x => string.Equals(x.CovName, value, StringComparison.OrdinalIgnoreCase)));

        if (lookup is null)
        {
            return;
        }

        _coverageForm.CovCode = lookup.CovCode;
        _coverageForm.CovName = lookup.CovName;
        _coverageForm.CoverageTypeId = lookup.CoverageTypeId;

        if (!string.IsNullOrWhiteSpace(lookup.LineOfBusinessCode))
        {
            _coverageForm.LineOfBusinessCode = lookup.LineOfBusinessCode;
        }

        ApplyCoverageTemplateDefaults(lookup.CovCode);
        NotifyCoverageLookupFieldsChanged();
    }

    private void NotifyCoverageLookupFieldsChanged()
    {
        _coverageEditContext.NotifyFieldChanged(new FieldIdentifier(_coverageForm, nameof(CoverageForm.CovCode)));
        _coverageEditContext.NotifyFieldChanged(new FieldIdentifier(_coverageForm, nameof(CoverageForm.CovName)));
        _coverageEditContext.NotifyFieldChanged(new FieldIdentifier(_coverageForm, nameof(CoverageForm.LineOfBusinessCode)));
    }

