    private sealed class CoverageFieldForm
    {
        public Guid? FieldId { get; set; }
        [Required, StringLength(50)]
        public string FieldGroupCode { get; set; } = string.Empty;
        [Required, StringLength(80)]
        public string FieldCode { get; set; } = string.Empty;
        [Required, StringLength(160)]
        public string FieldLabel { get; set; } = string.Empty;
        [Required, StringLength(1000)]
        public string FieldValue { get; set; } = string.Empty;
        [Required, StringLength(50)]
        public string FieldValueTypeCode { get; set; } = "Text";
        [StringLength(40)]
        public string UnitOfMeasureCode { get; set; } = string.Empty;
        public bool IsRequired { get; set; }
        public bool IsRatingField { get; set; }
        public bool IsScheduleField { get; set; }
        [Range(0, 10000)]
        public int SortOrder { get; set; }

        public static CoverageFieldForm FromField(PolicyCoverageDetailFieldDto field) => new()
        {
            FieldId = field.FieldId,
            FieldGroupCode = field.FieldGroupCode,
            FieldCode = field.FieldCode,
            FieldLabel = field.FieldLabel,
            FieldValue = field.FieldValue,
            FieldValueTypeCode = string.IsNullOrWhiteSpace(field.FieldValueTypeCode) ? "Text" : field.FieldValueTypeCode,
            UnitOfMeasureCode = field.UnitOfMeasureCode,
            IsRequired = field.IsRequired,
            IsRatingField = field.IsRatingField,
            IsScheduleField = field.IsScheduleField,
            SortOrder = field.SortOrder,
        };

        public static CoverageFieldForm FromTemplate(PolicyCoverageDetailTemplateFieldDto field) => new()
        {
            FieldGroupCode = field.FieldGroupCode,
            FieldCode = field.FieldCode,
            FieldLabel = field.FieldLabel,
            FieldValue = field.DefaultValue,
            FieldValueTypeCode = string.IsNullOrWhiteSpace(field.FieldValueTypeCode) ? "Text" : field.FieldValueTypeCode,
            UnitOfMeasureCode = field.UnitOfMeasureCode,
            IsRequired = field.IsRequired,
            IsRatingField = field.IsRatingField,
            IsScheduleField = field.IsScheduleField,
            SortOrder = field.SortOrder,
        };
    }

