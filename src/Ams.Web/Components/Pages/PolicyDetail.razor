    private async Task EmailInvoiceAsync()
    {
        if (_invoiceEmailInvoiceId == Guid.Empty || string.IsNullOrWhiteSpace(_invoiceEmailRecipient))
        {
            await ShowErrorToast("Select an invoice and enter a recipient email.");
            return;
        }

        _emailingInvoice = true;
        try
        {
            var result = await Api.EmailPolicyInvoiceAsync(PolicyId, _invoiceEmailInvoiceId, new EmailPolicyInvoiceRequest(_tenantId, _invoiceEmailRecipient.Trim(), null));
            _showInvoiceEmail = false;
            _accounting = await Api.GetPolicyAccountingDashboardAsync(_tenantId, PolicyId);
            LoadAccountingRows();
            await ShowToast($"Invoice email {result?.StatusCode.ToLowerInvariant() ?? "queued"} for {_invoiceEmailRecipient.Trim()}.");
        }
        catch (Exception ex)
        {
            await ShowErrorToast($"Invoice email could not be queued: {ex.Message}");
        }
        finally
        {
            _emailingInvoice = false;
        }
    }

