    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        await Task.Delay(0);
        BuildStubData();
        _loading = false;
    }

    // ── Action handling ─────────────────────────────────────────────────────
    private void OpenAction(string action)
    {
        _activeAction    = action;
        _actionNote      = string.Empty;
        _actionReason    = string.Empty;
        _actionCertHolder = string.Empty;
        _actionCertAddr  = string.Empty;
        _actionPremDelta = 0m;
        _actionDate      = DateTime.Today;

        (_actionTitle, _actionDesc, _actionIcon) = action switch
        {
            "endorse"     => ("Endorse Policy",      $"Create an endorsement on policy {_policy?.PolicyNumber}.",           "bi-pen"),
            "remarket"    => ("Remarket Policy",     $"Start a remarket submission for {_policy?.PolicyNumber}.",           "bi-arrow-left-right"),
            "rewrite"     => ("Rewrite Policy",      $"Rewrite policy {_policy?.PolicyNumber} with a new carrier or terms.","bi-arrow-repeat"),
            "cancel"      => ("Cancel Policy",       $"Cancel policy {_policy?.PolicyNumber}. This action cannot be undone.","bi-x-circle"),
            "reinstate"   => ("Reinstate Policy",    $"Reinstate cancelled policy {_policy?.PolicyNumber}.",                "bi-shield-check"),
            "certificate" => ("Issue Certificate",   $"Generate an ACORD certificate for {_policy?.PolicyNumber}.",         "bi-award"),
            "esign"       => ("Request E-Signature", $"Send a document for electronic signature.",                          "bi-pen-fill"),
            "message"     => ("Send Message",        $"Send a message related to policy {_policy?.PolicyNumber}.",          "bi-chat"),
            _             => (action, string.Empty, "bi-lightning"),
        };
        _showActionDlg = true;
    }

    private async Task ExecuteActionAsync()
    {
        if (_policy is null) return;
        switch (_activeAction)
        {
            case "cancel":
                _policy.Status     = "Cancelled";
                _policy.CancelDate = _actionDate;
                AddAuditEntry("Policy Cancelled", "Status", "Active", "Cancelled");
                break;
            case "reinstate":
                _policy.Status        = "Active";
                _policy.ReinstateDate = _actionDate;
                AddAuditEntry("Policy Reinstated", "Status", "Cancelled", "Active");
                break;
            case "endorse":
                _endorsements.Insert(0, new EndorsementRow
                {
                    EndNum = $"END-{_endorsements.Count + 1:000}",
                    EffDate = _actionDate, Type = "Change Endorsement",
                    Description = string.IsNullOrWhiteSpace(_actionNote) ? "Policy endorsement" : _actionNote,
                    PremChange = _actionPremDelta, Status = "Issued", IssuedBy = "System User",
                });
                AddAuditEntry("Endorsement Issued", "Endorsement", "—", $"END-{_endorsements.Count:000}");
                break;
        }
        _showActionDlg = false;
        await ShowToast($"{_actionTitle} — recorded successfully.");
    }

    private async Task SaveActivityAsync()
    {
        if (string.IsNullOrWhiteSpace(_actForm.Subject)) return;
        _activities.Insert(0, new ActivityRow
        {
            Subject = _actForm.Subject, Category = _actForm.Category,
            Channel = _actForm.Channel, Outcome = _actForm.Outcome,
            ActivityDate = _actForm.ActivityDate, Notes = _actForm.Notes, CreatedBy = "Current User",
        });
        _showActForm = false;
        await ShowToast("Activity logged.");
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_commForm.To)) return;
        _comms.Insert(0, new CommRow
        {
            SentAt = DateTime.Now, Channel = _commForm.Channel, Direction = "Outbound",
            Subject = _commForm.Subject, From = "Agency", To = _commForm.To, Status = "Sent",
        });
        _showCommForm = false;
        await ShowToast("Message sent.");
    }

    private void AddAuditEntry(string action, string field, string oldVal, string newVal)
