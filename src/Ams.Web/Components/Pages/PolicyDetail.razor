    private void AddEndorsement(string type, string description, decimal premiumChange, DateTime effectiveDate, string status = "Issued")
    {
        if (_policy is not null && status == "Issued" && premiumChange != 0m)
        {
            _policy.WrittenPremium += premiumChange;
            _policy.AnnualPremium += premiumChange;
            _policy.BalanceDue += Math.Round(premiumChange / 10m, 2);
        }

        var nextNumber = $"END-{_endorsements.Count + 1:000}";
        _endorsements.Insert(0, new EndorsementRow
        {
            EndNum = nextNumber,
            EffDate = effectiveDate,
            Type = type,
            Description = description,
            PremChange = premiumChange,
            Status = status,
            IssuedBy = "Current User",
        });
        _activities.Insert(0, NewActivity($"{type}: {nextNumber}", "Endorsement", "Portal", status == "Issued" ? "Completed" : "Pending", description));
        AddAuditEntry(status == "Issued" ? "Endorsement Issued" : "Endorsement Started", "Endorsement", "—", nextNumber);
    }

