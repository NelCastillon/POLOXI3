    private static PolicyRecord MapPolicyRecord(PolicyRegisterDto row)
    {
        var termMonths = Math.Max(1, ((row.ExpirationDate.Year - row.EffectiveDate.Year) * 12) + row.ExpirationDate.Month - row.EffectiveDate.Month);
        return new PolicyRecord
        {
            PolicyNumber = row.PolicyNumber,
            Account = row.AccountName,
            AccountId = row.AccountId,
            Carrier = row.CarrierName,
            Lob = row.LineOfBusiness,
            Status = row.Status,
            PolicyType = row.LineOfBusiness,
            Program = row.LineOfBusiness,
            IsPackage = row.LineOfBusiness.Contains("Package", StringComparison.OrdinalIgnoreCase),
            EffDate = row.EffectiveDate,
            ExpDate = row.ExpirationDate,
            IssueDate = row.BoundDateUtc,
            BindDate = row.BoundDateUtc,
            TermMonths = termMonths,
            WrittenPremium = row.WrittenPremium,
            AnnualPremium = row.AnnualPremium,
            AgencyFee = 0m,
            TaxesFees = 0m,
            BalanceDue = 0m,
            BillingPlan = "Agency Bill",
            PaymentMethod = "Account billing",
            PrimaryInsured = row.AccountName,
            InsuredType = row.AccountType,
            Producer = row.ProducerName,
            Csr = row.CsrName,
            Branch = row.Branch,
            AccountManager = row.AssignedToUserName,
            Source = "Bound policy workflow",
            SubmissionRef = row.SubmissionId == Guid.Empty ? null : row.SubmissionId.ToString(),
            QuoteNumber = row.QuoteId == Guid.Empty ? null : row.QuoteId.ToString(),
            CreatedBy = row.AssignedToUserName ?? row.ProducerName,
            CreatedAt = row.BoundDateUtc,
            OpenClaims = 0,
        };
    }

    private static DocRow MapEnterpriseDocumentRow(DocumentDto document) => new()
    {
        DocumentId = document.DocumentId,
        HasStoredContent = true,
        Name = document.FileName,
        Category = document.CategoryCode,
        FileType = Path.GetExtension(document.FileName).TrimStart('.').ToUpperInvariant() is { Length: > 0 } extension ? extension : "Record",
        FileSize = FormatDocumentSize(document.FileSizeBytes),
        UploadedAt = document.CreatedDateUtc,
        UploadedBy = document.UploadedByName ?? "System"
    };

    private static string FormatDocumentSize(long? bytes) => bytes switch
    {
        null => "Unknown size",
        < 1024 => $"{bytes} B",
        < 1_048_576 => $"{bytes / 1024d:F1} KB",
        _ => $"{bytes / 1_048_576d:F1} MB"
    };

