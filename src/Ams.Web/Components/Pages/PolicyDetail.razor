    private async Task LoadCoverageLookupsAsync()
    {
        try
        {
            var result = await Api.SearchCoverageTypesAsync(_tenantId, null, pageSize: 500);
            _coverageTemplates = (await Api.GetPolicyCoverageDetailTemplatesAsync(_tenantId) ?? [])
                .OrderBy(x => x.SortOrder)
                .ThenBy(x => x.CoverageName)
                .ToList();

            _coverageLookups = (result?.Items ?? [])
                .Where(x => x.IsActive)
                .OrderBy(x => x.SortOrder)
                .ThenBy(x => x.CoverageName)
                .Select(x => new CoverageLookup(
                    x.CoverageCode,
                    x.CoverageName,
                    x.CoverageTypeId,
                    x.LobCode ?? _coverageTemplates.FirstOrDefault(t => string.Equals(t.CoverageCode, x.CoverageCode, StringComparison.OrdinalIgnoreCase))?.LineOfBusinessCode ?? string.Empty))
                .DistinctBy(x => x.CovCode)
                .ToList();

            foreach (var template in _coverageTemplates.Where(template => !_coverageLookups.Any(x => string.Equals(x.CovCode, template.CoverageCode, StringComparison.OrdinalIgnoreCase))))
            {
                _coverageLookups.Add(new CoverageLookup(template.CoverageCode, template.CoverageName, template.CoverageTypeId, template.LineOfBusinessCode));
            }
        }
        catch (Exception ex)
        {
            _coverageLookups = [];
            await ShowErrorToast($"Coverage lookup load failed: {ex.Message}");
        }

    }

