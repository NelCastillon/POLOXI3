    private IEnumerable<PdLv> EndorsementOptionValues(string groupCode)
    {
        var options = _endorsementOptions
            .Where(x => string.Equals(x.OptionGroupCode, groupCode, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.SortOrder)
            .ThenBy(x => x.DisplayName)
            .Select(x => new PdLv(x.OptionCode, x.DisplayName))
            .ToList();

        if (options.Count == 0 && !string.IsNullOrWhiteSpace(_actionForm.GetOptionValue(groupCode)))
        {
            var value = _actionForm.GetOptionValue(groupCode)!;
            options.Add(new PdLv(value, value));
        }

        return options;
    }

    private string DefaultEndorsementOption(string groupCode)
        => _endorsementOptions
            .Where(x => string.Equals(x.OptionGroupCode, groupCode, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.IsDefault)
            .ThenBy(x => x.SortOrder)
            .Select(x => x.OptionCode)
            .FirstOrDefault() ?? string.Empty;

    private IEnumerable<PdLv> DistinctOptionValues(IEnumerable<string?> values)
        => values
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x)
            .Select(x => new PdLv(x, x));

