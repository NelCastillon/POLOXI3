        _loading = true;
        _loadError = null;
        StateHasChanged();
        try
        {
            await Task.Delay(0);
            BuildStubData();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load policy detail: {ex.Message}";
            await ShowErrorToast($"Load failed: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

