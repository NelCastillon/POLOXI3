    private async Task<Guid> EnsureCommissionLedgerExistsAsync(CommissionRow commission)
    {
        if (commission.CommissionId.HasValue && commission.CommissionId.Value != Guid.Empty)
            return commission.CommissionId.Value;

        var commissionId = await Api.CreateCommissionLedgerAsync(BuildCommissionLedgerRequest(commission));
        await LoadPolicyCommissionsAsync();
        return commissionId;
    }

    private CreateCommissionLedgerRequest BuildCommissionLedgerRequest(CommissionRow commission)
    {
        var rate = commission.CommPct * 100m;
        return new CreateCommissionLedgerRequest
        {
            TenantId = _tenantId,
            PolicyNumber = FirstNonEmpty(commission.PolicyNumber, _policy?.PolicyNumber) ?? string.Empty,
            Period = commission.Period,
            BusinessType = commission.Type,
            Producer = commission.Producer,
            AccountName = FirstNonEmpty(commission.AccountName, _policy?.Account) ?? string.Empty,
            LineOfBusiness = FirstNonEmpty(commission.LineOfBusiness, _policy?.Lob) ?? string.Empty,
            Carrier = FirstNonEmpty(commission.Carrier, _policy?.Carrier) ?? string.Empty,
            GrossAmount = commission.GrossAmt,
            CommissionPct = rate,
            AgencyAmount = commission.AgencyAmt,
            ProducerAmount = commission.ProducerAmt,
            Status = FirstNonEmpty(commission.Status, "Pending") ?? "Pending",
            StatementNumber = commission.StatementNumber,
            PayoutBatch = commission.PayoutBatch,
            TransactionDate = DateOnly.FromDateTime(commission.TransactionDate == default ? DateTime.Today : commission.TransactionDate),
            PaidDate = commission.PaidDate.HasValue ? DateOnly.FromDateTime(commission.PaidDate.Value) : null,
            CreatedByUserId = _currentUserId,
        };
    }

    private string DetailUrl(object? item) => item switch
    {
        CoverageRow c => c.CoverageDetailId == Guid.Empty ? string.Empty : $"/policies/{PolicyId}/coverages/{c.CoverageDetailId}",
        RiskItem r => r.ItemType.Equals("Location", StringComparison.OrdinalIgnoreCase)
            ? $"/policies/{PolicyId}/locations?item={Uri.EscapeDataString(r.Description)}"
            : $"/policies/{PolicyId}/risk-items?item={Uri.EscapeDataString(r.Description)}",
        DriverRow d => $"/policies/{PolicyId}/drivers?license={Uri.EscapeDataString(d.LicenseNum)}",
        LocationRow l => $"/policies/{PolicyId}/locations?location={l.LocNumber}",
        DocRow d => d.DocumentId.HasValue ? $"/documents/{d.DocumentId.Value}" : "/documents",
        ActivityRow a => $"/policies/{PolicyId}/activity?subject={Uri.EscapeDataString(a.Subject)}",
        CommRow c => c.ThreadId is not null ? $"/communications/thread/{c.ThreadId}" : "/communications/inbox",
        InvoiceRow i => $"/billing/invoices?invoice={Uri.EscapeDataString(i.InvoiceNum)}",
        ClaimRow c => c.ClaimId.HasValue ? $"/claims/{c.ClaimId.Value}" : "/claims",
        EndorsementRow e => $"/policies/endorsements?endorsement={Uri.EscapeDataString(e.EndNum)}",
        CommissionRow c => c.CommissionId.HasValue ? $"/commissions/{c.CommissionId.Value}" : string.Empty,
        CertificateRow c => $"/policies/certificates?certificate={Uri.EscapeDataString(c.CertificateNum)}",
        ComplianceRow c => c.ComplianceDocumentId.HasValue ? $"/policies/compliance/{c.ComplianceDocumentId.Value}" : $"/policies/compliance?requirement={Uri.EscapeDataString(c.Requirement)}",
        ServiceTaskRow t => $"/tasks?task={Uri.EscapeDataString(t.TaskNumber)}",
        SubmissionLinkRow s => $"/submissions/{s.SubmissionId}",
        CarrierUwRow c => c.Type switch
        {
            "Contact" => $"/admin/reference/carriers?carrier={Uri.EscapeDataString(_policy?.Carrier ?? string.Empty)}",
            "Appointment" => "/integrations/carriers",
            "Appetite" => $"/admin/reference/carrier-appetite?carrier={Uri.EscapeDataString(_policy?.Carrier ?? string.Empty)}",
            "Download" => "/admin/reference/download-mappings",
            _ => $"/admin/reference/carriers?carrier={Uri.EscapeDataString(_policy?.Carrier ?? string.Empty)}",
        },
