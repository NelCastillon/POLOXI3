    private async Task ExecuteActionAsync()
    {
        if (_policy is null) return;
        var refreshLifecycleData = _activeAction is "cancel" or "reinstate" or "bindRenewal";
        _actionDate = _actionForm.ActionDate;
        _actionReason = _actionForm.Reason ?? string.Empty;
        _actionCertHolder = _actionForm.PartyName ?? string.Empty;
        _actionCertAddr = _actionForm.PartyAddress ?? string.Empty;
        _actionPremDelta = _actionForm.PremiumDelta;
        _actionNote = _actionForm.Note ?? string.Empty;
        var toastMessage = $"{_actionTitle} ? recorded successfully.";
        switch (_activeAction)
        {
            case "cancel":
                if (string.IsNullOrWhiteSpace(_actionReason))
                {
                    await ShowErrorToast("Cancellation reason is required.");
                    return;
                }
                await CreateLifecycleTransactionAsync("Cancellation", "Issued", _actionReason, _actionNote, _policy.WrittenPremium, -_policy.WrittenPremium, 0m);
                _policy.Status     = "Cancelled";
                _policy.CancelDate = _actionDate;
                break;
            case "reinstate":
                await CreateLifecycleTransactionAsync("Reinstatement", "Issued", _actionReason, _actionNote, 0m, _policy.WrittenPremium, _policy.WrittenPremium);
                _policy.Status        = "Active";
                _policy.ReinstateDate = _actionDate;
                break;
            case "remarket":
                var remarketCase = await EnsureRenewalCaseAsync();
                await Api.LaunchRenewalPlacementAsync(remarketCase.RetentionCaseId, new LaunchRenewalPlacementRequest(_tenantId, _currentUserId));
                refreshLifecycleData = true;
                toastMessage = "Renewal placement launched.";
                break;
            case "bindRenewal":
                var renewalCase = await EnsureRenewalCaseAsync();
                var renewedPremium = renewalCase.ProposedPremium ?? _policy.WrittenPremium;
                await CreateLifecycleTransactionAsync("Renewal", "PendingReview", "Renewal", _actionNote, _policy.WrittenPremium, renewedPremium - _policy.WrittenPremium, renewedPremium);
                refreshLifecycleData = true;
                toastMessage = "Renewal transaction submitted for review.";
                break;
            case "certificate":
                if (string.IsNullOrWhiteSpace(_actionCertHolder))
                {
                    await ShowErrorToast("Certificate holder name is required.");
                    return;
                }
                await Api.CreatePolicyCertificateAsync(new CreatePolicyCertificateRequest(
                    _tenantId, PolicyId, _policy.PolicyNumber, _policy.Account, _actionCertHolder, _actionCertAddr,
                    string.IsNullOrWhiteSpace(_actionReason) ? _certTypeOpts.FirstOrDefault()?.Value ?? "ACORD25" : _actionReason,
                    _actionDate, _policy.ExpDate, _policy.Lob, _policy.Csr, "Issued", false, false,
                    _actionNote, null, false, null, _currentUserId));
                refreshLifecycleData = true;
                toastMessage = "Certificate record issued and synchronized.";
                break;
            case "esign":
                if (string.IsNullOrWhiteSpace(_actionCertHolder) || string.IsNullOrWhiteSpace(_actionCertAddr))
                {
                    await ShowErrorToast("Signer name and email are required.");
                    return;
                }
                await Api.SendPolicyCommunicationAsync(new SendPolicyCommunicationRequest
                {
                    TenantId = _tenantId, PolicyId = PolicyId, ChannelCode = "Email", Recipient = _actionCertAddr,
                    Subject = "E-signature request", Body = string.IsNullOrWhiteSpace(_actionNote) ? $"Electronic signature requested from {_actionCertHolder}." : _actionNote
                });
                refreshLifecycleData = true;
                toastMessage = "E-signature communication queued.";
                break;
            case "message":
                if (string.IsNullOrWhiteSpace(_actionCertHolder))
                {
                    await ShowErrorToast("Recipient is required.");
                    return;
                }
                await Api.SendPolicyCommunicationAsync(new SendPolicyCommunicationRequest
                {
                    TenantId = _tenantId, PolicyId = PolicyId,
                    ChannelCode = string.IsNullOrWhiteSpace(_actionReason) ? "Email" : _actionReason,
                    Recipient = _actionCertHolder,
                    Subject = string.IsNullOrWhiteSpace(_actionCertAddr) ? $"Policy {_policy.PolicyNumber}" : _actionCertAddr,
                    Body = string.IsNullOrWhiteSpace(_actionNote) ? $"Communication regarding policy {_policy.PolicyNumber}." : _actionNote
                });
                refreshLifecycleData = true;
                toastMessage = "Policy communication queued.";
                break;
        }
        _showActionDlg = false;
        if (refreshLifecycleData)
        {
            await LoadAsync();
        }
        await ShowToast(toastMessage);
    }

    private async Task<Guid> CreateLifecycleTransactionAsync(string transactionTypeCode, string transactionStatusCode, string? reasonCode, string? notes, decimal priorPremium, decimal premiumChange, decimal newPremium)
    {
        if (_policy is null)
        {
            throw new InvalidOperationException("A policy must be loaded before creating a lifecycle transaction.");
        }

        var request = new CreatePolicyLifecycleTransactionRequest
        {
            TenantId = _tenantId,
            PolicyId = PolicyId,
            TransactionTypeCode = transactionTypeCode,
            TransactionStatusCode = transactionStatusCode,
            EffectiveDate = DateOnly.FromDateTime(_actionDate),
            ExpirationDate = transactionTypeCode.Equals("Renewal", StringComparison.OrdinalIgnoreCase) ? DateOnly.FromDateTime(_policy.ExpDate) : null,
            PriorWrittenPremium = priorPremium,
            PremiumChange = premiumChange,
            NewWrittenPremium = newPremium,
            TotalCostChange = premiumChange,
            ReasonCode = string.IsNullOrWhiteSpace(reasonCode) ? transactionTypeCode : reasonCode,
            SourceCode = "PolicyDetail",
            Description = $"{transactionTypeCode} for {_policy.PolicyNumber}",
            Notes = notes,
            RequestedByUserId = await GetCurrentUserIdAsync()
        };

        if (!string.IsNullOrWhiteSpace(_policy.Lob))
        {
            request.LineChanges.Add(new PolicyLifecycleLineChangeRequest
            {
                LineOfBusinessCode = _policy.Lob,
                LineOfBusinessName = _policy.Lob,
                ChangeTypeCode = transactionTypeCode.Equals("Cancellation", StringComparison.OrdinalIgnoreCase) ? "RemoveLine" : "UpdateLine",
                PriorPremium = priorPremium,
                PremiumChange = premiumChange,
                NewPremium = newPremium
            });
        }

        return await Api.CreatePolicyLifecycleTransactionAsync(request);
    }

    private async Task<RenewalRetentionCaseDto> EnsureRenewalCaseAsync()
    {
        if (_policy is null) throw new InvalidOperationException("A policy must be loaded before starting renewal servicing.");
        var center = await Api.GetRenewalRetentionCenterAsync(_tenantId);
        var existing = center?.Cases.FirstOrDefault(x => x.PolicyId == PolicyId);
        if (existing is not null) return existing;

        var retentionCaseId = await Api.CreateRenewalRetentionCaseAsync(new CreateRenewalRetentionCaseRequest
        {
            TenantId = _tenantId, PolicyId = PolicyId, AccountId = _policy.AccountId,
            AccountName = _policy.Account, PolicyNumber = _policy.PolicyNumber, LineOfBusiness = _policy.Lob,
            Carrier = _policy.Carrier, Producer = _policy.Producer, Csr = _policy.Csr,
            ExpirationDate = _policy.ExpDate, CurrentPremium = _policy.WrittenPremium,
            Stage = "Intake", Priority = "Normal", OutreachStatus = "Not Started", Sentiment = "Neutral",
            AssignedToName = _policy.Csr, CreatedByUserId = _currentUserId
        });
        center = await Api.GetRenewalRetentionCenterAsync(_tenantId);
        return center?.Cases.FirstOrDefault(x => x.RetentionCaseId == retentionCaseId)
            ?? throw new InvalidOperationException("The renewal case was created but could not be reloaded.");
    }

