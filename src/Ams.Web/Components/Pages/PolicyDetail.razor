    private static List<ActivityRow> BuildActivityRows(IReadOnlyList<PolicyCancellationDto> cancellations, IReadOnlyList<PolicyCancellationActivityDto> cancellationActivities, IReadOnlyList<PolicyEndorsementDto> endorsements)
    {
        var activities = new List<ActivityRow>();
        activities.AddRange(endorsements.Select(e => new ActivityRow { Subject = $"Endorsement {e.EndorsementNumber}", Category = "Endorsement", Channel = "Workflow", Outcome = e.Status, ActivityDate = e.RequestedDateUtc.ToLocalTime(), Notes = e.Description, CreatedBy = e.RequestedByName }));
        activities.AddRange(cancellations.Select(c => new ActivityRow { Subject = $"{c.RequestType} {c.CancellationNumber}", Category = "Cancellation", Channel = "Workflow", Outcome = c.Status, ActivityDate = c.RequestDateUtc.ToLocalTime(), Notes = c.Notes, CreatedBy = c.RequestedByName }));
        activities.AddRange(cancellationActivities.Select(a => new ActivityRow { Subject = a.Subject, Category = a.ActivityType, Channel = "Workflow", Outcome = "Completed", ActivityDate = a.ActivityDateUtc.ToLocalTime(), Notes = a.Notes, CreatedBy = a.CreatedByName }));
        return activities.OrderByDescending(x => x.ActivityDate).ToList();
    }

