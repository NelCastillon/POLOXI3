    private static string NextPolicyNumber(string policyNumber)
    {
        var match = System.Text.RegularExpressions.Regex.Match(policyNumber, @"^(.*?)(\d{4})(.*)$");
        return match.Success
            ? $"{match.Groups[1].Value}{int.Parse(match.Groups[2].Value) + 1:0000}{match.Groups[3].Value}"
            : $"{policyNumber}-R";
    }

