@page "/policies/{PolicyId:guid}"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@(_policy is null ? "Policy" : _policy.PolicyNumber) — Policy Detail</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@if (_loading)
{
    <div class="pd-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading policy…</span></div>
}
else if (_policy is null)
{
    <div class="pd-not-found">
        <i class="bi bi-shield-x pd-nf-icon" aria-hidden="true"></i>
        <h2>Policy not found</h2>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/policies")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Policies
        </button>
    </div>
}
else
{
    <!-- ── HEADER ───────────────────────────────────────────────────────── -->
    <div class="pd-header">
        <div class="pd-header-left">
            <div class="pd-lob-icon pd-lob-@LobKey(_policy.Lob)">
                <i class="bi @LobIcon(_policy.Lob)" aria-hidden="true"></i>
            </div>
            <div class="pd-header-info">
                <div class="pd-title-row">
                    <h1 class="pd-pol-num">@_policy.PolicyNumber</h1>
                    <span class="pd-status pd-status-@_policy.Status.ToLower()">@_policy.Status</span>
                    <span class="pd-lob-badge pd-lob-@LobKey(_policy.Lob)">@_policy.Lob</span>
                </div>
                <div class="pd-sub-row">
                    <button class="pd-acct-link" @onclick='() => Nav.NavigateTo($"/accounts/{_policy.AccountId}")'>
                        <i class="bi bi-building" aria-hidden="true"></i>@_policy.Account
                    </button>
                    <span class="pd-sub-chip"><i class="bi bi-building-fill" aria-hidden="true"></i>@_policy.Carrier</span>
                    <span class="pd-sub-chip"><i class="bi bi-calendar" aria-hidden="true"></i>@_policy.EffDate.ToString("MM/dd/yyyy") – @_policy.ExpDate.ToString("MM/dd/yyyy")</span>
                    <span class="pd-sub-chip @ExpChipCss(_policy.ExpDate)">
                        <i class="bi bi-clock" aria-hidden="true"></i>
                        @DaysLabel(_policy.ExpDate)
                    </span>
                </div>
            </div>
        </div>
        <div class="pd-header-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("endorse")'>
                <i class="bi bi-pen" aria-hidden="true"></i> Endorse
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("remarket")'>
                <i class="bi bi-arrow-left-right" aria-hidden="true"></i> Remarket
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("rewrite")'>
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Rewrite
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("certificate")'>
                <i class="bi bi-award" aria-hidden="true"></i> Issue Cert
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("esign")'>
                <i class="bi bi-pen-fill" aria-hidden="true"></i> E-Sign
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("message")'>
                <i class="bi bi-chat" aria-hidden="true"></i> Message
            </button>
            @if (_policy.Status == "Cancelled")
            {
                <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => OpenAction("reinstate")'>
                    <i class="bi bi-shield-check" aria-hidden="true"></i> Reinstate
                </button>
            }
            else
            {
                <button class="um-btn um-btn-danger um-btn-sm" @onclick='() => OpenAction("cancel")'>
                    <i class="bi bi-x-circle" aria-hidden="true"></i> Cancel
                </button>
            }
        </div>
    </div>

    <!-- ── KPI BAR ───────────────────────────────────────────────────────── -->
    <div class="pd-kpi-bar">
        @PdKpi("Written Premium",   _policy.WrittenPremium.ToString("C0"),  "bi-cash-stack",       "pd-ki--blue")
        @PdKpi("Annual Premium",    _policy.AnnualPremium.ToString("C0"),   "bi-calendar-check",   "pd-ki--blue")
        @PdKpi("Balance Due",       _policy.BalanceDue.ToString("C0"),      "bi-receipt",          _policy.BalanceDue > 0 ? "pd-ki--red" : "pd-ki--green")
        @PdKpi("Open Claims",       _policy.OpenClaims.ToString(),          "bi-exclamation-circle", _policy.OpenClaims > 0 ? "pd-ki--amber" : "pd-ki--green")
        @PdKpi("Endorsements",      _endorsements.Count.ToString(),         "bi-pen",              "pd-ki--gray")
        @PdKpi("YTD Commission",    _commissions.Sum(c => c.AgencyAmt).ToString("C0"), "bi-percent", "pd-ki--purple")
        @PdKpi("Producer",          _policy.Producer,                       "bi-person-badge",     "pd-ki--gray")
        @PdKpi("CSR",               _policy.Csr,                            "bi-headset",          "pd-ki--gray")
    </div>

    <!-- ── 13-TAB BODY ──────────────────────────────────────────────────── -->
    <AppDetailTabs SelectedTab="_tab" SelectedTabChanged="t => _tab = t">
        <Tabs>

            <!-- 0 ── SUMMARY ─────────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Summary" IconCss="bi bi-clipboard-data" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="pd-summary-grid">

                            <div class="pd-info-card">
                                <h3 class="pd-card-hdr">Policy Identity</h3>
                                <div class="pd-field-grid">
                                    @F("Policy Number",   _policy.PolicyNumber)
                                    @F("Line of Business",_policy.Lob)
                                    @F("Carrier",         _policy.Carrier)
                                    @F("Program",         _policy.Program)
                                    @F("Status",          _policy.Status)
                                    @F("Policy Type",     _policy.PolicyType)
                                    @F("Package",         _policy.IsPackage ? "Yes" : "No")
                                    @F("Master Policy",   _policy.MasterPolicy ?? "—")
                                </div>
                            </div>

                            <div class="pd-info-card">
                                <h3 class="pd-card-hdr">Dates &amp; Term</h3>
                                <div class="pd-field-grid">
                                    @F("Effective Date",   _policy.EffDate.ToString("MM/dd/yyyy"))
                                    @F("Expiration Date",  _policy.ExpDate.ToString("MM/dd/yyyy"))
                                    @F("Issue Date",       _policy.IssueDate?.ToString("MM/dd/yyyy") ?? "—")
                                    @F("Bind Date",        _policy.BindDate?.ToString("MM/dd/yyyy") ?? "—")
                                    @F("Cancel Date",      _policy.CancelDate?.ToString("MM/dd/yyyy") ?? "—")
                                    @F("Reinstate Date",   _policy.ReinstateDate?.ToString("MM/dd/yyyy") ?? "—")
                                    @F("Days to Expiry",   DaysLabel(_policy.ExpDate))
                                    @F("Term (months)",    _policy.TermMonths.ToString())
                                </div>
                            </div>

                            <div class="pd-info-card">
                                <h3 class="pd-card-hdr">Premium &amp; Billing</h3>
                                <div class="pd-field-grid">
                                    @F("Written Premium",  _policy.WrittenPremium.ToString("C2"))
                                    @F("Annual Premium",   _policy.AnnualPremium.ToString("C2"))
                                    @F("Agency Fee",       _policy.AgencyFee.ToString("C2"))
                                    @F("Taxes &amp; Fees", _policy.TaxesFees.ToString("C2"))
                                    @F("Total Cost",       (_policy.WrittenPremium + _policy.AgencyFee + _policy.TaxesFees).ToString("C2"))
                                    @F("Balance Due",      _policy.BalanceDue.ToString("C2"))
                                    @F("Billing Plan",     _policy.BillingPlan)
                                    @F("Payment Method",   _policy.PaymentMethod)
                                </div>
                            </div>

                            <div class="pd-info-card">
                                <h3 class="pd-card-hdr">Named Insured</h3>
                                <div class="pd-field-grid">
                                    @F("Primary Insured",  _policy.PrimaryInsured)
                                    @F("Insured Type",     _policy.InsuredType)
                                    @F("Address",          _policy.InsuredAddress)
                                    @F("City / State",     $"{_policy.InsuredCity}, {_policy.InsuredState} {_policy.InsuredZip}")
                                    @F("FEIN / SSN",       _policy.InsuredTaxId ?? "—")
                                    @F("DBA",              _policy.InsuredDba ?? "—")
                                    @F("Entity Type",      _policy.EntityType ?? "—")
                                    @F("SIC Code",         _policy.SicCode ?? "—")
                                </div>
                            </div>

                            <div class="pd-info-card">
                                <h3 class="pd-card-hdr">Service Assignment</h3>
                                <div class="pd-field-grid">
                                    @F("Producer",         _policy.Producer)
                                    @F("CSR",              _policy.Csr)
                                    @F("Branch",           _policy.Branch)
                                    @F("Account Manager",  _policy.AccountManager ?? "—")
                                    @F("Underwriter",      _policy.Underwriter ?? "—")
                                    @F("UW Contact Email", _policy.UwEmail ?? "—")
                                    @F("UW Phone",         _policy.UwPhone ?? "—")
                                </div>
                            </div>

                            <div class="pd-info-card">
                                <h3 class="pd-card-hdr">Submission &amp; Source</h3>
                                <div class="pd-field-grid">
                                    @F("Source",           _policy.Source)
                                    @F("Sub Ref #",        _policy.SubmissionRef ?? "—")
                                    @F("Prior Carrier",    _policy.PriorCarrier ?? "—")
                                    @F("Prior Premium",    _policy.PriorPremium?.ToString("C0") ?? "—")
                                    @F("Quote #",          _policy.QuoteNumber ?? "—")
                                    @F("ACORD Form",       _policy.AcordForm ?? "—")
                                    @F("Created By",       _policy.CreatedBy)
                                    @F("Created",          _policy.CreatedAt.ToString("MM/dd/yyyy"))
                                </div>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 1 ── COVERAGES ───────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Coverages" IconCss="bi bi-shield-half" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_coverages.Count coverage(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => { _editCov = new(); _showCovForm = true; }">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Coverage
                            </button>
                        </div>
                        <SfGrid TValue="CoverageRow" DataSource="_coverages"
                                AllowSorting="true" EnableHover="true" RowHeight="50">
                            <GridColumns>
                                <GridColumn Field="@nameof(CoverageRow.CovCode)"    HeaderText="Code"         Width="110" />
                                <GridColumn Field="@nameof(CoverageRow.CovName)"    HeaderText="Coverage"     MinWidth="180" />
                                <GridColumn Field="@nameof(CoverageRow.CovType)"    HeaderText="Type"         Width="120">
                                    <Template>@{ var c = (CoverageRow)context; }<span class="pd-cov-type">@c.CovType</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CoverageRow.Limit)"      HeaderText="Limit"        Width="140" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (CoverageRow)context; }<span class="pd-mono">@(c.Limit.HasValue ? c.Limit.Value.ToString("C0") : "Occurrence")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CoverageRow.Deductible)" HeaderText="Deductible"   Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (CoverageRow)context; }<span class="pd-mono">@(c.Deductible.HasValue ? c.Deductible.Value.ToString("C0") : "—")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CoverageRow.Premium)"    HeaderText="Premium"      Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (CoverageRow)context; }<span class="pd-mono">@c.Premium.ToString("C2")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CoverageRow.Sublimit)"   HeaderText="Sub-Limit"    Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (CoverageRow)context; }<span class="pd-mono">@(c.Sublimit.HasValue ? c.Sublimit.Value.ToString("C0") : "—")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CoverageRow.IsIncluded)" HeaderText="Incl." Width="80">
                                    <Template>@{ var c = (CoverageRow)context; }<i class="bi @(c.IsIncluded ? "bi-check-circle-fill pd-chk-yes" : "bi-dash-circle pd-chk-no")" aria-hidden="true"></i></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CoverageRow.Notes)"      HeaderText="Notes"        MinWidth="160" />
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 2 ── RISK ITEMS ──────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Risk Items" IconCss="bi bi-boxes" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_riskItems.Count item(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => { _editRisk = new(); _showRiskForm = true; }">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Item
                            </button>
                        </div>
                        <SfGrid TValue="RiskItem" DataSource="_riskItems"
                                AllowSorting="true" AllowFiltering="true" EnableHover="true" RowHeight="50">
                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                            <GridColumns>
                                <GridColumn Field="@nameof(RiskItem.ItemType)"    HeaderText="Type"       Width="130">
                                    <Template>@{ var r = (RiskItem)context; }<span class="pd-risk-type">@r.ItemType</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(RiskItem.Description)" HeaderText="Description" MinWidth="200" />
                                <GridColumn Field="@nameof(RiskItem.Year)"        HeaderText="Year"        Width="80" />
                                <GridColumn Field="@nameof(RiskItem.Make)"        HeaderText="Make/Model"  Width="150" />
                                <GridColumn Field="@nameof(RiskItem.Vin)"         HeaderText="VIN / Serial" Width="165" />
                                <GridColumn Field="@nameof(RiskItem.Value)"       HeaderText="Value"       Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var r = (RiskItem)context; }<span class="pd-mono">@(r.Value.HasValue ? r.Value.Value.ToString("C0") : "—")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(RiskItem.Location)"    HeaderText="Location"    Width="150" />
                                <GridColumn Field="@nameof(RiskItem.IsActive)"    HeaderText="Active"      Width="80">
                                    <Template>@{ var r = (RiskItem)context; }<i class="bi @(r.IsActive ? "bi-check-circle-fill pd-chk-yes" : "bi-x-circle pd-chk-no")" aria-hidden="true"></i></Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 3 ── DRIVERS / LOCATIONS ─────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Drivers / Locations" IconCss="bi bi-geo-alt" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="pd-dl-tabs">
                            <button class="pd-dl-tab @(_dlTab=="drivers"?"pd-dl-tab--active":"")" @onclick='()=>_dlTab="drivers"'>
                                <i class="bi bi-person-badge" aria-hidden="true"></i> Drivers (@_drivers.Count)
                            </button>
                            <button class="pd-dl-tab @(_dlTab=="locations"?"pd-dl-tab--active":"")" @onclick='()=>_dlTab="locations"'>
                                <i class="bi bi-pin-map" aria-hidden="true"></i> Locations (@_locations.Count)
                            </button>
                        </div>

                        @if (_dlTab == "drivers")
                        {
                            <SfGrid TValue="DriverRow" DataSource="_drivers"
                                    AllowSorting="true" EnableHover="true" RowHeight="50">
                                <GridColumns>
                                    <GridColumn Field="@nameof(DriverRow.Name)"        HeaderText="Name"        MinWidth="160" />
                                    <GridColumn Field="@nameof(DriverRow.LicenseNum)"  HeaderText="License #"   Width="150" />
                                    <GridColumn Field="@nameof(DriverRow.State)"       HeaderText="State"       Width="80" />
                                    <GridColumn Field="@nameof(DriverRow.Dob)"         HeaderText="DOB"         Width="115">
                                        <Template>@{ var d = (DriverRow)context; }<span class="pd-mono">@d.Dob.ToString("MM/dd/yyyy")</span></Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(DriverRow.YearsExp)"    HeaderText="Exp (yrs)"   Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                                    <GridColumn Field="@nameof(DriverRow.Type)"        HeaderText="Driver Type" Width="140" />
                                    <GridColumn Field="@nameof(DriverRow.Violations)"  HeaderText="Violations"  Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                        <Template>@{ var d = (DriverRow)context; }
                                            <span class="@(d.Violations > 0 ? "pd-viol-warn" : "pd-mono")">@d.Violations</span>
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(DriverRow.IsExcluded)"  HeaderText="Excluded"    Width="100">
                                        <Template>@{ var d = (DriverRow)context; }<i class="bi @(d.IsExcluded ? "bi-x-circle pd-chk-no" : "bi-check-circle-fill pd-chk-yes")" aria-hidden="true"></i></Template>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        }
                        else
                        {
                            <SfGrid TValue="LocationRow" DataSource="_locations"
                                    AllowSorting="true" EnableHover="true" RowHeight="50">
                                <GridColumns>
                                    <GridColumn Field="@nameof(LocationRow.LocNumber)"  HeaderText="#"           Width="60" />
                                    <GridColumn Field="@nameof(LocationRow.Description)" HeaderText="Description" MinWidth="180" />
                                    <GridColumn Field="@nameof(LocationRow.Address)"    HeaderText="Address"     Width="200" />
                                    <GridColumn Field="@nameof(LocationRow.City)"       HeaderText="City"        Width="130" />
                                    <GridColumn Field="@nameof(LocationRow.State)"      HeaderText="ST"          Width="60" />
                                    <GridColumn Field="@nameof(LocationRow.Zip)"        HeaderText="ZIP"         Width="90" />
                                    <GridColumn Field="@nameof(LocationRow.Building)"   HeaderText="Bldg Value"  Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                        <Template>@{ var l = (LocationRow)context; }<span class="pd-mono">@(l.Building.HasValue ? l.Building.Value.ToString("C0") : "—")</span></Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(LocationRow.Contents)"   HeaderText="Contents"    Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                        <Template>@{ var l = (LocationRow)context; }<span class="pd-mono">@(l.Contents.HasValue ? l.Contents.Value.ToString("C0") : "—")</span></Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(LocationRow.IsPrimary)"  HeaderText="Primary"     Width="90">
                                        <Template>@{ var l = (LocationRow)context; }<i class="bi @(l.IsPrimary ? "bi-star-fill pd-star" : "bi-star")" aria-hidden="true"></i></Template>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 4 ── DOCUMENTS ───────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Documents" IconCss="bi bi-folder2" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_documents.Count document(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm">
                                <i class="bi bi-upload" aria-hidden="true"></i> Upload
                            </button>
                        </div>
                        <div class="pd-doc-grid">
                            @foreach (var doc in _documents)
                            {
                                <div class="pd-doc-card">
                                    <div class="pd-doc-icon pd-doc-@doc.FileType.ToLower()">
                                        <i class="bi @DocIcon(doc.FileType)" aria-hidden="true"></i>
                                    </div>
                                    <div class="pd-doc-info">
                                        <div class="pd-doc-name">@doc.Name</div>
                                        <div class="pd-doc-meta">@doc.Category · @doc.UploadedAt.ToString("MM/dd/yyyy") · @doc.FileSize</div>
                                        <div class="pd-doc-uploader">@doc.UploadedBy</div>
                                    </div>
                                    <div class="pd-doc-actions">
                                        <button class="um-btn um-btn-ghost um-btn-sm" title="Download"><i class="bi bi-download" aria-hidden="true"></i></button>
                                        <button class="um-btn um-btn-ghost um-btn-sm" title="Preview"><i class="bi bi-eye" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 5 ── ACTIVITIES ──────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Activities" IconCss="bi bi-lightning" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_activities.Count activity(ies)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => { _actForm = new(); _showActForm = true; }">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Log Activity
                            </button>
                        </div>
                        <div class="pd-timeline">
                            @foreach (var a in _activities.OrderByDescending(a => a.ActivityDate))
                            {
                                <div class="pd-tl-item">
                                    <div class="pd-tl-dot pd-tl-@a.Category.ToLower()">
                                        <i class="bi @ActivityIcon(a.Category)" aria-hidden="true"></i>
                                    </div>
                                    <div class="pd-tl-line"></div>
                                    <div class="pd-tl-body">
                                        <div class="pd-tl-header">
                                            <span class="pd-tl-title">@a.Subject</span>
                                            <span class="pd-tl-cat pd-cat-@a.Category.ToLower()">@a.Category</span>
                                            <span class="pd-tl-date">@a.ActivityDate.ToString("MM/dd/yyyy hh:mm tt")</span>
                                        </div>
                                        <div class="pd-tl-meta">
                                            <span>@a.Channel</span>
                                            <span>@a.Outcome</span>
                                            <span>by @a.CreatedBy</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(a.Notes))
                                        {
                                            <div class="pd-tl-notes">@a.Notes</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 6 ── COMMUNICATIONS ──────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Communications" IconCss="bi bi-envelope" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_comms.Count message(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => { _commForm = new(); _showCommForm = true; }">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> New Message
                            </button>
                        </div>
                        <SfGrid TValue="CommRow" DataSource="_comms"
                                AllowSorting="true" EnableHover="true" RowHeight="52">
                            <GridColumns>
                                <GridColumn Field="@nameof(CommRow.SentAt)"    HeaderText="Date"      Width="140">
                                    <Template>@{ var c = (CommRow)context; }<span class="pd-mono">@c.SentAt.ToString("MM/dd/yyyy")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CommRow.Channel)"   HeaderText="Channel"   Width="110">
                                    <Template>@{ var c = (CommRow)context; }<span class="pd-comm-chip pd-comm-@c.Channel.ToLower()">@c.Channel</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CommRow.Direction)" HeaderText="Dir."      Width="90">
                                    <Template>@{ var c = (CommRow)context; }
                                        <span class="pd-dir-chip @(c.Direction=="Inbound"?"pd-dir-in":"pd-dir-out")">@c.Direction</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CommRow.Subject)"   HeaderText="Subject"   MinWidth="200" />
                                <GridColumn Field="@nameof(CommRow.From)"      HeaderText="From"      Width="170" />
                                <GridColumn Field="@nameof(CommRow.To)"        HeaderText="To"        Width="170" />
                                <GridColumn Field="@nameof(CommRow.Status)"    HeaderText="Status"    Width="110">
                                    <Template>@{ var c = (CommRow)context; }<span class="pd-comm-status pd-cstat-@c.Status.ToLower()">@c.Status</span></Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 7 ── BILLING ─────────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Billing" IconCss="bi bi-receipt" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="pd-billing-summary">
                            <div class="pd-bill-kpi pd-bill-kpi--prem">
                                <div class="pd-bill-val">@_policy.WrittenPremium.ToString("C2")</div>
                                <div class="pd-bill-lbl">Total Billed</div>
                            </div>
                            <div class="pd-bill-kpi pd-bill-kpi--paid">
                                <div class="pd-bill-val">@_invoices.Where(i => i.Status == "Paid").Sum(i => i.Amount).ToString("C2")</div>
                                <div class="pd-bill-lbl">Total Paid</div>
                            </div>
                            <div class="pd-bill-kpi @(_policy.BalanceDue > 0 ? "pd-bill-kpi--due" : "pd-bill-kpi--ok")">
                                <div class="pd-bill-val">@_policy.BalanceDue.ToString("C2")</div>
                                <div class="pd-bill-lbl">Balance Due</div>
                            </div>
                            <div class="pd-bill-kpi">
                                <div class="pd-bill-val">@_policy.BillingPlan</div>
                                <div class="pd-bill-lbl">Billing Plan</div>
                            </div>
                        </div>

                        <h4 class="pd-section-hdr2">Installment Schedule</h4>
                        <SfGrid TValue="InvoiceRow" DataSource="_invoices"
                                AllowSorting="true" EnableHover="true" RowHeight="48">
                            <GridColumns>
                                <GridColumn Field="@nameof(InvoiceRow.InvoiceNum)" HeaderText="Invoice #"    Width="130" />
                                <GridColumn Field="@nameof(InvoiceRow.DueDate)"    HeaderText="Due Date"     Width="120">
                                    <Template>@{ var i = (InvoiceRow)context; }<span class="pd-mono @(i.Status == "Overdue" ? "pd-exp-30" : "")">@i.DueDate.ToString("MM/dd/yyyy")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(InvoiceRow.Amount)"     HeaderText="Amount"       Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var i = (InvoiceRow)context; }<span class="pd-mono">@i.Amount.ToString("C2")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(InvoiceRow.AmountPaid)" HeaderText="Paid"         Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var i = (InvoiceRow)context; }<span class="pd-mono">@i.AmountPaid.ToString("C2")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(InvoiceRow.Balance)"    HeaderText="Balance"      Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var i = (InvoiceRow)context; }<span class="pd-mono @(i.Balance > 0 ? "pd-bill-red" : "")">@i.Balance.ToString("C2")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(InvoiceRow.Status)"     HeaderText="Status"       Width="110">
                                    <Template>@{ var i = (InvoiceRow)context; }<span class="pd-inv-status pd-inv-@i.Status.ToLower()">@i.Status</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(InvoiceRow.PaidDate)"   HeaderText="Paid Date"    Width="120">
                                    <Template>@{ var i = (InvoiceRow)context; }<span class="pd-mono">@(i.PaidDate.HasValue ? i.PaidDate.Value.ToString("MM/dd/yyyy") : "—")</span></Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 8 ── CLAIMS ──────────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Claims" IconCss="bi bi-exclamation-circle" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_claims.Count claim(s) · @_claims.Count(c => c.Status == "Open") open</span>
                            <button class="um-btn um-btn-ghost um-btn-sm">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Report Claim
                            </button>
                        </div>
                        <SfGrid TValue="ClaimRow" DataSource="_claims"
                                AllowSorting="true" AllowFiltering="true" EnableHover="true" RowHeight="52">
                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                            <GridColumns>
                                <GridColumn Field="@nameof(ClaimRow.ClaimNum)"    HeaderText="Claim #"      Width="140" />
                                <GridColumn Field="@nameof(ClaimRow.LossDate)"    HeaderText="Loss Date"    Width="120">
                                    <Template>@{ var c = (ClaimRow)context; }<span class="pd-mono">@c.LossDate.ToString("MM/dd/yyyy")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(ClaimRow.LossType)"    HeaderText="Loss Type"    Width="150" />
                                <GridColumn Field="@nameof(ClaimRow.Description)" HeaderText="Description"  MinWidth="200" />
                                <GridColumn Field="@nameof(ClaimRow.Status)"      HeaderText="Status"       Width="110">
                                    <Template>@{ var c = (ClaimRow)context; }<span class="pd-claim-status pd-cs-@c.Status.ToLower()">@c.Status</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(ClaimRow.Reserve)"     HeaderText="Reserve"      Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (ClaimRow)context; }<span class="pd-mono">@c.Reserve.ToString("C0")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(ClaimRow.Paid)"        HeaderText="Paid"         Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (ClaimRow)context; }<span class="pd-mono">@c.Paid.ToString("C0")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(ClaimRow.Adjuster)"    HeaderText="Adjuster"     Width="150" />
                                <GridColumn Field="@nameof(ClaimRow.ClosedDate)"  HeaderText="Closed"       Width="115">
                                    <Template>@{ var c = (ClaimRow)context; }<span class="pd-mono">@(c.ClosedDate.HasValue ? c.ClosedDate.Value.ToString("MM/dd/yyyy") : "—")</span></Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 9 ── ENDORSEMENTS ────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Endorsements" IconCss="bi bi-pen" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_endorsements.Count endorsement(s)</span>
                            <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => OpenAction("endorse")'>
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> New Endorsement
                            </button>
                        </div>
                        <SfGrid TValue="EndorsementRow" DataSource="_endorsements"
                                AllowSorting="true" EnableHover="true" RowHeight="50">
                            <GridColumns>
                                <GridColumn Field="@nameof(EndorsementRow.EndNum)"    HeaderText="Endorse #"   Width="130" />
                                <GridColumn Field="@nameof(EndorsementRow.EffDate)"   HeaderText="Eff Date"    Width="115">
                                    <Template>@{ var e = (EndorsementRow)context; }<span class="pd-mono">@e.EffDate.ToString("MM/dd/yyyy")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(EndorsementRow.Type)"      HeaderText="Type"        Width="160" />
                                <GridColumn Field="@nameof(EndorsementRow.Description)" HeaderText="Description" MinWidth="200" />
                                <GridColumn Field="@nameof(EndorsementRow.PremChange)" HeaderText="Prem Δ"     Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>
                                        @{ var e = (EndorsementRow)context; }
                                        <span class="pd-mono @(e.PremChange > 0 ? "pd-prem-up" : e.PremChange < 0 ? "pd-prem-dn" : "")">
                                            @(e.PremChange >= 0 ? "+" : "")@e.PremChange.ToString("C2")
                                        </span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(EndorsementRow.Status)"    HeaderText="Status"      Width="110">
                                    <Template>@{ var e = (EndorsementRow)context; }<span class="pd-end-status pd-es-@e.Status.ToLower()">@e.Status</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(EndorsementRow.IssuedBy)"  HeaderText="Issued By"   Width="140" />
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 10 ── RENEWALS ───────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Renewals" IconCss="bi bi-arrow-repeat" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        @if (_renewal is not null)
                        {
                            <div class="pd-renewal-banner pd-renewal-@RenewalUrgency(_policy.ExpDate)">
                                <div class="pd-ren-info">
                                    <i class="bi bi-arrow-repeat pd-ren-icon" aria-hidden="true"></i>
                                    <div>
                                        <div class="pd-ren-title">Renewal Due @_policy.ExpDate.ToString("MMMM dd, yyyy")</div>
                                        <div class="pd-ren-sub">@DaysLabel(_policy.ExpDate) · Status: <strong>@_renewal.Status</strong></div>
                                    </div>
                                </div>
                                <div class="pd-ren-actions">
                                    <button class="um-btn um-btn-ghost um-btn-sm">
                                        <i class="bi bi-arrow-left-right" aria-hidden="true"></i> Remarket
                                    </button>
                                    <button class="um-btn um-btn-primary um-btn-sm">
                                        <i class="bi bi-check-lg" aria-hidden="true"></i> Bind Renewal
                                    </button>
                                </div>
                            </div>
                            <div class="pd-summary-grid" style="margin-top:1rem">
                                <div class="pd-info-card">
                                    <h3 class="pd-card-hdr">Renewal Pipeline</h3>
                                    <div class="pd-field-grid">
                                        @F("Status",           _renewal.Status)
                                        @F("Quoted Premium",   _renewal.QuotedPremium?.ToString("C0") ?? "—")
                                        @F("Expiring Premium", _policy.WrittenPremium.ToString("C0"))
                                        @F("Change",           _renewal.QuotedPremium.HasValue ? $"{(_renewal.QuotedPremium.Value - _policy.WrittenPremium):+#,##0.00;-#,##0.00;$0}" : "—")
                                        @F("Remarketed",       _renewal.Remarketed ? "Yes" : "No")
                                        @F("Carriers Quoted",  _renewal.CarriersQuoted.ToString())
                                        @F("Follow-Up Date",   _renewal.FollowUpDate?.ToString("MM/dd/yyyy") ?? "—")
                                        @F("Assigned To",      _renewal.AssignedTo)
                                    </div>
                                </div>
                            </div>
                        }

                        <h4 class="pd-section-hdr2" style="margin-top:1.5rem">Renewal History</h4>
                        <SfGrid TValue="RenewalHistRow" DataSource="_renewalHistory"
                                AllowSorting="true" EnableHover="true" RowHeight="48">
                            <GridColumns>
                                <GridColumn Field="@nameof(RenewalHistRow.PolicyNum)"   HeaderText="Policy #"        Width="160" />
                                <GridColumn Field="@nameof(RenewalHistRow.EffDate)"     HeaderText="Eff Date"        Width="115">
                                    <Template>@{ var r = (RenewalHistRow)context; }<span class="pd-mono">@r.EffDate.ToString("MM/dd/yyyy")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(RenewalHistRow.ExpDate)"     HeaderText="Exp Date"        Width="115">
                                    <Template>@{ var r = (RenewalHistRow)context; }<span class="pd-mono">@r.ExpDate.ToString("MM/dd/yyyy")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(RenewalHistRow.Carrier)"     HeaderText="Carrier"         Width="155" />
                                <GridColumn Field="@nameof(RenewalHistRow.Premium)"     HeaderText="Premium"         Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var r = (RenewalHistRow)context; }<span class="pd-mono">@r.Premium.ToString("C0")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(RenewalHistRow.Change)"      HeaderText="Δ vs Prior"      Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var r = (RenewalHistRow)context; }
                                        <span class="pd-mono @(r.Change > 0 ? "pd-prem-up" : r.Change < 0 ? "pd-prem-dn" : "")">
                                            @(r.Change >= 0 ? "+" : "")@r.Change.ToString("C0")
                                        </span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(RenewalHistRow.Outcome)"     HeaderText="Outcome"         Width="120">
                                    <Template>@{ var r = (RenewalHistRow)context; }<span class="pd-end-status pd-es-@r.Outcome.ToLower()">@r.Outcome</span></Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 11 ── COMMISSIONS ────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Commissions" IconCss="bi bi-percent" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="pd-billing-summary">
                            <div class="pd-bill-kpi pd-bill-kpi--prem">
                                <div class="pd-bill-val">@_commissions.Sum(c => c.GrossAmt).ToString("C2")</div>
                                <div class="pd-bill-lbl">Gross Commission</div>
                            </div>
                            <div class="pd-bill-kpi pd-bill-kpi--paid">
                                <div class="pd-bill-val">@_commissions.Sum(c => c.AgencyAmt).ToString("C2")</div>
                                <div class="pd-bill-lbl">Agency Net</div>
                            </div>
                            <div class="pd-bill-kpi">
                                <div class="pd-bill-val">@_commissions.Sum(c => c.ProducerAmt).ToString("C2")</div>
                                <div class="pd-bill-lbl">Producer Split</div>
                            </div>
                            <div class="pd-bill-kpi">
                                <div class="pd-bill-val">@(_commissions.Count > 0 ? $"{_commissions.Average(c => c.CommPct):P1}" : "—")</div>
                                <div class="pd-bill-lbl">Avg Comm %</div>
                            </div>
                        </div>

                        <SfGrid TValue="CommissionRow" DataSource="_commissions"
                                AllowSorting="true" EnableHover="true" RowHeight="50">
                            <GridColumns>
                                <GridColumn Field="@nameof(CommissionRow.Period)"      HeaderText="Period"      Width="120" />
                                <GridColumn Field="@nameof(CommissionRow.Type)"        HeaderText="Type"        Width="120" />
                                <GridColumn Field="@nameof(CommissionRow.Producer)"    HeaderText="Producer"    Width="155" />
                                <GridColumn Field="@nameof(CommissionRow.CommPct)"     HeaderText="Comm %"      Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (CommissionRow)context; }<span class="pd-mono">@c.CommPct.ToString("P1")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CommissionRow.GrossAmt)"    HeaderText="Gross"       Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (CommissionRow)context; }<span class="pd-mono">@c.GrossAmt.ToString("C2")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CommissionRow.AgencyAmt)"   HeaderText="Agency Net"  Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (CommissionRow)context; }<span class="pd-mono">@c.AgencyAmt.ToString("C2")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CommissionRow.ProducerAmt)" HeaderText="Producer"    Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (CommissionRow)context; }<span class="pd-mono">@c.ProducerAmt.ToString("C2")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CommissionRow.Status)"      HeaderText="Status"      Width="110">
                                    <Template>@{ var c = (CommissionRow)context; }<span class="pd-inv-status pd-inv-@c.Status.ToLower()">@c.Status</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(CommissionRow.PaidDate)"    HeaderText="Paid Date"   Width="120">
                                    <Template>@{ var c = (CommissionRow)context; }<span class="pd-mono">@(c.PaidDate.HasValue ? c.PaidDate.Value.ToString("MM/dd/yyyy") : "—")</span></Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 12 ── AUDIT ──────────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Audit" IconCss="bi bi-journal-text" /></ChildContent>
                <ContentTemplate>
                    <div class="pd-tab-body">
                        <div class="pd-tab-toolbar">
                            <span class="pd-tab-count">@_auditLog.Count event(s)</span>
                        </div>
                        <SfGrid TValue="AuditEntry" DataSource="_auditLog"
                                AllowSorting="true" AllowFiltering="true" EnableHover="true" RowHeight="50">
                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                            <GridColumns>
                                <GridColumn Field="@nameof(AuditEntry.Timestamp)"  HeaderText="Timestamp"  Width="155">
                                    <Template>@{ var a = (AuditEntry)context; }<span class="pd-mono">@a.Timestamp.ToString("MM/dd/yy hh:mm tt")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(AuditEntry.Action)"     HeaderText="Action"     Width="160">
                                    <Template>@{ var a = (AuditEntry)context; }<span class="pd-audit-action pd-aa-@a.Action.ToLower().Replace(" ","-")">@a.Action</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(AuditEntry.Field)"      HeaderText="Field"      Width="170" />
                                <GridColumn Field="@nameof(AuditEntry.OldValue)"   HeaderText="Old Value"  MinWidth="160" />
                                <GridColumn Field="@nameof(AuditEntry.NewValue)"   HeaderText="New Value"  MinWidth="160" />
                                <GridColumn Field="@nameof(AuditEntry.ChangedBy)"  HeaderText="Changed By" Width="145" />
                                <GridColumn Field="@nameof(AuditEntry.IpAddress)"  HeaderText="IP"         Width="130" />
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

        </Tabs>
    </AppDetailTabs>
}

<!-- ── ACTION DIALOGS ──────────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showActionDlg" Width="480px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="pd-dlg-hdr"><i class="bi @_actionIcon" aria-hidden="true"></i> @_actionTitle</span></Header>
        <Content>
            <div class="pd-dlg-body">
                <p class="pd-dlg-lead">@_actionDesc</p>
                @if (_activeAction is "endorse" or "rewrite" or "remarket" or "cancel" or "reinstate")
                {
                    <div class="pd-dlg-grid">
                        @if (_activeAction is "endorse" or "rewrite")
                        {
                            <SfDatePicker TValue="DateTime" Placeholder="Effective date" @bind-Value="_actionDate" />
                            <SfNumericTextBox TValue="decimal" Placeholder="Premium change ($)" Format="C2" @bind-Value="_actionPremDelta" />
                        }
                        @if (_activeAction == "cancel")
                        {
                            <SfDatePicker TValue="DateTime" Placeholder="Cancellation date" @bind-Value="_actionDate" />
                            <SfDropDownList TValue="string" TItem="PdLv" DataSource="_cancelReasonOpts"
                                            Placeholder="Cancellation reason *" Width="100%" @bind-Value="_actionReason">
                                <DropDownListFieldSettings Value="Value" Text="Label" />
                            </SfDropDownList>
                        }
                        @if (_activeAction == "reinstate")
                        {
                            <SfDatePicker TValue="DateTime" Placeholder="Reinstatement date" @bind-Value="_actionDate" />
                        }
                    </div>
                }
                @if (_activeAction is "certificate")
                {
                    <div class="pd-dlg-grid">
                        <SfTextBox Placeholder="Certificate holder name *" @bind-Value="_actionCertHolder" />
                        <SfTextBox Placeholder="Certificate holder address" @bind-Value="_actionCertAddr" />
                        <SfDropDownList TValue="string" TItem="PdLv" DataSource="_certTypeOpts"
                                        Placeholder="Certificate type" Width="100%" @bind-Value="_actionReason">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                        <SfDatePicker TValue="DateTime" Placeholder="Effective date" @bind-Value="_actionDate" />
                    </div>
                }
                @if (_activeAction is "esign")
                {
                    <div class="pd-dlg-grid">
                        <SfTextBox Placeholder="Signer name *" @bind-Value="_actionCertHolder" />
                        <SfTextBox Placeholder="Signer email *" @bind-Value="_actionCertAddr" />
                        <SfDropDownList TValue="string" TItem="PdLv" DataSource="_esignDocOpts"
                                        Placeholder="Document to sign" Width="100%" @bind-Value="_actionReason">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                }
                @if (_activeAction == "message")
                {
                    <div class="pd-dlg-grid-1">
                        <SfDropDownList TValue="string" TItem="PdLv" DataSource="_msgChannelOpts"
                                        Placeholder="Channel" Width="100%" @bind-Value="_actionReason">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                        <SfTextBox Placeholder="To (email / phone)" @bind-Value="_actionCertHolder" />
                        <SfTextBox Placeholder="Subject" @bind-Value="_actionCertAddr" />
                        <SfTextBox Placeholder="Message body…" Multiline="true"
                                   HtmlAttributes='@(new() {{"rows","4"}})' @bind-Value="_actionNote" />
                    </div>
                }
                <SfTextBox Placeholder="Notes / reason" Multiline="true"
                           HtmlAttributes='@(new() {{"rows","2"}})' @bind-Value="_actionNote" />
            </div>
        </Content>
        <FooterTemplate>
            <div class="pd-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showActionDlg = false">Cancel</button>
                <button class="um-btn @(_activeAction == "cancel" ? "um-btn-danger" : "um-btn-primary")"
                        @onclick="ExecuteActionAsync">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Confirm
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Log Activity Dialog -->
<SfDialog @bind-Visible="_showActForm" Width="520px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="pd-dlg-hdr"><i class="bi bi-lightning" aria-hidden="true"></i> Log Activity</span></Header>
        <Content>
            <div class="pd-dlg-body">
                <div class="pd-dlg-grid">
                    <SfTextBox Placeholder="Subject *" @bind-Value="_actForm.Subject" />
                    <SfDropDownList TValue="string" TItem="PdLv" DataSource="_actCategoryOpts"
                                    Placeholder="Category" Width="100%" @bind-Value="_actForm.Category">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                    <SfDropDownList TValue="string" TItem="PdLv" DataSource="_actChannelOpts"
                                    Placeholder="Channel" Width="100%" @bind-Value="_actForm.Channel">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                    <SfDropDownList TValue="string" TItem="PdLv" DataSource="_actOutcomeOpts"
                                    Placeholder="Outcome" Width="100%" @bind-Value="_actForm.Outcome">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
