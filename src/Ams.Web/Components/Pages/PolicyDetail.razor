    private async Task ExecuteActionAsync()
    {
        if (_policy is null) return;
        _actionDate = _actionForm.ActionDate;
        _actionReason = _actionForm.Reason ?? string.Empty;
        _actionCertHolder = _actionForm.PartyName ?? string.Empty;
        _actionCertAddr = _actionForm.PartyAddress ?? string.Empty;
        _actionPremDelta = _actionForm.PremiumDelta;
        _actionNote = _actionForm.Note ?? string.Empty;
        var toastMessage = $"{_actionTitle} — recorded successfully.";
        switch (_activeAction)
        {
            case "cancel":
                if (string.IsNullOrWhiteSpace(_actionReason))
                {
                    await ShowErrorToast("Cancellation reason is required.");
                    return;
                }
                _policy.Status     = "Cancelled";
                _policy.CancelDate = _actionDate;
                _activities.Insert(0, NewActivity("Policy cancellation recorded", "Endorsement", "Portal", "Completed", $"Reason: {_actionReason}. {_actionNote}"));
                AddAuditEntry("Policy Cancelled", "Status", "Active", "Cancelled");
                break;
            case "reinstate":
                _policy.Status        = "Active";
                _policy.ReinstateDate = _actionDate;
                _activities.Insert(0, NewActivity("Policy reinstated", "Endorsement", "Portal", "Completed", _actionNote));
                AddAuditEntry("Policy Reinstated", "Status", "Cancelled", "Active");
                break;
            case "endorse":
                AddEndorsement("Change Endorsement", string.IsNullOrWhiteSpace(_actionNote) ? "Policy endorsement" : _actionNote, _actionPremDelta, _actionDate);
                break;
            case "rewrite":
                AddEndorsement("Rewrite Request", string.IsNullOrWhiteSpace(_actionNote) ? "Policy rewrite requested" : _actionNote, _actionPremDelta, _actionDate, "Pending");
                _activities.Insert(0, NewActivity("Policy rewrite workflow started", "Renewal", "Portal", "Pending", _actionNote));
                AddAuditEntry("Rewrite Started", "Workflow", "—", "Pending");
                break;
            case "remarket":
                EnsureRenewalPipeline();
                _renewal!.Status = "Remarketing";
                _renewal.Remarketed = true;
                _renewal.CarriersQuoted = Math.Max(_renewal.CarriersQuoted, 3);
                _renewal.QuotedPremium ??= Math.Round(_policy.WrittenPremium * 1.04m, 2);
                _renewal.FollowUpDate = DateTime.Today.AddDays(7);
                _activities.Insert(0, NewActivity("Remarket workflow started", "Renewal", "Portal", "Pending", _actionNote));
                AddAuditEntry("Remarket Started", "Renewal Status", "In Progress", _renewal.Status);
                break;
            case "bindRenewal":
                EnsureRenewalPipeline();
                var oldPolicy = _policy.PolicyNumber;
                var oldPremium = _policy.WrittenPremium;
                var renewedPremium = _renewal!.QuotedPremium ?? Math.Round(_policy.WrittenPremium * 1.04m, 2);
                _renewalHistory.Insert(0, new RenewalHistRow
                {
                    PolicyNum = oldPolicy,
                    EffDate = _policy.EffDate,
                    ExpDate = _policy.ExpDate,
                    Carrier = _policy.Carrier,
                    Premium = _policy.WrittenPremium,
                    Change = 0m,
                    Outcome = "Renewed",
                });
                _policy.PolicyNumber = NextPolicyNumber(oldPolicy);
                _policy.EffDate = _policy.ExpDate;
                _policy.ExpDate = _policy.EffDate.AddMonths(_policy.TermMonths == 0 ? 12 : _policy.TermMonths);
                _policy.WrittenPremium = renewedPremium;
                _policy.AnnualPremium = renewedPremium;
                _policy.BalanceDue = Math.Round(renewedPremium / 10m, 2);
                _policy.Status = "Active";
                _renewal.Status = "Bound";
                _renewal.QuotedPremium = renewedPremium;
                _renewal.FollowUpDate = null;
                _documents.Insert(0, NewDocument($"Renewal Binder — {_policy.PolicyNumber}", "Bind", "PDF", "156 KB"));
                _activities.Insert(0, NewActivity("Renewal bound", "Renewal", "Portal", "Completed", $"Renewed from {oldPolicy} at {renewedPremium:C0}."));
                AddAuditEntry("Renewal Bound", "Written Premium", oldPremium.ToString("C0"), renewedPremium.ToString("C0"));
                toastMessage = $"Renewal bound as {_policy.PolicyNumber}.";
                break;
            case "certificate":
                if (string.IsNullOrWhiteSpace(_actionCertHolder))
                {
                    await ShowErrorToast("Certificate holder name is required.");
                    return;
                }
                var certName = $"Certificate of Insurance — {_actionCertHolder}";
                _documents.Insert(0, NewDocument(certName, "Certificate", "PDF", "144 KB"));
                _activities.Insert(0, NewActivity(certName, "Endorsement", "Portal", "Completed", _actionCertAddr));
                AddAuditEntry("Certificate Issued", "Documents", "—", certName);
                break;
            case "esign":
                if (string.IsNullOrWhiteSpace(_actionCertHolder) || string.IsNullOrWhiteSpace(_actionCertAddr))
                {
                    await ShowErrorToast("Signer name and email are required.");
                    return;
                }
                _comms.Insert(0, new CommRow
                {
                    SentAt = DateTime.Now,
                    Channel = "Email",
                    Direction = "Outbound",
                    Subject = "E-signature request",
                    From = "Agency",
                    To = _actionCertAddr,
                    Status = "Sent",
                });
                _activities.Insert(0, NewActivity($"E-sign request sent to {_actionCertHolder}", "Email", "Email", "Pending", _actionReason));
                AddAuditEntry("E-Sign Requested", "Communications", "—", _actionCertAddr);
                break;
            case "message":
                if (string.IsNullOrWhiteSpace(_actionCertHolder))
                {
                    await ShowErrorToast("Recipient is required.");
                    return;
                }
                _comms.Insert(0, new CommRow
                {
                    SentAt = DateTime.Now,
                    Channel = string.IsNullOrWhiteSpace(_actionReason) ? "Email" : _actionReason,
                    Direction = "Outbound",
                    Subject = string.IsNullOrWhiteSpace(_actionCertAddr) ? $"Policy {_policy.PolicyNumber}" : _actionCertAddr,
                    From = "Agency",
                    To = _actionCertHolder,
                    Status = "Sent",
                });
                _activities.Insert(0, NewActivity("Policy message sent", "Email", string.IsNullOrWhiteSpace(_actionReason) ? "Email" : _actionReason, "Completed", _actionNote));
                AddAuditEntry("Message Sent", "Communications", "—", _actionCertHolder);
                break;
        }
        _showActionDlg = false;
        await ShowToast(toastMessage);
    }

