    private async Task SaveCoverageAsync()
    {
        if (_policy is null)
            return;

        try
        {
            if (_coverageForm.IsEdit)
            {
                if (!_coverageForm.CoverageDetailId.HasValue)
                {
                    await ShowErrorToast("Coverage detail id is required for updates.");
                    return;
                }

                var coverageDetailId = _coverageForm.CoverageDetailId.Value;
                await Api.UpdatePolicyCoverageDetailAsync(coverageDetailId, BuildUpdateCoverageRequest(coverageDetailId));
                await PersistCoverageFieldsAsync(coverageDetailId);
                await LoadPolicyCoveragesAsync();
                await LoadPolicyCommissionsAsync();
                _showCovForm = false;
                await ShowToast("Coverage details updated.");
            }
            else
            {
                var coverageDetailId = await Api.CreatePolicyCoverageDetailAsync(BuildCreateCoverageRequest());
                await LoadPolicyCoveragesAsync();
                await LoadPolicyCommissionsAsync();
                _showCovForm = false;
                await ShowToast("Coverage details added.");
            }
        }
        catch (Exception ex)
        {
            await ShowErrorToast($"Coverage save failed: {ex.Message}");
        }
    }

