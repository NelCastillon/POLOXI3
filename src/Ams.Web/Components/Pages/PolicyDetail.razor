    private async Task SyncPolicyCommissionsAsync()
    {
        if (_policy is null)
        {
            _commissions = [];
            return;
        }

        var existingRows = _commissions.Count == 0
            ? (await Api.SearchCommissionLedgerAsync(_tenantId, _policy.PolicyNumber) ?? [])
                .Where(x => string.Equals(x.PolicyNumber, _policy.PolicyNumber, StringComparison.OrdinalIgnoreCase))
                .Select(MapCommissionRow)
                .ToList()
            : _commissions;

        foreach (var coverage in _coverages.Where(x => x.Premium != 0m))
        {
            if (HasMatchingCommission(existingRows, coverage))
            {
                continue;
            }

            await Api.CreateCommissionLedgerAsync(BuildCommissionLedgerRequest(coverage));
        }

        await LoadPolicyCommissionsAsync();
    }

    private bool HasMatchingCommission(IEnumerable<CommissionRow> rows, CoverageRow coverage)
    {
        var period = coverage.EffectiveDate.ToString("MMM yyyy", CultureInfo.CurrentCulture);
        var type = FirstNonEmpty(coverage.CoverageCategoryCode, coverage.LineOfBusinessCode, "Coverage") ?? "Coverage";
        return rows.Any(row =>
            string.Equals(row.Period, period, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(row.Type, type, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(row.Producer, _policy?.Producer ?? string.Empty, StringComparison.OrdinalIgnoreCase) &&
            row.GrossAmt == coverage.Premium);
    }

    private CreateCommissionLedgerRequest BuildCommissionLedgerRequest(CoverageRow coverage)
    {
        var rate = coverage.Rate ?? 0m;
        var agencyAmount = Math.Round(coverage.Premium * rate / 100m, 2);
        var status = FirstNonEmpty(coverage.StatusCode, _policy?.Status, "Pending") ?? "Pending";
        return new CreateCommissionLedgerRequest
        {
            TenantId = _tenantId,
            PolicyNumber = _policy?.PolicyNumber ?? string.Empty,
            Period = coverage.EffectiveDate.ToString("MMM yyyy", CultureInfo.CurrentCulture),
            BusinessType = FirstNonEmpty(coverage.CoverageCategoryCode, coverage.LineOfBusinessCode, "Coverage") ?? "Coverage",
            Producer = _policy?.Producer ?? string.Empty,
            AccountName = _policy?.Account ?? string.Empty,
            LineOfBusiness = FirstNonEmpty(coverage.LineOfBusinessCode, _policy?.Lob) ?? string.Empty,
            Carrier = FirstNonEmpty(coverage.CarrierName, _policy?.Carrier) ?? string.Empty,
            GrossAmount = coverage.Premium,
            CommissionPct = rate,
            AgencyAmount = agencyAmount,
            ProducerAmount = 0m,
            Status = status,
            TransactionDate = DateOnly.FromDateTime(coverage.EffectiveDate),
            CreatedByUserId = _currentUserId,
        };
    }

