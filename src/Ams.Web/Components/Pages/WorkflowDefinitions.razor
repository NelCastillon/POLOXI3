@page "/platform/workflow-definitions"
@inject ApiClient Api

<PageTitle>Workflow Definitions</PageTitle>
<h1>Workflow Definitions</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(WorkflowDefinitionDto.WorkflowCode)"      HeaderText="Code"            Width="150"></GridColumn>
        <GridColumn Field="@nameof(WorkflowDefinitionDto.WorkflowName)"      HeaderText="Name"            Width="220"></GridColumn>
        <GridColumn Field="@nameof(WorkflowDefinitionDto.TargetEntityName)"  HeaderText="Target Entity"   Width="180"></GridColumn>
        <GridColumn Field="@nameof(WorkflowDefinitionDto.TriggerTypeCode)"   HeaderText="Trigger"         Width="110"></GridColumn>
        <GridColumn Field="@nameof(WorkflowDefinitionDto.ThresholdAmount)"   HeaderText="Threshold"       Width="110" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(WorkflowDefinitionDto.Version)"           HeaderText="Ver"             Width="60"></GridColumn>
        <GridColumn Field="@nameof(WorkflowDefinitionDto.IsActive)"          HeaderText="Active"          Width="80" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(WorkflowDefinitionDto.IsSystemDefined)"   HeaderText="System"          Width="80" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(WorkflowDefinitionDto.CreatedDateUtc)"    HeaderText="Created"         Width="160" Type="ColumnType.DateTime" Format="MM/dd/yyyy"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private string? _searchTerm;
    private List<WorkflowDefinitionDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchWorkflowDefinitionsAsync(_searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
