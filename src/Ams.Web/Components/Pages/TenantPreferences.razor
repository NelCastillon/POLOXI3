@page "/tenant/settings/preferences"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>Tenant Preferences — AMS</PageTitle>

<AppPageHeader Title="Tenant Preferences"
               Subtitle="Configure tenant-wide operating preferences, locale, fiscal calendar, defaults, and display behavior"
               Icon="bi-sliders">
    <Actions>
        <button class="um-btn um-btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> Save Preferences</button>
    </Actions>
</AppPageHeader>

<section class="tset-hero" aria-label="Tenant preferences overview">
    <div>
        <span class="tset-eyebrow">Tenant administration</span>
        <h2>Tenant Operating Defaults</h2>
        <p>Set agency-wide defaults for locale, calendar, account behavior, data display, and operational controls.</p>
    </div>
</section>

<section class="tset-kpi-grid" aria-label="Tenant preference metrics">
    @Kpi("Defaults", "24", "Configured preferences", "bi-sliders", "tset-tone-blue")
    @Kpi("Branches", "12", "Using tenant defaults", "bi-diagram-3", "tset-tone-green")
    @Kpi("Overrides", "6", "Branch-specific values", "bi-toggle-on", "tset-tone-amber")
    @Kpi("Review", "Q2", "Next scheduled audit", "bi-calendar-check", "tset-tone-violet")
</section>

<TenantSettingsWorkflowManager PageCode="preferences"
                               Label="Tenant preference workflow"
                               DefaultStage="Configure"
                               DefaultCategory="Operational Defaults" />

<TenantConfigManager Kind="TenantPreference"
                     Title="Tenant Preferences"
                     Subtitle="Configure tenant-wide operating preferences, locale, fiscal calendar, defaults, and display behavior"
                     Icon="bi bi-sliders" />

<section class="tset-admin-panel" aria-label="Preference review">
    <h3>Preference review checklist</h3>
    <div class="tset-policy-card">
        <strong>Tenant preference controls</strong>
        <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Locale, timezone, fiscal year, and currency reviewed</span>
        <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Account, policy, billing, and dashboard defaults verified</span>
        <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Branch override governance documented</span>
    </div>
</section>

@code {
    protected override void OnInitialized() => Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tenant Preferences", "/tenant/settings/preferences"));

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="tset-kpi-card"><span class="tset-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span><div><strong>@value</strong><span>@label</span><small>@meta</small></div></article>;
}
