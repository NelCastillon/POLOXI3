@page "/tenant/commissions/schedules2"
@page "/tenant/commissions/splits2"
@page "/tenant/commissions/branches2"
@page "/tenant/commissions/rule2s"
@page "/tenant/commissions/house2"
@page "/tenant/commissions/clawbacks2"
@page "/tenant/commissions/statements2"
@page "/tenant/commissions/plans2"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Commission Setup — AMS</PageTitle>

<AppPageHeader Title="Commission Setup"
               Subtitle="Tenant admin control center for commission schedules, producer splits, branch overrides, new/renewal rules, house accounts, clawbacks, statements, and compensation plans"
               Icon="bi-percent">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/tenant/commissions/schedules")'>
            <i class="bi bi-clipboard-check" aria-hidden="true"></i> Commission Schedules
        </button>
    </Actions>
</AppPageHeader>

<section class="commcfg-hero" aria-label="Commission setup overview">
    <div>
        <span class="commcfg-eyebrow">Tenant administration</span>
        <h2>Commission Setup Workflow</h2>
        <p>Govern producer compensation from schedules, split rules, branch overrides, new/renewal logic, house account handling, clawbacks, statement settings, and compensation plan design.</p>
    </div>
    <div class="commcfg-hero-grid">
        @foreach (var action in _quickActions)
        {
            <button class="commcfg-quick-action" @onclick="() => Nav.NavigateTo(action.Url)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
</section>

<section class="commcfg-kpi-grid" aria-label="Commission setup metrics">
    @Kpi("Schedules", "12", "Active commission tables", "bi-clipboard-check", "commcfg-tone-blue")
    @Kpi("Split Rules", "48", "Producer and team splits", "bi-scissors", "commcfg-tone-violet")
    @Kpi("Exceptions", "9", "Need admin review", "bi-exclamation-triangle", "commcfg-tone-red")
    @Kpi("Plans", "7", "Compensation plans", "bi-award", "commcfg-tone-green")
</section>

<section class="commcfg-command-bar" aria-label="Commission setup filters">
    <div class="commcfg-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search"
               placeholder="Search commission setup, owner, rule, control, module..."
               @bind="_search"
               @bind:event="oninput" />
    </div>
    <div class="commcfg-pill-group" role="group" aria-label="Commission workflow filter">
        @foreach (var filter in _filters)
        {
            <button class="commcfg-pill @(_filter == filter.Key ? "commcfg-pill--active" : "")"
                    @onclick="() => _filter = filter.Key">
                @filter.Label
                <span>@FilterCount(filter.Key)</span>
            </button>
        }
    </div>
</section>

<section class="commcfg-layout">
    <div class="commcfg-flow" aria-label="Commission setup workflow lanes">
        @foreach (var lane in _lanes)
        {
            var laneItems = FilteredWorkflow.Where(x => x.Stage == lane.Key).ToList();
            <article class="commcfg-lane">
                <header class="commcfg-lane-header">
                    <div>
                        <span class="commcfg-lane-title">@lane.Label</span>
                        <span class="commcfg-lane-subtitle">@lane.Description</span>
                    </div>
                    <span class="commcfg-lane-count">@laneItems.Count</span>
                </header>

                <div class="commcfg-lane-list">
                    @if (laneItems.Count == 0)
                    {
                        <div class="commcfg-empty-mini">No visible workflow items.</div>
                    }
                    else
                    {
                        @foreach (var item in laneItems)
                        {
                            <button class="commcfg-work-card @(item.Risk == "High" ? "commcfg-work-card--risk" : "")"
                                    @onclick="() => _selected = item">
                                <div class="commcfg-work-topline">
                                    <span class="commcfg-chip @ToneCss(item.Domain)">@item.Domain</span>
                                    <span class="commcfg-status @RiskCss(item.Risk)">@item.Risk</span>
                                </div>
                                <strong>@item.Title</strong>
                                <p>@item.Summary</p>
                                <div class="commcfg-work-meta">
                                    <span><i class="bi bi-person" aria-hidden="true"></i> @item.Owner</span>
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> @item.Sla</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            </article>
        }
    </div>

    <aside class="commcfg-admin-panel" aria-label="Tenant commission administration controls">
        @if (_selected is null)
        {
            <div class="commcfg-side-empty">
                <i class="bi bi-percent" aria-hidden="true"></i>
                <h3>Commission governance</h3>
                <p>Select a workflow item to inspect owner, SLA, risk, compensation control, and setup module.</p>
            </div>
        }
        else
        {
            <div class="commcfg-detail-header">
                <span class="commcfg-chip @ToneCss(_selected.Domain)">@_selected.Domain</span>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close details">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h3>@_selected.Title</h3>
            <p>@_selected.Summary</p>

            <dl class="commcfg-detail-list">
                <div><dt>Owner</dt><dd>@_selected.Owner</dd></div>
                <div><dt>Stage</dt><dd>@_selected.Stage</dd></div>
                <div><dt>Risk</dt><dd><span class="commcfg-status @RiskCss(_selected.Risk)">@_selected.Risk</span></dd></div>
                <div><dt>SLA</dt><dd>@_selected.Sla</dd></div>
                <div><dt>Control</dt><dd>@_selected.Control</dd></div>
            </dl>

            <div class="commcfg-policy-card">
                <strong>Tenant commission controls</strong>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Schedule, split, override, and plan approvals enforced</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> New/renewal, house account, and clawback rules governed</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Statement output, compensation evidence, and audit trail retained</span>
            </div>

            <div class="commcfg-detail-actions">
                <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selected.Url)">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Module
                </button>
                <button class="um-btn um-btn-ghost" @onclick="() => Advance(_selected)">
                    <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Advance
                </button>
            </div>
        }
    </aside>
</section>

<section class="commcfg-module-grid" aria-label="Commission setup modules">
    @foreach (var module in _modules)
    {
        <button class="commcfg-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
            <span class="commcfg-module-icon @ToneCss(module.Domain)"><i class="bi @module.Icon" aria-hidden="true"></i></span>
            <span class="commcfg-module-content">
                <strong>@module.Title</strong>
                <small>@module.Description</small>
            </span>
            <i class="bi bi-chevron-right commcfg-module-arrow" aria-hidden="true"></i>
        </button>
    }
</section>

@code {
    private string _search = string.Empty;
    private string _filter = string.Empty;
    private CommissionWorkflowItem? _selected;
    private readonly List<CommissionWorkflowItem> _workflow = [];

    private readonly Lane[] _lanes =
    [
        new("Plan", "Plan", "Schedules and compensation design"),
        new("Allocate", "Allocate", "Splits and branch overrides"),
        new("Qualify", "Qualify", "New/renewal and house account rules"),
        new("Recover", "Recover", "Clawbacks and exceptions"),
        new("Publish", "Publish", "Statements and evidence")
    ];

    private readonly Filter[] _filters =
    [
        new("", "All"),
        new("risk", "High Risk"),
        new("splits", "Splits"),
        new("rules", "Rules"),
        new("statements", "Statements")
    ];

    private readonly CommissionModule[] _modules =
    [
        new("Commission Schedules", "Define schedule tables, basis, tiers, effective dates, and commissionable lines.", "/tenant/commissions/schedules", "bi-clipboard-check", "Schedules"),
        new("Producer Splits", "Configure producer, team, account, and policy-level split allocations.", "/tenant/commissions/splits", "bi-scissors", "Splits"),
        new("Branch Overrides", "Manage branch override percentages, eligibility, hierarchy, and approval rules.", "/tenant/commissions/branches", "bi-diagram-3", "Overrides"),
        new("New/Renewal Rules", "Control new versus renewal rates, term logic, and policy lifecycle commission behavior.", "/tenant/commissions/rules", "bi-sliders2", "Rules"),
        new("House Account Rules", "Define house account ownership, producer exclusion, servicing credit, and split policy.", "/tenant/commissions/house", "bi-house", "Rules"),
        new("Clawback Rules", "Set cancellation, non-payment, chargeback, and recovery rules with timing windows.", "/tenant/commissions/clawbacks", "bi-arrow-counterclockwise", "Clawbacks"),
        new("Statement Settings", "Configure statement layout, frequency, approval, delivery, and dispute windows.", "/tenant/commissions/statements", "bi-file-earmark-text", "Statements"),
        new("Compensation Plans", "Manage producer compensation packages, plan versions, guarantees, bonuses, and eligibility.", "/tenant/commissions/plans", "bi-award", "Plans")
    ];

    private readonly CommissionModule[] _quickActions =
    [
        new("Schedules", "", "/tenant/commissions/schedules", "bi-clipboard-check", "Schedules"),
        new("Splits", "", "/tenant/commissions/splits", "bi-scissors", "Splits"),
        new("Rules", "", "/tenant/commissions/rules", "bi-sliders2", "Rules"),
        new("Statements", "", "/tenant/commissions/statements", "bi-file-earmark-text", "Statements")
    ];

    private IEnumerable<CommissionWorkflowItem> FilteredWorkflow => _workflow.Where(item =>
        (string.IsNullOrWhiteSpace(_filter) || _filter switch
        {
            "risk" => item.Risk == "High",
            "splits" => item.Domain is "Splits" or "Overrides",
            "rules" => item.Domain == "Rules",
            "statements" => item.Domain == "Statements",
            _ => true
        }) &&
        (string.IsNullOrWhiteSpace(_search) ||
         item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Domain.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Control.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(x => x.Risk == "High")
        .ThenBy(x => x.Stage)
        .ThenBy(x => x.Title);

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Commission Setup", "/tenant/commissions/schedules"));
        BuildWorkflow();
        _selected = _workflow.FirstOrDefault(x => x.Risk == "High") ?? _workflow.FirstOrDefault();
    }

    private void BuildWorkflow()
    {
        _workflow.Clear();
        _workflow.AddRange(
        [
            new("Commercial schedule versioning", "Commercial lines commission schedule v2026 needs effective-date validation before activation.", "Schedules", "High", "Plan", "Diana Perez", "Today", "Schedule approval", "/tenant/commissions/schedules"),
            new("Producer compensation plan review", "New producer compensation plan includes guarantee and bonus components requiring approval.", "Plans", "Medium", "Plan", "Sarah Kim", "This week", "Plan version approval", "/tenant/commissions/plans"),
            new("Producer split conflict", "Two producers have overlapping account-level split rules for a commercial renewal book.", "Splits", "High", "Allocate", "James Park", "24h", "Split conflict control", "/tenant/commissions/splits"),
            new("Branch override update", "New branch override hierarchy needs validation for multi-branch accounts.", "Overrides", "Medium", "Allocate", "Maria Santos", "5 days", "Override hierarchy", "/tenant/commissions/branches"),
            new("New/renewal rule tuning", "Renewal rate logic needs adjustment for rewritten policies and broker-of-record changes.", "Rules", "High", "Qualify", "Kevin Obi", "48h", "Lifecycle rule governance", "/tenant/commissions/rules"),
            new("House account servicing credit", "House account servicing credit needs revised exclusion rules for inactive producers.", "Rules", "Medium", "Qualify", "Lisa Chen", "This week", "House account policy", "/tenant/commissions/house"),
            new("Clawback timing window", "Cancellation clawback window must align with carrier return commission timing.", "Clawbacks", "High", "Recover", "Robert Yamamoto", "Today", "Recovery rule approval", "/tenant/commissions/clawbacks"),
            new("Statement approval workflow", "Monthly producer statements require updated dispute window and approval routing.", "Statements", "Medium", "Publish", "Diana Perez", "Month end", "Statement approval", "/tenant/commissions/statements")
        ]);
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _filter = string.Empty;
    }

    private void Advance(CommissionWorkflowItem item)
    {
        item.Stage = item.Stage switch
        {
            "Plan" => "Allocate",
            "Allocate" => "Qualify",
            "Qualify" => "Recover",
            "Recover" => "Publish",
            _ => "Publish"
        };
    }

    private int FilterCount(string key) => key switch
    {
        "risk" => _workflow.Count(x => x.Risk == "High"),
        "splits" => _workflow.Count(x => x.Domain is "Splits" or "Overrides"),
        "rules" => _workflow.Count(x => x.Domain == "Rules"),
        "statements" => _workflow.Count(x => x.Domain == "Statements"),
        _ => _workflow.Count
    };

    private static string ToneCss(string domain) => domain switch
    {
        "Schedules" => "commcfg-tone-blue",
        "Splits" => "commcfg-tone-violet",
        "Overrides" => "commcfg-tone-cyan",
        "Rules" => "commcfg-tone-amber",
        "Clawbacks" => "commcfg-tone-red",
        "Statements" => "commcfg-tone-green",
        "Plans" => "commcfg-tone-blue",
        _ => "commcfg-tone-neutral"
    };

    private static string RiskCss(string risk) => risk switch
    {
        "High" => "commcfg-status-high",
        "Medium" => "commcfg-status-medium",
        _ => "commcfg-status-low"
    };

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="commcfg-kpi-card">
        <span class="commcfg-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span>
        <div>
            <strong>@value</strong>
            <span>@label</span>
            <small>@meta</small>
        </div>
    </article>;

    private sealed record Lane(string Key, string Label, string Description);
    private sealed record Filter(string Key, string Label);
    private sealed record CommissionModule(string Title, string Description, string Url, string Icon, string Domain)
    {
        public string Label => Title;
    }

    private sealed class CommissionWorkflowItem(string title, string summary, string domain, string risk, string stage, string owner, string sla, string control, string url)
    {
        public string Title { get; set; } = title;
        public string Summary { get; set; } = summary;
        public string Domain { get; set; } = domain;
        public string Risk { get; set; } = risk;
        public string Stage { get; set; } = stage;
        public string Owner { get; set; } = owner;
        public string Sla { get; set; } = sla;
        public string Control { get; set; } = control;
        public string Url { get; set; } = url;
    }
}
