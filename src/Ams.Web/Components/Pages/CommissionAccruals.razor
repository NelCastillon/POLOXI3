@page "/commissions/accruals"
@inject ApiClient Api

<PageTitle>Commission Accruals</PageTitle>

<h1>Commission Accruals</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(CommissionAccrualEntryDto.AccrualDate)" HeaderText="Accrual Date" Type="ColumnType.Date" Format="d" Width="150"></GridColumn>
            <GridColumn Field="@nameof(CommissionAccrualEntryDto.AccruedAmount)" HeaderText="Accrued Amount" Format="C2" Width="160"></GridColumn>
            <GridColumn Field="@nameof(CommissionAccrualEntryDto.ReversalDate)" HeaderText="Reversal Date" Type="ColumnType.Date" Format="d" Width="150"></GridColumn>
            <GridColumn Field="@nameof(CommissionAccrualEntryDto.ReversedAmount)" HeaderText="Reversed Amount" Format="C2" Width="160"></GridColumn>
            <GridColumn Field="@nameof(CommissionAccrualEntryDto.StatusCode)" HeaderText="Status" Width="120"></GridColumn>
            <GridColumn Field="@nameof(CommissionAccrualEntryDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="g" Width="180"></GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<CommissionAccrualEntryDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchCommissionAccrualEntriesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<CommissionAccrualEntryDto>();
    }
}
