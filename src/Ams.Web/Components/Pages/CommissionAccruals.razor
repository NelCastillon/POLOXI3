@page "/commissions/accruals"
@page "/commissions/forecast"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Commission Forecast &amp; Accruals — AMS</PageTitle>

<AppPageHeader Title="Commission Forecast &amp; Accruals"
               Subtitle="Project earned commissions, manage accrual entries, and track period reversals across producers and plans"
               Icon="bi-graph-up">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/planner")'>
            <i class="bi bi-calculator" aria-hidden="true"></i> What-If Planner
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/statements")'>
            <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Statements
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenPost">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> Post Accrual
        </button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}

<!-- Forecast summary tiles -->
<div class="cf-forecast-strip">
    <div class="cf-fc-card cf-fc-blue">
        <div class="cf-fc-lbl">Projected This Month</div>
        <div class="cf-fc-val">@Fmt(ProjectedThisMonth)</div>
        <div class="cf-fc-sub">From current DB accruals</div>
    </div>
    <div class="cf-fc-card cf-fc-green">
        <div class="cf-fc-lbl">YTD Earned</div>
        <div class="cf-fc-val">@Fmt(YtdEarned)</div>
        <div class="cf-fc-sub">Posted and settled entries</div>
    </div>
    <div class="cf-fc-card cf-fc-amber">
        <div class="cf-fc-lbl">Pending Accruals</div>
        <div class="cf-fc-val">@Fmt(PendingAccruals)</div>
        <div class="cf-fc-sub">@(_items?.Count(x=>x.StatusCode=="Pending") ?? 0) entries not yet reversed</div>
    </div>
    <div class="cf-fc-card cf-fc-purple">
        <div class="cf-fc-lbl">New Biz vs Renewal</div>
        <div class="cf-fc-val">@((_items?.Count ?? 0) == 0 ? "—" : "DB synced")</div>
        <div class="cf-fc-sub">Based on commission transactions</div>
    </div>
    <div class="cf-fc-card cf-fc-red">
        <div class="cf-fc-lbl">Clawback Risk</div>
        <div class="cf-fc-val">@Fmt(ClawbackRisk)</div>
        <div class="cf-fc-sub">Overdue reversal exposure</div>
    </div>
</div>

<!-- KPI strip -->
<div class="cf-kpi-strip">
    @CfKpi("bi-graph-up",          "Accrual Entries",  (_items?.Count ?? 0).ToString(),                                          "cf-ki-blue")
    @CfKpi("bi-currency-dollar",   "Accrued",          Fmt(_items?.Sum(x=>x.AccruedAmount)),                                     "cf-ki-blue")
    @CfKpi("bi-arrow-counterclockwise","Reversed",     Fmt(_items?.Sum(x=>x.ReversedAmount)),                                    "cf-ki-amber")
    @CfKpi("bi-check-circle",      "Settled",          (_items?.Count(x=>x.StatusCode=="Settled") ?? 0).ToString(),              "cf-ki-green")
    @CfKpi("bi-hourglass",         "Pending",          (_items?.Count(x=>x.StatusCode=="Pending") ?? 0).ToString(),              "cf-ki-amber")
    @CfKpi("bi-calendar-x",        "Overdue Reversals",(_items?.Count(x=>x.ReversalDate!=null && x.ReversalDate<DateOnly.FromDateTime(DateTime.Today) && x.ReversedAmount==0) ?? 0).ToString(), "cf-ki-red")
</div>

<!-- Sub-nav -->
<div class="cf-subnav">
    <button class="cf-snav-btn cf-snav-active"><i class="bi bi-graph-up" aria-hidden="true"></i> Forecast &amp; Accruals</button>
    <button class="cf-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/statements")'><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Statements</button>
    <button class="cf-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/producer-ledger")'><i class="bi bi-journal-text" aria-hidden="true"></i> Producer Ledger</button>
    <button class="cf-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/exceptions")'><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Exceptions</button>
    <button class="cf-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/clawbacks")'><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Clawbacks</button>
    <button class="cf-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/planner")'><i class="bi bi-calculator" aria-hidden="true"></i> What-If Planner</button>
</div>

<!-- Toolbar -->
<div class="cf-toolbar">
    <SfTextBox Placeholder="Search…" @bind-Value="_searchTerm" Width="270px"></SfTextBox>
    <select class="e-input cf-sel" @bind="_filterStatus">
        <option value="">All Statuses</option>
        <option value="Pending">Pending</option>
        <option value="Posted">Posted</option>
        <option value="Reversed">Reversed</option>
        <option value="Settled">Settled</option>
    </select>
</div>

<!-- Post Accrual Dialog -->
<SfDialog Width="560px" IsModal="true" @bind-Visible="_showPost" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-graph-up" aria-hidden="true"></i><span>Post Accrual Entry</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="ClosePost"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_postEditContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Accrual Date <span class="text-danger">*</span></label><InputDate @bind-Value="_postForm.AccrualDate" class="um-input" /><ValidationMessage For="() => _postForm.AccrualDate" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Accrued Amount <span class="text-danger">*</span></label><InputNumber @bind-Value="_postForm.AccruedAmount" class="um-input" /><ValidationMessage For="() => _postForm.AccruedAmount" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Expected Reversal Date <span class="text-danger">*</span></label><InputDate @bind-Value="_postForm.ReversalDate" class="um-input" /><ValidationMessage For="() => _postForm.ReversalDate" class="validation-message text-danger" /></div>
                    <div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_postForm.Notes" class="um-input" rows="3" /><ValidationMessage For="() => _postForm.Notes" class="validation-message text-danger" /></div>
                    @if (!string.IsNullOrWhiteSpace(_postFormError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_postFormError</div> }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="ClosePost">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="PostAccrual">Post</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@if (_items is null)
{
    <div style="padding:2rem"><SfSpinner Visible="true" /></div>
}
else
{
<div class="cf-grid-wrap">
    <SfGrid DataSource="FilteredItems" AllowPaging="true" AllowSorting="true" Height="480px">
        <GridPageSettings PageSize="15"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(CommissionAccrualEntryDto.AccrualDate)" HeaderText="Accrual Date" Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
            <GridColumn Field="@nameof(CommissionAccrualEntryDto.AccruedAmount)" HeaderText="Accrued" Format="C2" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
            <GridColumn Field="@nameof(CommissionAccrualEntryDto.ReversalDate)" HeaderText="Reversal Date" Type="ColumnType.Date" Format="d" Width="120">
                <Template>
                    @{ var a = (CommissionAccrualEntryDto)context; }
                    @if (a.ReversalDate.HasValue)
                    {
                        var overdue = a.ReversalDate.Value < DateOnly.FromDateTime(DateTime.Today) && a.ReversedAmount == 0;
                        <span class="@(overdue?"cf-overdue":"")">@a.ReversalDate.Value.ToString("MMM d, yyyy")</span>
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(CommissionAccrualEntryDto.ReversedAmount)" HeaderText="Reversed" Format="C2" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
            <GridColumn HeaderText="Status" Width="110">
                <Template>
                    @{ var a2 = (CommissionAccrualEntryDto)context; }
                    <span class="cf-status-chip cf-st-@a2.StatusCode.ToLower()">@a2.StatusCode</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(CommissionAccrualEntryDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="d" Width="110"></GridColumn>
        </GridColumns>
    </SfGrid>
</div>
}

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private string? _loadError;
    private string _filterStatus = "";
    private bool _showPost;
    private PostAccrualForm _postForm = new();
    private EditContext _postEditContext = default!;
    private string? _postFormError;
    private List<CommissionAccrualEntryDto>? _items;
    private decimal ProjectedThisMonth => (_items ?? []).Where(x => x.AccrualDate.Month == DateTime.Today.Month && x.AccrualDate.Year == DateTime.Today.Year).Sum(x => x.AccruedAmount);
    private decimal YtdEarned => (_items ?? []).Where(x => x.AccrualDate.Year == DateTime.Today.Year && x.StatusCode is "Posted" or "Settled" or "Reversed").Sum(x => x.AccruedAmount);
    private decimal PendingAccruals => (_items ?? []).Where(x => x.StatusCode == "Pending").Sum(x => x.AccruedAmount);
    private decimal ClawbackRisk => (_items ?? []).Where(x => x.ReversalDate != null && x.ReversalDate < DateOnly.FromDateTime(DateTime.Today) && (x.ReversedAmount ?? 0) == 0).Sum(x => x.AccruedAmount);

    private IEnumerable<CommissionAccrualEntryDto> FilteredItems => (_items ?? []).Where(x =>
        string.IsNullOrEmpty(_filterStatus) || x.StatusCode == _filterStatus);

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        _postEditContext = new(_postForm);
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Commissions","/commissions"), new("Forecast & Accruals",""));
        await LoadAsync();
    }

    private void OpenPost() { _postForm = new(); _postEditContext = new(_postForm); _postFormError = null; _showPost = true; }
    private void ClosePost() => _showPost = false;

    private void PostAccrual()
    {
        _postFormError = null;
        if (!_postEditContext.Validate()) return;
        if (_postForm.ReversalDate < _postForm.AccrualDate)
        {
            _postFormError = "Expected Reversal Date must be on or after Accrual Date.";
            return;
        }
        _showPost = false;
    }

    private async Task LoadAsync()
    {
        try
        {
            _loadError = null;
            var result = await Api.SearchCommissionAccrualEntriesAsync(_tenantId, _searchTerm);
            _items = result?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _items = [];
        }
    }

    static string Fmt(decimal? v) => v.HasValue ? v.Value.ToString("C0") : "$0";

    RenderFragment CfKpi(string icon, string label, string val, string color) => __builder =>
    {
        <div class="cf-kpi-card @color">
            <i class="bi @icon cf-kpi-icon" aria-hidden="true"></i>
            <div><div class="cf-kpi-val">@val</div><div class="cf-kpi-lbl">@label</div></div>
        </div>
    };

    private sealed class PostAccrualForm
    {
        [Required] public DateTime AccrualDate { get; set; } = DateTime.Today;
        [Range(0.01, 100000000)] public decimal AccruedAmount { get; set; }
        [Required] public DateTime ReversalDate { get; set; } = DateTime.Today.AddMonths(1);
        [StringLength(1000)] public string? Notes { get; set; }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
