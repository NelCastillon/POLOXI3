@page "/finance/journal-entry-lines"
@inject ApiClient Api
@using Ams.Application.Common.Dtos
@using Ams.Web.Services
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons

<h3>Journal Entry Lines</h3>

<div class="mb-3 d-flex gap-2">
    <SfTextBox Placeholder="Journal Entry ID..." @bind-Value="_journalEntryIdText" Width="300px" />
    <SfButton OnClick="LoadAsync">Load</SfButton>
</div>

<SfGrid DataSource="_items" AllowPaging="true">
    <GridPageSettings PageSize="10" />
    <GridColumns>
        <GridColumn Field="@nameof(JournalEntryLineDto.LineId)" HeaderText="Line ID" Width="220" />
        <GridColumn Field="@nameof(JournalEntryLineDto.JournalEntryId)" HeaderText="Journal Entry ID" Width="220" />
        <GridColumn Field="@nameof(JournalEntryLineDto.GLAccountId)" HeaderText="GL Account ID" Width="220" />
        <GridColumn Field="@nameof(JournalEntryLineDto.DebitAmount)" HeaderText="Debit" Format="C2" Width="120" />
        <GridColumn Field="@nameof(JournalEntryLineDto.CreditAmount)" HeaderText="Credit" Format="C2" Width="120" />
        <GridColumn Field="@nameof(JournalEntryLineDto.Description)" HeaderText="Description" Width="220" />
        <GridColumn Field="@nameof(JournalEntryLineDto.LineOrder)" HeaderText="Order" Width="80" />
    </GridColumns>
</SfGrid>

@code {
    private List<JournalEntryLineDto>? _items;
    private string? _journalEntryIdText;

    private async Task LoadAsync()
    {
        if (!Guid.TryParse(_journalEntryIdText, out var journalEntryId))
            return;

        var result = await Api.GetJournalEntryLinesAsync(journalEntryId);
        _items = result?.ToList() ?? [];
    }
}
