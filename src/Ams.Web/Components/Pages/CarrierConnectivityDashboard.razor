@page "/integrations/carriers"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Carrier Connectivity - AMS</PageTitle>

<AppPageHeader Title="Carrier Connectivity Dashboard"
               Subtitle="Real-time carrier download health, connection status, and download volume by carrier"
               Icon="bi-broadcast">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='()=>Nav.NavigateTo("/integrations/downloads")'>
            <i class="bi bi-arrow-down-circle" aria-hidden="true"></i> Downloads
        </button>
        <button class="um-btn um-btn-ghost" @onclick='()=>Nav.NavigateTo("/integrations/download-exceptions")'>
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Exceptions
        </button>
    </Actions>
</AppPageHeader>

<!-- Overall health -->
<div class="cc-health-bar">
    <div class="cc-health-icon cc-hi-@OverallHealthClass"><i class="bi bi-@OverallHealthIcon" aria-hidden="true"></i></div>
    <div>
        <div class="cc-health-title">@_carriers.Count(c=>c.Status=="Connected") of @_carriers.Count carriers online</div>
        <div class="cc-health-sub">@_carriers.Count(c=>c.Status=="Warning") warning - @_carriers.Count(c=>c.Status=="Error") errors - Last sweep 2 minutes ago</div>
    </div>
    <div class="cc-health-kpis">
        <div class="cc-hk"><div class="cc-hkv">@_carriers.Sum(c=>c.DownloadsToday)</div><div class="cc-hkl">Downloads today</div></div>
        <div class="cc-hk"><div class="cc-hkv">@_carriers.Sum(c=>c.ExceptionsOpen)</div><div class="cc-hkl">Open exceptions</div></div>
        <div class="cc-hk"><div class="cc-hkv cc-hk-good">@_carriers.Count(c=>c.IsEnabled)</div><div class="cc-hkl">Enabled</div></div>
    </div>
</div>

<!-- Carrier grid -->
<div class="cc-carrier-grid">
    @foreach (var c in _carriers)
    {
        <div class="cc-carrier-card @StatusBorder(c.Status)">
            <div class="cc-card-hdr">
                <div class="cc-car-av @(c.Status=="Connected"?"cc-av-green":c.Status=="Warning"?"cc-av-amber":"cc-av-red")">
                    @c.Code
                    <div class="cc-status-dot cc-dot-@c.Status.ToLower()"></div>
                </div>
                <div class="cc-car-info">
                    <div class="cc-car-name">@c.Name</div>
                    <div class="cc-car-type">@c.DownloadType - @c.Protocol</div>
                </div>
                <span class="@StatusBadge(c.Status)">@c.Status</span>
            </div>
            <div class="cc-car-stats">
                <div class="cc-cs-item"><div class="cc-csk">Downloads today</div><div class="cc-csv">@c.DownloadsToday</div></div>
                <div class="cc-cs-item"><div class="cc-csk">Last download</div><div class="cc-csv">@c.LastDownload</div></div>
                <div class="cc-cs-item"><div class="cc-csk">Success rate</div><div class="cc-csv @(c.SuccessRate>=95?"cc-good":c.SuccessRate>=85?"cc-warn":"cc-bad")">@c.SuccessRate%</div></div>
                <div class="cc-cs-item"><div class="cc-csk">Open exceptions</div><div class="cc-csv @(c.ExceptionsOpen>0?"cc-bad":"")">@c.ExceptionsOpen</div></div>
            </div>
            @if (!string.IsNullOrEmpty(c.LastError))
            {
                <div class="cc-error-msg"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @c.LastError</div>
            }
            <div class="cc-car-footer">
                <label class="cc-enable-toggle">
                    <input type="checkbox" checked="@c.IsEnabled" @onchange="() => c.IsEnabled = !c.IsEnabled" />
                    <span>@(c.IsEnabled ? "Enabled" : "Disabled")</span>
                </label>
                <div class="cc-car-actions">
                    <button class="um-btn um-btn-ghost um-btn-xs" title="Test connection"><i class="bi bi-wifi" aria-hidden="true"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-xs" title="Force download"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-xs" title="Configure" @onclick='()=>Nav.NavigateTo("/integrations")'><i class="bi bi-gear" aria-hidden="true"></i></button>
                    @if (c.ExceptionsOpen > 0)
                    {
                        <button class="um-btn um-btn-ghost um-btn-xs cc-exc-btn" title="View exceptions" @onclick='()=>Nav.NavigateTo("/integrations/download-exceptions")'><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @c.ExceptionsOpen</button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<CarrierConn> _carriers = [];

    private string OverallHealthClass => _carriers.Any(c => c.Status == "Error") ? "red" : _carriers.Any(c => c.Status == "Warning") ? "amber" : "green";
    private string OverallHealthIcon  => _carriers.Any(c => c.Status == "Error") ? "x-circle-fill" : _carriers.Any(c => c.Status == "Warning") ? "exclamation-triangle-fill" : "check-circle-fill";

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Integrations","/integrations"), new("Carrier Connectivity",""));
        _carriers =
        [
            new CarrierConn { Code="SFTY", Name="Safeco Insurance",        DownloadType="Policy",   Protocol="AL3",    Status="Connected", LastDownload="4 min ago",   DownloadsToday=142, SuccessRate=99, ExceptionsOpen=0,  IsEnabled=true, LastError="" },
            new CarrierConn { Code="PROG", Name="Progressive Commercial",  DownloadType="Policy",   Protocol="IVANS",  Status="Connected", LastDownload="18 min ago",  DownloadsToday=88,  SuccessRate=98, ExceptionsOpen=0,  IsEnabled=true, LastError="" },
            new CarrierConn { Code="TRVL", Name="Travelers Insurance",     DownloadType="Policy",   Protocol="AL3",    Status="Warning",   LastDownload="2 hr ago",    DownloadsToday=61,  SuccessRate=87, ExceptionsOpen=4,  IsEnabled=true, LastError="3 policies matched to multiple accounts - review required" },
            new CarrierConn { Code="GUAR", Name="Guard Insurance Group",   DownloadType="Claims",   Protocol="IVANS",  Status="Connected", LastDownload="1 hr ago",    DownloadsToday=22,  SuccessRate=100,ExceptionsOpen=0,  IsEnabled=true, LastError="" },
            new CarrierConn { Code="CITR", Name="Chubb / ACE",             DownloadType="Policy",   Protocol="XML",    Status="Error",     LastDownload="8 hr ago",    DownloadsToday=0,   SuccessRate=0,  ExceptionsOpen=12, IsEnabled=true, LastError="Authentication failed - carrier credentials expired. Update in settings." },
            new CarrierConn { Code="BRKL", Name="Berkley One",             DownloadType="Policy",   Protocol="REST",   Status="Connected", LastDownload="32 min ago",  DownloadsToday=38,  SuccessRate=97, ExceptionsOpen=1,  IsEnabled=true, LastError="" },
            new CarrierConn { Code="NTNL", Name="National General",        DownloadType="Policy",   Protocol="AL3",    Status="Connected", LastDownload="55 min ago",  DownloadsToday=54,  SuccessRate=96, ExceptionsOpen=0,  IsEnabled=true, LastError="" },
            new CarrierConn { Code="EMPL", Name="Employers Holdings",      DownloadType="Claims",   Protocol="IVANS",  Status="Connected", LastDownload="3 hr ago",    DownloadsToday=14,  SuccessRate=100,ExceptionsOpen=0,  IsEnabled=true, LastError="" },
            new CarrierConn { Code="HRTF", Name="Hartford Steam Boiler",   DownloadType="Policy",   Protocol="AL3",    Status="Inactive",  LastDownload="Never",       DownloadsToday=0,   SuccessRate=0,  ExceptionsOpen=0,  IsEnabled=false,LastError="" },
        ];
    }

    private static string StatusBorder(string s) => s switch { "Warning"=>"cc-border-warn","Error"=>"cc-border-err",_=>"" };
    private static string StatusBadge(string s)  => s switch { "Connected"=>"cc-st cc-st--ok","Warning"=>"cc-st cc-st--warn","Error"=>"cc-st cc-st--err",_=>"cc-st cc-st--off" };

    private sealed class CarrierConn { public string Code{get;set;}=string.Empty; public string Name{get;set;}=string.Empty; public string DownloadType{get;set;}=string.Empty; public string Protocol{get;set;}=string.Empty; public string Status{get;set;}=string.Empty; public string LastDownload{get;set;}=string.Empty; public int DownloadsToday{get;set;} public int SuccessRate{get;set;} public int ExceptionsOpen{get;set;} public bool IsEnabled{get;set;} public string LastError{get;set;}=string.Empty; }
}
