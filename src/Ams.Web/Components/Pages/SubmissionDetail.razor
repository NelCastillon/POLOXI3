        new("loss-runs-5-year.pdf", "Loss Runs", "Tenant Admin", DateTime.Today.AddDays(-4), "318 KB"),
        new($"{lineOfBusiness.ToLowerInvariant().Replace(' ', '-')}-schedule.xlsx", "Schedule", "Tenant Admin", DateTime.Today.AddDays(-3), "96 KB")
    ];

