        public decimal?  TargetPremium      { get; set; }
        public List<KeyValuePair<string,string>> Exposures { get; set; } = new();
        public List<CovRequest> Coverages { get; set; } = new();
        public List<LossYear>   LossHistory { get; set; } = new();
        public Guid? AssignedToUserId { get; set; }
        public string? AssignedToUserName { get; set; }
