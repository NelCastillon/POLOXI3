    int LiveProposalReadinessTotal => (_selectedQuote?.ProposalReadinessFactors.Count ?? 0) + 1;
    int LiveProposalReadinessCount => (_selectedQuote?.ProposalReadinessFactors.Count(IsProposalFactorSatisfied) ?? 0) + (HasCompleteBindableLineCoverage ? 1 : 0);
    bool HasAllSubmissionLineCoverage
    {
        get
        {
            if (_lines.Count == 0 || _quoteLineForms.Count == 0)
                return false;

            var quotedLineIds = _quoteLineForms.Select(line => line.SubmissionLineId).ToHashSet();
            return _lines.All(line => quotedLineIds.Contains(line.SubmissionLineId));
        }
    }
    bool HasCompleteBindableLineCoverage => HasAllSubmissionLineCoverage
        && _quoteLineForms.All(line => line.SubmissionLineId != Guid.Empty && line.IsBindable);
    string PackageBindableHelpText => HasCompleteBindableLineCoverage
        ? "All coverage lines are bindable. Check this box to approve the complete package for bind consideration."
        : "Mark every submission coverage line bindable before approving the package.";

    void SynchronizePackageBindability()
    {
        if (!HasCompleteBindableLineCoverage)
            _actionForm.IsBindable = false;
    }

    string BindableLineCoverageStatus
    {
        get
        {
            var missingCount = _lines.Count(line => _quoteLineForms.All(quoteLine => quoteLine.SubmissionLineId != line.SubmissionLineId));
            if (missingCount > 0)
                return $"{missingCount} of {_lines.Count} submission line(s) still need persisted quote terms.";

            var nonBindableCount = _quoteLineForms.Count(line => !line.IsBindable);
            return nonBindableCount > 0
                ? $"{nonBindableCount} coverage line(s) still need bindability approval."
                : $"All {_lines.Count} submission line(s) have persisted bindable quote terms.";
        }
    }

