    WorkflowGuidance BuildWorkflowGuidance()
    {
        if (_submission is null)
            return new("Workflow data is loading.", "Review the submission", "bi-hourglass-split", true);

        var status = _submission.Status;
        var presentedProposal = _proposals
            .Where(proposal => string.Equals(proposal.Status, "Presented", StringComparison.OrdinalIgnoreCase)
                || string.Equals(proposal.GovernanceStatusCode, "Presented", StringComparison.OrdinalIgnoreCase)
                || proposal.PresentedDateUtc.HasValue)
            .OrderByDescending(proposal => proposal.PresentedDateUtc)
            .FirstOrDefault();
        var acceptedProposal = _proposals
            .Where(proposal => string.Equals(proposal.ClientDecision, "Accepted", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(proposal => proposal.DecisionDateUtc)
            .FirstOrDefault();
        var activeBind = _bindTransactions
            .OrderByDescending(bind => bind.RequestedDateUtc)
            .FirstOrDefault(bind => bind.PolicyId is null
                && !string.Equals(bind.BindStatusCode, "Declined", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(bind.BindStatusCode, "Withdrawn", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(bind.BindStatusCode, "Expired", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(bind.BindStatusCode, "Failed", StringComparison.OrdinalIgnoreCase));

        if (string.Equals(status, "Bound", StringComparison.OrdinalIgnoreCase) || _bindTransactions.Any(bind => bind.PolicyId.HasValue))
            return new("No submission action is required; coverage is bound.", "Proceed to policy servicing", "bi-shield-check", true);

        if (status is "Declined" or "Withdrawn" or "Lost" or "Cancelled" or "Closed")
            return new("This submission workflow is closed.", "Copy or remarket when appropriate", "bi-slash-circle", true, "copy", "Copy / remarket");

        if (activeBind is not null)
            return new($"Waiting for carrier confirmation ({activeBind.BindStatusName}).", "Confirm the bind, then create or service the policy", "bi-hourglass-split", true, "quotes", "View bind");

        if (acceptedProposal is not null || string.Equals(status, "Customer Accepted", StringComparison.OrdinalIgnoreCase))
            return new("Client acceptance is recorded.", "Request bind from the selected quote", "bi-person-check", false, "policy", "Request bind");

        if ((presentedProposal is not null && string.IsNullOrWhiteSpace(presentedProposal.ClientDecision))
            || string.Equals(status, "Presented", StringComparison.OrdinalIgnoreCase))
            return new("Waiting for client acceptance to proceed.", "Record the client decision, then request bind", "bi-hourglass-split", true, "client-acceptance", "Client acceptance");

        if (_readiness?.IsReadyForMarketing == false)
            return new("Complete the outstanding underwriting requirements.", "Select a market after readiness is complete", "bi-clipboard2-check", false, "readiness", "View readiness");

        if (_markets.Count == 0)
            return new("Select at least one target market.", "Submit the completed package to market", "bi-bank", false, "markets", "Select market");

        if (_markets.All(market => !market.SubmittedDateUtc.HasValue))
            return new("Submit the package to a selected market.", "Request pricing and coverage terms", "bi-send", false, "markets", "Submit to market");

        if (_quotes.Count == 0 && _markets.Any(market => market.LatestQuoteRequestId.HasValue))
            return new("Waiting for a carrier quote response.", "Review and approve usable quote terms", "bi-hourglass-split", true, "markets", "Track requests");

        if (_quotes.Count == 0)
            return new("Request a quote from a submitted market.", "Review returned pricing and coverage", "bi-journal-plus", false, "quote", "Request quote");

        if (!CanGenerateProposal)
            return new("Review a quote and complete its proposal-readiness items.", "Generate and present the client proposal", "bi-journal-check", false, "quotes", "Review quotes");

        if (_proposals.Count == 0)
            return new("Generate a proposal from an approved quote.", "Present the proposal for client acceptance", "bi-file-earmark-richtext", false, "proposal", "Generate proposal");

        return new("Continue the proposal workflow.", "Present the proposal and record the client decision", "bi-envelope-check", false, "proposal", "Open proposal");
    }

    void ExecuteWorkflowGuidance(string actionCode)
    {
        switch (actionCode)
        {
            case "readiness": SetTab(3); break;
            case "markets": GoToMarketsForSubmit(); break;
            case "quotes": SetTab(2); break;
            case "quote": OpenActionDialog("quote"); break;
            case "proposal": OpenProposalWorkflow(); break;
            case "client-acceptance":
                if (ClientAcceptanceProposal is not null)
                    Nav.NavigateTo($"/submissions/{SubmissionId}/client-acceptance?proposalId={ClientAcceptanceProposal.ProposalId}");
                break;
            case "policy": OpenActionDialog("policy"); break;
            case "copy": OpenActionDialog("copy"); break;
        }
    }

