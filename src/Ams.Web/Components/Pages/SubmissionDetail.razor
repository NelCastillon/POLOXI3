    async Task LoadSubmission()
    {
        _loading = true;
        _loadError = null;

        try
        {
            var dto = await Api.GetSubmissionByIdAsync(SubmissionId);
            if (dto is null)
            {
                _sub = null;
                return;
            }

            BuildFromDto(dto);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load submission: {ex.Message}";
            BuildStub();
        }
        finally
        {
            _loading = false;
        }
    }

    void BuildFromDto(SubmissionDto dto)
    {
        var lineOfBusiness = string.IsNullOrWhiteSpace(dto.LineOfBusiness) ? "Commercial Property" : dto.LineOfBusiness;
        var accountName = string.IsNullOrWhiteSpace(dto.AccountName) ? "ACME Corporation" : dto.AccountName;

        _sub = new SubModel
        {
            SubmissionNumber = dto.SubmissionNumber,
            AccountName = accountName,
            Insured = accountName,
            Dba = accountName,
            Fein = "On file",
            LineOfBusiness = lineOfBusiness,
            Status = string.IsNullOrWhiteSpace(dto.Status) ? "New" : dto.Status,
            Priority = string.IsNullOrWhiteSpace(dto.Priority) ? "Normal" : dto.Priority,
            Producer = dto.AssignedToUserName ?? "Tenant Admin",
            Csr = "Service Team",
            ContactName = "James Brady",
            ContactPhone = "+1 312 555 0111",
            ContactEmail = "james.brady@acmecorp.com",
            Website = "https://acmecorp.com",
            Address = "100 Market Street, Chicago, IL 60601",
            RiskAddress = "4800 Industrial Parkway, Chicago, IL 60632",
            EntityType = "Corporation",
            YearFounded = "2001",
            SicNaics = "541612 / Risk Management Services",
            BusinessDesc = $"DB-backed {lineOfBusiness} submission prepared for carrier market review.",
            YearsInBusiness = "24",
            PriorCarrier = "Travelers",
            PriorPremium = dto.TargetPremium.GetValueOrDefault(112000m) * .92m,
            EffDate = dto.EffectiveDate,
            SubmitDate = dto.CreatedDateUtc.ToLocalTime(),
            DueDate = dto.EffectiveDate.AddDays(-14),
            TargetPremium = dto.TargetPremium,
            Exposures = BuildExposureRows(lineOfBusiness, dto.TargetPremium),
