            </div>
            <div class="sdd-modal__footer">
                <button type="button" class="sdd-btn sdd-btn--ghost" @onclick="CloseWaiverDialog">Cancel</button>
                <button type="button" class="sdd-btn sdd-btn--danger" @onclick="ExecuteWaiverAsync" disabled="@(string.IsNullOrWhiteSpace(_waiverReason))">Waive Requirement</button>
