    bool ValidateQuoteReview()
    {
        _quoteValidationErrors.Clear();
        SynchronizeQuoteStatusFromLines();

        if (string.IsNullOrWhiteSpace(_actionForm.QuoteStatus))
            _quoteValidationErrors.Add("Quote status is required.");
        if (!_actionForm.QuoteEffectiveDate.HasValue)
            _quoteValidationErrors.Add("Effective date is required.");
        if (!_actionForm.ExpiresDateUtc.HasValue)
            _quoteValidationErrors.Add("Expiration date is required.");
        if (_actionForm.QuoteEffectiveDate.HasValue && _actionForm.ExpiresDateUtc.HasValue && _actionForm.ExpiresDateUtc.Value.Date <= _actionForm.QuoteEffectiveDate.Value.Date)
            _quoteValidationErrors.Add("Expiration date must be after the effective date.");
        if (_actionForm.AnnualPremium is < 0)
            _quoteValidationErrors.Add("Annual premium cannot be negative.");

        if (string.Equals(_actionForm.QuoteStatus, "Approved for Presentation", StringComparison.OrdinalIgnoreCase))
        {
            if (!_actionForm.CarrierId.HasValue || _actionForm.CarrierId == Guid.Empty)
                _quoteValidationErrors.Add("A carrier market must be linked before approval for presentation.");
            if (_actionForm.AnnualPremium is null or <= 0)
                _quoteValidationErrors.Add("Annual premium must be greater than zero before approval for presentation.");
            if (!_actionForm.ExpiresDateUtc.HasValue || _actionForm.ExpiresDateUtc.Value <= DateTime.UtcNow)
                _quoteValidationErrors.Add("A future quote expiration date is required before approval for presentation.");
            if (!_actionForm.Deductible.HasValue)
                _quoteValidationErrors.Add("Deductible is required before approval for presentation.");
            if (!_actionForm.Limit.HasValue)
                _quoteValidationErrors.Add("Coverage limit is required before approval for presentation.");
            if (string.IsNullOrWhiteSpace(_actionForm.CoverageForms) && string.IsNullOrWhiteSpace(_actionForm.Notes))
                _quoteValidationErrors.Add("Coverage forms or coverage notes are required before approval for presentation.");
            if (!_actionForm.QuoteDocumentId.HasValue)
                _quoteValidationErrors.Add("A carrier quote document must be linked before approval for presentation.");
            if (!HasAllSubmissionLineCoverage)
                _quoteValidationErrors.Add("Every active submission line must have a corresponding quote line before approval for presentation.");
            if (!HasCompleteBindableLineCoverage)
                _quoteValidationErrors.Add("Every submission line must be marked bindable before approval for presentation.");
        }

        if (_actionForm.IsBindable && !HasCompleteBindableLineCoverage)
            _quoteValidationErrors.Add("The quote package cannot be marked bindable until every active submission line has a bindable quote line.");

        ValidateOptionalMoney(_actionForm.Deductible, "Package deductible");
        ValidateOptionalMoney(_actionForm.Limit, "Package limit");
        ValidateOptionalMoney(_actionForm.MinimumEarnedPremium, "Package minimum earned premium");
        ValidateOptionalMoney(_actionForm.TaxesAndFees, "Package taxes and fees");
        ValidateOptionalMoney(_actionForm.BrokerFee, "Package broker fee");
        ValidateCommission(_actionForm.CommissionPercent, "Package commission");
        ValidateLength(_actionForm.CarrierRating, 80, "Carrier rating");
        ValidateLength(_actionForm.PaymentTerms, 200, "Package payment terms");
        ValidateLength(_actionForm.CoverageForms, 2000, "Package coverage forms");
        ValidateLength(_actionForm.Subjectivities, 2000, "Package subjectivities");
        ValidateLength(_actionForm.Exclusions, 2000, "Package exclusions");
        ValidateLength(_actionForm.Notes, 1000, "Package notes");

        if (_quoteLineForms.Count == 0)
            _quoteValidationErrors.Add("At least one persisted submission coverage line is required.");
        if (_quoteLineForms.Any(line => line.SubmissionLineId == Guid.Empty))
            _quoteValidationErrors.Add("Every quote line must reference a valid submission line.");
        if (_quoteLineForms.GroupBy(line => line.SubmissionLineId).Any(group => group.Count() > 1))
            _quoteValidationErrors.Add("A submission coverage line can appear only once in the quote.");

        foreach (var line in _quoteLineForms.OrderBy(line => line.SortOrder))
        {
            var label = string.IsNullOrWhiteSpace(line.LineOfBusiness) ? "Coverage line" : line.LineOfBusiness.Trim();
            if (string.IsNullOrWhiteSpace(line.LineOfBusiness)) _quoteValidationErrors.Add("Every quote line requires a line of business.");
            if (line.LineOfBusiness?.Length > 100) _quoteValidationErrors.Add($"{label}: line of business cannot exceed 100 characters.");
            if (string.IsNullOrWhiteSpace(line.Status)) _quoteValidationErrors.Add($"{label}: status is required.");
            if (line.Status?.Length > 50) _quoteValidationErrors.Add($"{label}: status cannot exceed 50 characters.");
            if (line.QuotedPremium <= 0) _quoteValidationErrors.Add($"{label}: quoted premium must be greater than zero.");
            ValidateOptionalMoney(line.Deductible, $"{label} deductible");
            ValidateOptionalMoney(line.Limit, $"{label} limit");
            ValidateOptionalMoney(line.MinimumEarnedPremium, $"{label} minimum earned premium");
            ValidateOptionalMoney(line.TaxesAndFees, $"{label} taxes and fees");
            ValidateOptionalMoney(line.BrokerFee, $"{label} broker fee");
            ValidateCommission(line.CommissionPercent, $"{label} commission");
            ValidateLength(line.PaymentTerms, 200, $"{label} payment terms");
            ValidateLength(line.CoverageForms, 2000, $"{label} coverage forms");
            ValidateLength(line.Subjectivities, 2000, $"{label} subjectivities");
            ValidateLength(line.Exclusions, 2000, $"{label} exclusions");
            ValidateLength(line.CoverageNotes, 1000, $"{label} notes");
        }

        if (_quoteLineForms.Count > 0)
            _actionForm.AnnualPremium = _quoteLineForms.Sum(line => line.QuotedPremium);

        return _quoteValidationErrors.Count == 0;
    }

    void SynchronizeQuoteStatusFromLines()
    {
        var statuses = _quoteLineForms
            .Select(line => line.Status?.Trim())
            .Where(status => !string.IsNullOrWhiteSpace(status))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

        if (_quoteLineForms.Count > 0 && statuses.Length == 1)
            _actionForm.QuoteStatus = statuses[0]!;
    }

    void ValidateOptionalMoney(decimal? value, string label)
    {
        if (value is < 0 or > 999999999999m)
            _quoteValidationErrors.Add($"{label} must be between 0 and 999,999,999,999.");
    }

    void ValidateCommission(decimal? value, string label)
    {
        if (value is < 0 or > 100)
            _quoteValidationErrors.Add($"{label} must be between 0% and 100%.");
    }

    void ValidateLength(string? value, int maximumLength, string label)
    {
        if (value?.Length > maximumLength)
            _quoteValidationErrors.Add($"{label} cannot exceed {maximumLength:N0} characters.");
    }

