    static bool CanBindQuote(QuoteComparisonDto quote) => quote.IsBindable && quote.ExpiresDateUtc > DateTime.UtcNow && (quote.IsSelected || quote.Status is "Selected" or "Presented" or "Approved for Presentation");

    static string BindQuoteTitle(QuoteComparisonDto quote)
    {
        if (!quote.IsSelected && quote.Status is not ("Selected" or "Presented" or "Approved for Presentation"))
        {
            return "Select, present, or approve this quote before binding.";
        }

        if (quote.ExpiresDateUtc <= DateTime.UtcNow)
        {
            return "Expired quotes cannot be bound.";
        }

        if (!quote.IsBindable)
        {
            return "Mark this quote bindable during quote review before binding.";
        }

        return "Bind this confirmed quote and create the policy.";
    }

