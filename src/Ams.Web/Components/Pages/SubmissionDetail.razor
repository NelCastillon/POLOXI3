    static bool HasEvidence(SubmissionIntakeQuestionDto question) => question.EvidenceDocuments.Any();
    static bool IsQuestionSatisfied(SubmissionIntakeQuestionDto question) => question.StatusCode.Equals("Waived", StringComparison.OrdinalIgnoreCase)
        || ((question.IsAnswered || question.StatusCode.Equals("Confirmed", StringComparison.OrdinalIgnoreCase)) && (!question.RequiresEvidence || HasEvidence(question)));
    static string QuestionStatusLabel(SubmissionIntakeQuestionDto question) => question.StatusCode switch
    {
        _ when question.RequiresEvidence && !HasEvidence(question) && (question.IsAnswered || question.StatusCode.Equals("Confirmed", StringComparison.OrdinalIgnoreCase)) => "Evidence needed",
        "Confirmed" => "Confirmed",
        "Waived" => "Waived",
        "NeedsFollowUp" => "Needs follow-up",
        _ when IsQuestionSatisfied(question) => "Confirmed",
        _ => "Needs review"
    };
    static string QuestionActionLabel(SubmissionIntakeQuestionDto question) => IsQuestionSatisfied(question) ? QuestionStatusLabel(question) : "Confirm";
    static string QuestionStatusClass(SubmissionIntakeQuestionDto question) => question.StatusCode switch
    {
        _ when question.RequiresEvidence && !HasEvidence(question) && (question.IsAnswered || question.StatusCode.Equals("Confirmed", StringComparison.OrdinalIgnoreCase)) => "sdd-readiness-status sdd-readiness-status--follow-up",
        "Confirmed" => "sdd-readiness-status sdd-readiness-status--confirmed",
        "Waived" => "sdd-readiness-status sdd-readiness-status--waived",
        "NeedsFollowUp" => "sdd-readiness-status sdd-readiness-status--follow-up",
        _ when IsQuestionSatisfied(question) => "sdd-readiness-status sdd-readiness-status--confirmed",
        _ => "sdd-readiness-status sdd-readiness-status--review"
    };

    DocumentDto? LinkedEvidence(SubmissionIntakeQuestionDto question)
    {
        var evidenceDocumentId = question.EvidenceDocuments.FirstOrDefault()?.DocumentId;
        return evidenceDocumentId is Guid documentId ? _docs.FirstOrDefault(doc => doc.DocumentId == documentId) : null;
    }

    IEnumerable<DocumentDto> AvailableEvidenceDocuments(SubmissionIntakeQuestionDto question)
    {
        var linkedIds = question.EvidenceDocuments.Select(e => e.DocumentId).ToHashSet();
        return _docs.Where(doc => !linkedIds.Contains(doc.DocumentId)).OrderByDescending(d => d.CreatedDateUtc);
    }

    IEnumerable<DocumentDto> CarrierQuoteDocuments => _docs
