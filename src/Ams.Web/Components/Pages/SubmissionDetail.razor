    {
        _actionMode = mode;
        _actionTitle = mode switch
        {
            "submit" => "Submit to Market",
            "quote" => "Request Quote",
            "policy" => "Create Policy",
            "proposal" => "Generate Proposal",
            "decline" => "Decline Submission",
            "copy" => "Copy Submission",
            "note" => "Add Note",
            _ => "Submission Action"
        };
        _actionIcon = mode switch
        {
            "submit" => "bi-send",
            "quote" => "bi-journal-plus",
            "policy" => "bi-shield-check",
            "proposal" => "bi-file-earmark-richtext",
            "decline" => "bi-x-circle",
            "copy" => "bi-copy",
            "note" => "bi-sticky",
            _ => "bi-lightning-charge"
        };
        _actionButtonText = mode == "decline" ? "Decline" : "Continue";
        _actionForm.Reset(_submission);
        _showActionDialog = true;
    }

    void RequestQuoteForMarket(SubmissionMarketDto market)
    {
        OpenActionDialog("quote");
        _actionForm.CarrierId = market.CarrierId;
    }

    void CloseActionDialog()
    {
        if (_actionBusy) return;
        _showActionDialog = false;
    }

    void OpenConfirmDialog()
    {
        _confirmTitle = _actionTitle;
        _confirmMessage = _actionMode switch
        {
            "submit" => "Submit this package to the selected or default market?",
            "quote" => "Request quote terms for this submission?",
            "policy" => "Create a bound policy from the selected quote or generated quote?",
            "proposal" => "Generate a proposal from the available quote options?",
            "decline" => "Decline this submission? This updates the submission status and market rows.",
            "copy" => "Create a copied submission for remarketing or renewal?",
            _ => "Record this submission action?"
        };
        _showActionDialog = false;
        _showConfirmDialog = true;
    }

    void CloseConfirmDialog()
    {
        if (_actionBusy) return;
        _showConfirmDialog = false;
        _pendingRemoveMarket = null;
    }

    async Task ExecuteConfirmedActionAsync()
    {
        if (_submission is null) return;
        _actionBusy = true;
        try
        {
            if (_actionMode == "submit")
            {
                await Api.SubmitSubmissionToMarketAsync(SubmissionId, new SubmitSubmissionToMarketRequest(_submission.TenantId, _actionForm.CarrierId, _actionForm.Notes));
                ShowToast("Submission sent to market.");
            }
            else if (_actionMode == "quote")
            {
                await Api.RequestSubmissionQuoteAsync(SubmissionId, new RequestSubmissionQuoteRequest(_submission.TenantId, _actionForm.CarrierId, _actionForm.AnnualPremium, null, null, _actionForm.Notes));
                ShowToast("Quote requested.");
            }
            else if (_actionMode == "policy")
            {
                var quoteId = _selectedQuoteId ?? _quotes.OrderBy(q => q.AnnualPremium).FirstOrDefault()?.QuoteId;
                await Api.CreatePolicyFromSubmissionAsync(SubmissionId, new CreatePolicyFromSubmissionRequest(_submission.TenantId, quoteId, _actionForm.CarrierId, _actionForm.AnnualPremium, _submission.EffectiveDate, _submission.ExpirationDate));
                ShowToast("Policy created from submission.");
            }
            else if (_actionMode == "proposal")
            {
                var quoteIds = _quotes.Select(q => q.QuoteId).ToArray();
                await Api.GenerateProposalAsync(new GenerateProposalRequest(SubmissionId, _submission.TenantId, $"{_submission.SubmissionNumber} Proposal", quoteIds, _actionForm.Notes));
                ShowToast("Proposal generation started.");
            }
            else if (_actionMode == "decline")
            {
                await Api.DeclineSubmissionAsync(SubmissionId, new DeclineSubmissionRequest(_submission.TenantId, _actionForm.Notes));
                ShowToast("Submission declined.");
            }
            else if (_actionMode == "copy")
            {
                var result = await Api.CopySubmissionAsync(SubmissionId, new CopySubmissionRequest(_submission.TenantId, _actionForm.EffectiveDate, _submission.LineOfBusiness, _actionForm.Priority));
                ShowToast("Submission copied.");
                Nav.NavigateTo($"/submissions/{result.Id}");
                return;
            }
            else if (_actionMode == "remove-market" && _pendingRemoveMarket is not null)
            {
                await Api.RemoveSubmissionMarketAsync(_pendingRemoveMarket.SubmissionMarketId);
                ShowToast("Market removed.");
            }
            else
            {
                _activity.Insert(0, new ActivityItem("Tenant Admin", _actionTitle, _actionForm.Notes, "note", DateTime.Now));
                ShowToast("Action recorded.");
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"{_actionTitle} failed: {ex.Message}", true);
        }
        finally
        {
            _actionBusy = false;
            _showConfirmDialog = false;
            _pendingRemoveMarket = null;
        }
    }

    async Task SubmitMarketAsync(SubmissionMarketDto market)
    {
        if (_submission is null) return;
        try
        {
            await Api.SubmitSubmissionToMarketAsync(SubmissionId, new SubmitSubmissionToMarketRequest(_submission.TenantId, market.CarrierId, $"Submitted to {market.CarrierName} from detail dashboard."));
