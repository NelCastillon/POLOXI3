    static bool IsQuestionSatisfied(SubmissionIntakeQuestionDto question) => question.IsAnswered || question.StatusCode.Equals("Confirmed", StringComparison.OrdinalIgnoreCase) || question.StatusCode.Equals("Waived", StringComparison.OrdinalIgnoreCase);
    static string QuestionStatusLabel(SubmissionIntakeQuestionDto question) => question.StatusCode switch
    {
        "Confirmed" => "Confirmed",
        "Waived" => "Waived",
        "NeedsFollowUp" => "Needs follow-up",
        _ when IsQuestionSatisfied(question) => "Confirmed",
        _ => "Needs review"
    };
    static string QuestionActionLabel(SubmissionIntakeQuestionDto question) => IsQuestionSatisfied(question) ? QuestionStatusLabel(question) : "Confirm";
    static string QuestionStatusClass(SubmissionIntakeQuestionDto question) => question.StatusCode switch
    {
        "Confirmed" => "sdd-readiness-status sdd-readiness-status--confirmed",
        "Waived" => "sdd-readiness-status sdd-readiness-status--waived",
        "NeedsFollowUp" => "sdd-readiness-status sdd-readiness-status--follow-up",
        _ when IsQuestionSatisfied(question) => "sdd-readiness-status sdd-readiness-status--confirmed",
        _ => "sdd-readiness-status sdd-readiness-status--review"
    };

