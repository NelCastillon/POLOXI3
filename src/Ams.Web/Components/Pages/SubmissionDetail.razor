    void InitializeQuoteLineForms(QuoteComparisonDto? quote, SubmissionMarketDto? market)
    {
        _quoteLineForms.Clear();
        if (quote?.Lines.Any(line => line.SubmissionLineId.HasValue) == true)
            _quoteLineForms.AddRange(quote.Lines.Where(line => line.SubmissionLineId.HasValue).Select(line => QuoteLineForm.FromDto(line)));

        var requestedLineIds = market?.RequestedLines.Select(line => line.SubmissionLineId).ToHashSet() ?? [];
        var sourceLines = quote is not null || requestedLineIds.Count == 0 ? _lines : _lines.Where(line => requestedLineIds.Contains(line.SubmissionLineId));
        var existingLineIds = _quoteLineForms.Select(line => line.SubmissionLineId).ToHashSet();
        var sortOrder = _quoteLineForms.Count;
        foreach (var line in sourceLines)
        {
            if (existingLineIds.Contains(line.SubmissionLineId))
                continue;

            _quoteLineForms.Add(new QuoteLineForm
            {
                SubmissionLineId = line.SubmissionLineId,
                LineOfBusiness = line.LineOfBusiness,
                Status = PreferredOptionCode(_quoteStatuses, "Received", _actionForm.QuoteStatus),
                QuotedPremium = market?.RequestedLines.FirstOrDefault(requested => requested.SubmissionLineId == line.SubmissionLineId)?.TargetPremium ?? line.TargetPremium,
                SortOrder = sortOrder++
            });
        }
    }

