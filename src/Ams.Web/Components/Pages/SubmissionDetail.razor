    string QuoteRequestButtonTitle(SubmissionMarketDto market) => IsQuoteRequestBlocked(market) ? $"Quote requests are blocked because this market is {market.Status}." : "Create, update, or revise a DB-backed quote request for this market.";

    string ResolveQuoteRequestActionCode(SubmissionMarketDto? market)
    {
        var preferredCode = market switch
        {
            { LatestQuoteReceivedDateUtc: not null } => "RequestRevision",
            { LatestQuoteRequestVersion: > 0 } => "ResendUpdate",
            _ => "InitialRequest"
        };

        return PreferredOptionCode(_quoteRequestActionOptions, preferredCode, string.Empty);
    }

    string ResolveQuoteRequestMethodCode(SubmissionMarketDto? market)
    {
        var marketMethod = market?.LatestQuoteRequestMethodCode ?? market?.SubmissionMethodCode;
        if (!string.IsNullOrWhiteSpace(marketMethod))
        {
            var normalized = marketMethod switch
            {
                "API" or "CarrierApi" => "ApiRating",
                "Portal" => "MgaPortal",
                "Manual" or "InternalQueue" or "Download" => "ManualUnderwriter",
                _ => marketMethod
            };

            if (_quoteRequestMethodOptions.Any(option => string.Equals(option.OptionCode, normalized, StringComparison.OrdinalIgnoreCase)))
            {
                return normalized;
            }
        }

        var lineOfBusiness = _submission?.LineOfBusiness ?? string.Empty;
        if ((lineOfBusiness.Contains("Auto", StringComparison.OrdinalIgnoreCase)
            || lineOfBusiness.Contains("Home", StringComparison.OrdinalIgnoreCase)
            || lineOfBusiness.Contains("Rent", StringComparison.OrdinalIgnoreCase)
            || lineOfBusiness.Contains("Personal", StringComparison.OrdinalIgnoreCase))
            && _quoteRequestMethodOptions.Any(option => string.Equals(option.OptionCode, "ApiRating", StringComparison.OrdinalIgnoreCase)))
        {
            return "ApiRating";
        }

        return PreferredOptionCode(_quoteRequestMethodOptions, "ManualUnderwriter", DefaultOptionCode(_quoteRequestMethodOptions, string.Empty));
    }

    void ToggleQuoteRequestLine(Guid lineId, bool selected)
    {
        if (selected)
        {
            if (string.Equals(_actionForm.QuoteRequestScopeCode, "SingleLine", StringComparison.OrdinalIgnoreCase))
            {
                _selectedQuoteRequestLineIds.Clear();
            }
            _selectedQuoteRequestLineIds.Add(lineId);
        }
        else
        {
            _selectedQuoteRequestLineIds.Remove(lineId);
        }

        SyncQuoteRequestPremium();
    }

    void ApplyQuoteRequestScope()
    {
        if (string.Equals(_actionForm.QuoteRequestScopeCode, "SingleLine", StringComparison.OrdinalIgnoreCase) && _selectedQuoteRequestLineIds.Count != 1)
        {
            var firstLine = QuoteRequestCoverageLines.FirstOrDefault();
            _selectedQuoteRequestLineIds.Clear();
            if (firstLine is not null) _selectedQuoteRequestLineIds.Add(firstLine.SubmissionLineId);
        }
        else if (!string.Equals(_actionForm.QuoteRequestScopeCode, "SingleLine", StringComparison.OrdinalIgnoreCase) && !_selectedQuoteRequestLineIds.Any())
        {
            foreach (var line in QuoteRequestCoverageLines)
            {
                _selectedQuoteRequestLineIds.Add(line.SubmissionLineId);
            }
        }

        SyncQuoteRequestPremium();
    }

    void ResetQuoteRequestLines()
    {
        _selectedQuoteRequestLineIds.Clear();
        var scope = _actionForm.QuoteRequestScopeCode;
        var lines = QuoteRequestCoverageLines;
        if (string.Equals(scope, "SingleLine", StringComparison.OrdinalIgnoreCase))
        {
            var firstLine = lines.FirstOrDefault();
            if (firstLine is not null) _selectedQuoteRequestLineIds.Add(firstLine.SubmissionLineId);
            return;
        }

        foreach (var line in lines)
        {
            _selectedQuoteRequestLineIds.Add(line.SubmissionLineId);
        }
    }

