    static List<QuoteItem> BuildQuoteRows(int quoteCount, decimal? targetPremium, DateTime effectiveDate)
    {
        var premium = targetPremium.GetValueOrDefault(112000m);
        var quotes = new List<QuoteItem>
        {
            new() { Carrier = "Travelers", QuoteNo = "QT-2025-ENT-1001", Premium = premium, OccLimit = "$1,000,000", Aggregate = "$2,000,000", Deductible = "$5,000", EffDate = effectiveDate, ExpDate = DateTime.Today.AddDays(28), Notes = "Includes property enhancement endorsement." },
            new() { Carrier = "Chubb", QuoteNo = "QT-2025-ENT-1002", Premium = premium * 1.08m, OccLimit = "$1,000,000", Aggregate = "$2,000,000", Deductible = "$2,500", EffDate = effectiveDate, ExpDate = DateTime.Today.AddDays(21), Notes = "Subject to updated loss-run confirmation." }
        };

        var result = quotes.Take(Math.Max(0, quoteCount == 0 ? 1 : quoteCount)).ToList();
        if (result.Count > 0)
        {
            var low = result.Min(q => q.Premium);
            foreach (var quote in result) quote.IsLowest = quote.Premium == low;
        }

        return result;
    }

