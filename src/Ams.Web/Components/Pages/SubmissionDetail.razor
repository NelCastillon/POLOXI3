    [SupplyParameterFromQuery(Name = "proposalId")]
    public Guid? RequestedProposalId { get; set; }

    [SupplyParameterFromQuery(Name = "quoteId")]
    public Guid? RequestedQuoteId { get; set; }

    bool _loading = true;
    bool _actionBusy;
    bool _showActionDialog;
    RequestBindDialogContext? _requestBindContext;
    bool _showDocumentUpload;
    bool _uploadingCarrierQuote;
    bool _showDocumentMetadata;
    bool _documentBusy;
    bool _showConfirmDialog;
    bool _showQuoteRequestPopup;
    bool _showReadinessGatePopup;
    int _activeTab;
    string _activeKpi = "overview";
    string _commFilter = "All";
    string _refreshIconClass = string.Empty;
    string? _loadError;
    string _actionMode = string.Empty;
    string _actionTitle = string.Empty;
    string _actionIcon = "bi-lightning-charge";
    string _actionButtonText = "Continue";
    string _confirmTitle = string.Empty;
    string _confirmMessage = string.Empty;
    string? _quoteRequestInstruction;
    string? _quoteRequestError;
    bool _quoteRequestPopupIsError;
    string? _readinessGateContext;
    string _waiverReason = string.Empty;
    Guid? _selectedQuoteId;
    SubmissionMarketDto? _pendingRemoveMarket;
    DocumentDto? _selectedDocument;
    DocumentDto? _pendingDeleteDocument;
    SubmissionIntakeQuestionDto? _waiverTarget;
    CurrentUserContextModel? _currentUser;
    EnterpriseDocumentPreview? _documentPreview;
    DocumentMetadataForm _documentMetadataForm = new();

    SubmissionDto? _submission;
    SubmissionPackagePreviewDto? _packagePreview;
    readonly List<SubmissionMarketDto> _markets = [];
    readonly List<SubmissionMarketDto> _suggestedMarkets = [];
    readonly List<QuoteComparisonDto> _quotes = [];
     readonly List<SubmissionLineDto> _lines = [];
     readonly List<SubmissionIntakeQuestionDto> _intakeQuestions = [];
     readonly List<SubmissionDocumentChecklistDto> _documentChecklist = [];
     readonly List<SubmissionTaskTemplateDto> _taskTemplates = [];
     readonly List<ProposalWorkflowDto> _proposals = [];
    readonly List<ClientAcceptanceDto> _clientAcceptances = [];
    readonly List<SubmissionReferenceOptionDto> _bindConfirmationSourceOptions = [];
    readonly List<SubmissionReferenceOptionDto> _bindingMethodOptions = [];
    readonly List<SubmissionReferenceOptionDto> _bindingAuthorityOptions = [];
    readonly List<DocumentDto> _docs = [];
    readonly List<UwQuestion> _questions = [];
    readonly List<SubmissionActivityDto> _activity = [];
    readonly List<SubmissionTaskDto> _tasks = [];
    readonly List<UserDto> _users = [];
    readonly List<PolicyCreationSourceDto> _policyCreationSources = [];
    readonly List<PolicyBindStatusDto> _policyBindStatuses = [];
    readonly List<PolicyBindTransactionDto> _bindTransactions = [];
    readonly List<SubmissionReferenceOptionDto> _marketStatuses = [];
    readonly List<SubmissionReferenceOptionDto> _quoteStatuses = [];
    readonly List<SubmissionReferenceOptionDto> _submissionMethodOptions = [];
    readonly List<SubmissionReferenceOptionDto> _proposalDeliveryMethodOptions = [];
    readonly List<SubmissionReferenceOptionDto> _quoteRequestScopeOptions = [];
    readonly List<SubmissionReferenceOptionDto> _quoteRequestActionOptions = [];
    readonly List<SubmissionReferenceOptionDto> _quoteRequestReasonOptions = [];
    readonly List<SubmissionReferenceOptionDto> _quoteRequestMethodOptions = [];
    readonly List<SubmissionReferenceOptionDto> _quoteRequestBlockedStatusOptions = [];
    readonly List<SubmissionReferenceOptionDto> _customerAuthorizationMethodOptions = [];
    readonly HashSet<Guid> _selectedQuoteRequestLineIds = [];
    readonly List<QuoteLineForm> _quoteLineForms = [];
    readonly List<string> _quoteValidationErrors = [];
    readonly List<CommItem> _communications = [];
    readonly List<ToastMessage> _toasts = [];
    readonly ActionForm _actionForm = new();
     SubmissionReadinessDto? _readiness;
     SubmissionMarketDto? _selectedMarket;
     SubmissionMarketDto? _previewMarket;
     QuoteComparisonDto? _selectedQuote;
     SubmissionLineDto? _selectedCoverageLine;
     SubmissionLineDto? _marketFocusCoverageLine;
    readonly TabDef[] _tabs =
    [
        new(0, "overview", "Overview", "Submission profile", "Submission Overview", "Risk, account, priority, dates, and coverage intelligence.", "bi-speedometer2"),
        new(1, "markets", "Markets", "Carrier distribution", "Target Markets", "Real carrier market rows, appetite suggestions, and submit/quote actions.", "bi-bank"),
        new(2, "quotes", "Quotes", "Pricing", "Quote Comparison", "Quote options, lowest premium, and policy creation workflow.", "bi-journal-text"),
        new(3, "readiness", "Readiness", "Underwriting", "Question Readiness", "Required underwriting questions and readiness score.", "bi-question-circle"),
        new(4, "docs", "Documents", "Packet", "Submission Packet", "Derived application, schedule, and loss-run document checklist.", "bi-file-earmark-text"),
        new(5, "comms", "Comms", "Engagement", "Communications", "Client, carrier, and internal communication history.", "bi-chat-dots"),
        new(6, "activity", "Activity", "Timeline", "Activity Timeline", "Workflow events, actions, and audit-style activity.", "bi-activity")
    ];

    readonly string[] _commFilters = ["All", "Email", "Call", "Note", "SMS"];

    TabDef CurrentTab => _tabs[_activeTab];
    string PremiumDisplay => _submission?.TargetPremium is > 0 ? _submission.TargetPremium.Value.ToString("C0") : "Not set";
    string SubmissionLinesDisplay
    {
        get
        {
            var lines = _lines
                .Select(line => line.LineOfBusiness)
                .Where(line => !string.IsNullOrWhiteSpace(line))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            return lines.Count > 0 ? string.Join(" · ", lines) : Safe(_submission?.LineOfBusiness, "Line not set");
        }
    }
    int DaysToEffective => _submission is null ? 0 : (int)Math.Ceiling((_submission.EffectiveDate.Date - DateTime.Today).TotalDays);
    decimal LowestQuotePremium => _quotes.Any() ? _quotes.Min(q => q.AnnualPremium) : 0;
    int ReadinessPercent => _readiness?.ReadinessScore ?? 100;
    int ImportanceScore => CalculateImportanceScore();
    string ImportanceLabel => ImportanceScore >= 85 ? "Critical" : ImportanceScore >= 70 ? "High" : ImportanceScore >= 50 ? "Medium" : "Standard";
    IEnumerable<SubmissionMarketDto> VisibleMarkets => _activeKpi == "markets" ? _markets : _markets;
    IReadOnlyList<MarketStatusGroup> MarketStatusGroups => VisibleMarkets
        .GroupBy(m => Safe(m.Status, "Uncategorized"))
        .OrderBy(g => MarketStatusSortOrder(g.Key))
        .ThenBy(g => g.Key)
        .Select(g => new MarketStatusGroup(g.Key, g.OrderByDescending(m => m.IsRecommended).ThenByDescending(m => m.AppetiteScore).ThenBy(m => m.CarrierName).ToList()))
        .ToList();
    IEnumerable<QuoteComparisonDto> VisibleQuotes => _activeKpi == "premium" ? _quotes.OrderBy(q => q.AnnualPremium) : _quotes;
    IEnumerable<QuoteComparisonDto> ProposalReadyQuotes => _quotes.Where(q => q.IsProposalReady);
    bool CanGenerateProposal => ProposalReadyQuotes.Any();
    Guid? GeneratedPolicyId => _bindTransactions.Where(bind => bind.PolicyId.HasValue).OrderByDescending(bind => bind.CreatedDateUtc).Select(bind => bind.PolicyId).FirstOrDefault();
    bool IsHistoricalSubmission => GeneratedPolicyId.HasValue;
    string GenerateProposalTitle => IsHistoricalSubmission ? "Policy generation is complete; continue in the policy workspace." : CanGenerateProposal ? "Generate proposal from ready approved quotes." : "At least one non-expired reviewed quote must be approved for presentation with premium, coverage, deductible, carrier, and document data.";
    ProposalWorkflowDto? LatestProposal => _proposals.FirstOrDefault();
    ProposalWorkflowDto? ClientAcceptanceProposal => _proposals.FirstOrDefault(proposal =>
        string.Equals(proposal.GovernanceStatusCode, "Presented", StringComparison.OrdinalIgnoreCase)
        || string.Equals(proposal.Status, "Presented", StringComparison.OrdinalIgnoreCase)
        || proposal.PresentedDateUtc.HasValue) ?? LatestProposal;
    string LatestProposalDeliveryStatus => Safe(LatestProposal?.LatestDeliveryStatus, LatestProposal?.DeliveryStatus ?? "Not sent");
    string LatestProposalDeliveryTitle => LatestProposal?.LatestDeliveryDateUtc is DateTime deliveryDate
        ? $"Latest delivery status updated {deliveryDate.ToLocalTime():MMM d, yyyy h:mm tt}"
        : "No delivery has been recorded for the latest proposal version.";
    WorkflowGuidance CurrentWorkflowGuidance => BuildWorkflowGuidance();
    IReadOnlyList<SubmissionLineDto> QuoteRequestCoverageLines => _lines.Count > 0 ? _lines : [];
    IEnumerable<SubmissionLineDto> SelectedQuoteRequestLines => QuoteRequestCoverageLines.Where(l => _selectedQuoteRequestLineIds.Contains(l.SubmissionLineId));
    decimal QuoteRequestPackagePremium => SelectedQuoteRequestLines.Any() ? SelectedQuoteRequestLines.Sum(l => l.TargetPremium) : _submission?.TargetPremium ?? 0;
    bool _quoteLineSelectedExpressionValue = false;
    IEnumerable<CommItem> VisibleCommunications => _commFilter == "All" ? _communications : _communications.Where(c => c.Type == _commFilter);
    IEnumerable<IntelItem> CoverageInsights => BuildCoverageInsights();
    IEnumerable<string> ImportanceReasons => BuildImportanceReasons();
    IReadOnlyList<string> ReadinessBlockingReasons => _readiness?.BlockingReasons ?? [];
    bool RequiresQuoteRequestReason => _actionMode == "quote" && !string.Equals(_actionForm.QuoteRequestActionCode, "InitialRequest", StringComparison.OrdinalIgnoreCase);
    string ConfirmIconClass => _actionMode is "decline" or "remove-market" or "delete-document" ? "sdd-confirm-icon sdd-confirm-icon--danger" : "sdd-confirm-icon";
    string ConfirmButtonClass => _actionMode is "decline" or "remove-market" or "delete-document" ? "sdd-btn sdd-btn--danger" : "sdd-btn sdd-btn--primary";
    string ActionNotesLabel => _actionMode switch
    {
        "decline" => "Decline Reason",
        "quote" => "Quote Request Notes",
        "submit" => "Submission Notes",
        "copy" => "Copy Notes",
        _ => "Action Notes"
    };
    string ActionHelpText => _actionMode switch
    {
        "submit" => "Submit the package to a carrier market using the existing submit-to-market workflow.",
            "quote" => "Request quote terms using the existing quote request workflow. Choose a current market or let AMS auto-select the best recommended market.",
        "proposal" => "Generate a proposal record from available quotes.",
        "decline" => "Decline this submission and all eligible market rows with a required reason.",
        "copy" => "Create a new copied submission for renewal or remarketing.",
        _ => "Record a note, communication, or workflow action on the dashboard."
    };

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Submissions", "/submissions"), new("Detail", $"/submissions/{SubmissionId}"));
        await LoadAsync();

        if (_submission is not null)
        {
            if (string.Equals(RequestedTab, "markets", StringComparison.OrdinalIgnoreCase))
                SetTab(1);

            if (!string.IsNullOrWhiteSpace(RequestedAction))
            {
                if (string.Equals(RequestedAction, "document", StringComparison.OrdinalIgnoreCase))
                    OpenDocumentUpload();
                else if (RequestedAction is "proposal" or "proposal-delivery")
                    OpenProposalWorkflow();
                else if (string.Equals(RequestedAction, "quote-review", StringComparison.OrdinalIgnoreCase) && RequestedQuoteId.HasValue)
                {
                    var requestedQuote = _quotes.FirstOrDefault(quote => quote.QuoteId == RequestedQuoteId.Value);
                    if (requestedQuote is not null)
                    {
                        SetTab(2);
                        OpenQuoteReviewDialog(requestedQuote);
                    }
                }
                else
                {
                    OpenActionDialog(RequestedAction);
                    if (string.Equals(RequestedAction, "policy", StringComparison.OrdinalIgnoreCase) && RequestedProposalId.HasValue)
                        _actionForm.ProposalId = RequestedProposalId;
                }
            }
        }
    }

    async Task LoadAsync()
    {
        _loading = true;
        _refreshIconClass = "sdd-spin";
        _loadError = null;
        try
        {
            _currentUser ??= await CurrentUser.RequireAsync();
            _submission = await Api.GetSubmissionByIdAsync(SubmissionId);
            if (_submission is null)
            {
                return;
            }

            await LoadReferenceOptionsAsync(_submission.TenantId);
            var tenantId = _submission.TenantId;
            var intake = await Api.GetSubmissionIntakeAsync(SubmissionId) ?? [];
            var usersTask = Api.SearchUsersAsync(tenantId, pageSize: 100);
            var marketsTask = Api.GetSubmissionMarketsAsync(SubmissionId);
            var suggestionsTask = Api.GetSubmissionMarketSuggestionsAsync(SubmissionId);
            var quotesTask = Api.GetSubmissionQuoteComparisonAsync(SubmissionId, tenantId);
            var linesTask = Api.GetSubmissionLinesAsync(SubmissionId);
            var checklistTask = Api.GetSubmissionDocumentChecklistAsync(SubmissionId, tenantId);
            var templatesTask = Api.GetSubmissionTaskTemplatesAsync(tenantId);
            var proposalsTask = Api.GetSubmissionProposalsAsync(SubmissionId, tenantId);
            var acceptancesTask = Api.GetClientAcceptancesAsync(SubmissionId, tenantId);
            var documentsTask = Api.GetSubmissionDocumentsAsync(SubmissionId, tenantId);
            var activityTask = Api.GetSubmissionActivitiesAsync(SubmissionId);
            var tasksTask = Api.GetSubmissionTasksAsync(SubmissionId, tenantId);
            var policySourcesTask = Api.GetPolicyCreationSourcesAsync(tenantId);
            var bindStatusesTask = Api.GetPolicyBindStatusesAsync(tenantId);
            var bindTransactionsTask = Api.GetPolicyBindTransactionsAsync(SubmissionId);
            await Task.WhenAll(usersTask, marketsTask, suggestionsTask, quotesTask, linesTask, checklistTask, templatesTask, proposalsTask, acceptancesTask, documentsTask, activityTask, tasksTask, policySourcesTask, bindStatusesTask, bindTransactionsTask);

            _users.Clear();
            _users.AddRange((await usersTask)?.Items ?? []);

            _markets.Clear();
            _markets.AddRange(await marketsTask ?? []);

            _suggestedMarkets.Clear();
            _suggestedMarkets.AddRange(await suggestionsTask ?? []);

            _quotes.Clear();
            _quotes.AddRange(await quotesTask ?? []);
            _selectedQuoteId = _quotes.FirstOrDefault(q => q.IsSelected)?.QuoteId ?? _quotes.OrderByDescending(q => q.RecommendationScore).ThenBy(q => q.AnnualPremium).FirstOrDefault()?.QuoteId;

            _lines.Clear();
            _lines.AddRange(await linesTask ?? []);

            _intakeQuestions.Clear();
            _intakeQuestions.AddRange(intake);

            _documentChecklist.Clear();
            _documentChecklist.AddRange(await checklistTask ?? []);

            _readiness = BuildReadiness(_intakeQuestions, _documentChecklist);

            _taskTemplates.Clear();
            _taskTemplates.AddRange(await templatesTask ?? []);

            _proposals.Clear();
            _proposals.AddRange(await proposalsTask ?? []);

            _clientAcceptances.Clear();
            _clientAcceptances.AddRange(await acceptancesTask ?? []);

            _docs.Clear();
            _docs.AddRange(await documentsTask ?? []);

            _activity.Clear();
            _activity.AddRange(await activityTask ?? []);

            _tasks.Clear();
            _tasks.AddRange(await tasksTask ?? []);

            _policyCreationSources.Clear();
            _policyCreationSources.AddRange((await policySourcesTask ?? []).Where(x => x.IsActive && x.RequiresQuote).OrderBy(x => x.SortOrder).ThenBy(x => x.SourceName));

            _policyBindStatuses.Clear();
            _policyBindStatuses.AddRange((await bindStatusesTask ?? []).Where(x => x.IsActive).OrderBy(x => x.SortOrder).ThenBy(x => x.StatusName));

            _bindTransactions.Clear();
            _bindTransactions.AddRange(await bindTransactionsTask ?? []);

            BuildDerivedDashboardData();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load submission detail: {ex.Message}";
            ShowToast(_loadError, true);
        }
        finally
        {
            _loading = false;
            _refreshIconClass = string.Empty;
        }
    }

    void BuildDerivedDashboardData()
    {
        if (_submission is null) return;
        _questions.Clear();
        _questions.AddRange(_intakeQuestions.Select((q, index) => new UwQuestion(index + 1, q.QuestionText, q.IsRequired, q.IsAnswered, q.HelpText)));
        _communications.Clear();
        _communications.AddRange(_activity.Select(a => new CommItem(a.ActionCode, Safe(a.Title, a.ActionCode), Safe(a.CreatedByName, "System"), "Submission workflow", a.Notes ?? string.Empty, a.CreatedDateUtc.ToLocalTime())));
    }

    SubmissionReadinessDto BuildReadiness(IReadOnlyCollection<SubmissionIntakeQuestionDto> intake, IReadOnlyCollection<SubmissionDocumentChecklistDto> checklist)
    {
        static bool IsSatisfied(SubmissionIntakeQuestionDto question) => question.StatusCode.Equals("Waived", StringComparison.OrdinalIgnoreCase)
            || ((question.IsAnswered || question.StatusCode.Equals("Confirmed", StringComparison.OrdinalIgnoreCase)) && (!question.RequiresEvidence || question.EvidenceDocuments.Count > 0));

        var blockingQuestions = intake.Where(question => question.IsRequired && question.BlocksSubmit).ToArray();
        var requiredQuestionWeight = blockingQuestions.Sum(question => Math.Max(question.ScoreWeight, 1));
        var satisfiedQuestionWeight = blockingQuestions.Where(IsSatisfied).Sum(question => Math.Max(question.ScoreWeight, 1));
        var requiredDocumentWeight = checklist.Count(document => document.IsRequired);
        var satisfiedDocumentWeight = checklist.Count(document => document.IsRequired && document.IsSatisfied);
        var totalWeight = requiredQuestionWeight + requiredDocumentWeight;
        var completedWeight = satisfiedQuestionWeight + satisfiedDocumentWeight;
        var blockingReasons = blockingQuestions.Where(question => !IsSatisfied(question)).Select(question => question.RequiresEvidence && question.EvidenceDocuments.Count == 0 && (question.IsAnswered || question.StatusCode.Equals("Confirmed", StringComparison.OrdinalIgnoreCase))
                ? $"Missing evidence: {question.QuestionText}"
                : $"Missing intake: {question.QuestionText}")
            .Concat(checklist.Where(document => document.IsRequired && !document.IsSatisfied).Select(document => $"Missing document: {document.DisplayName}"))
            .ToArray();

        return new SubmissionReadinessDto
        {
            SubmissionId = SubmissionId,
            ReadinessScore = totalWeight == 0 ? 100 : (int)Math.Round((double)completedWeight / totalWeight * 100),
            RequiredQuestionCount = blockingQuestions.Length,
            AnsweredRequiredQuestionCount = blockingQuestions.Count(IsSatisfied),
            WaivedRequiredQuestionCount = blockingQuestions.Count(question => question.StatusCode.Equals("Waived", StringComparison.OrdinalIgnoreCase)),
            RequiredQuestionScoreWeight = requiredQuestionWeight,
            SatisfiedQuestionScoreWeight = satisfiedQuestionWeight,
            RequiredDocumentCount = requiredDocumentWeight,
            SatisfiedRequiredDocumentCount = satisfiedDocumentWeight,
            IsReadyForMarketing = blockingReasons.Length == 0,
            BlockingReasons = blockingReasons
        };
    }

