@page "/submissions/{SubmissionId:guid}"
@namespace Ams.Web.Components.Pages
@using Ams.Web.Components.Shared
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@(_sub is null ? "Submission" : _sub.SubmissionNumber) — Submission Detail</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@if (_loading)
{
    <div class="sd-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading submission…</span></div>
}
else if (_sub is null)
{
    <div class="sd-not-found">
        <i class="bi bi-send-x sd-nf-icon" aria-hidden="true"></i>
        <h2>Submission not found</h2>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/submissions")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Submissions
        </button>
    </div>
}
else
{
    <!-- ── HEADER ─────────────────────────────────────────────────── -->
    <div class="sd-header">
        <div class="sd-header-left">
            <div class="sd-lob-icon sd-lob-@LobKey(_sub.LineOfBusiness)">
                <i class="bi @LobIcon(_sub.LineOfBusiness)" aria-hidden="true"></i>
            </div>
            <div class="sd-header-info">
                <div class="sd-title-row">
                    <h1 class="sd-sub-num">@_sub.SubmissionNumber</h1>
                    <span class="sd-status sd-status-@CssStatus(_sub.Status)">@_sub.Status</span>
                    <span class="sd-lob-badge sd-lob-@LobKey(_sub.LineOfBusiness)">@_sub.LineOfBusiness</span>
                    @if (!string.IsNullOrEmpty(_sub.Priority))
                    {
                        <span class="sd-priority sd-priority-@_sub.Priority.ToLower()">
                            <i class="bi bi-flag-fill" aria-hidden="true"></i> @_sub.Priority
                        </span>
                    }
                </div>
                <div class="sd-sub-row">
                    <button class="sd-acct-link" @onclick='() => Nav.NavigateTo("/accounts/detail")'>
                        <i class="bi bi-building" aria-hidden="true"></i>@_sub.AccountName
                    </button>
                    <span class="sd-sub-chip"><i class="bi bi-person-workspace" aria-hidden="true"></i>@_sub.Producer</span>
                    <span class="sd-sub-chip"><i class="bi bi-calendar-event" aria-hidden="true"></i>Eff: @_sub.EffDate.ToString("MM/dd/yyyy")</span>
                    <span class="sd-sub-chip"><i class="bi bi-send" aria-hidden="true"></i>Submitted: @_sub.SubmitDate.ToString("MM/dd/yyyy")</span>
                    @if (_sub.DueDate.HasValue)
                    {
                        var days = (_sub.DueDate.Value - DateTime.Today).TotalDays;
                        <span class="sd-sub-chip @(days < 0 ? "sd-chip-late" : days <= 3 ? "sd-chip-soon" : "")">
                            <i class="bi bi-clock" aria-hidden="true"></i>
                            Due: @_sub.DueDate.Value.ToString("MM/dd/yyyy")
                        </span>
                    }
                </div>
            </div>
        </div>
        <div class="sd-header-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("submit")'>
                <i class="bi bi-send" aria-hidden="true"></i> Submit to Market
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("quote")'>
                <i class="bi bi-journal-text" aria-hidden="true"></i> Request Quote
            </button>
            @if (_sub.Status == "Quoted")
            {
                <button class="um-btn um-btn-success um-btn-sm" @onclick='() => OpenAction("bind")'>
                    <i class="bi bi-shield-check" aria-hidden="true"></i> Bind
                </button>
            }
            @if (_sub.Status == "Bound")
            {
                <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/new")'>
                    <i class="bi bi-shield-plus" aria-hidden="true"></i> Create Policy
                </button>
            }
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("copy")'>
                <i class="bi bi-copy" aria-hidden="true"></i> Copy
            </button>
            <button class="um-btn um-btn-danger um-btn-sm" @onclick='() => OpenAction("decline")'>
                <i class="bi bi-x-circle" aria-hidden="true"></i> Decline
            </button>
        </div>
    </div>

    <!-- ── KPI STRIP ─────────────────────────────────────────────── -->
    <div class="sd-kpi-strip">
        @KpiCard("bi-building",       "Markets Targeted",  _markets.Count.ToString(),                         "sd-kpi-mkt",  "markets", 1)
        @KpiCard("bi-send-check",     "Submitted To",      _markets.Count(m=>m.Status!="Pending").ToString(), "sd-kpi-sent", "submitted", 1)
        @KpiCard("bi-journal-text",   "Quotes Received",   _quotes.Count.ToString(),                          "sd-kpi-q",    "quotes", 4)
        @KpiCard("bi-cash-stack",     "Lowest Quote",      _quotes.Any() ? _quotes.Min(q=>q.Premium).ToString("C0") : "—", "sd-kpi-low", "lowest", 4)
        @KpiCard("bi-cash-coin",      "Highest Quote",     _quotes.Any() ? _quotes.Max(q=>q.Premium).ToString("C0") : "—", "sd-kpi-high", "highest", 4)
        @KpiCard("bi-file-earmark",   "Documents",         _docs.Count.ToString(),                            "sd-kpi-doc",  "docs", 2)
    </div>

    <!-- ── TABS ──────────────────────────────────────────────────── -->
    <AppDetailTabs @bind-SelectedTab="_tab">
        <Tabs>

            <!-- ① Risk Data -->
            <TabItem>
                <ChildContent><TabHeader Text="Risk Data" IconCss="bi bi-clipboard-data" /></ChildContent>
                <ContentTemplate>
                    <div class="sd-tab-body">
                        <div class="sd-section-grid">
                            <!-- Named insured & contact -->
                            <div class="sd-section sd-section-span2">
                                <div class="sd-section-head">
                                    <i class="bi bi-person-badge" aria-hidden="true"></i> Named Insured &amp; Contact
                                </div>
                                <div class="sd-field-grid">
                                    @FieldRow("Named Insured",  _sub.Insured)
                                    @FieldRow("DBA",            _sub.Dba)
                                    @FieldRow("FEIN",           _sub.Fein)
                                    @FieldRow("Contact Name",   _sub.ContactName)
                                    @FieldRow("Phone",          _sub.ContactPhone)
                                    @FieldRow("Email",          _sub.ContactEmail)
                                    @FieldRow("Website",        _sub.Website)
                                    @FieldRow("Mailing Address",_sub.Address)
                                    @FieldRow("Risk Location",  _sub.RiskAddress)
                                </div>
                            </div>

                            <!-- Business info -->
                            <div class="sd-section">
                                <div class="sd-section-head">
                                    <i class="bi bi-briefcase" aria-hidden="true"></i> Business Information
                                </div>
                                <div class="sd-field-grid">
                                    @FieldRow("Entity Type",     _sub.EntityType)
                                    @FieldRow("Year Founded",    _sub.YearFounded)
                                    @FieldRow("SIC / NAICS",     _sub.SicNaics)
                                    @FieldRow("Description",     _sub.BusinessDesc)
                                    @FieldRow("Years in Business", _sub.YearsInBusiness)
                                    @FieldRow("Prior Carrier",   _sub.PriorCarrier)
                                    @FieldRow("Prior Premium",   _sub.PriorPremium.ToString("C0"))
                                </div>
                            </div>

                            <!-- Exposures -->
                            <div class="sd-section">
                                <div class="sd-section-head">
                                    <i class="bi bi-bar-chart" aria-hidden="true"></i> Exposure Data
                                </div>
                                <div class="sd-field-grid">
                                    @foreach (var exp in _sub.Exposures)
                                    {
                                        @FieldRow(exp.Key, exp.Value)
                                    }
                                </div>
                            </div>

                            <!-- Requested coverages -->
                            <div class="sd-section sd-section-span2">
                                <div class="sd-section-head">
                                    <i class="bi bi-shield-plus" aria-hidden="true"></i> Requested Coverages &amp; Limits
                                </div>
                                <table class="sd-cov-table">
                                    <thead>
                                        <tr>
                                            <th>Coverage</th>
                                            <th>Occurrence Limit</th>
                                            <th>Aggregate</th>
                                            <th>Deductible</th>
                                            <th>Requested</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cov in _sub.Coverages)
                                        {
                                            <tr>
                                                <td class="sd-cov-name">@cov.Name</td>
                                                <td>@cov.OccLimit</td>
                                                <td>@cov.Aggregate</td>
                                                <td>@cov.Deductible</td>
                                                <td><span class="sd-cov-req @(cov.Requested ? "sd-cov-yes" : "sd-cov-no")">@(cov.Requested ? "Yes" : "No")</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Loss history -->
                            <div class="sd-section sd-section-span2">
                                <div class="sd-section-head">
                                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Loss History (5-Year)
                                </div>
                                <table class="sd-loss-table">
                                    <thead><tr><th>Year</th><th>Carrier</th><th>Claims</th><th>Paid</th><th>Reserved</th><th>Total Incurred</th><th>Description</th></tr></thead>
                                    <tbody>
                                        @foreach (var loss in _sub.LossHistory)
                                        {
                                            <tr>
                                                <td>@loss.Year</td>
                                                <td>@loss.Carrier</td>
                                                <td>@loss.Claims</td>
                                                <td>@loss.Paid.ToString("C0")</td>
                                                <td>@loss.Reserved.ToString("C0")</td>
                                                <td class="sd-loss-incurred">@(loss.Paid+loss.Reserved).ToString("C0")</td>
                                                <td class="sd-loss-desc">@loss.Description</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- ② Markets -->
            <TabItem>
                <ChildContent><TabHeader Text="Markets" IconCss="bi bi-building-fill" /></ChildContent>
                <ContentTemplate>
                    <div class="sd-tab-body">
                        <div class="sd-tab-toolbar">
                            <span class="sd-toolbar-title">
                                <i class="bi bi-building-fill" aria-hidden="true"></i>
                                @_markets.Count targeted market@(_markets.Count==1?"":"s")
                            </span>
                            <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => _showAddMarket = true'>
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Market
                            </button>
                        </div>
                        <div class="sd-market-grid">
                            @foreach (var mkt in FilteredMarkets)
                            {
                                <div class="sd-mkt-card sd-mkt-@CssMktStatus(mkt.Status)">
                                    <div class="sd-mkt-head">
                                        <div class="sd-mkt-carrier">
                                            <div class="sd-mkt-carrier-icon"><i class="bi bi-building" aria-hidden="true"></i></div>
                                            <div>
                                                <div class="sd-mkt-carrier-name">@mkt.Carrier</div>
                                                <div class="sd-mkt-underwriter">@mkt.Underwriter</div>
                                            </div>
                                        </div>
                                        <span class="sd-mkt-status sd-mkt-st-@CssMktStatus(mkt.Status)">@mkt.Status</span>
                                    </div>
                                    <div class="sd-mkt-meta">
                                        @if (mkt.SubmitDate.HasValue)
                                        {
                                            <span class="sd-mkt-meta-chip"><i class="bi bi-send" aria-hidden="true"></i>Sent @mkt.SubmitDate.Value.ToString("MM/dd/yy")</span>
                                        }
                                        @if (mkt.DueDate.HasValue)
                                        {
                                            <span class="sd-mkt-meta-chip"><i class="bi bi-clock" aria-hidden="true"></i>Due @mkt.DueDate.Value.ToString("MM/dd/yy")</span>
                                        }
                                        @if (!string.IsNullOrEmpty(mkt.QuoteRef))
                                        {
                                            <span class="sd-mkt-meta-chip sd-mkt-qref"><i class="bi bi-journal-text" aria-hidden="true"></i>@mkt.QuoteRef</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(mkt.Notes))
                                    {
                                        <div class="sd-mkt-notes">@mkt.Notes</div>
                                    }
                                    <div class="sd-mkt-actions">
                                        @if (mkt.Status == "Pending")
                                        {
                                            <button class="um-btn um-btn-primary um-btn-xs" @onclick="() => SubmitMarket(mkt)">
                                                <i class="bi bi-send" aria-hidden="true"></i> Submit
                                            </button>
                                        }
                                        @if (mkt.Status == "Awaiting Quote")
                                        {
                                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => EnterQuoteMarket(mkt)">
                                                <i class="bi bi-journal-plus" aria-hidden="true"></i> Enter Quote
                                            </button>
                                        }
                                        <button class="um-btn um-btn-ghost um-btn-xs">
                                            <i class="bi bi-three-dots" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- ③ Documents -->
            <TabItem>
                <ChildContent><TabHeader Text="Documents" IconCss="bi bi-file-earmark-text" /></ChildContent>
                <ContentTemplate>
                    <div class="sd-tab-body">
                        <div class="sd-tab-toolbar">
                            <span class="sd-toolbar-title">
                                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                                 @FilteredDocs.Count() document@(FilteredDocs.Count()==1?"":"s")
                            </span>
                            <button class="um-btn um-btn-primary um-btn-sm">
                                <i class="bi bi-cloud-upload" aria-hidden="true"></i> Upload
                            </button>
                        </div>
                        <div class="sd-doc-type-groups">
                            @foreach (var grp in FilteredDocs.GroupBy(d => d.DocType))
                            {
                                <div class="sd-doc-group">
                                    <div class="sd-doc-group-head">@grp.Key <span>(@grp.Count())</span></div>
                                    <div class="sd-doc-list">
                                        @foreach (var doc in grp)
                                        {
                                            <div class="sd-doc-row">
                                                <div class="sd-doc-icon sd-doc-icon-@DocExt(doc.FileName)">
                                                    <i class="bi @DocIcon(doc.FileName)" aria-hidden="true"></i>
                                                </div>
                                                <div class="sd-doc-info">
                                                    <div class="sd-doc-name">@doc.FileName</div>
                                                    <div class="sd-doc-meta">@doc.UploadedBy · @doc.UploadedDate.ToString("MM/dd/yyyy") · @doc.Size</div>
                                                </div>
                                                <div class="sd-doc-actions">
                                                    @if (!string.IsNullOrEmpty(doc.Version))
                                                    {
                                                        <span class="sd-doc-ver">v@doc.Version</span>
                                                    }
                                                    <button class="um-btn um-btn-ghost um-btn-xs"><i class="bi bi-download" aria-hidden="true"></i></button>
                                                    <button class="um-btn um-btn-ghost um-btn-xs"><i class="bi bi-share" aria-hidden="true"></i></button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- ④ Questions -->
            <TabItem>
                <ChildContent><TabHeader Text="Questions" IconCss="bi bi-question-circle" /></ChildContent>
                <ContentTemplate>
                    <div class="sd-tab-body">
                        <div class="sd-tab-toolbar">
                            <span class="sd-toolbar-title">
                                <i class="bi bi-question-circle" aria-hidden="true"></i>
                                @_questions.Count(q=>q.Answered) of @_questions.Count answered
                            </span>
                            <div class="sd-q-progress-bar-wrap">
                                <div class="sd-q-progress-bar" style="width:@QProgress%"></div>
                            </div>
                            <button class="um-btn um-btn-primary um-btn-sm" @onclick="MarkAllAnswered">
                                <i class="bi bi-check-all" aria-hidden="true"></i> Mark All Answered
                            </button>
                        </div>
                        <div class="sd-question-list">
                            @foreach (var (sec, qList) in _questions.GroupBy(q => q.Section).Select(g => (g.Key, g.ToList())))
                            {
                                <div class="sd-q-section">
                                    <div class="sd-q-section-head">@sec</div>
                                    @foreach (var q in qList)
                                    {
                                        <div class="sd-q-row @(q.Required && !q.Answered ? "sd-q-required" : "")">
                                            <div class="sd-q-left">
                                                <div class="sd-q-num">Q@q.Number</div>
                                                @if (q.Required) { <span class="sd-q-req-dot" title="Required">*</span> }
                                            </div>
                                            <div class="sd-q-body">
                                                <div class="sd-q-text">@q.Text</div>
                                                @if (q.AnswerType == "bool")
                                                {
                                                    <div class="sd-q-ans-bool">
                                                        <button class="sd-q-bool-btn @(q.BoolAnswer==true?"sd-q-bool-yes":"")" @onclick="() => { q.BoolAnswer = true; q.Answered = true; }">Yes</button>
                                                        <button class="sd-q-bool-btn @(q.BoolAnswer==false?"sd-q-bool-no":"")" @onclick="() => { q.BoolAnswer = false; q.Answered = true; }">No</button>
                                                    </div>
                                                }
                                                else if (q.AnswerType == "text")
                                                {
                                                    <textarea class="e-input sd-q-textarea" rows="2"
                                                              placeholder="Enter answer…"
                                                              @bind="q.TextAnswer"
                                                              @onblur="() => q.Answered = !string.IsNullOrWhiteSpace(q.TextAnswer)"></textarea>
                                                }
                                                else if (q.AnswerType == "number")
                                                {
                                                    <input type="number" class="e-input sd-q-input"
                                                           placeholder="Enter value…"
                                                           @bind="q.TextAnswer"
                                                           @onblur="() => q.Answered = !string.IsNullOrWhiteSpace(q.TextAnswer)" />
                                                }
                                                @if (!string.IsNullOrEmpty(q.HelpText))
                                                {
                                                    <div class="sd-q-help">@q.HelpText</div>
                                                }
                                            </div>
                                            <div class="sd-q-check">
                                                @if (q.Answered)
                                                {
                                                    <i class="bi bi-check-circle-fill sd-q-done" aria-hidden="true"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-circle sd-q-open" aria-hidden="true"></i>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- ⑤ Quotes -->
            <TabItem>
                <ChildContent><TabHeader Text="Quotes" IconCss="bi bi-journal-text" /></ChildContent>
                <ContentTemplate>
                    <div class="sd-tab-body">
                        <div class="sd-tab-toolbar">
                            <span class="sd-toolbar-title">
                                <i class="bi bi-journal-text" aria-hidden="true"></i>
                                @FilteredQuotes.Count() quote@(FilteredQuotes.Count()==1?"":"s") received
                            </span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => _showAddQuote = true'>
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Enter Quote
                            </button>
                        </div>
                        @if (!FilteredQuotes.Any())
                        {
                            <div class="sd-empty-state">
                                <i class="bi bi-journal-x sd-empty-icon" aria-hidden="true"></i>
                                <p>No quotes received yet. Submit to markets to request quotes.</p>
                            </div>
                        }
                        else
                        {
                            <div class="sd-quote-grid">
                                @foreach (var q in FilteredQuotes.OrderBy(q => q.Premium))
                                {
                                    <div class="sd-quote-card @(q.Selected ? "sd-quote-selected" : "") @(q.IsLowest ? "sd-quote-lowest" : "")">
                                        @if (q.IsLowest)
                                        {
                                            <div class="sd-quote-lowest-banner">
                                                <i class="bi bi-trophy-fill" aria-hidden="true"></i> Lowest Premium
                                            </div>
                                        }
                                        <div class="sd-quote-head">
                                            <div class="sd-quote-carrier">@q.Carrier</div>
                                            <div class="sd-quote-premium">@q.Premium.ToString("C0")</div>
                                        </div>
                                        <div class="sd-quote-meta">
                                            <div class="sd-quote-field">
                                                <span class="sd-qf-lbl">Quote #</span>
                                                <span class="sd-qf-val">@q.QuoteNo</span>
                                            </div>
                                            <div class="sd-quote-field">
                                                <span class="sd-qf-lbl">Effective</span>
                                                <span class="sd-qf-val">@q.EffDate.ToString("MM/dd/yyyy")</span>
                                            </div>
                                            <div class="sd-quote-field">
                                                <span class="sd-qf-lbl">Expires</span>
                                                <span class="sd-qf-val @((q.ExpDate < DateTime.Today) ? "sd-exp-past" : (q.ExpDate - DateTime.Today).TotalDays <= 10 ? "sd-exp-soon" : "")">@q.ExpDate.ToString("MM/dd/yyyy")</span>
                                            </div>
                                            <div class="sd-quote-field">
                                                <span class="sd-qf-lbl">Occ. Limit</span>
                                                <span class="sd-qf-val">@q.OccLimit</span>
                                            </div>
                                            <div class="sd-quote-field">
                                                <span class="sd-qf-lbl">Aggregate</span>
                                                <span class="sd-qf-val">@q.Aggregate</span>
                                            </div>
                                            <div class="sd-quote-field">
                                                <span class="sd-qf-lbl">Deductible</span>
                                                <span class="sd-qf-val">@q.Deductible</span>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(q.Notes))
                                        {
                                            <div class="sd-quote-notes">@q.Notes</div>
                                        }
                                        <div class="sd-quote-actions">
                                            <button class="um-btn @(q.Selected ? "um-btn-success" : "um-btn-ghost") um-btn-sm"
                                                    @onclick="() => SelectQuote(q)">
                                                <i class="bi @(q.Selected ? "bi-check-circle-fill" : "bi-circle") " aria-hidden="true"></i>
                                                @(q.Selected ? "Selected" : "Select")
                                            </button>
                                            <button class="um-btn um-btn-primary um-btn-sm" @onclick="() => BindQuote(q)">
                                                <i class="bi bi-shield-check" aria-hidden="true"></i> Bind
                                            </button>
                                            <button class="um-btn um-btn-ghost um-btn-sm">
                                                <i class="bi bi-download" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- ⑥ Activity -->
            <TabItem>
                <ChildContent><TabHeader Text="Activity" IconCss="bi bi-activity" /></ChildContent>
                <ContentTemplate>
                    <div class="sd-tab-body">
                        <div class="sd-tab-toolbar">
                            <span class="sd-toolbar-title"><i class="bi bi-activity" aria-hidden="true"></i> Activity Log</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => _showAddNote = true'>
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Note
                            </button>
                        </div>
                        <div class="sd-activity-feed">
                            @foreach (var act in _activity.OrderByDescending(a => a.When))
                            {
                                <div class="sd-act-row">
                                    <div class="sd-act-icon sd-act-@act.Type">
                                        <i class="bi @ActivityIcon(act.Type)" aria-hidden="true"></i>
                                    </div>
                                    <div class="sd-act-content">
                                        <div class="sd-act-head">
                                            <span class="sd-act-user">@act.User</span>
                                            <span class="sd-act-action">@act.Action</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(act.Detail))
                                        {
                                            <div class="sd-act-detail">@act.Detail</div>
                                        }
                                        <div class="sd-act-when">@act.When.ToString("MMM d, yyyy h:mm tt")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- ⑦ Communications -->
            <TabItem>
                <ChildContent><TabHeader Text="Communications" IconCss="bi bi-chat-dots" /></ChildContent>
                <ContentTemplate>
                    <div class="sd-tab-body">
                        <div class="sd-tab-toolbar">
                            <span class="sd-toolbar-title"><i class="bi bi-chat-dots" aria-hidden="true"></i> Communications</span>
                            <div class="sd-comm-actions">
                                <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("email")'>
                                    <i class="bi bi-envelope" aria-hidden="true"></i> Email
                                </button>
                                <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAction("call")'>
                                    <i class="bi bi-telephone" aria-hidden="true"></i> Log Call
                                </button>
                                <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => OpenAction("note")'>
                                    <i class="bi bi-sticky" aria-hidden="true"></i> Note
                                </button>
                            </div>
                        </div>
                        <div class="sd-comm-filter">
                            @foreach (var f in new[]{"All","Email","Call","Note","SMS"})
                            {
                                <button class="sd-comm-filter-btn @(_commFilter==f ? "sd-comm-filter-active" : "")"
                                        @onclick="() => _commFilter = f">@f</button>
                            }
                        </div>
                        <div class="sd-comm-list">
                            @foreach (var comm in _comms.Where(c => _commFilter == "All" || c.Type == _commFilter).OrderByDescending(c => c.When))
                            {
                                <div class="sd-comm-item sd-comm-@comm.Type.ToLower()">
                                    <div class="sd-comm-icon">
                                        <i class="bi @CommIcon(comm.Type)" aria-hidden="true"></i>
                                    </div>
                                    <div class="sd-comm-body">
                                        <div class="sd-comm-head">
                                            <span class="sd-comm-type-badge sd-comm-badge-@comm.Type.ToLower()">@comm.Type</span>
                                            <span class="sd-comm-subject">@comm.Subject</span>
                                            <span class="sd-comm-when">@comm.When.ToString("MMM d, yyyy h:mm tt")</span>
                                        </div>
                                        <div class="sd-comm-parties">
                                            <span><i class="bi bi-person" aria-hidden="true"></i> @comm.From</span>
                                            @if (!string.IsNullOrEmpty(comm.To))
                                            {
                                                <span><i class="bi bi-arrow-right" aria-hidden="true"></i> @comm.To</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(comm.Body))
                                        {
                                            <div class="sd-comm-preview">@comm.Body</div>
                                        }
                                        @if (comm.HasAttachment)
                                        {
                                            <div class="sd-comm-attach"><i class="bi bi-paperclip" aria-hidden="true"></i> Attachment</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- ⑧ Timeline -->
            <TabItem>
                <ChildContent><TabHeader Text="Timeline" IconCss="bi bi-clock-history" /></ChildContent>
                <ContentTemplate>
                    <div class="sd-tab-body">
                        <div class="sd-tab-toolbar">
                            <span class="sd-toolbar-title"><i class="bi bi-clock-history" aria-hidden="true"></i> Submission Timeline</span>
                        </div>
                        <div class="sd-timeline-wrap">
                            <PolicyChangeTimeline Events="@_timelineEvents" />
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

        </Tabs>
    </AppDetailTabs>

    <!-- ── ACTION DIALOG ─────────────────────────────────────────── -->
    <SfDialog @bind-Visible="_showActionDlg" Width="500px" IsModal="true" ShowCloseIcon="true" Header="@_actionTitle">
        <DialogTemplates>
            <Content>
                <div class="sd-dlg-fields">
                    @if (_actionMode == "submit")
                    {
                        <p class="sd-dlg-intro">Select which markets to submit this submission to:</p>
                        @foreach (var mkt in _markets.Where(m => m.Status == "Pending"))
                        {
                            <label class="sd-dlg-check-row">
                                <SfCheckBox @bind-Checked="mkt.Selected" />
                                <span>@mkt.Carrier</span>
                                <span class="sd-dlg-mkt-uw">@mkt.Underwriter</span>
                            </label>
                        }
                        @if (!_markets.Any(m => m.Status == "Pending"))
                        {
                            <p class="sd-dlg-muted">All markets have already been submitted.</p>
                        }
                    }
                    else if (_actionMode is "bind")
                    {
                        <p class="sd-dlg-intro">Select the quote to bind:</p>
                        @foreach (var qt in _quotes)
                        {
                            <label class="sd-dlg-check-row">
                                <SfCheckBox @bind-Checked="qt.Selected" />
                                <span class="sd-dlg-qt-carrier">@qt.Carrier</span>
                                <span class="sd-dlg-qt-prem">@qt.Premium.ToString("C0")</span>
                            </label>
                        }
                    }
                    else if (_actionMode is "decline" or "copy")
                    {
                        <div class="sd-dlg-field">
                            <label class="sd-dlg-lbl">Notes</label>
                            <textarea class="e-input" rows="3" @bind="_actionNotes"></textarea>
                        </div>
                    }
                    else
                    {
                        <div class="sd-dlg-field">
                            <label class="sd-dlg-lbl">Notes / Details</label>
                            <textarea class="e-input" rows="3" @bind="_actionNotes"></textarea>
                        </div>
                    }
                </div>
            </Content>
            <FooterTemplate>
                <button class="um-btn um-btn-ghost" @onclick='() => _showActionDlg = false'>Cancel</button>
                <button class="um-btn @(_actionMode=="decline" ? "um-btn-danger" : "um-btn-primary")"
                        @onclick="ExecuteAction">
                    @_actionTitle
                </button>
            </FooterTemplate>
        </DialogTemplates>
    </SfDialog>

    <!-- ── ADD MARKET DIALOG ─────────────────────────────────────── -->
    <SfDialog @bind-Visible="_showAddMarket" Width="440px" IsModal="true" ShowCloseIcon="true" Header="Add Market">
        <DialogTemplates>
            <Content>
                <div class="sd-dlg-fields">
                    <div class="sd-dlg-field">
                        <label class="sd-dlg-lbl">Carrier / Market</label>
                        <input class="e-input" @bind="_newMarket.Carrier" placeholder="Carrier name…" />
                    </div>
                    <div class="sd-dlg-field">
                        <label class="sd-dlg-lbl">Underwriter / Contact</label>
                        <input class="e-input" @bind="_newMarket.Underwriter" />
                    </div>
                    <div class="sd-dlg-field">
                        <label class="sd-dlg-lbl">Target Premium</label>
                        <SfNumericTextBox TValue="decimal" @bind-Value="_newMarket.TargetPremium" Format="N0" />
                    </div>
                    <div class="sd-dlg-field">
                        <label class="sd-dlg-lbl">Notes</label>
                        <textarea class="e-input" rows="2" @bind="_newMarket.Notes"></textarea>
                    </div>
                </div>
            </Content>
            <FooterTemplate>
                <button class="um-btn um-btn-ghost" @onclick='() => _showAddMarket = false'>Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="AddMarket">Add</button>
            </FooterTemplate>
        </DialogTemplates>
    </SfDialog>

    <!-- ── ADD QUOTE DIALOG ──────────────────────────────────────── -->
    <SfDialog @bind-Visible="_showAddQuote" Width="560px" IsModal="true" ShowCloseIcon="true" Header="Enter Quote">
        <DialogTemplates>
            <Content>
                <div class="sd-dlg-fields">
                    <div class="sd-dlg-field">
                        <label class="sd-dlg-lbl">Carrier</label>
                        <input class="e-input" @bind="_newQuote.Carrier" />
                    </div>
                    <div class="sd-dlg-field">
                        <label class="sd-dlg-lbl">Quote Number</label>
                        <input class="e-input" @bind="_newQuote.QuoteNo" />
                    </div>
                    <div class="sd-dlg-field">
                        <label class="sd-dlg-lbl">Annual Premium</label>
                        <SfNumericTextBox TValue="decimal" @bind-Value="_newQuote.Premium" Format="N0" />
                    </div>
                    <div class="sd-dlg-field">
                        <label class="sd-dlg-lbl">Occurrence Limit</label>
                        <input class="e-input" @bind="_newQuote.OccLimit" placeholder="$1,000,000" />
                    </div>
                    <div class="sd-dlg-field">
                        <label class="sd-dlg-lbl">Aggregate</label>
                        <input class="e-input" @bind="_newQuote.Aggregate" placeholder="$2,000,000" />
                    </div>
                    <div class="sd-dlg-field">
                        <label class="sd-dlg-lbl">Deductible</label>
                        <input class="e-input" @bind="_newQuote.Deductible" placeholder="$0" />
                    </div>
                    <div class="sd-dlg-field">
                        <label class="sd-dlg-lbl">Quote Effective</label>
                        <SfDatePicker TValue="DateTime" @bind-Value="_newQuote.EffDate" Format="MM/dd/yyyy" />
                    </div>
                    <div class="sd-dlg-field">
                        <label class="sd-dlg-lbl">Quote Expires</label>
                        <SfDatePicker TValue="DateTime" @bind-Value="_newQuote.ExpDate" Format="MM/dd/yyyy" />
                    </div>
                    <div class="sd-dlg-field sd-dlg-full">
                        <label class="sd-dlg-lbl">Notes / Conditions</label>
                        <textarea class="e-input" rows="2" @bind="_newQuote.Notes"></textarea>
                    </div>
                </div>
            </Content>
            <FooterTemplate>
                <button class="um-btn um-btn-ghost" @onclick='() => _showAddQuote = false'>Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="SaveQuote">Save Quote</button>
            </FooterTemplate>
        </DialogTemplates>
    </SfDialog>
}

@code {
    [Parameter] public Guid SubmissionId { get; set; }

    SfToast _toast = default!;

    bool   _loading      = true;
    int    _tab          = 0;
    string _commFilter   = "All";
    string? _kpiFilter   = null;
