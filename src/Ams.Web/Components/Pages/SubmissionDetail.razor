@if (_packagePreview is not null)
{
    <div class="sdd-modal-backdrop" role="presentation">
        <div class="sdd-package-preview" @onclick:stopPropagation="true">
            <div class="sdd-modal__header"><i class="bi bi-box-seam" aria-hidden="true"></i><span id="sdd-package-preview-title">Market Package Preview</span><button type="button" class="sdd-icon-btn sdd-icon-btn--light ms-auto" @onclick="ClosePackagePreview"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="sdd-modal__body">
                <div class="sdd-package-hero"><div><span>@Safe(_packagePreview.CarrierName, "Selected market")</span><h3>@_packagePreview.SubmissionNumber - @_packagePreview.AccountName</h3><p>@_packagePreview.LineOfBusiness</p></div><div><strong>@_packagePreview.ChannelCode</strong><small>@_packagePreview.ChannelDescription</small><em>@_packagePreview.PackageStatus</em></div></div>
                <div class="sdd-package-grid">
                    <section><h4>Coverage lines</h4>@foreach (var line in _packagePreview.Lines) { <div><span>@line.LineOfBusiness</span><strong>@line.TargetPremium.ToString("C0")</strong></div> } @if (!_packagePreview.Lines.Any()) { <p>No coverage lines selected.</p> }</section>
                    <section><h4>Documents</h4>@foreach (var doc in _packagePreview.Documents) { <div><span>@doc.FileName</span><strong>@doc.CategoryCode</strong></div> } @if (!_packagePreview.Documents.Any()) { <p>No documents attached.</p> }</section>
                    <section class="sdd-package-readiness">
                        <h4>Readiness evidence</h4>
                        @foreach (var item in _packagePreview.ReadinessItems)
                        {
                            <div class="@PackageReadinessEvidenceClass(item)">
                                <span><i class="bi @PackageReadinessEvidenceIcon(item)" aria-hidden="true"></i> @item.DisplayName</span>
                                <strong>@item.StatusCode</strong>
                                <small>@PackageReadinessEvidenceText(item)</small>
                                @if (item.EvidenceDocuments.Any())
                                {
                                    <div class="sdd-package-readiness__docs">
                                        @foreach (var evidence in item.EvidenceDocuments)
                                        {
                                            <em><i class="bi @DocIcon(evidence.FileName)" aria-hidden="true"></i> @evidence.FileName <b>@evidence.CategoryCode / @evidence.DocumentTypeCode</b></em>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(item.EvidenceCategoryCode))
                                {
                                    <em>@item.EvidenceCategoryCode / @item.EvidenceDocumentTypeCode</em>
                                }
                            </div>
                        }
                        @if (!_packagePreview.ReadinessItems.Any())
                        {
                            <p>No readiness items available.</p>
                        }
                    </section>
                    <section><h4>Channel history</h4>@foreach (var tx in _packagePreview.Transmissions) { <div><span>@tx.ChannelCode - @tx.StatusCode</span><strong>@(tx.SentDateUtc?.ToLocalTime().ToString("MMM d h:mm tt") ?? "Queued")</strong></div> } @if (!_packagePreview.Transmissions.Any()) { <p>No carrier transmission yet.</p> }</section>
                </div>
            </div>
            <div class="sdd-modal__footer"><button type="button" class="sdd-btn sdd-btn--ghost" @onclick="ClosePackagePreview">Close</button>@if (_packagePreview.SubmissionMarketId.HasValue) { <button type="button" class="sdd-btn sdd-btn--primary" @onclick="SubmitPreviewMarketAsync"><i class="bi bi-send" aria-hidden="true"></i> Submit This Market</button> }</div>
        </div>
    </div>
}

