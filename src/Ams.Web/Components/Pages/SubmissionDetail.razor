    void OpenActionDialog(string mode)
    {
        if (IsHistoricalSubmission && mode is "submit" or "quote" or "proposal" or "policy")
        {
            ShowToast("Policy generation is complete. Continue servicing in the policy workspace.", true);
            return;
        }

        if (mode == "policy")
        {
            OpenRequestBindDialog();
            return;
        }

        _actionMode = mode;
        _quoteValidationErrors.Clear();
        _actionTitle = mode switch
        {
            "submit" => "Submit to Market",
            "quote" => "Request Quote",
            "proposal" => "Generate Proposal",
            "decline" => "Decline Submission",
            "copy" => "Copy Submission",
            "note" => "Add Note",
            "assign" => "Assign Owner",
            "task" => "Create Follow-Up Task",
            "document" => "Upload Document",
            "market-package" => "Update Market Package",
            "quote-review" => "Review Quote Terms",
            "proposal-delivery" => "Proposal Delivery",
            _ => "Submission Action"
        };
        _actionIcon = mode switch
        {
            "submit" => "bi-send",
            "quote" => "bi-journal-plus",
            "proposal" => "bi-file-earmark-richtext",
            "decline" => "bi-x-circle",
            "copy" => "bi-copy",
            "note" => "bi-sticky",
            "assign" => "bi-person-check",
            "task" => "bi-list-check",
            "document" => "bi-upload",
            "market-package" => "bi-clipboard-data",
            "quote-review" => "bi-pencil-square",
            "proposal-delivery" => "bi-envelope-check",
            _ => "bi-lightning-charge"
        };
        _actionButtonText = mode switch { "decline" => "Decline", "assign" => "Assign", "task" => "Create Task", "document" => "Upload", "note" => "Add Note", "market-package" => "Save Package", "quote-review" => "Save Quote", "proposal-delivery" => "Save Proposal", _ => "Continue" };
        _actionForm.Reset(_submission);
        _actionForm.MarketStatus = DefaultOptionCode(_marketStatuses, _actionForm.MarketStatus);
        _actionForm.QuoteStatus = DefaultOptionCode(_quoteStatuses, _actionForm.QuoteStatus);
        _actionForm.SubmissionMethodCode = DefaultOptionCode(_submissionMethodOptions, _actionForm.SubmissionMethodCode);
        _actionForm.DeliveryMethod = DefaultOptionCode(_proposalDeliveryMethodOptions, _actionForm.DeliveryMethod);
        _actionForm.QuoteRequestScopeCode = DefaultOptionCode(_quoteRequestScopeOptions, _actionForm.QuoteRequestScopeCode);
        if (mode == "quote")
        {
            _actionForm.QuoteRequestActionCode = ResolveQuoteRequestActionCode(_selectedMarket);
            _actionForm.QuoteRequestReasonCode = DefaultOptionCode(_quoteRequestReasonOptions, _actionForm.QuoteRequestReasonCode ?? string.Empty);
            _actionForm.QuoteRequestMethodCode = ResolveQuoteRequestMethodCode(_selectedMarket);
            ResetQuoteRequestLines();
            SyncQuoteRequestPremium();
        }
        if (_taskTemplates.Count > 0)
        {
            _actionForm.TaskTypeCode = _taskTemplates[0].TaskTypeCode;
        }
        _showActionDialog = true;
    }

    void OpenRequestBindDialog()
    {
        if (_submission is null || _currentUser is null) return;
        if (GeneratedPolicyId is Guid policyId)
        {
            OpenPolicyWorkspace(policyId);
            return;
        }
        var quote = SelectedPolicyQuote;
        var acceptance = SelectedBindAcceptance;
        if (quote is null || acceptance is null || !acceptance.CustomerAuthorizationId.HasValue)
        {
            ShowToast("A selected quote with persisted client acceptance and customer authorization is required before requesting bind.", true);
            return;
        }

        _requestBindContext = new RequestBindDialogContext(
            _submission.TenantId,
            _currentUser.UserId,
            SubmissionId,
            quote.QuoteId,
            _submission.AccountId,
            quote.CarrierId,
            acceptance.ProposalId,
            acceptance.CustomerAuthorizationId.Value,
            acceptance.ClientAcceptanceId,
            _submission.AccountName,
            _submission.SubmissionNumber,
            quote.QuoteNumber,
            quote.CarrierName,
            string.Join(", ", _lines.Select(line => line.LineOfBusiness).Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase)),
            quote.AnnualPremium,
            _submission.EffectiveDate,
            _submission.ExpirationDate,
            null,
            quote.Subjectivities,
            acceptance,
            _policyCreationSources,
            _policyBindStatuses,
            _customerAuthorizationMethodOptions,
            _bindConfirmationSourceOptions,
            _bindingMethodOptions,
            _bindingAuthorityOptions);
    }

