    async Task UploadSelectedDocumentAsync(SubmissionDto submission)
    {
        if (_selectedDocumentFile is null)
            throw new InvalidOperationException("Select a document file to upload.");

        await using var stream = _selectedDocumentFile.OpenReadStream(104_857_600);
        await Api.UploadDocumentAsync(new ApiClient.UploadDocumentRequest
        {
            TenantId = submission.TenantId,
            DocumentTypeCode = string.IsNullOrWhiteSpace(_actionForm.DocumentTypeCode) ? "Submission" : _actionForm.DocumentTypeCode,
            CategoryCode = string.IsNullOrWhiteSpace(_actionForm.DocumentCategoryCode) ? "Submission" : _actionForm.DocumentCategoryCode,
            FileName = _selectedDocumentFile.Name,
            OriginalFileName = _selectedDocumentFile.Name,
            EntityName = "Submission",
            EntityId = SubmissionId,
            Description = _actionForm.Notes,
            UploadedByName = ResolveUserName(_currentUser?.UserId),
            CreatedByUserId = _currentUser?.UserId,
            Content = stream
        });

        await Api.AddSubmissionNoteAsync(SubmissionId, new AddSubmissionNoteRequest(submission.TenantId, $"Document attached: {_selectedDocumentFile.Name}.", _currentUser?.UserId));
    }

    int CalculateImportanceScore()
    {
        if (_submission is null) return 0;
        var score = 35;
        if (_submission.TargetPremium >= 100000) score += 25;
        else if (_submission.TargetPremium >= 50000) score += 16;
        else if (_submission.TargetPremium >= 25000) score += 8;
        if (_submission.Priority.Equals("Urgent", StringComparison.OrdinalIgnoreCase) || _submission.Priority.Equals("High", StringComparison.OrdinalIgnoreCase)) score += 15;
        if (DaysToEffective <= 14) score += 15;
        else if (DaysToEffective <= 30) score += 8;
        if (_quotes.Any()) score += 8;
        if (_markets.Count(m => m.Status != "Pending") >= 3) score += 6;
        if (_submission.Status is "Bound" or "Declined") score -= 12;
        return Math.Clamp(score, 0, 100);
    }

    IEnumerable<string> BuildImportanceReasons()
    {
        if (_submission is null) yield break;
        if (_submission.TargetPremium is > 0) yield return $"Premium exposure {PremiumDisplay}";
        if (_submission.Priority is "High" or "Urgent") yield return $"{_submission.Priority} priority submission";
        if (DaysToEffective <= 30) yield return $"{DaysToEffective} days to effective date";
        if (_markets.Any()) yield return $"{_markets.Count} carrier markets attached";
        if (_quotes.Any()) yield return $"{_quotes.Count} quote options available";
        if (!_markets.Any() && !_quotes.Any()) yield return "Market distribution still pending";
    }

    IEnumerable<IntelItem> BuildCoverageInsights()
    {
        if (_submission is null) yield break;
        yield return new("bi-clipboard2-check", "Packet readiness", $"{ReadinessPercent}% underwriting questions complete.");
        yield return new("bi-bank", "Market reach", _markets.Any() ? $"{_markets.Count} markets attached with {_markets.Count(m => m.IsRecommended)} recommended." : "No markets attached yet.");
        yield return new("bi-journal-text", "Quote quality", _quotes.Any() ? $"Lowest quote is {LowestQuotePremium:C0}." : "Quote workflow has not produced options yet.");
        yield return new("bi-clock-history", "Timing", DaysToEffective >= 0 ? $"{DaysToEffective} days until effective date." : "Effective date has passed; urgent review needed.");
    }

    void ShowToast(string message, bool danger = false)
    {
        _toasts.Insert(0, new ToastMessage(Guid.NewGuid(), message, danger ? "sdd-toast--danger" : "sdd-toast--success"));
        if (_toasts.Count > 4) _toasts.RemoveAt(_toasts.Count - 1);
    }

    void DismissToast(Guid id) => _toasts.RemoveAll(t => t.Id == id);

    static string ToastIconClass(ToastMessage toast) => toast.CssClass.Contains("danger", StringComparison.OrdinalIgnoreCase) ? "bi-exclamation-triangle" : "bi-check-circle";
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string MoneyOrDash(decimal? value) => value.HasValue ? value.Value.ToString("C0") : "-";
    static string PercentOrDash(decimal? value) => value.HasValue ? $"{value.Value:N2}%" : "-";
    static DateOnly? ToDateOnly(DateTime? value) => value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
    static string FormatBytes(long? bytes)
    {
        if (!bytes.HasValue) return "Unknown size";
        if (bytes.Value >= 1_048_576) return $"{bytes.Value / 1_048_576d:N1} MB";
        if (bytes.Value >= 1024) return $"{bytes.Value / 1024d:N0} KB";
        return $"{bytes.Value:N0} B";
    }

    string ResolveUserName(Guid? userId)
    {
        if (!userId.HasValue) return "System";
        var user = _users.FirstOrDefault(u => u.UserId == userId.Value);
        return user is null ? "System" : Safe(user.FullName, user.UserName);
    }

    static string StatusClass(string status) => $"sdd-status--{status.ToLowerInvariant().Replace(" ", "-")}";
    static string MarketStatusClass(string status) => $"sdd-market-status--{status.ToLowerInvariant().Replace(" ", "-")}";
    static string ActivityIcon(string type) => type switch { "SubmitToMarket" => "bi-send", "RequestQuote" => "bi-journal-text", "Decline" => "bi-x-circle", "Note" => "bi-sticky", "FollowUpTask" => "bi-list-check", "DocumentAttached" => "bi-file-earmark", "Assign" => "bi-person-check", _ => "bi-dot" };
    static string CommIcon(string type) => type switch { "Email" => "bi-envelope", "Call" => "bi-telephone", "Note" => "bi-sticky", "SMS" => "bi-chat-text", _ => "bi-chat" };
    static string DocIcon(string name) => System.IO.Path.GetExtension(name).ToLowerInvariant() switch { ".pdf" => "bi-file-earmark-pdf", ".doc" or ".docx" => "bi-file-earmark-word", ".xls" or ".xlsx" => "bi-file-earmark-spreadsheet", _ => "bi-file-earmark" };

