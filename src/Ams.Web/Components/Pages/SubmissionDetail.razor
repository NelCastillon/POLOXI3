    async Task ExecuteConfirmedActionAsync()
    {
        if (_submission is null) return;
        _actionBusy = true;
        try
        {
            if (_actionMode == "submit")
            {
                if (!IsReadyForSubmitToMarket())
                {
                    ShowReadinessGate("This carrier package cannot be submitted yet because underwriting readiness has open DB-backed blockers.");
                    return;
                }

                await Api.SubmitSubmissionToMarketAsync(SubmissionId, new SubmitSubmissionToMarketRequest(_submission.TenantId, _actionForm.CarrierId, _actionForm.Notes));
                ShowToast("Submission sent to market.");
            }
            else if (_actionMode == "quote")
            {
                var result = await Api.RequestSubmissionQuoteAsync(SubmissionId, new RequestSubmissionQuoteRequest(_submission.TenantId, _actionForm.CarrierId, _actionForm.AnnualPremium, null, null, _actionForm.Notes, _currentUser?.UserId, null, _selectedMarket?.SubmissionMarketId, _actionForm.QuoteRequestScopeCode, _selectedQuoteRequestLineIds.ToArray(), _actionForm.QuoteRequestActionCode, RequiresQuoteRequestReason ? _actionForm.QuoteRequestReasonCode : null));
                _quoteRequestInstruction = $"{result?.Message ?? "AMS created the quote request."} Next, monitor the Markets tab for carrier status, follow the Activity timeline for the request record, and record quote terms when the carrier responds.";
                _quoteRequestError = null;
                _quoteRequestPopupIsError = false;
                _showQuoteRequestPopup = true;
            }
            else if (_actionMode == "policy")
            {
                var requiresQuote = SelectedPolicyCreationSource?.RequiresQuote == true;
                var quoteId = requiresQuote ? _selectedQuoteId ?? _quotes.OrderBy(q => q.AnnualPremium).FirstOrDefault()?.QuoteId : null;
                await Api.CreatePolicyFromSubmissionAsync(SubmissionId, new CreatePolicyFromSubmissionRequest(TenantId: _submission.TenantId, QuoteId: quoteId, CarrierId: _actionForm.CarrierId, AnnualPremium: _actionForm.AnnualPremium, EffectiveDate: _submission.EffectiveDate, ExpirationDate: _submission.ExpirationDate, PolicyNumber: _actionForm.PolicyNumber, PolicySourceCode: _actionForm.PolicySourceCode, PolicySourceReason: _actionForm.PolicySourceReason, PolicySourceNotes: _actionForm.Notes));
                ShowToast("Policy created from submission.");
            }
            else if (_actionMode == "proposal")
            {
                var quoteIds = _quotes.Select(q => q.QuoteId).ToArray();
                await Api.GenerateProposalAsync(new GenerateProposalRequest(SubmissionId, _submission.TenantId, $"{_submission.SubmissionNumber} Proposal", quoteIds, _actionForm.Notes));
                ShowToast("Proposal generation started.");
            }
            else if (_actionMode == "decline")
            {
                await Api.DeclineSubmissionAsync(SubmissionId, new DeclineSubmissionRequest(_submission.TenantId, _actionForm.Notes));
                ShowToast("Submission declined.");
            }
            else if (_actionMode == "copy")
            {
                var result = await Api.CopySubmissionAsync(SubmissionId, new CopySubmissionRequest(_submission.TenantId, _actionForm.EffectiveDate, _submission.LineOfBusiness, _actionForm.Priority));
                ShowToast("Submission copied.");
                Nav.NavigateTo($"/submissions/{result.Id}");
                return;
            }
            else if (_actionMode == "assign" && _actionForm.AssignedToUserId.HasValue)
            {
                await Api.AssignSubmissionAsync(SubmissionId, new AssignSubmissionRequest(_actionForm.AssignedToUserId.Value));
                await Api.AddSubmissionNoteAsync(SubmissionId, new AddSubmissionNoteRequest(_submission.TenantId, $"Submission assigned to {ResolveUserName(_actionForm.AssignedToUserId.Value)}.", _currentUser?.UserId));
                ShowToast("Submission assigned.");
            }
            else if (_actionMode == "task")
            {
                await Api.CreateSubmissionFollowUpTaskAsync(SubmissionId, new CreateSubmissionFollowUpTaskRequest(_submission.TenantId, _actionForm.TaskTitle, _actionForm.Notes, _actionForm.Priority ?? "Medium", _actionForm.AssignedToUserId, ToDateOnly(_actionForm.TaskDueDate), _currentUser?.UserId));
                ShowToast("Follow-up task created.");
            }
            else if (_actionMode == "document")
            {
                await UploadSelectedDocumentAsync(_submission);
                ShowToast("Document uploaded and attached.");
            }
            else if (_actionMode == "note")
            {
                await Api.AddSubmissionNoteAsync(SubmissionId, new AddSubmissionNoteRequest(_submission.TenantId, _actionForm.Notes, _currentUser?.UserId));
                ShowToast("Note added.");
            }
            else if (_actionMode == "market-package" && _selectedMarket is not null)
            {
                await Api.UpdateSubmissionMarketPackageAsync(_selectedMarket.SubmissionMarketId, new UpdateSubmissionMarketPackageRequest(_submission.TenantId, _selectedMarket.SubmissionMarketId, _actionForm.MarketStatus, _actionForm.ReasonCode, _actionForm.Notes, _actionForm.NextActionDateUtc, _docs.Select(d => d.DocumentId).ToArray(), _currentUser?.UserId, _actionForm.UnderwriterName, _actionForm.UnderwriterEmail, _actionForm.UnderwriterPhone, _actionForm.MarketDueDateUtc, _actionForm.RequestedCoverageSummary, _actionForm.RequestedLimits, _actionForm.SubmissionMethodCode, null));
                ShowToast("Market package updated.");
            }
            else if (_actionMode == "quote-review" && (_selectedQuote is not null || _selectedMarket is not null))
            {
                var marketId = _selectedQuote?.SubmissionMarketId ?? _selectedMarket?.SubmissionMarketId;
                if (!marketId.HasValue)
                {
                    throw new InvalidOperationException("Select a market before recording a carrier quote response.");
                }

                await Api.RecordSubmissionQuoteResponseAsync(SubmissionId, new RecordSubmissionQuoteResponseRequest(_submission.TenantId, marketId.Value, _selectedQuote?.QuoteId, _actionForm.QuoteStatus, _actionForm.AnnualPremium ?? _selectedQuote?.AnnualPremium ?? 0, _actionForm.Deductible, _actionForm.Limit, _actionForm.CommissionPercent, _actionForm.Subjectivities, _actionForm.Exclusions, _actionForm.CarrierRating, _actionForm.PaymentTerms, _actionForm.MinimumEarnedPremium, _actionForm.TaxesAndFees, _actionForm.BrokerFee, _actionForm.TriaIncluded, null, _actionForm.Notes, _actionForm.ExpiresDateUtc ?? DateTime.UtcNow.AddDays(30), "ManualEntry", null, _currentUser?.UserId, _actionForm.QuoteEffectiveDate, _actionForm.CoverageForms, _actionForm.IsBindable));
                ShowToast("Quote terms updated.");
            }
            else if (_actionMode == "proposal-delivery" && _actionForm.ProposalId.HasValue)
            {
                await Api.DeliverProposalAsync(_actionForm.ProposalId.Value, new ProposalDeliveryRequest(_submission.TenantId, _actionForm.DeliveryMethod, _actionForm.Recipient, _currentUser?.UserId));
                if (!string.Equals(_actionForm.ClientDecision, "Pending", StringComparison.OrdinalIgnoreCase))
                {
                    await Api.RecordProposalDecisionAsync(_actionForm.ProposalId.Value, new ProposalDecisionRequest(_submission.TenantId, _actionForm.ClientDecision, _actionForm.Notes, _currentUser?.UserId));
                }
                ShowToast("Proposal workflow updated.");
            }
            else if (_actionMode == "remove-market" && _pendingRemoveMarket is not null)
            {
                await Api.RemoveSubmissionMarketAsync(_pendingRemoveMarket.SubmissionMarketId);
                ShowToast("Market removed.");
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            if (_actionMode == "quote")
            {
                _quoteRequestInstruction = "AMS could not complete the quote request. Review the failure detail below, adjust the request if needed, and try again.";
                _quoteRequestError = ex.Message;
                _quoteRequestPopupIsError = true;
                _showQuoteRequestPopup = true;
            }
            else
            {
                if (_actionMode == "submit" && ex.Message.Contains("not ready for marketing", StringComparison.OrdinalIgnoreCase))
                {
                    await RefreshReadinessAsync();
                    ShowReadinessGate(ex.Message);
                }
                else
                {
                    ShowToast($"{_actionTitle} failed: {ex.Message}", true);
                }
            }
        }
        finally
        {
            _actionBusy = false;
            _showConfirmDialog = false;
            _pendingRemoveMarket = null;
        }
    }

    async Task SubmitMarketAsync(SubmissionMarketDto market)
    {
        if (_submission is null) return;
        if (!IsReadyForSubmitToMarket())
        {
            ShowReadinessGate($"{market.CarrierName} cannot receive this package yet because underwriting readiness has open DB-backed blockers.");
            return;
        }

        try
        {
            await Api.SubmitSubmissionToMarketAsync(SubmissionId, new SubmitSubmissionToMarketRequest(_submission.TenantId, market.CarrierId, $"Submitted to {market.CarrierName} from detail dashboard."));
            await LoadAsync();
            ShowToast($"Submitted to {market.CarrierName}.");
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("not ready for marketing", StringComparison.OrdinalIgnoreCase))
            {
                await RefreshReadinessAsync();
                ShowReadinessGate(ex.Message);
            }
            else
            {
                ShowToast($"Submit failed: {ex.Message}", true);
            }
        }
    }

