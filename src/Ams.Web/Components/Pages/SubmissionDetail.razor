        new(2, "Describe material changes since the expiring term.", true, false, "Include new locations, payroll, vehicles, or revenue changes."),
        new(3, "Confirm target premium and requested effective date with the insured.", false, true, "Used for quote comparisons and proposal strategy.")
    ];

    static List<ActivityItem> BuildActivityRows(SubmissionDto dto) =>
    [
        new(dto.AssignedToUserName ?? "Tenant Admin", "Created submission", $"Submission {dto.SubmissionNumber} created for {dto.LineOfBusiness}.", "system", dto.CreatedDateUtc.ToLocalTime()),
        new("Tenant Admin", "Prepared market package", "Application, schedules, and loss runs staged for carrier underwriting.", "submit", DateTime.Now.AddDays(-2)),
        new("Underwriting", "Readiness review", "Missing questions and quote workflow reviewed by importance score.", "note", DateTime.Now.AddDays(-1))
    ];

    static List<CommItem> BuildCommunicationRows(SubmissionDto dto) =>
    [
        new("Email", "Submission package sent", "Tenant Admin", "Carrier market", $"Submitted {dto.LineOfBusiness} package for {dto.AccountName}.", DateTime.Now.AddDays(-2)),
        new("Call", "Underwriter intake call", "Tenant Admin", "Carrier underwriter", "Confirmed appetite and expected quote timeline.", DateTime.Now.AddDays(-1)),
        new("Note", "Client follow-up", "Tenant Admin", dto.AccountName, "Need final confirmation of subjectivities before bind.", DateTime.Now.AddHours(-6))
    ];

    sealed class ActionForm
    {
        public Guid? CarrierId { get; set; }

        [Range(0, 999999999999)]
        public decimal? AnnualPremium { get; set; }

        public DateTime? EffectiveDate { get; set; }

        [StringLength(50)]
        public string? Priority { get; set; }

        [Required, StringLength(1000)]
        public string Notes { get; set; } = string.Empty;

        public void Reset(SubmissionDto? submission)
        {
            CarrierId = null;
            AnnualPremium = submission?.TargetPremium;
            EffectiveDate = submission?.EffectiveDate.AddYears(1);
            Priority = submission?.Priority;
            Notes = string.Empty;
        }
    }

    sealed record TabDef(int Index, string Key, string Label, string Kicker, string Title, string Description, string Icon);
    sealed record DocItem(string FileName, string DocType, string UploadedBy, DateTime UploadedDate, string Size);
    sealed record UwQuestion(int Number, string Text, bool Required, bool Answered, string HelpText)
    {
        public bool Answered { get; set; } = Answered;
    }
    sealed record ActivityItem(string User, string Action, string Detail, string Type, DateTime When);
    sealed record CommItem(string Type, string Subject, string From, string To, string Body, DateTime When);
    sealed record IntelItem(string Icon, string Title, string Description);
    sealed record ToastMessage(Guid Id, string Message, string CssClass);
}
