    // ── Actions ───────────────────────────────────────────────────
    void OpenAction(string mode)
    {
        _actionMode  = mode;
        _actionTitle = mode switch
        {
            "submit"   => "Submit to Market",
            "quote"    => "Request Quote",
            "bind"     => "Bind",
            "decline"  => "Decline Submission",
            "copy"     => "Copy Submission",
            "email"    => "Send Email",
            "call"     => "Log Call",
            "note"     => "Add Note",
            _          => "Action"
        };
        _actionNotes = "";
        _showActionDlg = true;
    }

    async Task ExecuteAction()
    {
        if (_actionMode == "submit")
        {
            foreach (var m in _markets.Where(m => m.Selected))
            {
                m.Status     = "Submitted";
                m.SubmitDate = DateTime.Today;
            }
        }
        else if (_actionMode == "decline" && _sub is not null)
        {
            _sub.Status = "Declined";
        }

        _showActionDlg = false;
        await _toast.ShowAsync(new ToastModel
        {
            Title    = "Done",
            Content  = $"{_actionTitle} completed.",
            CssClass = "e-toast-success"
        });
    }

    void SelectQuote(QuoteItem q)
    {
        foreach (var qt in _quotes) qt.Selected = false;
        q.Selected = true;
        if (_sub is not null) _sub.Status = "Quoted";
    }

    async Task BindQuote(QuoteItem q)
    {
        SelectQuote(q);
        if (_sub is not null) _sub.Status = "Bound";
        _showActionDlg = false;
        await _toast.ShowAsync(new ToastModel
        {
            Title    = "Bound",
            Content  = $"Quote {q.QuoteNo} bound. Create a policy to complete.",
            CssClass = "e-toast-success"
        });
    }

    void AddMarket()
    {
        _markets.Add(_newMarket);
        _newMarket     = new();
        _showAddMarket = false;
    }

    void SaveQuote()
    {
        _quotes.Add(_newQuote);
        foreach (var q in _quotes) q.IsLowest = q.Premium == _quotes.Min(x => x.Premium);
        _newQuote     = new();
        _showAddQuote = false;
    }

    void MarkAllAnswered()
    {
        foreach (var q in _questions) q.Answered = true;
    }

    // ── Helpers ───────────────────────────────────────────────────
    static string LobKey(string lob) => lob switch
    {
        "General Liability"   => "gl",
        "Commercial Property" => "prop",
        "Commercial Auto"     => "auto",
        "Workers Comp"        => "wc",
        "Umbrella / Excess"   => "umb",
        _                     => "other"
    };

    static string LobIcon(string lob) => lob switch
    {
        "General Liability"   => "bi-shield",
        "Commercial Property" => "bi-building",
        "Commercial Auto"     => "bi-truck",
        "Workers Comp"        => "bi-person-badge",
        "Umbrella / Excess"   => "bi-umbrella",
        _                     => "bi-shield-exclamation"
    };

    static string CssStatus(string s) => s.ToLower().Replace(" ","-");

    static string CssMktStatus(string s) => s switch
    {
        "Quoted"         => "quoted",
        "Awaiting Quote" => "awaiting",
        "Submitted"      => "submitted",
        "Declined"       => "declined",
        _                => "pending"
    };

    static string ActivityIcon(string t) => t switch
    {
        "submit"  => "bi-send",
        "quote"   => "bi-journal-text",
        "decline" => "bi-x-circle",
        "note"    => "bi-sticky",
        "email"   => "bi-envelope",
        _         => "bi-dot"
    };

    static string CommIcon(string t) => t switch
    {
        "Email" => "bi-envelope",
        "Call"  => "bi-telephone",
        "Note"  => "bi-sticky",
        "SMS"   => "bi-chat-text",
        _       => "bi-chat"
    };

    static string DocExt(string name)
    {
        var ext = System.IO.Path.GetExtension(name).ToLower().TrimStart('.');
        return ext is "pdf" ? "pdf" : ext is "docx" or "doc" ? "word" : "file";
    }

    static string DocIcon(string name)
    {
        var ext = System.IO.Path.GetExtension(name).ToLower().TrimStart('.');
        return ext is "pdf" ? "bi-file-earmark-pdf" : ext is "docx" or "doc" ? "bi-file-earmark-word" : "bi-file-earmark";
    }

    static void SubmitMarket(Market m)    { m.Status = "Submitted"; m.SubmitDate = DateTime.Today; }
    static void EnterQuoteMarket(Market m) { m.Status = "Awaiting Quote"; }

    RenderFragment FieldRow(string label, string val) =>
        @<div class="sd-field-row">
            <span class="sd-field-lbl">@label</span>
            <span class="sd-field-val">@(string.IsNullOrEmpty(val) ? "—" : val)</span>
        </div>;

    RenderFragment KpiCard(string icon, string label, string val, string css) =>
        @<div class="sd-kpi-card @css">
            <div class="sd-kpi-val">@val</div>
            <div class="sd-kpi-lbl"><i class="bi @icon" aria-hidden="true"></i> @label</div>
        </div>;
}
