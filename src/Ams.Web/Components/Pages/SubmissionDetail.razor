        public decimal Reserved    { get; set; }
        public string  Description { get; set; } = "";
    }

    sealed class Market
    {
        public string    Carrier       { get; set; } = "";
        public string    Underwriter   { get; set; } = "";
        public string    Status        { get; set; } = "Pending";
        public DateTime? SubmitDate    { get; set; }
        public DateTime? DueDate       { get; set; }
        public string    QuoteRef      { get; set; } = "";
        public string    Notes         { get; set; } = "";
        public decimal   TargetPremium { get; set; }
        public bool      Selected      { get; set; }
    }

    sealed class DocItem
    {
        public string   FileName     { get; set; } = "";
        public string   DocType      { get; set; } = "";
        public string   UploadedBy   { get; set; } = "";
        public DateTime UploadedDate { get; set; }
        public string   Size         { get; set; } = "";
        public string   Version      { get; set; } = "";
    }

    sealed class UwQuestion
    {
        public int    Number     { get; set; }
        public string Section    { get; set; } = "";
        public string Text       { get; set; } = "";
        public string AnswerType { get; set; } = "bool";
        public bool   Required   { get; set; }
        public bool   Answered   { get; set; }
        public bool?  BoolAnswer { get; set; }
        public string TextAnswer { get; set; } = "";
        public string HelpText   { get; set; } = "";
    }

    sealed class QuoteItem
    {
        public string   Carrier    { get; set; } = "";
        public string   QuoteNo    { get; set; } = "";
        public decimal  Premium    { get; set; }
        public string   OccLimit   { get; set; } = "";
        public string   Aggregate  { get; set; } = "";
        public string   Deductible { get; set; } = "";
        public DateTime EffDate    { get; set; }
        public DateTime ExpDate    { get; set; }
        public string   Notes      { get; set; } = "";
        public bool     Selected   { get; set; }
        public bool     IsLowest   { get; set; }
    }

    sealed class ActivityItem
    {
        public string   User   { get; set; } = "";
        public string   Action { get; set; } = "";
        public string   Detail { get; set; } = "";
        public string   Type   { get; set; } = "system";
        public DateTime When   { get; set; }
    }

    sealed class CommItem
    {
        public string   Type          { get; set; } = "";
        public string   Subject       { get; set; } = "";
        public string   From          { get; set; } = "";
        public string   To            { get; set; } = "";
        public string   Body          { get; set; } = "";
        public DateTime When          { get; set; }
        public bool     HasAttachment { get; set; }
    }

    // ── Lifecycle ─────────────────────────────────────────────────
