    static string ToastIconClass(ToastMessage toast) => toast.CssClass.Contains("danger", StringComparison.OrdinalIgnoreCase) ? "bi-exclamation-triangle" : "bi-check-circle";
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string DefaultOptionCode(IReadOnlyList<SubmissionReferenceOptionDto> options, string fallback) => options.FirstOrDefault(o => o.IsDefault)?.OptionCode ?? options.FirstOrDefault()?.OptionCode ?? fallback;
    static string PreferredOptionCode(IReadOnlyList<SubmissionReferenceOptionDto> options, string preferredCode, string fallback) => options.FirstOrDefault(o => string.Equals(o.OptionCode, preferredCode, StringComparison.OrdinalIgnoreCase))?.OptionCode ?? DefaultOptionCode(options, fallback);
    static string QuoteRequestOptionName(IReadOnlyList<SubmissionReferenceOptionDto> options, string? code) => options.FirstOrDefault(o => string.Equals(o.OptionCode, code, StringComparison.OrdinalIgnoreCase))?.OptionName ?? Safe(code, "Quote request");
    static int MarketStatusSortOrder(string status) => status switch
    {
        "In Review" => 10,
        "Pending" => 20,
        "Submitted" => 30,
        "Requested" or "Awaiting Quote" => 40,
        "Quoted" => 50,
        "Bound" => 60,
        "Declined" => 70,
        "No Response" => 80,
        _ => 100
    };
    static string MoneyOrDash(decimal? value) => value.HasValue ? value.Value.ToString("C0") : "-";
    static string PercentOrDash(decimal? value) => value.HasValue ? $"{value.Value:N2}%" : "-";
    static DateOnly? ToDateOnly(DateTime? value) => value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
    static string FormatBytes(long? bytes)
    {
        if (!bytes.HasValue) return "Unknown size";
        if (bytes.Value >= 1_048_576) return $"{bytes.Value / 1_048_576d:N1} MB";
        if (bytes.Value >= 1024) return $"{bytes.Value / 1024d:N0} KB";
        return $"{bytes.Value:N0} B";
    }

    string ResolveUserName(Guid? userId)
    {
        if (!userId.HasValue) return "System";
        var user = _users.FirstOrDefault(u => u.UserId == userId.Value);
        return user is null ? "System" : Safe(user.FullName, user.UserName);
    }

    bool IsQuoteLineSelected(Guid lineId) => _selectedQuoteRequestLineIds.Contains(lineId);
    bool IsQuoteLineDisabled(Guid lineId) => string.Equals(_actionForm.QuoteRequestScopeCode, "SingleLine", StringComparison.OrdinalIgnoreCase) && _selectedQuoteRequestLineIds.Count == 1 && !_selectedQuoteRequestLineIds.Contains(lineId);
    bool IsQuoteRequestBlocked(SubmissionMarketDto market) => _quoteRequestBlockedStatusOptions.Any(o => string.Equals(o.OptionCode, market.Status, StringComparison.OrdinalIgnoreCase));
    string QuoteRequestButtonTitle(SubmissionMarketDto market) => IsQuoteRequestBlocked(market) ? $"Quote requests are blocked because this market is {market.Status}." : "Create, update, or revise a DB-backed quote request for this market.";

    string ResolveQuoteRequestActionCode(SubmissionMarketDto? market)
    {
        var preferredCode = market switch
        {
            { LatestQuoteReceivedDateUtc: not null } => "RequestRevision",
            { LatestQuoteRequestVersion: > 0 } => "ResendUpdate",
            _ => "InitialRequest"
        };

        return PreferredOptionCode(_quoteRequestActionOptions, preferredCode, string.Empty);
    }

    void ToggleQuoteRequestLine(Guid lineId, bool selected)
    {
        if (selected)
        {
            if (string.Equals(_actionForm.QuoteRequestScopeCode, "SingleLine", StringComparison.OrdinalIgnoreCase))
            {
                _selectedQuoteRequestLineIds.Clear();
            }
            _selectedQuoteRequestLineIds.Add(lineId);
        }
        else
        {
            _selectedQuoteRequestLineIds.Remove(lineId);
        }

        SyncQuoteRequestPremium();
    }

    void ApplyQuoteRequestScope()
    {
        if (string.Equals(_actionForm.QuoteRequestScopeCode, "SingleLine", StringComparison.OrdinalIgnoreCase) && _selectedQuoteRequestLineIds.Count != 1)
        {
            var firstLine = QuoteRequestCoverageLines.FirstOrDefault();
            _selectedQuoteRequestLineIds.Clear();
            if (firstLine is not null) _selectedQuoteRequestLineIds.Add(firstLine.SubmissionLineId);
        }
        else if (!string.Equals(_actionForm.QuoteRequestScopeCode, "SingleLine", StringComparison.OrdinalIgnoreCase) && !_selectedQuoteRequestLineIds.Any())
        {
            foreach (var line in QuoteRequestCoverageLines)
            {
                _selectedQuoteRequestLineIds.Add(line.SubmissionLineId);
            }
        }

        SyncQuoteRequestPremium();
    }

    void ResetQuoteRequestLines()
    {
        _selectedQuoteRequestLineIds.Clear();
        var scope = _actionForm.QuoteRequestScopeCode;
        var lines = QuoteRequestCoverageLines;
        if (string.Equals(scope, "SingleLine", StringComparison.OrdinalIgnoreCase))
        {
            var firstLine = lines.FirstOrDefault();
            if (firstLine is not null) _selectedQuoteRequestLineIds.Add(firstLine.SubmissionLineId);
            return;
        }

        foreach (var line in lines)
        {
            _selectedQuoteRequestLineIds.Add(line.SubmissionLineId);
        }
    }

    void SyncQuoteRequestPremium() => _actionForm.AnnualPremium = QuoteRequestPackagePremium;

    static string StatusClass(string status) => $"sdd-status--{status.ToLowerInvariant().Replace(" ", "-")}";
    static string MarketStatusClass(string status) => $"sdd-market-status--{status.ToLowerInvariant().Replace(" ", "-")}";
    static string ActivityIcon(string type) => type switch { "SubmitToMarket" => "bi-send", "RequestQuote" => "bi-journal-text", "Decline" => "bi-x-circle", "Note" => "bi-sticky", "FollowUpTask" => "bi-list-check", "DocumentAttached" => "bi-file-earmark", "Assign" => "bi-person-check", _ => "bi-dot" };
    static string CommIcon(string type) => type switch { "Email" => "bi-envelope", "Call" => "bi-telephone", "Note" => "bi-sticky", "SMS" => "bi-chat-text", _ => "bi-chat" };
    static string DocIcon(string name) => System.IO.Path.GetExtension(name).ToLowerInvariant() switch { ".pdf" => "bi-file-earmark-pdf", ".doc" or ".docx" => "bi-file-earmark-word", ".xls" or ".xlsx" => "bi-file-earmark-spreadsheet", _ => "bi-file-earmark" };

