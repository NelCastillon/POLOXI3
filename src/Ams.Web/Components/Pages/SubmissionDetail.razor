@page "/submissions/{SubmissionId:guid}"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Submissions
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@(_submission is null ? "Submission Detail" : $"{_submission.SubmissionNumber} â€” Submission Detail")</PageTitle>

@if (_loading)
{
    <div class="sdd-loading"><span class="sdd-spinner"></span><span>Loading submission detail...</span></div>
}
else if (_submission is null)
{
    <div class="sdd-not-found">
        <i class="bi bi-send-x" aria-hidden="true"></i>
        <h2>Submission not found</h2>
        <p>The requested submission could not be loaded from the existing submission workflow.</p>
        <button type="button" class="sdd-btn sdd-btn--primary" @onclick='() => Nav.NavigateTo("/submissions")'><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Submissions</button>
    </div>
}
else
{
    <div class="sdd-page">
        <section class="sdd-hero">
            <div class="sdd-hero__content">
                <div class="sdd-hero__eyebrow"><i class="bi bi-send-check" aria-hidden="true"></i> Enterprise submission detail</div>
                <h1>@_submission.SubmissionNumber</h1>
                <p>@_submission.OpportunityName for @_submission.AccountName. Monitor market distribution, quote quality, underwriting readiness, and bind workflow from one command center.</p>
                <div class="sdd-hero__meta">
                    <span><i class="bi bi-building" aria-hidden="true"></i>@_submission.AccountName</span>
                    <span><i class="bi bi-layers" aria-hidden="true"></i>@_submission.LineOfBusiness</span>
                    <span><i class="bi bi-flag" aria-hidden="true"></i>@_submission.Priority</span>
                    <span><i class="bi bi-calendar-event" aria-hidden="true"></i>@_submission.EffectiveDate.ToString("MMM d, yyyy")</span>
                    <span><i class="bi bi-cash-stack" aria-hidden="true"></i>@PremiumDisplay</span>
                </div>
            </div>
            <div class="sdd-hero__actions">
                <button type="button" class="sdd-btn sdd-btn--light" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @_refreshIconClass" aria-hidden="true"></i> Refresh</button>
                <button type="button" class="sdd-btn sdd-btn--light" @onclick='() => Nav.NavigateTo("/submissions")'><i class="bi bi-list-check" aria-hidden="true"></i> Submissions</button>
                <button type="button" class="sdd-btn sdd-btn--primary" @onclick='() => OpenActionDialog("submit")'><i class="bi bi-send" aria-hidden="true"></i> Submit</button>
            </div>
        </section>

        @if (_loadError is not null)
        {
            <div class="alert alert-danger sdd-alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <span>@_loadError</span>
            </div>
        }

        <section class="sdd-kpi-strip" aria-label="Submission detail KPIs">
            @KpiCard("overview", "Importance", ImportanceLabel, "Priority based on premium, timing, quotes, markets, and status", "bi-lightning-charge", "blue", 0)
            @KpiCard("markets", "Markets", _markets.Count.ToString(), "Carrier markets attached to this submission", "bi-bank", "cyan", 1)
            @KpiCard("quotes", "Quotes", _quotes.Count.ToString(), "Quote options received or requested", "bi-journal-text", "emerald", 2)
            @KpiCard("readiness", "Readiness", $"{ReadinessPercent}%", "Underwriting packet readiness score", "bi-clipboard2-check", "amber", 3)
            @KpiCard("premium", "Target Premium", PremiumDisplay, "Target or quoted premium value", "bi-cash-stack", "green", 2)
            @KpiCard("timeline", "Activity", _activity.Count.ToString(), "Workflow activity and communication events", "bi-activity", "purple", 6)
        </section>

        <section class="sdd-workflows" aria-label="Submission workflow shortcuts">
            <button type="button" class="sdd-workflow" @onclick='() => OpenActionDialog("submit")'><i class="bi bi-send" aria-hidden="true"></i><span><strong>Submit to market</strong><small>Send package to a selected carrier</small></span></button>
            <button type="button" class="sdd-workflow" @onclick='() => OpenActionDialog("quote")'><i class="bi bi-journal-plus" aria-hidden="true"></i><span><strong>Request quote</strong><small>Generate a quote workflow request</small></span></button>
            <button type="button" class="sdd-workflow" @onclick='() => OpenActionDialog("proposal")'><i class="bi bi-file-earmark-richtext" aria-hidden="true"></i><span><strong>Proposal</strong><small>Create proposal from available quotes</small></span></button>
            <button type="button" class="sdd-workflow" @onclick='() => OpenActionDialog("policy")'><i class="bi bi-shield-check" aria-hidden="true"></i><span><strong>Create policy</strong><small>Bind and issue from selected quote</small></span></button>
            <button type="button" class="sdd-workflow" @onclick='() => OpenActionDialog("copy")'><i class="bi bi-copy" aria-hidden="true"></i><span><strong>Copy / remarket</strong><small>Create renewal or remarketing copy</small></span></button>
        </section>

        <section class="sdd-tabs" aria-label="Submission detail tabs">
            @foreach (var tab in _tabs)
            {
                <button type="button" class="@TabClass(tab.Index)" title="@tab.Description" @onclick="() => SetTab(tab.Index)">
                    <i class="bi @tab.Icon" aria-hidden="true"></i>
                    <span>@tab.Label</span>
                    <strong>@TabCount(tab.Key)</strong>
                </button>
            }
        </section>

        <div class="sdd-dashboard">
            <main class="sdd-main-card">
                <div class="sdd-card-header">
                    <div>
                        <span class="sdd-section-kicker">@CurrentTab.Kicker</span>
                        <h2>@CurrentTab.Title</h2>
                        <p>@CurrentTab.Description</p>
                    </div>
                    <div class="sdd-card-actions">
                        @if (_activeTab == 1)
                        {
                            <button type="button" class="sdd-btn sdd-btn--ghost" @onclick="LoadSuggestionsAsync"><i class="bi bi-stars" aria-hidden="true"></i> Suggestions</button>
                        }
                        @if (_activeTab == 2)
                        {
                            <button type="button" class="sdd-btn sdd-btn--ghost" @onclick='() => OpenActionDialog("quote")'><i class="bi bi-plus-lg" aria-hidden="true"></i> Request Quote</button>
                        }
                        @if (_activeTab == 3)
                        {
                            <button type="button" class="sdd-btn sdd-btn--ghost" @onclick="MarkAllAnswered"><i class="bi bi-check-all" aria-hidden="true"></i> Mark Complete</button>
                        }
                        <button type="button" class="sdd-btn sdd-btn--primary" @onclick='() => OpenActionDialog("note")'><i class="bi bi-sticky" aria-hidden="true"></i> Add Note</button>
                    </div>
                </div>

                <div class="sdd-tab-body">
                    @if (_activeTab == 0)
                    {
                        <section class="sdd-overview-grid">
                            <div class="sdd-section-card">
                                <span class="sdd-section-title"><i class="bi bi-person-badge" aria-hidden="true"></i> Submission profile</span>
                                <div class="sdd-detail-list">
                                    <div><span>Status</span>@StatusBadge(_submission.Status)</div>
                                    <div><span>Account</span><strong>@_submission.AccountName</strong></div>
                                    <div><span>Opportunity</span><strong>@_submission.OpportunityName</strong></div>
                                    <div><span>Line of Business</span><strong>@_submission.LineOfBusiness</strong></div>
                                    <div><span>Priority</span><strong>@_submission.Priority</strong></div>
                                    <div><span>Assigned To</span><strong>@Safe(_submission.AssignedToUserName, "Unassigned")</strong></div>
                                </div>
                            </div>
                            <div class="sdd-section-card">
                                <span class="sdd-section-title"><i class="bi bi-calendar-range" aria-hidden="true"></i> Dates and premium</span>
                                <div class="sdd-detail-list">
                                    <div><span>Effective</span><strong>@_submission.EffectiveDate.ToString("MMM d, yyyy")</strong></div>
                                    <div><span>Expiration</span><strong>@_submission.ExpirationDate.ToString("MMM d, yyyy")</strong></div>
                                    <div><span>Days to Effective</span><strong>@DaysToEffective</strong></div>
                                    <div><span>Target Premium</span><strong>@PremiumDisplay</strong></div>
                                    <div><span>Created</span><strong>@_submission.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy")</strong></div>
                                    <div><span>Modified</span><strong>@(_submission.ModifiedDateUtc?.ToLocalTime().ToString("MMM d, yyyy") ?? "â€”")</strong></div>
                                </div>
                            </div>
                            <div class="sdd-section-card sdd-section-card--wide">
                                <span class="sdd-section-title"><i class="bi bi-shield-plus" aria-hidden="true"></i> Coverage intelligence</span>
                                <div class="sdd-intel-grid">
                                    @foreach (var item in CoverageInsights)
                                    {
                                        <div class="sdd-intel"><i class="bi @item.Icon" aria-hidden="true"></i><strong>@item.Title</strong><span>@item.Description</span></div>
                                    }
                                </div>
                            </div>
                        </section>
                    }
                    else if (_activeTab == 1)
                    {
                        <section class="sdd-market-grid">
                            @foreach (var market in VisibleMarkets)
                            {
                                <div class="sdd-market-card">
                                    <div class="sdd-market-head">
                                        <span><i class="bi bi-bank" aria-hidden="true"></i><strong>@market.CarrierName</strong></span>
                                        @MarketStatusBadge(market.Status)
                                    </div>
                                    <div class="sdd-market-meta">
                                        <span>Appetite @market.AppetiteScore</span>
                                        @if (market.IsRecommended)
                                        {
                                            <span>Recommended</span>
                                        }
                                        <span>Added @market.AddedDateUtc.ToLocalTime().ToString("MMM d")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(market.DeclineReason))
                                    {
                                        <p>@market.DeclineReason</p>
                                    }
                                    <div class="sdd-market-actions">
                                        <button type="button" class="sdd-btn sdd-btn--primary" @onclick="() => SubmitMarketAsync(market)"><i class="bi bi-send" aria-hidden="true"></i> Submit</button>
                                        <button type="button" class="sdd-btn sdd-btn--ghost" @onclick="() => RequestQuoteForMarket(market)"><i class="bi bi-journal-plus" aria-hidden="true"></i> Quote</button>
                                        <button type="button" class="sdd-icon-btn" @onclick="() => ConfirmRemoveMarket(market)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            }
                            @if (!VisibleMarkets.Any())
                            {
                                <div class="sdd-empty"><i class="bi bi-bank" aria-hidden="true"></i><strong>No markets attached</strong><span>Load suggestions or submit to market to create market rows.</span></div>
                            }
                        </section>
                    }
                    else if (_activeTab == 2)
                    {
                        <section class="sdd-quote-grid">
                            @foreach (var quote in VisibleQuotes)
                            {
                                <div class="sdd-quote-card @(quote.QuoteId == _selectedQuoteId ? "sdd-quote-card--selected" : string.Empty)">
                                    @if (quote.AnnualPremium == LowestQuotePremium)
                                    {
                                        <div class="sdd-quote-banner"><i class="bi bi-trophy-fill" aria-hidden="true"></i> Lowest premium</div>
                                    }
                                    <div class="sdd-quote-head"><strong>@quote.CarrierName</strong><span>@quote.AnnualPremium.ToString("C0")</span></div>
                                    <div class="sdd-quote-meta">
                                        <div><small>Quote #</small><strong>@quote.QuoteNumber</strong></div>
                                        <div><small>Status</small><strong>@quote.Status</strong></div>
                                        <div><small>Deductible</small><strong>@MoneyOrDash(quote.Deductible)</strong></div>
                                        <div><small>Limit</small><strong>@MoneyOrDash(quote.Limit)</strong></div>
                                        <div><small>Expires</small><strong>@quote.ExpiresDateUtc.ToLocalTime().ToString("MMM d, yyyy")</strong></div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(quote.CoverageNotes))
                                    {
                                        <p>@quote.CoverageNotes</p>
                                    }
                                    <div class="sdd-quote-actions">
                                        <button type="button" class="sdd-btn @(quote.QuoteId == _selectedQuoteId ? "sdd-btn--primary" : "sdd-btn--ghost")" @onclick="() => SelectQuote(quote)"><i class="bi bi-check-circle" aria-hidden="true"></i> Select</button>
                                        <button type="button" class="sdd-btn sdd-btn--ghost" @onclick="() => CreatePolicyFromQuoteAsync(quote)"><i class="bi bi-shield-check" aria-hidden="true"></i> Bind</button>
                                    </div>
                                </div>
                            }
                            @if (!VisibleQuotes.Any())
                            {
                                <div class="sdd-empty"><i class="bi bi-journal-x" aria-hidden="true"></i><strong>No quotes yet</strong><span>Request a quote from an existing or default carrier market.</span></div>
                            }
                        </section>
                    }
                    else if (_activeTab == 3)
                    {
                        <section class="sdd-question-list">
                            <div class="sdd-progress-card"><span>Underwriting readiness</span><strong>@ReadinessPercent%</strong><div class="sdd-progress"><span style="width:@ReadinessPercent%"></span></div></div>
                            @foreach (var question in _questions)
                            {
                                <div class="sdd-question-row @(question.Required && !question.Answered ? "sdd-question-row--required" : string.Empty)">
                                    <span class="sdd-question-num">Q@question.Number</span>
                                    <div><strong>@question.Text</strong><small>@question.HelpText</small></div>
                                    <button type="button" class="sdd-btn @(question.Answered ? "sdd-btn--primary" : "sdd-btn--ghost")" @onclick="() => ToggleQuestion(question)">@(question.Answered ? "Answered" : "Mark")</button>
                                </div>
                            }
                        </section>
                    }
                    else if (_activeTab == 4)
                    {
                        <section class="sdd-doc-list">
                            @foreach (var doc in _docs)
                            {
                                <div class="sdd-doc-row"><i class="bi @DocIcon(doc.FileName)" aria-hidden="true"></i><div><strong>@doc.FileName</strong><small>@doc.DocType â€¢ @doc.Size â€¢ @doc.UploadedDate.ToString("MMM d, yyyy")</small></div><button type="button" class="sdd-icon-btn" @onclick="ShowDocumentAction"><i class="bi bi-download" aria-hidden="true"></i></button></div>
                            }
                        </section>
                    }
                    else if (_activeTab == 5)
                    {
                        <section class="sdd-comm-list">
                            <div class="sdd-filter-row">
                                @foreach (var filter in _commFilters)
                                {
                                    <button type="button" class="sdd-pill @(_commFilter == filter ? "sdd-pill--active" : string.Empty)" @onclick="() => _commFilter = filter">@filter</button>
                                }
                            </div>
                            @foreach (var comm in VisibleCommunications)
                            {
                                <div class="sdd-comm-row"><i class="bi @CommIcon(comm.Type)" aria-hidden="true"></i><div><strong>@comm.Subject</strong><small>@comm.Type â€¢ @comm.From â†’ @comm.To â€¢ @comm.When.ToString("MMM d, h:mm tt")</small><p>@comm.Body</p></div></div>
                            }
                        </section>
                    }
                    else
                    {
                        <section class="sdd-activity-list">
                            @foreach (var activity in _activity.OrderByDescending(x => x.When))
                            {
                                <div class="sdd-activity-row"><i class="bi @ActivityIcon(activity.Type)" aria-hidden="true"></i><div><strong>@activity.Action</strong><small>@activity.User â€¢ @activity.When.ToString("MMM d, yyyy h:mm tt")</small><p>@activity.Detail</p></div></div>
                            }
                        </section>
                    }
                </div>
            </main>

            <aside class="sdd-side-panel">
                <section class="sdd-panel-card">
                    <span class="sdd-section-kicker">Importance</span>
                    <div class="sdd-score-card"><span>Enterprise score</span><strong>@ImportanceScore</strong><small>@ImportanceLabel</small></div>
                    <div class="sdd-insight-list">
                        @foreach (var reason in ImportanceReasons)
                        {
                            <div><i class="bi bi-check2-circle" aria-hidden="true"></i><span>@reason</span></div>
                        }
                    </div>
                </section>

                <section class="sdd-panel-card">
                    <span class="sdd-section-kicker">Workflow health</span>
                    <div class="sdd-detail-list">
                        <div><span>Markets</span><strong>@_markets.Count</strong></div>
                        <div><span>Submitted</span><strong>@_markets.Count(x => x.Status != "Pending")</strong></div>
                        <div><span>Quotes</span><strong>@_quotes.Count</strong></div>
                        <div><span>Lowest Quote</span><strong>@(_quotes.Any() ? LowestQuotePremium.ToString("C0") : "â€”")</strong></div>
                        <div><span>Questions</span><strong>@_questions.Count(q => q.Answered)/@_questions.Count</strong></div>
                    </div>
                </section>

                <section class="sdd-panel-card">
                    <span class="sdd-section-kicker">Actions</span>
                    <div class="sdd-selected-actions">
                        <button type="button" class="sdd-btn sdd-btn--primary" @onclick='() => OpenActionDialog("submit")'><i class="bi bi-send" aria-hidden="true"></i> Submit Market</button>
                        <button type="button" class="sdd-btn sdd-btn--ghost" @onclick='() => OpenActionDialog("quote")'><i class="bi bi-journal-plus" aria-hidden="true"></i> Request Quote</button>
                        <button type="button" class="sdd-btn sdd-btn--ghost" @onclick='() => OpenActionDialog("policy")'><i class="bi bi-shield-check" aria-hidden="true"></i> Create Policy</button>
                        <button type="button" class="sdd-btn sdd-btn--danger" @onclick='() => OpenActionDialog("decline")'><i class="bi bi-x-circle" aria-hidden="true"></i> Decline</button>
                    </div>
                </section>
            </aside>
        </div>
    </div>
}

@if (_showActionDialog && _submission is not null)
{
    <div class="sdd-modal-backdrop" role="presentation" @onclick="CloseActionDialog">
        <div class="sdd-modal" role="dialog" aria-modal="true" aria-labelledby="sdd-action-title" @onclick:stopPropagation="true">
            <div class="sdd-modal__header">
                <i class="bi @_actionIcon" aria-hidden="true"></i>
                <span id="sdd-action-title">@_actionTitle</span>
                <button type="button" class="sdd-icon-btn sdd-icon-btn--light ms-auto" @onclick="CloseActionDialog" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_actionForm" OnValidSubmit="OpenConfirmDialog" OnInvalidSubmit="NotifyActionValidation">
                <DataAnnotationsValidator />
                <div class="sdd-modal__body">
                    <div class="sdd-modal-intro"><strong>@ActionHelpText</strong><span>@_submission.SubmissionNumber â€” @_submission.AccountName</span></div>
                    <div class="sdd-form-grid">
                        @if (_actionMode is "submit" or "quote" or "policy")
                        {
                            <label class="sdd-field">
                                <span>Carrier Market</span>
                                <InputSelect class="form-select" @bind-Value="_actionForm.CarrierId">
                                    <option value="">Default market</option>
                                    @foreach (var market in _markets)
                                    {
                                        <option value="@market.CarrierId">@market.CarrierName</option>
                                    }
                                </InputSelect>
                            </label>
                        }
                        @if (_actionMode is "quote" or "policy")
                        {
                            <label class="sdd-field">
                                <span>Annual Premium</span>
                                <InputNumber class="form-control" @bind-Value="_actionForm.AnnualPremium" />
                            </label>
                        }
                        @if (_actionMode == "copy")
                        {
                            <label class="sdd-field">
                                <span>Effective Date</span>
                                <InputDate class="form-control" @bind-Value="_actionForm.EffectiveDate" />
                            </label>
                            <label class="sdd-field">
                                <span>Priority</span>
                                <InputText class="form-control" @bind-Value="_actionForm.Priority" />
                            </label>
                        }
                        <label class="sdd-field sdd-field--full">
                            <span>@ActionNotesLabel <em>*</em></span>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_actionForm.Notes" />
                        </label>
                    </div>
                </div>
                <div class="sdd-modal__footer">
                    <button type="button" class="sdd-btn sdd-btn--ghost" @onclick="CloseActionDialog" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="sdd-btn @(_actionMode == "decline" ? "sdd-btn--danger" : "sdd-btn--primary")" disabled="@_actionBusy">@_actionButtonText</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showConfirmDialog)
{
    <div class="sdd-modal-backdrop" role="presentation" @onclick="CloseConfirmDialog">
        <div class="sdd-confirm" role="dialog" aria-modal="true" aria-labelledby="sdd-confirm-title" @onclick:stopPropagation="true">
            <div class="sdd-modal__header">
                <i class="bi @_actionIcon" aria-hidden="true"></i>
                <span>Confirm submission action</span>
                <button type="button" class="sdd-icon-btn sdd-icon-btn--light ms-auto" @onclick="CloseConfirmDialog" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="sdd-confirm__body">
                <div class="@ConfirmIconClass"><i class="bi @_actionIcon" aria-hidden="true"></i></div>
                <div><h3 id="sdd-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div>
            </div>
            <div class="sdd-modal__footer">
                <button type="button" class="sdd-btn sdd-btn--ghost" @onclick="CloseConfirmDialog" disabled="@_actionBusy">Cancel</button>
                <button type="button" class="@ConfirmButtonClass" @onclick="ExecuteConfirmedActionAsync" disabled="@_actionBusy">
                    @if (_actionBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<div class="sdd-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="sdd-toast @toast.CssClass"><i class="bi @ToastIconClass(toast)" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)"><i class="bi bi-x" aria-hidden="true"></i></button></div>
    }
</div>

@code {
    [Parameter] public Guid SubmissionId { get; set; }

    bool _loading = true;
    bool _actionBusy;
    bool _showActionDialog;
    bool _showConfirmDialog;
    int _activeTab;
    string _activeKpi = "overview";
    string _commFilter = "All";
    string _refreshIconClass = string.Empty;
    string? _loadError;
    string _actionMode = string.Empty;
    string _actionTitle = string.Empty;
    string _actionIcon = "bi-lightning-charge";
    string _actionButtonText = "Continue";
    string _confirmTitle = string.Empty;
    string _confirmMessage = string.Empty;
    Guid? _selectedQuoteId;
    SubmissionMarketDto? _pendingRemoveMarket;

    SubmissionDto? _submission;
    readonly List<SubmissionMarketDto> _markets = [];
    readonly List<SubmissionMarketDto> _suggestedMarkets = [];
    readonly List<QuoteComparisonDto> _quotes = [];
    readonly List<DocItem> _docs = [];
    readonly List<UwQuestion> _questions = [];
    readonly List<ActivityItem> _activity = [];
    readonly List<CommItem> _communications = [];
    readonly List<ToastMessage> _toasts = [];
    readonly ActionForm _actionForm = new();

    readonly TabDef[] _tabs =
    [
        new(0, "overview", "Overview", "Submission profile", "Submission Overview", "Risk, account, priority, dates, and coverage intelligence.", "bi-speedometer2"),
        new(1, "markets", "Markets", "Carrier distribution", "Target Markets", "Real carrier market rows, appetite suggestions, and submit/quote actions.", "bi-bank"),
        new(2, "quotes", "Quotes", "Pricing", "Quote Comparison", "Quote options, lowest premium, and policy creation workflow.", "bi-journal-text"),
        new(3, "readiness", "Readiness", "Underwriting", "Question Readiness", "Required underwriting questions and readiness score.", "bi-question-circle"),
        new(4, "docs", "Documents", "Packet", "Submission Packet", "Derived application, schedule, and loss-run document checklist.", "bi-file-earmark-text"),
        new(5, "comms", "Comms", "Engagement", "Communications", "Client, carrier, and internal communication history.", "bi-chat-dots"),
        new(6, "activity", "Activity", "Timeline", "Activity Timeline", "Workflow events, actions, and audit-style activity.", "bi-activity")
    ];

    readonly string[] _commFilters = ["All", "Email", "Call", "Note", "SMS"];

    TabDef CurrentTab => _tabs[_activeTab];
    string PremiumDisplay => _submission?.TargetPremium is > 0 ? _submission.TargetPremium.Value.ToString("C0") : "Not set";
    int DaysToEffective => _submission is null ? 0 : (int)Math.Ceiling((_submission.EffectiveDate.Date - DateTime.Today).TotalDays);
    decimal LowestQuotePremium => _quotes.Any() ? _quotes.Min(q => q.AnnualPremium) : 0;
    int ReadinessPercent => _questions.Count == 0 ? 100 : (int)Math.Round((double)_questions.Count(q => q.Answered) / _questions.Count * 100);
    int ImportanceScore => CalculateImportanceScore();
    string ImportanceLabel => ImportanceScore >= 85 ? "Critical" : ImportanceScore >= 70 ? "High" : ImportanceScore >= 50 ? "Medium" : "Standard";
    IEnumerable<SubmissionMarketDto> VisibleMarkets => _activeKpi == "markets" ? _markets : _markets;
    IEnumerable<QuoteComparisonDto> VisibleQuotes => _activeKpi == "premium" ? _quotes.OrderBy(q => q.AnnualPremium) : _quotes;
    IEnumerable<CommItem> VisibleCommunications => _commFilter == "All" ? _communications : _communications.Where(c => c.Type == _commFilter);
    IEnumerable<IntelItem> CoverageInsights => BuildCoverageInsights();
    IEnumerable<string> ImportanceReasons => BuildImportanceReasons();
    string ConfirmIconClass => _actionMode == "decline" || _actionMode == "remove-market" ? "sdd-confirm-icon sdd-confirm-icon--danger" : "sdd-confirm-icon";
    string ConfirmButtonClass => _actionMode == "decline" || _actionMode == "remove-market" ? "sdd-btn sdd-btn--danger" : "sdd-btn sdd-btn--primary";
    string ActionNotesLabel => _actionMode switch
    {
        "decline" => "Decline Reason",
        "quote" => "Quote Request Notes",
        "submit" => "Submission Notes",
        "copy" => "Copy Notes",
        _ => "Action Notes"
    };
    string ActionHelpText => _actionMode switch
    {
        "submit" => "Submit the package to a carrier market using the existing submit-to-market workflow.",
        "quote" => "Request quote terms using the existing quote request workflow.",
        "policy" => "Create a bound policy from a selected or generated quote using existing policy workflow.",
        "proposal" => "Generate a proposal record from available quotes.",
        "decline" => "Decline this submission and all eligible market rows with a required reason.",
        "copy" => "Create a new copied submission for renewal or remarketing.",
        _ => "Record a note, communication, or workflow action on the dashboard."
    };

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Submissions", "/submissions"), new("Detail", $"/submissions/{SubmissionId}"));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _refreshIconClass = "sdd-spin";
        _loadError = null;
        try
        {
            _submission = await Api.GetSubmissionByIdAsync(SubmissionId);
            if (_submission is null)
            {
                return;
            }

            _markets.Clear();
            _markets.AddRange(await Api.GetSubmissionMarketsAsync(SubmissionId) ?? []);

            _quotes.Clear();
            _quotes.AddRange(await Api.GetSubmissionQuoteComparisonAsync(SubmissionId) ?? []);
            _selectedQuoteId = _quotes.OrderBy(q => q.AnnualPremium).FirstOrDefault()?.QuoteId;

            BuildDerivedDashboardData();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load submission detail: {ex.Message}";
            ShowToast(_loadError, true);
        }
        finally
        {
            _loading = false;
            _refreshIconClass = string.Empty;
        }
    }

    void BuildDerivedDashboardData()
    {
        if (_submission is null) return;
        _docs.Clear();
        _docs.AddRange(BuildDocumentRows(_submission.LineOfBusiness));
        _questions.Clear();
        _questions.AddRange(BuildQuestionRows(_submission.LineOfBusiness));
        _activity.Clear();
        _activity.AddRange(BuildActivityRows(_submission));
        _communications.Clear();
        _communications.AddRange(BuildCommunicationRows(_submission));
    }

    async Task LoadSuggestionsAsync()
    {
        try
        {
            _suggestedMarkets.Clear();
            _suggestedMarkets.AddRange(await Api.GetSubmissionMarketSuggestionsAsync(SubmissionId) ?? []);
            var existing = _markets.Select(m => m.CarrierId).ToHashSet();
            foreach (var suggestion in _suggestedMarkets.Where(s => !existing.Contains(s.CarrierId)).Take(4))
            {
                await Api.AddSubmissionMarketAsync(SubmissionId, new AddSubmissionMarketRequest(SubmissionId, suggestion.CarrierId));
            }
            await LoadAsync();
            _activeTab = 1;
            ShowToast("Market suggestions loaded.");
        }
        catch (Exception ex)
        {
            ShowToast($"Market suggestions failed: {ex.Message}", true);
        }
    }

    void SetTab(int index) => _activeTab = Math.Clamp(index, 0, _tabs.Length - 1);
    void SetKpi(string key, int tabIndex) { _activeKpi = key; SetTab(tabIndex); }
    string TabClass(int index) => _activeTab == index ? "sdd-tab sdd-tab--active" : "sdd-tab";
    string KpiClass(string key, string color) => _activeKpi == key ? $"sdd-kpi sdd-kpi--{color} sdd-kpi--active" : $"sdd-kpi sdd-kpi--{color}";
    string TabCount(string key) => key switch
    {
        "markets" => _markets.Count.ToString(),
        "quotes" => _quotes.Count.ToString(),
        "readiness" => $"{ReadinessPercent}%",
        "docs" => _docs.Count.ToString(),
        "comms" => _communications.Count.ToString(),
        "activity" => _activity.Count.ToString(),
        _ => ImportanceLabel
    };

    RenderFragment KpiCard(string key, string label, string value, string description, string icon, string color, int tabIndex) => @<button type="button" class="@KpiClass(key, color)" title="@description" @onclick="() => SetKpi(key, tabIndex)"><span><i class="bi @icon" aria-hidden="true"></i>@label</span><strong>@value</strong><small>@description</small></button>;
    RenderFragment StatusBadge(string status) => @<strong class="sdd-status @StatusClass(status)">@status</strong>;
    RenderFragment MarketStatusBadge(string status) => @<strong class="sdd-market-status @MarketStatusClass(status)">@status</strong>;

