            await Api.UpdateSubmissionIntakeQuestionAsync(SubmissionId, question.IntakeQuestionId, new UpdateSubmissionIntakeQuestionRequest(_submission.TenantId, answered ? Safe(question.AnswerText, "Confirmed for market readiness") : null, answered, _currentUser?.UserId, statusCode));
