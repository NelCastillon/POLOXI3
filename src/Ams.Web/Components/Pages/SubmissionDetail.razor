        public string? Priority { get; set; }

        public Guid? AssignedToUserId { get; set; }

        public Guid? ProposalId { get; set; }

        public string TaskTitle { get; set; } = string.Empty;

        public string TaskTypeCode { get; set; } = "MissingInformation";

        public DateTime? TaskDueDate { get; set; }

        public string MarketStatus { get; set; } = string.Empty;

        public string QuoteStatus { get; set; } = string.Empty;

        public string? ReasonCode { get; set; }

        public DateTime? NextActionDateUtc { get; set; }

        public string? UnderwriterName { get; set; }

        public string? UnderwriterEmail { get; set; }

        public string? UnderwriterPhone { get; set; }

        public DateTime? MarketDueDateUtc { get; set; }

        public string? RequestedCoverageSummary { get; set; }

        public string? RequestedLimits { get; set; }

        public string SubmissionMethodCode { get; set; } = string.Empty;

        public decimal? Deductible { get; set; }

        public decimal? Limit { get; set; }

        public decimal? CommissionPercent { get; set; }

        public DateTime? QuoteEffectiveDate { get; set; }

        public string? CoverageForms { get; set; }

        public string? Subjectivities { get; set; }

        public string? Exclusions { get; set; }

        public string? CarrierRating { get; set; }

        public string? PaymentTerms { get; set; }

        public decimal? MinimumEarnedPremium { get; set; }

        public decimal? TaxesAndFees { get; set; }

        public decimal? BrokerFee { get; set; }

        public bool TriaIncluded { get; set; }

        public bool IsBindable { get; set; }

        public DateTime? ExpiresDateUtc { get; set; }

        public string DeliveryMethod { get; set; } = string.Empty;

        public string Recipient { get; set; } = string.Empty;

        public string ClientDecision { get; set; } = string.Empty;

        public string QuoteRequestScopeCode { get; set; } = string.Empty;

        public string QuoteRequestActionCode { get; set; } = string.Empty;

        public string? QuoteRequestReasonCode { get; set; }

        public string DocumentTypeCode { get; set; } = "Submission";

        public string DocumentCategoryCode { get; set; } = "Submission";

        [Required, StringLength(1000)]
        public string Notes { get; set; } = string.Empty;

        public void Reset(SubmissionDto? submission)
        {
            CarrierId = null;
            AnnualPremium = submission?.TargetPremium;
            EffectiveDate = submission?.EffectiveDate.AddYears(1);
            PolicyNumber = null;
            PolicySourceCode = "QuoteBound";
            PolicySourceReason = null;
            Priority = submission?.Priority;
            AssignedToUserId = submission?.AssignedToUserId;
            ProposalId = null;
            TaskTitle = submission is null ? string.Empty : $"Follow up on {submission.SubmissionNumber}";
            TaskTypeCode = "MissingInformation";
            TaskDueDate = DateTime.Today.AddDays(2);
            MarketStatus = string.Empty;
            QuoteStatus = string.Empty;
            ReasonCode = null;
            NextActionDateUtc = null;
            UnderwriterName = null;
            UnderwriterEmail = null;
            UnderwriterPhone = null;
            MarketDueDateUtc = DateTime.Today.AddDays(14);
            RequestedCoverageSummary = submission?.LineOfBusiness;
            RequestedLimits = null;
            SubmissionMethodCode = string.Empty;
            Deductible = null;
            Limit = null;
            CommissionPercent = null;
            QuoteEffectiveDate = submission?.EffectiveDate;
            CoverageForms = null;
            Subjectivities = null;
            Exclusions = null;
            CarrierRating = null;
            PaymentTerms = null;
            MinimumEarnedPremium = null;
            TaxesAndFees = null;
            BrokerFee = null;
            TriaIncluded = false;
            IsBindable = false;
            ExpiresDateUtc = DateTime.Today.AddDays(30);
            DeliveryMethod = string.Empty;
            Recipient = string.Empty;
            ClientDecision = string.Empty;
            QuoteRequestScopeCode = string.Empty;
            QuoteRequestActionCode = string.Empty;
            QuoteRequestReasonCode = null;
            DocumentTypeCode = "Submission";
            DocumentCategoryCode = "Submission";
            Notes = string.Empty;
        }
    }

