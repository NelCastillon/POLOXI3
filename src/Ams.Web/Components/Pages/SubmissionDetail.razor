    async Task ExecuteConfirmedAction()
    {
        _actionBusy = true;
        try
        {
            await ExecuteAction();
            _showConfirmDlg = false;
        }
        finally
        {
            _actionBusy = false;
        }
    }

    async Task ExecuteAction()
    {
        try
        {
            if (_actionMode == "submit")
            {
                var selectedMarkets = _markets.Where(m => m.Selected).ToList();
                if (selectedMarkets.Count == 0)
                {
                    selectedMarkets = _markets.Where(m => m.Status == "Pending").Take(1).ToList();
                }

                foreach (var m in selectedMarkets)
                {
                    m.Status     = "Submitted";
                    m.SubmitDate = DateTime.Today;
                    m.Selected   = false;
                }

                if (_sub is not null) _sub.Status = "In Review";
            }
            else if (_actionMode == "quote")
            {
                _showAddQuote = true;
            }
            else if (_actionMode == "bind")
            {
                var selected = _quotes.FirstOrDefault(q => q.Selected) ?? _quotes.OrderBy(q => q.Premium).FirstOrDefault();
                if (selected is not null)
                {
                    await BindQuote(selected);
                }
            }
            else if (_actionMode == "decline" && _sub is not null)
            {
                _sub.Status = "Declined";
                _activity.Insert(0, new() { User = _sub.Producer, Action = "Declined submission", Detail = string.IsNullOrWhiteSpace(_actionNotes) ? "Submission declined from detail page." : _actionNotes, Type = "decline", When = DateTime.Now });
            }
            else if (_actionMode is "email" or "call" or "note")
            {
                var type = _actionMode == "email" ? "Email" : _actionMode == "call" ? "Call" : "Note";
                _comms.Insert(0, new() { Type = type, Subject = _actionTitle, From = "Tenant Admin", To = _sub?.ContactName ?? "Client", Body = _actionNotes, When = DateTime.Now, HasAttachment = false });
            }
            else if (_actionMode == "copy")
            {
                _activity.Insert(0, new() { User = _sub?.Producer ?? "Tenant Admin", Action = "Copied submission", Detail = string.IsNullOrWhiteSpace(_actionNotes) ? "Submission copy prepared." : _actionNotes, Type = "system", When = DateTime.Now });
            }

            ShowToast("Done", $"{_actionTitle} completed.");
        }
        catch (Exception ex)
        {
            ShowToast("Action failed", $"{_actionTitle} failed: {ex.Message}", isError: true);
        }

        _showActionDlg = false;
    }

    void SelectQuote(QuoteItem q)
    {
        foreach (var qt in _quotes) qt.Selected = false;
        q.Selected = true;
        if (_sub is not null) _sub.Status = "Quoted";
    }

    async Task BindQuote(QuoteItem q)
    {
        SelectQuote(q);
        if (_sub is not null) _sub.Status = "Bound";
        _showActionDlg = false;
        ShowToast("Bound", $"Quote {q.QuoteNo} bound. Create a policy to complete.");
    }

    void AddMarket()
    {
        _markets.Add(_newMarket);
        _newMarket     = new();
        _showAddMarket = false;
        ShowToast("Market added", "Carrier market added to this submission.");
    }

    void SaveQuote()
    {
        _quotes.Add(_newQuote);
        foreach (var q in _quotes) q.IsLowest = q.Premium == _quotes.Min(x => x.Premium);
        _newQuote     = new();
        _showAddQuote = false;
        if (_sub is not null) _sub.Status = "Quoted";
        ShowToast("Quote saved", "Carrier quote saved to this submission.");
    }

