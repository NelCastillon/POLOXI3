        public string? PaymentTerms { get; set; }

        public decimal? MinimumEarnedPremium { get; set; }

        public decimal? TaxesAndFees { get; set; }

        public decimal? BrokerFee { get; set; }

        public bool TriaIncluded { get; set; }

        public DateTime? ExpiresDateUtc { get; set; }

        public string DeliveryMethod { get; set; } = "Email";

        public string Recipient { get; set; } = string.Empty;

        public string ClientDecision { get; set; } = "Pending";

        public string DocumentTypeCode { get; set; } = "Submission";

        public string DocumentCategoryCode { get; set; } = "Submission";

        [Required, StringLength(1000)]
        public string Notes { get; set; } = string.Empty;

        public void Reset(SubmissionDto? submission)
        {
            CarrierId = null;
            AnnualPremium = submission?.TargetPremium;
            EffectiveDate = submission?.EffectiveDate.AddYears(1);
            Priority = submission?.Priority;
            AssignedToUserId = submission?.AssignedToUserId;
            ProposalId = null;
            TaskTitle = submission is null ? string.Empty : $"Follow up on {submission.SubmissionNumber}";
            TaskTypeCode = "MissingInformation";
            TaskDueDate = DateTime.Today.AddDays(2);
            MarketStatus = "Selected";
            QuoteStatus = "Received";
            ReasonCode = null;
            NextActionDateUtc = null;
            Deductible = null;
            Limit = null;
            CommissionPercent = null;
            Subjectivities = null;
            Exclusions = null;
            CarrierRating = null;
            PaymentTerms = null;
            MinimumEarnedPremium = null;
            TaxesAndFees = null;
            BrokerFee = null;
            TriaIncluded = false;
            ExpiresDateUtc = DateTime.Today.AddDays(30);
            DeliveryMethod = "Email";
            Recipient = string.Empty;
            ClientDecision = "Pending";
            DocumentTypeCode = "Submission";
            DocumentCategoryCode = "Submission";
            Notes = string.Empty;
        }
    }

