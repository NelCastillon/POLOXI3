@page "/analytics/reports"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject ConfirmationDialogService Confirmations
@inject IJSRuntime Js

<PageTitle>Reports Library â€” AMS</PageTitle>

<AppPageHeader Title="Reports Library"
               Subtitle="Enterprise reporting command center for executive dashboards, operational reports, scheduled delivery, exports, and audit-ready report runs."
               Icon="bi-collection-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_busy"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="OpenScheduleForSelected" disabled="@(_selected is null)"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Schedule</button>
        <button class="um-btn um-btn-primary" type="button" @onclick="ExportVisibleAsync" disabled="@(!_filtered.Any() || _busy)"><i class="bi bi-download" aria-hidden="true"></i> Export View</button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="arl-toast @_toastClass" role="status">
        <i class="bi @(_toastClass == "arl-toast--danger" ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="arl-toast-close" @onclick="ClearToast" aria-label="Dismiss message"><i class="bi bi-x-lg"></i></button>
    </div>
}

<div class="arl-page">
    <section class="arl-hero">
        <div class="arl-hero-main">
            <div class="arl-eyebrow"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Analytics reporting</div>
            <h2>@_reports.Count.ToString("N0") enterprise report definitions</h2>
            <p>Prioritize reports by executive value, operational cadence, export readiness, scheduled delivery, and recent run activity using DB-backed report definitions, executions, and schedules.</p>
            <div class="arl-hero-meta">
                <span><i class="bi bi-calendar-check"></i> @_schedules.Count(s => s.IsActive).ToString("N0") active schedules</span>
                <span><i class="bi bi-play-circle"></i> @_executions.Count.ToString("N0") recent runs</span>
                <span><i class="bi bi-file-earmark-excel"></i> @ExportableCount.ToString("N0") exportable</span>
                <span><i class="bi bi-lightning-charge"></i> @ExecutiveCount.ToString("N0") executive priority</span>
            </div>
        </div>
        <div class="arl-hero-panel">
            <div class="arl-score-card">
                <span>Reporting health score</span>
                <strong>@ReportingHealthScore%</strong>
                <div class="arl-score-track"><div style="width:@ReportingHealthScore%"></div></div>
                <small>@ReportingHealthSummary</small>
            </div>
            <div class="arl-priority-list">
                @foreach (var report in PriorityReports)
                {
                    <button type="button" class="arl-priority-item" @onclick="() => OpenPreviewAsync(report)">
                        <span class="arl-risk arl-risk--@PriorityCss(ReportPriority(report))">@ReportScore(report)</span>
                        <div><strong>@report.ReportName</strong><small>@ReportAction(report)</small></div>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="arl-kpi-strip" aria-label="Report KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="arl-kpi-card @(IsActiveKpi(kpi.Key) ? "arl-kpi-card--active" : null)" title="@kpi.Tooltip" @onclick="() => SetKpi(kpi.Key)">
                <span class="arl-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="arl-kpi-label">@kpi.Label</span>
                <strong>@kpi.Value</strong>
                <small>@kpi.Detail</small>
            </button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger arl-load-error" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError
        </div>
    }

    <section class="arl-command-bar">
        <div class="arl-search-wrap">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input class="arl-search" placeholder="Search reports, modules, types, formats, or descriptionsâ€¦" @bind="_search" @bind:event="oninput" />
        </div>
        <select class="arl-select" @bind="_moduleFilter">
            <option value="">All modules</option>
            @foreach (var module in Modules)
            {
                <option value="@module">@module</option>
            }
        </select>
        <select class="arl-select" @bind="_formatFilter">
            <option value="">All formats</option>
            <option value="PDF">PDF</option>
            <option value="Excel">Excel</option>
            <option value="CSV">CSV</option>
        </select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
        <button type="button" class="um-btn um-btn-ghost" @onclick="RunPriorityReportsAsync" disabled="@(!_filtered.Any() || _busy)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run Priority</button>
    </section>

    <div class="arl-tabs" role="tablist" aria-label="Report views">
        @foreach (var tab in _tabs)
        {
            <button type="button" role="tab" class="arl-tab @(_activeTab == tab.Key ? "arl-tab--active" : null)" @onclick="() => SetTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </div>

    @if (_loading)
    {
        <div class="arl-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading reports...</div>
    }
    else
    {
        <section class="arl-grid">
            <article class="arl-panel">
                <div class="arl-panel-header"><i class="bi bi-files" aria-hidden="true"></i><div><strong>@ActiveListTitle</strong><span>@_filtered.Count.ToString("N0") reports sorted by enterprise importance.</span></div></div>
                @if (!_filtered.Any())
                {
                    <div class="arl-empty"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i><strong>No reports match this view</strong><span>Adjust filters or refresh report seed data.</span></div>
                }
                else
                {
                    <div class="arl-report-list">
                        @foreach (var report in _filtered)
                        {
                            <button type="button" class="arl-report-row @(_selected?.ReportDefinitionId == report.ReportDefinitionId ? "arl-report-row--active" : null)" @onclick="() => OpenPreviewAsync(report)">
                                <span class="arl-module-icon arl-module-icon--@ModuleCss(report.ModuleCode)"><i class="bi @ModuleIcon(report.ModuleCode)" aria-hidden="true"></i></span>
                                <div class="arl-report-main">
                                    <div class="arl-report-title"><strong>@report.ReportName</strong><span class="arl-badge arl-badge--@ModuleCss(report.ModuleCode)">@report.ModuleCode</span><span class="arl-badge arl-badge--type">@report.ReportTypeCode</span></div>
                                    <p>@report.Description</p>
                                    <div class="arl-report-meta"><span>@report.OutputFormats</span><span>@LastRunLabel(report.ReportDefinitionId)</span><span>@ScheduleLabel(report.ReportDefinitionId)</span><span>@(report.IsSystemReport ? "System" : "Custom")</span></div>
                                </div>
                                <span class="arl-row-score">@ReportScore(report)</span>
                            </button>
                        }
                    </div>
                }
            </article>

            <aside class="arl-side">
                @if (_selected is null)
                {
                    <div class="arl-panel"><div class="arl-empty arl-empty--side"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a report</strong><span>Choose a report to preview, run, schedule, export, and inspect delivery workflow.</span></div></div>
                }
                else
                {
                    <article class="arl-panel">
                        <div class="arl-panel-header"><i class="bi @ModuleIcon(_selected.ModuleCode)" aria-hidden="true"></i><div><strong>Report command</strong><span>@_selected.ReportCode Â· @_selected.ModuleCode</span></div></div>
                        <div class="arl-detail">
                            <div class="arl-detail-head">
                                <span class="arl-module-icon arl-module-icon--@ModuleCss(_selected.ModuleCode)"><i class="bi @ModuleIcon(_selected.ModuleCode)" aria-hidden="true"></i></span>
                                <div><strong>@_selected.ReportName</strong><span>@_selected.Description</span></div>
                            </div>
                            <dl>
                                <dt>Type</dt><dd>@_selected.ReportTypeCode</dd>
                                <dt>Formats</dt><dd>@_selected.OutputFormats</dd>
                                <dt>Priority</dt><dd>@ReportPriority(_selected)</dd>
                                <dt>Last run</dt><dd>@LastRunLabel(_selected.ReportDefinitionId)</dd>
                                <dt>Schedule</dt><dd>@ScheduleLabel(_selected.ReportDefinitionId)</dd>
                                <dt>Status</dt><dd>@(_selected.IsActive ? "Active" : "Inactive")</dd>
                                <dt>Action</dt><dd>@ReportAction(_selected)</dd>
                            </dl>
                            <div class="arl-detail-actions">
                                <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenPreviewAsync(_selected)" disabled="@_busy"><i class="bi bi-eye" aria-hidden="true"></i> Preview</button>
                                <button type="button" class="um-btn um-btn-ghost" @onclick="() => RunReportAsync(_selected)" disabled="@_busy"><i class="bi bi-play-fill" aria-hidden="true"></i> Run</button>
                                <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenSchedule(_selected)" disabled="@_busy"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Schedule</button>
                                <button type="button" class="um-btn um-btn-primary" @onclick="() => ExportReportAsync(_selected)" disabled="@_busy"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Export</button>
                            </div>
                        </div>
                    </article>

                    <article class="arl-panel">
                        <div class="arl-panel-header"><i class="bi bi-clock-history" aria-hidden="true"></i><div><strong>Recent workflow</strong><span>Runs and deliveries tied to this report.</span></div></div>
                        <div class="arl-workflow-list">
                            @foreach (var execution in SelectedExecutions.Take(4))
                            {
                                <div class="arl-workflow-row">
                                    <i class="bi bi-check-circle" aria-hidden="true"></i>
                                    <div><strong>@execution.StatusCode @execution.OutputFormat</strong><span>@FormatRelative(execution.CompletedDateUtc ?? execution.CreatedDateUtc) Â· @FormatBytes(execution.FileSizeBytes) Â· @((execution.RowCount ?? 0).ToString("N0")) rows</span></div>
                                </div>
                            }
                            @if (!SelectedExecutions.Any())
                            {
                                <div class="arl-workflow-row arl-workflow-row--muted"><i class="bi bi-dash-circle" aria-hidden="true"></i><div><strong>No recent runs</strong><span>Run the report to create an execution record.</span></div></div>
                            }
                        </div>
                    </article>

                    <article class="arl-panel">
                        <div class="arl-panel-header"><i class="bi bi-calendar-check" aria-hidden="true"></i><div><strong>Scheduled delivery</strong><span>Pause, resume, or delete report delivery.</span></div></div>
                        <div class="arl-schedule-list">
                            @foreach (var schedule in SelectedSchedules)
                            {
                                <div class="arl-schedule-row">
                                    <div><strong>@schedule.FrequencyCode @schedule.OutputFormat</strong><span>@schedule.DeliveryEmail Â· next @FormatDate(schedule.NextRunDateUtc)</span></div>
                                    <div class="arl-row-actions">
                                        <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => ToggleScheduleAsync(schedule)" disabled="@_busy" title="@(schedule.IsActive ? "Pause" : "Activate")"><i class="bi @(schedule.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i></button>
                                        <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => DeleteScheduleAsync(schedule)" disabled="@_busy" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            }
                            @if (!SelectedSchedules.Any())
                            {
                                <button type="button" class="arl-add-schedule" @onclick="() => OpenSchedule(_selected)"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Add scheduled delivery</button>
                            }
                        </div>
                    </article>
                }
            </aside>
        </section>
    }
</div>

@if (_showSchedule)
{
    <div class="arl-modal-backdrop" role="presentation">
        <div class="arl-modal" role="dialog" aria-modal="true" aria-labelledby="schedule-title">
            <div class="um-modal-header">
                <i class="bi bi-calendar-plus" aria-hidden="true"></i><span id="schedule-title">Schedule Report</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseSchedule"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm EditContext="@_scheduleEditContext" OnValidSubmit="ScheduleAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Report <span class="text-danger">*</span></label>
                            <InputSelect @bind-Value="_scheduleForm.ReportDefinitionId" class="um-input">
                                @foreach (var report in ScheduleReportOptions)
                                {
                                    <option value="@report.ReportDefinitionId">@report.ReportName</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Frequency <span class="text-danger">*</span></label>
                            <InputSelect @bind-Value="_scheduleForm.FrequencyCode" class="um-input">
                                @foreach (var frequency in _frequencyOptions)
                                {
                                    <option>@frequency</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Format <span class="text-danger">*</span></label>
                            <InputSelect @bind-Value="_scheduleForm.OutputFormat" class="um-input">
                                @foreach (var format in _formatOptions)
                                {
                                    <option>@format</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field um-field--full">
                            <label>Deliver to <span class="text-danger">*</span></label>
                            <InputText @bind-Value="_scheduleForm.DeliveryEmail" class="um-input" placeholder="ops@agencybinder.local" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_formError))
                        {
                            <div class="alert alert-danger arl-load-error um-field--full" role="alert">@_formError</div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseSchedule">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy"><i class="bi bi-calendar-check" aria-hidden="true"></i> Schedule</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showPreview)
{
    <div class="arl-modal-backdrop" role="presentation">
        <div class="arl-modal arl-modal--wide" role="dialog" aria-modal="true" aria-labelledby="preview-title">
            <div class="um-modal-header">
                <i class="bi @(string.IsNullOrWhiteSpace(_preview?.ModuleCode) ? "bi-file-earmark-bar-graph" : ModuleIcon(_preview.ModuleCode))" aria-hidden="true"></i>
                <div><span id="preview-title">@(_preview?.ReportName ?? "Report Preview")</span><small>@_preview?.Description</small></div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="ClosePreview"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-modal-body arl-preview-body">
                @if (_previewLoading)
                {
                    <div class="arl-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Generating preview...</div>
                }
                else if (!string.IsNullOrWhiteSpace(_previewError))
                {
                    <div class="alert alert-danger arl-load-error" role="alert"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_previewError</div>
                }
                else if (_preview is not null)
                {
                    <div class="arl-preview-summary">
                        <div><span>Module</span><strong>@_preview.ModuleCode</strong></div>
                        <div><span>Type</span><strong>@_preview.ReportTypeCode</strong></div>
                        <div><span>Rows</span><strong>@_preview.RowCount.ToString("N0")</strong></div>
                        <div><span>Generated</span><strong>@_preview.GeneratedDateUtc.ToLocalTime().ToString("MMM d, h:mm tt")</strong></div>
                    </div>
                    <div class="arl-preview-table-wrap">
                        <table class="arl-preview-table">
                            <thead>
                                <tr>
                                    @foreach (var column in _preview.Columns)
                                    {
                                        <th class="@PreviewCellCss(column.DataType)">@column.Header</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _preview.Rows)
                                {
                                    <tr>
                                        @foreach (var column in _preview.Columns)
                                        {
                                            <td class="@PreviewCellCss(column.DataType)">@row.GetValueOrDefault(column.Field)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="ClosePreview">Close</button>
                @if (_previewReport is not null)
                {
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenSchedule(_previewReport)"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Schedule</button>
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => RunReportAsync(_previewReport)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run</button>
                    <button type="button" class="um-btn um-btn-primary" @onclick="() => ExportReportAsync(_previewReport)"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Download Excel</button>
                }
            </div>
        </div>
    </div>
}

<style>
@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }
</style>

@code {
    private readonly TabItem[] _tabs =
    [
        new("all", "All", "bi-stack"),
        new("executive", "Executive", "bi-lightning-charge"),
        new("scheduled", "Scheduled", "bi-calendar-check"),
        new("recent", "Recent Runs", "bi-play-circle"),
        new("exports", "Exportable", "bi-download"),
        new("operational", "Operational", "bi-gear-wide-connected")
    ];

    private readonly string[] _frequencyOptions = ["Daily", "Weekly", "Monthly", "Quarterly"];
    private readonly string[] _formatOptions = ["PDF", "Excel", "CSV"];

    private Guid _tenantId;
    private Guid? _currentUserId;
    private bool _loading;
    private bool _saving;
    private bool _showSchedule;
    private bool _showPreview;
    private bool _previewLoading;
    private string _search = string.Empty;
    private string _activeKpi = "all";
    private string _activeTab = "all";
    private string _moduleFilter = string.Empty;
    private string _formatFilter = string.Empty;
    private string? _loadError;
    private string? _formError;
    private string? _previewError;
    private string? _toastMessage;
    private string _toastClass = "arl-toast--success";
    private List<ReportDefinitionDto> _reports = [];
    private List<ReportDefinitionDto> _filtered = [];
    private List<ReportExecutionDto> _executions = [];
    private List<ReportScheduleDto> _schedules = [];
    private ReportDefinitionDto? _selected;
    private ReportDefinitionDto? _previewReport;
    private ReportPreviewDto? _preview;
    private ScheduleForm _scheduleForm = new();
    private EditContext _scheduleEditContext = default!;
    private bool _busy => _loading || _saving || _previewLoading;

    private IEnumerable<string> Modules => _reports.Select(r => r.ModuleCode).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s);
    private int ExportableCount => _reports.Count(IsExportable);
    private int ExecutiveCount => _reports.Count(IsExecutiveReport);
    private int RecentRunCount => _executions.Count;
    private int ScheduledCount => _schedules.Count(s => s.IsActive);
    private int OperationalCount => _reports.Count(IsOperationalReport);
    private int ReportingHealthScore => _reports.Count == 0 ? 0 : Math.Clamp(72 + Math.Min(14, ScheduledCount * 2) + Math.Min(10, RecentRunCount) + (ExportableCount > 0 ? 4 : 0), 0, 100);
    private string ReportingHealthSummary => ReportingHealthScore >= 92 ? "Reporting workflows are enterprise ready" : ReportingHealthScore >= 82 ? "Core reporting is healthy with delivery opportunities" : "Schedule and run priority reports to improve readiness";
    private IEnumerable<ReportExecutionDto> SelectedExecutions => _selected is null ? [] : _executions.Where(e => e.ReportDefinitionId == _selected.ReportDefinitionId).OrderByDescending(e => e.CreatedDateUtc);
    private IEnumerable<ReportScheduleDto> SelectedSchedules => _selected is null ? [] : _schedules.Where(s => s.ReportDefinitionId == _selected.ReportDefinitionId).OrderBy(s => s.NextRunDateUtc);
    private IEnumerable<ReportDefinitionDto> PriorityReports => _reports.OrderByDescending(r => ReportScore(r)).ThenBy(r => r.ReportName).Take(4);
    private IEnumerable<ReportDefinitionDto> ScheduleReportOptions => _reports.OrderByDescending(r => ReportScore(r)).ThenBy(r => r.ReportName);

    private IEnumerable<KpiItem> Kpis =>
    [
        new("all", "Reports", "bi-file-earmark-bar-graph", _reports.Count.ToString("N0"), "definitions", "Show all report definitions"),
        new("executive", "Executive", "bi-lightning-charge", ExecutiveCount.ToString("N0"), "high value", "Filter executive and analytics reports"),
        new("scheduled", "Scheduled", "bi-calendar-check", ScheduledCount.ToString("N0"), "active deliveries", "Filter scheduled reports"),
        new("recent", "Recent Runs", "bi-play-circle", RecentRunCount.ToString("N0"), "executions", "Filter recently run reports"),
        new("exports", "Exportable", "bi-download", ExportableCount.ToString("N0"), "Excel or CSV", "Filter exportable reports"),
        new("operational", "Operational", "bi-gear-wide-connected", OperationalCount.ToString("N0"), "workflow reports", "Filter operational reports")
    ];

    private string ActiveListTitle => _activeTab switch
    {
        "executive" => "Executive reporting suite",
        "scheduled" => "Scheduled delivery queue",
        "recent" => "Recently executed reports",
        "exports" => "Export-ready reports",
        "operational" => "Operational workflow reports",
        _ => "Enterprise report library"
    };

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _currentUserId = context.UserId;
        _scheduleEditContext = new(_scheduleForm);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var defs = await Api.SearchReportDefinitionsAsync(null);
            var execs = await Api.SearchReportExecutionsAsync(_tenantId, null);
            var schedules = await Api.SearchReportSchedulesAsync(_tenantId, null);
            _reports = defs?.Items.ToList() ?? [];
            _executions = execs?.Items.ToList() ?? [];
            _schedules = schedules?.Items.ToList() ?? [];
            ApplyFilter();
            _selected = _selected is null ? _filtered.FirstOrDefault() : _reports.FirstOrDefault(r => r.ReportDefinitionId == _selected.ReportDefinitionId) ?? _filtered.FirstOrDefault();
            if (_selected is null && _reports.Count > 0)
            {
                _selected = _reports.OrderByDescending(ReportScore).FirstOrDefault();
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load report data: {ex.Message}";
            _reports = [];
            _filtered = [];
            _executions = [];
            _schedules = [];
            ShowToast(_loadError, true);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilter()
    {
        _filtered = _reports
            .Where(MatchesSearch)
            .Where(r => string.IsNullOrWhiteSpace(_moduleFilter) || r.ModuleCode == _moduleFilter)
            .Where(r => string.IsNullOrWhiteSpace(_formatFilter) || r.OutputFormats.Contains(_formatFilter, StringComparison.OrdinalIgnoreCase))
            .Where(MatchesActiveView)
            .OrderByDescending(ReportScore)
            .ThenBy(r => r.ModuleCode)
            .ThenBy(r => r.ReportName)
            .ToList();
    }

    private bool MatchesSearch(ReportDefinitionDto report)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return report.ReportName.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || report.ReportCode.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || report.ModuleCode.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || report.ReportTypeCode.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || report.OutputFormats.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (report.Description?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private bool MatchesActiveView(ReportDefinitionDto report) => _activeTab switch
    {
        "executive" => IsExecutiveReport(report),
        "scheduled" => IsScheduled(report.ReportDefinitionId),
        "recent" => _executions.Any(e => e.ReportDefinitionId == report.ReportDefinitionId),
        "exports" => IsExportable(report),
        "operational" => IsOperationalReport(report),
        _ => true
    };

    private void SetKpi(string key)
    {
        _activeKpi = key;
        _activeTab = key;
        ApplyFilter();
    }

    private void SetTab(string key)
    {
        _activeTab = key;
        _activeKpi = key;
        ApplyFilter();
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _moduleFilter = string.Empty;
        _formatFilter = string.Empty;
        _activeKpi = "all";
        _activeTab = "all";
        ApplyFilter();
    }

    private bool IsActiveKpi(string key) => _activeKpi == key;
    private void SelectReport(ReportDefinitionDto report) => _selected = report;
    private void OpenScheduleForSelected() { if (_selected is not null) OpenSchedule(_selected); }

    private int TabCount(string key) => key switch
    {
        "executive" => _reports.Count(IsExecutiveReport),
        "scheduled" => _reports.Count(r => IsScheduled(r.ReportDefinitionId)),
        "recent" => _reports.Count(r => _executions.Any(e => e.ReportDefinitionId == r.ReportDefinitionId)),
        "exports" => ExportableCount,
        "operational" => OperationalCount,
        _ => _reports.Count
    };

    private async Task OpenPreviewAsync(ReportDefinitionDto report)
    {
        _selected = report;
        _previewReport = report;
        _preview = null;
        _previewError = null;
        _previewLoading = true;
        _showPreview = true;
        try
        {
            _preview = await Api.GetReportPreviewAsync(report.ReportDefinitionId, _tenantId);
        }
        catch (Exception ex)
        {
            _previewError = $"Preview failed: {ex.Message}";
        }
        finally
        {
            _previewLoading = false;
        }
    }

    private void ClosePreview()
    {
        _showPreview = false;
        _previewError = null;
        _previewLoading = false;
    }

    private void OpenSchedule(ReportDefinitionDto report)
    {
        _scheduleForm = new ScheduleForm
        {
            ReportDefinitionId = report.ReportDefinitionId,
            OutputFormat = PreferredFormat(report),
            FrequencyCode = IsExecutiveReport(report) ? "Weekly" : "Monthly",
            DeliveryEmail = "ops@agencybinder.local"
        };
        _scheduleEditContext = new(_scheduleForm);
        _formError = null;
        _showSchedule = true;
    }

    private void CloseSchedule()
    {
        _showSchedule = false;
        _formError = null;
    }

    private async Task RunReportAsync(ReportDefinitionDto report)
    {
        _saving = true;
        try
        {
            await Api.RunReportAsync(report.ReportDefinitionId, new RunReportRequest(_tenantId, PreferredFormat(report), _currentUserId));
            ShowToast($"Report run completed: {report.ReportName}");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Run failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RunPriorityReportsAsync()
    {
        var candidates = _filtered.Take(3).ToList();
        foreach (var report in candidates)
        {
            await RunReportAsync(report);
        }
        if (candidates.Count > 0)
        {
            ShowToast($"Priority run completed for {candidates.Count} report(s).");
        }
    }

    private async Task ExportReportAsync(ReportDefinitionDto report)
    {
        _saving = true;
        try
        {
            var file = await Api.DownloadReportExcelAsync(report.ReportDefinitionId, _tenantId);
            await DownloadFileAsync(file);
            ShowToast($"Excel downloaded: {report.ReportName}");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Export failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ExportVisibleAsync()
    {
        _saving = true;
        try
        {
            var file = await Api.DownloadReportsExcelAsync(new DownloadReportsRequest
            {
                TenantId = _tenantId,
                ReportDefinitionIds = _filtered.Select(r => r.ReportDefinitionId).ToList(),
                SearchTerm = _search,
                ModuleCode = _moduleFilter,
                Format = _formatFilter
            });
            await DownloadFileAsync(file);
            ShowToast($"Excel downloaded for {_filtered.Count} report(s).");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Export view failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ScheduleAsync()
    {
        _formError = null;
        if (!_scheduleEditContext.Validate()) return;
        _saving = true;
        try
        {
            await Api.ScheduleReportAsync(new ScheduleReportRequest(_tenantId, _scheduleForm.ReportDefinitionId, _scheduleForm.FrequencyCode, _scheduleForm.OutputFormat, _scheduleForm.DeliveryEmail));
            _showSchedule = false;
            ShowToast($"Report scheduled for {_scheduleForm.DeliveryEmail}.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = $"Schedule failed: {ex.Message}";
            ShowToast($"Schedule failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleScheduleAsync(ReportScheduleDto schedule)
    {
        _saving = true;
        try
        {
            await Api.SetReportScheduleStatusAsync(schedule.ReportScheduleId, !schedule.IsActive);
            ShowToast(schedule.IsActive ? "Schedule paused." : "Schedule activated.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Update failed: {ex.Message}", true);
        }
        finally
