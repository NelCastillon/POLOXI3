@page "/analytics/reports"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Reports Library — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Reports Library"
               Subtitle="Browse, run, schedule, and export all agency reports from a central catalog"
               Icon="bi-collection-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="() => _showSchedule = true">
            <i class="bi bi-calendar-plus" aria-hidden="true"></i> Schedule Report
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/analytics/dashboards")'>
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Dashboard
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="rl-kpi-strip">
    <div class="rl-kpi-card">
        <div class="rl-kpi-icon rl-ki-blue"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i></div>
        <div><div class="rl-kv">@_reports.Count</div><div class="rl-kl">Total Reports</div></div>
    </div>
    <div class="rl-kpi-card">
        <div class="rl-kpi-icon rl-ki-green"><i class="bi bi-calendar-check" aria-hidden="true"></i></div>
        <div><div class="rl-kv">@_reports.Count(r => r.IsScheduled)</div><div class="rl-kl">Scheduled</div></div>
    </div>
    <div class="rl-kpi-card">
        <div class="rl-kpi-icon rl-ki-amber"><i class="bi bi-star-fill" aria-hidden="true"></i></div>
        <div><div class="rl-kv">@_reports.Count(r => r.IsFavorite)</div><div class="rl-kl">Favorites</div></div>
    </div>
    <div class="rl-kpi-card">
        <div class="rl-kpi-icon rl-ki-green"><i class="bi bi-download" aria-hidden="true"></i></div>
        <div><div class="rl-kv">248</div><div class="rl-kl">Exports This Month</div></div>
    </div>
</div>

<!-- Filter bar -->
<div class="rl-filter-bar">
    <div class="rl-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="rl-search" placeholder="Search reports…" @bind="_search" @bind:event="oninput" />
    </div>
    <select class="rl-sel" @bind="_catFilter">
        <option value="">All Categories</option>
        <option value="Sales">Sales</option>
        <option value="Retention">Retention</option>
        <option value="Claims">Claims</option>
        <option value="Finance">Finance</option>
        <option value="Producer">Producer</option>
        <option value="Marketing">Marketing</option>
        <option value="Service">Service</option>
        <option value="Compliance">Compliance</option>
    </select>
    <select class="rl-sel" @bind="_fmtFilter">
        <option value="">All Formats</option>
        <option value="PDF">PDF</option>
        <option value="Excel">Excel</option>
        <option value="CSV">CSV</option>
    </select>
    <div class="rl-view-toggle">
        <button class="rl-vbtn @(_view=="grid"?"rl-vbtn--active":"")" @onclick='()=>_view="grid"'><i class="bi bi-grid" aria-hidden="true"></i></button>
        <button class="rl-vbtn @(_view=="list"?"rl-vbtn--active":"")" @onclick='()=>_view="list"'><i class="bi bi-list-ul" aria-hidden="true"></i></button>
    </div>
</div>

@if (_view == "grid")
{
    <div class="rl-report-grid">
        @foreach (var r in Filtered)
        {
            <div class="rl-report-card">
                <div class="rl-card-top">
                    <div class="rl-card-icon @CatIconCss(r.Category)"><i class="bi @CatIcon(r.Category)" aria-hidden="true"></i></div>
                    <button class="rl-fav-btn" @onclick="() => r.IsFavorite = !r.IsFavorite" title="@(r.IsFavorite?"Unfavorite":"Favorite")">
                        <i class="bi @(r.IsFavorite?"bi-star-fill rl-fav-on":"bi-star")" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="rl-card-name">@r.Name</div>
                <div class="rl-card-desc">@r.Description</div>
                <div class="rl-card-meta">
                    <span class="@CatBadge(r.Category)">@r.Category</span>
                    @if (r.IsScheduled) { <span class="rl-sched-chip"><i class="bi bi-calendar-check" aria-hidden="true"></i> Scheduled</span> }
                </div>
                <div class="rl-card-footer">
                    <span class="rl-card-run">Last run @r.LastRun.ToString("MMM d")</span>
                    <div class="rl-card-actions">
                        <button class="um-btn um-btn-ghost um-btn-xs" title="Run now" @onclick="() => RunReport(r)"><i class="bi bi-play-fill" aria-hidden="true"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" title="Export"><i class="bi bi-download" aria-hidden="true"></i></button>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="rl-list-wrap">
        <SfGrid TValue="ReportDef" DataSource="Filtered" AllowSorting="true" EnableHover="true" RowHeight="52">
            <GridColumns>
                <GridColumn HeaderText="Report" MinWidth="240" Field="@nameof(ReportDef.Name)">
                    <Template>
                        @{ var r = (ReportDef)context; }
                        <div class="rl-list-name-cell">
                            <div class="rl-list-icon @CatIconCss(r.Category)"><i class="bi @CatIcon(r.Category)" aria-hidden="true"></i></div>
                            <div>
                                <div class="rl-ln">@r.Name</div>
                                <div class="rl-ld">@r.Description</div>
                            </div>
                        </div>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(ReportDef.Category)" HeaderText="Category" Width="130">
                    <Template>@{ var r = (ReportDef)context; }<span class="@CatBadge(r.Category)">@r.Category</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(ReportDef.DefaultFormat)" HeaderText="Format" Width="90" />
                <GridColumn Field="@nameof(ReportDef.LastRun)" HeaderText="Last Run" Width="130" Type="ColumnType.DateTime" Format="MMM d, yyyy" />
                <GridColumn Field="@nameof(ReportDef.RunCount)" HeaderText="Runs" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                <GridColumn Field="@nameof(ReportDef.IsScheduled)" HeaderText="Scheduled" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                    <Template>@{ var r = (ReportDef)context; }<i class="bi @(r.IsScheduled?"bi-check-circle-fill rl-yes":"bi-dash rl-no")" aria-hidden="true"></i></Template>
                </GridColumn>
                <GridColumn HeaderText="" Width="110" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                    <Template>
                        @{ var r = (ReportDef)context; }
                        <div class="rl-row-actions">
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => RunReport(r)" title="Run"><i class="bi bi-play-fill" aria-hidden="true"></i></button>
                            <button class="um-btn um-btn-ghost um-btn-xs" title="Export"><i class="bi bi-download" aria-hidden="true"></i></button>
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => r.IsFavorite=!r.IsFavorite" title="Favorite"><i class="bi @(r.IsFavorite?"bi-star-fill rl-fav-on":"bi-star")" aria-hidden="true"></i></button>
                        </div>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
}

<!-- Schedule dialog -->
<SfDialog @bind-Visible="_showSchedule" Width="480px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="rl-dlg-hdr"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Schedule Report</span></Header>
        <Content>
            <div class="rl-dlg-body">
                <div class="rl-dlg-row">
                    <SfDropDownList TValue="string" TItem="Lv" DataSource="_reportOpts" Placeholder="Select report *" Width="100%" @bind-Value="_schedReport">
                        <DropDownListFieldSettings Value="V" Text="L" />
                    </SfDropDownList>
                    <SfDropDownList TValue="string" TItem="Lv" DataSource="_freqOpts" Placeholder="Frequency" Width="100%" @bind-Value="_schedFreq">
                        <DropDownListFieldSettings Value="V" Text="L" />
                    </SfDropDownList>
                </div>
                <div class="rl-dlg-row">
                    <SfTextBox Placeholder="Deliver to (email)" @bind-Value="_schedEmail" />
                    <SfDropDownList TValue="string" TItem="Lv" DataSource="_fmtOpts" Placeholder="Format" Width="100%" @bind-Value="_schedFmt">
                        <DropDownListFieldSettings Value="V" Text="L" />
                    </SfDropDownList>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="rl-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showSchedule = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitSchedule">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Schedule
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    private SfToast? _toast;
    private string _search = string.Empty;
    private string _catFilter = string.Empty;
    private string _fmtFilter = string.Empty;
    private string _view = "grid";
    private bool _showSchedule;
    private string _schedReport = string.Empty;
    private string _schedFreq = "Weekly";
    private string _schedEmail = string.Empty;
    private string _schedFmt = "PDF";

    private List<ReportDef> _reports = [];

    private static readonly List<Lv> _freqOpts = [new("Daily","Daily"), new("Weekly","Weekly"), new("Monthly","Monthly"), new("Quarterly","Quarterly")];
    private static readonly List<Lv> _fmtOpts  = [new("PDF","PDF"), new("Excel","Excel"), new("CSV","CSV")];
    private List<Lv> _reportOpts => _reports.Select(r => new Lv(r.Name, r.Name)).ToList();

    private IEnumerable<ReportDef> Filtered => _reports.Where(r =>
        (string.IsNullOrEmpty(_search) || r.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || r.Description.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_catFilter) || r.Category == _catFilter) &&
        (string.IsNullOrEmpty(_fmtFilter) || r.DefaultFormat == _fmtFilter));

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Analytics","/analytics/reports"), new("Reports Library",""));
        _reports =
        [
            new ReportDef { Id=1,  Name="Book of Business Summary",        Category="Sales",      DefaultFormat="PDF",   Description="Premium, policy count, and LOB breakdown for the full book.", LastRun=DateTime.Today.AddDays(-1),  RunCount=42, IsScheduled=true,  IsFavorite=true  },
            new ReportDef { Id=2,  Name="New Business Production",         Category="Sales",      DefaultFormat="Excel", Description="New accounts and policies written by period, producer, and LOB.", LastRun=DateTime.Today.AddDays(-3),  RunCount=28, IsScheduled=true,  IsFavorite=false },
            new ReportDef { Id=3,  Name="Renewal Retention Rate",          Category="Retention",  DefaultFormat="PDF",   Description="Retention rate by LOB, producer, and policy tier.", LastRun=DateTime.Today.AddDays(-7),  RunCount=19, IsScheduled=true,  IsFavorite=true  },
            new ReportDef { Id=4,  Name="Expiring Policies (60/30/14 Day)",Category="Retention",  DefaultFormat="Excel", Description="Upcoming expirations with premium and renewal probability.", LastRun=DateTime.Today.AddDays(-1),  RunCount=61, IsScheduled=true,  IsFavorite=false },
            new ReportDef { Id=5,  Name="Loss Ratio by Line of Business",  Category="Claims",     DefaultFormat="PDF",   Description="Incurred losses vs earned premium by LOB and carrier.", LastRun=DateTime.Today.AddDays(-14), RunCount=15, IsScheduled=false, IsFavorite=false },
            new ReportDef { Id=6,  Name="Open Claims Register",            Category="Claims",     DefaultFormat="Excel", Description="All open claims with age, status, reserves, and adjuster.", LastRun=DateTime.Today.AddDays(-2),  RunCount=34, IsScheduled=true,  IsFavorite=false },
            new ReportDef { Id=7,  Name="Commission Statement Summary",    Category="Finance",    DefaultFormat="PDF",   Description="Commission earned, paid, and pending by producer and period.", LastRun=DateTime.Today.AddDays(-5),  RunCount=22, IsScheduled=true,  IsFavorite=true  },
            new ReportDef { Id=8,  Name="AR Aging Report",                 Category="Finance",    DefaultFormat="Excel", Description="Accounts receivable aging buckets: current, 30, 60, 90+ days.", LastRun=DateTime.Today.AddDays(-3),  RunCount=31, IsScheduled=true,  IsFavorite=false },
            new ReportDef { Id=9,  Name="Producer Scorecard",              Category="Producer",   DefaultFormat="PDF",   Description="Per-producer new business, retention, revenue, and activity KPIs.", LastRun=DateTime.Today.AddDays(-7),  RunCount=18, IsScheduled=false, IsFavorite=true  },
            new ReportDef { Id=10, Name="Campaign ROI Analysis",           Category="Marketing",  DefaultFormat="Excel", Description="Revenue attributed to marketing campaigns vs spend.", LastRun=DateTime.Today.AddDays(-10), RunCount=9,  IsScheduled=false, IsFavorite=false },
            new ReportDef { Id=11, Name="Service Request Aging",           Category="Service",    DefaultFormat="Excel", Description="Open service requests by age, type, and assigned staff.", LastRun=DateTime.Today.AddDays(-2),  RunCount=27, IsScheduled=true,  IsFavorite=false },
            new ReportDef { Id=12, Name="Compliance Acknowledgements",     Category="Compliance", DefaultFormat="PDF",   Description="Policy acknowledgement completion rates and outstanding items.", LastRun=DateTime.Today.AddDays(-30),RunCount=6,  IsScheduled=false, IsFavorite=false },
        ];
    }

    private async Task RunReport(ReportDef r)
    {
        r.LastRun = DateTime.Today; r.RunCount++;
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Running '{r.Name}'…", CssClass = "e-toast-success" });
    }

    private async Task CommitSchedule()
    {
        var target = _reports.FirstOrDefault(r => r.Name == _schedReport);
        if (target is not null) target.IsScheduled = true;
        _showSchedule = false;
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"Report scheduled — {_schedFreq} delivery to {_schedEmail}.", CssClass = "e-toast-success" });
    }

    private static string CatIcon(string c) => c switch
    {
        "Sales"      => "bi-graph-up-arrow",
        "Retention"  => "bi-arrow-clockwise",
        "Claims"     => "bi-exclamation-circle",
        "Finance"    => "bi-bank",
        "Producer"   => "bi-person-badge",
        "Marketing"  => "bi-megaphone",
        "Service"    => "bi-headset",
        "Compliance" => "bi-patch-check",
        _            => "bi-file-earmark-bar-graph",
    };

    private static string CatIconCss(string c) => c switch
    {
        "Sales"      => "rl-ci-blue",
        "Retention"  => "rl-ci-green",
        "Claims"     => "rl-ci-red",
        "Finance"    => "rl-ci-green",
        "Producer"   => "rl-ci-purple",
        "Marketing"  => "rl-ci-amber",
        "Service"    => "rl-ci-blue",
        "Compliance" => "rl-ci-amber",
        _            => "rl-ci-blue",
    };

    private static string CatBadge(string c) => c switch
    {
        "Sales"      => "rl-cat rl-cat--sales",
        "Retention"  => "rl-cat rl-cat--ret",
        "Claims"     => "rl-cat rl-cat--claims",
        "Finance"    => "rl-cat rl-cat--fin",
        "Producer"   => "rl-cat rl-cat--prod",
        "Marketing"  => "rl-cat rl-cat--mkt",
        "Service"    => "rl-cat rl-cat--svc",
        "Compliance" => "rl-cat rl-cat--comp",
        _            => "rl-cat",
    };

    private sealed class ReportDef
    {
        public int      Id            { get; set; }
        public string   Name          { get; set; } = string.Empty;
        public string   Category      { get; set; } = string.Empty;
        public string   DefaultFormat { get; set; } = "PDF";
        public string   Description   { get; set; } = string.Empty;
        public DateTime LastRun       { get; set; }
        public int      RunCount      { get; set; }
        public bool     IsScheduled   { get; set; }
        public bool     IsFavorite    { get; set; }
    }

    private sealed record Lv(string V, string L);
}
