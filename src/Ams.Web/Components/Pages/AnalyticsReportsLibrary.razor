    private async Task DeleteScheduleAsync(ReportScheduleDto schedule)
    {
        if (!await Confirmations.ConfirmAsync("Delete schedule", $"Delete scheduled delivery for {schedule.ReportName}?", "Delete")) return;
        _saving = true;
        try
        {
            await Api.DeleteReportScheduleAsync(schedule.ReportScheduleId);
            ShowToast("Schedule deleted.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Delete failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DownloadFileAsync(ReportDownloadFile file)
    {
        var fileName = file.FileName.Replace("'", string.Empty).Replace("\"", string.Empty);
        var base64 = Convert.ToBase64String(file.Content);
        var script = $"(() => {{ const a = document.createElement(\"a\"); a.href = \"data:application/vnd.ms-excel;base64,{base64}\"; a.download = \"{fileName}\"; document.body.appendChild(a); a.click(); a.remove(); }})()";
        await Js.InvokeVoidAsync("eval", script);
    }

    private void ShowToast(string message, bool danger = false)
    {
        _toastMessage = message;
        _toastClass = danger ? "arl-toast--danger" : "arl-toast--success";
    }

    private void ClearToast() => _toastMessage = null;

    private bool IsScheduled(Guid reportDefinitionId) => _schedules.Any(s => s.ReportDefinitionId == reportDefinitionId && s.IsActive);
    private static bool IsExportable(ReportDefinitionDto report) => report.OutputFormats.Contains("Excel", StringComparison.OrdinalIgnoreCase) || report.OutputFormats.Contains("CSV", StringComparison.OrdinalIgnoreCase);
    private static bool IsExecutiveReport(ReportDefinitionDto report) => report.ModuleCode is "Agency" or "Finance" or "Sales" || report.ReportTypeCode is "Dashboard" or "Analytics" or "Financial";
    private static bool IsOperationalReport(ReportDefinitionDto report) => report.ModuleCode is "Retention" or "Claims" or "Policy" || report.ReportTypeCode is "Operational" or "Detail";
    private static string PreferredFormat(ReportDefinitionDto report) => report.OutputFormats.Contains("Excel", StringComparison.OrdinalIgnoreCase) ? "Excel" : report.OutputFormats.Contains("CSV", StringComparison.OrdinalIgnoreCase) ? "CSV" : "PDF";

    private int ReportScore(ReportDefinitionDto report)
    {
        var score = 18;
        if (IsExecutiveReport(report)) score += 26;
        if (IsOperationalReport(report)) score += 14;
        if (IsScheduled(report.ReportDefinitionId)) score += 18;
        if (_executions.Any(e => e.ReportDefinitionId == report.ReportDefinitionId)) score += 16;
        if (IsExportable(report)) score += 8;
        if (report.IsSystemReport) score += 5;
        return Math.Clamp(score, 0, 100);
    }

    private string ReportPriority(ReportDefinitionDto report)
    {
        var score = ReportScore(report);
        return score >= 76 ? "Critical" : score >= 62 ? "High" : score >= 44 ? "Normal" : "Low";
    }

    private string ReportAction(ReportDefinitionDto report)
    {
        if (!IsScheduled(report.ReportDefinitionId) && IsExecutiveReport(report)) return "Schedule executive delivery and run current-period export.";
        if (!_executions.Any(e => e.ReportDefinitionId == report.ReportDefinitionId)) return "Run report to create an audit-ready execution record.";
        if (IsExportable(report)) return "Ready for Excel/CSV export and downstream analysis.";
        return "Review definition and keep active for operational reporting.";
    }

    private string LastRunLabel(Guid reportDefinitionId)
        => _executions.Where(e => e.ReportDefinitionId == reportDefinitionId).OrderByDescending(e => e.CreatedDateUtc).FirstOrDefault() is { } execution
            ? $"Run {FormatRelative(execution.CompletedDateUtc ?? execution.CreatedDateUtc)}"
            : "Never run";

    private string ScheduleLabel(Guid reportDefinitionId)
        => _schedules.Where(s => s.ReportDefinitionId == reportDefinitionId && s.IsActive).OrderBy(s => s.NextRunDateUtc).FirstOrDefault() is { } schedule
            ? $"{schedule.FrequencyCode} delivery"
            : "Not scheduled";

    private static string FormatBytes(long? bytes) => bytes is null ? "â€”" : bytes < 1024 * 1024 ? $"{bytes / 1024m:N1} KB" : $"{bytes / 1024m / 1024m:N1} MB";
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("MMM d, yyyy") : "not set";
    private static string PreviewCellCss(string dataType) => dataType is "Currency" or "Number" ? "arl-preview-num" : string.Empty;
    private static string PriorityCss(string value) => value.ToLowerInvariant();

    private static string FormatRelative(DateTime? utc)
    {
        if (utc is null || utc == default) return "never";
        var diff = DateTime.UtcNow - utc.Value.ToUniversalTime();
        if (diff.TotalMinutes < 60) return $"{Math.Max(1, (int)diff.TotalMinutes)}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }

