@page "/documents"
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Components.Rendering
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Documents
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Documents Hub â€” AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="dh-toast dh-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="dh-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showUpload)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseUpload">
        <div class="mt-modal dh-action-modal" role="dialog" aria-modal="true" aria-labelledby="dh-upload-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span id="dh-upload-title">Upload Document</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseUpload" disabled="@_busy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_uploadForm" OnValidSubmit="SubmitUploadAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="dh-modal-intro">
                        <span class="dh-modal-chip"><i class="bi bi-folder-check" aria-hidden="true"></i> Enterprise repository</span>
                        <p>Upload, classify, retain, and audit tenant documents through the governed document workflow.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Document File <span class="text-danger">*</span></label>
                            <InputFile OnChange="OnUploadFileChanged" />
                            @if (_uploadFile is null && _uploadAttempted)
                            {
                                <div class="text-danger">A document file is required.</div>
                            }
                        </div>
                        <div class="um-field um-field--full">
                            <label>File Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_uploadForm.FileName" />
                        </div>
                        <div class="um-field">
                            <label>Category <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_uploadForm.CategoryCode">
                                @foreach (var category in UploadCategories)
                                {
                                    <option value="@category.Code">@category.Label</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Document Type <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_uploadForm.DocumentTypeCode" />
                        </div>
                        <div class="um-field">
                            <label>Linked Entity</label>
                            <InputText class="form-control" @bind-Value="_uploadForm.EntityName" placeholder="Account, Policy, Claim..." />
                        </div>
                        <div class="um-field">
                            <label>Retention Date</label>
                            <InputDate class="form-control" @bind-Value="_uploadForm.RetentionDate" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Description</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_uploadForm.Description" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Tags</label>
                            <InputText class="form-control" @bind-Value="_uploadForm.Tags" placeholder="policy, certificate, renewal" />
                        </div>
                        <div class="um-field">
                            <label>Uploaded By</label>
                            <InputText class="form-control" @bind-Value="_uploadForm.UploadedByName" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseUpload" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        Upload Document
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showMetadata && _selected is not null)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseMetadata">
        <div class="mt-modal dh-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="dh-metadata-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-tags" aria-hidden="true"></i>
                <span id="dh-metadata-title">Edit Metadata</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseMetadata" disabled="@_busy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_metadataForm" OnValidSubmit="SubmitMetadataAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Description</label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_metadataForm.Description" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Tags</label>
                            <InputText class="form-control" @bind-Value="_metadataForm.Tags" />
                        </div>
                        <div class="um-field">
                            <label>Retention Date</label>
                            <InputDate class="form-control" @bind-Value="_metadataForm.RetentionDate" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseMetadata" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">Save Metadata</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showNewVersion && _selected is not null)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseVersion">
        <div class="mt-modal dh-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="dh-version-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-layers" aria-hidden="true"></i>
                <span id="dh-version-title">Upload New Version</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseVersion" disabled="@_busy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_versionForm" OnValidSubmit="SubmitVersionAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Version File <span class="text-danger">*</span></label>
                            <InputFile OnChange="OnVersionFileChanged" />
                            @if (_versionFile is null && _versionAttempted)
                            {
                                <div class="text-danger">A version file is required.</div>
                            }
                        </div>
                        <div class="um-field um-field--full">
                            <label>File Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_versionForm.FileName" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Change Notes</label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_versionForm.ChangeNotes" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseVersion" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">Upload Version</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showShareDialog && _selected is not null)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseShare">
        <div class="mt-modal dh-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="dh-share-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-share" aria-hidden="true"></i>
                <span id="dh-share-title">Create Share Link</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseShare" disabled="@_busy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_shareForm" OnValidSubmit="SubmitShareLinkAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field">
                            <label>Expires UTC <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="_shareForm.ExpiresDateUtc" />
                        </div>
                        <div class="um-field">
                            <label>Max Access Count</label>
                            <InputNumber class="form-control" @bind-Value="_shareForm.MaxAccessCount" />
                        </div>
                        <div class="um-field um-field--checkbox">
                            <label><InputCheckbox @bind-Value="_shareForm.RequiresPin" /> Require PIN</label>
                        </div>
                        @if (_shareForm.RequiresPin)
                        {
                            <div class="um-field">
                                <label>PIN <span class="text-danger">*</span></label>
                                <InputText type="password" class="form-control" @bind-Value="_shareForm.Pin" />
                            </div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseShare" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">Create Link</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showRename && _selected is not null)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseRename">
        <div class="mt-modal dh-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="dh-rename-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-pencil" aria-hidden="true"></i>
                <span id="dh-rename-title">Rename Document</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseRename" disabled="@_busy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_renameForm" OnValidSubmit="SubmitRenameAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>New File Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_renameForm.NewFileName" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseRename" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">Rename</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_confirmAction is not null)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseConfirm">
        <div class="mt-modal dh-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="dh-confirm-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon @ConfirmIconClass"><i class="bi @ConfirmIcon" aria-hidden="true"></i></div>
                <div class="um-confirm-message">
                    <h6 id="dh-confirm-title">@_confirmAction Document?</h6>
                    <p>@ConfirmMessage</p>
                </div>
                <div class="um-modal-footer w-100">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseConfirm" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn @ConfirmButtonClass" @onclick="ExecuteConfirmAsync" disabled="@_busy">@_confirmAction</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_shareLinksVisible && _selected is not null)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseShareLinks">
        <div class="mt-modal dh-action-modal" role="dialog" aria-modal="true" aria-labelledby="dh-links-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-link-45deg" aria-hidden="true"></i>
                <span id="dh-links-title">Share Links â€” @_selected.FileName</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseShareLinks"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="um-modal-body">
                @if (!_shareLinks.Any())
                {
                    <div class="dh-empty-inline"><i class="bi bi-link" aria-hidden="true"></i><strong>No share links</strong><span>Create a share link from document actions.</span></div>
                }
                else
                {
                    <div class="dh-mini-table-wrap">
                        <table class="dh-mini-table" aria-label="Document share links">
                            <thead><tr><th>Token</th><th>Expires</th><th>Access</th><th>PIN</th><th>State</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var link in _shareLinks)
                                {
                                    <tr>
                                        <td><code>@link.Token</code></td>
                                        <td>@link.ExpiresDateUtc.ToLocalTime().ToString("MM/dd/yyyy")</td>
                                        <td>@link.AccessCount / @(link.MaxAccessCount?.ToString() ?? "âˆž")</td>
                                        <td>@(link.RequiresPin ? "Required" : "No")</td>
                                        <td>@(link.IsRevoked ? "Revoked" : "Active")</td>
                                        <td>
                                            @if (!link.IsRevoked)
                                            {
                                                <button type="button" class="um-btn um-btn-danger um-btn-xs" @onclick="() => OpenRevokeConfirm(link)">Revoke</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseShareLinks">Close</button></div>
        </div>
    </div>
}

<div class="dh-enterprise-page" @onclick="CloseActionMenu">
    <section class="dh-hero">
        <div class="dh-hero-left">
            <span class="dh-hero-icon"><i class="bi bi-folder2-open" aria-hidden="true"></i></span>
            <div>
                <div class="dh-title-row">
                    <h1>Documents Hub</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> @_rows.Count repository items</span>
                    <span><i class="bi bi-diagram-3" aria-hidden="true"></i> @_workflowTemplates.Count workflows</span>
                </div>
                <p>Govern documents, versions, metadata, retention, secure sharing, classification, and workflow audit from one enterprise command center.</p>
            </div>
        </div>
        <div class="dh-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @_loadingIconClass" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/documents/forms")'><i class="bi bi-file-earmark-medical" aria-hidden="true"></i> Forms</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenUpload"><i class="bi bi-upload" aria-hidden="true"></i> Upload Document</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="dh-error-banner" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>@_loadError</div>
    }

    <section class="dh-kpi-strip" aria-label="Document KPIs">
        @KpiCard("bi-folder2-open", "Total", _rows.Count.ToString(), "Repository inventory", "dh-kpi-total", null)
        @KpiCard("bi-check-circle-fill", "Active", _rows.Count(r => r.StatusCode == "Active").ToString(), "Ready for servicing", "dh-kpi-active", "Active")
        @KpiCard("bi-archive-fill", "Archived", _rows.Count(r => r.StatusCode == "Archived").ToString(), "Retained for audit", "dh-kpi-archived", "Archived")
        @KpiCard("bi-stars", "Classified", _rows.Count(r => !string.IsNullOrWhiteSpace(r.CategoryCode)).ToString(), "AI indexed metadata", "dh-kpi-classified", "__classified")
        @KpiCard("bi-exclamation-triangle-fill", "Unclassified", _rows.Count(r => string.IsNullOrWhiteSpace(r.CategoryCode)).ToString(), "Needs review", "dh-kpi-unclassified", "__unclassified")
        @KpiCard("bi-calendar-check", "This Week", _rows.Count(r => r.CreatedDateUtc >= DateTime.UtcNow.AddDays(-7)).ToString(), "Recent uploads", "dh-kpi-week", "__week")
    </section>

    <section class="dh-workflow-strip" aria-label="Document workflow summary">
        @foreach (var lane in _workflowLanes)
        {
            var count = _rows.Count(r => WorkflowStage(r) == lane.Key);
            <button type="button" class="@WorkflowCardClass(lane.FilterKey)" @onclick="() => SetActiveTab(lane.FilterKey)">
                <i class="bi @lane.Icon" aria-hidden="true"></i>
                <span><strong>@count @lane.Label</strong><small>@lane.Description</small></span>
            </button>
        }
    </section>

    <section class="dh-module-grid" aria-label="Documents modules">
        @foreach (var module in _docModules)
        {
            <button type="button" class="dh-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
                <span class="dh-module-icon @ToneCss(module.Type)"><i class="bi @module.Icon" aria-hidden="true"></i></span>
                <span class="dh-module-content"><strong>@module.Title</strong><small>@module.Description</small></span>
                <i class="bi bi-chevron-right dh-module-arrow" aria-hidden="true"></i>
            </button>
        }
    </section>

    <section class="dh-search-panel" role="search" aria-label="Search documents">
        <div class="dh-search-wrap">
            <span class="dh-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="dh-search-body">
                <label for="dh-search-input">Enterprise search</label>
                <input id="dh-search-input" class="dh-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search file, category, type, tags, entity, status, owner, dates..." />
                <span class="dh-search-hint">Searches document metadata, workflow state, classification, tags, linked entity, and upload dates as you type.</span>
            </div>
        </div>
        <div class="dh-search-result"><strong>@FilteredRows.Count()</strong><span>matches</span></div>
        @if (HasFilters)
        {
            <button type="button" class="um-btn um-btn-ghost dh-search-clear" @onclick="ClearFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
        }
    </section>

    <nav class="dh-view-tabs" role="tablist" aria-label="Document dashboard views">
        @foreach (var view in _dashboardViews)
        {
            <button type="button" class="dh-view-btn @(_activeView == view ? "dh-view-btn-active" : null)" role="tab" aria-selected="@(_activeView == view)" @onclick="() => SetActiveView(view)">@view</button>
        }
    </nav>

    <section class="dh-content-layout">
        <div class="dh-main-card">
            @if (_loading)
            {
                <div class="dh-loading"><i class="bi bi-arrow-repeat dh-spin" aria-hidden="true"></i><span>Loading documents...</span></div>
            }
            else if (!FilteredRows.Any())
            {
                <div class="dh-empty-state"><i class="bi bi-folder-x" aria-hidden="true"></i><strong>No documents found</strong><span>Upload a document or adjust the current view, KPI, or search criteria.</span></div>
            }
            else if (_activeView == "Workflow")
            {
                <div class="dh-board">
                    @foreach (var lane in _workflowLanes)
                    {
                        var laneRows = FilteredRows.Where(r => WorkflowStage(r) == lane.Key).OrderByDescending(r => DocumentRisk(r) == "High").ThenByDescending(r => r.CreatedDateUtc).ToList();
                        <section class="dh-board-col">
                            <header><div><strong>@lane.Label</strong><small>@lane.Description</small></div><span>@laneRows.Count</span></header>
                            @if (!laneRows.Any())
                            {
                                <div class="dh-empty-mini">No documents</div>
                            }
                            else
                            {
                                @foreach (var row in laneRows.Take(12))
                                {
                                    <button type="button" class="dh-board-card @(DocumentRisk(row) == "High" ? "dh-board-card-risk" : null)" @onclick="() => OpenDetailAsync(row)">
                                        <div><strong>@row.FileName</strong><span>@(row.CategoryCode ?? "Unclassified")</span></div>
                                        <span>@(row.Description ?? row.DocumentTypeCode)</span>
                                        <small>@LifecycleLabel(row)</small>
                                    </button>
                                }
                            }
                        </section>
                    }
                </div>
            }
            else if (_activeView == "Analytics")
            {
                <div class="dh-analytics-grid">
                    <section>
                        <h3>Workflow distribution</h3>
                        @foreach (var lane in _workflowLanes)
                        {
                            var count = _rows.Count(r => WorkflowStage(r) == lane.Key);
                            <button type="button" class="dh-stage-row" @onclick="() => SetActiveTab(lane.FilterKey)"><span>@lane.Label</span><div><i style="width:@Percent(count, Math.Max(_rows.Count, 1))%"></i></div><strong>@count</strong></button>
                        }
                    </section>
                    <section>
                        <h3>Category coverage</h3>
                        @foreach (var group in CategoryAnalytics)
                        {
                            <button type="button" class="dh-stage-row" @onclick="() => FocusCategory(group.Key)"><span>@group.Key</span><div><i style="width:@Percent(group.Count, Math.Max(_rows.Count, 1))%"></i></div><strong>@group.Count</strong></button>
                        }
                    </section>
                    <section>
                        <h3>Governance health</h3>
                        <div class="dh-metric-stack">
                            <div><span>Classified</span><strong>@_rows.Count(r => !string.IsNullOrWhiteSpace(r.CategoryCode))</strong><small>@Percent(_rows.Count(r => !string.IsNullOrWhiteSpace(r.CategoryCode)), Math.Max(_rows.Count, 1))% metadata coverage</small></div>
                            <div><span>Retention ready</span><strong>@_rows.Count(r => r.RetentionDate.HasValue)</strong><small>Documents with retention date</small></div>
                            <div><span>Open workflow</span><strong>@(_workflowInstances.Count + _approvals.Count + _reviews.Count + _classifications.Count)</strong><small>Active workflow records</small></div>
                        </div>
                    </section>
                    <section>
                        <h3>Priority exceptions</h3>
                        <div class="dh-priority-list">
                            @foreach (var row in _rows.Where(r => DocumentRisk(r) == "High").Take(6))
                            {
                                <button type="button" @onclick="() => OpenDetailAsync(row)"><strong>@row.FileName</strong><span>@PriorityReason(row)</span></button>
                            }
                        </div>
                    </section>
                </div>
            }
            else
            {
                <div class="dh-grid-toolbar">
                    <div><strong>@FilteredRows.Count()</strong> documents @if (HasFilters) { <span class="dh-filter-note">Filtered</span> }</div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
                </div>
                <div class="dh-table-scroll">
                    <table class="dh-table" aria-label="Documents register">
                        <thead>
                            <tr>
                                <th>Document</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Workflow</th>
                                <th>Version</th>
                                <th>Retention</th>
                                <th>Uploaded</th>
                                <th class="dh-actions-col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in PagedRows)
                            {
                                <tr class="dh-table-row @(_selected?.DocumentId == row.DocumentId ? "dh-row-selected" : null)" @onclick="() => OpenDetailAsync(row)">
                                    <td>
                                        <div class="dh-doc-cell">
                                            <span class="dh-avatar"><i class="bi @DocIcon(row.ContentType, row.FileName)" aria-hidden="true"></i></span>
                                            <div><strong>@row.FileName</strong><span>@(row.Description ?? row.Tags ?? "Document repository item")</span></div>
                                        </div>
                                    </td>
                                    <td>@CategoryChip(row)</td>
                                    <td>@TypeChip(row.DocumentTypeCode)</td>
                                    <td>@StatusChip(row.StatusCode)</td>
                                    <td>@WorkflowCell(row)</td>
                                    <td><span class="dh-version">v@row.VersionNumber</span></td>
                                    <td>@(row.RetentionDate?.ToString("MM/dd/yyyy") ?? "—")</td>
                                    <td>@row.CreatedDateUtc.ToLocalTime().ToString("MM/dd/yyyy")</td>
                                    <td class="dh-actions-col">@CtxBtn(row)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="dh-pager">
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</button>
                    <span class="dh-page-chip">@PageSummary</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            }
        </div>

        <aside class="dh-detail-card" aria-label="Selected document details">
            @if (_drawerRow is null)
            {
                <div class="dh-detail-empty"><i class="bi bi-folder2-open" aria-hidden="true"></i><strong>Select a document</strong><span>Open details, versions, metadata, secure sharing, retention, and workflow actions.</span></div>
            }
            else
            {
                <div class="dh-detail-head">
                    <div>
                        <span class="dh-detail-eyebrow"><i class="bi @DocIcon(_drawerRow.ContentType, _drawerRow.FileName)" aria-hidden="true"></i> @WorkflowStage(_drawerRow)</span>
                        <h2>@_drawerRow.FileName</h2>
                        <p>@_drawerRow.CategoryCode · @_drawerRow.DocumentTypeCode · v@_drawerRow.VersionNumber</p>
                    </div>
                    @StatusChip(_drawerRow.StatusCode)
                </div>
                <div class="dh-detail-body">
                    <div class="dh-detail-summary">
                        <div><span>Entity</span><strong>@(string.IsNullOrWhiteSpace(_drawerRow.EntityName) ? "Not linked" : _drawerRow.EntityName)</strong></div>
                        <div><span>Retention</span><strong>@(_drawerRow.RetentionDate?.ToString("MM/dd/yyyy") ?? "Not set")</strong></div>
                        <div><span>Size</span><strong>@FormatSize(_drawerRow.FileSizeBytes)</strong></div>
                        <div><span>Access</span><strong>@_accessLog.Count events</strong></div>
                    </div>
                    <p class="dh-detail-description">@(string.IsNullOrWhiteSpace(_drawerRow.Description) ? "No description has been provided." : _drawerRow.Description)</p>
                    <div class="dh-tag-list">
                        <span>@AiClassify(_drawerRow)</span>
                        <span>@(DocumentRisk(_drawerRow) == "High" ? "High risk" : "Standard risk")</span>
                        @foreach (var tag in DocumentTags(_drawerRow).Take(4))
                        {
                            <span>@tag</span>
                        }
                    </div>
                    @if (_relatedLoading)
                    {
                        <div class="dh-related-loading"><i class="bi bi-arrow-repeat dh-spin" aria-hidden="true"></i> Loading related activity...</div>
                    }
                    else if (_versions.Any())
                    {
                        <div class="dh-mini-list">
                            @foreach (var version in _versions.Take(3))
                            {
                                <div class="dh-mini-item"><strong>v@version.VersionNumber · @version.FileName</strong><span>@version.CreatedDateUtc.ToLocalTime().ToString("MM/dd/yyyy h:mm tt") · @(version.ChangeNotes ?? "No notes")</span></div>
                            }
                        </div>
                    }
                    <div class="dh-detail-actions">
                        <button type="button" class="um-btn um-btn-primary" @onclick="() => Download(_drawerRow)"><i class="bi bi-download" aria-hidden="true"></i> Download</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenMetadata(_drawerRow)"><i class="bi bi-tags" aria-hidden="true"></i> Metadata</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenVersion(_drawerRow)"><i class="bi bi-layers" aria-hidden="true"></i> New Version</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenShare(_drawerRow)"><i class="bi bi-share" aria-hidden="true"></i> Share</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenRename(_drawerRow)"><i class="bi bi-pencil" aria-hidden="true"></i> Rename</button>
                        <button type="button" class="um-btn um-btn-warning" @onclick='() => OpenConfirm(_drawerRow, "Archive")' disabled="@(_drawerRow.StatusCode == "Archived")"><i class="bi bi-archive" aria-hidden="true"></i> Archive</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@if (_openActionMenuFor is not null)
{
    <div class="dh-context-menu" style="left:@_menuXpx; top:@_menuYpx" @onclick:stopPropagation="true">
        <button type="button" @onclick='() => ExecuteMenuActionAsync("View")'><i class="bi bi-eye" aria-hidden="true"></i><span>View details</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Download")'><i class="bi bi-download" aria-hidden="true"></i><span>Download</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Metadata")'><i class="bi bi-tags" aria-hidden="true"></i><span>Edit metadata</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Version")'><i class="bi bi-layers" aria-hidden="true"></i><span>Upload new version</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Share")'><i class="bi bi-share" aria-hidden="true"></i><span>Create share link</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("ShareLinks")'><i class="bi bi-link-45deg" aria-hidden="true"></i><span>Share links</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Rename")'><i class="bi bi-pencil" aria-hidden="true"></i><span>Rename</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Archive")' disabled="@IsMenuArchived"><i class="bi bi-archive" aria-hidden="true"></i><span>Archive</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Delete")'><i class="bi bi-trash3" aria-hidden="true"></i><span>Delete</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("ESign")'><i class="bi bi-pen" aria-hidden="true"></i><span>Send for E-Sign</span></button>
    </div>
}

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading;
    private bool _busy;
    private bool _relatedLoading;
    private bool _toastVisible;
    private bool _showUpload;
    private bool _showMetadata;
    private bool _showNewVersion;
    private bool _showShareDialog;
    private bool _showRename;
    private bool _shareLinksVisible;
    private bool _uploadAttempted;
    private bool _versionAttempted;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string? _searchText;
    private string? _kpiFilter;
    private string? _confirmAction;
    private string _activeView = "Library";
    private string _activeTab = "all";
    private Guid? _openActionMenuFor;
    private string _menuXpx = "0px";
    private string _menuYpx = "0px";
    private int _page = 1;
    private const int PageSize = 20;

    private readonly List<DocumentDto> _rows = [];
    private readonly List<DocumentVersionDto> _versions = [];
    private readonly List<DocumentShareLinkDto> _shareLinks = [];
    private readonly List<DocumentAccessLogDto> _accessLog = [];
    private readonly List<DocumentWorkflowTemplateDto> _workflowTemplates = [];
    private readonly List<DocumentWorkflowInstanceDto> _workflowInstances = [];
    private readonly List<DocumentApprovalDto> _approvals = [];
    private readonly List<DocumentReviewDto> _reviews = [];
    private readonly List<DocumentClassificationQueueDto> _classifications = [];

    private DocumentDto? _selected;
    private DocumentDto? _drawerRow;
    private DocumentDto? _confirmTarget;
    private DocumentShareLinkDto? _revokeTarget;
    private IBrowserFile? _uploadFile;
    private IBrowserFile? _versionFile;
    private UploadFormModel _uploadForm = new();
    private MetadataFormModel _metadataForm = new();
    private VersionFormModel _versionForm = new();
    private ShareFormModel _shareForm = new();
    private RenameFormModel _renameForm = new();

    private readonly string[] _dashboardViews = ["Library", "Workflow", "Analytics"];

    private readonly TabDef[] _tabs =
    [
        new("all", "All", "bi-stack"),
        new("active", "Active", "bi-check-circle"),
        new("archived", "Archived", "bi-archive"),
        new("classified", "Classified", "bi-stars"),
        new("unclassified", "Unclassified", "bi-exclamation-triangle"),
        new("week", "This Week", "bi-calendar-check"),
        new("workflow", "Workflow", "bi-diagram-3")
    ];

    private readonly WorkflowLane[] _workflowLanes =
    [
        new("Intake", "Intake", "Uploads and client submissions", "bi-inbox", "workflow"),
        new("Classify", "Classify", "AI/OCR metadata assignment", "bi-tags", "unclassified"),
        new("Prepare", "Prepare", "Forms, packets, and versions", "bi-collection", "classified"),
        new("Sign", "Sign", "E-signature and acknowledgements", "bi-pen", "workflow"),
        new("Audit", "Audit", "Retention and access controls", "bi-shield-check", "archived")
    ];

    private readonly DocumentModule[] _docModules =
    [
        new("ACORD Forms Center", "Browse, pre-fill, complete, and route standard ACORD forms.", "/documents/forms", "bi-file-earmark-medical", "ACORD"),
        new("E-Signature Queue", "Send signature requests, monitor completion, void requests, and escalate.", "/documents/esign", "bi-pen", "E-Sign"),
        new("OCR Exceptions", "Resolve failed OCR, apply AI suggestions, and correct indexing.", "/documents/exceptions", "bi-exclamation-triangle", "OCR"),
        new("Packet Builder", "Assemble renewal, claims, onboarding, and service document packets.", "/documents/packets", "bi-collection", "Packet"),
        new("Document Workflow", "Configure templates, queues, retention policies, and workflow audit trails.", "/tenant/documents/workflow", "bi-diagram-3", "Workflow"),
        new("Storage Settings", "Manage tenant storage providers, retention defaults, and indexing controls.", "/tenant/documents/storage", "bi-hdd", "Storage")
    ];

    private static readonly CategoryOption[] Categories =
    [
        new("", "All Categories"),
        new("Policy", "Policy"),
        new("Certificate", "Certificate"),
        new("Endorsement", "Endorsement"),
        new("Binder", "Binder"),
        new("Claim", "Claim"),
        new("Compliance", "Compliance"),
        new("Proposal", "Proposal"),
        new("Contract", "Contract"),
        new("Other", "Other")
    ];

    private static IEnumerable<CategoryOption> UploadCategories => Categories.Where(c => !string.IsNullOrEmpty(c.Code));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Documents", "/documents"));
        await LoadAsync();
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchDocumentsAsync(_tenantId);
            _rows.Clear();
            _rows.AddRange((result?.Items ?? []).OrderByDescending(x => x.CreatedDateUtc));
            await LoadWorkflowAsync();
            _page = 1;
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load documents: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadWorkflowAsync()
    {
        try
        {
            var templatesTask = Api.SearchDocumentWorkflowTemplatesAsync(_tenantId, pageSize: 100);
            var instancesTask = Api.SearchDocumentWorkflowInstancesAsync(_tenantId, pageSize: 100);
            var approvalsTask = Api.SearchDocumentApprovalsAsync(_tenantId, approvalStatus: "Pending", pageSize: 100);
            var reviewsTask = Api.SearchDocumentReviewsAsync(_tenantId, reviewStatus: "Pending", pageSize: 100);
            var classificationTask = Api.SearchDocumentClassificationQueueAsync(_tenantId, pageSize: 100);
            await Task.WhenAll(templatesTask, instancesTask, approvalsTask, reviewsTask, classificationTask);
            _workflowTemplates.Clear();
            _workflowInstances.Clear();
            _approvals.Clear();
            _reviews.Clear();
            _classifications.Clear();
            _workflowTemplates.AddRange((await templatesTask)?.Items ?? []);
            _workflowInstances.AddRange((await instancesTask)?.Items ?? []);
            _approvals.AddRange((await approvalsTask)?.Items ?? []);
            _reviews.AddRange((await reviewsTask)?.Items ?? []);
            _classifications.AddRange((await classificationTask)?.Items ?? []);
        }
        catch
        {
            // Workflow summary is secondary to the document register; schema migration creates the backing tables on API startup.
        }
    }

    private string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            _page = 1;
        }
    }

    private IEnumerable<DocumentDto> FilteredRows => _rows.Where(MatchesActiveTab).Where(MatchesKpiFilter).Where(MatchesSearch).ToList();
    private IEnumerable<DocumentDto> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    private IEnumerable<CategoryMetric> CategoryAnalytics => _rows
        .GroupBy(r => string.IsNullOrWhiteSpace(r.CategoryCode) ? "Unclassified" : r.CategoryCode)
        .Select(g => new CategoryMetric(g.Key, g.Count()))
        .OrderByDescending(g => g.Count)
        .ThenBy(g => g.Key)
        .Take(8);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)PageSize));
    private bool HasFilters => !string.IsNullOrWhiteSpace(_searchText) || _activeTab != "all" || _kpiFilter is not null;
    private bool IsMenuArchived => _selected?.StatusCode == "Archived";
    private string ToastIconClass => _toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill";
    private string _loadingIconClass => _loading ? "dh-spin" : string.Empty;
    private string PageSummary => $"Page {_page} of {TotalPages} Â· {FilteredRows.Count()} records";
    private string ConfirmIconClass => _confirmAction == "Delete" || _confirmAction == "Revoke" ? "um-confirm-icon--danger" : "um-confirm-icon--warning";
    private string ConfirmButtonClass => _confirmAction == "Delete" || _confirmAction == "Revoke" ? "um-btn-danger" : "um-btn-warning";
    private string ConfirmIcon => _confirmAction == "Delete" ? "bi-trash3-fill" : _confirmAction == "Revoke" ? "bi-link-45deg" : "bi-archive-fill";
    private string ConfirmMessage => _confirmAction switch
    {
        "Delete" when _confirmTarget is not null => $"Delete '{_confirmTarget.FileName}'? The record will be removed from active document views and the backing file will be deleted.",
        "Archive" when _confirmTarget is not null => $"Archive '{_confirmTarget.FileName}'? The document will remain retained for audit and search.",
        "Revoke" when _revokeTarget is not null => $"Revoke share link '{_revokeTarget.Token}'? External access through this link will stop immediately.",
        _ => "Confirm this document action."
    };

    private bool MatchesActiveTab(DocumentDto row) => _activeTab switch
    {
        "active" => row.StatusCode == "Active",
        "archived" => row.StatusCode == "Archived",
        "classified" => !string.IsNullOrWhiteSpace(row.CategoryCode),
        "unclassified" => string.IsNullOrWhiteSpace(row.CategoryCode),
        "week" => row.CreatedDateUtc >= DateTime.UtcNow.AddDays(-7),
        "workflow" => WorkflowStage(row) is "Classify" or "Sign" or "Audit",
        _ => true
    };

    private bool MatchesKpiFilter(DocumentDto row) => _kpiFilter switch
    {
        null => true,
        "__classified" => !string.IsNullOrWhiteSpace(row.CategoryCode),
        "__unclassified" => string.IsNullOrWhiteSpace(row.CategoryCode),
        "__week" => row.CreatedDateUtc >= DateTime.UtcNow.AddDays(-7),
        _ => row.StatusCode == _kpiFilter
    };

    private bool MatchesSearch(DocumentDto row)
    {
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        var s = _searchText.Trim();
        return Contains(row.FileName, s)
            || Contains(row.CategoryCode, s)
            || Contains(row.DocumentTypeCode, s)
            || Contains(row.StatusCode, s)
            || Contains(row.Description, s)
            || Contains(row.Tags, s)
            || Contains(row.EntityName, s)
            || Contains(row.UploadedByName, s)
            || Contains(AiClassify(row), s)
            || Contains(WorkflowStage(row), s)
            || Contains(row.CreatedDateUtc.ToLocalTime().ToString("MM/dd/yyyy"), s)
            || Contains(row.RetentionDate?.ToString("MM/dd/yyyy"), s);
    }

    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;
    private string ViewTabClass(string key) => _activeTab == key ? "dh-view-tab dh-view-tab--active" : "dh-view-tab";
    private string WorkflowCardClass(string filterKey) => _activeTab == filterKey ? "dh-workflow-card dh-workflow-card--active" : "dh-workflow-card";
    private void SetActiveTab(string key) { _activeTab = key; _page = 1; }
    private void SetActiveView(string view) { _activeView = view; _page = 1; }
    private void SetKpiFilter(string? key) { _kpiFilter = Equals(_kpiFilter, key) ? null : key; _page = 1; }
    private void ClearFilters() { _searchText = null; _kpiFilter = null; _activeTab = "all"; _page = 1; }
    private void PreviousPage() => _page = Math.Max(1, _page - 1);
    private void NextPage() => _page = Math.Min(TotalPages, _page + 1);

    private int TabCount(string key) => key switch
    {
        "active" => _rows.Count(r => r.StatusCode == "Active"),
        "archived" => _rows.Count(r => r.StatusCode == "Archived"),
        "classified" => _rows.Count(r => !string.IsNullOrWhiteSpace(r.CategoryCode)),
        "unclassified" => _rows.Count(r => string.IsNullOrWhiteSpace(r.CategoryCode)),
        "week" => _rows.Count(r => r.CreatedDateUtc >= DateTime.UtcNow.AddDays(-7)),
        "workflow" => _workflowInstances.Count + _approvals.Count + _reviews.Count + _classifications.Count,
        _ => _rows.Count
    };

    private void OpenUpload()
    {
        _uploadAttempted = false;
        _uploadFile = null;
        _uploadForm = new UploadFormModel { CategoryCode = "Other", DocumentTypeCode = "General", RetentionDate = DateOnly.FromDateTime(DateTime.Today.AddYears(7)) };
        _showUpload = true;
    }

    private void CloseUpload() => _showUpload = false;

    private async Task SubmitUploadAsync()
    {
        _uploadAttempted = true;
        if (_uploadFile is null)
        {
            ShowToast("A document file is required.", "danger");
            return;
        }

        _busy = true;
        try
        {
            await using var stream = _uploadFile.OpenReadStream(104_857_600);
            var id = await Api.UploadDocumentAsync(new ApiClient.UploadDocumentRequest
            {
                TenantId = _tenantId,
                DocumentTypeCode = _uploadForm.DocumentTypeCode,
                CategoryCode = _uploadForm.CategoryCode,
                FileName = _uploadForm.FileName,
                OriginalFileName = _uploadFile.Name,
                EntityName = _uploadForm.EntityName,
                Description = _uploadForm.Description,
                Tags = _uploadForm.Tags,
                RetentionDate = _uploadForm.RetentionDate,
                UploadedByName = _uploadForm.UploadedByName,
                CreatedByUserId = _tenantAdminUserId,
                Content = stream
            });
            _showUpload = false;
            ShowToast("Document uploaded successfully.");
            await LoadAsync();
            var uploaded = _rows.FirstOrDefault(r => r.DocumentId == id);
            if (uploaded is not null) await OpenDetailAsync(uploaded);
        }
        catch (Exception ex)
        {
            ShowToast($"Upload failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnUploadFileChanged(InputFileChangeEventArgs args)
    {
        _uploadFile = args.File;
        if (string.IsNullOrWhiteSpace(_uploadForm.FileName)) _uploadForm.FileName = _uploadFile.Name;
        if (string.IsNullOrWhiteSpace(_uploadForm.DocumentTypeCode)) _uploadForm.DocumentTypeCode = GuessDocumentType(_uploadFile.Name);
    }

    private async Task OpenDetailAsync(DocumentDto row)
    {
        _selected = row;
        _drawerRow = row;
        await LoadRelatedAsync(row.DocumentId);
    }

    private async Task LoadRelatedAsync(Guid documentId)
    {
        _relatedLoading = true;
        try
        {
            _versions.Clear();
            _shareLinks.Clear();
            _accessLog.Clear();
            var versionsTask = Api.GetDocumentVersionsAsync(documentId);
            var linksTask = Api.GetDocumentShareLinksAsync(documentId);
            var logTask = Api.GetDocumentAccessLogAsync(documentId);
            await Task.WhenAll(versionsTask, linksTask, logTask);
            _versions.AddRange(await versionsTask ?? []);
            _shareLinks.AddRange(await linksTask ?? []);
            _accessLog.AddRange(await logTask ?? []);
        }
        catch (Exception ex)
        {
            ShowToast($"Related document data failed to load: {ex.Message}", "danger");
        }
        finally
        {
            _relatedLoading = false;
        }
    }

    private void CloseDrawer() => _drawerRow = null;
    private void Download(DocumentDto row) => Nav.NavigateTo(Api.GetDocumentDownloadUrl(row.DocumentId), forceLoad: true);

    private void OpenMetadata(DocumentDto row)
    {
        _selected = row;
        _metadataForm = new MetadataFormModel { Description = row.Description, Tags = row.Tags, RetentionDate = row.RetentionDate };
        _showMetadata = true;
    }

    private void CloseMetadata() => _showMetadata = false;

    private async Task SubmitMetadataAsync()
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            await Api.UpdateDocumentMetadataAsync(new UpdateDocumentMetadataRequest { DocumentId = _selected.DocumentId, Description = _metadataForm.Description, Tags = _metadataForm.Tags, RetentionDate = _metadataForm.RetentionDate, ModifiedByUserId = _tenantAdminUserId });
            _showMetadata = false;
            ShowToast("Document metadata updated.");
            await RefreshSelectedAsync(_selected.DocumentId);
        }
        catch (Exception ex)
        {
            ShowToast($"Metadata save failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenVersion(DocumentDto row)
    {
        _selected = row;
        _versionAttempted = false;
        _versionFile = null;
        _versionForm = new VersionFormModel { FileName = row.FileName };
        _showNewVersion = true;
    }

    private void CloseVersion() => _showNewVersion = false;

    private async Task SubmitVersionAsync()
    {
        _versionAttempted = true;
        if (_selected is null || _versionFile is null)
        {
            ShowToast("A version file is required.", "danger");
            return;
        }

        _busy = true;
        try
        {
            await using var stream = _versionFile.OpenReadStream(104_857_600);
            await Api.UploadDocumentVersionAsync(_selected.DocumentId, new ApiClient.UploadDocumentVersionRequest { FileName = _versionForm.FileName, OriginalFileName = _versionFile.Name, ChangeNotes = _versionForm.ChangeNotes, CreatedByUserId = _tenantAdminUserId, Content = stream });
            _showNewVersion = false;
            ShowToast("New document version uploaded.");
            await RefreshSelectedAsync(_selected.DocumentId);
        }
        catch (Exception ex)
        {
            ShowToast($"Version upload failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnVersionFileChanged(InputFileChangeEventArgs args)
    {
        _versionFile = args.File;
        if (string.IsNullOrWhiteSpace(_versionForm.FileName)) _versionForm.FileName = _versionFile.Name;
    }

    private void OpenShare(DocumentDto row)
    {
        _selected = row;
        _shareForm = new ShareFormModel { ExpiresDateUtc = DateTime.UtcNow.Date.AddDays(7), MaxAccessCount = null };
        _showShareDialog = true;
    }

    private void CloseShare() => _showShareDialog = false;

    private async Task SubmitShareLinkAsync()
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            await Api.CreateDocumentShareLinkAsync(new CreateDocumentShareLinkRequest { TenantId = _tenantId, DocumentId = _selected.DocumentId, CreatedByUserId = _tenantAdminUserId, ExpiresDateUtc = _shareForm.ExpiresDateUtc, MaxAccessCount = _shareForm.MaxAccessCount, RequiresPin = _shareForm.RequiresPin, Pin = _shareForm.Pin });
            _showShareDialog = false;
            ShowToast("Secure share link created.");
            await LoadRelatedAsync(_selected.DocumentId);
            _shareLinksVisible = true;
        }
        catch (Exception ex)
        {
            ShowToast($"Share link creation failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void CloseShareLinks() => _shareLinksVisible = false;

    private void OpenRename(DocumentDto row)
    {
        _selected = row;
        _renameForm = new RenameFormModel { NewFileName = row.FileName };
        _showRename = true;
    }

    private void CloseRename() => _showRename = false;

    private async Task SubmitRenameAsync()
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            await Api.RenameDocumentAsync(new RenameDocumentRequest { DocumentId = _selected.DocumentId, NewFileName = _renameForm.NewFileName, ModifiedByUserId = _tenantAdminUserId });
            _showRename = false;
            ShowToast("Document renamed.");
            await RefreshSelectedAsync(_selected.DocumentId);
        }
        catch (Exception ex)
        {
            ShowToast($"Rename failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenConfirm(DocumentDto row, string action)
    {
        _confirmTarget = row;
        _revokeTarget = null;
        _confirmAction = action;
    }

    private void OpenRevokeConfirm(DocumentShareLinkDto link)
    {
        _revokeTarget = link;
        _confirmTarget = null;
        _confirmAction = "Revoke";
    }

    private void CloseConfirm()
    {
        _confirmTarget = null;
        _revokeTarget = null;
        _confirmAction = null;
    }

    private async Task ExecuteConfirmAsync()
    {
        _busy = true;
        try
        {
            if (_confirmAction == "Archive" && _confirmTarget is not null)
            {
                await Api.ArchiveDocumentAsync(_confirmTarget.DocumentId, _tenantAdminUserId);
                ShowToast("Document archived.", "warning");
                var id = _confirmTarget.DocumentId;
                CloseConfirm();
                await RefreshSelectedAsync(id);
            }
            else if (_confirmAction == "Delete" && _confirmTarget is not null)
            {
                await Api.DeleteDocumentAsync(_confirmTarget.DocumentId, _tenantAdminUserId);
                ShowToast("Document deleted.", "warning");
                CloseDrawer();
                CloseConfirm();
                await LoadAsync();
            }
            else if (_confirmAction == "Revoke" && _revokeTarget is not null)
            {
                await Api.RevokeDocumentShareLinkAsync(_revokeTarget.ShareLinkId);
                ShowToast("Share link revoked.", "warning");
                CloseConfirm();
                if (_selected is not null) await LoadRelatedAsync(_selected.DocumentId);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Document action failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshSelectedAsync(Guid documentId)
    {
        await LoadAsync();
        var updated = await Api.GetDocumentByIdAsync(documentId);
        if (updated is not null)
        {
            _selected = updated;
            _drawerRow = updated;
            await LoadRelatedAsync(documentId);
        }
    }

    private void OpenActionMenu(DocumentDto row, MouseEventArgs args)
    {
        _selected = row;
        _openActionMenuFor = row.DocumentId;
        _menuXpx = $"{Math.Min(args.ClientX, 1420)}px";
        _menuYpx = $"{Math.Min(args.ClientY, 820)}px";
    }

    private void CloseActionMenu() => _openActionMenuFor = null;

    private async Task ExecuteMenuActionAsync(string action)
    {
        var row = _selected;
        CloseActionMenu();
        if (row is null) return;

        switch (action)
        {
            case "View": await OpenDetailAsync(row); break;
            case "Download": Download(row); break;
            case "Metadata": OpenMetadata(row); break;
            case "Version": OpenVersion(row); break;
            case "Share": OpenShare(row); break;
            case "ShareLinks": await OpenDetailAsync(row); _shareLinksVisible = true; break;
            case "Rename": OpenRename(row); break;
            case "Archive": OpenConfirm(row, "Archive"); break;
            case "Delete": OpenConfirm(row, "Delete"); break;
            case "ESign": Nav.NavigateTo("/documents/esign"); break;
        }
    }

    private Task ExportAsync()
    {
        var csv = new StringBuilder();
        csv.AppendLine("File Name,Category,Type,Status,Workflow,Version,Retention,Uploaded By,Uploaded Date,Tags");
        foreach (var row in FilteredRows)
        {
            csv.AppendLine(string.Join(',', Csv(row.FileName), Csv(row.CategoryCode), Csv(row.DocumentTypeCode), Csv(row.StatusCode), Csv(WorkflowStage(row)), row.VersionNumber.ToString(), Csv(row.RetentionDate?.ToString("MM/dd/yyyy")), Csv(row.UploadedByName), Csv(row.CreatedDateUtc.ToLocalTime().ToString("MM/dd/yyyy")), Csv(row.Tags)));
        }

        var url = "data:text/csv;charset=utf-8," + Uri.EscapeDataString(csv.ToString());
        Nav.NavigateTo(url, forceLoad: true);
        ShowToast("Document export generated.");
        return Task.CompletedTask;
    }

    private RenderFragment KpiCard(string icon, string label, string value, string caption, string cssClass, string? filterKey) =>
        @<button type="button" class="dh-kpi-card @cssClass @(Equals(_kpiFilter, filterKey) ? "dh-kpi-card--active" : string.Empty)" title="Filter by @label" @onclick="() => SetKpiFilter(filterKey)">
            <span class="dh-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span>
            <span class="dh-kpi-copy"><span class="dh-kpi-label">@label</span><strong class="dh-kpi-value">@value</strong><span class="dh-kpi-caption">@caption</span></span>
        </button>;

    private RenderFragment CtxBtn(DocumentDto row) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", "um-btn um-btn-ghost um-btn-sm dh-ctx-btn");
        builder.AddAttribute(seq++, "title", "Actions");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, args => OpenActionMenu(row, args)));
        builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
        builder.OpenElement(seq++, "i");
        builder.AddAttribute(seq++, "class", "bi bi-three-dots-vertical");
