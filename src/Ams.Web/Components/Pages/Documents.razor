@page "/documents"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Features.Documents

<PageTitle>Documents Hub — AMS</PageTitle>
<AppPageHeader Title="Documents Hub"
               Subtitle="Policies, forms, certificates, correspondence and all client documents in one place"
               Icon="bi-folder2-open">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/documents/forms")'>
            <i class="bi bi-file-earmark-medical" aria-hidden="true"></i> ACORD Forms
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/documents/esign")'>
            <i class="bi bi-pen" aria-hidden="true"></i> E-Sign
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/documents/packets")'>
            <i class="bi bi-collection" aria-hidden="true"></i> Packets
        </button>
        <button class="um-btn um-btn-primary" @onclick="() => _showUpload = true">
            <i class="bi bi-upload" aria-hidden="true"></i> Upload Document
        </button>
    </Actions>
</AppPageHeader>

<!-- ── TENANT ADMIN DOCUMENTS WORKFLOW ────────────────────────────── -->
<section class="docs-hero" aria-label="Documents workflow overview">
    <div>
        <span class="docs-eyebrow">Tenant administration</span>
        <h2>Documents Workflow</h2>
        <p>Govern document intake, classification, ACORD forms, e-signature, OCR exception resolution, packet assembly, retention, and audit controls.</p>
    </div>
    <div class="docs-hero-grid">
        @foreach (var action in _docQuickActions)
        {
            <button class="docs-quick-action" @onclick="() => Nav.NavigateTo(action.Url)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
</section>

<section class="docs-kpi-grid" aria-label="Documents workflow metrics">
    @DocWorkflowKpi("Repository", (_items?.Count ?? 0).ToString(), "Indexed tenant documents", "bi-folder2-open", "docs-tone-blue")
    @DocWorkflowKpi("E-Sign", _kpiEsign.ToString(), "Pending signatures", "bi-pen", "docs-tone-amber")
    @DocWorkflowKpi("OCR Review", _kpiExceptions.ToString(), "Exceptions to classify", "bi-exclamation-triangle", "docs-tone-red")
    @DocWorkflowKpi("Audit Ready", _docWorkflow.Count(x => x.Stage == "Audit").ToString(), "Retention and access evidence", "bi-shield-check", "docs-tone-green")
</section>

<section class="docs-command-bar" aria-label="Documents workflow filters">
    <div class="docs-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search"
               placeholder="Search workflow, owner, document type, control..."
               @bind="_workflowSearch"
               @bind:event="oninput" />
    </div>
    <div class="docs-pill-group" role="group" aria-label="Documents workflow filter">
        @foreach (var filter in _docFilters)
        {
            <button class="docs-pill @(_workflowFilter == filter.Key ? "docs-pill--active" : "")"
                    @onclick="() => _workflowFilter = filter.Key">
                @filter.Label
                <span>@DocFilterCount(filter.Key)</span>
            </button>
        }
    </div>
</section>

<section class="docs-layout">
    <div class="docs-flow" aria-label="Documents workflow lanes">
        @foreach (var lane in _docLanes)
        {
            var laneItems = FilteredDocWorkflow.Where(x => x.Stage == lane.Key).ToList();
            <article class="docs-lane">
                <header class="docs-lane-header">
                    <div>
                        <span class="docs-lane-title">@lane.Label</span>
                        <span class="docs-lane-subtitle">@lane.Description</span>
                    </div>
                    <span class="docs-lane-count">@laneItems.Count</span>
                </header>

                <div class="docs-lane-list">
                    @if (laneItems.Count == 0)
                    {
                        <div class="docs-empty-mini">No visible workflow items.</div>
                    }
                    else
                    {
                        @foreach (var item in laneItems)
                        {
                            <button class="docs-work-card @(item.Risk == "High" ? "docs-work-card--risk" : "")"
                                    @onclick="() => _selectedWorkflow = item">
                                <div class="docs-work-topline">
                                    <span class="docs-chip @DocToneCss(item.Type)">@item.Type</span>
                                    <span class="docs-status @DocRiskCss(item.Risk)">@item.Risk</span>
                                </div>
                                <strong>@item.Title</strong>
                                <p>@item.Summary</p>
                                <div class="docs-work-meta">
                                    <span><i class="bi bi-person" aria-hidden="true"></i> @item.Owner</span>
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> @item.Sla</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            </article>
        }
    </div>

    <aside class="docs-admin-panel" aria-label="Tenant document administration controls">
        @if (_selectedWorkflow is null)
        {
            <div class="docs-side-empty">
                <i class="bi bi-folder-check" aria-hidden="true"></i>
                <h3>Document governance</h3>
                <p>Select a workflow item to review ownership, SLA, retention, audit controls, and downstream module actions.</p>
            </div>
        }
        else
        {
            <div class="docs-detail-header">
                <span class="docs-chip @DocToneCss(_selectedWorkflow.Type)">@_selectedWorkflow.Type</span>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selectedWorkflow = null" aria-label="Close details">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h3>@_selectedWorkflow.Title</h3>
            <p>@_selectedWorkflow.Summary</p>

            <dl class="docs-detail-list">
                <div><dt>Owner</dt><dd>@_selectedWorkflow.Owner</dd></div>
                <div><dt>Stage</dt><dd>@_selectedWorkflow.Stage</dd></div>
                <div><dt>Risk</dt><dd><span class="docs-status @DocRiskCss(_selectedWorkflow.Risk)">@_selectedWorkflow.Risk</span></dd></div>
                <div><dt>SLA</dt><dd>@_selectedWorkflow.Sla</dd></div>
                <div><dt>Control</dt><dd>@_selectedWorkflow.Control</dd></div>
            </dl>

            <div class="docs-policy-card">
                <strong>Tenant controls</strong>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Metadata, category, and retention policy enforced</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Share links, e-sign, and access activity audited</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> OCR exceptions routed for manual classification</span>
            </div>

            <div class="docs-detail-actions">
                <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selectedWorkflow.Url)">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Module
                </button>
                <button class="um-btn um-btn-ghost" @onclick="() => AdvanceWorkflow(_selectedWorkflow)">
                    <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Advance
                </button>
            </div>
        }
    </aside>
</section>

<section class="docs-module-grid" aria-label="Documents modules">
    @foreach (var module in _docModules)
    {
        <button class="docs-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
            <span class="docs-module-icon @DocToneCss(module.Type)"><i class="bi @module.Icon" aria-hidden="true"></i></span>
            <span class="docs-module-content">
                <strong>@module.Title</strong>
                <small>@module.Description</small>
            </span>
            <i class="bi bi-chevron-right docs-module-arrow" aria-hidden="true"></i>
        </button>
    }
</section>

<!-- ── KPI STRIP ──────────────────────────────────────────────────── -->
<div class="dh-kpi-strip">
    @DhKpi("bi-folder2",           "Total Documents",      (_items?.Count ?? 0).ToString(),                                             "dh-ki-blue")
    @DhKpi("bi-pen",               "Pending Signature",    _kpiEsign.ToString(),                                                         "dh-ki-amber")
    @DhKpi("bi-file-earmark-medical","ACORD Forms",        _kpiAcord.ToString(),                                                         "dh-ki-purple")
    @DhKpi("bi-exclamation-triangle","OCR Exceptions",     _kpiExceptions.ToString(),                                                    "dh-ki-red")
    @DhKpi("bi-archive",           "Archived",             (_items?.Count(d => d.StatusCode == "Archived") ?? 0).ToString(),            "dh-ki-gray")
    @DhKpi("bi-calendar-plus",     "This Week",            (_items?.Count(d => d.CreatedDateUtc >= DateTime.UtcNow.AddDays(-7)) ?? 0).ToString(), "dh-ki-green")
    @DhKpi("bi-stars",             "AI Classified",        _kpiAiClassified.ToString(),                                                  "dh-ki-purple")
    @DhKpi("bi-exclamation-circle","Unclassified",         (_items?.Count(d => string.IsNullOrEmpty(d.CategoryCode)) ?? 0).ToString(),  "dh-ki-amber")
</div>

<!-- ── SUB-NAV STRIP ───────────────────────────────────────────── -->
<div class="dh-subnav">
    <button class="dh-subnav-btn dh-subnav-active">
        <i class="bi bi-folder2" aria-hidden="true"></i> All Documents
    </button>
    <button class="dh-subnav-btn" @onclick='() => Nav.NavigateTo("/documents/forms")'>
        <i class="bi bi-file-earmark-medical" aria-hidden="true"></i> ACORD Forms
    </button>
    <button class="dh-subnav-btn" @onclick='() => Nav.NavigateTo("/documents/esign")'>
        <i class="bi bi-pen" aria-hidden="true"></i> E-Signature Queue
        @if (_kpiEsign > 0) { <span class="dh-subnav-badge">@_kpiEsign</span> }
    </button>
    <button class="dh-subnav-btn" @onclick='() => Nav.NavigateTo("/documents/exceptions")'>
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> OCR Exceptions
        @if (_kpiExceptions > 0) { <span class="dh-subnav-badge dh-snb-red">@_kpiExceptions</span> }
    </button>
    <button class="dh-subnav-btn" @onclick='() => Nav.NavigateTo("/documents/packets")'>
        <i class="bi bi-collection" aria-hidden="true"></i> Packet Builder
    </button>
</div>

<div class="dh-toolbar">
    <SfDropDownList TItem="CategoryOption" TValue="string" DataSource="_categories" @bind-Value="_categoryFilter"
                    Placeholder="All Categories" Width="180px">
        <DropDownListFieldSettings Text="Label" Value="Code"></DropDownListFieldSettings>
    </SfDropDownList>
    <SfTextBox Placeholder="Search files, types, tags…" @bind-Value="_searchTerm" Width="280px"></SfTextBox>
    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync">
        <i class="bi bi-search" aria-hidden="true"></i> Search
    </button>
    <div class="dh-toolbar-right">
        <select class="e-input dh-view-sel" @bind="_viewMode">
            <option value="grid">Grid View</option>
            <option value="list">List View</option>
        </select>
    </div>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="480px">
        <GridEvents RowSelected="OnRowSelected" TValue="DocumentDto"></GridEvents>
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
                <GridColumn Field="@nameof(DocumentDto.FileName)" HeaderText="File Name" Width="220">
                    <Template>
                        @{ var doc = (DocumentDto)context; }
                        <div class="dh-fn-cell">
                            <i class="bi @DocIcon(doc.ContentType) dh-fn-icon" aria-hidden="true"></i>
                            <div>
                                <div class="dh-fn-name">@doc.FileName</div>
                                @if (!string.IsNullOrEmpty(doc.Description))
                                {
                                    <div class="dh-fn-desc">@doc.Description</div>
                                }
                            </div>
                        </div>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="AI Classification" Width="160">
                    <Template>
                        @{ var doc2 = (DocumentDto)context; }
                        <span class="dh-ai-class-chip @(string.IsNullOrEmpty(doc2.CategoryCode) ? "dh-ai-unclassified" : "dh-ai-classified")">
                            <i class="bi @(string.IsNullOrEmpty(doc2.CategoryCode) ? "bi-question-circle" : "bi-stars")" aria-hidden="true"></i>
                            @AiClassify(doc2)
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(DocumentDto.CategoryCode)" HeaderText="Category" Width="130"></GridColumn>
                <GridColumn Field="@nameof(DocumentDto.DocumentTypeCode)" HeaderText="Type" Width="130"></GridColumn>
                <GridColumn Field="@nameof(DocumentDto.EntityName)" HeaderText="Linked Entity" Width="130"></GridColumn>
                <GridColumn Field="@nameof(DocumentDto.VersionNumber)" HeaderText="Ver" Width="60" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center"></GridColumn>
                <GridColumn Field="@nameof(DocumentDto.Tags)" HeaderText="Tags" Width="160"></GridColumn>
                <GridColumn HeaderText="Status" Width="110">
                    <Template>
                        @{ var doc3 = (DocumentDto)context; }
                        <span class="dh-status-badge dh-st-@(doc3.StatusCode?.ToLower() ?? "active")">
                            @doc3.StatusCode
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(DocumentDto.RetentionDate)" HeaderText="Retention" Width="110"></GridColumn>
                <GridColumn Field="@nameof(DocumentDto.CreatedDateUtc)" HeaderText="Uploaded" Type="ColumnType.DateTime" Format="g" Width="145"></GridColumn>
                <GridColumn HeaderText="Actions" Width="105">
                    <Template>
                        @{ var docA = (DocumentDto)context; }
                        <div class="dh-row-actions">
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => Nav.NavigateTo($"/documents/{docA.DocumentId}")' title="Open detail">
                                <i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>
                            </button>
                            <button class="um-btn um-btn-ghost um-btn-xs" title="Send for E-Sign"
                                    @onclick='() => Nav.NavigateTo("/documents/esign")'>
                                <i class="bi bi-pen" aria-hidden="true"></i>
                            </button>
                        </div>
                    </Template>
                </GridColumn>
            </GridColumns>
    </SfGrid>
}

@* ── Upload Dialog ─────────────────────────────────────── *@
<SfDialog Width="1120px" IsModal="true" @bind-Visible="_showUpload" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header">
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span>Upload Document</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showUpload = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="um-modal-body">
                <div class="um-form-grid">
            <div class="um-field">
                <label>File Name</label>
                <SfTextBox @bind-Value="_newDoc.FileName"></SfTextBox>
            </div>
            <div class="um-field">
                <label>Storage Path</label>
                <SfTextBox @bind-Value="_newDoc.StoragePath"></SfTextBox>
            </div>
            <div class="um-field">
                <label>Category</label>
                <SfDropDownList TItem="CategoryOption" TValue="string" DataSource="_uploadCategories" @bind-Value="_newDoc.CategoryCode" Width="100%">
                    <DropDownListFieldSettings Text="Label" Value="Code"></DropDownListFieldSettings>
                </SfDropDownList>
            </div>
            <div class="um-field">
                <label>Document Type Code</label>
                <SfTextBox @bind-Value="_newDoc.DocumentTypeCode"></SfTextBox>
            </div>
            <div class="um-field">
                <label>Content Type</label>
                <SfTextBox @bind-Value="_newDoc.ContentType"></SfTextBox>
            </div>
            <div class="um-field">
                <label>Entity Name (e.g. Account, Agreement)</label>
                <SfTextBox @bind-Value="_newDoc.EntityName"></SfTextBox>
            </div>
            <div class="um-field um-field--full">
                <label>Description</label>
                <SfTextBox @bind-Value="_newDoc.Description" Multiline="true"></SfTextBox>
            </div>
            <div class="um-field">
                <label>Tags (comma-separated)</label>
                <SfTextBox @bind-Value="_newDoc.Tags"></SfTextBox>
            </div>
            <div class="um-field">
                <label>Uploaded By</label>
                <SfTextBox @bind-Value="_newDoc.UploadedByName"></SfTextBox>
            </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showUpload = false">Cancel</button>
                <button type="button" class="um-btn um-btn-primary" @onclick="SubmitUploadAsync">Upload</button>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

@* ── Detail / Actions Dialog ──────────────────────────── *@
<SfDialog Width="1120px" IsModal="true" @bind-Visible="_showDetail" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                <span>@(_selected?.FileName ?? "Document Details")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showDetail = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            @if (_selected is not null)
            {
                <div class="um-modal-body"><SfTab>
                    <TabItems>
                        <TabItem>
                            <ChildContent><TabHeader Text="Details"></TabHeader></ChildContent>
                            <ContentTemplate>
                                <div class="row mt-3">
                                    <div class="col-6"><strong>Category:</strong> @_selected.CategoryCode</div>
                                    <div class="col-6"><strong>Type:</strong> @_selected.DocumentTypeCode</div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-6"><strong>Status:</strong> @_selected.StatusCode</div>
                                    <div class="col-6"><strong>Version:</strong> @_selected.VersionNumber</div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-6"><strong>Content Type:</strong> @_selected.ContentType</div>
                                    <div class="col-6"><strong>Size:</strong> @FormatSize(_selected.FileSizeBytes)</div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-6"><strong>Linked Entity:</strong> @_selected.EntityName</div>
                                    <div class="col-6"><strong>Retention:</strong> @_selected.RetentionDate</div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12"><strong>Description:</strong> @_selected.Description</div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-12"><strong>Tags:</strong> @_selected.Tags</div>
                                </div>
                                <hr />
                                <div class="d-flex gap-2 flex-wrap">
                                    <SfButton CssClass="e-warning" OnClick="ArchiveSelectedAsync">Archive</SfButton>
                                    <SfButton CssClass="e-info" OnClick="() => _showMetadata = true">Edit Metadata</SfButton>
                                    <SfButton CssClass="e-success" OnClick="() => _showNewVersion = true">New Version</SfButton>
                                    <SfButton CssClass="e-primary" OnClick="() => _showShareDialog = true">Share</SfButton>
                                    <SfButton CssClass="e-secondary" OnClick="OpenRenameDialog">Rename</SfButton>
                                    <SfButton CssClass="e-danger" OnClick="DeleteSelectedAsync">Delete</SfButton>
                                </div>
                            </ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent><TabHeader Text="Versions"></TabHeader></ChildContent>
                            <ContentTemplate>
                                @if (_versions is null) { <p>Loading...</p> }
                                else
                                {
                                    <SfGrid DataSource="_versions" AllowSorting="true" Height="260px">
                                        <GridColumns>
                                            <GridColumn Field="@nameof(DocumentVersionDto.VersionNumber)" HeaderText="Ver" Width="60"></GridColumn>
                                            <GridColumn Field="@nameof(DocumentVersionDto.FileName)" HeaderText="File" Width="200"></GridColumn>
                                            <GridColumn Field="@nameof(DocumentVersionDto.ChangeNotes)" HeaderText="Notes" Width="200"></GridColumn>
                                            <GridColumn Field="@nameof(DocumentVersionDto.CreatedDateUtc)" HeaderText="Date" Type="ColumnType.DateTime" Format="g" Width="160"></GridColumn>
                                        </GridColumns>
                                    </SfGrid>
                                }
                            </ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent><TabHeader Text="Share Links"></TabHeader></ChildContent>
                            <ContentTemplate>
                                @if (_shareLinks is null) { <p>Loading...</p> }
                                else
                                {
                                    <SfGrid DataSource="_shareLinks" AllowSorting="true" Height="260px">
                                        <GridColumns>
                                            <GridColumn Field="@nameof(DocumentShareLinkDto.Token)" HeaderText="Token" Width="180"></GridColumn>
                                            <GridColumn Field="@nameof(DocumentShareLinkDto.ExpiresDateUtc)" HeaderText="Expires" Type="ColumnType.DateTime" Format="g" Width="160"></GridColumn>
                                            <GridColumn Field="@nameof(DocumentShareLinkDto.AccessCount)" HeaderText="Accessed" Width="90"></GridColumn>
                                            <GridColumn Field="@nameof(DocumentShareLinkDto.MaxAccessCount)" HeaderText="Max" Width="70"></GridColumn>
                                            <GridColumn Field="@nameof(DocumentShareLinkDto.IsRevoked)" HeaderText="Revoked" Width="90"></GridColumn>
                                            <GridColumn HeaderText="Actions" Width="90">
                                                <Template>
                                                    @{
                                                        var lnk = (DocumentShareLinkDto)context;
                                                    }
                                                    @if (!lnk.IsRevoked)
                                                    {
                                                        <SfButton CssClass="e-danger e-small" OnClick="@(() => RevokeShareLinkAsync(lnk.ShareLinkId))">Revoke</SfButton>
                                                    }
                                                </Template>
                                            </GridColumn>
                                        </GridColumns>
                                    </SfGrid>
                                }
                            </ContentTemplate>
                        </TabItem>
                        <TabItem>
                            <ChildContent><TabHeader Text="Audit Trail"></TabHeader></ChildContent>
                            <ContentTemplate>
                                @if (_accessLog is null) { <p>Loading...</p> }
                                else
                                {
                                    <SfGrid DataSource="_accessLog" AllowSorting="true" Height="260px">
                                        <GridColumns>
                                            <GridColumn Field="@nameof(DocumentAccessLogDto.ActionCode)" HeaderText="Action" Width="120"></GridColumn>
                                            <GridColumn Field="@nameof(DocumentAccessLogDto.UserId)" HeaderText="User" Width="200"></GridColumn>
                                            <GridColumn Field="@nameof(DocumentAccessLogDto.IpAddress)" HeaderText="IP" Width="140"></GridColumn>
                                            <GridColumn Field="@nameof(DocumentAccessLogDto.AccessDateUtc)" HeaderText="Date" Type="ColumnType.DateTime" Format="g" Width="160"></GridColumn>
                                        </GridColumns>
                                    </SfGrid>
                                }
                            </ContentTemplate>
                        </TabItem>
                    </TabItems>
                </SfTab></div>
            }
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showDetail = false">Close</button>
            </div>
        </Content>
    </DialogTemplates>
</SfDialog>

@* ── Edit Metadata Dialog ─────────────────────────────── *@
<SfDialog Width="760px" IsModal="true" @bind-Visible="_showMetadata" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-tags" aria-hidden="true"></i><span>Edit Metadata</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showMetadata = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="um-modal-body"><div class="um-form-grid">
            <div class="um-field um-field--full">
                <label>Description</label>
                <SfTextBox @bind-Value="_metaRequest.Description" Multiline="true"></SfTextBox>
            </div>
            <div class="um-field um-field--full">
                <label>Tags</label>
                <SfTextBox @bind-Value="_metaRequest.Tags"></SfTextBox>
            </div>
            </div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showMetadata = false">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SubmitMetadataAsync">Save</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@* ── New Version Dialog ───────────────────────────────── *@
<SfDialog Width="920px" IsModal="true" @bind-Visible="_showNewVersion" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-layers" aria-hidden="true"></i><span>Upload New Version</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showNewVersion = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="um-modal-body"><div class="um-form-grid">
            <div class="um-field">
                <label>File Name</label>
                <SfTextBox @bind-Value="_versionRequest.FileName"></SfTextBox>
            </div>
            <div class="um-field">
                <label>Storage Path</label>
                <SfTextBox @bind-Value="_versionRequest.StoragePath"></SfTextBox>
            </div>
            <div class="um-field">
                <label>Content Type</label>
                <SfTextBox @bind-Value="_versionRequest.ContentType"></SfTextBox>
            </div>
            <div class="um-field um-field--full">
                <label>Change Notes</label>
                <SfTextBox @bind-Value="_versionRequest.ChangeNotes" Multiline="true"></SfTextBox>
            </div>
            </div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showNewVersion = false">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SubmitVersionAsync">Upload Version</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@* ── Share Link Dialog ────────────────────────────────── *@
<SfDialog Width="760px" IsModal="true" @bind-Visible="_showShareDialog" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-share" aria-hidden="true"></i><span>Create Share Link</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showShareDialog = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="um-modal-body"><div class="um-form-grid">
            <div class="um-field">
                <label>Expires (UTC)</label>
                <SfDateTimePicker TValue="DateTime" @bind-Value="_shareExpires" Width="100%"></SfDateTimePicker>
            </div>
            <div class="um-field">
                <label>Max Access Count (blank = unlimited)</label>
                <SfNumericTextBox TValue="int?" @bind-Value="_shareMaxAccess" Width="100%"></SfNumericTextBox>
            </div>
            <div class="um-field">
                <SfCheckBox Label="Require PIN" @bind-Checked="_shareRequiresPin"></SfCheckBox>
            </div>
            @if (_shareRequiresPin)
            {
                <div class="um-field">
                    <label>PIN</label>
                    <SfTextBox @bind-Value="_sharePin" Type="InputType.Password"></SfTextBox>
                </div>
            }
            </div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showShareDialog = false">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SubmitShareLinkAsync">Create Link</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@* ── Rename Dialog ───────────────────────────────────────── *@
<SfDialog Width="620px" IsModal="true" @bind-Visible="_showRename" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-pencil" aria-hidden="true"></i><span>Rename Document</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showRename = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="um-modal-body"><div class="um-form-grid">
            <div class="um-field um-field--full">
                <label>New File Name</label>
                <SfTextBox @bind-Value="_renameRequest.NewFileName"></SfTextBox>
            </div>
            </div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showRename = false">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SubmitRenameAsync">Rename</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private string? _categoryFilter;
    private string _workflowSearch = string.Empty;
    private string _workflowFilter = string.Empty;
    private List<DocumentDto>? _items;
    private string _viewMode = "grid";

    // KPI counters (stubs — in production drive from real API)
    private int _kpiEsign      = 7;
    private int _kpiAcord      = 24;
    private int _kpiExceptions = 3;
    private int _kpiAiClassified => _items?.Count(d => !string.IsNullOrEmpty(d.CategoryCode)) ?? 0;

    // Detail panel
    private DocumentDto? _selected;
    private DocumentWorkflowItem? _selectedWorkflow;
    private bool _showDetail;
    private List<DocumentVersionDto>? _versions;
    private List<DocumentShareLinkDto>? _shareLinks;
    private List<DocumentAccessLogDto>? _accessLog;

    // Upload
    private bool _showUpload;
    private CreateDocumentRequest _newDoc = new();

    // Metadata edit
    private bool _showMetadata;
    private UpdateDocumentMetadataRequest _metaRequest = new();

    // New version
    private bool _showNewVersion;
    private CreateDocumentVersionRequest _versionRequest = new();

    // Share link
    private bool _showShareDialog;
    private DateTime _shareExpires = DateTime.UtcNow.AddDays(7);
    private int? _shareMaxAccess;
    private bool _shareRequiresPin;
    private string? _sharePin;

    // Rename
    private bool _showRename;
    private RenameDocumentRequest _renameRequest = new();

    private readonly List<DocumentWorkflowItem> _docWorkflow = [];

    private readonly WorkflowLane[] _docLanes =
    [
        new("Intake", "Intake", "Uploads and client submissions"),
        new("Classify", "Classify", "AI/OCR metadata assignment"),
        new("Prepare", "Prepare", "Forms, packets, and versions"),
        new("Sign", "Sign", "E-signature and acknowledgements"),
        new("Audit", "Audit", "Retention, access, and compliance")
    ];

    private readonly WorkflowFilter[] _docFilters =
    [
        new("", "All"),
        new("risk", "High Risk"),
        new("ocr", "OCR"),
        new("esign", "E-Sign"),
        new("audit", "Audit")
    ];

    private readonly DocumentModule[] _docModules =
    [
        new("Documents Hub", "Search, upload, version, share, archive, and manage document metadata.", "/documents", "bi-folder2", "Repository"),
        new("ACORD Forms Center", "Browse, pre-fill, complete, and route standard ACORD forms.", "/documents/forms", "bi-file-earmark-medical", "ACORD"),
        new("E-Signature Queue", "Send signature requests, monitor completion, void requests, and escalate.", "/documents/esign", "bi-pen", "E-Sign"),
        new("OCR Exceptions", "Resolve failed OCR, apply AI suggestions, and correct indexing.", "/documents/exceptions", "bi-exclamation-triangle", "OCR"),
        new("Packet Builder", "Assemble renewal, claims, onboarding, and service document packets.", "/documents/packets", "bi-collection", "Packet"),
        new("Audit Log", "Review access history, changes, retention evidence, and compliance events.", "/audit", "bi-shield-check", "Audit")
    ];

    private DocumentModule[] _docQuickActions =>
    [
        new("ACORD", "", "/documents/forms", "bi-file-earmark-medical", "ACORD"),
        new("E-Sign", "", "/documents/esign", "bi-pen", "E-Sign"),
        new("OCR", "", "/documents/exceptions", "bi-exclamation-triangle", "OCR"),
        new("Packets", "", "/documents/packets", "bi-collection", "Packet")
    ];

    private IEnumerable<DocumentWorkflowItem> FilteredDocWorkflow => _docWorkflow.Where(item =>
        (string.IsNullOrWhiteSpace(_workflowFilter) || _workflowFilter switch
        {
            "risk" => item.Risk == "High",
            "ocr" => item.Type == "OCR",
            "esign" => item.Type == "E-Sign",
            "audit" => item.Stage == "Audit" || item.Type == "Audit",
            _ => true
        }) &&
        (string.IsNullOrWhiteSpace(_workflowSearch) ||
         item.Title.Contains(_workflowSearch, StringComparison.OrdinalIgnoreCase) ||
         item.Summary.Contains(_workflowSearch, StringComparison.OrdinalIgnoreCase) ||
         item.Owner.Contains(_workflowSearch, StringComparison.OrdinalIgnoreCase) ||
         item.Type.Contains(_workflowSearch, StringComparison.OrdinalIgnoreCase) ||
         item.Control.Contains(_workflowSearch, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(item => item.Risk == "High")
        .ThenBy(item => item.Stage)
        .ThenBy(item => item.Title);

    // Category options
    private readonly List<CategoryOption> _categories = new()
    {
        new("", "All Categories"),
        new("Proposal", "Proposal"),
        new("Contract", "Contract"),
        new("Invoice", "Invoice"),
        new("Statement", "Statement"),
        new("ClientUpload", "Client Upload"),
        new("ServiceDocument", "Service Document"),
        new("CommissionStatement", "Commission Statement"),
        new("AuditEvidence", "Audit Evidence"),
        new("Other", "Other")
    };

    private List<CategoryOption> _uploadCategories => _categories.Where(c => !string.IsNullOrEmpty(c.Code)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Documents",""));
        BuildDocumentWorkflow();
        _selectedWorkflow = _docWorkflow.FirstOrDefault(x => x.Risk == "High") ?? _docWorkflow.FirstOrDefault();
        await LoadAsync();
    }

    private void BuildDocumentWorkflow()
    {
        _docWorkflow.Clear();
        _docWorkflow.AddRange(
        [
            new("New client document intake", "Client upload queue awaiting metadata validation and entity linkage.", "Repository", "Medium", "Intake", "Sarah Kim", "4h SLA", "Metadata policy", "/documents"),
            new("OCR exception classification", "Scanned policy package has low confidence OCR and requires manual classification.", "OCR", "High", "Classify", "James Park", "Same day", "OCR confidence threshold", "/documents/exceptions"),
            new("ACORD 25 pre-fill review", "Certificate form is AI pre-filled and waiting for producer validation.", "ACORD", "Medium", "Prepare", "Maria Santos", "24h", "Form accuracy control", "/documents/forms"),
            new("Renewal packet assembly", "Commercial renewal packet requires dec page, proposal, invoice, and disclosures.", "Packet", "Medium", "Prepare", "Lisa Chen", "2 days", "Packet completeness", "/documents/packets"),
            new("Signature request escalation", "Policy acknowledgement has not been signed before due date.", "E-Sign", "High", "Sign", "Kevin Obi", "Overdue", "Signer audit trail", "/documents/esign"),
            new("Share link access review", "External share links with access counts require tenant admin review.", "Audit", "Low", "Audit", "Diana Perez", "Weekly", "Access and retention audit", "/audit"),
            new("Retention evidence review", "Archived documents must be validated against agency retention settings.", "Audit", "Medium", "Audit", "Robert Yamamoto", "Monthly", "Retention schedule", "/audit")
        ]);
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchDocumentsAsync(_tenantId, _categoryFilter, null, null, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }

    private async Task OnRowSelected(RowSelectEventArgs<DocumentDto> args)
    {
        _selected = args.Data;
        _versions = null;
        _shareLinks = null;
        _accessLog = null;
        _showDetail = true;

        var versionsTask = Api.GetDocumentVersionsAsync(_selected.DocumentId);
        var linksTask = Api.GetDocumentShareLinksAsync(_selected.DocumentId);
        var logTask = Api.GetDocumentAccessLogAsync(_selected.DocumentId);
        await Task.WhenAll(versionsTask, linksTask, logTask);

        _versions = (await versionsTask)?.ToList() ?? [];
        _shareLinks = (await linksTask)?.ToList() ?? [];
        _accessLog = (await logTask)?.ToList() ?? [];
    }

    private async Task SubmitUploadAsync()
    {
        _newDoc.TenantId = _tenantId;
        await Api.CreateDocumentAsync(_newDoc);
        _newDoc = new();
        _showUpload = false;
        await LoadAsync();
    }

    private async Task SubmitMetadataAsync()
    {
        if (_selected is null) return;
        _metaRequest.DocumentId = _selected.DocumentId;
        await Api.UpdateDocumentMetadataAsync(_metaRequest);
        _showMetadata = false;
        _selected = await Api.GetDocumentByIdAsync(_selected.DocumentId);
    }

    private async Task ArchiveSelectedAsync()
    {
        if (_selected is null) return;
        await Api.ArchiveDocumentAsync(_selected.DocumentId);
        _showDetail = false;
        await LoadAsync();
    }

    private async Task SubmitVersionAsync()
    {
        if (_selected is null) return;
        _versionRequest.TenantId = _tenantId;
        _versionRequest.DocumentId = _selected.DocumentId;
        await Api.CreateDocumentVersionAsync(_versionRequest);
        _versionRequest = new();
        _showNewVersion = false;
        _versions = (await Api.GetDocumentVersionsAsync(_selected.DocumentId))?.ToList() ?? [];
        _selected = await Api.GetDocumentByIdAsync(_selected.DocumentId);
    }

    private async Task SubmitShareLinkAsync()
    {
        if (_selected is null) return;
        var request = new CreateDocumentShareLinkRequest
        {
            TenantId = _tenantId,
            DocumentId = _selected.DocumentId,
            CreatedByUserId = Guid.Empty,
            ExpiresDateUtc = _shareExpires,
            MaxAccessCount = _shareMaxAccess,
            RequiresPin = _shareRequiresPin,
            Pin = _sharePin
        };
        await Api.CreateDocumentShareLinkAsync(request);
        _showShareDialog = false;
        _shareLinks = (await Api.GetDocumentShareLinksAsync(_selected.DocumentId))?.ToList() ?? [];
    }

    private void OpenRenameDialog()
    {
        if (_selected is null) return;
        _renameRequest = new RenameDocumentRequest { DocumentId = _selected.DocumentId, NewFileName = _selected.FileName };
        _showRename = true;
    }

    private async Task SubmitRenameAsync()
    {
        await Api.RenameDocumentAsync(_renameRequest);
        _showRename = false;
        _selected = await Api.GetDocumentByIdAsync(_selected!.DocumentId);
        await LoadAsync();
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selected is null) return;
        await Api.DeleteDocumentAsync(_selected.DocumentId);
        _showDetail = false;
        await LoadAsync();
    }

    private async Task RevokeShareLinkAsync(Guid shareLinkId)
    {
        await Api.RevokeDocumentShareLinkAsync(shareLinkId);
        if (_selected is not null)
            _shareLinks = (await Api.GetDocumentShareLinksAsync(_selected.DocumentId))?.ToList() ?? [];
    }

    // ── Helpers ─────────────────────────────────────
    static string AiClassify(DocumentDto d)
    {
        if (!string.IsNullOrEmpty(d.CategoryCode)) return d.CategoryCode;
        var name = (d.FileName ?? "").ToLowerInvariant();
        if (name.Contains("acord") || name.Contains("form"))    return "ACORD Form";
        if (name.Contains("policy") || name.Contains("dec"))    return "Policy / Dec Page";
        if (name.Contains("claim")  || name.Contains("fnol"))   return "Claim Document";
        if (name.Contains("cert")   || name.Contains("coi"))    return "Certificate";
        if (name.Contains("endorse")|| name.Contains("endo"))   return "Endorsement";
        if (name.Contains("invoice")|| name.Contains("bill"))   return "Billing";
        if (name.Contains("audit"))                              return "Audit";
        if (name.Contains("proposal"))                          return "Proposal";
        return "Unclassified";
    }

    static string DocIcon(string? mime) => mime?.ToLowerInvariant() switch
    {
        var m when m?.Contains("pdf")   == true => "bi-file-earmark-pdf",
        var m when m?.Contains("word")  == true ||
                   m?.Contains("docx")  == true => "bi-file-earmark-word",
        var m when m?.Contains("excel") == true ||
                   m?.Contains("xlsx")  == true => "bi-file-earmark-excel",
        var m when m?.Contains("image") == true => "bi-file-earmark-image",
        _                                        => "bi-file-earmark"
    };

    RenderFragment DhKpi(string icon, string label, string val, string color) => __builder =>
    {
        <div class="dh-kpi-card @color">
            <i class="bi @icon dh-kpi-icon" aria-hidden="true"></i>
            <div><div class="dh-kpi-val">@val</div><div class="dh-kpi-lbl">@label</div></div>
        </div>
    };

    RenderFragment DocWorkflowKpi(string label, string value, string meta, string icon, string tone) => @<article class="docs-kpi-card">
        <span class="docs-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span>
        <div>
            <strong>@value</strong>
            <span>@label</span>
            <small>@meta</small>
        </div>
    </article>;

    private int DocFilterCount(string key) => key switch
    {
        "risk" => _docWorkflow.Count(x => x.Risk == "High"),
        "ocr" => _docWorkflow.Count(x => x.Type == "OCR"),
        "esign" => _docWorkflow.Count(x => x.Type == "E-Sign"),
        "audit" => _docWorkflow.Count(x => x.Stage == "Audit" || x.Type == "Audit"),
        _ => _docWorkflow.Count
    };

    private void AdvanceWorkflow(DocumentWorkflowItem item)
    {
        item.Stage = item.Stage switch
        {
            "Intake" => "Classify",
            "Classify" => "Prepare",
            "Prepare" => "Sign",
            "Sign" => "Audit",
            _ => "Audit"
        };
    }

    static string DocToneCss(string type) => type switch
    {
        "Repository" => "docs-tone-blue",
        "ACORD" => "docs-tone-violet",
        "E-Sign" => "docs-tone-amber",
        "OCR" => "docs-tone-red",
        "Packet" => "docs-tone-cyan",
        "Audit" => "docs-tone-green",
        _ => "docs-tone-neutral"
    };

    static string DocRiskCss(string risk) => risk switch
    {
        "High" => "docs-status-high",
        "Medium" => "docs-status-medium",
        _ => "docs-status-low"
    };

    private static string FormatSize(long? bytes)
    {
        if (bytes is null) return "—";
        return bytes switch
        {
            < 1024 => $"{bytes} B",
            < 1048576 => $"{bytes / 1024.0:F1} KB",
            < 1073741824 => $"{bytes / 1048576.0:F1} MB",
            _ => $"{bytes / 1073741824.0:F2} GB"
        };
    }

    private sealed record CategoryOption(string Code, string Label);
    private sealed record WorkflowLane(string Key, string Label, string Description);
    private sealed record WorkflowFilter(string Key, string Label);
    private sealed record DocumentModule(string Title, string Description, string Url, string Icon, string Type)
    {
        public string Label => Title;
    }

    private sealed class DocumentWorkflowItem(string title, string summary, string type, string risk, string stage, string owner, string sla, string control, string url)
    {
        public string Title { get; set; } = title;
        public string Summary { get; set; } = summary;
        public string Type { get; set; } = type;
        public string Risk { get; set; } = risk;
        public string Stage { get; set; } = stage;
        public string Owner { get; set; } = owner;
        public string Sla { get; set; } = sla;
        public string Control { get; set; } = control;
        public string Url { get; set; } = url;
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
