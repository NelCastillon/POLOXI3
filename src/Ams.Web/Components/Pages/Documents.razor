    private RenderFragment CategoryChip(DocumentDto row) => builder => Chip(builder, "dh-type-chip", string.IsNullOrWhiteSpace(row.CategoryCode) ? "Unclassified" : row.CategoryCode);
    private RenderFragment TypeChip(string type) => builder => Chip(builder, "dh-type-chip", string.IsNullOrWhiteSpace(type) ? "General" : type);
    private RenderFragment StatusChip(string status) => builder => Chip(builder, $"dh-status dh-status-{CssSafe(status)}", string.IsNullOrWhiteSpace(status) ? "Active" : status);
    private RenderFragment WorkflowCell(DocumentDto row) => builder => Chip(builder, $"dh-lifecycle dh-lifecycle-{CssSafe(WorkflowStage(row))}", WorkflowStage(row));

    private static void Chip(RenderTreeBuilder builder, string cssClass, string value)
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", cssClass);
        builder.AddContent(2, value);
        builder.CloseElement();
    }

    private IEnumerable<string> DocumentTags(DocumentDto row) => (row.Tags ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string AiClassify(DocumentDto d)
    {
        if (!string.IsNullOrWhiteSpace(d.CategoryCode)) return d.CategoryCode;
        var name = (d.FileName ?? string.Empty).ToLowerInvariant();
        if (name.Contains("acord") || name.Contains("form")) return "ACORD Form";
        if (name.Contains("policy") || name.Contains("dec")) return "Policy / Dec Page";
        if (name.Contains("claim") || name.Contains("fnol")) return "Claim Document";
        if (name.Contains("cert") || name.Contains("coi")) return "Certificate";
        if (name.Contains("endorse")) return "Endorsement";
        if (name.Contains("invoice") || name.Contains("bill")) return "Billing";
        if (name.Contains("audit")) return "Audit";
        if (name.Contains("proposal")) return "Proposal";
        return "Unclassified";
    }

    private static string WorkflowStage(DocumentDto row)
    {
        if (row.StatusCode == "Archived") return "Audit";
        if (string.IsNullOrWhiteSpace(row.CategoryCode)) return "Classify";
        if (row.FileName.Contains("sign", StringComparison.OrdinalIgnoreCase) || row.Tags?.Contains("sign", StringComparison.OrdinalIgnoreCase) == true) return "Sign";
        if (row.VersionNumber > 1 || row.FileName.Contains("packet", StringComparison.OrdinalIgnoreCase)) return "Prepare";
        return "Intake";
    }

    private static string DocumentRisk(DocumentDto row)
        => string.IsNullOrWhiteSpace(row.CategoryCode) || row.RetentionDate is null ? "High" : row.StatusCode == "Archived" ? "Low" : "Medium";

    private void FocusCategory(string category)
    {
        _searchText = category == "Unclassified" ? null : category;
        _activeTab = category == "Unclassified" ? "unclassified" : "all";
        _kpiFilter = null;
        _activeView = "Library";
        _page = 1;
    }

    private static int Percent(int value, int total) => total <= 0 ? 0 : Math.Clamp((int)Math.Round(value * 100d / total), 0, 100);

    private static string PriorityReason(DocumentDto row)
        => string.IsNullOrWhiteSpace(row.CategoryCode) ? "Missing classification metadata" : row.RetentionDate is null ? "Retention date not set" : "Workflow exception";

    private static string DocIcon(string? mime, string? fileName) => (mime ?? fileName ?? string.Empty).ToLowerInvariant() switch
    {
        var m when m.Contains("pdf") => "bi-file-earmark-pdf",
        var m when m.Contains("word") || m.Contains("docx") => "bi-file-earmark-word",
        var m when m.Contains("excel") || m.Contains("xlsx") => "bi-file-earmark-excel",
        var m when m.Contains("image") || m.Contains("png") || m.Contains("jpg") => "bi-file-earmark-image",
        _ => "bi-file-earmark"
    };

    private static string StatusIcon(string status) => status switch
    {
        "Archived" => "bi-archive-fill",
        "Pending Review" => "bi-hourglass-split",
        _ => "bi-check-circle-fill"
    };

    private static string LifecycleLabel(DocumentDto row) => row.StatusCode switch
    {
        "Archived" => row.ModifiedDateUtc.HasValue ? $"Archived {row.ModifiedDateUtc.Value.ToLocalTime():MM/dd/yyyy}" : "Archived for audit",
        "Pending Review" => "Pending review workflow",
        _ => row.RetentionDate.HasValue ? $"Retain until {row.RetentionDate.Value:MM/dd/yyyy}" : "Active repository item"
    };

    private static string ToneCss(string type) => type switch
    {
        "ACORD" => "dh-tone-violet",
        "E-Sign" => "dh-tone-amber",
        "OCR" => "dh-tone-red",
        "Packet" => "dh-tone-cyan",
        "Workflow" => "dh-tone-blue",
        "Storage" => "dh-tone-green",
        _ => "dh-tone-neutral"
    };

    private static string GuessDocumentType(string fileName)
    {
        var name = fileName.ToLowerInvariant();
        if (name.Contains("certificate") || name.Contains("coi")) return "Certificate";
        if (name.Contains("endorsement")) return "Endorsement";
        if (name.Contains("binder")) return "Binder";
        if (name.Contains("policy") || name.Contains("declaration")) return "Policy";
        if (name.Contains("claim")) return "Claim";
        return "General";
    }

    private static string FormatSize(long? bytes)
    {
        if (bytes is null) return "â€”";
        return bytes switch
        {
            < 1024 => $"{bytes} B",
            < 1048576 => $"{bytes / 1024.0:F1} KB",
            < 1073741824 => $"{bytes / 1048576.0:F1} MB",
            _ => $"{bytes / 1073741824.0:F2} GB"
        };
    }

    private static string Csv(string? value)
    {
        var text = value ?? string.Empty;
        return string.Concat("\"", text.Replace("\"", "\"\""), "\"");
    }

    private static string CssSafe(string? value) => string.IsNullOrWhiteSpace(value) ? "unknown" : value.Trim().ToLowerInvariant().Replace(" ", "-");
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;
    private Task NotifyValidationAsync() { ShowToast("Review required fields before continuing.", "danger"); return Task.CompletedTask; }

