    };

    private RenderFragment DrawerField(string label, string value) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "dh-meta-row");
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "dh-meta-lbl");
        builder.AddContent(seq++, label);
        builder.CloseElement();
        builder.OpenElement(seq++, "span");
