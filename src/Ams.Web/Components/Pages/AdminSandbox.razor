@page "/admin/system/sandbox"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>Sandbox &amp; Training Mode - AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<AppPageHeader Title="Sandbox &amp; Training Mode"
               Subtitle="Isolated environment for onboarding new staff, testing workflows, and demonstrating platform features without affecting live data"
               Icon="bi-bounding-box">
    <Actions>
        @if (!_sandboxEnabled)
        {
            <button class="um-btn um-btn-primary" @onclick="EnableSandbox"><i class="bi bi-play-circle" aria-hidden="true"></i> Enable Sandbox</button>
        }
        else
        {
            <button class="um-btn um-btn-ghost" @onclick="ResetSandbox"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset Sandbox Data</button>
            <button class="um-btn um-btn-danger" @onclick="DisableSandbox"><i class="bi bi-stop-circle" aria-hidden="true"></i> Disable Sandbox</button>
        }
    </Actions>
</AppPageHeader>

<!-- Status banner -->
<div class="sb-status-banner @(_sandboxEnabled?"sb-banner-on":"sb-banner-off")">
    <i class="bi bi-@(_sandboxEnabled?"bounding-box":"bounding-box")" aria-hidden="true"></i>
    <div>
        <div class="sb-banner-title">Sandbox Mode @(_sandboxEnabled?"ACTIVE":"INACTIVE")</div>
        <div class="sb-banner-sub">@(_sandboxEnabled ? "Users assigned to sandbox mode cannot affect live data. All actions are isolated." : "Enable sandbox mode to let new users practice without affecting production data.")</div>
    </div>
</div>

<!-- Configuration -->
<div class="sb-layout">
    <div class="sb-config-card">
        <div class="sb-card-hdr">Sandbox Configuration</div>
        <div class="sb-setting-row">
            <div><div class="sb-s-name">Auto-Assign New Users to Sandbox</div><div class="sb-s-desc">New user accounts start in sandbox mode until manually promoted</div></div>
            <label class="sb-toggle"><input type="checkbox" @bind="_autoAssign" /><span class="sb-thumb"></span></label>
        </div>
        <div class="sb-setting-row">
            <div><div class="sb-s-name">Sample Data Pack</div><div class="sb-s-desc">Pre-populate sandbox with realistic sample accounts, policies, and claims</div></div>
            <label class="sb-toggle"><input type="checkbox" @bind="_useSampleData" /><span class="sb-thumb"></span></label>
        </div>
        <div class="sb-setting-row">
            <div><div class="sb-s-name">Training Watermark</div><div class="sb-s-desc">Display "TRAINING MODE" banner on all pages for sandbox users</div></div>
            <label class="sb-toggle"><input type="checkbox" @bind="_showWatermark" /><span class="sb-thumb"></span></label>
        </div>
        <div class="sb-setting-row">
            <div><div class="sb-s-name">Block Outbound Communications</div><div class="sb-s-desc">Prevent sandbox users from sending real emails, SMS, or notifications</div></div>
            <label class="sb-toggle"><input type="checkbox" @bind="_blockComms" /><span class="sb-thumb"></span></label>
        </div>
        <div class="sb-setting-row">
            <div><div class="sb-s-name">Auto-Reset Schedule</div><div class="sb-s-desc">Automatically reset sandbox data on a schedule</div></div>
            <select class="sb-sel" @bind="_resetSchedule">
                <option value="never">Never</option>
                <option value="daily">Daily (midnight)</option>
                <option value="weekly">Weekly (Sunday midnight)</option>
                <option value="monthly">Monthly (1st of month)</option>
            </select>
        </div>
    </div>

    <div class="sb-users-card">
        <div class="sb-card-hdr">Sandbox Users (@_sandboxUsers.Count)</div>
        @foreach (var u in _sandboxUsers)
        {
            <div class="sb-user-row">
                <div class="sb-user-av">@u.Initials</div>
                <div class="sb-user-info">
                    <div class="sb-user-name">@u.Name</div>
                    <div class="sb-user-meta">@u.Role - Joined @u.JoinedDate</div>
                </div>
                <button class="um-btn um-btn-ghost um-btn-xs" title="Promote to production" @onclick="()=>PromoteUser(u)"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i> Promote</button>
            </div>
        }
        <button class="sb-add-user" aria-expanded="@_showAddUser" @onclick="()=>_showAddUser=true"><i class="bi bi-person-plus" aria-hidden="true"></i> Add User to Sandbox</button>
    </div>
</div>

@code {
    private EnterpriseToast? _toast;
    private bool _sandboxEnabled = false;
    private bool _autoAssign = false;
    private bool _useSampleData = true;
    private bool _showWatermark = true;
    private bool _blockComms = true;
    private bool _showAddUser;
    private string _resetSchedule = "weekly";

    private List<SandboxUser> _sandboxUsers = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Administration","/admin"), new("Sandbox & Training Mode",""));
        _sandboxUsers =
        [
            new SandboxUser { Name="Taylor Brooks",  Initials="TB", Role="New CSR",          JoinedDate="Jun 10" },
            new SandboxUser { Name="Morgan Lee",     Initials="ML", Role="Onboarding Producer",JoinedDate="Jun 11" },
            new SandboxUser { Name="Jordan Rivera",  Initials="JR", Role="Trainee Adjuster",  JoinedDate="Jun 11" },
        ];
    }

    private async Task EnableSandbox()
    {
        _sandboxEnabled = true;
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = "Sandbox mode enabled. Sample data is being loaded.", CssClass = "enterprise-toast-success" });
    }

    private async Task DisableSandbox()
    {
        _sandboxEnabled = false;
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = "Sandbox mode disabled.", CssClass = "enterprise-toast-warning" });
    }

    private async Task ResetSandbox()
    {
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = "Sandbox data reset. Sample data has been reloaded.", CssClass = "enterprise-toast-info" });
    }

    private async Task PromoteUser(SandboxUser u)
    {
        _sandboxUsers.Remove(u);
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"{u.Name} promoted to production environment.", CssClass = "enterprise-toast-success" });
    }

    private sealed class SandboxUser { public string Name{get;set;}=string.Empty; public string Initials{get;set;}=string.Empty; public string Role{get;set;}=string.Empty; public string JoinedDate{get;set;}=string.Empty; }
}
