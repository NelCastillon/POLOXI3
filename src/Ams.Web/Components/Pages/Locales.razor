@page "/platform/locales"
@inject ApiClient Api

<PageTitle>Supported Locales</PageTitle>
<h1>Supported Locales</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(SupportedLocaleDto.LocaleCode)"     HeaderText="Code"        Width="90"></GridColumn>
        <GridColumn Field="@nameof(SupportedLocaleDto.LocaleName)"     HeaderText="Name"        Width="220"></GridColumn>
        <GridColumn Field="@nameof(SupportedLocaleDto.NativeName)"     HeaderText="Native Name" Width="220"></GridColumn>
        <GridColumn Field="@nameof(SupportedLocaleDto.CurrencyCode)"   HeaderText="Currency"    Width="90"></GridColumn>
        <GridColumn Field="@nameof(SupportedLocaleDto.CurrencySymbol)" HeaderText="Symbol"      Width="70"></GridColumn>
        <GridColumn Field="@nameof(SupportedLocaleDto.DateFormat)"     HeaderText="Date Format" Width="120"></GridColumn>
        <GridColumn Field="@nameof(SupportedLocaleDto.TimeFormat)"     HeaderText="Time Format" Width="110"></GridColumn>
        <GridColumn Field="@nameof(SupportedLocaleDto.IsRtl)"          HeaderText="RTL"         Width="70" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(SupportedLocaleDto.IsActive)"       HeaderText="Active"      Width="80" DisplayAsCheckBox="true"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private string? _searchTerm;
    private List<SupportedLocaleDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchSupportedLocalesAsync(_searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
