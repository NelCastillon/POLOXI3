@page "/finance/vendors"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Validation
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Vendors</PageTitle>

<AppPageHeader Title="Vendors"
               Subtitle="Manage vendor accounts and payment information"
               Icon="bi-shop">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "fa-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Vendor
        </button>
    </Actions>
</AppPageHeader>

<!-- ── Search & Filter ──────────────────────────────────────────────────── -->
<div class="fin-toolbar">
    <div class="fin-search-box">
        <i class="bi bi-search fin-search-icon" aria-hidden="true"></i>
        <input class="e-input fin-search-input"
               placeholder="Search vendors…"
               @bind="_searchTerm"
               @bind:event="oninput"
               @onkeyup="@(e => e.Key == "Enter" ? LoadAsync() : Task.CompletedTask)" />
    </div>
    <div class="fin-filter-buttons">
        <button class="um-btn um-btn-ghost um-btn-sm @(_filterActive ? "um-btn-active" : "")"
                @onclick="() => _filterActive = !_filterActive">
            <i class="bi bi-funnel" aria-hidden="true"></i> Filter
        </button>
    </div>
</div>

@if (_filterActive)
{
    <div class="fin-filter-panel">
        <div class="fin-filter-group">
            <label class="fin-filter-label">Vendor Type</label>
            <select class="e-input" @bind="_filterType">
                <option value="">All Types</option>
                <option value="Supplier">Supplier</option>
                <option value="Service Provider">Service Provider</option>
                <option value="Contractor">Contractor</option>
            </select>
        </div>
        <div class="fin-filter-group">
            <label class="fin-filter-label">Status</label>
            <select class="e-input" @bind="_filterStatus">
                <option value="">All</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
    </div>
}

<!-- ── KPI Cards ──────────────────────────────────────────────────────── -->
@if (_stats is not null)
{
    <div class="fin-kpi-strip">
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #dbeafe; color: #1d4ed8;"><i class="bi bi-shop-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.TotalVendors</div>
                <div class="fin-kpi-label">Total Vendors</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #d1fae5; color: #047857;"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.ActiveVendors</div>
                <div class="fin-kpi-label">Active</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #ede9fe; color: #6d28d9;"><i class="bi bi-currency-dollar" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.AveragePaymentDays</div>
                <div class="fin-kpi-label">Avg Payment Days</div>
            </div>
        </div>
    </div>
}

<!-- ── Content ──────────────────────────────────────────────────────── -->
@if (_error is not null)
{
    <div class="fin-alert fin-alert-warning">
        <div class="fin-alert-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></div>
        <div class="fin-alert-body">
            <div class="fin-alert-title">⚠️ Database Schema Issue</div>
            <p>Finance schema initialization required. Run: <strong>sql/01_Finance_Schema.sql</strong></p>
        </div>
    </div>
}
else if (_loading)
{
    <div class="fin-loading">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading Vendors…</span>
    </div>
}
else if (_items?.Count == 0)
{
    <div class="fin-empty-state">
        <i class="bi bi-inbox fin-empty-icon" aria-hidden="true"></i>
        <h3>No Vendors Found</h3>
        <p>@(_searchTerm != null ? $"No vendors match \"{_searchTerm}\"." : "No vendors have been created yet.")</p>
    </div>
}
else
{
    <div class="fin-grid-container">
        <SfGrid TValue="VendorDto" DataSource="_items" AllowPaging="true" AllowSorting="true" Height="600px">
            <GridEvents TValue="VendorDto" RowSelected="OnRowSelected" />
            <GridPageSettings PageSize="12"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(VendorDto.VendorCode)" HeaderText="Code" Width="100" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(VendorDto.VendorName)" HeaderText="Vendor Name" Width="220" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(VendorDto.VendorTypeCode)" HeaderText="Type" Width="120" AllowSorting="true">
                    <Template>
                        @{
                            var vendor = context as VendorDto;
                            var typeBg = vendor?.VendorTypeCode switch
                            {
                                "Supplier" => "#dbeafe",
                                "Service Provider" => "#ede9fe",
                                "Contractor" => "#d1fae5",
                                _ => "#f3f4f6"
                            };
                            var typeColor = vendor?.VendorTypeCode switch
                            {
                                "Supplier" => "#1d4ed8",
                                "Service Provider" => "#6d28d9",
                                "Contractor" => "#047857",
                                _ => "#6b7280"
                            };
                        }
                        <span style="background: @typeBg; color: @typeColor; padding: 4px 8px; border-radius: 20px; font-size: 0.85em; font-weight: 600;">
                            @vendor?.VendorTypeCode
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(VendorDto.PaymentTermsCode)" HeaderText="Payment Terms" Width="130" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(VendorDto.Email)" HeaderText="Email" Width="200"></GridColumn>
                <GridColumn Field="@nameof(VendorDto.StatusCode)" HeaderText="Status" Width="100" AllowSorting="true">
                    <Template>
                        @{
                            var vendor = context as VendorDto;
                        }
                        <span class="fin-badge @(vendor?.StatusCode == "Active" ? "fin-badge-success" : "fin-badge-secondary")">
                            @vendor?.StatusCode
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Actions" Width="90">
                    <Template>
                        @{ var vendor = (VendorDto)context; }
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenEdit(vendor)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
}

<SfDialog @bind-Visible="_showForm" Width="680px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-truck" aria-hidden="true"></i><span>@(_editingId == Guid.Empty ? "New Vendor" : "Edit Vendor")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Vendor Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.VendorCode" class="um-input" /><ValidationMessage For="() => _form.VendorCode" class="text-danger" /></div>
                    <div class="um-field"><label>Vendor Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.VendorName" class="um-input" /><ValidationMessage For="() => _form.VendorName" class="text-danger" /></div>
                    <div class="um-field"><label>Vendor Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.VendorTypeCode" class="um-input">@foreach (var type in _vendorTypes) { <option value="@type">@type</option> }</InputSelect><ValidationMessage For="() => _form.VendorTypeCode" class="text-danger" /></div>
                    <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input"><option value="Active">Active</option><option value="Inactive">Inactive</option></InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
                    <div class="um-field"><label>Payment Terms <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.PaymentTermsCode" class="um-input">@foreach (var terms in _paymentTerms) { <option value="@terms">@terms</option> }</InputSelect><ValidationMessage For="() => _form.PaymentTermsCode" class="text-danger" /></div>
                    <div class="um-field"><label>Currency <span class="text-danger">*</span></label><InputText @bind-Value="_form.CurrencyCode" class="um-input" /><ValidationMessage For="() => _form.CurrencyCode" class="text-danger" /></div>
                    <div class="um-field"><label>Contact Name</label><InputText @bind-Value="_form.ContactName" class="um-input" /><ValidationMessage For="() => _form.ContactName" class="text-danger" /></div>
                    <div class="um-field"><label>Email</label><InputText @bind-Value="_form.Email" class="um-input" /><ValidationMessage For="() => _form.Email" class="text-danger" /></div>
                    <div class="um-field"><label>Phone</label><InputText @bind-Value="_form.Phone" class="um-input" /><ValidationMessage For="() => _form.Phone" class="text-danger" /></div>
                    <div class="um-field"><label>Tax ID</label><InputText @bind-Value="_form.TaxId" class="um-input" /><ValidationMessage For="() => _form.TaxId" class="text-danger" /></div>
                    @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Vendor")</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private string _filterType = "";
    private string _filterStatus = "";
    private bool _filterActive = false;
    private bool _loading = false;
    private bool _showForm;
    private bool _saving;
    private List<VendorDto>? _items;
    private string? _error;
    private string? _formError;
    private Guid _editingId = Guid.Empty;
    private VendorForm _form = new();
    private EditContext _editContext = default!;
    private readonly List<string> _vendorTypes = ["Supplier", "Service Provider", "Contractor", "Carrier", "Other"];
    private readonly List<string> _paymentTerms = ["DueOnReceipt", "Net15", "Net30", "Net45", "Net60"];

    private class Stats
    {
        public int TotalVendors { get; set; }
        public int ActiveVendors { get; set; }
        public int AveragePaymentDays { get; set; }
    }

    private Stats? _stats;

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home", "/"),
            new("Finance", "/finance"),
            new("Vendors", "/finance/vendors"));
        _editContext = new(_form);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _items = null;
        try
        {
            var result = await Api.SearchVendorsAsync(_tenantId, _searchTerm);
            _items = result?.Items.ToList() ?? [];

            if (!string.IsNullOrEmpty(_filterType))
                _items = _items.Where(x => x.VendorTypeCode == _filterType).ToList();

            if (!string.IsNullOrEmpty(_filterStatus))
                _items = _items.Where(x => x.StatusCode == _filterStatus).ToList();

            _stats = new Stats
            {
                TotalVendors = _items.Count,
                ActiveVendors = _items.Count(x => x.StatusCode == "Active"),
                AveragePaymentDays = 30
            };
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            if (ex.Message.Contains("Invalid column name") || ex.Message.Contains("Vendor"))
            {
                _error = "Database schema mismatch. Please ensure 00_schema_migration.sql has been applied to your database. See db/README.md for setup instructions.";
            }
            _items = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnRowSelected(RowSelectEventArgs<VendorDto> args) => OpenEdit(args.Data);
    private void OpenCreate() { _editingId = Guid.Empty; _form = new(); _editContext = new(_form); _formError = null; _showForm = true; }
    private void OpenEdit(VendorDto vendor)
    {
        _editingId = vendor.VendorId;
        _form = new VendorForm { VendorCode = vendor.VendorCode, VendorName = vendor.VendorName, ContactName = vendor.ContactName, Email = vendor.Email, Phone = vendor.Phone, PaymentTermsCode = vendor.PaymentTermsCode, CurrencyCode = vendor.CurrencyCode, TaxId = vendor.TaxId, VendorTypeCode = vendor.VendorTypeCode, StatusCode = vendor.StatusCode };
        _editContext = new(_form);
        _formError = null;
        _showForm = true;
    }
    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        if (!_editContext.Validate()) return;
        _saving = true;
        try
        {
            if (_editingId == Guid.Empty)
                await Api.CreateVendorAsync(new CreateVendorRequest { TenantId = _tenantId, VendorCode = _form.VendorCode, VendorName = _form.VendorName, ContactName = _form.ContactName, Email = _form.Email, Phone = _form.Phone, PaymentTermsCode = _form.PaymentTermsCode, CurrencyCode = _form.CurrencyCode, TaxId = _form.TaxId, VendorTypeCode = _form.VendorTypeCode, StatusCode = _form.StatusCode });
            else
                await Api.UpdateVendorAsync(_editingId, new UpdateVendorRequest { TenantId = _tenantId, VendorId = _editingId, VendorCode = _form.VendorCode, VendorName = _form.VendorName, ContactName = _form.ContactName, Email = _form.Email, Phone = _form.Phone, PaymentTermsCode = _form.PaymentTermsCode, CurrencyCode = _form.CurrencyCode, TaxId = _form.TaxId, VendorTypeCode = _form.VendorTypeCode, StatusCode = _form.StatusCode });
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
        }
        finally { _saving = false; }
    }

    private sealed class VendorForm
    {
        [Required, StringLength(50)] public string VendorCode { get; set; } = string.Empty;
        [Required, StringLength(200)] public string VendorName { get; set; } = string.Empty;
        [StringLength(150)] public string? ContactName { get; set; }
        [AmsEmailAddress, StringLength(254)] public string? Email { get; set; }
        [AmsPhone, StringLength(50)] public string? Phone { get; set; }
        [Required, StringLength(50)] public string PaymentTermsCode { get; set; } = "Net30";
        [Required, StringLength(3)] public string CurrencyCode { get; set; } = "USD";
        [StringLength(50)] public string? TaxId { get; set; }
        [Required, StringLength(80)] public string VendorTypeCode { get; set; } = "Supplier";
        [Required, StringLength(50)] public string StatusCode { get; set; } = "Active";
    }
}
