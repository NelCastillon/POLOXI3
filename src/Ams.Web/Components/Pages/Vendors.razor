@page "/finance/vendors"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Common.Validation
@using Ams.Application.Features.Finance
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Vendors - AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="ve-toast ve-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="ve-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showStatusConfirm && _statusTarget is not null && !string.IsNullOrWhiteSpace(_pendingStatus))
{
    <div class="ve-modal-backdrop" role="presentation" @onclick="CancelStatusUpdate">
        <div class="ve-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="ve-status-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon @(_pendingStatus == "Inactive" ? "um-confirm-icon--danger" : null)"><i class="bi @(_pendingStatus == "Active" ? "bi-check-circle" : "bi-pause-circle")"></i></div>
                <div class="um-confirm-title" id="ve-status-title">@(_pendingStatus == "Active" ? "Activate Vendor" : "Deactivate Vendor")</div>
                <div class="um-confirm-body">@(_pendingStatus == "Active" ? "Activate" : "Deactivate") <strong>@_statusTarget.VendorName</strong> for accounts payable workflows?</div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CancelStatusUpdate" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn @(_pendingStatus == "Active" ? "um-btn-primary" : "um-btn-danger")" @onclick="ExecuteStatusUpdateAsync" disabled="@_busy">@(_pendingStatus == "Active" ? "Activate" : "Deactivate")</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="ve-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="ve-modal ve-action-modal" role="dialog" aria-modal="true" aria-labelledby="ve-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-shop" aria-hidden="true"></i>
                <span id="ve-form-title">@(_editingId == Guid.Empty ? "New Vendor" : "Edit Vendor")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="ve-modal-intro"><span><i class="bi bi-shield-check" aria-hidden="true"></i> Vendor master workflow</span><p>Maintain payment terms, contact information, tax identifiers, and AP status for synchronized finance workflows.</p></div>
                    <div class="um-form-grid">
                        <div class="um-field"><label>Vendor Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.VendorCode" class="form-control" /></div>
                        <div class="um-field"><label>Vendor Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.VendorName" class="form-control" /></div>
                        <div class="um-field"><label>Vendor Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.VendorTypeCode" class="form-select">@foreach (var type in _vendorTypes) { <option value="@type">@type</option> }</InputSelect></div>
                        <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="form-select">@foreach (var status in _statuses) { <option value="@status">@status</option> }</InputSelect></div>
                        <div class="um-field"><label>Payment Terms <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.PaymentTermsCode" class="form-select">@foreach (var terms in _paymentTerms) { <option value="@terms">@terms</option> }</InputSelect></div>
                        <div class="um-field"><label>Currency <span class="text-danger">*</span></label><InputText @bind-Value="_form.CurrencyCode" class="form-control" /></div>
                        <div class="um-field"><label>Contact Name</label><InputText @bind-Value="_form.ContactName" class="form-control" /></div>
                        <div class="um-field"><label>Email</label><InputText @bind-Value="_form.Email" class="form-control" /></div>
                        <div class="um-field"><label>Phone</label><InputText type="tel" @bind-Value="_form.Phone" class="form-control" placeholder="(555) 123-4567" inputmode="tel" autocomplete="tel" /><small class="text-muted">Use enterprise phone format: (555) 123-4567 or +1 555 123 4567 x123.</small></div>
                        <div class="um-field"><label>Tax ID</label><InputText @bind-Value="_form.TaxId" class="form-control" /></div>
                        @if (!string.IsNullOrWhiteSpace(_formError))
                        {
                            <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">@if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } @(_editingId == Guid.Empty ? "Create Vendor" : "Save Changes")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="ve-enterprise-page">
    <section class="ve-header">
        <div class="ve-header-left">
            <div class="ve-lob-icon"><i class="bi bi-shop" aria-hidden="true"></i></div>
            <div class="ve-header-info">
                <div class="ve-title-row"><h1 class="ve-page-title">Vendors</h1><span class="ve-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live vendor master</span><span class="ve-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span></div>
                <div class="ve-sub-row"><span>Manage vendor accounts, AP payment terms, tax data, and payable workflow readiness.</span><span class="ve-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Seed sync enabled</span><span class="ve-sub-chip"><i class="bi bi-check2-circle" aria-hidden="true"></i> @_filtered.Count active matches</span></div>
            </div>
        </div>
        <div class="ve-header-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/finance/ap-invoices")'><i class="bi bi-receipt" aria-hidden="true"></i> AP Invoices</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/finance/ap-payments")'><i class="bi bi-credit-card" aria-hidden="true"></i> Payments</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi @(_loading ? "bi-arrow-repeat ve-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync" disabled="@(!_filtered.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Vendor</button>
        </div>
    </section>

    <section class="ve-kpi-strip" aria-label="Vendor metrics">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="ve-kpi-card @kpi.Tone @(_kpiFilter == kpi.Filter ? "ve-kpi-active" : null)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)">
                <span class="ve-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span><span class="ve-kpi-copy"><span class="ve-kpi-label">@kpi.Label</span><span class="ve-kpi-value">@kpi.Value</span><span class="ve-kpi-caption">@kpi.Caption</span></span>
            </button>
        }
    </section>

    <section class="ve-workflow-strip" aria-label="Vendor workflow shortcuts">
        <button type="button" class="ve-workflow-card ve-wf-vendor" @onclick="OpenCreate"><span class="ve-workflow-icon"><i class="bi bi-shop" aria-hidden="true"></i></span><span class="ve-workflow-content"><strong>1</strong><span>Vendor</span><small>Register payees.</small></span></button>
        <button type="button" class="ve-workflow-card ve-wf-invoice" @onclick='() => Nav.NavigateTo("/finance/ap-invoices")'><span class="ve-workflow-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span><span class="ve-workflow-content"><strong>2</strong><span>Invoice</span><small>Capture payables.</small></span></button>
        <button type="button" class="ve-workflow-card ve-wf-payment" @onclick='() => Nav.NavigateTo("/finance/ap-payments")'><span class="ve-workflow-icon"><i class="bi bi-credit-card" aria-hidden="true"></i></span><span class="ve-workflow-content"><strong>3</strong><span>Payment</span><small>Schedule disbursement.</small></span></button>
        <button type="button" class="ve-workflow-card ve-wf-ledger" @onclick='() => Nav.NavigateTo("/finance/journalentries")'><span class="ve-workflow-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span><span class="ve-workflow-content"><strong>4</strong><span>Ledger</span><small>Post activity.</small></span></button>
        <button type="button" class="ve-workflow-card ve-wf-report" @onclick='() => Nav.NavigateTo("/analytics/finance")'><span class="ve-workflow-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span><span class="ve-workflow-content"><strong>5</strong><span>Analyze</span><small>Review spend.</small></span></button>
    </section>

    <section class="ve-enterprise-search" aria-label="Vendor filters">
        <div class="ve-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
        <div class="ve-search-body"><label for="ve-search">Search vendors</label><input id="ve-search" class="ve-search-input" type="search" placeholder="Search code, name, email, type, status..." @bind="SearchFilter" @bind:event="oninput" /><span class="ve-search-hint">Filters apply instantly across synchronized vendor records.</span></div>
        <select class="ve-filter-select" @bind="TypeFilter" aria-label="Vendor type filter"><option value="">All types</option>@foreach (var type in _vendorTypes) { <option value="@type">@type</option> }</select>
        <select class="ve-filter-select" @bind="StatusFilter" aria-label="Status filter"><option value="">All statuses</option>@foreach (var status in _statuses) { <option value="@status">@status</option> }</select>
        <div class="ve-search-result"><strong>@_filtered.Count</strong><span>matches</span></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger ve-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
    }

    <section class="ve-content-layout">
        <div class="ve-grid-wrap">
            <div class="ve-grid-toolbar"><div><strong>Vendor register</strong><span>@ActiveFilterText</span></div><div class="ve-toolbar-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-eraser" aria-hidden="true"></i> Reset</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/finance/ap-invoices")'><i class="bi bi-receipt" aria-hidden="true"></i> AP</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add</button></div></div>
            @if (_loading)
            {
                <div class="ve-loading"><i class="bi bi-arrow-repeat ve-spin" aria-hidden="true"></i><strong>Loading vendors...</strong><span>Syncing schema, seed data, and vendor master records.</span></div>
            }
            else if (!_filtered.Any())
            {
                <div class="ve-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No vendors found</strong><span>Adjust filters or create a new vendor.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">New Vendor</button></div>
            }
            else
            {
                <div class="ve-table-scroll"><table class="ve-table"><thead><tr><th>Vendor</th><th>Type</th><th>Terms</th><th>Contact</th><th>Status</th><th class="ve-actions-col">Actions</th></tr></thead><tbody>@foreach (var item in PagedItems) { <tr class="ve-table-row @(_selected?.VendorId == item.VendorId ? "ve-table-row--selected" : null)" @onclick="() => SelectVendor(item)"><td><div class="ve-entry-cell"><span class="ve-entry-icon @TypeIconTone(item.VendorTypeCode)"><i class="bi bi-shop" aria-hidden="true"></i></span><span><strong>@item.VendorName</strong><span>@item.VendorCode - @item.CurrencyCode</span></span></div></td><td><span class="ve-type-chip @TypeCss(item.VendorTypeCode)">@item.VendorTypeCode</span></td><td>@item.PaymentTermsCode</td><td><div class="ve-contact-cell"><strong>@(string.IsNullOrWhiteSpace(item.ContactName) ? "Not assigned" : item.ContactName)</strong><span>@(string.IsNullOrWhiteSpace(item.Email) ? item.Phone : item.Email)</span></div></td><td><span class="ve-status-chip @StatusCss(item.StatusCode)">@item.StatusCode</span></td><td><div class="ve-row-acts"><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Edit" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="@(item.StatusCode == "Active" ? "Deactivate" : "Activate")" @onclick:stopPropagation="true" @onclick='() => ConfirmStatusUpdate(item, item.StatusCode == "Active" ? "Inactive" : "Active")'><i class="bi @(item.StatusCode == "Active" ? "bi-pause-circle" : "bi-check-circle")" aria-hidden="true"></i></button></div></td></tr> }</tbody></table></div>
                <div class="ve-pager"><span>Showing @PageStart-@PageEnd of @_filtered.Count</span><div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PrevPage" disabled="@(_page == 1)">Previous</button><span>Page @_page of @TotalPages</span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button></div></div>
            }
        </div>
        <aside class="ve-detail-panel" aria-label="Selected vendor detail">
            @if (_selected is null)
            {
                <div class="ve-detail-empty"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a vendor</strong><span>Choose a row to inspect contact, terms, tax, and AP workflow readiness.</span></div>
            }
            else
            {
                <div class="ve-detail-head"><div><span class="ve-detail-eyebrow"><i class="bi bi-shop" aria-hidden="true"></i> Vendor master</span><h2>@_selected.VendorName</h2><div class="ve-detail-meta"><span>@_selected.VendorCode</span><span class="ve-status-chip @StatusCss(_selected.StatusCode)">@_selected.StatusCode</span></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></div>
                <div class="ve-detail-body"><div class="ve-detail-summary"><div class="ve-meta-row"><span class="ve-meta-lbl">Type</span><span class="ve-meta-val">@_selected.VendorTypeCode</span></div><div class="ve-meta-row"><span class="ve-meta-lbl">Payment Terms</span><span class="ve-meta-val">@_selected.PaymentTermsCode</span></div><div class="ve-meta-row"><span class="ve-meta-lbl">Currency</span><span class="ve-meta-val">@_selected.CurrencyCode</span></div><div class="ve-meta-row"><span class="ve-meta-lbl">Tax ID</span><span class="ve-meta-val">@(string.IsNullOrWhiteSpace(_selected.TaxId) ? "Not provided" : _selected.TaxId)</span></div></div><div class="ve-note-card"><span><i class="bi bi-person-lines-fill" aria-hidden="true"></i> Contact detail</span><p>@(string.IsNullOrWhiteSpace(_selected.ContactName) ? "No contact assigned" : _selected.ContactName) - @(string.IsNullOrWhiteSpace(_selected.Email) ? "No email" : _selected.Email) - @(string.IsNullOrWhiteSpace(_selected.Phone) ? "No phone" : _selected.Phone)</p></div><div class="ve-detail-actions"><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, _selected.StatusCode == "Active" ? "Inactive" : "Active")'><i class="bi @(_selected.StatusCode == "Active" ? "bi-pause-circle" : "bi-check-circle")" aria-hidden="true"></i> @(_selected.StatusCode == "Active" ? "Deactivate" : "Activate")</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/finance/ap-invoices")'><i class="bi bi-receipt" aria-hidden="true"></i> AP Invoices</button></div></div>
            }
        </aside>
    </section>
</div>

@code {
    private const int PageSize = 12;
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<VendorDto> _items = [];
    private List<VendorDto> _filtered = [];
    private VendorDto? _selected;
    private VendorDto? _statusTarget;
    private VendorForm _form = new();
    private Guid _editingId = Guid.Empty;
    private string _searchTerm = string.Empty;
    private string _typeFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private string _kpiFilter = "all";
    private string? _pendingStatus;
    private int _page = 1;
    private bool _loading;
    private bool _busy;
    private bool _showForm;
    private bool _showStatusConfirm;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string? _formError;
    private readonly List<string> _vendorTypes = ["Supplier", "Service Provider", "Contractor", "Carrier", "Other"];
    private readonly List<string> _paymentTerms = ["DueOnReceipt", "Net15", "Net30", "Net45", "Net60"];
    private readonly List<string> _statuses = ["Active", "Inactive"];

    private IEnumerable<VendorDto> PagedItems => _filtered.Skip((_page - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
    private int PageStart => _filtered.Count == 0 ? 0 : ((_page - 1) * PageSize) + 1;
    private int PageEnd => Math.Min(_filtered.Count, _page * PageSize);
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", "info" => "bi-info-circle-fill", _ => "bi-check-circle-fill" };
    private string ActiveFilterText => _kpiFilter == "all" ? "All vendor accounts" : $"Filtered by {_kpiFilter}";
    private int AveragePaymentDays => _items.Any() ? (int)Math.Round(_items.Average(x => PaymentDays(x.PaymentTermsCode))) : 0;
    private IReadOnlyList<KpiModel> Kpis =>
    [
        new("all", "Vendors", _items.Count.ToString("N0"), "All accounts", "bi-shop", "ve-ki-blue"),
        new("active", "Active", _items.Count(x => x.StatusCode == "Active").ToString("N0"), "Ready for AP", "bi-check-circle", "ve-ki-green"),
        new("inactive", "Inactive", _items.Count(x => x.StatusCode == "Inactive").ToString("N0"), "Paused payees", "bi-pause-circle", "ve-ki-amber"),
        new("supplier", "Suppliers", _items.Count(x => x.VendorTypeCode == "Supplier").ToString("N0"), "Goods vendors", "bi-box-seam", "ve-ki-blue"),
        new("service", "Services", _items.Count(x => x.VendorTypeCode == "Service Provider").ToString("N0"), "Service vendors", "bi-tools", "ve-ki-purple"),
        new("terms", "Avg Terms", AveragePaymentDays.ToString("N0"), "Payment days", "bi-calendar-check", "ve-ki-green")
    ];

    private string SearchFilter { get => _searchTerm; set { _searchTerm = value; ApplyFilters(resetPage: true); } }
    private string TypeFilter { get => _typeFilter; set { _typeFilter = value; ApplyFilters(resetPage: true); } }
    private string StatusFilter { get => _statusFilter; set { _statusFilter = value; ApplyFilters(resetPage: true); } }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Finance", "/finance"), new("Vendors", "/finance/vendors"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchVendorsAsync(_tenantId, string.Empty, 1, 500);
            _items = result?.Items.OrderBy(x => x.VendorName).ToList() ?? [];
            ApplyFilters(resetPage: true);
            EnsureSelectedStillVisible();
        }
        catch (Exception ex)
        {
            _loadError = $"Vendors failed to load: {ex.Message}";
            ShowToast(_loadError, "danger");
            _items = [];
            _filtered = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters(bool resetPage)
    {
        IEnumerable<VendorDto> query = _items;
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(x => Contains(x.VendorCode, term) || Contains(x.VendorName, term) || Contains(x.ContactName, term) || Contains(x.Email, term) || Contains(x.Phone, term) || Contains(x.VendorTypeCode, term) || Contains(x.StatusCode, term));
        }

        if (!string.IsNullOrWhiteSpace(_typeFilter)) query = query.Where(x => x.VendorTypeCode == _typeFilter);
        if (!string.IsNullOrWhiteSpace(_statusFilter)) query = query.Where(x => x.StatusCode == _statusFilter);
        query = _kpiFilter switch
        {
            "active" => query.Where(x => x.StatusCode == "Active"),
            "inactive" => query.Where(x => x.StatusCode == "Inactive"),
            "supplier" => query.Where(x => x.VendorTypeCode == "Supplier"),
            "service" => query.Where(x => x.VendorTypeCode == "Service Provider"),
            "terms" => query.Where(x => PaymentDays(x.PaymentTermsCode) >= 30),
            _ => query
        };

        _filtered = query.OrderBy(x => x.VendorName).ToList();
        if (resetPage) _page = 1;
        if (_page > TotalPages) _page = TotalPages;
    }

    private void SetKpiFilter(string filter) { _kpiFilter = filter; ApplyFilters(resetPage: true); }
    private void ResetFilters() { _searchTerm = string.Empty; _typeFilter = string.Empty; _statusFilter = string.Empty; _kpiFilter = "all"; ApplyFilters(resetPage: true); ShowToast("Vendor filters reset.", "info"); }
    private void SelectVendor(VendorDto item) => _selected = item;
    private void OpenCreate() { _editingId = Guid.Empty; _formError = null; _form = new VendorForm(); _showForm = true; }
    private void OpenEdit(VendorDto vendor) { _editingId = vendor.VendorId; _formError = null; _form = new VendorForm { VendorCode = vendor.VendorCode, VendorName = vendor.VendorName, ContactName = vendor.ContactName, Email = vendor.Email, Phone = vendor.Phone, PaymentTermsCode = vendor.PaymentTermsCode, CurrencyCode = vendor.CurrencyCode, TaxId = vendor.TaxId, VendorTypeCode = vendor.VendorTypeCode, StatusCode = vendor.StatusCode }; _showForm = true; }
    private void CloseForm() { if (_busy) return; _showForm = false; }

    private async Task SaveAsync()
    {
        _busy = true;
        _formError = null;
        try
        {
            if (_editingId == Guid.Empty)
            {
                await Api.CreateVendorAsync(new CreateVendorRequest { TenantId = _tenantId, VendorCode = _form.VendorCode, VendorName = _form.VendorName, ContactName = _form.ContactName, Email = _form.Email, Phone = _form.Phone, PaymentTermsCode = _form.PaymentTermsCode, CurrencyCode = _form.CurrencyCode.ToUpperInvariant(), TaxId = _form.TaxId, VendorTypeCode = _form.VendorTypeCode, StatusCode = _form.StatusCode, CreatedByUserId = _tenantAdminUserId });
                ShowToast("Vendor created.", "success");
            }
            else
            {
                await Api.UpdateVendorAsync(_editingId, new UpdateVendorRequest { TenantId = _tenantId, VendorId = _editingId, VendorCode = _form.VendorCode, VendorName = _form.VendorName, ContactName = _form.ContactName, Email = _form.Email, Phone = _form.Phone, PaymentTermsCode = _form.PaymentTermsCode, CurrencyCode = _form.CurrencyCode.ToUpperInvariant(), TaxId = _form.TaxId, VendorTypeCode = _form.VendorTypeCode, StatusCode = _form.StatusCode, ModifiedByUserId = _tenantAdminUserId });
                ShowToast("Vendor updated.", "success");
            }

            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
            ShowToast(_formError, "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void ConfirmStatusUpdate(VendorDto item, string status) { _statusTarget = item; _pendingStatus = status; _showStatusConfirm = true; }
    private void CancelStatusUpdate() { if (_busy) return; _showStatusConfirm = false; _statusTarget = null; _pendingStatus = null; }
    private async Task ExecuteStatusUpdateAsync()
    {
        if (_statusTarget is null || string.IsNullOrWhiteSpace(_pendingStatus)) return;
        _busy = true;
        try
        {
            await Api.UpdateVendorAsync(_statusTarget.VendorId, new UpdateVendorRequest { TenantId = _tenantId, VendorId = _statusTarget.VendorId, VendorCode = _statusTarget.VendorCode, VendorName = _statusTarget.VendorName, ContactName = _statusTarget.ContactName, Email = _statusTarget.Email, Phone = _statusTarget.Phone, PaymentTermsCode = _statusTarget.PaymentTermsCode, CurrencyCode = _statusTarget.CurrencyCode, TaxId = _statusTarget.TaxId, VendorTypeCode = _statusTarget.VendorTypeCode, StatusCode = _pendingStatus, ModifiedByUserId = _tenantAdminUserId });
            ShowToast($"Vendor marked {_pendingStatus.ToLowerInvariant()}.", "success");
            _showStatusConfirm = false;
            _statusTarget = null;
            _pendingStatus = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Update failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private Task NotifyValidationAsync(EditContext _) { ShowToast("Please correct validation errors before saving the vendor.", "warning"); return Task.CompletedTask; }
    private async Task ExportAsync()
    {
        if (!_filtered.Any()) { ShowToast("No vendors are available to export.", "warning"); return; }
        var csv = new StringBuilder();
        csv.AppendLine("VendorCode,VendorName,VendorType,PaymentTerms,Currency,ContactName,Email,Phone,TaxId,Status,VendorId");
        foreach (var item in _filtered) csv.AppendLine(string.Join(',', Csv(item.VendorCode), Csv(item.VendorName), Csv(item.VendorTypeCode), Csv(item.PaymentTermsCode), Csv(item.CurrencyCode), Csv(item.ContactName ?? string.Empty), Csv(item.Email ?? string.Empty), Csv(item.Phone ?? string.Empty), Csv(item.TaxId ?? string.Empty), Csv(item.StatusCode), Csv(item.VendorId.ToString())));
        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        await Js.InvokeVoidAsync("amsDownload.downloadBase64", $"vendors-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
        ShowToast($"Exported {_filtered.Count:N0} vendors.", "success");
    }

    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind) { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void EnsureSelectedStillVisible() => _selected = _selected is null ? _filtered.FirstOrDefault() : _items.FirstOrDefault(x => x.VendorId == _selected.VendorId) ?? _filtered.FirstOrDefault();
    private static int PaymentDays(string terms) => terms switch { "DueOnReceipt" => 0, "Net15" => 15, "Net30" => 30, "Net45" => 45, "Net60" => 60, _ => 30 };
    private static bool Contains(string? value, string term) => value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
    private static string StatusCss(string status) => $"ve-st-{status.ToLowerInvariant()}";
    private static string TypeCss(string type) => type switch { "Supplier" => "ve-ty-supplier", "Service Provider" => "ve-ty-service", "Contractor" => "ve-ty-contractor", "Carrier" => "ve-ty-carrier", _ => "ve-ty-other" };
    private static string TypeIconTone(string type) => type switch { "Supplier" => "ve-di-blue", "Service Provider" => "ve-di-purple", "Contractor" => "ve-di-green", "Carrier" => "ve-di-amber", _ => "ve-di-slate" };
    private static string Csv(string value) { var quote = Convert.ToChar(34).ToString(); return string.Concat(quote, value.Replace(quote, quote + quote), quote); }
    private async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; }
    private sealed record KpiModel(string Filter, string Label, string Value, string Caption, string Icon, string Tone) { public string Title => $"Filter vendors by {Label}"; }

    private sealed class VendorForm
    {
        [Required, StringLength(50)] public string VendorCode { get; set; } = string.Empty;
        [Required, StringLength(200)] public string VendorName { get; set; } = string.Empty;
        [StringLength(150)] public string? ContactName { get; set; }
        [AmsEmailAddress, StringLength(254)] public string? Email { get; set; }
        [AmsPhone, StringLength(50)] public string? Phone { get; set; }
        [Required, StringLength(50)] public string PaymentTermsCode { get; set; } = "Net30";
        [Required, StringLength(3)] public string CurrencyCode { get; set; } = "USD";
        [StringLength(50)] public string? TaxId { get; set; }
        [Required, StringLength(80)] public string VendorTypeCode { get; set; } = "Supplier";
        [Required, StringLength(50)] public string StatusCode { get; set; } = "Active";
    }
}