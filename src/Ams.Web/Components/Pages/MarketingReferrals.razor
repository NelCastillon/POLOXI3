@page "/marketing/referrals"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Referral Pipeline — AMS</PageTitle>

<AppPageHeader Title="Referral Pipeline"
               Subtitle="Track and grow referrals from clients, partners, and producers across all lines of business"
               Icon="bi-person-plus-fill">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="OpenAdd">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Log Referral
        </button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}

<!-- KPI -->
<div class="mkr-kpi-strip">
    <div class="mkr-kpi-card"><i class="bi bi-person-plus mkr-ki mkr-ki-blue"></i><div><div class="mkr-kv">@_referrals.Count</div><div class="mkr-kl">Total Referrals</div></div></div>
    <div class="mkr-kpi-card"><i class="bi bi-hourglass mkr-ki mkr-ki-amber"></i><div><div class="mkr-kv">@_referrals.Count(r => r.Status == "Pending")</div><div class="mkr-kl">Pending</div></div></div>
    <div class="mkr-kpi-card"><i class="bi bi-check-circle mkr-ki mkr-ki-green"></i><div><div class="mkr-kv">@_referrals.Count(r => r.Status == "Converted")</div><div class="mkr-kl">Converted</div></div></div>
    <div class="mkr-kpi-card"><i class="bi bi-percent mkr-ki mkr-ki-green"></i><div><div class="mkr-kv">@(_referrals.Any() ? (_referrals.Count(r => r.Status == "Converted") * 100m / _referrals.Count).ToString("N1") : "0")%</div><div class="mkr-kl">Conversion Rate</div></div></div>
    <div class="mkr-kpi-card"><i class="bi bi-cash-coin mkr-ki mkr-ki-green"></i><div><div class="mkr-kv">@_referrals.Where(r => r.Status == "Converted").Sum(r => r.EstimatedPremium).ToString("C0")</div><div class="mkr-kl">Premium Won</div></div></div>
</div>

<!-- Referral grid -->
<div class="mkr-grid-card app-datagrid">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading referrals…</span></div> }
    <SfGrid CssClass="marketing-grid" TValue="ReferralRow" DataSource="_referrals" AllowPaging="true" AllowSorting="true" AllowFiltering="true"
            AllowTextWrap="true" EnableHover="true" RowHeight="64">
        <GridTextWrapSettings WrapMode="WrapMode.Content" />
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
        <GridPageSettings PageSize="20" />
        <GridColumns>
            <GridColumn HeaderText="Prospect" MinWidth="320" Field="@nameof(ReferralRow.ProspectName)">
                <Template>
                    @{ var r = (ReferralRow)context; }
                    <div class="mkr-name-cell">
                        <div class="mkr-av">@(r.ProspectName.Length > 0 ? r.ProspectName[0] : '?')</div>
                        <div>
                            <div class="mkr-item-name">@r.ProspectName</div>
                            <div class="mkr-item-sub">@r.PolicyInterest</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(ReferralRow.ReferredBy)" HeaderText="Referred By" Width="200" />
            <GridColumn Field="@nameof(ReferralRow.ReferralType)" HeaderText="Source" Width="120">
                <Template>@{ var r = (ReferralRow)context; }<span class="mkr-src-badge @SrcCss(r.ReferralType)">@r.ReferralType</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(ReferralRow.ReceivedDate)" HeaderText="Received" Width="120" Type="ColumnType.Date" Format="MMM d, yyyy" />
            <GridColumn Field="@nameof(ReferralRow.Status)" HeaderText="Status" Width="120">
                <Template>@{ var r = (ReferralRow)context; }<span class="@RefStatusBadge(r.Status)">@r.Status</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(ReferralRow.EstimatedPremium)" HeaderText="Est. Premium" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>@{ var r = (ReferralRow)context; }<span class="mkr-mono">@r.EstimatedPremium.ToString("C0")</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(ReferralRow.Producer)" HeaderText="Producer" Width="170" />
            <GridColumn HeaderText="" Width="70" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>
                    <button class="um-btn um-btn-ghost um-btn-sm"><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<!-- Log referral dialog -->
<SfDialog @bind-Visible="_showAdd" Width="580px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-person-plus" aria-hidden="true"></i><span>Log Referral</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseAdd"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_addEditContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Prospect Name <span class="text-danger">*</span></label><InputText @bind-Value="_addForm.ProspectName" class="um-input" placeholder="Full name or business name" /><ValidationMessage For="() => _addForm.ProspectName" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Referred By <span class="text-danger">*</span></label><InputText @bind-Value="_addForm.ReferredBy" class="um-input" placeholder="Client or partner name" /><ValidationMessage For="() => _addForm.ReferredBy" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Referral Source</label><InputSelect @bind-Value="_addForm.ReferralType" class="um-input"><option>Client</option><option>Partner</option><option>Producer</option><option>Online</option><option>Other</option></InputSelect><ValidationMessage For="() => _addForm.ReferralType" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Policy Interest</label><InputText @bind-Value="_addForm.PolicyInterest" class="um-input" placeholder="e.g. Home + Auto, BOP" /><ValidationMessage For="() => _addForm.PolicyInterest" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Est. Premium</label><InputNumber @bind-Value="_addForm.EstimatedPremium" class="um-input" /><ValidationMessage For="() => _addForm.EstimatedPremium" class="validation-message text-danger" /></div>
                    @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button class="um-btn um-btn-ghost" @onclick="CloseAdd">Cancel</button><button class="um-btn um-btn-primary" @onclick="CommitAddAsync" disabled="@_saving"><i class="bi bi-check-lg" aria-hidden="true"></i> Save</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private bool _showAdd, _loading, _saving;
    private string? _loadError, _formError;
    private ReferralForm _addForm = new();
    private EditContext _addEditContext = default!;
    private List<ReferralRow> _referrals = [];

    protected override async Task OnInitializedAsync()
    {
        _addEditContext = new(_addForm);
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Marketing","/marketing/campaigns"), new("Referrals",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try
        {
            var result = await Api.SearchMarketingReferralsAsync(_tenantId);
            _referrals = result?.Items.Select(x => new ReferralRow(x.ProspectName, x.ReferredBy, x.ReferralType, x.ReceivedDate, x.StatusCode, x.PolicyInterest, x.EstimatedPremium, x.Producer)).ToList() ?? [];
        }
        catch (Exception ex) { _loadError = $"Failed to load referrals: {ex.Message}"; _referrals = []; }
        finally { _loading = false; }
    }

    private void OpenAdd() { _addForm = new(); _addEditContext = new(_addForm); _formError = null; _showAdd = true; }
    private void CloseAdd() => _showAdd = false;

    private async Task CommitAddAsync()
    {
        _formError = null;
        if (!_addEditContext.Validate()) return;
        _saving = true;
        try
        {
            await Api.CreateMarketingReferralAsync(new MarketingReferralDto { TenantId = _tenantId, ProspectName = _addForm.ProspectName, ReferredBy = _addForm.ReferredBy, ReferralType = _addForm.ReferralType, PolicyInterest = _addForm.PolicyInterest ?? string.Empty, EstimatedPremium = _addForm.EstimatedPremium, Producer = "Unassigned" });
            _showAdd = false;
            await LoadAsync();
        }
        catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; }
        finally { _saving = false; }
    }

    private static string SrcCss(string s) => s switch
    {
        "Client"  => "mkr-src mkr-src--client",
        "Partner" => "mkr-src mkr-src--partner",
        "Online"  => "mkr-src mkr-src--online",
        _         => "mkr-src",
    };
    private static string RefStatusBadge(string s) => s switch
    {
        "Converted" => "mkr-status mkr-st--conv",
        "Contacted" => "mkr-status mkr-st--cont",
        "Lost"      => "mkr-status mkr-st--lost",
        _           => "mkr-status mkr-st--pend",
    };

    private sealed record ReferralRow(string ProspectName, string ReferredBy, string ReferralType,
        DateTime ReceivedDate, string Status, string PolicyInterest, decimal EstimatedPremium, string Producer);

    private sealed class ReferralForm
    {
        [Required, StringLength(200)] public string ProspectName { get; set; } = string.Empty;
        [Required, StringLength(200)] public string ReferredBy { get; set; } = string.Empty;
        [Required, StringLength(80)] public string ReferralType { get; set; } = "Client";
        [StringLength(200)] public string? PolicyInterest { get; set; }
        [Range(0, 100000000)] public decimal EstimatedPremium { get; set; }
    }
}
