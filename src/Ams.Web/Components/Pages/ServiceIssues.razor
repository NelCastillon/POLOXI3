@page "/ops/issues"
@inject ApiClient Api

<PageTitle>Issue Tracker</PageTitle>
<h1>Issue Tracker</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(ServiceIssueDto.IssueNumber)"    HeaderText="Issue #"    Width="130"></GridColumn>
        <GridColumn Field="@nameof(ServiceIssueDto.Title)"          HeaderText="Title"      Width="280"></GridColumn>
        <GridColumn Field="@nameof(ServiceIssueDto.SeverityCode)"   HeaderText="Severity"   Width="110"></GridColumn>
        <GridColumn Field="@nameof(ServiceIssueDto.StatusCode)"     HeaderText="Status"     Width="120"></GridColumn>
        <GridColumn Field="@nameof(ServiceIssueDto.ResolvedDate)"   HeaderText="Resolved"   Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(ServiceIssueDto.CreatedDateUtc)" HeaderText="Created"    Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
    </GridColumns>
</SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<ServiceIssueDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchServiceIssuesAsync(_tenantId, searchTerm: _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
