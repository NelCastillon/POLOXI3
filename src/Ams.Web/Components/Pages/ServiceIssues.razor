@page "/ops/issues"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@using Ams.Application.Features.Operations

<PageTitle>Issue Tracker — Operations</PageTitle>
<AppPageHeader Title="Issue Tracker Administration" Subtitle="Tenant admin oversight for service issues by severity, owner, status, SLA risk, and resolution accountability" Icon="bi-bug">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New Issue</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </Actions>
</AppPageHeader>
<section class="ma-hero twf-hero">
    <div>
        <span class="ma-eyebrow">Tenant Administration · Issue Tracker</span>
        <h2>Tenant Issue Control Center</h2>
        <p>Administer tenant-wide service issues, severity, ownership, escalation, status, resolution dates, and SLA exposure.</p>
    </div>
    <div class="ma-hero-actions">
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/ops/service-requests")'><i class="bi bi-tools"></i> Service Requests</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/ops/activities")'><i class="bi bi-clock-history"></i> Activities</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/workflow")'><i class="bi bi-diagram-3"></i> Workflows</button>
    </div>
</section>
<div class="pc-kpi-strip">
    <div class="pc-kpi-card @(_filter == null ? "pc-kpi-card--active" : "")" @onclick="() => SetFilter(null)" title="All">
        <span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-bug-fill"></i></span>
        <div>
            <div class="pc-kpi-value">@_items.Count</div>
            <div class="pc-kpi-label">Total</div>
        </div>
    </div>
    <div class="pc-kpi-card @(_filter == "High" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("High")' title="High severity">
        <span class="pc-kpi-icon pc-kpi-icon--danger"><i class="bi bi-exclamation-octagon-fill"></i></span>
        <div>
            <div class="pc-kpi-value">@_items.Count(x => x.SeverityCode == "High")</div>
            <div class="pc-kpi-label">High</div>
        </div>
    </div>
    <div class="pc-kpi-card @(_filter == "Open" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Open")' title="Open">
        <span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-play-circle-fill"></i></span>
        <div>
            <div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Open")</div>
            <div class="pc-kpi-label">Open</div>
        </div>
    </div>
</div>
<AppFilterPanel @bind-SearchValue="_searchTerm" OnSearch="OnSearchAsync" SearchPlaceholder="Search issues…" />
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div> }
<div class="um-grid-card">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }
    <SfGrid TValue="ServiceIssueDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
        <GridEvents TValue="ServiceIssueDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" />
        <GridColumns>
            <GridColumn Field="IssueNumber" HeaderText="Issue #" Width="130" />
            <GridColumn Field="Title" HeaderText="Title" Width="280" />
            <GridColumn Field="SeverityCode" HeaderText="Severity" Width="110" />
            <GridColumn Field="StatusCode" HeaderText="Status" Width="120" />
            <GridColumn Field="ResolvedDate" HeaderText="Resolved" Type="ColumnType.Date" Format="d" Width="130" />
            <GridColumn Field="CreatedDateUtc" HeaderText="Created" Type="ColumnType.DateTime" Format="d" Width="130" />
            <GridColumn HeaderText="Actions" Width="120" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (ServiceIssueDto)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(r)" @onclick:stopPropagation="true" title="Edit"><i class="bi bi-pencil"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDelete(r)" @onclick:stopPropagation="true" title="Delete"><i class="bi bi-trash"></i></button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>
<SfDialog @bind-Visible="_showForm" Width="560px" IsModal="true" ShowCloseIcon="false">
    <DialogEvents Closed="ResetForm" />
    <DialogContent>
        <div class="um-modal-header">
            <i class="bi bi-bug"></i>
            <span>@(_editId.HasValue ? "Edit Issue" : "New Issue")</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="um-field">
                        <label>Issue # <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.IssueNumber" class="um-input" />
                        <ValidationMessage For="() => _form.IssueNumber" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Title <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.Title" class="um-input" />
                        <ValidationMessage For="() => _form.Title" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Severity <span class="text-danger">*</span></label>
                        <InputSelect @bind-Value="_form.SeverityCode" class="um-input">
                            <option>Low</option>
                            <option>Medium</option>
                            <option>High</option>
                        </InputSelect>
                        <ValidationMessage For="() => _form.SeverityCode" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Status <span class="text-danger">*</span></label>
                        <InputSelect @bind-Value="_form.StatusCode" class="um-input">
                            <option>Open</option>
                            <option>In Progress</option>
                            <option>Resolved</option>
                            <option>Closed</option>
                        </InputSelect>
                        <ValidationMessage For="() => _form.StatusCode" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Resolved Date</label>
                        <InputDate @bind-Value="_form.ResolvedDate" class="um-input" />
                        <ValidationMessage For="() => _form.ResolvedDate" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Account Name</label>
                        <SfDropDownList TValue="string" TItem="AccountOption" DataSource="_accounts" @bind-Value="_form.AccountIdText" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" ShowClearButton="true" Placeholder="Search account name" CssClass="um-input">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                        <ValidationMessage For="() => _form.AccountIdText" class="text-danger" />
                    </div>
                    <div class="um-field um-field--full">
                        <label>Description</label>
                        <InputTextArea @bind-Value="_form.Description" class="um-input" rows="3" />
                        <ValidationMessage For="() => _form.Description" class="text-danger" />
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button>
            </div>
        </EditForm>
    </DialogContent>
</SfDialog>
@if (_showDelete && _deleteTarget is not null)
{
    <div class="mt-modal-backdrop" @onclick="() => _showDelete = false">
        <div class="um-confirm-dialog mt-confirm" @onclick:stopPropagation="true">
            <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash"></i></div>
            <div class="um-confirm-title">Delete issue?</div>
            <div class="um-confirm-text">This will remove <strong>@_deleteTarget.Title</strong>.</div>
            <div class="um-modal-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button>
            </div>
        </div>
    </div>
}
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />
<style>
    @@keyframes um-shake {
        0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)}
    }
</style>
@code {
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    string? _searchTerm, _loadError, _filter;
    bool _loading, _saving, _showForm, _showDelete;
    Guid? _editId;
    ServiceIssueDto? _deleteTarget;
    List<ServiceIssueDto> _items = [], _filtered = [];
    List<AccountOption> _accounts = [];
    SfToast _toast = default!;
    IssueForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tasks & Workflows", "/tasks"), new("Issue Tracker", null));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await LoadAccountsAsync();
            var result = await Api.SearchServiceIssuesAsync(TenantId, searchTerm: _searchTerm);
            _items = result?.Items.ToList() ?? [];
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load issues: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    Task OnSearchAsync() => LoadAsync();
    void ApplyFilter() => _filtered = _filter switch { "High" => _items.Where(x => x.SeverityCode == "High").ToList(), "Open" => _items.Where(x => x.StatusCode == "Open").ToList(), _ => [.. _items] };
    void SetFilter(string? f) { _filter = f; ApplyFilter(); }
    void OnRowSelected(RowSelectEventArgs<ServiceIssueDto> args) => OpenEdit(args.Data);
    void OpenCreate()
    {
        _editId = null;
        _form = new() { IssueNumber = $"ISS-{DateTime.UtcNow:yyyyMMddHHmmss}" };
        _showForm = true;
    }
    void OpenEdit(ServiceIssueDto item)
    {
        _editId = item.IssueId;
        _form = new()
        {
            IssueNumber = item.IssueNumber,
            Title = item.Title,
            Description = item.Description,
            SeverityCode = item.SeverityCode,
            StatusCode = item.StatusCode,
            ResolvedDate = item.ResolvedDate,
            AccountIdText = item.AccountId?.ToString()
        };
        _showForm = true;
    }
    void ConfirmDelete(ServiceIssueDto item) { _deleteTarget = item; _showDelete = true; }
    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue)
                await Api.UpdateServiceIssueAsync(_editId.Value, new()
                {
                    IssueNumber = _form.IssueNumber,
                    Title = _form.Title,
                    Description = _form.Description,
                    SeverityCode = _form.SeverityCode,
                    StatusCode = _form.StatusCode,
                    ResolvedDate = _form.ResolvedDate,
                    AccountId = string.IsNullOrWhiteSpace(_form.AccountIdText) ? null : Guid.Parse(_form.AccountIdText),
                    ModifiedByUserId = TenantAdminUserId
                });
            else
                await Api.CreateServiceIssueAsync(new()
                {
                    TenantId = TenantId,
                    IssueNumber = _form.IssueNumber,
                    Title = _form.Title,
                    Description = _form.Description,
                    SeverityCode = _form.SeverityCode,
                    AccountId = string.IsNullOrWhiteSpace(_form.AccountIdText) ? null : Guid.Parse(_form.AccountIdText)
                });
            _showForm = false;
            await _toast.ShowAsync(new() { Content = _editId.HasValue ? "Issue updated" : "Issue created", CssClass = "e-toast-success" });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
        finally
        {
            _saving = false;
        }
    }
    async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        _saving = true;
        try
        {
            await Api.DeleteServiceIssueAsync(_deleteTarget.IssueId, TenantAdminUserId);
            _showDelete = false;
            await _toast.ShowAsync(new() { Content = "Issue deleted", CssClass = "e-toast-success" });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
        finally
        {
            _saving = false;
        }
    }
    void ResetForm() { _form = new(); _editId = null; }

    async Task LoadAccountsAsync()
    {
        if (_accounts.Count > 0) return;
        var result = await Api.SearchAccountsAsync(TenantId);
        _accounts = (result?.Items ?? []).OrderBy(x => x.AccountName).Select(x => new AccountOption(x.AccountId.ToString(), x.AccountName)).ToList();
    }

    sealed record AccountOption(string Value, string Label);

    sealed class IssueForm
    {
        [Required, StringLength(50)]
        public string IssueNumber { get; set; } = string.Empty;

        [Required, StringLength(200)]
        public string Title { get; set; } = string.Empty;

        [Required, StringLength(50)]
        public string SeverityCode { get; set; } = "Medium";

        [Required, StringLength(50)]
        public string StatusCode { get; set; } = "Open";

        public DateOnly? ResolvedDate { get; set; }

        public string? AccountIdText { get; set; }

        [StringLength(2000)]
        public string? Description { get; set; }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
