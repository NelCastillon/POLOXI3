@page "/ops/milestones"
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@using Ams.Application.Features.Engagements

<PageTitle>Milestones — Operations</PageTitle>
<AppPageHeader Title="Milestones Administration" Subtitle="Tenant admin oversight for operational milestones, due dates, completion, and delivery risk" Icon="bi-flag"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New Milestone</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<section class="ma-hero twf-hero"><div><span class="ma-eyebrow">Tenant Administration · Milestones</span><h2>Tenant Milestone Control Center</h2><p>Administer milestone delivery, overdue checkpoints, engagement dependencies, and completion risk across tenant operations.</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/engagements")'><i class="bi bi-briefcase"></i> Engagements</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/ops/activities")'><i class="bi bi-clock-history"></i> Activities</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/workflow")'><i class="bi bi-diagram-3"></i> Workflows</button></div></section>
<div class="pc-kpi-strip"><div class="pc-kpi-card @(_filter == null ? "pc-kpi-card--active" : "")" @onclick="() => SetFilter(null)" title="Show all"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-flag-fill"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total</div></div></div><div class="pc-kpi-card @(_filter == "Open" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Open")' title="Open"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-play-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Open")</div><div class="pc-kpi-label">Open</div></div></div><div class="pc-kpi-card @(_filter == "Overdue" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Overdue")' title="Overdue"><span class="pc-kpi-icon pc-kpi-icon--danger"><i class="bi bi-alarm-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(IsOverdue)</div><div class="pc-kpi-label">Overdue</div></div></div></div>
<AppFilterPanel @bind-SearchValue="_searchTerm" OnSearch="OnSearchAsync" SearchPlaceholder="Search milestones…" />
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div> }
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }<SfGrid TValue="EngagementMilestoneDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52"><GridEvents TValue="EngagementMilestoneDto" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" /><GridColumns><GridColumn Field="MilestoneName" HeaderText="Milestone" Width="260" /><GridColumn Field="EngagementId" HeaderText="Engagement Id" Width="250" /><GridColumn Field="DueDate" HeaderText="Due Date" Type="ColumnType.Date" Format="d" Width="130" /><GridColumn Field="CompletedDate" HeaderText="Completed" Type="ColumnType.Date" Format="d" Width="130" /><GridColumn Field="StatusCode" HeaderText="Status" Width="120" /><GridColumn Field="CreatedDateUtc" HeaderText="Created" Type="ColumnType.DateTime" Format="d" Width="130" /></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="560px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm" /><DialogContent><div class="um-modal-header"><i class="bi bi-flag"></i><span>New Milestone</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Engagement Id <span class="text-danger">*</span></label><InputText @bind-Value="_form.EngagementIdText" class="um-input" /><ValidationMessage For="() => _form.EngagementIdText" class="text-danger" /></div><div class="um-field"><label>Milestone <span class="text-danger">*</span></label><InputText @bind-Value="_form.MilestoneName" class="um-input" /><ValidationMessage For="() => _form.MilestoneName" class="text-danger" /></div><div class="um-field"><label>Due Date</label><InputDate @bind-Value="_form.DueDate" class="um-input" /><ValidationMessage For="() => _form.DueDate" class="text-danger" /></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Create</button></div></EditForm></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" /><style>@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }</style>
@code { static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001"); string? _searchTerm, _loadError, _filter; bool _loading, _saving, _showForm; List<EngagementMilestoneDto> _items = [], _filtered = []; SfToast _toast = default!; MilestoneForm _form = new(); protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tasks & Workflows", "/tasks"), new("Milestones", null)); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchEngagementMilestonesAsync(TenantId, searchTerm: _searchTerm); _items = result?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = $"Failed to load milestones: {ex.Message}"; } finally { _loading = false; } } Task OnSearchAsync() => LoadAsync(); void ApplyFilter() => _filtered = _filter switch { "Open" => _items.Where(x => x.StatusCode == "Open").ToList(), "Overdue" => _items.Where(IsOverdue).ToList(), _ => [.. _items] }; void SetFilter(string? f) { _filter = f; ApplyFilter(); } void OnRowSelected(RowSelectEventArgs<EngagementMilestoneDto> args) { } void OpenCreate() { _form = new(); _showForm = true; } async Task SaveAsync() { _saving = true; try { await Api.CreateEngagementMilestoneAsync(new() { TenantId = TenantId, EngagementId = Guid.Parse(_form.EngagementIdText), MilestoneName = _form.MilestoneName, DueDate = _form.DueDate }); _showForm = false; await _toast.ShowAsync(new() { Content = "Milestone created", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } void ResetForm() => _form = new(); static bool IsOverdue(EngagementMilestoneDto x) => x.CompletedDate is null && x.DueDate.HasValue && x.DueDate.Value < DateOnly.FromDateTime(DateTime.Today); sealed class MilestoneForm { [Required, RegularExpression("^[0-9a-fA-F-]{36}$", ErrorMessage = "Enter a valid Engagement Id.")] public string EngagementIdText { get; set; } = string.Empty; [Required, StringLength(200)] public string MilestoneName { get; set; } = string.Empty; public DateOnly? DueDate { get; set; } } }
