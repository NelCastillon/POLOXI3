    sealed record TabDef(string Key, string Label, string Icon);
    sealed record ActionMenuItem(string Text, string IconCss);

    sealed class AccountRow
    {
        public Guid AccountId { get; set; }
        public Guid TenantId { get; set; }
        public string AccountNumber { get; set; } = string.Empty;
        public string AccountName { get; set; } = string.Empty;
        public string AccountTypeCode { get; set; } = string.Empty;
        public string? MainEmail { get; set; }
        public string? MainPhone { get; set; }
        public string StatusCode { get; set; } = string.Empty;
        public string? SegmentCode { get; set; }
        public Guid? OwnerUserId { get; set; }
        public Guid? ParentAccountId { get; set; }
        public string? LifecycleStageCode { get; set; }
        public string? Industry { get; set; }
        public string? Website { get; set; }
        public decimal? AnnualRevenue { get; set; }
        public DateTime CreatedDateUtc { get; set; }
        public DateTime? ModifiedDateUtc { get; set; }

        public static AccountRow From(AccountDto dto) => new()
        {
            AccountId = dto.AccountId,
            TenantId = dto.TenantId,
            AccountNumber = dto.AccountNumber,
            AccountName = dto.AccountName,
            AccountTypeCode = NormalizeType(dto.AccountTypeCode),
            MainEmail = dto.MainEmail,
            MainPhone = dto.MainPhone,
            StatusCode = NormalizeStatus(dto.StatusCode, dto.AccountTypeCode),
            SegmentCode = dto.SegmentCode,
            OwnerUserId = dto.OwnerUserId,
            ParentAccountId = dto.ParentAccountId,
            LifecycleStageCode = dto.LifecycleStageCode,
            Industry = dto.Industry,
            Website = dto.Website,
            AnnualRevenue = dto.AnnualRevenue,
            CreatedDateUtc = dto.CreatedDateUtc == default ? DateTime.UtcNow : dto.CreatedDateUtc,
            ModifiedDateUtc = dto.ModifiedDateUtc
        };

        public AccountFormModel ToForm() => new()
        {
            AccountNumber = AccountNumber,
            AccountName = AccountName,
            AccountTypeCode = AccountTypeCode,
            MainEmail = MainEmail,
            MainPhone = MainPhone,
            StatusCode = StatusCode,
            SegmentCode = SegmentCode,
            LifecycleStageCode = LifecycleStageCode,
            Industry = Industry,
            Website = Website,
            AnnualRevenue = AnnualRevenue
        };

        static string NormalizeStatus(string? status, string? type) => status switch
        {
            null or "" when string.Equals(type, "PROSPECT", StringComparison.OrdinalIgnoreCase) => "Prospect",
            null or "" => "Active",
            "CLIENT" => "Active",
            _ => status
        };

        static string NormalizeType(string? type) => type switch
        {
            null or "" => "Commercial",
            "CLIENT" => "Commercial",
            "PROSPECT" => "Commercial",
            _ => type
        };
    }
}
