@page "/accounts"
@inject ApiClient Api

<PageTitle>Accounts</PageTitle>

<h1>Accounts</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(AccountDto.AccountNumber)"     HeaderText="Account #"      Width="130"></GridColumn>
            <GridColumn Field="@nameof(AccountDto.AccountName)"       HeaderText="Account Name"   Width="220"></GridColumn>
            <GridColumn Field="@nameof(AccountDto.AccountTypeCode)"   HeaderText="Type"           Width="110"></GridColumn>
            <GridColumn Field="@nameof(AccountDto.StatusCode)"        HeaderText="Status"         Width="100"></GridColumn>
            <GridColumn Field="@nameof(AccountDto.LifecycleStageCode)" HeaderText="Lifecycle"     Width="120"></GridColumn>
            <GridColumn Field="@nameof(AccountDto.SegmentCode)"       HeaderText="Segment"        Width="110"></GridColumn>
            <GridColumn Field="@nameof(AccountDto.Industry)"          HeaderText="Industry"       Width="140"></GridColumn>
            <GridColumn Field="@nameof(AccountDto.MainEmail)"         HeaderText="Email"          Width="200"></GridColumn>
            <GridColumn Field="@nameof(AccountDto.MainPhone)"         HeaderText="Phone"          Width="140"></GridColumn>
            <GridColumn Field="@nameof(AccountDto.AnnualRevenue)"     HeaderText="Annual Revenue" Width="140" Format="C2"></GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<AccountDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchAccountsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
