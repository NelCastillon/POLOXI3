@page "/accounts"
@namespace Ams.Web.Components.Pages.AccountPages
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Accounts
@using Ams.Web.Components.Pages.Accounts

<PageTitle>Accounts Dashboard — AMS</PageTitle>

<AppPageHeader Title="Accounts Dashboard"
               Subtitle="Account command center for customer, prospect, and household records"
               Icon="bi-people">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/accounts/new")'><i class="bi bi-plus-lg"></i> New Account</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </Actions>
</AppPageHeader>

<section class="ma-hero acct-hero">
    <div>
        <span class="ma-eyebrow">Accounts & Customers</span>
        <h2>Account Operations Workspace</h2>
        <p>Search, segment, and manage customer master records, lifecycle stages, hierarchy links, and account intelligence.</p>
    </div>
    <div class="ma-hero-actions">
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/accounts/new")'><i class="bi bi-plus-lg"></i> Create Account</button>
        <button class="um-btn um-btn-ghost" @onclick='() => SetFilter("prospect")'><i class="bi bi-person-plus"></i> Prospects</button>
    </div>
</section>

<div class="pc-kpi-strip acct-kpi-strip">
    <div class="pc-kpi-card @(_activeFilter is null ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter(null)' title="Show all accounts"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-building"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Accounts</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "active" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("active")' title="Filter active accounts"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Active")</div><div class="pc-kpi-label">Active</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "prospect" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("prospect")' title="Filter prospects"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-person-plus"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Prospect" || x.LifecycleStageCode == "Prospect")</div><div class="pc-kpi-label">Prospects</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "enterprise" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("enterprise")' title="Filter enterprise accounts"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-gem"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.SegmentCode == "Enterprise")</div><div class="pc-kpi-label">Enterprise</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "revenue" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("revenue")' title="Filter accounts over $1M revenue"><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-cash-coin"></i></span><div><div class="pc-kpi-value">@_items.Count(x => (x.AnnualRevenue ?? 0) >= 1000000)</div><div class="pc-kpi-label">$1M+ Revenue</div></div></div>
</div>

<div class="ma-filter-bar acct-filter-bar">
    <div class="ma-search-wrap"><i class="bi bi-search"></i><input class="ma-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search account name, number, email, phone, industry…" /></div>
    <div class="ma-type-pills">
        <button class="ma-pill @(_activeFilter is null ? "ma-pill-active" : "")" @onclick='() => SetFilter(null)'>All</button>
        <button class="ma-pill @(_activeFilter == "active" ? "ma-pill-active" : "")" @onclick='() => SetFilter("active")'>Active</button>
        <button class="ma-pill @(_activeFilter == "prospect" ? "ma-pill-active" : "")" @onclick='() => SetFilter("prospect")'>Prospect</button>
        <button class="ma-pill @(_activeFilter == "enterprise" ? "ma-pill-active" : "")" @onclick='() => SetFilter("enterprise")'>Enterprise</button>
        <button class="ma-pill @(_activeFilter == "revenue" ? "ma-pill-active" : "")" @onclick='() => SetFilter("revenue")'>$1M+</button>
    </div>
    <select class="ma-filter-sel" @bind="_typeFilter" @bind:after="ApplyFilter"><option value="">All types</option>@foreach (var type in AccountPageConstants.Types) { <option value="@type">@type</option> }</select>
    <select class="ma-filter-sel" @bind="_segmentFilter" @bind:after="ApplyFilter"><option value="">All segments</option>@foreach (var segment in AccountPageConstants.Segments) { <option value="@segment">@segment</option> }</select>
    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button>
    <span class="ma-filter-count">@_filtered.Count accounts</span>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div>
}

<div class="um-grid-card">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading accounts…</span></div> }
    <SfGrid TValue="AccountDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="56">
        <GridEvents TValue="AccountDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" />
        <GridColumns>
            <GridColumn HeaderText="Account" MinWidth="240" Field="AccountName"><Template>@{ var a=(AccountDto)context; }<div class="acct-name-cell"><div class="acct-avatar">@AccountPageConstants.Initials(a.AccountName)</div><div><strong>@a.AccountName</strong><div class="text-muted">@a.AccountNumber · @(a.Industry ?? "No industry")</div></div></div></Template></GridColumn>
            <GridColumn Field="AccountTypeCode" HeaderText="Type" Width="125"><Template>@{ var a=(AccountDto)context; }<span class="um-badge um-badge-info">@a.AccountTypeCode</span></Template></GridColumn>
            <GridColumn Field="StatusCode" HeaderText="Status" Width="115"><Template>@{ var a=(AccountDto)context; }<span class="@AccountPageConstants.StatusBadge(a.StatusCode)">@a.StatusCode</span></Template></GridColumn>
            <GridColumn Field="SegmentCode" HeaderText="Segment" Width="130"><Template>@{ var a=(AccountDto)context; }@(a.SegmentCode ?? "—")</Template></GridColumn>
            <GridColumn Field="AnnualRevenue" HeaderText="Revenue" Width="130" TextAlign="TextAlign.Right"><Template>@{ var a=(AccountDto)context; }@(a.AnnualRevenue?.ToString("C0") ?? "—")</Template></GridColumn>
            <GridColumn Field="MainEmail" HeaderText="Email" Width="210"><Template>@{ var a=(AccountDto)context; }@(a.MainEmail ?? "—")</Template></GridColumn>
            <GridColumn Field="MainPhone" HeaderText="Phone" Width="140"><Template>@{ var a=(AccountDto)context; }@(a.MainPhone ?? "—")</Template></GridColumn>
            <GridColumn HeaderText="Actions" Width="150" TextAlign="TextAlign.Center"><Template>@{ var a=(AccountDto)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/accounts/{a.AccountId}")' @onclick:stopPropagation="true" title="360"><i class="bi bi-person-vcard"></i></button><button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/accounts/{a.AccountId}/hierarchy")' @onclick:stopPropagation="true" title="Hierarchy"><i class="bi bi-diagram-3"></i></button><button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDelete(a)" @onclick:stopPropagation="true" title="Delete"><i class="bi bi-trash"></i></button></Template></GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showDelete" Width="440px" IsModal="true" ShowCloseIcon="false"><DialogContent><div class="um-confirm-dialog"><div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash3-fill"></i></div><div class="um-confirm-message"><h6>Delete Account?</h6><p>You are about to delete <strong>@_deleteTarget?.AccountName</strong>. This action cannot be undone.</p></div><div class="um-modal-footer w-100"><button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button><button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div></div></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />

@code {
    List<AccountDto> _items = [], _filtered = [];
    string _search = string.Empty, _typeFilter = string.Empty, _segmentFilter = string.Empty;
    string? _activeFilter, _loadError;
    bool _loading, _saving, _showDelete;
    AccountDto? _deleteTarget;
    SfToast _toast = default!;

    protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Home", "/"), new("Accounts", "/accounts")); await LoadAsync(); }
    async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchAccountsAsync(AccountPageConstants.TenantId); _items = result?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = $"Failed to load accounts: {ex.Message}"; } finally { _loading = false; } }
    void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; ApplyFilter(); }
    void ApplyFilter() { var rows = _activeFilter switch { "active" => _items.Where(x => x.StatusCode == "Active"), "prospect" => _items.Where(x => x.StatusCode == "Prospect" || x.LifecycleStageCode == "Prospect"), "enterprise" => _items.Where(x => x.SegmentCode == "Enterprise"), "revenue" => _items.Where(x => (x.AnnualRevenue ?? 0) >= 1000000), _ => _items.AsEnumerable() }; _filtered = rows.Where(SearchMatches).Where(x => string.IsNullOrEmpty(_typeFilter) || x.AccountTypeCode == _typeFilter).Where(x => string.IsNullOrEmpty(_segmentFilter) || x.SegmentCode == _segmentFilter).ToList(); }
    bool SearchMatches(AccountDto a) { if (string.IsNullOrWhiteSpace(_search)) return true; var q = _search.Trim(); return a.AccountName.Contains(q, StringComparison.OrdinalIgnoreCase) || a.AccountNumber.Contains(q, StringComparison.OrdinalIgnoreCase) || (a.MainEmail?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) || (a.MainPhone?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) || (a.Industry?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false); }
    void SetFilter(string? key) { _activeFilter = key; ApplyFilter(); }
    void ResetFilters() { _activeFilter = null; _search = _typeFilter = _segmentFilter = string.Empty; ApplyFilter(); }
    void OnRowSelected(RowSelectEventArgs<AccountDto> args) => Nav.NavigateTo($"/accounts/{args.Data.AccountId}");
    void ConfirmDelete(AccountDto item) { _deleteTarget = item; _showDelete = true; }
    async Task ExecuteDeleteAsync() { _saving = true; try { await Api.DeleteAccountAsync(_deleteTarget!.AccountId); _showDelete = false; await _toast.ShowAsync(new() { Content = "Account deleted", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } }
}
