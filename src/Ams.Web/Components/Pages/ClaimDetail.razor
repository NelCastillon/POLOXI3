    private async Task RefreshAsync()
    {
        await LoadAsync();
        if (string.IsNullOrWhiteSpace(_loadError)) await ShowToast("Claim file refreshed.");
    }

    private bool MatchesActivityFilters(ClaimActivityDto activity)
    {
        var searchMatch = string.IsNullOrWhiteSpace(_activitySearch) || Contains(activity.Title, _activitySearch) || Contains(activity.Category, _activitySearch) || Contains(activity.Party, _activitySearch) || Contains(activity.Notes, _activitySearch) || Contains(activity.CreatedBy, _activitySearch);
        var typeMatch = string.IsNullOrWhiteSpace(_activityTypeFilter) || string.Equals(activity.ActivityType, _activityTypeFilter, StringComparison.OrdinalIgnoreCase);
        var kpiMatch = _activeFilter switch
        {
            "Activity" => true,
            "Tasks" => activity.ActivityType == "Task",
            "Notes" => activity.ActivityType == "Note" || activity.IsPinned,
            "Communication" or "Task" or "Reserve" or "Payment" or "Note" => activity.ActivityType == _activeFilter,
            _ => true
        };
        return searchMatch && typeMatch && kpiMatch;
    }

    private void ApplyKpi(KpiTile kpi)
    {
        _activeFilter = _activeFilter == kpi.Filter ? "All" : kpi.Filter;
        if (kpi.Filter == "Financials") _activeTab = "financials";
        else if (kpi.Filter == "Activity") _activeTab = "activity";
        else if (kpi.Filter == "Tasks") _activeTab = "followup";
        else if (kpi.Filter == "Notes") _activeTab = "notes";
        else _activeTab = "overview";
    }

    private void ApplyWorkflow(WorkflowLane lane)
    {
        _activeFilter = lane.Filter;
        _activityTypeFilter = lane.Filter is "Communication" or "Task" or "Reserve" or "Payment" or "Note" ? lane.Filter : string.Empty;
        _activeTab = lane.Tab;
    }

    private void SelectTab(string tab) => _activeTab = tab;
    private void ResetFilters() { _activitySearch = string.Empty; _activityTypeFilter = string.Empty; _activeFilter = "All"; }

    private void OpenActivityDialog(string activityType)
    {
        _activity = new ActivityForm { ActivityType = activityType, ActivityDate = DateTime.Today, Category = DefaultCategory(activityType), Title = DefaultTitle(activityType), DialogTitle = DialogTitle(activityType) };
        _showActivityDialog = true;
    }

    private void OpenCommunicationDialog() => OpenActivityDialog("Communication");
    private void OpenReserveDialog() => OpenActivityDialog("Reserve");
    private void OpenPaymentDialog() => OpenActivityDialog("Payment");
    private void OpenTaskDialog() => OpenActivityDialog("Task");
    private void OpenNoteDialog() => OpenActivityDialog("Note");

    private void CloseActivityDialog() => _showActivityDialog = false;

    private void OpenFollowUpDialog()
    {
        if (_claim is null) return;
        _followUp = new FollowUpForm { Priority = DisplayValue(_claim.Priority, "Standard"), FollowUpReason = _claim.FollowUpReason, FollowUpDueDate = _claim.FollowUpDueDate, IsSnoozed = _claim.IsSnoozed };
        _showFollowUpDialog = true;
    }

    private void CloseFollowUpDialog() => _showFollowUpDialog = false;

    private void OpenStatusDialog()
    {
        if (_claim is null) return;
        _statusForm = new StatusForm { Status = _claim.Status, Note = string.Empty };
        _showStatusDialog = true;
    }

    private void CloseStatusDialog() => _showStatusDialog = false;

    private async Task SaveActivityAsync()
    {
        if (_claim is null) return;
        _savingActivity = true;
        try
        {
            await Api.AddClaimActivityAsync(new CreateClaimActivityRequest { ClaimId = _claim.ClaimId, ActivityType = _activity.ActivityType, Title = _activity.Title, Category = _activity.Category, Party = _activity.Party, Notes = _activity.Notes, Amount = _activity.Amount, PriorAmount = _activity.PriorAmount, ActivityDate = _activity.ActivityDate.ToUniversalTime(), CreatedBy = "Tenant Admin", IsPinned = _activity.IsPinned });
            await LoadAsync();
            _showActivityDialog = false;
            await ShowToast($"{_activity.ActivityType} activity saved.");
        }
        catch (Exception ex) { await ShowToast($"Activity save failed: {ex.Message}", true); }
        finally { _savingActivity = false; }
    }

    private async Task SaveFollowUpAsync()
    {
        if (_claim is null) return;
        _savingFollowUp = true;
        try
        {
            await Api.UpdateClaimFollowUpAsync(_claim.ClaimId, new UpdateClaimFollowUpRequest { FollowUpReason = _followUp.FollowUpReason, Priority = _followUp.Priority, FollowUpDueDate = _followUp.FollowUpDueDate, IsSnoozed = _followUp.IsSnoozed, ModifiedByUserId = _userContext?.UserId });
            await Api.AddClaimActivityAsync(new CreateClaimActivityRequest { ClaimId = _claim.ClaimId, ActivityType = "Task", Title = "Follow-up updated", Category = _followUp.Priority, Party = _followUp.IsSnoozed ? "Snoozed" : "Active", Notes = _followUp.FollowUpReason ?? string.Empty, ActivityDate = (_followUp.FollowUpDueDate ?? DateTime.Today).ToUniversalTime(), CreatedBy = "Tenant Admin" });
            await LoadAsync();
            _showFollowUpDialog = false;
            await ShowToast("Follow-up updated.");
        }
        catch (Exception ex) { await ShowToast($"Follow-up update failed: {ex.Message}", true); }
        finally { _savingFollowUp = false; }
    }

    private async Task SaveStatusAsync()
    {
        if (_claim is null) return;
        _savingStatus = true;
        try
        {
            await Api.UpdateClaimStatusAsync(_claim.ClaimId, new UpdateClaimStatusRequest { Status = _statusForm.Status, ModifiedByUserId = _userContext?.UserId });
            await Api.AddClaimActivityAsync(new CreateClaimActivityRequest { ClaimId = _claim.ClaimId, ActivityType = _statusForm.Status is "Closed" ? "Closed" : _statusForm.Status is "Reopened" ? "Reopened" : "Status", Title = $"Status updated to {_statusForm.Status}", Category = "Status", Party = _claim.AccountName, Notes = _statusForm.Note, ActivityDate = DateTime.UtcNow, CreatedBy = "Tenant Admin" });
            await LoadAsync();
            _showStatusDialog = false;
            await ShowToast($"Claim status updated to {_statusForm.Status}.");
        }
        catch (Exception ex) { await ShowToast($"Status update failed: {ex.Message}", true); }
        finally { _savingStatus = false; }
    }

