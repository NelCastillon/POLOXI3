    private static string LobIcon(string lob) => lob switch { "General Liability" => "bi-shield-check", "Commercial Auto" => "bi-truck", "Commercial Property" => "bi-building", "Workers Comp" => "bi-person-fill-gear", "Umbrella" => "bi-umbrella", "Professional Liab." => "bi-briefcase", "Home/Dwelling" => "bi-house", "Personal Auto" => "bi-car-front", _ => "bi-shield-half" };
    private static string ActivityIcon(string type) => type switch { "Communication" => "bi-envelope", "Task" => "bi-list-check", "Reserve" => "bi-safe", "Payment" => "bi-cash-stack", "Note" => "bi-sticky", "Claimant" => "bi-people", "Coverage" => "bi-shield", "Legal" => "bi-gavel", "Investigation" => "bi-search", "Closed" => "bi-check-circle", "Reopened" => "bi-arrow-counterclockwise", "Status" => "bi-arrow-repeat", _ => "bi-circle" };
    private static string DefaultCategory(string type) => type switch { "Reserve" => "Reserve", "Payment" => "Payment", "Task" => "High", "Note" => "General", "Communication" => "Email", _ => type };
    private static string DefaultTitle(string type) => type switch { "Reserve" => "Update reserve", "Payment" => "Log payment", "Task" => "Add task", "Note" => "Add note", "Communication" => "Log communication", _ => $"{type} activity" };
    private static string DialogTitle(string type) => type switch { "Reserve" => "Update reserve", "Payment" => "Log payment", "Task" => "Add task", "Note" => "Add note", "Communication" => "Log communication", _ => $"Log {type.ToLowerInvariant()}" };

    private async Task ShowToast(string content, bool danger = false)
    {
        var toast = new ClaimToast(Guid.NewGuid(), content, danger ? "cd-toast-danger" : "cd-toast-success", danger ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill");
        _toasts.Add(toast);
        await InvokeAsync(StateHasChanged);
        _ = Task.Run(async () => { await Task.Delay(4500); await InvokeAsync(() => DismissToast(toast.Id)); });
    }

    private void DismissToast(Guid id) { _toasts.RemoveAll(t => t.Id == id); StateHasChanged(); }

    private sealed class ActivityForm
    {
        [Required, StringLength(50)] public string ActivityType { get; set; } = "Communication";
        [Required, StringLength(200)] public string Title { get; set; } = string.Empty;
        [StringLength(80)] public string Category { get; set; } = string.Empty;
        [StringLength(120)] public string Party { get; set; } = string.Empty;
        [StringLength(2000)] public string Notes { get; set; } = string.Empty;
        public decimal? Amount { get; set; }
        public decimal? PriorAmount { get; set; }
        [Required] public DateTime ActivityDate { get; set; } = DateTime.Today;
        public bool IsPinned { get; set; }
        public string DialogTitle { get; set; } = "Log activity";
    }

    private sealed class FollowUpForm
    {
        [StringLength(120)] public string? FollowUpReason { get; set; }
        [Required, StringLength(40)] public string Priority { get; set; } = "Standard";
        public DateTime? FollowUpDueDate { get; set; }
