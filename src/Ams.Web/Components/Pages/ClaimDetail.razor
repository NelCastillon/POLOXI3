    private static List<ClaimActivityDto> BuildSeedActivities(Guid claimId) =>
    [
        new() { ClaimActivityId = Guid.Parse("7c3a20d9-3db1-4b5a-9f9e-4c7c5d940301"), ClaimId = claimId, ActivityType = "Communication", Title = "Carrier adjuster update received", Category = "Email", Party = "Travelers Claims", Notes = "Adjuster confirmed liability investigation remains open pending witness statement and premises maintenance logs.", ActivityDate = DateTime.UtcNow.AddHours(-8), CreatedBy = "Amy Scott" },
        new() { ClaimActivityId = Guid.Parse("7c3a20d9-3db1-4b5a-9f9e-4c7c5d940302"), ClaimId = claimId, ActivityType = "Reserve", Title = "BI reserve increased", Category = "Medical / Liability", Party = "Travelers Indemnity", Notes = "Reserve increased after claimant treatment plan and wage-loss estimate were received.", Amount = 85000m, PriorAmount = 60000m, ActivityDate = DateTime.UtcNow.AddDays(-2), CreatedBy = "James Miller" },
        new() { ClaimActivityId = Guid.Parse("7c3a20d9-3db1-4b5a-9f9e-4c7c5d940303"), ClaimId = claimId, ActivityType = "Payment", Title = "Medical payment issued", Category = "Medical", Party = "Midwest Orthopedics", Notes = "Initial medical bill payment posted to claim ledger.", Amount = 13500m, PriorAmount = 0m, ActivityDate = DateTime.UtcNow.AddDays(-5), CreatedBy = "Claims Accounting" },
        new() { ClaimActivityId = Guid.Parse("7c3a20d9-3db1-4b5a-9f9e-4c7c5d940304"), ClaimId = claimId, ActivityType = "Task", Title = "Obtain witness statement", Category = "High", Party = "Sullivan Mfg. LLC", Notes = "Request written statement from CNC floor supervisor and security camera availability confirmation.", ActivityDate = DateTime.UtcNow.AddDays(2), CreatedBy = "Amy Scott" },
        new() { ClaimActivityId = Guid.Parse("7c3a20d9-3db1-4b5a-9f9e-4c7c5d940305"), ClaimId = claimId, ActivityType = "Coverage", Title = "Coverage position under review", Category = "Coverage", Party = "Travelers Coverage Unit", Notes = "GL occurrence form confirmed. Additional insured and vendor contract review pending.", ActivityDate = DateTime.UtcNow.AddDays(-9), CreatedBy = "Coverage Team", IsPinned = true },
