@page "/claims/{ClaimId:guid}"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Claims
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Nav
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject ApiClient Api

<PageTitle>@(_claim is null ? "Claim Detail" : $"{_claim.ClaimNumber} - Claim Detail")</PageTitle>

<div class="cd-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="cd-toast @toast.CssClass">
            <i class="bi @toast.Icon" aria-hidden="true"></i>
            <span>@toast.Content</span>
            <button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
    }
</div>

@if (_showActivityDialog && _claim is not null)
{
    <div class="cd-modal-backdrop" role="presentation" @onclick="CloseActivityDialog">
        <div class="cd-work-modal" role="dialog" aria-modal="true" aria-labelledby="activityTitle" @onclick:stopPropagation="true">
            <div class="cd-modal-header">
                <div class="cd-modal-title"><span class="cd-modal-icon"><i class="bi @ActivityIcon(_activity.ActivityType)" aria-hidden="true"></i></span><div><h2 id="activityTitle">@_activity.DialogTitle</h2><p>@_claim.ClaimNumber · @_claim.AccountName</p></div></div>
                <button type="button" class="cd-btn cd-btn-light" @onclick="CloseActivityDialog" disabled="@_savingActivity" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_activity" OnValidSubmit="SaveActivityAsync" OnInvalidSubmit="NotifyInvalidActivityAsync">
                <DataAnnotationsValidator />
                <div class="cd-modal-body">
                    <div class="cd-form-banner"><i class="bi bi-database-check" aria-hidden="true"></i><div><strong>DB-backed claim activity</strong><span>Entries are saved to the claim activity ledger and immediately refresh this dashboard.</span></div></div>
                    <div class="cd-form-grid">
                        <div class="cd-field"><label>Activity Type <span>*</span></label><InputSelect class="cd-input" @bind-Value="_activity.ActivityType">@foreach (var type in _activityTypes){<option value="@type">@type</option>}</InputSelect></div>
                        <div class="cd-field"><label>Category</label><InputText class="cd-input" @bind-Value="_activity.Category" placeholder="Coverage, Legal, Payment, Reserve" /></div>
                        <div class="cd-field cd-field-wide"><label>Title <span>*</span></label><InputText class="cd-input" @bind-Value="_activity.Title" placeholder="Summarize the activity" /></div>
                        <div class="cd-field"><label>Party / Payee</label><InputText class="cd-input" @bind-Value="_activity.Party" placeholder="Claimant, carrier, adjuster, payee" /></div>
                        <div class="cd-field"><label>Activity Date <span>*</span></label><InputDate class="cd-input" @bind-Value="_activity.ActivityDate" /></div>
                        <div class="cd-field"><label>Amount</label><InputNumber class="cd-input" @bind-Value="_activity.Amount" /></div>
                        <div class="cd-field"><label>Prior Amount</label><InputNumber class="cd-input" @bind-Value="_activity.PriorAmount" /></div>
                        <div class="cd-field cd-field-wide"><label>Notes</label><InputTextArea class="cd-input cd-textarea" @bind-Value="_activity.Notes" placeholder="Activity details, claim instructions, carrier notes, or audit context" /></div>
                        <label class="cd-check-row cd-field-wide"><InputCheckbox @bind-Value="_activity.IsPinned" /> <span>Pin as important note</span></label>
                    </div>
                </div>
                <div class="cd-modal-footer"><button type="button" class="cd-btn cd-btn-light" @onclick="CloseActivityDialog" disabled="@_savingActivity">Cancel</button><button type="submit" class="cd-btn cd-btn-blue" disabled="@_savingActivity"><i class="bi bi-check-lg" aria-hidden="true"></i> @(_savingActivity ? "Saving..." : "Save Activity")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showFollowUpDialog && _claim is not null)
{
    <div class="cd-modal-backdrop" role="presentation" @onclick="CloseFollowUpDialog">
        <div class="cd-work-modal cd-work-modal-sm" role="dialog" aria-modal="true" aria-labelledby="followUpTitle" @onclick:stopPropagation="true">
            <div class="cd-modal-header">
                <div class="cd-modal-title"><span class="cd-modal-icon"><i class="bi bi-bell" aria-hidden="true"></i></span><div><h2 id="followUpTitle">Update follow-up</h2><p>@_claim.ClaimNumber · @_claim.Priority priority</p></div></div>
                <button type="button" class="cd-btn cd-btn-light" @onclick="CloseFollowUpDialog" disabled="@_savingFollowUp" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_followUp" OnValidSubmit="SaveFollowUpAsync" OnInvalidSubmit="NotifyInvalidFollowUpAsync">
                <DataAnnotationsValidator />
                <div class="cd-modal-body">
                    <div class="cd-form-grid">
                        <div class="cd-field"><label>Priority <span>*</span></label><InputSelect class="cd-input" @bind-Value="_followUp.Priority">@foreach (var priority in _priorities){<option value="@priority">@priority</option>}</InputSelect></div>
                        <div class="cd-field"><label>Due Date</label><InputDate class="cd-input" @bind-Value="_followUp.FollowUpDueDate" /></div>
                        <div class="cd-field cd-field-wide"><label>Reason</label><InputText class="cd-input" @bind-Value="_followUp.FollowUpReason" placeholder="Coverage review, claimant contact, reserve review" /></div>
                        <label class="cd-check-row cd-field-wide"><InputCheckbox @bind-Value="_followUp.IsSnoozed" /> <span>Snooze this follow-up</span></label>
                    </div>
                </div>
                <div class="cd-modal-footer"><button type="button" class="cd-btn cd-btn-light" @onclick="CloseFollowUpDialog" disabled="@_savingFollowUp">Cancel</button><button type="submit" class="cd-btn cd-btn-blue" disabled="@_savingFollowUp"><i class="bi bi-check-lg" aria-hidden="true"></i> @(_savingFollowUp ? "Saving..." : "Save Follow-Up")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showStatusDialog && _claim is not null)
{
    <div class="cd-modal-backdrop" role="presentation" @onclick="CloseStatusDialog">
        <div class="cd-work-modal cd-work-modal-sm" role="dialog" aria-modal="true" aria-labelledby="statusTitle" @onclick:stopPropagation="true">
            <div class="cd-modal-header">
                <div class="cd-modal-title"><span class="cd-modal-icon"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span><div><h2 id="statusTitle">Update claim status</h2><p>@_claim.ClaimNumber · current status @_claim.Status</p></div></div>
                <button type="button" class="cd-btn cd-btn-light" @onclick="CloseStatusDialog" disabled="@_savingStatus" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_statusForm" OnValidSubmit="SaveStatusAsync" OnInvalidSubmit="NotifyInvalidStatusAsync">
                <DataAnnotationsValidator />
                <div class="cd-modal-body">
                    <div class="cd-form-grid">
                        <div class="cd-field cd-field-wide"><label>Status <span>*</span></label><InputSelect class="cd-input" @bind-Value="_statusForm.Status">@foreach (var status in _statuses){<option value="@status">@status</option>}</InputSelect></div>
                        <div class="cd-field cd-field-wide"><label>Status Note</label><InputTextArea class="cd-input cd-textarea" @bind-Value="_statusForm.Note" placeholder="Why is the claim status changing?" /></div>
                    </div>
                </div>
                <div class="cd-modal-footer"><button type="button" class="cd-btn cd-btn-light" @onclick="CloseStatusDialog" disabled="@_savingStatus">Cancel</button><button type="submit" class="cd-btn cd-btn-blue" disabled="@_savingStatus"><i class="bi bi-check-lg" aria-hidden="true"></i> @(_savingStatus ? "Updating..." : "Update Status")</button></div>
            </EditForm>
        </div>
    </div>
}

<div class="cd-enterprise-page">
    <section class="cd-hero">
        <div class="cd-hero-left">
            <div class="cd-hero-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></div>
            <div>
                <div class="cd-title-row"><h1>Claim Command Center</h1><span><i class="bi bi-building-check" aria-hidden="true"></i> @DisplayValue(_userContext?.TenantName, "Tenant workspace")</span><span><i class="bi bi-database-check" aria-hidden="true"></i> DB-backed</span></div>
                <p>Manage coverage, activity, reserves, payments, follow-up, claim status, and audit-sensitive workflow from one enterprise claim file.</p>
            </div>
        </div>
        <div class="cd-hero-actions">
            <button type="button" class="cd-btn cd-btn-ghost" @onclick="RefreshAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="cd-btn cd-btn-ghost" @onclick='() => Nav.NavigateTo("/claims")'><i class="bi bi-list-ul" aria-hidden="true"></i> Claims Register</button>
            <button type="button" class="cd-btn cd-btn-ghost" @onclick='() => Nav.NavigateTo("/claims/follow-up")'><i class="bi bi-list-check" aria-hidden="true"></i> Follow-Up Queue</button>
            <button type="button" class="cd-btn cd-btn-primary" @onclick="OpenCommunicationDialog" disabled="@(_claim is null)"><i class="bi bi-plus-lg" aria-hidden="true"></i> Log Activity</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="cd-error-banner"><i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i> @_loadError</div>
    }

    @if (_loading)
    {
        <div class="cd-main-card"><div class="cd-loading"><i class="bi bi-arrow-repeat cd-spin" aria-hidden="true"></i><strong>Loading claim file</strong><span>Synchronizing claim identity, activities, financial ledger, follow-up, and workflow state.</span></div></div>
    }
    else if (_claim is null)
    {
        <div class="cd-main-card"><div class="cd-empty-state"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><strong>Claim not found</strong><span>The requested claim file could not be loaded from the database.</span><button type="button" class="cd-btn cd-btn-blue" @onclick='() => Nav.NavigateTo("/claims")'><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Claims</button></div></div>
    }
    else
    {
        <section class="cd-claim-header">
            <div class="cd-claim-title">
                <i class="bi @LobIcon(_claim.Lob) cd-claim-icon" aria-hidden="true"></i>
                <div>
                    <div class="cd-claim-row"><h2>@_claim.ClaimNumber</h2><span class="@StatusClass(_claim.Status)">@_claim.Status</span><span class="@PriorityClass(_claim.Priority)">@DisplayValue(_claim.Priority, "Standard")</span>@if (_claim.IsLitigation){<span class="cd-flag-chip cd-flag-lit"><i class="bi bi-gavel" aria-hidden="true"></i> Litigation</span>}@if (_claim.HasSubrogation){<span class="cd-flag-chip cd-flag-sub"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Subrogation</span>}@if (_claim.IsCatastrophe){<span class="cd-flag-chip cd-flag-cat"><i class="bi bi-cloud-lightning" aria-hidden="true"></i> CAT @DisplayValue(_claim.CatCode, string.Empty)</span>}@if (_claim.IsDisputed){<span class="cd-flag-chip cd-flag-dis"><i class="bi bi-shield-exclamation" aria-hidden="true"></i> Disputed</span>}</div>
                    <div class="cd-claim-meta"><button type="button" @onclick='() => Nav.NavigateTo($"/accounts/{_claim.AccountId}")'><i class="bi bi-building" aria-hidden="true"></i>@_claim.AccountName</button><button type="button" @onclick='() => Nav.NavigateTo($"/policies/{_claim.PolicyId}")'><i class="bi bi-shield" aria-hidden="true"></i>@_claim.PolicyNumber</button><span><i class="bi bi-briefcase" aria-hidden="true"></i>@_claim.Lob</span><span><i class="bi bi-building-fill" aria-hidden="true"></i>@_claim.Carrier</span></div>
                </div>
            </div>
            <div class="cd-claim-actions"><button type="button" class="cd-btn cd-btn-light" @onclick="OpenFollowUpDialog"><i class="bi bi-bell" aria-hidden="true"></i> Follow-Up</button><button type="button" class="cd-btn cd-btn-light" @onclick="OpenStatusDialog"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Status</button><button type="button" class="cd-btn cd-btn-light" @onclick="OpenReserveDialog"><i class="bi bi-safe" aria-hidden="true"></i> Reserve</button><button type="button" class="cd-btn cd-btn-light" @onclick="OpenPaymentDialog"><i class="bi bi-cash-stack" aria-hidden="true"></i> Payment</button></div>
        </section>

        <section class="cd-kpi-strip" aria-label="Claim KPI filters">
            @foreach (var kpi in Kpis)
            {
                <button type="button" class="@KpiClass(kpi)" title="@kpi.Title" @onclick="() => ApplyKpi(kpi)"><span class="cd-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span><span><strong>@kpi.Value</strong><small>@kpi.Label</small><em>@kpi.Detail</em></span></button>
            }
        </section>

        @if (NeedsAttention)
        {
            <div class="cd-attention-alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><div><strong>Action needed:</strong> @AttentionMessage</div><button type="button" class="cd-btn cd-btn-danger" @onclick="OpenFollowUpDialog"><i class="bi bi-bell" aria-hidden="true"></i> Update Follow-Up</button></div>
        }

        <section class="cd-workflow-strip" aria-label="Claim workflow actions">
            @foreach (var lane in WorkflowLanes)
            {
                <button type="button" class="@WorkflowClass(lane)" title="@lane.Title" @onclick="() => ApplyWorkflow(lane)"><i class="bi @lane.Icon" aria-hidden="true"></i><span><strong>@lane.Label</strong><small>@lane.Count item(s) · @lane.Detail</small></span></button>
            }
        </section>

        <section class="cd-search-panel">
            <div class="cd-search-wrap"><span class="cd-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span><div class="cd-search-body"><label>Search claim activity</label><input class="cd-search-input" @bind="_activitySearch" @bind:event="oninput" placeholder="Title, category, party, notes, created by" /><span class="cd-search-hint">Filtered from @_activities.Count database activity record(s)</span></div></div>
            <select class="cd-filter-select" @bind="_activityTypeFilter"><option value="">All activity</option>@foreach (var type in ActivityTypes){<option value="@type">@type</option>}</select>
            <button type="button" class="cd-btn cd-btn-light" @onclick="ResetFilters"><i class="bi bi-x-circle" aria-hidden="true"></i> Reset</button>
            <div class="cd-search-result"><strong>@FilteredActivities.Count</strong><span>Visible</span></div>
        </section>

        <div class="cd-view-tabs" role="tablist" aria-label="Claim detail views"><button type="button" class="@TabClass("overview")" @onclick='() => SelectTab("overview")'><i class="bi bi-clipboard-data" aria-hidden="true"></i> Overview</button><button type="button" class="@TabClass("activity")" @onclick='() => SelectTab("activity")'><i class="bi bi-clock-history" aria-hidden="true"></i> Activity <strong>@FilteredActivities.Count</strong></button><button type="button" class="@TabClass("financials")" @onclick='() => SelectTab("financials")'><i class="bi bi-currency-dollar" aria-hidden="true"></i> Financials</button><button type="button" class="@TabClass("followup")" @onclick='() => SelectTab("followup")'><i class="bi bi-list-check" aria-hidden="true"></i> Workflow</button><button type="button" class="@TabClass("notes")" @onclick='() => SelectTab("notes")'><i class="bi bi-sticky" aria-hidden="true"></i> Notes <strong>@Notes.Count</strong></button></div>

        <section class="cd-content-layout">
            <div class="cd-main-card">
                <header class="cd-card-head"><div><h2>@ActiveViewTitle</h2><p>@ActiveViewSubtitle</p></div><span>@_activeFilter</span></header>
                @if (_activeTab == "overview")
                {
                    <div class="cd-overview-grid">
                        <section class="cd-info-card"><header><i class="bi bi-fingerprint" aria-hidden="true"></i><strong>Claim Identity</strong></header><div class="cd-field-grid">@Info("Claim Number", _claim.ClaimNumber)@Info("Carrier Claim #", _claim.CarrierClaimNumber)@Info("Status", _claim.Status)@Info("Priority", DisplayValue(_claim.Priority,"Standard"))@Info("Loss Type", _claim.LossType)@Info("Cause", _claim.CauseOfLoss)@Info("CAT Code", _claim.CatCode)</div></section>
                        <section class="cd-info-card"><header><i class="bi bi-calendar-event" aria-hidden="true"></i><strong>Loss Details</strong></header><div class="cd-field-grid">@Info("Date of Loss", _claim.DateOfLoss.ToString("MM/dd/yyyy"))@Info("Date Reported", _claim.DateReported.ToString("MM/dd/yyyy"))@Info("Closed Date", _claim.ClosedDate?.ToString("MM/dd/yyyy"))@Info("Reporting Lag", $"{Math.Max((_claim.DateReported.Date - _claim.DateOfLoss.Date).Days, 0)} day(s)")@Info("Days Open", _claim.Status == "Closed" ? "Closed" : $"{_claim.DaysOpen} day(s)")@Info("State", _claim.StateOfLoss)@Info("Location", _claim.LossLocation)</div></section>
                        <section class="cd-info-card"><header><i class="bi bi-shield" aria-hidden="true"></i><strong>Policy & Insured</strong></header><div class="cd-field-grid">@Info("Named Insured", _claim.AccountName)@Info("Policy Number", _claim.PolicyNumber)@Info("LOB", _claim.Lob)@Info("Carrier", _claim.Carrier)@Info("Primary Claimant", _claim.PrimaryClaimant)@Info("Reported By", _claim.ReportedBy)</div></section>
                        <section class="cd-info-card"><header><i class="bi bi-person-badge" aria-hidden="true"></i><strong>Assignment</strong></header><div class="cd-field-grid">@Info("Handler", _claim.AssignedHandler)@Info("Follow-Up", _claim.FollowUpReason)@Info("Follow-Up Due", _claim.FollowUpDueDate?.ToString("MM/dd/yyyy"))@Info("Snoozed", _claim.IsSnoozed ? "Yes" : "No")@Info("Created", _claim.CreatedDateUtc.ToLocalTime().ToString("MM/dd/yyyy h:mm tt"))@Info("Modified", _claim.ModifiedDateUtc?.ToLocalTime().ToString("MM/dd/yyyy h:mm tt"))</div></section>
                        <section class="cd-info-card cd-info-wide"><header><i class="bi bi-card-text" aria-hidden="true"></i><strong>Loss Description</strong></header><p class="cd-loss-desc">@DisplayValue(_claim.LossDescription, "No loss description captured.")</p></section>
                    </div>
                }
                else if (_activeTab == "activity")
                {
                    <div class="cd-toolbar"><span>@FilteredActivities.Count activity record(s)</span><button type="button" class="cd-btn cd-btn-blue" @onclick="OpenCommunicationDialog"><i class="bi bi-plus-lg" aria-hidden="true"></i> Log Activity</button></div>
                    @if (!FilteredActivities.Any())
                    {
                        <div class="cd-empty-state"><i class="bi bi-inboxes" aria-hidden="true"></i><strong>No activity matches filters</strong><span>Adjust filters or log a new claim activity.</span></div>
                    }
                    else
                    {
                        <div class="cd-activity-ledger-card">
                            <header><div><strong>Activity ledger table</strong><span>Native enterprise table synchronized with the claim timeline.</span></div><span>@FilteredActivities.Count row(s)</span></header>
                            <div class="cd-table-scroll">
                                <table class="cd-table cd-activity-ledger-table">
                                    <thead>
                                        <tr><th>Date</th><th>Type</th><th>Title</th><th>Party</th><th class="text-end">Amount</th><th>Created By</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var activity in FilteredActivities.OrderByDescending(a => a.ActivityDate))
                                        {
                                            <tr>
                                                <td data-label="Date">@activity.ActivityDate.ToLocalTime().ToString("MM/dd/yyyy")</td>
                                                <td data-label="Type"><span class="@ActivityTypeClass(activity.ActivityType)">@activity.ActivityType</span></td>
                                                <td data-label="Title"><strong>@activity.Title</strong><small>@DisplayValue(activity.Category, "General")</small></td>
                                                <td data-label="Party">@DisplayValue(activity.Party, "—")</td>
                                                <td data-label="Amount" class="text-end"><strong>@((activity.Amount ?? 0).ToString("C0"))</strong></td>
                                                <td data-label="Created By">@DisplayValue(activity.CreatedBy, "Tenant Admin")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="cd-timeline">@foreach (var activity in FilteredActivities.OrderByDescending(a => a.ActivityDate)){<section class="cd-timeline-item"><div class="@TimelineIconClass(activity.ActivityType)"><i class="bi @ActivityIcon(activity.ActivityType)" aria-hidden="true"></i></div><div class="cd-timeline-body"><header><strong>@activity.Title</strong><span class="@ActivityTypeClass(activity.ActivityType)">@activity.ActivityType</span><em>@activity.ActivityDate.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</em></header><div class="cd-timeline-meta"><span>@DisplayValue(activity.Category,"General")</span>@if (!string.IsNullOrWhiteSpace(activity.Party)){<span>@activity.Party</span>}<span>@DisplayValue(activity.CreatedBy,"Tenant Admin")</span>@if (activity.Amount.HasValue){<span>@activity.Amount.Value.ToString("C0")</span>}</div>@if (!string.IsNullOrWhiteSpace(activity.Notes)){<p>@activity.Notes</p>}</div></section>}</div>
                    }
                }
                else if (_activeTab == "financials")
                {
                    <div class="cd-finance-grid">@FinanceMetric("Total Incurred", _claim.TotalIncurred, "bi-currency-dollar", "red")@FinanceMetric("Total Reserves", _claim.TotalReserves, "bi-safe", "amber")@FinanceMetric("Total Paid", _claim.TotalPaid, "bi-cash-stack", "green")@FinanceMetric("Outstanding", OutstandingAmount, "bi-receipt", OutstandingAmount > 0 ? "purple" : "green")</div>
                    <div class="cd-ledger-grid"><section class="cd-ledger-card"><header><i class="bi bi-safe" aria-hidden="true"></i><strong>Reserve Ledger</strong><button type="button" class="cd-btn cd-btn-light" @onclick="OpenReserveDialog"><i class="bi bi-plus-lg" aria-hidden="true"></i> Update Reserve</button></header>@LedgerTable(Reserves, "Reserve")</section><section class="cd-ledger-card"><header><i class="bi bi-cash-stack" aria-hidden="true"></i><strong>Payment Ledger</strong><button type="button" class="cd-btn cd-btn-light" @onclick="OpenPaymentDialog"><i class="bi bi-plus-lg" aria-hidden="true"></i> Log Payment</button></header>@LedgerTable(Payments, "Payment")</section></div>
                }
                else if (_activeTab == "followup")
                {
                    <div class="cd-workflow-board"><section class="cd-workflow-panel"><header><i class="bi bi-bell" aria-hidden="true"></i><strong>Follow-Up Control</strong><button type="button" class="cd-btn cd-btn-light" @onclick="OpenFollowUpDialog"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></header><div class="cd-followup-summary"><div><span>Reason</span><strong>@DisplayValue(_claim.FollowUpReason,"No follow-up reason")</strong></div><div><span>Priority</span><strong>@DisplayValue(_claim.Priority,"Standard")</strong></div><div><span>Due</span><strong>@(_claim.FollowUpDueDate?.ToString("MM/dd/yyyy") ?? "Not set")</strong></div><div><span>Snoozed</span><strong>@(_claim.IsSnoozed ? "Yes" : "No")</strong></div></div></section><section class="cd-workflow-panel"><header><i class="bi bi-list-check" aria-hidden="true"></i><strong>Open Tasks</strong><button type="button" class="cd-btn cd-btn-light" @onclick="OpenTaskDialog"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Task</button></header>@TaskList</section><section class="cd-workflow-panel"><header><i class="bi bi-arrow-repeat" aria-hidden="true"></i><strong>Status Control</strong><button type="button" class="cd-btn cd-btn-light" @onclick="OpenStatusDialog"><i class="bi bi-pencil" aria-hidden="true"></i> Update</button></header><div class="cd-status-flow">@foreach (var status in _statuses){<span class="@(string.Equals(status, _claim.Status, StringComparison.OrdinalIgnoreCase) ? "cd-flow-step cd-flow-active" : "cd-flow-step")">@status</span>}</div></section></div>
                }
                else
                {
                    <div class="cd-toolbar"><span>@Notes.Count note(s)</span><button type="button" class="cd-btn cd-btn-blue" @onclick="OpenNoteDialog"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Note</button></div>
                    @if (!Notes.Any())
                    {
                        <div class="cd-empty-state"><i class="bi bi-sticky" aria-hidden="true"></i><strong>No notes logged</strong><span>Add claim notes to capture coverage, legal, investigation, or settlement context.</span></div>
                    }
                    else
                    {
                        <div class="cd-note-list">@foreach (var note in Notes.OrderByDescending(n => n.IsPinned).ThenByDescending(n => n.ActivityDate)){<section class="@(note.IsPinned ? "cd-note-card cd-note-pinned" : "cd-note-card")"><header><span class="@NoteCategoryClass(note.Category)">@DisplayValue(note.Category,"General")</span>@if (note.IsPinned){<i class="bi bi-pin-angle-fill" aria-hidden="true"></i>}<em>@note.CreatedBy · @note.ActivityDate.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</em></header><p>@DisplayValue(note.Notes, note.Title)</p></section>}</div>
                    }
                }
            </div>

            <aside class="cd-detail-card">
                <div class="cd-detail-head"><span class="cd-detail-eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> Claim file</span><h2>@_claim.ClaimNumber</h2><p>@_claim.AccountName</p></div>
                <div class="cd-detail-body"><div class="cd-detail-summary"><div><span>Status</span><strong>@_claim.Status</strong></div><div><span>Priority</span><strong>@DisplayValue(_claim.Priority,"Standard")</strong></div><div><span>Incurred</span><strong>@_claim.TotalIncurred.ToString("C0")</strong></div><div><span>Open</span><strong>@(_claim.Status == "Closed" ? "Closed" : _claim.DaysOpen + "d")</strong></div></div><div class="cd-contact-card"><strong>@_claim.LossType</strong><span>@DisplayValue(_claim.LossLocation,"No loss location")</span><span>@DisplayValue(_claim.LossDescription,"No description captured.")</span></div><div class="cd-flag-grid">@FlagChip(_claim.IsLitigation,"Litigation","bi-gavel")@FlagChip(_claim.HasSubrogation,"Subrogation","bi-arrow-counterclockwise")@FlagChip(_claim.IsCatastrophe,"Catastrophe","bi-cloud-lightning")@FlagChip(_claim.IsDisputed,"Disputed","bi-shield-exclamation")</div><div class="cd-detail-actions"><button type="button" class="cd-btn cd-btn-blue" @onclick="OpenCommunicationDialog"><i class="bi bi-envelope" aria-hidden="true"></i> Log communication</button><button type="button" class="cd-btn cd-btn-light" @onclick="OpenNoteDialog"><i class="bi bi-sticky" aria-hidden="true"></i> Add note</button><button type="button" class="cd-btn cd-btn-light" @onclick="OpenFollowUpDialog"><i class="bi bi-bell" aria-hidden="true"></i> Update follow-up</button><button type="button" class="cd-btn cd-btn-light" @onclick='() => Nav.NavigateTo($"/accounts/{_claim.AccountId}")'><i class="bi bi-building" aria-hidden="true"></i> Open account</button><button type="button" class="cd-btn cd-btn-light" @onclick='() => Nav.NavigateTo($"/policies/{_claim.PolicyId}")'><i class="bi bi-shield" aria-hidden="true"></i> Open policy</button></div></div>
            </aside>
        </section>
    }
</div>

@code {
    [Parameter] public Guid ClaimId { get; set; }

