    private FollowUpForm _followUp = new();
    private StatusForm _statusForm = new();
    private readonly List<ClaimActivityDto> _activities = [];
    private readonly List<ClaimToast> _toasts = [];
    private readonly string[] _activityTypes = ["Communication", "Task", "Reserve", "Payment", "Note", "Claimant", "Coverage", "Legal", "Investigation"];
    private readonly string[] _priorities = ["Critical", "High", "Standard", "Medium", "Low"];
    private readonly string[] _statuses = ["Open", "Acknowledged", "Under Review", "Pending Info", "In Litigation", "Subrogation", "Denied", "Closed", "Reopened"];

    private List<ClaimActivityDto> FilteredActivities => _activities.Where(MatchesActivityFilters).ToList();
    private List<string> ActivityTypes => _activities.Select(a => a.ActivityType).Where(v => !string.IsNullOrWhiteSpace(v)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(v => v).DefaultIfEmpty("Communication").ToList();
    private List<ClaimActivityDto> Communications => _activities.Where(a => a.ActivityType == "Communication").ToList();
    private List<ClaimActivityDto> Tasks => _activities.Where(a => a.ActivityType == "Task").ToList();
    private List<ClaimActivityDto> Reserves => _activities.Where(a => a.ActivityType == "Reserve").ToList();
    private List<ClaimActivityDto> Payments => _activities.Where(a => a.ActivityType == "Payment").ToList();
    private List<ClaimActivityDto> Notes => _activities.Where(a => a.ActivityType == "Note" || a.IsPinned).ToList();
    private decimal OutstandingAmount => Math.Max((_claim?.TotalReserves ?? 0) - (_claim?.TotalPaid ?? 0), 0);
    private bool FollowUpOverdue => _claim?.FollowUpDueDate is DateTime due && due.Date < DateTime.Today && _claim.Status != "Closed" && !_claim.IsSnoozed;
    private bool NeedsAttention => _claim is not null && (FollowUpOverdue || _claim.IsLitigation || _claim.IsDisputed || OutstandingAmount > 0 && _claim.DaysOpen > 30);
    private string AttentionMessage => FollowUpOverdue ? "Follow-up is overdue and should be updated or snoozed." : _claim?.IsLitigation == true ? "Litigation flag is active; review legal notes and next tasks." : _claim?.IsDisputed == true ? "Dispute flag is active; document claim position and next action." : "Outstanding exposure remains open; review reserves, payments, and next follow-up.";
    private string ActiveViewTitle => _activeTab switch { "activity" => "Activity timeline", "financials" => "Financial command center", "followup" => "Workflow and follow-up", "notes" => "Pinned and claim notes", _ => "Claim overview" };
    private string ActiveViewSubtitle => _activeTab switch { "activity" => "Search and review all DB-backed claim activity, communications, tasks, reserves, payments, and notes.", "financials" => "Monitor incurred, reserve, paid, and outstanding exposure with reserve and payment ledgers.", "followup" => "Control status, priority, due dates, snooze state, and open workflow tasks.", "notes" => "Review important notes and pinned audit context from the activity ledger.", _ => "Review claim identity, loss details, policy context, assignment, financials, and flags by importance." };

    private IEnumerable<KpiTile> Kpis =>
    [
        new("Incurred", _claim?.TotalIncurred.ToString("C0") ?? "$0", "bi-currency-dollar", "red", "Financials", "Total exposure", "Open financial ledger"),
        new("Outstanding", OutstandingAmount.ToString("C0"), "bi-receipt", OutstandingAmount > 0 ? "purple" : "green", "Financials", "Reserve less paid", "Open reserve and payment ledger"),
        new("Days Open", _claim is null ? "0" : (_claim.Status == "Closed" ? "Closed" : _claim.DaysOpen + "d"), "bi-clock-history", _claim?.DaysOpen > 90 ? "red" : "blue", "All", "Claim age", "Show overview"),
        new("Activities", _activities.Count.ToString("N0"), "bi-clock-history", "blue", "Activity", "Claim ledger", "Show all activities"),
        new("Tasks", Tasks.Count.ToString("N0"), "bi-list-check", Tasks.Any() ? "amber" : "blue", "Tasks", "Workflow items", "Filter task activities"),
        new("Notes", Notes.Count.ToString("N0"), "bi-sticky", "purple", "Notes", "Pinned context", "Show notes")
