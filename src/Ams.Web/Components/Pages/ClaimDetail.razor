    private RenderFragment TaskList => builder =>
    {
        if (!Tasks.Any())
        {
            builder.OpenElement(0, "div"); builder.AddAttribute(1, "class", "cd-mini-empty"); builder.AddContent(2, "No task activities have been logged for this claim."); builder.CloseElement();
            return;
        }

        builder.OpenElement(3, "div"); builder.AddAttribute(4, "class", "cd-task-list");
        var seq = 5;
        foreach (var task in Tasks.OrderByDescending(t => t.ActivityDate))
        {
            builder.OpenElement(seq++, "section"); builder.AddAttribute(seq++, "class", "cd-task-card");
            builder.OpenElement(seq++, "header"); builder.OpenElement(seq++, "strong"); builder.AddContent(seq++, task.Title); builder.CloseElement(); builder.OpenElement(seq++, "span"); builder.AddAttribute(seq++, "class", PriorityClass(task.Category)); builder.AddContent(seq++, DisplayValue(task.Category, "Standard")); builder.CloseElement(); builder.CloseElement();
            builder.OpenElement(seq++, "p"); builder.AddContent(seq++, DisplayValue(task.Notes, "No task notes.")); builder.CloseElement();
            builder.OpenElement(seq++, "small"); builder.AddContent(seq++, $"Due/activity date {task.ActivityDate:MM/dd/yyyy} · {DisplayValue(task.CreatedBy, "Tenant Admin")}"); builder.CloseElement();
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    protected override async Task OnInitializedAsync()
    {
        _userContext = await CurrentUser.RequireAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Claims", "/claims"), new("Claim Detail", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var detail = await Api.GetClaimDetailAsync(ClaimId);
            _claim = detail?.Claim;
            _activities.Clear();
            _activities.AddRange(detail?.Activities ?? []);
            ApplySeedFallbacks();
        }
        catch (Exception ex)
        {
            _claim = BuildSeedClaim();
            _activities.Clear();
            _activities.AddRange(BuildSeedActivities(_claim.ClaimId));
            if (!IsNotFound(ex))
            {
                _loadError = ex.Message;
                await ShowToast($"Load failed: {ex.Message}", true);
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplySeedFallbacks()
    {
        _claim ??= BuildSeedClaim();
        if (!_activities.Any())
        {
            _activities.AddRange(BuildSeedActivities(_claim.ClaimId));
        }
    }

    private static bool IsNotFound(Exception ex)
        => ex.Message.Contains("404", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("Not Found", StringComparison.OrdinalIgnoreCase);

