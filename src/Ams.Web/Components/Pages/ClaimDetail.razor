    // ── Save handlers ─────────────────────────────────────────────
    async Task SaveClaimant()
    {
        if (string.IsNullOrWhiteSpace(_claimantForm.Name)) return;
        _claimants.Add(new ClaimantRow { ClaimantId=Guid.NewGuid(), Name=_claimantForm.Name, Role=_claimantForm.Role, InjuryType=_claimantForm.InjuryType, Status="Unrepresented", Phone=_claimantForm.Phone, Email=_claimantForm.Email, Attorney=_claimantForm.Attorney, AttorneyPhone=_claimantForm.AttorneyPhone, Notes=_claimantForm.Notes });
        _showClaimantDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Claimant Added", Content=$"{_claimantForm.Name} added.", CssClass="e-toast-success" });
    }

    async Task SaveTask()
    {
        if (string.IsNullOrWhiteSpace(_taskForm.Title)) return;
        if (_editTask?.TaskId == Guid.Empty)
        {
            _tasks.Add(new TaskRow { TaskId=Guid.NewGuid(), Title=_taskForm.Title, Priority=_taskForm.Priority, Status=_taskForm.Status, AssignedTo=_taskForm.AssignedTo, DueDate=_taskForm.DueDate, Notes=_taskForm.Notes });
        }
        else if (_editTask is not null)
        {
            _editTask.Title=_taskForm.Title; _editTask.Priority=_taskForm.Priority; _editTask.Status=_taskForm.Status; _editTask.AssignedTo=_taskForm.AssignedTo; _editTask.DueDate=_taskForm.DueDate; _editTask.Notes=_taskForm.Notes;
        }
        _showTaskDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Task Saved", Content=$"\"{_taskForm.Title}\" saved.", CssClass="e-toast-success" });
    }

    async Task SaveReserve()
    {
        if (string.IsNullOrWhiteSpace(_reserveForm.ReserveType)) return;
        var prior = _reserves.Where(r => r.ReserveType == _reserveForm.ReserveType).OrderByDescending(r => r.EffectiveDate).FirstOrDefault();
        _reserves.Add(new ReserveEntry { ReserveType=_reserveForm.ReserveType, Amount=_reserveForm.Amount, PriorAmount=prior?.Amount, EffectiveDate=DateTime.Today, Reason=_reserveForm.Reason, SetBy="Current User" });
        if (_claim is not null) _claim.TotalReserves = _reserves.GroupBy(r => r.ReserveType).Sum(g => g.OrderByDescending(r => r.EffectiveDate).First().Amount);
        _showReserveDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Reserve Updated", Content=$"{_reserveForm.ReserveType} reserve updated to {_reserveForm.Amount.ToString("C0")}.", CssClass="e-toast-success" });
    }

    async Task SavePayment()
    {
        if (string.IsNullOrWhiteSpace(_paymentForm.Payee) || _paymentForm.Amount <= 0) return;
        _payments.Add(new PaymentEntry { PaymentType=_paymentForm.PaymentType, Amount=_paymentForm.Amount, Payee=_paymentForm.Payee, PaymentDate=_paymentForm.PaymentDate ?? DateTime.Today, CheckNumber=_paymentForm.CheckNumber, Method=_paymentForm.Method, Notes=_paymentForm.Notes, LoggedBy="Current User" });
        if (_claim is not null) { _claim.TotalPaid += _paymentForm.Amount; _claim.TotalIncurred = _claim.TotalPaid + _claim.TotalReserves - _claim.TotalPaid; }
        _showPaymentDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Payment Logged", Content=$"Payment of {_paymentForm.Amount.ToString("C0")} to {_paymentForm.Payee} logged.", CssClass="e-toast-success" });
    }

    async Task SaveComm()
    {
        _comms.Add(new CommRow { CommType=_commForm.CommType, Direction=_commForm.Direction, Party=_commForm.Party, CommDate=_commForm.CommDate, Subject=_commForm.Subject, Notes=_commForm.Notes, LoggedBy="Current User" });
        _timeline.Add(new TimelineEvent { EventType="Communication", Title=$"{_commForm.CommType} — {_commForm.Subject}", EventDate=_commForm.CommDate, PerformedBy="Current User", Party=_commForm.Party, Notes=_commForm.Notes });
        _showCommDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Communication Logged", Content="Communication entry saved.", CssClass="e-toast-success" });
    }

    async Task SaveNote()
    {
        if (string.IsNullOrWhiteSpace(_noteForm.Body)) return;
        _notes.Add(new NoteRow { NoteId=Guid.NewGuid(), Category=_noteForm.Category, Body=_noteForm.Body, IsPinned=_noteForm.IsPinned, CreatedBy="Current User", CreatedAt=DateTime.Now });
        _showNoteDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Note Saved", Content="Note added to claim.", CssClass="e-toast-success" });
    }

    void EditTask(TaskRow t)
    {
        _editTask  = t;
        _taskForm  = new TaskForm { Title=t.Title, Priority=t.Priority, Status=t.Status, AssignedTo=t.AssignedTo, DueDate=t.DueDate, Notes=t.Notes };
        _showTaskDlg = true;
    }

    async Task CompleteTask(TaskRow t)
    {
        t.Status = "Completed";
        await _toast.ShowAsync(new ToastModel { Title="Task Complete", Content=$"\"{t.Title}\" marked complete.", CssClass="e-toast-success" });
    }

    async Task CloseClaim()
    {
        if (_claim is null) return;
        _claim.Status    = "Closed";
        _claim.ClosedDate = DateTime.Today;
        _timeline.Add(new TimelineEvent { EventType="Closed", Title="Claim Closed", EventDate=DateTime.Now, PerformedBy="Current User", Party="", Notes="" });
        await _toast.ShowAsync(new ToastModel { Title="Claim Closed", Content=$"{_claim.ClaimNumber} has been closed.", CssClass="e-toast-success" });
    }

    async Task ReopenClaim()
    {
        if (_claim is null) return;
        _claim.Status    = "Reopened";
        _claim.ClosedDate = null;
        _timeline.Add(new TimelineEvent { EventType="Reopened", Title="Claim Reopened", EventDate=DateTime.Now, PerformedBy="Current User", Party="", Notes="" });
        await _toast.ShowAsync(new ToastModel { Title="Claim Reopened", Content=$"{_claim.ClaimNumber} has been reopened.", CssClass="e-toast-info" });
    }

    // ── Render helpers ────────────────────────────────────────────
    RenderFragment F(string label, string value) => __builder =>
    {
        <div class="pd-field-row">
            <span class="pd-field-lbl">@label</span>
            <span class="pd-field-val">@value</span>
        </div>
    };

    RenderFragment CdKpi(string label, string value, string icon, string color) => __builder =>
    {
        <div class="pd-kpi-card @color">
            <i class="bi @icon pd-kpi-icon" aria-hidden="true"></i>
            <div>
                <div class="pd-kpi-val">@value</div>
                <div class="pd-kpi-lbl">@label</div>
            </div>
        </div>
    };

    RenderFragment NoteCard(NoteRow note) => __builder =>
    {
        <div class="cd-note-card @(note.IsPinned ? "cd-note-pinned" : "")">
            <div class="cd-note-header">
                <span class="cd-note-cat cd-ncat-@note.Category.ToLower().Replace(" ","").Replace("/","")">@note.Category</span>
                @if (note.IsPinned) { <span class="cd-note-pin"><i class="bi bi-pin-angle-fill" aria-hidden="true"></i></span> }
                <span class="cd-note-meta">@note.CreatedBy · @note.CreatedAt.ToString("MM/dd/yyyy h:mm tt")</span>
                <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => note.IsPinned = !note.IsPinned" title="Toggle pin">
                    <i class="bi @(note.IsPinned ? "bi-pin-angle-fill" : "bi-pin-angle")" aria-hidden="true"></i>
                </button>
            </div>
            <div class="cd-note-body">@note.Body</div>
        </div>
    };

    // ── Static helpers ────────────────────────────────────────────
    static string LobKey(string lob)  => lob.ToLower().Replace(" ","").Replace("/","").Replace("&","").Replace(".","").Replace("-","");
    static string LobIcon(string lob) => lob switch
    {
        "General Liability"   => "bi-shield-check",
        "Commercial Auto"     => "bi-truck",
        "Commercial Property" => "bi-building",
        "Workers Comp"        => "bi-person-fill-gear",
        "Umbrella"            => "bi-umbrella",
        "Professional Liab."  => "bi-briefcase",
        "Home/Dwelling"       => "bi-house",
        "Personal Auto"       => "bi-car-front",
        _                     => "bi-shield-half"
    };
    static string StatusCss(string s)         => s.ToLower().Replace(" ","-").Replace("/","-");
    static string RoleCss(string r)           => r.ToLower().Replace(" ","-").Replace("/","-").Replace("&","");
    static string ClaimantStatusCss(string s) => s.ToLower().Replace(" ","-");
    static string TaskStatusCss(string s)     => s.ToLower().Replace(" ","-");
    static string CommTypeCss(string t)       => t switch { "Email"=>"email","Phone Call"=>"phone","Letter"=>"letter","Text/SMS"=>"sms","Fax"=>"letter",_=>"letter" };
    static string TlTypeCss(string t)         => t.ToLower().Replace(" ","-").Replace("/","-");
    static string TlIcon(string t)            => t switch
    {
        "Loss"          => "bi-exclamation-triangle",
        "Reported"      => "bi-megaphone",
        "Acknowledged"  => "bi-check-circle",
        "Contact"       => "bi-telephone",
        "Reserve"       => "bi-safe",
        "Legal"         => "bi-gavel",
        "Payment"       => "bi-cash-stack",
        "Communication" => "bi-envelope",
        "Closed"        => "bi-x-circle",
        "Reopened"      => "bi-arrow-counterclockwise",
        _               => "bi-circle"
    };
    static string DocIcon(string ft) => ft switch { "pdf"=>"bi-file-earmark-pdf","docx"=>"bi-file-earmark-word","xlsx"=>"bi-file-earmark-excel","jpg" or "png"=>"bi-file-earmark-image",_=>"bi-file-earmark" };
}
