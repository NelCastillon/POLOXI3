    private IEnumerable<WorkflowLane> WorkflowLanes =>
    [
        new("Communicate", "Carrier / claimant", "bi-envelope", "Communication", "activity", Communications.Count, "Logged communications", "Filter communications"),
        new("Tasks", "Next actions", "bi-list-check", "Task", "followup", Tasks.Count, "Task activities", "Review workflow tasks"),
        new("Reserves", "Exposure", "bi-safe", "Reserve", "financials", Reserves.Count, "Reserve updates", "Review reserves"),
        new("Payments", "Disbursement", "bi-cash-stack", "Payment", "financials", Payments.Count, "Payment entries", "Review payments"),
