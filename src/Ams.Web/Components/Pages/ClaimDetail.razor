        DateOfLoss = DateTime.Today.AddDays(-47),
        DateReported = DateTime.Today.AddDays(-44),
        DaysOpen = 44,
        TotalIncurred = 98500m,
        TotalReserves = 85000m,
        TotalPaid = 13500m,
        AssignedHandler = "Amy Scott",
        IsLitigation = false,
        HasSubrogation = true,
        IsCatastrophe = false,
        IsDisputed = true,
        FollowUpReason = "Carrier coverage position and claimant medical update due",
        Priority = "High",
