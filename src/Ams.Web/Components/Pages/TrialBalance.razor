@page "/finance/trial-balance"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Trial Balance — AMS</PageTitle>

<AppPageHeader Title="Trial Balance"
               Subtitle="Tenant Admin review of debit, credit, and net balances by GL account"
               Icon="bi-calculator">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/finance/glaccounts")'><i class="bi bi-journals" aria-hidden="true"></i> GL Accounts</button>
    </Actions>
</AppPageHeader>

<div class="fin-kpi-strip">
    <div class="fin-kpi-card"><div class="fin-kpi-icon"><i class="bi bi-calculator"></i></div><div><div class="fin-kpi-value">@_items.Count</div><div class="fin-kpi-label">Accounts</div></div></div>
    <div class="fin-kpi-card"><div class="fin-kpi-icon"><i class="bi bi-arrow-down-circle"></i></div><div><div class="fin-kpi-value">@Fmt(_items.Sum(x => x.DebitBalance))</div><div class="fin-kpi-label">Debit Balance</div></div></div>
    <div class="fin-kpi-card"><div class="fin-kpi-icon"><i class="bi bi-arrow-up-circle"></i></div><div><div class="fin-kpi-value">@Fmt(_items.Sum(x => x.CreditBalance))</div><div class="fin-kpi-label">Credit Balance</div></div></div>
    <div class="fin-kpi-card"><div class="fin-kpi-icon"><i class="bi bi-bank"></i></div><div><div class="fin-kpi-value">@Fmt(_items.Sum(x => x.NetBalance))</div><div class="fin-kpi-label">Net Balance</div></div></div>
</div>

<div class="fin-toolbar">
    <div class="fin-search-box"><i class="bi bi-search fin-search-icon" aria-hidden="true"></i><input class="e-input fin-search-input" placeholder="Search account code or name…" @bind="_searchTerm" @bind:event="oninput" @onkeyup="@(e => e.Key == "Enter" ? LoadAsync() : Task.CompletedTask)" /></div>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-search" aria-hidden="true"></i> Search</button>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="fin-alert"><div class="fin-alert-icon"><i class="bi bi-exclamation-triangle-fill"></i></div><div><div class="fin-alert-title">Trial balance failed to load</div><div>@_error</div></div></div>
}
else if (_loading)
{
    <div class="fin-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading trial balance…</span></div>
}
else
{
    <div class="fin-grid-container">
        <SfGrid TValue="TrialBalanceSnapshotDto" DataSource="_items" AllowPaging="true" AllowSorting="true" Height="600px">
            <GridPageSettings PageSize="15" />
            <GridColumns>
                <GridColumn Field="@nameof(TrialBalanceSnapshotDto.SnapshotDate)" HeaderText="Snapshot" Type="ColumnType.Date" Format="d" Width="130" />
                <GridColumn Field="@nameof(TrialBalanceSnapshotDto.AccountCode)" HeaderText="Code" Width="120" />
                <GridColumn Field="@nameof(TrialBalanceSnapshotDto.AccountName)" HeaderText="Account Name" Width="240" />
                <GridColumn Field="@nameof(TrialBalanceSnapshotDto.DebitBalance)" HeaderText="Debit" Format="C2" Width="130" TextAlign="TextAlign.Right" />
                <GridColumn Field="@nameof(TrialBalanceSnapshotDto.CreditBalance)" HeaderText="Credit" Format="C2" Width="130" TextAlign="TextAlign.Right" />
                <GridColumn Field="@nameof(TrialBalanceSnapshotDto.NetBalance)" HeaderText="Net" Format="C2" Width="130" TextAlign="TextAlign.Right" />
                <GridColumn Field="@nameof(TrialBalanceSnapshotDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="d" Width="130" />
            </GridColumns>
        </SfGrid>
    </div>
}

<SfDialog @bind-Visible="_showForm" Width="720px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-calculator" aria-hidden="true"></i><span>@(_editingId == Guid.Empty ? "New Trial Balance Snapshot" : "Edit Trial Balance Snapshot")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Snapshot Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.SnapshotDate" class="um-input" /><ValidationMessage For="() => _form.SnapshotDate" class="text-danger" /></div>
                    <div class="um-field"><label>Accounting Period</label><InputSelect @bind-Value="_form.AccountingPeriodId" class="um-input"><option value="">None</option>@foreach (var period in _periods) { <option value="@period.AccountingPeriodId">@period.PeriodCode - @period.PeriodName</option> }</InputSelect><ValidationMessage For="() => _form.AccountingPeriodId" class="text-danger" /></div>
                    <div class="um-field um-field--full"><label>GL Account <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.GLAccountId" class="um-input"><option value="@Guid.Empty">Select account…</option>@foreach (var account in _glAccounts) { <option value="@account.GLAccountId">@account.AccountCode - @account.AccountName</option> }</InputSelect><ValidationMessage For="() => _form.GLAccountId" class="text-danger" /></div>
                    <div class="um-field"><label>Account Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.AccountCode" class="um-input" /><ValidationMessage For="() => _form.AccountCode" class="text-danger" /></div>
                    <div class="um-field"><label>Account Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.AccountName" class="um-input" /><ValidationMessage For="() => _form.AccountName" class="text-danger" /></div>
                    <div class="um-field"><label>Debit Balance</label><InputNumber @bind-Value="_form.DebitBalance" class="um-input" /><ValidationMessage For="() => _form.DebitBalance" class="text-danger" /></div>
                    <div class="um-field"><label>Credit Balance</label><InputNumber @bind-Value="_form.CreditBalance" class="um-input" /><ValidationMessage For="() => _form.CreditBalance" class="text-danger" /></div>
                    <div class="um-field"><label>Net Balance</label><input class="um-input" value="@((_form.DebitBalance - _form.CreditBalance).ToString("C2"))" disabled /></div>
                    @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Snapshot")</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private List<TrialBalanceSnapshotDto> _items = [];
    private List<GLAccountDto> _glAccounts = [];
    private List<AccountingPeriodDto> _periods = [];
    private string? _searchTerm, _error, _formError;
    private bool _loading, _showForm, _saving;
    private Guid _editingId = Guid.Empty;
    private TrialBalanceForm _form = new();
    private EditContext _editContext = default!;
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    protected override async Task OnInitializedAsync() { _editContext = new(_form); await LoadAsync(); }
    private async Task LoadAsync() { _loading = true; _error = null; try { var result = await Api.SearchTrialBalanceSnapshotsAsync(_tenantId, _searchTerm); var gl = await Api.SearchGLAccountsAsync(_tenantId, pageSize: 500); var periods = await Api.SearchAccountingPeriodsAsync(_tenantId); _items = result?.Items.ToList() ?? []; _glAccounts = gl?.Items.ToList() ?? []; _periods = periods?.Items.ToList() ?? []; } catch (Exception ex) { _error = ex.Message; _items = []; } finally { _loading = false; } }
    private void OnRowSelected(RowSelectEventArgs<TrialBalanceSnapshotDto> args) => OpenEdit(args.Data);
    private void OpenCreate() { _editingId = Guid.Empty; _form = new(); _editContext = new(_form); _formError = null; _showForm = true; }
    private void OpenEdit(TrialBalanceSnapshotDto item) { _editingId = item.TrialBalanceSnapshotId; _form = new TrialBalanceForm { SnapshotDate = item.SnapshotDate.ToDateTime(TimeOnly.MinValue), AccountingPeriodId = item.AccountingPeriodId, GLAccountId = item.GLAccountId, AccountCode = item.AccountCode, AccountName = item.AccountName, DebitBalance = item.DebitBalance, CreditBalance = item.CreditBalance }; _editContext = new(_form); _formError = null; _showForm = true; }
    private void CloseForm() => _showForm = false;
    private async Task SaveAsync() { if (!_editContext.Validate()) return; _saving = true; try { if (_editingId == Guid.Empty) await Api.CreateTrialBalanceSnapshotAsync(new CreateTrialBalanceSnapshotRequest { TenantId = _tenantId, SnapshotDate = DateOnly.FromDateTime(_form.SnapshotDate), AccountingPeriodId = _form.AccountingPeriodId, GLAccountId = _form.GLAccountId, AccountCode = _form.AccountCode, AccountName = _form.AccountName, DebitBalance = _form.DebitBalance, CreditBalance = _form.CreditBalance }); else await Api.UpdateTrialBalanceSnapshotAsync(_editingId, new UpdateTrialBalanceSnapshotRequest { TenantId = _tenantId, TrialBalanceSnapshotId = _editingId, SnapshotDate = DateOnly.FromDateTime(_form.SnapshotDate), AccountingPeriodId = _form.AccountingPeriodId, GLAccountId = _form.GLAccountId, AccountCode = _form.AccountCode, AccountName = _form.AccountName, DebitBalance = _form.DebitBalance, CreditBalance = _form.CreditBalance }); _showForm = false; await LoadAsync(); } catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; } finally { _saving = false; } }
    private static string Fmt(decimal value) => value.ToString("C0");
    private sealed class TrialBalanceForm { [Required] public DateTime SnapshotDate { get; set; } = DateTime.Today; public Guid? AccountingPeriodId { get; set; } [RequiredGuid(ErrorMessage = "GL Account is required.")] public Guid GLAccountId { get; set; } [Required, StringLength(50)] public string AccountCode { get; set; } = string.Empty; [Required, StringLength(200)] public string AccountName { get; set; } = string.Empty; [Range(0, 100000000)] public decimal DebitBalance { get; set; } [Range(0, 100000000)] public decimal CreditBalance { get; set; } }
}
