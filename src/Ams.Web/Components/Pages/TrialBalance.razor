@page "/finance/trial-balance"
@inject ApiClient Api
@using Ams.Application.Common.Dtos
@using Ams.Web.Services
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons

<h3>Trial Balance</h3>

<div class="mb-3 d-flex gap-2">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="300px" />
    <SfButton OnClick="LoadAsync">Search</SfButton>
</div>

<SfGrid DataSource="_items" AllowPaging="true">
    <GridPageSettings PageSize="10" />
    <GridColumns>
        <GridColumn Field="@nameof(TrialBalanceSnapshotDto.TrialBalanceSnapshotId)" HeaderText="ID" Width="220" />
        <GridColumn Field="@nameof(TrialBalanceSnapshotDto.SnapshotDate)" HeaderText="Snapshot Date" Width="140" />
        <GridColumn Field="@nameof(TrialBalanceSnapshotDto.AccountCode)" HeaderText="Account Code" Width="140" />
        <GridColumn Field="@nameof(TrialBalanceSnapshotDto.AccountName)" HeaderText="Account Name" Width="200" />
        <GridColumn Field="@nameof(TrialBalanceSnapshotDto.DebitBalance)" HeaderText="Debit" Format="C2" Width="120" />
        <GridColumn Field="@nameof(TrialBalanceSnapshotDto.CreditBalance)" HeaderText="Credit" Format="C2" Width="120" />
        <GridColumn Field="@nameof(TrialBalanceSnapshotDto.NetBalance)" HeaderText="Net" Format="C2" Width="120" />
        <GridColumn Field="@nameof(TrialBalanceSnapshotDto.CreatedDateUtc)" HeaderText="Created" Width="160" />
    </GridColumns>
</SfGrid>

@code {
    private List<TrialBalanceSnapshotDto>? _items;
    private string? _searchTerm;
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.SearchTrialBalanceSnapshotsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
