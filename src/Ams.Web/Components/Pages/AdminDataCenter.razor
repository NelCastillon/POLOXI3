@page "/admin/system/data"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>Data Import &amp; Export Center — AMS</PageTitle>

<AppPageHeader Title="Data Import &amp; Export Center"
               Subtitle="Bulk import and export records across accounts, policies, contacts, billing, and commissions"
               Icon="bi-database-up">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="()=>_showImport=true"><i class="bi bi-upload" aria-hidden="true"></i> New Import</button>
        <button class="um-btn um-btn-ghost"><i class="bi bi-download" aria-hidden="true"></i> Export Data</button>
    </Actions>
</AppPageHeader>

<div class="dic-tabs">
    <button class="dic-tab @(_tab==1?"dic-tab-active":"")" @onclick="()=>_tab=1">Import Jobs</button>
    <button class="dic-tab @(_tab==2?"dic-tab-active":"")" @onclick="()=>_tab=2">Export Jobs</button>
    <button class="dic-tab @(_tab==3?"dic-tab-active":"")" @onclick="()=>_tab=3">Field Mappings</button>
</div>

@if (_tab == 1)
{
    <div class="dic-job-list">
        @foreach (var job in _importJobs)
        {
            <div class="dic-job-card @StatusCardCss(job.Status)">
                <div class="dic-job-hdr">
                    <div class="dic-job-icon @EntityIconCss(job.Entity)"><i class="bi bi-@EntityIcon(job.Entity)" aria-hidden="true"></i></div>
                    <div class="dic-job-info">
                        <div class="dic-job-name">@job.Name</div>
                        <div class="dic-job-meta">@job.Entity · @job.Format · @job.StartedBy · @job.StartedAt</div>
                    </div>
                    <span class="@StatusBadge(job.Status)">@job.Status</span>
                </div>
                @if (job.Status is "Running" or "Completed" or "Failed")
                {
                    <div class="dic-progress-wrap">
                        <div class="dic-progress-bar"><div class="dic-progress-fill @ProgressCss(job.Status)" style="width:@job.Progress%"></div></div>
                        <span class="dic-pct">@job.Progress%</span>
                    </div>
                    <div class="dic-job-stats">
                        <span class="dic-stat-item dic-stat-ok"><i class="bi bi-check-circle" aria-hidden="true"></i> @job.Imported imported</span>
                        @if (job.Errors > 0) { <span class="dic-stat-item dic-stat-err"><i class="bi bi-x-circle" aria-hidden="true"></i> @job.Errors errors</span> }
                        @if (job.Skipped > 0) { <span class="dic-stat-item dic-stat-skip"><i class="bi bi-skip-forward" aria-hidden="true"></i> @job.Skipped skipped</span> }
                    </div>
                }
                @if (!string.IsNullOrEmpty(job.ErrorSummary))
                {
                    <div class="dic-err-box">@job.ErrorSummary</div>
                }
                <div class="dic-job-footer">
                    @if (job.Status == "Failed") { <button class="um-btn um-btn-ghost um-btn-xs"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Retry</button> }
                    <button class="um-btn um-btn-ghost um-btn-xs"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Log</button>
                </div>
            </div>
        }
    </div>
}
else if (_tab == 2)
{
    <div class="dic-placeholder"><i class="bi bi-download dic-ph-icon" aria-hidden="true"></i><div>Export job history and configuration will appear here.</div></div>
}
else
{
    <div class="dic-placeholder"><i class="bi bi-arrow-down-up dic-ph-icon" aria-hidden="true"></i><div>Configure field-level import/export mappings for each entity type.</div></div>
}

<SfDialog @bind-Visible="_showImport" Width="480px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>New Import Job</Header>
        <Content>
            <div class="dic-dlg">
                <label class="dic-label">Data Type</label>
                <select class="dic-input"><option>Accounts</option><option>Contacts</option><option>Policies</option><option>Claims</option><option>Invoices</option><option>Commission Splits</option></select>
                <label class="dic-label">File Format</label>
                <select class="dic-input"><option>CSV</option><option>Excel (.xlsx)</option><option>JSON</option></select>
                <label class="dic-label">File</label>
                <input type="file" class="dic-file" accept=".csv,.xlsx,.json" />
                <label class="dic-label">Duplicate Handling</label>
                <select class="dic-input"><option>Skip duplicates</option><option>Update existing</option><option>Flag for review</option></select>
                <label class="dic-label">Run as</label>
                <select class="dic-input"><option>Dry run (validate only)</option><option>Live import</option></select>
            </div>
        </Content>
        <FooterTemplate>
            <button class="um-btn um-btn-ghost" @onclick="()=>_showImport=false">Cancel</button>
            <button class="um-btn um-btn-primary" @onclick="()=>_showImport=false"><i class="bi bi-upload" aria-hidden="true"></i> Start Import</button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    private int _tab = 1;
    private bool _showImport;
    private List<ImportJob> _importJobs = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Administration","/admin"), new("Data Import & Export",""));
        _importJobs =
        [
            new ImportJob { Name="Accounts Migration — Q2 2025",         Entity="Accounts",     Format="CSV",  Status="Completed", StartedBy="J. Rivera",   StartedAt="Jun 8 10:22 AM", Progress=100, Imported=4822, Errors=3,  Skipped=12, ErrorSummary="" },
            new ImportJob { Name="Commission Split Import — May",        Entity="Commissions",  Format="Excel",Status="Completed", StartedBy="M. Kim",      StartedAt="Jun 5 3:14 PM",  Progress=100, Imported=1204, Errors=0,  Skipped=4,  ErrorSummary="" },
            new ImportJob { Name="Policy Data Load — Carrier Migration", Entity="Policies",     Format="CSV",  Status="Failed",    StartedBy="Admin",       StartedAt="Jun 10 8:00 AM", Progress=62,  Imported=2810, Errors=142,Skipped=0,  ErrorSummary="142 rows failed: invalid carrier code 'XYZ' on lines 2811–2952. Correct file and retry." },
            new ImportJob { Name="Contact List — Marketing Campaign",    Entity="Contacts",     Format="CSV",  Status="Running",   StartedBy="C. Ortega",   StartedAt="Jun 11 9:45 AM", Progress=44,  Imported=881,  Errors=2,  Skipped=0,  ErrorSummary="" },
            new ImportJob { Name="Invoice Backfill — 2024 Archive",      Entity="Invoices",     Format="JSON", Status="Queued",    StartedBy="Admin",       StartedAt="Jun 11 10:00 AM",Progress=0,   Imported=0,    Errors=0,  Skipped=0,  ErrorSummary="" },
        ];
    }

    private static string StatusBadge(string s) => s switch { "Completed"=>"dic-st dic-st--ok","Running"=>"dic-st dic-st--run","Failed"=>"dic-st dic-st--err","Queued"=>"dic-st dic-st--q",_=>"dic-st" };
    private static string StatusCardCss(string s) => s == "Failed" ? "dic-card-err" : "";
    private static string ProgressCss(string s) => s switch { "Completed"=>"dic-pf-green","Failed"=>"dic-pf-red",_=>"dic-pf-blue" };
    private static string EntityIcon(string e) => e switch { "Accounts"=>"building","Policies"=>"shield-check","Contacts"=>"person-badge","Claims"=>"exclamation-circle","Invoices"=>"receipt","Commissions"=>"percent",_=>"database" };
    private static string EntityIconCss(string e) => e switch { "Accounts"=>"dic-ei-blue","Policies"=>"dic-ei-green","Contacts"=>"dic-ei-purple","Claims"=>"dic-ei-red","Invoices"=>"dic-ei-amber","Commissions"=>"dic-ei-blue",_=>"dic-ei-grey" };

    private sealed class ImportJob { public string Name{get;set;}=string.Empty; public string Entity{get;set;}=string.Empty; public string Format{get;set;}=string.Empty; public string Status{get;set;}=string.Empty; public string StartedBy{get;set;}=string.Empty; public string StartedAt{get;set;}=string.Empty; public int Progress{get;set;} public int Imported{get;set;} public int Errors{get;set;} public int Skipped{get;set;} public string ErrorSummary{get;set;}=string.Empty; }
}
