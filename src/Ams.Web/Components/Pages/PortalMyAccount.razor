@page "/portal/my-account"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Portal My Account - AMS</PageTitle>

<AppPageHeader Title="My Account"
               Subtitle="Enterprise tenant account command center for portal ownership, usage, security, support, and renewal readiness."
               Icon="bi-person-circle">
    <Actions>
        <button class="um-btn um-btn-ghost" type="button" @onclick='() => Nav.NavigateTo("/portal/users")'><i class="bi bi-people" aria-hidden="true"></i> Portal Users</button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_busy"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-primary" type="submit" form="pma-form" disabled="@_busy"><i class="bi bi-check-lg" aria-hidden="true"></i> Save account</button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="pma-toast @_toastClass" role="status">
        <i class="bi @(_toastClass == "pma-toast--danger" ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="pma-toast-close" @onclick="ClearToast" aria-label="Dismiss message"><i class="bi bi-x-lg"></i></button>
    </div>
}

<div class="pma-page">
    <section class="pma-hero">
        <div class="pma-hero-main">
            <div class="pma-eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> Tenant admin console</div>
            <h2>@DisplayName</h2>
            <p>Prioritized view of the client portal account, subscription utilization, admin ownership, secure access controls, and support readiness.</p>
            <div class="pma-hero-meta">
                <span><i class="bi bi-globe2"></i> @_form.PortalDomain</span>
                <span><i class="bi bi-person-badge"></i> @_form.AdminRole</span>
                <span><i class="bi bi-clock-history"></i> Last login @FormatRelative(_account.LastAdminLoginUtc)</span>
                <span><i class="bi bi-calendar-check"></i> Renews @_form.RenewalDateUtc.ToString("MMM d, yyyy")</span>
            </div>
        </div>
        <div class="pma-hero-panel">
            <div class="pma-score-card">
                <span>Account readiness</span>
                <strong>@ReadinessScore%</strong>
                <div class="pma-score-track"><div style="width:@ReadinessScore%"></div></div>
                <small>@ReadinessSummary</small>
            </div>
            <div class="pma-priority-list">
                @foreach (var item in PriorityItems)
                {
                    <button type="button" class="pma-priority-item" @onclick="() => _activeTab = item.TargetTab">
                        <span class="pma-priority-score @item.Css">@item.Score</span>
                        <div><strong>@item.Title</strong><small>@item.Detail</small></div>
                        <i class="bi bi-chevron-right"></i>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="pma-kpi-strip" aria-label="My account KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="pma-kpi-card @(IsActiveKpi(kpi.Key) ? "pma-kpi-card--active" : null)" title="@kpi.Tooltip" @onclick="() => SetKpi(kpi.Key)">
                <span class="pma-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="pma-kpi-label">@kpi.Label</span>
                <strong>@kpi.Value</strong>
                <small>@kpi.Detail</small>
            </button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger pma-load-error" role="alert">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            @_loadError
        </div>
    }

    <section class="pma-command-bar">
        <div>
            <strong>@WorkflowTitle</strong>
            <span>@WorkflowSummary</span>
        </div>
        <div class="pma-command-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => NavigateWorkflow("users")'><i class="bi bi-people"></i> Review users</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => NavigateWorkflow("requests")'><i class="bi bi-inbox"></i> Triage requests</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => NavigateWorkflow("documents")'><i class="bi bi-folder2-open"></i> Audit documents</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => NavigateWorkflow("activity")'><i class="bi bi-activity"></i> Open activity</button>
        </div>
    </section>

    <div class="pma-tabs" role="tablist" aria-label="My account tabs">
        @foreach (var tab in _tabs)
        {
            <button type="button" role="tab" class="pma-tab @(_activeTab == tab.Key ? "pma-tab--active" : null)" @onclick="() => _activeTab = tab.Key">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
            </button>
        }
    </div>

    @if (_loading)
    {
        <div class="pma-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading account...</div>
    }
    else
    {
        <EditForm id="pma-form" Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            @if (_activeTab == "overview")
            {
                <section class="pma-grid pma-grid--overview">
                    <article class="pma-panel pma-panel--large">
                        <div class="pma-panel-header"><i class="bi bi-list-check"></i><div><strong>Executive priorities</strong><span>Highest impact portal account items first.</span></div></div>
                        <div class="pma-readiness-list">
                            @foreach (var item in PriorityItems)
                            {
                                <button type="button" class="pma-readiness-item" @onclick="() => _activeTab = item.TargetTab">
                                    <span class="pma-score @item.Css">@item.Score</span>
                                    <div><strong>@item.Title</strong><span>@item.Detail</span></div>
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            }
                        </div>
                    </article>
                    <article class="pma-panel">
                        <div class="pma-panel-header"><i class="bi bi-credit-card"></i><div><strong>Subscription</strong><span>Renewal and usage posture.</span></div></div>
                        <div class="pma-plan-card">
                            <span class="pma-status pma-status--active">@_form.PlanStatus</span>
                            <strong>@_form.PlanName</strong>
                            <small>Renews @_form.RenewalDateUtc.ToString("MMM d, yyyy")</small>
                            <div class="pma-meter-label"><span>Storage</span><span>@_form.StorageUsedGb GB / @_form.StorageLimitGb GB</span></div>
                            <div class="pma-meter"><span style="width:@StoragePercent%"></span></div>
                        </div>
                    </article>
                    <article class="pma-panel">
                        <div class="pma-panel-header"><i class="bi bi-bar-chart"></i><div><strong>Usage signals</strong><span>Current adoption indicators.</span></div></div>
                        <div class="pma-metric-list">
                            @foreach (var metric in UsageMetrics)
                            {
                                <div class="pma-metric-row"><span>@metric.Label</span><strong>@metric.Value</strong></div>
                            }
                        </div>
                    </article>
                </section>
            }
            else if (_activeTab == "identity")
            {
                <section class="pma-grid">
                    <article class="pma-panel pma-panel--large">
                        <div class="pma-panel-header"><i class="bi bi-building"></i><div><strong>Account ownership</strong><span>Tenant, administrator, locale, and contact ownership.</span></div></div>
                        <div class="pma-form-grid">
                            <div class="pma-field pma-field--full"><label>Agency name</label><InputText class="pma-input" @bind-Value="_form.AgencyName" /></div>
                            <div class="pma-field"><label>Admin name</label><InputText class="pma-input" @bind-Value="_form.AdminName" /></div>
                            <div class="pma-field"><label>Admin email</label><InputText class="pma-input" @bind-Value="_form.AdminEmail" /></div>
                            <div class="pma-field"><label>Admin phone</label><InputText type="tel" class="pma-input" placeholder="(555) 123-4567" inputmode="tel" autocomplete="tel" @bind-Value="_form.AdminPhone" /><small class="text-muted">Use enterprise phone format: (555) 123-4567 or +1 555 123 4567 x123.</small></div>
                            <div class="pma-field"><label>Admin role</label><InputText class="pma-input" @bind-Value="_form.AdminRole" /></div>
                            <div class="pma-field"><label>Time zone</label><InputText class="pma-input" @bind-Value="_form.TimeZone" /></div>
                            <div class="pma-field"><label>Locale</label><InputText class="pma-input" @bind-Value="_form.Locale" /></div>
                            <div class="pma-field"><label>Tenant ID</label><input class="pma-input" value="@_tenantId" readonly /></div>
                        </div>
                    </article>
                    <article class="pma-panel"><div class="pma-panel-header"><i class="bi bi-person-vcard"></i><div><strong>Administrator card</strong><span>Visible account owner.</span></div></div><div class="pma-admin-card"><div class="pma-avatar">@Initials(_form.AgencyName)</div><strong>@_form.AdminName</strong><span>@_form.AdminEmail</span><small>@_form.AdminPhone</small></div></article>
                </section>
            }
            else if (_activeTab == "subscription")
            {
                <section class="pma-grid">
                    <article class="pma-panel pma-panel--large">
                        <div class="pma-panel-header"><i class="bi bi-credit-card-2-front"></i><div><strong>Plan and usage controls</strong><span>Subscription, renewal, capacity, and adoption metrics.</span></div></div>
                        <div class="pma-form-grid">
                            <div class="pma-field"><label>Plan name</label><InputText class="pma-input" @bind-Value="_form.PlanName" /></div>
                            <div class="pma-field"><label>Plan status</label><InputSelect class="pma-input" @bind-Value="_form.PlanStatus"><option>Active</option><option>Trial</option><option>Renewal Review</option><option>Suspended</option></InputSelect></div>
                            <div class="pma-field"><label>Renewal date</label><InputDate class="pma-input" @bind-Value="_form.RenewalDateUtc" /></div>
                            <div class="pma-field"><label>Portal users</label><InputNumber class="pma-input" @bind-Value="_form.PortalUsers" /></div>
                            <div class="pma-field"><label>Active portal users</label><InputNumber class="pma-input" @bind-Value="_form.ActivePortalUsers" /></div>
                            <div class="pma-field"><label>Pending invites</label><InputNumber class="pma-input" @bind-Value="_form.PendingInvites" /></div>
                            <div class="pma-field"><label>Open requests</label><InputNumber class="pma-input" @bind-Value="_form.OpenRequests" /></div>
                            <div class="pma-field"><label>Urgent requests</label><InputNumber class="pma-input" @bind-Value="_form.UrgentRequests" /></div>
                            <div class="pma-field"><label>Shared documents</label><InputNumber class="pma-input" @bind-Value="_form.SharedDocuments" /></div>
                            <div class="pma-field"><label>Storage used GB</label><InputNumber class="pma-input" @bind-Value="_form.StorageUsedGb" /></div>
                            <div class="pma-field"><label>Storage limit GB</label><InputNumber class="pma-input" @bind-Value="_form.StorageLimitGb" /></div>
                            <div class="pma-field"><label>Monthly logins</label><InputNumber class="pma-input" @bind-Value="_form.MonthlyLoginCount" /></div>
                            <div class="pma-field"><label>Mobile installs</label><InputNumber class="pma-input" @bind-Value="_form.MobileInstalls" /></div>
                            <div class="pma-field"><label>Chat sessions 30d</label><InputNumber class="pma-input" @bind-Value="_form.ChatSessions30d" /></div>
                            <div class="pma-field"><label>API calls 30d</label><InputNumber class="pma-input" @bind-Value="_form.ApiCalls30d" /></div>
                        </div>
                    </article>
                    <article class="pma-panel"><div class="pma-panel-header"><i class="bi bi-speedometer2"></i><div><strong>Capacity</strong><span>Storage and renewal signal.</span></div></div><div class="pma-capacity-card"><strong>@StoragePercent%</strong><span>storage utilized</span><div class="pma-meter"><span style="width:@StoragePercent%"></span></div><small>@_form.StorageUsedGb of @_form.StorageLimitGb GB used</small></div></article>
                </section>
            }
            else if (_activeTab == "security")
            {
                <section class="pma-grid">
                    <article class="pma-panel pma-panel--large">
                        <div class="pma-panel-header"><i class="bi bi-shield-lock"></i><div><strong>Security and access controls</strong><span>Client portal access policy and published modules.</span></div></div>
                        <div class="pma-switch-grid">
                            @SecuritySwitch("MFA required", "Require multi-factor authentication for tenant admins.", "bi-shield-check", _form.MfaEnabled, value => _form.MfaEnabled = value)
                            @SecuritySwitch("SSO enabled", "Allow single sign-on for portal login.", "bi-key", _form.SsoEnabled, value => _form.SsoEnabled = value)
                            @SecuritySwitch("Branding published", "Make white-label branding visible to portal users.", "bi-palette", _form.BrandingPublished, value => _form.BrandingPublished = value)
                            @SecuritySwitch("Mobile app published", "Allow mobile users to access the tenant app.", "bi-phone", _form.MobileAppPublished, value => _form.MobileAppPublished = value)
                            @SecuritySwitch("Chat enabled", "Enable embedded chat assistant for portal users.", "bi-chat-dots", _form.ChatEnabled, value => _form.ChatEnabled = value)
                        </div>
                    </article>
                    <article class="pma-panel"><div class="pma-panel-header"><i class="bi bi-heart-pulse"></i><div><strong>Health checks</strong><span>Live account posture.</span></div></div><div class="pma-health-list">@foreach (var h in _account.HealthChecks) { <div class="pma-health-row pma-health--@StatusCss(h.Status)"><i class="bi @h.Icon"></i><div><strong>@h.Name</strong><span>@h.Detail</span></div><em>@h.Status</em></div> }</div></article>
                </section>
            }
            else if (_activeTab == "support")
            {
                <section class="pma-grid">
                    <article class="pma-panel pma-panel--large">
                        <div class="pma-panel-header"><i class="bi bi-headset"></i><div><strong>Support channels</strong><span>Published contact points and portal routing.</span></div></div>
                        <div class="pma-form-grid">
                            <div class="pma-field"><label>Support email</label><InputText class="pma-input" @bind-Value="_form.SupportEmail" /></div>
                            <div class="pma-field"><label>Support phone</label><InputText type="tel" class="pma-input" placeholder="(555) 123-4567" inputmode="tel" autocomplete="tel" @bind-Value="_form.SupportPhone" /><small class="text-muted">Use enterprise phone format: (555) 123-4567 or +1 555 123 4567 x123.</small></div>
                            <div class="pma-field pma-field--full"><label>Portal domain</label><InputText class="pma-input" @bind-Value="_form.PortalDomain" /></div>
                        </div>
                    </article>
                    <article class="pma-panel"><div class="pma-panel-header"><i class="bi bi-clock-history"></i><div><strong>Recent activity</strong><span>Account workflow history.</span></div></div><div class="pma-activity-list">@foreach (var a in _account.RecentActivity.OrderByDescending(x => x.OccurredAtUtc).Take(8)) { <div class="pma-activity-row pma-activity--@StatusCss(a.Severity)"><i class="bi @a.Icon"></i><div><strong>@a.Title</strong><span>@a.Detail</span><small>@FormatRelative(a.OccurredAtUtc)</small></div></div> }</div></article>
                </section>
            }
        </EditForm>
    }
</div>

@code {
    private readonly TabItem[] _tabs =
    [
        new("overview", "Overview", "bi-grid-1x2"),
        new("identity", "Ownership", "bi-building"),
        new("subscription", "Subscription", "bi-credit-card"),
        new("security", "Security", "bi-shield-lock"),
        new("support", "Support", "bi-headset")
    ];

    private Guid _tenantId;
    private bool _loading;
    private bool _saving;
    private string _activeTab = "overview";
    private string _activeKpi = "all";
    private string? _loadError;
    private string? _toastMessage;
    private string _toastClass = "pma-toast--success";
    private PortalMyAccountDto _account = new();
    private AccountFormModel _form = new();
    private bool _busy => _loading || _saving;

    private string DisplayName => string.IsNullOrWhiteSpace(_form.AgencyName) ? "Portal account" : _form.AgencyName;
    private int StoragePercent => _form.StorageLimitGb <= 0 ? 0 : Math.Clamp((int)Math.Round(_form.StorageUsedGb * 100m / _form.StorageLimitGb), 0, 100);
    private int ReadinessScore => Math.Clamp(55 + (_form.MfaEnabled ? 10 : 0) + (_form.SsoEnabled ? 10 : 0) + (_form.BrandingPublished ? 8 : 0) + (_form.MobileAppPublished ? 7 : 0) + (_form.ChatEnabled ? 5 : 0) + (StoragePercent < 80 ? 5 : 0), 0, 100);
    private string ReadinessSummary => ReadinessScore >= 90 ? "Enterprise ready" : ReadinessScore >= 75 ? "Operational with a few actions" : "Needs administrative review";

    private IEnumerable<KpiItem> Kpis =>
    [
        new("all", "Portal Users", "bi-people", _form.PortalUsers.ToString("N0"), $"{_form.ActivePortalUsers:N0} active", "Show complete account overview"),
        new("requests", "Open Requests", "bi-inbox", _form.OpenRequests.ToString("N0"), $"{_form.UrgentRequests:N0} urgent", "Focus request queue", "subscription"),
        new("documents", "Shared Docs", "bi-folder2-open", _form.SharedDocuments.ToString("N0"), $"{_form.StorageUsedGb:N0} GB used", "Focus document activity", "subscription"),
        new("mobile", "Mobile", "bi-phone", _form.MobileInstalls.ToString("N0"), _form.MobileAppPublished ? "published" : "draft", "Focus mobile access", "security"),
        new("security", "Security", "bi-shield-check", ReadinessScore.ToString("N0") + "%", _form.MfaEnabled ? "MFA active" : "MFA off", "Focus security controls", "security")
    ];

    private IEnumerable<PriorityItem> PriorityItems
    {
        get
        {
            if (!_form.MfaEnabled) yield return new(98, "Enable MFA", "Protect tenant administrators before broad portal rollout.", "pma-score--danger", "security");
            if (!_form.SsoEnabled) yield return new(86, "Review SSO", "Single sign-on is not enabled for portal access.", "pma-score--warning", "security");
            if (_form.UrgentRequests > 0) yield return new(82, "Triage urgent requests", $"{_form.UrgentRequests:N0} urgent self-service requests need review.", "pma-score--warning", "subscription");
            if (StoragePercent >= 80) yield return new(78, "Review storage capacity", $"Storage is {StoragePercent:N0}% utilized.", "pma-score--warning", "subscription");
            if (!_form.BrandingPublished) yield return new(72, "Publish branding", "White-label portal branding is not published.", "pma-score--info", "security");
            yield return new(65, "Verify support routing", "Confirm support email, phone, and portal domain are current.", "pma-score--success", "support");
        }
    }

    private IEnumerable<MetricItem> UsageMetrics =>
    [
        new("Monthly logins", _form.MonthlyLoginCount.ToString("N0")),
        new("Mobile installs", _form.MobileInstalls.ToString("N0")),
        new("Chat sessions 30d", _form.ChatSessions30d.ToString("N0")),
        new("API calls 30d", _form.ApiCalls30d.ToString("N0")),
        new("Pending invites", _form.PendingInvites.ToString("N0"))
    ];

    private string WorkflowTitle => _activeKpi switch
    {
        "requests" => "Request workflow",
        "documents" => "Document workflow",
        "mobile" => "Mobile workflow",
        "security" => "Security workflow",
        _ => "Enterprise workflow"
    };

    private string WorkflowSummary => _activeKpi switch
    {
        "requests" => $"{_form.OpenRequests:N0} open requests with {_form.UrgentRequests:N0} urgent items requiring administrator attention.",
        "documents" => $"{_form.SharedDocuments:N0} shared documents using {_form.StorageUsedGb:N0} GB of {_form.StorageLimitGb:N0} GB capacity.",
        "mobile" => $"{_form.MobileInstalls:N0} mobile installs and mobile app is {(_form.MobileAppPublished ? "published" : "not published") }.",
        "security" => $"Readiness is {ReadinessScore:N0}% with MFA {(_form.MfaEnabled ? "enabled" : "disabled")} and SSO {(_form.SsoEnabled ? "enabled" : "disabled") }.",
        _ => $"{_form.PortalUsers:N0} portal users, {_form.OpenRequests:N0} open requests, {_form.SharedDocuments:N0} shared documents, and {_form.ApiCalls30d:N0} API calls in the last 30 days."
    };

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Portal", "/portal/users"), new("My Account", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _account = await Api.GetPortalMyAccountAsync(_tenantId) ?? new PortalMyAccountDto { TenantId = _tenantId };
            _form = AccountFormModel.FromDto(_account);
        }
        catch (Exception ex)
        {
            _loadError = $"Unable to load portal account: {ex.Message}";
            ShowToast(_loadError, true);
        }
        finally { _loading = false; }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            _account = _form.ToDto(_account, _tenantId);
            await Api.UpdatePortalMyAccountAsync(_tenantId, _account);
            ShowToast("Tenant admin portal account saved.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", true);
        }
        finally { _saving = false; }
    }

    private void SetKpi(string key)
    {
        _activeKpi = key;
        var target = Kpis.FirstOrDefault(k => k.Key == key)?.TargetTab;
        if (!string.IsNullOrWhiteSpace(target))
            _activeTab = target;
    }

    private bool IsActiveKpi(string key) => _activeKpi == key;

    private void NavigateWorkflow(string key)
    {
        var route = key switch
        {
            "users" => "/portal/users",
            "requests" => "/portal/requests",
            "documents" => "/portal/documents",
            "activity" => "/portal/activity",
            _ => "/portal/my-account"
        };
        Nav.NavigateTo(route);
    }

    private RenderFragment SecuritySwitch(string title, string detail, string icon, bool value, Action<bool> setValue) => @<label class="pma-switch-card @(value ? "pma-switch-card--on" : null)">
        <input type="checkbox" checked="@value" @onchange="e => setValue(e.Value is true)" />
        <i class="bi @icon" aria-hidden="true"></i>
        <span>@title</span>
        <small>@detail</small>
        <em>@(value ? "On" : "Off")</em>
    </label>;

    private void ShowToast(string message, bool danger = false)
    {
        _toastMessage = message;
        _toastClass = danger ? "pma-toast--danger" : "pma-toast--success";
    }

    private void ClearToast() => _toastMessage = null;

    private static string Initials(string value)
    {
        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : value.Length > 0 ? value[..1] : "A";
    }

    private static string StatusCss(string value) => string.IsNullOrWhiteSpace(value) ? "neutral" : value.ToLowerInvariant().Replace(" ", "-");

    private static string FormatRelative(DateTime utc)
    {
        if (utc == default) return "never";
        var diff = DateTime.UtcNow - utc.ToUniversalTime();
        if (diff.TotalMinutes < 60) return $"{Math.Max(1, (int)diff.TotalMinutes)}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }

    private sealed record TabItem(string Key, string Label, string Icon);
    private sealed record KpiItem(string Key, string Label, string Icon, string Value, string Detail, string Tooltip, string TargetTab = "overview");
    private sealed record PriorityItem(int Score, string Title, string Detail, string Css, string TargetTab);
    private sealed record MetricItem(string Label, string Value);

    private sealed class AccountFormModel
    {
        [Required]
        [StringLength(200)]
        public string AgencyName { get; set; } = string.Empty;

        [Required]
        [StringLength(200)]
        public string AdminName { get; set; } = string.Empty;

        [Required]
        [StringLength(320)]
        public string AdminEmail { get; set; } = string.Empty;

        [StringLength(80)]
        public string AdminRole { get; set; } = string.Empty;

        [AmsPhone]
        [StringLength(50)]
        public string AdminPhone { get; set; } = string.Empty;

        [StringLength(120)]
        public string TimeZone { get; set; } = string.Empty;

        [StringLength(40)]
        public string Locale { get; set; } = string.Empty;

