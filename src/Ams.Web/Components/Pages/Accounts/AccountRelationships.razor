@page "/accounts/{AccountId:guid}/relationships"
@namespace Ams.Web.Components.Pages.Accounts
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject NavigationContextService NavContext
@using Ams.Application.Common.Dtos

<PageTitle>@(_account?.AccountName ?? "Account") Relationships — Tenant Admin</PageTitle>

<AppPageHeader Title="Account Relationships"
               Subtitle="Tenant Admin relationship map for parent, child, and related account links"
               Icon="bi-link-45deg">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo($"/accounts/{AccountId}")'><i class="bi bi-person-vcard"></i> Account 360</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </Actions>
</AppPageHeader>

<div class="rel-page">
    <section class="rel-hero">
        <div class="rel-hero-copy">
            <span class="rel-eyebrow">Tenant Admin · Account Intelligence</span>
            <h2>@(_account?.AccountName ?? "Account") Relationship Map</h2>
            <p>Review parent, child, and related account links with operational context for servicing and account strategy.</p>
        </div>
        <div class="rel-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo($"/accounts/{AccountId}")'>
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Account
            </button>
            <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo($"/accounts/{AccountId}/hierarchy")'>
                <i class="bi bi-diagram-3" aria-hidden="true"></i> Hierarchy
            </button>
        </div>
    </section>

    <div class="rel-kpi-strip">
        <button type="button" class="rel-kpi-card @(_activeFilter is null ? "rel-kpi-card--active" : "")" title="Show all relationships" @onclick='() => SetFilter(null)'>
            <span class="rel-kpi-icon rel-kpi-icon--total"><i class="bi bi-link-45deg" aria-hidden="true"></i></span>
            <span class="rel-kpi-copy"><strong>@_relationships.Count</strong><span>Relationships</span></span>
        </button>
        <button type="button" class="rel-kpi-card @(_activeFilter == "Parent" ? "rel-kpi-card--active" : "")" title="Show parent accounts" @onclick='() => SetFilter("Parent")'>
            <span class="rel-kpi-icon rel-kpi-icon--parent"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i></span>
            <span class="rel-kpi-copy"><strong>@_relationships.Count(x => x.RelationshipType == "Parent")</strong><span>Parents</span></span>
        </button>
        <button type="button" class="rel-kpi-card @(_activeFilter == "Child" ? "rel-kpi-card--active" : "")" title="Show child accounts" @onclick='() => SetFilter("Child")'>
            <span class="rel-kpi-icon rel-kpi-icon--child"><i class="bi bi-arrow-down-circle" aria-hidden="true"></i></span>
            <span class="rel-kpi-copy"><strong>@_relationships.Count(x => x.RelationshipType == "Child")</strong><span>Children</span></span>
        </button>
        <button type="button" class="rel-kpi-card @(_activeFilter == "Related" ? "rel-kpi-card--active" : "")" title="Show related accounts" @onclick='() => SetFilter("Related")'>
            <span class="rel-kpi-icon rel-kpi-icon--related"><i class="bi bi-intersect" aria-hidden="true"></i></span>
            <span class="rel-kpi-copy"><strong>@_relationships.Count(x => x.RelationshipType == "Related")</strong><span>Related</span></span>
        </button>
    </div>

    <div class="rel-filter-bar">
        <div class="rel-search-wrap">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input class="rel-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search related account name, number, type…" />
        </div>
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
        <span class="rel-filter-count">@Filtered.Count() links</span>
    </div>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger rel-alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError
        </div>
    }

    <section class="rel-panel">
        <div class="rel-panel-header">
            <div>
                <span class="rel-panel-eyebrow">Relationship Directory</span>
                <h3>Linked Accounts</h3>
            </div>
            <span class="rel-panel-count">@Filtered.Count() shown</span>
        </div>

        @if (_loading)
        {
            <div class="rel-loading"><span class="um-spin" aria-hidden="true"></span><span>Loading relationships…</span></div>
        }
        else if (!Filtered.Any())
        {
            <div class="rel-empty">
                <span class="rel-empty-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
                <h3>No relationships found</h3>
                <p>Adjust the filters or return to Account 360 to manage account hierarchy details.</p>
                <button class="um-btn um-btn-primary" @onclick="ResetFilters"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Clear Filters</button>
            </div>
        }
        else
        {
            <div class="rel-list" role="list">
                @foreach (var r in Filtered)
                {
                    <article class="rel-row" role="listitem" @onclick='() => Nav.NavigateTo($"/accounts/{r.AccountId}")'>
                        <div class="rel-row-main">
                            <div class="rel-avatar @RelationshipTone(r.RelationshipType)">@AccountPageConstants.Initials(r.AccountName)</div>
                            <div class="rel-account-copy">
                                <div class="rel-account-name">@r.AccountName</div>
                                <div class="rel-account-meta"><span>@r.AccountNumber</span><span>@r.AccountTypeCode</span></div>
                            </div>
                        </div>
                        <div class="rel-row-details">
                            <span class="rel-type @RelationshipTone(r.RelationshipType)"><i class="bi @RelationshipIcon(r.RelationshipType)" aria-hidden="true"></i>@r.RelationshipType</span>
                            <span class="@AccountPageConstants.StatusBadge(r.StatusCode)">@r.StatusCode</span>
                        </div>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm rel-open" title="Open related account" @onclick='() => Nav.NavigateTo($"/accounts/{r.AccountId}")' @onclick:stopPropagation="true">
                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </button>
                    </article>
                }
            </div>
        }
    </section>
</div>

@code {
    [Parameter] public Guid AccountId { get; set; }
    AccountDto? _account;
    List<AccountDto> _accounts = [];
    List<AccountRelationshipItem> _relationships = [];
    string _search = string.Empty;
    string? _activeFilter, _loadError;
    bool _loading;
    IEnumerable<AccountRelationshipItem> Filtered => _relationships.Where(x => (_activeFilter is null || x.RelationshipType == _activeFilter) && (string.IsNullOrWhiteSpace(_search) || x.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.AccountNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.AccountTypeCode.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Accounts", "/accounts"), new("Relationships")); await LoadAsync(); }
    async Task LoadAsync() { _loading = true; _loadError = null; try { _account = await Api.GetAccountByIdAsync(AccountId); var result = await Api.SearchAccountsAsync(AccountPageConstants.TenantId); _accounts = result?.Items.ToList() ?? []; if (_account is not null) { _relationships = AccountPageData.BuildRelationships(_account, _accounts); NavContext.SetAccount(AccountId, _account.AccountName); Breadcrumbs.SetCrumbs(new("Accounts", "/accounts"), new(_account.AccountName, $"/accounts/{AccountId}"), new("Relationships")); } } catch (Exception ex) { _loadError = $"Failed to load relationships: {ex.Message}"; } finally { _loading = false; } }
    void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _search = e.Value?.ToString() ?? string.Empty;
    void SetFilter(string? key) => _activeFilter = key;
    void ResetFilters() { _activeFilter = null; _search = string.Empty; }
    static string RelationshipIcon(string type) => type switch { "Parent" => "bi-arrow-up-circle", "Child" => "bi-arrow-down-circle", _ => "bi-intersect" };
    static string RelationshipTone(string type) => type switch { "Parent" => "rel-tone--parent", "Child" => "rel-tone--child", _ => "rel-tone--related" };
}
