@page "/accounts/new"
@namespace Ams.Web.Components.Pages.Accounts
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject CurrentUserContext CurrentUser
@using Ams.Application.Features.Accounts
@using Ams.Application.Common.Dtos
@using Ams.Application.Common.Validation
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>New Account - Tenant Admin</PageTitle>

<AppPageHeader Title="New Account"
               Subtitle="Tenant Admin account creation for customer and prospect master records"
               Icon="bi-plus-circle">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/accounts")'><i class="bi bi-arrow-left"></i> Accounts</button>
    </Actions>
</AppPageHeader>

<section class="ma-hero acct-hero">
    <div>
        <span class="ma-eyebrow">Tenant Admin - Accounts</span>
        <h2>Create Account Master Record</h2>
        <p>Capture account identity, lifecycle, segmentation, and financial profile. Required fields follow the account database contract.</p>
    </div>
    <div class="ma-hero-actions">
        <button class="um-btn um-btn-primary" type="button" @onclick="SubmitAsync" disabled="@_saving"><i class="bi bi-check-lg"></i> Create Account</button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="ResetForm"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
    </div>
</section>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div>
}

<div class="acct-form-card">
    <EditForm EditContext="@_editContext" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <div class="um-modal-body"><div class="um-form-grid">
            <div class="um-field"><label>Account Number</label><div class="um-input acct-generated-number" aria-readonly="true"><i class="bi bi-shield-lock me-2"></i>Generated automatically when saved</div></div>
            <div class="um-field"><label>Account Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.AccountName" class="um-input" /></div>
            <div class="um-field"><label>Account Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.AccountTypeCode" class="um-input">@foreach (var type in _typeOptions) { <option value="@type.Code">@type.Name</option> }</InputSelect></div>
            <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input">@foreach (var status in _statusOptions) { <option value="@status.Code">@status.Name</option> }</InputSelect></div>
            <div class="um-field"><label>Segment</label><InputSelect @bind-Value="_form.SegmentCode" class="um-input"><option value="">None</option>@foreach (var segment in _segmentOptions) { <option value="@segment.Code">@segment.Name</option> }</InputSelect></div>
            <div class="um-field"><label>Lifecycle Stage</label><InputSelect @bind-Value="_form.LifecycleStageCode" class="um-input"><option value="">None</option>@foreach (var stage in _lifecycleStageOptions) { <option value="@stage.Code">@stage.Name</option> }</InputSelect></div>
            <div class="um-field"><label>Email</label><InputText @bind-Value="_form.MainEmail" class="um-input" /><ValidationMessage For="() => _form.MainEmail" class="text-danger" /></div>
            <div class="um-field"><label>Phone</label><InputText Value="@_form.MainPhone" ValueChanged="OnPhoneChanged" ValueExpression="() => _form.MainPhone" class="um-input" /><small>Phone is normalized for dialing and display.</small><ValidationMessage For="() => _form.MainPhone" class="text-danger" /></div>
            <div class="um-field"><label>Industry</label><InputSelect @bind-Value="_form.Industry" class="um-input"><option value="">None</option>@foreach (var industry in _industryOptions) { <option value="@industry.Code">@industry.Name</option> }</InputSelect></div>
            <div class="um-field"><label>Website</label><InputText @bind-Value="_form.Website" class="um-input" placeholder="https://example.com" /><ValidationMessage For="() => _form.Website" class="text-danger" /></div>
            <div class="um-field"><label>Annual Revenue</label><InputNumber @bind-Value="_form.AnnualRevenue" class="um-input" /><ValidationMessage For="() => _form.AnnualRevenue" class="text-danger" /></div>
        </div></div>
        <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/accounts")'>Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_saving ? "Creating?" : "Create Account")</button></div>
    </EditForm>
</div>

<EnterpriseToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true"  />

@code {
    AccountNewFormModel _form = new();
    EditContext _editContext = default!;
    EnterpriseToast _toast = default!;
    bool _saving;
    string? _loadError;
    Guid _tenantId;
    List<AccountOption> _typeOptions = [];
    List<AccountOption> _statusOptions = [];
    List<AccountOption> _segmentOptions = [];
    List<AccountOption> _lifecycleStageOptions = [];
    List<AccountOption> _industryOptions = [];

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Accounts", "/accounts"), new("New Account", "/accounts/new"));
        await LoadReferenceDataAsync();
        ResetForm();
    }

    async Task LoadReferenceDataAsync()
    {
        var accountTypes = await Api.SearchAccountTypesAsync(_tenantId, pageSize: 200);
        _typeOptions = accountTypes?.Items.Where(t => t.IsActive).OrderBy(t => t.SortOrder).ThenBy(t => t.TypeName).Select(t => new AccountOption(t.TypeCode, t.TypeName, t.IsDefault)).ToList() ?? [];

        var options = await Api.GetAccountReferenceOptionsAsync(_tenantId);
        var activeOptions = options?.Where(o => o.IsActive).ToList() ?? [];
        _statusOptions = ToOptions(activeOptions, "Status");
        _segmentOptions = ToOptions(activeOptions, "Segment");
        _lifecycleStageOptions = ToOptions(activeOptions, "LifecycleStage");
        _industryOptions = ToOptions(activeOptions, "Industry");
    }

    async Task SubmitAsync()
    {
        if (!_editContext.Validate()) return;
        _saving = true;
        try
        {
            var id = await Api.CreateAccountAsync(new CreateAccountRequest
            {
                TenantId = _tenantId,
                AccountName = Normalize(_form.AccountName) ?? string.Empty,
                AccountTypeCode = Normalize(_form.AccountTypeCode) ?? DefaultOptionCode(_typeOptions),
                MainEmail = Normalize(_form.MainEmail),
                MainPhone = Normalize(FormatPhone(_form.MainPhone)),
                StatusCode = Normalize(_form.StatusCode) ?? DefaultOptionCode(_statusOptions),
                SegmentCode = Normalize(_form.SegmentCode),
                LifecycleStageCode = Normalize(_form.LifecycleStageCode),
                Industry = Normalize(_form.Industry),
                Website = Normalize(_form.Website),
                AnnualRevenue = _form.AnnualRevenue
            });
            await _toast.ShowAsync(new() { Content = "Account created", CssClass = "enterprise-toast-success" });
            Nav.NavigateTo($"/accounts/{id}");
        }
        catch (Exception ex)
        {
            _loadError = $"Create failed: {ex.Message}";
            await _toast.ShowAsync(new() { Content = $"Create failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
        }
        finally { _saving = false; }
    }

    void ResetForm()
    {
        _form = new()
        {
            AccountTypeCode = DefaultOptionCode(_typeOptions),
            StatusCode = DefaultOptionCode(_statusOptions),
            LifecycleStageCode = DefaultOptionCode(_lifecycleStageOptions)
        };
        _editContext = new(_form);
    }

    static List<AccountOption> ToOptions(IEnumerable<AccountReferenceOptionDto> options, string group) =>
        options.Where(o => string.Equals(o.OptionGroup, group, StringComparison.OrdinalIgnoreCase)).OrderBy(o => o.SortOrder).ThenBy(o => o.OptionName).Select(o => new AccountOption(o.OptionCode, o.OptionName, o.IsDefault)).ToList();

    static string DefaultOptionCode(IReadOnlyList<AccountOption> options) => options.FirstOrDefault(o => o.IsDefault)?.Code ?? options.FirstOrDefault()?.Code ?? string.Empty;

    static string? Normalize(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    void OnPhoneChanged(string? value) => _form.MainPhone = FormatPhone(value);

    static string? FormatPhone(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        var digits = new string(value.Where(char.IsDigit).ToArray());
        if (digits.Length == 11 && digits[0] == '1') digits = digits[1..];
        return digits.Length == 10 ? $"({digits[..3]}) {digits[3..6]}-{digits[6..]}" : value.Trim();
    }

    sealed record AccountOption(string Code, string Name, bool IsDefault);

    sealed class AccountNewFormModel
    {
        [Required, StringLength(300)] public string AccountName { get; set; } = string.Empty;
        [Required, StringLength(50)] public string AccountTypeCode { get; set; } = string.Empty;
        [AmsEmailAddress, StringLength(300)] public string? MainEmail { get; set; }
        [AmsPhone, StringLength(50)] public string? MainPhone { get; set; }
        [Required, StringLength(50)] public string StatusCode { get; set; } = string.Empty;
        [StringLength(50)] public string? SegmentCode { get; set; }
        [StringLength(50)] public string? LifecycleStageCode { get; set; }
        [StringLength(100)] public string? Industry { get; set; }
        [Url, StringLength(200)] public string? Website { get; set; }
        [Range(0, 999999999999)] public decimal? AnnualRevenue { get; set; }
    }
}
