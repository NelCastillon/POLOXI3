@page "/accounts/new"
@namespace Ams.Web.Components.Pages.Accounts
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Features.Accounts

<PageTitle>New Account — Tenant Admin</PageTitle>

<AppPageHeader Title="New Account"
               Subtitle="Tenant Admin account creation for customer and prospect master records"
               Icon="bi-plus-circle">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/accounts")'><i class="bi bi-arrow-left"></i> Accounts</button>
    </Actions>
</AppPageHeader>

<section class="ma-hero acct-hero">
    <div>
        <span class="ma-eyebrow">Tenant Admin · Accounts</span>
        <h2>Create Account Master Record</h2>
        <p>Capture account identity, lifecycle, segmentation, and financial profile. Required fields follow the account database contract.</p>
    </div>
    <div class="ma-hero-actions">
        <button class="um-btn um-btn-primary" type="button" @onclick="SubmitAsync" disabled="@_saving"><i class="bi bi-check-lg"></i> Create Account</button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="ResetForm"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
    </div>
</section>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div>
}

<div class="acct-form-card">
    <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
        <DataAnnotationsValidator />
        <div class="um-modal-body"><div class="um-form-grid">
            <div class="um-field"><label>Account Number <span class="text-danger">*</span></label><InputText @bind-Value="_form.AccountNumber" class="um-input" /><ValidationMessage For="() => _form.AccountNumber" class="text-danger" /></div>
            <div class="um-field"><label>Account Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.AccountName" class="um-input" /><ValidationMessage For="() => _form.AccountName" class="text-danger" /></div>
            <div class="um-field"><label>Account Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.AccountTypeCode" class="um-input">@foreach (var type in AccountPageConstants.Types) { <option value="@type">@type</option> }</InputSelect><ValidationMessage For="() => _form.AccountTypeCode" class="text-danger" /></div>
            <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input">@foreach (var status in AccountPageConstants.Statuses) { <option value="@status">@status</option> }</InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
            <div class="um-field"><label>Segment</label><InputSelect @bind-Value="_form.SegmentCode" class="um-input"><option value="">None</option>@foreach (var segment in AccountPageConstants.Segments) { <option value="@segment">@segment</option> }</InputSelect><ValidationMessage For="() => _form.SegmentCode" class="text-danger" /></div>
            <div class="um-field"><label>Lifecycle Stage</label><InputSelect @bind-Value="_form.LifecycleStageCode" class="um-input"><option value="">None</option>@foreach (var stage in AccountPageConstants.LifecycleStages) { <option value="@stage">@stage</option> }</InputSelect><ValidationMessage For="() => _form.LifecycleStageCode" class="text-danger" /></div>
            <div class="um-field"><label>Email</label><InputText @bind-Value="_form.MainEmail" class="um-input" /><ValidationMessage For="() => _form.MainEmail" class="text-danger" /></div>
            <div class="um-field"><label>Phone</label><InputText @bind-Value="_form.MainPhone" class="um-input" /><ValidationMessage For="() => _form.MainPhone" class="text-danger" /></div>
            <div class="um-field"><label>Industry</label><InputText @bind-Value="_form.Industry" class="um-input" /><ValidationMessage For="() => _form.Industry" class="text-danger" /></div>
            <div class="um-field"><label>Website</label><InputText @bind-Value="_form.Website" class="um-input" placeholder="https://example.com" /><ValidationMessage For="() => _form.Website" class="text-danger" /></div>
            <div class="um-field"><label>Annual Revenue</label><InputNumber @bind-Value="_form.AnnualRevenue" class="um-input" /><ValidationMessage For="() => _form.AnnualRevenue" class="text-danger" /></div>
        </div></div>
        <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/accounts")'>Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_saving ? "Creating…" : "Create Account")</button></div>
    </EditForm>
</div>

<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />

@code {
    AccountFormModel _form = new();
    EditContext _editContext = default!;
    SfToast _toast = default!;
    bool _saving;
    string? _loadError;

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Accounts", "/accounts"), new("New Account", "/accounts/new"));
        _editContext = new(_form);
    }

    async Task SubmitAsync()
    {
        if (!_editContext.Validate()) return;
        _saving = true;
        try
        {
            var id = await Api.CreateAccountAsync(new CreateAccountRequest
            {
                TenantId = AccountPageConstants.TenantId,
                AccountNumber = _form.AccountNumber,
                AccountName = _form.AccountName,
                AccountTypeCode = _form.AccountTypeCode,
                MainEmail = AccountPageConstants.Normalize(_form.MainEmail),
                MainPhone = AccountPageConstants.Normalize(_form.MainPhone),
                StatusCode = _form.StatusCode,
                SegmentCode = AccountPageConstants.Normalize(_form.SegmentCode),
                LifecycleStageCode = AccountPageConstants.Normalize(_form.LifecycleStageCode),
                Industry = AccountPageConstants.Normalize(_form.Industry),
                Website = AccountPageConstants.Normalize(_form.Website),
                AnnualRevenue = _form.AnnualRevenue
            });
            await _toast.ShowAsync(new() { Content = "Account created", CssClass = "e-toast-success" });
            Nav.NavigateTo($"/accounts/{id}");
        }
        catch (Exception ex)
        {
            _loadError = $"Create failed: {ex.Message}";
            await _toast.ShowAsync(new() { Content = $"Create failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
        finally { _saving = false; }
    }

    void ResetForm()
    {
        _form = new();
        _editContext = new(_form);
    }
}
