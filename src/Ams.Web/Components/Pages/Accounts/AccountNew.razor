@page "/accounts/new"
@namespace Ams.Web.Components.Pages.Accounts.Details
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.DropDowns
@inject ApiClient Api
@inject HttpClient HttpClient
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>New Account</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="New Account"
               Subtitle="Create a new account record"
               Icon="bi-plus-circle">
</AppPageHeader>

<div class="acn-container">
    <div class="acn-form-card">
        <form @onsubmit="HandleSubmit">
            <div class="acn-form-section">
                <h2 class="acn-section-title">Account Information</h2>

                <div class="acn-form-grid">
                    <div class="acn-form-group">
                        <label for="accountName" class="acn-label">Account Name *</label>
                        <input type="text" id="accountName" class="acn-input" 
                               @bind="_form.AccountName" placeholder="Enter account name" required />
                    </div>

                    <div class="acn-form-group">
                        <label for="accountNumber" class="acn-label">Account Number *</label>
                        <input type="text" id="accountNumber" class="acn-input" 
                               @bind="_form.AccountNumber" placeholder="Auto-generated if empty" />
                    </div>

                    <div class="acn-form-group">
                        <label for="accountType" class="acn-label">Account Type *</label>
                        <SfDropDownList TValue="string" TItem="LV" DataSource="_accountTypeOptions" 
                                      Placeholder="Select type" ShowClearButton="false"
                                      @bind-Value="_form.AccountTypeCode">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>

                    <div class="acn-form-group">
                        <label for="status" class="acn-label">Status</label>
                        <SfDropDownList TValue="string" TItem="LV" DataSource="_statusOptions" 
                                      Placeholder="Select status" ShowClearButton="false"
                                      @bind-Value="_form.StatusCode">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>

                    <div class="acn-form-group">
                        <label for="segment" class="acn-label">Segment</label>
                        <SfDropDownList TValue="string" TItem="LV" DataSource="_segmentOptions" 
                                      Placeholder="Select segment" ShowClearButton="true"
                                      @bind-Value="_form.SegmentCode">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>

                    <div class="acn-form-group">
                        <label for="industry" class="acn-label">Industry</label>
                        <input type="text" id="industry" class="acn-input" 
                               @bind="_form.Industry" placeholder="Enter industry" />
                    </div>
                </div>
            </div>

            <div class="acn-form-section">
                <h2 class="acn-section-title">Contact Information</h2>

                <div class="acn-form-grid">
                    <div class="acn-form-group">
                        <label for="email" class="acn-label">Email</label>
                        <input type="email" id="email" class="acn-input" 
                               @bind="_form.MainEmail" placeholder="Enter email address" />
                    </div>

                    <div class="acn-form-group">
                        <label for="phone" class="acn-label">Phone</label>
                        <input type="tel" id="phone" class="acn-input" 
                               @bind="_form.MainPhone" placeholder="Enter phone number" />
                    </div>

                    <div class="acn-form-group">
                        <label for="website" class="acn-label">Website</label>
                        <input type="url" id="website" class="acn-input" 
                               @bind="_form.Website" placeholder="https://example.com" />
                    </div>

                    <div class="acn-form-group">
                        <label for="street" class="acn-label">Street Address</label>
                        <input type="text" id="street" class="acn-input" 
                               @bind="_form.StreetAddress" placeholder="Enter street address" />
                    </div>

                    <div class="acn-form-group">
                        <label for="city" class="acn-label">City</label>
                        <input type="text" id="city" class="acn-input" 
                               @bind="_form.City" placeholder="Enter city" />
                    </div>

                    <div class="acn-form-group">
                        <label for="state" class="acn-label">State</label>
                        <input type="text" id="state" class="acn-input" 
                               @bind="_form.State" placeholder="Enter state" maxlength="2" />
                    </div>

                    <div class="acn-form-group">
                        <label for="zip" class="acn-label">ZIP Code</label>
                        <input type="text" id="zip" class="acn-input" 
                               @bind="_form.ZipCode" placeholder="Enter ZIP code" />
                    </div>

                    <div class="acn-form-group">
                        <label for="country" class="acn-label">Country</label>
                        <input type="text" id="country" class="acn-input" 
                               @bind="_form.Country" placeholder="United States" />
                    </div>
                </div>
            </div>

            <div class="acn-form-section">
                <h2 class="acn-section-title">Financial Information</h2>

                <div class="acn-form-grid">
                    <div class="acn-form-group">
                        <label for="annualRevenue" class="acn-label">Annual Revenue</label>
                        <input type="number" id="annualRevenue" class="acn-input" 
                               @bind="_form.AnnualRevenue" placeholder="0.00" step="0.01" />
                    </div>

                    <div class="acn-form-group">
                        <label for="taxId" class="acn-label">Tax ID / EIN</label>
                        <input type="text" id="taxId" class="acn-input" 
                               @bind="_form.TaxId" placeholder="Enter tax ID" />
                    </div>
                </div>
            </div>

            <div class="acn-form-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/accounts")'>
                    <i class="bi bi-x" aria-hidden="true"></i> Cancel
                </button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">
                    @if (_saving) { <span class="um-spin" aria-hidden="true"></span> }
                    else { <i class="bi bi-plus-lg" aria-hidden="true"></i> }
                    @(_saving ? "Creating…" : "Create Account")
                </button>
            </div>
        </form>
    </div>
</div>

@code {
    private SfToast _toast = null!;
    private bool _saving = false;

    private AccountFormModel _form = new();

    private List<LV> _accountTypeOptions = [];
    private List<LV> _statusOptions = [];
    private List<LV> _segmentOptions = [];

    record LV(string Label, string Value);

    record AccountFormModel
    {
        public string? AccountNumber { get; set; }
        public string AccountName { get; set; } = string.Empty;
        public string AccountTypeCode { get; set; } = string.Empty;
        public string StatusCode { get; set; } = "Active";
        public string? SegmentCode { get; set; }
        public string? Industry { get; set; }
        public string? MainEmail { get; set; }
        public string? MainPhone { get; set; }
        public string? Website { get; set; }
        public string? StreetAddress { get; set; }
        public string? City { get; set; }
        public string? State { get; set; }
        public string? ZipCode { get; set; }
        public string? Country { get; set; } = "United States";
        public decimal? AnnualRevenue { get; set; }
        public string? TaxId { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var breadcrumbs = new BreadcrumbService.BreadcrumbItem[] {
            new("Accounts", "/accounts"),
            new("New Account", "/accounts/new")
        };
        Breadcrumbs.SetCrumbs(breadcrumbs);

        _accountTypeOptions = new ()
        {
            new("Prospect", "Prospect"),
            new("Customer", "Customer"),
            new("Inactive", "Inactive"),
            new("Partner", "Partner"),
        };

        _statusOptions = new ()
        {
            new("Active", "Active"),
            new("Inactive", "Inactive"),
            new("Suspended", "Suspended"),
        };

        _segmentOptions = new ()
        {
            new("Enterprise", "Enterprise"),
            new("Mid-Market", "MidMarket"),
            new("SMB", "SMB"),
            new("Startup", "Startup"),
        };
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_form.AccountName))
        {
            await _toast.ShowAsync(new ToastModel { Title = "Validation Error", Content = "Account Name is required", CssClass = "e-toast-danger" });
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.AccountTypeCode))
        {
            await _toast.ShowAsync(new ToastModel { Title = "Validation Error", Content = "Account Type is required", CssClass = "e-toast-danger" });
            return;
        }

        _saving = true;
        try
        {
            var response = await HttpClient.PostAsJsonAsync("/api/accounts", _form);
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var result = System.Text.Json.JsonSerializer.Deserialize<CreateResponse>(json, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (result != null)
                {
                    await _toast.ShowAsync(new ToastModel { Title = "Success", Content = "Account created successfully", CssClass = "e-toast-success" });
                    Nav.NavigateTo("/accounts/" + result.Id);
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                await _toast.ShowAsync(new ToastModel { Title = "Error", Content = error, CssClass = "e-toast-danger" });
            }
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Error", Content = ex.Message, CssClass = "e-toast-danger" });
        }
        finally
        {
            _saving = false;
        }
    }

    record CreateResponse { public Guid Id { get; set; } }
}
