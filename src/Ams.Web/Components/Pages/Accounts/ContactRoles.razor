@page "/client/contacts/roles"
@namespace Ams.Web.Components.Pages.Contacts.Details
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos
@using Ams.Web.Components.Pages.Contacts

<PageTitle>Contact Roles — Tenant Admin</PageTitle>

<AppPageHeader Title="Contact Roles" Subtitle="Tenant Admin role distribution for account contacts" Icon="bi-shield"><Actions><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button><button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/client/contacts/new")'><i class="bi bi-plus-lg"></i> New Contact</button></Actions></AppPageHeader>
<section class="ma-hero contact-hero"><div><span class="ma-eyebrow">Tenant Admin · Contacts & Relationships</span><h2>Role Governance</h2><p>Review how contacts are assigned to primary, billing, service, portal, executive, and decision-maker responsibilities.</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/client/contacts")'><i class="bi bi-people"></i> Directory</button></div></section>
<div class="pc-kpi-strip contact-kpi-strip"><div class="pc-kpi-card @(_activeFilter is null ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter(null)'><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-shield"></i></span><div><div class="pc-kpi-value">@_items.Select(x => x.ContactTypeCode).Distinct().Count()</div><div class="pc-kpi-label">Role Types</div></div></div><div class="pc-kpi-card @(_activeFilter == "billing" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("billing")'><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-receipt"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsBillingContact)</div><div class="pc-kpi-label">Billing</div></div></div><div class="pc-kpi-card @(_activeFilter == "service" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("service")'><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-headset"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsServiceContact)</div><div class="pc-kpi-label">Service</div></div></div><div class="pc-kpi-card @(_activeFilter == "portal" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("portal")'><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-globe"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsPortalUser)</div><div class="pc-kpi-label">Portal</div></div></div></div>
<div class="ma-filter-bar contact-filter-bar"><div class="ma-search-wrap"><i class="bi bi-search"></i><input class="ma-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search roles, names, accounts…" /></div><button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button><span class="ma-filter-count">@_filtered.Count contacts</span></div>
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading contact roles…</span></div> }<SfGrid TValue="ContactDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="56"><GridEvents TValue="ContactDto" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" /><GridColumns><GridColumn Field="ContactTypeCode" HeaderText="Role" Width="150"><Template>@{ var c=(ContactDto)context; }<span class="um-badge um-badge-info">@c.ContactTypeCode</span></Template></GridColumn><GridColumn HeaderText="Contact" MinWidth="230"><Template>@{ var c=(ContactDto)context; }<div class="contact-name-cell"><div class="contact-avatar">@ContactPageConstants.Initials(c.FirstName,c.LastName)</div><div><strong>@ContactPageConstants.FullName(c)</strong><div class="text-muted">@(c.JobTitle ?? "—")</div></div></div></Template></GridColumn><GridColumn Field="AccountName" HeaderText="Account" Width="220" /><GridColumn HeaderText="Responsibilities" Width="220"><Template>@{ var c=(ContactDto)context; }<div class="contact-role-dots">@if(c.IsKeyContact){<span title="Key" class="contact-dot contact-dot-key"></span>}@if(c.IsBillingContact){<span title="Billing" class="contact-dot contact-dot-billing"></span>}@if(c.IsServiceContact){<span title="Service" class="contact-dot contact-dot-service"></span>}@if(c.IsPortalUser){<span title="Portal" class="contact-dot contact-dot-portal"></span>}</div></Template></GridColumn><GridColumn Field="StatusCode" HeaderText="Status" Width="110"><Template>@{ var c=(ContactDto)context; }<span class="@ContactPageConstants.StatusBadge(c.StatusCode)">@c.StatusCode</span></Template></GridColumn></GridColumns></SfGrid></div>
@code { List<ContactDto> _items = [], _filtered = []; string _search = string.Empty; string? _activeFilter, _loadError; bool _loading; protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Contacts", "/client/contacts"), new("Roles")); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchContactsAsync(ContactPageConstants.TenantId); _items = result?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = $"Failed to load contact roles: {ex.Message}"; } finally { _loading = false; } } void ApplyFilter() { var rows = _activeFilter switch { "billing" => _items.Where(x => x.IsBillingContact), "service" => _items.Where(x => x.IsServiceContact), "portal" => _items.Where(x => x.IsPortalUser), _ => _items.AsEnumerable() }; _filtered = rows.Where(x => string.IsNullOrWhiteSpace(_search) || x.ContactTypeCode.Contains(_search, StringComparison.OrdinalIgnoreCase) || ContactPageConstants.FullName(x).Contains(_search, StringComparison.OrdinalIgnoreCase) || (x.AccountName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList(); } void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; ApplyFilter(); } void SetFilter(string? key) { _activeFilter = key; ApplyFilter(); } void ResetFilters() { _activeFilter = null; _search = string.Empty; ApplyFilter(); } void OnRowSelected(RowSelectEventArgs<ContactDto> args) => Nav.NavigateTo($"/client/contacts/{args.Data.ContactId}"); }
