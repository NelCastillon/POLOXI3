@page "/client/contacts/roles"
@namespace Ams.Web.Components.Pages.Contacts.Details
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Notifications
@inject ApiClient Api
@inject HttpClient HttpClient
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Contact Roles</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Contact Roles"
               Subtitle="Manage contact roles and responsibilities"
               Icon="bi-shield">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "cr-spin" : "")" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-primary" @onclick="() => _showNewRole = true">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Role
        </button>
    </Actions>
</AppPageHeader>

<div class="cr-container">
    <!-- KPI Strip -->
    <div class="cr-kpi-strip">
        <div class="cr-kpi-card">
            <span class="cr-ki"><i class="bi bi-shield" aria-hidden="true"></i></span>
            <div><div class="cr-kv">@_roles.Count</div><div class="cr-kl">Total Roles</div></div>
        </div>
    </div>

    @if (_loading)
    {
        <div class="cr-loading"><span class="um-spin" aria-hidden="true"></span><span>Loading roles…</span></div>
    }
    else if (_roles.Count == 0)
    {
        <div class="cr-empty">
            <i class="bi bi-inbox" aria-hidden="true"></i>
            <span>No roles defined yet. <button class="um-link" @onclick="() => _showNewRole = true">Create one now.</button></span>
        </div>
    }
    else
    {
        <div class="cr-grid">
            @foreach (var role in _roles)
            {
                <div class="cr-card">
                    <div class="cr-card-header">
                        <div class="cr-role-name">@role.RoleName</div>
                        <button class="cr-menu" @onclick="() => _selectedRole = _selectedRole?.Id == role.Id ? null : role">
                            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="cr-card-body">
                        <div class="cr-detail-row">
                            <span class="cr-label">Description:</span>
                            <span class="cr-value">@role.Description</span>
                        </div>
                        <div class="cr-detail-row">
                            <span class="cr-label">Contacts:</span>
                            <span class="cr-badge">@role.ContactCount</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- New Role Modal -->
    @if (_showNewRole)
    {
        <div class="cr-modal-overlay" @onclick="() => _showNewRole = false">
            <div class="cr-modal" @onclick:stopPropagation="true">
                <div class="cr-modal-header">
                    <h2>Create New Contact Role</h2>
                    <button class="cr-close" @onclick="() => _showNewRole = false">
                        <i class="bi bi-x" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="cr-modal-body">
                    <div class="cr-form-group">
                        <label for="roleName" class="cr-label">Role Name *</label>
                        <input type="text" id="roleName" class="cr-input" placeholder="e.g., Decision Maker"
                               @bind="_newRole.RoleName" />
                    </div>

                    <div class="cr-form-group">
                        <label for="description" class="cr-label">Description</label>
                        <textarea id="description" class="cr-textarea" placeholder="Describe this role…"
                                  @bind="_newRole.Description"></textarea>
                    </div>

                    <div class="cr-form-group">
                        <label class="cr-checkbox">
                            <input type="checkbox" @bind="_newRole.IsDefault" />
                            Set as default role for new contacts
                        </label>
                    </div>
                </div>
                <div class="cr-modal-footer">
                    <button class="um-btn um-btn-ghost" @onclick="() => _showNewRole = false">Cancel</button>
                    <button class="um-btn um-btn-primary" @onclick="SaveRole" disabled="@string.IsNullOrEmpty(_newRole.RoleName)">
                        Create Role
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private SfToast _toast = null!;
    private bool _loading = true;
    private bool _showNewRole = false;

    private List<ContactRoleInfo> _roles = new();
    private ContactRoleInfo? _selectedRole;
    private NewRoleForm _newRole = new();

    class ContactRoleInfo
    {
        public Guid Id { get; set; }
        public string RoleName { get; set; } = string.Empty;
        public string? Description { get; set; }
        public int ContactCount { get; set; }
        public bool IsDefault { get; set; }
    }

    record NewRoleForm
    {
        public string RoleName { get; set; } = string.Empty;
        public string? Description { get; set; }
        public bool IsDefault { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var breadcrumbs = new BreadcrumbService.BreadcrumbItem[] {
            new("Contacts", "/client/contacts"),
            new("Roles", "/client/contacts/roles")
        };
        Breadcrumbs.SetCrumbs(breadcrumbs);

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await Task.Delay(0); // TODO: replace with real API call to /api/contacts/roles
        _roles =
        [
            new() { Id = Guid.NewGuid(), RoleName = "Primary Insured",    Description = "Main policyholder contact",          ContactCount = 142, IsDefault = true  },
            new() { Id = Guid.NewGuid(), RoleName = "Named Insured",      Description = "Additional insured on the policy",   ContactCount = 87,  IsDefault = false },
            new() { Id = Guid.NewGuid(), RoleName = "Billing Contact",    Description = "Receives invoices and billing info",  ContactCount = 63,  IsDefault = false },
            new() { Id = Guid.NewGuid(), RoleName = "Claims Contact",     Description = "Point of contact for claims",         ContactCount = 51,  IsDefault = false },
            new() { Id = Guid.NewGuid(), RoleName = "Decision Maker",     Description = "Authorises policy changes",           ContactCount = 39,  IsDefault = false },
            new() { Id = Guid.NewGuid(), RoleName = "Agent of Record",    Description = "Assigned producer / agent",           ContactCount = 28,  IsDefault = false },
        ];
        _loading = false;
    }

    private async Task SaveRole()
    {
        if (string.IsNullOrWhiteSpace(_newRole.RoleName))
            return;

        // TODO: call POST /api/contacts/roles
        _roles.Insert(0, new ContactRoleInfo
        {
            Id           = Guid.NewGuid(),
            RoleName     = _newRole.RoleName,
            Description  = _newRole.Description,
            ContactCount = 0,
            IsDefault    = _newRole.IsDefault
        });
        _showNewRole = false;
        _newRole = new();
        await _toast.ShowAsync(new ToastModel { Title = "Success", Content = "Role created successfully", CssClass = "e-toast-success" });
    }
}
