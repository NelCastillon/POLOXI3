@page "/client/contacts/dm"
@namespace Ams.Web.Components.Pages.Contacts.Details
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos
@using Ams.Web.Components.Pages.Contacts

<PageTitle>Decision Makers — Tenant Admin</PageTitle>

<AppPageHeader Title="Decision Makers" Subtitle="Tenant Admin workspace for executive and key contacts" Icon="bi-star"><Actions><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button><button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/client/contacts/new")'><i class="bi bi-plus-lg"></i> New Contact</button></Actions></AppPageHeader>

<section class="ma-hero contact-hero"><div><span class="ma-eyebrow">Tenant Admin · Contacts & Relationships</span><h2>Decision Maker Desk</h2><p>Monitor key contacts, executive roles, account sponsors, and portal-ready decision makers.</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/client/contacts")'><i class="bi bi-people"></i> Directory</button></div></section>
<div class="pc-kpi-strip contact-kpi-strip"><div class="pc-kpi-card @(_activeFilter is null ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter(null)'><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-star-fill"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Decision Makers</div></div></div><div class="pc-kpi-card @(_activeFilter == "portal" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("portal")'><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-globe"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsPortalUser)</div><div class="pc-kpi-label">Portal</div></div></div><div class="pc-kpi-card @(_activeFilter == "email" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("email")'><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-envelope"></i></span><div><div class="pc-kpi-value">@_items.Count(x => !string.IsNullOrWhiteSpace(x.Email))</div><div class="pc-kpi-label">With Email</div></div></div></div>
<div class="ma-filter-bar contact-filter-bar"><div class="ma-search-wrap"><i class="bi bi-search"></i><input class="ma-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search decision makers…" /></div><button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button><span class="ma-filter-count">@_filtered.Count contacts</span></div>
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading decision makers…</span></div> }<SfGrid TValue="ContactDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="56"><GridEvents TValue="ContactDto" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" /><GridColumns><GridColumn HeaderText="Decision Maker" MinWidth="240"><Template>@{ var c=(ContactDto)context; }<div class="contact-name-cell"><div class="contact-avatar">@ContactPageConstants.Initials(c.FirstName,c.LastName)</div><div><strong>@ContactPageConstants.FullName(c)</strong><div class="text-muted">@(c.JobTitle ?? "Decision Maker")</div></div></div></Template></GridColumn><GridColumn Field="AccountName" HeaderText="Account" Width="220" /><GridColumn Field="Email" HeaderText="Email" Width="220" /><GridColumn Field="Phone" HeaderText="Phone" Width="140" /><GridColumn Field="ContactTypeCode" HeaderText="Role" Width="150"><Template>@{ var c=(ContactDto)context; }<span class="um-badge um-badge-info">@c.ContactTypeCode</span></Template></GridColumn><GridColumn HeaderText="Status" Width="110"><Template>@{ var c=(ContactDto)context; }<span class="@ContactPageConstants.StatusBadge(c.StatusCode)">@c.StatusCode</span></Template></GridColumn></GridColumns></SfGrid></div>
@code { List<ContactDto> _items = [], _filtered = []; string _search = string.Empty; string? _activeFilter, _loadError; bool _loading; protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Contacts", "/client/contacts"), new("Decision Makers")); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchContactsAsync(ContactPageConstants.TenantId); _items = (result?.Items ?? []).Where(x => x.IsKeyContact || x.ContactTypeCode == "Decision Maker" || (x.JobTitle?.Contains("CEO", StringComparison.OrdinalIgnoreCase) ?? false) || (x.JobTitle?.Contains("Chief", StringComparison.OrdinalIgnoreCase) ?? false) || (x.JobTitle?.Contains("President", StringComparison.OrdinalIgnoreCase) ?? false)).ToList(); ApplyFilter(); } catch (Exception ex) { _loadError = $"Failed to load decision makers: {ex.Message}"; } finally { _loading = false; } } void ApplyFilter() { var rows = _activeFilter switch { "portal" => _items.Where(x => x.IsPortalUser), "email" => _items.Where(x => !string.IsNullOrWhiteSpace(x.Email)), _ => _items.AsEnumerable() }; _filtered = rows.Where(x => string.IsNullOrWhiteSpace(_search) || ContactPageConstants.FullName(x).Contains(_search, StringComparison.OrdinalIgnoreCase) || (x.AccountName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) || (x.JobTitle?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList(); } void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; ApplyFilter(); } void SetFilter(string? key) { _activeFilter = key; ApplyFilter(); } void ResetFilters() { _activeFilter = null; _search = string.Empty; ApplyFilter(); } void OnRowSelected(RowSelectEventArgs<ContactDto> args) => Nav.NavigateTo($"/client/contacts/{args.Data.ContactId}"); }
