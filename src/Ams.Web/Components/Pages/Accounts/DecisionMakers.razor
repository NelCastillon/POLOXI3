    static string AuthoritySummary(DecisionMakerRow row)
    {
        var roles = new List<string> { "Decision Maker" };
        if (IsExecutive(row)) roles.Add("Executive");
        if (row.IsPortalUser) roles.Add("Portal");
        if (row.IsBillingContact) roles.Add("Billing");
        if (row.IsServiceContact) roles.Add("Service");
        return string.Join(' ', roles);
    }

    static string CssSafe(string? value) => string.IsNullOrWhiteSpace(value) ? "unknown" : value.Trim().ToLowerInvariant().Replace(" ", "-").Replace("/", "-");

