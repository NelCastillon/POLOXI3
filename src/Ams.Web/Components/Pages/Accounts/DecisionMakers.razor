@page "/client/contacts/dm"
@namespace Ams.Web.Components.Pages.Contacts.Details
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Contacts
@using Ams.Web.Components.Pages.Contacts
@using Microsoft.AspNetCore.Components.Rendering
@using Microsoft.AspNetCore.Components.Web
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Decision Makers — AMS</PageTitle>

@if (_toastVisible)
{
    <div class="dmx-toast dmx-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="dmx-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showEditDialog)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseEditDialog">
        <div class="mt-modal dmx-action-modal" role="dialog" aria-modal="true" aria-labelledby="dmx-edit-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-person-check" aria-hidden="true"></i>
                <span id="dmx-edit-title">Edit decision-maker profile for @_selected.FullName</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseEditDialog" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveDecisionMakerAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="dmx-modal-intro">
                        <span class="dmx-modal-chip"><i class="bi bi-stars" aria-hidden="true"></i> Decision authority</span>
                        <p>Maintain the executive role, key-contact flag, portal readiness, and communication settings used by account and workflow teams.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field">
                            <label>Decision Role <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.ContactTypeCode">
                                @foreach (var type in ContactPageConstants.ContactTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.ContactTypeCode" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Status <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.StatusCode">
                                @foreach (var status in ContactPageConstants.Statuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.StatusCode" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Preferred Method</label>
                            <InputSelect class="form-select" @bind-Value="_form.PreferredContactMethod">
                                <option value="">Select method</option>
                                @foreach (var method in ContactPageConstants.Methods)
                                {
                                    <option value="@method">@method</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.PreferredContactMethod" class="text-danger" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Decision Maker Flags</label>
                            <div class="dmx-check-grid">
                                <label><InputCheckbox @bind-Value="_form.IsKeyContact" /> Key Decision Maker</label>
                                <label><InputCheckbox @bind-Value="_form.IsPortalUser" /> Portal Ready</label>
                                <label><InputCheckbox @bind-Value="_form.IsBillingContact" /> Billing Authority</label>
                                <label><InputCheckbox @bind-Value="_form.IsServiceContact" /> Service Sponsor</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseEditDialog" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        Save Decision Maker
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showConfirmDialog)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseConfirmDialog">
        <div class="mt-modal dmx-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="dmx-confirm-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi @_confirmIcon" aria-hidden="true"></i>
                <span>Confirm decision-maker action</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseConfirmDialog" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon @(_pendingAction is "Delete" or "Deactivate" or "Remove Decision Maker" ? "um-confirm-icon--danger" : "")">
                    <i class="bi @_confirmIcon" aria-hidden="true"></i>
                </div>
                <div>
                    <h3 id="dmx-confirm-title">@_confirmTitle</h3>
                    <p>@_confirmMessage</p>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CloseConfirmDialog" disabled="@_actionBusy">Cancel</button>
                <button type="button" class="um-btn @(_pendingAction is "Delete" or "Deactivate" or "Remove Decision Maker" ? "um-btn-danger" : "um-btn-primary")" @onclick="ExecuteConfirmedActionAsync" disabled="@_actionBusy">
                    @if (_actionBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<div class="dmx-enterprise-page" @onclick="CloseActionMenu">
    <section class="dmx-header" aria-label="Decision makers overview">
        <div class="dmx-header-left">
            <div class="dmx-lob-icon"><i class="bi bi-star-fill" aria-hidden="true"></i></div>
            <div class="dmx-header-info">
                <div class="dmx-title-row">
                    <h1 class="dmx-page-title">Decision Makers</h1>
                    <span class="dmx-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live client data</span>
                    <span class="dmx-status-pill"><i class="bi bi-diagram-3" aria-hidden="true"></i> Workflow synced</span>
                    @if (HasFilters)
                    {
                        <span class="dmx-filter-pill">Filtered</span>
                    }
                </div>
                <p class="dmx-hero-copy">Track executive buyers, billing authorities, portal-ready sponsors, and account workflow handoffs from live contact master data.</p>
                <div class="dmx-sub-row">
                    <span class="dmx-sub-chip"><i class="bi bi-eye" aria-hidden="true"></i>@FilteredRows.Count() visible</span>
                    <span class="dmx-sub-chip"><i class="bi bi-person-check" aria-hidden="true"></i>@_rows.Count decision makers</span>
                    <span class="dmx-sub-chip"><i class="bi bi-globe" aria-hidden="true"></i>@_rows.Count(r => r.IsPortalUser) portal ready</span>
                    <span class="dmx-sub-chip"><i class="bi bi-envelope" aria-hidden="true"></i>@_rows.Count(r => !string.IsNullOrWhiteSpace(r.Email)) with email</span>
                    <span class="dmx-sub-chip"><i class="bi bi-building" aria-hidden="true"></i>@_rows.Select(r => r.AccountId).Distinct().Count() accounts</span>
                </div>
            </div>
        </div>
        <div class="dmx-header-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "dmx-spin" : "")" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => Nav.NavigateTo("/client/contacts")'><i class="bi bi-person-plus" aria-hidden="true"></i> New Contact</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/client/contacts")'><i class="bi bi-people" aria-hidden="true"></i> Directory</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/client/contacts/roles")'><i class="bi bi-shield-check" aria-hidden="true"></i> Roles</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger dmx-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError
        </div>
    }

    <div class="dmx-kpi-strip">
        @KpiCard("bi-star-fill", "Decision Makers", _rows.Count.ToString(), "dmx-kpi-total", null)
        @KpiCard("bi-globe", "Portal Ready", _rows.Count(r => r.IsPortalUser).ToString(), "dmx-kpi-portal", "__portal")
        @KpiCard("bi-envelope", "With Email", _rows.Count(r => !string.IsNullOrWhiteSpace(r.Email)).ToString(), "dmx-kpi-email", "__email")
        @KpiCard("bi-telephone", "With Phone", _rows.Count(r => !string.IsNullOrWhiteSpace(r.Phone)).ToString(), "dmx-kpi-phone", "__phone")
        @KpiCard("bi-briefcase", "Executives", _rows.Count(IsExecutive).ToString(), "dmx-kpi-executive", "__executive")
        @KpiCard("bi-check-circle", "Active", _rows.Count(r => r.StatusCode == "Active").ToString(), "dmx-kpi-active", "Active")
    </div>

    <div class="dmx-enterprise-search" role="search" aria-label="Search decision makers">
        <div class="dmx-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
        <div class="dmx-search-body">
            <label for="dmx-search-input">Enterprise search</label>
            <input id="dmx-search-input" class="dmx-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search decision makers, accounts, title, email, phone, role, status, IDs…" />
            <div class="dmx-search-hint">Searches executive role, account linkage, contact methods, status, and supporting contact master fields.</div>
        </div>
        <div class="dmx-search-result"><strong>@FilteredRows.Count()</strong><span>matches</span></div>
        @if (!string.IsNullOrWhiteSpace(_searchText))
        {
            <button type="button" class="um-btn um-btn-ghost um-btn-sm dmx-search-clear" @onclick="ClearFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
        }
    </div>

    <div class="dmx-view-tabs" role="tablist" aria-label="Decision maker views">
        @foreach (var tab in _tabs)
        {
            <button class="dmx-view-tab @(_activeTab == tab.Key ? "dmx-view-tab--active" : "")" type="button" role="tab" aria-selected="@(_activeTab == tab.Key)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label
                <span class="dmx-tab-count">@TabCount(tab.Key)</span>
            </button>
        }
        <select class="dmx-type-filter" @bind="_typeFilter" @bind:after="OnTypeFilterChanged" aria-label="Filter by decision role">
            <option value="">All decision roles</option>
            @foreach (var type in ContactPageConstants.ContactTypes)
            {
                <option value="@type">@type</option>
            }
        </select>
    </div>

    <div class="dmx-grid-wrap">
        @if (_loading)
        {
            <div class="dmx-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading decision makers…</span></div>
        }
        else
        {
            <div class="dmx-grid-toolbar">
                <div>
                    <strong>@FilteredRows.Count()</strong> decision makers
                    @if (HasFilters)
                    {
                        <span class="dmx-filter-note">filtered</span>
                    }
                </div>
                <div class="dmx-grid-tools">
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ExportAsync" disabled="@(!FilteredRows.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
                </div>
            </div>
            <div class="dmx-table-scroll">
                <table class="dmx-table" aria-label="Decision makers register">
                    <thead>
                        <tr>
                            <th>Decision Maker</th>
                            <th>Account</th>
                            <th>Authority</th>
                            <th>Status</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Preferred</th>
                            <th>Created</th>
                            <th class="dmx-actions-col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!PagedRows.Any())
                        {
                            <tr>
                                <td colspan="9">
                                    <div class="dmx-empty-state">
                                        <i class="bi bi-inbox" aria-hidden="true"></i>
                                        <strong>No decision makers found</strong>
                                        <span>Adjust the current tab, KPI, decision role, or search criteria.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in PagedRows)
                            {
                                <tr class="dmx-table-row" @onclick="() => OpenContact(row)">
                                    <td>@DecisionMakerCell(row)</td>
                                    <td>@AccountCell(row)</td>
                                    <td>@AuthorityBadges(row)</td>
                                    <td>@StatusChip(row.StatusCode)</td>
                                    <td>@EmailCell(row)</td>
                                    <td>@PhoneCell(row)</td>
                                    <td>@(row.PreferredContactMethod ?? "—")</td>
                                    <td>@row.CreatedDateUtc.ToLocalTime().ToString("MM/dd/yyyy")</td>
                                    <td class="dmx-actions-col">@CtxBtn(row)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="dmx-pager" aria-label="Decision makers pagination">
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</button>
                <span>Page @_page of @TotalPages</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
            </div>
        }
    </div>
</div>

@code {
    Guid _tenantId;
    Guid _tenantAdminUserId;
    bool _loading;
    bool _actionBusy;
    bool _showEditDialog;
    bool _showConfirmDialog;
    bool _toastVisible;
    string _toastMessage = string.Empty;
    string _toastKind = "success";
    string _activeTab = "all";
    string? _kpiFilter;
    string? _searchText;
    string? _loadError;
    string _typeFilter = string.Empty;
    Guid? _openActionMenuFor;
    int _page = 1;
    const int PageSize = 20;

    DecisionMakerRow _selected = new();
    DecisionMakerFormModel _form = new();
    string _pendingAction = string.Empty;
    string _confirmTitle = "Confirm action";
    string _confirmMessage = "Confirm this decision-maker action?";
    string _confirmIcon = "bi-question-circle";

    readonly List<DecisionMakerRow> _allContacts = [];
    readonly List<DecisionMakerRow> _rows = [];

    readonly TabDef[] _tabs =
    [
        new("all", "All", "bi-stack"),
        new("portal", "Portal", "bi-globe"),
        new("email", "With Email", "bi-envelope"),
        new("phone", "With Phone", "bi-telephone"),
        new("executive", "Executives", "bi-briefcase"),
        new("inactive", "Inactive", "bi-slash-circle"),
    ];

    readonly ActionMenuItem[] _actionItems =
    [
        new("Open Contact", "bi bi-person-vcard"),
        new("Edit Decision Maker", "bi bi-pencil-square"),
        new("Account", "bi bi-building"),
        new("Email", "bi bi-envelope"),
        new("Call", "bi bi-telephone"),
        new("Mark Decision Maker", "bi bi-person-check"),
        new("Portal Access", "bi bi-globe"),
        new("Billing Authority", "bi bi-receipt"),
        new("Service Sponsor", "bi bi-headset"),
        new("Remove Decision Maker", "bi bi-person-dash"),
        new("Sync Workflow", "bi bi-arrow-repeat"),
        new("Activate", "bi bi-check-circle"),
        new("Deactivate", "bi bi-slash-circle"),
        new("Delete", "bi bi-trash"),
    ];

    IEnumerable<DecisionMakerRow> BaseTabRows => _activeTab switch
    {
        "portal" => _rows.Where(r => r.IsPortalUser),
        "email" => _rows.Where(r => !string.IsNullOrWhiteSpace(r.Email)),
        "phone" => _rows.Where(r => !string.IsNullOrWhiteSpace(r.Phone)),
        "executive" => _rows.Where(IsExecutive),
        "inactive" => _rows.Where(r => r.StatusCode is "Inactive" or "Left Company"),
        _ => _rows,
    };

    IEnumerable<DecisionMakerRow> KpiRows => _kpiFilter switch
    {
        null => BaseTabRows,
        "__portal" => BaseTabRows.Where(r => r.IsPortalUser),
        "__email" => BaseTabRows.Where(r => !string.IsNullOrWhiteSpace(r.Email)),
        "__phone" => BaseTabRows.Where(r => !string.IsNullOrWhiteSpace(r.Phone)),
        "__executive" => BaseTabRows.Where(IsExecutive),
        var status => BaseTabRows.Where(r => r.StatusCode == status),
    };

    IEnumerable<DecisionMakerRow> FilteredRows => ApplyEnterpriseFilters(KpiRows);
    IEnumerable<DecisionMakerRow> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize);
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)PageSize));
    bool HasFilters => !string.IsNullOrWhiteSpace(_searchText) || _kpiFilter is not null || !string.IsNullOrWhiteSpace(_typeFilter);

    string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            _page = 1;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Contacts", "/client/contacts"), new("Decision Makers", "/client/contacts/dm"));
        await LoadAsync();
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchContactsAsync(_tenantId, pageSize: 500);
            _allContacts.Clear();
            _allContacts.AddRange((result?.Items ?? []).Select(DecisionMakerRow.From));
            _rows.Clear();
            _rows.AddRange(_allContacts.Where(IsDecisionMakerCandidate));
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load decision makers: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    string TabCount(string key) => key switch
    {
        "all" => _rows.Count.ToString(),
        "portal" => _rows.Count(r => r.IsPortalUser).ToString(),
        "email" => _rows.Count(r => !string.IsNullOrWhiteSpace(r.Email)).ToString(),
        "phone" => _rows.Count(r => !string.IsNullOrWhiteSpace(r.Phone)).ToString(),
        "executive" => _rows.Count(IsExecutive).ToString(),
        "inactive" => _rows.Count(r => r.StatusCode is "Inactive" or "Left Company").ToString(),
        _ => string.Empty,
    };

    IEnumerable<DecisionMakerRow> ApplyEnterpriseFilters(IEnumerable<DecisionMakerRow> rows)
    {
        if (!string.IsNullOrWhiteSpace(_typeFilter))
        {
            rows = rows.Where(r => r.ContactTypeCode == _typeFilter);
        }

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim();
            rows = rows.Where(r => Contains(r.FullName, term)
                || Contains(r.AccountName, term)
                || Contains(r.Email, term)
                || Contains(r.Phone, term)
                || Contains(r.JobTitle, term)
                || Contains(r.ContactTypeCode, term)
                || Contains(r.StatusCode, term)
                || Contains(r.PreferredContactMethod, term)
                || Contains(AuthoritySummary(r), term)
                || Contains(r.ContactId.ToString(), term)
                || Contains(r.AccountId.ToString(), term)
                || Contains(r.CreatedDateUtc.ToString("MM/dd/yyyy"), term)
                || Contains(r.CreatedDateUtc.ToString("yyyy-MM-dd"), term));
        }

        return rows;
    }

    static bool Contains(string? source, string term) =>
        !string.IsNullOrWhiteSpace(source) && source.Contains(term, StringComparison.OrdinalIgnoreCase);

    static bool IsDecisionMakerCandidate(DecisionMakerRow row) => row.IsKeyContact
        || string.Equals(row.ContactTypeCode, "Decision Maker", StringComparison.OrdinalIgnoreCase)
        || IsExecutive(row);

    static bool IsExecutive(DecisionMakerRow row) => Contains(row.JobTitle, "CEO")
        || Contains(row.JobTitle, "Chief")
        || Contains(row.JobTitle, "President")
        || Contains(row.JobTitle, "Owner")
        || Contains(row.JobTitle, "Principal")
        || Contains(row.JobTitle, "Executive")
        || Contains(row.ContactTypeCode, "Executive");

    void SetActiveTab(string key)
    {
        _activeTab = key;
        _page = 1;
    }

    void ToggleKpiFilter(string? filterKey)
    {
        _kpiFilter = filterKey is null || _kpiFilter == filterKey ? null : filterKey;
        _page = 1;
    }

    void OnTypeFilterChanged() => _page = 1;

    void ClearFilters()
    {
        _searchText = null;
        _kpiFilter = null;
        _typeFilter = string.Empty;
        _page = 1;
    }

    void PreviousPage()
    {
        if (_page > 1)
            _page--;
    }

    void NextPage()
    {
        if (_page < TotalPages)
            _page++;
    }

    void OpenContact(DecisionMakerRow row) => Nav.NavigateTo($"/client/contacts/{row.ContactId}");

    async Task HandleActionAsync(string action)
    {
        _openActionMenuFor = null;
        if (_selected.ContactId == Guid.Empty)
        {
            ShowToast("Select a decision maker before running an action.", "danger");
            return;
        }

        switch (action)
        {
            case "Open Contact":
                OpenContact(_selected);
                break;
            case "Edit Decision Maker":
                OpenEditDialog(_selected);
                break;
            case "Account":
                Nav.NavigateTo($"/accounts/{_selected.AccountId}");
                break;
            case "Email":
                if (string.IsNullOrWhiteSpace(_selected.Email)) ShowToast("This decision maker does not have an email address.", "danger");
                else Nav.NavigateTo($"mailto:{_selected.Email}", forceLoad: true);
                break;
            case "Call":
                if (string.IsNullOrWhiteSpace(_selected.Phone)) ShowToast("This decision maker does not have a phone number.", "danger");
                else Nav.NavigateTo($"tel:{_selected.Phone}", forceLoad: true);
                break;
            case "Mark Decision Maker":
            case "Portal Access":
            case "Billing Authority":
            case "Service Sponsor":
            case "Remove Decision Maker":
            case "Sync Workflow":
            case "Activate":
            case "Deactivate":
            case "Delete":
                OpenConfirmDialog(action);
                break;
            default:
                await Task.CompletedTask;
                break;
        }
    }

    void OpenEditDialog(DecisionMakerRow row)
    {
        _selected = row;
        _form = row.ToForm();
        _showEditDialog = true;
    }

    void CloseEditDialog()
    {
        if (_actionBusy) return;
        _showEditDialog = false;
    }

    async Task SaveDecisionMakerAsync()
    {
        if (_selected.ContactId == Guid.Empty)
            return;

        _actionBusy = true;
        try
        {
            await Api.UpdateContactAsync(_selected.ContactId, BuildUpdateRequest(_selected, _form));
            await CreateDecisionMakerWorkflowEventAsync("Profile Updated", $"Decision-maker profile updated for {_selected.FullName}.");
            _showEditDialog = false;
            ShowToast("Decision maker updated.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    Task NotifyValidationAsync()
    {
        ShowToast("Please correct the highlighted fields before continuing.", "danger");
        return Task.CompletedTask;
    }

    void OpenConfirmDialog(string action)
    {
        _pendingAction = action;
        (_confirmTitle, _confirmMessage, _confirmIcon) = action switch
        {
            "Mark Decision Maker" => ($"Mark {_selected.FullName} as decision maker?", "This sets the contact role to Decision Maker and marks the contact as key.", "bi-person-check"),
            "Portal Access" => ($"Enable portal access for {_selected.FullName}?", "This marks the decision maker as portal-ready for invitation and account access workflows.", "bi-globe"),
            "Billing Authority" => ($"Mark {_selected.FullName} as billing authority?", "This flags the decision maker for billing and receivable authority workflows.", "bi-receipt"),
            "Service Sponsor" => ($"Mark {_selected.FullName} as service sponsor?", "This flags the decision maker as a service sponsor for account servicing workflows.", "bi-headset"),
            "Remove Decision Maker" => ($"Remove decision-maker status from {_selected.FullName}?", "This clears key decision-maker status and changes the role to Secondary while preserving the contact record.", "bi-person-dash"),
            "Sync Workflow" => ($"Sync workflow for {_selected.FullName}?", "This writes a workflow event to the contact timeline and related account workflow context.", "bi-arrow-repeat"),
            "Activate" => ($"Activate {_selected.FullName}?", "This will set the contact status to Active.", "bi-check-circle"),
            "Deactivate" => ($"Deactivate {_selected.FullName}?", "This will set the contact status to Inactive while retaining the record for audit.", "bi-slash-circle"),
            "Delete" => ($"Delete {_selected.FullName}?", "This will soft-delete the contact. Related audit data remains available in the database.", "bi-trash"),
            _ => ("Confirm action", "Confirm this decision-maker action?", "bi-question-circle")
        };
        _showConfirmDialog = true;
    }

    void CloseConfirmDialog()
    {
        if (_actionBusy) return;
        _showConfirmDialog = false;
    }

    async Task ExecuteConfirmedActionAsync()
    {
        if (_selected.ContactId == Guid.Empty)
            return;

        _actionBusy = true;
        try
        {
            switch (_pendingAction)
            {
                case "Sync Workflow":
                    await CreateDecisionMakerWorkflowEventAsync("Workflow Synced", $"Decision-maker workflow sync requested for {_selected.FullName}.");
                    _showConfirmDialog = false;
                    ShowToast("Decision-maker workflow sync recorded.");
                    await LoadAsync();
                    break;
                case "Mark Decision Maker":
                    await UpdateDecisionMakerAsync(type: "Decision Maker", key: true, eventTitle: "Decision Maker Marked", eventDetail: $"{_selected.FullName} was marked as a key decision maker.");
                    ShowToast("Contact marked as decision maker.");
                    break;
                case "Portal Access":
                    await UpdateDecisionMakerAsync(portal: true, eventTitle: "Portal Access Flagged", eventDetail: $"Portal readiness enabled for {_selected.FullName}.");
                    ShowToast("Portal access flag enabled.");
                    break;
                case "Billing Authority":
                    await UpdateDecisionMakerAsync(billing: true, eventTitle: "Billing Authority Flagged", eventDetail: $"Billing authority enabled for {_selected.FullName}.");
                    ShowToast("Billing authority enabled.");
                    break;
                case "Service Sponsor":
                    await UpdateDecisionMakerAsync(service: true, eventTitle: "Service Sponsor Flagged", eventDetail: $"Service sponsor flag enabled for {_selected.FullName}.");
                    ShowToast("Service sponsor flag enabled.");
                    break;
                case "Remove Decision Maker":
                    await UpdateDecisionMakerAsync(type: "Secondary", key: false, eventTitle: "Decision Maker Removed", eventDetail: $"Decision-maker status removed for {_selected.FullName}; contact record retained.");
                    ShowToast("Decision-maker status removed.");
                    break;
                case "Activate":
                    await UpdateDecisionMakerAsync(status: "Active", eventTitle: "Decision Maker Activated", eventDetail: $"Decision-maker status set to Active for {_selected.FullName}.");
                    ShowToast("Decision maker activated.");
                    break;
                case "Deactivate":
                    await UpdateDecisionMakerAsync(status: "Inactive", eventTitle: "Decision Maker Deactivated", eventDetail: $"Decision-maker status set to Inactive for {_selected.FullName}.");
                    ShowToast("Decision maker deactivated.");
                    break;
                case "Delete":
                    await CreateDecisionMakerWorkflowEventAsync("Decision Maker Deleted", $"Decision-maker contact {_selected.FullName} was deleted from the active register.");
                    await Api.DeleteContactAsync(_selected.ContactId);
                    ShowToast("Decision maker deleted.");
                    break;
            }

            _showConfirmDialog = false;
            if (_pendingAction != "Sync Workflow")
            {
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Action failed: {ex.Message}", "danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    async Task UpdateDecisionMakerAsync(string? type = null, string? status = null, bool? key = null, bool? billing = null, bool? service = null, bool? portal = null, string? eventTitle = null, string? eventDetail = null)
    {
        var form = _selected.ToForm();
        form.ContactTypeCode = type ?? form.ContactTypeCode;
        form.StatusCode = status ?? form.StatusCode;
        form.IsKeyContact = key ?? form.IsKeyContact;
        form.IsBillingContact = billing ?? form.IsBillingContact;
        form.IsServiceContact = service ?? form.IsServiceContact;
        form.IsPortalUser = portal ?? form.IsPortalUser;
        await Api.UpdateContactAsync(_selected.ContactId, BuildUpdateRequest(_selected, form));
        if (!string.IsNullOrWhiteSpace(eventTitle))
        {
            await CreateDecisionMakerWorkflowEventAsync(eventTitle, eventDetail);
        }
    }

    async Task CreateDecisionMakerWorkflowEventAsync(string eventTitle, string? eventDetail)
    {
        await Api.CreateContactWorkflowEventAsync(_selected.ContactId, new CreateContactWorkflowEventRequest
        {
            TenantId = _tenantId,
            ContactId = _selected.ContactId,
            EventType = "DecisionMaker",
            EventTitle = eventTitle,
            EventDetail = eventDetail,
            RelatedEntityName = "Account",
            RelatedEntityId = _selected.AccountId == Guid.Empty ? null : _selected.AccountId,
            EventDateUtc = DateTime.UtcNow,
            CreatedByUserId = _tenantAdminUserId
        });
    }

    UpdateContactRequest BuildUpdateRequest(DecisionMakerRow row, DecisionMakerFormModel form) => new()
    {
        FirstName = row.FirstName,
        LastName = row.LastName,
        Email = ContactPageConstants.Normalize(row.Email),
        Phone = ContactPageConstants.Normalize(row.Phone),
        JobTitle = ContactPageConstants.Normalize(row.JobTitle),
        ContactTypeCode = form.ContactTypeCode,
        IsBillingContact = form.IsBillingContact,
        IsServiceContact = form.IsServiceContact,
        IsPortalUser = form.IsPortalUser,
        IsKeyContact = form.IsKeyContact,
        PreferredContactMethod = ContactPageConstants.Normalize(form.PreferredContactMethod),
        StatusCode = form.StatusCode,
        ModifiedByUserId = _tenantAdminUserId
    };

    Task ExportAsync()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Decision Maker,Account,Title,Role,Email,Phone,Status,Preferred Method,Portal,Billing,Service,Created");
        foreach (var row in FilteredRows)
        {
            csv.AppendLine(string.Join(',', Csv(row.FullName), Csv(row.AccountName), Csv(row.JobTitle), Csv(row.ContactTypeCode), Csv(row.Email), Csv(row.Phone), Csv(row.StatusCode), Csv(row.PreferredContactMethod), Csv(row.IsPortalUser.ToString()), Csv(row.IsBillingContact.ToString()), Csv(row.IsServiceContact.ToString()), Csv(row.CreatedDateUtc.ToLocalTime().ToString("MM/dd/yyyy"))));
        }
        Nav.NavigateTo("data:text/csv;charset=utf-8," + Uri.EscapeDataString(csv.ToString()), forceLoad: true);
        ShowToast("Decision makers export generated.");
        return Task.CompletedTask;
    }

    static string Csv(string? value)
    {
        var text = value ?? string.Empty;
        return string.Concat("\"", text.Replace("\"", "\"\""), "\"");
    }

