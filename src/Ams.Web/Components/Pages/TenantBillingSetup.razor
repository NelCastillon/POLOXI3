@page "/tenant/billing/modes2"
@page "/tenant/billing/invoices2"
@page "/tenant/billing/providers2"
@page "/tenant/billing/plans2"
@page "/tenant/billing/taxes2"
@page "/tenant/billing/gl2"
@page "/tenant/billing/recon2"
@page "/tenant/billing/collections2"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Billing & Accounting Setup — AMS</PageTitle>

<AppPageHeader Title="Billing & Accounting Setup"
               Subtitle="Tenant admin control center for billing modes, invoice settings, payment providers, payment plans, taxes and fees, GL mapping, reconciliation rules, and collections rules"
               Icon="bi-receipt-cutoff">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/tenant/billing/modes")'>
            <i class="bi bi-diagram-3" aria-hidden="true"></i> Billing Modes
        </button>
    </Actions>
</AppPageHeader>

<section class="billcfg-hero" aria-label="Billing and accounting setup overview">
    <div>
        <span class="billcfg-eyebrow">Tenant administration</span>
        <h2>Billing Setup Workflow</h2>
        <p>Configure tenant billing controls across agency/direct bill modes, invoice numbering, payment providers, payment plans, tax and fee policy, GL mapping, reconciliation automation, and collections governance.</p>
    </div>
    <div class="billcfg-hero-grid">
        @foreach (var action in _quickActions)
        {
            <button class="billcfg-quick-action" @onclick="() => Nav.NavigateTo(action.Url)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
</section>

<section class="billcfg-kpi-grid" aria-label="Billing setup metrics">
    @Kpi("Billing Modes", "4", "Active tenant modes", "bi-diagram-3", "billcfg-tone-blue")
    @Kpi("Providers", "3", "Payment integrations", "bi-credit-card", "billcfg-tone-green")
    @Kpi("GL Rules", "28", "Posting mappings", "bi-journals", "billcfg-tone-violet")
    @Kpi("Exceptions", "11", "Setup reviews needed", "bi-exclamation-triangle", "billcfg-tone-red")
</section>

<section class="billcfg-command-bar" aria-label="Billing setup filters">
    <div class="billcfg-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search"
               placeholder="Search billing setup, owner, control, module..."
               @bind="_search"
               @bind:event="oninput" />
    </div>
    <div class="billcfg-pill-group" role="group" aria-label="Billing setup workflow filter">
        @foreach (var filter in _filters)
        {
            <button class="billcfg-pill @(_filter == filter.Key ? "billcfg-pill--active" : "")"
                    @onclick="() => _filter = filter.Key">
                @filter.Label
                <span>@FilterCount(filter.Key)</span>
            </button>
        }
    </div>
</section>

<section class="billcfg-layout">
    <div class="billcfg-flow" aria-label="Billing setup workflow lanes">
        @foreach (var lane in _lanes)
        {
            var laneItems = FilteredWorkflow.Where(x => x.Stage == lane.Key).ToList();
            <article class="billcfg-lane">
                <header class="billcfg-lane-header">
                    <div>
                        <span class="billcfg-lane-title">@lane.Label</span>
                        <span class="billcfg-lane-subtitle">@lane.Description</span>
                    </div>
                    <span class="billcfg-lane-count">@laneItems.Count</span>
                </header>

                <div class="billcfg-lane-list">
                    @if (laneItems.Count == 0)
                    {
                        <div class="billcfg-empty-mini">No visible workflow items.</div>
                    }
                    else
                    {
                        @foreach (var item in laneItems)
                        {
                            <button class="billcfg-work-card @(item.Risk == "High" ? "billcfg-work-card--risk" : "")"
                                    @onclick="() => _selected = item">
                                <div class="billcfg-work-topline">
                                    <span class="billcfg-chip @ToneCss(item.Domain)">@item.Domain</span>
                                    <span class="billcfg-status @RiskCss(item.Risk)">@item.Risk</span>
                                </div>
                                <strong>@item.Title</strong>
                                <p>@item.Summary</p>
                                <div class="billcfg-work-meta">
                                    <span><i class="bi bi-person" aria-hidden="true"></i> @item.Owner</span>
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> @item.Sla</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            </article>
        }
    </div>

    <aside class="billcfg-admin-panel" aria-label="Tenant billing setup administration controls">
        @if (_selected is null)
        {
            <div class="billcfg-side-empty">
                <i class="bi bi-receipt-cutoff" aria-hidden="true"></i>
                <h3>Billing governance</h3>
                <p>Select a workflow item to inspect owner, SLA, risk, control, and setup module.</p>
            </div>
        }
        else
        {
            <div class="billcfg-detail-header">
                <span class="billcfg-chip @ToneCss(_selected.Domain)">@_selected.Domain</span>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close details">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h3>@_selected.Title</h3>
            <p>@_selected.Summary</p>

            <dl class="billcfg-detail-list">
                <div><dt>Owner</dt><dd>@_selected.Owner</dd></div>
                <div><dt>Stage</dt><dd>@_selected.Stage</dd></div>
                <div><dt>Risk</dt><dd><span class="billcfg-status @RiskCss(_selected.Risk)">@_selected.Risk</span></dd></div>
                <div><dt>SLA</dt><dd>@_selected.Sla</dd></div>
                <div><dt>Control</dt><dd>@_selected.Control</dd></div>
            </dl>

            <div class="billcfg-policy-card">
                <strong>Tenant billing controls</strong>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Billing modes, invoice numbering, and payment terms governed</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Payment provider, tax, fee, and GL mappings auditable</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Reconciliation and collections rules monitored for exceptions</span>
            </div>

            <div class="billcfg-detail-actions">
                <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selected.Url)">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Module
                </button>
                <button class="um-btn um-btn-ghost" @onclick="() => Advance(_selected)">
                    <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Advance
                </button>
            </div>
        }
    </aside>
</section>

<section class="billcfg-module-grid" aria-label="Billing setup modules">
    @foreach (var module in _modules)
    {
        <button class="billcfg-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
            <span class="billcfg-module-icon @ToneCss(module.Domain)"><i class="bi @module.Icon" aria-hidden="true"></i></span>
            <span class="billcfg-module-content">
                <strong>@module.Title</strong>
                <small>@module.Description</small>
            </span>
            <i class="bi bi-chevron-right billcfg-module-arrow" aria-hidden="true"></i>
        </button>
    }
</section>

@code {
    private string _search = string.Empty;
    private string _filter = string.Empty;
    private BillingSetupWorkflowItem? _selected;
    private readonly List<BillingSetupWorkflowItem> _workflow = [];

    private readonly Lane[] _lanes =
    [
        new("Configure", "Configure", "Modes, invoices, providers"),
        new("Price", "Price", "Plans, taxes, fees"),
        new("Post", "Post", "GL mapping and accounting"),
        new("Reconcile", "Reconcile", "Matching and exception rules"),
        new("Collect", "Collect", "Collections policy")
    ];

    private readonly Filter[] _filters =
    [
        new("", "All"),
        new("risk", "High Risk"),
        new("payments", "Payments"),
        new("gl", "GL"),
        new("collections", "Collections")
    ];

    private readonly BillingSetupModule[] _modules =
    [
        new("Billing Modes", "Configure agency bill, direct bill, installments, account bill, and statement modes.", "/tenant/billing/modes", "bi-diagram-3", "Modes"),
        new("Invoice Settings", "Manage numbering, due dates, templates, delivery, late fees, and invoice approval policy.", "/tenant/billing/invoices", "bi-file-earmark-text", "Invoices"),
        new("Payment Providers", "Control processors, credentials, settlement webhooks, refunds, and failure routing.", "/tenant/billing/providers", "bi-credit-card", "Payments"),
        new("Payment Plans", "Define installment schedules, down payments, grace windows, autopay rules, and defaults.", "/tenant/billing/plans", "bi-calendar-check", "Payments"),
        new("Taxes & Fees", "Configure premium taxes, agency fees, service fees, surcharge rules, and exemptions.", "/tenant/billing/taxes", "bi-percent", "Pricing"),
        new("GL Accounts", "Map AR, cash, premium payable, fees, taxes, bad debt, and revenue accounts.", "/tenant/billing/gl", "bi-journals", "GL"),
        new("Reconciliation Rules", "Set matching tolerances, bank deposit grouping, carrier statement logic, and exceptions.", "/tenant/billing/recon", "bi-ui-checks-grid", "Reconciliation"),
        new("Collections Rules", "Define dunning, promises-to-pay, suspension policy, write-off thresholds, and escalation.", "/tenant/billing/collections", "bi-exclamation-triangle", "Collections")
    ];

    private readonly BillingSetupModule[] _quickActions =
    [
        new("Modes", "", "/tenant/billing/modes", "bi-diagram-3", "Modes"),
        new("Providers", "", "/tenant/billing/providers", "bi-credit-card", "Payments"),
        new("GL", "", "/tenant/billing/gl", "bi-journals", "GL"),
        new("Collections", "", "/tenant/billing/collections", "bi-exclamation-triangle", "Collections")
    ];

    private IEnumerable<BillingSetupWorkflowItem> FilteredWorkflow => _workflow.Where(item =>
        (string.IsNullOrWhiteSpace(_filter) || _filter switch
        {
            "risk" => item.Risk == "High",
            "payments" => item.Domain == "Payments",
            "gl" => item.Domain == "GL",
            "collections" => item.Domain == "Collections",
            _ => true
        }) &&
        (string.IsNullOrWhiteSpace(_search) ||
         item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Domain.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Control.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(x => x.Risk == "High")
        .ThenBy(x => x.Stage)
        .ThenBy(x => x.Title);

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Billing & Accounting Setup", "/tenant/billing/modes"));
        BuildWorkflow();
        _selected = _workflow.FirstOrDefault(x => x.Risk == "High") ?? _workflow.FirstOrDefault();
    }

    private void BuildWorkflow()
    {
        _workflow.Clear();
        _workflow.AddRange(
        [
            new("Billing mode rollout", "Agency bill and direct bill modes require tenant admin validation before enabling for all branches.", "Modes", "Medium", "Configure", "Diana Perez", "This week", "Billing mode approval", "/tenant/billing/modes"),
            new("Invoice numbering policy", "Invoice prefix, sequence reset, and branch-level numbering need approval before next cycle.", "Invoices", "Medium", "Configure", "Sarah Kim", "5 days", "Invoice numbering control", "/tenant/billing/invoices"),
            new("Payment provider webhook", "Settlement and refund webhooks need validation after gateway credential rotation.", "Payments", "High", "Configure", "Kevin Obi", "Today", "Provider webhook validation", "/tenant/billing/providers"),
            new("Payment plan grace window", "Installment grace period and autopay retry windows need updated tenant defaults.", "Payments", "Medium", "Price", "Maria Santos", "This week", "Payment plan policy", "/tenant/billing/plans"),
            new("Tax and fee exemption review", "Commercial surplus lines fee and tax exemption rules need review for new jurisdictions.", "Pricing", "High", "Price", "James Park", "48h", "Tax and fee governance", "/tenant/billing/taxes"),
            new("GL mapping exception", "Premium payable and agency fee mappings are missing for a new line of business.", "GL", "High", "Post", "Robert Yamamoto", "Today", "GL mapping approval", "/tenant/billing/gl"),
            new("Bank reconciliation tolerance", "Deposit matching tolerance and unapplied cash exception thresholds require adjustment.", "Reconciliation", "Medium", "Reconcile", "Lisa Chen", "2 days", "Reconciliation rule control", "/tenant/billing/recon"),
            new("Collections escalation policy", "Delinquency dunning, suspension, and write-off thresholds require tenant admin approval.", "Collections", "High", "Collect", "Diana Perez", "Today", "Collections governance", "/tenant/billing/collections")
        ]);
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _filter = string.Empty;
    }

    private void Advance(BillingSetupWorkflowItem item)
    {
        item.Stage = item.Stage switch
        {
            "Configure" => "Price",
            "Price" => "Post",
            "Post" => "Reconcile",
            "Reconcile" => "Collect",
            _ => "Collect"
        };
    }

    private int FilterCount(string key) => key switch
    {
        "risk" => _workflow.Count(x => x.Risk == "High"),
        "payments" => _workflow.Count(x => x.Domain == "Payments"),
        "gl" => _workflow.Count(x => x.Domain == "GL"),
        "collections" => _workflow.Count(x => x.Domain == "Collections"),
        _ => _workflow.Count
    };

    private static string ToneCss(string domain) => domain switch
    {
        "Modes" => "billcfg-tone-blue",
        "Invoices" => "billcfg-tone-cyan",
        "Payments" => "billcfg-tone-green",
        "Pricing" => "billcfg-tone-amber",
        "GL" => "billcfg-tone-violet",
        "Reconciliation" => "billcfg-tone-blue",
        "Collections" => "billcfg-tone-red",
        _ => "billcfg-tone-neutral"
    };

    private static string RiskCss(string risk) => risk switch
    {
        "High" => "billcfg-status-high",
        "Medium" => "billcfg-status-medium",
        _ => "billcfg-status-low"
    };

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="billcfg-kpi-card">
        <span class="billcfg-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span>
        <div>
            <strong>@value</strong>
            <span>@label</span>
            <small>@meta</small>
        </div>
    </article>;

    private sealed record Lane(string Key, string Label, string Description);
    private sealed record Filter(string Key, string Label);
    private sealed record BillingSetupModule(string Title, string Description, string Url, string Icon, string Domain)
    {
        public string Label => Title;
    }

    private sealed class BillingSetupWorkflowItem(string title, string summary, string domain, string risk, string stage, string owner, string sla, string control, string url)
    {
        public string Title { get; set; } = title;
        public string Summary { get; set; } = summary;
        public string Domain { get; set; } = domain;
        public string Risk { get; set; } = risk;
        public string Stage { get; set; } = stage;
        public string Owner { get; set; } = owner;
        public string Sla { get; set; } = sla;
        public string Control { get; set; } = control;
        public string Url { get; set; } = url;
    }
}
