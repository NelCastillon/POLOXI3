@page "/client/account-events"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos
@using Ams.Web.Components.Pages.Accounts

<PageTitle>Account Events — Tenant Admin</PageTitle>

<AppPageHeader Title="Account Events" Subtitle="Tenant Admin event stream across account records" Icon="bi-lightning"><Actions><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<section class="ma-hero acct-hero"><div><span class="ma-eyebrow">Tenant Admin · Account Intelligence</span><h2>Account Event Stream</h2><p>Review account creation, lifecycle, ownership, notes, portal, and relationship events in one operational feed.</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/accounts")'><i class="bi bi-building"></i> Account Directory</button></div></section>
<div class="pc-kpi-strip acct-kpi-strip"><div class="pc-kpi-card @(_activeFilter is null ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter(null)'><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-lightning"></i></span><div><div class="pc-kpi-value">@_events.Count</div><div class="pc-kpi-label">Events</div></div></div><div class="pc-kpi-card @(_activeFilter == "Account" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Account")'><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-building"></i></span><div><div class="pc-kpi-value">@_events.Count(x => x.Type == "Account")</div><div class="pc-kpi-label">Account</div></div></div><div class="pc-kpi-card @(_activeFilter == "Note" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Note")'><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-sticky"></i></span><div><div class="pc-kpi-value">@_events.Count(x => x.Type == "Note")</div><div class="pc-kpi-label">Notes</div></div></div><div class="pc-kpi-card @(_activeFilter == "Portal" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Portal")'><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-envelope"></i></span><div><div class="pc-kpi-value">@_events.Count(x => x.Type == "Portal")</div><div class="pc-kpi-label">Portal</div></div></div></div>
<div class="ma-filter-bar acct-filter-bar"><div class="ma-search-wrap"><i class="bi bi-search"></i><input class="ma-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search account events…" /></div><button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button><span class="ma-filter-count">@Filtered.Count() events</span></div>
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }
@if (_loading) { <div class="mt-loading"><div class="um-spinner"></div><span>Loading account events…</span></div> }
<div class="ma-content acct-timeline-card"><div class="ma-feed">@foreach (var group in Filtered.GroupBy(x => x.DateUtc.Date).OrderByDescending(g => g.Key)) { <div class="ma-date-sep"><span>@group.Key.ToString("MMM d, yyyy")</span></div>@foreach (var item in group.OrderByDescending(x => x.DateUtc)) { <div class="ma-feed-item" @onclick="() => NavigateAccount(item.AccountId)"><div class="ma-feed-icon acct-tone-@item.Tone"><i class="bi @item.Icon"></i></div><div class="ma-feed-body"><div class="ma-feed-hdr"><span class="ma-feed-acct">@item.Title</span><span class="ma-type-chip acct-tone-@item.Tone">@item.Type</span></div><div class="ma-feed-notes">@item.Description</div><div class="ma-feed-meta"><span><i class="bi bi-building"></i> @item.AccountName</span><span><i class="bi bi-clock"></i> @item.DateUtc.ToLocalTime().ToString("h:mm tt")</span></div></div></div> } } @if (!Filtered.Any()) { <div class="ma-empty"><i class="bi bi-lightning ma-empty-icon"></i><span>No account events match current filters.</span></div> }</div></div>
@code { sealed record AccountEventItem(Guid? AccountId, string AccountName, string Type, string Title, string Description, DateTime DateUtc, string Icon, string Tone); List<AccountEventItem> _events = []; string _search = string.Empty; string? _activeFilter, _loadError; bool _loading; IEnumerable<AccountEventItem> Filtered => _events.Where(x => (_activeFilter is null || x.Type == _activeFilter) && (string.IsNullOrWhiteSpace(_search) || x.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Description.Contains(_search, StringComparison.OrdinalIgnoreCase))); protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Accounts", "/accounts"), new("Account Events")); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { var accounts = (await Api.SearchAccountsAsync(AccountPageConstants.TenantId))?.Items.ToList() ?? []; var notes = (await Api.SearchAccountNotesAsync(AccountPageConstants.TenantId))?.Items.ToList() ?? []; var invites = (await Api.SearchPortalInvitesAsync(AccountPageConstants.TenantId))?.Items.ToList() ?? []; _events = accounts.Take(100).Select(a => new AccountEventItem(a.AccountId, a.AccountName, "Account", "Account created", $"{a.AccountTypeCode} account in {a.StatusCode} status.", a.CreatedDateUtc, "bi-building", "info")).Concat(notes.Select(n => new AccountEventItem(n.AccountId, n.AccountName, "Note", n.NoteTypeCode, n.NoteText, n.CreatedDateUtc, "bi-sticky", n.NoteTypeCode == "Critical" ? "danger" : "warning"))).Concat(invites.Select(i => new AccountEventItem(i.AccountId, i.AccountName, "Portal", $"Portal invite {i.StatusCode}", $"{i.ContactName} invited at {i.InviteEmail}.", i.CreatedDateUtc, "bi-envelope", i.StatusCode == "Accepted" ? "success" : "info"))).OrderByDescending(x => x.DateUtc).ToList(); } catch (Exception ex) { _loadError = $"Failed to load account events: {ex.Message}"; } finally { _loading = false; } } void NavigateAccount(Guid? accountId) { if (accountId.HasValue) Nav.NavigateTo($"/accounts/{accountId.Value}"); } void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; } void SetFilter(string? key) { _activeFilter = key; } void ResetFilters() { _activeFilter = null; _search = string.Empty; } }
