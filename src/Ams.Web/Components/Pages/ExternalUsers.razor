@page "/iam/external-users"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>External Users</PageTitle>
<AppPageHeader Title="External Users" Icon="bi-person" />
<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(ExternalUserProfileDto.UserFullName)"        HeaderText="User"            Width="180"></GridColumn>
        <GridColumn Field="@nameof(ExternalUserProfileDto.ExternalUserTypeCode)" HeaderText="Type"           Width="110"></GridColumn>
        <GridColumn Field="@nameof(ExternalUserProfileDto.OrganizationName)"    HeaderText="Organization"    Width="200"></GridColumn>
        <GridColumn Field="@nameof(ExternalUserProfileDto.LicenseNumber)"       HeaderText="License #"       Width="130"></GridColumn>
        <GridColumn Field="@nameof(ExternalUserProfileDto.LicenseState)"        HeaderText="State"           Width="80"></GridColumn>
        <GridColumn Field="@nameof(ExternalUserProfileDto.NpnNumber)"           HeaderText="NPN"             Width="100"></GridColumn>
        <GridColumn Field="@nameof(ExternalUserProfileDto.PortalAccessEnabled)" HeaderText="Portal Access"   Width="110" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(ExternalUserProfileDto.SsoProvider)"         HeaderText="SSO Provider"    Width="120"></GridColumn>
        <GridColumn Field="@nameof(ExternalUserProfileDto.PortalLastLoginDateUtc)" HeaderText="Last Login"   Width="140" Type="ColumnType.DateTime" Format="MM/dd/yyyy"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private Guid DefaultTenantId { get; set; }
    private string? _searchTerm;
    private List<ExternalUserProfileDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchExternalUserProfilesAsync(DefaultTenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
