    private async Task EnsureSeedDataAsync()
    {
        if (_rules.Count > 0) return;
        if (_segments.Count == 0)
        {
            await Api.CreateAccountSegmentAsync(new CreateAccountSegmentRequest { TenantId = _tenantId, SegmentCode = "VIP", SegmentName = "VIP Tier", Description = "High-value accounts with executive retention focus.", IsActive = true });
            await Api.CreateAccountSegmentAsync(new CreateAccountSegmentRequest { TenantId = _tenantId, SegmentCode = "STANDARD", SegmentName = "Standard Tier", Description = "Core accounts with normal service cadence.", IsActive = true });
            var segmentsResult = await Api.SearchAccountSegmentsAsync(null, 1, 250);
            _segments = segmentsResult?.Items?.OrderBy(x => x.SegmentName).ToList() ?? [];
        }
        var vip = _segments.FirstOrDefault(x => Contains(x.SegmentName, "VIP") || string.Equals(x.SegmentCode, "VIP", StringComparison.OrdinalIgnoreCase)) ?? _segments.First();
        var standard = _segments.FirstOrDefault(x => Contains(x.SegmentName, "Standard") || string.Equals(x.SegmentCode, "STANDARD", StringComparison.OrdinalIgnoreCase)) ?? _segments.First();
        var seeds = new[]
        {
            new CreateAccountSegmentRuleRequest { TenantId = _tenantId, SegmentId = vip.SegmentId, SegmentCode = vip.SegmentCode, RuleCode = "VIP-ENTERPRISE", RuleName = "VIP Enterprise Clients", Description = "Automatically identify high-value enterprise relationships for focused retention and executive outreach.", CriteriaJson = JsonSerializer.Serialize(new[] { new RuleCriterion { Field = "AnnualRevenue", Operator = "GreaterThan", Value = "10000000", Points = 45 }, new RuleCriterion { Field = "LifecycleStage", Operator = "Equals", Value = "Client", Points = 20 } }, JsonOptions), Priority = 1, RunOnSchedule = true, IsActive = true, CreatedByUserId = _userId },
            new CreateAccountSegmentRuleRequest { TenantId = _tenantId, SegmentId = standard.SegmentId, SegmentCode = standard.SegmentCode, RuleCode = "MIDMARKET-GROWTH", RuleName = "Mid-Market Growth Segment", Description = "Surface growing mid-market accounts ready for advisory, cross-sell, and rounding workflows.", CriteriaJson = JsonSerializer.Serialize(new[] { new RuleCriterion { Field = "AnnualRevenue", Operator = "GreaterThan", Value = "1000000", Points = 25 }, new RuleCriterion { Field = "AnnualRevenue", Operator = "LessThan", Value = "10000000", Points = 15 } }, JsonOptions), Priority = 2, RunOnSchedule = true, IsActive = true, CreatedByUserId = _userId }
        };
        foreach (var seed in seeds) await Api.CreateAccountSegmentRuleAsync(seed);
    }

    private List<AccountDto> AccountsFor(AccountSegmentRuleDto rule) => _accounts.Where(x => string.Equals(x.SegmentCode, rule.SegmentCode, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.AccountName).ToList();
    private decimal AverageAccuracy() => _rules.Count == 0 ? 0 : _rules.Average(x => x.AccuracyPercent);
    private static bool IsValidCriterion(RuleCriterion criterion) => !string.IsNullOrWhiteSpace(criterion.Field) && !string.IsNullOrWhiteSpace(criterion.Operator) && !string.IsNullOrWhiteSpace(criterion.Value);
    private string? ValidateCriteria() => _form.Criteria.Any(IsValidCriterion) ? null : "At least one complete criterion is required.";
    private static List<RuleCriterion> CriteriaFor(AccountSegmentRuleDto rule) { try { return JsonSerializer.Deserialize<List<RuleCriterion>>(rule.CriteriaJson, JsonOptions) ?? []; } catch { return []; } }
    private static string CriteriaSummary(AccountSegmentRuleDto rule) { var criteria = CriteriaFor(rule); return criteria.Count == 0 ? "No criteria" : string.Join(" AND ", criteria.Take(2).Select(x => $"{x.Field} {x.Operator} {x.Value}")) + (criteria.Count > 2 ? $" +{criteria.Count - 2}" : string.Empty); }
    private static IEnumerable<BreakdownRow> BuildBreakdown(IEnumerable<(string Label, int Count)> rows) { var list = rows.OrderByDescending(x => x.Count).ToList(); var max = Math.Max(1, list.Select(x => x.Count).DefaultIfEmpty(1).Max()); return list.Select(x => new BreakdownRow(x.Label, x.Count, (double)x.Count / max * 100)); }

    private async Task ShowToastAsync(string message, string kind = "info")
    {
        _toastCts?.Cancel(); _toastCts?.Dispose(); _toastCts = new CancellationTokenSource();
        _toastMessage = message.Length <= 140 ? message : $"{message[..137]}..."; _toastKind = ToastKind(kind); _toastVisible = true; StateHasChanged();
        _ = HideToastAfterDelayAsync(_toastCts.Token, _toastKind == "danger" ? 5200 : 2800);
        await Task.CompletedTask;
    }

    private async Task HideToastAfterDelayAsync(CancellationToken cancellationToken, int delayMs)
    {
        try { await Task.Delay(delayMs, cancellationToken); _toastVisible = false; await InvokeAsync(StateHasChanged); } catch (TaskCanceledException) { }
    }

    private void HideToast() { _toastCts?.Cancel(); _toastVisible = false; }
    private static string ToastKind(string value) => value.Contains("danger", StringComparison.OrdinalIgnoreCase) || value.Contains("error", StringComparison.OrdinalIgnoreCase) ? "danger" : value.Contains("warning", StringComparison.OrdinalIgnoreCase) ? "warning" : value.Contains("success", StringComparison.OrdinalIgnoreCase) ? "success" : "info";
    private async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; _userId = context.UserId; }
    private static bool Contains(string value, string term) => value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static string NormalizeCode(string value) => value.Trim().ToUpperInvariant().Replace(' ', '-');
    private static string Initials(string name) { var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length > 0 ? name[..1] : "?"; }
    private static string AvatarClass(string name) { var classes = new[] { "sr-av1", "sr-av2", "sr-av3", "sr-av4", "sr-av5", "sr-av6" }; return classes[Math.Abs(name.GetHashCode()) % classes.Length]; }
    private static string LabelFor(IEnumerable<Option> options, string? value) => options.FirstOrDefault(x => string.Equals(x.Value, value, StringComparison.OrdinalIgnoreCase))?.Label ?? value ?? "Unspecified";
    private static string StatusClass(AccountSegmentRuleDto rule) => rule.IsActive ? "sr-status sr-status-active" : "sr-status sr-status-inactive";
    private static string StatusDotClass(AccountSegmentRuleDto rule) => rule.IsActive ? "sr-active" : "sr-inactive";
    private static string AccuracyClass(AccountSegmentRuleDto rule) => rule.AccuracyPercent >= 90 ? "sr-accuracy sr-accuracy-high" : rule.AccuracyPercent >= 75 ? "sr-accuracy sr-accuracy-med" : "sr-accuracy sr-accuracy-low";
    private string RowClass(AccountSegmentRuleDto rule) => _selected?.RuleId == rule.RuleId ? "sr-row-selected" : string.Empty;
    private string MetricCardClass(MetricCard metric) => $"sr-kpi-card {metric.Tone} {(_kpiFilter == metric.Filter && !string.IsNullOrWhiteSpace(metric.Filter) ? "sr-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewDef view) => _view == view.Id ? "sr-view-btn sr-view-btn-active" : "sr-view-btn";

