    private async Task SaveRuleAsync()
    {
        _formError = ValidateCriteria();
        if (!string.IsNullOrWhiteSpace(_formError)) return;
        _saving = true;
        try
        {
            var segment = _segments.FirstOrDefault(x => string.Equals(x.SegmentCode, _form.SegmentCode, StringComparison.OrdinalIgnoreCase));
            var criteriaJson = JsonSerializer.Serialize(_form.Criteria.Where(IsValidCriterion), JsonOptions);
            if (_editingId == Guid.Empty)
            {
                await Api.CreateAccountSegmentRuleAsync(new CreateAccountSegmentRuleRequest { TenantId = _tenantId, SegmentId = segment?.SegmentId, SegmentCode = _form.SegmentCode, RuleCode = NormalizeCode(_form.RuleCode), RuleName = _form.RuleName, Description = _form.Description, CriteriaJson = criteriaJson, LogicConnector = "AND", Priority = _form.Priority, RunOnSchedule = _form.RunOnSchedule, IsActive = _form.IsActive, CreatedByUserId = _userId });
                await ShowToastAsync("Segmentation rule created.", "success");
            }
            else
            {
                await Api.UpdateAccountSegmentRuleAsync(_editingId, new UpdateAccountSegmentRuleRequest { RuleId = _editingId, SegmentId = segment?.SegmentId, SegmentCode = _form.SegmentCode, RuleCode = NormalizeCode(_form.RuleCode), RuleName = _form.RuleName, Description = _form.Description, CriteriaJson = criteriaJson, LogicConnector = "AND", Priority = _form.Priority, RunOnSchedule = _form.RunOnSchedule, IsActive = _form.IsActive, ModifiedByUserId = _userId });
                await ShowToastAsync("Segmentation rule saved.", "success");
            }
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

