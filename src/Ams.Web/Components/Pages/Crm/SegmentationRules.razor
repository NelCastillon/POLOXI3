@page "/crm/segments/rules"
@namespace Ams.Web.Components.Pages.Crm
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.AccountSegments
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text.Json
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Segmentation Rules â€” CRM</PageTitle>

@if (_toastVisible)
{
    <div class="sr-toast sr-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIcon" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="sr-toast-close" @onclick="HideToast" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="sr-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="sr-rule-modal" role="dialog" aria-modal="true" aria-labelledby="ruleFormTitle" @onclick:stopPropagation="true">
            <EditForm Model="_form" OnValidSubmit="SaveRuleAsync" OnInvalidSubmit="HandleInvalidSubmitAsync">
                <DataAnnotationsValidator />
                <div class="sr-modal-header">
                    <div class="sr-modal-title">
                        <span class="sr-modal-icon"><i class="bi bi-sliders2" aria-hidden="true"></i></span>
                        <div>
                            <h2 id="ruleFormTitle">@(_editingId == Guid.Empty ? "New segmentation rule" : "Edit segmentation rule")</h2>
                            <p>Define account criteria, segment assignment, scheduling, and scoring controls.</p>
                        </div>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseForm" disabled="@_saving" aria-label="Close rule form"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="sr-modal-body">
                    <div class="sr-form-banner">
                        <i class="bi bi-database-check" aria-hidden="true"></i>
                        <div>
                            <strong>CRM.SegmentationRule backed workflow</strong>
                            <span>Rules are persisted, tenant scoped, and recalculated against account segment assignments.</span>
                        </div>
                    </div>
                    <div class="sr-form-grid">
                        <div class="sr-field">
                            <label for="ruleName">Rule name <span>*</span></label>
                            <InputText id="ruleName" class="sr-input" @bind-Value="_form.RuleName" placeholder="VIP Enterprise Clients" />
                        </div>
                        <div class="sr-field">
                            <label for="ruleCode">Rule code <span>*</span></label>
                            <InputText id="ruleCode" class="sr-input" @bind-Value="_form.RuleCode" placeholder="VIP-ENTERPRISE" />
                        </div>
                        <div class="sr-field">
                            <label for="segmentCode">Target segment <span>*</span></label>
                            <InputSelect id="segmentCode" class="sr-input" @bind-Value="_form.SegmentCode">
                                <option value="">Select segment</option>
                                @foreach (var segment in _segments)
                                {
                                    <option value="@segment.SegmentCode">@segment.SegmentName (@segment.SegmentCode)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="sr-field">
                            <label for="priority">Priority</label>
                            <InputNumber id="priority" class="sr-input" @bind-Value="_form.Priority" />
                        </div>
                        <div class="sr-field sr-field-wide">
                            <label for="description">Description</label>
                            <InputTextArea id="description" class="sr-input sr-textarea" @bind-Value="_form.Description" placeholder="Describe when this rule should classify accounts into the target segment..." />
                        </div>
                    </div>

                    <section class="sr-criteria-editor" aria-label="Rule criteria editor">
                        <header>
                            <div>
                                <strong>Criteria</strong>
                                <span>Add at least one criterion. Criteria are stored as JSON for future rules-engine execution.</span>
                            </div>
                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="AddCriterion"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Criterion</button>
                        </header>
                        @foreach (var criterion in _form.Criteria)
                        {
                            <div class="sr-criterion-row">
                                <div class="sr-field">
                                    <label>Field <span>*</span></label>
                                    <InputSelect class="sr-input" @bind-Value="criterion.Field">
                                        <option value="">Field</option>
                                        @foreach (var option in FieldOptions)
                                        {
                                            <option value="@option.Value">@option.Label</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="sr-field">
                                    <label>Operator <span>*</span></label>
                                    <InputSelect class="sr-input" @bind-Value="criterion.Operator">
                                        <option value="">Operator</option>
                                        @foreach (var option in OperatorOptions)
                                        {
                                            <option value="@option.Value">@option.Label</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="sr-field">
                                    <label>Value <span>*</span></label>
                                    <InputText class="sr-input" @bind-Value="criterion.Value" placeholder="1000000" />
                                </div>
                                <div class="sr-field">
                                    <label>Points</label>
                                    <InputNumber class="sr-input" @bind-Value="criterion.Points" />
                                </div>
                                <button type="button" class="um-btn um-btn-ghost um-btn-sm sr-remove-criterion" @onclick="@(() => RemoveCriterion(criterion))" title="Remove criterion"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_formError))
                        {
                            <div class="sr-form-error"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_formError</div>
                        }
                    </section>

                    <div class="sr-options-grid">
                        <label class="sr-check-card"><InputCheckbox @bind-Value="_form.IsActive" /><span><strong>Active rule</strong><small>Include this rule in automated segment processing.</small></span></label>
                        <label class="sr-check-card"><InputCheckbox @bind-Value="_form.RunOnSchedule" /><span><strong>Run on schedule</strong><small>Allow scheduled jobs to evaluate this rule.</small></span></label>
                    </div>
                </div>
                <div class="sr-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_saving">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi @(_saving ? "bi-arrow-repeat sr-spin" : "bi-check2")" aria-hidden="true"></i> @(_editingId == Guid.Empty ? "Create Rule" : "Save Rule")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showDeleteConfirm && _deleteTarget is not null)
{
    <div class="sr-modal-backdrop" role="presentation" @onclick="CancelDelete">
        <div class="sr-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="deleteRuleTitle" @onclick:stopPropagation="true">
            <div class="sr-confirm-icon sr-confirm-danger"><i class="bi bi-trash3-fill" aria-hidden="true"></i></div>
            <h2 id="deleteRuleTitle">Delete segmentation rule</h2>
            <p>Delete <strong>@_deleteTarget.RuleName</strong>? This soft-deletes the persisted rule and removes it from scheduled processing.</p>
            <div class="sr-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CancelDelete" disabled="@_saving">Cancel</button>
                <button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
            </div>
        </div>
    </div>
}

<div class="sr-enterprise-page">
    <section class="sr-hero">
        <div class="sr-hero-left">
            <span class="sr-hero-icon"><i class="bi bi-sliders2" aria-hidden="true"></i></span>
            <div>
                <div class="sr-title-row">
                    <h1>Segmentation Rules</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> CRM.SegmentationRule</span>
                    <span><i class="bi bi-diagram-3" aria-hidden="true"></i> Segment workflow</span>
                </div>
                <p>Design, run, and govern automatic account segmentation rules with enterprise CRM controls.</p>
            </div>
        </div>
        <div class="sr-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="RecalculateAllAsync" disabled="@(_loading || _saving)" title="Recalculate all rules"><i class="bi @(_saving ? "bi-arrow-repeat sr-spin" : "bi-lightning-charge")" aria-hidden="true"></i> Recalculate</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh rules"><i class="bi @(_loading ? "bi-arrow-repeat sr-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate" title="Create segmentation rule"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Rule</button>
        </div>
    </section>

    <section class="sr-kpi-strip" aria-label="Segmentation rule metrics">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" title="@metric.Tooltip" @onclick="@(() => SetKpiFilter(metric.Filter))">
                <span class="sr-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span><span class="sr-kpi-val">@metric.Value</span><span class="sr-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
            </button>
        }
    </section>

    <section class="sr-workflow-strip" aria-label="Segmentation rules workflow shortcuts">
        <button type="button" class="sr-workflow-card" @onclick="ShowRules"><i class="bi bi-list-ul" aria-hidden="true"></i><span><strong>Rules</strong><span>Manage active and inactive rules.</span></span></button>
        <button type="button" class="sr-workflow-card" @onclick="ShowActive"><i class="bi bi-check2-circle" aria-hidden="true"></i><span><strong>Active focus</strong><span>Filter active automation rules.</span></span></button>
        <button type="button" class="sr-workflow-card" @onclick="ShowCriteria"><i class="bi bi-braces" aria-hidden="true"></i><span><strong>Criteria</strong><span>Audit rule logic and JSON criteria.</span></span></button>
        <button type="button" class="sr-workflow-card" @onclick="ShowAnalytics"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span><strong>Analytics</strong><span>Measure match coverage and accuracy.</span></span></button>
    </section>

    <section class="sr-search-panel">
        <div class="sr-search-wrap">
            <span class="sr-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="sr-search-body">
                <label for="ruleSearchInput">Search rules</label>
                <input id="ruleSearchInput" class="sr-search-input" @bind-value="Search" @bind-value:event="oninput" placeholder="Search name, code, segment, description, or criteria..." />
                <span class="sr-search-hint">Filters persisted segmentation rules instantly.</span>
            </div>
        </div>
        <select class="sr-filter-select" @bind="StatusFilter"><option value="">All statuses</option><option value="active">Active</option><option value="inactive">Inactive</option></select>
        <select class="sr-filter-select" @bind="SegmentFilter"><option value="">All segments</option>@foreach (var segment in _segments) { <option value="@segment.SegmentCode">@segment.SegmentName</option> }</select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ClearFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
        <div class="sr-search-result"><strong>@_filtered.Count</strong><span>matches</span></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger sr-error-banner" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="sr-view-tabs" aria-label="Segmentation rule views">
        @foreach (var view in _views)
        {
            <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label</button>
        }
    </section>

    <section class="sr-content-layout">
        <main class="sr-main-card">
            @if (_loading)
            {
                <div class="sr-loading"><i class="bi bi-arrow-repeat sr-spin" aria-hidden="true"></i><strong>Loading segmentation rules...</strong></div>
            }
            else if (_filtered.Count == 0)
            {
                <div class="sr-empty-state"><i class="bi bi-sliders2" aria-hidden="true"></i><strong>No rules match this view</strong><span>Adjust filters or create a new segmentation rule.</span><div><button type="button" class="um-btn um-btn-ghost" @onclick="ClearFilters">Clear filters</button><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">New Rule</button></div></div>
            }
            else if (_view == "criteria")
            {
                <div class="sr-criteria-board">
                    @foreach (var rule in _filtered)
                    {
                        <article class="sr-criteria-card" @onclick="@(() => SelectRule(rule))">
                            <header><span class="sr-rule-icon @StatusDotClass(rule)"><i class="bi bi-braces" aria-hidden="true"></i></span><div><strong>@rule.RuleName</strong><small>@rule.RuleCode</small></div><span class="@StatusClass(rule)">@(rule.IsActive ? "Active" : "Inactive")</span></header>
                            <div class="sr-criteria-list">
                                @foreach (var criterion in CriteriaFor(rule).Take(4))
                                {
                                    <span><strong>@LabelFor(FieldOptions, criterion.Field)</strong> @LabelFor(OperatorOptions, criterion.Operator) <em>@criterion.Value</em> <b>@criterion.Points pts</b></span>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            else if (_view == "analytics")
            {
                <div class="sr-analytics-grid">
                    <section><h3>Status distribution</h3>@foreach (var row in StatusBreakdown) { <div class="sr-meter-row"><span>@row.Label</span><div><i style="width:@row.Width%"></i></div><strong>@row.Count</strong></div> }</section>
                    <section><h3>Segment coverage</h3>@foreach (var row in SegmentBreakdown) { <div class="sr-meter-row"><span>@row.Label</span><div><i style="width:@row.Width%"></i></div><strong>@row.Count</strong></div> }</section>
                    <section><h3>Match volume</h3>@foreach (var row in MatchBreakdown) { <div class="sr-meter-row"><span>@row.Label</span><div><i style="width:@row.Width%"></i></div><strong>@row.Count</strong></div> }</section>
                    <section><h3>Schedule mix</h3>@foreach (var row in ScheduleBreakdown) { <div class="sr-meter-row"><span>@row.Label</span><div><i style="width:@row.Width%"></i></div><strong>@row.Count</strong></div> }</section>
                </div>
            }
            else
            {
                <div class="sr-table-scroll">
                    <table class="sr-table">
                        <thead><tr><th>Rule</th><th>Segment</th><th>Criteria</th><th>Matched</th><th>Accuracy</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var rule in _filtered)
                            {
                                <tr class="@RowClass(rule)" @onclick="@(() => SelectRule(rule))">
                                    <td><div class="sr-name-cell"><span class="sr-rule-icon @StatusDotClass(rule)"><i class="bi bi-sliders2" aria-hidden="true"></i></span><span><strong>@rule.RuleName</strong><small>@(rule.Description ?? rule.RuleCode)</small></span></div></td>
                                    <td><span class="sr-segment-badge">@rule.SegmentName</span><small class="sr-code-small">@rule.SegmentCode</small></td>
                                    <td><span class="sr-criteria-summary">@CriteriaSummary(rule)</span></td>
                                    <td>@rule.AccountsMatched.ToString("N0", CultureInfo.CurrentCulture)</td>
                                    <td><span class="@AccuracyClass(rule)">@rule.AccuracyPercent.ToString("N0", CultureInfo.CurrentCulture)%</span></td>
                                    <td><span class="@StatusClass(rule)">@(rule.IsActive ? "Active" : "Inactive")</span></td>
                                    <td @onclick:stopPropagation="true"><div class="sr-row-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenEdit(rule))" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => RecalculateRuleAsync(rule))" title="Run rule"><i class="bi bi-play-fill" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => DuplicateRuleAsync(rule))" title="Duplicate"><i class="bi bi-files" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ConfirmDelete(rule))" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </main>

        <aside class="sr-detail-card">
            @if (_selected is null)
            {
                <div class="sr-detail-empty"><i class="bi bi-sliders2" aria-hidden="true"></i><strong>Select a rule</strong><span>Review criteria, matched accounts, and execution actions.</span></div>
            }
            else
            {
                <div class="sr-detail-head"><div><span class="sr-detail-eyebrow"><i class="bi bi-sliders" aria-hidden="true"></i> @_selected.RuleCode</span><h2>@_selected.RuleName</h2><p>@(_selected.Description ?? "No description captured")</p></div><span class="@StatusClass(_selected)">@(_selected.IsActive ? "Active" : "Inactive")</span></div>
                <div class="sr-detail-body">
                    <div class="sr-detail-summary"><div><span>Segment</span><strong>@_selected.SegmentName</strong></div><div><span>Matched</span><strong>@_selected.AccountsMatched.ToString("N0", CultureInfo.CurrentCulture)</strong></div><div><span>Accuracy</span><strong>@_selected.AccuracyPercent.ToString("N0", CultureInfo.CurrentCulture)%</strong></div><div><span>Last run</span><strong>@(_selected.LastRunDateUtc?.ToLocalTime().ToString("MMM d, h:mm tt", CultureInfo.CurrentCulture) ?? "Not run")</strong></div></div>
                    <div class="sr-rules-card"><header><span><i class="bi bi-braces" aria-hidden="true"></i> Criteria</span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenEdit(_selected))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></header>@foreach (var criterion in CriteriaFor(_selected)) { <p><strong>@LabelFor(FieldOptions, criterion.Field)</strong> @LabelFor(OperatorOptions, criterion.Operator) <em>@criterion.Value</em> <span>@criterion.Points pts</span></p> }</div>
                    <div class="sr-account-list"><header><span><i class="bi bi-building" aria-hidden="true"></i> Matched accounts</span><strong>@AccountsFor(_selected).Count</strong></header>@foreach (var account in AccountsFor(_selected).Take(6)) { <button type="button" class="sr-account-row" @onclick="@(() => Nav.NavigateTo($"/accounts/{account.AccountId}"))"><span class="sr-avatar @AvatarClass(account.AccountName)">@Initials(account.AccountName)</span><span><strong>@account.AccountName</strong><small>@(account.Industry ?? account.AccountTypeCode)</small></span><i class="bi bi-arrow-right" aria-hidden="true"></i></button> }</div>
                    <div class="sr-detail-actions"><button type="button" class="um-btn um-btn-ghost" @onclick="@(() => OpenEdit(_selected))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost" @onclick="@(() => RecalculateRuleAsync(_selected))"><i class="bi bi-play-fill" aria-hidden="true"></i> Run</button><button type="button" class="um-btn um-btn-ghost" @onclick="@(() => DuplicateRuleAsync(_selected))"><i class="bi bi-files" aria-hidden="true"></i> Duplicate</button><button type="button" class="um-btn um-btn-danger" @onclick="@(() => ConfirmDelete(_selected))"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    private Guid _tenantId;
    private Guid? _userId;
    private bool _loading;
    private bool _saving;
    private bool _showForm;
    private bool _showDeleteConfirm;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "info";
    private string? _loadError;
    private string? _formError;
    private string _view = "rules";
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private string _segmentFilter = string.Empty;
    private string _kpiFilter = string.Empty;
    private Guid _editingId = Guid.Empty;
    private CancellationTokenSource? _toastCts;
    private AccountSegmentRuleDto? _selected;
    private AccountSegmentRuleDto? _deleteTarget;
    private RuleForm _form = new();
    private List<AccountSegmentRuleDto> _rules = [];
    private List<AccountSegmentRuleDto> _filtered = [];
    private List<AccountSegmentDto> _segments = [];
    private List<AccountDto> _accounts = [];

    private static readonly ViewDef[] _views = [new("rules", "Rules", "bi-list-ul"), new("criteria", "Criteria", "bi-braces"), new("analytics", "Analytics", "bi-graph-up")];
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private static readonly Option[] FieldOptions = [new("AnnualRevenue", "Annual Revenue"), new("Industry", "Industry"), new("LifecycleStage", "Lifecycle Stage"), new("AccountType", "Account Type"), new("Status", "Account Status"), new("SegmentCode", "Segment Code")];
    private static readonly Option[] OperatorOptions = [new("Equals", "equals"), new("NotEquals", "does not equal"), new("GreaterThan", "greater than"), new("LessThan", "less than"), new("Contains", "contains"), new("IsNotEmpty", "is not empty")];

    private string Search { get => _search; set { _search = value ?? string.Empty; ApplyFilters(); } }
    private string StatusFilter { get => _statusFilter; set { _statusFilter = value ?? string.Empty; ApplyFilters(); } }
    private string SegmentFilter { get => _segmentFilter; set { _segmentFilter = value ?? string.Empty; ApplyFilters(); } }
    private string ToastIcon => _toastKind == "danger" ? "bi-exclamation-octagon" : _toastKind == "warning" ? "bi-exclamation-triangle" : _toastKind == "success" ? "bi-check2-circle" : "bi-info-circle";

    private IEnumerable<MetricCard> Metrics =>
    [
        new("Rules", _rules.Count.ToString(), "All definitions", "bi-sliders2", "sr-blue", "", "Show all segmentation rules"),
        new("Active", _rules.Count(x => x.IsActive).ToString(), "Scheduled and manual", "bi-check2-circle", "sr-green", "active", "Show active rules"),
        new("Scheduled", _rules.Count(x => x.RunOnSchedule).ToString(), "Automation ready", "bi-calendar2-check", "sr-cyan", "scheduled", "Show scheduled rules"),
        new("Matched", _rules.Sum(x => x.AccountsMatched).ToString("N0", CultureInfo.CurrentCulture), "Account matches", "bi-building", "sr-purple", "matched", "Show rules with matches"),
        new("Accuracy", AverageAccuracy().ToString("N0", CultureInfo.CurrentCulture) + "%", "Average confidence", "bi-shield-check", "sr-amber", "accurate", "Show high-accuracy rules")
    ];

    private IEnumerable<BreakdownRow> StatusBreakdown => BuildBreakdown(_filtered.GroupBy(x => x.IsActive ? "Active" : "Inactive").Select(g => (g.Key, g.Count())));
    private IEnumerable<BreakdownRow> SegmentBreakdown => BuildBreakdown(_filtered.GroupBy(x => x.SegmentName).Select(g => (g.Key, g.Count())));
    private IEnumerable<BreakdownRow> MatchBreakdown => BuildBreakdown(_filtered.Select(x => (x.RuleName, x.AccountsMatched)));
    private IEnumerable<BreakdownRow> ScheduleBreakdown => BuildBreakdown(_filtered.GroupBy(x => x.RunOnSchedule ? "Scheduled" : "Manual").Select(g => (g.Key, g.Count())));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Segments", "/crm/segments"), new("Rules", "/crm/segments/rules"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var segmentsResult = await Api.SearchAccountSegmentsAsync(null, 1, 250);
            _segments = segmentsResult?.Items?.OrderBy(x => x.SegmentName).ToList() ?? [];
            var rulesResult = await Api.SearchAccountSegmentRulesAsync(_tenantId, null, 1, 250);
            _rules = rulesResult?.Items?.OrderBy(x => x.Priority).ThenBy(x => x.RuleName).ToList() ?? [];
            await EnsureSeedDataAsync();
            rulesResult = await Api.SearchAccountSegmentRulesAsync(_tenantId, null, 1, 250);
            _rules = rulesResult?.Items?.OrderBy(x => x.Priority).ThenBy(x => x.RuleName).ToList() ?? [];
            var accountsResult = await Api.SearchAccountsAsync(_tenantId, null, 1, 500);
            _accounts = accountsResult?.Items?.ToList() ?? [];
            ApplyFilters(false);
            _selected = _selected is null ? _filtered.FirstOrDefault() : _filtered.FirstOrDefault(x => x.RuleId == _selected.RuleId) ?? _filtered.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load segmentation rules: {ex.Message}";
            _rules = [];
            _accounts = [];
            ApplyFilters(false);
            await ShowToastAsync($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters(bool resetDetail = true)
    {
        IEnumerable<AccountSegmentRuleDto> query = _rules;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            query = query.Where(x => Contains(x.RuleName, term) || Contains(x.RuleCode, term) || Contains(x.SegmentName, term) || Contains(x.SegmentCode, term) || Contains(x.Description ?? string.Empty, term) || Contains(x.CriteriaJson, term));
        }
        if (!string.IsNullOrWhiteSpace(_statusFilter)) query = _statusFilter == "active" ? query.Where(x => x.IsActive) : query.Where(x => !x.IsActive);
        if (!string.IsNullOrWhiteSpace(_segmentFilter)) query = query.Where(x => string.Equals(x.SegmentCode, _segmentFilter, StringComparison.OrdinalIgnoreCase));
        query = _kpiFilter switch
        {
            "active" => query.Where(x => x.IsActive),
            "scheduled" => query.Where(x => x.RunOnSchedule),
            "matched" => query.Where(x => x.AccountsMatched > 0),
            "accurate" => query.Where(x => x.AccuracyPercent >= 90),
            _ => query
        };
        _filtered = query.OrderBy(x => x.Priority).ThenBy(x => x.RuleName).ToList();
        if (resetDetail) _selected = _filtered.FirstOrDefault(x => x.RuleId == _selected?.RuleId) ?? _filtered.FirstOrDefault();
    }

    private void ClearFilters() { _search = string.Empty; _statusFilter = string.Empty; _segmentFilter = string.Empty; _kpiFilter = string.Empty; ApplyFilters(); }
