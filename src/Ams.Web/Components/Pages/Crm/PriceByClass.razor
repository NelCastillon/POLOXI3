@page "/crm/pricing/classes"
@namespace Ams.Web.Components.Pages.Crm
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@using Ams.Application.Common.Dtos

<PageTitle>Price by Class — CRM</PageTitle>

<AppPageHeader Title="Price by Class"
               Subtitle="Tenant admin controls for class-based rates, risk tiers, and premium bands"
               Icon="bi-diagram-3">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> Add Class</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </Actions>
</AppPageHeader>

<section class="ma-hero pmr-hero">
    <div>
        <span class="ma-eyebrow">Pricing & Market Rules</span>
        <h2>Class Rating Workspace</h2>
        <p>Review risk tiers, premium bands, and base rates with fast filtering across class codes, LOBs, and descriptions.</p>
    </div>
    <div class="ma-hero-actions">
        <button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> Add Class</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </div>
</section>

<div class="ma-view-tabs pmr-view-tabs">
    <button class="ma-view-tab" @onclick='() => Nav.NavigateTo("/crm/pricing-rules")'><i class="bi bi-tags"></i> Pricing Rules</button>
    <button class="ma-view-tab ma-view-tab--active"><i class="bi bi-diagram-3"></i> Price by Class</button>
    <button class="ma-view-tab" @onclick='() => Nav.NavigateTo("/crm/appetite")'><i class="bi bi-grid-3x3"></i> Market Appetite</button>
    <button class="ma-view-tab" @onclick='() => Nav.NavigateTo("/crm/carrier-mapping")'><i class="bi bi-broadcast"></i> Carrier Mapping</button>
</div>

<div class="pc-kpi-strip">
    <div class="pc-kpi-card @(_activeFilter == null ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter(null)' title="Show all price classes">
        <span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Classes</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "active" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("active")' title="Filter: Active">
        <span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.IsActive)</div><div class="pc-kpi-label">Active</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "commercial" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("commercial")' title="Filter: Commercial">
        <span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-building" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.LobCode.Contains("Commercial", StringComparison.OrdinalIgnoreCase))</div><div class="pc-kpi-label">Commercial</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "preferred" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("preferred")' title="Filter: Preferred risk tier">
        <span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-star-fill" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.RiskTierCode == "Preferred")</div><div class="pc-kpi-label">Preferred</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "highrate" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("highrate")' title="Filter: Base rate over 2%">
        <span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.BaseRate >= 0.02m)</div><div class="pc-kpi-label">High Rate</div></div>
    </div>
</div>

<div class="ma-filter-bar pmr-filter-bar">
    <div class="ma-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="ma-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search class, code, LOB, risk tier, description…" />
    </div>
    <div class="ma-type-pills">
        <button class="ma-pill @(_activeFilter is null ? "ma-pill-active" : "")" @onclick='() => SetFilter(null)'>All</button>
        <button class="ma-pill @(_activeFilter == "active" ? "ma-pill-active" : "")" @onclick='() => SetFilter("active")'>Active</button>
        <button class="ma-pill @(_activeFilter == "commercial" ? "ma-pill-active" : "")" @onclick='() => SetFilter("commercial")'>Commercial</button>
        <button class="ma-pill @(_activeFilter == "preferred" ? "ma-pill-active" : "")" @onclick='() => SetFilter("preferred")'>Preferred</button>
        <button class="ma-pill @(_activeFilter == "highrate" ? "ma-pill-active" : "")" @onclick='() => SetFilter("highrate")'>High Rate</button>
    </div>
    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button>
    <span class="ma-filter-count">@_filtered.Count classes</span>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div>
}

<div class="um-grid-card">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading price classes…</span></div> }
    <SfGrid TValue="PriceClassDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
        <GridEvents TValue="PriceClassDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" />
        <GridColumns>
            <GridColumn Field="ClassCode" HeaderText="Code" Width="120" />
            <GridColumn Field="ClassName" HeaderText="Class Name" Width="220" />
            <GridColumn Field="LobCode" HeaderText="LOB" Width="160"><Template>@{ var r=(PriceClassDto)context; }<span class="um-badge um-badge-info">@r.LobCode</span></Template></GridColumn>
            <GridColumn Field="RiskTierCode" HeaderText="Risk Tier" Width="120"><Template>@{ var r=(PriceClassDto)context; }@(r.RiskTierCode ?? "—")</Template></GridColumn>
            <GridColumn HeaderText="Base Rate" Width="110" TextAlign="TextAlign.Right"><Template>@{ var r=(PriceClassDto)context; }<strong>@((r.BaseRate * 100).ToString("0.###"))%</strong></Template></GridColumn>
            <GridColumn HeaderText="Premium Band" Width="180"><Template>@{ var r=(PriceClassDto)context; }@(r.MinPremium?.ToString("C0") ?? "—") — @(r.MaxPremium?.ToString("C0") ?? "Unlimited")</Template></GridColumn>
            <GridColumn Field="Priority" HeaderText="Priority" Width="90" TextAlign="TextAlign.Center" />
            <GridColumn HeaderText="Status" Width="100" TextAlign="TextAlign.Center"><Template>@{ var r=(PriceClassDto)context; }<span class="um-badge @(r.IsActive ? "um-badge-success" : "um-badge-neutral")">@(r.IsActive ? "Active" : "Inactive")</span></Template></GridColumn>
            <GridColumn HeaderText="Actions" Width="110" TextAlign="TextAlign.Center"><Template>@{ var r=(PriceClassDto)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(r)" @onclick:stopPropagation="true" title="Edit"><i class="bi bi-pencil"></i></button><button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDelete(r)" @onclick:stopPropagation="true" title="Delete"><i class="bi bi-trash"></i></button></Template></GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showForm" Width="720px" IsModal="true" ShowCloseIcon="false">
    <DialogEvents Closed="ResetForm" />
    <DialogContent>
        <div class="um-modal-header"><i class="bi bi-diagram-3"></i><span>@(_editId.HasValue ? "Edit Price Class" : "Add Price Class")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field"><label>Class Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.ClassCode" class="um-input" /><ValidationMessage For="() => _form.ClassCode" class="text-danger" /></div>
                <div class="um-field"><label>Class Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.ClassName" class="um-input" /><ValidationMessage For="() => _form.ClassName" class="text-danger" /></div>
                <div class="um-field"><label>Line of Business <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.LobCode" class="um-input">@foreach (var lob in PricingMarketRulePageConstants.LobCodes) { <option value="@lob">@lob</option> }</InputSelect><ValidationMessage For="() => _form.LobCode" class="text-danger" /></div>
                <div class="um-field"><label>Risk Tier</label><InputSelect @bind-Value="_form.RiskTierCode" class="um-input"><option value="">None</option>@foreach (var tier in PricingMarketRulePageConstants.RiskTiers) { <option value="@tier">@tier</option> }</InputSelect><ValidationMessage For="() => _form.RiskTierCode" class="text-danger" /></div>
                <div class="um-field"><label>Base Rate <span class="text-danger">*</span></label><InputNumber @bind-Value="_form.BaseRate" class="um-input" /><ValidationMessage For="() => _form.BaseRate" class="text-danger" /></div>
                <div class="um-field"><label>Minimum Premium</label><InputNumber @bind-Value="_form.MinPremium" class="um-input" /><ValidationMessage For="() => _form.MinPremium" class="text-danger" /></div>
                <div class="um-field"><label>Maximum Premium</label><InputNumber @bind-Value="_form.MaxPremium" class="um-input" /><ValidationMessage For="() => _form.MaxPremium" class="text-danger" /></div>
                <div class="um-field"><label>Priority <span class="text-danger">*</span></label><InputNumber @bind-Value="_form.Priority" class="um-input" /><ValidationMessage For="() => _form.Priority" class="text-danger" /></div>
                <div class="um-field"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="2" /><ValidationMessage For="() => _form.Description" class="text-danger" /></div>
                <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label></div>
            </div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button></div>
        </EditForm>
    </DialogContent>
</SfDialog>

<SfDialog @bind-Visible="_showDelete" Width="440px" IsModal="true" ShowCloseIcon="false"><DialogContent><div class="um-confirm-dialog"><div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash3-fill"></i></div><div class="um-confirm-message"><h6>Delete Price Class?</h6><p>You are about to delete <strong>@_deleteTarget?.ClassName</strong>. This action cannot be undone.</p></div><div class="um-modal-footer w-100"><button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button><button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div></div></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />

@code {
    List<PriceClassDto> _items = [], _filtered = [];
    string? _activeFilter, _loadError;
    string _search = string.Empty;
    bool _loading, _saving, _showForm, _showDelete;
    Guid? _editId;
    PriceClassDto? _deleteTarget;
    SfToast _toast = default!;
    PriceClassFormModel _form = new();

    protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("CRM", "/crm"), new("Pricing", "/crm/pricing-rules"), new("Price by Class")); await LoadAsync(); }
    async Task LoadAsync() { _loading = true; _loadError = null; try { var r = await Api.SearchPriceClassesAsync(PricingMarketRulePageConstants.TenantId); _items = r?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = $"Failed to load price classes: {ex.Message}"; } finally { _loading = false; } }
    void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; ApplyFilter(); }
    void ApplyFilter() { var rows = _activeFilter switch { "active" => _items.Where(x => x.IsActive), "commercial" => _items.Where(x => x.LobCode.Contains("Commercial", StringComparison.OrdinalIgnoreCase)), "preferred" => _items.Where(x => x.RiskTierCode == "Preferred"), "highrate" => _items.Where(x => x.BaseRate >= 0.02m), _ => _items.AsEnumerable() }; _filtered = rows.Where(SearchMatches).ToList(); }
    void SetFilter(string? key) { _activeFilter = key; ApplyFilter(); }
    void ResetFilters() { _activeFilter = null; _search = string.Empty; ApplyFilter(); }
    bool SearchMatches(PriceClassDto item) { if (string.IsNullOrWhiteSpace(_search)) return true; var q = _search.Trim(); return item.ClassCode.Contains(q, StringComparison.OrdinalIgnoreCase) || item.ClassName.Contains(q, StringComparison.OrdinalIgnoreCase) || item.LobCode.Contains(q, StringComparison.OrdinalIgnoreCase) || (item.RiskTierCode?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) || (item.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false); }
    void OnRowSelected(RowSelectEventArgs<PriceClassDto> args) => OpenEdit(args.Data);
    void OpenCreate() { _editId = null; _form = new(); _showForm = true; }
    void OpenEdit(PriceClassDto item) { _editId = item.PriceClassId; _form = new() { ClassCode = item.ClassCode, ClassName = item.ClassName, LobCode = item.LobCode, RiskTierCode = item.RiskTierCode, Description = item.Description, BaseRate = item.BaseRate, MinPremium = item.MinPremium, MaxPremium = item.MaxPremium, Priority = item.Priority, IsActive = item.IsActive }; _showForm = true; }
    async Task SaveAsync() { _saving = true; try { var req = new UpsertPriceClassRequest { TenantId = PricingMarketRulePageConstants.TenantId, ClassCode = _form.ClassCode, ClassName = _form.ClassName, LobCode = _form.LobCode, RiskTierCode = PricingMarketRulePageConstants.Normalize(_form.RiskTierCode), Description = PricingMarketRulePageConstants.Normalize(_form.Description), BaseRate = _form.BaseRate, MinPremium = _form.MinPremium, MaxPremium = _form.MaxPremium, Priority = _form.Priority, IsActive = _form.IsActive }; if (_editId.HasValue) await Api.UpdatePriceClassAsync(_editId.Value, req); else await Api.CreatePriceClassAsync(req); _showForm = false; await _toast.ShowAsync(new() { Content = "Price class saved", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } }
    void ConfirmDelete(PriceClassDto item) { _deleteTarget = item; _showDelete = true; }
    async Task ExecuteDeleteAsync() { _saving = true; try { await Api.DeletePriceClassAsync(_deleteTarget!.PriceClassId); _showDelete = false; await _toast.ShowAsync(new() { Content = "Price class deleted", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } }
    void ResetForm() { _form = new(); _editId = null; }
}
