    private void SelectFactor(LeadEngagementFactorDto factor) { _selectedFactor = factor; _selectedLead = null; }
    private void SelectLead(LeadEngagementRow lead) { _selectedLead = lead; _selectedFactor = null; }
    private void SelectMetric(string metric) { _metricFilter = _metricFilter == metric ? string.Empty : metric; _view = "factors"; }
    private void SetQuickFilter(string filter) { _quickFilter = _quickFilter == filter ? string.Empty : filter; if (filter == "High") _view = "leads"; else _view = "factors"; }
    private void ResetFilters() { _searchTerm = string.Empty; _factorFilter = string.Empty; _levelFilter = string.Empty; _metricFilter = string.Empty; _quickFilter = string.Empty; }
