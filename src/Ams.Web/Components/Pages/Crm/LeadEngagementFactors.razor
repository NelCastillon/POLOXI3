@page "/crm/leads/engagement-factors"
@namespace Ams.Web.Components.Pages.Crm
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Leads
@using Microsoft.AspNetCore.Components.Forms
@using BlazorChangeEventArgs = Microsoft.AspNetCore.Components.ChangeEventArgs
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Enterprise Lead Engagement Factors</PageTitle>

@if (_toastVisible)
{
    <div class="ld-toast ld-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="ld-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showConfirm && _confirmAction is not null)
{
    <div class="ef-modal-backdrop" role="presentation" @onclick="CancelConfirm">
        <div class="ef-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="engagementConfirmTitle" @onclick:stopPropagation="true">
            <div class="ef-confirm-icon ef-confirm-@_confirmAction.Kind"><i class="bi @_confirmAction.Icon" aria-hidden="true"></i></div>
            <h2 id="engagementConfirmTitle">@_confirmAction.Title</h2>
            <p>@_confirmAction.Message</p>
            <div class="ef-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CancelConfirm" disabled="@_busy">Cancel</button>
                <button type="button" class="um-btn @_confirmAction.ButtonClass" @onclick="ExecuteConfirmedAsync" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    @_confirmAction.ButtonText
                </button>
            </div>
        </div>
    </div>
}

@if (_showFactorForm)
{
    <div class="ef-modal-backdrop" role="presentation" @onclick="CloseFactorForm">
        <div class="ef-factor-modal" role="dialog" aria-modal="true" aria-labelledby="leadEngagementFactorTitle" @onclick:stopPropagation="true">
            <div class="ef-modal-header">
                <div class="ef-modal-title">
                    <span class="ef-modal-icon"><i class="bi bi-activity" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="leadEngagementFactorTitle">@(_editingFactorId == Guid.Empty ? "Create engagement factor" : "Edit engagement factor")</h2>
                        <p>Configure tenant-scoped activity criteria that influence lead engagement level and producer follow-up priority.</p>
                    </div>
                </div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseFactorForm" disabled="@_savingFactor" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_factorForm" OnValidSubmit="SaveFactorAsync" OnInvalidSubmit="HandleInvalidFactorSubmitAsync">
                <DataAnnotationsValidator />
                <div class="ef-modal-body">
                    <div class="ef-form-banner">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <div>
                            <strong>Enterprise engagement governance</strong>
                            <span>Factors are validated, ordered, tenant scoped, and synchronized with the active CRM engagement workflow.</span>
                        </div>
                    </div>
                    <div class="ef-form-grid">
                        <div class="ef-field ef-field-wide">
                            <label>Factor name <span>*</span></label>
                            <InputText class="ef-input" @bind-Value="_factorForm.FactorName" placeholder="Example: Opened nurture email" />
                        </div>
                        <div class="ef-field">
                            <label>Metric <span>*</span></label>
                            <InputSelect class="ef-input" @bind-Value="_factorForm.Metric">
                                @foreach (var item in _metricOptions)
                                {
                                    <option value="@item.Value">@item.Label</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="ef-field">
                            <label>Condition <span>*</span></label>
                            <InputSelect class="ef-input" @bind-Value="_factorForm.Operator">
                                @foreach (var item in _operatorOptions)
                                {
                                    <option value="@item.Value">@item.Label</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="ef-field ef-field-wide">
                            <label>Value</label>
                            <InputText class="ef-input" @bind-Value="_factorForm.Value" placeholder="Example: 1, 14, 30" />
                        </div>
                        <div class="ef-field">
                            <label>Points <span>*</span></label>
                            <InputNumber class="ef-input" @bind-Value="_factorForm.Points" />
                        </div>
                        <div class="ef-field">
                            <label>Sort order</label>
                            <InputNumber class="ef-input" @bind-Value="_factorForm.SortOrder" />
                        </div>
                        <div class="ef-field ef-field-wide">
                            <label class="ef-check"><InputCheckbox @bind-Value="_factorForm.IsActive" /> Active engagement factor</label>
                        </div>
                    </div>
                </div>
                <div class="ef-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseFactorForm" disabled="@_savingFactor">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_savingFactor">
                        @if (_savingFactor)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(_editingFactorId == Guid.Empty ? "Create factor" : "Save factor")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="ef-enterprise-page">
    <section class="ef-hero">
        <div class="ef-hero-left">
            <span class="ef-hero-icon"><i class="bi bi-activity" aria-hidden="true"></i></span>
            <div>
                <div class="ef-title-row">
                    <h1>Enterprise Engagement Factors</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live CRM data</span>
                    <span><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span>
                </div>
                <p>Manage activity factors that calculate lead engagement level, surface high-touch prospects, and guide follow-up workflows.</p>
            </div>
        </div>
        <div class="ef-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh engagement data"><i class="bi @(_loading ? "bi-arrow-repeat ef-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-ghost" @onclick="SyncEngagementAsync" disabled="@_loading" title="Reload factors and engagement preview"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Sync engagement</button>
            <button class="um-btn um-btn-ghost" @onclick="NavigateToLeads" title="Open enterprise leads"><i class="bi bi-person-lines-fill" aria-hidden="true"></i> Leads</button>
            <button class="um-btn um-btn-primary" @onclick="OpenCreateFactor" title="Create engagement factor"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Factor</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="ef-error-banner"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="ef-kpi-strip" aria-label="Lead engagement factor metrics">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" @onclick="@(() => SetQuickFilter(metric.Filter))">
                <span class="ef-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span><span class="ef-kpi-val">@metric.Value</span><span class="ef-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
            </button>
        }
    </section>

    <section class="ef-workflow-strip" aria-label="Engagement workflow actions">
        <button class="ef-workflow-card" @onclick="OpenCreateFactor"><i class="bi bi-plus-square" aria-hidden="true"></i><span><strong>Create factor</strong><span>Add engagement criteria.</span></span></button>
        <button class="ef-workflow-card" @onclick="ActivateAllFactors"><i class="bi bi-check2-circle" aria-hidden="true"></i><span><strong>Activate factors</strong><span>Enable all engagement logic.</span></span></button>
        <button class="ef-workflow-card" @onclick="SeedDefaultFactorsAsync"><i class="bi bi-stars" aria-hidden="true"></i><span><strong>Seed defaults</strong><span>Add enterprise defaults if empty.</span></span></button>
        <button class="ef-workflow-card" @onclick="ShowAnalytics"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span><strong>Analyze engagement</strong><span>Review level distribution.</span></span></button>
    </section>

    <section class="ef-search-panel">
        <div class="ef-search-wrap">
            <span class="ef-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="ef-search-body">
                <label for="engagementSearchInput">Search engagement workspace</label>
                <input id="engagementSearchInput" class="ef-search-input" value="@_searchTerm" @oninput="OnSearchChanged" placeholder="Search factors, metrics, conditions, leads, accounts, or levels..." />
                <span class="ef-search-hint">Enterprise search filters engagement factors and current lead engagement preview records.</span>
            </div>
        </div>
        <select class="ef-filter-select" value="@_factorFilter" @onchange="OnFactorFilterChanged">
            <option value="">All factors</option>
            <option value="Active">Active factors</option>
            <option value="Inactive">Inactive factors</option>
            <option value="Positive">Positive points</option>
            <option value="Negative">Negative points</option>
        </select>
        <select class="ef-filter-select" value="@_levelFilter" @onchange="OnLevelFilterChanged">
            <option value="">All levels</option>
            <option value="High">High</option>
            <option value="Medium">Medium</option>
            <option value="Low">Low</option>
        </select>
        <select class="ef-filter-select" value="@_metricFilter" @onchange="OnMetricFilterChanged">
            <option value="">All metrics</option>
            @foreach (var item in _metricOptions)
            {
                <option value="@item.Value">@item.Label</option>
            }
        </select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
        <div class="ef-search-result"><strong>@FilteredLeads.Count</strong><span>matches</span></div>
    </section>

    <section class="ef-view-tabs" aria-label="Lead engagement views">
        @foreach (var view in _views)
        {
            <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label</button>
        }
    </section>

    <section class="ef-content-layout">
        <main class="ef-main-card">
            @if (_loading)
            {
                <div class="ef-loading"><i class="bi bi-arrow-repeat ef-spin" aria-hidden="true"></i><strong>Loading enterprise engagement workspace...</strong></div>
            }
            else if (_view == "factors")
            {
                <div class="ef-section-head">
                    <div><h2>Engagement factor management</h2><p>Create, edit, activate, deactivate, duplicate, and delete tenant-scoped engagement factors.</p></div>
                    <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreateFactor"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Factor</button>
                </div>
                @if (FilteredFactors.Count == 0)
                {
                    <div class="ef-empty-state"><i class="bi bi-activity" aria-hidden="true"></i><strong>No engagement factors match this view</strong><span>Adjust filters or add a new factor to start configuring engagement logic.</span><button class="um-btn um-btn-primary" @onclick="OpenCreateFactor">Create factor</button></div>
                }
                else
                {
                    <div class="ef-rules-grid">
                        @foreach (var factor in FilteredFactors.OrderBy(f => f.SortOrder).ThenByDescending(f => f.Points))
                        {
                            <article class="ef-rule-card" @onclick="@(() => SelectFactor(factor))">
                                <div class="ef-rule-hdr">
                                    <div class="ef-rule-heading">
                                        <span class="ef-rule-avatar @FactorAvatarClass(factor)"><i class="@FactorIcon(factor)" aria-hidden="true"></i></span>
                                        <div><strong>@factor.FactorName</strong><span>@MetricLabel(factor.Metric)</span></div>
                                    </div>
                                    <div class="ef-rule-actions" @onclick:stopPropagation="true">
                                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ToggleFactorActiveAsync(factor))" title="Toggle active state"><i class="bi @(factor.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i></button>
                                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenEditFactor(factor))" title="Edit factor"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => DuplicateFactorAsync(factor))" title="Duplicate factor"><i class="bi bi-copy" aria-hidden="true"></i></button>
                                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ConfirmDeleteFactor(factor))" title="Delete factor"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                                <div class="ef-rule-meta">
                                    <span class="ef-status-pill @(factor.IsActive ? "ef-status-pill-active" : "ef-status-pill-inactive")">@(factor.IsActive ? "Active" : "Inactive")</span>
                                    <span class="ef-points-pill @PointsClass(factor.Points)">@FormatPoints(factor.Points) pts</span>
                                    <span class="ef-order-pill">Order @factor.SortOrder</span>
                                </div>
                                <div class="ef-rule-cond"><span>Condition</span><strong>@FactorCondition(factor)</strong></div>
                                <div class="ef-rule-footer"><span><i class="bi bi-diagram-3" aria-hidden="true"></i> @factor.Operator</span><span><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span></div>
                            </article>
                        }
                    </div>
                }
            }
            else if (_view == "leads")
            {
                <div class="ef-section-head">
                    <div><h2>Engaged leads preview</h2><p>Review lead engagement level, score, account, and workflow readiness from current factor configuration.</p></div>
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="NavigateToLeads"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Leads</button>
                </div>
                @if (FilteredLeads.Count == 0)
                {
                    <div class="ef-empty-state"><i class="bi bi-people" aria-hidden="true"></i><strong>No engaged leads match this view</strong><span>Adjust search or engagement filters to view CRM records.</span><button class="um-btn um-btn-ghost" @onclick="ResetFilters">Reset filters</button></div>
                }
                else
                {
                    <div class="ef-table-scroll">
                        <table class="ef-table">
                            <thead><tr><th>Lead</th><th>Level</th><th class="ef-number">Score</th><th>Account</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var lead in FilteredLeads)
                                {
                                    <tr class="@LeadRowClass(lead)" @onclick="@(() => SelectLead(lead))">
                                        <td><div class="ef-name-cell"><span class="ef-avatar @AvatarColor(lead.FullName)" aria-hidden="true">@Initials(lead.FullName)</span><span><strong>@lead.FullName</strong><small>@lead.AccountName</small></span></div></td>
                                        <td><span class="@LevelBadge(lead.Level)">@lead.Level</span></td>
                                        <td class="ef-number"><span class="ef-score-pill @ScoreTone(lead.Score)">@lead.Score</span></td>
                                        <td>@lead.AccountName</td>
                                        <td @onclick:stopPropagation="true"><button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenLeadInCrm(lead))" title="Find lead in CRM"><i class="bi bi-arrow-right" aria-hidden="true"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                <div class="ef-section-head"><div><h2>Engagement analytics</h2><p>Monitor lead engagement distribution and factor contribution readiness.</p></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="SyncEngagementAsync"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Refresh analytics</button></div>
                <div class="ef-analytics-grid">
                    <section>
                        <h3>Engagement distribution</h3>
                        @foreach (var row in LevelDistribution)
                        {
                            <div class="ef-stage-row"><span>@row.Label</span><div><i class="@row.Tone" style="width:@row.WidthPercent%"></i></div><strong>@row.Count</strong><small>@row.Percent.ToString("F0")%</small></div>
                        }
                    </section>
                    <section>
                        <h3>Metric configuration</h3>
                        @foreach (var metric in MetricBreakdown)
                        {
                            <button class="@MetricRowClass(metric.Metric)" @onclick="@(() => SelectMetric(metric.Metric))"><span><i class="bi @MetricIcon(metric.Metric)" aria-hidden="true"></i> @MetricLabel(metric.Metric)</span><div><i style="width:@metric.WidthPercent%"></i></div><strong>@metric.Total</strong><small>@metric.Active active</small></button>
                        }
                    </section>
                </div>
            }
        </main>

        <aside class="ef-detail-card">
            @if (_selectedFactor is not null)
            {
                <div class="ef-detail-head"><div><span class="ef-detail-eyebrow"><i class="@FactorIcon(_selectedFactor)" aria-hidden="true"></i> @MetricLabel(_selectedFactor.Metric)</span><h2>@_selectedFactor.FactorName</h2><p>@FactorCondition(_selectedFactor)</p></div><span class="ef-points-pill @PointsClass(_selectedFactor.Points)">@FormatPoints(_selectedFactor.Points)</span></div>
                <div class="ef-detail-body">
                    <div class="ef-detail-summary"><div><span>Status</span><strong>@(_selectedFactor.IsActive ? "Active" : "Inactive")</strong></div><div><span>Sort</span><strong>@_selectedFactor.SortOrder</strong></div><div><span>Operator</span><strong>@_selectedFactor.Operator</strong></div><div><span>Created</span><strong>@_selectedFactor.CreatedDateUtc.ToLocalTime().ToString("MMM d", CultureInfo.CurrentCulture)</strong></div></div>
                    <div class="ef-contact-card"><span><i class="bi bi-list-check" aria-hidden="true"></i> @FactorCondition(_selectedFactor)</span><span><i class="bi bi-lightning-charge" aria-hidden="true"></i> @FormatPoints(_selectedFactor.Points) engagement points when matched</span><span><i class="bi bi-building-lock" aria-hidden="true"></i> Tenant-scoped CRM engagement factor</span></div>
                    <div class="ef-detail-actions"><button class="um-btn um-btn-ghost" @onclick="@(() => OpenEditFactor(_selectedFactor))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button class="um-btn um-btn-ghost" @onclick="@(() => ToggleFactorActiveAsync(_selectedFactor))"><i class="bi bi-power" aria-hidden="true"></i> Toggle</button><button class="um-btn um-btn-danger" @onclick="@(() => ConfirmDeleteFactor(_selectedFactor))"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                </div>
            }
            else if (_selectedLead is not null)
            {
                <div class="ef-detail-head"><div><span class="ef-detail-eyebrow"><i class="bi bi-person-lines-fill" aria-hidden="true"></i> Engagement preview</span><h2>@_selectedLead.FullName</h2><p>@_selectedLead.AccountName</p></div><span class="@LevelBadge(_selectedLead.Level)">@_selectedLead.Level</span></div>
                <div class="ef-detail-body">
                    <div class="ef-detail-summary"><div><span>Score</span><strong>@_selectedLead.Score</strong></div><div><span>Level</span><strong>@_selectedLead.Level</strong></div><div><span>Account</span><strong>@_selectedLead.AccountName</strong></div><div><span>Workflow</span><strong>@LeadWorkflowLabel(_selectedLead)</strong></div></div>
                    <div class="ef-contact-card"><span><i class="bi bi-bar-chart" aria-hidden="true"></i> @_selectedLead.Level priority from current engagement score</span><span><i class="bi bi-activity" aria-hidden="true"></i> Engagement preview is synchronized from lead activity summary.</span></div>
                    <div class="ef-detail-actions"><button class="um-btn um-btn-ghost" @onclick="@(() => OpenLeadInCrm(_selectedLead))"><i class="bi bi-person-lines-fill" aria-hidden="true"></i> Open Lead</button><button class="um-btn um-btn-primary" @onclick="OpenCreateFactor"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add Factor</button></div>
                </div>
            }
            else
            {
                <div class="ef-detail-empty"><i class="bi bi-activity" aria-hidden="true"></i><strong>Select a factor or lead</strong><span>Review engagement factor intelligence, lead engagement details, and workflow actions.</span></div>
            }
        </aside>
    </section>
</div>

@code {
    private Guid _tenantId;
    private string _searchTerm = string.Empty;
    private string _loadError = string.Empty;
    private string _factorFilter = string.Empty;
    private string _levelFilter = string.Empty;
    private string _metricFilter = string.Empty;
    private string _quickFilter = string.Empty;
    private string _view = "factors";
    private bool _loading;
    private bool _busy;
    private bool _showFactorForm;
    private bool _showConfirm;
    private bool _savingFactor;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "info";
    private Guid _editingFactorId = Guid.Empty;
    private CancellationTokenSource? _toastCts;
    private ConfirmAction? _confirmAction;
    private LeadEngagementFactorForm _factorForm = new();
    private LeadEngagementFactorDto? _selectedFactor;
    private LeadEngagementRow? _selectedLead;
    private List<LeadEngagementFactorDto> _factors = [];
    private List<LeadEngagementRow> _leads = [];

    private static readonly List<ViewDef> _views = [new("factors", "Factors", "bi-activity"), new("leads", "Engaged Leads", "bi-people"), new("analytics", "Analytics", "bi-graph-up-arrow")];

    private static readonly List<LabelValue> _metricOptions =
    [
        new("EmailsSent", "Emails sent"),
        new("EmailsOpened", "Emails opened"),
        new("Clicks", "Links clicked"),
        new("PortalVisits", "Portal visits"),
        new("ActivityCount", "Activities logged"),
        new("DaysSinceTouch", "Days since touch"),
    ];

    private static readonly List<LabelValue> _operatorOptions =
    [
        new("Equals", "Equals"),
        new("GreaterThan", "Greater than"),
        new("GreaterThanOrEqual", "Greater than or equal"),
        new("LessThan", "Less than"),
        new("LessThanOrEqual", "Less than or equal"),
        new("IsNotZero", "Is not zero"),
    ];

    private IEnumerable<KpiModel> Metrics =>
    [
        new("Factors", _factors.Count.ToString(), "Tenant factors", "bi-activity", "ef-blue", ""),
        new("Active", _factors.Count(x => x.IsActive).ToString(), "Enabled now", "bi-check-circle", "ef-green", "Active"),
        new("High", _leads.Count(x => x.Level == "High").ToString(), "Engaged leads", "bi-lightning-charge", "ef-red", "High"),
        new("Average", AverageScore.ToString("F0"), "Engagement score", "bi-speedometer2", "ef-purple", ""),
        new("Positive", _factors.Count(x => x.Points > 0).ToString(), "Adds points", "bi-plus-circle", "ef-cyan", "Positive")
    ];

    private List<LeadEngagementFactorDto> FilteredFactors
    {
        get
        {
            IEnumerable<LeadEngagementFactorDto> query = _factors;
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(x => Contains(x.FactorName, term) || Contains(x.Metric, term) || Contains(x.Operator, term) || Contains(x.Value, term) || Contains(FactorCondition(x), term));
            }
            if (!string.IsNullOrWhiteSpace(_metricFilter)) query = query.Where(x => x.Metric == _metricFilter);
            query = _factorFilter switch
            {
                "Active" => query.Where(x => x.IsActive),
                "Inactive" => query.Where(x => !x.IsActive),
                "Positive" => query.Where(x => x.Points > 0),
                "Negative" => query.Where(x => x.Points < 0),
                _ => query
            };
            query = _quickFilter switch
            {
                "Active" => query.Where(x => x.IsActive),
                "Positive" => query.Where(x => x.Points > 0),
                _ => query
            };
            return query.ToList();
        }
    }

    private List<LeadEngagementRow> FilteredLeads
    {
        get
        {
            IEnumerable<LeadEngagementRow> query = _leads;
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(x => Contains(x.FullName, term) || Contains(x.AccountName, term) || Contains(x.Level, term));
            }
            if (!string.IsNullOrWhiteSpace(_levelFilter)) query = query.Where(x => x.Level == _levelFilter);
            query = _quickFilter switch
            {
                "High" => query.Where(x => x.Level == "High"),
                _ => query
            };
            return query.OrderByDescending(x => x.Score).ThenBy(x => x.FullName).ToList();
        }
    }

    private double AverageScore => _leads.Count == 0 ? 0 : _leads.Average(x => x.Score);
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-octagon", "warning" => "bi-exclamation-triangle", "success" => "bi-check2-circle", _ => "bi-info-circle" };

    private IEnumerable<DistributionRow> LevelDistribution
    {
        get
        {
            var total = Math.Max(1, _leads.Count);
            var rows = new[]
            {
                new DistributionRow("High", _leads.Count(x => x.Level == "High"), 0, "ef-dist-high"),
                new DistributionRow("Medium", _leads.Count(x => x.Level == "Medium"), 0, "ef-dist-medium"),
                new DistributionRow("Low", _leads.Count(x => x.Level == "Low"), 0, "ef-dist-low")
            };
            var max = Math.Max(1, rows.Max(x => x.Count));
            return rows.Select(x => x with { WidthPercent = (double)x.Count / max * 100, Percent = (double)x.Count / total * 100 });
        }
    }

    private IEnumerable<MetricBreakdownRow> MetricBreakdown
    {
        get
        {
            var rows = _factors.GroupBy(x => x.Metric).Select(g => new MetricBreakdownRow(g.Key, g.Count(), g.Count(x => x.IsActive), 0)).ToList();
            var max = Math.Max(1, rows.Select(x => x.Total).DefaultIfEmpty(1).Max());
            return rows.OrderByDescending(x => x.Total).Select(x => x with { WidthPercent = max == 0 ? 0 : (double)x.Total / max * 100 });
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Lead Engagement Factors", "/crm/leads/engagement-factors"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = string.Empty;
        try
        {
            if (_tenantId == Guid.Empty) _tenantId = (await CurrentUser.RequireAsync()).TenantId;

            var factorsTask = Api.GetLeadEngagementFactorsAsync(_tenantId);
            var leadsTask = Api.SearchLeadsAsync(_tenantId, string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm);
            await Task.WhenAll(factorsTask, leadsTask);

            _factors = factorsTask.Result?.OrderBy(x => x.SortOrder).ThenBy(x => x.FactorName).ToList() ?? [];
            var leadItems = leadsTask.Result?.Items?.Take(25).ToList() ?? [];
            var rows = new List<LeadEngagementRow>();
            foreach (var lead in leadItems)
            {
                var summary = await Api.GetLeadEngagementSummaryAsync(lead.LeadId);
                rows.Add(new LeadEngagementRow(lead.LeadId, $"{lead.FirstName} {lead.LastName}".Trim(), lead.AccountName ?? "â€”", summary?.Score ?? 0, NormalizeLevel(summary?.Level)));
            }

            _leads = rows.OrderByDescending(x => x.Score).ToList();
            _selectedFactor = _selectedFactor is null ? _factors.FirstOrDefault() : _factors.FirstOrDefault(x => x.EngagementFactorId == _selectedFactor.EngagementFactorId) ?? _factors.FirstOrDefault();
            _selectedLead = _selectedLead is null ? _leads.FirstOrDefault() : _leads.FirstOrDefault(x => x.LeadId == _selectedLead.LeadId) ?? _leads.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load lead engagement factors: {ex.Message}";
            _factors = [];
            _leads = [];
            await ShowToastAsync("Unable to load engagement data.", "danger");
        }
        finally { _loading = false; }
    }

    private async Task SyncEngagementAsync()
    {
        await LoadAsync();
        await ShowToastAsync("Lead engagement data synchronized.", "success");
    }

