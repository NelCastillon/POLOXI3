    private void OpenCreateFactor()
    {
        _editingFactorId = Guid.Empty;
        _factorForm = new()
        {
            Metric = "ActivityCount",
            Operator = "GreaterThanOrEqual",
            Value = "1",
            Points = 20,
            SortOrder = _factors.Count == 0 ? 10 : _factors.Max(f => f.SortOrder) + 10,
            IsActive = true
        };
        _showFactorForm = true;
    }

    private void OpenEditFactor(LeadEngagementFactorDto factor)
    {
        _editingFactorId = factor.EngagementFactorId;
        _factorForm = new()
        {
            FactorName = factor.FactorName,
            Metric = string.IsNullOrWhiteSpace(factor.Metric) ? "ActivityCount" : factor.Metric,
            Operator = string.IsNullOrWhiteSpace(factor.Operator) ? "GreaterThanOrEqual" : factor.Operator,
            Value = factor.Value,
            Points = factor.Points,
            IsActive = factor.IsActive,
            SortOrder = factor.SortOrder
        };
        _showFactorForm = true;
    }

    private void CloseFactorForm() { if (!_savingFactor) _showFactorForm = false; }
    private Task HandleInvalidFactorSubmitAsync(EditContext _) => ShowToastAsync("Fix validation errors.", "warning");

    private async Task SaveFactorAsync()
    {
        _savingFactor = true;
        try
        {
            if (_editingFactorId == Guid.Empty)
            {
                var id = await Api.CreateLeadEngagementFactorAsync(new CreateLeadEngagementFactorRequest { TenantId = _tenantId, FactorName = _factorForm.FactorName.Trim(), Metric = _factorForm.Metric, Operator = _factorForm.Operator, Value = _factorForm.Value?.Trim() ?? string.Empty, Points = _factorForm.Points, IsActive = _factorForm.IsActive, SortOrder = _factorForm.SortOrder });
                _editingFactorId = id;
                await ShowToastAsync("Engagement factor created.", "success");
            }
            else
            {
                await Api.UpdateLeadEngagementFactorAsync(_editingFactorId, new UpdateLeadEngagementFactorRequest { EngagementFactorId = _editingFactorId, TenantId = _tenantId, FactorName = _factorForm.FactorName.Trim(), Metric = _factorForm.Metric, Operator = _factorForm.Operator, Value = _factorForm.Value?.Trim() ?? string.Empty, Points = _factorForm.Points, IsActive = _factorForm.IsActive, SortOrder = _factorForm.SortOrder });
                await ShowToastAsync("Engagement factor saved.", "success");
            }
            _showFactorForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to save engagement factor: {ex.Message}";
            await ShowToastAsync("Save failed.", "danger");
        }
        finally { _savingFactor = false; }
    }

    private async Task ToggleFactorActiveAsync(LeadEngagementFactorDto factor)
    {
        try
        {
            await Api.UpdateLeadEngagementFactorAsync(factor.EngagementFactorId, new UpdateLeadEngagementFactorRequest { EngagementFactorId = factor.EngagementFactorId, TenantId = _tenantId, FactorName = factor.FactorName, Metric = factor.Metric, Operator = factor.Operator, Value = factor.Value, Points = factor.Points, IsActive = !factor.IsActive, SortOrder = factor.SortOrder });
            await ShowToastAsync(!factor.IsActive ? "Engagement factor activated." : "Engagement factor paused.", "success");
            await LoadAsync();
        }
        catch (Exception ex) { await ShowToastAsync($"Toggle failed: {ex.Message}", "danger"); }
    }

    private async Task DuplicateFactorAsync(LeadEngagementFactorDto factor)
    {
        try
        {
            await Api.CreateLeadEngagementFactorAsync(new CreateLeadEngagementFactorRequest { TenantId = _tenantId, FactorName = $"{factor.FactorName} Copy", Metric = factor.Metric, Operator = factor.Operator, Value = factor.Value, Points = factor.Points, IsActive = false, SortOrder = _factors.Count == 0 ? 10 : _factors.Max(f => f.SortOrder) + 10 });
            await ShowToastAsync("Engagement factor duplicated as inactive.", "success");
            await LoadAsync();
        }
        catch (Exception ex) { await ShowToastAsync($"Duplicate failed: {ex.Message}", "danger"); }
    }

    private void ConfirmDeleteFactor(LeadEngagementFactorDto factor) => OpenConfirm(new("Delete engagement factor", $"Delete {factor.FactorName}? This removes it from future engagement scoring.", "Delete", "um-btn-danger", "bi-trash", "danger", () => DeleteFactorAsync(factor)));

    private async Task DeleteFactorAsync(LeadEngagementFactorDto factor)
    {
        await Api.DeleteLeadEngagementFactorAsync(factor.EngagementFactorId);
        if (_selectedFactor?.EngagementFactorId == factor.EngagementFactorId) _selectedFactor = null;
        await ShowToastAsync("Engagement factor deleted.", "success");
        await LoadAsync();
    }

    private void ActivateAllFactors()
    {
        if (_factors.Count == 0) { _ = ShowToastAsync("No engagement factors to activate.", "warning"); return; }
        OpenConfirm(new("Activate engagement factors", $"Activate {_factors.Count(x => !x.IsActive)} inactive engagement factor(s)?", "Activate", "um-btn-primary", "bi-check2-circle", "warning", ActivateAllFactorsAsync));
    }

    private async Task ActivateAllFactorsAsync()
    {
        foreach (var factor in _factors.Where(x => !x.IsActive))
        {
            await Api.UpdateLeadEngagementFactorAsync(factor.EngagementFactorId, new UpdateLeadEngagementFactorRequest { EngagementFactorId = factor.EngagementFactorId, TenantId = _tenantId, FactorName = factor.FactorName, Metric = factor.Metric, Operator = factor.Operator, Value = factor.Value, Points = factor.Points, IsActive = true, SortOrder = factor.SortOrder });
        }
        await ShowToastAsync("Engagement factors activated.", "success");
        await LoadAsync();
    }

    private async Task SeedDefaultFactorsAsync()
    {
        if (_factors.Count > 0) { await ShowToastAsync("Default engagement data already exists.", "info"); return; }
        OpenConfirm(new("Seed default engagement", "Create enterprise default engagement factors for this tenant?", "Seed defaults", "um-btn-primary", "bi-stars", "warning", CreateDefaultFactorsAsync));
    }

    private async Task CreateDefaultFactorsAsync()
    {
        var defaults = new[]
        {
            new LeadEngagementFactorSeed("Recent activity logged", "ActivityCount", "GreaterThanOrEqual", "1", 20, 10),
            new LeadEngagementFactorSeed("Opened nurture email", "EmailsOpened", "GreaterThanOrEqual", "1", 15, 20),
            new LeadEngagementFactorSeed("Clicked campaign link", "Clicks", "GreaterThanOrEqual", "1", 18, 30),
            new LeadEngagementFactorSeed("Visited portal", "PortalVisits", "GreaterThanOrEqual", "2", 12, 40),
            new LeadEngagementFactorSeed("No recent touch", "DaysSinceTouch", "GreaterThan", "30", -20, 50)
        };
        foreach (var factor in defaults)
        {
            await Api.CreateLeadEngagementFactorAsync(new CreateLeadEngagementFactorRequest { TenantId = _tenantId, FactorName = factor.FactorName, Metric = factor.Metric, Operator = factor.Operator, Value = factor.Value, Points = factor.Points, IsActive = true, SortOrder = factor.SortOrder });
        }
        await ShowToastAsync("Default engagement factors seeded.", "success");
        await LoadAsync();
    }

    private void OpenConfirm(ConfirmAction action) { _confirmAction = action; _showConfirm = true; }
    private void CancelConfirm() { if (!_busy) { _showConfirm = false; _confirmAction = null; } }
    private async Task ExecuteConfirmedAsync() { if (_confirmAction is null) return; _busy = true; try { var action = _confirmAction; await action.ExecuteAsync(); _showConfirm = false; _confirmAction = null; } catch (Exception ex) { await ShowToastAsync($"Action failed: {ex.Message}", "danger"); } finally { _busy = false; } }

    private async Task ShowToastAsync(string message, string kind = "info")
    {
        _toastCts?.Cancel(); _toastCts?.Dispose(); _toastCts = new CancellationTokenSource();
        _toastMessage = message.Length <= 96 ? message : $"{message[..93]}..."; _toastKind = ToastKind(kind); _toastVisible = true; StateHasChanged();
        try { await Task.Delay(_toastKind == "danger" ? 10400 : 8000, _toastCts.Token); _toastVisible = false; await InvokeAsync(StateHasChanged); } catch (TaskCanceledException) { }
    }

    private void HideToast() { _toastCts?.Cancel(); _toastVisible = false; }
    private static string ToastKind(string value) => value.Contains("danger", StringComparison.OrdinalIgnoreCase) || value.Contains("error", StringComparison.OrdinalIgnoreCase) ? "danger" : value.Contains("warning", StringComparison.OrdinalIgnoreCase) ? "warning" : value.Contains("success", StringComparison.OrdinalIgnoreCase) ? "success" : "info";
    private static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static string NormalizeLevel(string? level) => string.IsNullOrWhiteSpace(level) ? "Low" : level.Trim() switch { "high" => "High", "medium" => "Medium", "low" => "Low", var value => CultureInfo.CurrentCulture.TextInfo.ToTitleCase(value.ToLowerInvariant()) };
    private static string LeadWorkflowLabel(LeadEngagementRow lead) => lead.Level switch { "High" => "Immediate follow-up", "Medium" => "Nurture sequence", _ => "Monitor" };
    private static string FactorCondition(LeadEngagementFactorDto factor) { var metric = MetricLabel(factor.Metric); var op = _operatorOptions.FirstOrDefault(x => x.Value == factor.Operator)?.Label ?? factor.Operator; return string.IsNullOrWhiteSpace(factor.Value) ? $"{metric} Â· {op}" : $"{metric} Â· {op} Â· {factor.Value}"; }
    private static string MetricLabel(string metric) => _metricOptions.FirstOrDefault(x => x.Value == metric)?.Label ?? metric;
    private static string FactorIcon(LeadEngagementFactorDto factor) => $"bi {MetricIcon(factor.Metric)}";
    private static string MetricIcon(string metric) => metric switch { "EmailsSent" => "bi-envelope", "EmailsOpened" => "bi-envelope-open", "Clicks" => "bi-cursor", "PortalVisits" => "bi-globe2", "ActivityCount" => "bi-lightning", "DaysSinceTouch" => "bi-clock-history", _ => "bi-activity" };
    private static string FactorAvatarClass(LeadEngagementFactorDto factor) => factor.Points switch { > 0 => "ef-rule-avatar-positive", < 0 => "ef-rule-avatar-negative", _ => "ef-rule-avatar-neutral" };
    private static string FormatPoints(int points) => points > 0 ? $"+{points}" : points.ToString();
    private static string PointsClass(int points) => points < 0 ? "ef-points-negative" : points > 0 ? "ef-points-positive" : "ef-points-neutral";
    private string MetricCardClass(KpiModel metric) => $"ef-kpi-card {metric.Tone} {(_quickFilter == metric.Filter && !string.IsNullOrWhiteSpace(metric.Filter) ? "ef-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewDef view) => _view == view.Id ? "ef-view-btn ef-view-btn-active" : "ef-view-btn";
    private string LeadRowClass(LeadEngagementRow lead) => lead.LeadId == _selectedLead?.LeadId ? "ef-row-selected" : string.Empty;
    private string MetricRowClass(string metric) => _metricFilter == metric ? "ef-funnel-row ef-active" : "ef-funnel-row";
    private static string LevelBadge(string level) => level switch { "High" => "ef-level ef-level-high", "Medium" => "ef-level ef-level-medium", _ => "ef-level ef-level-low" };
    private static string ScoreTone(int score) => score >= 80 ? "ef-score-high" : score >= 40 ? "ef-score-medium" : "ef-score-low";
    private static string AvatarColor(string name) { var colors = new[] { "ef-av1", "ef-av2", "ef-av3", "ef-av4", "ef-av5", "ef-av6" }; return colors[Math.Abs(name.GetHashCode()) % colors.Length]; }
    private static string Initials(string name) { var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length > 0 ? name[..1] : "?"; }

    private sealed record ViewDef(string Id, string Label, string Icon);
    private sealed record LabelValue(string Value, string Label);
    private sealed record KpiModel(string Label, string Value, string Caption, string Icon, string Tone, string Filter);
