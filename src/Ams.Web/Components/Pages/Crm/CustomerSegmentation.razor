@page "/crm/segments"
@namespace Ams.Web.Components.Pages.Crm
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.AccountSegments
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Customer Segmentation — CRM</PageTitle>

@if (_toastVisible)
{
    <div class="sg-toast sg-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIcon" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="sg-toast-close" @onclick="HideToast" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="sg-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="sg-segment-modal" role="dialog" aria-modal="true" aria-labelledby="segmentFormTitle" @onclick:stopPropagation="true">
            <EditForm Model="_form" OnValidSubmit="SaveSegmentAsync" OnInvalidSubmit="HandleInvalidSubmitAsync">
                <DataAnnotationsValidator />
                <div class="sg-modal-header">
                    <div class="sg-modal-title">
                        <span class="sg-modal-icon"><i class="bi bi-pie-chart-fill" aria-hidden="true"></i></span>
                        <div>
                            <h2 id="segmentFormTitle">@(_editingId == Guid.Empty ? "New segment" : "Edit segment")</h2>
                            <p>Define account segmentation identity, activation, and reporting visibility.</p>
                        </div>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseForm" disabled="@_saving" aria-label="Close segment form"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="sg-modal-body">
                    <div class="sg-form-banner">
                        <i class="bi bi-database-check" aria-hidden="true"></i>
                        <div>
                            <strong>Client.AccountSegment backed workflow</strong>
                            <span>Segments are saved to the existing account segment table and used with account segment codes.</span>
                        </div>
                    </div>
                    <div class="sg-form-grid">
                        <div class="sg-field">
                            <label for="segmentCode">Segment code <span>*</span></label>
                            <InputText id="segmentCode" class="sg-input" @bind-Value="_form.SegmentCode" placeholder="PLATINUM" />
                            <ValidationMessage For="() => _form.SegmentCode" class="text-danger" />
                        </div>
                        <div class="sg-field">
                            <label for="segmentName">Segment name <span>*</span></label>
                            <InputText id="segmentName" class="sg-input" @bind-Value="_form.SegmentName" placeholder="Platinum Tier" />
                            <ValidationMessage For="() => _form.SegmentName" class="text-danger" />
                        </div>
                        <div class="sg-field sg-field-wide">
                            <label for="description">Description</label>
                            <InputTextArea id="description" class="sg-input sg-textarea" @bind-Value="_form.Description" placeholder="Describe the segment purpose, criteria, and audience usage..." />
                            <ValidationMessage For="() => _form.Description" class="text-danger" />
                        </div>
                        <div class="sg-field sg-check-field">
                            <label>Status</label>
                            <label class="sg-check-row"><InputCheckbox @bind-Value="_form.IsActive" /> <span>Active segment</span></label>
                        </div>
                    </div>
                </div>
                <div class="sg-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_saving">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi @(_saving ? "bi-arrow-repeat sg-spin" : "bi-check2")" aria-hidden="true"></i> @(_editingId == Guid.Empty ? "Create Segment" : "Save")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showDeleteConfirm && _deleteTarget is not null)
{
    <div class="sg-modal-backdrop" role="presentation" @onclick="CancelDelete">
        <div class="sg-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="deleteSegmentTitle" @onclick:stopPropagation="true">
            <div class="sg-confirm-icon sg-confirm-danger"><i class="bi bi-trash3-fill" aria-hidden="true"></i></div>
            <h2 id="deleteSegmentTitle">Delete segment</h2>
            <p>Delete <strong>@_deleteTarget.SegmentName</strong>? This soft-deletes the existing segment record.</p>
            <div class="sg-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CancelDelete" disabled="@_saving">Cancel</button>
                <button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
            </div>
        </div>
    </div>
}

<div class="sg-enterprise-page">
    <section class="sg-hero">
        <div class="sg-hero-left">
            <span class="sg-hero-icon"><i class="bi bi-pie-chart-fill" aria-hidden="true"></i></span>
            <div>
                <div class="sg-title-row">
                    <h1>Customer Segmentation</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Client.AccountSegment</span>
                    <span><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped accounts</span>
                </div>
                <p>Classify accounts, analyze segment distribution, and manage audience groups through governed CRM segmentation.</p>
            </div>
        </div>
        <div class="sg-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh segments"><i class="bi @(_loading ? "bi-arrow-repeat sg-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate" title="Create segment"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Segment</button>
        </div>
    </section>

    <section class="sg-kpi-strip" aria-label="Customer segmentation metrics">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" title="@metric.Tooltip" @onclick="@(() => SetKpiFilter(metric.Filter))">
                <span class="sg-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span><span class="sg-kpi-val">@metric.Value</span><span class="sg-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
            </button>
        }
    </section>

    <section class="sg-workflow-strip" aria-label="Segmentation workflow shortcuts">
        <button type="button" class="sg-workflow-card" @onclick="ShowSegments"><i class="bi bi-list-ul" aria-hidden="true"></i><span><strong>Segments</strong><span>Manage definitions and account counts.</span></span></button>
        <button type="button" class="sg-workflow-card" @onclick="ShowActive"><i class="bi bi-check2-circle" aria-hidden="true"></i><span><strong>Active focus</strong><span>Filter active audiences.</span></span></button>
        <button type="button" class="sg-workflow-card" @onclick="ShowAccountMap"><i class="bi bi-diagram-3" aria-hidden="true"></i><span><strong>Account map</strong><span>Review account distribution.</span></span></button>
        <button type="button" class="sg-workflow-card" @onclick="ShowAnalytics"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span><strong>Analytics</strong><span>Measure segment health.</span></span></button>
    </section>

    <section class="sg-search-panel">
        <div class="sg-search-wrap">
            <span class="sg-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="sg-search-body">
                <label for="segmentSearchInput">Search segments</label>
                <input id="segmentSearchInput" class="sg-search-input" @bind-value="Search" @bind-value:event="oninput" placeholder="Search segment name, code, or description..." />
                <span class="sg-search-hint">Filters segment records and account distribution instantly.</span>
            </div>
        </div>
        <select class="sg-filter-select" @bind="StatusFilter"><option value="">All statuses</option><option value="active">Active</option><option value="inactive">Inactive</option></select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ClearFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
        <div class="sg-search-result"><strong>@_filtered.Count</strong><span>matches</span></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger sg-error-banner" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="sg-view-tabs" aria-label="Segment views">
        @foreach (var view in _views)
        {
            <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label</button>
        }
    </section>

    <section class="sg-content-layout">
        <main class="sg-main-card">
            @if (_loading)
            {
                <div class="sg-loading"><i class="bi bi-arrow-repeat sg-spin" aria-hidden="true"></i><strong>Loading segmentation workspace...</strong></div>
            }
            else if (_filtered.Count == 0)
            {
                <div class="sg-empty-state"><i class="bi bi-pie-chart" aria-hidden="true"></i><strong>No segments match this view</strong><span>Adjust filters or create a new segment.</span><div><button type="button" class="um-btn um-btn-ghost" @onclick="ClearFilters">Clear filters</button><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">New Segment</button></div></div>
            }
            else if (_view == "accounts")
            {
                <div class="sg-account-map">
                    @foreach (var segment in _filtered)
                    {
                        var accounts = AccountsFor(segment).Take(5).ToList();
                        <article class="sg-segment-map-card" @onclick="@(() => SelectSegment(segment))">
                            <header><span class="sg-color-dot @StatusDotClass(segment)"></span><strong>@segment.SegmentName</strong><span>@AccountsFor(segment).Count accounts</span></header>
                            @if (accounts.Count == 0)
                            {
                                <div class="sg-mini-empty">No mapped accounts</div>
                            }
                            else
                            {
                                @foreach (var account in accounts)
                                {
                                    <div class="sg-account-mini"><span class="sg-avatar @AvatarClass(account.AccountName)">@Initials(account.AccountName)</span><span><strong>@account.AccountName</strong><small>@(account.Industry ?? account.AccountTypeCode)</small></span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="@(() => Nav.NavigateTo($"/accounts/{account.AccountId}"))"><i class="bi bi-arrow-right" aria-hidden="true"></i></button></div>
                                }
                            }
                        </article>
                    }
                </div>
            }
            else if (_view == "analytics")
            {
                <div class="sg-analytics-grid">
                    <section><h3>Status distribution</h3>@foreach (var row in StatusBreakdown) { <div class="sg-meter-row"><span>@row.Label</span><div><i style="width:@row.Width%"></i></div><strong>@row.Count</strong></div> }</section>
                    <section><h3>Account distribution</h3>@foreach (var row in AccountBreakdown) { <div class="sg-meter-row"><span>@row.Label</span><div><i style="width:@row.Width%"></i></div><strong>@row.Count</strong></div> }</section>
                    <section><h3>Lifecycle mix</h3>@foreach (var row in LifecycleBreakdown) { <div class="sg-meter-row"><span>@row.Label</span><div><i style="width:@row.Width%"></i></div><strong>@row.Count</strong></div> }</section>
                    <section><h3>Revenue mix</h3>@foreach (var row in RevenueBreakdown) { <div class="sg-meter-row"><span>@row.Label</span><div><i style="width:@row.Width%"></i></div><strong>@row.Count</strong></div> }</section>
                </div>
            }
            else
            {
                <div class="sg-table-scroll">
                    <table class="sg-table">
                        <thead><tr><th>Segment</th><th>Code</th><th>Accounts</th><th>Status</th><th>Created</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var segment in _filtered)
                            {
                                <tr class="@RowClass(segment)" @onclick="@(() => SelectSegment(segment))">
                                    <td><div class="sg-name-cell"><span class="sg-segment-icon @StatusDotClass(segment)"><i class="bi bi-pie-chart" aria-hidden="true"></i></span><span><strong>@segment.SegmentName</strong><small>@(segment.Description ?? "No description")</small></span></div></td>
                                    <td><span class="sg-code-badge">@segment.SegmentCode</span></td>
                                    <td>@AccountsFor(segment).Count</td>
                                    <td><span class="@StatusClass(segment)">@(segment.IsActive ? "Active" : "Inactive")</span></td>
                                    <td>@segment.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture)</td>
                                    <td @onclick:stopPropagation="true"><div class="sg-row-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenEdit(segment))" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ExportSegmentAsync(segment))" title="Export"><i class="bi bi-download" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ConfirmDelete(segment))" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </main>

        <aside class="sg-detail-card">
            @if (_selected is null)
            {
                <div class="sg-detail-empty"><i class="bi bi-pie-chart" aria-hidden="true"></i><strong>Select a segment</strong><span>Review account distribution, status, and workflow actions.</span></div>
            }
            else
            {
                <div class="sg-detail-head"><div><span class="sg-detail-eyebrow"><i class="bi bi-pie-chart" aria-hidden="true"></i> @_selected.SegmentCode</span><h2>@_selected.SegmentName</h2><p>@(_selected.Description ?? "No description captured")</p></div><span class="@StatusClass(_selected)">@(_selected.IsActive ? "Active" : "Inactive")</span></div>
                <div class="sg-detail-body">
                    <div class="sg-detail-summary"><div><span>Accounts</span><strong>@AccountsFor(_selected).Count</strong></div><div><span>Revenue</span><strong>@AccountsFor(_selected).Sum(x => x.AnnualRevenue ?? 0).ToString("C0")</strong></div><div><span>Avg revenue</span><strong>@AverageRevenue(_selected).ToString("C0")</strong></div><div><span>Created</span><strong>@_selected.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture)</strong></div></div>
                    <div class="sg-rules-card"><header><span><i class="bi bi-sliders" aria-hidden="true"></i> Segment rules</span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="EditRulesAsync"><i class="bi bi-pencil" aria-hidden="true"></i> Edit Rules</button></header><p>Rules can be configured through segment code alignment, account lifecycle, and reporting criteria. This keeps existing audience workflow available without creating a separate rules table.</p></div>
                    <div class="sg-account-list"><header><span><i class="bi bi-building" aria-hidden="true"></i> Accounts in Segment</span><strong>@AccountsFor(_selected).Count</strong></header>@foreach (var account in AccountsFor(_selected).Take(6)) { <button type="button" class="sg-account-row" @onclick="@(() => Nav.NavigateTo($"/accounts/{account.AccountId}"))"><span class="sg-avatar @AvatarClass(account.AccountName)">@Initials(account.AccountName)</span><span><strong>@account.AccountName</strong><small>@(account.Industry ?? account.AccountTypeCode)</small></span><i class="bi bi-arrow-right" aria-hidden="true"></i></button> }</div>
                    <div class="sg-detail-actions"><button type="button" class="um-btn um-btn-ghost" @onclick="@(() => OpenEdit(_selected))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost" @onclick="@(() => ExportSegmentAsync(_selected))"><i class="bi bi-download" aria-hidden="true"></i> Export</button><button type="button" class="um-btn um-btn-danger" @onclick="@(() => ConfirmDelete(_selected))"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    private Guid _tenantId;
    private bool _loading;
    private bool _saving;
    private bool _showForm;
    private bool _showDeleteConfirm;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "info";
    private string? _loadError;
    private string _view = "segments";
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private string _kpiFilter = string.Empty;
    private Guid _editingId = Guid.Empty;
    private CancellationTokenSource? _toastCts;
    private AccountSegmentDto? _selected;
    private AccountSegmentDto? _deleteTarget;
    private SegmentForm _form = new();
    private List<AccountSegmentDto> _segments = [];
    private List<AccountSegmentDto> _filtered = [];
    private List<AccountDto> _accounts = [];

    private static readonly ViewDef[] _views = [new("segments", "Segments", "bi-list-ul"), new("accounts", "Account Map", "bi-diagram-3"), new("analytics", "Analytics", "bi-graph-up")];

    private string Search { get => _search; set { _search = value ?? string.Empty; ApplyFilters(); } }
    private string StatusFilter { get => _statusFilter; set { _statusFilter = value ?? string.Empty; ApplyFilters(); } }
    private string ToastIcon => _toastKind == "danger" ? "bi-exclamation-octagon" : _toastKind == "warning" ? "bi-exclamation-triangle" : _toastKind == "success" ? "bi-check2-circle" : "bi-info-circle";

    private IEnumerable<MetricCard> Metrics =>
    [
        new("Segments", _segments.Count.ToString(), "All segment definitions", "bi-pie-chart-fill", "sg-blue", "", "Show all segments"),
        new("Active", _segments.Count(x => x.IsActive).ToString(), "Available audiences", "bi-check2-circle", "sg-green", "active", "Show active segments"),
        new("Inactive", _segments.Count(x => !x.IsActive).ToString(), "Paused segments", "bi-pause-circle", "sg-amber", "inactive", "Show inactive segments"),
        new("Accounts", _accounts.Count.ToString(), "Loaded accounts", "bi-building", "sg-cyan", "accounts", "Show account map"),
        new("Revenue", _accounts.Sum(x => x.AnnualRevenue ?? 0).ToString("C0"), "Account revenue", "bi-cash-coin", "sg-purple", "revenue", "Show segments with mapped accounts")
    ];

    private IEnumerable<BreakdownRow> StatusBreakdown => BuildBreakdown(_filtered.GroupBy(x => x.IsActive ? "Active" : "Inactive").Select(g => (g.Key, g.Count())));
    private IEnumerable<BreakdownRow> AccountBreakdown => BuildBreakdown(_filtered.Select(x => (x.SegmentName, AccountsFor(x).Count)));
    private IEnumerable<BreakdownRow> LifecycleBreakdown => BuildBreakdown(_accounts.GroupBy(x => string.IsNullOrWhiteSpace(x.LifecycleStageCode) ? "Unspecified" : x.LifecycleStageCode!).Select(g => (g.Key, g.Count())));
    private IEnumerable<BreakdownRow> RevenueBreakdown => BuildBreakdown(_filtered.Select(x => (x.SegmentName, (int)Math.Round(AccountsFor(x).Sum(a => a.AnnualRevenue ?? 0) / 1000m))));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Segments", "/crm/segments"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var segmentsResult = await Api.SearchAccountSegmentsAsync(null, 1, 100);
            _segments = segmentsResult?.Items?.OrderBy(x => x.SegmentName).ToList() ?? [];
            await EnsureSeedDataAsync();
            segmentsResult = await Api.SearchAccountSegmentsAsync(null, 1, 100);
            _segments = segmentsResult?.Items?.OrderBy(x => x.SegmentName).ToList() ?? [];
            var accountsResult = await Api.SearchAccountsAsync(_tenantId, null, 1, 500);
            _accounts = accountsResult?.Items?.ToList() ?? [];
            ApplyFilters(false);
            _selected = _selected is null ? _filtered.FirstOrDefault() : _filtered.FirstOrDefault(x => x.SegmentId == _selected.SegmentId) ?? _filtered.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load segments: {ex.Message}";
            _segments = [];
            _accounts = [];
            ApplyFilters(false);
            await ShowToastAsync($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters(bool resetDetail = true)
    {
        IEnumerable<AccountSegmentDto> query = _segments;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            query = query.Where(x => Contains(x.SegmentName, term) || Contains(x.SegmentCode, term) || Contains(x.Description ?? string.Empty, term));
        }
        if (!string.IsNullOrWhiteSpace(_statusFilter)) query = _statusFilter == "active" ? query.Where(x => x.IsActive) : query.Where(x => !x.IsActive);
        query = _kpiFilter switch
        {
            "active" => query.Where(x => x.IsActive),
            "inactive" => query.Where(x => !x.IsActive),
            "accounts" => query.Where(x => AccountsFor(x).Count > 0),
            "revenue" => query.Where(x => AccountsFor(x).Sum(a => a.AnnualRevenue ?? 0) > 0),
            _ => query
        };
        _filtered = query.OrderBy(x => x.SegmentName).ToList();
        if (resetDetail) _selected = _filtered.FirstOrDefault(x => x.SegmentId == _selected?.SegmentId) ?? _filtered.FirstOrDefault();
    }

    private void ClearFilters() { _search = string.Empty; _statusFilter = string.Empty; _kpiFilter = string.Empty; ApplyFilters(); }
    private void SetKpiFilter(string filter) { _kpiFilter = _kpiFilter == filter ? string.Empty : filter; _view = filter == "accounts" ? "accounts" : "segments"; ApplyFilters(); }
    private void SetView(string view) => _view = view;
    private void ShowSegments() => _view = "segments";
    private void ShowAccountMap() => _view = "accounts";
    private void ShowAnalytics() => _view = "analytics";
    private void ShowActive() { _statusFilter = "active"; _view = "segments"; ApplyFilters(); }
    private void SelectSegment(AccountSegmentDto segment) => _selected = segment;

    private void OpenCreate()
    {
        _editingId = Guid.Empty;
        _form = new SegmentForm { IsActive = true };
        _showForm = true;
    }

    private void OpenEdit(AccountSegmentDto segment)
    {
        _editingId = segment.SegmentId;
        _form = new SegmentForm { SegmentCode = segment.SegmentCode, SegmentName = segment.SegmentName, Description = segment.Description, IsActive = segment.IsActive };
        _showForm = true;
    }

    private void CloseForm() { if (!_saving) _showForm = false; }
    private void ConfirmDelete(AccountSegmentDto segment) { _deleteTarget = segment; _showDeleteConfirm = true; }
    private void CancelDelete() { if (!_saving) { _deleteTarget = null; _showDeleteConfirm = false; } }
    private Task HandleInvalidSubmitAsync(EditContext _) => ShowToastAsync("Fix validation errors before saving.", "warning");

    private async Task SaveSegmentAsync()
    {
        _saving = true;
        try
        {
            if (_editingId == Guid.Empty)
            {
                await Api.CreateAccountSegmentAsync(new CreateAccountSegmentRequest { TenantId = _tenantId, SegmentCode = NormalizeCode(_form.SegmentCode), SegmentName = _form.SegmentName, Description = _form.Description, IsActive = _form.IsActive });
                await ShowToastAsync("Segment created.", "success");
            }
            else
            {
                await Api.UpdateAccountSegmentAsync(_editingId, new UpdateAccountSegmentRequest { SegmentId = _editingId, TenantId = _tenantId, SegmentCode = NormalizeCode(_form.SegmentCode), SegmentName = _form.SegmentName, Description = _form.Description, IsActive = _form.IsActive });
                await ShowToastAsync("Segment saved.", "success");
            }
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        _saving = true;
        try
        {
            await Api.DeleteAccountSegmentAsync(_deleteTarget.SegmentId);
            await ShowToastAsync("Segment deleted.", "success");
            _deleteTarget = null;
            _showDeleteConfirm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Delete failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ExportSegmentAsync(AccountSegmentDto segment)
    {
        await ShowToastAsync($"Export prepared for {segment.SegmentName} ({AccountsFor(segment).Count} account(s)).", "success");
    }

    private Task EditRulesAsync() => ShowToastAsync("Segment rules remain aligned to account segment codes and reporting criteria.", "info");

    private async Task EnsureSeedDataAsync()
    {
        if (_segments.Count > 0) return;
        var seeds = new[]
        {
            new CreateAccountSegmentRequest { TenantId = _tenantId, SegmentCode = "PLATINUM", SegmentName = "Platinum Tier", Description = "Top-value accounts by revenue, relationship strength, and retention priority.", IsActive = true },
            new CreateAccountSegmentRequest { TenantId = _tenantId, SegmentCode = "GOLD", SegmentName = "Gold Tier", Description = "Mid-market accounts with strong renewal and cross-sell potential.", IsActive = true },
            new CreateAccountSegmentRequest { TenantId = _tenantId, SegmentCode = "RISK-RENEWAL", SegmentName = "High-Risk Renewal", Description = "Accounts requiring producer attention due to risk profile or renewal timing.", IsActive = true },
            new CreateAccountSegmentRequest { TenantId = _tenantId, SegmentCode = "NURTURE", SegmentName = "Nurture Audience", Description = "Lower-touch accounts and prospects used for marketing nurture campaigns.", IsActive = false }
        };
        foreach (var seed in seeds)
        {
            await Api.CreateAccountSegmentAsync(seed);
        }
    }

    private List<AccountDto> AccountsFor(AccountSegmentDto segment) => _accounts.Where(x => string.Equals(x.SegmentCode, segment.SegmentCode, StringComparison.OrdinalIgnoreCase)).OrderBy(x => x.AccountName).ToList();
    private decimal AverageRevenue(AccountSegmentDto segment) { var accounts = AccountsFor(segment); return accounts.Count == 0 ? 0 : accounts.Sum(x => x.AnnualRevenue ?? 0) / accounts.Count; }

    private static IEnumerable<BreakdownRow> BuildBreakdown(IEnumerable<(string Label, int Count)> rows)
    {
        var list = rows.OrderByDescending(x => x.Count).ToList();
        var max = Math.Max(1, list.Select(x => x.Count).DefaultIfEmpty(1).Max());
        return list.Select(x => new BreakdownRow(x.Label, x.Count, (double)x.Count / max * 100));
    }

    private async Task ShowToastAsync(string message, string kind = "info")
    {
        _toastCts?.Cancel(); _toastCts?.Dispose(); _toastCts = new CancellationTokenSource();
        _toastMessage = message.Length <= 120 ? message : $"{message[..117]}..."; _toastKind = ToastKind(kind); _toastVisible = true; StateHasChanged();
        try { await Task.Delay(_toastKind == "danger" ? 10000 : 6500, _toastCts.Token); _toastVisible = false; await InvokeAsync(StateHasChanged); } catch (TaskCanceledException) { }
    }

    private void HideToast() { _toastCts?.Cancel(); _toastVisible = false; }
    private static string ToastKind(string value) => value.Contains("danger", StringComparison.OrdinalIgnoreCase) || value.Contains("error", StringComparison.OrdinalIgnoreCase) ? "danger" : value.Contains("warning", StringComparison.OrdinalIgnoreCase) ? "warning" : value.Contains("success", StringComparison.OrdinalIgnoreCase) ? "success" : "info";
    private async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; }
    private static bool Contains(string value, string term) => value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static string NormalizeCode(string value) => value.Trim().ToUpperInvariant().Replace(' ', '-');
    private static string Initials(string name) { var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length > 0 ? name[..1] : "?"; }
    private static string AvatarClass(string name) { var classes = new[] { "sg-av1", "sg-av2", "sg-av3", "sg-av4", "sg-av5", "sg-av6" }; return classes[Math.Abs(name.GetHashCode()) % classes.Length]; }
    private static string StatusClass(AccountSegmentDto segment) => segment.IsActive ? "sg-status sg-status-active" : "sg-status sg-status-inactive";
    private static string StatusDotClass(AccountSegmentDto segment) => segment.IsActive ? "sg-active" : "sg-inactive";
    private string RowClass(AccountSegmentDto segment) => _selected?.SegmentId == segment.SegmentId ? "sg-row-selected" : string.Empty;
    private string MetricCardClass(MetricCard metric) => $"sg-kpi-card {metric.Tone} {(_kpiFilter == metric.Filter && !string.IsNullOrWhiteSpace(metric.Filter) ? "sg-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewDef view) => _view == view.Id ? "sg-view-btn sg-view-btn-active" : "sg-view-btn";

    private sealed record ViewDef(string Id, string Label, string Icon);
    private sealed record MetricCard(string Label, string Value, string Caption, string Icon, string Tone, string Filter, string Tooltip);
    private sealed record BreakdownRow(string Label, int Count, double Width);

    private sealed class SegmentForm
    {
        [Required, StringLength(50)]
        public string SegmentCode { get; set; } = string.Empty;
        [Required, StringLength(150)]
        public string SegmentName { get; set; } = string.Empty;
        [StringLength(500)]
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
