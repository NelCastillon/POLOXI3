@page "/crm/leads/duplicates"
@namespace Ams.Web.Components.Pages.Crm
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Lead Duplicates</PageTitle>

<AppPageHeader Title="Lead Duplicates"
               Subtitle="Review and resolve duplicate leads — merge, keep, or dismiss"
               Icon="bi-subtract">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh">
            <i class="bi bi-arrow-clockwise @(_loading ? "ldup-spin" : "")" aria-hidden="true"></i>
        </button>
    </Actions>
</AppPageHeader>

<!-- Summary strip -->
<div class="ldup-summary-strip">
    <div class="ldup-summary-card ldup-s1">
        <div class="ldup-summary-val">@_groups.Count</div>
        <div class="ldup-summary-lbl">Duplicate Groups</div>
    </div>
    <div class="ldup-summary-card ldup-s2">
        <div class="ldup-summary-val">@_groups.Sum(g => g.Leads.Count)</div>
        <div class="ldup-summary-lbl">Duplicate Leads</div>
    </div>
    <div class="ldup-summary-card ldup-s3">
        <div class="ldup-summary-val">@_groups.Count(g => g.Confidence >= 90)</div>
        <div class="ldup-summary-lbl">High Confidence</div>
    </div>
    <div class="ldup-summary-card ldup-s4">
        <div class="ldup-summary-val">@_resolved</div>
        <div class="ldup-summary-lbl">Resolved Today</div>
    </div>
</div>

@if (_loading)
{
    <div class="ldup-loading">
        <i class="bi bi-arrow-clockwise ldup-spin" style="font-size:1.4rem;"></i>
        <span>Scanning for duplicates…</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_loadError</div>
}
else if (!_groups.Any())
{
    <div class="ldup-empty-state">
        <i class="bi bi-check-circle-fill ldup-empty-icon"></i>
        <div class="ldup-empty-title">No Duplicates Found</div>
        <div class="ldup-empty-sub">All leads appear to be unique. Run a manual scan to re-check.</div>
        <button class="um-btn um-btn-primary" @onclick="LoadAsync">Re-scan Leads</button>
    </div>
}
else
{
    <div class="ldup-groups">
        @foreach (var grp in _groups)
        {
            <div class="ldup-group-card">
                <div class="ldup-group-header">
                    <div class="ldup-group-meta">
                        <span class="ldup-conf-badge ldup-conf--@ConfClass(grp.Confidence)">
                            @grp.Confidence% match
                        </span>
                        <span class="ldup-match-reason">
                            <i class="bi bi-lightning-charge-fill"></i> @grp.MatchReason
                        </span>
                    </div>
                    <div class="ldup-group-actions">
                        <button class="um-btn um-btn-sm um-btn-primary" @onclick="() => MergeAsync(grp)">
                            <i class="bi bi-union"></i> Merge
                        </button>
                        <button class="um-btn um-btn-sm um-btn-ghost" @onclick="() => DismissAsync(grp)">
                            <i class="bi bi-x-lg"></i> Dismiss
                        </button>
                    </div>
                </div>
                <div class="ldup-lead-grid">
                    @foreach (var lead in grp.Leads)
                    {
                        <div class="ldup-lead-card @(lead.IsPrimary ? "ldup-lead-card--primary" : "")">
                            @if (lead.IsPrimary)
                            {
                                <div class="ldup-primary-badge">Primary</div>
                            }
                            <div class="ldup-lead-name">@lead.FullName</div>
                            <div class="ldup-lead-detail"><i class="bi bi-envelope"></i> @lead.Email</div>
                            <div class="ldup-lead-detail"><i class="bi bi-telephone"></i> @lead.Phone</div>
                            <div class="ldup-lead-detail"><i class="bi bi-building"></i> @lead.Company</div>
                            <div class="ldup-lead-detail"><i class="bi bi-calendar3"></i> Created @lead.CreatedDate</div>
                            <div class="ldup-lead-stage-row">
                                <span class="ldup-stage ldup-stage--@lead.Stage.ToLower()">@lead.Stage</span>
                                <span class="ldup-score">Score: @lead.Score</span>
                            </div>
                            @if (!lead.IsPrimary)
                            {
                                <button class="um-btn um-btn-sm um-btn-ghost ldup-set-primary-btn" @onclick="() => SetPrimary(grp, lead)">
                                    Set as Primary
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    bool _loading = true;
    int _resolved;
    string? _loadError;
    List<DupGroup> _groups = [];

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("CRM", "/crm"), new("Leads", "/crm/leads"), new("Duplicates"));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchLeadsAsync(_tenantId);
            var leads = result?.Items?.ToList() ?? [];
            _groups = BuildDuplicateGroups(leads);
        }
        catch (Exception ex)
        {
            _loadError = $"Scan failed: {ex.Message}";
            _groups = [];
        }
        finally
        {
            _loading = false;
        }
    }

    async Task MergeAsync(DupGroup grp)
    {
        await Task.Delay(0);
        _groups.Remove(grp);
        _resolved++;
    }

    async Task DismissAsync(DupGroup grp)
    {
        await Task.Delay(0);
        _groups.Remove(grp);
    }

    void SetPrimary(DupGroup grp, DupLead lead)
    {
        foreach (var l in grp.Leads) l.IsPrimary = false;
        lead.IsPrimary = true;
    }

    static string ConfClass(int c) => c >= 90 ? "high" : c >= 70 ? "med" : "low";

    static List<DupGroup> BuildDuplicateGroups(IEnumerable<LeadDto> leads)
    {
        var groups = new List<DupGroup>();
        groups.AddRange(BuildGroups(leads.Where(l => !string.IsNullOrWhiteSpace(l.Email)).GroupBy(l => l.Email!.Trim().ToLowerInvariant()), "Email address", 97));
        groups.AddRange(BuildGroups(leads.Where(l => !string.IsNullOrWhiteSpace(l.Phone)).GroupBy(l => DigitsOnly(l.Phone!)), "Phone number", 90));
        groups.AddRange(BuildGroups(leads.GroupBy(l => $"{l.FirstName.Trim().ToLowerInvariant()}|{l.LastName.Trim().ToLowerInvariant()}|{l.AccountName?.Trim().ToLowerInvariant()}"), "Name + company", 84));

        return groups
            .GroupBy(g => string.Join('|', g.Leads.Select(l => l.LeadId).OrderBy(id => id)))
            .Select(g => g.OrderByDescending(x => x.Confidence).First())
            .OrderByDescending(g => g.Confidence)
            .ThenByDescending(g => g.Leads.Count)
            .ToList();
    }

    static IEnumerable<DupGroup> BuildGroups(IEnumerable<IGrouping<string, LeadDto>> source, string reason, int confidence) =>
        source
            .Where(g => !string.IsNullOrWhiteSpace(g.Key) && g.Count() > 1)
            .Select(g => new DupGroup(reason, confidence, g.OrderBy(l => l.CreatedDateUtc).Select((l, i) => new DupLead(l, i == 0)).ToList()));

    static string DigitsOnly(string value) => new(value.Where(char.IsDigit).ToArray());

    static string NormalizeStage(string? stage, int statusCode)
    {
        if (!string.IsNullOrWhiteSpace(stage)) return stage.Trim() == "Won" ? "Converted" : stage.Trim() == "Closed" ? "Lost" : stage.Trim();
        return statusCode switch { 2 => "Contacted", 3 => "Qualified", 4 => "Converted", 5 => "Lost", _ => "New" };
    }

    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    class DupGroup(string matchReason, int confidence, List<DupLead> leads)
    {
        public string MatchReason { get; } = matchReason;
        public int Confidence { get; } = confidence;
        public List<DupLead> Leads { get; } = leads;
    }

    class DupLead(LeadDto lead, bool isPrimary)
    {
        public Guid   LeadId      { get; } = lead.LeadId;
        public string FullName    { get; } = $"{lead.FirstName} {lead.LastName}".Trim();
        public string Email       { get; } = lead.Email ?? "—";
        public string Phone       { get; } = lead.Phone ?? "—";
        public string Company     { get; } = lead.AccountName ?? "—";
        public string Stage       { get; } = NormalizeStage(lead.NurturingStageCode, lead.StatusCode);
        public int    Score       { get; } = Math.Clamp(lead.Score ?? 0, 0, 100);
        public string CreatedDate { get; } = lead.CreatedDateUtc.ToString("MMM d, yyyy");
        public bool   IsPrimary   { get; set; } = isPrimary;
    }
}
