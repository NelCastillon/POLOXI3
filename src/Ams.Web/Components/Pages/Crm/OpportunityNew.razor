@page "/crm/opportunities/new"
@namespace Ams.Web.Components.Pages.Crm
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>New Opportunity — CRM</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Create New Opportunity"
               Subtitle="Add a new sales opportunity to track"
               Icon="bi-plus-circle">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back
        </button>
    </Actions>
</AppPageHeader>

<div class="opp-new-container">
    <div class="opp-new-form-card">
        <form @onsubmit="HandleSubmit">
            <div class="opp-form-row">
                <div class="opp-form-group">
                    <label class="opp-form-label">Opportunity Name <span class="opp-required">*</span></label>
                    <input type="text"
                           class="opp-form-input"
                           placeholder="Enter opportunity name"
                           @bind="_model.OpportunityName"
                           required />
                </div>

                <div class="opp-form-group">
                    <label class="opp-form-label">Account <span class="opp-required">*</span></label>
                    <SfDropDownList TValue="Guid" TItem="AccountOption"
                                    DataSource="_accounts"
                                    Placeholder="Select account"
                                    Value="_model.AccountId"
                                    ValueChanged="@((Guid val) => _model.AccountId = val)"
                                    required>
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                    </SfDropDownList>
                </div>
            </div>

            <div class="opp-form-row">
                <div class="opp-form-group">
                    <label class="opp-form-label">Estimated Amount <span class="opp-required">*</span></label>
                    <div class="opp-input-prefix">
                        <span class="opp-prefix-text">$</span>
                        <input type="number"
                               class="opp-form-input"
                               placeholder="0.00"
                               @bind="_model.EstimatedAmount"
                               step="0.01"
                               min="0"
                               required />
                    </div>
                </div>

                <div class="opp-form-group">
                    <label class="opp-form-label">Win Probability %</label>
                    <div class="opp-input-suffix">
                        <input type="number"
                               class="opp-form-input"
                               placeholder="0"
                               @bind="_model.WinProbability"
                               step="5"
                               min="0"
                               max="100" />
                        <span class="opp-suffix-text">%</span>
                    </div>
                </div>
            </div>

            <div class="opp-form-row">
                <div class="opp-form-group">
                    <label class="opp-form-label">Close Date <span class="opp-required">*</span></label>
                    <input type="date"
                           class="opp-form-input"
                           @bind="_model.CloseDate"
                           required />
                </div>

                <div class="opp-form-group">
                    <label class="opp-form-label">Forecast Category</label>
                    <SfDropDownList TValue="string" TItem="ForecastCategoryOption"
                                    DataSource="_forecastCategories"
                                    Placeholder="Select category"
                                    Value="_model.ForecastCategoryCode">
                        <DropDownListFieldSettings Value="Code" Text="Label" />
                    </SfDropDownList>
                </div>
            </div>

            <div class="opp-form-row">
                <div class="opp-form-group">
                    <label class="opp-form-label">Opportunity Owner</label>
                    <SfDropDownList TValue="Guid?" TItem="UserOption"
                                    DataSource="_users"
                                    Placeholder="Select owner"
                                    Value="_model.OwnerUserId"
                                    ValueChanged="@((Guid? val) => _model.OwnerUserId = val)">
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                    </SfDropDownList>
                </div>

                <div class="opp-form-group">
                    <label class="opp-form-label">Lead Source</label>
                    <SfDropDownList TValue="Guid?" TItem="LeadOption"
                                    DataSource="_leads"
                                    Placeholder="Select lead (optional)"
                                    Value="_model.LeadId"
                                    ValueChanged="@((Guid? val) => _model.LeadId = val)">
                        <DropDownListFieldSettings Value="Id" Text="Name" />
                    </SfDropDownList>
                </div>
            </div>

            <div class="opp-form-row">
                <div class="opp-form-group full-width">
                    <label class="opp-form-label">Description</label>
                    <textarea class="opp-form-textarea"
                              placeholder="Add details about this opportunity…"
                              rows="4"
                              @bind="_model.Description"></textarea>
                </div>
            </div>

            <div class="opp-form-actions">
                <button type="button"
                        class="um-btn um-btn-ghost"
                        @onclick='() => Nav.NavigateTo("/crm/opportunities")'>
                    Cancel
                </button>
                <button type="submit"
                        class="um-btn um-btn-primary"
                        disabled="@_submitting">
                    @if (_submitting)
                    {
                        <span class="um-spinner-inline" aria-hidden="true"></span>
                    }
                    Create Opportunity
                </button>
            </div>
        </form>
    </div>
</div>

@code {
    private class CreateOpportunityModel
    {
        public string OpportunityName { get; set; } = string.Empty;
        public Guid AccountId { get; set; }
        public decimal EstimatedAmount { get; set; }
        public int WinProbability { get; set; } = 50;
        public DateTime CloseDate { get; set; }
        public string? ForecastCategoryCode { get; set; }
        public Guid? OwnerUserId { get; set; }
        public Guid? LeadId { get; set; }
        public string? Description { get; set; }
    }

    private record AccountOption(Guid Id, string Name);
    private record UserOption(Guid Id, string Name);
    private record LeadOption(Guid Id, string Name);
    private record ForecastCategoryOption(string Code, string Label);

    private SfToast _toast = null!;
    private CreateOpportunityModel _model = new();

    private List<AccountOption> _accounts = [];
    private List<UserOption> _users = [];
    private List<LeadOption> _leads = [];
    private List<ForecastCategoryOption> _forecastCategories = [];

    private bool _submitting = false;

    protected override async Task OnInitializedAsync()
    {
        _model.CloseDate = DateTime.Now.AddMonths(1);
        _model.WinProbability = 50;
        _model.ForecastCategoryCode = "Pipeline";
        await LoadReferenceData();
        Breadcrumbs.SetBreadcrumb("New Opportunity", "/crm/opportunities/new");
    }

    private async Task LoadReferenceData()
    {
        try
        {
            // Load accounts
            var accountsResult = await Api.GetAsync<List<AccountOption>>("api/accounts?pageSize=1000");
            if (accountsResult?.Success == true)
                _accounts = accountsResult.Data ?? [];

            // Load users
            var usersResult = await Api.GetAsync<List<UserOption>>("api/users?pageSize=1000");
            if (usersResult?.Success == true)
                _users = usersResult.Data ?? [];

            // Load leads
            var leadsResult = await Api.GetAsync<List<LeadOption>>("api/leads?pageSize=1000");
            if (leadsResult?.Success == true)
                _leads = leadsResult.Data ?? [];

            // Load forecast categories
            _forecastCategories =
            [
                new("Pipeline", "Pipeline"),
                new("BestCase", "Best Case"),
                new("CommitmentForecast", "Commitment"),
                new("Forecast", "Forecast"),
                new("Omitted", "Omitted"),
            ];
        }
        catch (Exception ex)
        {
            await ShowToast("Error loading reference data", ex.Message, "Error");
        }
    }

    private async Task HandleSubmit()
    {
        if (_model.AccountId == Guid.Empty)
        {
            await ShowToast("Validation Error", "Please select an account", "Error");
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.OpportunityName))
        {
            await ShowToast("Validation Error", "Please enter an opportunity name", "Error");
            return;
        }

        _submitting = true;
        try
        {
            var payload = new
            {
                _model.OpportunityName,
                _model.AccountId,
                _model.EstimatedAmount,
                _model.WinProbability,
                _model.CloseDate,
                _model.ForecastCategoryCode,
                _model.OwnerUserId,
                _model.LeadId,
                _model.Description
            };

            var result = await Api.PostAsync<Guid>("api/opportunities", payload);
            if (result?.Success == true && result.Data != Guid.Empty)
            {
                await ShowToast("Success", "Opportunity created successfully", "Success");
                Nav.NavigateTo($"/crm/opportunities/{result.Data}");
            }
            else
            {
                await ShowToast("Error", result?.Message ?? "Failed to create opportunity", "Error");
            }
        }
        catch (Exception ex)
        {
            await ShowToast("Error", ex.Message, "Error");
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task ShowToast(string title, string message, string cssClass)
    {
        if (_toast != null)
        {
            await _toast.ShowAsync(new ToastModel
            {
                Title = title,
                Content = message,
                CssClass = cssClass
            });
        }
    }
}
