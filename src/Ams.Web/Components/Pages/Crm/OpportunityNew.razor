@page "/crm/opportunities/new"
@namespace Ams.Web.Components.Pages.Crm
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Opportunities

<PageTitle>New Opportunity — CRM</PageTitle>

<AppPageHeader Title="New Opportunity" Subtitle="Create a sales opportunity tied to an account" Icon="bi-plus-circle"><Actions><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities")'><i class="bi bi-arrow-left"></i> Opportunities</button></Actions></AppPageHeader>
<section class="ma-hero opp-hero"><div><span class="ma-eyebrow">CRM · Opportunities</span><h2>Create Opportunity</h2><p>Capture opportunity amount, close date, forecast category, and account relationship.</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-primary" type="button" @onclick="SubmitAsync" disabled="@_saving"><i class="bi bi-check-lg"></i> Create Opportunity</button></div></section>
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }
<div class="acct-form-card"><EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Opportunity Number <span class="text-danger">*</span></label><InputText @bind-Value="_form.OpportunityNumber" class="um-input" /><ValidationMessage For="() => _form.OpportunityNumber" class="text-danger" /></div><div class="um-field"><label>Opportunity Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.OpportunityName" class="um-input" /><ValidationMessage For="() => _form.OpportunityName" class="text-danger" /></div><div class="um-field"><label>Account <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.AccountId" class="um-input"><option value="">Select account</option>@foreach (var account in _accounts) { <option value="@account.AccountId">@account.AccountName</option> }</InputSelect><ValidationMessage For="() => _form.AccountId" class="text-danger" /></div><div class="um-field"><label>Estimated Amount</label><InputNumber @bind-Value="_form.EstimatedAmount" class="um-input" /><ValidationMessage For="() => _form.EstimatedAmount" class="text-danger" /></div><div class="um-field"><label>Win Probability</label><InputNumber @bind-Value="_form.WinProbability" class="um-input" /><ValidationMessage For="() => _form.WinProbability" class="text-danger" /></div><div class="um-field"><label>Close Date</label><InputDate @bind-Value="_form.CloseDate" class="um-input" /></div><div class="um-field"><label>Forecast Category <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.ForecastCategoryCode" class="um-input">@foreach (var cat in OpportunityPageConstants.ForecastCategories) { <option value="@cat">@cat</option> }</InputSelect><ValidationMessage For="() => _form.ForecastCategoryCode" class="text-danger" /></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities")'>Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_saving ? "Creating…" : "Create Opportunity")</button></div></EditForm></div>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />
@code { OpportunityFormModel _form = new(); EditContext _editContext = default!; List<AccountDto> _accounts = []; SfToast _toast = default!; string? _loadError; bool _saving; protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("CRM", "/crm/opportunities"), new("New Opportunity")); _editContext = new(_form); await LoadAccountsAsync(); } async Task LoadAccountsAsync() { try { _accounts = (await Api.SearchAccountsAsync(OpportunityPageConstants.TenantId))?.Items.ToList() ?? []; } catch (Exception ex) { _loadError = $"Failed to load accounts: {ex.Message}"; } } async Task SubmitAsync() { if (!_editContext.Validate()) return; _saving = true; try { var id = await Api.CreateOpportunityAsync(new CreateOpportunityRequest { TenantId = OpportunityPageConstants.TenantId, OpportunityNumber = _form.OpportunityNumber, AccountId = _form.AccountId!.Value, OpportunityName = _form.OpportunityName, EstimatedAmount = _form.EstimatedAmount, OwnerUserId = _form.OwnerUserId, CloseDate = _form.CloseDate, LeadId = _form.LeadId, WinProbability = _form.WinProbability, ForecastCategoryCode = _form.ForecastCategoryCode }); await _toast.ShowAsync(new() { Content = "Opportunity created", CssClass = "e-toast-success" }); Nav.NavigateTo($"/crm/opportunities/{id}"); } catch (Exception ex) { _loadError = $"Create failed: {ex.Message}"; await _toast.ShowAsync(new() { Content = $"Create failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } }
