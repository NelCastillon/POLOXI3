    private void OnOpportunityDocumentSelected(InputFileChangeEventArgs args)
    {
        _uploadFileError = null;
        _selectedUploadFile = args.File;

        var extension = Path.GetExtension(_selectedUploadFile.Name);
        if (!AllowedUploadExtensions.Contains(extension))
        {
            _uploadFileError = "Select a supported document type: PDF, Word, Excel, CSV, image, or TIFF.";
            _selectedUploadFile = null;
            return;
        }

        if (_selectedUploadFile.Size > MaxUploadBytes)
        {
            _uploadFileError = "The selected file is larger than the 100 MB upload limit.";
            _selectedUploadFile = null;
            return;
        }

        _uploadForm.FileName = _selectedUploadFile.Name;
        _uploadForm.Extension = extension;
        _uploadForm.SizeKb = ToSizeKb(_selectedUploadFile.Size);
    }

    private async Task CommitUploadDocumentAsync()
    {
        if (_opp is null) return;

        if (_selectedUploadFile is null)
        {
            _uploadFileError = "Select a document file to upload.";
            return;
        }

        _savingUpload = true;
        try
        {
            await using var stream = _selectedUploadFile.OpenReadStream(MaxUploadBytes);
            await Api.UploadDocumentAsync(new ApiClient.UploadDocumentRequest
            {
                TenantId = _tenantId,
                DocumentTypeCode = _uploadForm.Category,
                CategoryCode = _uploadForm.Category,
                FileName = _uploadForm.FileName,
                OriginalFileName = _selectedUploadFile.Name,
                EntityName = "Opportunity",
                EntityId = OpportunityId,
                Tags = "opportunity",
                UploadedByName = _uploadedByName,
                CreatedByUserId = _currentUserId,
                Content = stream
            });

            _showUpload = false;
            ResetUpload();
            await LoadOpportunityDocumentsAsync();
            await ShowToast("Document uploaded successfully.");
        }
        catch (Exception ex)
        {
            await ShowToast($"Document upload failed: {ex.Message}", "enterprise-toast-danger");
        }
        finally
        {
            _savingUpload = false;
        }
    }

