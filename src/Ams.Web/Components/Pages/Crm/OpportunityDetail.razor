    private static bool IsClosedWon(string? stage) => string.Equals(stage, "Closed Won", StringComparison.OrdinalIgnoreCase);

    private bool ShowPolicyBindingRequiredCta => _opp is not null
        && string.Equals(_opp.Stage, "Closed Won", StringComparison.OrdinalIgnoreCase)
        && _currentPolicies.Count == 0
        && _workflowEvents.Any(e => string.Equals(e.EventType, "PolicyBindingRequired", StringComparison.OrdinalIgnoreCase));

    private string PolicyBindingRequiredDetail => _workflowEvents
        .Where(e => string.Equals(e.EventType, "PolicyBindingRequired", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(e => e.EventDateUtc)
        .Select(e => e.EventDetail)
        .FirstOrDefault(detail => !string.IsNullOrWhiteSpace(detail))
        ?? "This opportunity was won without creating a bound policy. Complete the binding workflow when operations is ready.";

