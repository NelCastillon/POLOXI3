@page "/crm/opportunities/{OpportunityId:guid}"
@namespace Ams.Web.Components.Pages.Crm
@using Ams.Application.Features.Opportunities
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@(_opp is null ? "Opportunity" : _opp.Name) — CRM</PageTitle>

@if (_toastVisible)
{
    <div class="od-toast od-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="od-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_loading)
{
    <div class="od-enterprise-page"><div class="od-loading"><span class="um-spin" aria-hidden="true"></span><span>Loading opportunity…</span></div></div>
}
else if (_opp is null)
{
    <div class="od-enterprise-page"><div class="od-not-found">
        <i class="bi bi-trophy od-nf-icon" aria-hidden="true"></i>
        <h2>Opportunity not found</h2>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back
        </button>
    </div></div>
}
else
{
    <div class="od-enterprise-page">
    <section class="od-hero">
        <div class="od-hero-left">
            <span class="od-hero-icon"><i class="bi bi-trophy-fill" aria-hidden="true"></i></span>
            <div class="od-hero-copy">
                <div class="od-title-row">
                    <h1>@_opp.Name</h1>
                    <span><i class="bi bi-hash" aria-hidden="true"></i> @_opp.OppNumber</span>
                </div>
                <p>@_opp.AccountName · @_opp.Owner · Close @_opp.CloseDate.ToString("d")</p>
            </div>
        </div>
        <div class="od-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="OpenEditOpportunity"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
            <button class="um-btn um-btn-ghost" @onclick="OpenStageDialog"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Move Stage</button>
            <button class="um-btn um-btn-ghost" @onclick="OpenNewSubmission"><i class="bi bi-send-plus" aria-hidden="true"></i> New Submission</button>
            <button class="um-btn um-btn-primary" @onclick="OpenWonDialog"><i class="bi bi-check2-circle" aria-hidden="true"></i> Mark Won</button>
        </div>
    </section>

    <section class="od-kpi-strip" aria-label="Opportunity KPI filters">
        <button type="button" class='@KpiClass("overview")' title="Show overview" @onclick='() => ActivateKpi("overview", 0)'><span class="od-kpi-icon"><i class="bi bi-cash-coin" aria-hidden="true"></i></span><span><strong class="od-kpi-val">@_opp.Amount.ToString("C0")</strong><span class="od-kpi-lbl">Amount</span><small>@WeightedAmount.ToString("C0") weighted</small></span></button>
        <button type="button" class='@KpiClass("stage")' title="Show workflow" @onclick='() => ActivateKpi("stage", 6)'><span class="od-kpi-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span><span><strong class="od-kpi-val">@_opp.WinPct%</strong><span class="od-kpi-lbl">Win probability</span><small>@_opp.ForecastCategory forecast</small></span></button>
        <button type="button" class='@KpiClass("activities")' title="Show activities" @onclick='() => ActivateKpi("activities", 1)'><span class="od-kpi-icon"><i class="bi bi-lightning-charge" aria-hidden="true"></i></span><span><strong class="od-kpi-val">@_activities.Count</strong><span class="od-kpi-lbl">Activities</span><small>@RecentActivityText</small></span></button>
        <button type="button" class='@KpiClass("submissions")' title="Show submissions" @onclick='() => ActivateKpi("submissions", 2)'><span class="od-kpi-icon"><i class="bi bi-send" aria-hidden="true"></i></span><span><strong class="od-kpi-val">@_submissions.Count</strong><span class="od-kpi-lbl">Submissions</span><small>@_quotes.Count quote(s)</small></span></button>
        <button type="button" class='@KpiClass("documents")' title="Show documents" @onclick='() => ActivateKpi("documents", 4)'><span class="od-kpi-icon"><i class="bi bi-folder2-open" aria-hidden="true"></i></span><span><strong class="od-kpi-val">@_documents.Count</strong><span class="od-kpi-lbl">Documents</span><small>Proposal package</small></span></button>
        <button type="button" class='@KpiClass("competitors")' title="Show competitors" @onclick='() => ActivateKpi("competitors", 5)'><span class="od-kpi-icon"><i class="bi bi-crosshair" aria-hidden="true"></i></span><span><strong class="od-kpi-val">@_competitors.Count</strong><span class="od-kpi-lbl">Competitors</span><small>Market intel</small></span></button>
    </section>

    <!-- Identity strip -->
    <div class="od-strip">
        <span class="@StageBadge(_opp.Stage)">@_opp.Stage</span>
        <span class="@ForecastBadge(_opp.ForecastCategory)">@_opp.ForecastCategory</span>
        <span class="od-chip"><i class="bi bi-person" aria-hidden="true"></i> @_opp.Owner</span>
        <span class="od-chip"><i class="bi bi-building" aria-hidden="true"></i> @_opp.AccountName</span>
        <span class="od-chip od-mono od-bold"><i class="bi bi-cash-coin" aria-hidden="true"></i> @_opp.Amount.ToString("C0")</span>
        <span class="od-chip">
            <i class="bi bi-calendar3" aria-hidden="true"></i>
            <span class="@(_opp.CloseDate < DateTime.UtcNow && _opp.Stage != "Closed Won" && _opp.Stage != "Closed Lost" ? "od-overdue" : "")">
                Close @_opp.CloseDate.ToString("d")
            </span>
        </span>
        <!-- Win probability gauge -->
        <div class="od-win-gauge">
            <div class="od-win-bar" style="width:@_opp.WinPct%;background:@WinColor(_opp.WinPct)"></div>
            <span class="od-win-label" style="color:@WinColor(_opp.WinPct)">@_opp.WinPct% win</span>
        </div>
    </div>

    <!-- Two-column layout -->
    <div class="od-layout">
        <div class="od-tabs-col">
            <div class="od-native-tabs" role="tablist" aria-label="Opportunity detail sections">
                @TabButton(0, "Overview", "bi-house")
                @TabButton(1, "Activities", "bi-lightning")
                @TabButton(2, "Submissions", "bi-send")
                @TabButton(3, "Quotes", "bi-file-text")
                @TabButton(4, "Documents", "bi-folder2")
                @TabButton(5, "Competitors", "bi-crosshair")
                @TabButton(6, "Workflow", "bi-diagram-3")
            </div>
            <div class="od-native-panels">
                @if (_tab == 0)
                {
                            <div class="od-tab-body">
                                <div class="od-info-card">
                                    <h3 class="od-section-hdr">Opportunity Details</h3>
                                    <div class="od-field-grid">
                                        @OField("Opportunity #",  _opp.OppNumber)
                                        @OField("Account",        _opp.AccountName)
                                        @OField("Stage",          _opp.Stage)
                                        @OField("Forecast",       _opp.ForecastCategory)
                                        @OField("Amount",         _opp.Amount.ToString("C0"))
                                        @OField("Win Probability",$"{_opp.WinPct}%")
                                        @OField("Close Date",     _opp.CloseDate.ToString("d"))
                                        @OField("Owner",          _opp.Owner)
                                        @OField("Source Lead",    _opp.SourceLead ?? "â€”")
                                        @OField("Campaign",       _opp.CampaignName ?? "â€”")
                                        @OField("Created",        _opp.CreatedAt.ToString("f"))
                                        @OField("Last Modified",  _opp.ModifiedAt?.ToString("f") ?? "â€”")
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(_opp.Description))
                                {
                                    <div class="od-info-card">
                                        <h3 class="od-section-hdr">Description</h3>
                                        <p class="od-notes">@_opp.Description</p>
                                    </div>
                                }
                                <div class="od-info-card">
                                    <h3 class="od-section-hdr">Lines of Interest</h3>
                                    @if (_lines.Count == 0)
                                    { <p class="od-empty-sm">No lines added yet.</p> }
                                    else
                                    {
                                        <div class="od-table-wrap"><table class="od-table"><thead><tr><th>Line</th><th>Carrier</th><th class="text-end">Est. Premium</th><th>Priority</th></tr></thead><tbody>
                                            @foreach (var l in _lines)
                                            {
                                                <tr><td data-label="Line">@l.LineOfBusiness</td><td data-label="Carrier">@(l.Carrier ?? "—")</td><td data-label="Est. Premium" class="text-end od-mono od-bold">@l.EstPremium.ToString("C0")</td><td data-label="Priority"><span class="@PriBadge(l.Priority)">@l.Priority</span></td></tr>
                                            }
                                        </tbody></table></div>
                                    }
                                </div>
                            </div>
                }

                @if (_tab == 1)
                {
                            <div class="od-tab-body">
                                <div class="od-tab-toolbar">
                                    <span class="od-tab-count">@_activities.Count activit@(_activities.Count == 1 ? "y" : "ies")</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenLogActivity"><i class="bi bi-plus-lg" aria-hidden="true"></i> Log</button>
                                </div>
                                @if (_activities.Count == 0) { @OEmpty("bi-lightning","No activities","Log calls, emails or meetings against this opportunity.") }
                                else
                                {
                                    <div class="od-timeline">
                                        @foreach (var a in _activities.OrderByDescending(x => x.OccurredAt))
                                        {
                                            <div class="od-tl-item">
                                                <div class="od-tl-icon @ActivityColor(a.Type)"><i class="bi @ActivityIcon(a.Type)" aria-hidden="true"></i></div>
                                                <div class="od-tl-body">
                                                    <div class="od-tl-hdr">
                                                        <span class="od-tl-type">@a.Type</span>
                                                        <span class="od-tl-by">@a.By</span>
                                                        <span class="od-mono od-muted">@a.OccurredAt.ToString("g")</span>
                                                    </div>
                                                    <div class="od-tl-subject">@a.Subject</div>
                                                    @if (!string.IsNullOrEmpty(a.Notes)) { <p class="od-tl-notes">@a.Notes</p> }
                                                    <div class="od-inline-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditActivity(a)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteActivity(a)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                                                </div>
                                            </div>
                                        }
                @if (_tab == 5)
                {
                    <div class="od-tab-body">
                        <div class="od-tab-toolbar">
                            <span class="od-tab-count">@_competitors.Count competitor(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenAddCompetitor"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add</button>
                        </div>
                        @if (_competitors.Count == 0) { @OEmpty("bi-crosshair", "No competitors", "Track competitive pressure and strength for win strategy.") }
                        else
                        {
                            <div class="od-competitor-grid">
                                @foreach (var c in _competitors)
                                {
                                    <article class="od-competitor-card">
                                        <div><strong>@c.Name</strong><span class="@CompBadge(c.Strength)">@c.Strength</span></div>
                                        <div class="od-row-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditCompetitor(c)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteCompetitor(c)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                }
                @if (_tab == 6)
                {
                    <div class="od-tab-body">
                        <div class="od-tab-toolbar"><span class="od-tab-count">@_workflowEvents.Count workflow event(s)</span></div>
                        @if (_workflowEvents.Count == 0) { @OEmpty("bi-diagram-3", "No workflow events", "Opportunity actions will appear here as they sync to related entities.") }
                        else
                        {
                            <div class="od-timeline">
                                @foreach (var e in _workflowEvents.OrderByDescending(x => x.EventDateUtc))
                                {
                                    <div class="od-tl-item"><div class="od-tl-icon od-tl-ic--workflow"><i class="bi @WorkflowIcon(e.EventType)" aria-hidden="true"></i></div><div class="od-tl-body"><div class="od-tl-hdr"><span class="od-tl-type">@e.EventType</span><span class="od-mono od-muted">@e.EventDateUtc.ToString("g")</span>@if (!string.IsNullOrWhiteSpace(e.RelatedEntityName)) { <span class="od-related-chip">@e.RelatedEntityName</span> }</div><div class="od-tl-subject">@e.EventTitle</div>@if (!string.IsNullOrWhiteSpace(e.EventDetail)) { <p class="od-tl-notes">@e.EventDetail</p> }</div></div>
                                }
                            </div>
                        }
                    </div>
                }
                                    </div>
                                }
                            </div>
                }

                @if (_tab == 2)
                {
                            <div class="od-tab-body">
                                <div class="od-tab-toolbar">
                                    <span class="od-tab-count">@_submissions.Count submission(s)</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenNewSubmission"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Submission</button>
                                </div>
                                @if (_submissions.Count == 0) { @OEmpty("bi-send","No submissions","Create underwriting submissions from this opportunity before requesting quotes.") }
                                else
                                {
                                    <div class="od-table-wrap"><table class="od-table"><thead><tr><th>Submission #</th><th>Line</th><th>Status</th><th class="text-end">Target Premium</th><th class="text-end">Quotes</th><th class="text-end">Actions</th></tr></thead><tbody>
                                        @foreach (var s in _submissions)
                                        {
                                            <tr><td data-label="Submission #" class="od-mono od-bold">@s.SubmissionNumber</td><td data-label="Line">@s.LineOfBusiness</td><td data-label="Status"><span class="@QSBadge(s.Status)">@s.Status</span></td><td data-label="Target Premium" class="text-end od-mono od-bold">@s.TargetPremium.ToString("C0")</td><td data-label="Quotes" class="text-end">@s.QuoteCount</td><td data-label="Actions" class="text-end"><div class="od-row-actions"><button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenSubmission(s.SubmissionId)"><i class="bi bi-arrow-right" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditSubmission(s)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteSubmission(s)"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td></tr>
                                        }
                                    </tbody></table></div>
                                }
                            </div>
                }

                @if (_tab == 3)
                {
                            <div class="od-tab-body">
                                <div class="od-tab-toolbar">
                                    <span class="od-tab-count">@_quotes.Count quote(s)</span>
                                </div>
                                @if (_quotes.Count == 0) { @OEmpty("bi-file-text","No quotes","Quotes are created downstream from submissions.") }
                                else
                                {
                                    <div class="od-table-wrap"><table class="od-table"><thead><tr><th>Quote #</th><th>Carrier</th><th>Status</th><th class="text-end">Premium</th><th>Expires</th></tr></thead><tbody>
                                        @foreach (var q in _quotes)
                                        {
                                            <tr><td data-label="Quote #" class="od-mono od-bold">@q.QuoteNumber</td><td data-label="Carrier">@(string.IsNullOrWhiteSpace(q.Carrier) ? "—" : q.Carrier)</td><td data-label="Status"><span class="@QSBadge(q.Status)">@q.Status</span></td><td data-label="Premium" class="text-end od-mono od-bold">@q.Premium.ToString("C0")</td><td data-label="Expires" class="od-mono">@q.ExpiresAt.ToString("d")</td></tr>
                                        }
                                    </tbody></table></div>
                                }
                            </div>
                }

                @if (_tab == 4)
                {
                            <div class="od-tab-body">
                                <div class="od-tab-toolbar">
                                    <span class="od-tab-count">@_documents.Count document(s)</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showUpload = true"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Upload</button>
                                </div>
                                @if (_documents.Count == 0) { @OEmpty("bi-folder2","No documents","Attach proposals, carrier submissions or correspondence.") }
                                else
                                {
                                    <div class="od-table-wrap"><table class="od-table"><thead><tr><th>File</th><th>Category</th><th class="text-end">Size</th><th>Uploaded By</th><th>Date</th><th class="text-end">Actions</th></tr></thead><tbody>
                                        @foreach (var d in _documents)
                                        {
                                            <tr><td data-label="File"><span class="od-doc-name"><i class="bi @DocIcon(d.Extension)" aria-hidden="true"></i> @d.FileName</span></td><td data-label="Category">@d.Category</td><td data-label="Size" class="text-end od-mono">@d.SizeKb KB</td><td data-label="Uploaded By">@d.UploadedBy</td><td data-label="Date" class="od-mono">@d.UploadedAt.ToString("d")</td><td data-label="Actions" class="text-end"><div class="od-row-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => DownloadDocumentAsync(d)"><i class="bi bi-download" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteDocument(d)"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td></tr>
                                        }
                                    </tbody></table></div>
                                }
                            </div>
                }
            </div>
        </div>

        <!-- Right panel -->
        <aside class="od-right-panel">
            <!-- Stage progress -->
            <div class="od-panel-card">
                <div class="od-panel-hdr"><i class="bi bi-signpost-2 od-pi--stage" aria-hidden="true"></i><span class="od-panel-title">Stage Progress</span></div>
                <div class="od-stage-steps">
                    @foreach (var st in _stageSteps)
                    {
                        var done = StageOrder(st) < StageOrder(_opp.Stage) || st == _opp.Stage;
                        var cur  = st == _opp.Stage;
                        <div class="od-ss-row @(cur ? "od-ss--cur" : done ? "od-ss--done" : "")">
                            <div class="od-ss-dot @(cur ? "od-ss-dot--cur" : done ? "od-ss-dot--done" : "")">
                                @if (done && !cur) { <i class="bi bi-check-lg" aria-hidden="true"></i> }
                                else if (cur)      { <i class="bi bi-circle-fill" style="font-size:.45rem" aria-hidden="true"></i> }
                            </div>
                            <span class="od-ss-label">@st</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Key metrics -->
            <div class="od-panel-card">
                <div class="od-panel-hdr"><i class="bi bi-bar-chart-steps od-pi--metric" aria-hidden="true"></i><span class="od-panel-title">Key Metrics</span></div>
                <div class="od-metric-list">
                    @OMetric("Amount",        _opp.Amount.ToString("C0"),            "bi-cash-coin")
                    @OMetric("Weighted",      (_opp.Amount * (decimal)_opp.WinPct / 100).ToString("C0"), "bi-graph-up")
                    @OMetric("Days Open",     ((int)(DateTime.UtcNow - _opp.CreatedAt).TotalDays).ToString(), "bi-clock")
                    @OMetric("Days to Close", Math.Max(0,(int)(_opp.CloseDate - DateTime.UtcNow).TotalDays).ToString(), "bi-calendar-check")
                    @OMetric("Activities",    _activities.Count.ToString(), "bi-lightning")
                    @OMetric("Submissions",   _submissions.Count.ToString(),"bi-send")
                    @OMetric("Quotes",        _quotes.Count.ToString(),     "bi-file-text")
                </div>
            </div>

            <!-- Competitor intel -->
            <div class="od-panel-card">
                <div class="od-panel-hdr"><i class="bi bi-crosshair od-pi--comp" aria-hidden="true"></i><span class="od-panel-title">Competitors</span></div>
                @if (_competitors.Count == 0) { <p class="od-panel-empty">No competitors tracked.</p> }
                else
                {
                    <div class="od-comp-list">
                        @foreach (var c in _competitors)
                        {
                            <div class="od-comp-row">
                                <span class="od-comp-name">@c.Name</span>
                                <span class="@CompBadge(c.Strength)">@c.Strength</span>
                                <span class="od-compact-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditCompetitor(c)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteCompetitor(c)"><i class="bi bi-trash" aria-hidden="true"></i></button></span>
                            </div>
                        }
                    </div>
                }
                <button class="um-btn um-btn-ghost um-btn-sm od-add-btn" @onclick="OpenAddCompetitor"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add</button>
            </div>
        </aside>
    </div>
    </div>
}

<!-- Edit Opportunity dialog -->
@if (_showEdit)
{
    <div class="od-modal-backdrop" role="presentation" @onclick="() => _showEdit = false"><div class="od-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
        <div class="um-modal-header"><i class="bi bi-trophy" aria-hidden="true"></i><span>Edit Opportunity</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showEdit = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        <EditForm Model="_editForm" OnValidSubmit="SaveOpportunityAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field um-field--full"><label>Opportunity Name <span class="text-danger">*</span></label><InputText @bind-Value="_editForm.Name" class="um-input" /></div>
                <div class="um-field"><label>Account Name <span class="text-danger">*</span></label><InputText @bind-Value="_editForm.AccountName" class="um-input" /></div>
                <div class="um-field"><label>Stage <span class="text-danger">*</span></label><InputSelect @bind-Value="_editForm.Stage" class="um-input">@foreach (var option in _stageOpts) { <option value="@option.Value">@option.Label</option> }</InputSelect></div>
                <div class="um-field"><label>Forecast <span class="text-danger">*</span></label><InputSelect @bind-Value="_editForm.ForecastCategory" class="um-input"><option value="Pipeline">Pipeline</option><option value="Best Case">Best Case</option><option value="Commit">Commit</option><option value="Closed">Closed</option></InputSelect></div>
                <div class="um-field"><label>Amount</label><InputNumber @bind-Value="_editForm.Amount" class="um-input" /></div>
                <div class="um-field"><label>Win Probability</label><InputNumber @bind-Value="_editForm.WinPct" class="um-input" /></div>
                <div class="um-field"><label>Close Date <span class="text-danger">*</span></label><InputDate @bind-Value="_editForm.CloseDate" class="um-input" /></div>
                <div class="um-field um-field--full"><label>Description</label><InputTextArea @bind-Value="_editForm.Description" class="um-input" rows="4" /></div>
            </div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showEdit = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_savingAction"><i class="bi bi-check-lg" aria-hidden="true"></i> Save Changes</button></div>
        </EditForm>
    </div></div>
}

<!-- Log/Edit Activity dialog -->
@if (_showLogActivity)
{
    <div class="od-modal-backdrop" role="presentation" @onclick="CloseActivityDialog"><div class="od-modal od-modal-sm" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
        <div class="um-modal-header"><i class="bi bi-lightning" aria-hidden="true"></i><span>@(_editingActivity is null ? "Log Activity" : "Edit Activity")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseActivityDialog"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        <EditForm Model="_activityForm" OnValidSubmit="CommitActivityAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field"><label>Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_activityForm.Type" class="um-input">@foreach (var option in _actTypes) { <option value="@option.Value">@option.Label</option> }</InputSelect></div>
                <div class="um-field"><label>Date <span class="text-danger">*</span></label><InputDate @bind-Value="_activityForm.OccurredAt" class="um-input" /></div>
                <div class="um-field um-field--full"><label>Subject <span class="text-danger">*</span></label><InputText @bind-Value="_activityForm.Subject" class="um-input" /></div>
                <div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_activityForm.Notes" class="um-input" rows="3" /></div>
            </div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseActivityDialog">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_savingAction"><i class="bi bi-check-lg" aria-hidden="true"></i> Save</button></div>
        </EditForm>
    </div></div>
}

<!-- Move Stage dialog -->
@if (_showStage)
{
    <div class="od-modal-backdrop" role="presentation" @onclick="() => _showStage = false"><div class="od-modal od-modal-xs" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
        <div class="um-modal-header"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i><span>Move Stage</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showStage = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        <EditForm Model="_stageForm" OnValidSubmit="CommitStageAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid"><div class="um-field um-field--full"><label>Target Stage <span class="text-danger">*</span></label><InputSelect @bind-Value="_stageForm.Stage" class="um-input"><option value="">Select stage</option>@foreach (var option in _stageOpts) { <option value="@option.Value">@option.Label</option> }</InputSelect></div></div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showStage = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_savingAction"><i class="bi bi-check-lg" aria-hidden="true"></i> Move</button></div>
        </EditForm>
    </div></div>
}

<!-- Mark Won confirmation -->
@if (_showWon)
{
    <div class="od-modal-backdrop" role="presentation" @onclick="() => _showWon = false"><div class="od-confirm-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
        <div class="um-confirm-dialog">
            <div class="um-confirm-icon"><i class="bi bi-trophy-fill" aria-hidden="true"></i></div>
            <div class="um-confirm-title">Mark as Closed Won</div>
            <div class="um-confirm-body">Mark <strong>@(_opp?.Name)</strong> as Closed Won with amount <strong>@(_opp?.Amount.ToString("C0"))</strong>?</div>
            <label class="od-toggle-label"><InputCheckbox @bind-Value="_wonForm.CreatePolicy" /> Create bound policy record</label>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showWon = false">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="CommitWonAsync" disabled="@_savingAction"><i class="bi bi-check2-circle" aria-hidden="true"></i> Confirm Won</button></div>
        </div>
    </div></div>
}

<!-- Upload doc dialog -->
@if (_showUpload)
{
    <div class="od-modal-backdrop" role="presentation" @onclick="() => _showUpload = false"><div class="od-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
        <div class="um-modal-header">
            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i>
            <span>Upload Opportunity Document</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showUpload = false" aria-label="Close"><i class="bi bi-x-lg"></i></button>
        </div>
        <EditForm Model="_uploadForm" OnValidSubmit="CommitUploadDocumentAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="um-field um-field--full">
                        <label>Category <span class="text-danger">*</span></label>
                        <InputSelect class="um-input" @bind-Value="_uploadForm.Category">
                            <option value="">Select categoryâ€¦</option>
                            @foreach (var category in _docCats)
                            {
                                <option value="@category.Value">@category.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="um-field um-field--full">
                        <label>Document File <span class="text-danger">*</span></label>
                        <InputFile class="um-input" OnChange="OnOpportunityDocumentSelected" accept=".pdf,.doc,.docx,.xls,.xlsx,.csv,.png,.jpg,.jpeg,.tif,.tiff" />
                        @if (_selectedUploadFile is not null)
                        {
                            <div class="text-muted mt-1">
                                <i class="bi bi-paperclip" aria-hidden="true"></i>
                                @_selectedUploadFile.Name Â· @FormatFileSize(_selectedUploadFile.Size) Â· @(_selectedUploadFile.ContentType ?? "application/octet-stream")
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_uploadFileError))
                        {
                            <div class="text-danger">@_uploadFileError</div>
                        }
                    </div>
                    <div class="um-field">
                        <label>Document Name <span class="text-danger">*</span></label>
                        <InputText class="um-input" @bind-Value="_uploadForm.FileName" placeholder="Auto-filled from selected file" />
                    </div>
                    <div class="um-field">
                        <label>Uploaded By</label>
                        <div class="um-input d-flex align-items-center text-muted">
                            <i class="bi bi-person-check me-2" aria-hidden="true"></i>
                            @_uploadedByName
                        </div>
                    </div>
                    <div class="um-field um-field--full">
                        <label>Storage</label>
                        <div class="um-input d-flex align-items-center text-muted">
                            <i class="bi bi-cloud-arrow-up me-2" aria-hidden="true"></i>
                            Stored securely after upload
                        </div>
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showUpload = false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_savingUpload">
                    @if (_savingUpload) { <span class="um-spinner-sm"></span> } Upload
                </button>
            </div>
        </EditForm>
    </div></div>
}

<!-- Add/Edit competitor dialog -->
@if (_showAddComp)
{
    <div class="od-modal-backdrop" role="presentation" @onclick="CloseCompetitorDialog"><div class="od-modal od-modal-xs" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
        <div class="um-modal-header"><i class="bi bi-crosshair" aria-hidden="true"></i><span>@(_editingCompetitor is null ? "Add Competitor" : "Edit Competitor")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseCompetitorDialog"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        <EditForm Model="_competitorForm" OnValidSubmit="CommitAddCompAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid"><div class="um-field um-field--full"><label>Competitor Name <span class="text-danger">*</span></label><InputText @bind-Value="_competitorForm.Name" class="um-input" /></div><div class="um-field um-field--full"><label>Strength <span class="text-danger">*</span></label><InputSelect @bind-Value="_competitorForm.Strength" class="um-input">@foreach (var option in _compStrengths) { <option value="@option.Value">@option.Label</option> }</InputSelect></div></div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseCompetitorDialog">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_savingAction"><i class="bi bi-check-lg" aria-hidden="true"></i> @(_editingCompetitor is null ? "Add" : "Save")</button></div>
        </EditForm>
    </div></div>
}

<!-- New/Edit Submission dialog -->
@if (_showSubmission)
{
    <div class="od-modal-backdrop" role="presentation" @onclick="CloseSubmissionDialog"><div class="od-modal od-modal-sm" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
        <div class="um-modal-header"><i class="bi bi-send" aria-hidden="true"></i><span>@(_editingSubmission is null ? "New Submission" : "Edit Submission")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseSubmissionDialog"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
        <EditForm Model="_submissionForm" OnValidSubmit="CommitSubmissionAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field"><label>Line of Business <span class="text-danger">*</span></label><InputText @bind-Value="_submissionForm.LineOfBusiness" class="um-input" /></div>
                <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_submissionForm.Status" class="um-input"><option value="Draft">Draft</option><option value="In Review">In Review</option><option value="Quoted">Quoted</option><option value="Bound">Bound</option><option value="Declined">Declined</option></InputSelect></div>
                <div class="um-field"><label>Target Premium</label><InputNumber @bind-Value="_submissionForm.TargetPremium" class="um-input" /></div>
            </div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseSubmissionDialog">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_savingAction"><i class="bi bi-check-lg" aria-hidden="true"></i> @(_editingSubmission is null ? "Create" : "Save")</button></div>
        </EditForm>
    </div></div>
}

@if (_showDeleteConfirm)
{
    <div class="od-modal-backdrop" role="presentation" @onclick="() => _showDeleteConfirm = false"><div class="od-confirm-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
        <div class="um-confirm-dialog">
            <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash3-fill" aria-hidden="true"></i></div>
            <div class="um-confirm-title">@_deleteTitle</div>
            <div class="um-confirm-body">@_deleteMessage</div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showDeleteConfirm = false">Cancel</button><button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_savingAction">Delete</button></div>
        </div>
    </div></div>
}

@code {
    [Parameter] public Guid OpportunityId { get; set; }

    private bool     _loading = true;
    private int      _tab     = 0;
    private OppDetailModel? _opp;
    private Guid _tenantId;
    private Guid? _currentUserId;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string _activeKpi = "overview";

    private List<OppLine>    _lines       = [];
    private List<ActivityRow> _activities = [];
    private List<SubmissionRow> _submissions = [];
    private List<QuoteRow>   _quotes      = [];
    private List<DocRow>     _documents   = [];
    private List<CompetitorRow> _competitors = [];
    private List<WorkflowEventRow> _workflowEvents = [];

    private bool   _showEdit        = false;
    private bool   _showStage       = false;
    private bool   _showWon         = false;
    private bool   _showLogActivity = false;
    private bool   _showUpload      = false;
    private bool   _showAddComp     = false;
    private bool   _showDeleteConfirm = false;
    private bool   _showSubmission = false;

    private OpportunityEditForm _editForm = new();
    private StageMoveForm _stageForm = new();
    private WonForm _wonForm = new();
    private ActivityForm _activityForm = new();
    private CompetitorForm _competitorForm = new();
    private SubmissionForm _submissionForm = new();
    private ActivityRow? _editingActivity;
    private CompetitorRow? _editingCompetitor;
    private SubmissionRow? _editingSubmission;
    private string        _deleteTitle = string.Empty;
    private string        _deleteMessage = string.Empty;
    private Func<Task>?   _confirmDeleteAction;
    private bool          _savingAction;
    private bool          _wonCreatePolicy = true;
    private UploadDocumentForm _uploadForm = new();
    private IBrowserFile? _selectedUploadFile;
    private string? _uploadFileError;
    private string _uploadedByName = "Current user";
    private bool _savingUpload;
    private const long MaxUploadBytes = 104_857_600;
    private static readonly HashSet<string> AllowedUploadExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".csv", ".png", ".jpg", ".jpeg", ".tif", ".tiff"
    };
    private static readonly List<LV> _actTypes    = [new("Call","Call"),new("Email","Email"),new("Meeting","Meeting"),new("Note","Note"),new("Task","Task")];
    private static readonly List<LV> _stageOpts   = [new("Qualification","Qualification"),new("Needs Analysis","Needs Analysis"),new("Proposal","Proposal"),new("Negotiation","Negotiation"),new("Closed Won","Closed Won"),new("Closed Lost","Closed Lost")];
    private static readonly List<LV> _docCats     = [new("Proposal","Proposal"),new("Carrier Sub","Carrier Submission"),new("Financials","Financials"),new("Correspondence","Correspondence"),new("Other","Other")];
    private static readonly List<LV> _compStrengths = [new("Strong","Strong"),new("Moderate","Moderate"),new("Weak","Weak")];
    private static readonly string[] _stageSteps  = ["Qualification","Needs Analysis","Proposal","Negotiation","Closed Won"];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            var detail = await Api.GetOpportunityDetailAsync(OpportunityId);
            if (detail is null)
            {
                _opp = null;
                return;
            }

            _opp = MapOpportunity(detail.Opportunity);
            _lines = detail.Lines.Select(MapLine).ToList();
            _activities = detail.Activities.Select(MapActivity).ToList();
            _submissions = detail.Submissions.Select(MapSubmission).ToList();
            _quotes = detail.Quotes.Select(MapQuote).ToList();
            _competitors = detail.Competitors.Select(MapCompetitor).ToList();
            _workflowEvents = detail.WorkflowEvents.Select(MapWorkflowEvent).ToList();
            await LoadOpportunityDocumentsAsync();

            Breadcrumbs.SetCrumbs(
                new("Home","/"), new("CRM","/crm/opportunities"),
                new("Opportunities","/crm/opportunities"),
                new(_opp.Name, $"/crm/opportunities/{OpportunityId}"));
        }
        catch (Exception ex)
        {
            _opp = null;
            await ShowToast($"Failed to load opportunity: {ex.Message}", "e-toast-danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CommitActivityAsync()
    {
        var isNew = _editingActivity is null;
        await Api.UpsertOpportunityActivityAsync(OpportunityId, new UpsertOpportunityActivityRequest
        {
            ActivityId = _editingActivity?.ActivityId,
            TenantId = _tenantId,
            OpportunityId = OpportunityId,
            ActivityTypeCode = _activityForm.Type,
            Subject = Normalize(_activityForm.Subject) ?? string.Empty,
            Notes = Normalize(_activityForm.Notes),
            ActivityDate = _activityForm.OccurredAt,
            UserId = _currentUserId
        });
        CloseActivityDialog();
        await LoadAsync();
        await ShowToast(isNew ? "Activity logged." : "Activity updated.");
    }
    private async Task CommitStageAsync()
    {
        await Api.UpdateOpportunityStageAsync(OpportunityId, new UpdateOpportunityStageRequest { Stage = _stageForm.Stage, ModifiedByUserId = _currentUserId });
        _showStage = false; _stageForm = new();
        await LoadAsync();
        await ShowToast("Stage updated.");
    }
    private async Task CommitWonAsync()
    {
        await Api.UpdateOpportunityStageAsync(OpportunityId, new UpdateOpportunityStageRequest { Stage = "Closed Won", ModifiedByUserId = _currentUserId });
        _showWon = false;
        await LoadAsync();
        await ShowToast(_wonForm.CreatePolicy ? "Opportunity marked Closed Won. Policy creation queued." : "Opportunity marked Closed Won.");
    }
    private async Task CommitAddCompAsync()
    {
        var isNew = _editingCompetitor is null;
        await Api.UpsertOpportunityCompetitorAsync(OpportunityId, new UpsertOpportunityCompetitorRequest
        {
            CompetitorId = _editingCompetitor?.CompetitorId,
            TenantId = _tenantId,
            OpportunityId = OpportunityId,
            Name = Normalize(_competitorForm.Name) ?? string.Empty,
            Strength = Normalize(_competitorForm.Strength) ?? "Moderate",
            UserId = _currentUserId
        });
        CloseCompetitorDialog();
        await LoadAsync();
        await ShowToast(isNew ? "Competitor added." : "Competitor updated.");
    }

    private async Task SaveOpportunityAsync()
    {
        if (_opp is null) return;
        await Api.UpdateOpportunityAsync(OpportunityId, new UpdateOpportunityRequest
        {
            OpportunityName = Normalize(_editForm.Name) ?? string.Empty,
            StageName = _editForm.Stage,
            ForecastCategoryCode = _editForm.ForecastCategory,
            EstimatedAmount = _editForm.Amount,
            WinProbability = _editForm.WinPct,
            CloseDate = _editForm.CloseDate,
            Description = Normalize(_editForm.Description),
            ModifiedByUserId = _currentUserId
        });
        _showEdit = false;
        await LoadAsync();
        await ShowToast("Opportunity updated.");
    }

    private void OnOpportunityDocumentSelected(InputFileChangeEventArgs args)
    {
        _uploadFileError = null;
        _selectedUploadFile = args.File;

        var extension = Path.GetExtension(_selectedUploadFile.Name);
        if (!AllowedUploadExtensions.Contains(extension))
        {
            _uploadFileError = "Select a supported document type: PDF, Word, Excel, CSV, image, or TIFF.";
            _selectedUploadFile = null;
            return;
        }

        if (_selectedUploadFile.Size > MaxUploadBytes)
        {
            _uploadFileError = "The selected file is larger than the 100 MB upload limit.";
            _selectedUploadFile = null;
            return;
        }

        _uploadForm.FileName = _selectedUploadFile.Name;
        _uploadForm.Extension = extension;
        _uploadForm.SizeKb = ToSizeKb(_selectedUploadFile.Size);
    }

    private async Task CommitUploadDocumentAsync()
    {
        if (_opp is null) return;

        if (_selectedUploadFile is null)
        {
            _uploadFileError = "Select a document file to upload.";
            return;
        }

        _savingUpload = true;
        try
        {
            await using var stream = _selectedUploadFile.OpenReadStream(MaxUploadBytes);
            await Api.UploadDocumentAsync(new ApiClient.UploadDocumentRequest
            {
                TenantId = _tenantId,
                DocumentTypeCode = _uploadForm.Category,
                CategoryCode = _uploadForm.Category,
                FileName = _uploadForm.FileName,
                OriginalFileName = _selectedUploadFile.Name,
                EntityName = "Opportunity",
                EntityId = OpportunityId,
                Tags = "opportunity",
                UploadedByName = _uploadedByName,
                CreatedByUserId = _currentUserId,
                Content = stream
            });

            _showUpload = false;
            ResetUpload();
            await LoadOpportunityDocumentsAsync();
            await ShowToast("Document uploaded successfully.");
        }
        catch (Exception ex)
        {
            await ShowToast($"Document upload failed: {ex.Message}", "e-toast-danger");
        }
        finally
        {
            _savingUpload = false;
        }
    }

    private void ResetUpload()
    {
        _uploadForm = new();
        _selectedUploadFile = null;
        _uploadFileError = null;
    }

    private void CreateSubmission()
    {
        if (_opp is null) return;
        Nav.NavigateTo($"/submissions/new?opportunityId={OpportunityId}&accountName={Uri.EscapeDataString(_opp.AccountName)}");
    }

    private void OpenSubmission(Guid submissionId) => Nav.NavigateTo($"/submissions/{submissionId}");

    private void OpenEditOpportunity()
    {
        if (_opp is null) return;
        _editForm = new()
        {
            Name = _opp.Name,
            AccountName = _opp.AccountName,
            Stage = _opp.Stage,
            ForecastCategory = _opp.ForecastCategory,
            Amount = _opp.Amount,
            WinPct = _opp.WinPct,
            CloseDate = _opp.CloseDate,
            Description = _opp.Description
        };
        _showEdit = true;
    }

    private void OpenStageDialog() { _stageForm = new() { Stage = _opp?.Stage ?? string.Empty }; _showStage = true; }
    private void OpenStageDialog(string stage) { _stageForm = new() { Stage = stage }; _showStage = true; }
    private void OpenWonDialog() { _wonForm = new() { CreatePolicy = true }; _showWon = true; }
    private void OpenLogActivity() { _editingActivity = null; _activityForm = new() { Type = "Call", OccurredAt = DateTime.UtcNow }; _showLogActivity = true; }
    private void OpenEditActivity(ActivityRow row) { _editingActivity = row; _activityForm = new() { Type = row.Type, Subject = row.Subject, Notes = row.Notes, OccurredAt = row.OccurredAt }; _showLogActivity = true; }
    private void CloseActivityDialog() { _showLogActivity = false; _editingActivity = null; _activityForm = new(); }
    private void OpenAddCompetitor() { _editingCompetitor = null; _competitorForm = new() { Strength = "Moderate" }; _showAddComp = true; }
    private void OpenEditCompetitor(CompetitorRow row) { _editingCompetitor = row; _competitorForm = new() { Name = row.Name, Strength = row.Strength }; _showAddComp = true; }
    private void CloseCompetitorDialog() { _showAddComp = false; _editingCompetitor = null; _competitorForm = new(); }
    private void OpenNewSubmission() { _editingSubmission = null; _submissionForm = new() { Status = "Draft" }; _showSubmission = true; }
    private void OpenEditSubmission(SubmissionRow row) { _editingSubmission = row; _submissionForm = new() { LineOfBusiness = row.LineOfBusiness, Status = row.Status, TargetPremium = row.TargetPremium }; _showSubmission = true; }
    private void CloseSubmissionDialog() { _showSubmission = false; _editingSubmission = null; _submissionForm = new(); }

    private async Task CommitSubmissionAsync()
    {
        var isNew = _editingSubmission is null;
        await Api.UpsertOpportunitySubmissionAsync(OpportunityId, new UpsertOpportunitySubmissionRequest
        {
            SubmissionId = _editingSubmission?.SubmissionId,
            TenantId = _tenantId,
            OpportunityId = OpportunityId,
            SubmissionNumber = _editingSubmission?.SubmissionNumber,
            LineOfBusiness = Normalize(_submissionForm.LineOfBusiness) ?? string.Empty,
            Status = _submissionForm.Status,
            TargetPremium = _submissionForm.TargetPremium,
            UserId = _currentUserId
        });
        CloseSubmissionDialog();
        await LoadAsync();
        await ShowToast(isNew ? "Submission created." : "Submission updated.");
    }

    private void ConfirmDeleteActivity(ActivityRow row) => ConfirmDelete("Delete Activity", $"Delete activity {row.Subject}?", async () => { await Api.DeleteOpportunityActivityAsync(row.ActivityId, _currentUserId); await LoadAsync(); await ShowToast("Activity deleted."); });
    private void ConfirmDeleteSubmission(SubmissionRow row) => ConfirmDelete("Delete Submission", $"Delete submission {row.SubmissionNumber}?", async () => { await Api.DeleteOpportunitySubmissionAsync(row.SubmissionId, _currentUserId); await LoadAsync(); await ShowToast("Submission deleted."); });
    private void ConfirmDeleteDocument(DocRow row) => ConfirmDelete("Delete Document", $"Delete document {row.FileName}?", async () => { await Api.DeleteDocumentAsync(row.DocumentId, _currentUserId); await LoadOpportunityDocumentsAsync(); await ShowToast("Document deleted."); });
    private void ConfirmDeleteCompetitor(CompetitorRow row) => ConfirmDelete("Delete Competitor", $"Delete competitor {row.Name}?", async () => { await Api.DeleteOpportunityCompetitorAsync(row.CompetitorId, _currentUserId); await LoadAsync(); await ShowToast("Competitor deleted."); });
    private Task DownloadDocumentAsync(DocRow row)
    {
        Nav.NavigateTo(Api.GetDocumentDownloadUrl(row.DocumentId), forceLoad: true);
        return Task.CompletedTask;
    }

    private void ConfirmDelete(string title, string message, Func<Task> action)
    {
        _deleteTitle = title;
        _deleteMessage = message;
        _confirmDeleteAction = action;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_confirmDeleteAction is null) return;
        _savingAction = true;
        try
        {
            await _confirmDeleteAction.Invoke();
            _showDeleteConfirm = false;
        }
        catch (Exception ex)
        {
            await ShowToast($"Delete failed: {ex.Message}", "e-toast-danger");
        }
        finally
        {
            _savingAction = false;
            _confirmDeleteAction = null;
        }
    }

    private async Task ShowToast(string content, string cssClass = "e-toast-success")
    {
        _toastMessage = content;
        _toastKind = cssClass.Contains("danger", StringComparison.OrdinalIgnoreCase) ? "danger" : "success";
        _toastVisible = true;
        await InvokeAsync(StateHasChanged);
    }

    private void HideToast() => _toastVisible = false;

    private string ToastIconClass => _toastKind == "danger" ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill";

    private decimal WeightedAmount => _opp is null ? 0 : _opp.Amount * _opp.WinPct / 100m;

    private int DaysOpen => _opp is null ? 0 : Math.Max(0, (int)(DateTime.UtcNow - _opp.CreatedAt).TotalDays);

    private int DaysToClose => _opp is null ? 0 : Math.Max(0, (int)(_opp.CloseDate - DateTime.UtcNow).TotalDays);

    private string RecentActivityText => _activities.Count == 0
        ? "No recent activity"
        : _activities.OrderByDescending(x => x.OccurredAt).First().OccurredAt.ToString("MMM d");

    private string KpiClass(string key) => _activeKpi == key ? "od-kpi-card od-kpi-card-active" : "od-kpi-card";

    private void ActivateKpi(string key, int tab)
    {
        _activeKpi = key;
        _tab = tab;
    }

