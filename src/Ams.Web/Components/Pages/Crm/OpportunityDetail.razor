    private static string StageBadge(string s) => s switch
    {
        "Qualification" => "op-stage op-stage--qual", "Needs Analysis" => "op-stage op-stage--needs",
        "Proposal"      => "op-stage op-stage--prop", "Negotiation"    => "op-stage op-stage--neg",
        "Closed Won"    => "op-stage op-stage--won",  "Closed Lost"    => "op-stage op-stage--lost",
        _               => "op-stage",
    };
    private static string ForecastBadge(string f) => f switch
    {
        "Commit" => "op-fc op-fc--commit","Best Case" => "op-fc op-fc--best",
        "Closed" => "op-fc op-fc--closed", _ => "op-fc op-fc--pipeline",
    };
    private static string PriBadge(string p) => p switch { "High" => "ld-pri ld-pri--high","Medium" => "ld-pri ld-pri--normal",_ => "ld-pri ld-pri--low" };
    private static string QSBadge(string s)  => s switch { "Approved" => "ld-status ld-status--approved","Rejected" => "ld-status ld-status--rejected","Pending" => "ld-status ld-status--pending",_ => "ld-status ld-status--open" };
    private static string CompBadge(string s) => s switch { "Strong" => "od-comp-badge od-cb--strong","Weak" => "od-comp-badge od-cb--weak",_ => "od-comp-badge od-cb--mid" };
    private static string PolicyStatusBadge(string s) => string.Equals(s, "Active", StringComparison.OrdinalIgnoreCase) || string.Equals(s, "Bound", StringComparison.OrdinalIgnoreCase) || string.Equals(s, "In Force", StringComparison.OrdinalIgnoreCase) ? "ld-status ld-status--approved" : string.Equals(s, "Expired", StringComparison.OrdinalIgnoreCase) || string.Equals(s, "Cancelled", StringComparison.OrdinalIgnoreCase) ? "ld-status ld-status--rejected" : "ld-status ld-status--open";
    private static string PolicyExpirationClass(CurrentPolicyRow policy) => policy.DaysToExpiration < 0 ? "od-policy-exp od-policy-exp--expired" : policy.DaysToExpiration <= 30 ? "od-policy-exp od-policy-exp--urgent" : policy.DaysToExpiration <= 90 ? "od-policy-exp od-policy-exp--soon" : "od-policy-exp";
    private static string PolicyExpirationText(CurrentPolicyRow policy) => policy.DaysToExpiration < 0 ? $"Expired {Math.Abs(policy.DaysToExpiration)} day(s) ago" : policy.DaysToExpiration == 0 ? "Expires today" : $"{policy.DaysToExpiration} day(s) to expiration";
    private static string ActivityIcon(string t) => t switch { "Call"=>"bi-telephone","Email"=>"bi-envelope","Meeting"=>"bi-calendar3","Note"=>"bi-sticky","Task"=>"bi-check2-square",_=>"bi-lightning" };
    private static string ActivityColor(string t) => t switch { "Call"=>"od-tl-ic--call","Email"=>"od-tl-ic--email","Meeting"=>"od-tl-ic--meeting","Note"=>"od-tl-ic--note",_=>"od-tl-ic--other" };
    private static string WorkflowIcon(string t) => t switch { "Created"=>"bi-plus-circle","Updated"=>"bi-pencil-square","Stage"=>"bi-arrow-right-circle","Submission" or "SubmissionUpdated"=>"bi-send","Quote"=>"bi-file-text","Activity" or "ActivityUpdated"=>"bi-lightning","Competitor" or "CompetitorUpdated"=>"bi-crosshair",_=>"bi-diagram-3" };
    private static string DocIcon(string ext) => ext.ToLower() switch { ".pdf"=>"bi-file-earmark-pdf",".docx"=>"bi-file-earmark-word",".xlsx"=>"bi-file-earmark-excel",_=>"bi-file-earmark" };
    private static string WinColor(int p) => p >= 70 ? "#16a34a" : p >= 40 ? "#b45309" : "#dc2626";
    private int StageOrder(string stage)
    {
        var index = StageOptions.ToList().FindIndex(s => string.Equals(s, stage, StringComparison.OrdinalIgnoreCase));
        return index < 0 ? int.MaxValue : index;
    }
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToString("d") : "Not set";
    private static int ToSizeKb(long bytes) => Math.Max(1, (int)Math.Ceiling(bytes / 1024.0));
    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F1} GB";
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _currentUserId = context.UserId;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _uploadedByName = user.FindFirst(ClaimTypes.Name)?.Value
            ?? user.FindFirst("user_name")?.Value
            ?? user.FindFirst(ClaimTypes.Email)?.Value
            ?? "Current user";
    }

