    private static IEnumerable<T> FilterBy<T>(IEnumerable<T> source, string search, params Func<T, string?>[] selectors)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return source;
        }

        var term = search.Trim();
        return source.Where(item => selectors.Any(selector => (selector(item) ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase)));
    }

