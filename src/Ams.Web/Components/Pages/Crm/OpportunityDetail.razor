        WinPct = (int)Math.Round(dto.WinProbability),
        Owner = dto.OwnerName ?? "Unassigned",
        CloseDate = dto.CloseDate ?? DateTime.UtcNow,
        CreatedAt = dto.CreatedDateUtc == default ? DateTime.UtcNow : dto.CreatedDateUtc,
        ModifiedAt = dto.ModifiedDateUtc,
        Description = dto.Description,
        SourceLead = dto.SourceLead
    };

