    private async Task SubmitSubmissionFormAsync()
    {
        if (_editingSubmission is null)
        {
            var selectedLines = _lines.Where(l => _submissionForm.OpportunityLineIds.Contains(l.OpportunityLineId)).ToList();
            if (selectedLines.Count == 0)
            {
                await ShowToast("Select at least one coverage line for the submission.", "enterprise-toast-danger");
