    private static string? Normalize(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task LoadOpportunityDocumentsAsync()
    {
        var docs = await Api.GetDocumentsByEntityAsync(_tenantId, "Opportunity", OpportunityId) ?? [];
        _documents = docs.Select(MapDocument).ToList();
    }

    private static OppDetailModel MapOpportunity(OpportunityDto dto) => new()
    {
