@code {
    [Parameter] public Guid OpportunityId { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? LaunchSource { get; set; }

    [SupplyParameterFromQuery(Name = "conversionId")]
    public Guid? LaunchConversionId { get; set; }

    [SupplyParameterFromQuery(Name = "submissionId")]
    public Guid? LaunchSubmissionId { get; set; }

    private bool     _loading = true;
    private int      _tab     = 0;
    private OppDetailModel? _opp;
    private Guid _tenantId;
    private Guid? _currentUserId;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string _activeKpi = "overview";

    private List<OppLine>    _lines       = [];
    private List<ActivityRow> _activities = [];
    private List<SubmissionRow> _submissions = [];
    private List<QuoteRow>   _quotes      = [];
    private List<CurrentPolicyRow> _currentPolicies = [];
    private List<DocRow>     _documents   = [];
    private List<CompetitorRow> _competitors = [];
    private List<WorkflowEventRow> _workflowEvents = [];
    private List<OpportunityStageDto> _stages = [];
    private List<OpportunityForecastCategoryDto> _forecastCategories = [];
    private List<LeadActivityTypeDto> _activityTypes = [];
    private List<LineOfBusinessDto> _lobOptions = [];
    private List<CarrierDto> _carrierOptions = [];
    private List<OpportunityCompetitorLookupDto> _competitorLookupOptions = [];
    private OpportunityConversionLaunchDto? _conversionLaunch;
    private bool _showLobPicker;
    private bool _showCarrierPicker;
    private bool _showCompetitorPicker;
    private bool _showNewCompetitor;
    private string _lobSearch = string.Empty;
    private string _carrierSearch = string.Empty;
    private string _competitorSearch = string.Empty;
    private string? _newCompetitorError;

    private bool   _showEdit        = false;
    private bool   _showStage       = false;
    private bool   _showWon         = false;
    private bool   _showClosedWonPrerequisites;
    private bool   _showLogActivity = false;
    private bool   _showUpload      = false;
    private bool   _showAddComp     = false;
    private bool   _showDeleteConfirm = false;
    private bool   _showSubmission = false;
    private bool   _showSubmissionConfirm = false;
    private bool   _showLine = false;
    private SubmissionRow? _postCreateSubmission;

    private OpportunityEditForm _editForm = new();
    private StageMoveForm _stageForm = new();
    private WonForm _wonForm = new();
    private ActivityForm _activityForm = new();
    private CompetitorForm _competitorForm = new();
    private NewCompetitorForm _newCompetitorForm = new();
    private SubmissionForm _submissionForm = new();
    private OpportunityLineForm _lineForm = new();
    private ActivityRow? _editingActivity;
    private CompetitorRow? _editingCompetitor;
    private SubmissionRow? _editingSubmission;
    private OppLine? _editingLine;
    private string        _deleteTitle = string.Empty;
    private string        _deleteMessage = string.Empty;
    private Func<Task>?   _confirmDeleteAction;
    private bool          _savingAction;
    private bool          _wonCreatePolicy = true;
    private UploadDocumentForm _uploadForm = new();
    private IBrowserFile? _selectedUploadFile;
    private string? _uploadFileError;
    private string _uploadedByName = "Current user";
    private bool _savingUpload;
    private bool _showDocumentEdit;
    private bool _savingDocumentEdit;
    private DocRow? _editingDocument;
    private DocumentEditForm _documentEditForm = new();
    private const long MaxUploadBytes = 104_857_600;
    private static readonly HashSet<string> AllowedUploadExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".csv", ".png", ".jpg", ".jpeg", ".tif", ".tiff"
    };
    private static readonly List<LV> _compStrengths = [new("Strong","Strong"),new("Moderate","Moderate"),new("Weak","Weak")];
    private List<DocumentConfigItemDto> _documentCategories = [];
    private IEnumerable<LV> DocumentCategoryOptions => _documentCategories.Select(c => new LV(CategoryLabel(c), CategoryLabel(c)));
    private IReadOnlyList<string> StageOptions => OpportunityPageConstants.ActiveStageNames(_stages);
    private IReadOnlyList<string> StageSteps => StageOptions.Where(s => !s.Equals("Closed Lost", StringComparison.OrdinalIgnoreCase)).ToList();
    private IReadOnlyList<string> ForecastOptions => OpportunityPageConstants.ForecastCategoryNames(_forecastCategories);
    private IEnumerable<LV> ActivityTypeOptions => _activityTypes.Select(type => new LV(type.ActivityTypeCode, type.ActivityTypeName));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            var detail = await Api.GetOpportunityDetailAsync(OpportunityId);
            if (detail is null)
            {
                _opp = null;
                return;
            }

            _opp = MapOpportunity(detail.Opportunity);
            var stages = await Api.SearchOpportunityStagesAsync(_tenantId, pageSize: 200);
            var forecastCategories = await Api.SearchOpportunityForecastCategoriesAsync(_tenantId, pageSize: 200);
            var activityTypes = await Api.SearchLeadActivityTypesAsync(_tenantId, pageSize: 200);
            _stages = stages?.Items.OrderBy(s => s.SortOrder).ThenBy(s => s.StageName).ToList() ?? [];
            _forecastCategories = forecastCategories?.Items.OrderBy(c => c.SortOrder).ThenBy(c => c.CategoryName).ToList() ?? [];
            _activityTypes = activityTypes?.Items.Where(type => type.IsActive).OrderBy(type => type.SortOrder).ThenBy(type => type.ActivityTypeName).ToList() ?? [];
            await LoadCoverageLineLookupsAsync();
            _lines = detail.Lines.Select(MapLine).ToList();
            _activities = detail.Activities.Select(MapActivity).ToList();
            _submissions = detail.Submissions.Select(MapSubmission).ToList();
            _quotes = detail.Quotes.Select(MapQuote).ToList();
            _currentPolicies = detail.CurrentPolicies.Select(MapCurrentPolicy).ToList();
            _competitors = detail.Competitors.Select(MapCompetitor).ToList();
            _workflowEvents = detail.WorkflowEvents.Select(MapWorkflowEvent).ToList();
            await LoadCompetitorLookupsAsync();
            await LoadDocumentCategoriesAsync();
            await LoadOpportunityDocumentsAsync();
            await LoadConversionLaunchAsync();

            Breadcrumbs.SetCrumbs(
                new("Home","/"), new("CRM","/crm/opportunities"),
                new("Opportunities","/crm/opportunities"),
                new(_opp.Name, $"/crm/opportunities/{OpportunityId}"));
        }
        catch (Exception ex)
        {
            _opp = null;
            await ShowToast($"Failed to load opportunity: {ex.Message}", "enterprise-toast-danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadDocumentCategoriesAsync()
    {
        var result = await Api.SearchDocumentConfigItemsAsync(_tenantId, "DocumentCategory", pageSize: 1000);
        _documentCategories = result?.Items.Where(c => c.IsActive).OrderBy(c => c.SortOrder).ThenBy(c => c.Name).ToList() ?? [];
    }

    private static string CategoryLabel(DocumentConfigItemDto category) => Normalize(category.Name) ?? Normalize(category.Code) ?? string.Empty;

    private async Task LoadCoverageLineLookupsAsync()
    {
        var lobs = await Api.SearchLobsAsync(_tenantId, pageSize: 500);
        var carriers = await Api.SearchCarriersAsync(_tenantId, pageSize: 500);
        _lobOptions = lobs?.Items.Where(l => l.IsActive).OrderBy(l => l.LobName).ThenBy(l => l.LobCode).ToList() ?? [];
        _carrierOptions = carriers?.Items.Where(c => c.IsActive).OrderBy(c => c.CarrierName).ThenBy(c => c.NaicCode).ToList() ?? [];
    }

    private async Task LoadCompetitorLookupsAsync()
    {
        var result = await Api.SearchOpportunityCompetitorLookupsAsync(_tenantId, pageSize: 250);
        _competitorLookupOptions = result?.Items.OrderBy(c => c.Name).ToList() ?? [];
    }

    private async Task LoadConversionLaunchAsync()
    {
        _conversionLaunch = await Api.GetOpportunityConversionLaunchAsync(OpportunityId);
        if (_conversionLaunch is not null && LaunchSubmissionId.HasValue && !_conversionLaunch.SubmissionId.HasValue)
        {
            _conversionLaunch.SubmissionId = LaunchSubmissionId;
        }
    }

    private string ConversionDateLabel => _conversionLaunch?.ConvertedDateUtc?.ToString("MMM d, yyyy") ?? "recently";

    private static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();

    private static string LaunchActionClass(OpportunityConversionLaunchActionDto action)
    {
        var css = string.IsNullOrWhiteSpace(action.ButtonCssClass) ? "um-btn um-btn-ghost" : action.ButtonCssClass.Trim();
        if (action.IsPrimary && !css.Contains("um-btn-primary", StringComparison.OrdinalIgnoreCase))
        {
            css += " od-launch-primary";
        }

        return action.IsAvailable ? $"od-launch-action {css}" : $"od-launch-action {css} od-launch-action-disabled";
    }

    private void NavigateLaunchAction(OpportunityConversionLaunchActionDto action)
    {
        if (!action.IsAvailable || string.IsNullOrWhiteSpace(action.Route))
        {
            return;
        }

        Nav.NavigateTo(action.Route);
    }

    private async Task CommitActivityAsync()
    {
        var isNew = _editingActivity is null;
        await ExecuteActionAsync(async () =>
        {
            await Api.UpsertOpportunityActivityAsync(OpportunityId, new UpsertOpportunityActivityRequest
            {
                ActivityId = _editingActivity?.ActivityId,
                TenantId = _tenantId,
                OpportunityId = OpportunityId,
                ActivityTypeCode = _activityForm.Type,
                Subject = Normalize(_activityForm.Subject) ?? string.Empty,
                Notes = Normalize(_activityForm.Notes),
                ActivityDate = _activityForm.OccurredAt,
                UserId = _currentUserId
            });
            ResetActivityDialog();
            await LoadAsync();
            await ShowToast(isNew ? "Activity logged." : "Activity updated.");
        }, "Activity save failed");
    }
    private async Task CommitStageAsync()
    {
        if (IsClosedWon(_stageForm.Stage) && !HasBoundPolicy)
        {
            _showStage = false;
            _showClosedWonPrerequisites = true;
            return;
        }

        await ExecuteActionAsync(async () =>
        {
            var targetStage = _stageForm.Stage;
            await Api.UpdateOpportunityStageAsync(OpportunityId, new UpdateOpportunityStageRequest { Stage = targetStage, ModifiedByUserId = _currentUserId });
            _showStage = false; _stageForm = new();
            await LoadAsync();
            await ShowToast("Stage updated.");
            if (string.Equals(targetStage, "Proposal", StringComparison.OrdinalIgnoreCase))
            {
                await OpenProposalWorkflowAsync();
            }
        }, "Stage update failed");
    }
    private async Task CommitWonAsync()
    {
        await ExecuteActionAsync(async () =>
        {
            var result = await Api.UpdateOpportunityStageAsync(OpportunityId, new UpdateOpportunityStageRequest { Stage = "Closed Won", ModifiedByUserId = _currentUserId, CreateBoundPolicy = false });
            _showWon = false;
            await LoadAsync();
            await ShowToast(string.IsNullOrWhiteSpace(result.Message) ? "Opportunity marked Closed Won." : result.Message);
        }, "Mark won failed");
    }
    private async Task CommitAddCompAsync()
    {
        var isNew = _editingCompetitor is null;
        await ExecuteActionAsync(async () =>
        {
            await Api.UpsertOpportunityCompetitorAsync(OpportunityId, new UpsertOpportunityCompetitorRequest
            {
                CompetitorId = _editingCompetitor?.CompetitorId,
                TenantId = _tenantId,
                OpportunityId = OpportunityId,
                Name = Normalize(_competitorForm.Name) ?? string.Empty,
                Strength = Normalize(_competitorForm.Strength) ?? "Moderate",
