@page "/crm/opportunities/{OpportunityId:guid}"
@namespace Ams.Web.Components.Pages.Crm
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@(_opp is null ? "Opportunity" : _opp.Name) — CRM</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@if (_loading)
{
    <div class="od-loading"><span class="um-spin" aria-hidden="true"></span><span>Loading opportunity…</span></div>
}
else if (_opp is null)
{
    <div class="od-not-found">
        <i class="bi bi-trophy od-nf-icon" aria-hidden="true"></i>
        <h2>Opportunity not found</h2>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back
        </button>
    </div>
}
else
{
    <AppPageHeader Title="@_opp.Name" Subtitle="@_opp.AccountName" Icon="bi-trophy-fill">
        <Actions>
            <button class="um-btn um-btn-ghost" @onclick="() => _showEdit = true"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
            <button class="um-btn um-btn-ghost" @onclick="() => _showStage = true"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Move Stage</button>
            <button class="um-btn um-btn-primary" @onclick="() => _showWon = true"><i class="bi bi-check2-circle" aria-hidden="true"></i> Mark Won</button>
        </Actions>
    </AppPageHeader>

    <!-- Identity strip -->
    <div class="od-strip">
        <span class="@StageBadge(_opp.Stage)">@_opp.Stage</span>
        <span class="@ForecastBadge(_opp.ForecastCategory)">@_opp.ForecastCategory</span>
        <span class="od-chip"><i class="bi bi-person" aria-hidden="true"></i> @_opp.Owner</span>
        <span class="od-chip"><i class="bi bi-building" aria-hidden="true"></i> @_opp.AccountName</span>
        <span class="od-chip od-mono od-bold"><i class="bi bi-cash-coin" aria-hidden="true"></i> @_opp.Amount.ToString("C0")</span>
        <span class="od-chip">
            <i class="bi bi-calendar3" aria-hidden="true"></i>
            <span class="@(_opp.CloseDate < DateTime.UtcNow && _opp.Stage != "Closed Won" && _opp.Stage != "Closed Lost" ? "od-overdue" : "")">
                Close @_opp.CloseDate.ToString("d")
            </span>
        </span>
        <!-- Win probability gauge -->
        <div class="od-win-gauge">
            <div class="od-win-bar" style="width:@_opp.WinPct%;background:@WinColor(_opp.WinPct)"></div>
            <span class="od-win-label" style="color:@WinColor(_opp.WinPct)">@_opp.WinPct% win</span>
        </div>
    </div>

    <!-- Two-column layout -->
    <div class="od-layout">
        <div class="od-tabs-col">
            <AppDetailTabs SelectedTab="_tab" SelectedTabChanged="t => _tab = t">
                <Tabs>
                    <!-- 0 Overview -->
                    <TabItem>
                        <ChildContent><TabHeader Text="Overview" IconCss="bi bi-house" /></ChildContent>
                        <ContentTemplate>
                            <div class="od-tab-body">
                                <div class="od-info-card">
                                    <h3 class="od-section-hdr">Opportunity Details</h3>
                                    <div class="od-field-grid">
                                        @OField("Opportunity #",  _opp.OppNumber)
                                        @OField("Account",        _opp.AccountName)
                                        @OField("Stage",          _opp.Stage)
                                        @OField("Forecast",       _opp.ForecastCategory)
                                        @OField("Amount",         _opp.Amount.ToString("C0"))
                                        @OField("Win Probability",$"{_opp.WinPct}%")
                                        @OField("Close Date",     _opp.CloseDate.ToString("d"))
                                        @OField("Owner",          _opp.Owner)
                                        @OField("Source Lead",    _opp.SourceLead ?? "—")
                                        @OField("Campaign",       _opp.CampaignName ?? "—")
                                        @OField("Created",        _opp.CreatedAt.ToString("f"))
                                        @OField("Last Modified",  _opp.ModifiedAt?.ToString("f") ?? "—")
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(_opp.Description))
                                {
                                    <div class="od-info-card">
                                        <h3 class="od-section-hdr">Description</h3>
                                        <p class="od-notes">@_opp.Description</p>
                                    </div>
                                }
                                <div class="od-info-card">
                                    <h3 class="od-section-hdr">Lines of Interest</h3>
                                    @if (_lines.Count == 0)
                                    { <p class="od-empty-sm">No lines added yet.</p> }
                                    else
                                    {
                                        <SfGrid TValue="OppLine" DataSource="_lines" EnableHover="true" RowHeight="48">
                                            <GridColumns>
                                                <GridColumn Field="@nameof(OppLine.LineOfBusiness)" HeaderText="Line"    MinWidth="160" />
                                                <GridColumn Field="@nameof(OppLine.Carrier)"        HeaderText="Carrier" Width="150" />
                                                <GridColumn Field="@nameof(OppLine.EstPremium)"     HeaderText="Est. Premium" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                                    <Template>@{ var l = (OppLine)context; }<span class="od-mono od-bold">@l.EstPremium.ToString("C0")</span></Template>
                                                </GridColumn>
                                                <GridColumn Field="@nameof(OppLine.Priority)"       HeaderText="Priority" Width="100">
                                                    <Template>@{ var l = (OppLine)context; }<span class="@PriBadge(l.Priority)">@l.Priority</span></Template>
                                                </GridColumn>
                                            </GridColumns>
                                        </SfGrid>
                                    }
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <!-- 1 Activities -->
                    <TabItem>
                        <ChildContent><TabHeader Text="Activities" IconCss="bi bi-lightning" /></ChildContent>
                        <ContentTemplate>
                            <div class="od-tab-body">
                                <div class="od-tab-toolbar">
                                    <span class="od-tab-count">@_activities.Count activit@(_activities.Count == 1 ? "y" : "ies")</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showLogActivity = true"><i class="bi bi-plus-lg" aria-hidden="true"></i> Log</button>
                                </div>
                                @if (_activities.Count == 0) { @OEmpty("bi-lightning","No activities","Log calls, emails or meetings against this opportunity.") }
                                else
                                {
                                    <div class="od-timeline">
                                        @foreach (var a in _activities.OrderByDescending(x => x.OccurredAt))
                                        {
                                            <div class="od-tl-item">
                                                <div class="od-tl-icon @ActivityColor(a.Type)"><i class="bi @ActivityIcon(a.Type)" aria-hidden="true"></i></div>
                                                <div class="od-tl-body">
                                                    <div class="od-tl-hdr">
                                                        <span class="od-tl-type">@a.Type</span>
                                                        <span class="od-tl-by">@a.By</span>
                                                        <span class="od-mono od-muted">@a.OccurredAt.ToString("g")</span>
                                                    </div>
                                                    <div class="od-tl-subject">@a.Subject</div>
                                                    @if (!string.IsNullOrEmpty(a.Notes)) { <p class="od-tl-notes">@a.Notes</p> }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <!-- 2 Quotes -->
                    <TabItem>
                        <ChildContent><TabHeader Text="Quotes" IconCss="bi bi-file-text" /></ChildContent>
                        <ContentTemplate>
                            <div class="od-tab-body">
                                <div class="od-tab-toolbar">
                                    <span class="od-tab-count">@_quotes.Count quote(s)</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/quotes/new?oppId=" + OpportunityId)'><i class="bi bi-plus-lg" aria-hidden="true"></i> New Quote</button>
                                </div>
                                @if (_quotes.Count == 0) { @OEmpty("bi-file-text","No quotes","Generate a quote directly from this opportunity.") }
                                else
                                {
                                    <div class="app-datagrid">
                                        <SfGrid TValue="QuoteRow" DataSource="_quotes" AllowSorting="true" EnableHover="true" RowHeight="52">
                                            <GridColumns>
                                                <GridColumn Field="@nameof(QuoteRow.QuoteNumber)"    HeaderText="Quote #"  Width="130" />
                                                <GridColumn Field="@nameof(QuoteRow.LineOfBusiness)" HeaderText="Line"     Width="160" />
                                                <GridColumn Field="@nameof(QuoteRow.Carrier)"        HeaderText="Carrier"  Width="150" />
                                                <GridColumn Field="@nameof(QuoteRow.Premium)"        HeaderText="Premium"  Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                                    <Template>@{ var q = (QuoteRow)context; }<span class="od-mono od-bold">@q.Premium.ToString("C0")</span></Template>
                                                </GridColumn>
                                                <GridColumn Field="@nameof(QuoteRow.Status)"         HeaderText="Status"   Width="120">
                                                    <Template>@{ var q = (QuoteRow)context; }<span class="@QSBadge(q.Status)">@q.Status</span></Template>
                                                </GridColumn>
                                                <GridColumn Field="@nameof(QuoteRow.ExpiresAt)"      HeaderText="Expires"  Width="120">
                                                    <Template>@{ var q = (QuoteRow)context; }<span class="od-mono @(q.ExpiresAt < DateTime.UtcNow ? "od-overdue" : "")">@q.ExpiresAt.ToString("d")</span></Template>
                                                </GridColumn>
                                            </GridColumns>
                                        </SfGrid>
                                    </div>
                                }
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <!-- 3 Documents -->
                    <TabItem>
                        <ChildContent><TabHeader Text="Documents" IconCss="bi bi-folder2" /></ChildContent>
                        <ContentTemplate>
                            <div class="od-tab-body">
                                <div class="od-tab-toolbar">
                                    <span class="od-tab-count">@_documents.Count document(s)</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showUpload = true"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Upload</button>
                                </div>
                                @if (_documents.Count == 0) { @OEmpty("bi-folder2","No documents","Attach proposals, carrier submissions or correspondence.") }
                                else
                                {
                                    <div class="app-datagrid">
                                        <SfGrid TValue="DocRow" DataSource="_documents" AllowSorting="true" EnableHover="true" RowHeight="52">
                                            <GridColumns>
                                                <GridColumn Field="@nameof(DocRow.FileName)"    HeaderText="File"        MinWidth="200">
                                                    <Template>@{ var d = (DocRow)context; }<span class="od-doc-name"><i class="bi @DocIcon(d.Extension)" aria-hidden="true"></i> @d.FileName</span></Template>
                                                </GridColumn>
                                                <GridColumn Field="@nameof(DocRow.Category)"   HeaderText="Category"    Width="140" />
                                                <GridColumn Field="@nameof(DocRow.SizeKb)"     HeaderText="Size"        Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                                    <Template>@{ var d = (DocRow)context; }<span class="od-mono">@d.SizeKb KB</span></Template>
                                                </GridColumn>
                                                <GridColumn Field="@nameof(DocRow.UploadedBy)" HeaderText="Uploaded By" Width="150" />
                                                <GridColumn Field="@nameof(DocRow.UploadedAt)" HeaderText="Date"        Width="120">
                                                    <Template>@{ var d = (DocRow)context; }<span class="od-mono">@d.UploadedAt.ToString("d")</span></Template>
                                                </GridColumn>
                                            </GridColumns>
                                        </SfGrid>
                                    </div>
                                }
                            </div>
                        </ContentTemplate>
                    </TabItem>
                </Tabs>
            </AppDetailTabs>
        </div>

        <!-- Right panel -->
        <aside class="od-right-panel">
            <!-- Stage progress -->
            <div class="od-panel-card">
                <div class="od-panel-hdr"><i class="bi bi-signpost-2 od-pi--stage" aria-hidden="true"></i><span class="od-panel-title">Stage Progress</span></div>
                <div class="od-stage-steps">
                    @foreach (var st in _stageSteps)
                    {
                        var done = StageOrder(st) < StageOrder(_opp.Stage) || st == _opp.Stage;
                        var cur  = st == _opp.Stage;
                        <div class="od-ss-row @(cur ? "od-ss--cur" : done ? "od-ss--done" : "")">
                            <div class="od-ss-dot @(cur ? "od-ss-dot--cur" : done ? "od-ss-dot--done" : "")">
                                @if (done && !cur) { <i class="bi bi-check-lg" aria-hidden="true"></i> }
                                else if (cur)      { <i class="bi bi-circle-fill" style="font-size:.45rem" aria-hidden="true"></i> }
                            </div>
                            <span class="od-ss-label">@st</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Key metrics -->
            <div class="od-panel-card">
                <div class="od-panel-hdr"><i class="bi bi-bar-chart-steps od-pi--metric" aria-hidden="true"></i><span class="od-panel-title">Key Metrics</span></div>
                <div class="od-metric-list">
                    @OMetric("Amount",        _opp.Amount.ToString("C0"),            "bi-cash-coin")
                    @OMetric("Weighted",      (_opp.Amount * (decimal)_opp.WinPct / 100).ToString("C0"), "bi-graph-up")
                    @OMetric("Days Open",     ((int)(DateTime.UtcNow - _opp.CreatedAt).TotalDays).ToString(), "bi-clock")
                    @OMetric("Days to Close", Math.Max(0,(int)(_opp.CloseDate - DateTime.UtcNow).TotalDays).ToString(), "bi-calendar-check")
                    @OMetric("Activities",    _activities.Count.ToString(), "bi-lightning")
                    @OMetric("Quotes",        _quotes.Count.ToString(),     "bi-file-text")
                </div>
            </div>

            <!-- Competitor intel -->
            <div class="od-panel-card">
                <div class="od-panel-hdr"><i class="bi bi-crosshair od-pi--comp" aria-hidden="true"></i><span class="od-panel-title">Competitors</span></div>
                @if (_competitors.Count == 0) { <p class="od-panel-empty">No competitors tracked.</p> }
                else
                {
                    <div class="od-comp-list">
                        @foreach (var c in _competitors)
                        {
                            <div class="od-comp-row">
                                <span class="od-comp-name">@c.Name</span>
                                <span class="@CompBadge(c.Strength)">@c.Strength</span>
                            </div>
                        }
                    </div>
                }
                <button class="um-btn um-btn-ghost um-btn-sm od-add-btn" @onclick="() => _showAddComp = true"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add</button>
            </div>
        </aside>
    </div>
}

<!-- Log Activity dialog -->
<SfDialog @bind-Visible="_showLogActivity" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="od-dlg-hdr"><i class="bi bi-lightning" aria-hidden="true"></i> Log Activity</span></Header>
        <Content>
            <div class="od-dlg-body">
                <SfDropDownList TValue="string" TItem="LV" DataSource="_actTypes" Placeholder="Type…" Width="100%" @bind-Value="_newAct.Type"><DropDownListFieldSettings Value="Value" Text="Label" /></SfDropDownList>
                <SfTextBox Placeholder="Subject" @bind-Value="_newAct.Subject" />
                <SfTextBox Placeholder="Notes" @bind-Value="_newAct.Notes" Multiline="true" HtmlAttributes="@(new Dictionary<string,object>{{"rows","3"}})" />
                <SfDateTimePicker TValue="DateTime" Placeholder="Date & time" @bind-Value="_newAct.OccurredAt" />
            </div>
        </Content>
        <FooterTemplate>
            <div class="od-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showLogActivity = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitActivityAsync" disabled="@(string.IsNullOrEmpty(_newAct.Type)||string.IsNullOrEmpty(_newAct.Subject))"><i class="bi bi-check-lg" aria-hidden="true"></i> Save</button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Move Stage dialog -->
<SfDialog @bind-Visible="_showStage" Width="400px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="od-dlg-hdr"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Move Stage</span></Header>
        <Content>
            <div class="od-dlg-body">
                <SfDropDownList TValue="string" TItem="LV" DataSource="_stageOpts" Placeholder="Select stage…" Width="100%" @bind-Value="_stageTarget"><DropDownListFieldSettings Value="Value" Text="Label" /></SfDropDownList>
            </div>
        </Content>
        <FooterTemplate>
            <div class="od-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showStage = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitStageAsync" disabled="@string.IsNullOrEmpty(_stageTarget)"><i class="bi bi-check-lg" aria-hidden="true"></i> Move</button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Mark Won confirmation -->
<SfDialog @bind-Visible="_showWon" Width="400px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="od-dlg-hdr"><i class="bi bi-trophy" aria-hidden="true"></i> Mark as Closed Won</span></Header>
        <Content>
            <div class="od-dlg-body" style="font-size:.88rem">
                <p style="margin:0">Mark <strong>@(_opp?.Name)</strong> as Closed Won with amount <strong>@(_opp?.Amount.ToString("C0"))</strong>?</p>
                <label class="od-toggle-label"><input type="checkbox" @bind="_wonCreatePolicy" /> Create bound policy record</label>
            </div>
        </Content>
        <FooterTemplate>
            <div class="od-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showWon = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitWonAsync"><i class="bi bi-check2-circle" aria-hidden="true"></i> Confirm Won</button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Upload doc dialog -->
<SfDialog @bind-Visible="_showUpload" Width="440px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="od-dlg-hdr"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Upload Document</span></Header>
        <Content>
            <div class="od-dlg-body">
                <SfDropDownList TValue="string" TItem="LV" DataSource="_docCats" Placeholder="Category…" Width="100%" @bind-Value="_docCat"><DropDownListFieldSettings Value="Value" Text="Label" /></SfDropDownList>
                <SfUploader AllowedExtensions=".pdf,.docx,.xlsx,.csv" MaxFileSize="10485760" AutoUpload="false" />
            </div>
        </Content>
        <FooterTemplate>
            <div class="od-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showUpload = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="() => _showUpload = false"><i class="bi bi-check-lg" aria-hidden="true"></i> Upload</button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Add competitor dialog -->
<SfDialog @bind-Visible="_showAddComp" Width="400px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="od-dlg-hdr"><i class="bi bi-crosshair" aria-hidden="true"></i> Add Competitor</span></Header>
        <Content>
            <div class="od-dlg-body">
                <SfTextBox Placeholder="Competitor name" @bind-Value="_newCompName" />
                <SfDropDownList TValue="string" TItem="LV" DataSource="_compStrengths" Placeholder="Strength…" Width="100%" @bind-Value="_newCompStrength"><DropDownListFieldSettings Value="Value" Text="Label" /></SfDropDownList>
            </div>
        </Content>
        <FooterTemplate>
            <div class="od-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showAddComp = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitAddCompAsync" disabled="@string.IsNullOrEmpty(_newCompName)"><i class="bi bi-check-lg" aria-hidden="true"></i> Add</button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public Guid OpportunityId { get; set; }

    private SfToast? _toast;
    private bool     _loading = true;
    private int      _tab     = 0;
    private OppDetailModel? _opp;

    private List<OppLine>    _lines       = [];
    private List<ActivityRow> _activities = [];
    private List<QuoteRow>   _quotes      = [];
    private List<DocRow>     _documents   = [];
    private List<CompetitorRow> _competitors = [];

    private bool   _showEdit        = false;
    private bool   _showStage       = false;
    private bool   _showWon         = false;
    private bool   _showLogActivity = false;
    private bool   _showUpload      = false;
    private bool   _showAddComp     = false;

    private string        _stageTarget    = string.Empty;
    private bool          _wonCreatePolicy = true;
    private string        _docCat         = string.Empty;
    private ActivityRow   _newAct         = new();
    private string        _newCompName    = string.Empty;
    private string        _newCompStrength = string.Empty;

    private static readonly List<LV> _actTypes    = [new("Call","Call"),new("Email","Email"),new("Meeting","Meeting"),new("Note","Note"),new("Task","Task")];
    private static readonly List<LV> _stageOpts   = [new("Qualification","Qualification"),new("Needs Analysis","Needs Analysis"),new("Proposal","Proposal"),new("Negotiation","Negotiation"),new("Closed Won","Closed Won"),new("Closed Lost","Closed Lost")];
    private static readonly List<LV> _docCats     = [new("Proposal","Proposal"),new("Carrier Sub","Carrier Submission"),new("Financials","Financials"),new("Correspondence","Correspondence"),new("Other","Other")];
    private static readonly List<LV> _compStrengths = [new("Strong","Strong"),new("Moderate","Moderate"),new("Weak","Weak")];
    private static readonly string[] _stageSteps  = ["Qualification","Needs Analysis","Proposal","Negotiation","Closed Won"];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        await Task.Delay(0); // TODO: Api.GetOpportunityAsync(OpportunityId)
        _opp = new OppDetailModel
        {
            OppId = OpportunityId, OppNumber = "OPP-00291",
            Name  = "Sullivan Manufacturing — BOP + GL Renewal",
            AccountName = "Sullivan Manufacturing LLC",
            Stage = "Proposal", ForecastCategory = "Best Case",
            Amount = 42_000m, WinPct = 65, Owner = "Alice Carter",
            CloseDate   = DateTime.UtcNow.AddDays(18),
            CreatedAt   = DateTime.UtcNow.AddDays(-30),
            ModifiedAt  = DateTime.UtcNow.AddDays(-2),
            Description = "Full commercial package renewal — BOP and GL. Decision expected before close date.",
        };
        Breadcrumbs.SetCrumbs(
            new("Home","/"), new("CRM","/crm/opportunities"),
            new("Opportunities","/crm/opportunities"),
            new(_opp.Name, $"/crm/opportunities/{OpportunityId}"));
        _loading = false;
    }

    private async Task CommitActivityAsync()
    {
        _newAct.By = "Me"; _newAct.OccurredAt = DateTime.UtcNow;
        _activities.Insert(0, new ActivityRow { Type = _newAct.Type, Subject = _newAct.Subject, Notes = _newAct.Notes, By = _newAct.By, OccurredAt = _newAct.OccurredAt });
        _newAct = new(); _showLogActivity = false;
        await _toast!.ShowAsync(new ToastModel { Content = "Activity logged.", CssClass = "e-toast-success" });
    }
    private async Task CommitStageAsync()
    {
        if (_opp is not null) _opp.Stage = _stageTarget;
        _showStage = false; _stageTarget = string.Empty;
        await _toast!.ShowAsync(new ToastModel { Content = "Stage updated.", CssClass = "e-toast-success" });
    }
    private async Task CommitWonAsync()
    {
        if (_opp is not null) _opp.Stage = "Closed Won";
        _showWon = false;
        await _toast!.ShowAsync(new ToastModel { Content = "Opportunity marked Closed Won.", CssClass = "e-toast-success" });
    }
    private async Task CommitAddCompAsync()
    {
        _competitors.Add(new CompetitorRow { Name = _newCompName, Strength = _newCompStrength });
        _newCompName = string.Empty; _newCompStrength = string.Empty; _showAddComp = false;
        await _toast!.ShowAsync(new ToastModel { Content = "Competitor added.", CssClass = "e-toast-success" });
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static RenderFragment OField(string label, string? val) => __builder =>
    { <div class="od-field-group"><span class="od-field-lbl">@label</span><span class="od-field-val">@(string.IsNullOrEmpty(val) ? "—" : val)</span></div>; };

    private static RenderFragment OEmpty(string icon, string title, string sub) => __builder =>
    { <div class="od-empty"><i class="bi @icon od-empty-icon" aria-hidden="true"></i><div class="od-empty-title">@title</div><div class="od-empty-sub">@sub</div></div>; };

    private static RenderFragment OMetric(string label, string val, string icon) => __builder =>
    { <div class="od-metric-row"><i class="bi @icon od-metric-icon" aria-hidden="true"></i><span class="od-metric-lbl">@label</span><span class="od-metric-val">@val</span></div>; };

    private static string StageBadge(string s) => s switch
    {
        "Qualification" => "op-stage op-stage--qual", "Needs Analysis" => "op-stage op-stage--needs",
        "Proposal"      => "op-stage op-stage--prop", "Negotiation"    => "op-stage op-stage--neg",
        "Closed Won"    => "op-stage op-stage--won",  "Closed Lost"    => "op-stage op-stage--lost",
        _               => "op-stage",
    };
    private static string ForecastBadge(string f) => f switch
    {
        "Commit" => "op-fc op-fc--commit","Best Case" => "op-fc op-fc--best",
        "Closed" => "op-fc op-fc--closed", _ => "op-fc op-fc--pipeline",
    };
    private static string PriBadge(string p) => p switch { "High" => "ld-pri ld-pri--high","Medium" => "ld-pri ld-pri--normal",_ => "ld-pri ld-pri--low" };
    private static string QSBadge(string s)  => s switch { "Approved" => "ld-status ld-status--approved","Rejected" => "ld-status ld-status--rejected","Pending" => "ld-status ld-status--pending",_ => "ld-status ld-status--open" };
    private static string CompBadge(string s) => s switch { "Strong" => "od-comp-badge od-cb--strong","Weak" => "od-comp-badge od-cb--weak",_ => "od-comp-badge od-cb--mid" };
    private static string ActivityIcon(string t) => t switch { "Call"=>"bi-telephone","Email"=>"bi-envelope","Meeting"=>"bi-calendar3","Note"=>"bi-sticky","Task"=>"bi-check2-square",_=>"bi-lightning" };
    private static string ActivityColor(string t) => t switch { "Call"=>"od-tl-ic--call","Email"=>"od-tl-ic--email","Meeting"=>"od-tl-ic--meeting","Note"=>"od-tl-ic--note",_=>"od-tl-ic--other" };
    private static string DocIcon(string ext) => ext.ToLower() switch { ".pdf"=>"bi-file-earmark-pdf",".docx"=>"bi-file-earmark-word",".xlsx"=>"bi-file-earmark-excel",_=>"bi-file-earmark" };
    private static string WinColor(int p) => p >= 70 ? "#16a34a" : p >= 40 ? "#b45309" : "#dc2626";
    private static int StageOrder(string s) => s switch { "Qualification"=>0,"Needs Analysis"=>1,"Proposal"=>2,"Negotiation"=>3,"Closed Won"=>4,"Closed Lost"=>5,_=>99 };

    // ── Models ────────────────────────────────────────────────────────────────
    private sealed class OppDetailModel
    {
        public Guid     OppId           { get; set; }
        public string   OppNumber       { get; set; } = string.Empty;
        public string   Name            { get; set; } = string.Empty;
        public string   AccountName     { get; set; } = string.Empty;
        public string   Stage           { get; set; } = "Qualification";
        public string   ForecastCategory{ get; set; } = "Pipeline";
        public decimal  Amount          { get; set; }
        public int      WinPct          { get; set; }
        public string   Owner           { get; set; } = string.Empty;
        public DateTime CloseDate       { get; set; }
        public DateTime CreatedAt       { get; set; }
        public DateTime? ModifiedAt     { get; set; }
        public string?  Description     { get; set; }
        public string?  SourceLead      { get; set; }
        public string?  CampaignName    { get; set; }
    }
    private sealed class OppLine     { public string LineOfBusiness { get; set; }=string.Empty; public string? Carrier { get; set; } public decimal EstPremium { get; set; } public string Priority { get; set; }="Medium"; }
    private sealed class ActivityRow { public string Type { get; set; }=string.Empty; public string Subject { get; set; }=string.Empty; public string? Notes { get; set; } public string By { get; set; }=string.Empty; public DateTime OccurredAt { get; set; }=DateTime.UtcNow; }
    private sealed class QuoteRow    { public Guid QuoteId { get; set; }=Guid.NewGuid(); public string QuoteNumber { get; set; }=string.Empty; public string LineOfBusiness { get; set; }=string.Empty; public string Carrier { get; set; }=string.Empty; public decimal Premium { get; set; } public string Status { get; set; }="Pending"; public DateTime ExpiresAt { get; set; }=DateTime.UtcNow.AddDays(30); }
    private sealed class DocRow      { public string FileName { get; set; }=string.Empty; public string Extension { get; set; }=string.Empty; public string Category { get; set; }=string.Empty; public int SizeKb { get; set; } public string UploadedBy { get; set; }=string.Empty; public DateTime UploadedAt { get; set; }=DateTime.UtcNow; }
    private sealed class CompetitorRow { public string Name { get; set; }=string.Empty; public string Strength { get; set; }="Moderate"; }
    private sealed record LV(string Value, string Label);
