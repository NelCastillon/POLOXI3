@page "/crm/opportunities/{OpportunityId:guid}"
@namespace Ams.Web.Components.Pages.Crm
@using Ams.Application.Features.Opportunities
@using Ams.Application.Features.Documents
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@(_opp is null ? "Opportunity" : _opp.Name) ? CRM</PageTitle>

@if (_toastVisible)
{
    <div class="od-toast od-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="od-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_loading)
{
    <div class="od-enterprise-page"><div class="od-loading"><span class="um-spin" aria-hidden="true"></span><span>Loading opportunity?</span></div></div>
}
else if (_opp is null)
{
    <div class="od-enterprise-page"><div class="od-not-found">
        <i class="bi bi-trophy od-nf-icon" aria-hidden="true"></i>
        <h2>Opportunity not found</h2>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back
        </button>
    </div></div>
}
else
{
    <div class="od-enterprise-page">
    <section class="od-hero">
        <div class="od-hero-left">
            <span class="od-hero-icon"><i class="bi bi-trophy-fill" aria-hidden="true"></i></span>
            <div class="od-hero-copy">
                <div class="od-title-row">
                    <h1>@_opp.Name</h1>
                    <span><i class="bi bi-hash" aria-hidden="true"></i> @_opp.OppNumber</span>
                </div>
                <p>@Safe(_opp.AccountName, "Account pending") <span aria-hidden="true">&bull;</span> @Safe(_opp.Owner, "Unassigned") <span aria-hidden="true">&bull;</span> Close @FormatDate(_opp.CloseDate)</p>
            </div>
        </div>
        <div class="od-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="OpenEditOpportunity"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
            <button class="um-btn um-btn-ghost" @onclick="OpenStageDialog"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Move Stage</button>
            <button class="um-btn um-btn-ghost" @onclick="OpenNewSubmission"><i class="bi bi-send-plus" aria-hidden="true"></i> New Submission</button>
            <button class="um-btn um-btn-ghost" @onclick="OpenProposalWorkflowAsync"><i class="bi bi-file-earmark-richtext" aria-hidden="true"></i> Proposal Workflow</button>
            <span title="@MarkWonEligibilityMessage"><button class="um-btn um-btn-primary" @onclick="OpenWonDialog" disabled="@(!HasBoundPolicy)"><i class="bi bi-check2-circle" aria-hidden="true"></i> Mark Won</button></span>
        </div>
    </section>

    @if (_conversionLaunch?.HasConversionContext == true)
    {
        <section class="od-conversion-launch" aria-label="Lead conversion launch center">
            <div class="od-conversion-head">
                <div>
                    <span class="od-conversion-eyebrow"><i class="bi bi-arrow-up-right-circle" aria-hidden="true"></i> Lead conversion command center</span>
                    <h2>Next best actions for @_conversionLaunch.OpportunityName</h2>
                    <p>DB-backed launch actions synchronize the new opportunity with the converted lead, account, submission draft, and pipeline modules.</p>
                </div>
                <span class="od-conversion-badge"><i class="bi bi-check2-circle" aria-hidden="true"></i> Converted @ConversionDateLabel</span>
            </div>
            <div class="od-conversion-grid">
                <div class="od-conversion-summary">
                    <span>Source lead</span>
                    <strong>@Safe(_conversionLaunch.SourceLeadNumber, "Converted lead")</strong>
                    <small>@(_conversionLaunch.LineOfBusiness ?? "Line pending")</small>
                </div>
                <div class="od-conversion-summary">
                    <span>Account</span>
                    <strong>@Safe(_conversionLaunch.AccountName, _opp.AccountName)</strong>
                    <small>@_conversionLaunch.EstimatedAmount.GetValueOrDefault().ToString("C0") estimated premium</small>
                </div>
                <div class="od-conversion-summary">
                    <span>Submission</span>
                    <strong>@(_conversionLaunch.SubmissionNumber ?? "No draft created")</strong>
                    <small>@(_conversionLaunch.HasSubmissionDraft ? "Persisted draft is ready" : "Create from the opportunity workspace")</small>
                </div>
            </div>
            <div class="od-conversion-actions" aria-label="Post-conversion actions">
                @foreach (var action in _conversionLaunch.Actions.OrderBy(a => a.SortOrder))
                {
                    <button type="button" class="@LaunchActionClass(action)" title="@action.ActionDescription" disabled="@(!action.IsAvailable)" @onclick="() => NavigateLaunchAction(action)">
                        <i class="bi @Safe(action.IconCssClass, "bi-arrow-right-circle")" aria-hidden="true"></i>
                        <span><strong>@action.ActionTitle</strong><small>@action.ActionDescription</small></span>
                    </button>
                }
            </div>
        </section>
    }

    <section class="od-kpi-strip" aria-label="Opportunity KPI filters">
        <button type="button" class='@KpiClass("overview")' title="Show overview" @onclick='() => ActivateKpi("overview", 0)'><span class="od-kpi-icon"><i class="bi bi-cash-coin" aria-hidden="true"></i></span><span><strong class="od-kpi-val">@_opp.Amount.ToString("C0")</strong><span class="od-kpi-lbl">Amount</span><small>@WeightedAmount.ToString("C0") weighted</small></span></button>
        <button type="button" class='@KpiClass("stage")' title="Show workflow" @onclick='() => ActivateKpi("stage", 6)'><span class="od-kpi-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span><span><strong class="od-kpi-val">@_opp.WinPct%</strong><span class="od-kpi-lbl">Win probability</span><small>@_opp.ForecastCategory forecast</small></span></button>
        <button type="button" class='@KpiClass("activities")' title="Show activities" @onclick='() => ActivateKpi("activities", 1)'><span class="od-kpi-icon"><i class="bi bi-lightning-charge" aria-hidden="true"></i></span><span><strong class="od-kpi-val">@_activities.Count</strong><span class="od-kpi-lbl">Activities</span><small>@RecentActivityText</small></span></button>
        <button type="button" class='@KpiClass("submissions")' title="Show submissions" @onclick='() => ActivateKpi("submissions", 2)'><span class="od-kpi-icon"><i class="bi bi-send" aria-hidden="true"></i></span><span><strong class="od-kpi-val">@_submissions.Count</strong><span class="od-kpi-lbl">Submissions</span><small>@_quotes.Count quote(s)</small></span></button>
        <button type="button" class='@KpiClass("policies")' title="Show current policies" @onclick='() => ActivateKpi("policies", 7)'><span class="od-kpi-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span><span><strong class="od-kpi-val">@_currentPolicies.Count</strong><span class="od-kpi-lbl">Current Policies</span><small>@CurrentPolicyPremiumText</small></span></button>
        <button type="button" class='@KpiClass("documents")' title="Show documents" @onclick='() => ActivateKpi("documents", 4)'><span class="od-kpi-icon"><i class="bi bi-folder2-open" aria-hidden="true"></i></span><span><strong class="od-kpi-val">@_documents.Count</strong><span class="od-kpi-lbl">Documents</span><small>Proposal package</small></span></button>
        <button type="button" class='@KpiClass("competitors")' title="Show competitors" @onclick='() => ActivateKpi("competitors", 5)'><span class="od-kpi-icon"><i class="bi bi-crosshair" aria-hidden="true"></i></span><span><strong class="od-kpi-val">@_competitors.Count</strong><span class="od-kpi-lbl">Competitors</span><small>Market intel</small></span></button>
    </section>

    <!-- Identity strip -->
    <div class="od-strip">
        <span class="@StageBadge(_opp.Stage)">@_opp.Stage</span>
        <span class="@ForecastBadge(_opp.ForecastCategory)">@_opp.ForecastCategory</span>
        <span class="od-chip"><i class="bi bi-person" aria-hidden="true"></i> @_opp.Owner</span>
        <span class="od-chip"><i class="bi bi-building" aria-hidden="true"></i> @_opp.AccountName</span>
        <span class="od-chip od-mono od-bold"><i class="bi bi-cash-coin" aria-hidden="true"></i> @_opp.Amount.ToString("C0")</span>
        <span class="od-chip">
            <i class="bi bi-calendar3" aria-hidden="true"></i>
            <span class="@(_opp.CloseDate.HasValue && _opp.CloseDate.Value < DateTime.UtcNow && _opp.Stage != "Closed Won" && _opp.Stage != "Closed Lost" ? "od-overdue" : "")">
                Close @FormatDate(_opp.CloseDate)
            </span>
        </span>
        <!-- Win probability gauge -->
        <div class="od-win-gauge">
            <div class="od-win-bar" style="width:@_opp.WinPct%;background:@WinColor(_opp.WinPct)"></div>
            <span class="od-win-label" style="color:@WinColor(_opp.WinPct)">@_opp.WinPct% win</span>
        </div>
    </div>

    @if (ShowPolicyBindingRequiredCta)
    {
        <section class="od-policy-cta" aria-label="Policy binding required">
            <div class="od-policy-cta-icon"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></div>
            <div class="od-policy-cta-copy">
                <span>Policy binding required</span>
                <strong>Create the bound policy record or continue the submission workflow.</strong>
                <p>@PolicyBindingRequiredDetail</p>
            </div>
            <div class="od-policy-cta-actions">
                <button type="button" class="um-btn um-btn-primary" @onclick="ContinuePolicyBindingSubmission"><i class="bi bi-send" aria-hidden="true"></i> Continue Binding Workflow</button>
            </div>
        </section>
    }

    <!-- Two-column layout -->
    <div class="od-layout">
        <div class="od-tabs-col">
            <div class="od-native-tabs" role="tablist" aria-label="Opportunity detail sections">
                @TabButton(0, "Overview", "bi-house")
                @TabButton(1, "Activities", "bi-lightning")
                @TabButton(2, "Submissions", "bi-send")
                @TabButton(3, "Quotes", "bi-file-text")
                @TabButton(4, "Documents", "bi-folder2")
                @TabButton(5, "Competitors", "bi-crosshair")
                @TabButton(6, "Workflow", "bi-diagram-3")
                @TabButton(7, "Current Policies", "bi-shield-check")
            </div>
            <div class="od-native-panels">
                @if (_tab == 0)
                {
                            <div class="od-tab-body">
                                <div class="od-info-card">
                                    <h3 class="od-section-hdr">Opportunity Details</h3>
                                    <div class="od-field-grid">
                                        @OField("Opportunity #",  _opp.OppNumber)
                                        @OField("Account",        _opp.AccountName)
                                        @OField("Stage",          _opp.Stage)
                                        @OField("Forecast",       _opp.ForecastCategory)
                                        @OField("Amount",         _opp.Amount.ToString("C0"))
                                        @OField("Win Probability",$"{_opp.WinPct}%")
                                        @OField("Close Date",     FormatDate(_opp.CloseDate))
                                        @OField("Owner",          _opp.Owner)
                                        @OField("Source Lead",    _opp.SourceLead ?? "?")
                                        @OField("Campaign",       _opp.CampaignName ?? "?")
                                        @OField("Created",        _opp.CreatedAt.ToString("f"))
                                        @OField("Last Modified",  _opp.ModifiedAt?.ToString("f") ?? "?")
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(_opp.Description))
                                {
                                    <div class="od-info-card">
                                        <h3 class="od-section-hdr">Description</h3>
                                        <p class="od-notes">@_opp.Description</p>
                                    </div>
                                }
                                <div class="od-info-card">
                                    <div class="od-tab-toolbar">
                                        <h3 class="od-section-hdr">Coverage Lines</h3>
                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm od-add-line-btn" @onclick="OpenAddLine"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Line</button>
                                    </div>
                                    @if (_lines.Count == 0)
                                    { <p class="od-empty-sm">No lines added yet.</p> }
                                    else
                                    {
                                        <div class="od-table-wrap"><table class="od-table"><thead><tr><th>Line</th><th>Carrier</th><th>Status</th><th class="text-end">Est. Premium</th><th>Priority</th><th class="text-end">Actions</th></tr></thead><tbody>
                                            @foreach (var l in _lines)
                                            {
                                                <tr><td data-label="Line"><strong>@l.LineOfBusiness</strong>@if (l.IsPrimary) { <span class="od-related-chip ms-2">Primary</span> }</td><td data-label="Carrier">@(l.Carrier ?? "?")</td><td data-label="Status"><span class="@QSBadge(l.Status)">@l.Status</span></td><td data-label="Est. Premium" class="text-end od-mono od-bold">@l.EstPremium.ToString("C0")</td><td data-label="Priority"><span class="@PriBadge(l.Priority)">@l.Priority</span></td><td data-label="Actions" class="text-end"><div class="od-row-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditLine(l)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>@if (!l.IsPrimary) { <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => SetPrimaryLineAsync(l)"><i class="bi bi-star" aria-hidden="true"></i> Primary</button> }<button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteLine(l)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div></td></tr>
                                            }
                                        </tbody></table></div>
                                    }
                                </div>
                            </div>
                }

                @if (_tab == 1)
                {
                            <div class="od-tab-body">
                                <div class="od-tab-toolbar">
                                    <span class="od-tab-count">@_activities.Count activit@(_activities.Count == 1 ? "y" : "ies")</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenLogActivity"><i class="bi bi-plus-lg" aria-hidden="true"></i> Log</button>
                                </div>
                                @if (_activities.Count == 0) { @OEmpty("bi-lightning","No activities","Log calls, emails or meetings against this opportunity.") }
                                else
                                {
                                    <div class="od-timeline">
                                        @foreach (var a in _activities.OrderByDescending(x => x.OccurredAt))
                                        {
                                            <div class="od-tl-item">
                                                <div class="od-tl-icon @ActivityColor(a.Type)"><i class="bi @ActivityIcon(a.Type)" aria-hidden="true"></i></div>
                                                <div class="od-tl-body">
                                                    <div class="od-tl-hdr">
                                                        <span class="od-tl-type">@a.Type</span>
                                                        <span class="od-tl-by">@a.By</span>
                                                        <span class="od-mono od-muted">@a.OccurredAt.ToString("g")</span>
                                                    </div>
                                                    <div class="od-tl-subject">@a.Subject</div>
                                                    @if (!string.IsNullOrEmpty(a.Notes)) { <p class="od-tl-notes">@a.Notes</p> }
                                                    <div class="od-inline-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditActivity(a)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteActivity(a)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                                                </div>
                                            </div>
                                        }
                @if (_tab == 5)
                {
                    <div class="od-tab-body">
                        <div class="od-tab-toolbar">
                            <span class="od-tab-count">@_competitors.Count competitor(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenAddCompetitor"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add</button>
                        </div>
                        @if (_competitors.Count == 0) { @OEmpty("bi-crosshair", "No competitors", "Track competitive pressure and strength for win strategy.") }
                        else
                        {
                            <div class="od-competitor-grid">
                                @foreach (var c in _competitors)
                                {
                                    <article class="od-competitor-card">
                                        <div><strong>@c.Name</strong><span class="@CompBadge(c.Strength)">@c.Strength</span></div>
                                        <div class="od-row-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditCompetitor(c)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteCompetitor(c)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                                    </article>
                                }
                            </div>
                        }
                    </div>
                }
                @if (_tab == 6)
                {
                    <div class="od-tab-body">
                        <div class="od-tab-toolbar"><span class="od-tab-count">@_workflowEvents.Count workflow event(s)</span></div>
                        @if (_workflowEvents.Count == 0) { @OEmpty("bi-diagram-3", "No workflow events", "Opportunity actions will appear here as they sync to related entities.") }
                        else
                        {
                            <div class="od-timeline">
                                @foreach (var e in _workflowEvents.OrderByDescending(x => x.EventDateUtc))
                                {
                                    <div class="od-tl-item"><div class="od-tl-icon od-tl-ic--workflow"><i class="bi @WorkflowIcon(e.EventType)" aria-hidden="true"></i></div><div class="od-tl-body"><div class="od-tl-hdr"><span class="od-tl-type">@e.EventType</span><span class="od-mono od-muted">@e.EventDateUtc.ToString("g")</span>@if (!string.IsNullOrWhiteSpace(e.RelatedEntityName)) { <span class="od-related-chip">@e.RelatedEntityName</span> }</div><div class="od-tl-subject">@e.EventTitle</div>@if (!string.IsNullOrWhiteSpace(e.EventDetail)) { <p class="od-tl-notes">@e.EventDetail</p> }</div></div>
                                }
                            </div>
                        }
                    </div>
                }
                                    </div>
                                }
                            </div>
                }

                @if (_tab == 2)
                {
                            <div class="od-tab-body">
                                <div class="od-tab-toolbar">
                                    <span class="od-tab-count">@_submissions.Count submission(s)</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenNewSubmission"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Submission</button>
                                </div>
                                @if (_submissions.Count == 0) { @OEmpty("bi-send","No submissions","Create underwriting submissions from this opportunity before requesting quotes.") }
                                else
                                {
                                    <div class="od-table-wrap"><table class="od-table"><thead><tr><th>Submission #</th><th>Line</th><th>Status</th><th class="text-end">Target Premium</th><th class="text-end">Quotes</th><th class="text-end">Actions</th></tr></thead><tbody>
                                        @foreach (var s in _submissions)
                                        {
                                            <tr><td data-label="Submission #" class="od-mono od-bold">@s.SubmissionNumber</td><td data-label="Line"><strong>@s.LineOfBusiness</strong>@if (s.Lines.Count > 1) { <div class="od-line-list">@string.Join(", ", s.Lines.Select(l => l.LineOfBusiness))</div> }</td><td data-label="Status"><span class="@QSBadge(s.Status)">@s.Status</span></td><td data-label="Target Premium" class="text-end od-mono od-bold">@s.TargetPremium.ToString("C0")</td><td data-label="Quotes" class="text-end">@s.QuoteCount</td><td data-label="Actions" class="text-end"><div class="od-row-actions"><button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenSubmission(s.SubmissionId)"><i class="bi bi-arrow-right" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditSubmission(s)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteSubmission(s)"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td></tr>
                                        }
                                    </tbody></table></div>
                                }
                            </div>
                }

                @if (_tab == 3)
                {
                            <div class="od-tab-body">
                                <div class="od-tab-toolbar">
                                    <span class="od-tab-count">@_quotes.Count quote(s)</span>
                                </div>
                                @if (_quotes.Count == 0) { @OEmpty("bi-file-text","No quotes","Quotes are created downstream from submissions.") }
                                else
                                {
                                    <div class="od-table-wrap"><table class="od-table"><thead><tr><th>Quote #</th><th>Carrier</th><th>Status</th><th class="text-end">Premium</th><th>Expires</th></tr></thead><tbody>
                                        @foreach (var q in _quotes)
                                        {
                                            <tr><td data-label="Quote #" class="od-mono od-bold">@q.QuoteNumber</td><td data-label="Carrier">@(string.IsNullOrWhiteSpace(q.Carrier) ? "?" : q.Carrier)</td><td data-label="Status"><span class="@QSBadge(q.Status)">@q.Status</span></td><td data-label="Premium" class="text-end od-mono od-bold">@q.Premium.ToString("C0")</td><td data-label="Expires" class="od-mono">@q.ExpiresAt.ToString("d")</td></tr>
                                        }
                                    </tbody></table></div>
                                }
                            </div>
                }

                @if (_tab == 4)
                {
                            <div class="od-tab-body">
                                <div class="od-tab-toolbar">
                                    <span class="od-tab-count">@_documents.Count document(s)</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showUpload = true"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Upload</button>
                                </div>
                                @if (_documents.Count == 0) { @OEmpty("bi-folder2","No documents","Attach proposals, carrier submissions or correspondence.") }
                                else
                                {
                                    <div class="od-table-wrap"><table class="od-table"><thead><tr><th>File</th><th>Category</th><th class="text-end">Size</th><th>Uploaded By</th><th>Date</th><th class="text-end">Actions</th></tr></thead><tbody>
                                        @foreach (var d in _documents)
                                        {
                                            <tr><td data-label="File"><span class="od-doc-name"><i class="bi @DocIcon(d.Extension)" aria-hidden="true"></i> @d.FileName</span></td><td data-label="Category">@d.Category</td><td data-label="Size" class="text-end od-mono">@d.SizeKb KB</td><td data-label="Uploaded By">@d.UploadedBy</td><td data-label="Date" class="od-mono">@d.UploadedAt.ToString("d")</td><td data-label="Actions" class="text-end"><div class="od-row-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Edit document" @onclick="() => OpenEditDocument(d)"><i class="bi bi-pencil-square" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Download document" @onclick="() => DownloadDocumentAsync(d)"><i class="bi bi-download" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" title="Delete document" @onclick="() => ConfirmDeleteDocument(d)"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td></tr>
                                        }
                                    </tbody></table></div>
                                }
                            </div>
                }
                @if (_tab == 7)
                {
                            <div class="od-tab-body">
                                <div class="od-tab-toolbar">
                                    <span class="od-tab-count">@_currentPolicies.Count current polic@(_currentPolicies.Count == 1 ? "y" : "ies")</span>
                                    <span class="od-readonly"><i class="bi bi-database-check" aria-hidden="true"></i> Synced from bound policy register</span>
                                </div>
                                @if (_currentPolicies.Count == 0) { @OEmpty("bi-shield-check", "No current policies", "No active or bound policies are currently linked to this opportunity account.") }
                                else
                                {
                                    <div class="od-policy-grid">
                                        @foreach (var policy in _currentPolicies)
                                        {
                                            <article class="od-policy-card">
                                                <div class="od-policy-card-head">
                                                    <span class="od-policy-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                                                    <div>
                                                        <strong>@policy.PolicyNumber</strong>
                                                        <small>@policy.LineOfBusiness</small>
                                                    </div>
                                                    <span class="@PolicyStatusBadge(policy.Status)">@policy.Status</span>
                                                </div>
                                                <div class="od-policy-meta">
                                                    <span><i class="bi bi-building" aria-hidden="true"></i> @Safe(policy.CarrierName, "Carrier pending")</span>
                                                    <span><i class="bi bi-calendar-range" aria-hidden="true"></i> @policy.EffectiveDate.ToString("d") - @policy.ExpirationDate.ToString("d")</span>
                                                    <span class="@PolicyExpirationClass(policy)"><i class="bi bi-clock-history" aria-hidden="true"></i> @PolicyExpirationText(policy)</span>
                                                </div>
                                                <div class="od-policy-financials">
                                                    <div><span>Annual premium</span><strong>@policy.AnnualPremium.ToString("C0")</strong></div>
                                                    <div><span>Renewal stage</span><strong>@Safe(policy.RenewalStage, "Not Started")</strong></div>
                                                    <div><span>Documents</span><strong>@policy.DocumentCount</strong></div>
                                                    <div><span>Endorsements</span><strong>@policy.EndorsementCount</strong></div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(policy.LastAction))
                                                {
                                                    <p class="od-policy-last-action">@policy.LastAction</p>
                                                }
                                                <div class="od-policy-actions">
                                                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenPolicy(policy.PolicyId)"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> View Policy</button>
                                                    @if (policy.SubmissionId != Guid.Empty)
                                                    {
                                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenSubmission(policy.SubmissionId)"><i class="bi bi-send" aria-hidden="true"></i> Submission</button>
                                                    }
                                                </div>
                                            </article>
                                        }
                                    </div>
                                }
                            </div>
                }
            </div>
        </div>

        <!-- Right panel -->
        <aside class="od-right-panel">
            <!-- Stage progress -->
            <div class="od-panel-card">
                <div class="od-panel-hdr"><i class="bi bi-signpost-2 od-pi--stage" aria-hidden="true"></i><span class="od-panel-title">Stage Progress</span></div>
                <div class="od-stage-steps">
                    @foreach (var st in StageSteps)
                    {
                        var done = StageOrder(st) < StageOrder(_opp.Stage) || st == _opp.Stage;
                        var cur  = st == _opp.Stage;
                        <div class="od-ss-row @(cur ? "od-ss--cur" : done ? "od-ss--done" : "")">
                            <div class="od-ss-dot @(cur ? "od-ss-dot--cur" : done ? "od-ss-dot--done" : "")">
                                @if (done && !cur) { <i class="bi bi-check-lg" aria-hidden="true"></i> }
                                else if (cur)      { <i class="bi bi-circle-fill" style="font-size:.45rem" aria-hidden="true"></i> }
                            </div>
                            <span class="od-ss-label">@st</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Key metrics -->
            <div class="od-panel-card">
                <div class="od-panel-hdr"><i class="bi bi-bar-chart-steps od-pi--metric" aria-hidden="true"></i><span class="od-panel-title">Key Metrics</span></div>
                <div class="od-metric-list">
                    @OMetric("Amount",        _opp.Amount.ToString("C0"),            "bi-cash-coin")
                    @OMetric("Weighted",      (_opp.Amount * (decimal)_opp.WinPct / 100).ToString("C0"), "bi-graph-up")
                    @OMetric("Days Open",     ((int)(DateTime.UtcNow - _opp.CreatedAt).TotalDays).ToString(), "bi-clock")
                    @OMetric("Days to Close", DaysToCloseText, "bi-calendar-check")
                    @OMetric("Activities",    _activities.Count.ToString(), "bi-lightning")
                    @OMetric("Submissions",   _submissions.Count.ToString(),"bi-send")
                    @OMetric("Quotes",        _quotes.Count.ToString(),     "bi-file-text")
                    @OMetric("Current Policies", _currentPolicies.Count.ToString(), "bi-shield-check")
                    @OMetric("Policy Premium", CurrentPolicyPremiumText, "bi-cash-stack")
                </div>
            </div>

            <!-- Competitor intel -->
            <div class="od-panel-card">
                <div class="od-panel-hdr"><i class="bi bi-crosshair od-pi--comp" aria-hidden="true"></i><span class="od-panel-title">Competitors</span></div>
                @if (_competitors.Count == 0) { <p class="od-panel-empty">No competitors tracked.</p> }
                else
                {
                    <div class="od-comp-list">
                        @foreach (var c in _competitors)
                        {
                            <div class="od-comp-row">
                                <span class="od-comp-name">@c.Name</span>
                                <span class="@CompBadge(c.Strength)">@c.Strength</span>
                                <span class="od-compact-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditCompetitor(c)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteCompetitor(c)"><i class="bi bi-trash" aria-hidden="true"></i></button></span>
                            </div>
                        }
                    </div>
                }
                <button class="um-btn um-btn-ghost um-btn-sm od-add-btn" @onclick="OpenAddCompetitor"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add</button>
            </div>
        </aside>
    </div>
    </div>
}

