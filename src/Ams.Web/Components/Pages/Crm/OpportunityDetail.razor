    {
        _showSubmissionConfirm = false;
        await CommitSubmissionAsync();
    }

    private void CancelSubmissionConfirm() => _showSubmissionConfirm = false;

    private async Task CommitSubmissionAsync()
    {
        var isNew = _editingSubmission is null;
        var selectedLines = _lines.Where(l => _submissionForm.OpportunityLineIds.Contains(l.OpportunityLineId)).ToList();
        if (selectedLines.Count == 0)
        {
            await ShowToast("Select at least one coverage line for the submission.", "enterprise-toast-danger");
            return;
        }

        var lineLabel = selectedLines.Count == 1 ? selectedLines[0].LineOfBusiness : $"{selectedLines.Count} line package";
        var targetPremium = selectedLines.Sum(l => l.EstPremium);
        var submissionStatus = _submissionForm.Status;
        _savingAction = true;
        try
        {
            var savedSubmissionId = await Api.UpsertOpportunitySubmissionAsync(OpportunityId, new UpsertOpportunitySubmissionRequest
            {
                SubmissionId = _editingSubmission?.SubmissionId,
                TenantId = _tenantId,
                OpportunityId = OpportunityId,
                SubmissionNumber = _editingSubmission?.SubmissionNumber,
                LineOfBusiness = lineLabel,
                OpportunityLineIds = selectedLines.Select(l => l.OpportunityLineId).ToList(),
                Status = _submissionForm.Status,
                TargetPremium = targetPremium,
                UserId = _currentUserId
            });
            ResetSubmissionDialog();
            await LoadAsync();
            if (isNew)
            {
                _postCreateSubmission = _submissions.FirstOrDefault(s => s.SubmissionId == savedSubmissionId) ?? new SubmissionRow { SubmissionId = savedSubmissionId, SubmissionNumber = lineLabel, LineOfBusiness = lineLabel, Status = submissionStatus, TargetPremium = targetPremium };
            }
            await ShowToast(isNew ? "Submission created and synchronized to the submissions workflow." : "Submission updated and synchronized to the submissions workflow.");
        }
        catch (Exception ex)
        {
            await ShowToast($"Submission save failed: {ex.Message}", "enterprise-toast-danger");
        }
        finally
        {
            _savingAction = false;
        }
    }

