    private async Task EnsureTenantContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _currentUserId = context.UserId;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _uploadedByName = user.FindFirst(ClaimTypes.Name)?.Value
            ?? user.FindFirst("user_name")?.Value
            ?? user.FindFirst(ClaimTypes.Email)?.Value
            ?? "Current user";
    }

    private static int ToSizeKb(long bytes) => Math.Max(1, (int)Math.Ceiling(bytes / 1024.0));

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F1} GB";
    }
