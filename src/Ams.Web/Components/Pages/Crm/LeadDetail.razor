    private static int StageToStatusCode(string stage) => stage switch
    {
        "Contacted" => 2,
        "Qualified" => 3,
        "Converted" => 4,
        "Lost" => 5,
        _ => 1,
    };

    private async Task Toast(string msg, string css = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = css });
