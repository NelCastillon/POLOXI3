    private bool   _showAddContact   = false;
    private bool   _showAddInterest  = false;
    private bool   _showCompose      = false;
    private bool   _savingEdit       = false;

    // Form models
    private AssignOwnerForm _assignForm = new();
    private EditLeadForm _editForm = new();
    private ConvertLeadForm _convertForm = new();
    private CampaignForm _campaignForm = new();
    private UploadDocumentForm _uploadForm = new();
    private IBrowserFile? _selectedUploadFile;
    private string? _uploadFileError;
    private string _uploadedByName = "Current user";
    private const long MaxUploadBytes = 104_857_600;
    private static readonly HashSet<string> AllowedUploadExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".csv", ".png", ".jpg", ".jpeg", ".tif", ".tiff"
    };
    private ActivityForm _activityForm = new();
    private ContactForm _contactForm = new();
    private InterestForm _interestForm = new();
    private CommunicationForm _commForm = new();
    private static readonly List<LabelValue> _sourceOptions =
    [
        new("Referral","Referral"), new("Website","Website"), new("Cold Call","Cold Call"),
        new("Social","Social"), new("Email","Email"), new("Event","Event"),
        new("Partner","Partner"), new("Inbound","Inbound"), new("Direct","Direct"),
    ];
    private static readonly List<LabelValue> _stageOptions =
    [
        new("New","New"), new("Contacted","Contacted"), new("Qualified","Qualified"),
        new("Proposal","Proposal"), new("Negotiation","Negotiation"),
        new("Converted","Converted"), new("Lost","Lost"),
    ];

    // ── Static options ────────────────────────────────────────────────────────
    private List<LabelValue> _ownerOptions = [];
    private static readonly List<LabelValue> _campaignOptions =
    [
        new("c1","Q3 Commercial BOP Drip"),
        new("c2","Renewal Win-Back 2025"),
        new("c3","Mid-Market Cyber Awareness"),
        new("c4","New Business Referral Series"),
    ];
    private static readonly List<LabelValue> _docCategories =
    [
        new("Loss Run","Loss Run"), new("Application","Application"),
        new("Financial","Financial"), new("Correspondence","Correspondence"), new("Other","Other"),
    ];
    private static readonly List<LabelValue> _activityTypes =
    [
        new("Call","Call"), new("Email","Email"), new("Meeting","Meeting"),
        new("Note","Note"), new("Task","Task"), new("Demo","Demo"),
    ];
    private static readonly List<LabelValue> _commChannels =
    [
        new("Email","Email"), new("Phone","Phone"), new("SMS","SMS"), new("Portal","Portal"),
    ];
    private static readonly List<LabelValue> _lobOptions =
    [
        new("BOP","Business Owner's Policy"), new("GL","General Liability"),
        new("WC","Workers' Compensation"),    new("Cyber","Cyber Liability"),
        new("Auto","Commercial Auto"),        new("Property","Commercial Property"),
        new("Umbrella","Commercial Umbrella"),new("PL","Professional Liability"),
    ];
    private static readonly List<LabelValue> _priorityOptions =
    [
        new("High","High"), new("Medium","Medium"), new("Low","Low"),
    ];

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnParametersSetAsync()
    {
        await EnsureTenantContextAsync();
        await LoadAsync();
        _ = StartLeadScoringRealtimeAsync();
    }

    private async Task OnLeadScoresChangedAsync(Guid tenantId)
    {
        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task StartLeadScoringRealtimeAsync()
    {
        try
        {
            if (_tenantId != Guid.Empty)
            {
                await LeadScoringRealtime.StartAsync(_tenantId, OnLeadScoresChangedAsync);
            }
        }
        catch (Exception ex)
        {
            await Toast($"Real-time lead scoring updates are unavailable: {ex.Message}", "e-toast-warning");
        }
    }

    public async ValueTask DisposeAsync() => await LeadScoringRealtime.DisposeAsync();

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            _loadError = null;
            var dto = await Api.GetLeadByIdAsync(LeadId);
            if (dto is null)
            {
                _lead = null;
                return;
            }

            var scoreFactors = await Api.GetLeadScoreFactorsAsync(LeadId);
            var engagement = await Api.GetLeadEngagementSummaryAsync(LeadId);

            var users = await Api.SearchUsersAsync(dto.TenantId, pageSize: 250);
            _ownerOptions = (users?.Items ?? [])
                .Where(u => string.Equals(u.StatusCode, "Active", StringComparison.OrdinalIgnoreCase))
                .OrderBy(u => string.IsNullOrWhiteSpace(u.DisplayName) ? u.FullName : u.DisplayName)
                .Select(u => new LabelValue(u.UserId.ToString(), string.IsNullOrWhiteSpace(u.DisplayName) ? u.FullName : u.DisplayName))
                .ToList();

            var owner = ResolveOwnerName(dto.AssignedToUserId);
            _lead = MapToLeadDetail(dto, owner);
            _scoreFactors = (scoreFactors ?? [])
                .Select(ScoreFactor.FromDto)
                .ToList();
            ApplyEngagementSummary(engagement);
            _assignForm.OwnerId = dto.AssignedToUserId?.ToString() ?? string.Empty;

            await LoadTabDataAsync(dto.TenantId);

            BuildRightPanel(engagement is null);
            await LoadNbaAsync();

            Breadcrumbs.SetCrumbs(
                new("Home", "/"),
                new("CRM", "/crm/leads"),
                new("Leads", "/crm/leads"),
                new(_lead.FullName, $"/crm/leads/{LeadId}"));
        }
        catch (Exception ex)
        {
            _loadError = $"Error loading lead: {ex.Message}";
            _lead = null;
            await Toast(_loadError, "e-toast-danger");
        }
        finally { _loading = false; }
    }

    private string ResolveOwnerName(Guid? assignedToUserId)
    {
        if (!assignedToUserId.HasValue)
        {
            return "Unassigned";
        }

        return _ownerOptions.FirstOrDefault(o => o.Value == assignedToUserId.Value.ToString())?.Label ?? "Unassigned";
    }

    private async Task LoadTabDataAsync(Guid tenantId)
    {
        var contacts = await Api.GetLeadContactsAsync(LeadId);
        var interests = await Api.GetLeadInterestLinesAsync(LeadId);
        var activities = await Api.GetLeadActivitiesByLeadIdAsync(LeadId);
        var quotes = await Api.SearchQuotesAsync(tenantId);
        var documents = await Api.GetLeadDocumentsAsync(LeadId);
        var comms = await Api.GetLeadCommunicationsAsync(LeadId);
        var campaigns = await Api.GetLeadCampaignsAsync(LeadId);

        _contacts = (contacts ?? []).Select(ContactRow.FromDto).ToList();
        _interestLines = (interests ?? []).Select(InterestLine.FromDto).ToList();
        _activities = (activities ?? []).Select(ActivityRow.FromDto).ToList();
        _quotes = (quotes?.Items ?? []).Where(q => q.OpportunityId.HasValue || q.AccountName == _lead?.CompanyName).Select(QuoteRow.FromDto).ToList();
        _documents = (documents ?? []).Select(DocRow.FromDto).ToList();
        _comms = (comms ?? []).Select(CommRow.FromDto).ToList();
        _campaigns = (campaigns ?? []).Select(CampaignEnrollment.FromDto).ToList();
    }

    private static LeadDetailModel MapToLeadDetail(LeadDto dto, string owner)
    {
        var score = Math.Clamp(dto.Score ?? 0, 0, 100);
        var source = string.IsNullOrWhiteSpace(dto.SourceCode) ? "Direct" : dto.SourceCode;

        return new LeadDetailModel
        {
            LeadId = dto.LeadId,
            FirstName = dto.FirstName,
            LastName = dto.LastName,
            CompanyName = dto.AccountName ?? string.Empty,
            Email = dto.Email ?? string.Empty,
            Phone = dto.Phone,
            InterestedService = dto.InterestedService,
            Stage = NormalizeStage(dto.NurturingStageCode, dto.StatusCode),
            Rating = ScoreToRating(score),
            Source = source,
            Owner = owner,
            Score = score,
            EstPremium = dto.AnnualRevenue ?? 0,
            CreatedAt = dto.CreatedDateUtc,
            ModifiedAt = dto.ModifiedDateUtc,
            LastTouch = source,
            Notes = dto.InterestedService,
        };
    }

    private static string NormalizeStage(string? stage, int statusCode)
    {
        if (!string.IsNullOrWhiteSpace(stage))
        {
            return stage.Trim() switch
            {
                "Closed" => "Lost",
                "Won" => "Converted",
                var s => s
            };
        }

        return statusCode switch
        {
            2 => "Contacted",
            3 => "Qualified",
            4 => "Converted",
            5 => "Lost",
            _ => "New",
        };
    }

    private static string ScoreToRating(int score) => score switch
    {
        >= 80 => "Hot",
        >= 50 => "Warm",
        _ => "Cold",
    };

    private void ApplyEngagementSummary(LeadEngagementSummaryDto? engagement)
    {
        if (engagement is null) return;

        _engageLevel = engagement.Level;
        _engageMetrics = new EngageMetrics
        {
            EmailsSent = engagement.EmailsSent,
            EmailsOpened = engagement.EmailsOpened,
            Clicks = engagement.Clicks,
            PortalVisits = engagement.PortalVisits,
            ActivityCount = engagement.ActivityCount,
            DaysSinceTouch = engagement.DaysSinceTouch,
        };

        var matched = engagement.Factors?.Where(f => f.Matched).ToList() ?? [];
        var max = Math.Max(1, matched.Count == 0 ? 1 : matched.Max(f => Math.Abs(f.Points)));
        _engageBars = matched.Count == 0
            ? []
            : matched.Select((f, i) => new EngageBar { Date = DateTime.UtcNow.AddDays(-matched.Count + i + 1), Count = Math.Abs(f.Points), MaxCount = max }).ToList();
    }

    private void BuildRightPanel(bool useFallback)
    {
        if (_lead is null) return;

        if (useFallback)
        {
            var emailComms = _comms.Where(c => string.Equals(c.Channel, "Email", StringComparison.OrdinalIgnoreCase)).ToList();
            var lastTouch = _activities.Select(a => (DateTime?)a.OccurredAt)
                .Concat(_comms.Select(c => (DateTime?)c.SentAt))
                .Concat(_campaigns.Select(c => (DateTime?)(c.LastTouch ?? c.EnrolledAt)))
                .Where(d => d.HasValue)
                .Select(d => d!.Value)
                .DefaultIfEmpty(_lead.CreatedAt)
                .Max();

            _engageMetrics = new EngageMetrics
            {
                EmailsSent = emailComms.Count + _campaigns.Sum(c => c.EmailsSent),
                EmailsOpened = emailComms.Count(c => c.Opened) + _campaigns.Sum(c => c.EmailsOpen),
                Clicks = emailComms.Count(c => c.Clicked) + _campaigns.Sum(c => c.Clicks),
                PortalVisits = 0,
                ActivityCount = _activities.Count,
                DaysSinceTouch = Math.Max(0, (int)(DateTime.UtcNow - lastTouch).TotalDays),
            };

            var fallbackScore = Math.Clamp(
                (_engageMetrics.EmailsSent > 0 ? 10 : 0) +
                (_engageMetrics.EmailsOpened > 0 ? 20 : 0) +
                (_engageMetrics.Clicks > 0 ? 20 : 0) +
                (_engageMetrics.ActivityCount > 0 ? 20 : 0) +
                (_engageMetrics.DaysSinceTouch > 14 ? -20 : 0), 0, 100);
            _engageLevel = fallbackScore >= 70 ? "High" : fallbackScore >= 40 ? "Medium" : "Low";
        }

        BuildEngagementBars();
    }

    private void BuildEngagementBars()
    {
        var startDate = DateTime.UtcNow.Date.AddDays(-29);
        var touches = _activities.Select(a => a.OccurredAt)
            .Concat(_comms.Select(c => c.SentAt))
            .Concat(_campaigns.Select(c => c.LastTouch ?? c.EnrolledAt))
            .Where(d => d.Date >= startDate)
            .GroupBy(d => d.Date)
            .ToDictionary(g => g.Key, g => g.Count());

        var max = Math.Max(1, touches.Values.DefaultIfEmpty(0).Max());
        _engageBars = Enumerable.Range(0, 30)
            .Select(i =>
            {
                var date = startDate.AddDays(i);
                return new EngageBar { Date = date, Count = touches.TryGetValue(date, out var count) ? count : 0, MaxCount = max };
            })
            .ToList();
    }

    private async Task LoadNbaAsync()
    {
        _nbaLoading = true; StateHasChanged();
        await Task.Delay(0); // Placeholder until a real next-best-action API exists.
        _nbaActions = [];
        _nbaLoading = false;
    }

