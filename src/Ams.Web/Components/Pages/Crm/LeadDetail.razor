    private Task SyncLeadContactFormToAccountAsync(Guid accountId)
    {
        var contact = new LeadContactDto
        {
            TenantId = _lead?.TenantId ?? _tenantId,
            LeadId = LeadId,
            FirstName = _tabForm.FirstName.Trim(),
            LastName = _tabForm.LastName.Trim(),
            Title = TrimOrNull(_tabForm.Title),
            Email = TrimOrNull(_tabForm.Email),
            Phone = NormalizePhone(_tabForm.Phone) ?? TrimOrNull(_tabForm.Phone),
            IsPrimary = _tabForm.IsPrimary
        };

        return SyncLeadContactToAccountAsync(contact, accountId);
    }

    private async Task SyncLeadContactToAccountAsync(LeadContactDto contact, Guid accountId)
    {
        if (string.IsNullOrWhiteSpace(contact.FirstName) || string.IsNullOrWhiteSpace(contact.LastName)) return;

        var accountContacts = await Api.GetAccountContactsAsync(accountId) ?? [];
        var existing = FindMatchingAccountContact(accountContacts, contact);
        if (existing is null)
        {
            await Api.CreateContactAsync(new CreateContactRequest
            {
                TenantId = _lead?.TenantId ?? _tenantId,
                AccountId = accountId,
                FirstName = contact.FirstName.Trim(),
                LastName = contact.LastName.Trim(),
                Email = TrimOrNull(contact.Email),
                Phone = TrimOrNull(contact.Phone),
                JobTitle = TrimOrNull(contact.Title),
                ContactTypeCode = contact.IsPrimary ? "Primary" : "Business",
                IsKeyContact = contact.IsPrimary,
                IsServiceContact = !contact.IsPrimary,
                PreferredContactMethod = string.IsNullOrWhiteSpace(contact.Email) ? (string.IsNullOrWhiteSpace(contact.Phone) ? null : "Phone") : "Email",
                StatusCode = "Active",
                StatusCodeId = 1,
                CreatedByUserId = _currentUserId == Guid.Empty ? null : _currentUserId
            });
            return;
        }

        await Api.UpdateContactAsync(existing.ContactId, new UpdateContactRequest
        {
            FirstName = contact.FirstName.Trim(),
            LastName = contact.LastName.Trim(),
            Email = TrimOrNull(contact.Email),
            Phone = TrimOrNull(contact.Phone),
            JobTitle = TrimOrNull(contact.Title),
            ContactTypeCode = contact.IsPrimary ? "Primary" : Safe(existing.ContactTypeCode, "Business"),
            IsBillingContact = existing.IsBillingContact,
            IsServiceContact = existing.IsServiceContact || !contact.IsPrimary,
            IsPortalUser = existing.IsPortalUser,
            IsKeyContact = existing.IsKeyContact || contact.IsPrimary,
            PreferredContactMethod = string.IsNullOrWhiteSpace(contact.Email) ? existing.PreferredContactMethod : "Email",
            StatusCode = "Active",
            StatusCodeId = 1,
            ModifiedByUserId = _currentUserId == Guid.Empty ? null : _currentUserId
        });
    }

    private static ContactDto? FindMatchingAccountContact(IEnumerable<ContactDto> accountContacts, LeadContactDto leadContact)
    {
        if (!string.IsNullOrWhiteSpace(leadContact.Email))
        {
            var byEmail = accountContacts.FirstOrDefault(c => string.Equals(c.Email, leadContact.Email, StringComparison.OrdinalIgnoreCase));
