    private async Task HandleLeadDocumentUploadedAsync(Guid documentId)
    {
        var document = await Api.GetDocumentByIdAsync(documentId);
        if (document is null)
        {
            ShowToast("danger", "The document was uploaded, but its lead record could not be created.");
            return;
        }

        var extension = Path.GetExtension(document.FileName).TrimStart('.').ToLowerInvariant();
        await Api.CreateLeadDocumentAsync(LeadId, new CreateLeadDocumentRequest
        {
            DocumentId = documentId,
            TenantId = _lead?.TenantId ?? _tenantId,
            LeadId = LeadId,
            FileName = document.FileName,
            Extension = extension,
            Category = document.CategoryCode,
            SizeKb = Math.Max(1, (int)Math.Ceiling((document.FileSizeBytes ?? 0) / 1024m)),
            UploadedByUserId = _currentUserId == Guid.Empty ? null : _currentUserId,
            UploadedAt = document.CreatedDateUtc
        });

        await LoadAsync();
        ShowToast("success", "Lead document uploaded successfully.");
    }

