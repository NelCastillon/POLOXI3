        private static IReadOnlyList<ValidationResult> ValidatePopupModel(object model, IReadOnlyDictionary<string, string>? memberMap = null)
        {
            var results = new List<ValidationResult>();
            Validator.TryValidateObject(model, new ValidationContext(model), results, validateAllProperties: true);

            if (memberMap is null || memberMap.Count == 0)
            {
                return results;
            }

            return results
                .Select(result => new ValidationResult(
                    result.ErrorMessage,
                    result.MemberNames.Select(member => memberMap.TryGetValue(member, out var mappedMember) ? mappedMember : member)))
                .ToList();
        }
