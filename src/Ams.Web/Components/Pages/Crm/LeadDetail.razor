    private void OnConvertLineOfBusinessChanged(string value)
    {
        var oldLineOfBusiness = _convertForm.LineOfBusiness;
        _convertForm.LineOfBusiness = value;
        _convertForm.OpportunityName = ReplaceConvertOpportunityLineOfBusiness(_convertForm.OpportunityName, oldLineOfBusiness, value);
    }

    private void ClearConvertAccountSelection()
    {
        _convertForm.ExistingAccountId = string.Empty;
