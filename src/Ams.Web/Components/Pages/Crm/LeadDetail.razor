@code {
    [Parameter] public Guid LeadId { get; set; }

    private SfToast? _toast;
    private bool     _loading = true;
    private int      _tab     = 0;

    // ── Core record ───────────────────────────────────────────────────────────
    private LeadDetailModel? _lead;

    // ── Tab data ──────────────────────────────────────────────────────────────
    private List<ContactRow>       _contacts      = [];
    private List<InterestLine>     _interestLines = [];
    private List<ActivityRow>      _activities    = [];
    private List<QuoteRow>         _quotes        = [];
    private List<DocRow>           _documents     = [];
    private List<CommRow>          _comms         = [];
    private List<CampaignEnrollment> _campaigns   = [];

    // ── Right-panel data ──────────────────────────────────────────────────────
    private List<ScoreFactor>  _scoreFactors  = [];
    private string             _engageLevel   = "Medium";
    private EngageMetrics      _engageMetrics = new();
    private List<EngageBar>    _engageBars    = [];
    private bool               _nbaLoading    = false;
    private List<NbaAction>    _nbaActions    = [];

    // ── Dialog state ──────────────────────────────────────────────────────────
    private bool   _showEdit         = false;
    private bool   _showAssign       = false;
    private bool   _showConvert      = false;
    private bool   _showCampaign     = false;
    private bool   _showUploadDoc    = false;
    private bool   _showLogActivity  = false;
    private bool   _showAddContact   = false;
    private bool   _showAddInterest  = false;
    private bool   _showCompose      = false;

    // Assign
    private string _assignTarget = string.Empty;
    private bool   _assignNotify  = true;

    // Convert
    private bool _convertKeepLead       = false;
    private bool _convertCreateActivity = true;

    // Campaign
    private string _campaignTarget  = string.Empty;
    private bool   _campaignSendNow = false;

    // Doc upload
    private string _docCategory = string.Empty;

    // Log activity
    private ActivityRow _newActivity = new();

    // Add contact
    private ContactRow _newContact = new();

    // Add interest
    private InterestLine _newInterest = new();

    // Compose comm
    private CommRow _newComm = new();

    // ── Static options ────────────────────────────────────────────────────────
    private static readonly List<LabelValue> _ownerOptions =
    [
        new("Alice Carter","Alice Carter"), new("Bob Martinez","Bob Martinez"),
        new("Carol Smith","Carol Smith"),   new("David Lee","David Lee"),
        new("Eva Johnson","Eva Johnson"),
    ];
    private static readonly List<LabelValue> _campaignOptions =
    [
        new("c1","Q3 Commercial BOP Drip"),
        new("c2","Renewal Win-Back 2025"),
        new("c3","Mid-Market Cyber Awareness"),
        new("c4","New Business Referral Series"),
    ];
    private static readonly List<LabelValue> _docCategories =
    [
        new("Loss Run","Loss Run"), new("Application","Application"),
        new("Financial","Financial"), new("Correspondence","Correspondence"), new("Other","Other"),
    ];
    private static readonly List<LabelValue> _activityTypes =
    [
        new("Call","Call"), new("Email","Email"), new("Meeting","Meeting"),
        new("Note","Note"), new("Task","Task"), new("Demo","Demo"),
    ];
    private static readonly List<LabelValue> _commChannels =
    [
        new("Email","Email"), new("Phone","Phone"), new("SMS","SMS"), new("Portal","Portal"),
    ];
    private static readonly List<LabelValue> _lobOptions =
    [
        new("BOP","Business Owner's Policy"), new("GL","General Liability"),
        new("WC","Workers' Compensation"),    new("Cyber","Cyber Liability"),
        new("Auto","Commercial Auto"),        new("Property","Commercial Property"),
        new("Umbrella","Commercial Umbrella"),new("PL","Professional Liability"),
    ];
    private static readonly List<LabelValue> _priorityOptions =
    [
        new("High","High"), new("Medium","Medium"), new("Low","Low"),
    ];

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            // TODO: replace stubs with real API calls
            await Task.Delay(0);
            _lead = BuildStub();

            _contacts      = [];
            _interestLines = [];
            _activities    = [];
            _quotes        = [];
            _documents     = [];
            _comms         = [];
            _campaigns     = [];

            BuildRightPanel();
            await LoadNbaAsync();

            Breadcrumbs.SetCrumbs(
                new("Home", "/"),
                new("CRM", "/crm/leads"),
                new("Leads", "/crm/leads"),
                new(_lead.FullName, $"/crm/leads/{LeadId}"));
        }
        finally { _loading = false; }
    }

    private void BuildRightPanel()
    {
        if (_lead is null) return;

        _scoreFactors =
        [
            new("Company size",   20, 20,  true),
            new("Email opened",   15, 15,  true),
            new("Website visits",  8, 10,  true),
            new("Title match",    12, 15,  true),
            new("Stale > 14 d",  -10, 15, false),
        ];

        _engageLevel   = _lead.Score >= 70 ? "High" : _lead.Score >= 40 ? "Medium" : "Low";
        _engageMetrics = new EngageMetrics
        {
            EmailsSent    = 8,
            EmailsOpened  = 5,
            Clicks        = 2,
            PortalVisits  = 3,
            ActivityCount = _activities.Count,
            DaysSinceTouch = _lead.LastActivity.HasValue
                ? (int)(DateTime.UtcNow - _lead.LastActivity.Value).TotalDays : 999,
        };

        var rnd  = new Random(LeadId.GetHashCode());
        var max  = 0;
        var bars = Enumerable.Range(0, 30)
            .Select(i => { var c = rnd.Next(0, 5); max = Math.Max(max, c); return (Date: DateTime.UtcNow.AddDays(-29 + i), Count: c); })
            .ToList();
        _engageBars = bars.Select(b => new EngageBar { Date = b.Date, Count = b.Count, MaxCount = max }).ToList();
    }

    private async Task LoadNbaAsync()
    {
        _nbaLoading = true; StateHasChanged();
        await Task.Delay(0); // TODO: Api.GetLeadNbaAsync(LeadId)
        _nbaActions =
        [
            new("Call",    "Follow up on proposal",      "Proposal sent 5 days ago with no response.", "High",   DateTime.UtcNow.AddDays(1)),
            new("Email",   "Send loss run request",      "No loss run on file — needed for quote.",    "High",   DateTime.UtcNow.AddDays(2)),
            new("Enroll",  "Add to BOP nurture campaign","Lead matches BOP segment criteria.",          "Medium", null),
        ];
        _nbaLoading = false;
    }

    // ── Action handlers ───────────────────────────────────────────────────────
    private async Task CommitAssignAsync()
    {
        // TODO: Api.AssignLeadAsync(LeadId, _assignTarget, _assignNotify)
        await Task.Delay(0);
        if (_lead is not null) _lead.Owner = _assignTarget;
        _showAssign = false;
        await Toast($"Lead assigned to {_assignTarget}.", "e-toast-success");
    }

    private async Task CommitConvertAsync()
    {
        // TODO: Api.ConvertLeadAsync(LeadId, _convertKeepLead, _convertCreateActivity)
        await Task.Delay(0);
        _showConvert = false;
        await Toast("Lead converted to opportunity.", "e-toast-success");
        Nav.NavigateTo("/crm/opportunities");
    }

    private async Task CommitCampaignAsync()
    {
        // TODO: Api.EnrollLeadInCampaignAsync(LeadId, _campaignTarget, _campaignSendNow)
        await Task.Delay(0);
        _showCampaign   = false;
        _campaignTarget = string.Empty;
        await Toast("Lead enrolled in campaign.", "e-toast-success");
        await LoadAsync();
    }

    private async Task CommitActivityAsync()
    {
        _newActivity.By = "Me"; // TODO: current user
        var copy = new ActivityRow { Type = _newActivity.Type, Subject = _newActivity.Subject, Notes = _newActivity.Notes, By = _newActivity.By, OccurredAt = _newActivity.OccurredAt, NextFollowUp = _newActivity.NextFollowUp };
        _activities.Insert(0, copy);
        _newActivity       = new();
        _showLogActivity   = false;
        await Toast("Activity logged.", "e-toast-success");
    }

    private async Task CommitAddContactAsync()
    {
        var copy = new ContactRow { FirstName = _newContact.FirstName, LastName = _newContact.LastName, Title = _newContact.Title, Email = _newContact.Email, Phone = _newContact.Phone, IsPrimary = _newContact.IsPrimary };
        _contacts.Add(copy);
        _newContact        = new();
        _showAddContact    = false;
        await Toast("Contact added.", "e-toast-success");
    }

    private async Task CommitAddInterestAsync()
    {
        var copy = new InterestLine { LineOfBusiness = _newInterest.LineOfBusiness, Carrier = _newInterest.Carrier, CurrentCarrier = _newInterest.CurrentCarrier, EstPremium = _newInterest.EstPremium, ExpiryDate = _newInterest.ExpiryDate, Priority = _newInterest.Priority, Notes = _newInterest.Notes };
        _interestLines.Add(copy);
        _newInterest       = new();
        _showAddInterest   = false;
        await Toast("Interest line added.", "e-toast-success");
    }

    private async Task CommitComposeAsync()
    {
        _newComm.SentAt = DateTime.UtcNow;
        _newComm.SentBy = "Me"; // TODO: current user
        var copy = new CommRow { Channel = _newComm.Channel, Subject = _newComm.Subject, Preview = _newComm.Preview, SentBy = _newComm.SentBy, SentAt = _newComm.SentAt };
        _comms.Insert(0, copy);
        _newComm    = new();
        _showCompose = false;
        await Toast("Communication logged.", "e-toast-success");
    }

    private async Task Toast(string msg, string css = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = css });
    }

    // ── Render helpers ────────────────────────────────────────────────────────
    private static RenderFragment Field(string label, string? val) => __builder =>
    {
        <div class="ldd-field-group">
            <span class="ldd-field-lbl">@label</span>
            <span class="ldd-field-val">@(string.IsNullOrEmpty(val) ? "—" : val)</span>
        </div>;
    };

    private static RenderFragment AttrRow(string label, string? val, string icon) => __builder =>
    {
        <div class="ldd-attr-row">
            <i class="bi @icon ldd-attr-icon" aria-hidden="true"></i>
            <span class="ldd-attr-lbl">@label</span>
            <span class="ldd-attr-val">@(val ?? "—")</span>
        </div>;
    };

    private static RenderFragment EngageMetric(string label, int val, int total, string icon) => __builder =>
    {
        <div class="ldd-em-row">
            <i class="bi @icon ldd-em-icon" aria-hidden="true"></i>
            <span class="ldd-em-lbl">@label</span>
            <span class="ldd-em-val">@val@(total > 0 ? $" / {total}" : "")</span>
        </div>;
    };

    private static RenderFragment EmptyState(string icon, string title, string sub) => __builder =>
    {
        <div class="ldd-empty">
            <i class="bi @icon ldd-empty-icon" aria-hidden="true"></i>
            <div class="ldd-empty-title">@title</div>
            <div class="ldd-empty-sub">@sub</div>
        </div>;
    };

