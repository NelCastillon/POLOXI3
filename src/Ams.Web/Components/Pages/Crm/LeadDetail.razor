    private static string AvatarColor(string name)
    {
        var colors = new[] { "ld-av1","ld-av2","ld-av3","ld-av4","ld-av5","ld-av6" };
        return colors[Math.Abs(name.GetHashCode()) % colors.Length];
    }

    private static string Initials(string name)
    {
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length > 0 ? name[..1] : "?";
    }

