    private async Task<Guid?> ResolveStoredDocumentIdAsync(LeadDocumentDto leadDocument)
    {
        var tenantId = leadDocument.TenantId != Guid.Empty ? leadDocument.TenantId : _lead?.TenantId ?? _tenantId;
        if (tenantId == Guid.Empty) return null;

        var storedDocuments = await Api.GetDocumentsByEntityAsync(tenantId, "CRM.Lead", LeadId) ?? [];
        var exact = storedDocuments.FirstOrDefault(d => d.DocumentId == leadDocument.DocumentId);
        if (exact is not null) return exact.DocumentId;

        return storedDocuments
            .OrderByDescending(d => d.CreatedDateUtc)
            .FirstOrDefault(d => IsStoredDocumentMatch(d, leadDocument))
            ?.DocumentId;
    }

    private static bool IsStoredDocumentMatch(DocumentDto storedDocument, LeadDocumentDto leadDocument)
    {
        if (!string.Equals(storedDocument.FileName, leadDocument.FileName, StringComparison.OrdinalIgnoreCase)) return false;
        if (!string.IsNullOrWhiteSpace(storedDocument.CategoryCode) && !string.Equals(storedDocument.CategoryCode, leadDocument.Category, StringComparison.OrdinalIgnoreCase)) return false;
        if (!storedDocument.FileSizeBytes.HasValue || leadDocument.SizeKb <= 0) return true;

        var minimumBytes = Math.Max(0, (leadDocument.SizeKb - 1) * 1024L);
        var maximumBytes = leadDocument.SizeKb * 1024L;
        return storedDocument.FileSizeBytes.Value > minimumBytes && storedDocument.FileSizeBytes.Value <= maximumBytes;
    }

    private static string NormalizeExtension(string? extension)
    {
        if (string.IsNullOrWhiteSpace(extension)) return string.Empty;
        var normalized = extension.Trim().ToLowerInvariant();
        return normalized.StartsWith('.') ? normalized : $".{normalized}";
    }

    private static string DocumentFileExtensionLabel(DocumentFileExtension extension) => DocumentFileExtensionValue(extension).ToUpperInvariant();

    private static string DocumentFileExtensionValue(DocumentFileExtension extension) => extension switch
    {
        DocumentFileExtension.Pdf => ".pdf",
        DocumentFileExtension.Doc => ".doc",
        DocumentFileExtension.Docx => ".docx",
        DocumentFileExtension.Xls => ".xls",
        DocumentFileExtension.Xlsx => ".xlsx",
        DocumentFileExtension.Csv => ".csv",
        DocumentFileExtension.Txt => ".txt",
        DocumentFileExtension.Png => ".png",
        DocumentFileExtension.Jpg => ".jpg",
        DocumentFileExtension.Jpeg => ".jpeg",
        _ => string.Empty
    };

    private static bool TryGetDocumentFileExtension(string fileName, out DocumentFileExtension extension)
    {
        var value = NormalizeExtension(Path.GetExtension(fileName));
        extension = Enum.GetValues<DocumentFileExtension>()
            .FirstOrDefault(option => string.Equals(DocumentFileExtensionValue(option), value, StringComparison.OrdinalIgnoreCase));

        return !string.IsNullOrWhiteSpace(value) && DocumentFileExtensionValue(extension).Length > 0;
    }

    private static string? TrimOrNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static bool IsPhoneValid(string? value) { if (string.IsNullOrWhiteSpace(value)) return true; var digits = new string(value.Where(char.IsDigit).ToArray()); if (digits.Length == 11 && digits[0] == '1') digits = digits[1..]; return digits.Length == 10; }
    private static string? NormalizePhone(string? value) { if (string.IsNullOrWhiteSpace(value)) return null; var digits = new string(value.Where(char.IsDigit).ToArray()); if (digits.Length == 11 && digits[0] == '1') digits = digits[1..]; return digits.Length == 10 ? $"({digits[..3]}) {digits.Substring(3, 3)}-{digits[6..]}" : value.Trim(); }

