        if (_convertForm.AccountMode == "Link")
        {
            _convertForm.ExistingAccountId = string.Empty;
            _convertAccountSearch = string.Empty;
            _showConvertAccountPicker = true;
            _focusConvertAccountPicker = true;
            await LoadConvertAccountCandidatesAsync();
        }
        else
        {
            _convertForm.ExistingAccountId = string.Empty;
            _showConvertAccountPicker = false;
        }
    }

