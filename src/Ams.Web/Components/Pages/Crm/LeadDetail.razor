    private sealed class ScoreFactor
    {
        public ScoreFactor(string label, int points, int maxPoints, bool positive)
        { Label = label; Points = points; MaxPoints = maxPoints; Positive = positive; }
        public static ScoreFactor FromDto(LeadScoreFactorDto dto)
        {
            var points = dto.Matched ? dto.Points : 0;
            return new ScoreFactor(dto.RuleName, points, Math.Max(Math.Abs(dto.Points), 1), points >= 0);
        }
        public string Label     { get; }
        public int    Points    { get; }
        public int    MaxPoints { get; }
        public bool   Positive  { get; }
        public double Pct       => MaxPoints == 0 ? 0 : Math.Abs(Points) / (double)MaxPoints * 100;
    }

