                        </div>
                        <div class="um-field">
                            <label>Priority <span class="text-danger">*</span></label>
                            <InputSelect class="um-input" @bind-Value="_interestForm.Priority">
                                @foreach (var priority in _priorityOptions)
                                {
                                    <option value="@priority.Value">@priority.Label</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _interestForm.Priority" class="text-danger" />
                        </div>
                        <div class="um-field"><label>Preferred Carrier</label><InputText class="um-input" @bind-Value="_interestForm.Carrier" /><ValidationMessage For="() => _interestForm.Carrier" class="text-danger" /></div>
                        <div class="um-field"><label>Current Carrier</label><InputText class="um-input" @bind-Value="_interestForm.CurrentCarrier" /><ValidationMessage For="() => _interestForm.CurrentCarrier" class="text-danger" /></div>
                        <div class="um-field"><label>Est. Premium</label><InputNumber class="um-input" @bind-Value="_interestForm.EstPremium" /><ValidationMessage For="() => _interestForm.EstPremium" class="text-danger" /></div>
                        <div class="um-field"><label>Expiry Date</label><InputDate class="um-input" @bind-Value="_interestForm.ExpiryDate" /><ValidationMessage For="() => _interestForm.ExpiryDate" class="text-danger" /></div>
                        <div class="um-field um-field--full"><label>Notes</label><InputText class="um-input" @bind-Value="_interestForm.Notes" /><ValidationMessage For="() => _interestForm.Notes" class="text-danger" /></div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showAddInterest = false">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary">
                        <i class="bi bi-check-lg" aria-hidden="true"></i> Add
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

