    private async Task CreateTabItemAsync()
    {
        if (_lead is null) return;
        switch (_tabForm.Kind)
        {
            case LeadTabItemKind.Contact:
                await Api.CreateLeadContactAsync(LeadId, BuildCreateContactRequest());
                if (_lead.AccountId is { } createAccountId)
                {
                    await SyncLeadContactFormToAccountAsync(createAccountId);
                }
                break;
            case LeadTabItemKind.InterestLine:
                await Api.CreateLeadInterestLineAsync(LeadId, BuildCreateInterestLineRequest());
                break;
            case LeadTabItemKind.Activity:
                await Api.CreateLeadActivityAsync(BuildCreateActivityRequest());
                break;
            case LeadTabItemKind.Communication:
                await Api.CreateLeadCommunicationAsync(LeadId, BuildCreateCommunicationRequest());
                break;
            case LeadTabItemKind.Campaign:
                await Api.CreateLeadCampaignAsync(LeadId, BuildCreateCampaignRequest());
                break;
            case LeadTabItemKind.Document:
                var uploadedDocumentId = await UploadLeadDocumentFileAsync();
                await Api.CreateLeadDocumentAsync(LeadId, BuildCreateDocumentRequest(uploadedDocumentId));
                break;
        }
    }

    private async Task UpdateTabItemAsync(Guid id)
    {
        switch (_tabForm.Kind)
        {
            case LeadTabItemKind.Contact:
                await Api.UpdateLeadContactAsync(LeadId, id, BuildUpdateContactRequest(id));
                if (_lead?.AccountId is { } updateAccountId)
                {
                    await SyncLeadContactFormToAccountAsync(updateAccountId);
                }
                break;
            case LeadTabItemKind.InterestLine:
                await Api.UpdateLeadInterestLineAsync(LeadId, id, BuildUpdateInterestLineRequest(id));
                break;
            case LeadTabItemKind.Activity:
                await Api.UpdateLeadActivityAsync(id, BuildUpdateActivityRequest(id));
                break;
            case LeadTabItemKind.Communication:
                await Api.UpdateLeadCommunicationAsync(LeadId, id, BuildUpdateCommunicationRequest(id));
                break;
            case LeadTabItemKind.Campaign:
                await Api.UpdateLeadCampaignAsync(LeadId, id, BuildUpdateCampaignRequest(id));
                break;
            case LeadTabItemKind.Document:
                await Api.UpdateLeadDocumentAsync(LeadId, id, BuildUpdateDocumentRequest(id));
                break;
        }
    }

    private async Task DeleteTabItemAsync(LeadTabItemKind kind, Guid id)
    {
        switch (kind)
        {
            case LeadTabItemKind.Contact:
                await Api.DeleteLeadContactAsync(id, _currentUserId == Guid.Empty ? null : _currentUserId);
                break;
            case LeadTabItemKind.InterestLine:
                await Api.DeleteLeadInterestLineAsync(id, _currentUserId == Guid.Empty ? null : _currentUserId);
                break;
            case LeadTabItemKind.Activity:
                await Api.DeleteLeadActivityAsync(id, _currentUserId == Guid.Empty ? null : _currentUserId);
                break;
            case LeadTabItemKind.Communication:
                await Api.DeleteLeadCommunicationAsync(id, _currentUserId == Guid.Empty ? null : _currentUserId);
                break;
            case LeadTabItemKind.Campaign:
                await Api.DeleteLeadCampaignAsync(id, _currentUserId == Guid.Empty ? null : _currentUserId);
                break;
            case LeadTabItemKind.Document:
                await Api.DeleteLeadDocumentAsync(id, _currentUserId == Guid.Empty ? null : _currentUserId);
