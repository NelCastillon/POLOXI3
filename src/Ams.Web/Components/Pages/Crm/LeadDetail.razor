        _showConvertAccountPicker = true;
    }

    private async Task LoadConvertAccountCandidatesAsync()
    {
        if (_lead is null) return;
        try
        {
            var search = TrimOrNull(_convertAccountSearch) ?? TrimOrNull(_lead.AccountName) ?? TrimOrNull(_lead.Email) ?? LeadDisplayName;
            var result = await Api.SearchAccountsAsync(_lead.TenantId, search, pageSize: 25);
            _accountCandidates = result?.Items?.ToList() ?? [];
            if (_lead.AccountId.HasValue && !_accountCandidates.Any(a => a.AccountId == _lead.AccountId.Value))
            {
                var account = await Api.GetAccountByIdAsync(_lead.AccountId.Value);
                if (account is not null)
                {
                    _accountCandidates.Insert(0, account);
                }
            }
        }
        catch (Exception ex)
        {
            ShowToast("danger", $"Account search failed: {ex.Message}");
        }
    }

    private static string ConvertAccountDisplay(AccountDto account)
    {
        var number = TrimOrNull(account.AccountNumber);
        return number is null ? Safe(account.AccountName, "Unnamed account") : $"{Safe(account.AccountName, "Unnamed account")} ({number})";
    }

    private static string ConvertAccountSubtitle(AccountDto account)
    {
        var parts = new[]
        {
            TrimOrNull(account.AccountNumber),
            TrimOrNull(account.MainEmail),
            TrimOrNull(account.MainPhone),
            TrimOrNull(account.StatusCode)
        }.Where(p => !string.IsNullOrWhiteSpace(p));

        return string.Join(" • ", parts);
    }

    private string BuildConvertOpportunityName(string accountName)
    {
        var lob = TrimOrNull(_convertForm.LineOfBusiness)
            ?? _interestLines.OrderByDescending(l => l.EstPremium).FirstOrDefault()?.LineOfBusiness
            ?? TrimOrNull(_lead?.InterestedService)
            ?? "Opportunity";

        return $"{Safe(accountName, "Account")} - {Safe(lob, "Opportunity")}";
    }

    private static string ReplaceConvertOpportunityLineOfBusiness(string opportunityName, string? oldLineOfBusiness, string? newLineOfBusiness)
    {
        var name = Safe(opportunityName, "Opportunity").Trim();
        var oldSuffix = TrimOrNull(oldLineOfBusiness);
        var newSuffix = TrimOrNull(newLineOfBusiness) ?? "Opportunity";
        var baseName = name;

        if (!string.IsNullOrWhiteSpace(oldSuffix) && name.EndsWith($" - {oldSuffix}", StringComparison.OrdinalIgnoreCase))
        {
            baseName = name[..^(oldSuffix.Length + 3)].Trim();
        }
        else if (name.EndsWith(" - Opportunity", StringComparison.OrdinalIgnoreCase))
        {
            baseName = name[..^14].Trim();
        }

        return $"{Safe(baseName, "Opportunity")} - {newSuffix}";
    }

    private async Task ExecuteConfirmedAsync()
    {
        if (_confirmAction is null) return;
        _busy = true;
        try
        {
            await _confirmAction.ExecuteAsync();
        }
        catch (Exception ex)
        {
            ShowToast("danger", $"Action failed: {ex.Message}");
        }
        finally
        {
            _busy = false;
        }
    }

    private UpdateLeadRequest BuildUpdateRequest(Guid? assignedToUserId, string? stage = null, int? statusCode = null, string? priorityCode = null, int? score = null, DateTime? qualifiedDate = null, Guid? accountId = null)
    {
        var source = _showEdit ? _editForm : null;
        return new()
        {
            LeadId = LeadId,
            AccountName = source?.AccountName?.Trim() ?? _lead?.AccountName,
            FirstName = source?.FirstName?.Trim() ?? _lead?.FirstName,
            LastName = source?.LastName?.Trim() ?? _lead?.LastName,
            Email = source?.Email?.Trim() ?? _lead?.Email,
            Phone = source?.Phone?.Trim() ?? _lead?.Phone,
            InterestedService = source?.InterestedService ?? _lead?.InterestedService,
            AnnualRevenue = source?.AnnualRevenue ?? _lead?.AnnualRevenue,
            Score = score ?? source?.Score ?? _lead?.Score,
            PriorityCode = priorityCode ?? source?.PriorityCode ?? _lead?.PriorityCode,
            SourceCode = source?.SourceCode ?? _lead?.SourceCode,
            NurturingStageCode = stage ?? source?.NurturingStageCode ?? _lead?.NurturingStageCode,
            StatusCode = statusCode ?? StageToStatusCode(stage ?? source?.NurturingStageCode ?? _lead?.NurturingStageCode),
            QualifiedDate = qualifiedDate ?? _lead?.QualifiedDate,
            AccountId = accountId ?? _lead?.AccountId,
            AssignedToUserId = assignedToUserId,
            UpdatedByUserId = _currentUserId == Guid.Empty ? null : _currentUserId
        };
    }

