    private async Task SaveTabItemAsync()
    {
        if (_lead is null) return;
        _tabValidationError = null;
        _busy = true;
        try
        {
            if (_editingTabItemId.HasValue)
            {
                await UpdateTabItemAsync(_editingTabItemId.Value);
            }
            else
            {
                await CreateTabItemAsync();
            }

            _showTabForm = false;
            await LoadAsync();
            ShowToast("success", $"{TabItemLabel(_tabForm.Kind)} saved.");
        }
        catch (Exception ex)
        {
            ShowToast("danger", $"Save failed: {ex.Message}");
        }
        finally
        {
            _busy = false;
        }
    }

