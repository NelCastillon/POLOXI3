@page "/crm/leads/{LeadId:guid}"
@page "/leads/{LeadId:guid}"
@namespace Ams.Web.Components.Pages.Crm
@using System.Globalization
@using Ams.Application.Common.Dtos
@using Ams.Application.Common.Validation
@using Ams.Application.Features.LeadActivities
@using Ams.Application.Features.Accounts
@using Ams.Application.Features.Contacts
@using Ams.Application.Features.Leads
@using Ams.Application.Features.Opportunities
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav

<PageTitle>@(_lead is null ? "Lead Detail" : $"{LeadDisplayName} - Lead Detail")</PageTitle>

@if (_toastVisible)
{
    <div class="ldd-toast ldd-toast--@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="ldd-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

        @if (SuppressedPhoneCount > 0)
        {
            <div class="ldd-dnc-alert" role="alert">
                <i class="bi bi-telephone-x-fill" aria-hidden="true"></i>
                <div><strong>Do Not Call restriction active</strong><span>@SuppressedPhoneCount phone number(s) are suppressed. Outbound calls, SMS, and campaign actions are enforced by the backend.</span></div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => SetTab(6)">Review compliance</button>
            </div>
        }

<EnterpriseDocumentPreview @ref="_documentPreview" />

<EnterpriseDocumentUpload @bind-IsOpen="_showDocumentUpload"
                          TenantId="_tenantId"
                          CreatedByUserId="_currentUserId"
                          EntityName="CRM.Lead"
                          EntityId="LeadId"
                          Title="Upload Lead Document"
                          IntroText="Upload and classify applications, statements, loss runs, and other supporting lead documents."
                          DefaultDocumentTypeCode="LEAD"
                          DefaultCategoryCode="CRM"
                          DefaultTags="Lead"
                          OnUploaded="HandleLeadDocumentUploadedAsync"
                          OnUploadFailed="HandleLeadDocumentUploadFailed" />

@if (_showEdit)
{
    <div class="ldd-modal-backdrop" role="presentation" @onclick="CloseEdit">
        <div class="ldd-enterprise-modal ldd-enterprise-modal--wide" role="dialog" aria-modal="true" aria-labelledby="leadEditTitle" @onclick:stopPropagation="true">
            <EditForm Model="_editForm" OnValidSubmit="SaveEditAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                    <span id="leadEditTitle">Edit lead</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseEdit" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field"><label>First name</label><InputText class="um-input" @bind-Value="_editForm.FirstName" /></div>
                        <div class="um-field"><label>Last name</label><InputText class="um-input" @bind-Value="_editForm.LastName" /></div>
                        <div class="um-field um-field-wide"><label>Company</label><InputText class="um-input" @bind-Value="_editForm.AccountName" /></div>
                        <div class="um-field"><label>Email</label><InputText class="um-input" type="email" @bind-Value="_editForm.Email" /><ValidationMessage For="() => _editForm.Email" class="text-danger" /></div>
                        <div class="um-field"><label>Phone</label><InputText class="um-input" type="tel" @bind-Value="_editForm.Phone" /><ValidationMessage For="() => _editForm.Phone" class="text-danger" /></div>
                        <div class="um-field"><label>Source</label><InputSelect class="um-input" @bind-Value="_editForm.SourceCode"><option value="">Select source</option>@foreach (var source in LeadSourceOptions) { <option value="@source.Code">@source.Label</option> }</InputSelect></div>
                        <div class="um-field"><label>Stage</label><InputSelect class="um-input" @bind-Value="_editForm.NurturingStageCode"><option value="">Select stage</option>@foreach (var stage in LeadStageOptions) { <option value="@stage.Code">@stage.Label</option> }</InputSelect></div>
                        <div class="um-field"><label>Priority</label><InputSelect class="um-input" @bind-Value="_editForm.PriorityCode"><option value="">Select priority</option>@foreach (var priority in LeadPriorityOptions) { <option value="@priority.Code">@priority.Label</option> }</InputSelect></div>
                        <div class="um-field"><label>Estimated premium</label><InputNumber class="um-input" @bind-Value="_editForm.AnnualRevenue" /></div>
                        <div class="um-field"><label>Score</label><InputNumber class="um-input" @bind-Value="_editForm.Score" /></div>
                        <div class="um-field"><label>Owner</label><InputSelect class="um-input" @bind-Value="_editForm.AssignedToUserId"><option value="">Unassigned</option>@foreach (var owner in _ownerOptions) { <option value="@owner.Value">@owner.Label</option> }</InputSelect></div>
                        <div class="um-field um-field-wide"><label>Interested service / notes</label><InputTextArea class="um-input" rows="4" @bind-Value="_editForm.InterestedService" /></div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseEdit" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy"><i class="bi bi-check2" aria-hidden="true"></i> Save lead</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showAssign)
{
    <div class="ldd-modal-backdrop" role="presentation" @onclick="CloseAssign">
        <div class="ldd-enterprise-modal" role="dialog" aria-modal="true" aria-labelledby="leadAssignTitle" @onclick:stopPropagation="true">
            <EditForm Model="_assignForm" OnValidSubmit="SaveAssignAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header">
                    <i class="bi bi-person-check" aria-hidden="true"></i>
                    <span id="leadAssignTitle">Assign lead</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseAssign" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field um-field-wide"><label>Owner</label><InputSelect class="um-input" @bind-Value="_assignForm.AssignedToUserId"><option value="">Select owner</option>@foreach (var owner in _ownerOptions) { <option value="@owner.Value">@owner.Label</option> }</InputSelect></div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseAssign" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy"><i class="bi bi-person-check" aria-hidden="true"></i> Assign</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showConvert)
{
    <div class="ldd-modal-backdrop" role="presentation" @onclick="CloseConvert">
        <div class="ldd-enterprise-modal ldd-enterprise-modal--wide" role="dialog" aria-modal="true" aria-labelledby="leadConvertTitle" @onclick:stopPropagation="true">
            <EditForm Model="_convertForm" OnValidSubmit="ConvertAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header">
                    <i class="bi bi-arrow-up-right-circle" aria-hidden="true"></i>
                    <span id="leadConvertTitle">Convert lead to Account + Opportunity</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseConvert" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="um-modal-body">
                    <div class="ldd-convert-flow" aria-label="Enterprise conversion path">
                        <span><i class="bi bi-person-lines-fill" aria-hidden="true"></i> Lead</span>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        <span><i class="bi bi-building" aria-hidden="true"></i> Account</span>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        <span><i class="bi bi-trophy" aria-hidden="true"></i> Opportunity</span>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        <span><i class="bi bi-send" aria-hidden="true"></i> Submission</span>
                    </div>
                    <div class="um-form-grid">
                        <div class="ldd-convert-section um-field-wide">
                            <div class="ldd-convert-section-head">
                                <span><i class="bi bi-building-gear" aria-hidden="true"></i> Account destination</span>
                                <small>Choose whether AMS creates a new account or links this lead to a persisted account.</small>
                            </div>
                            <div class="ldd-convert-mode-toggle" role="radiogroup" aria-label="Account handling">
                                <label class="ldd-convert-mode @( _convertForm.AccountMode == "Create" ? "ldd-convert-mode--active" : string.Empty )">
                                    <input type="radio" name="convertAccountMode" value="Create" checked="@(_convertForm.AccountMode == "Create")" @onchange="OnConvertAccountModeSelected" disabled="@_busy" />
                                    <span><i class="bi bi-plus-circle" aria-hidden="true"></i> Create new account</span>
                                    <small>Use the lead company and contact details.</small>
                                </label>
                                <label class="ldd-convert-mode @( _convertForm.AccountMode == "Link" ? "ldd-convert-mode--active" : string.Empty )">
                                    <input type="radio" name="convertAccountMode" value="Link" checked="@(_convertForm.AccountMode == "Link")" @onchange="OnConvertAccountModeSelected" disabled="@_busy" />
                                    <span><i class="bi bi-link-45deg" aria-hidden="true"></i> Link existing account</span>
                                    <small>Search DB accounts and convert under the selected account.</small>
                                </label>
                            </div>
                        </div>
                        @if (_convertForm.AccountMode == "Link")
                        {
                            <div class="ldd-account-picker um-field um-field-wide">
                                <label for="convertAccountPicker">Existing account</label>
                                <div class="ldd-account-combobox">
                                    <i class="bi bi-search" aria-hidden="true"></i>
                                    <input id="convertAccountPicker"
                                           @ref="_convertAccountPickerRef"
                                           class="um-input"
                                           value="@_convertAccountSearch"
                                           placeholder="Search DB accounts by name, number, or email"
                                           role="combobox"
                                           aria-expanded="@_showConvertAccountPicker"
                                           aria-controls="convertAccountPickerResults"
                                           autocomplete="off"
                                           disabled="@_busy"
                                           @onfocus="ShowConvertAccountPicker"
                                           @oninput="OnConvertAccountSearchInput" />
                                    @if (_convertForm.ExistingAccountGuid.HasValue)
                                    {
                                        <button type="button" class="ldd-account-clear" title="Clear selected account" @onclick="ClearConvertAccountSelection" disabled="@_busy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                                    }
                                </div>
                                <span class="ldd-field-hint @ConvertAccountPickerStatusClass">@ConvertAccountPickerStatus</span>
                                @if (_showConvertAccountPicker)
                                {
                                    <div id="convertAccountPickerResults" class="ldd-account-picker-menu" role="listbox">
                                        @if (_accountCandidates.Count == 0)
                                        {
                                            <div class="ldd-account-picker-empty">
                                                <i class="bi bi-database-exclamation" aria-hidden="true"></i>
                                                <span>No DB accounts found. Refine the search or create a new account.</span>
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var account in _accountCandidates)
                                            {
                                                <button type="button" class="ldd-account-option @(account.AccountId == _convertForm.ExistingAccountGuid ? "ldd-account-option--selected" : string.Empty)" role="option" aria-selected="@(account.AccountId == _convertForm.ExistingAccountGuid)" @onclick="() => SelectConvertAccount(account)" disabled="@_busy">
                                                    <span class="ldd-account-option-icon"><i class="bi bi-building" aria-hidden="true"></i></span>
                                                    <span class="ldd-account-option-main">
                                                        <strong>@Safe(account.AccountName, "Unnamed account")</strong>
                                                        <small>@ConvertAccountSubtitle(account)</small>
                                                    </span>
                                                    @if (account.AccountId == _convertForm.ExistingAccountGuid)
                                                    {
                                                        <i class="bi bi-check2-circle ldd-account-option-check" aria-hidden="true"></i>
                                                    }
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                            @if (SelectedConvertAccount is not null)
                            {
                                <div class="ldd-selected-account um-field-wide">
                                    <span class="ldd-selected-account-icon"><i class="bi bi-building-check" aria-hidden="true"></i></span>
                                    <span>
                                        <strong>@Safe(SelectedConvertAccount.AccountName, "Selected account")</strong>
                                        <small>@ConvertAccountSubtitle(SelectedConvertAccount)</small>
                                    </span>
                                </div>
                            }
                            <div class="validation-message-placeholder d-none">
                                <ValidationMessage For="() => _convertForm.ExistingAccountId" class="text-danger" />
                            </div>
                        }
                        else
                        {
                            <div class="um-field um-field-wide"><label>New account name</label><InputText class="um-input" @bind-Value="_convertForm.AccountName" /></div>
                        }
                        <div class="ldd-convert-section um-field-wide">
                            <div class="ldd-convert-section-head">
                                <span><i class="bi bi-trophy" aria-hidden="true"></i> Opportunity setup</span>
                                <small>Confirm the opportunity details that will be persisted during conversion.</small>
                            </div>
                            <div class="um-form-grid ldd-convert-inner-grid">
                                <div class="um-field um-field-wide"><label>Opportunity name</label><InputText class="um-input" @bind-Value="_convertForm.OpportunityName" /></div>
                                <div class="um-field"><label>Line of business</label><InputSelect TValue="string" class="um-input" Value="@_convertForm.LineOfBusiness" ValueChanged="@OnConvertLineOfBusinessChanged" ValueExpression="@(() => _convertForm.LineOfBusiness)"><option value="">Select line</option>@foreach (var line in _lineOfBusinessOptions) { <option value="@line.LobName">@line.LobName</option> }</InputSelect></div>
                                <div class="um-field"><label>Estimated premium</label><InputNumber class="um-input" @bind-Value="_convertForm.EstimatedAmount" /></div>
                                <div class="um-field"><label>Target close date</label><InputDate class="um-input" @bind-Value="_convertForm.CloseDate" /></div>
                                <div class="um-field"><label>Owner</label><InputSelect class="um-input" @bind-Value="_convertForm.OwnerUserId"><option value="">Use current owner</option>@foreach (var owner in _ownerOptions) { <option value="@owner.Value">@owner.Label</option> }</InputSelect></div>
                            </div>
                        </div>
                        <div class="ldd-convert-section um-field-wide">
                            <label class="ldd-convert-checkbox"><InputCheckbox @bind-Value="_convertForm.CreateSubmissionDraft" /> <span>Create draft submission during conversion</span></label>
                            <span class="ldd-text-muted">AMS creates the account, opportunity, and draft submission in one backend transaction, then opens the persisted submission.</span>
                            <div class="um-field ldd-convert-notes"><label>Conversion notes</label><InputTextArea class="um-input" rows="3" @bind-Value="_convertForm.Notes" /></div>
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseConvert" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy"><i class="bi bi-check2-circle" aria-hidden="true"></i> Convert to Account + Opportunity</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showTabForm)
{
    <div class="ldd-modal-backdrop" role="presentation">
        <div class="ldd-enterprise-modal ldd-enterprise-modal--wide" role="dialog" aria-modal="true" aria-labelledby="leadTabFormTitle" @onclick:stopPropagation="true">
            <EditForm Model="_tabForm" OnValidSubmit="SaveTabItemAsync" OnInvalidSubmit="HandleInvalidTabItemSubmit">
                <DataAnnotationsValidator />
                <div class="um-modal-header">
                    <i class="bi @TabFormIcon" aria-hidden="true"></i>
                    <span id="leadTabFormTitle">@TabFormTitle</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseTabForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="um-modal-body">
                    @if (!string.IsNullOrWhiteSpace(_tabValidationError))
                    {
                        <div class="login-alert login-alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                            @_tabValidationError
                        </div>
                    }
                    <div class="um-form-grid">
                        @if (_tabForm.Kind == LeadTabItemKind.Contact)
                        {
                            <div class="um-field"><label for="leadContactFirstName">First name <span class="text-danger">*</span></label><InputText id="leadContactFirstName" class="um-input" @bind-Value="_tabForm.FirstName" maxlength="150" autocomplete="given-name" /></div>
                            <div class="um-field"><label for="leadContactLastName">Last name <span class="text-danger">*</span></label><InputText id="leadContactLastName" class="um-input" @bind-Value="_tabForm.LastName" maxlength="150" autocomplete="family-name" /></div>
                            <div class="um-field"><label for="leadContactTitle">Title</label><InputText id="leadContactTitle" class="um-input" @bind-Value="_tabForm.Title" maxlength="200" autocomplete="organization-title" /><ValidationMessage For="() => _tabForm.Title" class="text-danger" /></div>
                            <div class="um-field"><label for="leadContactEmail">Email</label><InputText id="leadContactEmail" class="um-input" type="email" @bind-Value="_tabForm.Email" maxlength="300" autocomplete="email" /><ValidationMessage For="() => _tabForm.Email" class="text-danger" /></div>
                            <div class="um-field"><label for="leadContactPhone">Phone</label><InputText id="leadContactPhone" class="um-input" type="tel" @bind-Value="_tabForm.Phone" @bind-Value:after="OnTabContactPhoneChanged" maxlength="50" autocomplete="tel" /><ValidationMessage For="() => _tabForm.Phone" class="text-danger" />@if (!string.IsNullOrWhiteSpace(_tabForm.Phone)) { <span class="@TabContactPhoneHintClass">@TabContactPhoneStatusText</span> }</div>
                            <div class="um-field"><label><InputCheckbox @bind-Value="_tabForm.IsPrimary" /> Primary contact</label></div>
                        }
                        else if (_tabForm.Kind == LeadTabItemKind.InterestLine)
                        {
                            <div class="um-field"><label>Line of business <span class="text-danger">*</span></label><InputSelect class="um-input" @bind-Value="_tabForm.LineOfBusiness"><option value="">Select line</option>@foreach (var line in LineOfBusinessOptions) { <option value="@line.LobName">@line.LobName</option> }</InputSelect></div>
                            <div class="um-field"><label>Target carrier</label><InputSelect class="um-input" @bind-Value="_tabForm.Carrier"><option value="">Select target carrier</option>@foreach (var carrier in CarrierOptions) { <option value="@carrier.CarrierName">@carrier.CarrierName</option> }</InputSelect></div>
                            <div class="um-field"><label>Current carrier</label><InputSelect class="um-input" @bind-Value="_tabForm.CurrentCarrier"><option value="">Select current carrier</option>@foreach (var carrier in CarrierOptions) { <option value="@carrier.CarrierName">@carrier.CarrierName</option> }</InputSelect></div>
                            <div class="um-field"><label>Estimated premium</label><InputNumber class="um-input" @bind-Value="_tabForm.EstPremium" /></div>
                            <div class="um-field"><label>Expiration</label><InputDate class="um-input" @bind-Value="_tabForm.ExpiryDate" /></div>
                            <div class="um-field"><label>Priority <span class="text-danger">*</span></label><InputSelect class="um-input" @bind-Value="_tabForm.Priority"><option value="">Select priority</option>@foreach (var priority in LeadPriorityOptions) { <option value="@priority.Code">@priority.Label</option> }</InputSelect></div>
                            <div class="um-field um-field-wide ldd-interest-notes-field"><label>Notes</label><InputTextArea class="um-input" rows="4" @bind-Value="_tabForm.Notes" /></div>
                        }
                        else if (_tabForm.Kind == LeadTabItemKind.Activity)
                        {
                            <div class="um-field"><label>Type <span class="text-danger">*</span></label><InputSelect class="um-input" @bind-Value="_tabForm.ActivityTypeCode" @bind-Value:after="OnActivityTypeChanged"><option value="">Select type</option>@foreach (var type in ActivityTypeOptions) { <option value="@type">@type</option> }</InputSelect></div>
                            <div class="um-field"><label>Activity date <span class="text-danger">*</span></label><InputDate class="um-input" @bind-Value="_tabForm.ActivityDate" /></div>
                            <div class="um-field um-field-wide"><label>Subject <span class="text-danger">*</span></label><InputText class="um-input" @bind-Value="_tabForm.Subject" /></div>
                            <div class="um-field"><label>Duration minutes</label><InputNumber class="um-input" @bind-Value="_tabForm.DurationMinutes" /></div>
                            <div class="um-field"><label>Outcome</label><InputSelect class="um-input" @bind-Value="_tabForm.OutcomeCode"><option value="">Select outcome</option>@foreach (var outcome in ActivityOutcomeOptions) { <option value="@outcome.OutcomeCode">@outcome.OutcomeName</option> }</InputSelect></div>
                            <div class="um-field"><label><InputCheckbox @bind-Value="_tabForm.IsCompleted" /> Completed</label></div>
                            <div class="um-field um-field-wide ldd-activity-notes-field"><label>Notes</label><InputTextArea class="um-input" rows="4" @bind-Value="_tabForm.Notes" /></div>
                        }
                        else if (_tabForm.Kind == LeadTabItemKind.Communication)
                        {
                            <div class="um-field"><label>Channel <span class="text-danger">*</span></label><InputSelect class="um-input" @bind-Value="_tabForm.Channel"><option value="">Select channel</option>@foreach (var option in CommunicationChannelOptions) { <option value="@option.Code">@option.Label</option> }</InputSelect></div>
                            <div class="um-field"><label>Direction <span class="text-danger">*</span></label><InputSelect class="um-input" @bind-Value="_tabForm.Direction"><option value="">Select direction</option>@foreach (var option in CommunicationDirectionOptions) { <option value="@option.Code">@option.Label</option> }</InputSelect></div>
                            <div class="um-field"><label>Sent at <span class="text-danger">*</span></label><InputDate class="um-input" @bind-Value="_tabForm.SentAt" /></div>
                            <div class="um-field"><label>Delivery <span class="text-danger">*</span></label><InputSelect class="um-input" @bind-Value="_tabForm.DeliveryStatus"><option value="">Select delivery</option>@foreach (var option in CommunicationDeliveryOptions) { <option value="@option.Code">@option.Label</option> }</InputSelect></div>
                            <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect class="um-input" @bind-Value="_tabForm.EngagementStatus"><option value="">Select status</option>@foreach (var option in CommunicationStatusOptions) { <option value="@option.Code">@option.Label</option> }</InputSelect></div>
                            <div class="um-field um-field-wide"><label>Subject <span class="text-danger">*</span></label><InputText class="um-input" @bind-Value="_tabForm.Subject" /></div>
                            <div class="um-field"><label><InputCheckbox @bind-Value="_tabForm.Opened" /> Opened</label></div>
                            <div class="um-field"><label><InputCheckbox @bind-Value="_tabForm.Clicked" /> Clicked</label></div>
                            <div class="um-field"><label><InputCheckbox @bind-Value="_tabForm.IsAutomated" /> Automated</label></div>
                            <div class="um-field um-field-wide ldd-communication-preview-field"><label>Preview <span class="text-danger">*</span></label><InputTextArea class="um-input" rows="4" @bind-Value="_tabForm.Preview" /></div>
                        }
                        else if (_tabForm.Kind == LeadTabItemKind.Campaign)
                        {
                            <div class="um-field um-field-wide"><label>Campaign catalog</label><InputSelect class="um-input" @bind-Value="_tabForm.CampaignId" @bind-Value:after="OnCampaignOptionChanged"><option value="">Select DB campaign</option>@foreach (var campaign in _campaignOptions) { <option value="@campaign.CampaignId">@campaign.Name - @campaign.Status</option> }</InputSelect></div>
                            <div class="um-field um-field-wide"><label>Campaign name <span class="text-danger">*</span></label><InputText class="um-input" @bind-Value="_tabForm.CampaignName" /></div>
                            <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect class="um-input" @bind-Value="_tabForm.CampaignStatus"><option value="">Select status</option>@foreach (var option in CampaignStatusOptions) { <option value="@option.Code">@option.Label</option> }</InputSelect></div>
                            <div class="um-field"><label>Type</label><InputText class="um-input" @bind-Value="_tabForm.CampaignType" /></div>
                            <div class="um-field"><label>Segment</label><InputText class="um-input" @bind-Value="_tabForm.Segment" /></div>
                            <div class="um-field"><label>Enrolled at <span class="text-danger">*</span></label><InputDate class="um-input" @bind-Value="_tabForm.EnrolledAt" /></div>
                            <div class="um-field"><label>Last touch</label><InputDate class="um-input" @bind-Value="_tabForm.LastTouch" /></div>
                            <div class="um-field"><label>Emails sent</label><InputNumber class="um-input" @bind-Value="_tabForm.EmailsSent" /></div>
                            <div class="um-field"><label>Emails opened</label><InputNumber class="um-input" @bind-Value="_tabForm.EmailsOpen" /></div>
                            <div class="um-field"><label>Clicks</label><InputNumber class="um-input" @bind-Value="_tabForm.Clicks" /></div>
                            <div class="um-field"><label>Open rate</label><InputNumber class="um-input" @bind-Value="_tabForm.OpenRate" /></div>
                            <div class="um-field"><label>Conversions</label><InputNumber class="um-input" @bind-Value="_tabForm.Conversions" /></div>
                            <div class="um-field"><label>Revenue</label><InputNumber class="um-input" @bind-Value="_tabForm.Revenue" /></div>
                        }
                        else if (_tabForm.Kind == LeadTabItemKind.Document)
                        {
                            @if (!_editingTabItemId.HasValue)
                            {
                                <div class="um-field um-field-wide"><label>Document file <span class="text-danger">*</span></label><InputFile class="um-input" OnChange="OnLeadDocumentSelected" accept="@DocumentAcceptExtensions" />@if (_selectedDocumentFile is not null) { <small class="ldd-text-muted">@_selectedDocumentFile.Name (@SizeText((int)Math.Ceiling(_selectedDocumentFile.Size / 1024m))) selected</small> }</div>
                            }
                            <div class="um-field um-field-wide"><label>File name <span class="text-danger">*</span></label><InputText class="um-input" @bind-Value="_tabForm.FileName" /></div>
                            <div class="um-field"><label>Extension <span class="text-danger">*</span></label><InputSelect class="um-input" @bind-Value="_tabForm.Extension"><option value="">Select type</option>@foreach (var extension in Enum.GetValues<DocumentFileExtension>()) { <option value="@DocumentFileExtensionValue(extension)">@DocumentFileExtensionLabel(extension)</option> }</InputSelect></div>
                            <div class="um-field"><label>Category <span class="text-danger">*</span></label><InputSelect class="um-input" @bind-Value="_tabForm.Category"><option value="">Select category</option>@foreach (var category in DocumentCategoryOptions) { <option value="@Safe(category.Name, category.Code)">@Safe(category.Name, category.Code)</option> }</InputSelect></div>
                            <div class="um-field"><label>Size KB</label><InputNumber class="um-input" @bind-Value="_tabForm.SizeKb" disabled="@(_selectedDocumentFile is not null)" /></div>
                            <div class="um-field"><label>Uploaded at <span class="text-danger">*</span></label><InputDate class="um-input" @bind-Value="_tabForm.UploadedAt" /></div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseTabForm" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy"><i class="bi bi-check2" aria-hidden="true"></i> @(_editingTabItemId.HasValue ? "Save item" : "Create item")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showSuppressionForm && _selectedCompliancePhone is not null)
{
    <div class="ldd-modal-backdrop" role="presentation" @onclick="CloseSuppressionForm">
        <div class="ldd-enterprise-modal ldd-enterprise-modal--wide" role="dialog" aria-modal="true" aria-labelledby="suppressionTitle" @onclick:stopPropagation="true">
            <EditForm Model="_suppressionForm" OnValidSubmit="SaveSuppressionAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header">
                    <i class="bi bi-telephone-x" aria-hidden="true"></i>
                    <span id="suppressionTitle">Add phone suppression</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseSuppressionForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field um-field-wide"><label>Phone</label><InputText class="um-input" @bind-Value="_suppressionForm.PhoneNumber" disabled /></div>
                    <div class="um-field"><label>Source</label><InputSelect class="um-input" @bind-Value="_suppressionForm.SourceCode"><option value="">Select source</option>@foreach (var option in ComplianceOptions("SuppressionSource")) { <option value="@option.Code">@option.Name</option> }</InputSelect></div>
                    <div class="um-field"><label>Reason</label><InputSelect class="um-input" @bind-Value="_suppressionForm.ReasonCode"><option value="">Select reason</option>@foreach (var option in ComplianceOptions("SuppressionReason")) { <option value="@option.Code">@option.Name</option> }</InputSelect></div>
                    <div class="um-field"><label>Channel</label><InputSelect class="um-input" @bind-Value="_suppressionForm.ChannelCode"><option value="">Select channel</option>@foreach (var option in ComplianceOptions("Channel")) { <option value="@option.Code">@option.Name</option> }</InputSelect></div>
                    <div class="um-field"><label>Purpose</label><InputSelect class="um-input" @bind-Value="_suppressionForm.PurposeCode"><option value="">All purposes</option>@foreach (var option in ComplianceOptions("Purpose")) { <option value="@option.Code">@option.Name</option> }</InputSelect></div>
                    <div class="um-field"><label>Effective date</label><InputDate class="um-input" Type="InputDateType.DateTimeLocal" @bind-Value="_suppressionForm.EffectiveDateUtc" /></div>
                    <div class="um-field"><label>Expiration date</label><InputDate class="um-input" Type="InputDateType.DateTimeLocal" @bind-Value="_suppressionForm.ExpirationDateUtc" /></div>
                    <div class="um-field um-field-wide"><label>Evidence reference</label><InputText class="um-input" @bind-Value="_suppressionForm.EvidenceReference" /></div>
                    <div class="um-field um-field-wide"><label>Notes</label><InputTextArea class="um-input" rows="3" @bind-Value="_suppressionForm.Notes" /></div>
                </div></div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseSuppressionForm" disabled="@_busy">Cancel</button><button type="submit" class="um-btn um-btn-danger" disabled="@_busy"><i class="bi bi-shield-x"></i> Apply suppression</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showConsentForm && _selectedCompliancePhone is not null)
{
    <div class="ldd-modal-backdrop" role="presentation" @onclick="CloseConsentForm">
        <div class="ldd-enterprise-modal ldd-enterprise-modal--wide" role="dialog" aria-modal="true" aria-labelledby="consentTitle" @onclick:stopPropagation="true">
            <EditForm Model="_consentForm" OnValidSubmit="SaveConsentAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header">
                    <i class="bi bi-file-earmark-check" aria-hidden="true"></i>
                    <span id="consentTitle">Record documented consent</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseConsentForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field um-field-wide"><label>Phone</label><InputText class="um-input" @bind-Value="_consentForm.PhoneNumber" disabled /></div>
                    <div class="um-field"><label>Consent type</label><InputSelect class="um-input" @bind-Value="_consentForm.ConsentTypeCode"><option value="">Select consent type</option>@foreach (var option in ComplianceOptions("ConsentType")) { <option value="@option.Code">@option.Name</option> }</InputSelect></div>
                    <div class="um-field"><label>Channel</label><InputSelect class="um-input" @bind-Value="_consentForm.ChannelCode"><option value="">Select channel</option>@foreach (var option in ComplianceOptions("Channel")) { <option value="@option.Code">@option.Name</option> }</InputSelect></div>
                    <div class="um-field"><label>Purpose</label><InputSelect class="um-input" @bind-Value="_consentForm.PurposeCode"><option value="">Select purpose</option>@foreach (var option in ComplianceOptions("Purpose")) { <option value="@option.Code">@option.Name</option> }</InputSelect></div>
                    <div class="um-field"><label>Legal basis</label><InputSelect class="um-input" @bind-Value="_consentForm.LegalBasisCode"><option value="">Select legal basis</option>@foreach (var option in ComplianceOptions("LegalBasis")) { <option value="@option.Code">@option.Name</option> }</InputSelect></div>
                    <div class="um-field"><label>Evidence type</label><InputSelect class="um-input" @bind-Value="_consentForm.EvidenceTypeCode"><option value="">Select evidence</option>@foreach (var option in ComplianceOptions("EvidenceType")) { <option value="@option.Code">@option.Name</option> }</InputSelect></div>
                    <div class="um-field"><label>Evidence reference</label><InputText class="um-input" @bind-Value="_consentForm.EvidenceReference" /></div>
                    <div class="um-field"><label>Captured date</label><InputDate class="um-input" Type="InputDateType.DateTimeLocal" @bind-Value="_consentForm.CapturedDateUtc" /></div>
                    <div class="um-field"><label>Expiration date</label><InputDate class="um-input" Type="InputDateType.DateTimeLocal" @bind-Value="_consentForm.ExpirationDateUtc" /></div>
                    <div class="um-field um-field-wide"><label>Consent text / evidence notes</label><InputTextArea class="um-input" rows="4" @bind-Value="_consentForm.ConsentText" /></div>
                </div></div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseConsentForm" disabled="@_busy">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_busy"><i class="bi bi-check2-circle"></i> Record consent</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_confirmAction is not null)
{
    <div class="ldd-modal-backdrop" role="presentation" @onclick="CloseConfirm">
        <div class="ldd-enterprise-modal" role="dialog" aria-modal="true" aria-labelledby="leadConfirmTitle" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi @_confirmAction.Icon" aria-hidden="true"></i>
                <span id="leadConfirmTitle">@_confirmAction.Title</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseConfirm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-modal-body"><p class="ldd-notes">@_confirmAction.Message</p></div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CloseConfirm" disabled="@_busy">Cancel</button>
                <button type="button" class="um-btn @_confirmAction.ButtonClass" @onclick="ExecuteConfirmedAsync" disabled="@_busy">@_confirmAction.ButtonText</button>
            </div>
        </div>
    </div>
}

@if (_loading)
{
    <div class="ldd-page-shell">
        <div class="ldd-loading"><span class="um-spin" aria-hidden="true"></span><span>Loading lead detail...</span></div>
    </div>
}
else if (_lead is null)
{
    <div class="ldd-page-shell">
        <div class="ldd-not-found">
            <i class="bi bi-person-x ldd-not-found-icon" aria-hidden="true"></i>
            <h2>Lead not found</h2>
            <p>The selected CRM lead could not be loaded from the existing lead workflow.</p>
            <button type="button" class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/crm/leads")'><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Leads</button>
        </div>
    </div>
}
else
{
    <div class="ldd-page-shell">
        <AppPageHeader Title="@LeadDisplayName" Subtitle="@LeadHeaderSubtitle" Icon="bi-person-lines-fill" ReturnUrl="/crm/leads" ReturnLabel="Back to Leads">
            <Actions>
                <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
            </Actions>
        </AppPageHeader>

        @if (_loadError is not null)
        {
            <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <span>@_loadError</span>
            </div>
        }

        <section class="ldd-id-strip" aria-label="Lead identity">
            <span class="ldd-avatar @AvatarClass(LeadDisplayName)">@Initials(LeadDisplayName)</span>
            <div class="ldd-id-meta">
                <span class="ldd-meta-chip ldd-mono"><i class="bi bi-hash" aria-hidden="true"></i> @Safe(_lead.LeadNumber, "Unnumbered")</span>
                <span class="@StageBadge(_lead.NurturingStageCode)">@StageLabel</span>
                <span class="@PriorityBadge(_lead.PriorityCode)">@PriorityLabel</span>
                <span class="ldd-source-chip"><i class="bi bi-megaphone" aria-hidden="true"></i> @Safe(_lead.SourceCode, "Unknown source")</span>
                <span class="ldd-meta-chip"><i class="bi bi-building" aria-hidden="true"></i> @Safe(_lead.AccountName, "No account")</span>
                <span class="ldd-meta-chip"><i class="bi bi-calendar3" aria-hidden="true"></i> Created @_lead.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy")</span>
            </div>
        </section>

        <section class="ldd-command-center" aria-label="Lead command center">
            <article class="ldd-command-card ldd-command-card--primary">
                <span class="ldd-command-eyebrow">Conversion readiness</span>
                <div class="ldd-readiness-row"><strong>@ReadinessPercent%</strong><span>@ReadinessLabel</span></div>
                <div class="ldd-progress-track"><div class="ldd-progress-fill" style="width:@ReadinessPercent%"></div></div>
                <small>@ReadinessDetail</small>
            </article>
            <article class="ldd-command-card">
                <span class="ldd-command-label">Lead score</span>
                <strong>@ScoreDisplay</strong>
                <small>@MatchedScoreFactors of @_scoreFactors.Count score factor(s) matched</small>
            </article>
            <article class="ldd-command-card">
                <span class="ldd-command-label">Estimated premium</span>
                <strong>@Money(_lead.AnnualRevenue)</strong>
                <small>@_interestLines.Count line(s) of interest totaling @Money(_interestLines.Sum(l => l.EstPremium))</small>
            </article>
            <article class="ldd-command-card">
                <span class="ldd-command-label">Last touch</span>
                <strong>@LastTouchText</strong>
                <small>@_activities.Count activity item(s), @_communications.Count communication(s)</small>
            </article>
        </section>

        <section class="ldd-kpi-strip" aria-label="Lead detail KPI filters">
            <button type="button" class="@KpiClass(0)" title="Show lead overview" @onclick="() => SetTab(0)"><span class="ldd-kpi-icon ldd-kpi-icon--blue"><i class="bi bi-person-vcard" aria-hidden="true"></i></span><span class="ldd-kpi-label">Overview</span><strong>@ReadinessPercent%</strong><small>Lead readiness</small></button>
            <button type="button" class="@KpiClass(1)" title="Show contacts" @onclick="() => SetTab(1)"><span class="ldd-kpi-icon ldd-kpi-icon--green"><i class="bi bi-people" aria-hidden="true"></i></span><span class="ldd-kpi-label">Contacts</span><strong>@_contacts.Count</strong><small>@PrimaryContactText</small></button>
            <button type="button" class="@KpiClass(2)" title="Show coverage interest" @onclick="() => SetTab(2)"><span class="ldd-kpi-icon ldd-kpi-icon--purple"><i class="bi bi-shield-plus" aria-hidden="true"></i></span><span class="ldd-kpi-label">Interest</span><strong>@_interestLines.Count</strong><small>@Money(_interestLines.Sum(l => l.EstPremium)) total</small></button>
            <button type="button" class="@KpiClass(3)" title="Show activities" @onclick="() => SetTab(3)"><span class="ldd-kpi-icon ldd-kpi-icon--amber"><i class="bi bi-lightning-charge" aria-hidden="true"></i></span><span class="ldd-kpi-label">Activity</span><strong>@_activities.Count</strong><small>@CompletedActivityText</small></button>
            <button type="button" class="@KpiClass(4)" title="Show communications and campaigns" @onclick="() => SetTab(4)"><span class="ldd-kpi-icon ldd-kpi-icon--teal"><i class="bi bi-broadcast" aria-hidden="true"></i></span><span class="ldd-kpi-label">Engagement</span><strong>@EngagementScoreDisplay</strong><small>@EngagementLevel</small></button>
            <button type="button" class="@KpiClass(5)" title="Show documents" @onclick="() => SetTab(5)"><span class="ldd-kpi-icon ldd-kpi-icon--slate"><i class="bi bi-folder2-open" aria-hidden="true"></i></span><span class="ldd-kpi-label">Documents</span><strong>@_documents.Count</strong><small>@DocumentSizeText</small></button>
            <button type="button" class="@KpiClass(6)" title="Show phone compliance" @onclick="() => SetTab(6)"><span class="ldd-kpi-icon ldd-kpi-icon--danger"><i class="bi bi-shield-lock" aria-hidden="true"></i></span><span class="ldd-kpi-label">Phone Compliance</span><strong>@SuppressedPhoneCount</strong><small>@(SuppressedPhoneCount == 0 ? "No active DNC" : "Suppressed")</small></button>
        </section>

        <div class="ldd-layout">
            <main class="ldd-tabs-col">
                <section class="ldd-native-tabs" role="tablist" aria-label="Lead detail sections">
                    @foreach (var tab in _tabs)
                    {
                        <button type="button" class="@TabClass(tab.Index)" role="tab" aria-selected="@(_activeTab == tab.Index)" @onclick="() => SetTab(tab.Index)">
                            <i class="bi @tab.Icon" aria-hidden="true"></i>
                            <span>@tab.Label</span>
                            <strong>@TabCount(tab.Key)</strong>
                        </button>
                    }
                </section>

                <section class="ldd-native-panels">
                    @if (_activeTab == 0)
                    {
                        <div class="ldd-tab-body">
                            <div class="ldd-info-card">
                                <h2 class="ldd-section-hdr">Lead profile</h2>
                                <div class="ldd-field-grid">
                                    @DetailField("Lead #", Safe(_lead.LeadNumber, "-"))
                                    @DetailField("Status", StatusLabel(_lead.StatusCode))
                                    @DetailField("Stage", StageLabel)
                                    @DetailField("Priority", PriorityLabel)
                                    @DetailField("Source", Safe(_lead.SourceCode, "-"))
                                    @DetailField("Company", Safe(_lead.AccountName, "-"))
                                    @DetailField("Email", Safe(_lead.Email, "-"))
                                    @DetailField("Phone", Safe(_lead.Phone, "-"))
                                    @DetailField("Assigned User", OwnerName)
                                    @DetailField("Qualified", _lead.QualifiedDate?.ToLocalTime().ToString("MMM d, yyyy") ?? "Not qualified")
                                    @DetailField("Created", _lead.CreatedDateUtc.ToLocalTime().ToString("f"))
                                    @DetailField("Modified", _lead.ModifiedDateUtc?.ToLocalTime().ToString("f") ?? "-")
                                </div>
                            </div>
                            <div class="ldd-info-card">
                                <h2 class="ldd-section-hdr">Interested service / notes</h2>
                                <p class="ldd-notes">@Safe(_lead.InterestedService, "No service interest or notes have been captured for this lead.")</p>
                            </div>
                            <div class="ldd-info-card">
                                <h2 class="ldd-section-hdr">Conversion checklist</h2>
                                <div class="ldd-field-grid">
                                    @ChecklistField("Identity", HasIdentity, "Name, company, and contact detail")
                                    @ChecklistField("Primary contact", _contacts.Any(c => c.IsPrimary), "A decision-maker marked primary")
                                    @ChecklistField("Coverage interest", _interestLines.Count > 0, "At least one line of business")
                                    @ChecklistField("Engagement", TotalEngagementEvents > 0, "Activities, communications, or campaigns")
                                    @ChecklistField("Documents", _documents.Count > 0, "Supporting files attached")
                                    @ChecklistField("Qualified", _lead.QualifiedDate.HasValue || string.Equals(_lead.NurturingStageCode, "Qualified", StringComparison.OrdinalIgnoreCase), "Ready for opportunity workflow")
                                </div>
                            </div>
                        </div>
                    }
                    else if (_activeTab == 1)
                    {
                        <div class="ldd-tab-body">
                            <div class="ldd-tab-toolbar"><span class="ldd-tab-count">@_contacts.Count contact(s)</span><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenCreateTabItem(LeadTabItemKind.Contact)"><i class="bi bi-person-plus" aria-hidden="true"></i> Add contact</button></div>
                            @if (_contacts.Count == 0)
                            {
                                @EmptyState("bi-person-plus", "No contacts", "Add stakeholders and decision makers from the lead workflow to complete the profile.")
                            }
                            else
                            {
                                <div class="ldd-contact-list">
                                    @foreach (var contact in _contacts.OrderByDescending(c => c.IsPrimary).ThenBy(c => c.LastName).ThenBy(c => c.FirstName))
                                    {
                                        <article class="ldd-contact-card">
                                            <span class="ldd-contact-avatar @AvatarClass(ContactName(contact))">@Initials(ContactName(contact))</span>
                                            <div class="ldd-contact-body">
                                                <div class="ldd-contact-name">@ContactName(contact)</div>
                                                <div class="ldd-contact-title">@Safe(contact.Title, "Stakeholder")</div>
                                                <div class="ldd-contact-links">
                                                    @if (!string.IsNullOrWhiteSpace(contact.Email))
                                                    {
                                                        <a class="ldd-contact-link" href="mailto:@contact.Email"><i class="bi bi-envelope" aria-hidden="true"></i>@contact.Email</a>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(contact.Phone))
                                                    {
                                                        <a class="ldd-contact-link" href="tel:@contact.Phone"><i class="bi bi-telephone" aria-hidden="true"></i>@contact.Phone</a>
                                                    }
                                                </div>
                                            </div>
                                            @if (contact.IsPrimary)
                                            {
                                                <span class="ldd-primary-badge">Primary</span>
                                            }
                                            <div class="d-flex gap-2">
                                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditTabItem(contact)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                                <button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteTabItem(LeadTabItemKind.Contact, contact.ContactId, ContactName(contact))"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (_activeTab == 2)
                    {
                        <div class="ldd-tab-body">
                            <div class="ldd-tab-toolbar"><span class="ldd-tab-count">@_interestLines.Count line(s) of interest</span><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenCreateTabItem(LeadTabItemKind.InterestLine)"><i class="bi bi-shield-plus" aria-hidden="true"></i> Add interest</button></div>
                            @if (_interestLines.Count == 0)
                            {
                                @EmptyState("bi-shield-plus", "No coverage interest", "Capture lines of business, current carriers, premium, and expiration dates for this lead.")
                            }
                            else
                            {
                                <div class="ldd-table-wrap"><table class="ldd-enterprise-table"><thead><tr><th>Line</th><th>Target carrier</th><th>Current carrier</th><th>Expiration</th><th>Priority</th><th class="ldd-text-end">Est. premium</th><th class="ldd-text-end">Actions</th></tr></thead><tbody>
                                    @foreach (var line in _interestLines.OrderByDescending(l => l.EstPremium))
                                    {
                                        <tr><td><strong>@line.LineOfBusiness</strong><div class="ldd-text-muted">@Safe(line.Notes, "-")</div></td><td>@Safe(line.Carrier, "-")</td><td>@Safe(line.CurrentCarrier, "-")</td><td class="@ExpiryClass(line.ExpiryDate)">@DateOrDash(line.ExpiryDate)</td><td><span class="@LinePriorityBadge(line.Priority)">@line.Priority</span></td><td class="ldd-text-end ldd-mono ldd-bold">@Money(line.EstPremium)</td><td class="ldd-text-end"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditTabItem(line)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteTabItem(LeadTabItemKind.InterestLine, line.InterestLineId, line.LineOfBusiness)"><i class="bi bi-trash" aria-hidden="true"></i></button></td></tr>
                                    }
                                </tbody></table></div>
                            }
                        </div>
                    }
                    else if (_activeTab == 3)
                    {
                        <div class="ldd-tab-body">
                            <div class="ldd-tab-toolbar"><span class="ldd-tab-count">@_activities.Count activit@(_activities.Count == 1 ? "y" : "ies")</span><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenCreateTabItem(LeadTabItemKind.Activity)"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Add activity</button></div>
                            @if (_activities.Count == 0)
                            {
                                @EmptyState("bi-lightning-charge", "No activities", "Lead calls, meetings, notes, and follow-ups will appear here.")
                            }
                            else
                            {
                                <div class="ldd-timeline">
                                    @foreach (var activity in _activities.OrderByDescending(a => a.ActivityDate))
                                    {
                                        <article class="ldd-tl-item">
                                            <span class="ldd-tl-icon @ActivityIconClass(activity.ActivityTypeCode)"><i class="bi @ActivityIcon(activity.ActivityTypeCode)" aria-hidden="true"></i></span>
                                            <div class="ldd-tl-body">
                                                <div class="ldd-tl-hdr"><span class="ldd-tl-type">@activity.ActivityTypeCode</span><span class="ldd-tl-by">@Safe(activity.ProducerName, "Unassigned")</span><span class="ldd-tl-when">@activity.ActivityDate.ToLocalTime().ToString("g")</span></div>
                                                <div class="ldd-tl-subject">@activity.Subject</div>
                                                @if (!string.IsNullOrWhiteSpace(activity.Notes))
                                                {
                                                    <p class="ldd-tl-notes">@activity.Notes</p>
                                                }
                                                <div class="ldd-tl-follow"><i class="bi @(activity.IsCompleted ? "bi-check-circle" : "bi-clock")" aria-hidden="true"></i>@(activity.IsCompleted ? "Completed" : "Open")@DurationText(activity)</div>
                                                <div class="d-flex gap-2 mt-2"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditTabItem(activity)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteTabItem(LeadTabItemKind.Activity, activity.ActivityId, activity.Subject)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (_activeTab == 4)
                    {
                        <div class="ldd-tab-body">
                            <div class="ldd-tab-toolbar"><span class="ldd-tab-count">@_communications.Count communication(s), @_campaigns.Count campaign(s)</span><div class="d-flex gap-2"><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenCreateTabItem(LeadTabItemKind.Communication)"><i class="bi bi-chat-dots" aria-hidden="true"></i> Add communication</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenCreateTabItem(LeadTabItemKind.Campaign)"><i class="bi bi-megaphone" aria-hidden="true"></i> Add campaign</button></div></div>
                            <div class="ldd-info-card">
                                <h2 class="ldd-section-hdr">Communications</h2>
                                @if (_communications.Count == 0)
                                {
                                    @EmptyState("bi-chat-dots", "No communications", "Email, phone, SMS, and workflow communications will appear here.")
                                }
                                else
                                {
                                    <div class="ldd-comms-list">
                                        @foreach (var comm in _communications.OrderByDescending(c => c.SentAt))
                                        {
                                            <article class="ldd-comm-row">
                                                <span class="ldd-comm-icon @CommunicationIconClass(comm.Channel)"><i class="bi @CommunicationIcon(comm.Channel)" aria-hidden="true"></i></span>
                                                <div class="ldd-comm-body"><div class="ldd-comm-hdr"><span class="ldd-comm-subject">@comm.Subject</span><span class="ldd-comm-channel">@comm.Channel</span></div><div class="ldd-comm-preview">@comm.Preview</div><div class="ldd-comm-meta"><span>@Safe(comm.SentByName, "System")</span><span>@comm.SentAt.ToLocalTime().ToString("g")</span>@if (comm.Opened) { <span class="ldd-comm-opened"><i class="bi bi-envelope-open" aria-hidden="true"></i>Opened</span> }@if (comm.Clicked) { <span class="ldd-comm-clicked"><i class="bi bi-cursor" aria-hidden="true"></i>Clicked</span> }</div><div class="d-flex gap-2 mt-2"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditTabItem(comm)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteTabItem(LeadTabItemKind.Communication, comm.CommunicationId, comm.Subject)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div></div>
                                            </article>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="ldd-info-card">
                                <h2 class="ldd-section-hdr">Campaign enrollment</h2>
                                @if (_campaigns.Count == 0)
                                {
                                    @EmptyState("bi-megaphone", "No campaign enrollments", "Marketing campaign enrollment and response metrics will appear here.")
                                }
                                else
                                {
                                    <div class="ldd-table-wrap"><table class="ldd-enterprise-table"><thead><tr><th>Campaign</th><th>Status</th><th>Enrolled</th><th>Last touch</th><th class="ldd-text-end">Sent</th><th class="ldd-text-end">Open</th><th class="ldd-text-end">Clicks</th><th class="ldd-text-end">Actions</th></tr></thead><tbody>
                                        @foreach (var campaign in _campaigns.OrderByDescending(c => c.LastTouch ?? c.EnrolledAt))
                                        {
                                            <tr><td><strong>@campaign.CampaignName</strong></td><td><span class="@CampaignStatusBadge(campaign.Status)">@campaign.Status</span></td><td>@campaign.EnrolledAt.ToLocalTime().ToString("MMM d, yyyy")</td><td>@DateOrDash(campaign.LastTouch)</td><td class="ldd-text-end ldd-mono">@campaign.EmailsSent</td><td class="ldd-text-end ldd-mono">@campaign.EmailsOpen</td><td class="ldd-text-end ldd-mono">@campaign.Clicks</td><td class="ldd-text-end"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditTabItem(campaign)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteTabItem(LeadTabItemKind.Campaign, campaign.EnrollmentId, campaign.CampaignName)"><i class="bi bi-trash" aria-hidden="true"></i></button></td></tr>
                                        }
                                    </tbody></table></div>
                                }
                            </div>
                        </div>
                    }
                    else if (_activeTab == 5)
                    {
                        <div class="ldd-tab-body">
                            <div class="ldd-tab-toolbar"><span class="ldd-tab-count">@_documents.Count document(s)</span><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenDocumentUpload"><i class="bi bi-folder-plus" aria-hidden="true"></i> Add document</button></div>
                            @if (_documents.Count == 0)
                            {
                                @EmptyState("bi-folder2-open", "No documents", "Applications, statements, loss runs, and supporting lead documents will appear here.")
                            }
                            else
                            {
                                <div class="ldd-table-wrap"><table class="ldd-enterprise-table"><thead><tr><th>File</th><th>Category</th><th>Uploaded by</th><th>Uploaded</th><th class="ldd-text-end">Size</th><th class="ldd-text-end">Actions</th></tr></thead><tbody>
                                    @foreach (var doc in _documents.OrderByDescending(d => d.UploadedAt))
                                    {
                                        <tr><td><span class="ldd-doc-name"><i class="bi @DocumentIcon(doc.Extension)" aria-hidden="true"></i><strong>@doc.FileName</strong></span><div class="ldd-text-muted">@doc.Extension.ToUpperInvariant()</div></td><td>@doc.Category</td><td>@Safe(doc.UploadedByName, "System")</td><td>@doc.UploadedAt.ToLocalTime().ToString("g")</td><td class="ldd-text-end ldd-mono">@SizeText(doc.SizeKb)</td><td class="ldd-text-end"><div class="ldd-doc-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Open document details" @onclick="() => OpenDocumentAsync(doc)"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span>Open</span></button>@if (IsImageDocument(doc)) { <button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Preview image" @onclick="() => PreviewDocumentAsync(doc)"><i class="bi bi-eye" aria-hidden="true"></i></button> }<button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Download file" @onclick="() => DownloadDocumentAsync(doc)"><i class="bi bi-download" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Edit metadata" @onclick="() => OpenEditTabItem(doc)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" title="Delete document" @onclick="() => ConfirmDeleteTabItem(LeadTabItemKind.Document, doc.DocumentId, doc.FileName)"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td></tr>
                                    }
                                </tbody></table></div>
                            }
                        </div>
                    }
                    else if (_activeTab == 6)
                    {
                        <div class="ldd-tab-body">
                            <div class="ldd-tab-toolbar"><span class="ldd-tab-count">@_phoneCompliance.Count linked phone record(s)</span></div>
                            @if (_phoneCompliance.Count == 0)
                            {
                                @EmptyState("bi-telephone", "No phone records", "Add a valid phone to the lead or a lead contact to initialize compliance screening.")
                            }
                            else
                            {
                                <div class="ldd-compliance-list">
                                    @foreach (var phone in _phoneCompliance.OrderByDescending(p => p.IsPrimary).ThenBy(p => p.EntityDisplayName))
                                    {
                                        <article class="ldd-compliance-card">
                                            <div class="ldd-compliance-head">
                                                <div><span class="ldd-field-lbl">@phone.EntityTypeCode</span><h3>@phone.EntityDisplayName</h3><span class="ldd-mono">@phone.DisplayPhoneNumber</span></div>
                                                <span class="@(phone.IsCallAllowed || phone.IsSmsAllowed ? "ldd-dnc-status ldd-dnc-status--allowed" : "ldd-dnc-status ldd-dnc-status--blocked")"><i class="bi @(phone.IsCallAllowed || phone.IsSmsAllowed ? "bi-telephone-check-fill" : "bi-telephone-x-fill")"></i> @phone.OverallStatusCode</span>
                                            </div>
                                            <div class="ldd-compliance-metrics"><span><strong>Calls</strong>@(phone.IsCallAllowed ? "Allowed" : "Blocked")</span><span><strong>SMS</strong>@(phone.IsSmsAllowed ? "Allowed" : "Blocked")</span><span><strong>Last evaluated</strong>@DateOrDash(phone.LastEvaluatedDateUtc)</span><span><strong>Screening due</strong>@DateOrDash(phone.NextScreeningDueDateUtc)</span></div>
                                            <div class="ldd-compliance-actions"><button type="button" class="um-btn um-btn-danger um-btn-sm" @onclick="() => OpenSuppressionForm(phone)"><i class="bi bi-telephone-x"></i> Add suppression</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenConsentForm(phone)"><i class="bi bi-file-earmark-check"></i> Record consent</button></div>

                                            <details class="ldd-compliance-history" open="@(phone.Suppressions.Any(s => s.StatusCode == "Active"))"><summary>Suppressions (@phone.Suppressions.Count)</summary>
                                                @if (phone.Suppressions.Count == 0) { <p>No suppression history.</p> }
                                                else { @foreach (var item in phone.Suppressions) { <div class="ldd-history-row"><div><strong>@ReferenceName("SuppressionSource", item.SourceCode)</strong><span>@ReferenceName("SuppressionReason", item.ReasonCode) • @ReferenceName("Channel", item.ChannelCode) • @item.EffectiveDateUtc.ToLocalTime().ToString("g")</span><small>@Safe(item.Notes, Safe(item.EvidenceReference, "No notes"))</small></div><span class="ldd-dnc-status @(item.StatusCode == "Active" ? "ldd-dnc-status--blocked" : "ldd-dnc-status--neutral")">@item.StatusCode</span>@if (item.StatusCode == "Active") { <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ConfirmRevokeSuppression(phone, item)">Revoke</button> }</div> } }
                                            </details>
                                            <details class="ldd-compliance-history"><summary>Consent evidence (@phone.Consents.Count)</summary>
                                                @if (phone.Consents.Count == 0) { <p>No consent evidence.</p> }
                                                else { @foreach (var item in phone.Consents) { <div class="ldd-history-row"><div><strong>@ReferenceName("ConsentType", item.ConsentTypeCode)</strong><span>@ReferenceName("Purpose", item.PurposeCode) • @ReferenceName("LegalBasis", item.LegalBasisCode)</span><small>@item.EvidenceReference</small></div><span class="ldd-dnc-status @(item.StatusCode == "Granted" ? "ldd-dnc-status--allowed" : "ldd-dnc-status--neutral")">@item.StatusCode</span>@if (item.StatusCode == "Granted") { <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ConfirmRevokeConsent(phone, item)">Revoke</button> }</div> } }
                                            </details>
                                            <details class="ldd-compliance-history"><summary>Registry screenings (@phone.ScreeningResults.Count)</summary>
                                                @if (phone.ScreeningResults.Count == 0) { <p>No screening results have been recorded.</p> }
                                                else { @foreach (var item in phone.ScreeningResults) { <div class="ldd-history-row"><div><strong>@item.RegistryCode</strong><span>@item.ProviderCode • @item.ScreenedDateUtc.ToLocalTime().ToString("g")</span><small>@Safe(item.ProviderReference, Safe(item.ErrorDetails, "No provider detail"))</small></div><span class="ldd-dnc-status @(item.ResultCode == "Matched" ? "ldd-dnc-status--blocked" : "ldd-dnc-status--allowed")">@item.ResultCode</span></div> } }
                                            </details>
                                        </article>
                                    }
                                </div>
                            }
                        </div>
                    }
                </section>
            </main>

            <aside class="ldd-right-panel" aria-label="Lead intelligence panel">
                <section class="ldd-panel-card ldd-panel-card--nba">
                    <div class="ldd-panel-card-hdr"><i class="bi bi-stars ldd-panel-icon ldd-pi--nba" aria-hidden="true"></i><span class="ldd-panel-title">Lead actions</span><span class="ldd-ai-chip"><i class="bi bi-cpu" aria-hidden="true"></i> AI</span></div>
                    <div class="ldd-action-row">
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenEdit"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenAssign"><i class="bi bi-person-check" aria-hidden="true"></i> Assign</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ConfirmDisqualify"><i class="bi bi-x-circle" aria-hidden="true"></i> Disqualify</button>
                    </div>
                    <button type="button" class="um-btn um-btn-primary w-100 justify-content-center mt-2" @onclick="OpenConvertWorkflow"><i class="bi bi-arrow-up-right-circle" aria-hidden="true"></i> Convert Lead</button>
                </section>

                <section class="ldd-panel-card">
                    <div class="ldd-panel-card-hdr"><i class="bi bi-speedometer2 ldd-panel-icon ldd-pi--score" aria-hidden="true"></i><span class="ldd-panel-title">Score factors</span><span class="ldd-score-num">@ScoreDisplay</span></div>
                    <div class="ldd-score-bar-track"><div class="ldd-score-bar-fill" style="width:@ScorePercent%;background:@ScoreColor"></div></div>
                    @if (_scoreFactors.Count == 0)
                    {
                        <p class="ldd-nba-empty">No score factor details are available for this lead.</p>
                    }
                    else
                    {
                        <div class="ldd-score-breakdown">
                            @foreach (var factor in _scoreFactors.OrderByDescending(f => Math.Abs(f.Points)).Take(6))
                            {
                                <div class="ldd-sf-row"><span class="ldd-sf-lbl" title="@factor.RuleName">@factor.RuleName</span><span class="ldd-sf-track"><span class="ldd-sf-fill @(factor.Points >= 0 ? "ldd-sf--pos" : "ldd-sf--neg")" style="width:@FactorWidth(factor.Points)%"></span></span><span class="ldd-sf-pts @(factor.Points >= 0 ? "ldd-pts--pos" : "ldd-pts--neg")">@(factor.Points >= 0 ? "+" : "")@factor.Points</span></div>
                            }
                        </div>
                    }
                </section>

                <section class="ldd-panel-card">
                    <div class="ldd-panel-card-hdr"><i class="bi bi-broadcast ldd-panel-icon ldd-pi--engage" aria-hidden="true"></i><span class="ldd-panel-title">Engagement</span><span class="@EngagementBadgeClass">@EngagementLevel</span></div>
                    <div class="ldd-engage-metrics">
                        <div class="ldd-em-row"><i class="bi bi-envelope ldd-em-icon" aria-hidden="true"></i><span class="ldd-em-lbl">Emails sent</span><span class="ldd-em-val">@(_engagement?.EmailsSent ?? _campaigns.Sum(c => c.EmailsSent))</span></div>
                        <div class="ldd-em-row"><i class="bi bi-envelope-open ldd-em-icon" aria-hidden="true"></i><span class="ldd-em-lbl">Emails opened</span><span class="ldd-em-val">@(_engagement?.EmailsOpened ?? _campaigns.Sum(c => c.EmailsOpen))</span></div>
                        <div class="ldd-em-row"><i class="bi bi-cursor ldd-em-icon" aria-hidden="true"></i><span class="ldd-em-lbl">Clicks</span><span class="ldd-em-val">@(_engagement?.Clicks ?? _campaigns.Sum(c => c.Clicks))</span></div>
                        <div class="ldd-em-row"><i class="bi bi-clock-history ldd-em-icon" aria-hidden="true"></i><span class="ldd-em-lbl">Days since touch</span><span class="ldd-em-val">@(_engagement?.DaysSinceTouch.ToString(CultureInfo.InvariantCulture) ?? DaysSinceLastTouch.ToString(CultureInfo.InvariantCulture))</span></div>
                    </div>
                </section>

                <section class="ldd-panel-card ldd-panel-card--nba">
                    <div class="ldd-panel-card-hdr"><i class="bi bi-magic ldd-panel-icon ldd-pi--nba" aria-hidden="true"></i><span class="ldd-panel-title">Next best action</span></div>
                    <div class="ldd-nba-list">
                        @foreach (var action in NextActions)
                        {
                            <article class="ldd-nba-item @(action.IsHigh ? "ldd-nba-item--high" : string.Empty)"><span class="ldd-nba-icon @action.IconClass"><i class="bi @action.Icon" aria-hidden="true"></i></span><div class="ldd-nba-body"><div class="ldd-nba-action">@action.Title</div><div class="ldd-nba-reason">@action.Reason</div><div class="ldd-nba-due @(action.IsHigh ? "ldd-nba-due--urgent" : string.Empty)"><i class="bi bi-calendar-event" aria-hidden="true"></i>@action.DueText</div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm ldd-nba-act-btn" @onclick="() => SetTab(action.TabIndex)">Open</button></article>
                        }
                    </div>
                </section>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public Guid LeadId { get; set; }

    private LeadDto? _lead;
    private List<LeadContactDto> _contacts = [];
    private List<LeadInterestLineDto> _interestLines = [];
    private List<LeadActivityDto> _activities = [];
    private List<LeadCommunicationDto> _communications = [];
    private List<LeadCampaignEnrollmentDto> _campaigns = [];
    private List<LeadDocumentDto> _documents = [];
    private List<LeadPhoneComplianceDto> _phoneCompliance = [];
    private List<PhoneComplianceReferenceDto> _complianceReferences = [];
    private List<LeadScoreFactorDto> _scoreFactors = [];
    private List<LeadActivityTypeDto> _activityTypes = [];
    private List<LeadActivityOutcomeDto> _activityOutcomes = [];
    private List<LeadEngagementOptionDto> _engagementOptions = [];
    private List<LeadCampaignOptionDto> _campaignOptions = [];
    private List<CarrierDto> _carrierOptions = [];
    private List<LineOfBusinessDto> _lineOfBusinessOptions = [];
    private List<DocumentConfigItemDto> _documentCategories = [];
    private LeadEngagementSummaryDto? _engagement;
    private Guid _tenantId;
    private Guid _currentUserId;
    private bool _loading = true;
    private bool _busy;
    private bool _showEdit;
    private bool _showAssign;
    private bool _showConvert;
    private bool _showTabForm;
    private bool _showDocumentUpload;
    private bool _showSuppressionForm;
    private bool _showConsentForm;
    private string? _loadError;
    private string? _tabValidationError;
    private int _activeTab;
    private bool _toastVisible;
    private string _toastKind = "success";
    private string _toastMessage = string.Empty;
    private ConfirmAction? _confirmAction;
    private EnterpriseDocumentPreview? _documentPreview;
    private LeadEditForm _editForm = new();
    private LeadAssignForm _assignForm = new();
    private LeadConvertForm _convertForm = new();
    private LeadTabItemForm _tabForm = new();
    private PhoneSuppressionForm _suppressionForm = new();
    private PhoneConsentForm _consentForm = new();
    private LeadPhoneComplianceDto? _selectedCompliancePhone;
    private IBrowserFile? _selectedDocumentFile;
    private Guid? _editingTabItemId;
    private List<OwnerOption> _ownerOptions = [];
    private List<AccountDto> _accountCandidates = [];
    private string _convertAccountSearch = string.Empty;
    private bool _showConvertAccountPicker;
    private bool _focusConvertAccountPicker;
    private ElementReference _convertAccountPickerRef;

    private readonly TabDefinition[] _tabs =
    [
        new(0, "overview", "Overview", "bi-person-vcard"),
        new(1, "contacts", "Contacts", "bi-people"),
        new(2, "interest", "Interest", "bi-shield-plus"),
        new(3, "activities", "Activities", "bi-lightning-charge"),
        new(4, "engagement", "Engagement", "bi-broadcast"),
        new(5, "documents", "Documents", "bi-folder2-open"),
        new(6, "compliance", "Phone Compliance", "bi-shield-lock")
    ];

    protected override async Task OnParametersSetAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Leads", "/crm/leads"), new("Lead Detail", $"/crm/leads/{LeadId}"));
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusConvertAccountPicker) return;

        _focusConvertAccountPicker = false;
        await _convertAccountPickerRef.FocusAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            if (_tenantId == Guid.Empty || _currentUserId == Guid.Empty)
            {
                var currentUser = await CurrentUser.RequireAsync();
                _tenantId = currentUser.TenantId;
                _currentUserId = currentUser.UserId;
            }

            _lead = await Api.GetLeadByIdAsync(LeadId);
            if (_lead is null)
            {
                ClearRelatedData();
                return;
            }

            var leadTenantId = _lead.TenantId == Guid.Empty ? _tenantId : _lead.TenantId;
            var usersTask = leadTenantId == Guid.Empty ? Task.FromResult<PagedResult<UserDto>?>(null) : Api.SearchUsersAsync(leadTenantId);
            var contactsTask = Api.GetLeadContactsAsync(LeadId);
            var interestTask = Api.GetLeadInterestLinesAsync(LeadId);
            var activitiesTask = Api.GetLeadActivitiesByLeadIdAsync(LeadId);
            var communicationsTask = Api.GetLeadCommunicationsAsync(LeadId);
            var campaignsTask = Api.GetLeadCampaignsAsync(LeadId);
            var documentsTask = Api.GetLeadDocumentsAsync(LeadId);
            var scoresTask = Api.GetLeadScoreFactorsAsync(LeadId);
            var engagementTask = Api.GetLeadEngagementSummaryAsync(LeadId);
            var activityTypesTask = Api.SearchLeadActivityTypesAsync(leadTenantId, pageSize: 1000);
            var activityOutcomesTask = Api.GetLeadActivityOutcomesAsync(leadTenantId);
            var engagementOptionsTask = Api.GetLeadEngagementOptionsAsync(leadTenantId);
            var campaignOptionsTask = Api.GetLeadCampaignOptionsAsync(leadTenantId);
            var carriersTask = Api.SearchCarriersAsync(leadTenantId, pageSize: 1000);
            var linesOfBusinessTask = Api.SearchLobsAsync(leadTenantId, pageSize: 1000);
            var documentCategoriesTask = Api.SearchDocumentConfigItemsAsync(leadTenantId, "DocumentCategory", pageSize: 1000);
            var phoneComplianceTask = Api.GetLeadPhoneComplianceAsync(LeadId);
            var complianceReferencesTask = Api.GetPhoneComplianceReferencesAsync(leadTenantId);

            await Task.WhenAll(usersTask, contactsTask, interestTask, activitiesTask, communicationsTask, campaignsTask, documentsTask, scoresTask, engagementTask, activityTypesTask, activityOutcomesTask, engagementOptionsTask, campaignOptionsTask, carriersTask, linesOfBusinessTask, documentCategoriesTask, phoneComplianceTask, complianceReferencesTask);

            _ownerOptions = usersTask.Result?.Items?
                .Where(u => string.Equals(u.StatusCode, "Active", StringComparison.OrdinalIgnoreCase))
                .Select(u => new OwnerOption(u.UserId.ToString(), Safe(u.DisplayName, Safe(u.FullName, u.Email))))
                .Where(o => !string.IsNullOrWhiteSpace(o.Label))
                .OrderBy(o => o.Label)
                .ToList() ?? [];
            _contacts = contactsTask.Result?.ToList() ?? [];
            _interestLines = interestTask.Result?.ToList() ?? [];
            _activities = activitiesTask.Result?.ToList() ?? [];
            _communications = communicationsTask.Result?.ToList() ?? [];
            _campaigns = campaignsTask.Result?.ToList() ?? [];
            _documents = documentsTask.Result?.ToList() ?? [];
            _scoreFactors = scoresTask.Result?.ToList() ?? [];
            _engagement = engagementTask.Result;
            _activityTypes = activityTypesTask.Result?.Items.Where(t => t.IsActive).OrderBy(t => t.SortOrder).ThenBy(t => t.ActivityTypeName).ToList() ?? [];
            _activityOutcomes = activityOutcomesTask.Result?.Where(o => o.IsActive).ToList() ?? [];
            _engagementOptions = engagementOptionsTask.Result?.Where(o => o.IsActive).OrderBy(o => o.SortOrder).ThenBy(o => o.Label).ToList() ?? [];
            _campaignOptions = campaignOptionsTask.Result?.OrderBy(c => c.Name).ToList() ?? [];
            _carrierOptions = carriersTask.Result?.Items.Where(c => c.IsActive).OrderBy(c => c.CarrierName).ToList() ?? [];
            _lineOfBusinessOptions = linesOfBusinessTask.Result?.Items.Where(l => l.IsActive).OrderBy(l => l.LobName).ToList() ?? [];
            _documentCategories = documentCategoriesTask.Result?.Items.Where(c => c.IsActive).OrderBy(c => c.SortOrder).ThenBy(c => c.Name).ToList() ?? [];
            _phoneCompliance = phoneComplianceTask.Result?.ToList() ?? [];
            _complianceReferences = complianceReferencesTask.Result?.OrderBy(r => r.ReferenceTypeCode).ThenBy(r => r.SortOrder).ThenBy(r => r.Name).ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = $"Lead detail failed to load: {ex.Message}";
            ShowToast("danger", _loadError);
        }
        finally
        {
            _loading = false;
        }
    }

