        _campaignForm = new CampaignForm();
        _showCampaign = true;
    }

    private void OpenUploadDocument()
    {
        _uploadForm = new UploadDocumentForm();
        _selectedUploadFile = null;
        _uploadFileError = null;
        _showUploadDoc = true;
    }

    private void OnLeadDocumentSelected(InputFileChangeEventArgs args)
    {
        _uploadFileError = null;
        _selectedUploadFile = args.File;

        var extension = Path.GetExtension(_selectedUploadFile.Name);
        if (!AllowedUploadExtensions.Contains(extension))
        {
            _uploadFileError = "Select a supported document type: PDF, Word, Excel, CSV, image, or TIFF.";
            _selectedUploadFile = null;
            return;
        }

        if (_selectedUploadFile.Size > MaxUploadBytes)
        {
            _uploadFileError = "The selected file is larger than the 100 MB upload limit.";
            _selectedUploadFile = null;
            return;
        }

        _uploadForm.FileName = _selectedUploadFile.Name;
        _uploadForm.Extension = extension;
        _uploadForm.SizeKb = ToSizeKb(_selectedUploadFile.Size);
    }

    private void OpenLogActivity()
    {
        _activityForm = new ActivityForm { OccurredAt = DateTime.UtcNow };
        _showLogActivity = true;
    }

    private void OpenAddContact()
    {
        _contactForm = new ContactForm();
        _showAddContact = true;
    }

    private void OpenAddInterest()
    {
        _interestForm = new InterestForm();
        _showAddInterest = true;
    }

    private void OpenCompose()
    {
        _commForm = new CommunicationForm();
        _showCompose = true;
    }

    private async Task SaveEditAsync()
    {
        if (_lead is null) return;
        _savingEdit = true;
        try
        {
            var ownerId = Guid.TryParse(_editForm.OwnerId, out var parsedOwnerId) ? parsedOwnerId : (Guid?)null;
            await Api.UpdateLeadAsync(LeadId, new UpdateLeadRequest
            {
                AccountName = _editForm.CompanyName.Trim(),
                FirstName = _editForm.FirstName.Trim(),
                LastName = _editForm.LastName.Trim(),
                Email = NullIfWhiteSpace(_editForm.Email),
                Phone = NullIfWhiteSpace(_editForm.Phone),
                InterestedService = NullIfWhiteSpace(_editForm.Notes),
                AnnualRevenue = _editForm.EstPremium,
                Score = _editForm.Score,
                PriorityCode = ScoreToRating(_editForm.Score),
                SourceCode = _editForm.Source,
                NurturingStageCode = _editForm.Stage,
                StatusCode = StageToStatusCode(_editForm.Stage),
                AssignedToUserId = ownerId,
                UpdatedByUserId = CurrentUserId
            });
            _showEdit = false;
            await Toast("Lead updated.", "e-toast-success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Save failed: {ex.Message}", "e-toast-danger");
        }
        finally
        {
            _savingEdit = false;
        }
    }

    private async Task CommitAssignAsync()
    {
        if (_lead is null || !Guid.TryParse(_assignForm.OwnerId, out var assignedToUserId))
        {
            await Toast("Select a valid owner from the user table.", "e-toast-danger");
            return;
        }

        try
        {
            await Api.UpdateLeadAsync(LeadId, new UpdateLeadRequest
            {
                AccountName = _lead.CompanyName,
                FirstName = _lead.FirstName,
                LastName = _lead.LastName,
                Email = _lead.Email,
                Phone = _lead.Phone,
                InterestedService = _lead.InterestedService,
                Score = _lead.Score,
                PriorityCode = _lead.Rating,
                SourceCode = _lead.Source,
                NurturingStageCode = _lead.Stage,
                StatusCode = StageToStatusCode(_lead.Stage),
                AssignedToUserId = assignedToUserId,
            });

            _lead.Owner = ResolveOwnerName(assignedToUserId);
            _showAssign = false;
            await Toast($"Lead assigned to {_lead.Owner}.", "e-toast-success");
        }
        catch (Exception ex)
        {
            await Toast($"Assignment failed: {ex.Message}", "e-toast-danger");
        }
    }

    private async Task CommitConvertAsync()
    {
        // TODO: Api.QualifyLeadToAccountAsync(LeadId, _convertForm.KeepLead, _convertForm.CreateActivity)
        await Task.Delay(0);
        _showConvert = false;
        await Toast("Lead qualified to account.", "e-toast-success");
        Nav.NavigateTo($"/accounts/new?leadId={LeadId}");
    }

    private async Task CommitCampaignAsync()
    {
        if (_lead is null) return;
        try
        {
            var campaignName = _campaignOptions.FirstOrDefault(c => c.Value == _campaignForm.CampaignId)?.Label ?? _campaignForm.CampaignId;
            await Api.CreateLeadCampaignAsync(LeadId, new CreateLeadCampaignEnrollmentRequest { TenantId = _lead.TenantId, LeadId = LeadId, CampaignName = campaignName, Status = "Active", EnrolledAt = DateTime.UtcNow, EmailsSent = _campaignForm.SendNow ? 1 : 0, CreatedByUserId = CurrentUserId });
            _showCampaign = false;
            _campaignForm = new();
            await Toast("Lead enrolled in campaign.", "e-toast-success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Campaign enrollment failed: {ex.Message}", "e-toast-danger");
        }
    }

    private async Task CommitUploadDocumentAsync()
    {
        if (_lead is null) return;

        if (_selectedUploadFile is null)
        {
            _uploadFileError = "Select a document file to upload.";
            return;
        }

        try
        {
            await using var stream = _selectedUploadFile.OpenReadStream(MaxUploadBytes);
            await Api.UploadDocumentAsync(new ApiClient.UploadDocumentRequest
            {
                TenantId = _lead.TenantId,
                DocumentTypeCode = _uploadForm.Category,
                CategoryCode = _uploadForm.Category,
                FileName = _uploadForm.FileName,
                OriginalFileName = _selectedUploadFile.Name,
                EntityName = "Lead",
                EntityId = LeadId,
                Tags = "lead",
                UploadedByName = _uploadedByName,
                CreatedByUserId = _currentUserId,
                Content = stream
            });

            await Api.CreateLeadDocumentAsync(LeadId, new CreateLeadDocumentRequest
            {
                TenantId = _lead.TenantId,
                LeadId = LeadId,
                FileName = _uploadForm.FileName,
                Extension = _uploadForm.Extension,
                Category = _uploadForm.Category,
                SizeKb = _uploadForm.SizeKb,
                UploadedByUserId = _currentUserId,
                UploadedAt = DateTime.UtcNow
            });

            _showUploadDoc = false;
            _uploadForm = new();
            _selectedUploadFile = null;
            _uploadFileError = null;
            await Toast("Document uploaded successfully.", "e-toast-success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Document upload failed: {ex.Message}", "e-toast-danger");
        }
    }

    private async Task CommitActivityAsync()
    {
        if (_lead is null) return;

        try
        {
            await Api.CreateLeadActivityAsync(new Ams.Application.Features.LeadActivities.CreateLeadActivityRequest { TenantId = _lead.TenantId, LeadId = LeadId, ActivityTypeCode = _activityForm.Type.Trim(), Subject = _activityForm.Subject.Trim(), Notes = NullIfWhiteSpace(_activityForm.Notes), ActivityDate = _activityForm.OccurredAt, CreatedByUserId = CurrentUserId });
            _activityForm = new();
            _showLogActivity = false;
            await Toast("Activity logged.", "e-toast-success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Activity save failed: {ex.Message}", "e-toast-danger");
        }
    }

    private async Task CommitAddContactAsync()
    {
        if (_lead is null) return;

        var emailValidation = ValidateEmail(_contactForm.Email);
        if (emailValidation is not null)
        {
            await Toast(emailValidation, "e-toast-danger");
            return;
        }

        var phoneValidation = ValidatePhone(_contactForm.Phone);
        if (phoneValidation is not null)
        {
            await Toast(phoneValidation, "e-toast-danger");
            return;
        }

        try
        {
            await Api.CreateLeadContactAsync(LeadId, new CreateLeadContactRequest { TenantId = _lead.TenantId, LeadId = LeadId, FirstName = _contactForm.FirstName.Trim(), LastName = _contactForm.LastName.Trim(), Title = NullIfWhiteSpace(_contactForm.Title), Email = NullIfWhiteSpace(_contactForm.Email), Phone = NullIfWhiteSpace(_contactForm.Phone), IsPrimary = _contactForm.IsPrimary, CreatedByUserId = CurrentUserId });
            _contactForm = new();
            _showAddContact = false;
            await Toast("Contact added.", "e-toast-success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Contact save failed: {ex.Message}", "e-toast-danger");
        }
    }

    private static string? NullIfWhiteSpace(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string? ValidateEmail(string? email) => new AmsEmailAddressAttribute().IsValid(email) ? null : "Enter a valid email address.";

    private static string? ValidatePhone(string? phone) => new AmsPhoneAttribute().IsValid(phone) ? null : "Enter a valid phone number.";

    private async Task CommitAddInterestAsync()
    {
        if (_lead is null) return;
        try
        {
            await Api.CreateLeadInterestLineAsync(LeadId, new CreateLeadInterestLineRequest { TenantId = _lead.TenantId, LeadId = LeadId, LineOfBusiness = _interestForm.LineOfBusiness, Carrier = _interestForm.Carrier, CurrentCarrier = _interestForm.CurrentCarrier, EstPremium = _interestForm.EstPremium, ExpiryDate = _interestForm.ExpiryDate, Priority = _interestForm.Priority, Notes = _interestForm.Notes, CreatedByUserId = CurrentUserId });
            _interestForm = new();
            _showAddInterest = false;
            await Toast("Interest line added.", "e-toast-success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Interest line save failed: {ex.Message}", "e-toast-danger");
        }
    }

    private async Task CommitComposeAsync()
    {
        if (_lead is null) return;
        try
        {
            await Api.CreateLeadCommunicationAsync(LeadId, new CreateLeadCommunicationRequest { TenantId = _lead.TenantId, LeadId = LeadId, Channel = _commForm.Channel, Subject = _commForm.Subject, Preview = _commForm.Preview, SentByUserId = CurrentUserId, SentAt = DateTime.UtcNow });
            _commForm = new();
