@page "/crm/leads/{LeadId:guid}"
@namespace Ams.Web.Components.Pages.Crm
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Ams.Application.Common.Validation
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject LeadScoringRealtimeClient LeadScoringRealtime
@implements IAsyncDisposable

<PageTitle>@(_lead is null ? "Lead" : _lead.FullName) — CRM</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@if (_loading)
{
    <div class="ldd-loading">
        <span class="um-spin" aria-hidden="true"></span>
        <span>Loading lead…</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" role="alert">
        @_loadError
    </div>
}
else if (_lead is null)
{
    <div class="ldd-not-found">
        <i class="bi bi-person-x ldd-not-found-icon" aria-hidden="true"></i>
        <h2>Lead not found</h2>
        <p>The requested lead record could not be loaded.</p>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/leads")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Leads
        </button>
    </div>
}
else
{
    <!-- ── Header ───────────────────────────────────────────────────────────── -->
    <AppPageHeader Title="@_lead.FullName"
                   Subtitle="@_lead.CompanyName"
                   Icon="bi-person-plus-fill"
                   ReturnUrl="/crm/leads"
                   ReturnLabel="Back to Leads">
        <Actions>
            <button class="um-btn um-btn-ghost" @onclick="OpenEdit">
                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
            </button>
            <button class="um-btn um-btn-ghost" @onclick="OpenAssign">
                <i class="bi bi-person-check" aria-hidden="true"></i> Assign
            </button>
            <button class="um-btn um-btn-ghost" @onclick="OpenCampaign">
                <i class="bi bi-megaphone" aria-hidden="true"></i> Campaign
            </button>
            <button class="um-btn um-btn-primary" @onclick="OpenConvert">
                <i class="bi bi-building-check" aria-hidden="true"></i> Qualify to Account
            </button>
        </Actions>
    </AppPageHeader>

    <!-- ── Identity / badge strip ────────────────────────────────────────── -->
    <div class="ldd-id-strip">
        <div class="ldd-avatar @AvatarColor(_lead.FullName)" aria-hidden="true">
            @Initials(_lead.FullName)
        </div>
        <div class="ldd-id-meta">
            <span class="@RatingBadge(_lead.Rating)">@_lead.Rating</span>
            <span class="@StageBadge(_lead.Stage)">@_lead.Stage</span>
            <span class="ldd-source-chip">
                <i class="bi @SourceIcon(_lead.Source)" aria-hidden="true"></i> @_lead.Source
            </span>
            <span class="ldd-meta-chip">
                <i class="bi bi-person" aria-hidden="true"></i> @_lead.Owner
            </span>
            <span class="ldd-meta-chip">
                <i class="bi bi-envelope" aria-hidden="true"></i> @_lead.Email
            </span>
            @if (!string.IsNullOrEmpty(_lead.Phone))
            {
                <span class="ldd-meta-chip">
                    <i class="bi bi-telephone" aria-hidden="true"></i> @_lead.Phone
                </span>
            }
            <span class="ldd-meta-chip">
                <i class="bi bi-calendar3" aria-hidden="true"></i> Created @_lead.CreatedAt.ToString("d")
            </span>
        </div>
    </div>

    <!-- ── Two-column layout: tabs left, right panel right ───────────────── -->
    <div class="ldd-layout">

        <!-- ── LEFT: Tabs ───────────────────────────────────────────────── -->
        <div class="ldd-tabs-col">
            <AppDetailTabs SelectedTab="_tab" SelectedTabChanged="t => _tab = t">
                <Tabs>

                    <!-- 0 ── Overview ───────────────────────────────────── -->
                    <TabItem>
                        <ChildContent><TabHeader Text="Overview" IconCss="bi bi-house" /></ChildContent>
                        <ContentTemplate>
                            <div class="ldd-tab-body">

                                <div class="ldd-info-card">
                                    <h3 class="ldd-section-hdr">Lead Information</h3>
                                    <div class="ldd-field-grid">
                                        @Field("First Name",    _lead.FirstName)
                                        @Field("Last Name",     _lead.LastName)
                                        @Field("Company",       _lead.CompanyName)
                                        @Field("Title",         _lead.Title)
                                        @Field("Email",         _lead.Email)
                                        @Field("Phone",         _lead.Phone)
                                        @Field("Website",       _lead.Website)
                                        @Field("Industry",      _lead.Industry)
                                        @Field("Employees",     _lead.EmployeeCount.HasValue ? _lead.EmployeeCount.Value.ToString("N0") : "—")
                                        @Field("Annual Revenue",_lead.AnnualRevenue.HasValue ? _lead.AnnualRevenue.Value.ToString("C0") : "—")
                                    </div>
                                </div>

                                <div class="ldd-info-card">
                                    <h3 class="ldd-section-hdr">Lead Details</h3>
                                    <div class="ldd-field-grid">
                                        @Field("Stage",         _lead.Stage)
                                        @Field("Rating",        _lead.Rating)
                                        @Field("Source",        _lead.Source)
                                        @Field("Owner",         _lead.Owner)
                                        @Field("Est. Premium",  _lead.EstPremium.ToString("C0"))
                                        @Field("Lead Score",    _lead.Score.ToString())
                                        @Field("Campaign",      _lead.CampaignName ?? "—")
                                        @Field("Referred By",   _lead.ReferredBy ?? "—")
                                        @Field("Created",       _lead.CreatedAt.ToString("f"))
                                        @Field("Last Modified", _lead.ModifiedAt?.ToString("f") ?? "—")
                                        @Field("Last Activity", _lead.LastActivity?.ToString("f") ?? "—")
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(_lead.Notes))
                                {
                                    <div class="ldd-info-card">
                                        <h3 class="ldd-section-hdr">Notes</h3>
                                        <p class="ldd-notes">@_lead.Notes</p>
                                    </div>
                                }

                                <div class="ldd-info-card">
                                    <h3 class="ldd-section-hdr">Address</h3>
                                    <div class="ldd-field-grid">
                                        @Field("Street",  _lead.Street ?? "—")
                                        @Field("City",    _lead.City ?? "—")
                                        @Field("State",   _lead.State ?? "—")
                                        @Field("ZIP",     _lead.Zip ?? "—")
                                        @Field("Country", _lead.Country ?? "—")
                                    </div>
                                </div>

                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <!-- 1 ── Contacts ───────────────────────────────────── -->
                    <TabItem>
                        <ChildContent><TabHeader Text="Contacts" IconCss="bi bi-people" /></ChildContent>
                        <ContentTemplate>
                            <div class="ldd-tab-body">
                                <div class="ldd-tab-toolbar">
                                    <span class="ldd-tab-count">@_contacts.Count contact(s)</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenAddContact">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Contact
                                    </button>
                                </div>
                                @if (_contacts.Count == 0)
                                {
                                    @EmptyState("bi-people", "No contacts", "Add a contact linked to this lead.")
                                }
                                else
                                {
                                    <div class="ldd-contact-list">
                                        @foreach (var c in _contacts)
                                        {
                                            <div class="ldd-contact-card">
                                                <div class="ldd-contact-avatar @AvatarColor(c.FullName)">@Initials(c.FullName)</div>
                                                <div class="ldd-contact-body">
                                                    <div class="ldd-contact-name">@c.FullName</div>
                                                    <div class="ldd-contact-title">@c.Title</div>
                                                    <div class="ldd-contact-links">
                                                        @if (!string.IsNullOrEmpty(c.Email))
                                                        {
                                                            <a href="mailto:@c.Email" class="ldd-contact-link">
                                                                <i class="bi bi-envelope" aria-hidden="true"></i> @c.Email
                                                            </a>
                                                        }
                                                        @if (!string.IsNullOrEmpty(c.Phone))
                                                        {
                                                            <span class="ldd-contact-link">
                                                                <i class="bi bi-telephone" aria-hidden="true"></i> @c.Phone
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                                @if (c.IsPrimary)
                                                {
                                                    <span class="ldd-primary-badge">Primary</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <!-- 2 ── Interest Lines ──────────────────────────────── -->
                    <TabItem>
                        <ChildContent><TabHeader Text="Interest Lines" IconCss="bi bi-shield-check" /></ChildContent>
                        <ContentTemplate>
                            <div class="ldd-tab-body">
                                <div class="ldd-tab-toolbar">
                                    <span class="ldd-tab-count">@_interestLines.Count line(s) of interest</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenAddInterest">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Line
                                    </button>
                                </div>
                                @if (_interestLines.Count == 0)
                                {
                                    @EmptyState("bi-shield", "No interest lines", "Add the lines of business this lead is interested in.")
                                }
                                else
                                {
                                    <SfGrid TValue="InterestLine"
                                            DataSource="_interestLines"
                                            AllowSorting="true"
                                            EnableHover="true"
                                            RowHeight="52">
                                        <GridColumns>
                                            <GridColumn Field="@nameof(InterestLine.LineOfBusiness)" HeaderText="Line of Business" Width="180" />
                                            <GridColumn Field="@nameof(InterestLine.Carrier)"        HeaderText="Preferred Carrier" Width="160" />
                                            <GridColumn Field="@nameof(InterestLine.EstPremium)"     HeaderText="Est. Premium"      Width="130" TextAlign="TextAlign.Right">
                                                <Template>
                                                    @{ var il = (InterestLine)context; }
                                                    <span class="ldd-mono ldd-bold">@il.EstPremium.ToString("C0")</span>
                                                </Template>
                                            </GridColumn>
                                            <GridColumn Field="@nameof(InterestLine.CurrentCarrier)" HeaderText="Current Carrier"  Width="150" />
                                            <GridColumn Field="@nameof(InterestLine.ExpiryDate)"     HeaderText="Expiry"           Width="110">
                                                <Template>
                                                    @{ var il = (InterestLine)context; }
                                                    <span class="ldd-mono">@(il.ExpiryDate.HasValue ? il.ExpiryDate.Value.ToString("d") : "—")</span>
                                                </Template>
                                            </GridColumn>
                                            <GridColumn Field="@nameof(InterestLine.Priority)"       HeaderText="Priority"         Width="100">
                                                <Template>
                                                    @{ var il = (InterestLine)context; }
                                                    <span class="@PriorityBadge(il.Priority)">@il.Priority</span>
                                                </Template>
                                            </GridColumn>
                                            <GridColumn Field="@nameof(InterestLine.Notes)"          HeaderText="Notes"            MinWidth="120" />
                                        </GridColumns>
                                    </SfGrid>
                                }
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <!-- 3 ── Activities ──────────────────────────────────── -->
                    <TabItem>
                        <ChildContent><TabHeader Text="Activities" IconCss="bi bi-lightning" /></ChildContent>
                        <ContentTemplate>
                            <div class="ldd-tab-body">
                                <div class="ldd-tab-toolbar">
                                    <span class="ldd-tab-count">@_activities.Count activit@(_activities.Count == 1 ? "y" : "ies")</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenLogActivity">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i> Log Activity
                                    </button>
                                </div>
                                @if (_activities.Count == 0)
                                {
                                    @EmptyState("bi-lightning", "No activities", "Log a call, email or meeting against this lead.")
                                }
                                else
                                {
                                    <div class="ldd-timeline">
                                        @foreach (var a in _activities.OrderByDescending(x => x.OccurredAt))
                                        {
                                            <div class="ldd-tl-item">
                                                <div class="ldd-tl-icon @ActivityColor(a.Type)">
                                                    <i class="bi @ActivityIcon(a.Type)" aria-hidden="true"></i>
                                                </div>
                                                <div class="ldd-tl-body">
                                                    <div class="ldd-tl-hdr">
                                                        <span class="ldd-tl-type">@a.Type</span>
                                                        <span class="ldd-tl-by">@a.By</span>
                                                        <span class="ldd-tl-when ldd-mono">@a.OccurredAt.ToString("g")</span>
                                                    </div>
                                                    <div class="ldd-tl-subject">@a.Subject</div>
                                                    @if (!string.IsNullOrEmpty(a.Notes))
                                                    {
                                                        <p class="ldd-tl-notes">@a.Notes</p>
                                                    }
                                                    @if (a.NextFollowUp.HasValue)
                                                    {
                                                        <div class="ldd-tl-follow">
                                                            <i class="bi bi-arrow-return-right" aria-hidden="true"></i>
                                                            Follow-up: @a.NextFollowUp.Value.ToString("d")
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <!-- 4 ── Quotes ───────────────────────────────────────── -->
                    <TabItem>
                        <ChildContent><TabHeader Text="Quotes" IconCss="bi bi-file-text" /></ChildContent>
                        <ContentTemplate>
                            <div class="ldd-tab-body">
                                <div class="ldd-tab-toolbar">
                                    <span class="ldd-tab-count">@_quotes.Count quote(s)</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/quotes/new?leadId=" + LeadId)'>
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i> New Quote
                                    </button>
                                </div>
                                @if (_quotes.Count == 0)
                                {
                                    @EmptyState("bi-file-text", "No quotes", "Generate a quote directly from this lead.")
                                }
                                else
                                {
                                    <SfGrid TValue="QuoteRow"
                                            DataSource="_quotes"
                                            AllowSorting="true"
                                            EnableHover="true"
                                            RowHeight="52">
                                        <GridColumns>
                                            <GridColumn Field="@nameof(QuoteRow.QuoteNumber)"   HeaderText="Quote #"     Width="130" />
                                            <GridColumn Field="@nameof(QuoteRow.LineOfBusiness)" HeaderText="Line"       Width="150" />
                                            <GridColumn Field="@nameof(QuoteRow.Carrier)"        HeaderText="Carrier"    Width="150" />
                                            <GridColumn Field="@nameof(QuoteRow.Premium)"        HeaderText="Premium"    Width="130" TextAlign="TextAlign.Right">
                                                <Template>
                                                    @{ var q = (QuoteRow)context; }
                                                    <span class="ldd-mono ldd-bold">@q.Premium.ToString("C0")</span>
                                                </Template>
                                            </GridColumn>
                                            <GridColumn Field="@nameof(QuoteRow.Status)"         HeaderText="Status"     Width="120">
                                                <Template>
                                                    @{ var q = (QuoteRow)context; }
                                                    <span class="@QuoteStatusBadge(q.Status)">@q.Status</span>
                                                </Template>
                                            </GridColumn>
                                            <GridColumn Field="@nameof(QuoteRow.CreatedAt)"      HeaderText="Created"    Width="120">
                                                <Template>@{ var q = (QuoteRow)context; }<span class="ldd-mono">@q.CreatedAt.ToString("d")</span></Template>
                                            </GridColumn>
                                            <GridColumn Field="@nameof(QuoteRow.ExpiresAt)"      HeaderText="Expires"    Width="120">
                                                <Template>@{ var q = (QuoteRow)context; }<span class="ldd-mono @(q.ExpiresAt < DateTime.UtcNow ? "ldd-expired" : "")">@q.ExpiresAt.ToString("d")</span></Template>
                                            </GridColumn>
                                            <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Right">
                                                <Template>
                                                    @{ var q = (QuoteRow)context; }
                                                    <button class="um-btn um-btn-ghost um-btn-sm"
                                                            @onclick='() => Nav.NavigateTo($"/quotes/{q.QuoteId}")'>
                                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                                    </button>
                                                </Template>
                                            </GridColumn>
                                        </GridColumns>
                                    </SfGrid>
                                }
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <!-- 5 ── Documents ───────────────────────────────────── -->
                    <TabItem>
                        <ChildContent><TabHeader Text="Documents" IconCss="bi bi-folder2" /></ChildContent>
                        <ContentTemplate>
                            <div class="ldd-tab-body">
                                <div class="ldd-tab-toolbar">
                                    <span class="ldd-tab-count">@_documents.Count document(s)</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenUploadDocument">
                                        <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Upload
                                    </button>
                                </div>
                                @if (_documents.Count == 0)
                                {
                                    @EmptyState("bi-folder2", "No documents", "Upload intake forms, loss runs or any supporting files.")
                                }
                                else
                                {
                                    <SfGrid TValue="DocRow"
                                            DataSource="_documents"
                                            AllowSorting="true"
                                            EnableHover="true"
                                            RowHeight="52">
                                        <GridColumns>
                                            <GridColumn Field="@nameof(DocRow.FileName)"    HeaderText="File"     MinWidth="200">
                                                <Template>
                                                    @{ var d = (DocRow)context; }
                                                    <span class="ldd-doc-name">
                                                        <i class="bi @DocIcon(d.Extension)" aria-hidden="true"></i> @d.FileName
                                                    </span>
                                                </Template>
                                            </GridColumn>
                                            <GridColumn Field="@nameof(DocRow.Category)"   HeaderText="Category" Width="140" />
                                            <GridColumn Field="@nameof(DocRow.SizeKb)"     HeaderText="Size"     Width="90" TextAlign="TextAlign.Right">
                                                <Template>@{ var d = (DocRow)context; }<span class="ldd-mono">@d.SizeKb KB</span></Template>
                                            </GridColumn>
                                            <GridColumn Field="@nameof(DocRow.UploadedBy)" HeaderText="Uploaded By" Width="150" />
                                            <GridColumn Field="@nameof(DocRow.UploadedAt)" HeaderText="Date"        Width="120">
                                                <Template>@{ var d = (DocRow)context; }<span class="ldd-mono">@d.UploadedAt.ToString("d")</span></Template>
                                            </GridColumn>
                                            <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Right">
                                                <Template>
                                                    <button class="um-btn um-btn-ghost um-btn-sm" title="Download">
                                                        <i class="bi bi-download" aria-hidden="true"></i>
                                                    </button>
                                                </Template>
                                            </GridColumn>
                                        </GridColumns>
                                    </SfGrid>
                                }
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <!-- 6 ── Communications ──────────────────────────────── -->
                    <TabItem>
                        <ChildContent><TabHeader Text="Communications" IconCss="bi bi-chat-dots" /></ChildContent>
                        <ContentTemplate>
                            <div class="ldd-tab-body">
                                <div class="ldd-tab-toolbar">
                                    <span class="ldd-tab-count">@_comms.Count message(s)</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenCompose">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i> New
                                    </button>
                                </div>
                                @if (_comms.Count == 0)
                                {
                                    @EmptyState("bi-chat-dots", "No communications", "Log emails, calls or SMS sent to this lead.")
                                }
                                else
                                {
                                    <div class="ldd-comms-list">
                                        @foreach (var m in _comms.OrderByDescending(x => x.SentAt))
                                        {
                                            <div class="ldd-comm-row">
                                                <div class="ldd-comm-icon @CommColor(m.Channel)">
                                                    <i class="bi @CommIcon(m.Channel)" aria-hidden="true"></i>
                                                </div>
                                                <div class="ldd-comm-body">
                                                    <div class="ldd-comm-hdr">
                                                        <span class="ldd-comm-subject">@m.Subject</span>
                                                        <span class="ldd-comm-channel">@m.Channel</span>
                                                        <span class="ldd-mono ldd-text-muted">@m.SentAt.ToString("g")</span>
                                                    </div>
                                                    <div class="ldd-comm-preview">@m.Preview</div>
                                                    <div class="ldd-comm-meta">
                                                        <span>By @m.SentBy</span>
                                                        @if (m.Opened) { <span class="ldd-comm-opened"><i class="bi bi-check2-all" aria-hidden="true"></i> Opened</span> }
                                                        @if (m.Clicked) { <span class="ldd-comm-clicked"><i class="bi bi-cursor" aria-hidden="true"></i> Clicked</span> }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <!-- 7 ── Marketing ───────────────────────────────────── -->
                    <TabItem>
                        <ChildContent><TabHeader Text="Marketing" IconCss="bi bi-megaphone" /></ChildContent>
                        <ContentTemplate>
                            <div class="ldd-tab-body">
                                <div class="ldd-tab-toolbar">
                                    <span class="ldd-tab-count">@_campaigns.Count enrollment(s)</span>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenCampaign">
                                        <i class="bi bi-plus-lg" aria-hidden="true"></i> Enroll
                                    </button>
                                </div>
                                @if (_campaigns.Count == 0)
                                {
                                    @EmptyState("bi-megaphone", "No campaign enrollments", "Enroll this lead in a nurture or outreach campaign.")
                                }
                                else
                                {
                                    <SfGrid TValue="CampaignEnrollment"
                                            DataSource="_campaigns"
                                            AllowSorting="true"
                                            EnableHover="true"
                                            RowHeight="52">
                                        <GridColumns>
                                            <GridColumn Field="@nameof(CampaignEnrollment.CampaignName)" HeaderText="Campaign"   MinWidth="200" />
                                            <GridColumn Field="@nameof(CampaignEnrollment.Status)"       HeaderText="Status"     Width="120">
                                                <Template>
                                                    @{ var ce = (CampaignEnrollment)context; }
                                                    <span class="@CampaignStatusBadge(ce.Status)">@ce.Status</span>
                                                </Template>
                                            </GridColumn>
                                            <GridColumn Field="@nameof(CampaignEnrollment.EnrolledAt)"  HeaderText="Enrolled"   Width="120">
                                                <Template>@{ var ce = (CampaignEnrollment)context; }<span class="ldd-mono">@ce.EnrolledAt.ToString("d")</span></Template>
                                            </GridColumn>
                                            <GridColumn Field="@nameof(CampaignEnrollment.EmailsSent)"  HeaderText="Sent"       Width="70"  TextAlign="TextAlign.Right" />
                                            <GridColumn Field="@nameof(CampaignEnrollment.EmailsOpen)"  HeaderText="Opens"      Width="70"  TextAlign="TextAlign.Right" />
                                            <GridColumn Field="@nameof(CampaignEnrollment.Clicks)"      HeaderText="Clicks"     Width="70"  TextAlign="TextAlign.Right" />
                                            <GridColumn Field="@nameof(CampaignEnrollment.LastTouch)"   HeaderText="Last Touch" Width="120">
                                                <Template>@{ var ce = (CampaignEnrollment)context; }<span class="ldd-mono">@(ce.LastTouch.HasValue ? ce.LastTouch.Value.ToString("d") : "—")</span></Template>
                                            </GridColumn>
                                        </GridColumns>
                                    </SfGrid>
                                }
                            </div>
                        </ContentTemplate>
                    </TabItem>

                </Tabs>
            </AppDetailTabs>
        </div>

        <!-- ── RIGHT PANEL ──────────────────────────────────────────────── -->
        <aside class="ldd-right-panel" aria-label="Lead intelligence">

            <!-- Lead Score -->
            <div class="ldd-panel-card">
                <div class="ldd-panel-card-hdr">
                    <i class="bi bi-graph-up-arrow ldd-panel-icon ldd-pi--score" aria-hidden="true"></i>
                    <span class="ldd-panel-title">Lead Score</span>
                    <span class="ldd-score-num" style="color:@ScoreColor(_lead.Score)">@_lead.Score</span>
                </div>
                <div class="ldd-score-bar-track">
                    <div class="ldd-score-bar-fill" style="width:@_lead.Score%;background:@ScoreColor(_lead.Score)"></div>
                </div>
                <div class="ldd-score-breakdown">
                    @foreach (var f in _scoreFactors)
                    {
                        <div class="ldd-sf-row">
                            <span class="ldd-sf-lbl">@f.Label</span>
                            <div class="ldd-sf-track">
                                <div class="ldd-sf-fill @(f.Positive ? "ldd-sf--pos" : "ldd-sf--neg")"
                                     style="width:@f.Pct%"></div>
                            </div>
                            <span class="ldd-sf-pts @(f.Positive ? "ldd-pts--pos" : "ldd-pts--neg")">
                                @(f.Positive ? "+" : "")@f.Points
                            </span>
                        </div>
                    }
                </div>
            </div>

            <!-- Source Attribution -->
            <div class="ldd-panel-card">
                <div class="ldd-panel-card-hdr">
                    <i class="bi bi-diagram-3 ldd-panel-icon ldd-pi--source" aria-hidden="true"></i>
                    <span class="ldd-panel-title">Source Attribution</span>
                </div>
                <div class="ldd-attr-grid">
                    @AttrRow("First Touch",  _lead.Source,       SourceIcon(_lead.Source))
                    @AttrRow("Last Touch",   _lead.LastTouch ?? _lead.Source, SourceIcon(_lead.LastTouch ?? _lead.Source))
                    @AttrRow("Campaign",     _lead.CampaignName ?? "None", "bi-megaphone")
                    @AttrRow("Referred By",  _lead.ReferredBy ?? "—", "bi-share")
                    @AttrRow("UTM Medium",   _lead.UtmMedium ?? "—", "bi-link-45deg")
                    @AttrRow("UTM Source",   _lead.UtmSource ?? "—", "bi-link")
                </div>
            </div>

            <!-- Engagement Level -->
            <div class="ldd-panel-card">
                <div class="ldd-panel-card-hdr">
                    <i class="bi bi-activity ldd-panel-icon ldd-pi--engage" aria-hidden="true"></i>
                    <span class="ldd-panel-title">Engagement Level</span>
                    <span class="@EngageBadge(_engageLevel)">@_engageLevel</span>
                </div>
                <div class="ldd-engage-metrics">
                    @EngageMetric("Emails Opened",  _engageMetrics.EmailsOpened,  _engageMetrics.EmailsSent,   "bi-envelope-open")
                    @EngageMetric("Links Clicked",  _engageMetrics.Clicks,         _engageMetrics.EmailsOpened, "bi-cursor")
                    @EngageMetric("Portal Visits",  _engageMetrics.PortalVisits,   0,                           "bi-globe")
                    @EngageMetric("Activities",     _engageMetrics.ActivityCount,  0,                           "bi-lightning")
                    @EngageMetric("Days Since Touch",_engageMetrics.DaysSinceTouch,0,                           "bi-clock")
                </div>
                <div class="ldd-engage-timeline">
                    <div class="ldd-etl-label">30-day activity</div>
                    <div class="ldd-etl-bars">
                        @foreach (var b in _engageBars)
                        {
                            <div class="ldd-etl-bar-col" title="@b.Date.ToString("M"): @b.Count">
                                <div class="ldd-etl-bar" style="height:@(b.MaxCount == 0 ? 0 : (double)b.Count/b.MaxCount*100)%"></div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Next Best Action -->
            <div class="ldd-panel-card ldd-panel-card--nba">
                <div class="ldd-panel-card-hdr">
                    <i class="bi bi-stars ldd-panel-icon ldd-pi--nba" aria-hidden="true"></i>
                    <span class="ldd-panel-title">Next Best Action</span>
                    <span class="ldd-ai-chip"><i class="bi bi-robot" aria-hidden="true"></i> AI</span>
                </div>
                @if (_nbaLoading)
                {
                    <div class="ldd-nba-loading">
                        <span class="um-spin" aria-hidden="true"></span>
                        <span>Analysing lead…</span>
                    </div>
                }
                else if (_nbaActions.Count == 0)
                {
                    <p class="ldd-nba-empty">No recommendations yet.</p>
                }
                else
                {
                    <div class="ldd-nba-list">
                        @foreach (var a in _nbaActions)
                        {
                            <div class="ldd-nba-item @(a.Priority == "High" ? "ldd-nba-item--high" : "")">
                                <div class="ldd-nba-icon @NbaIconColor(a.Type)">
                                    <i class="bi @NbaIcon(a.Type)" aria-hidden="true"></i>
                                </div>
                                <div class="ldd-nba-body">
                                    <div class="ldd-nba-action">@a.Action</div>
                                    <div class="ldd-nba-reason">@a.Reason</div>
                                    @if (a.DueDate.HasValue)
                                    {
                                        <div class="ldd-nba-due @(a.DueDate.Value < DateTime.UtcNow.AddDays(2) ? "ldd-nba-due--urgent" : "")">
                                            <i class="bi bi-alarm" aria-hidden="true"></i> @a.DueDate.Value.ToString("M")
                                        </div>
                                    }
                                </div>
                                <button class="um-btn um-btn-ghost um-btn-sm ldd-nba-act-btn" title="Act now">
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </button>
                            </div>
                        }
                    </div>
                    <button class="um-btn um-btn-ghost um-btn-sm ldd-nba-refresh" @onclick="LoadNbaAsync">
                        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
                    </button>
                }
            </div>

        </aside>
    </div>
}

