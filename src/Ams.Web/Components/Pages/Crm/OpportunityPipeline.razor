@page "/crm/opportunities/pipeline"
@page "/tenant/crm/pipeline"
@page "/tenant/crm/pipeline-settings"
@namespace Ams.Web.Components.Pages.Crm
@using System.Globalization
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Opportunities
@using BlazorChangeEventArgs = Microsoft.AspNetCore.Components.ChangeEventArgs
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>CRM Pipeline Command Center - AMS</PageTitle>

@if (_toastVisible)
{
    <div class="opl-toast opl-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="opl-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showStageModal)
{
    <div class="opl-modal-backdrop" role="presentation" @onclick="CloseStageModal">
        <div class="opl-stage-modal" role="dialog" aria-modal="true" aria-labelledby="stageModalTitle" @onclick:stopPropagation="true">
            <div class="opl-modal-header">
                <div class="opl-modal-title"><span class="opl-modal-icon"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i></span><span><h2 id="stageModalTitle">Move Pipeline Stage</h2><p>@_selectedIds.Count selected opportunity(s)</p></span></div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseStageModal" disabled="@_busy" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="opl-modal-body">
                <label class="opl-field">Target stage<select class="opl-input" @bind="_bulkStage">@foreach (var stage in StageOptions) { <option value="@stage">@stage</option> }</select></label>
                @if (!string.IsNullOrWhiteSpace(_modalError))
                {
                    <div class="opl-form-error"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_modalError</div>
                }
            </div>
            <div class="opl-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseStageModal" disabled="@_busy">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="ApplyBulkStageAsync" disabled="@_busy"><i class="bi bi-check-lg" aria-hidden="true"></i> Move Stage</button></div>
        </div>
    </div>
}

<div class="opl-enterprise-page">
    <section class="opl-hero">
        <div class="opl-hero__content">
            <div class="opl-hero-left">
                <span class="opl-hero-icon"><i class="bi bi-funnel" aria-hidden="true"></i></span>
                <div class="opl-hero-title">
                    <div class="opl-hero__eyebrow">Enterprise CRM command center</div>
                    <div class="opl-title-row">
                        <h1>CRM Pipeline Command Center</h1>
                        <div class="opl-hero__meta">
                            <span><i class="bi bi-trophy" aria-hidden="true"></i>@_rows.Count opportunities</span>
                            <span><i class="bi bi-cash-coin" aria-hidden="true"></i>@FormatCurrency(PipelineAmount) pipeline</span>
                            <span><i class="bi bi-calendar-x" aria-hidden="true"></i>@AtRiskCount at risk</span>
                            <span><i class="bi bi-check2-circle" aria-hidden="true"></i>@CommitCount commit</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Prioritize revenue, stage movement, close urgency, owner workload, forecast confidence, and CRM workflow quality across the active tenant pipeline.</p>
        </div>
        <div class="opl-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi @(_loading ? "bi-arrow-repeat opl-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities")'><i class="bi bi-trophy" aria-hidden="true"></i> Opportunities</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities/board")'><i class="bi bi-kanban" aria-hidden="true"></i> Board</button>
            <button type="button" class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/crm/opportunities/new")'><i class="bi bi-plus-lg" aria-hidden="true"></i> New Opportunity</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger opl-error-banner" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError</div>
    }

    @if (_loading)
    {
        <section class="opl-loading-state"><i class="bi bi-arrow-repeat opl-spin" aria-hidden="true"></i><strong>Loading pipeline intelligence...</strong><span>Syncing opportunities, owners, account context, stages, close timing, and weighted forecast metrics.</span></section>
    }
    else
    {
        <section class="opl-kpi-strip" aria-label="Pipeline KPI filters">
            @foreach (var metric in Metrics)
            {
                <button type="button" class="@MetricCardClass(metric)" title="@metric.Caption" @onclick="@(() => SetFilter(metric.Filter))">
                    <span class="opl-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                    <span><span class="opl-kpi-val">@metric.Value</span><span class="opl-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
                </button>
            }
        </section>

        <section class="opl-workflow-strip" aria-label="Pipeline workflow actions">
            <button type="button" class="opl-workflow-card opl-workflow-primary" @onclick='() => SetView("board")'><i class="bi bi-kanban" aria-hidden="true"></i><span><strong>Manage stages</strong><span>Move deals through the pipeline.</span></span></button>
            <button type="button" class="opl-workflow-card" @onclick='() => SetFilter("closing")'><i class="bi bi-calendar-x" aria-hidden="true"></i><span><strong>Closing focus</strong><span>Work near-term revenue risk.</span></span></button>
            <button type="button" class="opl-workflow-card" @onclick='() => SetFilter("commit")'><i class="bi bi-check2-circle" aria-hidden="true"></i><span><strong>Commit review</strong><span>Inspect committed forecast.</span></span></button>
            <button type="button" class="opl-workflow-card" @onclick='() => SetView("forecast")'><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span><strong>Forecast quality</strong><span>Review weighted performance.</span></span></button>
            <button type="button" class="opl-workflow-card" @onclick='() => SetView("risk")'><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span><strong>Risk queue</strong><span>Prioritize overdue and unassigned deals.</span></span></button>
            <button type="button" class="opl-workflow-card" @onclick='() => SetView("settings")'><i class="bi bi-sliders2" aria-hidden="true"></i><span><strong>Configuration</strong><span>Inspect synced stage and pipeline rules.</span></span></button>
        </section>

        <section class="opl-filter-panel">
            <div class="opl-search-wrap">
                <span class="opl-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                <div class="opl-search-body">
                    <label for="pipelineSearch">Search pipeline</label>
                    <input id="pipelineSearch" class="opl-search-input" value="@_search" @oninput="OnSearchChanged" placeholder="Search opportunity, account, owner, stage, forecast, lead, or description..." />
                    <span>Search filters every view, KPI, stage board, forecast analytics, and operating table.</span>
                </div>
            </div>
            <label class="opl-filter-field">Stage<select class="opl-filter-select" value="@_stageFilter" @onchange="OnStageChanged"><option value="">All stages</option>@foreach (var stage in StageOptions) { <option value="@stage">@stage</option> }</select></label>
            <label class="opl-filter-field">Owner<select class="opl-filter-select" value="@_ownerFilter" @onchange="OnOwnerChanged"><option value="">All owners</option><option value="Unassigned">Unassigned</option>@foreach (var owner in OwnerOptions) { <option value="@owner">@owner</option> }</select></label>
            <label class="opl-filter-field">Forecast<select class="opl-filter-select" value="@_forecastFilter" @onchange="OnForecastChanged"><option value="">All forecasts</option>@foreach (var forecast in ForecastOptions) { <option value="@forecast">@forecast</option> }</select></label>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-cloud-arrow-down" aria-hidden="true"></i> Sync</button>
            <div class="opl-filter-result"><strong>@FilteredRows.Count.ToString("N0", CultureInfo.CurrentCulture)</strong><span>shown</span></div>
        </section>

        @if (_selectedIds.Count > 0)
        {
            <section class="opl-bulk-bar"><strong>@_selectedIds.Count selected</strong><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenStageModal"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Move Stage</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearSelection"><i class="bi bi-x-lg" aria-hidden="true"></i></button></section>
        }

        <section class="opl-view-tabs" aria-label="Pipeline views">
            @foreach (var view in _views)
            {
                <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label <span>@ViewCount(view.Id)</span></button>
            }
        </section>

        @if (_rows.Count == 0)
        {
            <section class="opl-empty-state"><i class="bi bi-funnel" aria-hidden="true"></i><strong>No pipeline opportunities available</strong><span>Create an opportunity or sync CRM pipeline records for this tenant.</span><button type="button" class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/crm/opportunities/new")'>New Opportunity</button></section>
        }
        else
        {
            <section class="opl-content-layout">
                <main class="opl-main-card">
                    @if (_view == "overview")
                    {
                        <div class="opl-section-head"><div><h2>Executive pipeline overview</h2><p>Pipeline ranked by revenue, weighted value, close urgency, forecast confidence, and stage movement.</p></div><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => SetView("board")'><i class="bi bi-kanban" aria-hidden="true"></i> Stage Board</button></div>
                        <div class="opl-overview-grid"><section class="opl-spotlight-card"><span><i class="bi bi-stars" aria-hidden="true"></i> Highest priority deal</span><strong>@(TopOpportunity?.Name ?? "-")</strong><p>@(TopOpportunity is null ? "No matching pipeline item needs attention." : $"{FormatCurrency(TopOpportunity.Amount)} - {TopOpportunity.Stage} - closes {FormatDate(TopOpportunity.CloseDate)}")</p><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="SelectTopOpportunity">Inspect deal</button></section><section class="opl-guidance-card"><h3><i class="bi bi-lightbulb" aria-hidden="true"></i> Pipeline guidance</h3><p>@GuidanceText</p><div class="opl-guidance-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("closing")'>Closing</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("highprob")'>High Probability</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("commit")'>Commit</button></div></section></div>
                        <section class="opl-panel"><h3><i class="bi bi-bar-chart-line" aria-hidden="true"></i> Stage revenue ranking</h3><div class="opl-rank-stack">@foreach (var stage in StageRows) { <button type="button" class="@(stage.Label == _stageFilter ? "opl-rank-row opl-rank-active" : "opl-rank-row")" @onclick="@(() => SelectStage(stage.Label))"><span>@stage.Label</span><div><i style="width:@stage.Width"></i></div><strong>@FormatCurrency(stage.Amount)</strong><small>@stage.Count opps</small></button> }</div></section>
                    }
                    else if (_view == "board")
                    {
                        <div class="opl-section-head"><div><h2>Native stage board</h2><p>Move opportunities through qualification, proposal, negotiation, and close outcomes.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("open")'>Open</button></div>
                        <div class="opl-board">@foreach (var stage in StageOptions) { <section class="opl-board-col"><header><strong>@stage</strong><span>@FilteredRows.Count(r => r.Stage == stage)</span></header><div>@foreach (var item in FilteredRows.Where(r => r.Stage == stage)) { <article class="@(IsSelected(item) ? "opl-pipeline-card opl-pipeline-card-selected" : "opl-pipeline-card")" @onclick="@(() => SelectOpportunity(item))"><div class="opl-card-top"><span class="opl-badge @StageBadgeClass(item.Stage)">@item.Stage</span><button type="button" class="opl-card-check" @onclick:stopPropagation="true" @onclick="@(() => ToggleSelection(item.Id))"><i class="bi @(_selectedIds.Contains(item.Id) ? "bi-check-square-fill" : "bi-square")" aria-hidden="true"></i></button></div><h3>@item.Name</h3><p>@item.AccountName</p><div class="opl-card-stats"><div><span>Amount</span><strong>@FormatCurrency(item.Amount)</strong></div><div><span>Weighted</span><strong>@FormatCurrency(item.WeightedAmount)</strong></div></div><footer><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="@(() => MoveStageAsync(item, NextStage(item.Stage)))">Move</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick:stopPropagation="true" @onclick="@(() => NavigateOpportunity(item.Id))">Open</button></footer></article> }</div></section> }</div>
                    }
                    else if (_view == "forecast")
                    {
                        <div class="opl-section-head"><div><h2>Forecast quality</h2><p>Weighted pipeline, confidence bands, forecast categories, and win probability quality.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/crm/forecast")'>Forecast</button></div>
                        <div class="opl-analytics-grid">@AnalyticsPanel("Forecast distribution", ForecastRows, "bi-graph-up-arrow", "opl-tone-blue") @AnalyticsPanel("Win probability bands", WinRows, "bi-percent", "opl-tone-green") @InsightPanel</div>
                    }
                    else if (_view == "owners")
                    {
                        <div class="opl-section-head"><div><h2>Owner pipeline workload</h2><p>Open pipeline, weighted revenue, urgent closes, and forecast pressure by owner.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("closing")'>Closing</button></div>
                        <div class="opl-card-grid">@foreach (var owner in OwnerRows) { <article class="@(IsSelected(owner) ? "opl-owner-card opl-owner-card-selected" : "opl-owner-card")" @onclick="@(() => SelectOwner(owner))"><div class="opl-card-top"><span class="opl-owner-avatar">@Initials(owner.OwnerName)</span><span class="opl-badge @OwnerBadgeClass(owner)">@owner.Status</span></div><h3>@owner.OwnerName</h3><p>@owner.Summary</p><div class="opl-card-stats"><div><span>Open</span><strong>@owner.OpenCount</strong></div><div><span>Weighted</span><strong>@FormatCurrency(owner.WeightedAmount)</strong></div></div></article> }</div>
                    }
                    else if (_view == "risk")
                    {
                        <div class="opl-section-head"><div><h2>At-risk pipeline queue</h2><p>Enterprise-ranked deals needing action because they are overdue, closing soon, unassigned, low-confidence, or high-value without commit.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("atRisk")'>At Risk</button></div>
                        <div class="opl-card-grid">@foreach (var item in AtRiskRows) { <article class="@(IsSelected(item) ? "opl-risk-card opl-risk-card-selected" : "opl-risk-card")" @onclick="@(() => SelectOpportunity(item))"><div class="opl-card-top"><span class="opl-badge @RiskBadgeClass(item)">@RiskLabel(item)</span><button type="button" class="opl-card-check" @onclick:stopPropagation="true" @onclick="@(() => ToggleSelection(item.Id))"><i class="bi @(_selectedIds.Contains(item.Id) ? "bi-check-square-fill" : "bi-square")" aria-hidden="true"></i></button></div><h3>@item.Name</h3><p>@item.AccountName - @item.Owner</p><div class="opl-card-stats"><div><span>Close</span><strong>@FormatDate(item.CloseDate)</strong></div><div><span>Weighted</span><strong>@FormatCurrency(item.WeightedAmount)</strong></div></div><footer><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="@(() => MoveStageAsync(item, NextStage(item.Stage)))">Move</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick:stopPropagation="true" @onclick="@(() => NavigateOpportunity(item.Id))">Open</button></footer></article> }</div>
                    }
                    else if (_view == "settings")
                    {
                        <div class="opl-section-head"><div><h2>Pipeline configuration sync</h2><p>Tenant CRM settings and stage definitions currently driving board columns, probability signals, and workflow decisions.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/tenant/crm/pipeline-settings")'><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Manage Settings</button></div>
                        <div class="opl-config-grid"><section class="opl-panel"><h3><i class="bi bi-diagram-3" aria-hidden="true"></i> Stage definitions</h3><div class="opl-config-list">@foreach (var stage in StageConfigRows) { <button type="button" class="opl-config-row" @onclick="@(() => SelectStage(stage.StageName))"><span><strong>@stage.StageName</strong><small>@stage.StageCode - sort @stage.SortOrder</small></span><span class="opl-badge @(stage.IsClosedStage ? stage.IsWonStage ? "opl-badge-success" : "opl-badge-danger" : "opl-badge-info")">@(stage.IsClosedStage ? stage.IsWonStage ? "Won" : "Closed" : $"{stage.ProbabilityPercent}%")</span></button> }</div></section><section class="opl-panel"><h3><i class="bi bi-sliders2" aria-hidden="true"></i> Pipeline settings</h3><div class="opl-config-list">@if (_settings.Count == 0) { <div class="opl-empty-compact">No pipeline settings configured for this tenant.</div> } else { @foreach (var setting in _settings) { <div class="opl-config-row"><span><strong>@setting.SettingKey</strong><small>@setting.Category - @setting.Description</small></span><span class="opl-setting-value">@setting.SettingValue</span></div> } }</div></section></div>
                    }
                    else
                    {
                        <div class="opl-section-head"><div><h2>Pipeline operating table</h2><p>Native table synchronized from CRM opportunities, owners, accounts, stages, and forecast data.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters">Reset</button></div>
                        <div class="opl-table-wrap"><table class="opl-table"><thead><tr><th></th><th>Opportunity</th><th>Stage</th><th>Amount</th><th>Weighted</th><th>Win</th><th>Forecast</th><th>Owner</th><th>Close</th></tr></thead><tbody>@foreach (var item in FilteredRows) { <tr class="@(IsSelected(item) ? "opl-row-selected" : string.Empty)" @onclick="@(() => SelectOpportunity(item))"><td><button type="button" class="opl-card-check" @onclick:stopPropagation="true" @onclick="@(() => ToggleSelection(item.Id))"><i class="bi @(_selectedIds.Contains(item.Id) ? "bi-check-square-fill" : "bi-square")" aria-hidden="true"></i></button></td><td><strong>@item.Name</strong><small>@item.AccountName - @item.Number</small></td><td><span class="opl-badge @StageBadgeClass(item.Stage)">@item.Stage</span></td><td>@FormatCurrency(item.Amount)</td><td>@FormatCurrency(item.WeightedAmount)</td><td>@item.WinPct.ToString("F0", CultureInfo.CurrentCulture)%</td><td><span class="opl-badge @ForecastBadgeClass(item.Forecast)">@item.Forecast</span></td><td>@item.Owner</td><td class="@(item.IsOverdue ? "opl-overdue" : string.Empty)">@FormatDate(item.CloseDate)</td></tr> }</tbody></table></div>
                    }
                </main>

                <aside class="opl-detail-panel">
                    @if (_selected is not null)
                    {
                        <div class="opl-detail-head"><div><span><i class="bi bi-trophy" aria-hidden="true"></i> Pipeline opportunity</span><h2>@_selected.Name</h2><p>@_selected.AccountName - @_selected.Number</p></div><span class="opl-badge @StageBadgeClass(_selected.Stage)">@_selected.Stage</span></div>
                        <div class="opl-score-ring"><strong>@_selected.WinPct.ToString("F0", CultureInfo.CurrentCulture)%</strong><span>win probability</span></div>
                        <div class="opl-detail-summary"><div><span>Pipeline</span><strong>@FormatCurrency(_selected.Amount)</strong></div><div><span>Weighted</span><strong>@FormatCurrency(_selected.WeightedAmount)</strong></div><div><span>Owner</span><strong>@_selected.Owner</strong></div><div><span>Close</span><strong>@FormatDate(_selected.CloseDate)</strong></div></div>
                        <div class="opl-note-card"><strong>Pipeline action</strong><p>@NextBestAction(_selected)</p></div>
                        <div class="opl-rules-card"><header><strong>Pipeline signals</strong><span>@_selected.Forecast</span></header>@foreach (var signal in Signals(_selected)) { <p><em>@signal</em><span>active</span></p> }</div>
                        <div class="opl-detail-actions"><button type="button" class="um-btn um-btn-primary" @onclick="@(() => NavigateOpportunity(_selected.Id))"><i class="bi bi-arrow-right" aria-hidden="true"></i> Open</button><button type="button" class="um-btn um-btn-ghost" @onclick="@(() => MoveStageAsync(_selected, NextStage(_selected.Stage)))"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Move</button><button type="button" class="um-btn um-btn-ghost" @onclick="@(() => ToggleSelection(_selected.Id))"><i class="bi bi-check-square" aria-hidden="true"></i> Select</button></div>
                    }
                    else if (_selectedOwner is not null)
                    {
                        <div class="opl-detail-head"><div><span><i class="bi bi-person-badge" aria-hidden="true"></i> Owner pipeline</span><h2>@_selectedOwner.OwnerName</h2><p>@_selectedOwner.Summary</p></div><span class="opl-badge @OwnerBadgeClass(_selectedOwner)">@_selectedOwner.Status</span></div>
                        <div class="opl-detail-summary"><div><span>Open</span><strong>@_selectedOwner.OpenCount</strong></div><div><span>Total</span><strong>@FormatCurrency(_selectedOwner.TotalAmount)</strong></div><div><span>Weighted</span><strong>@FormatCurrency(_selectedOwner.WeightedAmount)</strong></div><div><span>Closing</span><strong>@_selectedOwner.ClosingCount</strong></div></div>
                        <div class="opl-rules-card"><header><strong>Owner opportunities</strong><span>@_selectedOwner.Count total</span></header>@foreach (var item in _rows.Where(r => r.Owner == _selectedOwner.OwnerName).Take(5)) { <p><em>@item.Name</em><span>@FormatCurrency(item.Amount)</span></p> }</div>
                    }
                    else
                    {
                        <div class="opl-detail-empty"><i class="bi bi-funnel" aria-hidden="true"></i><strong>Select a pipeline item</strong><span>Review stage, weighted value, owner, urgency, and recommended actions.</span></div>
                    }
                </aside>
            </section>
        }
    }
</div>

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading = true;
    private bool _busy;
    private bool _showStageModal;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string _modalError = string.Empty;
    private string _search = string.Empty;
    private string _activeFilter = "all";
    private string _stageFilter = string.Empty;
    private string _ownerFilter = string.Empty;
    private string _forecastFilter = string.Empty;
    private string _view = "overview";
    private string _bulkStage = "Qualification";
    private PipelineRow? _selected;
    private OwnerRow? _selectedOwner;
    private List<PipelineRow> _rows = [];
    private List<AccountDto> _accounts = [];
    private List<UserDto> _users = [];
    private List<OpportunityStageDto> _stages = [];
    private List<OpportunityForecastCategoryDto> _forecastCategories = [];
    private List<PipelineSettingDto> _settings = [];
    private HashSet<Guid> _selectedIds = [];

    private readonly ViewDef[] _views = [new("overview", "Overview", "bi-speedometer2"), new("board", "Stage Board", "bi-kanban"), new("forecast", "Forecast", "bi-graph-up-arrow"), new("owners", "Owners", "bi-people"), new("risk", "At Risk", "bi-exclamation-octagon"), new("settings", "Settings", "bi-sliders2"), new("table", "Table", "bi-table")];

    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", _ => "bi-check-circle-fill" };
    private IReadOnlyList<string> StageOptions => OpportunityPageConstants.ActiveStageNames(_stages);
    private IReadOnlyList<string> ForecastOptions => OpportunityPageConstants.ForecastCategoryNames(_forecastCategories);
    private IReadOnlyList<PipelineRow> FilteredRows => ApplyFilters(_rows).ToList();
    private IReadOnlyList<DistributionRow> StageRows => BuildDistribution(FilteredRows.Select(r => new DistributionSource(r.Stage, 1, r.Amount)));
    private IReadOnlyList<DistributionRow> ForecastRows => BuildDistribution(FilteredRows.Select(r => new DistributionSource(r.Forecast, 1, r.WeightedAmount)));
    private IReadOnlyList<DistributionRow> WinRows => BuildDistribution(FilteredRows.Select(r => new DistributionSource(WinBand(r.WinPct), 1, r.WeightedAmount)));
    private IReadOnlyList<OwnerRow> OwnerRows => BuildOwnerRows();
    private IReadOnlyList<OpportunityStageDto> StageConfigRows => _stages;
    private IEnumerable<string> OwnerOptions => _rows.Select(r => r.Owner).Where(o => !string.IsNullOrWhiteSpace(o) && o != "Unassigned").Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(o => o);
    private PipelineRow? TopOpportunity => FilteredRows.OrderByDescending(r => r.PriorityScore).ThenByDescending(r => r.Amount).FirstOrDefault();
    private int OpenCount => _rows.Count(r => r.IsOpen);
    private int ClosingCount => _rows.Count(r => r.IsOpen && r.DaysToClose <= 7);
    private int AtRiskCount => _rows.Count(IsAtRisk);
    private int CommitCount => _rows.Count(r => r.Forecast == "Commit");
    private decimal PipelineAmount => _rows.Where(r => r.IsOpen).Sum(r => r.Amount);
    private decimal WeightedAmount => _rows.Where(r => r.IsOpen).Sum(r => r.WeightedAmount);
    private double AverageWinRate => _rows.Count == 0 ? 0 : _rows.Average(r => (double)r.WinPct);
    private string GuidanceText => ClosingCount > 0 ? $"{ClosingCount.ToString("N0", CultureInfo.CurrentCulture)} open opportunity(s) close within 7 days and need immediate follow-up." : CommitCount > 0 ? $"{CommitCount.ToString("N0", CultureInfo.CurrentCulture)} committed opportunity(s) should be protected through close." : "Pipeline is ready for prioritization by stage, weighted value, and close timing.";
    private IReadOnlyList<PipelineRow> AtRiskRows => FilteredRows.Where(IsAtRisk).OrderByDescending(r => r.RiskScore).ThenBy(r => r.CloseDate).ToList();
    private IReadOnlyList<Metric> Metrics => [new("all", _rows.Count.ToString("N0", CultureInfo.CurrentCulture), "Total", "All pipeline records", "bi-funnel", "opl-kpi-blue"), new("open", OpenCount.ToString("N0", CultureInfo.CurrentCulture), "Open", "Active stages", "bi-kanban", "opl-kpi-green"), new("pipeline", FormatCurrency(PipelineAmount), "Pipeline", "Open estimated amount", "bi-cash-coin", "opl-kpi-cyan"), new("weighted", FormatCurrency(WeightedAmount), "Weighted", "Probability-adjusted value", "bi-graph-up-arrow", "opl-kpi-purple"), new("atRisk", AtRiskCount.ToString("N0", CultureInfo.CurrentCulture), "At Risk", "Overdue, unassigned, or low-confidence", "bi-exclamation-octagon", "opl-kpi-red"), new("commit", CommitCount.ToString("N0", CultureInfo.CurrentCulture), "Commit", "Committed forecast", "bi-check2-circle", "opl-kpi-green")];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Opportunities", "/crm/opportunities"), new("Pipeline", "/crm/opportunities/pipeline"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            if (_tenantId == Guid.Empty) await ResolveCurrentUserContextAsync();
            var opportunities = await Api.SearchOpportunitiesAsync(_tenantId, pageSize: 500);
            var accounts = await Api.SearchAccountsAsync(_tenantId, pageSize: 500);
            var users = await Api.SearchUsersAsync(_tenantId, pageSize: 500);
            var stages = await Api.SearchOpportunityStagesAsync(_tenantId, pageSize: 200);
            var settings = await Api.GetPipelineSettingsAsync(_tenantId);
            _accounts = accounts?.Items.ToList() ?? [];
            _users = users?.Items.ToList() ?? [];
            _stages = stages?.Items.OrderBy(s => s.SortOrder).ThenBy(s => s.StageName).ToList() ?? [];
            _settings = settings?.OrderBy(s => s.Category).ThenBy(s => s.SettingKey).ToList() ?? [];
            _rows = (opportunities?.Items ?? []).Select(MapOpportunity).OrderByDescending(r => r.PriorityScore).ToList();
            _selected = _selected is null ? FilteredRows.FirstOrDefault() : _rows.FirstOrDefault(r => r.Id == _selected.Id) ?? FilteredRows.FirstOrDefault();
            _selectedOwner = null;
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load opportunity pipeline: {ex.Message}";
            _rows = [];
            _selected = null;
            _selectedOwner = null;
            ShowToast($"Pipeline load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private PipelineRow MapOpportunity(OpportunityDto dto)
    {
        var stage = !string.IsNullOrWhiteSpace(dto.StageName) ? dto.StageName! : OpportunityPageConstants.StageName(dto.StatusCode);
        var owner = !string.IsNullOrWhiteSpace(dto.OwnerName) ? dto.OwnerName! : OwnerName(dto.OwnerUserId);
        return new(dto.OpportunityId, dto.OpportunityNumber, dto.OpportunityName, dto.AccountName ?? AccountName(dto.AccountId), stage, dto.EstimatedAmount, dto.WinProbability, OpportunityPageConstants.NormalizeForecast(dto.ForecastCategoryCode), dto.OwnerUserId, owner, dto.CloseDate, dto.Description, dto.SourceLead, dto.CreatedDateUtc);
    }

    private IEnumerable<PipelineRow> ApplyFilters(IEnumerable<PipelineRow> rows)
    {
        var query = rows;
        if (!string.IsNullOrWhiteSpace(_search)) { var term = _search.Trim(); query = query.Where(r => Contains(r.Name, term) || Contains(r.Number, term) || Contains(r.AccountName, term) || Contains(r.Owner, term) || Contains(r.Stage, term) || Contains(r.Forecast, term) || Contains(r.Description, term) || Contains(r.SourceLead, term)); }
        if (!string.IsNullOrWhiteSpace(_stageFilter)) query = query.Where(r => r.Stage == _stageFilter);
        if (!string.IsNullOrWhiteSpace(_ownerFilter)) query = _ownerFilter == "Unassigned" ? query.Where(r => r.Owner == "Unassigned") : query.Where(r => r.Owner == _ownerFilter);
        if (!string.IsNullOrWhiteSpace(_forecastFilter)) query = query.Where(r => r.Forecast == _forecastFilter);
        query = _activeFilter switch { "open" => query.Where(r => r.IsOpen), "pipeline" => query.Where(r => r.IsOpen), "weighted" => query.Where(r => r.IsOpen && r.WinPct > 0), "closing" => query.Where(r => r.IsOpen && r.DaysToClose <= 7), "atRisk" => query.Where(IsAtRisk), "highprob" => query.Where(r => r.WinPct >= 70), "commit" => query.Where(r => r.Forecast == "Commit"), _ => query };
        return query.OrderByDescending(r => r.PriorityScore).ThenBy(r => r.CloseDate);
    }

    private IReadOnlyList<OwnerRow> BuildOwnerRows()
    {
        return _rows.GroupBy(r => r.Owner).Select(g =>
        {
            var items = g.ToList();
            var open = items.Count(r => r.IsOpen);
            var total = items.Sum(r => r.Amount);
            var weighted = items.Sum(r => r.WeightedAmount);
            var closing = items.Count(r => r.IsOpen && r.DaysToClose <= 7);
            var status = g.Key == "Unassigned" ? "Gap" : closing > 0 ? "Urgent" : weighted >= 100000 ? "High Value" : "Stable";
            var summary = $"{open.ToString("N0", CultureInfo.CurrentCulture)} open opportunity(s), {FormatCurrency(weighted)} weighted pipeline.";
            return new OwnerRow(g.Key, items.Count, open, total, weighted, closing, status, summary);
        }).OrderByDescending(o => o.Status == "Gap").ThenByDescending(o => o.WeightedAmount).ThenBy(o => o.OwnerName).ToList();
    }

    private async Task MoveStageAsync(PipelineRow row, string stage)
    {
        try
        {
            await Api.UpdateOpportunityStageAsync(row.Id, new UpdateOpportunityStageRequest { Stage = stage, ModifiedByUserId = _tenantAdminUserId });
            await LoadAsync();
            ShowToast($"{row.Name} moved to {stage}.", "success");
        }
        catch (Exception ex)
        {
            ShowToast($"Stage update failed: {ex.Message}", "danger");
        }
    }

    private async Task ApplyBulkStageAsync()
    {
        if (_selectedIds.Count == 0) { _modalError = "Select at least one opportunity."; return; }
        _busy = true;
        _modalError = string.Empty;
        try
        {
            foreach (var row in _rows.Where(r => _selectedIds.Contains(r.Id)))
            {
                await Api.UpdateOpportunityStageAsync(row.Id, new UpdateOpportunityStageRequest { Stage = _bulkStage, ModifiedByUserId = _tenantAdminUserId });
            }
            _showStageModal = false;
            var count = _selectedIds.Count;
            _selectedIds.Clear();
            await LoadAsync();
            ShowToast($"{count} opportunity(s) moved to {_bulkStage}.", "success");
        }
        catch (Exception ex)
        {
            _modalError = $"Move failed: {ex.Message}";
            ShowToast($"Move failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void SetFilter(string filter) { _activeFilter = _activeFilter == filter && filter != "all" ? "all" : filter; if (filter is "atRisk") _view = "risk"; else if (filter is "closing" or "commit" or "highprob") _view = "table"; _selected = FilteredRows.FirstOrDefault(); _selectedOwner = null; }
    private void SetView(string view) { _view = view; _selected = FilteredRows.FirstOrDefault(); _selectedOwner = null; }
    private void SelectOpportunity(PipelineRow row) { _selected = row; _selectedOwner = null; }
    private void SelectOwner(OwnerRow owner) { _selectedOwner = owner; _selected = null; }
    private void SelectTopOpportunity() { if (TopOpportunity is not null) { _selected = TopOpportunity; _selectedOwner = null; _view = "table"; } }
    private void SelectStage(string stage) { _stageFilter = _stageFilter == stage ? string.Empty : stage; _view = "table"; _selected = FilteredRows.FirstOrDefault(); }
    private void ToggleSelection(Guid id) { if (!_selectedIds.Remove(id)) _selectedIds.Add(id); }
    private void ClearSelection() => _selectedIds.Clear();
    private void OpenStageModal() { if (_selected is not null) _selectedIds.Add(_selected.Id); _bulkStage = StageOptions.FirstOrDefault() ?? OpportunityPageConstants.DefaultStageName; _modalError = string.Empty; _showStageModal = true; }
    private void CloseStageModal() { if (!_busy) { _showStageModal = false; _modalError = string.Empty; } }
    private void ResetFilters() { _activeFilter = "all"; _search = string.Empty; _stageFilter = string.Empty; _ownerFilter = string.Empty; _forecastFilter = string.Empty; _selected = FilteredRows.FirstOrDefault(); _selectedOwner = null; }
    private void OnSearchChanged(BlazorChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; _selected = FilteredRows.FirstOrDefault(); }
    private void OnStageChanged(BlazorChangeEventArgs e) { _stageFilter = e.Value?.ToString() ?? string.Empty; _activeFilter = "all"; _selected = FilteredRows.FirstOrDefault(); }
    private void OnOwnerChanged(BlazorChangeEventArgs e) { _ownerFilter = e.Value?.ToString() ?? string.Empty; _activeFilter = "all"; _selected = FilteredRows.FirstOrDefault(); }
    private void OnForecastChanged(BlazorChangeEventArgs e) { _forecastFilter = e.Value?.ToString() ?? string.Empty; _activeFilter = "all"; _selected = FilteredRows.FirstOrDefault(); }
    private void NavigateOpportunity(Guid id) => Nav.NavigateTo($"/crm/opportunities/{id}");
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind) { _toastMessage = message.Length <= 150 ? message : $"{message[..147]}..."; _toastKind = ToastKind(kind); _toastVisible = true; }

    private int ViewCount(string view) => view switch { "owners" => OwnerRows.Count, "risk" => AtRiskRows.Count, "board" => StageOptions.Count, "settings" => StageConfigRows.Count + _settings.Count, _ => FilteredRows.Count };
    private bool IsSelected(PipelineRow row) => _selected?.Id == row.Id;
    private bool IsSelected(OwnerRow owner) => _selectedOwner?.OwnerName == owner.OwnerName;
    private string AccountName(Guid accountId) => _accounts.FirstOrDefault(a => a.AccountId == accountId)?.AccountName ?? "Unknown account";
    private string OwnerName(Guid? ownerId) { if (!ownerId.HasValue) return "Unassigned"; var user = _users.FirstOrDefault(u => u.UserId == ownerId.Value); return user is null ? "Unknown owner" : DisplayUser(user); }
    private static string DisplayUser(UserDto user) => !string.IsNullOrWhiteSpace(user.DisplayName) ? user.DisplayName : !string.IsNullOrWhiteSpace(user.FullName) ? user.FullName : user.UserName;
    private static string Initials(string name) { var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : parts.Length == 1 ? parts[0][..1] : "?"; }
    private string NextStage(string stage) { var stages = StageOptions.ToList(); var index = stages.FindIndex(s => string.Equals(s, stage, StringComparison.OrdinalIgnoreCase)); return index < 0 || index >= stages.Count - 1 ? stage : stages[index + 1]; }
    private static string WinBand(decimal winPct) => winPct >= 70 ? "High 70%+" : winPct >= 40 ? "Medium 40-69%" : "Low <40%";
    private static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static string FormatCurrency(decimal value) => value.ToString("C0", CultureInfo.CurrentCulture);
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture) : "Not set";
    private static string WidthPct(decimal value, decimal max) => (max <= 0 ? 4 : Math.Max(4, Math.Min(100, (double)(value / max * 100)))).ToString("F1", CultureInfo.InvariantCulture) + "%";
    private static string ToastKind(string value) => value.Contains("danger", StringComparison.OrdinalIgnoreCase) || value.Contains("error", StringComparison.OrdinalIgnoreCase) ? "danger" : value.Contains("warning", StringComparison.OrdinalIgnoreCase) ? "warning" : "success";
    private string MetricCardClass(Metric metric) => $"opl-kpi-card {metric.Tone} {(_activeFilter == metric.Filter ? "opl-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewDef view) => $"opl-view-btn {(view.Id == _view ? "opl-view-btn-active" : string.Empty)}";
    private static string StageBadgeClass(string stage) => stage switch { "Closed Won" => "opl-badge-success", "Closed Lost" => "opl-badge-danger", "Negotiation" => "opl-badge-warning", "Proposal" => "opl-badge-purple", "Needs Analysis" => "opl-badge-info", _ => "opl-badge-neutral" };
    private static string ForecastBadgeClass(string forecast) => forecast switch { "Commit" => "opl-badge-success", "Best Case" => "opl-badge-info", "Closed" => "opl-badge-purple", _ => "opl-badge-neutral" };
    private static string OwnerBadgeClass(OwnerRow owner) => owner.Status switch { "Gap" => "opl-badge-danger", "Urgent" => "opl-badge-warning", "High Value" => "opl-badge-success", _ => "opl-badge-info" };
    private static bool IsAtRisk(PipelineRow row) => row.IsOpen && (row.IsOverdue || row.DaysToClose <= 7 || row.Owner == "Unassigned" || row.WinPct < 35 || (row.Amount >= 100000 && row.Forecast != "Commit"));
    private static string RiskLabel(PipelineRow row) => row.IsOverdue ? "Overdue" : row.Owner == "Unassigned" ? "Unassigned" : row.DaysToClose <= 7 ? "Closing" : row.WinPct < 35 ? "Low Confidence" : "High Value";
    private static string RiskBadgeClass(PipelineRow row) => row.IsOverdue || row.Owner == "Unassigned" ? "opl-badge-danger" : row.DaysToClose <= 7 ? "opl-badge-warning" : row.WinPct < 35 ? "opl-badge-info" : "opl-badge-purple";
    private static string NextBestAction(PipelineRow row) => row.IsOverdue ? "Close date is overdue. Update the close plan, decision outcome, or stage immediately." : row.DaysToClose <= 7 ? "Confirm the decision path, remove blockers, and update the forecast before close." : row.WinPct >= 70 ? "Protect this high-probability opportunity and drive it toward commit or close." : "Create the next activity and strengthen qualification or proposal signals.";
    private static IEnumerable<string> Signals(PipelineRow row) { yield return $"Stage: {row.Stage}."; yield return $"Weighted value: {FormatCurrency(row.WeightedAmount)}."; if (row.DaysToClose <= 7) yield return "Close date is within seven days."; if (row.WinPct >= 70) yield return "High win probability."; if (row.Owner == "Unassigned") yield return "Owner assignment is required."; }

    private RenderFragment AnalyticsPanel(string title, IReadOnlyList<DistributionRow> rows, string icon, string tone) => @<section class="opl-analytics-panel @tone"><h3><i class="bi @icon" aria-hidden="true"></i> @title</h3><div class="opl-analytics-list">@foreach (var row in rows) { <button type="button" @onclick="@(() => ApplyDistribution(row.Label, title))"><span>@row.Label</span><div><i style="width:@row.Width"></i></div><strong>@FormatCurrency(row.Amount)</strong><small>@row.Count.ToString("N0", CultureInfo.CurrentCulture)</small></button> }</div></section>;
    private RenderFragment InsightPanel => @<section class="opl-analytics-panel opl-tone-amber"><h3><i class="bi bi-lightbulb" aria-hidden="true"></i> Executive insight</h3><div class="opl-insight-grid"><div><span>Open</span><strong>@OpenCount</strong><small>active deals</small></div><div><span>Weighted</span><strong>@FormatCurrency(WeightedAmount)</strong><small>forecast value</small></div><div><span>Closing</span><strong>@ClosingCount</strong><small>7 days</small></div><div><span>Win</span><strong>@AverageWinRate.ToString("F0", CultureInfo.CurrentCulture)%</strong><small>average</small></div></div><p>@GuidanceText</p></section>;

    private void ApplyDistribution(string label, string title)
    {
        if (title.Contains("Forecast", StringComparison.OrdinalIgnoreCase)) _forecastFilter = _forecastFilter == label ? string.Empty : label;
        else if (title.Contains("Win", StringComparison.OrdinalIgnoreCase)) _activeFilter = label.StartsWith("High", StringComparison.OrdinalIgnoreCase) ? "highprob" : "all";
        else _stageFilter = _stageFilter == label ? string.Empty : label;
        _view = "table";
        _selected = FilteredRows.FirstOrDefault();
    }

    private static IReadOnlyList<DistributionRow> BuildDistribution(IEnumerable<DistributionSource> sources)
    {
        var rows = sources.GroupBy(s => s.Label).Select(g => new DistributionRow(g.Key, g.Count(), g.Sum(x => x.Amount), "0%")).OrderByDescending(r => r.Amount).ThenBy(r => r.Label).ToList();
        var max = Math.Max(1, rows.Select(r => r.Amount).DefaultIfEmpty(1).Max());
        return rows.Select(r => r with { Width = WidthPct(r.Amount, max) }).ToList();
    }

    private async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; }

    private sealed record ViewDef(string Id, string Label, string Icon);
    private sealed record Metric(string Filter, string Value, string Label, string Caption, string Icon, string Tone);
    private sealed record DistributionSource(string Label, int Count, decimal Amount);
    private sealed record DistributionRow(string Label, int Count, decimal Amount, string Width);
    private sealed record OwnerRow(string OwnerName, int Count, int OpenCount, decimal TotalAmount, decimal WeightedAmount, int ClosingCount, string Status, string Summary);
    private sealed record PipelineRow(Guid Id, string Number, string Name, string AccountName, string Stage, decimal Amount, decimal WinPct, string Forecast, Guid? OwnerUserId, string Owner, DateTime? CloseDate, string? Description, string? SourceLead, DateTime CreatedDateUtc)
    {
        public bool IsOpen => Stage is not "Closed Won" and not "Closed Lost";
        public int DaysToClose => CloseDate.HasValue ? (int)Math.Ceiling((CloseDate.Value.Date - DateTime.UtcNow.Date).TotalDays) : int.MaxValue;
        public bool IsOverdue => IsOpen && CloseDate.HasValue && CloseDate.Value.Date < DateTime.UtcNow.Date;
        public decimal WeightedAmount => Amount * WinPct / 100m;
        public decimal RiskScore => (IsOverdue ? 500000 : 0) + (Owner == "Unassigned" ? 300000 : 0) + (DaysToClose <= 7 ? 250000 : 0) + (WinPct < 35 ? 125000 : 0) + Amount;
        public decimal PriorityScore => (IsOpen ? 500 : 0) + WeightedAmount + (DaysToClose <= 7 ? 250000 : 0) + (Forecast == "Commit" ? 150000 : 0) + (WinPct * 1000);
    }
}
