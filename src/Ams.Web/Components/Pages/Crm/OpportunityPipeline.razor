@page "/crm/opportunities/pipeline"
@namespace Ams.Web.Components.Pages.Crm
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Pipeline View — CRM</PageTitle>

<AppPageHeader Title="Pipeline View" Subtitle="Analyze opportunity pipeline by stage, forecast, and close timing" Icon="bi-funnel"><Actions><button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/crm/opportunities/new")'><i class="bi bi-plus-lg"></i> New Opportunity</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<section class="ma-hero opp-hero"><div><span class="ma-eyebrow">CRM · Opportunities</span><h2>Pipeline Analytics</h2><p>Analyze total and weighted sales pipeline without removing the existing opportunity workflow.</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities/board")'><i class="bi bi-kanban"></i> Board</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/forecast")'><i class="bi bi-graph-up-arrow"></i> Forecast</button></div></section>
<div class="pc-kpi-strip opp-kpi-strip"><div class="pc-kpi-card"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-trophy"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Opportunities</div></div></div><div class="pc-kpi-card"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-cash-coin"></i></span><div><div class="pc-kpi-value">@_items.Sum(x => x.EstimatedAmount).ToString("C0")</div><div class="pc-kpi-label">Pipeline</div></div></div><div class="pc-kpi-card"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-graph-up-arrow"></i></span><div><div class="pc-kpi-value">@_items.Sum(x => x.WeightedAmount).ToString("C0")</div><div class="pc-kpi-label">Weighted</div></div></div><div class="pc-kpi-card"><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-percent"></i></span><div><div class="pc-kpi-value">@(_items.Any() ? _items.Average(x => x.WinProbability).ToString("F0") : "0")%</div><div class="pc-kpi-label">Avg Win</div></div></div></div>
<div class="ma-filter-bar opp-filter-bar"><div class="ma-search-wrap"><i class="bi bi-search"></i><input class="ma-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search opportunities or accounts…" /></div><button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button><span class="ma-filter-count">@Filtered.Count() opportunities</span></div>
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }
@if (_loading) { <div class="mt-loading"><div class="um-spinner"></div><span>Loading pipeline…</span></div> }
else { <div class="opp-pipeline-layout"><section class="opp-panel"><h3>Pipeline by Stage</h3>@foreach (var stage in StageMetrics) { var max = StageMetrics.Max(x => x.Amount); var pct = max == 0 ? 0 : stage.Amount / max * 100; <div class="opp-stage-row"><span class="@OpportunityPageConstants.StageBadge(stage.Stage)">@stage.Stage</span><div class="opp-stage-track"><div style="width:@pct.ToString("F1")%"></div></div><strong>@stage.Amount.ToString("C0")</strong><small>@stage.Count opps</small></div> }</section><section class="opp-panel"><h3>Forecast Distribution</h3><SfGrid TValue="ForecastMetric" DataSource="@ForecastMetrics" AllowSorting="true" EnableHover="true" RowHeight="48"><GridColumns><GridColumn Field="Category" HeaderText="Forecast"><Template>@{ var f=(ForecastMetric)context; }<span class="@OpportunityPageConstants.ForecastBadge(f.Category)">@f.Category</span></Template></GridColumn><GridColumn Field="Count" HeaderText="Count" Width="90" TextAlign="TextAlign.Right" /><GridColumn Field="Amount" HeaderText="Pipeline" Width="140" TextAlign="TextAlign.Right"><Template>@{ var f=(ForecastMetric)context; }@f.Amount.ToString("C0")</Template></GridColumn><GridColumn Field="Weighted" HeaderText="Weighted" Width="140" TextAlign="TextAlign.Right"><Template>@{ var f=(ForecastMetric)context; }@f.Weighted.ToString("C0")</Template></GridColumn></GridColumns></SfGrid></section></div><div class="um-grid-card"><SfGrid TValue="OpportunityRow" DataSource="@Filtered.ToList()" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="56"><GridEvents TValue="OpportunityRow" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" /><GridColumns><GridColumn Field="OpportunityName" HeaderText="Opportunity" MinWidth="220" /><GridColumn Field="AccountName" HeaderText="Account" Width="190" /><GridColumn Field="Stage" HeaderText="Stage" Width="145"><Template>@{ var r=(OpportunityRow)context; }<span class="@OpportunityPageConstants.StageBadge(r.Stage)">@r.Stage</span></Template></GridColumn><GridColumn Field="EstimatedAmount" HeaderText="Amount" Width="130" TextAlign="TextAlign.Right"><Template>@{ var r=(OpportunityRow)context; }@r.EstimatedAmount.ToString("C0")</Template></GridColumn><GridColumn Field="WeightedAmount" HeaderText="Weighted" Width="130" TextAlign="TextAlign.Right"><Template>@{ var r=(OpportunityRow)context; }@r.WeightedAmount.ToString("C0")</Template></GridColumn><GridColumn Field="CloseDate" HeaderText="Close" Width="120" Format="d" /></GridColumns></SfGrid></div> }
@code { sealed record StageMetric(string Stage, int Count, decimal Amount); sealed record ForecastMetric(string Category, int Count, decimal Amount, decimal Weighted); List<OpportunityRow> _items = []; string _search = string.Empty; string? _loadError; bool _loading; IEnumerable<OpportunityRow> Filtered => _items.Where(x => string.IsNullOrWhiteSpace(_search) || x.OpportunityName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase)); List<StageMetric> StageMetrics => Filtered.GroupBy(x => x.Stage).Select(g => new StageMetric(g.Key, g.Count(), g.Sum(x => x.EstimatedAmount))).OrderBy(x => OpportunityPageConstants.StageOrder(x.Stage)).ToList(); List<ForecastMetric> ForecastMetrics => Filtered.GroupBy(x => x.ForecastCategory).Select(g => new ForecastMetric(g.Key, g.Count(), g.Sum(x => x.EstimatedAmount), g.Sum(x => x.WeightedAmount))).ToList(); protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("CRM", "/crm/opportunities"), new("Pipeline View")); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchOpportunitiesAsync(OpportunityPageConstants.TenantId); _items = (result?.Items ?? []).Select(OpportunityPageData.FromDto).ToList(); } catch (Exception ex) { _loadError = $"Failed to load pipeline: {ex.Message}"; } finally { _loading = false; } } void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; } void ResetFilters() { _search = string.Empty; } void OnRowSelected(RowSelectEventArgs<OpportunityRow> args) => Nav.NavigateTo($"/crm/opportunities/{args.Data.OpportunityId}"); }
