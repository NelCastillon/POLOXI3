<!-- ══════════════════════════════════════════════════════════
     DIALOG — Enroll Campaign
     ══════════════════════════════════════════════════════════ -->
<SfDialog @bind-Visible="_showCampaign" Width="480px" IsModal="true" ShowCloseIcon="true">
