            </div>
        </Content>
        <FooterTemplate>
            <div class="ld-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showAssign = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitAssignAsync" disabled="@string.IsNullOrEmpty(_assignTarget)">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Assign
