        <div class="ld-detail-footer">
            <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo($"/crm/leads/{_detail.LeadId}")'>
                Open Full Record <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </div>
    </div>
}

<!-- ── Add/Edit Drawer ──────────────────────────────────────────────────── -->
<AppCrudDrawer @bind-Visible="_showAdd" 
               Title="@(_editingId == Guid.Empty ? "Create New Lead" : "Edit Lead")"
               Icon="bi-person-plus"
               OnConfirm="SaveLeadAsync" 
               IsBusy="_savingLead"
               Width="420px">
    <Content>
        <EditForm Model="_leadForm" OnValidSubmit="SaveLeadAsync">
            <DataAnnotationsValidator />

            <div class="form-row">
                <label class="form-label">First Name <span class="form-required">*</span></label>
                <InputText class="form-control" placeholder="John" @bind-Value="_leadForm.FirstName" />
                <ValidationMessage For="() => _leadForm.FirstName" class="text-danger" />
            </div>
            <div class="form-row">
                <label class="form-label">Last Name <span class="form-required">*</span></label>
                <InputText class="form-control" placeholder="Doe" @bind-Value="_leadForm.LastName" />
                <ValidationMessage For="() => _leadForm.LastName" class="text-danger" />
            </div>
            <div class="form-row">
                <label class="form-label">Company <span class="form-required">*</span></label>
                <InputText class="form-control" placeholder="Company Name" @bind-Value="_leadForm.Company" />
                <ValidationMessage For="() => _leadForm.Company" class="text-danger" />
            </div>
            <div class="form-row">
                <label class="form-label">Email <span class="form-required">*</span></label>
                <InputText type="email" class="form-control" placeholder="john@example.com" @bind-Value="_leadForm.Email" />
                <ValidationMessage For="() => _leadForm.Email" class="text-danger" />
            </div>
            <div class="form-row">
                <label class="form-label">Phone</label>
                <InputText type="tel" class="form-control" placeholder="(555) 123-4567" @bind-Value="_leadForm.Phone" />
                <ValidationMessage For="() => _leadForm.Phone" class="text-danger" />
            </div>
            <div class="form-row">
                <label class="form-label">Source <span class="form-required">*</span></label>
                <InputSelect class="form-control" @bind-Value="_leadForm.Source">
                    <option value="">Select source</option>
                    @foreach (var opt in _sourceOptions)
                    {
                        <option value="@opt.Value">@opt.Label</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _leadForm.Source" class="text-danger" />
            </div>
            <div class="form-row">
                <label class="form-label">Owner</label>
                <InputSelect class="form-control" @bind-Value="_leadForm.Owner">
                    <option value="">Assign to owner</option>
                    @foreach (var opt in _ownerOptions)
                    {
                        <option value="@opt.Value">@opt.Label</option>
                    }
                </InputSelect>
            </div>
            <div class="form-row">
                <label class="form-label">Est. Premium</label>
                <InputNumber class="form-control" placeholder="0.00" step="0.01" min="0" @bind-Value="_leadForm.EstPremium" />
                <ValidationMessage For="() => _leadForm.EstPremium" class="text-danger" />
            </div>
            <div class="form-row">
                <label class="form-label">Notes</label>
                <InputTextArea class="form-control" rows="3" placeholder="Add notes…" @bind-Value="_leadForm.Notes" />
            </div>
        </EditForm>
    </Content>
</AppCrudDrawer>

<!-- ══════════════════════════════════════════════════════════
     DIALOG — Import Leads
     ══════════════════════════════════════════════════════════ -->
<SfDialog @bind-Visible="_showImport" Width="540px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="ld-dlg-hdr"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Import Leads</span></Header>
        <Content>
            <div class="ld-import-body">
                <p class="ld-import-intro">
                    Upload a <strong>.CSV</strong> or <strong>.XLSX</strong> file. Required columns:
                    <code>FirstName, LastName, Company, Email, Source</code>.
                </p>
                <SfUploader AllowedExtensions=".csv,.xlsx"
                            MaxFileSize="5242880"
                            AutoUpload="false"
                            @ref="_uploader">
                    <UploaderEvents ValueChange="OnFileSelected" />
                </SfUploader>

                @if (_importErrors.Count > 0)
                {
                    <div class="ld-import-errors">
                        <div class="ld-import-errors-hdr"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_importErrors.Count validation error(s)</div>
                        <ul>
                            @foreach (var e in _importErrors.Take(5))
                            {
                                <li>@e</li>
                            }
                            @if (_importErrors.Count > 5) { <li>… and @(_importErrors.Count - 5) more</li> }
                        </ul>
                    </div>
                }

                @if (_importPreview.Count > 0)
                {
                    <div class="ld-import-preview">
                        <div class="ld-import-preview-hdr">Preview — first @_importPreview.Count row(s)</div>
                        <SfGrid TValue="LeadImportRow"
                                DataSource="_importPreview"
                                AllowPaging="false"
                                EnableHover="true"
                                Height="160px">
                            <GridColumns>
                                <GridColumn Field="@nameof(LeadImportRow.FullName)"    HeaderText="Name"    Width="160" />
                                <GridColumn Field="@nameof(LeadImportRow.CompanyName)" HeaderText="Company" Width="160" />
                                <GridColumn Field="@nameof(LeadImportRow.Email)"       HeaderText="Email"   Width="200" />
                                <GridColumn Field="@nameof(LeadImportRow.Source)"      HeaderText="Source"  Width="120" />
                            </GridColumns>
                        </SfGrid>
                    </div>
                }

                <div class="ld-import-options">
                    <label class="ld-toggle-label">
                        <input type="checkbox" @bind="_importDedupe" />
                        Skip duplicate emails
                    </label>
                    <label class="ld-toggle-label">
                        <input type="checkbox" @bind="_importAssignRoundRobin" />
                        Auto-assign (round-robin)
                    </label>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="ld-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => { _showImport = false; _importPreview.Clear(); _importErrors.Clear(); }">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitImportAsync" disabled="@(_importPreview.Count == 0 || _importErrors.Count > 0)">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Import @(_importPreview.Count > 0 ? $"{_importPreview.Count} Lead(s)" : "")
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ══════════════════════════════════════════════════════════
     DIALOG — Assign Owner
     ══════════════════════════════════════════════════════════ -->
<SfDialog @bind-Visible="_showAssign" Width="420px" IsModal="true" ShowCloseIcon="true">
