<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast?    _toast;
    private SfGrid<LeadRow>? _grid;
    private SfUploader? _uploader;

    // ── View state ────────────────────────────────────────────────────────────
    private string _view   = "grid";
    private bool   _loading = false;

    private record ViewDef(string Id, string Label, string Icon);
    private static readonly List<ViewDef> _views =
    [
        new("grid",     "Grid",     "bi-table"),
        new("kanban",   "Kanban",   "bi-kanban"),
        new("funnel",   "Funnel",   "bi-funnel-fill"),
        new("producer", "Producer", "bi-person-badge"),
    ];

    // ── Data ──────────────────────────────────────────────────────────────────
    private List<LeadRow>   _leads    = [];
    private List<LeadRow>   _filtered = [];
    private List<SourceRow> _sourceFunnel  = [];
    private List<ProducerRow> _producerRows = [];
    private LeadKpi         _kpi = new();

    // ── Filters ───────────────────────────────────────────────────────────────
    private string _search        = string.Empty;
    private string _filterStage   = string.Empty;
    private string _filterSource  = string.Empty;
    private string _filterOwner   = string.Empty;
    private string _filterRating  = string.Empty;

    // ── Selection ─────────────────────────────────────────────────────────────
    private List<LeadRow> _selected = [];

    // ── Detail slide-over ─────────────────────────────────────────────────────
    private LeadRow? _detail = null;

    // ── Row context menu ──────────────────────────────────────────────────────
    private LeadRow? _menuLead = null;
    private double   _menuX = 0, _menuY = 0;

    // ── Kanban ────────────────────────────────────────────────────────────────
    private bool _swimByOwner = false;

    private record KanbanColDef(string Key, string Label);
    private static readonly List<KanbanColDef> _kanbanColumns =
    [
        new("New",         "New"),
        new("Contacted",   "Contacted"),
        new("Qualified",   "Qualified"),
        new("Proposal",    "Proposal"),
        new("Negotiation", "Negotiation"),
        new("Converted",   "Converted"),
        new("Lost",        "Lost"),
    ];

    // ── Funnel ────────────────────────────────────────────────────────────────
    private string _funnelSource = string.Empty;

    // ── Producer ──────────────────────────────────────────────────────────────
    private string _producerFilter = string.Empty;

    // ── Dialogs ───────────────────────────────────────────────────────────────
    private bool   _showImport    = false;
    private bool   _showAssign    = false;
    private bool   _showMerge     = false;
    private bool   _showConvert   = false;
    private bool   _showCampaign  = false;
    private bool   _showAdd       = false;
    private bool   _savingLead    = false;
    private Guid   _editingId     = Guid.Empty;

    // Import
    private List<LeadImportRow> _importPreview = [];
    private List<string>        _importErrors  = [];
    private bool _importDedupe           = true;
    private bool _importAssignRoundRobin = false;

    // Add/Edit Lead Form
    private LeadFormModel _leadForm = new();

    // Assign
    private string _assignTarget = string.Empty;
    private bool   _assignNotify = true;

    // Merge
    private string _mergeTarget = string.Empty;

    // Convert
    private bool _convertKeepLead       = false;
    private bool _convertCreateActivity = true;

    // Campaign
    private string _campaignTarget          = string.Empty;
    private bool   _campaignSendImmediately = false;

    // ── Static reference data ─────────────────────────────────────────────────
    private static readonly List<LabelValue> _stageOptions =
    [
        new("New","New"), new("Contacted","Contacted"), new("Qualified","Qualified"),
        new("Proposal","Proposal"), new("Negotiation","Negotiation"),
        new("Converted","Converted"), new("Lost","Lost"),
    ];
    private static readonly List<LabelValue> _sourceOptions =
    [
        new("Referral","Referral"), new("Website","Website"), new("Cold Call","Cold Call"),
        new("Social","Social"), new("Email","Email"), new("Event","Event"),
        new("Partner","Partner"), new("Inbound","Inbound"),
    ];
    private static readonly List<LabelValue> _ratingOptions =
    [
        new("Hot","Hot"), new("Warm","Warm"), new("Cold","Cold"),
    ];
    private List<LabelValue> _ownerOptions = [];
    private static readonly List<LabelValue> _campaignOptions =
    [
        new("c1","Q3 Commercial BOP Drip"),
        new("c2","Renewal Win-Back 2025"),
        new("c3","Mid-Market Cyber Awareness"),
        new("c4","New Business Referral Series"),
    ];

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Leads", "/crm/leads"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            var leadsTask = Api.SearchLeadsAsync(_tenantId);
            var usersTask = Api.SearchUsersAsync(_tenantId);
            await Task.WhenAll(leadsTask, usersTask);

            var users = usersTask.Result?.Items?.ToList() ?? [];
            var ownerLookup = users.ToDictionary(u => u.UserId, u => string.IsNullOrWhiteSpace(u.DisplayName) ? u.FullName : u.DisplayName);

            _ownerOptions = users
                .Where(u => u.StatusCode.Equals("Active", StringComparison.OrdinalIgnoreCase))
                .Select(u => new LabelValue(u.UserId.ToString(), string.IsNullOrWhiteSpace(u.DisplayName) ? u.FullName : u.DisplayName))
                .Where(o => !string.IsNullOrWhiteSpace(o.Label))
                .OrderBy(o => o.Label)
                .ToList();

            var response = leadsTask.Result;
            _leads = response?.Items?.Select(l => MapToLeadRow(l, ownerLookup)).ToList() ?? [];
            RebuildDerived();
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Error loading leads: {ex.Message}", "e-toast-danger");
            _leads = [];
        }
        finally { _loading = false; }
    }

    private LeadRow MapToLeadRow(LeadDto dto, IReadOnlyDictionary<Guid, string> ownerLookup)
    {
        var score = Math.Clamp(dto.Score ?? 0, 0, 100);
        return new LeadRow
        {
            LeadId = dto.LeadId,
            AssignedToUserId = dto.AssignedToUserId,
            FirstName = dto.FirstName,
            LastName = dto.LastName,
            FullName = $"{dto.FirstName} {dto.LastName}".Trim(),
            CompanyName = dto.AccountName ?? string.Empty,
            Email = dto.Email ?? string.Empty,
            Phone = dto.Phone ?? string.Empty,
            Stage = NormalizeStage(dto.NurturingStageCode, dto.StatusCode),
            Source = string.IsNullOrWhiteSpace(dto.SourceCode) ? "Direct" : dto.SourceCode,
            Owner = dto.AssignedToUserId.HasValue && ownerLookup.TryGetValue(dto.AssignedToUserId.Value, out var owner) ? owner : "Unassigned",
            Rating = ScoreToRating(score),
            Score = score,
            EstPremium = 0,
            CreatedAt = dto.CreatedDateUtc,
            LastActivity = null,
            Notes = dto.InterestedService
        };
    }

    private static string NormalizeStage(string? stage, int statusCode)
    {
        if (!string.IsNullOrWhiteSpace(stage))
        {
            return stage.Trim() switch
            {
                "Closed" => "Lost",
                "Won" => "Converted",
                var s => s
            };
        }

        return statusCode switch
        {
            2 => "Contacted",
            3 => "Qualified",
            4 => "Converted",
            5 => "Lost",
            _ => "New",
        };
    }

    private static string ScoreToRating(int score) => score switch
    {
        >= 80 => "Hot",
        >= 50 => "Warm",
        _ => "Cold",
    };

    private void RebuildDerived()
    {
        ApplyFilters();

        _sourceFunnel = _leads
            .GroupBy(x => x.Source)
            .Select(g => new SourceRow
            {
                Source        = g.Key,
                Total         = g.Count(),
                Converted     = g.Count(x => x.Stage == "Converted"),
                AvgScore      = g.Any() ? (int)g.Average(x => x.Score) : 0,
                AvgPremium    = g.Any() ? g.Average(x => x.EstPremium) : 0,
                TotalPipeline = g.Sum(x => x.EstPremium),
            })
            .OrderByDescending(x => x.Total)
            .ToList();

        _producerRows = _leads
            .GroupBy(x => x.Owner)
            .Select(g => new ProducerRow
            {
                Owner    = g.Key,
                Total    = g.Count(),
                Converted= g.Count(x => x.Stage == "Converted"),
                Pipeline = g.Sum(x => x.EstPremium),
            })
            .OrderByDescending(x => x.Pipeline)
            .ToList();

        _kpi = new LeadKpi
        {
            TotalLeads     = _leads.Count,
            Hot            = _leads.Count(x => x.Rating == "Hot"),
            Converted      = _leads.Count(x => x.Stage == "Converted"),
            ConversionRate = _leads.Count == 0 ? 0 : (double)_leads.Count(x => x.Stage == "Converted") / _leads.Count * 100,
            Stale          = _leads.Count(x => x.DaysSinceActivity > 30),
            EstPipeline    = _leads.Where(x => x.Stage != "Converted" && x.Stage != "Lost").Sum(x => x.EstPremium),
        };
    }

    private void ApplyFilters()
    {
        _filtered = _leads.Where(r =>
            (string.IsNullOrEmpty(_filterStage)  || r.Stage  == _filterStage) &&
            (string.IsNullOrEmpty(_filterSource) || r.Source == _filterSource) &&
            (string.IsNullOrEmpty(_filterOwner)  || r.AssignedToUserId?.ToString() == _filterOwner) &&
            (string.IsNullOrEmpty(_filterRating) || r.Rating == _filterRating) &&
            (string.IsNullOrEmpty(_search) ||
             r.FullName.Contains(_search,    StringComparison.OrdinalIgnoreCase) ||
             r.CompanyName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             r.Email.Contains(_search,       StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    private List<LeadRow> ProducerFiltered() =>
        string.IsNullOrEmpty(_producerFilter)
            ? _filtered
            : _filtered.Where(x => x.Owner == _producerFilter).ToList();

