@page "/crm/leads"
@namespace Ams.Web.Components.Pages.Crm
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Ams.Application.Common.Dtos
@using Ams.Application.Common.Validation
@using Ams.Application.Features.Leads
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using BlazorChangeEventArgs = Microsoft.AspNetCore.Components.ChangeEventArgs
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@inject LeadScoringRealtimeClient LeadScoringRealtime
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Enterprise Leads</PageTitle>

@if (_toastVisible)
{
    <div class="ld-toast ld-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="ld-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showConfirm && _confirmAction is not null)
{
    <div id="lead-confirm-modal-root" class="ld-modal-backdrop" role="presentation" @onclick="CancelConfirm">
        <div class="ld-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="leadConfirmTitle" @onclick:stopPropagation="true">
            <div class="ld-confirm-icon ld-confirm-@_confirmAction.Kind"><i class="bi @_confirmAction.Icon" aria-hidden="true"></i></div>
            <h2 id="leadConfirmTitle">@_confirmAction.Title</h2>
            <p>@_confirmAction.Message</p>
            <div class="ld-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CancelConfirm" disabled="@_busy">Cancel</button>
                <button type="button" class="um-btn @_confirmAction.ButtonClass" @onclick="ExecuteConfirmedAsync" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    @_confirmAction.ButtonText
                </button>
            </div>
        </div>
    </div>
}

@if (_showLeadModal)
{
    <div id="lead-form-modal-root" class="ld-modal-backdrop" role="presentation" @onclick="CloseLeadModal">
        <div class="ld-lead-modal" role="dialog" aria-modal="true" aria-labelledby="leadFormTitle" @onclick:stopPropagation="true">
            <div class="ld-modal-header">
                <div class="ld-modal-title">
                    <span class="ld-modal-icon"><i class="bi bi-person-plus" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="leadFormTitle">@(_editingId == Guid.Empty ? "Create enterprise lead" : "Edit enterprise lead")</h2>
                        <p>Capture prospect details, scoring, ownership, source, and nurture workflow metadata.</p>
                    </div>
                </div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseLeadModal" disabled="@_savingLead" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_leadForm" OnValidSubmit="SaveLeadAsync" OnInvalidSubmit="HandleInvalidLeadSubmitAsync">
                <DataAnnotationsValidator />
                <div class="ld-modal-body">
                    <div class="ld-form-banner">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <div>
                            <strong>Enterprise validations enabled</strong>
                            <span>Required identity, source, owner, email, phone, score, and premium checks are enforced before save.</span>
                        </div>
                    </div>
                    <div class="ld-form-grid">
                        <div class="ld-field">
                            <label>First name <span>*</span></label>
                            <InputText class="ld-input" @bind-Value="_leadForm.FirstName" placeholder="First name" />
                        </div>
                        <div class="ld-field">
                            <label>Last name <span>*</span></label>
                            <InputText class="ld-input" @bind-Value="_leadForm.LastName" placeholder="Last name" />
                        </div>
                        <div class="ld-field ld-field-wide">
                            <label>Company <span>*</span></label>
                            <InputText class="ld-input" @bind-Value="_leadForm.Company" placeholder="Company or account name" />
                        </div>
                        <div class="ld-field">
                            <label>Email <span>*</span></label>
                            <InputText class="ld-input" type="email" @bind-Value="_leadForm.Email" placeholder="name@company.com" />
                        </div>
                        <div class="ld-field">
                            <label>Phone</label>
                            <InputText class="ld-input" type="tel" @bind-Value="_leadForm.Phone" @bind-Value:after="OnPhoneChanged" placeholder="(555) 123-4567" />
                            @if (!string.IsNullOrWhiteSpace(_leadForm.Phone))
                            {
                                <span class="@PhoneHintClass">@PhoneStatusText</span>
                            }
                        </div>
                        <div class="ld-field">
                            <label>Source <span>*</span></label>
                            <InputSelect class="ld-input" @bind-Value="_leadForm.Source">
                                <option value="">Select source</option>
                                @foreach (var source in _sourceOptions)
                                {
                                    <option value="@source.Value">@source.Label</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="ld-field">
                            <label>Stage</label>
                            <InputSelect class="ld-input" @bind-Value="_leadForm.Stage">
                                @foreach (var stage in _stageOptions)
                                {
                                    <option value="@stage.Value">@stage.Label</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="ld-field">
                            <label>Priority</label>
                            <InputSelect class="ld-input" @bind-Value="_leadForm.Priority">
                                @foreach (var rating in _ratingOptions)
                                {
                                    <option value="@rating.Value">@rating.Label</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="ld-field">
                            <label>Owner <span>*</span></label>
                            <InputSelect class="ld-input" @bind-Value="_leadForm.Owner">
                                <option value="">Assign owner</option>
                                @foreach (var owner in _ownerOptions)
                                {
                                    <option value="@owner.Value">@owner.Label</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="ld-field">
                            <label>Estimated premium</label>
                            <InputNumber class="ld-input" @bind-Value="_leadForm.EstPremium" />
                        </div>
                        <div class="ld-field">
                            <label>Lead score</label>
                            <InputNumber class="ld-input" @bind-Value="_leadForm.Score" />
                        </div>
                        <div class="ld-field ld-field-wide">
                            <label>Notes / interested service</label>
                            <InputTextArea class="ld-input" rows="4" @bind-Value="_leadForm.Notes" placeholder="Coverage interests, timing, decision process, or next best action" />
                        </div>
                    </div>
                </div>
                <div class="ld-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseLeadModal" disabled="@_savingLead">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_savingLead">
                        @if (_savingLead)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(_editingId == Guid.Empty ? "Create lead" : "Save changes")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showImport)
{
    <div id="lead-import-modal-root" class="ld-modal-backdrop" role="presentation" @onclick="CloseImport">
        <div class="ld-action-modal" role="dialog" aria-modal="true" aria-labelledby="importLeadsTitle" @onclick:stopPropagation="true">
            <div class="ld-modal-header">
                <div class="ld-modal-title">
                    <span class="ld-modal-icon"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="importLeadsTitle">Import leads</h2>
                        <p>Upload CSV records for validation and staged import.</p>
                    </div>
                </div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseImport" aria-label="Close import dialog"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="ld-modal-body">
                <div class="ld-form-banner">
                    <i class="bi bi-filetype-csv" aria-hidden="true"></i>
                    <div>
                        <strong>CSV format</strong>
                        <span>Required columns: FirstName, LastName, Company, Email, Source. Optional: Phone, Owner, Premium, Notes.</span>
                    </div>
                </div>
                <InputFile OnChange="OnFileSelectedAsync" accept=".csv" />
                @if (_importErrors.Count > 0)
                {
                    <div class="ld-import-errors">
                        <strong>@_importErrors.Count validation issue(s)</strong>
                        <ul>
                            @foreach (var error in _importErrors.Take(6))
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }
                @if (_importPreview.Count > 0)
                {
                    <div class="ld-import-preview">
                        <strong>Preview</strong>
                        <div class="ld-mini-table">
                            @foreach (var row in _importPreview.Take(6))
                            {
                                <div><span>@row.FullName</span><span>@row.CompanyName</span><span>@row.Email</span><span>@row.Source</span></div>
                            }
                        </div>
                    </div>
                }
                <div class="ld-check-row">
                    <label><InputCheckbox @bind-Value="_importDedupe" /> Skip duplicate emails</label>
                    <label><InputCheckbox @bind-Value="_importAssignRoundRobin" /> Auto assign unowned records</label>
                </div>
            </div>
            <div class="ld-modal-footer">
                <button class="um-btn um-btn-ghost" @onclick="CloseImport">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="ConfirmImport" disabled="@ImportDisabled">Import @_importPreview.Count</button>
            </div>
        </div>
    </div>
}

@if (_showAssign)
{
    <div id="lead-assign-modal-root" class="ld-modal-backdrop" role="presentation" @onclick="CloseAssign">
        <div class="ld-action-modal" role="dialog" aria-modal="true" aria-labelledby="assignOwnerTitle" @onclick:stopPropagation="true">
            <div class="ld-modal-header">
                <div class="ld-modal-title">
                    <span class="ld-modal-icon"><i class="bi bi-person-check" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="assignOwnerTitle">Assign owner</h2>
                        <p>Route selected leads to an active producer.</p>
                    </div>
                </div>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseAssign" aria-label="Close assign dialog"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="ld-modal-body">
                <div class="ld-form-banner"><i class="bi bi-people" aria-hidden="true"></i><div><strong>@_selected.Count selected lead(s)</strong><span>Assignment updates existing CRM lead owner fields.</span></div></div>
                <select class="ld-input" @bind="_assignTarget">
                    <option value="">Select owner</option>
                    @foreach (var owner in _ownerOptions)
                    {
                        <option value="@owner.Value">@owner.Label</option>
                    }
                </select>
                <div class="ld-check-row"><label><InputCheckbox @bind-Value="_assignNotify" /> Add notification flag to workflow</label></div>
            </div>
            <div class="ld-modal-footer"><button class="um-btn um-btn-ghost" @onclick="CloseAssign">Cancel</button><button class="um-btn um-btn-primary" @onclick="ConfirmAssign" disabled="@AssignDisabled">Assign leads</button></div>
        </div>
    </div>
}

@if (_showMerge)
{
    <div id="lead-merge-modal-root" class="ld-modal-backdrop" role="presentation" @onclick="CloseMerge">
        <div class="ld-action-modal" role="dialog" aria-modal="true" aria-labelledby="mergeLeadsTitle" @onclick:stopPropagation="true">
            <div class="ld-modal-header">
                <div class="ld-modal-title">
                    <span class="ld-modal-icon"><i class="bi bi-intersect" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="mergeLeadsTitle">Merge duplicate leads</h2>
                        <p>Select a master record; duplicates are safely marked lost with merge notes.</p>
                    </div>
                </div>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseMerge" aria-label="Close merge dialog"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="ld-modal-body">
                @if (_selected.Count < 2)
                {
                    <div class="ld-empty-state"><i class="bi bi-info-circle" aria-hidden="true"></i><strong>Select at least two leads</strong><span>Use table checkboxes to select records before merging.</span></div>
                }
                else
                {
                    <div class="ld-merge-list">
                        @foreach (var lead in _selected)
                        {
                            <button type="button" class="@MergeOptionClass(lead)" @onclick="@(() => SelectMergeTarget(lead))">
                                <i class="@MergeOptionIconClass(lead)" aria-hidden="true"></i>
                                <span><strong>@lead.FullName</strong><small>@lead.CompanyName · @lead.Email · @lead.Stage · @lead.Owner</small></span>
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="ld-modal-footer"><button class="um-btn um-btn-ghost" @onclick="CloseMerge">Cancel</button><button class="um-btn um-btn-danger" @onclick="ConfirmMerge" disabled="@MergeDisabled">Merge duplicates</button></div>
        </div>
    </div>
}

@if (_showConvert)
{
    <div id="lead-convert-modal-root" class="ld-modal-backdrop" role="presentation" @onclick="CloseConvert">
        <div class="ld-action-modal" role="dialog" aria-modal="true" aria-labelledby="convertTitle" @onclick:stopPropagation="true">
            <div class="ld-modal-header"><div class="ld-modal-title"><span class="ld-modal-icon"><i class="bi bi-trophy" aria-hidden="true"></i></span><div><h2 id="convertTitle">Convert to pipeline</h2><p>Move selected leads into converted workflow state and record activity.</p></div></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseConvert"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="ld-modal-body"><div class="ld-form-banner"><i class="bi bi-diagram-3" aria-hidden="true"></i><div><strong>@_selected.Count lead(s) ready for conversion</strong><span>Stage becomes Converted, status is updated, score is lifted if needed.</span></div></div><ul class="ld-action-list">@foreach (var lead in _selected.Take(5)) { <li>@lead.FullName — @lead.CompanyName (@lead.EstPremium.ToString("C0"))</li> }</ul><div class="ld-check-row"><label><InputCheckbox @bind-Value="_convertKeepLead" /> Keep lead visible after conversion</label><label><InputCheckbox @bind-Value="_convertCreateActivity" /> Create follow-up workflow activity</label></div></div>
            <div class="ld-modal-footer"><button class="um-btn um-btn-ghost" @onclick="CloseConvert">Cancel</button><button class="um-btn um-btn-primary" @onclick="ConfirmCommitConvert">Convert leads</button></div>
        </div>
    </div>
}

@if (_showCampaign)
{
    <div id="lead-campaign-modal-root" class="ld-modal-backdrop" role="presentation" @onclick="CloseCampaign">
        <div class="ld-action-modal" role="dialog" aria-modal="true" aria-labelledby="campaignTitle" @onclick:stopPropagation="true">
            <div class="ld-modal-header"><div class="ld-modal-title"><span class="ld-modal-icon"><i class="bi bi-megaphone" aria-hidden="true"></i></span><div><h2 id="campaignTitle">Enroll campaign</h2><p>Create campaign enrollment records for selected leads.</p></div></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseCampaign"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="ld-modal-body"><select class="ld-input" @bind="_campaignTarget"><option value="">Select campaign</option>@foreach (var campaign in _campaignOptions) { <option value="@campaign.Value">@campaign.Label</option> }</select><div class="ld-check-row"><label><InputCheckbox @bind-Value="_campaignSendImmediately" /> Send first email immediately</label></div></div>
            <div class="ld-modal-footer"><button class="um-btn um-btn-ghost" @onclick="CloseCampaign">Cancel</button><button class="um-btn um-btn-primary" @onclick="ConfirmCampaign" disabled="@CampaignDisabled">Enroll leads</button></div>
        </div>
    </div>
}

<div class="ld-enterprise-page">
    <section class="ld-hero">
        <div class="ld-hero-left">
            <span class="ld-hero-icon"><i class="bi bi-person-lines-fill" aria-hidden="true"></i></span>
            <div><div class="ld-title-row"><h1>Enterprise Leads</h1><span><i class="bi bi-database-check"></i> Live CRM data</span><span><i class="bi bi-shield-lock"></i> Tenant scoped</span></div><p>Track, score, nurture, assign, and convert prospects through a governed sales workflow.</p></div>
        </div>
        <div class="ld-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh leads list"><i class="bi @(_loading ? "bi-arrow-repeat ld-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-ghost" @onclick="OpenImport" title="Import leads from CSV"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Import</button>
            <button class="um-btn um-btn-primary" @onclick="OnNewLeadClick" title="Create a new lead"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Lead</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="ld-error-banner"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="ld-kpi-strip" aria-label="Lead performance metrics">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" @onclick="@(() => SetQuickFilter(metric.Filter))">
                <span class="ld-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span><span class="ld-kpi-val">@metric.Value</span><span class="ld-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
            </button>
        }
    </section>

    <section class="ld-workflow-strip" aria-label="Lead workflow">
        <button class="ld-workflow-card" @onclick="ShowBoardView"><i class="bi bi-kanban" aria-hidden="true"></i><span><strong>Nurture board</strong><span>Move prospects by stage.</span></span></button>
        <button class="ld-workflow-card" @onclick="ShowHotLeads"><i class="bi bi-fire" aria-hidden="true"></i><span><strong>Prioritize hot</strong><span>Focus high intent leads.</span></span></button>
        <button class="ld-workflow-card" @onclick="ShowFunnelView"><i class="bi bi-funnel" aria-hidden="true"></i><span><strong>Source funnel</strong><span>Measure channel quality.</span></span></button>
        <button class="ld-workflow-card" @onclick="ShowProducerView"><i class="bi bi-person-badge" aria-hidden="true"></i><span><strong>Producer view</strong><span>Balance owner workload.</span></span></button>
    </section>

    <section class="ld-search-panel">
        <div class="ld-search-wrap">
            <span class="ld-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="ld-search-body"><label for="leadSearchInput">Search CRM leads</label><input id="leadSearchInput" class="ld-search-input" value="@_search" @oninput="OnSearchChanged" placeholder="Search name, company, email, phone, source, owner, or stage..." /><span class="ld-search-hint">Enterprise search filters the current in-memory CRM dataset instantly.</span></div>
        </div>
        <select class="ld-filter-select" value="@_filterStage" @onchange="OnStageFilterChanged"><option value="">All stages</option>@foreach (var option in _stageOptions) { <option value="@option.Value">@option.Label</option> }</select>
        <select class="ld-filter-select" value="@_filterSource" @onchange="OnSourceFilterChanged"><option value="">All sources</option>@foreach (var option in _sourceOptions) { <option value="@option.Value">@option.Label</option> }</select>
        <select class="ld-filter-select" value="@_filterOwner" @onchange="OnOwnerFilterChanged"><option value="">All owners</option>@foreach (var option in _ownerOptions) { <option value="@option.Value">@option.Label</option> }</select>
        <select class="ld-filter-select" value="@_filterRating" @onchange="OnRatingFilterChanged"><option value="">All ratings</option>@foreach (var option in _ratingOptions) { <option value="@option.Value">@option.Label</option> }</select>
        <div class="ld-search-result"><strong>@_filtered.Count</strong><span>matches</span></div>
    </section>

    @if (_selected.Count > 0)
    {
        <section class="ld-bulk-bar"><span>@_selected.Count selected</span><button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenAssign"><i class="bi bi-person-check"></i> Assign</button><button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenMerge"><i class="bi bi-intersect"></i> Merge</button><button class="um-btn um-btn-ghost um-btn-sm" @onclick="ConfirmConvertToOpportunity"><i class="bi bi-trophy"></i> Convert</button><button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenCampaign"><i class="bi bi-megaphone"></i> Campaign</button><button class="um-btn um-btn-ghost um-btn-sm ld-deselect-btn" @onclick="ClearSelection"><i class="bi bi-x-lg" aria-hidden="true"></i></button></section>
    }

    <section class="ld-view-tabs" aria-label="Lead views">
        @foreach (var view in _views)
        {
            <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label</button>
        }
    </section>

    <section class="ld-content-layout">
        <main class="ld-main-card">
            @if (_loading)
            {
                <div class="ld-loading"><i class="bi bi-arrow-repeat ld-spin" aria-hidden="true"></i><strong>Loading enterprise lead workspace...</strong></div>
            }
            else if (_filtered.Count == 0)
            {
                <div class="ld-empty-state"><i class="bi bi-person-plus" aria-hidden="true"></i><strong>No leads match this view</strong><span>Adjust filters or create a new lead.</span><button class="um-btn um-btn-primary" @onclick="OnNewLeadClick">Create lead</button></div>
            }
            else if (_view == "table")
            {
                <div class="ld-table-scroll"><table class="ld-table"><thead><tr><th><input type="checkbox" checked="@AllPageSelected" @onchange="ToggleCurrentPageSelection" aria-label="Select all leads on this page" /></th><th>Lead</th><th>Stage</th><th>Source</th><th>Owner</th><th class="ld-number">Score</th><th class="ld-number">Premium</th><th>Created</th><th></th></tr></thead><tbody>@foreach (var lead in _paged) { <tr class="@LeadRowClass(lead)" @onclick="@(() => OpenDetail(lead))"><td @onclick:stopPropagation="true"><input type="checkbox" checked="@IsSelected(lead)" @onchange="@(() => ToggleSelection(lead))" aria-label="Select lead" /></td><td><div class="ld-name-cell"><span class="ld-avatar @AvatarColor(lead.FullName)" aria-hidden="true">@Initials(lead.FullName)</span><span><strong>@lead.FullName</strong><small>@lead.CompanyName · @lead.Email</small></span></div></td><td><span class="@StageBadge(lead.Stage)">@lead.Stage</span></td><td><span class="ld-source-badge"><i class="bi @SourceIcon(lead.Source)" aria-hidden="true"></i> @lead.Source</span></td><td>@lead.Owner</td><td class="ld-number"><span class="ld-score-pill @ScoreTone(lead.Score)">@lead.Score</span></td><td class="ld-number">@lead.EstPremium.ToString("C0", CultureInfo.CurrentCulture)</td><td>@lead.CreatedAt.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture)</td><td @onclick:stopPropagation="true"><div class="ld-row-actions"><button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenEdit(lead))" title="Edit lead"><i class="bi bi-pencil" aria-hidden="true"></i></button><button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenLeadCampaign(lead))" title="Enroll campaign"><i class="bi bi-megaphone" aria-hidden="true"></i></button><button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ConfirmDisqualify(lead))" title="Disqualify lead"><i class="bi bi-x-octagon" aria-hidden="true"></i></button></div></td></tr> }</tbody></table></div><div class="ld-pager"><span>@PageSummary</span><div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_pageIndex <= 1)" title="Previous page"><i class="bi bi-chevron-left" aria-hidden="true"></i></button><span>Page @_pageIndex of @TotalPages</span><button class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_pageIndex >= TotalPages)" title="Next page"><i class="bi bi-chevron-right" aria-hidden="true"></i></button></div></div>
            }
            else if (_view == "board")
            {
                <div class="ld-board">@foreach (var stage in _boardStages) { var stageLeads = _filtered.Where(l => l.Stage == stage).ToList(); <section class="ld-board-col"><header><strong>@stage</strong><span>@stageLeads.Count</span></header>@foreach (var lead in stageLeads) { <article class="ld-board-card" @onclick="@(() => OpenDetail(lead))"><div><strong>@lead.FullName</strong><span>@lead.CompanyName</span></div><div><span class="@RatingBadge(lead.Rating)">@lead.Rating</span><span>@lead.EstPremium.ToString("C0")</span></div><small>@lead.Owner · score @lead.Score</small></article> }</section> }</div>
            }
            else if (_view == "funnel")
            {
                <div class="ld-analytics-grid"><section><h3>Source performance</h3>@foreach (var source in _sourceFunnel) { <button class="@FunnelRowClass(source)" @onclick="@(() => SelectFunnelSource(source.Source))"><span><i class="bi @SourceIcon(source.Source)" aria-hidden="true"></i> @source.Source</span><div><i style="width:@source.WidthPercent%"></i></div><strong>@source.Total</strong><small>@source.ConvPct.ToString("F0")% conv.</small></button> }</section><section><h3>Stage mix</h3>@foreach (var stage in StageBreakdown) { <div class="ld-stage-row"><span>@stage.Stage</span><div><i style="width:@stage.WidthPercent%"></i></div><strong>@stage.Count</strong></div> }</section></div>
            }
            else
            {
                <div class="ld-producer-grid">@foreach (var producer in _producerRows) { <article class="@ProducerCardClass(producer)" @onclick="@(() => SelectProducer(producer.Owner))"><div><strong>@producer.Owner</strong><span>@producer.Total leads · @producer.ConvPct.ToString("F0")% conversion</span></div><strong>@producer.Pipeline.ToString("C0")</strong><div class="ld-producer-meter"><i style="width:@producer.WidthPercent%"></i></div></article> }</div>
            }
        </main>

        <aside class="ld-detail-card">
            @if (_detail is null)
            {
                <div class="ld-detail-empty"><i class="bi bi-person-vcard" aria-hidden="true"></i><strong>Select a lead</strong><span>Review lead intelligence, contact details, and workflow actions.</span></div>
            }
            else
            {
                <div class="ld-detail-head"><div><span class="ld-detail-eyebrow"><i class="bi @SourceIcon(_detail.Source)" aria-hidden="true"></i> @_detail.Source</span><h2>@_detail.FullName</h2><p>@_detail.CompanyName</p></div><span class="@StageBadge(_detail.Stage)">@_detail.Stage</span></div><div class="ld-detail-body"><div class="ld-detail-summary"><div><span>Score</span><strong>@_detail.Score</strong></div><div><span>Rating</span><strong>@_detail.Rating</strong></div><div><span>Pipeline</span><strong>@_detail.EstPremium.ToString("C0")</strong></div><div><span>Owner</span><strong>@_detail.Owner</strong></div></div><div class="ld-contact-card"><span><i class="bi bi-envelope" aria-hidden="true"></i> @_detail.Email</span><span><i class="bi bi-telephone" aria-hidden="true"></i> @_detail.Phone</span><span><i class="bi bi-card-text" aria-hidden="true"></i> @(_detail.Notes ?? "No notes captured")</span></div><div class="ld-detail-actions"><div class="ld-detail-actions-row"><button class="um-btn um-btn-ghost" @onclick="@(() => OpenEdit(_detail))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button class="um-btn um-btn-ghost" @onclick="@(() => OpenLeadAssign(_detail))"><i class="bi bi-person-check" aria-hidden="true"></i> Assign</button><button class="um-btn um-btn-danger" @onclick="@(() => ConfirmDisqualify(_detail))"><i class="bi bi-x-octagon" aria-hidden="true"></i> Disqualify</button></div><button class="um-btn um-btn-primary ld-detail-convert-btn" @onclick="@(() => OpenLeadConvert(_detail))"><i class="bi bi-trophy" aria-hidden="true"></i> Convert</button></div></div>
            }
        </aside>
    </section>
</div>

@code {
    private Guid _tenantId;
    private Guid TenantAdminUserId { get; set; }
    private bool _loading;
    private bool _hasLoaded;
    private bool _busy;
    private bool _savingLead;
    private bool _showLeadModal;
    private bool _showImport;
    private bool _showAssign;
    private bool _showMerge;
    private bool _showConvert;
    private bool _showCampaign;
    private bool _showConfirm;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "info";
    private string _loadError = string.Empty;
    private CancellationTokenSource? _toastCts;
    private ConfirmAction? _confirmAction;
    private Guid _editingId = Guid.Empty;
    private string _view = "table";
    private string _search = string.Empty;
    private string _filterStage = string.Empty;
    private string _filterSource = string.Empty;
    private string _filterOwner = string.Empty;
    private string _filterRating = string.Empty;
    private string _quickFilter = string.Empty;
    private string _funnelSource = string.Empty;
    private string _producerFilter = string.Empty;
    private string _assignTarget = string.Empty;
    private string _mergeTarget = string.Empty;
    private string _campaignTarget = string.Empty;
    private bool _assignNotify = true;
    private bool _convertKeepLead;
    private bool _convertCreateActivity = true;
    private bool _campaignSendImmediately;
    private bool _importDedupe = true;
    private bool _importAssignRoundRobin;
    private int _pageIndex = 1;
    private const int PageSize = 12;
    private LeadRow? _detail;
    private LeadFormModel _leadForm = new();
    private List<LeadRow> _leads = [];
    private List<LeadRow> _filtered = [];
    private List<LeadRow> _paged = [];
    private List<LeadRow> _selected = [];
    private List<LeadImportRow> _importPreview = [];
    private List<string> _importErrors = [];
    private List<LabelValue> _ownerOptions = [];
    private List<SourceRow> _sourceFunnel = [];
    private List<ProducerRow> _producerRows = [];
    private LeadKpi _kpi = new();

    private static readonly List<ViewDef> _views = [new("table", "Table", "bi-table"), new("board", "Board", "bi-kanban"), new("funnel", "Funnel", "bi-funnel"), new("producer", "Producer", "bi-person-badge")];
    private static readonly string[] _boardStages = ["New", "Contacted", "Qualified", "Proposal", "Negotiation", "Converted", "Lost"];
    private static readonly List<LabelValue> _stageOptions = [new("New", "New"), new("Contacted", "Contacted"), new("Qualified", "Qualified"), new("Proposal", "Proposal"), new("Negotiation", "Negotiation"), new("Converted", "Converted"), new("Lost", "Lost")];
    private static readonly List<LabelValue> _sourceOptions = [new("Referral", "Referral"), new("Website", "Website"), new("Cold Call", "Cold Call"), new("Social", "Social"), new("Email", "Email"), new("Event", "Event"), new("Partner", "Partner"), new("Inbound", "Inbound")];
    private static readonly List<LabelValue> _ratingOptions = [new("Hot", "Hot"), new("Warm", "Warm"), new("Cold", "Cold")];
    private static readonly List<LabelValue> _campaignOptions = [new("c1", "Q3 Commercial BOP Drip"), new("c2", "Renewal Win-Back 2025"), new("c3", "Mid-Market Cyber Awareness"), new("c4", "New Business Referral Series")];
    private static readonly string[] _modalRootIds = ["lead-confirm-modal-root", "lead-form-modal-root", "lead-import-modal-root", "lead-assign-modal-root", "lead-merge-modal-root", "lead-convert-modal-root", "lead-campaign-modal-root"];

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
    private bool AllPageSelected => _paged.Count > 0 && _paged.All(IsSelected);
    private string PageSummary => _filtered.Count == 0 ? "No leads" : $"Showing {((_pageIndex - 1) * PageSize) + 1}-{Math.Min(_pageIndex * PageSize, _filtered.Count)} of {_filtered.Count}";
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-octagon", "warning" => "bi-exclamation-triangle", "success" => "bi-check2-circle", _ => "bi-info-circle" };
    private string PhoneStatusText => IsPhoneValid(_leadForm.Phone) ? $"Phone formatted as {NormalizePhone(_leadForm.Phone)}" : "Enter a valid 10-digit phone number.";
    private string PhoneHintClass => IsPhoneValid(_leadForm.Phone) ? "ld-field-hint ld-hint-good" : "ld-field-hint ld-hint-bad";
    private bool ImportDisabled => _importPreview.Count == 0 || _importErrors.Count > 0;
    private bool AssignDisabled => string.IsNullOrWhiteSpace(_assignTarget);
    private bool MergeDisabled => string.IsNullOrWhiteSpace(_mergeTarget) || _selected.Count < 2;
    private bool CampaignDisabled => string.IsNullOrWhiteSpace(_campaignTarget);

    private IEnumerable<KpiModel> Metrics =>
    [
        new("Total", _leads.Count.ToString(), "All CRM leads", "bi-person-plus-fill", "ld-blue", ""),
        new("Hot", _leads.Count(x => x.Rating == "Hot").ToString(), "High priority", "bi-fire", "ld-red", "hot"),
        new("Converted", _leads.Count(x => x.Stage == "Converted").ToString(), "Won pipeline", "bi-trophy", "ld-green", "converted"),
        new("Conversion", _kpi.ConversionRate.ToString("F1") + "%", "Lead-to-pipeline", "bi-graph-up-arrow", "ld-purple", "converted"),
        new("Stale", _leads.Count(x => x.DaysSinceActivity > 30 && x.Stage != "Converted" && x.Stage != "Lost").ToString(), "Needs activity", "bi-calendar-x", "ld-amber", "stale"),
        new("Pipeline", _leads.Where(x => x.Stage != "Converted" && x.Stage != "Lost").Sum(x => x.EstPremium).ToString("C0"), "Open premium", "bi-cash-coin", "ld-cyan", "pipeline")
    ];

    private IEnumerable<StageBreakdownRow> StageBreakdown
    {
        get
        {
            var rows = _filtered.GroupBy(x => x.Stage).Select(g => new StageBreakdownRow(g.Key, g.Count(), 0)).ToList();
            var max = rows.Count == 0 ? 1 : rows.Max(x => x.Count);
            return rows.OrderBy(x => StageOrder(x.Stage)).Select(x => x with { WidthPercent = max == 0 ? 0 : (double)x.Count / max * 100 });
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Leads", "/crm/leads"));
        await LoadAsync();
        _ = StartLeadScoringRealtimeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await PortalOpenModalsAsync();

        if (!firstRender || _hasLoaded) return;
        await ResolveCurrentUserContextAsync();
        await LoadAsync();
        StateHasChanged();
    }

    private async Task PortalOpenModalsAsync()
    {
        try
        {
            foreach (var id in _modalRootIds)
            {
                await JS.InvokeVoidAsync("amsShell.portalModal", id);
            }
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private async Task ReleaseModalAsync(string id)
    {
        try { await JS.InvokeVoidAsync("amsShell.releaseModal", id); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        var path = Nav.ToBaseRelativePath(args.Location).Split('?', '#')[0].Trim('/');
        if (string.Equals(path, "crm/leads", StringComparison.OrdinalIgnoreCase)) _ = InvokeAsync(LoadAsync);
    }

    private async Task StartLeadScoringRealtimeAsync()
    {
        try { if (_tenantId != Guid.Empty) await LeadScoringRealtime.StartAsync(_tenantId, _ => InvokeAsync(LoadAsync)); }
        catch (Exception ex) { await ShowToastAsync($"Realtime unavailable: {ex.Message}", "warning"); }
    }

    public async ValueTask DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        await LeadScoringRealtime.DisposeAsync();
        foreach (var id in _modalRootIds)
        {
            await ReleaseModalAsync(id);
        }
        _toastCts?.Cancel();
        _toastCts?.Dispose();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = string.Empty;
        try
        {
            if (_tenantId == Guid.Empty) await ResolveCurrentUserContextAsync();
            if (_tenantId == Guid.Empty) return;

            var leadsTask = Api.SearchLeadsAsync(_tenantId);
            var usersTask = Api.SearchUsersAsync(_tenantId);
            await Task.WhenAll(leadsTask, usersTask);

            var users = usersTask.Result?.Items?.ToList() ?? [];
            var ownerLookup = users.ToDictionary(u => u.UserId, u => string.IsNullOrWhiteSpace(u.DisplayName) ? u.FullName : u.DisplayName);
            _ownerOptions = users.Where(u => string.Equals(u.StatusCode, "Active", StringComparison.OrdinalIgnoreCase)).Select(u => new LabelValue(u.UserId.ToString(), string.IsNullOrWhiteSpace(u.DisplayName) ? u.FullName : u.DisplayName)).Where(x => !string.IsNullOrWhiteSpace(x.Label)).OrderBy(x => x.Label).ToList();
            _leads = leadsTask.Result?.Items?.Select(l => MapToLeadRow(l, ownerLookup)).ToList() ?? [];
            RebuildDerived();
            _detail = _detail is null ? _filtered.FirstOrDefault() : _leads.FirstOrDefault(x => x.LeadId == _detail.LeadId) ?? _filtered.FirstOrDefault();
            _hasLoaded = true;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _leads = [];
            RebuildDerived();
            await ShowToastAsync("Unable to load leads.", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private LeadRow MapToLeadRow(LeadDto dto, IReadOnlyDictionary<Guid, string> ownerLookup)
    {
        var score = Math.Clamp(dto.Score ?? 0, 0, 100);
        return new LeadRow
        {
            LeadId = dto.LeadId,
            AssignedToUserId = dto.AssignedToUserId,
            FirstName = dto.FirstName,
            LastName = dto.LastName,
            FullName = $"{dto.FirstName} {dto.LastName}".Trim(),
            CompanyName = dto.AccountName ?? string.Empty,
            Email = dto.Email ?? string.Empty,
            Phone = dto.Phone ?? string.Empty,
            Stage = NormalizeStage(dto.NurturingStageCode, dto.StatusCode),
            Source = string.IsNullOrWhiteSpace(dto.SourceCode) ? "Inbound" : dto.SourceCode,
            Owner = dto.AssignedToUserId.HasValue && ownerLookup.TryGetValue(dto.AssignedToUserId.Value, out var owner) ? owner : "Unassigned",
            Rating = ScoreToRating(score, dto.PriorityCode),
            Score = score,
            EstPremium = dto.AnnualRevenue ?? 0,
            CreatedAt = dto.CreatedDateUtc,
            LastActivity = dto.ModifiedDateUtc,
            Notes = dto.InterestedService
        };
    }

    private void RebuildDerived()
    {
        ApplyFilters(false);
        var maxSource = Math.Max(1, _leads.GroupBy(x => x.Source).Select(g => g.Count()).DefaultIfEmpty(1).Max());
        _sourceFunnel = _leads.GroupBy(x => x.Source).Select(g => new SourceRow(g.Key, g.Count(), g.Count(x => x.Stage == "Converted"), (int)g.Average(x => x.Score), g.Average(x => x.EstPremium), g.Sum(x => x.EstPremium), (double)g.Count() / maxSource * 100)).OrderByDescending(x => x.Total).ToList();
        var maxProducer = Math.Max(1, _leads.GroupBy(x => x.Owner).Select(g => g.Sum(x => x.EstPremium)).DefaultIfEmpty(1).Max());
        _producerRows = _leads.GroupBy(x => x.Owner).Select(g => new ProducerRow(g.Key, g.Count(), g.Count(x => x.Stage == "Converted"), g.Sum(x => x.EstPremium), maxProducer == 0 ? 0 : (double)(g.Sum(x => x.EstPremium) / maxProducer) * 100)).OrderByDescending(x => x.Pipeline).ToList();
        _kpi = new LeadKpi { ConversionRate = _leads.Count == 0 ? 0 : (double)_leads.Count(x => x.Stage == "Converted") / _leads.Count * 100 };
    }

    private void ApplyFilters(bool resetPage = true)
    {
        IEnumerable<LeadRow> query = _leads;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            query = query.Where(x => Contains(x.FullName, term) || Contains(x.CompanyName, term) || Contains(x.Email, term) || Contains(x.Phone, term) || Contains(x.Source, term) || Contains(x.Owner, term) || Contains(x.Stage, term));
        }
        if (!string.IsNullOrWhiteSpace(_filterStage)) query = query.Where(x => x.Stage == _filterStage);
        if (!string.IsNullOrWhiteSpace(_filterSource)) query = query.Where(x => x.Source == _filterSource);
        if (!string.IsNullOrWhiteSpace(_filterOwner)) query = query.Where(x => x.AssignedToUserId?.ToString() == _filterOwner);
        if (!string.IsNullOrWhiteSpace(_filterRating)) query = query.Where(x => x.Rating == _filterRating);
        query = _quickFilter switch { "hot" => query.Where(x => x.Rating == "Hot"), "converted" => query.Where(x => x.Stage == "Converted"), "stale" => query.Where(x => x.DaysSinceActivity > 30 && x.Stage != "Converted" && x.Stage != "Lost"), "pipeline" => query.Where(x => x.Stage != "Converted" && x.Stage != "Lost"), _ => query };
        if (!string.IsNullOrWhiteSpace(_producerFilter)) query = query.Where(x => x.Owner == _producerFilter);
        _filtered = query.OrderByDescending(x => x.Score).ThenByDescending(x => x.CreatedAt).ToList();
        if (resetPage) _pageIndex = 1;
        _pageIndex = Math.Clamp(_pageIndex, 1, TotalPages);
        ApplyPaging();
    }

    private void ApplyPaging() => _paged = _filtered.Skip((_pageIndex - 1) * PageSize).Take(PageSize).ToList();
    private void PreviousPage() { if (_pageIndex > 1) { _pageIndex--; ApplyPaging(); } }
    private void NextPage() { if (_pageIndex < TotalPages) { _pageIndex++; ApplyPaging(); } }
    private void SetView(string view) { _view = view; if (view != "producer") _producerFilter = string.Empty; }
    private void SetQuickFilter(string filter) { _quickFilter = _quickFilter == filter ? string.Empty : filter; ApplyFilters(); }
    private void ShowBoardView() => SetView("board");
    private void ShowFunnelView() => SetView("funnel");
    private void ShowProducerView() => SetView("producer");
    private void ShowHotLeads() => SetQuickFilter("hot");
    private void OpenDetail(LeadRow lead) => _detail = lead;
    private void SelectFunnelSource(string source) { _funnelSource = _funnelSource == source ? string.Empty : source; _filterSource = _funnelSource; ApplyFilters(); }
    private void SelectProducer(string producer) { _producerFilter = _producerFilter == producer ? string.Empty : producer; ApplyFilters(); }
    private void ClearSelection() => _selected.Clear();
    private bool IsSelected(LeadRow lead) => _selected.Any(x => x.LeadId == lead.LeadId);
    private void ToggleSelection(LeadRow lead) { if (IsSelected(lead)) _selected.RemoveAll(x => x.LeadId == lead.LeadId); else _selected.Add(lead); }
    private void ToggleCurrentPageSelection(BlazorChangeEventArgs e) { var selected = e.Value as bool? ?? string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase); if (selected) { foreach (var lead in _paged.Where(x => !IsSelected(x))) _selected.Add(lead); } else { _selected.RemoveAll(x => _paged.Any(p => p.LeadId == x.LeadId)); } }
    private void OnSearchChanged(BlazorChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; ApplyFilters(); }
    private void OnStageFilterChanged(BlazorChangeEventArgs e) { _filterStage = e.Value?.ToString() ?? string.Empty; ApplyFilters(); }
    private void OnSourceFilterChanged(BlazorChangeEventArgs e) { _filterSource = e.Value?.ToString() ?? string.Empty; ApplyFilters(); }
    private void OnOwnerFilterChanged(BlazorChangeEventArgs e) { _filterOwner = e.Value?.ToString() ?? string.Empty; ApplyFilters(); }
    private void OnRatingFilterChanged(BlazorChangeEventArgs e) { _filterRating = e.Value?.ToString() ?? string.Empty; ApplyFilters(); }

    private void OnNewLeadClick() { _editingId = Guid.Empty; _leadForm = new LeadFormModel { Source = "Referral", Stage = "New", Priority = "Warm", Score = 50, Owner = _ownerOptions.FirstOrDefault()?.Value ?? string.Empty }; _showLeadModal = true; }
    private void OpenEdit(LeadRow lead) { _editingId = lead.LeadId; _leadForm = new LeadFormModel { FirstName = lead.FirstName, LastName = lead.LastName, Company = lead.CompanyName, Email = lead.Email, Phone = lead.Phone, Source = lead.Source, Stage = lead.Stage, Priority = lead.Rating, Owner = lead.AssignedToUserId?.ToString() ?? string.Empty, EstPremium = lead.EstPremium, Score = lead.Score, Notes = lead.Notes ?? string.Empty }; _showLeadModal = true; }
    private async Task CloseLeadModal() { if (!_savingLead) { await ReleaseModalAsync("lead-form-modal-root"); _showLeadModal = false; } }
    private void OpenImport() => _showImport = true;
    private async Task CloseImport() { await ReleaseModalAsync("lead-import-modal-root"); _showImport = false; _importErrors.Clear(); _importPreview.Clear(); }
    private void OpenAssign() => _showAssign = true;
    private async Task CloseAssign() { await ReleaseModalAsync("lead-assign-modal-root"); _showAssign = false; }
    private void OpenMerge() => _showMerge = true;
    private async Task CloseMerge() { await ReleaseModalAsync("lead-merge-modal-root"); _showMerge = false; }
    private void SelectMergeTarget(LeadRow lead) => _mergeTarget = lead.LeadId.ToString();
    private async Task CloseConvert() { await ReleaseModalAsync("lead-convert-modal-root"); _showConvert = false; }
    private void OpenCampaign() => _showCampaign = true;
    private async Task CloseCampaign() { await ReleaseModalAsync("lead-campaign-modal-root"); _showCampaign = false; }
    private void OpenLeadAssign(LeadRow lead) { _selected = [lead]; _showAssign = true; }
    private void OpenLeadCampaign(LeadRow lead) { _selected = [lead]; _showCampaign = true; }
    private void OpenLeadConvert(LeadRow lead) { _selected = [lead]; ConfirmConvertToOpportunity(); }

    private async Task SaveLeadAsync()
    {
        if (!ValidateLeadForm()) return;
        _savingLead = true;
        try
        {
            var assignedToUserId = Guid.TryParse(_leadForm.Owner, out var ownerId) ? ownerId : (Guid?)null;
            if (_editingId == Guid.Empty)
            {
                await Api.CreateLeadAsync(new CreateLeadRequest { TenantId = _tenantId, LeadNumber = $"LD-{DateTime.UtcNow:yyyyMMddHHmmss}", AccountName = _leadForm.Company.Trim(), FirstName = _leadForm.FirstName.Trim(), LastName = _leadForm.LastName.Trim(), Email = _leadForm.Email.Trim(), Phone = NormalizePhone(_leadForm.Phone), InterestedService = _leadForm.Notes, AnnualRevenue = _leadForm.EstPremium, Score = _leadForm.Score, PriorityCode = _leadForm.Priority, SourceCode = _leadForm.Source, NurturingStageCode = _leadForm.Stage, AssignedToUserId = assignedToUserId, CreatedByUserId = TenantAdminUserId });
                await ShowToastAsync("Lead created.", "success");
            }
            else
            {
                await Api.UpdateLeadAsync(_editingId, new UpdateLeadRequest { LeadId = _editingId, AccountName = _leadForm.Company.Trim(), FirstName = _leadForm.FirstName.Trim(), LastName = _leadForm.LastName.Trim(), Email = _leadForm.Email.Trim(), Phone = NormalizePhone(_leadForm.Phone), InterestedService = _leadForm.Notes, AnnualRevenue = _leadForm.EstPremium, Score = _leadForm.Score, PriorityCode = _leadForm.Priority, SourceCode = _leadForm.Source, NurturingStageCode = _leadForm.Stage, StatusCode = StageToStatusCode(_leadForm.Stage), AssignedToUserId = assignedToUserId, UpdatedByUserId = TenantAdminUserId });
                await ShowToastAsync("Lead saved.", "success");
            }
            await CloseLeadModal();
            _editingId = Guid.Empty;
            await LoadAsync();
        }
        catch (Exception ex) { await ShowToastAsync($"Save failed: {ex.Message}", "danger"); }
        finally { _savingLead = false; }
    }

    private bool ValidateLeadForm()
    {
        if (string.IsNullOrWhiteSpace(_leadForm.FirstName) || string.IsNullOrWhiteSpace(_leadForm.LastName) || string.IsNullOrWhiteSpace(_leadForm.Company) || string.IsNullOrWhiteSpace(_leadForm.Email) || string.IsNullOrWhiteSpace(_leadForm.Source) || string.IsNullOrWhiteSpace(_leadForm.Owner)) { _ = ShowToastAsync("Complete required lead fields.", "warning"); return false; }
        if (!new EmailAddressAttribute().IsValid(_leadForm.Email)) { _ = ShowToastAsync("Enter a valid email address.", "warning"); return false; }
        if (!IsPhoneValid(_leadForm.Phone)) { _ = ShowToastAsync("Enter a valid phone number.", "warning"); return false; }
        return true;
    }

    private Task HandleInvalidLeadSubmitAsync(EditContext _) => ShowToastAsync("Fix validation errors.", "warning");

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        _importErrors.Clear(); _importPreview.Clear();
        try
        {
            using var stream = args.File.OpenReadStream(5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var header = await reader.ReadLineAsync();
            if (string.IsNullOrWhiteSpace(header)) { _importErrors.Add("CSV file is empty."); return; }
            var columns = header.Split(',').Select(x => x.Trim()).ToArray();
            var lineNo = 1;
            while (!reader.EndOfStream && _importPreview.Count < 100)
            {
                lineNo++;
                var line = await reader.ReadLineAsync();
                if (string.IsNullOrWhiteSpace(line)) continue;
                var values = line.Split(',');
                string Get(string name) { var idx = Array.FindIndex(columns, c => string.Equals(c, name, StringComparison.OrdinalIgnoreCase)); return idx >= 0 && idx < values.Length ? values[idx].Trim() : string.Empty; }
                var row = new LeadImportRow { FirstName = Get("FirstName"), LastName = Get("LastName"), CompanyName = Get("Company"), Email = Get("Email"), Source = Get("Source"), Phone = Get("Phone"), Owner = Get("Owner"), PremiumText = Get("Premium"), Notes = Get("Notes") };
                if (string.IsNullOrWhiteSpace(row.FirstName) || string.IsNullOrWhiteSpace(row.LastName) || string.IsNullOrWhiteSpace(row.CompanyName) || string.IsNullOrWhiteSpace(row.Email) || string.IsNullOrWhiteSpace(row.Source)) _importErrors.Add($"Line {lineNo}: missing required fields.");
                else _importPreview.Add(row);
            }
        }
        catch (Exception ex) { _importErrors.Add(ex.Message); }
    }

    private async Task CommitImportAsync()
    {
        var created = 0;
        foreach (var row in _importPreview)
        {
            if (_importDedupe && _leads.Any(x => string.Equals(x.Email, row.Email, StringComparison.OrdinalIgnoreCase))) continue;
            var ownerId = ResolveOwnerId(row.Owner) ?? (_importAssignRoundRobin ? ResolveOwnerId(_ownerOptions.ElementAtOrDefault(created % Math.Max(1, _ownerOptions.Count))?.Label) : null);
            await Api.CreateLeadAsync(new CreateLeadRequest { TenantId = _tenantId, LeadNumber = $"LD-{DateTime.UtcNow:yyyyMMddHHmmss}-{created + 1}", AccountName = row.CompanyName, FirstName = row.FirstName, LastName = row.LastName, Email = row.Email, Phone = NormalizePhone(row.Phone), InterestedService = row.Notes, AnnualRevenue = decimal.TryParse(row.PremiumText, out var premium) ? premium : null, Score = 45, PriorityCode = "Warm", SourceCode = row.Source, NurturingStageCode = "New", AssignedToUserId = ownerId, CreatedByUserId = TenantAdminUserId });
            created++;
        }
        await CloseImport();
        await ShowToastAsync($"Imported {created} lead(s).", "success");
        await LoadAsync();
    }

    private async Task CommitAssignAsync()
    {
        if (!Guid.TryParse(_assignTarget, out var ownerId)) { await ShowToastAsync("Select an owner.", "warning"); return; }
        foreach (var lead in _selected) await UpdateLeadWorkflowAsync(lead, lead.Stage, StageToStatusCode(lead.Stage), ownerId, lead.Rating, lead.Score, lead.Notes);
        var owner = _ownerOptions.FirstOrDefault(x => x.Value == _assignTarget)?.Label ?? "owner";
        await CloseAssign(); _selected.Clear(); await ShowToastAsync($"Assigned to {owner}.", "success"); await LoadAsync();
    }

    private async Task CommitMergeAsync()
    {
        if (!Guid.TryParse(_mergeTarget, out var masterId)) { await ShowToastAsync("Select a master lead.", "warning"); return; }
        var master = _selected.First(x => x.LeadId == masterId);
        foreach (var duplicate in _selected.Where(x => x.LeadId != masterId)) await UpdateLeadWorkflowAsync(duplicate, "Lost", 5, duplicate.AssignedToUserId, duplicate.Rating, duplicate.Score, $"Merged into {master.FullName}. {duplicate.Notes}");
        await CloseMerge(); _selected.Clear(); await ShowToastAsync($"Merged into {master.FullName}.", "success"); await LoadAsync();
    }

    private void ConfirmConvertToOpportunity()
    {
        if (_selected.Count == 0) { _ = ShowToastAsync("Select leads to convert.", "warning"); return; }
        OpenConfirm(new ConfirmAction("Convert leads", $"Review conversion options for {_selected.Count} lead(s)?", "Continue", "um-btn-primary", "bi-trophy", "warning", () => { _showConvert = true; return Task.CompletedTask; }));
    }

    private async Task CommitConvertAsync()
    {
        foreach (var lead in _selected.ToList())
        {
            await UpdateLeadWorkflowAsync(lead, "Converted", 4, lead.AssignedToUserId, "Hot", Math.Max(lead.Score, 85), lead.Notes, DateTime.UtcNow);
            if (_convertCreateActivity) await Api.CreateLeadCommunicationAsync(lead.LeadId, new CreateLeadCommunicationRequest { TenantId = _tenantId, LeadId = lead.LeadId, Channel = "Workflow", Subject = "Lead converted", Preview = "Lead converted from enterprise Leads workspace.", SentByUserId = TenantAdminUserId, SentAt = DateTime.UtcNow, Opened = true, Clicked = false });
        }
        await CloseConvert(); _selected.Clear(); await ShowToastAsync("Lead conversion completed.", "success"); await LoadAsync();
    }

    private async Task CommitCampaignAsync()
    {
        var campaignName = _campaignOptions.FirstOrDefault(x => x.Value == _campaignTarget)?.Label ?? _campaignTarget;
        foreach (var lead in _selected) await Api.CreateLeadCampaignAsync(lead.LeadId, new CreateLeadCampaignEnrollmentRequest { TenantId = _tenantId, LeadId = lead.LeadId, CampaignName = campaignName, Status = "Active", EnrolledAt = DateTime.UtcNow, EmailsSent = _campaignSendImmediately ? 1 : 0, EmailsOpen = 0, Clicks = 0, LastTouch = _campaignSendImmediately ? DateTime.UtcNow : null, CreatedByUserId = TenantAdminUserId });
        await CloseCampaign(); _selected.Clear(); await ShowToastAsync("Campaign enrollment completed.", "success");
    }

    private void ConfirmImport() => OpenConfirm(new("Import leads", $"Import {_importPreview.Count} validated lead(s)?", "Import", "um-btn-primary", "bi-cloud-arrow-up", "warning", CommitImportAsync));
    private void ConfirmAssign() => OpenConfirm(new("Assign owner", $"Assign {_selected.Count} selected lead(s)?", "Assign", "um-btn-primary", "bi-person-check", "warning", CommitAssignAsync));
    private void ConfirmMerge() => OpenConfirm(new("Merge duplicates", $"Merge {_selected.Count} selected lead(s)?", "Merge", "um-btn-danger", "bi-intersect", "danger", CommitMergeAsync));
    private void ConfirmCommitConvert() => OpenConfirm(new("Confirm conversion", $"Convert {_selected.Count} selected lead(s)?", "Convert", "um-btn-primary", "bi-trophy", "warning", CommitConvertAsync));
    private void ConfirmCampaign() => OpenConfirm(new("Enroll campaign", $"Enroll {_selected.Count} lead(s)?", "Enroll", "um-btn-primary", "bi-megaphone", "warning", CommitCampaignAsync));
    private void ConfirmDisqualify(LeadRow lead) => OpenConfirm(new("Disqualify lead", $"Disqualify {lead.FullName}?", "Disqualify", "um-btn-danger", "bi-x-octagon", "danger", () => DisqualifyLeadAsync(lead)));

    private async Task DisqualifyLeadAsync(LeadRow lead) { await UpdateLeadWorkflowAsync(lead, "Lost", 5, lead.AssignedToUserId, lead.Rating, lead.Score, lead.Notes); _selected.RemoveAll(x => x.LeadId == lead.LeadId); _detail = null; await ShowToastAsync("Lead disqualified.", "success"); await LoadAsync(); }

    private async Task UpdateLeadWorkflowAsync(LeadRow lead, string stage, int status, Guid? ownerId, string priority, int score, string? notes, DateTime? qualifiedDate = null)
    {
        await Api.UpdateLeadAsync(lead.LeadId, new UpdateLeadRequest { LeadId = lead.LeadId, AccountName = lead.CompanyName, FirstName = lead.FirstName, LastName = lead.LastName, Email = lead.Email, Phone = lead.Phone, InterestedService = notes, AnnualRevenue = lead.EstPremium, Score = score, PriorityCode = priority, SourceCode = lead.Source, NurturingStageCode = stage, QualifiedDate = qualifiedDate, StatusCode = status, AssignedToUserId = ownerId, UpdatedByUserId = TenantAdminUserId });
    }

    private void OpenConfirm(ConfirmAction action) { _confirmAction = action; _showConfirm = true; }
    private async Task CancelConfirm() { if (!_busy) { await ReleaseModalAsync("lead-confirm-modal-root"); _showConfirm = false; _confirmAction = null; } }
    private async Task ExecuteConfirmedAsync() { if (_confirmAction is null) return; _busy = true; try { var action = _confirmAction; await action.ExecuteAsync(); await ReleaseModalAsync("lead-confirm-modal-root"); _showConfirm = false; _confirmAction = null; } catch (Exception ex) { await ShowToastAsync($"Action failed: {ex.Message}", "danger"); } finally { _busy = false; } }

    private async Task ShowToastAsync(string message, string kind = "info")
    {
        _toastCts?.Cancel(); _toastCts?.Dispose(); _toastCts = new CancellationTokenSource();
        _toastMessage = message.Length <= 96 ? message : $"{message[..93]}..."; _toastKind = ToastKind(kind); _toastVisible = true; StateHasChanged();
        try { await Task.Delay(_toastKind == "danger" ? 10400 : 8000, _toastCts.Token); _toastVisible = false; await InvokeAsync(StateHasChanged); } catch (TaskCanceledException) { }
    }

    private void HideToast() { _toastCts?.Cancel(); _toastVisible = false; }
    private static string ToastKind(string value) => value.Contains("danger", StringComparison.OrdinalIgnoreCase) || value.Contains("error", StringComparison.OrdinalIgnoreCase) ? "danger" : value.Contains("warning", StringComparison.OrdinalIgnoreCase) ? "warning" : value.Contains("success", StringComparison.OrdinalIgnoreCase) ? "success" : "info";
    private async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; TenantAdminUserId = context.UserId; }
    private void OnPhoneChanged() { if (IsPhoneValid(_leadForm.Phone)) _leadForm.Phone = NormalizePhone(_leadForm.Phone) ?? string.Empty; }
    private Guid? ResolveOwnerId(string? owner) => Guid.TryParse(owner, out var id) ? id : Guid.TryParse(_ownerOptions.FirstOrDefault(x => string.Equals(x.Label, owner, StringComparison.OrdinalIgnoreCase))?.Value, out var byName) ? byName : null;
    private static bool IsPhoneValid(string? value) { if (string.IsNullOrWhiteSpace(value)) return true; var digits = new string(value.Where(char.IsDigit).ToArray()); if (digits.Length == 11 && digits[0] == '1') digits = digits[1..]; return digits.Length == 10; }
    private static string? NormalizePhone(string? value) { if (string.IsNullOrWhiteSpace(value)) return null; var digits = new string(value.Where(char.IsDigit).ToArray()); if (digits.Length == 11 && digits[0] == '1') digits = digits[1..]; return digits.Length == 10 ? $"({digits[..3]}) {digits.Substring(3, 3)}-{digits[6..]}" : value.Trim(); }
    private static bool Contains(string value, string term) => value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static string NormalizeStage(string? stage, int statusCode) => !string.IsNullOrWhiteSpace(stage) ? stage.Trim() switch { "Closed" => "Lost", "Won" => "Converted", var s => s } : statusCode switch { 2 => "Contacted", 3 => "Qualified", 4 => "Converted", 5 => "Lost", _ => "New" };
    private static string ScoreToRating(int score, string? priority = null) => string.Equals(priority, "Hot", StringComparison.OrdinalIgnoreCase) || score >= 80 ? "Hot" : score >= 50 ? "Warm" : "Cold";
    private static int StageOrder(string stage) => Array.IndexOf(_boardStages, stage) is var index && index >= 0 ? index : 99;
    private static int StageToStatusCode(string stage) => stage switch { "Contacted" => 2, "Qualified" => 3, "Converted" => 4, "Lost" => 5, _ => 1 };
    private string MetricCardClass(KpiModel metric) => $"ld-kpi-card {metric.Tone} {(_quickFilter == metric.Filter ? "ld-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewDef view) => _view == view.Id ? "ld-view-btn ld-view-btn-active" : "ld-view-btn";
    private string LeadRowClass(LeadRow lead) => lead.LeadId == _detail?.LeadId ? "ld-row-selected" : string.Empty;
    private string FunnelRowClass(SourceRow source) => _funnelSource == source.Source ? "ld-funnel-row ld-active" : "ld-funnel-row";
    private string ProducerCardClass(ProducerRow producer) => _producerFilter == producer.Owner ? "ld-producer-card ld-active" : "ld-producer-card";
    private static string RatingBadge(string rating) => rating switch { "Hot" => "ld-rating ld-rating-hot", "Warm" => "ld-rating ld-rating-warm", _ => "ld-rating ld-rating-cold" };
    private static string StageBadge(string stage) => $"ld-stage ld-stage-{stage.ToLowerInvariant().Replace(" ", "-")}";
    private string MergeOptionClass(LeadRow lead) => _mergeTarget == lead.LeadId.ToString() ? "ld-merge-option ld-merge-option-active" : "ld-merge-option";
    private string MergeOptionIconClass(LeadRow lead) => _mergeTarget == lead.LeadId.ToString() ? "bi bi-check-circle-fill" : "bi bi-circle";
    private static string SourceIcon(string source) => source switch { "Referral" => "bi-share-fill", "Website" => "bi-globe", "Cold Call" => "bi-telephone-fill", "Social" => "bi-instagram", "Email" => "bi-envelope-fill", "Event" => "bi-calendar-event-fill", "Partner" => "bi-handshake-fill", _ => "bi-inbox-fill" };
    private static string ScoreTone(int score) => score >= 80 ? "ld-score-hot" : score >= 50 ? "ld-score-warm" : "ld-score-cold";
    private static string AvatarColor(string name) { var colors = new[] { "ld-av1", "ld-av2", "ld-av3", "ld-av4", "ld-av5", "ld-av6" }; return colors[Math.Abs(name.GetHashCode()) % colors.Length]; }
    private static string Initials(string name) { var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length > 0 ? name[..1] : "?"; }

    private sealed record ViewDef(string Id, string Label, string Icon);
    private sealed record LabelValue(string Value, string Label);
    private sealed record KpiModel(string Label, string Value, string Caption, string Icon, string Tone, string Filter);
    private sealed record ConfirmAction(string Title, string Message, string ButtonText, string ButtonClass, string Icon, string Kind, Func<Task> ExecuteAsync);
    private sealed record StageBreakdownRow(string Stage, int Count, double WidthPercent);
    private sealed record SourceRow(string Source, int Total, int Converted, int AvgScore, decimal AvgPremium, decimal TotalPipeline, double WidthPercent) { public double ConvPct => Total == 0 ? 0 : (double)Converted / Total * 100; }
    private sealed record ProducerRow(string Owner, int Total, int Converted, decimal Pipeline, double WidthPercent) { public double ConvPct => Total == 0 ? 0 : (double)Converted / Total * 100; }
    private sealed class LeadKpi { public double ConversionRate { get; set; } }
    private sealed class LeadRow { public Guid LeadId { get; set; } public Guid? AssignedToUserId { get; set; } public string FirstName { get; set; } = string.Empty; public string LastName { get; set; } = string.Empty; public string FullName { get; set; } = string.Empty; public string CompanyName { get; set; } = string.Empty; public string Email { get; set; } = string.Empty; public string Phone { get; set; } = string.Empty; public string Stage { get; set; } = "New"; public string Source { get; set; } = string.Empty; public string Owner { get; set; } = string.Empty; public string Rating { get; set; } = "Cold"; public int Score { get; set; } public decimal EstPremium { get; set; } public DateTime CreatedAt { get; set; } public DateTime? LastActivity { get; set; } public int DaysSinceActivity => LastActivity.HasValue ? (int)(DateTime.UtcNow - LastActivity.Value).TotalDays : 999; public string? Notes { get; set; } }
    private sealed class LeadImportRow { public string FirstName { get; set; } = string.Empty; public string LastName { get; set; } = string.Empty; public string FullName => $"{FirstName} {LastName}".Trim(); public string CompanyName { get; set; } = string.Empty; public string Email { get; set; } = string.Empty; public string Source { get; set; } = string.Empty; public string Phone { get; set; } = string.Empty; public string Owner { get; set; } = string.Empty; public string PremiumText { get; set; } = string.Empty; public string Notes { get; set; } = string.Empty; }
    private sealed class LeadFormModel
    {
        [Required, StringLength(100)] public string FirstName { get; set; } = string.Empty;
        [Required, StringLength(100)] public string LastName { get; set; } = string.Empty;
        [Required, StringLength(200)] public string Company { get; set; } = string.Empty;
        [Required, AmsEmailAddress, StringLength(200)] public string Email { get; set; } = string.Empty;
        [AmsPhone, StringLength(30)] public string Phone { get; set; } = string.Empty;
        [Required, StringLength(50)] public string Source { get; set; } = string.Empty;
        [Required, StringLength(100)] public string Owner { get; set; } = string.Empty;
        [StringLength(50)] public string Stage { get; set; } = "New";
        [StringLength(50)] public string Priority { get; set; } = "Warm";
        [Range(0, 99999999.99)] public decimal EstPremium { get; set; }
        [Range(0, 100)] public int Score { get; set; } = 50;
        [StringLength(1000)] public string Notes { get; set; } = string.Empty;
    }
}
