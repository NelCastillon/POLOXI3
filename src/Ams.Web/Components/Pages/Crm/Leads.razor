        <Header><span class="ld-dlg-hdr"><i class="bi bi-person-check" aria-hidden="true"></i> Assign Owner</span></Header>
        <Content>
            <div class="ld-assign-body">
                <p class="ld-assign-info">Assign <strong>@_selected.Count lead(s)</strong> to:</p>
                <SfDropDownList TValue="string" TItem="LabelValue"
                                DataSource="_ownerOptions"
                                Placeholder="Select owner…"
                                Width="100%"
