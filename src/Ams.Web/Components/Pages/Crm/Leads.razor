    private async Task CommitAssignAsync()
    {
        if (_selected.Count == 0)
        {
            await ShowToastAsync("Select at least one lead to assign.", "e-toast-danger");
            return;
        }

        if (!Guid.TryParse(_assignTarget, out var assignedToUserId))
        {
            await ShowToastAsync("Select a valid owner from the user table.", "e-toast-danger");
            return;
        }

        try
        {
            foreach (var lead in _selected)
            {
                await Api.UpdateLeadAsync(lead.LeadId, new UpdateLeadRequest
                {
                    LeadId = lead.LeadId,
                    AccountName = lead.CompanyName,
                    FirstName = lead.FirstName,
                    LastName = lead.LastName,
                    Email = lead.Email,
                    Phone = lead.Phone,
                    InterestedService = lead.Notes,
                    Score = lead.Score,
                    PriorityCode = lead.Rating,
                    SourceCode = lead.Source,
                    NurturingStageCode = lead.Stage,
                    StatusCode = StageToStatusCode(lead.Stage),
                    AssignedToUserId = assignedToUserId,
                });
            }

            var ownerName = _ownerOptions.FirstOrDefault(o => o.Value == _assignTarget)?.Label ?? "selected owner";
            _showAssign = false;
            _detail = null;
            await ShowToastAsync($"{_selected.Count} lead(s) assigned to {ownerName}.", "e-toast-success");
            _selected.Clear();
            _assignTarget = string.Empty;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Assignment failed: {ex.Message}", "e-toast-danger");
        }
    }

