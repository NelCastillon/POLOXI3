    private sealed class LeadRow
    {
        public Guid      LeadId          { get; set; } = Guid.NewGuid();
        public Guid?     AssignedToUserId { get; set; }
        public string    FirstName       { get; set; } = string.Empty;
        public string    LastName        { get; set; } = string.Empty;
        public string    FullName        { get; set; } = string.Empty;
        public string    CompanyName     { get; set; } = string.Empty;
        public string    Email           { get; set; } = string.Empty;
        public string    Phone           { get; set; } = string.Empty;
        public string    Stage           { get; set; } = "New";
        public string    Source          { get; set; } = string.Empty;
        public string    Owner           { get; set; } = string.Empty;
        public string    Rating          { get; set; } = "Cold";
        public int       Score           { get; set; }
        public decimal   EstPremium      { get; set; }
        public DateTime  CreatedAt       { get; set; } = DateTime.UtcNow;
        public DateTime? LastActivity    { get; set; }
        public int       DaysSinceActivity => LastActivity.HasValue
            ? (int)(DateTime.UtcNow - LastActivity.Value).TotalDays : 999;
        public string?   Notes           { get; set; }
    }

    private sealed class LeadImportRow
    {
        public string FullName    { get; set; } = string.Empty;
        public string CompanyName { get; set; } = string.Empty;
        public string Email       { get; set; } = string.Empty;
        public string Source      { get; set; } = string.Empty;
    }

    private sealed class SourceRow
    {
        public string  Source        { get; set; } = string.Empty;
        public int     Total         { get; set; }
        public int     Converted     { get; set; }
        public int     AvgScore      { get; set; }
        public decimal AvgPremium    { get; set; }
        public decimal TotalPipeline { get; set; }
        public double  ConvPct       => Total == 0 ? 0 : (double)Converted / Total * 100;
    }

    private sealed class ProducerRow
    {
        public string  Owner     { get; set; } = string.Empty;
        public int     Total     { get; set; }
        public int     Converted { get; set; }
        public decimal Pipeline  { get; set; }
        public double  ConvPct   => Total == 0 ? 0 : (double)Converted / Total * 100;
    }

    private sealed class LeadKpi
    {
        public int     TotalLeads     { get; set; }
        public int     Hot            { get; set; }
        public int     Converted      { get; set; }
        public double  ConversionRate { get; set; }
        public int     Stale          { get; set; }
        public decimal EstPipeline    { get; set; }
    }

