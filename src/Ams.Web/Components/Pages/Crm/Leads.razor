@page "/crm/leads"
@namespace Ams.Web.Components.Pages.Crm
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Leads</PageTitle>

<AppPageHeader Title="Leads"
               Subtitle="Track, score and convert every prospect — grid, Kanban, source funnel and producer breakdown"
               Icon="bi-person-plus-fill">
    <Actions>
        <!-- View switcher -->
        <div class="ld-view-toggle" role="group" aria-label="View mode">
            @foreach (var v in _views)
            {
                <button class="ld-view-btn @(_view == v.Id ? "ld-view-btn--active" : "")"
                        @onclick="() => SetView(v.Id)"
                        title="@v.Label"
                        aria-pressed="@(_view == v.Id)">
                    <i class="bi @v.Icon" aria-hidden="true"></i>
                    <span class="ld-view-label">@v.Label</span>
                </button>
            }
        </div>

        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh">
            <i class="bi bi-arrow-clockwise @(_loading ? "ld-spin" : "")" aria-hidden="true"></i>
        </button>

        <button class="um-btn um-btn-ghost" @onclick="() => _showImport = true">
            <i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Import
        </button>

        <button class="um-btn um-btn-primary" @onclick='OnNewLeadClick'>
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Lead
        </button>
    </Actions>
</AppPageHeader>

<!-- ── KPI strip ─────────────────────────────────────────────────────────── -->
<div class="ld-kpi-strip">
    <div class="ld-kpi-card">
        <span class="ld-kpi-icon ld-kpi-i1"><i class="bi bi-person-plus-fill" aria-hidden="true"></i></span>
        <div>
            <div class="ld-kpi-val">@_kpi.TotalLeads</div>
            <div class="ld-kpi-lbl">Total Leads</div>
        </div>
    </div>
    <div class="ld-kpi-card">
        <span class="ld-kpi-icon ld-kpi-i2"><i class="bi bi-fire" aria-hidden="true"></i></span>
        <div>
            <div class="ld-kpi-val">@_kpi.Hot</div>
            <div class="ld-kpi-lbl">Hot</div>
        </div>
    </div>
    <div class="ld-kpi-card">
        <span class="ld-kpi-icon ld-kpi-i3"><i class="bi bi-trophy-fill" aria-hidden="true"></i></span>
        <div>
            <div class="ld-kpi-val">@_kpi.Converted</div>
            <div class="ld-kpi-lbl">Converted</div>
        </div>
    </div>
    <div class="ld-kpi-card">
        <span class="ld-kpi-icon ld-kpi-i4"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span>
        <div>
            <div class="ld-kpi-val">@_kpi.ConversionRate.ToString("F1")%</div>
            <div class="ld-kpi-lbl">Conversion Rate</div>
        </div>
    </div>
    <div class="ld-kpi-card">
        <span class="ld-kpi-icon ld-kpi-i5"><i class="bi bi-calendar-x" aria-hidden="true"></i></span>
        <div>
            <div class="ld-kpi-val @(_kpi.Stale > 0 ? "ld-kpi-val--warn" : "")">@_kpi.Stale</div>
            <div class="ld-kpi-lbl">Stale (&gt;30 d)</div>
        </div>
    </div>
    <div class="ld-kpi-card">
        <span class="ld-kpi-icon ld-kpi-i1"><i class="bi bi-cash-coin" aria-hidden="true"></i></span>
        <div>
            <div class="ld-kpi-val">@_kpi.EstPipeline.ToString("C0")</div>
            <div class="ld-kpi-lbl">Est. Pipeline</div>
        </div>
    </div>
</div>

<!-- ── Filter / search bar ───────────────────────────────────────────────── -->
<div class="ld-filter-bar">
    <div class="ld-search-wrap">
        <i class="bi bi-search ld-search-icon" aria-hidden="true"></i>
        <input class="ld-search-input" type="search" placeholder="Search leads…"
               value="@_search"
               @oninput="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => { _search = e.Value?.ToString() ?? string.Empty; ApplyFilters(); })" />
    </div>

    <SfDropDownList TValue="string" TItem="LabelValue"
                    DataSource="_stageOptions"
                    Placeholder="All Stages"
                    ShowClearButton="true"
                    Width="145px"
                    Value="_filterStage"
                    ValueChanged="@((string v) => { _filterStage = v; ApplyFilters(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>

    <SfDropDownList TValue="string" TItem="LabelValue"
                    DataSource="_sourceOptions"
                    Placeholder="All Sources"
                    ShowClearButton="true"
                    Width="145px"
                    Value="_filterSource"
                    ValueChanged="@((string v) => { _filterSource = v; ApplyFilters(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>

    <SfDropDownList TValue="string" TItem="LabelValue"
                    DataSource="_ownerOptions"
                    Placeholder="All Owners"
                    ShowClearButton="true"
                    Width="145px"
                    Value="_filterOwner"
                    ValueChanged="@((string v) => { _filterOwner = v; ApplyFilters(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>

    <SfDropDownList TValue="string" TItem="LabelValue"
                    DataSource="_ratingOptions"
                    Placeholder="All Ratings"
                    ShowClearButton="true"
                    Width="130px"
                    Value="_filterRating"
                    ValueChanged="@((string v) => { _filterRating = v; ApplyFilters(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>

    @if (_selected.Count > 0)
    {
        <div class="ld-bulk-actions">
            <span class="ld-bulk-count">@_selected.Count selected</span>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showAssign = true">
                <i class="bi bi-person-check" aria-hidden="true"></i> Assign
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showMerge = true">
                <i class="bi bi-intersect" aria-hidden="true"></i> Merge
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="ConvertToOpportunityAsync">
                <i class="bi bi-trophy" aria-hidden="true"></i> Convert
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showCampaign = true">
                <i class="bi bi-megaphone" aria-hidden="true"></i> Campaign
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm ld-deselect-btn" @onclick="ClearSelection">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
    }
</div>

<!-- ════════════════════════════════════════════════════════════════════════
     VIEW: GRID
     ════════════════════════════════════════════════════════════════════════ -->
@if (_view == "grid")
{
    @if (_loading)
    {
        <div class="ld-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading leads…</span></div>
    }
    else
    {
        <div class="ld-grid-card app-datagrid">
            <SfGrid @ref="_grid"
                    TValue="LeadRow"
                    DataSource="_filtered"
                    AllowPaging="true"
                    AllowSorting="true"
                    AllowFiltering="true"
                    AllowSelection="true"
                    EnableHover="true"
                    RowHeight="56">
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" />
                <GridPageSettings PageSize="25" PageSizes="@(new int[]{10,25,50,100})" />
                <GridEvents TValue="LeadRow" RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
                <GridColumns>
                    <GridColumn Type="ColumnType.CheckBox" Width="48" />
                    <GridColumn HeaderText="Rating" Width="100" AllowFiltering="false" AllowSorting="true" Field="@nameof(LeadRow.Rating)">
                        <Template>
                            @{ var r = (LeadRow)context; }
                            <span class="@RatingBadge(r.Rating)">@r.Rating</span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Lead" Width="220" Field="@nameof(LeadRow.FullName)">
                        <Template>
                            @{ var r = (LeadRow)context; }
                            <div class="ld-name-cell">
                                <div class="ld-avatar @AvatarColor(r.FullName)">@Initials(r.FullName)</div>
                                <div>
                                    <div class="ld-item-name">@r.FullName</div>
                                    <div class="ld-item-sub">@r.CompanyName</div>
                                </div>
                            </div>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(LeadRow.Stage)" HeaderText="Stage" Width="140">
                        <Template>
                            @{ var r = (LeadRow)context; }
                            <span class="@StageBadge(r.Stage)">@r.Stage</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(LeadRow.Source)" HeaderText="Source" Width="130">
                        <Template>
                            @{ var r = (LeadRow)context; }
                            <span class="ld-source-badge">
                                <i class="bi @SourceIcon(r.Source)" aria-hidden="true"></i> @r.Source
                            </span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(LeadRow.Owner)" HeaderText="Owner" Width="140" />
                    <GridColumn Field="@nameof(LeadRow.EstPremium)" HeaderText="Est. Premium" Width="140" TextAlign="TextAlign.Right">
                        <Template>
                            @{ var r = (LeadRow)context; }
                            <span class="ld-mono ld-bold">@r.EstPremium.ToString("C0")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(LeadRow.Score)" HeaderText="Score" Width="120">
                        <Template>
                            @{ var r = (LeadRow)context; }
                            <div class="ld-score-wrap">
                                <div class="ld-score-bar" style="width:@r.Score%;background:@ScoreColor(r.Score)"></div>
                                <span class="ld-score-num">@r.Score</span>
                            </div>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(LeadRow.LastActivity)" HeaderText="Last Activity" Width="130">
                        <Template>
                            @{ var r = (LeadRow)context; }
                            <span class="@(r.DaysSinceActivity > 30 ? "ld-stale" : "")">
                                @(r.LastActivity.HasValue ? r.LastActivity.Value.ToString("d") : "—")
                            </span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(LeadRow.CreatedAt)" HeaderText="Created" Width="120">
                        <Template>@{ var r = (LeadRow)context; }<span class="ld-mono">@r.CreatedAt.ToString("d")</span></Template>
                    </GridColumn>
                    <GridColumn HeaderText="" Width="90" AllowFiltering="false" AllowSorting="false" TextAlign="TextAlign.Right">
                        <Template>
                            @{ var r = (LeadRow)context; }
                            <div class="ld-row-actions">
                                <button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenDetail(r)" title="View">
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </button>
                                <button class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="(e) => OpenRowMenu(r, e)" title="More">
                                    <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                </button>
                            </div>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    }
}

<!-- ════════════════════════════════════════════════════════════════════════
     VIEW: KANBAN
     ════════════════════════════════════════════════════════════════════════ -->
@if (_view == "kanban")
{
    @if (_loading)
    {
        <div class="ld-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div>
    }
    else
    {
        <div class="ld-kanban-wrap">
            <SfKanban TValue="LeadRow"
                      KeyField="@nameof(LeadRow.Stage)"
                      DataSource="_filtered">
                <KanbanColumns>
                    @foreach (var col in _kanbanColumns)
                    {
                        <KanbanColumn HeaderText="@col.Label"
                                      KeyField="@(new List<string> { col.Key })"
                                      AllowDrop="true"
                                      AllowDrag="true"
                                      ShowItemCount="true" />
                    }
                </KanbanColumns>
                <KanbanCardSettings HeaderField="@nameof(LeadRow.LeadId)"
                                    ContentField="@nameof(LeadRow.FullName)">
                    <Template>
                        @{ var r = (LeadRow)context; }
                        <div class="ld-card" @onclick="() => OpenDetail(r)">
                            <div class="ld-card-hdr">
                                <span class="@RatingBadge(r.Rating)">@r.Rating</span>
                                <span class="ld-card-score" style="color:@ScoreColor(r.Score)" title="Lead score">@r.Score</span>
                            </div>
                            <div class="ld-card-name">@r.FullName</div>
                            <div class="ld-card-company">@r.CompanyName</div>
                            <div class="ld-card-meta">
                                <span class="ld-source-badge">
                                    <i class="bi @SourceIcon(r.Source)" aria-hidden="true"></i> @r.Source
                                </span>
                                <span class="ld-mono">@r.EstPremium.ToString("C0")</span>
                            </div>
                            <div class="ld-card-footer">
                                <span class="ld-card-owner"><i class="bi bi-person" aria-hidden="true"></i> @r.Owner</span>
                                @if (r.DaysSinceActivity > 30)
                                {
                                    <span class="ld-stale-chip" title="No activity for @r.DaysSinceActivity days">
                                        <i class="bi bi-clock" aria-hidden="true"></i> @r.DaysSinceActivity d
                                    </span>
                                }
                            </div>
                        </div>
                    </Template>
                </KanbanCardSettings>
                <KanbanSwimlaneSettings KeyField="@(_swimByOwner ? nameof(LeadRow.Owner) : string.Empty)"
                                        ShowEmptyRow="false" />
            </SfKanban>
        </div>
        <div class="ld-kanban-toolbar">
            <label class="ld-toggle-label">
                <input type="checkbox" @bind="_swimByOwner" />
                Swimlanes by owner
            </label>
        </div>
    }
}

<!-- ════════════════════════════════════════════════════════════════════════
     VIEW: SOURCE FUNNEL
     ════════════════════════════════════════════════════════════════════════ -->
@if (_view == "funnel")
{
    <div class="ld-funnel-layout">

        <!-- Left: funnel visual -->
        <div class="ld-funnel-chart-wrap">
            <h3 class="ld-section-hdr">Leads by Source</h3>
            <div class="ld-funnel-bars">
                @foreach (var s in _sourceFunnel)
                {
                    var pct = _sourceFunnel.Max(x => x.Total) == 0 ? 0
                              : (double)s.Total / _sourceFunnel.Max(x => x.Total) * 100;
                    <div class="ld-funnel-row @(_funnelSource == s.Source ? "ld-funnel-row--active" : "")"
                         @onclick="() => SelectFunnelSource(s.Source)"
                         role="button" tabindex="0">
                        <div class="ld-funnel-lbl">
                            <i class="bi @SourceIcon(s.Source)" aria-hidden="true"></i>
                            <span>@s.Source</span>
                        </div>
                        <div class="ld-funnel-bar-track">
                            <div class="ld-funnel-bar-fill" style="width:@pct.ToString("F1",System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                        <div class="ld-funnel-nums">
                            <span class="ld-funnel-total">@s.Total</span>
                            <span class="ld-funnel-conv @(s.ConvPct >= 20 ? "ld-conv--good" : s.ConvPct >= 10 ? "ld-conv--mid" : "ld-conv--low")">
                                @s.ConvPct.ToString("F0")% conv.
                            </span>
                        </div>
                    </div>
                }
            </div>

            <!-- Stage breakdown for selected source -->
            @if (!string.IsNullOrEmpty(_funnelSource))
            {
                var stages = _filtered.Where(x => x.Source == _funnelSource)
                                      .GroupBy(x => x.Stage)
                                      .Select(g => (Stage: g.Key, Count: g.Count()))
                                      .OrderBy(x => StageOrder(x.Stage))
                                      .ToList();
                <div class="ld-funnel-stages">
                    <h4 class="ld-funnel-stages-hdr">@_funnelSource — Stage Breakdown</h4>
                    <div class="ld-funnel-stage-bars">
                        @foreach (var sg in stages)
                        {
                            var maxC = stages.Max(s => s.Count);
                            var sp = maxC == 0 ? 0 : (double)sg.Count / maxC * 100;
                            <div class="ld-fstage-row">
                                <span class="@StageBadge(sg.Stage)" style="min-width:90px">@sg.Stage</span>
                                <div class="ld-fstage-track">
                                    <div class="ld-fstage-fill @StageFill(sg.Stage)" style="width:@sp.ToString("F1",System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                                <span class="ld-fstage-count">@sg.Count</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Right: source table -->
        <div class="ld-funnel-table-wrap">
            <h3 class="ld-section-hdr">Source Performance</h3>
            <SfGrid TValue="SourceRow"
                    DataSource="_sourceFunnel"
                    AllowSorting="true"
                    EnableHover="true"
                    RowHeight="48">
                <GridColumns>
                    <GridColumn Field="@nameof(SourceRow.Source)" HeaderText="Source" Width="160">
                        <Template>
                            @{ var s = (SourceRow)context; }
                            <span class="ld-source-badge">
                                <i class="bi @SourceIcon(s.Source)" aria-hidden="true"></i> @s.Source
                            </span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(SourceRow.Total)"     HeaderText="Total"    Width="80"  TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(SourceRow.Converted)" HeaderText="Conv."    Width="80"  TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(SourceRow.ConvPct)"   HeaderText="Conv. %"  Width="90"  TextAlign="TextAlign.Right">
                        <Template>
                            @{ var s = (SourceRow)context; }
                            <span class="@(s.ConvPct >= 20 ? "ld-conv--good" : s.ConvPct >= 10 ? "ld-conv--mid" : "ld-conv--low")">
                                @s.ConvPct.ToString("F1")%
                            </span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(SourceRow.AvgScore)"    HeaderText="Avg Score" Width="100" TextAlign="TextAlign.Right" />
                    <GridColumn Field="@nameof(SourceRow.AvgPremium)"  HeaderText="Avg Premium" Width="130" TextAlign="TextAlign.Right">
                        <Template>
                            @{ var s = (SourceRow)context; }
                            <span class="ld-mono">@s.AvgPremium.ToString("C0")</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(SourceRow.TotalPipeline)" HeaderText="Pipeline" Width="130" TextAlign="TextAlign.Right">
                        <Template>
                            @{ var s = (SourceRow)context; }
                            <span class="ld-mono ld-bold">@s.TotalPipeline.ToString("C0")</span>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    </div>
}

<!-- ════════════════════════════════════════════════════════════════════════
     VIEW: BY PRODUCER
     ════════════════════════════════════════════════════════════════════════ -->
@if (_view == "producer")
{
    <div class="ld-producer-layout">

        <!-- Producer leaderboard -->
        <div class="ld-producer-board">
            <h3 class="ld-section-hdr">Producer Leaderboard</h3>
            <div class="ld-producer-list">
                @{ int rank = 0; }
                @foreach (var p in _producerRows.OrderByDescending(x => x.Pipeline))
                {
                    rank++;
                    var maxPipe = _producerRows.Max(x => x.Pipeline);
                    var barPct  = maxPipe == 0 ? 0 : (double)p.Pipeline / (double)maxPipe * 100;
                    <div class="ld-producer-row @(_producerFilter == p.Owner ? "ld-producer-row--active" : "")"
                         @onclick="() => SelectProducer(p.Owner)"
                         role="button" tabindex="0">
                        <span class="ld-rank @(rank == 1 ? "ld-rank--gold" : rank == 2 ? "ld-rank--silver" : rank == 3 ? "ld-rank--bronze" : "")">
                            @rank
                        </span>
                        <div class="ld-producer-info">
                            <div class="ld-producer-name">@p.Owner</div>
                            <div class="ld-producer-bar-track">
                                <div class="ld-producer-bar-fill" style="width:@barPct.ToString("F1",System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                        </div>
                        <div class="ld-producer-stats">
                            <div class="ld-pstat">
                                <span class="ld-pstat-val">@p.Total</span>
                                <span class="ld-pstat-lbl">leads</span>
                            </div>
                            <div class="ld-pstat">
                                <span class="ld-pstat-val">@p.ConvPct.ToString("F0")%</span>
                                <span class="ld-pstat-lbl">conv.</span>
                            </div>
                            <div class="ld-pstat">
                                <span class="ld-pstat-val ld-mono">@p.Pipeline.ToString("C0")</span>
                                <span class="ld-pstat-lbl">pipeline</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Right: producer detail grid -->
        <div class="ld-producer-detail">
            <h3 class="ld-section-hdr">
                @if (!string.IsNullOrEmpty(_producerFilter))
                {
                    <span>@_producerFilter's Leads</span>
                    <button class="um-btn um-btn-ghost um-btn-sm" style="margin-left:.5rem" @onclick="() => _producerFilter = string.Empty">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                }
                else
                {
                    <span>All Producer Leads</span>
                }
            </h3>
            <div class="ld-grid-card app-datagrid">
                <SfGrid TValue="LeadRow"
                        DataSource="@ProducerFiltered()"
                        AllowPaging="true"
                        AllowSorting="true"
                        EnableHover="true"
                        RowHeight="52">
                    <GridPageSettings PageSize="20" PageSizes="@(new int[]{10,20,50})" />
                    <GridColumns>
                        <GridColumn HeaderText="Rating" Width="90" Field="@nameof(LeadRow.Rating)">
                            <Template>@{ var r = (LeadRow)context; }<span class="@RatingBadge(r.Rating)">@r.Rating</span></Template>
                        </GridColumn>
                        <GridColumn HeaderText="Lead" Width="200" Field="@nameof(LeadRow.FullName)">
                            <Template>
                                @{ var r = (LeadRow)context; }
                                <div class="ld-name-cell">
                                    <div class="ld-avatar @AvatarColor(r.FullName)">@Initials(r.FullName)</div>
                                    <div>
                                        <div class="ld-item-name">@r.FullName</div>
                                        <div class="ld-item-sub">@r.CompanyName</div>
                                    </div>
                                </div>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(LeadRow.Stage)"      HeaderText="Stage"    Width="130">
                            <Template>@{ var r = (LeadRow)context; }<span class="@StageBadge(r.Stage)">@r.Stage</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(LeadRow.Source)"     HeaderText="Source"   Width="120">
                            <Template>@{ var r = (LeadRow)context; }<span class="ld-source-badge"><i class="bi @SourceIcon(r.Source)" aria-hidden="true"></i> @r.Source</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(LeadRow.EstPremium)" HeaderText="Est. Premium" Width="130" TextAlign="TextAlign.Right">
                            <Template>@{ var r = (LeadRow)context; }<span class="ld-mono ld-bold">@r.EstPremium.ToString("C0")</span></Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(LeadRow.Score)"      HeaderText="Score"    Width="80"  TextAlign="TextAlign.Right" />
                        <GridColumn Field="@nameof(LeadRow.LastActivity)" HeaderText="Last Activity" Width="130">
                            <Template>
                                @{ var r = (LeadRow)context; }
                                <span class="@(r.DaysSinceActivity > 30 ? "ld-stale" : "")">
                                    @(r.LastActivity.HasValue ? r.LastActivity.Value.ToString("d") : "—")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn HeaderText="" Width="80" TextAlign="TextAlign.Right">
                            <Template>
                                @{ var r = (LeadRow)context; }
                                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenDetail(r)">
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
