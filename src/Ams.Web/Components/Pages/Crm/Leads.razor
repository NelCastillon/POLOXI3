<!-- ══════════════════════════════════════════════════════════
     DIALOG — Merge Duplicates
     ══════════════════════════════════════════════════════════ -->
<SfDialog @bind-Visible="_showMerge" Width="600px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="ld-dlg-hdr"><i class="bi bi-intersect" aria-hidden="true"></i> Merge Duplicates</span></Header>
        <Content>
            <div class="ld-merge-body">
                @if (_selected.Count < 2)
                {
                    <div class="ld-merge-warn">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        Select at least 2 leads in the grid before merging.
                    </div>
                }
                else
                {
                    <p class="ld-merge-intro">
                        Merging <strong>@_selected.Count leads</strong>. Choose the <em>master</em> record — all other records will be de-duplicated into it.
                    </p>
                    <div class="ld-merge-list">
                        @foreach (var r in _selected)
                        {
                            <label class="ld-merge-option @(_mergeTarget == r.LeadId.ToString() ? "ld-merge-option--active" : "")">
                                <input type="radio" name="merge-target" value="@r.LeadId"
                                       @onchange="() => _mergeTarget = r.LeadId.ToString()" />
                                <div class="ld-merge-card">
                                    <div class="ld-merge-name">@r.FullName</div>
                                    <div class="ld-merge-meta">@r.CompanyName · @r.Email · @r.Source</div>
                                    <div class="ld-merge-meta">Score: @r.Score · Stage: @r.Stage · Owner: @r.Owner</div>
                                </div>
                            </label>
                        }
                    </div>
                }
            </div>
        </Content>
        <FooterTemplate>
            <div class="ld-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showMerge = false">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="CommitMergeAsync"
                        disabled="@(string.IsNullOrEmpty(_mergeTarget) || _selected.Count < 2)">
                    <i class="bi bi-intersect" aria-hidden="true"></i> Merge into Master
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ══════════════════════════════════════════════════════════
     DIALOG — Convert to Opportunity  (confirmation)
