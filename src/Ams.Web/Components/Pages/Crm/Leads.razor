<!-- ── Detail slide-over ─────────────────────────────────────────────────── -->
@if (_detail is not null)
{
    <div class="ld-overlay" @onclick="() => _detail = null" role="button" tabindex="-1" aria-label="Close"></div>
    <div class="ld-detail-panel" role="complementary" aria-label="Lead detail">
        <div class="ld-detail-hdr">
            <span class="@RatingBadge(_detail.Rating)">@_detail.Rating</span>
            <span class="@StageBadge(_detail.Stage)">@_detail.Stage</span>
            <button class="um-btn um-btn-ghost um-btn-sm" style="margin-left:auto" @onclick="() => _detail = null">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div class="ld-detail-identity">
            <div class="ld-detail-avatar @AvatarColor(_detail.FullName)">@Initials(_detail.FullName)</div>
            <div>
                <h2 class="ld-detail-name">@_detail.FullName</h2>
                <div class="ld-detail-company">@_detail.CompanyName</div>
            </div>
        </div>
        <div class="ld-detail-body">
            @DetailRow("Source",      @<span class="ld-source-badge"><i class="bi @SourceIcon(_detail.Source)" aria-hidden="true"></i> @_detail.Source</span>)
            @DetailRow("Owner",       @<span>@_detail.Owner</span>)
            @DetailRow("Email",       @<span class="ld-mono">@_detail.Email</span>)
            @DetailRow("Phone",       @<span class="ld-mono">@_detail.Phone</span>)
            @DetailRow("Est. Premium",@<span class="ld-mono ld-bold">@_detail.EstPremium.ToString("C0")</span>)
            @DetailRow("Score",       @<div class="ld-score-wrap" style="max-width:120px"><div class="ld-score-bar" style="width:@_detail.Score%;background:@ScoreColor(_detail.Score)"></div><span class="ld-score-num">@_detail.Score</span></div>)
            @DetailRow("Created",     @<span class="ld-mono">@_detail.CreatedAt.ToString("d")</span>)
            @DetailRow("Last Activity",@<span class="@(_detail.DaysSinceActivity > 30 ? "ld-stale" : "ld-mono")">@(_detail.LastActivity.HasValue ? _detail.LastActivity.Value.ToString("d") : "—")</span>)
            @if (!string.IsNullOrEmpty(_detail.Notes)) { @DetailRow("Notes", @<p class="ld-detail-notes">@_detail.Notes</p>) }
        </div>
        <div class="ld-detail-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => { _selected.Clear(); _selected.Add(_detail!); _showAssign = true; }">
                <i class="bi bi-person-check" aria-hidden="true"></i> Assign
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => { _selected.Clear(); _selected.Add(_detail!); ConvertToOpportunityAsync(); }">
                <i class="bi bi-trophy" aria-hidden="true"></i> Convert
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => { _selected.Clear(); _selected.Add(_detail!); _showCampaign = true; }">
                <i class="bi bi-megaphone" aria-hidden="true"></i> Campaign
