@page "/crm/opportunities/board"
@namespace Ams.Web.Components.Pages.Crm
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Opportunity Board — CRM</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Opportunity Board"
               Subtitle="Manage opportunities across sales stages"
               Icon="bi-kanban">
    <Actions>
        <div class="op-board-controls">
            <SfDropDownList TValue="string" TItem="OwnerOption"
                            DataSource="_ownerOptions"
                            Placeholder="Filter by Owner"
                            ShowClearButton="true"
                            Width="160px"
                            Value="_filterOwner"
                            ValueChanged="@((string? v) => { _filterOwner = v; ApplyFilters(); })">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>

            <button class="um-btn um-btn-ghost" @onclick="LoadBoardAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "op-spin" : "")" aria-hidden="true"></i>
            </button>
            <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/crm/opportunities/new")'>
                <i class="bi bi-plus-lg" aria-hidden="true"></i> New Opportunity
            </button>
        </div>
    </Actions>
</AppPageHeader>

<div class="op-board-container">
    @if (_loading)
    {
        <div class="op-board-loading">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading board…</span>
        </div>
    }
    else
    {
        <div class="op-board-columns">
            @foreach (var stage in _stages)
            {
                var stageOpps = _opportunities
                    .Where(o => o.Stage == stage.Code)
                    .OrderByDescending(o => o.Amount)
                    .ToList();

                <div class="op-board-column" data-stage="@stage.Code">
                    <div class="op-board-header">
                        <div class="op-board-title">
                            <span class="op-stage-badge op-stage-@stage.Code.ToLower()">@stage.Label</span>
                            <span class="op-board-count">@stageOpps.Count</span>
                        </div>
                        <div class="op-board-stats">
                            <span class="op-board-stat">@stageOpps.Sum(o => o.Amount).ToString("C0")</span>
                        </div>
                    </div>

                    <div class="op-board-cards" @ondrop="@((Syncfusion.Blazor.Navigations.DragEventArgs e) => HandleDrop(e, stage.Code))"
                         @ondragover="@((Syncfusion.Blazor.Navigations.DragEventArgs e) => HandleDragOver(e))"
                         @ondragleave="@((Syncfusion.Blazor.Navigations.DragEventArgs e) => HandleDragLeave(e))">
                        @foreach (var opp in stageOpps)
                        {
                            <div class="op-board-card"
                                 draggable="true"
                                 @ondragstart="@((Syncfusion.Blazor.Navigations.DragEventArgs e) => HandleDragStart(e, opp))"
                                 @onclick='() => Nav.NavigateTo($"/crm/opportunities/{opp.Id}")'>
                                <div class="op-card-header">
                                    <span class="op-card-name">@opp.Name</span>
                                    @if (opp.WinProbability >= 75)
                                    {
                                        <span class="op-card-hot" title="Hot opportunity">
                                            <i class="bi bi-fire" aria-hidden="true"></i>
                                        </span>
                                    }
                                </div>

                                <div class="op-card-body">
                                    <p class="op-card-account">@opp.AccountName</p>
                                    <div class="op-card-meta">
                                        <span class="op-card-amount">@opp.Amount.ToString("C0")</span>
                                        <span class="op-card-prob" style="background: @GetWinProbabilityColor(opp.WinProbability);">
                                            @opp.WinProbability%
                                        </span>
                                    </div>
                                </div>

                                <div class="op-card-footer">
                                    <span class="op-card-owner">@(opp.OwnerInitials ?? "U")</span>
                                    <span class="op-card-close">
                                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                                        @opp.CloseDate.ToString("M/d")
                                    </span>
                                </div>
                            </div>
                        }

                        @if (stageOpps.Count == 0)
                        {
                            <div class="op-board-empty">
                                <i class="bi bi-inbox" aria-hidden="true"></i>
                                <p>No opportunities</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private record OpportunityCard(
        Guid Id,
        string Name,
        string AccountName,
        decimal Amount,
        int WinProbability,
        DateTime CloseDate,
        string Stage,
        string? OwnerInitials
    );

    private record StageOption(string Code, string Label, int Order);
    private record OwnerOption(string Value, string Label);

    private SfToast _toast = null!;
    private bool _loading = false;
    private string? _filterOwner;
    private List<OpportunityCard> _opportunities = [];
    private List<StageOption> _stages =
    [
        new("Qualified", "Qualified", 0),
        new("Proposal", "Proposal", 1),
        new("Negotiation", "Negotiation", 2),
        new("ClosedWon", "Closed Won", 3),
        new("ClosedLost", "Closed Lost", 4),
    ];

    private List<OwnerOption> _ownerOptions = [];
    private OpportunityCard? _draggedCard;

    protected override async Task OnInitializedAsync()
    {
        await LoadBoardAsync();
        Breadcrumbs.SetBreadcrumb("Opportunity Board", "/crm/opportunities/board");
    }

    private async Task LoadBoardAsync()
    {
        _loading = true;
        try
        {
            var result = await Api.GetAsync<List<OpportunityCard>>("api/opportunities/board");
            if (result?.Success == true)
            {
                _opportunities = result.Data ?? [];
                await LoadOwnerFilters();
            }
        }
        catch (Exception ex)
        {
            await ShowToast("Error", ex.Message, "Error");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadOwnerFilters()
    {
        try
        {
            _ownerOptions = _opportunities
                .Select(o => o.OwnerInitials)
                .Where(o => o != null)
                .Distinct()
                .OrderBy(o => o)
                .Select(o => new OwnerOption(o ?? "", o ?? "Unknown"))
                .ToList();
        }
        catch { }
    }

    private void ApplyFilters()
    {
        // Filters are applied in rendering through LINQ
    }

    private void HandleDragStart(Syncfusion.Blazor.Navigations.DragEventArgs e, OpportunityCard card)
    {
        _draggedCard = card;
        if (e.DataTransfer != null)
            e.DataTransfer.DropEffect = "move";
    }

    private void HandleDragOver(Syncfusion.Blazor.Navigations.DragEventArgs e)
    {
        e.preventDefault();
        if (e.DataTransfer != null)
            e.DataTransfer.DropEffect = "move";
    }

    private void HandleDragLeave(Syncfusion.Blazor.Navigations.DragEventArgs e)
    {
        e.preventDefault();
    }

    private async Task HandleDrop(Syncfusion.Blazor.Navigations.DragEventArgs e, string targetStage)
    {
        e.preventDefault();
        if (_draggedCard == null) return;

        try
        {
            var result = await Api.PutAsync<bool>(
                $"api/opportunities/{_draggedCard.Id}/stage",
                new { stage = targetStage }
            );

            if (result?.Success == true)
            {
                await LoadBoardAsync();
                await ShowToast("Success", $"Opportunity moved to {targetStage}", "Success");
            }
        }
        catch (Exception ex)
        {
            await ShowToast("Error", ex.Message, "Error");
        }
        finally
        {
            _draggedCard = null;
        }
    }

    private string GetWinProbabilityColor(int probability)
    {
        return probability switch
        {
            >= 75 => "#22c55e",     // Green
            >= 50 => "#3b82f6",     // Blue
            >= 25 => "#f59e0b",     // Amber
            _ => "#ef4444"          // Red
        };
    }

    private async Task ShowToast(string title, string message, string cssClass)
    {
        if (_toast != null)
        {
            await _toast.ShowAsync(new ToastModel
            {
                Title = title,
                Content = message,
                CssClass = cssClass
            });
        }
    }
}
