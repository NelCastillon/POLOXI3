@page "/crm/opportunities/board"
@namespace Ams.Web.Components.Pages.Crm
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Opportunity Board — CRM</PageTitle>

<AppPageHeader Title="Opportunity Board"
               Subtitle="Manage opportunities across sales stages"
               Icon="bi-kanban">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/crm/opportunities/new")'>
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Opportunity
        </button>
    </Actions>
</AppPageHeader>

<div class="op-board-container">
    <div class="op-board-placeholder">
        <i class="bi bi-kanban" aria-hidden="true" style="font-size: 3rem; color: #d1d5db;"></i>
        <p>Opportunity Board View</p>
        <p style="font-size: 0.875rem; color: #9ca3af;">Kanban-style board for managing opportunities by stage</p>
        <button class="um-btn um-btn-secondary" @onclick='() => Nav.NavigateTo("/crm/opportunities")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Opportunities
        </button>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new BreadcrumbService.BreadcrumbItem("Opportunity Board"));
    }
}
