@page "/crm/opportunities/board"
@namespace Ams.Web.Components.Pages.Crm
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos

<PageTitle>Opportunity Board — CRM</PageTitle>

<AppPageHeader Title="Opportunity Board" Subtitle="Kanban board for managing opportunity stages" Icon="bi-kanban"><Actions><button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/crm/opportunities/new")'><i class="bi bi-plus-lg"></i> New Opportunity</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<section class="ma-hero opp-hero"><div><span class="ma-eyebrow">CRM · Opportunities</span><h2>Opportunity Board</h2><p>Move from qualification to close with a stage-based sales workflow while preserving existing opportunity navigation.</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities")'><i class="bi bi-list-ul"></i> Directory</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities/pipeline")'><i class="bi bi-funnel"></i> Pipeline</button></div></section>
<div class="pc-kpi-strip opp-kpi-strip"><div class="pc-kpi-card"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-trophy"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Opportunities</div></div></div><div class="pc-kpi-card"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-cash-coin"></i></span><div><div class="pc-kpi-value">@_items.Sum(x => x.EstimatedAmount).ToString("C0")</div><div class="pc-kpi-label">Pipeline</div></div></div><div class="pc-kpi-card"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-graph-up-arrow"></i></span><div><div class="pc-kpi-value">@_items.Sum(x => x.WeightedAmount).ToString("C0")</div><div class="pc-kpi-label">Weighted</div></div></div></div>
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }
@if (_loading) { <div class="mt-loading"><div class="um-spinner"></div><span>Loading opportunity board…</span></div> }
else { <div class="opp-board-columns">@foreach (var stage in OpportunityPageConstants.Stages) { var rows = _items.Where(x => x.Stage == stage).ToList(); <section class="opp-board-col"><header><span class="@OpportunityPageConstants.StageBadge(stage)">@stage</span><strong>@rows.Count</strong></header><div class="opp-board-list">@foreach (var row in rows) { <article class="opp-board-card" @onclick='() => Nav.NavigateTo($"/crm/opportunities/{row.OpportunityId}")'><div class="opp-board-card-top"><strong>@row.OpportunityName</strong><span class="@OpportunityPageConstants.ForecastBadge(row.ForecastCategory)">@row.ForecastCategory</span></div><div class="text-muted">@row.AccountName</div><div class="opp-board-card-meta"><span>@row.EstimatedAmount.ToString("C0")</span><span>@row.WinProbability.ToString("F0")%</span></div><div class="opp-win-track"><span style="width:@row.WinProbability.ToString("F0")%"></span></div><div class="text-muted"><i class="bi bi-calendar3"></i> @(row.CloseDate?.ToString("d") ?? "No close date")</div></article> }</div></section> }</div> }
@code { List<OpportunityRow> _items = []; string? _loadError; bool _loading; protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("CRM", "/crm/opportunities"), new("Opportunity Board")); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchOpportunitiesAsync(OpportunityPageConstants.TenantId); _items = (result?.Items ?? []).Select(OpportunityPageData.FromDto).OrderBy(x => OpportunityPageConstants.StageOrder(x.Stage)).ThenByDescending(x => x.EstimatedAmount).ToList(); } catch (Exception ex) { _loadError = $"Failed to load opportunity board: {ex.Message}"; } finally { _loading = false; } } }
