@page "/crm/pricing-rules"
@namespace Ams.Web.Components.Pages.Crm
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@using Ams.Application.Features.PricingRules

<PageTitle>Pricing Rules — CRM</PageTitle>

<AppPageHeader Title="Pricing Rules"
               Subtitle="Tenant admin controls for service discounts, segment pricing, approvals, and effective dates"
               Icon="bi-tags-fill">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Pricing Rule
        </button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
    </Actions>
</AppPageHeader>

<section class="ma-hero pmr-hero">
    <div>
        <span class="ma-eyebrow">Pricing & Market Rules</span>
        <h2>Pricing Rule Command Center</h2>
        <p>Manage discount schedules, segment offers, approval gates, and effective windows from a single tenant admin workspace.</p>
    </div>
    <div class="ma-hero-actions">
        <button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> Add Pricing Rule</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </div>
</section>

<div class="ma-view-tabs pmr-view-tabs">
    <button class="ma-view-tab ma-view-tab--active"><i class="bi bi-tags"></i> Pricing Rules</button>
    <button class="ma-view-tab" @onclick='() => Nav.NavigateTo("/crm/pricing/classes")'><i class="bi bi-diagram-3"></i> Price by Class</button>
    <button class="ma-view-tab" @onclick='() => Nav.NavigateTo("/crm/appetite")'><i class="bi bi-grid-3x3"></i> Market Appetite</button>
    <button class="ma-view-tab" @onclick='() => Nav.NavigateTo("/crm/carrier-mapping")'><i class="bi bi-broadcast"></i> Carrier Mapping</button>
</div>

<div class="pc-kpi-strip">
    <div class="pc-kpi-card @(_activeFilter == null ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter(null)' title="Show all pricing rules">
        <span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-tags-fill" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total Rules</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "active" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("active")' title="Filter: Active rules">
        <span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.IsActive)</div><div class="pc-kpi-label">Active</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "approval" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("approval")' title="Filter: Requires approval">
        <span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.RequiresApproval)</div><div class="pc-kpi-label">Needs Approval</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "promo" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("promo")' title="Filter: Promotional rules">
        <span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-percent" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.RuleTypeCode.Equals("PROMO", StringComparison.OrdinalIgnoreCase))</div><div class="pc-kpi-label">Promotional</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "expired" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("expired")' title="Filter: Expired rules">
        <span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-calendar-x" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(IsExpired)</div><div class="pc-kpi-label">Expired</div></div>
    </div>
</div>

<div class="ma-filter-bar pmr-filter-bar">
    <div class="ma-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="ma-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search code, name, type, service, segment…" />
    </div>
    <div class="ma-type-pills">
        <button class="ma-pill @(_activeFilter is null ? "ma-pill-active" : "")" @onclick='() => SetFilter(null)'>All</button>
        <button class="ma-pill @(_activeFilter == "active" ? "ma-pill-active" : "")" @onclick='() => SetFilter("active")'>Active</button>
        <button class="ma-pill @(_activeFilter == "approval" ? "ma-pill-active" : "")" @onclick='() => SetFilter("approval")'>Approval</button>
        <button class="ma-pill @(_activeFilter == "promo" ? "ma-pill-active" : "")" @onclick='() => SetFilter("promo")'>Promo</button>
        <button class="ma-pill @(_activeFilter == "expired" ? "ma-pill-active" : "")" @onclick='() => SetFilter("expired")'>Expired</button>
    </div>
    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button>
    <span class="ma-filter-count">@_filtered.Count rules</span>
</div>

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

<div class="um-grid-card">
    @if (_loading)
    {
        <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading pricing rules…</span></div>
    }
    <SfGrid TValue="PricingRuleDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
        <GridEvents TValue="PricingRuleDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" />
        <GridColumns>
            <GridColumn Field="RuleCode" HeaderText="Code" Width="120" />
            <GridColumn Field="RuleName" HeaderText="Rule Name" Width="230" />
            <GridColumn Field="RuleTypeCode" HeaderText="Type" Width="120">
                <Template>
                    @{ var r = (PricingRuleDto)context; }
                    <span class="um-badge um-badge-info">@r.RuleTypeCode</span>
                </Template>
            </GridColumn>
            <GridColumn Field="ServiceCode" HeaderText="Service" Width="120">
                <Template>
                    @{ var r = (PricingRuleDto)context; }
                    <span>@(string.IsNullOrWhiteSpace(r.ServiceCode) ? "—" : r.ServiceCode)</span>
                </Template>
            </GridColumn>
            <GridColumn Field="SegmentCode" HeaderText="Segment" Width="130">
                <Template>
                    @{ var r = (PricingRuleDto)context; }
                    <span>@(string.IsNullOrWhiteSpace(r.SegmentCode) ? "—" : r.SegmentCode)</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Discount" Width="100" TextAlign="TextAlign.Right">
                <Template>
                    @{ var r = (PricingRuleDto)context; }
                    <strong>@r.DiscountPercent.ToString("0.##")%</strong>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Effective" Width="170">
                <Template>
                    @{ var r = (PricingRuleDto)context; }
                    <span>@r.EffectiveStartDate.ToString("MMM d, yyyy")</span>
                    <span class="text-muted"> — @(r.EffectiveEndDate?.ToString("MMM d, yyyy") ?? "Open")</span>
                </Template>
            </GridColumn>
            <GridColumn Field="Priority" HeaderText="Priority" Width="90" TextAlign="TextAlign.Center" />
            <GridColumn HeaderText="Status" Width="110" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (PricingRuleDto)context; }
                    <span class="um-badge @(r.IsActive ? "um-badge-success" : "um-badge-neutral")">@(r.IsActive ? "Active" : "Inactive")</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Approval" Width="115" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (PricingRuleDto)context; }
                    <span class="um-badge @(r.RequiresApproval ? "um-badge-warning" : "um-badge-neutral")">@(r.RequiresApproval ? "Required" : "None")</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Actions" Width="110" TextAlign="TextAlign.Center">
                <Template>
                    @{ var r = (PricingRuleDto)context; }
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(r)" @onclick:stopPropagation="true" title="Edit"><i class="bi bi-pencil"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDelete(r)" @onclick:stopPropagation="true" title="Delete"><i class="bi bi-trash"></i></button>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showForm" Width="760px" IsModal="true" ShowCloseIcon="false">
    <DialogEvents Closed="ResetForm" />
    <DialogContent>
        <div class="um-modal-header">
            <i class="bi bi-tags-fill"></i>
            <span>@(_editId.HasValue ? "Edit Pricing Rule" : "Add Pricing Rule")</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button>
        </div>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="um-field">
                        <label>Rule Code <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.RuleCode" class="um-input" placeholder="e.g. VOL-10" />
                        <ValidationMessage For="() => _form.RuleCode" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Rule Name <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.RuleName" class="um-input" placeholder="e.g. Volume discount" />
                        <ValidationMessage For="() => _form.RuleName" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Rule Type <span class="text-danger">*</span></label>
                        <SfDropDownList TValue="string" TItem="string" @bind-Value="_form.RuleTypeCode" DataSource="_ruleTypes" Placeholder="Select type" />
                        <ValidationMessage For="() => _form.RuleTypeCode" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Service Code</label>
                        <InputText @bind-Value="_form.ServiceCode" class="um-input" placeholder="Optional service" />
                        <ValidationMessage For="() => _form.ServiceCode" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Segment Code</label>
                        <InputText @bind-Value="_form.SegmentCode" class="um-input" placeholder="Optional segment" />
                        <ValidationMessage For="() => _form.SegmentCode" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Minimum Quantity</label>
                        <InputNumber @bind-Value="_form.MinQuantity" class="um-input" />
                        <ValidationMessage For="() => _form.MinQuantity" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Maximum Quantity</label>
                        <InputNumber @bind-Value="_form.MaxQuantity" class="um-input" />
                        <ValidationMessage For="() => _form.MaxQuantity" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Discount Percent <span class="text-danger">*</span></label>
                        <InputNumber @bind-Value="_form.DiscountPercent" class="um-input" />
                        <ValidationMessage For="() => _form.DiscountPercent" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Adjusted Unit Price</label>
                        <InputNumber @bind-Value="_form.AdjustedUnitPrice" class="um-input" />
                        <ValidationMessage For="() => _form.AdjustedUnitPrice" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Effective Start <span class="text-danger">*</span></label>
                        <InputDate @bind-Value="_form.EffectiveStartDate" class="um-input" />
                        <ValidationMessage For="() => _form.EffectiveStartDate" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Effective End</label>
                        <InputDate @bind-Value="_form.EffectiveEndDate" class="um-input" />
                        <ValidationMessage For="() => _form.EffectiveEndDate" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Priority <span class="text-danger">*</span></label>
                        <InputNumber @bind-Value="_form.Priority" class="um-input" />
                        <ValidationMessage For="() => _form.Priority" class="text-danger" />
                    </div>
                    <div class="um-field um-field--checkbox">
                        <label><InputCheckbox @bind-Value="_form.IsActive" /> Active</label>
                    </div>
                    <div class="um-field um-field--checkbox">
                        <label><InputCheckbox @bind-Value="_form.RequiresApproval" /> Requires Approval</label>
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">
                    @if (_saving) { <span class="um-spinner-sm"></span> } @(_editId.HasValue ? "Save Changes" : "Create")
                </button>
            </div>
        </EditForm>
    </DialogContent>
</SfDialog>

<SfDialog @bind-Visible="_showDelete" Width="440px" IsModal="true" ShowCloseIcon="false">
    <DialogContent>
        <div class="um-confirm-dialog">
            <div class="um-confirm-icon um-confirm-icon--danger">
                <i class="bi bi-trash3-fill"></i>
            </div>
            <div class="um-confirm-message">
                <h6>Delete Pricing Rule?</h6>
                <p>You are about to delete <strong>@_deleteTarget?.RuleName</strong>. This action cannot be undone.</p>
            </div>
            <div class="um-modal-footer w-100">
                <button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button>
            </div>
        </div>
    </DialogContent>
</SfDialog>

<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />

@code {
    static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    readonly string[] _ruleTypes = ["VOLUME", "SEGMENT", "TIERED", "PROMO", "DISCOUNT"];

    List<PricingRuleDto> _items = [], _filtered = [];
    string? _activeFilter;
    bool _loading, _saving;
    string _search = string.Empty;
    string? _loadError;
    bool _showForm, _showDelete;
    Guid? _editId;
    PricingRuleDto? _deleteTarget;
    SfToast _toast = default!;
    PricingRuleFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", null), new("Pricing Rules", "/crm/pricing-rules"));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchPricingRulesAsync(TenantId, pageSize: 200);
            _items = result?.Items.ToList() ?? [];
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load pricing rules: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    void ApplyFilter()
    {
        var rows = _activeFilter switch
        {
            "active" => _items.Where(x => x.IsActive),
            "approval" => _items.Where(x => x.RequiresApproval),
            "promo" => _items.Where(x => x.RuleTypeCode.Equals("PROMO", StringComparison.OrdinalIgnoreCase)),
            "expired" => _items.Where(IsExpired),
            _ => _items.AsEnumerable()
        };

        _filtered = rows.Where(SearchMatches).ToList();
    }

    void SetFilter(string? key) { _activeFilter = key; ApplyFilter(); }
    void ResetFilters() { _activeFilter = null; _search = string.Empty; ApplyFilter(); }
    void OnRowSelected(RowSelectEventArgs<PricingRuleDto> args) => OpenEdit(args.Data);
    static bool IsExpired(PricingRuleDto item) => item.EffectiveEndDate.HasValue && item.EffectiveEndDate.Value.Date < DateTime.Today;
    bool SearchMatches(PricingRuleDto item)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        var q = _search.Trim();
        return item.RuleCode.Contains(q, StringComparison.OrdinalIgnoreCase)
            || item.RuleName.Contains(q, StringComparison.OrdinalIgnoreCase)
            || item.RuleTypeCode.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (item.ServiceCode?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || (item.SegmentCode?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    void OpenCreate()
    {
        _editId = null;
        _form = new();
        _showForm = true;
    }

    void OpenEdit(PricingRuleDto item)
    {
        _editId = item.PricingRuleId;
        _form = new()
        {
            RuleCode = item.RuleCode,
            RuleName = item.RuleName,
            RuleTypeCode = item.RuleTypeCode,
            ServiceCode = item.ServiceCode,
            SegmentCode = item.SegmentCode,
            MinQuantity = item.MinQuantity,
            MaxQuantity = item.MaxQuantity,
            DiscountPercent = item.DiscountPercent,
            AdjustedUnitPrice = item.AdjustedUnitPrice,
            EffectiveStartDate = item.EffectiveStartDate.Date,
            EffectiveEndDate = item.EffectiveEndDate?.Date,
            RequiresApproval = item.RequiresApproval,
            Priority = item.Priority,
            IsActive = item.IsActive
        };
        _showForm = true;
    }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_editId.HasValue)
            {
                await Api.UpdatePricingRuleAsync(_editId.Value, new UpdatePricingRuleRequest
                {
                    RuleCode = _form.RuleCode,
                    RuleName = _form.RuleName,
                    RuleTypeCode = _form.RuleTypeCode,
                    ServiceCode = Normalize(_form.ServiceCode),
                    SegmentCode = Normalize(_form.SegmentCode),
                    MinQuantity = _form.MinQuantity,
                    MaxQuantity = _form.MaxQuantity,
                    DiscountPercent = _form.DiscountPercent,
                    AdjustedUnitPrice = _form.AdjustedUnitPrice,
                    EffectiveStartDate = _form.EffectiveStartDate,
                    EffectiveEndDate = _form.EffectiveEndDate,
                    RequiresApproval = _form.RequiresApproval,
                    Priority = _form.Priority,
                    IsActive = _form.IsActive
                });
            }
            else
            {
                await Api.CreatePricingRuleAsync(new CreatePricingRuleRequest
                {
                    TenantId = TenantId,
                    RuleCode = _form.RuleCode,
                    RuleName = _form.RuleName,
                    RuleTypeCode = _form.RuleTypeCode,
                    ServiceCode = Normalize(_form.ServiceCode),
                    SegmentCode = Normalize(_form.SegmentCode),
                    MinQuantity = _form.MinQuantity,
                    MaxQuantity = _form.MaxQuantity,
                    DiscountPercent = _form.DiscountPercent,
                    AdjustedUnitPrice = _form.AdjustedUnitPrice,
                    EffectiveStartDate = _form.EffectiveStartDate,
                    EffectiveEndDate = _form.EffectiveEndDate,
                    RequiresApproval = _form.RequiresApproval,
                    Priority = _form.Priority
                });
            }

            _showForm = false;
            await _toast.ShowAsync(new() { Content = "Pricing rule saved", CssClass = "e-toast-success" });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
        finally
        {
            _saving = false;
        }
    }

    void ConfirmDelete(PricingRuleDto item) { _deleteTarget = item; _showDelete = true; }

    async Task ExecuteDeleteAsync()
    {
        _saving = true;
        try
        {
            await Api.DeletePricingRuleAsync(_deleteTarget!.PricingRuleId);
            _showDelete = false;
            await _toast.ShowAsync(new() { Content = "Pricing rule deleted", CssClass = "e-toast-success" });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
        finally
        {
            _saving = false;
        }
    }

    void ResetForm() { _form = new(); _editId = null; }
    static string? Normalize(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    sealed class PricingRuleFormModel
    {
        [Required(ErrorMessage = "Rule Code is required.")]
        [StringLength(80, ErrorMessage = "Rule Code cannot exceed 80 characters.")]
        public string RuleCode { get; set; } = string.Empty;

        [Required(ErrorMessage = "Rule Name is required.")]
        [StringLength(200, ErrorMessage = "Rule Name cannot exceed 200 characters.")]
        public string RuleName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Rule Type is required.")]
        [StringLength(50, ErrorMessage = "Rule Type cannot exceed 50 characters.")]
        public string RuleTypeCode { get; set; } = "VOLUME";

        [StringLength(80, ErrorMessage = "Service Code cannot exceed 80 characters.")]
        public string? ServiceCode { get; set; }

        [StringLength(80, ErrorMessage = "Segment Code cannot exceed 80 characters.")]
        public string? SegmentCode { get; set; }

        [Range(0, 999999999, ErrorMessage = "Minimum Quantity must be 0 or greater.")]
        public decimal? MinQuantity { get; set; }

        [Range(0, 999999999, ErrorMessage = "Maximum Quantity must be 0 or greater.")]
        public decimal? MaxQuantity { get; set; }

        [Range(0, 100, ErrorMessage = "Discount Percent must be between 0 and 100.")]
        public decimal DiscountPercent { get; set; }

        [Range(0, 999999999, ErrorMessage = "Adjusted Unit Price must be 0 or greater.")]
        public decimal? AdjustedUnitPrice { get; set; }

        [Required(ErrorMessage = "Effective Start is required.")]
        public DateTime EffectiveStartDate { get; set; } = DateTime.Today;

        public DateTime? EffectiveEndDate { get; set; }
        public bool RequiresApproval { get; set; }

        [Range(0, int.MaxValue, ErrorMessage = "Priority must be 0 or greater.")]
        public int Priority { get; set; } = 10;

        public bool IsActive { get; set; } = true;
    }
}
