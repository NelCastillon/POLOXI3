@page "/crm/lead-activities"
@namespace Ams.Web.Components.Pages.Crm
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.LeadActivities
@using System.ComponentModel.DataAnnotations

<PageTitle>Lead Activities — CRM</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Lead Activities"
               Subtitle="Log and track every call, meeting, email and task against your leads and opportunities"
               Icon="bi-lightning-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "la-spin" : "")" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Log Activity
        </button>
    </Actions>
</AppPageHeader>

<!-- ── KPI strip ─────────────────────────────────────────────────────────── -->
<div class="la-kpi-strip">
    <div class="la-kpi-card">
        <span class="la-ki la-ki1"><i class="bi bi-lightning-fill" aria-hidden="true"></i></span>
        <div><div class="la-kv">@_items.Count</div><div class="la-kl">Total Activities</div></div>
    </div>
    <div class="la-kpi-card">
        <span class="la-ki la-ki2"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
        <div><div class="la-kv">@_items.Count(x => x.IsCompleted)</div><div class="la-kl">Completed</div></div>
    </div>
    <div class="la-kpi-card">
        <span class="la-ki la-ki3"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span>
        <div><div class="la-kv">@_items.Count(x => !x.IsCompleted)</div><div class="la-kl">Open</div></div>
    </div>
    <div class="la-kpi-card">
        <span class="la-ki la-ki4"><i class="bi bi-telephone" aria-hidden="true"></i></span>
        <div><div class="la-kv">@_items.Count(x => x.ActivityTypeCode == "Call")</div><div class="la-kl">Calls</div></div>
    </div>
    <div class="la-kpi-card">
        <span class="la-ki la-ki5"><i class="bi bi-clock" aria-hidden="true"></i></span>
        <div><div class="la-kv">@(_items.Where(x => x.DurationMinutes.HasValue).Sum(x => x.DurationMinutes!.Value))</div><div class="la-kl">Total Minutes</div></div>
    </div>
</div>

<!-- ── Filter bar ────────────────────────────────────────────────────────── -->
<div class="la-filter-bar">
    <div class="la-search-wrap">
        <i class="bi bi-search la-si" aria-hidden="true"></i>
        <input class="la-search" type="search" placeholder="Search activities…"
               value="@_search"
               @oninput="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => { _search = e.Value?.ToString() ?? string.Empty; ApplyFilters(); })" />
    </div>
    <SfDropDownList TValue="string" TItem="LV" DataSource="_typeOpts" Placeholder="All Types" ShowClearButton="true" Width="140px"
                    Value="_filterType" ValueChanged="@((string v) => { _filterType = v; ApplyFilters(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>
    <SfDropDownList TValue="string" TItem="LV" DataSource="_outcomeOpts" Placeholder="All Outcomes" ShowClearButton="true" Width="150px"
                    Value="_filterOutcome" ValueChanged="@((string v) => { _filterOutcome = v; ApplyFilters(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>
    <SfDropDownList TValue="string" TItem="LV" DataSource="_completedOpts" Placeholder="Any Status" ShowClearButton="true" Width="140px"
                    Value="_filterCompleted" ValueChanged="@((string v) => { _filterCompleted = v; ApplyFilters(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>
</div>

<!-- ── Grid ─────────────────────────────────────────────────────────────── -->
@if (_loading)
{
    <div class="la-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading activities…</span></div>
}
else
{
    <div class="app-datagrid">
        <SfGrid TValue="LeadActivityDto"
                DataSource="_filtered"
                AllowPaging="true"
                AllowSorting="true"
                AllowFiltering="true"
                EnableHover="true"
                RowHeight="52">
            <GridEvents TValue="LeadActivityDto" RowSelected="OnRowSelected" />
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
            <GridPageSettings PageSize="25" PageSizes="@(new int[]{10,25,50,100})" />
            <GridColumns>
                <GridColumn HeaderText="Type" Width="120" Field="@nameof(LeadActivityDto.ActivityTypeCode)">
                    <Template>
                        @{ var r = (LeadActivityDto)context; }
                        <span class="la-type-badge la-type-@r.ActivityTypeCode.ToLower()">
                            <i class="bi @TypeIcon(r.ActivityTypeCode)" aria-hidden="true"></i> @r.ActivityTypeCode
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(LeadActivityDto.Subject)" HeaderText="Subject" Width="240" />
                <GridColumn Field="@nameof(LeadActivityDto.LeadName)" HeaderText="Lead" Width="180" />
                <GridColumn Field="@nameof(LeadActivityDto.ProducerName)" HeaderText="Producer" Width="170">
                    <Template>
                        @{ var r = (LeadActivityDto)context; }
                        <span>@(string.IsNullOrWhiteSpace(r.ProducerName) ? "Unassigned" : r.ProducerName)</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(LeadActivityDto.ActivityDate)" HeaderText="Date" Width="140" Type="ColumnType.DateTime" Format="yMd" />
                <GridColumn Field="@nameof(LeadActivityDto.DurationMinutes)" HeaderText="Duration" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                    <Template>
                        @{ var r = (LeadActivityDto)context; }
                        <span>@(r.DurationMinutes.HasValue ? r.DurationMinutes + " min" : "—")</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Status" Width="120">
                    <Template>
                        @{ var r = (LeadActivityDto)context; }
                        <span class="@(r.IsCompleted ? "la-status-completed" : "la-status-open")">
                            @(r.IsCompleted ? "✓ Completed" : "◆ Open")
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Actions" Width="130" AllowFiltering="false" AllowSorting="false" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                    <Template>
                        @{ var r = (LeadActivityDto)context; }
                        <div class="la-actions">
                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(r)" @onclick:stopPropagation="true" title="Edit activity">
                                <i class="bi bi-pencil" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ConfirmDelete(r)" @onclick:stopPropagation="true" title="Delete activity">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </div>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
}

<!-- ── Add/Edit Drawer ──────────────────────────────────────────────────── -->
<AppCrudDrawer @bind-Visible="_showAdd" 
               Title="@(_editingId == Guid.Empty ? "Log New Activity" : "Edit Activity")"
               Icon="bi-lightning"
               OnConfirm="SaveAsync" 
               IsBusy="_saving"
               Width="420px">
    <Content>
        @if (_formErrors.Count > 0)
        {
            <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
                Please correct the validation errors below.
            </div>
        }
        <div class="form-row">
            <label class="form-label">Activity Type <span class="form-required">*</span></label>
            <SfDropDownList TValue="string" TItem="LV"
                            DataSource="_typeOpts"
                            @bind-Value="_form.ActivityTypeCode"
                            Placeholder="Select type">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>
            @FieldError(nameof(ActivityForm.ActivityTypeCode))
        </div>
        <div class="form-row">
            <label class="form-label">Lead <span class="form-required">*</span></label>
            <SfDropDownList TValue="Guid" TItem="LeadOption"
                            DataSource="_leadOptions"
                            @bind-Value="_form.LeadId"
                            Placeholder="Select lead"
                            AllowFiltering="true">
                <DropDownListFieldSettings Value="Id" Text="Display" />
            </SfDropDownList>
            @FieldError(nameof(ActivityForm.LeadId))
        </div>
        <div class="form-row">
            <label class="form-label">Subject <span class="form-required">*</span></label>
            <input type="text" class="form-control" placeholder="Activity subject" @bind="_form.Subject" />
            @FieldError(nameof(ActivityForm.Subject))
        </div>
        <div class="form-row">
            <label class="form-label">Activity Date <span class="form-required">*</span></label>
            <SfDatePicker TValue="DateTime" @bind-Value="_form.ActivityDate"></SfDatePicker>
            @FieldError(nameof(ActivityForm.ActivityDate))
        </div>
        <div class="form-row">
            <label class="form-label">Duration (minutes)</label>
            <input type="number" class="form-control" placeholder="0" @bind="_form.DurationMinutes" />
            @FieldError(nameof(ActivityForm.DurationMinutes))
        </div>
        <div class="form-row">
            <label class="form-label">Outcome</label>
            <SfDropDownList TValue="string" TItem="LV"
                            DataSource="_outcomeOpts"
                            @bind-Value="_form.OutcomeCode"
                            Placeholder="Select outcome"
                            ShowClearButton="true">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>
            @FieldError(nameof(ActivityForm.OutcomeCode))
        </div>
        <div class="form-row la-checkbox-row">
            <label class="la-checkbox-label">
                <input type="checkbox" @bind="_form.IsCompleted" />
                <span>Mark activity completed</span>
            </label>
        </div>
        <div class="form-row">
            <label class="form-label">Notes</label>
            <textarea class="form-control" rows="3" placeholder="Additional notes…" @bind="_form.Notes"></textarea>
            @FieldError(nameof(ActivityForm.Notes))
        </div>
    </Content>
</AppCrudDrawer>

<SfDialog @bind-Visible="_showDeleteConfirm" Width="420px" IsModal="true" ShowCloseIcon="false">
    <DialogContent>
        <div class="um-confirm-dialog">
            <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash3-fill"></i></div>
            <div class="um-confirm-title">Delete Activity</div>
            <div class="um-confirm-body">Delete <strong>@_deleteTarget?.Subject</strong>?</div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showDeleteConfirm = false">Cancel</button>
                <button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync">Delete</button>
            </div>
        </div>
    </DialogContent>
</SfDialog>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private SfToast? _toast;
    private List<LeadActivityDto> _items = [];
    private List<LeadActivityDto> _filtered = [];
    private List<LeadOption> _leadOptions = [];
    private List<LV> _typeOpts = [];
    private List<LV> _outcomeOpts = [];
    private List<LV> _completedOpts = [];
    private string _search = string.Empty;
    private string _filterType = string.Empty;
    private string _filterOutcome = string.Empty;
    private string _filterCompleted = string.Empty;
    private bool _loading = false;
    private bool _saving = false;
    private bool _showAdd = false;
    private bool _showDeleteConfirm;
    private Guid _editingId = Guid.Empty;
    private LeadActivityDto? _deleteTarget;
    private ActivityForm _form = new();
    private readonly Dictionary<string, string> _formErrors = new();

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/lead-activities"), new("Lead Activities", "/crm/lead-activities"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;
            var leadsResult = await Api.SearchLeadsAsync(_tenantId);
            _leadOptions = leadsResult?.Items?
                .Select(l => new LeadOption(l.LeadId, $"{l.FirstName} {l.LastName}".Trim(), l.AccountName ?? "—"))
                .OrderBy(l => l.Display)
                .ToList() ?? [];

            var result = await Api.SearchLeadActivitiesAsync(_tenantId) ?? new();
            _items = result.Items?.ToList() ?? [];

            _typeOpts = new()
            {
                new() { Label = "Call", Value = "Call" },
                new() { Label = "Email", Value = "Email" },
                new() { Label = "Meeting", Value = "Meeting" },
                new() { Label = "Task", Value = "Task" },
                new() { Label = "Note", Value = "Note" }
            };

            _outcomeOpts = new()
            {
                new() { Label = "Positive", Value = "Positive" },
                new() { Label = "Negative", Value = "Negative" },
                new() { Label = "Neutral", Value = "Neutral" }
            };

            _completedOpts = new()
            {
                new() { Label = "Open", Value = "0" },
                new() { Label = "Completed", Value = "1" }
            };

            ApplyFilters();
        }
        catch (Exception ex)
        {
            await _toast?.ShowAsync(new ToastModel { Title = "Error", Content = ex.Message, CssClass = "e-toast-danger" });
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters()
    {
        _filtered = _items
            .Where(x => string.IsNullOrEmpty(_search) || x.Subject.Contains(_search, StringComparison.OrdinalIgnoreCase))
            .Where(x => string.IsNullOrEmpty(_filterType) || x.ActivityTypeCode == _filterType)
            .Where(x => string.IsNullOrEmpty(_filterCompleted) || ((_filterCompleted == "1") == x.IsCompleted))
            .ToList();
    }

    private async Task SaveAsync()
    {
        if (!ValidateForm())
            return;

        try
        {
            _saving = true;
            if (_editingId == Guid.Empty)
            {
                await Api.CreateLeadActivityAsync(new CreateLeadActivityRequest
                {
                    TenantId = _tenantId,
                    LeadId = _form.LeadId,
                    ActivityTypeCode = _form.ActivityTypeCode,
                    Subject = _form.Subject,
                    Notes = _form.Notes,
                    ActivityDate = _form.ActivityDate,
                    DurationMinutes = _form.DurationMinutes,
                    OutcomeCode = _form.OutcomeCode,
                });
            }
            else
            {
                await Api.UpdateLeadActivityAsync(_editingId, new UpdateLeadActivityRequest
                {
                    ActivityId = _editingId,
                    LeadId = _form.LeadId,
                    ActivityTypeCode = _form.ActivityTypeCode,
                    Subject = _form.Subject,
                    Notes = _form.Notes,
                    ActivityDate = _form.ActivityDate,
                    DurationMinutes = _form.DurationMinutes,
                    OutcomeCode = _form.OutcomeCode,
                    IsCompleted = _form.IsCompleted,
                });
            }

            await _toast?.ShowAsync(new ToastModel { Title = "Success", Content = "Activity saved", CssClass = "e-toast-success" });
            _showAdd = false;
            _editingId = Guid.Empty;
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await _toast?.ShowAsync(new ToastModel { Title = "Error", Content = ex.Message, CssClass = "e-toast-danger" });
        }
        finally
        {
            _saving = false;
        }
    }

    private string TypeIcon(string type) => type switch
    {
        "Call" => "bi-telephone-fill",
        "Email" => "bi-envelope-fill",
        "Meeting" => "bi-calendar-event-fill",
        "Task" => "bi-check2-square",
        "Note" => "bi-sticky-fill",
        _ => "bi-lightning"
    };

    private void OpenCreate()
    {
        _editingId = Guid.Empty;
        ResetForm();
        _showAdd = true;
    }

    private void OnRowSelected(RowSelectEventArgs<LeadActivityDto> args) => OpenEdit(args.Data);

    private void OpenEdit(LeadActivityDto item)
    {
        _editingId = item.ActivityId;
        _formErrors.Clear();
        _form = new()
        {
            LeadId = item.LeadId ?? Guid.Empty,
            ActivityTypeCode = item.ActivityTypeCode,
            Subject = item.Subject,
            Notes = item.Notes,
            ActivityDate = item.ActivityDate,
            DurationMinutes = item.DurationMinutes,
            OutcomeCode = item.OutcomeCode,
            IsCompleted = item.IsCompleted,
        };
        _showAdd = true;
    }

    private void ConfirmDelete(LeadActivityDto item)
    {
        _deleteTarget = item;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;

        try
        {
            await Api.DeleteLeadActivityAsync(_deleteTarget.ActivityId);
            await _toast?.ShowAsync(new ToastModel { Title = "Deleted", Content = "Activity deleted", CssClass = "e-toast-success" });
            _deleteTarget = null;
            _showDeleteConfirm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await _toast?.ShowAsync(new ToastModel { Title = "Delete failed", Content = ex.Message, CssClass = "e-toast-danger" });
        }
    }

    private void ResetForm()
    {
        _formErrors.Clear();
        _form = new()
        {
            LeadId = Guid.Empty,
            ActivityTypeCode = "Call",
            ActivityDate = DateTime.Now,
        };
    }

    private bool ValidateForm()
    {
        _formErrors.Clear();
        var results = new List<ValidationResult>();
        var context = new ValidationContext(_form);
        Validator.TryValidateObject(_form, context, results, true);

        if (_form.LeadId == Guid.Empty)
            results.Add(new ValidationResult("Lead is required.", [nameof(ActivityForm.LeadId)]));

        foreach (var result in results)
        {
            var member = result.MemberNames.FirstOrDefault() ?? string.Empty;
            if (!_formErrors.ContainsKey(member))
                _formErrors[member] = result.ErrorMessage ?? "Invalid value.";
        }

        return _formErrors.Count == 0;
    }

    private RenderFragment FieldError(string fieldName) => builder =>
    {
        if (!_formErrors.TryGetValue(fieldName, out var error)) return;

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "text-danger");
        builder.AddContent(2, error);
        builder.CloseElement();
    };

    private sealed record LeadOption(Guid Id, string Name, string Company)
    {
        public string Display => string.IsNullOrWhiteSpace(Company) || Company == "—" ? Name : $"{Name} — {Company}";
    }

    private sealed class ActivityForm
    {
        [Required]
        public Guid LeadId { get; set; }

        [Required, StringLength(50)]
        public string ActivityTypeCode { get; set; } = "Call";

        [Required, StringLength(200)]
        public string Subject { get; set; } = string.Empty;

        public DateTime ActivityDate { get; set; } = DateTime.Now;

        [Range(0, 1440)]
        public int? DurationMinutes { get; set; }

        [StringLength(50)]
        public string? OutcomeCode { get; set; }

        [StringLength(2000)]
        public string? Notes { get; set; }

        public bool IsCompleted { get; set; }
    }

    private class LV 
    { 
        public string Label { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
