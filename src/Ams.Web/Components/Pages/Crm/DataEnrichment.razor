@page "/crm/enrichment"
@namespace Ams.Web.Components.Pages.Crm
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Enrichment
@using BlazorChangeEventArgs = Microsoft.AspNetCore.Components.ChangeEventArgs
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Enterprise Data Enrichment</PageTitle>

@if (_toastVisible)
{
    <div class="enr-toast enr-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="enr-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showConfirm && _confirmAction is not null)
{
    <div class="enr-modal-backdrop" role="presentation" @onclick="CancelConfirm">
        <div class="enr-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="enrichmentConfirmTitle" @onclick:stopPropagation="true">
            <div class="enr-confirm-icon enr-confirm-@_confirmAction.Kind"><i class="bi @_confirmAction.Icon" aria-hidden="true"></i></div>
            <h2 id="enrichmentConfirmTitle">@_confirmAction.Title</h2>
            <p>@_confirmAction.Message</p>
            <div class="enr-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CancelConfirm" disabled="@_busy">Cancel</button>
                <button type="button" class="um-btn @_confirmAction.ButtonClass" @onclick="ExecuteConfirmedAsync" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    @_confirmAction.ButtonText
                </button>
            </div>
        </div>
    </div>
}

@if (_showProviderDialog && _selectedProvider is not null)
{
    <div class="enr-modal-backdrop" role="presentation" @onclick="CloseProviderDialog">
        <div class="enr-provider-modal" role="dialog" aria-modal="true" aria-labelledby="providerConfigTitle" @onclick:stopPropagation="true">
            <div class="enr-modal-header">
                <div class="enr-modal-title"><span class="enr-modal-icon"><i class="bi @_selectedProvider.IconCssClass" aria-hidden="true"></i></span><span><h2 id="providerConfigTitle">Configure @_selectedProvider.ProviderName</h2><p>Connect provider credentials and choose enrichment fields.</p></span></div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseProviderDialog" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveProviderConfigAsync">
                <DataAnnotationsValidator />
                <div class="enr-modal-body">
                    <div class="enr-form-banner"><i class="bi bi-shield-lock" aria-hidden="true"></i><span><strong>Secure provider setup</strong><span>Credentials are represented as configuration state in this workspace; third-party API calls are not executed from the browser.</span></span></div>
                    <div class="enr-form-grid">
                        <div class="enr-field enr-field-wide">
                            <label for="providerApiKey">API Key <span>*</span></label>
                            <InputText id="providerApiKey" class="enr-input" type="password" @bind-Value="_form.ApiKey" placeholder="Enter provider API key" />
                        </div>
                        <div class="enr-field enr-field-wide">
                            <label>Fields to enrich <span>*</span></label>
                            <div class="enr-field-selection">
                                @foreach (var field in ProviderFields(_selectedProvider))
                                {
                                    <label class="enr-field-checkbox">
                                        <input type="checkbox" checked="@_form.SelectedFields.Contains(field)" @onchange="@(() => ToggleProviderField(field))" />
                                        <span>@field</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <label class="enr-check-card enr-field-wide">
                            <InputCheckbox @bind-Value="_form.EnableAutoEnrich" />
                            <span><strong>Enable automatic enrichment</strong><small>Run enrichment automatically for new account and contact records.</small></span>
                        </label>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_formError))
                    {
                        <div class="enr-form-error"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_formError</div>
                    }
                </div>
                <div class="enr-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseProviderDialog" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy"><i class="bi bi-check-lg" aria-hidden="true"></i> Save Configuration</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="enr-enterprise-page">
    <section class="enr-hero">
        <div class="enr-hero-left">
            <span class="enr-hero-icon"><i class="bi bi-stars" aria-hidden="true"></i></span>
            <div>
                <div class="enr-title-row">
                    <h1>Enterprise Data Enrichment</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live CRM workflow</span>
                    <span><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span>
                </div>
                <p>Connect enrichment providers, choose fields, enrich account and contact records, and audit every enrichment run.</p>
            </div>
        </div>
        <div class="enr-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh enrichment workspace"><i class="bi @(_loading ? "bi-arrow-repeat enr-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-ghost" @onclick="ShowConnectedProviders" title="Show connected providers"><i class="bi bi-plug-fill" aria-hidden="true"></i> Connected</button>
            <button class="um-btn um-btn-ghost" @onclick="NavigateToAccounts" title="Open accounts"><i class="bi bi-building" aria-hidden="true"></i> Accounts</button>
            <button class="um-btn um-btn-primary" @onclick="ConfirmRunAll" disabled="@(_busy || _enriching)"><i class="bi @(_enriching ? "bi-hourglass-split enr-spin" : "bi-play-fill")" aria-hidden="true"></i> Run Enrichment</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="enr-error-banner"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="enr-kpi-strip" aria-label="Enrichment metrics">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" @onclick="@(() => SetQuickFilter(metric.Filter))" title="@metric.Caption">
                <span class="enr-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span><span class="enr-kpi-val">@metric.Value</span><span class="enr-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
            </button>
        }
    </section>

    <section class="enr-workflow-strip" aria-label="Enrichment workflow actions">
        <button class="enr-workflow-card" @onclick="ConfirmRunAll"><i class="bi bi-play-fill" aria-hidden="true"></i><span><strong>Run enrichment</strong><span>Enrich all connected sources.</span></span></button>
        <button class="enr-workflow-card" @onclick="ShowProviders"><i class="bi bi-plug" aria-hidden="true"></i><span><strong>Providers</strong><span>Configure integrations.</span></span></button>
        <button class="enr-workflow-card" @onclick="ShowJobs"><i class="bi bi-clock-history" aria-hidden="true"></i><span><strong>Job history</strong><span>Audit enrichment runs.</span></span></button>
        <button class="enr-workflow-card" @onclick="ShowAnalytics"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span><strong>Analytics</strong><span>Monitor coverage and success.</span></span></button>
    </section>

    <section class="enr-search-panel">
        <div class="enr-search-wrap">
            <span class="enr-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="enr-search-body">
                <label for="enrichmentSearchInput">Search enrichment workspace</label>
                <input id="enrichmentSearchInput" class="enr-search-input" value="@_searchTerm" @oninput="OnSearchChanged" placeholder="Search provider, field, job, status, entity type, or notes..." />
                <span class="enr-search-hint">Enterprise search filters providers, fields, jobs, and audit records in memory.</span>
            </div>
        </div>
        <select class="enr-filter-select" value="@_providerStatusFilter" @onchange="OnProviderStatusFilterChanged">
            <option value="">All providers</option>
            <option value="Connected">Connected</option>
            <option value="Disconnected">Disconnected</option>
        </select>
        <select class="enr-filter-select" value="@_jobStatusFilter" @onchange="OnJobStatusFilterChanged">
            <option value="">All job statuses</option>
            @foreach (var status in JobStatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>
        <select class="enr-filter-select" value="@_entityFilter" @onchange="OnEntityFilterChanged">
            <option value="">All entities</option>
            <option value="All">All records</option>
            <option value="Account">Accounts</option>
            <option value="Contact">Contacts</option>
        </select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
        <div class="enr-search-result"><strong>@SearchResultCount</strong><span>@(_view == "providers" ? "providers" : "jobs")</span></div>
    </section>

    <section class="enr-view-tabs" aria-label="Enrichment views">
        @foreach (var view in _views)
        {
            <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label</button>
        }
    </section>

    <section class="enr-content-layout">
        <main class="enr-main-card">
            @if (_loading)
            {
                <div class="enr-loading"><i class="bi bi-arrow-repeat enr-spin" aria-hidden="true"></i><strong>Loading enterprise enrichment workspace...</strong></div>
            }
            else if (_view == "providers")
            {
                <div class="enr-section-head"><div><h2>Provider command center</h2><p>Connect providers, select enrichment fields, enable automation, or run provider-specific enrichment.</p></div><button class="um-btn um-btn-primary um-btn-sm" @onclick="ConfirmRunAll" disabled="@(_busy || _enriching)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run All</button></div>
                @if (FilteredProviders.Count == 0)
                {
                    <div class="enr-empty-state"><i class="bi bi-plug" aria-hidden="true"></i><strong>No providers match this view</strong><span>Adjust filters or seed provider configuration through the enrichment migration.</span><button class="um-btn um-btn-ghost" @onclick="ResetFilters">Reset filters</button></div>
                }
                else
                {
                    <div class="enr-providers-grid">
                        @foreach (var provider in FilteredProviders)
                        {
                            <article class="enr-provider-card @ProviderCardClass(provider)" @onclick="@(() => SelectProvider(provider))">
                                <div class="enr-provider-header">
                                    <span class="enr-provider-logo @ProviderTone(provider)"><i class="bi @provider.IconCssClass" aria-hidden="true"></i></span>
                                    <div><strong>@provider.ProviderName</strong><span>@provider.Description</span></div>
                                </div>
                                <div class="enr-provider-meta">
                                    <span class="@ProviderStatusClass(provider)"><i class="bi @(provider.IsConnected ? "bi-check-circle" : "bi-circle")" aria-hidden="true"></i> @provider.StatusCode</span>
                                    <span><i class="bi bi-calendar2-check" aria-hidden="true"></i> Last run @FormatDate(provider.LastRunDateUtc)</span>
                                    @if (provider.EnableAutoEnrich)
                                    {
                                        <span><i class="bi bi-lightning-charge" aria-hidden="true"></i> Auto</span>
                                    }
                                </div>
                                <div class="enr-field-tags">
                                    @foreach (var field in ProviderFields(provider).Take(5))
                                    {
                                        <span class="enr-field-tag">@field</span>
                                    }
                                    @if (ProviderFields(provider).Count > 5)
                                    {
                                        <span class="enr-field-tag enr-field-tag-more">+@(ProviderFields(provider).Count - 5)</span>
                                    }
                                </div>
                                <div class="enr-provider-actions" @onclick:stopPropagation="true">
                                    <button class="um-btn um-btn-primary um-btn-sm" @onclick="@(() => ConfigureProvider(provider))"><i class="bi bi-gear" aria-hidden="true"></i> Configure</button>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ConfirmRunProvider(provider))" disabled="@(!provider.IsConnected || _busy)"><i class="bi bi-play" aria-hidden="true"></i> Run</button>
                                    @if (provider.IsConnected)
                                    {
                                        <button class="um-btn um-btn-danger um-btn-sm" @onclick="@(() => ConfirmDisconnect(provider))"><i class="bi bi-x-circle" aria-hidden="true"></i></button>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            }
            else if (_view == "jobs")
            {
                <div class="enr-section-head"><div><h2>Enrichment job history</h2><p>Review run status, provider coverage, records enriched, failures, and success rates.</p></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="ShowProviders"><i class="bi bi-arrow-left" aria-hidden="true"></i> Providers</button></div>
                @if (FilteredJobs.Count == 0)
                {
                    <div class="enr-empty-state"><i class="bi bi-clock-history" aria-hidden="true"></i><strong>No enrichment jobs match this view</strong><span>Run enrichment or adjust filters to see job history.</span><button class="um-btn um-btn-primary" @onclick="ConfirmRunAll">Run enrichment</button></div>
                }
                else
                {
                    <div class="enr-jobs-list">
                        @foreach (var job in FilteredJobs)
                        {
                            <article class="enr-job-item @JobCardClass(job)" @onclick="@(() => SelectJob(job))">
                                <span class="enr-job-icon @JobStatusTone(job.StatusCode)"><i class="bi @JobIcon(job.StatusCode)" aria-hidden="true"></i></span>
                                <div class="enr-job-main"><strong>@job.JobName</strong><span>@job.ProviderName Â· @job.TargetEntityType Â· @FormatDateTime(job.StartedDateUtc)</span></div>
                                <div class="enr-job-stats"><span class="@JobStatusClass(job.StatusCode)">@job.StatusCode</span><strong>@job.RecordsEnriched.ToString("N0", CultureInfo.CurrentCulture)</strong><small>@Percent(job.SuccessRate)</small></div>
                            </article>
                        }
                    </div>
                }
            }
            else
            {
                <div class="enr-section-head"><div><h2>Enrichment analytics</h2><p>Monitor provider connectivity, job success, entity coverage, and enriched record volume.</p></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Refresh analytics</button></div>
                <div class="enr-analytics-grid">
                    <section>
                        <h3>Provider connectivity</h3>
                        @foreach (var row in ProviderDistribution)
                        {
                            <button class="@ProviderRowClass(row.Label)" @onclick="@(() => SelectProviderStatus(row.Label))"><span><i class="bi @(row.Label == "Connected" ? "bi-plug-fill" : "bi-plug")" aria-hidden="true"></i> @row.Label</span><div><i style="width:@row.WidthPercent%"></i></div><strong>@row.Count</strong><small>providers</small></button>
                        }
                    </section>
                    <section>
                        <h3>Job success bands</h3>
                        @foreach (var row in SuccessDistribution)
                        {
                            <div class="enr-stage-row"><span>@row.Label</span><div><i class="@row.Tone" style="width:@row.WidthPercent%"></i></div><strong>@row.Count</strong><small>@row.Percent.ToString("F0", CultureInfo.CurrentCulture)%</small></div>
                        }
                    </section>
                </div>
            }
        </main>

        <aside class="enr-detail-card">
            @if (_selectedProvider is not null && _view != "jobs")
            {
                <div class="enr-detail-head"><div><span class="enr-detail-eyebrow"><i class="bi @_selectedProvider.IconCssClass" aria-hidden="true"></i> Provider</span><h2>@_selectedProvider.ProviderName</h2><p>@_selectedProvider.Description</p></div><span class="@ProviderStatusClass(_selectedProvider)">@_selectedProvider.StatusCode</span></div>
                <div class="enr-detail-body">
                    <div class="enr-detail-summary"><div><span>Status</span><strong>@_selectedProvider.StatusCode</strong></div><div><span>Auto enrich</span><strong>@(_selectedProvider.EnableAutoEnrich ? "Enabled" : "Off")</strong></div><div><span>Fields</span><strong>@ProviderFields(_selectedProvider).Count</strong></div><div><span>Last run</span><strong>@FormatDate(_selectedProvider.LastRunDateUtc)</strong></div></div>
                    <div class="enr-rules-card"><header><strong>Selected fields</strong><span>@SelectedFields(_selectedProvider).Count selected</span></header>@foreach (var field in SelectedFields(_selectedProvider).DefaultIfEmpty("No fields selected")) { <p><em>@field</em><span>@(_selectedProvider.IsConnected ? "active" : "pending")</span></p> }</div>
                    <div class="enr-detail-actions"><button class="um-btn um-btn-primary" @onclick="@(() => ConfigureProvider(_selectedProvider))"><i class="bi bi-gear" aria-hidden="true"></i> Configure</button><button class="um-btn um-btn-ghost" @onclick="@(() => ConfirmRunProvider(_selectedProvider))" disabled="@(!_selectedProvider.IsConnected || _busy)"><i class="bi bi-play" aria-hidden="true"></i> Run</button>@if (_selectedProvider.IsConnected) { <button class="um-btn um-btn-danger" @onclick="@(() => ConfirmDisconnect(_selectedProvider))"><i class="bi bi-x-circle" aria-hidden="true"></i> Disconnect</button> }</div>
                </div>
            }
            else if (_selectedJob is not null)
            {
                <div class="enr-detail-head"><div><span class="enr-detail-eyebrow"><i class="bi @JobIcon(_selectedJob.StatusCode)" aria-hidden="true"></i> Job audit</span><h2>@_selectedJob.JobName</h2><p>@_selectedJob.ProviderName Â· @_selectedJob.TargetEntityType</p></div><span class="@JobStatusClass(_selectedJob.StatusCode)">@_selectedJob.StatusCode</span></div>
                <div class="enr-detail-body"><div class="enr-detail-summary"><div><span>Requested</span><strong>@_selectedJob.RecordsRequested.ToString("N0", CultureInfo.CurrentCulture)</strong></div><div><span>Enriched</span><strong>@_selectedJob.RecordsEnriched.ToString("N0", CultureInfo.CurrentCulture)</strong></div><div><span>Failed</span><strong>@_selectedJob.RecordsFailed.ToString("N0", CultureInfo.CurrentCulture)</strong></div><div><span>Success</span><strong>@Percent(_selectedJob.SuccessRate)</strong></div></div><div class="enr-rules-card"><header><strong>Run timeline</strong><span>@FormatDateTime(_selectedJob.StartedDateUtc)</span></header><p><em>Started</em><span>@FormatDateTime(_selectedJob.StartedDateUtc)</span></p><p><em>Completed</em><span>@FormatDateTime(_selectedJob.CompletedDateUtc)</span></p><p><em>Notes</em><span>@(_selectedJob.Notes ?? "â€”")</span></p></div><div class="enr-detail-actions"><button class="um-btn um-btn-ghost" @onclick="ShowJobs"><i class="bi bi-clock-history" aria-hidden="true"></i> Job History</button><button class="um-btn um-btn-primary" @onclick="ConfirmRunAll"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Run Again</button></div></div>
            }
            else
            {
                <div class="enr-detail-empty"><i class="bi bi-stars" aria-hidden="true"></i><strong>Select a provider or job</strong><span>Review provider configuration, enrichment fields, job status, and workflow actions.</span></div>
            }
        </aside>
    </section>
</div>

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading = true;
    private bool _busy;
    private bool _enriching;
    private bool _showConfirm;
    private bool _showProviderDialog;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "info";
    private string _loadError = string.Empty;
    private string _formError = string.Empty;
    private string _activeFilter = string.Empty;
    private string _searchTerm = string.Empty;
    private string _providerStatusFilter = string.Empty;
    private string _jobStatusFilter = string.Empty;
    private string _entityFilter = string.Empty;
    private string _view = "providers";
    private CancellationTokenSource? _toastCts;
    private ConfirmAction? _confirmAction;
    private EnrichmentProviderDto? _selectedProvider;
    private EnrichmentJobDto? _selectedJob;
    private ProviderFormModel _form = new();
    private List<EnrichmentProviderDto> _providers = [];
    private List<EnrichmentJobDto> _jobs = [];

    private static readonly List<ViewDef> _views = [new("providers", "Providers", "bi-plug"), new("jobs", "Job History", "bi-clock-history"), new("analytics", "Analytics", "bi-graph-up-arrow")];
    private IEnumerable<string> JobStatusOptions => _jobs.Select(j => j.StatusCode).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);
    private int SearchResultCount => _view == "providers" ? FilteredProviders.Count : FilteredJobs.Count;

    private IEnumerable<KpiModel> Metrics =>
    [
        new("Providers", _providers.Count.ToString(CultureInfo.InvariantCulture), "Configured sources", "bi-plug", "enr-blue", ""),
        new("Connected", _providers.Count(p => p.IsConnected).ToString(CultureInfo.InvariantCulture), "Ready to enrich", "bi-check2-circle", "enr-green", "Connected"),
        new("Jobs", _jobs.Count.ToString(CultureInfo.InvariantCulture), "Audit history", "bi-clock-history", "enr-purple", "Jobs"),
        new("Records", _jobs.Sum(j => j.RecordsEnriched).ToString("N0", CultureInfo.CurrentCulture), "Enriched records", "bi-database-check", "enr-cyan", ""),
        new("Success", AverageSuccessText, "Average rate", "bi-percent", "enr-amber", "HighSuccess")
    ];

    private string AverageSuccessText => _jobs.Count == 0 ? "N/A" : Percent(_jobs.Average(j => j.SuccessRate));
    private List<EnrichmentProviderDto> FilteredProviders => ApplyProviderFilters(_providers).ToList();
    private List<EnrichmentJobDto> FilteredJobs => ApplyJobFilters(_jobs).ToList();

    private IEnumerable<DistributionRow> ProviderDistribution
    {
        get
        {
            var rows = new[] { new DistributionRow("Connected", _providers.Count(p => p.IsConnected), 0, "enr-dist-high"), new DistributionRow("Disconnected", _providers.Count(p => !p.IsConnected), 0, "enr-dist-low") };
            var max = Math.Max(1, rows.Max(x => x.Count));
            return rows.Select(x => x with { WidthPercent = (double)x.Count / max * 100 });
        }
    }

    private IEnumerable<DistributionRow> SuccessDistribution
    {
        get
        {
            var total = Math.Max(1, _jobs.Count);
            var rows = new[] { new DistributionRow("High", _jobs.Count(j => j.SuccessRate >= .95m), 0, "enr-dist-high"), new DistributionRow("Medium", _jobs.Count(j => j.SuccessRate >= .8m && j.SuccessRate < .95m), 0, "enr-dist-medium"), new DistributionRow("Low", _jobs.Count(j => j.SuccessRate < .8m), 0, "enr-dist-low") };
            var max = Math.Max(1, rows.Max(x => x.Count));
            return rows.Select(x => x with { WidthPercent = (double)x.Count / max * 100, Percent = (double)x.Count / total * 100 });
        }
    }

    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-octagon", "warning" => "bi-exclamation-triangle", "success" => "bi-check2-circle", _ => "bi-info-circle" };

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Enrichment", "/crm/enrichment"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = string.Empty;
        try
        {
            if (_tenantId == Guid.Empty) await ResolveCurrentUserContextAsync();
            var workspace = await Api.GetEnrichmentWorkspaceAsync(new EnrichmentSearchRequest { TenantId = _tenantId });
            _providers = workspace?.Providers?.ToList() ?? [];
            _jobs = workspace?.Jobs?.ToList() ?? [];
            _selectedProvider = _selectedProvider is null ? FilteredProviders.FirstOrDefault() : _providers.FirstOrDefault(p => p.ProviderId == _selectedProvider.ProviderId) ?? FilteredProviders.FirstOrDefault();
            _selectedJob = _selectedJob is null ? FilteredJobs.FirstOrDefault() : _jobs.FirstOrDefault(j => j.JobId == _selectedJob.JobId) ?? FilteredJobs.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Enrichment workspace failed to load: {ex.Message}";
            _providers = [];
            _jobs = [];
            await ShowToastAsync("Enrichment workspace failed to load.", "danger");
        }
        finally { _loading = false; }
    }

    private IEnumerable<EnrichmentProviderDto> ApplyProviderFilters(IEnumerable<EnrichmentProviderDto> providers)
    {
        var query = providers;
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(p => Contains(p.ProviderName, term) || Contains(p.Description, term) || Contains(p.StatusCode, term) || Contains(p.AvailableFields, term) || Contains(p.SelectedFields, term));
        }
        if (!string.IsNullOrWhiteSpace(_providerStatusFilter)) query = query.Where(p => p.StatusCode == _providerStatusFilter);
        query = _activeFilter switch { "Connected" => query.Where(p => p.IsConnected), _ => query };
        return query.OrderBy(p => p.SortOrder).ThenBy(p => p.ProviderName);
    }

    private IEnumerable<EnrichmentJobDto> ApplyJobFilters(IEnumerable<EnrichmentJobDto> jobs)
    {
        var query = jobs;
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(j => Contains(j.JobName, term) || Contains(j.ProviderName, term) || Contains(j.TargetEntityType, term) || Contains(j.StatusCode, term) || Contains(j.Notes, term));
        }
        if (!string.IsNullOrWhiteSpace(_jobStatusFilter)) query = query.Where(j => j.StatusCode == _jobStatusFilter);
        if (!string.IsNullOrWhiteSpace(_entityFilter)) query = query.Where(j => j.TargetEntityType == _entityFilter || j.TargetEntityType == "All");
        if (_activeFilter == "HighSuccess") query = query.Where(j => j.SuccessRate >= .95m);
        return query.OrderByDescending(j => j.StartedDateUtc);
    }

    private void ConfigureProvider(EnrichmentProviderDto provider)
    {
        _selectedProvider = provider;
        _form = new ProviderFormModel { ApiKey = string.Empty, SelectedFields = SelectedFields(provider).ToList(), EnableAutoEnrich = provider.EnableAutoEnrich };
        if (_form.SelectedFields.Count == 0) _form.SelectedFields = ProviderFields(provider).Take(3).ToList();
        _formError = string.Empty;
        _showProviderDialog = true;
    }

    private async Task SaveProviderConfigAsync()
    {
        if (_selectedProvider is null) return;
        if (_form.SelectedFields.Count == 0)
        {
            _formError = "Select at least one field to enrich.";
            return;
        }
        _busy = true;
        try
        {
            await Api.ConfigureEnrichmentProviderAsync(_selectedProvider.ProviderId, new EnrichmentProviderConfigRequest { TenantId = _tenantId, ApiKey = _form.ApiKey, SelectedFields = _form.SelectedFields, EnableAutoEnrich = _form.EnableAutoEnrich, ModifiedByUserId = _tenantAdminUserId });
            _showProviderDialog = false;
            await LoadAsync();
            await ShowToastAsync("Provider configuration saved.", "success");
        }
        catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; await ShowToastAsync($"Save failed: {ex.Message}", "danger"); }
        finally { _busy = false; }
    }

    private void ConfirmDisconnect(EnrichmentProviderDto provider) => OpenConfirm(new("Disconnect provider", $"Disconnect {provider.ProviderName}? Existing job history will be retained.", "Disconnect", "um-btn-danger", "bi-x-circle", "danger", () => SetProviderStatusAsync(provider, "Disconnected")));
    private void ConfirmRunAll() => OpenConfirm(new("Run enrichment", "Run enrichment for all connected providers and CRM accounts/contacts?", "Run", "um-btn-primary", "bi-play-fill", "warning", () => RunEnrichmentAsync(null)));
    private void ConfirmRunProvider(EnrichmentProviderDto provider) => OpenConfirm(new("Run provider enrichment", $"Run enrichment using {provider.ProviderName}?", "Run", "um-btn-primary", "bi-play-fill", "warning", () => RunEnrichmentAsync(provider)));

    private async Task SetProviderStatusAsync(EnrichmentProviderDto provider, string status)
    {
        await Api.SetEnrichmentProviderStatusAsync(provider.ProviderId, new EnrichmentProviderStatusRequest { TenantId = _tenantId, StatusCode = status, ModifiedByUserId = _tenantAdminUserId });
        await LoadAsync();
        await ShowToastAsync($"{provider.ProviderName} {status.ToLowerInvariant()}.", "success");
    }

    private async Task RunEnrichmentAsync(EnrichmentProviderDto? provider)
    {
        _enriching = true;
        var target = string.IsNullOrWhiteSpace(_entityFilter) ? "All" : _entityFilter;
        try
        {
            var job = await Api.RunEnrichmentAsync(new EnrichmentRunRequest { TenantId = _tenantId, ProviderId = provider?.ProviderId, TargetEntityType = target, JobName = provider is null ? "Manual multi-provider enrichment" : $"{provider.ProviderName} enrichment", CreatedByUserId = _tenantAdminUserId });
            await LoadAsync();
            _selectedJob = job is null ? _jobs.FirstOrDefault() : _jobs.FirstOrDefault(j => j.JobId == job.JobId) ?? job;
            _view = "jobs";
            await ShowToastAsync($"Enrichment completed: {job?.RecordsEnriched.ToString("N0", CultureInfo.CurrentCulture) ?? "0"} record(s) enriched.", "success");
        }
        catch (Exception ex) { await ShowToastAsync($"Enrichment failed: {ex.Message}", "danger"); }
        finally { _enriching = false; }
    }

    private void SelectProvider(EnrichmentProviderDto provider) { _selectedProvider = provider; _view = "providers"; }
    private void SelectJob(EnrichmentJobDto job) { _selectedJob = job; _view = "jobs"; }
    private void SetView(string view) => _view = view;
    private void ShowProviders() => _view = "providers";
    private void ShowJobs() => _view = "jobs";
    private void ShowAnalytics() => _view = "analytics";
    private void ShowConnectedProviders() { _providerStatusFilter = "Connected"; _activeFilter = "Connected"; _view = "providers"; }
    private void SelectProviderStatus(string status) { _providerStatusFilter = _providerStatusFilter == status ? string.Empty : status; _activeFilter = _providerStatusFilter; _view = "providers"; }
    private void SetQuickFilter(string filter) { _activeFilter = _activeFilter == filter ? string.Empty : filter; if (filter == "Connected") { _providerStatusFilter = _activeFilter; _view = "providers"; } else if (filter == "Jobs" || filter == "HighSuccess") { _view = "jobs"; } else { _view = "providers"; } }
    private void ResetFilters() { _activeFilter = string.Empty; _searchTerm = string.Empty; _providerStatusFilter = string.Empty; _jobStatusFilter = string.Empty; _entityFilter = string.Empty; }
    private void OnSearchChanged(BlazorChangeEventArgs e) => _searchTerm = e.Value?.ToString() ?? string.Empty;
    private void OnProviderStatusFilterChanged(BlazorChangeEventArgs e) { _providerStatusFilter = e.Value?.ToString() ?? string.Empty; _activeFilter = string.Empty; }
    private void OnJobStatusFilterChanged(BlazorChangeEventArgs e) { _jobStatusFilter = e.Value?.ToString() ?? string.Empty; _activeFilter = string.Empty; }
    private void OnEntityFilterChanged(BlazorChangeEventArgs e) => _entityFilter = e.Value?.ToString() ?? string.Empty;
    private void NavigateToAccounts() => Nav.NavigateTo("/crm/accounts");
    private void ToggleProviderField(string field) { if (!_form.SelectedFields.Remove(field)) _form.SelectedFields.Add(field); }
    private void CloseProviderDialog() { if (!_busy) { _showProviderDialog = false; _formError = string.Empty; } }

    private void OpenConfirm(ConfirmAction action) { _confirmAction = action; _showConfirm = true; }
    private void CancelConfirm() { if (!_busy) { _showConfirm = false; _confirmAction = null; } }
    private async Task ExecuteConfirmedAsync() { if (_confirmAction is null) return; _busy = true; try { var action = _confirmAction; await action.ExecuteAsync(); _showConfirm = false; _confirmAction = null; } catch (Exception ex) { await ShowToastAsync($"Action failed: {ex.Message}", "danger"); } finally { _busy = false; } }

    private async Task ShowToastAsync(string message, string kind = "info")
    {
        _toastCts?.Cancel(); _toastCts?.Dispose(); _toastCts = new CancellationTokenSource();
        _toastMessage = message.Length <= 120 ? message : $"{message[..117]}..."; _toastKind = ToastKind(kind); _toastVisible = true; StateHasChanged();
        try { await Task.Delay(_toastKind == "danger" ? 10400 : 7000, _toastCts.Token); _toastVisible = false; await InvokeAsync(StateHasChanged); } catch (TaskCanceledException) { }
    }

    private void HideToast() { _toastCts?.Cancel(); _toastVisible = false; }
    private static string ToastKind(string value) => value.Contains("danger", StringComparison.OrdinalIgnoreCase) || value.Contains("error", StringComparison.OrdinalIgnoreCase) ? "danger" : value.Contains("warning", StringComparison.OrdinalIgnoreCase) ? "warning" : value.Contains("success", StringComparison.OrdinalIgnoreCase) ? "success" : "info";
    private static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static List<string> SplitFields(string? value) => string.IsNullOrWhiteSpace(value) ? [] : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
    private static List<string> ProviderFields(EnrichmentProviderDto provider) => SplitFields(provider.AvailableFields);
    private static List<string> SelectedFields(EnrichmentProviderDto provider) => SplitFields(provider.SelectedFields);
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture) : "Never";
    private static string FormatDateTime(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("MMM d, h:mm tt", CultureInfo.CurrentCulture) : "â€”";
    private static string Percent(decimal value) => value.ToString("P0", CultureInfo.CurrentCulture);
    private static string ProviderTone(EnrichmentProviderDto provider) => provider.IsConnected ? "enr-provider-connected" : "enr-provider-disconnected";
    private static string ProviderStatusClass(EnrichmentProviderDto provider) => provider.IsConnected ? "enr-status enr-status-connected" : "enr-status enr-status-disconnected";
    private static string JobStatusClass(string status) => status switch { "Completed" => "enr-status enr-status-connected", "Failed" => "enr-status enr-status-failed", "In Progress" => "enr-status enr-status-progress", _ => "enr-status enr-status-disconnected" };
    private static string JobStatusTone(string status) => status switch { "Completed" => "enr-job-success", "Failed" => "enr-job-failed", "In Progress" => "enr-job-progress", _ => "enr-job-pending" };
    private static string JobIcon(string status) => status switch { "Completed" => "bi-check2-circle", "Failed" => "bi-exclamation-octagon", "In Progress" => "bi-hourglass-split", _ => "bi-clock" };
    private string MetricCardClass(KpiModel metric) => $"enr-kpi-card {metric.Tone} {(_activeFilter == metric.Filter && !string.IsNullOrWhiteSpace(metric.Filter) ? "enr-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewDef view) => _view == view.Id ? "enr-view-btn enr-view-btn-active" : "enr-view-btn";
    private string ProviderCardClass(EnrichmentProviderDto provider) => provider.ProviderId == _selectedProvider?.ProviderId ? "enr-provider-card-selected" : string.Empty;
    private string JobCardClass(EnrichmentJobDto job) => job.JobId == _selectedJob?.JobId ? "enr-job-item-selected" : string.Empty;
    private string ProviderRowClass(string status) => _providerStatusFilter == status ? "enr-funnel-row enr-active" : "enr-funnel-row";

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private sealed record ViewDef(string Id, string Label, string Icon);
    private sealed record KpiModel(string Label, string Value, string Caption, string Icon, string Tone, string Filter);
    private sealed record ConfirmAction(string Title, string Message, string ButtonText, string ButtonClass, string Icon, string Kind, Func<Task> ExecuteAsync);
    private sealed record DistributionRow(string Label, int Count, double WidthPercent, string Tone) { public double Percent { get; init; } }

    private sealed class ProviderFormModel
    {
        [Required]
        [StringLength(200)]
        public string ApiKey { get; set; } = string.Empty;

        [Required]
        public List<string> SelectedFields { get; set; } = [];

        public bool EnableAutoEnrich { get; set; }
    }
}
