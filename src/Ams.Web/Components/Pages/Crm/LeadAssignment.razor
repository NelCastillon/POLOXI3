@page "/crm/leads/assignment"
@namespace Ams.Web.Components.Pages.Crm
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.CrmConfig
@using Ams.Application.Features.Leads
@using BlazorChangeEventArgs = Microsoft.AspNetCore.Components.ChangeEventArgs
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Lead Assignment Command Center</PageTitle>

@if (_toastVisible)
{
    <div class="la-toast la-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="la-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showAssign)
{
    <div class="la-modal-backdrop" role="presentation" @onclick="CloseAssign">
        <div class="la-action-modal" role="dialog" aria-modal="true" aria-labelledby="assignTitle" @onclick:stopPropagation="true">
            <div class="la-modal-header">
                <div class="la-modal-title">
                    <span class="la-modal-icon"><i class="bi bi-person-check" aria-hidden="true"></i></span>
                    <div><h2 id="assignTitle">Assign selected leads</h2><p>Route @_selectedLeads.Count lead(s) and sync existing CRM ownership.</p></div>
                </div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseAssign" disabled="@_busy" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_assignForm" OnValidSubmit="ConfirmAssign">
                <DataAnnotationsValidator />
                <div class="la-modal-body">
                    <div class="la-form-banner"><i class="bi bi-shield-check" aria-hidden="true"></i><div><strong>Workflow sync enabled</strong><span>Assignment updates Lead.AssignedToUserId and can log a workflow communication event.</span></div></div>
                    <div class="la-form-grid">
                        <label class="la-field"><span>Assign to producer <em>*</em></span><InputSelect class="la-input" @bind-Value="_assignForm.OwnerId"><option value="">Select owner</option>@foreach (var owner in _ownerOptions) { <option value="@owner.Value">@owner.Label</option> }</InputSelect><ValidationMessage For="() => _assignForm.OwnerId" class="text-danger" /></label>
                        <label class="la-field"><span>Move to stage</span><InputSelect class="la-input" @bind-Value="_assignForm.Stage">@foreach (var stage in _stageOptions) { <option value="@stage.Value">@stage.Label</option> }</InputSelect><ValidationMessage For="() => _assignForm.Stage" class="text-danger" /></label>
                        <label class="la-field la-field-wide"><span>Assignment note</span><InputTextArea class="la-textarea" @bind-Value="_assignForm.Note" rows="3" placeholder="Reason, routing context, or next action" /><ValidationMessage For="() => _assignForm.Note" class="text-danger" /></label>
                        <label class="la-field la-check"><InputCheckbox @bind-Value="_assignForm.LogWorkflow" /> <span>Log workflow activity on each lead</span></label>
                    </div>
                </div>
                <div class="la-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseAssign" disabled="@_busy">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_busy">@if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } Assign leads</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showRuleForm)
{
    <div class="la-modal-backdrop" role="presentation" @onclick="CloseRuleForm">
        <div class="la-action-modal" role="dialog" aria-modal="true" aria-labelledby="ruleFormTitle" @onclick:stopPropagation="true">
            <div class="la-modal-header">
                <div class="la-modal-title">
                    <span class="la-modal-icon"><i class="bi @(_ruleEditId.HasValue ? "bi-pencil-square" : "bi-diagram-3")" aria-hidden="true"></i></span>
                    <div><h2 id="ruleFormTitle">@(_ruleEditId.HasValue ? "Edit routing rule" : "Create routing rule")</h2><p>Configure assignment criteria, method, target, and priority.</p></div>
                </div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseRuleForm" disabled="@_busy" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_ruleForm" OnValidSubmit="SaveRuleAsync">
                <DataAnnotationsValidator />
                <div class="la-modal-body">
                    <div class="la-form-banner"><i class="bi bi-sliders" aria-hidden="true"></i><div><strong>Enterprise routing criteria</strong><span>Criteria is matched against source, stage, priority, score, premium, company, and service text.</span></div></div>
                    <div class="la-form-grid">
                        <label class="la-field"><span>Rule name <em>*</em></span><InputText class="la-input" @bind-Value="_ruleForm.RuleName" /><ValidationMessage For="() => _ruleForm.RuleName" class="text-danger" /></label>
                        <label class="la-field"><span>Entity <em>*</em></span><InputSelect class="la-input" @bind-Value="_ruleForm.EntityType"><option value="Lead">Lead</option><option value="Opportunity">Opportunity</option><option value="Submission">Submission</option></InputSelect><ValidationMessage For="() => _ruleForm.EntityType" class="text-danger" /></label>
                        <label class="la-field"><span>Method <em>*</em></span><InputSelect class="la-input" @bind-Value="_ruleForm.AssignmentMethod">@foreach (var method in _methodOptions) { <option value="@method">@method</option> }</InputSelect><ValidationMessage For="() => _ruleForm.AssignmentMethod" class="text-danger" /></label>
                        <label class="la-field"><span>Priority</span><InputNumber class="la-input" @bind-Value="_ruleForm.Priority" /><ValidationMessage For="() => _ruleForm.Priority" class="text-danger" /></label>
                        <label class="la-field"><span>Assign to user</span><InputSelect class="la-input" @bind-Value="_ruleForm.AssignToUserId"><option value="">No direct user</option>@foreach (var owner in _ownerOptions) { <option value="@owner.Value">@owner.Label</option> }</InputSelect><ValidationMessage For="() => _ruleForm.AssignToUserId" class="text-danger" /></label>
                        <label class="la-field"><span>Assign to team</span><InputText class="la-input" @bind-Value="_ruleForm.AssignToTeam" placeholder="Commercial producers" /><ValidationMessage For="() => _ruleForm.AssignToTeam" class="text-danger" /></label>
                        <label class="la-field la-field-wide"><span>Criteria</span><InputTextArea class="la-textarea" @bind-Value="_ruleForm.Criteria" rows="3" placeholder="Source = Referral AND Score >= 80" /><ValidationMessage For="() => _ruleForm.Criteria" class="text-danger" /></label>
                        <label class="la-field la-field-wide"><span>Description</span><InputTextArea class="la-textarea" @bind-Value="_ruleForm.Description" rows="3" /><ValidationMessage For="() => _ruleForm.Description" class="text-danger" /></label>
                        <label class="la-field la-check"><InputCheckbox @bind-Value="_ruleForm.IsActive" /> <span>Active rule</span></label>
                    </div>
                </div>
                <div class="la-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseRuleForm" disabled="@_busy">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_busy">@if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } @(_ruleEditId.HasValue ? "Save rule" : "Create rule")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showConfirm && _confirmAction is not null)
{
    <div class="la-modal-backdrop" role="presentation" @onclick="CancelConfirm">
        <div class="la-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle" @onclick:stopPropagation="true">
            <div class="la-confirm-icon la-confirm-@_confirmAction.Kind"><i class="bi @_confirmAction.Icon" aria-hidden="true"></i></div>
            <h2 id="confirmTitle">@_confirmAction.Title</h2>
            <p>@_confirmAction.Message</p>
            <div class="la-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CancelConfirm" disabled="@_busy">Cancel</button><button type="button" class="um-btn @_confirmAction.ButtonClass" @onclick="ExecuteConfirmedAsync" disabled="@_busy">@if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } @_confirmAction.ButtonText</button></div>
        </div>
    </div>
}

<div class="la-enterprise-page">
    <section class="la-hero">
        <div class="la-hero-left">
            <span class="la-hero-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
            <div>
                <div class="la-title-row"><h1>Lead Assignment Command Center</h1><span><i class="bi bi-database-check" aria-hidden="true"></i> Live CRM data</span><span><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span></div>
                <p>Prioritize unassigned and high-value leads, balance producer workload, simulate routing rules, and synchronize assignment workflow with the CRM lead pipeline.</p>
            </div>
        </div>
        <div class="la-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh lead assignment data"><i class="bi @(_loading ? "bi-arrow-repeat la-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="AutoBalanceSelected" disabled="@(!_selectedLeads.Any())" title="Assign selected leads to the lowest workload producers"><i class="bi bi-shuffle" aria-hidden="true"></i> Auto-balance</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreateRule" title="Create assignment rule"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Rule</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger la-error-banner" style="border-left: 4px solid #dc3545; animation: la-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@_loadError</span></div>
    }

    <section class="la-kpi-strip" aria-label="Assignment KPI filters">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" title="@metric.Caption" @onclick="() => SetKpiFilter(metric.Filter)"><span class="la-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span><span><span class="la-kpi-val">@metric.Value</span><span class="la-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span></button>
        }
    </section>

    <section class="la-workflow-strip" aria-label="Assignment workflow actions">
        <button type="button" class="la-workflow-card" @onclick="ShowQueue"><i class="bi bi-list-stars" aria-hidden="true"></i><span><strong>Priority queue</strong><span>Rank by importance and SLA risk.</span></span></button>
        <button type="button" class="la-workflow-card" @onclick="ShowUnassigned"><i class="bi bi-person-x" aria-hidden="true"></i><span><strong>Unassigned leads</strong><span>Find records without an owner.</span></span></button>
        <button type="button" class="la-workflow-card" @onclick="ShowWorkload"><i class="bi bi-speedometer2" aria-hidden="true"></i><span><strong>Producer capacity</strong><span>Balance open pipeline workload.</span></span></button>
        <button type="button" class="la-workflow-card" @onclick="ShowRules"><i class="bi bi-diagram-2" aria-hidden="true"></i><span><strong>Routing rules</strong><span>Simulate and maintain rules.</span></span></button>
    </section>

    <section class="la-search-panel" aria-label="Lead assignment filters">
        <div class="la-search-wrap"><span class="la-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span><div class="la-search-body"><label for="assignmentSearch">Search assignment queue</label><input id="assignmentSearch" class="la-search-input" value="@_search" @oninput="OnSearchChanged" placeholder="Search lead, company, source, stage, owner, rule, email, or phone..." /><span class="la-search-hint">Results are ranked by importance: unassigned, hot, stale, high score, high premium, and active rule match.</span></div></div>
        <select class="la-filter-select" value="@_stageFilter" @onchange="OnStageChanged"><option value="">All stages</option>@foreach (var stage in _stageOptions) { <option value="@stage.Value">@stage.Label</option> }</select>
        <select class="la-filter-select" value="@_ownerFilter" @onchange="OnOwnerChanged"><option value="">All owners</option><option value="unassigned">Unassigned</option>@foreach (var owner in _ownerOptions) { <option value="@owner.Value">@owner.Label</option> }</select>
        <select class="la-filter-select" value="@_sortMode" @onchange="OnSortChanged"><option value="importance">Importance</option><option value="score">Score</option><option value="premium">Premium</option><option value="stale">Stale first</option><option value="created">Newest</option></select>
        <div class="la-search-result"><strong>@_filtered.Count</strong><span>matches</span></div>
    </section>

    @if (_selectedLeads.Count > 0)
    {
        <section class="la-bulk-bar"><span>@_selectedLeads.Count selected - @_selectedLeads.Sum(x => x.EstPremium).ToString("C0", CultureInfo.CurrentCulture) open premium</span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenAssign"><i class="bi bi-person-check" aria-hidden="true"></i> Assign</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="AutoBalanceSelected"><i class="bi bi-shuffle" aria-hidden="true"></i> Auto-balance</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="MarkSelectedContacted"><i class="bi bi-telephone-outbound" aria-hidden="true"></i> Mark Contacted</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearSelection"><i class="bi bi-x-lg" aria-hidden="true"></i></button></section>
    }

    <section class="la-view-tabs" aria-label="Assignment views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="@TabClass(tab.Id)" @onclick="() => SetTab(tab.Id)"><i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label</button>
        }
    </section>

    <section class="la-content-layout">
        <main class="la-main-card">
            <div class="la-section-head"><div><h2>@ActiveTabTitle</h2><p>@ActiveTabDescription</p></div><div><strong>@_filtered.Count.ToString("N0", CultureInfo.CurrentCulture)</strong> leads</div></div>
            @if (_loading)
            {
                <div class="la-loading"><i class="bi bi-arrow-repeat la-spin" aria-hidden="true"></i><strong>Loading lead assignment workspace...</strong></div>
            }
            else if (_activeTab == "workload")
            {
                <div class="la-workload-grid">
                    @foreach (var workload in _workloads)
                    {
                        <article class="la-workload-card" @onclick="() => FilterByOwner(workload.OwnerId)">
                            <div class="la-workload-hdr"><div><strong>@workload.OwnerName</strong><span>@workload.OpenCount open leads - @workload.OpenPremium.ToString("C0", CultureInfo.CurrentCulture)</span></div><span class="la-workload-status @WorkloadTone(workload)">@workload.Status</span></div>
                            <div class="la-workload-bar"><span class="la-workload-fill @WorkloadTone(workload)" style="width:@workload.WidthPercent%"></span></div>
                            <div class="la-workload-stats"><div><span>@workload.HotCount</span><small>Hot</small></div><div><span>@workload.StaleCount</span><small>Stale</small></div><div><span>@workload.CapacityPercent.ToString("F0")%</span><small>Capacity</small></div></div>
                            <div class="la-card-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenAssignTo(workload.OwnerId)"><i class="bi bi-person-plus" aria-hidden="true"></i> Assign here</button></div>
                        </article>
                    }
                </div>
            }
            else if (_activeTab == "rules")
            {
                <div class="la-rules-grid">
                    @foreach (var rule in FilteredRules)
                    {
                        <article class="la-rule-card" @onclick="() => SelectRule(rule)">
                            <div class="la-rule-hdr"><div><strong>@rule.RuleName</strong><span>@Safe(rule.Description, "No description")</span></div><span class="la-status-pill @(rule.IsActive ? "la-status-active" : "la-status-inactive")">@(rule.IsActive ? "Active" : "Inactive")</span></div>
                            <div class="la-rule-meta"><span class="la-status-pill la-order-pill">@rule.EntityType</span><span class="la-status-pill la-order-pill">@Safe(rule.AssignmentMethod, "Manual")</span><span class="la-status-pill la-order-pill">Priority @rule.Priority</span></div>
                            <div class="la-rule-cond"><span>Criteria</span><strong>@Safe(rule.Criteria, "Always eligible")</strong></div>
                            <div class="la-rule-footer"><span>@RuleTarget(rule)</span><span>@RuleMatchCount(rule) matching leads</span></div>
                            <div class="la-card-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => SimulateRule(rule)"><i class="bi bi-play-circle" aria-hidden="true"></i> Simulate</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEditRule(rule)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => ConfirmToggleRule(rule)"><i class="bi @(rule.IsActive ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-danger um-btn-sm" @onclick:stopPropagation="true" @onclick="() => ConfirmDeleteRule(rule)"><i class="bi bi-trash3" aria-hidden="true"></i></button></div>
                        </article>
                    }
                </div>
            }
            else if (_activeTab == "history")
            {
                <div class="la-history-list">@foreach (var item in HistoryItems) { <article class="la-history-item"><span class="la-history-icon"><i class="bi @item.Icon" aria-hidden="true"></i></span><div><strong>@item.Title</strong><span>@item.Description</span></div></article> }</div>
            }
            else if (_filtered.Count == 0)
            {
                <div class="la-empty-state"><i class="bi bi-person-check" aria-hidden="true"></i><strong>No assignment records match this view</strong><span>Adjust filters or refresh lead data.</span></div>
            }
            else
            {
                <div class="la-table-scroll">
                    <table class="la-table">
                        <thead><tr><th><input type="checkbox" checked="@AllPageSelected" @onchange="TogglePageSelection" aria-label="Select all leads on page" /></th><th>Importance</th><th>Lead</th><th>Stage</th><th>Source</th><th>Owner</th><th class="la-number">Score</th><th class="la-number">Premium</th><th>Best rule</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var lead in _paged)
                            {
                                <tr class="@LeadRowClass(lead)" @onclick="() => SelectLead(lead)">
                                    <td @onclick:stopPropagation="true"><input type="checkbox" checked="@IsSelected(lead)" @onchange="() => ToggleLead(lead)" aria-label="Select lead" /></td>
                                    <td><span class="la-score-pill @ImportanceTone(lead)">@ImportanceScore(lead)</span></td>
                                    <td><div class="la-name-cell"><span class="la-avatar @AvatarColor(lead.FullName)">@Initials(lead.FullName)</span><span><strong>@lead.FullName</strong><small>@lead.CompanyName - @lead.Email</small></span></div></td>
                                    <td><span class="la-status-pill @StageTone(lead.Stage)">@lead.Stage</span></td>
                                    <td><span class="la-source-badge"><i class="bi @SourceIcon(lead.Source)" aria-hidden="true"></i>@lead.Source</span></td>
                                    <td>@lead.OwnerName</td>
                                    <td class="la-number"><span class="la-score-pill @ScoreTone(lead.Score)">@lead.Score</span></td>
                                    <td class="la-number">@lead.EstPremium.ToString("C0", CultureInfo.CurrentCulture)</td>
                                    <td>@BestRuleName(lead)</td>
                                    <td @onclick:stopPropagation="true"><div class="la-row-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenLeadAssign(lead)" title="Assign lead"><i class="bi bi-person-check" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => MarkLeadContacted(lead)" title="Mark contacted"><i class="bi bi-telephone-outbound" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => NavigateToLead(lead)" title="Open lead"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="la-rule-footer"><span>@PageSummary</span><span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i></button> Page @_page of @TotalPages <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)"><i class="bi bi-chevron-right" aria-hidden="true"></i></button></span></div>
            }
        </main>

        <aside class="la-detail-card">
            @if (_selectedLead is null && _selectedRule is null)
            {
                <div class="la-detail-empty"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a lead or rule</strong><span>Inspect assignment importance, rule matches, workload impact, and next best action.</span></div>
            }
            else if (_selectedRule is not null && _activeTab == "rules")
            {
                <div class="la-detail-head"><div><span class="la-detail-eyebrow"><i class="bi bi-diagram-2" aria-hidden="true"></i> Routing rule</span><h2>@_selectedRule.RuleName</h2><p>@RuleTarget(_selectedRule)</p></div><span class="la-status-pill @(_selectedRule.IsActive ? "la-status-active" : "la-status-inactive")">@(_selectedRule.IsActive ? "Active" : "Inactive")</span></div>
                <div class="la-detail-body"><div class="la-detail-summary"><div><span>Matches</span><strong>@RuleMatchCount(_selectedRule)</strong></div><div><span>Priority</span><strong>@_selectedRule.Priority</strong></div><div><span>Method</span><strong>@Safe(_selectedRule.AssignmentMethod, "Manual")</strong></div><div><span>Entity</span><strong>@_selectedRule.EntityType</strong></div></div><div class="la-contact-card"><span><i class="bi bi-funnel" aria-hidden="true"></i>@Safe(_selectedRule.Criteria, "Always eligible")</span><span><i class="bi bi-card-text" aria-hidden="true"></i>@Safe(_selectedRule.Description, "No description")</span></div><div class="la-detail-actions"><button type="button" class="um-btn um-btn-primary" @onclick="() => SimulateRule(_selectedRule)"><i class="bi bi-play-circle" aria-hidden="true"></i> Simulate</button><button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenEditRule(_selectedRule)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></div></div>
            }
            else if (_selectedLead is not null)
            {
                <div class="la-detail-head"><div><span class="la-detail-eyebrow"><i class="bi @SourceIcon(_selectedLead.Source)" aria-hidden="true"></i> @_selectedLead.Source</span><h2>@_selectedLead.FullName</h2><p>@_selectedLead.CompanyName</p></div><span class="la-score-pill @ImportanceTone(_selectedLead)">@ImportanceScore(_selectedLead)</span></div>
                <div class="la-detail-body"><div class="la-detail-summary"><div><span>Owner</span><strong>@_selectedLead.OwnerName</strong></div><div><span>Stage</span><strong>@_selectedLead.Stage</strong></div><div><span>Score</span><strong>@_selectedLead.Score</strong></div><div><span>Premium</span><strong>@_selectedLead.EstPremium.ToString("C0", CultureInfo.CurrentCulture)</strong></div></div><div class="la-contact-card"><span><i class="bi bi-envelope" aria-hidden="true"></i>@Safe(_selectedLead.Email, "No email")</span><span><i class="bi bi-telephone" aria-hidden="true"></i>@Safe(_selectedLead.Phone, "No phone")</span><span><i class="bi bi-diagram-2" aria-hidden="true"></i>Best rule: @BestRuleName(_selectedLead)</span><span><i class="bi bi-card-text" aria-hidden="true"></i>@Safe(_selectedLead.Notes, "No notes captured")</span></div><div class="la-detail-actions"><button type="button" class="um-btn um-btn-primary" @onclick="() => OpenLeadAssign(_selectedLead)"><i class="bi bi-person-check" aria-hidden="true"></i> Assign</button><button type="button" class="um-btn um-btn-ghost" @onclick="() => MarkLeadContacted(_selectedLead)"><i class="bi bi-telephone-outbound" aria-hidden="true"></i> Contacted</button><button type="button" class="um-btn um-btn-ghost" @onclick="() => NavigateToLead(_selectedLead)"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open lead</button></div></div>
            }
        </aside>
    </section>
</div>

@code {
    private Guid _tenantId;
    private Guid _currentUserId;
    private bool _loading;
    private bool _busy;
    private bool _toastVisible;
    private bool _showAssign;
    private bool _showRuleForm;
    private bool _showConfirm;
