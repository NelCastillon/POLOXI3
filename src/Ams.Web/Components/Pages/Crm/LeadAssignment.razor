    private void OpenBulkAssignDrawer()
    {
        _drawerMode = "assign-bulk";
        _bulkStrategy = "Manual";
        _bulkGroup = "All";
        _selectedProducerId = Guid.Empty;
        _drawerOpen = true;
    }

    private async Task AssignLead()
    {
        if (_selectedLead == null || _selectedProducerId == Guid.Empty)
        {
            await ShowToast("warning", "Invalid Selection", "Please select both lead and producer");
            return;
        }

        var producer = _producers.FirstOrDefault(p => p.Id == _selectedProducerId);
        if (producer == null) return;

        try
        {
            // TODO: Call API to assign lead
            // var request = new AssignLeadRequest 
            // { 
            //     LeadId = _selectedLead.Id,
            //     ProducerId = producer.Id,
            //     Notes = _assignmentNotes
            // };
            // await Api.AssignLeadAsync(request);

            _leads.Remove(_selectedLead);
            _history.Insert(0, new(
                _history.Count + 1,
                _selectedLead.Name,
                producer.Name,
                DateTime.Now,
                "Manual"
            ));

            UpdateKpi();
            _drawerOpen = false;
            await ShowToast("success", "Lead Assigned", $"{_selectedLead.Name} assigned to {producer.Name}");
        }
        catch (Exception ex)
        {
            await ShowToast("error", "Assignment Failed", ex.Message);
        }
    }

    private async Task BulkAssignLeads()
    {
        if (_selectedLeads.Count == 0) return;

        var leadsToAssign = _leads.Where(l => _selectedLeads.Contains(l.Id)).ToList();

        try
        {
            // TODO: Call API to bulk assign leads
            // var request = new BulkAssignLeadsRequest
            // {
            //     LeadIds = _selectedLeads.ToList(),
            //     Strategy = _bulkStrategy,
            //     ProducerId = _selectedProducerId,
            //     ProducerGroup = _bulkGroup
            // };
            // await Api.BulkAssignLeadsAsync(request);

            foreach (var lead in leadsToAssign)
            {
                var producer = _bulkStrategy.Equals("Manual", StringComparison.OrdinalIgnoreCase)
                    ? _producers.FirstOrDefault(p => p.Id == _selectedProducerId)
                    : _producers.FirstOrDefault();

                if (producer != null)
                {
                    _history.Insert(0, new(
                        _history.Count + 1,
                        lead.Name,
                        producer.Name,
                        DateTime.Now,
                        $"Bulk ({_bulkStrategy})"
                    ));
                }

                _leads.Remove(lead);
            }

            _selectedLeads.Clear();
            UpdateKpi();
            _drawerOpen = false;
            await ShowToast("success", "Bulk Assignment Complete", $"{leadsToAssign.Count} leads assigned");
        }
        catch (Exception ex)
        {
            await ShowToast("error", "Bulk Assignment Failed", ex.Message);
        }
    }

