    // ── Helpers ──────────────────────────────────────────────────────────
    private string GetAvatarColor(Guid id)
    {
        if (_avatarColors?.Length == 0) return "#cccccc";
        return _avatarColors[Math.Abs(id.GetHashCode()) % _avatarColors.Length];
    }

    private string GetScoreBadgeClass(int score) => score switch
    {
        >= 80 => "la-score--hot",
        >= 50 => "la-score--warm",
        _ => "la-score--cold",
    };

    private async Task ShowToast(string type, string title, string message)
    {
        if (_toast is null) return;
        await _toast.ShowAsync(new ToastModel { Title = title, Content = message, CssClass = $"e-toast-{type}" });
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
