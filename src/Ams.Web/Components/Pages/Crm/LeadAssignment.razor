    private async Task AssignSelectedAsync()
    {
        if (!Guid.TryParse(_assignForm.OwnerId, out var ownerId)) { await ShowToastAsync("Select an owner.", "warning"); return; }
        foreach (var lead in _selectedLeads.ToList())
        {
            var notes = string.IsNullOrWhiteSpace(_assignForm.Note) ? lead.Notes : $"{_assignForm.Note} {lead.Notes}".Trim();
            await UpdateLeadAssignmentAsync(lead, ownerId, _assignForm.Stage, notes);
            if (_assignForm.LogWorkflow)
            {
                await Api.CreateLeadCommunicationAsync(lead.LeadId, new CreateLeadCommunicationRequest { TenantId = _tenantId, LeadId = lead.LeadId, Channel = "Workflow", Subject = "Lead assigned", Preview = $"Lead assigned to {OwnerName(ownerId)} from Assignment Command Center.", SentByUserId = _currentUserId, SentAt = DateTime.UtcNow, Opened = true, Clicked = false });
            }
        }
        _showAssign = false;
        _selectedLeads.Clear();
        await LoadAsync();
        await ShowToastAsync("Lead assignment completed.", "success");
    }

    private void AutoBalanceSelected()
    {
        if (_selectedLeads.Count == 0) { _ = ShowToastAsync("Select leads to auto-balance.", "warning"); return; }
        OpenConfirm(new("Auto-balance leads", $"Assign {_selectedLeads.Count} lead(s) to lowest workload producers?", "Auto-balance", "um-btn-primary", "bi-shuffle", "warning", AutoBalanceSelectedAsync));
    }

    private async Task AutoBalanceSelectedAsync()
    {
        var owners = _workloads.OrderBy(w => w.CapacityPercent).ThenBy(w => w.OpenPremium).Where(w => w.OwnerId != Guid.Empty).ToList();
        if (owners.Count == 0) { await ShowToastAsync("No active owners available.", "warning"); return; }
        var index = 0;
        foreach (var lead in _selectedLeads.ToList())
        {
            var owner = owners[index % owners.Count];
            await UpdateLeadAssignmentAsync(lead, owner.OwnerId, lead.Stage == "New" ? "Contacted" : lead.Stage, $"Auto-balanced to {owner.OwnerName}. {lead.Notes}".Trim());
            index++;
        }
        _selectedLeads.Clear();
        await LoadAsync();
        await ShowToastAsync("Auto-balance completed.", "success");
    }

