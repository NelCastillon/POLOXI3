    private void SimulateRule(AssignmentRuleDto rule)
    {
        _activeTab = "queue";
        _kpiFilter = string.Empty;
        var matches = _leads.Where(l => RuleMatchesLead(rule, l)).ToList();
        _filtered = matches.OrderByDescending(ImportanceScore).ToList();
        _page = 1;
        _paged = _filtered.Take(PageSize).ToList();
        _selectedRule = rule;
        _ = ShowToastAsync($"{matches.Count} lead(s) match {rule.RuleName}.", "info");
    }

    private void OpenConfirm(ConfirmAction action) { _confirmAction = action; _showConfirm = true; }
    private void CancelConfirm() { if (!_busy) { _showConfirm = false; _confirmAction = null; } }
    private async Task ExecuteConfirmedAsync()
    {
        if (_confirmAction is null) return;
        _busy = true;
        try { var action = _confirmAction; await action.ExecuteAsync(); _showConfirm = false; _confirmAction = null; }
        catch (Exception ex) { await ShowToastAsync($"Action failed: {ex.Message}", "danger"); }
        finally { _busy = false; }
    }

    private int ImportanceScore(LeadAssignmentRow lead)
    {
        var score = 0;
        if (!lead.AssignedToUserId.HasValue) score += 35;
        if (lead.Rating == "Hot") score += 25;
        if (lead.Score >= 80) score += 15;
        if (lead.EstPremium >= 25000) score += 12;
        if (lead.DaysSinceActivity > 14) score += 10;
        if (_rules.Any(r => r.IsActive && RuleMatchesLead(r, lead))) score += 8;
        if (lead.Stage == "New") score += 5;
        return Math.Min(score, 100);
    }

    private bool RuleMatchesLead(AssignmentRuleDto rule, LeadAssignmentRow lead)
    {
        if (!rule.IsActive || !string.Equals(rule.EntityType, "Lead", StringComparison.OrdinalIgnoreCase)) return false;
        if (string.IsNullOrWhiteSpace(rule.Criteria)) return true;
        var criteria = rule.Criteria;
        return TextContains(criteria, lead.Source) || TextContains(criteria, lead.Stage) || TextContains(criteria, lead.Rating) || TextContains(criteria, lead.CompanyName) || TextContains(criteria, lead.Notes) || (lead.Score >= 80 && TextContains(criteria, "score")) || (lead.EstPremium >= 25000 && (TextContains(criteria, "premium") || TextContains(criteria, "revenue")));
    }

    private string BestRuleName(LeadAssignmentRow lead) => _rules.Where(r => RuleMatchesLead(r, lead)).OrderByDescending(r => r.Priority).Select(r => r.RuleName).FirstOrDefault() ?? "Manual review";
    private int RuleMatchCount(AssignmentRuleDto rule) => _leads.Count(l => l.IsOpen && RuleMatchesLead(rule, l));
    private string RuleTarget(AssignmentRuleDto rule) => rule.AssignToUserId.HasValue ? OwnerName(rule.AssignToUserId.Value) : Safe(rule.AssignToTeam, "Manual queue");
    private string OwnerName(Guid userId) => _ownerOptions.FirstOrDefault(x => x.UserId == userId)?.Label ?? "Selected owner";
    private static string DisplayUser(UserDto user) => string.IsNullOrWhiteSpace(user.DisplayName) ? (string.IsNullOrWhiteSpace(user.FullName) ? user.UserName : user.FullName) : user.DisplayName;
    private static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static bool TextContains(string? value, string? term) => !string.IsNullOrWhiteSpace(value) && !string.IsNullOrWhiteSpace(term) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static string NormalizeStage(string? stage, int statusCode) => !string.IsNullOrWhiteSpace(stage) ? stage.Trim() switch { "Closed" => "Lost", "Won" => "Converted", var s => s } : statusCode switch { 2 => "Contacted", 3 => "Qualified", 4 => "Converted", 5 => "Lost", _ => "New" };
    private static string ScoreToRating(int score, string? priority = null) => string.Equals(priority, "Hot", StringComparison.OrdinalIgnoreCase) || score >= 80 ? "Hot" : score >= 50 ? "Warm" : "Cold";
    private static int StageToStatusCode(string stage) => stage switch { "Contacted" => 2, "Qualified" => 3, "Converted" => 4, "Lost" => 5, _ => 1 };
    private string MetricCardClass(KpiModel metric) => $"la-kpi-card {metric.Tone} {(_kpiFilter == metric.Filter ? "la-kpi-card-active" : string.Empty)}";
    private string TabClass(string id) => _activeTab == id ? "la-view-btn la-view-btn-active" : "la-view-btn";
    private string LeadRowClass(LeadAssignmentRow lead) => lead.LeadId == _selectedLead?.LeadId ? "la-row-selected" : string.Empty;
    private static string SourceIcon(string source) => source switch { "Referral" => "bi-share-fill", "Website" => "bi-globe", "Cold Call" => "bi-telephone-fill", "Social" => "bi-instagram", "Email" => "bi-envelope-fill", "Event" => "bi-calendar-event-fill", "Partner" => "bi-handshake-fill", _ => "bi-inbox-fill" };
    private static string ScoreTone(int score) => score >= 80 ? "la-score-hot" : score >= 50 ? "la-score-warm" : "la-score-cold";
    private static string ImportanceTone(LeadAssignmentRow lead) => !lead.AssignedToUserId.HasValue || lead.Score >= 80 ? "la-score-hot" : lead.DaysSinceActivity > 14 ? "la-score-warm" : "la-score-cold";
    private static string StageTone(string stage) => stage is "Converted" ? "la-status-active" : stage is "Lost" ? "la-status-inactive" : "la-order-pill";
    private static string WorkloadTone(WorkloadRow row) => row.CapacityPercent >= 95 ? "la-workload-over" : row.CapacityPercent >= 75 ? "la-workload-high" : row.CapacityPercent >= 45 ? "la-workload-med" : "la-workload-low";
    private static string AvatarColor(string name) { var colors = new[] { "la-av1", "la-av2", "la-av3", "la-av4", "la-av5", "la-av6" }; return colors[Math.Abs(name.GetHashCode()) % colors.Length]; }
    private static string Initials(string name) { var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length > 0 ? name[..1] : "?"; }
    private Task ShowToastAsync(string message, string kind = "info") { _toastCts?.Cancel(); _toastCts?.Dispose(); _toastCts = new CancellationTokenSource(); _toastMessage = message.Length <= 110 ? message : $"{message[..107]}..."; _toastKind = kind.Contains("danger", StringComparison.OrdinalIgnoreCase) || kind.Contains("error", StringComparison.OrdinalIgnoreCase) ? "danger" : kind.Contains("warning", StringComparison.OrdinalIgnoreCase) ? "warning" : kind.Contains("success", StringComparison.OrdinalIgnoreCase) ? "success" : "info"; _toastVisible = true; StateHasChanged(); _ = HideToastAfterDelayAsync(_toastCts.Token, _toastKind == "danger" ? 5200 : 2800); return Task.CompletedTask; }
    private async Task HideToastAfterDelayAsync(CancellationToken cancellationToken, int delayMs) { try { await Task.Delay(delayMs, cancellationToken); _toastVisible = false; await InvokeAsync(StateHasChanged); } catch (TaskCanceledException) { } }
    private void HideToast() { _toastCts?.Cancel(); _toastVisible = false; }

    private sealed record TabDef(string Id, string Label, string Icon);
    private sealed record LabelValue(string Value, string Label);
    private sealed record OwnerOption(Guid UserId, string Label) { public string Value => UserId.ToString(); }
    private sealed record KpiModel(string Label, string Value, string Caption, string Icon, string Tone, string Filter);
    private sealed record ConfirmAction(string Title, string Message, string ButtonText, string ButtonClass, string Icon, string Kind, Func<Task> ExecuteAsync);
    private sealed record HistoryItem(string Icon, string Title, string Description);
    private sealed record WorkloadRow(Guid OwnerId, string OwnerName, int OpenCount, int HotCount, int StaleCount, decimal OpenPremium, double CapacityPercent, double WidthPercent)
    {
        public string Status => CapacityPercent >= 95 ? "Overloaded" : CapacityPercent >= 75 ? "High" : CapacityPercent >= 45 ? "Balanced" : "Available";
    }

    private sealed class LeadAssignmentRow
    {
        public Guid LeadId { get; set; }
        public Guid? AssignedToUserId { get; set; }
        public Guid? AccountId { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string CompanyName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Source { get; set; } = string.Empty;
        public string Stage { get; set; } = "New";
        public string Rating { get; set; } = "Warm";
        public int Score { get; set; }
        public decimal EstPremium { get; set; }
        public string OwnerName { get; set; } = "Unassigned";
        public string? Notes { get; set; }
        public DateTime CreatedDateUtc { get; set; }
        public DateTime? ModifiedDateUtc { get; set; }
        public DateTime? QualifiedDate { get; set; }
        public bool IsOpen => Stage is not "Converted" and not "Lost";
        public int DaysSinceActivity => (int)(DateTime.UtcNow - (ModifiedDateUtc ?? CreatedDateUtc)).TotalDays;
    }

