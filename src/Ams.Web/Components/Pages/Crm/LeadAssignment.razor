    private void ToggleRuleActive(int ruleId, bool active)
    {
        var rule = _rules.FirstOrDefault(r => r.Id == ruleId);
        if (rule != null)
        {
            var idx = _rules.IndexOf(rule);
            _rules[idx] = rule with { Active = active };
        }
    }

    private async Task DeleteRule(int ruleId)
    {
        _rules.RemoveAll(r => r.Id == ruleId);
        await ShowToast("success", "Rule Deleted", "Assignment rule has been removed");
    }

