    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _currentUserId = context.UserId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Lead Assignment", "/crm/leads/assignment"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var leadsTask = Api.SearchLeadsAsync(_tenantId);
            var usersTask = Api.SearchUsersAsync(_tenantId, pageSize: 250);
            var rulesTask = Api.SearchAssignmentRulesAsync(_tenantId, pageSize: 250);
            await Task.WhenAll(leadsTask, usersTask, rulesTask);

            _users = usersTask.Result?.Items?.ToList() ?? [];
            _ownerOptions = _users.Where(u => string.Equals(u.StatusCode, "Active", StringComparison.OrdinalIgnoreCase)).Select(u => new OwnerOption(u.UserId, DisplayUser(u))).Where(o => !string.IsNullOrWhiteSpace(o.Label)).OrderBy(o => o.Label).ToList();
            var ownerLookup = _users.ToDictionary(u => u.UserId, DisplayUser);
            _rules = rulesTask.Result?.Items?.ToList() ?? [];
            _leads = leadsTask.Result?.Items?.Select(l => MapLead(l, ownerLookup)).ToList() ?? [];
            _selectedLeads.RemoveAll(s => _leads.All(l => l.LeadId != s.LeadId));
            _selectedLead = _selectedLead is null ? _leads.OrderByDescending(ImportanceScore).FirstOrDefault() : _leads.FirstOrDefault(x => x.LeadId == _selectedLead.LeadId) ?? _leads.OrderByDescending(ImportanceScore).FirstOrDefault();
            RebuildWorkloads();
            ApplyFilters(false);
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _leads = [];
            _rules = [];
            _workloads = [];
            ApplyFilters(false);
            await ShowToastAsync($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private LeadAssignmentRow MapLead(LeadDto dto, IReadOnlyDictionary<Guid, string> ownerLookup)
    {
        var score = Math.Clamp(dto.Score ?? 0, 0, 100);
        var stage = NormalizeStage(dto.NurturingStageCode, dto.StatusCode);
        return new LeadAssignmentRow
        {
            LeadId = dto.LeadId,
            AssignedToUserId = dto.AssignedToUserId,
            AccountId = dto.AccountId,
            FirstName = dto.FirstName,
            LastName = dto.LastName,
            FullName = $"{dto.FirstName} {dto.LastName}".Trim(),
            CompanyName = dto.AccountName ?? string.Empty,
            Email = dto.Email ?? string.Empty,
            Phone = dto.Phone ?? string.Empty,
            Source = string.IsNullOrWhiteSpace(dto.SourceCode) ? "Inbound" : dto.SourceCode,
            Stage = stage,
            Rating = ScoreToRating(score, dto.PriorityCode),
            Score = score,
            EstPremium = dto.AnnualRevenue ?? 0,
            OwnerName = dto.AssignedToUserId.HasValue && ownerLookup.TryGetValue(dto.AssignedToUserId.Value, out var owner) ? owner : "Unassigned",
            Notes = dto.InterestedService,
            CreatedDateUtc = dto.CreatedDateUtc,
            ModifiedDateUtc = dto.ModifiedDateUtc,
            QualifiedDate = dto.QualifiedDate
        };
    }

    private void RebuildWorkloads()
    {
        var maxPremium = Math.Max(1, _leads.Where(l => l.IsOpen).GroupBy(l => l.AssignedToUserId ?? Guid.Empty).Select(g => g.Sum(l => l.EstPremium)).DefaultIfEmpty(1).Max());
        _workloads = _ownerOptions.Select(o =>
        {
            var rows = _leads.Where(l => l.IsOpen && l.AssignedToUserId == o.UserId).ToList();
            var premium = rows.Sum(l => l.EstPremium);
            var capacity = Math.Min(100, rows.Count * 7 + rows.Count(l => l.Rating == "Hot") * 8 + (double)(premium / maxPremium) * 35);
            return new WorkloadRow(o.UserId, o.Label, rows.Count, rows.Count(l => l.Rating == "Hot"), rows.Count(l => l.DaysSinceActivity > 14), premium, capacity, maxPremium == 0 ? 0 : (double)(premium / maxPremium) * 100);
        }).OrderByDescending(w => w.OpenPremium).ThenByDescending(w => w.OpenCount).ToList();
    }

    private void ApplyFilters(bool resetPage = true)
    {
        IEnumerable<LeadAssignmentRow> query = _leads.Where(x => x.IsOpen || _kpiFilter == "rules");
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            query = query.Where(x => TextContains(x.FullName, term) || TextContains(x.CompanyName, term) || TextContains(x.Email, term) || TextContains(x.Phone, term) || TextContains(x.Source, term) || TextContains(x.Stage, term) || TextContains(x.OwnerName, term) || TextContains(x.Notes, term) || TextContains(BestRuleName(x), term));
        }
        if (!string.IsNullOrWhiteSpace(_stageFilter)) query = query.Where(x => x.Stage == _stageFilter);
        if (_ownerFilter == "unassigned") query = query.Where(x => !x.AssignedToUserId.HasValue);
        else if (Guid.TryParse(_ownerFilter, out var ownerId)) query = query.Where(x => x.AssignedToUserId == ownerId);
        query = _kpiFilter switch { "unassigned" => query.Where(x => !x.AssignedToUserId.HasValue), "hot" => query.Where(x => x.Rating == "Hot"), "stale" => query.Where(x => x.DaysSinceActivity > 14), "pipeline" => query.Where(x => x.EstPremium > 0), _ => query };
        query = _sortMode switch { "score" => query.OrderByDescending(x => x.Score), "premium" => query.OrderByDescending(x => x.EstPremium), "stale" => query.OrderByDescending(x => x.DaysSinceActivity), "created" => query.OrderByDescending(x => x.CreatedDateUtc), _ => query.OrderByDescending(ImportanceScore).ThenByDescending(x => x.Score).ThenByDescending(x => x.EstPremium) };
        _filtered = query.ToList();
        if (resetPage) _page = 1;
        _page = Math.Clamp(_page, 1, TotalPages);
        _paged = _filtered.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    }

