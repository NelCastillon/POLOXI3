@page "/leads/scoring"
@page "/crm/leads/scoring"
@namespace Ams.Web.Components.Pages.Crm
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Leads
@using Microsoft.AspNetCore.Components.Forms
@using BlazorChangeEventArgs = Microsoft.AspNetCore.Components.ChangeEventArgs
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@inject LeadScoringRealtimeClient LeadScoringRealtime
@implements IAsyncDisposable

<PageTitle>Enterprise Lead Scoring</PageTitle>

@if (_toastVisible)
{
    <div class="ld-toast ld-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="ld-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showConfirm && _confirmAction is not null)
{
    <div class="ls-modal-backdrop" role="presentation" @onclick="CancelConfirm">
        <div class="ls-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="scoreConfirmTitle" @onclick:stopPropagation="true">
            <div class="ls-confirm-icon ls-confirm-@_confirmAction.Kind"><i class="bi @_confirmAction.Icon" aria-hidden="true"></i></div>
            <h2 id="scoreConfirmTitle">@_confirmAction.Title</h2>
            <p>@_confirmAction.Message</p>
            <div class="ls-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CancelConfirm" disabled="@_busy">Cancel</button>
                <button type="button" class="um-btn @_confirmAction.ButtonClass" @onclick="ExecuteConfirmedAsync" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    @_confirmAction.ButtonText
                </button>
            </div>
        </div>
    </div>
}

@if (_showRuleForm)
{
    <div class="ls-modal-backdrop" role="presentation" @onclick="CloseRuleForm">
        <div class="ls-rule-modal" role="dialog" aria-modal="true" aria-labelledby="leadScoringRuleTitle" @onclick:stopPropagation="true">
            <div class="ls-modal-header">
                <div class="ls-modal-title">
                    <span class="ls-modal-icon"><i class="bi bi-sliders" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="leadScoringRuleTitle">@(_editingRuleId == Guid.Empty ? "Create scoring factor" : "Edit scoring factor")</h2>
                        <p>Configure tenant-scoped criteria that influence lead score, priority, and producer workflow.</p>
                    </div>
                </div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseRuleForm" disabled="@_savingRule" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_ruleForm" OnValidSubmit="SaveRuleAsync" OnInvalidSubmit="HandleInvalidRuleSubmitAsync">
                <DataAnnotationsValidator />
                <div class="ls-modal-body">
                    <div class="ls-form-banner">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <div>
                            <strong>Enterprise scoring governance</strong>
                            <span>Factors are tenant scoped, ordered, validated, and synchronized with the active CRM lead scoring workflow.</span>
                        </div>
                    </div>
                    <div class="ls-form-grid">
                        <div class="ls-field ls-field-wide">
                            <label>Factor name <span>*</span></label>
                            <InputText class="ls-input" @bind-Value="_ruleForm.RuleName" placeholder="Example: High annual revenue" />
                        </div>
                        <div class="ls-field">
                            <label>Category <span>*</span></label>
                            <InputSelect class="ls-input" @bind-Value="_ruleForm.Field">
                                @foreach (var item in _fieldOptions)
                                {
                                    <option value="@item.Value">@item.Label</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="ls-field">
                            <label>Condition <span>*</span></label>
                            <InputSelect class="ls-input" @bind-Value="_ruleForm.Operator">
                                @foreach (var item in _operatorOptions)
                                {
                                    <option value="@item.Value">@item.Label</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="ls-field ls-field-wide">
                            <label>Value</label>
                            <InputText class="ls-input" @bind-Value="_ruleForm.Value" placeholder="Example: 14, Opened, Referral, 100000" />
                        </div>
                        <div class="ls-field">
                            <label>Points <span>*</span></label>
                            <InputNumber class="ls-input" @bind-Value="_ruleForm.Points" />
                        </div>
                        <div class="ls-field">
                            <label>Sort order</label>
                            <InputNumber class="ls-input" @bind-Value="_ruleForm.SortOrder" />
                        </div>
                        <div class="ls-field ls-field-wide">
                            <label class="ls-check"><InputCheckbox @bind-Value="_ruleForm.IsActive" /> Active scoring factor</label>
                        </div>
                    </div>
                </div>
                <div class="ls-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseRuleForm" disabled="@_savingRule">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_savingRule">
                        @if (_savingRule)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(_editingRuleId == Guid.Empty ? "Create factor" : "Save factor")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="ls-enterprise-page">
    <section class="ls-hero">
        <div class="ls-hero-left">
            <span class="ls-hero-icon"><i class="bi bi-sliders" aria-hidden="true"></i></span>
            <div>
                <div class="ls-title-row">
                    <h1>Enterprise Lead Scoring</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live CRM data</span>
                    <span><i class="bi bi-broadcast" aria-hidden="true"></i> Realtime sync</span>
                </div>
                <p>Design scoring factors, monitor lead priority, and keep sales workflow routing aligned with tenant-scoped CRM data.</p>
            </div>
        </div>
        <div class="ls-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh scoring data"><i class="bi @(_loading ? "bi-arrow-repeat ls-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-ghost" @onclick="SyncScoresAsync" disabled="@_loading" title="Reload scored leads and rules"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Sync scores</button>
            <button class="um-btn um-btn-ghost" @onclick="NavigateToLeads" title="Open enterprise leads"><i class="bi bi-person-lines-fill" aria-hidden="true"></i> Leads</button>
            <button class="um-btn um-btn-primary" @onclick="OpenCreateRule" title="Create scoring factor"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Factor</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="ls-error-banner"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="ls-kpi-strip" aria-label="Lead scoring metrics">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" @onclick="@(() => SetQuickFilter(metric.Filter))">
                <span class="ls-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span><span class="ls-kpi-val">@metric.Value</span><span class="ls-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
            </button>
        }
    </section>

    <section class="ls-workflow-strip" aria-label="Scoring workflow actions">
        <button class="ls-workflow-card" @onclick="OpenCreateRule"><i class="bi bi-plus-square" aria-hidden="true"></i><span><strong>Create factor</strong><span>Add scoring criteria.</span></span></button>
        <button class="ls-workflow-card" @onclick="ActivateAllRules"><i class="bi bi-check2-circle" aria-hidden="true"></i><span><strong>Activate rules</strong><span>Enable all scoring factors.</span></span></button>
        <button class="ls-workflow-card" @onclick="SeedDefaultRulesAsync"><i class="bi bi-stars" aria-hidden="true"></i><span><strong>Seed defaults</strong><span>Add enterprise defaults if empty.</span></span></button>
        <button class="ls-workflow-card" @onclick="ShowAnalytics"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span><strong>Analyze score mix</strong><span>Review quality distribution.</span></span></button>
    </section>

    <section class="ls-search-panel">
        <div class="ls-search-wrap">
            <i class="bi bi-search ls-search-icon" aria-hidden="true"></i>
            <div class="ls-search-body">
                <label for="scoringSearchInput">Search scoring workspace</label>
                <input id="scoringSearchInput" class="ls-search-input" value="@_searchTerm" @oninput="OnSearchChanged" placeholder="Search factors, conditions, leads, companies, source, service, or rating..." />
                <span class="ls-search-hint">Enterprise search filters both scoring factors and scored lead preview records.</span>
            </div>
        </div>
        <select class="ls-filter-select" value="@_factorFilter" @onchange="OnFactorFilterChanged">
            <option value="">All factors</option>
            <option value="Active">Active factors</option>
            <option value="Inactive">Inactive factors</option>
            <option value="Positive">Positive points</option>
            <option value="Negative">Negative points</option>
        </select>
        <select class="ls-filter-select" value="@_ratingFilter" @onchange="OnRatingFilterChanged">
            <option value="">All ratings</option>
            <option value="Hot">Hot</option>
            <option value="Warm">Warm</option>
            <option value="Cold">Cold</option>
        </select>
        <select class="ls-filter-select" value="@_sourceFilter" @onchange="OnSourceFilterChanged">
            <option value="">All sources</option>
            @foreach (var source in SourceOptions)
            {
                <option value="@source">@source</option>
            }
        </select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
        <div class="ls-search-result"><strong>@FilteredLeads.Count</strong><span>matches</span></div>
    </section>

    <section class="ls-view-tabs" aria-label="Lead scoring views">
        @foreach (var view in _views)
        {
            <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label</button>
        }
    </section>

    <section class="ls-content-layout">
        <main class="ls-main-card">
            @if (_loading)
            {
                <div class="ls-loading"><i class="bi bi-arrow-repeat ls-spin" aria-hidden="true"></i><strong>Loading enterprise scoring workspace...</strong></div>
            }
            else if (_view == "rules")
            {
                <div class="ls-section-head">
                    <div><h2>Scoring factor management</h2><p>Create, edit, activate, deactivate, duplicate, and delete tenant-scoped scoring factors.</p></div>
                    <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreateRule"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Factor</button>
                </div>
                @if (FilteredRules.Count == 0)
                {
                    <div class="ls-empty-state"><i class="bi bi-sliders" aria-hidden="true"></i><strong>No scoring factors match this view</strong><span>Adjust filters or add a new factor to start configuring scoring logic.</span><button class="um-btn um-btn-primary" @onclick="OpenCreateRule">Create factor</button></div>
                }
                else
                {
                    <div class="ls-rules-grid">
                        @foreach (var rule in FilteredRules.OrderBy(r => r.SortOrder).ThenByDescending(r => r.PointValue))
                        {
                            <article class="ls-rule-card" @onclick="@(() => SelectRule(rule))">
                                <div class="ls-rule-hdr">
                                    <div class="ls-rule-heading">
                                        <span class="ls-rule-avatar @RuleAvatarClass(rule)"><i class="@RuleIcon(rule)" aria-hidden="true"></i></span>
                                        <div><strong>@rule.RuleName</strong><span>@FieldLabel(rule.Field)</span></div>
                                    </div>
                                    <div class="ls-rule-actions" @onclick:stopPropagation="true">
                                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ToggleRuleActiveAsync(rule))" title="Toggle active state"><i class="bi @(rule.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i></button>
                                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenEditRule(rule))" title="Edit factor"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => DuplicateRuleAsync(rule))" title="Duplicate factor"><i class="bi bi-copy" aria-hidden="true"></i></button>
                                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ConfirmDeleteRule(rule))" title="Delete factor"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                                <div class="ls-rule-meta">
                                    <span class="ls-status-pill @(rule.IsActive ? "ls-status-pill-active" : "ls-status-pill-inactive")">@(rule.IsActive ? "Active" : "Inactive")</span>
                                    <span class="ls-points-pill @PointsClass(rule.PointValue)">@FormatPoints(rule.PointValue) pts</span>
                                    <span class="ls-order-pill">Order @rule.SortOrder</span>
                                </div>
                                <div class="ls-rule-cond"><span>Condition</span><strong>@RuleCondition(rule)</strong></div>
                                <div class="ls-rule-footer"><span><i class="bi bi-diagram-3" aria-hidden="true"></i> @rule.Operator</span><span><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span></div>
                            </article>
                        }
                    </div>
                }
            }
            else if (_view == "leads")
            {
                <div class="ls-section-head">
                    <div><h2>Scored leads preview</h2><p>Review lead score, rating, source, service interest, and CRM workflow readiness.</p></div>
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="NavigateToLeads"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Leads</button>
                </div>
                @if (FilteredLeads.Count == 0)
                {
                    <div class="ls-empty-state"><i class="bi bi-person-lines-fill" aria-hidden="true"></i><strong>No scored leads match this view</strong><span>Adjust search, rating, or source filters to view scored CRM records.</span><button class="um-btn um-btn-ghost" @onclick="ResetFilters">Reset filters</button></div>
                }
                else
                {
                    <div class="ls-table-scroll">
                        <table class="ls-table">
                            <thead><tr><th>Lead</th><th>Rating</th><th>Source</th><th>Stage</th><th class="ls-number">Score</th><th class="ls-number">Premium</th><th>Updated</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var lead in FilteredLeads)
                                {
                                    <tr class="@LeadRowClass(lead)" @onclick="@(() => SelectLead(lead))">
                                        <td><div class="ls-name-cell"><span class="ls-avatar @AvatarColor(lead.FullName)" aria-hidden="true">@Initials(lead.FullName)</span><span><strong>@lead.FullName</strong><small>@lead.AccountName - @lead.Email</small></span></div></td>
                                        <td><span class="@RatingBadge(lead.Rating)">@lead.Rating</span></td>
                                        <td><span class="ls-source-badge"><i class="bi @SourceIcon(lead.SourceCode)" aria-hidden="true"></i> @lead.SourceCode</span></td>
                                        <td><span class="@StageBadge(lead.Stage)">@lead.Stage</span></td>
                                        <td class="ls-number"><span class="ls-score-pill @ScoreTone(lead.Score)">@lead.Score</span></td>
                                        <td class="ls-number">@lead.EstPremium.ToString("C0", CultureInfo.CurrentCulture)</td>
                                        <td>@(lead.ModifiedDateUtc ?? lead.CreatedDateUtc).ToLocalTime().ToString("MMM d", CultureInfo.CurrentCulture)</td>
                                        <td @onclick:stopPropagation="true"><button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenLeadInCrm(lead))" title="Find lead in CRM"><i class="bi bi-arrow-right" aria-hidden="true"></i></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                <div class="ls-section-head"><div><h2>Scoring analytics</h2><p>Monitor lead quality distribution and source contribution against active scoring factors.</p></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="SyncScoresAsync"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Refresh analytics</button></div>
                <div class="ls-analytics-grid">
                    <section>
                        <h3>Score distribution</h3>
                        @foreach (var row in ScoreDistribution)
                        {
                            <div class="ls-stage-row"><span>@row.Label</span><div><i class="@row.Tone" style="width:@row.WidthPercent%"></i></div><strong>@row.Count</strong><small>@row.Percent.ToString("F0")%</small></div>
                        }
                    </section>
                    <section>
                        <h3>Source quality</h3>
                        @foreach (var source in SourceBreakdown)
                        {
                            <button class="@SourceRowClass(source.Source)" @onclick="@(() => SelectSource(source.Source))"><span><i class="bi @SourceIcon(source.Source)" aria-hidden="true"></i> @source.Source</span><div><i style="width:@source.WidthPercent%"></i></div><strong>@source.AvgScore</strong><small>@source.Total leads</small></button>
                        }
                    </section>
                </div>
            }
        </main>

        <aside class="ls-detail-card">
            @if (_selectedRule is not null)
            {
                <div class="ls-detail-head"><div><span class="ls-detail-eyebrow"><i class="@RuleIcon(_selectedRule)" aria-hidden="true"></i> @FieldLabel(_selectedRule.Field)</span><h2>@_selectedRule.RuleName</h2><p>@RuleCondition(_selectedRule)</p></div><span class="ls-points-pill @PointsClass(_selectedRule.PointValue)">@FormatPoints(_selectedRule.PointValue)</span></div>
                <div class="ls-detail-body">
                    <div class="ls-detail-summary"><div><span>Status</span><strong>@(_selectedRule.IsActive ? "Active" : "Inactive")</strong></div><div><span>Sort</span><strong>@_selectedRule.SortOrder</strong></div><div><span>Operator</span><strong>@_selectedRule.Operator</strong></div><div><span>Created</span><strong>@_selectedRule.CreatedDateUtc.ToLocalTime().ToString("MMM d", CultureInfo.CurrentCulture)</strong></div></div>
                    <div class="ls-contact-card"><span><i class="bi bi-list-check" aria-hidden="true"></i> @RuleCondition(_selectedRule)</span><span><i class="bi bi-lightning-charge" aria-hidden="true"></i> @FormatPoints(_selectedRule.PointValue) points when matched</span><span><i class="bi bi-building-lock" aria-hidden="true"></i> Tenant-scoped CRM scoring rule</span></div>
                    <div class="ls-detail-actions"><button class="um-btn um-btn-ghost" @onclick="@(() => OpenEditRule(_selectedRule))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button class="um-btn um-btn-ghost" @onclick="@(() => ToggleRuleActiveAsync(_selectedRule))"><i class="bi bi-power" aria-hidden="true"></i> Toggle</button><button class="um-btn um-btn-danger" @onclick="@(() => ConfirmDeleteRule(_selectedRule))"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                </div>
            }
            else if (_selectedLead is not null)
            {
                <div class="ls-detail-head"><div><span class="ls-detail-eyebrow"><i class="bi @SourceIcon(_selectedLead.SourceCode)" aria-hidden="true"></i> @_selectedLead.SourceCode</span><h2>@_selectedLead.FullName</h2><p>@_selectedLead.AccountName</p></div><span class="@RatingBadge(_selectedLead.Rating)">@_selectedLead.Rating</span></div>
                <div class="ls-detail-body">
                    <div class="ls-detail-summary"><div><span>Score</span><strong>@_selectedLead.Score</strong></div><div><span>Stage</span><strong>@_selectedLead.Stage</strong></div><div><span>Pipeline</span><strong>@_selectedLead.EstPremium.ToString("C0")</strong></div><div><span>Created</span><strong>@_selectedLead.CreatedDateUtc.ToLocalTime().ToString("MMM d", CultureInfo.CurrentCulture)</strong></div></div>
                    <div class="ls-contact-card"><span><i class="bi bi-envelope" aria-hidden="true"></i> @_selectedLead.Email</span><span><i class="bi bi-card-text" aria-hidden="true"></i> @_selectedLead.InterestedService</span><span><i class="bi bi-bar-chart" aria-hidden="true"></i> @_selectedLead.Rating priority from current CRM score</span></div>
                    <div class="ls-detail-actions"><button class="um-btn um-btn-ghost" @onclick="@(() => OpenLeadInCrm(_selectedLead))"><i class="bi bi-person-lines-fill" aria-hidden="true"></i> Open Lead</button><button class="um-btn um-btn-primary" @onclick="OpenCreateRule"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add Factor</button></div>
                </div>
            }
            else
            {
                <div class="ls-detail-empty"><i class="bi bi-sliders" aria-hidden="true"></i><strong>Select a factor or lead</strong><span>Review scoring factor intelligence, lead score details, and workflow actions.</span></div>
            }
        </aside>
    </section>
</div>

@code {
    private Guid _tenantId;
    private bool _loading;
    private bool _busy;
    private bool _showRuleForm;
    private bool _showConfirm;
    private bool _savingRule;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "info";
    private string _searchTerm = string.Empty;
    private string _loadError = string.Empty;
    private string _view = "rules";
    private string _factorFilter = string.Empty;
    private string _ratingFilter = string.Empty;
    private string _sourceFilter = string.Empty;
    private string _quickFilter = string.Empty;
    private Guid _editingRuleId = Guid.Empty;
    private CancellationTokenSource? _toastCts;
    private ConfirmAction? _confirmAction;
    private LeadScoringRuleForm _ruleForm = new();
    private LeadScoringRuleDto? _selectedRule;
    private LeadScoreRow? _selectedLead;
    private List<LeadScoreRow> _leads = [];
    private List<LeadScoringRuleDto> _rules = [];

    private static readonly List<ViewDef> _views = [new("rules", "Factors", "bi-sliders"), new("leads", "Scored Leads", "bi-people"), new("analytics", "Analytics", "bi-graph-up-arrow")];

    private static readonly List<LabelValue> _fieldOptions =
    [
        new("CompanySize", "Company size"),
        new("EmailOpened", "Email opened"),
        new("WebsiteVisits", "Website visits"),
        new("Title", "Title match"),
        new("StaleDays", "Stale age"),
        new("Source", "Lead source"),
        new("AnnualRevenue", "Annual revenue"),
    ];

    private static readonly List<LabelValue> _operatorOptions =
    [
        new("Equals", "Equals"),
        new("Contains", "Contains"),
        new("GreaterThan", "Greater than"),
        new("LessThan", "Less than"),
        new("IsNotEmpty", "Is not empty"),
        new("OlderThanDays", "Older than days"),
    ];

    private IEnumerable<KpiModel> Metrics =>
    [
        new("Factors", _rules.Count.ToString(), "Tenant rules", "bi-sliders", "ls-blue", ""),
        new("Active", _rules.Count(x => x.IsActive).ToString(), "Enabled now", "bi-check-circle", "ls-green", "Active"),
        new("Hot", _leads.Count(x => x.Rating == "Hot").ToString(), "High intent", "bi-fire", "ls-red", "Hot"),
        new("Average", AverageScore.ToString("F0"), "Lead score", "bi-speedometer2", "ls-purple", ""),
        new("Pipeline", _leads.Sum(x => x.EstPremium).ToString("C0"), "Scored premium", "bi-cash-coin", "ls-cyan", "")
    ];

    private List<LeadScoringRuleDto> FilteredRules
    {
        get
        {
            IEnumerable<LeadScoringRuleDto> query = _rules;
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(x => Contains(x.RuleName, term) || Contains(x.Field, term) || Contains(x.Operator, term) || Contains(x.Value, term) || Contains(RuleCondition(x), term));
            }
            query = _factorFilter switch
            {
                "Active" => query.Where(x => x.IsActive),
                "Inactive" => query.Where(x => !x.IsActive),
                "Positive" => query.Where(x => x.PointValue > 0),
                "Negative" => query.Where(x => x.PointValue < 0),
                _ => query
            };
            if (_quickFilter == "Active") query = query.Where(x => x.IsActive);
            return query.ToList();
        }
    }

    private List<LeadScoreRow> FilteredLeads
    {
        get
        {
            IEnumerable<LeadScoreRow> query = _leads;
            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(x => Contains(x.FullName, term) || Contains(x.AccountName, term) || Contains(x.Email, term) || Contains(x.SourceCode, term) || Contains(x.InterestedService, term) || Contains(x.Rating, term) || Contains(x.Stage, term));
            }
            if (!string.IsNullOrWhiteSpace(_ratingFilter)) query = query.Where(x => x.Rating == _ratingFilter);
            if (!string.IsNullOrWhiteSpace(_sourceFilter)) query = query.Where(x => x.SourceCode == _sourceFilter);
            query = _quickFilter switch
            {
                "Hot" => query.Where(x => x.Rating == "Hot"),
                _ => query
            };
            return query.OrderByDescending(x => x.Score).ThenByDescending(x => x.CreatedDateUtc).ToList();
        }
    }

    private IEnumerable<string> SourceOptions => _leads.Select(x => x.SourceCode).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);
    private double AverageScore => _leads.Count == 0 ? 0 : _leads.Average(x => x.Score);
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-octagon", "warning" => "bi-exclamation-triangle", "success" => "bi-check2-circle", _ => "bi-info-circle" };

    private IEnumerable<DistributionRow> ScoreDistribution
    {
        get
        {
            var total = Math.Max(1, _leads.Count);
            var rows = new[]
            {
                new DistributionRow("Hot", _leads.Count(x => x.Rating == "Hot"), 0, "ls-dist-hot"),
                new DistributionRow("Warm", _leads.Count(x => x.Rating == "Warm"), 0, "ls-dist-warm"),
                new DistributionRow("Cold", _leads.Count(x => x.Rating == "Cold"), 0, "ls-dist-cold")
            };
            var max = Math.Max(1, rows.Max(x => x.Count));
            return rows.Select(x => x with { WidthPercent = (double)x.Count / max * 100, Percent = (double)x.Count / total * 100 });
        }
    }

    private IEnumerable<SourceBreakdownRow> SourceBreakdown
    {
        get
        {
            var rows = _leads.GroupBy(x => x.SourceCode).Select(g => new SourceBreakdownRow(g.Key, g.Count(), (int)Math.Round(g.Average(x => x.Score)), 0)).ToList();
            var max = Math.Max(1, rows.Select(x => x.AvgScore).DefaultIfEmpty(1).Max());
            return rows.OrderByDescending(x => x.AvgScore).Select(x => x with { WidthPercent = max == 0 ? 0 : (double)x.AvgScore / max * 100 });
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Lead Scoring", "/crm/leads/scoring"));
        await LoadAsync();
        _ = StartLeadScoringRealtimeAsync();
    }

    private async Task OnLeadScoresChangedAsync(Guid tenantId)
    {
        if (tenantId != _tenantId) return;
        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task StartLeadScoringRealtimeAsync()
    {
        try
        {
            if (_tenantId != Guid.Empty) await LeadScoringRealtime.StartAsync(_tenantId, OnLeadScoresChangedAsync);
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Realtime unavailable: {ex.Message}", "warning");
        }
    }

    public async ValueTask DisposeAsync()
    {
        await LeadScoringRealtime.DisposeAsync();
        _toastCts?.Cancel();
        _toastCts?.Dispose();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = string.Empty;
        try
        {
            if (_tenantId == Guid.Empty) _tenantId = (await CurrentUser.RequireAsync()).TenantId;
            var leadsTask = Api.SearchLeadsAsync(_tenantId);
            var rulesTask = Api.GetLeadScoringRulesAsync(_tenantId);
            await Task.WhenAll(leadsTask, rulesTask);

            _leads = (leadsTask.Result?.Items ?? [])
                .Select(l => new LeadScoreRow(
                    l.LeadId,
                    $"{l.FirstName} {l.LastName}".Trim(),
                    l.AccountName ?? "-",
                    l.Email ?? string.Empty,
                    string.IsNullOrWhiteSpace(l.SourceCode) ? "Inbound" : l.SourceCode,
                    string.IsNullOrWhiteSpace(l.InterestedService) ? "No service captured" : l.InterestedService,
                    Math.Clamp(l.Score ?? 0, 0, 100),
                    Rating(Math.Clamp(l.Score ?? 0, 0, 100)),
                    NormalizeStage(l.NurturingStageCode, l.StatusCode),
                    l.AnnualRevenue ?? 0,
                    l.CreatedDateUtc,
                    l.ModifiedDateUtc))
                .OrderByDescending(l => l.Score)
                .ToList();

            _rules = rulesTask.Result?.OrderBy(x => x.SortOrder).ThenBy(x => x.RuleName).ToList() ?? [];
            _selectedRule = _selectedRule is null ? _rules.FirstOrDefault() : _rules.FirstOrDefault(x => x.LeadScoringRuleId == _selectedRule.LeadScoringRuleId) ?? _rules.FirstOrDefault();
            _selectedLead = _selectedLead is null ? _leads.FirstOrDefault() : _leads.FirstOrDefault(x => x.LeadId == _selectedLead.LeadId) ?? _leads.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load lead scoring: {ex.Message}";
            _leads = [];
            _rules = [];
            await ShowToastAsync("Unable to load lead scoring data.", "danger");
        }
        finally { _loading = false; }
    }

    private async Task SyncScoresAsync()
    {
        await LoadAsync();
        await ShowToastAsync("Lead scoring data synchronized.", "success");
    }

