@page "/leads/scoring"
@page "/crm/leads/scoring"
@namespace Ams.Web.Components.Pages.Crm
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Leads
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@inject LeadScoringRealtimeClient LeadScoringRealtime
@implements IAsyncDisposable

<PageTitle>Lead Scoring Factors — CRM</PageTitle>

<AppPageHeader Title="Lead Scoring Factors"
               Subtitle="Manage tenant-scoped scoring factors used to calculate lead priority and score"
               Icon="bi-sliders">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-ghost" @onclick="OpenCreateRule">
            <i class="bi bi-sliders" aria-hidden="true"></i> New Factor
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/crm/leads")'>
            <i class="bi bi-person-plus" aria-hidden="true"></i> Leads
        </button>
    </Actions>
</AppPageHeader>

<div class="ls-factor-kpi pc-kpi-strip">
    <div class="pc-kpi-card @(_factorFilter is null ? "pc-kpi-card--active" : "")" @onclick="() => SetFactorFilter(null)" title="Show all scoring factors">
        <span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-sliders" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_rules.Count</div><div class="pc-kpi-label">Factors</div></div>
    </div>
    <div class="pc-kpi-card @(_factorFilter == "Active" ? "pc-kpi-card--active" : "")" @onclick='() => SetFactorFilter("Active")' title="Show active factors">
        <span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_rules.Count(x => x.IsActive)</div><div class="pc-kpi-label">Active</div></div>
    </div>
    <div class="pc-kpi-card @(_factorFilter == "Inactive" ? "pc-kpi-card--active" : "")" @onclick='() => SetFactorFilter("Inactive")' title="Show inactive factors">
        <span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-pause-circle" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_rules.Count(x => !x.IsActive)</div><div class="pc-kpi-label">Inactive</div></div>
    </div>
    <div class="pc-kpi-card @(_factorFilter == "Positive" ? "pc-kpi-card--active" : "")" @onclick='() => SetFactorFilter("Positive")' title="Show factors that add points">
        <span class="pc-kpi-icon pc-kpi-icon--success"><i class="bi bi-plus-circle" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_rules.Count(x => x.PointValue > 0)</div><div class="pc-kpi-label">Positive</div></div>
    </div>
    <div class="pc-kpi-card @(_factorFilter == "Negative" ? "pc-kpi-card--active" : "")" @onclick='() => SetFactorFilter("Negative")' title="Show factors that subtract points">
        <span class="pc-kpi-icon pc-kpi-icon--danger"><i class="bi bi-dash-circle" aria-hidden="true"></i></span>
        <div><div class="pc-kpi-value">@_rules.Count(x => x.PointValue < 0)</div><div class="pc-kpi-label">Negative</div></div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i> @_loadError
    </div>
}

<div class="ls-factor-layout row g-3 mb-3">
    <div class="col-12 col-xl-8">
        <div class="um-grid-card ls-panel ls-factor-panel h-100 position-relative">
            @if (_loading)
            {
                <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div>
            }
            <div class="ls-panel-header">
                <div class="ls-panel-title-wrap">
                    <span class="ls-panel-icon"><i class="bi bi-sliders" aria-hidden="true"></i></span>
                    <div>
                        <h3>Scoring Factor Management</h3>
                        <p>Create, edit, activate, deactivate, and delete factors used in lead scoring.</p>
                    </div>
                </div>
                <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreateRule"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Factor</button>
            </div>
            @if (FilteredRules.Count == 0)
            {
                <div class="ls-empty-state">
                    <i class="bi bi-sliders" aria-hidden="true"></i>
                    <h4>No scoring factors match this view</h4>
                    <p>Change the KPI filter or add a new factor to start configuring scoring logic.</p>
                    <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreateRule"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Factor</button>
                </div>
            }
            else
            {
                <div class="ls-rules-grid">
                    @foreach (var rule in FilteredRules.OrderBy(r => r.SortOrder).ThenByDescending(r => r.PointValue))
                    {
                        <div class="ls-rule-card">
                            <div class="ls-rule-hdr">
                                <div class="ls-rule-heading">
                                    <span class="ls-rule-avatar @RuleAvatarClass(rule)"><i class="@RuleIcon(rule)" aria-hidden="true"></i></span>
                                    <div>
                                        <div class="ls-rule-title">@rule.RuleName</div>
                                        <div class="ls-rule-subtitle">@FieldLabel(rule.Field)</div>
                                    </div>
                                </div>
                                <div class="ls-rule-actions">
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditRule(rule)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ConfirmDeleteRule(rule)" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </div>
                            </div>
                            <div class="ls-rule-meta">
                                <span class="ls-status-pill @(rule.IsActive ? "ls-status-pill--active" : "ls-status-pill--inactive")">@(rule.IsActive ? "Active" : "Inactive")</span>
                                <span class="ls-points-pill @PointsClass(rule.PointValue)">@FormatPoints(rule.PointValue)</span>
                                <span class="ls-order-pill">Order @rule.SortOrder</span>
                            </div>
                            <div class="ls-rule-cond">
                                <span>Condition</span>
                                <strong>@RuleCondition(rule)</strong>
                            </div>
                            <div class="ls-rule-footer">
                                <span><i class="bi bi-diagram-3" aria-hidden="true"></i> @rule.Operator</span>
                                <span><i class="bi bi-database-check" aria-hidden="true"></i> Tenant scoped</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div class="um-grid-card ls-panel ls-preview-panel h-100 position-relative">
            <div class="ls-panel-header ls-panel-header--compact">
                <div class="ls-panel-title-wrap">
                    <span class="ls-panel-icon ls-panel-icon--preview"><i class="bi bi-people" aria-hidden="true"></i></span>
                    <div>
                        <h3>Scored Leads Preview</h3>
                        <p>Review lead scores affected by configured factors.</p>
                    </div>
                </div>
            </div>
            <div class="ls-preview-toolbar">
                <SfTextBox Placeholder="Search leads..." @bind-Value="_searchTerm" Width="100%"></SfTextBox>
                <button class="um-btn um-btn-primary um-btn-sm" @onclick="LoadAsync"><i class="bi bi-search" aria-hidden="true"></i></button>
            </div>
            <div class="ls-preview-grid app-datagrid">
            <SfGrid TValue="LeadScoreRow" DataSource="_filtered" AllowPaging="true" AllowSorting="true" Height="520px" EnableHover="true" RowHeight="52">
                <GridPageSettings PageSize="10" PageSizes="@(new[] { 10, 25, 50 })"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(LeadScoreRow.Rating)" HeaderText="Rating" Width="100">
                        <Template>@{ var r = (LeadScoreRow)context; }<span class="badge @RatingClass(r.Rating)">@r.Rating</span></Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(LeadScoreRow.FullName)" HeaderText="Lead" Width="180">
                        <Template>
                            @{ var r = (LeadScoreRow)context; }
                            <div class="fw-semibold">@r.FullName</div>
                            <div class="text-muted small">@r.AccountName</div>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(LeadScoreRow.Score)" HeaderText="Score" Width="90" TextAlign="TextAlign.Right">
                        <Template>@{ var r = (LeadScoreRow)context; }<strong>@r.Score</strong></Template>
                    </GridColumn>
                    <GridColumn HeaderText="" Width="70" TextAlign="TextAlign.Right">
                        <Template>@{ var r = (LeadScoreRow)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/crm/leads/{r.LeadId}")'><i class="bi bi-arrow-right" aria-hidden="true"></i></button></Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
            </div>
        </div>
    </div>
</div>

@if (_showRuleForm)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseRuleForm">
        <div class="mt-modal ls-rule-modal" role="dialog" aria-modal="true" aria-labelledby="leadScoringRuleTitle" @onclick:stopPropagation="true">
            <EditForm Model="_ruleForm" OnValidSubmit="SaveRuleAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-header">
                    <i class="bi bi-sliders" aria-hidden="true"></i>
                    <span id="leadScoringRuleTitle">@(_editingRuleId == Guid.Empty ? "New Scoring Factor" : "Edit Scoring Factor")</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseRuleForm" aria-label="Close"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Factor name <span class="text-danger">*</span></label>
                            <InputText class="um-input" @bind-Value="_ruleForm.RuleName" />
                            <ValidationMessage For="() => _ruleForm.RuleName" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Category <span class="text-danger">*</span></label>
                            <InputSelect class="um-input" @bind-Value="_ruleForm.Field">
                                @foreach (var item in _fieldOptions)
                                {
                                    <option value="@item.Value">@item.Label</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _ruleForm.Field" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Condition <span class="text-danger">*</span></label>
                            <InputSelect class="um-input" @bind-Value="_ruleForm.Operator">
                                @foreach (var item in _operatorOptions)
                                {
                                    <option value="@item.Value">@item.Label</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _ruleForm.Operator" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Value</label>
                            <InputText class="um-input" @bind-Value="_ruleForm.Value" placeholder="Example: 14, Opened, Enterprise" />
                            <ValidationMessage For="() => _ruleForm.Value" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Points <span class="text-danger">*</span></label>
                            <InputNumber class="um-input" @bind-Value="_ruleForm.Points" />
                            <ValidationMessage For="() => _ruleForm.Points" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Sort order</label>
                            <InputNumber class="um-input" @bind-Value="_ruleForm.SortOrder" />
                            <ValidationMessage For="() => _ruleForm.SortOrder" class="text-danger" />
                        </div>
                        <div class="um-field um-field--checkbox">
                            <label><InputCheckbox @bind-Value="_ruleForm.IsActive" /> Active</label>
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseRuleForm">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_savingRule">
                        <i class="bi bi-check-lg" aria-hidden="true"></i> Save Factor
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_deleteRule is not null)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CancelDeleteRule">
        <div class="mt-modal ls-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="deleteRuleTitle" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-modal-header">
                    <i class="bi bi-trash" aria-hidden="true"></i>
                    <span id="deleteRuleTitle">Delete Scoring Factor</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CancelDeleteRule" aria-label="Close"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="um-modal-body">
                    <p>Delete <strong>@_deleteRule.RuleName</strong>? This removes the factor from future lead scoring.</p>
                </div>
                <div class="um-modal-footer">
                    <button class="um-btn um-btn-ghost" @onclick="CancelDeleteRule">Cancel</button>
                    <button class="um-btn um-btn-danger" @onclick="DeleteRuleAsync"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }
.ls-factor-kpi { margin-bottom: 1.25rem; }
.ls-factor-kpi .pc-kpi-card { cursor: pointer; transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease; }
.ls-factor-kpi .pc-kpi-card:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(15,23,42,.10); }
.ls-factor-layout { align-items: stretch; }
.ls-panel { padding: 0 !important; overflow: hidden; border: 1px solid rgba(148,163,184,.22); box-shadow: 0 18px 45px rgba(15,23,42,.07); }
.ls-panel-header { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; padding:1.15rem 1.25rem; border-bottom:1px solid rgba(148,163,184,.18); background:linear-gradient(135deg, rgba(248,250,252,.96), rgba(239,246,255,.72)); }
.ls-panel-header--compact { padding-bottom: .95rem; }
.ls-panel-title-wrap { display:flex; align-items:flex-start; gap:.8rem; min-width:0; }
.ls-panel-icon { width:2.35rem; height:2.35rem; border-radius:.8rem; display:inline-flex; align-items:center; justify-content:center; color:#2563eb; background:linear-gradient(135deg,#dbeafe,#eff6ff); box-shadow:inset 0 0 0 1px rgba(37,99,235,.14); flex:0 0 auto; }
.ls-panel-icon--preview { color:#7c3aed; background:linear-gradient(135deg,#ede9fe,#f5f3ff); box-shadow:inset 0 0 0 1px rgba(124,58,237,.14); }
.ls-panel-title-wrap h3 { margin:0; font-size:1rem; font-weight:800; color:#0f172a; letter-spacing:-.01em; }
.ls-panel-title-wrap p { margin:.15rem 0 0; color:#64748b; font-size:.82rem; line-height:1.35; }
.ls-rules-grid { padding:1.25rem; display:grid; grid-template-columns:repeat(auto-fill, minmax(19rem, 1fr)); gap:1rem; }
.ls-rule-card { position:relative; padding:1rem; border:1px solid rgba(148,163,184,.24); border-radius:1rem; background:linear-gradient(180deg,#fff,rgba(248,250,252,.96)); box-shadow:0 10px 25px rgba(15,23,42,.06); transition:transform .16s ease, box-shadow .16s ease, border-color .16s ease; }
.ls-rule-card:hover { transform:translateY(-2px); border-color:rgba(37,99,235,.35); box-shadow:0 18px 38px rgba(15,23,42,.10); }
.ls-rule-hdr { display:flex; align-items:flex-start; justify-content:space-between; gap:.75rem; margin-bottom:.85rem; }
.ls-rule-heading { display:flex; align-items:center; gap:.7rem; min-width:0; }
.ls-rule-avatar { width:2.45rem; height:2.45rem; border-radius:.85rem; display:inline-flex; align-items:center; justify-content:center; flex:0 0 auto; }
.ls-rule-avatar--positive { color:#047857; background:#d1fae5; }
.ls-rule-avatar--negative { color:#b91c1c; background:#fee2e2; }
.ls-rule-avatar--neutral { color:#475569; background:#e2e8f0; }
.ls-rule-title { font-weight:800; color:#0f172a; line-height:1.2; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:14rem; }
.ls-rule-subtitle { color:#64748b; font-size:.75rem; margin-top:.1rem; }
.ls-rule-actions { display:flex; gap:.25rem; flex:0 0 auto; }
.ls-rule-meta { display:flex; align-items:center; flex-wrap:wrap; gap:.4rem; margin-bottom:.8rem; }
.ls-status-pill, .ls-points-pill, .ls-order-pill { display:inline-flex; align-items:center; border-radius:999px; padding:.22rem .55rem; font-size:.72rem; font-weight:800; line-height:1; }
.ls-status-pill--active { color:#047857; background:#d1fae5; }
.ls-status-pill--inactive { color:#475569; background:#e2e8f0; }
.ls-points-pill--positive { color:#047857; background:#dcfce7; }
.ls-points-pill--negative { color:#b91c1c; background:#fee2e2; }
.ls-points-pill--neutral { color:#475569; background:#e2e8f0; }
.ls-order-pill { color:#334155; background:#f1f5f9; }
.ls-rule-cond { display:flex; flex-direction:column; gap:.25rem; padding:.75rem; border-radius:.8rem; background:#f8fafc; border:1px solid rgba(148,163,184,.20); }
.ls-rule-cond span { color:#64748b; font-size:.7rem; text-transform:uppercase; font-weight:800; letter-spacing:.05em; }
.ls-rule-cond strong { color:#0f172a; font-size:.86rem; line-height:1.35; }
.ls-rule-footer { display:flex; align-items:center; justify-content:space-between; gap:.5rem; margin-top:.8rem; color:#64748b; font-size:.75rem; }
.ls-rule-footer span { display:inline-flex; align-items:center; gap:.35rem; }
.ls-empty-state { margin:1.25rem; min-height:22rem; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:2rem; border:1px dashed rgba(148,163,184,.45); border-radius:1rem; background:linear-gradient(180deg,#fff,#f8fafc); }
.ls-empty-state i { font-size:2.4rem; color:#94a3b8; margin-bottom:.75rem; }
.ls-empty-state h4 { margin:0; font-size:1rem; font-weight:800; color:#0f172a; }
.ls-empty-state p { margin:.4rem 0 1rem; color:#64748b; max-width:28rem; }
.ls-preview-toolbar { display:flex; align-items:center; gap:.5rem; padding:1rem 1rem .8rem; }
.ls-preview-grid { padding:0 1rem 1rem; }
.ls-rule-modal { width:min(56rem, calc(100vw - 2rem)) !important; }
.ls-confirm-modal { width:min(32rem, calc(100vw - 2rem)) !important; }
.ls-rule-modal .um-input { width:100%; padding:.55rem .75rem; border:1px solid var(--border-color); border-radius:var(--r-md); background:var(--surface-input); color:var(--text-primary); font:inherit; }
.ls-rule-modal .um-input:focus { outline:none; border-color:var(--brand-500); box-shadow:var(--ring); }
@@media (max-width: 768px) {
    .ls-panel-header { flex-direction:column; }
    .ls-rules-grid { grid-template-columns:1fr; padding:1rem; }
    .ls-rule-title { max-width:11rem; }
}
</style>

@code {
    private Guid _tenantId;
    private string? _searchTerm;
    private string? _loadError;
    private string? _activeFilter;
    private string? _factorFilter;
    private bool _loading;
    private bool _showRuleForm;
    private bool _savingRule;
    private Guid _editingRuleId = Guid.Empty;
    private LeadScoringRuleForm _ruleForm = new();
    private LeadScoringRuleDto? _deleteRule;
    private List<LeadScoreRow> _leads = [];
    private List<LeadScoreRow> _filtered = [];
    private List<LeadScoringRuleDto> _rules = [];

    private List<LeadScoringRuleDto> FilteredRules => _factorFilter switch
    {
        "Active" => _rules.Where(x => x.IsActive).ToList(),
        "Inactive" => _rules.Where(x => !x.IsActive).ToList(),
        "Positive" => _rules.Where(x => x.PointValue > 0).ToList(),
        "Negative" => _rules.Where(x => x.PointValue < 0).ToList(),
        _ => [.. _rules]
    };

    private static readonly List<LabelValue> _fieldOptions =
    [
        new("CompanySize", "Company size"),
        new("EmailOpened", "Email opened"),
        new("WebsiteVisits", "Website visits"),
        new("Title", "Title match"),
        new("StaleDays", "Stale age"),
        new("Source", "Lead source"),
        new("AnnualRevenue", "Annual revenue"),
    ];

    private static readonly List<LabelValue> _operatorOptions =
    [
        new("Equals", "Equals"),
        new("Contains", "Contains"),
        new("GreaterThan", "Greater than"),
        new("LessThan", "Less than"),
        new("IsNotEmpty", "Is not empty"),
        new("OlderThanDays", "Older than days"),
    ];

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Lead Scoring Factors", null));
        await LoadAsync();
        _ = StartLeadScoringRealtimeAsync();
    }

    private async Task OnLeadScoresChangedAsync(Guid tenantId)
    {
        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task StartLeadScoringRealtimeAsync()
    {
        try
        {
            if (_tenantId != Guid.Empty)
            {
                await LeadScoringRealtime.StartAsync(_tenantId, OnLeadScoresChangedAsync);
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Real-time lead scoring updates are unavailable: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync() => await LeadScoringRealtime.DisposeAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            if (_tenantId == Guid.Empty)
            {
                _tenantId = (await CurrentUser.RequireAsync()).TenantId;
            }

            var leadsResult = await Api.SearchLeadsAsync(_tenantId, _searchTerm);
            var rules = await Api.GetLeadScoringRulesAsync(_tenantId);

            _leads = (leadsResult?.Items ?? [])
                .Select(l => new LeadScoreRow(
                    l.LeadId,
                    $"{l.FirstName} {l.LastName}".Trim(),
                    l.AccountName ?? "—",
                    l.SourceCode ?? "—",
                    l.InterestedService ?? "—",
                    l.Score ?? 0,
                    Rating(l.Score ?? 0),
                    l.CreatedDateUtc))
                .OrderByDescending(l => l.Score)
                .ToList();
            _rules = rules?.ToList() ?? [];
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load lead scoring: {ex.Message}";
            _leads = [];
            _filtered = [];
            _rules = [];
        }
        finally { _loading = false; }
    }

    private void SetFilter(string? filter)
    {
        _activeFilter = filter;
        ApplyFilter();
    }

    private void SetFactorFilter(string? filter) => _factorFilter = filter;

    private void ApplyFilter() => _filtered = _activeFilter switch
    {
        "Hot" => _leads.Where(x => x.Score >= 80).ToList(),
        "Warm" => _leads.Where(x => x.Score is >= 50 and < 80).ToList(),
        "Cold" => _leads.Where(x => x.Score < 50).ToList(),
        _ => [.. _leads]
    };

    private static string Rating(int score) => score >= 80 ? "Hot" : score >= 50 ? "Warm" : "Cold";
    private static string RatingClass(string rating) => rating switch
    {
        "Hot" => "bg-danger",
        "Warm" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private void OpenCreateRule()
    {
        _editingRuleId = Guid.Empty;
        _ruleForm = new()
        {
            Field = "CompanySize",
            Operator = "GreaterThan",
            Points = 20,
            SortOrder = _rules.Count == 0 ? 10 : _rules.Max(r => r.SortOrder) + 10,
            IsActive = true
        };
        _showRuleForm = true;
    }

    private void OpenEditRule(LeadScoringRuleDto rule)
    {
        _editingRuleId = rule.LeadScoringRuleId;
        _ruleForm = new()
        {
            RuleName = rule.RuleName,
            Field = string.IsNullOrWhiteSpace(rule.Field) ? "CompanySize" : rule.Field,
            Operator = string.IsNullOrWhiteSpace(rule.Operator) ? "Equals" : rule.Operator,
            Value = rule.Value,
            Points = rule.PointValue,
            IsActive = rule.IsActive,
            SortOrder = rule.SortOrder
        };
        _showRuleForm = true;
    }

    private void CloseRuleForm() => _showRuleForm = false;

    private async Task SaveRuleAsync()
    {
        _savingRule = true;
        try
        {
            if (_editingRuleId == Guid.Empty)
            {
                await Api.CreateLeadScoringRuleAsync(new CreateLeadScoringRuleRequest
                {
                    TenantId = _tenantId,
                    RuleName = _ruleForm.RuleName.Trim(),
                    Field = _ruleForm.Field,
                    Operator = _ruleForm.Operator,
                    Value = _ruleForm.Value?.Trim() ?? string.Empty,
                    Points = _ruleForm.Points,
                    IsActive = _ruleForm.IsActive,
                    SortOrder = _ruleForm.SortOrder
                });
            }
            else
            {
                await Api.UpdateLeadScoringRuleAsync(_editingRuleId, new UpdateLeadScoringRuleRequest
                {
                    ScoringRuleId = _editingRuleId,
                    TenantId = _tenantId,
                    RuleName = _ruleForm.RuleName.Trim(),
                    Field = _ruleForm.Field,
                    Operator = _ruleForm.Operator,
                    Value = _ruleForm.Value?.Trim() ?? string.Empty,
                    Points = _ruleForm.Points,
                    IsActive = _ruleForm.IsActive,
                    SortOrder = _ruleForm.SortOrder
                });
            }

            _showRuleForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to save scoring factor: {ex.Message}";
        }
        finally
        {
            _savingRule = false;
        }
    }

    private void ConfirmDeleteRule(LeadScoringRuleDto rule) => _deleteRule = rule;
    private void CancelDeleteRule() => _deleteRule = null;

    private async Task DeleteRuleAsync()
    {
        if (_deleteRule is null) return;
        try
        {
            await Api.DeleteLeadScoringRuleAsync(_deleteRule.LeadScoringRuleId);
            _deleteRule = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to delete scoring factor: {ex.Message}";
        }
    }

    private static string RuleCondition(LeadScoringRuleDto rule)
    {
        var field = _fieldOptions.FirstOrDefault(x => x.Value == rule.Field)?.Label ?? rule.Field;
        var op = _operatorOptions.FirstOrDefault(x => x.Value == rule.Operator)?.Label ?? rule.Operator;
        return string.IsNullOrWhiteSpace(rule.Value) ? $"{field} · {op}" : $"{field} · {op} · {rule.Value}";
    }

    private static string FieldLabel(string field) => _fieldOptions.FirstOrDefault(x => x.Value == field)?.Label ?? field;

    private static string RuleIcon(LeadScoringRuleDto rule) => rule.Field switch
    {
        "EmailOpened" => "bi bi-envelope-check",
        "WebsiteVisits" => "bi bi-globe2",
        "Title" => "bi bi-person-badge",
        "StaleDays" => "bi bi-hourglass-split",
        "Source" => "bi bi-share",
        "AnnualRevenue" => "bi bi-currency-dollar",
        _ => "bi bi-building"
    };

    private static string RuleAvatarClass(LeadScoringRuleDto rule) => rule.PointValue switch
    {
        > 0 => "ls-rule-avatar--positive",
        < 0 => "ls-rule-avatar--negative",
        _ => "ls-rule-avatar--neutral"
    };

    private static string FormatPoints(int points) => points > 0 ? $"+{points}" : points.ToString();
    private static string PointsClass(int points) => points < 0 ? "ls-points-pill--negative" : points > 0 ? "ls-points-pill--positive" : "ls-points-pill--neutral";

    private sealed record LeadScoreRow(Guid LeadId, string FullName, string AccountName, string SourceCode, string InterestedService, int Score, string Rating, DateTime CreatedDateUtc);
    private sealed record LabelValue(string Value, string Label);

    private sealed class LeadScoringRuleForm
    {
        [Required, StringLength(200)]
        public string RuleName { get; set; } = string.Empty;

        [Required, StringLength(100)]
        public string Field { get; set; } = "CompanySize";

        [Required, StringLength(50)]
        public string Operator { get; set; } = "Equals";

        [StringLength(500)]
        public string? Value { get; set; }

        [Range(-1000, 1000)]
        public int Points { get; set; }

        public bool IsActive { get; set; } = true;

        [Range(0, 100000)]
        public int SortOrder { get; set; }
    }
}
