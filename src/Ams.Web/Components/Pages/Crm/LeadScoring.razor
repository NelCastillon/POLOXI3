    private void OpenCreateRule()
    {
        _editingRuleId = Guid.Empty;
        _ruleForm = new()
        {
            Field = "CompanySize",
            Operator = "GreaterThan",
            Points = 20,
            SortOrder = _rules.Count == 0 ? 10 : _rules.Max(r => r.SortOrder) + 10,
            IsActive = true
        };
        _showRuleForm = true;
    }

    private void OpenEditRule(LeadScoringRuleDto rule)
    {
        _editingRuleId = rule.LeadScoringRuleId;
        _ruleForm = new()
        {
            RuleName = rule.RuleName,
            Field = string.IsNullOrWhiteSpace(rule.Field) ? "CompanySize" : rule.Field,
            Operator = string.IsNullOrWhiteSpace(rule.Operator) ? "Equals" : rule.Operator,
            Value = rule.Value,
            Points = rule.PointValue,
            IsActive = rule.IsActive,
            SortOrder = rule.SortOrder
        };
        _showRuleForm = true;
    }

    private void CloseRuleForm() { if (!_savingRule) _showRuleForm = false; }
    private Task HandleInvalidRuleSubmitAsync(EditContext _) => ShowToastAsync("Fix validation errors.", "warning");

    private async Task SaveRuleAsync()
    {
        _savingRule = true;
        try
        {
            if (_editingRuleId == Guid.Empty)
            {
                var id = await Api.CreateLeadScoringRuleAsync(new CreateLeadScoringRuleRequest { TenantId = _tenantId, RuleName = _ruleForm.RuleName.Trim(), Field = _ruleForm.Field, Operator = _ruleForm.Operator, Value = _ruleForm.Value?.Trim() ?? string.Empty, Points = _ruleForm.Points, IsActive = _ruleForm.IsActive, SortOrder = _ruleForm.SortOrder });
                await ShowToastAsync("Scoring factor created.", "success");
                _editingRuleId = id;
            }
            else
            {
                await Api.UpdateLeadScoringRuleAsync(_editingRuleId, new UpdateLeadScoringRuleRequest { ScoringRuleId = _editingRuleId, TenantId = _tenantId, RuleName = _ruleForm.RuleName.Trim(), Field = _ruleForm.Field, Operator = _ruleForm.Operator, Value = _ruleForm.Value?.Trim() ?? string.Empty, Points = _ruleForm.Points, IsActive = _ruleForm.IsActive, SortOrder = _ruleForm.SortOrder });
                await ShowToastAsync("Scoring factor saved.", "success");
            }
            _showRuleForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to save scoring factor: {ex.Message}";
            await ShowToastAsync("Save failed.", "danger");
        }
        finally { _savingRule = false; }
    }

    private async Task ToggleRuleActiveAsync(LeadScoringRuleDto rule)
    {
        try
        {
            await Api.UpdateLeadScoringRuleAsync(rule.LeadScoringRuleId, new UpdateLeadScoringRuleRequest { ScoringRuleId = rule.LeadScoringRuleId, TenantId = _tenantId, RuleName = rule.RuleName, Field = rule.Field, Operator = rule.Operator, Value = rule.Value, Points = rule.PointValue, IsActive = !rule.IsActive, SortOrder = rule.SortOrder });
            await ShowToastAsync(!rule.IsActive ? "Scoring factor activated." : "Scoring factor paused.", "success");
            await LoadAsync();
        }
        catch (Exception ex) { await ShowToastAsync($"Toggle failed: {ex.Message}", "danger"); }
    }

    private async Task DuplicateRuleAsync(LeadScoringRuleDto rule)
    {
        try
        {
            await Api.CreateLeadScoringRuleAsync(new CreateLeadScoringRuleRequest { TenantId = _tenantId, RuleName = $"{rule.RuleName} Copy", Field = rule.Field, Operator = rule.Operator, Value = rule.Value, Points = rule.PointValue, IsActive = false, SortOrder = _rules.Count == 0 ? 10 : _rules.Max(r => r.SortOrder) + 10 });
            await ShowToastAsync("Scoring factor duplicated as inactive.", "success");
            await LoadAsync();
        }
        catch (Exception ex) { await ShowToastAsync($"Duplicate failed: {ex.Message}", "danger"); }
    }

    private void ConfirmDeleteRule(LeadScoringRuleDto rule) => OpenConfirm(new("Delete scoring factor", $"Delete {rule.RuleName}? This removes it from future lead scoring.", "Delete", "um-btn-danger", "bi-trash", "danger", () => DeleteRuleAsync(rule)));

    private async Task DeleteRuleAsync(LeadScoringRuleDto rule)
    {
        await Api.DeleteLeadScoringRuleAsync(rule.LeadScoringRuleId);
        if (_selectedRule?.LeadScoringRuleId == rule.LeadScoringRuleId) _selectedRule = null;
        await ShowToastAsync("Scoring factor deleted.", "success");
        await LoadAsync();
    }

    private void ActivateAllRules()
    {
        if (_rules.Count == 0) { _ = ShowToastAsync("No scoring factors to activate.", "warning"); return; }
        OpenConfirm(new("Activate scoring factors", $"Activate {_rules.Count(x => !x.IsActive)} inactive scoring factor(s)?", "Activate", "um-btn-primary", "bi-check2-circle", "warning", ActivateAllRulesAsync));
    }

    private async Task ActivateAllRulesAsync()
    {
        foreach (var rule in _rules.Where(x => !x.IsActive))
        {
            await Api.UpdateLeadScoringRuleAsync(rule.LeadScoringRuleId, new UpdateLeadScoringRuleRequest { ScoringRuleId = rule.LeadScoringRuleId, TenantId = _tenantId, RuleName = rule.RuleName, Field = rule.Field, Operator = rule.Operator, Value = rule.Value, Points = rule.PointValue, IsActive = true, SortOrder = rule.SortOrder });
        }
        await ShowToastAsync("Scoring factors activated.", "success");
        await LoadAsync();
    }

    private async Task SeedDefaultRulesAsync()
    {
        if (_rules.Count > 0) { await ShowToastAsync("Default scoring data already exists.", "info"); return; }
        OpenConfirm(new("Seed default scoring", "Create enterprise default lead scoring factors for this tenant?", "Seed defaults", "um-btn-primary", "bi-stars", "warning", CreateDefaultRulesAsync));
    }

    private async Task CreateDefaultRulesAsync()
    {
        var defaults = new[]
        {
            new LeadScoringRuleSeed("High annual revenue", "AnnualRevenue", "GreaterThan", "100000", 20, 10),
            new LeadScoringRuleSeed("Referral source", "Source", "Equals", "Referral", 15, 20),
            new LeadScoringRuleSeed("Website engagement", "WebsiteVisits", "GreaterThan", "3", 12, 30),
            new LeadScoringRuleSeed("Opened nurture email", "EmailOpened", "Equals", "true", 8, 40),
            new LeadScoringRuleSeed("Stale lead penalty", "StaleDays", "OlderThanDays", "30", -15, 50)
        };
        foreach (var rule in defaults)
        {
            await Api.CreateLeadScoringRuleAsync(new CreateLeadScoringRuleRequest { TenantId = _tenantId, RuleName = rule.RuleName, Field = rule.Field, Operator = rule.Operator, Value = rule.Value, Points = rule.Points, IsActive = true, SortOrder = rule.SortOrder });
        }
        await ShowToastAsync("Default scoring factors seeded.", "success");
        await LoadAsync();
    }

    private void OpenConfirm(ConfirmAction action) { _confirmAction = action; _showConfirm = true; }
    private void CancelConfirm() { if (!_busy) { _showConfirm = false; _confirmAction = null; } }
    private async Task ExecuteConfirmedAsync() { if (_confirmAction is null) return; _busy = true; try { var action = _confirmAction; await action.ExecuteAsync(); _showConfirm = false; _confirmAction = null; } catch (Exception ex) { await ShowToastAsync($"Action failed: {ex.Message}", "danger"); } finally { _busy = false; } }

    private async Task ShowToastAsync(string message, string kind = "info")
    {
        _toastCts?.Cancel(); _toastCts?.Dispose(); _toastCts = new CancellationTokenSource();
        _toastMessage = message.Length <= 96 ? message : $"{message[..93]}..."; _toastKind = ToastKind(kind); _toastVisible = true; StateHasChanged();
        _ = HideToastAfterDelayAsync(_toastCts.Token, _toastKind == "danger" ? 5200 : 2800);
        await Task.CompletedTask;
    }

    private async Task HideToastAfterDelayAsync(CancellationToken cancellationToken, int delayMs)
    {
        try { await Task.Delay(delayMs, cancellationToken); _toastVisible = false; await InvokeAsync(StateHasChanged); } catch (TaskCanceledException) { }
    }

    private void HideToast() { _toastCts?.Cancel(); _toastVisible = false; }
    private static string ToastKind(string value) => value.Contains("danger", StringComparison.OrdinalIgnoreCase) || value.Contains("error", StringComparison.OrdinalIgnoreCase) ? "danger" : value.Contains("warning", StringComparison.OrdinalIgnoreCase) ? "warning" : value.Contains("success", StringComparison.OrdinalIgnoreCase) ? "success" : "info";
    private static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static string Rating(int score) => score >= 80 ? "Hot" : score >= 50 ? "Warm" : "Cold";
    private static string NormalizeStage(string? stage, int statusCode) => !string.IsNullOrWhiteSpace(stage) ? stage.Trim() switch { "Closed" => "Lost", "Won" => "Converted", var s => s } : statusCode switch { 2 => "Contacted", 3 => "Qualified", 4 => "Converted", 5 => "Lost", _ => "New" };
    private static string RuleCondition(LeadScoringRuleDto rule) { var field = FieldLabel(rule.Field); var op = _operatorOptions.FirstOrDefault(x => x.Value == rule.Operator)?.Label ?? rule.Operator; return string.IsNullOrWhiteSpace(rule.Value) ? $"{field} - {op}" : $"{field} - {op} - {rule.Value}"; }
    private static string FieldLabel(string field) => _fieldOptions.FirstOrDefault(x => x.Value == field)?.Label ?? field;
    private static string RuleIcon(LeadScoringRuleDto rule) => rule.Field switch { "EmailOpened" => "bi bi-envelope-check", "WebsiteVisits" => "bi bi-globe2", "Title" => "bi bi-person-badge", "StaleDays" => "bi bi-hourglass-split", "Source" => "bi bi-share", "AnnualRevenue" => "bi bi-currency-dollar", _ => "bi bi-building" };
    private static string RuleAvatarClass(LeadScoringRuleDto rule) => rule.PointValue switch { > 0 => "ls-rule-avatar-positive", < 0 => "ls-rule-avatar-negative", _ => "ls-rule-avatar-neutral" };
    private static string FormatPoints(int points) => points > 0 ? $"+{points}" : points.ToString();
    private static string PointsClass(int points) => points < 0 ? "ls-points-negative" : points > 0 ? "ls-points-positive" : "ls-points-neutral";
    private string MetricCardClass(KpiModel metric) => $"ls-kpi-card {metric.Tone} {(_quickFilter == metric.Filter && !string.IsNullOrWhiteSpace(metric.Filter) ? "ls-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewDef view) => _view == view.Id ? "ls-view-btn ls-view-btn-active" : "ls-view-btn";
    private string LeadRowClass(LeadScoreRow lead) => lead.LeadId == _selectedLead?.LeadId ? "ls-row-selected" : string.Empty;
    private string SourceRowClass(string source) => _sourceFilter == source ? "ls-funnel-row ls-active" : "ls-funnel-row";
    private static string RatingBadge(string rating) => rating switch { "Hot" => "ls-rating ls-rating-hot", "Warm" => "ls-rating ls-rating-warm", _ => "ls-rating ls-rating-cold" };
    private static string StageBadge(string stage) => $"ls-stage ls-stage-{stage.ToLowerInvariant().Replace(' ', '-')}";
    private static string SourceIcon(string source) => source switch { "Referral" => "bi-share-fill", "Website" => "bi-globe", "Cold Call" => "bi-telephone-fill", "Social" => "bi-instagram", "Email" => "bi-envelope-fill", "Event" => "bi-calendar-event-fill", "Partner" => "bi-handshake-fill", _ => "bi-inbox-fill" };
    private static string ScoreTone(int score) => score >= 80 ? "ls-score-hot" : score >= 50 ? "ls-score-warm" : "ls-score-cold";
    private static string AvatarColor(string name) { var colors = new[] { "ls-av1", "ls-av2", "ls-av3", "ls-av4", "ls-av5", "ls-av6" }; return colors[Math.Abs(name.GetHashCode()) % colors.Length]; }
    private static string Initials(string name) { var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length > 0 ? name[..1] : "?"; }

    private sealed record ViewDef(string Id, string Label, string Icon);
    private sealed record LabelValue(string Value, string Label);
