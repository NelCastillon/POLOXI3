    private sealed record ConfirmAction(string Title, string Message, string ButtonText, string ButtonClass, string Icon, string Kind, Func<Task> ExecuteAsync);
    private sealed record DistributionRow(string Label, int Count, double WidthPercent, string Tone) { public double Percent { get; init; } }
    private sealed record SourceBreakdownRow(string Source, int Total, int AvgScore, double WidthPercent);
    private sealed record LeadScoringRuleSeed(string RuleName, string Field, string Operator, string Value, int Points, int SortOrder);
    private sealed record LeadScoreRow(Guid LeadId, string FullName, string AccountName, string Email, string SourceCode, string InterestedService, int Score, string Rating, string Stage, decimal EstPremium, DateTime CreatedDateUtc, DateTime? ModifiedDateUtc);

    private sealed class LeadScoringRuleForm
    {
        [Required, StringLength(200)] public string RuleName { get; set; } = string.Empty;
        [Required, StringLength(100)] public string Field { get; set; } = "CompanySize";
        [Required, StringLength(50)] public string Operator { get; set; } = "Equals";
        [StringLength(500)] public string? Value { get; set; }
        [Range(-1000, 1000)] public int Points { get; set; }
        public bool IsActive { get; set; } = true;
        [Range(0, 100000)] public int SortOrder { get; set; }
    }
