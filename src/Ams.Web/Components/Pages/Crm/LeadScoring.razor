    private void OpenLeadInCrm(LeadScoreRow lead) => Nav.NavigateTo($"/crm/leads?search={Uri.EscapeDataString(lead.Email)}");
    private void SelectRule(LeadScoringRuleDto rule) { _selectedRule = rule; _selectedLead = null; }
    private void SelectLead(LeadScoreRow lead) { _selectedLead = lead; _selectedRule = null; }
    private void SelectSource(string source) { _sourceFilter = _sourceFilter == source ? string.Empty : source; _view = "leads"; }
    private void SetQuickFilter(string filter) { _quickFilter = _quickFilter == filter ? string.Empty : filter; if (filter is "Hot") _view = "leads"; else _view = "rules"; }
    private void ResetFilters() { _searchTerm = string.Empty; _factorFilter = string.Empty; _ratingFilter = string.Empty; _sourceFilter = string.Empty; _quickFilter = string.Empty; }
    private void OnSearchChanged(BlazorChangeEventArgs e) => _searchTerm = e.Value?.ToString() ?? string.Empty;
    private void OnFactorFilterChanged(BlazorChangeEventArgs e) { _factorFilter = e.Value?.ToString() ?? string.Empty; _quickFilter = string.Empty; }
    private void OnRatingFilterChanged(BlazorChangeEventArgs e) { _ratingFilter = e.Value?.ToString() ?? string.Empty; _quickFilter = string.Empty; _view = "leads"; }
