    private double CompletionRate => _items.Count == 0 ? 0 : (double)_items.Count(x => x.Status == "Completed") / _items.Count * 100;
    private IReadOnlyList<FollowUpRow> OverdueRows => _filtered.Where(x => x.IsOverdue).OrderBy(x => x.DueDate).ToList();
    private IReadOnlyList<FollowUpRow> DueTodayRows => _filtered.Where(x => x.DueDate.Date == DateTime.Today && !x.IsClosed).OrderBy(x => x.DueDate).ToList();
    private IReadOnlyList<FollowUpRow> UpcomingRows => _filtered.Where(x => x.DueDate.Date > DateTime.Today && x.DueDate.Date <= DateTime.Today.AddDays(7) && !x.IsClosed).OrderBy(x => x.DueDate).ToList();
    private IReadOnlyList<FollowUpRow> SelectedDateRows => _selectedDate.HasValue ? _filtered.Where(x => x.DueDate.Date == _selectedDate.Value.Date).OrderBy(x => x.DueDate).ToList() : [];
    private string ToastIcon => _toastKind == "danger" ? "bi-exclamation-octagon" : _toastKind == "warning" ? "bi-exclamation-triangle" : _toastKind == "success" ? "bi-check2-circle" : "bi-info-circle";

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Leads", "/crm/leads"), new("Follow-up", "/crm/leads/follow-up"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = string.Empty;
        try
        {
            if (_tenantId == Guid.Empty) await ResolveCurrentUserContextAsync();
            var leadsResult = await Api.SearchLeadsAsync(_tenantId);
            var leads = leadsResult?.Items?.ToList() ?? [];
            await EnsureSeedDataAsync(leads);
            leadsResult = await Api.SearchLeadsAsync(_tenantId);
            leads = leadsResult?.Items?.ToList() ?? [];
            _leadOptions = leads.Select(l => new LeadOption(l.LeadId, $"{l.FirstName} {l.LastName}".Trim(), l.AccountName ?? "Unknown")).Where(x => !string.IsNullOrWhiteSpace(x.Name)).OrderBy(x => x.Name).ToList();
            var leadLookup = _leadOptions.ToDictionary(x => x.Id);
            var activities = await Api.SearchLeadActivitiesAsync(_tenantId);
            _items = activities?.Items?.Where(a => a.LeadId.HasValue && IsFollowUpActivity(a)).Select(a => MapFollowUp(a, leadLookup)).OrderBy(x => x.DueDate).ToList() ?? [];
            ApplyFilters(false);
            _detail = _detail is null ? _filtered.FirstOrDefault() : _filtered.FirstOrDefault(x => x.Id == _detail.Id) ?? _filtered.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _items = [];
            ApplyFilters(false);
            await ShowToastAsync($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters(bool resetDetail = true)
    {
        IEnumerable<FollowUpRow> query = _items;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            query = query.Where(x => Contains(x.LeadName, term) || Contains(x.CompanyName, term) || Contains(x.ActivityType, term) || Contains(x.ContactMethod, term) || Contains(x.Priority, term) || Contains(x.Status, term) || Contains(x.Notes ?? string.Empty, term));
        }
        if (!string.IsNullOrWhiteSpace(_statusFilter)) query = query.Where(x => x.Status == _statusFilter);
        if (!string.IsNullOrWhiteSpace(_priorityFilter)) query = query.Where(x => x.Priority == _priorityFilter);
        if (!string.IsNullOrWhiteSpace(_activityFilter)) query = query.Where(x => x.ActivityType == _activityFilter);
        query = _kpiFilter switch
        {
            "scheduled" => query.Where(x => !x.IsClosed),
            "overdue" => query.Where(x => x.IsOverdue),
            "today" => query.Where(x => x.DueDate.Date == DateTime.Today && !x.IsClosed),
            "completed" => query.Where(x => x.Status == "Completed" && x.DueDate >= DateTime.Today.AddDays(-7)),
            _ => query
        };
        _filtered = query.OrderBy(x => x.IsClosed).ThenBy(x => x.DueDate).ToList();
        if (resetDetail) _detail = _filtered.FirstOrDefault(x => x.Id == _detail?.Id) ?? _filtered.FirstOrDefault();
    }

    private void ClearFilters() { _search = string.Empty; _statusFilter = string.Empty; _priorityFilter = string.Empty; _activityFilter = string.Empty; _kpiFilter = string.Empty; ApplyFilters(); }
    private void SetKpiFilter(string filter) { _kpiFilter = _kpiFilter == filter ? string.Empty : filter; _view = "list"; ApplyFilters(); }
    private void SetView(string view) => _view = view;
    private void ShowDashboard() => _view = "dashboard";
    private void ShowCalendar() => _view = "calendar";
    private void ShowAnalytics() => _view = "analytics";
    private void ShowOverdue() { _kpiFilter = "overdue"; _view = "list"; ApplyFilters(); }
    private void SelectDetail(FollowUpRow item) => _detail = item;
    private void PreviousMonth() => _currentMonth = _currentMonth.AddMonths(-1);
    private void NextMonth() => _currentMonth = _currentMonth.AddMonths(1);
    private void SelectDate(DateTime date) { _selectedDate = date.Date; _view = "calendar"; }

