@page "/crm/leads/follow-up"
@namespace Ams.Web.Components.Pages.Crm
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.LeadActivities
@using Ams.Application.Features.Leads
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Lead Follow-up - CRM</PageTitle>

@if (_toastVisible)
{
    <div class="lf-toast lf-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIcon" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="lf-toast-close" @onclick="HideToast" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="lf-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="lf-followup-modal" role="dialog" aria-modal="true" aria-labelledby="followupFormTitle" @onclick:stopPropagation="true">
            <EditForm Model="_form" OnValidSubmit="SaveFollowUpAsync" OnInvalidSubmit="HandleInvalidSubmitAsync">
                <DataAnnotationsValidator />
                <div class="lf-modal-header">
                    <div class="lf-modal-title">
                        <span class="lf-modal-icon"><i class="bi bi-calendar-plus" aria-hidden="true"></i></span>
                        <div>
                            <h2 id="followupFormTitle">@(_editingId == Guid.Empty ? "Schedule follow-up" : "Edit follow-up")</h2>
                            <p>Capture the next action, due date, owner context, and workflow status.</p>
                        </div>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseForm" aria-label="Close follow-up form"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="lf-modal-body">
                    <div class="lf-form-banner">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <div>
                            <strong>LeadActivity backed workflow</strong>
                            <span>Follow-ups are saved to CRM.LeadActivity with tenant scope and activity audit fields.</span>
                        </div>
                    </div>
                    <div class="lf-form-grid">
                        <div class="lf-field lf-field-wide">
                            <label for="leadSelect">Lead <span>*</span></label>
                            <InputSelect id="leadSelect" class="lf-input" @bind-Value="_form.LeadId">
                                <option value="@Guid.Empty">Select lead...</option>
                                @foreach (var lead in _leadOptions)
                                {
                                    <option value="@lead.Id">@lead.Name - @lead.Company</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="lf-field">
                            <label for="activityType">Activity type <span>*</span></label>
                            <InputSelect id="activityType" class="lf-input" @bind-Value="_form.ActivityType">
                                <option value="">Select activity...</option>
                                @foreach (var option in _activityTypeOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="lf-field">
                            <label for="dueDate">Due date <span>*</span></label>
                            <InputDate id="dueDate" class="lf-input" @bind-Value="_form.DueDate" />
                        </div>
                        <div class="lf-field">
                            <label for="priority">Priority <span>*</span></label>
                            <InputSelect id="priority" class="lf-input" @bind-Value="_form.Priority">
                                @foreach (var option in _priorityOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="lf-field">
                            <label for="contactMethod">Contact method <span>*</span></label>
                            <InputSelect id="contactMethod" class="lf-input" @bind-Value="_form.ContactMethod">
                                @foreach (var option in _contactMethodOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="lf-field">
                            <label for="status">Status <span>*</span></label>
                            <InputSelect id="status" class="lf-input" @bind-Value="_form.Status">
                                @foreach (var option in _statusOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="lf-field">
                            <label for="duration">Duration minutes</label>
                            <InputNumber id="duration" class="lf-input" @bind-Value="_form.DurationMinutes" />
                        </div>
                        <div class="lf-field lf-field-wide">
                            <label for="notes">Notes</label>
                            <InputTextArea id="notes" class="lf-input lf-textarea" @bind-Value="_form.Notes" placeholder="Coverage interests, timing, decision process, or next best action..." />
                        </div>
                    </div>
                </div>
                <div class="lf-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi @(_saving ? "bi-arrow-repeat lf-spin" : "bi-check2")" aria-hidden="true"></i> @(_editingId == Guid.Empty ? "Schedule" : "Save")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showDeleteConfirm && _deleteTarget is not null)
{
    <div class="lf-modal-backdrop" role="presentation" @onclick="CancelDelete">
        <div class="lf-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="deleteFollowupTitle" @onclick:stopPropagation="true">
            <div class="lf-confirm-icon lf-confirm-danger"><i class="bi bi-trash3-fill" aria-hidden="true"></i></div>
            <h2 id="deleteFollowupTitle">Delete follow-up</h2>
            <p>Delete follow-up for <strong>@_deleteTarget.LeadName</strong>? This keeps the database row soft-deleted through the existing API.</p>
            <div class="lf-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
            </div>
        </div>
    </div>
}

<div class="lf-enterprise-page">
    <section class="lf-hero">
        <div class="lf-hero-left">
            <span class="lf-hero-icon"><i class="bi bi-calendar2-check-fill" aria-hidden="true"></i></span>
            <div>
                <div class="lf-title-row">
                    <h1>Lead Follow-up</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> CRM.LeadActivity</span>
                    <span><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span>
                </div>
                <p>Schedule, prioritize, complete, and audit lead follow-ups through a governed CRM activity workflow.</p>
            </div>
        </div>
        <div class="lf-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh follow-ups"><i class="bi @(_loading ? "bi-arrow-repeat lf-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenNewFollowUp" title="Schedule follow-up"><i class="bi bi-plus-circle" aria-hidden="true"></i> Schedule Follow-up</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="lf-error-banner" style="border-left: 4px solid #dc3545; animation: lf-shake 0.3s ease;"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="lf-kpi-strip" aria-label="Lead follow-up metrics">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" title="@metric.Tooltip" @onclick="@(() => SetKpiFilter(metric.Filter))">
                <span class="lf-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span><span class="lf-kpi-val">@metric.Value</span><span class="lf-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
            </button>
        }
    </section>

    <section class="lf-workflow-strip" aria-label="Follow-up workflow shortcuts">
        <button type="button" class="lf-workflow-card" @onclick="ShowDashboard"><i class="bi bi-inbox" aria-hidden="true"></i><span><strong>My queue</strong><span>Overdue, due today, and upcoming work.</span></span></button>
        <button type="button" class="lf-workflow-card" @onclick="ShowCalendar"><i class="bi bi-calendar3" aria-hidden="true"></i><span><strong>Calendar</strong><span>Review daily follow-up load.</span></span></button>
        <button type="button" class="lf-workflow-card" @onclick="ShowOverdue"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><span><strong>Overdue focus</strong><span>Filter records requiring action.</span></span></button>
        <button type="button" class="lf-workflow-card" @onclick="ShowAnalytics"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span><strong>Analytics</strong><span>Measure status, type, and priority mix.</span></span></button>
    </section>

    <section class="lf-search-panel">
        <div class="lf-search-wrap">
            <i class="bi bi-search lf-search-icon" aria-hidden="true"></i>
            <div class="lf-search-body">
                <label for="followupSearchInput">Search follow-ups</label>
                <input id="followupSearchInput" class="lf-search-input" @bind-value="Search" @bind-value:event="oninput" placeholder="Search lead, company, activity, contact, status, priority, or notes..." />
                <span class="lf-search-hint">Filters the current tenant-scoped CRM activity dataset instantly.</span>
            </div>
        </div>
        <select class="lf-filter-select" @bind="StatusFilter"><option value="">All statuses</option>@foreach (var option in _statusOptions) { <option value="@option">@option</option> }</select>
        <select class="lf-filter-select" @bind="PriorityFilter"><option value="">All priorities</option>@foreach (var option in _priorityOptions) { <option value="@option">@option</option> }</select>
        <select class="lf-filter-select" @bind="ActivityFilter"><option value="">All activities</option>@foreach (var option in _activityTypeOptions) { <option value="@option">@option</option> }</select>
        <div class="lf-search-result"><strong>@_filtered.Count</strong><span>matches</span></div>
    </section>

    <section class="lf-view-tabs" aria-label="Follow-up views">
        @foreach (var view in _views)
        {
            <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label</button>
        }
    </section>

    <section class="lf-content-layout">
        <main class="lf-main-card">
            @if (_loading)
            {
                <div class="lf-loading"><i class="bi bi-arrow-repeat lf-spin" aria-hidden="true"></i><strong>Loading lead follow-up workspace...</strong></div>
            }
            else if (_filtered.Count == 0)
            {
                <div class="lf-empty-state"><i class="bi bi-calendar-x" aria-hidden="true"></i><strong>No follow-ups match this view</strong><span>Adjust filters or schedule a new follow-up.</span><div><button type="button" class="um-btn um-btn-ghost" @onclick="ClearFilters">Clear filters</button><button type="button" class="um-btn um-btn-primary" @onclick="OpenNewFollowUp">Schedule follow-up</button></div></div>
            }
            else if (_view == "dashboard")
            {
                <div class="lf-dashboard-grid">
                    <section class="lf-queue-section lf-overdue-section"><header><span><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> Overdue</span><strong>@OverdueRows.Count</strong></header>@if (OverdueRows.Count == 0) { <div class="lf-mini-empty">No overdue follow-ups</div> } else { @foreach (var item in OverdueRows.Take(6)) { <article class="lf-followup-card lf-card-overdue" @onclick="@(() => SelectDetail(item))"><div class="lf-card-head"><div><strong>@item.LeadName</strong><span>@item.CompanyName</span></div><span class="@StatusClass(item.Status)">@item.Status</span></div><div class="lf-card-body"><span><i class="bi @ActivityIcon(item.ActivityType)" aria-hidden="true"></i> @item.ActivityType</span><span><i class="bi bi-calendar" aria-hidden="true"></i> @item.DueDate.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture)</span><span><i class="bi bi-broadcast" aria-hidden="true"></i> @item.ContactMethod</span></div><div class="lf-card-actions" @onclick:stopPropagation="true">@if (!item.IsClosed) { <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="@(() => CompleteFollowUpAsync(item))"><i class="bi bi-check2" aria-hidden="true"></i> Complete</button> }<button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenEdit(item))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></div></article> } }</section>
                    <section class="lf-queue-section lf-today-section"><header><span><i class="bi bi-calendar-day" aria-hidden="true"></i> Due today</span><strong>@DueTodayRows.Count</strong></header>@if (DueTodayRows.Count == 0) { <div class="lf-mini-empty">No follow-ups due today</div> } else { @foreach (var item in DueTodayRows.Take(6)) { <article class="lf-followup-card lf-card-today" @onclick="@(() => SelectDetail(item))"><div class="lf-card-head"><div><strong>@item.LeadName</strong><span>@item.CompanyName</span></div><span class="@StatusClass(item.Status)">@item.Status</span></div><div class="lf-card-body"><span><i class="bi @ActivityIcon(item.ActivityType)" aria-hidden="true"></i> @item.ActivityType</span><span><i class="bi bi-calendar" aria-hidden="true"></i> @item.DueDate.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture)</span><span><i class="bi bi-broadcast" aria-hidden="true"></i> @item.ContactMethod</span></div><div class="lf-card-actions" @onclick:stopPropagation="true">@if (!item.IsClosed) { <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="@(() => CompleteFollowUpAsync(item))"><i class="bi bi-check2" aria-hidden="true"></i> Complete</button> }<button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenEdit(item))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></div></article> } }</section>
                    <section class="lf-queue-section lf-upcoming-section"><header><span><i class="bi bi-calendar-week" aria-hidden="true"></i> Next 7 days</span><strong>@UpcomingRows.Count</strong></header>@if (UpcomingRows.Count == 0) { <div class="lf-mini-empty">No upcoming follow-ups</div> } else { @foreach (var item in UpcomingRows.Take(6)) { <article class="lf-followup-card lf-card-upcoming" @onclick="@(() => SelectDetail(item))"><div class="lf-card-head"><div><strong>@item.LeadName</strong><span>@item.CompanyName</span></div><span class="@StatusClass(item.Status)">@item.Status</span></div><div class="lf-card-body"><span><i class="bi @ActivityIcon(item.ActivityType)" aria-hidden="true"></i> @item.ActivityType</span><span><i class="bi bi-calendar" aria-hidden="true"></i> @item.DueDate.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture)</span><span><i class="bi bi-broadcast" aria-hidden="true"></i> @item.ContactMethod</span></div><div class="lf-card-actions" @onclick:stopPropagation="true">@if (!item.IsClosed) { <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="@(() => CompleteFollowUpAsync(item))"><i class="bi bi-check2" aria-hidden="true"></i> Complete</button> }<button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenEdit(item))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></div></article> } }</section>
                </div>
            }
            else if (_view == "calendar")
            {
                <div class="lf-calendar-layout">
                    <section>
                        <div class="lf-calendar-header"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousMonth"><i class="bi bi-chevron-left" aria-hidden="true"></i></button><h3>@_currentMonth.ToString("MMMM yyyy", CultureInfo.CurrentCulture)</h3><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextMonth"><i class="bi bi-chevron-right" aria-hidden="true"></i></button></div>
                        <div class="lf-calendar-grid">
                            @foreach (var day in _dayNames)
                            {
                                <div class="lf-calendar-day-name">@day</div>
                            }
                            @foreach (var day in CalendarDays)
                            {
                                var dayRows = _filtered.Where(x => x.DueDate.Date == day.Date).ToList();
                                <button type="button" class="@CalendarDayClass(day)" @onclick="@(() => SelectDate(day))">
                                    <span>@day.Day</span>
                                    <small>@dayRows.Count</small>
                                    <div>@foreach (var item in dayRows.Take(3)) { <i class="@StatusDotClass(item.Status)" title="@item.LeadName"></i> }</div>
                                </button>
                            }
                        </div>
                    </section>
                    <aside class="lf-calendar-detail"><h3>@(_selectedDate?.ToString("MMM d, yyyy", CultureInfo.CurrentCulture) ?? "Select a date")</h3>@if (SelectedDateRows.Count == 0) { <div class="lf-mini-empty">No follow-ups for this date.</div> } else { @foreach (var item in SelectedDateRows) { <article class="lf-followup-card lf-card-calendar" @onclick="@(() => SelectDetail(item))"><div class="lf-card-head"><div><strong>@item.LeadName</strong><span>@item.CompanyName</span></div><span class="@StatusClass(item.Status)">@item.Status</span></div><div class="lf-card-body"><span><i class="bi @ActivityIcon(item.ActivityType)" aria-hidden="true"></i> @item.ActivityType</span><span><i class="bi bi-calendar" aria-hidden="true"></i> @item.DueDate.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture)</span><span><i class="bi bi-broadcast" aria-hidden="true"></i> @item.ContactMethod</span></div><div class="lf-card-actions" @onclick:stopPropagation="true">@if (!item.IsClosed) { <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="@(() => CompleteFollowUpAsync(item))"><i class="bi bi-check2" aria-hidden="true"></i> Complete</button> }<button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenEdit(item))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></div></article> } }</aside>
                </div>
            }
            else if (_view == "analytics")
            {
                <div class="lf-analytics-grid">
                    <section><h3>Status distribution</h3>@foreach (var row in StatusBreakdown) { <div class="lf-meter-row"><span>@row.Label</span><div><i style="width:@row.Width%"></i></div><strong>@row.Count</strong></div> }</section>
                    <section><h3>Activity mix</h3>@foreach (var row in ActivityBreakdown) { <div class="lf-meter-row"><span>@row.Label</span><div><i style="width:@row.Width%"></i></div><strong>@row.Count</strong></div> }</section>
                    <section><h3>Priority mix</h3>@foreach (var row in PriorityBreakdown) { <div class="lf-meter-row"><span>@row.Label</span><div><i style="width:@row.Width%"></i></div><strong>@row.Count</strong></div> }</section>
                    <section><h3>Completion trend</h3><div class="lf-trend">@foreach (var day in CompletionTrend) { <span style="height:@day.Height%" title="@day.Label: @day.Count completed"></span> }</div></section>
                </div>
            }
            else
            {
                <div class="lf-table-scroll">
                    <table class="lf-table">
                        <thead><tr><th>Lead</th><th>Activity</th><th>Due</th><th>Priority</th><th>Status</th><th>Contact</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var item in _filtered)
                            {
                                <tr class="@RowClass(item)" @onclick="@(() => SelectDetail(item))">
                                    <td><div class="lf-name-cell"><span class="lf-avatar @AvatarClass(item.LeadName)" aria-hidden="true">@Initials(item.LeadName)</span><span><strong>@item.LeadName</strong><small>@item.CompanyName</small></span></div></td>
                                    <td><span class="lf-activity-badge"><i class="bi @ActivityIcon(item.ActivityType)" aria-hidden="true"></i> @item.ActivityType</span></td>
                                    <td><div class="lf-date-cell"><strong>@item.DueDate.ToLocalTime().ToString("MMM d", CultureInfo.CurrentCulture)</strong><small>@DueLabel(item)</small></div></td>
                                    <td><span class="@PriorityClass(item.Priority)">@item.Priority</span></td>
                                    <td><span class="@StatusClass(item.Status)">@item.Status</span></td>
                                    <td>@item.ContactMethod</td>
                                    <td @onclick:stopPropagation="true"><div class="lf-row-actions">@if (!item.IsClosed) { <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => CompleteFollowUpAsync(item))" title="Complete"><i class="bi bi-check" aria-hidden="true"></i></button> }<button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => OpenEdit(item))" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ConfirmDelete(item))" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </main>

        <aside class="lf-detail-card">
            @if (_detail is null)
            {
                <div class="lf-detail-empty"><i class="bi bi-calendar2-check" aria-hidden="true"></i><strong>Select a follow-up</strong><span>Review next action details and workflow commands.</span></div>
            }
            else
            {
                <div class="lf-detail-head"><div><span class="lf-detail-eyebrow"><i class="bi @ActivityIcon(_detail.ActivityType)" aria-hidden="true"></i> @_detail.ActivityType</span><h2>@_detail.LeadName</h2><p>@_detail.CompanyName</p></div><span class="@StatusClass(_detail.Status)">@_detail.Status</span></div>
                <div class="lf-detail-body">
                    <div class="lf-detail-summary"><div><span>Due</span><strong>@_detail.DueDate.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture)</strong></div><div><span>Priority</span><strong>@_detail.Priority</strong></div><div><span>Contact</span><strong>@_detail.ContactMethod</strong></div><div><span>Duration</span><strong>@(_detail.DurationMinutes.HasValue ? $"{_detail.DurationMinutes} min" : "-")</strong></div></div>
                    <div class="lf-notes-card"><span><i class="bi bi-card-text" aria-hidden="true"></i> @(_detail.Notes ?? "No notes captured")</span></div>
                    <div class="lf-detail-actions">@if (!_detail.IsClosed) { <button type="button" class="um-btn um-btn-primary" @onclick="@(() => CompleteFollowUpAsync(_detail))"><i class="bi bi-check2" aria-hidden="true"></i> Complete</button> }<button type="button" class="um-btn um-btn-ghost" @onclick="@(() => RescheduleFollowUp(_detail))"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Reschedule</button><button type="button" class="um-btn um-btn-ghost" @onclick="@(() => OpenEdit(_detail))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-danger" @onclick="@(() => ConfirmDelete(_detail))"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    private Guid _tenantId;
    private Guid _userId;
    private bool _loading;
    private bool _saving;
    private bool _showForm;
    private bool _showDeleteConfirm;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "info";
    private string _loadError = string.Empty;
    private string _view = "dashboard";
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private string _priorityFilter = string.Empty;
    private string _activityFilter = string.Empty;
    private string _kpiFilter = string.Empty;
    private Guid _editingId = Guid.Empty;
    private DateTime _currentMonth = DateTime.Today;
    private DateTime? _selectedDate = DateTime.Today;
    private CancellationTokenSource? _toastCts;
    private FollowUpRow? _detail;
    private FollowUpRow? _deleteTarget;
    private FollowUpFormModel _form = new();
    private List<LeadOption> _leadOptions = [];
    private List<FollowUpRow> _items = [];
    private List<FollowUpRow> _filtered = [];

    private static readonly ViewDef[] _views = [new("dashboard", "Queue", "bi-inbox"), new("list", "List", "bi-list-ul"), new("calendar", "Calendar", "bi-calendar3"), new("analytics", "Analytics", "bi-graph-up")];
    private static readonly string[] _activityTypeOptions = ["Phone Call", "Email", "Meeting", "Text", "LinkedIn", "Demo", "Proposal", "Check-in"];
    private static readonly string[] _priorityOptions = ["High", "Medium", "Low"];
    private static readonly string[] _contactMethodOptions = ["Phone Call", "Email", "Meeting", "Text", "LinkedIn", "Portal"];
    private static readonly string[] _statusOptions = ["Pending", "Completed", "Cancelled"];
    private static readonly string[] _dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    private string Search
    {
