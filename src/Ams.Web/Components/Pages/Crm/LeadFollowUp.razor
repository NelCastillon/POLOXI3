        _form = new FollowUpFormModel { LeadId = _leadOptions.FirstOrDefault()?.Id ?? Guid.Empty, ActivityType = "Phone Call", DueDate = DateTime.Today.AddDays(1), Priority = "Medium", ContactMethod = "Phone Call", Status = "Pending", DurationMinutes = 30 };
        _showForm = true;
    }

    private void OpenEdit(FollowUpRow item)
    {
        _editingId = item.Id;
        _form = new FollowUpFormModel { LeadId = item.LeadId, ActivityType = item.ActivityType, DueDate = item.DueDate, Priority = item.Priority, ContactMethod = item.ContactMethod, Status = item.Status == "Overdue" ? "Pending" : item.Status, DurationMinutes = item.DurationMinutes, Notes = item.Notes ?? string.Empty };
        _showForm = true;
    }

    private void RescheduleFollowUp(FollowUpRow item)
    {
        OpenEdit(item);
        _form.Status = "Pending";
        if (_form.DueDate.Date <= DateTime.Today) _form.DueDate = DateTime.Today.AddDays(1);
    }

    private void CloseForm() { if (!_saving) _showForm = false; }
    private void ConfirmDelete(FollowUpRow item) { _deleteTarget = item; _showDeleteConfirm = true; }
    private void CancelDelete() { if (!_saving) { _deleteTarget = null; _showDeleteConfirm = false; } }

    private async Task SaveFollowUpAsync()
    {
        _saving = true;
        try
        {
            var lead = _leadOptions.FirstOrDefault(x => x.Id == _form.LeadId);
            if (lead is null) { await ShowToastAsync("Select a valid lead.", "warning"); return; }
            if (_editingId == Guid.Empty)
            {
                await Api.CreateLeadActivityAsync(new CreateLeadActivityRequest { TenantId = _tenantId, LeadId = _form.LeadId, ActivityTypeCode = _form.ActivityType, Subject = SubjectFor(_form.ActivityType), Notes = ComposeNotes(_form.Priority, _form.ContactMethod, _form.Notes), ActivityDate = _form.DueDate, DurationMinutes = _form.DurationMinutes, OutcomeCode = _form.Status, CreatedByUserId = _userId });
                await ShowToastAsync($"Follow-up scheduled for {lead.Name}.", "success");
            }
            else
            {
                await Api.UpdateLeadActivityAsync(_editingId, ToUpdateRequest(_editingId, _form, _form.Status == "Completed"));
                await ShowToastAsync($"Follow-up updated for {lead.Name}.", "success");
            }
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private Task HandleInvalidSubmitAsync(EditContext _) => ShowToastAsync("Fix validation errors before saving.", "warning");

    private async Task CompleteFollowUpAsync(FollowUpRow item)
    {
        try
        {
            var form = new FollowUpFormModel { LeadId = item.LeadId, ActivityType = item.ActivityType, DueDate = item.DueDate, Priority = item.Priority, ContactMethod = item.ContactMethod, Status = "Completed", DurationMinutes = item.DurationMinutes, Notes = item.Notes ?? string.Empty };
            await Api.UpdateLeadActivityAsync(item.Id, ToUpdateRequest(item.Id, form, true));
            await ShowToastAsync($"Follow-up for {item.LeadName} completed.", "success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Complete failed: {ex.Message}", "danger");
        }
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        _saving = true;
        try
        {
            await Api.DeleteLeadActivityAsync(_deleteTarget.Id, _userId);
            await ShowToastAsync($"Follow-up for {_deleteTarget.LeadName} deleted.", "success");
            _deleteTarget = null;
            _showDeleteConfirm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Delete failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task EnsureSeedDataAsync(List<LeadDto> leads)
    {
        var seedLeads = leads.Where(l => l.LeadNumber.StartsWith("LFU-", StringComparison.OrdinalIgnoreCase)).ToList();
        if (seedLeads.Count == 0)
        {
            var seeds = new[]
            {
                new LeadSeed("LFU-001", "Maya", "Patel", "Northstar Manufacturing", "maya.patel@northstarmfg.example", "(555) 410-1001", "Commercial Package"),
                new LeadSeed("LFU-002", "Ethan", "Brooks", "Harbor Retail Group", "ethan.brooks@harborretail.example", "(555) 410-1002", "Workers Comp"),
                new LeadSeed("LFU-003", "Olivia", "Reed", "Summit Dental Partners", "olivia.reed@summitdental.example", "(555) 410-1003", "Professional Liability"),
                new LeadSeed("LFU-004", "Noah", "Kim", "Blue Ridge Logistics", "noah.kim@brlogistics.example", "(555) 410-1004", "Fleet Coverage")
            };
            foreach (var seed in seeds)
            {
                await Api.CreateLeadAsync(new CreateLeadRequest { TenantId = _tenantId, LeadNumber = seed.LeadNumber, FirstName = seed.FirstName, LastName = seed.LastName, AccountName = seed.AccountName, Email = seed.Email, Phone = seed.Phone, InterestedService = seed.InterestedService, SourceCode = "Referral", NurturingStageCode = "New", PriorityCode = "Warm", Score = 45, CreatedByUserId = _userId });
            }
            var refreshed = await Api.SearchLeadsAsync(_tenantId);
            seedLeads = refreshed?.Items?.Where(l => l.LeadNumber.StartsWith("LFU-", StringComparison.OrdinalIgnoreCase)).ToList() ?? [];
        }

        var activities = await Api.SearchLeadActivitiesAsync(_tenantId);
        if (activities?.Items?.Any(a => a.Subject.StartsWith("Follow-up:", StringComparison.OrdinalIgnoreCase)) == true) return;
        var templates = new[]
        {
            new FollowUpSeed("Phone Call", "High", "Phone Call", "Discuss current renewal concerns and timeline.", DateTime.Today.AddDays(-2), "Pending", 30),
            new FollowUpSeed("Email", "Medium", "Email", "Send required exposure details and document checklist.", DateTime.Today, "Pending", 15),
            new FollowUpSeed("Meeting", "Medium", "Meeting", "Coordinate producer meeting with decision makers.", DateTime.Today.AddDays(2), "Pending", 45),
            new FollowUpSeed("Demo", "Low", "Portal", "Show portal document center and self-service requests.", DateTime.Today.AddDays(5), "Pending", 30),
            new FollowUpSeed("Email", "Low", "Email", "Sent recap and next steps after first conversation.", DateTime.Today.AddDays(-3), "Completed", 10)
        };
        for (var i = 0; i < templates.Length && seedLeads.Count > 0; i++)
        {
            var lead = seedLeads[i % seedLeads.Count];
            var item = templates[i];
            await Api.CreateLeadActivityAsync(new CreateLeadActivityRequest { TenantId = _tenantId, LeadId = lead.LeadId, ActivityTypeCode = item.ActivityType, Subject = SubjectFor(item.ActivityType), Notes = ComposeNotes(item.Priority, item.ContactMethod, item.Notes), ActivityDate = item.DueDate, DurationMinutes = item.DurationMinutes, OutcomeCode = item.Status, CreatedByUserId = _userId });
        }
    }

    private IEnumerable<DateTime> CalendarDays
    {
        get
        {
            var first = new DateTime(_currentMonth.Year, _currentMonth.Month, 1);
            var start = first.AddDays(-(int)first.DayOfWeek);
            for (var i = 0; i < 42; i++) yield return start.AddDays(i);
        }
    }

    private IEnumerable<BreakdownRow> StatusBreakdown => BuildBreakdown(_items.GroupBy(x => x.Status).Select(g => (g.Key, g.Count())));
    private IEnumerable<BreakdownRow> ActivityBreakdown => BuildBreakdown(_items.GroupBy(x => x.ActivityType).Select(g => (g.Key, g.Count())));
    private IEnumerable<BreakdownRow> PriorityBreakdown => BuildBreakdown(_items.GroupBy(x => x.Priority).Select(g => (g.Key, g.Count())));
    private IEnumerable<TrendPoint> CompletionTrend => Enumerable.Range(0, 30).Select(i => DateTime.Today.AddDays(i - 29)).Select(day => { var count = _items.Count(x => x.Status == "Completed" && x.DueDate.Date == day); var max = Math.Max(1, _items.Count(x => x.Status == "Completed")); return new TrendPoint(day.ToString("MMM d", CultureInfo.CurrentCulture), count, Math.Max(8, (double)count / max * 100)); });

    private static IEnumerable<BreakdownRow> BuildBreakdown(IEnumerable<(string Label, int Count)> rows)
    {
        var list = rows.OrderByDescending(x => x.Count).ToList();
        var max = Math.Max(1, list.Select(x => x.Count).DefaultIfEmpty(1).Max());
        return list.Select(x => new BreakdownRow(x.Label, x.Count, (double)x.Count / max * 100));
    }

    private static bool IsFollowUpActivity(LeadActivityDto activity) => activity.Subject.StartsWith("Follow-up:", StringComparison.OrdinalIgnoreCase) || activity.Subject.Contains("follow", StringComparison.OrdinalIgnoreCase) || activity.ActivityTypeCode.Contains("follow", StringComparison.OrdinalIgnoreCase) || activity.OutcomeCode is "Pending" or "Completed" or "Cancelled";
    private static FollowUpRow MapFollowUp(LeadActivityDto activity, IReadOnlyDictionary<Guid, LeadOption> leadLookup)
    {
        var lead = activity.LeadId.HasValue && leadLookup.TryGetValue(activity.LeadId.Value, out var option) ? option : null;
        var notes = ParseNotes(activity.Notes, out var priority, out var contact);
        var status = activity.IsCompleted || string.Equals(activity.OutcomeCode, "Completed", StringComparison.OrdinalIgnoreCase) ? "Completed" : string.Equals(activity.OutcomeCode, "Cancelled", StringComparison.OrdinalIgnoreCase) ? "Cancelled" : activity.ActivityDate < DateTime.Now ? "Overdue" : "Pending";
        return new FollowUpRow(activity.ActivityId, activity.LeadId ?? Guid.Empty, activity.LeadName ?? lead?.Name ?? "Unknown Lead", lead?.Company ?? "-", activity.ActivityTypeCode, activity.ActivityDate, priority ?? PriorityFromDate(activity.ActivityDate, activity.IsCompleted), contact ?? ContactMethod(activity.ActivityTypeCode), status, notes, activity.DurationMinutes);
    }

    private static string ComposeNotes(string priority, string contactMethod, string? notes) => $"[Priority: {priority}] [Contact: {contactMethod}]\n{notes}".Trim();
    private static string? ParseNotes(string? source, out string? priority, out string? contact)
    {
        priority = null; contact = null;
        if (string.IsNullOrWhiteSpace(source)) return null;
        var text = source.Trim();
        if (text.StartsWith("[Priority:", StringComparison.OrdinalIgnoreCase))
        {
            var priorityEnd = text.IndexOf(']');
            if (priorityEnd > 0) priority = text[10..priorityEnd].Trim();
            var contactStart = text.IndexOf("[Contact:", StringComparison.OrdinalIgnoreCase);
            if (contactStart >= 0)
            {
                var contactEnd = text.IndexOf(']', contactStart);
                if (contactEnd > contactStart) contact = text[(contactStart + 9)..contactEnd].Trim();
                text = text[(contactEnd + 1)..].Trim();
            }
            else if (priorityEnd > 0)
            {
                text = text[(priorityEnd + 1)..].Trim();
            }
        }
        return string.IsNullOrWhiteSpace(text) ? null : text;
    }

    private UpdateLeadActivityRequest ToUpdateRequest(Guid id, FollowUpFormModel form, bool isCompleted) => new() { ActivityId = id, LeadId = form.LeadId, ActivityTypeCode = form.ActivityType, Subject = SubjectFor(form.ActivityType), Notes = ComposeNotes(form.Priority, form.ContactMethod, form.Notes), ActivityDate = form.DueDate, DurationMinutes = form.DurationMinutes, OutcomeCode = form.Status, IsCompleted = isCompleted, ModifiedByUserId = _userId };
    private static string SubjectFor(string activityType) => $"Follow-up: {activityType}"[..Math.Min(200, $"Follow-up: {activityType}".Length)];
    private static string ContactMethod(string activityType) => activityType switch { "Phone Call" or "Call" => "Phone Call", "Email" => "Email", "Meeting" => "Meeting", "Text" => "Text", "LinkedIn" => "LinkedIn", _ => activityType };
    private static string PriorityFromDate(DateTime dueDate, bool completed) => completed ? "Low" : dueDate.Date <= DateTime.Today ? "High" : dueDate.Date <= DateTime.Today.AddDays(2) ? "Medium" : "Low";
    private static bool Contains(string value, string term) => value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static string Initials(string name) { var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length > 0 ? name[..1] : "?"; }
    private static string AvatarClass(string name) { var classes = new[] { "lf-av1", "lf-av2", "lf-av3", "lf-av4", "lf-av5", "lf-av6" }; return classes[Math.Abs(name.GetHashCode()) % classes.Length]; }
    private static string ActivityIcon(string value) => value switch { "Phone Call" => "bi-telephone", "Email" => "bi-envelope", "Meeting" => "bi-people", "Text" => "bi-chat-dots", "LinkedIn" => "bi-linkedin", _ => "bi-calendar-check" };
    private static string PriorityClass(string value) => $"lf-priority lf-priority-{value.ToLowerInvariant()}";
    private static string StatusClass(string value) => $"lf-status lf-status-{value.ToLowerInvariant()}";
    private static string StatusDotClass(string value) => $"lf-dot lf-dot-{value.ToLowerInvariant()}";
    private static string DueLabel(FollowUpRow item) => item.Status == "Completed" ? "Completed" : item.IsOverdue ? $"{(DateTime.Today - item.DueDate.Date).Days} day(s) overdue" : item.DueDate.Date == DateTime.Today ? "Due today" : $"In {(item.DueDate.Date - DateTime.Today).Days} day(s)";
    private string RowClass(FollowUpRow item) => _detail?.Id == item.Id ? "lf-row-selected" : item.IsOverdue ? "lf-row-overdue" : item.IsClosed ? "lf-row-closed" : string.Empty;
    private string MetricCardClass(MetricCard metric) => $"lf-kpi-card {metric.Tone} {(_kpiFilter == metric.Filter && !string.IsNullOrWhiteSpace(metric.Filter) ? "lf-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewDef view) => _view == view.Id ? "lf-view-btn lf-view-btn-active" : "lf-view-btn";
    private string CalendarDayClass(DateTime day) => $"lf-calendar-day {(day.Month == _currentMonth.Month ? string.Empty : "lf-calendar-muted")} {(day.Date == DateTime.Today ? "lf-calendar-today" : string.Empty)} {(_selectedDate?.Date == day.Date ? "lf-calendar-selected" : string.Empty)}";

    private async Task ShowToastAsync(string message, string kind = "info")
    {
        _toastCts?.Cancel(); _toastCts?.Dispose(); _toastCts = new CancellationTokenSource();
        _toastMessage = message.Length <= 120 ? message : $"{message[..117]}..."; _toastKind = ToastKind(kind); _toastVisible = true; StateHasChanged();
        _ = HideToastAfterDelayAsync(_toastCts.Token, _toastKind == "danger" ? 5200 : 2800);
        await Task.CompletedTask;
    }

    private async Task HideToastAfterDelayAsync(CancellationToken cancellationToken, int delayMs)
    {
        try { await Task.Delay(delayMs, cancellationToken); _toastVisible = false; await InvokeAsync(StateHasChanged); } catch (TaskCanceledException) { }
    }

    private void HideToast() { _toastCts?.Cancel(); _toastVisible = false; }
    private static string ToastKind(string value) => value.Contains("danger", StringComparison.OrdinalIgnoreCase) || value.Contains("error", StringComparison.OrdinalIgnoreCase) ? "danger" : value.Contains("warning", StringComparison.OrdinalIgnoreCase) ? "warning" : value.Contains("success", StringComparison.OrdinalIgnoreCase) ? "success" : "info";
    private async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; _userId = context.UserId; }

    private sealed record ViewDef(string Id, string Label, string Icon);
    private sealed record MetricCard(string Label, string Value, string Caption, string Icon, string Tone, string Filter, string Tooltip);
    private sealed record LeadOption(Guid Id, string Name, string Company);
    private sealed record LeadSeed(string LeadNumber, string FirstName, string LastName, string AccountName, string Email, string Phone, string InterestedService);
    private sealed record FollowUpSeed(string ActivityType, string Priority, string ContactMethod, string Notes, DateTime DueDate, string Status, int DurationMinutes);
    private sealed record BreakdownRow(string Label, int Count, double Width);
    private sealed record TrendPoint(string Label, int Count, double Height);
    private sealed record FollowUpRow(Guid Id, Guid LeadId, string LeadName, string CompanyName, string ActivityType, DateTime DueDate, string Priority, string ContactMethod, string Status, string? Notes, int? DurationMinutes)
    {
        public bool IsClosed => Status is "Completed" or "Cancelled";
        public bool IsOverdue => DueDate < DateTime.Now && !IsClosed;
    }

    private sealed class FollowUpFormModel
    {
        [RequiredNonEmptyGuid]
        public Guid LeadId { get; set; }
        [Required, StringLength(50)]
        public string ActivityType { get; set; } = string.Empty;
        [Required]
        public DateTime DueDate { get; set; } = DateTime.Today.AddDays(1);
        [Required, StringLength(20)]
        public string Priority { get; set; } = "Medium";
        [Required, StringLength(50)]
        public string ContactMethod { get; set; } = "Phone Call";
        [Required, StringLength(50)]
        public string Status { get; set; } = "Pending";
        [Range(0, 1440)]
        public int? DurationMinutes { get; set; } = 30;
        [StringLength(2000)]
        public string Notes { get; set; } = string.Empty;
    }

    private sealed class RequiredNonEmptyGuidAttribute : ValidationAttribute
    {
        public override bool IsValid(object? value) => value is Guid id && id != Guid.Empty;
        public override string FormatErrorMessage(string name) => $"{name} is required.";
    }
}
