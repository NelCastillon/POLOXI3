@page "/crm/duplicates"
@namespace Ams.Web.Components.Pages.Crm
@using System.Globalization
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Duplicates
@using BlazorChangeEventArgs = Microsoft.AspNetCore.Components.ChangeEventArgs
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Enterprise Duplicate Management</PageTitle>

@if (_toastVisible)
{
    <div class="dup-toast dup-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="dup-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showConfirm && _confirmAction is not null)
{
    <div class="dup-modal-backdrop" role="presentation" @onclick="CancelConfirm">
        <div class="dup-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="duplicateConfirmTitle" @onclick:stopPropagation="true">
            <div class="dup-confirm-icon dup-confirm-@_confirmAction.Kind"><i class="bi @_confirmAction.Icon" aria-hidden="true"></i></div>
            <h2 id="duplicateConfirmTitle">@_confirmAction.Title</h2>
            <p>@_confirmAction.Message</p>
            @if (!string.IsNullOrWhiteSpace(_confirmAction.NotesLabel))
            {
                <textarea class="dup-input dup-textarea" @bind="_resolutionNotes" placeholder="@_confirmAction.NotesLabel"></textarea>
            }
            <div class="dup-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CancelConfirm" disabled="@_busy">Cancel</button>
                <button type="button" class="um-btn @_confirmAction.ButtonClass" @onclick="ExecuteConfirmedAsync" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    @_confirmAction.ButtonText
                </button>
            </div>
        </div>
    </div>
}

<div class="dup-enterprise-page">
    <section class="dup-hero">
        <div class="dup-hero-left">
            <span class="dup-hero-icon"><i class="bi bi-intersect" aria-hidden="true"></i></span>
            <div>
                <div class="dup-title-row">
                    <h1>Enterprise Duplicate Management</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live CRM workflow</span>
                    <span><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span>
                </div>
                <p>Scan accounts and contacts, compare candidate records, select a master, merge, dismiss, and audit duplicate decisions.</p>
            </div>
        </div>
        <div class="dup-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh duplicate workspace"><i class="bi @(_loading ? "bi-arrow-repeat dup-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-ghost" @onclick="RunScanAsync" disabled="@(_loading || _busy)" title="Run duplicate detection"><i class="bi @(_scanning ? "bi-hourglass-split dup-spin" : "bi-search")" aria-hidden="true"></i> @(_scanning ? "Scanning" : "Scan")</button>
            <button class="um-btn um-btn-ghost" @onclick="NavigateToAccounts" title="Open accounts"><i class="bi bi-building" aria-hidden="true"></i> Accounts</button>
            <button class="um-btn um-btn-primary" @onclick="ShowHighConfidence" title="Prioritize high confidence matches"><i class="bi bi-lightning-charge" aria-hidden="true"></i> High Confidence</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="dup-error-banner"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_loadError</div>
    }

    <section class="dup-kpi-strip" aria-label="Duplicate metrics">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" @onclick="@(() => SetQuickFilter(metric.Filter))">
                <span class="dup-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span><span class="dup-kpi-val">@metric.Value</span><span class="dup-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
            </button>
        }
    </section>

    <section class="dup-workflow-strip" aria-label="Duplicate workflow actions">
        <button class="dup-workflow-card" @onclick="RunScanAsync" disabled="@(_loading || _busy)"><i class="bi bi-search" aria-hidden="true"></i><span><strong>Scan CRM</strong><span>Detect account and contact duplicates.</span></span></button>
        <button class="dup-workflow-card" @onclick="ShowAccounts"><i class="bi bi-building" aria-hidden="true"></i><span><strong>Account review</strong><span>Focus duplicate organizations.</span></span></button>
        <button class="dup-workflow-card" @onclick="ShowContacts"><i class="bi bi-person-vcard" aria-hidden="true"></i><span><strong>Contact review</strong><span>Resolve duplicate people.</span></span></button>
        <button class="dup-workflow-card" @onclick="ShowResolved"><i class="bi bi-journal-check" aria-hidden="true"></i><span><strong>Resolved audit</strong><span>Review merged and dismissed groups.</span></span></button>
    </section>

    <section class="dup-search-panel">
        <div class="dup-search-wrap">
            <span class="dup-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="dup-search-body">
                <label for="duplicateSearchInput">Search duplicate workspace</label>
                <input id="duplicateSearchInput" class="dup-search-input" value="@_searchTerm" @oninput="OnSearchChanged" placeholder="Search name, email, phone, match reason, status, source, or confidence..." />
                <span class="dup-search-hint">Search filters loaded account/contact duplicate groups and record comparison fields.</span>
            </div>
        </div>
        <select class="dup-filter-select" value="@_entityFilter" @onchange="OnEntityFilterChanged">
            <option value="">All entities</option>
            <option value="Account">Accounts</option>
            <option value="Contact">Contacts</option>
        </select>
        <select class="dup-filter-select" value="@_confidenceFilter" @onchange="OnConfidenceFilterChanged">
            <option value="">All confidence</option>
            <option value="High">High confidence</option>
            <option value="Medium">Medium confidence</option>
            <option value="Low">Low confidence</option>
        </select>
        <select class="dup-filter-select" value="@_statusFilter" @onchange="OnStatusFilterChanged">
            <option value="">All statuses</option>
            @foreach (var status in StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
        <div class="dup-search-result"><strong>@FilteredGroups.Count</strong><span>groups</span></div>
    </section>

    <section class="dup-bulk-bar">
        <div>
            <strong>@_selectedGroupIds.Count selected</strong>
            <span>Select duplicate groups, then merge or dismiss them in one governed action.</span>
        </div>
        <div>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ToggleSelectVisible" disabled="@(FilteredOpenGroups.Count == 0)"><i class="bi bi-check2-square" aria-hidden="true"></i> Select visible</button>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearSelected" disabled="@(_selectedGroupIds.Count == 0)"><i class="bi bi-eraser" aria-hidden="true"></i> Clear</button>
            <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="ConfirmBulkMerge" disabled="@(_selectedGroupIds.Count == 0 || _busy)"><i class="bi bi-union" aria-hidden="true"></i> Merge selected</button>
            <button type="button" class="um-btn um-btn-danger um-btn-sm" @onclick="ConfirmBulkDismiss" disabled="@(_selectedGroupIds.Count == 0 || _busy)"><i class="bi bi-x-circle" aria-hidden="true"></i> Dismiss selected</button>
        </div>
    </section>

    <section class="dup-view-tabs" aria-label="Duplicate views">
        @foreach (var view in _views)
        {
            <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label</button>
        }
    </section>

    <section class="dup-content-layout">
        <main class="dup-main-card">
            @if (_loading)
            {
                <div class="dup-loading"><i class="bi bi-arrow-repeat dup-spin" aria-hidden="true"></i><strong>Loading duplicate workspace...</strong></div>
            }
            else if (_view == "groups")
            {
                <div class="dup-section-head">
                    <div><h2>Duplicate group resolution</h2><p>Compare records, choose the master, then merge or dismiss with confirmation.</p></div>
                    <button class="um-btn um-btn-primary um-btn-sm" @onclick="RunScanAsync" disabled="@(_busy || _scanning)"><i class="bi bi-search" aria-hidden="true"></i> Re-scan</button>
                </div>
                @if (FilteredOpenGroups.Count == 0)
                {
                    <div class="dup-empty-state"><i class="bi bi-check-circle" aria-hidden="true"></i><strong>No open duplicate groups match this view</strong><span>Adjust filters or run a CRM scan to detect new duplicate account and contact records.</span><button class="um-btn um-btn-primary" @onclick="RunScanAsync" disabled="@_scanning">Re-scan CRM</button></div>
                }
                else
                {
                    <div class="dup-groups-grid">
                        @foreach (var group in FilteredOpenGroups)
                        {
                            <article class="dup-group-card @GroupCardClass(group)" @onclick="@(() => CompareGroupAsync(group))">
                                <div class="dup-group-hdr">
                                    <div class="dup-select-wrap" @onclick:stopPropagation="true">
                                        <input type="checkbox" checked="@IsSelected(group.GroupId)" @onchange="@(() => ToggleSelected(group.GroupId))" aria-label="Select duplicate group" />
                                    </div>
                                    <div class="dup-group-title">
                                        <span class="dup-group-icon @ConfidenceAvatarClass(group.ConfidenceScore)"><i class="bi @EntityIcon(group.EntityType)" aria-hidden="true"></i></span>
                                        <div><strong>@group.PrimaryName</strong><span>@group.EntityType - @group.Records.Count records - @group.MatchReasons</span></div>
                                    </div>
                                    <div class="dup-group-actions" @onclick:stopPropagation="true">
                                        <button class="um-btn um-btn-primary um-btn-sm" @onclick="@(() => ConfirmMerge(group))" title="Merge duplicate group"><i class="bi bi-union" aria-hidden="true"></i> Merge</button>
                                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => ConfirmDismiss(group))" title="Dismiss duplicate group"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                                <div class="dup-group-meta">
                                    <span class="dup-confidence @ConfidenceClass(group.ConfidenceScore)">@group.ConfidenceScore% match</span>
                                    <span class="dup-status dup-status-open">@group.StatusCode</span>
                                    <span class="dup-reason"><i class="bi bi-lightning-charge" aria-hidden="true"></i> @group.MatchKey</span>
                                </div>
                                <div class="dup-record-compare">
                                    @foreach (var record in group.Records)
                                    {
                                        <div class="dup-record-card @(record.IsPrimary ? "dup-record-card-primary" : string.Empty)">
                                            <div class="dup-record-top"><span class="dup-avatar @AvatarColor(record.RecordName)" aria-hidden="true">@Initials(record.RecordName)</span><span><strong>@record.RecordName</strong><small>@record.SourceSystem - @FormatDate(record.CreatedDateUtc)</small></span></div>
                                            <div class="dup-record-lines">
                                                @foreach (var field in PreviewFields(record))
                                                {
                                                    <span><i class="bi bi-dot" aria-hidden="true"></i> @field.Key: @field.Value</span>
                                                }
                                            </div>
                                            @if (record.IsPrimary)
                                            {
                                                <span class="dup-primary-badge"><i class="bi bi-star-fill" aria-hidden="true"></i> Primary</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="@(() => SetPrimaryAsync(group, record))" @onclick:stopPropagation="true" disabled="@_busy">Set primary</button>
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            }
            else if (_view == "resolved")
            {
                <div class="dup-section-head"><div><h2>Resolved duplicate decisions</h2><p>Audit groups that were merged or dismissed by the duplicate workflow.</p></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="ShowGroups"><i class="bi bi-arrow-left" aria-hidden="true"></i> Open Groups</button></div>
                @if (FilteredResolvedGroups.Count == 0)
                {
                    <div class="dup-empty-state"><i class="bi bi-journal-check" aria-hidden="true"></i><strong>No resolved duplicates match this view</strong><span>Merge or dismiss a group to see it in the audit stream.</span><button class="um-btn um-btn-ghost" @onclick="ShowGroups">Review open groups</button></div>
                }
                else
                {
                    <div class="dup-history-list">
                        @foreach (var group in FilteredResolvedGroups)
                        {
                            <article class="dup-history-item" @onclick="@(() => CompareGroupAsync(group))">
                                <span class="dup-history-icon"><i class="bi @(group.StatusCode == "Merged" ? "bi-union" : "bi-x-circle")" aria-hidden="true"></i></span>
                                <div><strong>@group.StatusCode: @group.PrimaryName</strong><span>@group.EntityType - @group.Records.Count records - @FormatDateTime(group.ResolvedDateUtc)</span></div>
                                <span class="dup-confidence @ConfidenceClass(group.ConfidenceScore)">@group.ConfidenceScore%</span>
                            </article>
                        }
                    </div>
                }
            }
            else
            {
                <div class="dup-section-head"><div><h2>Duplicate analytics</h2><p>Monitor confidence, entity, and status distribution across the duplicate workspace.</p></div><button class="um-btn um-btn-ghost um-btn-sm" @onclick="RunScanAsync" disabled="@_scanning"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Refresh analytics</button></div>
                <div class="dup-analytics-grid">
                    <section>
                        <h3>Confidence distribution</h3>
                        @foreach (var row in ConfidenceDistribution)
                        {
                            <div class="dup-stage-row"><span>@row.Label</span><div><i class="@row.Tone" style="width:@row.WidthPercent%"></i></div><strong>@row.Count</strong><small>@row.Percent.ToString("F0", CultureInfo.CurrentCulture)%</small></div>
                        }
                    </section>
                    <section>
                        <h3>Entity distribution</h3>
                        @foreach (var row in EntityDistribution)
                        {
                            <button class="@EntityRowClass(row.Label)" @onclick="@(() => SelectEntity(row.Label))"><span><i class="bi @EntityIcon(row.Label)" aria-hidden="true"></i> @row.Label</span><div><i style="width:@row.WidthPercent%"></i></div><strong>@row.Count</strong><small>groups</small></button>
                        }
                    </section>
                </div>
            }
        </main>

        <aside class="dup-detail-card">
            @if (_selectedGroup is not null)
            {
                var primary = PrimaryRecord(_selectedGroup);
                <div class="dup-detail-head"><div><span class="dup-detail-eyebrow"><i class="bi @EntityIcon(_selectedGroup.EntityType)" aria-hidden="true"></i> @_selectedGroup.EntityType duplicate</span><h2>@_selectedGroup.PrimaryName</h2><p>@_selectedGroup.MatchReasons</p></div><span class="dup-confidence @ConfidenceClass(_selectedGroup.ConfidenceScore)">@_selectedGroup.ConfidenceScore%</span></div>
                <div class="dup-detail-body">
                    <div class="dup-detail-summary"><div><span>Records</span><strong>@_selectedGroup.Records.Count</strong></div><div><span>Primary</span><strong>@primary.RecordName</strong></div><div><span>Status</span><strong>@_selectedGroup.StatusCode</strong></div><div><span>Detected</span><strong>@FormatDate(_selectedGroup.DetectedDateUtc)</strong></div></div>
                    <div class="dup-rules-card">
                        <header><strong>Comparison fields</strong><span>@_selectedGroup.MatchKey</span></header>
                        @foreach (var field in CompareFields(_selectedGroup))
                        {
                            <p><em>@field</em><span>@DistinctValueCount(_selectedGroup, field) values</span></p>
                        }
                    </div>
                    <div class="dup-compare-table-wrap">
                        <table class="dup-compare-table">
                            <thead>
                                <tr>
                                    <th>Field</th>
                                    @foreach (var record in _selectedGroup.Records)
                                    {
                                        <th class="@(record.IsPrimary ? "dup-master-col" : string.Empty)">@record.RecordName</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var field in CompareFields(_selectedGroup))
                                {
                                    <tr class="@(HasConflict(_selectedGroup, field) ? "dup-row-conflict" : string.Empty)">
                                        <td>@field</td>
                                        @foreach (var record in _selectedGroup.Records)
                                        {
                                            <td>@FieldValue(record, field)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="dup-detail-actions">
                        <button class="um-btn um-btn-ghost" @onclick="@(() => OpenRecordInCrm(primary))"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Record</button>
                        @if (IsOpen(_selectedGroup))
                        {
                            <button class="um-btn um-btn-primary" @onclick="@(() => ConfirmMerge(_selectedGroup))" disabled="@_busy"><i class="bi bi-union" aria-hidden="true"></i> Merge</button>
                            <button class="um-btn um-btn-danger" @onclick="@(() => ConfirmDismiss(_selectedGroup))" disabled="@_busy"><i class="bi bi-x-circle" aria-hidden="true"></i> Dismiss</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="dup-detail-empty"><i class="bi bi-intersect" aria-hidden="true"></i><strong>Select a duplicate group</strong><span>Review duplicate intelligence, primary record, comparison fields, and resolution actions.</span></div>
            }
        </aside>
    </section>
</div>

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading = true;
    private bool _busy;
    private bool _scanning;
    private bool _showConfirm;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "info";
    private string _loadError = string.Empty;
    private string _activeFilter = string.Empty;
    private string _searchTerm = string.Empty;
    private string _entityFilter = string.Empty;
    private string _confidenceFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private string _view = "groups";
    private string _resolutionNotes = string.Empty;
    private CancellationTokenSource? _toastCts;
    private ConfirmAction? _confirmAction;
    private DuplicateGroupDto? _selectedGroup;
    private List<DuplicateGroupDto> _groups = [];
    private readonly HashSet<Guid> _selectedGroupIds = [];

    private static readonly List<ViewDef> _views = [new("groups", "Duplicate Groups", "bi-intersect"), new("resolved", "Resolved", "bi-journal-check"), new("analytics", "Analytics", "bi-graph-up-arrow")];

    private IEnumerable<string> StatusOptions => _groups.Select(g => g.StatusCode).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    private IEnumerable<KpiModel> Metrics =>
    [
        new("Open", OpenGroups.Count().ToString(CultureInfo.InvariantCulture), "Active groups", "bi-intersect", "dup-blue", ""),
        new("Accounts", _groups.Count(g => g.EntityType == "Account" && IsOpen(g)).ToString(CultureInfo.InvariantCulture), "Organizations", "bi-building", "dup-purple", "Account"),
        new("Contacts", _groups.Count(g => g.EntityType == "Contact" && IsOpen(g)).ToString(CultureInfo.InvariantCulture), "People", "bi-person-vcard", "dup-cyan", "Contact"),
        new("High", _groups.Count(g => IsOpen(g) && g.ConfidenceScore >= 90).ToString(CultureInfo.InvariantCulture), "Strong matches", "bi-lightning-charge", "dup-red", "High"),
        new("Resolved", _groups.Count(IsResolved).ToString(CultureInfo.InvariantCulture), "Merged or dismissed", "bi-check2-circle", "dup-green", "Resolved")
    ];

    private IEnumerable<DuplicateGroupDto> OpenGroups => _groups.Where(IsOpen);
    private List<DuplicateGroupDto> FilteredGroups => ApplyGroupFilters(_groups).ToList();
    private List<DuplicateGroupDto> FilteredOpenGroups => ApplyGroupFilters(OpenGroups).ToList();
    private List<DuplicateGroupDto> FilteredResolvedGroups => ApplyGroupFilters(_groups.Where(IsResolved)).ToList();

    private IEnumerable<DistributionRow> ConfidenceDistribution
    {
        get
        {
            var source = FilteredGroups;
            var total = Math.Max(1, source.Count);
            var rows = new[]
            {
                new DistributionRow("High", source.Count(x => x.ConfidenceScore >= 90), 0, "dup-dist-high"),
                new DistributionRow("Medium", source.Count(x => x.ConfidenceScore >= 70 && x.ConfidenceScore < 90), 0, "dup-dist-medium"),
                new DistributionRow("Low", source.Count(x => x.ConfidenceScore < 70), 0, "dup-dist-low")
            };
            var max = Math.Max(1, rows.Max(x => x.Count));
            return rows.Select(x => x with { WidthPercent = (double)x.Count / max * 100, Percent = (double)x.Count / total * 100 });
        }
    }

    private IEnumerable<DistributionRow> EntityDistribution
    {
        get
        {
            var rows = FilteredGroups.GroupBy(x => x.EntityType).Select(g => new DistributionRow(g.Key, g.Count(), 0, "dup-dist-entity")).ToList();
            var max = Math.Max(1, rows.Select(x => x.Count).DefaultIfEmpty(1).Max());
            return rows.OrderByDescending(x => x.Count).Select(x => x with { WidthPercent = (double)x.Count / max * 100 });
        }
    }

    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-octagon", "warning" => "bi-exclamation-triangle", "success" => "bi-check2-circle", _ => "bi-info-circle" };

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Duplicates", "/crm/duplicates"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = string.Empty;
        try
        {
            if (_tenantId == Guid.Empty) await ResolveCurrentUserContextAsync();
            var result = await Api.SearchDuplicatesAsync(new DuplicateSearchRequest { TenantId = _tenantId, PageNumber = 1, PageSize = 250 });
            _groups = result?.Items?.ToList() ?? [];
            _selectedGroupIds.RemoveWhere(id => _groups.All(g => g.GroupId != id || !IsOpen(g)));
            _selectedGroup = _selectedGroup is null ? FilteredGroups.FirstOrDefault() : _groups.FirstOrDefault(g => g.GroupId == _selectedGroup.GroupId) ?? FilteredGroups.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Duplicate workspace failed to load: {ex.Message}";
            _groups = [];
            await ShowToastAsync("Duplicate workspace failed to load.", "danger");
        }
        finally { _loading = false; }
    }

    private async Task RunScanAsync()
    {
        _busy = true;
        _scanning = true;
        try
        {
            var result = await Api.ScanDuplicatesAsync(new DuplicateScanRequest { TenantId = _tenantId, ScannedByUserId = _tenantAdminUserId });
            var inserted = result?.TotalCount ?? result?.Items?.Count ?? 0;
            await LoadAsync();
            await ShowToastAsync(inserted == 0 ? "Scan complete. No new duplicate groups were created." : $"Scan complete. {inserted} new duplicate group(s) created.", inserted == 0 ? "success" : "warning");
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"Duplicate scan failed: {ex.Message}", "danger");
        }
        finally
        {
            _scanning = false;
            _busy = false;
        }
    }

    private IEnumerable<DuplicateGroupDto> ApplyGroupFilters(IEnumerable<DuplicateGroupDto> groups)
    {
        var query = groups;
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(g => Contains(g.PrimaryName, term) || Contains(g.MatchReasons, term) || Contains(g.MatchKey, term) || Contains(g.EntityType, term) || Contains(g.StatusCode, term) || g.ConfidenceScore.ToString(CultureInfo.InvariantCulture).Contains(term, StringComparison.OrdinalIgnoreCase) || g.Records.Any(r => Contains(r.RecordName, term) || Contains(r.SourceSystem, term) || r.FieldValues.Any(f => Contains(f.Key, term) || Contains(f.Value, term))));
        }
        if (!string.IsNullOrWhiteSpace(_entityFilter)) query = query.Where(g => g.EntityType == _entityFilter);
        if (!string.IsNullOrWhiteSpace(_statusFilter)) query = query.Where(g => g.StatusCode == _statusFilter);
        query = _confidenceFilter switch
        {
            "High" => query.Where(g => g.ConfidenceScore >= 90),
            "Medium" => query.Where(g => g.ConfidenceScore >= 70 && g.ConfidenceScore < 90),
            "Low" => query.Where(g => g.ConfidenceScore < 70),
            _ => query
        };
        query = _activeFilter switch
        {
            "Account" => query.Where(g => g.EntityType == "Account"),
            "Contact" => query.Where(g => g.EntityType == "Contact"),
            "High" => query.Where(g => g.ConfidenceScore >= 90),
            "Resolved" => query.Where(IsResolved),
            _ => query
        };
        return query.OrderBy(g => IsOpen(g) ? 0 : 1).ThenByDescending(g => g.ConfidenceScore).ThenByDescending(g => g.DetectedDateUtc);
    }

    private void ConfirmMerge(DuplicateGroupDto group) => OpenConfirm(new("Merge duplicate records", $"Merge {Math.Max(0, group.Records.Count - 1)} duplicate record(s) into {PrimaryRecord(group).RecordName}?", "Merge", "um-btn-primary", "bi-union", "warning", "Optional merge notes", () => MergeAsync(group)));
    private void ConfirmDismiss(DuplicateGroupDto group) => OpenConfirm(new("Dismiss duplicate group", $"Dismiss the {group.MatchReasons} match for {group.PrimaryName}?", "Dismiss", "um-btn-danger", "bi-x-circle", "danger", "Optional dismissal notes", () => DismissAsync(group)));
    private void ConfirmBulkMerge() => OpenConfirm(new("Merge selected duplicate groups", $"Merge {_selectedGroupIds.Count} selected duplicate group(s)?", "Merge selected", "um-btn-primary", "bi-union", "warning", "Optional bulk merge notes", BulkMergeAsync));
    private void ConfirmBulkDismiss() => OpenConfirm(new("Dismiss selected duplicate groups", $"Dismiss {_selectedGroupIds.Count} selected duplicate group(s)?", "Dismiss selected", "um-btn-danger", "bi-x-circle", "danger", "Optional bulk dismissal notes", BulkDismissAsync));

    private async Task SetPrimaryAsync(DuplicateGroupDto group, DuplicateRecordDto record)
    {
        _busy = true;
        try
        {
            await RecordDecisionAsync(group, MatchReviewDecisionCodes.UseExisting, record.RecordId, $"Selected {record.RecordName} as the primary record.");
            await Api.SetDuplicatePrimaryAsync(group.GroupId, new DuplicateSetPrimaryRequest { PrimaryRecordId = record.RecordId, ModifiedByUserId = _tenantAdminUserId });
            await LoadAsync();
            await ShowToastAsync($"{record.RecordName} set as primary.", "success");
        }
        catch (Exception ex) { await ShowToastAsync($"Set primary failed: {ex.Message}", "danger"); }
        finally { _busy = false; }
    }

    private async Task MergeAsync(DuplicateGroupDto group)
    {
        await RecordDecisionAsync(group, MatchReviewDecisionCodes.MergeRequest, group.PrimaryRecordId, _resolutionNotes);
        await Api.MergeDuplicateGroupAsync(group.GroupId, new DuplicateResolveRequest { ResolvedByUserId = _tenantAdminUserId, Notes = _resolutionNotes });
        _selectedGroupIds.Remove(group.GroupId);
        await LoadAsync();
        _view = "resolved";
        await ShowToastAsync("Duplicate group merged successfully.", "success");
    }

    private async Task DismissAsync(DuplicateGroupDto group)
    {
        await RecordDecisionAsync(group, MatchReviewDecisionCodes.CreateNew, null, _resolutionNotes);
        await Api.DismissDuplicateGroupAsync(group.GroupId, new DuplicateResolveRequest { ResolvedByUserId = _tenantAdminUserId, Notes = _resolutionNotes });
        _selectedGroupIds.Remove(group.GroupId);
        await LoadAsync();
        _view = "resolved";
        await ShowToastAsync("Duplicate group dismissed.", "success");
    }

    private async Task BulkMergeAsync()
    {
        await Api.BulkMergeDuplicateGroupsAsync(new DuplicateBulkResolveRequest { TenantId = _tenantId, GroupIds = _selectedGroupIds.ToList(), ResolvedByUserId = _tenantAdminUserId, Notes = _resolutionNotes });
        var count = _selectedGroupIds.Count;
        _selectedGroupIds.Clear();
        await LoadAsync();
        _view = "resolved";
        await ShowToastAsync($"{count} duplicate group(s) merged.", "success");
    }

    private async Task BulkDismissAsync()
    {
        await Api.BulkDismissDuplicateGroupsAsync(new DuplicateBulkResolveRequest { TenantId = _tenantId, GroupIds = _selectedGroupIds.ToList(), ResolvedByUserId = _tenantAdminUserId, Notes = _resolutionNotes });
        var count = _selectedGroupIds.Count;
        _selectedGroupIds.Clear();
        await LoadAsync();
        _view = "resolved";
        await ShowToastAsync($"{count} duplicate group(s) dismissed.", "success");
    }

    private void SetView(string view) => _view = view;
    private void ShowGroups() => SetView("groups");
    private void ShowResolved() => SetView("resolved");
    private void ShowAccounts() { _entityFilter = "Account"; _activeFilter = "Account"; _view = "groups"; }
    private void ShowContacts() { _entityFilter = "Contact"; _activeFilter = "Contact"; _view = "groups"; }
    private void ShowHighConfidence() { _confidenceFilter = "High"; _activeFilter = "High"; _view = "groups"; }
    private async Task CompareGroupAsync(DuplicateGroupDto group)
    {
        _selectedGroup = group;
        await RecordDecisionAsync(group, MatchReviewDecisionCodes.Compare, group.PrimaryRecordId, "Opened record comparison.");
    }

    private async Task RecordDecisionAsync(DuplicateGroupDto group, string decisionCode, Guid? candidateEntityId, string? notes)
    {
        const string prefix = "SearchMatch:";
        if (!group.MatchKey.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) || !Guid.TryParse(group.MatchKey[prefix.Length..], out var executionId)) return;
        await Api.SaveMatchReviewDecisionAsync(new MatchReviewDecisionRequest
        {
            MatchExecutionId = executionId,
            CandidateEntityId = candidateEntityId,
            DecisionCode = decisionCode,
            Notes = notes,
            CorrelationId = $"duplicate-review:{group.GroupId:N}:{Guid.NewGuid():N}"
        });
    }
    private void SelectEntity(string entity) { _entityFilter = _entityFilter == entity ? string.Empty : entity; _activeFilter = _entityFilter; _view = "groups"; }
    private void SetQuickFilter(string filter) { _activeFilter = _activeFilter == filter ? string.Empty : filter; if (filter is "Account" or "Contact") _entityFilter = _activeFilter; if (filter == "High") _confidenceFilter = _confidenceFilter == "High" ? string.Empty : "High"; if (filter == "Resolved") _view = "resolved"; else _view = "groups"; }
    private void ResetFilters() { _activeFilter = string.Empty; _searchTerm = string.Empty; _entityFilter = string.Empty; _confidenceFilter = string.Empty; _statusFilter = string.Empty; }
    private void OnSearchChanged(BlazorChangeEventArgs e) => _searchTerm = e.Value?.ToString() ?? string.Empty;
    private void OnEntityFilterChanged(BlazorChangeEventArgs e) { _entityFilter = e.Value?.ToString() ?? string.Empty; _activeFilter = string.Empty; }
    private void OnConfidenceFilterChanged(BlazorChangeEventArgs e) { _confidenceFilter = e.Value?.ToString() ?? string.Empty; _activeFilter = string.Empty; }
    private void OnStatusFilterChanged(BlazorChangeEventArgs e) { _statusFilter = e.Value?.ToString() ?? string.Empty; _activeFilter = string.Empty; }
    private void NavigateToAccounts() => Nav.NavigateTo("/crm/accounts");
    private void OpenRecordInCrm(DuplicateRecordDto record) => Nav.NavigateTo($"/crm/{(_selectedGroup?.EntityType == "Contact" ? "contacts" : "accounts")}?search={Uri.EscapeDataString(record.RecordName)}");

    private bool IsSelected(Guid groupId) => _selectedGroupIds.Contains(groupId);
    private void ToggleSelected(Guid groupId) { if (!_selectedGroupIds.Add(groupId)) _selectedGroupIds.Remove(groupId); }
    private void ToggleSelectVisible() { foreach (var group in FilteredOpenGroups) _selectedGroupIds.Add(group.GroupId); }
    private void ClearSelected() => _selectedGroupIds.Clear();

    private void OpenConfirm(ConfirmAction action) { _confirmAction = action; _resolutionNotes = string.Empty; _showConfirm = true; }
    private void CancelConfirm() { if (!_busy) { _showConfirm = false; _confirmAction = null; _resolutionNotes = string.Empty; } }
    private async Task ExecuteConfirmedAsync() { if (_confirmAction is null) return; _busy = true; try { var action = _confirmAction; await action.ExecuteAsync(); _showConfirm = false; _confirmAction = null; _resolutionNotes = string.Empty; } catch (Exception ex) { await ShowToastAsync($"Action failed: {ex.Message}", "danger"); } finally { _busy = false; } }

    private async Task ShowToastAsync(string message, string kind = "info")
    {
        _toastCts?.Cancel(); _toastCts?.Dispose(); _toastCts = new CancellationTokenSource();
        _toastMessage = message.Length <= 120 ? message : $"{message[..117]}..."; _toastKind = ToastKind(kind); _toastVisible = true; StateHasChanged();
        _ = HideToastAfterDelayAsync(_toastCts.Token, _toastKind == "danger" ? 5200 : 2800);
        await Task.CompletedTask;
    }

    private async Task HideToastAfterDelayAsync(CancellationToken cancellationToken, int delayMs)
    {
        try { await Task.Delay(delayMs, cancellationToken); _toastVisible = false; await InvokeAsync(StateHasChanged); } catch (TaskCanceledException) { }
    }

    private void HideToast() { _toastCts?.Cancel(); _toastVisible = false; }
    private static string ToastKind(string value) => value.Contains("danger", StringComparison.OrdinalIgnoreCase) || value.Contains("error", StringComparison.OrdinalIgnoreCase) ? "danger" : value.Contains("warning", StringComparison.OrdinalIgnoreCase) ? "warning" : value.Contains("success", StringComparison.OrdinalIgnoreCase) ? "success" : "info";
    private static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static bool IsOpen(DuplicateGroupDto group) => group.StatusCode is "Open" or "Under Review";
    private static bool IsResolved(DuplicateGroupDto group) => group.StatusCode is "Merged" or "Dismissed";
    private static DuplicateRecordDto PrimaryRecord(DuplicateGroupDto group) => group.Records.FirstOrDefault(r => r.IsPrimary) ?? group.Records.FirstOrDefault() ?? new DuplicateRecordDto { RecordName = group.PrimaryName, RecordId = group.PrimaryRecordId ?? Guid.Empty };
    private static string ConfidenceClass(int value) => value >= 90 ? "dup-confidence-high" : value >= 70 ? "dup-confidence-medium" : "dup-confidence-low";
    private static string ConfidenceAvatarClass(int value) => value >= 90 ? "dup-group-icon-high" : value >= 70 ? "dup-group-icon-medium" : "dup-group-icon-low";
    private static string EntityIcon(string entity) => entity == "Contact" ? "bi-person-vcard" : "bi-building";
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture) : "-";
    private static string FormatDateTime(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("MMM d, h:mm tt", CultureInfo.CurrentCulture) : "-";
    private static string FieldValue(DuplicateRecordDto record, string field) => record.FieldValues.TryGetValue(field, out var value) && !string.IsNullOrWhiteSpace(value) ? value : "-";
    private static IEnumerable<string> CompareFields(DuplicateGroupDto group) => group.Records.SelectMany(r => r.FieldValues.Keys).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);
    private static bool HasConflict(DuplicateGroupDto group, string field) => group.Records.Select(r => FieldValue(r, field)).Distinct(StringComparer.OrdinalIgnoreCase).Count() > 1;
    private static int DistinctValueCount(DuplicateGroupDto group, string field) => group.Records.Select(r => FieldValue(r, field)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    private static IEnumerable<KeyValuePair<string, string>> PreviewFields(DuplicateRecordDto record) => record.FieldValues.Where(f => !string.IsNullOrWhiteSpace(f.Value)).Take(3);
    private string MetricCardClass(KpiModel metric) => $"dup-kpi-card {metric.Tone} {(_activeFilter == metric.Filter && !string.IsNullOrWhiteSpace(metric.Filter) ? "dup-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewDef view) => _view == view.Id ? "dup-view-btn dup-view-btn-active" : "dup-view-btn";
    private string GroupCardClass(DuplicateGroupDto group) => group.GroupId == _selectedGroup?.GroupId ? "dup-group-card-selected" : string.Empty;
    private string EntityRowClass(string entity) => _entityFilter == entity ? "dup-funnel-row dup-active" : "dup-funnel-row";
    private static string AvatarColor(string name) { var colors = new[] { "dup-av1", "dup-av2", "dup-av3", "dup-av4", "dup-av5", "dup-av6" }; return colors[Math.Abs(name.GetHashCode()) % colors.Length]; }
    private static string Initials(string name) { var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length > 0 ? name[..1] : "?"; }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private sealed record ViewDef(string Id, string Label, string Icon);
    private sealed record KpiModel(string Label, string Value, string Caption, string Icon, string Tone, string Filter);
    private sealed record ConfirmAction(string Title, string Message, string ButtonText, string ButtonClass, string Icon, string Kind, string NotesLabel, Func<Task> ExecuteAsync);
    private sealed record DistributionRow(string Label, int Count, double WidthPercent, string Tone) { public double Percent { get; init; } }
}
