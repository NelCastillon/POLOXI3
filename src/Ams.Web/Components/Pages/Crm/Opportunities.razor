@page "/crm/opportunities"
@namespace Ams.Web.Components.Pages.Crm
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Opportunities — CRM</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Opportunities"
               Subtitle="Track every deal from qualification to close"
               Icon="bi-trophy-fill">
    <Actions>
        <div class="op-view-toggle" role="group" aria-label="View mode">
            @foreach (var v in _views)
            {
                <button class="op-view-btn @(_view == v.Id ? "op-view-btn--active" : "")"
                        @onclick="() => _view = v.Id"
                        title="@v.Label"
                        aria-pressed="@(_view == v.Id)">
                    <i class="bi @v.Icon" aria-hidden="true"></i>
                    <span class="op-view-lbl">@v.Label</span>
                </button>
            }
        </div>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "op-spin" : "")" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => _showAdd = true'>
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Opportunity
        </button>
    </Actions>
</AppPageHeader>

<!-- ── KPI strip ─────────────────────────────────────────────────────────── -->
<div class="op-kpi-strip">
    <div class="op-kpi-card">
        <span class="op-kpi-icon op-ki1"><i class="bi bi-trophy-fill" aria-hidden="true"></i></span>
        <div><div class="op-kpi-val">@_kpi.Total</div><div class="op-kpi-lbl">Total Open</div></div>
    </div>
    <div class="op-kpi-card">
        <span class="op-kpi-icon op-ki2"><i class="bi bi-cash-coin" aria-hidden="true"></i></span>
        <div><div class="op-kpi-val">@_kpi.Pipeline.ToString("C0")</div><div class="op-kpi-lbl">Pipeline</div></div>
    </div>
    <div class="op-kpi-card">
        <span class="op-kpi-icon op-ki3"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span>
        <div><div class="op-kpi-val">@_kpi.WeightedPipeline.ToString("C0")</div><div class="op-kpi-lbl">Weighted</div></div>
    </div>
    <div class="op-kpi-card">
        <span class="op-kpi-icon op-ki4"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
        <div><div class="op-kpi-val">@_kpi.WonThisMonth.ToString("C0")</div><div class="op-kpi-lbl">Won This Month</div></div>
    </div>
    <div class="op-kpi-card">
        <span class="op-kpi-icon op-ki5"><i class="bi bi-calendar-x" aria-hidden="true"></i></span>
        <div>
            <div class="op-kpi-val @(_kpi.ClosingThisWeek > 0 ? "op-kpi-val--warn" : "")">@_kpi.ClosingThisWeek</div>
            <div class="op-kpi-lbl">Closing This Week</div>
        </div>
    </div>
    <div class="op-kpi-card">
        <span class="op-kpi-icon op-ki1"><i class="bi bi-percent" aria-hidden="true"></i></span>
        <div><div class="op-kpi-val">@_kpi.AvgWinRate.ToString("F0")%</div><div class="op-kpi-lbl">Avg Win Rate</div></div>
    </div>
</div>

<!-- ── Filter bar ────────────────────────────────────────────────────────── -->
<div class="op-filter-bar">
    <div class="op-search-wrap">
        <i class="bi bi-search op-search-icon" aria-hidden="true"></i>
        <input class="op-search-input" type="search" placeholder="Search opportunities…"
               value="@_search"
               @oninput="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => { _search = e.Value?.ToString() ?? string.Empty; ApplyFilters(); })" />
    </div>
    <SfDropDownList TValue="string" TItem="LV" DataSource="_stageOptions"  Placeholder="All Stages"    ShowClearButton="true" Width="145px" Value="_filterStage"    ValueChanged="@((string v) => { _filterStage = v; ApplyFilters(); })"><DropDownListFieldSettings Value="Value" Text="Label" /></SfDropDownList>
    <SfDropDownList TValue="string" TItem="LV" DataSource="_ownerOptions"  Placeholder="All Owners"    ShowClearButton="true" Width="145px" Value="_filterOwner"    ValueChanged="@((string v) => { _filterOwner = v; ApplyFilters(); })"><DropDownListFieldSettings Value="Value" Text="Label" /></SfDropDownList>
    <SfDropDownList TValue="string" TItem="LV" DataSource="_forecastOptions" Placeholder="All Forecasts" ShowClearButton="true" Width="150px" Value="_filterForecast" ValueChanged="@((string v) => { _filterForecast = v; ApplyFilters(); })"><DropDownListFieldSettings Value="Value" Text="Label" /></SfDropDownList>
    @if (_selected.Count > 0)
    {
        <div class="op-bulk">
            <span class="op-bulk-count">@_selected.Count selected</span>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showBulkStage = true"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Move Stage</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showAssign = true"><i class="bi bi-person-check" aria-hidden="true"></i> Assign</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearSelection"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
    }
</div>

<!-- ══ VIEW: GRID ═══════════════════════════════════════════════════════════ -->
@if (_view == "grid")
{
    @if (_loading)
    {
        <div class="op-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div>
    }
    else
    {
        <div class="op-grid-card app-datagrid">
            <SfGrid @ref="_grid" TValue="OppRow" DataSource="_filtered"
                    AllowPaging="true" AllowSorting="true" AllowFiltering="true"
                    AllowSelection="true" EnableHover="true" RowHeight="56">
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" />
                <GridPageSettings PageSize="25" PageSizes="@(new int[]{10,25,50,100})" />
                <GridEvents TValue="OppRow" RowSelected="OnRowSelected" RowDeselected="OnRowDeselected" />
                <GridColumns>
                    <GridColumn Type="ColumnType.CheckBox" Width="48" />
                    <GridColumn HeaderText="Opportunity" Width="220" Field="@nameof(OppRow.Name)">
                        <Template>
                            @{ var r = (OppRow)context; }
                            <div class="op-name-cell">
                                <div class="op-opp-icon @ForecastColor(r.ForecastCategory)"><i class="bi bi-trophy" aria-hidden="true"></i></div>
                                <div>
                                    <div class="op-item-name">@r.Name</div>
                                    <div class="op-item-sub">@r.AccountName</div>
                                </div>
                            </div>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(OppRow.Stage)" HeaderText="Stage" Width="150">
                        <Template>@{ var r = (OppRow)context; }<span class="@StageBadge(r.Stage)">@r.Stage</span></Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(OppRow.Amount)" HeaderText="Amount" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                        <Template>@{ var r = (OppRow)context; }<span class="op-mono op-bold">@r.Amount.ToString("C0")</span></Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(OppRow.WinPct)" HeaderText="Win %" Width="100">
                        <Template>
                            @{ var r = (OppRow)context; }
                            <div class="op-win-wrap">
                                <div class="op-win-bar" style="width:@r.WinPct%;background:@WinColor(r.WinPct)"></div>
                                <span class="op-win-num">@r.WinPct%</span>
                            </div>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(OppRow.ForecastCategory)" HeaderText="Forecast" Width="130">
                        <Template>@{ var r = (OppRow)context; }<span class="@ForecastBadge(r.ForecastCategory)">@r.ForecastCategory</span></Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(OppRow.Owner)"    HeaderText="Owner"      Width="140" />
                    <GridColumn Field="@nameof(OppRow.CloseDate)" HeaderText="Close Date" Width="120">
                        <Template>
                            @{ var r = (OppRow)context; }
                            <span class="@(r.CloseDate < DateTime.UtcNow && r.Stage != "Closed Won" && r.Stage != "Closed Lost" ? "op-overdue" : "op-mono")">
                                @(r.CloseDate.ToString("d"))
                            </span>
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                        <Template>
                            @{ var r = (OppRow)context; }
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/crm/opportunities/{r.OppId}")'>
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </button>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    }
}

<!-- ══ VIEW: KANBAN ═════════════════════════════════════════════════════════ -->
@if (_view == "kanban")
{
    @if (_loading)
    {
        <div class="op-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div>
    }
    else
    {
        <div class="op-kanban-wrap">
            <SfKanban TValue="OppRow" KeyField="@nameof(OppRow.Stage)" DataSource="_filtered">
                <KanbanColumns>
                    @foreach (var col in _kanbanCols)
                    {
                        <KanbanColumn HeaderText="@col.Label" KeyField="@(new List<string>{col.Key})"
                                      AllowDrop="true" AllowDrag="true" ShowItemCount="true" />
                    }
                </KanbanColumns>
                <KanbanCardSettings HeaderField="@nameof(OppRow.OppId)" ContentField="@nameof(OppRow.Name)">
                    <Template Context="kanbanCtx">
                        @{ var r = (OppRow)kanbanCtx; }
                        <div class="op-kcard" @onclick='() => Nav.NavigateTo($"/crm/opportunities/{r.OppId}")'>
                            <div class="op-kcard-hdr">
                                <span class="@ForecastBadge(r.ForecastCategory)">@r.ForecastCategory</span>
                                <span class="op-win-chip" style="color:@WinColor(r.WinPct)">@r.WinPct%</span>
                            </div>
                            <div class="op-kcard-name">@r.Name</div>
                            <div class="op-kcard-acct">@r.AccountName</div>
                            <div class="op-kcard-footer">
                                <span class="op-mono op-bold">@r.Amount.ToString("C0")</span>
                                <span class="op-kcard-close @(r.CloseDate < DateTime.UtcNow ? "op-overdue" : "")">
                                    <i class="bi bi-calendar3" aria-hidden="true"></i> @r.CloseDate.ToString("d")
                                </span>
                            </div>
                            <div class="op-kcard-owner"><i class="bi bi-person" aria-hidden="true"></i> @r.Owner</div>
                        </div>
                    </Template>
                </KanbanCardSettings>
            </SfKanban>
        </div>
    }
}

<!-- ══ VIEW: FORECAST ══════════════════════════════════════════════════════ -->
@if (_view == "forecast")
{
    <div class="op-forecast-layout">
        <!-- Stage funnel bars -->
        <div class="op-forecast-chart">
            <h3 class="op-section-hdr">Pipeline by Stage</h3>
            @foreach (var sg in _stageRollup)
            {
                var maxAmt = _stageRollup.Max(s => s.Amount);
                var pct    = maxAmt == 0 ? 0 : (double)sg.Amount / (double)maxAmt * 100;
                <div class="op-stage-bar-row">
                    <span class="@StageBadge(sg.Stage)" style="min-width:110px">@sg.Stage</span>
                    <div class="op-stage-bar-track">
                        <div class="op-stage-bar-fill @StageFill(sg.Stage)"
                             style="width:@pct.ToString("F1",System.Globalization.CultureInfo.InvariantCulture)%"></div>
                    </div>
                    <span class="op-mono op-bold" style="min-width:90px;text-align:right">@sg.Amount.ToString("C0")</span>
                    <span class="op-stage-cnt">@sg.Count opp@(sg.Count != 1 ? "s" : "")</span>
                </div>
            }
        </div>
        <!-- Forecast category table -->
        <div class="op-forecast-table">
            <h3 class="op-section-hdr">Forecast Summary</h3>
            <SfGrid TValue="ForecastRollup" DataSource="_forecastRollup"
                    AllowSorting="true" EnableHover="true" RowHeight="48">
                <GridColumns>
                    <GridColumn Field="@nameof(ForecastRollup.Category)"   HeaderText="Category"  MinWidth="140">
                        <Template>@{ var f = (ForecastRollup)context; }<span class="@ForecastBadge(f.Category)">@f.Category</span></Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(ForecastRollup.Count)"      HeaderText="Count"     Width="70"  TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                    <GridColumn Field="@nameof(ForecastRollup.TotalAmount)" HeaderText="Total"    Width="140" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                        <Template>@{ var f = (ForecastRollup)context; }<span class="op-mono op-bold">@f.TotalAmount.ToString("C0")</span></Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(ForecastRollup.WeightedAmount)" HeaderText="Weighted" Width="140" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                        <Template>@{ var f = (ForecastRollup)context; }<span class="op-mono">@f.WeightedAmount.ToString("C0")</span></Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(ForecastRollup.AvgWinPct)"  HeaderText="Avg Win %" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                        <Template>@{ var f = (ForecastRollup)context; }<span>@f.AvgWinPct.ToString("F0")%</span></Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    </div>
}

<!-- ── Dialogs ───────────────────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showAssign" Width="400px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="op-dlg-hdr"><i class="bi bi-person-check" aria-hidden="true"></i> Assign Owner</span></Header>
        <Content>
            <div class="op-dlg-body">
                <p class="op-dlg-info">Assign <strong>@_selected.Count opportunity(s)</strong> to:</p>
                <SfDropDownList TValue="string" TItem="LV" DataSource="_ownerOptions" Placeholder="Select owner…" Width="100%" @bind-Value="_assignTarget"><DropDownListFieldSettings Value="Value" Text="Label" /></SfDropDownList>
            </div>
        </Content>
        <FooterTemplate>
            <div class="op-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showAssign = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitAssignAsync" disabled="@string.IsNullOrEmpty(_assignTarget)"><i class="bi bi-check-lg" aria-hidden="true"></i> Assign</button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_showBulkStage" Width="400px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="op-dlg-hdr"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Move Stage</span></Header>
        <Content>
            <div class="op-dlg-body">
                <p class="op-dlg-info">Move <strong>@_selected.Count opportunity(s)</strong> to stage:</p>
                <SfDropDownList TValue="string" TItem="LV" DataSource="_stageOptions" Placeholder="Select stage…" Width="100%" @bind-Value="_bulkStageTarget"><DropDownListFieldSettings Value="Value" Text="Label" /></SfDropDownList>
            </div>
        </Content>
        <FooterTemplate>
            <div class="op-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showBulkStage = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitBulkStageAsync" disabled="@string.IsNullOrEmpty(_bulkStageTarget)"><i class="bi bi-check-lg" aria-hidden="true"></i> Move</button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast?          _toast;
    private SfGrid<OppRow>?   _grid;
    private string            _view    = "grid";
    private bool              _loading = false;
    private bool              _showAdd = false;

    private record ViewDef(string Id, string Label, string Icon);
    private static readonly List<ViewDef> _views =
    [
        new("grid",     "Grid",     "bi-table"),
        new("kanban",   "Kanban",   "bi-kanban"),
        new("forecast", "Forecast", "bi-bar-chart-steps"),
    ];

    private record KanbanColDef(string Key, string Label);
    private static readonly List<KanbanColDef> _kanbanCols =
    [
        new("Qualification","Qualification"), new("Needs Analysis","Needs Analysis"),
        new("Proposal","Proposal"),           new("Negotiation","Negotiation"),
        new("Closed Won","Closed Won"),       new("Closed Lost","Closed Lost"),
    ];

    private List<OppRow>       _opps      = [];
    private List<OppRow>       _filtered  = [];
    private List<StageRollup>  _stageRollup   = [];
    private List<ForecastRollup> _forecastRollup = [];
    private OppKpi             _kpi       = new();
    private List<OppRow>       _selected  = [];

    private string _search        = string.Empty;
    private string _filterStage   = string.Empty;
    private string _filterOwner   = string.Empty;
    private string _filterForecast = string.Empty;

    private bool   _showAssign     = false;
    private bool   _showBulkStage  = false;
    private string _assignTarget   = string.Empty;
    private string _bulkStageTarget = string.Empty;

    private static readonly List<LV> _stageOptions =
    [
        new("Qualification","Qualification"), new("Needs Analysis","Needs Analysis"),
        new("Proposal","Proposal"),           new("Negotiation","Negotiation"),
        new("Closed Won","Closed Won"),       new("Closed Lost","Closed Lost"),
    ];
    private static readonly List<LV> _ownerOptions =
    [
        new("Alice Carter","Alice Carter"), new("Bob Martinez","Bob Martinez"),
        new("Carol Smith","Carol Smith"),   new("David Lee","David Lee"),
    ];
    private static readonly List<LV> _forecastOptions =
    [
        new("Pipeline","Pipeline"), new("Best Case","Best Case"),
        new("Commit","Commit"),     new("Closed","Closed"),
    ];

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("CRM","/crm/opportunities"), new("Opportunities","/crm/opportunities"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            var response = await Api.SearchOpportunitiesAsync(_tenantId);
            _opps = response?.Items?.Select(MapToOppRow).ToList() ?? [];
            RebuildDerived();
        }
        catch (Exception ex)
        {
            await _toast!.ShowAsync(new ToastModel { Content = $"Error loading opportunities: {ex.Message}", CssClass = "e-toast-danger" });
            _opps = [];
        }
        finally { _loading = false; }
    }

    private OppRow MapToOppRow(OpportunityDto dto)
    {
        return new OppRow
        {
            OppId = dto.OpportunityId,
            Name = dto.OpportunityName,
            AccountName = dto.AccountName ?? string.Empty,
            Stage = GetStageName(dto.StatusCode),
            Amount = dto.EstimatedAmount,
            WinPct = (int)dto.WinProbability,
            ForecastCategory = dto.ForecastCategoryCode ?? "Pipeline",
            Owner = string.Empty,
            CloseDate = dto.CloseDate ?? DateTime.UtcNow.AddDays(30)
        };
    }

    private string GetStageName(int statusCode) => statusCode switch
    {
        1 => "Qualification",
        2 => "Needs Analysis",
        3 => "Proposal",
        4 => "Negotiation",
        5 => "Closed Won",
        6 => "Closed Lost",
        _ => "Qualification"
    };

    private void RebuildDerived()
    {
        ApplyFilters();
        _stageRollup = _opps.GroupBy(x => x.Stage)
            .Select(g => new StageRollup { Stage = g.Key, Count = g.Count(), Amount = g.Sum(x => x.Amount) })
            .OrderBy(x => StageOrder(x.Stage)).ToList();
        _forecastRollup = _opps.GroupBy(x => x.ForecastCategory)
            .Select(g => new ForecastRollup
            {
                Category       = g.Key,
                Count          = g.Count(),
                TotalAmount    = g.Sum(x => x.Amount),
                WeightedAmount = g.Sum(x => x.Amount * (decimal)x.WinPct / 100),
                AvgWinPct      = g.Any() ? g.Average(x => x.WinPct) : 0,
            }).ToList();
        _kpi = new OppKpi
        {
            Total           = _opps.Count(x => x.Stage != "Closed Won" && x.Stage != "Closed Lost"),
            Pipeline        = _opps.Where(x => x.Stage != "Closed Won" && x.Stage != "Closed Lost").Sum(x => x.Amount),
            WeightedPipeline= _opps.Where(x => x.Stage != "Closed Won" && x.Stage != "Closed Lost").Sum(x => x.Amount * (decimal)x.WinPct / 100),
            WonThisMonth    = _opps.Where(x => x.Stage == "Closed Won" && x.CloseDate.Month == DateTime.UtcNow.Month && x.CloseDate.Year == DateTime.UtcNow.Year).Sum(x => x.Amount),
            ClosingThisWeek = _opps.Count(x => x.Stage != "Closed Won" && x.Stage != "Closed Lost" && (x.CloseDate - DateTime.UtcNow).TotalDays <= 7),
            AvgWinRate      = _opps.Any() ? _opps.Average(x => x.WinPct) : 0,
        };
    }

    private void ApplyFilters()
    {
        _filtered = _opps.Where(r =>
            (string.IsNullOrEmpty(_filterStage)    || r.Stage == _filterStage) &&
            (string.IsNullOrEmpty(_filterOwner)    || r.Owner == _filterOwner) &&
            (string.IsNullOrEmpty(_filterForecast) || r.ForecastCategory == _filterForecast) &&
            (string.IsNullOrEmpty(_search) ||
             r.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             r.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    private void OnRowSelected(RowSelectEventArgs<OppRow> args)   { if (!_selected.Any(x => x.OppId == args.Data.OppId)) _selected.Add(args.Data); }
    private void OnRowDeselected(RowDeselectEventArgs<OppRow> args) => _selected.RemoveAll(x => x.OppId == args.Data.OppId);
    private void ClearSelection() => _selected.Clear();

    private async Task CommitAssignAsync()
    {
        await Task.Delay(0); // TODO: Api.AssignOpportunitiesAsync
        _showAssign = false;
        await _toast!.ShowAsync(new ToastModel { Content = $"{_selected.Count} opportunity(s) assigned to {_assignTarget}.", CssClass = "e-toast-success" });
        _selected.Clear(); _assignTarget = string.Empty;
    }
    private async Task CommitBulkStageAsync()
    {
        await Task.Delay(0); // TODO: Api.BulkMoveStageAsync
        _showBulkStage = false;
        await _toast!.ShowAsync(new ToastModel { Content = $"{_selected.Count} opportunity(s) moved to {_bulkStageTarget}.", CssClass = "e-toast-success" });
        _selected.Clear(); _bulkStageTarget = string.Empty;
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static string StageBadge(string s) => s switch
    {
        "Qualification" => "op-stage op-stage--qual",
        "Needs Analysis"=> "op-stage op-stage--needs",
        "Proposal"      => "op-stage op-stage--prop",
        "Negotiation"   => "op-stage op-stage--neg",
        "Closed Won"    => "op-stage op-stage--won",
        "Closed Lost"   => "op-stage op-stage--lost",
        _               => "op-stage",
    };
    private static string StageFill(string s) => s switch
    {
        "Closed Won" => "op-sf--won", "Closed Lost" => "op-sf--lost",
        "Negotiation"=> "op-sf--neg", "Proposal"    => "op-sf--prop",
        _            => "op-sf--default",
    };
    private static int StageOrder(string s) => s switch
    {
        "Qualification" => 0, "Needs Analysis" => 1, "Proposal" => 2,
        "Negotiation"   => 3, "Closed Won"     => 4, "Closed Lost" => 5, _ => 99,
    };
    private static string ForecastBadge(string f) => f switch
    {
        "Commit"    => "op-fc op-fc--commit",
        "Best Case" => "op-fc op-fc--best",
        "Closed"    => "op-fc op-fc--closed",
        _           => "op-fc op-fc--pipeline",
    };
    private static string ForecastColor(string f) => f switch
    {
        "Commit" => "op-oi--commit", "Closed" => "op-oi--closed", _ => "op-oi--default",
    };
    private static string WinColor(int p) => p >= 70 ? "#16a34a" : p >= 40 ? "#b45309" : "#dc2626";

    // ── Models ────────────────────────────────────────────────────────────────
    private sealed class OppRow
    {
        public Guid     OppId            { get; set; } = Guid.NewGuid();
        public string   Name             { get; set; } = string.Empty;
        public string   AccountName      { get; set; } = string.Empty;
        public string   Stage            { get; set; } = "Qualification";
        public decimal  Amount           { get; set; }
        public int      WinPct           { get; set; }
        public string   ForecastCategory { get; set; } = "Pipeline";
        public string   Owner            { get; set; } = string.Empty;
        public DateTime CloseDate        { get; set; } = DateTime.UtcNow.AddDays(30);
    }
    private sealed class OppKpi
    {
        public int     Total            { get; set; }
        public decimal Pipeline         { get; set; }
        public decimal WeightedPipeline { get; set; }
        public decimal WonThisMonth     { get; set; }
        public int     ClosingThisWeek  { get; set; }
        public double  AvgWinRate       { get; set; }
    }
    private sealed class StageRollup   { public string Stage { get; set; } = string.Empty; public int Count { get; set; } public decimal Amount { get; set; } }
    private sealed class ForecastRollup
    {
        public string  Category       { get; set; } = string.Empty;
        public int     Count          { get; set; }
        public decimal TotalAmount    { get; set; }
        public decimal WeightedAmount { get; set; }
        public double  AvgWinPct      { get; set; }
    }
    private sealed record LV(string Value, string Label);
}

