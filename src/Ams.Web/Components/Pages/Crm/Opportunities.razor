@page "/crm/opportunities"
@namespace Ams.Web.Components.Pages.Crm
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Opportunities
@using BlazorChangeEventArgs = Microsoft.AspNetCore.Components.ChangeEventArgs
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Enterprise Opportunities</PageTitle>

@if (_toastVisible)
{
    <div class="op-toast op-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="op-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showCreate)
{
    <div class="op-modal-backdrop" role="presentation" @onclick="CloseCreate">
        <div class="op-modal" role="dialog" aria-modal="true" aria-labelledby="opCreateTitle" @onclick:stopPropagation="true">
            <EditForm Model="_form" OnValidSubmit="CreateOpportunityAsync">
                <DataAnnotationsValidator />
                <div class="op-modal-header">
                    <div class="op-modal-title"><span class="op-modal-icon"><i class="bi bi-trophy-fill" aria-hidden="true"></i></span><span><h2 id="opCreateTitle">New Opportunity</h2><p>Capture revenue potential and place it into the active pipeline.</p></span></div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseCreate" disabled="@_busy" aria-label="Close"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="op-modal-body">
                    <div class="op-form-grid">
                        <div class="op-field op-field-wide">
                            <label for="opName">Opportunity Name <span>*</span></label>
                            <InputText id="opName" class="op-input" @bind-Value="_form.OpportunityName" />
                        </div>
                        <div class="op-field">
                            <label for="opAccount">Account <span>*</span></label>
                            <InputSelect id="opAccount" class="op-input" @bind-Value="_form.AccountId">
                                <option value="@Guid.Empty">Select account</option>
                                @foreach (var account in _accounts.OrderBy(a => a.AccountName))
                                {
                                    <option value="@account.AccountId">@account.AccountName</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="op-field">
                            <label for="opAmount">Estimated Amount</label>
                            <InputNumber id="opAmount" class="op-input" @bind-Value="_form.EstimatedAmount" />
                        </div>
                        <div class="op-field">
                            <label for="opClose">Close Date</label>
                            <InputDate id="opClose" class="op-input" @bind-Value="_form.CloseDate" />
                        </div>
                        <div class="op-field">
                            <label for="opWin">Win Probability</label>
                            <InputNumber id="opWin" class="op-input" @bind-Value="_form.WinProbability" />
                        </div>
                        <div class="op-field">
                            <label for="opForecast">Forecast <span>*</span></label>
                            <InputSelect id="opForecast" class="op-input" @bind-Value="_form.ForecastCategoryCode">
                                @foreach (var option in ForecastOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="op-field">
                            <label for="opOwner">Owner</label>
                            <InputSelect id="opOwner" class="op-input" @bind-Value="_form.OwnerUserId">
                                <option value="">Current user</option>
                                @foreach (var user in ActiveUsers)
                                {
                                    <option value="@user.UserId">@DisplayUser(user)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="op-field op-field-wide">
                            <label for="opDescription">Description</label>
                            <InputTextArea id="opDescription" class="op-input op-textarea" @bind-Value="_form.Description" placeholder="Business need, coverage goal, competitor pressure, or next step" />
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_formError))
                    {
                        <div class="op-form-error"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_formError</div>
                    }
                </div>
                <div class="op-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseCreate" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy"><i class="bi bi-check-lg" aria-hidden="true"></i> Create Opportunity</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showStage || _showAssign)
{
    <div class="op-modal-backdrop" role="presentation" @onclick="CloseBulkDialogs">
        <div class="op-mini-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="op-modal-header">
                <div class="op-modal-title"><span class="op-modal-icon"><i class="bi @(_showStage ? "bi-arrow-right-circle" : "bi-person-check")" aria-hidden="true"></i></span><span><h2>@(_showStage ? "Move Stage" : "Assign Owner")</h2><p>@_selectedIds.Count opportunity(s) selected.</p></span></div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseBulkDialogs"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="op-modal-body">
                @if (_showStage)
                {
                    <label class="op-field">Stage<select class="op-input" @bind="_bulkStage">@foreach (var stage in StageOptions) { <option value="@stage">@stage</option> }</select></label>
                }
                else
                {
                    <label class="op-field">Owner<select class="op-input" @bind="_bulkOwner"><option value="">Select owner</option>@foreach (var user in ActiveUsers) { <option value="@user.UserId">@DisplayUser(user)</option> }</select></label>
                }
            </div>
            <div class="op-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseBulkDialogs">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="CommitBulkAsync" disabled="@_busy"><i class="bi bi-check-lg" aria-hidden="true"></i> Apply</button></div>
        </div>
    </div>
}

<div class="op-enterprise-page">
    <section class="op-hero">
        <div class="op-hero-left">
            <span class="op-hero-icon"><i class="bi bi-trophy-fill" aria-hidden="true"></i></span>
            <div>
                <div class="op-title-row"><h1>Opportunity Command Center</h1><span><i class="bi bi-cash-coin" aria-hidden="true"></i> Revenue pipeline</span><span><i class="bi bi-kanban" aria-hidden="true"></i> Stage workflow</span><span><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span></div>
                <p>Prioritize revenue, forecast confidence, close urgency, owner workload, stage movement, and conversion opportunities.</p>
            </div>
        </div>
        <div class="op-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi @(_loading ? "bi-arrow-repeat op-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities/pipeline")'><i class="bi bi-funnel" aria-hidden="true"></i> Pipeline</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/crm/opportunities/board")'><i class="bi bi-kanban" aria-hidden="true"></i> Board</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Opportunity</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger op-error-banner" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError</div>
    }

    @if (_loading)
    {
        <section class="op-loading-state"><i class="bi bi-arrow-repeat op-spin" aria-hidden="true"></i><strong>Loading enterprise opportunity pipeline...</strong><span>Syncing opportunities, accounts, owners, stages, forecast categories, and revenue rollups.</span></section>
    }
    else
    {
        <section class="op-kpi-strip" aria-label="Opportunity KPI filters">
            @foreach (var metric in Metrics)
            {
                <button type="button" class="@MetricCardClass(metric)" title="@metric.Caption" @onclick="@(() => SetFilter(metric.Filter))"><span class="op-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span><span><span class="op-kpi-val">@metric.Value</span><span class="op-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span></button>
            }
        </section>

        <section class="op-workflow-strip" aria-label="Opportunity workflow actions">
            <button type="button" class="op-workflow-card op-workflow-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i><span><strong>Create opportunity</strong><span>Capture new revenue potential.</span></span></button>
            <button type="button" class="op-workflow-card" @onclick='() => SetFilter("closing")'><i class="bi bi-calendar-x" aria-hidden="true"></i><span><strong>Closing focus</strong><span>Prioritize urgent close dates.</span></span></button>
            <button type="button" class="op-workflow-card" @onclick='() => SetFilter("commit")'><i class="bi bi-check2-circle" aria-hidden="true"></i><span><strong>Commit forecast</strong><span>Review high-confidence pipeline.</span></span></button>
            <button type="button" class="op-workflow-card" @onclick='() => SetView("forecast")'><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span><strong>Forecast</strong><span>Analyze weighted revenue.</span></span></button>
        </section>

        <section class="op-filter-panel opportunity-search-panel">
            <div class="op-search-wrap opportunity-search-box"><i class="bi bi-search op-search-icon" aria-hidden="true"></i><div class="op-search-body opportunity-search-body"><label for="opSearch">Search opportunities</label><input id="opSearch" class="op-search-input" value="@_search" @oninput="OnSearchChanged" placeholder="Search opportunity, account, owner, stage, forecast, lead, or notes..." /><span>Search filters every view, KPI, pipeline, forecast, and table.</span></div></div>
            <label class="op-filter-field">Stage<select class="op-filter-select" value="@_stageFilter" @onchange="OnStageChanged"><option value="">All stages</option>@foreach (var stage in StageOptions) { <option value="@stage">@stage</option> }</select></label>
            <label class="op-filter-field">Owner<select class="op-filter-select" value="@_ownerFilter" @onchange="OnOwnerChanged"><option value="">All owners</option><option value="Unassigned">Unassigned</option>@foreach (var owner in OwnerOptions) { <option value="@owner">@owner</option> }</select></label>
            <label class="op-filter-field">Forecast<select class="op-filter-select" value="@_forecastFilter" @onchange="OnForecastChanged"><option value="">All forecasts</option>@foreach (var forecast in ForecastOptions) { <option value="@forecast">@forecast</option> }</select></label>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-cloud-arrow-down" aria-hidden="true"></i> Sync</button>
            <div class="op-filter-result"><strong>@FilteredRows.Count.ToString("N0", CultureInfo.CurrentCulture)</strong><span>shown</span></div>
        </section>

        @if (_selectedIds.Count > 0)
        {
            <section class="op-bulk-bar"><strong>@_selectedIds.Count selected</strong><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenBulkStage"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Move Stage</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenBulkAssign"><i class="bi bi-person-check" aria-hidden="true"></i> Assign</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearSelection"><i class="bi bi-x-lg" aria-hidden="true"></i></button></section>
        }

        <section class="op-view-tabs" aria-label="Opportunity views">
            @foreach (var view in _views)
            {
                <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label <span>@ViewCount(view.Id)</span></button>
            }
        </section>

        @if (_rows.Count == 0)
        {
            <section class="op-empty-state"><i class="bi bi-trophy" aria-hidden="true"></i><strong>No opportunities available</strong><span>Create an opportunity or sync existing CRM pipeline data for this tenant.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">Create Opportunity</button></section>
        }
        else
        {
            <section class="op-content-layout">
                <main class="op-main-card">
                    @if (_view == "overview")
                    {
                        <div class="op-section-head"><div><h2>Executive opportunity overview</h2><p>Revenue priority ranked by amount, win probability, close urgency, and forecast confidence.</p></div><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => SetView("pipeline")'><i class="bi bi-kanban" aria-hidden="true"></i> Pipeline</button></div>
                        <div class="op-overview-grid"><section class="op-spotlight-card"><span><i class="bi bi-stars" aria-hidden="true"></i> Top priority opportunity</span><strong>@(TopOpportunity?.Name ?? "-")</strong><p>@(TopOpportunity is null ? "No matching opportunity requires attention." : $"{FormatCurrency(TopOpportunity.Amount)} - {TopOpportunity.Stage} - {TopOpportunity.WinPct}% win")</p><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="SelectTopOpportunity">Inspect opportunity</button></section><section class="op-guidance-card"><h3><i class="bi bi-lightbulb" aria-hidden="true"></i> Pipeline guidance</h3><p>@GuidanceText</p><div class="op-guidance-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("closing")'>Closing</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("highprob")'>High Prob</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("commit")'>Commit</button></div></section></div>
                        <section class="op-panel"><h3><i class="bi bi-bar-chart-line" aria-hidden="true"></i> Revenue priority ranking</h3><div class="op-rank-stack">@foreach (var item in FilteredRows.Take(8)) { <button type="button" class="@(IsSelected(item) ? "op-rank-row op-rank-active" : "op-rank-row")" @onclick="@(() => SelectOpportunity(item))"><span>@item.Name</span><div><i style="width:@item.Width"></i></div><strong>@FormatCurrency(item.Amount)</strong><small>@item.Stage</small></button> }</div></section>
                    }
                    else if (_view == "pipeline")
                    {
                        <div class="op-section-head"><div><h2>Native pipeline board</h2><p>Stage-based opportunity board with clickable cards and quick stage movement.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("open")'>Open</button></div>
                        <div class="op-board">@foreach (var stage in StageOptions) { <section class="op-board-col"><header><strong>@stage</strong><span>@FilteredRows.Count(r => r.Stage == stage)</span></header><div>@foreach (var item in FilteredRows.Where(r => r.Stage == stage)) { <article class="@(IsSelected(item) ? "op-pipeline-card op-pipeline-card-selected" : "op-pipeline-card")" @onclick="@(() => SelectOpportunity(item))"><div class="op-card-top"><span class="op-badge @StageBadgeClass(item.Stage)">@item.Stage</span><button type="button" class="op-card-check" @onclick:stopPropagation="true" @onclick="@(() => ToggleSelection(item.Id))"><i class="bi @(_selectedIds.Contains(item.Id) ? "bi-check-square-fill" : "bi-square")" aria-hidden="true"></i></button></div><h3>@item.Name</h3><p>@item.AccountName</p><div class="op-card-stats"><div><span>Amount</span><strong>@FormatCurrency(item.Amount)</strong></div><div><span>Win</span><strong>@item.WinPct%</strong></div></div><footer><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="@(() => MoveStageAsync(item, NextStage(item.Stage)))">Move</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick:stopPropagation="true" @onclick="@(() => NavigateOpportunity(item.Id))">Open</button></footer></article> }</div></section> }</div>
                    }
                    else if (_view == "forecast")
                    {
                        <div class="op-section-head"><div><h2>Forecast and stage analytics</h2><p>Weighted revenue by forecast category and stage progression.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/crm/forecast")'>Forecast</button></div>
                        <div class="op-analytics-grid">@AnalyticsPanel("Stage distribution", StageDistribution, "bi-bar-chart-steps", "op-tone-blue") @AnalyticsPanel("Forecast distribution", ForecastDistribution, "bi-graph-up-arrow", "op-tone-green") @InsightPanel</div>
                    }
                    else if (_view == "owners")
                    {
                        <div class="op-section-head"><div><h2>Owner workload</h2><p>Pipeline concentration, weighted revenue, and close urgency by owner.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenBulkAssign">Assign</button></div>
                        <div class="op-card-grid">@foreach (var owner in OwnerRows) { <article class="@(IsSelected(owner) ? "op-owner-card op-owner-card-selected" : "op-owner-card")" @onclick="@(() => SelectOwner(owner))"><div class="op-card-top"><span class="op-owner-avatar">@Initials(owner.OwnerName)</span><span class="op-badge @OwnerBadgeClass(owner)">@owner.Status</span></div><h3>@owner.OwnerName</h3><p>@owner.Summary</p><div class="op-card-stats"><div><span>Open</span><strong>@owner.OpenCount</strong></div><div><span>Weighted</span><strong>@FormatCurrency(owner.WeightedAmount)</strong></div></div></article> }</div>
                    }
                    else
                    {
                        <div class="op-section-head"><div><h2>Opportunity operating table</h2><p>Native table synchronized from opportunity, account, owner, stage, and forecast data.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters">Reset</button></div>
                        <div class="op-table-wrap"><table class="op-table"><thead><tr><th></th><th>Opportunity</th><th>Stage</th><th>Amount</th><th>Win</th><th>Forecast</th><th>Owner</th><th>Close</th></tr></thead><tbody>@foreach (var item in FilteredRows) { <tr class="@(IsSelected(item) ? "op-row-selected" : string.Empty)" @onclick="@(() => SelectOpportunity(item))"><td><button type="button" class="op-card-check" @onclick:stopPropagation="true" @onclick="@(() => ToggleSelection(item.Id))"><i class="bi @(_selectedIds.Contains(item.Id) ? "bi-check-square-fill" : "bi-square")" aria-hidden="true"></i></button></td><td><strong>@item.Name</strong><small>@item.AccountName - @item.Number</small></td><td><span class="op-badge @StageBadgeClass(item.Stage)">@item.Stage</span></td><td>@FormatCurrency(item.Amount)</td><td>@item.WinPct%</td><td><span class="op-badge @ForecastBadgeClass(item.Forecast)">@item.Forecast</span></td><td>@item.Owner</td><td class="@(item.IsOverdue ? "op-overdue" : string.Empty)">@FormatDate(item.CloseDate)</td></tr> }</tbody></table></div>
                    }
                </main>

                <aside class="op-detail-panel">
                    @if (_selected is not null)
                    {
                        <div class="op-detail-head"><div><span><i class="bi bi-trophy" aria-hidden="true"></i> Opportunity</span><h2>@_selected.Name</h2><p>@_selected.AccountName - @_selected.Number</p></div><span class="op-badge @StageBadgeClass(_selected.Stage)">@_selected.Stage</span></div>
                        <div class="op-score-ring"><strong>@_selected.WinPct%</strong><span>win probability</span></div>
                        <div class="op-detail-summary"><div><span>Amount</span><strong>@FormatCurrency(_selected.Amount)</strong></div><div><span>Weighted</span><strong>@FormatCurrency(_selected.WeightedAmount)</strong></div><div><span>Owner</span><strong>@_selected.Owner</strong></div><div><span>Close</span><strong>@FormatDate(_selected.CloseDate)</strong></div></div>
                        <div class="op-note-card"><strong>Next best action</strong><p>@NextBestAction(_selected)</p></div>
                        <div class="op-rules-card"><header><strong>Pipeline signals</strong><span>@_selected.Forecast</span></header>@foreach (var signal in Signals(_selected)) { <p><em>@signal</em><span>active</span></p> }</div>
                        <div class="op-detail-actions"><button type="button" class="um-btn um-btn-primary" @onclick="@(() => NavigateOpportunity(_selected.Id))"><i class="bi bi-arrow-right" aria-hidden="true"></i> Open</button><button type="button" class="um-btn um-btn-ghost" @onclick="@(() => MoveStageAsync(_selected, NextStage(_selected.Stage)))"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Move</button><button type="button" class="um-btn um-btn-ghost" @onclick="OpenBulkAssign"><i class="bi bi-person-check" aria-hidden="true"></i> Assign</button></div>
                    }
                    else if (_selectedOwner is not null)
                    {
                        <div class="op-detail-head"><div><span><i class="bi bi-person-badge" aria-hidden="true"></i> Owner</span><h2>@_selectedOwner.OwnerName</h2><p>@_selectedOwner.Summary</p></div><span class="op-badge @OwnerBadgeClass(_selectedOwner)">@_selectedOwner.Status</span></div>
                        <div class="op-detail-summary"><div><span>Open</span><strong>@_selectedOwner.OpenCount</strong></div><div><span>Total</span><strong>@FormatCurrency(_selectedOwner.TotalAmount)</strong></div><div><span>Weighted</span><strong>@FormatCurrency(_selectedOwner.WeightedAmount)</strong></div><div><span>Closing</span><strong>@_selectedOwner.ClosingCount</strong></div></div>
                        <div class="op-rules-card"><header><strong>Owner opportunities</strong><span>@_selectedOwner.Count total</span></header>@foreach (var item in _rows.Where(r => r.Owner == _selectedOwner.OwnerName).Take(5)) { <p><em>@item.Name</em><span>@FormatCurrency(item.Amount)</span></p> }</div>
                    }
                    else
                    {
                        <div class="op-detail-empty"><i class="bi bi-trophy" aria-hidden="true"></i><strong>Select an opportunity</strong><span>Review forecast, win probability, urgency, owner, and recommended actions.</span></div>
                    }
                </aside>
            </section>
        }
    }
</div>

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading = true;
    private bool _busy;
    private bool _showCreate;
    private bool _showStage;
    private bool _showAssign;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string _formError = string.Empty;
    private string _search = string.Empty;
    private string _activeFilter = "all";
    private string _stageFilter = string.Empty;
    private string _ownerFilter = string.Empty;
    private string _forecastFilter = string.Empty;
    private string _view = "overview";
    private string _bulkStage = "Qualification";
    private string _bulkOwner = string.Empty;
    private OpportunityFormModel _form = new();
    private OpportunityRow? _selected;
    private OwnerRow? _selectedOwner;
    private List<OpportunityRow> _rows = [];
    private List<AccountDto> _accounts = [];
    private List<UserDto> _users = [];
    private List<OpportunityStageDto> _stages = [];
    private List<OpportunityForecastCategoryDto> _forecastCategories = [];
    private HashSet<Guid> _selectedIds = [];

    private readonly ViewDef[] _views = [new("overview", "Overview", "bi-speedometer2"), new("pipeline", "Pipeline", "bi-kanban"), new("forecast", "Forecast", "bi-graph-up-arrow"), new("owners", "Owners", "bi-people"), new("table", "Table", "bi-table")];

    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", _ => "bi-check-circle-fill" };
    private IReadOnlyList<string> StageOptions => OpportunityPageConstants.ActiveStageNames(_stages);
    private IReadOnlyList<string> ForecastOptions => OpportunityPageConstants.ForecastCategoryNames(_forecastCategories);
    private IReadOnlyList<OpportunityRow> FilteredRows => ApplyFilters(_rows).ToList();
    private IReadOnlyList<OwnerRow> OwnerRows => BuildOwnerRows();
    private IReadOnlyList<DistributionRow> StageDistribution => BuildDistribution(FilteredRows.Select(r => new DistributionSource(r.Stage, 1, r.Amount)));
    private IReadOnlyList<DistributionRow> ForecastDistribution => BuildDistribution(FilteredRows.Select(r => new DistributionSource(r.Forecast, 1, r.WeightedAmount)));
    private IEnumerable<string> OwnerOptions => _rows.Select(r => r.Owner).Where(o => !string.IsNullOrWhiteSpace(o) && o != "Unassigned").Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(o => o);
    private IEnumerable<UserDto> ActiveUsers => _users.Where(u => u.StatusCode.Equals("Active", StringComparison.OrdinalIgnoreCase) || string.IsNullOrWhiteSpace(u.StatusCode)).OrderBy(DisplayUser);
    private OpportunityRow? TopOpportunity => FilteredRows.OrderByDescending(r => r.PriorityScore).ThenByDescending(r => r.Amount).FirstOrDefault();
    private int OpenCount => _rows.Count(r => r.IsOpen);
    private int ClosingCount => _rows.Count(r => r.IsOpen && r.DaysToClose <= 7);
    private decimal PipelineAmount => _rows.Where(r => r.IsOpen).Sum(r => r.Amount);
    private decimal WeightedAmount => _rows.Where(r => r.IsOpen).Sum(r => r.WeightedAmount);
    private decimal WonThisMonth => _rows.Where(r => r.Stage == "Closed Won" && r.CloseDate.HasValue && r.CloseDate.Value.Month == DateTime.UtcNow.Month && r.CloseDate.Value.Year == DateTime.UtcNow.Year).Sum(r => r.Amount);
    private double AverageWinRate => _rows.Count == 0 ? 0 : _rows.Average(r => r.WinPct);
    private string GuidanceText => ClosingCount > 0 ? $"{ClosingCount.ToString("N0", CultureInfo.CurrentCulture)} open opportunity(s) close within 7 days and need immediate action." : WeightedAmount > 0 ? $"Weighted pipeline is {FormatCurrency(WeightedAmount)} across {OpenCount.ToString("N0", CultureInfo.CurrentCulture)} open opportunity(s)." : "Create or sync opportunities to activate pipeline intelligence.";
    private IReadOnlyList<Metric> Metrics => [new("all", _rows.Count.ToString("N0", CultureInfo.CurrentCulture), "Total", "All opportunities", "bi-trophy", "op-kpi-blue"), new("open", OpenCount.ToString("N0", CultureInfo.CurrentCulture), "Open", "Active pipeline", "bi-funnel", "op-kpi-green"), new("pipeline", FormatCurrency(PipelineAmount), "Pipeline", "Open estimated amount", "bi-cash-coin", "op-kpi-cyan"), new("weighted", FormatCurrency(WeightedAmount), "Weighted", "Probability-adjusted pipeline", "bi-graph-up-arrow", "op-kpi-purple"), new("closing", ClosingCount.ToString("N0", CultureInfo.CurrentCulture), "Closing", "Due within 7 days", "bi-calendar-x", "op-kpi-amber"), new("won", FormatCurrency(WonThisMonth), "Won", "Won this month", "bi-check2-circle", "op-kpi-green")];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("CRM", "/crm/leads"), new("Opportunities", "/crm/opportunities"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            if (_tenantId == Guid.Empty) await ResolveCurrentUserContextAsync();
            var opportunities = await Api.SearchOpportunitiesAsync(_tenantId, pageSize: 500);
            var accounts = await Api.SearchAccountsAsync(_tenantId, pageSize: 500);
            var users = await Api.SearchUsersAsync(_tenantId, pageSize: 500);
            var stages = await Api.SearchOpportunityStagesAsync(_tenantId, pageSize: 200);
            var forecastCategories = await Api.SearchOpportunityForecastCategoriesAsync(_tenantId, pageSize: 200);
            _accounts = accounts?.Items.ToList() ?? [];
            _users = users?.Items.ToList() ?? [];
            _stages = stages?.Items.OrderBy(s => s.SortOrder).ThenBy(s => s.StageName).ToList() ?? [];
            _forecastCategories = forecastCategories?.Items.OrderBy(c => c.SortOrder).ThenBy(c => c.CategoryName).ToList() ?? [];
            _rows = (opportunities?.Items ?? []).Select(MapOpportunity).OrderByDescending(r => r.PriorityScore).ToList();
            _selected = _selected is null ? FilteredRows.FirstOrDefault() : _rows.FirstOrDefault(r => r.Id == _selected.Id) ?? FilteredRows.FirstOrDefault();
            _selectedOwner = null;
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load opportunities: {ex.Message}";
            _rows = [];
            _selected = null;
            _selectedOwner = null;
            ShowToast($"Opportunity load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private OpportunityRow MapOpportunity(OpportunityDto dto)
    {
        var stage = !string.IsNullOrWhiteSpace(dto.StageName) ? dto.StageName! : OpportunityPageConstants.StageName(dto.StatusCode);
        var owner = !string.IsNullOrWhiteSpace(dto.OwnerName) ? dto.OwnerName! : OwnerName(dto.OwnerUserId);
        return new(dto.OpportunityId, dto.OpportunityNumber, dto.OpportunityName, dto.AccountName ?? AccountName(dto.AccountId), stage, dto.EstimatedAmount, (int)Math.Round(dto.WinProbability), OpportunityPageConstants.NormalizeForecast(dto.ForecastCategoryCode), dto.OwnerUserId, owner, dto.CloseDate, dto.Description, dto.SourceLead, dto.CreatedDateUtc);
    }

    private IEnumerable<OpportunityRow> ApplyFilters(IEnumerable<OpportunityRow> rows)
    {
        var query = rows;
        if (!string.IsNullOrWhiteSpace(_search)) { var term = _search.Trim(); query = query.Where(r => Contains(r.Name, term) || Contains(r.Number, term) || Contains(r.AccountName, term) || Contains(r.Owner, term) || Contains(r.Stage, term) || Contains(r.Forecast, term) || Contains(r.Description, term) || Contains(r.SourceLead, term)); }
        if (!string.IsNullOrWhiteSpace(_stageFilter)) query = query.Where(r => r.Stage == _stageFilter);
        if (!string.IsNullOrWhiteSpace(_ownerFilter)) query = _ownerFilter == "Unassigned" ? query.Where(r => r.Owner == "Unassigned") : query.Where(r => r.Owner == _ownerFilter);
        if (!string.IsNullOrWhiteSpace(_forecastFilter)) query = query.Where(r => r.Forecast == _forecastFilter);
        query = _activeFilter switch { "open" => query.Where(r => r.IsOpen), "pipeline" => query.Where(r => r.IsOpen), "weighted" => query.Where(r => r.IsOpen && r.WinPct > 0), "closing" => query.Where(r => r.IsOpen && r.DaysToClose <= 7), "highprob" => query.Where(r => r.WinPct >= 70), "commit" => query.Where(r => r.Forecast == "Commit"), "won" => query.Where(r => r.Stage == "Closed Won"), _ => query };
        return query.OrderByDescending(r => r.PriorityScore).ThenBy(r => r.CloseDate);
    }

    private IReadOnlyList<OwnerRow> BuildOwnerRows()
    {
        var rows = _rows.GroupBy(r => r.Owner).Select(g =>
        {
            var all = g.ToList();
            var open = all.Count(r => r.IsOpen);
            var total = all.Sum(r => r.Amount);
            var weighted = all.Sum(r => r.WeightedAmount);
            var closing = all.Count(r => r.IsOpen && r.DaysToClose <= 7);
            var status = g.Key == "Unassigned" ? "Gap" : closing > 0 ? "Urgent" : weighted >= 100000 ? "High Value" : "Stable";
            var summary = $"{open.ToString("N0", CultureInfo.CurrentCulture)} open opportunity(s), {FormatCurrency(weighted)} weighted pipeline.";
            return new OwnerRow(g.Key, all.Count, open, total, weighted, closing, status, summary);
        }).OrderByDescending(o => o.Status == "Gap").ThenByDescending(o => o.WeightedAmount).ThenBy(o => o.OwnerName).ToList();
        return rows;
    }

    private void OpenCreate()
    {
        _form = new() { ForecastCategoryCode = ForecastOptions.FirstOrDefault() ?? OpportunityPageConstants.DefaultForecastCategory, OwnerUserId = _tenantAdminUserId };
        _formError = string.Empty;
        _showCreate = true;
    }

    private void CloseCreate() { if (!_busy) { _showCreate = false; _formError = string.Empty; } }

    private async Task CreateOpportunityAsync()
    {
        if (_form.AccountId == Guid.Empty) { _formError = "Select an account."; return; }
        _busy = true;
        try
        {
            var id = await Api.CreateOpportunityAsync(new CreateOpportunityRequest { TenantId = _tenantId, AccountId = _form.AccountId, OpportunityName = _form.OpportunityName, EstimatedAmount = _form.EstimatedAmount, OwnerUserId = _form.OwnerUserId ?? _tenantAdminUserId, CloseDate = _form.CloseDate, WinProbability = _form.WinProbability, ForecastCategoryCode = _form.ForecastCategoryCode, CreatedByUserId = _tenantAdminUserId });
            _showCreate = false;
            await LoadAsync();
            ShowToast("Opportunity created.", "success");
            Nav.NavigateTo($"/crm/opportunities/{id}");
        }
        catch (Exception ex)
        {
            _formError = $"Create failed: {ex.Message}";
            ShowToast($"Create failed: {ex.Message}", "danger");
        }
        finally { _busy = false; }
    }

    private async Task MoveStageAsync(OpportunityRow row, string stage)
    {
        try
        {
            await Api.UpdateOpportunityStageAsync(row.Id, new UpdateOpportunityStageRequest { Stage = stage, ModifiedByUserId = _tenantAdminUserId });
            await LoadAsync();
            ShowToast($"{row.Name} moved to {stage}.", "success");
        }
        catch (Exception ex) { ShowToast($"Stage update failed: {ex.Message}", "danger"); }
    }

    private async Task CommitBulkAsync()
    {
        _busy = true;
        try
        {
            if (_showStage)
            {
                foreach (var row in _rows.Where(r => _selectedIds.Contains(r.Id))) await Api.UpdateOpportunityStageAsync(row.Id, new UpdateOpportunityStageRequest { Stage = _bulkStage, ModifiedByUserId = _tenantAdminUserId });
                ShowToast($"{_selectedIds.Count} opportunity(s) moved to {_bulkStage}.", "success");
            }
            else if (Guid.TryParse(_bulkOwner, out var ownerId))
            {
                foreach (var row in _rows.Where(r => _selectedIds.Contains(r.Id))) await Api.UpdateOpportunityAsync(row.Id, new UpdateOpportunityRequest { OpportunityName = row.Name, EstimatedAmount = row.Amount, CloseDate = row.CloseDate, WinProbability = row.WinPct, ForecastCategoryCode = row.Forecast, StageName = row.Stage, OwnerUserId = ownerId, Description = row.Description, ModifiedByUserId = _tenantAdminUserId });
                ShowToast($"{_selectedIds.Count} opportunity(s) assigned.", "success");
            }
            CloseBulkDialogs();
            _selectedIds.Clear();
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast($"Bulk action failed: {ex.Message}", "danger"); }
        finally { _busy = false; }
    }

    private void SetFilter(string filter) { _activeFilter = _activeFilter == filter && filter != "all" ? "all" : filter; if (filter is "closing" or "highprob" or "commit") _view = "table"; _selected = FilteredRows.FirstOrDefault(); _selectedOwner = null; }
    private void SetView(string view) { _view = view; _selected = FilteredRows.FirstOrDefault(); _selectedOwner = null; }
    private void SelectOpportunity(OpportunityRow row) { _selected = row; _selectedOwner = null; }
    private void SelectOwner(OwnerRow owner) { _selectedOwner = owner; _selected = null; }
    private void SelectTopOpportunity() { if (TopOpportunity is not null) { _selected = TopOpportunity; _view = "table"; } }
    private void ToggleSelection(Guid id) { if (!_selectedIds.Remove(id)) _selectedIds.Add(id); }
    private void ClearSelection() => _selectedIds.Clear();
    private void OpenBulkStage() { _bulkStage = StageOptions.FirstOrDefault() ?? OpportunityPageConstants.DefaultStageName; _showStage = true; _showAssign = false; }
    private void OpenBulkAssign() { if (_selected is not null) _selectedIds.Add(_selected.Id); _bulkOwner = string.Empty; _showAssign = true; _showStage = false; }
    private void CloseBulkDialogs() { if (!_busy) { _showStage = false; _showAssign = false; } }
    private void ResetFilters() { _activeFilter = "all"; _search = string.Empty; _stageFilter = string.Empty; _ownerFilter = string.Empty; _forecastFilter = string.Empty; _selected = FilteredRows.FirstOrDefault(); _selectedOwner = null; }
    private void OnSearchChanged(BlazorChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; _selected = FilteredRows.FirstOrDefault(); }
    private void OnStageChanged(BlazorChangeEventArgs e) { _stageFilter = e.Value?.ToString() ?? string.Empty; _activeFilter = "all"; _selected = FilteredRows.FirstOrDefault(); }
    private void OnOwnerChanged(BlazorChangeEventArgs e) { _ownerFilter = e.Value?.ToString() ?? string.Empty; _activeFilter = "all"; _selected = FilteredRows.FirstOrDefault(); }
    private void OnForecastChanged(BlazorChangeEventArgs e) { _forecastFilter = e.Value?.ToString() ?? string.Empty; _activeFilter = "all"; _selected = FilteredRows.FirstOrDefault(); }
    private void NavigateOpportunity(Guid id) => Nav.NavigateTo($"/crm/opportunities/{id}");
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind) { _toastMessage = message.Length <= 150 ? message : $"{message[..147]}..."; _toastKind = ToastKind(kind); _toastVisible = true; }

    private int ViewCount(string view) => view switch { "owners" => OwnerRows.Count, _ => FilteredRows.Count };
    private bool IsSelected(OpportunityRow row) => _selected?.Id == row.Id;
    private bool IsSelected(OwnerRow owner) => _selectedOwner?.OwnerName == owner.OwnerName;
    private string AccountName(Guid accountId) => _accounts.FirstOrDefault(a => a.AccountId == accountId)?.AccountName ?? "Unknown account";
    private string OwnerName(Guid? ownerId) { if (!ownerId.HasValue) return "Unassigned"; var user = _users.FirstOrDefault(u => u.UserId == ownerId.Value); return user is null ? "Unknown owner" : DisplayUser(user); }
    private static string DisplayUser(UserDto user) => !string.IsNullOrWhiteSpace(user.DisplayName) ? user.DisplayName : !string.IsNullOrWhiteSpace(user.FullName) ? user.FullName : user.UserName;
    private static string Initials(string name) { var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : parts.Length == 1 ? parts[0][..1] : "?"; }
    private string NextStage(string stage) { var stages = StageOptions.ToList(); var index = stages.FindIndex(s => string.Equals(s, stage, StringComparison.OrdinalIgnoreCase)); return index < 0 || index >= stages.Count - 1 ? stage : stages[index + 1]; }
    private static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static string FormatCurrency(decimal value) => value.ToString("C0", CultureInfo.CurrentCulture);
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.CurrentCulture) : "Not set";
    private static string WidthPct(decimal value, decimal max) => (max <= 0 ? 4 : Math.Max(4, Math.Min(100, (double)(value / max * 100)))).ToString("F1", CultureInfo.InvariantCulture) + "%";
    private static string ToastKind(string value) => value.Contains("danger", StringComparison.OrdinalIgnoreCase) || value.Contains("error", StringComparison.OrdinalIgnoreCase) ? "danger" : value.Contains("warning", StringComparison.OrdinalIgnoreCase) ? "warning" : "success";
    private string MetricCardClass(Metric metric) => $"op-kpi-card {metric.Tone} {(_activeFilter == metric.Filter ? "op-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewDef view) => $"op-view-btn {(view.Id == _view ? "op-view-btn-active" : string.Empty)}";
    private static string StageBadgeClass(string stage) => stage switch { "Closed Won" => "op-badge-success", "Closed Lost" => "op-badge-danger", "Negotiation" => "op-badge-warning", "Proposal" => "op-badge-purple", "Needs Analysis" => "op-badge-info", _ => "op-badge-neutral" };
    private static string ForecastBadgeClass(string forecast) => forecast switch { "Commit" => "op-badge-success", "Best Case" => "op-badge-info", "Closed" => "op-badge-purple", _ => "op-badge-neutral" };
    private static string OwnerBadgeClass(OwnerRow owner) => owner.Status switch { "Gap" => "op-badge-danger", "Urgent" => "op-badge-warning", "High Value" => "op-badge-success", _ => "op-badge-info" };
    private static string NextBestAction(OpportunityRow row) => row.IsOverdue ? "Close date has passed. Update close date, stage, or convert the decision outcome." : row.DaysToClose <= 7 ? "Confirm decision path, remove blockers, and update forecast confidence." : row.WinPct >= 70 ? "Protect the win plan and move the deal toward commit or close." : "Document next activity and strengthen qualification signals.";
    private static IEnumerable<string> Signals(OpportunityRow row) { yield return $"Forecast category: {row.Forecast}."; yield return $"Weighted value: {FormatCurrency(row.WeightedAmount)}."; if (row.DaysToClose <= 7) yield return "Close date is within seven days."; if (row.WinPct >= 70) yield return "High win probability opportunity."; if (row.Owner == "Unassigned") yield return "Owner assignment is required."; }

    private RenderFragment AnalyticsPanel(string title, IReadOnlyList<DistributionRow> rows, string icon, string tone) => @<section class="op-analytics-panel @tone"><h3><i class="bi @icon" aria-hidden="true"></i> @title</h3><div class="op-analytics-list">@foreach (var row in rows) { <button type="button" @onclick="@(() => ApplyDistribution(row.Label, title))"><span>@row.Label</span><div><i style="width:@row.Width"></i></div><strong>@FormatCurrency(row.Amount)</strong><small>@row.Count.ToString("N0", CultureInfo.CurrentCulture)</small></button> }</div></section>;
    private RenderFragment InsightPanel => @<section class="op-analytics-panel op-tone-amber"><h3><i class="bi bi-lightbulb" aria-hidden="true"></i> Executive insight</h3><div class="op-insight-grid"><div><span>Open</span><strong>@OpenCount</strong><small>active deals</small></div><div><span>Weighted</span><strong>@FormatCurrency(WeightedAmount)</strong><small>forecast</small></div><div><span>Closing</span><strong>@ClosingCount</strong><small>7 days</small></div><div><span>Win</span><strong>@AverageWinRate.ToString("F0")%</strong><small>average</small></div></div><p>@GuidanceText</p></section>;

    private void ApplyDistribution(string label, string title)
    {
        if (title.Contains("Stage", StringComparison.OrdinalIgnoreCase)) _stageFilter = _stageFilter == label ? string.Empty : label;
        else _forecastFilter = _forecastFilter == label ? string.Empty : label;
        _activeFilter = "all";
        _view = "table";
        _selected = FilteredRows.FirstOrDefault();
    }

    private static IReadOnlyList<DistributionRow> BuildDistribution(IEnumerable<DistributionSource> sources)
    {
        var rows = sources.GroupBy(s => s.Label).Select(g => new DistributionRow(g.Key, g.Count(), g.Sum(x => x.Amount), "0%")).OrderByDescending(r => r.Amount).ThenBy(r => r.Label).ToList();
        var max = Math.Max(1, rows.Select(r => r.Amount).DefaultIfEmpty(1).Max());
        return rows.Select(r => r with { Width = WidthPct(r.Amount, max) }).ToList();
    }

    private async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; }

    private sealed record ViewDef(string Id, string Label, string Icon);
    private sealed record Metric(string Filter, string Value, string Label, string Caption, string Icon, string Tone);
    private sealed record DistributionSource(string Label, int Count, decimal Amount);
    private sealed record DistributionRow(string Label, int Count, decimal Amount, string Width);
    private sealed record OwnerRow(string OwnerName, int Count, int OpenCount, decimal TotalAmount, decimal WeightedAmount, int ClosingCount, string Status, string Summary);
    private sealed record OpportunityRow(Guid Id, string Number, string Name, string AccountName, string Stage, decimal Amount, int WinPct, string Forecast, Guid? OwnerUserId, string Owner, DateTime? CloseDate, string? Description, string? SourceLead, DateTime CreatedDateUtc)
    {
        public bool IsOpen => Stage is not "Closed Won" and not "Closed Lost";
        public int DaysToClose => CloseDate.HasValue ? (int)Math.Ceiling((CloseDate.Value.Date - DateTime.UtcNow.Date).TotalDays) : int.MaxValue;
        public bool IsOverdue => IsOpen && CloseDate.HasValue && CloseDate.Value.Date < DateTime.UtcNow.Date;
        public decimal WeightedAmount => Amount * WinPct / 100m;
        public decimal PriorityScore => (IsOpen ? 500 : 0) + WeightedAmount + (DaysToClose <= 7 ? 250000 : 0) + (Forecast == "Commit" ? 150000 : 0) + (WinPct * 1000);
        public string Width => WidthPct(Math.Max(1, Amount), 1000000);
    }

    private sealed class OpportunityFormModel
    {
        [Required, StringLength(50)]
        public string OpportunityNumber { get; set; } = string.Empty;

        [Required]
        public Guid AccountId { get; set; }

        [Required, StringLength(200)]
        public string OpportunityName { get; set; } = string.Empty;

        [Range(0, 999999999999)]
        public decimal EstimatedAmount { get; set; }

        public DateTime? CloseDate { get; set; }

        [Range(0, 100)]
        public decimal WinProbability { get; set; }

        [Required, StringLength(50)]
        public string ForecastCategoryCode { get; set; } = string.Empty;

        public Guid? OwnerUserId { get; set; }

        [StringLength(2000)]
        public string? Description { get; set; }
    }
}
