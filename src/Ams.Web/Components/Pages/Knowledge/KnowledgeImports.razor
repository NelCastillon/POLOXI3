@page "/admin/knowledge/imports"
@attribute [Authorize(Policy = Ams.Web.Security.KnowledgePolicies.ConceptsRead)]
@using System.ComponentModel.DataAnnotations
@using Ams.Knowledge.Application.Features.Knowledge
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NotificationService Notifications
@inject CurrentUserContext CurrentUser
@inject ConfirmationDialogService Confirmations

<PageTitle>Knowledge Imports</PageTitle><KnowledgeWorkspace><AppPageHeader Title="Knowledge Imports" Subtitle="Queue and govern restart-safe semantic catalog ingestion" Icon="bi-cloud-arrow-up"><Actions><AuthorizeView Policy="@Ams.Web.Security.KnowledgePolicies.Import"><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> Queue import</button></AuthorizeView></Actions></AppPageHeader><section class="knowledge-panel"><KnowledgeSectionHeader Eyebrow="Data operations" Title="Import queue" Description="Queued and failed jobs can be corrected or removed. Processing and staged jobs remain immutable evidence."/><div class="knowledge-toolbar"><input class="knowledge-input knowledge-input-grow" placeholder="Search file or correlation ID" @bind="_search"/><select class="knowledge-input" @bind="_status"><option value="">All statuses</option>@foreach(var x in _statuses){<option value="@x.ValueCode">@x.DisplayName</option>}</select><button class="um-btn um-btn-ghost" @onclick="LoadAsync">Apply filters</button></div>@if(_error is not null){<KnowledgeStatePanel Tone="error" Title="Imports unavailable" Message="@_error"/>}else if(_loading){<KnowledgeStatePanel Title="Loading import queue"/>}else if(_items.Count==0){<KnowledgeStatePanel Title="No imports found" Message="Queue a governed import or adjust the filters."/>}else{<AppGrid TValue="KnowledgeImportDto" DataSource="_items" AllowPaging="true"><GridColumns><GridColumn Field="@nameof(KnowledgeImportDto.SourceFileName)" HeaderText="Source file"/><GridColumn Field="@nameof(KnowledgeImportDto.ImportTypeCode)" HeaderText="Type"/><GridColumn HeaderText="Status"><Template>@{var r=(KnowledgeImportDto)context;}<AppStatusBadge Status="@r.StatusCode"/></Template></GridColumn><GridColumn Field="@nameof(KnowledgeImportDto.RecordsProcessed)" HeaderText="Processed"/><GridColumn Field="@nameof(KnowledgeImportDto.RecordsFailed)" HeaderText="Failed"/><GridColumn Field="@nameof(KnowledgeImportDto.CreatedDateUtc)" HeaderText="Queued"/><GridColumn HeaderText="Actions" Width="100"><Template>@{var r=(KnowledgeImportDto)context;}@if(r.StatusCode is "QUEUED" or "FAILED"){<AuthorizeView Policy="@Ams.Web.Security.KnowledgePolicies.Import" Context="authorizationState"><div class="knowledge-actions"><button class="knowledge-icon-btn" @onclick="()=>OpenEdit(r)"><i class="bi bi-pencil"></i></button><button class="knowledge-icon-btn knowledge-icon-btn--danger" @onclick="()=>DeleteAsync(r)"><i class="bi bi-trash"></i></button></div></AuthorizeView>}</Template></GridColumn></GridColumns></AppGrid>}</section></KnowledgeWorkspace>
<AppCrudDrawer @bind-Visible="_drawer" Title="@(_editing is null?"Queue knowledge import":"Edit queued import")" Icon="bi-cloud-arrow-up" IsBusy="_saving"><Content><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator/><KnowledgeValidationSummary/><div class="knowledge-form-grid"><div class="knowledge-field"><label>Import type</label><InputText class="knowledge-input" @bind-Value="_form.Type"/><ValidationMessage For="()=>_form.Type"/></div><div class="knowledge-field"><label>Source file name</label><InputText class="knowledge-input" @bind-Value="_form.File"/><ValidationMessage For="()=>_form.File"/></div><div class="knowledge-field knowledge-field-wide"><label>Relative storage reference</label><InputText class="knowledge-input" @bind-Value="_form.Storage"/><ValidationMessage For="()=>_form.Storage"/><small>Path must remain beneath the configured Knowledge import root.</small></div><div class="knowledge-field knowledge-field-wide"><label>Change reason</label><InputTextArea class="knowledge-input" @bind-Value="_form.Reason"/><ValidationMessage For="()=>_form.Reason"/></div></div></EditForm></Content></AppCrudDrawer>
@code{private List<KnowledgeImportDto>_items=[];private List<KnowledgeLookupDto>_statuses=[];private string _search="",_status="";private bool _loading,_saving,_drawer;private string?_error;private KnowledgeImportDto?_editing;private ImportForm _form=new();protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Knowledge","/admin/knowledge"),new("Imports","/admin/knowledge/imports"));await LoadAsync();}private async Task LoadAsync(){_loading=true;try{var r=Api.SearchKnowledgeImportsAsync(_search,_status,pageSize:500);var s=Api.GetKnowledgeLookupsAsync("IMPORT_STATUS");await Task.WhenAll(r,s);_items=(r.Result?.Items??[]).ToList();_statuses=s.Result.ToList();}catch(Exception ex){_error=ex.Message;Fail("Import load failed",ex);}finally{_loading=false;}}private void OpenCreate(){_editing=null;_form=new();_drawer=true;}private void OpenEdit(KnowledgeImportDto r){_editing=r;_form=new(){Type=r.ImportTypeCode,File=r.SourceFileName,Storage=r.StorageReference,Reason="Corrected queued import metadata"};_drawer=true;}private async Task SaveAsync(){_saving=true;try{var u=await CurrentUser.RequireAsync();var c=Guid.NewGuid().ToString("N");if(_editing is null)await Api.QueueKnowledgeImportAsync(new(u.TenantId,_form.Type,"QUEUED",_form.File,_form.Storage,c,_form.Reason,u.UserId));else await Api.UpdateKnowledgeImportAsync(_editing.ImportJobId,new(u.TenantId,_editing.ImportJobId,_form.Type,_form.File,_form.Storage,_form.Reason,c,u.UserId,_editing.RowVersion));_drawer=false;await LoadAsync();}catch(Exception ex){Fail("Import save failed",ex);}finally{_saving=false;}}private async Task DeleteAsync(KnowledgeImportDto r){if(!await Confirmations.ConfirmAsync("Delete import job",$"Remove '{r.SourceFileName}' from the import queue?"))return;var u=await CurrentUser.RequireAsync();try{await Api.DeleteKnowledgeImportAsync(r.ImportJobId,new(u.TenantId,r.ImportJobId,"Deleted queued import job",Guid.NewGuid().ToString("N"),u.UserId,r.RowVersion));await LoadAsync();}catch(Exception ex){Fail("Import deletion failed",ex);}}private void Fail(string t,Exception e)=>Notifications.Add(new(Guid.NewGuid(),t,e.Message,"bi-exclamation-triangle","danger"));private sealed class ImportForm{[Required,StringLength(50)]public string Type{get;set;}="";[Required,StringLength(260)]public string File{get;set;}="";[Required,StringLength(1000)]public string Storage{get;set;}="";[Required]public string Reason{get;set;}="";}}
