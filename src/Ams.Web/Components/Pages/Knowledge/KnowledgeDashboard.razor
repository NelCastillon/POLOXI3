@page "/admin/knowledge"
@attribute [Authorize(Policy = Ams.Web.Security.KnowledgePolicies.ConceptsRead)]
@using Ams.Knowledge.Application.Features.Knowledge
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject NotificationService Notifications

<PageTitle>Insurance Knowledge Center</PageTitle>
<KnowledgeWorkspace>
    <AppPageHeader Title="Insurance Knowledge Center" Subtitle="Governed insurance terminology, taxonomy, carrier mappings, and semantic operations" Icon="bi-journal-richtext">
        <Actions><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-repeat"></i> Refresh</button></Actions>
    </AppPageHeader>
    @if (_loadError is not null) { <KnowledgeStatePanel Tone="error" Icon="bi-exclamation-triangle" Title="Knowledge Center unavailable" Message="@_loadError"><Actions><button class="um-btn um-btn-ghost" @onclick="LoadAsync">Try again</button></Actions></KnowledgeStatePanel> }
    @if (_dashboard is not null)
    {
        <div class="knowledge-kpis">
            <AppKpiCard Label="Active schemes" Value="@_dashboard.ActiveSchemes.ToString()" Icon="bi-collection" Variant="info" Href="/admin/knowledge/schemes" />
            <AppKpiCard Label="Published concepts" Value="@_dashboard.PublishedConcepts.ToString()" Icon="bi-journal-check" Variant="success" Href="/admin/knowledge/concepts" />
            <AppKpiCard Label="Searchable labels" Value="@_dashboard.SearchableLabels.ToString()" Icon="bi-tags" Variant="purple" Href="/admin/knowledge/concepts" />
            <AppKpiCard Label="Approved mappings" Value="@_dashboard.ApprovedMappings.ToString()" Icon="bi-arrow-left-right" Variant="success" Href="/admin/knowledge/mappings" />
            <AppKpiCard Label="Pending reviews" Value="@_dashboard.PendingMappingReviews.ToString()" Icon="bi-hourglass-split" Variant="warning" Href="/admin/knowledge/review" />
            <AppKpiCard Label="Failed imports" Value="@_dashboard.FailedImports.ToString()" Icon="bi-exclamation-octagon" Variant="danger" Href="/admin/knowledge/imports" />
        </div>
        <section class="knowledge-panel">
            <KnowledgeSectionHeader Eyebrow="Operating model" Title="Governance health" Description="The semantic layer remains relational, deterministic, tenant isolated, and fully audited." />
            <div class="knowledge-detail-grid">
                <div class="knowledge-detail"><small>Open governance work</small><strong>@_dashboard.DraftChangeRequests change requests</strong></div>
                <div class="knowledge-detail"><small>Resolution model</small><strong>Deterministic with human review</strong></div>
                <div class="knowledge-detail"><small>Data authority</small><strong>SQL Server governed catalog</strong></div>
                <div class="knowledge-detail"><small>Tenant boundary</small><strong>Global reference + tenant overlays</strong></div>
            </div>
        </section>
        <section class="knowledge-panel">
            <KnowledgeSectionHeader Eyebrow="Administration" Title="Governance workspaces" Description="Manage terminology, interoperability, quality controls, and controlled publication from dedicated workspaces." />
            <div class="knowledge-detail-grid">
                <a class="knowledge-detail text-decoration-none" href="/admin/knowledge/schemes"><small>Taxonomy</small><strong>Schemes and authorities</strong></a>
                <a class="knowledge-detail text-decoration-none" href="/admin/knowledge/rules"><small>Data quality</small><strong>Validation rules</strong></a>
                <a class="knowledge-detail text-decoration-none" href="/admin/knowledge/publications"><small>Release management</small><strong>Publications</strong></a>
                <a class="knowledge-detail text-decoration-none" href="/admin/knowledge/audit"><small>Evidence</small><strong>Audit trail</strong></a>
            </div>
        </section>
    }
    else if (_loading) { <KnowledgeStatePanel Icon="bi-arrow-repeat" Title="Loading governance metrics" Message="Collecting current catalog, mapping, review, and import health." /> }
</KnowledgeWorkspace>

@code {
    private KnowledgeDashboardDto? _dashboard;
    private bool _loading;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Administration", "/admin"), new("Insurance Knowledge Center", "/admin/knowledge"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try { _dashboard = await Api.GetKnowledgeDashboardAsync(); }
        catch (Exception ex) { _loadError = $"Failed to load Knowledge Center: {ex.Message}"; Danger("Knowledge Center load failed", ex); }
        finally { _loading = false; }
    }

    private void Danger(string title, Exception ex) => Notifications.Add(new(Guid.NewGuid(), title, ex.Message, "bi-exclamation-triangle", "danger"));
}
