@page "/admin/knowledge/mappings"
@attribute [Authorize(Policy = Ams.Web.Security.KnowledgePolicies.MappingsRead)]
@using System.ComponentModel.DataAnnotations
@using Ams.Knowledge.Application.Features.Knowledge
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NotificationService Notifications
@inject CurrentUserContext CurrentUser
@inject ConfirmationDialogService Confirmations

<PageTitle>External Mappings</PageTitle>
<KnowledgeWorkspace>
<AppPageHeader Title="Carrier & External Mappings" Subtitle="Govern deterministic translation from carrier, legacy AMS, document, and integration terminology" Icon="bi-arrow-left-right"><Actions><AuthorizeView Policy="@Ams.Web.Security.KnowledgePolicies.MappingsManage"><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New mapping</button></AuthorizeView></Actions></AppPageHeader>
<section class="knowledge-panel"><KnowledgeSectionHeader Eyebrow="Interoperability" Title="External terminology registry" Description="Every tenant mapping is reviewed before it can participate in deterministic resolution." /><div class="knowledge-toolbar"><input class="knowledge-input knowledge-input-grow" placeholder="Search external code or value" @bind="_search" @bind:event="oninput"/><select class="knowledge-input" @bind="_source"><option value="">All sources</option>@foreach(var x in _sources){<option value="@x.ValueCode">@x.DisplayName</option>}</select><select class="knowledge-input" @bind="_approval"><option value="">All decisions</option><option value="true">Approved</option><option value="false">Pending review</option></select><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-search"></i> Apply filters</button></div>
@if(_error is not null){<KnowledgeStatePanel Tone="error" Icon="bi-exclamation-triangle" Title="Mappings unavailable" Message="@_error"/>}else if(_loading){<KnowledgeStatePanel Icon="bi-arrow-repeat" Title="Loading mappings" Message="Retrieving governed external terminology."/>}else if(_items.Count==0){<KnowledgeStatePanel Title="No mappings found" Message="Create a tenant mapping or adjust the filters."/>}else{<AppGrid TValue="ExternalConceptMappingDto" DataSource="_items" AllowPaging="true" EnableHover="true"><GridColumns><GridColumn Field="@nameof(ExternalConceptMappingDto.SourceSystemTypeCode)" HeaderText="Source" Width="145"/><GridColumn Field="@nameof(ExternalConceptMappingDto.ExternalCode)" HeaderText="External code" Width="150"/><GridColumn Field="@nameof(ExternalConceptMappingDto.ExternalValue)" HeaderText="External value"/><GridColumn HeaderText="Canonical concept"><Template>@{var row=(ExternalConceptMappingDto)context;}@ConceptName(row.KnowledgeConceptId)</Template></GridColumn><GridColumn HeaderText="Decision" Width="120"><Template>@{var row=(ExternalConceptMappingDto)context;}<AppStatusBadge Status="@(row.IsApproved?"APPROVED":"PENDING")"/></Template></GridColumn><GridColumn HeaderText="Actions" Width="100"><Template>@{var row=(ExternalConceptMappingDto)context;}@if(row.TenantId.HasValue){<AuthorizeView Policy="@Ams.Web.Security.KnowledgePolicies.MappingsManage" Context="authorizationState"><div class="knowledge-actions"><button class="knowledge-icon-btn" @onclick="()=>OpenEdit(row)"><i class="bi bi-pencil"></i></button><button class="knowledge-icon-btn knowledge-icon-btn--danger" @onclick="()=>DeleteAsync(row)"><i class="bi bi-trash"></i></button></div></AuthorizeView>}</Template></GridColumn></GridColumns></AppGrid>}</section>
</KnowledgeWorkspace>
<AppCrudDrawer @bind-Visible="_drawer" Title="@(_editing is null?"Create external mapping":"Edit external mapping")" Icon="bi-arrow-left-right" IsBusy="_saving" ConfirmText="Save mapping"><Content><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator/><KnowledgeValidationSummary/><div class="knowledge-form-grid"><div class="knowledge-field"><label>Canonical concept</label><InputSelect class="knowledge-input" @bind-Value="_form.ConceptId"><option value="@Guid.Empty">Select concept</option>@foreach(var x in _concepts){<option value="@x.KnowledgeConceptId">@x.PreferredLabel</option>}</InputSelect><ValidationMessage For="()=>_form.ConceptId"/></div><div class="knowledge-field"><label>Source system</label><InputSelect class="knowledge-input" @bind-Value="_form.SourceType"><option value="">Select source</option>@foreach(var x in _sources){<option value="@x.ValueCode">@x.DisplayName</option>}</InputSelect></div><div class="knowledge-field"><label>External code</label><InputText class="knowledge-input" @bind-Value="_form.ExternalCode"/></div><div class="knowledge-field"><label>External value</label><InputText class="knowledge-input" @bind-Value="_form.ExternalValue"/><ValidationMessage For="()=>_form.ExternalValue"/></div><div class="knowledge-field"><label>Direction</label><InputSelect class="knowledge-input" @bind-Value="_form.Direction">@foreach(var x in _directions){<option value="@x.ValueCode">@x.DisplayName</option>}</InputSelect></div><div class="knowledge-field"><label>Match type</label><InputSelect class="knowledge-input" @bind-Value="_form.MatchType">@foreach(var x in _matchTypes){<option value="@x.ValueCode">@x.DisplayName</option>}</InputSelect></div><div class="knowledge-field"><label>Confidence (0–1)</label><InputNumber class="knowledge-input" @bind-Value="_form.Confidence"/></div><div class="knowledge-field"><label>State</label><InputText class="knowledge-input" @bind-Value="_form.State"/></div><div class="knowledge-field knowledge-field-wide"><label>External path</label><InputText class="knowledge-input" @bind-Value="_form.Path"/></div><div class="knowledge-field knowledge-field-wide"><label>Change reason</label><InputTextArea class="knowledge-input" rows="3" @bind-Value="_form.Reason"/><ValidationMessage For="()=>_form.Reason"/></div></div></EditForm></Content></AppCrudDrawer>
@code{
 private List<ExternalConceptMappingDto>_items=[];private List<KnowledgeConceptDto>_concepts=[];private List<KnowledgeLookupDto>_sources=[],_directions=[],_matchTypes=[];private string _search="",_source="",_approval="";private bool _loading,_saving,_drawer;private string?_error;private ExternalConceptMappingDto?_editing;private MappingForm _form=new();
 protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Knowledge","/admin/knowledge"),new("Mappings","/admin/knowledge/mappings"));await LoadAsync();}
 private async Task LoadAsync(){_loading=true;_error=null;try{bool? approved=bool.TryParse(_approval,out var a)?a:null;var rows=Api.SearchKnowledgeMappingsAsync(_search,_source,approved,pageSize:500);var concepts=Api.SearchKnowledgeConceptsAsync(pageSize:500);var sources=Api.GetKnowledgeLookupsAsync("SOURCE_SYSTEM_TYPE");var directions=Api.GetKnowledgeLookupsAsync("MAPPING_DIRECTION");var matches=Api.GetKnowledgeLookupsAsync("MATCH_TYPE");await Task.WhenAll(rows,concepts,sources,directions,matches);_items=(rows.Result?.Items??[]).ToList();_concepts=(concepts.Result?.Items??[]).ToList();_sources=sources.Result.ToList();_directions=directions.Result.ToList();_matchTypes=matches.Result.ToList();}catch(Exception ex){_error=ex.Message;Fail("Mapping load failed",ex);}finally{_loading=false;}}
 private string ConceptName(Guid id)=>_concepts.FirstOrDefault(x=>x.KnowledgeConceptId==id)?.PreferredLabel??id.ToString();private void OpenCreate(){_editing=null;_form=new(){Direction="BIDIRECTIONAL",MatchType="EXACT_EXTERNAL_CODE",Confidence=1m};_drawer=true;}private void OpenEdit(ExternalConceptMappingDto x){_editing=x;_form=new(){ConceptId=x.KnowledgeConceptId,SourceType=x.SourceSystemTypeCode,ExternalCode=x.ExternalCode,ExternalValue=x.ExternalValue,Direction=x.MappingDirectionCode,MatchType=x.MatchTypeCode,Confidence=x.ConfidenceScore,State=x.StateCode,Reason="Updated external terminology mapping"};_drawer=true;}
 private async Task SaveAsync(){_saving=true;try{var u=await CurrentUser.RequireAsync();var c=Guid.NewGuid().ToString("N");if(_editing is null)await Api.CreateKnowledgeMappingAsync(new(u.TenantId,_form.ConceptId,_form.SourceType,null,_form.ExternalCode,_form.ExternalValue,_form.Path,_form.Direction,_form.MatchType,"PENDING",_form.Confidence,_form.State,null,null,DateTime.UtcNow,null,_form.Reason,c,u.UserId));else await Api.UpdateKnowledgeMappingAsync(_editing.ExternalConceptMappingId,new(u.TenantId,_editing.ExternalConceptMappingId,_form.ConceptId,_form.SourceType,null,_form.ExternalCode,_form.ExternalValue,_form.Path,_form.Direction,_form.MatchType,_form.Confidence,_form.State,null,null,DateTime.UtcNow,null,_form.Reason,c,u.UserId,_editing.RowVersion));_drawer=false;Success("Mapping saved");await LoadAsync();}catch(Exception ex){Fail("Mapping save failed",ex);}finally{_saving=false;}}
 private async Task DeleteAsync(ExternalConceptMappingDto x){if(!await Confirmations.ConfirmAsync("Delete external mapping",$"Delete mapping '{x.ExternalValue}'?"))return;try{var u=await CurrentUser.RequireAsync();await Api.DeleteKnowledgeMappingAsync(x.ExternalConceptMappingId,new(u.TenantId,x.ExternalConceptMappingId,"Deleted external terminology mapping",Guid.NewGuid().ToString("N"),u.UserId,x.RowVersion));Success("Mapping deleted");await LoadAsync();}catch(Exception ex){Fail("Mapping deletion failed",ex);}}
 private void Success(string t)=>Notifications.Add(new(Guid.NewGuid(),t,"The mapping was submitted to governance.","bi-check-circle","success"));private void Fail(string t,Exception e)=>Notifications.Add(new(Guid.NewGuid(),t,e.Message,"bi-exclamation-triangle","danger"));private sealed class MappingForm{[Required]public Guid ConceptId{get;set;}[Required]public string SourceType{get;set;}="";public string?ExternalCode{get;set;}[Required,StringLength(500)]public string ExternalValue{get;set;}="";public string?Path{get;set;}[Required]public string Direction{get;set;}="";[Required]public string MatchType{get;set;}="";[Range(0,1)]public decimal?Confidence{get;set;}[StringLength(2,MinimumLength=2)]public string?State{get;set;}[Required]public string Reason{get;set;}="";}
}
