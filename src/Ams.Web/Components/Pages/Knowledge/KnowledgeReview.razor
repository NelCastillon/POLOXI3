@page "/admin/knowledge/review"
@attribute [Authorize(Policy = Ams.Web.Security.KnowledgePolicies.MappingsRead)]
@using Ams.Knowledge.Application.Features.Knowledge
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NotificationService Notifications

<PageTitle>Mapping Review Queue</PageTitle><KnowledgeWorkspace><AppPageHeader Title="Mapping Review Queue" Subtitle="Approve or reject governed carrier terminology mappings" Icon="bi-check2-square"/><section class="knowledge-panel"><KnowledgeSectionHeader Eyebrow="Four-eyes governance" Title="Pending mapping decisions" Description="Review records are immutable evidence. Decisions require a reason and are recorded with actor, correlation, and concurrency data."/><div class="knowledge-toolbar"><select class="knowledge-input knowledge-input-grow" @bind="_status"><option value="">All statuses</option>@foreach(var x in _statuses){<option value="@x.ValueCode">@x.DisplayName</option>}</select><button class="um-btn um-btn-ghost" @onclick="LoadAsync">Apply filter</button></div>@if(_error is not null){<KnowledgeStatePanel Tone="error" Title="Review queue unavailable" Message="@_error"/>}else if(_loading){<KnowledgeStatePanel Title="Loading review queue"/>}else if(_items.Count==0){<KnowledgeStatePanel Icon="bi-check2-circle" Title="Review queue is clear" Message="There are no mapping decisions matching the current status."/>}else{<AppGrid TValue="MappingReviewDto" DataSource="_items" AllowPaging="true"><GridColumns><GridColumn Field="@nameof(MappingReviewDto.MappingReviewId)" HeaderText="Review"/><GridColumn Field="@nameof(MappingReviewDto.ExternalConceptMappingId)" HeaderText="Mapping"/><GridColumn HeaderText="Status"><Template>@{var r=(MappingReviewDto)context;}<AppStatusBadge Status="@r.StatusCode"/></Template></GridColumn><GridColumn Field="@nameof(MappingReviewDto.ReviewReason)" HeaderText="Reason"/><GridColumn HeaderText="Decision" Width="210"><Template>@{var r=(MappingReviewDto)context;}@if(r.StatusCode=="PENDING"){<AuthorizeView Policy="@Ams.Web.Security.KnowledgePolicies.MappingsApprove" Context="authorizationState"><div class="knowledge-actions"><button class="um-btn um-btn-primary um-btn-xs" @onclick="()=>OpenDecision(r,true)"><i class="bi bi-check-lg"></i> Approve</button><button class="um-btn um-btn-ghost um-btn-xs" @onclick="()=>OpenDecision(r,false)"><i class="bi bi-x-lg"></i> Reject</button></div></AuthorizeView>}</Template></GridColumn></GridColumns></AppGrid>}</section></KnowledgeWorkspace>
@if(_selected is not null){<div class="knowledge-modal-backdrop" @onclick="Cancel"><div class="knowledge-modal" role="alertdialog" aria-modal="true" @onclick:stopPropagation="true"><header><h2 class="h5 mb-0">Confirm @(_approve?"mapping approval":"mapping rejection")</h2></header><div class="body"><p>The decision becomes permanent governance evidence and cannot be edited.</p><div class="knowledge-field"><label>Decision reason</label><textarea class="knowledge-input" rows="4" @bind="_reason"></textarea></div></div><footer><button class="um-btn um-btn-ghost" @onclick="Cancel">Cancel</button><button class="um-btn @(_approve?"um-btn-primary":"um-btn-danger")" @onclick="DecideAsync" disabled="@(string.IsNullOrWhiteSpace(_reason))">Record decision</button></footer></div></div>}
@code{private List<MappingReviewDto>_items=[];private List<KnowledgeLookupDto>_statuses=[];private MappingReviewDto?_selected;private string _status="PENDING",_reason="";private bool _approve,_loading;private string?_error;protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Knowledge","/admin/knowledge"),new("Review","/admin/knowledge/review"));await LoadAsync();}private async Task LoadAsync(){_loading=true;try{var r=Api.SearchKnowledgeReviewsAsync(_status,pageSize:500);var s=Api.GetKnowledgeLookupsAsync("MAPPING_REVIEW_STATUS");await Task.WhenAll(r,s);_items=(r.Result?.Items??[]).ToList();_statuses=s.Result.ToList();}catch(Exception ex){_error=ex.Message;Fail(ex);}finally{_loading=false;}}private void OpenDecision(MappingReviewDto r,bool approve){_selected=r;_approve=approve;_reason="";}private void Cancel(){_selected=null;_reason="";}private async Task DecideAsync(){if(_selected is null)return;try{await Api.ReviewKnowledgeMappingAsync(_selected.MappingReviewId,new(Guid.Empty,_selected.MappingReviewId,_selected.ExternalConceptMappingId,_approve?"APPROVED":"REJECTED",_reason,Guid.NewGuid().ToString("N"),Guid.Empty,_selected.RowVersion));Cancel();await LoadAsync();}catch(Exception ex){Fail(ex);}}private void Fail(Exception ex)=>Notifications.Add(new(Guid.NewGuid(),"Mapping review failed",ex.Message,"bi-exclamation-triangle","danger"));}
