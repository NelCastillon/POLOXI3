@page "/admin/knowledge/audit"
@attribute [Authorize(Policy = Ams.Web.Security.KnowledgePolicies.AuditRead)]
@using Ams.Knowledge.Application.Features.Knowledge
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NotificationService Notifications

<PageTitle>Knowledge Audit</PageTitle><KnowledgeWorkspace><AppPageHeader Title="Knowledge Audit History" Subtitle="Trace governed semantic changes, actors, reasons, versions, and correlations" Icon="bi-clock-history"/><section class="knowledge-panel"><KnowledgeSectionHeader Eyebrow="Compliance evidence" Title="Immutable change history" Description="Audit facts preserve the accountable actor, business reason, action, entity, and correlation identifier for every governed mutation."/><div class="knowledge-toolbar"><input class="knowledge-input knowledge-input-grow" placeholder="Search entity, reason, or correlation ID" @bind="_search"/><input class="knowledge-input" placeholder="Action type" @bind="_action"/><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-search"></i> Apply filters</button></div>@if(_error is not null){<KnowledgeStatePanel Tone="error" Title="Audit history unavailable" Message="@_error"/>}else if(_loading){<KnowledgeStatePanel Title="Loading audit evidence"/>}else if(_items.Count==0){<KnowledgeStatePanel Icon="bi-journal-check" Title="No audit events found" Message="No immutable events match the current filters."/>}else{<AppGrid TValue="KnowledgeAuditDto" DataSource="_items" AllowPaging="true"><GridColumns><GridColumn Field="@nameof(KnowledgeAuditDto.CreatedUtc)" HeaderText="Recorded UTC" Width="170"/><GridColumn HeaderText="Action" Width="120"><Template>@{var r=(KnowledgeAuditDto)context;}<AppStatusBadge Status="@r.ActionType"/></Template></GridColumn><GridColumn Field="@nameof(KnowledgeAuditDto.EntityName)" HeaderText="Entity"/><GridColumn Field="@nameof(KnowledgeAuditDto.ChangeReason)" HeaderText="Business reason" MinWidth="240"/><GridColumn Field="@nameof(KnowledgeAuditDto.CorrelationId)" HeaderText="Correlation"/></GridColumns></AppGrid>}</section></KnowledgeWorkspace>
@code{private List<KnowledgeAuditDto>_items=[];private string _search="",_action="";private bool _loading;private string?_error;protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Knowledge","/admin/knowledge"),new("Audit","/admin/knowledge/audit"));await LoadAsync();}private async Task LoadAsync(){_loading=true;_error=null;try{_items=(await Api.SearchKnowledgeAuditAsync(_search,_action,pageSize:500))?.Items.ToList()??[];}catch(Exception ex){_error=ex.Message;Notifications.Add(new(Guid.NewGuid(),"Audit load failed",ex.Message,"bi-exclamation-triangle","danger"));}finally{_loading=false;}}}
