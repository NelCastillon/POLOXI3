@page "/admin/knowledge/schemes"
@attribute [Authorize(Policy = Ams.Web.Security.KnowledgePolicies.ConceptsRead)]
@using System.ComponentModel.DataAnnotations
@using Ams.Knowledge.Application.Features.Knowledge
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NotificationService Notifications
@inject CurrentUserContext CurrentUser
@inject ConfirmationDialogService Confirmations

<PageTitle>Knowledge Schemes</PageTitle>
<KnowledgeWorkspace>
    <AppPageHeader Title="Concept Schemes" Subtitle="Govern taxonomy boundaries, authorities, lifecycle, and version identity" Icon="bi-collection">
        <Actions><AuthorizeView Policy="@Ams.Web.Security.KnowledgePolicies.ConceptsManage"><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New scheme</button></AuthorizeView></Actions>
    </AppPageHeader>
    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Taxonomy administration" Title="Scheme registry" Description="Global schemes are reference-only. Tenant schemes can be edited or removed with full audit evidence." />
        <div class="knowledge-toolbar"><input class="knowledge-input knowledge-input-grow" placeholder="Search scheme code, name, or description" @bind="_search" @bind:event="oninput" /><select class="knowledge-input" @bind="_status"><option value="">All statuses</option>@foreach(var status in _statuses){<option value="@status.ValueCode">@status.DisplayName</option>}</select><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-search"></i> Apply filters</button></div>
        @if (_error is not null){<KnowledgeStatePanel Tone="error" Icon="bi-exclamation-triangle" Title="Schemes unavailable" Message="@_error" />}
        else if (_loading){<KnowledgeStatePanel Icon="bi-arrow-repeat" Title="Loading schemes" Message="Retrieving global and tenant taxonomy definitions." />}
        else if (_items.Count==0){<KnowledgeStatePanel Title="No schemes found" Message="Adjust the filters or create a tenant-managed scheme." />}
        else{<AppGrid TValue="ConceptSchemeDto" DataSource="_items" AllowPaging="true" EnableHover="true"><GridColumns><GridColumn Field="@nameof(ConceptSchemeDto.SchemeCode)" HeaderText="Code" Width="180" /><GridColumn Field="@nameof(ConceptSchemeDto.Name)" HeaderText="Name" MinWidth="220" /><GridColumn Field="@nameof(ConceptSchemeDto.AuthorityCode)" HeaderText="Authority" Width="135" /><GridColumn HeaderText="Ownership" Width="145"><Template>@{var row=(ConceptSchemeDto)context;}<KnowledgeOwnershipBadge TenantId="@row.TenantId" IsSystemDefined="@row.IsSystemDefined" /></Template></GridColumn><GridColumn HeaderText="Status" Width="110"><Template>@{var row=(ConceptSchemeDto)context;}<AppStatusBadge Status="@row.StatusCode" /></Template></GridColumn><GridColumn HeaderText="Actions" Width="100"><Template>@{var row=(ConceptSchemeDto)context;}@if(row.TenantId.HasValue&&!row.IsSystemDefined){<div class="knowledge-actions"><button class="knowledge-icon-btn" title="Edit" @onclick="()=>OpenEdit(row)"><i class="bi bi-pencil"></i></button><button class="knowledge-icon-btn knowledge-icon-btn--danger" title="Delete" @onclick="()=>DeleteAsync(row)"><i class="bi bi-trash"></i></button></div>}</Template></GridColumn></GridColumns></AppGrid>}
    </section>
</KnowledgeWorkspace>

<AppCrudDrawer @bind-Visible="_drawer" Title="@(_editing is null ? "Create concept scheme" : "Edit concept scheme")" Icon="bi-collection" IsBusy="_saving" ConfirmText="Save scheme">
    <Content><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><KnowledgeValidationSummary /><div class="knowledge-form-grid"><div class="knowledge-field"><label>Scheme code</label><InputText class="knowledge-input" @bind-Value="_form.Code" disabled="@(_editing is not null)" /><ValidationMessage For="()=>_form.Code" /></div><div class="knowledge-field"><label>Name</label><InputText class="knowledge-input" @bind-Value="_form.Name" /><ValidationMessage For="()=>_form.Name" /></div><div class="knowledge-field"><label>Authority</label><InputText class="knowledge-input" @bind-Value="_form.Authority" /><ValidationMessage For="()=>_form.Authority" /></div><div class="knowledge-field"><label>Version</label><InputText class="knowledge-input" @bind-Value="_form.Version" /></div><div class="knowledge-field"><label>Status</label><InputSelect class="knowledge-input" @bind-Value="_form.Status"><option value="">Select status</option>@foreach(var status in _statuses){<option value="@status.ValueCode">@status.DisplayName</option>}</InputSelect><ValidationMessage For="()=>_form.Status" /></div><div class="knowledge-field knowledge-field-wide"><label>Description</label><InputTextArea class="knowledge-input" rows="4" @bind-Value="_form.Description" /></div><div class="knowledge-field knowledge-field-wide"><label>Change reason</label><InputTextArea class="knowledge-input" rows="3" @bind-Value="_form.Reason" /><ValidationMessage For="()=>_form.Reason" /></div></div></EditForm></Content>
</AppCrudDrawer>

@code{
    private List<ConceptSchemeDto> _items=[]; private List<KnowledgeLookupDto> _statuses=[]; private string _search="",_status=""; private bool _loading,_saving,_drawer; private string? _error; private ConceptSchemeDto? _editing; private SchemeForm _form=new();
    protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Knowledge","/admin/knowledge"),new("Schemes","/admin/knowledge/schemes"));await LoadAsync();}
    private async Task LoadAsync(){_loading=true;_error=null;try{var rows=Api.SearchKnowledgeSchemesAsync(_search,_status,pageSize:500);var states=Api.GetKnowledgeLookupsAsync("SCHEME_STATUS");await Task.WhenAll(rows,states);_items=(rows.Result?.Items??[]).ToList();_statuses=states.Result.ToList();}catch(Exception ex){_error=ex.Message;Danger("Scheme load failed",ex);}finally{_loading=false;}}
    private void OpenCreate(){_editing=null;_form=new(){Status="DRAFT",Authority="TENANT",Version="1.0"};_drawer=true;}
    private void OpenEdit(ConceptSchemeDto row){_editing=row;_form=new(){Code=row.SchemeCode,Name=row.Name,Description=row.Description,Authority=row.AuthorityCode,Version=row.VersionLabel,Status=row.StatusCode};_drawer=true;}
    private async Task SaveAsync(){_saving=true;try{var user=await CurrentUser.RequireAsync();var correlation=Guid.NewGuid().ToString("N");if(_editing is null)await Api.CreateKnowledgeSchemeAsync(new(user.TenantId,_form.Code,_form.Name,_form.Description,_form.Authority,_form.Version,_form.Status,user.TenantId,false,_form.Reason,correlation,user.UserId));else await Api.UpdateKnowledgeSchemeAsync(_editing.ConceptSchemeId,new(user.TenantId,_editing.ConceptSchemeId,_form.Name,_form.Description,_form.Authority,_form.Version,_form.Status,_form.Reason,correlation,user.UserId,_editing.RowVersion));_drawer=false;Success("Scheme saved");await LoadAsync();}catch(Exception ex){Danger("Scheme save failed",ex);}finally{_saving=false;}}
    private async Task DeleteAsync(ConceptSchemeDto row){if(!await Confirmations.ConfirmAsync("Delete concept scheme",$"Delete tenant scheme '{row.Name}'? This action is audited."))return;try{var user=await CurrentUser.RequireAsync();await Api.DeleteKnowledgeSchemeAsync(row.ConceptSchemeId,new(user.TenantId,row.ConceptSchemeId,$"Deleted tenant scheme {row.SchemeCode}",Guid.NewGuid().ToString("N"),user.UserId,row.RowVersion));Success("Scheme deleted");await LoadAsync();}catch(Exception ex){Danger("Scheme deletion failed",ex);}}
    private void Success(string title)=>Notifications.Add(new(Guid.NewGuid(),title,"The governed change was completed.","bi-check-circle","success")); private void Danger(string title,Exception ex)=>Notifications.Add(new(Guid.NewGuid(),title,ex.Message,"bi-exclamation-triangle","danger"));
    private sealed class SchemeForm{[Required,StringLength(100)]public string Code{get;set;}="";[Required,StringLength(200)]public string Name{get;set;}="";[StringLength(4000)]public string? Description{get;set;}[Required,StringLength(100)]public string Authority{get;set;}="";[StringLength(50)]public string? Version{get;set;}[Required]public string Status{get;set;}="";[Required,StringLength(1000)]public string Reason{get;set;}="";}
}
