@page "/admin/knowledge/concepts/{Id:guid}"
@attribute [Authorize(Policy = Ams.Web.Security.KnowledgePolicies.ConceptsRead)]
@using System.ComponentModel.DataAnnotations
@using Ams.Knowledge.Application.Features.Knowledge
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NotificationService Notifications
@inject CurrentUserContext CurrentUser
@inject ConfirmationDialogService Confirmations
@inject NavigationManager Nav

<PageTitle>@(_concept?.PreferredLabel ?? "Knowledge Concept")</PageTitle>
<KnowledgeWorkspace>
    <AppPageHeader Title="@(_concept?.PreferredLabel ?? "Knowledge Concept")" Subtitle="Canonical definition, terminology, ownership, and semantic relationships" Icon="bi-journal-bookmark" ReturnUrl="/admin/knowledge/concepts">
        <Actions>@if(CanManage){<button class="um-btn um-btn-ghost" @onclick="OpenEdit"><i class="bi bi-pencil"></i> Edit draft</button><button class="um-btn um-btn-danger" @onclick="DeleteConceptAsync"><i class="bi bi-trash"></i> Delete</button>}</Actions>
    </AppPageHeader>
    @if(_error is not null){<KnowledgeStatePanel Tone="error" Icon="bi-exclamation-triangle" Title="Concept unavailable" Message="@_error" />}
    else if(_loading){<KnowledgeStatePanel Icon="bi-arrow-repeat" Title="Loading concept workspace" Message="Retrieving terminology, hierarchy, and relationship context." />}
    else if(_concept is not null){
        <section class="knowledge-panel"><KnowledgeSectionHeader Eyebrow="Canonical record" Title="Definition and stewardship"><Actions><KnowledgeOwnershipBadge TenantId="@_concept.TenantId" IsSystemDefined="@_concept.IsSystemDefined" /></Actions></KnowledgeSectionHeader><div class="knowledge-detail-grid"><div class="knowledge-detail"><small>Concept code</small><strong>@_concept.ConceptCode</strong></div><div class="knowledge-detail"><small>Type</small><strong>@_concept.ConceptTypeCode</strong></div><div class="knowledge-detail"><small>Status</small><AppStatusBadge Status="@_concept.StatusCode" /></div><div class="knowledge-detail"><small>Version</small><strong>@_concept.VersionNumber</strong></div><div class="knowledge-detail knowledge-field-wide"><small>Definition</small><span>@(_concept.Definition??"No definition recorded")</span></div><div class="knowledge-detail"><small>Definition source</small><span>@_concept.DefinitionSource</span></div><div class="knowledge-detail"><small>Effective period</small><span>@_concept.EffectiveFromUtc.ToString("MMM d, yyyy") — @(_concept.EffectiveToUtc?.ToString("MMM d, yyyy")??"Open ended")</span></div></div></section>
        <section class="knowledge-panel"><KnowledgeSectionHeader Eyebrow="Terminology" Title="Labels and synonyms" Description="Searchable language-specific terminology used by deterministic resolution."><Actions>@if(CanManage){<button class="um-btn um-btn-primary" @onclick="OpenAddLabel"><i class="bi bi-plus-lg"></i> Add label</button>}</Actions></KnowledgeSectionHeader>@if(_labels.Count==0){<KnowledgeStatePanel Title="No labels" Message="Add approved terminology for this concept." />}else{<AppGrid TValue="ConceptLabelDto" DataSource="_labels"><GridColumns><GridColumn Field="@nameof(ConceptLabelDto.Label)" HeaderText="Label" /><GridColumn Field="@nameof(ConceptLabelDto.LabelTypeCode)" HeaderText="Type" Width="130" /><GridColumn Field="@nameof(ConceptLabelDto.LanguageCode)" HeaderText="Language" Width="100" /><GridColumn Field="@nameof(ConceptLabelDto.Source)" HeaderText="Source" /><GridColumn HeaderText="Actions" Width="100"><Template>@{var row=(ConceptLabelDto)context;}@if(row.TenantId.HasValue&&CanManage){<div class="knowledge-actions"><button class="knowledge-icon-btn" @onclick="()=>OpenEditLabel(row)"><i class="bi bi-pencil"></i></button><button class="knowledge-icon-btn knowledge-icon-btn--danger" @onclick="()=>DeleteLabelAsync(row)"><i class="bi bi-trash"></i></button></div>}</Template></GridColumn></GridColumns></AppGrid>}</section>
        <section class="knowledge-panel"><KnowledgeSectionHeader Eyebrow="Semantic graph" Title="Relationships" Description="Govern broader, narrower, coverage, requirement, and related-concept links."><Actions>@if(CanManage){<button class="um-btn um-btn-primary" @onclick="OpenAddRelationship"><i class="bi bi-plus-lg"></i> Add relationship</button>}</Actions></KnowledgeSectionHeader>@if(_relationships.Count==0){<KnowledgeStatePanel Title="No explicit relationships" Message="Hierarchy may still be represented through the parent concept." />}else{<AppGrid TValue="ConceptRelationshipDto" DataSource="_relationships"><GridColumns><GridColumn HeaderText="Direction"><Template>@{var row=(ConceptRelationshipDto)context;}@(row.SubjectConceptId==Id?"Outbound":"Inbound")</Template></GridColumn><GridColumn Field="@nameof(ConceptRelationshipDto.PredicateCode)" HeaderText="Predicate" /><GridColumn HeaderText="Related concept"><Template>@{var row=(ConceptRelationshipDto)context;}@ConceptName(row.SubjectConceptId==Id?row.ObjectConceptId:row.SubjectConceptId)</Template></GridColumn><GridColumn HeaderText="Status"><Template>@{var row=(ConceptRelationshipDto)context;}<AppStatusBadge Status="@row.StatusCode" /></Template></GridColumn><GridColumn HeaderText="Actions" Width="100"><Template>@{var row=(ConceptRelationshipDto)context;}@if(row.TenantId.HasValue&&CanManage){<div class="knowledge-actions"><button class="knowledge-icon-btn" @onclick="()=>OpenEditRelationship(row)"><i class="bi bi-pencil"></i></button><button class="knowledge-icon-btn knowledge-icon-btn--danger" @onclick="()=>DeleteRelationshipAsync(row)"><i class="bi bi-trash"></i></button></div>}</Template></GridColumn></GridColumns></AppGrid>}</section>
        <section class="knowledge-panel"><KnowledgeSectionHeader Eyebrow="Hierarchy" Title="Taxonomy position" /><div class="knowledge-detail-grid"><div><h3 class="h6">Ancestors</h3>@foreach(var item in _ancestors){<div class="knowledge-detail mb-2">@item.PreferredLabel <small>Depth @item.Depth</small></div>}</div><div><h3 class="h6">Descendants</h3>@foreach(var item in _descendants){<div class="knowledge-detail mb-2">@item.PreferredLabel <small>Depth @item.Depth</small></div>}</div></div></section>
    }
</KnowledgeWorkspace>

<AppCrudDrawer @bind-Visible="_conceptDrawer" Title="Edit concept draft" Icon="bi-pencil" IsBusy="_saving"><Content><EditForm Model="_conceptForm" OnValidSubmit="SaveConceptAsync"><DataAnnotationsValidator /><KnowledgeValidationSummary /><div class="knowledge-form-grid"><div class="knowledge-field"><label>Preferred label</label><InputText class="knowledge-input" @bind-Value="_conceptForm.Label" /><ValidationMessage For="()=>_conceptForm.Label" /></div><div class="knowledge-field"><label>Type</label><InputSelect class="knowledge-input" @bind-Value="_conceptForm.Type"><option value="">Select type</option>@foreach(var x in _types){<option value="@x.ValueCode">@x.DisplayName</option>}</InputSelect></div><div class="knowledge-field knowledge-field-wide"><label>Definition</label><InputTextArea class="knowledge-input" rows="5" @bind-Value="_conceptForm.Definition" /></div><div class="knowledge-field"><label>Definition source</label><InputText class="knowledge-input" @bind-Value="_conceptForm.Source" /><ValidationMessage For="()=>_conceptForm.Source" /></div><div class="knowledge-field"><label>Effective from</label><InputDate class="knowledge-input" @bind-Value="_conceptForm.From" /></div><div class="knowledge-field knowledge-field-wide"><label>Change reason</label><InputTextArea class="knowledge-input" rows="3" @bind-Value="_conceptForm.Reason" /><ValidationMessage For="()=>_conceptForm.Reason" /></div></div></EditForm></Content></AppCrudDrawer>
<AppCrudDrawer @bind-Visible="_labelDrawer" Title="@(_editingLabel is null?"Add concept label":"Edit concept label")" Icon="bi-tag" IsBusy="_saving"><Content><EditForm Model="_labelForm" OnValidSubmit="SaveLabelAsync"><DataAnnotationsValidator /><KnowledgeValidationSummary /><div class="knowledge-form-grid"><div class="knowledge-field knowledge-field-wide"><label>Label</label><InputText class="knowledge-input" @bind-Value="_labelForm.Label" /><ValidationMessage For="()=>_labelForm.Label" /></div><div class="knowledge-field"><label>Type</label><InputSelect class="knowledge-input" @bind-Value="_labelForm.Type"><option value="">Select type</option>@foreach(var x in _labelTypes){<option value="@x.ValueCode">@x.DisplayName</option>}</InputSelect></div><div class="knowledge-field"><label>Language</label><InputText class="knowledge-input" @bind-Value="_labelForm.Language" /></div><div class="knowledge-field"><label>Source</label><InputText class="knowledge-input" @bind-Value="_labelForm.Source" /></div><div class="knowledge-field"><label><InputCheckbox @bind-Value="_labelForm.Searchable" /> Searchable</label></div><div class="knowledge-field knowledge-field-wide"><label>Change reason</label><InputTextArea class="knowledge-input" @bind-Value="_labelForm.Reason" /><ValidationMessage For="()=>_labelForm.Reason" /></div></div></EditForm></Content></AppCrudDrawer>
<AppCrudDrawer @bind-Visible="_relationshipDrawer" Title="@(_editingRelationship is null?"Add relationship":"Edit relationship")" Icon="bi-diagram-3" IsBusy="_saving"><Content><EditForm Model="_relationshipForm" OnValidSubmit="SaveRelationshipAsync"><DataAnnotationsValidator /><KnowledgeValidationSummary /><div class="knowledge-form-grid"><div class="knowledge-field"><label>Predicate</label><InputSelect class="knowledge-input" @bind-Value="_relationshipForm.Predicate"><option value="">Select predicate</option>@foreach(var x in _predicates){<option value="@x.PredicateCode">@x.DisplayName</option>}</InputSelect></div><div class="knowledge-field"><label>Related concept</label><InputSelect class="knowledge-input" @bind-Value="_relationshipForm.ObjectId" disabled="@(_editingRelationship is not null)"><option value="@Guid.Empty">Select concept</option>@foreach(var x in _concepts.Where(x=>x.KnowledgeConceptId!=Id)){<option value="@x.KnowledgeConceptId">@x.PreferredLabel</option>}</InputSelect></div><div class="knowledge-field"><label>Strength</label><InputNumber class="knowledge-input" @bind-Value="_relationshipForm.Strength" /></div><div class="knowledge-field"><label>Status</label><InputSelect class="knowledge-input" @bind-Value="_relationshipForm.Status">@foreach(var x in _statuses){<option value="@x.ValueCode">@x.DisplayName</option>}</InputSelect></div><div class="knowledge-field knowledge-field-wide"><label>Change reason</label><InputTextArea class="knowledge-input" @bind-Value="_relationshipForm.Reason" /><ValidationMessage For="()=>_relationshipForm.Reason" /></div></div></EditForm></Content></AppCrudDrawer>

@code{
 [Parameter]public Guid Id{get;set;} private KnowledgeConceptDto? _concept;private List<ConceptLabelDto>_labels=[];private List<ConceptRelationshipDto>_relationships=[];private List<KnowledgeConceptDto>_concepts=[];private List<Ams.Knowledge.Contracts.Hierarchy.ConceptHierarchyNode>_ancestors=[],_descendants=[];private List<KnowledgeLookupDto>_labelTypes=[],_types=[],_statuses=[];private List<KnowledgeRelationshipPredicateDto>_predicates=[];private bool _loading,_saving,_conceptDrawer,_labelDrawer,_relationshipDrawer;private string? _error;private ConceptLabelDto?_editingLabel;private ConceptRelationshipDto?_editingRelationship;private ConceptForm _conceptForm=new();private LabelForm _labelForm=new();private RelationshipForm _relationshipForm=new();private bool CanManage=>_concept?.TenantId.HasValue==true&&!_concept.IsSystemDefined;
 protected override async Task OnParametersSetAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Knowledge","/admin/knowledge"),new("Concepts","/admin/knowledge/concepts"),new("Detail",$"/admin/knowledge/concepts/{Id}"));await LoadAsync();}
 private async Task LoadAsync(){_loading=true;_error=null;try{var c=Api.GetKnowledgeConceptAsync(Id);var l=Api.GetKnowledgeLabelsAsync(Id);var r=Api.GetKnowledgeRelationshipsAsync(Id);var a=Api.GetKnowledgeAncestorsAsync(Id);var d=Api.GetKnowledgeDescendantsAsync(Id);var all=Api.SearchKnowledgeConceptsAsync(pageSize:500);var lt=Api.GetKnowledgeLookupsAsync("LABEL_TYPE");var ct=Api.GetKnowledgeLookupsAsync("CONCEPT_TYPE");var st=Api.GetKnowledgeLookupsAsync("CONCEPT_STATUS");var p=Api.GetKnowledgeRelationshipPredicatesAsync();await Task.WhenAll(c,l,r,a,d,all,lt,ct,st,p);_concept=c.Result;_labels=l.Result.ToList();_relationships=r.Result.ToList();_ancestors=a.Result.ToList();_descendants=d.Result.ToList();_concepts=(all.Result?.Items??[]).ToList();_labelTypes=lt.Result.ToList();_types=ct.Result.ToList();_statuses=st.Result.ToList();_predicates=p.Result.ToList();if(_concept is null)_error="The concept was not found.";}catch(Exception ex){_error=ex.Message;Danger("Concept load failed",ex);}finally{_loading=false;}}
 private string ConceptName(Guid id)=>_concepts.FirstOrDefault(x=>x.KnowledgeConceptId==id)?.PreferredLabel??id.ToString();
 private void OpenEdit(){if(_concept is null)return;_conceptForm=new(){Label=_concept.PreferredLabel,Type=_concept.ConceptTypeCode,Definition=_concept.Definition,Source=_concept.DefinitionSource,From=_concept.EffectiveFromUtc,Reason="Updated concept stewardship metadata"};_conceptDrawer=true;}
 private async Task SaveConceptAsync(){if(_concept is null)return;_saving=true;try{var u=await CurrentUser.RequireAsync();await Api.UpdateKnowledgeConceptDraftAsync(Id,new(u.TenantId,Id,_conceptForm.Type,_conceptForm.Label,_conceptForm.Definition,_concept.ParentConceptId,_concept.IsAbstract,_concept.IsSelectable,_conceptForm.From,_concept.EffectiveToUtc,_concept.OwnerUserId,_concept.BusinessStewardUserId,_concept.TechnicalStewardUserId,_conceptForm.Source,_concept.LicensingNotes,_conceptForm.Reason,Guid.NewGuid().ToString("N"),u.UserId,_concept.RowVersion));_conceptDrawer=false;Success("Concept updated");await LoadAsync();}catch(Exception ex){Danger("Concept update failed",ex);}finally{_saving=false;}}
 private void OpenAddLabel(){_editingLabel=null;_labelForm=new(){Type="ALTERNATIVE",Language="en-US",Searchable=true};_labelDrawer=true;}private void OpenEditLabel(ConceptLabelDto x){_editingLabel=x;_labelForm=new(){Label=x.Label,Type=x.LabelTypeCode,Language=x.LanguageCode,Source=x.Source,Searchable=x.IsSearchable,Reason="Updated concept label"};_labelDrawer=true;}
 private async Task SaveLabelAsync(){var u=await CurrentUser.RequireAsync();_saving=true;try{if(_editingLabel is null)await Api.AddKnowledgeLabelAsync(Id,new(u.TenantId,Id,_labelForm.Label,_labelForm.Type,_labelForm.Language,_labelForm.Source,_labelForm.Searchable,u.TenantId,false,_labelForm.Reason,Guid.NewGuid().ToString("N"),u.UserId));else await Api.UpdateKnowledgeLabelAsync(Id,_editingLabel.ConceptLabelId,new(u.TenantId,_editingLabel.ConceptLabelId,_labelForm.Label,_labelForm.Type,_labelForm.Language,_labelForm.Source,_labelForm.Searchable,false,_labelForm.Reason,Guid.NewGuid().ToString("N"),u.UserId,_editingLabel.RowVersion));_labelDrawer=false;Success("Label saved");await LoadAsync();}catch(Exception ex){Danger("Label save failed",ex);}finally{_saving=false;}}
 private async Task DeleteLabelAsync(ConceptLabelDto x){if(!await Confirmations.ConfirmAsync("Delete label",$"Delete '{x.Label}'?"))return;var u=await CurrentUser.RequireAsync();try{await Api.DeleteKnowledgeLabelAsync(Id,x.ConceptLabelId,Delete(u,x.ConceptLabelId,x.RowVersion,"Deleted concept label"));await LoadAsync();}catch(Exception ex){Danger("Label deletion failed",ex);}}
 private void OpenAddRelationship(){_editingRelationship=null;_relationshipForm=new(){Status="DRAFT",Strength=1m};_relationshipDrawer=true;}private void OpenEditRelationship(ConceptRelationshipDto x){_editingRelationship=x;_relationshipForm=new(){Predicate=x.PredicateCode,ObjectId=x.SubjectConceptId==Id?x.ObjectConceptId:x.SubjectConceptId,Strength=x.RelationshipStrength,Status=x.StatusCode,Reason="Updated semantic relationship"};_relationshipDrawer=true;}
 private async Task SaveRelationshipAsync(){var u=await CurrentUser.RequireAsync();_saving=true;try{if(_editingRelationship is null)await Api.AddKnowledgeRelationshipAsync(new(u.TenantId,Id,_relationshipForm.Predicate,_relationshipForm.ObjectId,_relationshipForm.Strength,"Tenant governance",DateTime.UtcNow,null,_relationshipForm.Status,u.TenantId,false,_relationshipForm.Reason,Guid.NewGuid().ToString("N"),u.UserId));else await Api.UpdateKnowledgeRelationshipAsync(_editingRelationship.ConceptRelationshipId,new(u.TenantId,_editingRelationship.ConceptRelationshipId,_relationshipForm.Predicate,_relationshipForm.Strength,"Tenant governance",_editingRelationship.EffectiveFromUtc,_editingRelationship.EffectiveToUtc,_relationshipForm.Status,_relationshipForm.Reason,Guid.NewGuid().ToString("N"),u.UserId,_editingRelationship.RowVersion));_relationshipDrawer=false;Success("Relationship saved");await LoadAsync();}catch(Exception ex){Danger("Relationship save failed",ex);}finally{_saving=false;}}
 private async Task DeleteRelationshipAsync(ConceptRelationshipDto x){if(!await Confirmations.ConfirmAsync("Delete relationship","Remove this semantic relationship?"))return;var u=await CurrentUser.RequireAsync();try{await Api.DeleteKnowledgeRelationshipAsync(x.ConceptRelationshipId,Delete(u,x.ConceptRelationshipId,x.RowVersion,"Deleted semantic relationship"));await LoadAsync();}catch(Exception ex){Danger("Relationship deletion failed",ex);}}
 private async Task DeleteConceptAsync(){if(_concept is null||!await Confirmations.ConfirmAsync("Delete knowledge concept",$"Delete '{_concept.PreferredLabel}' and remove it from tenant searches?"))return;var u=await CurrentUser.RequireAsync();try{await Api.DeleteKnowledgeConceptAsync(Id,Delete(u,Id,_concept.RowVersion,"Deleted tenant knowledge concept"));Nav.NavigateTo("/admin/knowledge/concepts");}catch(Exception ex){Danger("Concept deletion failed",ex);}}
 private static DeleteKnowledgeEntityCommand Delete(CurrentUserContextModel u,Guid id,byte[] rv,string reason)=>new(u.TenantId,id,reason,Guid.NewGuid().ToString("N"),u.UserId,rv);private void Success(string t)=>Notifications.Add(new(Guid.NewGuid(),t,"The governed change was completed.","bi-check-circle","success"));private void Danger(string t,Exception e)=>Notifications.Add(new(Guid.NewGuid(),t,e.Message,"bi-exclamation-triangle","danger"));
 private sealed class ConceptForm{[Required]public string Label{get;set;}="";[Required]public string Type{get;set;}="";public string? Definition{get;set;}[Required]public string Source{get;set;}="";public DateTime From{get;set;}=DateTime.UtcNow;[Required]public string Reason{get;set;}="";}private sealed class LabelForm{[Required]public string Label{get;set;}="";[Required]public string Type{get;set;}="";[Required]public string Language{get;set;}="en-US";public string? Source{get;set;}public bool Searchable{get;set;}[Required]public string Reason{get;set;}="";}private sealed class RelationshipForm{[Required]public string Predicate{get;set;}="";[Required]public Guid ObjectId{get;set;}public decimal? Strength{get;set;}[Required]public string Status{get;set;}="";[Required]public string Reason{get;set;}="";}
}
