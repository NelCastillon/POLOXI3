@if (TenantId.HasValue && !IsSystemDefined)
{
    <span class="knowledge-ownership knowledge-ownership--tenant"><i class="bi bi-building"></i> Tenant managed</span>
}
else
{
    <span class="knowledge-ownership knowledge-ownership--global"><i class="bi bi-globe2"></i> Global reference</span>
}

@code {
    [Parameter] public Guid? TenantId { get; set; }
    [Parameter] public bool IsSystemDefined { get; set; }
}
