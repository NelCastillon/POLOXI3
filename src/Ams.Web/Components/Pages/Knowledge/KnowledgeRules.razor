@page "/admin/knowledge/rules"
@attribute [Authorize(Policy = Ams.Web.Security.KnowledgePolicies.ConceptsRead)]
@using System.ComponentModel.DataAnnotations
@using Ams.Knowledge.Application.Features.Knowledge
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NotificationService Notifications
@inject CurrentUserContext CurrentUser
@inject ConfirmationDialogService Confirmations
<PageTitle>Knowledge Validation Rules</PageTitle><KnowledgeWorkspace><AppPageHeader Title="Semantic Validation Rules" Subtitle="Govern reusable insurance data-quality and relationship controls" Icon="bi-ui-checks-grid"><Actions><AuthorizeView Policy="@Ams.Web.Security.KnowledgePolicies.RulesManage"><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New rule</button></AuthorizeView></Actions></AppPageHeader><section class="knowledge-panel"><KnowledgeSectionHeader Eyebrow="Data quality" Title="Rule registry" Description="Rules are evaluated against canonical concepts and retain tenant ownership, severity, lifecycle, and audit evidence."/><div class="knowledge-toolbar"><input class="knowledge-input knowledge-input-grow" placeholder="Search rule code or message" @bind="_search"/><select class="knowledge-input" @bind="_status"><option value="">All statuses</option>@foreach(var x in _statuses){<option value="@x.ValueCode">@x.DisplayName</option>}</select><button class="um-btn um-btn-ghost" @onclick="LoadAsync">Apply filters</button></div>@if(_error is not null){<KnowledgeStatePanel Tone="error" Title="Rules unavailable" Message="@_error"/>}else if(_loading){<KnowledgeStatePanel Title="Loading validation rules"/>}else if(_items.Count==0){<KnowledgeStatePanel Title="No rules found" Message="Create a tenant rule or adjust the filters."/>}else{<AppGrid TValue="KnowledgeValidationRuleDto" DataSource="_items" AllowPaging="true"><GridColumns><GridColumn Field="@nameof(KnowledgeValidationRuleDto.RuleCode)" HeaderText="Rule code"/><GridColumn HeaderText="Concept"><Template>@{var r=(KnowledgeValidationRuleDto)context;}@ConceptName(r.AppliesToConceptId)</Template></GridColumn><GridColumn Field="@nameof(KnowledgeValidationRuleDto.RuleTypeCode)" HeaderText="Type"/><GridColumn HeaderText="Severity"><Template>@{var r=(KnowledgeValidationRuleDto)context;}<AppStatusBadge Status="@r.SeverityCode"/></Template></GridColumn><GridColumn HeaderText="Ownership"><Template>@{var r=(KnowledgeValidationRuleDto)context;}<KnowledgeOwnershipBadge TenantId="@r.TenantId" IsSystemDefined="@r.IsSystemDefined"/></Template></GridColumn><GridColumn HeaderText="Actions" Width="100"><Template>@{var r=(KnowledgeValidationRuleDto)context;}@if(r.TenantId.HasValue&&!r.IsSystemDefined){<AuthorizeView Policy="@Ams.Web.Security.KnowledgePolicies.RulesManage" Context="authorizationState"><div class="knowledge-actions"><button class="knowledge-icon-btn" @onclick="()=>OpenEdit(r)"><i class="bi bi-pencil"></i></button><button class="knowledge-icon-btn knowledge-icon-btn--danger" @onclick="()=>DeleteAsync(r)"><i class="bi bi-trash"></i></button></div></AuthorizeView>}</Template></GridColumn></GridColumns></AppGrid>}</section></KnowledgeWorkspace>
<AppCrudDrawer @bind-Visible="_drawer" Title="@(_editing is null?"Create validation rule":"Edit validation rule")" Icon="bi-ui-checks-grid" IsBusy="_saving"><Content><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator/><KnowledgeValidationSummary/><div class="knowledge-form-grid"><div class="knowledge-field"><label>Rule code</label><InputText class="knowledge-input" @bind-Value="_form.Code" disabled="@(_editing is not null)"/><ValidationMessage For="()=>_form.Code"/></div><div class="knowledge-field"><label>Applies to concept</label><InputSelect class="knowledge-input" @bind-Value="_form.ConceptId"><option value="@Guid.Empty">Select concept</option>@foreach(var x in _concepts){<option value="@x.KnowledgeConceptId">@x.PreferredLabel</option>}</InputSelect></div><div class="knowledge-field"><label>Rule type</label><InputSelect class="knowledge-input" @bind-Value="_form.Type">@foreach(var x in _types){<option value="@x.ValueCode">@x.DisplayName</option>}</InputSelect></div><div class="knowledge-field"><label>Severity</label><InputSelect class="knowledge-input" @bind-Value="_form.Severity">@foreach(var x in _severities){<option value="@x.ValueCode">@x.DisplayName</option>}</InputSelect></div><div class="knowledge-field"><label>Property path</label><InputText class="knowledge-input" @bind-Value="_form.Path"/></div><div class="knowledge-field"><label>Operator</label><InputText class="knowledge-input" @bind-Value="_form.Operator"/></div><div class="knowledge-field"><label>Minimum count</label><InputNumber class="knowledge-input" @bind-Value="_form.Minimum"/></div><div class="knowledge-field"><label>Maximum count</label><InputNumber class="knowledge-input" @bind-Value="_form.Maximum"/></div><div class="knowledge-field knowledge-field-wide"><label>Expected value</label><InputText class="knowledge-input" @bind-Value="_form.Expected"/></div><div class="knowledge-field knowledge-field-wide"><label>Validation message</label><InputTextArea class="knowledge-input" @bind-Value="_form.Message"/><ValidationMessage For="()=>_form.Message"/></div><div class="knowledge-field knowledge-field-wide"><label>Change reason</label><InputTextArea class="knowledge-input" @bind-Value="_form.Reason"/><ValidationMessage For="()=>_form.Reason"/></div></div></EditForm></Content></AppCrudDrawer>
@code{private List<KnowledgeValidationRuleDto>_items=[];private List<KnowledgeConceptDto>_concepts=[];private List<KnowledgeLookupDto>_types=[],_severities=[],_statuses=[];private string _search="",_status="";private bool _loading,_saving,_drawer;private string?_error;private KnowledgeValidationRuleDto?_editing;private RuleForm _form=new();protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Knowledge","/admin/knowledge"),new("Validation Rules","/admin/knowledge/rules"));await LoadAsync();}private async Task LoadAsync(){_loading=true;try{var r=Api.SearchKnowledgeValidationRulesAsync(_search,_status,pageSize:500);var c=Api.SearchKnowledgeConceptsAsync(pageSize:500);var t=Api.GetKnowledgeLookupsAsync("RULE_TYPE");var s=Api.GetKnowledgeLookupsAsync("SEVERITY");var st=Api.GetKnowledgeLookupsAsync("CONCEPT_STATUS");await Task.WhenAll(r,c,t,s,st);_items=(r.Result?.Items??[]).ToList();_concepts=(c.Result?.Items??[]).ToList();_types=t.Result.ToList();_severities=s.Result.ToList();_statuses=st.Result.ToList();}catch(Exception ex){_error=ex.Message;Fail("Rule load failed",ex);}finally{_loading=false;}}private string ConceptName(Guid id)=>_concepts.FirstOrDefault(x=>x.KnowledgeConceptId==id)?.PreferredLabel??id.ToString();private void OpenCreate(){_editing=null;_form=new(){Type="REQUIREDPROPERTY",Severity="WARNING",Operator="NOT_EMPTY"};_drawer=true;}private void OpenEdit(KnowledgeValidationRuleDto r){_editing=r;_form=new(){Code=r.RuleCode,ConceptId=r.AppliesToConceptId,Type=r.RuleTypeCode,Path=r.PropertyPath,Operator=r.OperatorCode,Expected=r.ExpectedValue,Minimum=r.MinimumCount,Maximum=r.MaximumCount,Severity=r.SeverityCode,Message=r.Message,Reason="Updated semantic validation rule"};_drawer=true;}private async Task SaveAsync(){_saving=true;try{var u=await CurrentUser.RequireAsync();var c=Guid.NewGuid().ToString("N");if(_editing is null)await Api.CreateKnowledgeValidationRuleAsync(new(u.TenantId,_form.ConceptId,_form.Code,_form.Type,_form.Path,_form.Operator,_form.Expected,_form.Minimum,_form.Maximum,_form.Severity,_form.Message,DateTime.UtcNow,null,"DRAFT",_form.Reason,c,u.UserId));else await Api.UpdateKnowledgeValidationRuleAsync(_editing.ConceptValidationRuleId,new(u.TenantId,_editing.ConceptValidationRuleId,_form.ConceptId,_form.Type,_form.Path,_form.Operator,_form.Expected,_form.Minimum,_form.Maximum,_form.Severity,_form.Message,_editing.EffectiveFromUtc,_editing.EffectiveToUtc,_editing.StatusCode,_form.Reason,c,u.UserId,_editing.RowVersion));_drawer=false;await LoadAsync();}catch(Exception ex){Fail("Rule save failed",ex);}finally{_saving=false;}}private async Task DeleteAsync(KnowledgeValidationRuleDto r){if(!await Confirmations.ConfirmAsync("Delete validation rule",$"Delete rule '{r.RuleCode}'?"))return;var u=await CurrentUser.RequireAsync();try{await Api.DeleteKnowledgeValidationRuleAsync(r.ConceptValidationRuleId,new(u.TenantId,r.ConceptValidationRuleId,"Deleted tenant validation rule",Guid.NewGuid().ToString("N"),u.UserId,r.RowVersion));await LoadAsync();}catch(Exception ex){Fail("Rule deletion failed",ex);}}private void Fail(string t,Exception e)=>Notifications.Add(new(Guid.NewGuid(),t,e.Message,"bi-exclamation-triangle","danger"));private sealed class RuleForm{[Required]public string Code{get;set;}="";[Required]public Guid ConceptId{get;set;}[Required]public string Type{get;set;}="";public string?Path{get;set;}[Required]public string Operator{get;set;}="";public string?Expected{get;set;}public int?Minimum{get;set;}public int?Maximum{get;set;}[Required]public string Severity{get;set;}="";[Required]public string Message{get;set;}="";[Required]public string Reason{get;set;}="";}}
