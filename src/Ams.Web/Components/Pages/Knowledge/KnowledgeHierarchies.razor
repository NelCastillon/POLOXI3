@page "/admin/knowledge/hierarchies"
@attribute [Authorize(Policy = Ams.Web.Security.KnowledgePolicies.ConceptsRead)]
@using Ams.Knowledge.Application.Features.Knowledge
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NotificationService Notifications

<PageTitle>Knowledge Hierarchies</PageTitle><KnowledgeWorkspace><AppPageHeader Title="Concept Hierarchies" Subtitle="Inspect broader and narrower insurance concept relationships" Icon="bi-diagram-3"/><section class="knowledge-panel"><KnowledgeSectionHeader Eyebrow="Semantic navigation" Title="Hierarchy explorer" Description="Inspect transitive ancestors and descendants generated from governed broader and narrower relationships."/><div class="knowledge-toolbar"><select class="knowledge-input knowledge-input-grow" @bind="_selectedId"><option value="@Guid.Empty">Select a canonical concept</option>@foreach(var x in _concepts){<option value="@x.KnowledgeConceptId">@x.PreferredLabel (@x.ConceptCode)</option>}</select><button class="um-btn um-btn-primary" @onclick="LoadHierarchyAsync" disabled="@(_selectedId==Guid.Empty||_loading)"><i class="bi bi-diagram-3"></i> Explore hierarchy</button></div>@if(_error is not null){<KnowledgeStatePanel Tone="error" Title="Hierarchy unavailable" Message="@_error"/>}else if(_loading){<KnowledgeStatePanel Title="Loading hierarchy" Message="Resolving transitive semantic relationships."/>}else if(_selectedId==Guid.Empty){<KnowledgeStatePanel Icon="bi-signpost-split" Title="Select a concept" Message="Choose a canonical concept to inspect its broader and narrower context."/>}else{<div class="knowledge-detail-grid"><section><KnowledgeSectionHeader Eyebrow="Broader context" Title="Ancestors" Description="Concepts that classify or contain the selected concept."/>@if(_ancestors.Count==0){<KnowledgeStatePanel Title="No ancestors" Message="This concept is at the top of its hierarchy."/>}@foreach(var x in _ancestors){<div class="knowledge-detail mb-2"><strong>@x.PreferredLabel</strong><small>@x.ConceptCode · Depth @x.Depth</small></div>}</section><section><KnowledgeSectionHeader Eyebrow="Narrower context" Title="Descendants" Description="Concepts specialized beneath the selected concept."/>@if(_descendants.Count==0){<KnowledgeStatePanel Title="No descendants" Message="This concept is currently a hierarchy leaf."/>}@foreach(var x in _descendants){<div class="knowledge-detail mb-2"><strong>@x.PreferredLabel</strong><small>@x.ConceptCode · Depth @x.Depth</small></div>}</section></div>}</section></KnowledgeWorkspace>
@code{private List<KnowledgeConceptDto>_concepts=[];private List<Ams.Knowledge.Contracts.Hierarchy.ConceptHierarchyNode>_ancestors=[],_descendants=[];private Guid _selectedId;private bool _loading;private string?_error;protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Knowledge","/admin/knowledge"),new("Hierarchies","/admin/knowledge/hierarchies"));_loading=true;try{_concepts=(await Api.SearchKnowledgeConceptsAsync(pageSize:500))?.Items.ToList()??[];}catch(Exception ex){Fail(ex);}finally{_loading=false;}}private async Task LoadHierarchyAsync(){_loading=true;_error=null;try{var a=Api.GetKnowledgeAncestorsAsync(_selectedId);var d=Api.GetKnowledgeDescendantsAsync(_selectedId);await Task.WhenAll(a,d);_ancestors=a.Result.ToList();_descendants=d.Result.ToList();}catch(Exception ex){Fail(ex);}finally{_loading=false;}}private void Fail(Exception ex){_error=ex.Message;Notifications.Add(new(Guid.NewGuid(),"Hierarchy load failed",ex.Message,"bi-exclamation-triangle","danger"));}}
