@page "/knowledge/features-guide"
@attribute [Authorize(Policy = Ams.Web.Security.KnowledgePolicies.ConceptsRead)]
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>@PageTitleText</PageTitle>

<div class="fg-page">
    <AppPageHeader Title="@HeaderTitle" Subtitle="@HeaderSubtitle" Icon="@HeaderIcon">
        <Actions>
            @if (ShowDocumentIntake)
            {
                <button type="button" class="um-btn um-btn-ghost" @onclick="OpenDocumentIntelligenceSettings"><i class="bi bi-gear"></i> Manage Document Intelligence</button>
                <button type="button" class="um-btn um-btn-primary" @onclick="OpenDocumentIntake"><i class="bi bi-box-arrow-up-right"></i> Open Document Intake</button>
            }
            else if (ShowPremiumFinance)
            {
                <button type="button" class="um-btn um-btn-primary" @onclick="OpenPremiumFinance"><i class="bi bi-box-arrow-up-right"></i> Open Premium Finance</button>
            }
        </Actions>
    </AppPageHeader>

    @if (IsLanding)
    {
        <section class="fg-guide-index" aria-labelledby="feature-guide-title">
            <div class="fg-guide-index-intro">
                <span class="knowledge-eyebrow">Insurance Knowledge Center</span>
                <h2 id="feature-guide-title">Feature Guides</h2>
                <p>Select a dedicated guide for end-to-end workflows, connected modules, operational controls, user actions, data relationships, and implementation references.</p>
            </div>
            <div class="fg-guide-index-grid">
                <NavLink href="/knowledge/features-guide/document-intake" class="fg-guide-link">
                    <span class="fg-card-icon"><i class="bi bi-stars"></i></span>
                    <div><strong>AI Document Intake</strong><p>Capture documents, run governed OCR and AI interpretation, normalize knowledge, review extracted fields, resolve issues, and promote approved business data.</p><span>Open feature guide <i class="bi bi-arrow-right"></i></span></div>
                </NavLink>
                <NavLink href="/knowledge/features-guide/premium-finance" class="fg-guide-link">
                    <span class="fg-card-icon"><i class="bi bi-bank2"></i></span>
                    <div><strong>Premium Finance Module</strong><p>Connect quotes and policies to provider terms, applications, signatures, funding, payment schedules, account attention, documents, and servicing.</p><span>Open feature guide <i class="bi bi-arrow-right"></i></span></div>
                </NavLink>
            </div>
        </section>
    }

    @if (ShowDocumentIntake)
    {
    <section id="document-intake" class="fg-hero fg-feature-section" aria-labelledby="fg-title">
        <div>
            <span class="knowledge-eyebrow">First feature guide</span>
            <h2 id="fg-title">AI Document Intake</h2>
            <p>
                Document Intake is the governed AI-assisted pipeline that turns uploaded or inbound insurance documents into reviewed,
                validated business drafts that can be promoted into AMS workflows, especially submissions.
            </p>
            <div class="fg-flow" aria-label="Document Intake workflow summary">
                <span><i class="bi bi-cloud-arrow-up"></i> Capture</span>
                <span><i class="bi bi-shield-check"></i> Malware gate</span>
                <span><i class="bi bi-file-earmark-text"></i> OCR</span>
                <span><i class="bi bi-cpu"></i> AI extract</span>
                <span><i class="bi bi-diagram-3"></i> Normalize</span>
                <span><i class="bi bi-ui-checks-grid"></i> Validate</span>
                <span><i class="bi bi-person-check"></i> Review</span>
                <span><i class="bi bi-box-arrow-up-right"></i> Promote</span>
            </div>
        </div>
        <aside class="fg-hero-card">
            <span class="fg-card-icon"><i class="bi bi-stars"></i></span>
            <strong>AI accelerates intake. Humans approve business truth.</strong>
            <p>AI output is stored as draft evidence, not final AMS data, until review, validation, and promotion rules pass.</p>
        </aside>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Purpose" Title="What Document Intake does" Description="A full document-to-workflow operating model, not just a file upload screen." />
        <div class="fg-card-grid">
            <article class="fg-card"><i class="bi bi-folder2-open"></i><strong>Captures evidence</strong><span>Creates tenant-scoped intake sessions and links DMS source documents with role, sequence, hash, and file metadata.</span></article>
            <article class="fg-card"><i class="bi bi-robot"></i><strong>Uses governed AI</strong><span>Runs OCR, classification, extraction, normalization, and validation through approved providers, prompts, schemas, and tenant routes.</span></article>
            <article class="fg-card"><i class="bi bi-person-lines-fill"></i><strong>Requires review</strong><span>Presents extracted fields, warnings, and issues for human approval, correction, rejection, and audit history.</span></article>
            <article class="fg-card"><i class="bi bi-arrow-up-right-square"></i><strong>Promotes safely</strong><span>Converts reviewed data into business workflows through existing Submission Intake services using idempotency and readiness checks.</span></article>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Workflow" Title="End-to-end Document Intake lifecycle" Description="The practical user and system journey from document capture to promoted business record." />
        <ol class="fg-timeline">
            @foreach (var step in _workflow)
            {
                <li>
                    <span class="fg-step-number">@step.Number</span>
                    <div>
                        <h3>@step.Title</h3>
                        <p>@step.Description</p>
                        <small>@step.Control</small>
                    </div>
                </li>
            }
        </ol>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="AI architecture" Title="How the AI works" Description="Document Intake separates OCR, interpretation, safety, normalization, validation, and review." />
        <div class="fg-architecture">
            <article>
                <h3><i class="bi bi-file-earmark-richtext"></i> 1. OCR with Azure Document Intelligence</h3>
                <p>The worker downloads the source document, hashes the file, sends the stream to the tenant-configured Azure Document Intelligence route, polls for completion, and stores the raw OCR JSON as retained evidence.</p>
                <ul>
                    <li>Provider implementation: <code>AzureDocumentIntelligenceOcrProvider</code></li>
                    <li>Worker method: <code>DocumentIntakeProcessor.OcrAsync</code></li>
                    <li>Output includes text, pages, words, confidence, raw JSON, model, provider, and duration.</li>
                    <li>Routes are tenant-specific and database-backed through the OCR route repository.</li>
                </ul>
            </article>
            <article>
                <h3><i class="bi bi-cpu"></i> 2. Interpretation with Azure OpenAI</h3>
                <p>The worker reads retained OCR JSON, loads the approved database prompt and output schema, and routes the request through the AI provider router for classification and extraction.</p>
                <ul>
                    <li>Provider implementation: <code>AzureOpenAiDocumentInterpretationProvider</code></li>
                    <li>Worker method: <code>DocumentIntakeProcessor.InterpretAsync</code></li>
                    <li>Runtime prompt source: <code>DMS.AiPromptDefinition</code></li>
                    <li>Prompt lookup: <code>DocumentIntakeRepository.GetProcessingContextAsync</code></li>
                    <li>Expected structured output includes classification, fields, warnings, confidence, and source references.</li>
                    <li>AI output is stored as draft intake data, not written directly to final AMS records.</li>
                </ul>
            </article>
            <article>
                <h3><i class="bi bi-router"></i> 3. Tenant AI routing and safety</h3>
                <p>The AI provider router selects configured model routes by tenant, feature, and capability, checks provider health, supports failover, enforces safety limits, validates structured output, and records AI execution evidence.</p>
                <ul>
                    <li>Router: <code>AiProviderRouter</code></li>
                    <li>Controls include maximum input characters, maximum output characters, and structured JSON validation.</li>
                    <li>Every AI call is traceable by tenant, feature, correlation ID, source entity, prompt, provider, model, duration, and token counts.</li>
                    <li>Azure OpenAI receives the system prompt as the <code>system</code> message, OCR JSON as the <code>user</code> message, and the schema as strict <code>json_schema</code> response format.</li>
                </ul>
            </article>
            <article>
                <h3><i class="bi bi-stars"></i> 4. What LLM is used?</h3>
                <p>Document Intake uses an LLM during the interpretation step. The concrete provider implementation in this codebase is Azure OpenAI, but the exact model is not hardcoded in the worker.</p>
                <ul>
                    <li>LLM provider implementation: <code>AzureOpenAiProvider</code></li>
                    <li>Document interpretation adapter: <code>AzureOpenAiDocumentInterpretationProvider</code></li>
                    <li>Model selection: database-configured per tenant, feature, and capability through <code>AiProviderRouter</code>.</li>
                    <li>The route can define provider code, model code, deployment name, endpoint, credential reference, API version, temperature, max output tokens, and timeout.</li>
                    <li>In simple terms: the flow uses Azure OpenAI, and the selected GPT deployment comes from the tenant's AI provider route configuration.</li>
                </ul>
            </article>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Prompt governance" Title="Where the approved prompt and output schema are saved" Description="Document Intake prompts are database-backed, versioned, effective-dated, tenant-overridable, evaluated, approved, and audited." />
        <div class="fg-simple-flow" aria-label="Simple approved prompt and OCR flow">
            <div><span>1</span><strong>Database stores the instructions</strong><p>The approved prompt tells AI what to do, and the output schema tells AI the exact JSON shape to return.</p></div>
            <i class="bi bi-arrow-right"></i>
            <div><span>2</span><strong>Worker reads the OCR</strong><p>The uploaded document is already converted into OCR JSON by Azure Document Intelligence.</p></div>
            <i class="bi bi-arrow-right"></i>
            <div><span>3</span><strong>AI receives both together</strong><p>Azure OpenAI receives the approved prompt, OCR JSON, and required schema in one governed request.</p></div>
            <i class="bi bi-arrow-right"></i>
            <div><span>4</span><strong>AI returns draft fields</strong><p>The response becomes reviewable draft data, not final business data, until users validate and promote it.</p></div>
        </div>
        <div class="fg-architecture">
            <article>
                <h3><i class="bi bi-database-check"></i> Prompt table used by the Document Intake worker</h3>
                <p>The runtime Document Intake worker loads prompts from <code>DMS.AiPromptDefinition</code>, created by migration <code>0078_EnterpriseAiDocumentIntake.sql</code>.</p>
                <div class="fg-code-paths">
                    <span><strong>Table</strong><code>DMS.AiPromptDefinition</code></span>
                    <span><strong>Prompt text</strong><code>SystemPrompt</code></span>
                    <span><strong>Schema</strong><code>OutputSchemaJson</code></span>
                    <span><strong>Version</strong><code>VersionLabel</code></span>
                    <span><strong>Status</strong><code>DRAFT / APPROVED / RETIRED</code></span>
                    <span><strong>Tenant override</strong><code>TenantId nullable</code></span>
                </div>
                <p>The seeded prompt rows include <code>DOCUMENT.CLASSIFICATION</code>, <code>SUBMISSION.EXTRACTION</code>, <code>POLICY.EXTRACTION</code>, <code>CLAIM.EXTRACTION</code>, <code>ENDORSEMENT.INTENT</code>, <code>RENEWAL.SUMMARY</code>, and <code>QUOTE.COMPARISON</code>.</p>
            </article>
            <article>
                <h3><i class="bi bi-signpost-split"></i> How the correct prompt is selected</h3>
                <p><code>DocumentIntakeRepository.GetProcessingContextAsync</code> loads the active prompt for the leased work item and places it into <code>DocumentIntakeProcessingContext</code>.</p>
                <ul>
                    <li>For classification work, the prompt code is <code>DOCUMENT.CLASSIFICATION</code>.</li>
                    <li>For extraction work, the prompt code is built from the module, for example <code>SUBMISSION.EXTRACTION</code>.</li>
                    <li>The query only accepts <code>APPROVED</code> prompts whose effective dates are active.</li>
                    <li>Tenant-specific prompts win first; global prompts with <code>TenantId IS NULL</code> are fallback prompts.</li>
                    <li>If no active approved prompt/schema exists, the worker throws <code>APPROVED_PROMPT_MISSING</code> and does not call the model.</li>
                </ul>
            </article>
            <article>
                <h3><i class="bi bi-chat-square-text"></i> What is sent to Azure OpenAI</h3>
                <p><code>AzureOpenAiDocumentInterpretationProvider</code> combines database prompt governance with retained OCR evidence.</p>
                <div class="fg-message-grid">
                    <div><strong>System message</strong><span>Loaded from <code>DMS.AiPromptDefinition.SystemPrompt</code>.</span></div>
                    <div><strong>User message</strong><span>Built at runtime with module, correlation ID, and retained OCR JSON.</span></div>
                    <div><strong>Output schema</strong><span>Loaded from <code>DMS.AiPromptDefinition.OutputSchemaJson</code>.</span></div>
                    <div><strong>Feature code</strong><span>The prompt code, such as <code>SUBMISSION.EXTRACTION</code>, drives AI route selection.</span></div>
                </div>
            </article>
            <article>
                <h3><i class="bi bi-braces"></i> How the schema is enforced</h3>
                <p><code>AzureOpenAiProvider.GenerateAsync</code> parses the stored <code>OutputSchemaJson</code> and sends it to Azure OpenAI as strict structured output.</p>
                <ul>
                    <li>The provider builds <code>response_format.type = json_schema</code>.</li>
                    <li>The schema name is derived from the feature/prompt code.</li>
                    <li><code>strict = true</code> is sent with the schema.</li>
                    <li>The AI router also checks that structured output is valid JSON when the safety policy enables structured output validation.</li>
                </ul>
            </article>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Evaluation and audit" Title="How prompt changes are tested, approved, and traced" Description="Prompt changes can be evaluated before approval, and every production interpretation records the prompt/model evidence used." />
        <div class="fg-two-column">
            <div>
                <h3>Prompt evaluation workflow</h3>
                <ul class="fg-check-list">
                    <li>Prompt suites and cases define expected outputs and scoring rules.</li>
                    <li>Users can queue evaluation runs through Document Intake operations endpoints.</li>
                    <li><code>DocumentIntakePromptEvaluationWorkerService</code> executes the candidate prompt through the same interpretation provider used in production.</li>
                    <li>Actual output is compared to expected output and scored.</li>
                    <li>Approval can require a passing evaluation run using <code>DocumentIntake.PromptEvaluation.RequirePassedRunForApproval</code>.</li>
                </ul>
            </div>
            <div>
                <h3>Execution audit trail</h3>
                <ul class="fg-check-list">
                    <li><code>DMS.AiExecution</code> records the prompt code and prompt version used for OCR and interpretation work.</li>
                    <li>Input and output payload references are stored for retained OCR and AI JSON evidence.</li>
                    <li>Input and output hashes support repeatability and evidence integrity.</li>
                    <li>Provider, model, duration, confidence, input tokens, and output tokens are captured.</li>
                    <li>Prompt output becomes reviewed draft fields; it is not trusted as final AMS business data.</li>
                </ul>
            </div>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Governance" Title="Why AI output is controlled" Description="The feature is built for insurance operations where extracted values need review, evidence, and repeatability." />
        <div class="fg-two-column">
            <div>
                <h3>Controls before processing</h3>
                <ul class="fg-check-list">
                    <li>Authenticated user and tenant context from the API controller.</li>
                    <li>Supported module validation for submission, policy, lead, renewal, claim, account, certificate, CRM, compliance, and related areas.</li>
                    <li>Malware scanning gate before queueing when enabled.</li>
                    <li>Idempotency keys to prevent duplicate intake or promotion flows.</li>
                    <li>Approved prompt, prompt version, and output schema required before interpretation.</li>
                </ul>
            </div>
            <div>
                <h3>Controls after extraction</h3>
                <ul class="fg-check-list">
                    <li>Knowledge mapping normalizes AI text to canonical concepts and known AMS values.</li>
                    <li>Validation and rules evaluate extracted facts before promotion.</li>
                    <li>Users approve, correct, or reject fields with review history.</li>
                    <li>Promotion readiness blocks incomplete or invalid submissions.</li>
                    <li>Source documents, notes, and follow-up tasks can be linked to promoted records.</li>
                </ul>
            </div>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Statuses" Title="Session and worker state model" Description="Document Intake uses explicit states so users and operators can see where work is blocked." />
        <div class="fg-status-grid">
            <div>
                <h3>Session statuses</h3>
                <div class="fg-pill-list">
                    @foreach (var status in _sessionStatuses)
                    {
                        <span>@status</span>
                    }
                </div>
                <p>Sessions move from draft and queueing through processing, review, readiness, completion, failure, or cancellation.</p>
            </div>
            <div>
                <h3>Work item types</h3>
                <div class="fg-pill-list">
                    @foreach (var workType in _workTypes)
                    {
                        <span>@workType</span>
                    }
                </div>
                <p>Work items are leased by background workers and can retry, fail, dead-letter, or complete independently.</p>
            </div>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Review and promotion" Title="From draft evidence to real AMS workflow" Description="Promotion currently uses the governed Submission Intake path for submission documents." />
        <div class="fg-promotion">
            <div class="fg-promotion-main">
                <h3>Submission promotion path</h3>
                <p>For <code>SUBMISSION</code> intake, the service builds a reviewed submission draft, captures a Submission Intake record, promotes it into account/opportunity/submission workflow, links source documents, optionally creates a follow-up task, and adds a source note.</p>
                <div class="fg-code-paths">
                    <span><strong>API</strong><code>DocumentIntakeController.Promote</code></span>
                    <span><strong>Service</strong><code>DocumentIntakeService.PromoteAsync</code></span>
                    <span><strong>Capture</strong><code>ISubmissionIntakeService.CaptureAsync</code></span>
                    <span><strong>Promote</strong><code>ISubmissionIntakeService.PromoteAsync</code></span>
                </div>
            </div>
            <aside>
                <h3>Promotion blockers</h3>
                <ul>
                    <li>Unsupported module promotion path.</li>
                    <li>Missing line of business mapping.</li>
                    <li>Unresolved validation blockers.</li>
                    <li>Incomplete review state.</li>
                    <li>Missing tenant promotion configuration.</li>
                </ul>
            </aside>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Operational guide" Title="Where users and operators work" Description="Primary routes and components for Document Intake." />
        <div class="fg-route-grid">
            @foreach (var route in _routes)
            {
                <article>
                    <span><i class="bi @route.Icon"></i> @route.Area</span>
                    <strong>@route.Name</strong>
                    <code>@route.Path</code>
                    <p>@route.Description</p>
                </article>
            }
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Implementation map" Title="Important code areas" Description="Key implementation files for developers reviewing or extending the feature." />
        <div class="fg-file-list">
            @foreach (var file in _files)
            {
                <div>
                    <strong>@file.Name</strong>
                    <code>@file.Path</code>
                    <span>@file.Description</span>
                </div>
            }
        </div>
    </section>

    }

    @if (ShowPremiumFinance)
    {
    <section id="premium-finance" class="fg-hero fg-feature-section fg-hero--finance" aria-labelledby="pf-guide-title">
        <div>
            <span class="knowledge-eyebrow">Agency-facing feature guide</span>
            <h2 id="pf-guide-title">Premium Finance Management</h2>
            <p>
                Premium Finance Management connects eligible quotes, policies, renewals, submissions, and accounts to provider terms,
                customer selection, application and signature processing, funding, payment schedules, account monitoring, documents, and a complete activity history.
            </p>
            <div class="fg-flow" aria-label="Premium finance workflow summary">
                <span><i class="bi bi-link-45deg"></i> Connect source</span>
                <span><i class="bi bi-calculator"></i> Request terms</span>
                <span><i class="bi bi-ui-radios-grid"></i> Compare options</span>
                <span><i class="bi bi-check2-square"></i> Select</span>
                <span><i class="bi bi-send"></i> Apply</span>
                <span><i class="bi bi-pen"></i> Sign</span>
                <span><i class="bi bi-cash-coin"></i> Fund</span>
                <span><i class="bi bi-calendar2-check"></i> Service</span>
            </div>
        </div>
        <aside class="fg-hero-card">
            <span class="fg-card-icon"><i class="bi bi-bank2"></i></span>
            <strong>The agency manages the financing relationship without replacing the finance company.</strong>
            <p>The AMS records provider terms, approvals, evidence, schedules, and servicing status while the provider remains authoritative for funding, payments, payoff, and cancellation notices.</p>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenPremiumFinance"><i class="bi bi-box-arrow-up-right"></i> Open workbench</button>
        </aside>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Start here" Title="Where financing happens and what to click" Description="In simple terms: the quote, policy, renewal, or account sends the user to Premium Finance, but the financing work itself happens in the Premium Finance workbench." />
        <div class="fg-next-action">
            <i class="bi bi-bank2"></i>
            <div>
                <strong>The financing workspace is <code>/premium-finance</code>.</strong>
                <span>The originating module supplies the business context. Premium Finance then creates the request, records provider terms, tracks the application and agreement, confirms funding, and services the payment schedule.</span>
            </div>
        </div>
        <div class="fg-route-grid">
            <article>
                <span><i class="bi bi-receipt"></i> Quote Detail</span>
                <strong>Click “Finance Premium”</strong>
                <p>This opens the Finance Premium dialog with the selected quote already identified. Review the loaded insured, carrier, premium, taxes, and fees; choose an optional provider and requested terms; then click <strong>Create Request</strong>.</p>
            </article>
            <article>
                <span><i class="bi bi-file-earmark-check"></i> Policy Detail</span>
                <strong>Click “Finance Premium”</strong>
                <p>This opens the dialog with the current policy ID. Confirm that the policy is eligible and the premium is correct, enter financing preferences, then click <strong>Create Request</strong>.</p>
            </article>
            <article>
                <span><i class="bi bi-arrow-repeat"></i> Renewal Detail</span>
                <strong>Click “Renew Financing”</strong>
                <p>This opens Premium Finance with the renewal record. Verify the renewal premium and customer context, create the request, and then obtain replacement financing terms.</p>
            </article>
            <article>
                <span><i class="bi bi-box-seam"></i> Submission</span>
                <strong>Open the selected quote first</strong>
                <p>A submission does not create financing directly. Open an eligible returned quote, select or accept it, and click <strong>Finance Premium</strong> from Quote Detail. The submission relationship is retained through the quote.</p>
            </article>
            <article>
                <span><i class="bi bi-building"></i> Account 360</span>
                <strong>Click “Financing”</strong>
                <p>This opens the workbench filtered to that account. To create financing, click <strong>Finance Premium</strong>, select Quote, Policy, or Renewal, paste its record ID, and click the search <strong>Load</strong> button.</p>
            </article>
            <article>
                <span><i class="bi bi-layout-sidebar"></i> Main navigation</span>
                <strong>Open Premium Finance → Dashboard</strong>
                <p>Use this route when starting without a related record page. Click <strong>Finance Premium</strong>, choose the source type, enter the source record ID, click <strong>Load</strong>, and create the request after eligibility is confirmed.</p>
            </article>
        </div>
        <div class="fg-next-action">
            <i class="bi bi-search"></i>
            <div><strong>What the search button does</strong><span><strong>Load</strong> searches only the current tenant, reloads the source from the database, and checks eligibility. The Create Request button stays disabled until an eligible source is found.</span></div>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Connections" Title="Where premium finance enters the AMS workflow" Description="Start from an eligible source record; the service resolves trusted source data before creating a request." />
        <div class="fg-card-grid">
            <article class="fg-card"><i class="bi bi-receipt"></i><strong>Quote</strong><span>Finance a selected or presented quote using its account, submission, carrier, producer, premium, taxes, fees, effective date, and quote number.</span></article>
            <article class="fg-card"><i class="bi bi-file-earmark-check"></i><strong>Policy</strong><span>Connect financing to an issued or active policy and preserve the policy, account, carrier, line-of-business, and premium relationship.</span></article>
            <article class="fg-card"><i class="bi bi-arrow-repeat"></i><strong>Renewal</strong><span>Prepare replacement financing for a renewal while retaining the related policy, account, producer, effective date, and renewal context.</span></article>
            <article class="fg-card"><i class="bi bi-box-seam"></i><strong>Submission</strong><span>Open the selected or accepted quote from the submission and start financing from Quote Detail. The resulting request retains the quote's submission relationship.</span></article>
            <article class="fg-card"><i class="bi bi-building"></i><strong>Account</strong><span>Click Financing in Account 360 to open the account-filtered workbench. Every request remains account-scoped for insured, communications, documents, and history.</span></article>
            <article class="fg-card"><i class="bi bi-diagram-3"></i><strong>Related modules</strong><span>Uses Billing finance companies and agreements, DMS documents, e-sign envelope references, IAM users, carriers, activities, and policy or quote identifiers.</span></article>
        </div>
        <div class="fg-next-action">
            <i class="bi bi-info-circle"></i>
            <div><strong>Connection rule</strong><span>The API reloads the selected source inside the tenant, verifies eligibility, and copies authoritative values into the request. Client-entered source details cannot override the resolved quote, policy, renewal, submission, or account data.</span></div>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Before starting" Title="Configuration and readiness checklist" Description="Complete these steps before agency staff submit live premium finance business." />
        <div class="fg-two-column">
            <div>
                <h3>Agency and provider setup</h3>
                <ul class="fg-check-list">
                    <li>Confirm the tenant has active finance companies in <code>Billing.FinanceCompany</code>.</li>
                    <li>Set each provider's code, contact details, portal URL, provider key, and integration level.</li>
                    <li>Enable only supported capabilities: quotes, applications, agreements, schedules, account status, and payoff.</li>
                    <li>For manual providers, configure agency-specific portal access and operating procedures outside stored public directory defaults.</li>
                    <li>Confirm users have premium-finance view or manage authorization for the tenant.</li>
                </ul>
            </div>
            <div>
                <h3>Source readiness</h3>
                <ul class="fg-check-list">
                    <li>Choose an existing quote, policy, or renewal that belongs to the current tenant and account. For a submission, use its selected or accepted quote.</li>
                    <li>Confirm insured, policy or quote number, line of business, effective date, and premium are complete.</li>
                    <li>Verify premium plus taxes and fees is greater than zero and appropriate for financing.</li>
                    <li>Confirm customer email or phone, requested down payment, installment preference, assignee, and preferred provider when known.</li>
                    <li>Do not create a disconnected finance request when a supported source already exists.</li>
                </ul>
            </div>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="End-to-end workflow" Title="Step-by-step agency operating procedure" Description="Each step explains what to do, what the system controls, and what should happen next." />
        <ol class="fg-timeline">
            @foreach (var step in _premiumFinanceWorkflow)
            {
                <li>
                    <span class="fg-step-number">@step.Number</span>
                    <div><h3>@step.Title</h3><p>@step.Description</p><small>@step.Control</small></div>
                </li>
            }
        </ol>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="What to do next" Title="Action guide by current state" Description="Use the current queue and status to identify the next responsible agency action." />
        <div class="fg-route-grid">
            <article><span><i class="bi bi-pencil-square"></i> Draft</span><strong>Click “Update Status” or “Record Option”</strong><p>Use Update Status to move to Options Requested. After terms arrive, use Record Option to capture the provider response.</p></article>
            <article><span><i class="bi bi-hourglass-split"></i> Options Requested</span><strong>Click “Record Option”</strong><p>Complete the provider portal or external request, then record every returned option with its provider reference, amounts, APR, payments, dates, and terms.</p></article>
            <article><span><i class="bi bi-ui-radios-grid"></i> Options Received</span><strong>Click the request row, then “Select option”</strong><p>Compare all recorded choices, confirm customer authorization, and select the chosen received option. Alternatives remain in history.</p></article>
            <article><span><i class="bi bi-check2-circle"></i> Option Selected</span><strong>Click “Submit Application”</strong><p>Capture the agreement number, provider application reference, expected funding date, and cancellation-protection date, then record submission.</p></article>
            <article><span><i class="bi bi-pen"></i> Pending Signature</span><strong>Click “Update Agreement” and “Link Document”</strong><p>Move signature status through Sent, Delivered, and Signed. Link the agreement or signed agreement from DMS as supporting evidence.</p></article>
            <article><span><i class="bi bi-patch-check"></i> Pending Approval</span><strong>Click “Update Agreement”</strong><p>Record the provider's Approved or Declined application status. A decline automatically synchronizes the parent request to Declined.</p></article>
            <article><span><i class="bi bi-cash-coin"></i> Approved</span><strong>Click “Update Agreement,” then “Sync Schedule”</strong><p>Record Funded status and date before setting the agreement Active. Then enter the provider installment schedule using database-backed payment statuses.</p></article>
            <article><span><i class="bi bi-exclamation-triangle"></i> Account Attention</span><strong>Click “Add Activity,” “Link Document,” or “Update Agreement”</strong><p>Record customer/provider contact, attach notices, and update Past Due, Cancellation Pending, payoff, or account status without deleting history.</p></article>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Workbench buttons" Title="What each Premium Finance action does" Description="Open a request by clicking its row, then use the action that matches the next business event." />
        <div class="fg-card-grid">
            <article class="fg-card"><i class="bi bi-pencil"></i><strong>Edit Request</strong><span>Change the quote-capable preferred provider, requested down payment, payment count, customer email or phone, and notes.</span></article>
            <article class="fg-card"><i class="bi bi-arrow-repeat"></i><strong>Update Status</strong><span>Shows only valid next request statuses. Choose the next state and add notes explaining the transition.</span></article>
            <article class="fg-card"><i class="bi bi-plus-circle"></i><strong>Record Option</strong><span>Record financing terms returned by an active provider that supports quotes. The request moves to Options Received.</span></article>
            <article class="fg-card"><i class="bi bi-send"></i><strong>Submit Application</strong><span>Available after one option is selected. The provider adapter must succeed before the agreement and provider transaction are recorded.</span></article>
            <article class="fg-card"><i class="bi bi-file-earmark-check"></i><strong>Update Agreement</strong><span>Record application, signature, funding, account, agreement, next-payment, and payoff changes. Declines synchronize the request automatically.</span></article>
            <article class="fg-card"><i class="bi bi-calendar3"></i><strong>Sync Schedule</strong><span>Enter included installment number, due date, amount, and a database-backed payment status. The schedule count must match the agreement.</span></article>
            <article class="fg-card"><i class="bi bi-journal-plus"></i><strong>Add Activity</strong><span>Choose a database-backed activity type and record subject, notes, and provider reference for the audit timeline.</span></article>
            <article class="fg-card"><i class="bi bi-paperclip"></i><strong>Link Document</strong><span>Enter an existing tenant DMS document ID and select its configured role. The newest link becomes the current document for that role.</span></article>
            <article class="fg-card"><i class="bi bi-x-circle"></i><strong>Cancel Request</strong><span>Enter a reason and confirm. If a provider is connected, provider cancellation must succeed before local records are cancelled and logged.</span></article>
            <article class="fg-card"><i class="bi bi-buildings"></i><strong>Providers → Add Provider</strong><span>Configure provider identity, adapter key, integration level, URLs, contacts, and only the capabilities that provider supports.</span></article>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Lifecycle" Title="Status models and completion criteria" Description="Request, agreement, application, signature, funding, account, and installment states remain separate so the agency can see exactly what is complete or blocked." />
        <div class="fg-status-grid">
            <div><h3>Request lifecycle</h3><div class="fg-pill-list">@foreach (var status in _premiumFinanceRequestStatuses){<span>@status</span>}</div><p><strong>Complete:</strong> Active means an agreement exists and financing is active. Declined and Cancelled are terminal outcomes.</p></div>
            <div><h3>Agreement and provider lifecycle</h3><div class="fg-pill-list">@foreach (var status in _premiumFinanceAgreementStatuses){<span>@status</span>}</div><p>Track application, signature, funding, agreement, and provider-account state independently; never infer funding from application submission.</p></div>
            <div><h3>Payment servicing</h3><div class="fg-pill-list"><span>Scheduled</span><span>Due</span><span>Paid</span><span>Past Due</span></div><p>A schedule is complete when every expected installment is recorded and paid, or the provider reports an authoritative payoff.</p></div>
            <div><h3>Exception outcomes</h3><div class="fg-pill-list"><span>Declined</span><span>Cancelled</span><span>Funding Failed</span><span>Past Due</span><span>Cancellation Pending</span><span>Manual Action Required</span></div><p>Retain failed and terminal records, reasons, notices, activities, and provider references for operational history and audit.</p></div>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Features" Title="Agency-facing capabilities" Description="The workbench combines intake, provider management, transaction processing, servicing, reporting, and evidence." />
        <div class="fg-card-grid">
            <article class="fg-card"><i class="bi bi-inboxes"></i><strong>Unified work queues</strong><span>Filter all requests, options pending, signatures, approvals, active financing, and attention-required accounts.</span></article>
            <article class="fg-card"><i class="bi bi-search"></i><strong>Cross-field search</strong><span>Find records by request, insured, policy or quote, carrier, line of business, or provider.</span></article>
            <article class="fg-card"><i class="bi bi-buildings"></i><strong>Provider directory</strong><span>Maintain tenant providers, contacts, integration level, URLs, external IDs, and supported operations.</span></article>
            <article class="fg-card"><i class="bi bi-calculator"></i><strong>Term comparison</strong><span>Compare down payment, financed amount, APR, finance charge, installments, payment amount, first due date, and expiration.</span></article>
            <article class="fg-card"><i class="bi bi-file-earmark-signature"></i><strong>Application and agreement</strong><span>Record submission, provider references, agreement number, application decision, signature state, funding, payoff, and account status.</span></article>
            <article class="fg-card"><i class="bi bi-calendar3"></i><strong>Payment schedules</strong><span>The workbench records included installment number, due date, amount, and configured status. The API contract also supports principal, finance charge, paid details, and provider references.</span></article>
            <article class="fg-card"><i class="bi bi-paperclip"></i><strong>Document evidence</strong><span>Link applications, quotes, agreements, signed agreements, payment schedules, and provider notices from DMS.</span></article>
            <article class="fg-card"><i class="bi bi-journal-text"></i><strong>Activity timeline</strong><span>Record quote requests, selections, submissions, signatures, funding confirmations, payment changes, notes, calls, and follow-ups.</span></article>
            <article class="fg-card"><i class="bi bi-exclamation-diamond"></i><strong>Account attention</strong><span>Surface past-due and cancellation-pending financing so agency staff can intervene before coverage is affected.</span></article>
            <article class="fg-card"><i class="bi bi-bar-chart"></i><strong>Management reporting</strong><span>Summarize total financed, outstanding scheduled balance, renewals due, active agreements, attention items, and conversion.</span></article>
            <article class="fg-card"><i class="bi bi-cash-stack"></i><strong>Payoff tracking</strong><span>Capture provider payoff amount and good-through date without treating the AMS as the payment ledger of record.</span></article>
            <article class="fg-card"><i class="bi bi-shield-check"></i><strong>Tenant and audit controls</strong><span>Enforce tenant scope, authenticated actors, database-backed options, validation, timestamps, soft deletion, and immutable operational history.</span></article>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Business controls" Title="Rules that protect financing accuracy" Description="Application services enforce workflow integrity in addition to UI guidance." />
        <div class="fg-two-column">
            <div><h3>Financial and workflow validation</h3><ul class="fg-check-list">
                <li>Requested down payment cannot exceed premium plus taxes and fees.</li>
                <li>Option down payment plus amount financed must equal total cost within the supported rounding tolerance.</li>
                <li>Payment amount must be positive; installment count must be between 1 and 120.</li>
                <li>Only a received, unselected option belonging to the request can be selected.</li>
                <li>An application requires a selected option and the same provider; only one agreement may be created per request.</li>
                <li>Completed, declined, or cancelled requests and paid-off or cancelled agreements cannot be edited.</li>
            </ul></div>
            <div><h3>Servicing and evidence validation</h3><ul class="fg-check-list">
                <li>Funded date requires <code>Funded</code> funding status.</li>
                <li>Payoff amount requires a payoff good-through date.</li>
                <li>Schedule installment numbers and due dates must be unique and count must match the selected terms.</li>
                <li>A paid installment requires paid amount and paid date; paid amount cannot exceed scheduled amount.</li>
                <li>Activity, document, request, and agreement parents must belong to the same tenant and relationship chain.</li>
                <li>Cancellation requires confirmation, records a reason, and preserves rather than deletes the request. A connected provider must report success before local cancellation completes.</li>
            </ul></div>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Data and integration" Title="Authoritative records and provider operations" Description="Database-backed reference data drives the UI and workflow; provider adapters isolate manual and future integrated processing." />
        <div class="fg-promotion">
            <div>
                <h3>Core Billing records</h3>
                <div class="fg-code-paths">
                    <span><strong>Configuration</strong><code>Billing.FinanceCompany</code></span>
                    <span><strong>Reference options</strong><code>Billing.PremiumFinanceReferenceOption</code></span>
                    <span><strong>Request</strong><code>Billing.PremiumFinanceRequest</code></span>
                    <span><strong>Provider terms</strong><code>Billing.PremiumFinanceQuoteOption</code></span>
                    <span><strong>Agreement</strong><code>Billing.FinanceAgreement</code></span>
                    <span><strong>Installments</strong><code>Billing.PremiumFinancePaymentSchedule</code></span>
                    <span><strong>Provider calls</strong><code>Billing.PremiumFinanceProviderTransaction</code></span>
                    <span><strong>Evidence</strong><code>Billing.PremiumFinanceDocument</code></span>
                    <span><strong>History</strong><code>Billing.PremiumFinanceActivity</code></span>
                </div>
            </div>
            <aside><h3>Provider adapter contract</h3><ul><li>Get quote</li><li>Submit application</li><li>Get application status</li><li>Get agreement</li><li>Get payment schedule</li><li>Get account status</li><li>Get payoff</li><li>Cancel request</li></ul><p>The current workbench records quote terms and servicing updates after the provider action. Application submission and cancellation call the configured adapter and persist its result; failures do not advance local workflow.</p></aside>
        </div>
    </section>

    <section class="knowledge-panel">
        <KnowledgeSectionHeader Eyebrow="Operational and implementation map" Title="Routes, API, and important code areas" Description="Use these entry points to operate, support, test, or extend Agency-Facing Premium Finance Management." />
        <div class="fg-route-grid">
            <article><span><i class="bi bi-window"></i> User</span><strong>Premium Finance Workbench</strong><code>/premium-finance</code><p>Manage queues, providers, options, applications, agreements, schedules, documents, activities, exceptions, and reports.</p></article>
            <article><span><i class="bi bi-braces"></i> API</span><strong>Premium Finance API</strong><code>api/premium-finance</code><p>Provides workbench, detail, source resolution, request, option, application, agreement, schedule, document, activity, provider, and cancellation endpoints.</p></article>
            <article><span><i class="bi bi-link-45deg"></i> Scoped launch</span><strong>Account context</strong><code>/premium-finance?accountId={id}</code><p>Opens the same workbench filtered to the related account when launched from an account workflow.</p></article>
            <article><span><i class="bi bi-search"></i> Source launch</span><strong>Quote, policy, or renewal context</strong><code>/premium-finance?sourceType={type}&amp;sourceId={id}</code><p>Opens the Finance Premium dialog and immediately performs the tenant-scoped source lookup.</p></article>
        </div>
        <div class="fg-file-list fg-file-list--spaced">
            @foreach (var file in _premiumFinanceFiles)
            {
                <div><strong>@file.Name</strong><code>@file.Path</code><span>@file.Description</span></div>
            }
        </div>
    </section>
    }
</div>

@code {
    [Parameter]
    public string? Feature { get; set; }

    private bool IsLanding => Feature is null;
    private bool ShowDocumentIntake => Feature == "DocumentIntake";
    private bool ShowPremiumFinance => Feature == "PremiumFinance";
    private string PageTitleText => ShowDocumentIntake ? "AI Document Intake Feature Guide" : ShowPremiumFinance ? "Premium Finance Module Feature Guide" : "Knowledge Center Features Guide";
    private string HeaderTitle => ShowDocumentIntake ? "AI Document Intake" : ShowPremiumFinance ? "Premium Finance Module" : "Features Guide";
    private string HeaderSubtitle => ShowDocumentIntake
        ? "Governed document capture, OCR, AI interpretation, review, validation, and promotion"
