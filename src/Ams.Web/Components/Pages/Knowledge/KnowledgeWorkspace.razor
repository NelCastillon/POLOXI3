<div class="knowledge-workspace">
    <nav class="knowledge-nav" aria-label="Insurance Knowledge Center sections">
        <div class="knowledge-nav-brand">
            <span><i class="bi bi-shield-check"></i></span>
            <div><strong>Knowledge Center</strong><small>Insurance semantic governance</small></div>
        </div>
        <NavLink href="/knowledge/features-guide"><i class="bi bi-stars"></i> Features Guide</NavLink>
        <NavLink href="/admin/knowledge" Match="NavLinkMatch.All"><i class="bi bi-speedometer2"></i> Overview</NavLink>
        <NavLink href="/admin/knowledge/schemes"><i class="bi bi-collection"></i> Schemes</NavLink>
        <NavLink href="/admin/knowledge/concepts"><i class="bi bi-journal-text"></i> Concepts</NavLink>
        <NavLink href="/admin/knowledge/hierarchies"><i class="bi bi-diagram-3"></i> Hierarchies</NavLink>
        <NavLink href="/admin/knowledge/mappings"><i class="bi bi-arrow-left-right"></i> Mappings</NavLink>
        <NavLink href="/admin/knowledge/review"><i class="bi bi-check2-square"></i> Review</NavLink>
        <NavLink href="/admin/knowledge/rules"><i class="bi bi-ui-checks-grid"></i> Validation Rules</NavLink>
        <NavLink href="/admin/knowledge/imports"><i class="bi bi-cloud-arrow-up"></i> Imports</NavLink>
        <NavLink href="/admin/knowledge/publications"><i class="bi bi-box-arrow-up-right"></i> Publications</NavLink>
        <NavLink href="/admin/knowledge/audit"><i class="bi bi-clock-history"></i> Audit</NavLink>
    </nav>
    <main class="knowledge-content">
        @ChildContent
    </main>
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
}
