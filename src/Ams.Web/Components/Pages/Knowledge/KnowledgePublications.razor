@page "/admin/knowledge/publications"
@attribute [Authorize(Policy = Ams.Web.Security.KnowledgePolicies.ConceptsRead)]
@using System.ComponentModel.DataAnnotations
@using Ams.Knowledge.Application.Features.Knowledge
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NotificationService Notifications
@inject CurrentUserContext CurrentUser
@inject ConfirmationDialogService Confirmations

<PageTitle>Knowledge Publications</PageTitle><KnowledgeWorkspace><AppPageHeader Title="Knowledge Publications" Subtitle="Create, govern, and release versioned semantic catalog packages" Icon="bi-box-arrow-up-right"><Actions><AuthorizeView Policy="@Ams.Web.Security.KnowledgePolicies.Publish"><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New publication</button></AuthorizeView></Actions></AppPageHeader><section class="knowledge-panel"><KnowledgeSectionHeader Eyebrow="Release governance" Title="Publication registry" Description="Draft releases can be maintained by their owning tenant. Published releases remain immutable audit evidence."/><div class="knowledge-toolbar"><input class="knowledge-input knowledge-input-grow" placeholder="Search publication code or name" @bind="_search"/><select class="knowledge-input" @bind="_status"><option value="">All statuses</option>@foreach(var x in _statuses){<option value="@x.ValueCode">@x.DisplayName</option>}</select><button class="um-btn um-btn-ghost" @onclick="LoadAsync">Apply filters</button></div>@if(_error is not null){<KnowledgeStatePanel Tone="error" Title="Publications unavailable" Message="@_error"/>}else if(_loading){<KnowledgeStatePanel Title="Loading publications"/>}else if(_items.Count==0){<KnowledgeStatePanel Title="No publications found" Message="Create a governed release or adjust the filters."/>}else{<AppGrid TValue="KnowledgePublicationDto" DataSource="_items" AllowPaging="true"><GridColumns><GridColumn Field="@nameof(KnowledgePublicationDto.PublicationCode)" HeaderText="Code"/><GridColumn Field="@nameof(KnowledgePublicationDto.Name)" HeaderText="Name"/><GridColumn Field="@nameof(KnowledgePublicationDto.VersionLabel)" HeaderText="Version"/><GridColumn HeaderText="Status"><Template>@{var r=(KnowledgePublicationDto)context;}<AppStatusBadge Status="@r.StatusCode"/></Template></GridColumn><GridColumn Field="@nameof(KnowledgePublicationDto.ItemCount)" HeaderText="Items"/><GridColumn HeaderText="Ownership"><Template>@{var r=(KnowledgePublicationDto)context;}<KnowledgeOwnershipBadge TenantId="@r.TenantId" IsSystemDefined="@r.IsSystemDefined"/></Template></GridColumn><GridColumn HeaderText="Actions" Width="210"><Template>@{var r=(KnowledgePublicationDto)context;}@if(r.PublishedDateUtc is null&&r.TenantId.HasValue&&!r.IsSystemDefined){<AuthorizeView Policy="@Ams.Web.Security.KnowledgePolicies.Publish" Context="authorizationState"><div class="knowledge-actions"><button class="knowledge-icon-btn" title="Edit" @onclick="()=>OpenEdit(r)"><i class="bi bi-pencil"></i></button><button class="knowledge-icon-btn knowledge-icon-btn--danger" title="Delete" @onclick="()=>DeleteAsync(r)"><i class="bi bi-trash"></i></button><button class="um-btn um-btn-primary um-btn-xs" @onclick="()=>OpenPublish(r)">Publish</button></div></AuthorizeView>}</Template></GridColumn></GridColumns></AppGrid>}</section></KnowledgeWorkspace>
<AppCrudDrawer @bind-Visible="_drawer" Title="@(_editing is null?"Create publication":"Edit publication")" Icon="bi-box-arrow-up-right" IsBusy="_saving"><Content><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator/><KnowledgeValidationSummary/><div class="knowledge-form-grid"><div class="knowledge-field"><label>Publication code</label><InputText class="knowledge-input" @bind-Value="_form.Code" disabled="@(_editing is not null)"/><ValidationMessage For="()=>_form.Code"/></div><div class="knowledge-field"><label>Version label</label><InputText class="knowledge-input" @bind-Value="_form.Version"/><ValidationMessage For="()=>_form.Version"/></div><div class="knowledge-field knowledge-field-wide"><label>Name</label><InputText class="knowledge-input" @bind-Value="_form.Name"/><ValidationMessage For="()=>_form.Name"/></div><div class="knowledge-field"><label>Status</label><InputSelect class="knowledge-input" @bind-Value="_form.Status">@foreach(var x in _statuses){<option value="@x.ValueCode">@x.DisplayName</option>}</InputSelect></div><div class="knowledge-field knowledge-field-wide"><label>Change reason</label><InputTextArea class="knowledge-input" @bind-Value="_form.Reason"/><ValidationMessage For="()=>_form.Reason"/></div></div></EditForm></Content></AppCrudDrawer>
@if(_publishing is not null){<div class="knowledge-modal-backdrop" @onclick="CancelPublish"><div class="knowledge-modal" role="alertdialog" aria-modal="true" @onclick:stopPropagation="true"><header><h2 class="h5 mb-0">Publish @_publishing.Name?</h2></header><div class="body"><p>This releases @_publishing.ItemCount versioned item(s) as @_publishing.VersionLabel. The release becomes immutable.</p><div class="knowledge-field"><label>Publication reason</label><textarea class="knowledge-input" rows="4" @bind="_publishReason"></textarea></div></div><footer><button class="um-btn um-btn-ghost" @onclick="CancelPublish">Cancel</button><button class="um-btn um-btn-primary" disabled="@(string.IsNullOrWhiteSpace(_publishReason))" @onclick="PublishAsync">Publish release</button></footer></div></div>}
@code{private List<KnowledgePublicationDto>_items=[];private List<KnowledgeLookupDto>_statuses=[];private string _search="",_status="";private bool _loading,_saving,_drawer;private string?_error;private KnowledgePublicationDto?_editing,_publishing;private PublicationForm _form=new();private string _publishReason="";protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Knowledge","/admin/knowledge"),new("Publications","/admin/knowledge/publications"));await LoadAsync();}private async Task LoadAsync(){_loading=true;try{var r=Api.SearchKnowledgePublicationsAsync(_search,_status,pageSize:500);var s=Api.GetKnowledgeLookupsAsync("PUBLICATION_STATUS");await Task.WhenAll(r,s);_items=(r.Result?.Items??[]).ToList();_statuses=s.Result.ToList();}catch(Exception ex){_error=ex.Message;Fail("Publication load failed",ex);}finally{_loading=false;}}private void OpenCreate(){_editing=null;_form=new(){Status="DRAFT"};_drawer=true;}private void OpenEdit(KnowledgePublicationDto r){_editing=r;_form=new(){Code=r.PublicationCode,Name=r.Name,Version=r.VersionLabel,Status=r.StatusCode,Reason="Updated publication metadata"};_drawer=true;}private async Task SaveAsync(){_saving=true;try{var u=await CurrentUser.RequireAsync();var c=Guid.NewGuid().ToString("N");if(_editing is null)await Api.CreateKnowledgePublicationAsync(new(u.TenantId,_form.Code,_form.Name,_form.Version,_form.Status,_form.Reason,c,u.UserId));else await Api.UpdateKnowledgePublicationAsync(_editing.PublicationId,new(u.TenantId,_editing.PublicationId,_form.Name,_form.Version,_form.Status,_form.Reason,c,u.UserId,_editing.RowVersion));_drawer=false;await LoadAsync();}catch(Exception ex){Fail("Publication save failed",ex);}finally{_saving=false;}}private async Task DeleteAsync(KnowledgePublicationDto r){if(!await Confirmations.ConfirmAsync("Delete draft publication",$"Delete publication '{r.Name}'?"))return;var u=await CurrentUser.RequireAsync();try{await Api.DeleteKnowledgePublicationAsync(r.PublicationId,new(u.TenantId,r.PublicationId,"Deleted draft publication",Guid.NewGuid().ToString("N"),u.UserId,r.RowVersion));await LoadAsync();}catch(Exception ex){Fail("Publication deletion failed",ex);}}private void OpenPublish(KnowledgePublicationDto r){_publishing=r;_publishReason="";}private void CancelPublish(){_publishing=null;_publishReason="";}private async Task PublishAsync(){if(_publishing is null)return;try{var u=await CurrentUser.RequireAsync();await Api.PublishKnowledgeAsync(_publishing.PublicationId,new(u.TenantId,_publishing.PublicationId,"PUBLISHED",_publishReason,Guid.NewGuid().ToString("N"),u.UserId,_publishing.RowVersion));CancelPublish();await LoadAsync();}catch(Exception ex){Fail("Publication operation failed",ex);}}private void Fail(string t,Exception e)=>Notifications.Add(new(Guid.NewGuid(),t,e.Message,"bi-exclamation-triangle","danger"));private sealed class PublicationForm{[Required,StringLength(100)]public string Code{get;set;}="";[Required,StringLength(200)]public string Name{get;set;}="";[Required,StringLength(50)]public string Version{get;set;}="";[Required]public string Status{get;set;}="";[Required]public string Reason{get;set;}="";}}
