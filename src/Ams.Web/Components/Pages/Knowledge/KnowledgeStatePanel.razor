<div class="knowledge-state knowledge-state--@Tone" role="@(Tone == "error" ? "alert" : "status")">
    <span class="knowledge-state__icon"><i class="bi @Icon"></i></span>
    <div>
        <strong>@Title</strong>
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <p>@Message</p>
        }
        @if (Actions is not null)
        {
            <div class="knowledge-state__actions">@Actions</div>
        }
    </div>
</div>

@code {
    [Parameter] public string Tone { get; set; } = "empty";
    [Parameter] public string Icon { get; set; } = "bi-inbox";
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Message { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
