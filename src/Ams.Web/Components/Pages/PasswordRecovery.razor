@page "/password-recovery"
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav

<PageTitle>Password Recovery</PageTitle>

<div class="prc-page">
    <section class="prc-card">
        <div class="prc-header">
            <span class="prc-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
            <div>
                <span class="prc-eyebrow">Secure account access</span>
                <h1>Reset your password</h1>
                <p>Enter your email address and the system will send a secure reset link if the account exists.</p>
            </div>
        </div>

        @if (_submitted)
        {
            <div class="prc-alert prc-alert-success" role="status">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                <span>If an account matches <strong>@_form.Email</strong>, a password reset link has been sent.</span>
            </div>
        }

        <EditForm Model="_form" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <div class="prc-form">
                <div class="um-field">
                    <label>Email address <span class="text-danger">*</span></label>
                    <InputText class="um-input" @bind-Value="_form.Email" autocomplete="email" placeholder="name@agency.com" />
                    <ValidationMessage For="() => _form.Email" class="text-danger" />
                </div>
                <button type="submit" class="um-btn um-btn-primary">
                    <i class="bi bi-send" aria-hidden="true"></i> Send reset link
                </button>
                <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/login")'>
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to login
                </button>
            </div>
        </EditForm>
    </section>
</div>

@code {
    private readonly RecoveryForm _form = new();
    private bool _submitted;

    private async Task SubmitAsync()
    {
        await Task.Delay(150);
        _submitted = true;
    }

    private sealed class RecoveryForm
    {
        [Required]
        [EmailAddress]
        [StringLength(256)]
        public string Email { get; set; } = string.Empty;
    }
}
