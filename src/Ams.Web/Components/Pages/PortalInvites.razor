@page "/client/portal-invites"
@inject ApiClient Api

<PageTitle>Portal Invites</PageTitle>
<h1>Portal Invites</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(PortalInviteDto.AccountName)"    HeaderText="Account"     Width="200"></GridColumn>
        <GridColumn Field="@nameof(PortalInviteDto.ContactName)"    HeaderText="Contact"     Width="180"></GridColumn>
        <GridColumn Field="@nameof(PortalInviteDto.InviteEmail)"    HeaderText="Email"       Width="220"></GridColumn>
        <GridColumn Field="@nameof(PortalInviteDto.StatusCode)"     HeaderText="Status"      Width="110"></GridColumn>
        <GridColumn Field="@nameof(PortalInviteDto.SentDateUtc)"    HeaderText="Sent"        Width="140" Format="d"></GridColumn>
        <GridColumn Field="@nameof(PortalInviteDto.ExpiresDateUtc)" HeaderText="Expires"     Width="140" Format="d"></GridColumn>
        <GridColumn Field="@nameof(PortalInviteDto.AcceptedDateUtc)" HeaderText="Accepted"   Width="140" Format="d"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<PortalInviteDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchPortalInvitesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
