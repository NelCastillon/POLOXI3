@page "/client/portal-invites"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.PortalInvites
@using Ams.Web.Components.Pages.Accounts
@using System.ComponentModel.DataAnnotations

<PageTitle>Portal Invites — Tenant Admin</PageTitle>

<AppPageHeader Title="Portal Invites" Subtitle="Tenant Admin portal access invitation center" Icon="bi-envelope"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-send"></i> Send Invite</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<section class="ma-hero acct-hero"><div><span class="ma-eyebrow">Tenant Admin · Account Intelligence</span><h2>Portal Invitation Desk</h2><p>Issue, monitor, and resend client portal access invitations by account and contact.</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-envelope-plus"></i> Send Invite</button></div></section>
<div class="pc-kpi-strip acct-kpi-strip"><div class="pc-kpi-card @(_activeFilter is null ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter(null)'><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-envelope"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Invites</div></div></div><div class="pc-kpi-card @(_activeFilter == "Accepted" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Accepted")'><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Accepted")</div><div class="pc-kpi-label">Accepted</div></div></div><div class="pc-kpi-card @(_activeFilter == "Pending" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Pending")'><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-clock"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Pending")</div><div class="pc-kpi-label">Pending</div></div></div><div class="pc-kpi-card @(_activeFilter == "Expired" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Expired")'><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-exclamation-circle"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Expired")</div><div class="pc-kpi-label">Expired</div></div></div></div>
<div class="ma-filter-bar acct-filter-bar"><div class="ma-search-wrap"><i class="bi bi-search"></i><input class="ma-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search account, contact, email…" /></div><button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button><span class="ma-filter-count">@Filtered.Count() invites</span></div>
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading portal invites…</span></div> }<SfGrid TValue="PortalInviteDto" DataSource="@Filtered.ToList()" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="56"><GridPageSettings PageSize="25" /><GridColumns><GridColumn Field="AccountName" HeaderText="Account" MinWidth="200" /><GridColumn Field="ContactName" HeaderText="Contact" Width="190" /><GridColumn Field="InviteEmail" HeaderText="Email" Width="230" /><GridColumn Field="StatusCode" HeaderText="Status" Width="115"><Template>@{ var i=(PortalInviteDto)context; }<span class="um-badge @InviteBadge(i.StatusCode)">@i.StatusCode</span></Template></GridColumn><GridColumn Field="SentDateUtc" HeaderText="Sent" Width="130" Format="d" /><GridColumn Field="ExpiresDateUtc" HeaderText="Expires" Width="130" Format="d" /><GridColumn HeaderText="Actions" Width="90" TextAlign="TextAlign.Center"><Template>@{ var i=(PortalInviteDto)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ResendAsync(i)" title="Resend"><i class="bi bi-arrow-repeat"></i></button></Template></GridColumn></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="640px" IsModal="true" ShowCloseIcon="false"><DialogContent><div class="um-modal-header"><i class="bi bi-envelope"></i><span>Send Portal Invite</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_inviteForm" OnValidSubmit="SendAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Account <span class="text-danger">*</span></label><InputSelect @bind-Value="_inviteForm.AccountId" class="um-input"><option value="">Select account</option>@foreach (var a in _accounts) { <option value="@a.AccountId">@a.AccountName</option> }</InputSelect><ValidationMessage For="() => _inviteForm.AccountId" class="text-danger" /></div><div class="um-field"><label>Contact <span class="text-danger">*</span></label><InputSelect @bind-Value="_inviteForm.ContactId" class="um-input"><option value="">Select contact</option>@foreach (var c in _contacts) { <option value="@c.ContactId">@ContactName(c)</option> }</InputSelect><ValidationMessage For="() => _inviteForm.ContactId" class="text-danger" /></div><div class="um-field"><label>Email <span class="text-danger">*</span></label><InputText @bind-Value="_inviteForm.Email" class="um-input" /><ValidationMessage For="() => _inviteForm.Email" class="text-danger" /></div><div class="um-field"><label>Expires Days</label><InputNumber @bind-Value="_inviteForm.ExpiresDays" class="um-input" /><ValidationMessage For="() => _inviteForm.ExpiresDays" class="text-danger" /></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Send</button></div></EditForm></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />
@code { List<PortalInviteDto> _items = []; List<AccountDto> _accounts = []; List<ContactDto> _contacts = []; string _search = string.Empty; InviteForm _inviteForm = new(); string? _activeFilter, _loadError; bool _loading, _saving, _showForm; SfToast _toast = default!; IEnumerable<PortalInviteDto> Filtered => _items.Where(x => (_activeFilter is null || x.StatusCode == _activeFilter) && (string.IsNullOrWhiteSpace(_search) || x.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.ContactName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.InviteEmail.Contains(_search, StringComparison.OrdinalIgnoreCase))); protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Accounts", "/accounts"), new("Portal Invites")); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { _items = (await Api.SearchPortalInvitesAsync(AccountPageConstants.TenantId))?.Items.ToList() ?? []; _accounts = (await Api.SearchAccountsAsync(AccountPageConstants.TenantId))?.Items.ToList() ?? []; _contacts = (await Api.SearchContactsAsync(AccountPageConstants.TenantId))?.Items.ToList() ?? []; } catch (Exception ex) { _loadError = $"Failed to load portal invites: {ex.Message}"; } finally { _loading = false; } } void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; } void SetFilter(string? key) { _activeFilter = key; } void ResetFilters() { _activeFilter = null; _search = string.Empty; } void OpenCreate() { _inviteForm = new(); _showForm = true; } async Task SendAsync() { _saving = true; try { await Api.CreatePortalInviteAsync(new CreatePortalInviteRequest { TenantId = AccountPageConstants.TenantId, AccountId = _inviteForm.AccountId!.Value, ContactId = _inviteForm.ContactId!.Value, InviteEmail = _inviteForm.Email, ExpiresDateUtc = DateTime.UtcNow.AddDays(_inviteForm.ExpiresDays) }); _showForm = false; await _toast.ShowAsync(new() { Content = "Portal invite sent", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Send failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } async Task ResendAsync(PortalInviteDto invite) { _saving = true; try { await Api.CreatePortalInviteAsync(new CreatePortalInviteRequest { TenantId = AccountPageConstants.TenantId, AccountId = invite.AccountId, ContactId = invite.ContactId, InviteEmail = invite.InviteEmail, ExpiresDateUtc = DateTime.UtcNow.AddDays(30) }); await _toast.ShowAsync(new() { Content = "Invite resent", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Resend failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } static string InviteBadge(string status) => status switch { "Accepted" => "um-badge-success", "Pending" => "um-badge-info", "Expired" => "um-badge-warning", "Revoked" => "um-badge-danger", _ => "um-badge-neutral" }; static string ContactName(ContactDto c) => $"{c.FirstName} {c.LastName}".Trim(); sealed class InviteForm { [Required(ErrorMessage = "Account is required.")] public Guid? AccountId { get; set; } [Required(ErrorMessage = "Contact is required.")] public Guid? ContactId { get; set; } [Required(ErrorMessage = "Email is required."), EmailAddress(ErrorMessage = "Enter a valid email address."), StringLength(200)] public string Email { get; set; } = string.Empty; [Range(1, 365, ErrorMessage = "Expires Days must be between 1 and 365.")] public int ExpiresDays { get; set; } = 30; } }
