    {
        "at-risk" => item.Category == "At Risk" || item.Status is "At Risk" or "Escalate",
        "save-play" => item.Category == "Save Play",
        "churn-driver" => item.Category == "Churn Driver",
        "producer" => item.Category == "Producer",
        "client-health" => item.Category == "Client Health",
