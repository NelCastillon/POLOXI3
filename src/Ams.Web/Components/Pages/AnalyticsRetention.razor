@page "/analytics/retention"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>Retention Analytics — AMS</PageTitle>

<AppPageHeader Title="Retention Analytics"
               Subtitle="Policy renewal rates, lapse trends, non-renewal reasons, and at-risk accounts"
               Icon="bi-arrow-clockwise">
    <Actions>
        <button class="um-btn um-btn-ghost"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="ret-kpi-strip">
    <div class="ret-kpi-card ret-kpi-card--main">
        <div class="ret-kpi-big">88.4%</div>
        <div class="ret-kpi-lbl">Overall Retention Rate</div>
        <div class="ret-kpi-delta ret-delta--up"><i class="bi bi-arrow-up-short" aria-hidden="true"></i> +1.2% vs prior year</div>
    </div>
    <div class="ret-kpi-card">
        <div class="ret-kpi-icon ret-ki-green"><i class="bi bi-check-circle" aria-hidden="true"></i></div>
        <div><div class="ret-kv">1,842</div><div class="ret-kl">Renewed (MTD)</div></div>
    </div>
    <div class="ret-kpi-card">
        <div class="ret-kpi-icon ret-ki-red"><i class="bi bi-x-circle" aria-hidden="true"></i></div>
        <div><div class="ret-kv">241</div><div class="ret-kl">Non-Renewals</div></div>
    </div>
    <div class="ret-kpi-card">
        <div class="ret-kpi-icon ret-ki-amber"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div>
        <div><div class="ret-kv">187</div><div class="ret-kl">At-Risk Accounts</div></div>
    </div>
    <div class="ret-kpi-card">
        <div class="ret-kpi-icon ret-ki-blue"><i class="bi bi-currency-dollar" aria-hidden="true"></i></div>
        <div><div class="ret-kv">$4.2M</div><div class="ret-kl">Retained Premium</div></div>
    </div>
</div>

<div class="ret-two-col">

    <!-- Retention by LOB -->
    <div class="ret-panel">
        <div class="ret-panel-hdr">Retention Rate by Line of Business</div>
        <div class="ret-lob-chart">
            @foreach (var lob in _lobRetention)
            {
                <div class="ret-lob-row">
                    <div class="ret-lob-lbl">@lob.Lob</div>
                    <div class="ret-lob-track">
                        <div class="ret-lob-fill @(lob.Rate >= 88 ? "ret-fill--green" : lob.Rate >= 80 ? "ret-fill--amber" : "ret-fill--red")" style="width:@lob.Rate%"></div>
                    </div>
                    <div class="ret-lob-rate @(lob.Rate >= 88 ? "ret-rate--good" : lob.Rate >= 80 ? "ret-rate--warn" : "ret-rate--bad")">@lob.Rate%</div>
                </div>
            }
        </div>
    </div>

    <!-- Non-renewal reasons -->
    <div class="ret-panel">
        <div class="ret-panel-hdr">Non-Renewal Reasons</div>
        <div class="ret-reasons">
            @foreach (var r in _reasons)
            {
                <div class="ret-reason-row">
                    <div class="ret-reason-lbl">@r.Reason</div>
                    <div class="ret-reason-bar-wrap">
                        <div class="ret-reason-bar" style="width:@r.Pct%"></div>
                    </div>
                    <div class="ret-reason-pct">@r.Pct%</div>
                    <div class="ret-reason-count">@r.Count</div>
                </div>
            }
        </div>
    </div>

    <!-- At-risk table -->
    <div class="ret-panel ret-panel--wide">
        <div class="ret-panel-hdr">At-Risk Accounts — Renewal in 60 Days
            <span class="ret-ai-chip"><i class="bi bi-robot" aria-hidden="true"></i> AI Risk Scored</span>
        </div>
        <SfGrid TValue="AtRiskAccount" DataSource="_atRisk" AllowSorting="true" EnableHover="true" RowHeight="52">
            <GridColumns>
                <GridColumn Field="@nameof(AtRiskAccount.Account)"    HeaderText="Account" MinWidth="180" />
                <GridColumn Field="@nameof(AtRiskAccount.Producer)"   HeaderText="Producer" Width="140" />
                <GridColumn Field="@nameof(AtRiskAccount.Premium)"    HeaderText="Premium" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                    <Template>@{ var a = (AtRiskAccount)context; }<span class="ret-mono">@a.Premium</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(AtRiskAccount.RenewalDate)" HeaderText="Renewal Date" Width="130" Type="ColumnType.DateTime" Format="MMM d, yyyy" />
                <GridColumn Field="@nameof(AtRiskAccount.RiskScore)"   HeaderText="Risk Score" Width="110" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                    <Template>@{ var a = (AtRiskAccount)context; }
                        <span class="@RiskBadge(a.RiskScore)">@a.RiskScore</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(AtRiskAccount.RiskReason)"  HeaderText="Risk Signal" MinWidth="200" />
                <GridColumn HeaderText="" Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                    <Template>
                        <button class="um-btn um-btn-ghost um-btn-xs" title="Create task"><i class="bi bi-check2-square" aria-hidden="true"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" title="View account"><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
</div>

@code {
    private record LobRet(string Lob, int Rate);
    private record NonRenewReason(string Reason, int Count, int Pct);
    private sealed class AtRiskAccount { public string Account{get;set;}=string.Empty; public string Producer{get;set;}=string.Empty; public string Premium{get;set;}=string.Empty; public DateTime RenewalDate{get;set;} public string RiskScore{get;set;}=string.Empty; public string RiskReason{get;set;}=string.Empty; }

    private List<LobRet> _lobRetention = [];
    private List<NonRenewReason> _reasons = [];
    private List<AtRiskAccount> _atRisk = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Analytics","/analytics/reports"), new("Retention",""));
        _lobRetention = [new("Commercial GL",91), new("BOP",89), new("Workers Comp",88), new("Commercial Auto",85), new("Professional Liab",82), new("Personal Lines",78), new("Umbrella",76)];
        _reasons = [new("Price / Rate increase",88,37), new("Carrier non-renewal",54,22), new("Coverage no longer needed",42,17), new("Competitor price",31,13), new("Service dissatisfaction",14,6), new("Business closed",12,5)];
        _atRisk =
        [
            new AtRiskAccount { Account="Apex Logistics LLC",    Producer="Tom Reyes",    Premium="$18,400", RenewalDate=DateTime.Today.AddDays(14), RiskScore="High",   RiskReason="No engagement in 45d · Price increase 22%" },
            new AtRiskAccount { Account="Riverside Dental Group", Producer="Beth Nakamura",Premium="$12,100", RenewalDate=DateTime.Today.AddDays(21), RiskScore="High",   RiskReason="Service complaint open · Carrier non-renewal flag" },
            new AtRiskAccount { Account="Castillo Auto Group",    Producer="Lisa Park",    Premium="$31,200", RenewalDate=DateTime.Today.AddDays(28), RiskScore="Medium", RiskReason="Competitor quote obtained · Loss ratio 84%" },
            new AtRiskAccount { Account="Kim Realty LLC",         Producer="Tom Reyes",    Premium="$9,800",  RenewalDate=DateTime.Today.AddDays(32), RiskScore="Medium", RiskReason="No portal login in 60d · Invoice overdue" },
            new AtRiskAccount { Account="Sullivan Manufacturing",  Producer="Diana Ruiz",   Premium="$44,100", RenewalDate=DateTime.Today.AddDays(41), RiskScore="Low",    RiskReason="Slight premium increase · No prior churn signals" },
        ];
    }

    private static string RiskBadge(string r) => r switch { "High"=>"ret-risk ret-risk--high", "Medium"=>"ret-risk ret-risk--med", _=>"ret-risk ret-risk--low" };
}
