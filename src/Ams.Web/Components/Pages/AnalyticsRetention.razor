    private async Task CreateSaveCaseAsync()
    {
        if (_selectedItem is null) return;
        _saving = true;
        try
        {
            var id = await Api.CreateRenewalRetentionCaseAsync(new Ams.Application.Features.RenewalRetention.CreateRenewalRetentionCaseRequest
            {
                TenantId = _tenantId,
                AccountName = _selectedItem.Title,
                PolicyNumber = $"RET-{DateTime.UtcNow:yyyyMMddHHmm}",
                LineOfBusiness = _selectedItem.Segment,
                Carrier = "Retention Market Review",
                Producer = _selectedItem.Owner,
                Csr = "Retention Desk",
                ExpirationDate = _selectedItem.DueDateUtc,
                CurrentPremium = _selectedItem.Premium,
                ProposedPremium = _selectedItem.Premium,
                RetentionProbability = (int)Math.Clamp(_selectedItem.RetentionPct, 0, 100),
                RiskScore = _selectedItem.RiskScore,
                Stage = "Save Plan",
                Priority = _selectedItem.Priority,
                OutreachStatus = "Not Started",
                Sentiment = _selectedItem.RiskScore >= 75 ? "Concerned" : "Neutral",
                RiskDrivers = _selectedItem.Driver,
                NextBestAction = _selectedItem.NextAction,
                NextActionDueDate = _selectedItem.DueDateUtc,
                AssignedToName = _selectedItem.Owner,
                IsEscalated = _selectedItem.Priority == "Critical",
                IsAtRisk = _selectedItem.RiskScore >= 70,
                CreatedByUserId = _currentUserId
            });
            await Api.AddRenewalRetentionActivityAsync(new Ams.Application.Features.RenewalRetention.CreateRenewalRetentionActivityRequest
            {
                RetentionCaseId = id,
                ActivityType = "Plan",
                Subject = $"Created retention save plan for {_selectedItem.Title}",
                Outcome = "Created",
                Notes = _selectedItem.Insight,
                ActivityDateUtc = DateTime.UtcNow,
                CreatedByName = "Retention Analytics",
                CreatedByUserId = _currentUserId
            });
            ShowToast($"Save case created: {_selectedItem.Title}");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Create save case failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

