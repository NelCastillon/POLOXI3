@page "/billing/retainers"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>Retainer Accounts</PageTitle>
<AppPageHeader Title="Retainer Accounts" Icon="bi-buildings" />
<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(RetainerAccountDto.RetainerName)"    HeaderText="Retainer"    Width="220"></GridColumn>
        <GridColumn Field="@nameof(RetainerAccountDto.TotalAmount)"     HeaderText="Total"       Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(RetainerAccountDto.UsedAmount)"      HeaderText="Used"        Width="110" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(RetainerAccountDto.RemainingAmount)" HeaderText="Remaining"   Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(RetainerAccountDto.PeriodStart)"     HeaderText="Period Start" Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(RetainerAccountDto.StatusCode)"      HeaderText="Status"      Width="110"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private string? _loadError;
    private List<RetainerAccountDto>? _items;
    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            var result = await Api.SearchRetainerAccountsAsync(_tenantId, _searchTerm);
            _items = result?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = $"Retainer accounts failed to load: {ex.Message}";
            _items = [];
        }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
