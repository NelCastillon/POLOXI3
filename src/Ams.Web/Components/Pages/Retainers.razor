@page "/billing/retainers"
@inject ApiClient Api

<PageTitle>Retainer Accounts</PageTitle>
<h1>Retainer Accounts</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(RetainerAccountDto.RetainerName)"    HeaderText="Retainer"    Width="220"></GridColumn>
        <GridColumn Field="@nameof(RetainerAccountDto.TotalAmount)"     HeaderText="Total"       Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(RetainerAccountDto.UsedAmount)"      HeaderText="Used"        Width="110" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(RetainerAccountDto.RemainingAmount)" HeaderText="Remaining"   Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(RetainerAccountDto.PeriodStart)"     HeaderText="Period Start" Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(RetainerAccountDto.StatusCode)"      HeaderText="Status"      Width="110"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<RetainerAccountDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchRetainerAccountsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
