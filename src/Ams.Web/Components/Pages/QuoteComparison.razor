@page "/quotes/compare/{SubmissionId:guid}"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Submissions
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Quote Comparison ? AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

@if (_loading)
{
    <div class="qc-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading quotes?</span></div>
}
else if (_loadError is not null)
{
    <div class="qc-loading"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>@_loadError</span></div>
}
else if (!_quotes.Any())
{
    <div class="qc-loading"><i class="bi bi-file-earmark-text" aria-hidden="true"></i><span>No DB-backed quotes are available for this submission yet.</span><button class="um-btn um-btn-primary um-btn-sm" @onclick="GoBack">Back to Submission</button></div>
}
else
{
    <!-- -- HEADER --------------------------------------------------- -->
    <div class="qc-header">
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="GoBack">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back
        </button>
        <div class="qc-header-title">
            <i class="bi bi-layout-split qc-title-icon" aria-hidden="true"></i>
            <div>
                <h1 class="qc-h1">Quote Comparison</h1>
                <span class="qc-sub">@_submissionNo ? @_account ? @_lob</span>
            </div>
        </div>
        <div class="qc-header-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="ExportComparison">
                <i class="bi bi-download" aria-hidden="true"></i> Export
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm"
                    @onclick='() => Nav.NavigateTo($"/quotes/proposal/{SubmissionId}")'>
                <i class="bi bi-file-earmark-richtext" aria-hidden="true"></i> Build Proposal
            </button>
            <button class="um-btn um-btn-primary um-btn-sm"
                    @onclick="BindSelectedOrRecommended">
                <i class="bi bi-shield-check" aria-hidden="true"></i> Bind
            </button>
        </div>
    </div>

    <!-- -- RECOMMENDATION BANNER ----------------------------------- -->
    <div class="qc-rec-banner">
        <div class="qc-rec-icon"><i class="bi bi-stars" aria-hidden="true"></i></div>
        <div class="qc-rec-body">
            <div class="qc-rec-title">Recommended: <strong>@_recommended?.Carrier</strong></div>
            <div class="qc-rec-reason">@(_recommended?.RecommendationReason ?? "Premium, coverage breadth, carrier rating, appetite, subjectivity burden, commission, expiration risk, and producer preference are evaluated.")</div>
        </div>
        <button class="um-btn um-btn-success um-btn-sm" @onclick="() => BindRecommended()">
            <i class="bi bi-shield-check" aria-hidden="true"></i> Bind Recommended
        </button>
    </div>

    <!-- -- SUMMARY CARD ROW ----------------------------------------- -->
    <div class="qc-summary-row">
        @foreach (var q in _quotes)
        {
            <div class="qc-summary-card @(q.IsRecommended ? "qc-recommended" : "") @(q.IsSelected ? "qc-selected" : "")">
                @if (q.IsRecommended)
                {
                    <div class="qc-rec-badge"><i class="bi bi-trophy-fill" aria-hidden="true"></i> Recommended</div>
                }
                <div class="qc-sum-carrier">@q.Carrier</div>
                <div class="qc-sum-premium">@q.Premium.ToString("C0")</div>
                <div class="qc-sum-label">Annual Premium</div>
                <div class="qc-sum-chips">
                    @if (q.IsLowest) { <span class="qc-chip qc-chip-low"><i class="bi bi-arrow-down" aria-hidden="true"></i> Lowest</span> }
                    @if (q.BestSla)  { <span class="qc-chip qc-chip-sla"><i class="bi bi-clock" aria-hidden="true"></i> Best SLA</span> }
                    @if (q.FullLimits) { <span class="qc-chip qc-chip-lim"><i class="bi bi-shield" aria-hidden="true"></i> Full Limits</span> }
                </div>
                <div class="qc-sum-meta">Quote #@q.QuoteNo ? Exp @q.ExpDate.ToString("MM/dd/yy")</div>
                <div class="qc-sum-meta">Score @q.RecommendationScore ? Rating @Safe(q.CarrierRating, "-") ? Commission @PercentOrDash(q.CommissionPercent)</div>
                <div class="qc-sum-actions">
                    <button class="um-btn @(q.IsSelected ? "um-btn-success" : "um-btn-ghost") um-btn-sm"
                            @onclick="() => SelectQuoteAsync(q)">
                        <i class="bi @(q.IsSelected ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                        @(q.IsSelected ? "Selected" : "Select")
                    </button>
                    <button class="um-btn um-btn-primary um-btn-sm" @onclick="() => BindQuote(q)">
                        <i class="bi bi-shield-check" aria-hidden="true"></i> Bind
                    </button>
                </div>
            </div>
        }
    </div>

    <!-- -- TOGGLE VIEW TABS ----------------------------------------- -->
    <div class="qc-view-row">
        @foreach (var v in new[]{"Coverage","Premium Breakdown","Market Intelligence","Notes"})
        {
            <button class="qc-view-btn @(_viewTab == v ? "qc-view-active" : "")"
                    @onclick="() => _viewTab = v">@v</button>
        }
    </div>

    <!-- -- COMPARISON TABLE ----------------------------------------- -->
    @if (_viewTab == "Coverage")
    {
        <div class="qc-table-wrap">
            <table class="qc-table">
                <thead>
                    <tr>
                        <th class="qc-th-field">Coverage Feature</th>
                        @foreach (var q in _quotes)
                        {
                            <th class="qc-th-carrier @(q.IsRecommended ? "qc-th-rec" : "")">
                                @q.Carrier
                                @if (q.IsRecommended) { <span class="qc-th-rec-star">?</span> }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _coverageRows)
                    {
                        @if (row.IsSection)
                        {
                            <tr class="qc-section-row">
                                <td colspan="@(_quotes.Count+1)">@row.Field</td>
                            </tr>
                        }
                        else
                        {
                            <tr class="qc-data-row @(row.IsHighlighted ? "qc-row-hl" : "")">
                                <td class="qc-field-name">
                                    @row.Field
                                    @if (row.IsKey) { <span class="qc-key-dot" title="Key coverage field">?</span> }
                                </td>
                                @foreach (var q in _quotes)
                                {
                                    var val = q.CoverageValues.GetValueOrDefault(row.Field, "?");
                                    var best = row.BestValue == q.Carrier;
                                    <td class="qc-val-cell @(best ? "qc-best-val" : "") @(q.IsRecommended ? "qc-rec-col" : "")">
                                        @if (val == "Yes")   { <span class="qc-yes"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span> }
                                        else if (val == "No"){ <span class="qc-no"><i class="bi bi-x-circle" aria-hidden="true"></i></span> }
                                        else                 { <span>@val</span> }
                                        @if (best) { <i class="bi bi-star-fill qc-best-star" title="Best value" aria-hidden="true"></i> }
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_viewTab == "Premium Breakdown")
    {
        <div class="qc-breakdown-wrap">
            <table class="qc-table">
                <thead>
                    <tr>
                        <th class="qc-th-field">Coverage Element</th>
                        @foreach (var q in _quotes) { <th class="qc-th-carrier @(q.IsRecommended ? "qc-th-rec" : "")">@q.Carrier</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in _premiumLines)
                    {
                        <tr class="qc-data-row @(line.IsTotalRow ? "qc-total-row" : "")">
                            <td class="qc-field-name">@line.Label</td>
                            @foreach (var q in _quotes)
                            {
                                var val = q.PremiumLines.GetValueOrDefault(line.Label, 0);
                                var isLow = _quotes.Min(x => x.PremiumLines.GetValueOrDefault(line.Label, decimal.MaxValue)) == val && val > 0;
                                <td class="qc-val-cell @(isLow && !line.IsTotalRow ? "qc-best-val" : "") @(line.IsTotalRow ? "qc-total-val" : "") @(q.IsRecommended ? "qc-rec-col" : "")">
                                    @(val == 0 ? "?" : val.ToString("C0"))
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (_viewTab == "Market Intelligence")
    {
        <div class="qc-intel-wrap">
            <table class="qc-table">
                <thead>
                    <tr>
                        <th class="qc-th-field">Intelligence Metric</th>
                        @foreach (var q in _quotes) { <th class="qc-th-carrier @(q.IsRecommended ? "qc-th-rec" : "")">@q.Carrier</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _intelRows)
                    {
                        <tr class="qc-data-row">
                            <td class="qc-field-name">@row</td>
                            @foreach (var q in _quotes)
                            {
                                var val = q.IntelValues.GetValueOrDefault(row, "?");
                                <td class="qc-val-cell @(q.IsRecommended ? "qc-rec-col" : "")">@val</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="qc-notes-wrap">
            @foreach (var q in _quotes)
            {
                <div class="qc-note-card @(q.IsRecommended ? "qc-note-rec" : "")">
                    <div class="qc-note-carrier">@q.Carrier</div>
                    <div class="qc-note-text">@q.Notes</div>
                    @if (!string.IsNullOrEmpty(q.Exclusions))
                    {
                        <div class="qc-note-excl"><strong>Exclusions / Conditions:</strong> @q.Exclusions</div>
                    }
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public Guid SubmissionId { get; set; }

    EnterpriseToast _toast = default!;

    bool   _loading     = true;
    string? _loadError;
    string _viewTab     = "Coverage";
    string _submissionNo = "";
    string _account      = "";
    string _lob          = "";
    SubmissionDto? _submission;

    sealed class QuoteModel
    {
        public string   Carrier        { get; set; } = "";
        public string   QuoteNo        { get; set; } = "";
        public decimal  Premium        { get; set; }
        public DateTime ExpDate        { get; set; }
        public bool     IsRecommended  { get; set; }
        public bool     IsSelected     { get; set; }
        public bool     IsLowest       { get; set; }
        public bool     BestSla        { get; set; }
        public bool     FullLimits     { get; set; }
        public Guid     QuoteId        { get; set; }
        public Guid     CarrierId      { get; set; }
        public int      RecommendationScore { get; set; }
        public string?  RecommendationReason { get; set; }
        public decimal? CommissionPercent { get; set; }
        public string?  CarrierRating { get; set; }
        public string?  Subjectivities { get; set; }
        public string   Notes          { get; set; } = "";
        public string   Exclusions     { get; set; } = "";
        public Dictionary<string,string>  CoverageValues { get; set; } = new();
        public Dictionary<string,decimal> PremiumLines   { get; set; } = new();
        public Dictionary<string,string>  IntelValues    { get; set; } = new();
    }

    sealed class CovRow
    {
        public string Field        { get; set; } = "";
        public bool   IsSection    { get; set; }
        public bool   IsKey        { get; set; }
        public bool   IsHighlighted{ get; set; }
        public string BestValue    { get; set; } = "";
    }

    sealed class PremLine
    {
        public string Label      { get; set; } = "";
        public bool   IsTotalRow { get; set; }
    }

    List<QuoteModel> _quotes       = new();
    List<CovRow>     _coverageRows = new();
    List<PremLine>   _premiumLines = new();
    List<string>     _intelRows    = new();
    QuoteModel?      _recommended;

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home","/"), new("Submissions","/submissions"),
            new("Submission",$"/submissions/{SubmissionId}"),
            new("Compare",$"/quotes/compare/{SubmissionId}"));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _submission = await Api.GetSubmissionByIdAsync(SubmissionId);
            if (_submission is null)
            {
                _loadError = "Submission was not found.";
                return;
            }

            _submissionNo = _submission.SubmissionNumber;
            _account = _submission.AccountName;
            _lob = _submission.LineOfBusiness;

            var quoteDtos = await Api.GetSubmissionQuoteComparisonAsync(SubmissionId) ?? [];
            BuildComparison(quoteDtos);
        }
        catch (Exception ex)
        {
            _loadError = $"Quote comparison failed to load: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    void BuildComparison(IReadOnlyList<QuoteComparisonDto> quoteDtos)
    {
        var lowest = quoteDtos.Count == 0 ? 0 : quoteDtos.Min(q => q.AnnualPremium);
        var latestExpiry = quoteDtos.Count == 0 ? DateTime.MinValue : quoteDtos.Max(q => q.ExpiresDateUtc);

        _quotes = quoteDtos.Select(q => new QuoteModel
        {
            Carrier = q.CarrierName,
            QuoteId = q.QuoteId,
            CarrierId = q.CarrierId,
            QuoteNo = q.QuoteNumber,
            Premium = q.AnnualPremium,
            ExpDate = q.ExpiresDateUtc,
            IsLowest = q.AnnualPremium == lowest,
            IsRecommended = q.IsRecommended || (!quoteDtos.Any(x => x.IsRecommended) && q.RecommendationScore == quoteDtos.Max(x => x.RecommendationScore)),
            IsSelected = q.IsSelected,
            BestSla = q.ExpiresDateUtc == latestExpiry,
            FullLimits = q.Limit.HasValue && q.Limit.Value > 0,
            RecommendationScore = q.RecommendationScore,
            RecommendationReason = q.RecommendationReason,
            CommissionPercent = q.CommissionPercent,
            CarrierRating = q.CarrierRating,
            Subjectivities = q.Subjectivities,
            Notes = string.IsNullOrWhiteSpace(q.CoverageNotes) ? q.Status : q.CoverageNotes,
            Exclusions = q.Exclusions ?? string.Empty,
            CoverageValues = new()
            {
                { "Carrier", q.CarrierName },
                { "Quote Status", q.Status },
                { "Limit", q.Limit?.ToString("C0") ?? "Not provided" },
                { "Deductible", q.Deductible?.ToString("C0") ?? "Not provided" },
                { "Carrier Rating", string.IsNullOrWhiteSpace(q.CarrierRating) ? "Not provided" : q.CarrierRating },
                { "Subjectivities", string.IsNullOrWhiteSpace(q.Subjectivities) ? "None listed" : q.Subjectivities },
                { "Exclusions", string.IsNullOrWhiteSpace(q.Exclusions) ? "None listed" : q.Exclusions },
                { "Coverage Notes", string.IsNullOrWhiteSpace(q.CoverageNotes) ? "Not provided" : q.CoverageNotes }
            },
            PremiumLines = new()
            {
                { _lob, q.AnnualPremium },
                { "Taxes & Fees", q.TaxesAndFees ?? 0 },
                { "Broker Fee", q.BrokerFee ?? 0 },
                { "Commission", q.CommissionPercent ?? 0 },
                { "Deductible", q.Deductible ?? 0 },
                { "Limit", q.Limit ?? 0 },
                { "Total", q.AnnualPremium + (q.TaxesAndFees ?? 0) + (q.BrokerFee ?? 0) }
            },
            IntelValues = new()
            {
                { "Quote Status", q.Status },
                { "Recommendation Score", q.RecommendationScore.ToString() },
                { "Carrier Rating", string.IsNullOrWhiteSpace(q.CarrierRating) ? "Not provided" : q.CarrierRating },
                { "Subjectivity Burden", string.IsNullOrWhiteSpace(q.Subjectivities) ? "Low" : "Review" },
                { "Commission", q.CommissionPercent.HasValue ? $"{q.CommissionPercent:N2}%" : "Not provided" },
                { "Quoted Date", q.QuotedDateUtc.ToLocalTime().ToString("MMM d, yyyy") },
                { "Expires", q.ExpiresDateUtc.ToLocalTime().ToString("MMM d, yyyy") },
                { "Premium Delta", lowest > 0 ? (q.AnnualPremium - lowest).ToString("C0") : "-" },
                { "Bind Readiness", q.Status.Contains("Accepted", StringComparison.OrdinalIgnoreCase) || q.Status.Contains("Presented", StringComparison.OrdinalIgnoreCase) ? "Ready" : "Review" }
            }
        }).OrderByDescending(q => q.IsSelected).ThenByDescending(q => q.RecommendationScore).ThenBy(q => q.Premium).ToList();

        _recommended = _quotes.FirstOrDefault(q => q.IsRecommended) ?? _quotes.OrderByDescending(q => q.RecommendationScore).FirstOrDefault();

        _coverageRows = new()
        {
            new() { Field="Quote Summary", IsSection=true },
            new() { Field="Carrier", IsKey=true },
            new() { Field="Quote Status", IsKey=true },
            new() { Field="Limit", IsKey=true, BestValue = BestCarrierByLimit(), IsHighlighted=true },
            new() { Field="Deductible", IsKey=true, BestValue = _recommended?.Carrier ?? string.Empty, IsHighlighted=true },
            new() { Field="Carrier Rating", IsKey=true },
            new() { Field="Subjectivities", IsKey=true },
            new() { Field="Exclusions", IsKey=true },
            new() { Field="Coverage Notes" },
        };

        _premiumLines = new()
        {
            new() { Label=_lob },
            new() { Label="Taxes & Fees" },
            new() { Label="Broker Fee" },
            new() { Label="Commission" },
            new() { Label="Deductible" },
            new() { Label="Limit" },
            new() { Label="Total", IsTotalRow=true },
        };

        _intelRows = new()
        {
            "Quote Status", "Recommendation Score", "Carrier Rating", "Subjectivity Burden", "Commission", "Quoted Date", "Expires", "Premium Delta", "Bind Readiness"
        };
    }

    string BestCarrierByLimit()
    {
        var best = _quotes
            .Select(q => new { Quote = q, Limit = q.PremiumLines.GetValueOrDefault("Limit") })
            .OrderByDescending(x => x.Limit)
            .FirstOrDefault(x => x.Limit > 0);
        return best?.Quote.Carrier ?? string.Empty;
    }

    async Task SelectQuoteAsync(QuoteModel q)
    {
        if (_submission is null)
            return;

        await Api.SelectSubmissionQuoteAsync(SubmissionId, new SelectSubmissionQuoteRequest(_submission.TenantId, q.QuoteId, true, q.RecommendationReason ?? $"Selected from quote comparison with score {q.RecommendationScore}.", null));
        foreach (var x in _quotes) x.IsSelected = false;
        q.IsSelected = true;
        await _toast.ShowAsync(new ToastModel { Title = "Quote selected", Content = $"{q.QuoteNo} was persisted as the selected quote.", CssClass = "enterprise-toast-success" });
    }

    async Task BindQuote(QuoteModel q)
    {
        await SelectQuoteAsync(q);
        if (_submission is null)
            return;

        var quote = (await Api.GetSubmissionQuoteComparisonAsync(SubmissionId) ?? [])
            .FirstOrDefault(x => x.QuoteId == q.QuoteId);
        if (quote is null)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Bind", Content = "Quote could not be resolved for binding.", CssClass = "enterprise-toast-danger" });
            return;
        }

        await _toast.ShowAsync(new ToastModel { Title = "Bind request", Content = "Quote selected. Record the bind request and carrier confirmation in the Bind Center; policy creation is automatic after confirmation.", CssClass = "enterprise-toast-success" });
        Nav.NavigateTo("/quotes/bind");
    }

    void BindRecommended()
    {
        if (_recommended is not null)
        {
            _ = BindQuote(_recommended);
        }
    }

    void BindSelectedOrRecommended()
    {
        var selected = _quotes.FirstOrDefault(q => q.IsSelected) ?? _recommended ?? _quotes.FirstOrDefault();
        if (selected is not null)
        {
            _ = BindQuote(selected);
        }
    }

    async Task ExportComparison()
    {
        await _toast.ShowAsync(new ToastModel
        {
            Title    = "Export",
            Content  = "Quote comparison exported to PDF.",
            CssClass = "enterprise-toast-success"
        });
    }

    void GoBack() => Nav.NavigateTo($"/submissions/{SubmissionId}");
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string PercentOrDash(decimal? value) => value.HasValue ? $"{value.Value:N2}%" : "-";
}
