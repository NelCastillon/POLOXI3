    private readonly List<QuoteOption> _quotes = [];
    private readonly List<CovHighlight> _policyCoverages = [];

    private readonly TabOption[] _tabs = [new("snapshot", "Snapshot", "bi-clipboard-data"), new("riskchanges", "Risk Changes", "bi-exclamation-triangle"), new("premium", "Premium", "bi-graph-up"), new("claims", "Claims", "bi-exclamation-circle"), new("marketing", "Marketing", "bi-send"), new("risk", "Retention", "bi-shield-exclamation"), new("tasks", "Tasks", "bi-list-check"), new("communications", "Comms", "bi-envelope"), new("quotes", "Quotes", "bi-quote")];
    private readonly string[] _stageOptions = ["Not Started", "In Progress", "Quoted", "Renewed", "Lost", "Non-Renewed"];

    private int RetentionProb => _renewal is null ? 0 : Math.Clamp(100 - _renewal.RetentionRiskScore, 0, 100);
    private int OpenTaskCount => _tasks.Count(t => !t.Complete);
    private int CompletedTaskCount => _tasks.Count(t => t.Complete);
    private int OverdueTaskCount => _tasks.Count(t => t.IsDue);
    private int TaskProgress => _tasks.Count == 0 ? 0 : CompletedTaskCount * 100 / _tasks.Count;
    private string ToastIcon => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", _ => "bi-check-circle-fill" };
    private string LastTouchLabel => _comms.Count == 0 ? "none" : _comms.Max(c => c.SentAt).ToString("MMM d", CultureInfo.CurrentCulture);
    private string PremiumDelta => _renewal?.ProjectedPremium.HasValue == true ? SignedMoney(_renewal.ProjectedPremium.Value - _renewal.CurrentPremium) : "—";
    private string NextBestAction => OverdueTaskCount > 0 ? "Clear overdue renewal tasks before proposal delivery." : _renewal?.RetentionRiskScore >= 70 ? "Schedule executive retention outreach and compare competitive coverage." : _quotes.Any(q => q.IsRecommended) ? "Review the recommended quote and build the client proposal." : "Continue monitoring carrier responses and client sentiment.";

    private IReadOnlyList<Metric> Metrics => _renewal is null ? [] :
    [
        new("snapshot", MoneyShort(_renewal.CurrentPremium), "Current Premium", "In-force written premium", "bi-cash-stack", "rdf-kpi-blue"),
        new("premium", _renewal.ProjectedPremium.HasValue ? MoneyShort(_renewal.ProjectedPremium.Value) : "Pending", "Projected", "Projected renewal premium", "bi-calculator", _renewal.ProjectedPremium > _renewal.CurrentPremium ? "rdf-kpi-red" : "rdf-kpi-green"),
        new("premium", PremiumDelta, "Premium Δ", "Change against current premium", "bi-graph-up", PremiumDelta.StartsWith('+') ? "rdf-kpi-red" : "rdf-kpi-green"),
        new("snapshot", DaysLabel(_renewal.DaysToExpiry), "Expiry", "Days to expiration", "bi-clock", _renewal.DaysToExpiry <= 30 ? "rdf-kpi-red" : "rdf-kpi-blue"),
        new("claims", _renewal.LossRatio.ToString("F0", CultureInfo.CurrentCulture) + "%", "Loss Ratio", "Current loss ratio", "bi-percent", _renewal.LossRatio >= 70 ? "rdf-kpi-red" : _renewal.LossRatio >= 40 ? "rdf-kpi-amber" : "rdf-kpi-green"),
        new("tasks", OpenTaskCount.ToString("N0", CultureInfo.CurrentCulture), "Open Tasks", "Unfinished renewal tasks", "bi-list-check", OverdueTaskCount > 0 ? "rdf-kpi-red" : "rdf-kpi-gray"),
        new("risk", _renewal.RetentionRiskScore + "/100", "Risk Score", "Retention risk score", "bi-shield-exclamation", _renewal.RetentionRiskScore >= 70 ? "rdf-kpi-red" : _renewal.RetentionRiskScore >= 40 ? "rdf-kpi-amber" : "rdf-kpi-green"),
        new("quotes", _quotes.Count(q => q.Status == "Quoted").ToString("N0", CultureInfo.CurrentCulture), "Quotes", "Quotes received", "bi-quote", "rdf-kpi-purple")
    ];

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _userId = context.UserId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Renewals", "/renewals"), new("Renewal Detail", $"/renewals/{RenewalId}"));
        await LoadAsync();
    }

    private async Task Refresh() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            BuildStub();
            var detail = await Api.GetRenewalRetentionDetailAsync(RenewalId);
            if (detail is not null && detail.Case.RetentionCaseId != Guid.Empty)
            {
                ApplyRetentionDetail(detail);
                ShowToast("Renewal retention workflow synced successfully.", "success");
            }
            else
            {
                ShowToast("Renewal detail loaded from local workflow seed data.", "success");
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to sync renewal workflow: {ex.Message}";
            if (_renewal is null) BuildStub();
            ShowToast($"Renewal detail sync failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyRetentionDetail(RenewalRetentionDetailDto detail)
    {
        var c = detail.Case;
        _renewal ??= new RenewalModel();
        _renewal.RenewalId = c.RetentionCaseId;
        _renewal.PolicyId = c.PolicyId ?? c.RetentionCaseId;
        _renewal.AccountName = c.AccountName;
        _renewal.PolicyNumber = c.PolicyNumber;
        _renewal.Lob = c.LineOfBusiness;
        _renewal.Carrier = c.Carrier;
        _renewal.Producer = c.Producer;
        _renewal.Csr = c.Csr;
        _renewal.ExpiryDate = c.ExpirationDate;
        _renewal.DaysToExpiry = c.DaysToExpiration;
        _renewal.CurrentPremium = c.CurrentPremium;
        _renewal.ProjectedPremium = c.ProposedPremium;
        _renewal.RetentionRiskScore = c.RiskScore;
        _renewal.Stage = string.IsNullOrWhiteSpace(c.Stage) ? _renewal.Stage : c.Stage;
        _renewal.RiskAssessmentNotes = c.RiskDrivers ?? c.NextBestAction ?? _renewal.RiskAssessmentNotes;

        foreach (var activity in detail.Activities.OrderByDescending(a => a.ActivityDateUtc))
        {
            if (_comms.All(x => x.Subject != activity.Subject))
            {
                _comms.Add(new CommRow { Channel = activity.ActivityType, Direction = "Internal", Subject = activity.Subject, From = activity.CreatedByName, To = c.AccountName, Status = activity.Outcome, SentAt = activity.ActivityDateUtc.ToLocalTime(), CreatedBy = activity.CreatedByName, Notes = activity.Notes ?? string.Empty });
            }
        }

        foreach (var offer in detail.Offers)
        {
            if (_quotes.All(q => q.QuoteNumber != offer.RetentionOfferId.ToString()))
            {
                _quotes.Add(new QuoteOption { Carrier = offer.OfferName, QuoteNumber = offer.RetentionOfferId.ToString()[..8].ToUpperInvariant(), Status = offer.Status, QuotedPremium = c.CurrentPremium + offer.PremiumImpact, ExpiryDate = offer.PresentedDateUtc?.AddDays(30), Notes = offer.Notes ?? offer.OfferType, Features = [offer.OfferType, $"Retention lift {offer.RetentionLift}%"] });
            }
        }
    }

