    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string _tab = "snapshot";
    private string? _loadError;

    private RenewalModel? _renewal;
    private readonly List<RiskChangeRow> _riskChanges = [];
    private readonly List<PremHistoryRow> _premHistory = [];
    private readonly List<ClaimHistRow> _claims = [];
    private readonly List<MarketActionRow> _marketActions = [];
    private readonly List<RiskFactor> _riskFactors = [];
