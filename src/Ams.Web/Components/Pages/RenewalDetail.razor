@page "/renewals/{RenewalId:guid}"
@namespace Ams.Web.Components.Pages
@using System.Globalization
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@(_renewal is null ? "Renewal" : _renewal.AccountName) — Enterprise Renewal Detail</PageTitle>

@if (_toastVisible)
{
    <div class="rdf-toast rdf-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIcon" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="rdf-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="rdf-enterprise-page">
    @if (_loading)
    {
        <section class="rdf-loading-state">
            <i class="bi bi-arrow-repeat rdf-spin" aria-hidden="true"></i>
            <strong>Loading renewal detail...</strong>
            <span>Syncing policy, retention, quote, risk, and task workflow.</span>
        </section>
    }
    else if (_renewal is null)
    {
        <section class="rdf-empty-state">
            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
            <h1>Renewal not found</h1>
            <p>The renewal record could not be loaded from the workflow source.</p>
            <button type="button" class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/renewals")'><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Renewals</button>
        </section>
    }
    else
    {
        <section class="rdf-hero">
            <div class="rdf-hero-left">
                <span class="rdf-hero-icon rdf-lob-@LobKey(_renewal.Lob)"><i class="bi @LobIcon(_renewal.Lob)" aria-hidden="true"></i></span>
                <div class="rdf-hero-copy">
                    <div class="rdf-title-row">
                        <h1>@_renewal.AccountName</h1>
                        <span class="rdf-stage rdf-st-@StageCss(_renewal.Stage)">@_renewal.Stage</span>
                        <span><i class="bi bi-shield-check" aria-hidden="true"></i> @_renewal.PolicyNumber</span>
                        <span><i class="bi bi-layers" aria-hidden="true"></i> @_renewal.Lob</span>
                    </div>
                    <p>Enterprise renewal command page for premium protection, carrier marketing, risk changes, retention playbooks, tasks, communications, and quote decisions.</p>
                    <div class="rdf-sub-row">
                        <button type="button" @onclick='() => Nav.NavigateTo($"/policies/{_renewal.PolicyId}")'><i class="bi bi-shield" aria-hidden="true"></i> Policy</button>
                        <span><i class="bi bi-building-fill" aria-hidden="true"></i> @_renewal.Carrier</span>
                        <span class="rdf-exp-chip rdf-exp-@ExpChipCss(_renewal.DaysToExpiry)"><i class="bi bi-clock" aria-hidden="true"></i> @DaysLabel(_renewal.DaysToExpiry)</span>
                        <span><i class="bi bi-person-badge" aria-hidden="true"></i> @_renewal.Producer</span>
                        <span><i class="bi bi-geo-alt" aria-hidden="true"></i> @_renewal.Branch</span>
                    </div>
                </div>
            </div>
            <div class="rdf-hero-actions">
                <button type="button" class="um-btn um-btn-ghost" @onclick="Refresh" disabled="@_loading"><i class="bi @(_loading ? "bi-arrow-repeat rdf-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
                <button type="button" class="um-btn um-btn-ghost" @onclick='() => SetStage("In Progress")' disabled='@(_renewal.Stage == "In Progress")'><i class="bi bi-play-circle" aria-hidden="true"></i> Start Renewal</button>
                <button type="button" class="um-btn um-btn-ghost" @onclick="OpenRemarket"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Remarket</button>
                <button type="button" class="um-btn um-btn-ghost" @onclick='() => SetTab("quotes")'><i class="bi bi-quote" aria-hidden="true"></i> Quotes</button>
                <button type="button" class="um-btn um-btn-primary" @onclick='() => SetStage("Renewed")' disabled='@(_renewal.Stage == "Renewed")'><i class="bi bi-check-circle" aria-hidden="true"></i> Mark Renewed</button>
            </div>
        </section>

        @if (_loadError is not null)
        {
            <div class="alert alert-danger rdf-error-banner" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError</div>
        }

        <section class="rdf-kpi-strip" aria-label="Renewal detail KPI cards">
            @foreach (var metric in Metrics)
            {
                <button type="button" class="@MetricClass(metric)" title="@metric.Caption" @onclick='() => SetTab(metric.Tab)'>
                    <span class="rdf-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                    <span><span class="rdf-kpi-val">@metric.Value</span><span class="rdf-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
                </button>
            }
        </section>

        <section class="rdf-workflow-strip" aria-label="Renewal workflow actions">
            <button type="button" class="rdf-workflow-card" @onclick='() => SetTab("risk")'><i class="bi bi-shield-exclamation" aria-hidden="true"></i><span><strong>Protect retention</strong><span>@RetentionProb% probability with @RiskLabel(_renewal.RetentionRiskScore).ToLowerInvariant() signal.</span></span></button>
            <button type="button" class="rdf-workflow-card" @onclick='() => SetTab("marketing")'><i class="bi bi-send" aria-hidden="true"></i><span><strong>Market renewal</strong><span>@_marketActions.Count market actions and @_quotes.Count(q => q.Status == "Quoted") quote(s).</span></span></button>
            <button type="button" class="rdf-workflow-card rdf-workflow-warning" @onclick='() => SetTab("tasks")'><i class="bi bi-list-check" aria-hidden="true"></i><span><strong>Clear tasks</strong><span>@OpenTaskCount open task(s), @OverdueTaskCount overdue.</span></span></button>
            <button type="button" class="rdf-workflow-card" @onclick='() => SetTab("communications")'><i class="bi bi-envelope" aria-hidden="true"></i><span><strong>Client contact</strong><span>@_comms.Count touchpoint(s), last @LastTouchLabel.</span></span></button>
        </section>

        <section class="rdf-content-layout">
            <main class="rdf-main-card">
                <nav class="rdf-tabs" aria-label="Renewal detail tabs">
                    @foreach (var tab in _tabs)
                    {
                        <button type="button" class="@TabClass(tab.Id)" @onclick="() => SetTab(tab.Id)"><i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label <span>@TabBadge(tab.Id)</span></button>
                    }
                </nav>

                @if (_tab == "snapshot")
                {
                    <section class="rdf-tab-body">
                        <div class="rdf-section-head"><div><h2>Policy snapshot</h2><p>Most important identity, premium, team, term, and coverage information for renewal execution.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/policies/{_renewal.PolicyId}")'>Open Policy</button></div>
                        <div class="rdf-summary-grid">
                            @InfoCard("Policy Identity", "bi-clipboard-data", new[] { Field("Policy Number", _renewal.PolicyNumber), Field("Line of Business", _renewal.Lob), Field("Carrier", _renewal.Carrier), Field("Program", _renewal.Program), Field("Policy Status", _renewal.PolicyStatus), Field("Policy Type", _renewal.PolicyType) })
                            @InfoCard("Term Dates", "bi-calendar-range", new[] { Field("Effective Date", DateText(_renewal.EffDate)), Field("Expiration Date", DateText(_renewal.ExpiryDate)), Field("Days Remaining", DaysLabel(_renewal.DaysToExpiry)), Field("Term Length", $"{_renewal.TermMonths} months"), Field("Renewal Notice", _renewal.RenewalNoticeDate?.ToString("MM/dd/yyyy", CultureInfo.CurrentCulture) ?? "Not sent"), Field("Quote Due", _renewal.QuoteDueDate?.ToString("MM/dd/yyyy", CultureInfo.CurrentCulture) ?? "Not set") })
                            @InfoCard("Premium Summary", "bi-cash-stack", new[] { Field("Current Premium", Money(_renewal.CurrentPremium)), Field("Prior Premium", _renewal.PriorPremium.HasValue ? Money(_renewal.PriorPremium.Value) : "—"), Field("Projected Premium", _renewal.ProjectedPremium.HasValue ? Money(_renewal.ProjectedPremium.Value) : "Pending"), Field("Premium Change", PremiumDelta), Field("Minimum Acceptable", _renewal.MinAcceptablePremium.HasValue ? Money(_renewal.MinAcceptablePremium.Value) : "Not set"), Field("Agency Fee", Money(_renewal.AgencyFee)) })
                            @InfoCard("Named Insured", "bi-building", new[] { Field("Insured Name", _renewal.PrimaryInsured), Field("Address", _renewal.InsuredAddress), Field("City / State", $"{_renewal.InsuredCity}, {_renewal.InsuredState} {_renewal.InsuredZip}"), Field("Entity Type", _renewal.EntityType ?? "—"), Field("SIC", _renewal.SicCode ?? "—"), Field("FEIN", _renewal.Fein ?? "—") })
                            @InfoCard("Service Team", "bi-people", new[] { Field("Producer", _renewal.Producer), Field("CSR", _renewal.Csr), Field("Account Manager", _renewal.AccountManager ?? "—"), Field("Underwriter", _renewal.Underwriter ?? "—"), Field("UW Phone", _renewal.UwPhone ?? "—"), Field("Branch", _renewal.Branch) })
                            @InfoCard("Coverage Highlights", "bi-shield-plus", _policyCoverages.Select(c => Field(c.Label, c.Value)).ToArray())
                        </div>
                    </section>
                }
                else if (_tab == "riskchanges")
                {
                    <section class="rdf-tab-body">
                        <div class="rdf-section-head"><div><h2>Risk changes</h2><p>@_riskChanges.Count change(s), @_riskChanges.Count(c => c.Severity == "Material") material, @_riskChanges.Count(c => !c.IsResolved) unresolved.</p></div><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="AddRiskChange"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Change</button></div>
                        <div class="rdf-table-wrap"><table class="rdf-table"><thead><tr><th>Risk Area</th><th>Description</th><th>Prior</th><th>Current</th><th>Severity</th><th>UW Implication</th><th>Reviewed</th><th>Status</th></tr></thead><tbody>@foreach (var item in _riskChanges) { <tr><td><strong>@item.Area</strong></td><td>@item.Description</td><td>@item.PriorValue</td><td>@item.CurrentValue</td><td><span class="rdf-severity rdf-sev-@Slug(item.Severity)">@item.Severity</span></td><td>@item.UwImplication</td><td>@(string.IsNullOrWhiteSpace(item.ReviewedBy) ? "Pending" : item.ReviewedBy)</td><td><button type="button" class="rdf-icon-toggle @(item.IsResolved ? "rdf-toggle-on" : string.Empty)" @onclick="() => ToggleRiskChange(item)"><i class="bi @(item.IsResolved ? "bi-check-circle-fill" : "bi-clock")" aria-hidden="true"></i> @(item.IsResolved ? "Resolved" : "Open")</button></td></tr> }</tbody></table></div>
                    </section>
                }
                else if (_tab == "premium")
                {
                    <section class="rdf-tab-body">
                        <div class="rdf-section-head"><div><h2>Premium history</h2><p>Five-year premium trend, carrier movement, and loss ratio context.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetTab("quotes")'>View Quotes</button></div>
                        <div class="rdf-bar-chart">
                            @{ var maxPremium = _premHistory.Any() ? _premHistory.Max(h => h.Premium) : 1m; }
                            @foreach (var h in _premHistory.OrderBy(h => h.Year))
                            {
                                var pct = Math.Max(4, (double)(h.Premium / maxPremium * 100));
                                <div class="rdf-bar-col"><div class="rdf-bar-value">@MoneyShort(h.Premium)</div><div class="rdf-bar-wrap"><div class="rdf-bar-fill" style="height:@pct.ToString("F0", CultureInfo.InvariantCulture)%"></div></div><div class="rdf-bar-year">@h.Year</div>@if (h.CarrierChanged) { <i class="bi bi-arrow-left-right rdf-carrier-change" title="Carrier changed" aria-hidden="true"></i> }</div>
                            }
                        </div>
                        <div class="rdf-table-wrap"><table class="rdf-table"><thead><tr><th>Policy Year</th><th>Carrier</th><th class="rdf-num">Premium</th><th class="rdf-num">Change</th><th class="rdf-num">Change %</th><th class="rdf-num">Loss Ratio</th><th>Notes</th></tr></thead><tbody>@foreach (var h in _premHistory) { <tr><td><strong>@h.Year</strong></td><td>@h.Carrier</td><td class="rdf-num">@Money(h.Premium)</td><td class="rdf-num @DeltaClass(h.PremiumChange)">@(h.PremiumChange == 0 ? "—" : SignedMoney(h.PremiumChange))</td><td class="rdf-num @DeltaClass(h.PremiumChangePct)">@(h.PremiumChangePct == 0 ? "—" : SignedPct(h.PremiumChangePct))</td><td class="rdf-num @LossClass(h.LossRatio)">@h.LossRatio.ToString("F1", CultureInfo.CurrentCulture)%</td><td>@h.Notes</td></tr> }</tbody></table></div>
                    </section>
                }
                else if (_tab == "claims")
                {
                    <section class="rdf-tab-body">
                        <div class="rdf-section-head"><div><h2>Claims / losses</h2><p>Loss activity that may influence underwriting, premium, and retention risk.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="LogClaimReview"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Log Review</button></div>
                        <div class="rdf-mini-kpis"><div><strong>@_claims.Count</strong><span>Total Claims</span></div><div><strong class="rdf-red">@_claims.Count(c => c.Status == "Open")</strong><span>Open</span></div><div><strong>@MoneyShort(_claims.Sum(c => c.TotalIncurred))</strong><span>Incurred</span></div><div><strong>@MoneyShort(_claims.Sum(c => c.Reserve))</strong><span>Reserve</span></div><div><strong class="@LossClass(_renewal.LossRatio)">@_renewal.LossRatio.ToString("F1", CultureInfo.CurrentCulture)%</strong><span>Loss Ratio</span></div></div>
                        <div class="rdf-table-wrap"><table class="rdf-table"><thead><tr><th>Claim #</th><th>Year</th><th>Loss Date</th><th>Type</th><th>Description</th><th>Status</th><th class="rdf-num">Incurred</th><th class="rdf-num">Paid</th><th class="rdf-num">Reserve</th></tr></thead><tbody>@foreach (var c in _claims) { <tr><td><strong>@c.ClaimNum</strong></td><td>@c.PolicyYear</td><td>@DateText(c.LossDate)</td><td>@c.LossType</td><td>@c.Description</td><td><span class="rdf-status rdf-status-@Slug(c.Status)">@c.Status</span></td><td class="rdf-num">@Money(c.TotalIncurred)</td><td class="rdf-num">@Money(c.Paid)</td><td class="rdf-num">@Money(c.Reserve)</td></tr> }</tbody></table></div>
                    </section>
                }
                else if (_tab == "marketing")
                {
                    <section class="rdf-tab-body">
                        <div class="rdf-section-head"><div><h2>Marketing actions</h2><p>@_marketActions.Count market(s) contacted and @_marketActions.Count(m => m.Status == "Quoted") quoted.</p></div><div class="rdf-head-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="AddMarket"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Market</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => Nav.NavigateTo($"/quotes/compare/{_renewal.PolicyId}")'>Compare Quotes</button></div></div>
                        <div class="rdf-table-wrap"><table class="rdf-table"><thead><tr><th>Carrier</th><th>Program</th><th>Submitted</th><th>Status</th><th class="rdf-num">Quoted Premium</th><th>Quote Expires</th><th>Underwriter</th><th>Action</th></tr></thead><tbody>@foreach (var m in _marketActions) { <tr><td><strong>@m.Carrier</strong><small>@m.Notes</small></td><td>@m.Program</td><td>@(m.ContactedDate?.ToString("MM/dd/yyyy", CultureInfo.CurrentCulture) ?? "—")</td><td><span class="rdf-status rdf-status-@Slug(m.Status)">@m.Status</span></td><td class="rdf-num">@(m.QuotedPremium.HasValue ? Money(m.QuotedPremium.Value) : "—")</td><td>@(m.QuoteExpiry?.ToString("MM/dd/yyyy", CultureInfo.CurrentCulture) ?? "—")</td><td>@m.Underwriter</td><td>@if (m.QuotedPremium.HasValue && m.Status == "Quoted") { <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => SelectQuote(m)">Select</button> }</td></tr> }</tbody></table></div>
                    </section>
                }
                else if (_tab == "risk")
                {
                    <section class="rdf-tab-body">
                        <div class="rdf-section-head"><div><h2>Retention risk</h2><p>Risk score, drivers, probability, and recommended retention actions.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CompletePriorityActions">Complete Priority</button></div>
                        <div class="rdf-risk-layout"><div class="rdf-risk-gauge rdf-risk-@RiskCss(_renewal.RetentionRiskScore)"><strong>@_renewal.RetentionRiskScore</strong><span>Risk Score</span><small>@RiskLabel(_renewal.RetentionRiskScore)</small></div><div class="rdf-risk-summary"><h3>Risk Assessment</h3><p>Estimated retention probability: <strong class="@(RetentionProb >= 75 ? "rdf-green" : RetentionProb >= 50 ? "rdf-amber" : "rdf-red")">@RetentionProb%</strong></p><p>@_renewal.RiskAssessmentNotes</p></div></div>
                        <div class="rdf-risk-factors">@foreach (var rf in _riskFactors) { <article class="rdf-risk-factor rdf-impact-@rf.Impact.ToLowerInvariant()"><div><i class="bi @rf.Icon" aria-hidden="true"></i><strong>@rf.Factor</strong><span>@rf.Impact</span></div><div class="rdf-progress"><i style="width:@rf.Score%"></i></div><p>@rf.Detail</p></article> }</div>
                        <div class="rdf-action-list">@foreach (var action in _retentionActions) { <label class="rdf-action-item @(action.IsComplete ? "rdf-action-done" : action.IsPriority ? "rdf-action-priority" : string.Empty)"><input type="checkbox" @bind="action.IsComplete" /><span><strong>@action.Action</strong><small>@action.Type · @action.Owner · @action.DueDesc</small></span>@if (action.IsPriority && !action.IsComplete) { <i class="bi bi-star-fill" aria-hidden="true"></i> }</label> }</div>
                    </section>
                }
                else if (_tab == "tasks")
                {
                    <section class="rdf-tab-body">
                        <div class="rdf-section-head"><div><h2>Tasks</h2><p>@CompletedTaskCount/@_tasks.Count complete, @OpenTaskCount open, @OverdueTaskCount overdue.</p></div><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="AddTask"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Task</button></div>
                        <div class="rdf-task-progress"><span>Renewal progress</span><div><i style="width:@TaskProgress%"></i></div><strong>@TaskProgress%</strong></div>
                        <div class="rdf-task-list">@foreach (var task in _tasks.OrderBy(t => t.SortOrder)) { <label class="rdf-task-item @(task.Complete ? "rdf-task-done" : task.IsDue ? "rdf-task-overdue" : string.Empty)"><input type="checkbox" @bind="task.Complete" /><span class="rdf-task-step">@task.SortOrder</span><span class="rdf-task-body"><strong>@task.Title</strong><small>@task.Category · @(task.DueDate.HasValue ? $"Due {task.DueDate.Value:MM/dd/yyyy}" : "No due date") · @(task.AssignedTo ?? "Unassigned")</small>@if (!string.IsNullOrWhiteSpace(task.Notes)) { <em>@task.Notes</em> }</span>@if (task.IsDue) { <span class="rdf-due-badge">Overdue</span> }</label> }</div>
                    </section>
                }
                else if (_tab == "communications")
                {
                    <section class="rdf-tab-body">
                        <div class="rdf-section-head"><div><h2>Communication log</h2><p>@_comms.Count client, carrier, and internal renewal touchpoint(s).</p></div><div class="rdf-head-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NewMessage">New Message</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="LogCall">Log Call</button></div></div>
                        <div class="rdf-timeline">@foreach (var c in _comms.OrderByDescending(c => c.SentAt)) { <article class="rdf-timeline-item"><span class="rdf-timeline-dot rdf-comm-@Slug(c.Channel)"><i class="bi @CommIcon(c.Channel)" aria-hidden="true"></i></span><div><header><strong>@c.Subject</strong><span>@c.SentAt.ToString("MM/dd/yyyy hh:mm tt", CultureInfo.CurrentCulture)</span></header><p><span class="rdf-status rdf-status-@Slug(c.Channel)">@c.Channel</span> <span class="rdf-status rdf-status-@Slug(c.Direction)">@c.Direction</span> <span class="rdf-status rdf-status-@Slug(c.Status)">@c.Status</span></p><small>From @c.From to @c.To · by @c.CreatedBy</small>@if (!string.IsNullOrWhiteSpace(c.Notes)) { <p>@c.Notes</p> }</div></article> }</div>
                    </section>
                }
                else
                {
                    <section class="rdf-tab-body">
                        <div class="rdf-section-head"><div><h2>Quote options</h2><p>@_quotes.Count(q => q.Status == "Quoted") quote(s) received. Select the best option for proposal or binding.</p></div><div class="rdf-head-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/quotes/proposal/{_renewal.PolicyId}")'>Build Proposal</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => Nav.NavigateTo("/quotes/bind")'>Bind</button></div></div>
                        <div class="rdf-quote-grid">@foreach (var q in _quotes) { <article class="rdf-quote-card @(q.IsRecommended ? "rdf-quote-rec" : string.Empty) @(q.IsSelected ? "rdf-quote-selected" : string.Empty)">@if (q.IsRecommended) { <span class="rdf-rec-badge"><i class="bi bi-trophy-fill" aria-hidden="true"></i> Recommended</span> }<header><strong>@q.Carrier</strong><span class="rdf-status rdf-status-@Slug(q.Status)">@q.Status</span></header><div class="rdf-quote-prem">@(q.QuotedPremium.HasValue ? Money(q.QuotedPremium.Value) : "Pending")</div>@if (q.QuotedPremium.HasValue) { var d = q.QuotedPremium.Value - _renewal.CurrentPremium; <p class="@DeltaClass(d)">@SignedMoney(d) vs current (@SignedPct(d / _renewal.CurrentPremium * 100m))</p> }<div class="rdf-quote-meta">@if (!string.IsNullOrWhiteSpace(q.QuoteNumber)) { <span>@q.QuoteNumber</span> }@if (q.ExpiryDate.HasValue) { <span>Exp @q.ExpiryDate.Value.ToString("MM/dd/yy", CultureInfo.CurrentCulture)</span> }</div><div class="rdf-chip-row">@foreach (var feat in q.Features) { <span>@feat</span> }</div><p>@q.Notes</p><footer><button type="button" class="um-btn @(q.IsSelected ? "um-btn-success" : "um-btn-ghost") um-btn-sm" @onclick="() => SelectRenewalQuote(q)"><i class="bi @(q.IsSelected ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i> @(q.IsSelected ? "Selected" : "Select")</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => Nav.NavigateTo("/quotes/bind")'>Bind</button></footer></article> }</div>
                    </section>
                }
            </main>

            <aside class="rdf-side-panel">
                <section class="rdf-side-card">
                    <h2>Executive summary</h2>
                    <div class="rdf-side-grid">
                        <div><span>Premium</span><strong>@Money(_renewal.CurrentPremium)</strong></div>
                        <div><span>Projected</span><strong>@(_renewal.ProjectedPremium.HasValue ? Money(_renewal.ProjectedPremium.Value) : "Pending")</strong></div>
                        <div><span>Risk</span><strong class="@RiskTone(_renewal.RetentionRiskScore)">@_renewal.RetentionRiskScore/100</strong></div>
                        <div><span>Retention</span><strong>@RetentionProb%</strong></div>
                        <div><span>Open Tasks</span><strong>@OpenTaskCount</strong></div>
                        <div><span>Quotes</span><strong>@_quotes.Count(q => q.Status == "Quoted")</strong></div>
                    </div>
                </section>
                <section class="rdf-side-card">
                    <h2>Stage workflow</h2>
                    <div class="rdf-stage-actions">
                        @foreach (var stage in _stageOptions)
                        {
                            <button type="button" class="@(stage == _renewal.Stage ? "rdf-stage-active" : string.Empty)" @onclick="() => SetStage(stage)">@stage</button>
                        }
                    </div>
                </section>
                <section class="rdf-side-card">
                    <h2>Next best action</h2>
                    <p>@NextBestAction</p>
                    <div class="rdf-side-actions">
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetTab("tasks")'>Tasks</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetTab("communications")'>Contact</button>
                        <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => SetTab("quotes")'>Quote</button>
                    </div>
                </section>
            </aside>
        </section>
    }
</div>

@code {
    [Parameter] public Guid RenewalId { get; set; }

    private Guid _tenantId;
