@page "/renewals/{RenewalId:guid}"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@(_renewal is null ? "Renewal" : _renewal.AccountName) — Renewal Detail</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@if (_loading)
{
    <div class="rd-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading renewal…</span></div>
}
else if (_renewal is null)
{
    <div class="rd-not-found">
        <i class="bi bi-arrow-repeat rd-nf-icon" aria-hidden="true"></i>
        <h2>Renewal not found</h2>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/renewals")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Renewals
        </button>
    </div>
}
else
{
    <!-- ── HEADER ──────────────────────────────────────────────────── -->
    <div class="rd-header">
        <div class="rd-header-left">
            <div class="rd-lob-icon rd-lob-@LobKey(_renewal.Lob)">
                <i class="bi @LobIcon(_renewal.Lob)" aria-hidden="true"></i>
            </div>
            <div class="rd-header-info">
                <div class="rd-title-row">
                    <h1 class="rd-acct-name">@_renewal.AccountName</h1>
                    <span class="rd-stage rd-st-@StageCss(_renewal.Stage)">@_renewal.Stage</span>
                    <span class="rd-lob-badge">@_renewal.Lob</span>
                    <span class="rd-risk-badge rd-risk-@RiskCss(_renewal.RetentionRiskScore)"
                          title="Retention Risk Score">
                        <i class="bi bi-shield-exclamation" aria-hidden="true"></i> Risk @_renewal.RetentionRiskScore
                    </span>
                </div>
                <div class="rd-sub-row">
                    <button class="rd-policy-link" @onclick='() => Nav.NavigateTo($"/policies/{_renewal.PolicyId}")'>
                        <i class="bi bi-shield" aria-hidden="true"></i> @_renewal.PolicyNumber
                    </button>
                    <span class="rd-sub-chip"><i class="bi bi-building-fill" aria-hidden="true"></i>@_renewal.Carrier</span>
                    <span class="rd-sub-chip"><i class="bi bi-calendar" aria-hidden="true"></i>Expires @_renewal.ExpiryDate.ToString("MM/dd/yyyy")</span>
                    <span class="rd-sub-chip rd-exp-chip-@ExpChipCss(_renewal.DaysToExpiry)">
                        <i class="bi bi-clock" aria-hidden="true"></i>@DaysLabel(_renewal.DaysToExpiry)
                    </span>
                    <span class="rd-sub-chip"><i class="bi bi-person-badge" aria-hidden="true"></i>@_renewal.Producer</span>
                </div>
            </div>
        </div>
        <div class="rd-header-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetStage("In Progress")'
                    disabled="@(_renewal.Stage == "In Progress")">
                <i class="bi bi-play-circle" aria-hidden="true"></i> Start Renewal
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenRemarket">
                <i class="bi bi-arrow-left-right" aria-hidden="true"></i> Remarket
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => _tab = 8'>
                <i class="bi bi-quote" aria-hidden="true"></i> View Quotes
            </button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="LogActivity">
                <i class="bi bi-lightning" aria-hidden="true"></i> Log Activity
            </button>
            <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => SetStage("Renewed")'
                    disabled="@(_renewal.Stage == "Renewed")">
                <i class="bi bi-check-circle" aria-hidden="true"></i> Mark Renewed
            </button>
        </div>
    </div>

    <!-- ── KPI BAR ─────────────────────────────────────────────────── -->
    <div class="rd-kpi-bar">
        @RdKpi("Current Premium",    _renewal.CurrentPremium.ToString("C0"),         "bi-cash-stack",         "rd-ki-blue")
        @RdKpi("Projected Premium",  _renewal.ProjectedPremium.HasValue ? _renewal.ProjectedPremium.Value.ToString("C0") : "Pending",  "bi-calculator",    _renewal.ProjectedPremium > _renewal.CurrentPremium ? "rd-ki-red" : "rd-ki-green")
        @RdKpi("Premium Δ",          PremiumDelta,                                   "bi-graph-up",           PremiumDeltaCss)
        @RdKpi("Days to Expiry",     DaysLabel(_renewal.DaysToExpiry),               "bi-clock",              _renewal.DaysToExpiry <= 30 ? "rd-ki-red" : _renewal.DaysToExpiry <= 60 ? "rd-ki-amber" : "rd-ki-blue")
        @RdKpi("Loss Ratio",         _renewal.LossRatio.ToString("F0") + "%",        "bi-percent",            _renewal.LossRatio >= 70 ? "rd-ki-red" : _renewal.LossRatio >= 40 ? "rd-ki-amber" : "rd-ki-green")
        @RdKpi("Open Tasks",         _tasks.Count(t => !t.Complete).ToString(),      "bi-list-check",         _tasks.Any(t => !t.Complete && t.IsDue) ? "rd-ki-red" : "rd-ki-gray")
        @RdKpi("Risk Score",         _renewal.RetentionRiskScore + "/100",           "bi-shield-exclamation", RiskCss(_renewal.RetentionRiskScore) == "high" ? "rd-ki-red" : RiskCss(_renewal.RetentionRiskScore) == "med" ? "rd-ki-amber" : "rd-ki-green")
        @RdKpi("Quotes Received",    _quotes.Count(q => q.Status == "Quoted").ToString(), "bi-quote",         "rd-ki-purple")
    </div>

    <!-- ── 9-TAB BODY ──────────────────────────────────────────────── -->
    <AppDetailTabs SelectedTab="_tab" SelectedTabChanged="t => _tab = t">
        <Tabs>

            <!-- 0 ── POLICY SNAPSHOT ──────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Policy Snapshot" IconCss="bi bi-clipboard-data" /></ChildContent>
                <ContentTemplate>
                    <div class="rd-tab-body">
                        <div class="rd-summary-grid">
                            <div class="rd-info-card">
                                <h3 class="rd-card-hdr">Policy Identity</h3>
                                <div class="rd-field-grid">
                                    @F("Policy Number",    _renewal.PolicyNumber)
                                    @F("Line of Business", _renewal.Lob)
                                    @F("Carrier",          _renewal.Carrier)
                                    @F("Program",          _renewal.Program)
                                    @F("Policy Status",    _renewal.PolicyStatus)
                                    @F("Policy Type",      _renewal.PolicyType)
                                </div>
                            </div>
                            <div class="rd-info-card">
                                <h3 class="rd-card-hdr">Current Term Dates</h3>
                                <div class="rd-field-grid">
                                    @F("Effective Date",  _renewal.EffDate.ToString("MM/dd/yyyy"))
                                    @F("Expiration Date", _renewal.ExpiryDate.ToString("MM/dd/yyyy"))
                                    @F("Days Remaining",  DaysLabel(_renewal.DaysToExpiry))
                                    @F("Term Length",     _renewal.TermMonths + " months")
                                    @F("Renewal Notice",  _renewal.RenewalNoticeDate?.ToString("MM/dd/yyyy") ?? "Not sent")
                                    @F("Quote Due Date",  _renewal.QuoteDueDate?.ToString("MM/dd/yyyy") ?? "Not set")
                                </div>
                            </div>
                            <div class="rd-info-card">
                                <h3 class="rd-card-hdr">Premium Summary</h3>
                                <div class="rd-field-grid">
                                    @F("Current Written Prem.",    _renewal.CurrentPremium.ToString("C2"))
                                    @F("Prior Year Premium",       _renewal.PriorPremium?.ToString("C2") ?? "—")
                                    @F("Year-Over-Year Change",    _renewal.PriorPremium.HasValue ? ((_renewal.CurrentPremium - _renewal.PriorPremium.Value) / _renewal.PriorPremium.Value * 100m).ToString("F1") + "%" : "—")
                                    @F("Projected Renewal Prem.", _renewal.ProjectedPremium?.ToString("C2") ?? "Pending")
                                    @F("Min. Acceptable Prem.",    _renewal.MinAcceptablePremium?.ToString("C2") ?? "Not set")
                                    @F("Agency Fee",               _renewal.AgencyFee.ToString("C2"))
                                </div>
                            </div>
                            <div class="rd-info-card">
                                <h3 class="rd-card-hdr">Named Insured</h3>
                                <div class="rd-field-grid">
                                    @F("Insured Name",   _renewal.PrimaryInsured)
                                    @F("Address",        _renewal.InsuredAddress)
                                    @F("City / State",   $"{_renewal.InsuredCity}, {_renewal.InsuredState} {_renewal.InsuredZip}")
                                    @F("Entity Type",    _renewal.EntityType ?? "—")
                                    @F("SIC Code",       _renewal.SicCode ?? "—")
                                    @F("FEIN",           _renewal.Fein ?? "—")
                                </div>
                            </div>
                            <div class="rd-info-card">
                                <h3 class="rd-card-hdr">Service Team</h3>
                                <div class="rd-field-grid">
                                    @F("Producer",        _renewal.Producer)
                                    @F("CSR",             _renewal.Csr)
                                    @F("Account Manager", _renewal.AccountManager ?? "—")
                                    @F("Underwriter",     _renewal.Underwriter ?? "—")
                                    @F("UW Phone",        _renewal.UwPhone ?? "—")
                                    @F("Branch",          _renewal.Branch)
                                </div>
                            </div>
                            <div class="rd-info-card">
                                <h3 class="rd-card-hdr">Coverage Highlights</h3>
                                <div class="rd-field-grid">
                                    @foreach (var cov in _policyCoverages)
                                    {
                                        @F(cov.Label, cov.Value)
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 1 ── RISK CHANGES ─────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Risk Changes" IconCss="bi bi-exclamation-triangle" /></ChildContent>
                <ContentTemplate>
                    <div class="rd-tab-body">
                        <div class="rd-tab-toolbar">
                            <span class="rd-tab-count">
                                @_riskChanges.Count change(s) ·
                                <span class="rd-tc-warn">@_riskChanges.Count(c => c.Severity == "Material") material</span>
                            </span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="AddRiskChange">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Change
                            </button>
                        </div>
                        <SfGrid TValue="RiskChangeRow" DataSource="_riskChanges"
                                AllowSorting="true" EnableHover="true" RowHeight="56" CssClass="rd-data-grid">
                            <GridColumns>
                                <GridColumn Field="@nameof(RiskChangeRow.Area)"        HeaderText="Risk Area"     Width="160" />
                                <GridColumn Field="@nameof(RiskChangeRow.Description)" HeaderText="Description"   MinWidth="220" />
                                <GridColumn Field="@nameof(RiskChangeRow.PriorValue)"  HeaderText="Prior"         Width="150" />
                                <GridColumn Field="@nameof(RiskChangeRow.CurrentValue)" HeaderText="Current"      Width="150" />
                                <GridColumn Field="@nameof(RiskChangeRow.Severity)"    HeaderText="Severity"      Width="125" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                                    <Template>
                                        @{ var rc = (RiskChangeRow)context; }
                                        <span class="rd-severity rd-sev-@rc.Severity.ToLower().Replace(" ","")">@rc.Severity</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(RiskChangeRow.UwImplication)" HeaderText="UW Implication" MinWidth="180" />
                                <GridColumn Field="@nameof(RiskChangeRow.ReviewedBy)"  HeaderText="Reviewed By"  Width="140" />
                                <GridColumn Field="@nameof(RiskChangeRow.IsResolved)"  HeaderText="Resolved"     Width="95" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                                    <Template>
                                        @{ var rc = (RiskChangeRow)context; }
                                        <i class="bi @(rc.IsResolved ? "bi-check-circle-fill pd-chk-yes" : "bi-clock rd-pending-icon")"
                                           aria-hidden="true"></i>
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 2 ── PREMIUM HISTORY ──────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Premium History" IconCss="bi bi-graph-up" /></ChildContent>
                <ContentTemplate>
                    <div class="rd-tab-body">
                        <!-- Premium trend visual -->
                        <div class="rd-prem-chart">
                            <h3 class="rd-chart-title">5-Year Premium Trend</h3>
                            <div class="rd-bar-chart">
                                @{
                                    var maxP = _premHistory.Any() ? _premHistory.Max(h => h.Premium) : 1;
                                }
                                @foreach (var h in _premHistory.OrderBy(h => h.Year))
                                {
                                    var pct = (double)h.Premium / (double)maxP * 100;
                                    var isCurrentCycle = h.Year == _premHistory.Max(x => x.Year);
                                    <div class="rd-bar-col">
                                        <div class="rd-bar-prem-lbl">@h.Premium.ToString("C0")</div>
                                        <div class="rd-bar-wrap">
                                            <div class="rd-bar-fill @(isCurrentCycle ? "rd-bar-current" : "")"
                                                 style="height:@pct.ToString("F0")%"></div>
                                        </div>
                                        <div class="rd-bar-year @(isCurrentCycle ? "rd-bar-year-cur" : "")">@h.Year</div>
                                        @if (h.CarrierChanged)
                                        {
                                            <div class="rd-bar-carrier-changed" title="Carrier changed this year">
                                                <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Premium history table -->
                        <SfGrid TValue="PremHistoryRow" DataSource="_premHistory" AllowSorting="true" EnableHover="true" RowHeight="54" CssClass="rd-data-grid">
                            <GridColumns>
                                <GridColumn Field="@nameof(PremHistoryRow.Year)"          HeaderText="Policy Year"  Width="120" />
                                <GridColumn Field="@nameof(PremHistoryRow.Carrier)"       HeaderText="Carrier"      Width="175" />
                                <GridColumn Field="@nameof(PremHistoryRow.Premium)"       HeaderText="Written Prem." Width="140" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var h = (PremHistoryRow)context; }<span class="pd-mono">@h.Premium.ToString("C2")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(PremHistoryRow.PremiumChange)" HeaderText="Change ($)"   Width="135" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>
                                        @{ var h = (PremHistoryRow)context; }
                                        <span class="pd-mono @(h.PremiumChange > 0 ? "pd-prem-up" : h.PremiumChange < 0 ? "pd-prem-dn" : "")">
                                            @(h.PremiumChange == 0 ? "—" : (h.PremiumChange > 0 ? "+" : "") + h.PremiumChange.ToString("C0"))
                                        </span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(PremHistoryRow.PremiumChangePct)" HeaderText="Change (%)" Width="125" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>
                                        @{ var h = (PremHistoryRow)context; }
                                        <span class="@(h.PremiumChangePct > 5 ? "pd-prem-up" : h.PremiumChangePct < 0 ? "pd-prem-dn" : "")">
                                            @(h.PremiumChangePct == 0 ? "—" : (h.PremiumChangePct > 0 ? "+" : "") + h.PremiumChangePct.ToString("F1") + "%")
                                        </span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(PremHistoryRow.LossRatio)"     HeaderText="Loss Ratio"  Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var h = (PremHistoryRow)context; }<span class="@(h.LossRatio >= 70 ? "pd-viol-warn" : h.LossRatio >= 40 ? "rd-lr-warn" : "")">@h.LossRatio.ToString("F1")%</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(PremHistoryRow.CarrierChanged)" HeaderText="Carrier Chg." Width="115" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                                    <Template>@{ var h = (PremHistoryRow)context; }<i class="bi @(h.CarrierChanged ? "bi-check-circle-fill pd-chk-yes" : "bi-dash")" aria-hidden="true"></i></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(PremHistoryRow.Notes)"         HeaderText="Notes"        MinWidth="180" />
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 3 ── CLAIMS / LOSSES ──────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Claims / Losses" IconCss="bi bi-exclamation-circle" /></ChildContent>
                <ContentTemplate>
                    <div class="rd-tab-body">
                        <!-- Loss summary KPIs -->
                        <div class="rd-loss-kpis">
                            <div class="rd-loss-kpi">
                                <div class="rd-lk-val">@_claims.Count</div>
                                <div class="rd-lk-lbl">Total Claims (5yr)</div>
                            </div>
                            <div class="rd-loss-kpi">
                                <div class="rd-lk-val rd-lk-open">@_claims.Count(c => c.Status == "Open")</div>
                                <div class="rd-lk-lbl">Open Claims</div>
                            </div>
                            <div class="rd-loss-kpi">
                                <div class="rd-lk-val rd-lk-prem">@_claims.Sum(c => c.TotalIncurred).ToString("C0")</div>
                                <div class="rd-lk-lbl">Total Incurred</div>
                            </div>
                            <div class="rd-loss-kpi">
                                <div class="rd-lk-val rd-lk-paid">@_claims.Sum(c => c.Paid).ToString("C0")</div>
                                <div class="rd-lk-lbl">Total Paid</div>
                            </div>
                            <div class="rd-loss-kpi">
                                <div class="rd-lk-val @(_renewal.LossRatio >= 70 ? "rd-lk-open" : _renewal.LossRatio >= 40 ? "rd-lk-warn" : "rd-lk-ok")">
                                    @_renewal.LossRatio.ToString("F1")%
                                </div>
                                <div class="rd-lk-lbl">Loss Ratio (current yr)</div>
                            </div>
                            <div class="rd-loss-kpi">
                                <div class="rd-lk-val">@_claims.Sum(c => c.Reserve).ToString("C0")</div>
                                <div class="rd-lk-lbl">Outstanding Reserve</div>
                            </div>
                        </div>

                        <SfGrid TValue="ClaimHistRow" DataSource="_claims"
                                AllowSorting="true" AllowFiltering="true" EnableHover="true" RowHeight="56" CssClass="rd-data-grid">
                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                            <GridColumns>
                                <GridColumn Field="@nameof(ClaimHistRow.ClaimNum)"    HeaderText="Claim #"      Width="140" />
                                <GridColumn Field="@nameof(ClaimHistRow.PolicyYear)"  HeaderText="Policy Yr."   Width="105" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" />
                                <GridColumn Field="@nameof(ClaimHistRow.LossDate)"    HeaderText="Loss Date"    Width="115">
                                    <Template>@{ var c = (ClaimHistRow)context; }<span class="pd-mono">@c.LossDate.ToString("MM/dd/yyyy")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(ClaimHistRow.LossType)"    HeaderText="Loss Type"    Width="155" />
                                <GridColumn Field="@nameof(ClaimHistRow.Description)" HeaderText="Description"  MinWidth="200" />
                                <GridColumn Field="@nameof(ClaimHistRow.Status)"      HeaderText="Status"       Width="110" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                                    <Template>@{ var c = (ClaimHistRow)context; }<span class="pd-claim-status pd-cs-@c.Status.ToLower()">@c.Status</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(ClaimHistRow.TotalIncurred)" HeaderText="Incurred"   Width="125" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (ClaimHistRow)context; }<span class="pd-mono">@c.TotalIncurred.ToString("C0")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(ClaimHistRow.Paid)"        HeaderText="Paid"         Width="115" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (ClaimHistRow)context; }<span class="pd-mono">@c.Paid.ToString("C0")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(ClaimHistRow.Reserve)"     HeaderText="Reserve"      Width="115" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>@{ var c = (ClaimHistRow)context; }<span class="pd-mono">@c.Reserve.ToString("C0")</span></Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 4 ── MARKETING ACTIONS ────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Marketing Actions" IconCss="bi bi-send" /></ChildContent>
                <ContentTemplate>
                    <div class="rd-tab-body">
                        <div class="rd-tab-toolbar">
                            <span class="rd-tab-count">
                                @_marketActions.Count market(s) contacted ·
                                @_marketActions.Count(m => m.Status == "Quoted") quoted
                            </span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="AddMarket">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Market
                            </button>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/quotes/compare/{_renewal.PolicyId}")'>
                                <i class="bi bi-layout-split" aria-hidden="true"></i> Compare Quotes
                            </button>
                        </div>
                        <SfGrid TValue="MarketActionRow" DataSource="_marketActions"
                                AllowSorting="true" EnableHover="true" RowHeight="58" CssClass="rd-data-grid">
                            <GridColumns>
                                <GridColumn Field="@nameof(MarketActionRow.Carrier)"       HeaderText="Carrier"         Width="175" />
                                <GridColumn Field="@nameof(MarketActionRow.Program)"       HeaderText="Program"         Width="165" />
                                <GridColumn Field="@nameof(MarketActionRow.ContactedDate)" HeaderText="Submitted"       Width="120">
                                    <Template>@{ var m = (MarketActionRow)context; }<span class="pd-mono">@(m.ContactedDate.HasValue ? m.ContactedDate.Value.ToString("MM/dd/yyyy") : "—")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(MarketActionRow.Status)"        HeaderText="Status"          Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                                    <Template>
                                        @{ var m = (MarketActionRow)context; }
                                        <span class="rd-mkt-status rd-mkt-@m.Status.ToLower().Replace(" ","")">@m.Status</span>
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(MarketActionRow.QuotedPremium)" HeaderText="Quoted Premium"  Width="145" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                    <Template>
                                        @{ var m = (MarketActionRow)context; }
                                        @if (m.QuotedPremium.HasValue)
                                        {
                                            <div class="rd-mkt-prem-cell">
                                                <span class="pd-mono">@m.QuotedPremium.Value.ToString("C0")</span>
                                                @{
                                                    var delta = m.QuotedPremium.Value - _renewal.CurrentPremium;
                                                }
                                                <span class="rd-mkt-delta @(delta > 0 ? "rdb-delta-up" : "rdb-delta-dn")">
                                                    @(delta >= 0 ? "+" : "")@delta.ToString("C0")
                                                </span>
                                            </div>
                                        }
                                        else { <span class="rdb-no-quote">—</span> }
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(MarketActionRow.QuoteExpiry)"   HeaderText="Quote Expires"   Width="130">
                                    <Template>@{ var m = (MarketActionRow)context; }<span class="pd-mono">@(m.QuoteExpiry.HasValue ? m.QuoteExpiry.Value.ToString("MM/dd/yyyy") : "—")</span></Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(MarketActionRow.Underwriter)"   HeaderText="Underwriter"     Width="145" />
                                <GridColumn Field="@nameof(MarketActionRow.Notes)"         HeaderText="Notes"           MinWidth="180" />
                                <GridColumn HeaderText="Action"                            Width="120" AllowSorting="false" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                                    <Template>
                                        @{ var m = (MarketActionRow)context; }
                                        @if (m.QuotedPremium.HasValue && m.Status == "Quoted")
                                        {
                                            <button class="um-btn um-btn-primary um-btn-xs" @onclick="() => SelectQuote(m)">
                                                <i class="bi bi-check-circle" aria-hidden="true"></i> Select
                                            </button>
                                        }
                                    </Template>
                                </GridColumn>
                            </GridColumns>
                        </SfGrid>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 5 ── RETENTION RISK ───────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Retention Risk" IconCss="bi bi-shield-exclamation" /></ChildContent>
                <ContentTemplate>
                    <div class="rd-tab-body">
                        <!-- Risk score overview -->
                        <div class="rd-risk-overview">
                            <div class="rd-risk-gauge rd-risk-gauge-@RiskCss(_renewal.RetentionRiskScore)">
                                <div class="rd-rg-val">@_renewal.RetentionRiskScore</div>
                                <div class="rd-rg-lbl">Retention Risk Score</div>
                                <div class="rd-rg-band">@RiskLabel(_renewal.RetentionRiskScore)</div>
                            </div>
                            <div class="rd-risk-summary">
                                <div class="rd-rs-title">Risk Assessment</div>
                                <div class="rd-rs-prob">
                                    Estimated Retention Probability:
                                    <strong class="@(RetentionProb >= 75 ? "rd-prob-high" : RetentionProb >= 50 ? "rd-prob-med" : "rd-prob-low")">
                                        @RetentionProb%
                                    </strong>
                                </div>
                                <div class="rd-rs-body">@_renewal.RiskAssessmentNotes</div>
                            </div>
                        </div>

                        <!-- Risk factor breakdown -->
                        <h3 class="rd-section-hdr">Risk Factor Breakdown</h3>
                        <div class="rd-risk-factors">
                            @foreach (var rf in _riskFactors)
                            {
                                <div class="rd-rf-card rd-rf-@rf.Impact.ToLower()">
                                    <div class="rd-rf-head">
                                        <i class="bi @rf.Icon rd-rf-icon" aria-hidden="true"></i>
                                        <div class="rd-rf-label">@rf.Factor</div>
                                        <span class="rd-rf-impact rd-rf-imp-@rf.Impact.ToLower()">@rf.Impact</span>
                                    </div>
                                    <div class="rd-rf-score-row">
                                        <div class="rd-rf-bar-wrap">
                                            <div class="rd-rf-bar rd-rf-@rf.Impact.ToLower()" style="width:@rf.Score%"></div>
                                        </div>
                                        <span class="rd-rf-score">@rf.Score/100</span>
                                    </div>
                                    <div class="rd-rf-detail">@rf.Detail</div>
                                </div>
                            }
                        </div>

                        <!-- Retention recommendations -->
                        <h3 class="rd-section-hdr">Recommended Retention Actions</h3>
                        <div class="rd-retention-actions">
                            @foreach (var ra in _retentionActions)
                            {
                                <div class="rd-ra-item @(ra.IsComplete ? "rd-ra-done" : ra.IsPriority ? "rd-ra-priority" : "")">
                                    <div class="rd-ra-checkbox">
                                        <SfCheckBox @bind-Checked="ra.IsComplete" />
                                    </div>
                                    <div class="rd-ra-body">
                                        <div class="rd-ra-title @(ra.IsComplete ? "rd-ra-title-done" : "")">
                                            @if (ra.IsPriority && !ra.IsComplete)
                                            {
                                                <i class="bi bi-star-fill rd-ra-priority-icon" aria-hidden="true"></i>
                                            }
                                            @ra.Action
                                        </div>
                                        <div class="rd-ra-meta">@ra.Owner · @ra.DueDesc</div>
                                    </div>
                                    <span class="rd-ra-type rd-ra-t-@ra.Type.ToLower().Replace(" ","")">@ra.Type</span>
                                </div>
                            }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 6 ── TASKS ────────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Tasks" IconCss="bi bi-list-check" /></ChildContent>
                <ContentTemplate>
                    <div class="rd-tab-body">
                        <div class="rd-tab-toolbar">
                            <span class="rd-tab-count">
                                @_tasks.Count(t => t.Complete)/@_tasks.Count complete ·
                                @{ var overdue = _tasks.Count(t => !t.Complete && t.IsDue); }
                                @if (overdue > 0) { <span class="rd-tc-warn">@overdue overdue</span> }
                            </span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="AddTask">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Task
                            </button>
                        </div>

                        <!-- Progress track -->
                        <div class="rd-task-progress">
                            <div class="rd-tp-label">Renewal Pipeline Progress</div>
                            <div class="rd-tp-bar-wrap">
                                <div class="rd-tp-bar"
                                     style="width:@(_tasks.Any() ? (_tasks.Count(t=>t.Complete)*100/_tasks.Count) : 0)%"></div>
                            </div>
                            <span class="rd-tp-pct">@(_tasks.Any() ? (_tasks.Count(t=>t.Complete)*100/_tasks.Count) : 0)%</span>
                        </div>

                        <div class="rd-task-list">
                            @foreach (var task in _tasks.OrderBy(t => t.SortOrder))
                            {
                                <div class="rd-task-item @(task.Complete ? "rd-task-done" : task.IsDue ? "rd-task-overdue" : "")">
                                    <div class="rd-task-check">
                                        <SfCheckBox @bind-Checked="task.Complete" />
                                    </div>
                                    <div class="rd-task-step">@task.SortOrder</div>
                                    <div class="rd-task-body">
                                        <div class="rd-task-title @(task.Complete ? "rd-task-title-done" : "")">@task.Title</div>
                                        <div class="rd-task-meta">
                                            <span>@task.Category</span>
                                            @if (task.DueDate.HasValue)
                                            {
                                                <span class="@(task.IsDue && !task.Complete ? "rd-tc-warn" : "")">
                                                    Due @task.DueDate.Value.ToString("MM/dd/yyyy")
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(task.AssignedTo)) { <span>@task.AssignedTo</span> }
                                        </div>
                                        @if (!string.IsNullOrEmpty(task.Notes))
                                        {
                                            <div class="rd-task-notes">@task.Notes</div>
                                        }
                                    </div>
                                    @if (task.IsDue && !task.Complete)
                                    {
                                        <span class="rd-task-due-badge">Overdue</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 7 ── COMMUNICATION LOG ────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Communication Log" IconCss="bi bi-envelope" /></ChildContent>
                <ContentTemplate>
                    <div class="rd-tab-body">
                        <div class="rd-tab-toolbar">
                            <span class="rd-tab-count">@_comms.Count message(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="NewMessage">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> New Message
                            </button>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="LogCall">
                                <i class="bi bi-telephone" aria-hidden="true"></i> Log Call
                            </button>
                        </div>
                        <div class="pd-timeline">
                            @foreach (var c in _comms.OrderByDescending(c => c.SentAt))
                            {
                                <div class="pd-tl-item">
                                    <div class="pd-tl-dot pd-tl-@c.Channel.ToLower()">
                                        <i class="bi @CommIcon(c.Channel)" aria-hidden="true"></i>
                                    </div>
                                    <div class="pd-tl-line"></div>
                                    <div class="pd-tl-body">
                                        <div class="pd-tl-header">
                                            <span class="pd-tl-title">@c.Subject</span>
                                            <span class="pd-comm-chip pd-comm-@c.Channel.ToLower()">@c.Channel</span>
                                            <span class="pd-dir-chip @(c.Direction=="Inbound"?"pd-dir-in":"pd-dir-out")">@c.Direction</span>
                                            <span class="pd-comm-status pd-cstat-@c.Status.ToLower()">@c.Status</span>
                                            <span class="pd-tl-date">@c.SentAt.ToString("MM/dd/yyyy hh:mm tt")</span>
                                        </div>
                                        <div class="pd-tl-meta">
                                            <span>From: @c.From</span>
                                            <span>To: @c.To</span>
                                            <span>by @c.CreatedBy</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(c.Notes))
                                        {
                                            <div class="pd-tl-notes">@c.Notes</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 8 ── QUOTE OPTIONS ────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Quote Options" IconCss="bi bi-quote" /></ChildContent>
                <ContentTemplate>
                    <div class="rd-tab-body">
                        <div class="rd-tab-toolbar">
                            <span class="rd-tab-count">@_quotes.Count(q => q.Status == "Quoted") quote(s) received</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/quotes/compare/{_renewal.PolicyId}")'>
                                <i class="bi bi-layout-split" aria-hidden="true"></i> Full Comparison
                            </button>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/quotes/proposal/{_renewal.PolicyId}")'>
                                <i class="bi bi-file-earmark-richtext" aria-hidden="true"></i> Build Proposal
                            </button>
                            <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => Nav.NavigateTo("/quotes/bind")'>
                                <i class="bi bi-shield-check" aria-hidden="true"></i> Bind
                            </button>
                        </div>

                        <!-- Quote cards -->
                        <div class="rd-quote-cards">
                            @foreach (var q in _quotes)
                            {
                                <div class="rd-quote-card @(q.IsRecommended ? "rd-qc-rec" : "") @(q.IsSelected ? "rd-qc-selected" : "")">
                                    @if (q.IsRecommended)
                                    {
                                        <div class="rd-qc-rec-badge">
                                            <i class="bi bi-trophy-fill" aria-hidden="true"></i> Recommended
                                        </div>
                                    }
                                    <div class="rd-qc-head">
                                        <div class="rd-qc-carrier">@q.Carrier</div>
                                        <span class="rd-mkt-status rd-mkt-@q.Status.ToLower().Replace(" ","")">@q.Status</span>
                                    </div>
                                    @if (q.QuotedPremium.HasValue)
                                    {
                                        <div class="rd-qc-prem">@q.QuotedPremium.Value.ToString("C0")</div>
                                        <div class="rd-qc-delta">
                                            @{
                                                var d = q.QuotedPremium.Value - _renewal.CurrentPremium;
                                            }
                                            <span class="@(d > 0 ? "rdb-delta-up" : "rdb-delta-dn")">
                                                @(d >= 0 ? "+" : "")@d.ToString("C0")
                                                (@(d >= 0 ? "+" : "")@((d / _renewal.CurrentPremium * 100).ToString("F1"))%)
                                            </span>
                                            vs. current
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rd-qc-prem rd-qc-pend">Pending</div>
                                    }
                                    <div class="rd-qc-meta">
                                        @if (!string.IsNullOrEmpty(q.QuoteNumber)) { <span>@q.QuoteNumber</span> }
                                        @if (q.ExpiryDate.HasValue) { <span>Exp @q.ExpiryDate.Value.ToString("MM/dd/yy")</span> }
                                    </div>
                                    <div class="rd-qc-chips">
                                        @foreach (var feat in q.Features) { <span class="rd-qc-feat">@feat</span> }
                                    </div>
                                    @if (!string.IsNullOrEmpty(q.Notes))
                                    {
                                        <div class="rd-qc-notes">@q.Notes</div>
                                    }
                                    <div class="rd-qc-actions">
                                        <button class="um-btn @(q.IsSelected ? "um-btn-success" : "um-btn-ghost") um-btn-sm"
                                                @onclick="() => SelectRenewalQuote(q)">
                                            <i class="bi @(q.IsSelected ? "bi-check-circle-fill" : "bi-circle")" aria-hidden="true"></i>
                                            @(q.IsSelected ? "Selected" : "Select")
                                        </button>
                                        <button class="um-btn um-btn-primary um-btn-sm"
                                                @onclick='() => Nav.NavigateTo("/quotes/bind")'>
                                            <i class="bi bi-shield-check" aria-hidden="true"></i> Bind
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

        </Tabs>
    </AppDetailTabs>
}

@code {
    [Parameter] public Guid RenewalId { get; set; }

    SfToast _toast = default!;

    bool _loading = true;
    int  _tab     = 0;

    // ── Data model ────────────────────────────────────────────────
