    async Task SelectQuote(MarketActionRow m)
    {
        await _toast.ShowAsync(new ToastModel
        {
            Title    = "Quote Selected",
            Content  = $"{m.Carrier} {m.QuotedPremium!.Value.ToString("C0")} selected for binding.",
            CssClass = "e-toast-success"
        });
    }

    void SelectRenewalQuote(QuoteOption q)
    {
        foreach (var x in _quotes) x.IsSelected = false;
        q.IsSelected = true;
    }

    // ── Helpers ───────────────────────────────────────────────────
    static string LobKey(string lob) => lob.ToLower()
        .Replace(" ","").Replace("/","").Replace("&","").Replace(".","").Replace("-","");

    static string LobIcon(string lob) => lob switch
    {
        "General Liability"   => "bi-shield-check",
        "Commercial Auto"     => "bi-truck",
        "Commercial Property" => "bi-building",
        "Workers Comp"        => "bi-person-fill-gear",
        "Umbrella"            => "bi-umbrella",
        "Professional Liab."  => "bi-briefcase",
        "Home/Dwelling"       => "bi-house",
        "Personal Auto"       => "bi-car-front",
        _                     => "bi-shield-half"
    };

    static string StageCss(string stage) => stage switch
    {
        "Not Started"  => "ns",
        "In Progress"  => "ip",
        "Quoted"       => "qt",
        "Renewed"      => "rn",
        "Lost"         => "lo",
        "Non-Renewed"  => "nr",
        _              => "ns"
    };

    static string RiskCss(int score)   => score >= 70 ? "high" : score >= 40 ? "med" : "low";
    static string RiskLabel(int score) => score >= 70 ? "High Risk" : score >= 40 ? "Moderate Risk" : "Low Risk";

    static string ExpChipCss(int days) =>
        days <= 0 ? "expired" : days <= 30 ? "exp30" : days <= 60 ? "exp60" : "normal";

    static string DaysLabel(int days) =>
        days <= 0   ? $"Expired {Math.Abs(days)}d ago" :
        days == 1   ? "1 day left" : $"{days} days left";

    static string CommIcon(string channel) => channel switch
    {
        "Email"  => "bi-envelope",
        "Phone"  => "bi-telephone",
        "SMS"    => "bi-chat-dots",
        "Letter" => "bi-file-text",
        "Portal" => "bi-browser-chrome",
        _        => "bi-chat"
    };

    // F() field row helper
    RenderFragment F(string label, string value) =>
        @<div class="rd-field-row">
            <span class="rd-field-lbl">@label</span>
            <span class="rd-field-val">@value</span>
        </div>;

    // KPI card helper
    RenderFragment RdKpi(string label, string val, string icon, string css) =>
        @<div class="rd-kpi-card @css">
            <i class="bi @icon rd-kpi-icon" aria-hidden="true"></i>
            <div>
                <div class="rd-kpi-val">@val</div>
                <div class="rd-kpi-lbl">@label</div>
            </div>
        </div>;
}
