@page "/billing/adjustments"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>Billing Adjustments</PageTitle>
<AppPageHeader Title="Billing Adjustments & Write-offs" Icon="bi-receipt-cutoff" />
<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(BillingAdjustmentDto.AdjustmentDate)"     HeaderText="Date"     Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(BillingAdjustmentDto.AdjustmentTypeCode)" HeaderText="Type"     Width="120"></GridColumn>
        <GridColumn Field="@nameof(BillingAdjustmentDto.Amount)"             HeaderText="Amount"   Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(BillingAdjustmentDto.Reason)"             HeaderText="Reason"   Width="280"></GridColumn>
        <GridColumn Field="@nameof(BillingAdjustmentDto.StatusCode)"         HeaderText="Status"   Width="110"></GridColumn>
        <GridColumn Field="@nameof(BillingAdjustmentDto.ApprovedDateUtc)"    HeaderText="Approved" Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private string? _loadError;
    private List<BillingAdjustmentDto>? _items;
    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            var result = await Api.SearchBillingAdjustmentsAsync(_tenantId, _searchTerm);
            _items = result?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = $"Billing adjustments failed to load: {ex.Message}";
            _items = [];
        }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
