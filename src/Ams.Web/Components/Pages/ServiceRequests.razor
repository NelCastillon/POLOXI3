@page "/ops/service-requests"
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Features.Operations

<PageTitle>Service Requests — Operations</PageTitle>
<AppPageHeader Title="Service Requests" Subtitle="Route and resolve client service requests by priority, type, and status" Icon="bi-tools"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New Request</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<div class="pc-kpi-strip"><div class="pc-kpi-card @(_filter == null ? "pc-kpi-card--active" : "")" @onclick="() => SetFilter(null)" title="All"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-tools"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total</div></div></div><div class="pc-kpi-card @(_filter == "High" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("High")' title="High priority"><span class="pc-kpi-icon pc-kpi-icon--danger"><i class="bi bi-exclamation-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.PriorityCode == "High")</div><div class="pc-kpi-label">High</div></div></div><div class="pc-kpi-card @(_filter == "Open" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Open")' title="Open"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-play-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Open")</div><div class="pc-kpi-label">Open</div></div></div></div>
<AppFilterPanel @bind-SearchValue="_searchTerm" OnSearch="OnSearchAsync" SearchPlaceholder="Search service requests…" />
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div> }
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }<SfGrid TValue="ServiceRequestDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52"><GridEvents TValue="ServiceRequestDto" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" /><GridColumns><GridColumn Field="RequestNumber" HeaderText="Request #" Width="140" /><GridColumn Field="RequestTypeCode" HeaderText="Type" Width="130" /><GridColumn Field="Subject" HeaderText="Subject" Width="280" /><GridColumn Field="PriorityCode" HeaderText="Priority" Width="110" /><GridColumn Field="StatusCode" HeaderText="Status" Width="120" /><GridColumn Field="ResolvedDate" HeaderText="Resolved" Type="ColumnType.Date" Format="d" Width="130" /></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="560px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm" /><DialogContent><div class="um-modal-header"><i class="bi bi-tools"></i><span>New Service Request</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Request # <span class="text-danger">*</span></label><InputText @bind-Value="_form.RequestNumber" class="um-input" /><ValidationMessage For="() => _form.RequestNumber" class="text-danger" /></div><div class="um-field"><label>Account Id <span class="text-danger">*</span></label><InputText @bind-Value="_form.AccountIdText" class="um-input" /><ValidationMessage For="() => _form.AccountIdText" class="text-danger" /></div><div class="um-field"><label>Type <span class="text-danger">*</span></label><InputText @bind-Value="_form.RequestTypeCode" class="um-input" /><ValidationMessage For="() => _form.RequestTypeCode" class="text-danger" /></div><div class="um-field"><label>Priority <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.PriorityCode" class="um-input"><option>Low</option><option>Medium</option><option>High</option></InputSelect><ValidationMessage For="() => _form.PriorityCode" class="text-danger" /></div><div class="um-field um-field--full"><label>Subject <span class="text-danger">*</span></label><InputText @bind-Value="_form.Subject" class="um-input" /><ValidationMessage For="() => _form.Subject" class="text-danger" /></div><div class="um-field um-field--full"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="3" /><ValidationMessage For="() => _form.Description" class="text-danger" /></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Create</button></div></EditForm></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" /><style>@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }</style>
@code { static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001"); string? _searchTerm, _loadError, _filter; bool _loading, _saving, _showForm; List<ServiceRequestDto> _items = [], _filtered = []; SfToast _toast = default!; RequestForm _form = new(); protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tasks & Workflows", "/tasks"), new("Service Requests", null)); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchServiceRequestsAsync(TenantId, searchTerm: _searchTerm); _items = result?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = $"Failed to load service requests: {ex.Message}"; } finally { _loading = false; } } Task OnSearchAsync() => LoadAsync(); void ApplyFilter() => _filtered = _filter switch { "High" => _items.Where(x => x.PriorityCode == "High").ToList(), "Open" => _items.Where(x => x.StatusCode == "Open").ToList(), _ => [.. _items] }; void SetFilter(string? f) { _filter = f; ApplyFilter(); } void OnRowSelected(RowSelectEventArgs<ServiceRequestDto> args) { } void OpenCreate() { _form = new() { RequestNumber = $"SR-{DateTime.UtcNow:yyyyMMddHHmmss}" }; _showForm = true; } async Task SaveAsync() { _saving = true; try { await Api.CreateServiceRequestAsync(new() { TenantId = TenantId, AccountId = Guid.Parse(_form.AccountIdText), RequestNumber = _form.RequestNumber, RequestTypeCode = _form.RequestTypeCode, Subject = _form.Subject, Description = _form.Description, PriorityCode = _form.PriorityCode }); _showForm = false; await _toast.ShowAsync(new() { Content = "Service request created", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } void ResetForm() => _form = new(); sealed class RequestForm { [Required, StringLength(50)] public string RequestNumber { get; set; } = string.Empty; [Required, RegularExpression("^[0-9a-fA-F-]{36}$", ErrorMessage = "Enter a valid Account Id.")] public string AccountIdText { get; set; } = string.Empty; [Required, StringLength(50)] public string RequestTypeCode { get; set; } = "Servicing"; [Required, StringLength(50)] public string PriorityCode { get; set; } = "Medium"; [Required, StringLength(200)] public string Subject { get; set; } = string.Empty; [StringLength(2000)] public string? Description { get; set; } } }
