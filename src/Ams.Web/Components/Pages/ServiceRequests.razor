@page "/ops/service-requests"
@inject ApiClient Api

<PageTitle>Service Requests</PageTitle>
<h1>Service Requests</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(ServiceRequestDto.RequestNumber)"   HeaderText="Request #"  Width="140"></GridColumn>
        <GridColumn Field="@nameof(ServiceRequestDto.RequestTypeCode)" HeaderText="Type"       Width="130"></GridColumn>
        <GridColumn Field="@nameof(ServiceRequestDto.Subject)"         HeaderText="Subject"    Width="280"></GridColumn>
        <GridColumn Field="@nameof(ServiceRequestDto.PriorityCode)"    HeaderText="Priority"   Width="110"></GridColumn>
        <GridColumn Field="@nameof(ServiceRequestDto.StatusCode)"      HeaderText="Status"     Width="120"></GridColumn>
        <GridColumn Field="@nameof(ServiceRequestDto.ResolvedDate)"    HeaderText="Resolved"   Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(ServiceRequestDto.CreatedDateUtc)"  HeaderText="Created"    Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
    </GridColumns>
</SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<ServiceRequestDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchServiceRequestsAsync(_tenantId, searchTerm: _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
