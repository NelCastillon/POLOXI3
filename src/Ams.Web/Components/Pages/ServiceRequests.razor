@page "/ops/service-requests"
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Operations

<PageTitle>Service Requests — Operations</PageTitle>
<AppPageHeader Title="Service Requests Administration" Subtitle="Tenant admin routing and resolution for client service requests by priority, type, status, and queue ownership" Icon="bi-tools"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New Request</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<section class="ma-hero twf-hero"><div><span class="ma-eyebrow">Tenant Administration · Service Requests</span><h2>Tenant Service Request Control Center</h2><p>Administer service intake, request type, priority, queue ownership, resolution status, and operational follow-through.</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/ops/issues")'><i class="bi bi-bug"></i> Issue Tracker</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/ops/activities")'><i class="bi bi-clock-history"></i> Activities</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/workflow")'><i class="bi bi-diagram-3"></i> Workflows</button></div></section>
<div class="pc-kpi-strip"><div class="pc-kpi-card @(_filter == null ? "pc-kpi-card--active" : "")" @onclick="() => SetFilter(null)" title="All"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-tools"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total</div></div></div><div class="pc-kpi-card @(_filter == "High" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("High")' title="High priority"><span class="pc-kpi-icon pc-kpi-icon--danger"><i class="bi bi-exclamation-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.PriorityCode == "High")</div><div class="pc-kpi-label">High</div></div></div><div class="pc-kpi-card @(_filter == "Open" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Open")' title="Open"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-play-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Open")</div><div class="pc-kpi-label">Open</div></div></div></div>
<AppFilterPanel @bind-SearchValue="_searchTerm" OnSearch="OnSearchAsync" SearchPlaceholder="Search service requests…" />
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div> }
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }<SfGrid TValue="ServiceRequestDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52"><GridEvents TValue="ServiceRequestDto" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" /><GridColumns><GridColumn Field="RequestNumber" HeaderText="Request #" Width="140" /><GridColumn Field="RequestTypeCode" HeaderText="Type" Width="130" /><GridColumn Field="Subject" HeaderText="Subject" Width="280" /><GridColumn Field="PriorityCode" HeaderText="Priority" Width="110" /><GridColumn Field="StatusCode" HeaderText="Status" Width="120" /><GridColumn Field="ResolvedDate" HeaderText="Resolved" Type="ColumnType.Date" Format="d" Width="130" /><GridColumn HeaderText="Actions" Width="120" TextAlign="TextAlign.Center"><Template>@{ var r = (ServiceRequestDto)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(r)" @onclick:stopPropagation="true" title="Edit"><i class="bi bi-pencil"></i></button><button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDelete(r)" @onclick:stopPropagation="true" title="Delete"><i class="bi bi-trash"></i></button></Template></GridColumn></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="560px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm" /><DialogContent><div class="um-modal-header"><i class="bi bi-tools"></i><span>@(_editId.HasValue ? "Edit Service Request" : "New Service Request")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div><EditForm @key="_form" Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="ShowValidation"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Request # <span class="text-danger">*</span></label><InputText @bind-Value="_form.RequestNumber" class="um-input" /><ValidationMessage For="() => _form.RequestNumber" class="text-danger" /></div><div class="um-field"><label>Account Name <span class="text-danger">*</span></label><SfDropDownList TValue="string" TItem="AccountOption" DataSource="_accounts" @bind-Value="_form.AccountIdText" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Search account name" CssClass="um-input"><DropDownListFieldSettings Value="Value" Text="Label" /></SfDropDownList>@if (_showValidation) { <ValidationMessage For="() => _form.AccountIdText" class="text-danger" /> }</div><div class="um-field"><label>Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.RequestTypeCode" class="um-input">@foreach (var type in _taskTypes.Where(x => x.IsActive)) { <option value="@type.TaskTypeCode">@type.TaskTypeName</option> }</InputSelect><ValidationMessage For="() => _form.RequestTypeCode" class="text-danger" /></div><div class="um-field"><label>Priority <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.PriorityCode" class="um-input"><option>Low</option><option>Medium</option><option>High</option></InputSelect><ValidationMessage For="() => _form.PriorityCode" class="text-danger" /></div><div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input"><option>Open</option><option>In Progress</option><option>Resolved</option><option>Closed</option></InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div><div class="um-field"><label>Resolved Date</label><InputDate @bind-Value="_form.ResolvedDate" class="um-input" /><ValidationMessage For="() => _form.ResolvedDate" class="text-danger" /></div><div class="um-field um-field--full"><label>Subject <span class="text-danger">*</span></label><InputText @bind-Value="_form.Subject" class="um-input" /><ValidationMessage For="() => _form.Subject" class="text-danger" /></div><div class="um-field um-field--full"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="3" /><ValidationMessage For="() => _form.Description" class="text-danger" /></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button></div></EditForm></DialogContent></SfDialog>
@if (_showDelete && _deleteTarget is not null) { <div class="mt-modal-backdrop" @onclick="() => _showDelete = false"><div class="um-confirm-dialog mt-confirm" @onclick:stopPropagation="true"><div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash"></i></div><div class="um-confirm-title">Delete service request?</div><div class="um-confirm-text">This will remove <strong>@_deleteTarget.Subject</strong>.</div><div class="um-modal-footer"><button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button><button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div></div></div> }
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" /><style>@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }</style>
@code { static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001"); static readonly Guid TenantAdminUserId = Guid.Parse("00000000-0000-0000-0000-000000000002"); string? _searchTerm, _loadError, _filter; bool _loading, _saving, _showForm, _showDelete, _showValidation; Guid? _editId; ServiceRequestDto? _deleteTarget; List<ServiceRequestDto> _items = [], _filtered = []; List<AccountOption> _accounts = []; List<TaskTypeDto> _taskTypes = []; SfToast _toast = default!; RequestForm _form = new(); [SupplyParameterFromQuery(Name = "new")] public bool OpenNew { get; set; } protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tasks & Workflows", "/tasks"), new("Service Requests", null)); await LoadAsync(); if (OpenNew) OpenCreate(); } async Task LoadAsync() { _loading = true; _loadError = null; try { await LoadAccountsAsync(); await LoadTaskTypesAsync(); var result = await Api.SearchServiceRequestsAsync(TenantId, searchTerm: _searchTerm); _items = result?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = $"Failed to load service requests: {ex.Message}"; } finally { _loading = false; } } Task OnSearchAsync() => LoadAsync(); void ApplyFilter() => _filtered = _filter switch { "High" => _items.Where(x => x.PriorityCode == "High").ToList(), "Open" => _items.Where(x => x.StatusCode == "Open").ToList(), _ => [.. _items] }; void SetFilter(string? f) { _filter = f; ApplyFilter(); } void OnRowSelected(RowSelectEventArgs<ServiceRequestDto> args) => OpenEdit(args.Data); void OpenCreate() { _editId = null; _showValidation = false; _form = new() { RequestNumber = $"SR-{DateTime.UtcNow:yyyyMMddHHmmss}", RequestTypeCode = GetDefaultTaskTypeCode("Service Request") }; _showForm = true; } void OpenEdit(ServiceRequestDto item) { _editId = item.ServiceRequestId; _showValidation = false; _form = new() { RequestNumber = item.RequestNumber, AccountIdText = item.AccountId.ToString(), RequestTypeCode = item.RequestTypeCode, PriorityCode = item.PriorityCode, StatusCode = item.StatusCode, ResolvedDate = item.ResolvedDate, Subject = item.Subject, Description = item.Description }; _showForm = true; } void ConfirmDelete(ServiceRequestDto item) { _deleteTarget = item; _showDelete = true; } async Task SaveAsync() { _showValidation = true; _saving = true; try { if (_editId.HasValue) await Api.UpdateServiceRequestAsync(_editId.Value, new() { AccountId = Guid.Parse(_form.AccountIdText), RequestNumber = _form.RequestNumber, RequestTypeCode = _form.RequestTypeCode, Subject = _form.Subject, Description = _form.Description, PriorityCode = _form.PriorityCode, StatusCode = _form.StatusCode, ResolvedDate = _form.ResolvedDate, ModifiedByUserId = TenantAdminUserId }); else await Api.CreateServiceRequestAsync(new() { TenantId = TenantId, AccountId = Guid.Parse(_form.AccountIdText), RequestNumber = _form.RequestNumber, RequestTypeCode = _form.RequestTypeCode, Subject = _form.Subject, Description = _form.Description, PriorityCode = _form.PriorityCode }); _showForm = false; await _toast.ShowAsync(new() { Content = _editId.HasValue ? "Service request updated" : "Service request created", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } async Task ExecuteDeleteAsync() { if (_deleteTarget is null) return; _saving = true; try { await Api.DeleteServiceRequestAsync(_deleteTarget.ServiceRequestId, TenantAdminUserId); _showDelete = false; await _toast.ShowAsync(new() { Content = "Service request deleted", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } void ResetForm() { _form = new(); _editId = null; _showValidation = false; } void ShowValidation() => _showValidation = true; async Task LoadAccountsAsync() { if (_accounts.Count > 0) return; var result = await Api.SearchAccountsAsync(TenantId); _accounts = (result?.Items ?? []).OrderBy(x => x.AccountName).Select(x => new AccountOption(x.AccountId.ToString(), x.AccountName)).ToList(); } async Task LoadTaskTypesAsync() { if (_taskTypes.Count > 0) return; var result = await Api.SearchTaskTypesAsync(TenantId, pageSize: 250); _taskTypes = (result?.Items ?? []).OrderBy(x => x.SortOrder).ThenBy(x => x.TaskTypeName).ToList(); } string GetDefaultTaskTypeCode(string defaultCode) => _taskTypes.FirstOrDefault(x => x.TaskTypeCode == defaultCode)?.TaskTypeCode ?? defaultCode; sealed record AccountOption(string Value, string Label); sealed class RequestForm { [Required, StringLength(50)] public string RequestNumber { get; set; } = string.Empty; [Required(ErrorMessage = "Select an account.")] public string AccountIdText { get; set; } = string.Empty; [Required, StringLength(50)] public string RequestTypeCode { get; set; } = "Service Request"; [Required, StringLength(50)] public string PriorityCode { get; set; } = "Medium"; [Required, StringLength(50)] public string StatusCode { get; set; } = "Open"; public DateOnly? ResolvedDate { get; set; } [Required, StringLength(200)] public string Subject { get; set; } = string.Empty; [StringLength(2000)] public string? Description { get; set; } } }
