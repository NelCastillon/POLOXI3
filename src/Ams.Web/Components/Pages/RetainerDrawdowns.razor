@page "/billing/retainer-drawdowns"
@inject ApiClient Api

<PageTitle>Retainer Drawdowns</PageTitle>
<h1>Retainer Drawdowns</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(RetainerDrawdownDto.DrawdownDate)"      HeaderText="Date"     Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(RetainerDrawdownDto.Amount)"            HeaderText="Amount"   Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(RetainerDrawdownDto.Description)"       HeaderText="Description" Width="300"></GridColumn>
        <GridColumn Field="@nameof(RetainerDrawdownDto.RetainerAccountId)" HeaderText="Retainer" Width="300"></GridColumn>
        <GridColumn Field="@nameof(RetainerDrawdownDto.CreatedDateUtc)"    HeaderText="Created"  Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<RetainerDrawdownDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchRetainerDrawdownsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
