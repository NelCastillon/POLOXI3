@page "/quotes/bind"
@page "/submissions/bind-requests"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Submissions
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Bind Request Command Center - AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4500" NewestOnTop="true" />

<div class="bc-page">
    <section class="bc-hero">
        <div class="bc-hero__content">
            <div class="bc-hero__eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> Bind request operations</div>
            <h1>Bind Request Command Center</h1>
            <p>Review DB-backed customer-authorized quotes, create auditable bind requests, track carrier responses, and create policies only after carrier Bound confirmation.</p>
            <div class="bc-hero__meta">
                <span><i class="bi bi-stack" aria-hidden="true"></i>@TotalCount queued</span>
                <span><i class="bi bi-check2-square" aria-hidden="true"></i>@SelectedCount selected</span>
                        <span><i class="bi bi-shield-check" aria-hidden="true"></i>@BoundCount bound policies</span>
                <span><i class="bi bi-cash-stack" aria-hidden="true"></i>@VisiblePremium.ToString("C0") visible premium</span>
            </div>
        </div>
        <div class="bc-hero__actions">
            <button type="button" class="bc-btn bc-btn--light" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "bc-spin" : null)" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="bc-btn bc-btn--light" @onclick="OpenQuotes"><i class="bi bi-file-text" aria-hidden="true"></i> Quotes</button>
            <button type="button" class="bc-btn bc-btn--light" @onclick="OpenPolicies"><i class="bi bi-journal-check" aria-hidden="true"></i> Policies</button>
            <button type="button" class="bc-btn bc-btn--primary" @onclick="OpenSubmissions"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i> Submissions</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger bc-alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="bind-kpi-strip" aria-label="Bind center KPIs">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" title="@metric.Tooltip" @onclick="() => SetKpiFilter(metric.Filter)">
                <span class="bind-kpi__icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span class="bind-kpi__body">
                    <span class="bind-kpi__val">@metric.Value</span>
                    <span class="bind-kpi__lbl">@metric.Label</span>
                    <small>@metric.Caption</small>
                </span>
            </button>
        }
    </section>

    <section class="bc-filter-panel" aria-label="Bind filters">
        <div class="bc-search-wrap">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input class="bc-search" @bind="SearchText" @bind:event="oninput" placeholder="Search account, submission, quote, carrier, LOB, producer, status..." />
        </div>
        <label class="bc-filter">
            <span>Status</span>
            <select class="bc-filter-sel" @bind="_statusFilter">
                <option value="">All statuses</option>
                @foreach (var status in StatusFilterOptions.Where(s => !string.IsNullOrWhiteSpace(s)))
                {
                    <option value="@status">@status</option>
                }
            </select>
        </label>
        <label class="bc-filter">
            <span>Line</span>
            <select class="bc-filter-sel" @bind="LineFilter">
                <option value="">All lines</option>
                @foreach (var line in LineOptions)
                {
                    <option value="@line">@line</option>
                }
            </select>
        </label>
        <button type="button" class="bc-clear-filter" @onclick="ClearFilters" disabled="@(!HasFilters)">
            <i class="bi bi-x-circle" aria-hidden="true"></i> Clear
        </button>
        <button type="button" class="bc-clear-filter" @onclick="ExportAsync" disabled="@(!FilteredRows.Any())">
            <i class="bi bi-download" aria-hidden="true"></i> Export
        </button>
        <div class="bc-result"><strong>@FilteredRows.Count()</strong><span>matches</span></div>
    </section>

    <section class="bc-view-tabs" aria-label="Bind dashboard views">
        <button type="button" class="@(ViewButtonClass("queue"))" @onclick='() => SetView("queue")'><i class="bi bi-table" aria-hidden="true"></i> Queue</button>
        <button type="button" class="@(ViewButtonClass("analytics"))" @onclick='() => SetView("analytics")'><i class="bi bi-bar-chart" aria-hidden="true"></i> Analytics</button>
        <button type="button" class="@(ViewButtonClass("workflow"))" @onclick='() => SetView("workflow")'><i class="bi bi-kanban" aria-hidden="true"></i> Workflow</button>
    </section>

    <section class="bc-layout">
        <main class="bc-main-card">
            @if (_loading)
            {
                <div class="bc-empty-state"><i class="bi bi-arrow-repeat bc-spin" aria-hidden="true"></i><strong>Loading bind queue...</strong></div>
            }
            else if (!FilteredRows.Any())
            {
                <div class="bc-empty-state">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <strong>No bind records match this view.</strong>
                    <span>Use DB-backed submissions and quotes to select a quote for binding.</span>
                    <button type="button" class="bc-btn bc-btn--primary" @onclick="OpenSubmissions"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i> Open Submissions</button>
                </div>
            }
            else if (_view == "analytics")
            {
                <div class="bc-analytics-grid">
                    <section>
                        <h3>Status mix</h3>
                        @foreach (var item in StatusBreakdown)
                        {
                            <button type="button" class="@BreakdownRowClass(item.Name, _statusFilter)" @onclick="() => SetStatusFilter(item.Name)">
                                <span>@item.Name</span>
                                <div><i style="width:@(item.WidthPercent.ToString("F0"))%"></i></div>
                                <strong>@item.Count</strong>
                            </button>
                        }
                    </section>
                    <section>
                        <h3>Line mix</h3>
                        @foreach (var item in LineBreakdown)
                        {
                            <button type="button" class="@BreakdownRowClass(item.Name, _lineFilter)" @onclick="() => _lineFilter = item.Name">
                                <span>@item.Name</span>
                                <div><i style="width:@(item.WidthPercent.ToString("F0"))%"></i></div>
                                <strong>@item.Count</strong>
                            </button>
                        }
                    </section>
                </div>
            }
            else if (_view == "workflow")
            {
                <div class="bc-workflow-board">
                    @foreach (var status in WorkflowStatuses)
                    {
                        var statusRows = FilteredRows.Where(r => string.Equals(r.DisplayStatus, status, StringComparison.OrdinalIgnoreCase)).ToList();
                        <section class="bc-workflow-col">
                            <header><strong>@status</strong><span>@statusRows.Count</span></header>
                            @foreach (var row in statusRows)
                            {
                                <article class="bc-workflow-card @(_selected?.RowId == row.RowId ? "bc-workflow-card--selected" : null)" @onclick="() => SelectRow(row)">
                                    <div><strong>@Display(row.AccountName)</strong><span>@Display(row.QuoteNumber)</span></div>
                                    <div><span>@Display(row.CarrierName)</span><span>@(row.AnnualPremium.ToString("C0"))</span></div>
                                    <small>@Display(row.LineOfBusiness) - @(row.EffectiveDate.ToString("MMM d, yyyy"))</small>
                                </article>
                            }
                        </section>
                    }
                </div>
            }
            else
            {
                <div class="bc-grid-wrap">
                    <table class="bc-table" aria-label="Bind queue">
                        <thead>
                            <tr>
                                <th>Account / Insured</th>
                                <th>Quote</th>
                                <th>Carrier</th>
                                <th>LOB</th>
                                <th class="bc-num">Premium</th>
                                <th>Effective</th>
                                <th>Quote Expires</th>
                                <th>Status</th>
                                <th>Producer</th>
                                <th>Audit</th>
                                <th class="bc-actions-col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in FilteredRows)
                            {
                                <tr class="bc-row @(_selected?.RowId == row.RowId ? "bc-row-selected" : null)" @onclick="() => SelectRow(row)" @ondblclick="() => OpenSubmission(row)">
                                    <td>
                                        <div class="bc-acct-cell">
                                            <div class="bc-acct-name">@Display(row.AccountName)</div>
                                            <div class="bc-acct-meta">@Display(row.SubmissionNumber)</div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="bc-quote-cell">
                                            <div class="bc-qno">@Display(row.QuoteNumber)</div>
                                            <div class="bc-uw">@Display(row.RecommendationReason)</div>
                                        </div>
                                    </td>
                                    <td>@Display(row.CarrierName)</td>
                                    <td>@LobChip(row.LineOfBusiness)</td>
                                    <td class="bc-num">@row.AnnualPremium.ToString("C0")</td>
                                    <td>@DateCell(row.EffectiveDate)</td>
                                    <td>@ExpiryCell(row)</td>
                                    <td>@StatusChip(row.DisplayStatus)</td>
                                    <td>@Display(row.ProducerName)</td>
                                    <td>@AuditCell(row)</td>
                                    <td class="bc-actions-col" @onclick:stopPropagation="true">@GridActions(row)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </main>

        <aside class="bc-detail-card" aria-label="Bind detail panel">
            @if (_selected is null)
            {
                <div class="bc-detail-empty"><i class="bi bi-clipboard-data" aria-hidden="true"></i><strong>Select a bind record</strong><span>Review quote details, bind readiness, and policy transaction audit from DB-backed data.</span></div>
            }
            else
            {
                <div class="bc-drawer-head">
                    <div>
                        <span class="bc-drawer-eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> Bind workflow</span>
                        <h2 class="bc-drawer-acct">@Display(_selected.AccountName)</h2>
                        <span class="bc-drawer-meta">@Display(_selected.SubmissionNumber) - @Display(_selected.QuoteNumber)</span>
                    </div>
                    @StatusChip(_selected.DisplayStatus)
                </div>
                <div class="bc-drawer-body">
                    <h3 class="bc-drawer-sec-head">Bind Details</h3>
                    @DrawRow("Submission", Display(_selected.SubmissionNumber))
                    @DrawRow("Quote", Display(_selected.QuoteNumber))
                    @DrawRow("Carrier", Display(_selected.CarrierName))
                    @DrawRow("Line of Business", Display(_selected.LineOfBusiness))
                    @DrawRow("Annual Premium", _selected.AnnualPremium.ToString("C0"))
                    @DrawRow("Effective", _selected.EffectiveDate.ToString("MM/dd/yyyy"))
                    @DrawRow("Expiration", _selected.ExpirationDate.ToString("MM/dd/yyyy"))
                    @DrawRow("Producer", Display(_selected.ProducerName))
                    @DrawRow("Quote expires", _selected.QuoteExpiresDateUtc.ToLocalTime().ToString("MM/dd/yyyy"))

                    <h3 class="bc-drawer-sec-head">Quote Intelligence</h3>
                    @DrawRow("Selected", _selected.IsSelected ? "Yes" : "No")
                    @DrawRow("Recommended", _selected.IsRecommended ? $"Yes ({_selected.RecommendationScore})" : "No")
                    @DrawRow("Deductible", _selected.Deductible?.ToString("C0") ?? "-")
                    @DrawRow("Limit", _selected.Limit?.ToString("C0") ?? "-")
                    @DrawRow("Commission", _selected.CommissionPercent?.ToString("0.##'%' ") ?? "-")
                    @DrawRow("Taxes and fees", _selected.TaxesAndFees?.ToString("C2") ?? "-")
                    @DrawRow("Broker fee", _selected.BrokerFee?.ToString("C2") ?? "-")
                    @DrawRow("Payment plan", Display(_selected.PaymentTerms))
                    @DrawRow("Minimum earned premium", _selected.MinimumEarnedPremium?.ToString("C2") ?? "-")
                    @if (!string.IsNullOrWhiteSpace(_selected.RecommendationReason))
                    {
                        <div class="bc-note-card"><span>Recommendation</span><strong>@_selected.RecommendationReason</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_selected.Subjectivities))
                    {
                        <div class="bc-note-card"><span>Subjectivities</span><strong>@_selected.Subjectivities</strong></div>
                    }

                    <h3 class="bc-drawer-sec-head">Bind Audit</h3>
                    @if (_selected.BindTransaction is null)
                    {
                        <div class="bc-note-card"><span>No bind transaction yet</span><strong>Bind this quote to create an auditable policy transaction.</strong></div>
                    }
                    else
                    {
                        @DrawRow("Bind status", Display(_selected.BindTransaction.BindStatusName))
                        @DrawRow("Policy", Display(_selected.BindTransaction.PolicyNumber))
                        @DrawRow("Source", Display(_selected.BindTransaction.PolicySourceName))
                        @DrawRow("Requested", _selected.BindTransaction.RequestedDateUtc.ToLocalTime().ToString("g"))
                        @if (_detailLoading)
                        {
                            <div class="bc-note-card"><span>Workflow</span><strong>Loading readiness and audit data...</strong></div>
                        }
                        else if (_bindDetail is not null)
                        {
                            @DrawRow("Binding method", Display(_bindDetail.Request.BindingMethodName))
                            @DrawRow("Binding authority", Display(_bindDetail.Request.BindingAuthorityName))
                            @DrawRow("Requested effective time", _bindDetail.Request.RequestedEffectiveTime?.ToString() ?? "-")
                            @DrawRow("Payment required", _bindDetail.Request.PaymentRequired ? "Yes" : "No")
                            @DrawRow("Payment verified", _bindDetail.Request.PaymentVerified ? "Yes" : "No")
                            @DrawRow("Response due", _bindDetail.Request.ResponseDueDateUtc?.ToLocalTime().ToString("g") ?? "-")
                            @if (!string.IsNullOrWhiteSpace(_bindDetail.Request.ProducerNotes))
                            {
                                <div class="bc-note-card"><span>Producer notes</span><strong>@_bindDetail.Request.ProducerNotes</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_bindDetail.Request.CarrierInstructions))
                            {
                                <div class="bc-note-card"><span>Carrier instructions</span><strong>@_bindDetail.Request.CarrierInstructions</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_bindDetail.Request.SpecialConditions))
                            {
                                <div class="bc-note-card"><span>Special conditions</span><strong>@_bindDetail.Request.SpecialConditions</strong></div>
                            }
                            @DrawRow("Blocking checks", _bindDetail.BlockingValidationCount.ToString())
                            <h3 class="bc-drawer-sec-head">Readiness Checks</h3>
                            @if (_bindDetail.Validations.Count == 0)
                            {
                                <div class="bc-note-card"><span>Not evaluated</span><strong>Run validation to evaluate DB-backed requirements.</strong></div>
                            }
                            @foreach (var validation in _bindDetail.Validations)
                            {
                                <div class="bc-note-card"><span>@validation.RequirementName</span><strong>@validation.StatusCode@if (!string.IsNullOrWhiteSpace(validation.Message)){<text> — @validation.Message</text>}</strong></div>
                            }
                            <h3 class="bc-drawer-sec-head">Approvals & Evidence</h3>
                            @foreach (var approval in _bindDetail.Approvals)
                            {
                                <div class="bc-note-card">
                                    <span>@Display(approval.ApprovalReasonName ?? approval.ApprovalReasonCode)</span>
                                    <strong>@approval.StatusCode · @approval.RequestedDateUtc.ToLocalTime().ToString("g")</strong>
                                    @if (approval.StatusCode == "Pending")
                                    {
                                        <div class="bc-inline-actions">
                                            <button type="button" class="bc-btn bc-btn--success bc-btn--sm" @onclick="@(async () => await ApproveAsync(approval.BindApprovalId))" disabled="@_detailBusy">Approve</button>
                                            <button type="button" class="bc-btn bc-btn--ghost bc-btn--sm" @onclick="@(async () => await RejectAsync(approval.BindApprovalId))" disabled="@_detailBusy">Reject</button>
                                        </div>
                                    }
                                </div>
                            }
                            @foreach (var document in _bindDetail.Documents)
                            {
                                <div class="bc-note-card"><span>@Display(document.DocumentRoleCode)</span><strong>@Display(document.FileName)</strong></div>
                            }
                            @foreach (var package in _bindDetail.Packages)
                            {
                                <div class="bc-note-card"><span>@package.PackageNumber</span><strong>@package.StatusCode · @package.DocumentCount documents · @package.PreparedDateUtc.ToLocalTime().ToString("g")</strong></div>
                            }
                            @foreach (var message in _bindDetail.CarrierMessages)
                            {
                                <div class="bc-note-card"><span>@message.DirectionCode · @Display(message.MessageTypeCode)</span><strong>@message.StatusCode · @message.SentReceivedDateUtc.ToLocalTime().ToString("g")@if (!string.IsNullOrWhiteSpace(message.MessageBody)){<text> — @message.MessageBody</text>}</strong></div>
                            }
                            @foreach (var history in _bindDetail.StatusHistory)
                            {
                                <div class="bc-note-card"><span>@Display(history.OldStatusCode) → @history.NewStatusCode</span><strong>@history.ChangedDateUtc.ToLocalTime().ToString("g") · @Display(history.ChangedByName)@if (!string.IsNullOrWhiteSpace(history.Comments)){<text> — @history.Comments</text>}</strong></div>
                            }
                            @if (_bindDetail.BinderReview is not null)
                            {
                                <h3 class="bc-drawer-sec-head">Carrier Binder Review</h3>
                                @DrawRow("Review status", _bindDetail.BinderReview.StatusCode)
                                @DrawRow("Verified policy number", Display(_bindDetail.BinderReview.PolicyNumber))
                                @DrawRow("Verified premium", _bindDetail.BinderReview.Premium.ToString("C2"))
                            }
                            @if (_bindDetail.PolicyGeneration is not null)
                            {
                                <h3 class="bc-drawer-sec-head">Policy Generation</h3>
                                @DrawRow("Generation status", _bindDetail.PolicyGeneration.StatusCode)
                                @DrawRow("Attempts", _bindDetail.PolicyGeneration.AttemptCount.ToString())
                                @if (!string.IsNullOrWhiteSpace(_bindDetail.PolicyGeneration.ErrorDetails))
                                {
                                    <div class="bc-note-card"><span>Generation error</span><strong>@_bindDetail.PolicyGeneration.ErrorDetails</strong></div>
                                }
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(_selected.BindTransaction.BindReason))
                        {
                            <div class="bc-note-card"><span>Bind reason</span><strong>@_selected.BindTransaction.BindReason</strong></div>
                        }
                    }

                    <div class="bc-drawer-actions">
                        <button type="button" class="bc-btn bc-btn--primary" @onclick="() => OpenBindDialogAsync(_selected)" disabled="@(_selected.BindTransaction is not null || IsBound(_selected))">
                            <i class="bi bi-shield-check" aria-hidden="true"></i> Create Bind Request
                        </button>
                        @if (_selected.BindTransaction is not null)
                        {
                            <button type="button" class="bc-btn bc-btn--ghost" @onclick="ValidateSelectedAsync" disabled="@_detailBusy"><i class="bi bi-clipboard-check"></i> Validate</button>
                            <button type="button" class="bc-btn bc-btn--ghost" @onclick='() => TransitionSelectedAsync("Ready")' disabled='@(_detailBusy || !CanTransition("Ready"))'><i class="bi bi-check2-circle"></i> Mark Ready</button>
                            <button type="button" class="bc-btn bc-btn--primary" @onclick='() => TransitionSelectedAsync("Submitted")' disabled='@(_detailBusy || !CanTransition("Submitted"))'><i class="bi bi-send"></i> Submit</button>
                            <button type="button" class="bc-btn bc-btn--ghost" @onclick="OpenApprovalDialog" disabled="@(_detailBusy || !CanRequestApproval)"><i class="bi bi-person-check"></i> Approval</button>
                            <button type="button" class="bc-btn bc-btn--ghost" @onclick="PrepareBinderPackageAsync" disabled="@(_detailBusy || !CanPrepareBinderPackage)"><i class="bi bi-file-earmark-zip"></i> Prepare Binder</button>
                            <button type="button" class="bc-btn bc-btn--success" @onclick="OpenCarrierResponseDialog" disabled="@(_detailBusy || !CarrierResponseTransitions.Any())"><i class="bi bi-broadcast"></i> Carrier Response</button>
                            @if (CanReviewCarrierBinder)
                            {
                                <button type="button" class="bc-btn bc-btn--success" @onclick="OpenBinderReviewDialog" disabled="@_detailBusy"><i class="bi bi-journal-check"></i> Accept Carrier Binder</button>
                            }
                        }

@if (_showBinderReviewDialog && _bindDetail is not null)
{
    <div class="rbd-backdrop"><div class="rbd-modal bc-review-modal" role="dialog" aria-modal="true">
        <div class="um-modal-header"><i class="bi bi-journal-check"></i><span>Accept Carrier Binder → Create Policy</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showBinderReviewDialog = false"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_binderReviewForm" OnValidSubmit="SaveBinderReviewAsync"><DataAnnotationsValidator /><ValidationSummary class="text-danger" />
            <div class="um-modal-body">
                <div class="bc-review-step"><strong>1. Verify binder terms</strong><span>Compare the authoritative carrier binder to the quoted and requested terms before acceptance.</span></div>
                <div class="um-form-grid">
                    <div><label>Policy Number</label><InputText class="form-control" @bind-Value="_binderReviewForm.PolicyNumber" /></div>
                    <div><label>Carrier</label><input class="form-control" value="@_bindDetail.Request.CarrierName" disabled /></div>
                    <div><label>Line of Business</label><InputText class="form-control" @bind-Value="_binderReviewForm.LineOfBusiness" /><ValidationMessage For="() => _binderReviewForm.LineOfBusiness" class="text-danger" /></div>
                    <div><label>Effective Date</label><InputDate class="form-control" @bind-Value="_binderReviewForm.EffectiveDate" /></div>
                    <div><label>Expiration Date</label><InputDate class="form-control" @bind-Value="_binderReviewForm.ExpirationDate" /></div>
                    <div><label>Premium</label><InputNumber class="form-control" @bind-Value="_binderReviewForm.Premium" /></div>
                    <div><label>Fees</label><InputNumber class="form-control" @bind-Value="_binderReviewForm.Fees" /></div>
                    <div><label>Taxes</label><InputNumber class="form-control" @bind-Value="_binderReviewForm.Taxes" /></div>
                    <div><label>Commission %</label><InputNumber class="form-control" @bind-Value="_binderReviewForm.CommissionPercent" /></div>
                    <div><label>Payment Plan</label><InputText class="form-control" @bind-Value="_binderReviewForm.PaymentPlan" /></div>
                    <div><label>Billing Type</label><InputText class="form-control" @bind-Value="_binderReviewForm.BillingTypeCode" /></div>
                    <div class="rbd-field--full"><label>Review Notes</label><InputTextArea class="form-control" rows="3" @bind-Value="_binderReviewForm.ReviewNotes" /></div>
                </div>
                <div class="bc-review-status"><span>Quoted → Binder premium</span><strong>@_bindDetail.Request.AnnualPremium.ToString("C2") → @_binderReviewForm.Premium.ToString("C2") (@((_binderReviewForm.Premium - _bindDetail.Request.AnnualPremium).ToString("+0.00;-0.00;0.00")))</strong></div>
                <div class="bc-review-status"><span>Requested → Binder term</span><strong>@_bindDetail.Request.EffectiveDate.ToString("MM/dd/yyyy")–@_bindDetail.Request.ExpirationDate.ToString("MM/dd/yyyy") → @_binderReviewForm.EffectiveDate.ToString("MM/dd/yyyy")–@_binderReviewForm.ExpirationDate.ToString("MM/dd/yyyy")</strong></div>
                <label class="bc-review-attestation"><InputCheckbox @bind-Value="_binderReviewAttested" /> I verified the carrier binder, attached evidence, coverage, dates, premium, taxes, fees, commission, and billing terms against authoritative AMS data.</label>
                <div class="bc-review-step"><strong>2. Record producer decision</strong><span>Save verified values, then accept, reject, or request correction. Only an accepted review can generate a policy.</span></div>
                @if (_bindDetail.BinderReview is not null)
                {
                    <div class="bc-review-status"><span>Current review</span><strong>@_bindDetail.BinderReview.StatusCode</strong></div>
                }
                @if (_bindDetail.PolicyGeneration is not null)
                {
                    <div class="bc-review-status"><span>Generation</span><strong>@_bindDetail.PolicyGeneration.StatusCode · @_bindDetail.PolicyGeneration.AttemptCount attempt(s)</strong></div>
                }
            </div>
            <div class="um-modal-footer bc-review-actions">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showBinderReviewDialog = false">Close</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_detailBusy">Save Verification</button>
                <button type="button" class="um-btn um-btn-ghost" @onclick='() => DecideBinderReviewAsync("CorrectionRequested")' disabled="@_detailBusy">Request Correction</button>
                <button type="button" class="um-btn um-btn-ghost" @onclick='() => DecideBinderReviewAsync("Rejected")' disabled="@_detailBusy">Reject</button>
                <button type="button" class="um-btn um-btn-success" @onclick='() => DecideBinderReviewAsync("Accepted")' disabled="@(_detailBusy || !_binderReviewAttested)">Accept Binder</button>
                <button type="button" class="um-btn um-btn-success" @onclick="QueuePolicyGenerationAsync" disabled="@(!CanGeneratePolicy || _detailBusy)"><i class="bi bi-gear"></i> @(_bindDetail.PolicyGeneration?.StatusCode == "Failed" ? "Retry Policy Generation" : "Generate Policy")</button>
                @if (_bindDetail.PolicyGeneration?.PolicyId is Guid generatedPolicyId)
                {
                    <button type="button" class="um-btn um-btn-primary" @onclick="() => OpenPolicy(generatedPolicyId)">Open Policy Workspace</button>
                }
            </div>
        </EditForm>
    </div></div>
}
