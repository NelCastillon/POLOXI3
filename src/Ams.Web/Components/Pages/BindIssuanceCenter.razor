    sealed class BindQueueRow
    {
        public Guid RowId { get; set; }
        public Guid SubmissionId { get; set; }
        public Guid TenantId { get; set; }
        public Guid AccountId { get; set; }
        public string AccountName { get; set; } = string.Empty;
        public string SubmissionNumber { get; set; } = string.Empty;
        public string LineOfBusiness { get; set; } = string.Empty;
        public string ProducerName { get; set; } = string.Empty;
        public DateTime EffectiveDate { get; set; }
        public DateTime ExpirationDate { get; set; }
        public Guid QuoteId { get; set; }
        public Guid CarrierId { get; set; }
        public string CarrierName { get; set; } = string.Empty;
        public string QuoteNumber { get; set; } = string.Empty;
        public string QuoteStatus { get; set; } = string.Empty;
        public decimal AnnualPremium { get; set; }
        public decimal? Deductible { get; set; }
        public decimal? Limit { get; set; }
        public decimal? CommissionPercent { get; set; }
        public string? Subjectivities { get; set; }
        public string? Exclusions { get; set; }
        public string? CarrierRating { get; set; }
        public string? PaymentTerms { get; set; }
        public decimal? MinimumEarnedPremium { get; set; }
        public decimal? TaxesAndFees { get; set; }
        public decimal? BrokerFee { get; set; }
        public bool? TriaIncluded { get; set; }
        public Guid? QuoteDocumentId { get; set; }
        public string? CoverageNotes { get; set; }
        public bool IsSelected { get; set; }
        public bool IsRecommended { get; set; }
        public int RecommendationScore { get; set; }
        public string? RecommendationReason { get; set; }
        public DateTime QuoteExpiresDateUtc { get; set; }
        public PolicyBindTransactionDto? BindTransaction { get; set; }
        public string? PolicyNumber => BindTransaction?.PolicyNumber;
        public string DisplayStatus => BindTransaction?.BindStatusName ?? QuoteStatus;

        public static BindQueueRow From(SubmissionDto submission, QuoteComparisonDto quote, PolicyBindTransactionDto? transaction) => new()
        {
            RowId = quote.QuoteId,
            SubmissionId = submission.SubmissionId,
            TenantId = submission.TenantId,
            AccountId = submission.AccountId,
            AccountName = submission.AccountName,
            SubmissionNumber = submission.SubmissionNumber,
            LineOfBusiness = submission.LineOfBusiness,
            ProducerName = submission.AssignedToUserName ?? string.Empty,
            EffectiveDate = submission.EffectiveDate,
            ExpirationDate = submission.ExpirationDate,
            QuoteId = quote.QuoteId,
            CarrierId = quote.CarrierId,
            CarrierName = quote.CarrierName,
            QuoteNumber = quote.QuoteNumber,
            QuoteStatus = quote.Status,
            AnnualPremium = quote.AnnualPremium,
            Deductible = quote.Deductible,
            Limit = quote.Limit,
            CommissionPercent = quote.CommissionPercent,
            Subjectivities = quote.Subjectivities,
            Exclusions = quote.Exclusions,
            CarrierRating = quote.CarrierRating,
            PaymentTerms = quote.PaymentTerms,
            MinimumEarnedPremium = quote.MinimumEarnedPremium,
            TaxesAndFees = quote.TaxesAndFees,
            BrokerFee = quote.BrokerFee,
            TriaIncluded = quote.TriaIncluded,
            QuoteDocumentId = quote.QuoteDocumentId,
            CoverageNotes = quote.CoverageNotes,
            IsSelected = quote.IsSelected,
            IsRecommended = quote.IsRecommended,
            RecommendationScore = quote.RecommendationScore,
            RecommendationReason = quote.RecommendationReason,
            QuoteExpiresDateUtc = quote.ExpiresDateUtc,
            BindTransaction = transaction
        };
    }

    sealed class BindForm : IValidatableObject
    {
        [StringLength(80)] public string? PolicyNumber { get; set; }
        [Required, StringLength(50)] public string PolicySourceCode { get; set; } = string.Empty;
        [Required, StringLength(50)] public string BindStatusCode { get; set; } = string.Empty;
        [Required, StringLength(50)] public string? CustomerAuthorizationMethodCode { get; set; }
        [StringLength(200)] public string? CustomerAuthorizationReference { get; set; }
        [StringLength(50)] public string? ConfirmationSourceCode { get; set; }
        [StringLength(120)] public string? CarrierReferenceNumber { get; set; }
        [StringLength(120)] public string? BinderNumber { get; set; }
        [Range(0.01, 999999999999)] public decimal AnnualPremium { get; set; }
        public decimal? DownPaymentAmount { get; set; }
        [Required] public DateTime EffectiveDate { get; set; }
        public string EffectiveTime { get; set; } = "00:01";
        [Required] public DateTime ExpirationDate { get; set; }
        [StringLength(200)] public string? UnderwriterName { get; set; }
        [StringLength(200)] public string? UnderwriterCompany { get; set; }
        [StringLength(2000)] public string? SubjectivitiesOutstanding { get; set; }
        [StringLength(2000)] public string? ConfirmationNotes { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
        public bool ConfirmationCertified { get; set; }
        public TimeSpan? RequestedEffectiveTime => TimeSpan.TryParse(EffectiveTime, out var value) ? value : null;

        public Func<string, bool> CreatesPolicyStatus { get; set; } = _ => false;

        public void Reset(BindQueueRow row, string sourceCode, string bindStatusCode, string? authorizationMethodCode, Func<string, bool>? createsPolicyStatus = null)
        {
            PolicyNumber = row.PolicyNumber;
            PolicySourceCode = sourceCode;
            BindStatusCode = bindStatusCode;
            CustomerAuthorizationMethodCode = authorizationMethodCode;
            CreatesPolicyStatus = createsPolicyStatus ?? (_ => false);
            CustomerAuthorizationReference = null;
            ConfirmationSourceCode = null;
            CarrierReferenceNumber = null;
            BinderNumber = null;
            AnnualPremium = row.AnnualPremium;
            DownPaymentAmount = null;
            EffectiveDate = row.EffectiveDate;
            EffectiveTime = "00:01";
            ExpirationDate = row.ExpirationDate;
            UnderwriterName = null;
            UnderwriterCompany = null;
            SubjectivitiesOutstanding = row.Subjectivities;
            ConfirmationNotes = null;
            Notes = row.Subjectivities;
            ConfirmationCertified = false;
        }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (ExpirationDate <= EffectiveDate)
                yield return new ValidationResult("Expiration date must be after effective date.", [nameof(ExpirationDate)]);

            if (!string.IsNullOrWhiteSpace(EffectiveTime) && RequestedEffectiveTime is null)
                yield return new ValidationResult("Effective time must be valid.", [nameof(EffectiveTime)]);

            if (CreatesPolicyStatus(BindStatusCode))
            {
                if (string.IsNullOrWhiteSpace(ConfirmationSourceCode))
                    yield return new ValidationResult("Confirmation method is required before marking the bind request Bound.", [nameof(ConfirmationSourceCode)]);

                if (!ConfirmationCertified)
                    yield return new ValidationResult("Carrier confirmation certification is required before marking the bind request Bound.", [nameof(ConfirmationCertified)]);

                if (string.IsNullOrWhiteSpace(CarrierReferenceNumber) && string.IsNullOrWhiteSpace(BinderNumber) && string.IsNullOrWhiteSpace(PolicyNumber))
                    yield return new ValidationResult("Enter a carrier confirmation number, binder number, or policy number before marking the bind request Bound.", [nameof(CarrierReferenceNumber)]);
            }
        }
    }
}
