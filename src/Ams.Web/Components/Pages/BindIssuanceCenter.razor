    sealed class CarrierResponseForm
    {
        [Required, StringLength(50)] public string StatusCode { get; set; } = string.Empty;
        [Required, StringLength(50)] public string MessageTypeCode { get; set; } = string.Empty;
        [StringLength(50)] public string? ConfirmationSourceCode { get; set; }
        [StringLength(120)] public string? CarrierReferenceNumber { get; set; }
        [StringLength(120)] public string? BinderNumber { get; set; }
        [Range(0.01, 999999999999)] public decimal? FinalPremium { get; set; }
        public Guid? ConfirmationDocumentId { get; set; }
        [StringLength(4000)] public string? MessageBody { get; set; }
        public bool ConfirmationCertified { get; set; }

        public void Reset(BindRequestDetailDto? detail, IEnumerable<SubmissionReferenceOptionDto> messageTypes, IEnumerable<SubmissionReferenceOptionDto> confirmationSources, IEnumerable<BindStatusTransitionDto> transitions)
        {
            StatusCode = transitions.FirstOrDefault()?.ToStatusCode ?? string.Empty;
            MessageTypeCode = messageTypes.FirstOrDefault()?.OptionCode ?? string.Empty;
            ConfirmationSourceCode = confirmationSources.FirstOrDefault()?.OptionCode;
            CarrierReferenceNumber = detail?.Request.CarrierReferenceNumber;
            BinderNumber = detail?.Request.BinderNumber;
            FinalPremium = detail?.Request.FinalPremium ?? detail?.Request.AnnualPremium;
            ConfirmationDocumentId = detail?.Request.ConfirmationDocumentId;
            MessageBody = null;
            ConfirmationCertified = false;
        }
    }

