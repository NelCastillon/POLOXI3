@page "/quotes/bind"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Submissions
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Bind Center - AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4500" NewestOnTop="true" />

<div class="bc-page">
    <section class="bc-hero">
        <div class="bc-hero__content">
            <div class="bc-hero__eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> Bind request operations</div>
            <h1>Bind Center</h1>
            <p>Review DB-backed customer-authorized quotes, create auditable bind requests, track carrier responses, and create policies only after carrier Bound confirmation.</p>
            <div class="bc-hero__meta">
                <span><i class="bi bi-stack" aria-hidden="true"></i>@TotalCount queued</span>
                <span><i class="bi bi-check2-square" aria-hidden="true"></i>@SelectedCount selected</span>
                        <span><i class="bi bi-shield-check" aria-hidden="true"></i>@BoundCount bound policies</span>
                <span><i class="bi bi-cash-stack" aria-hidden="true"></i>@VisiblePremium.ToString("C0") visible premium</span>
            </div>
        </div>
        <div class="bc-hero__actions">
            <button type="button" class="bc-btn bc-btn--light" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "bc-spin" : null)" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="bc-btn bc-btn--light" @onclick="OpenQuotes"><i class="bi bi-file-text" aria-hidden="true"></i> Quotes</button>
            <button type="button" class="bc-btn bc-btn--light" @onclick="OpenPolicies"><i class="bi bi-journal-check" aria-hidden="true"></i> Policies</button>
            <button type="button" class="bc-btn bc-btn--primary" @onclick="OpenSubmissions"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i> Submissions</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger bc-alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="bind-kpi-strip" aria-label="Bind center KPIs">
        @foreach (var metric in Metrics)
        {
            <button type="button" class="@MetricCardClass(metric)" title="@metric.Tooltip" @onclick="() => SetKpiFilter(metric.Filter)">
                <span class="bind-kpi__icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                <span class="bind-kpi__body">
                    <span class="bind-kpi__val">@metric.Value</span>
                    <span class="bind-kpi__lbl">@metric.Label</span>
                    <small>@metric.Caption</small>
                </span>
            </button>
        }
    </section>

    <section class="bc-filter-panel" aria-label="Bind filters">
        <div class="bc-search-wrap">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input class="bc-search" @bind="SearchText" @bind:event="oninput" placeholder="Search account, submission, quote, carrier, LOB, producer, status..." />
        </div>
        <label class="bc-filter">
            <span>Status</span>
            <select class="bc-filter-sel" @bind="_statusFilter">
                <option value="">All statuses</option>
                @foreach (var status in StatusFilterOptions.Where(s => !string.IsNullOrWhiteSpace(s)))
                {
                    <option value="@status">@status</option>
                }
            </select>
        </label>
        <label class="bc-filter">
            <span>Line</span>
            <select class="bc-filter-sel" @bind="LineFilter">
                <option value="">All lines</option>
                @foreach (var line in LineOptions)
                {
                    <option value="@line">@line</option>
                }
            </select>
        </label>
        <button type="button" class="bc-clear-filter" @onclick="ClearFilters" disabled="@(!HasFilters)">
            <i class="bi bi-x-circle" aria-hidden="true"></i> Clear
        </button>
        <button type="button" class="bc-clear-filter" @onclick="ExportAsync" disabled="@(!FilteredRows.Any())">
            <i class="bi bi-download" aria-hidden="true"></i> Export
        </button>
        <div class="bc-result"><strong>@FilteredRows.Count()</strong><span>matches</span></div>
    </section>

    <section class="bc-view-tabs" aria-label="Bind dashboard views">
        <button type="button" class="@(ViewButtonClass("queue"))" @onclick='() => SetView("queue")'><i class="bi bi-table" aria-hidden="true"></i> Queue</button>
        <button type="button" class="@(ViewButtonClass("analytics"))" @onclick='() => SetView("analytics")'><i class="bi bi-bar-chart" aria-hidden="true"></i> Analytics</button>
        <button type="button" class="@(ViewButtonClass("workflow"))" @onclick='() => SetView("workflow")'><i class="bi bi-kanban" aria-hidden="true"></i> Workflow</button>
    </section>

    <section class="bc-layout">
        <main class="bc-main-card">
            @if (_loading)
            {
                <div class="bc-empty-state"><i class="bi bi-arrow-repeat bc-spin" aria-hidden="true"></i><strong>Loading bind queue...</strong></div>
            }
            else if (!FilteredRows.Any())
            {
                <div class="bc-empty-state">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <strong>No bind records match this view.</strong>
                    <span>Use DB-backed submissions and quotes to select a quote for binding.</span>
                    <button type="button" class="bc-btn bc-btn--primary" @onclick="OpenSubmissions"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i> Open Submissions</button>
                </div>
            }
            else if (_view == "analytics")
            {
                <div class="bc-analytics-grid">
                    <section>
                        <h3>Status mix</h3>
                        @foreach (var item in StatusBreakdown)
                        {
                            <button type="button" class="@BreakdownRowClass(item.Name, _statusFilter)" @onclick="() => SetStatusFilter(item.Name)">
                                <span>@item.Name</span>
                                <div><i style="width:@(item.WidthPercent.ToString("F0"))%"></i></div>
                                <strong>@item.Count</strong>
                            </button>
                        }
                    </section>
                    <section>
                        <h3>Line mix</h3>
                        @foreach (var item in LineBreakdown)
                        {
                            <button type="button" class="@BreakdownRowClass(item.Name, _lineFilter)" @onclick="() => _lineFilter = item.Name">
                                <span>@item.Name</span>
                                <div><i style="width:@(item.WidthPercent.ToString("F0"))%"></i></div>
                                <strong>@item.Count</strong>
                            </button>
                        }
                    </section>
                </div>
            }
            else if (_view == "workflow")
            {
                <div class="bc-workflow-board">
                    @foreach (var status in WorkflowStatuses)
                    {
                        var statusRows = FilteredRows.Where(r => string.Equals(r.DisplayStatus, status, StringComparison.OrdinalIgnoreCase)).ToList();
                        <section class="bc-workflow-col">
                            <header><strong>@status</strong><span>@statusRows.Count</span></header>
                            @foreach (var row in statusRows)
                            {
                                <article class="bc-workflow-card @(_selected?.RowId == row.RowId ? "bc-workflow-card--selected" : null)" @onclick="() => SelectRow(row)">
                                    <div><strong>@Display(row.AccountName)</strong><span>@Display(row.QuoteNumber)</span></div>
                                    <div><span>@Display(row.CarrierName)</span><span>@(row.AnnualPremium.ToString("C0"))</span></div>
                                    <small>@Display(row.LineOfBusiness) - @(row.EffectiveDate.ToString("MMM d, yyyy"))</small>
                                </article>
                            }
                        </section>
                    }
                </div>
            }
            else
            {
                <div class="bc-grid-wrap">
                    <table class="bc-table" aria-label="Bind queue">
                        <thead>
                            <tr>
                                <th>Account / Insured</th>
                                <th>Quote</th>
                                <th>Carrier</th>
                                <th>LOB</th>
                                <th class="bc-num">Premium</th>
                                <th>Effective</th>
                                <th>Quote Expires</th>
                                <th>Status</th>
                                <th>Producer</th>
                                <th>Audit</th>
                                <th class="bc-actions-col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in FilteredRows)
                            {
                                <tr class="bc-row @(_selected?.RowId == row.RowId ? "bc-row-selected" : null)" @onclick="() => SelectRow(row)" @ondblclick="() => OpenSubmission(row)">
                                    <td>
                                        <div class="bc-acct-cell">
                                            <div class="bc-acct-name">@Display(row.AccountName)</div>
                                            <div class="bc-acct-meta">@Display(row.SubmissionNumber)</div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="bc-quote-cell">
                                            <div class="bc-qno">@Display(row.QuoteNumber)</div>
                                            <div class="bc-uw">@Display(row.RecommendationReason)</div>
                                        </div>
                                    </td>
                                    <td>@Display(row.CarrierName)</td>
                                    <td>@LobChip(row.LineOfBusiness)</td>
                                    <td class="bc-num">@row.AnnualPremium.ToString("C0")</td>
                                    <td>@DateCell(row.EffectiveDate)</td>
                                    <td>@ExpiryCell(row)</td>
                                    <td>@StatusChip(row.DisplayStatus)</td>
                                    <td>@Display(row.ProducerName)</td>
                                    <td>@AuditCell(row)</td>
                                    <td class="bc-actions-col" @onclick:stopPropagation="true">@GridActions(row)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </main>

        <aside class="bc-detail-card" aria-label="Bind detail panel">
            @if (_selected is null)
            {
                <div class="bc-detail-empty"><i class="bi bi-clipboard-data" aria-hidden="true"></i><strong>Select a bind record</strong><span>Review quote details, bind readiness, and policy transaction audit from DB-backed data.</span></div>
            }
            else
            {
                <div class="bc-drawer-head">
                    <div>
                        <span class="bc-drawer-eyebrow"><i class="bi bi-shield-check" aria-hidden="true"></i> Bind workflow</span>
                        <h2 class="bc-drawer-acct">@Display(_selected.AccountName)</h2>
                        <span class="bc-drawer-meta">@Display(_selected.SubmissionNumber) - @Display(_selected.QuoteNumber)</span>
                    </div>
                    @StatusChip(_selected.DisplayStatus)
                </div>
                <div class="bc-drawer-body">
                    <h3 class="bc-drawer-sec-head">Bind Details</h3>
                    @DrawRow("Submission", Display(_selected.SubmissionNumber))
                    @DrawRow("Quote", Display(_selected.QuoteNumber))
                    @DrawRow("Carrier", Display(_selected.CarrierName))
                    @DrawRow("Line of Business", Display(_selected.LineOfBusiness))
                    @DrawRow("Annual Premium", _selected.AnnualPremium.ToString("C0"))
                    @DrawRow("Effective", _selected.EffectiveDate.ToString("MM/dd/yyyy"))
                    @DrawRow("Expiration", _selected.ExpirationDate.ToString("MM/dd/yyyy"))
                    @DrawRow("Producer", Display(_selected.ProducerName))
                    @DrawRow("Quote expires", _selected.QuoteExpiresDateUtc.ToLocalTime().ToString("MM/dd/yyyy"))

                    <h3 class="bc-drawer-sec-head">Quote Intelligence</h3>
                    @DrawRow("Selected", _selected.IsSelected ? "Yes" : "No")
                    @DrawRow("Recommended", _selected.IsRecommended ? $"Yes ({_selected.RecommendationScore})" : "No")
                    @DrawRow("Deductible", _selected.Deductible?.ToString("C0") ?? "-")
                    @DrawRow("Limit", _selected.Limit?.ToString("C0") ?? "-")
                    @DrawRow("Commission", _selected.CommissionPercent?.ToString("0.##'%' ") ?? "-")
                    @if (!string.IsNullOrWhiteSpace(_selected.RecommendationReason))
                    {
                        <div class="bc-note-card"><span>Recommendation</span><strong>@_selected.RecommendationReason</strong></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_selected.Subjectivities))
                    {
                        <div class="bc-note-card"><span>Subjectivities</span><strong>@_selected.Subjectivities</strong></div>
                    }

                    <h3 class="bc-drawer-sec-head">Bind Audit</h3>
                    @if (_selected.BindTransaction is null)
                    {
                        <div class="bc-note-card"><span>No bind transaction yet</span><strong>Bind this quote to create an auditable policy transaction.</strong></div>
                    }
                    else
                    {
                        @DrawRow("Bind status", Display(_selected.BindTransaction.BindStatusName))
                        @DrawRow("Policy", Display(_selected.BindTransaction.PolicyNumber))
                        @DrawRow("Source", Display(_selected.BindTransaction.PolicySourceName))
                        @DrawRow("Requested", _selected.BindTransaction.RequestedDateUtc.ToLocalTime().ToString("g"))
                        @if (!string.IsNullOrWhiteSpace(_selected.BindTransaction.BindReason))
                        {
                            <div class="bc-note-card"><span>Bind reason</span><strong>@_selected.BindTransaction.BindReason</strong></div>
                        }
                    }

                    <div class="bc-drawer-actions">
                        <button type="button" class="bc-btn bc-btn--primary" @onclick="() => OpenBindDialog(_selected)" disabled="@IsBound(_selected)">
                            <i class="bi bi-shield-check" aria-hidden="true"></i> Record Bind Confirmation
                        </button>
                        <button type="button" class="bc-btn bc-btn--ghost" @onclick="() => SelectQuoteAsync(_selected)" disabled="@(_selected.IsSelected || IsBound(_selected))">
                            <i class="bi bi-check2-square" aria-hidden="true"></i> Select Quote
                        </button>
                        <button type="button" class="bc-btn bc-btn--ghost" @onclick="() => OpenSubmission(_selected)">
                            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Submission
                        </button>
                        @if (_selected.BindTransaction?.PolicyId is Guid policyId)
                        {
                            <button type="button" class="bc-btn bc-btn--success" @onclick="() => OpenPolicy(policyId)">
                                <i class="bi bi-journal-check" aria-hidden="true"></i> Policy
                            </button>
                        }
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@if (_showBindDialog && _bindTarget is not null)
{
    <div class="bc-stepper-backdrop" @onclick="CloseBindDialog"></div>
    <div class="bc-stepper-modal" role="dialog" aria-modal="true" aria-labelledby="bc-bind-title" @onclick:stopPropagation="true">
        <div class="bc-stepper-head">
                <div class="bc-stepper-title"><i class="bi bi-shield-check" aria-hidden="true"></i><span id="bc-bind-title">Bind Request</span></div>
            <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="CloseBindDialog" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <EditForm Model="_bindForm" OnValidSubmit="ExecuteBindAsync" OnInvalidSubmit="NotifyBindValidationAsync">
            <DataAnnotationsValidator />
            <div class="bc-stp-body">
                <div class="bc-stp-summary">
                    @BindSummaryRow("Account", Display(_bindTarget.AccountName))
                    @BindSummaryRow("Submission", Display(_bindTarget.SubmissionNumber))
                    @BindSummaryRow("Quote", Display(_bindTarget.QuoteNumber))
                    @BindSummaryRow("Carrier", Display(_bindTarget.CarrierName))
                    @BindSummaryRow("Premium", _bindTarget.AnnualPremium.ToString("C0"))
                    @BindSummaryRow("Effective", _bindTarget.EffectiveDate.ToString("MM/dd/yyyy"))
                </div>
                <div class="bc-stp-fields">
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Policy Source</label>
                        <InputSelect class="bc-input" @bind-Value="_bindForm.PolicySourceCode">
                            @foreach (var source in QuoteBoundSources)
                            {
                                <option value="@source.SourceCode">@source.SourceName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Authorization Method</label>
                        <InputSelect class="bc-input" @bind-Value="_bindForm.CustomerAuthorizationMethodCode">
                            <option value="">Select authorization method</option>
                            @foreach (var option in _customerAuthorizationMethods)
                            {
                                <option value="@option.OptionCode">@option.OptionName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Authorization Reference</label>
                        <InputText class="bc-input" @bind-Value="_bindForm.CustomerAuthorizationReference" placeholder="Email, call, portal, signature, or document reference" />
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Bind Status</label>
                        <InputSelect class="bc-input" @bind-Value="_bindForm.BindStatusCode">
                            @foreach (var status in BindStatusOptions)
                            {
                                <option value="@status.StatusCode">@status.StatusName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Confirmation Method</label>
                        <InputSelect class="bc-input" @bind-Value="_bindForm.ConfirmationSourceCode">
                            <option value="">Awaiting carrier confirmation</option>
                            @foreach (var option in _bindConfirmationSources)
                            {
                                <option value="@option.OptionCode">@option.OptionName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _bindForm.ConfirmationSourceCode" class="text-danger" />
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Carrier Confirmation Number</label>
                        <InputText class="bc-input" @bind-Value="_bindForm.CarrierReferenceNumber" placeholder="Carrier, MGA, wholesaler, or underwriter reference" />
                        <ValidationMessage For="() => _bindForm.CarrierReferenceNumber" class="text-danger" />
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Binder Number</label>
                        <InputText class="bc-input" @bind-Value="_bindForm.BinderNumber" placeholder="Binder or confirmation number" />
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Policy Number</label>
                        <InputText class="bc-input" @bind-Value="_bindForm.PolicyNumber" placeholder="Carrier policy number, if available" />
                        <ValidationMessage For="() => _bindForm.PolicyNumber" class="text-danger" />
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Final Premium</label>
                        <InputNumber class="bc-input" @bind-Value="_bindForm.AnnualPremium" />
                        <ValidationMessage For="() => _bindForm.AnnualPremium" class="text-danger" />
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Down Payment</label>
                        <InputNumber class="bc-input" @bind-Value="_bindForm.DownPaymentAmount" />
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Effective Date</label>
                        <InputDate class="bc-input" @bind-Value="_bindForm.EffectiveDate" />
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Effective Time</label>
                        <InputText type="time" class="bc-input" @bind-Value="_bindForm.EffectiveTime" />
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Expiration Date</label>
                        <InputDate class="bc-input" @bind-Value="_bindForm.ExpirationDate" />
                        <ValidationMessage For="() => _bindForm.ExpirationDate" class="text-danger" />
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Underwriter</label>
                        <InputText class="bc-input" @bind-Value="_bindForm.UnderwriterName" placeholder="Authorized underwriter name" />
                    </div>
                    <div class="bc-stp-field">
                        <label class="bc-stp-lbl">Underwriter Company</label>
                        <InputText class="bc-input" @bind-Value="_bindForm.UnderwriterCompany" placeholder="Carrier, MGA, or wholesaler" />
                    </div>
                    <div class="bc-stp-field bc-stp-field--full">
                        <label class="bc-stp-lbl">Outstanding Requirements</label>
                        <InputTextArea class="bc-input" rows="3" @bind-Value="_bindForm.SubjectivitiesOutstanding" placeholder="Remaining subjectivities, payment requirements, signed forms, or follow-up items" />
                    </div>
                    <div class="bc-stp-field bc-stp-field--full">
                        <label class="bc-stp-lbl">Bind Notes</label>
                        <InputTextArea class="bc-input" rows="4" @bind-Value="_bindForm.Notes" placeholder="Bind instructions, subjectivities, billing notes, or audit context" />
                        <ValidationMessage For="() => _bindForm.Notes" class="text-danger" />
                    </div>
                    <div class="bc-stp-field bc-stp-field--full">
                        <label class="bc-stp-lbl">Carrier Confirmation Notes</label>
                        <InputTextArea class="bc-input" rows="3" @bind-Value="_bindForm.ConfirmationNotes" placeholder="Evidence details, email message id, portal confirmation, phone call notes, or binder document reference" />
                    </div>
                    <div class="bc-stp-field bc-stp-field--full">
                        <label class="bc-certify">
                            <InputCheckbox @bind-Value="_bindForm.ConfirmationCertified" />
                            <span>I confirm that binding authority was received from the carrier, MGA, wholesaler, or authorized underwriter.</span>
                        </label>
                        <ValidationMessage For="() => _bindForm.ConfirmationCertified" class="text-danger" />
                    </div>
                </div>
                @if (!RequiredDocumentsSatisfied(_bindTarget))
                {
                    <div class="bc-stp-warn"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Required subjectivities or quote conditions are still present. Review before binding.</div>
                }
            </div>
            <div class="bc-stp-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CloseBindDialog" disabled="@_actionBusy">Cancel</button>
                <button type="submit" class="um-btn um-btn-success" disabled="@_actionBusy">
                    @if (_actionBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    <i class="bi bi-shield-check" aria-hidden="true"></i> Save Bind Request
                </button>
            </div>
        </EditForm>
    </div>
}

@code {
    EnterpriseToast? _toast;
    CurrentUserContextModel? _currentUser;
    bool _loading;
    bool _actionBusy;
    bool _showBindDialog;
    string? _loadError;
    string? _search;
    string _statusFilter = string.Empty;
    string _lineFilter = string.Empty;
    string _kpiFilter = string.Empty;
    string _view = "queue";
    BindQueueRow? _selected;
    BindQueueRow? _bindTarget;
    readonly BindForm _bindForm = new();
    readonly List<BindQueueRow> _rows = [];
    readonly List<PolicyCreationSourceDto> _policySources = [];
    readonly List<PolicyBindStatusDto> _bindStatuses = [];
    readonly List<SubmissionReferenceOptionDto> _customerAuthorizationMethods = [];
    readonly List<SubmissionReferenceOptionDto> _bindConfirmationSources = [];

    int TotalCount => _rows.Count;
    int SelectedCount => _rows.Count(r => r.IsSelected);
    int RecommendedCount => _rows.Count(r => r.IsRecommended);
    int BoundCount => _rows.Count(IsBound);
    int ExpiringCount => _rows.Count(IsExpiringSoon);
    decimal VisiblePremium => FilteredRows.Sum(x => x.AnnualPremium);
    IEnumerable<string> StatusFilterOptions => _rows.Select(r => r.DisplayStatus).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).Prepend(string.Empty);
    IEnumerable<string> LineOptions => _rows.Select(r => r.LineOfBusiness).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);
    IEnumerable<string> WorkflowStatuses => _rows.Select(r => r.DisplayStatus).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);
    IEnumerable<BreakdownItem> StatusBreakdown => BuildBreakdown(FilteredRows.Select(r => r.DisplayStatus));
    IEnumerable<BreakdownItem> LineBreakdown => BuildBreakdown(FilteredRows.Select(r => r.LineOfBusiness));
    IEnumerable<BindMetric> Metrics =>
    [
        new("blue", "all", "bi-stack", "Total Queue", TotalCount.ToString(), "All DB-backed quote records", "All DB-backed quote records in the bind queue"),
        new("cyan", "selected", "bi-check2-square", "Selected", SelectedCount.ToString(), "Quotes selected for bind", "Quotes selected for bind"),
        new("purple", "recommended", "bi-stars", "Recommended", RecommendedCount.ToString(), "Recommended carrier quotes", "Carrier quotes recommended by scoring"),
        new("green", "bound", "bi-shield-check", "Bound", BoundCount.ToString(), "Carrier-confirmed policies", "Rows where carrier confirmation created a policy"),
        new("amber", "expiring", "bi-calendar-event", "Expiring", ExpiringCount.ToString(), "Quotes expiring soon", "Visible quotes expiring soon"),
        new("slate", "premium", "bi-cash-stack", "Premium", VisiblePremium.ToString("C0"), "Visible annual premium", "Visible annual premium")
    ];
    IEnumerable<PolicyCreationSourceDto> QuoteBoundSources => _policySources.Where(x => x.IsActive && x.RequiresQuote).OrderBy(x => x.SortOrder).ThenBy(x => x.SourceName);
    IEnumerable<PolicyBindStatusDto> BindStatusOptions => _bindStatuses.Where(x => x.IsActive).OrderBy(x => x.SortOrder).ThenBy(x => x.StatusName);
    bool HasFilters => !string.IsNullOrWhiteSpace(_search) || !string.IsNullOrWhiteSpace(_statusFilter) || !string.IsNullOrWhiteSpace(_lineFilter) || !string.IsNullOrWhiteSpace(_kpiFilter);
    string? SearchText { get => _search; set => _search = value; }
    string LineFilter { get => _lineFilter; set => _lineFilter = value; }

    IEnumerable<BindQueueRow> FilteredRows => _rows
        .Where(MatchesKpi)
        .Where(r => string.IsNullOrWhiteSpace(_statusFilter) || string.Equals(r.DisplayStatus, _statusFilter, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrWhiteSpace(_lineFilter) || string.Equals(r.LineOfBusiness, _lineFilter, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrWhiteSpace(_search) || MatchesSearch(r, _search.Trim()))
        .OrderBy(r => r.DisplayStatus)
        .ThenBy(r => r.QuoteExpiresDateUtc)
        .ThenBy(r => r.AccountName);

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Submissions & Quotes", "/submissions"), new("Bind Center", "/quotes/bind"));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _currentUser ??= await CurrentUser.RequireAsync();
            var tenantId = _currentUser.TenantId;

            var submissionsResult = await Api.SearchSubmissionsAsync(tenantId, pageSize: 250);
            var submissions = (submissionsResult?.Items ?? []).Where(s => s.QuoteCount > 0).ToList();

            _policySources.Clear();
            _policySources.AddRange((await Api.GetPolicyCreationSourcesAsync(tenantId) ?? []).Where(s => s.IsActive).OrderBy(s => s.SortOrder).ThenBy(s => s.SourceName));

            _bindStatuses.Clear();
            _bindStatuses.AddRange((await Api.GetPolicyBindStatusesAsync(tenantId) ?? []).Where(s => s.IsActive).OrderBy(s => s.SortOrder).ThenBy(s => s.StatusName));

            _customerAuthorizationMethods.Clear();
            _customerAuthorizationMethods.AddRange((await Api.GetSubmissionReferenceOptionsAsync(tenantId, "CustomerAuthorizationMethod") ?? []).Where(o => o.IsActive).OrderBy(o => o.SortOrder).ThenBy(o => o.OptionName));

            _bindConfirmationSources.Clear();
            _bindConfirmationSources.AddRange((await Api.GetSubmissionReferenceOptionsAsync(tenantId, "BindConfirmationSource") ?? []).Where(o => o.IsActive).OrderBy(o => o.SortOrder).ThenBy(o => o.OptionName));

            _rows.Clear();
            foreach (var submission in submissions)
            {
                var quotes = await Api.GetSubmissionQuoteComparisonAsync(submission.SubmissionId) ?? [];
                var transactions = await Api.GetPolicyBindTransactionsAsync(submission.SubmissionId) ?? [];
                foreach (var quote in quotes.Where(IsQueueQuote))
                {
                    var transaction = transactions
                        .Where(t => t.QuoteId == quote.QuoteId)
                        .OrderByDescending(t => t.CreatedDateUtc)
                        .FirstOrDefault();

                    _rows.Add(BindQueueRow.From(submission, quote, transaction));
                }
            }

            _selected = _selected is null ? null : _rows.FirstOrDefault(r => r.RowId == _selected.RowId);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load bind center: {ex.Message}";
            await ShowToastAsync("Load failed", _loadError, "enterprise-toast-danger");
        }
        finally
        {
            _loading = false;
        }
    }

    static bool IsQueueQuote(QuoteComparisonDto quote) => quote.IsSelected || quote.IsRecommended || quote.AnnualPremium > 0 || !string.IsNullOrWhiteSpace(quote.Status);
    static bool MatchesSearch(BindQueueRow row, string term) => Contains(row.AccountName, term) || Contains(row.SubmissionNumber, term) || Contains(row.QuoteNumber, term) || Contains(row.CarrierName, term) || Contains(row.LineOfBusiness, term) || Contains(row.ProducerName, term) || Contains(row.DisplayStatus, term) || Contains(row.PolicyNumber, term);
    static bool Contains(string? source, string term) => !string.IsNullOrWhiteSpace(source) && source.Contains(term, StringComparison.OrdinalIgnoreCase);

    bool MatchesKpi(BindQueueRow row) => _kpiFilter switch
    {
        "selected" => row.IsSelected,
        "recommended" => row.IsRecommended,
        "bound" => IsBound(row),
        "expiring" => IsExpiringSoon(row),
        "premium" => row.AnnualPremium > 0,
        _ => true
    };

    static bool IsBound(BindQueueRow row) => row.BindTransaction?.PolicyId.HasValue == true;
    bool CreatesPolicyStatus(string statusCode) => _bindStatuses.Any(s => s.IsActive && s.CreatesPolicy && string.Equals(s.StatusCode, statusCode, StringComparison.OrdinalIgnoreCase));
    static bool IsManualConfirmationSource(string? sourceCode) => sourceCode is not null && (sourceCode.Equals("CarrierPortal", StringComparison.OrdinalIgnoreCase) || sourceCode.Equals("Email", StringComparison.OrdinalIgnoreCase) || sourceCode.Equals("Phone", StringComparison.OrdinalIgnoreCase) || sourceCode.Equals("BinderDocument", StringComparison.OrdinalIgnoreCase) || sourceCode.Equals("Manual", StringComparison.OrdinalIgnoreCase));
    static bool IsExpiringSoon(BindQueueRow row) => row.QuoteExpiresDateUtc.Date >= DateTime.UtcNow.Date && row.QuoteExpiresDateUtc.Date <= DateTime.UtcNow.Date.AddDays(14);
    static bool RequiredDocumentsSatisfied(BindQueueRow row) => string.IsNullOrWhiteSpace(row.Subjectivities);

    void SetStatusFilter(string status) => _statusFilter = status;
    void SetKpiFilter(string key) => _kpiFilter = _kpiFilter == key ? string.Empty : key;
    void SetView(string view) => _view = view;
    void ClearFilters() { _search = null; _statusFilter = string.Empty; _lineFilter = string.Empty; _kpiFilter = string.Empty; }
    void SelectRow(BindQueueRow row) => _selected = row;
    void CloseDrawer() => _selected = null;
    void OpenSubmissions() => Nav.NavigateTo("/submissions");
    void OpenQuotes() => Nav.NavigateTo("/submissions/quotes");
    void OpenPolicies() => Nav.NavigateTo("/policies");
    void OpenPolicy(Guid policyId) => Nav.NavigateTo($"/policies/{policyId}");
    void OpenSubmission(BindQueueRow row) => Nav.NavigateTo($"/submissions/{row.SubmissionId}");

    string MetricCardClass(BindMetric metric) => $"bind-kpi bind-kpi--{metric.Tone} {(_kpiFilter == metric.Filter || (metric.Filter == "all" && string.IsNullOrWhiteSpace(_kpiFilter)) ? "bind-kpi--active" : string.Empty)}";
    string ViewButtonClass(string view) => $"bc-view-btn {(_view == view ? "bc-view-btn--active" : string.Empty)}";
    static string BreakdownRowClass(string value, string currentFilter) => $"bc-breakdown-row {(string.Equals(value, currentFilter, StringComparison.OrdinalIgnoreCase) ? "bc-breakdown-row--active" : string.Empty)}";

    static IEnumerable<BreakdownItem> BuildBreakdown(IEnumerable<string> values)
    {
        var groups = values
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .GroupBy(v => v, StringComparer.OrdinalIgnoreCase)
            .Select(g => new { Name = g.First(), Count = g.Count() })
            .OrderByDescending(g => g.Count)
            .ThenBy(g => g.Name)
            .ToList();
        var max = groups.Count == 0 ? 1 : groups.Max(g => g.Count);
        return groups.Select(g => new BreakdownItem(g.Name, g.Count, max == 0 ? 0 : (decimal)g.Count / max * 100));
    }

    void OpenBindDialog(BindQueueRow row)
    {
        var source = QuoteBoundSources.FirstOrDefault();
        var status = BindStatusOptions.FirstOrDefault(s => s.IsDefault) ?? BindStatusOptions.FirstOrDefault(s => s.StatusCode == "Pending") ?? BindStatusOptions.FirstOrDefault();
        if (source is null || status is null)
        {
            _ = ShowToastAsync("Bind configuration missing", "No active DB-backed quote-bound policy source or creating bind status is configured.", "enterprise-toast-danger");
            return;
        }

        _bindTarget = row;
        var authorizationMethod = _customerAuthorizationMethods.FirstOrDefault(m => m.IsDefault) ?? _customerAuthorizationMethods.FirstOrDefault();
        _bindForm.Reset(row, source.SourceCode, status.StatusCode, authorizationMethod?.OptionCode, CreatesPolicyStatus);
        _showBindDialog = true;
    }

    void CloseBindDialog()
    {
        if (_actionBusy) return;
        _showBindDialog = false;
        _bindTarget = null;
    }

    async Task SelectQuoteAsync(BindQueueRow row)
    {
        if (_currentUser is null) return;
        _actionBusy = true;
        try
        {
            await Api.SelectSubmissionQuoteAsync(row.SubmissionId, new SelectSubmissionQuoteRequest(_currentUser.TenantId, row.QuoteId, true, $"Quote selected for bind from Bind Center: {row.QuoteNumber}.", _currentUser.UserId));
            await LoadAsync();
            await ShowToastAsync("Quote selected", $"{row.QuoteNumber} is now selected for bind.", "enterprise-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("Select failed", $"Quote selection failed: {ex.Message}", "enterprise-toast-danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    async Task ExecuteBindAsync()
    {
        if (_currentUser is null || _bindTarget is null) return;
        _actionBusy = true;
        try
        {
            var id = await Api.BindPolicyAsync(new BindPolicyRequest(
                SubmissionId: _bindTarget.SubmissionId,
                QuoteId: _bindTarget.QuoteId,
                TenantId: _currentUser.TenantId,
                AccountId: _bindTarget.AccountId,
                CarrierId: _bindTarget.CarrierId,
                AnnualPremium: _bindForm.AnnualPremium,
                EffectiveDate: _bindForm.EffectiveDate,
                ExpirationDate: _bindForm.ExpirationDate,
                PolicyNumber: _bindForm.PolicyNumber,
                PolicySourceCode: _bindForm.PolicySourceCode,
                PolicySourceReason: _bindForm.Notes,
                PolicySourceNotes: _bindForm.Notes,
                RequestedByUserId: _currentUser.UserId,
                ApprovedByUserId: _currentUser.UserId,
                BoundByUserId: CreatesPolicyStatus(_bindForm.BindStatusCode) ? _currentUser.UserId : null,
                BindStatusCode: _bindForm.BindStatusCode,
                CustomerAuthorizationMethodCode: _bindForm.CustomerAuthorizationMethodCode,
                CustomerAuthorizationReference: _bindForm.CustomerAuthorizationReference,
                CustomerAuthorizationNotes: _bindForm.Notes,
                CustomerAuthorizedDateUtc: DateTime.UtcNow,
                RequestedEffectiveTime: _bindForm.RequestedEffectiveTime,
                ConfirmationSourceCode: _bindForm.ConfirmationSourceCode,
                CarrierReferenceNumber: _bindForm.CarrierReferenceNumber,
                BinderNumber: _bindForm.BinderNumber,
                FinalPremium: _bindForm.AnnualPremium,
                DownPaymentAmount: _bindForm.DownPaymentAmount,
                SubjectivitiesOutstanding: _bindForm.SubjectivitiesOutstanding,
                ConfirmationNotes: _bindForm.ConfirmationNotes,
                UnderwriterName: _bindForm.UnderwriterName,
                UnderwriterCompany: _bindForm.UnderwriterCompany,
                FollowUpWrittenConfirmationRequired: string.Equals(_bindForm.ConfirmationSourceCode, "Phone", StringComparison.OrdinalIgnoreCase),
                ConfirmedManually: IsManualConfirmationSource(_bindForm.ConfirmationSourceCode),
                ConfirmationCertified: _bindForm.ConfirmationCertified));

            _showBindDialog = false;
            _bindTarget = null;
            await LoadAsync();
            var createsPolicy = CreatesPolicyStatus(_bindForm.BindStatusCode);
            await ShowToastAsync(createsPolicy ? "Policy created" : "Bind request saved", createsPolicy ? $"Policy {id} was created after carrier Bound confirmation." : $"Bind request {id} was saved for carrier response tracking.", "enterprise-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("Bind failed", $"Policy bind failed: {ex.Message}", "enterprise-toast-danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    Task NotifyBindValidationAsync() => ShowToastAsync("Validation", "Correct the highlighted bind fields before continuing.", "enterprise-toast-danger");
    Task ExportAsync() => ShowToastAsync("Export ready", $"{FilteredRows.Count()} bind queue item(s) are ready for export from the current filtered view.", "enterprise-toast-success");

    async Task ShowToastAsync(string title, string content, string cssClass)
    {
        if (_toast is not null)
        {
            await _toast.ShowAsync(new ToastModel { Title = title, Content = content, CssClass = cssClass });
        }
    }

    static string StatusCss(string s) => string.IsNullOrWhiteSpace(s) ? "bc-st-bi" : s.ToLowerInvariant() switch
    {
        var value when value.Contains("select") => "bc-st-qs",
        var value when value.Contains("pending") => "bc-st-pb",
        var value when value.Contains("bound") || value.Contains("issued") => "bc-st-is",
        var value when value.Contains("hold") => "bc-st-oh",
        var value when value.Contains("declin") || value.Contains("reject") || value.Contains("expire") => "bc-st-dc",
        _ => "bc-st-bi"
    };

    static string LobCss(string lob)
    {
        var normalized = lob.ToLowerInvariant();
        if (normalized.Contains("auto")) return "ca";
        if (normalized.Contains("property")) return "cp";
        if (normalized.Contains("worker")) return "wc";
        if (normalized.Contains("umbrella")) return "um";
        if (normalized.Contains("professional")) return "pl";
        return "gl";
    }

    static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    RenderFragment LobChip(string lob) => @<span class="bc-lob-chip bc-lob-@LobCss(lob)">@Display(lob)</span>;
    RenderFragment DateCell(DateTime date) => @<span class="bc-date">@date.ToString("MM/dd/yy")</span>;
    RenderFragment ExpiryCell(BindQueueRow row) => @<span class="bc-date @(IsExpiringSoon(row) ? "bc-expiring" : null)">@row.QuoteExpiresDateUtc.ToLocalTime().ToString("MM/dd/yy")</span>;
    RenderFragment StatusChip(string status) => @<span class="bc-status @StatusCss(status)">@Display(status)</span>;
    RenderFragment AuditCell(BindQueueRow row) => row.BindTransaction is null ? @<span class="bc-audit-muted">No bind</span> : @<span class="bc-audit-ok"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @Display(row.BindTransaction.BindStatusName)</span>;

    RenderFragment GridActions(BindQueueRow row) =>
        @<div class="bc-grid-actions">
            <button type="button" class="um-btn um-btn-primary um-btn-xs" title="Record bind confirmation" @onclick="() => OpenBindDialog(row)" disabled="@IsBound(row)"><i class="bi bi-shield-check" aria-hidden="true"></i></button>
            <button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Open submission" @onclick="() => OpenSubmission(row)"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></button>
        </div>;

    RenderFragment DrawRow(string label, string value) =>
        @<div class="bc-draw-row"><span class="bc-draw-lbl">@label</span><span class="bc-draw-val">@value</span></div>;

    RenderFragment BindSummaryRow(string label, string value) =>
        @<div class="bc-stp-sum-row"><span class="bc-stp-sum-lbl">@label</span><span class="bc-stp-sum-val">@value</span></div>;

