</div>

<RequestBindDialog Context="_requestBindContext"
                   OnCancelled="CloseRequestBindDialog"
                   OnCompleted="CompleteRequestBindAsync"
                   ContinueLabel="Return to Bind Center" />

@if (_showApprovalDialog && _bindDetail is not null)
{
    <div class="rbd-backdrop"><div class="rbd-modal" role="dialog" aria-modal="true">
        <div class="um-modal-header"><i class="bi bi-person-check"></i><span>Request Bind Approval</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showApprovalDialog = false"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_approvalForm" OnValidSubmit="RequestApprovalAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div><label>Approval Reason</label><InputSelect class="form-select" @bind-Value="_approvalForm.ApprovalReasonCode"><option value="">Select reason</option>@foreach (var reason in _bindDetail.ApprovalReasons){<option value="@reason.OptionCode">@reason.OptionName</option>}</InputSelect><ValidationMessage For="() => _approvalForm.ApprovalReasonCode" class="text-danger" /></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showApprovalDialog = false">Cancel</button><button type="submit" class="um-btn um-btn-success" disabled="@_detailBusy">Request Approval</button></div></EditForm>
    </div></div>
}

@if (_showCarrierResponseDialog)
{
    <div class="rbd-backdrop"><div class="rbd-modal" role="dialog" aria-modal="true">
        <div class="um-modal-header"><i class="bi bi-broadcast"></i><span>Record Carrier Response</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showCarrierResponseDialog = false"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_carrierResponseForm" OnValidSubmit="RecordCarrierResponseAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid">
            <div><label>Message Type</label><InputSelect class="form-select" @bind-Value="_carrierResponseForm.MessageTypeCode"><option value="">Select message type</option>@foreach (var type in _carrierMessageTypes){<option value="@type.OptionCode">@type.OptionName</option>}</InputSelect><ValidationMessage For="() => _carrierResponseForm.MessageTypeCode" class="text-danger" /></div>
            <div><label>Response Status</label><InputSelect class="form-select" @bind-Value="_carrierResponseForm.StatusCode"><option value="">Select status</option>@foreach (var transition in CarrierResponseTransitions){<option value="@transition.ToStatusCode">@BindStatusName(transition.ToStatusCode)</option>}</InputSelect><ValidationMessage For="() => _carrierResponseForm.StatusCode" class="text-danger" /></div>
            <div><label>Confirmation Source</label><InputSelect class="form-select" @bind-Value="_carrierResponseForm.ConfirmationSourceCode"><option value="">Select source</option>@foreach (var source in _bindConfirmationSources){<option value="@source.OptionCode">@source.OptionName</option>}</InputSelect><ValidationMessage For="() => _carrierResponseForm.ConfirmationSourceCode" class="text-danger" /></div>
            <div><label>Carrier Reference</label><InputText class="form-control" @bind-Value="_carrierResponseForm.CarrierReferenceNumber" /><ValidationMessage For="() => _carrierResponseForm.CarrierReferenceNumber" class="text-danger" /></div>
            <div><label>Binder Number</label><InputText class="form-control" @bind-Value="_carrierResponseForm.BinderNumber" /><ValidationMessage For="() => _carrierResponseForm.BinderNumber" class="text-danger" /></div>
            <div><label>Final Premium</label><InputNumber class="form-control" @bind-Value="_carrierResponseForm.FinalPremium" /><ValidationMessage For="() => _carrierResponseForm.FinalPremium" class="text-danger" /></div>
            <div><label>Confirmation Document</label><InputSelect class="form-select" @bind-Value="_carrierResponseForm.ConfirmationDocumentId"><option value="">Select document</option>@foreach (var document in _bindDetail?.Documents ?? []){<option value="@document.DocumentId">@Display(document.FileName)</option>}</InputSelect><ValidationMessage For="() => _carrierResponseForm.ConfirmationDocumentId" class="text-danger" /></div>
            <div class="rbd-field--full"><label>Carrier Message</label><InputTextArea class="form-control" rows="4" @bind-Value="_carrierResponseForm.MessageBody" /><ValidationMessage For="() => _carrierResponseForm.MessageBody" class="text-danger" /></div>
            <div class="rbd-field--full"><label><InputCheckbox @bind-Value="_carrierResponseForm.ConfirmationCertified" /> Carrier confirmation is authoritative and certified</label></div>
        </div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showCarrierResponseDialog = false">Cancel</button><button type="submit" class="um-btn um-btn-success" disabled="@_detailBusy">Record Response</button></div></EditForm>
    </div></div>
}

@code {
    [SupplyParameterFromQuery(Name = "submissionId")] public Guid? RequestedSubmissionId { get; set; }
    [SupplyParameterFromQuery(Name = "proposalId")] public Guid? RequestedProposalId { get; set; }
    [SupplyParameterFromQuery(Name = "quoteId")] public Guid? RequestedQuoteId { get; set; }
    [SupplyParameterFromQuery(Name = "authorizationId")] public Guid? RequestedAuthorizationId { get; set; }
    [SupplyParameterFromQuery(Name = "clientAcceptanceId")] public Guid? RequestedClientAcceptanceId { get; set; }
    EnterpriseToast? _toast;
    CurrentUserContextModel? _currentUser;
    bool _loading;
    bool _detailLoading;
    bool _detailBusy;
    bool _showApprovalDialog;
    bool _showCarrierResponseDialog;
    bool _showBinderReviewDialog;
    RequestBindDialogContext? _requestBindContext;
    BindRequestDetailDto? _bindDetail;
    readonly ApprovalForm _approvalForm = new();
    readonly CarrierResponseForm _carrierResponseForm = new();
    UpsertBinderReviewRequest _binderReviewForm = new();
    bool _binderReviewAttested;
    string? _loadError;
    string? _search;
    string _statusFilter = string.Empty;
    string _lineFilter = string.Empty;
    string _kpiFilter = string.Empty;
    string _view = "queue";
    BindQueueRow? _selected;
    readonly List<BindQueueRow> _rows = [];
    readonly List<PolicyCreationSourceDto> _policySources = [];
    readonly List<PolicyBindStatusDto> _bindStatuses = [];
    readonly List<SubmissionReferenceOptionDto> _customerAuthorizationMethods = [];
    readonly List<SubmissionReferenceOptionDto> _bindConfirmationSources = [];
    readonly List<SubmissionReferenceOptionDto> _bindingMethods = [];
    readonly List<SubmissionReferenceOptionDto> _bindingAuthorities = [];
    readonly List<SubmissionReferenceOptionDto> _carrierMessageTypes = [];

    int TotalCount => _rows.Count;
    int SelectedCount => _rows.Count(r => r.IsSelected);
    int RecommendedCount => _rows.Count(r => r.IsRecommended);
    int BoundCount => _rows.Count(IsBound);
    int ExpiringCount => _rows.Count(IsExpiringSoon);
    decimal VisiblePremium => FilteredRows.Sum(x => x.AnnualPremium);
    IEnumerable<string> StatusFilterOptions => _rows.Select(r => r.DisplayStatus).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).Prepend(string.Empty);
    IEnumerable<string> LineOptions => _rows.Select(r => r.LineOfBusiness).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);
    IEnumerable<string> WorkflowStatuses => _rows.Select(r => r.DisplayStatus).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);
    IEnumerable<BindStatusTransitionDto> CarrierResponseTransitions => _bindDetail?.AllowedTransitions.Where(x => x.RequiresCarrierResponse) ?? [];
    bool CanRequestApproval => _bindDetail is not null && _bindDetail.AllowedTransitions.Any(x => x.ToStatusCode == "PendingApproval") && !_bindDetail.Approvals.Any(x => x.StatusCode == "Pending");
    bool CanPrepareBinderPackage => _bindDetail?.IsReadyToSubmit == true;
    bool CanReviewCarrierBinder => _bindDetail?.Request.ConfirmationCertified == true && _bindDetail.Request.BindStatusCode is "BinderReceived" or "Approved" or "BinderAccepted" or "PolicyGenerationQueued" or "PolicyCreated";
    bool CanGeneratePolicy => _bindDetail?.BinderReview?.StatusCode is "Accepted" or "GenerationQueued" && (_bindDetail.PolicyGeneration is null || _bindDetail.PolicyGeneration.StatusCode == "Failed");
    IEnumerable<BreakdownItem> StatusBreakdown => BuildBreakdown(FilteredRows.Select(r => r.DisplayStatus));
    IEnumerable<BreakdownItem> LineBreakdown => BuildBreakdown(FilteredRows.Select(r => r.LineOfBusiness));
    IEnumerable<BindMetric> Metrics =>
    [
        new("blue", "all", "bi-stack", "Total Queue", TotalCount.ToString(), "All DB-backed quote records", "All DB-backed quote records in the bind queue"),
        new("cyan", "selected", "bi-check2-square", "Selected", SelectedCount.ToString(), "Quotes selected for bind", "Quotes selected for bind"),
        new("purple", "recommended", "bi-stars", "Recommended", RecommendedCount.ToString(), "Recommended carrier quotes", "Carrier quotes recommended by scoring"),
        new("green", "bound", "bi-shield-check", "Bound", BoundCount.ToString(), "Carrier-confirmed policies", "Rows where carrier confirmation created a policy"),
        new("amber", "expiring", "bi-calendar-event", "Expiring", ExpiringCount.ToString(), "Quotes expiring soon", "Visible quotes expiring soon"),
        new("slate", "premium", "bi-cash-stack", "Premium", VisiblePremium.ToString("C0"), "Visible annual premium", "Visible annual premium")
    ];
    IEnumerable<PolicyCreationSourceDto> QuoteBoundSources => _policySources.Where(x => x.IsActive && x.RequiresQuote).OrderBy(x => x.SortOrder).ThenBy(x => x.SourceName);
    IEnumerable<PolicyBindStatusDto> BindStatusOptions => _bindStatuses.Where(x => x.IsActive).OrderBy(x => x.SortOrder).ThenBy(x => x.StatusName);
    bool HasFilters => !string.IsNullOrWhiteSpace(_search) || !string.IsNullOrWhiteSpace(_statusFilter) || !string.IsNullOrWhiteSpace(_lineFilter) || !string.IsNullOrWhiteSpace(_kpiFilter);
    string? SearchText { get => _search; set => _search = value; }
    string LineFilter { get => _lineFilter; set => _lineFilter = value; }

    IEnumerable<BindQueueRow> FilteredRows => _rows
        .Where(MatchesKpi)
        .Where(r => string.IsNullOrWhiteSpace(_statusFilter) || string.Equals(r.DisplayStatus, _statusFilter, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrWhiteSpace(_lineFilter) || string.Equals(r.LineOfBusiness, _lineFilter, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrWhiteSpace(_search) || MatchesSearch(r, _search.Trim()))
        .OrderBy(r => r.DisplayStatus)
        .ThenBy(r => r.QuoteExpiresDateUtc)
        .ThenBy(r => r.AccountName);

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Submissions & Quotes", "/submissions"), new("Bind Request", "/submissions/bind-requests"));
        await LoadAsync();
        if (RequestedSubmissionId.HasValue && RequestedQuoteId.HasValue)
        {
            var requestedRow = _rows.FirstOrDefault(row => row.SubmissionId == RequestedSubmissionId.Value && row.QuoteId == RequestedQuoteId.Value);
            if (requestedRow is not null)
            {
                ClientAcceptanceDto? acceptance = null;
                if (RequestedClientAcceptanceId.HasValue && _currentUser is not null)
                {
                    acceptance = await Api.GetClientAcceptanceByIdAsync(RequestedClientAcceptanceId.Value, _currentUser.TenantId);
                    if (acceptance is null
                        || acceptance.SubmissionId != requestedRow.SubmissionId
                        || acceptance.QuoteId != requestedRow.QuoteId
                        || acceptance.ProposalId != RequestedProposalId
                        || acceptance.CustomerAuthorizationId != RequestedAuthorizationId
                        || acceptance.StatusCode is not ("Accepted" or "BindRequested"))
                    {
                        await ShowToastAsync("Bind authorization unavailable", "The persisted client acceptance no longer matches this proposal, quote, or customer authorization.", "enterprise-toast-danger");
                        return;
                    }
                }

                _selected = requestedRow;
                await OpenBindDialogAsync(requestedRow, RequestedProposalId, RequestedAuthorizationId, acceptance);
            }
        }
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _currentUser ??= await CurrentUser.RequireAsync();
            var tenantId = _currentUser.TenantId;

            var bindQueueTask = Api.GetBindQueueAsync(tenantId);
            var policySourcesTask = Api.GetPolicyCreationSourcesAsync(tenantId);
            var bindStatusesTask = Api.GetPolicyBindStatusesAsync(tenantId);
            var authorizationMethodsTask = Api.GetSubmissionReferenceOptionsAsync(tenantId, "CustomerAuthorizationMethod");
            var confirmationSourcesTask = Api.GetSubmissionReferenceOptionsAsync(tenantId, "BindConfirmationSource");
            var bindingMethodsTask = Api.GetSubmissionReferenceOptionsAsync(tenantId, "BindMethod");
            var bindingAuthoritiesTask = Api.GetSubmissionReferenceOptionsAsync(tenantId, "BindingAuthority");
            var carrierMessageTypesTask = Api.GetSubmissionReferenceOptionsAsync(tenantId, "BindCarrierMessageType");
            await Task.WhenAll(bindQueueTask, policySourcesTask, bindStatusesTask, authorizationMethodsTask, confirmationSourcesTask, bindingMethodsTask, bindingAuthoritiesTask, carrierMessageTypesTask);

            _policySources.Clear();
            _policySources.AddRange((await policySourcesTask ?? []).Where(s => s.IsActive).OrderBy(s => s.SortOrder).ThenBy(s => s.SourceName));

            _bindStatuses.Clear();
            _bindStatuses.AddRange((await bindStatusesTask ?? []).Where(s => s.IsActive).OrderBy(s => s.SortOrder).ThenBy(s => s.StatusName));

            _customerAuthorizationMethods.Clear();
            _customerAuthorizationMethods.AddRange((await authorizationMethodsTask ?? []).Where(o => o.IsActive).OrderBy(o => o.SortOrder).ThenBy(o => o.OptionName));

            _bindConfirmationSources.Clear();
            _bindConfirmationSources.AddRange((await confirmationSourcesTask ?? []).Where(o => o.IsActive).OrderBy(o => o.SortOrder).ThenBy(o => o.OptionName));

            _bindingMethods.Clear();
            _bindingMethods.AddRange((await bindingMethodsTask ?? []).Where(o => o.IsActive).OrderBy(o => o.SortOrder).ThenBy(o => o.OptionName));

            _bindingAuthorities.Clear();
            _bindingAuthorities.AddRange((await bindingAuthoritiesTask ?? []).Where(o => o.IsActive).OrderBy(o => o.SortOrder).ThenBy(o => o.OptionName));

            _carrierMessageTypes.Clear();
            _carrierMessageTypes.AddRange((await carrierMessageTypesTask ?? []).Where(o => o.IsActive).OrderBy(o => o.SortOrder).ThenBy(o => o.OptionName));

            _rows.Clear();
            _rows.AddRange((await bindQueueTask ?? []).Select(BindQueueRow.From));

            _selected = _selected is null ? null : _rows.FirstOrDefault(r => r.RowId == _selected.RowId);
            if (_selected?.BindTransaction?.PolicyBindTransactionId is Guid bindRequestId)
                await LoadBindDetailAsync(bindRequestId);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load bind center: {ex.Message}";
            await ShowToastAsync("Load failed", _loadError, "enterprise-toast-danger");
        }
        finally
        {
            _loading = false;
        }
    }

    static bool MatchesSearch(BindQueueRow row, string term) => Contains(row.AccountName, term) || Contains(row.SubmissionNumber, term) || Contains(row.QuoteNumber, term) || Contains(row.CarrierName, term) || Contains(row.LineOfBusiness, term) || Contains(row.ProducerName, term) || Contains(row.DisplayStatus, term) || Contains(row.PolicyNumber, term);
    static bool Contains(string? source, string term) => !string.IsNullOrWhiteSpace(source) && source.Contains(term, StringComparison.OrdinalIgnoreCase);

    bool MatchesKpi(BindQueueRow row) => _kpiFilter switch
    {
        "selected" => row.IsSelected,
        "recommended" => row.IsRecommended,
        "bound" => IsBound(row),
        "expiring" => IsExpiringSoon(row),
        "premium" => row.AnnualPremium > 0,
        _ => true
    };

    static bool IsBound(BindQueueRow row) => row.BindTransaction?.PolicyId.HasValue == true;
    bool CreatesPolicyStatus(string statusCode) => _bindStatuses.Any(s => s.IsActive && s.CreatesPolicy && string.Equals(s.StatusCode, statusCode, StringComparison.OrdinalIgnoreCase));
    static bool IsManualConfirmationSource(string? sourceCode) => sourceCode is not null && (sourceCode.Equals("CarrierPortal", StringComparison.OrdinalIgnoreCase) || sourceCode.Equals("Email", StringComparison.OrdinalIgnoreCase) || sourceCode.Equals("Phone", StringComparison.OrdinalIgnoreCase) || sourceCode.Equals("BinderDocument", StringComparison.OrdinalIgnoreCase) || sourceCode.Equals("Manual", StringComparison.OrdinalIgnoreCase));
    static bool IsExpiringSoon(BindQueueRow row) => row.QuoteExpiresDateUtc.Date >= DateTime.UtcNow.Date && row.QuoteExpiresDateUtc.Date <= DateTime.UtcNow.Date.AddDays(14);
    static bool RequiredDocumentsSatisfied(BindQueueRow row) => string.IsNullOrWhiteSpace(row.Subjectivities);

    void SetStatusFilter(string status) => _statusFilter = status;
    void SetKpiFilter(string key) => _kpiFilter = _kpiFilter == key ? string.Empty : key;
    void SetView(string view) => _view = view;
    void ClearFilters() { _search = null; _statusFilter = string.Empty; _lineFilter = string.Empty; _kpiFilter = string.Empty; }
    async Task SelectRow(BindQueueRow row)
    {
        _selected = row;
        _bindDetail = null;
        if (row.BindTransaction?.PolicyBindTransactionId is Guid bindRequestId)
            await LoadBindDetailAsync(bindRequestId);
    }
    void CloseDrawer() { _selected = null; _bindDetail = null; }
    void OpenSubmissions() => Nav.NavigateTo("/submissions");
    void OpenQuotes() => Nav.NavigateTo("/submissions/quotes");
    void OpenPolicies() => Nav.NavigateTo("/policies");
    void OpenPolicy(Guid policyId) => Nav.NavigateTo($"/policies/{policyId}");
    void OpenSubmission(BindQueueRow row) => Nav.NavigateTo($"/submissions/{row.SubmissionId}");

    async Task LoadBindDetailAsync(Guid bindRequestId)
    {
        if (_currentUser is null) return;
        _detailLoading = true;
        try
        {
            _bindDetail = await Api.GetBindRequestDetailAsync(bindRequestId, _currentUser.TenantId);
        }
        catch (Exception ex)
        {
            await ShowToastAsync("Bind detail failed", $"Bind detail failed: {ex.Message}", "enterprise-toast-danger");
        }
        finally
        {
            _detailLoading = false;
        }
    }

    async Task ValidateSelectedAsync()
    {
        if (_currentUser is null || _selected?.BindTransaction?.PolicyBindTransactionId is not Guid bindRequestId) return;
        _detailBusy = true;
        try
        {
            await Api.ValidateBindRequestAsync(bindRequestId, new ValidateBindRequestRequest(_currentUser.TenantId, _currentUser.UserId));
            await LoadBindDetailAsync(bindRequestId);
            await ShowToastAsync("Validation completed", "The bind request readiness snapshot was refreshed from authoritative data.", "enterprise-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("Validation failed", $"Validation failed: {ex.Message}", "enterprise-toast-danger");
        }
        finally { _detailBusy = false; }
    }

    Task ApproveAsync(Guid approvalId) => DecideApprovalAsync(approvalId, "Approved");
    Task RejectAsync(Guid approvalId) => DecideApprovalAsync(approvalId, "Rejected");

    async Task DecideApprovalAsync(Guid approvalId, string decisionCode)
    {
        if (_currentUser is null || _selected?.BindTransaction?.PolicyBindTransactionId is not Guid bindRequestId) return;
        _detailBusy = true;
        try
        {
            await Api.DecideBindApprovalAsync(bindRequestId, approvalId, new DecideBindApprovalRequest(_currentUser.TenantId, decisionCode, $"{decisionCode} from the Bind Request Command Center.", _currentUser.UserId));
            await LoadAsync();
            await ShowToastAsync("Approval updated", $"The bind approval was {decisionCode.ToLowerInvariant()}.", "enterprise-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("Approval decision failed", $"Approval decision failed: {ex.Message}", "enterprise-toast-danger");
        }
        finally { _detailBusy = false; }
    }

    async Task PrepareBinderPackageAsync()
    {
        if (_currentUser is null || _selected?.BindTransaction?.PolicyBindTransactionId is not Guid bindRequestId) return;
        _detailBusy = true;
        try
        {
            var package = await Api.PrepareBindPackageAsync(bindRequestId, new PrepareBindPackageRequest(_currentUser.TenantId, "Prepared from the Bind Request Command Center.", _currentUser.UserId));
            await LoadBindDetailAsync(bindRequestId);
            await ShowToastAsync("Binder package prepared", $"{package.PackageNumber} contains {package.DocumentCount} linked documents.", "enterprise-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("Binder package failed", $"Binder package failed: {ex.Message}", "enterprise-toast-danger");
        }
        finally { _detailBusy = false; }
    }

    async Task TransitionSelectedAsync(string statusCode)
    {
        if (_currentUser is null || _selected?.BindTransaction?.PolicyBindTransactionId is not Guid bindRequestId) return;
        _detailBusy = true;
        try
        {
            await Api.UpdateBindRequestStatusAsync(bindRequestId, new UpdateBindRequestStatusRequest(_currentUser.TenantId, statusCode, $"Bind request moved to {statusCode} from the command center.", _currentUser.UserId));
            await LoadAsync();
            await ShowToastAsync("Bind request updated", $"Bind request status is now {statusCode}.", "enterprise-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("Status update failed", $"Status update failed: {ex.Message}", "enterprise-toast-danger");
        }
        finally { _detailBusy = false; }
    }

    void OpenApprovalDialog()
    {
        _approvalForm.ApprovalReasonCode = _bindDetail?.ApprovalReasons.FirstOrDefault()?.OptionCode ?? string.Empty;
        _showApprovalDialog = true;
    }

    async Task RequestApprovalAsync()
    {
        if (_currentUser is null || _selected?.BindTransaction?.PolicyBindTransactionId is not Guid bindRequestId) return;
        _detailBusy = true;
        try
        {
            await Api.RequestBindApprovalAsync(bindRequestId, new RequestBindApprovalRequest(_currentUser.TenantId, _approvalForm.ApprovalReasonCode, null, _currentUser.UserId));
            _showApprovalDialog = false;
            await LoadAsync();
            await ShowToastAsync("Approval requested", "The bind request was routed for approval.", "enterprise-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("Approval failed", $"Approval request failed: {ex.Message}", "enterprise-toast-danger");
        }
        finally { _detailBusy = false; }
    }

    void OpenCarrierResponseDialog()
    {
        _carrierResponseForm.Reset(_bindDetail, _carrierMessageTypes, _bindConfirmationSources, CarrierResponseTransitions);
        _showCarrierResponseDialog = true;
    }

    async Task RecordCarrierResponseAsync()
    {
        if (_currentUser is null || _selected?.BindTransaction?.PolicyBindTransactionId is not Guid bindRequestId) return;
        _detailBusy = true;
        try
        {
            await Api.RecordBindCarrierResponseAsync(bindRequestId, new RecordBindCarrierResponseRequest(
                _currentUser.TenantId, _carrierResponseForm.StatusCode, _carrierResponseForm.MessageTypeCode, _bindDetail?.Request.BindingMethodCode,
                null, null, _carrierResponseForm.MessageBody, _carrierResponseForm.CarrierReferenceNumber, _carrierResponseForm.BinderNumber,
                _carrierResponseForm.FinalPremium, _carrierResponseForm.ConfirmationDocumentId, _currentUser.UserId, _carrierResponseForm.ConfirmationSourceCode, _carrierResponseForm.ConfirmationCertified));
            _showCarrierResponseDialog = false;
            await LoadAsync();
            await ShowToastAsync("Carrier response recorded", "The carrier response was recorded. Producer binder review is required before policy generation.", "enterprise-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("Carrier response failed", $"Carrier response failed: {ex.Message}", "enterprise-toast-danger");
        }
        finally { _detailBusy = false; }
    }

    void OpenBinderReviewDialog()
    {
        if (_currentUser is null || _bindDetail is null) return;
        var review = _bindDetail.BinderReview;
        _binderReviewForm = new UpsertBinderReviewRequest
        {
            TenantId = _currentUser.TenantId,
            PolicyNumber = review?.PolicyNumber ?? _bindDetail.Request.PolicyNumber ?? _bindDetail.Request.BinderNumber,
            CarrierId = review?.CarrierId ?? _bindDetail.Request.CarrierId,
            LineOfBusiness = review?.LineOfBusiness ?? _selected?.LineOfBusiness ?? string.Empty,
            EffectiveDate = review?.EffectiveDate ?? DateOnly.FromDateTime(_bindDetail.Request.EffectiveDate),
            ExpirationDate = review?.ExpirationDate ?? DateOnly.FromDateTime(_bindDetail.Request.ExpirationDate),
            Premium = review?.Premium ?? _bindDetail.Request.FinalPremium ?? _bindDetail.Request.AnnualPremium,
            Fees = review?.Fees,
            Taxes = review?.Taxes ?? _selected?.TaxesAndFees,
            CommissionPercent = review?.CommissionPercent ?? _bindDetail.Request.CommissionRatePct,
            PaymentPlan = review?.PaymentPlan ?? _selected?.PaymentTerms,
            BillingTypeCode = review?.BillingTypeCode,
            ProducerId = review?.ProducerId ?? _bindDetail.Request.RequestedByUserId,
            CsrId = review?.CsrId,
            CoverageSnapshotJson = review?.CoverageSnapshotJson ?? JsonSerializer.Serialize(new { _selected?.Limit, _selected?.Deductible, _selected?.Subjectivities }),
            RiskSnapshotJson = review?.RiskSnapshotJson ?? JsonSerializer.Serialize(new { _bindDetail.Request.AccountId, _bindDetail.Request.SubmissionId, _bindDetail.Request.QuoteId }),
            ComparisonSnapshotJson = review?.ComparisonSnapshotJson ?? JsonSerializer.Serialize(new { QuotedPremium = _bindDetail.Request.AnnualPremium, BinderPremium = _bindDetail.Request.FinalPremium, _bindDetail.Request.EffectiveDate, _bindDetail.Request.ExpirationDate }),
            ReviewNotes = review?.ReviewNotes
        };
        _binderReviewAttested = false;
        _showBinderReviewDialog = true;
    }

    async Task SaveBinderReviewAsync()
    {
        if (_selected?.BindTransaction?.PolicyBindTransactionId is not Guid bindRequestId) return;
        _detailBusy = true;
        try
        {
            await Api.SaveBinderReviewAsync(bindRequestId, _binderReviewForm);
            await LoadBindDetailAsync(bindRequestId);
            await ShowToastAsync("Verification saved", "The carrier binder verification snapshot was saved.", "enterprise-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("Verification failed", ex.Message, "enterprise-toast-danger");
        }
        finally { _detailBusy = false; }
    }

    async Task DecideBinderReviewAsync(string decisionCode)
    {
        if (_currentUser is null || _selected?.BindTransaction?.PolicyBindTransactionId is not Guid bindRequestId) return;
        _detailBusy = true;
        try
        {
            await Api.SaveBinderReviewAsync(bindRequestId, _binderReviewForm);
            await Api.DecideBinderReviewAsync(bindRequestId, new DecideBinderReviewRequest(_currentUser.TenantId, decisionCode, _binderReviewForm.ReviewNotes, _currentUser.UserId));
            await LoadAsync();
            _showBinderReviewDialog = true;
            await ShowToastAsync("Binder review updated", $"The carrier binder review is now {decisionCode}.", "enterprise-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("Binder decision failed", ex.Message, "enterprise-toast-danger");
        }
        finally { _detailBusy = false; }
    }

    async Task QueuePolicyGenerationAsync()
    {
        if (_currentUser is null || _selected?.BindTransaction?.PolicyBindTransactionId is not Guid bindRequestId) return;
        _detailBusy = true;
        try
        {
            await Api.QueuePolicyGenerationAsync(bindRequestId, new QueuePolicyGenerationRequest(_currentUser.TenantId, $"binder-{bindRequestId:N}", _currentUser.UserId));
            await MonitorPolicyGenerationAsync(bindRequestId);
            _showBinderReviewDialog = true;
            await ShowToastAsync("Policy generation queued", "The accepted carrier binder was queued for idempotent policy generation.", "enterprise-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("Policy generation failed", ex.Message, "enterprise-toast-danger");
        }
        finally { _detailBusy = false; }
    }

    async Task MonitorPolicyGenerationAsync(Guid bindRequestId)
    {
        for (var attempt = 0; attempt < 30; attempt++)
        {
            await LoadBindDetailAsync(bindRequestId);
            if (_bindDetail?.PolicyGeneration?.StatusCode is "Completed" or "Failed") break;
            await Task.Delay(TimeSpan.FromSeconds(2));
        }
        await LoadAsync();
        if (_bindDetail?.PolicyGeneration?.PolicyId is Guid policyId) OpenPolicy(policyId);
    }

    string MetricCardClass(BindMetric metric) => $"bind-kpi bind-kpi--{metric.Tone} {(_kpiFilter == metric.Filter || (metric.Filter == "all" && string.IsNullOrWhiteSpace(_kpiFilter)) ? "bind-kpi--active" : string.Empty)}";
    bool CanTransition(string statusCode) => _bindDetail?.AllowedTransitions.Any(x => !x.RequiresCarrierResponse && string.Equals(x.ToStatusCode, statusCode, StringComparison.OrdinalIgnoreCase)) == true;
    string BindStatusName(string statusCode) => _bindStatuses.FirstOrDefault(x => string.Equals(x.StatusCode, statusCode, StringComparison.OrdinalIgnoreCase))?.StatusName ?? statusCode;
    string ViewButtonClass(string view) => $"bc-view-btn {(_view == view ? "bc-view-btn--active" : string.Empty)}";
    static string BreakdownRowClass(string value, string currentFilter) => $"bc-breakdown-row {(string.Equals(value, currentFilter, StringComparison.OrdinalIgnoreCase) ? "bc-breakdown-row--active" : string.Empty)}";

    static IEnumerable<BreakdownItem> BuildBreakdown(IEnumerable<string> values)
    {
        var groups = values
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .GroupBy(v => v, StringComparer.OrdinalIgnoreCase)
            .Select(g => new { Name = g.First(), Count = g.Count() })
            .OrderByDescending(g => g.Count)
            .ThenBy(g => g.Name)
            .ToList();
        var max = groups.Count == 0 ? 1 : groups.Max(g => g.Count);
        return groups.Select(g => new BreakdownItem(g.Name, g.Count, max == 0 ? 0 : (decimal)g.Count / max * 100));
    }

    async Task OpenBindDialogAsync(BindQueueRow row) => await OpenBindDialogAsync(row, null, null, null);

    async Task OpenBindDialogAsync(BindQueueRow row, Guid? proposalId, Guid? customerAuthorizationId, ClientAcceptanceDto? acceptance)
    {
        if (_currentUser is null) return;
        acceptance ??= (await Api.GetClientAcceptancesAsync(row.SubmissionId, _currentUser.TenantId) ?? [])
            .Where(item => item.QuoteId == row.QuoteId && item.StatusCode is "Accepted" or "BindRequested")
            .OrderByDescending(item => item.CreatedDateUtc)
            .FirstOrDefault();
        proposalId ??= acceptance?.ProposalId;
        customerAuthorizationId ??= acceptance?.CustomerAuthorizationId;
        if (acceptance is null || !proposalId.HasValue || !customerAuthorizationId.HasValue)
        {
            await ShowToastAsync("Bind authorization unavailable", "A persisted accepted proposal and customer authorization are required before requesting bind.", "enterprise-toast-danger");
            return;
        }

        _requestBindContext = new RequestBindDialogContext(
            _currentUser.TenantId,
            _currentUser.UserId,
            row.SubmissionId,
            row.QuoteId,
            row.AccountId,
            row.CarrierId,
            proposalId.Value,
            customerAuthorizationId.Value,
            acceptance.ClientAcceptanceId,
            row.AccountName,
            row.SubmissionNumber,
            row.QuoteNumber,
            row.CarrierName,
            row.LineOfBusiness,
            row.AnnualPremium,
            row.EffectiveDate,
            row.ExpirationDate,
            row.PolicyNumber,
            row.Subjectivities,
            acceptance,
            _policySources,
            _bindStatuses,
            _customerAuthorizationMethods,
            _bindConfirmationSources,
            _bindingMethods,
            _bindingAuthorities);
    }

    Task CloseRequestBindDialog()
    {
        _requestBindContext = null;
        return Task.CompletedTask;
    }

    async Task CompleteRequestBindAsync(RequestBindDialogResult result)
    {
        _requestBindContext = null;
        await LoadAsync();
        await ShowToastAsync(result.CreatedPolicy ? "Policy created" : "Bind request created", result.CreatedPolicy ? $"Transaction {result.TransactionId} recorded carrier confirmation and created the policy workflow." : $"Bind request {result.TransactionId} was created and the queue was refreshed.", "enterprise-toast-success");
    }

    async Task SelectQuoteAsync(BindQueueRow row)
    {
        if (_currentUser is null) return;
        try
        {
            await Api.SelectSubmissionQuoteAsync(row.SubmissionId, new SelectSubmissionQuoteRequest(_currentUser.TenantId, row.QuoteId, true, $"Quote selected for bind from Bind Center: {row.QuoteNumber}.", _currentUser.UserId));
            await LoadAsync();
            await ShowToastAsync("Quote selected", $"{row.QuoteNumber} is now selected for bind.", "enterprise-toast-success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("Select failed", $"Quote selection failed: {ex.Message}", "enterprise-toast-danger");
        }
    }

    Task ExportAsync() => ShowToastAsync("Export ready", $"{FilteredRows.Count()} bind queue item(s) are ready for export from the current filtered view.", "enterprise-toast-success");

    async Task ShowToastAsync(string title, string content, string cssClass)
    {
        if (_toast is not null)
        {
            await _toast.ShowAsync(new ToastModel { Title = title, Content = content, CssClass = cssClass });
        }
    }

    static string StatusCss(string s) => string.IsNullOrWhiteSpace(s) ? "bc-st-bi" : s.ToLowerInvariant() switch
    {
        var value when value.Contains("select") => "bc-st-qs",
        var value when value.Contains("pending") => "bc-st-pb",
        var value when value.Contains("bound") || value.Contains("issued") => "bc-st-is",
        var value when value.Contains("hold") => "bc-st-oh",
        var value when value.Contains("declin") || value.Contains("reject") || value.Contains("expire") => "bc-st-dc",
        _ => "bc-st-bi"
    };

    static string LobCss(string lob)
    {
        var normalized = lob.ToLowerInvariant();
        if (normalized.Contains("auto")) return "ca";
        if (normalized.Contains("property")) return "cp";
        if (normalized.Contains("worker")) return "wc";
        if (normalized.Contains("umbrella")) return "um";
        if (normalized.Contains("professional")) return "pl";
        return "gl";
    }

    static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    RenderFragment LobChip(string lob) => @<span class="bc-lob-chip bc-lob-@LobCss(lob)">@Display(lob)</span>;
    RenderFragment DateCell(DateTime date) => @<span class="bc-date">@date.ToString("MM/dd/yy")</span>;
    RenderFragment ExpiryCell(BindQueueRow row) => @<span class="bc-date @(IsExpiringSoon(row) ? "bc-expiring" : null)">@row.QuoteExpiresDateUtc.ToLocalTime().ToString("MM/dd/yy")</span>;
    RenderFragment StatusChip(string status) => @<span class="bc-status @StatusCss(status)">@Display(status)</span>;
    RenderFragment AuditCell(BindQueueRow row) => row.BindTransaction is null ? @<span class="bc-audit-muted">No bind</span> : @<span class="bc-audit-ok"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> @Display(row.BindTransaction.BindStatusName)</span>;

    RenderFragment GridActions(BindQueueRow row) =>
        @<div class="bc-grid-actions">
             <button type="button" class="um-btn um-btn-primary um-btn-xs" title="Create bind request" @onclick="() => OpenBindDialogAsync(row)" disabled="@(row.BindTransaction is not null || IsBound(row))"><i class="bi bi-shield-check" aria-hidden="true"></i></button>
            <button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Open submission" @onclick="() => OpenSubmission(row)"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></button>
        </div>;

    RenderFragment DrawRow(string label, string value) =>
        @<div class="bc-draw-row"><span class="bc-draw-lbl">@label</span><span class="bc-draw-val">@value</span></div>;

