@page "/marketing/campaigns/new"
@page "/campaigns/new"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@PageTitleText - AMS</PageTitle>

@if (_toastVisible)
{
    <div class="ecb-toast ecb-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIcon" aria-hidden="true"></i>
        <div>
            <strong>@_toastTitle</strong>
            <span>@_toastMessage</span>
        </div>
        <button type="button" class="ecb-toast-close" @onclick="() => _toastVisible = false" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="ecb-enterprise-page">
    <section class="ecb-header">
        <div class="ecb-header-left">
            <div class="ecb-lob-icon"><i class="bi bi-kanban-fill" aria-hidden="true"></i></div>
            <div class="ecb-header-info">
                <div class="ecb-title-row">
                    <h1 class="ecb-page-title">@PageTitleText</h1>
                    <span class="ecb-status-pill"><i class="bi bi-activity" aria-hidden="true"></i> @_form.Status</span>
                </div>
                <div class="ecb-sub-row">
                    <span><i class="bi bi-megaphone" aria-hidden="true"></i> Enterprise campaign builder</span>
                    <span class="ecb-sub-chip"><i class="bi bi-database-check" aria-hidden="true"></i> Synced Marketing + Comms data</span>
                    <span class="ecb-sub-chip"><i class="bi bi-people" aria-hidden="true"></i> @SelectedContactCount.ToString("N0") recipients</span>
                </div>
            </div>
        </div>
        <div class="ecb-header-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="BackToCampaigns"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="SyncWorkspaceAsync" disabled="@(_loading || _saving)"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Sync Data</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="SaveDraftAsync" disabled="@(_loading || _saving)"><i class="bi bi-floppy" aria-hidden="true"></i> Save Draft</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="LaunchAsync" disabled="@(!IsValid || _loading || _saving)"><i class="bi bi-rocket-takeoff" aria-hidden="true"></i> Launch</button>
        </div>
    </section>

    <section class="ecb-kpi-strip" aria-label="Campaign builder summary">
        @KpiCard(0, "bi-bullseye", "Goal", _form.Goal, "Campaign objective", "ecb-ki-blue")
        @KpiCard(1, "bi-people", "Audience", SelectedContactCount.ToString("N0"), $"{SelectedSegmentNames.Count} selected segments", "ecb-ki-purple")
        @KpiCard(2, "bi-envelope-paper", "Channel", _form.Type, _form.TemplateName, "ecb-ki-cyan")
        @KpiCard(3, "bi-calendar-event", "Launch", _form.ScheduledDateUtc.ToString("MMM d"), _form.Timezone, "ecb-ki-green")
        @KpiCard(2, "bi-cursor", "CTA", string.IsNullOrWhiteSpace(_form.CtaLabel) ? "Not set" : _form.CtaLabel, _form.LandingPageSlug ?? "Landing page", "ecb-ki-amber")
    </section>

    <section class="ecb-workflow-strip" aria-label="Campaign builder workflow shortcuts">
        <button type="button" class="@WorkflowCardClass(0, "ecb-wf-details")" @onclick="() => GoToStep(0)"><span class="ecb-workflow-icon"><i class="bi bi-info-circle" aria-hidden="true"></i></span><span class="ecb-workflow-content"><strong>Details</strong><small>Name, type, goal, and timing.</small></span></button>
        <button type="button" class="@WorkflowCardClass(1, "ecb-wf-audience")" @onclick="() => GoToStep(1)"><span class="ecb-workflow-icon"><i class="bi bi-people" aria-hidden="true"></i></span><span class="ecb-workflow-content"><strong>Audience</strong><small>Synced segment targeting.</small></span></button>
        <button type="button" class="@WorkflowCardClass(2, "ecb-wf-content")" @onclick="() => GoToStep(2)"><span class="ecb-workflow-icon"><i class="bi bi-envelope-paper" aria-hidden="true"></i></span><span class="ecb-workflow-content"><strong>Content</strong><small>Email and landing page sync.</small></span></button>
        <button type="button" class="@WorkflowCardClass(3, "ecb-wf-schedule")" @onclick="() => GoToStep(3)"><span class="ecb-workflow-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></span><span class="ecb-workflow-content"><strong>Schedule</strong><small>Automation and suppression.</small></span></button>
        <button type="button" class="@WorkflowCardClass(4, "ecb-wf-review")" @onclick="() => GoToStep(4)"><span class="ecb-workflow-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span><span class="ecb-workflow-content"><strong>Review</strong><small>Ready-to-launch summary.</small></span></button>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger ecb-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError
        </div>
    }

    <section class="ecb-content-layout">
        <aside class="ecb-stepper" aria-label="Campaign builder steps">
            @for (var i = 0; i < _steps.Count; i++)
            {
                var index = i;
                <button type="button" class="ecb-step @(_step == index ? "ecb-step--active" : string.Empty) @(StepIsValid(index) ? "ecb-step--valid" : string.Empty)" @onclick="() => GoToStep(index)">
                    <span class="ecb-step-num">@(index + 1)</span>
                    <span><strong>@_steps[index].Title</strong><small>@_steps[index].Subtitle</small></span>
                    @if (StepIsValid(index))
                    {
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    }
                </button>
            }

            <div class="ecb-side-card">
                <span><i class="bi bi-shield-check" aria-hidden="true"></i> Workflow sync</span>
                <p>Saving this builder synchronizes Campaign, Audience, Content, Automation, Email Blast, and Landing Page records.</p>
            </div>
        </aside>

        <EditForm Model="_form" OnValidSubmit="SaveDraftAsync" class="ecb-panel">
            <DataAnnotationsValidator />

            @if (_loading)
            {
                <div class="ecb-loading"><i class="bi bi-arrow-repeat ecb-spin" aria-hidden="true"></i><strong>Loading campaign workspace...</strong><span>Repairing schema, seed data, and marketing workflow records.</span></div>
            }
            else if (_step == 0)
            {
                <div class="ecb-panel-head ecb-details-head">
                    <span><i class="bi bi-info-circle" aria-hidden="true"></i> Campaign Details</span>
                    <small>Define the campaign identity, objective, channel, lifecycle state, and planning window.</small>
                </div>
                <div class="ecb-details-shell">
                    <div class="ecb-details-intro">
                        <span><i class="bi bi-stars" aria-hidden="true"></i> Setup foundation</span>
                        <p>Use a clear campaign name and aligned timing so audience, content, automation, and reporting records stay synchronized.</p>
                    </div>
                    <div class="ecb-form-grid ecb-details-grid">
                        <div class="ecb-field ecb-full"><label>Campaign Name *</label><InputText class="ecb-input" @bind-Value="_form.Name" placeholder="Q3 Umbrella Cross-Sell - Commercial" /></div>
                        <div class="ecb-field"><label>Campaign Type *</label><InputSelect class="ecb-input" @bind-Value="_form.Type">@foreach (var item in _types) { <option value="@item">@item</option> }</InputSelect></div>
                        <div class="ecb-field"><label>Goal *</label><InputSelect class="ecb-input" @bind-Value="_form.Goal">@foreach (var item in _goals) { <option value="@item">@item</option> }</InputSelect></div>
                        <div class="ecb-field"><label>Status *</label><InputSelect class="ecb-input" @bind-Value="_form.Status">@foreach (var item in _statuses) { <option value="@item">@item</option> }</InputSelect></div>
                        <div class="ecb-field"><label>Start Date *</label><InputDate class="ecb-input" @bind-Value="_form.StartDate" /></div>
                        <div class="ecb-field"><label>End Date</label><InputDate class="ecb-input" @bind-Value="_form.EndDate" /></div>
                        <div class="ecb-field ecb-full"><label>Description</label><textarea class="ecb-input ecb-textarea" @bind="_form.Description" placeholder="Summarize the strategy, business owner, and expected outcome."></textarea></div>
                    </div>
                </div>
            }
            else if (_step == 1)
            {
                <div class="ecb-panel-head"><span><i class="bi bi-people" aria-hidden="true"></i> Audience Targeting</span><small>Use synced marketing segments and campaign audience tables.</small></div>
                <div class="ecb-seg-grid">
                    @foreach (var seg in _segments)
                    {
                        <button type="button" class="ecb-seg-card @(_selectedSegmentIds.Contains(seg.SegmentId) ? "ecb-seg-card--selected" : string.Empty)" @onclick="() => ToggleSegment(seg)">
                            <i class="bi @seg.Icon" aria-hidden="true"></i>
                            <strong>@seg.Name</strong>
                            <span>@seg.ContactCount.ToString("N0") contacts</span>
                            <small>@seg.Description</small>
                        </button>
                    }
                </div>
                <div class="ecb-audience-summary"><i class="bi bi-person-lines-fill" aria-hidden="true"></i><strong>@SelectedContactCount.ToString("N0")</strong> estimated recipients across @SelectedSegmentNames.Count selected segment(s).</div>
            }
            else if (_step == 2)
            {
                <div class="ecb-panel-head"><span><i class="bi bi-envelope-paper" aria-hidden="true"></i> Content & Landing Page</span><small>Sync campaign content with email blast and landing page records.</small></div>
                <div class="ecb-form-grid">
                    <div class="ecb-field ecb-full"><label>Subject / Headline *</label><InputText class="ecb-input" @bind-Value="_form.Subject" placeholder="Is your liability protection enough?" /></div>
                    <div class="ecb-field"><label>Sender Name *</label><InputText class="ecb-input" @bind-Value="_form.SenderName" /></div>
                    <div class="ecb-field"><label>Reply-To Email *</label><InputText class="ecb-input" @bind-Value="_form.ReplyToEmail" /></div>
                    <div class="ecb-field"><label>Template *</label><InputSelect class="ecb-input" @bind-Value="_form.TemplateName">@foreach (var item in _templates) { <option value="@item">@item</option> }</InputSelect></div>
                    <div class="ecb-field"><label>CTA Label</label><InputText class="ecb-input" @bind-Value="_form.CtaLabel" /></div>
                    <div class="ecb-field"><label>Landing Page Slug</label><InputText class="ecb-input" @bind-Value="_form.LandingPageSlug" placeholder="commercial-umbrella-review" /></div>
                    <div class="ecb-field ecb-full"><label>Landing Page URL</label><InputText class="ecb-input" @bind-Value="_form.LandingPageUrl" placeholder="https://agencybinder.local/lp/..." /></div>
                </div>
                <div class="ecb-sync-grid">
                    <div>
                        <h3>Synced Email Blasts</h3>
                        @foreach (var blast in _emailBlasts.Take(3))
                        {
                            <p><strong>@blast.Name</strong><span>@blast.Status - @blast.RecipientCount.ToString("N0") recipients</span></p>
                        }
                    </div>
                    <div>
                        <h3>Synced Landing Pages</h3>
                        @foreach (var landingPage in _landingPages.Take(3))
                        {
                            <p><strong>@landingPage.Name</strong><span>@landingPage.Status - @landingPage.ConversionRate.ToString("0.##")% conversion</span></p>
                        }
                    </div>
                </div>
            }
            else if (_step == 3)
            {
                <div class="ecb-panel-head"><span><i class="bi bi-calendar-event" aria-hidden="true"></i> Schedule & Automation</span><small>Control launch timing, suppression rules, and follow-up automation.</small></div>
                <div class="ecb-form-grid">
                    <div class="ecb-field"><label>Send Mode *</label><InputSelect class="ecb-input" @bind-Value="_form.SendMode">@foreach (var item in _sendModes) { <option value="@item">@item</option> }</InputSelect></div>
                    <div class="ecb-field"><label>Scheduled Date *</label><InputDate class="ecb-input" @bind-Value="_form.ScheduledDateUtc" /></div>
                    <div class="ecb-field"><label>Timezone *</label><InputSelect class="ecb-input" @bind-Value="_form.Timezone">@foreach (var item in _timezones) { <option value="@item">@item</option> }</InputSelect></div>
                    <div class="ecb-field"><label>Follow-up Delay *</label><InputNumber class="ecb-input" @bind-Value="_form.FollowUpDays" /></div>
                    <div class="ecb-check-grid ecb-full">
                        <label><InputCheckbox @bind-Value="_form.SendFollowUp" /> Send follow-up to non-openers</label>
                        <label><InputCheckbox @bind-Value="_form.SuppressRecentContacts" /> Suppress recent contacts</label>
                        <label><InputCheckbox @bind-Value="_form.SuppressOptOut" /> Exclude opted-out contacts</label>
                        <label><InputCheckbox @bind-Value="_form.AbTestSubject" /> A/B test subject line</label>
                    </div>
                </div>
            }
            else
            {
                <div class="ecb-panel-head"><span><i class="bi bi-clipboard-check" aria-hidden="true"></i> Review & Launch</span><small>Confirm campaign setup before saving or launching.</small></div>
                <div class="ecb-review-grid">
                    @ReviewCard("Campaign", ("Name", _form.Name), ("Type", _form.Type), ("Goal", _form.Goal), ("Status", _form.Status))
                    @ReviewCard("Audience", ("Segments", string.Join(", ", SelectedSegmentNames)), ("Contacts", SelectedContactCount.ToString("N0")), ("Suppression", _form.SuppressOptOut ? "Opt-outs excluded" : "Manual review"))
                    @ReviewCard("Content", ("Subject", _form.Subject), ("Template", _form.TemplateName), ("CTA", _form.CtaLabel ?? string.Empty), ("Landing", _form.LandingPageSlug ?? string.Empty))
                    @ReviewCard("Schedule", ("Mode", _form.SendMode), ("Launch", _form.ScheduledDateUtc.ToString("MMM d, yyyy")), ("Timezone", _form.Timezone), ("Follow-up", _form.SendFollowUp ? $"{_form.FollowUpDays} days" : "Off"))
                </div>
            }

            <div class="ecb-nav-row">
                <button type="button" class="um-btn um-btn-ghost" @onclick="PreviousStep" disabled="@(_step == 0 || _loading)"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</button>
                <div>
                    <button type="button" class="um-btn um-btn-ghost" @onclick="SaveDraftAsync" disabled="@(_loading || _saving)"><i class="bi bi-floppy" aria-hidden="true"></i> Save Draft</button>
                    @if (_step < _steps.Count - 1)
                    {
                        <button type="button" class="um-btn um-btn-primary" @onclick="NextStep" disabled="@(!CanAdvance || _loading)">Next <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                    }
                    else
                    {
                        <button type="button" class="um-btn um-btn-primary" @onclick="LaunchAsync" disabled="@(!IsValid || _saving)"><i class="bi bi-rocket-takeoff" aria-hidden="true"></i> Launch Campaign</button>
                    }
                </div>
            </div>
        </EditForm>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "campaignId")] public Guid? CampaignId { get; set; }
    [SupplyParameterFromQuery(Name = "sourceCampaignId")] public Guid? SourceCampaignId { get; set; }
    [SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }

    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private int _step;
    private bool _loading;
    private bool _saving;
    private bool _toastVisible;
    private string? _loadError;
    private string _toastTitle = string.Empty;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private CampaignBuilderForm _form = new();
    private List<MarketingSegmentDto> _segments = [];
    private List<MarketingEmailBlastDto> _emailBlasts = [];
    private List<MarketingLandingPageDto> _landingPages = [];
    private HashSet<Guid> _selectedSegmentIds = [];

    private static readonly List<BuilderStep> _steps =
    [
        new("Details", "Objective and status"),
        new("Audience", "Segments and reach"),
        new("Content", "Message and landing"),
        new("Schedule", "Timing and rules"),
        new("Review", "Launch readiness")
    ];

    private static readonly string[] _types = ["Email", "SMS", "Direct Mail", "Multi-Channel", "Push Notification"];
    private static readonly string[] _goals = ["Cross-Sell", "Win-Back", "Referral", "Renewal", "Upsell", "Brand Awareness", "Review Request"];
    private static readonly string[] _statuses = ["Draft", "Scheduled", "Active", "Paused"];
    private static readonly string[] _sendModes = ["Immediate", "Scheduled", "Triggered"];
    private static readonly string[] _timezones = ["Eastern", "Central", "Mountain", "Pacific"];
    private static readonly string[] _templates = ["Insurance Benefit Card", "Plain Text", "Modern Promo", "Newsletter", "Win-Back Offer", "Referral Ask"];

    private string PageTitleText => CampaignId.HasValue && !IsDuplicateMode ? "Edit Campaign Builder" : IsDuplicateMode ? "Duplicate Campaign Builder" : "New Campaign Builder";
    private bool IsDuplicateMode => string.Equals(Mode, "duplicate", StringComparison.OrdinalIgnoreCase) || SourceCampaignId.HasValue;
    private bool IsValid => !string.IsNullOrWhiteSpace(_form.Name) && !string.IsNullOrWhiteSpace(_form.Type) && _selectedSegmentIds.Any() && !string.IsNullOrWhiteSpace(_form.Subject);
    private bool CanAdvance => _step switch { 0 => StepIsValid(0), 1 => StepIsValid(1), 2 => StepIsValid(2), 3 => StepIsValid(3), _ => IsValid };
    private List<string> SelectedSegmentNames => _segments.Where(s => _selectedSegmentIds.Contains(s.SegmentId)).Select(s => s.Name).ToList();
    private int SelectedContactCount => _segments.Where(s => _selectedSegmentIds.Contains(s.SegmentId)).Sum(s => s.ContactCount);
    private string ToastIcon => _toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill";

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Marketing", "/marketing/campaigns"), new(PageTitleText, ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var loadId = CampaignId ?? SourceCampaignId;
            CommunicationCampaignBuilderDataDto? data;
            if (loadId.HasValue)
            {
                data = await Api.GetCommunicationCampaignBuilderAsync(loadId.Value, _tenantId);
            }
            else
            {
                data = await Api.GetCommunicationCampaignBuilderWorkspaceAsync(_tenantId);
            }

            if (data is not null)
            {
                _segments = data.Segments;
                _emailBlasts = data.EmailBlasts;
                _landingPages = data.LandingPages;
                ApplyCampaign(data.Campaign, IsDuplicateMode);
            }

            SelectDefaultSegment();
        }
        catch (Exception ex)
        {
            _loadError = $"Campaign builder failed to load: {ex.Message}";
            ShowToast("Load failed", $"Campaign builder failed to load: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SyncWorkspaceAsync()
    {
        await LoadAsync();
        if (string.IsNullOrWhiteSpace(_loadError))
        {
        }
    }

    private void ApplyCampaign(CommunicationCampaignDto campaign, bool duplicate)
    {
        _form = new CampaignBuilderForm
        {
            Name = duplicate ? $"Copy of {campaign.Name}" : campaign.Name,
            Type = string.IsNullOrWhiteSpace(campaign.Type) ? "Email" : campaign.Type,
            Goal = string.IsNullOrWhiteSpace(campaign.Goal) ? "Cross-Sell" : campaign.Goal,
            Status = duplicate ? "Draft" : string.IsNullOrWhiteSpace(campaign.Status) ? "Draft" : campaign.Status,
            Description = campaign.Description,
            StartDate = campaign.StartDate == default ? DateTime.Today.AddDays(7) : campaign.StartDate,
            EndDate = campaign.EndDate,
            Subject = campaign.Subject,
            SenderName = string.IsNullOrWhiteSpace(campaign.SenderName) ? "AgencyBinder Team" : campaign.SenderName,
            ReplyToEmail = string.IsNullOrWhiteSpace(campaign.ReplyToEmail) ? "marketing@agencybinder.local" : campaign.ReplyToEmail,
            TemplateName = string.IsNullOrWhiteSpace(campaign.TemplateName) ? "Insurance Benefit Card" : campaign.TemplateName,
            CtaLabel = string.IsNullOrWhiteSpace(campaign.CtaLabel) ? "Get a Quote" : campaign.CtaLabel,
            LandingPageSlug = campaign.LandingPageSlug,
            LandingPageUrl = campaign.LandingPageUrl,
            SendMode = string.IsNullOrWhiteSpace(campaign.SendMode) ? "Scheduled" : campaign.SendMode,
            ScheduledDateUtc = campaign.ScheduledDateUtc ?? (campaign.StartDate == default ? DateTime.Today.AddDays(7) : campaign.StartDate),
            Timezone = string.IsNullOrWhiteSpace(campaign.Timezone) ? "Eastern" : campaign.Timezone,
            FollowUpDays = campaign.FollowUpDays <= 0 ? 7 : campaign.FollowUpDays,
            SendFollowUp = campaign.SendFollowUp,
            SuppressRecentContacts = campaign.SuppressRecentContacts,
            SuppressOptOut = campaign.SuppressOptOut,
            AbTestSubject = campaign.AbTestSubject,
            Revenue = duplicate ? 0 : campaign.Revenue,
            OpenRate = duplicate ? 0 : campaign.OpenRate,
            Conversions = duplicate ? 0 : campaign.Conversions
        };

        _selectedSegmentIds.Clear();
        if (!string.IsNullOrWhiteSpace(campaign.Segment))
        {
            foreach (var segment in _segments.Where(s => campaign.Segment.Contains(s.Name, StringComparison.OrdinalIgnoreCase)))
            {
                _selectedSegmentIds.Add(segment.SegmentId);
            }
        }
    }

    private void SelectDefaultSegment()
    {
        if (!_selectedSegmentIds.Any() && _segments.Count > 0)
        {
            _selectedSegmentIds.Add(_segments[0].SegmentId);
        }
    }

    private void ToggleSegment(MarketingSegmentDto segment)
    {
        if (!_selectedSegmentIds.Remove(segment.SegmentId))
        {
            _selectedSegmentIds.Add(segment.SegmentId);
        }
    }

    private void GoToStep(int step)
    {
        if (step >= 0 && step < _steps.Count)
        {
            _step = step;
        }
    }

    private void NextStep()
    {
        if (CanAdvance && _step < _steps.Count - 1)
        {
            _step++;
        }
    }

    private void PreviousStep()
    {
        if (_step > 0)
        {
            _step--;
        }
    }

    private bool StepIsValid(int index) => index switch
    {
        0 => !string.IsNullOrWhiteSpace(_form.Name) && !string.IsNullOrWhiteSpace(_form.Type) && !string.IsNullOrWhiteSpace(_form.Goal),
        1 => _selectedSegmentIds.Any(),
        2 => !string.IsNullOrWhiteSpace(_form.Subject) && !string.IsNullOrWhiteSpace(_form.SenderName) && !string.IsNullOrWhiteSpace(_form.ReplyToEmail),
        3 => !string.IsNullOrWhiteSpace(_form.SendMode) && _form.FollowUpDays is >= 1 and <= 90,
        4 => IsValid,
        _ => false
    };

    private async Task SaveDraftAsync() => await SaveCampaignAsync("Draft", false);

    private async Task LaunchAsync()
    {
        var status = _form.SendMode == "Scheduled" ? "Scheduled" : "Active";
        await SaveCampaignAsync(status, true);
    }

    private async Task SaveCampaignAsync(string status, bool navigateAfterSave)
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        try
        {
            _form.Status = status;
            var request = ToDto(status);
            if (CampaignId.HasValue && !IsDuplicateMode)
            {
                await Api.UpdateCommunicationCampaignAsync(CampaignId.Value, request);
                ShowToast("Campaign updated", $"{_form.Name} was synced successfully.", "success");
            }
            else
            {
                var id = await Api.CreateCommunicationCampaignAsync(request);
                CampaignId = id;
                Mode = "edit";
                ShowToast("Campaign created", $"{_form.Name} was saved successfully.", "success");
            }

            if (navigateAfterSave)
            {
                Nav.NavigateTo("/marketing/campaigns");
            }
        }
        catch (Exception ex)
        {
            ShowToast("Save failed", $"Campaign save failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private CommunicationCampaignDto ToDto(string status)
        => new()
        {
            CampaignId = CampaignId ?? Guid.Empty,
            TenantId = _tenantId,
            Name = _form.Name.Trim(),
            Type = _form.Type,
            Status = status,
            Segment = string.Join(", ", SelectedSegmentNames),
            Goal = _form.Goal,
            Description = _form.Description ?? string.Empty,
            Subject = _form.Subject,
            SenderName = _form.SenderName,
            ReplyToEmail = _form.ReplyToEmail,
            TemplateName = _form.TemplateName,
            CtaLabel = _form.CtaLabel ?? string.Empty,
            SendMode = _form.SendMode,
            Timezone = _form.Timezone,
            FollowUpDays = _form.FollowUpDays,
            SendFollowUp = _form.SendFollowUp,
            SuppressRecentContacts = _form.SuppressRecentContacts,
            SuppressOptOut = _form.SuppressOptOut,
            AbTestSubject = _form.AbTestSubject,
            EndDate = _form.EndDate,
            ScheduledDateUtc = _form.ScheduledDateUtc,
            LandingPageSlug = _form.LandingPageSlug ?? string.Empty,
            LandingPageUrl = _form.LandingPageUrl ?? string.Empty,
            StartDate = _form.StartDate,
            Reached = status == "Draft" ? 0 : SelectedContactCount,
            OpenRate = _form.OpenRate,
            Conversions = _form.Conversions,
            Revenue = _form.Revenue
        };

    private void BackToCampaigns() => Nav.NavigateTo("/marketing/campaigns");

    private void ShowToast(string title, string message, string kind)
    {
        _toastTitle = title;
        _toastMessage = message;
        _toastKind = kind;
        _toastVisible = true;
    }

    private string WorkflowCardClass(int step, string css) => $"ecb-workflow-card {css}{(_step == step ? " ecb-workflow-active" : string.Empty)}";

    private string KpiCardClass(int step, string css) => $"ecb-kpi-card {css}{(_step == step ? " ecb-kpi-active" : string.Empty)}";

    private RenderFragment KpiCard(int step, string icon, string label, string value, string caption, string css) => @<button type="button" class="@KpiCardClass(step, css)" title="Open @label section" @onclick="() => GoToStep(step)"><span class="ecb-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span><span class="ecb-kpi-copy"><span class="ecb-kpi-label">@label</span><strong class="ecb-kpi-value">@value</strong><small class="ecb-kpi-caption">@caption</small></span></button>;

    private RenderFragment ReviewCard(string title, params (string Label, string Value)[] rows) => @<article class="ecb-review-card"><h3>@title</h3>@foreach (var row in rows) { <div><span>@row.Label</span><strong>@(string.IsNullOrWhiteSpace(row.Value) ? "-" : row.Value)</strong></div> }</article>;

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private sealed record BuilderStep(string Title, string Subtitle);

    private sealed class CampaignBuilderForm
    {
        [Required, StringLength(200)] public string Name { get; set; } = string.Empty;
        [Required, StringLength(80)] public string Type { get; set; } = "Email";
        [Required, StringLength(100)] public string Goal { get; set; } = "Cross-Sell";
        [Required, StringLength(50)] public string Status { get; set; } = "Draft";
        [StringLength(1000)] public string? Description { get; set; }
        [Required] public DateTime StartDate { get; set; } = DateTime.Today.AddDays(7);
        public DateTime? EndDate { get; set; }
        [Required, StringLength(300)] public string Subject { get; set; } = string.Empty;
        [Required, StringLength(150)] public string SenderName { get; set; } = "AgencyBinder Team";
        [Required, EmailAddress, StringLength(254)] public string ReplyToEmail { get; set; } = "marketing@agencybinder.local";
        [Required, StringLength(150)] public string TemplateName { get; set; } = "Insurance Benefit Card";
        [StringLength(150)] public string? CtaLabel { get; set; } = "Get a Quote";
        [StringLength(200)] public string? LandingPageSlug { get; set; }
        [StringLength(500)] public string? LandingPageUrl { get; set; }
        [Required, StringLength(50)] public string SendMode { get; set; } = "Scheduled";
        [Required] public DateTime ScheduledDateUtc { get; set; } = DateTime.Today.AddDays(7);
        [Required, StringLength(80)] public string Timezone { get; set; } = "Eastern";
        [Range(1, 90)] public int FollowUpDays { get; set; } = 7;
        public bool SendFollowUp { get; set; } = true;
        public bool SuppressRecentContacts { get; set; } = true;
        public bool SuppressOptOut { get; set; } = true;
        public bool AbTestSubject { get; set; }
        public decimal OpenRate { get; set; }
        public int Conversions { get; set; }
        public decimal Revenue { get; set; }
    }
}
