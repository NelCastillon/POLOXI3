@page "/integrations/automation"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Automation Workflows - AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<AppPageHeader Title="Automation Workflows"
               Subtitle="No-code and low-code automation flows triggered by AMS events - renewals, claims, payments, downloads, and more"
               Icon="bi-diagram-3-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='()=>Nav.NavigateTo("/integrations/automation/history")'><i class="bi bi-clock-history" aria-hidden="true"></i> Job History</button>
        <button class="um-btn um-btn-primary" @onclick='()=>Nav.NavigateTo("/integrations/automation/designer")'><i class="bi bi-plus-lg" aria-hidden="true"></i> New Workflow</button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="aw-kpi-strip">
    <div class="aw-kpi-card"><div class="aw-kpi-icon aw-ki-green"><i class="bi bi-check-circle" aria-hidden="true"></i></div><div><div class="aw-kv">@_workflows.Count(w=>w.Status=="Active")</div><div class="aw-kl">Active</div></div></div>
    <div class="aw-kpi-card"><div class="aw-kpi-icon aw-ki-grey"><i class="bi bi-pause-circle" aria-hidden="true"></i></div><div><div class="aw-kv">@_workflows.Count(w=>w.Status=="Paused")</div><div class="aw-kl">Paused</div></div></div>
    <div class="aw-kpi-card"><div class="aw-kpi-icon aw-ki-blue"><i class="bi bi-lightning-charge" aria-hidden="true"></i></div><div><div class="aw-kv">4,821</div><div class="aw-kl">Runs Today</div></div></div>
    <div class="aw-kpi-card"><div class="aw-kpi-icon aw-ki-red"><i class="bi bi-x-circle" aria-hidden="true"></i></div><div><div class="aw-kv">@_workflows.Sum(w=>w.FailuresToday)</div><div class="aw-kl">Failures Today</div></div></div>
</div>

<!-- Trigger category filter -->
<div class="aw-cat-row">
    @foreach (var cat in _triggerCats)
    {
        <button class="aw-cat-btn @(_catFilter==cat?"aw-cat-sel":"")" @onclick="() => ToggleCatFilter(cat)">@cat</button>
    }
</div>

<!-- Workflow cards -->
<div class="aw-wf-grid">
    @foreach (var wf in Filtered)
    {
        <div class="aw-wf-card @StatusBorderCss(wf.Status)">
            <div class="aw-wf-hdr">
                <div class="aw-wf-icon @TriggerIconCss(wf.TriggerCategory)"><i class="bi bi-@TriggerIcon(wf.TriggerCategory)" aria-hidden="true"></i></div>
                <div class="aw-wf-info">
                    <div class="aw-wf-name">@wf.Name</div>
                    <div class="aw-wf-trigger"><i class="bi bi-lightning-charge" aria-hidden="true"></i> @wf.TriggerEvent</div>
                </div>
                <label class="aw-toggle-switch" title="@(wf.Status=="Active"?"Pause":"Activate")">
                    <input type="checkbox" checked="@(wf.Status=="Active")" @onchange="()=>ToggleWf(wf)" />
                    <span class="aw-toggle-thumb"></span>
                </label>
            </div>
            <div class="aw-wf-desc">@wf.Description</div>
            <div class="aw-wf-steps">
                @foreach (var (step, idx) in wf.Steps.Select((s,i)=>(s,i)))
                {
                    <div class="aw-step"><span class="aw-step-num">@(idx+1)</span><span class="aw-step-lbl">@step</span></div>
                    @if (idx < wf.Steps.Count - 1) { <div class="aw-step-arrow"><i class="bi bi-arrow-down" aria-hidden="true"></i></div> }
                }
            </div>
            <div class="aw-wf-stats">
                <div class="aw-ws"><div class="aw-wsl">Runs today</div><div class="aw-wsv">@wf.RunsToday</div></div>
                <div class="aw-ws"><div class="aw-wsl">Failures</div><div class="aw-wsv @(wf.FailuresToday>0?"aw-bad":"")">@wf.FailuresToday</div></div>
                <div class="aw-ws"><div class="aw-wsl">Success rate</div><div class="aw-wsv @(wf.SuccessRate>=95?"aw-good":wf.SuccessRate>=80?"aw-warn":"aw-bad")">@wf.SuccessRate%</div></div>
                <div class="aw-ws"><div class="aw-wsl">Last run</div><div class="aw-wsv">@wf.LastRun</div></div>
            </div>
            <div class="aw-wf-footer">
                <span class="@StatusBadge(wf.Status)">@wf.Status</span>
                <div class="aw-wf-actions">
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick='()=>Nav.NavigateTo("/integrations/automation/designer")' title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick='()=>Nav.NavigateTo("/integrations/automation/history")' title="History"><i class="bi bi-clock-history" aria-hidden="true"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-xs" title="Duplicate"><i class="bi bi-copy" aria-hidden="true"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-xs" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button>
                </div>
            </div>
        </div>
    }
    <!-- New workflow card -->
    <div class="aw-new-card" @onclick='()=>Nav.NavigateTo("/integrations/automation/designer")'>
        <i class="bi bi-plus-circle aw-new-icon" aria-hidden="true"></i>
        <span>Create Workflow</span>
        <div class="aw-new-sub">No-code flow builder</div>
    </div>
</div>

@code {
    private EnterpriseToast? _toast;
    private string _catFilter = string.Empty;

    private void ToggleCatFilter(string cat) => _catFilter = _catFilter == cat ? string.Empty : cat;

    private static readonly string[] _triggerCats = ["Renewals","Claims","Payments","Downloads","Documents","Leads","Communications"];

    private IEnumerable<WorkflowDef> Filtered => string.IsNullOrEmpty(_catFilter)
        ? _workflows
        : _workflows.Where(w => w.TriggerCategory == _catFilter);

    private List<WorkflowDef> _workflows = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Integrations","/integrations"), new("Automation Workflows",""));
        _workflows =
        [
            new WorkflowDef { Id=1, Name="Renewal 90-Day Reminder",        TriggerEvent="on renewal created (90 days out)", TriggerCategory="Renewals",      Status="Active", RunsToday=42, FailuresToday=0, SuccessRate=100, LastRun="3 min ago",  Description="Sends producer task + client email 90 days before renewal date.", Steps=["Trigger: renewal.created","Filter: days_to_expiry = 90","Action: Create task for producer","Action: Send renewal email to client"] },
            new WorkflowDef { Id=2, Name="Claim Severity Alert",            TriggerEvent="on claim opened",                  TriggerCategory="Claims",        Status="Active", RunsToday=8,  FailuresToday=0, SuccessRate=100, LastRun="22 min ago", Description="Alerts service manager when a new claim exceeds $25K reserve.", Steps=["Trigger: claim.opened","Condition: reserve_amount > 25000","Action: Notify service manager (Slack + email)","Action: Create follow-up task (3 days)"] },
            new WorkflowDef { Id=3, Name="Payment Failed Outreach",         TriggerEvent="on payment failed",                TriggerCategory="Payments",      Status="Active", RunsToday=6,  FailuresToday=1, SuccessRate=83,  LastRun="1 hr ago",   Description="Sends SMS and creates CSR task on payment failure. Retries after 2 days.", Steps=["Trigger: payment.failed","Action: Send SMS to policyholder","Action: Create CSR task","Wait: 2 days","Condition: payment still failed","Action: Create escalation task"] },
            new WorkflowDef { Id=4, Name="Lead Inactivity Re-Engagement",   TriggerEvent="on lead inactive (14 days)",       TriggerCategory="Leads",         Status="Active", RunsToday=11, FailuresToday=0, SuccessRate=100, LastRun="45 min ago", Description="Sends re-engagement email when a lead has no activity for 14 days.", Steps=["Trigger: lead.inactive","Filter: days_inactive >= 14","Action: Send re-engagement email campaign","Action: Create producer task"] },
            new WorkflowDef { Id=5, Name="Download Exception Triage",       TriggerEvent="on new download received",         TriggerCategory="Downloads",     Status="Active", RunsToday=88, FailuresToday=2, SuccessRate=98,  LastRun="2 min ago",  Description="Auto-matches download records. Routes unmatched to exception queue and notifies ops.", Steps=["Trigger: download.received","Action: Attempt auto-match","Condition: match_found = false","Action: Create exception record","Action: Notify operations team"] },
            new WorkflowDef { Id=6, Name="Missing Document Reminder",       TriggerEvent="on missing document",              TriggerCategory="Documents",     Status="Active", RunsToday=14, FailuresToday=0, SuccessRate=100, LastRun="1 hr ago",   Description="Emails client when required policy documents are missing 30 days before renewal.", Steps=["Trigger: document.missing_required","Condition: days_to_renewal <= 30","Action: Send document request email","Action: Create CSR follow-up task"] },
            new WorkflowDef { Id=7, Name="eSign Timeout Escalation",        TriggerEvent="on pending e-sign timeout",        TriggerCategory="Documents",     Status="Active", RunsToday=3,  FailuresToday=0, SuccessRate=100, LastRun="3 hr ago",   Description="Escalates to producer when e-sign package is pending for more than 7 days.", Steps=["Trigger: document.esign.timeout","Filter: pending_days > 7","Action: Send reminder email to signer","Action: Create escalation task for producer"] },
            new WorkflowDef { Id=8, Name="New Carrier Download Audit",      TriggerEvent="on new download received",         TriggerCategory="Downloads",     Status="Paused", RunsToday=0,  FailuresToday=0, SuccessRate=100, LastRun="2 days ago", Description="Creates an audit log entry for every carrier download for compliance reporting.", Steps=["Trigger: download.received","Action: Write audit log entry","Condition: is_exception = true","Action: Tag record for compliance review"] },
        ];
    }

    private async Task ToggleWf(WorkflowDef wf)
    {
        wf.Status = wf.Status == "Active" ? "Paused" : "Active";
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = $"'{wf.Name}' {wf.Status.ToLower()}.", CssClass = "enterprise-toast-info" });
    }

    private static string StatusBorderCss(string s) => s switch { "Paused"=>"aw-border-paused","Error"=>"aw-border-err",_=>"" };
    private static string StatusBadge(string s) => s switch { "Active"=>"aw-st aw-st--ok","Paused"=>"aw-st aw-st--off","Error"=>"aw-st aw-st--err",_=>"aw-st" };
    private static string TriggerIcon(string cat) => cat switch { "Renewals"=>"arrow-clockwise","Claims"=>"exclamation-circle","Payments"=>"cash-coin","Downloads"=>"arrow-down-circle","Documents"=>"file-earmark","Leads"=>"person-plus","Communications"=>"envelope",_=>"lightning-charge" };
    private static string TriggerIconCss(string cat) => cat switch { "Renewals"=>"aw-ic-blue","Claims"=>"aw-ic-red","Payments"=>"aw-ic-green","Downloads"=>"aw-ic-purple","Documents"=>"aw-ic-amber","Leads"=>"aw-ic-blue","Communications"=>"aw-ic-purple",_=>"aw-ic-grey" };

    private sealed class WorkflowDef { public int Id{get;set;} public string Name{get;set;}=string.Empty; public string TriggerEvent{get;set;}=string.Empty; public string TriggerCategory{get;set;}=string.Empty; public string Status{get;set;}=string.Empty; public int RunsToday{get;set;} public int FailuresToday{get;set;} public int SuccessRate{get;set;} public string LastRun{get;set;}=string.Empty; public string Description{get;set;}=string.Empty; public List<string> Steps{get;set;}=[]; }
}
