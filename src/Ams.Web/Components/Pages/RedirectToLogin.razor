@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var returnUrl = "/" + Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/');
        var authState = AuthenticationStateTask is null ? null : await AuthenticationStateTask;
        var target = authState?.User.Identity?.IsAuthenticated == true
            ? "/unauthorized"
            : $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";

        Nav.NavigateTo(target, replace: true);
    }
}
