    private async Task PersistCoverageFieldsAsync(Guid coverageDetailId)
    {
        NormalizeDynamicFields();
        var current = _existingCoverage?.Fields ?? [];
        var submittedIds = _coverageForm.Fields.Where(x => x.FieldId.HasValue).Select(x => x.FieldId!.Value).ToHashSet();
        foreach (var field in current.Where(x => !submittedIds.Contains(x.FieldId)))
        {
            await Api.DeletePolicyCoverageFieldAsync(_tenantId, field.FieldId, _currentUserId);
        }

        foreach (var field in _coverageForm.Fields)
        {
            if (field.FieldId.HasValue)
            {
                await Api.UpdatePolicyCoverageFieldAsync(field.FieldId.Value, new UpdatePolicyCoverageFieldRequest
                {
                    TenantId = _tenantId,
                    FieldId = field.FieldId.Value,
                    FieldGroupCode = field.FieldGroupCode.Trim(),
                    FieldCode = field.FieldCode.Trim(),
                    FieldLabel = field.FieldLabel.Trim(),
                    FieldValue = field.FieldValue.Trim(),
                    FieldValueTypeCode = field.FieldValueTypeCode.Trim(),
                    UnitOfMeasureCode = field.UnitOfMeasureCode.Trim(),
                    IsRequired = field.IsRequired,
                    IsRatingField = field.IsRatingField,
                    IsScheduleField = field.IsScheduleField,
                    SortOrder = field.SortOrder,
                    ModifiedByUserId = _currentUserId,
                });
                continue;
            }

            await Api.CreatePolicyCoverageFieldAsync(new CreatePolicyCoverageFieldRequest
            {
                TenantId = _tenantId,
                CoverageDetailId = coverageDetailId,
                FieldGroupCode = field.FieldGroupCode.Trim(),
                FieldCode = field.FieldCode.Trim(),
                FieldLabel = field.FieldLabel.Trim(),
                FieldValue = field.FieldValue.Trim(),
                FieldValueTypeCode = field.FieldValueTypeCode.Trim(),
                UnitOfMeasureCode = field.UnitOfMeasureCode.Trim(),
                IsRequired = field.IsRequired,
                IsRatingField = field.IsRatingField,
                IsScheduleField = field.IsScheduleField,
                SortOrder = field.SortOrder,
                CreatedByUserId = _currentUserId,
            });
        }
    }

    private bool ValidateCoverageBeforeSave()
    {
        NormalizeCoverageForm();
        NormalizeDynamicFields();

        if (_coverageForm.ExpirationDate < _coverageForm.EffectiveDate)
        {
            _ = ShowErrorToast("Expiration date must be on or after the effective date.");
            _tab = 2;
            return false;
        }

        var invalidField = _coverageForm.Fields.FirstOrDefault(field =>
            string.IsNullOrWhiteSpace(field.FieldGroupCode) ||
            string.IsNullOrWhiteSpace(field.FieldCode) ||
            string.IsNullOrWhiteSpace(field.FieldLabel) ||
            string.IsNullOrWhiteSpace(field.FieldValueTypeCode) ||
            (field.IsRequired && string.IsNullOrWhiteSpace(field.FieldValue)));

        if (invalidField is not null)
        {
            _ = ShowErrorToast($"Complete dynamic field '{EmptyDash(invalidField.FieldLabel)}' before saving.");
            _tab = 4;
            return false;
        }

        return true;
    }

    private void NormalizeCoverageForm()
    {
        _coverageForm.CovCode = _coverageForm.CovCode.Trim();
        _coverageForm.CovName = _coverageForm.CovName.Trim();
        _coverageForm.LineOfBusinessCode = _coverageForm.LineOfBusinessCode.Trim();
        _coverageForm.CoverageCategoryCode = _coverageForm.CoverageCategoryCode.Trim();
        _coverageForm.CoverageFormCode = _coverageForm.CoverageFormCode.Trim();
        _coverageForm.CoverageTriggerCode = _coverageForm.CoverageTriggerCode.Trim();
        _coverageForm.ValuationBasisCode = _coverageForm.ValuationBasisCode.Trim();
        _coverageForm.TerritoryCode = _coverageForm.TerritoryCode.Trim();
        _coverageForm.ExposureBasisCode = _coverageForm.ExposureBasisCode.Trim();
        _coverageForm.CarrierName = _coverageForm.CarrierName.Trim();
        _coverageForm.WritingCompanyName = _coverageForm.WritingCompanyName.Trim();
        _coverageForm.UnderwriterName = _coverageForm.UnderwriterName.Trim();
        _coverageForm.StatusCode = _coverageForm.StatusCode.Trim();
    }

    private void NormalizeDynamicFields()
    {
        var sortOrder = 10;
        foreach (var field in _coverageForm.Fields)
        {
            field.FieldGroupCode = field.FieldGroupCode.Trim();
            field.FieldCode = field.FieldCode.Trim();
            field.FieldLabel = field.FieldLabel.Trim();
            field.FieldValue = field.FieldValue.Trim();
            field.FieldValueTypeCode = string.IsNullOrWhiteSpace(field.FieldValueTypeCode) ? "Text" : field.FieldValueTypeCode.Trim();
            field.UnitOfMeasureCode = field.UnitOfMeasureCode.Trim();
            if (field.SortOrder <= 0)
            {
                field.SortOrder = sortOrder;
            }

            sortOrder = Math.Max(sortOrder + 10, field.SortOrder + 10);
        }
    }

    private void AddDynamicField()
    {
        var next = _coverageForm.Fields.Count == 0 ? 10 : _coverageForm.Fields.Max(x => x.SortOrder) + 10;
        _coverageForm.Fields.Add(new CoverageFieldForm
        {
            FieldGroupCode = "General",
            FieldCode = $"FIELD_{next}",
            FieldLabel = "New Coverage Field",
            FieldValueTypeCode = "Text",
            SortOrder = next,
        });
    }

    private void RemoveDynamicField(CoverageFieldForm field)
        => _coverageForm.Fields.Remove(field);

    private IReadOnlyList<string> BuildValidationIssues()
    {
        var issues = new List<string>();
        AddMissing(issues, _coverageForm.CovCode, "coverage code");
        AddMissing(issues, _coverageForm.CovName, "coverage name");
        AddMissing(issues, _coverageForm.LineOfBusinessCode, "line of business");
        AddMissing(issues, _coverageForm.CoverageCategoryCode, "category");
        AddMissing(issues, _coverageForm.CoverageFormCode, "coverage form");
        AddMissing(issues, _coverageForm.CoverageTriggerCode, "coverage trigger");
        AddMissing(issues, _coverageForm.CarrierName, "carrier");
        AddMissing(issues, _coverageForm.StatusCode, "status");
        if (_coverageForm.ExpirationDate < _coverageForm.EffectiveDate)
        {
            issues.Add("expiration date must be on or after effective date");
        }

        foreach (var field in _coverageForm.Fields.Where(x => x.IsRequired && string.IsNullOrWhiteSpace(x.FieldValue)))
        {
            issues.Add($"{EmptyDash(field.FieldLabel)} value");
        }

        return issues;
    }

    private static void AddMissing(List<string> issues, string? value, string label)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            issues.Add(label);
        }
    }

    private string TabCompletionText(int tab) => tab switch
    {
        0 => IsIdentityComplete ? "Complete" : "Required",
        1 => "Synced",
        2 => IsTermComplete ? "Complete" : "Required",
        3 => "Synced",
        4 => DynamicRequiredMissing == 0 ? $"{_coverageForm.Fields.Count} field(s)" : $"{DynamicRequiredMissing} missing",
        _ => string.Empty
    };

    private string TabStateClass(int tab) => tab switch
    {
        0 when IsIdentityComplete => "pd-native-tab--complete",
        0 => "pd-native-tab--needs-attention",
        2 when IsTermComplete => "pd-native-tab--complete",
        2 => "pd-native-tab--needs-attention",
        4 when DynamicRequiredMissing > 0 => "pd-native-tab--needs-attention",
        _ => string.Empty
    };

    private bool IsIdentityComplete =>
        !string.IsNullOrWhiteSpace(_coverageForm.CovCode) &&
        !string.IsNullOrWhiteSpace(_coverageForm.CovName) &&
        !string.IsNullOrWhiteSpace(_coverageForm.LineOfBusinessCode) &&
        !string.IsNullOrWhiteSpace(_coverageForm.CoverageCategoryCode) &&
        !string.IsNullOrWhiteSpace(_coverageForm.CoverageFormCode) &&
        !string.IsNullOrWhiteSpace(_coverageForm.CoverageTriggerCode);

    private bool IsTermComplete =>
        !string.IsNullOrWhiteSpace(_coverageForm.CarrierName) &&
        !string.IsNullOrWhiteSpace(_coverageForm.StatusCode) &&
        _coverageForm.ExpirationDate >= _coverageForm.EffectiveDate;

    private int FirstInvalidTab()
    {
        if (!IsIdentityComplete) return 0;
        if (!IsTermComplete) return 2;
        if (DynamicRequiredMissing > 0) return 4;
        return _tab;
    }

    private static string SyncText(string currentValue, string? templateValue, bool overwriteExistingValues)
    {
        if (string.IsNullOrWhiteSpace(templateValue))
        {
            return overwriteExistingValues ? string.Empty : currentValue;
        }

        return overwriteExistingValues || string.IsNullOrWhiteSpace(currentValue) ? templateValue : currentValue;
    }

    private static decimal? SyncNullable(decimal? currentValue, decimal? templateValue, bool overwriteExistingValues)
        => overwriteExistingValues || !currentValue.HasValue ? templateValue : currentValue;

    private Task NotifyValidationAsync(EditContext _)
        => ShowErrorToast("Please correct the highlighted validation errors.");

    private void BackToPolicy()
        => Nav.NavigateTo($"/policies/{PolicyId}");

    private async Task ShowToast(string msg)
    {
        ShowNativeToast(msg, "success");
        await Task.CompletedTask;
    }

    private async Task ShowErrorToast(string msg)
    {
        ShowNativeToast(msg, "danger");
        await Task.CompletedTask;
    }

    private void ShowNativeToast(string message, string kind = "info")
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = new CancellationTokenSource();
        _toastMessage = message.Length <= 120 ? message : $"{message[..117]}...";
        _toastKind = ToastKind(kind);
        _toastVisible = true;
        StateHasChanged();
        _ = HideToastAfterDelayAsync(_toastCts.Token, _toastKind == "danger" ? 5200 : 3200);
    }

    private async Task HideToastAfterDelayAsync(CancellationToken cancellationToken, int delayMs)
    {
        try
        {
            await Task.Delay(delayMs, cancellationToken);
            _toastVisible = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void HideToast()
    {
        _toastCts?.Cancel();
        _toastVisible = false;
    }

    private static string ToastKind(string value) => value.Contains("danger", StringComparison.OrdinalIgnoreCase) || value.Contains("error", StringComparison.OrdinalIgnoreCase) ? "danger" : value.Contains("warning", StringComparison.OrdinalIgnoreCase) ? "warning" : value.Contains("success", StringComparison.OrdinalIgnoreCase) ? "success" : "info";

    private static string EmptyDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string? FirstNonEmpty(params string?[] values) => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
    private static IReadOnlyList<string> CoverageValueOptions(string? currentValue, params IEnumerable<string?>[] sources)
        => sources.SelectMany(x => x).Append(currentValue).Where(value => !string.IsNullOrWhiteSpace(value)).Select(value => value!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(value => value).ToList();

