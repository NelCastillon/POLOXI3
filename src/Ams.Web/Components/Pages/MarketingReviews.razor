@page "/marketing/reviews"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject IJSRuntime Js

<PageTitle>Reputation & Review Requests ? AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="mkv-toast mkv-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="mkv-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showReviewForm)
{
    <div class="mkv-modal-backdrop" role="presentation" @onclick="CloseForms">
        <div class="mkv-modal mkv-action-modal" role="dialog" aria-modal="true" aria-labelledby="mkv-review-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header"><i class="bi bi-star-fill" aria-hidden="true"></i><span id="mkv-review-form-title">@(_editingReviewId == Guid.Empty ? "Add Review" : "Edit Review")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForms" disabled="@_busy"><i class="bi bi-x-lg"></i></button></div>
            <EditForm Model="_reviewForm" OnValidSubmit="SaveReviewAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="mkv-modal-intro"><span><i class="bi bi-stars" aria-hidden="true"></i> Reputation record</span><p>Capture client review, source platform, rating, public content, and agency response for DB-backed reputation tracking.</p></div>
                    <div class="um-form-grid">
                        <div class="um-field"><label>Client name <span class="text-danger">*</span></label><InputText class="form-control" @bind-Value="_reviewForm.ClientName" /></div>
                        <div class="um-field"><label>Platform <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="_reviewForm.Platform">@foreach (var platform in _platforms) { <option value="@platform">@platform</option> }</InputSelect></div>
                        <div class="um-field"><label>Rating</label><InputNumber class="form-control" @bind-Value="_reviewForm.Rating" /></div>
                        <div class="um-field"><label>Review date</label><InputDate class="form-control" @bind-Value="_reviewForm.ReviewDate" /></div>
                        <div class="um-field um-field--full"><label>Review content <span class="text-danger">*</span></label><InputTextArea class="form-control" rows="4" @bind-Value="_reviewForm.Content" /></div>
                        <div class="um-field um-field--full"><label>Agency response</label><InputTextArea class="form-control" rows="3" @bind-Value="_reviewForm.Response" /></div>
                    </div>
                </div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForms" disabled="@_busy">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_busy">@(_editingReviewId == Guid.Empty ? "Add Review" : "Save Changes")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showRequestForm)
{
    <div class="mkv-modal-backdrop" role="presentation" @onclick="CloseForms">
        <div class="mkv-modal mkv-action-modal" role="dialog" aria-modal="true" aria-labelledby="mkv-request-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header"><i class="bi bi-send" aria-hidden="true"></i><span id="mkv-request-form-title">@(_editingRequestId == Guid.Empty ? "Send Review Request" : "Edit Review Request")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForms" disabled="@_busy"><i class="bi bi-x-lg"></i></button></div>
            <EditForm Model="_requestForm" OnValidSubmit="SaveRequestAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="mkv-modal-intro"><span><i class="bi bi-send-check" aria-hidden="true"></i> Request workflow</span><p>Send or update a review request with client, channel, destination platform, NPS signal, sent date, and completion state.</p></div>
                    <div class="um-form-grid">
                        <div class="um-field"><label>Client name <span class="text-danger">*</span></label><InputText class="form-control" @bind-Value="_requestForm.ClientName" /></div>
                        <div class="um-field"><label>Channel <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="_requestForm.Channel">@foreach (var channel in _channels) { <option value="@channel">@channel</option> }</InputSelect></div>
                        <div class="um-field"><label>Platform <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="_requestForm.Platform">@foreach (var platform in _platforms) { <option value="@platform">@platform</option> }</InputSelect></div>
                        <div class="um-field"><label>NPS score</label><InputNumber class="form-control" @bind-Value="_requestForm.NpsScore" /></div>
                        <div class="um-field"><label>Sent date</label><InputDate class="form-control" @bind-Value="_requestForm.SentDate" /></div>
                        <label class="mkv-form-check"><InputCheckbox @bind-Value="_requestForm.ReviewLeft" /> Review left</label>
                    </div>
                </div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForms" disabled="@_busy">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_busy">@(_editingRequestId == Guid.Empty ? "Send Request" : "Save Changes")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showConfirm)
{
    <div class="mkv-modal-backdrop" role="presentation" @onclick="CancelConfirm">
        <div class="mkv-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="mkv-confirm-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon @ConfirmIconTone"><i class="bi @ConfirmIcon"></i></div>
                <div class="um-confirm-title" id="mkv-confirm-title">@ConfirmTitle</div>
                <div class="um-confirm-body">@ConfirmBody</div>
                <div class="mkv-config-panel">
                    <span class="mkv-config-eyebrow"><i class="bi bi-sliders" aria-hidden="true"></i> Configuration required</span>
                    <div class="mkv-config-grid">
                        @if (_confirmAction == ConfirmAction.Reply)
                        {
                            <label class="mkv-config-full"><span>Response</span><textarea class="form-control" rows="4" @bind="_actionConfig.ResponseText"></textarea></label>
                            <label class="mkv-config-check"><input type="checkbox" @bind="_actionConfig.RefreshAfterAction" /> Refresh after reply</label>
                        }
                        else if (_confirmAction == ConfirmAction.CompleteRequest)
                        {
                            <label><span>Completion mode</span><select class="form-select" @bind="_actionConfig.ExecutionMode"><option value="MarkOnly">Mark request complete</option><option value="CreateReview">Mark complete and add review later</option></select></label>
                            <label class="mkv-config-check"><input type="checkbox" @bind="_actionConfig.RefreshAfterAction" /> Refresh after update</label>
                        }
                        else if (_confirmAction == ConfirmAction.DuplicateRequest)
                        {
                            <label class="mkv-config-full"><span>Copy label</span><input class="form-control" @bind="_actionConfig.NewName" /></label>
                            <label><span>Destination platform</span><select class="form-select" @bind="_actionConfig.Platform">@foreach (var platform in _platforms) { <option value="@platform">@platform</option> }</select></label>
                        }
                        else if (_confirmAction == ConfirmAction.ArchiveReview || _confirmAction == ConfirmAction.ArchiveRequest)
                        {
                            <label class="mkv-config-full"><span>Reason</span><input class="form-control" @bind="_actionConfig.Reason" placeholder="Document why this reputation record is being archived" /></label>
                            <label class="mkv-config-check"><input type="checkbox" @bind="_actionConfig.ExportBeforeAction" /> Export snapshot before archiving</label>
                        }
                        else if (_confirmAction == ConfirmAction.Sync)
                        {
                            <label><span>Seed mode</span><select class="form-select" @bind="_actionConfig.ExecutionMode"><option value="MissingOnly">Add missing seed data only</option><option value="RepairSchema">Repair schema and seed data</option></select></label>
                            <label class="mkv-config-check"><input type="checkbox" @bind="_actionConfig.RefreshAfterAction" /> Refresh after sync</label>
                        }
                        else if (_confirmAction == ConfirmAction.Export)
                        {
                            <label><span>Export dataset</span><select class="form-select" @bind="_actionConfig.ExecutionMode"><option value="Current">Current tab and filters</option><option value="Reviews">All reviews</option><option value="Requests">All requests</option></select></label>
                            <label class="mkv-config-check"><input type="checkbox" @bind="_actionConfig.IncludeResponses" /> Include responses and NPS data</label>
                        }
                    </div>
                </div>
                <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CancelConfirm" disabled="@_busy">Cancel</button><button type="button" class="um-btn @ConfirmButtonClass" @onclick="ExecuteConfirmAsync" disabled="@_busy">@ConfirmButtonText</button></div>
            </div>
        </div>
    </div>
}

<div class="mkv-enterprise-page">
    <section class="mkv-header">
        <div class="mkv-header-left"><div class="mkv-lob-icon"><i class="bi bi-star-fill" aria-hidden="true"></i></div><div class="mkv-header-info"><div class="mkv-title-row"><h1 class="mkv-page-title">Reputation & Review Requests</h1><span class="mkv-status-pill"><i class="bi bi-database-check"></i> Live reputation data</span><span class="mkv-status-pill"><i class="bi bi-shield-lock"></i> Tenant scoped</span></div><div class="mkv-sub-row"><span>Automate review requests, monitor public sentiment, and respond from a DB-backed command center.</span><span class="mkv-sub-chip"><i class="bi bi-stars"></i> @_filteredReviews.Count reviews</span><span class="mkv-sub-chip"><i class="bi bi-send-check"></i> @_filteredRequests.Count requests</span></div></div></div>
        <div class="mkv-header-actions"><button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi @(_loading ? "bi-arrow-repeat mkv-spin" : "bi-arrow-clockwise")"></i> Refresh</button><button type="button" class="um-btn um-btn-ghost" @onclick="ConfigureSync" disabled="@_busy"><i class="bi bi-cloud-arrow-down"></i> Sync Seed</button><button type="button" class="um-btn um-btn-ghost" @onclick="ConfigureExport" disabled="@(!_reviews.Any() && !_requests.Any())"><i class="bi bi-download"></i> Export</button><button type="button" class="um-btn um-btn-ghost" @onclick="OpenCreateReview"><i class="bi bi-star"></i> Add Review</button><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreateRequest"><i class="bi bi-send"></i> Send Request</button></div>
    </section>

    <section class="mkv-kpi-strip" aria-label="Reputation metrics">@foreach (var kpi in Kpis) { <button type="button" class="mkv-kpi-card @kpi.Tone @(_kpiFilter == kpi.Filter ? "mkv-kpi-active" : null)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)"><span class="mkv-kpi-icon"><i class="bi @kpi.Icon"></i></span><span class="mkv-kpi-copy"><span class="mkv-kpi-label">@kpi.Label</span><span class="mkv-kpi-value">@kpi.Value</span><span class="mkv-kpi-caption">@kpi.Caption</span></span></button> }</section>

    <section class="mkv-workflow-strip" aria-label="Review workflow shortcuts">
        <button type="button" class="mkv-workflow-card mkv-wf-rules" @onclick='() => Nav.NavigateTo("/tenant/config/marketing/review-request-rules")'><span class="mkv-workflow-icon"><i class="bi bi-sliders"></i></span><span class="mkv-workflow-content"><strong>1</strong><span>Rules</span><small>Request triggers.</small></span></button>
        <button type="button" class="mkv-workflow-card mkv-wf-segments" @onclick='() => Nav.NavigateTo("/marketing/segments")'><span class="mkv-workflow-icon"><i class="bi bi-pie-chart"></i></span><span class="mkv-workflow-content"><strong>2</strong><span>Segments</span><small>NPS promoters.</small></span></button>
        <button type="button" class="mkv-workflow-card mkv-wf-builder" @onclick='() => Nav.NavigateTo("/marketing/campaigns/new?goal=Reviews")'><span class="mkv-workflow-icon"><i class="bi bi-magic"></i></span><span class="mkv-workflow-content"><strong>3</strong><span>Builder</span><small>Review campaign.</small></span></button>
        <button type="button" class="mkv-workflow-card mkv-wf-email" @onclick='() => Nav.NavigateTo("/marketing/email")'><span class="mkv-workflow-icon"><i class="bi bi-envelope-paper"></i></span><span class="mkv-workflow-content"><strong>4</strong><span>Email</span><small>Request nurture.</small></span></button>
        <button type="button" class="mkv-workflow-card mkv-wf-pages" @onclick='() => Nav.NavigateTo("/marketing/landing-pages")'><span class="mkv-workflow-icon"><i class="bi bi-layout-text-window"></i></span><span class="mkv-workflow-content"><strong>5</strong><span>Pages</span><small>Review landing.</small></span></button>
    </section>

    <section class="mkv-enterprise-search" aria-label="Review filters">
        <div class="mkv-search-icon"><i class="bi bi-search"></i></div>
        <div class="mkv-search-body"><label for="mkv-search">Search reputation records</label><input id="mkv-search" class="mkv-search-input" type="search" placeholder="Search client, platform, content, response, channel..." @bind="SearchFilter" @bind:event="oninput" /><span class="mkv-search-hint">Filters apply instantly across reviews and review requests.</span></div>
        <select class="mkv-filter-select" @bind="PlatformFilter"><option value="">All platforms</option>@foreach (var platform in _platforms) { <option value="@platform">@platform</option> }</select>
        <select class="mkv-filter-select" @bind="RatingFilter"><option value="">Rating/NPS: all</option><option value="promoter">Promoters</option><option value="five">5-star</option><option value="low">Needs attention</option></select>
        <select class="mkv-filter-select" @bind="RequestFilter"><option value="">Requests: all</option><option value="completed">Completed</option><option value="pending">Pending</option></select>
        <div class="mkv-search-result"><strong>@ActiveCount</strong><span>matches</span></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError)) { <div class="alert alert-danger mkv-load-error" style="border-left:4px solid #dc3545; animation:um-shake .3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }

    <section class="mkv-content-layout">
        <div class="mkv-grid-wrap"><div class="mkv-grid-toolbar"><div><strong>Reputation command center</strong><span>@ActiveFilterText</span></div><div class="mkv-toolbar-actions"><button type="button" class="mkv-tab @(_tab == "reviews" ? "mkv-tab--active" : null)" @onclick='() => SetTab("reviews")'><i class="bi bi-star"></i> Reviews</button><button type="button" class="mkv-tab @(_tab == "requests" ? "mkv-tab--active" : null)" @onclick='() => SetTab("requests")'><i class="bi bi-send"></i> Requests</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-eraser"></i> Reset</button></div></div>
            @if (_loading) { <div class="mkv-loading"><i class="bi bi-arrow-repeat mkv-spin"></i><strong>Loading reputation data...</strong><span>Syncing reviews, requests, platforms, responses, NPS scores, and completion state.</span></div> }
            else if (_tab == "reviews")
            {
                @if (!_pagedReviews.Any()) { <div class="mkv-empty-state"><i class="bi bi-inbox"></i><strong>No reviews found</strong><span>Adjust filters or add a DB-backed review.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreateReview">Add Review</button></div> }
                else
                {
                    <div class="mkv-review-list">
                        @foreach (var review in _pagedReviews)
                        {
                            <article class="@ReviewCardCss(review)" @onclick="() => SelectReview(review)">
                                <div class="mkv-review-head"><span class="mkv-avatar">@Initials(review.ClientName)</span><div><strong>@review.ClientName</strong><span>@review.Platform ? @review.ReviewDate.ToString("MMM d, yyyy")</span></div><span class="mkv-stars">@RenderStars(review.Rating)</span><span class="mkv-platform-chip @PlatformCss(review.Platform)">@review.Platform</span></div>
                                <p>@review.Content</p>
                                @if (!string.IsNullOrWhiteSpace(review.Response)) { <div class="mkv-response"><i class="bi bi-reply"></i><span>@review.Response</span></div> }
                                <div class="mkv-card-actions"><button type="button" class="um-btn um-btn-primary um-btn-xs" @onclick="() => ConfigureReply(review)" @onclick:stopPropagation="true"><i class="bi bi-reply"></i> Reply</button><button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenEditReview(review)" @onclick:stopPropagation="true"><i class="bi bi-pencil"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => ConfigureArchiveReview(review)" @onclick:stopPropagation="true"><i class="bi bi-archive"></i></button></div>
                            </article>
                        }
                    </div>
                    <div class="mkv-pager"><span>Page @_reviewPage of @ReviewTotalPages ? @_filteredReviews.Count records</span><div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousReviewPage" disabled="@(_reviewPage <= 1)"><i class="bi bi-chevron-left"></i> Previous</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextReviewPage" disabled="@(_reviewPage >= ReviewTotalPages)">Next <i class="bi bi-chevron-right"></i></button></div></div>
                }
            }
            else
            {
                @if (!_pagedRequests.Any()) { <div class="mkv-empty-state"><i class="bi bi-inbox"></i><strong>No review requests found</strong><span>Adjust filters or send a DB-backed request.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreateRequest">Send Request</button></div> }
                else
                {
                    <div class="mkv-table-scroll"><table class="mkv-table"><thead><tr><th>Client</th><th>Channel</th><th>Sent</th><th>Platform</th><th>Completed</th><th class="mkv-number">NPS</th><th class="mkv-actions-col">Actions</th></tr></thead><tbody>@foreach (var request in _pagedRequests) { <tr class="@RequestRowCss(request)" @onclick="() => SelectRequest(request)"><td><div class="mkv-account-cell"><span class="mkv-avatar">@Initials(request.ClientName)</span><div><strong>@request.ClientName</strong><span>@(request.ReviewLeft ? "Review left" : "Awaiting review")</span></div></div></td><td>@request.Channel</td><td>@request.SentDate.ToString("MMM d, yyyy")</td><td><span class="mkv-platform-chip @PlatformCss(request.Platform)">@request.Platform</span></td><td><i class="bi @(request.ReviewLeft ? "bi-check-circle-fill mkv-chk" : "bi-x-circle mkv-xc")" aria-hidden="true"></i></td><td class="mkv-number">@request.NpsScore</td><td><div class="mkv-row-acts"><button type="button" class="um-btn um-btn-primary um-btn-xs" @onclick="() => ConfigureCompleteRequest(request)" @onclick:stopPropagation="true" title="Complete"><i class="bi bi-check2-circle"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenEditRequest(request)" @onclick:stopPropagation="true" title="Edit"><i class="bi bi-pencil"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => ConfigureDuplicateRequest(request)" @onclick:stopPropagation="true" title="Duplicate"><i class="bi bi-copy"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => ConfigureArchiveRequest(request)" @onclick:stopPropagation="true" title="Archive"><i class="bi bi-archive"></i></button></div></td></tr> }</tbody></table></div>
                    <div class="mkv-pager"><span>Page @_requestPage of @RequestTotalPages ? @_filteredRequests.Count records</span><div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousRequestPage" disabled="@(_requestPage <= 1)"><i class="bi bi-chevron-left"></i> Previous</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextRequestPage" disabled="@(_requestPage >= RequestTotalPages)">Next <i class="bi bi-chevron-right"></i></button></div></div>
                }
            }
        </div>
        <aside class="mkv-detail-panel">
            @if (_tab == "reviews")
            {
                @if (_selectedReview is null) { <div class="mkv-detail-empty"><i class="bi bi-layout-sidebar-inset"></i><strong>Select a review</strong><span>Click a review to inspect rating, response status, and reputation actions.</span></div> }
                else { <div class="mkv-detail-head"><div><span class="mkv-detail-eyebrow"><i class="bi bi-star"></i> Review detail</span><h2>@_selectedReview.ClientName</h2><div class="mkv-detail-meta"><span>@_selectedReview.Platform</span><span>@RenderStars(_selectedReview.Rating)</span></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearSelection"><i class="bi bi-x-lg"></i></button></div><div class="mkv-detail-body"><div class="mkv-detail-summary"><div class="mkv-meta-row"><span class="mkv-meta-lbl">Rating</span><span class="mkv-meta-val">@_selectedReview.Rating / 5</span></div><div class="mkv-meta-row"><span class="mkv-meta-lbl">Review date</span><span class="mkv-meta-val">@_selectedReview.ReviewDate.ToString("MMM d, yyyy")</span></div><div class="mkv-meta-row"><span class="mkv-meta-lbl">Platform</span><span class="mkv-meta-val">@_selectedReview.Platform</span></div><div class="mkv-meta-row"><span class="mkv-meta-lbl">Response</span><span class="mkv-meta-val">@(string.IsNullOrWhiteSpace(_selectedReview.Response) ? "Needed" : "Posted")</span></div></div><div class="mkv-contact-card"><strong>Review content</strong><span><i class="bi bi-chat-quote"></i>@_selectedReview.Content</span>@if (!string.IsNullOrWhiteSpace(_selectedReview.Response)) { <span><i class="bi bi-reply"></i>@_selectedReview.Response</span> }</div><div class="mkv-detail-actions"><button type="button" class="um-btn um-btn-primary" @onclick="() => ConfigureReply(_selectedReview)"><i class="bi bi-reply"></i> Reply</button><button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenEditReview(_selectedReview)"><i class="bi bi-pencil"></i> Edit</button><button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfigureArchiveReview(_selectedReview)"><i class="bi bi-archive"></i> Archive</button></div></div> }
            }
            else
            {
                @if (_selectedRequest is null) { <div class="mkv-detail-empty"><i class="bi bi-layout-sidebar-inset"></i><strong>Select a request</strong><span>Click a request to inspect NPS, channel, completion state, and actions.</span></div> }
                else { <div class="mkv-detail-head"><div><span class="mkv-detail-eyebrow"><i class="bi bi-send"></i> Request detail</span><h2>@_selectedRequest.ClientName</h2><div class="mkv-detail-meta"><span>@_selectedRequest.Channel</span><span>@_selectedRequest.Platform</span><span>@(_selectedRequest.ReviewLeft ? "Completed" : "Pending")</span></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearSelection"><i class="bi bi-x-lg"></i></button></div><div class="mkv-detail-body"><div class="mkv-detail-summary"><div class="mkv-meta-row"><span class="mkv-meta-lbl">NPS</span><span class="mkv-meta-val">@_selectedRequest.NpsScore</span></div><div class="mkv-meta-row"><span class="mkv-meta-lbl">Sent</span><span class="mkv-meta-val">@_selectedRequest.SentDate.ToString("MMM d, yyyy")</span></div><div class="mkv-meta-row"><span class="mkv-meta-lbl">Channel</span><span class="mkv-meta-val">@_selectedRequest.Channel</span></div><div class="mkv-meta-row"><span class="mkv-meta-lbl">Status</span><span class="mkv-meta-val">@(_selectedRequest.ReviewLeft ? "Review left" : "Awaiting review")</span></div></div><div class="mkv-contact-card"><strong>Request routing</strong><span><i class="bi bi-person-heart"></i>@_selectedRequest.ClientName</span><span><i class="bi bi-send"></i>@_selectedRequest.Channel</span><span><i class="bi bi-star"></i>@_selectedRequest.Platform</span></div><div class="mkv-detail-actions"><button type="button" class="um-btn um-btn-primary" @onclick="() => ConfigureCompleteRequest(_selectedRequest)"><i class="bi bi-check2-circle"></i> Complete</button><button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenEditRequest(_selectedRequest)"><i class="bi bi-pencil"></i> Edit</button><button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfigureDuplicateRequest(_selectedRequest)"><i class="bi bi-copy"></i> Duplicate</button><button type="button" class="um-btn um-btn-ghost" @onclick="() => ConfigureArchiveRequest(_selectedRequest)"><i class="bi bi-archive"></i> Archive</button></div></div> }
            }
        </aside>
    </section>
</div>

@code {
    private const int PageSize = 10;
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
