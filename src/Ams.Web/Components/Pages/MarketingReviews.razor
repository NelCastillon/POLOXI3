    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Marketing", "/marketing/campaigns"), new("Reviews", null)); await LoadAsync(); }
    private async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchMarketingReviewsAsync(_tenantId); _reviews = result?.Reviews.ToList() ?? []; _requests = result?.Requests.ToList() ?? []; ApplyFilters(); EnsureSelectedStillVisible(); } catch (Exception ex) { _loadError = $"Failed to load reputation data: {ex.Message}"; _reviews = []; _requests = []; _filteredReviews = []; _filteredRequests = []; _pagedReviews = []; _pagedRequests = []; } finally { _loading = false; } }
    private void ApplyFilters(bool resetPage = false) { var reviews = _reviews.AsEnumerable(); var requests = _requests.AsEnumerable(); if (!string.IsNullOrWhiteSpace(_search)) { reviews = reviews.Where(x => x.ClientName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Platform.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Content.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Response.Contains(_search, StringComparison.OrdinalIgnoreCase)); requests = requests.Where(x => x.ClientName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Platform.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Channel.Contains(_search, StringComparison.OrdinalIgnoreCase)); } if (!string.IsNullOrWhiteSpace(_platformFilter)) { reviews = reviews.Where(x => x.Platform == _platformFilter); requests = requests.Where(x => x.Platform == _platformFilter); } reviews = _ratingFilter switch { "promoter" => reviews.Where(x => x.Rating >= 4), "five" => reviews.Where(x => x.Rating == 5), "low" => reviews.Where(x => x.Rating <= 3), _ => reviews }; requests = _ratingFilter switch { "promoter" => requests.Where(x => x.NpsScore >= 9), "low" => requests.Where(x => x.NpsScore <= 6), _ => requests }; requests = _requestFilter switch { "completed" => requests.Where(x => x.ReviewLeft), "pending" => requests.Where(x => !x.ReviewLeft), _ => requests }; reviews = _kpiFilter switch { "rating" => reviews.Where(x => x.Rating >= 4), "google" => reviews.Where(x => x.Platform == "Google"), "needed" => reviews.Where(x => string.IsNullOrWhiteSpace(x.Response)), _ => reviews }; requests = _kpiFilter switch { "requests" => requests, "response" => requests.Where(x => x.ReviewLeft), _ => requests }; _filteredReviews = reviews.OrderByDescending(x => x.ReviewDate).ThenByDescending(x => x.Rating).ToList(); _filteredRequests = requests.OrderByDescending(x => x.SentDate).ThenByDescending(x => x.NpsScore).ToList(); if (resetPage) { _reviewPage = 1; _requestPage = 1; } if (_reviewPage > ReviewTotalPages) _reviewPage = ReviewTotalPages; if (_requestPage > RequestTotalPages) _requestPage = RequestTotalPages; _pagedReviews = _filteredReviews.Skip((_reviewPage - 1) * PageSize).Take(PageSize).ToList(); _pagedRequests = _filteredRequests.Skip((_requestPage - 1) * PageSize).Take(PageSize).ToList(); }
    private void SetTab(string tab) { _tab = tab; ClearSelection(); ApplyFilters(); }
    private void SetKpiFilter(string filter) { _kpiFilter = _kpiFilter == filter ? "all" : filter; if (filter is "requests" or "response") _tab = "requests"; if (filter is "rating" or "google" or "needed") _tab = "reviews"; ApplyFilters(resetPage: true); }
    private void ResetFilters() { _search = string.Empty; _platformFilter = string.Empty; _ratingFilter = string.Empty; _requestFilter = string.Empty; _kpiFilter = "all"; ApplyFilters(resetPage: true); }
    private void PreviousReviewPage() { if (_reviewPage <= 1) return; _reviewPage--; ApplyFilters(); }
    private void NextReviewPage() { if (_reviewPage >= ReviewTotalPages) return; _reviewPage++; ApplyFilters(); }
    private void PreviousRequestPage() { if (_requestPage <= 1) return; _requestPage--; ApplyFilters(); }
    private void NextRequestPage() { if (_requestPage >= RequestTotalPages) return; _requestPage++; ApplyFilters(); }
    private void SelectReview(MarketingReviewDto item) { _selectedReview = item; _selectedRequest = null; }
    private void SelectRequest(MarketingReviewRequestDto item) { _selectedRequest = item; _selectedReview = null; }
    private void ClearSelection() { _selectedReview = null; _selectedRequest = null; }
    private string ReviewCardCss(MarketingReviewDto item) => _selectedReview?.ReviewId == item.ReviewId ? "mkv-review-card mkv-review-card--selected" : "mkv-review-card";
    private string RequestRowCss(MarketingReviewRequestDto item) => _selectedRequest?.ReviewRequestId == item.ReviewRequestId ? "mkv-table-row mkv-table-row--selected" : "mkv-table-row";
    private void OpenCreateReview() { _editingReviewId = Guid.Empty; _reviewForm = new ReviewForm { Platform = "Google", Rating = 5, ReviewDate = DateTime.Today, Content = "Great service and responsive support." }; _showReviewForm = true; }
    private void OpenEditReview(MarketingReviewDto item) { _editingReviewId = item.ReviewId; _reviewForm = new() { ClientName = item.ClientName, Platform = item.Platform, Rating = item.Rating, ReviewDate = item.ReviewDate, Content = item.Content, Response = item.Response }; _showReviewForm = true; }
    private void OpenCreateRequest() { _editingRequestId = Guid.Empty; _requestForm = new ReviewRequestForm { Channel = "Email", Platform = "Google", SentDate = DateTime.Today, NpsScore = 9 }; _showRequestForm = true; }
    private void OpenEditRequest(MarketingReviewRequestDto item) { _editingRequestId = item.ReviewRequestId; _requestForm = new() { ClientName = item.ClientName, Channel = item.Channel, Platform = item.Platform, SentDate = item.SentDate, ReviewLeft = item.ReviewLeft, NpsScore = item.NpsScore }; _showRequestForm = true; }
    private void CloseForms() { if (_busy) return; _showReviewForm = false; _showRequestForm = false; _editingReviewId = Guid.Empty; _editingRequestId = Guid.Empty; }
    private async Task SaveReviewAsync() { _busy = true; try { var request = ToReviewDto(); if (_editingReviewId == Guid.Empty) { await Api.CreateMarketingReviewAsync(request); ShowToast("Review added.", "success"); } else { await Api.UpdateMarketingReviewAsync(_editingReviewId, request); ShowToast("Review saved.", "success"); } CloseForms(); await LoadAsync(); } catch (Exception ex) { ShowToast($"Save failed: {ex.Message}", "danger"); } finally { _busy = false; } }
    private async Task SaveRequestAsync() { _busy = true; try { var request = ToRequestDto(); if (_editingRequestId == Guid.Empty) { await Api.CreateMarketingReviewRequestAsync(request); ShowToast("Review request sent.", "success"); } else { await Api.UpdateMarketingReviewRequestAsync(_editingRequestId, request); ShowToast("Review request saved.", "success"); } CloseForms(); await LoadAsync(); } catch (Exception ex) { ShowToast($"Save failed: {ex.Message}", "danger"); } finally { _busy = false; } }
    private Task NotifyValidationAsync(EditContext _) { ShowToast("Please correct the validation errors before saving.", "warning"); return Task.CompletedTask; }
    private MarketingReviewDto ToReviewDto() => new() { ReviewId = _editingReviewId, TenantId = _tenantId, ClientName = _reviewForm.ClientName.Trim(), Platform = _reviewForm.Platform, Rating = _reviewForm.Rating, ReviewDate = _reviewForm.ReviewDate ?? DateTime.UtcNow, Content = _reviewForm.Content.Trim(), Response = _reviewForm.Response.Trim() };
    private MarketingReviewRequestDto ToRequestDto() => new() { ReviewRequestId = _editingRequestId, TenantId = _tenantId, ClientName = _requestForm.ClientName.Trim(), Channel = _requestForm.Channel, Platform = _requestForm.Platform, SentDate = _requestForm.SentDate ?? DateTime.UtcNow, ReviewLeft = _requestForm.ReviewLeft, NpsScore = _requestForm.NpsScore };
    private void ConfigureReply(MarketingReviewDto item) => ShowConfirm(item, null, ConfirmAction.Reply);
    private void ConfigureArchiveReview(MarketingReviewDto item) => ShowConfirm(item, null, ConfirmAction.ArchiveReview);
    private void ConfigureCompleteRequest(MarketingReviewRequestDto item) => ShowConfirm(null, item, ConfirmAction.CompleteRequest);
    private void ConfigureDuplicateRequest(MarketingReviewRequestDto item) => ShowConfirm(null, item, ConfirmAction.DuplicateRequest);
    private void ConfigureArchiveRequest(MarketingReviewRequestDto item) => ShowConfirm(null, item, ConfirmAction.ArchiveRequest);
    private void ConfigureSync() => ShowConfirm(null, null, ConfirmAction.Sync);
    private void ConfigureExport() => ShowConfirm(null, null, ConfirmAction.Export);
    private void ShowConfirm(MarketingReviewDto? review, MarketingReviewRequestDto? request, ConfirmAction action) { _confirmReview = review; _confirmRequest = request; _confirmAction = action; _actionConfig = CreateDefaultConfiguration(review, request, action); _showConfirm = true; }
    private void CancelConfirm() { if (_busy) return; _showConfirm = false; _confirmReview = null; _confirmRequest = null; }
    private async Task ExecuteConfirmAsync()
    {
        _busy = true;
        try
        {
            if (_confirmAction == ConfirmAction.Reply && _confirmReview is not null)
            {
                await Api.ReplyMarketingReviewAsync(_confirmReview.ReviewId, _actionConfig.ResponseText);
                ShowToast($"Reply saved for {_confirmReview.ClientName}.", "success");
            }
            else if (_confirmAction == ConfirmAction.CompleteRequest && _confirmRequest is not null)
            {
                await Api.CompleteMarketingReviewRequestAsync(_confirmRequest.ReviewRequestId);
                ShowToast($"Marked {_confirmRequest.ClientName}'s request complete.", "success");
            }
            else if (_confirmAction == ConfirmAction.DuplicateRequest && _confirmRequest is not null)
            {
                await Api.DuplicateMarketingReviewRequestAsync(_confirmRequest.ReviewRequestId);
                ShowToast($"Duplicated {_confirmRequest.ClientName}'s request.", "success");
            }
            else if (_confirmAction == ConfirmAction.ArchiveReview && _confirmReview is not null)
            {
                if (_actionConfig.ExportBeforeAction)
                {
                    await ExportReviewsAsync(new[] { _confirmReview });
                }

                await Api.ArchiveMarketingReviewAsync(_confirmReview.ReviewId);
                ShowToast($"Archived {_confirmReview.ClientName}'s review.", "success");
            }
            else if (_confirmAction == ConfirmAction.ArchiveRequest && _confirmRequest is not null)
            {
                if (_actionConfig.ExportBeforeAction)
                {
                    await ExportRequestsAsync(new[] { _confirmRequest });
                }

                await Api.ArchiveMarketingReviewRequestAsync(_confirmRequest.ReviewRequestId);
                ShowToast($"Archived {_confirmRequest.ClientName}'s request.", "success");
            }
            else if (_confirmAction == ConfirmAction.Sync)
            {
                await Api.EnsureMarketingReviewSeedAsync(_tenantId);
                ShowToast("Review seed data synchronized.", "success");
            }
            else if (_confirmAction == ConfirmAction.Export)
            {
                await ExportConfiguredAsync();
            }

            _showConfirm = false;
            _confirmReview = null;
            _confirmRequest = null;
            if (_confirmAction != ConfirmAction.Export && _actionConfig.RefreshAfterAction)
            {
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            ShowToast($"Action failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }
    private async Task ExportConfiguredAsync() { if (_actionConfig.ExecutionMode == "Reviews" || (_actionConfig.ExecutionMode == "Current" && _tab == "reviews")) { await ExportReviewsAsync(_actionConfig.ExecutionMode == "Reviews" ? _reviews : _filteredReviews); ShowToast("Reviews exported.", "success"); } else { await ExportRequestsAsync(_actionConfig.ExecutionMode == "Requests" ? _requests : _filteredRequests); ShowToast("Review requests exported.", "success"); } }
    private async Task ExportReviewsAsync(IReadOnlyCollection<MarketingReviewDto> items) { if (!items.Any()) return; var csv = new StringBuilder(); csv.AppendLine(_actionConfig.IncludeResponses ? "ClientName,Platform,Rating,ReviewDate,Content,Response" : "ClientName,Platform,Rating,ReviewDate,Content"); foreach (var item in items) { if (_actionConfig.IncludeResponses) csv.AppendLine(string.Join(',', Csv(item.ClientName), Csv(item.Platform), item.Rating, Csv(item.ReviewDate.ToString("yyyy-MM-dd")), Csv(item.Content), Csv(item.Response))); else csv.AppendLine(string.Join(',', Csv(item.ClientName), Csv(item.Platform), item.Rating, Csv(item.ReviewDate.ToString("yyyy-MM-dd")), Csv(item.Content))); } var bytes = Encoding.UTF8.GetBytes(csv.ToString()); await Js.InvokeVoidAsync("amsDownload.downloadBase64", $"marketing-reviews-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes)); }
    private async Task ExportRequestsAsync(IReadOnlyCollection<MarketingReviewRequestDto> items) { if (!items.Any()) return; var csv = new StringBuilder(); csv.AppendLine(_actionConfig.IncludeResponses ? "ClientName,Channel,SentDate,Platform,ReviewLeft,NpsScore" : "ClientName,Channel,SentDate,Platform,ReviewLeft"); foreach (var item in items) { if (_actionConfig.IncludeResponses) csv.AppendLine(string.Join(',', Csv(item.ClientName), Csv(item.Channel), Csv(item.SentDate.ToString("yyyy-MM-dd")), Csv(item.Platform), item.ReviewLeft, item.NpsScore)); else csv.AppendLine(string.Join(',', Csv(item.ClientName), Csv(item.Channel), Csv(item.SentDate.ToString("yyyy-MM-dd")), Csv(item.Platform), item.ReviewLeft)); } var bytes = Encoding.UTF8.GetBytes(csv.ToString()); await Js.InvokeVoidAsync("amsDownload.downloadBase64", $"marketing-review-requests-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes)); }
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind) { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void EnsureSelectedStillVisible() { if (_selectedReview is not null) _selectedReview = _reviews.FirstOrDefault(x => x.ReviewId == _selectedReview.ReviewId); if (_selectedRequest is not null) _selectedRequest = _requests.FirstOrDefault(x => x.ReviewRequestId == _selectedRequest.ReviewRequestId); }
    private static string RenderStars(int rating) => string.Concat(Enumerable.Range(1, 5).Select(i => i <= rating ? "?" : "?"));
    private static string Initials(string n) { var parts = n.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant() : n.Length > 0 ? n[..1].ToUpperInvariant() : "?"; }
    private static string PlatformCss(string platform) => $"mkv-plt-{platform.ToLowerInvariant()}";
    private static string Csv(string value) { var quote = Convert.ToChar(34).ToString(); return string.Concat(quote, value.Replace(quote, quote + quote), quote); }
    private static ActionConfiguration CreateDefaultConfiguration(MarketingReviewDto? review, MarketingReviewRequestDto? request, ConfirmAction action) => action switch
    {
        ConfirmAction.Reply => new() { ResponseText = string.IsNullOrWhiteSpace(review?.Response) ? "Thank you for sharing your experience. We appreciate your trust in our agency." : review.Response, RefreshAfterAction = true },
        ConfirmAction.CompleteRequest => new() { ExecutionMode = "MarkOnly", RefreshAfterAction = true },
        ConfirmAction.DuplicateRequest => new() { NewName = request?.ClientName ?? string.Empty, Platform = request?.Platform ?? "Google", RefreshAfterAction = true },
        ConfirmAction.ArchiveReview => new() { Reason = "No longer actionable", ExportBeforeAction = false, RefreshAfterAction = true },
        ConfirmAction.ArchiveRequest => new() { Reason = "No longer actionable", ExportBeforeAction = false, RefreshAfterAction = true },
        ConfirmAction.Sync => new() { ExecutionMode = "MissingOnly", RefreshAfterAction = true },
        ConfirmAction.Export => new() { ExecutionMode = "Current", IncludeResponses = true, RefreshAfterAction = false },
        _ => new()
    };
    async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); TenantId = context.TenantId; TenantAdminUserId = context.UserId; _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; DevTenantId = context.TenantId; DevUserId = context.UserId; }

    private sealed record KpiModel(string Filter, string Label, string Value, string Caption, string Icon, string Tone) { public string Title => $"Filter by {Label}"; }
    private enum ConfirmAction { Reply, CompleteRequest, DuplicateRequest, ArchiveReview, ArchiveRequest, Sync, Export }
    private sealed class ActionConfiguration { public string ExecutionMode { get; set; } = string.Empty; public string Reason { get; set; } = string.Empty; public string NewName { get; set; } = string.Empty; public string Platform { get; set; } = "Google"; public string ResponseText { get; set; } = string.Empty; public bool IncludeResponses { get; set; } = true; public bool ExportBeforeAction { get; set; } public bool RefreshAfterAction { get; set; } = true; }
    private sealed class ReviewForm { [Required, StringLength(200)] public string ClientName { get; set; } = string.Empty; [Required, StringLength(80)] public string Platform { get; set; } = "Google"; [Range(1, 5)] public int Rating { get; set; } = 5; public DateTime? ReviewDate { get; set; } = DateTime.Today; [Required, StringLength(2000)] public string Content { get; set; } = string.Empty; [StringLength(2000)] public string Response { get; set; } = string.Empty; }
    private sealed class ReviewRequestForm { [Required, StringLength(200)] public string ClientName { get; set; } = string.Empty; [Required, StringLength(80)] public string Channel { get; set; } = "Email"; [Required, StringLength(80)] public string Platform { get; set; } = "Google"; public DateTime? SentDate { get; set; } = DateTime.Today; public bool ReviewLeft { get; set; } [Range(0, 10)] public int NpsScore { get; set; } = 9; }
}
