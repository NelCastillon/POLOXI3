@page "/marketing/reviews"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Review Requests — AMS</PageTitle>

<AppPageHeader Title="Reputation &amp; Review Requests"
               Subtitle="Automate Google, Facebook, and Yelp review requests from satisfied policyholders"
               Icon="bi-star-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/marketing/campaigns/new")'>
            <i class="bi bi-megaphone" aria-hidden="true"></i> New Review Campaign
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenSend">
            <i class="bi bi-send" aria-hidden="true"></i> Send Requests
        </button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}

<!-- KPI -->
<div class="mkv-kpi-strip">
    <div class="mkv-kpi-card"><i class="bi bi-star-fill mkv-ki mkv-ki-gold"></i><div><div class="mkv-kv">@_avgRating.ToString("N1")</div><div class="mkv-kl">Avg. Rating</div></div></div>
    <div class="mkv-kpi-card"><i class="bi bi-chat-square-text mkv-ki mkv-ki-blue"></i><div><div class="mkv-kv">@_reviews.Count</div><div class="mkv-kl">Total Reviews</div></div></div>
    <div class="mkv-kpi-card"><i class="bi bi-send mkv-ki mkv-ki-blue"></i><div><div class="mkv-kv">@_requests.Count</div><div class="mkv-kl">Requests Sent</div></div></div>
    <div class="mkv-kpi-card"><i class="bi bi-check-circle mkv-ki mkv-ki-green"></i><div><div class="mkv-kv">@(_requests.Any() ? (_requests.Count(r => r.ReviewLeft) * 100m / _requests.Count).ToString("N1") : "0")%</div><div class="mkv-kl">Response Rate</div></div></div>
    <div class="mkv-kpi-card"><i class="bi bi-google mkv-ki mkv-ki-blue"></i><div><div class="mkv-kv">@_reviews.Count(r => r.Platform == "Google")</div><div class="mkv-kl">Google Reviews</div></div></div>
</div>

<!-- Tabs: Reviews / Requests -->
<div class="mkv-tabs">
    <button class="mkv-tab @(_tab == "reviews" ? "mkv-tab--active" : "")" @onclick='() => _tab = "reviews"'>
        <i class="bi bi-star" aria-hidden="true"></i> Recent Reviews
    </button>
    <button class="mkv-tab @(_tab == "requests" ? "mkv-tab--active" : "")" @onclick='() => _tab = "requests"'>
        <i class="bi bi-send" aria-hidden="true"></i> Sent Requests
    </button>
</div>

@if (_tab == "reviews")
{
    <div class="mkv-reviews-list position-relative">
        @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading reviews…</span></div> }
        @foreach (var rev in _reviews)
        {
            <div class="mkv-review-card">
                <div class="mkv-rev-header">
                    <div class="mkv-rev-av">@rev.ClientName[0]</div>
                    <div>
                        <div class="mkv-rev-name">@rev.ClientName</div>
                        <div class="mkv-rev-meta">@rev.Platform · @rev.Date.ToString("MMM d, yyyy")</div>
                    </div>
                    <div class="mkv-stars">@RenderStars(rev.Rating)</div>
                    <span class="mkv-plt-badge @PltCss(rev.Platform)">@rev.Platform</span>
                </div>
                <div class="mkv-rev-body">@rev.Content</div>
                @if (!string.IsNullOrEmpty(rev.Response))
                {
                    <div class="mkv-rev-response"><i class="bi bi-reply" aria-hidden="true"></i> <em>@rev.Response</em></div>
                }
                else
                {
                    <button class="um-btn um-btn-ghost um-btn-xs">
                        <i class="bi bi-reply" aria-hidden="true"></i> Reply
                    </button>
                }
            </div>
        }
    </div>
}
else
{
    <div class="app-datagrid" style="background:var(--um-bg-card);border:1px solid var(--um-border);border-radius:12px;overflow:hidden">
        <SfGrid CssClass="marketing-grid" TValue="ReviewRequest" DataSource="_requests" AllowPaging="true" AllowSorting="true" AllowTextWrap="true" EnableHover="true" RowHeight="60">
            <GridTextWrapSettings WrapMode="WrapMode.Content" />
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="@nameof(ReviewRequest.ClientName)" HeaderText="Client" MinWidth="280" />
                <GridColumn Field="@nameof(ReviewRequest.Channel)" HeaderText="Channel" Width="100" />
                <GridColumn Field="@nameof(ReviewRequest.SentDate)" HeaderText="Sent" Width="120" Type="ColumnType.Date" Format="MMM d, yyyy" />
                <GridColumn Field="@nameof(ReviewRequest.Platform)" HeaderText="Platform" Width="110">
                    <Template>@{ var r = (ReviewRequest)context; }<span class="mkv-plt-badge @PltCss(r.Platform)">@r.Platform</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(ReviewRequest.ReviewLeft)" HeaderText="Review Left" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                    <Template>@{ var r = (ReviewRequest)context; }<i class="bi @(r.ReviewLeft ? "bi-check-circle-fill mkv-chk" : "bi-x-circle mkv-xc")" aria-hidden="true"></i></Template>
                </GridColumn>
                <GridColumn Field="@nameof(ReviewRequest.NpsScore)" HeaderText="NPS" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
            </GridColumns>
        </SfGrid>
    </div>
}

<!-- Bulk send dialog -->
<SfDialog @bind-Visible="_showSend" Width="480px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-send" aria-hidden="true"></i><span>Send Review Requests</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showSend = false"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_sendEditContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field"><label>Client Name <span class="text-danger">*</span></label>
                    <InputText @bind-Value="_sendForm.ClientName" class="um-input" />
                    <ValidationMessage For="() => _sendForm.ClientName" class="validation-message text-danger" />
                </div>
                <div class="um-field"><label>Target Platform</label>
                    <InputSelect @bind-Value="_sendForm.Platform" class="um-input"><option>Google</option><option>Facebook</option><option>Yelp</option></InputSelect>
                    <ValidationMessage For="() => _sendForm.Platform" class="validation-message text-danger" />
                </div>
                <div class="um-field"><label>NPS Score</label>
                    <InputNumber @bind-Value="_sendForm.NpsScore" class="um-input" />
                    <ValidationMessage For="() => _sendForm.NpsScore" class="validation-message text-danger" />
                </div>
                <div class="um-field"><label>Channel</label>
                    <InputSelect @bind-Value="_sendForm.Channel" class="um-input"><option>Email</option><option>SMS</option><option>Both</option></InputSelect>
                    <ValidationMessage For="() => _sendForm.Channel" class="validation-message text-danger" />
                </div>
                @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
                </div></div>
            </EditForm>
        </Content>
        <FooterTemplate>
            <div class="um-modal-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showSend = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="SendRequestAsync">
                    <i class="bi bi-send" aria-hidden="true"></i> Send
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string _tab = "reviews";
    private bool _showSend;
    private bool _loading;
    private string? _loadError, _formError;
    private ReviewRequestForm _sendForm = new();
    private EditContext _sendEditContext = default!;

    private List<ReviewRow>     _reviews  = [];
    private List<ReviewRequest> _requests = [];
    private decimal _avgRating;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        _sendEditContext = new(_sendForm);
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Marketing","/marketing/campaigns"), new("Reviews",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try
        {
            var result = await Api.SearchMarketingReviewsAsync(_tenantId);
            _reviews = result?.Reviews.Select(x => new ReviewRow(x.ClientName, x.Platform, x.Rating, x.ReviewDate, x.Content, x.Response)).ToList() ?? [];
            _requests = result?.Requests.Select(x => new ReviewRequest(x.ClientName, x.Channel, x.SentDate, x.Platform, x.ReviewLeft, x.NpsScore)).ToList() ?? [];
            _avgRating = _reviews.Any() ? (decimal)_reviews.Average(r => r.Rating) : 0m;
        }
        catch (Exception ex) { _loadError = $"Failed to load reviews: {ex.Message}"; _reviews = []; _requests = []; _avgRating = 0; }
        finally { _loading = false; }
    }

    private static string RenderStars(int r) => string.Concat(Enumerable.Range(1, 5).Select(i => i <= r ? "★" : "☆"));
    private static string PltCss(string p) => p switch
    {
        "Google"   => "mkv-plt mkv-plt--google",
        "Facebook" => "mkv-plt mkv-plt--fb",
        "Yelp"     => "mkv-plt mkv-plt--yelp",
        _          => "mkv-plt",
    };

    private void OpenSend()
    {
        _sendForm = new();
        _sendEditContext = new(_sendForm);
        _formError = null;
        _showSend = true;
    }

    private async Task SendRequestAsync()
    {
        _formError = null;
        if (!_sendEditContext.Validate()) return;
        try
        {
            await Api.CreateMarketingReviewRequestAsync(new MarketingReviewRequestDto { TenantId = _tenantId, ClientName = _sendForm.ClientName, Channel = _sendForm.Channel, Platform = _sendForm.Platform, NpsScore = _sendForm.NpsScore });
            _showSend = false;
            await LoadAsync();
        }
        catch (Exception ex) { _formError = $"Send failed: {ex.Message}"; }
    }

    private sealed record ReviewRow(string ClientName, string Platform, int Rating, DateTime Date, string Content, string Response);
    private sealed record ReviewRequest(string ClientName, string Channel, DateTime SentDate, string Platform, bool ReviewLeft, int NpsScore);

    private sealed class ReviewRequestForm
    {
        [Required, StringLength(200)] public string ClientName { get; set; } = string.Empty;
        [Required, StringLength(80)] public string Channel { get; set; } = "Email";
        [Required, StringLength(80)] public string Platform { get; set; } = "Google";
        [Range(1, 10)] public int NpsScore { get; set; } = 9;
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
