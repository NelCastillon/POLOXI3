@page "/client/account-health"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos
@using Ams.Web.Components.Pages.Accounts

<PageTitle>Account Health — Tenant Admin</PageTitle>

<AppPageHeader Title="Account Health" Subtitle="Tenant Admin health scoring across customer accounts" Icon="bi-heart-pulse"><Actions><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<section class="ma-hero acct-hero"><div><span class="ma-eyebrow">Tenant Admin · Account Intelligence</span><h2>Account Health Monitor</h2><p>Prioritize account attention using activity, portal, revenue, lifecycle, and relationship signals.</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-primary" @onclick='() => SetFilter("risk")'><i class="bi bi-exclamation-triangle"></i> At Risk</button></div></section>
<div class="pc-kpi-strip acct-kpi-strip"><div class="pc-kpi-card @(_activeFilter is null ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter(null)'><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-heart-pulse"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Accounts</div></div></div><div class="pc-kpi-card @(_activeFilter == "healthy" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("healthy")'><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.Score >= 75)</div><div class="pc-kpi-label">Healthy</div></div></div><div class="pc-kpi-card @(_activeFilter == "watch" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("watch")'><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-eye"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.Score is >= 50 and < 75)</div><div class="pc-kpi-label">Watch</div></div></div><div class="pc-kpi-card @(_activeFilter == "risk" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("risk")'><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-exclamation-triangle"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.Score < 50)</div><div class="pc-kpi-label">At Risk</div></div></div></div>
<div class="ma-filter-bar acct-filter-bar"><div class="ma-search-wrap"><i class="bi bi-search"></i><input class="ma-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search accounts, segment, lifecycle…" /></div><button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button><span class="ma-filter-count">@Filtered.Count() accounts</span></div>
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading account health…</span></div> }<SfGrid TValue="AccountHealthItem" DataSource="@Filtered.ToList()" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="56"><GridEvents TValue="AccountHealthItem" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" /><GridColumns><GridColumn HeaderText="Account" MinWidth="240"><Template>@{ var h=(AccountHealthItem)context; }<div class="acct-name-cell"><div class="acct-avatar">@AccountPageConstants.Initials(h.AccountName)</div><div><strong>@h.AccountName</strong><div class="text-muted">@h.AccountNumber · @h.Segment</div></div></div></Template></GridColumn><GridColumn Field="Score" HeaderText="Score" Width="110" TextAlign="TextAlign.Center"><Template>@{ var h=(AccountHealthItem)context; }<strong class="acct-health-score acct-health-@h.Tone">@h.Score</strong></Template></GridColumn><GridColumn Field="Status" HeaderText="Health" Width="130"><Template>@{ var h=(AccountHealthItem)context; }<span class="um-badge @h.Badge">@h.Status</span></Template></GridColumn><GridColumn Field="Signal" HeaderText="Top Signal" MinWidth="240" /><GridColumn Field="AnnualRevenue" HeaderText="Revenue" Width="130" TextAlign="TextAlign.Right"><Template>@{ var h=(AccountHealthItem)context; }@(h.AnnualRevenue?.ToString("C0") ?? "—")</Template></GridColumn><GridColumn Field="Lifecycle" HeaderText="Lifecycle" Width="130" /></GridColumns></SfGrid></div>
@code { sealed record AccountHealthItem(Guid AccountId, string AccountName, string AccountNumber, string Segment, string Lifecycle, decimal? AnnualRevenue, int Score, string Status, string Signal, string Tone, string Badge); List<AccountHealthItem> _items = []; string _search = string.Empty; string? _activeFilter, _loadError; bool _loading; IEnumerable<AccountHealthItem> Filtered => _items.Where(x => (_activeFilter switch { "healthy" => x.Score >= 75, "watch" => x.Score is >= 50 and < 75, "risk" => x.Score < 50, _ => true }) && (string.IsNullOrWhiteSpace(_search) || x.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.AccountNumber.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Segment.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.Lifecycle.Contains(_search, StringComparison.OrdinalIgnoreCase))); protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Accounts", "/accounts"), new("Account Health")); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { var accounts = (await Api.SearchAccountsAsync(AccountPageConstants.TenantId))?.Items.ToList() ?? []; var notes = (await Api.SearchAccountNotesAsync(AccountPageConstants.TenantId))?.Items.ToList() ?? []; var invites = (await Api.SearchPortalInvitesAsync(AccountPageConstants.TenantId))?.Items.ToList() ?? []; _items = accounts.Select(a => BuildHealth(a, notes.Count(n => n.AccountId == a.AccountId && n.NoteTypeCode == "Critical"), invites.Count(i => i.AccountId == a.AccountId && i.StatusCode == "Accepted"))).ToList(); } catch (Exception ex) { _loadError = $"Failed to load account health: {ex.Message}"; } finally { _loading = false; } } static AccountHealthItem BuildHealth(AccountDto a, int criticalNotes, int acceptedInvites) { var score = 55 + (a.StatusCode == "Active" ? 15 : 0) + (a.AnnualRevenue >= 1000000 ? 10 : 0) + (acceptedInvites > 0 ? 10 : 0) - (criticalNotes * 20); score = Math.Clamp(score, 0, 100); var status = score >= 75 ? "Healthy" : score >= 50 ? "Watch" : "At Risk"; var tone = score >= 75 ? "success" : score >= 50 ? "warning" : "danger"; var badge = score >= 75 ? "um-badge-success" : score >= 50 ? "um-badge-warning" : "um-badge-danger"; var signal = criticalNotes > 0 ? $"{criticalNotes} critical note(s) require attention" : acceptedInvites > 0 ? "Portal relationship established" : "Needs engagement signal"; return new(a.AccountId, a.AccountName, a.AccountNumber, a.SegmentCode ?? "Unsegmented", a.LifecycleStageCode ?? "Unknown", a.AnnualRevenue, score, status, signal, tone, badge); } void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; } void SetFilter(string? key) { _activeFilter = key; } void ResetFilters() { _activeFilter = null; _search = string.Empty; } void OnRowSelected(RowSelectEventArgs<AccountHealthItem> args) => Nav.NavigateTo($"/accounts/{args.Data.AccountId}"); }
