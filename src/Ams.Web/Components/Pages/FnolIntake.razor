@page "/claims/new"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.Claims
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Nav
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject Ams.Web.Services.ApiClient Api

<PageTitle>FNOL Intake - AMS</PageTitle>

<div class="fnol-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="fnol-toast @toast.CssClass">
            <i class="bi @toast.Icon" aria-hidden="true"></i>
            <span>@toast.Content</span>
            <button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
    }
</div>

@if (_showConfirm)
{
    <div class="fnol-modal-backdrop" role="presentation" @onclick="CloseConfirm">
        <div class="fnol-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="fnolConfirmTitle" @onclick:stopPropagation="true">
            <div class="fnol-confirm-icon"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></div>
            <h2 id="fnolConfirmTitle">FNOL submitted</h2>
            <p>Claim <strong>@_assignedClaimNumber</strong> was created from the DB-backed claims workflow.</p>
            <div class="fnol-confirm-chips">
                <span><i class="bi bi-shield" aria-hidden="true"></i>@_form.PolicyNumber</span>
                <span><i class="bi bi-calendar-event" aria-hidden="true"></i>@_form.DateOfLoss.ToString("MMM d, yyyy")</span>
                <span><i class="bi bi-person-badge" aria-hidden="true"></i>@_form.AssignedHandler</span>
            </div>
            <div class="fnol-confirm-actions">
                <button type="button" class="fnol-btn fnol-btn-ghost" @onclick='() => Nav.NavigateTo("/claims")'><i class="bi bi-list-ul" aria-hidden="true"></i> Claims Register</button>
                <button type="button" class="fnol-btn fnol-btn-primary" @onclick="StartAnother"><i class="bi bi-plus-lg" aria-hidden="true"></i> New FNOL</button>
            </div>
        </div>
    </div>
}

<div class="fnol-enterprise-page">
    <section class="fnol-hero">
        <div class="fnol-hero-left">
            <div class="fnol-hero-icon"><i class="bi bi-clipboard-plus" aria-hidden="true"></i></div>
            <div>
                <div class="fnol-title-row">
                    <h1>FNOL Intake Center</h1>
                    <span><i class="bi bi-building" aria-hidden="true"></i>@(_userContext?.TenantName ?? "Tenant")</span>
                    <span><i class="bi bi-diagram-3" aria-hidden="true"></i>@StepTitle</span>
                </div>
                <p>Capture first notice of loss, policy identity, loss facts, claimant information, coverage review, assignment, and carrier reporting in a guided enterprise workflow.</p>
            </div>
        </div>
        <div class="fnol-hero-actions">
            <button type="button" class="fnol-btn fnol-btn-ghost" @onclick='() => Nav.NavigateTo("/claims")'><i class="bi bi-arrow-left" aria-hidden="true"></i> Claims Register</button>
            <button type="button" class="fnol-btn fnol-btn-ghost" @onclick='() => Nav.NavigateTo("/claims/follow-up")'><i class="bi bi-list-check" aria-hidden="true"></i> Follow-Up</button>
            <button type="button" class="fnol-btn fnol-btn-ghost" @onclick='() => Nav.NavigateTo("/claims/catastrophe")'><i class="bi bi-cloud-lightning" aria-hidden="true"></i> CAT Mode</button>
            <button type="button" class="fnol-btn fnol-btn-primary" @onclick="SubmitFnolAsync" disabled="@(!CanSubmit || _submitting)"><i class="bi bi-check-lg" aria-hidden="true"></i> Submit FNOL</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="fnol-error-banner" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>@_loadError</div>
    }

    <section class="fnol-kpi-strip" aria-label="FNOL readiness KPIs">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="@KpiClass(kpi)" title="@kpi.Title" @onclick="() => GoToStep(kpi.Step)">
                <span class="fnol-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span><strong>@kpi.Value</strong><small>@kpi.Label</small><em>@kpi.Detail</em></span>
            </button>
        }
    </section>

    <section class="fnol-workflow-strip" aria-label="FNOL steps">
        @for (var i = 0; i < _steps.Length; i++)
        {
            var idx = i;
            <button type="button" class="@StepClass(idx)" @onclick="() => GoToStep(idx)">
                <i class="bi @_steps[idx].Icon" aria-hidden="true"></i>
                <span><strong>@_steps[idx].Title</strong><small>@StepStatus(idx)</small></span>
            </button>
        }
    </section>

    <div class="fnol-content-layout">
        <main class="fnol-main-card">
            <div class="fnol-card-head">
                <div><h2>@StepTitle</h2><p>@StepSubtitle</p></div>
                <span>Step @(_step + 1) of @_steps.Length</span>
            </div>

            <EditForm Model="_form" OnValidSubmit="SubmitFnolAsync" OnInvalidSubmit="NotifyInvalidAsync">
                <DataAnnotationsValidator />
                <div class="fnol-panel-body">
                    @if (_step == 0)
                    {
                        <section class="fnol-form-section">
                            <div class="fnol-form-banner"><i class="bi bi-shield-check" aria-hidden="true"></i><div><strong>Policy identity</strong><span>No policy lookup API is available, so enter verified policy details from the source policy record.</span></div></div>
                            <div class="fnol-form-grid">
                                <div class="fnol-field"><label>Policy Number <span>*</span></label><InputText class="fnol-input" @bind-Value="_form.PolicyNumber" placeholder="Policy number" /></div>
                                <div class="fnol-field"><label>Insured / Account <span>*</span></label><InputText class="fnol-input" @bind-Value="_form.AccountName" placeholder="Named insured" /></div>
                                <div class="fnol-field"><label>Line of Business <span>*</span></label><InputSelect class="fnol-input" @bind-Value="_form.Lob"><option value="">Select LOB</option>@foreach (var lob in _lobs) { <option value="@lob">@lob</option> }</InputSelect></div>
                                <div class="fnol-field"><label>Carrier <span>*</span></label><InputText class="fnol-input" @bind-Value="_form.Carrier" placeholder="Carrier" /></div>
                                <div class="fnol-field"><label>Policy Effective</label><InputDate class="fnol-input" @bind-Value="_form.PolicyEffectiveDate" /></div>
                                <div class="fnol-field"><label>Policy Expiration</label><InputDate class="fnol-input" @bind-Value="_form.PolicyExpirationDate" /></div>
                            </div>
                        </section>
                    }
                    else if (_step == 1)
                    {
                        <section class="fnol-form-section">
                            <div class="fnol-form-grid">
                                <div class="fnol-field"><label>Date of Loss <span>*</span></label><InputDate class="fnol-input" @bind-Value="_form.DateOfLoss" /></div>
                                <div class="fnol-field"><label>Date Reported <span>*</span></label><InputDate class="fnol-input" @bind-Value="_form.DateReported" /></div>
                                <div class="fnol-field"><label>Estimated Loss</label><InputNumber class="fnol-input" @bind-Value="_form.EstimatedAmount" /></div>
                                <div class="fnol-field"><label>Loss Type <span>*</span></label><InputSelect class="fnol-input" @bind-Value="_form.LossType"><option value="">Select loss type</option>@foreach (var type in _lossTypes) { <option value="@type">@type</option> }</InputSelect></div>
                                <div class="fnol-field"><label>Cause of Loss</label><InputSelect class="fnol-input" @bind-Value="_form.CauseOfLoss"><option value="">Select cause</option>@foreach (var cause in _causesOfLoss) { <option value="@cause">@cause</option> }</InputSelect></div>
                                <div class="fnol-field"><label>State of Loss</label><InputSelect class="fnol-input" @bind-Value="_form.StateOfLoss"><option value="">Select state</option>@foreach (var state in _usStates) { <option value="@state">@state</option> }</InputSelect></div>
                                <div class="fnol-field fnol-field-wide"><label>Loss Location</label><InputText class="fnol-input" @bind-Value="_form.LossLocation" placeholder="Street, city, state, ZIP" /></div>
                                <div class="fnol-field fnol-field-wide"><label>Loss Description <span>*</span></label><InputTextArea class="fnol-input" rows="5" @bind-Value="_form.LossDescription" placeholder="Describe the loss event, damages, parties, injuries, and immediate next action" /></div>
                            </div>
                        </section>
                    }
                    else if (_step == 2)
                    {
                        <section class="fnol-form-section">
                            <div class="fnol-form-grid">
                                <div class="fnol-field"><label>Primary Claimant <span>*</span></label><InputText class="fnol-input" @bind-Value="_form.PrimaryClaimant" placeholder="Full name" /></div>
                                <div class="fnol-field"><label>Claimant Phone</label><InputText class="fnol-input" @bind-Value="_form.PrimaryClaimantPhone" placeholder="(555) 123-4567" /></div>
                                <div class="fnol-field"><label>Claimant Email</label><InputText class="fnol-input" type="email" @bind-Value="_form.PrimaryClaimantEmail" placeholder="email@domain.com" /></div>
                                <div class="fnol-field"><label>Injury / Damage Type</label><InputSelect class="fnol-input" @bind-Value="_form.PrimaryInjuryType"><option value="">Select type</option>@foreach (var injury in _injuryTypes) { <option value="@injury">@injury</option> }</InputSelect></div>
                                <div class="fnol-field"><label>Litigation Status</label><InputSelect class="fnol-input" @bind-Value="_form.LitigationStatus">@foreach (var status in _litigationStatuses) { <option value="@status">@status</option> }</InputSelect></div>
                                <div class="fnol-field"><label>Third Party</label><InputSelect class="fnol-input" @bind-Value="_form.ThirdParty">@foreach (var option in _thirdPartyOptions) { <option value="@option">@option</option> }</InputSelect></div>
                            </div>
                        </section>
                    }
                    else if (_step == 3)
                    {
                        <section class="fnol-form-section">
                            <div class="fnol-coverage-grid">
                                @CoverageCard("Policy in force", PolicyInForceText, PolicyInForce ? "fnol-good" : "fnol-warn-tone", "bi-shield-check")
                                @CoverageCard("Loss vs deductible", DeductibleText, DeductibleExceeded ? "fnol-good" : "fnol-warn-tone", "bi-safe")
                                @CoverageCard("CAT indicator", string.IsNullOrWhiteSpace(_form.CatCode) ? "Standard loss" : _form.CatCode, string.IsNullOrWhiteSpace(_form.CatCode) ? "fnol-neutral" : "fnol-warn-tone", "bi-cloud-lightning")
                                @CoverageCard("Litigation", _form.LitigationStatus, _form.IsLitigation ? "fnol-warn-tone" : "fnol-good", "bi-gavel")
                            </div>
                            <div class="fnol-form-grid fnol-mt">
                                <div class="fnol-field"><label>Coverage Limit</label><InputNumber class="fnol-input" @bind-Value="_form.CoverageLimit" /></div>
                                <div class="fnol-field"><label>Deductible</label><InputNumber class="fnol-input" @bind-Value="_form.Deductible" /></div>
                                <div class="fnol-field"><label>CAT Event Tag</label><InputText class="fnol-input" @bind-Value="_form.CatCode" placeholder="CAT code if applicable" /></div>
                                <div class="fnol-field"><label>Priority</label><InputSelect class="fnol-input" @bind-Value="_form.Priority">@foreach (var priority in _priorities) { <option value="@priority">@priority</option> }</InputSelect></div>
                                <div class="fnol-field fnol-field-wide"><label>Coverage Notes</label><InputTextArea class="fnol-input" rows="4" @bind-Value="_form.CoverageNotes" placeholder="Coverage reservation, exclusion questions, deductible notes, or underwriter review needs" /></div>
                                <div class="fnol-check-row fnol-field-wide"><label><InputCheckbox @bind-Value="_form.IsDisputed" /> Coverage disputed</label><label><InputCheckbox @bind-Value="_form.HasSubrogation" /> Subrogation potential</label><label><InputCheckbox @bind-Value="_form.IsCatastrophe" /> Catastrophe claim</label></div>
                            </div>
                        </section>
                    }
                    else
                    {
                        <section class="fnol-form-section">
                            <div class="fnol-form-grid">
                                <div class="fnol-field"><label>Claims Handler <span>*</span></label><InputText class="fnol-input" @bind-Value="_form.AssignedHandler" placeholder="Assigned handler" /></div>
                                <div class="fnol-field"><label>Reported By</label><InputText class="fnol-input" @bind-Value="_form.ReportedBy" placeholder="Reporter name" /></div>
                                <div class="fnol-field"><label>Carrier Claim #</label><InputText class="fnol-input" @bind-Value="_form.CarrierClaimNumber" placeholder="Carrier reference" /></div>
                                <div class="fnol-field"><label>Carrier Report Date</label><InputDate class="fnol-input" @bind-Value="_form.CarrierReportDate" /></div>
                                <div class="fnol-field fnol-field-wide"><label>Internal Notes</label><InputTextArea class="fnol-input" rows="4" @bind-Value="_form.InternalNotes" placeholder="Internal handling notes, next actions, and carrier reporting context" /></div>
                            </div>
                            <div class="fnol-review-card">
                                <div class="fnol-review-head"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Submission Summary</div>
                                <div class="fnol-review-grid">
                                    @ReviewRow("Policy", _form.PolicyNumber)
                                    @ReviewRow("Insured", _form.AccountName)
                                    @ReviewRow("LOB / Carrier", $"{_form.Lob} / {_form.Carrier}")
                                    @ReviewRow("Loss", $"{_form.LossType} on {_form.DateOfLoss:MM/dd/yyyy}")
                                    @ReviewRow("Claimant", _form.PrimaryClaimant)
                                    @ReviewRow("Priority", _form.Priority)
                                    @ReviewRow("Handler", _form.AssignedHandler)
                                    @ReviewRow("Flags", FlagSummary)
                                </div>
                            </div>
                        </section>
                    }
                </div>

                <div class="fnol-nav">
                    <div>
                        @if (_step > 0)
                        {
                            <button type="button" class="fnol-btn fnol-btn-ghost fnol-btn-light" @onclick="PrevStep"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back</button>
                        }
                    </div>
                    <div class="fnol-nav-right">
                        <button type="button" class="fnol-btn fnol-btn-ghost fnol-btn-light" @onclick="ResetForm"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset</button>
                        @if (_step < _steps.Length - 1)
                        {
                            <button type="button" class="fnol-btn fnol-btn-primary fnol-btn-blue" @onclick="NextStep" disabled="@(!CanAdvance)">Next <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                        }
                        else
                        {
                            <button type="submit" class="fnol-btn fnol-btn-primary fnol-btn-blue" disabled="@(!CanSubmit || _submitting)">@(_submitting ? "Submitting..." : "Submit FNOL")</button>
                        }
                    </div>
                </div>
            </EditForm>
        </main>

        <aside class="fnol-detail-card">
            <div class="fnol-detail-head"><span class="fnol-detail-eyebrow"><i class="bi bi-activity" aria-hidden="true"></i> Intake Readiness</span><h2>@ReadinessLabel</h2><p>@ReadinessDetail</p></div>
            <div class="fnol-detail-body">
                <div class="fnol-detail-summary">
                    <div><span>Required</span><strong>@RequiredComplete/@RequiredTotal</strong></div>
                    <div><span>Severity</span><strong>@SeverityLabel</strong></div>
                    <div><span>Lag</span><strong>@ReportingLagLabel</strong></div>
                    <div><span>Persisted To</span><strong>Claims API</strong></div>
                </div>
                <div class="fnol-contact-card"><strong>@DisplayValue(_form.AccountName, "Insured not entered")</strong><span>@DisplayValue(_form.PolicyNumber, "Policy not entered")</span><span>@DisplayValue(_form.LossType, "Loss type not selected")</span></div>
                <div class="fnol-flag-grid">
                    @FlagChip(_form.IsLitigation, "Litigation", "bi-gavel")
                    @FlagChip(_form.HasSubrogation, "Subrogation", "bi-arrow-counterclockwise")
                    @FlagChip(_form.IsCatastrophe || !string.IsNullOrWhiteSpace(_form.CatCode), "CAT", "bi-cloud-lightning")
                    @FlagChip(_form.IsDisputed, "Disputed", "bi-shield-exclamation")
                </div>
            </div>
        </aside>
    </div>
</div>

@code {
    private CurrentUserContextModel? _userContext;
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private int _step;
    private bool _showConfirm;
    private bool _submitting;
    private string? _loadError;
    private string _assignedClaimNumber = string.Empty;
    private FnolForm _form = new();
    private readonly List<FnolToast> _toasts = [];

    private readonly StepDef[] _steps = [new("Policy", "Policy Identity", "bi-shield-check"), new("Loss", "Loss Details", "bi-exclamation-triangle"), new("Claimant", "Claimant", "bi-people"), new("Coverage", "Coverage Review", "bi-shield-half"), new("Submit", "Assignment & Submit", "bi-person-gear")];
    private readonly string[] _lobs = ["General Liability", "Commercial Auto", "Commercial Property", "Workers Comp", "Umbrella", "Professional Liab.", "Home/Dwelling", "Personal Auto"];
    private readonly string[] _lossTypes = ["Bodily Injury", "Property Damage", "Auto Collision", "Auto Comprehensive", "Workers Comp Injury", "Product Liability", "Professional Error", "Theft", "Fire", "Water/Flood", "Wind/Hail", "Slip & Fall", "Equipment Breakdown", "Other"];
    private readonly string[] _causesOfLoss = ["Slip & Fall", "Vehicle Collision", "Fire", "Water Damage", "Theft", "Wind/Hail", "Employee Injury", "Product Defect", "Professional Negligence", "Other"];
    private readonly string[] _injuryTypes = ["Bodily Injury", "Property Damage", "Medical Expenses", "Lost Wages", "Vehicle Damage", "Building Damage", "Equipment Loss", "Wrongful Death", "Unknown"];
    private readonly string[] _litigationStatuses = ["No", "Possible", "Attorney Retained", "Suit Filed"];
    private readonly string[] _thirdPartyOptions = ["No", "Yes - Known", "Yes - Unknown"];
    private readonly string[] _priorities = ["Standard", "High", "Critical"];
    private readonly string[] _usStates = ["", "AL", "AK", "AZ", "AR", "CA", "CO", "CT", "DE", "FL", "GA", "HI", "ID", "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD", "MA", "MI", "MN", "MS", "MO", "MT", "NE", "NV", "NH", "NJ", "NM", "NY", "NC", "ND", "OH", "OK", "OR", "PA", "RI", "SC", "SD", "TN", "TX", "UT", "VT", "VA", "WA", "WV", "WI", "WY"];

    private string StepTitle => _steps[_step].Title;
    private string StepSubtitle => _step switch { 0 => "Enter verified policy identity and insured details.", 1 => "Capture loss timing, classification, location, and narrative.", 2 => "Capture claimant and third-party severity signals.", 3 => "Review deductible, CAT, litigation, subrogation, and coverage indicators.", _ => "Assign the handler and submit the claim to the DB-backed workflow." };
    private bool CanAdvance => _step switch { 0 => HasValue(_form.PolicyNumber) && HasValue(_form.AccountName) && HasValue(_form.Lob) && HasValue(_form.Carrier), 1 => HasValue(_form.LossType) && HasValue(_form.LossDescription), 2 => HasValue(_form.PrimaryClaimant), 3 => true, _ => CanSubmit };
    private bool CanSubmit => RequiredComplete == RequiredTotal && HasValue(_form.AssignedHandler);
    private int RequiredTotal => 10;
    private int RequiredComplete => new[] { HasValue(_form.PolicyNumber), HasValue(_form.AccountName), HasValue(_form.Lob), HasValue(_form.Carrier), HasValue(_form.LossType), HasValue(_form.LossDescription), HasValue(_form.PrimaryClaimant), _form.DateOfLoss != default, _form.DateReported != default, HasValue(_form.AssignedHandler) }.Count(x => x);
    private bool PolicyInForce => !_form.PolicyEffectiveDate.HasValue || !_form.PolicyExpirationDate.HasValue || (_form.DateOfLoss >= _form.PolicyEffectiveDate.Value && _form.DateOfLoss <= _form.PolicyExpirationDate.Value);
    private bool DeductibleExceeded => _form.EstimatedAmount.HasValue && _form.Deductible.HasValue && _form.EstimatedAmount.Value > _form.Deductible.Value;
    private string PolicyInForceText => PolicyInForce ? "In-force or not dated" : "Verify dates";
    private string DeductibleText => !_form.EstimatedAmount.HasValue || !_form.Deductible.HasValue ? "Needs values" : DeductibleExceeded ? "Exceeds deductible" : "At/below deductible";
    private string SeverityLabel => _form.IsLitigation || _form.IsDisputed || _form.EstimatedAmount >= 100000 ? "High" : _form.IsCatastrophe || _form.HasSubrogation ? "Watch" : "Standard";
    private string ReportingLagLabel => (_form.DateReported.Date - _form.DateOfLoss.Date).Days <= 0 ? "Same day" : $"{(_form.DateReported.Date - _form.DateOfLoss.Date).Days:N0}d";
    private string ReadinessLabel => CanSubmit ? "Ready to submit" : "Needs intake data";
    private string ReadinessDetail => CanSubmit ? "All required claim creation fields are complete." : "Complete required policy, loss, claimant, and handler fields.";
    private string FlagSummary => string.Join(" / ", new[] { _form.IsLitigation ? "Litigation" : null, _form.HasSubrogation ? "Subrogation" : null, (_form.IsCatastrophe || HasValue(_form.CatCode)) ? "CAT" : null, _form.IsDisputed ? "Disputed" : null }.Where(HasValue).DefaultIfEmpty("No flags"));
    private IReadOnlyList<KpiTile> Kpis => [new("Required", $"{RequiredComplete}/{RequiredTotal}", "bi-check2-square", "blue", 0, "Completion", "Go to policy identity"), new("Severity", SeverityLabel, "bi-exclamation-triangle", SeverityLabel == "High" ? "red" : "amber", 3, "Risk signal", "Review severity"), new("Reporting Lag", ReportingLagLabel, "bi-clock-history", "cyan", 1, "Loss to report", "Review loss timing"), new("Claimant", HasValue(_form.PrimaryClaimant) ? "Ready" : "Needed", "bi-people", HasValue(_form.PrimaryClaimant) ? "green" : "red", 2, "Party details", "Review claimant"), new("Handler", HasValue(_form.AssignedHandler) ? "Assigned" : "Needed", "bi-person-badge", HasValue(_form.AssignedHandler) ? "green" : "red", 4, "Assignment", "Assign handler")];

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Claims", "/claims"), new("FNOL Intake", "/claims/new"));
        try
        {
            _userContext = await CurrentUser.RequireAsync();
            _tenantId = _userContext.TenantId;
            _tenantAdminUserId = _userContext.UserId;
            _form.AssignedHandler = _userContext.TenantName ?? "Tenant user";
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to initialize FNOL intake: {ex.Message}";
        }
    }

    private void NextStep() { if (_step < _steps.Length - 1 && CanAdvance) _step++; }
    private void PrevStep() { if (_step > 0) _step--; }
    private void GoToStep(int index) { if (index >= 0 && index < _steps.Length) _step = index; }
    private void ResetForm() { _form = new FnolForm { AssignedHandler = _userContext?.TenantName ?? "Tenant user" }; _step = 0; }
    private void StartAnother() { _showConfirm = false; ResetForm(); }
    private void CloseConfirm() => _showConfirm = false;

    private async Task SubmitFnolAsync()
    {
        if (!CanSubmit || _submitting) return;
        _submitting = true;
        try
        {
            var id = await Api.CreateClaimAsync(new CreateClaimRequest
            {
                TenantId = _tenantId,
                PolicyNumber = Normalize(_form.PolicyNumber) ?? string.Empty,
                AccountName = Normalize(_form.AccountName) ?? string.Empty,
                Lob = _form.Lob,
                Carrier = Normalize(_form.Carrier) ?? string.Empty,
                LossType = _form.LossType,
                PrimaryClaimant = Normalize(_form.PrimaryClaimant) ?? string.Empty,
                DateOfLoss = _form.DateOfLoss,
                DateReported = _form.DateReported,
                LossDescription = Normalize(_form.LossDescription) ?? string.Empty,
                LossLocation = Normalize(_form.LossLocation),
                StateOfLoss = Normalize(_form.StateOfLoss),
                CauseOfLoss = Normalize(_form.CauseOfLoss),
                AssignedHandler = Normalize(_form.AssignedHandler) ?? "Unassigned",
                Priority = _form.Priority,
                CatCode = Normalize(_form.CatCode),
                TotalIncurred = _form.EstimatedAmount ?? 0m,
                TotalReserves = _form.EstimatedAmount ?? 0m,
                IsCatastrophe = _form.IsCatastrophe || HasValue(_form.CatCode),
                IsLitigation = _form.IsLitigation,
                IsDisputed = _form.IsDisputed,
                HasSubrogation = _form.HasSubrogation,
                CreatedByUserId = _tenantAdminUserId
            });
            var created = await Api.GetClaimDetailAsync(id);
            _assignedClaimNumber = created?.Claim.ClaimNumber ?? "Created";
            _showConfirm = true;
            await ShowToast($"Claim {_assignedClaimNumber} created.");
        }
        catch (Exception ex)
        {
            await ShowToast($"FNOL submit failed: {ex.Message}", true);
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task NotifyInvalidAsync() => await ShowToast("Please fix validation errors before submitting FNOL.", true);
    private string StepClass(int index) => index == _step ? "fnol-workflow-card fnol-active" : index < _step ? "fnol-workflow-card fnol-done" : "fnol-workflow-card";
    private string StepStatus(int index) => index < _step ? "Completed" : index == _step ? "In progress" : "Pending";
    private string KpiClass(KpiTile kpi) => $"fnol-kpi-card fnol-{kpi.Tone}";
    private static bool HasValue(string? value) => !string.IsNullOrWhiteSpace(value);
    private static string DisplayValue(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static string? Normalize(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static RenderFragment CoverageCard(string title, string value, string tone, string icon) => builder =>
    {
        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class", $"fnol-coverage-card {tone}");
        builder.OpenElement(2, "i");
        builder.AddAttribute(3, "class", $"bi {icon}");
        builder.AddAttribute(4, "aria-hidden", "true");
        builder.CloseElement();
        builder.OpenElement(5, "span");
        builder.AddContent(6, title);
        builder.CloseElement();
        builder.OpenElement(7, "strong");
        builder.AddContent(8, value);
        builder.CloseElement();
        builder.CloseElement();
    };

    private static RenderFragment ReviewRow(string label, string? value) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "fnol-review-row");
        builder.OpenElement(2, "span");
        builder.AddContent(3, label);
        builder.CloseElement();
        builder.OpenElement(4, "strong");
        builder.AddContent(5, string.IsNullOrWhiteSpace(value) ? "-" : value);
        builder.CloseElement();
        builder.CloseElement();
    };

    private static RenderFragment FlagChip(bool active, string label, string icon) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", active ? "fnol-flag-chip fnol-flag-chip-active" : "fnol-flag-chip");
        builder.OpenElement(2, "i");
        builder.AddAttribute(3, "class", $"bi {icon}");
        builder.AddAttribute(4, "aria-hidden", "true");
        builder.CloseElement();
        builder.AddContent(5, label);
        builder.CloseElement();
    };

    private async Task ShowToast(string content, bool danger = false)
    {
        var toast = new FnolToast(Guid.NewGuid(), content, danger ? "fnol-toast-danger" : "fnol-toast-success", danger ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill");
        _toasts.Add(toast);
        await InvokeAsync(StateHasChanged);
        _ = Task.Run(async () => { await Task.Delay(4500); await InvokeAsync(() => DismissToast(toast.Id)); });
    }

    private void DismissToast(Guid id)
    {
        _toasts.RemoveAll(t => t.Id == id);
        StateHasChanged();
    }

    private sealed class FnolForm
    {
        [Required, StringLength(50)] public string PolicyNumber { get; set; } = string.Empty;
        [Required, StringLength(160)] public string AccountName { get; set; } = string.Empty;
        [Required, StringLength(80)] public string Lob { get; set; } = string.Empty;
        [Required, StringLength(120)] public string Carrier { get; set; } = string.Empty;
        public DateTime? PolicyEffectiveDate { get; set; }
        public DateTime? PolicyExpirationDate { get; set; }
        [Required] public DateTime DateOfLoss { get; set; } = DateTime.Today;
        [Required] public DateTime DateReported { get; set; } = DateTime.Today;
        [Required, StringLength(80)] public string LossType { get; set; } = string.Empty;
        [StringLength(120)] public string? CauseOfLoss { get; set; }
        public decimal? EstimatedAmount { get; set; }
        [StringLength(400)] public string? LossLocation { get; set; }
        [StringLength(20)] public string? StateOfLoss { get; set; }
        [Required, StringLength(2000)] public string LossDescription { get; set; } = string.Empty;
        [Required, StringLength(160)] public string PrimaryClaimant { get; set; } = string.Empty;
        [StringLength(50)] public string? PrimaryClaimantPhone { get; set; }
        [EmailAddress, StringLength(160)] public string? PrimaryClaimantEmail { get; set; }
        [StringLength(80)] public string? PrimaryInjuryType { get; set; }
        [StringLength(40)] public string LitigationStatus { get; set; } = "No";
        [StringLength(40)] public string ThirdParty { get; set; } = "No";
        public decimal? CoverageLimit { get; set; }
        public decimal? Deductible { get; set; }
        [StringLength(80)] public string? CatCode { get; set; }
        [StringLength(2000)] public string? CoverageNotes { get; set; }
        [Required, StringLength(120)] public string AssignedHandler { get; set; } = string.Empty;
        [StringLength(120)] public string? ReportedBy { get; set; }
        [StringLength(120)] public string? CarrierClaimNumber { get; set; }
        public DateTime? CarrierReportDate { get; set; }
        [StringLength(2000)] public string? InternalNotes { get; set; }
        [StringLength(40)] public string Priority { get; set; } = "Standard";
        public bool IsLitigation => LitigationStatus is "Attorney Retained" or "Suit Filed";
        public bool IsDisputed { get; set; }
        public bool HasSubrogation { get; set; }
        public bool IsCatastrophe { get; set; }
    }

    private sealed record StepDef(string Key, string Title, string Icon);
    private sealed record KpiTile(string Label, string Value, string Icon, string Tone, int Step, string Detail, string Title);
    private sealed record FnolToast(Guid Id, string Content, string CssClass, string Icon);
}
