@page "/invoices"
@inject ApiClient Api

<PageTitle>Invoices</PageTitle>

<h1>Invoices</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>

            <GridColumn Field="@nameof(InvoiceDto.InvoiceNumber)" HeaderText="Invoice #" Width="160"></GridColumn>
            <GridColumn Field="@nameof(InvoiceDto.TotalAmount)" HeaderText="Total" Format="C2" Width="140"></GridColumn>
            <GridColumn Field="@nameof(InvoiceDto.BalanceAmount)" HeaderText="Balance" Format="C2" Width="140"></GridColumn>
            <GridColumn Field="@nameof(InvoiceDto.StatusCode)" HeaderText="Status" Width="100"></GridColumn>
            <GridColumn Field="@nameof(InvoiceDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="g" Width="180"></GridColumn>

        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<InvoiceDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchInvoicesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<InvoiceDto>();
    }
}
