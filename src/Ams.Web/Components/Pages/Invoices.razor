@page "/invoices"
@page "/billing/invoices"
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Invoices — AMS</PageTitle>

<AppPageHeader Title="Invoices"
               Subtitle="Track, issue, and manage all policy invoices across direct-bill and agency-bill accounts"
               Icon="bi-receipt">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/billing/accounts")'>
            <i class="bi bi-building" aria-hidden="true"></i> Billing Accounts
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/billing/payments")'>
            <i class="bi bi-cash-coin" aria-hidden="true"></i> Payments
        </button>
        <button class="um-btn um-btn-primary" @onclick="() => _showCreate = true">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> New Invoice
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="inv-kpi-strip">
    @InvKpi("bi-receipt",          "Total",          (_items?.Count ?? 0).ToString(),                                                        "inv-ki-blue")
    @InvKpi("bi-hourglass",        "Outstanding",    Fmt(_items?.Where(x=>x.StatusCode!=2).Sum(x=>x.BalanceAmount)),                        "inv-ki-amber")
    @InvKpi("bi-exclamation-circle","Overdue",       (_items?.Count(x=>x.StatusCode==3) ?? 0).ToString(),                                   "inv-ki-red")
    @InvKpi("bi-check-circle",     "Paid",           (_items?.Count(x=>x.StatusCode==2) ?? 0).ToString(),                                   "inv-ki-green")
    @InvKpi("bi-currency-dollar",  "Total Billed",   Fmt(_items?.Sum(x=>x.TotalAmount)),                                                    "inv-ki-blue")
    @InvKpi("bi-calendar-x",       "Past Due 30+",   Fmt(_items?.Where(x=>x.StatusCode==3 && x.CreatedDateUtc<DateTime.UtcNow.AddDays(-30)).Sum(x=>x.BalanceAmount)), "inv-ki-red")
</div>

<!-- Sub-nav -->
<div class="inv-subnav">
    <button class="inv-snav-btn inv-snav-active"><i class="bi bi-receipt" aria-hidden="true"></i> Invoices</button>
    <button class="inv-snav-btn" @onclick='() => Nav.NavigateTo("/billing/payments")'><i class="bi bi-cash-coin" aria-hidden="true"></i> Payments</button>
    <button class="inv-snav-btn" @onclick='() => Nav.NavigateTo("/billing/credits")'><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Credits &amp; Refunds</button>
    <button class="inv-snav-btn" @onclick='() => Nav.NavigateTo("/billing/reconciliation")'><i class="bi bi-ui-checks-grid" aria-hidden="true"></i> Reconciliation</button>
    <button class="inv-snav-btn" @onclick='() => Nav.NavigateTo("/billing/collections")'><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Collections</button>
    <button class="inv-snav-btn" @onclick='() => Nav.NavigateTo("/billing/payment-experience")'><i class="bi bi-graph-up" aria-hidden="true"></i> Payment Experience</button>
</div>

<!-- Toolbar -->
<div class="inv-toolbar">
    <SfTextBox Placeholder="Search invoice #, account, amount…" @bind-Value="_searchTerm" Width="280px"></SfTextBox>
    <select class="e-input inv-sel" @bind="_filterStatus">
        <option value="">All Statuses</option>
        <option value="1">Draft</option>
        <option value="2">Paid</option>
        <option value="3">Overdue</option>
        <option value="4">Void</option>
    </select>
    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync">
        <i class="bi bi-search" aria-hidden="true"></i> Search
    </button>
</div>

@if (_items is null)
{
    <div style="padding:2rem"><SfSpinner Visible="true" /></div>
}
else
{
    <div class="inv-grid-wrap">
    <SfGrid DataSource="FilteredItems" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="15"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(InvoiceDto.InvoiceNumber)" HeaderText="Invoice #" Width="150"></GridColumn>
            <GridColumn Field="@nameof(InvoiceDto.TotalAmount)" HeaderText="Total" Format="C2" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
            <GridColumn HeaderText="Balance" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>
                    @{ var inv = (InvoiceDto)context; }
                    <span class="@(inv.BalanceAmount > 0 ? "inv-bal-due" : "inv-bal-clear")">@inv.BalanceAmount.ToString("C2")</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Status" Width="120">
                <Template>
                    @{ var inv2 = (InvoiceDto)context; }
                    <span class="inv-status-chip inv-st-@inv2.StatusCode">@InvoiceStatusLabel(inv2.StatusCode)</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(InvoiceDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="d" Width="120"></GridColumn>
            <GridColumn HeaderText="Actions" Width="100">
                <Template>
                    @{ var inv3 = (InvoiceDto)context; }
                    <div class="inv-row-acts">
                        <button class="um-btn um-btn-ghost um-btn-xs"
                                @onclick='() => Nav.NavigateTo($"/billing/accounts/{inv3.AccountId}")'
                                title="Open billing account">
                            <i class="bi bi-building" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-ghost um-btn-xs"
                                @onclick='() => Nav.NavigateTo("/billing/payments")'
                                title="Record payment">
                            <i class="bi bi-cash-coin" aria-hidden="true"></i>
                        </button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
    </div>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private string _filterStatus = "";
    private bool _showCreate;
    private List<InvoiceDto>? _items;

    private IEnumerable<InvoiceDto> FilteredItems => (_items ?? []).Where(x =>
        (string.IsNullOrEmpty(_filterStatus) || x.StatusCode.ToString() == _filterStatus));

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Billing","/billing/accounts"), new("Invoices",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchInvoicesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }

    static string InvoiceStatusLabel(int code) => code switch { 1 => "Draft", 2 => "Paid", 3 => "Overdue", 4 => "Void", _ => "Open" };
    static string Fmt(decimal? v) => v.HasValue ? v.Value.ToString("C0") : "$0";

    RenderFragment InvKpi(string icon, string label, string val, string color) => __builder =>
    {
        <div class="inv-kpi-card @color">
            <i class="bi @icon inv-kpi-icon" aria-hidden="true"></i>
            <div><div class="inv-kpi-val">@val</div><div class="inv-kpi-lbl">@label</div></div>
        </div>
    };
}
