    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _currentUserId = context.UserId;
        _scheduleEditContext = new(_scheduleForm);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var records = await Api.SearchDashboardRecordsAsync(_tenantId, "FinanceAnalytics", _search);
            var arAging = await Api.SearchArAgingSnapshotsAsync(_tenantId, _search);
            var invoices = await Api.SearchInvoicesAsync(_tenantId, _search);
            var gl = await Api.SearchGLAccountsAsync(_tenantId, _search, pageSize: 100);
            var journals = await Api.SearchJournalEntriesAsync(_tenantId, _search);
            var apInvoices = await Api.SearchApInvoicesAsync(_tenantId, _search);
            var apPayments = await Api.SearchApPaymentsAsync(_tenantId, _search);
            var periods = await Api.SearchAccountingPeriodsAsync(_tenantId, _search);
            var bank = await Api.SearchBankReconciliationsAsync(_tenantId, _search);
            var deferred = await Api.SearchDeferredRevenueSchedulesAsync(_tenantId, _search);
            var adjustments = await Api.SearchBillingAdjustmentsAsync(_tenantId, _search);
            var collections = await Api.SearchCollectionsNotesAsync(_tenantId, _search);
            var definitions = await Api.SearchReportDefinitionsAsync("Finance");
            var executions = await Api.SearchReportExecutionsAsync(_tenantId, null);
            var schedules = await Api.SearchReportSchedulesAsync(_tenantId, "Finance");

            _financeItems = records?.Items.Select(r => DeserializeFinanceRecord(r.Id, r.JsonData)).Where(r => r is not null).Cast<FinanceAnalyticsRecord>().ToList() ?? [];
            _arAging = arAging?.Items.ToList() ?? [];
            _invoices = invoices?.Items.ToList() ?? [];
            _glAccounts = gl?.Items.ToList() ?? [];
            _journals = journals?.Items.ToList() ?? [];
            _apInvoices = apInvoices?.Items.ToList() ?? [];
            _apPayments = apPayments?.Items.ToList() ?? [];
            _periods = periods?.Items.ToList() ?? [];
            _bankReconciliations = bank?.Items.ToList() ?? [];
            _deferredRevenue = deferred?.Items.ToList() ?? [];
            _adjustments = adjustments?.Items.ToList() ?? [];
            _collectionsNotes = collections?.Items.ToList() ?? [];
            _financeReports = definitions?.Items.Where(IsFinanceReport).ToList() ?? [];
            _executions = executions?.Items.Where(e => _financeReports.Any(r => r.ReportDefinitionId == e.ReportDefinitionId)).ToList() ?? [];
            _schedules = schedules?.Items.Where(s => _financeReports.Any(r => r.ReportDefinitionId == s.ReportDefinitionId)).ToList() ?? [];
            _selectedItem = _selectedItem is null ? FilteredItems.FirstOrDefault() : _financeItems.FirstOrDefault(i => i.Title == _selectedItem.Title) ?? FilteredItems.FirstOrDefault();
            _selectedAging = _selectedAging is null ? AgingByImportance.FirstOrDefault() : _arAging.FirstOrDefault(a => a.SnapshotId == _selectedAging.SnapshotId) ?? AgingByImportance.FirstOrDefault();
            _selectedInvoice = _selectedInvoice is null ? _invoices.OrderByDescending(i => i.BalanceAmount).FirstOrDefault() : _invoices.FirstOrDefault(i => i.InvoiceId == _selectedInvoice.InvoiceId) ?? _invoices.OrderByDescending(i => i.BalanceAmount).FirstOrDefault();
            _selectedApInvoice = _selectedApInvoice is null ? _apInvoices.OrderByDescending(i => i.Amount - i.AmountPaid).FirstOrDefault() : _apInvoices.FirstOrDefault(i => i.ApInvoiceId == _selectedApInvoice.ApInvoiceId) ?? _apInvoices.OrderByDescending(i => i.Amount - i.AmountPaid).FirstOrDefault();
            _selectedReport = _selectedReport is null ? FinanceReportsByImportance.FirstOrDefault() : _financeReports.FirstOrDefault(r => r.ReportDefinitionId == _selectedReport.ReportDefinitionId) ?? FinanceReportsByImportance.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load finance analytics: {ex.Message}";
            _financeItems = [];
            ShowToast(_loadError, true);
        }
        finally
        {
            _loading = false;
        }
    }

    private static FinanceAnalyticsRecord? DeserializeFinanceRecord(Guid id, string json)
    {
        try
        {
            var item = System.Text.Json.JsonSerializer.Deserialize<FinanceAnalyticsRecord>(json, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
            if (item is not null) item.Id = id;
            return item;
        }
        catch
        {
            return null;
        }
    }

    private static bool IsFinanceReport(ReportDefinitionDto report) => report.ModuleCode == "Finance" || report.ModuleCode == "Billing" || report.ReportName.Contains("Finance", StringComparison.OrdinalIgnoreCase) || report.ReportName.Contains("Billing", StringComparison.OrdinalIgnoreCase) || report.ReportName.Contains("AR", StringComparison.OrdinalIgnoreCase) || report.ReportName.Contains("Revenue", StringComparison.OrdinalIgnoreCase);
    private bool MatchesSearch(FinanceAnalyticsRecord item) => string.IsNullOrWhiteSpace(_search) || item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.Category.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.Segment.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.Workflow.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.Status.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.Insight.Contains(_search, StringComparison.OrdinalIgnoreCase) || _financeReports.Any(r => r.ReportName.Contains(_search, StringComparison.OrdinalIgnoreCase));
    private bool MatchesActiveView(FinanceAnalyticsRecord item) => _activeTab switch
    {
        "cash" => item.Category == "Cash" || item.Workflow == "Collections",
        "ar" => item.Category == "Cash" || item.Workflow == "Collections",
        "close" => item.Category == "Close" || item.Workflow == "Close",
        "revenue" => item.Category == "Revenue" || item.Workflow == "Revenue Recognition",
        "payables" => item.Category == "Payables" || item.Workflow == "Payables",
        "controls" => item.Category == "Controls" || item.Workflow == "Reconciliation",
        "reports" => item.Category == "Reports" || item.Workflow == "Reporting" || _financeReports.Any(),
        _ => true
    };

