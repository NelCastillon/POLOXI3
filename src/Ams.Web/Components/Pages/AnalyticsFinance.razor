    private async Task DownloadFileAsync(ReportDownloadFile file)
    {
        var fileName = file.FileName.Replace("'", string.Empty);
        var base64 = Convert.ToBase64String(file.Content);
        var script = $"(() => {{ const a = document.createElement(\"a\"); a.href = \"data:application/vnd.ms-excel;base64,{base64}\"; a.download = \"{fileName}\"; document.body.appendChild(a); a.click(); a.remove(); }})()";
        await Js.InvokeVoidAsync("eval", script);
    }

    private static string PreferredFormat(ReportDefinitionDto report) => report.OutputFormats.Contains("Excel", StringComparison.OrdinalIgnoreCase) ? "Excel" : report.OutputFormats.Contains("CSV", StringComparison.OrdinalIgnoreCase) ? "CSV" : "PDF";
    private bool IsScheduled(Guid reportId) => _schedules.Any(s => s.ReportDefinitionId == reportId && s.IsActive);
    private string LastRunLabel(Guid reportId) => _executions.Where(e => e.ReportDefinitionId == reportId).OrderByDescending(e => e.CreatedDateUtc).Select(e => e.CompletedDateUtc.HasValue ? $"last {FormatDate(e.CompletedDateUtc.Value)}" : e.StatusCode).FirstOrDefault() ?? "not run";
    private int ReportScore(ReportDefinitionDto report) => (report.IsSystemReport ? 20 : 10) + (IsScheduled(report.ReportDefinitionId) ? 20 : 0) + (report.OutputFormats.Contains("Excel", StringComparison.OrdinalIgnoreCase) ? 10 : 0) + (report.ReportName.Contains("AR", StringComparison.OrdinalIgnoreCase) || report.ReportName.Contains("Revenue", StringComparison.OrdinalIgnoreCase) || report.ReportName.Contains("Finance", StringComparison.OrdinalIgnoreCase) ? 30 : 12);
    private static int ItemScore(FinanceAnalyticsRecord item) => Math.Clamp((item.Priority == "Critical" ? 44 : item.Priority == "High" ? 30 : 18) + (int)Math.Min(24, item.Amount / 25000) + (int)Math.Min(18, item.Count) + (int)Math.Max(0, 12 - (item.DueDateUtc - DateTime.UtcNow).TotalDays) + (int)Math.Max(0, 100 - item.HealthPct) / 4, 0, 100);
    private static int AgingScore(ArAgingSnapshotDto aging) => Math.Clamp((int)Math.Min(60, aging.TotalOutstanding / 10000) + (int)Math.Min(35, AgingRiskPct(aging)) + (aging.Days90PlusAmount > 0 ? 15 : 0), 0, 100);
    private static double AgingRiskPct(ArAgingSnapshotDto aging) => aging.TotalOutstanding <= 0 ? 0 : (double)((aging.Days60Amount + aging.Days90Amount + aging.Days90PlusAmount) / aging.TotalOutstanding * 100);
    private static string AgingRiskClass(ArAgingSnapshotDto aging) => AgingRiskPct(aging) >= 50 ? "critical" : AgingRiskPct(aging) >= 25 ? "high" : "normal";
    private static string PriorityCss(string priority) => priority switch { "Critical" => "critical", "High" => "high", "Normal" => "normal", _ => "standard" };
    private static string CategoryCss(string category) => category switch { "Cash" => "green", "Close" => "blue", "Revenue" => "purple", "Payables" => "amber", "Controls" => "cyan", _ => "slate" };
    private static string CategoryIcon(string category) => category switch { "Cash" => "bi-cash-coin", "Close" => "bi-calendar2-check", "Revenue" => "bi-pie-chart", "Payables" => "bi-receipt", "Controls" => "bi-shield-check", _ => "bi-bank" };
    private static string TrendCss(double value) => value >= 0 ? "af-trend-up" : "af-trend-down";
    private static string FormatSigned(double value) => value >= 0 ? $"+{value:N1}" : value.ToString("N1");
    private static string FormatCurrency(decimal value) => value >= 1000000 ? $"{value / 1000000m:C1}M" : value >= 1000 ? $"{value / 1000m:C0}K" : value.ToString("C0");
    private static string FormatDate(DateTime value) => value.ToLocalTime().ToString("MMM d");
    private static string PreviewCellCss(string dataType) => dataType.Equals("Number", StringComparison.OrdinalIgnoreCase) || dataType.Equals("Currency", StringComparison.OrdinalIgnoreCase) || dataType.Equals("Percent", StringComparison.OrdinalIgnoreCase) ? "af-preview-cell--numeric" : string.Empty;
    private void ShowToast(string message, bool danger = false) { _toastMessage = message; _toastClass = danger ? "af-toast--danger" : "af-toast--success"; }
    private void ClearToast() => _toastMessage = null;

    private sealed record TabItem(string Key, string Label, string Icon);
    private sealed record KpiItem(string Key, string Label, string Icon, string Value, string Detail, string Tooltip);
    private sealed record MixRow(string Label, decimal Amount) { public double Percent { get; init; } }
    private sealed class FinanceAnalyticsRecord
    {
        public Guid Id { get; set; }
        public string Category { get; set; } = string.Empty;
        public string Priority { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Owner { get; set; } = string.Empty;
        public string Segment { get; set; } = string.Empty;
        public string Workflow { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public int Count { get; set; }
        public double HealthPct { get; set; }
        public double TrendPct { get; set; }
        public DateTime DueDateUtc { get; set; }
        public string NextAction { get; set; } = string.Empty;
        public string Insight { get; set; } = string.Empty;
    }

    private sealed class ScheduleForm
    {
        [Required]
        public Guid ReportDefinitionId { get; set; }

        [Required, StringLength(50)]
        public string FrequencyCode { get; set; } = "Weekly";

        [Required, StringLength(20)]
        public string OutputFormat { get; set; } = "Excel";

        [Required, EmailAddress, StringLength(254)]
        public string DeliveryEmail { get; set; } = "finance@agencybinder.local";
    }
}
