@page "/analytics/finance"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject IJSRuntime Js

<PageTitle>Finance Analytics ? AMS</PageTitle>

<AppPageHeader Title="Finance Analytics"
               Subtitle="Enterprise finance command center for cash, AR aging, revenue recognition, close readiness, AP exposure, GL controls, bank reconciliations, and report delivery."
               Icon="bi-bank2">
    <Actions>
        <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_busy"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="SyncArAgingAsync" disabled="@_busy"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Sync AR Aging</button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="CreateCloseJournalAsync" disabled="@(_selectedItem is null || _busy)"><i class="bi bi-journal-plus" aria-hidden="true"></i> Create Close Journal</button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="OpenScheduleForSelected" disabled="@(_selectedReport is null || _busy)"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Schedule Report</button>
        <button class="um-btn um-btn-primary" type="button" @onclick="ExportFinancePackAsync" disabled="@(!_financeReports.Any() || _busy)"><i class="bi bi-download" aria-hidden="true"></i> Export Finance Pack</button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="af-toast @_toastClass" role="status">
        <i class="bi @(_toastClass == "af-toast--danger" ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="af-toast-close" @onclick="ClearToast" aria-label="Dismiss message"><i class="bi bi-x-lg"></i></button>
    </div>
}

<div class="af-page">
    <section class="af-hero">
        <div class="af-hero-main">
            <div class="af-eyebrow"><i class="bi bi-activity" aria-hidden="true"></i> Finance control cockpit</div>
            <h2>@FormatCurrency(TotalCashFocus) in managed finance exposure with @FinanceReadinessScore% readiness</h2>
            <p>Rank cash acceleration, AR aging, collections, revenue recognition, AP payment timing, GL controls, bank reconciliation, and close activities by financial impact and operational urgency.</p>
            <div class="af-hero-meta">
                <span><i class="bi bi-cash-coin"></i> @FormatCurrency(ArOutstanding) AR outstanding</span>
                <span><i class="bi bi-receipt"></i> @FormatCurrency(ApExposure) AP exposure</span>
                <span><i class="bi bi-calendar2-check"></i> @OpenCloseItems close items</span>
                <span><i class="bi bi-file-earmark-bar-graph"></i> @_financeReports.Count reports</span>
            </div>
        </div>
        <div class="af-hero-panel">
            <div class="af-score-card">
                <span>Finance readiness score</span>
                <strong>@FinanceReadinessScore%</strong>
                <div class="af-score-track"><div style="width:@FinanceReadinessScore%"></div></div>
                <small>@FinanceReadinessSummary</small>
            </div>
            <div class="af-priority-list">
                @foreach (var item in PriorityItems)
                {
                    <button type="button" class="af-priority-item" @onclick="() => SelectAnalyticsItem(item)">
                        <span class="af-risk af-risk--@PriorityCss(item.Priority)">@ItemScore(item)</span>
                        <div><strong>@item.Title</strong><small>@item.NextAction</small></div>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="af-kpi-strip" aria-label="Finance KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="af-kpi-card @(IsActiveKpi(kpi.Key) ? "af-kpi-card--active" : null)" title="@kpi.Tooltip" @onclick="() => SetKpi(kpi.Key)">
                <span class="af-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="af-kpi-label">@kpi.Label</span>
                <strong>@kpi.Value</strong>
                <small>@kpi.Detail</small>
            </button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger af-load-error" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError
        </div>
    }

    <section class="af-command-bar">
        <div class="af-search-wrap">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input class="af-search" placeholder="Search finance analytics, AR/AP, close, GL, bank, revenue, reports, owners, workflows, or status?" @bind="_search" @bind:event="oninput" />
        </div>
        <select class="af-select" @bind="_segmentFilter">
            <option value="">All segments</option>
            @foreach (var segment in Segments)
            {
                <option value="@segment">@segment</option>
            }
        </select>
        <select class="af-select" @bind="_priorityFilter">
            <option value="">All priorities</option>
            <option value="Critical">Critical</option>
            <option value="High">High</option>
            <option value="Normal">Normal</option>
        </select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
        <button type="button" class="um-btn um-btn-ghost" @onclick="RunFinanceReportsAsync" disabled="@(!_financeReports.Any() || _busy)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run Finance Reports</button>
    </section>

    <div class="af-tabs" role="tablist" aria-label="Finance analytics views">
        @foreach (var tab in _tabs)
        {
            <button type="button" role="tab" class="af-tab @(_activeTab == tab.Key ? "af-tab--active" : null)" @onclick="() => SetTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </div>

    @if (_loading)
    {
        <div class="af-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading finance analytics...</div>
    }
    else
    {
        <section class="af-grid">
            <article class="af-panel af-panel--main">
                <div class="af-panel-header"><i class="bi @ActiveIcon" aria-hidden="true"></i><div><strong>@ActiveListTitle</strong><span>@FilteredItemCount.ToString("N0") finance records ranked by cash impact, close risk, control health, workflow urgency, and due date.</span></div></div>
                @if (!FilteredItems.Any())
                {
                    <div class="af-empty"><i class="bi bi-bank" aria-hidden="true"></i><strong>No finance records match this view</strong><span>Adjust filters or refresh seeded finance analytics.</span></div>
                }
                else
                {
                    <div class="af-item-list">
                        @foreach (var item in FilteredItems)
                        {
                            <button type="button" class="af-item-row @(_selectedItem?.Title == item.Title ? "af-item-row--active" : null)" @onclick="() => SelectAnalyticsItem(item)">
                                <span class="af-module-icon af-module-icon--@CategoryCss(item.Category)"><i class="bi @CategoryIcon(item.Category)" aria-hidden="true"></i></span>
                                <div class="af-item-main">
                                    <div class="af-item-title"><strong>@item.Title</strong><span class="af-badge af-badge--@CategoryCss(item.Category)">@item.Category</span><span class="af-badge af-badge--type">@item.Workflow</span></div>
                                    <p>@item.Insight</p>
                                    <div class="af-item-meta"><span>@item.Owner</span><span>@item.Segment</span><span>@item.Count.ToString("N0") items</span><span>@FormatCurrency(item.Amount)</span><span>@item.HealthPct.ToString("N1")% health</span><span>due @FormatDate(item.DueDateUtc)</span></div>
                                </div>
                                <span class="af-row-score">@ItemScore(item)</span>
                            </button>
                        }
                    </div>
                }
            </article>

            <aside class="af-side">
                @if (_selectedItem is null)
                {
                    <div class="af-panel"><div class="af-empty af-empty--side"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a finance priority</strong><span>Choose a cash, AR, close, revenue, payable, or control priority to inspect workflow and actions.</span></div></div>
                }
                else
                {
                    <article class="af-panel">
                        <div class="af-panel-header"><i class="bi @CategoryIcon(_selectedItem.Category)" aria-hidden="true"></i><div><strong>Finance command</strong><span>@_selectedItem.Priority ?? @_selectedItem.Status</span></div></div>
                        <div class="af-detail">
                            <div class="af-detail-head">
                                <span class="af-module-icon af-module-icon--@CategoryCss(_selectedItem.Category)"><i class="bi @CategoryIcon(_selectedItem.Category)" aria-hidden="true"></i></span>
                                <div><strong>@_selectedItem.Title</strong><span>@_selectedItem.Insight</span></div>
                            </div>
                            <dl>
                                <dt>Exposure</dt><dd>@FormatCurrency(_selectedItem.Amount)</dd>
                                <dt>Items</dt><dd>@_selectedItem.Count.ToString("N0")</dd>
                                <dt>Health</dt><dd>@_selectedItem.HealthPct.ToString("N1")%</dd>
                                <dt>Trend</dt><dd class="@TrendCss(_selectedItem.TrendPct)">@FormatSigned(_selectedItem.TrendPct)%</dd>
                                <dt>Workflow</dt><dd>@_selectedItem.Workflow</dd>
                                <dt>Owner</dt><dd>@_selectedItem.Owner</dd>
                                <dt>Due</dt><dd>@FormatDate(_selectedItem.DueDateUtc)</dd>
                                <dt>Next action</dt><dd>@_selectedItem.NextAction</dd>
                            </dl>
                            <div class="af-detail-actions">
                                <button type="button" class="um-btn um-btn-ghost" @onclick="CreateCloseJournalAsync" disabled="@_busy"><i class="bi bi-journal-plus" aria-hidden="true"></i> Create Journal</button>
                                <button type="button" class="um-btn um-btn-ghost" @onclick="CreateCollectionNoteAsync" disabled="@(_selectedAging is null || _busy)"><i class="bi bi-telephone-outbound" aria-hidden="true"></i> Log Collection</button>
                                <button type="button" class="um-btn um-btn-ghost" @onclick="FocusFinanceReport" disabled="@(_selectedReport is null)"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i> Focus Report</button>
                                <button type="button" class="um-btn um-btn-ghost" @onclick="OpenSelectedReportPreviewAsync" disabled="@(_selectedReport is null || _busy)"><i class="bi bi-eye" aria-hidden="true"></i> View Report</button>
                                <button type="button" class="um-btn um-btn-primary" @onclick="RunSelectedReportAsync" disabled="@(_selectedReport is null || _busy)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run</button>
                            </div>
                        </div>
                    </article>
                }

                <article class="af-panel">
                    <div class="af-panel-header"><i class="bi bi-hourglass-split" aria-hidden="true"></i><div><strong>AR aging queue</strong><span>Existing aging snapshots sorted by cash risk.</span></div></div>
                    <div class="af-case-list">
                        @foreach (var aging in AgingByImportance.Take(6))
                        {
                            <button type="button" class="af-case-row @(_selectedAging?.SnapshotId == aging.SnapshotId ? "af-case-row--active" : null)" @onclick="() => SelectAging(aging)">
                                <div><strong>@FormatCurrency(aging.TotalOutstanding)</strong><span>@aging.SnapshotDate.ToString("MMM d, yyyy") ?? 60+ @FormatCurrency(aging.Days60Amount + aging.Days90Amount + aging.Days90PlusAmount)</span></div>
                                <div class="af-case-metrics"><strong>@AgingRiskPct(aging).ToString("N0")%</strong><span class="af-risk-label af-risk-label--@AgingRiskClass(aging)">aged</span></div>
                            </button>
                        }
                        @if (!_arAging.Any())
                        {
                            <div class="af-empty af-empty--compact"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No AR aging snapshots loaded</strong><span>Use Sync AR Aging to create snapshots from invoices.</span></div>
                        }
                    </div>
                </article>

                <article class="af-panel">
                    <div class="af-panel-header"><i class="bi bi-lightning-charge" aria-hidden="true"></i><div><strong>Finance actions</strong><span>Collections, AP, close, and controls workflow.</span></div></div>
                    <div class="af-action-list">
                        <button type="button" class="um-btn um-btn-ghost" @onclick="CreateCollectionNoteAsync" disabled="@(_selectedAging is null || _busy)"><i class="bi bi-chat-left-text" aria-hidden="true"></i> Add Collection Note</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="CreateBillingAdjustmentAsync" disabled="@(_selectedInvoice is null || _busy)"><i class="bi bi-sliders" aria-hidden="true"></i> Create Billing Adjustment</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="CreateApPaymentAsync" disabled="@(_selectedApInvoice is null || _busy)"><i class="bi bi-credit-card" aria-hidden="true"></i> Stage AP Payment</button>
                        <button type="button" class="um-btn um-btn-primary" @onclick="SyncArAgingAsync" disabled="@_busy"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Sync Aging</button>
                    </div>
                </article>
            </aside>
        </section>

        <section class="af-lower-grid">
            <article class="af-panel">
                <div class="af-panel-header"><i class="bi bi-calendar2-check" aria-hidden="true"></i><div><strong>Close readiness</strong><span>Periods, journals, and reconciliation dependencies.</span></div></div>
                <div class="af-metric-list">
                    <div><span>Open periods</span><strong>@_periods.Count(p => !p.StatusCode.Contains("Closed", StringComparison.OrdinalIgnoreCase)).ToString("N0")</strong></div>
                    <div><span>Draft journals</span><strong>@_journals.Count(j => j.StatusCode.Contains("Draft", StringComparison.OrdinalIgnoreCase)).ToString("N0")</strong></div>
                    <div><span>Unbalanced journals</span><strong>@_journals.Count(j => j.TotalDebit != j.TotalCredit).ToString("N0")</strong></div>
                    <div><span>Bank discrepancies</span><strong>@FormatCurrency(_bankReconciliations.Sum(b => Math.Abs(b.Discrepancy)))</strong></div>
                </div>
            </article>

            <article class="af-panel">
                <div class="af-panel-header"><i class="bi bi-pie-chart" aria-hidden="true"></i><div><strong>Revenue and payables mix</strong><span>Deferred revenue and vendor cash requirements.</span></div></div>
                <div class="af-mix-list">
                    @foreach (var row in RevenuePayableMix)
                    {
                        <div class="af-mix-row">
                            <span>@row.Label</span>
                            <div><span style="width:@row.Percent.ToString("N0")%"></span></div>
                            <strong>@FormatCurrency(row.Amount)</strong>
                        </div>
                    }
                </div>
            </article>

            <article class="af-panel">
                <div class="af-panel-header"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i><div><strong>Finance report workflow</strong><span>Preview, run, export, and scheduled delivery.</span></div></div>
                <div class="af-report-list">
                    @foreach (var report in FinanceReportsByImportance.Take(6))
                    {
                        <div class="af-report-row @(_selectedReport?.ReportDefinitionId == report.ReportDefinitionId ? "af-report-row--active" : null)" role="button" tabindex="0" title="Open report preview" @onclick="() => OpenPreviewAsync(report)">
                            <div><strong>@report.ReportName</strong><span>@report.ReportTypeCode ?? @report.OutputFormats ?? @LastRunLabel(report.ReportDefinitionId)</span></div>
                            <div class="af-report-actions">
                                <span>@ReportScore(report)</span>
                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" title="View report" @onclick="() => OpenPreviewAsync(report)" @onclick:stopPropagation="true" disabled="@_busy"><i class="bi bi-eye" aria-hidden="true"></i></button>
                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Run report" @onclick="() => RunReportAsync(report)" @onclick:stopPropagation="true" disabled="@_busy"><i class="bi bi-play-fill" aria-hidden="true"></i></button>
                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Export report" @onclick="() => ExportReportAsync(report)" @onclick:stopPropagation="true" disabled="@_busy"><i class="bi bi-download" aria-hidden="true"></i></button>
                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Schedule report" @onclick="() => OpenSchedule(report)" @onclick:stopPropagation="true" disabled="@_busy"><i class="bi bi-calendar-plus" aria-hidden="true"></i></button>
                            </div>
                        </div>
                    }
                    @if (!_financeReports.Any())
                    {
                        <div class="af-empty af-empty--compact"><i class="bi bi-file-earmark-x" aria-hidden="true"></i><strong>No Finance module reports found</strong><span>Finance analytics still uses seeded records and live financial workflow data.</span></div>
                    }
                </div>
            </article>
        </section>
    }
</div>

@if (_showSchedule)
{
    <div class="af-modal-backdrop" role="presentation" @onclick="CloseSchedule">
        <div class="af-modal" role="dialog" aria-modal="true" aria-label="Schedule finance report" @onclick:stopPropagation="true">
            <EditForm EditContext="@_scheduleEditContext" OnValidSubmit="ScheduleAsync">
                <DataAnnotationsValidator />
                <div class="af-modal-header">
                    <i class="bi bi-calendar-plus" aria-hidden="true"></i>
                    <span>Schedule finance report</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseSchedule"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="af-modal-body">
                    @if (!string.IsNullOrWhiteSpace(_formError))
                    {
                        <div class="alert alert-danger af-load-error" role="alert">@_formError</div>
                    }
                    <div class="af-form-grid">
                        <label>Report
                            <select class="af-input" @bind="_scheduleForm.ReportDefinitionId">
                                @foreach (var report in FinanceReportsByImportance)
                                {
                                    <option value="@report.ReportDefinitionId">@report.ReportName</option>
                                }
                            </select>
                        </label>
                        <label>Frequency
                            <select class="af-input" @bind="_scheduleForm.FrequencyCode">
                                @foreach (var frequency in _frequencyOptions)
                                {
                                    <option value="@frequency">@frequency</option>
                                }
                            </select>
                        </label>
                        <label>Output format
                            <select class="af-input" @bind="_scheduleForm.OutputFormat">
                                @foreach (var format in _formatOptions)
                                {
                                    <option value="@format">@format</option>
                                }
                            </select>
                        </label>
                        <label>Delivery email
                            <input class="af-input" @bind="_scheduleForm.DeliveryEmail" />
                        </label>
                    </div>
                </div>
                <div class="af-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseSchedule">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi bi-check2" aria-hidden="true"></i> Schedule</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showPreview)
{
    <div class="af-modal-backdrop" role="presentation" @onclick="ClosePreview">
        <div class="af-modal af-modal--preview" role="dialog" aria-modal="true" aria-label="Finance report preview" @onclick:stopPropagation="true">
            <div class="af-modal-header">
                <i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i>
                <div>
                    <span>@(_preview?.ReportName ?? _previewReport?.ReportName ?? "Finance Report")</span>
                    <small>@(_preview?.Description ?? _previewReport?.Description ?? "Generated finance report preview")</small>
                </div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="ClosePreview"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="af-modal-body af-preview-body">
                @if (_previewLoading)
                {
                    <div class="af-loading af-loading--preview"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Generating finance report preview...</div>
                }
                else if (!string.IsNullOrWhiteSpace(_previewError))
                {
                    <div class="alert alert-danger af-load-error" role="alert"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_previewError</div>
                }
                else if (_preview is not null)
                {
                    <div class="af-preview-summary">
                        <div><span>Module</span><strong>@_preview.ModuleCode</strong></div>
                        <div><span>Type</span><strong>@_preview.ReportTypeCode</strong></div>
                        <div><span>Rows</span><strong>@_preview.RowCount.ToString("N0")</strong></div>
                        <div><span>Generated</span><strong>@_preview.GeneratedDateUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</strong></div>
                    </div>
                    <div class="af-preview-table-wrap">
                        <table class="af-preview-table">
                            <thead>
                                <tr>
                                    @foreach (var column in _preview.Columns)
                                    {
                                        <th class="@PreviewCellCss(column.DataType)">@column.Header</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _preview.Rows)
                                {
                                    <tr>
                                        @foreach (var column in _preview.Columns)
                                        {
                                            <td class="@PreviewCellCss(column.DataType)">@row.GetValueOrDefault(column.Field)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="af-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="ClosePreview">Close</button>
                @if (_previewReport is not null)
                {
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenSchedule(_previewReport)"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Schedule</button>
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => RunReportAsync(_previewReport)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run</button>
                    <button type="button" class="um-btn um-btn-primary" @onclick="() => ExportReportAsync(_previewReport)"><i class="bi bi-download" aria-hidden="true"></i> Download Excel</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private readonly TabItem[] _tabs =
    [
        new("all", "Command", "bi-speedometer2"),
        new("cash", "Cash", "bi-cash-coin"),
        new("ar", "AR Aging", "bi-hourglass-split"),
        new("close", "Close", "bi-calendar2-check"),
        new("revenue", "Revenue", "bi-pie-chart"),
        new("payables", "AP", "bi-receipt"),
        new("controls", "Controls", "bi-shield-check"),
        new("reports", "Reports", "bi-file-earmark-bar-graph")
    ];

    private readonly string[] _frequencyOptions = ["Daily", "Weekly", "Monthly", "Quarterly"];
    private readonly string[] _formatOptions = ["PDF", "Excel", "CSV"];

    private Guid _tenantId;
    private Guid? _currentUserId;
    private bool _loading;
    private bool _saving;
    private bool _showSchedule;
    private string _search = string.Empty;
    private string _activeKpi = "all";
    private string _activeTab = "all";
    private string _segmentFilter = string.Empty;
    private string _priorityFilter = string.Empty;
    private string? _loadError;
    private string? _formError;
    private string? _toastMessage;
    private string _toastClass = "af-toast--success";
    private bool _showPreview;
    private bool _previewLoading;
    private string? _previewError;
    private ReportPreviewDto? _preview;
    private ReportDefinitionDto? _previewReport;
    private List<FinanceAnalyticsRecord> _financeItems = [];
    private List<ArAgingSnapshotDto> _arAging = [];
    private List<InvoiceDto> _invoices = [];
    private List<GLAccountDto> _glAccounts = [];
    private List<JournalEntryDto> _journals = [];
    private List<ApInvoiceDto> _apInvoices = [];
    private List<ApPaymentDto> _apPayments = [];
    private List<AccountingPeriodDto> _periods = [];
    private List<BankReconciliationDto> _bankReconciliations = [];
    private List<DeferredRevenueScheduleDto> _deferredRevenue = [];
    private List<BillingAdjustmentDto> _adjustments = [];
    private List<CollectionsNoteDto> _collectionsNotes = [];
    private List<ReportDefinitionDto> _financeReports = [];
    private List<ReportExecutionDto> _executions = [];
    private List<ReportScheduleDto> _schedules = [];
    private FinanceAnalyticsRecord? _selectedItem;
    private ArAgingSnapshotDto? _selectedAging;
    private InvoiceDto? _selectedInvoice;
    private ApInvoiceDto? _selectedApInvoice;
    private ReportDefinitionDto? _selectedReport;
    private ScheduleForm _scheduleForm = new();
    private EditContext _scheduleEditContext = default!;
    private bool _busy => _loading || _saving;

    private decimal ArOutstanding => _arAging.Sum(a => a.TotalOutstanding) + _invoices.Sum(i => i.BalanceAmount);
    private decimal AgedAr => _arAging.Sum(a => a.Days60Amount + a.Days90Amount + a.Days90PlusAmount);
    private decimal ApExposure => _apInvoices.Sum(i => Math.Max(0, i.Amount - i.AmountPaid));
    private decimal DeferredRemaining => _deferredRevenue.Sum(r => r.RemainingAmount);
    private decimal BankDiscrepancy => _bankReconciliations.Sum(b => Math.Abs(b.Discrepancy));
    private decimal AnalyticsExposure => _financeItems.Sum(i => i.Amount);
    private decimal TotalCashFocus => AnalyticsExposure + ArOutstanding + ApExposure + DeferredRemaining + BankDiscrepancy;
    private int OpenCloseItems => _periods.Count(p => !p.StatusCode.Contains("Closed", StringComparison.OrdinalIgnoreCase)) + _journals.Count(j => !j.StatusCode.Contains("Posted", StringComparison.OrdinalIgnoreCase));
    private int ScheduledReportCount => _financeReports.Count(r => IsScheduled(r.ReportDefinitionId));
    private int FinanceReadinessScore => Math.Clamp(58 + Math.Min(12, _financeItems.Count * 2) + Math.Min(10, _glAccounts.Count(g => g.IsActive)) + Math.Min(10, ScheduledReportCount * 4) + Math.Min(10, _bankReconciliations.Count(b => Math.Abs(b.Discrepancy) == 0)), 0, 100);
    private string FinanceReadinessSummary => FinanceReadinessScore >= 90 ? "Finance workflow is executive ready" : FinanceReadinessScore >= 80 ? "Finance controls are healthy with focused cash and close actions" : "Sync AR aging, run reports, and clear close/control exceptions to improve readiness";
    private IEnumerable<string> Segments => _financeItems.Select(i => i.Segment).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s);
    private IEnumerable<FinanceAnalyticsRecord> PriorityItems => _financeItems.OrderByDescending(ItemScore).ThenBy(i => i.DueDateUtc).Take(4);
    private IEnumerable<ArAgingSnapshotDto> AgingByImportance => _arAging.OrderByDescending(AgingScore).ThenByDescending(a => a.TotalOutstanding);
    private IEnumerable<ReportDefinitionDto> FinanceReportsByImportance => _financeReports.OrderByDescending(ReportScore).ThenBy(r => r.ReportName);
    private IEnumerable<MixRow> RevenuePayableMix
    {
        get
        {
            var rows = new[]
            {
                new MixRow("AR outstanding", ArOutstanding),
                new MixRow("Deferred remaining", DeferredRemaining),
                new MixRow("AP exposure", ApExposure),
                new MixRow("Bank discrepancy", BankDiscrepancy)
            };
            var max = Math.Max(1, rows.Max(r => r.Amount));
            return rows.Select(r => r with { Percent = Math.Clamp((double)(r.Amount / max * 100), 4, 100) });
        }
    }
    private IEnumerable<FinanceAnalyticsRecord> FilteredItems => _financeItems
        .Where(MatchesSearch)
        .Where(i => string.IsNullOrWhiteSpace(_segmentFilter) || i.Segment == _segmentFilter)
        .Where(i => string.IsNullOrWhiteSpace(_priorityFilter) || i.Priority == _priorityFilter)
        .Where(MatchesActiveView)
        .OrderByDescending(ItemScore)
        .ThenBy(i => i.DueDateUtc)
        .ToList();
    private int FilteredItemCount => FilteredItems.Count();

    private IEnumerable<KpiItem> Kpis =>
    [
        new("all", "Exposure", "bi-speedometer2", FormatCurrency(TotalCashFocus), $"{_financeItems.Count:N0} priorities", "Show all finance command records"),
        new("cash", "Cash", "bi-cash-coin", FormatCurrency(ArOutstanding), $"{AgedArPct:N1}% aged", "Filter cash acceleration and collections records"),
        new("ar", "AR Aging", "bi-hourglass-split", FormatCurrency(AgedAr), "60+ day exposure", "Filter AR aging records"),
        new("close", "Close", "bi-calendar2-check", OpenCloseItems.ToString("N0"), "open items", "Filter close readiness records"),
        new("revenue", "Revenue", "bi-pie-chart", FormatCurrency(DeferredRemaining), "deferred", "Filter revenue recognition records"),
        new("payables", "AP", "bi-receipt", FormatCurrency(ApExposure), $"{_apInvoices.Count:N0} invoices", "Filter payables and vendor cash requirements"),
        new("controls", "Controls", "bi-shield-check", FormatCurrency(BankDiscrepancy), "bank variance", "Filter GL controls and reconciliation quality records"),
        new("reports", "Reports", "bi-file-earmark-bar-graph", _financeReports.Count.ToString("N0"), $"{ScheduledReportCount:N0} scheduled", "Filter Finance module reports")
    ];

    private double AgedArPct => ArOutstanding <= 0 ? 0 : (double)(AgedAr / ArOutstanding * 100);
    private string ActiveListTitle => _activeTab switch
    {
        "cash" => "Cash acceleration and collections queue",
        "ar" => "AR aging and delinquency exposure",
        "close" => "Month-end close readiness exceptions",
        "revenue" => "Revenue recognition and deferred revenue review",
        "payables" => "AP payment timing and vendor exposure",
        "controls" => "GL, bank reconciliation, and control quality",
        "reports" => "Finance reporting workflow",
        _ => "Enterprise finance command queue"
    };

    private string ActiveIcon => _activeTab switch
    {
        "cash" => "bi-cash-coin",
        "ar" => "bi-hourglass-split",
        "close" => "bi-calendar2-check",
        "revenue" => "bi-pie-chart",
        "payables" => "bi-receipt",
