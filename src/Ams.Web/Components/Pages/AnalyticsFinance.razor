    private void SetTab(string key) { _activeTab = key; _activeKpi = key; }
    private void ResetFilters() { _search = string.Empty; _segmentFilter = string.Empty; _priorityFilter = string.Empty; _activeKpi = "all"; _activeTab = "all"; }
