@page "/analytics/finance"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>Financial Analytics — AMS</PageTitle>

<AppPageHeader Title="Financial Analytics"
               Subtitle="Revenue, AR aging, commission payable, and period-vs-budget performance"
               Icon="bi-bank">
    <Actions>
        <button class="um-btn um-btn-ghost"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
    </Actions>
</AppPageHeader>

<div class="fa-kpi-strip">
    <div class="fa-kpi-card"><div class="fa-kpi-icon fa-ki-green"><i class="bi bi-currency-dollar" aria-hidden="true"></i></div><div><div class="fa-kv">$1.84M</div><div class="fa-kl">Revenue (YTD)</div><div class="fa-delta fa-d-up"><i class="bi bi-arrow-up-short" aria-hidden="true"></i> +9% vs prior year</div></div></div>
    <div class="fa-kpi-card"><div class="fa-kpi-icon fa-ki-blue"><i class="bi bi-receipt" aria-hidden="true"></i></div><div><div class="fa-kv">$214K</div><div class="fa-kl">Open AR</div><div class="fa-delta fa-d-dn"><i class="bi bi-arrow-down-short" aria-hidden="true"></i> 8% vs last month</div></div></div>
    <div class="fa-kpi-card"><div class="fa-kpi-icon fa-ki-amber"><i class="bi bi-percent" aria-hidden="true"></i></div><div><div class="fa-kv">$182K</div><div class="fa-kl">Commission Payable</div><div class="fa-delta fa-d-up"><i class="bi bi-arrow-up-short" aria-hidden="true"></i> 4% vs last month</div></div></div>
    <div class="fa-kpi-card"><div class="fa-kpi-icon fa-ki-green"><i class="bi bi-graph-up" aria-hidden="true"></i></div><div><div class="fa-kv">94%</div><div class="fa-kl">Budget Attainment</div><div class="fa-delta fa-d-up"><i class="bi bi-arrow-up-short" aria-hidden="true"></i> On track</div></div></div>
    <div class="fa-kpi-card"><div class="fa-kpi-icon fa-ki-red"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div><div><div class="fa-kv">$31K</div><div class="fa-kl">Past-Due AR</div><div class="fa-delta fa-d-dn"><i class="bi bi-arrow-up-short" aria-hidden="true"></i> +3% vs last month</div></div></div>
</div>

<div class="fa-two-col">

    <!-- AR Aging -->
    <div class="fa-panel">
        <div class="fa-panel-hdr">Accounts Receivable Aging</div>
        <div class="fa-aging-chart">
            @foreach (var a in _aging)
            {
                <div class="fa-aging-row">
                    <div class="fa-aging-lbl">@a.Bucket</div>
                    <div class="fa-aging-track"><div class="@a.FillCss" style="width:@a.Pct%"></div></div>
                    <div class="fa-aging-val">@a.Amount</div>
                    <div class="fa-aging-pct">@a.Pct%</div>
                </div>
            }
        </div>
    </div>

    <!-- Revenue by category -->
    <div class="fa-panel">
        <div class="fa-panel-hdr">Revenue Mix by Category</div>
        <div class="fa-rev-list">
            @foreach (var r in _revMix)
            {
                <div class="fa-rev-row">
                    <div class="fa-rev-dot" style="background:@r.Color"></div>
                    <div class="fa-rev-name">@r.Category</div>
                    <div class="fa-rev-bar-wrap"><div class="fa-rev-bar" style="width:@r.Pct%; background:@r.Color"></div></div>
                    <div class="fa-rev-val">@r.Amount</div>
                    <div class="fa-rev-pct">@r.Pct%</div>
                </div>
            }
        </div>
    </div>

    <!-- Budget vs actual -->
    <div class="fa-panel fa-panel--wide">
        <div class="fa-panel-hdr">Budget vs Actual — Monthly (YTD)</div>
        <div class="fa-bva-chart">
            @foreach (var m in _budgetActual)
            {
                <div class="fa-bva-grp">
                    <div class="fa-bva-bars">
                        <div class="fa-bva-bar fa-bva-budget" style="height:@((int)(m.Budget*90.0/_budgetActual.Max(x=>Math.Max(x.Budget,x.Actual))))px" title="Budget: @m.Budget K"></div>
                        <div class="fa-bva-bar fa-bva-actual" style="height:@((int)(m.Actual*90.0/_budgetActual.Max(x=>Math.Max(x.Budget,x.Actual))))px" title="Actual: @m.Actual K"></div>
                    </div>
                    <div class="fa-bva-lbl">@m.Month</div>
                </div>
            }
        </div>
        <div class="fa-bva-legend"><span class="fa-bva-dot fa-bva-budget-dot"></span> Budget <span class="fa-bva-dot fa-bva-actual-dot"></span> Actual</div>
    </div>
</div>

@code {
    private record AgingRow(string Bucket, string Amount, int Pct, string FillCss);
    private record RevCat(string Category, string Amount, int Pct, string Color);
    private record BvaRow(string Month, int Budget, int Actual);

    private List<AgingRow> _aging = [];
    private List<RevCat>   _revMix = [];
    private List<BvaRow>   _budgetActual = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Analytics","/analytics/reports"), new("Financial",""));
        _aging  = [new("Current (≤ 30d)","$141K",66,"fa-af-fill fa-af-green"), new("31–60 days","$43K",20,"fa-af-fill fa-af-amber"), new("61–90 days","$21K",10,"fa-af-fill fa-af-orange"), new("> 90 days","$9K",4,"fa-af-fill fa-af-red")];
        _revMix = [new("Direct Commission","$1,020K",55,"#3b82f6"), new("Broker Fees","$368K",20,"#22c55e"), new("Policy Fees","$184K",10,"#f59e0b"), new("Consulting / Svc","$147K",8,"#8b5cf6"), new("Other","$121K",7,"#94a3b8")];
        _budgetActual = [new("Jan",280,265), new("Feb",280,290), new("Mar",310,304), new("Apr",310,318), new("May",330,309), new("Jun",330,341)];
    }
}
