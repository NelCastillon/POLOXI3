@page "/billing/rate-cards"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>Rate Cards</PageTitle>
<AppPageHeader Title="Rate Cards" Icon="bi-tag" />
<div class="toolbar">
    <AppTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></AppTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
else {
<AppGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(RateCardDto.RateCardCode)"       HeaderText="Code"       Width="130"></GridColumn>
        <GridColumn Field="@nameof(RateCardDto.RateCardName)"       HeaderText="Name"       Width="250"></GridColumn>
        <GridColumn Field="@nameof(RateCardDto.EffectiveStartDate)" HeaderText="Effective"  Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(RateCardDto.EffectiveEndDate)"   HeaderText="Expires"    Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(RateCardDto.StatusCode)"         HeaderText="Status"     Width="110"></GridColumn>
        <GridColumn Field="@nameof(RateCardDto.Description)"        HeaderText="Description" Width="300"></GridColumn>
    </GridColumns>
</AppGrid>
}
@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private string? _loadError;
    private List<RateCardDto>? _items;
    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            var result = await Api.SearchRateCardsAsync(_tenantId, _searchTerm);
            _items = result?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = $"Rate cards failed to load: {ex.Message}";
            _items = [];
        }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
