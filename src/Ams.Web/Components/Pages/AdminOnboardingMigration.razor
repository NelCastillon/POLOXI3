@page "/admin/system/onboarding/migration"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Migration Wizard - AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<AppPageHeader Title="Data Migration Wizard"
               Subtitle="Import accounts, contacts, policies, and claims from your previous AMS platform"
               Icon="bi-database-up">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/admin/system/onboarding")'><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Onboarding</button>
    </Actions>
</AppPageHeader>

<!-- Stepper -->
<div class="mw-stepper">
    @for (int i = 0; i < _steps.Length; i++)
    {
        var idx = i;
        <div class="mw-step @(idx == _currentStep ? "mw-step-active" : idx < _currentStep ? "mw-step-done" : "")">
            <div class="mw-step-circle">@(idx < _currentStep ? "Yes" : (idx + 1).ToString())</div>
            <div class="mw-step-label">@_steps[idx]</div>
        </div>
        @if (i < _steps.Length - 1)
        {
            <div class="mw-step-line @(idx < _currentStep ? "mw-line-done" : "")"></div>
        }
    }
</div>

<div class="mw-card">
    @if (_currentStep == 0)
    {
        <div class="mw-section-title">Select Source System</div>
        <p class="mw-hint">Choose the AMS platform you are migrating from. This determines the expected export format and default field mappings.</p>
        <div class="mw-source-grid">
            @foreach (var src in _sources)
            {
                <div class="mw-source-card @(_selectedSource == src.Key ? "mw-src-sel" : "")" @onclick="() => _selectedSource = src.Key">
                    <div class="mw-src-icon"><i class="bi bi-@src.Icon" aria-hidden="true"></i></div>
                    <div class="mw-src-name">@src.Name</div>
                    <div class="mw-src-desc">@src.Description</div>
                </div>
            }
        </div>
    }
    else if (_currentStep == 1)
    {
        <div class="mw-section-title">Upload Export File</div>
        <p class="mw-hint">Export your data from <strong>@(_sources.FirstOrDefault(s => s.Key == _selectedSource)?.Name ?? _selectedSource)</strong> and upload the file below. Accepted formats: CSV, Excel (.xlsx), JSON.</p>
        <div class="mw-upload-zone">
            <i class="bi bi-cloud-upload mw-upload-icon" aria-hidden="true"></i>
            <div class="mw-upload-label">Drag and drop your file here, or <span class="mw-upload-link">browse to select</span></div>
            <div class="mw-upload-hint-sm">Max file size: 250 MB - CSV, XLSX, JSON</div>
            <input type="file" class="mw-file-input" accept=".csv,.xlsx,.json" />
        </div>
        <div class="mw-file-demo">
            <i class="bi bi-file-earmark-spreadsheet" aria-hidden="true"></i>
            <span>sample_export_accounts.csv - 8,214 rows detected</span>
            <span class="mw-file-ok"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Ready</span>
        </div>
        <div class="mw-data-types">
            <div class="mw-section-title mw-mt">Select Data Types to Import</div>
            @foreach (var dt in _dataTypes)
            {
                <label class="mw-dtype-row">
                    <input type="checkbox" @bind="dt.Selected" class="mw-dtype-chk" />
                    <i class="bi bi-@dt.Icon mw-dtype-icon" aria-hidden="true"></i>
                    <div>
                        <div class="mw-dtype-name">@dt.Name</div>
                        <div class="mw-dtype-desc">@dt.Description</div>
                    </div>
                </label>
            }
        </div>
    }
    else if (_currentStep == 2)
    {
        <div class="mw-section-title">Map Source Fields to AMS Fields</div>
        <p class="mw-hint">Match columns from your export file to AMS destination fields. Fields marked <strong>Required</strong> must be mapped before proceeding.</p>
        <div class="mw-map-table">
            <div class="mw-map-hdr">
                <span>Source Column</span>
                <span>Sample Value</span>
                <span>AMS Destination Field</span>
                <span>Requirement</span>
            </div>
            @foreach (var m in _fieldMappings)
            {
                <div class="mw-map-row @(m.Required && string.IsNullOrEmpty(m.AmsField) ? "mw-map-err" : "")">
                    <span class="mw-map-src">@m.SourceColumn</span>
                    <span class="mw-map-sample">@m.SampleValue</span>
                    <select class="mw-map-sel" @bind="m.AmsField">
                        <option value="">- Skip -</option>
                        @foreach (var f in _amsFields) { <option value="@f">@f</option> }
                    </select>
                    <span class="mw-req-badge @(m.Required ? "mw-req-yes" : "mw-req-opt")">@(m.Required ? "Required" : "Optional")</span>
                </div>
            }
        </div>
    }
    else if (_currentStep == 3)
    {
        <div class="mw-section-title">Validation - Dry Run Results</div>
        <div class="mw-val-summary">
            <div class="mw-val-stat mw-val-ok"><i class="bi bi-check-circle-fill" aria-hidden="true"></i><div><div class="mw-val-num">8,102</div><div class="mw-val-lbl">Valid rows</div></div></div>
            <div class="mw-val-stat mw-val-warn"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><div><div class="mw-val-num">87</div><div class="mw-val-lbl">Warnings</div></div></div>
            <div class="mw-val-stat mw-val-err"><i class="bi bi-x-circle-fill" aria-hidden="true"></i><div><div class="mw-val-num">25</div><div class="mw-val-lbl">Errors</div></div></div>
        </div>
        <p class="mw-hint">Review the issues below. Errors must be resolved in your source file before a live import can proceed. Warnings will be skipped during import.</p>
        <div class="mw-val-issues">
            <div class="mw-val-hdr"><span>Row</span><span>Column</span><span>Message</span><span>Type</span></div>
            @foreach (var issue in _validationIssues)
            {
                <div class="mw-val-row @IssueCss(issue.Severity)">
                    <span class="mw-val-row-lbl">@issue.Row</span>
                    <span class="mw-val-col-lbl">@issue.Column</span>
                    <span class="mw-val-msg">@issue.Message</span>
                    <span class="mw-badge @IssueBadge(issue.Severity)">@issue.Severity</span>
                </div>
            }
        </div>
        <div class="mw-val-actions">
            <button class="um-btn um-btn-ghost" @onclick="DownloadErrorLog"><i class="bi bi-download" aria-hidden="true"></i> Download Error CSV</button>
        </div>
    }
    else if (_currentStep == 4)
    {
        <div class="mw-done-wrap">
            <div class="mw-done-icon"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></div>
            <div class="mw-done-title">Import Complete</div>
            <div class="mw-done-sub">Your data has been successfully imported into AMS.</div>
            <div class="mw-done-stats">
                <div class="mw-done-stat"><div class="mw-done-num mw-dn-ok">8,102</div><div class="mw-done-lbl">Records Imported</div></div>
                <div class="mw-done-stat"><div class="mw-done-num mw-dn-warn">87</div><div class="mw-done-lbl">Skipped (warnings)</div></div>
                <div class="mw-done-stat"><div class="mw-done-num mw-dn-err">25</div><div class="mw-done-lbl">Failed (errors)</div></div>
            </div>
            <div class="mw-done-actions">
                <button class="um-btn um-btn-ghost" @onclick="DownloadErrorLog"><i class="bi bi-download" aria-hidden="true"></i> Download Error Log</button>
                <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/accounts")'><i class="bi bi-building" aria-hidden="true"></i> View Accounts</button>
                <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/admin/system/onboarding")'><i class="bi bi-rocket-takeoff" aria-hidden="true"></i> Back to Onboarding</button>
            </div>
        </div>
    }
</div>

@if (_currentStep < 4)
{
    <div class="mw-nav-btns">
        @if (_currentStep > 0)
        {
            <button class="um-btn um-btn-ghost" @onclick="PrevStep"><i class="bi bi-chevron-left" aria-hidden="true"></i> Back</button>
        }
        else
        {
            <span></span>
        }
        <button class="um-btn um-btn-primary" @onclick="NextStep" disabled="@(_currentStep == 0 && string.IsNullOrEmpty(_selectedSource))">
            @(_currentStep == 3 ? "Run Live Import" : "Next") <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </button>
    </div>
}

@code {
    private EnterpriseToast? _toast;
    private int _currentStep;
    private string _selectedSource = string.Empty;

    private static readonly string[] _steps = ["Source System", "Upload File", "Map Fields", "Validate", "Complete"];

    private void NextStep() { if (_currentStep < _steps.Length - 1) _currentStep++; }
    private void PrevStep() { if (_currentStep > 0) _currentStep--; }

    private async Task DownloadErrorLog()
    {
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = "Error log downloaded.", CssClass = "e-toast-success" });
    }

    private static string IssueCss(string s) => s == "Error" ? "mw-row-err" : "mw-row-warn";
    private static string IssueBadge(string s) => s == "Error" ? "mw-badge-err" : "mw-badge-warn";

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Administration", "/admin"), new("Tenant Onboarding", "/admin/system/onboarding"), new("Migration Wizard", ""));
    }

    private sealed class SourceSystem(string key, string name, string icon, string description) { public string Key=key; public string Name=name; public string Icon=icon; public string Description=description; }
    private sealed class FieldMapping { public string SourceColumn{get;set;}=string.Empty; public string SampleValue{get;set;}=string.Empty; public string AmsField{get;set;}=string.Empty; public bool Required{get;set;} }
    private sealed class ValidationIssue { public int Row{get;set;} public string Column{get;set;}=string.Empty; public string Message{get;set;}=string.Empty; public string Severity{get;set;}=string.Empty; }
    private sealed class DataType { public string Name{get;set;}=string.Empty; public string Icon{get;set;}=string.Empty; public string Description{get;set;}=string.Empty; public bool Selected{get;set;} }

    private List<SourceSystem> _sources =
    [
        new("epic",     "Applied Epic",       "building",          "TAM / Epic AMS export via CSV or XML"),
        new("hawksoft", "HawkSoft",           "feather",           "HawkSoft CSV / backup export"),
        new("qq",       "QQ Catalyst",        "lightning-charge",  "QQ Catalyst data export package"),
        new("ams360",   "AMS360 / Agency Matrix", "grid-3x3",      "AMS360 or Agency Matrix CSV export"),
        new("ezlynx",   "EZLynx",             "bezier2",           "EZLynx account and policy export"),
        new("custom",   "Custom / Other",     "file-earmark-text", "Generic CSV with manual field mapping"),
    ];

    private List<DataType> _dataTypes =
    [
        new DataType { Name="Accounts & Contacts",  Icon="people",              Description="Client accounts, contacts, and addresses",           Selected=true },
        new DataType { Name="Policies",             Icon="shield-check",         Description="Policy records, coverage details, and attachments",  Selected=true },
        new DataType { Name="Claims",               Icon="exclamation-circle",   Description="Historical claims and claim notes",                  Selected=false },
        new DataType { Name="Commission Records",   Icon="percent",              Description="Historical commission statements and splits",         Selected=false },
        new DataType { Name="Notes & Activities",   Icon="sticky",               Description="Account notes, call logs, and activity history",     Selected=false },
    ];

    private List<FieldMapping> _fieldMappings =
    [
        new FieldMapping { SourceColumn="AccountName",   SampleValue="Apex Logistics LLC",  AmsField="Account Name",  Required=true  },
        new FieldMapping { SourceColumn="PhoneMain",     SampleValue="(303) 555-0192",       AmsField="Phone",         Required=true  },
        new FieldMapping { SourceColumn="EmailAddr",     SampleValue="info@apexlog.com",     AmsField="Email",         Required=false },
        new FieldMapping { SourceColumn="SICCode",       SampleValue="4213",                 AmsField="SIC Code",      Required=false },
        new FieldMapping { SourceColumn="AnnualRevenue", SampleValue="4200000",              AmsField="Annual Revenue",Required=false },
        new FieldMapping { SourceColumn="AssignedCSR",   SampleValue="J. Torres",            AmsField="",              Required=true  },
        new FieldMapping { SourceColumn="ProducerCode",  SampleValue="PROD-004",             AmsField="Producer",      Required=true  },
        new FieldMapping { SourceColumn="ZipCode",       SampleValue="80203",                AmsField="ZIP Code",      Required=false },
    ];

    private static readonly string[] _amsFields =
        ["Account Name","Phone","Email","SIC Code","Annual Revenue","Producer","CSR","ZIP Code","City","State","EIN","Website"];

    private List<ValidationIssue> _validationIssues =
    [
        new ValidationIssue { Row=12,  Column="AssignedCSR",   Message="CSR 'M. Davis' not found in AMS users",          Severity="Error"   },
        new ValidationIssue { Row=47,  Column="PhoneMain",     Message="Phone number format invalid: '3035550000x22'",   Severity="Warning" },
        new ValidationIssue { Row=103, Column="EmailAddr",     Message="Duplicate email - same as row 88",               Severity="Warning" },
        new ValidationIssue { Row=218, Column="AssignedCSR",   Message="CSR 'B. Park' not found in AMS users",           Severity="Error"   },
        new ValidationIssue { Row=402, Column="AnnualRevenue", Message="Non-numeric value: '$4.2M'",                     Severity="Error"   },
    ];
}
