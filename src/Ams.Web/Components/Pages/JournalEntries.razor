@page "/finance/journalentries"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Finance
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Journal Entries - AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="je-toast je-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="je-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showStatusConfirm && _statusTarget is not null && !string.IsNullOrWhiteSpace(_pendingStatus))
{
    <div class="je-modal-backdrop" role="presentation" @onclick="CancelStatusUpdate">
        <div class="je-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="je-status-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon"><i class="bi @(_pendingStatus == "Posted" ? "bi-check-circle" : "bi-arrow-counterclockwise")"></i></div>
                <div class="um-confirm-title" id="je-status-title">@(_pendingStatus == "Posted" ? "Post Journal Entry" : "Reopen Journal Entry")</div>
                <div class="um-confirm-body">@(_pendingStatus == "Posted" ? "Post" : "Reopen") <strong>@_statusTarget.EntryNumber</strong>? This updates the entry status in the finance workflow.</div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CancelStatusUpdate" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn um-btn-primary" @onclick="ExecuteStatusUpdateAsync" disabled="@_busy">@(_pendingStatus == "Posted" ? "Post Entry" : "Reopen Entry")</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="je-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="je-modal je-action-modal" role="dialog" aria-modal="true" aria-labelledby="je-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-journal-text" aria-hidden="true"></i>
                <span id="je-form-title">@(_editingId == Guid.Empty ? "New Journal Entry" : "Edit Journal Entry")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="je-modal-intro"><span><i class="bi bi-shield-check" aria-hidden="true"></i> Balanced journal workflow</span><p>Record balanced debit and credit entries for general ledger posting and reporting.</p></div>
                    <div class="um-form-grid">
                        <div class="um-field"><label>Entry Number <span class="text-danger">*</span></label><InputText class="form-control" @bind-Value="_form.EntryNumber" /></div>
                        <div class="um-field"><label>Entry Date <span class="text-danger">*</span></label><InputDate class="form-control" @bind-Value="_form.EntryDate" /></div>
                        <div class="um-field"><label>Total Debit <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.TotalDebit" /></div>
                        <div class="um-field"><label>Total Credit <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.TotalCredit" /></div>
            <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="_form.StatusCode">@foreach (var status in StatusOptions) { <option value="@status">@status</option> }</InputSelect></div>
                        <div class="um-field um-field--full"><label>Description <span class="text-danger">*</span></label><InputTextArea class="form-control" @bind-Value="_form.Description" rows="3" /></div>
                        @if (!string.IsNullOrWhiteSpace(_formError))
                        {
                            <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">@if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } @(_editingId == Guid.Empty ? "Create Entry" : "Save Changes")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="je-enterprise-page">
    <section class="je-header">
        <div class="je-header-left"><div class="je-lob-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></div><div class="je-header-info"><div class="je-title-row"><h1 class="je-page-title">Journal Entries</h1><span class="je-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live journal data</span><span class="je-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span></div><div class="je-sub-row"><span>Review, draft, post, and export balanced general ledger journal entries.</span><span class="je-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Seed sync enabled</span><span class="je-sub-chip"><i class="bi bi-check2-circle" aria-hidden="true"></i> @_filtered.Count active matches</span></div></div></div>
        <div class="je-header-actions"><button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/finance/glaccounts")'><i class="bi bi-journals" aria-hidden="true"></i> GL Accounts</button><button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/finance")'><i class="bi bi-speedometer2" aria-hidden="true"></i> Finance</button><button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi @(_loading ? "bi-arrow-repeat je-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button><button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync" disabled="@(!_filtered.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Entry</button></div>
    </section>

    <section class="je-kpi-strip" aria-label="Journal entry metrics">@foreach (var kpi in Kpis) { <button type="button" class="je-kpi-card @kpi.Tone @(_kpiFilter == kpi.Filter ? "je-kpi-active" : null)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)"><span class="je-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span><span class="je-kpi-copy"><span class="je-kpi-label">@kpi.Label</span><span class="je-kpi-value">@kpi.Value</span><span class="je-kpi-caption">@kpi.Caption</span></span></button> }</section>

    <section class="je-workflow-strip" aria-label="Journal workflow shortcuts">
        <button type="button" class="je-workflow-card je-wf-chart" @onclick='() => Nav.NavigateTo("/finance/glaccounts")'><span class="je-workflow-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span><span class="je-workflow-content"><strong>1</strong><span>Chart</span><small>Review accounts.</small></span></button>
        <button type="button" class="je-workflow-card je-wf-journal" @onclick="OpenCreate"><span class="je-workflow-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span><span class="je-workflow-content"><strong>2</strong><span>Journal</span><small>Create entries.</small></span></button>
        <button type="button" class="je-workflow-card je-wf-post" @onclick='() => SetKpiFilter("draft")'><span class="je-workflow-icon"><i class="bi bi-check2-square" aria-hidden="true"></i></span><span class="je-workflow-content"><strong>3</strong><span>Post</span><small>Post balanced drafts.</small></span></button>
        <button type="button" class="je-workflow-card je-wf-recon" @onclick='() => Nav.NavigateTo("/billing/reconciliation")'><span class="je-workflow-icon"><i class="bi bi-ui-checks-grid" aria-hidden="true"></i></span><span class="je-workflow-content"><strong>4</strong><span>Reconcile</span><small>Validate balances.</small></span></button>
        <button type="button" class="je-workflow-card je-wf-report" @onclick='() => Nav.NavigateTo("/analytics/finance")'><span class="je-workflow-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span><span class="je-workflow-content"><strong>5</strong><span>Report</span><small>Review analytics.</small></span></button>
    </section>

    <section class="je-enterprise-search" aria-label="Journal entry filters"><div class="je-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div><div class="je-search-body"><label for="je-search">Search journal entries</label><input id="je-search" class="je-search-input" type="search" placeholder="Search entry number, description, status..." @bind="SearchFilter" @bind:event="oninput" /><span class="je-search-hint">Filters apply instantly across synchronized journal entries.</span></div><select class="je-filter-select" @bind="StatusFilter" aria-label="Status filter"><option value="">All statuses</option>@foreach (var status in StatusOptions) { <option value="@status">@status</option> }</select><div class="je-search-result"><strong>@_filtered.Count</strong><span>matches</span></div></section>

    @if (!string.IsNullOrWhiteSpace(_loadError)) { <div class="alert alert-danger je-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div> }

    <section class="je-content-layout"><div class="je-grid-wrap"><div class="je-grid-toolbar"><div><strong>Journal register</strong><span>@ActiveFilterText</span></div><div class="je-toolbar-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-eraser" aria-hidden="true"></i> Reset</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/finance/glaccounts")'><i class="bi bi-journals" aria-hidden="true"></i> GL Accounts</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add</button></div></div>
            @if (_loading) { <div class="je-loading"><i class="bi bi-arrow-repeat je-spin" aria-hidden="true"></i><strong>Loading journal entries...</strong><span>Syncing schema, seed data, and journal entries.</span></div> }
            else if (!_filtered.Any()) { <div class="je-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No journal entries found</strong><span>Adjust filters or create a new journal entry.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">New Entry</button></div> }
            else { <div class="je-table-scroll"><table class="je-table"><thead><tr><th>Entry</th><th>Status</th><th>Date</th><th class="je-number">Debit</th><th class="je-number">Credit</th><th class="je-number">Variance</th><th class="je-actions-col">Actions</th></tr></thead><tbody>@foreach (var item in PagedItems) { <tr class="je-table-row @(_selected?.JournalEntryId == item.JournalEntryId ? "je-table-row--selected" : null)" @onclick="() => SelectEntry(item)"><td><div class="je-entry-cell"><span class="je-entry-icon @StatusIconTone(item.StatusCode)"><i class="bi bi-journal-text" aria-hidden="true"></i></span><span><strong>@item.EntryNumber</strong><span>@Truncate(item.Description, 92)</span></span></div></td><td><span class="je-status-chip @StatusCss(item.StatusCode)">@item.StatusCode</span></td><td>@item.EntryDate.ToString("MMM d, yyyy")</td><td class="je-number">@Fmt(item.TotalDebit)</td><td class="je-number">@Fmt(item.TotalCredit)</td><td class="je-number"><span class="@(IsBalanced(item) ? "je-balanced" : "je-unbalanced")">@Fmt(Math.Abs(item.TotalDebit - item.TotalCredit))</span></td><td><div class="je-row-acts"><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Edit" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="@(item.StatusCode == "Posted" ? "Reopen" : "Post")" @onclick:stopPropagation="true" @onclick='() => ConfirmStatusUpdate(item, item.StatusCode == "Posted" ? "Draft" : "Posted")'><i class="bi @(item.StatusCode == "Posted" ? "bi-arrow-counterclockwise" : "bi-check-circle")" aria-hidden="true"></i></button></div></td></tr> }</tbody></table></div><div class="je-pager"><span>Showing @PageStart-@PageEnd of @_filtered.Count</span><div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PrevPage" disabled="@(_page == 1)">Previous</button><span>Page @_page of @TotalPages</span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button></div></div> }
        </div>
        <aside class="je-detail-panel" aria-label="Selected journal entry detail">@if (_selected is null) { <div class="je-detail-empty"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select an entry</strong><span>Choose a row to inspect balance, posting status, and workflow actions.</span></div> } else { <div class="je-detail-head"><div><span class="je-detail-eyebrow"><i class="bi bi-journal-text" aria-hidden="true"></i> Journal entry</span><h2>@_selected.EntryNumber</h2><div class="je-detail-meta"><span>@_selected.EntryDate.ToString("MMM d, yyyy")</span><span class="je-status-chip @StatusCss(_selected.StatusCode)">@_selected.StatusCode</span></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></div><div class="je-detail-body"><div class="je-detail-summary"><div class="je-meta-row"><span class="je-meta-lbl">Debit</span><span class="je-meta-val">@Fmt(_selected.TotalDebit)</span></div><div class="je-meta-row"><span class="je-meta-lbl">Credit</span><span class="je-meta-val">@Fmt(_selected.TotalCredit)</span></div><div class="je-meta-row"><span class="je-meta-lbl">Variance</span><span class="je-meta-val @(IsBalanced(_selected) ? "je-balanced" : "je-unbalanced")">@Fmt(Math.Abs(_selected.TotalDebit - _selected.TotalCredit))</span></div><div class="je-meta-row"><span class="je-meta-lbl">Created</span><span class="je-meta-val">@_selected.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy")</span></div></div><div class="je-note-card"><span><i class="bi bi-journal-text" aria-hidden="true"></i> Entry description</span><p>@_selected.Description</p></div><div class="je-detail-actions"><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, _selected.StatusCode == "Posted" ? "Draft" : "Posted")'><i class="bi @(_selected.StatusCode == "Posted" ? "bi-arrow-counterclockwise" : "bi-check-circle")" aria-hidden="true"></i> @(_selected.StatusCode == "Posted" ? "Reopen" : "Post")</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/finance/glaccounts")'><i class="bi bi-journals" aria-hidden="true"></i> GL Accounts</button></div></div> }</aside>
    </section>
</div>

@code {
    private const int PageSize = 12;
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<JournalEntryDto> _items = [];
    private List<JournalEntryDto> _filtered = [];
    private JournalEntryDto? _selected;
    private JournalEntryDto? _statusTarget;
    private JournalEntryForm _form = new();
    private Guid _editingId = Guid.Empty;
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private string _kpiFilter = "all";
    private string? _pendingStatus;
    private int _page = 1;
    private bool _loading;
    private bool _busy;
    private bool _showForm;
    private bool _showStatusConfirm;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string? _formError;
    private IEnumerable<string> StatusOptions => DistinctOptions(_items.Select(x => x.StatusCode), _form.StatusCode, _statusFilter, _pendingStatus);

    private IEnumerable<JournalEntryDto> PagedItems => _filtered.Skip((_page - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
    private int PageStart => _filtered.Count == 0 ? 0 : ((_page - 1) * PageSize) + 1;
    private int PageEnd => Math.Min(_filtered.Count, _page * PageSize);
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", "info" => "bi-info-circle-fill", _ => "bi-check-circle-fill" };
    private string ActiveFilterText => _kpiFilter == "all" ? "All journal entries" : $"Filtered by {_kpiFilter}";
    private IReadOnlyList<KpiModel> Kpis =>
    [
        new("all", "Entries", _items.Count.ToString("N0"), "All entries", "bi-journal-text", "je-ki-blue"),
        new("posted", "Posted", _items.Count(x => x.StatusCode == "Posted").ToString("N0"), "Finalized", "bi-check-circle", "je-ki-green"),
        new("draft", "Draft", _items.Count(x => x.StatusCode == "Draft").ToString("N0"), "Needs review", "bi-pencil", "je-ki-amber"),
        new("balanced", "Balanced", _items.Count(IsBalanced).ToString("N0"), "Debit equals credit", "bi-scale", "je-ki-green"),
        new("debit", "Debit", Fmt(_items.Sum(x => x.TotalDebit)), "Total debits", "bi-arrow-down-circle", "je-ki-blue"),
        new("credit", "Credit", Fmt(_items.Sum(x => x.TotalCredit)), "Total credits", "bi-arrow-up-circle", "je-ki-green")
    ];

    private string SearchFilter { get => _searchTerm; set { _searchTerm = value; ApplyFilters(resetPage: true); } }
    private string StatusFilter { get => _statusFilter; set { _statusFilter = value; ApplyFilters(resetPage: true); } }

    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Finance", "/finance"), new("Journal Entries", "/finance/journalentries")); await LoadAsync(); }
    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try { var result = await Api.SearchJournalEntriesAsync(_tenantId, string.Empty); _items = result?.Items.OrderByDescending(x => x.EntryDate).ThenByDescending(x => x.CreatedDateUtc).ToList() ?? []; ApplyFilters(resetPage: true); EnsureSelectedStillVisible(); }
        catch (Exception ex) { _loadError = $"Journal entries failed to load: {ex.Message}"; ShowToast(_loadError, "danger"); _items = []; _filtered = []; }
        finally { _loading = false; }
    }
    private void ApplyFilters(bool resetPage)
    {
        IEnumerable<JournalEntryDto> query = _items;
        if (!string.IsNullOrWhiteSpace(_searchTerm)) { var term = _searchTerm.Trim(); query = query.Where(x => Contains(x.EntryNumber, term) || Contains(x.Description, term) || Contains(x.StatusCode, term)); }
        if (!string.IsNullOrWhiteSpace(_statusFilter)) query = query.Where(x => x.StatusCode == _statusFilter);
        query = _kpiFilter switch { "posted" => query.Where(x => x.StatusCode == "Posted"), "draft" => query.Where(x => x.StatusCode == "Draft"), "balanced" => query.Where(IsBalanced), _ => query };
        _filtered = query.OrderByDescending(x => x.EntryDate).ThenByDescending(x => x.CreatedDateUtc).ToList(); if (resetPage) _page = 1; if (_page > TotalPages) _page = TotalPages;
    }
    private void SetKpiFilter(string filter) { _kpiFilter = filter; ApplyFilters(resetPage: true); }
    private void ResetFilters() { _searchTerm = string.Empty; _statusFilter = string.Empty; _kpiFilter = "all"; ApplyFilters(resetPage: true); ShowToast("Journal entry filters reset.", "info"); }
    private void SelectEntry(JournalEntryDto item) => _selected = item;
    private void OpenCreate() { _editingId = Guid.Empty; _formError = null; _form = new JournalEntryForm { EntryNumber = $"JE-{DateTime.UtcNow:yyyyMMddHHmm}" }; _showForm = true; }
    private void OpenEdit(JournalEntryDto entry) { _editingId = entry.JournalEntryId; _formError = null; _form = new JournalEntryForm { EntryNumber = entry.EntryNumber, EntryDate = entry.EntryDate.ToDateTime(TimeOnly.MinValue), Description = entry.Description, TotalDebit = entry.TotalDebit, TotalCredit = entry.TotalCredit, StatusCode = entry.StatusCode }; _showForm = true; }
    private void CloseForm() { if (_busy) return; _showForm = false; }
    private async Task SaveAsync()
    {
        if (_form.TotalDebit != _form.TotalCredit) { _formError = "Total Debit must equal Total Credit."; ShowToast(_formError, "warning"); return; }
        _busy = true; _formError = null;
        try
        {
            if (_editingId == Guid.Empty) { await Api.CreateJournalEntryAsync(new CreateJournalEntryRequest { TenantId = _tenantId, EntryNumber = _form.EntryNumber, EntryDate = DateOnly.FromDateTime(_form.EntryDate), Description = _form.Description, TotalDebit = _form.TotalDebit, TotalCredit = _form.TotalCredit, StatusCode = _form.StatusCode, CreatedByUserId = _tenantAdminUserId }); ShowToast("Journal entry created.", "success"); }
            else { await Api.UpdateJournalEntryAsync(_editingId, new UpdateJournalEntryRequest { TenantId = _tenantId, JournalEntryId = _editingId, EntryNumber = _form.EntryNumber, EntryDate = DateOnly.FromDateTime(_form.EntryDate), Description = _form.Description, TotalDebit = _form.TotalDebit, TotalCredit = _form.TotalCredit, StatusCode = _form.StatusCode, ModifiedByUserId = _tenantAdminUserId }); ShowToast("Journal entry updated.", "success"); }
            _showForm = false; await LoadAsync();
        }
        catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; ShowToast(_formError, "danger"); }
        finally { _busy = false; }
    }
    private void ConfirmStatusUpdate(JournalEntryDto item, string status) { _statusTarget = item; _pendingStatus = status; _showStatusConfirm = true; }
    private void CancelStatusUpdate() { if (_busy) return; _showStatusConfirm = false; _statusTarget = null; _pendingStatus = null; }
    private async Task ExecuteStatusUpdateAsync()
    {
        if (_statusTarget is null || string.IsNullOrWhiteSpace(_pendingStatus)) return;
        _busy = true;
        try { await Api.UpdateJournalEntryAsync(_statusTarget.JournalEntryId, new UpdateJournalEntryRequest { TenantId = _tenantId, JournalEntryId = _statusTarget.JournalEntryId, EntryNumber = _statusTarget.EntryNumber, EntryDate = _statusTarget.EntryDate, Description = _statusTarget.Description, TotalDebit = _statusTarget.TotalDebit, TotalCredit = _statusTarget.TotalCredit, StatusCode = _pendingStatus, ModifiedByUserId = _tenantAdminUserId }); ShowToast($"Journal entry marked {_pendingStatus.ToLowerInvariant()}.", "success"); _showStatusConfirm = false; _statusTarget = null; _pendingStatus = null; await LoadAsync(); }
        catch (Exception ex) { ShowToast($"Update failed: {ex.Message}", "danger"); }
        finally { _busy = false; }
    }
    private Task NotifyValidationAsync(EditContext _) { ShowToast("Please correct validation errors before saving the journal entry.", "warning"); return Task.CompletedTask; }
    private async Task ExportAsync()
    {
        if (!_filtered.Any()) { ShowToast("No journal entries are available to export.", "warning"); return; }
        var csv = new StringBuilder(); csv.AppendLine("EntryNumber,EntryDate,Description,Debit,Credit,Variance,Status,JournalEntryId");
        foreach (var item in _filtered) csv.AppendLine(string.Join(',', Csv(item.EntryNumber), Csv(item.EntryDate.ToString("yyyy-MM-dd")), Csv(item.Description), item.TotalDebit.ToString("0.00"), item.TotalCredit.ToString("0.00"), Math.Abs(item.TotalDebit - item.TotalCredit).ToString("0.00"), Csv(item.StatusCode), Csv(item.JournalEntryId.ToString())));
        var bytes = Encoding.UTF8.GetBytes(csv.ToString()); await Js.InvokeVoidAsync("amsDownload.downloadBase64", $"journalentries-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes)); ShowToast($"Exported {_filtered.Count:N0} journal entries.", "success");
    }
    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind) { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void EnsureSelectedStillVisible() => _selected = _selected is null ? _filtered.FirstOrDefault() : _items.FirstOrDefault(x => x.JournalEntryId == _selected.JournalEntryId) ?? _filtered.FirstOrDefault();
    private static bool IsBalanced(JournalEntryDto item) => item.TotalDebit == item.TotalCredit;
    private static string Fmt(decimal value) => value.ToString("C0");
    private static bool Contains(string? value, string term) => value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
    private static IReadOnlyList<string> DistinctOptions(IEnumerable<string?> values, params string?[] additionalValues) => values.Concat(additionalValues).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x!.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    private static string Truncate(string value, int max) => value.Length <= max ? value : value[..max] + "...";
    private static string StatusCss(string status) => $"je-st-{status.ToLowerInvariant()}";
    private static string StatusIconTone(string status) => status == "Posted" ? "je-di-green" : "je-di-amber";
    private static string Csv(string value) { var quote = Convert.ToChar(34).ToString(); return string.Concat(quote, value.Replace(quote, quote + quote), quote); }
    private async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; }
    private sealed record KpiModel(string Filter, string Label, string Value, string Caption, string Icon, string Tone) { public string Title => $"Filter journal entries by {Label}"; }
    private sealed class JournalEntryForm
    {
        [Required, StringLength(50)] public string EntryNumber { get; set; } = string.Empty;
        [Required] public DateTime EntryDate { get; set; } = DateTime.Today;
        [Required, StringLength(1000)] public string Description { get; set; } = string.Empty;
        [Range(0, 100000000)] public decimal TotalDebit { get; set; }
        [Range(0, 100000000)] public decimal TotalCredit { get; set; }
        [Required, StringLength(50)] public string StatusCode { get; set; } = "Draft";
    }
}