@page "/finance/journalentries"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Journal Entries</PageTitle>

<AppPageHeader Title="Journal Entries"
               Subtitle="Review and manage general ledger journal entries"
               Icon="bi-journal-text">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "fa-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Entry
        </button>
    </Actions>
</AppPageHeader>

<!-- ── Search & Filter ──────────────────────────────────────────────────── -->
<div class="fin-toolbar">
    <div class="fin-search-box">
        <i class="bi bi-search fin-search-icon" aria-hidden="true"></i>
        <input class="e-input fin-search-input"
               placeholder="Search journal entries…"
               @bind="_searchTerm"
               @bind:event="oninput"
               @onkeyup="@(e => e.Key == "Enter" ? LoadAsync() : Task.CompletedTask)" />
    </div>
    <div class="fin-filter-buttons">
        <button class="um-btn um-btn-ghost um-btn-sm @(_filterActive ? "um-btn-active" : "")"
                @onclick="() => _filterActive = !_filterActive">
            <i class="bi bi-funnel" aria-hidden="true"></i> Filter
        </button>
    </div>
</div>

@if (_filterActive)
{
    <div class="fin-filter-panel">
        <div class="fin-filter-group">
            <label class="fin-filter-label">Status</label>
            <select class="e-input" @bind="_filterStatus">
                <option value="">All</option>
                <option value="Draft">Draft</option>
                <option value="Posted">Posted</option>
            </select>
        </div>
    </div>
}

<!-- ── KPI Cards ──────────────────────────────────────────────────────── -->
@if (_stats is not null)
{
    <div class="fin-kpi-strip">
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #dbeafe; color: #1d4ed8;"><i class="bi bi-journal-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.TotalEntries</div>
                <div class="fin-kpi-label">Total Entries</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #d1fae5; color: #047857;"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.PostedEntries</div>
                <div class="fin-kpi-label">Posted</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #fef3c7; color: #b45309;"><i class="bi bi-pencil-square" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.DraftEntries</div>
                <div class="fin-kpi-label">Draft</div>
            </div>
        </div>
    </div>
}

<!-- ── Content ──────────────────────────────────────────────────────── -->
@if (_error is not null)
{
    <div class="fin-alert fin-alert-warning">
        <div class="fin-alert-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></div>
        <div class="fin-alert-body">
            <div class="fin-alert-title">⚠️ Database Schema Issue</div>
            <p>@_error</p>
        </div>
    </div>
}
else if (_loading)
{
    <div class="fin-loading">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading Journal Entries…</span>
    </div>
}
else if (_items?.Count == 0)
{
    <div class="fin-empty-state">
        <i class="bi bi-inbox fin-empty-icon" aria-hidden="true"></i>
        <h3>No Journal Entries Found</h3>
        <p>@(_searchTerm != null ? $"No entries match \"{_searchTerm}\"." : "No journal entries have been created yet.")</p>
    </div>
}
else
{
    <div class="fin-grid-container">
        <SfGrid TValue="JournalEntryDto" DataSource="_items" AllowPaging="true" AllowSorting="true" Height="600px">
            <GridEvents TValue="JournalEntryDto" RowSelected="OnRowSelected" />
            <GridPageSettings PageSize="15"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(JournalEntryDto.EntryNumber)" HeaderText="Entry #" Width="120" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(JournalEntryDto.EntryDate)" HeaderText="Date" Type="ColumnType.Date" Format="d" Width="110" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(JournalEntryDto.Description)" HeaderText="Description" Width="280"></GridColumn>
                <GridColumn Field="@nameof(JournalEntryDto.TotalDebit)" HeaderText="Debit" Format="C2" Width="110" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(JournalEntryDto.TotalCredit)" HeaderText="Credit" Format="C2" Width="110" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(JournalEntryDto.StatusCode)" HeaderText="Status" Width="100" AllowSorting="true">
                    <Template>
                        @{
                            var entry = context as JournalEntryDto;
                            var badgeClass = entry?.StatusCode switch
                            {
                                "Posted" => "fin-badge-success",
                                "Draft" => "fin-badge-secondary",
                                _ => "fin-badge-warning"
                            };
                        }
                        <span class="fin-badge @badgeClass">@entry?.StatusCode</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Actions" Width="90">
                    <Template>
                        @{ var entry = (JournalEntryDto)context; }
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenEdit(entry)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
}

<SfDialog @bind-Visible="_showForm" Width="680px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-journal-text" aria-hidden="true"></i><span>@(_editingId == Guid.Empty ? "New Journal Entry" : "Edit Journal Entry")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Entry Number <span class="text-danger">*</span></label><InputText @bind-Value="_form.EntryNumber" class="um-input" /><ValidationMessage For="() => _form.EntryNumber" class="text-danger" /></div>
                    <div class="um-field"><label>Entry Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.EntryDate" class="um-input" /><ValidationMessage For="() => _form.EntryDate" class="text-danger" /></div>
                    <div class="um-field"><label>Total Debit</label><InputNumber @bind-Value="_form.TotalDebit" class="um-input" /><ValidationMessage For="() => _form.TotalDebit" class="text-danger" /></div>
                    <div class="um-field"><label>Total Credit</label><InputNumber @bind-Value="_form.TotalCredit" class="um-input" /><ValidationMessage For="() => _form.TotalCredit" class="text-danger" /></div>
                    <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input"><option value="Draft">Draft</option><option value="Posted">Posted</option></InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
                    <div class="um-field um-field--full"><label>Description <span class="text-danger">*</span></label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="3" /><ValidationMessage For="() => _form.Description" class="text-danger" /></div>
                    @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Entry")</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private string _filterStatus = "";
    private bool _filterActive = false;
    private bool _loading = false;
    private bool _showForm;
    private bool _saving;
    private List<JournalEntryDto>? _items;
    private string? _error;
    private string? _formError;
    private Guid _editingId = Guid.Empty;
    private JournalEntryForm _form = new();
    private EditContext _editContext = default!;

    private class Stats
    {
        public int TotalEntries { get; set; }
        public int PostedEntries { get; set; }
        public int DraftEntries { get; set; }
    }

    private Stats? _stats;

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home", "/"),
            new("Finance", "/finance"),
            new("Journal Entries", "/finance/journalentries"));
        _editContext = new(_form);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _items = null;
        try
        {
            var result = await Api.SearchJournalEntriesAsync(_tenantId, _searchTerm);
            _items = result?.Items.ToList() ?? [];

            if (!string.IsNullOrEmpty(_filterStatus))
                _items = _items.Where(x => x.StatusCode == _filterStatus).ToList();

            _stats = new Stats
            {
                TotalEntries = _items.Count,
                PostedEntries = _items.Where(x => x.StatusCode == "Posted").Count(),
                DraftEntries = _items.Where(x => x.StatusCode == "Draft").Count()
            };
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            if (ex.Message.Contains("Invalid column name") || ex.Message.Contains("JournalEntry"))
            {
                _error = "Database schema mismatch. Please ensure 00_schema_migration.sql has been applied to your database. See db/README.md for setup instructions.";
            }
            _items = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnRowSelected(RowSelectEventArgs<JournalEntryDto> args) => OpenEdit(args.Data);
    private void OpenCreate() { _editingId = Guid.Empty; _form = new(); _editContext = new(_form); _formError = null; _showForm = true; }
    private void OpenEdit(JournalEntryDto entry) { _editingId = entry.JournalEntryId; _form = new JournalEntryForm { EntryNumber = entry.EntryNumber, EntryDate = entry.EntryDate.ToDateTime(TimeOnly.MinValue), Description = entry.Description, TotalDebit = entry.TotalDebit, TotalCredit = entry.TotalCredit, StatusCode = entry.StatusCode }; _editContext = new(_form); _formError = null; _showForm = true; }
    private void CloseForm() => _showForm = false;
    private async Task SaveAsync()
    {
        if (!_editContext.Validate()) return;
        if (_form.TotalDebit != _form.TotalCredit) { _formError = "Total Debit must equal Total Credit."; return; }
        _saving = true;
        try
        {
            if (_editingId == Guid.Empty)
                await Api.CreateJournalEntryAsync(new CreateJournalEntryRequest { TenantId = _tenantId, EntryNumber = _form.EntryNumber, EntryDate = DateOnly.FromDateTime(_form.EntryDate), Description = _form.Description, TotalDebit = _form.TotalDebit, TotalCredit = _form.TotalCredit, StatusCode = _form.StatusCode });
            else
                await Api.UpdateJournalEntryAsync(_editingId, new UpdateJournalEntryRequest { TenantId = _tenantId, JournalEntryId = _editingId, EntryNumber = _form.EntryNumber, EntryDate = DateOnly.FromDateTime(_form.EntryDate), Description = _form.Description, TotalDebit = _form.TotalDebit, TotalCredit = _form.TotalCredit, StatusCode = _form.StatusCode });
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; }
        finally { _saving = false; }
    }

    private sealed class JournalEntryForm
    {
        [Required, StringLength(50)] public string EntryNumber { get; set; } = string.Empty;
        [Required] public DateTime EntryDate { get; set; } = DateTime.Today;
        [Required, StringLength(1000)] public string Description { get; set; } = string.Empty;
        [Range(0, 100000000)] public decimal TotalDebit { get; set; }
        [Range(0, 100000000)] public decimal TotalCredit { get; set; }
        [Required, StringLength(50)] public string StatusCode { get; set; } = "Draft";
    }
}
