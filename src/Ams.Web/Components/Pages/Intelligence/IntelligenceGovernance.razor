@page "/intelligence/governance"
@attribute [Authorize(Policy=Ams.Web.Security.IntelligencePolicies.GovernanceManage)]
@using Ams.Application.Features.Intelligence
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
<IntelligenceWorkspace><div class="intel-page"><header class="intel-header"><div><span>Safety & governance</span><h1>Engine Policy & Safety Center</h1><p>Inspect versioned engine policies, tenant compliance requirements, safety controls, violations, fail-closed behavior, and human-review gates.</p></div><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">Refresh</button></header>@if(_loading){<div class="intel-state">Loading governed engine configuration...</div>}else if(_error is not null){<div class="intel-error">@_error</div>}else{<section class="intel-kpis"><article><span>Engine policies</span><strong>@_policies.Count</strong></article><article><span>Compliance requirements</span><strong>@_requirements.Count(x=>x.IsActive)</strong></article><article><span>Fail closed</span><strong>@_policies.Count(x=>x.FailClosed)</strong></article><article><span>Safety controls</span><strong>@_controls.Count(x=>x.IsActive)</strong></article><article><span>Safety events</span><strong>@_events.Count</strong></article></section><section class="intel-panel"><h2>Tenant compliance requirements</h2>@if(_requirements.Count==0){<div class="intel-state">No tenant state, carrier, licensing, disclosure, or internal compliance requirements are configured. The compliance engine will not fabricate them.</div>}@foreach(var requirement in _requirements){<div class="intel-row"><div><strong>@requirement.DisplayName</strong><small>@requirement.RequirementCode v@requirement.VersionNumber · @requirement.RequirementScopeCode · @(requirement.JurisdictionCode??"all jurisdictions")</small><span>@requirement.Description</span><span>@(requirement.BlocksTransaction?"blocks transaction":"advisory") · @(requirement.CanBeWaived?"waiver configured":"not waivable")</span></div><AppStatusBadge Status="@(requirement.IsActive?"ACTIVE":"INACTIVE")"/></div>}</section><section class="intel-panel"><h2>Recent safety events</h2>@if(_events.Count==0){<div class="intel-state">No safety violations have been recorded.</div>}@foreach(var item in _events){<div class="intel-row"><div><strong>@item.ControlName</strong><small>@item.EventTypeCode · @item.EnforcementStageCode · @item.DetectedDateUtc.ToLocalTime().ToString("g")</small><span>Enforcement action @item.ActionCode</span></div><AppStatusBadge Status="@item.SeverityCode"/></div>}</section><section class="intel-panel"><h2>Safety controls</h2>@foreach(var control in _controls){<div class="intel-row"><div><strong>@control.DisplayName</strong><small>@control.ControlCode · @control.EnforcementStageCode</small><span>@control.Description</span></div><AppStatusBadge Status="@(control.IsActive?"ACTIVE":"INACTIVE")"/></div>}</section>}</div></IntelligenceWorkspace>
@code{private readonly List<IntelligenceEnginePolicyDto> _policies=[];private readonly List<IntelligenceSafetyControlDto> _controls=[];private readonly List<IntelligenceComplianceRequirementDto> _requirements=[];private readonly List<IntelligenceSafetyEventDto> _events=[];private bool _loading=true;private string? _error;protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Intelligence","/intelligence"),new("Governance","/intelligence/governance"));await LoadAsync();}private async Task LoadAsync(){_loading=true;_error=null;try{var policies=Api.GetIntelligenceEnginePoliciesAsync();var controls=Api.GetIntelligenceSafetyControlsAsync();var requirements=Api.GetIntelligenceComplianceRequirementsAsync();var events=Api.GetIntelligenceSafetyEventsAsync();await Task.WhenAll(policies,controls,requirements,events);_policies.Clear();_policies.AddRange(await policies);_controls.Clear();_controls.AddRange(await controls);_requirements.Clear();_requirements.AddRange(await requirements);_events.Clear();_events.AddRange(await events);}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}}
