@page "/intelligence/executions"
@attribute [Authorize(Policy=Ams.Web.Security.IntelligencePolicies.AuditRead)]
@using Ams.Application.Features.Intelligence
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
<IntelligenceWorkspace><div class="intel-page"><header class="intel-header"><div><span>Governance evidence</span><h1>AI Execution Center</h1><p>Trace models, duration, cost, confidence, grounding, failures, and corrections.</p></div><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">Refresh</button></header><div class="intel-toolbar"><input placeholder="Search correlation, feature, entity, or error" @bind="_search" @bind:event="oninput" /><select @bind="_status"><option value="">All statuses</option><option>COMPLETED</option><option>FAILED</option><option>PROCESSING</option></select><button class="um-btn um-btn-primary" @onclick="LoadAsync">Search</button></div>
@if(_loading){<div class="intel-state">Loading execution evidence...</div>}else if(_error is not null){<div class="intel-error">@_error</div>}else{<section class="intel-kpis"><article><span>Matching executions</span><strong>@_result.TotalCount</strong></article><article><span>Failed</span><strong>@_result.Items.Count(x=>x.StatusCode=="FAILED")</strong></article><article><span>Estimated cost</span><strong>@_result.Items.Sum(x=>x.EstimatedCost??0).ToString("C2")</strong></article><article><span>Grounding sources</span><strong>@_result.Items.Sum(x=>x.GroundingSourceCount)</strong></article></section><section class="intel-panel">@if(_result.Items.Count==0){<div class="intel-state">No executions match the current filters.</div>}@foreach(var item in _result.Items){<div class="intel-row"><div><strong>@item.FeatureCode</strong><small>@item.ProviderCode / @item.ModelCode · @item.CorrelationId</small><span>@item.StartedDateUtc.ToLocalTime().ToString("g") · @(item.DurationMilliseconds?.ToString("N0")??"—") ms · confidence @(item.Confidence?.ToString("P0")??"—")</span></div><div><AppStatusBadge Status="@item.StatusCode" /><button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>OpenAsync(item.ExecutionId)">Inspect</button></div></div>}</section>}
@if(_detail is not null){<section class="intel-panel"><div class="intel-header"><h2>Execution detail</h2><button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>_detail=null">Close</button></div><div class="intel-grid"><div><strong>Feature</strong><span>@_detail.Execution.FeatureCode</span></div><div><strong>Status</strong><span>@_detail.Execution.StatusCode</span></div><div><strong>Tokens</strong><span>@_detail.Execution.InputTokenCount input / @_detail.Execution.OutputTokenCount output</span></div><div><strong>Cost</strong><span>@(_detail.Execution.EstimatedCost?.ToString("C4")??"—")</span></div></div><h2>Grounding sources</h2>@if(_detail.GroundingSources.Count==0){<div class="intel-state">No grounding sources were recorded.</div>}@foreach(var source in _detail.GroundingSources){<div class="intel-row"><div><strong>@(source.Title??source.SourceTypeCode)</strong><small>@source.SourceReference</small></div><span>@(source.RelevanceScore?.ToString("P0")??"—")</span></div>}<h2>Feedback and corrections</h2>@foreach(var feedback in _detail.Feedback){<div class="intel-row"><div><strong>@feedback.FeedbackTypeCode</strong><small>@feedback.Comment</small></div><span>@feedback.CreatedDateUtc.ToLocalTime().ToString("g")</span></div>}<div class="intel-grid"><div class="intel-field"><label>Feedback type</label><select @bind="_feedbackType"><option>QUALITY</option><option>CORRECTION</option><option>APPROVAL</option></select></div><div class="intel-field"><label>Rating</label><input type="number" min="1" max="5" @bind="_rating" /></div><div class="intel-field intel-field-wide"><label>Comment</label><textarea @bind="_comment"></textarea></div></div><button class="um-btn um-btn-primary" @onclick="SubmitFeedbackAsync">Save feedback</button></section>}</div></IntelligenceWorkspace>
@code{private PagedResult<AiExecutionSummaryDto> _result=new();private AiExecutionDetailDto? _detail;private bool _loading=true;private string? _error;private string _search="",_status="",_feedbackType="QUALITY",_comment="";private short? _rating;
protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Intelligence","/intelligence"),new("Executions","/intelligence/executions"));await LoadAsync();}private async Task LoadAsync(){_loading=true;_error=null;try{_result=await Api.SearchIntelligenceExecutionsAsync(_search,null,_status);}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}private async Task OpenAsync(Guid id){_detail=await Api.GetIntelligenceExecutionAsync(id);}private async Task SubmitFeedbackAsync(){if(_detail is null)return;try{await Api.SubmitIntelligenceFeedbackAsync(_detail.Execution.ExecutionId,new(Guid.Empty,_detail.Execution.ExecutionId,_feedbackType,_rating,null,_comment,Guid.Empty));_comment="";_detail=await Api.GetIntelligenceExecutionAsync(_detail.Execution.ExecutionId);}catch(Exception ex){_error=ex.Message;}}
}
