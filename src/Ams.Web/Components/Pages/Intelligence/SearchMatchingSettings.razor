@page "/intelligence/search-matching/settings"
@using Ams.Application.Features.SearchMatching
@inject ApiClient Api
@inject IJSRuntime JS

<PageTitle>Search & Matching Settings - AMS</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div><h1 class="h3 mb-1"><i class="bi bi-sliders me-2"></i>Search & Matching Settings</h1><p class="text-body-secondary mb-0">Control database-backed scoring profiles, field rules, algorithms, and normalization terms.</p></div>
        <button class="btn btn-outline-primary" @onclick="LoadAsync" disabled="@_busy"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>
    </div>

        <div class="card mb-4"><div class="card-header"><strong>Operational telemetry</strong><span class="text-body-secondary ms-2">Retained tenant activity</span></div><div class="card-body"><div class="row g-3">
            <div class="col-6 col-md-2"><small class="text-body-secondary">Executions</small><div class="fs-4 fw-semibold">@_model.Telemetry.ExecutionCount</div></div>
            <div class="col-6 col-md-2"><small class="text-body-secondary">Completed</small><div class="fs-4 fw-semibold text-success">@_model.Telemetry.CompletedExecutionCount</div></div>
            <div class="col-6 col-md-2"><small class="text-body-secondary">Failed</small><div class="fs-4 fw-semibold @(_model.Telemetry.FailedExecutionCount > 0 ? "text-danger" : "")">@_model.Telemetry.FailedExecutionCount</div></div>
            <div class="col-6 col-md-2"><small class="text-body-secondary">Semantic evidence</small><div class="fs-4 fw-semibold">@_model.Telemetry.SemanticEvidenceCount</div></div>
            <div class="col-6 col-md-2"><small class="text-body-secondary">Review decisions</small><div class="fs-4 fw-semibold">@_model.Telemetry.ReviewDecisionCount</div></div>
            <div class="col-6 col-md-2"><small class="text-body-secondary">Open duplicates</small><div class="fs-4 fw-semibold">@_model.Telemetry.OpenDuplicateGroupCount</div></div>
        </div>@if (_model.Telemetry.LastExecutionDateUtc is null) { <div class="alert alert-info mt-3 mb-0">No retained matching executions exist for this tenant yet. Activity appears here when users run matching, search, duplicate scans, or review workflows.</div> } else { <small class="text-body-secondary d-block mt-3">Last execution: @_model.Telemetry.LastExecutionDateUtc.Value.ToLocalTime().ToString("g")</small> }</div></div>

    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger">@_error</div> }
    @if (_busy && _model is null) { <div class="text-center py-5"><div class="spinner-border"></div></div> }
    else if (_model is not null)
    {
        <div class="row g-3 mb-4">
            @foreach (var capability in _model.Capabilities)
            {
                <div class="col-12 col-md-4 col-xl-2"><div class="card h-100"><div class="card-body"><strong>@capability.DisplayName</strong><div class="mt-2"><span class="badge @(capability.IsEnabled && capability.IsAvailable ? "bg-success" : "bg-secondary")">@(capability.IsEnabled && capability.IsAvailable ? "Available" : "Unavailable")</span></div>@if (capability.CapabilityCode == "SEMANTIC") { <small class="d-block text-body-secondary mt-2">@SemanticConfiguration(capability.ConfigurationJson)</small> }</div></div></div>
            }
        </div>

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item"><button class="nav-link @(TabClass("profiles"))" @onclick='() => _tab = "profiles"'>Profiles</button></li>
            <li class="nav-item"><button class="nav-link @(TabClass("algorithms"))" @onclick='() => _tab = "algorithms"'>Algorithms</button></li>
            <li class="nav-item"><button class="nav-link @(TabClass("terms"))" @onclick='() => _tab = "terms"'>Normalization</button></li>
        </ul>

        @if (_tab == "profiles")
        {
            <div class="d-flex justify-content-end mb-3"><button class="btn btn-primary" @onclick="NewProfile"><i class="bi bi-plus-lg me-1"></i>New tenant profile</button></div>
            <div class="accordion" id="matchingProfiles">
                @foreach (var profile in _model.Profiles)
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#profile-@profile.MatchProfileId"><span class="me-2">@profile.DisplayName</span><span class="badge @(profile.IsInherited ? "bg-secondary" : "bg-primary")">@(profile.IsInherited ? "Platform default" : "Tenant override")</span></button></h2>
                        <div id="profile-@profile.MatchProfileId" class="accordion-collapse collapse"><div class="accordion-body">
                            <div class="row g-3 mb-3"><div class="col-md-3"><small class="text-body-secondary">Entity</small><div>@profile.EntityTypeCode</div></div><div class="col-md-3"><small class="text-body-secondary">Thresholds</small><div>@profile.ExactThreshold / @profile.StrongThreshold / @profile.PossibleThreshold</div></div><div class="col-md-3"><small class="text-body-secondary">Candidates</small><div>@profile.MaximumCandidates</div></div><div class="col-md-3"><small class="text-body-secondary">Semantic concepts</small><div>@profile.SemanticMaximumConcepts</div></div></div>
                            <div class="d-flex gap-2 mb-3"><button class="btn btn-sm btn-outline-primary" @onclick="() => EditProfile(profile)">@(profile.IsInherited ? "Create override" : "Edit")</button>@if (!profile.IsInherited) { <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteProfileAsync(profile)">Delete</button> }<button class="btn btn-sm btn-outline-success" @onclick="() => NewRule(profile)" disabled="@profile.IsInherited">Add field rule</button></div>
                            <div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Field</th><th>Algorithm</th><th>Weight</th><th>Minimum</th><th>Controls</th><th></th></tr></thead><tbody>
                                @foreach (var rule in profile.FieldRules)
                                {
                                    <tr><td>@rule.DisplayName <small class="d-block text-body-secondary">@rule.FieldCode</small></td><td>@rule.AlgorithmCode</td><td>@rule.Weight</td><td>@rule.MinimumSimilarity%</td><td>@(rule.IsCriticalIdentifier ? "Critical " : "")@(rule.ExactMatchOnly ? "Exact only" : "")</td><td class="text-end">@if (!rule.IsInherited) { <button class="btn btn-sm btn-link" @onclick="() => EditRule(rule)">Edit</button><button class="btn btn-sm btn-link text-danger" @onclick="() => DeleteRuleAsync(rule)">Delete</button> }</td></tr>
                                }
                            </tbody></table></div>
                        </div></div>
                    </div>
                }
            </div>
        }
        else if (_tab == "algorithms")
        {
            <div class="d-flex justify-content-end mb-3"><button class="btn btn-primary" @onclick="NewAlgorithm">New tenant algorithm</button></div>
            <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Code</th><th>Name</th><th>Kind</th><th>Scope</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var item in _model.Algorithms) { <tr><td><code>@item.AlgorithmCode</code></td><td>@item.DisplayName</td><td>@item.AlgorithmKindCode</td><td>@(item.IsInherited ? "Platform" : "Tenant")</td><td>@(item.IsActive ? "Active" : "Inactive")</td><td class="text-end"><button class="btn btn-sm btn-link" @onclick="() => EditAlgorithm(item)">@(item.IsInherited ? "Create override" : "Edit")</button>@if (!item.IsInherited) { <button class="btn btn-sm btn-link text-danger" @onclick="() => DeleteAlgorithmAsync(item)">Delete</button> }</td></tr> }</tbody></table></div>
        }
        else
        {
            <div class="d-flex justify-content-end mb-3"><button class="btn btn-primary" @onclick="NewTerm">New normalization term</button></div>
            <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Entity / field</th><th>Source</th><th>Normalized</th><th>Kind</th><th>Scope</th><th></th></tr></thead><tbody>@foreach (var item in _model.NormalizationTerms) { <tr><td>@item.EntityTypeCode / @item.FieldCode</td><td>@item.SourceValue</td><td>@item.NormalizedValue</td><td>@item.TermKindCode</td><td>@(item.IsInherited ? "Platform" : "Tenant")</td><td class="text-end"><button class="btn btn-sm btn-link" @onclick="() => EditTerm(item)">@(item.IsInherited ? "Create override" : "Edit")</button>@if (!item.IsInherited) { <button class="btn btn-sm btn-link text-danger" @onclick="() => DeleteTermAsync(item)">Delete</button> }</td></tr> }</tbody></table></div>
        }
    }
</div>

@if (_editor is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">@_editorTitle</h2><button class="btn-close" @onclick="CloseEditor"></button></div><div class="modal-body"><EditForm Model="_editor" OnValidSubmit="SaveEditorAsync"><DataAnnotationsValidator /><ValidationSummary />
        @if (_editor is SaveMatchProfileSettingRequest profile) { <div class="row g-3"><Field Label="Profile code"><InputText class="form-control" @bind-Value="profile.ProfileCode" /></Field><Field Label="Entity type"><InputText class="form-control" @bind-Value="profile.EntityTypeCode" /></Field><Field Label="Display name"><InputText class="form-control" @bind-Value="profile.DisplayName" /></Field><Field Label="Maximum candidates"><InputNumber class="form-control" @bind-Value="profile.MaximumCandidates" /></Field><Field Label="Exact threshold"><InputNumber class="form-control" @bind-Value="profile.ExactThreshold" /></Field><Field Label="Strong threshold"><InputNumber class="form-control" @bind-Value="profile.StrongThreshold" /></Field><Field Label="Possible threshold"><InputNumber class="form-control" @bind-Value="profile.PossibleThreshold" /></Field><Field Label="Semantic maximum concepts"><InputNumber class="form-control" @bind-Value="profile.SemanticMaximumConcepts" /></Field><div class="col-12"><label class="form-label">Description</label><InputTextArea class="form-control" @bind-Value="profile.Description" /></div><div class="col-12"><InputCheckbox @bind-Value="profile.RequiresReview" /> Requires review <InputCheckbox class="ms-3" @bind-Value="profile.IsActive" /> Active</div></div> }
        else if (_editor is SaveMatchFieldRuleSettingRequest rule) { <div class="row g-3"><Field Label="Field code"><InputText class="form-control" @bind-Value="rule.FieldCode" /></Field><Field Label="Display name"><InputText class="form-control" @bind-Value="rule.DisplayName" /></Field><Field Label="Algorithm"><InputSelect class="form-select" @bind-Value="rule.MatchAlgorithmId">@foreach (var algorithm in _model!.Algorithms.Where(x => x.IsActive)) { <option value="@algorithm.MatchAlgorithmId">@algorithm.DisplayName</option> }</InputSelect></Field><Field Label="Weight"><InputNumber class="form-control" @bind-Value="rule.Weight" /></Field><Field Label="Minimum similarity"><InputNumber class="form-control" @bind-Value="rule.MinimumSimilarity" /></Field><Field Label="Sort order"><InputNumber class="form-control" @bind-Value="rule.SortOrder" /></Field><div class="col-12"><InputCheckbox @bind-Value="rule.IsRequired" /> Required <InputCheckbox class="ms-3" @bind-Value="rule.IsCriticalIdentifier" /> Critical identifier <InputCheckbox class="ms-3" @bind-Value="rule.ExactMatchOnly" /> Exact only <InputCheckbox class="ms-3" @bind-Value="rule.IsSensitive" /> Sensitive <InputCheckbox class="ms-3" @bind-Value="rule.IsActive" /> Active</div></div> }
        else if (_editor is SaveMatchAlgorithmSettingRequest algorithm) { <div class="row g-3"><Field Label="Algorithm code"><InputText class="form-control" @bind-Value="algorithm.AlgorithmCode" /></Field><Field Label="Display name"><InputText class="form-control" @bind-Value="algorithm.DisplayName" /></Field><Field Label="Kind"><InputSelect class="form-select" @bind-Value="algorithm.AlgorithmKindCode">@foreach (var kind in AlgorithmKinds) { <option>@kind</option> }</InputSelect></Field><div class="col-12"><label class="form-label">Description</label><InputTextArea class="form-control" @bind-Value="algorithm.Description" /></div><div class="col-12"><label class="form-label">Configuration JSON</label><InputTextArea class="form-control font-monospace" @bind-Value="algorithm.ConfigurationJson" /></div><div class="col-12"><InputCheckbox @bind-Value="algorithm.IsActive" /> Active</div></div> }
        else if (_editor is SaveNormalizationTermSettingRequest term) { <div class="row g-3"><Field Label="Entity type"><InputText class="form-control" @bind-Value="term.EntityTypeCode" /></Field><Field Label="Field code"><InputText class="form-control" @bind-Value="term.FieldCode" /></Field><Field Label="Source value"><InputText class="form-control" @bind-Value="term.SourceValue" /></Field><Field Label="Normalized value"><InputText class="form-control" @bind-Value="term.NormalizedValue" /></Field><Field Label="Kind"><InputSelect class="form-select" @bind-Value="term.TermKindCode">@foreach (var kind in TermKinds) { <option>@kind</option> }</InputSelect></Field><Field Label="Culture"><InputText class="form-control" @bind-Value="term.CultureCode" /></Field><Field Label="Sort order"><InputNumber class="form-control" @bind-Value="term.SortOrder" /></Field><div class="col-12"><InputCheckbox @bind-Value="term.IsActive" /> Active</div></div> }
        <div class="modal-footer px-0 pb-0 mt-4"><button type="button" class="btn btn-outline-secondary" @onclick="CloseEditor">Cancel</button><button type="submit" class="btn btn-primary" disabled="@_busy">Save</button></div>
    </EditForm></div></div></div></div>
}

@code {
    private SearchMatchingAdministration? _model; private object? _editor; private string _editorTitle = ""; private string _tab = "profiles"; private string? _error; private bool _busy;
    private static readonly string[] AlgorithmKinds = ["EXACT", "NORMALIZED", "PHONETIC", "EDIT_DISTANCE", "FUZZY", "SEMANTIC"];
    private static readonly string[] TermKinds = ["SYNONYM", "REPLACEMENT", "ABBREVIATION", "STOP_WORD"];
    protected override Task OnInitializedAsync() => LoadAsync();
    private string TabClass(string tab) => _tab == tab ? "active" : "";
    private async Task LoadAsync() { try { _busy = true; _error = null; _model = await Api.GetSearchMatchingAdministrationAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
    private void NewProfile() => Open("New tenant profile", new SaveMatchProfileSettingRequest { ExactThreshold = 95, StrongThreshold = 85, PossibleThreshold = 70, MaximumCandidates = 25, SemanticMaximumConcepts = 12 });
    private void EditProfile(MatchProfileSetting x) => Open(x.IsInherited ? "Create tenant override" : "Edit tenant profile", new SaveMatchProfileSettingRequest { MatchProfileId = x.IsInherited ? null : x.MatchProfileId, ProfileCode = x.ProfileCode, EntityTypeCode = x.EntityTypeCode, DisplayName = x.DisplayName, Description = x.Description, ExactThreshold = x.ExactThreshold, StrongThreshold = x.StrongThreshold, PossibleThreshold = x.PossibleThreshold, MaximumCandidates = x.MaximumCandidates, SemanticMaximumConcepts = x.SemanticMaximumConcepts, RequiresReview = x.RequiresReview, IsActive = x.IsActive, RowVersion = x.IsInherited ? null : x.RowVersion });
    private void NewRule(MatchProfileSetting x) => Open("New field rule", new SaveMatchFieldRuleSettingRequest { MatchProfileId = x.MatchProfileId, MatchAlgorithmId = _model!.Algorithms.First(y => y.IsActive).MatchAlgorithmId, Weight = 10, MinimumSimilarity = 70, SortOrder = x.FieldRules.Count * 10 + 10 });
    private void EditRule(MatchFieldRuleSetting x) => Open("Edit field rule", new SaveMatchFieldRuleSettingRequest { MatchFieldRuleId = x.MatchFieldRuleId, MatchProfileId = x.MatchProfileId, FieldCode = x.FieldCode, DisplayName = x.DisplayName, MatchAlgorithmId = x.MatchAlgorithmId, Weight = x.Weight, MinimumSimilarity = x.MinimumSimilarity, IsRequired = x.IsRequired, IsCriticalIdentifier = x.IsCriticalIdentifier, ExactMatchOnly = x.ExactMatchOnly, IsSensitive = x.IsSensitive, SortOrder = x.SortOrder, IsActive = x.IsActive, RowVersion = x.RowVersion });
    private void NewAlgorithm() => Open("New tenant algorithm", new SaveMatchAlgorithmSettingRequest { AlgorithmKindCode = "FUZZY" });
    private void EditAlgorithm(MatchAlgorithmSetting x) => Open(x.IsInherited ? "Create tenant algorithm override" : "Edit tenant algorithm", new SaveMatchAlgorithmSettingRequest { MatchAlgorithmId = x.IsInherited ? null : x.MatchAlgorithmId, AlgorithmCode = x.AlgorithmCode, DisplayName = x.DisplayName, AlgorithmKindCode = x.AlgorithmKindCode, Description = x.Description, ConfigurationJson = x.ConfigurationJson, IsActive = x.IsActive, RowVersion = x.IsInherited ? null : x.RowVersion });
    private void NewTerm() => Open("New normalization term", new SaveNormalizationTermSettingRequest { EntityTypeCode = "Global", FieldCode = "Global", TermKindCode = "SYNONYM" });
    private void EditTerm(NormalizationTermSetting x) => Open(x.IsInherited ? "Create tenant normalization override" : "Edit normalization term", new SaveNormalizationTermSettingRequest { NormalizationTermId = x.IsInherited ? null : x.NormalizationTermId, EntityTypeCode = x.EntityTypeCode, FieldCode = x.FieldCode, SourceValue = x.SourceValue, NormalizedValue = x.NormalizedValue, TermKindCode = x.TermKindCode, CultureCode = x.CultureCode, SortOrder = x.SortOrder, IsActive = x.IsActive, RowVersion = x.IsInherited ? null : x.RowVersion });
    private void Open(string title, object editor) { _editorTitle = title; _editor = editor; _error = null; } private void CloseEditor() => _editor = null;
    private async Task SaveEditorAsync() { try { _busy = true; if (_editor is SaveMatchProfileSettingRequest p) await Api.SaveMatchProfileSettingAsync(p); else if (_editor is SaveMatchFieldRuleSettingRequest r) await Api.SaveMatchFieldRuleSettingAsync(r); else if (_editor is SaveMatchAlgorithmSettingRequest a) await Api.SaveMatchAlgorithmSettingAsync(a); else if (_editor is SaveNormalizationTermSettingRequest n) await Api.SaveNormalizationTermSettingAsync(n); _editor = null; await LoadAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
    private async Task<bool> ConfirmAsync(string message) => await JS.InvokeAsync<bool>("confirm", message);
    private async Task DeleteProfileAsync(MatchProfileSetting x) => await DeleteAsync($"Delete {x.DisplayName}?", () => Api.DeleteMatchProfileSettingAsync(x.MatchProfileId, x.RowVersion));
    private async Task DeleteRuleAsync(MatchFieldRuleSetting x) => await DeleteAsync($"Delete {x.DisplayName}?", () => Api.DeleteMatchFieldRuleSettingAsync(x.MatchFieldRuleId, x.RowVersion));
    private async Task DeleteAlgorithmAsync(MatchAlgorithmSetting x) => await DeleteAsync($"Delete {x.DisplayName}?", () => Api.DeleteMatchAlgorithmSettingAsync(x.MatchAlgorithmId, x.RowVersion));
    private async Task DeleteTermAsync(NormalizationTermSetting x) => await DeleteAsync($"Delete normalization for {x.SourceValue}?", () => Api.DeleteNormalizationTermSettingAsync(x.NormalizationTermId, x.RowVersion));
    private async Task DeleteAsync(string message, Func<Task> operation) { if (!await ConfirmAsync(message)) return; try { _busy = true; _error = null; await operation(); await LoadAsync(); } catch (Exception ex) { _error = ex.Message; } finally { _busy = false; } }
    private static string SemanticConfiguration(string json) { try { using var document = System.Text.Json.JsonDocument.Parse(json); var root = document.RootElement; return $"Tokens {root.GetProperty("maximumTokens").GetInt32()}, phrase length {root.GetProperty("maximumPhraseLength").GetInt32()}, phrases {root.GetProperty("maximumPhrases").GetInt32()}"; } catch { return "Configuration unavailable"; } }
}
