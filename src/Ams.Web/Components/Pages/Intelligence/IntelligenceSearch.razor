@page "/intelligence/search"
@attribute [Authorize(Policy=Ams.Web.Security.IntelligencePolicies.Search)]
@using Ams.Application.Features.Intelligence
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
<IntelligenceWorkspace><div class="intel-page"><header class="intel-header"><div><span>Permission-aware discovery</span><h1>Search Intelligence</h1><p>Natural-language and hybrid keyword/concept search across only the records the current user may read.</p></div></header><section class="intel-panel"><div class="intel-toolbar"><input style="flex:1" placeholder="Example: commercial vehicle fleet submissions missing loss runs" @bind="_query" @bind:event="oninput" @onkeydown="KeyDown" /><select @bind="_module"><option value="">All modules</option><option>Accounts</option><option>Submissions</option><option>Policies</option><option>Claims</option><option>Documents</option><option>Knowledge</option></select><button class="um-btn um-btn-primary" @onclick="SearchAsync" disabled="@_loading"><i class="bi bi-search"></i> Search</button></div></section>@if(_loading){<div class="intel-state">Expanding concepts and searching authorized records...</div>}else if(_error is not null){<div class="intel-error">@_error</div>}else if(_response is not null){<section class="intel-kpis"><article><span>Results</span><strong>@_response.Results.Count</strong></article><article><span>Duration</span><strong>@_response.DurationMilliseconds ms</strong></article><article><span>Expanded terms</span><strong>@_response.ExpandedTerms.Count</strong></article></section>@if(_response.ExpandedTerms.Count>0){<section class="intel-panel"><h2>Query expansion</h2><div class="intel-toolbar">@foreach(var term in _response.ExpandedTerms){<span class="um-badge um-badge-neutral">@term</span>}</div></section>}<section class="intel-panel">@if(_response.Results.Count==0){<div class="intel-state">No authorized indexed records matched this query.</div>}@foreach(var result in _response.Results){<div class="intel-row"><div><strong>@result.Title</strong><small>@result.ModuleCode · @result.EntityTypeCode</small><span>@result.Excerpt</span>@if(result.Concepts.Count>0){<small>@string.Join(" · ",result.Concepts.Select(x=>x.PreferredLabel))</small>}</div><div><strong>@result.CombinedScore.ToString("P0")</strong><small>keyword @result.KeywordScore.ToString("P0") · semantic @result.SemanticScore.ToString("P0")</small></div></div>}</section>}</div></IntelligenceWorkspace>
@code{private string _query="",_module="";private bool _loading;private string? _error;private IntelligenceSearchResponse? _response;protected override Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Intelligence","/intelligence"),new("Search","/intelligence/search"));return Task.CompletedTask;}private async Task SearchAsync(){if(string.IsNullOrWhiteSpace(_query)||_query.Trim().Length<2)return;_loading=true;_error=null;try{_response=await Api.IntelligenceSearchAsync(new(Guid.Empty,Guid.Empty,_query,_module,null,50,Guid.NewGuid().ToString("N")));}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}private async Task KeyDown(KeyboardEventArgs args){if(args.Key=="Enter")await SearchAsync();}
}
