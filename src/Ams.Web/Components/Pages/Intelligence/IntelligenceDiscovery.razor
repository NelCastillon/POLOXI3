@page "/intelligence/discovery"
@attribute [Authorize(Policy=Ams.Web.Security.IntelligencePolicies.RelationshipsRead)]
@using Ams.Application.Features.Intelligence
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
<IntelligenceWorkspace><div class="intel-page"><header class="intel-header"><div><span>Search & discovery</span><h1>Relationship & Similarity Explorer</h1><p>Traverse source-linked, permission-filtered relationships and compare versioned similarity projections without exposing unauthorized records.</p></div></header><section class="intel-panel"><h2>Explore an authorized record</h2><div class="intel-toolbar"><select @bind="_entityType"><option>ACCOUNT</option><option>SUBMISSION</option><option>POLICY</option><option>CLAIM</option><option>DOCUMENT</option></select><input placeholder="Entity ID" @bind="_entityIdText"/><input type="number" min="1" max="10" title="Maximum relationship depth" @bind="_depth"/><button class="um-btn um-btn-primary" @onclick="ExploreAsync" disabled="@_loading">Explore</button></div></section>@if(_loading){<div class="intel-state">Loading authorized discovery projections...</div>}else if(_error is not null){<div class="intel-error">@_error</div>}else if(_graph is not null){<section class="intel-kpis"><article><span>Relationships</span><strong>@_graph.Relationships.Count</strong><small>Through depth @_graph.MaximumDepth</small></article><article><span>Similar records</span><strong>@_similar.Count</strong><small>Score ≥ 70%</small></article><article><span>Source modules</span><strong>@_graph.Relationships.Select(x=>x.SourceModuleCode).Distinct().Count()</strong><small>Authoritative origins</small></article></section><section class="intel-panel"><h2>Relationship graph</h2>@if(_graph.Relationships.Count==0){<div class="intel-state">No authorized relationships are currently projected for this record.</div>}@foreach(var edge in _graph.Relationships){<div class="intel-row"><div><strong>@edge.SourceEntityTypeCode → @edge.RelationshipTypeCode → @edge.TargetEntityTypeCode</strong><small>@edge.SourceEntityId → @edge.TargetEntityId</small><span>@edge.SourceReference · synchronized @edge.LastSynchronizedDateUtc.ToLocalTime().ToString("g")</span></div><span>@edge.Strength.ToString("P0") strength</span></div>}</section><section class="intel-panel"><h2>Similar authorized records</h2>@if(_similar.Count==0){<div class="intel-state">No versioned similarity records meet the configured threshold.</div>}@foreach(var item in _similar){<div class="intel-row"><div><strong>@item.EntityTypeCode @item.SimilarEntityId</strong><small>@item.SimilarityModelCode · version @item.SimilarityModelVersion</small><span>Calculated @item.CalculatedDateUtc.ToLocalTime().ToString("g")</span></div><strong>@item.SimilarityScore.ToString("P0")</strong></div>}</section>}</div></IntelligenceWorkspace>
@code{private EntityRelationshipGraphDto? _graph;private IReadOnlyCollection<EntitySimilarityDto> _similar=[];private bool _loading;private string? _error;private string _entityType="ACCOUNT",_entityIdText="";private int _depth=3;protected override Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Intelligence","/intelligence"),new("Discovery","/intelligence/discovery"));return Task.CompletedTask;}private async Task ExploreAsync(){if(!Guid.TryParse(_entityIdText,out var id)){_error="Enter a valid existing entity ID.";return;}_loading=true;_error=null;try{var graph=Api.GetIntelligenceRelationshipsAsync(_entityType,id,_depth);var similar=Api.GetIntelligenceSimilarityAsync(_entityType,id);await Task.WhenAll(graph,similar);_graph=await graph;_similar=await similar;}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}}
