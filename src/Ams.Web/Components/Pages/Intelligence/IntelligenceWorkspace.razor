<div class="intel-shell">
    <aside class="intel-rail">
        <div class="intel-brand">
            <span class="intel-brand-icon" aria-hidden="true"><i class="bi bi-stars"></i></span>
            <span><small>AMS Enterprise</small><strong>Intelligence</strong></span>
        </div>
        <div class="intel-nav-label">Workspace</div>
        <nav class="intel-nav" aria-label="Intelligence platform">
        <AuthorizeView Policy="@Ams.Web.Security.IntelligencePolicies.Read"><NavLink href="/intelligence" Match="NavLinkMatch.All"><i class="bi bi-speedometer2"></i> Dashboard</NavLink></AuthorizeView>
        <AuthorizeView Policy="@Ams.Web.Security.IntelligencePolicies.Search"><NavLink href="/intelligence/search"><i class="bi bi-search"></i> Search</NavLink></AuthorizeView>
        <AuthorizeView Policy="@Ams.Web.Security.IntelligencePolicies.Read"><NavLink href="/intelligence/recommendations"><i class="bi bi-lightbulb"></i> Recommendations</NavLink></AuthorizeView>
        <AuthorizeView Policy="@Ams.Web.Security.IntelligencePolicies.Review"><NavLink href="/intelligence/review"><i class="bi bi-check2-square"></i> Review</NavLink></AuthorizeView>
        <AuthorizeView Policy="@Ams.Web.Security.IntelligencePolicies.AuditRead"><NavLink href="/intelligence/executions"><i class="bi bi-activity"></i> Executions</NavLink></AuthorizeView>
        <AuthorizeView Policy="@Ams.Web.Security.IntelligencePolicies.Evaluate"><NavLink href="/intelligence/evaluations"><i class="bi bi-clipboard-data"></i> Evaluations</NavLink></AuthorizeView>
        <AuthorizeView Policy="@Ams.Web.Security.IntelligencePolicies.Configure"><NavLink href="/intelligence/configuration"><i class="bi bi-sliders"></i> Configuration</NavLink></AuthorizeView>
        </nav>
        <div class="intel-nav-label intel-nav-label-secondary">Knowledge governance</div>
        <nav class="intel-nav intel-nav-secondary" aria-label="Knowledge governance">
        <AuthorizeView Policy="@Ams.Web.Security.KnowledgePolicies.Import"><NavLink href="/admin/knowledge/imports"><i class="bi bi-cloud-arrow-up"></i> Knowledge imports</NavLink></AuthorizeView>
        <AuthorizeView Policy="@Ams.Web.Security.KnowledgePolicies.ConceptsRead"><NavLink href="/admin/knowledge"><i class="bi bi-diagram-3"></i> Knowledge</NavLink></AuthorizeView>
        </nav>
        <div class="intel-rail-footer"><i class="bi bi-shield-check"></i><span><strong>Governed AI</strong><small>Tenant and permission aware</small></span></div>
    </aside>
    <main class="intel-content">@ChildContent</main>
</div>
@code{[Parameter]public RenderFragment? ChildContent{get;set;}}
