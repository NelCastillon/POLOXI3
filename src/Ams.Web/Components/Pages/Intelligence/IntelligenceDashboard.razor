@page "/intelligence"
@attribute [Authorize(Policy=Ams.Web.Security.IntelligencePolicies.Read)]
@using Ams.Application.Features.Intelligence
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
<IntelligenceWorkspace><div class="intel-page"><header class="intel-header"><div><span>Operational intelligence</span><h1>Intelligence Dashboard</h1><p>Live AI activity, quality, cost, review demand, recommendations, knowledge changes, and worker health.</p></div><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">Refresh</button></header>@if(_loading){<div class="intel-state">Loading intelligence metrics...</div>}else if(_error is not null){<div class="intel-error">@_error</div>}else if(_dashboard is null){<div class="intel-state">No dashboard snapshot is available.</div>}else{<section class="intel-kpis"><article><span>Executions today</span><strong>@_dashboard.ExecutionsToday</strong><small>@_dashboard.FailedExecutionsToday failed</small></article><article><span>Estimated cost</span><strong>@_dashboard.EstimatedCostToday.ToString("C2")</strong><small>Today</small></article><article><span>Average confidence</span><strong>@(_dashboard.AverageConfidenceToday?.ToString("P0")??"—")</strong><small>@(_dashboard.AverageDurationMillisecondsToday?.ToString("N0")??"—") ms average</small></article><article><span>Review queue</span><strong>@_dashboard.OpenReviewCount</strong><small>Human decisions pending</small></article><article><span>Recommendations</span><strong>@_dashboard.OpenRecommendationCount</strong><small>Open next-best actions</small></article><article><span>Searches today</span><strong>@_dashboard.SearchCountToday</strong><small>Permission-aware queries</small></article><article><span>Knowledge changes</span><strong>@_dashboard.KnowledgeChangesToday</strong><small>@_dashboard.ImportJobsInProgress imports active</small></article><article><span>Worker queue</span><strong>@_dashboard.WorkerQueueDepth</strong><small>Recommendation work</small></article></section><section class="intel-panel"><h2>Usage by feature</h2>@if(_dashboard.UsageByFeature.Count==0){<div class="intel-state">No AI executions have been recorded today.</div>}@foreach(var feature in _dashboard.UsageByFeature){<div class="intel-row"><div><strong>@feature.FeatureCode</strong><small>@feature.ExecutionCount executions · @feature.FailedCount failed</small></div><div><span>@feature.EstimatedCost.ToString("C4")</span><small>@(feature.AverageConfidence?.ToString("P0")??"—") confidence · @(feature.AverageDurationMilliseconds?.ToString("N0")??"—") ms</small></div></div>}</section><section class="intel-panel"><h2>Recommendations by type</h2>@foreach(var type in _dashboard.RecommendationsByType){<div class="intel-row"><div><strong>@type.DisplayName</strong><small>@type.TypeCode</small></div><span>@type.OpenCount open · @type.AcceptedCount accepted · @type.DismissedCount dismissed</span></div>}</section><small>Generated @_dashboard.GeneratedDateUtc.ToLocalTime().ToString("g")</small>}</div></IntelligenceWorkspace>
@code{private IntelligenceDashboardDto? _dashboard;private bool _loading=true;private string? _error;protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Intelligence","/intelligence"));await LoadAsync();}private async Task LoadAsync(){_loading=true;_error=null;try{_dashboard=await Api.GetIntelligenceDashboardAsync();}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}
}
