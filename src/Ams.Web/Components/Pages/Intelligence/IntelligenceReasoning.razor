@page "/intelligence/reasoning"
@attribute [Authorize(Policy=Ams.Web.Security.IntelligencePolicies.Reason)]
@using Ams.Application.Features.Intelligence
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
<IntelligenceWorkspace><div class="intel-page"><header class="intel-header"><div><span>Insurance reasoning engine</span><h1>Explainable Operational Guidance</h1><p>Ask why an authorized transaction is blocked or what should happen next. Conclusions combine governed rules, findings, documents, Knowledge concepts, history, and permissions.</p></div></header><section class="intel-panel"><h2>Start a reasoning session</h2><div class="intel-grid"><div class="intel-field"><label>Record type</label><select @bind="_entityType"><option>SUBMISSION</option><option>ACCOUNT</option><option>POLICY</option><option>CLAIM</option></select></div><div class="intel-field"><label>Record ID</label><input @bind="_entityIdText" placeholder="Existing authorized entity ID"/></div><div class="intel-field intel-field-wide"><label>Question</label><textarea rows="4" @bind="_question" placeholder="For example: Why can't I bind this policy, and what should I do next?"></textarea></div></div><button class="um-btn um-btn-primary" @onclick="ReasonAsync" disabled="@_loading"><i class="bi bi-stars"></i> Analyze evidence</button></section>@if(_loading){<div class="intel-state">Assembling permission-scoped evidence and evaluating governed findings...</div>}else if(_error is not null){<div class="intel-error">@_error</div>}else if(_response is not null){<section class="intel-kpis"><article><span>Intent</span><strong>@_response.IntentCode</strong></article><article><span>Confidence</span><strong>@(_response.Confidence?.ToString("P0")??"—")</strong></article><article><span>Evidence</span><strong>@_response.Evidence.Count</strong></article><article><span>Conclusions</span><strong>@_response.Conclusions.Count</strong></article><article><span>Human review</span><strong>@(_response.RequiresHumanReview?"Required":"Not required")</strong></article></section><section class="intel-panel"><h2>Conclusions</h2>@foreach(var conclusion in _response.Conclusions.OrderBy(x=>x.SequenceNumber)){<div class="intel-row"><div><strong>@conclusion.Title</strong><small>@conclusion.ConclusionCode · rule @(conclusion.RuleCode??"not applicable") version @(conclusion.RuleVersion??"—")</small><span>@conclusion.Explanation</span></div><div><AppStatusBadge Status="@(conclusion.IsBlocking?"BLOCKING":"ADVISORY")"/><span>@conclusion.Confidence.ToString("P0")</span></div></div>}</section><section class="intel-panel"><h2>Supporting evidence</h2>@foreach(var evidence in _response.Evidence.OrderByDescending(x=>x.RelevanceScore)){<div class="intel-row"><div><strong>@evidence.Title</strong><small>@evidence.EvidenceTypeCode · @evidence.SourceModuleCode · @(evidence.IsAuthoritative?"authoritative":"advisory")</small><span>@evidence.Summary</span><span>@evidence.SourceReference</span></div><span>@evidence.RelevanceScore.ToString("P0") relevance</span></div>}</section><section class="intel-panel"><h2>Next actions</h2>@foreach(var action in _response.Actions.OrderBy(x=>x.SequenceNumber)){<div class="intel-row"><div><strong>@action.DisplayName</strong><small>@action.ActionCode · permission @(action.RequiredPermissionCode??"none")</small><span>@action.Description</span>@if(!action.IsAvailable){<span>@action.UnavailableReason</span>}</div><AppStatusBadge Status="@(action.IsAvailable?"AVAILABLE":"UNAVAILABLE")"/></div>}</section><small>Session @_response.ReasoningSessionId · correlation @_response.CorrelationId. Guidance is advisory and does not autonomously bind, deny, or adjudicate.</small>}</div></IntelligenceWorkspace>
@code{private InsuranceReasoningResponse? _response;private bool _loading;private string? _error;private string _entityType="SUBMISSION",_entityIdText="",_question="";protected override Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Intelligence","/intelligence"),new("Reasoning","/intelligence/reasoning"));return Task.CompletedTask;}private async Task ReasonAsync(){if(!Guid.TryParse(_entityIdText,out var id)){_error="Enter a valid existing entity ID.";return;}if(string.IsNullOrWhiteSpace(_question)){_error="Enter a question for the reasoning engine.";return;}_loading=true;_error=null;try{_response=await Api.ExecuteInsuranceReasoningAsync(new(Guid.Empty,Guid.Empty,_entityType,id,_question,Guid.NewGuid().ToString("N"),[]));}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}}
