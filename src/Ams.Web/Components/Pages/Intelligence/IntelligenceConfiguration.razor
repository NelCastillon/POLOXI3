private void NewPrompt(){_error=null;_promptForm=new();_editingPrompt=true;}
private void EditPrompt(IntelligencePromptDefinitionDto item){_error=null;_promptForm=PromptForm.From(item);_editingPrompt=true;}
private void NewPromptVersion(IntelligencePromptDefinitionDto item){_error=null;_promptForm=PromptForm.From(item);_promptForm.VersionLabel="";_promptForm.StatusCode="DRAFT";_promptForm.RowVersion=null;_editingPrompt=true;}
private async Task SavePromptAsync()
{
    if(_promptForm.RowVersion is not null&&!await ConfirmUpdateAsync($"prompt '{_promptForm.PromptCode}' version '{_promptForm.VersionLabel}'"))return;
    _saving=true;_error=null;
    try
    {
        var request=new SaveIntelligencePromptDefinitionRequest(Guid.Empty,_promptForm.IntelligenceCapabilityId??Guid.Empty,_promptForm.PromptCode,_promptForm.VersionLabel,_promptForm.DisplayName,_promptForm.SystemInstructions,_promptForm.InputSchemaJson,_promptForm.OutputSchemaJson,_promptForm.StatusCode,_promptForm.EffectiveFromUtc,_promptForm.EffectiveToUtc,Guid.Empty,_promptForm.RowVersion);
        await Api.SaveIntelligencePromptDefinitionAsync(_promptForm.PromptCode,_promptForm.VersionLabel,request);
        _editingPrompt=false;await LoadAsync();
    }
    catch(Exception ex){_error=$"Save failed: {ex.Message}";}
    finally{_saving=false;}
}

