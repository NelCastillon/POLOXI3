@page "/intelligence/configuration"
@attribute [Authorize(Policy=Ams.Web.Security.IntelligencePolicies.Configure)]
@using Ams.Application.Features.Intelligence
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<IntelligenceWorkspace><div class="intel-page">
<header class="intel-header"><div><span>Control plane</span><h1>AI Configuration Center</h1><p>Effective provider capabilities, model deployments, routing, limits, and human-review controls from the database.</p></div><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button></header>
@if(_loading){<div class="intel-state">Loading AI configuration...</div>}else if(_error is not null){<div class="intel-error">@_error</div>}else{
<section class="intel-kpis"><article><span>Providers</span><strong>@_providers.Count(x=>x.IsActive)</strong></article><article><span>Models</span><strong>@_models.Count(x=>x.IsActive)</strong></article><article><span>Feature policies</span><strong>@_policies.Count</strong></article><article><span>Prompt versions</span><strong>@_prompts.Count</strong></article></section>
<section class="intel-panel"><h2>Provider registry</h2>@if(_providers.Count==0){<div class="intel-state">No provider records are configured.</div>}@foreach(var provider in _providers){<div class="intel-row"><div><strong>@provider.DisplayName</strong><small>@provider.ProviderCode · @provider.ProviderTypeCode</small></div><div><span>@(provider.SupportsChat?"Chat ":"")@(provider.SupportsEmbeddings?"Embeddings ":"")@(provider.SupportsVision?"Vision":"")</span><AppStatusBadge Status="@(provider.IsActive?"ACTIVE":"INACTIVE")" /></div></div>}</section>
<section class="intel-panel"><h2>Model deployments</h2>@if(_models.Count==0){<div class="intel-state">No model deployments exist. Add deployment records before enabling feature policies.</div>}@foreach(var model in _models){<div class="intel-row"><div><strong>@model.DeploymentName</strong><small>@model.ProviderCode · @model.ModelFamily · @model.CapabilityCode</small></div><div><span>@model.ContextWindowTokens.ToString("N0") context · @model.MaximumOutputTokens.ToString("N0") output</span><AppStatusBadge Status="@(model.IsActive?"ACTIVE":"INACTIVE")" /></div></div>}</section>
<section class="intel-panel"><h2>Feature policies</h2><button class="um-btn um-btn-primary um-btn-sm" @onclick="NewPolicy">Add feature policy</button>@if(_policies.Count==0){<div class="intel-state">No tenant feature policies are configured. AI features remain unavailable until explicitly enabled.</div>}@foreach(var policy in _policies){<div class="intel-row"><div><strong>@policy.FeatureCode</strong><small>@policy.ModuleCode · temperature @policy.Temperature · timeout @policy.TimeoutSeconds seconds</small><span>@policy.MaximumInputTokens.ToString("N0") input / @policy.MaximumOutputTokens.ToString("N0") output tokens · minimum confidence @policy.MinimumConfidence.ToString("P0")</span></div><div><AppStatusBadge Status="@(policy.IsEnabled?"ENABLED":"DISABLED")" /><button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>Edit(policy)">Edit</button></div></div>}</section>
<section class="intel-panel"><div class="intel-toolbar"><h2>Prompt registry</h2><button class="um-btn um-btn-primary um-btn-sm" @onclick="NewPrompt">Add prompt version</button></div>@if(_prompts.Count==0){<div class="intel-state">No prompt definitions are configured.</div>}@foreach(var prompt in _prompts){<div class="intel-row"><div><strong>@prompt.DisplayName</strong><small>@prompt.PromptCode · @prompt.VersionLabel · @prompt.CapabilityCode</small><span>@(prompt.TenantId.HasValue?"Tenant":"Platform") prompt definition</span></div><div><AppStatusBadge Status="@prompt.StatusCode" />@if(prompt.TenantId.HasValue&&prompt.StatusCode=="DRAFT"){<button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>EditPrompt(prompt)">Edit</button>}<button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>NewPromptVersion(prompt)">New version</button></div></div>}</section>
@if(_editing){<section class="intel-panel"><h2>@(_form.RowVersion is null?"Add feature policy":"Edit feature policy")</h2><div class="intel-grid"><div class="intel-field"><label>Feature code</label><input @bind="_form.FeatureCode" disabled="@(_form.RowVersion is not null)" /></div><div class="intel-field"><label>Module</label><input @bind="_form.ModuleCode" /></div><div class="intel-field"><label>Primary model</label><select @bind="_form.PrimaryModelDeploymentId"><option value="">Not selected</option>@foreach(var model in _models.Where(x=>x.IsActive)){<option value="@model.ModelDeploymentId">@model.DeploymentName</option>}</select></div><div class="intel-field"><label>Fallback model</label><select @bind="_form.FallbackModelDeploymentId"><option value="">Not selected</option>@foreach(var model in _models.Where(x=>x.IsActive)){<option value="@model.ModelDeploymentId">@model.DeploymentName</option>}</select></div><div class="intel-field"><label>Temperature</label><input type="number" step="0.05" min="0" max="2" @bind="_form.Temperature" /></div><div class="intel-field"><label>Timeout seconds</label><input type="number" @bind="_form.TimeoutSeconds" /></div><div class="intel-field"><label>Maximum input tokens</label><input type="number" @bind="_form.MaximumInputTokens" /></div><div class="intel-field"><label>Maximum output tokens</label><input type="number" @bind="_form.MaximumOutputTokens" /></div><div class="intel-field"><label>Daily cost limit</label><input type="number" step="0.01" @bind="_form.DailyCostLimit" /></div><div class="intel-field"><label>Monthly cost limit</label><input type="number" step="0.01" @bind="_form.MonthlyCostLimit" /></div><div class="intel-field"><label>Minimum confidence</label><input type="number" min="0" max="1" step="0.01" @bind="_form.MinimumConfidence" /></div><div class="intel-field"><label><input type="checkbox" @bind="_form.RequiresHumanReview" /> Human review required</label><label><input type="checkbox" @bind="_form.IsEnabled" /> Enabled</label></div></div><div class="intel-toolbar"><button class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">Save policy</button><button class="um-btn um-btn-ghost" @onclick="()=>_editing=false">Cancel</button></div></section>}
@if(_editingPrompt){<div class="um-modal-backdrop"><div class="um-modal"><div class="um-modal-header"><i class="bi bi-braces-asterisk"></i><span>@(_promptForm.RowVersion is null?"Add prompt version":"Edit prompt draft")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="()=>_editingPrompt=false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_promptForm" OnValidSubmit="SavePromptAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="intel-field"><label>Capability</label><InputSelect @bind-Value="_promptForm.IntelligenceCapabilityId"><option value="">Select capability</option>@foreach(var capability in _capabilities){<option value="@capability.IntelligenceCapabilityId">@capability.DisplayName</option>}</InputSelect></div><div class="intel-field"><label>Prompt code</label><InputText @bind-Value="_promptForm.PromptCode" disabled="@(_promptForm.RowVersion is not null)" /></div><div class="intel-field"><label>Version</label><InputText @bind-Value="_promptForm.VersionLabel" disabled="@(_promptForm.RowVersion is not null)" /></div><div class="intel-field"><label>Display name</label><InputText @bind-Value="_promptForm.DisplayName" /></div><div class="intel-field"><label>Status</label><InputSelect @bind-Value="_promptForm.StatusCode"><option value="DRAFT">Draft</option><option value="APPROVED">Approved</option><option value="RETIRED">Retired</option></InputSelect></div><div class="intel-field"><label>Effective from (UTC)</label><InputDate @bind-Value="_promptForm.EffectiveFromUtc" /></div><div class="intel-field"><label>Effective to (UTC)</label><InputDate @bind-Value="_promptForm.EffectiveToUtc" /></div><div class="intel-field" style="grid-column:1/-1"><label>System instructions</label><InputTextArea @bind-Value="_promptForm.SystemInstructions" /></div><div class="intel-field" style="grid-column:1/-1"><label>Input schema JSON</label><InputTextArea @bind-Value="_promptForm.InputSchemaJson" /></div><div class="intel-field" style="grid-column:1/-1"><label>Output schema JSON</label><InputTextArea @bind-Value="_promptForm.OutputSchemaJson" /></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="()=>_editingPrompt=false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Save prompt</button></div></EditForm></div></div>}
}</div></IntelligenceWorkspace>
@code{
private readonly List<AiProviderDto> _providers=[];private readonly List<AiModelDeploymentDto> _models=[];private readonly List<AiFeaturePolicyDto> _policies=[];private readonly List<IntelligencePromptDefinitionDto> _prompts=[];private readonly List<IntelligenceCapabilityDto> _capabilities=[];private bool _loading=true,_editing,_editingPrompt,_saving;private string? _error;private PolicyForm _form=new();private PromptForm _promptForm=new();
protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Intelligence","/intelligence"),new("Configuration","/intelligence/configuration"));await LoadAsync();}
private async Task LoadAsync(){_loading=true;_error=null;try{var providers=Api.GetIntelligenceProvidersAsync();var models=Api.GetIntelligenceModelsAsync();var policies=Api.GetIntelligenceFeaturePoliciesAsync();var prompts=Api.GetIntelligencePromptDefinitionsAsync();var platform=Api.GetIntelligencePlatformAsync();await Task.WhenAll(providers,models,policies,prompts,platform);_providers.Clear();_providers.AddRange(await providers);_models.Clear();_models.AddRange(await models);_policies.Clear();_policies.AddRange(await policies);_prompts.Clear();_prompts.AddRange(await prompts);_capabilities.Clear();_capabilities.AddRange((await platform)?.Pillars.SelectMany(x=>x.Capabilities)??[]);}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}
private void NewPolicy(){_form=new();_editing=true;}private void Edit(AiFeaturePolicyDto item){_form=new(){FeatureCode=item.FeatureCode,ModuleCode=item.ModuleCode,PrimaryModelDeploymentId=item.PrimaryModelDeploymentId,FallbackModelDeploymentId=item.FallbackModelDeploymentId,Temperature=item.Temperature,MaximumInputTokens=item.MaximumInputTokens,MaximumOutputTokens=item.MaximumOutputTokens,TimeoutSeconds=item.TimeoutSeconds,DailyCostLimit=item.DailyCostLimit,MonthlyCostLimit=item.MonthlyCostLimit,MinimumConfidence=item.MinimumConfidence,RequiresHumanReview=item.RequiresHumanReview,IsEnabled=item.IsEnabled,RowVersion=item.RowVersion};_editing=true;}
private async Task SaveAsync(){_saving=true;_error=null;try{var request=new SaveAiFeaturePolicyRequest(Guid.Empty,_form.FeatureCode,_form.ModuleCode,_form.PrimaryModelDeploymentId,_form.FallbackModelDeploymentId,_form.Temperature,_form.MaximumInputTokens,_form.MaximumOutputTokens,_form.TimeoutSeconds,_form.DailyCostLimit,_form.MonthlyCostLimit,_form.MinimumConfidence,_form.RequiresHumanReview,_form.IsEnabled,Guid.Empty,_form.RowVersion);await Api.SaveIntelligenceFeaturePolicyAsync(_form.FeatureCode,request);_editing=false;await LoadAsync();}catch(Exception ex){_error=ex.Message;}finally{_saving=false;}}
private void NewPrompt(){_promptForm=new();_editingPrompt=true;}private void EditPrompt(IntelligencePromptDefinitionDto item){_promptForm=PromptForm.From(item);_editingPrompt=true;}private void NewPromptVersion(IntelligencePromptDefinitionDto item){_promptForm=PromptForm.From(item);_promptForm.VersionLabel="";_promptForm.StatusCode="DRAFT";_promptForm.RowVersion=null;_editingPrompt=true;}
private async Task SavePromptAsync(){_saving=true;_error=null;try{var request=new SaveIntelligencePromptDefinitionRequest(Guid.Empty,_promptForm.IntelligenceCapabilityId,_promptForm.PromptCode,_promptForm.VersionLabel,_promptForm.DisplayName,_promptForm.SystemInstructions,_promptForm.InputSchemaJson,_promptForm.OutputSchemaJson,_promptForm.StatusCode,_promptForm.EffectiveFromUtc,_promptForm.EffectiveToUtc,Guid.Empty,_promptForm.RowVersion);await Api.SaveIntelligencePromptDefinitionAsync(_promptForm.PromptCode,_promptForm.VersionLabel,request);_editingPrompt=false;await LoadAsync();}catch(Exception ex){_error=$"Save failed: {ex.Message}";}finally{_saving=false;}}
private sealed class PolicyForm{public string FeatureCode{get;set;}="";public string ModuleCode{get;set;}="";public Guid? PrimaryModelDeploymentId{get;set;}public Guid? FallbackModelDeploymentId{get;set;}public decimal Temperature{get;set;}public int MaximumInputTokens{get;set;}=32000;public int MaximumOutputTokens{get;set;}=4000;public int TimeoutSeconds{get;set;}=60;public decimal? DailyCostLimit{get;set;}public decimal? MonthlyCostLimit{get;set;}public decimal MinimumConfidence{get;set;}=.75m;public bool RequiresHumanReview{get;set;}=true;public bool IsEnabled{get;set;}public byte[]? RowVersion{get;set;}}
private sealed class PromptForm{[Required]public Guid IntelligenceCapabilityId{get;set;}[Required,StringLength(120)]public string PromptCode{get;set;}="";[Required,StringLength(30)]public string VersionLabel{get;set;}="";[Required,StringLength(200)]public string DisplayName{get;set;}="";[Required]public string SystemInstructions{get;set;}="";[Required]public string InputSchemaJson{get;set;}="{}";[Required]public string OutputSchemaJson{get;set;}="{}";[Required,StringLength(30)]public string StatusCode{get;set;}="DRAFT";public DateTime? EffectiveFromUtc{get;set;}public DateTime? EffectiveToUtc{get;set;}public byte[]? RowVersion{get;set;}public static PromptForm From(IntelligencePromptDefinitionDto item)=>new(){IntelligenceCapabilityId=item.IntelligenceCapabilityId,PromptCode=item.PromptCode,VersionLabel=item.VersionLabel,DisplayName=item.DisplayName,SystemInstructions=item.SystemInstructions,InputSchemaJson=item.InputSchemaJson,OutputSchemaJson=item.OutputSchemaJson,StatusCode=item.StatusCode,EffectiveFromUtc=item.EffectiveFromUtc,EffectiveToUtc=item.EffectiveToUtc,RowVersion=item.RowVersion};}
}
