@page "/intelligence/evaluations"
@attribute [Authorize(Policy=Ams.Web.Security.IntelligencePolicies.Evaluate)]
@using Ams.Application.Features.Intelligence
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
<IntelligenceWorkspace><div class="intel-page"><header class="intel-header"><div><span>Continuous quality</span><h1>AI Evaluation Platform</h1><p>Measure success, confidence, latency, and correction rates from real execution evidence.</p></div><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">Refresh</button></header>@if(_loading){<div class="intel-state">Loading evaluations...</div>}else if(_error is not null){<div class="intel-error">@_error</div>}else{<section class="intel-kpis"><article><span>Definitions</span><strong>@_definitions.Count</strong></article><article><span>Runs</span><strong>@_runs.Count</strong></article><article><span>Passed</span><strong>@_runs.Count(x=>x.Passed==true)</strong></article><article><span>Insufficient data</span><strong>@_runs.Count(x=>x.StatusCode=="INSUFFICIENT_DATA")</strong></article></section><section class="intel-panel"><h2>Evaluation definitions</h2>@if(_definitions.Count==0){<div class="intel-state">No evaluation definitions are configured.</div>}@foreach(var definition in _definitions){<div class="intel-row"><div><strong>@definition.DisplayName</strong><small>@definition.MetricCode · @definition.WindowHours hour window · minimum @definition.MinimumSampleSize samples</small><span>Target @definition.TargetValue · warning @definition.WarningValue</span></div><button class="um-btn um-btn-primary um-btn-sm" @onclick="()=>QueueAsync(definition)" disabled="@_busy">Run now</button></div>}</section><section class="intel-panel"><h2>Evaluation history</h2>@if(_runs.Count==0){<div class="intel-state">No evaluation runs exist. Queue a definition after real executions have been recorded.</div>}@foreach(var run in _runs){<div class="intel-row"><div><strong>@run.DisplayName</strong><small>@run.WindowStartUtc.ToLocalTime().ToString("g") — @run.WindowEndUtc.ToLocalTime().ToString("g")</small><span>@run.SampleCount samples · value @(run.MetricValue?.ToString("0.####")??"—")</span></div><AppStatusBadge Status="@run.StatusCode" /></div>}</section>}</div></IntelligenceWorkspace>
@code{private readonly List<AiEvaluationDefinitionDto> _definitions=[];private readonly List<AiEvaluationRunDto> _runs=[];private bool _loading=true,_busy;private string? _error;protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Intelligence","/intelligence"),new("Evaluations","/intelligence/evaluations"));await LoadAsync();}private async Task LoadAsync(){_loading=true;_error=null;try{var definitions=Api.GetIntelligenceEvaluationDefinitionsAsync();var runs=Api.GetIntelligenceEvaluationRunsAsync();await Task.WhenAll(definitions,runs);_definitions.Clear();_definitions.AddRange(await definitions);_runs.Clear();_runs.AddRange(await runs);}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}private async Task QueueAsync(AiEvaluationDefinitionDto definition){_busy=true;try{var end=DateTime.UtcNow;await Api.QueueIntelligenceEvaluationAsync(new(Guid.Empty,definition.EvaluationDefinitionId,end.AddHours(-definition.WindowHours),end,Guid.Empty));await LoadAsync();}catch(Exception ex){_error=ex.Message;}finally{_busy=false;}}
}
