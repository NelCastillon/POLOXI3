@page "/intelligence/business"
@attribute [Authorize(Policy=Ams.Web.Security.IntelligencePolicies.FindingsRead)]
@using Ams.Application.Common.Models
@using Ams.Application.Features.Intelligence
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
<IntelligenceWorkspace><div class="intel-page"><header class="intel-header"><div><span>Business intelligence</span><h1>Operational Intelligence Signals</h1><p>Advisory workflow, renewal, claims, producer, and customer signals derived from authoritative AgencyBinder activity.</p></div><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">Refresh</button></header><div class="intel-toolbar"><input placeholder="Search signals" @bind="_search" @bind:event="oninput"/><select @bind="_capability"><option value="">All business engines</option><option value="WORKFLOW_INTELLIGENCE">Workflow</option><option value="RENEWAL_INTELLIGENCE">Renewal</option><option value="CLAIMS_INTELLIGENCE">Claims</option><option value="PRODUCER_INTELLIGENCE">Producer</option><option value="CUSTOMER_INTELLIGENCE">Customer</option></select><select @bind="_status"><option value="">All statuses</option><option>OPEN</option><option>IN_PROGRESS</option><option>COMPLETED</option><option>DISMISSED</option></select><button class="um-btn um-btn-primary" @onclick="LoadAsync">Search</button></div>@if(_loading){<div class="intel-state">Loading business signals...</div>}else if(_error is not null){<div class="intel-error">@_error</div>}else{<section class="intel-kpis"><article><span>Total signals</span><strong>@_result.TotalCount</strong></article><article><span>Workflow</span><strong>@_result.Items.Count(x=>x.CapabilityCode=="WORKFLOW_INTELLIGENCE")</strong></article><article><span>Renewals</span><strong>@_result.Items.Count(x=>x.CapabilityCode=="RENEWAL_INTELLIGENCE")</strong></article><article><span>Claims</span><strong>@_result.Items.Count(x=>x.CapabilityCode=="CLAIMS_INTELLIGENCE")</strong></article><article><span>Customer & producer</span><strong>@_result.Items.Count(x=>x.CapabilityCode is "CUSTOMER_INTELLIGENCE" or "PRODUCER_INTELLIGENCE")</strong></article></section><section class="intel-panel">@if(_result.Items.Count==0){<div class="intel-state">No database-backed signals match the current filters.</div>}@foreach(var item in _result.Items){<div class="intel-row"><div><strong>@item.Title</strong><small>@item.CapabilityName · @item.SignalTypeCode · @item.EntityTypeCode</small><span>@item.Summary</span><span>Confidence @(item.Confidence?.ToString("P0")??"—") · due @(item.DueDateUtc?.ToLocalTime().ToString("g")??"not set")</span></div><div><AppStatusBadge Status="@item.SeverityCode"/><AppStatusBadge Status="@item.StatusCode"/><AuthorizeView Policy="@Ams.Web.Security.IntelligencePolicies.FindingsReview">@if(item.StatusCode is "OPEN" or "IN_PROGRESS" or "REVIEW_REQUIRED"){<button class="um-btn um-btn-primary um-btn-sm" @onclick="()=>Select(item)">Act</button>}</AuthorizeView></div></div>}</section>}@if(_selected is not null){<section class="intel-panel"><h2>Signal decision</h2><strong>@_selected.Title</strong><div class="intel-grid"><div class="intel-field"><label>Decision</label><select @bind="_decision"><option>IN_PROGRESS</option><option>COMPLETED</option><option>DISMISSED</option></select></div><div class="intel-field intel-field-wide"><label>Audited notes</label><textarea @bind="_notes"></textarea></div></div><button class="um-btn um-btn-primary" @onclick="DecideAsync" disabled="@_busy">Save decision</button><button class="um-btn um-btn-ghost" @onclick="()=>_selected=null">Cancel</button></section>}</div></IntelligenceWorkspace>
@code{private PagedResult<BusinessIntelligenceSignalDto> _result=new();private BusinessIntelligenceSignalDto? _selected;private bool _loading=true,_busy;private string? _error;private string _search="",_capability="",_status="",_decision="IN_PROGRESS",_notes="";protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Intelligence","/intelligence"),new("Business Intelligence","/intelligence/business"));await LoadAsync();}private async Task LoadAsync(){_loading=true;_error=null;try{_result=await Api.SearchBusinessIntelligenceSignalsAsync(_search,_capability,null,null,null,_status);}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}private void Select(BusinessIntelligenceSignalDto item){_selected=item;_notes="";}private async Task DecideAsync(){if(_selected is null||string.IsNullOrWhiteSpace(_notes))return;_busy=true;try{await Api.DecideBusinessIntelligenceSignalAsync(_selected.BusinessSignalId,new(Guid.Empty,_selected.BusinessSignalId,_decision,_notes,Guid.Empty,_selected.RowVersion));_selected=null;await LoadAsync();}catch(Exception ex){_error=ex.Message;}finally{_busy=false;}}}
