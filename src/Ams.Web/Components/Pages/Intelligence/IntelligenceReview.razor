@page "/intelligence/review"
@attribute [Authorize(Policy=Ams.Web.Security.IntelligencePolicies.Review)]
@using Ams.Application.Common.Models
@using Ams.Application.Features.Intelligence
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
<IntelligenceWorkspace><div class="intel-page"><header class="intel-header"><div><span>Human oversight</span><h1>AI Review Queue</h1><p>Inspect and decide AI output that crossed configured review or confidence thresholds.</p></div><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">Refresh</button></header><div class="intel-toolbar"><input placeholder="Search review queue" @bind="_search" @bind:event="oninput" /><select @bind="_status"><option value="">Open work</option><option>OPEN</option><option>ASSIGNED</option><option>IN_REVIEW</option><option>COMPLETED</option></select><select @bind="_priority"><option value="">All priorities</option><option>CRITICAL</option><option>HIGH</option><option>NORMAL</option><option>LOW</option></select><button class="um-btn um-btn-primary" @onclick="LoadAsync">Search</button></div>@if(_loading){<div class="intel-state">Loading review work...</div>}else if(_error is not null){<div class="intel-error">@_error</div>}else{<section class="intel-kpis"><article><span>Review items</span><strong>@_result.TotalCount</strong></article><article><span>High priority</span><strong>@_result.Items.Count(x=>x.PriorityCode is "HIGH" or "CRITICAL")</strong></article><article><span>Low confidence</span><strong>@_result.Items.Count(x=>x.Confidence<.75m)</strong></article></section><section class="intel-panel">@if(_result.Items.Count==0){<div class="intel-state">No AI output requires review for these filters.</div>}@foreach(var item in _result.Items){<div class="intel-row"><div><strong>@item.Title</strong><small>@item.ReviewTypeCode · @item.SourceEntityTypeCode</small><span>@item.Summary</span><span>Confidence @(item.Confidence?.ToString("P0")??"—") · due @(item.DueDateUtc?.ToLocalTime().ToString("g")??"not set")</span></div><div><AppStatusBadge Status="@item.PriorityCode" />@if(item.StatusCode!="COMPLETED"){<button class="um-btn um-btn-primary um-btn-sm" @onclick="()=>Select(item)">Review</button>}</div></div>}</section>}@if(_selected is not null){<section class="intel-panel"><h2>Decision: @_selected.Title</h2><div class="intel-grid"><div class="intel-field"><label>Decision</label><select @bind="_decision"><option>APPROVED</option><option>CORRECTED</option><option>REJECTED</option><option>ESCALATED</option></select></div><div class="intel-field intel-field-wide"><label>Reason</label><textarea rows="4" @bind="_reason"></textarea></div></div><div class="intel-toolbar"><button class="um-btn um-btn-primary" @onclick="DecideAsync" disabled="@_busy">Complete review</button><button class="um-btn um-btn-ghost" @onclick="()=>_selected=null">Cancel</button></div></section>}</div></IntelligenceWorkspace>
@code{private PagedResult<AiReviewQueueItemDto> _result=new();private AiReviewQueueItemDto? _selected;private bool _loading=true,_busy;private string? _error;private string _search="",_status="",_priority="",_decision="APPROVED",_reason="";protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Intelligence","/intelligence"),new("Review","/intelligence/review"));await LoadAsync();}private async Task LoadAsync(){_loading=true;_error=null;try{_result=await Api.SearchIntelligenceReviewQueueAsync(_search,null,_status,_priority);}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}private void Select(AiReviewQueueItemDto item){_selected=item;_reason="";}private async Task DecideAsync(){if(_selected is null||string.IsNullOrWhiteSpace(_reason))return;_busy=true;try{await Api.DecideIntelligenceReviewAsync(_selected.ReviewQueueItemId,new(Guid.Empty,_selected.ReviewQueueItemId,_decision,_reason,Guid.Empty,_selected.RowVersion));_selected=null;await LoadAsync();}catch(Exception ex){_error=ex.Message;}finally{_busy=false;}}
}
