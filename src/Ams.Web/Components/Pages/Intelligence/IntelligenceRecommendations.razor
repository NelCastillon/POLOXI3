@page "/intelligence/recommendations"
@attribute [Authorize(Policy=Ams.Web.Security.IntelligencePolicies.Read)]
@using Ams.Application.Common.Models
@using Ams.Application.Features.Intelligence
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
<IntelligenceWorkspace><div class="intel-page"><header class="intel-header"><div><span>Next-best action</span><h1>Recommendation Center</h1><p>Missing coverages, endorsements, documents, workflow actions, and historically similar authorized records.</p></div><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">Refresh</button></header><div class="intel-toolbar"><input placeholder="Search recommendations" @bind="_search" @bind:event="oninput" /><select @bind="_type"><option value="">All recommendation types</option>@foreach(var type in _types){<option value="@type.TypeCode">@type.DisplayName</option>}</select><select @bind="_status"><option value="">All statuses</option><option>OPEN</option><option>REVIEW_REQUIRED</option><option>ACCEPTED</option><option>COMPLETED</option><option>DISMISSED</option></select><button class="um-btn um-btn-primary" @onclick="LoadAsync">Search</button></div>@if(_loading){<div class="intel-state">Loading recommendations...</div>}else if(_error is not null){<div class="intel-error">@_error</div>}else{<section class="intel-kpis"><article><span>Recommendations</span><strong>@_result.TotalCount</strong></article><article><span>Review required</span><strong>@_result.Items.Count(x=>x.StatusCode=="REVIEW_REQUIRED")</strong></article><article><span>High confidence</span><strong>@_result.Items.Count(x=>x.Confidence>=.85m)</strong></article></section><section class="intel-panel">@if(_result.Items.Count==0){<div class="intel-state">No governed recommendations match the current filters.</div>}@foreach(var item in _result.Items){<div class="intel-row"><div><strong>@item.Title</strong><small>@item.TypeName · @item.EntityTypeCode</small><span>@item.Summary</span><span>Confidence @item.Confidence.ToString("P0") · score @item.Score.ToString("0.##")</span></div><div><AppStatusBadge Status="@item.StatusCode" /><AuthorizeView Policy="@Ams.Web.Security.IntelligencePolicies.Recommend">@if(item.StatusCode is "OPEN" or "REVIEW_REQUIRED" or "ACCEPTED"){<button class="um-btn um-btn-primary um-btn-sm" @onclick="()=>Select(item)">Act</button>}</AuthorizeView></div></div>}</section>}<AuthorizeView Policy="@Ams.Web.Security.IntelligencePolicies.Recommend"><section class="intel-panel"><h2>Generate for an existing record</h2><p>Generation evaluates active tenant-governed database rules. If no applicable rules exist, no recommendation is created.</p><div class="intel-toolbar"><select @bind="_entityType"><option>SUBMISSION</option><option>ACCOUNT</option><option>CLAIM</option><option>POLICY</option></select><input placeholder="Entity ID" @bind="_entityIdText" /><button class="um-btn um-btn-primary" @onclick="GenerateAsync" disabled="@_busy">Queue generation</button></div></section>@if(_selected is not null){<section class="intel-panel"><h2>Recommendation decision</h2><strong>@_selected.Title</strong><div class="intel-grid"><div class="intel-field"><label>Decision</label><select @bind="_decision"><option value="ACCEPT">Accept</option><option value="COMPLETE">Complete</option><option value="DISMISS">Dismiss</option></select></div><div class="intel-field intel-field-wide"><label>Reason</label><textarea @bind="_reason"></textarea></div></div><div class="intel-toolbar"><button class="um-btn um-btn-primary" @onclick="DecideAsync" disabled="@_busy">Save decision</button><button class="um-btn um-btn-ghost" @onclick="()=>_selected=null">Cancel</button></div></section>}</AuthorizeView></div></IntelligenceWorkspace>
@code{private readonly List<RecommendationTypeDto> _types=[];private PagedResult<RecommendationDto> _result=new();private RecommendationDto? _selected;private bool _loading=true,_busy;private string? _error;private string _search="",_type="",_status="",_entityType="SUBMISSION",_entityIdText="",_decision="ACCEPT",_reason="";protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Intelligence","/intelligence"),new("Recommendations","/intelligence/recommendations"));var types=await Api.GetRecommendationTypesAsync();_types.AddRange(types);await LoadAsync();}private async Task LoadAsync(){_loading=true;_error=null;try{_result=await Api.SearchRecommendationsAsync(_search,_type,_status);}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}private void Select(RecommendationDto item){_selected=item;_reason="";}private async Task GenerateAsync(){if(!Guid.TryParse(_entityIdText,out var id)){_error="Enter a valid existing entity ID.";return;}_busy=true;try{await Api.QueueRecommendationsAsync(new(Guid.Empty,_entityType,id,Guid.NewGuid().ToString("N"),Guid.Empty));_error=null;}catch(Exception ex){_error=ex.Message;}finally{_busy=false;}}private async Task DecideAsync(){if(_selected is null||string.IsNullOrWhiteSpace(_reason))return;_busy=true;try{await Api.DecideRecommendationAsync(_selected.RecommendationId,new(Guid.Empty,_selected.RecommendationId,_decision,_reason,Guid.Empty,_selected.RowVersion));_selected=null;await LoadAsync();}catch(Exception ex){_error=ex.Message;}finally{_busy=false;}}
}
