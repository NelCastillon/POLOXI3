@page "/intelligence/findings"
@attribute [Authorize(Policy=Ams.Web.Security.IntelligencePolicies.FindingsRead)]
@using Ams.Application.Common.Models
@using Ams.Application.Features.Intelligence
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
<IntelligenceWorkspace><div class="intel-page"><header class="intel-header"><div><span>Decision intelligence</span><h1>Risk, Compliance & Explainability Findings</h1><p>Review tenant-scoped findings produced by configured engines, including rule versions, confidence, explanations, and authoritative evidence.</p></div><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">Refresh</button></header><div class="intel-toolbar"><input placeholder="Search findings" @bind="_search" @bind:event="oninput"/><select @bind="_capability"><option value="">All engines</option><option value="RISK_INTELLIGENCE">Risk intelligence</option><option value="COMPLIANCE_INTELLIGENCE">Compliance intelligence</option><option value="EXPLAINABILITY">Explainability</option></select><select @bind="_severity"><option value="">All severities</option><option>CRITICAL</option><option>HIGH</option><option>MEDIUM</option><option>LOW</option></select><select @bind="_status"><option value="">All statuses</option><option>OPEN</option><option>REVIEW_REQUIRED</option><option>IN_REVIEW</option><option>RESOLVED</option></select><button class="um-btn um-btn-primary" @onclick="LoadAsync">Search</button></div>@if(_loading){<div class="intel-state">Loading governed findings...</div>}else if(_error is not null){<div class="intel-error">@_error</div>}else{<section class="intel-kpis"><article><span>Total findings</span><strong>@_result.TotalCount</strong></article><article><span>High severity</span><strong>@_result.Items.Count(x=>x.SeverityCode is "HIGH" or "CRITICAL")</strong></article><article><span>Review required</span><strong>@_result.Items.Count(x=>x.StatusCode=="REVIEW_REQUIRED")</strong></article><article><span>Low confidence</span><strong>@_result.Items.Count(x=>x.Confidence<.7m)</strong></article></section><section class="intel-panel">@if(_result.Items.Count==0){<div class="intel-state">No database-backed findings match the current filters.</div>}@foreach(var item in _result.Items){<div class="intel-row"><div><strong>@item.Title</strong><small>@item.CapabilityName · @item.EntityTypeCode · rule @(item.RuleVersion??"not recorded")</small><span>@item.Summary</span><span>Detected @item.DetectedDateUtc.ToLocalTime().ToString("g") · confidence @(item.Confidence?.ToString("P0")??"—")</span></div><div><AppStatusBadge Status="@item.SeverityCode"/><AppStatusBadge Status="@item.StatusCode"/><button class="um-btn um-btn-ghost um-btn-sm" @onclick="()=>OpenAsync(item)">Evidence</button></div></div>}</section>}@if(_detail is not null){<section class="intel-panel"><h2>@_detail.Finding.Title</h2><p>@_detail.Finding.Explanation</p><h3>Authoritative evidence</h3>@if(_detail.Evidence.Count==0){<div class="intel-state">No evidence records are attached.</div>}@foreach(var evidence in _detail.Evidence){<div class="intel-row"><div><strong>@evidence.Description</strong><small>@evidence.EvidenceTypeCode · @evidence.SourceModuleCode</small><span>@evidence.SourceReference</span></div><span>@(evidence.RelevanceScore?.ToString("P0")??"—") relevance</span></div>}<AuthorizeView Policy="@Ams.Web.Security.IntelligencePolicies.FindingsReview">@if(_detail.Finding.StatusCode!="RESOLVED"){<div class="intel-grid"><div class="intel-field"><label>Resolution</label><select @bind="_resolution"><option>RESOLVED</option><option>WAIVED</option><option>FALSE_POSITIVE</option><option>DISMISSED</option></select></div><div class="intel-field intel-field-wide"><label>Audited notes</label><textarea @bind="_notes"></textarea></div></div><button class="um-btn um-btn-primary" @onclick="DecideAsync" disabled="@_busy">Save decision</button>}</AuthorizeView><button class="um-btn um-btn-ghost" @onclick="()=>_detail=null">Close</button></section>}</div></IntelligenceWorkspace>
@code{private PagedResult<IntelligenceFindingDto> _result=new();private IntelligenceFindingDetailDto? _detail;private bool _loading=true,_busy;private string? _error;private string _search="",_capability="",_severity="",_status="",_resolution="RESOLVED",_notes="";protected override async Task OnInitializedAsync(){Breadcrumbs.SetCrumbs(new("Home","/"),new("Intelligence","/intelligence"),new("Findings","/intelligence/findings"));await LoadAsync();}private async Task LoadAsync(){_loading=true;_error=null;try{_result=await Api.SearchIntelligenceFindingsAsync(_search,_capability,null,null,_severity,_status);}catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}private async Task OpenAsync(IntelligenceFindingDto item){_detail=await Api.GetIntelligenceFindingAsync(item.IntelligenceFindingId);_notes="";}private async Task DecideAsync(){if(_detail is null||string.IsNullOrWhiteSpace(_notes))return;_busy=true;try{await Api.DecideIntelligenceFindingAsync(_detail.Finding.IntelligenceFindingId,new(Guid.Empty,_detail.Finding.IntelligenceFindingId,_resolution,_notes,Guid.Empty,_detail.Finding.RowVersion));_detail=null;await LoadAsync();}catch(Exception ex){_error=ex.Message;}finally{_busy=false;}}}
