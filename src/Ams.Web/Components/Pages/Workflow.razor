@page "/workflow"
@inject ApiClient Api

<PageTitle>Workflow</PageTitle>

<h1>Workflow</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>

            <GridColumn Field="@nameof(WorkflowInstanceDto.TargetEntityName)" HeaderText="Entity" Width="180"></GridColumn>
            <GridColumn Field="@nameof(WorkflowInstanceDto.TargetEntityId)" HeaderText="Entity Id" Width="260"></GridColumn>
            <GridColumn Field="@nameof(WorkflowInstanceDto.StatusCode)" HeaderText="Status" Width="100"></GridColumn>
            <GridColumn Field="@nameof(WorkflowInstanceDto.SubmittedDateUtc)" HeaderText="Submitted" Type="ColumnType.DateTime" Format="g" Width="180"></GridColumn>

        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<WorkflowInstanceDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchWorkflowAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<WorkflowInstanceDto>();
    }
}
