@page "/contacts"
@inject ApiClient Api

<PageTitle>Contacts</PageTitle>
<h1>Contacts</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(ContactDto.AccountName)"          HeaderText="Account"       Width="180"></GridColumn>
        <GridColumn Field="@nameof(ContactDto.FirstName)"            HeaderText="First Name"    Width="130"></GridColumn>
        <GridColumn Field="@nameof(ContactDto.LastName)"             HeaderText="Last Name"     Width="130"></GridColumn>
        <GridColumn Field="@nameof(ContactDto.Email)"                HeaderText="Email"         Width="200"></GridColumn>
        <GridColumn Field="@nameof(ContactDto.Phone)"                HeaderText="Phone"         Width="130"></GridColumn>
        <GridColumn Field="@nameof(ContactDto.JobTitle)"             HeaderText="Job Title"     Width="160"></GridColumn>
        <GridColumn Field="@nameof(ContactDto.ContactTypeCode)"      HeaderText="Type"          Width="110"></GridColumn>
        <GridColumn Field="@nameof(ContactDto.IsBillingContact)"     HeaderText="Billing"       Width="80"  DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(ContactDto.IsServiceContact)"     HeaderText="Service"       Width="80"  DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(ContactDto.IsKeyContact)"         HeaderText="Key"           Width="70"  DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(ContactDto.IsPortalUser)"         HeaderText="Portal"        Width="75"  DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(ContactDto.PreferredContactMethod)" HeaderText="Pref. Method" Width="120"></GridColumn>
        <GridColumn Field="@nameof(ContactDto.StatusCode)"           HeaderText="Status"        Width="100"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<ContactDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchContactsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
