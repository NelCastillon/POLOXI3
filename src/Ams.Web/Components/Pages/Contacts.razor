@page "/client/contacts"
@namespace Ams.Web.Components.Pages.ContactPages
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos
@using Ams.Web.Components.Pages.Contacts

<PageTitle>Contact Directory — Tenant Admin</PageTitle>

<AppPageHeader Title="Contact Directory"
               Subtitle="Tenant Admin workspace for account contacts, roles, portal users, and decision makers"
               Icon="bi-people">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/client/contacts/new")'><i class="bi bi-plus-lg"></i> New Contact</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </Actions>
</AppPageHeader>

<section class="ma-hero contact-hero">
    <div><span class="ma-eyebrow">Tenant Admin · Contacts & Relationships</span><h2>Contact Operations Workspace</h2><p>Manage account contacts, key decision makers, service/billing responsibilities, portal access, and communication preferences.</p></div>
    <div class="ma-hero-actions"><button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/client/contacts/new")'><i class="bi bi-person-plus"></i> Create Contact</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/client/contacts/dm")'><i class="bi bi-star"></i> Decision Makers</button></div>
</section>

<div class="pc-kpi-strip contact-kpi-strip">
    <div class="pc-kpi-card @(_activeFilter is null ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter(null)'><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-people"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Contacts</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "key" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("key")'><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-star-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsKeyContact)</div><div class="pc-kpi-label">Key</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "portal" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("portal")'><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-globe"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsPortalUser)</div><div class="pc-kpi-label">Portal</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "billing" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("billing")'><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-receipt"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsBillingContact)</div><div class="pc-kpi-label">Billing</div></div></div>
    <div class="pc-kpi-card @(_activeFilter == "service" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("service")'><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-headset"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.IsServiceContact)</div><div class="pc-kpi-label">Service</div></div></div>
</div>

<div class="ma-filter-bar contact-filter-bar"><div class="ma-search-wrap"><i class="bi bi-search"></i><input class="ma-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search name, account, email, phone, title…" /></div><div class="ma-type-pills"><button class="ma-pill @(_activeFilter is null ? "ma-pill-active" : "")" @onclick='() => SetFilter(null)'>All</button><button class="ma-pill @(_activeFilter == "key" ? "ma-pill-active" : "")" @onclick='() => SetFilter("key")'>Key</button><button class="ma-pill @(_activeFilter == "portal" ? "ma-pill-active" : "")" @onclick='() => SetFilter("portal")'>Portal</button><button class="ma-pill @(_activeFilter == "billing" ? "ma-pill-active" : "")" @onclick='() => SetFilter("billing")'>Billing</button><button class="ma-pill @(_activeFilter == "service" ? "ma-pill-active" : "")" @onclick='() => SetFilter("service")'>Service</button></div><select class="ma-filter-sel" @bind="_typeFilter" @bind:after="ApplyFilter"><option value="">All types</option>@foreach (var type in ContactPageConstants.ContactTypes) { <option value="@type">@type</option> }</select><button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button><span class="ma-filter-count">@_filtered.Count contacts</span></div>

@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }

<div class="um-grid-card">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading contacts…</span></div> }
    <SfGrid TValue="ContactDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="56">
        <GridEvents TValue="ContactDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" />
        <GridColumns>
            <GridColumn HeaderText="Contact" MinWidth="230" Field="LastName"><Template>@{ var c=(ContactDto)context; }<div class="contact-name-cell"><div class="contact-avatar">@ContactPageConstants.Initials(c.FirstName,c.LastName)</div><div><strong>@ContactPageConstants.FullName(c)</strong><div class="text-muted">@(c.JobTitle ?? "No title")</div></div></div></Template></GridColumn>
            <GridColumn Field="AccountName" HeaderText="Account" Width="190" />
            <GridColumn Field="Email" HeaderText="Email" Width="210"><Template>@{ var c=(ContactDto)context; }@(c.Email ?? "—")</Template></GridColumn>
            <GridColumn Field="Phone" HeaderText="Phone" Width="135"><Template>@{ var c=(ContactDto)context; }@(c.Phone ?? "—")</Template></GridColumn>
            <GridColumn Field="ContactTypeCode" HeaderText="Type" Width="135"><Template>@{ var c=(ContactDto)context; }<span class="um-badge um-badge-info">@c.ContactTypeCode</span></Template></GridColumn>
            <GridColumn HeaderText="Roles" Width="145"><Template>@{ var c=(ContactDto)context; }<div class="contact-role-dots">@if(c.IsKeyContact){<span title="Key" class="contact-dot contact-dot-key"></span>}@if(c.IsBillingContact){<span title="Billing" class="contact-dot contact-dot-billing"></span>}@if(c.IsServiceContact){<span title="Service" class="contact-dot contact-dot-service"></span>}@if(c.IsPortalUser){<span title="Portal" class="contact-dot contact-dot-portal"></span>}</div></Template></GridColumn>
            <GridColumn Field="StatusCode" HeaderText="Status" Width="110"><Template>@{ var c=(ContactDto)context; }<span class="@ContactPageConstants.StatusBadge(c.StatusCode)">@c.StatusCode</span></Template></GridColumn>
            <GridColumn HeaderText="Actions" Width="120" TextAlign="TextAlign.Center"><Template>@{ var c=(ContactDto)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/client/contacts/{c.ContactId}")' @onclick:stopPropagation="true"><i class="bi bi-person-circle"></i></button><button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDelete(c)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button></Template></GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showDelete" Width="440px" IsModal="true" ShowCloseIcon="false"><DialogContent><div class="um-confirm-dialog"><div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash3-fill"></i></div><div class="um-confirm-message"><h6>Delete Contact?</h6><p>You are about to delete <strong>@(ContactPageConstants.FullName(_deleteTarget ?? new()))</strong>.</p></div><div class="um-modal-footer w-100"><button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button><button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div></div></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />

@code {
    List<ContactDto> _items = [], _filtered = [];
    string _search = string.Empty, _typeFilter = string.Empty;
    string? _activeFilter, _loadError;
    bool _loading, _saving, _showDelete;
    ContactDto? _deleteTarget;
    SfToast _toast = default!;

    protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Accounts", "/accounts"), new("Contacts", "/client/contacts")); await LoadAsync(); }
    async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchContactsAsync(ContactPageConstants.TenantId); _items = result?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = $"Failed to load contacts: {ex.Message}"; } finally { _loading = false; } }
    void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; ApplyFilter(); }
    void ApplyFilter() { var rows = _activeFilter switch { "key" => _items.Where(x => x.IsKeyContact), "portal" => _items.Where(x => x.IsPortalUser), "billing" => _items.Where(x => x.IsBillingContact), "service" => _items.Where(x => x.IsServiceContact), _ => _items.AsEnumerable() }; _filtered = rows.Where(SearchMatches).Where(x => string.IsNullOrEmpty(_typeFilter) || x.ContactTypeCode == _typeFilter).ToList(); }
    bool SearchMatches(ContactDto c) { if (string.IsNullOrWhiteSpace(_search)) return true; var q = _search.Trim(); return ContactPageConstants.FullName(c).Contains(q, StringComparison.OrdinalIgnoreCase) || (c.AccountName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) || (c.Email?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) || (c.Phone?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) || (c.JobTitle?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false); }
    void SetFilter(string? key) { _activeFilter = key; ApplyFilter(); }
    void ResetFilters() { _activeFilter = null; _search = _typeFilter = string.Empty; ApplyFilter(); }
    void OnRowSelected(RowSelectEventArgs<ContactDto> args) => Nav.NavigateTo($"/client/contacts/{args.Data.ContactId}");
    void ConfirmDelete(ContactDto item) { _deleteTarget = item; _showDelete = true; }
    async Task ExecuteDeleteAsync() { _saving = true; try { await Api.DeleteContactAsync(_deleteTarget!.ContactId); _showDelete = false; await _toast.ShowAsync(new() { Content = "Contact deleted", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } }
}
