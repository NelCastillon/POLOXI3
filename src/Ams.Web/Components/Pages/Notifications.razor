@page "/platform/notifications"
@inject ApiClient Api

<PageTitle>Notifications</PageTitle>
<h1>Notifications</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(NotificationDto.ChannelCode)"   HeaderText="Channel"    Width="100"></GridColumn>
        <GridColumn Field="@nameof(NotificationDto.Subject)"       HeaderText="Subject"    Width="250"></GridColumn>
        <GridColumn Field="@nameof(NotificationDto.StatusCode)"    HeaderText="Status"     Width="100"></GridColumn>
        <GridColumn Field="@nameof(NotificationDto.IsRead)"        HeaderText="Read"       Width="80"  DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(NotificationDto.SentDateUtc)"   HeaderText="Sent"       Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(NotificationDto.CreatedDateUtc)" HeaderText="Created"   Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = new("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<NotificationDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchNotificationsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
