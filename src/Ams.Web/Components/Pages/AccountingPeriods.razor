@page "/finance/accounting-periods"
@inject ApiClient Api

<PageTitle>Accounting Periods</PageTitle>
<h1>Accounting Periods</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="12"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(AccountingPeriodDto.PeriodName)"   HeaderText="Period"      Width="130"></GridColumn>
        <GridColumn Field="@nameof(AccountingPeriodDto.FiscalYear)"   HeaderText="Fiscal Year" Width="110"></GridColumn>
        <GridColumn Field="@nameof(AccountingPeriodDto.PeriodNumber)" HeaderText="#"           Width="70"></GridColumn>
        <GridColumn Field="@nameof(AccountingPeriodDto.StartDate)"    HeaderText="Start"       Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(AccountingPeriodDto.EndDate)"      HeaderText="End"         Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(AccountingPeriodDto.StatusCode)"   HeaderText="Status"      Width="100"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<AccountingPeriodDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchAccountingPeriodsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
