@page "/finance/accounting-periods"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Accounting Periods</PageTitle>

<AppPageHeader Title="Accounting Periods"
               Subtitle="Fiscal periods and period-end processing"
               Icon="bi-calendar3">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "fa-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Period
        </button>
    </Actions>
</AppPageHeader>

<!-- ── Search & Filter ──────────────────────────────────────────────────── -->
<div class="fin-toolbar">
    <div class="fin-search-box">
        <i class="bi bi-search fin-search-icon" aria-hidden="true"></i>
        <input class="e-input fin-search-input"
               placeholder="Search periods…"
               @bind="_searchTerm"
               @bind:event="oninput"
               @onkeyup="@(e => e.Key == "Enter" ? LoadAsync() : Task.CompletedTask)" />
    </div>
    <div class="fin-filter-buttons">
        <button class="um-btn um-btn-ghost um-btn-sm @(_filterActive ? "um-btn-active" : "")"
                @onclick="() => _filterActive = !_filterActive">
            <i class="bi bi-funnel" aria-hidden="true"></i> Filter
        </button>
    </div>
</div>

@if (_filterActive)
{
    <div class="fin-filter-panel">
        <div class="fin-filter-group">
            <label class="fin-filter-label">Fiscal Year</label>
            <select class="e-input" @bind="_filterYear">
                <option value="">All Years</option>
                <option value="2024">2024</option>
                <option value="2025">2025</option>
                <option value="2026">2026</option>
            </select>
        </div>
        <div class="fin-filter-group">
            <label class="fin-filter-label">Status</label>
            <select class="e-input" @bind="_filterStatus">
                <option value="">All</option>
                <option value="Open">Open</option>
                <option value="Closed">Closed</option>
            </select>
        </div>
    </div>
}

<!-- ── KPI Cards ──────────────────────────────────────────────────────── -->
@if (_stats is not null)
{
    <div class="fin-kpi-strip">
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #dbeafe; color: #1d4ed8;"><i class="bi bi-calendar-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.TotalPeriods</div>
                <div class="fin-kpi-label">Total Periods</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #d1fae5; color: #047857;"><i class="bi bi-unlock-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.OpenPeriods</div>
                <div class="fin-kpi-label">Open Periods</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #ede9fe; color: #6d28d9;"><i class="bi bi-lock-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.ClosedPeriods</div>
                <div class="fin-kpi-label">Closed Periods</div>
            </div>
        </div>
    </div>
}

<!-- ── Content ──────────────────────────────────────────────────────── -->
@if (_error is not null)
{
    <div class="fin-alert fin-alert-warning">
        <div class="fin-alert-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></div>
        <div class="fin-alert-body">
            <div class="fin-alert-title">⚠️ Database Schema Issue</div>
            <p>Finance schema initialization required. Run: <strong>sql/01_Finance_Schema.sql</strong></p>
        </div>
    </div>
}
else if (_loading)
{
    <div class="fin-loading">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading Accounting Periods…</span>
    </div>
}
else if (_items?.Count == 0)
{
    <div class="fin-empty-state">
        <i class="bi bi-inbox fin-empty-icon" aria-hidden="true"></i>
        <h3>No Periods Found</h3>
        <p>@(_searchTerm != null ? $"No periods match \"{_searchTerm}\"." : "No accounting periods have been created yet.")</p>
    </div>
}
else
{
    <div class="fin-grid-container">
        <SfGrid TValue="AccountingPeriodDto" DataSource="_items" AllowPaging="true" AllowSorting="true" Height="600px">
            <GridEvents TValue="AccountingPeriodDto" RowSelected="OnRowSelected" />
            <GridPageSettings PageSize="12"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(AccountingPeriodDto.PeriodCode)" HeaderText="Code" Width="100" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(AccountingPeriodDto.PeriodName)" HeaderText="Period" Width="150" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(AccountingPeriodDto.StartDate)" HeaderText="Start Date" Type="ColumnType.Date" Format="d" Width="120" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(AccountingPeriodDto.EndDate)" HeaderText="End Date" Type="ColumnType.Date" Format="d" Width="120" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(AccountingPeriodDto.StatusCode)" HeaderText="Status" Width="100" AllowSorting="true">
                    <Template>
                        @{
                            var period = context as AccountingPeriodDto;
                            var badgeClass = period?.StatusCode switch
                            {
                                "Closed" => "fin-badge-secondary",
                                "Open" => "fin-badge-success",
                                _ => "fin-badge-warning"
                            };
                        }
                        <span class="fin-badge @badgeClass">@period?.StatusCode</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Actions" Width="90">
                    <Template>
                        @{ var period = (AccountingPeriodDto)context; }
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenEdit(period)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
}

<SfDialog @bind-Visible="_showForm" Width="640px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates><Content>
        <div class="um-modal-header"><i class="bi bi-calendar-range" aria-hidden="true"></i><span>@(_editingId == Guid.Empty ? "New Accounting Period" : "Edit Accounting Period")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
        <EditForm EditContext="_editContext"><DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field"><label>Period Code <span class="text-danger">*</span></label><InputText @bind-Value="_form.PeriodCode" class="um-input" /><ValidationMessage For="() => _form.PeriodCode" class="text-danger" /></div>
                <div class="um-field"><label>Period Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.PeriodName" class="um-input" /><ValidationMessage For="() => _form.PeriodName" class="text-danger" /></div>
                <div class="um-field"><label>Start Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.StartDate" class="um-input" /><ValidationMessage For="() => _form.StartDate" class="text-danger" /></div>
                <div class="um-field"><label>End Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.EndDate" class="um-input" /><ValidationMessage For="() => _form.EndDate" class="text-danger" /></div>
                <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input"><option value="Open">Open</option><option value="Closed">Closed</option></InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
                @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
            </div></div>
        </EditForm>
        <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Period")</button></div>
    </Content></DialogTemplates>
</SfDialog>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private string _filterYear = "";
    private string _filterStatus = "";
    private bool _filterActive = false;
    private bool _loading = false;
    private bool _showForm;
    private bool _saving;
    private List<AccountingPeriodDto>? _items;
    private string? _error;
    private string? _formError;
    private Guid _editingId = Guid.Empty;
    private PeriodForm _form = new();
    private EditContext _editContext = default!;

    private class Stats
    {
        public int TotalPeriods { get; set; }
        public int OpenPeriods { get; set; }
        public int ClosedPeriods { get; set; }
    }

    private Stats? _stats;

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home", "/"),
            new("Finance", "/finance"),
            new("Accounting Periods", "/finance/accounting-periods"));
        _editContext = new(_form);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _items = null;
        try
        {
            var result = await Api.SearchAccountingPeriodsAsync(_tenantId, _searchTerm);
            _items = result?.Items.ToList() ?? [];

            if (!string.IsNullOrEmpty(_filterYear))
                _items = _items.Where(x => x.StartDate.Year.ToString() == _filterYear).ToList();

            if (!string.IsNullOrEmpty(_filterStatus))
                _items = _items.Where(x => x.StatusCode == _filterStatus).ToList();

            _stats = new Stats
            {
                TotalPeriods = _items.Count,
                OpenPeriods = _items.Count(x => x.StatusCode == "Open"),
                ClosedPeriods = _items.Count(x => x.StatusCode == "Closed")
            };
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            if (ex.Message.Contains("Invalid column name") || ex.Message.Contains("AccountingPeriod"))
            {
                _error = "Database schema mismatch. Please ensure 00_schema_migration.sql has been applied to your database. See db/README.md for setup instructions.";
            }
            _items = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnRowSelected(RowSelectEventArgs<AccountingPeriodDto> args) => OpenEdit(args.Data);
    private void OpenCreate() { _editingId = Guid.Empty; _form = new(); _editContext = new(_form); _formError = null; _showForm = true; }
    private void OpenEdit(AccountingPeriodDto period) { _editingId = period.AccountingPeriodId; _form = new PeriodForm { PeriodCode = period.PeriodCode, PeriodName = period.PeriodName, StartDate = period.StartDate.ToDateTime(TimeOnly.MinValue), EndDate = period.EndDate.ToDateTime(TimeOnly.MinValue), StatusCode = period.StatusCode }; _editContext = new(_form); _formError = null; _showForm = true; }
    private void CloseForm() => _showForm = false;
    private async Task SaveAsync()
    {
        if (!_editContext.Validate()) return;
        if (_form.EndDate < _form.StartDate) { _formError = "End Date must be on or after Start Date."; return; }
        _saving = true;
        try
        {
            if (_editingId == Guid.Empty)
                await Api.CreateAccountingPeriodAsync(new CreateAccountingPeriodRequest { TenantId = _tenantId, PeriodCode = _form.PeriodCode, PeriodName = _form.PeriodName, StartDate = DateOnly.FromDateTime(_form.StartDate), EndDate = DateOnly.FromDateTime(_form.EndDate), StatusCode = _form.StatusCode });
            else
                await Api.UpdateAccountingPeriodAsync(_editingId, new UpdateAccountingPeriodRequest { TenantId = _tenantId, AccountingPeriodId = _editingId, PeriodCode = _form.PeriodCode, PeriodName = _form.PeriodName, StartDate = DateOnly.FromDateTime(_form.StartDate), EndDate = DateOnly.FromDateTime(_form.EndDate), StatusCode = _form.StatusCode });
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; }
        finally { _saving = false; }
    }

    private sealed class PeriodForm
    {
        [Required, StringLength(50)] public string PeriodCode { get; set; } = string.Empty;
        [Required, StringLength(150)] public string PeriodName { get; set; } = string.Empty;
        [Required] public DateTime StartDate { get; set; } = DateTime.Today;
        [Required] public DateTime EndDate { get; set; } = DateTime.Today;
        [Required, StringLength(50)] public string StatusCode { get; set; } = "Open";
    }
}
