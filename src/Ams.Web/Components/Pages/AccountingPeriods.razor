@page "/finance/accounting-periods"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Accounting Periods</PageTitle>

<AppPageHeader Title="Accounting Periods"
               Subtitle="Fiscal periods and period-end processing"
               Icon="bi-calendar3">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "fa-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Period
        </button>
    </Actions>
</AppPageHeader>

<!-- ── Search & Filter ──────────────────────────────────────────────────── -->
<div class="fin-toolbar">
    <div class="fin-search-box">
        <i class="bi bi-search fin-search-icon" aria-hidden="true"></i>
        <input class="e-input fin-search-input"
               placeholder="Search periods…"
               @bind="_searchTerm"
               @bind:event="oninput"
               @onkeyup="@(e => e.Key == "Enter" ? LoadAsync() : Task.CompletedTask)" />
    </div>
    <div class="fin-filter-buttons">
        <button class="um-btn um-btn-ghost um-btn-sm @(_filterActive ? "um-btn-active" : "")"
                @onclick="() => _filterActive = !_filterActive">
            <i class="bi bi-funnel" aria-hidden="true"></i> Filter
        </button>
    </div>
</div>

@if (_filterActive)
{
    <div class="fin-filter-panel">
        <div class="fin-filter-group">
            <label class="fin-filter-label">Fiscal Year</label>
            <select class="e-input" @bind="_filterYear">
                <option value="">All Years</option>
                <option value="2024">2024</option>
                <option value="2025">2025</option>
                <option value="2026">2026</option>
            </select>
        </div>
        <div class="fin-filter-group">
            <label class="fin-filter-label">Status</label>
            <select class="e-input" @bind="_filterStatus">
                <option value="">All</option>
                <option value="Open">Open</option>
                <option value="Closed">Closed</option>
            </select>
        </div>
    </div>
}

<!-- ── KPI Cards ──────────────────────────────────────────────────────── -->
@if (_stats is not null)
{
    <div class="fin-kpi-strip">
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #dbeafe; color: #1d4ed8;"><i class="bi bi-calendar-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.TotalPeriods</div>
                <div class="fin-kpi-label">Total Periods</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #d1fae5; color: #047857;"><i class="bi bi-unlock-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.OpenPeriods</div>
                <div class="fin-kpi-label">Open Periods</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #ede9fe; color: #6d28d9;"><i class="bi bi-lock-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.ClosedPeriods</div>
                <div class="fin-kpi-label">Closed Periods</div>
            </div>
        </div>
    </div>
}

<!-- ── Content ──────────────────────────────────────────────────────── -->
@if (_error is not null)
{
    <div class="fin-alert fin-alert-warning">
        <div class="fin-alert-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></div>
        <div class="fin-alert-body">
            <div class="fin-alert-title">⚠️ Database Schema Issue</div>
            <p>Finance schema initialization required. Run: <strong>sql/01_Finance_Schema.sql</strong></p>
        </div>
    </div>
}
else if (_loading)
{
    <div class="fin-loading">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading Accounting Periods…</span>
    </div>
}
else if (_items?.Count == 0)
{
    <div class="fin-empty-state">
        <i class="bi bi-inbox fin-empty-icon" aria-hidden="true"></i>
        <h3>No Periods Found</h3>
        <p>@(_searchTerm != null ? $"No periods match \"{_searchTerm}\"." : "No accounting periods have been created yet.")</p>
    </div>
}
else
{
    <div class="fin-grid-container">
        <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="600px">
            <GridPageSettings PageSize="12"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(AccountingPeriodDto.PeriodCode)" HeaderText="Code" Width="100" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(AccountingPeriodDto.PeriodName)" HeaderText="Period" Width="150" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(AccountingPeriodDto.StartDate)" HeaderText="Start Date" Type="ColumnType.Date" Format="d" Width="120" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(AccountingPeriodDto.EndDate)" HeaderText="End Date" Type="ColumnType.Date" Format="d" Width="120" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(AccountingPeriodDto.StatusCode)" HeaderText="Status" Width="100" AllowSorting="true">
                    <Template>
                        @{
                            var period = context as AccountingPeriodDto;
                            var badgeClass = period?.StatusCode switch
                            {
                                "Closed" => "fin-badge-secondary",
                                "Open" => "fin-badge-success",
                                _ => "fin-badge-warning"
                            };
                        }
                        <span class="fin-badge @badgeClass">@period?.StatusCode</span>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private string _filterYear = "";
    private string _filterStatus = "";
    private bool _filterActive = false;
    private bool _loading = false;
    private List<AccountingPeriodDto>? _items;
    private string? _error;

    private class Stats
    {
        public int TotalPeriods { get; set; }
        public int OpenPeriods { get; set; }
        public int ClosedPeriods { get; set; }
    }

    private Stats? _stats;

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home", "/"),
            new("Finance", "/finance"),
            new("Accounting Periods", "/finance/accounting-periods"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _items = null;
        try
        {
            var result = await Api.SearchAccountingPeriodsAsync(_tenantId, _searchTerm);
            _items = result?.Items.ToList() ?? [];

            if (!string.IsNullOrEmpty(_filterYear))
                _items = _items.Where(x => x.StartDate.Year.ToString() == _filterYear).ToList();

            if (!string.IsNullOrEmpty(_filterStatus))
                _items = _items.Where(x => x.StatusCode == _filterStatus).ToList();

            _stats = new Stats
            {
                TotalPeriods = _items.Count,
                OpenPeriods = _items.Count(x => x.StatusCode == "Open"),
                ClosedPeriods = _items.Count(x => x.StatusCode == "Closed")
            };
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            if (ex.Message.Contains("Invalid column name") || ex.Message.Contains("AccountingPeriod"))
            {
                _error = "Database schema mismatch. Please ensure 00_schema_migration.sql has been applied to your database. See db/README.md for setup instructions.";
            }
            _items = [];
        }
        finally
        {
            _loading = false;
        }
    }
}
