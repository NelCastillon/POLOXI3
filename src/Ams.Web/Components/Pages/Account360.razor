    // ── Action handlers ───────────────────────────────────────────────────────
    private async Task CommitAddContactAsync()
    {
        _contacts.Add(new ContactRow { FirstName=_newContact.FirstName, LastName=_newContact.LastName, Title=_newContact.Title, Email=_newContact.Email, Phone=_newContact.Phone, IsPrimary=_newContact.IsPrimary });
        _newContact=new(); _showAddContact=false;
        await ShowToast("Contact added.");
    }
    private async Task CommitActivityAsync()
    {
        _activities.Insert(0, new ActivityRow { Type=_newAct.Type, Subject=_newAct.Subject, Notes=_newAct.Notes, By="Me", OccurredAt=_newAct.OccurredAt });
        AddTimelineEvent("Activity", $"{_newAct.Type}: {_newAct.Subject}", _newAct.Notes, "Me", _newAct.OccurredAt);
        _newAct=new(); _showLogActivity=false;
        await ShowToast("Activity logged.");
    }
    private async Task CommitComposeAsync()
    {
        _comms.Insert(0, new CommRow { Channel=_newComm.Channel, Subject=_newComm.Subject, Preview=_newComm.Preview, SentBy="Me", SentAt=DateTime.UtcNow });
        _newComm=new(); _showCompose=false;
        await ShowToast("Communication logged.");
    }
    private async Task CommitFnolAsync()
    {
        _claims.Add(new ClaimRow { ClaimNumber=$"CLM-{Random.Shared.Next(1000,9999)}", LineOfBusiness=_newFnol.LineOfBusiness, LossDate=_newFnol.LossDate ?? DateTime.UtcNow, Status="Open", ReserveAmount=0, PaidAmount=0, Adjuster=_newFnol.Adjuster ?? "—" });
        _newFnol=new(); _showFnol=false;
        await ShowToast("FNOL submitted.");
    }
    private async Task CommitAddRelAsync()
    {
        _relationships.Add(new RelationshipRow { RelatedAccountId=Guid.NewGuid(), RelatedAccount=_newRel.RelatedAccount, RelationType=_newRel.RelationType });
        _newRel=new(); _showAddRel=false;
        await ShowToast("Relationship linked.");
    }
    private async Task CommitCampaignAsync()
    {
        _campaigns.Add(new CampaignRow { CampaignName=_campaignTarget, Status="Active", EnrolledAt=DateTime.UtcNow });
        _campaignTarget=string.Empty; _showCampaign=false;
        await ShowToast("Enrolled in campaign.");
    }
    private async Task CommitNoteAsync()
    {
        AddTimelineEvent("Note", "Note added", _newNoteText, "Me", DateTime.UtcNow);
        _newNoteText=string.Empty; _showNote=false;
        await ShowToast("Note saved.");
    }
    private async Task CommitAddSubmissionAsync()
    {
        _submissions.Add(new SubmissionRow { SubmissionNumber=$"SUB-{Random.Shared.Next(1000,9999)}", LineOfBusiness=_newSub.LineOfBusiness, Carrier=_newSub.Carrier, Status="Submitted", SubmittedAt=DateTime.UtcNow, DueDate=_newSub.DueDate, Notes=_newSub.Notes });
        _newSub=new(); _showAddSubmission=false;
        await ShowToast("Submission created.");
    }

    private void AddTimelineEvent(string cat, string title, string? detail, string by, DateTime at)
        => _timelineEvents.Insert(0, new TimelineEvent(cat, title, detail, by, at));

    private async Task ShowToast(string msg, string css = "e-toast-success")
    {
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = css });
    }

    // ── Render helpers ────────────────────────────────────────────────────────
    private static RenderFragment F(string label, string? val) => __builder =>
    { <div class="a360-field-group"><span class="a360-field-lbl">@label</span><span class="a360-field-val">@(string.IsNullOrEmpty(val) ? "—" : val)</span></div>; };

    private static RenderFragment KpiCard(string label, string val, string icon, string cls) => __builder =>
    {
        <div class="a360-kpi-card">
            <span class="a360-kpi-icon @cls"><i class="bi @icon" aria-hidden="true"></i></span>
            <div><div class="a360-kpi-val">@val</div><div class="a360-kpi-lbl">@label</div></div>
        </div>;
    };

    private static RenderFragment AEmpty(string icon, string title, string sub) => __builder =>
    { <div class="a360-empty"><i class="bi @icon a360-empty-icon" aria-hidden="true"></i><div class="a360-empty-title">@title</div><div class="a360-empty-sub">@sub</div></div>; };

    private static RenderFragment RMetric(string label, string val, string icon) => __builder =>
    { <div class="a360-rm-row"><i class="bi @icon a360-rm-icon" aria-hidden="true"></i><span class="a360-rm-lbl">@label</span><span class="a360-rm-val">@val</span></div>; };

