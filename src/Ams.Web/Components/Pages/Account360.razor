        <FooterTemplate>
            <div class="a360-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showLogActivity = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitActivityAsync" disabled="@(string.IsNullOrEmpty(_newAct.Type)||string.IsNullOrEmpty(_newAct.Subject))"><i class="bi bi-check-lg" aria-hidden="true"></i> Save</button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Compose -->
