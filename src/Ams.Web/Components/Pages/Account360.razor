@page "/accounts/{AccountId:guid}"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Common.Validation
@using Ams.Application.Features.Accounts
@using Microsoft.AspNetCore.Components.Forms
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject NavigationContextService NavContext

<PageTitle>@(_acct is null ? "Account" : _acct.AccountName) â€” 360</PageTitle>

<div class="a360-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="a360-toast @toast.CssClass">
            <i class="bi @toast.Icon" aria-hidden="true"></i>
            <span>@toast.Content</span>
            <button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
    }
</div>

@if (_loading)
{
    <div class="a360-loading"><span class="um-spin" aria-hidden="true"></span><span>Loading accountâ€¦</span></div>
}
else if (_acct is null)
{
    <div class="a360-not-found">
        <i class="bi bi-building-x a360-nf-icon" aria-hidden="true"></i>
        <h2>Account not found</h2>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/accounts")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Accounts
        </button>
    </div>
}
else
{
    <div class="a360-enterprise-page">
    <!-- â”€â”€ HEADER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <div class="a360-header">
        <div class="a360-header-left">
            <div class="a360-logo @AvatarColor(_acct.AccountName)">@Initials(_acct.AccountName)</div>
            <div class="a360-header-info">
                <div class="a360-name-row">
                    <h1 class="a360-name">@_acct.AccountName</h1>
                    <span class="a360-account-pill">@_acct.AccountNumber</span>
                    <span class="@StatusBadge(_acct.Status)">@_acct.Status</span>
                    @if (!string.IsNullOrEmpty(_acct.Segment))
                    {
                        <span class="@SegBadge(_acct.Segment)">@_acct.Segment</span>
                    }
                </div>
                <div class="a360-sub-row">
                    <span class="a360-sub-chip"><i class="bi bi-building" aria-hidden="true"></i>@_acct.AccountType</span>
                    <span class="a360-sub-chip"><i class="bi bi-person" aria-hidden="true"></i>@_acct.Owner</span>
                    <span class="a360-sub-chip"><i class="bi bi-people" aria-hidden="true"></i>@_acct.ServicingTeam</span>
                    @if (!string.IsNullOrEmpty(_acct.Industry))
                    {
                        <span class="a360-sub-chip"><i class="bi bi-briefcase" aria-hidden="true"></i>@_acct.Industry</span>
                    }
                </div>
            </div>
        </div>
        <div class="a360-header-actions">
            <button type="button" class="a360-return" @onclick='() => Nav.NavigateTo("/accounts")' title="Back to Accounts" aria-label="Back to Accounts"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
            <button class="um-btn um-btn-ghost" @onclick="OpenEditAccount"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
            <button class="um-btn um-btn-ghost" @onclick="() => _showNote = true"><i class="bi bi-sticky" aria-hidden="true"></i> Add Note</button>
            <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/quotes/new?accountId=" + AccountId)'><i class="bi bi-file-text" aria-hidden="true"></i> New Quote</button>
            <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/crm/opportunities/new?accountId=" + AccountId)'><i class="bi bi-trophy" aria-hidden="true"></i> New Opportunity</button>
        </div>
    </div>

    <!-- â”€â”€ HEADLINE KPI CARDS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <div class="a360-kpi-bar">
        @KpiCard("Total Premium",          DisplayTotalPremium.ToString("C0"),    "bi-shield-fill",     "a360-ki--green")
        @KpiCard("Balances Due",           DisplayBalancesDue.ToString("C0"),     "bi-receipt",         DisplayBalancesDue > 0 ? "a360-ki--red" : "a360-ki--green")
        @KpiCard("Renewal Risk",           _acct.RenewalRisk,                    "bi-arrow-repeat",    RenewalRiskIcon(_acct.RenewalRisk))
        @KpiCard("Open Claims",            DisplayOpenClaims.ToString(),          "bi-exclamation-triangle", DisplayOpenClaims > 0 ? "a360-ki--amber" : "a360-ki--green")
        @KpiCard("Active Policies",        DisplayActivePolicies.ToString(),      "bi-shield-check",    "a360-ki--blue")
        @KpiCard("Open Opportunities",     _acct.OpenOpportunities.ToString(),   "bi-trophy",          "a360-ki--purple")
        @KpiCard("YTD Commissions",        DisplayYtdCommissions.ToString("C0"),  "bi-percent",         "a360-ki--blue")
        @KpiCard("Last Activity",          DisplayLastActivity?.ToString("d") ?? "—", "bi-lightning","a360-ki--gray")
    </div>

    <section class="a360-priority-grid" aria-label="Enterprise account priorities">
        @foreach (var insight in PriorityInsights)
        {
            <button type="button" class="a360-priority-card @insight.Tone" @onclick="() => SelectTab(insight.TabIndex)">
                <span class="a360-priority-icon"><i class="bi @insight.Icon" aria-hidden="true"></i></span>
                <span><strong>@insight.Title</strong><small>@insight.Detail</small></span>
                <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
            </button>
        }
    </section>

    <section class="a360-action-strip" aria-label="Account workflow actions">
        <button type="button" class="a360-action-card" @onclick="OpenLogActivity"><i class="bi bi-lightning" aria-hidden="true"></i><span><strong>Log activity</strong><small>Capture service, sales, or renewal touchpoints</small></span></button>
        <button type="button" class="a360-action-card" @onclick="OpenCompose"><i class="bi bi-send" aria-hidden="true"></i><span><strong>Send communication</strong><small>Create email, call, SMS, or portal history</small></span></button>
        <button type="button" class="a360-action-card" @onclick="OpenUpload"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i><span><strong>Upload document</strong><small>Add loss runs, policies, or financials</small></span></button>
        <button type="button" class="a360-action-card" @onclick="OpenFnol"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span><strong>Start FNOL</strong><small>Open claim intake for account servicing</small></span></button>
    </section>

    <!-- â”€â”€ 14-TAB BODY â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <div class="a360-detail-shell">
    <div class="a360-native-tabs" role="tablist" aria-label="Account detail sections">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="@TabButtonClass(tab.Index)" role="tab" aria-selected="@(_tab == tab.Index)" @onclick="() => SelectTab(tab.Index)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
            </button>
        }
    </div>
    <div class="a360-native-panels">

            <!-- 0 â”€â”€ OVERVIEW â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 0)
            {
                    <div class="a360-tab-body">
                        <div class="a360-overview-grid">

                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Account Information</h3>
                                <div class="a360-field-grid">
                                    @F("Account #",      _acct.AccountNumber)
                                    @F("Account Name",   _acct.AccountName)
                                    @F("Type",           _acct.AccountType)
                                    @F("Status",         _acct.Status)
                                    @F("Segment",        _acct.Segment)
                                    @F("Industry",       _acct.Industry)
                                    @F("Employees",      _acct.Employees?.ToString("N0") ?? "â€”")
                                    @F("Annual Revenue", _acct.AnnualRevenue?.ToString("C0") ?? "â€”")
                                    @F("Website",        _acct.Website)
                                    @F("Tax ID / EIN",   _acct.TaxId)
                                    @F("NAICS Code",     _acct.NaicsCode)
                                    @F("Lifecycle Stage",_acct.LifecycleStage)
                                    @F("Created",        _acct.CreatedAt.ToString("d"))
                                    @F("Last Modified",  _acct.ModifiedAt?.ToString("d") ?? "â€”")
                                </div>
                            </div>

                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Service Team</h3>
                                <div class="a360-field-grid">
                                    @F("Account Owner",    _acct.Owner)
                                    @F("Servicing Team",   _acct.ServicingTeam)
                                    @F("CSR",              _acct.CsrName ?? "â€”")
                                    @F("Producer",         _acct.ProducerName ?? "â€”")
                                    @F("Account Manager",  _acct.AccountManager ?? "â€”")
                                </div>
                            </div>

                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Contact Information</h3>
                                <div class="a360-field-grid">
                                    @F("Primary Email", _acct.Email)
                                    @F("Phone",         _acct.Phone)
                                    @F("Street",        _acct.Street)
                                    @F("City",          _acct.City)
                                    @F("State",         _acct.State)
                                    @F("ZIP",           _acct.Zip)
                                    @F("Country",       _acct.Country)
                                </div>
                            </div>

                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Financial Summary</h3>
                                <div class="a360-field-grid">
                                    @F("Total Premium",       _acct.TotalPremium.ToString("C0"))
                                    @F("Balances Due",        _acct.BalancesDue.ToString("C0"))
                                    @F("YTD Commissions",     _acct.YtdCommissions.ToString("C0"))
                                    @F("Active Policies",     _acct.ActivePolicies.ToString())
                                    @F("Open Claims",         _acct.OpenClaims.ToString())
                                    @F("Renewal Risk",        _acct.RenewalRisk)
                                    @F("Open Opportunities",  _acct.OpenOpportunities.ToString())
                                </div>
                            </div>

                        </div>
                        @if (!string.IsNullOrEmpty(_acct.Notes))
                        {
                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Notes</h3>
                                <p class="a360-notes">@_acct.Notes</p>
                            </div>
                        }
                    </div>
            }

            <!-- 1 â”€â”€ CONTACTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 1)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_contacts.Count contact(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenAddContact"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Contact</button>
                        </div>
                        @if (_contacts.Count == 0) { @AEmpty("bi-people","No contacts","Add the key contacts for this account.") }
                        else
                        {
                            <div class="a360-contact-grid">
                                @foreach (var c in _contacts)
                                {
                                    <div class="a360-contact-card">
                                        <div class="a360-contact-avatar @AvatarColor(c.FullName)">@Initials(c.FullName)</div>
                                        <div class="a360-contact-body">
                                            <div class="a360-contact-name">@c.FullName</div>
                                            <div class="a360-contact-title">@c.Title</div>
                                            <div class="a360-contact-links">
                                                @if (!string.IsNullOrEmpty(c.Email)) { <a href="mailto:@c.Email" class="a360-contact-link"><i class="bi bi-envelope" aria-hidden="true"></i> @c.Email</a> }
                                                @if (!string.IsNullOrEmpty(c.Phone)) { <span class="a360-contact-link"><i class="bi bi-telephone" aria-hidden="true"></i> @c.Phone</span> }
                                            </div>
                                        </div>
                                        @if (c.IsPrimary) { <span class="a360-primary-badge">Primary</span> }
                                        <div class="a360-card-actions">
                                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Edit contact" @onclick="() => OpenEditContact(c)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" title="Delete contact" @onclick="() => ConfirmDeleteContact(c)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
            }

            <!-- 2 â”€â”€ POLICIES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 2)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_policies.Count polic@(_policies.Count == 1 ? "y" : "ies")</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/new?accountId=" + AccountId)'><i class="bi bi-plus-lg" aria-hidden="true"></i> New Policy</button>
                        </div>
                        @if (_policies.Count == 0) { @AEmpty("bi-shield","No policies","Bind new policies from quotes or add existing.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>Policy #</th><th>Line</th><th>Carrier</th><th class="text-end">Premium</th><th>Status</th><th>Effective</th><th>Expiration</th><th class="text-end">Actions</th></tr></thead>
                                    <tbody>
                                        @foreach (var p in _policies.OrderByDescending(x => x.Premium))
                                        {
                                            <tr>
                                                <td class="a360-mono a360-bold">@p.PolicyNumber</td><td>@p.LineOfBusiness</td><td>@p.Carrier</td><td class="text-end a360-mono a360-bold">@p.Premium.ToString("C0")</td><td><span class="@PolicyStatusBadge(p.Status)">@p.Status</span></td><td class="a360-mono">@p.EffectiveDate.ToString("d")</td><td class="a360-mono @(p.ExpirationDate < DateTime.UtcNow.AddDays(30) && p.Status == "Active" ? "a360-due-soon" : "")">@p.ExpirationDate.ToString("d")</td><td class="text-end"><button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/policies/{p.PolicyId}")'><i class="bi bi-arrow-right" aria-hidden="true"></i></button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 3 â”€â”€ SUBMISSIONS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 3)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_submissions.Count submission(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenAddSubmission"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Submission</button>
                        </div>
                        @if (_submissions.Count == 0) { @AEmpty("bi-send","No submissions","Create carrier submissions for this account's lines.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>Sub #</th><th>Line</th><th>Carrier</th><th>Status</th><th>Submitted</th><th>Due</th><th>Notes</th><th class="text-end">Actions</th></tr></thead>
                                    <tbody>
                                        @foreach (var s in _submissions.OrderByDescending(x => x.SubmittedAt))
                                        {
                                            <tr><td class="a360-mono a360-bold">@s.SubmissionNumber</td><td>@s.LineOfBusiness</td><td>@s.Carrier</td><td><span class="@SubStatusBadge(s.Status)">@s.Status</span></td><td class="a360-mono">@s.SubmittedAt.ToString("d")</td><td class="a360-mono @(s.DueDate.HasValue && s.DueDate < DateTime.UtcNow ? "a360-overdue" : "")">@(s.DueDate?.ToString("d") ?? "—")</td><td>@s.Notes</td><td class="text-end"><button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Edit submission" @onclick="() => OpenEditSubmission(s)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" title="Delete submission" @onclick="() => ConfirmDeleteSubmission(s)"><i class="bi bi-trash" aria-hidden="true"></i></button></td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 4 â”€â”€ CLAIMS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 4)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_claims.Count claim(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenFnol"><i class="bi bi-plus-lg" aria-hidden="true"></i> FNOL</button>
                        </div>
                        @if (_claims.Count == 0) { @AEmpty("bi-exclamation-triangle","No claims","First notice of loss will appear here.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>Claim #</th><th>Line</th><th>Loss Date</th><th>Status</th><th class="text-end">Reserve</th><th class="text-end">Paid</th><th>Adjuster</th><th class="text-end">Actions</th></tr></thead>
                                    <tbody>
                                        @foreach (var c in _claims.OrderByDescending(x => x.LossDate))
                                        {
                                            <tr><td class="a360-mono a360-bold">@c.ClaimNumber</td><td>@c.LineOfBusiness</td><td class="a360-mono">@c.LossDate.ToString("d")</td><td><span class="@ClaimStatusBadge(c.Status)">@c.Status</span></td><td class="text-end a360-mono a360-bold">@c.ReserveAmount.ToString("C0")</td><td class="text-end a360-mono">@c.PaidAmount.ToString("C0")</td><td>@c.Adjuster</td><td class="text-end"><button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Edit claim" @onclick="() => OpenEditClaim(c)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" title="Delete claim" @onclick="() => ConfirmDeleteClaim(c)"><i class="bi bi-trash" aria-hidden="true"></i></button></td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 5 â”€â”€ BILLING â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 5)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_billing.Count invoice(s)</span>
                        </div>
                        @if (_billing.Count == 0) { @AEmpty("bi-receipt","No billing records","Invoices and installments will appear here.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>Invoice #</th><th>Policy #</th><th class="text-end">Amount</th><th class="text-end">Balance</th><th>Status</th><th>Due</th><th>Method</th></tr></thead>
                                    <tbody>
                                        @foreach (var b in _billing.OrderBy(x => x.DueDate))
                                        {
                                            <tr><td class="a360-mono a360-bold">@b.InvoiceNumber</td><td class="a360-mono">@b.PolicyNumber</td><td class="text-end a360-mono a360-bold">@b.Amount.ToString("C0")</td><td class="text-end a360-mono @(b.Balance > 0 ? "a360-overdue" : "")">@b.Balance.ToString("C0")</td><td><span class="@BillingStatusBadge(b.Status)">@b.Status</span></td><td class="a360-mono @(b.DueDate < DateTime.UtcNow && b.Status != "Paid" ? "a360-overdue" : "")">@b.DueDate.ToString("d")</td><td>@b.PaymentMethod</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 6 â”€â”€ COMMISSIONS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 6)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_commissions.Count commission record(s)</span>
                        </div>
                        @if (_commissions.Count == 0) { @AEmpty("bi-percent","No commission records","Commission history will appear here.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>Policy #</th><th>Line</th><th class="text-end">Premium</th><th class="text-end">Rate</th><th class="text-end">Commission</th><th>Status</th><th>Paid Date</th><th>Producer</th></tr></thead>
                                    <tbody>
                                        @foreach (var c in _commissions.OrderByDescending(x => x.CommissionAmount))
                                        {
                                            <tr><td class="a360-mono a360-bold">@c.PolicyNumber</td><td>@c.LineOfBusiness</td><td class="text-end a360-mono a360-bold">@c.GrossPremium.ToString("C0")</td><td class="text-end a360-mono">@c.CommissionRate.ToString("F1")%</td><td class="text-end a360-mono a360-bold">@c.CommissionAmount.ToString("C0")</td><td><span class="@CommStatusBadge(c.Status)">@c.Status</span></td><td class="a360-mono">@(c.PaidDate?.ToString("d") ?? "—")</td><td>@c.Producer</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 7 â”€â”€ DOCUMENTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 7)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_documents.Count document(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenUpload"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Upload</button>
                        </div>
                        @if (_documents.Count == 0) { @AEmpty("bi-folder2","No documents","Upload loss runs, financials, policy documents or correspondence.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>File</th><th>Category</th><th class="text-end">Size</th><th>Uploaded By</th><th>Date</th><th class="text-end">Actions</th></tr></thead>
                                    <tbody>
                                        @foreach (var d in _documents.OrderByDescending(x => x.UploadedAt))
                                        {
                                            <tr><td><span class="a360-doc-name"><i class="bi @DocIcon(d.Extension)" aria-hidden="true"></i> @d.FileName</span></td><td>@d.Category</td><td class="text-end a360-mono">@d.SizeKb KB</td><td>@d.UploadedBy</td><td class="a360-mono">@d.UploadedAt.ToString("d")</td><td class="text-end"><button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Download" @onclick="() => DownloadDocumentAsync(d)"><i class="bi bi-download" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" title="Delete document" @onclick="() => ConfirmDeleteDocument(d)"><i class="bi bi-trash" aria-hidden="true"></i></button></td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 8 â”€â”€ ACTIVITIES â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 8)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_activities.Count activit@(_activities.Count == 1 ? "y" : "ies")</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenLogActivity"><i class="bi bi-plus-lg" aria-hidden="true"></i> Log</button>
                        </div>
                        @if (_activities.Count == 0) { @AEmpty("bi-lightning","No activities","Log calls, emails and meetings linked to this account.") }
                        else
                        {
                            <div class="a360-timeline">
                                @foreach (var a in _activities.OrderByDescending(x => x.OccurredAt))
                                {
                                    <div class="a360-tl-item">
                                        <div class="a360-tl-icon @ActivityColor(a.Type)"><i class="bi @ActivityIcon(a.Type)" aria-hidden="true"></i></div>
                                        <div class="a360-tl-body">
                                            <div class="a360-tl-hdr">
                                                <span class="a360-tl-type">@a.Type</span>
                                                <span class="a360-tl-by">@a.By</span>
                                                <span class="a360-mono a360-muted">@a.OccurredAt.ToString("g")</span>
                                            </div>
                                            <div class="a360-tl-subject">@a.Subject</div>
                                            @if (!string.IsNullOrEmpty(a.Notes)) { <p class="a360-tl-notes">@a.Notes</p> }
                                            <div class="a360-inline-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditActivity(a)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteActivity(a)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
            }

            <!-- 9 â”€â”€ COMMUNICATIONS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 9)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_comms.Count message(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenCompose"><i class="bi bi-plus-lg" aria-hidden="true"></i> New</button>
                        </div>
                        @if (_comms.Count == 0) { @AEmpty("bi-chat-dots","No communications","Log emails, calls or SMS sent to this account.") }
                        else
                        {
                            <div class="a360-comms-list">
                                @foreach (var m in _comms.OrderByDescending(x => x.SentAt))
                                {
                                    <div class="a360-comm-row">
                                        <div class="a360-comm-icon @CommColor(m.Channel)"><i class="bi @CommIcon(m.Channel)" aria-hidden="true"></i></div>
                                        <div class="a360-comm-body">
                                            <div class="a360-comm-hdr">
                                                <span class="a360-comm-subject">@m.Subject</span>
                                                <span class="a360-comm-channel">@m.Channel</span>
                                                <span class="a360-mono a360-muted">@m.SentAt.ToString("g")</span>
                                            </div>
                                            <div class="a360-comm-preview">@m.Preview</div>
                                            <div class="a360-comm-meta"><span>By @m.SentBy</span>@if (m.Opened) { <span class="a360-comm-opened"><i class="bi bi-check2-all" aria-hidden="true"></i> Opened</span> }</div>
                                            <div class="a360-inline-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditCommunication(m)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => MarkCommunicationOpenedAsync(m)"><i class="bi bi-check2-all" aria-hidden="true"></i> Mark Opened</button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteCommunication(m)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
            }

            <!-- 10 â”€â”€ MARKETING â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 10)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_campaigns.Count enrollment(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenCampaign"><i class="bi bi-plus-lg" aria-hidden="true"></i> Enroll</button>
                        </div>
                        @if (_campaigns.Count == 0) { @AEmpty("bi-megaphone","No campaign enrollments","Enroll this account in renewal or cross-sell campaigns.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>Campaign</th><th>Status</th><th>Enrolled</th><th class="text-end">Sent</th><th class="text-end">Opens</th><th class="text-end">Clicks</th><th class="text-end">Actions</th></tr></thead>
                                    <tbody>
                                        @foreach (var c in _campaigns.OrderByDescending(x => x.EnrolledAt))
                                        {
                                            <tr><td>@c.CampaignName</td><td><span class="@CampStatusBadge(c.Status)">@c.Status</span></td><td class="a360-mono">@c.EnrolledAt.ToString("d")</td><td class="text-end a360-mono">@c.EmailsSent</td><td class="text-end a360-mono">@c.Opens</td><td class="text-end a360-mono">@c.Clicks</td><td class="text-end"><button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Edit campaign" @onclick="() => OpenEditCampaign(c)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" title="Remove campaign" @onclick="() => ConfirmDeleteCampaign(c)"><i class="bi bi-trash" aria-hidden="true"></i></button></td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 11 â”€â”€ TIMELINE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 11)
            {
                    <div class="a360-tab-body">
                        <div class="a360-timeline-full">
                            @foreach (var e in _timelineEvents.OrderByDescending(x => x.OccurredAt))
                            {
                                <div class="a360-tle-item">
                                    <div class="a360-tle-when"><span class="a360-mono">@e.OccurredAt.ToString("d")</span><span class="a360-muted">@e.OccurredAt.ToString("t")</span></div>
                                    <div class="a360-tle-dot @TimelineColor(e.Category)"><i class="bi @TimelineIcon(e.Category)" aria-hidden="true"></i></div>
                                    <div class="a360-tle-body">
                                        <div class="a360-tle-cat">@e.Category</div>
                                        <div class="a360-tle-title">@e.Title</div>
                                        @if (!string.IsNullOrEmpty(e.Detail)) { <p class="a360-tle-detail">@e.Detail</p> }
                                        <div class="a360-tle-by">@e.By</div>
                                    </div>
                                </div>
                            }
                            @if (_timelineEvents.Count == 0) { @AEmpty("bi-clock-history","No timeline events","All account-level events will appear here in chronological order.") }
                        </div>
                    </div>
            }

            <!-- 12 â”€â”€ RELATIONSHIPS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 12)
            {
                    <div class="a360-tab-body">
                        <div class="a360-rel-header">
                            <span class="a360-tab-count">Account relationship map</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenAddRelationship"><i class="bi bi-plus-lg" aria-hidden="true"></i> Link Account</button>
                        </div>
                        <div class="a360-rel-map" aria-label="Account relationship visualization">
                            <div class="a360-rel-node a360-rel-node-root">
                                <span class="a360-rel-avatar @AvatarColor(_acct.AccountName)">@Initials(_acct.AccountName)</span>
                                <strong>@_acct.AccountName</strong>
                                <small>Primary account</small>
                            </div>
                            <div class="a360-rel-branches">
                                @foreach (var r in _relationships)
                                {
                                    <div class="a360-rel-branch">
                                        <span class="a360-rel-line" aria-hidden="true"></span>
                                        <div class="a360-rel-node">
                                            <span class="a360-rel-avatar @AvatarColor(r.RelatedAccount)">@Initials(r.RelatedAccount)</span>
                                            <strong>@r.RelatedAccount</strong>
                                            <small>@r.RelationType</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        @if (_relationships.Count > 0)
                        {
                            <div class="a360-rel-list">
                                @foreach (var r in _relationships)
                                {
                                    <div class="a360-rel-row">
                                        <div class="a360-rel-avatar @AvatarColor(r.RelatedAccount)">@Initials(r.RelatedAccount)</div>
                                        <div class="a360-rel-body">
                                            <div class="a360-rel-name">@r.RelatedAccount</div>
                                            <div class="a360-rel-type">@r.RelationType</div>
                                        </div>
                                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/accounts/{r.RelatedAccountId}")'>
                                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEditRelationship(r)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                        <button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDeleteRelationship(r)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
            }

            <!-- 13 â”€â”€ RISK INSIGHTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
            @if (_tab == 13)
            {
                    <div class="a360-tab-body">
                        <div class="a360-risk-grid">

                            <!-- Renewal risk panel -->
                            <div class="a360-risk-card @RenewalRiskCard(_acct.RenewalRisk)">
                                <div class="a360-risk-card-hdr">
                                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                                    <span>Renewal Risk</span>
                                    <span class="a360-risk-badge @RenewalRiskIcon(_acct.RenewalRisk)">@_acct.RenewalRisk</span>
                                </div>
                                <div class="a360-risk-factors">
                                    @foreach (var f in _renewalRiskFactors)
                                    {
                                        <div class="a360-rf-row">
                                            <i class="bi @(f.Positive ? "bi-check-circle-fill a360-rf--pos" : "bi-exclamation-circle-fill a360-rf--neg")" aria-hidden="true"></i>
                                            <span class="a360-rf-label">@f.Label</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Loss ratio card -->
                            <div class="a360-risk-card">
                                <div class="a360-risk-card-hdr"><i class="bi bi-bar-chart-steps" aria-hidden="true"></i><span>Loss Ratio (3-yr)</span></div>
                                @foreach (var yr in _lossRatioYears)
                                {
                                    <div class="a360-lr-row">
                                        <span class="a360-lr-year">@yr.Year</span>
                                        <div class="a360-lr-track">
                                            <div class="a360-lr-bar @(yr.Ratio > 70 ? "a360-lr--high" : yr.Ratio > 50 ? "a360-lr--mid" : "a360-lr--low")"
                                                 style="width:@Math.Min(yr.Ratio,100)%"></div>
                                        </div>
                                        <span class="a360-lr-val a360-mono @(yr.Ratio > 70 ? "a360-overdue" : "")">@yr.Ratio.ToString("F0")%</span>
                                    </div>
                                }
                            </div>

                            <!-- Claims history card -->
                            <div class="a360-risk-card">
                                <div class="a360-risk-card-hdr"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>Claims History</span></div>
                                <div class="a360-risk-metrics">
                                    @RMetric("Total Claims",    _claimsHistory.TotalClaims.ToString(),     "bi-clipboard")
                                    @RMetric("Open Claims",     _claimsHistory.OpenClaims.ToString(),      "bi-exclamation-circle")
                                    @RMetric("Total Incurred",  _claimsHistory.TotalIncurred.ToString("C0"),"bi-cash-coin")
                                    @RMetric("Avg Claim Size",  _claimsHistory.AvgClaimSize.ToString("C0"), "bi-graph-up")
                                    @RMetric("Largest Claim",   _claimsHistory.LargestClaim.ToString("C0"), "bi-arrow-up-circle")
                                    @RMetric("Yrs Since Loss",  _claimsHistory.YearsSinceLoss.ToString(),  "bi-clock")
                                </div>
                            </div>

                            <!-- Engagement card -->
                            <div class="a360-risk-card">
                                <div class="a360-risk-card-hdr"><i class="bi bi-activity" aria-hidden="true"></i><span>Engagement Score</span></div>
                                <div class="a360-score-wrap">
                                    <div class="a360-score-num" style="color:@ScoreColor(_riskInsight.EngagementScore)">@_riskInsight.EngagementScore</div>
                                    <div class="a360-score-bar-track">
                                        <div class="a360-score-bar-fill" style="width:@_riskInsight.EngagementScore%;background:@ScoreColor(_riskInsight.EngagementScore)"></div>
                                    </div>
                                </div>
                                <div class="a360-risk-metrics">
                                    @RMetric("Portal Logins",   _riskInsight.PortalLogins.ToString(),   "bi-globe")
                                    @RMetric("Emails Opened",   _riskInsight.EmailsOpened.ToString(),   "bi-envelope-open")
                                    @RMetric("Days Since Touch", _riskInsight.DaysSinceTouch.ToString(), "bi-clock")
                                    @RMetric("NPS Score",       _riskInsight.NpsScore?.ToString() ?? "â€”","bi-emoji-smile")
                                </div>
                            </div>

                        </div>
                    </div>
            }
    </div>
    </div>
    </div>
}

<!-- â•â• DIALOGS â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->

<!-- Edit Account -->
@if (_showEdit)
{
<div class="a360-modal-backdrop" role="presentation" @onclick="() => _showEdit = false">
    <div class="a360-modal a360-modal-lg" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
        <div class="um-modal-header">
            <i class="bi bi-building-gear" aria-hidden="true"></i>
            <span>Edit Account</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showEdit = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <EditForm Model="_editForm" OnValidSubmit="SaveAccountAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="um-field">
                        <label>Account Name <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_editForm.AccountName" class="um-input" />
                    </div>
                    <div class="um-field">
                        <label>Account Type <span class="text-danger">*</span></label>
                        <InputSelect @bind-Value="_editForm.AccountTypeCode" class="um-input">
                            @foreach (var option in _accountTypes)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="um-field">
                        <label>Status <span class="text-danger">*</span></label>
                        <InputSelect @bind-Value="_editForm.StatusCode" class="um-input">
                            @foreach (var option in _statusOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="um-field">
                        <label>Segment</label>
                        <InputSelect @bind-Value="_editForm.SegmentCode" class="um-input">
                            <option value="">Select segment</option>
                            @foreach (var option in _segmentOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="um-field">
                        <label>Lifecycle Stage</label>
                        <InputSelect @bind-Value="_editForm.LifecycleStageCode" class="um-input">
                            <option value="">Select stage</option>
                            @foreach (var option in _lifecycleOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="um-field">
                        <label>Industry</label>
                        <InputText @bind-Value="_editForm.Industry" class="um-input" />
                    </div>
                    <div class="um-field">
                        <label>Email</label>
                        <InputText @bind-Value="_editForm.MainEmail" class="um-input" />
                    </div>
                    <div class="um-field">
                        <label>Phone</label>
                        <InputText @bind-Value="_editForm.MainPhone" class="um-input" />
                    </div>
                    <div class="um-field">
                        <label>Website</label>
                        <InputText @bind-Value="_editForm.Website" class="um-input" />
                    </div>
                    <div class="um-field">
                        <label>Annual Revenue</label>
                        <InputNumber @bind-Value="_editForm.AnnualRevenue" class="um-input" />
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showEdit = false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi bi-check-lg" aria-hidden="true"></i> Save Changes</button>
            </div>
        </EditForm>
    </div>
</div>
}

<!-- Add/Edit Contact -->
@if (_showAddContact)
{
<div class="a360-modal-backdrop" role="presentation" @onclick="CloseContactDialog">
    <div class="a360-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
        <div class="um-modal-header">
            <i class="bi bi-person-plus" aria-hidden="true"></i>
            <span>@(_editingContact is null ? "Add Contact" : "Edit Contact")</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseContactDialog"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
