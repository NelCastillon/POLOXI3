    private IEnumerable<UserDto> AccountManagerUsers => UsersInRoles("ACCOUNT_MANAGER", "ACCOUNTMANAGER", "SERVICE_MANAGER", "SERVICEMANAGER");
    private IEnumerable<UserDto> ProducerUsers => UsersInRoles("PRODUCER", "ACCOUNT_PRODUCER", "ACCOUNTPRODUCER");
    private IEnumerable<UserDto> CsrUsers => UsersInRoles("CSR", "SENIOR_CSR", "SENIORCSR");
    private IEnumerable<UserDto> UsersInRoles(params string[] allowedRoles)
    {
        var allowed = allowedRoles.Select(NormalizeUserRole).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return _tenantUsers.Where(user => !user.IsLockedOut && string.Equals(user.StatusCode, "Active", StringComparison.OrdinalIgnoreCase) && UserRoles(user).Any(allowed.Contains)).OrderBy(UserDisplay);
    }
    private static IEnumerable<string> UserRoles(UserDto user) => (user.AssignedRoleCodes ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(NormalizeUserRole);
    private static string NormalizeUserRole(string role) => role.Replace("_", "").Replace("-", "").Replace(" ", "");
    private static string UserDisplay(UserDto user) => string.IsNullOrWhiteSpace(user.DisplayName) ? (string.IsNullOrWhiteSpace(user.FullName) ? user.Email : user.FullName) : user.DisplayName;
    private static bool IsAssignmentRole(AccountServiceAssignmentDto assignment, string role) => string.Equals(assignment.AssignmentRoleCode.Replace("_", "").Replace("-", "").Replace(" ", ""), role.Replace("_", ""), StringComparison.OrdinalIgnoreCase);

