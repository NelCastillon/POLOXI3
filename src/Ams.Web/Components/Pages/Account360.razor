    private static ContactRow MapContact(ContactDto contact) => new()
    {
        ContactId = contact.ContactId,
        FirstName = contact.FirstName,
        LastName = contact.LastName,
        Title = contact.JobTitle,
        Email = contact.Email,
        Phone = contact.Phone,
        IsPrimary = contact.IsKeyContact || contact.IsServiceContact || contact.IsBillingContact
    };

    private async Task LoadDocumentsAsync()
    {
        _documentLoadError = null;

        if (_acct is null)
            return;

        try
        {
            var tenantId = _userContext?.TenantId != Guid.Empty ? _userContext?.TenantId : _acct.TenantId;
            var documents = await Api.GetDocumentsByEntityAsync(tenantId ?? _acct.TenantId, "Account", AccountId) ?? Array.Empty<DocumentDto>();
            _documents = documents.Select(MapDocument).ToList();
        }
        catch (Exception ex)
        {
            _documents = new();
            _documentLoadError = ex.Message;
            await ShowToast($"Document load failed: {ex.Message}", "a360-toast-danger");
        }
    }

    private static DocRow MapDocument(DocumentDto document) => new()
    {
        DocumentId = document.DocumentId,
        FileName = document.FileName,
        Extension = Path.GetExtension(document.FileName),
        Category = string.IsNullOrWhiteSpace(document.CategoryCode) ? "Other" : document.CategoryCode,
        SizeKb = document.FileSizeBytes.HasValue ? Math.Max(1, (int)Math.Ceiling(document.FileSizeBytes.Value / 1024m)) : 0,
        UploadedBy = string.IsNullOrWhiteSpace(document.UploadedByName) ? "System" : document.UploadedByName,
        UploadedAt = document.CreatedDateUtc
    };

    private void BuildRightPanel()
    {
        var daysSinceTouch = _acct?.DaysSinceLastTouch ?? DaysSince(_acct?.LastActivityDate) ?? 0;
        _renewalRiskFactors = new()
        {
            new(DisplayBalancesDue > 0 ? $"Outstanding balance: {DisplayBalancesDue:C0}" : "No outstanding balance", DisplayBalancesDue <= 0),
            new($"Active policies: {DisplayActivePolicies:N0}", DisplayActivePolicies > 0),
            new($"Open claims: {DisplayOpenClaims:N0}", DisplayOpenClaims == 0),
            new($"Open opportunities: {_acct?.OpenOpportunities ?? 0:N0}", (_acct?.OpenOpportunities ?? 0) > 0),
            new(daysSinceTouch > 0 ? $"Days since last touch: {daysSinceTouch:N0}" : "No last-touch date recorded", daysSinceTouch is > 0 and <= 30),
        };
        _lossRatioYears = new();
        _claimsHistory = new ClaimsHistory { TotalClaims = DisplayOpenClaims, OpenClaims = DisplayOpenClaims };
        _riskInsight = new RiskInsight
        {
            EngagementScore = _acct?.EngagementScore ?? 0,
            PortalLogins = _acct?.PortalLogins ?? 0,
            EmailsOpened = 0,
            DaysSinceTouch = daysSinceTouch,
            NpsScore = null
        };
    }

