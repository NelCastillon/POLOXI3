    private static string SubStatusBadge(string s) => s switch { "Quoted"=>"a360-sub a360-sub--quoted","Bound"=>"a360-sub a360-sub--bound","Declined"=>"a360-sub a360-sub--declined",_=>"a360-sub a360-sub--sub" };
    private static string ClaimStatusBadge(string s) => s switch { "Open"=>"a360-cl a360-cl--open","Closed"=>"a360-cl a360-cl--closed","Pending"=>"a360-cl a360-cl--pending",_=>"a360-cl" };
    private static string BillingStatusBadge(string s) => s switch { "Paid"=>"a360-bill a360-bill--paid","Overdue"=>"a360-bill a360-bill--overdue","Pending"=>"a360-bill a360-bill--pending",_=>"a360-bill" };
    private static string CommStatusBadge(string s) => s switch { "Paid"=>"a360-cs a360-cs--paid","Pending"=>"a360-cs a360-cs--pending",_=>"a360-cs" };
    private static string CampStatusBadge(string s) => s switch { "Active"=>"a360-camp a360-camp--active","Completed"=>"a360-camp a360-camp--done","Paused"=>"a360-camp a360-camp--paused",_=>"a360-camp" };
    private static string RenewalRiskCard(string r) => r switch { "High"=>"a360-risk-card--high","Medium"=>"a360-risk-card--mid",_=>"a360-risk-card--low" };
    private static string RenewalRiskIcon(string r) => r switch { "High"=>"a360-ki--red","Medium"=>"a360-ki--amber",_=>"a360-ki--green" };
    private static string ScoreColor(int s) => s >= 70 ? "#16a34a" : s >= 40 ? "#b45309" : "#dc2626";
    private static string ActivityIcon(string t) => t switch { "Call"=>"bi-telephone","Email"=>"bi-envelope","Meeting"=>"bi-calendar3","Note"=>"bi-sticky","Task"=>"bi-check2-square",_=>"bi-lightning" };
    private static string ActivityColor(string t) => t switch { "Call"=>"a360-tl-ic--call","Email"=>"a360-tl-ic--email","Meeting"=>"a360-tl-ic--meeting","Note"=>"a360-tl-ic--note",_=>"a360-tl-ic--other" };
    private static string CommIcon(string c) => c switch { "Email"=>"bi-envelope","Phone"=>"bi-telephone","SMS"=>"bi-chat-dots",_=>"bi-globe" };
    private static string CommColor(string c) => c switch { "Email"=>"a360-comm-ic--email","Phone"=>"a360-comm-ic--phone",_=>"a360-comm-ic--other" };
    private static string DocIcon(string ext) => ext.ToLower() switch { ".pdf"=>"bi-file-earmark-pdf",".docx"=>"bi-file-earmark-word",".xlsx"=>"bi-file-earmark-excel",_=>"bi-file-earmark" };
    private static string TimelineIcon(string cat) => cat switch { "Policy"=>"bi-shield-check","Claim"=>"bi-exclamation-triangle","Billing"=>"bi-receipt","Activity"=>"bi-lightning","Marketing"=>"bi-megaphone","Note"=>"bi-sticky",_=>"bi-circle" };
