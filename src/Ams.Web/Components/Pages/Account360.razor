    private async Task ShowToast(string msg, string css = "e-toast-success")
    {
        var toast = new AccountToast(Guid.NewGuid(), msg, css, css == "e-toast-danger" ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill");
        _toasts.Add(toast);
        await InvokeAsync(StateHasChanged);
        _ = Task.Run(async () =>
        {
            await Task.Delay(4500);
            await InvokeAsync(() => DismissToast(toast.Id));
        });
    }

    private void DismissToast(Guid id)
    {
        _toasts.RemoveAll(t => t.Id == id);
        StateHasChanged();
    }

    private IReadOnlyList<PriorityInsight> BuildPriorityInsights()
    {
        var insights = new List<PriorityInsight>();
        if (DisplayBalancesDue > 0)
            insights.Add(new("Collect balance", $"{DisplayBalancesDue:C0} outstanding across billing records", "bi-receipt", "a360-priority-danger", 5));
        if (DisplayOpenClaims > 0)
            insights.Add(new("Resolve open claims", $"{DisplayOpenClaims:N0} claim(s) require servicing visibility", "bi-exclamation-triangle", "a360-priority-warning", 4));
        if (string.Equals(_acct?.RenewalRisk, "High", StringComparison.OrdinalIgnoreCase) || string.Equals(_acct?.RenewalRisk, "Medium", StringComparison.OrdinalIgnoreCase))
            insights.Add(new("Review renewal risk", $"Renewal risk is {_acct?.RenewalRisk ?? "unscored"}; inspect loss and engagement drivers", "bi-arrow-repeat", "a360-priority-warning", 13));
        if (_submissions.Any(s => s.DueDate.HasValue && s.DueDate.Value.Date <= DateTime.UtcNow.AddDays(7).Date))
            insights.Add(new("Advance submissions", "Carrier response due within 7 days", "bi-send", "a360-priority-info", 3));
        if (DisplayLastActivity is null || DisplayLastActivity < DateTime.UtcNow.AddDays(-14))
            insights.Add(new("Schedule outreach", "No recent activity in the last 14 days", "bi-lightning", "a360-priority-info", 8));
        if (insights.Count == 0)
            insights.Add(new("Account is operating normally", "No critical service, billing, claims, or renewal exceptions detected", "bi-check-circle", "a360-priority-success", 0));
        return insights.Take(4).ToList();
    }

