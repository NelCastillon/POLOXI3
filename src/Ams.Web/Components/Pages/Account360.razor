<!-- Add Contact -->
<SfDialog @bind-Visible="_showAddContact" Width="520px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="a360-dlg-hdr"><i class="bi bi-person-plus" aria-hidden="true"></i> Add Contact</span></Header>
        <Content>
            <div class="a360-dlg-body" style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem">
                <SfTextBox Placeholder="First name *" @bind-Value="_newContact.FirstName" />
                <SfTextBox Placeholder="Last name"    @bind-Value="_newContact.LastName" />
                <SfTextBox Placeholder="Title"        @bind-Value="_newContact.Title" />
                <SfTextBox Placeholder="Email"        @bind-Value="_newContact.Email" />
                <SfTextBox Placeholder="Phone"        @bind-Value="_newContact.Phone" />
                <div style="display:flex;align-items:center"><label class="a360-toggle"><input type="checkbox" @bind="_newContact.IsPrimary" /> Primary</label></div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="a360-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showAddContact = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitAddContactAsync" disabled="@string.IsNullOrEmpty(_newContact.FirstName)"><i class="bi bi-check-lg" aria-hidden="true"></i> Add</button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Log Activity -->
<SfDialog @bind-Visible="_showLogActivity" Width="500px" IsModal="true" ShowCloseIcon="true">
