@page "/accounts/{AccountId:guid}"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Common.Validation
@using Ams.Application.Features.Accounts
@using Ams.Application.Features.Contacts
@using Ams.Application.Features.Submissions
@using Microsoft.AspNetCore.Components.Forms
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject NavigationContextService NavContext
@inject CurrentUserContext UserContext

<PageTitle>@(_acct is null ? "Account" : _acct.AccountName) - 360</PageTitle>

<EnterpriseDocumentUpload @bind-IsOpen="_showDocumentUpload"
                          TenantId="@(_userContext?.TenantId ?? _acct?.TenantId ?? Guid.Empty)"
                          CreatedByUserId="_userContext?.UserId"
                          EntityName="Account"
                          EntityId="AccountId"
                          Title="Upload Account Document"
                          IntroText="Upload and classify account applications, loss runs, financials, policies, and other supporting documents."
                          DefaultDocumentTypeCode="ACCOUNT"
                          DefaultCategoryCode="ACCOUNT"
                          DefaultTags="Account"
                          OnUploaded="HandleAccountDocumentUploadedAsync"
                          OnUploadFailed="HandleAccountDocumentUploadFailed" />

<div class="a360-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="a360-toast @toast.CssClass">
            <i class="bi @toast.Icon" aria-hidden="true"></i>
            <span>@toast.Content</span>
            <button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
    }

</div>

@if (_loading)
{
    <div class="a360-loading"><span class="a360-spinner" aria-hidden="true"></span><span>Loading account?</span></div>
}
else if (_acct is null)
{
    <div class="a360-not-found">
        <i class="bi bi-building-x a360-nf-icon" aria-hidden="true"></i>
        <h2>Account not found</h2>
        <button class="a360-btn a360-btn-ghost" @onclick='() => Nav.NavigateTo("/accounts")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Accounts
        </button>
    </div>
}
else
{
    <div class="a360-enterprise-page">
    <!-- -- HEADER -------------------------------------------------------- -->
    <div class="a360-header">
        <div class="a360-header-left">
            <div class="a360-logo @AvatarColor(_acct.AccountName)">@Initials(_acct.AccountName)</div>
            <div class="a360-header-info">
                <div class="a360-name-row">
                    <h1 class="a360-name">@_acct.AccountName</h1>
                    <span class="a360-account-pill">@_acct.AccountNumber</span>
                    <span class="@StatusBadge(_acct.Status)">@_acct.Status</span>
                    @if (!string.IsNullOrEmpty(_acct.Segment))
                    {
                        <span class="@SegBadge(_acct.Segment)">@_acct.Segment</span>
                    }
                </div>
                <div class="a360-sub-row">
                    <span class="a360-sub-chip"><i class="bi bi-building" aria-hidden="true"></i>@_acct.AccountType</span>
                    <span class="a360-sub-chip"><i class="bi bi-person" aria-hidden="true"></i>@_acct.Owner</span>
                    <span class="a360-sub-chip"><i class="bi bi-people" aria-hidden="true"></i>@_acct.ServicingTeam</span>
                    @if (!string.IsNullOrEmpty(_acct.Industry))
                    {
                        <span class="a360-sub-chip"><i class="bi bi-briefcase" aria-hidden="true"></i>@_acct.Industry</span>
                    }
                </div>
            </div>
        </div>
        <div class="a360-header-actions">
            <button type="button" class="a360-return" @onclick='() => Nav.NavigateTo("/accounts")' title="Back to Accounts" aria-label="Back to Accounts"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
            <button class="a360-btn a360-btn-ghost" @onclick="OpenEditAccount"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
            <button class="a360-btn a360-btn-ghost" @onclick="() => _showNote = true"><i class="bi bi-sticky" aria-hidden="true"></i> Add Note</button>
            <button class="a360-btn a360-btn-ghost" @onclick='() => Nav.NavigateTo($"/premium-finance?accountId={AccountId}")'><i class="bi bi-bank2" aria-hidden="true"></i> Financing</button>
            <button class="a360-btn a360-btn-ghost" @onclick="OpenQuoteWorkflow"><i class="bi bi-file-text" aria-hidden="true"></i> New Quote</button>
            <button class="a360-btn a360-btn-primary" @onclick="OpenOpportunityWorkflow"><i class="bi bi-trophy" aria-hidden="true"></i> New Opportunity</button>
        </div>
    </div>

    <!-- -- HEADLINE KPI CARDS -------------------------------------------- -->
    <div class="a360-kpi-bar">
        @KpiCard("Total Premium",          DisplayTotalPremium.ToString("C0"),    "bi-shield-fill",     "a360-ki--green")
        @KpiCard("Balances Due",           DisplayBalancesDue.ToString("C0"),     "bi-receipt",         DisplayBalancesDue > 0 ? "a360-ki--red" : "a360-ki--green")
        @KpiCard("Renewal Risk",           _acct.RenewalRisk,                    "bi-arrow-repeat",    RenewalRiskIcon(_acct.RenewalRisk))
        @KpiCard("Open Claims",            DisplayOpenClaims.ToString(),          "bi-exclamation-triangle", DisplayOpenClaims > 0 ? "a360-ki--amber" : "a360-ki--green")
        @KpiCard("Active Policies",        DisplayActivePolicies.ToString(),      "bi-shield-check",    "a360-ki--blue")
        @KpiCard("Open Opportunities",     _acct.OpenOpportunities.ToString(),   "bi-trophy",          "a360-ki--purple")
        @KpiCard("YTD Commissions",        DisplayYtdCommissions.ToString("C0"),  "bi-percent",         "a360-ki--blue")
        @KpiCard("Last Activity",          DisplayLastActivity?.ToString("d") ?? "-", "bi-lightning","a360-ki--gray")
    </div>

    <section class="a360-priority-grid" aria-label="Enterprise account priorities">
        @foreach (var insight in PriorityInsights)
        {
            <button type="button" class="a360-priority-card @insight.Tone" @onclick="() => SelectTab(insight.TabIndex)">
                <span class="a360-priority-icon"><i class="bi @insight.Icon" aria-hidden="true"></i></span>
                <span><strong>@insight.Title</strong><small>@insight.Detail</small></span>
                <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
            </button>
        }
    </section>

    <section class="a360-action-strip" aria-label="Account workflow actions">
        <button type="button" class="a360-action-card" @onclick="OpenLogActivity"><i class="bi bi-lightning" aria-hidden="true"></i><span><strong>Log activity</strong><small>Capture service, sales, or renewal touchpoints</small></span></button>
        <button type="button" class="a360-action-card" @onclick="OpenCompose"><i class="bi bi-send" aria-hidden="true"></i><span><strong>Send communication</strong><small>Create email, call, SMS, or portal history</small></span></button>
        <button type="button" class="a360-action-card" @onclick="OpenDocumentUpload"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i><span><strong>Upload document</strong><small>Add loss runs, policies, or financials</small></span></button>
        <button type="button" class="a360-action-card" @onclick="OpenFnol"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span><strong>Start FNOL</strong><small>Open claim intake for account servicing</small></span></button>
    </section>

    <!-- -- 14-TAB BODY --------------------------------------------------- -->
    <div class="a360-detail-shell">
    <div class="a360-native-tabs" role="tablist" aria-label="Account detail sections">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="@TabButtonClass(tab.Index)" role="tab" aria-selected="@(_tab == tab.Index)" @onclick="() => SelectTab(tab.Index)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
            </button>
        }
    </div>
    <div class="a360-native-panels">

            <!-- 0 -- OVERVIEW -------------------------------------------- -->
            @if (_tab == 0)
            {
                    <div class="a360-tab-body">
                        <div class="a360-overview-grid">

                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Account Information</h3>
                                <div class="a360-field-grid">
                                    @F("Account #",      _acct.AccountNumber)
                                    @F("Account Name",   _acct.AccountName)
                                    @F("DBA",            _acct.DbaName)
                                    @F("Type",           _acct.AccountType)
                                    @F("Status",         _acct.Status)
                                    @F("Segment",        _acct.Segment)
                                    @F("Industry",       _acct.Industry)
                                    @F("Employees",      _acct.Employees?.ToString("N0") ?? "-")
                                    @F("Annual Revenue", _acct.AnnualRevenue?.ToString("C0") ?? "-")
                                    @F("Website",        _acct.Website)
                                    @F("Tax ID / EIN",   _acct.TaxId)
                                    @F("NAICS Code",     _acct.NaicsCode)
                                    @F("Lifecycle Stage",_acct.LifecycleStage)
                                    @F("Created",        _acct.CreatedAt.ToString("d"))
                                    @F("Last Modified",  _acct.ModifiedAt?.ToString("d") ?? "-")
                                </div>
                            </div>
                        <div class="a360-overview-grid">
                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Named Insured Hierarchy</h3>
                                @if (_account360?.NamedInsureds.Count > 0)
                                {
                                    @foreach (var insured in _account360.NamedInsureds)
                                    {
                                        <div class="a360-rel-row"><div class="a360-rel-body"><div class="a360-rel-name">@insured.LegalName</div><div class="a360-rel-type">@OptionName("InsuredRelationship", insured.RelationshipCode) · @OptionName("InsuredType", insured.InsuredTypeCode) @(insured.IsPrimary ? "· Primary" : string.Empty)</div></div></div>
                                    }
                                }
                                else { @AEmpty("bi-person-vcard", "No named insureds", "Add customer-level insured entities before marketing or binding.") }
                            </div>
                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Owners & Officers</h3>
                                @if (_account360?.Stakeholders.Count > 0)
                                {
                                    @foreach (var stakeholder in _account360.Stakeholders)
                                    {
                                        <div class="a360-rel-row"><div class="a360-rel-body"><div class="a360-rel-name">@stakeholder.ContactName</div><div class="a360-rel-type">@OptionName("StakeholderRole", stakeholder.StakeholderRoleCode) @(stakeholder.OwnershipPercentage.HasValue ? $"· {stakeholder.OwnershipPercentage:0.##}%" : string.Empty)</div></div></div>
                                    }
                                }
                                else { @AEmpty("bi-person-badge", "No owners or officers", "Link account contacts to ownership and officer roles.") }
                            </div>
                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Communication Preferences</h3>
                                @if (_account360?.CommunicationPreferences.Count > 0)
                                {
                                    @foreach (var preference in _account360.CommunicationPreferences)
                                    {
                                        <div class="a360-rel-row"><div class="a360-rel-body"><div class="a360-rel-name">@OptionName("CommunicationPurpose", preference.CommunicationPurposeCode)</div><div class="a360-rel-type">@OptionName("CommunicationChannel", preference.ChannelCode) · @OptionName("PreferenceStatus", preference.PreferenceStatusCode) @(string.IsNullOrWhiteSpace(preference.ContactName) ? "· Account-wide" : $"· {preference.ContactName}")</div></div></div>
                                    }
                                }
                                else { @AEmpty("bi-chat-square-heart", "No communication preferences", "Record consent and channel preferences for service, billing, claims, marketing, and renewals.") }
                            </div>
                            <div class="a360-info-card">
                                <div class="d-flex align-items-center justify-content-between gap-2 mb-2"><h3 class="a360-section-hdr mb-0">Service Assignments</h3><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="OpenServiceAssignmentsAsync"><i class="bi bi-person-gear" aria-hidden="true"></i> Manage</button></div>
                                @if (_account360?.ServiceAssignments.Count > 0)
                                {
                                    @foreach (var assignment in _account360.ServiceAssignments)
                                    {
                                        <div class="a360-rel-row"><div class="a360-rel-body"><div class="a360-rel-name">@assignment.UserName</div><div class="a360-rel-type">@OptionName("ServiceAssignmentRole", assignment.AssignmentRoleCode) @(assignment.IsPrimary ? "· Primary" : string.Empty)</div></div></div>
                                    }
                                }
                                else { @AEmpty("bi-people-fill", "No service assignments", "Assign producers, CSRs, account managers, claims advocates, and billing specialists.") }
                            </div>
                        </div>
                        <div class="a360-info-card">
                            <h3 class="a360-section-hdr">Exposure Inventory</h3>
                            <div class="a360-risk-metrics">
                                @RMetric("Locations", (_account360?.Metrics.LocationCount ?? 0).ToString(), "bi-geo-alt")
                                @RMetric("Properties", (_account360?.Metrics.PropertyCount ?? 0).ToString(), "bi-buildings")
                                @RMetric("Vehicles", (_account360?.Metrics.VehicleCount ?? 0).ToString(), "bi-truck")
                                @RMetric("Drivers", (_account360?.Metrics.DriverCount ?? 0).ToString(), "bi-person-vcard")
                                @RMetric("Scheduled Items", (_account360?.Metrics.ScheduleItemCount ?? 0).ToString(), "bi-list-check")
                                @RMetric("Scheduled Value", (_account360?.Metrics.TotalScheduledValue ?? 0).ToString("C0"), "bi-cash-stack")
                                @RMetric("Open Tasks", (_account360?.Metrics.OpenTaskCount ?? 0).ToString(), "bi-check2-square")
                                @RMetric("Shared Documents", (_account360?.Metrics.DocumentCount ?? 0).ToString(), "bi-folder2-open")
                            </div>
                        </div>

                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Service Team</h3>
                                <div class="a360-field-grid">
                                    @F("Account Owner",    _acct.Owner)
                                    @F("Servicing Team",   _acct.ServicingTeam)
                                    @F("CSR",              _acct.CsrName ?? "?")
                                    @F("Producer",         _acct.ProducerName ?? "?")
                                    @F("Account Manager",  _acct.AccountManager ?? "?")
                                </div>
                            </div>

                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Contact Information</h3>
                                <div class="a360-field-grid">
                                    @F("Primary Email", _acct.Email)
                                    @F("Phone",         _acct.Phone)
                                    @F("Street",        _acct.Street)
                                    @F("City",          _acct.City)
                                    @F("State",         _acct.State)
                                    @F("ZIP",           _acct.Zip)
                                    @F("Country",       _acct.Country)
                                </div>
                            </div>

                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Financial Summary</h3>
                                <div class="a360-field-grid">
                                    @F("Total Premium",       _acct.TotalPremium.ToString("C0"))
                                    @F("Balances Due",        _acct.BalancesDue.ToString("C0"))
                                    @F("YTD Commissions",     _acct.YtdCommissions.ToString("C0"))
                                    @F("Active Policies",     _acct.ActivePolicies.ToString())
                                    @F("Open Claims",         _acct.OpenClaims.ToString())
                                    @F("Renewal Risk",        _acct.RenewalRisk)
                                    @F("Open Opportunities",  _acct.OpenOpportunities.ToString())
                                </div>
                            </div>

                        </div>
                        @if (!string.IsNullOrEmpty(_acct.Notes))
                        {
                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Notes</h3>
                                <p class="a360-notes">@_acct.Notes</p>
                            </div>
                        }
            @if (_tab == 14 && _account360 is not null)
            {
                <Account360RiskProfile Data="_account360" ResolveOptionName="OptionName" />
            }
                    </div>
            }

            <!-- 1 -- CONTACTS -------------------------------------------- -->
            @if (_tab == 1)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_contacts.Count contact(s)</span>
                            <button class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="OpenAddContact"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Contact</button>
                        </div>
                        @if (_contacts.Count == 0) { @AEmpty("bi-people","No contacts","Add the key contacts for this account.") }
                        else
                        {
                            <div class="a360-contact-grid">
                                @foreach (var c in _contacts)
                                {
                                    <div class="a360-contact-card">
                                        <div class="a360-contact-avatar @AvatarColor(c.FullName)">@Initials(c.FullName)</div>
                                        <div class="a360-contact-body">
                                            <div class="a360-contact-name">@c.FullName</div>
                                            <div class="a360-contact-title">@c.Title</div>
                                            <div class="a360-contact-links">
                                                @if (!string.IsNullOrEmpty(c.Email)) { <a href="mailto:@c.Email" class="a360-contact-link"><i class="bi bi-envelope" aria-hidden="true"></i> @c.Email</a> }
                                                @if (!string.IsNullOrEmpty(c.Phone)) { <span class="a360-contact-link"><i class="bi bi-telephone" aria-hidden="true"></i> @c.Phone</span> }
                                            </div>
                                        </div>
                                        @if (c.IsPrimary) { <span class="a360-primary-badge">Primary</span> }
                                        <div class="a360-card-actions">
                                            <button type="button" class="a360-btn a360-btn-ghost a360-btn-sm" title="Edit contact" @onclick="() => OpenEditContact(c)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                            <button type="button" class="a360-btn a360-btn-ghost a360-btn-sm a360-text-danger" title="Delete contact" @onclick="() => ConfirmDeleteContact(c)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
            }

            <!-- 2 -- POLICIES -------------------------------------------- -->
            @if (_tab == 2)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_policies.Count polic@(_policies.Count == 1 ? "y" : "ies")</span>
                            <button class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="OpenAddExistingPolicy"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Existing Policy</button>
                        </div>
                        @if (_policies.Count == 0) { @AEmpty("bi-shield","No policies","Policies appear after carrier-confirmed bind requests or existing policy entry.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>Policy #</th><th>Line</th><th>Carrier</th><th class="text-end">Premium</th><th>Status</th><th>Effective</th><th>Expiration</th><th class="text-end">Actions</th></tr></thead>
                                    <tbody>
                                        @foreach (var p in _policies.OrderByDescending(x => x.Premium))
                                        {
                                            <tr>
                                                <td data-label="Policy #" class="a360-mono a360-bold">@p.PolicyNumber</td><td data-label="Line">@p.LineOfBusiness</td><td data-label="Carrier">@p.Carrier</td><td data-label="Premium" class="text-end a360-mono a360-bold">@p.Premium.ToString("C0")</td><td data-label="Status"><span class="@PolicyStatusBadge(p.Status)">@p.Status</span></td><td data-label="Effective" class="a360-mono">@p.EffectiveDate.ToString("d")</td><td data-label="Expiration" class="a360-mono @(p.ExpirationDate < DateTime.UtcNow.AddDays(30) && p.Status == "Active" ? "a360-due-soon" : "")">@p.ExpirationDate.ToString("d")</td><td data-label="Actions" class="text-end"><button class="a360-btn a360-btn-ghost a360-btn-sm" @onclick='() => Nav.NavigateTo($"/policies/{p.PolicyId}")'><i class="bi bi-arrow-right" aria-hidden="true"></i></button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 3 -- SUBMISSIONS ----------------------------------------- -->
            @if (_tab == 3)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_submissions.Count submission(s)</span>
                            <button class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="OpenAddSubmission"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Submission</button>
                        </div>
                        @if (_submissions.Count == 0) { @AEmpty("bi-send","No submissions","Create carrier submissions for this account's lines.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>Sub #</th><th>Line</th><th>Carrier</th><th>Status</th><th>Submitted</th><th>Due</th><th>Notes</th><th class="text-end">Actions</th></tr></thead>
                                    <tbody>
                                        @foreach (var s in _submissions.OrderByDescending(x => x.SubmittedAt))
                                        {
                                            <tr><td data-label="Sub #" class="a360-mono a360-bold">@s.SubmissionNumber</td><td data-label="Line">@s.LineOfBusiness</td><td data-label="Carrier">@s.Carrier</td><td data-label="Status"><span class="@SubStatusBadge(s.Status)">@s.Status</span></td><td data-label="Submitted" class="a360-mono">@s.SubmittedAt.ToString("d")</td><td data-label="Due" class="a360-mono @(s.DueDate.HasValue && s.DueDate < DateTime.UtcNow ? "a360-overdue" : "")">@(s.DueDate?.ToString("d") ?? "-")</td><td data-label="Notes">@s.Notes</td><td data-label="Actions" class="text-end"><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm" title="Edit submission" @onclick="() => OpenEditSubmission(s)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm a360-text-danger" title="Delete submission" @onclick="() => ConfirmDeleteSubmission(s)"><i class="bi bi-trash" aria-hidden="true"></i></button></td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 4 -- CLAIMS -------------------------------------------- -->
            @if (_tab == 4)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_claims.Count claim(s)</span>
                            <button class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="OpenFnol"><i class="bi bi-plus-lg" aria-hidden="true"></i> FNOL</button>
                        </div>
                        @if (_claims.Count == 0) { @AEmpty("bi-exclamation-triangle","No claims","First notice of loss will appear here.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>Claim #</th><th>Line</th><th>Loss Date</th><th>Status</th><th class="text-end">Reserve</th><th class="text-end">Paid</th><th>Adjuster</th><th class="text-end">Actions</th></tr></thead>
                                    <tbody>
                                        @foreach (var c in _claims.OrderByDescending(x => x.LossDate))
                                        {
                                            <tr><td data-label="Claim #" class="a360-mono a360-bold">@c.ClaimNumber</td><td data-label="Line">@c.LineOfBusiness</td><td data-label="Loss Date" class="a360-mono">@c.LossDate.ToString("d")</td><td data-label="Status"><span class="@ClaimStatusBadge(c.Status)">@c.Status</span></td><td data-label="Reserve" class="text-end a360-mono a360-bold">@c.ReserveAmount.ToString("C0")</td><td data-label="Paid" class="text-end a360-mono">@c.PaidAmount.ToString("C0")</td><td data-label="Adjuster">@c.Adjuster</td><td data-label="Actions" class="text-end"><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm" title="Edit claim" @onclick="() => OpenEditClaim(c)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm a360-text-danger" title="Delete claim" @onclick="() => ConfirmDeleteClaim(c)"><i class="bi bi-trash" aria-hidden="true"></i></button></td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 5 -- BILLING --------------------------------------------- -->
            @if (_tab == 5)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_billing.Count invoice(s)</span>
                        </div>
                        @if (_billing.Count == 0) { @AEmpty("bi-receipt","No billing records","Invoices and installments will appear here.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>Invoice #</th><th>Policy #</th><th class="text-end">Amount</th><th class="text-end">Balance</th><th>Status</th><th>Due</th><th>Method</th></tr></thead>
                                    <tbody>
                                        @foreach (var b in _billing.OrderBy(x => x.DueDate))
                                        {
                                            <tr><td data-label="Invoice #" class="a360-mono a360-bold">@b.InvoiceNumber</td><td data-label="Policy #" class="a360-mono">@b.PolicyNumber</td><td data-label="Amount" class="text-end a360-mono a360-bold">@b.Amount.ToString("C0")</td><td data-label="Balance" class="text-end a360-mono @(b.Balance > 0 ? "a360-overdue" : "")">@b.Balance.ToString("C0")</td><td data-label="Status"><span class="@BillingStatusBadge(b.Status)">@b.Status</span></td><td data-label="Due" class="a360-mono @(b.DueDate < DateTime.UtcNow && b.Status != "Paid" ? "a360-overdue" : "")">@b.DueDate.ToString("d")</td><td data-label="Method">@b.PaymentMethod</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 6 -- COMMISSIONS ----------------------------------------- -->
            @if (_tab == 6)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_commissions.Count commission record(s)</span>
                        </div>
                        @if (_commissions.Count == 0) { @AEmpty("bi-percent","No commission records","Commission history will appear here.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>Policy #</th><th>Line</th><th class="text-end">Premium</th><th class="text-end">Rate</th><th class="text-end">Commission</th><th>Status</th><th>Paid Date</th><th>Producer</th></tr></thead>
                                    <tbody>
                                        @foreach (var c in _commissions.OrderByDescending(x => x.CommissionAmount))
                                        {
                                            <tr><td data-label="Policy #" class="a360-mono a360-bold">@c.PolicyNumber</td><td data-label="Line">@c.LineOfBusiness</td><td data-label="Premium" class="text-end a360-mono a360-bold">@c.GrossPremium.ToString("C0")</td><td data-label="Rate" class="text-end a360-mono">@c.CommissionRate.ToString("F1")%</td><td data-label="Commission" class="text-end a360-mono a360-bold">@c.CommissionAmount.ToString("C0")</td><td data-label="Status"><span class="@CommStatusBadge(c.Status)">@c.Status</span></td><td data-label="Paid Date" class="a360-mono">@(c.PaidDate?.ToString("d") ?? "-")</td><td data-label="Producer">@c.Producer</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 7 -- DOCUMENTS ------------------------------------------- -->
            @if (_tab == 7)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_documents.Count document(s)</span>
                            <button class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="OpenDocumentUpload"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Upload</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_documentLoadError))
                        {
                            <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">Document load failed: @_documentLoadError</div>
                        }
                        @if (_documents.Count == 0) { @AEmpty("bi-folder2","No documents","Upload loss runs, financials, policy documents or correspondence.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>File</th><th>Category</th><th class="text-end">Size</th><th>Uploaded By</th><th>Date</th><th class="text-end">Actions</th></tr></thead>
                                    <tbody>
                                        @foreach (var d in _documents.OrderByDescending(x => x.UploadedAt))
                                        {
                                            <tr><td data-label="File"><span class="a360-doc-name"><i class="bi @DocIcon(d.Extension)" aria-hidden="true"></i> @d.FileName</span></td><td data-label="Category">@d.Category</td><td data-label="Size" class="text-end a360-mono">@d.SizeKb KB</td><td data-label="Uploaded By">@d.UploadedBy</td><td data-label="Date" class="a360-mono">@d.UploadedAt.ToString("d")</td><td data-label="Actions" class="text-end"><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm" title="Download" @onclick="() => DownloadDocumentAsync(d)"><i class="bi bi-download" aria-hidden="true"></i></button><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm a360-text-danger" title="Delete document" @onclick="() => ConfirmDeleteDocument(d)"><i class="bi bi-trash" aria-hidden="true"></i></button></td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 8 -- ACTIVITIES ------------------------------------------ -->
            @if (_tab == 8)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_activities.Count activit@(_activities.Count == 1 ? "y" : "ies")</span>
                            <button class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="OpenLogActivity"><i class="bi bi-plus-lg" aria-hidden="true"></i> Log</button>
                        </div>
                        @if (_activities.Count == 0) { @AEmpty("bi-lightning","No activities","Log calls, emails and meetings linked to this account.") }
                        else
                        {
                            <div class="a360-timeline">
                                @foreach (var a in _activities.OrderByDescending(x => x.OccurredAt))
                                {
                                    <div class="a360-tl-item">
                                        <div class="a360-tl-icon @ActivityColor(a.Type)"><i class="bi @ActivityIcon(a.Type)" aria-hidden="true"></i></div>
                                        <div class="a360-tl-body">
                                            <div class="a360-tl-hdr">
                                                <span class="a360-tl-type">@a.Type</span>
                                                <span class="a360-tl-by">@a.By</span>
                                                <span class="a360-mono a360-muted">@a.OccurredAt.ToString("g")</span>
                                            </div>
                                            <div class="a360-tl-subject">@a.Subject</div>
                                            @if (!string.IsNullOrEmpty(a.Notes)) { <p class="a360-tl-notes">@a.Notes</p> }
                                            <div class="a360-inline-actions"><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="() => OpenEditActivity(a)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm a360-text-danger" @onclick="() => ConfirmDeleteActivity(a)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
            }

            <!-- 9 -- COMMUNICATIONS -------------------------------------- -->
            @if (_tab == 9)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_comms.Count message(s)</span>
                            <button class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="OpenCompose"><i class="bi bi-plus-lg" aria-hidden="true"></i> New</button>
                        </div>
                        @if (_comms.Count == 0) { @AEmpty("bi-chat-dots","No communications","Log emails, calls or SMS sent to this account.") }
                        else
                        {
                            <div class="a360-comms-list">
                                @foreach (var m in _comms.OrderByDescending(x => x.SentAt))
                                {
                                    <div class="a360-comm-row">
                                        <div class="a360-comm-icon @CommColor(m.Channel)"><i class="bi @CommIcon(m.Channel)" aria-hidden="true"></i></div>
                                        <div class="a360-comm-body">
                                            <div class="a360-comm-hdr">
                                                <span class="a360-comm-subject">@m.Subject</span>
                                                <span class="a360-comm-channel">@m.Channel</span>
                                                <span class="a360-mono a360-muted">@m.SentAt.ToString("g")</span>
                                            </div>
                                            <div class="a360-comm-preview">@m.Preview</div>
                                            <div class="a360-comm-meta"><span>By @m.SentBy</span>@if (m.Opened) { <span class="a360-comm-opened"><i class="bi bi-check2-all" aria-hidden="true"></i> Opened</span> }</div>
                                            <div class="a360-inline-actions"><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="() => OpenEditCommunication(m)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="() => MarkCommunicationOpenedAsync(m)"><i class="bi bi-check2-all" aria-hidden="true"></i> Mark Opened</button><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm a360-text-danger" @onclick="() => ConfirmDeleteCommunication(m)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
            }

            <!-- 10 -- MARKETING ------------------------------------------ -->
            @if (_tab == 10)
            {
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_campaigns.Count enrollment(s)</span>
                            <button class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="OpenCampaign"><i class="bi bi-plus-lg" aria-hidden="true"></i> Enroll</button>
                        </div>
                        @if (_campaigns.Count == 0) { @AEmpty("bi-megaphone","No campaign enrollments","Enroll this account in renewal or cross-sell campaigns.") }
                        else
                        {
                            <div class="a360-native-table-wrap">
                                <table class="a360-native-table">
                                    <thead><tr><th>Campaign</th><th>Status</th><th>Enrolled</th><th class="text-end">Sent</th><th class="text-end">Opens</th><th class="text-end">Clicks</th><th class="text-end">Actions</th></tr></thead>
                                    <tbody>
                                        @foreach (var c in _campaigns.OrderByDescending(x => x.EnrolledAt))
                                        {
                                            <tr><td data-label="Campaign">@c.CampaignName</td><td data-label="Status"><span class="@CampStatusBadge(c.Status)">@c.Status</span></td><td data-label="Enrolled" class="a360-mono">@c.EnrolledAt.ToString("d")</td><td data-label="Sent" class="text-end a360-mono">@c.EmailsSent</td><td data-label="Opens" class="text-end a360-mono">@c.Opens</td><td data-label="Clicks" class="text-end a360-mono">@c.Clicks</td><td data-label="Actions" class="text-end"><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm" title="Edit campaign" @onclick="() => OpenEditCampaign(c)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="a360-btn a360-btn-ghost a360-btn-sm a360-text-danger" title="Remove campaign" @onclick="() => ConfirmDeleteCampaign(c)"><i class="bi bi-trash" aria-hidden="true"></i></button></td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
            }

            <!-- 11 -- TIMELINE ------------------------------------------- -->
            @if (_tab == 11)
            {
                    <div class="a360-tab-body">
                        <div class="a360-timeline-full">
                            @foreach (var e in _timelineEvents.OrderByDescending(x => x.OccurredAt))
                            {
                                <div class="a360-tle-item">
                                    <div class="a360-tle-when"><span class="a360-mono">@e.OccurredAt.ToString("d")</span><span class="a360-muted">@e.OccurredAt.ToString("t")</span></div>
                                    <div class="a360-tle-dot @TimelineColor(e.Category)"><i class="bi @TimelineIcon(e.Category)" aria-hidden="true"></i></div>
                                    <div class="a360-tle-body">
                                        <div class="a360-tle-cat">@e.Category</div>
                                        <div class="a360-tle-title">@e.Title</div>
                                        @if (!string.IsNullOrEmpty(e.Detail)) { <p class="a360-tle-detail">@e.Detail</p> }
                                        <div class="a360-tle-by">@e.By</div>
                                    </div>
                                </div>
                            }
                            @if (_timelineEvents.Count == 0) { @AEmpty("bi-clock-history","No timeline events","All account-level events will appear here in chronological order.") }
                        </div>
                    </div>
            }

            <!-- 12 -- RELATIONSHIPS --------------------------------------- -->
            @if (_tab == 12)
            {
                    <div class="a360-tab-body">
                        <div class="a360-rel-header">
                            <span class="a360-tab-count">Account relationship map</span>
                            <button class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="OpenAddRelationship"><i class="bi bi-plus-lg" aria-hidden="true"></i> Link Account</button>
                        </div>
                        <div class="a360-rel-map" aria-label="Account relationship visualization">
                            <div class="a360-rel-node a360-rel-node-root">
                                <span class="a360-rel-avatar @AvatarColor(_acct.AccountName)">@Initials(_acct.AccountName)</span>
                                <strong>@_acct.AccountName</strong>
                                <small>Primary account</small>
                            </div>
                            <div class="a360-rel-branches">
                                @foreach (var r in _relationships)
                                {
                                    <div class="a360-rel-branch">
                                        <span class="a360-rel-line" aria-hidden="true"></span>
                                        <div class="a360-rel-node">
                                            <span class="a360-rel-avatar @AvatarColor(r.RelatedAccount)">@Initials(r.RelatedAccount)</span>
                                            <strong>@r.RelatedAccount</strong>
                                            <small>@r.RelationType</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        @if (_relationships.Count > 0)
                        {
                            <div class="a360-rel-list">
                                @foreach (var r in _relationships)
                                {
                                    <div class="a360-rel-row">
                                        <div class="a360-rel-avatar @AvatarColor(r.RelatedAccount)">@Initials(r.RelatedAccount)</div>
                                        <div class="a360-rel-body">
                                            <div class="a360-rel-name">@r.RelatedAccount</div>
                                            <div class="a360-rel-type">@r.RelationType</div>
                                        </div>
                                        <button class="a360-btn a360-btn-ghost a360-btn-sm" @onclick='() => Nav.NavigateTo($"/accounts/{r.RelatedAccountId}")'>
                                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="a360-btn a360-btn-ghost a360-btn-sm" @onclick="() => OpenEditRelationship(r)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                        <button type="button" class="a360-btn a360-btn-ghost a360-btn-sm a360-text-danger" @onclick="() => ConfirmDeleteRelationship(r)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
            }

            <!-- 13 -- RISK INSIGHTS ---------------------------------------- -->
            @if (_tab == 13)
            {
                    <div class="a360-tab-body">
                        <div class="a360-risk-grid">

                            <!-- Renewal risk panel -->
                            <div class="a360-risk-card @RenewalRiskCard(_acct.RenewalRisk)">
                                <div class="a360-risk-card-hdr">
                                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                                    <span>Renewal Risk</span>
                                    <span class="a360-risk-badge @RenewalRiskIcon(_acct.RenewalRisk)">@_acct.RenewalRisk</span>
                                </div>
                                <div class="a360-risk-factors">
                                    @foreach (var f in _renewalRiskFactors)
                                    {
                                        <div class="a360-rf-row">
                                            <i class="bi @(f.Positive ? "bi-check-circle-fill a360-rf--pos" : "bi-exclamation-circle-fill a360-rf--neg")" aria-hidden="true"></i>
                                            <span class="a360-rf-label">@f.Label</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Loss ratio card -->
                            <div class="a360-risk-card">
                                <div class="a360-risk-card-hdr"><i class="bi bi-bar-chart-steps" aria-hidden="true"></i><span>Loss Ratio (3-yr)</span></div>
                                @foreach (var yr in _lossRatioYears)
                                {
                                    <div class="a360-lr-row">
                                        <span class="a360-lr-year">@yr.Year</span>
                                        <div class="a360-lr-track">
                                            <div class="a360-lr-bar @(yr.Ratio > 70 ? "a360-lr--high" : yr.Ratio > 50 ? "a360-lr--mid" : "a360-lr--low")"
                                                 style="width:@Math.Min(yr.Ratio,100)%"></div>
                                        </div>
                                        <span class="a360-lr-val a360-mono @(yr.Ratio > 70 ? "a360-overdue" : "")">@yr.Ratio.ToString("F0")%</span>
                                    </div>
                                }
                            </div>

                            <!-- Claims history card -->
                            <div class="a360-risk-card">
                                <div class="a360-risk-card-hdr"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>Claims History</span></div>
                                <div class="a360-risk-metrics">
                                    @RMetric("Total Claims",    _claimsHistory.TotalClaims.ToString(),     "bi-clipboard")
                                    @RMetric("Open Claims",     _claimsHistory.OpenClaims.ToString(),      "bi-exclamation-circle")
                                    @RMetric("Total Incurred",  _claimsHistory.TotalIncurred.ToString("C0"),"bi-cash-coin")
                                    @RMetric("Avg Claim Size",  _claimsHistory.AvgClaimSize.ToString("C0"), "bi-graph-up")
                                    @RMetric("Largest Claim",   _claimsHistory.LargestClaim.ToString("C0"), "bi-arrow-up-circle")
                                    @RMetric("Yrs Since Loss",  _claimsHistory.YearsSinceLoss.ToString(),  "bi-clock")
                                </div>
                            </div>

                            <!-- Engagement card -->
                            <div class="a360-risk-card">
                                <div class="a360-risk-card-hdr"><i class="bi bi-activity" aria-hidden="true"></i><span>Engagement Score</span></div>
                                <div class="a360-score-wrap">
                                    <div class="a360-score-num" style="color:@ScoreColor(_riskInsight.EngagementScore)">@_riskInsight.EngagementScore</div>
                                    <div class="a360-score-bar-track">
                                        <div class="a360-score-bar-fill" style="width:@_riskInsight.EngagementScore%;background:@ScoreColor(_riskInsight.EngagementScore)"></div>
                                    </div>
                                </div>
                                <div class="a360-risk-metrics">
                                    @RMetric("Portal Logins",   _riskInsight.PortalLogins.ToString(),   "bi-globe")
                                    @RMetric("Emails Opened",   _riskInsight.EmailsOpened.ToString(),   "bi-envelope-open")
                                    @RMetric("Days Since Touch", _riskInsight.DaysSinceTouch.ToString(), "bi-clock")
                                    @RMetric("NPS Score",       _riskInsight.NpsScore?.ToString() ?? "?","bi-emoji-smile")
                                </div>
                            </div>

                        </div>
                    </div>
            }
    </div>
    </div>
    </div>
}

<!-- -- DIALOGS ---------------------------------------------------------------- -->
<!-- Edit Account -->
@if (_showEdit)
{
<div class="a360-modal-backdrop" role="presentation" @onclick="() => _showEdit = false">
    <div class="a360-modal a360-modal-lg" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
        <div class="a360-modal-header">
            <i class="bi bi-building-gear" aria-hidden="true"></i>
            <span>Edit Account</span>
            <button type="button" class="a360-btn a360-btn-ghost a360-btn-sm a360-ms-auto" @onclick="() => _showEdit = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <EditForm Model="_editForm" OnValidSubmit="SaveAccountAsync">
            <DataAnnotationsValidator />
            <div class="a360-modal-body">
                <div class="a360-form-grid">
                    <div class="a360-field">
                        <label>Account Name <span class="a360-text-danger">*</span></label>
                        <InputText @bind-Value="_editForm.AccountName" class="a360-input" />
                    </div>
                    <div class="a360-field">
                        <label>Account Type <span class="a360-text-danger">*</span></label>
                        <InputSelect @bind-Value="_editForm.AccountTypeCode" class="a360-input">
                            @foreach (var option in _accountTypes)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="a360-field">
                        <label>Status <span class="a360-text-danger">*</span></label>
                        <InputSelect @bind-Value="_editForm.StatusCode" class="a360-input">
                            @foreach (var option in _statusOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="a360-field">
                        <label>Segment</label>
                        <InputSelect @bind-Value="_editForm.SegmentCode" class="a360-input">
                            <option value="">Select segment</option>
                            @foreach (var option in _segmentOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="a360-field">
                        <label>Lifecycle Stage</label>
                        <InputSelect @bind-Value="_editForm.LifecycleStageCode" class="a360-input">
                            <option value="">Select stage</option>
                            @foreach (var option in _lifecycleOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="a360-field">
                        <label>Industry</label>
                        <InputText @bind-Value="_editForm.Industry" class="a360-input" />
                    </div>
                    <div class="a360-field">
                        <label>Email</label>
                        <InputText @bind-Value="_editForm.MainEmail" class="a360-input" />
                    </div>
                    <div class="a360-field">
                        <label>Phone</label>
                        <InputText @bind-Value="_editForm.MainPhone" class="a360-input" />
                    </div>
                    <div class="a360-field">
                        <label>Website</label>
                        <InputText @bind-Value="_editForm.Website" class="a360-input" />
                    </div>
                    <div class="a360-field">
                        <label>Annual Revenue</label>
                        <InputNumber @bind-Value="_editForm.AnnualRevenue" class="a360-input" />
                    </div>
                </div>
            </div>
            <div class="a360-modal-footer">
                <button type="button" class="a360-btn a360-btn-ghost" @onclick="() => _showEdit = false">Cancel</button>
                <button type="submit" class="a360-btn a360-btn-primary" disabled="@_saving"><i class="bi bi-check-lg" aria-hidden="true"></i> Save Changes</button>
            </div>
        </EditForm>
    </div>
</div>
}

@if (_showServiceAssignments)
{
<div class="a360-modal-backdrop" role="presentation" @onclick="CloseServiceAssignments">
    <div class="a360-modal" role="dialog" aria-modal="true" aria-labelledby="service-assignment-title" @onclick:stopPropagation="true">
        <div class="a360-modal-header">
            <i class="bi bi-people-fill" aria-hidden="true"></i>
            <span id="service-assignment-title">Manage Service Assignments</span>
            <button type="button" class="a360-btn a360-btn-ghost a360-btn-sm a360-ms-auto" @onclick="CloseServiceAssignments" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <EditForm Model="_serviceAssignmentForm" OnValidSubmit="SaveServiceAssignmentsAsync">
            <div class="a360-modal-body">
                <p class="text-muted">These database-backed assignments drive account servicing and endorsement fallback routing.</p>
                <div class="a360-form-grid">
                    <div class="a360-field"><label>Primary Account Manager</label><InputSelect @bind-Value="_serviceAssignmentForm.AccountManagerUserId" class="a360-input"><option value="">Unassigned</option>@foreach(var user in AccountManagerUsers){<option value="@user.UserId">@UserDisplay(user)</option>}</InputSelect></div>
