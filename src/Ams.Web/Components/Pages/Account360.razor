                <SfTextBox Placeholder="Subject *" @bind-Value="_newAct.Subject" />
                <SfTextBox Placeholder="Notes" @bind-Value="_newAct.Notes" Multiline="true" HtmlAttributes="@(new Dictionary<string,object>{{"rows","3"}})" />
