    private string OptionName(string group, string code) => _account360?.ReferenceOptions.FirstOrDefault(option => string.Equals(option.OptionGroup, group, StringComparison.OrdinalIgnoreCase) && string.Equals(option.OptionCode, code, StringComparison.OrdinalIgnoreCase))?.OptionName ?? code;
