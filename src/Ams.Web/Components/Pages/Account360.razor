        <Content>
            <div class="a360-dlg-body" style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem">
                <SfTextBox Placeholder="Line of business *" @bind-Value="_newSub.LineOfBusiness" />
                <SfTextBox Placeholder="Carrier *"          @bind-Value="_newSub.Carrier" />
                <SfDatePicker TValue="DateTime?" Placeholder="Due date" @bind-Value="_newSub.DueDate" />
