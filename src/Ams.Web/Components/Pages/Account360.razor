    private async Task CommitAddContactAsync()
    {
        if (_acct is null)
            return;

        if (_userContext?.TenantId == Guid.Empty)
        {
            await ShowToast("Save failed: tenant context is missing.", "a360-toast-danger");
            return;
        }

        _saving = true;
        try
        {
            if (_editingContact is null)
            {
                var request = new Ams.Application.Features.Contacts.CreateContactRequest
                {
                    TenantId = _userContext?.TenantId ?? _acct.TenantId,
                    AccountId = AccountId,
                    FirstName = Normalize(_contactForm.FirstName) ?? string.Empty,
                    LastName = Normalize(_contactForm.LastName) ?? string.Empty,
                    Email = Normalize(_contactForm.Email),
                    Phone = Normalize(_contactForm.Phone),
                    JobTitle = Normalize(_contactForm.Title),
                    ContactTypeCode = _contactForm.IsPrimary ? "Primary" : "General",
                    IsKeyContact = _contactForm.IsPrimary,
                    IsServiceContact = _contactForm.IsPrimary,
                    StatusCode = "Active",
                    CreatedByUserId = _userContext?.UserId
                };

                await Api.CreateContactAsync(request);
            }
            else
            {
                var request = new Ams.Application.Features.Contacts.UpdateContactRequest
                {
                    FirstName = Normalize(_contactForm.FirstName) ?? string.Empty,
                    LastName = Normalize(_contactForm.LastName) ?? string.Empty,
                    Email = Normalize(_contactForm.Email),
                    Phone = Normalize(_contactForm.Phone),
                    JobTitle = Normalize(_contactForm.Title),
                    ContactTypeCode = _contactForm.IsPrimary ? "Primary" : "General",
                    IsKeyContact = _contactForm.IsPrimary,
                    IsServiceContact = _contactForm.IsPrimary,
                    StatusCode = "Active",
                    ModifiedByUserId = _userContext?.UserId
                };

                await Api.UpdateContactAsync(_editingContact.ContactId, request);
            }

            CloseContactDialog();
            await LoadContactsAsync();
            await ShowToast(_editingContact is null ? "Contact added." : "Contact updated.");
        }
        catch (Exception ex)
        {
            await ShowToast($"Save failed: {ex.Message}", "a360-toast-danger");
        }
        finally
        {
            _saving = false;
        }
    }
