    private async Task LoadPolicyCreationSourcesAsync(Guid accountTenantId)
    {
        var tenantId = _userContext?.TenantId != Guid.Empty ? _userContext?.TenantId ?? accountTenantId : accountTenantId;
        var sources = await Api.GetPolicyCreationSourcesAsync(tenantId) ?? Array.Empty<PolicyCreationSourceDto>();
