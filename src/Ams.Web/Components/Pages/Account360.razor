    private async Task SaveAccountAsync()
    {
        if (_acct is null)
            return;

        _saving = true;
        try
        {
            var request = new UpdateAccountRequest
            {
                AccountName = Normalize(_editForm.AccountName) ?? string.Empty,
                AccountTypeCode = Normalize(_editForm.AccountTypeCode) ?? string.Empty,
                StatusCode = Normalize(_editForm.StatusCode) ?? "Active",
                SegmentCode = Normalize(_editForm.SegmentCode),
                LifecycleStageCode = Normalize(_editForm.LifecycleStageCode),
                Industry = Normalize(_editForm.Industry),
                MainEmail = Normalize(_editForm.MainEmail),
                MainPhone = Normalize(_editForm.MainPhone),
                Website = Normalize(_editForm.Website),
                AnnualRevenue = _editForm.AnnualRevenue
            };

            await Api.UpdateAccountAsync(AccountId, request);
            _showEdit = false;
            AddTimelineEvent("Account", "Account updated", "Account profile fields were updated.", "Me", DateTime.UtcNow);
            await LoadAsync();
            await ShowToast("Account updated.");
        }
        catch (Exception ex)
        {
            await ShowToast($"Save failed: {ex.Message}", "e-toast-danger");
        }
        finally
        {
            _saving = false;
        }
    }

