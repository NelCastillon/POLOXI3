    private async Task CommitExistingPolicyAsync()
    {
        if (_acct is null)
            return;

        if (_policyCreationSources.Count == 0)
        {
            await ShowToast("Add existing policy failed: no DB-backed existing-policy entry sources are configured.", "a360-toast-danger");
            return;
        }

        _saving = true;
        try
        {
            var tenantId = _userContext?.TenantId != Guid.Empty ? _userContext?.TenantId ?? _acct.TenantId : _acct.TenantId;
            var notes = BuildExistingPolicyNotes(_existingPolicyForm);
            var policyId = await Api.CreatePolicyRegisterAsync(new UpsertPolicyRegisterRequest
            {
                TenantId = tenantId,
                AccountId = AccountId,
                AccountName = _acct.AccountName,
                AccountType = string.IsNullOrWhiteSpace(_acct.AccountType) ? "Commercial" : _acct.AccountType,
                PolicyNumber = Normalize(_existingPolicyForm.PolicyNumber) ?? string.Empty,
                CarrierName = Normalize(_existingPolicyForm.CarrierName) ?? string.Empty,
                PolicySourceCode = Normalize(_existingPolicyForm.PolicySourceCode) ?? SelectedExistingPolicySource?.SourceCode ?? string.Empty,
                PolicySourceReason = Normalize(_existingPolicyForm.PolicySourceReason),
                LineOfBusiness = Normalize(_existingPolicyForm.LineOfBusiness) ?? string.Empty,
                Status = Normalize(_existingPolicyForm.Status) ?? "Active",
                EffectiveDate = _existingPolicyForm.EffectiveDate ?? DateTime.Today,
                ExpirationDate = _existingPolicyForm.ExpirationDate ?? DateTime.Today.AddYears(1),
                WrittenPremium = _existingPolicyForm.WrittenPremium > 0 ? _existingPolicyForm.WrittenPremium : _existingPolicyForm.AnnualPremium,
                AnnualPremium = _existingPolicyForm.AnnualPremium,
                ProducerName = _acct.ProducerName,
                CsrName = _acct.CsrName,
                Branch = Normalize(_existingPolicyForm.Branch),
                RenewalStage = "Not Started",
                Notes = notes,
                ModifiedByUserId = _userContext?.UserId
            });

            if (_existingPolicyUploadFile is not null)
            {
                await UploadExistingPolicyDocumentAsync(policyId, tenantId);
            }

            CloseExistingPolicyDialog();
            await LoadPoliciesAsync();
            await LoadDocumentsAsync();
            await ShowToast("Existing policy added.");
        }
        catch (Exception ex)
        {
            await ShowToast($"Add existing policy failed: {ex.Message}", "a360-toast-danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task UploadExistingPolicyDocumentAsync(Guid policyId, Guid tenantId)
    {
        if (_existingPolicyUploadFile is null)
            return;

        await using var stream = _existingPolicyUploadFile.OpenReadStream(104_857_600);
        await Api.UploadDocumentAsync(new ApiClient.UploadDocumentRequest
        {
            TenantId = tenantId,
            DocumentTypeCode = "Policy",
            CategoryCode = "Declarations",
            FileExtension = Path.GetExtension(_existingPolicyUploadFile.Name),
            FileName = _existingPolicyUploadFile.Name,
            OriginalFileName = _existingPolicyUploadFile.Name,
            EntityName = "Policy",
            EntityId = policyId,
            Description = $"Declarations page for existing policy {_existingPolicyForm.PolicyNumber}.",
            Tags = "policy,declarations,existing-policy",
            UploadedByName = _userContext?.TenantName,
            CreatedByUserId = _userContext?.UserId,
            Content = stream
        });
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _acct = null;
        StateHasChanged();

        try
        {
            _userContext ??= await UserContext.GetAsync();
            if (_userContext is null)
                throw new InvalidOperationException("The current user session is missing tenant context.");

            _account360 = await Api.GetAccount360Async(_userContext.TenantId, AccountId);
            var account = _account360?.Account;
            if (account is null)
            {
                Breadcrumbs.SetCrumbs(new("Home", "/"), new("Accounts", "/accounts"), new("Account not found", $"/accounts/{AccountId}"));
                NavContext.ClearAccount();
                return;
            }

            _acct = BuildAccountModel(account);
            ClearTabData();
            ApplyAccount360Data(_account360!);
            await LoadDocumentCategoriesAsync(account.TenantId);
            await LoadPolicyCreationSourcesAsync(account.TenantId);
            await LoadPoliciesAsync();
            await LoadContactsAsync();
            await LoadDocumentsAsync();
            BuildRightPanel();
            Breadcrumbs.SetCrumbs(new("Home", "/"), new("Accounts", "/accounts"), new(_acct.AccountName, $"/accounts/{AccountId}"));
            NavContext.SetAccount(AccountId, _acct.AccountName);
        }
        catch (Exception ex)
        {
            Breadcrumbs.SetCrumbs(new("Home", "/"), new("Accounts", "/accounts"), new("Account load failed", $"/accounts/{AccountId}"));
            NavContext.ClearAccount();
            await ShowToast($"Load failed: {ex.Message}", "a360-toast-danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyAccount360Data(Account360Dto account360)
    {
        _contacts = account360.Contacts.Select(MapContact).ToList();
        _submissions = account360.Submissions.Select(submission => new SubmissionRow
        {
            SubmissionNumber = submission.SubmissionNumber,
            LineOfBusiness = submission.LineOfBusiness,
            Carrier = submission.MarketCount > 0 ? $"{submission.MarketCount} market(s)" : "Not marketed",
            Status = submission.Status,
            SubmittedAt = submission.CreatedDateUtc,
            DueDate = submission.EffectiveDate,
            Notes = submission.OpportunityName
        }).ToList();
        _claims = account360.Claims.Select(claim => new ClaimRow
        {
            ClaimNumber = claim.ClaimNumber,
            LineOfBusiness = claim.Lob,
            LossDate = claim.DateOfLoss,
            Status = claim.Status,
            ReserveAmount = claim.TotalReserves,
            PaidAmount = claim.TotalPaid,
            Adjuster = claim.AssignedHandler
        }).ToList();
        _documents = account360.Documents.Select(MapDocument).ToList();
        _activities = account360.Activities.Select(activity => new ActivityRow
        {
            Type = OptionName("ActivityType", activity.ActivityTypeCode),
            Subject = activity.Title,
            Notes = activity.Description,
            By = activity.CreatedByUserId?.ToString() ?? "System",
            OccurredAt = activity.OccurredDateUtc
        }).ToList();
        _relationships = account360.Relationships.Select(relationship => new RelationshipRow
        {
            RelatedAccountId = relationship.RelatedAccountId,
            RelatedAccount = relationship.RelatedAccountName,
            RelationType = relationship.RelationshipTypeCode
        }).ToList();
        _timelineEvents = account360.Timeline.Select(item => new TimelineEvent(item.EventTypeCode, item.Title, item.Description, "Account", item.EventDateUtc)).ToList();
    }

