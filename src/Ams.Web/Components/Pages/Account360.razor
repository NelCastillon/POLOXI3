    private void ConfirmDelete(string title, string message, Func<Task> action)
    {
        _deleteTitle = title;
        _deleteMessage = message;
        _confirmDeleteAction = action;
        _showDeleteConfirm = true;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_confirmDeleteAction is null)
            return;

        _saving = true;
        try
        {
            await _confirmDeleteAction.Invoke();
            _showDeleteConfirm = false;
        }
        catch (Exception ex)
        {
            await ShowToast($"Delete failed: {ex.Message}", "e-toast-danger");
        }
        finally
        {
            _saving = false;
            _confirmDeleteAction = null;
        }
    }

