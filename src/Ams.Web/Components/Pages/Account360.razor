            <div class="a360-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showAddSubmission = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitAddSubmissionAsync" disabled="@(string.IsNullOrEmpty(_newSub.LineOfBusiness)||string.IsNullOrEmpty(_newSub.Carrier))"><i class="bi bi-check-lg" aria-hidden="true"></i> Submit</button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public Guid AccountId { get; set; }

    private SfToast?                       _toast;
