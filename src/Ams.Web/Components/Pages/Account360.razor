@page "/accounts/{AccountId:guid}"
@namespace Ams.Web.Components.Pages
@using Syncfusion.Blazor.Diagram
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject NavigationContextService NavContext

<PageTitle>@(_acct is null ? "Account" : _acct.AccountName) — 360</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@if (_loading)
{
    <div class="a360-loading"><span class="um-spin" aria-hidden="true"></span><span>Loading account…</span></div>
}
else if (_acct is null)
{
    <div class="a360-not-found">
        <i class="bi bi-building-x a360-nf-icon" aria-hidden="true"></i>
        <h2>Account not found</h2>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/accounts")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Accounts
        </button>
    </div>
}
else
{
    <!-- ── HEADER ─────────────────────────────────────────────────────── -->
    <div class="a360-header">
        <div class="a360-header-left">
            <div class="a360-logo @AvatarColor(_acct.AccountName)">@Initials(_acct.AccountName)</div>
            <div class="a360-header-info">
                <div class="a360-name-row">
                    <h1 class="a360-name">@_acct.AccountName</h1>
                    <span class="@StatusBadge(_acct.Status)">@_acct.Status</span>
                    @if (!string.IsNullOrEmpty(_acct.Segment))
                    {
                        <span class="@SegBadge(_acct.Segment)">@_acct.Segment</span>
                    }
                </div>
                <div class="a360-sub-row">
                    <span class="a360-sub-chip"><i class="bi bi-building" aria-hidden="true"></i>@_acct.AccountType</span>
                    <span class="a360-sub-chip"><i class="bi bi-person" aria-hidden="true"></i>@_acct.Owner</span>
                    <span class="a360-sub-chip"><i class="bi bi-people" aria-hidden="true"></i>@_acct.ServicingTeam</span>
                    @if (!string.IsNullOrEmpty(_acct.Industry))
                    {
                        <span class="a360-sub-chip"><i class="bi bi-briefcase" aria-hidden="true"></i>@_acct.Industry</span>
                    }
                </div>
            </div>
        </div>
        <div class="a360-header-actions">
            <button class="um-btn um-btn-ghost" @onclick="() => _showEdit = true"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
            <button class="um-btn um-btn-ghost" @onclick="() => _showNote = true"><i class="bi bi-sticky" aria-hidden="true"></i> Add Note</button>
            <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/quotes/new?accountId=" + AccountId)'><i class="bi bi-file-text" aria-hidden="true"></i> New Quote</button>
            <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/crm/opportunities/new?accountId=" + AccountId)'><i class="bi bi-trophy" aria-hidden="true"></i> New Opportunity</button>
        </div>
    </div>

    <!-- ── HEADLINE KPI CARDS ──────────────────────────────────────────── -->
    <div class="a360-kpi-bar">
        @KpiCard("Total Premium",          _acct.TotalPremium.ToString("C0"),    "bi-shield-fill",     "a360-ki--green")
        @KpiCard("Balances Due",           _acct.BalancesDue.ToString("C0"),     "bi-receipt",         _acct.BalancesDue > 0 ? "a360-ki--red" : "a360-ki--green")
        @KpiCard("Renewal Risk",           _acct.RenewalRisk,                    "bi-arrow-repeat",    RenewalRiskIcon(_acct.RenewalRisk))
        @KpiCard("Open Claims",            _acct.OpenClaims.ToString(),          "bi-exclamation-triangle", _acct.OpenClaims > 0 ? "a360-ki--amber" : "a360-ki--green")
        @KpiCard("Active Policies",        _acct.ActivePolicies.ToString(),      "bi-shield-check",    "a360-ki--blue")
        @KpiCard("Open Opportunities",     _acct.OpenOpportunities.ToString(),   "bi-trophy",          "a360-ki--purple")
        @KpiCard("YTD Commissions",        _acct.YtdCommissions.ToString("C0"),  "bi-percent",         "a360-ki--blue")
        @KpiCard("Last Activity",          _acct.LastActivityDate?.ToString("d") ?? "—", "bi-lightning","a360-ki--gray")
    </div>

    <!-- ── 14-TAB BODY ─────────────────────────────────────────────────── -->
    <AppDetailTabs SelectedTab="_tab" SelectedTabChanged="t => _tab = t">
        <Tabs>

            <!-- 0 ── OVERVIEW ──────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Overview" IconCss="bi bi-house" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-overview-grid">

                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Account Information</h3>
                                <div class="a360-field-grid">
                                    @F("Account #",      _acct.AccountNumber)
                                    @F("Account Name",   _acct.AccountName)
                                    @F("Type",           _acct.AccountType)
                                    @F("Status",         _acct.Status)
                                    @F("Segment",        _acct.Segment)
                                    @F("Industry",       _acct.Industry)
                                    @F("Employees",      _acct.Employees?.ToString("N0") ?? "—")
                                    @F("Annual Revenue", _acct.AnnualRevenue?.ToString("C0") ?? "—")
                                    @F("Website",        _acct.Website)
                                    @F("Tax ID / EIN",   _acct.TaxId)
                                    @F("NAICS Code",     _acct.NaicsCode)
                                    @F("Lifecycle Stage",_acct.LifecycleStage)
                                    @F("Created",        _acct.CreatedAt.ToString("d"))
                                    @F("Last Modified",  _acct.ModifiedAt?.ToString("d") ?? "—")
                                </div>
                            </div>

                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Service Team</h3>
                                <div class="a360-field-grid">
                                    @F("Account Owner",    _acct.Owner)
                                    @F("Servicing Team",   _acct.ServicingTeam)
                                    @F("CSR",              _acct.CsrName ?? "—")
                                    @F("Producer",         _acct.ProducerName ?? "—")
                                    @F("Account Manager",  _acct.AccountManager ?? "—")
                                </div>
                            </div>

                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Contact Information</h3>
                                <div class="a360-field-grid">
                                    @F("Primary Email", _acct.Email)
                                    @F("Phone",         _acct.Phone)
                                    @F("Street",        _acct.Street)
                                    @F("City",          _acct.City)
                                    @F("State",         _acct.State)
                                    @F("ZIP",           _acct.Zip)
                                    @F("Country",       _acct.Country)
                                </div>
                            </div>

                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Financial Summary</h3>
                                <div class="a360-field-grid">
                                    @F("Total Premium",       _acct.TotalPremium.ToString("C0"))
                                    @F("Balances Due",        _acct.BalancesDue.ToString("C0"))
                                    @F("YTD Commissions",     _acct.YtdCommissions.ToString("C0"))
                                    @F("Active Policies",     _acct.ActivePolicies.ToString())
                                    @F("Open Claims",         _acct.OpenClaims.ToString())
                                    @F("Renewal Risk",        _acct.RenewalRisk)
                                    @F("Open Opportunities",  _acct.OpenOpportunities.ToString())
                                </div>
                            </div>

                        </div>
                        @if (!string.IsNullOrEmpty(_acct.Notes))
                        {
                            <div class="a360-info-card">
                                <h3 class="a360-section-hdr">Notes</h3>
                                <p class="a360-notes">@_acct.Notes</p>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 1 ── CONTACTS ──────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Contacts" IconCss="bi bi-people" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_contacts.Count contact(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showAddContact = true"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Contact</button>
                        </div>
                        @if (_contacts.Count == 0) { @AEmpty("bi-people","No contacts","Add the key contacts for this account.") }
                        else
                        {
                            <div class="a360-contact-grid">
                                @foreach (var c in _contacts)
                                {
                                    <div class="a360-contact-card">
                                        <div class="a360-contact-avatar @AvatarColor(c.FullName)">@Initials(c.FullName)</div>
                                        <div class="a360-contact-body">
                                            <div class="a360-contact-name">@c.FullName</div>
                                            <div class="a360-contact-title">@c.Title</div>
                                            <div class="a360-contact-links">
                                                @if (!string.IsNullOrEmpty(c.Email)) { <a href="mailto:@c.Email" class="a360-contact-link"><i class="bi bi-envelope" aria-hidden="true"></i> @c.Email</a> }
                                                @if (!string.IsNullOrEmpty(c.Phone)) { <span class="a360-contact-link"><i class="bi bi-telephone" aria-hidden="true"></i> @c.Phone</span> }
                                            </div>
                                        </div>
                                        @if (c.IsPrimary) { <span class="a360-primary-badge">Primary</span> }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 2 ── POLICIES ──────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Policies" IconCss="bi bi-shield-check" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_policies.Count polic@(_policies.Count == 1 ? "y" : "ies")</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/new?accountId=" + AccountId)'><i class="bi bi-plus-lg" aria-hidden="true"></i> New Policy</button>
                        </div>
                        @if (_policies.Count == 0) { @AEmpty("bi-shield","No policies","Bind new policies from quotes or add existing.") }
                        else
                        {
                            <div class="app-datagrid">
                                <SfGrid TValue="PolicyRow" DataSource="_policies" AllowSorting="true" AllowFiltering="true" EnableHover="true" RowHeight="56">
                                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                                    <GridColumns>
                                        <GridColumn Field="@nameof(PolicyRow.PolicyNumber)"   HeaderText="Policy #"    Width="150" />
                                        <GridColumn Field="@nameof(PolicyRow.LineOfBusiness)" HeaderText="Line"        Width="160" />
                                        <GridColumn Field="@nameof(PolicyRow.Carrier)"        HeaderText="Carrier"     Width="150" />
                                        <GridColumn Field="@nameof(PolicyRow.Premium)"        HeaderText="Premium"     Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                            <Template>@{ var p = (PolicyRow)context; }<span class="a360-mono a360-bold">@p.Premium.ToString("C0")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(PolicyRow.Status)"         HeaderText="Status"      Width="100">
                                            <Template>@{ var p = (PolicyRow)context; }<span class="@PolicyStatusBadge(p.Status)">@p.Status</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(PolicyRow.EffectiveDate)"  HeaderText="Effective"   Width="120">
                                            <Template>@{ var p = (PolicyRow)context; }<span class="a360-mono">@p.EffectiveDate.ToString("d")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(PolicyRow.ExpirationDate)" HeaderText="Expiration"  Width="120">
                                            <Template>@{ var p = (PolicyRow)context; }<span class="a360-mono @(p.ExpirationDate < DateTime.UtcNow.AddDays(30) && p.Status == "Active" ? "a360-due-soon" : "")">@p.ExpirationDate.ToString("d")</span></Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                            <Template>@{ var p = (PolicyRow)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/policies/{p.PolicyId}")'><i class="bi bi-arrow-right" aria-hidden="true"></i></button></Template>
                                        </GridColumn>
                                    </GridColumns>
                                </SfGrid>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 3 ── SUBMISSIONS ───────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Submissions" IconCss="bi bi-send" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_submissions.Count submission(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showAddSubmission = true"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Submission</button>
                        </div>
                        @if (_submissions.Count == 0) { @AEmpty("bi-send","No submissions","Create carrier submissions for this account's lines.") }
                        else
                        {
                            <div class="app-datagrid">
                                <SfGrid TValue="SubmissionRow" DataSource="_submissions" AllowSorting="true" EnableHover="true" RowHeight="52">
                                    <GridColumns>
                                        <GridColumn Field="@nameof(SubmissionRow.SubmissionNumber)" HeaderText="Sub #"     Width="140" />
                                        <GridColumn Field="@nameof(SubmissionRow.LineOfBusiness)"   HeaderText="Line"      Width="160" />
                                        <GridColumn Field="@nameof(SubmissionRow.Carrier)"          HeaderText="Carrier"   Width="150" />
                                        <GridColumn Field="@nameof(SubmissionRow.Status)"           HeaderText="Status"    Width="120">
                                            <Template>@{ var s = (SubmissionRow)context; }<span class="@SubStatusBadge(s.Status)">@s.Status</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(SubmissionRow.SubmittedAt)"      HeaderText="Submitted"  Width="120">
                                            <Template>@{ var s = (SubmissionRow)context; }<span class="a360-mono">@s.SubmittedAt.ToString("d")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(SubmissionRow.DueDate)"          HeaderText="Due"        Width="120">
                                            <Template>@{ var s = (SubmissionRow)context; }<span class="a360-mono @(s.DueDate.HasValue && s.DueDate < DateTime.UtcNow ? "a360-overdue" : "")">@(s.DueDate?.ToString("d") ?? "—")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(SubmissionRow.Notes)"            HeaderText="Notes"     MinWidth="120" />
                                    </GridColumns>
                                </SfGrid>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 4 ── CLAIMS ────────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Claims" IconCss="bi bi-exclamation-triangle" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_claims.Count claim(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showFnol = true"><i class="bi bi-plus-lg" aria-hidden="true"></i> FNOL</button>
                        </div>
                        @if (_claims.Count == 0) { @AEmpty("bi-exclamation-triangle","No claims","First notice of loss will appear here.") }
                        else
                        {
                            <div class="app-datagrid">
                                <SfGrid TValue="ClaimRow" DataSource="_claims" AllowSorting="true" AllowFiltering="true" EnableHover="true" RowHeight="52">
                                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                                    <GridColumns>
                                        <GridColumn Field="@nameof(ClaimRow.ClaimNumber)"     HeaderText="Claim #"    Width="150" />
                                        <GridColumn Field="@nameof(ClaimRow.LineOfBusiness)"  HeaderText="Line"       Width="160" />
                                        <GridColumn Field="@nameof(ClaimRow.LossDate)"        HeaderText="Loss Date"  Width="120">
                                            <Template>@{ var c = (ClaimRow)context; }<span class="a360-mono">@c.LossDate.ToString("d")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(ClaimRow.Status)"          HeaderText="Status"     Width="110">
                                            <Template>@{ var c = (ClaimRow)context; }<span class="@ClaimStatusBadge(c.Status)">@c.Status</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(ClaimRow.ReserveAmount)"   HeaderText="Reserve"    Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                            <Template>@{ var c = (ClaimRow)context; }<span class="a360-mono a360-bold">@c.ReserveAmount.ToString("C0")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(ClaimRow.PaidAmount)"      HeaderText="Paid"       Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                            <Template>@{ var c = (ClaimRow)context; }<span class="a360-mono">@c.PaidAmount.ToString("C0")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(ClaimRow.Adjuster)"        HeaderText="Adjuster"   Width="140" />
                                    </GridColumns>
                                </SfGrid>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 5 ── BILLING ───────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Billing" IconCss="bi bi-receipt" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_billing.Count invoice(s)</span>
                        </div>
                        @if (_billing.Count == 0) { @AEmpty("bi-receipt","No billing records","Invoices and installments will appear here.") }
                        else
                        {
                            <div class="app-datagrid">
                                <SfGrid TValue="BillingRow" DataSource="_billing" AllowSorting="true" EnableHover="true" RowHeight="52">
                                    <GridColumns>
                                        <GridColumn Field="@nameof(BillingRow.InvoiceNumber)" HeaderText="Invoice #"  Width="150" />
                                        <GridColumn Field="@nameof(BillingRow.PolicyNumber)"  HeaderText="Policy #"   Width="150" />
                                        <GridColumn Field="@nameof(BillingRow.Amount)"        HeaderText="Amount"     Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                            <Template>@{ var b = (BillingRow)context; }<span class="a360-mono a360-bold">@b.Amount.ToString("C0")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(BillingRow.Balance)"       HeaderText="Balance"    Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                            <Template>@{ var b = (BillingRow)context; }<span class="a360-mono @(b.Balance > 0 ? "a360-overdue" : "")">@b.Balance.ToString("C0")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(BillingRow.Status)"        HeaderText="Status"     Width="110">
                                            <Template>@{ var b = (BillingRow)context; }<span class="@BillingStatusBadge(b.Status)">@b.Status</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(BillingRow.DueDate)"       HeaderText="Due"        Width="120">
                                            <Template>@{ var b = (BillingRow)context; }<span class="a360-mono @(b.DueDate < DateTime.UtcNow && b.Status != "Paid" ? "a360-overdue" : "")">@b.DueDate.ToString("d")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(BillingRow.PaymentMethod)" HeaderText="Method"     Width="120" />
                                    </GridColumns>
                                </SfGrid>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 6 ── COMMISSIONS ───────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Commissions" IconCss="bi bi-percent" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_commissions.Count commission record(s)</span>
                        </div>
                        @if (_commissions.Count == 0) { @AEmpty("bi-percent","No commission records","Commission history will appear here.") }
                        else
                        {
                            <div class="app-datagrid">
                                <SfGrid TValue="CommissionRow" DataSource="_commissions" AllowSorting="true" EnableHover="true" RowHeight="52">
                                    <GridColumns>
                                        <GridColumn Field="@nameof(CommissionRow.PolicyNumber)"    HeaderText="Policy #"   Width="150" />
                                        <GridColumn Field="@nameof(CommissionRow.LineOfBusiness)"  HeaderText="Line"       Width="160" />
                                        <GridColumn Field="@nameof(CommissionRow.GrossPremium)"    HeaderText="Premium"    Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                            <Template>@{ var c = (CommissionRow)context; }<span class="a360-mono a360-bold">@c.GrossPremium.ToString("C0")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(CommissionRow.CommissionRate)"  HeaderText="Rate"       Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                            <Template>@{ var c = (CommissionRow)context; }<span class="a360-mono">@c.CommissionRate.ToString("F1")%</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(CommissionRow.CommissionAmount)" HeaderText="Commission" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                            <Template>@{ var c = (CommissionRow)context; }<span class="a360-mono a360-bold">@c.CommissionAmount.ToString("C0")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(CommissionRow.Status)"          HeaderText="Status"     Width="110">
                                            <Template>@{ var c = (CommissionRow)context; }<span class="@CommStatusBadge(c.Status)">@c.Status</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(CommissionRow.PaidDate)"        HeaderText="Paid Date"  Width="120">
                                            <Template>@{ var c = (CommissionRow)context; }<span class="a360-mono">@(c.PaidDate?.ToString("d") ?? "—")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(CommissionRow.Producer)"        HeaderText="Producer"   Width="140" />
                                    </GridColumns>
                                </SfGrid>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 7 ── DOCUMENTS ─────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Documents" IconCss="bi bi-folder2" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_documents.Count document(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showUpload = true"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i> Upload</button>
                        </div>
                        @if (_documents.Count == 0) { @AEmpty("bi-folder2","No documents","Upload loss runs, financials, policy documents or correspondence.") }
                        else
                        {
                            <div class="app-datagrid">
                                <SfGrid TValue="DocRow" DataSource="_documents" AllowSorting="true" EnableHover="true" RowHeight="52">
                                    <GridColumns>
                                        <GridColumn Field="@nameof(DocRow.FileName)"    HeaderText="File"        MinWidth="200">
                                            <Template>@{ var d = (DocRow)context; }<span class="a360-doc-name"><i class="bi @DocIcon(d.Extension)" aria-hidden="true"></i> @d.FileName</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(DocRow.Category)"   HeaderText="Category"    Width="140" />
                                        <GridColumn Field="@nameof(DocRow.SizeKb)"     HeaderText="Size"        Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                            <Template>@{ var d = (DocRow)context; }<span class="a360-mono">@d.SizeKb KB</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(DocRow.UploadedBy)" HeaderText="Uploaded By" Width="150" />
                                        <GridColumn Field="@nameof(DocRow.UploadedAt)" HeaderText="Date"        Width="120">
                                            <Template>@{ var d = (DocRow)context; }<span class="a360-mono">@d.UploadedAt.ToString("d")</span></Template>
                                        </GridColumn>
                                        <GridColumn HeaderText="" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                                            <Template><button class="um-btn um-btn-ghost um-btn-sm" title="Download"><i class="bi bi-download" aria-hidden="true"></i></button></Template>
                                        </GridColumn>
                                    </GridColumns>
                                </SfGrid>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 8 ── ACTIVITIES ────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Activities" IconCss="bi bi-lightning" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_activities.Count activit@(_activities.Count == 1 ? "y" : "ies")</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showLogActivity = true"><i class="bi bi-plus-lg" aria-hidden="true"></i> Log</button>
                        </div>
                        @if (_activities.Count == 0) { @AEmpty("bi-lightning","No activities","Log calls, emails and meetings linked to this account.") }
                        else
                        {
                            <div class="a360-timeline">
                                @foreach (var a in _activities.OrderByDescending(x => x.OccurredAt))
                                {
                                    <div class="a360-tl-item">
                                        <div class="a360-tl-icon @ActivityColor(a.Type)"><i class="bi @ActivityIcon(a.Type)" aria-hidden="true"></i></div>
                                        <div class="a360-tl-body">
                                            <div class="a360-tl-hdr">
                                                <span class="a360-tl-type">@a.Type</span>
                                                <span class="a360-tl-by">@a.By</span>
                                                <span class="a360-mono a360-muted">@a.OccurredAt.ToString("g")</span>
                                            </div>
                                            <div class="a360-tl-subject">@a.Subject</div>
                                            @if (!string.IsNullOrEmpty(a.Notes)) { <p class="a360-tl-notes">@a.Notes</p> }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 9 ── COMMUNICATIONS ────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Communications" IconCss="bi bi-chat-dots" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_comms.Count message(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showCompose = true"><i class="bi bi-plus-lg" aria-hidden="true"></i> New</button>
                        </div>
                        @if (_comms.Count == 0) { @AEmpty("bi-chat-dots","No communications","Log emails, calls or SMS sent to this account.") }
                        else
                        {
                            <div class="a360-comms-list">
                                @foreach (var m in _comms.OrderByDescending(x => x.SentAt))
                                {
                                    <div class="a360-comm-row">
                                        <div class="a360-comm-icon @CommColor(m.Channel)"><i class="bi @CommIcon(m.Channel)" aria-hidden="true"></i></div>
                                        <div class="a360-comm-body">
                                            <div class="a360-comm-hdr">
                                                <span class="a360-comm-subject">@m.Subject</span>
                                                <span class="a360-comm-channel">@m.Channel</span>
                                                <span class="a360-mono a360-muted">@m.SentAt.ToString("g")</span>
                                            </div>
                                            <div class="a360-comm-preview">@m.Preview</div>
                                            <div class="a360-comm-meta"><span>By @m.SentBy</span>@if (m.Opened) { <span class="a360-comm-opened"><i class="bi bi-check2-all" aria-hidden="true"></i> Opened</span> }</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 10 ── MARKETING ────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Marketing" IconCss="bi bi-megaphone" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-tab-toolbar">
                            <span class="a360-tab-count">@_campaigns.Count enrollment(s)</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showCampaign = true"><i class="bi bi-plus-lg" aria-hidden="true"></i> Enroll</button>
                        </div>
                        @if (_campaigns.Count == 0) { @AEmpty("bi-megaphone","No campaign enrollments","Enroll this account in renewal or cross-sell campaigns.") }
                        else
                        {
                            <div class="app-datagrid">
                                <SfGrid TValue="CampaignRow" DataSource="_campaigns" AllowSorting="true" EnableHover="true" RowHeight="52">
                                    <GridColumns>
                                        <GridColumn Field="@nameof(CampaignRow.CampaignName)" HeaderText="Campaign"    MinWidth="200" />
                                        <GridColumn Field="@nameof(CampaignRow.Status)"       HeaderText="Status"      Width="110">
                                            <Template>@{ var c = (CampaignRow)context; }<span class="@CampStatusBadge(c.Status)">@c.Status</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(CampaignRow.EnrolledAt)"  HeaderText="Enrolled"    Width="120">
                                            <Template>@{ var c = (CampaignRow)context; }<span class="a360-mono">@c.EnrolledAt.ToString("d")</span></Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(CampaignRow.EmailsSent)"  HeaderText="Sent"        Width="65" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                                        <GridColumn Field="@nameof(CampaignRow.Opens)"       HeaderText="Opens"       Width="65" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                                        <GridColumn Field="@nameof(CampaignRow.Clicks)"      HeaderText="Clicks"      Width="65" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                                    </GridColumns>
                                </SfGrid>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 11 ── TIMELINE ─────────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Timeline" IconCss="bi bi-clock-history" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-timeline-full">
                            @foreach (var e in _timelineEvents.OrderByDescending(x => x.OccurredAt))
                            {
                                <div class="a360-tle-item">
                                    <div class="a360-tle-when"><span class="a360-mono">@e.OccurredAt.ToString("d")</span><span class="a360-muted">@e.OccurredAt.ToString("t")</span></div>
                                    <div class="a360-tle-dot @TimelineColor(e.Category)"><i class="bi @TimelineIcon(e.Category)" aria-hidden="true"></i></div>
                                    <div class="a360-tle-body">
                                        <div class="a360-tle-cat">@e.Category</div>
                                        <div class="a360-tle-title">@e.Title</div>
                                        @if (!string.IsNullOrEmpty(e.Detail)) { <p class="a360-tle-detail">@e.Detail</p> }
                                        <div class="a360-tle-by">@e.By</div>
                                    </div>
                                </div>
                            }
                            @if (_timelineEvents.Count == 0) { @AEmpty("bi-clock-history","No timeline events","All account-level events will appear here in chronological order.") }
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 12 ── RELATIONSHIPS ─────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Relationships" IconCss="bi bi-diagram-3" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-rel-header">
                            <span class="a360-tab-count">Account relationship map</span>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showAddRel = true"><i class="bi bi-plus-lg" aria-hidden="true"></i> Link Account</button>
                        </div>
                        <!-- SfDiagram for relationship visualization -->
                        <div class="a360-diagram-wrap">
                            <SfDiagramComponent @ref="_diagram"
                                                Width="100%" Height="440px"
                                                Nodes="_diagramNodes"
                                                Connectors="_diagramConnectors"
                                                Created="OnDiagramCreated">
                                <SnapSettings Constraints="SnapConstraints.None" />
                                <Layout Type="LayoutType.HierarchicalTree"
                                        HorizontalSpacing="60"
                                        VerticalSpacing="60"
                                        Orientation="LayoutOrientation.TopToBottom" />
                            </SfDiagramComponent>
                        </div>
                        <!-- Relationship list -->
                        @if (_relationships.Count > 0)
                        {
                            <div class="a360-rel-list">
                                @foreach (var r in _relationships)
                                {
                                    <div class="a360-rel-row">
                                        <div class="a360-rel-avatar @AvatarColor(r.RelatedAccount)">@Initials(r.RelatedAccount)</div>
                                        <div class="a360-rel-body">
                                            <div class="a360-rel-name">@r.RelatedAccount</div>
                                            <div class="a360-rel-type">@r.RelationType</div>
                                        </div>
                                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo($"/accounts/{r.RelatedAccountId}")'>
                                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 13 ── RISK INSIGHTS ──────────────────────────────────────── -->
            <TabItem>
                <ChildContent><TabHeader Text="Risk Insights" IconCss="bi bi-graph-up" /></ChildContent>
                <ContentTemplate>
                    <div class="a360-tab-body">
                        <div class="a360-risk-grid">

                            <!-- Renewal risk panel -->
                            <div class="a360-risk-card @RenewalRiskCard(_acct.RenewalRisk)">
                                <div class="a360-risk-card-hdr">
                                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                                    <span>Renewal Risk</span>
                                    <span class="a360-risk-badge @RenewalRiskIcon(_acct.RenewalRisk)">@_acct.RenewalRisk</span>
                                </div>
                                <div class="a360-risk-factors">
                                    @foreach (var f in _renewalRiskFactors)
                                    {
                                        <div class="a360-rf-row">
                                            <i class="bi @(f.Positive ? "bi-check-circle-fill a360-rf--pos" : "bi-exclamation-circle-fill a360-rf--neg")" aria-hidden="true"></i>
                                            <span class="a360-rf-label">@f.Label</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Loss ratio card -->
                            <div class="a360-risk-card">
                                <div class="a360-risk-card-hdr"><i class="bi bi-bar-chart-steps" aria-hidden="true"></i><span>Loss Ratio (3-yr)</span></div>
                                @foreach (var yr in _lossRatioYears)
                                {
                                    <div class="a360-lr-row">
                                        <span class="a360-lr-year">@yr.Year</span>
                                        <div class="a360-lr-track">
                                            <div class="a360-lr-bar @(yr.Ratio > 70 ? "a360-lr--high" : yr.Ratio > 50 ? "a360-lr--mid" : "a360-lr--low")"
                                                 style="width:@Math.Min(yr.Ratio,100)%"></div>
                                        </div>
                                        <span class="a360-lr-val a360-mono @(yr.Ratio > 70 ? "a360-overdue" : "")">@yr.Ratio.ToString("F0")%</span>
                                    </div>
                                }
                            </div>

                            <!-- Claims history card -->
                            <div class="a360-risk-card">
                                <div class="a360-risk-card-hdr"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><span>Claims History</span></div>
                                <div class="a360-risk-metrics">
                                    @RMetric("Total Claims",    _claimsHistory.TotalClaims.ToString(),     "bi-clipboard")
                                    @RMetric("Open Claims",     _claimsHistory.OpenClaims.ToString(),      "bi-exclamation-circle")
                                    @RMetric("Total Incurred",  _claimsHistory.TotalIncurred.ToString("C0"),"bi-cash-coin")
                                    @RMetric("Avg Claim Size",  _claimsHistory.AvgClaimSize.ToString("C0"), "bi-graph-up")
                                    @RMetric("Largest Claim",   _claimsHistory.LargestClaim.ToString("C0"), "bi-arrow-up-circle")
                                    @RMetric("Yrs Since Loss",  _claimsHistory.YearsSinceLoss.ToString(),  "bi-clock")
                                </div>
                            </div>

                            <!-- Engagement card -->
                            <div class="a360-risk-card">
                                <div class="a360-risk-card-hdr"><i class="bi bi-activity" aria-hidden="true"></i><span>Engagement Score</span></div>
                                <div class="a360-score-wrap">
                                    <div class="a360-score-num" style="color:@ScoreColor(_riskInsight.EngagementScore)">@_riskInsight.EngagementScore</div>
                                    <div class="a360-score-bar-track">
                                        <div class="a360-score-bar-fill" style="width:@_riskInsight.EngagementScore%;background:@ScoreColor(_riskInsight.EngagementScore)"></div>
                                    </div>
                                </div>
                                <div class="a360-risk-metrics">
                                    @RMetric("Portal Logins",   _riskInsight.PortalLogins.ToString(),   "bi-globe")
                                    @RMetric("Emails Opened",   _riskInsight.EmailsOpened.ToString(),   "bi-envelope-open")
                                    @RMetric("Days Since Touch", _riskInsight.DaysSinceTouch.ToString(), "bi-clock")
                                    @RMetric("NPS Score",       _riskInsight.NpsScore?.ToString() ?? "—","bi-emoji-smile")
                                </div>
                            </div>

                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

        </Tabs>
    </AppDetailTabs>
}

