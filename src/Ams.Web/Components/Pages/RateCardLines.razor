@page "/billing/rate-card-lines"
@inject ApiClient Api

<PageTitle>Rate Card Lines</PageTitle>
<h1>Rate Card Lines</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(RateCardLineDto.RoleCode)"          HeaderText="Role"       Width="150"></GridColumn>
        <GridColumn Field="@nameof(RateCardLineDto.ServiceCode)"        HeaderText="Service"    Width="130"></GridColumn>
        <GridColumn Field="@nameof(RateCardLineDto.Description)"        HeaderText="Description" Width="250"></GridColumn>
        <GridColumn Field="@nameof(RateCardLineDto.HourlyRate)"         HeaderText="Hourly"     Width="110" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(RateCardLineDto.DailyRate)"          HeaderText="Daily"      Width="110" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(RateCardLineDto.EffectiveStartDate)" HeaderText="Effective"  Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(RateCardLineDto.IsActive)"           HeaderText="Active"     Width="90" DisplayAsCheckBox="true"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<RateCardLineDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchRateCardLinesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
