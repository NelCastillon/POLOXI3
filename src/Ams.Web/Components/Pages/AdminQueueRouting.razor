@page "/admin/system/routing"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>Queue Routing Rules - AMS</PageTitle>

<AppPageHeader Title="Queue Routing Rules"
               Subtitle="Configure how tasks, leads, service requests, and claims are auto-assigned and routed to queues and users"
               Icon="bi-signpost-split">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="()=>_showCreate=true"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Routing Rule</button>
    </Actions>
</AppPageHeader>

<div class="qrr-table-wrap">
    <AppGrid TValue="RoutingRule" DataSource="_rules" AllowSorting="true" AllowPaging="true" EnableHover="true" RowHeight="52">
        
        <GridColumns>
            <GridColumn Field="@nameof(RoutingRule.Priority)"    HeaderText="Order" Width="70" TextAlign=@("Center") />
            <GridColumn Field="@nameof(RoutingRule.Name)"        HeaderText="Rule" MinWidth="160" />
            <GridColumn Field="@nameof(RoutingRule.QueueType)"   HeaderText="Queue" Width="120" />
            <GridColumn Field="@nameof(RoutingRule.Condition)"   HeaderText="Condition" MinWidth="180" />
            <GridColumn Field="@nameof(RoutingRule.AssignTo)"    HeaderText="Assign To" Width="160" />
            <GridColumn Field="@nameof(RoutingRule.Fallback)"    HeaderText="Fallback" Width="140" />
            <GridColumn Field="@nameof(RoutingRule.Status)"      HeaderText="Status" Width="100">
                <Template>@{ var r=(RoutingRule)context; }<span class="@(r.Status=="Active"?"qrr-st-ok":"qrr-st-off")">@r.Status</span></Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="80" TextAlign=@("Right")>
                <Template>
                    <button class="um-btn um-btn-ghost um-btn-xs"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                    <button class="um-btn um-btn-ghost um-btn-xs"><i class="bi bi-trash" aria-hidden="true"></i></button>
                </Template>
            </GridColumn>
        </GridColumns>
    </AppGrid>
</div>

<AppModal @bind-Visible="_showCreate" Width="460px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>New Routing Rule</Header>
        <Content>
            <div class="qrr-dlg">
                <label class="qrr-label">Rule Name</label><input class="qrr-input" placeholder="e.g. Route commercial claims to CAT team" />
                <label class="qrr-label">Queue Type</label>
                <select class="qrr-input"><option>Tasks</option><option>Claims</option><option>Leads</option><option>Service Requests</option><option>Downloads</option></select>
                <label class="qrr-label">Condition</label><input class="qrr-input" placeholder="e.g. claim.type == 'CAT' AND claim.reserve > 50000" />
                <label class="qrr-label">Assign To</label><input class="qrr-input" placeholder="User, role, or team name" />
                <label class="qrr-label">Fallback (if no match)</label><input class="qrr-input" placeholder="e.g. General Queue" />
            </div>
        </Content>
        <FooterTemplate>
            <button class="um-btn um-btn-ghost" @onclick="()=>_showCreate=false">Cancel</button>
            <button class="um-btn um-btn-primary" @onclick="()=>_showCreate=false"><i class="bi bi-check2" aria-hidden="true"></i> Save Rule</button>
        </FooterTemplate>
    </DialogTemplates>
</AppModal>

@code {
    private bool _showCreate;
    private List<RoutingRule> _rules = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Administration","/admin"), new("Queue Routing Rules",""));
        _rules =
        [
            new RoutingRule { Priority=1,  Name="CAT Claims - CAT Response Team",          QueueType="Claims",          Condition="claim.type == 'CAT'",               AssignTo="CAT Response Team",     Fallback="Claims General",   Status="Active" },
            new RoutingRule { Priority=2,  Name="Commercial Claims > $25K - Sr. Adjuster", QueueType="Claims",          Condition="claim.reserve > 25000",             AssignTo="Senior Adjusters",      Fallback="Claims General",   Status="Active" },
            new RoutingRule { Priority=3,  Name="New Commercial Leads - Sales Team",        QueueType="Leads",           Condition="lead.type == 'Commercial'",         AssignTo="Commercial Sales",      Fallback="General Sales",    Status="Active" },
            new RoutingRule { Priority=4,  Name="Download Exceptions - Ops Team",           QueueType="Downloads",       Condition="download.status == 'Exception'",    AssignTo="Operations Queue",      Fallback="Admin",            Status="Active" },
            new RoutingRule { Priority=5,  Name="Portal Service Requests - CSR Team",       QueueType="Service Requests",Condition="request.source == 'Portal'",        AssignTo="CSR Team",              Fallback="General CSR",      Status="Active" },
            new RoutingRule { Priority=6,  Name="Tasks unassigned > 3 days - Manager",      QueueType="Tasks",           Condition="task.age_days > 3 AND assignee IS NULL",AssignTo="Service Manager",Fallback="Admin",            Status="Active" },
            new RoutingRule { Priority=7,  Name="Personal Lines Renewals - CSR by ZIP",     QueueType="Tasks",           Condition="task.type == 'Renewal' AND policy.lob == 'Personal'",AssignTo="ZIP-based CSR map",Fallback="CSR General",Status="Active" },
            new RoutingRule { Priority=8,  Name="Leads from MarketingBlast - Round Robin",  QueueType="Leads",           Condition="lead.source == 'EmailBlast'",       AssignTo="Round Robin Pool",      Fallback="General Sales",    Status="Inactive" },
        ];
    }

    private sealed class RoutingRule { public int Priority{get;set;} public string Name{get;set;}=string.Empty; public string QueueType{get;set;}=string.Empty; public string Condition{get;set;}=string.Empty; public string AssignTo{get;set;}=string.Empty; public string Fallback{get;set;}=string.Empty; public string Status{get;set;}=string.Empty; }
}
