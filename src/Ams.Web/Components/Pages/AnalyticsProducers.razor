@page "/analytics/producers"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>Producer Performance — AMS</PageTitle>

<AppPageHeader Title="Producer Performance"
               Subtitle="Individual and team-level production, retention, commissions, activity, and goal attainment"
               Icon="bi-person-badge">
    <Actions>
        <button class="um-btn um-btn-ghost"><i class="bi bi-download" aria-hidden="true"></i> Export Scorecards</button>
    </Actions>
</AppPageHeader>

<!-- Team summary KPIs -->
<div class="pp-kpi-strip">
    <div class="pp-kpi-card"><div class="pp-kpi-icon pp-ki-blue"><i class="bi bi-people" aria-hidden="true"></i></div><div><div class="pp-kv">18</div><div class="pp-kl">Active Producers</div></div></div>
    <div class="pp-kpi-card"><div class="pp-kpi-icon pp-ki-green"><i class="bi bi-graph-up" aria-hidden="true"></i></div><div><div class="pp-kv">$482K</div><div class="pp-kl">New Business MTD</div></div></div>
    <div class="pp-kpi-card"><div class="pp-kpi-icon pp-ki-blue"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></div><div><div class="pp-kv">88.4%</div><div class="pp-kl">Team Retention</div></div></div>
    <div class="pp-kpi-card"><div class="pp-kpi-icon pp-ki-amber"><i class="bi bi-bullseye" aria-hidden="true"></i></div><div><div class="pp-kv">76%</div><div class="pp-kl">At or Above Goal</div></div></div>
    <div class="pp-kpi-card"><div class="pp-kpi-icon pp-ki-purple"><i class="bi bi-percent" aria-hidden="true"></i></div><div><div class="pp-kv">$218K</div><div class="pp-kl">Commission Earned MTD</div></div></div>
</div>

<!-- Producer scorecards -->
<div class="pp-scorecard-grid">
    @foreach (var p in _producers)
    {
        <div class="pp-scorecard">
            <div class="pp-sc-hdr">
                <div class="pp-sc-av" style="background:@p.AvatarColor">@Initials(p.Name)</div>
                <div class="pp-sc-info">
                    <div class="pp-sc-name">@p.Name</div>
                    <div class="pp-sc-role">@p.Role · @p.Branch</div>
                </div>
                <span class="@GoalBadge(p.GoalPct)">@p.GoalPct%</span>
            </div>
            <div class="pp-sc-metrics">
                <div class="pp-sc-metric">
                    <div class="pp-sc-mv">@p.NewPolicies</div>
                    <div class="pp-sc-ml">New Policies</div>
                </div>
                <div class="pp-sc-metric">
                    <div class="pp-sc-mv">@p.Premium</div>
                    <div class="pp-sc-ml">New Premium</div>
                </div>
                <div class="pp-sc-metric">
                    <div class="pp-sc-mv @(p.Retention >= 88 ? "pp-good":"pp-warn")">@p.Retention%</div>
                    <div class="pp-sc-ml">Retention</div>
                </div>
                <div class="pp-sc-metric">
                    <div class="pp-sc-mv">@p.Commission</div>
                    <div class="pp-sc-ml">Commission</div>
                </div>
            </div>
            <!-- Goal progress bar -->
            <div class="pp-goal-wrap">
                <div class="pp-goal-lbl">Goal attainment</div>
                <div class="pp-goal-track">
                    <div class="pp-goal-fill @(p.GoalPct >= 100 ? "pp-gf-green" : p.GoalPct >= 75 ? "pp-gf-blue" : "pp-gf-amber")" style="width:@Math.Min(p.GoalPct,100)%"></div>
                </div>
            </div>
            <!-- Activity row -->
            <div class="pp-activity-row">
                <span class="pp-act"><i class="bi bi-telephone" aria-hidden="true"></i> @p.Calls calls</span>
                <span class="pp-act"><i class="bi bi-envelope" aria-hidden="true"></i> @p.Emails emails</span>
                <span class="pp-act"><i class="bi bi-calendar-check" aria-hidden="true"></i> @p.Meetings meetings</span>
            </div>
        </div>
    }
</div>

@code {
    private sealed class ProducerCard { public string Name{get;set;}=string.Empty; public string Role{get;set;}=string.Empty; public string Branch{get;set;}=string.Empty; public string AvatarColor{get;set;}="#dbeafe"; public int NewPolicies{get;set;} public string Premium{get;set;}=string.Empty; public int Retention{get;set;} public string Commission{get;set;}=string.Empty; public int GoalPct{get;set;} public int Calls{get;set;} public int Emails{get;set;} public int Meetings{get;set;} }

    private List<ProducerCard> _producers = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Analytics","/analytics/reports"), new("Producer Performance",""));
        _producers =
        [
            new ProducerCard { Name="Beth Nakamura",  Role="Senior Producer", Branch="Main",    AvatarColor="#dbeafe", NewPolicies=38, Premium="$94,200", Retention=92, Commission="$18,400", GoalPct=112, Calls=84, Emails=142, Meetings=18 },
            new ProducerCard { Name="Tom Reyes",      Role="Producer",        Branch="Main",    AvatarColor="#d1fae5", NewPolicies=31, Premium="$78,400", Retention=89, Commission="$14,800", GoalPct=94,  Calls=72, Emails=119, Meetings=14 },
            new ProducerCard { Name="Lisa Park",      Role="Producer",        Branch="North",   AvatarColor="#ede9fe", NewPolicies=28, Premium="$71,100", Retention=88, Commission="$13,200", GoalPct=88,  Calls=68, Emails=104, Meetings=11 },
            new ProducerCard { Name="Marcus Webb",    Role="Producer",        Branch="North",   AvatarColor="#fef3c7", NewPolicies=24, Premium="$59,800", Retention=84, Commission="$11,100", GoalPct=75,  Calls=61, Emails=98,  Meetings=9  },
            new ProducerCard { Name="Diana Ruiz",     Role="Producer",        Branch="South",   AvatarColor="#fee2e2", NewPolicies=22, Premium="$51,300", Retention=82, Commission="$9,800",  GoalPct=68,  Calls=54, Emails=88,  Meetings=8  },
            new ProducerCard { Name="Kevin Torres",   Role="Associate",       Branch="South",   AvatarColor="#d1fae5", NewPolicies=18, Premium="$38,100", Retention=79, Commission="$7,200",  GoalPct=57,  Calls=41, Emails=74,  Meetings=6  },
        ];
    }

    private static string Initials(string name) { var p=name.Trim().Split(' ',StringSplitOptions.RemoveEmptyEntries); return p.Length>=2?$"{p[0][0]}{p[^1][0]}":name.Length>0?name[..1]:"?"; }
    private static string GoalBadge(int g) => g>=100?"pp-goal-chip pp-gc-green":g>=75?"pp-goal-chip pp-gc-blue":"pp-goal-chip pp-gc-amber";
}
