@page "/analytics/producers"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Features.Forecast
@using Microsoft.AspNetCore.Components.Forms
@inject ApiClient Api
@inject ProducerWorkbenchApiClient ProducerWorkbench
@inject CurrentUserContext CurrentUser
@inject IJSRuntime Js

<PageTitle>Producer Analytics — AMS</PageTitle>

<AppPageHeader Title="Producer Analytics"
               Subtitle="Enterprise producer command center for goal attainment, premium production, pipeline velocity, quote conversion, renewal retention, commissions, coaching, and report delivery."
               Icon="bi-person-badge">
    <Actions>
        <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_busy"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="SyncCommissionDataAsync" disabled="@_busy"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Sync Commissions</button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="LogSelectedContactAsync" disabled="@(!CanLogContact || _busy)"><i class="bi bi-telephone-outbound" aria-hidden="true"></i> Log Contact</button>
        <button class="um-btn um-btn-ghost" type="button" @onclick="OpenScheduleForSelected" disabled="@(_selectedReport is null || _busy)"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Schedule Report</button>
        <button class="um-btn um-btn-primary" type="button" @onclick="ExportProducerPackAsync" disabled="@(!_producerReports.Any() || _busy)"><i class="bi bi-download" aria-hidden="true"></i> Export Producer Pack</button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="ap-toast @_toastClass" role="status">
        <i class="bi @(_toastClass == "ap-toast--danger" ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="ap-toast-close" @onclick="ClearToast" aria-label="Dismiss message"><i class="bi bi-x-lg"></i></button>
    </div>
}

<div class="ap-page">
    <section class="ap-hero">
        <div class="ap-hero-main">
            <div class="ap-eyebrow"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Producer growth cockpit</div>
            <h2>@FormatCurrency(TotalManagedPremium) premium focus with @ProducerReadinessScore% producer readiness</h2>
            <p>Rank producer performance by goal attainment, written premium, active pipeline, quote conversion, renewal retention, coaching urgency, commission readiness, and sales workflow execution.</p>
            <div class="ap-hero-meta">
                <span><i class="bi bi-trophy"></i> @AverageGoalPct.ToString("N1")% goal attainment</span>
                <span><i class="bi bi-funnel"></i> @FormatCurrency(TotalPipeline) weighted pipeline</span>
                <span><i class="bi bi-file-earmark-text"></i> @QuoteFollowupCount quote follow-ups</span>
                <span><i class="bi bi-cash-stack"></i> @FormatCurrency(NetCommissionPayout) net payout</span>
            </div>
        </div>
        <div class="ap-hero-panel">
            <div class="ap-score-card">
                <span>Producer readiness score</span>
                <strong>@ProducerReadinessScore%</strong>
                <div class="ap-score-track"><div style="width:@ProducerReadinessScore%"></div></div>
                <small>@ProducerReadinessSummary</small>
            </div>
            <div class="ap-priority-list">
                @foreach (var item in PriorityItems)
                {
                    <button type="button" class="ap-priority-item" @onclick="() => SelectAnalyticsItem(item)">
                        <span class="ap-risk ap-risk--@PriorityCss(item.Priority)">@ItemScore(item)</span>
                        <div><strong>@item.Title</strong><small>@item.NextAction</small></div>
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="ap-kpi-strip" aria-label="Producer KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="ap-kpi-card @(IsActiveKpi(kpi.Key) ? "ap-kpi-card--active" : null)" title="@kpi.Tooltip" @onclick="() => SetKpi(kpi.Key)">
                <span class="ap-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="ap-kpi-label">@kpi.Label</span>
                <strong>@kpi.Value</strong>
                <small>@kpi.Detail</small>
            </button>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger ap-load-error" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError
        </div>
    }

    <section class="ap-command-bar">
        <div class="ap-search-wrap">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input class="ap-search" placeholder="Search producer analytics, producers, branches, pipeline, quotes, renewals, commissions, owners, workflows, or status…" @bind="_search" @bind:event="oninput" />
        </div>
        <select class="ap-select" @bind="_segmentFilter">
            <option value="">All segments</option>
            @foreach (var segment in Segments)
            {
                <option value="@segment">@segment</option>
            }
        </select>
        <select class="ap-select" @bind="_priorityFilter">
            <option value="">All priorities</option>
            <option value="Critical">Critical</option>
            <option value="High">High</option>
            <option value="Normal">Normal</option>
        </select>
        <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
        <button type="button" class="um-btn um-btn-ghost" @onclick="RunProducerReportsAsync" disabled="@(!_producerReports.Any() || _busy)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run Producer Reports</button>
    </section>

    <div class="ap-tabs" role="tablist" aria-label="Producer analytics views">
        @foreach (var tab in _tabs)
        {
            <button type="button" role="tab" class="ap-tab @(_activeTab == tab.Key ? "ap-tab--active" : null)" @onclick="() => SetTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </div>

    @if (_loading)
    {
        <div class="ap-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading producer analytics...</div>
    }
    else
    {
        <section class="ap-grid">
            <article class="ap-panel ap-panel--main">
                <div class="ap-panel-header"><i class="bi @ActiveIcon" aria-hidden="true"></i><div><strong>@ActiveListTitle</strong><span>@FilteredItemCount.ToString("N0") producer records ranked by premium impact, workflow urgency, coaching risk, conversion, and due date.</span></div></div>
                @if (!FilteredItems.Any())
                {
                    <div class="ap-empty"><i class="bi bi-person-badge" aria-hidden="true"></i><strong>No producer records match this view</strong><span>Adjust filters or refresh seeded producer analytics.</span></div>
                }
                else
                {
                    <div class="ap-item-list">
                        @foreach (var item in FilteredItems)
                        {
                            <button type="button" class="ap-item-row @(_selectedItem?.Title == item.Title ? "ap-item-row--active" : null)" @onclick="() => SelectAnalyticsItem(item)">
                                <span class="ap-module-icon ap-module-icon--@CategoryCss(item.Category)"><i class="bi @CategoryIcon(item.Category)" aria-hidden="true"></i></span>
                                <div class="ap-item-main">
                                    <div class="ap-item-title"><strong>@item.Title</strong><span class="ap-badge ap-badge--@CategoryCss(item.Category)">@item.Category</span><span class="ap-badge ap-badge--type">@item.Workflow</span></div>
                                    <p>@item.Insight</p>
                                    <div class="ap-item-meta"><span>@item.Owner</span><span>@item.Segment</span><span>@item.Count.ToString("N0") items</span><span>@FormatCurrency(item.Premium)</span><span>@item.GoalPct.ToString("N1")% goal</span><span>due @FormatDate(item.DueDateUtc)</span></div>
                                </div>
                                <span class="ap-row-score">@ItemScore(item)</span>
                            </button>
                        }
                    </div>
                }
            </article>

            <aside class="ap-side">
                @if (_selectedItem is null)
                {
                    <div class="ap-panel"><div class="ap-empty ap-empty--side"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a producer priority</strong><span>Choose a goal, pipeline, quote, retention, or commission priority to inspect workflow and actions.</span></div></div>
                }
                else
                {
                    <article class="ap-panel">
                        <div class="ap-panel-header"><i class="bi @CategoryIcon(_selectedItem.Category)" aria-hidden="true"></i><div><strong>Producer command</strong><span>@_selectedItem.Priority · @_selectedItem.Status</span></div></div>
                        <div class="ap-detail">
                            <div class="ap-detail-head">
                                <span class="ap-module-icon ap-module-icon--@CategoryCss(_selectedItem.Category)"><i class="bi @CategoryIcon(_selectedItem.Category)" aria-hidden="true"></i></span>
                                <div><strong>@_selectedItem.Title</strong><span>@_selectedItem.Insight</span></div>
                            </div>
                            <dl>
                                <dt>Premium</dt><dd>@FormatCurrency(_selectedItem.Premium)</dd>
                                <dt>Pipeline</dt><dd>@FormatCurrency(_selectedItem.Pipeline)</dd>
                                <dt>Items</dt><dd>@_selectedItem.Count.ToString("N0")</dd>
                                <dt>Goal</dt><dd>@_selectedItem.GoalPct.ToString("N1")%</dd>
                                <dt>Conversion</dt><dd>@_selectedItem.ConversionPct.ToString("N1")%</dd>
                                <dt>Retention</dt><dd>@_selectedItem.RetentionPct.ToString("N1")%</dd>
                                <dt>Trend</dt><dd class="@TrendCss(_selectedItem.TrendPct)">@FormatSigned(_selectedItem.TrendPct)%</dd>
                                <dt>Next action</dt><dd>@_selectedItem.NextAction</dd>
                            </dl>
                            <div class="ap-detail-actions">
                                <button type="button" class="um-btn um-btn-ghost" @onclick="CreateForecastFromSelectionAsync" disabled="@_busy"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Add Forecast</button>
                                <button type="button" class="um-btn um-btn-ghost" @onclick="LogSelectedContactAsync" disabled="@(!CanLogContact || _busy)"><i class="bi bi-telephone-outbound" aria-hidden="true"></i> Log Contact</button>
                                <button type="button" class="um-btn um-btn-ghost" @onclick="FocusProducerReport" disabled="@(_selectedReport is null)"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i> Focus Report</button>
                                <button type="button" class="um-btn um-btn-primary" @onclick="RunSelectedReportAsync" disabled="@(_selectedReport is null || _busy)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run</button>
                            </div>
                        </div>
                    </article>
                }

                <article class="ap-panel">
                    <div class="ap-panel-header"><i class="bi bi-trophy" aria-hidden="true"></i><div><strong>Producer leaderboard</strong><span>Live agency producer performance by premium and goal health.</span></div></div>
                    <div class="ap-case-list">
                        @foreach (var producer in ProducersByImportance.Take(6))
                        {
                            <button type="button" class="ap-case-row @(_selectedProducer?.UserId == producer.UserId ? "ap-case-row--active" : null)" @onclick="() => SelectProducer(producer)">
                                <div><strong>@producer.DisplayName</strong><span>@producer.BranchName · @FormatCurrency(producer.WrittenPremiumYtd) YTD · @producer.QuoteConversionRate.ToString("N1")% quote</span></div>
                                <div class="ap-case-metrics"><strong>@ProducerScore(producer)</strong><span class="ap-risk-label ap-risk-label--@ProducerRiskClass(producer)">score</span></div>
                            </button>
                        }
                        @if (!_producers.Any())
                        {
                            <div class="ap-empty ap-empty--compact"><i class="bi bi-people" aria-hidden="true"></i><strong>No producer performance loaded</strong><span>Refresh to sync agency dashboard producer performance.</span></div>
                        }
                    </div>
                </article>

                <article class="ap-panel">
                    <div class="ap-panel-header"><i class="bi bi-lightning-charge" aria-hidden="true"></i><div><strong>Producer actions</strong><span>Goal, pipeline, activity, commission, and report workflow.</span></div></div>
                    <div class="ap-action-list">
                        <button type="button" class="um-btn um-btn-ghost" @onclick="CreateForecastFromProducerAsync" disabled="@(_selectedProducer is null || _busy)"><i class="bi bi-bar-chart-line" aria-hidden="true"></i> Add Producer Forecast</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="RescoreSelectedCrossSellAsync" disabled="@(_selectedCrossSell is null || _busy)"><i class="bi bi-stars" aria-hidden="true"></i> Rescore Cross-Sell</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="SyncCommissionDataAsync" disabled="@_busy"><i class="bi bi-cash-stack" aria-hidden="true"></i> Sync Commission Seeds</button>
                        <button type="button" class="um-btn um-btn-primary" @onclick="RunProducerReportsAsync" disabled="@(!_producerReports.Any() || _busy)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run Reports</button>
                    </div>
                </article>
            </aside>
        </section>

        <section class="ap-lower-grid">
            <article class="ap-panel">
                <div class="ap-panel-header"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i><div><strong>Workbench workflow</strong><span>Producer queues sorted by urgency and revenue impact.</span></div></div>
                <div class="ap-workflow-list">
                    @foreach (var row in WorkbenchRows.Take(8))
                    {
                        <button type="button" class="ap-workflow-row @(_selectedWorkbenchItem?.Id == row.Id ? "ap-workflow-row--active" : null)" @onclick="() => SelectWorkbenchItem(row)">
                            <span class="ap-workflow-icon"><i class="bi @row.Icon" aria-hidden="true"></i></span>
                            <div><strong>@row.Title</strong><span>@row.Detail</span></div>
                            <strong>@row.Score</strong>
                        </button>
                    }
                    @if (!WorkbenchRows.Any())
                    {
                        <div class="ap-empty ap-empty--compact"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No producer workbench rows loaded</strong><span>Refresh to sync leads, opportunities, quotes, renewals, and cross-sell.</span></div>
                    }
                </div>
            </article>

            <article class="ap-panel">
                <div class="ap-panel-header"><i class="bi bi-pie-chart" aria-hidden="true"></i><div><strong>Pipeline and revenue mix</strong><span>Highest-value producer growth pools.</span></div></div>
                <div class="ap-mix-list">
                    @foreach (var row in ProducerMix)
                    {
                        <div class="ap-mix-row">
                            <span>@row.Label</span>
                            <div><span style="width:@row.Percent.ToString("N0")%"></span></div>
                            <strong>@FormatCurrency(row.Amount)</strong>
                        </div>
                    }
                </div>
            </article>

            <article class="ap-panel">
                <div class="ap-panel-header"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i><div><strong>Producer report workflow</strong><span>Preview, run, export, and scheduled delivery.</span></div></div>
                <div class="ap-report-list">
                    @foreach (var report in ProducerReportsByImportance.Take(6))
                    {
                        <button type="button" class="ap-report-row @(_selectedReport?.ReportDefinitionId == report.ReportDefinitionId ? "ap-report-row--active" : null)" @onclick="() => SelectReport(report)">
                            <div><strong>@report.ReportName</strong><span>@report.ReportTypeCode · @report.OutputFormats · @LastRunLabel(report.ReportDefinitionId)</span></div>
                            <span>@ReportScore(report)</span>
                        </button>
                    }
                    @if (!_producerReports.Any())
                    {
                        <div class="ap-empty ap-empty--compact"><i class="bi bi-file-earmark-x" aria-hidden="true"></i><strong>No Producer module reports found</strong><span>Producer analytics still uses seeded records, workbench queues, commission data, and live performance data.</span></div>
                    }
                </div>
            </article>
        </section>
    }
</div>

@if (_showSchedule)
{
    <div class="ap-modal-backdrop" role="presentation" @onclick="CloseSchedule">
        <div class="ap-modal" role="dialog" aria-modal="true" aria-label="Schedule producer report" @onclick:stopPropagation="true">
            <EditForm EditContext="_scheduleEditContext" OnValidSubmit="ScheduleAsync">
                <DataAnnotationsValidator />
                <div class="ap-modal-header">
                    <i class="bi bi-calendar-plus" aria-hidden="true"></i>
                    <span>Schedule producer report</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseSchedule"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="ap-modal-body">
                    @if (!string.IsNullOrWhiteSpace(_formError))
                    {
                        <div class="alert alert-danger ap-load-error" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_formError</div>
                    }
                    <div class="ap-form-grid">
                        <label>Report
                            <select class="ap-input" @bind="_scheduleForm.ReportDefinitionId">
                                @foreach (var report in ProducerReportsByImportance)
                                {
                                    <option value="@report.ReportDefinitionId">@report.ReportName</option>
                                }
                            </select>
                            <ValidationMessage For="() => _scheduleForm.ReportDefinitionId" class="text-danger" />
                        </label>
                        <label>Frequency
                            <select class="ap-input" @bind="_scheduleForm.FrequencyCode">
                                @foreach (var frequency in _frequencyOptions)
                                {
                                    <option value="@frequency">@frequency</option>
                                }
                            </select>
                            <ValidationMessage For="() => _scheduleForm.FrequencyCode" class="text-danger" />
                        </label>
                        <label>Output format
                            <select class="ap-input" @bind="_scheduleForm.OutputFormat">
                                @foreach (var format in _formatOptions)
                                {
                                    <option value="@format">@format</option>
                                }
                            </select>
                            <ValidationMessage For="() => _scheduleForm.OutputFormat" class="text-danger" />
                        </label>
                        <label>Delivery email
                            <input class="ap-input" @bind="_scheduleForm.DeliveryEmail" />
                            <ValidationMessage For="() => _scheduleForm.DeliveryEmail" class="text-danger" />
                        </label>
                    </div>
                </div>
                <div class="ap-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseSchedule">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi bi-check2" aria-hidden="true"></i> Schedule</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private readonly TabItem[] _tabs =
    [
        new("all", "Command", "bi-speedometer2"),
        new("goals", "Goals", "bi-trophy"),
        new("pipeline", "Pipeline", "bi-funnel"),
        new("quotes", "Quotes", "bi-file-earmark-text"),
        new("renewals", "Renewals", "bi-arrow-repeat"),
        new("commissions", "Commissions", "bi-cash-stack"),
        new("reports", "Reports", "bi-file-earmark-bar-graph")
    ];

    private readonly string[] _frequencyOptions = ["Daily", "Weekly", "Monthly", "Quarterly"];
    private readonly string[] _formatOptions = ["PDF", "Excel", "CSV"];

    private Guid _tenantId;
    private Guid? _currentUserId;
    private bool _loading;
    private bool _saving;
    private bool _showSchedule;
    private string _search = string.Empty;
    private string _activeKpi = "all";
    private string _activeTab = "all";
    private string _segmentFilter = string.Empty;
    private string _priorityFilter = string.Empty;
    private string? _loadError;
    private string? _formError;
    private string? _toastMessage;
    private string _toastClass = "ap-toast--success";
    private List<ProducerAnalyticsRecord> _producerItems = [];
    private List<ProducerPerformanceDto> _producers = [];
    private ProducerWorkbenchDto _workbench = new();
    private List<CommissionPayeeDto> _payees = [];
    private List<CommissionTransactionDto> _commissionTransactions = [];
    private List<CommissionPayoutStatementDto> _payoutStatements = [];
    private List<CommissionExceptionDto> _commissionExceptions = [];
    private List<MarketingCrossSellOpportunityDto> _crossSell = [];
    private List<ForecastEntryDto> _forecastEntries = [];
    private RenewalPipelineDto _renewalPipeline = new();
    private List<ReportDefinitionDto> _producerReports = [];
    private List<ReportExecutionDto> _executions = [];
    private List<ReportScheduleDto> _schedules = [];
    private ProducerAnalyticsRecord? _selectedItem;
    private ProducerPerformanceDto? _selectedProducer;
    private WorkbenchRow? _selectedWorkbenchItem;
    private MarketingCrossSellOpportunityDto? _selectedCrossSell;
    private ReportDefinitionDto? _selectedReport;
    private ScheduleForm _scheduleForm = new();
    private EditContext _scheduleEditContext = default!;
    private bool _busy => _loading || _saving;

    private decimal TotalProducerPremium => _producers.Sum(p => p.WrittenPremiumYtd);
    private decimal TotalPipeline => _producerItems.Sum(i => i.Pipeline) + _workbench.Counts.OppsPremium + _workbench.Goal.PipelineValue + _forecastEntries.Sum(f => f.PipelineAmount);
    private decimal TotalManagedPremium => _producerItems.Sum(i => i.Premium) + TotalProducerPremium + _workbench.Goal.WrittenPremium;
    private decimal NetCommissionPayout => _payoutStatements.Sum(s => s.NetPayout) + _commissionTransactions.Sum(t => t.CommissionAmount);
    private int QuoteFollowupCount => _workbench.Counts.QuoteFollowups + _workbench.QuoteFollowups.Count + _producers.Sum(p => p.QuotesMtd);
    private int ScheduledReportCount => _producerReports.Count(r => IsScheduled(r.ReportDefinitionId));
    private double AverageGoalPct => _producers.Any() ? _producers.Average(ProducerGoalPct) : _workbench.Goal.WrittenPct;
    private int ProducerReadinessScore => Math.Clamp(55 + Math.Min(12, _producerItems.Count * 2) + Math.Min(12, _producers.Count(p => ProducerGoalPct(p) >= 90) * 3) + Math.Min(10, ScheduledReportCount * 4) + Math.Min(11, _workbench.Messages.Count(m => !m.IsRead) == 0 ? 11 : 6), 0, 100);
    private string ProducerReadinessSummary => ProducerReadinessScore >= 90 ? "Producer performance is executive ready" : ProducerReadinessScore >= 80 ? "Producer workflow is healthy with focused coaching and pipeline actions" : "Sync commissions, run producer reports, and coach low-conversion or under-goal producers";
    private IEnumerable<string> Segments => _producerItems.Select(i => i.Segment).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s);
    private IEnumerable<ProducerAnalyticsRecord> PriorityItems => _producerItems.OrderByDescending(ItemScore).ThenBy(i => i.DueDateUtc).Take(4);
    private IEnumerable<ProducerPerformanceDto> ProducersByImportance => _producers.OrderByDescending(ProducerScore).ThenByDescending(p => p.WrittenPremiumYtd);
    private IEnumerable<ReportDefinitionDto> ProducerReportsByImportance => _producerReports.OrderByDescending(ReportScore).ThenBy(r => r.ReportName);
    private IEnumerable<WorkbenchRow> WorkbenchRows => BuildWorkbenchRows().OrderByDescending(r => r.Score).ThenBy(r => r.Title).ToList();
    private IEnumerable<MixRow> ProducerMix
    {
        get
        {
            var rows = new[]
            {
                new MixRow("Written premium YTD", TotalProducerPremium),
                new MixRow("Pipeline and forecast", TotalPipeline),
                new MixRow("Cross-sell premium", _workbench.Counts.CrossSellPremium + _crossSell.Sum(c => c.EstimatedPremium)),
                new MixRow("Net commissions", NetCommissionPayout)
            };
            var max = Math.Max(1, rows.Max(r => r.Amount));
            return rows.Select(r => r with { Percent = Math.Clamp((double)(r.Amount / max * 100), 4, 100) });
        }
    }
    private IEnumerable<ProducerAnalyticsRecord> FilteredItems => _producerItems
        .Where(MatchesSearch)
        .Where(i => string.IsNullOrWhiteSpace(_segmentFilter) || i.Segment == _segmentFilter)
        .Where(i => string.IsNullOrWhiteSpace(_priorityFilter) || i.Priority == _priorityFilter)
        .Where(MatchesActiveView)
        .OrderByDescending(ItemScore)
        .ThenBy(i => i.DueDateUtc)
        .ToList();
    private int FilteredItemCount => FilteredItems.Count();
    private bool CanLogContact => _selectedWorkbenchItem is not null && (_selectedWorkbenchItem.Type == "Lead" || _selectedWorkbenchItem.Type == "Opportunity" || _selectedWorkbenchItem.Type == "Quote" || _selectedWorkbenchItem.Type == "Renewal" || _selectedWorkbenchItem.Type == "CrossSell");

    private IEnumerable<KpiItem> Kpis =>
    [
        new("all", "Premium", "bi-speedometer2", FormatCurrency(TotalManagedPremium), $"{_producerItems.Count:N0} priorities", "Show all producer command records"),
        new("goals", "Goals", "bi-trophy", $"{AverageGoalPct:N1}%", $"{_producers.Count:N0} producers", "Filter producer goal attainment records"),
        new("pipeline", "Pipeline", "bi-funnel", FormatCurrency(TotalPipeline), $"{_workbench.Counts.OpenOpportunities:N0} opportunities", "Filter pipeline and forecast records"),
        new("quotes", "Quotes", "bi-file-earmark-text", QuoteFollowupCount.ToString("N0"), $"{AverageQuoteConversion:N1}% conversion", "Filter quote follow-up and conversion records"),
        new("renewals", "Renewals", "bi-arrow-repeat", RenewalCount.ToString("N0"), $"{AverageRetention:N1}% retention", "Filter renewal retention records"),
        new("commissions", "Commissions", "bi-cash-stack", FormatCurrency(NetCommissionPayout), $"{_commissionExceptions.Count:N0} exceptions", "Filter commission payout and exception records"),
        new("reports", "Reports", "bi-file-earmark-bar-graph", _producerReports.Count.ToString("N0"), $"{ScheduledReportCount:N0} scheduled", "Filter Producer module reports")
    ];

    private double AverageQuoteConversion => _producers.Any() ? _producers.Average(p => (double)p.QuoteConversionRate) : 0;
    private double AverageRetention => _producers.Any() ? _producers.Average(p => (double)p.RetentionRate) : _workbench.Goal.RetentionRate;
    private int RenewalCount => _workbench.Counts.RenewalCallList + _workbench.RenewalCallList.Count + _renewalPipeline.Rows.Count;
    private string ActiveListTitle => _activeTab switch
    {
        "goals" => "Producer goal attainment and coaching queue",
        "pipeline" => "Producer pipeline acceleration and forecast queue",
        "quotes" => "Quote conversion and follow-up discipline",
        "renewals" => "Renewal retention and producer save workflow",
        "commissions" => "Commission payout, split, and exception review",
        "reports" => "Producer reporting workflow",
        _ => "Enterprise producer command queue"
    };
    private string ActiveIcon => _activeTab switch
    {
        "goals" => "bi-trophy",
        "pipeline" => "bi-funnel",
        "quotes" => "bi-file-earmark-text",
        "renewals" => "bi-arrow-repeat",
