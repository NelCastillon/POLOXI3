    private IEnumerable<WorkbenchRow> BuildWorkbenchRows()
    {
        foreach (var lead in _workbench.MyLeads)
            yield return new WorkbenchRow(lead.LeadId, "Lead", lead.FullName.Length == 0 ? lead.LeadNumber : lead.FullName, $"{lead.PriorityCode ?? "Lead"} · score {lead.Score?.ToString() ?? "n/a"} · {lead.DaysSinceActivity} days since activity", "bi-person-plus", Math.Clamp((lead.Score ?? 40) + Math.Min(30, lead.DaysSinceActivity * 3), 0, 100));
        foreach (var opp in _workbench.MyOpportunities)
            yield return new WorkbenchRow(opp.OpportunityId, "Opportunity", opp.OpportunityName, $"{opp.AccountName} · {FormatCurrency(opp.EstimatedAmount)} · {opp.WinProbability}% win", "bi-funnel", Math.Clamp((int)Math.Min(45, opp.EstimatedAmount / 10000) + opp.WinProbability + (opp.IsClosingSoon ? 20 : 0), 0, 100));
        foreach (var quote in _workbench.QuoteFollowups)
            yield return new WorkbenchRow(quote.QuoteId, "Quote", quote.AccountName ?? quote.QuoteNumber, $"{FormatCurrency(quote.TotalAmount)} · {quote.StatusCode} · valid {FormatDate(quote.ValidUntilDate ?? quote.CreatedDateUtc)}", "bi-file-earmark-text", Math.Clamp((int)Math.Min(45, quote.TotalAmount / 10000) + (quote.IsExpired ? 45 : quote.IsExpiringSoon ? 30 : 12), 0, 100));
        foreach (var renewal in _workbench.RenewalCallList)
            yield return new WorkbenchRow(renewal.RenewalId, "Renewal", renewal.AccountName ?? renewal.RenewalNumber, $"{FormatCurrency(renewal.TotalContractValue ?? 0)} · {renewal.DaysTillRenewal} days · {renewal.StatusCode}", "bi-arrow-repeat", Math.Clamp((int)Math.Min(50, (renewal.TotalContractValue ?? 0) / 10000) + (renewal.IsUrgent ? 35 : 12), 0, 100));
        foreach (var cross in _workbench.CrossSellList)
            yield return new WorkbenchRow(cross.AccountId, "CrossSell", cross.AccountName, $"{cross.TargetLob} · {FormatCurrency(cross.OppPremium)} · score {cross.Score:N0}", "bi-bullseye", Math.Clamp((int)Math.Min(45, cross.OppPremium / 10000) + (int)cross.Score, 0, 100));
    }

    private async Task DownloadFileAsync(ReportDownloadFile file)
    {
        var fileName = file.FileName.Replace("'", string.Empty);
        var base64 = Convert.ToBase64String(file.Content);
        var script = $"(() => {{ const a = document.createElement(\"a\"); a.href = \"data:application/vnd.ms-excel;base64,{base64}\"; a.download = \"{fileName}\"; document.body.appendChild(a); a.click(); a.remove(); }})()";
        await Js.InvokeVoidAsync("eval", script);
    }

    private static string PreferredFormat(ReportDefinitionDto report) => report.OutputFormats.Contains("Excel", StringComparison.OrdinalIgnoreCase) ? "Excel" : report.OutputFormats.Contains("CSV", StringComparison.OrdinalIgnoreCase) ? "CSV" : "PDF";
    private bool IsScheduled(Guid reportId) => _schedules.Any(s => s.ReportDefinitionId == reportId && s.IsActive);
    private string LastRunLabel(Guid reportId) => _executions.Where(e => e.ReportDefinitionId == reportId).OrderByDescending(e => e.CreatedDateUtc).Select(e => e.CompletedDateUtc.HasValue ? $"last {FormatDate(e.CompletedDateUtc.Value)}" : e.StatusCode).FirstOrDefault() ?? "not run";
    private int ReportScore(ReportDefinitionDto report) => (report.IsSystemReport ? 20 : 10) + (IsScheduled(report.ReportDefinitionId) ? 20 : 0) + (report.OutputFormats.Contains("Excel", StringComparison.OrdinalIgnoreCase) ? 10 : 0) + (IsProducerReport(report) ? 30 : 12);
    private static int ItemScore(ProducerAnalyticsRecord item) => Math.Clamp((item.Priority == "Critical" ? 44 : item.Priority == "High" ? 30 : 18) + (int)Math.Min(20, item.Premium / 25000) + (int)Math.Min(16, item.Pipeline / 50000) + (int)Math.Max(0, 12 - (item.DueDateUtc - DateTime.UtcNow).TotalDays) + (int)Math.Max(0, 100 - item.GoalPct) / 4, 0, 100);
    private static double ProducerGoalPct(ProducerPerformanceDto producer) => producer.WrittenPremiumYtd <= 0 ? 0 : Math.Clamp((double)(producer.WrittenPremiumMtd * 12 / producer.WrittenPremiumYtd * 100), 0, 150);
    private static int ProducerScore(ProducerPerformanceDto producer) => Math.Clamp((int)Math.Min(45, producer.WrittenPremiumYtd / 25000) + (int)Math.Min(20, producer.QuoteConversionRate) + (int)Math.Min(20, producer.RetentionRate / 5) + Math.Min(15, producer.OpenOpportunities), 0, 100);
    private static string ProducerRiskClass(ProducerPerformanceDto producer) => ProducerScore(producer) >= 75 ? "normal" : ProducerScore(producer) >= 55 ? "high" : "critical";
    private static string PriorityCss(string priority) => priority switch { "Critical" => "critical", "High" => "high", "Normal" => "normal", _ => "standard" };
    private static string CategoryCss(string category) => category switch { "Goal" => "blue", "Pipeline" => "green", "Quotes" => "purple", "Retention" => "cyan", "Commissions" => "amber", _ => "slate" };
    private static string CategoryIcon(string category) => category switch { "Goal" => "bi-trophy", "Pipeline" => "bi-funnel", "Quotes" => "bi-file-earmark-text", "Retention" => "bi-arrow-repeat", "Commissions" => "bi-cash-stack", _ => "bi-person-badge" };
    private static string TrendCss(double value) => value >= 0 ? "ap-trend-up" : "ap-trend-down";
    private static string FormatSigned(double value) => value >= 0 ? $"+{value:N1}" : value.ToString("N1");
    private static string FormatCurrency(decimal value) => value >= 1000000 ? $"{value / 1000000m:C1}M" : value >= 1000 ? $"{value / 1000m:C0}K" : value.ToString("C0");
    private static string FormatDate(DateTime value) => value.ToLocalTime().ToString("MMM d");
    private void ShowToast(string message, bool danger = false) { _toastMessage = message; _toastClass = danger ? "ap-toast--danger" : "ap-toast--success"; }
    private void ClearToast() => _toastMessage = null;

