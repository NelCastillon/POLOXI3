    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _currentUserId = context.UserId;
        _scheduleEditContext = new(_scheduleForm);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var records = await Api.SearchDashboardRecordsAsync(_tenantId, "ProducerAnalytics", _search);
            var producers = await Api.GetProducerPerformanceAsync(_tenantId, 50);
            var workbench = await ProducerWorkbench.GetWorkbenchAsync(_tenantId, _currentUserId);
            var payees = await Api.SearchCommissionPayeesAsync(_tenantId, _search);
            var transactions = await Api.SearchCommissionTransactionsAsync(_tenantId, _search);
            var statements = await Api.SearchCommissionPayoutStatementsAsync(_tenantId, _search);
            var exceptions = await Api.SearchCommissionExceptionsAsync(_tenantId, _search);
            var crossSell = await Api.SearchMarketingCrossSellAsync(_tenantId);
            var forecast = await Api.SearchForecastEntriesAsync(_tenantId, _search);
            var renewals = await Api.GetRenewalPipelineAsync(_tenantId);
            var definitions = await Api.SearchReportDefinitionsAsync("Producer");
            var executions = await Api.SearchReportExecutionsAsync(_tenantId, null);
            var schedules = await Api.SearchReportSchedulesAsync(_tenantId, "Producer");

            _producerItems = records?.Items.Select(r => DeserializeProducerRecord(r.Id, r.JsonData)).Where(r => r is not null).Cast<ProducerAnalyticsRecord>().ToList() ?? [];
            _producers = producers?.ToList() ?? [];
            _workbench = workbench ?? new();
            _payees = payees?.Items.ToList() ?? [];
            _commissionTransactions = transactions?.Items.ToList() ?? [];
            _payoutStatements = statements?.Items.ToList() ?? [];
            _commissionExceptions = exceptions?.Items.ToList() ?? [];
            _crossSell = crossSell?.Items.ToList() ?? [];
            _forecastEntries = forecast?.Items.ToList() ?? [];
            _renewalPipeline = renewals ?? new();
            _producerReports = definitions?.Items.Where(IsProducerReport).ToList() ?? [];
            _executions = executions?.Items.Where(e => _producerReports.Any(r => r.ReportDefinitionId == e.ReportDefinitionId)).ToList() ?? [];
            _schedules = schedules?.Items.Where(s => _producerReports.Any(r => r.ReportDefinitionId == s.ReportDefinitionId)).ToList() ?? [];
            _selectedItem = _selectedItem is null ? FilteredItems.FirstOrDefault() : _producerItems.FirstOrDefault(i => i.Title == _selectedItem.Title) ?? FilteredItems.FirstOrDefault();
            _selectedProducer = _selectedProducer is null ? ProducersByImportance.FirstOrDefault() : _producers.FirstOrDefault(p => p.UserId == _selectedProducer.UserId) ?? ProducersByImportance.FirstOrDefault();
            _selectedWorkbenchItem = _selectedWorkbenchItem is null ? WorkbenchRows.FirstOrDefault() : WorkbenchRows.FirstOrDefault(w => w.Id == _selectedWorkbenchItem.Id) ?? WorkbenchRows.FirstOrDefault();
            _selectedCrossSell = _selectedCrossSell is null ? _crossSell.OrderByDescending(c => c.Score).FirstOrDefault() : _crossSell.FirstOrDefault(c => c.OpportunityId == _selectedCrossSell.OpportunityId) ?? _crossSell.OrderByDescending(c => c.Score).FirstOrDefault();
            _selectedReport = _selectedReport is null ? ProducerReportsByImportance.FirstOrDefault() : _producerReports.FirstOrDefault(r => r.ReportDefinitionId == _selectedReport.ReportDefinitionId) ?? ProducerReportsByImportance.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load producer analytics: {ex.Message}";
            _producerItems = [];
            ShowToast(_loadError, true);
        }
        finally
        {
            _loading = false;
        }
    }

    private static ProducerAnalyticsRecord? DeserializeProducerRecord(Guid id, string json)
    {
        try
        {
            var item = System.Text.Json.JsonSerializer.Deserialize<ProducerAnalyticsRecord>(json, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
            if (item is not null) item.Id = id;
            return item;
        }
        catch
        {
            return null;
        }
    }

    private static bool IsProducerReport(ReportDefinitionDto report) => report.ModuleCode.Contains("Producer", StringComparison.OrdinalIgnoreCase) || report.ModuleCode.Contains("Commission", StringComparison.OrdinalIgnoreCase) || report.ReportName.Contains("Producer", StringComparison.OrdinalIgnoreCase) || report.ReportName.Contains("Commission", StringComparison.OrdinalIgnoreCase) || report.ReportName.Contains("Goal", StringComparison.OrdinalIgnoreCase) || report.ReportName.Contains("Activity", StringComparison.OrdinalIgnoreCase);
    private bool MatchesSearch(ProducerAnalyticsRecord item) => string.IsNullOrWhiteSpace(_search) || item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.Category.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.Segment.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.Workflow.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.Status.Contains(_search, StringComparison.OrdinalIgnoreCase) || item.Insight.Contains(_search, StringComparison.OrdinalIgnoreCase) || _producers.Any(p => p.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase) || (p.BranchName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)) || _producerReports.Any(r => r.ReportName.Contains(_search, StringComparison.OrdinalIgnoreCase));
    private bool MatchesActiveView(ProducerAnalyticsRecord item) => _activeTab switch
    {
        "goals" => item.Category == "Goal" || item.Workflow.Contains("Goal", StringComparison.OrdinalIgnoreCase),
        "pipeline" => item.Category == "Pipeline" || item.Workflow.Contains("Pipeline", StringComparison.OrdinalIgnoreCase),
        "quotes" => item.Category == "Quotes" || item.Workflow.Contains("Quote", StringComparison.OrdinalIgnoreCase),
        "renewals" => item.Category == "Retention" || item.Workflow.Contains("Renewal", StringComparison.OrdinalIgnoreCase),
        "commissions" => item.Category == "Commissions" || item.Workflow.Contains("Commission", StringComparison.OrdinalIgnoreCase),
        "reports" => _producerReports.Any(),
        _ => true
    };

    private void SetKpi(string key) { _activeKpi = key; _activeTab = key; }
    private void SetTab(string key) { _activeTab = key; _activeKpi = key; }
    private void ResetFilters() { _search = string.Empty; _segmentFilter = string.Empty; _priorityFilter = string.Empty; _activeKpi = "all"; _activeTab = "all"; }
    private bool IsActiveKpi(string key) => _activeKpi == key;
    private void SelectAnalyticsItem(ProducerAnalyticsRecord item) => _selectedItem = item;
    private void SelectProducer(ProducerPerformanceDto producer) => _selectedProducer = producer;
    private void SelectWorkbenchItem(WorkbenchRow row) => _selectedWorkbenchItem = row;
    private void SelectReport(ReportDefinitionDto report) => _selectedReport = report;
    private void FocusProducerReport() { if (_selectedReport is null) return; _activeTab = "reports"; _activeKpi = "reports"; ShowToast($"Focused report workflow: {_selectedReport.ReportName}"); }

    private int TabCount(string key) => key switch
    {
        "goals" => _producerItems.Count(i => i.Category == "Goal") + _producers.Count,
        "pipeline" => _producerItems.Count(i => i.Category == "Pipeline") + _workbench.MyOpportunities.Count + _forecastEntries.Count,
        "quotes" => _producerItems.Count(i => i.Category == "Quotes") + _workbench.QuoteFollowups.Count,
        "renewals" => _producerItems.Count(i => i.Category == "Retention") + _workbench.RenewalCallList.Count + _renewalPipeline.Rows.Count,
        "commissions" => _producerItems.Count(i => i.Category == "Commissions") + _commissionTransactions.Count + _payoutStatements.Count,
        "reports" => _producerReports.Count,
        _ => _producerItems.Count
    };

