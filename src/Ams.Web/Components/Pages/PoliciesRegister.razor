@page "/policies"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Submissions
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Policies Register - AMS</PageTitle>

@if (_toastVisible)
{
    <div class="pr-toast pr-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="pr-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="ClosePolicyForm">
        <div class="mt-modal pr-action-modal" role="dialog" aria-modal="true" aria-labelledby="pr-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-shield-plus" aria-hidden="true"></i>
                <span id="pr-form-title">@(_policyForm.Id == Guid.Empty ? "New Policy" : $"Edit {_policyForm.PolicyNumber}")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="ClosePolicyForm" disabled="@_actionBusy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_policyForm" OnValidSubmit="SavePolicyAsync" OnInvalidSubmit="NotifyFormValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="pr-modal-intro">
                        <span class="pr-modal-chip"><i class="bi bi-shield-check" aria-hidden="true"></i> Policy administration</span>
                        <p>Create or maintain policy register data used by service, renewal, document, and compliance workflows.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full pr-dlg-section">Policy Identity</div>
                        <div class="um-field">
                            <label>Policy Number <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_policyForm.PolicyNumber" />
                        </div>
                        <div class="um-field">
                            <label>Status <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_policyForm.Status">
                                @foreach (var status in PolicyStatuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Line of Business <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_policyForm.Lob">
                                <option value="">Select LOB</option>
                                @foreach (var lob in LinesOfBusiness)
                                {
                                    <option value="@lob">@lob</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Carrier <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_policyForm.Carrier">
                                <option value="">Select carrier</option>
                                @foreach (var carrier in CarrierOptions)
                                {
                                    <option value="@carrier">@carrier</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="um-field um-field--full pr-dlg-section">Dates & Premium</div>
                        <div class="um-field">
                            <label>Effective Date <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="_policyForm.EffDate" />
                        </div>
                        <div class="um-field">
                            <label>Expiration Date <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="_policyForm.ExpDate" />
                        </div>
                        <div class="um-field">
                            <label>Written Premium</label>
                            <InputNumber class="form-control" @bind-Value="_policyForm.WrittenPremium" />
                        </div>
                        <div class="um-field">
                            <label>Annual Premium</label>
                            <InputNumber class="form-control" @bind-Value="_policyForm.AnnualPremium" />
                        </div>

                        <div class="um-field um-field--full pr-dlg-section">Assignment</div>
                        <div class="um-field um-field--full pr-account-picker-field">
                            <label>Account <span class="text-danger">*</span></label>
                            <div class="pr-account-picker" @onfocusout="CloseAccountDropdownAsync">
                                <div class="pr-account-picker-control">
                                    <i class="bi bi-building" aria-hidden="true"></i>
                                    <input class="form-control pr-account-search"
                                           value="@_accountSearchText"
                                           placeholder="Search and select an account"
                                           autocomplete="off"
                                           role="combobox"
                                           aria-expanded="@_accountDropdownOpen"
                                           aria-controls="policy-account-options"
                                           @onfocus="OpenAccountDropdown"
                                           @oninput="OnAccountSearchChanged" />
                                    <button type="button" class="pr-account-picker-toggle" title="Show accounts" @onclick="ToggleAccountDropdown" disabled="@_actionBusy">
                                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                    </button>
                                </div>
                                @if (_accountDropdownOpen)
                                {
                                    <div id="policy-account-options" class="pr-account-options" role="listbox">
                                        @if (FilteredAccountOptions.Any())
                                        {
                                            @foreach (var account in FilteredAccountOptions)
                                            {
                                                <button type="button" class="pr-account-option" role="option" @onclick="() => SelectAccount(account)">
                                                    <span class="pr-account-option-main">@account.Name</span>
                                                    <span class="pr-account-option-meta">@AccountOptionMeta(account)</span>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <div class="pr-account-option-empty">No matching accounts</div>
                                        }
                                    </div>
                                }
                            </div>
                            <ValidationMessage For="() => _policyForm.Account" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Account Type</label>
                            <InputSelect class="form-select" @bind-Value="_policyForm.AccountType">
                                <option value="Commercial">Commercial</option>
                                <option value="Personal">Personal</option>
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Producer</label>
                            <InputText class="form-control" @bind-Value="_policyForm.Producer" />
                        </div>
                        <div class="um-field">
                            <label>CSR</label>
                            <InputText class="form-control" @bind-Value="_policyForm.Csr" />
                        </div>
                        <div class="um-field">
                            <label>Branch</label>
                            <InputSelect class="form-select" @bind-Value="_policyForm.Branch">
                                @foreach (var branch in BranchOptions)
                                {
                                    <option value="@branch">@branch</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Renewal Stage</label>
                            <InputSelect class="form-select" @bind-Value="_policyForm.RenewalStage">
                                @foreach (var stage in RenewalStages)
                                {
                                    <option value="@stage">@stage</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field um-field--full">
                            <label>Notes</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_policyForm.Notes" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="ClosePolicyForm" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        Save Policy
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showActionDialog)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseActionDialog">
        <div class="mt-modal pr-action-modal" role="dialog" aria-modal="true" aria-labelledby="pr-action-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi @_actionIcon" aria-hidden="true"></i>
                <span id="pr-action-title">@_actionTitle</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseActionDialog" disabled="@_actionBusy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_actionForm" OnValidSubmit="ConfirmActionAsync" OnInvalidSubmit="NotifyActionValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="pr-modal-intro">
                        <span class="pr-modal-chip"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Policy action</span>
                        <p>@_actionHelpText</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Policy</label>
                            <input class="form-control pr-readonly-input" value="@_selected.PolicyNumber - @_selected.Account" disabled />
                        </div>
                        @if (_pendingAction is "Endorse" or "Renew")
                        {
                            <div class="um-field">
                                <label>Effective Date <span class="text-danger">*</span></label>
                                <InputDate class="form-control" @bind-Value="_actionForm.EffectiveDate" />
                            </div>
                            <div class="um-field">
                                <label>Premium</label>
                                <InputNumber class="form-control" @bind-Value="_actionForm.Premium" />
                            </div>
                        }
                        @if (_pendingAction == "Add Document")
                        {
                            <div class="um-field um-field--full">
                                <label>Document Title <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_actionForm.DocumentTitle" />
                            </div>
                        }
                        <div class="um-field um-field--full">
                            <label>
                                Notes
                                @if (_pendingAction is "Cancel Policy" or "Log Activity")
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_actionForm.Notes" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseActionDialog" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @_actionButtonText
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showConfirmDialog)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseConfirmDialog">
        <div class="mt-modal pr-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="pr-confirm-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi @_confirmIcon" aria-hidden="true"></i>
                <span>Confirm policy action</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseConfirmDialog" disabled="@_actionBusy"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon @(_pendingAction == "Cancel Policy" ? "um-confirm-icon--danger" : "um-confirm-icon--info")">
                    <i class="bi @_confirmIcon" aria-hidden="true"></i>
                </div>
                <div class="um-confirm-message">
                    <h6 id="pr-confirm-title">@_confirmTitle</h6>
                    <p>@_confirmMessage</p>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="CloseConfirmDialog" disabled="@_actionBusy">Cancel</button>
                <button type="button" class="um-btn @(_pendingAction == "Cancel Policy" ? "um-btn-danger" : "um-btn-primary")" @onclick="ExecuteConfirmedActionAsync" disabled="@_actionBusy">
                    @if (_actionBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<div class="pr-enterprise-page">
    <div class="pr-hero">
        <div class="pr-hero-left">
            <div class="pr-hero-icon">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
            </div>
            <div class="pr-header-info">
                <div class="pr-title-row">
                    <h1 class="pr-page-title">Policies Register</h1>
                    <span class="pr-status-pill">@FilteredRows.Count() matches</span>
                    @if (HasFilters)
                    {
                        <span class="pr-filter-pill">Filtered</span>
                    }
                </div>
                <p>Enterprise policy command center for active books, renewals, endorsements, cancellations, documents, and service workflow.</p>
                <div class="pr-sub-row">
                    <span class="pr-sub-chip"><i class="bi bi-stack" aria-hidden="true"></i>@_rows.Count total policies</span>
                    <span class="pr-sub-chip"><i class="bi bi-shield-check" aria-hidden="true"></i>@_rows.Count(r => r.Status == "Active") active</span>
                    <span class="pr-sub-chip"><i class="bi bi-clock-history" aria-hidden="true"></i>@_rows.Count(r => DaysToExp(r.ExpDate) is >= 0 and <= 30) expiring 30d</span>
                    <span class="pr-sub-chip"><i class="bi bi-cash-stack" aria-hidden="true"></i>@_rows.Where(r => r.Status == "Active").Sum(r => r.WrittenPremium).ToString("C0") premium</span>
                </div>
            </div>
        </div>
        <div class="pr-hero-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "pr-spin" : "")"></i> Refresh</button>
            <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenNewPolicy"><i class="bi bi-plus-lg"></i> New Policy</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/endorsements")'><i class="bi bi-pen"></i> Endorsements</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/cancellations")'><i class="bi bi-x-circle"></i> Cancellations</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/documents")'><i class="bi bi-folder2"></i> Documents</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/compliance/policies")'><i class="bi bi-patch-check"></i> Compliance</button>
        </div>
    </div>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger pr-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError
        </div>
    }

    <div class="pr-kpi-strip">
        @KpiCard("bi-stack", "Total", _rows.Count.ToString(), "pr-kpi-total", null)
        @KpiCard("bi-shield-check", "Active", _rows.Count(r => r.Status == "Active").ToString(), "pr-kpi-active", "Active")
        @KpiCard("bi-clock-history", "Expiring 30d", _rows.Count(r => DaysToExp(r.ExpDate) is >= 0 and <= 30).ToString(), "pr-kpi-exp30", "__exp30")
        @KpiCard("bi-clock", "Expiring 60d", _rows.Count(r => DaysToExp(r.ExpDate) is >= 0 and <= 60).ToString(), "pr-kpi-exp60", "__exp60")
        @KpiCard("bi-clock", "Expiring 90d", _rows.Count(r => DaysToExp(r.ExpDate) is >= 0 and <= 90).ToString(), "pr-kpi-exp90", "__exp90")
        @KpiCard("bi-x-circle", "Cancelled", _rows.Count(r => r.Status == "Cancelled").ToString(), "pr-kpi-cancelled", "Cancelled")
        @KpiCard("bi-cash-stack", "Active Premium", _rows.Where(r => r.Status == "Active").Sum(r => r.WrittenPremium).ToString("C0"), "pr-kpi-prem", "__premium")
    </div>

    <div class="pr-workflow-strip" aria-label="Policy workflow shortcuts">
        <button type="button" class="pr-workflow-card" @onclick="OpenEndorsements" title="Open Endorsements">
            <i class="bi bi-pen" aria-hidden="true"></i>
            <div><strong>Endorsements</strong><span>Policy changes, limits, locations, and insured updates</span></div>
        </button>
        <button type="button" class="pr-workflow-card" @onclick="OpenCancellations" title="Open Cancellations">
            <i class="bi bi-x-circle" aria-hidden="true"></i>
            <div><strong>Cancellations</strong><span>Notices, reinstatements, rescissions, and cancellation review</span></div>
        </button>
        <button type="button" class="pr-workflow-card" @onclick="OpenDocuments" title="Open Documents">
            <i class="bi bi-folder2-open" aria-hidden="true"></i>
            <div><strong>Documents</strong><span>Declarations, binders, certificates, forms, and policy files</span></div>
        </button>
        <button type="button" class="pr-workflow-card" @onclick="OpenCompliance" title="Open Compliance">
            <i class="bi bi-patch-check" aria-hidden="true"></i>
            <div><strong>Compliance</strong><span>Compliance policies, attestations, and retained evidence</span></div>
        </button>
    </div>

    <div class="pr-enterprise-search" role="search" aria-label="Search policies">
        <div class="pr-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
        <div class="pr-search-body">
            <label for="pr-search-input">Enterprise search</label>
            <input id="pr-search-input" class="pr-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search every policy field: policy #, account, carrier, LOB, status, premium, dates, producer, CSR, branch, IDs..." />
            <div class="pr-search-hint">Searches all visible and supporting policy fields as you type.</div>
        </div>
        <div class="pr-search-result">
            <strong>@FilteredRows.Count()</strong>
            <span>matches</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(_searchText))
        {
            <button type="button" class="um-btn um-btn-ghost um-btn-sm pr-search-clear" @onclick="ClearFilters">
                <i class="bi bi-x-lg" aria-hidden="true"></i> Clear
            </button>
        }
    </div>

    <div class="pr-view-tabs" role="tablist" aria-label="Policy views">
        @foreach (var tab in _tabs)
        {
            <button class="pr-view-tab @(_activeTab == tab.Key ? "pr-view-tab--active" : null)" type="button" role="tab" aria-selected="@(_activeTab == tab.Key)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <span class="pr-tab-count">@TabCount(tab.Key)</span>
            </button>
        }
    </div>

    <div class="pr-content-layout">
        <div class="pr-main-card">
            @if (_loading)
            {
                <div class="pr-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Loading policies...</span></div>
            }
            else if (!FilteredRows.Any())
            {
                <div class="pr-empty-state">
                    <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                    <strong>No policies found</strong>
                    <span>Adjust the current tab, KPI, or search criteria.</span>
                </div>
            }
            else
            {
                <div class="pr-grid-toolbar">
                    <div>
                        <strong>@FilteredRows.Count()</strong> policies
                        @if (HasFilters)
                        {
                            <span class="pr-filter-note">Filtered</span>
                        }
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearFilters" disabled="@(!HasFilters)">
                        <i class="bi bi-x-lg" aria-hidden="true"></i> Reset
                    </button>
                </div>

                @if (IsGroupingTab)
                {
                    <div class="pr-group-board">
                        @foreach (var group in GroupedRows)
                        {
                            <button type="button" class="pr-group-card" @onclick="() => ApplyGroupSearch(group.Key)">
                                <div>
                                    <span>@GroupTitle</span>
                                    <strong>@group.Key</strong>
                                </div>
                                <div class="pr-group-metrics">
                                    <span><b>@group.Count()</b> policies</span>
                                    <span><b>@group.Sum(x => x.WrittenPremium).ToString("C0")</b> premium</span>
                                </div>
                                <div class="pr-group-meter"><i style="width:@Percent(group.Count(), Math.Max(FilteredRows.Count(), 1))%"></i></div>
                            </button>
                        }
                    </div>
                }

                <div class="pr-table-scroll">
                    <table class="pr-table" aria-label="Policies register">
                    <thead>
                        <tr>
                            <th>Policy #</th>
                            <th>Account</th>
                            <th>LOB</th>
                            <th>Carrier</th>
                            <th>Status</th>
                            <th>Effective</th>
                            <th>Expires</th>
                            <th class="pr-num">Premium</th>
                            <th>Producer</th>
                            <th>CSR</th>
                            <th>Branch</th>
                            <th>Docs</th>
                            <th class="pr-actions-col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedRows)
                        {
                            <tr class="pr-table-row @(_selected.Id == row.Id ? "pr-row-selected" : null)" @onclick="() => SelectPolicy(row)" @ondblclick="() => OpenPolicy(row)">
                                <td>@PolicyNoLink(row)</td>
                                <td>
                                    <div class="pr-account-cell">
                                        <span class="pr-avatar">@Initials(row.Account)</span>
                                        <div>
                                            <strong>@row.Account</strong>
                                            <span>@row.AccountType</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@LobChip(row.Lob)</td>
                                <td>@row.Carrier</td>
                                <td>@StatusChip(row.Status)</td>
                                <td>@row.EffDate.ToString("MM/dd/yyyy")</td>
                                <td>@ExpiryCell(row.ExpDate)</td>
                                <td class="pr-num">@PremiumCell(row.WrittenPremium)</td>
                                <td>@row.Producer</td>
                                <td>@row.Csr</td>
                                <td>@row.Branch</td>
                                <td><span class="pr-doc-count">@row.Documents</span></td>
                                <td class="pr-actions-col">@CtxBtn(row)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
                <div class="pr-pager">
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left"></i> Previous</button>
                    <span class="pr-page-chip">@PageSummary</span>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right"></i></button>
                </div>
            }
        </div>

        <aside class="pr-detail-card" aria-label="Selected policy details">
            @if (_selected.Id == Guid.Empty)
            {
                <div class="pr-detail-empty">
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <strong>Select a policy</strong>
                    <span>Choose any row to review workflow state and available actions.</span>
                </div>
            }
            else
            {
                <div class="pr-detail-head">
                    <div>
                        <span class="pr-detail-eyebrow"><i class="bi bi-shield-lock" aria-hidden="true"></i> Policy workspace</span>
                        <h2>@_selected.PolicyNumber</h2>
                        <p>@_selected.Account</p>
                    </div>
                    @StatusChip(_selected.Status)
                </div>
                <div class="pr-detail-body">
                    <div class="pr-detail-summary">
                        <div><span>Carrier</span><strong>@_selected.Carrier</strong></div>
                        <div><span>LOB</span><strong>@_selected.Lob</strong></div>
                        <div><span>Premium</span><strong>@_selected.WrittenPremium.ToString("C0")</strong></div>
                        <div><span>Expires</span><strong>@_selected.ExpDate.ToString("MM/dd/yyyy")</strong></div>
                        <div><span>Producer</span><strong>@_selected.Producer</strong></div>
                        <div><span>CSR</span><strong>@_selected.Csr</strong></div>
                    </div>
                    <div class="pr-work-card">
                        <span>Last action</span>
                        <strong>@_selected.LastAction</strong>
                    </div>
                    <div class="pr-detail-actions">
                        <div class="pr-detail-actions-row">
                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenEditAction"><i class="bi bi-pencil"></i> Edit</button>
                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenEndorseAction"><i class="bi bi-pen"></i> Endorse</button>
                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenDocumentAction"><i class="bi bi-paperclip"></i> Document</button>
                        </div>
                        <button type="button" class="um-btn um-btn-primary pr-detail-open-btn" @onclick="() => OpenPolicy(_selected)"><i class="bi bi-box-arrow-up-right"></i> Open policy file</button>
                        <button type="button" class="um-btn um-btn-danger pr-detail-open-btn" @onclick="OpenCancelAction"><i class="bi bi-x-circle"></i> Start cancellation</button>
                    </div>
                </div>
            }
        </aside>
    </div>
</div>

@code {
    Guid _tenantId;
    Guid _tenantAdminUserId;
    bool _loading;
    bool _showForm;
    bool _showActionDialog;
    bool _showConfirmDialog;
    bool _actionBusy;
    bool _toastVisible;
    string _activeTab = "all";
    string _toastMessage = string.Empty;
    string _toastKind = "success";
    string? _kpiFilter;
    string? _loadError;
    string? _searchText;
    Guid? _openActionMenuFor;
    int _page = 1;
    const int PageSize = 20;

    PolicyRow _selected = new();
    PolicyForm _policyForm = new();
    readonly PolicyActionForm _actionForm = new();
    string _pendingAction = string.Empty;
    string _actionTitle = "Policy Action";
    string _actionIcon = "bi-shield-check";
    string _actionButtonText = "Continue";
    string _actionHelpText = string.Empty;
    string _confirmTitle = "Confirm action";
    string _confirmMessage = "Confirm this policy action?";
    string _confirmIcon = "bi-question-circle";
    string _accountSearchText = string.Empty;
    bool _accountDropdownOpen;

    readonly List<PolicyRow> _rows = [];
    readonly List<AccountOption> _accountOptions = [];

    static readonly string[] PolicyStatuses = ["Active", "Pending", "Cancelled", "Expired", "Non-Renewed"];
    static readonly string[] LinesOfBusiness = ["Commercial Auto", "Commercial Property", "General Liability", "Workers Comp", "Professional Liability", "Umbrella", "Cyber", "Directors & Officers", "Personal Auto", "Homeowners", "Life", "Health", "Flood"];
    static readonly string[] RenewalStages = ["Not Started", "Pre-Renewal", "Marketing", "Quoted", "Bound", "Lost"];

    readonly TabDef[] _tabs =
    [
        new("all", "All", "bi-stack"),
        new("active", "Active", "bi-shield-check"),
        new("exp30", "Expiring 30d", "bi-clock-history"),
        new("exp60", "Expiring 60d", "bi-clock"),
        new("exp90", "Expiring 90d", "bi-clock"),
        new("cancelled", "Cancelled", "bi-x-circle"),
        new("carrier", "By Carrier", "bi-building"),
        new("producer", "By Producer", "bi-person-badge"),
        new("branch", "By Branch", "bi-geo-alt"),
        new("lob", "By LOB", "bi-layers"),
    ];

    readonly ActionItem[] _actionItems =
    [
        new("Open", "bi bi-box-arrow-up-right"),
        new("Edit", "bi bi-pencil"),
        new("Endorse", "bi bi-pen"),
        new("Renew", "bi bi-arrow-repeat"),
        new("Cancel Policy", "bi bi-x-circle"),
        new("Add Document", "bi bi-paperclip"),
        new("Log Activity", "bi bi-lightning"),
    ];

    bool HasFilters => !string.IsNullOrWhiteSpace(_searchText) || _kpiFilter is not null;
    string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            _page = 1;
        }
    }

    IEnumerable<PolicyRow> BaseTabRows => _activeTab switch
    {
        "active" => _rows.Where(r => r.Status == "Active"),
        "exp30" => _rows.Where(r => DaysToExp(r.ExpDate) is >= 0 and <= 30),
        "exp60" => _rows.Where(r => DaysToExp(r.ExpDate) is >= 0 and <= 60),
        "exp90" => _rows.Where(r => DaysToExp(r.ExpDate) is >= 0 and <= 90),
        "cancelled" => _rows.Where(r => r.Status == "Cancelled"),
        "carrier" => _rows.OrderBy(r => r.Carrier).ThenBy(r => r.ExpDate),
        "producer" => _rows.OrderBy(r => r.Producer).ThenBy(r => r.ExpDate),
        "branch" => _rows.OrderBy(r => r.Branch).ThenBy(r => r.ExpDate),
        "lob" => _rows.OrderBy(r => r.Lob).ThenBy(r => r.ExpDate),
        _ => _rows,
    };

    IEnumerable<PolicyRow> FilteredRows => ApplyEnterpriseFilters(BaseTabRows);
    IEnumerable<string> CarrierOptions => _rows.Select(r => r.Carrier).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x);
    IEnumerable<string> BranchOptions => _rows.Select(r => r.Branch).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).DefaultIfEmpty("HQ").OrderBy(x => x);
    IEnumerable<AccountOption> FilteredAccountOptions
    {
        get
        {
            var options = _accountOptions.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_accountSearchText))
            {
                var term = _accountSearchText.Trim();
                options = options.Where(a => Contains(a.Name, term) || Contains(a.Number, term) || Contains(a.Type, term));
            }

            return options.Take(25);
        }
    }
    IEnumerable<PolicyRow> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize);
    bool IsGroupingTab => _activeTab is "carrier" or "producer" or "branch" or "lob";
    string GroupTitle => _activeTab switch
    {
        "carrier" => "Carrier",
        "producer" => "Producer",
        "branch" => "Branch",
        "lob" => "Line of business",
        _ => "Group"
    };
    IEnumerable<IGrouping<string, PolicyRow>> GroupedRows => _activeTab switch
    {
        "carrier" => FilteredRows.GroupBy(r => r.Carrier).OrderByDescending(g => g.Count()),
        "producer" => FilteredRows.GroupBy(r => r.Producer).OrderByDescending(g => g.Count()),
        "branch" => FilteredRows.GroupBy(r => r.Branch).OrderByDescending(g => g.Count()),
        "lob" => FilteredRows.GroupBy(r => r.Lob).OrderByDescending(g => g.Count()),
        _ => Enumerable.Empty<IGrouping<string, PolicyRow>>()
    };
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)PageSize));
    string PageSummary
    {
        get
        {
            var total = FilteredRows.Count();
            if (total == 0) return "No policies";
            var start = ((_page - 1) * PageSize) + 1;
            var end = Math.Min(_page * PageSize, total);
            return $"Showing {start}-{end} of {total}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policies", "/policies"));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchPolicyRegisterAsync(_tenantId, pageSize: 250);
            var accounts = await Api.SearchAccountsAsync(_tenantId, pageSize: 250);
            _rows.Clear();
            _rows.AddRange((result?.Items ?? []).Select(MapRegisterPolicy));
            BuildAccountOptions(accounts?.Items ?? []);
            BuildAccountOptionsFromRows();
            RefreshSelectedPolicy();

            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load policies: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger");
            BuildAccountOptionsFromRows();
        }
        finally
        {
            _loading = false;
        }
    }

    void BuildAccountOptions(IEnumerable<AccountDto> accounts)
    {
        _accountOptions.Clear();
        _accountOptions.AddRange(accounts
            .Where(a => a.AccountId != Guid.Empty && !string.IsNullOrWhiteSpace(a.AccountName))
            .Select(a => new AccountOption(a.AccountId, a.AccountName, string.IsNullOrWhiteSpace(a.AccountTypeCode) ? "Commercial" : a.AccountTypeCode, a.AccountNumber))
            .DistinctBy(a => a.Id)
            .OrderBy(a => a.Name));
    }

    void BuildAccountOptionsFromRows()
    {
        foreach (var row in _rows.Where(r => r.AccountId != Guid.Empty && !string.IsNullOrWhiteSpace(r.Account)))
        {
            if (_accountOptions.All(a => a.Id != row.AccountId))
            {
                _accountOptions.Add(new AccountOption(row.AccountId, row.Account, row.AccountType, string.Empty));
            }
        }

        _accountOptions.Sort((left, right) => string.Compare(left.Name, right.Name, StringComparison.OrdinalIgnoreCase));
    }

    PolicyRow MapRegisterPolicy(PolicyRegisterDto p) => new()
    {
        Id = p.PolicyId,
        SubmissionId = p.SubmissionId,
        QuoteId = p.QuoteId,
        PolicyNumber = p.PolicyNumber,
        Account = p.AccountName,
        AccountType = p.AccountType,
        AccountId = p.AccountId,
        Carrier = p.CarrierName,
        Lob = string.IsNullOrWhiteSpace(p.LineOfBusiness) ? "General Liability" : p.LineOfBusiness,
        Status = p.Status == "Bound" ? "Active" : p.Status,
        EffDate = p.EffectiveDate,
        ExpDate = p.ExpirationDate,
        WrittenPremium = p.WrittenPremium,
        AnnualPremium = p.AnnualPremium,
        Producer = string.IsNullOrWhiteSpace(p.ProducerName) ? p.AssignedToUserName ?? "Unassigned" : p.ProducerName,
        Csr = string.IsNullOrWhiteSpace(p.CsrName) ? p.AssignedToUserName ?? "Unassigned" : p.CsrName,
        Branch = string.IsNullOrWhiteSpace(p.Branch) ? "HQ" : p.Branch,
        Documents = Math.Max(0, p.DocumentCount),
        Activities = Math.Max(1, p.ActivityCount),
        Endorsements = Math.Max(0, p.EndorsementCount),
        RenewalStage = string.IsNullOrWhiteSpace(p.RenewalStage) ? "Not Started" : p.RenewalStage,
        LastAction = string.IsNullOrWhiteSpace(p.LastAction) ? "Policy synchronized from bound policy workflow." : p.LastAction
    };

    void RefreshSelectedPolicy()
    {
        if (_rows.Count == 0)
        {
            _selected = new();
            return;
        }

        _selected = _selected.Id == Guid.Empty
            ? _rows[0]
            : _rows.FirstOrDefault(r => r.Id == _selected.Id) ?? _rows[0];
    }

    IEnumerable<PolicyRow> ApplyEnterpriseFilters(IEnumerable<PolicyRow> rows)
    {
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim();
            rows = rows.Where(r => Contains(r.PolicyNumber, term)
                || Contains(r.Account, term)
                || Contains(r.AccountType, term)
                || Contains(r.AccountId.ToString(), term)
                || Contains(r.Id.ToString(), term)
                || Contains(r.Carrier, term)
                || Contains(r.Lob, term)
                || Contains(r.Status, term)
                || Contains(r.EffDate.ToString("MM/dd/yyyy"), term)
                || Contains(r.EffDate.ToString("yyyy-MM-dd"), term)
                || Contains(r.ExpDate.ToString("MM/dd/yyyy"), term)
                || Contains(r.ExpDate.ToString("yyyy-MM-dd"), term)
                || Contains(r.WrittenPremium.ToString("C0"), term)
                || Contains(r.WrittenPremium.ToString("0.##"), term)
                || Contains(r.AnnualPremium.ToString("C0"), term)
                || Contains(r.AnnualPremium.ToString("0.##"), term)
                || Contains(r.Producer, term)
                || Contains(r.Csr, term)
                || Contains(r.Branch, term)
                || Contains(r.Documents.ToString(), term)
                || Contains(r.Activities.ToString(), term)
                || Contains(r.Endorsements.ToString(), term)
                || Contains(r.RenewalStage, term)
                || Contains(r.LastAction, term)
                || Contains(r.Notes, term));
        }

        rows = _kpiFilter switch
        {
            null => rows,
            "__exp30" => rows.Where(r => DaysToExp(r.ExpDate) is >= 0 and <= 30),
            "__exp60" => rows.Where(r => DaysToExp(r.ExpDate) is >= 0 and <= 60),
            "__exp90" => rows.Where(r => DaysToExp(r.ExpDate) is >= 0 and <= 90),
            "__premium" => rows.Where(r => r.Status == "Active" && r.WrittenPremium > 0),
            "__docs" => rows.Where(r => r.Documents > 0),
            var f => rows.Where(r => r.Status == f)
        };

        return rows;
    }

    static bool Contains(string? source, string term) =>
        !string.IsNullOrWhiteSpace(source) && source.Contains(term, StringComparison.OrdinalIgnoreCase);

    static int DaysToExp(DateTime exp) => (int)(exp.Date - DateTime.Today).TotalDays;

    string TabCount(string key) => key switch
    {
        "all" => _rows.Count.ToString(),
        "active" => _rows.Count(r => r.Status == "Active").ToString(),
        "exp30" => _rows.Count(r => DaysToExp(r.ExpDate) is >= 0 and <= 30).ToString(),
        "exp60" => _rows.Count(r => DaysToExp(r.ExpDate) is >= 0 and <= 60).ToString(),
        "exp90" => _rows.Count(r => DaysToExp(r.ExpDate) is >= 0 and <= 90).ToString(),
        "cancelled" => _rows.Count(r => r.Status == "Cancelled").ToString(),
        "carrier" => _rows.Select(r => r.Carrier).Distinct().Count().ToString(),
        "producer" => _rows.Select(r => r.Producer).Distinct().Count().ToString(),
        "branch" => _rows.Select(r => r.Branch).Distinct().Count().ToString(),
        "lob" => _rows.Select(r => r.Lob).Distinct().Count().ToString(),
        _ => string.Empty,
    };

    void SetActiveTab(string key)
    {
        _activeTab = key;
        _page = 1;
    }

    void SelectPolicy(PolicyRow row)
    {
        _selected = row;
        _openActionMenuFor = null;
    }

    void ApplyGroupSearch(string value)
    {
        _searchText = value;
        _page = 1;
    }

    static int Percent(int value, int total) => total <= 0 ? 0 : Math.Clamp((int)Math.Round(value * 100m / total), 4, 100);

    Task OpenEditAction() => HandleActionAsync("Edit");
    Task OpenEndorseAction() => HandleActionAsync("Endorse");
    Task OpenDocumentAction() => HandleActionAsync("Add Document");
    Task OpenCancelAction() => HandleActionAsync("Cancel Policy");
    void OpenEndorsements() => Nav.NavigateTo("/policies/endorsements");
    void OpenCancellations() => Nav.NavigateTo("/policies/cancellations");
    void OpenDocuments() => Nav.NavigateTo("/policies/documents");
    void OpenCompliance() => Nav.NavigateTo("/compliance/policies");

    void ToggleKpiFilter(string? filterKey)
    {
        _kpiFilter = filterKey is null || _kpiFilter == filterKey ? null : filterKey;
        _page = 1;
    }

    void ClearFilters()
    {
        _searchText = null;
        _kpiFilter = null;
        _page = 1;
    }

    void PreviousPage()
    {
        if (_page > 1)
            _page--;
    }

    void NextPage()
    {
        if (_page < TotalPages)
            _page++;
    }

    void OpenPolicy(PolicyRow row) => Nav.NavigateTo($"/policies/{row.Id}");

    void OpenNewPolicy()
    {
        var firstAccount = _accountOptions.FirstOrDefault();
        _policyForm = new PolicyForm
        {
            PolicyNumber = $"POL-{DateTime.Today:yyyy}-{_rows.Count + 1:D4}",
            EffDate = DateTime.Today,
            ExpDate = DateTime.Today.AddYears(1),
            Status = "Active",
            Lob = "General Liability",
            Carrier = CarrierOptions.FirstOrDefault() ?? string.Empty,
            Branch = BranchOptions.FirstOrDefault() ?? "HQ",
            RenewalStage = "Not Started",
            AccountId = firstAccount?.Id ?? Guid.Empty,
            Account = firstAccount?.Name ?? string.Empty,
            AccountType = firstAccount?.Type ?? "Commercial"
        };
        _accountSearchText = _policyForm.Account;
        _accountDropdownOpen = false;
        _showForm = true;
    }

    void ClosePolicyForm()
    {
        if (_actionBusy) return;
        _showForm = false;
        _accountDropdownOpen = false;
    }

    void OpenAccountDropdown() => _accountDropdownOpen = true;

    void ToggleAccountDropdown() => _accountDropdownOpen = !_accountDropdownOpen;

    void OnAccountSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args)
    {
        _accountSearchText = args.Value?.ToString() ?? string.Empty;
        _policyForm.Account = _accountSearchText;
        _policyForm.AccountId = Guid.Empty;
        _accountDropdownOpen = true;
    }

    void SelectAccount(AccountOption account)
    {
        _policyForm.AccountId = account.Id;
        _policyForm.Account = account.Name;
        _policyForm.AccountType = string.IsNullOrWhiteSpace(account.Type) ? "Commercial" : account.Type;
        _accountSearchText = account.Name;
        _accountDropdownOpen = false;
    }

    static string AccountOptionMeta(AccountOption account) => string.IsNullOrWhiteSpace(account.Number) ? account.Type : $"{account.Type} - {account.Number}";

    async Task CloseAccountDropdownAsync()
    {
        await Task.Delay(120);
        _accountDropdownOpen = false;
    }

    async Task SavePolicyAsync()
    {
        _actionBusy = true;
        try
        {
            var request = ToUpsertRequest(_policyForm);
            if (_policyForm.Id == Guid.Empty)
            {
                var id = await Api.CreatePolicyRegisterAsync(request);
                _selected.Id = id;
            }
            else
            {
                await Api.UpdatePolicyRegisterAsync(_policyForm.Id, request);
                _selected.Id = _policyForm.Id;
            }

            _showForm = false;
            _page = 1;
            await LoadAsync();
            ShowToast("Policy saved.");
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    UpsertPolicyRegisterRequest ToUpsertRequest(PolicyForm form) => new()
    {
        TenantId = _tenantId,
        PolicyNumber = form.PolicyNumber.Trim(),
        AccountId = form.AccountId,
        AccountName = form.Account.Trim(),
        AccountType = form.AccountType.Trim(),
        CarrierName = form.Carrier.Trim(),
        LineOfBusiness = form.Lob.Trim(),
        Status = form.Status.Trim(),
        EffectiveDate = form.EffDate,
        ExpirationDate = form.ExpDate,
        WrittenPremium = form.WrittenPremium,
        AnnualPremium = form.AnnualPremium,
        ProducerName = form.Producer,
        CsrName = form.Csr,
        Branch = form.Branch,
        RenewalStage = form.RenewalStage,
        Notes = form.Notes,
        ModifiedByUserId = _tenantAdminUserId
    };

    Task NotifyFormValidationAsync()
    {
        ShowToast("Please correct the highlighted policy fields before saving.", "danger");
        return Task.CompletedTask;
    }

    async Task HandleActionAsync(string action)
    {
        _openActionMenuFor = null;

        if (_selected.Id == Guid.Empty)
        {
            ShowToast("Select a policy before running an action.", "danger");
            return;
        }

        switch (action)
        {
            case "Open":
                OpenPolicy(_selected);
                break;
            case "Edit":
                _policyForm = PolicyForm.From(_selected);
                _accountSearchText = _policyForm.Account;
                _accountDropdownOpen = false;
                _showForm = true;
                break;
            case "Cancel Policy":
                _actionForm.Reset(_selected, action);
                OpenConfirmDialog(action);
                break;
            case "Endorse":
            case "Renew":
            case "Add Document":
            case "Log Activity":
                OpenActionDialog(action);
                break;
        }
    }

    void OpenActionDialog(string action)
    {
        _pendingAction = action;
        _actionForm.Reset(_selected, action);
        (_actionTitle, _actionIcon, _actionButtonText) = action switch
        {
            "Endorse" => ($"Endorse {_selected.PolicyNumber}", "bi-pen", "Create Endorsement"),
            "Renew" => ($"Renew {_selected.PolicyNumber}", "bi-arrow-repeat", "Start Renewal"),
            "Add Document" => ($"Add document to {_selected.PolicyNumber}", "bi-paperclip", "Add Document"),
            "Log Activity" => ($"Log activity for {_selected.PolicyNumber}", "bi-lightning", "Log Activity"),
            _ => ("Policy Action", "bi-shield-check", "Continue")
        };
        _actionHelpText = action switch
        {
            "Endorse" => "Create an endorsement note and update the policy premium or effective date if needed.",
            "Renew" => "Create a pending renewal policy with refreshed term dates and premium.",
            "Add Document" => "Attach or register a policy document and increment the document count.",
            "Log Activity" => "Record a service activity note against the policy.",
            _ => "Review the action details and confirm before changes are applied."
        };
        _showActionDialog = true;
    }

    void CloseActionDialog()
    {
        if (_actionBusy) return;
        _showActionDialog = false;
    }

    Task ConfirmActionAsync()
    {
        OpenConfirmDialog(_pendingAction);
        return Task.CompletedTask;
    }

    Task NotifyActionValidationAsync()
    {
        ShowToast("Please correct the highlighted fields before continuing.", "danger");
        return Task.CompletedTask;
    }

    void OpenConfirmDialog(string action)
    {
        _pendingAction = action;
        (_confirmTitle, _confirmMessage, _confirmIcon) = action switch
        {
            "Endorse" => ($"Create endorsement for {_selected.PolicyNumber}?", "This will record an endorsement and update the policy register values entered.", "bi-pen"),
            "Renew" => ($"Start renewal for {_selected.PolicyNumber}?", "This will create a pending renewal policy row with a new term.", "bi-arrow-repeat"),
            "Cancel Policy" => ($"Cancel {_selected.PolicyNumber}?", "This will mark the selected policy as cancelled in the register.", "bi-exclamation-triangle"),
            "Add Document" => ($"Add document to {_selected.PolicyNumber}?", "This will register the document against the policy and keep you on the policy register.", "bi-paperclip"),
            "Log Activity" => ($"Log activity for {_selected.PolicyNumber}?", "This will add a service activity entry to the policy work history.", "bi-lightning"),
            _ => ("Confirm action", "Confirm this policy action?", "bi-question-circle")
        };
        _showConfirmDialog = true;
    }

    void CloseConfirmDialog()
    {
        if (_actionBusy) return;
        _showConfirmDialog = false;
    }

    async Task ExecuteConfirmedActionAsync()
    {
        if (_selected.Id == Guid.Empty)
            return;

        _actionBusy = true;
        try
        {
            var result = await Api.ExecutePolicyRegisterActionAsync(_selected.Id, new PolicyRegisterActionRequest
            {
                TenantId = _tenantId,
                Action = _pendingAction,
                EffectiveDate = _actionForm.EffectiveDate,
                Premium = _actionForm.Premium,
                DocumentTitle = _actionForm.DocumentTitle,
                Notes = _actionForm.Notes,
                ModifiedByUserId = _tenantAdminUserId
            });

            _showActionDialog = false;
            _showConfirmDialog = false;
            _page = 1;
            await LoadAsync();
            ShowToast(result.Message);
        }
        catch (Exception ex)
        {
            ShowToast($"Action failed: {ex.Message}", "danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    void ToggleActionMenu(PolicyRow row)
    {
        _selected = row;
        _openActionMenuFor = _openActionMenuFor == row.Id ? null : row.Id;
    }

    void ShowToast(string message, string kind = "success")
    {
        _toastMessage = message;
        _toastKind = kind;
        _toastVisible = true;
    }

    void HideToast() => _toastVisible = false;

    RenderFragment PolicyNoLink(PolicyRow row) =>
        @<button class="pr-link um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenPolicy(row)">@row.PolicyNumber</button>;

    RenderFragment LobChip(string lob) =>
        @<span class="pr-lob-chip">@lob</span>;

    RenderFragment StatusChip(string status) =>
        @<span class="pr-status pr-status-@status.ToLowerInvariant().Replace(" ", "-")">@status</span>;

    RenderFragment PremiumCell(decimal premium) =>
        premium <= 0 ? @<span class="pr-prem-none">-</span> : @<span class="pr-prem">@premium.ToString("C0")</span>;

    RenderFragment ExpiryCell(DateTime exp)
    {
        var days = DaysToExp(exp);
        var css = days < 0 ? "pr-exp-past" : days <= 30 ? "pr-exp-30" : days <= 60 ? "pr-exp-60" : string.Empty;
        return @<span class="@css">@exp.ToString("MM/dd/yyyy")</span>;
    }

    RenderFragment CtxBtn(PolicyRow row) =>
        @<div class="pr-action-menu-wrap" @onclick:stopPropagation="true">
            <button type="button" class="um-btn um-btn-ghost um-btn-xs pr-ctx-btn" aria-haspopup="menu" aria-expanded="@(_openActionMenuFor == row.Id)" title="Policy actions" @onclick="() => ToggleActionMenu(row)">
                <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
            </button>
            @if (_openActionMenuFor == row.Id)
            {
                <div class="pr-action-menu" role="menu" aria-label="Policy actions">
                    <div class="pr-action-menu-summary">
                        <strong>@row.PolicyNumber</strong>
                        <span>@row.Account</span>
                    </div>
                    @foreach (var item in _actionItems)
                    {
                        <button type="button" class="um-action-menu-item @(item.Text == "Cancel Policy" ? "um-action-menu-item--danger" : null)" role="menuitem" @onclick="() => HandleActionAsync(item.Text)">
                            <i class="@item.IconCss" aria-hidden="true"></i>
                            <span>@item.Text</span>
                        </button>
                    }
                </div>
            }
        </div>;

    RenderFragment KpiCard(string icon, string label, string val, string css, string? filterKey)
    {
        var isActive = _kpiFilter == filterKey;
        var cardClass = $"pr-kpi-card {css} {(isActive ? "pr-kpi-selected" : string.Empty)}";
        var title = filterKey is null ? "Show all" : isActive ? "Clear filter" : $"Filter by {label}";
        return @<button type="button" class="@cardClass" @onclick="() => ToggleKpiFilter(filterKey)" title="@title">
            <div class="pr-kpi-lbl"><i class="bi @icon" aria-hidden="true"></i> @label</div>
            <div class="pr-kpi-val">@val</div>
        </button>;
    }

    RenderFragment WorkflowCard(string icon, string title, string description, string url) =>
        @<button type="button" class="pr-workflow-card" @onclick="() => Nav.NavigateTo(url)" title="Open @title">
            <i class="bi @icon" aria-hidden="true"></i>
            <div><strong>@title</strong><span>@description</span></div>
        </button>;

    static string Initials(string value)
    {
        var words = value.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (words.Length == 0) return "P";
        if (words.Length == 1) return words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant();
        return string.Concat(words.Take(2).Select(w => char.ToUpperInvariant(w[0])));
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    sealed record TabDef(string Key, string Label, string Icon);
    sealed record ActionItem(string Text, string IconCss);
    sealed record AccountOption(Guid Id, string Name, string Type, string Number);

    sealed class PolicyRow
    {
        public Guid Id { get; set; }
        public Guid SubmissionId { get; set; }
        public Guid QuoteId { get; set; }
        public string PolicyNumber { get; set; } = string.Empty;
        public string Account { get; set; } = string.Empty;
        public string AccountType { get; set; } = "Commercial";
        public Guid AccountId { get; set; }
        public string Carrier { get; set; } = string.Empty;
        public string Lob { get; set; } = string.Empty;
        public string Status { get; set; } = "Active";
        public DateTime EffDate { get; set; }
        public DateTime ExpDate { get; set; }
        public decimal WrittenPremium { get; set; }
        public decimal AnnualPremium { get; set; }
        public string Producer { get; set; } = string.Empty;
        public string Csr { get; set; } = string.Empty;
        public string Branch { get; set; } = string.Empty;
        public int Documents { get; set; }
        public int Activities { get; set; }
        public int Endorsements { get; set; }
        public string RenewalStage { get; set; } = "Not Started";
        public string LastAction { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;

    }

    sealed class PolicyForm : IValidatableObject
    {
        public Guid Id { get; set; }
        [Required, StringLength(80)] public string PolicyNumber { get; set; } = string.Empty;
        public Guid AccountId { get; set; }
        [Required, StringLength(200)] public string Account { get; set; } = string.Empty;
        [Required, StringLength(40)] public string AccountType { get; set; } = "Commercial";
        [Required, StringLength(120)] public string Carrier { get; set; } = string.Empty;
        [Required, StringLength(80)] public string Lob { get; set; } = string.Empty;
        [Required, StringLength(40)] public string Status { get; set; } = "Active";
        [Required] public DateTime EffDate { get; set; } = DateTime.Today;
        [Required] public DateTime ExpDate { get; set; } = DateTime.Today.AddYears(1);
        [Range(0, 100000000)] public decimal WrittenPremium { get; set; }
        [Range(0, 100000000)] public decimal AnnualPremium { get; set; }
        [StringLength(120)] public string Producer { get; set; } = string.Empty;
        [StringLength(120)] public string Csr { get; set; } = string.Empty;
        [StringLength(80)] public string Branch { get; set; } = "HQ";
        [StringLength(80)] public string RenewalStage { get; set; } = "Not Started";
        [StringLength(1000)] public string Notes { get; set; } = string.Empty;

        public static PolicyForm From(PolicyRow row) => new()
        {
            Id = row.Id,
            PolicyNumber = row.PolicyNumber,
            AccountId = row.AccountId,
            Account = row.Account,
            AccountType = row.AccountType,
            Carrier = row.Carrier,
            Lob = row.Lob,
            Status = row.Status,
            EffDate = row.EffDate,
            ExpDate = row.ExpDate,
            WrittenPremium = row.WrittenPremium,
            AnnualPremium = row.AnnualPremium,
            Producer = row.Producer,
            Csr = row.Csr,
            Branch = row.Branch,
            RenewalStage = row.RenewalStage,
            Notes = row.Notes
        };

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (ExpDate <= EffDate)
                yield return new ValidationResult("Expiration date must be after effective date.", [nameof(ExpDate)]);
            if (AccountId == Guid.Empty)
                yield return new ValidationResult("Select an account from the account list.", [nameof(Account)]);
        }
    }

    sealed class PolicyActionForm : IValidatableObject
    {
        public DateTime? EffectiveDate { get; set; }
        [Range(0, 100000000)] public decimal? Premium { get; set; }
        [StringLength(200)] public string? DocumentTitle { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
        string _action = string.Empty;

        public void Reset(PolicyRow row, string action)
        {
            _action = action;
            EffectiveDate = action == "Renew" ? row.ExpDate.Date : DateTime.Today;
            Premium = row.WrittenPremium > 0 ? row.WrittenPremium : null;
            DocumentTitle = action == "Add Document" ? $"Policy Document - {row.PolicyNumber}" : null;
            Notes = action switch
            {
                "Cancel Policy" => "Policy cancelled from policy register.",
                "Log Activity" => "Service activity recorded from policy register.",
                "Endorse" => "Endorsement requested from policy register.",
                "Renew" => "Renewal started from policy register.",
                _ => string.Empty
            };
        }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if ((_action is "Endorse" or "Renew") && EffectiveDate is null)
                yield return new ValidationResult("Effective date is required.", [nameof(EffectiveDate)]);
            if (_action == "Add Document" && string.IsNullOrWhiteSpace(DocumentTitle))
                yield return new ValidationResult("Document title is required.", [nameof(DocumentTitle)]);
            if (_action is "Cancel Policy" or "Log Activity" && string.IsNullOrWhiteSpace(Notes))
                yield return new ValidationResult("Notes are required.", [nameof(Notes)]);
        }
    }
}
