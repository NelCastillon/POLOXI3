@page "/crm/pricing-rules"
@inject ApiClient Api

<PageTitle>Pricing Rules</PageTitle>

<h1>Pricing Rules</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(PricingRuleDto.RuleCode)" HeaderText="Rule Code" Width="140"></GridColumn>
            <GridColumn Field="@nameof(PricingRuleDto.RuleName)" HeaderText="Rule Name" Width="220"></GridColumn>
            <GridColumn Field="@nameof(PricingRuleDto.RuleTypeCode)" HeaderText="Type" Width="120"></GridColumn>
            <GridColumn Field="@nameof(PricingRuleDto.SegmentCode)" HeaderText="Segment" Width="120"></GridColumn>
            <GridColumn Field="@nameof(PricingRuleDto.ServiceCode)" HeaderText="Service" Width="140"></GridColumn>
            <GridColumn Field="@nameof(PricingRuleDto.DiscountPercent)" HeaderText="Discount %" Format="N2" Width="120"></GridColumn>
            <GridColumn Field="@nameof(PricingRuleDto.AdjustedUnitPrice)" HeaderText="Adj. Unit Price" Format="C2" Width="140"></GridColumn>
            <GridColumn Field="@nameof(PricingRuleDto.RequiresApproval)" HeaderText="Requires Approval" DisplayAsCheckBox="true" Width="160"></GridColumn>
            <GridColumn Field="@nameof(PricingRuleDto.Priority)" HeaderText="Priority" Width="100"></GridColumn>
            <GridColumn Field="@nameof(PricingRuleDto.IsActive)" HeaderText="Active" DisplayAsCheckBox="true" Width="100"></GridColumn>
            <GridColumn Field="@nameof(PricingRuleDto.EffectiveStartDate)" HeaderText="Effective From" Type="ColumnType.DateTime" Format="d" Width="140"></GridColumn>
            <GridColumn Field="@nameof(PricingRuleDto.EffectiveEndDate)" HeaderText="Effective To" Type="ColumnType.DateTime" Format="d" Width="140"></GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<PricingRuleDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchPricingRulesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<PricingRuleDto>();
    }
}
