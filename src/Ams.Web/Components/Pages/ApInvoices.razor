@page "/finance/ap-invoices"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Common.Validation
@using Ams.Application.Features.Finance
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>AP Invoices — AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="api-toast api-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="api-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showStatusConfirm && _statusTarget is not null && !string.IsNullOrWhiteSpace(_pendingStatus))
{
    <div class="api-modal-backdrop" role="presentation" @onclick="CancelStatusUpdate">
        <div class="api-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="api-status-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon @(_pendingStatus == "Void" ? "um-confirm-icon--danger" : null)"><i class="bi @StatusActionIcon(_pendingStatus)"></i></div>
                <div class="um-confirm-title" id="api-status-title">@StatusActionTitle(_pendingStatus)</div>
                <div class="um-confirm-body">Update <strong>@_statusTarget.InvoiceNumber</strong> from <strong>@VendorName(_statusTarget.VendorId)</strong> to <strong>@_pendingStatus</strong>?</div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CancelStatusUpdate" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn @(_pendingStatus == "Void" ? "um-btn-danger" : "um-btn-primary")" @onclick="ExecuteStatusUpdateAsync" disabled="@_busy">@StatusActionButton(_pendingStatus)</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="api-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="api-modal api-action-modal" role="dialog" aria-modal="true" aria-labelledby="api-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-receipt" aria-hidden="true"></i>
                <span id="api-form-title">@(_editingId == Guid.Empty ? "New AP Invoice" : "Edit AP Invoice")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="api-modal-intro"><span><i class="bi bi-shield-check" aria-hidden="true"></i> Accounts payable workflow</span><p>Capture vendor invoices, track due dates, allocate GL accounts, and manage payment status.</p></div>
                    <div class="um-form-grid">
                        <div class="um-field"><label>Vendor <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.VendorId" class="form-select"><option value="@Guid.Empty">Select vendor...</option>@foreach (var vendor in _vendors) { <option value="@vendor.VendorId">@vendor.VendorName</option> }</InputSelect><ValidationMessage For="() => _form.VendorId" class="text-danger" /></div>
                        <div class="um-field"><label>Invoice Number <span class="text-danger">*</span></label><InputText @bind-Value="_form.InvoiceNumber" class="form-control" /><ValidationMessage For="() => _form.InvoiceNumber" class="text-danger" /></div>
                        <div class="um-field"><label>Invoice Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.InvoiceDate" class="form-control" /><ValidationMessage For="() => _form.InvoiceDate" class="text-danger" /></div>
                        <div class="um-field"><label>Due Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.DueDate" class="form-control" /><ValidationMessage For="() => _form.DueDate" class="text-danger" /></div>
                        <div class="um-field"><label>Amount <span class="text-danger">*</span></label><InputNumber @bind-Value="_form.Amount" class="form-control" /><ValidationMessage For="() => _form.Amount" class="text-danger" /></div>
                        <div class="um-field"><label>Amount Paid</label><InputNumber @bind-Value="_form.AmountPaid" class="form-control" /><ValidationMessage For="() => _form.AmountPaid" class="text-danger" /></div>
                        <div class="um-field"><label>Tax Amount</label><InputNumber @bind-Value="_form.TaxAmount" class="form-control" /><ValidationMessage For="() => _form.TaxAmount" class="text-danger" /></div>
                        <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="form-select">@foreach (var status in _statuses) { <option value="@status">@status</option> }</InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
                        <div class="um-field um-field--full"><label>GL Account</label><InputSelect @bind-Value="_form.GLAccountId" class="form-select"><option value="">None</option>@foreach (var account in _glAccounts) { <option value="@account.GLAccountId">@account.AccountCode - @account.AccountName</option> }</InputSelect><ValidationMessage For="() => _form.GLAccountId" class="text-danger" /></div>
                        <div class="um-field um-field--full"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="form-control" rows="2" /><ValidationMessage For="() => _form.Description" class="text-danger" /></div>
                        <div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_form.Notes" class="form-control" rows="2" /><ValidationMessage For="() => _form.Notes" class="text-danger" /></div>
                        @if (!string.IsNullOrWhiteSpace(_formError))
                        {
                            <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">@if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } @(_editingId == Guid.Empty ? "Create Invoice" : "Save Changes")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="api-enterprise-page">
    <section class="api-header">
        <div class="api-header-left">
            <div class="api-lob-icon"><i class="bi bi-receipt" aria-hidden="true"></i></div>
            <div class="api-header-info">
                <div class="api-title-row"><h1 class="api-page-title">AP Invoices</h1><span class="api-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live payable data</span><span class="api-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span></div>
                <div class="api-sub-row"><span>Track vendor invoices, due dates, balances, and AP workflow status.</span><span class="api-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Seed sync enabled</span><span class="api-sub-chip"><i class="bi bi-check2-circle" aria-hidden="true"></i> @_filtered.Count active matches</span></div>
            </div>
        </div>
        <div class="api-header-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/finance/vendors")'><i class="bi bi-shop" aria-hidden="true"></i> Vendors</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/finance/ap-payments")'><i class="bi bi-credit-card" aria-hidden="true"></i> Payments</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi @(_loading ? "bi-arrow-repeat api-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync" disabled="@(!_filtered.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Invoice</button>
        </div>
    </section>

    <section class="api-kpi-strip" aria-label="AP invoice metrics">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="api-kpi-card @kpi.Tone @(_kpiFilter == kpi.Filter ? "api-kpi-active" : null)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)">
                <span class="api-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span><span class="api-kpi-copy"><span class="api-kpi-label">@kpi.Label</span><span class="api-kpi-value">@kpi.Value</span><span class="api-kpi-caption">@kpi.Caption</span></span>
            </button>
        }
    </section>

    <section class="api-workflow-strip" aria-label="AP invoice workflow shortcuts">
        <button type="button" class="api-workflow-card api-wf-vendor" @onclick='() => Nav.NavigateTo("/finance/vendors")'><span class="api-workflow-icon"><i class="bi bi-shop" aria-hidden="true"></i></span><span class="api-workflow-content"><strong>1</strong><span>Vendor</span><small>Verify payee.</small></span></button>
        <button type="button" class="api-workflow-card api-wf-invoice" @onclick="OpenCreate"><span class="api-workflow-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span><span class="api-workflow-content"><strong>2</strong><span>Invoice</span><small>Capture payable.</small></span></button>
        <button type="button" class="api-workflow-card api-wf-approve" @onclick='() => SetKpiFilter("open")'><span class="api-workflow-icon"><i class="bi bi-check2-square" aria-hidden="true"></i></span><span class="api-workflow-content"><strong>3</strong><span>Review</span><small>Clear open items.</small></span></button>
        <button type="button" class="api-workflow-card api-wf-payment" @onclick='() => Nav.NavigateTo("/finance/ap-payments")'><span class="api-workflow-icon"><i class="bi bi-credit-card" aria-hidden="true"></i></span><span class="api-workflow-content"><strong>4</strong><span>Pay</span><small>Schedule payments.</small></span></button>
        <button type="button" class="api-workflow-card api-wf-ledger" @onclick='() => Nav.NavigateTo("/finance/journalentries")'><span class="api-workflow-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span><span class="api-workflow-content"><strong>5</strong><span>Post</span><small>Update ledger.</small></span></button>
    </section>

    <section class="api-enterprise-search" aria-label="AP invoice filters">
        <div class="api-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
        <div class="api-search-body"><label for="api-search">Search AP invoices</label><input id="api-search" class="api-search-input" type="search" placeholder="Search invoice number, vendor, status, description..." @bind="SearchFilter" @bind:event="oninput" /><span class="api-search-hint">Filters apply instantly across synchronized AP invoice records.</span></div>
        <select class="api-filter-select" @bind="StatusFilter" aria-label="Status filter"><option value="">All statuses</option>@foreach (var status in _statuses) { <option value="@status">@status</option> }</select>
        <select class="api-filter-select" @bind="VendorFilter" aria-label="Vendor filter"><option value="">All vendors</option>@foreach (var vendor in _vendors) { <option value="@vendor.VendorId.ToString()">@vendor.VendorName</option> }</select>
        <div class="api-search-result"><strong>@_filtered.Count</strong><span>matches</span></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger api-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
    }

    <section class="api-content-layout">
        <div class="api-grid-wrap">
            <div class="api-grid-toolbar"><div><strong>AP invoice register</strong><span>@ActiveFilterText</span></div><div class="api-toolbar-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-eraser" aria-hidden="true"></i> Reset</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/finance/vendors")'><i class="bi bi-shop" aria-hidden="true"></i> Vendors</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add</button></div></div>
            @if (_loading)
            {
                <div class="api-loading"><i class="bi bi-arrow-repeat api-spin" aria-hidden="true"></i><strong>Loading AP invoices...</strong><span>Syncing schema, seed data, vendors, GL accounts, and payable entries.</span></div>
            }
            else if (!_filtered.Any())
            {
                <div class="api-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No AP invoices found</strong><span>Adjust filters or create a new invoice.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">New Invoice</button></div>
            }
            else
            {
                <div class="api-table-scroll"><table class="api-table"><thead><tr><th>Invoice</th><th>Vendor</th><th>Due</th><th class="api-number">Amount</th><th class="api-number">Balance</th><th>Status</th><th class="api-actions-col">Actions</th></tr></thead><tbody>@foreach (var item in PagedItems) { <tr class="api-table-row @(_selected?.ApInvoiceId == item.ApInvoiceId ? "api-table-row--selected" : null)" @onclick="() => SelectInvoice(item)"><td><div class="api-entry-cell"><span class="api-entry-icon @StatusIconTone(item.StatusCode)"><i class="bi bi-receipt" aria-hidden="true"></i></span><span><strong>@item.InvoiceNumber</strong><span>@item.InvoiceDate.ToString("MMM d, yyyy") · @GlAccountName(item.GLAccountId)</span></span></div></td><td>@VendorName(item.VendorId)</td><td><span class="@DueCss(item)">@item.DueDate.ToString("MMM d, yyyy")</span></td><td class="api-number">@Fmt(item.Amount)</td><td class="api-number"><span class="@(Balance(item) > 0 ? "api-unpaid" : "api-paid")">@Fmt(Balance(item))</span></td><td><span class="api-status-chip @StatusCss(item.StatusCode)">@item.StatusCode</span></td><td><div class="api-row-acts"><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Edit" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Mark Paid" disabled="@(item.StatusCode == "Paid")" @onclick:stopPropagation="true" @onclick='() => ConfirmStatusUpdate(item, "Paid")'><i class="bi bi-check-circle" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Void" disabled="@(item.StatusCode == "Void")" @onclick:stopPropagation="true" @onclick='() => ConfirmStatusUpdate(item, "Void")'><i class="bi bi-slash-circle" aria-hidden="true"></i></button></div></td></tr> }</tbody></table></div>
                <div class="api-pager"><span>Showing @PageStart-@PageEnd of @_filtered.Count</span><div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PrevPage" disabled="@(_page == 1)">Previous</button><span>Page @_page of @TotalPages</span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button></div></div>
            }
        </div>
        <aside class="api-detail-panel" aria-label="Selected AP invoice detail">
            @if (_selected is null)
            {
                <div class="api-detail-empty"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select an invoice</strong><span>Choose a row to inspect vendor, due date, balance, and workflow actions.</span></div>
            }
            else
            {
                <div class="api-detail-head"><div><span class="api-detail-eyebrow"><i class="bi bi-receipt" aria-hidden="true"></i> AP invoice</span><h2>@_selected.InvoiceNumber</h2><div class="api-detail-meta"><span>@VendorName(_selected.VendorId)</span><span class="api-status-chip @StatusCss(_selected.StatusCode)">@_selected.StatusCode</span></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></div>
                <div class="api-detail-body"><div class="api-detail-summary"><div class="api-meta-row"><span class="api-meta-lbl">Amount</span><span class="api-meta-val">@Fmt(_selected.Amount)</span></div><div class="api-meta-row"><span class="api-meta-lbl">Paid</span><span class="api-meta-val">@Fmt(_selected.AmountPaid)</span></div><div class="api-meta-row"><span class="api-meta-lbl">Balance</span><span class="api-meta-val @(Balance(_selected) > 0 ? "api-unpaid" : "api-paid")">@Fmt(Balance(_selected))</span></div><div class="api-meta-row"><span class="api-meta-lbl">Tax</span><span class="api-meta-val">@Fmt(_selected.TaxAmount)</span></div></div><div class="api-note-card"><span><i class="bi bi-calendar-check" aria-hidden="true"></i> Payable detail</span><p>Invoice date @_selected.InvoiceDate.ToString("MMM d, yyyy") · due @_selected.DueDate.ToString("MMM d, yyyy") · @GlAccountName(_selected.GLAccountId). @(!string.IsNullOrWhiteSpace(_selected.Description) ? _selected.Description : _selected.Notes)</p></div><div class="api-detail-actions"><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, "Paid")' disabled="@(_selected.StatusCode == "Paid")"><i class="bi bi-check-circle" aria-hidden="true"></i> Mark Paid</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, _selected.StatusCode == "Void" ? "Open" : "Void")'><i class="bi @(_selected.StatusCode == "Void" ? "bi-arrow-counterclockwise" : "bi-slash-circle")" aria-hidden="true"></i> @(_selected.StatusCode == "Void" ? "Reopen" : "Void")</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/finance/ap-payments")'><i class="bi bi-credit-card" aria-hidden="true"></i> Payments</button></div></div>
            }
        </aside>
    </section>
</div>

@code {
    private const int PageSize = 12;
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<ApInvoiceDto> _items = [];
    private List<ApInvoiceDto> _filtered = [];
    private List<VendorDto> _vendors = [];
    private List<GLAccountDto> _glAccounts = [];
    private ApInvoiceDto? _selected;
    private ApInvoiceDto? _statusTarget;
    private ApInvoiceForm _form = new();
    private Guid _editingId = Guid.Empty;
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private string _vendorFilter = string.Empty;
    private string _kpiFilter = "all";
    private string? _pendingStatus;
    private int _page = 1;
    private bool _loading;
    private bool _busy;
    private bool _showForm;
    private bool _showStatusConfirm;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string? _formError;
    private readonly List<string> _statuses = ["Open", "Pending", "Paid", "Void"];

    private IEnumerable<ApInvoiceDto> PagedItems => _filtered.Skip((_page - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
    private int PageStart => _filtered.Count == 0 ? 0 : ((_page - 1) * PageSize) + 1;
    private int PageEnd => Math.Min(_filtered.Count, _page * PageSize);
    private decimal OpenBalance => _items.Where(x => x.StatusCode != "Paid" && x.StatusCode != "Void").Sum(Balance);
    private decimal PaidAmount => _items.Where(x => x.StatusCode == "Paid").Sum(x => x.AmountPaid);
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", "info" => "bi-info-circle-fill", _ => "bi-check-circle-fill" };
    private string ActiveFilterText => _kpiFilter == "all" ? "All AP invoices" : $"Filtered by {_kpiFilter}";
    private IReadOnlyList<KpiModel> Kpis =>
    [
        new("all", "Invoices", _items.Count.ToString("N0"), "All payables", "bi-receipt", "api-ki-blue"),
        new("open", "Open", _items.Count(x => x.StatusCode == "Open" || x.StatusCode == "Pending").ToString("N0"), "Needs action", "bi-hourglass", "api-ki-amber"),
        new("overdue", "Overdue", _items.Count(IsOverdue).ToString("N0"), "Past due", "bi-exclamation-triangle", "api-ki-red"),
        new("balance", "Balance", Fmt(OpenBalance), "Outstanding", "bi-cash-stack", "api-ki-red"),
        new("paid", "Paid", Fmt(PaidAmount), "Settled", "bi-check-circle", "api-ki-green"),
        new("vendors", "Vendors", _items.Select(x => x.VendorId).Distinct().Count().ToString("N0"), "With invoices", "bi-shop", "api-ki-purple")
    ];

    private string SearchFilter { get => _searchTerm; set { _searchTerm = value; ApplyFilters(resetPage: true); } }
    private string StatusFilter { get => _statusFilter; set { _statusFilter = value; ApplyFilters(resetPage: true); } }
    private string VendorFilter { get => _vendorFilter; set { _vendorFilter = value; ApplyFilters(resetPage: true); } }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Finance", "/finance"), new("AP Invoices", "/finance/ap-invoices"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchApInvoicesAsync(_tenantId, string.Empty);
            var vendors = await Api.SearchVendorsAsync(_tenantId, pageSize: 500);
            var glAccounts = await Api.SearchGLAccountsAsync(_tenantId, pageSize: 500);
            _items = result?.Items.OrderByDescending(x => x.InvoiceDate).ThenBy(x => x.InvoiceNumber).ToList() ?? [];
            _vendors = vendors?.Items.OrderBy(x => x.VendorName).ToList() ?? [];
            _glAccounts = glAccounts?.Items.OrderBy(x => x.AccountCode).ToList() ?? [];
            ApplyFilters(resetPage: true);
            EnsureSelectedStillVisible();
        }
        catch (Exception ex)
        {
            _loadError = $"AP invoices failed to load: {ex.Message}";
            ShowToast(_loadError, "danger");
            _items = [];
            _filtered = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters(bool resetPage)
    {
        IEnumerable<ApInvoiceDto> query = _items;
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(x => Contains(x.InvoiceNumber, term) || Contains(x.Description, term) || Contains(x.Notes, term) || Contains(x.StatusCode, term) || Contains(VendorName(x.VendorId), term));
        }

        if (!string.IsNullOrWhiteSpace(_statusFilter)) query = query.Where(x => x.StatusCode == _statusFilter);
        if (Guid.TryParse(_vendorFilter, out var vendorId)) query = query.Where(x => x.VendorId == vendorId);
        query = _kpiFilter switch
        {
            "open" => query.Where(x => x.StatusCode == "Open" || x.StatusCode == "Pending"),
            "overdue" => query.Where(IsOverdue),
            "balance" => query.Where(x => Balance(x) > 0 && x.StatusCode != "Void"),
            "paid" => query.Where(x => x.StatusCode == "Paid"),
            "vendors" => query.Where(x => _vendors.Any(v => v.VendorId == x.VendorId)),
            _ => query
        };

        _filtered = query.OrderByDescending(x => x.InvoiceDate).ThenBy(x => x.InvoiceNumber).ToList();
        if (resetPage) _page = 1;
        if (_page > TotalPages) _page = TotalPages;
    }

    private void SetKpiFilter(string filter) { _kpiFilter = filter; ApplyFilters(resetPage: true); }
    private void ResetFilters() { _searchTerm = string.Empty; _statusFilter = string.Empty; _vendorFilter = string.Empty; _kpiFilter = "all"; ApplyFilters(resetPage: true); ShowToast("AP invoice filters reset.", "info"); }
    private void SelectInvoice(ApInvoiceDto item) => _selected = item;
    private void OpenCreate() { _editingId = Guid.Empty; _formError = null; _form = new ApInvoiceForm { InvoiceDate = DateTime.Today, DueDate = DateTime.Today.AddDays(30) }; _showForm = true; }
    private void OpenEdit(ApInvoiceDto invoice) { _editingId = invoice.ApInvoiceId; _formError = null; _form = new ApInvoiceForm { VendorId = invoice.VendorId, InvoiceNumber = invoice.InvoiceNumber, InvoiceDate = invoice.InvoiceDate.ToDateTime(TimeOnly.MinValue), DueDate = invoice.DueDate.ToDateTime(TimeOnly.MinValue), Amount = invoice.Amount, AmountPaid = invoice.AmountPaid, TaxAmount = invoice.TaxAmount, StatusCode = invoice.StatusCode, GLAccountId = invoice.GLAccountId, Description = invoice.Description, Notes = invoice.Notes }; _showForm = true; }
    private void CloseForm() { if (_busy) return; _showForm = false; }

    private async Task SaveAsync()
    {
        if (_form.DueDate < _form.InvoiceDate) { _formError = "Due Date must be on or after Invoice Date."; ShowToast(_formError, "warning"); return; }
        if (_form.AmountPaid > _form.Amount) { _formError = "Amount Paid cannot exceed Amount."; ShowToast(_formError, "warning"); return; }
        _busy = true;
        _formError = null;
        try
        {
            if (_editingId == Guid.Empty)
            {
                await Api.CreateApInvoiceAsync(new CreateApInvoiceRequest { TenantId = _tenantId, VendorId = _form.VendorId, InvoiceNumber = _form.InvoiceNumber, InvoiceDate = DateOnly.FromDateTime(_form.InvoiceDate), DueDate = DateOnly.FromDateTime(_form.DueDate), Amount = _form.Amount, AmountPaid = _form.AmountPaid, TaxAmount = _form.TaxAmount, StatusCode = _form.StatusCode, GLAccountId = _form.GLAccountId, Description = _form.Description, Notes = _form.Notes, CreatedByUserId = _tenantAdminUserId });
                ShowToast("AP invoice created.", "success");
            }
            else
            {
                await Api.UpdateApInvoiceAsync(_editingId, new UpdateApInvoiceRequest { TenantId = _tenantId, ApInvoiceId = _editingId, VendorId = _form.VendorId, InvoiceNumber = _form.InvoiceNumber, InvoiceDate = DateOnly.FromDateTime(_form.InvoiceDate), DueDate = DateOnly.FromDateTime(_form.DueDate), Amount = _form.Amount, AmountPaid = _form.AmountPaid, TaxAmount = _form.TaxAmount, StatusCode = _form.StatusCode, GLAccountId = _form.GLAccountId, Description = _form.Description, Notes = _form.Notes, ModifiedByUserId = _tenantAdminUserId });
                ShowToast("AP invoice updated.", "success");
            }

            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
            ShowToast(_formError, "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void ConfirmStatusUpdate(ApInvoiceDto item, string status) { _statusTarget = item; _pendingStatus = status; _showStatusConfirm = true; }
    private void CancelStatusUpdate() { if (_busy) return; _showStatusConfirm = false; _statusTarget = null; _pendingStatus = null; }
    private async Task ExecuteStatusUpdateAsync()
    {
        if (_statusTarget is null || string.IsNullOrWhiteSpace(_pendingStatus)) return;
        _busy = true;
        try
        {
            var amountPaid = _pendingStatus == "Paid" ? _statusTarget.Amount : _pendingStatus == "Void" ? 0 : _statusTarget.AmountPaid;
            await Api.UpdateApInvoiceAsync(_statusTarget.ApInvoiceId, new UpdateApInvoiceRequest { TenantId = _tenantId, ApInvoiceId = _statusTarget.ApInvoiceId, VendorId = _statusTarget.VendorId, InvoiceNumber = _statusTarget.InvoiceNumber, InvoiceDate = _statusTarget.InvoiceDate, DueDate = _statusTarget.DueDate, Amount = _statusTarget.Amount, AmountPaid = amountPaid, TaxAmount = _statusTarget.TaxAmount, StatusCode = _pendingStatus, GLAccountId = _statusTarget.GLAccountId, AgreementId = _statusTarget.AgreementId, Description = _statusTarget.Description, Notes = _statusTarget.Notes, ModifiedByUserId = _tenantAdminUserId });
            ShowToast($"AP invoice marked {_pendingStatus.ToLowerInvariant()}.", "success");
            _showStatusConfirm = false;
            _statusTarget = null;
            _pendingStatus = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Update failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private Task NotifyValidationAsync(EditContext _) { ShowToast("Please correct validation errors before saving the AP invoice.", "warning"); return Task.CompletedTask; }
    private async Task ExportAsync()
    {
        if (!_filtered.Any()) { ShowToast("No AP invoices are available to export.", "warning"); return; }
        var csv = new StringBuilder();
        csv.AppendLine("InvoiceNumber,Vendor,InvoiceDate,DueDate,Amount,AmountPaid,Balance,TaxAmount,Status,GLAccount,Description,Notes,ApInvoiceId");
        foreach (var item in _filtered) csv.AppendLine(string.Join(',', Csv(item.InvoiceNumber), Csv(VendorName(item.VendorId)), Csv(item.InvoiceDate.ToString("yyyy-MM-dd")), Csv(item.DueDate.ToString("yyyy-MM-dd")), item.Amount.ToString("0.00"), item.AmountPaid.ToString("0.00"), Balance(item).ToString("0.00"), item.TaxAmount.ToString("0.00"), Csv(item.StatusCode), Csv(GlAccountName(item.GLAccountId)), Csv(item.Description ?? string.Empty), Csv(item.Notes ?? string.Empty), Csv(item.ApInvoiceId.ToString())));
        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        await Js.InvokeVoidAsync("amsShell.downloadBase64", $"ap-invoices-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
        ShowToast($"Exported {_filtered.Count:N0} AP invoices.", "success");
    }

    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind) { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void EnsureSelectedStillVisible() => _selected = _selected is null ? _filtered.FirstOrDefault() : _items.FirstOrDefault(x => x.ApInvoiceId == _selected.ApInvoiceId) ?? _filtered.FirstOrDefault();
    private string VendorName(Guid vendorId) => _vendors.FirstOrDefault(x => x.VendorId == vendorId)?.VendorName ?? "Unknown vendor";
    private string GlAccountName(Guid? glAccountId) => glAccountId is null ? "No GL account" : _glAccounts.FirstOrDefault(x => x.GLAccountId == glAccountId)?.AccountName ?? "GL account";
    private static decimal Balance(ApInvoiceDto item) => Math.Max(0, item.Amount - item.AmountPaid);
    private static bool IsOverdue(ApInvoiceDto item) => item.StatusCode != "Paid" && item.StatusCode != "Void" && item.DueDate < DateOnly.FromDateTime(DateTime.Today);
    private static string DueCss(ApInvoiceDto item) => IsOverdue(item) ? "api-overdue" : item.StatusCode == "Paid" ? "api-paid" : "";
    private static string Fmt(decimal value) => value.ToString("C0");
    private static bool Contains(string? value, string term) => value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
    private static string StatusCss(string status) => $"api-st-{status.ToLowerInvariant()}";
    private static string StatusIconTone(string status) => status switch { "Paid" => "api-di-green", "Pending" => "api-di-amber", "Void" => "api-di-slate", _ => "api-di-blue" };
    private static string StatusActionIcon(string status) => status switch { "Paid" => "bi-check-circle", "Void" => "bi-slash-circle", "Open" => "bi-arrow-counterclockwise", _ => "bi-hourglass" };
    private static string StatusActionTitle(string status) => status switch { "Paid" => "Mark Paid", "Void" => "Void Invoice", "Open" => "Reopen Invoice", _ => $"Mark {status}" };
    private static string StatusActionButton(string status) => status switch { "Paid" => "Mark Paid", "Void" => "Void", "Open" => "Reopen", _ => $"Mark {status}" };
    private static string Csv(string value) { var quote = Convert.ToChar(34).ToString(); return string.Concat(quote, value.Replace(quote, quote + quote), quote); }
    private async Task ResolveCurrentUserContextAsync() { var context = await CurrentUser.RequireAsync(); _tenantId = context.TenantId; _tenantAdminUserId = context.UserId; }
    private sealed record KpiModel(string Filter, string Label, string Value, string Caption, string Icon, string Tone) { public string Title => $"Filter AP invoices by {Label}"; }

    private sealed class ApInvoiceForm
    {
        [RequiredGuid(ErrorMessage = "Vendor is required.")] public Guid VendorId { get; set; }
        [Required, StringLength(80)] public string InvoiceNumber { get; set; } = string.Empty;
        [Required] public DateTime InvoiceDate { get; set; } = DateTime.Today;
        [Required] public DateTime DueDate { get; set; } = DateTime.Today.AddDays(30);
        [Range(0.01, 100000000)] public decimal Amount { get; set; }
        [Range(0, 100000000)] public decimal AmountPaid { get; set; }
        [Range(0, 100000000)] public decimal TaxAmount { get; set; }
        [Required, StringLength(50)] public string StatusCode { get; set; } = "Open";
        public Guid? GLAccountId { get; set; }
        [StringLength(1000)] public string? Description { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
    }
}