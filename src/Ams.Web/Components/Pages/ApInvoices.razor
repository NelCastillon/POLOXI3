@page "/finance/ap-invoices"
@inject ApiClient Api

<PageTitle>AP Invoices</PageTitle>
<h1>AP Invoices</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(ApInvoiceDto.InvoiceNumber)"   HeaderText="Invoice #"     Width="140"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceDto.InvoiceDate)"     HeaderText="Invoice Date"  Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceDto.DueDate)"         HeaderText="Due Date"      Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceDto.TotalAmount)"     HeaderText="Total"         Format="C2" Width="120"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceDto.PaidAmount)"      HeaderText="Paid"          Format="C2" Width="110"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceDto.BalanceAmount)"   HeaderText="Balance"       Format="C2" Width="110"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceDto.StatusCode)"      HeaderText="Status"        Width="110"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<ApInvoiceDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchApInvoicesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
