@page "/finance/ap-invoices"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>AP Invoices</PageTitle>

<AppPageHeader Title="Accounts Payable Invoices"
               Subtitle="Track and manage vendor invoices"
               Icon="bi-receipt">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "fa-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Invoice
        </button>
    </Actions>
</AppPageHeader>

<!-- -- Search & Filter ---------------------------------------------------- -->
<div class="fin-toolbar">
    <div class="fin-search-box">
        <i class="bi bi-search fin-search-icon" aria-hidden="true"></i>
        <input class="e-input fin-search-input"
               placeholder="Search invoices…"
               @bind="_searchTerm"
               @bind:event="oninput"
               @onkeyup="@(e => e.Key == "Enter" ? LoadAsync() : Task.CompletedTask)" />
    </div>
    <div class="fin-filter-buttons">
        <button class="um-btn um-btn-ghost um-btn-sm @(_filterActive ? "um-btn-active" : "")"
                @onclick="() => _filterActive = !_filterActive">
            <i class="bi bi-funnel" aria-hidden="true"></i> Filter
        </button>
    </div>
</div>

@if (_filterActive)
{
    <div class="fin-filter-panel">
        <div class="fin-filter-group">
            <label class="fin-filter-label">Status</label>
            <select class="e-input" @bind="_filterStatus">
                <option value="">All</option>
                <option value="Draft">Draft</option>
                <option value="Pending">Pending</option>
                <option value="Paid">Paid</option>
            </select>
        </div>
    </div>
}

<!-- -- KPI Cards -------------------------------------------------------- -->
@if (_stats is not null)
{
    <div class="fin-kpi-strip">
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #fef3c7; color: #b45309;"><i class="bi bi-receipt-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.TotalInvoices</div>
                <div class="fin-kpi-label">Total Invoices</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #fee2e2; color: #b91c1c;"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.PendingAmount.ToString("C0")</div>
                <div class="fin-kpi-label">Pending Amount</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #d1fae5; color: #047857;"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.PaidAmount.ToString("C0")</div>
                <div class="fin-kpi-label">Paid Amount</div>
            </div>
        </div>
    </div>
}

<!-- -- Content -------------------------------------------------------- -->
@if (_error is not null)
{
    <div class="fin-alert fin-alert-warning">
        <div class="fin-alert-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></div>
        <div class="fin-alert-body">
            <div class="fin-alert-title">?? Database Schema Issue</div>
            <p>Finance schema initialization required. Run: <strong>sql/01_Finance_Schema.sql</strong></p>
        </div>
    </div>
}
else if (_loading)
{
    <div class="fin-loading">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading AP Invoices…</span>
    </div>
}
else if (_items?.Count == 0)
{
    <div class="fin-empty-state">
        <i class="bi bi-inbox fin-empty-icon" aria-hidden="true"></i>
        <h3>No Invoices Found</h3>
        <p>@(_searchTerm != null ? $"No invoices match \"{_searchTerm}\"." : "No invoices have been created yet.")</p>
    </div>
}
else
{
    <div class="fin-grid-container">
        <SfGrid TValue="ApInvoiceDto" DataSource="_items" AllowPaging="true" AllowSorting="true" Height="600px">
            <GridEvents TValue="ApInvoiceDto" RowSelected="OnRowSelected" />
            <GridPageSettings PageSize="12"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(ApInvoiceDto.InvoiceNumber)" HeaderText="Invoice #" Width="120" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(ApInvoiceDto.InvoiceDate)" HeaderText="Date" Type="ColumnType.Date" Format="d" Width="110" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(ApInvoiceDto.DueDate)" HeaderText="Due Date" Type="ColumnType.Date" Format="d" Width="110" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(ApInvoiceDto.Amount)" HeaderText="Total" Format="C2" Width="110" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(ApInvoiceDto.AmountPaid)" HeaderText="Paid" Format="C2" Width="110" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(ApInvoiceDto.TaxAmount)" HeaderText="Tax" Format="C2" Width="100" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(ApInvoiceDto.StatusCode)" HeaderText="Status" Width="100" AllowSorting="true">
                    <Template>
                        @{
                            var invoice = context as ApInvoiceDto;
                            var badgeClass = invoice?.StatusCode switch
                            {
                                "Open" => "fin-badge-warning",
                                "Paid" => "fin-badge-success",
                                _ => "fin-badge-secondary"
                            };
                        }
                        <span class="fin-badge @badgeClass">@invoice?.StatusCode</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Actions" Width="90">
                    <Template>
                        @{ var invoice = (ApInvoiceDto)context; }
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenEdit(invoice)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
}

<SfDialog @bind-Visible="_showForm" Width="720px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-receipt" aria-hidden="true"></i><span>@(_editingId == Guid.Empty ? "New AP Invoice" : "Edit AP Invoice")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Vendor <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.VendorId" class="um-input"><option value="@Guid.Empty">Select vendor…</option>@foreach (var vendor in _vendors) { <option value="@vendor.VendorId">@vendor.VendorName</option> }</InputSelect><ValidationMessage For="() => _form.VendorId" class="text-danger" /></div>
                    <div class="um-field"><label>Invoice Number <span class="text-danger">*</span></label><InputText @bind-Value="_form.InvoiceNumber" class="um-input" /><ValidationMessage For="() => _form.InvoiceNumber" class="text-danger" /></div>
                    <div class="um-field"><label>Invoice Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.InvoiceDate" class="um-input" /><ValidationMessage For="() => _form.InvoiceDate" class="text-danger" /></div>
                    <div class="um-field"><label>Due Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.DueDate" class="um-input" /><ValidationMessage For="() => _form.DueDate" class="text-danger" /></div>
                    <div class="um-field"><label>Amount <span class="text-danger">*</span></label><InputNumber @bind-Value="_form.Amount" class="um-input" /><ValidationMessage For="() => _form.Amount" class="text-danger" /></div>
                    <div class="um-field"><label>Amount Paid</label><InputNumber @bind-Value="_form.AmountPaid" class="um-input" /><ValidationMessage For="() => _form.AmountPaid" class="text-danger" /></div>
                    <div class="um-field"><label>Tax Amount</label><InputNumber @bind-Value="_form.TaxAmount" class="um-input" /><ValidationMessage For="() => _form.TaxAmount" class="text-danger" /></div>
                    <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input"><option value="Open">Open</option><option value="Pending">Pending</option><option value="Paid">Paid</option><option value="Void">Void</option></InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
                    <div class="um-field"><label>GL Account</label><InputSelect @bind-Value="_form.GLAccountId" class="um-input"><option value="">None</option>@foreach (var account in _glAccounts) { <option value="@account.GLAccountId">@account.AccountCode - @account.AccountName</option> }</InputSelect><ValidationMessage For="() => _form.GLAccountId" class="text-danger" /></div>
                    <div class="um-field um-field--full"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="2" /><ValidationMessage For="() => _form.Description" class="text-danger" /></div>
                    <div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_form.Notes" class="um-input" rows="2" /><ValidationMessage For="() => _form.Notes" class="text-danger" /></div>
                    @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Invoice")</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private string _filterStatus = "";
    private bool _filterActive = false;
    private bool _loading = false;
    private bool _showForm;
    private bool _saving;
    private List<ApInvoiceDto>? _items;
    private List<VendorDto> _vendors = [];
    private List<GLAccountDto> _glAccounts = [];
    private string? _error;
    private string? _formError;
    private Guid _editingId = Guid.Empty;
    private ApInvoiceForm _form = new();
    private EditContext _editContext = default!;

    private class Stats
    {
        public int TotalInvoices { get; set; }
        public decimal PendingAmount { get; set; }
        public decimal PaidAmount { get; set; }
    }

    private Stats? _stats;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(
            new("Home", "/"),
            new("Finance", "/finance"),
            new("AP Invoices", "/finance/ap-invoices"));
        _editContext = new(_form);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _items = null;
        try
        {
            var result = await Api.SearchApInvoicesAsync(_tenantId, _searchTerm);
            var vendors = await Api.SearchVendorsAsync(_tenantId, pageSize: 500);
            var glAccounts = await Api.SearchGLAccountsAsync(_tenantId, pageSize: 500);
            _items = result?.Items.ToList() ?? [];
            _vendors = vendors?.Items.ToList() ?? [];
            _glAccounts = glAccounts?.Items.ToList() ?? [];

            if (!string.IsNullOrEmpty(_filterStatus))
                _items = _items.Where(x => x.StatusCode == _filterStatus).ToList();

            _stats = new Stats
            {
                TotalInvoices = _items.Count,
                PendingAmount = _items.Where(x => x.StatusCode != "Paid").Sum(x => x.Amount - x.AmountPaid),
                PaidAmount = _items.Where(x => x.StatusCode == "Paid").Sum(x => x.AmountPaid)
            };
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            if (ex.Message.Contains("Invalid column name") || ex.Message.Contains("ApInvoice"))
            {
                _error = "Database schema mismatch. Please ensure 00_schema_migration.sql has been applied to your database. See db/README.md for setup instructions.";
            }
            _items = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnRowSelected(RowSelectEventArgs<ApInvoiceDto> args) => OpenEdit(args.Data);
    private void OpenCreate() { _editingId = Guid.Empty; _form = new(); _editContext = new(_form); _formError = null; _showForm = true; }
    private void OpenEdit(ApInvoiceDto invoice) { _editingId = invoice.ApInvoiceId; _form = new ApInvoiceForm { VendorId = invoice.VendorId, InvoiceNumber = invoice.InvoiceNumber, InvoiceDate = invoice.InvoiceDate.ToDateTime(TimeOnly.MinValue), DueDate = invoice.DueDate.ToDateTime(TimeOnly.MinValue), Amount = invoice.Amount, AmountPaid = invoice.AmountPaid, TaxAmount = invoice.TaxAmount, StatusCode = invoice.StatusCode, GLAccountId = invoice.GLAccountId, Description = invoice.Description, Notes = invoice.Notes }; _editContext = new(_form); _formError = null; _showForm = true; }
    private void CloseForm() => _showForm = false;
    private async Task SaveAsync()
    {
        if (!_editContext.Validate()) return;
        if (_form.DueDate < _form.InvoiceDate) { _formError = "Due Date must be on or after Invoice Date."; return; }
        if (_form.AmountPaid > _form.Amount) { _formError = "Amount Paid cannot exceed Amount."; return; }
        _saving = true;
        try
        {
            if (_editingId == Guid.Empty)
                await Api.CreateApInvoiceAsync(new CreateApInvoiceRequest { TenantId = _tenantId, VendorId = _form.VendorId, InvoiceNumber = _form.InvoiceNumber, InvoiceDate = DateOnly.FromDateTime(_form.InvoiceDate), DueDate = DateOnly.FromDateTime(_form.DueDate), Amount = _form.Amount, AmountPaid = _form.AmountPaid, TaxAmount = _form.TaxAmount, StatusCode = _form.StatusCode, GLAccountId = _form.GLAccountId, Description = _form.Description, Notes = _form.Notes });
            else
                await Api.UpdateApInvoiceAsync(_editingId, new UpdateApInvoiceRequest { TenantId = _tenantId, ApInvoiceId = _editingId, VendorId = _form.VendorId, InvoiceNumber = _form.InvoiceNumber, InvoiceDate = DateOnly.FromDateTime(_form.InvoiceDate), DueDate = DateOnly.FromDateTime(_form.DueDate), Amount = _form.Amount, AmountPaid = _form.AmountPaid, TaxAmount = _form.TaxAmount, StatusCode = _form.StatusCode, GLAccountId = _form.GLAccountId, Description = _form.Description, Notes = _form.Notes });
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; }
        finally { _saving = false; }
    }

    private sealed class ApInvoiceForm
    {
        [RequiredGuid(ErrorMessage = "Vendor is required.")] public Guid VendorId { get; set; }
        [Required, StringLength(80)] public string InvoiceNumber { get; set; } = string.Empty;
        [Required] public DateTime InvoiceDate { get; set; } = DateTime.Today;
        [Required] public DateTime DueDate { get; set; } = DateTime.Today;
        [Range(0.01, 100000000)] public decimal Amount { get; set; }
        [Range(0, 100000000)] public decimal AmountPaid { get; set; }
        [Range(0, 100000000)] public decimal TaxAmount { get; set; }
        [Required, StringLength(50)] public string StatusCode { get; set; } = "Open";
        public Guid? GLAccountId { get; set; }
        [StringLength(1000)] public string? Description { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
