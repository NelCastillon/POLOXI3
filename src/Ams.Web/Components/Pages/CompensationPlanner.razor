    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Commissions", "/commissions2"), new("What-If Planner", "/commissions/planner"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await Api.EnsureCommissionSeedAsync(_tenantId, _tenantAdminUserId);
            await Api.EnsureCommissionForecastsSeedAsync(_tenantId);
            await Api.EnsureCommissionPlannerScenariosSeedAsync(_tenantId);
            var scenarios = await Api.SearchCommissionPlannerScenariosAsync(_tenantId, string.Empty);
            var plans = await Api.SearchCommissionPlansAsync(_tenantId, string.Empty);
            var payees = await Api.SearchCommissionPayeesAsync(_tenantId, string.Empty);
            var forecasts = await Api.SearchCommissionForecastsAsync(_tenantId, string.Empty);
            _items = scenarios?.Items.OrderBy(x => StatusSort(x.StatusCode)).ThenByDescending(x => x.CreatedDateUtc).ToList() ?? [];
            _plans = plans?.Items.OrderBy(x => x.PlanName).ToList() ?? [];
            _payees = payees?.Items.OrderBy(x => x.PayeeTypeCode).ToList() ?? [];
            _forecasts = forecasts?.Items.ToList() ?? [];
            ApplyFilters(resetPage: true);
            EnsureSelectedStillVisible();
        }
        catch (Exception ex)
        {
            _loadError = $"Compensation planner failed to load: {ex.Message}";
            ShowToast(_loadError, "danger");
            _items = [];
            _filtered = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters(bool resetPage)
    {
        IEnumerable<CommissionPlannerScenarioDto> query = _items;
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(x => Contains(x.ScenarioNumber, term) || Contains(x.ScenarioName, term) || Contains(x.ScenarioTypeCode, term) || Contains(x.SplitTypeCode, term) || Contains(x.StatusCode, term) || Contains(x.Notes, term) || Contains(x.PayeeName, term) || Contains(x.PlanName, term));
        }
        if (!string.IsNullOrWhiteSpace(_typeFilter)) query = query.Where(x => x.ScenarioTypeCode == _typeFilter);
        if (!string.IsNullOrWhiteSpace(_statusFilter)) query = query.Where(x => x.StatusCode == _statusFilter);
        query = _kpiFilter switch { "active" => query.Where(x => x.StatusCode == "Active"), "risk" => query.Where(x => x.ScenarioTypeCode == "Risk Model" || x.ProjectedClawbacks > 5000), "override" => query.Where(x => x.BranchOverride), "net" => query.Where(x => x.NetPayout > 0), "forecast" => query, _ => query };
        _filtered = query.OrderBy(x => StatusSort(x.StatusCode)).ThenByDescending(x => x.CreatedDateUtc).ToList();
        if (resetPage) _page = 1;
        if (_page > TotalPages) _page = TotalPages;
    }

    private void SetKpiFilter(string filter) { _kpiFilter = _kpiFilter == filter && filter != "all" ? "all" : filter; ApplyFilters(resetPage: true); }
    private void ResetFilters() { _searchTerm = string.Empty; _statusFilter = string.Empty; _typeFilter = string.Empty; _kpiFilter = "all"; ApplyFilters(resetPage: true); ShowToast("Planner filters reset.", "info"); }
    private void SelectScenario(CommissionPlannerScenarioDto item) => _selected = item;

