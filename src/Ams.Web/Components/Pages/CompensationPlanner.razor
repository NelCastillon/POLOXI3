    private bool ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(_form.ScenarioNumber)) { _formError = "Scenario Number is required."; ShowToast(_formError, "warning"); return false; }
        if (string.IsNullOrWhiteSpace(_form.ScenarioName)) { _formError = "Scenario Name is required."; ShowToast(_formError, "warning"); return false; }
        if (_form.PrimarySplitPct + _form.SecondarySplitPct > 100m && !_form.BranchOverride) { _formError = "Primary and secondary splits cannot exceed 100%."; ShowToast(_formError, "warning"); return false; }
        return true;
    }

    private IReadOnlyList<ProducerRow> BuildRows(CommissionPlannerScenarioDto item)
    {
        if (item.HouseAccount) return [new("House Account", "House Account", 100, item.TotalCommission, item.ProjectedClawbacks, item.NetPayout)];
        var totalWithoutOverride = item.TotalCommission - item.OverrideCommission;
        var clawPrimary = item.SharedClawbacks ? item.ProjectedClawbacks * item.PrimarySplitPct / 100m : item.ProjectedClawbacks;
        var clawSecondary = item.SharedClawbacks ? item.ProjectedClawbacks * item.SecondarySplitPct / 100m : 0m;
        var rows = new List<ProducerRow> { new("Primary Producer", "Primary", item.PrimarySplitPct, totalWithoutOverride * item.PrimarySplitPct / 100m, clawPrimary, item.PrimaryNetPayout) };
        if (item.SecondarySplitPct > 0) rows.Add(new("Secondary Producer", "Secondary", item.SecondarySplitPct, totalWithoutOverride * item.SecondarySplitPct / 100m, clawSecondary, item.SecondaryNetPayout));
        if (item.BranchOverride) rows.Add(new("Branch Office", "Branch Manager", 0, item.OverrideCommission, 0, item.BranchNetPayout));
        return rows;
    }

    private IReadOnlyList<ComparisonRow> BuildComparisons(CommissionPlannerScenarioDto item)
    {
        var net = item.NetPayout;
        return [new("No Split", net, 0, net), new("60/40", net * .60m, net * .40m, net), new("50/50", net * .50m, net * .50m, net), new("70/30", net * .70m, net * .30m, net)];
    }

