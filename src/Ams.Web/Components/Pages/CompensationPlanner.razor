    private async Task SaveAsync()
    {
        _saveAttempted = true;
        CalculateForm();
        if (!ValidateForm()) return;
        _busy = true;
        _formError = null;
        var savedId = _editingId;
        try
        {
            if (_editingId == Guid.Empty)
            {
                savedId = await Api.CreateCommissionPlannerScenarioAsync(ToCreateRequest());
                ShowToast("Planner scenario saved.", "success");
            }
            else
            {
                await Api.UpdateCommissionPlannerScenarioAsync(_editingId, ToUpdateRequest());
                ShowToast("Planner scenario updated.", "success");
            }
            _showForm = false;
            await LoadAsync();
            _selected = _items.FirstOrDefault(x => x.ScenarioId == savedId) ?? _selected;
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
            ShowToast(_formError, "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void CalculateForm()
    {
        if (_form.SplitTypeCode != "Custom") ApplySplitTypeDefaults();
        var newBiz = Math.Round(_form.NewBusinessPremium * _form.NewBusinessRatePct / 100m, 2);
        var renewal = Math.Round(_form.RenewalPremium * _form.RenewalRatePct / 100m, 2);
        var overrideAmount = _form.BranchOverride ? Math.Round((_form.NewBusinessPremium + _form.RenewalPremium) * _form.OverrideRatePct / 100m, 2) : 0m;
        var total = newBiz + renewal + overrideAmount;
        var clawbacks = Math.Round(total * ((_form.CancellationRatePct + _form.NsfRatePct) / 100m), 2);
        var net = total - clawbacks;
        _form.NewBusinessCommission = newBiz;
        _form.RenewalCommission = renewal;
        _form.OverrideCommission = overrideAmount;
        _form.TotalCommission = total;
        _form.ProjectedClawbacks = clawbacks;
        _form.NetPayout = net;
        if (_form.HouseAccount)
        {
            _form.PrimaryNetPayout = net;
            _form.SecondaryNetPayout = 0;
            _form.BranchNetPayout = 0;
            return;
        }
        var baseNet = net - overrideAmount;
        _form.PrimaryNetPayout = Math.Round(baseNet * _form.PrimarySplitPct / 100m, 2);
        _form.SecondaryNetPayout = Math.Round(baseNet * _form.SecondarySplitPct / 100m, 2);
        _form.BranchNetPayout = overrideAmount;
    }

    private void ApplySplitTypeDefaults()
    {
        (_form.PrimarySplitPct, _form.SecondarySplitPct, _form.BranchOverride, _form.HouseAccount) = _form.SplitTypeCode switch
        {
            "No Split" => (100m, 0m, false, false),
            "50/50" => (50m, 50m, false, false),
            "70/30" => (70m, 30m, false, false),
            "Branch Override" => (70m, 20m, true, false),
            "House Account" => (100m, 0m, false, true),
            "Custom" => (_form.PrimarySplitPct, 100m - _form.PrimarySplitPct, _form.BranchOverride, _form.HouseAccount),
            _ => (60m, 40m, false, false)
        };
    }

    private void UpdateSecondarySplit() { if (_form.SplitTypeCode == "Custom") _form.SecondarySplitPct = Math.Max(0, 100m - _form.PrimarySplitPct); }
    private async Task NotifyValidationAsync(EditContext _) { _saveAttempted = true; ShowToast("Please correct validation errors before saving.", "warning"); await Task.CompletedTask; }

    private void CloneSelected()
    {
        if (_selected is null) return;
        OpenEdit(_selected);
        _editingId = Guid.Empty;
        _form.ScenarioNumber = $"WP-{DateTime.UtcNow:yyyyMM}-{(_items.Count + 1):000}";
        _form.ScenarioName = $"Copy of {_selected.ScenarioName}";
        _form.StatusCode = "Draft";
        ShowToast("Scenario cloned. Review and save the copy.", "info");
    }

    private void ConfirmStatusUpdate(CommissionPlannerScenarioDto item, string status) { _statusTarget = item; _pendingStatus = status; _showStatusConfirm = true; }
    private void CancelStatusUpdate() { if (_busy) return; _showStatusConfirm = false; _statusTarget = null; _pendingStatus = null; }

    private async Task ExecuteStatusUpdateAsync()
    {
        if (_statusTarget is null || string.IsNullOrWhiteSpace(_pendingStatus)) return;
        _busy = true;
        var selectedId = _statusTarget.ScenarioId;
        try
        {
            var request = ToUpdateRequest(_statusTarget, _pendingStatus);
            await Api.UpdateCommissionPlannerScenarioAsync(_statusTarget.ScenarioId, request);
            ShowToast($"Scenario marked {_pendingStatus.ToLowerInvariant()}.", "success");
            _showStatusConfirm = false;
            _statusTarget = null;
            _pendingStatus = null;
            await LoadAsync();
            _selected = _items.FirstOrDefault(x => x.ScenarioId == selectedId) ?? _selected;
        }
        catch (Exception ex)
        {
            ShowToast($"Update failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ExportAsync()
    {
        if (!_filtered.Any()) { ShowToast("No planner scenarios are available to export.", "warning"); return; }
        var csv = new StringBuilder();
        csv.AppendLine("ScenarioId,ScenarioNumber,ScenarioName,ScenarioType,Status,Plan,Payee,NewBusinessPremium,RenewalPremium,PolicyCount,SplitType,PrimarySplit,SecondarySplit,TotalCommission,ProjectedClawbacks,NetPayout,Notes");
        foreach (var item in _filtered)
        {
            csv.AppendLine(string.Join(',', Csv(item.ScenarioId.ToString()), Csv(item.ScenarioNumber), Csv(item.ScenarioName), Csv(item.ScenarioTypeCode), Csv(item.StatusCode), Csv(item.PlanName), Csv(item.PayeeName), item.NewBusinessPremium, item.RenewalPremium, item.PolicyCount, Csv(item.SplitTypeCode), item.PrimarySplitPct, item.SecondarySplitPct, item.TotalCommission, item.ProjectedClawbacks, item.NetPayout, Csv(item.Notes)));
        }
        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        await Js.InvokeVoidAsync("amsShell.downloadBase64", $"commission-planner-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
        ShowToast($"Exported {_filtered.Count:N0} planner scenarios.", "success");
    }

