@page "/commissions/planner"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Commissions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject IJSRuntime Js

<PageTitle>What-If Compensation Planner â€” AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="wp-toast wp-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="wp-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showStatusConfirm && _statusTarget is not null && !string.IsNullOrWhiteSpace(_pendingStatus))
{
    <div class="wp-modal-backdrop" role="presentation" @onclick="CancelStatusUpdate">
        <div class="wp-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="wp-status-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon @(_pendingStatus == "Archived" ? "um-confirm-icon--danger" : null)"><i class="bi @PendingStatusIcon" aria-hidden="true"></i></div>
                <div class="um-confirm-title" id="wp-status-title">@PendingStatusTitle</div>
                <div class="um-confirm-body">Update planner scenario <strong>@_statusTarget.ScenarioNumber</strong> to <strong>@_pendingStatus</strong>?</div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CancelStatusUpdate" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn @(_pendingStatus == "Archived" ? "um-btn-danger" : "um-btn-primary")" @onclick="ExecuteStatusUpdateAsync" disabled="@_busy">@PendingStatusAction</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="wp-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="wp-modal wp-action-modal" role="dialog" aria-modal="true" aria-labelledby="wp-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-calculator" aria-hidden="true"></i>
                <span id="wp-form-title">@(_editingId == Guid.Empty ? "New What-If Scenario" : "Edit What-If Scenario")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="wp-modal-intro">
                        <span><i class="bi bi-shield-check" aria-hidden="true"></i> Compensation workflow</span>
                        <p>Model producer splits, branch overrides, house account treatment, and clawback exposure before committing rules or payout workflows.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field"><label>Scenario Number <span class="text-danger">*</span></label><InputText class="form-control" @bind-Value="_form.ScenarioNumber" /></div>
                        <div class="um-field"><label>Scenario Type <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="_form.ScenarioTypeCode">@foreach (var type in _scenarioTypes) { <option value="@type">@type</option> }</InputSelect></div>
                        <div class="um-field um-field--full"><label>Scenario Name <span class="text-danger">*</span></label><InputText class="form-control" @bind-Value="_form.ScenarioName" /></div>
                        <div class="um-field"><label>Plan</label><InputSelect class="form-select" @bind-Value="_form.CommissionPlanId"><option value="">Unassigned plan</option>@foreach (var plan in _plans) { <option value="@plan.CommissionPlanId">@plan.PlanName</option> }</InputSelect></div>
                        <div class="um-field"><label>Payee</label><InputSelect class="form-select" @bind-Value="_form.PayeeId"><option value="">All payees</option>@foreach (var payee in _payees) { <option value="@payee.PayeeId">@PayeeLabel(payee)</option> }</InputSelect></div>
                        <div class="um-field"><label>New Business Premium <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.NewBusinessPremium" /></div>
                        <div class="um-field"><label>Renewal Premium <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.RenewalPremium" /></div>
                        <div class="um-field"><label>Policy Count <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.PolicyCount" /></div>
                        <div class="um-field"><label>New Business Rate % <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.NewBusinessRatePct" /></div>
                        <div class="um-field"><label>Renewal Rate % <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.RenewalRatePct" /></div>
                        <div class="um-field"><label>Override / Bonus % <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.OverrideRatePct" /></div>
                        <div class="um-field"><label>Split Type <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="_form.SplitTypeCode" @bind-Value:after="ApplySplitTypeDefaults">@foreach (var split in _splitTypes) { <option value="@split">@split</option> }</InputSelect></div>
                        <div class="um-field"><label>Primary Split % <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.PrimarySplitPct" @bind-Value:after="UpdateSecondarySplit" /></div>
                        <div class="um-field"><label>Secondary Split % <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.SecondarySplitPct" /></div>
                        <div class="um-field"><label>Cancellation Rate % <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.CancellationRatePct" /></div>
                        <div class="um-field"><label>NSF / Chargeback Rate % <span class="text-danger">*</span></label><InputNumber class="form-control" @bind-Value="_form.NsfRatePct" /></div>
                        <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect class="form-select" @bind-Value="_form.StatusCode">@foreach (var status in _statuses) { <option value="@status">@status</option> }</InputSelect></div>
                        <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.BranchOverride" /> Branch override applies</label></div>
                        <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.HouseAccount" /> House account treatment</label></div>
                        <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_form.SharedClawbacks" /> Share clawbacks proportionally</label></div>
                        <div class="um-field um-field--full"><label>Notes</label><InputTextArea class="form-control" rows="3" @bind-Value="_form.Notes" /></div>
                        <div class="um-field um-field--full wp-scenario-preview"><span>Scenario preview</span><strong>@_form.NetPayout.ToString("C2")</strong><small>@_form.TotalCommission.ToString("C2") gross Â· @_form.ProjectedClawbacks.ToString("C2") projected clawbacks</small><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CalculateForm">Calculate</button></div>
                        @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn um-btn-ghost" @onclick="RunFormScenario" disabled="@_busy"><i class="bi bi-play-fill" aria-hidden="true"></i> Run</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">@if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> } @(_editingId == Guid.Empty ? "Save Scenario" : "Save Changes")</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="wp-enterprise-page">
    <section class="wp-header">
        <div class="wp-header-left">
            <div class="wp-lob-icon"><i class="bi bi-calculator" aria-hidden="true"></i></div>
            <div class="wp-header-info">
                <div class="wp-title-row"><h1 class="wp-page-title">What-If Compensation Planner</h1><span class="wp-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live planner data</span><span class="wp-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span></div>
                <div class="wp-sub-row"><span>Model split rules, producer payout, branch overrides, house accounts, and clawback exposure.</span><span class="wp-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Seed sync enabled</span><span class="wp-sub-chip"><i class="bi bi-check2-circle" aria-hidden="true"></i> @_filtered.Count active matches</span></div>
            </div>
        </div>
        <div class="wp-header-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions2")'><i class="bi bi-cash-coin" aria-hidden="true"></i> Commissions</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi @(_loading ? "bi-arrow-repeat wp-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync" disabled="@(!_filtered.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Scenario</button>
        </div>
    </section>

    <section class="wp-kpi-strip" aria-label="Planner metrics">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="@KpiClass(kpi)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)"><span class="wp-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span><span class="wp-kpi-copy"><span class="wp-kpi-label">@kpi.Label</span><span class="wp-kpi-value">@kpi.Value</span><span class="wp-kpi-caption">@kpi.Caption</span></span></button>
        }
    </section>

    <section class="wp-workflow-strip" aria-label="Planner workflow shortcuts">
        <button type="button" class="wp-workflow-card wp-wf-create" @onclick="OpenCreate"><span class="wp-workflow-icon"><i class="bi bi-plus-circle" aria-hidden="true"></i></span><span class="wp-workflow-content"><strong>1</strong><span>Model</span><small>Create scenario.</small></span></button>
        <button type="button" class="wp-workflow-card wp-wf-run" @onclick="RunSelectedScenario" disabled="@(_selected is null)"><span class="wp-workflow-icon"><i class="bi bi-play-fill" aria-hidden="true"></i></span><span class="wp-workflow-content"><strong>2</strong><span>Run</span><small>Calculate payout.</small></span></button>
        <button type="button" class="wp-workflow-card wp-wf-plans" @onclick='() => Nav.NavigateTo("/commissions/plans")'><span class="wp-workflow-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span><span class="wp-workflow-content"><strong>3</strong><span>Plans</span><small>Review rates.</small></span></button>
        <button type="button" class="wp-workflow-card wp-wf-splits" @onclick='() => Nav.NavigateTo("/commissions/splits")'><span class="wp-workflow-icon"><i class="bi bi-scissors" aria-hidden="true"></i></span><span class="wp-workflow-content"><strong>4</strong><span>Splits</span><small>Create rule.</small></span></button>
        <button type="button" class="wp-workflow-card wp-wf-forecast" @onclick='() => Nav.NavigateTo("/commissions/forecast2")'><span class="wp-workflow-icon"><i class="bi bi-graph-up" aria-hidden="true"></i></span><span class="wp-workflow-content"><strong>5</strong><span>Forecast</span><small>Compare forecast.</small></span></button>
        <button type="button" class="wp-workflow-card wp-wf-statements" @onclick='() => Nav.NavigateTo("/commissions/statements")'><span class="wp-workflow-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span><span class="wp-workflow-content"><strong>6</strong><span>Statements</span><small>Reconcile payout.</small></span></button>
    </section>

    <section class="wp-enterprise-search" aria-label="Planner filters">
        <div class="wp-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
        <div class="wp-search-body"><label for="wp-search">Search planner scenarios</label><input id="wp-search" class="wp-search-input" type="search" placeholder="Search scenario, split type, status, payee, plan, notes..." @bind="SearchFilter" @bind:event="oninput" /><span class="wp-search-hint">Filters apply instantly across synchronized what-if planner data.</span></div>
        <select class="wp-filter-select" @bind="TypeFilter" aria-label="Scenario type filter"><option value="">All scenario types</option>@foreach (var type in _scenarioTypes) { <option value="@type">@type</option> }</select>
        <select class="wp-filter-select" @bind="StatusFilter" aria-label="Status filter"><option value="">All statuses</option>@foreach (var status in _statuses) { <option value="@status">@status</option> }</select>
        <div class="wp-search-result"><strong>@_filtered.Count</strong><span>matches</span></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError)) { <div class="alert alert-danger wp-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div> }

    <section class="wp-content-layout">
        <div class="wp-grid-wrap">
            <div class="wp-grid-toolbar"><div><strong>Scenario register</strong><span>@ActiveFilterText</span></div><div class="wp-toolbar-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-eraser" aria-hidden="true"></i> Reset</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="RunSelectedScenario" disabled="@(_selected is null)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloneSelected" disabled="@(_selected is null)"><i class="bi bi-copy" aria-hidden="true"></i> Clone</button><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add</button></div></div>
            @if (_loading) { <div class="wp-loading"><i class="bi bi-arrow-repeat wp-spin" aria-hidden="true"></i><strong>Loading compensation planner...</strong><span>Syncing schema, seed scenarios, plans, payees, and forecast context.</span></div> }
            else if (!_filtered.Any()) { <div class="wp-empty-state"><i class="bi bi-calculator" aria-hidden="true"></i><strong>No planner scenarios found</strong><span>Adjust filters or create a new compensation what-if scenario.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">New Scenario</button></div> }
            else
            {
                <div class="wp-table-scroll">
                    <table class="wp-table">
                        <thead>
                            <tr>
                                <th>Scenario</th>
                                <th>Type</th>
                                <th>Split</th>
                                <th>Plan</th>
                                <th class="wp-number">Premium</th>
                                <th class="wp-number">Gross</th>
                                <th class="wp-number">Clawbacks</th>
                                <th class="wp-number">Net</th>
                                <th>Status</th>
                                <th class="wp-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PagedItems)
                            {
                                <tr class="@RowClass(item)" @onclick="() => SelectScenario(item)">
                                    <td><div class="wp-entry-cell"><span class="wp-entry-icon @ScenarioIconTone(item.ScenarioTypeCode)"><i class="bi bi-calculator" aria-hidden="true"></i></span><span><strong>@item.ScenarioName</strong><span>@item.ScenarioNumber Â· @item.PayeeName</span></span></div></td>
                                    <td><span class="wp-type-chip @TypeCss(item.ScenarioTypeCode)">@item.ScenarioTypeCode</span></td>
                                    <td>@SplitLabel(item)</td>
                                    <td>@item.PlanName</td>
                                    <td class="wp-number">@((item.NewBusinessPremium + item.RenewalPremium).ToString("C0"))</td>
                                    <td class="wp-number">@item.TotalCommission.ToString("C0")</td>
                                    <td class="wp-number wp-risk">@item.ProjectedClawbacks.ToString("C0")</td>
                                    <td class="wp-number wp-net">@item.NetPayout.ToString("C0")</td>
                                    <td><span class="wp-status-chip @StatusCss(item.StatusCode)">@item.StatusCode</span></td>
                                    <td>
                                        <div class="wp-row-acts">
                                            <button type="button" class="um-btn um-btn-primary um-btn-xs" title="Inspect" @onclick:stopPropagation="true" @onclick="() => SelectScenario(item)"><i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Edit" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Run" @onclick:stopPropagation="true" @onclick="() => RunScenario(item)"><i class="bi bi-play-fill" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Activate" @onclick:stopPropagation="true" @onclick='() => ConfirmStatusUpdate(item, "Active")' disabled="@(item.StatusCode == "Active")"><i class="bi bi-check2-circle" aria-hidden="true"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="wp-pager"><span>Showing @PageStart-@PageEnd of @_filtered.Count</span><div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PrevPage" disabled="@(_page == 1)">Previous</button><span>Page @_page of @TotalPages</span><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button></div></div>
            }
        </div>
        <aside class="wp-detail-panel" aria-label="Selected scenario detail">
            @if (_selected is null)
            {
                <div class="wp-detail-empty"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a scenario</strong><span>Choose a row to inspect assumptions, payout breakdown, comparison, clawback risk, and workflow actions.</span></div>
            }
            else
            {
                <div class="wp-detail-head"><div><span class="wp-detail-eyebrow"><i class="bi bi-calculator" aria-hidden="true"></i> Scenario detail</span><h2>@_selected.ScenarioName</h2><div class="wp-detail-meta"><span>@_selected.ScenarioNumber</span><span class="wp-type-chip @TypeCss(_selected.ScenarioTypeCode)">@_selected.ScenarioTypeCode</span><span class="wp-status-chip @StatusCss(_selected.StatusCode)">@_selected.StatusCode</span></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button></div>
                <div class="wp-detail-body">
                    <div class="wp-result-kpis"><div class="wp-rk-card wp-rk-green"><i class="bi bi-currency-dollar wp-rk-icon" aria-hidden="true"></i><div><div class="wp-rk-val">@_selected.NetPayout.ToString("C0")</div><div class="wp-rk-lbl">Net Payout</div></div></div><div class="wp-rk-card wp-rk-blue"><i class="bi bi-arrow-up-circle wp-rk-icon" aria-hidden="true"></i><div><div class="wp-rk-val">@_selected.NewBusinessCommission.ToString("C0")</div><div class="wp-rk-lbl">New Biz</div></div></div><div class="wp-rk-card wp-rk-amber"><i class="bi bi-building wp-rk-icon" aria-hidden="true"></i><div><div class="wp-rk-val">@_selected.OverrideCommission.ToString("C0")</div><div class="wp-rk-lbl">Override</div></div></div><div class="wp-rk-card wp-rk-red"><i class="bi bi-arrow-counterclockwise wp-rk-icon" aria-hidden="true"></i><div><div class="wp-rk-val">@_selected.ProjectedClawbacks.ToString("C0")</div><div class="wp-rk-lbl">Clawbacks</div></div></div></div>
                    <div class="wp-breakdown-hdr">Payout breakdown</div>
                    <div class="wp-breakdown-table">
                        <div class="wp-bt-row wp-bt-hdr"><span>Party</span><span>Role</span><span>Split</span><span>Gross</span><span>Clawback</span><span>Net</span></div>
                        @foreach (var row in DetailRows)
                        {
                            <div class="wp-bt-row"><span class="wp-bt-name">@row.Name</span><span><span class="wp-role-chip @RoleCss(row.Role)">@row.Role</span></span><span class="wp-bt-pct">@row.SplitPct.ToString("N0")%</span><span class="wp-bt-amount">@row.GrossShare.ToString("C2")</span><span class="wp-bt-cw">@(row.ClawbackShare > 0 ? row.ClawbackShare.ToString("C2") : "â€”")</span><span class="wp-bt-net">@row.NetShare.ToString("C2")</span></div>
                        }
                    </div>
                    <div class="wp-breakdown-hdr">Split comparison</div>
                    <div class="wp-compare-grid">
                        @foreach (var c in Comparisons)
                        {
                            <div class="wp-compare-card @(_selected.SplitTypeCode == c.Label ? "wp-compare-active" : null)">
                                <div class="wp-cc-title">@c.Label</div>
                                <div class="wp-cc-gross">@c.PrimaryNet.ToString("C0")<span class="wp-cc-sub"> primary</span></div>
                                @if (c.SecondaryNet > 0)
                                {
                                    <div class="wp-cc-sec">@c.SecondaryNet.ToString("C0")<span class="wp-cc-sub"> secondary</span></div>
                                }
                                <div class="wp-cc-net">Net total: <strong>@c.TotalNet.ToString("C0")</strong></div>
                                @if (_selected.SplitTypeCode == c.Label)
                                {
                                    <span class="wp-cc-badge">Current scenario</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="wp-note-card"><span><i class="bi bi-card-text" aria-hidden="true"></i> Workflow context</span><p>@(string.IsNullOrWhiteSpace(_selected.Notes) ? "No planner notes have been captured." : _selected.Notes)</p></div>
                    <div class="wp-detail-actions"><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="RunSelectedScenario"><i class="bi bi-play-fill" aria-hidden="true"></i> Run</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloneSelected"><i class="bi bi-copy" aria-hidden="true"></i> Clone</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, "Active")' disabled="@(_selected.StatusCode == "Active")"><i class="bi bi-check2-circle" aria-hidden="true"></i> Activate</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, "Archived")' disabled="@(_selected.StatusCode == "Archived")"><i class="bi bi-archive" aria-hidden="true"></i> Archive</button></div>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    private const int PageSize = 12;
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<CommissionPlannerScenarioDto> _items = [];
    private List<CommissionPlannerScenarioDto> _filtered = [];
    private List<CommissionPlanDto> _plans = [];
    private List<CommissionPayeeDto> _payees = [];
    private List<CommissionForecastDto> _forecasts = [];
    private CommissionPlannerScenarioDto? _selected;
    private CommissionPlannerScenarioDto? _statusTarget;
    private PlannerForm _form = new();
    private Guid _editingId = Guid.Empty;
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private string _typeFilter = string.Empty;
    private string _kpiFilter = "all";
    private string? _pendingStatus;
    private int _page = 1;
    private bool _loading, _busy, _showForm, _showStatusConfirm, _toastVisible, _saveAttempted;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError, _formError;
    private readonly List<string> _scenarioTypes = ["What-If", "Branch Override", "House Account", "Risk Model", "Upside", "Renewal"];
