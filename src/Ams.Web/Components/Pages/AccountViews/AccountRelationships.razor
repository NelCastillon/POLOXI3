@page "/accounts/{AccountId:guid}/relationships"
@namespace Ams.Web.Components.Pages.AccountViews
@using Syncfusion.Blazor.Diagram
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Relationships — @(_accountName ?? "Account")</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Account Relationships"
               Subtitle="@($"Hierarchy and relationship map for {_accountName ?? "this account"}")"
               Icon="bi-diagram-3-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo($"/accounts/{AccountId}")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Account 360
        </button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "ar-spin" : "")" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-primary" @onclick="() => _showAddRel = true">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Link Account
        </button>
    </Actions>
</AppPageHeader>

@if (_loading)
{
    <div class="ar-loading">
        <span class="um-spin" aria-hidden="true"></span>
        <span>Loading relationships…</span>
    </div>
}
else
{
    <!-- ── Toolbar: view toggle + filter ─────────────────────────────── -->
    <div class="ar-toolbar">
        <div class="ar-view-toggle" role="group" aria-label="View mode">
            <button class="ar-view-btn @(_view == "diagram" ? "ar-view-btn--active" : "")"
                    @onclick='() => _view = "diagram"'
                    title="Hierarchy Diagram"
                    aria-pressed="@(_view == "diagram")">
                <i class="bi bi-diagram-3" aria-hidden="true"></i>
                <span>Diagram</span>
            </button>
            <button class="ar-view-btn @(_view == "grid" ? "ar-view-btn--active" : "")"
                    @onclick='() => _view = "grid"'
                    title="List View"
                    aria-pressed="@(_view == "grid")">
                <i class="bi bi-table" aria-hidden="true"></i>
                <span>List</span>
            </button>
        </div>
        <div class="ar-filter-wrap">
            <SfDropDownList TValue="string" TItem="LV"
                            DataSource="_relTypeOpts"
                            Placeholder="All Types"
                            ShowClearButton="true"
                            Width="160px"
                            Value="_filterType"
                            ValueChanged="@((string v) => { _filterType = v; ApplyFilter(); })">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>
            <span class="ar-count">@_filtered.Count relationship(s)</span>
        </div>
    </div>

    <!-- ── Legend ────────────────────────────────────────────────────── -->
    <div class="ar-legend">
        <span class="ar-leg-item ar-leg--root"><i class="bi bi-circle-fill" aria-hidden="true"></i> This Account</span>
        <span class="ar-leg-item ar-leg--sub"><i class="bi bi-circle-fill" aria-hidden="true"></i> Subsidiary</span>
        <span class="ar-leg-item ar-leg--parent"><i class="bi bi-circle-fill" aria-hidden="true"></i> Parent</span>
        <span class="ar-leg-item ar-leg--partner"><i class="bi bi-circle-fill" aria-hidden="true"></i> Partner</span>
        <span class="ar-leg-item ar-leg--referral"><i class="bi bi-circle-fill" aria-hidden="true"></i> Referred By</span>
    </div>

    @if (_view == "diagram")
    {
        <!-- ── Hierarchy diagram ──────────────────────────────────────── -->
        <div class="ar-diagram-wrap">
            @if (_relationships.Count == 0)
            {
                <div class="ar-empty">
                    <i class="bi bi-diagram-3 ar-empty-icon" aria-hidden="true"></i>
                    <div class="ar-empty-title">No relationships</div>
                    <div class="ar-empty-sub">Link this account to parent companies, subsidiaries, or partners.</div>
                    <button class="um-btn um-btn-primary ar-empty-cta" @onclick="() => _showAddRel = true">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> Link Account
                    </button>
                </div>
            }
            else
            {
                <SfDiagramComponent @ref="_diagram"
                                    Width="100%"
                                    Height="520px"
                                    Nodes="_diagramNodes"
                                    Connectors="_diagramConnectors"
                                    Created="OnDiagramCreated">
                    <SnapSettings Constraints="SnapConstraints.None" />
                    <Layout Type="LayoutType.HierarchicalTree"
                            HorizontalSpacing="70"
                            VerticalSpacing="70"
                            Orientation="LayoutOrientation.TopToBottom" />
                </SfDiagramComponent>
            }
        </div>
    }
    else
    {
        <!-- ── List / grid view ───────────────────────────────────────── -->
        @if (_filtered.Count == 0)
        {
            <div class="ar-empty">
                <i class="bi bi-diagram-3 ar-empty-icon" aria-hidden="true"></i>
                <div class="ar-empty-title">No relationships</div>
                <div class="ar-empty-sub">Link this account to parent companies, subsidiaries, or partners.</div>
                <button class="um-btn um-btn-primary ar-empty-cta" @onclick="() => _showAddRel = true">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Link Account
                </button>
            </div>
        }
        else
        {
            <div class="app-datagrid">
                <SfGrid TValue="RelationshipRow"
                        DataSource="_filtered"
                        AllowSorting="true"
                        AllowFiltering="true"
                        EnableHover="true"
                        RowHeight="60">
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                    <GridColumns>
                        <GridColumn HeaderText="Account" MinWidth="200">
                            <Template>
                                @{
                                    var r = (RelationshipRow)context;
                                    <div class="ar-grid-name-cell">
                                        <div class="ar-avatar @AvatarColor(r.RelatedAccount)">@Initials(r.RelatedAccount)</div>
                                        <div>
                                            <div class="ar-grid-name">@r.RelatedAccount</div>
                                            @if (!string.IsNullOrEmpty(r.Industry))
                                            {
                                                <div class="ar-grid-sub">@r.Industry</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(RelationshipRow.RelationType)" HeaderText="Relationship" Width="160">
                            <Template>
                                @{
                                    var r = (RelationshipRow)context;
                                    <span class="@RelTypeBadge(r.RelationType)">@r.RelationType</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(RelationshipRow.AccountType)"    HeaderText="Type"        Width="140" />
                        <GridColumn Field="@nameof(RelationshipRow.Status)"         HeaderText="Status"      Width="110">
                            <Template>
                                @{
                                    var r = (RelationshipRow)context;
                                    <span class="@StatusBadge(r.Status)">@r.Status</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(RelationshipRow.TotalPremium)"   HeaderText="Premium"     Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                            <Template>
                                @{
                                    var r = (RelationshipRow)context;
                                    <span class="ar-mono ar-bold">@r.TotalPremium.ToString("C0")</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(RelationshipRow.LinkedAt)"       HeaderText="Linked"      Width="120">
                            <Template>
                                @{
                                    var r = (RelationshipRow)context;
                                    <span class="ar-mono">@r.LinkedAt.ToString("d")</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn HeaderText="" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                            <Template>
                                @{
                                    var r = (RelationshipRow)context;
                                    <div class="ar-row-actions">
                                        <button class="um-btn um-btn-ghost um-btn-sm"
                                                @onclick='() => Nav.NavigateTo($"/accounts/{r.RelatedAccountId}")'
                                                title="View Account 360">
                                            <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                        </button>
                                        <button class="um-btn um-btn-ghost um-btn-sm ar-btn--danger"
                                                @onclick="() => ConfirmUnlink(r)"
                                                title="Unlink">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        }
    }
}

<!-- ══ DIALOGS ══════════════════════════════════════════════════════════════ -->

<!-- Link Account -->
<SfDialog @bind-Visible="_showAddRel" Width="480px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <span class="ar-dlg-hdr">
                <i class="bi bi-diagram-3" aria-hidden="true"></i> Link Account
            </span>
        </Header>
        <Content>
            <div class="ar-dlg-body">
                <div class="ar-dlg-field">
                    <label class="ar-dlg-lbl">Related Account Name *</label>
                    <SfTextBox Placeholder="e.g. Sullivan Holdings Inc." @bind-Value="_newRel.RelatedAccount" />
                </div>
                <div class="ar-dlg-field">
                    <label class="ar-dlg-lbl">Relationship Type *</label>
                    <SfDropDownList TValue="string" TItem="LV"
                                    DataSource="_relTypeOpts"
                                    Placeholder="Select type…"
                                    Width="100%"
                                    @bind-Value="_newRel.RelationType">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
                <div class="ar-dlg-field">
                    <label class="ar-dlg-lbl">Industry (optional)</label>
                    <SfTextBox Placeholder="e.g. Manufacturing" @bind-Value="_newRel.Industry" />
                </div>
                <div class="ar-dlg-field">
                    <label class="ar-dlg-lbl">Notes (optional)</label>
                    <SfTextBox Placeholder="Additional context…"
                               @bind-Value="_newRel.Notes"
                               Multiline="true"
                               HtmlAttributes="@(new Dictionary<string,object>{{"rows","3"}})" />
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="ar-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showAddRel = false">Cancel</button>
                <button class="um-btn um-btn-primary"
                        @onclick="CommitAddRelAsync"
                        disabled="@(string.IsNullOrEmpty(_newRel.RelatedAccount) || string.IsNullOrEmpty(_newRel.RelationType))">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Link
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Confirm Unlink -->
<SfDialog @bind-Visible="_showUnlink" Width="420px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <span class="ar-dlg-hdr ar-dlg-hdr--danger">
                <i class="bi bi-x-circle" aria-hidden="true"></i> Unlink Account
            </span>
        </Header>
        <Content>
            <div class="ar-dlg-body">
                <p>Remove the <strong>@_unlinkTarget?.RelationType</strong> relationship with <strong>@_unlinkTarget?.RelatedAccount</strong>?</p>
                <p class="ar-dlg-warn">This only removes the relationship link — both accounts remain unchanged.</p>
            </div>
        </Content>
        <FooterTemplate>
            <div class="ar-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showUnlink = false">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="CommitUnlinkAsync">
                    <i class="bi bi-x-lg" aria-hidden="true"></i> Unlink
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public Guid AccountId { get; set; }

    private SfToast?               _toast;
    private SfDiagramComponent?    _diagram;
    private bool                   _loading      = true;
    private string                 _view         = "diagram";
    private string?                _accountName;
    private string                 _filterType   = string.Empty;

    private List<RelationshipRow>  _relationships = [];
    private List<RelationshipRow>  _filtered      = [];

    private Syncfusion.Blazor.Diagram.DiagramObjectCollection<Syncfusion.Blazor.Diagram.Node>
        _diagramNodes = new();
    private Syncfusion.Blazor.Diagram.DiagramObjectCollection<Syncfusion.Blazor.Diagram.Connector>
        _diagramConnectors = new();

    // Dialog state
    private bool              _showAddRel  = false;
    private bool              _showUnlink  = false;
    private RelationshipRow   _newRel      = new();
    private RelationshipRow?  _unlinkTarget;

    private static readonly List<LV> _relTypeOpts =
    [
        new("Parent",      "Parent"),
        new("Subsidiary",  "Subsidiary"),
        new("Partner",     "Partner"),
        new("Referred By", "Referred By"),
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            await Task.Delay(0); // TODO: Api.GetAccountRelationshipsAsync(AccountId)
            _accountName  = "Sullivan Manufacturing LLC";
            _relationships =
            [
                new RelationshipRow
                {
                    RelatedAccountId = Guid.NewGuid(),
                    RelatedAccount   = "Sullivan Holdings Inc.",
                    RelationType     = "Parent",
                    AccountType      = "Commercial",
                    Industry         = "Holding Company",
                    Status           = "Active",
                    TotalPremium     = 142_000m,
                    LinkedAt         = DateTime.UtcNow.AddYears(-3),
                },
                new RelationshipRow
                {
                    RelatedAccountId = Guid.NewGuid(),
                    RelatedAccount   = "Sullivan Realty LLC",
                    RelationType     = "Subsidiary",
                    AccountType      = "Commercial",
                    Industry         = "Real Estate",
                    Status           = "Active",
                    TotalPremium     = 28_400m,
                    LinkedAt         = DateTime.UtcNow.AddYears(-2),
                },
                new RelationshipRow
                {
                    RelatedAccountId = Guid.NewGuid(),
                    RelatedAccount   = "Sullivan Logistics Co.",
                    RelationType     = "Subsidiary",
                    AccountType      = "Commercial",
                    Industry         = "Transportation",
                    Status           = "Active",
                    TotalPremium     = 19_800m,
                    LinkedAt         = DateTime.UtcNow.AddYears(-1),
                },
                new RelationshipRow
                {
                    RelatedAccountId = Guid.NewGuid(),
                    RelatedAccount   = "Meridian Partners LLC",
                    RelationType     = "Partner",
                    AccountType      = "Commercial",
                    Industry         = "Consulting",
                    Status           = "Active",
                    TotalPremium     = 0m,
                    LinkedAt         = DateTime.UtcNow.AddMonths(-6),
                },
            ];
            ApplyFilter();
            BuildDiagram();
            Breadcrumbs.SetCrumbs(
                new("Home", "/"),
                new("Accounts", "/accounts"),
                new(_accountName, $"/accounts/{AccountId}"),
                new("Relationships", $"/accounts/{AccountId}/relationships"));
        }
        finally { _loading = false; }
    }

    private void ApplyFilter()
    {
        _filtered = string.IsNullOrEmpty(_filterType)
            ? [.. _relationships]
            : _relationships.Where(r => r.RelationType == _filterType).ToList();
    }

    private void BuildDiagram()
    {
        var nodes      = new Syncfusion.Blazor.Diagram.DiagramObjectCollection<Syncfusion.Blazor.Diagram.Node>();
        var connectors = new Syncfusion.Blazor.Diagram.DiagramObjectCollection<Syncfusion.Blazor.Diagram.Connector>();

        // Root node — this account
        nodes.Add(new Syncfusion.Blazor.Diagram.Node
        {
            ID       = "root",
            OffsetX  = 400, OffsetY = 80,
            Width    = 180, Height  = 52,
            Style    = new Syncfusion.Blazor.Diagram.ShapeStyle { Fill = "#1d4ed8", StrokeColor = "#1d4ed8" },
            Annotations = new Syncfusion.Blazor.Diagram.DiagramObjectCollection<Syncfusion.Blazor.Diagram.ShapeAnnotation>
            {
                new Syncfusion.Blazor.Diagram.ShapeAnnotation
                {
                    Content = _accountName ?? "This Account",
                    Style   = new Syncfusion.Blazor.Diagram.TextStyle { Color = "#fff", FontSize = 12, Bold = true },
                }
            },
        });

        var nodeColors = new Dictionary<string, string[]>
        {
            ["Parent"]      = ["#fef3c7", "#d97706", "#92400e"],
            ["Subsidiary"]  = ["#ede9fe", "#6d28d9", "#4c1d95"],
            ["Partner"]     = ["#d1fae5", "#047857", "#064e3b"],
            ["Referred By"] = ["#fce7f3", "#9d174d", "#831843"],
        };

        int i = 0;
        foreach (var rel in _relationships)
        {
            var id    = $"rel_{i}";
            var color = nodeColors.GetValueOrDefault(rel.RelationType) ?? ["#f1f5f9", "#64748b", "#334155"];
            var xPos  = 150 + (i * 200);

            nodes.Add(new Syncfusion.Blazor.Diagram.Node
            {
                ID      = id,
                OffsetX = xPos, OffsetY = 240,
                Width   = 160,  Height  = 48,
                Style   = new Syncfusion.Blazor.Diagram.ShapeStyle { Fill = color[0], StrokeColor = color[1] },
                Annotations = new Syncfusion.Blazor.Diagram.DiagramObjectCollection<Syncfusion.Blazor.Diagram.ShapeAnnotation>
                {
                    new Syncfusion.Blazor.Diagram.ShapeAnnotation
                    {
                        Content = rel.RelatedAccount,
                        Style   = new Syncfusion.Blazor.Diagram.TextStyle { Color = color[2], FontSize = 11 },
                    }
                },
            });

            connectors.Add(new Syncfusion.Blazor.Diagram.Connector
            {
                ID       = $"conn_{i}",
                SourceID = rel.RelationType == "Parent" ? id : "root",
                TargetID = rel.RelationType == "Parent" ? "root" : id,
                Type     = Syncfusion.Blazor.Diagram.ConnectorSegmentType.Orthogonal,
                Style    = new Syncfusion.Blazor.Diagram.ShapeStyle { StrokeColor = "#94a3b8" },
                TargetDecorator = new Syncfusion.Blazor.Diagram.DecoratorSettings
                {
                    Shape = Syncfusion.Blazor.Diagram.DecoratorShape.Arrow,
                    Style = new Syncfusion.Blazor.Diagram.ShapeStyle { Fill = "#94a3b8", StrokeColor = "#94a3b8" },
                },
                Annotations = new Syncfusion.Blazor.Diagram.DiagramObjectCollection<Syncfusion.Blazor.Diagram.PathAnnotation>
                {
                    new Syncfusion.Blazor.Diagram.PathAnnotation
                    {
                        Content = rel.RelationType,
                        Style   = new Syncfusion.Blazor.Diagram.TextStyle { FontSize = 10, Color = "#64748b", Italic = true },
                    }
                },
            });

            i++;
        }

        _diagramNodes      = nodes;
        _diagramConnectors = connectors;
    }

    private void OnDiagramCreated() { }

    // ── Handlers ──────────────────────────────────────────────────────────────
    private async Task CommitAddRelAsync()
    {
        _relationships.Add(new RelationshipRow
        {
            RelatedAccountId = Guid.NewGuid(),
            RelatedAccount   = _newRel.RelatedAccount,
            RelationType     = _newRel.RelationType,
            Industry         = _newRel.Industry,
            Notes            = _newRel.Notes,
            AccountType      = "Commercial",
            Status           = "Active",
            TotalPremium     = 0m,
            LinkedAt         = DateTime.UtcNow,
        });
        ApplyFilter();
        BuildDiagram();
        _newRel = new(); _showAddRel = false;
        await ShowToastAsync("Relationship linked.");
    }

    private void ConfirmUnlink(RelationshipRow row)
    {
        _unlinkTarget = row;
        _showUnlink   = true;
    }

    private async Task CommitUnlinkAsync()
    {
        if (_unlinkTarget is not null)
        {
            _relationships.RemoveAll(r => r.RelatedAccountId == _unlinkTarget.RelatedAccountId);
            ApplyFilter();
            BuildDiagram();
        }
        _unlinkTarget = null; _showUnlink = false;
        await ShowToastAsync("Relationship removed.");
    }

    private async Task ShowToastAsync(string msg, string css = "e-toast-success")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = css });
    }

    // ── Style helpers ─────────────────────────────────────────────────────────
    private static string RelTypeBadge(string t) => t switch
    {
        "Parent"      => "ar-type ar-type--parent",
        "Subsidiary"  => "ar-type ar-type--sub",
        "Partner"     => "ar-type ar-type--partner",
        "Referred By" => "ar-type ar-type--referral",
        _             => "ar-type",
    };
    private static string StatusBadge(string s) => s switch
    {
        "Active"   => "acl-status acl-status--active",
        "Inactive" => "acl-status acl-status--inactive",
        _          => "acl-status acl-status--suspended",
    };
    private static string AvatarColor(string name)
    {
        var c = new[] { "ar-av1", "ar-av2", "ar-av3", "ar-av4", "ar-av5", "ar-av6" };
        return c[Math.Abs(name.GetHashCode()) % c.Length];
    }
    private static string Initials(string name)
    {
        var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}" : name.Length > 0 ? name[..1] : "?";
    }

    // ── Models ────────────────────────────────────────────────────────────────
    private sealed class RelationshipRow
    {
        public Guid     RelatedAccountId { get; set; } = Guid.NewGuid();
        public string   RelatedAccount   { get; set; } = string.Empty;
        public string   RelationType     { get; set; } = string.Empty;
        public string   AccountType      { get; set; } = string.Empty;
        public string?  Industry         { get; set; }
        public string   Status           { get; set; } = "Active";
        public decimal  TotalPremium     { get; set; }
        public DateTime LinkedAt         { get; set; } = DateTime.UtcNow;
        public string?  Notes            { get; set; }
    }
    private sealed record LV(string Value, string Label);
}
