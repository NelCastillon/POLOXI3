@page "/accounts/{AccountId:guid}/relationships2"
@namespace Ams.Web.Components.Pages.AccountViews
@using Syncfusion.Blazor.Diagram
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject NavigationContextService NavContext

<PageTitle>Hierarchy — @(_rootName ?? "Account")</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Account Hierarchy &amp; Relationships"
               Subtitle="@($"Commercial, household, and affiliate linkages for {_rootName ?? "this account"}")"
               Icon="bi-diagram-3-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo($"/accounts/{AccountId}")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Account 360
        </button>
        <button class="um-btn um-btn-ghost" @onclick="() => _showAddRel = true">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Link Account
        </button>
        <div class="rm-view-toggle">
            <button class="rm-view-btn @(_view=="diagram"?"rm-view-btn--active":"")" @onclick='()=>_view="diagram"'><i class="bi bi-diagram-3" aria-hidden="true"></i> Diagram</button>
            <button class="rm-view-btn @(_view=="tree"   ?"rm-view-btn--active":"")" @onclick='()=>_view="tree"'>  <i class="bi bi-list-tree" aria-hidden="true"></i> Tree</button>
            <button class="rm-view-btn @(_view=="table"  ?"rm-view-btn--active":"")" @onclick='()=>_view="table"'> <i class="bi bi-table" aria-hidden="true"></i> Table</button>
        </div>
    </Actions>
</AppPageHeader>

<!-- Hierarchy type tabs -->
<div class="rm-type-tabs">
    <button class="rm-type-tab @(_hierType=="commercial"?"rm-type-tab--active":"")" @onclick='()=>{_hierType="commercial";RebuildDiagram();}'>
        <i class="bi bi-building" aria-hidden="true"></i> Commercial Hierarchy
    </button>
    <button class="rm-type-tab @(_hierType=="household"?"rm-type-tab--active":"")" @onclick='()=>{_hierType="household";RebuildDiagram();}'>
        <i class="bi bi-house" aria-hidden="true"></i> Household / Personal
    </button>
    <button class="rm-type-tab @(_hierType=="all"?"rm-type-tab--active":"")" @onclick='()=>{_hierType="all";RebuildDiagram();}'>
        <i class="bi bi-globe" aria-hidden="true"></i> All Relationships
    </button>
</div>

@if (_loading)
{
    <div class="rm-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading hierarchy…</span></div>
}
else
{
    <!-- KPI summary -->
    <div class="rm-summary-strip">
        <div class="rm-sum-card">
            <div class="rm-sum-val">@_nodes.Count</div>
            <div class="rm-sum-lbl">Accounts in Network</div>
        </div>
        <div class="rm-sum-card">
            <div class="rm-sum-val">@_nodes.Count(n => n.AccountType == "Commercial")</div>
            <div class="rm-sum-lbl">Commercial Entities</div>
        </div>
        <div class="rm-sum-card">
            <div class="rm-sum-val">@_nodes.Count(n => n.AccountType == "Personal")</div>
            <div class="rm-sum-lbl">Households</div>
        </div>
        <div class="rm-sum-card">
            <div class="rm-sum-val">@_edges.Count</div>
            <div class="rm-sum-lbl">Relationships</div>
        </div>
        <div class="rm-sum-card">
            <div class="rm-sum-val">@_nodes.Sum(n => n.TotalPremium).ToString("C0")</div>
            <div class="rm-sum-lbl">Combined Premium</div>
        </div>
    </div>

    @if (_view == "diagram")
    {
        <div class="rm-diagram-wrap">
            <SfDiagramComponent @ref="_diagram"
                                Width="100%" Height="580px"
                                Nodes="_diagramNodes"
                                Connectors="_diagramConnectors"
                                Created="OnDiagramCreated">
                <SnapSettings Constraints="SnapConstraints.None" />
                <Layout Type="LayoutType.HierarchicalTree"
                        HorizontalSpacing="70" VerticalSpacing="64"
                        Orientation="LayoutOrientation.TopToBottom" />
                <DiagramZoomSettings ScrollLimit="ScrollLimitMode.Infinity" />
            </SfDiagramComponent>
            <div class="rm-legend">
                <div class="rm-legend-item"><span class="rm-leg-dot rm-ld-root"></span>Current Account</div>
                <div class="rm-legend-item"><span class="rm-leg-dot rm-ld-parent"></span>Parent / Ultimate Parent</div>
                <div class="rm-legend-item"><span class="rm-leg-dot rm-ld-sub"></span>Subsidiary / Affiliate</div>
                <div class="rm-legend-item"><span class="rm-leg-dot rm-ld-hh"></span>Household Member</div>
                <div class="rm-legend-item"><span class="rm-leg-dot rm-ld-ref"></span>Referred / Partner</div>
            </div>
        </div>
    }
    else if (_view == "tree")
    {
        <div class="rm-tree-wrap">
            @foreach (var row in _flatTree)
            {
                <div class="rm-tree-row @(row.IsRoot ? "rm-tree-row--root" : "")" style="margin-left:@(row.Depth * 2.5)rem">
                    <div class="rm-tree-av @NodeColorCss(row.AccountType)">@Initials(row.Name)</div>
                    <div class="rm-tree-info">
                        <button class="rm-nav-btn rm-tree-name" @onclick='() => Nav.NavigateTo($"/accounts/{row.AccountId}/relationships")'>@row.Name</button>
                        <span class="rm-tree-meta">@row.AccountType · @row.RelationType</span>
                    </div>
                    <span class="rm-tree-prem">@row.TotalPremium.ToString("C0")</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="rm-table-wrap">
            <SfGrid TValue="RmEdge" DataSource="_edges"
                    AllowSorting="true" AllowFiltering="true"
                    EnableHover="true" RowHeight="54">
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
                <GridColumns>
                    <GridColumn HeaderText="Related Account" MinWidth="220" Field="@nameof(RmEdge.TargetName)">
                        <Template>
                            @{ var e = (RmEdge)context; }
                            <div class="rm-name-cell">
                                <div class="rm-cell-av @NodeColorCss(e.TargetType)">@Initials(e.TargetName)</div>
                                <div>
                                    <button class="rm-nav-btn" @onclick='() => Nav.NavigateTo($"/accounts/{e.TargetId}/relationships")'>@e.TargetName</button>
                                    <div class="rm-cell-type">@e.TargetType</div>
                                </div>
                            </div>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(RmEdge.RelationType)" HeaderText="Relationship" Width="170">
                        <Template>@{ var e = (RmEdge)context; }<span class="@RelBadgeCss(e.RelationType)">@e.RelationType</span></Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(RmEdge.Direction)" HeaderText="Direction" Width="120">
                        <Template>@{ var e = (RmEdge)context; }<span class="rm-dir-chip">@e.Direction</span></Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(RmEdge.TotalPremium)" HeaderText="Premium" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                        <Template>@{ var e = (RmEdge)context; }<span class="rm-mono">@e.TotalPremium.ToString("C0")</span></Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(RmEdge.ActivePolicies)" HeaderText="Policies" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                    <GridColumn Field="@nameof(RmEdge.SharedSince)" HeaderText="Linked Since" Width="130">
                        <Template>@{ var e = (RmEdge)context; }<span class="rm-mono">@e.SharedSince.ToString("MMM yyyy")</span></Template>
                    </GridColumn>
                    <GridColumn HeaderText="" Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                        <Template>
                            @{ var e = (RmEdge)context; }
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ConfirmRemove(e)" title="Remove link"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    }
}

<!-- Add Relationship Dialog -->
<SfDialog @bind-Visible="_showAddRel" Width="540px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="rm-dlg-hdr"><i class="bi bi-diagram-3" aria-hidden="true"></i> Link Account</span></Header>
        <Content>
            <div class="rm-dlg-body">
                <div class="rm-dlg-section">Relationship Type</div>
                <div class="rm-dlg-grid">
                    <SfDropDownList TValue="string" TItem="RmLv" DataSource="_relTypeOpts" Placeholder="Relationship type *" Width="100%" @bind-Value="_newEdge.RelationType">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                    <SfDropDownList TValue="string" TItem="RmLv" DataSource="_dirOpts" Placeholder="Direction" Width="100%" @bind-Value="_newEdge.Direction">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
                <div class="rm-dlg-section" style="margin-top:.9rem">Account to Link</div>
                <div class="rm-dlg-grid">
                    <SfTextBox Placeholder="Account name *" @bind-Value="_newEdge.TargetName" />
                    <SfDropDownList TValue="string" TItem="RmLv" DataSource="_acctTypeOpts" Placeholder="Account type" Width="100%" @bind-Value="_newEdge.TargetType">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
                <div class="rm-dlg-section" style="margin-top:.9rem">Details</div>
                <div class="rm-dlg-grid">
                    <SfDatePicker TValue="DateTime" Placeholder="Linked since" @bind-Value="_newEdge.SharedSince" />
                    <SfTextBox Placeholder="Notes" @bind-Value="_newEdge.Notes" />
                    <div class="rm-dlg-check"><label class="rm-toggle"><input type="checkbox" @bind="_newEdge.SharedCoverage" /> Shared coverage</label></div>
                    <div class="rm-dlg-check"><label class="rm-toggle"><input type="checkbox" @bind="_newEdge.SharedBilling"  /> Shared billing</label></div>
                </div>
                @if (!string.IsNullOrEmpty(_addRelError))
                {
                    <div class="rm-form-error"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_addRelError</div>
                }
            </div>
        </Content>
        <FooterTemplate>
            <div class="rm-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => { _showAddRel = false; _newEdge = new(); _addRelError = null; }">Cancel</button>
                <button class="um-btn um-btn-primary"
                        disabled="@(string.IsNullOrEmpty(_newEdge.RelationType) || string.IsNullOrEmpty(_newEdge.TargetName))"
                        @onclick="CommitAddRelAsync">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Link Account
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Remove confirm dialog -->
<SfDialog @bind-Visible="_showConfirmRemove" Width="400px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="rm-dlg-hdr"><i class="bi bi-trash" aria-hidden="true"></i> Remove Link</span></Header>
        <Content>
            <p style="padding:.5rem .25rem">Remove the relationship with <strong>@_removeTarget?.TargetName</strong>? This will not delete either account.</p>
        </Content>
        <FooterTemplate>
            <div class="rm-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showConfirmRemove = false">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ExecuteRemoveAsync"><i class="bi bi-trash" aria-hidden="true"></i> Remove</button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    [Parameter] public Guid AccountId { get; set; }

    private SfToast?            _toast;
    private SfDiagramComponent? _diagram;
    private bool                _loading  = true;
    private string              _view     = "diagram";
    private string              _hierType = "commercial";
    private string?             _rootName;

    private List<RmNode>        _nodes    = [];
    private List<RmEdge>        _edges    = [];
    private List<RmFlatRow>     _flatTree = [];

    private Syncfusion.Blazor.Diagram.DiagramObjectCollection<Syncfusion.Blazor.Diagram.Node>      _diagramNodes      = new();
    private Syncfusion.Blazor.Diagram.DiagramObjectCollection<Syncfusion.Blazor.Diagram.Connector> _diagramConnectors = new();

    private bool    _showAddRel        = false;
    private bool    _showConfirmRemove = false;
    private RmEdge  _newEdge           = new();
    private RmEdge? _removeTarget;
    private string? _addRelError;

    private static readonly List<RmLv> _relTypeOpts = [
        new("Parent","Parent"), new("Subsidiary","Subsidiary"), new("Affiliate","Affiliate"),
        new("Partner","Partner"), new("Household Member","Household Member"),
        new("Named Insured","Named Insured"), new("Co-Insured","Co-Insured"),
        new("Related Insured","Related Insured"), new("Decision Maker","Decision Maker"),
        new("Referred By","Referred By"), new("Referred To","Referred To"),
        new("Guarantor","Guarantor"), new("Ultimate Parent","Ultimate Parent"),
    ];
    private static readonly List<RmLv> _dirOpts = [
        new("Outbound","Outbound"), new("Inbound","Inbound"), new("Mutual","Mutual"),
    ];
    private static readonly List<RmLv> _acctTypeOpts = [
        new("Commercial","Commercial"), new("Personal","Personal"),
        new("Non-Profit","Non-Profit"), new("Government","Government"),
    ];

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home", "/"), new("Accounts", "/accounts"),
            new("Account", $"/accounts/{AccountId}"),
            new("Hierarchy", $"/accounts/{AccountId}/relationships"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; StateHasChanged();
        await Task.Delay(0);
        BuildStubData();
        RebuildDiagram();
        _loading = false;
    }

    private void OnDiagramCreated() { }

    private void RebuildDiagram()
    {
        var visible = _hierType switch
        {
            "commercial" => _nodes.Where(n => n.AccountType == "Commercial").ToList(),
            "household"  => _nodes.Where(n => n.AccountType == "Personal").ToList(),
            _            => _nodes,
        };
        var visibleIds = visible.Select(n => n.NodeId).ToHashSet();

        _diagramNodes = new Syncfusion.Blazor.Diagram.DiagramObjectCollection<Syncfusion.Blazor.Diagram.Node>(
            visible.Select(n => new Syncfusion.Blazor.Diagram.Node
            {
                ID = n.NodeId, Width = 165, Height = 52,
                Style = new Syncfusion.Blazor.Diagram.ShapeStyle { Fill = NodeFill(n), StrokeColor = NodeStroke(n) },
                Annotations = new Syncfusion.Blazor.Diagram.DiagramObjectCollection<Syncfusion.Blazor.Diagram.ShapeAnnotation>
                {
                    new Syncfusion.Blazor.Diagram.ShapeAnnotation
                    {
                        Content = n.Name.Length > 22 ? n.Name[..20] + "…" : n.Name,
                        Style = new Syncfusion.Blazor.Diagram.TextStyle { Color = NodeTextColor(n), FontSize = 11, Bold = n.IsRoot }
                    }
                }
            }).ToList());

        _diagramConnectors = new Syncfusion.Blazor.Diagram.DiagramObjectCollection<Syncfusion.Blazor.Diagram.Connector>(
            _edges
            .Where(e => visibleIds.Contains(e.SourceId) && visibleIds.Contains(e.TargetId))
            .Select(e => new Syncfusion.Blazor.Diagram.Connector
            {
                ID = e.EdgeId, SourceID = e.SourceId, TargetID = e.TargetId,
                Type = Syncfusion.Blazor.Diagram.ConnectorSegmentType.Orthogonal,
                Style = new Syncfusion.Blazor.Diagram.ShapeStyle { StrokeColor = "#94a3b8", StrokeWidth = 1.5f },
                TargetDecorator = new Syncfusion.Blazor.Diagram.DecoratorSettings
                {
                    Shape = Syncfusion.Blazor.Diagram.DecoratorShape.Arrow,
                    Style = new Syncfusion.Blazor.Diagram.ShapeStyle { Fill = "#94a3b8", StrokeColor = "#94a3b8" }
                },
                Annotations = new Syncfusion.Blazor.Diagram.DiagramObjectCollection<Syncfusion.Blazor.Diagram.PathAnnotation>
                {
                    new Syncfusion.Blazor.Diagram.PathAnnotation
                    {
                        Content = e.RelationType,
                        Style = new Syncfusion.Blazor.Diagram.TextStyle { FontSize = 9, Color = "#64748b" }
                    }
                }
            }).ToList());

        // Flatten tree for tree view
        _flatTree = [];
        foreach (var root in _nodes.Where(n => !_edges.Any(e => e.TargetId == n.NodeId && visibleIds.Contains(e.SourceId))))
            FlattenInto(root, 0, visibleIds);
    }

    private void FlattenInto(RmNode node, int depth, HashSet<string> visibleIds)
    {
        if (!visibleIds.Contains(node.NodeId)) return;
        _flatTree.Add(new RmFlatRow(node.AccountId, node.NodeId, node.Name, node.AccountType, node.RelationType, node.TotalPremium, node.IsRoot, depth));
        foreach (var childEdge in _edges.Where(e => e.SourceId == node.NodeId && visibleIds.Contains(e.TargetId)))
        {
            var child = _nodes.FirstOrDefault(n => n.NodeId == childEdge.TargetId);
            if (child is not null) FlattenInto(child, depth + 1, visibleIds);
        }
    }

    private void ConfirmRemove(RmEdge e) { _removeTarget = e; _showConfirmRemove = true; }

    private async Task CommitAddRelAsync()
    {
        if (string.IsNullOrWhiteSpace(_newEdge.TargetName)) { _addRelError = "Account name is required."; return; }

        var newTargetId = Guid.NewGuid().ToString();
        _newEdge.EdgeId   = Guid.NewGuid().ToString();
        _newEdge.SourceId = AccountId.ToString();
        _newEdge.TargetId = newTargetId;
        _edges.Add(_newEdge);
        _nodes.Add(new RmNode { AccountId = Guid.Parse(newTargetId), NodeId = newTargetId, Name = _newEdge.TargetName, AccountType = _newEdge.TargetType, RelationType = _newEdge.RelationType });
        RebuildDiagram();
        _showAddRel = false; _newEdge = new(); _addRelError = null;
        await ShowToast("Account linked successfully.");
    }

    private async Task ExecuteRemoveAsync()
    {
        if (_removeTarget is not null)
        {
            _edges.Remove(_removeTarget);
            _nodes.RemoveAll(n => n.NodeId == _removeTarget.TargetId);
            RebuildDiagram();
        }
        _showConfirmRemove = false; _removeTarget = null;
        await ShowToast("Relationship removed.");
    }

    private async Task ShowToast(string msg)
    {
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = "e-toast-success" });
    }

    // ── Style helpers ─────────────────────────────────────────────────────────
    private static string NodeFill(RmNode n) => n.IsRoot ? "#1d4ed8" :
        n.AccountType == "Personal" ? "#d1fae5" :
        n.RelationType is "Parent" or "Ultimate Parent" ? "#fef3c7" : "#ede9fe";

    private static string NodeStroke(RmNode n) => n.IsRoot ? "#1e40af" :
        n.AccountType == "Personal" ? "#047857" :
        n.RelationType is "Parent" or "Ultimate Parent" ? "#d97706" : "#6d28d9";

    private static string NodeTextColor(RmNode n) => n.IsRoot ? "#ffffff" :
        n.AccountType == "Personal" ? "#065f46" :
        n.RelationType is "Parent" or "Ultimate Parent" ? "#92400e" : "#4c1d95";

    private static string NodeColorCss(string t) => t switch
    {
        "Commercial" => "rm-av-comm",
        "Personal"   => "rm-av-pers",
        "Non-Profit" => "rm-av-np",
        _            => "rm-av-other",
    };

    private static string RelBadgeCss(string r) => r switch
    {
        "Parent" or "Ultimate Parent"                           => "rm-rel rm-rel--parent",
        "Subsidiary" or "Affiliate"                             => "rm-rel rm-rel--sub",
        "Household Member"                                      => "rm-rel rm-rel--hh",
        "Named Insured" or "Co-Insured" or "Related Insured"    => "rm-rel rm-rel--insured",
        "Referred By" or "Referred To"                          => "rm-rel rm-rel--ref",
        _                                                       => "rm-rel",
    };

    private static string Initials(string name)
    {
        var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}" : name.Length > 0 ? name[..1] : "?";
    }

    // ── Stub data ─────────────────────────────────────────────────────────────
    private void BuildStubData()
    {
        var rootId   = AccountId.ToString();
        var sub1Id   = Guid.NewGuid().ToString();
        var sub2Id   = Guid.NewGuid().ToString();
        var parentId = Guid.NewGuid().ToString();
        var hh1Id    = Guid.NewGuid().ToString();
        var hh2Id    = Guid.NewGuid().ToString();

        _rootName = "Sullivan Manufacturing LLC";
        NavContext.SetAccount(AccountId, _rootName);

        _nodes =
        [
            new RmNode { AccountId=Guid.Parse(parentId), NodeId=parentId, Name="Sullivan Holdings Corp",    AccountType="Commercial", RelationType="Ultimate Parent", TotalPremium=640000 },
            new RmNode { AccountId=AccountId,            NodeId=rootId,   Name=_rootName,                  AccountType="Commercial", RelationType="Current",         TotalPremium=285000, IsRoot=true },
            new RmNode { AccountId=Guid.Parse(sub1Id),   NodeId=sub1Id,   Name="Sullivan Realty LLC",       AccountType="Commercial", RelationType="Subsidiary",      TotalPremium=95000  },
            new RmNode { AccountId=Guid.Parse(sub2Id),   NodeId=sub2Id,   Name="Sullivan Logistics Inc",    AccountType="Commercial", RelationType="Affiliate",       TotalPremium=48000  },
            new RmNode { AccountId=Guid.Parse(hh1Id),    NodeId=hh1Id,    Name="Robert Sullivan HH",        AccountType="Personal",   RelationType="Household Member",TotalPremium=12000  },
            new RmNode { AccountId=Guid.Parse(hh2Id),    NodeId=hh2Id,    Name="Angela Park HH",            AccountType="Personal",   RelationType="Household Member",TotalPremium=8400   },
        ];

        _edges =
        [
            new RmEdge { EdgeId=Guid.NewGuid().ToString(), SourceId=parentId, TargetId=rootId,  TargetName="Sullivan Manufacturing LLC", TargetType="Commercial", RelationType="Subsidiary",       Direction="Outbound", TotalPremium=285000, ActivePolicies=5, SharedSince=new DateTime(2015,1,1) },
            new RmEdge { EdgeId=Guid.NewGuid().ToString(), SourceId=rootId,   TargetId=sub1Id,  TargetName="Sullivan Realty LLC",        TargetType="Commercial", RelationType="Subsidiary",       Direction="Outbound", TotalPremium=95000,  ActivePolicies=2, SharedSince=new DateTime(2018,4,1) },
            new RmEdge { EdgeId=Guid.NewGuid().ToString(), SourceId=rootId,   TargetId=sub2Id,  TargetName="Sullivan Logistics Inc",     TargetType="Commercial", RelationType="Affiliate",        Direction="Outbound", TotalPremium=48000,  ActivePolicies=1, SharedSince=new DateTime(2020,7,1) },
            new RmEdge { EdgeId=Guid.NewGuid().ToString(), SourceId=rootId,   TargetId=hh1Id,   TargetName="Robert Sullivan HH",         TargetType="Personal",   RelationType="Household Member", Direction="Outbound", TotalPremium=12000,  ActivePolicies=3, SharedSince=new DateTime(2015,1,1) },
            new RmEdge { EdgeId=Guid.NewGuid().ToString(), SourceId=rootId,   TargetId=hh2Id,   TargetName="Angela Park HH",             TargetType="Personal",   RelationType="Household Member", Direction="Outbound", TotalPremium=8400,   ActivePolicies=2, SharedSince=new DateTime(2021,3,1) },
        ];
    }

    // ── Models ─────────────────────────────────────────────────────────────────
    private sealed class RmNode
    {
        public Guid    AccountId    { get; set; }
        public string  NodeId       { get; set; } = string.Empty;
        public string  Name         { get; set; } = string.Empty;
        public string  AccountType  { get; set; } = "Commercial";
        public string  RelationType { get; set; } = string.Empty;
        public decimal TotalPremium { get; set; }
        public int     ActivePolicies { get; set; }
        public bool    IsRoot       { get; set; }
    }

    private sealed class RmEdge
    {
        public string  EdgeId        { get; set; } = string.Empty;
        public string  SourceId      { get; set; } = string.Empty;
        public string  TargetId      { get; set; } = string.Empty;
        public string  TargetName    { get; set; } = string.Empty;
        public string  TargetType    { get; set; } = "Commercial";
        public string  RelationType  { get; set; } = string.Empty;
        public string  Direction     { get; set; } = "Outbound";
        public decimal TotalPremium  { get; set; }
        public int     ActivePolicies{ get; set; }
        public DateTime SharedSince  { get; set; } = DateTime.UtcNow;
        public string? Notes         { get; set; }
        public bool    SharedCoverage{ get; set; }
