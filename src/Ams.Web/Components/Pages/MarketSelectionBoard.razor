@page "/submissions/{SubmissionId:guid}/markets"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Features.Submissions
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>Market Selection Board ? AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

@if (_loading)
{
    <div class="msb-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading markets?</span></div>
}
else
{
    <!-- -- HEADER --------------------------------------------------- -->
    <div class="msb-header">
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="GoBack">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Submission
        </button>
        <div class="msb-header-title">
            <i class="bi bi-diagram-3-fill msb-title-icon" aria-hidden="true"></i>
            <div>
                <h1 class="msb-h1">Market Selection Board</h1>
                <span class="msb-sub">@_submissionNo ? @_account ? @_lob</span>
            </div>
        </div>
        <div class="msb-header-actions">
            <button class="um-btn um-btn-ghost um-btn-sm"
                    @onclick='() => _view = (_view == "kanban" ? "matrix" : "kanban")'>
                <i class="bi @(_view == "kanban" ? "bi-table" : "bi-kanban") " aria-hidden="true"></i>
                @(_view == "kanban" ? "Matrix View" : "Kanban View")
            </button>
            <button class="um-btn um-btn-primary um-btn-sm" @onclick="SubmitSelected">
                <i class="bi bi-send" aria-hidden="true"></i>
                Submit Tier 1 (@_markets.Count(m => m.Tier == 1))
            </button>
        </div>
    </div>

    <!-- -- STRATEGY KPI STRIP -------------------------------------- -->
    <div class="msb-kpi-strip">
        @KpiCard("bi-diagram-3",        "Markets Pooled",      _markets.Count.ToString(),                                               "msb-kpi-pool")
        @KpiCard("bi-1-circle-fill",    "Tier 1 Selected",     _markets.Count(m=>m.Tier==1).ToString(),                                 "msb-kpi-t1")
        @KpiCard("bi-2-circle-fill",    "Tier 2 Selected",     _markets.Count(m=>m.Tier==2).ToString(),                                 "msb-kpi-t2")
        @KpiCard("bi-bullseye",         "Avg Appetite Score",  (_markets.Any() ? _markets.Average(m=>m.AppetiteScore) : 0).ToString("F0") + "/100", "msb-kpi-apt")
        @KpiCard("bi-clock",            "Best SLA",            (_markets.Any() ? _markets.Min(m=>m.TurnaroundDays) : 0) + "d",         "msb-kpi-sla")
        @KpiCard("bi-trophy",           "Avg Hit Ratio",       (_markets.Any() ? _markets.Average(m=>m.HitRatioPct) : 0).ToString("F0") + "%",     "msb-kpi-hit")
        @KpiCard("bi-bar-chart-fill",   "Avg Bind Ratio",      (_markets.Any() ? _markets.Average(m=>m.BindRatioPct) : 0).ToString("F0") + "%",    "msb-kpi-bind")
        @KpiCard("bi-percent",          "Avg Commission",      (_markets.Any() ? _markets.Average(m=>m.CommissionPct) : 0).ToString("F1") + "%",   "msb-kpi-comm")
    </div>

    <!-- -- FILTER BAR ---------------------------------------------- -->
    <div class="msb-filter-bar">
        <input class="e-input msb-search" @bind="_search" @bind:event="oninput" placeholder="Search carriers?" />
        <select class="e-input msb-filter-sel" @bind="_filterTier">
            <option value="-1">All Tiers</option>
            <option value="1">Tier 1</option>
            <option value="2">Tier 2</option>
            <option value="3">Watch</option>
            <option value="0">Unassigned</option>
        </select>
        <label class="msb-filter-lbl">Min Appetite:</label>
        <input type="range" class="msb-slider" min="0" max="100" step="5"
               @bind="_minAppetite" @bind:event="oninput" />
        <span class="msb-slider-val">@_minAppetite</span>
        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters">
            <i class="bi bi-x" aria-hidden="true"></i> Reset
        </button>
        <span class="msb-filter-count">@FilteredMarkets.Count() showing</span>
    </div>

    @if (_view == "kanban")
    {
        <!-- -- KANBAN BOARD ----------------------------------------- -->
        <div class="msb-kanban-wrap">
            <div class="app-kanban msb-native-kanban">
                @foreach (var group in FilteredMarkets.GroupBy(m => m.TierKey))
                {
                    <section class="msb-native-lane">
                        <h3>@group.Key</h3>
                        @foreach (var mkt in group)
                        {
                        <div class="msb-kcard msb-kcard-@ScoreRing(mkt.AppetiteScore)">
                            <div class="msb-kc-head">
                                <div class="msb-kc-info">
                                    <div class="msb-kc-carrier">@mkt.Carrier</div>
                                    <div class="msb-kc-prog">@mkt.Program</div>
                                </div>
                                <div class="msb-kc-score msb-score-@ScoreRing(mkt.AppetiteScore)">
                                    <span class="msb-kcs-val">@mkt.AppetiteScore</span>
                                    <span class="msb-kcs-lbl">APT</span>
                                </div>
                            </div>
                            <div class="msb-kc-metrics">
                                <span class="msb-kcm" title="Turnaround SLA"><i class="bi bi-clock" aria-hidden="true"></i> @mkt.TurnaroundDays d</span>
                                <span class="msb-kcm" title="Hit Ratio"><i class="bi bi-bullseye" aria-hidden="true"></i> @mkt.HitRatioPct%</span>
                                <span class="msb-kcm" title="Bind Ratio"><i class="bi bi-shield-check" aria-hidden="true"></i> @mkt.BindRatioPct%</span>
                                <span class="msb-kcm @(mkt.CommissionPct >= 15 ? "msb-comm-hi" : mkt.CommissionPct < 12 ? "msb-comm-lo" : "")" title="Commission"><i class="bi bi-percent" aria-hidden="true"></i> @mkt.CommissionPct.ToString("F1")%</span>
                            </div>
                            <div class="msb-kc-foot">
                                <span class="msb-stars-sm">@(new string('?', mkt.ProducerPreference))@(new string('?', 5 - mkt.ProducerPreference))</span>
                                @if (mkt.Submitted)
                                {
                                    <span class="msb-kc-sent"><i class="bi bi-send-check" aria-hidden="true"></i> Sent</span>
                                }
                                <button class="um-btn um-btn-ghost um-btn-xs msb-kc-info-btn"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => OpenDetail(mkt)"
                                        title="View details">
                                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                        }
                    </section>
                }
            </div>
        </div>

        @* old board lanes removed ? AppKanban is now the board view *@
    }
    else
    {
        <!-- -- MATRIX VIEW ------------------------------------------ -->
        <div class="msb-matrix-wrap">
            <AppGrid DataSource="@FilteredMarkets.ToList()" AllowSorting="true" AllowPaging="true"
                    AllowResizing="true" RowHeight="44">
                
                <GridColumns>
                    <GridColumn Field="Carrier"          HeaderText="Carrier / Program"  Width="200"
                                Template="@(ctx => CarrierCell((MarketRow)ctx))" />
                    <GridColumn Field="Tier"             HeaderText="Tier"               Width="90"
                                Template="@(ctx => TierChip(((MarketRow)ctx).Tier))" />
                    <GridColumn Field="AppetiteScore"    HeaderText="Appetite ?"        Width="110"
                                Template="@(ctx => ScoreBar(((MarketRow)ctx).AppetiteScore, "apt"))" />
                    <GridColumn Field="TurnaroundDays"   HeaderText="SLA (days)"         Width="100"
                                Template="@(ctx => SlaCell(((MarketRow)ctx).TurnaroundDays))" />
                    <GridColumn Field="HitRatioPct"      HeaderText="Hit Ratio %"        Width="105"
                                Template="@(ctx => PctBar(((MarketRow)ctx).HitRatioPct, "hit"))" />
                    <GridColumn Field="BindRatioPct"     HeaderText="Bind Ratio %"       Width="110"
                                Template="@(ctx => PctBar(((MarketRow)ctx).BindRatioPct, "bind"))" />
                    <GridColumn Field="ProducerPreference" HeaderText="Producer Pref"    Width="120"
                                Template="@(ctx => StarsCell(((MarketRow)ctx).ProducerPreference))" />
                    <GridColumn Field="CommissionPct"    HeaderText="Commission %"       Width="115"
                                Template="@(ctx => CommCell(((MarketRow)ctx).CommissionPct))" />
                    <GridColumn Field="UnderwriterName"  HeaderText="Underwriter"        Width="140" />
                    <GridColumn Field="Submitted"        HeaderText="Submitted"          Width="100"
                                Template="@(ctx => SubmittedCell(((MarketRow)ctx).Submitted))" />
                    <GridColumn HeaderText=""            Width="110"  AllowSorting="false"
                                Template="@(ctx => MatrixActions((MarketRow)ctx))" />
                </GridColumns>
            </AppGrid>
        </div>
    }

    <!-- -- MARKET DETAIL DRAWER ------------------------------------ -->
    @if (_detailMarket is not null)
    {
        <div class="msb-drawer-backdrop" @onclick="() => _detailMarket = null"></div>
        <div class="msb-drawer">
            <div class="msb-drawer-head">
                <div>
                    <h2 class="msb-drawer-carrier">@_detailMarket.Carrier</h2>
                    <span class="msb-drawer-prog">@_detailMarket.Program</span>
                </div>
                <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _detailMarket = null">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <div class="msb-drawer-body">
                <!-- Big score -->
                <div class="msb-big-score msb-score-@ScoreRing(_detailMarket.AppetiteScore)">
                    <div class="msb-bs-val">@_detailMarket.AppetiteScore</div>
                    <div class="msb-bs-lbl">Appetite Score</div>
                </div>

                <!-- Score breakdown -->
                <h3 class="msb-drawer-section-head">Strategy Metrics</h3>
                @DrawerMetricRow("Turnaround SLA",       _detailMarket.TurnaroundDays + " business days", ScoreRing(100 - _detailMarket.TurnaroundDays * 8))
                @DrawerMetricRow("Expected Hit Ratio",   _detailMarket.HitRatioPct + "%",                  ScoreRing(_detailMarket.HitRatioPct))
                @DrawerMetricRow("Historical Bind Ratio",_detailMarket.BindRatioPct + "%",                  ScoreRing(_detailMarket.BindRatioPct))
                @DrawerMetricRow("Commission Rate",      _detailMarket.CommissionPct.ToString("F1") + "%", _detailMarket.CommissionPct >= 15 ? "high" : _detailMarket.CommissionPct >= 10 ? "ok" : "low")
                @DrawerMetricRow("Producer Preference",  new string('?', _detailMarket.ProducerPreference) + new string('?', 5 - _detailMarket.ProducerPreference), "ok")

                <h3 class="msb-drawer-section-head">Market Request Workflow</h3>
                @DrawerMetricRow("Underwriter", SafeValue(_detailMarket.UnderwriterName), "ok")
                @DrawerMetricRow("Contact", SafeValue(_detailMarket.UnderwriterEmail), "ok")
                @DrawerMetricRow("Due Date", _detailMarket.DueDateUtc?.ToLocalTime().ToString("MMM d, yyyy") ?? "Not set", _detailMarket.DueDateUtc.HasValue && _detailMarket.DueDateUtc < DateTime.UtcNow ? "low" : "ok")
                @DrawerMetricRow("Request Scope", SafeValue(_detailMarket.QuoteRequestScopeCode), "ok")
                @DrawerMetricRow("Requested Premium", _detailMarket.RequestedPremium?.ToString("C0") ?? "Not set", _detailMarket.IsPastDue ? "low" : "ok")
                @DrawerMetricRow("Submission Method", SafeValue(_detailMarket.SubmissionMethodCode), "ok")
                @DrawerMetricRow("Requested Coverages", SafeValue(_detailMarket.RequestedCoverageSummary), "ok")
                @DrawerMetricRow("Requested Limits", SafeValue(_detailMarket.RequestedLimits), "ok")
                @if (_detailMarket.RequestedLines.Any())
                {
                    <div class="msb-apt-row">
                        <span class="msb-apt-field">Selected Lines</span>
                        <span class="msb-apt-val">@string.Join("; ", _detailMarket.RequestedLines.Select(l => $"{l.LineOfBusiness} {l.TargetPremium:C0}"))</span>
                    </div>
                }

                <h3 class="msb-drawer-section-head">Carrier Transmission</h3>
                @DrawerMetricRow("Transmission Status", string.IsNullOrWhiteSpace(_detailMarket.LatestTransmissionStatusCode) ? "Not transmitted" : _detailMarket.LatestTransmissionStatusCode, TransmissionScore(_detailMarket.LatestTransmissionStatusCode))
                @DrawerMetricRow("Connector", string.IsNullOrWhiteSpace(_detailMarket.LatestTransmissionConnectorName) ? (_detailMarket.LatestTransmissionChannelCode ?? "Not configured") : _detailMarket.LatestTransmissionConnectorName, "ok")
                @DrawerMetricRow("External Reference", SafeValue(_detailMarket.LatestTransmissionExternalReferenceNumber), "ok")
                @DrawerMetricRow("Sent", _detailMarket.LatestTransmissionSentDateUtc?.ToLocalTime().ToString("MMM d, yyyy h:mm tt") ?? "Not sent", _detailMarket.LatestTransmissionSentDateUtc.HasValue ? "ok" : "low")
                @DrawerMetricRow("Confirmed", _detailMarket.LatestTransmissionConfirmedDateUtc?.ToLocalTime().ToString("MMM d, yyyy h:mm tt") ?? "Not confirmed", _detailMarket.LatestTransmissionConfirmedDateUtc.HasValue ? "ok" : "low")
                @if (!string.IsNullOrWhiteSpace(_detailMarket.LatestTransmissionLastError))
                {
                    @DrawerMetricRow("Failure Detail", _detailMarket.LatestTransmissionLastError, "low")
                }
                @DrawerMetricRow("Inbound Response", LatestInboundSummary(_detailMarket), _detailMarket.LatestInboundResponseReceivedDateUtc.HasValue ? "ok" : "low")

                <!-- Appetite details -->
                <h3 class="msb-drawer-section-head">Appetite Details</h3>
                @foreach (var ap in _detailMarket.AppetiteDetails)
                {
                    <div class="msb-apt-row">
                        <span class="msb-apt-field">@ap.Key</span>
                        <span class="msb-apt-val @(ap.Value == "Yes" ? "msb-apt-yes" : ap.Value == "No" ? "msb-apt-no" : "")">@ap.Value</span>
                    </div>
                }

                <!-- Historical data -->
                <h3 class="msb-drawer-section-head">Submission History (this market)</h3>
                <table class="msb-hist-table">
                    <thead><tr><th>Year</th><th>Submitted</th><th>Quoted</th><th>Bound</th><th>Avg Premium</th></tr></thead>
                    <tbody>
                        @foreach (var h in _detailMarket.History)
                        {
                            <tr>
                                <td>@h.Year</td>
                                <td>@h.Submitted</td>
                                <td>@h.Quoted</td>
                                <td>@h.Bound</td>
                                <td>@h.AvgPremium.ToString("C0")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- Actions -->
                <div class="msb-drawer-actions">
                    <button class="um-btn um-btn-primary um-btn-sm" @onclick="() => { SetTier(_detailMarket, 1); _detailMarket = null; }">
                        <i class="bi bi-1-circle" aria-hidden="true"></i> Add to Tier 1
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => { SetTier(_detailMarket, 2); _detailMarket = null; }">
                        <i class="bi bi-2-circle" aria-hidden="true"></i> Add to Tier 2
                    </button>
                    <button class="um-btn um-btn-primary um-btn-sm" @onclick="() => RecordResponse(_detailMarket)">
                        <i class="bi bi-receipt" aria-hidden="true"></i> Record Response
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid SubmissionId { get; set; }

    EnterpriseToast _toast = default!;

    bool   _loading       = true;
    string _view          = "kanban";
    string _search        = "";
    int    _filterTier    = -1;
    int    _minAppetite   = 0;
    Guid   _tenantId;
    Guid?  _currentUserId;
    string _submissionNo  = "";
    string _account       = "";
    string _lob           = "";

    MarketRow? _detailMarket = null;

    IEnumerable<MarketRow> FilteredMarkets => _markets
        .Where(m => (string.IsNullOrEmpty(_search) || m.Carrier.Contains(_search, StringComparison.OrdinalIgnoreCase) || m.Program.Contains(_search, StringComparison.OrdinalIgnoreCase))
                 && (_filterTier == -1 || m.Tier == _filterTier)
                 && m.AppetiteScore >= _minAppetite);

    sealed class MarketRow
    {
        public Guid SubmissionMarketId { get; set; }
        public Guid CarrierId { get; set; }
        public string  Carrier            { get; set; } = "";
        public string  Program            { get; set; } = "";
        public string  UnderwriterName    { get; set; } = "";
        public string? UnderwriterEmail { get; set; }
        public string? UnderwriterPhone { get; set; }
        public DateTime? DueDateUtc { get; set; }
        public string? RequestedCoverageSummary { get; set; }
        public string? RequestedLimits { get; set; }
        public string? SubmissionMethodCode { get; set; }
        public string? QuoteRequestScopeCode { get; set; }
        public decimal? RequestedPremium { get; set; }
        public bool IsPastDue { get; set; }
        public int? DaysPastDue { get; set; }
        public List<SubmissionMarketLineDto> RequestedLines { get; set; } = [];
        public Guid? LatestCarrierTransmissionId { get; set; }
        public string? LatestTransmissionStatusCode { get; set; }
        public string? LatestTransmissionChannelCode { get; set; }
        public string? LatestTransmissionConnectorName { get; set; }
        public string? LatestTransmissionExternalReferenceNumber { get; set; }
        public DateTime? LatestTransmissionSentDateUtc { get; set; }
        public DateTime? LatestTransmissionConfirmedDateUtc { get; set; }
        public DateTime? LatestTransmissionFailedDateUtc { get; set; }
        public DateTime? LatestTransmissionBounceDateUtc { get; set; }
        public string? LatestTransmissionLastError { get; set; }
        public string? LatestInboundResponseStatusCode { get; set; }
        public string? LatestInboundResponseTypeCode { get; set; }
        public DateTime? LatestInboundResponseReceivedDateUtc { get; set; }
        public int     Tier               { get; set; }        // 0=unassigned 1=T1 2=T2 3=watch
        public string  TierKey            => Tier switch { 1=>"T1", 2=>"T2", 3=>"Watch", _=>"Unassigned" };
        public int     AppetiteScore      { get; set; }        // 0-100
        public int     TurnaroundDays     { get; set; }
        public int     HitRatioPct        { get; set; }        // 0-100
        public int     BindRatioPct       { get; set; }        // 0-100
        public int     ProducerPreference { get; set; }        // 1-5
        public decimal CommissionPct      { get; set; }
        public bool    Submitted          { get; set; }
        public string  StrategyNote       { get; set; } = "";
        public List<KeyValuePair<string,string>> AppetiteDetails { get; set; } = new();
        public List<HistRow> History      { get; set; } = new();
    }

    sealed class HistRow
    {
        public string  Year       { get; set; } = "";
        public int     Submitted  { get; set; }
        public int     Quoted     { get; set; }
        public int     Bound      { get; set; }
        public decimal AvgPremium { get; set; }
    }

    readonly List<MarketRow> _markets = new();

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home","/"), new("Submissions","/submissions"),
            new("Submission",$"/submissions/{SubmissionId}"),
            new("Markets",$"/submissions/{SubmissionId}/markets"));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var context = await CurrentUser.RequireAsync();
            _tenantId = context.TenantId;
            _currentUserId = context.UserId;

            var submission = await Api.GetSubmissionByIdAsync(SubmissionId);
            if (submission is not null)
            {
                _submissionNo = submission.SubmissionNumber;
                _account = submission.AccountName;
                _lob = submission.LineOfBusiness;
            }

            var markets = await Api.GetSubmissionMarketsAsync(SubmissionId) ?? [];
            _markets.Clear();
            _markets.AddRange(markets.Select(ToMarketRow));
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Title = "Load failed", Content = ex.Message, CssClass = "enterprise-toast-danger" });
        }
        finally
        {
            _loading = false;
        }
    }

    static MarketRow ToMarketRow(SubmissionMarketDto market) => new()
    {
        SubmissionMarketId = market.SubmissionMarketId,
        CarrierId = market.CarrierId,
        Carrier = market.CarrierName,
        Program = string.IsNullOrWhiteSpace(market.LatestQuoteNumber) ? market.Status : $"{market.LatestQuoteNumber} - {market.LatestQuoteStatus}",
        UnderwriterName = market.UnderwriterName ?? string.Empty,
        UnderwriterEmail = market.UnderwriterEmail,
        UnderwriterPhone = market.UnderwriterPhone,
        DueDateUtc = market.DueDateUtc,
        RequestedCoverageSummary = market.RequestedCoverageSummary,
        RequestedLimits = market.RequestedLimits,
        SubmissionMethodCode = market.SubmissionMethodCode,
        QuoteRequestScopeCode = market.QuoteRequestScopeCode,
        RequestedPremium = market.RequestedPremium,
        IsPastDue = market.IsPastDue,
        DaysPastDue = market.DaysPastDue,
        RequestedLines = market.RequestedLines.ToList(),
        LatestCarrierTransmissionId = market.LatestCarrierTransmissionId,
        LatestTransmissionStatusCode = market.LatestTransmissionStatusCode,
        LatestTransmissionChannelCode = market.LatestTransmissionChannelCode,
        LatestTransmissionConnectorName = market.LatestTransmissionConnectorName,
        LatestTransmissionExternalReferenceNumber = market.LatestTransmissionExternalReferenceNumber,
        LatestTransmissionSentDateUtc = market.LatestTransmissionSentDateUtc,
        LatestTransmissionConfirmedDateUtc = market.LatestTransmissionConfirmedDateUtc,
        LatestTransmissionFailedDateUtc = market.LatestTransmissionFailedDateUtc,
        LatestTransmissionBounceDateUtc = market.LatestTransmissionBounceDateUtc,
        LatestTransmissionLastError = market.LatestTransmissionLastError,
        LatestInboundResponseStatusCode = market.LatestInboundResponseStatusCode,
        LatestInboundResponseTypeCode = market.LatestInboundResponseTypeCode,
        LatestInboundResponseReceivedDateUtc = market.LatestInboundResponseReceivedDateUtc,
        Tier = market.Status switch { "In Review" or "Quoted" => 1, "Pending" or "Current Market" => 2, "Declined" or "Blocked" => 3, _ => 0 },
        AppetiteScore = market.AppetiteScore,
        TurnaroundDays = market.RespondedDateUtc.HasValue ? Math.Max(0, (int)Math.Round((market.RespondedDateUtc.Value - market.AddedDateUtc).TotalDays)) : 0,
        HitRatioPct = market.LatestQuoteId.HasValue ? 100 : 0,
        BindRatioPct = market.LatestQuoteStatus is "Accepted" or "Bound" ? 100 : 0,
        ProducerPreference = market.IsRecommended ? 5 : 1,
        CommissionPct = 0,
        Submitted = market.Status is "In Review" or "Quoted" or "Declined" or "Bound",
        StrategyNote = market.DeclineReason ?? market.LatestQuoteStatus ?? market.Status,
        AppetiteDetails = new() { new("Market Status", market.Status), new("Latest Quote", market.LatestQuoteNumber ?? "Not received"), new("Recommended", market.IsRecommended ? "Yes" : "No"), new("Documents Sent", market.SubmittedDateUtc.HasValue ? "Yes" : "Not yet"), new("Carrier Delivered", market.LatestTransmissionConfirmedDateUtc.HasValue ? "Yes" : "No"), new("Inbound Response", market.LatestInboundResponseReceivedDateUtc.HasValue ? "Yes" : "No"), new("No Response", market.Status == "No Response" ? "Yes" : "No"), new("Past Due", market.IsPastDue ? "Yes" : "No") },
        History = new()
    };

    static string LatestInboundSummary(MarketRow market)
        => market.LatestInboundResponseReceivedDateUtc.HasValue
            ? $"{(string.IsNullOrWhiteSpace(market.LatestInboundResponseTypeCode) ? "Response" : market.LatestInboundResponseTypeCode)} / {(string.IsNullOrWhiteSpace(market.LatestInboundResponseStatusCode) ? "Received" : market.LatestInboundResponseStatusCode)} on {market.LatestInboundResponseReceivedDateUtc.Value.ToLocalTime():MMM d, yyyy h:mm tt}"
            : "No inbound response";

    static string TransmissionScore(string? statusCode)
        => statusCode switch
        {
            "Delivered" or "ResponseReceived" => "ok",
            "Failed" or "Bounced" => "low",
            "AwaitingExternalConnector" or "Queued" => "high",
            _ => "low"
        };

    void SetTier(MarketRow m, int tier) => m.Tier = tier;
    void OpenDetail(MarketRow m) => _detailMarket = m;
    void RecordResponse(MarketRow m) => Nav.NavigateTo($"/submissions/{SubmissionId}");
    void ResetFilters() { _search = ""; _filterTier = -1; _minAppetite = 0; }
    void GoBack() => Nav.NavigateTo($"/submissions/{SubmissionId}");

    async Task SubmitSelected()
    {
        var tier1 = _markets.Where(m => m.Tier == 1 && !m.Submitted).ToList();
        foreach (var m in tier1)
        {
            await Api.SubmitSubmissionToMarketAsync(SubmissionId, new SubmitSubmissionToMarketRequest(_tenantId, m.CarrierId, $"Submitted from market selection board by user {_currentUserId}."));
        }
        await LoadAsync();
        await _toast.ShowAsync(new ToastModel
        {
            Title    = "Submitted",
            Content  = $"{tier1.Count} market{(tier1.Count==1?"":"s")} submitted.",
            CssClass = "enterprise-toast-success"
        });
    }

    static string ScoreRing(int score) =>
        score >= 80 ? "high" : score >= 60 ? "ok" : score >= 40 ? "low" : "poor";

    static string SafeValue(string? value) => string.IsNullOrWhiteSpace(value) ? "Not set" : value;

    // -- Cell renderers ---------------------------------------------
    RenderFragment CarrierCell(MarketRow r) =>
        @<div class="msb-carrier-cell">
            <div class="msb-cc-name">@r.Carrier</div>
            <div class="msb-cc-prog">@r.Program</div>
        </div>;

    RenderFragment TierChip(int tier) =>
        @<span class="msb-tier-chip msb-tier-@tier">@(tier switch { 1=>"Tier 1", 2=>"Tier 2", 3=>"Watch", _=>"?" })</span>;

    RenderFragment ScoreBar(int score, string kind) =>
        @<div class="msb-score-bar-wrap">
            <div class="msb-score-bar msb-sb-@ScoreRing(score)" style="width:@score%"></div>
            <span class="msb-sb-val">@score</span>
        </div>;

    RenderFragment PctBar(int pct, string kind) =>
        @<div class="msb-score-bar-wrap">
            <div class="msb-score-bar msb-sb-@(pct >= 60 ? "high" : pct >= 35 ? "ok" : "low")" style="width:@pct%"></div>
            <span class="msb-sb-val">@pct%</span>
        </div>;

    RenderFragment SlaCell(int days) =>
        @<span class="@(days <= 5 ? "msb-sla-fast" : days <= 10 ? "msb-sla-ok" : "msb-sla-slow")">@days d</span>;

    RenderFragment StarsCell(int pref) =>
        @<span class="msb-stars-sm">@(new string('?', pref))@(new string('?', 5-pref))</span>;

    RenderFragment CommCell(decimal pct) =>
        @<span class="@(pct >= 15 ? "msb-comm-hi" : pct < 12 ? "msb-comm-lo" : "")">@pct.ToString("F1")%</span>;

    RenderFragment SubmittedCell(bool s) =>
        s ? @<span class="msb-sub-yes"><i class="bi bi-send-check" aria-hidden="true"></i> Sent</span>
          : @<span class="msb-sub-no">?</span>;

    RenderFragment MatrixActions(MarketRow r) =>
        @<div class="msb-mat-actions">
            <button class="um-btn um-btn-primary um-btn-xs" @onclick="() => SetTier(r, 1)"><i class="bi bi-1-circle" aria-hidden="true"></i></button>
            <button class="um-btn um-btn-ghost   um-btn-xs" @onclick="() => SetTier(r, 2)"><i class="bi bi-2-circle" aria-hidden="true"></i></button>
            <button class="um-btn um-btn-ghost   um-btn-xs" @onclick="() => OpenDetail(r)"><i class="bi bi-info-circle" aria-hidden="true"></i></button>
        </div>;

    RenderFragment Metric(string icon, string lbl, string val, string quality) =>
        @<div class="msb-metric msb-metric-@quality">
            <i class="bi @icon" aria-hidden="true"></i>
            <span class="msb-metric-lbl">@lbl</span>
            <span class="msb-metric-val">@val</span>
        </div>;

    RenderFragment DrawerMetricRow(string label, string val, string quality) =>
        @<div class="msb-dmr">
            <span class="msb-dmr-lbl">@label</span>
            <span class="msb-dmr-val msb-dmr-@quality">@val</span>
        </div>;

    RenderFragment KpiCard(string icon, string label, string val, string css) =>
        @<div class="msb-kpi-card @css">
            <div class="msb-kpi-val">@val</div>
            <div class="msb-kpi-lbl"><i class="bi @icon" aria-hidden="true"></i> @label</div>
        </div>;
}
