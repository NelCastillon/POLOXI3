    private int CountStatus(string status) => _accounts.Count(a => a.StatusCode == status);
    private static string Fmt(decimal v) => v.ToString("C0");
    private static IReadOnlyList<string> DistinctOptions(IEnumerable<string?> values, params string?[] additionalValues)
        => values.Concat(additionalValues)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Select(v => v!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v)
            .ToList();
