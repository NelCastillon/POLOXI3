@page "/billing/accounts"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Billing Accounts — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<!-- ── CREATE BILLING ACCOUNT DIALOG ─────────────────────────────── -->
<SfDialog @bind-Visible="_showCreate" Width="560px" ShowCloseIcon="true" IsModal="true">
    <DialogTemplates>
        <Header><div class="ba-dlg-hdr"><i class="bi bi-building-plus" aria-hidden="true"></i> Create Billing Account</div></Header>
        <Content>
            <div class="ba-dlg-body">
                <div class="form-group mb-2"><label class="ba-lbl">Account Name *</label>
                    <SfTextBox @bind-Value="_newName" Placeholder="e.g. Acme Corp — Commercial Lines"></SfTextBox>
                </div>
                <div class="form-group mb-2"><label class="ba-lbl">Billing Mode</label>
                    <SfDropDownList TValue="string" TItem="string" DataSource="_billingModes" @bind-Value="_newMode" Width="100%"></SfDropDownList>
                </div>
                <div class="form-group mb-2"><label class="ba-lbl">Payment Terms</label>
                    <SfDropDownList TValue="string" TItem="string" DataSource="_terms" @bind-Value="_newTerms" Width="100%"></SfDropDownList>
                </div>
                <div class="form-group mb-2"><label class="ba-lbl">Default Payment Method</label>
                    <SfDropDownList TValue="string" TItem="string" DataSource="_methods" @bind-Value="_newMethod" Width="100%"></SfDropDownList>
                </div>
                <div class="form-group mb-2"><label class="ba-lbl">Credit Limit</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_newCreditLimit" Format="C2" Width="100%"></SfNumericTextBox>
                </div>
                <div class="form-group mb-2">
                    <SfCheckBox Label="Autopay Enrolled" @bind-Checked="_newAutopay"></SfCheckBox>
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Create" IsPrimary="true" OnClick="CreateAccountAsync"></DialogButton>
        <DialogButton Content="Cancel" OnClick="() => _showCreate = false"></DialogButton>
    </DialogButtons>
</SfDialog>

<AppPageHeader Title="Billing Accounts"
               Subtitle="Manage billing relationships, payment terms, credit limits, and autopay enrollment for all accounts"
               Icon="bi-building">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/billing/invoices")'>
            <i class="bi bi-receipt" aria-hidden="true"></i> Invoices
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/billing/modes")'>
            <i class="bi bi-diagram-3" aria-hidden="true"></i> Billing Modes
        </button>
        <button class="um-btn um-btn-primary" @onclick="() => _showCreate = true">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> New Account
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="ba-kpi-strip">
    <div class="ba-kpi"><i class="bi bi-building ba-ki blue" aria-hidden="true"></i><div><div class="ba-kv">@_accounts.Count</div><div class="ba-kl">Total Accounts</div></div></div>
    <div class="ba-kpi"><i class="bi bi-currency-dollar ba-ki blue" aria-hidden="true"></i><div><div class="ba-kv">@Fmt(_accounts.Sum(a=>a.Balance))</div><div class="ba-kl">Total AR Balance</div></div></div>
    <div class="ba-kpi"><i class="bi bi-exclamation-triangle ba-ki red" aria-hidden="true"></i><div><div class="ba-kv">@_accounts.Count(a=>a.Status=="Delinquent")</div><div class="ba-kl">Delinquent</div></div></div>
    <div class="ba-kpi"><i class="bi bi-arrow-repeat ba-ki green" aria-hidden="true"></i><div><div class="ba-kv">@_accounts.Count(a=>a.AutopayEnrolled)</div><div class="ba-kl">Autopay Enrolled</div></div></div>
    <div class="ba-kpi"><i class="bi bi-diagram-3 ba-ki purple" aria-hidden="true"></i><div><div class="ba-kv">@_accounts.Count(a=>a.BillingMode=="Agency Bill")</div><div class="ba-kl">Agency Bill</div></div></div>
    <div class="ba-kpi"><i class="bi bi-building-check ba-ki blue" aria-hidden="true"></i><div><div class="ba-kv">@_accounts.Count(a=>a.BillingMode=="Direct Bill")</div><div class="ba-kl">Direct Bill</div></div></div>
    <div class="ba-kpi"><i class="bi bi-credit-card ba-ki amber" aria-hidden="true"></i><div><div class="ba-kv">@Fmt(_accounts.Sum(a=>a.CreditLimit))</div><div class="ba-kl">Total Credit</div></div></div>
    <div class="ba-kpi"><i class="bi bi-shield-x ba-ki red" aria-hidden="true"></i><div><div class="ba-kv">@_accounts.Count(a=>a.Status=="Suspended")</div><div class="ba-kl">Suspended</div></div></div>
</div>

<!-- Sub-nav -->
<div class="ba-subnav">
    <button class="ba-snav-btn ba-snav-active"><i class="bi bi-building" aria-hidden="true"></i> All Accounts</button>
    <button class="ba-snav-btn" @onclick='() => Nav.NavigateTo("/billing/invoices")'><i class="bi bi-receipt" aria-hidden="true"></i> Invoices</button>
    <button class="ba-snav-btn" @onclick='() => Nav.NavigateTo("/billing/payments")'><i class="bi bi-cash-coin" aria-hidden="true"></i> Payments</button>
    <button class="ba-snav-btn" @onclick='() => Nav.NavigateTo("/billing/credits")'><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Credits</button>
    <button class="ba-snav-btn" @onclick='() => Nav.NavigateTo("/billing/reconciliation")'><i class="bi bi-ui-checks-grid" aria-hidden="true"></i> Reconciliation</button>
    <button class="ba-snav-btn" @onclick='() => Nav.NavigateTo("/billing/modes")'><i class="bi bi-diagram-3" aria-hidden="true"></i> Billing Modes</button>
    <button class="ba-snav-btn" @onclick='() => Nav.NavigateTo("/billing/collections")'><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Collections</button>
    <button class="ba-snav-btn" @onclick='() => Nav.NavigateTo("/billing/payment-experience")'><i class="bi bi-graph-up" aria-hidden="true"></i> Payment Experience</button>
</div>

<!-- Toolbar -->
<div class="ba-toolbar">
    <SfTextBox Placeholder="Search account name, policy, method…" @bind-Value="_search" Width="280px"></SfTextBox>
    <select class="e-input ba-sel" @bind="_filterMode">
        <option value="">All Billing Modes</option>
        <option value="Direct Bill">Direct Bill</option>
        <option value="Agency Bill">Agency Bill</option>
        <option value="EFT">EFT</option>
    </select>
    <select class="e-input ba-sel" @bind="_filterStatus">
        <option value="">All Statuses</option>
        <option value="Active">Active</option>
        <option value="Delinquent">Delinquent</option>
        <option value="Suspended">Suspended</option>
        <option value="Closed">Closed</option>
    </select>
    <select class="e-input ba-sel" @bind="_filterAutopay">
        <option value="">Autopay: All</option>
        <option value="yes">Autopay: Enrolled</option>
        <option value="no">Autopay: Not Enrolled</option>
    </select>
</div>

<!-- Grid -->
<div class="ba-grid-wrap">
    <SfGrid DataSource="FilteredAccounts" AllowSorting="true" AllowPaging="true" Height="520px">
        <GridEvents RowSelected="OnRowSelected" TValue="BillingAccountRow"></GridEvents>
        <GridPageSettings PageSize="15"></GridPageSettings>
        <GridColumns>
            <GridColumn HeaderText="Account" Width="230">
                <Template>
                    @{ var a = (BillingAccountRow)context; }
                    <div class="ba-acct-cell">
                        <i class="bi bi-building ba-acct-icon" aria-hidden="true"></i>
                        <div>
                            <div class="ba-acct-name">@a.Name</div>
                            <div class="ba-acct-sub">@a.PolicyCount policies · @a.DefaultMethod</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Mode" Width="120">
                <Template>
                    @{ var a2 = (BillingAccountRow)context; }
                    <span class="ba-mode-chip ba-m-@a2.BillingMode.ToLower().Replace(" ","-")">@a2.BillingMode</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Balance" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>
                    @{ var a3 = (BillingAccountRow)context; }
                    <span class="@(a3.Balance > 0 ? "ba-bal-due" : "ba-bal-clear")">@a3.Balance.ToString("C2")</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(BillingAccountRow.CreditLimit)" HeaderText="Credit Limit" Format="C2" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
            <GridColumn Field="@nameof(BillingAccountRow.Terms)" HeaderText="Terms" Width="100"></GridColumn>
            <GridColumn HeaderText="Autopay" Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                <Template>
                    @{ var a4 = (BillingAccountRow)context; }
                    @if (a4.AutopayEnrolled) { <span class="ba-autopay-on"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span> }
                    else                     { <span class="ba-autopay-off"><i class="bi bi-circle" aria-hidden="true"></i></span> }
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Status" Width="110">
                <Template>
                    @{ var a5 = (BillingAccountRow)context; }
                    <span class="ba-status-chip ba-st-@a5.Status.ToLower()">@a5.Status</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(BillingAccountRow.LastPaymentDate)" HeaderText="Last Payment" Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
            <GridColumn HeaderText="Actions" Width="100">
                <Template>
                    @{ var a6 = (BillingAccountRow)context; }
                    <div class="ba-row-acts">
                        <button class="um-btn um-btn-primary um-btn-xs" @onclick='() => Nav.NavigateTo($"/billing/accounts/{a6.Id}")' title="Open account">
                            <i class="bi bi-arrow-up-right-square" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => Nav.NavigateTo("/billing/invoices")' title="View invoices">
                            <i class="bi bi-receipt" aria-hidden="true"></i>
                        </button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

@code {
    private SfToast _toast = default!;
    private string _search = "", _filterMode = "", _filterStatus = "", _filterAutopay = "";
    private bool _showCreate;
    private string? _newName, _newMode = "Direct Bill", _newTerms = "Net 30", _newMethod = "ACH";
    private decimal _newCreditLimit = 10000;
    private bool _newAutopay;

    private readonly List<string> _billingModes = ["Direct Bill", "Agency Bill", "EFT"];
    private readonly List<string> _terms        = ["Net 15", "Net 30", "Net 45", "Net 60", "Due on Receipt"];
    private readonly List<string> _methods      = ["ACH", "Credit Card", "Check", "Wire Transfer", "Cash"];

    private List<BillingAccountRow> _accounts =
    [
        new(Guid.NewGuid(), "Acme Corp",               "Direct Bill", 12850.00m, 25000m, "Net 30", "ACH",          true,  "Active",     5, DateTime.Today.AddDays(-3)),
        new(Guid.NewGuid(), "Green Valley LLC",         "Agency Bill",  4200.00m, 15000m, "Net 45", "Check",        false, "Active",     2, DateTime.Today.AddDays(-12)),
        new(Guid.NewGuid(), "Harbor Logistics Inc.",    "Direct Bill",     0.00m, 50000m, "Net 30", "ACH",          true,  "Active",     8, DateTime.Today.AddDays(-1)),
        new(Guid.NewGuid(), "Westside Properties",      "Direct Bill",  7540.00m, 10000m, "Net 15", "Credit Card",  false, "Delinquent", 3, DateTime.Today.AddDays(-47)),
        new(Guid.NewGuid(), "Summit Tech Solutions",    "Agency Bill",  1890.00m, 20000m, "Net 30", "ACH",          true,  "Active",     4, DateTime.Today.AddDays(-8)),
        new(Guid.NewGuid(), "Coastal Restaurants LLC",  "EFT",          9300.00m, 12000m, "Due on Receipt","EFT",  true,  "Delinquent", 1, DateTime.Today.AddDays(-60)),
        new(Guid.NewGuid(), "Pioneer Manufacturing",    "Direct Bill",     0.00m, 75000m, "Net 60", "Wire Transfer",false, "Active",    11, DateTime.Today.AddDays(-5)),
        new(Guid.NewGuid(), "Riverdale Medical Group",  "Agency Bill",  2100.00m, 30000m, "Net 30", "Check",        false, "Suspended",  6, DateTime.Today.AddDays(-90)),
        new(Guid.NewGuid(), "Apex Distribution Co.",   "Direct Bill",     0.00m, 40000m, "Net 45", "ACH",          true,  "Active",     9, DateTime.Today.AddDays(-2)),
        new(Guid.NewGuid(), "Bluewater Marine LLC",    "Direct Bill",  3750.00m, 18000m, "Net 30", "Credit Card",  true,  "Active",     2, DateTime.Today.AddDays(-15)),
    ];

    private IEnumerable<BillingAccountRow> FilteredAccounts => _accounts.Where(a =>
        (string.IsNullOrEmpty(_search)        || a.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterMode)    || a.BillingMode == _filterMode) &&
        (string.IsNullOrEmpty(_filterStatus)  || a.Status == _filterStatus) &&
        (_filterAutopay switch { "yes" => a.AutopayEnrolled, "no" => !a.AutopayEnrolled, _ => true }));

    protected override void OnInitialized() =>
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Billing", ""), new("Accounts", ""));

    void OnRowSelected(RowSelectEventArgs<BillingAccountRow> a) =>
        Nav.NavigateTo($"/billing/accounts/{a.Data.Id}");

    async Task CreateAccountAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        _accounts.Insert(0, new(Guid.NewGuid(), _newName, _newMode!, 0, _newCreditLimit, _newTerms!, _newMethod!, _newAutopay, "Active", 0, null));
        _showCreate = false;
        _newName = null; _newMode = "Direct Bill"; _newTerms = "Net 30"; _newMethod = "ACH"; _newCreditLimit = 10000; _newAutopay = false;
        await _toast.ShowAsync(new ToastModel { Content = "Billing account created.", CssClass = "e-toast-success" });
    }

    static string Fmt(decimal v) => v.ToString("C0");

    record BillingAccountRow(Guid Id, string Name, string BillingMode, decimal Balance, decimal CreditLimit,
                             string Terms, string DefaultMethod, bool AutopayEnrolled, string Status,
                             int PolicyCount, DateTime? LastPaymentDate);
}
