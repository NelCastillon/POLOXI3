    private static string ModeCss(string mode) => $"ba-m-{mode.ToLowerInvariant().Replace(" ", "-")}";
    private static string ModeIconClass(string mode) => mode switch { "Agency Bill" => "ba-di-purple", "EFT" => "ba-di-green", _ => "ba-di-blue" };
