@page "/tasks"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@using Ams.Application.Features.Operations

<PageTitle>Task Board — AMS</PageTitle>

<AppPageHeader Title="Task Board"
               Subtitle="Enterprise command center for agency tasks, workflow routing, service follow-through, and operational execution"
               Icon="bi-kanban">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Task
        </button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
    </Actions>
</AppPageHeader>

<div class="pc-kpi-strip">
    <div class="pc-kpi-card @(_activeFilter == null ? "pc-kpi-card--active" : "")" @onclick="() => SetFilter(null)" title="Show all tasks">
        <span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-kanban-fill"></i></span>
        <div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total Tasks</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "Open" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Open")' title="Filter: Open">
        <span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-play-circle-fill"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Open")</div><div class="pc-kpi-label">Open</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "Overdue" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Overdue")' title="Filter: Overdue">
        <span class="pc-kpi-icon pc-kpi-icon--danger"><i class="bi bi-alarm-fill"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(IsOverdue)</div><div class="pc-kpi-label">Overdue</div></div>
    </div>
    <div class="pc-kpi-card @(_activeFilter == "Completed" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Completed")' title="Filter: Completed">
        <span class="pc-kpi-icon pc-kpi-icon--success"><i class="bi bi-check-circle-fill"></i></span>
        <div><div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Completed")</div><div class="pc-kpi-label">Completed</div></div>
    </div>
</div>

<AppFilterPanel @bind-SearchValue="_search" OnSearch="OnSearchAsync" SearchPlaceholder="Search tasks, task number, type, description…" />

@if (_loadError is not null)
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

<section class="ops-layout">
    <div class="ops-board" aria-label="Task kanban board">
        @foreach (var lane in _lanes)
        {
            var laneItems = _filtered.Where(x => x.StageCode == lane.Key).ToList();
            <article class="ops-lane">
                <header class="ops-lane-header"><div><span class="ops-lane-title">@lane.Label</span><span class="ops-lane-subtitle">@lane.Description</span></div><span class="ops-lane-count">@laneItems.Count</span></header>
                <div class="ops-lane-list">
                    @if (_loading)
                    {
                        <div class="ops-empty-mini">Loading…</div>
                    }
                    else if (laneItems.Count == 0)
                    {
                        <div class="ops-empty-mini">No visible tasks.</div>
                    }
                    else
                    {
                        @foreach (var item in laneItems)
                        {
                            <button class="ops-work-card @(IsOverdue(item) ? "ops-work-card--risk" : "")" @onclick="() => SelectItem(item)">
                                <div class="ops-work-topline"><span class="ops-work-type">@item.TaskTypeCode</span><span class="ops-priority @PriorityCss(item.PriorityCode)">@item.PriorityCode</span></div>
                                <strong>@item.Title</strong>
                                <p>@item.TaskNumber</p>
                                <div class="ops-work-meta"><span><i class="bi bi-diagram-3"></i> @item.RelatedEntityName</span><span class="@(IsOverdue(item) ? "ops-danger-text" : "")"><i class="bi bi-calendar3"></i> @(item.DueDate?.ToString("MMM d") ?? "No due date")</span></div>
                            </button>
                        }
                    }
                </div>
            </article>
        }
    </div>

    <aside class="ops-side-panel" aria-label="Selected task details">
        @if (_selected is null)
        {
            <div class="ops-side-empty"><i class="bi bi-kanban"></i><h3>Select a task</h3><p>Open a task card to review ownership, due date, status, and related workflow context.</p></div>
        }
        else
        {
            <div class="ops-detail-header"><span class="ops-work-type">@_selected.TaskTypeCode</span><button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null"><i class="bi bi-x-lg"></i></button></div>
            <h3>@_selected.Title</h3>
            <p>@_selected.Description</p>
            <dl class="ops-detail-list">
                <div><dt>Task #</dt><dd>@_selected.TaskNumber</dd></div>
                <div><dt>Stage</dt><dd>@_selected.StageCode</dd></div>
                <div><dt>Status</dt><dd>@_selected.StatusCode</dd></div>
                <div><dt>Priority</dt><dd>@_selected.PriorityCode</dd></div>
                <div><dt>Due</dt><dd class="@(IsOverdue(_selected) ? "ops-danger-text" : "")">@(_selected.DueDate?.ToString("MMM d, yyyy") ?? "Not set")</dd></div>
            </dl>
            <div class="ops-detail-actions">
                <button class="um-btn um-btn-primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil"></i> Edit</button>
                <button class="um-btn um-btn-ghost" @onclick="() => ToggleCompleteAsync(_selected)"><i class="bi bi-check2-circle"></i> @(_selected.StatusCode == "Completed" ? "Reopen" : "Complete")</button>
            </div>
        }
    </aside>
</section>

<section class="ops-module-grid" aria-label="Tasks and workflows modules">
    @foreach (var module in _modules)
    {
        <button class="ops-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
            <span class="ops-module-icon"><i class="bi @module.Icon"></i></span><span class="ops-module-content"><strong>@module.Title</strong><small>@module.Description</small></span><i class="bi bi-chevron-right ops-module-arrow"></i>
        </button>
    }
</section>

<SfDialog @bind-Visible="_showForm" Width="640px" IsModal="true" ShowCloseIcon="false">
    <DialogEvents Closed="ResetForm" />
    <DialogContent>
        <div class="um-modal-header"><i class="bi bi-kanban"></i><span>@(_editId.HasValue ? "Edit Task" : "New Task")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field"><label>Task # <span class="text-danger">*</span></label><InputText @bind-Value="_form.TaskNumber" class="um-input" disabled="@_editId.HasValue" /><ValidationMessage For="() => _form.TaskNumber" class="text-danger" /></div>
                <div class="um-field"><label>Title <span class="text-danger">*</span></label><InputText @bind-Value="_form.Title" class="um-input" /><ValidationMessage For="() => _form.Title" class="text-danger" /></div>
                <div class="um-field"><label>Type <span class="text-danger">*</span></label><InputText @bind-Value="_form.TaskTypeCode" class="um-input" /><ValidationMessage For="() => _form.TaskTypeCode" class="text-danger" /></div>
                <div class="um-field"><label>Stage <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StageCode" class="um-input"><option>Intake</option><option>In Progress</option><option>Review</option><option>Approval</option><option>Done</option></InputSelect><ValidationMessage For="() => _form.StageCode" class="text-danger" /></div>
                <div class="um-field"><label>Priority <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.PriorityCode" class="um-input"><option>Low</option><option>Medium</option><option>High</option></InputSelect><ValidationMessage For="() => _form.PriorityCode" class="text-danger" /></div>
                <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input"><option>Open</option><option>Completed</option><option>Blocked</option></InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
                <div class="um-field"><label>Due Date</label><InputDate @bind-Value="_form.DueDate" class="um-input" /><ValidationMessage For="() => _form.DueDate" class="text-danger" /></div>
                <div class="um-field"><label>Related Entity</label><InputText @bind-Value="_form.RelatedEntityName" class="um-input" /><ValidationMessage For="() => _form.RelatedEntityName" class="text-danger" /></div>
                <div class="um-field um-field--full"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="3" /><ValidationMessage For="() => _form.Description" class="text-danger" /></div>
            </div></div>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Save</button></div>
        </EditForm>
    </DialogContent>
</SfDialog>

<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />

<style>@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }</style>

@code {
    static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    List<TaskItemDto> _items = [], _filtered = [];
    string _search = string.Empty;
    string? _activeFilter, _loadError;
    bool _loading, _saving, _showForm;
    Guid? _editId;
    TaskItemDto? _selected;
    SfToast _toast = default!;
    TaskFormModel _form = new();

    readonly Lane[] _lanes = [new("Intake", "Intake", "New work and triage"), new("In Progress", "In Progress", "Active execution"), new("Review", "Review", "Quality and service checks"), new("Approval", "Approval", "Workflow decisions"), new("Done", "Done", "Completed work")];
    readonly ModuleLink[] _modules = [new("Agreements", "Manage agreement lifecycle and customer commitments.", "/agreements", "bi-file-earmark-check"), new("Engagements", "Track active customer engagements and delivery status.", "/engagements", "bi-briefcase"), new("Milestones", "Monitor operational milestones and due dates.", "/ops/milestones", "bi-flag"), new("Amendments", "Review agreement amendments and changes.", "/ops/amendments", "bi-pencil-square"), new("Issue Tracker", "Resolve service issues by severity and SLA risk.", "/ops/issues", "bi-bug"), new("Service Requests", "Route and resolve client service requests.", "/ops/service-requests", "bi-tools"), new("Activity History", "Audit operational activity and timeline events.", "/ops/activities", "bi-clock-history"), new("Workflow Canvas", "Approve, reject, return, and track workflow instances.", "/workflow", "bi-diagram-3")];

    protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tasks & Workflows", "/tasks")); await LoadAsync(); }
    async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchTaskItemsAsync(TenantId, _search, pageSize: 200); _items = result?.Items.ToList() ?? []; ApplyFilter(); _selected ??= _filtered.FirstOrDefault(); } catch (Exception ex) { _loadError = $"Failed to load tasks: {ex.Message}"; } finally { _loading = false; } }
    Task OnSearchAsync() => LoadAsync();
    void ApplyFilter() => _filtered = _activeFilter switch { "Open" => _items.Where(x => x.StatusCode == "Open").ToList(), "Overdue" => _items.Where(IsOverdue).ToList(), "Completed" => _items.Where(x => x.StatusCode == "Completed").ToList(), _ => [.. _items] };
    void SetFilter(string? key) { _activeFilter = key; ApplyFilter(); }
    void SelectItem(TaskItemDto item) => _selected = item;
    void OpenCreate() { _editId = null; _form = new() { TaskNumber = $"TASK-{DateTime.UtcNow:yyyyMMddHHmmss}" }; _showForm = true; }
    void OpenEdit(TaskItemDto item) { _editId = item.TaskItemId; _form = new() { TaskNumber = item.TaskNumber, Title = item.Title, Description = item.Description, TaskTypeCode = item.TaskTypeCode, StageCode = item.StageCode, PriorityCode = item.PriorityCode, StatusCode = item.StatusCode, RelatedEntityName = item.RelatedEntityName, DueDate = item.DueDate }; _showForm = true; }
    async Task SaveAsync() { _saving = true; try { if (_editId.HasValue) await Api.UpdateTaskItemAsync(_editId.Value, new() { Title = _form.Title, Description = _form.Description, TaskTypeCode = _form.TaskTypeCode, StageCode = _form.StageCode, PriorityCode = _form.PriorityCode, StatusCode = _form.StatusCode, DueDate = _form.DueDate, CompletedDate = _form.StatusCode == "Completed" ? DateOnly.FromDateTime(DateTime.Today) : null }); else await Api.CreateTaskItemAsync(new() { TenantId = TenantId, TaskNumber = _form.TaskNumber, Title = _form.Title, Description = _form.Description, TaskTypeCode = _form.TaskTypeCode, StageCode = _form.StageCode, PriorityCode = _form.PriorityCode, StatusCode = _form.StatusCode, RelatedEntityName = _form.RelatedEntityName, DueDate = _form.DueDate }); _showForm = false; await _toast.ShowAsync(new() { Content = "Task saved", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } }
    async Task ToggleCompleteAsync(TaskItemDto item) { item.StatusCode = item.StatusCode == "Completed" ? "Open" : "Completed"; item.StageCode = item.StatusCode == "Completed" ? "Done" : "In Progress"; await Api.UpdateTaskItemAsync(item.TaskItemId, new() { Title = item.Title, Description = item.Description, TaskTypeCode = item.TaskTypeCode, StageCode = item.StageCode, PriorityCode = item.PriorityCode, StatusCode = item.StatusCode, AssignedToUserId = item.AssignedToUserId, DueDate = item.DueDate, CompletedDate = item.StatusCode == "Completed" ? DateOnly.FromDateTime(DateTime.Today) : null }); await LoadAsync(); }
    void ResetForm() => _form = new();
    static bool IsOverdue(TaskItemDto item) => item.StatusCode != "Completed" && item.DueDate.HasValue && item.DueDate.Value < DateOnly.FromDateTime(DateTime.Today);
    static string PriorityCss(string priority) => priority == "High" ? "ops-priority-high" : priority == "Low" ? "ops-priority-low" : "ops-priority-medium";
    sealed record Lane(string Key, string Label, string Description);
    sealed record ModuleLink(string Title, string Description, string Url, string Icon);
    sealed class TaskFormModel { [Required, StringLength(50)] public string TaskNumber { get; set; } = string.Empty; [Required, StringLength(200)] public string Title { get; set; } = string.Empty; [StringLength(2000)] public string? Description { get; set; } [Required, StringLength(50)] public string TaskTypeCode { get; set; } = "Task"; [Required, StringLength(50)] public string StageCode { get; set; } = "Intake"; [Required, StringLength(50)] public string PriorityCode { get; set; } = "Medium"; [Required, StringLength(50)] public string StatusCode { get; set; } = "Open"; [StringLength(100)] public string? RelatedEntityName { get; set; } public DateOnly? DueDate { get; set; } }
}
