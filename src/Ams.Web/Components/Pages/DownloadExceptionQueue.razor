@page "/integrations/download-exceptions"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Integrations
@using Ams.Web.Services
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav

<PageTitle>Download Exception Queue - AMS</PageTitle>

<EnterpriseToast @ref="_toastRef" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<AppPageHeader Title="Download Exception Queue"
               Subtitle="Carrier download records that could not be automatically matched or applied - resolve, retry, or route for review"
               Icon="bi-exclamation-triangle-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='()=>Nav.NavigateTo("/automation/job-scheduler")'><i class="bi bi-clock-history" aria-hidden="true"></i> Job Scheduler</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-primary" @onclick="BulkResolveAsync" disabled="@(!_selected.Any())"><i class="bi bi-check2-all" aria-hidden="true"></i> Resolve Selected (@_selected.Count)</button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
        @_loadError
    </div>
}

<div class="deq-filter-bar">
    <div class="deq-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="deq-search" placeholder="Search carrier, policy, insured, reason..." @bind="_search" @bind:event="oninput" />
    </div>
    <select class="deq-sel" @bind="_reasonFilter">
        <option value="">All Reasons</option>
        @foreach (var reason in _exceptions.Select(e => e.ExceptionType).Distinct().OrderBy(x => x))
        {
            <option value="@reason">@reason</option>
        }
    </select>
    <select class="deq-sel" @bind="_priorityFilter">
        <option value="">All Priorities</option>
        <option value="High">High</option>
        <option value="Medium">Medium</option>
        <option value="Low">Low</option>
    </select>
</div>

<div class="deq-count-bar"><span>@Filtered.Count() exceptions</span> <span class="deq-cnt-sel">@_selected.Count selected</span></div>

@if (_loading)
{
    <div class="deq-empty"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><strong>Loading carrier download exceptions...</strong><span>Reading seeded DB records from the Integration carrier download tables.</span></div>
}
else if (!Filtered.Any())
{
    <div class="deq-empty"><i class="bi bi-shield-check" aria-hidden="true"></i><strong>No carrier download exceptions match this view</strong><span>Adjust filters or wait for the worker to route low-confidence download items.</span></div>
}
else
{
    @foreach (var ex in Filtered)
    {
        var isSel = _selected.Contains(ex.DownloadExceptionId);
        <div class="deq-card @PriorityBorderCss(ex.Severity) @(isSel ? "deq-sel" : "")">
            <div class="deq-card-hdr">
                <input type="checkbox" class="deq-chk" checked="@isSel" @onchange="() => ToggleSel(ex.DownloadExceptionId)" title="Select" />
                <div class="deq-reason-icon @ReasonIconCss(ex.ExceptionType)"><i class="bi bi-@ReasonIcon(ex.ExceptionType)" aria-hidden="true"></i></div>
                <div class="deq-card-main">
                    <div class="deq-card-title">@ex.CarrierName - @(ex.CarrierPolicyNumber ?? "No policy #") <span class="deq-tx-type">@ex.TransactionType</span></div>
                    <div class="deq-card-reason">@ex.Message</div>
                </div>
                <span class="@PriorityBadge(ex.Severity)">@ex.Severity</span>
                <div class="deq-card-time">@FormatAge(ex.OccurredUtc)</div>
            </div>
            <div class="deq-card-body">
                <div class="deq-meta">
                    <div class="deq-m-item"><span class="deq-ml">Premium</span><span class="deq-mv">@FormatMoney(ex.Premium)</span></div>
                    <div class="deq-m-item"><span class="deq-ml">Eff. Date</span><span class="deq-mv">@(ex.EffectiveDate?.ToString("MMM d") ?? "-")</span></div>
                    <div class="deq-m-item"><span class="deq-ml">Insured</span><span class="deq-mv">@(ex.NamedInsured ?? "Unknown")</span></div>
                    <div class="deq-m-item"><span class="deq-ml">Status</span><span class="deq-mv">@ex.ResolutionStatus</span></div>
                </div>
                <div class="deq-actions">
                    <button class="um-btn um-btn-primary um-btn-xs" @onclick="() => ResolveOneAsync(ex)"><i class="bi bi-check2" aria-hidden="true"></i> Resolve</button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => RetryOneAsync(ex)"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Retry</button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _selectedDetail = _selectedDetail == ex.DownloadExceptionId ? null : ex.DownloadExceptionId"><i class="bi bi-braces" aria-hidden="true"></i> Raw Payload</button>
                </div>
                @if (_selectedDetail == ex.DownloadExceptionId)
                {
                    <pre class="deq-raw">@(string.IsNullOrWhiteSpace(ex.RawPayload) ? "No raw payload captured." : ex.RawPayload)</pre>
                }
            </div>
        </div>
    }
}

<style>
    @@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }
    .deq-empty { border: 1px dashed #d7deea; border-radius: 1rem; padding: 2.5rem; text-align: center; color: #64748b; background: #f8fafc; display: grid; gap: .4rem; }
    .deq-empty i { font-size: 2rem; color: #94a3b8; }
    .deq-raw { background: #0f172a; color: #dbeafe; border-radius: .75rem; padding: .85rem; margin-top: .75rem; max-height: 18rem; overflow: auto; font-size: .8rem; }
</style>

@code {
    private EnterpriseToast? _toastRef;
    private Guid _tenantId;
    private Guid _currentUserId;
    private bool _loading;
    private string? _loadError;
    private string _search = string.Empty;
    private string _reasonFilter = string.Empty;
    private string _priorityFilter = string.Empty;
    private HashSet<Guid> _selected = [];
    private Guid? _selectedDetail;
    private List<DownloadExceptionDto> _exceptions = [];

    private IEnumerable<DownloadExceptionDto> Filtered => _exceptions.Where(e =>
        (string.IsNullOrWhiteSpace(_search) || (e.CarrierPolicyNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) || e.CarrierName.Contains(_search, StringComparison.OrdinalIgnoreCase) || (e.NamedInsured?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) || e.Message.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_reasonFilter) || e.ExceptionType.Equals(_reasonFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_priorityFilter) || e.Severity.Equals(_priorityFilter, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _currentUserId = context.UserId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Integrations", "/integrations"), new("Exception Queue", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchDownloadExceptionsAsync(_tenantId, null, 1, 250);
            _exceptions = result?.Items.Where(e => !e.ResolutionStatus.Equals("Resolved", StringComparison.OrdinalIgnoreCase)).ToList() ?? [];
            _selected.RemoveWhere(id => _exceptions.All(e => e.DownloadExceptionId != id));
        }
        catch (Exception ex)
        {
            _loadError = $"Load failed: {ex.Message}";
            if (_toastRef is not null) await _toastRef.ShowAsync(new ToastModel { Content = _loadError, CssClass = "enterprise-toast-danger" });
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleSel(Guid id)
    {
        if (!_selected.Remove(id)) _selected.Add(id);
    }

    private async Task ResolveOneAsync(DownloadExceptionDto ex)
    {
        try
        {
            await Api.ResolveDownloadExceptionAsync(ex.DownloadExceptionId, new ResolveDownloadExceptionRequest(_currentUserId, "Resolved from carrier download exception queue after review."));
            _exceptions.Remove(ex);
            _selected.Remove(ex.DownloadExceptionId);
            if (_toastRef is not null) await _toastRef.ShowAsync(new ToastModel { Content = $"{ex.CarrierPolicyNumber ?? ex.NamedInsured ?? ex.ExceptionType} resolved.", CssClass = "enterprise-toast-success" });
        }
        catch (Exception err)
        {
            if (_toastRef is not null) await _toastRef.ShowAsync(new ToastModel { Content = $"Resolve failed: {err.Message}", CssClass = "enterprise-toast-danger" });
        }
    }

    private async Task RetryOneAsync(DownloadExceptionDto ex)
    {
        try
        {
            await Api.RetryDownloadExceptionAsync(ex.DownloadExceptionId);
            ex.ResolutionStatus = "Retrying";
            if (_toastRef is not null) await _toastRef.ShowAsync(new ToastModel { Content = $"{ex.CarrierPolicyNumber ?? ex.NamedInsured ?? ex.ExceptionType} queued for retry.", CssClass = "enterprise-toast-info" });
        }
        catch (Exception err)
        {
            if (_toastRef is not null) await _toastRef.ShowAsync(new ToastModel { Content = $"Retry failed: {err.Message}", CssClass = "enterprise-toast-danger" });
        }
    }

    private async Task BulkResolveAsync()
    {
        var targets = _exceptions.Where(e => _selected.Contains(e.DownloadExceptionId)).ToList();
        foreach (var ex in targets)
        {
            await ResolveOneAsync(ex);
        }
    }

    private static string FormatMoney(decimal? value) => value.HasValue ? value.Value.ToString("C0") : "-";

    private static string FormatAge(DateTime value)
    {
        var span = DateTime.UtcNow - value;
        if (span.TotalMinutes < 60) return $"{Math.Max(1, (int)span.TotalMinutes)} min ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} hr ago";
        return $"{(int)span.TotalDays} days ago";
    }

    private static string ReasonIcon(string code) => code switch
    {
        var c when c.Contains("not found", StringComparison.OrdinalIgnoreCase) => "person-x",
        var c when c.Contains("Duplicate", StringComparison.OrdinalIgnoreCase) => "copy",
        var c when c.Contains("credential", StringComparison.OrdinalIgnoreCase) => "shield-x",
        var c when c.Contains("LOB", StringComparison.OrdinalIgnoreCase) || c.Contains("Invalid", StringComparison.OrdinalIgnoreCase) => "file-earmark-x",
        _ => "question-circle"
    };

    private static string ReasonIconCss(string code) => code switch
    {
        var c when c.Contains("credential", StringComparison.OrdinalIgnoreCase) || c.Contains("not found", StringComparison.OrdinalIgnoreCase) => "deq-ri-red",
        var c when c.Contains("Duplicate", StringComparison.OrdinalIgnoreCase) => "deq-ri-blue",
        _ => "deq-ri-amber"
    };

    private static string PriorityBorderCss(string p) => p switch { "High" => "deq-p-high", "Medium" => "deq-p-med", _ => "" };
    private static string PriorityBadge(string p) => p switch { "High" => "deq-pri deq-pri--hi", "Medium" => "deq-pri deq-pri--med", _ => "deq-pri deq-pri--low" };
}
