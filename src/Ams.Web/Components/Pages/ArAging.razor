@page "/billing/ar-aging"
@inject ApiClient Api

<PageTitle>AR Aging</PageTitle>
<h1>AR Aging Snapshots</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(ArAgingSnapshotDto.SnapshotDate)"    HeaderText="Date"      Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(ArAgingSnapshotDto.CurrentAmount)"   HeaderText="Current"   Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(ArAgingSnapshotDto.Days30Amount)"    HeaderText="1–30 Days" Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(ArAgingSnapshotDto.Days60Amount)"    HeaderText="31–60 Days" Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(ArAgingSnapshotDto.Days90Amount)"    HeaderText="61–90 Days" Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(ArAgingSnapshotDto.Days90PlusAmount)" HeaderText="90+ Days" Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(ArAgingSnapshotDto.TotalOutstanding)" HeaderText="Total"    Width="130" Format="C2"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<ArAgingSnapshotDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchArAgingSnapshotsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
