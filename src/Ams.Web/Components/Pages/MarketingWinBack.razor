    private static string Initials(string n) { var parts = n.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant() : n.Length > 0 ? n[..1].ToUpperInvariant() : "?"; }
    private static string StatusCss(string status) => $"mkw-st-{status.ToLowerInvariant()}";
    private static string Csv(string value) { var quote = Convert.ToChar(34).ToString(); return string.Concat(quote, value.Replace(quote, quote + quote), quote); }
    private static string Bold(string value) => $"<strong>{value}</strong>";
    private static ActionConfiguration CreateDefaultConfiguration(MarketingWinBackDto? item, ConfirmAction action) => action switch
    {
        ConfirmAction.Contact => new() { ExecutionMode = "PhoneCall", NextStatus = "Contacted", NotifyProducer = true, RefreshAfterAction = true },
        ConfirmAction.Reactivate => new() { ExecutionMode = "PhoneCall", NextStatus = "Reactivated", NotifyProducer = true, RefreshAfterAction = true },
        ConfirmAction.Lost => new() { ExecutionMode = "PhoneCall", NextStatus = "Lost", NotifyProducer = true, RefreshAfterAction = true },
        ConfirmAction.Duplicate => new() { NewName = item is null ? string.Empty : $"{item.AccountName} Copy", NextStatus = "New", RefreshAfterAction = true },
        ConfirmAction.Archive => new() { Reason = "No longer actionable", ExportBeforeAction = false, RefreshAfterAction = true },
        ConfirmAction.Sync => new() { ExecutionMode = "MissingOnly", RefreshAfterAction = true },
        ConfirmAction.Export => new() { ExecutionMode = "Filtered", IncludeReason = true, RefreshAfterAction = false },
        _ => new()
    };
