@page "/marketing/win-back"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Win-Back Campaigns — AMS</PageTitle>

<AppPageHeader Title="Win-Back Campaigns"
               Subtitle="Recover lapsed policyholders with targeted reactivation outreach and competitive offers"
               Icon="bi-arrow-repeat">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/marketing/campaigns/new")'>
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Win-Back Campaign
        </button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}

<!-- KPI -->
<div class="mkw-kpi-strip">
    <div class="mkw-kpi-card"><i class="bi bi-arrow-repeat mkw-ki mkw-ki-blue"></i><div><div class="mkw-kv">@_lapsed.Count</div><div class="mkw-kl">Lapsed Accounts</div></div></div>
    <div class="mkw-kpi-card"><i class="bi bi-cash-stack mkw-ki mkw-ki-green"></i><div><div class="mkw-kv">@_lapsed.Sum(l => l.LastPremium).ToString("C0")</div><div class="mkw-kl">Lost Premium</div></div></div>
    <div class="mkw-kpi-card"><i class="bi bi-trophy mkw-ki mkw-ki-green"></i><div><div class="mkw-kv">@_lapsed.Count(l => l.Status == "Reactivated")</div><div class="mkw-kl">Reactivated</div></div></div>
    <div class="mkw-kpi-card"><i class="bi bi-envelope-check mkw-ki mkw-ki-amber"></i><div><div class="mkw-kv">@_lapsed.Count(l => l.Status == "Contacted")</div><div class="mkw-kl">Contacted</div></div></div>
    <div class="mkw-kpi-card"><i class="bi bi-percent mkw-ki mkw-ki-blue"></i><div><div class="mkw-kv">@(_lapsed.Any() ? (_lapsed.Count(l => l.Status == "Reactivated") * 100m / _lapsed.Count).ToString("N1") : "0.0")%</div><div class="mkw-kl">Recovery Rate</div></div></div>
</div>

<!-- Filters -->
<div class="mkw-filter-bar">
    <select class="mkw-sel" @bind="_filterWindow">
        <option value="">All Lapse Periods</option>
        <option value="30–60">30–60 Days</option>
        <option value="60–90">60–90 Days</option>
        <option value="90–180">90–180 Days</option>
        <option value="180+">180+ Days</option>
    </select>
    <select class="mkw-sel" @bind="_filterStatus">
        <option value="">All Statuses</option>
        <option value="New">New</option>
        <option value="Contacted">Contacted</option>
        <option value="Interested">Interested</option>
        <option value="Reactivated">Reactivated</option>
        <option value="Lost">Lost</option>
    </select>
</div>

<!-- Grid -->
<div class="mkw-grid-card app-datagrid">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading win-back accounts…</span></div> }
    <SfGrid CssClass="marketing-grid" TValue="LapsedRow" DataSource="Filtered" AllowPaging="true" AllowSorting="true" AllowFiltering="true"
            AllowTextWrap="true" EnableHover="true" RowHeight="64">
        <GridTextWrapSettings WrapMode="WrapMode.Content" />
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
        <GridPageSettings PageSize="20" />
        <GridColumns>
            <GridColumn HeaderText="Account" MinWidth="320" Field="@nameof(LapsedRow.AccountName)">
                <Template>
                    @{ var l = (LapsedRow)context; }
                    <div class="mkw-name-cell">
                        <div class="mkw-av">@l.AccountName[0]</div>
                        <div>
                            <div class="mkw-item-name">@l.AccountName</div>
                            <div class="mkw-item-sub">@l.PolicyType</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(LapsedRow.LapseDate)" HeaderText="Lapsed" Width="120" Type="ColumnType.Date" Format="MMM d, yyyy" />
            <GridColumn Field="@nameof(LapsedRow.DaysLapsed)" HeaderText="Days" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
            <GridColumn Field="@nameof(LapsedRow.LastPremium)" HeaderText="Last Premium" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>@{ var l = (LapsedRow)context; }<span class="mkw-mono">@l.LastPremium.ToString("C0")</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(LapsedRow.Status)" HeaderText="Status" Width="120">
                <Template>@{ var l = (LapsedRow)context; }<span class="@WbStatusBadge(l.Status)">@l.Status</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(LapsedRow.LapseReason)" HeaderText="Reason" Width="190" />
            <GridColumn HeaderText="Actions" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>
                    @{ var l = (LapsedRow)context; }
                    <div style="display:flex;gap:.3rem;justify-content:flex-end">
                        <button class="um-btn um-btn-primary um-btn-xs" @onclick:stopPropagation="true" @onclick='() => UpdateStatusAsync(l, "Contacted")'><i class="bi bi-telephone" aria-hidden="true"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick='() => Nav.NavigateTo("/marketing/campaigns/new?goal=Win-Back")'><i class="bi bi-envelope" aria-hidden="true"></i></button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string _filterWindow = "", _filterStatus = "";
    private bool _loading;
    private string? _loadError;
    private List<LapsedRow> _lapsed = [];

    private IEnumerable<LapsedRow> Filtered => _lapsed.Where(l =>
        (string.IsNullOrEmpty(_filterStatus) || l.Status == _filterStatus) &&
        (string.IsNullOrEmpty(_filterWindow) || l.LapseWindow == _filterWindow));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Marketing","/marketing/campaigns"), new("Win-Back",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try
        {
            var result = await Api.SearchMarketingWinBackAsync(_tenantId);
            _lapsed = result?.Items.Select(x => new LapsedRow(x.WinBackId, x.AccountName, x.PolicyType, x.LapseDate, x.DaysLapsed, x.LastPremium, x.LapseReason, x.StatusCode, x.LapseWindow)).ToList() ?? [];
        }
        catch (Exception ex) { _loadError = $"Failed to load win-back data: {ex.Message}"; _lapsed = []; }
        finally { _loading = false; }
    }

    private static string WbStatusBadge(string s) => s switch
    {
        "Reactivated" => "mkw-status mkw-st--react",
        "Interested"  => "mkw-status mkw-st--int",
        "Contacted"   => "mkw-status mkw-st--cont",
        "Lost"        => "mkw-status mkw-st--lost",
        _             => "mkw-status mkw-st--new",
    };

    private async Task UpdateStatusAsync(LapsedRow row, string status)
    {
        try
        {
            await Api.UpdateMarketingWinBackStatusAsync(row.Id, status);
            await LoadAsync();
        }
        catch (Exception ex) { _loadError = $"Update failed: {ex.Message}"; }
    }

    private sealed record LapsedRow(Guid Id, string AccountName, string PolicyType, DateTime LapseDate, int DaysLapsed,
        decimal LastPremium, string LapseReason, string Status, string LapseWindow);

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
