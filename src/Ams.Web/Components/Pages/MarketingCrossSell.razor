@page "/marketing/cross-sell"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject ConfirmationDialogService Confirmations

<PageTitle>Cross-Sell Opportunities — AMS</PageTitle>

<AppPageHeader Title="Cross-Sell Opportunities"
               Subtitle="AI-scored opportunities to expand coverage and grow revenue across your book of business"
               Icon="bi-arrows-expand">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/marketing/rules-engine")'>
            <i class="bi bi-lightning-charge" aria-hidden="true"></i> Rules Engine
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/marketing/campaigns/new")'>
            <i class="bi bi-megaphone" aria-hidden="true"></i> Launch Campaign
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI -->
<div class="mkx-kpi-strip">
    <div class="mkx-kpi-card mkx-kpi-blue">
        <i class="bi bi-arrows-expand" aria-hidden="true"></i>
        <div><div class="mkx-kv">@_opportunities.Count</div><div class="mkx-kl">Open Opportunities</div></div>
    </div>
    <div class="mkx-kpi-card mkx-kpi-green">
        <i class="bi bi-cash-stack" aria-hidden="true"></i>
        <div><div class="mkx-kv">@_opportunities.Sum(o => o.EstimatedPremium).ToString("C0")</div><div class="mkx-kl">Est. Premium Pipeline</div></div>
    </div>
    <div class="mkx-kpi-card mkx-kpi-amber">
        <i class="bi bi-bullseye" aria-hidden="true"></i>
        <div><div class="mkx-kv">@(_opportunities.Any() ? _opportunities.Average(o => o.Score).ToString("N0") : "0")</div><div class="mkx-kl">Avg. Propensity Score</div></div>
    </div>
    <div class="mkx-kpi-card mkx-kpi-green">
        <i class="bi bi-trophy" aria-hidden="true"></i>
        <div><div class="mkx-kv">@_opportunities.Count(o => o.Score >= 80)</div><div class="mkx-kl">High Priority</div></div>
    </div>
</div>

<!-- Opportunity table -->
<div class="mkx-grid-card app-datagrid">
    <SfGrid CssClass="marketing-grid" TValue="XsellOpp" DataSource="_opportunities" AllowPaging="true" AllowSorting="true" AllowFiltering="true"
            AllowTextWrap="true" EnableHover="true" RowHeight="64">
        <GridTextWrapSettings WrapMode="WrapMode.Content" />
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
        <GridPageSettings PageSize="20" />
        <GridColumns>
            <GridColumn HeaderText="Account" MinWidth="320" Field="@nameof(XsellOpp.AccountName)">
                <Template>
                    @{ var o = (XsellOpp)context; }
                    <div class="mkx-name-cell">
                        <div class="mkx-av">@Initials(o.AccountName)</div>
                        <div>
                            <div class="mkx-item-name">@o.AccountName</div>
                            <div class="mkx-item-sub">@o.AccountType · @o.Producer</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(XsellOpp.OpportunityType)" HeaderText="Opportunity" Width="180">
                <Template>@{ var o = (XsellOpp)context; }<span class="mkx-opp-type @OppCss(o.OpportunityType)">@o.OpportunityType</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(XsellOpp.Score)" HeaderText="Score" Width="110" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>
                    @{ var o = (XsellOpp)context; }
                    <div class="mkx-score-wrap">
                        <div class="mkx-score-bar" style="width:@(o.Score)%"></div>
                        <span class="mkx-score-val @ScoreCss(o.Score)">@o.Score</span>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(XsellOpp.EstimatedPremium)" HeaderText="Est. Premium" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>@{ var o = (XsellOpp)context; }<span class="mkx-mono mkx-bold">@o.EstimatedPremium.ToString("C0")</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(XsellOpp.Trigger)" HeaderText="Trigger Signal" Width="240" />
            <GridColumn Field="@nameof(XsellOpp.LastContact)" HeaderText="Last Contact" Width="120" Type="ColumnType.Date" Format="MMM d, yyyy" />
            <GridColumn HeaderText="Action" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>
                    @{ var o = (XsellOpp)context; }
                    <div style="display:flex;gap:.3rem;justify-content:flex-end">
                        <button class="um-btn um-btn-primary um-btn-xs" title="Contact">
                            <i class="bi bi-telephone" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-ghost um-btn-xs" title="Dismiss" @onclick="() => DismissOpportunityAsync(o)">
                            <i class="bi bi-x" aria-hidden="true"></i>
                        </button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

@code {
    private List<XsellOpp> _opportunities = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Marketing","/marketing/campaigns"), new("Cross-Sell",""));
        _opportunities =
        [
            new("Riverside Construction LLC", "Commercial", "Beth Nguyen", "Missing Umbrella",           94, 4_200m, "Payroll > $500k, no umbrella",              new DateTime(2025,3,1)),
            new("Harmon Family",              "Personal",   "Jake Park",   "Home + Auto Bundle",          88, 1_800m, "2 separate carriers, bundling discount",   new DateTime(2025,2,15)),
            new("Summit Roofing Inc",         "Commercial", "Beth Nguyen", "Workers Comp Expansion",      85, 6_400m, "Added 4 employees, no WC update",          new DateTime(2025,3,10)),
            new("Delgado Household",          "Personal",   "Sara Kim",    "Teen Driver Add-On",          81, 950m,   "Driver DOB 2007, not listed",              new DateTime(2025,2,28)),
            new("BlueSky Café Group",         "Commercial", "Jake Park",   "Business Package Expansion",  79, 3_100m, "No BOP, liquor liability gap",             new DateTime(2025,1,20)),
            new("Tanaka Medical Group",       "Commercial", "Sara Kim",    "Benefits Upsell",             76, 12_000m,"Enrolled 22 employees, no dental/vision",  new DateTime(2025,3,5)),
            new("Chen Family Trust",          "Personal",   "Beth Nguyen", "Home + Auto Bundle",          72, 1_400m, "Auto renewing, no HO cross-sell offer",    new DateTime(2025,2,10)),
            new("Apex Distribution Inc",      "Commercial", "Jake Park",   "Workers Comp Expansion",      68, 8_900m, "Revenue grew 35%, WC audit pending",       new DateTime(2025,3,12)),
        ];
    }

    private static string Initials(string n) { var p = n.Trim().Split(' '); return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}" : n.Length > 0 ? n[..1] : "?"; }
    private static string OppCss(string t) => t switch
    {
        "Missing Umbrella"         => "mkx-ot mkx-ot--umbrella",
        "Home + Auto Bundle"       => "mkx-ot mkx-ot--bundle",
        "Workers Comp Expansion"   => "mkx-ot mkx-ot--wc",
        "Teen Driver Add-On"       => "mkx-ot mkx-ot--teen",
        "Business Package Expansion" => "mkx-ot mkx-ot--bop",
        "Benefits Upsell"          => "mkx-ot mkx-ot--benefits",
        _                          => "mkx-ot",
    };
    private static string ScoreCss(int s) => s >= 80 ? "mkx-score--high" : s >= 60 ? "mkx-score--med" : "mkx-score--low";

    private async Task DismissOpportunityAsync(XsellOpp opportunity)
    {
        if (!await Confirmations.ConfirmAsync("Dismiss opportunity", $"Dismiss the {opportunity.OpportunityType} opportunity for {opportunity.AccountName}?", "Dismiss")) return;
        _opportunities.Remove(opportunity);
    }

    private sealed record XsellOpp(string AccountName, string AccountType, string Producer, string OpportunityType,
        int Score, decimal EstimatedPremium, string Trigger, DateTime LastContact);
}
