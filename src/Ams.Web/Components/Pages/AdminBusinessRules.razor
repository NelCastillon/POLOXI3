@page "/admin/system/rules"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Business Rules — AMS</PageTitle>

<AppPageHeader Title="Branch / Business Rules"
               Subtitle="Configure platform-wide business rules governing workflows, data validation, and operational logic"
               Icon="bi-node-plus">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="()=>_showCreate=true"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Rule</button>
    </Actions>
</AppPageHeader>

<div class="br-filter-bar">
    <div class="br-search-wrap"><i class="bi bi-search" aria-hidden="true"></i><input class="br-search" placeholder="Search rules…" @bind="_search" @bind:event="oninput" /></div>
    <select class="br-sel" @bind="_catFilter"><option value="">All Categories</option><option value="Policy">Policy</option><option value="Billing">Billing</option><option value="Claims">Claims</option><option value="Compliance">Compliance</option><option value="Workflow">Workflow</option></select>
    <select class="br-sel" @bind="_statusFilter"><option value="">All</option><option value="Active">Active</option><option value="Inactive">Inactive</option><option value="Draft">Draft</option></select>
</div>

<div class="br-table-wrap">
    <SfGrid TValue="BusinessRule" DataSource="Filtered.ToList()" AllowSorting="true" AllowPaging="true" EnableHover="true" RowHeight="54">
        <GridPageSettings PageSize="20" />
        <GridColumns>
            <GridColumn Field="@nameof(BusinessRule.Name)"        HeaderText="Rule Name" MinWidth="180" />
            <GridColumn Field="@nameof(BusinessRule.Category)"    HeaderText="Category" Width="120" />
            <GridColumn Field="@nameof(BusinessRule.Trigger)"     HeaderText="Trigger" Width="180" />
            <GridColumn Field="@nameof(BusinessRule.Priority)"    HeaderText="Priority" Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                <Template>@{ var r=(BusinessRule)context; }<span class="br-pri-badge br-pri-@r.Priority.ToLower()">@r.Priority</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(BusinessRule.Status)"      HeaderText="Status" Width="100">
                <Template>@{ var r=(BusinessRule)context; }<span class="@StatusBadge(r.Status)">@r.Status</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(BusinessRule.LastModified)" HeaderText="Modified" Width="130" />
            <GridColumn HeaderText="" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>@{ var r=(BusinessRule)context; }
                    <div class="br-row-actions">
                        <button class="um-btn um-btn-ghost um-btn-xs" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => ToggleStatus(r)" title="Toggle">
                            <i class="bi bi-@(r.Status=="Active"?"pause":"play")-circle" aria-hidden="true"></i>
                        </button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showCreate" Width="460px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>New Business Rule</Header>
        <Content>
            <div class="br-dlg">
                <label class="br-label">Rule Name</label><input class="br-input" placeholder="e.g. Require prior carrier on new business" />
                <label class="br-label">Category</label>
                <select class="br-input"><option>Policy</option><option>Billing</option><option>Claims</option><option>Compliance</option><option>Workflow</option></select>
                <label class="br-label">Trigger</label>
                <select class="br-input"><option>On record save</option><option>On status change</option><option>On field change</option><option>On schedule</option></select>
                <label class="br-label">Condition (pseudo-code)</label>
                <textarea class="br-input br-ta" placeholder="e.g. policy.type == 'Commercial' AND policy.prior_carrier IS NULL"></textarea>
                <label class="br-label">Action</label>
                <select class="br-input"><option>Block save with message</option><option>Show warning</option><option>Auto-set field</option><option>Create task</option><option>Send notification</option></select>
            </div>
        </Content>
        <FooterTemplate>
            <button class="um-btn um-btn-ghost" @onclick="()=>_showCreate=false">Cancel</button>
            <button class="um-btn um-btn-primary" @onclick="()=>_showCreate=false"><i class="bi bi-check2" aria-hidden="true"></i> Create Rule</button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    private string _search = string.Empty;
    private string _catFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private bool _showCreate;

    private List<BusinessRule> _rules = [];

    private IEnumerable<BusinessRule> Filtered => _rules.Where(r =>
        (string.IsNullOrEmpty(_search) || r.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_catFilter) || r.Category == _catFilter) &&
        (string.IsNullOrEmpty(_statusFilter) || r.Status == _statusFilter));

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Administration","/admin"), new("Business Rules",""));
        _rules =
        [
            new BusinessRule { Id=1,  Name="Require prior carrier for new business",         Category="Policy",     Trigger="On record save",    Priority="High",   Status="Active",   LastModified="Jun 1" },
            new BusinessRule { Id=2,  Name="Block cancellation within active claim",          Category="Policy",     Trigger="On status change",  Priority="High",   Status="Active",   LastModified="May 28" },
            new BusinessRule { Id=3,  Name="Auto-assign CSR based on ZIP code",              Category="Workflow",   Trigger="On record save",    Priority="Medium", Status="Active",   LastModified="May 15" },
            new BusinessRule { Id=4,  Name="Require manager approval for credit > $5,000",   Category="Billing",    Trigger="On status change",  Priority="High",   Status="Active",   LastModified="Apr 10" },
            new BusinessRule { Id=5,  Name="Flag claim if reserve exceeds $100K",            Category="Claims",     Trigger="On field change",   Priority="High",   Status="Active",   LastModified="Mar 22" },
            new BusinessRule { Id=6,  Name="Enforce ACH payment for recurring billing",      Category="Billing",    Trigger="On record save",    Priority="Medium", Status="Active",   LastModified="Mar 5" },
            new BusinessRule { Id=7,  Name="Auto-set renewal owner to current producer",     Category="Workflow",   Trigger="On schedule",       Priority="Low",    Status="Active",   LastModified="Feb 18" },
            new BusinessRule { Id=8,  Name="Require signed ACORD 25 before bind",            Category="Compliance", Trigger="On status change",  Priority="High",   Status="Active",   LastModified="Jan 30" },
            new BusinessRule { Id=9,  Name="Send 60-day payment past due notice",            Category="Billing",    Trigger="On schedule",       Priority="Medium", Status="Inactive", LastModified="Jan 12" },
            new BusinessRule { Id=10, Name="Prevent duplicate policy number across carriers",Category="Policy",   Trigger="On record save",    Priority="High",   Status="Draft",    LastModified="Jun 10" },
        ];
    }

    private static string StatusBadge(string s) => s switch { "Active"=>"br-st br-st--ok","Inactive"=>"br-st br-st--off","Draft"=>"br-st br-st--draft",_=>"br-st" };

    private static void ToggleStatus(BusinessRule r) => r.Status = r.Status == "Active" ? "Inactive" : "Active";

    private sealed class BusinessRule { public int Id{get;set;} public string Name{get;set;}=string.Empty; public string Category{get;set;}=string.Empty; public string Trigger{get;set;}=string.Empty; public string Priority{get;set;}=string.Empty; public string Status{get;set;}=string.Empty; public string LastModified{get;set;}=string.Empty; }
}
