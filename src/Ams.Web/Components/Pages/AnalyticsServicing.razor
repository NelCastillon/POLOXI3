@page "/analytics/service"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>Servicing Analytics — AMS</PageTitle>

<AppPageHeader Title="Servicing Analytics"
               Subtitle="Service request volume, SLA compliance, staff throughput, and client satisfaction metrics"
               Icon="bi-headset">
    <Actions>
        <button class="um-btn um-btn-ghost"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="sv-kpi-strip">
    <div class="sv-kpi-card">
        <div class="sv-kpi-icon sv-ki-blue"><i class="bi bi-inbox" aria-hidden="true"></i></div>
        <div><div class="sv-kv">312</div><div class="sv-kl">Open Requests</div><div class="sv-delta sv-d-up"><i class="bi bi-arrow-up-short" aria-hidden="true"></i> 8% WoW</div></div>
    </div>
    <div class="sv-kpi-card">
        <div class="sv-kpi-icon sv-ki-green"><i class="bi bi-check-circle" aria-hidden="true"></i></div>
        <div><div class="sv-kv">91.4%</div><div class="sv-kl">SLA Compliance</div><div class="sv-delta sv-d-up"><i class="bi bi-arrow-up-short" aria-hidden="true"></i> 2% WoW</div></div>
    </div>
    <div class="sv-kpi-card">
        <div class="sv-kpi-icon sv-ki-amber"><i class="bi bi-stopwatch" aria-hidden="true"></i></div>
        <div><div class="sv-kv">2.4h</div><div class="sv-kl">Avg. Response Time</div><div class="sv-delta sv-d-dn"><i class="bi bi-arrow-down-short" aria-hidden="true"></i> 0.3h vs target</div></div>
    </div>
    <div class="sv-kpi-card">
        <div class="sv-kpi-icon sv-ki-green"><i class="bi bi-emoji-smile" aria-hidden="true"></i></div>
        <div><div class="sv-kv">4.7 / 5</div><div class="sv-kl">Client Satisfaction</div><div class="sv-delta sv-d-up"><i class="bi bi-arrow-up-short" aria-hidden="true"></i> 0.2 vs prior</div></div>
    </div>
    <div class="sv-kpi-card">
        <div class="sv-kpi-icon sv-ki-red"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div>
        <div><div class="sv-kv">14</div><div class="sv-kl">SLA Breaches (MTD)</div><div class="sv-delta sv-d-dn"><i class="bi bi-arrow-down-short" aria-hidden="true"></i> 3 vs last month</div></div>
    </div>
</div>

<div class="sv-two-col">

    <!-- Request volume by type -->
    <div class="sv-panel">
        <div class="sv-panel-hdr">Requests by Type</div>
        <div class="sv-bar-chart">
            @foreach (var r in _byType)
            {
                <div class="sv-bar-row">
                    <div class="sv-bar-lbl">@r.Type</div>
                    <div class="sv-bar-track"><div class="sv-bar-fill" style="width:@r.Pct%"></div></div>
                    <div class="sv-bar-val">@r.Count</div>
                </div>
            }
        </div>
    </div>

    <!-- Staff performance -->
    <div class="sv-panel">
        <div class="sv-panel-hdr">Staff Throughput (MTD)</div>
        <div class="sv-staff-list">
            @foreach (var s in _staff)
            {
                <div class="sv-staff-row">
                    <div class="sv-staff-av">@Initials(s.Name)</div>
                    <div class="sv-staff-info">
                        <div class="sv-staff-name">@s.Name</div>
                        <div class="sv-staff-role">@s.Role</div>
                    </div>
                    <div class="sv-staff-stats">
                        <div class="sv-ss"><span class="sv-ss-lbl">Resolved</span><span class="sv-ss-val">@s.Resolved</span></div>
                        <div class="sv-ss"><span class="sv-ss-lbl">Avg Time</span><span class="sv-ss-val">@s.AvgTime</span></div>
                        <div class="sv-ss"><span class="sv-ss-lbl">CSAT</span><span class="sv-ss-val sv-csat">@s.Csat ★</span></div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Aging buckets -->
    <div class="sv-panel sv-panel--wide">
        <div class="sv-panel-hdr">Request Aging Buckets
            <span class="sv-ai-chip"><i class="bi bi-robot" aria-hidden="true"></i> AI: Bottleneck Detected — COI Requests &gt; 48h avg</span>
        </div>
        <div class="sv-aging-grid">
            @foreach (var b in _aging)
            {
                <div class="sv-aging-card @b.CssClass">
                    <div class="sv-aging-count">@b.Count</div>
                    <div class="sv-aging-lbl">@b.Label</div>
                    <div class="sv-aging-sub">@b.Sub</div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private record TypeRow(string Type, int Count, int Pct);
    private record StaffRow(string Name, string Role, int Resolved, string AvgTime, decimal Csat);
    private record AgingBucket(string Label, string Sub, int Count, string CssClass);

    private List<TypeRow> _byType = [];
    private List<StaffRow> _staff = [];
    private List<AgingBucket> _aging = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Analytics","/analytics/reports"), new("Servicing",""));
        _byType = [new("COI Request",98,100), new("Policy Change",74,76), new("Document Request",54,55), new("Billing Question",42,43), new("Coverage Question",28,29), new("Claim Follow-Up",16,16)];
        _staff  = [new("Beth Nakamura","Senior CSR",114,"1.8h",4.9m), new("Tom Reyes","CSR",98,"2.1h",4.7m), new("Lisa Park","CSR",86,"2.6h",4.6m), new("Diana Ruiz","CSR",71,"3.2h",4.4m), new("Marcus Webb","CSR",64,"3.8h",4.3m)];
        _aging  = [new("< 4 Hours","Within target SLA",148,"sv-age-green"), new("4–24 Hours","Monitoring",89,"sv-age-amber"), new("24–48 Hours","Approaching breach",51,"sv-age-amber"), new("48–72 Hours","SLA breach risk",18,"sv-age-red"), new("> 72 Hours","SLA breach",6,"sv-age-red sv-age-critical")];
    }

    private static string Initials(string name)
    {
        var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}" : name.Length > 0 ? name[..1] : "?";
    }
}
