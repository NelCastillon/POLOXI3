@page "/assistant"
@inject ApiClient Api

<PageTitle>Assistant</PageTitle>

<AppPageHeader Title="Assistant" Icon="bi-grid" />

<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>

@if (_items is null)
{
    <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>

            <GridColumn Field="@nameof(AssistantConversationDto.UserId)" HeaderText="User Id" Width="260"></GridColumn>
            <GridColumn Field="@nameof(AssistantConversationDto.ContextEntityName)" HeaderText="Context Entity" Width="180"></GridColumn>
            <GridColumn Field="@nameof(AssistantConversationDto.ContextEntityId)" HeaderText="Context Id" Width="260"></GridColumn>
            <GridColumn Field="@nameof(AssistantConversationDto.StartedDateUtc)" HeaderText="Started" Type="ColumnType.DateTime" Format="g" Width="180"></GridColumn>

        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<AssistantConversationDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchAssistantAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<AssistantConversationDto>();
    }
}
