@page "/ops/activities"
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Operations

<PageTitle>Activity History — Operations</PageTitle>
<AppPageHeader Title="Activity History Administration" Subtitle="Tenant admin audit of operational activity, notes, timeline events, and follow-through" Icon="bi-clock-history"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> Log Activity</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<section class="ma-hero twf-hero"><div><span class="ma-eyebrow">Tenant Administration · Activity History</span><h2>Tenant Operational Activity Ledger</h2><p>Audit tenant-wide operational activity, notes, account interactions, engagement updates, workflow events, and follow-through history.</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/engagements")'><i class="bi bi-briefcase"></i> Engagements</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/ops/service-requests")'><i class="bi bi-tools"></i> Service Requests</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/workflow")'><i class="bi bi-diagram-3"></i> Workflows</button></div></section>
<div class="pc-kpi-strip"><div class="pc-kpi-card @(_filter == null ? "pc-kpi-card--active" : "")" @onclick="() => SetFilter(null)" title="All"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-clock-history"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total</div></div></div><div class="pc-kpi-card @(_filter == "Today" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Today")' title="Today"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-calendar-check-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(IsToday)</div><div class="pc-kpi-label">Today</div></div></div></div>
<AppFilterPanel @bind-SearchValue="_searchTerm" OnSearch="OnSearchAsync" SearchPlaceholder="Search activities…" />
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div> }
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }<SfGrid TValue="OperationalActivityLogDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52"><GridEvents TValue="OperationalActivityLogDto" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" /><GridColumns><GridColumn Field="ActivityDate" HeaderText="Date" Type="ColumnType.Date" Format="d" Width="120" /><GridColumn Field="ActivityTypeCode" HeaderText="Type" Width="150" /><GridColumn Field="Subject" HeaderText="Subject" Width="300" /><GridColumn Field="Notes" HeaderText="Notes" Width="300" /><GridColumn Field="CreatedDateUtc" HeaderText="Logged" Type="ColumnType.DateTime" Format="d" Width="130" /><GridColumn HeaderText="Actions" Width="120" TextAlign="TextAlign.Center"><Template>@{ var r = (OperationalActivityLogDto)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(r)" @onclick:stopPropagation="true" title="Edit"><i class="bi bi-pencil"></i></button><button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDelete(r)" @onclick:stopPropagation="true" title="Delete"><i class="bi bi-trash"></i></button></Template></GridColumn></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="560px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm" /><DialogContent><div class="um-modal-header"><i class="bi bi-clock-history"></i><span>@(_editId.HasValue ? "Edit Activity" : "Log Activity")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div><EditForm @key="_form" Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.ActivityDate" class="um-input" /><ValidationMessage For="() => _form.ActivityDate" class="text-danger" /></div><div class="um-field"><label>Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.ActivityTypeCode" class="um-input">@foreach (var type in _taskTypes.Where(x => x.IsActive)) { <option value="@type.TaskTypeCode">@type.TaskTypeName</option> }</InputSelect><ValidationMessage For="() => _form.ActivityTypeCode" class="text-danger" /></div><div class="um-field um-field--full"><label>Subject <span class="text-danger">*</span></label><InputText @bind-Value="_form.Subject" class="um-input" /><ValidationMessage For="() => _form.Subject" class="text-danger" /></div><div class="um-field"><label>Account Name</label><SfDropDownList TValue="string" TItem="AccountOption" DataSource="_accounts" @bind-Value="_form.AccountIdText" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" ShowClearButton="true" Placeholder="Search account name" CssClass="um-input"><DropDownListFieldSettings Value="Value" Text="Label" /></SfDropDownList><ValidationMessage For="() => _form.AccountIdText" class="text-danger" /></div><div class="um-field"><label>Engagement Id</label><InputText @bind-Value="_form.EngagementIdText" class="um-input" /><ValidationMessage For="() => _form.EngagementIdText" class="text-danger" /></div><div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_form.Notes" class="um-input" rows="3" /><ValidationMessage For="() => _form.Notes" class="text-danger" /></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Log")</button></div></EditForm></DialogContent></SfDialog>
@if (_showDelete && _deleteTarget is not null) { <div class="mt-modal-backdrop" @onclick="() => _showDelete = false"><div class="um-confirm-dialog mt-confirm" @onclick:stopPropagation="true"><div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash"></i></div><div class="um-confirm-title">Delete activity?</div><div class="um-confirm-text">This will remove <strong>@_deleteTarget.Subject</strong>.</div><div class="um-modal-footer"><button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button><button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div></div></div> }
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" /><style>@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }</style>
@code { static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001"); static readonly Guid TenantAdminUserId = Guid.Parse("00000000-0000-0000-0000-000000000002"); string? _searchTerm, _loadError, _filter; bool _loading, _saving, _showForm, _showDelete; Guid? _editId; OperationalActivityLogDto? _deleteTarget; List<OperationalActivityLogDto> _items = [], _filtered = []; List<AccountOption> _accounts = []; List<TaskTypeDto> _taskTypes = []; SfToast _toast = default!; ActivityForm _form = new(); protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tasks & Workflows", "/tasks"), new("Activity History", null)); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { await LoadAccountsAsync(); await LoadTaskTypesAsync(); var result = await Api.SearchOperationalActivitiesAsync(TenantId, searchTerm: _searchTerm); _items = result?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = $"Failed to load activities: {ex.Message}"; } finally { _loading = false; } } Task OnSearchAsync() => LoadAsync(); void ApplyFilter() => _filtered = _filter == "Today" ? _items.Where(IsToday).ToList() : [.. _items]; void SetFilter(string? f) { _filter = f; ApplyFilter(); } void OnRowSelected(RowSelectEventArgs<OperationalActivityLogDto> args) => OpenEdit(args.Data); void OpenCreate() { _editId = null; _form = new() { ActivityDate = DateOnly.FromDateTime(DateTime.Today), ActivityTypeCode = GetDefaultTaskTypeCode("Activity") }; _showForm = true; } void OpenEdit(OperationalActivityLogDto item) { _editId = item.ActivityId; _form = new() { ActivityDate = item.ActivityDate, ActivityTypeCode = item.ActivityTypeCode, Subject = item.Subject, Notes = item.Notes, AccountIdText = item.AccountId?.ToString(), EngagementIdText = item.EngagementId?.ToString() }; _showForm = true; } void ConfirmDelete(OperationalActivityLogDto item) { _deleteTarget = item; _showDelete = true; } async Task SaveAsync() { _saving = true; try { if (_editId.HasValue) await Api.UpdateOperationalActivityAsync(_editId.Value, new() { ActivityDate = _form.ActivityDate, ActivityTypeCode = _form.ActivityTypeCode, Subject = _form.Subject, Notes = _form.Notes, AccountId = string.IsNullOrWhiteSpace(_form.AccountIdText) ? null : Guid.Parse(_form.AccountIdText), EngagementId = string.IsNullOrWhiteSpace(_form.EngagementIdText) ? null : Guid.Parse(_form.EngagementIdText), ModifiedByUserId = TenantAdminUserId }); else await Api.CreateOperationalActivityAsync(new() { TenantId = TenantId, ActivityDate = _form.ActivityDate, ActivityTypeCode = _form.ActivityTypeCode, Subject = _form.Subject, Notes = _form.Notes, AccountId = string.IsNullOrWhiteSpace(_form.AccountIdText) ? null : Guid.Parse(_form.AccountIdText), EngagementId = string.IsNullOrWhiteSpace(_form.EngagementIdText) ? null : Guid.Parse(_form.EngagementIdText) }); _showForm = false; await _toast.ShowAsync(new() { Content = _editId.HasValue ? "Activity updated" : "Activity logged", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } async Task ExecuteDeleteAsync() { if (_deleteTarget is null) return; _saving = true; try { await Api.DeleteOperationalActivityAsync(_deleteTarget.ActivityId, TenantAdminUserId); _showDelete = false; await _toast.ShowAsync(new() { Content = "Activity deleted", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } void ResetForm() { _form = new(); _editId = null; } async Task LoadAccountsAsync() { if (_accounts.Count > 0) return; var result = await Api.SearchAccountsAsync(TenantId); _accounts = (result?.Items ?? []).OrderBy(x => x.AccountName).Select(x => new AccountOption(x.AccountId.ToString(), x.AccountName)).ToList(); } async Task LoadTaskTypesAsync() { if (_taskTypes.Count > 0) return; var result = await Api.SearchTaskTypesAsync(TenantId, pageSize: 250); _taskTypes = (result?.Items ?? []).OrderBy(x => x.SortOrder).ThenBy(x => x.TaskTypeName).ToList(); } string GetDefaultTaskTypeCode(string defaultCode) => _taskTypes.FirstOrDefault(x => x.TaskTypeCode == defaultCode)?.TaskTypeCode ?? defaultCode; static bool IsToday(OperationalActivityLogDto x) => x.ActivityDate == DateOnly.FromDateTime(DateTime.Today); sealed record AccountOption(string Value, string Label); sealed class ActivityForm { [Required] public DateOnly ActivityDate { get; set; } = DateOnly.FromDateTime(DateTime.Today); [Required, StringLength(50)] public string ActivityTypeCode { get; set; } = "Activity"; [Required, StringLength(200)] public string Subject { get; set; } = string.Empty; public string? AccountIdText { get; set; } [RegularExpression("^$|^[0-9a-fA-F-]{36}$", ErrorMessage = "Enter a valid Engagement Id.")] public string? EngagementIdText { get; set; } [StringLength(2000)] public string? Notes { get; set; } } }
