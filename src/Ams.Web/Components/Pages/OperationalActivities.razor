@page "/ops/activities"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Operations
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Operational Activities</PageTitle>

@if (_toastVisible)
{
    <div class="act-toast act-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIcon" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="act-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="act-enterprise-page">
    <section class="act-hero">
        <div class="act-hero-left">
            <span class="act-hero-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
            <div>
                <div class="act-title-row">
                    <h1>Operational Activities</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> OPS ledger</span>
                    <span><i class="bi bi-journal-check" aria-hidden="true"></i> Audit ready</span>
                </div>
                <p>Enterprise operational activity ledger for account interactions, engagement updates, workflow events, notes, follow-through history, and tenant-wide audit visibility.</p>
            </div>
        </div>
        <div class="act-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "act-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync" disabled="@(!_items.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="OpenServiceRequests"><i class="bi bi-tools" aria-hidden="true"></i> Requests</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Log Activity</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="act-error-banner" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@_loadError</span></div>
    }

    <section class="act-kpi-strip" aria-label="Activity KPIs">
        <button type="button" class="@AllKpiClass" @onclick="ShowAll"><span class="act-kpi-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span><span><strong>@_items.Count</strong><em>Total</em><small>Tenant activity ledger</small></span></button>
        <button type="button" class="@TodayKpiClass" @onclick="ShowToday"><span class="act-kpi-icon"><i class="bi bi-calendar-check-fill" aria-hidden="true"></i></span><span><strong>@TodayCount</strong><em>Today</em><small>Current follow-through</small></span></button>
        <button type="button" class="@WeekKpiClass" @onclick="ShowThisWeek"><span class="act-kpi-icon"><i class="bi bi-calendar-week" aria-hidden="true"></i></span><span><strong>@ThisWeekCount</strong><em>This Week</em><small>Recent activity</small></span></button>
        <button type="button" class="@AccountKpiClass" @onclick="ShowAccountLinked"><span class="act-kpi-icon"><i class="bi bi-buildings" aria-hidden="true"></i></span><span><strong>@AccountLinkedCount</strong><em>Account Linked</em><small>Client context</small></span></button>
        <button type="button" class="@UnlinkedKpiClass" @onclick="ShowUnlinked"><span class="act-kpi-icon"><i class="bi bi-link-45deg" aria-hidden="true"></i></span><span><strong>@UnlinkedCount</strong><em>Unlinked</em><small>Needs attribution</small></span></button>
        <button type="button" class="@NotesKpiClass" @onclick="ShowNeedsNotes"><span class="act-kpi-icon"><i class="bi bi-journal-x" aria-hidden="true"></i></span><span><strong>@NeedsNotesCount</strong><em>Needs Notes</em><small>Audit quality</small></span></button>
    </section>

    <section class="act-workflow-strip" aria-label="Activity workflows">
        <button type="button" class="act-workflow-card" @onclick="ShowLedger"><i class="bi bi-table" aria-hidden="true"></i><span><strong>Ledger</strong><small>Activity register</small></span></button>
        <button type="button" class="act-workflow-card" @onclick="ShowTimeline"><i class="bi bi-activity" aria-hidden="true"></i><span><strong>Timeline</strong><small>Operational cadence</small></span></button>
        <button type="button" class="act-workflow-card" @onclick="ShowGovernance"><i class="bi bi-shield-check" aria-hidden="true"></i><span><strong>Governance</strong><small>Audit lanes</small></span></button>
        <button type="button" class="act-workflow-card" @onclick="OpenEngagements"><i class="bi bi-briefcase" aria-hidden="true"></i><span><strong>Engagements</strong><small>Related work</small></span></button>
        <button type="button" class="act-workflow-card" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i><span><strong>Log</strong><small>New activity</small></span></button>
    </section>

    <section class="act-search-panel">
        <div class="act-search-wrap">
            <span class="act-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="act-search-body">
                <label for="act-search">Activity search</label>
                <input id="act-search" class="act-search-input" @bind="_searchTerm" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="Search subject, notes, type, account, engagement..." />
                <span class="act-search-hint">Filters loaded tenant activities and keeps KPIs, tabs, timeline, and detail selection synchronized.</span>
            </div>
        </div>
        <select class="act-filter-select" @bind="_dateFilter" @bind:after="ApplyFilter" aria-label="Date filter">
            <option value="all">All dates</option>
            <option value="today">Today</option>
            <option value="week">This week</option>
            <option value="month">This month</option>
            <option value="older">Older</option>
        </select>
        <select class="act-filter-select" @bind="_typeFilter" @bind:after="ApplyFilter" aria-label="Type filter">
            <option value="all">All types</option>
            @foreach (var type in TypeOptions)
            {
                <option value="@type">@type</option>
            }
        </select>
        <select class="act-filter-select" @bind="_accountFilter" @bind:after="ApplyFilter" aria-label="Account filter">
            <option value="all">All accounts</option>
            <option value="unlinked">Unlinked</option>
            @foreach (var account in _accounts)
            {
                <option value="@account.Value">@account.Label</option>
            }
        </select>
        <div class="act-search-result"><strong>@_filtered.Count</strong><span>records</span></div>
    </section>

    <nav class="act-view-tabs" aria-label="Activity views">
        @foreach (var view in _views)
        {
            <button type="button" class="act-view-btn @(_activeView == view ? "act-view-btn-active" : null)" @onclick="() => SetView(view)">@view</button>
        }
    </nav>

    <section class="act-content-layout">
        <div class="act-main-card">
            @if (_loading)
            {
                <div class="act-loading"><i class="bi bi-arrow-repeat act-spin" aria-hidden="true"></i><span>Loading activities...</span></div>
            }
            else if (_filtered.Count == 0)
            {
                <div class="act-empty-state"><i class="bi bi-clock-history" aria-hidden="true"></i><h2>No activities found</h2><p>Adjust filters or log a new operational activity.</p><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> Log Activity</button></div>
            }
            else if (_activeView == "Timeline")
            {
                <div class="act-analytics-grid">
                    <section class="act-panel">
                        <header><div><i class="bi bi-activity" aria-hidden="true"></i><strong>Cadence Health</strong></div><span>@CadenceScore.ToString("F0")%</span></header>
                        <div class="act-panel-body act-metric-list">
                            <div class="act-metric-row"><span>Today</span><div><i style="@WidthStyle(TodayCount, SafeTotal)"></i></div><strong>@TodayCount</strong></div>
                            <div class="act-metric-row"><span>This Week</span><div><i style="@WidthStyle(ThisWeekCount, SafeTotal)"></i></div><strong>@ThisWeekCount</strong></div>
                            <div class="act-metric-row"><span>Account Linked</span><div><i style="@WidthStyle(AccountLinkedCount, SafeTotal)"></i></div><strong>@AccountLinkedCount</strong></div>
                            <div class="act-metric-row"><span>Needs Notes</span><div><i style="@WidthStyle(NeedsNotesCount, SafeTotal)"></i></div><strong>@NeedsNotesCount</strong></div>
                        </div>
                    </section>
                    <section class="act-panel">
                        <header><div><i class="bi bi-tags" aria-hidden="true"></i><strong>Activity Mix</strong></div><span>@TypeSummaries.Count</span></header>
                        <div class="act-panel-body act-group-list">
                            @foreach (var group in TypeSummaries.Take(8))
                            {
                                <button type="button" class="act-group-row" @onclick="() => FilterType(group.Name)"><span>@group.Name</span><div><i style="@WidthStyle(group.Count, SafeTotal)"></i></div><strong>@group.Count</strong></button>
                            }
                        </div>
                    </section>
                    <section class="act-panel act-panel-wide">
                        <header><div><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><strong>Audit Quality Queue</strong></div><span>@AuditQueue.Count</span></header>
                        <div class="act-panel-body act-review-list">
                            @foreach (var item in AuditQueue.Take(10))
                            {
                                <button type="button" class="act-review-row" @onclick="() => SelectItem(item)"><strong>@item.Subject</strong><span>@AuditReason(item)</span><em>@ImportanceLabel(item)</em></button>
                            }
                        </div>
                    </section>
                </div>
            }
            else if (_activeView == "Governance")
            {
                <div class="act-board">
                    @foreach (var lane in GovernanceLanes)
                    {
                        <section class="act-board-col">
                            <header><strong>@lane.Title</strong><span>@lane.Items.Count</span></header>
                            @foreach (var item in lane.Items)
                            {
                                <button type="button" class="act-board-card" @onclick="() => SelectItem(item)">
                                    <div><strong>@item.Subject</strong><span>@item.ActivityTypeCode</span></div>
                                    <small>@AccountName(item.AccountId) · @FormatDate(item.ActivityDate)</small>
                                    <em>@ImportanceLabel(item)</em>
                                </button>
                            }
                        </section>
                    }
                </div>
            }
            else
            {
                <div class="act-table-scroll">
                    <table class="act-table">
                        <thead><tr><th>Activity</th><th>Account</th><th>Engagement</th><th>Type</th><th>Date</th><th>Logged</th><th>Importance</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var item in _filtered)
                            {
                                <tr @onclick="() => SelectItem(item)">
                                    <td><div class="act-name-cell"><span class="act-avatar @AvatarClass(item)">@Initials(item.Subject)</span><span><strong>@item.Subject</strong><small>@(item.Notes ?? "No notes provided")</small></span></div></td>
                                    <td>@AccountName(item.AccountId)</td>
                                    <td>@EngagementLabel(item.EngagementId)</td>
                                    <td><span class="act-code-pill">@item.ActivityTypeCode</span></td>
                                    <td>@FormatDate(item.ActivityDate)</td>
                                    <td>@item.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                                    <td><span class="@ImportanceClass(item)">@ImportanceLabel(item)</span></td>
                                    <td><div class="act-row-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => DuplicateItem(item)" title="Duplicate"><i class="bi bi-files" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(item)" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <aside class="act-detail-card" aria-label="Selected activity">
            @if (_selected is null)
            {
                <div class="act-detail-empty"><i class="bi bi-clock-history" aria-hidden="true"></i><h2>Activity command brief</h2><p>Select an activity to review timeline context, account attribution, audit quality, and operational actions.</p></div>
            }
            else
            {
                <div class="act-detail-head"><div><span class="act-detail-eyebrow"><i class="bi bi-buildings" aria-hidden="true"></i> @AccountName(_selected.AccountId)</span><h2>@_selected.Subject</h2><p>@_selected.ActivityTypeCode · @FormatDate(_selected.ActivityDate)</p></div><span class="@ImportanceClass(_selected)">@ImportanceLabel(_selected)</span></div>
                <div class="act-detail-body">
                    <div class="act-detail-summary">
                        <div><span>Activity Date</span><strong>@FormatDate(_selected.ActivityDate)</strong></div>
                        <div><span>Logged</span><strong>@_selected.CreatedDateUtc.ToLocalTime().ToString("MMM d")</strong></div>
                        <div><span>Type</span><strong>@_selected.ActivityTypeCode</strong></div>
                        <div><span>Engagement</span><strong>@EngagementLabel(_selected.EngagementId)</strong></div>
                    </div>
                    <div class="act-config-card"><span>Audit brief</span><strong>@AuditReason(_selected)</strong><small>@(_selected.Notes ?? "No notes provided for this activity.")</small></div>
                    <div class="act-detail-actions">
                        <button type="button" class="um-btn um-btn-primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit Activity</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="DuplicateSelected"><i class="bi bi-files" aria-hidden="true"></i> Duplicate</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="MarkTodayAsync"><i class="bi bi-calendar-check" aria-hidden="true"></i> Mark Today</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="OpenServiceRequests"><i class="bi bi-tools" aria-hidden="true"></i> Service Requests</button>
                        <button type="button" class="um-btn um-btn-ghost text-danger" @onclick="() => ConfirmDelete(_selected)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@if (_showForm)
{
    <div class="act-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="act-form-title">
        <div class="act-modal">
            <div class="act-modal-header"><div class="act-modal-title"><span class="act-modal-icon"><i class="bi bi-clock-history" aria-hidden="true"></i></span><div><h2 id="act-form-title">@(_editId.HasValue ? "Edit Activity" : "Log Activity")</h2><p>Capture account context, activity type, engagement reference, notes, and audit-ready timeline details.</p></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm @key="_form" Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="ShowValidation">
                <DataAnnotationsValidator />
                <div class="act-modal-body">
                    <div class="act-form-banner"><i class="bi bi-info-circle" aria-hidden="true"></i><span><strong>Activity ledger</strong> Activities are optional-linked to accounts, engagements, and agreements; complete notes improve audit quality.</span></div>
                    <div class="act-form-grid">
                        <div class="act-field"><label>Date <span>*</span></label><InputDate @bind-Value="_form.ActivityDate" class="act-input" /><ValidationMessage For="() => _form.ActivityDate" class="text-danger" /></div>
                        <div class="act-field"><label>Type <span>*</span></label><InputSelect @bind-Value="_form.ActivityTypeCode" class="act-input">@foreach (var type in ActiveTaskTypes){<option value="@type.TaskTypeCode">@type.TaskTypeName</option>}</InputSelect><ValidationMessage For="() => _form.ActivityTypeCode" class="text-danger" /></div>
                        <div class="act-field act-field-wide"><label>Subject <span>*</span></label><InputText @bind-Value="_form.Subject" class="act-input" /><ValidationMessage For="() => _form.Subject" class="text-danger" /></div>
                        <div class="act-field"><label>Account</label><InputSelect @bind-Value="_form.AccountIdText" class="act-input"><option value="">Unlinked account</option>@foreach (var account in _accounts){<option value="@account.Value">@account.Label</option>}</InputSelect><ValidationMessage For="() => _form.AccountIdText" class="text-danger" /></div>
                        <div class="act-field"><label>Engagement Id</label><InputText @bind-Value="_form.EngagementIdText" class="act-input" /><ValidationMessage For="() => _form.EngagementIdText" class="text-danger" /></div>
                        <div class="act-field act-field-wide"><label>Notes</label><InputTextArea @bind-Value="_form.Notes" class="act-input" rows="3" /><ValidationMessage For="() => _form.Notes" class="text-danger" /></div>
                    </div>
                </div>
                <div class="act-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi bi-check2" aria-hidden="true"></i> @(_editId.HasValue ? "Save Changes" : "Log Activity")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showDelete)
{
    <div class="act-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="act-delete-title">
        <div class="act-confirm-modal">
            <div class="act-confirm-icon"><i class="bi bi-trash3-fill" aria-hidden="true"></i></div>
            <h2 id="act-delete-title">Delete Activity</h2>
            <p>Delete <strong>@_deleteTarget?.Subject</strong>? This removes the operational timeline entry.</p>
            <div class="act-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CancelDelete">Cancel</button><button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div>
        </div>
    </div>
}

@code {
    private Guid TenantId { get; set; }
    private Guid TenantAdminUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading;
    private bool _saving;
    private bool _showForm;
    private bool _showDelete;
    private bool _toastVisible;
    private string _searchTerm = string.Empty;
    private string _dateFilter = "all";
    private string _typeFilter = "all";
    private string _accountFilter = "all";
    private string _activeView = "Ledger";
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private Guid? _editId;
    private OperationalActivityLogDto? _selected;
    private OperationalActivityLogDto? _deleteTarget;
    private readonly string[] _views = ["Ledger", "Timeline", "Governance"];
    private List<OperationalActivityLogDto> _items = [];
    private List<OperationalActivityLogDto> _filtered = [];
    private List<AccountOption> _accounts = [];
    private List<TaskTypeDto> _taskTypes = [];
    private ActivityForm _form = new();

    private IEnumerable<TaskTypeDto> ActiveTaskTypes => _taskTypes.Where(x => x.IsActive).DefaultIfEmpty(new TaskTypeDto { TaskTypeCode = "Activity", TaskTypeName = "Activity", IsActive = true });
    private int TodayCount => _items.Count(IsToday);
    private int ThisWeekCount => _items.Count(IsThisWeek);
    private int AccountLinkedCount => _items.Count(x => x.AccountId.HasValue);
    private int UnlinkedCount => _items.Count(x => !x.AccountId.HasValue && !x.EngagementId.HasValue && !x.AgreementId.HasValue);
    private int NeedsNotesCount => _items.Count(NeedsNotes);
    private int SafeTotal => Math.Max(_items.Count, 1);
    private double CadenceScore => _items.Count == 0 ? 0 : Math.Clamp((TodayCount * 25d + ThisWeekCount * 10d + AccountLinkedCount * 5d - NeedsNotesCount * 10d) / Math.Max(_items.Count, 1), 0, 100);
    private List<string> TypeOptions => _items.Select(x => x.ActivityTypeCode).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    private List<GroupSummary> TypeSummaries => _items.GroupBy(x => x.ActivityTypeCode).Select(g => new GroupSummary(g.Key, g.Count())).OrderByDescending(x => x.Count).ThenBy(x => x.Name).ToList();
    private List<OperationalActivityLogDto> AuditQueue => _items.Where(x => NeedsNotes(x) || IsUnlinked(x) || IsToday(x)).OrderByDescending(IsToday).ThenByDescending(ImportanceRank).ThenByDescending(x => x.ActivityDate).ToList();
    private List<GovernanceLane> GovernanceLanes =>
    [
        new("Today", _filtered.Where(IsToday).ToList()),
        new("Linked", _filtered.Where(x => x.AccountId.HasValue || x.EngagementId.HasValue || x.AgreementId.HasValue).ToList()),
        new("Audit Review", _filtered.Where(x => NeedsNotes(x) || IsUnlinked(x)).ToList()),
    ];
    private string ToastIcon => _toastKind == "success" ? "bi-check-circle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-exclamation-triangle-fill";
    private string AllKpiClass => KpiClass("all", "act-blue");
    private string TodayKpiClass => KpiClass("today", "act-green");
    private string WeekKpiClass => KpiClass("week", "act-cyan");
    private string AccountKpiClass => KpiClass("account", "act-purple");
    private string UnlinkedKpiClass => KpiClass("unlinked", "act-amber");
    private string NotesKpiClass => KpiClass("notes", "act-red");

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tasks & Workflows", "/tasks"), new("Activity History", "/ops/activities"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await LoadAccountsAsync();
            await LoadTaskTypesAsync();
            var result = await Api.SearchOperationalActivitiesAsync(TenantId, searchTerm: _searchTerm, pageSize: 100);
            _items = result?.Items.OrderByDescending(x => x.ActivityDate).ThenByDescending(x => x.CreatedDateUtc).ToList() ?? [];
            ApplyFilter();
            _selected ??= _filtered.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load activities: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilter()
    {
        IEnumerable<OperationalActivityLogDto> query = _items;
        if (!string.IsNullOrWhiteSpace(_searchTerm)) query = query.Where(MatchesSearch);
        query = _dateFilter switch
        {
            "today" => query.Where(IsToday),
            "week" => query.Where(IsThisWeek),
            "month" => query.Where(IsThisMonth),
            "older" => query.Where(x => x.ActivityDate < DateOnly.FromDateTime(DateTime.Today.AddDays(-30))),
            _ => query
        };
        if (_typeFilter != "all") query = query.Where(x => string.Equals(x.ActivityTypeCode, _typeFilter, StringComparison.OrdinalIgnoreCase));
        if (_accountFilter == "unlinked") query = query.Where(IsUnlinked);
        else if (_accountFilter != "all" && Guid.TryParse(_accountFilter, out var accountId)) query = query.Where(x => x.AccountId == accountId);
        _filtered = query.OrderByDescending(ImportanceRank).ThenByDescending(x => x.ActivityDate).ThenByDescending(x => x.CreatedDateUtc).ToList();
        if (_selected is not null && !_filtered.Any(x => x.ActivityId == _selected.ActivityId)) _selected = _filtered.FirstOrDefault();
    }

    private void ShowAll() { _dateFilter = "all"; _typeFilter = "all"; _accountFilter = "all"; ApplyFilter(); }
    private void ShowToday() { _dateFilter = "today"; _typeFilter = "all"; ApplyFilter(); }
    private void ShowThisWeek() { _dateFilter = "week"; _typeFilter = "all"; ApplyFilter(); }
    private void ShowAccountLinked() { _dateFilter = "all"; _accountFilter = "all"; _filtered = _items.Where(x => x.AccountId.HasValue).OrderByDescending(x => x.ActivityDate).ToList(); _selected = _filtered.FirstOrDefault(); }
    private void ShowUnlinked() { _dateFilter = "all"; _accountFilter = "unlinked"; ApplyFilter(); }
    private void ShowNeedsNotes() { _dateFilter = "all"; _accountFilter = "all"; _filtered = _items.Where(NeedsNotes).OrderByDescending(x => x.ActivityDate).ToList(); _selected = _filtered.FirstOrDefault(); }
    private void ShowLedger() => SetView("Ledger");
    private void ShowTimeline() => SetView("Timeline");
    private void ShowGovernance() => SetView("Governance");
    private void SetView(string view) => _activeView = view;
    private void FilterType(string type) { _typeFilter = type; ApplyFilter(); }
    private void SelectItem(OperationalActivityLogDto item) => _selected = item;
    private void OpenEngagements() => Nav.NavigateTo("/engagements");
    private void OpenServiceRequests() => Nav.NavigateTo("/ops/service-requests");

    private void OpenCreate()
    {
        _editId = null;
        _form = new() { ActivityDate = DateOnly.FromDateTime(DateTime.Today), ActivityTypeCode = GetDefaultTaskTypeCode("Activity") };
        _showForm = true;
    }

    private void OpenEdit(OperationalActivityLogDto item)
    {
        _editId = item.ActivityId;
        _form = new()
        {
            ActivityDate = item.ActivityDate,
            ActivityTypeCode = item.ActivityTypeCode,
            Subject = item.Subject,
            Notes = item.Notes,
            AccountIdText = item.AccountId?.ToString() ?? string.Empty,
            EngagementIdText = item.EngagementId?.ToString() ?? string.Empty
        };
        _showForm = true;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var accountId = ParseOptionalGuid(_form.AccountIdText);
            var engagementId = ParseOptionalGuid(_form.EngagementIdText);
            if (_editId.HasValue)
            {
                await Api.UpdateOperationalActivityAsync(_editId.Value, new()
                {
                    ActivityDate = _form.ActivityDate,
                    ActivityTypeCode = _form.ActivityTypeCode,
                    Subject = _form.Subject.Trim(),
                    Notes = Clean(_form.Notes),
                    AccountId = accountId,
                    EngagementId = engagementId,
                    ModifiedByUserId = TenantAdminUserId
                });
                ShowToast("Activity updated.");
            }
            else
            {
                var id = await Api.CreateOperationalActivityAsync(new()
                {
                    TenantId = TenantId,
                    ActivityDate = _form.ActivityDate,
                    ActivityTypeCode = _form.ActivityTypeCode,
                    Subject = _form.Subject.Trim(),
                    Notes = Clean(_form.Notes),
                    AccountId = accountId,
                    EngagementId = engagementId,
                    PerformedByUserId = TenantAdminUserId,
                    CreatedByUserId = TenantAdminUserId
                });
                _editId = id;
                ShowToast("Activity logged.");
            }
            _showForm = false;
            await LoadAsync();
            _selected = _items.FirstOrDefault(x => x.ActivityId == _editId) ?? _selected;
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmDelete(OperationalActivityLogDto item) { _deleteTarget = item; _showDelete = true; }
    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        _saving = true;
        try
        {
            await Api.DeleteOperationalActivityAsync(_deleteTarget.ActivityId, TenantAdminUserId);
            ShowToast("Activity deleted.");
            if (_selected?.ActivityId == _deleteTarget.ActivityId) _selected = null;
            _showDelete = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Delete failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private void DuplicateItem(OperationalActivityLogDto item)
    {
        _editId = null;
        _form = new()
        {
            ActivityDate = DateOnly.FromDateTime(DateTime.Today),
            ActivityTypeCode = item.ActivityTypeCode,
            Subject = $"Follow-up: {item.Subject}",
            Notes = item.Notes,
            AccountIdText = item.AccountId?.ToString() ?? string.Empty,
            EngagementIdText = item.EngagementId?.ToString() ?? string.Empty
        };
        _showForm = true;
    }

    private void DuplicateSelected()
    {
        if (_selected is null) return;
        DuplicateItem(_selected);
    }

    private async Task MarkTodayAsync()
    {
        if (_selected is null)
        {
            ShowToast("Select an activity to mark today.", "warning");
            return;
        }
        _saving = true;
        try
        {
            await Api.UpdateOperationalActivityAsync(_selected.ActivityId, new()
            {
                AccountId = _selected.AccountId,
                EngagementId = _selected.EngagementId,
                AgreementId = _selected.AgreementId,
                ActivityDate = DateOnly.FromDateTime(DateTime.Today),
                ActivityTypeCode = _selected.ActivityTypeCode,
                Subject = _selected.Subject,
                Notes = _selected.Notes,
                PerformedByUserId = _selected.PerformedByUserId,
                ModifiedByUserId = TenantAdminUserId
            });
            ShowToast("Activity date marked as today.");
            await LoadAsync();
            _selected = _items.FirstOrDefault(x => x.ActivityId == _selected.ActivityId) ?? _selected;
        }
        catch (Exception ex)
        {
            ShowToast($"Update failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private Task ExportAsync()
    {
        var rows = new List<string> { "Subject,Type,Account,Engagement,ActivityDate,Logged,Importance,Notes" };
        rows.AddRange(_filtered.Select(x => string.Join(',', Csv(x.Subject), Csv(x.ActivityTypeCode), Csv(AccountName(x.AccountId)), Csv(EngagementLabel(x.EngagementId)), Csv(FormatDate(x.ActivityDate)), Csv(x.CreatedDateUtc.ToString("O")), Csv(ImportanceLabel(x)), Csv(x.Notes))));
        Nav.NavigateTo("data:text/csv;charset=utf-8," + Uri.EscapeDataString(string.Join(Environment.NewLine, rows)), forceLoad: true);
        ShowToast("Activity export generated.");
        return Task.CompletedTask;
    }

    private async Task LoadAccountsAsync()
    {
        if (_accounts.Count > 0) return;
        var result = await Api.SearchAccountsAsync(TenantId);
        _accounts = (result?.Items ?? []).OrderBy(x => x.AccountName).Select(x => new AccountOption(x.AccountId.ToString(), x.AccountName)).ToList();
    }

    private async Task LoadTaskTypesAsync()
    {
        if (_taskTypes.Count > 0) return;
        var result = await Api.SearchTaskTypesAsync(TenantId, pageSize: 250);
        _taskTypes = (result?.Items ?? []).OrderBy(x => x.SortOrder).ThenBy(x => x.TaskTypeName).ToList();
    }

    private void ShowValidation() => ShowToast("Please fix validation errors before saving.", "danger");
    private void CloseForm() { _showForm = false; _form = new(); _editId = null; }
    private void CancelDelete() { _showDelete = false; _deleteTarget = null; }
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }

    private string KpiClass(string key, string tone)
    {
        var active = key switch
        {
            "all" => _dateFilter == "all" && _typeFilter == "all" && _accountFilter == "all",
            "today" => _dateFilter == "today",
            "week" => _dateFilter == "week",
            "account" => _filtered.Count > 0 && _filtered.All(x => x.AccountId.HasValue),
            "unlinked" => _accountFilter == "unlinked",
            "notes" => _filtered.Count > 0 && _filtered.All(NeedsNotes),
            _ => false
        };
        return $"act-kpi-card {tone}{(active ? " act-kpi-card-active" : string.Empty)}";
    }

    private bool MatchesSearch(OperationalActivityLogDto item)
    {
        var q = _searchTerm.Trim();
        return Contains(item.Subject, q) || Contains(item.Notes, q) || Contains(item.ActivityTypeCode, q) || Contains(AccountName(item.AccountId), q) || Contains(EngagementLabel(item.EngagementId), q);
    }

    private string AccountName(Guid? accountId) => accountId is null ? "Unlinked account" : _accounts.FirstOrDefault(x => string.Equals(x.Value, accountId.Value.ToString(), StringComparison.OrdinalIgnoreCase))?.Label ?? "Account not loaded";
    private static string EngagementLabel(Guid? engagementId) => engagementId.HasValue ? engagementId.Value.ToString()[..8] : "No engagement";
    private string GetDefaultTaskTypeCode(string defaultCode) => _taskTypes.FirstOrDefault(x => x.TaskTypeCode == defaultCode)?.TaskTypeCode ?? _taskTypes.FirstOrDefault(x => x.IsActive)?.TaskTypeCode ?? defaultCode;
    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;
    private static bool IsToday(OperationalActivityLogDto x) => x.ActivityDate == DateOnly.FromDateTime(DateTime.Today);
    private static bool IsThisWeek(OperationalActivityLogDto x) => x.ActivityDate >= DateOnly.FromDateTime(DateTime.Today.AddDays(-7));
    private static bool IsThisMonth(OperationalActivityLogDto x) => x.ActivityDate >= DateOnly.FromDateTime(DateTime.Today.AddDays(-30));
    private static bool NeedsNotes(OperationalActivityLogDto x) => string.IsNullOrWhiteSpace(x.Notes);
    private static bool IsUnlinked(OperationalActivityLogDto x) => !x.AccountId.HasValue && !x.EngagementId.HasValue && !x.AgreementId.HasValue;
    private static int ImportanceRank(OperationalActivityLogDto item) => IsToday(item) ? 4 : NeedsNotes(item) || IsUnlinked(item) ? 3 : IsThisWeek(item) ? 2 : 1;
    private static string ImportanceLabel(OperationalActivityLogDto item) => IsToday(item) ? "Today" : NeedsNotes(item) || IsUnlinked(item) ? "Audit Review" : IsThisWeek(item) ? "Recent" : "Historical";
    private static string ImportanceClass(OperationalActivityLogDto item) => IsToday(item) ? "act-priority act-priority-today" : NeedsNotes(item) || IsUnlinked(item) ? "act-priority act-priority-risk" : IsThisWeek(item) ? "act-priority act-priority-recent" : "act-priority act-priority-standard";
    private static string AuditReason(OperationalActivityLogDto item)
    {
        if (IsUnlinked(item)) return "Activity is not linked to an account, engagement, or agreement.";
        if (NeedsNotes(item)) return "Activity notes are missing for audit context.";
        if (IsToday(item)) return "Activity is part of today's operational follow-through.";
        if (IsThisWeek(item)) return "Activity is recent and part of current operational cadence.";
        return "Activity is historical and audit-ready.";
    }
    private static string FormatDate(DateOnly value) => value.ToString("MMM d, yyyy");
    private static string WidthStyle(int value, int max) => $"width:{Math.Clamp((int)Math.Round(value * 100d / Math.Max(max, 1)), 0, 100)}%;";
    private static string AvatarClass(OperationalActivityLogDto item)
    {
        var index = Math.Abs(item.Subject.GetHashCode()) % 6;
        if (index == 0) return "act-av1";
        if (index == 1) return "act-av2";
        if (index == 2) return "act-av3";
        if (index == 3) return "act-av4";
        if (index == 4) return "act-av5";
        return "act-av6";
    }
    private static string Initials(string name)
    {
        var parts = name.Split(' ', '-', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant() : name.Length > 0 ? name[..1].ToUpperInvariant() : "?";
    }
    private static Guid? ParseOptionalGuid(string? value) => string.IsNullOrWhiteSpace(value) ? null : Guid.Parse(value);
    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string Csv(string? value) => string.Concat("\"", (value ?? string.Empty).Replace("\"", "\"\""), "\"");

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private sealed record AccountOption(string Value, string Label);
    private sealed record GroupSummary(string Name, int Count);
    private sealed record GovernanceLane(string Title, List<OperationalActivityLogDto> Items);
    private sealed class ActivityForm
    {
        [Required] public DateOnly ActivityDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        [Required, StringLength(50)] public string ActivityTypeCode { get; set; } = "Activity";
        [Required, StringLength(200)] public string Subject { get; set; } = string.Empty;
        public string? AccountIdText { get; set; }
        [RegularExpression("^$|^[0-9a-fA-F-]{36}$", ErrorMessage = "Enter a valid Engagement Id.")] public string? EngagementIdText { get; set; }
        [StringLength(2000)] public string? Notes { get; set; }
    }
