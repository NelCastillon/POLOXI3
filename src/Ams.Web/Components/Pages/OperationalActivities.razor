@page "/ops/activities"
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Features.Operations

<PageTitle>Activity History — Operations</PageTitle>
<AppPageHeader Title="Activity History" Subtitle="Audit operational activity, notes, timeline events, and follow-through" Icon="bi-clock-history"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> Log Activity</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<div class="pc-kpi-strip"><div class="pc-kpi-card @(_filter == null ? "pc-kpi-card--active" : "")" @onclick="() => SetFilter(null)" title="All"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-clock-history"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total</div></div></div><div class="pc-kpi-card @(_filter == "Today" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Today")' title="Today"><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-calendar-check-fill"></i></span><div><div class="pc-kpi-value">@_items.Count(IsToday)</div><div class="pc-kpi-label">Today</div></div></div></div>
<AppFilterPanel @bind-SearchValue="_searchTerm" OnSearch="OnSearchAsync" SearchPlaceholder="Search activities…" />
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div> }
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }<SfGrid TValue="OperationalActivityLogDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52"><GridEvents TValue="OperationalActivityLogDto" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" /><GridColumns><GridColumn Field="ActivityDate" HeaderText="Date" Type="ColumnType.Date" Format="d" Width="120" /><GridColumn Field="ActivityTypeCode" HeaderText="Type" Width="150" /><GridColumn Field="Subject" HeaderText="Subject" Width="300" /><GridColumn Field="Notes" HeaderText="Notes" Width="300" /><GridColumn Field="CreatedDateUtc" HeaderText="Logged" Type="ColumnType.DateTime" Format="d" Width="130" /></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="560px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm" /><DialogContent><div class="um-modal-header"><i class="bi bi-clock-history"></i><span>Log Activity</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.ActivityDate" class="um-input" /><ValidationMessage For="() => _form.ActivityDate" class="text-danger" /></div><div class="um-field"><label>Type <span class="text-danger">*</span></label><InputText @bind-Value="_form.ActivityTypeCode" class="um-input" /><ValidationMessage For="() => _form.ActivityTypeCode" class="text-danger" /></div><div class="um-field um-field--full"><label>Subject <span class="text-danger">*</span></label><InputText @bind-Value="_form.Subject" class="um-input" /><ValidationMessage For="() => _form.Subject" class="text-danger" /></div><div class="um-field"><label>Account Id</label><InputText @bind-Value="_form.AccountIdText" class="um-input" /><ValidationMessage For="() => _form.AccountIdText" class="text-danger" /></div><div class="um-field"><label>Engagement Id</label><InputText @bind-Value="_form.EngagementIdText" class="um-input" /><ValidationMessage For="() => _form.EngagementIdText" class="text-danger" /></div><div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_form.Notes" class="um-input" rows="3" /><ValidationMessage For="() => _form.Notes" class="text-danger" /></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Log</button></div></EditForm></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" /><style>@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }</style>
@code { static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001"); string? _searchTerm, _loadError, _filter; bool _loading, _saving, _showForm; List<OperationalActivityLogDto> _items = [], _filtered = []; SfToast _toast = default!; ActivityForm _form = new(); protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tasks & Workflows", "/tasks"), new("Activity History", null)); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchOperationalActivitiesAsync(TenantId, searchTerm: _searchTerm); _items = result?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = $"Failed to load activities: {ex.Message}"; } finally { _loading = false; } } Task OnSearchAsync() => LoadAsync(); void ApplyFilter() => _filtered = _filter == "Today" ? _items.Where(IsToday).ToList() : [.. _items]; void SetFilter(string? f) { _filter = f; ApplyFilter(); } void OnRowSelected(RowSelectEventArgs<OperationalActivityLogDto> args) { } void OpenCreate() { _form = new() { ActivityDate = DateOnly.FromDateTime(DateTime.Today) }; _showForm = true; } async Task SaveAsync() { _saving = true; try { await Api.CreateOperationalActivityAsync(new() { TenantId = TenantId, ActivityDate = _form.ActivityDate, ActivityTypeCode = _form.ActivityTypeCode, Subject = _form.Subject, Notes = _form.Notes, AccountId = string.IsNullOrWhiteSpace(_form.AccountIdText) ? null : Guid.Parse(_form.AccountIdText), EngagementId = string.IsNullOrWhiteSpace(_form.EngagementIdText) ? null : Guid.Parse(_form.EngagementIdText) }); _showForm = false; await _toast.ShowAsync(new() { Content = "Activity logged", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } void ResetForm() => _form = new(); static bool IsToday(OperationalActivityLogDto x) => x.ActivityDate == DateOnly.FromDateTime(DateTime.Today); sealed class ActivityForm { [Required] public DateOnly ActivityDate { get; set; } = DateOnly.FromDateTime(DateTime.Today); [Required, StringLength(50)] public string ActivityTypeCode { get; set; } = "Note"; [Required, StringLength(200)] public string Subject { get; set; } = string.Empty; [RegularExpression("^$|^[0-9a-fA-F-]{36}$", ErrorMessage = "Enter a valid Account Id.")] public string? AccountIdText { get; set; } [RegularExpression("^$|^[0-9a-fA-F-]{36}$", ErrorMessage = "Enter a valid Engagement Id.")] public string? EngagementIdText { get; set; } [StringLength(2000)] public string? Notes { get; set; } } }
