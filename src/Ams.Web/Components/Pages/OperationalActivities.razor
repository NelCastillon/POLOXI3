@page "/ops/activities"
@inject ApiClient Api

<PageTitle>Operational Activities</PageTitle>
<h1>Operational Activities</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(OperationalActivityLogDto.ActivityDate)"     HeaderText="Date"         Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(OperationalActivityLogDto.ActivityTypeCode)" HeaderText="Type"         Width="150"></GridColumn>
        <GridColumn Field="@nameof(OperationalActivityLogDto.Subject)"          HeaderText="Subject"      Width="300"></GridColumn>
        <GridColumn Field="@nameof(OperationalActivityLogDto.Notes)"            HeaderText="Notes"        Width="300"></GridColumn>
        <GridColumn Field="@nameof(OperationalActivityLogDto.CreatedDateUtc)"   HeaderText="Logged"       Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
    </GridColumns>
</SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<OperationalActivityLogDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchOperationalActivitiesAsync(_tenantId, searchTerm: _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
