<article class="profile-row @(Highlighted ? "is-highlighted" : null)">
    <div>
        <strong>@Title</strong>
        <span>@Detail</span>
        <small>@Meta</small>
    </div>
    @if (!string.IsNullOrWhiteSpace(Badge))
    {
        <em>@Badge</em>
    }
</article>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Detail { get; set; } = string.Empty;
    [Parameter] public string Meta { get; set; } = string.Empty;
    [Parameter] public bool Highlighted { get; set; }
    [Parameter] public string? Badge { get; set; }
}
