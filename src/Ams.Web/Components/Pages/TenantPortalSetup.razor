@page "/tenant/portal/branding2"
@page "/tenant/portal"
@page "/tenant/portal-admin/branding"
@page "/tenant/portal/users2"
@page "/tenant/portal/features2"
@page "/tenant/portal/requests2"
@page "/tenant/portal/documents2"
@page "/tenant/portal/alerts2"
@page "/tenant/portal/mobile2"
@page "/tenant/portal/activity2"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Client Portal Setup — AMS</PageTitle>

<AppPageHeader Title="Client Portal Setup"
               Subtitle="Tenant admin control center for portal branding, users, self-service features, requests, documents, notifications, mobile settings, and activity"
               Icon="bi-window-gear">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/tenant/portal/branding")'>
            <i class="bi bi-palette" aria-hidden="true"></i> Portal Branding
        </button>
    </Actions>
</AppPageHeader>

<section class="cps-hero" aria-label="Client portal setup overview">
    <div>
        <span class="cps-eyebrow">Tenant administration</span>
        <h2>Client Portal Setup Workflow</h2>
        <p>Configure the insured portal experience across branding, users, feature access, self-service intake, document center, notification rules, mobile configuration, and activity monitoring.</p>
    </div>
    <div class="cps-hero-grid">
        @foreach (var action in _quickActions)
        {
            <button class="cps-quick-action" @onclick="() => Nav.NavigateTo(action.Url)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
</section>

<section class="cps-kpi-grid" aria-label="Client portal setup metrics">
    @Kpi("Portal Users", "1,284", "184 active this week", "bi-people", "cps-tone-blue")
    @Kpi("Self-Service", "76%", "Requests resolved digitally", "bi-tools", "cps-tone-green")
    @Kpi("Pending Invites", "38", "Awaiting activation", "bi-envelope", "cps-tone-amber")
    @Kpi("Warnings", "6", "Security and delivery items", "bi-shield-exclamation", "cps-tone-red")
</section>

<section class="cps-command-bar" aria-label="Client portal setup filters">
    <div class="cps-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search"
               placeholder="Search portal setup, owner, control, module..."
               @bind="_search"
               @bind:event="oninput" />
    </div>
    <div class="cps-pill-group" role="group" aria-label="Portal workflow filter">
        @foreach (var filter in _filters)
        {
            <button class="cps-pill @(_filter == filter.Key ? "cps-pill--active" : "")"
                    @onclick="() => _filter = filter.Key">
                @filter.Label
                <span>@FilterCount(filter.Key)</span>
            </button>
        }
    </div>
</section>

<section class="cps-layout">
    <div class="cps-flow" aria-label="Client portal setup workflow lanes">
        @foreach (var lane in _lanes)
        {
            var laneItems = FilteredWorkflow.Where(x => x.Stage == lane.Key).ToList();
            <article class="cps-lane">
                <header class="cps-lane-header">
                    <div>
                        <span class="cps-lane-title">@lane.Label</span>
                        <span class="cps-lane-subtitle">@lane.Description</span>
                    </div>
                    <span class="cps-lane-count">@laneItems.Count</span>
                </header>

                <div class="cps-lane-list">
                    @if (laneItems.Count == 0)
                    {
                        <div class="cps-empty-mini">No visible workflow items.</div>
                    }
                    else
                    {
                        @foreach (var item in laneItems)
                        {
                            <button class="cps-work-card @(item.Risk == "High" ? "cps-work-card--risk" : "")"
                                    @onclick="() => _selected = item">
                                <div class="cps-work-topline">
                                    <span class="cps-chip @ToneCss(item.Domain)">@item.Domain</span>
                                    <span class="cps-status @RiskCss(item.Risk)">@item.Risk</span>
                                </div>
                                <strong>@item.Title</strong>
                                <p>@item.Summary</p>
                                <div class="cps-work-meta">
                                    <span><i class="bi bi-person" aria-hidden="true"></i> @item.Owner</span>
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> @item.Sla</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            </article>
        }
    </div>

    <aside class="cps-admin-panel" aria-label="Tenant portal administration controls">
        @if (_selected is null)
        {
            <div class="cps-side-empty">
                <i class="bi bi-window-gear" aria-hidden="true"></i>
                <h3>Portal governance</h3>
                <p>Select a workflow item to inspect owner, SLA, risk, portal control, and downstream setup module.</p>
            </div>
        }
        else
        {
            <div class="cps-detail-header">
                <span class="cps-chip @ToneCss(_selected.Domain)">@_selected.Domain</span>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close details">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h3>@_selected.Title</h3>
            <p>@_selected.Summary</p>

            <dl class="cps-detail-list">
                <div><dt>Owner</dt><dd>@_selected.Owner</dd></div>
                <div><dt>Stage</dt><dd>@_selected.Stage</dd></div>
                <div><dt>Risk</dt><dd><span class="cps-status @RiskCss(_selected.Risk)">@_selected.Risk</span></dd></div>
                <div><dt>SLA</dt><dd>@_selected.Sla</dd></div>
                <div><dt>Control</dt><dd>@_selected.Control</dd></div>
            </dl>

            <div class="cps-policy-card">
                <strong>Tenant portal controls</strong>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Portal identity, branding, and domain policy governed</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> User access, document permissions, and request routing monitored</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Notifications, mobile settings, and portal activity audited</span>
            </div>

            <div class="cps-detail-actions">
                <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selected.Url)">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Module
                </button>
                <button class="um-btn um-btn-ghost" @onclick="() => Advance(_selected)">
                    <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Advance
                </button>
            </div>
        }
    </aside>
</section>

<section class="cps-module-grid" aria-label="Client portal setup modules">
    @foreach (var module in _modules)
    {
        <button class="cps-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
            <span class="cps-module-icon @ToneCss(module.Domain)"><i class="bi @module.Icon" aria-hidden="true"></i></span>
            <span class="cps-module-content">
                <strong>@module.Title</strong>
                <small>@module.Description</small>
            </span>
            <i class="bi bi-chevron-right cps-module-arrow" aria-hidden="true"></i>
        </button>
    }
</section>

@code {
    private string _search = string.Empty;
    private string _filter = string.Empty;
    private PortalWorkflowItem? _selected;
    private readonly List<PortalWorkflowItem> _workflow = [];

    private readonly Lane[] _lanes =
    [
        new("Brand", "Brand", "Identity, domain, theme"),
        new("Invite", "Invite", "Users and access"),
        new("Enable", "Enable", "Features and documents"),
        new("Route", "Route", "Requests and notifications"),
        new("Monitor", "Monitor", "Mobile and activity")
    ];

    private readonly Filter[] _filters =
    [
        new("", "All"),
        new("risk", "High Risk"),
        new("users", "Users"),
        new("requests", "Requests"),
        new("mobile", "Mobile")
    ];

    private readonly PortalModule[] _modules =
    [
        new("Portal Branding", "Configure client portal display name, domain, logo, colors, support contact, and messaging.", "/tenant/portal/branding", "bi-palette", "Branding"),
        new("Portal Users", "Manage insured users, invites, MFA, status, account access, and relationship visibility.", "/tenant/portal/users", "bi-people", "Users"),
        new("Portal Features", "Control enabled portal modules, client self-service capabilities, and rollout settings.", "/tenant/portal/features", "bi-toggles", "Features"),
        new("Self-Svc Request Types", "Configure request categories, forms, routing, SLA, and assignment rules.", "/tenant/portal/requests", "bi-tools", "Requests"),
        new("Portal Documents", "Govern document center access, categories, upload rules, and sharing permissions.", "/tenant/portal/documents", "bi-folder2", "Documents"),
        new("Portal Notifications", "Configure portal alerts, reminders, digest rules, push/email/SMS routing, and opt-outs.", "/tenant/portal/alerts", "bi-bell-gear", "Notifications"),
        new("Mobile App Settings", "Manage mobile app identity, store links, push settings, biometrics, and mobile feature access.", "/tenant/portal/mobile", "bi-phone", "Mobile"),
        new("Portal Activity", "Monitor portal login, document, request, payment, message, and security activity.", "/tenant/portal/activity", "bi-activity", "Activity")
    ];

    private readonly PortalModule[] _quickActions =
    [
        new("Branding", "", "/tenant/portal/branding", "bi-palette", "Branding"),
        new("Users", "", "/tenant/portal/users", "bi-people", "Users"),
        new("Requests", "", "/tenant/portal/requests", "bi-tools", "Requests"),
        new("Activity", "", "/tenant/portal/activity", "bi-activity", "Activity")
    ];

    private IEnumerable<PortalWorkflowItem> FilteredWorkflow => _workflow.Where(item =>
        (string.IsNullOrWhiteSpace(_filter) || _filter switch
        {
            "risk" => item.Risk == "High",
            "users" => item.Domain == "Users",
            "requests" => item.Domain == "Requests",
            "mobile" => item.Domain == "Mobile",
            _ => true
        }) &&
        (string.IsNullOrWhiteSpace(_search) ||
         item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Domain.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Control.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(x => x.Risk == "High")
        .ThenBy(x => x.Stage)
        .ThenBy(x => x.Title);

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Client Portal Setup", "/tenant/portal/branding"));
        BuildWorkflow();
        _selected = _workflow.FirstOrDefault(x => x.Risk == "High") ?? _workflow.FirstOrDefault();
    }

    private void BuildWorkflow()
    {
        _workflow.Clear();
        _workflow.AddRange(
        [
            new("Portal domain verification", "Custom portal domain is pending DNS verification before branding can go live.", "Branding", "High", "Brand", "Diana Perez", "Today", "Domain and TLS validation", "/tenant/portal/branding"),
            new("Brand package approval", "Updated portal colors, logo, support contact, and welcome message require tenant admin approval.", "Branding", "Medium", "Brand", "Sarah Kim", "This week", "Brand governance", "/tenant/portal/branding"),
            new("Pending portal invites", "38 portal user invites remain unaccepted and need reminder or cleanup action.", "Users", "Medium", "Invite", "James Park", "7 days", "Invite lifecycle", "/tenant/portal/users"),
            new("Suspended user review", "Portal user access exceptions require security review and account relationship validation.", "Users", "High", "Invite", "Kevin Obi", "24h", "Access review", "/tenant/portal/users"),
            new("Feature rollout readiness", "Self-service billing, certificate requests, and policy document access are staged for rollout.", "Features", "Medium", "Enable", "Maria Santos", "This week", "Feature rollout approval", "/tenant/portal/features"),
            new("Document center permissions", "Portal document categories need permission review for commercial and personal lines clients.", "Documents", "High", "Enable", "Lisa Chen", "48h", "Document access policy", "/tenant/portal/documents"),
            new("Service request routing", "New endorsement and certificate request types need SLA, routing, and required field validation.", "Requests", "High", "Route", "Robert Yamamoto", "Today", "Request routing policy", "/tenant/portal/requests"),
            new("Notification delivery rules", "Portal alert digests and SMS/push routing need validation after communications settings update.", "Notifications", "Medium", "Route", "Sarah Kim", "This week", "Notification governance", "/tenant/portal/alerts"),
            new("Mobile app readiness", "Mobile app version, store links, push notifications, and biometric settings need final review.", "Mobile", "Medium", "Monitor", "Diana Perez", "5 days", "Mobile release checklist", "/tenant/portal/mobile"),
            new("Portal activity warnings", "Recent activity log contains failed login warnings and document access anomalies.", "Activity", "High", "Monitor", "Kevin Obi", "Same day", "Activity audit", "/tenant/portal/activity")
        ]);
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _filter = string.Empty;
    }

    private void Advance(PortalWorkflowItem item)
    {
        item.Stage = item.Stage switch
        {
            "Brand" => "Invite",
            "Invite" => "Enable",
            "Enable" => "Route",
            "Route" => "Monitor",
            _ => "Monitor"
        };
    }

    private int FilterCount(string key) => key switch
    {
        "risk" => _workflow.Count(x => x.Risk == "High"),
        "users" => _workflow.Count(x => x.Domain == "Users"),
        "requests" => _workflow.Count(x => x.Domain == "Requests"),
        "mobile" => _workflow.Count(x => x.Domain == "Mobile"),
        _ => _workflow.Count
    };

    private static string ToneCss(string domain) => domain switch
    {
        "Branding" => "cps-tone-violet",
        "Users" => "cps-tone-blue",
        "Features" => "cps-tone-green",
        "Requests" => "cps-tone-amber",
        "Documents" => "cps-tone-cyan",
        "Notifications" => "cps-tone-red",
        "Mobile" => "cps-tone-violet",
        "Activity" => "cps-tone-neutral",
        _ => "cps-tone-neutral"
    };

    private static string RiskCss(string risk) => risk switch
    {
        "High" => "cps-status-high",
        "Medium" => "cps-status-medium",
        _ => "cps-status-low"
    };

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="cps-kpi-card">
        <span class="cps-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span>
        <div>
            <strong>@value</strong>
            <span>@label</span>
            <small>@meta</small>
        </div>
    </article>;

    private sealed record Lane(string Key, string Label, string Description);
    private sealed record Filter(string Key, string Label);
    private sealed record PortalModule(string Title, string Description, string Url, string Icon, string Domain)
    {
        public string Label => Title;
    }

    private sealed class PortalWorkflowItem(string title, string summary, string domain, string risk, string stage, string owner, string sla, string control, string url)
    {
        public string Title { get; set; } = title;
        public string Summary { get; set; } = summary;
        public string Domain { get; set; } = domain;
        public string Risk { get; set; } = risk;
        public string Stage { get; set; } = stage;
        public string Owner { get; set; } = owner;
        public string Sla { get; set; } = sla;
        public string Control { get; set; } = control;
        public string Url { get; set; } = url;
    }
}
