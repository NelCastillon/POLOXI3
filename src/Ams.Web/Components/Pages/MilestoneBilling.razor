@page "/billing/milestone-billing"
@inject ApiClient Api

<PageTitle>Milestone Billing</PageTitle>
<AppPageHeader Title="Milestone Billing Links" Icon="bi-flag" />
<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(MilestoneBillingLinkDto.MilestoneId)"      HeaderText="Milestone"   Width="300"></GridColumn>
        <GridColumn Field="@nameof(MilestoneBillingLinkDto.BillingAmount)"    HeaderText="Amount"      Width="130" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(MilestoneBillingLinkDto.StatusCode)"       HeaderText="Status"      Width="120"></GridColumn>
        <GridColumn Field="@nameof(MilestoneBillingLinkDto.TriggeredDateUtc)" HeaderText="Triggered"   Type="ColumnType.DateTime" Format="d" Width="140"></GridColumn>
        <GridColumn Field="@nameof(MilestoneBillingLinkDto.Notes)"            HeaderText="Notes"       Width="280"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<MilestoneBillingLinkDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchMilestoneBillingLinksAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
