@page "/sod/rules"
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Sod
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>SoD Rules</PageTitle>

<div class="sod-shell">

    <!-- ── Header ──────────────────────────────────────────────────────────── -->
    <div class="sod-header">
        <div class="sod-header-left">
            <nav class="sod-breadcrumb" aria-label="breadcrumb">
                <a href="/" class="sod-bc-link">Home</a>
                <span class="sod-bc-sep" aria-hidden="true">›</span>
                <span class="sod-bc-current">SoD Rules</span>
            </nav>
            <h1 class="sod-title">
                <i class="bi bi-diagram-3" aria-hidden="true"></i>
                Segregation of Duties Rules
            </h1>
        </div>
        <div class="sod-header-right">
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
            </button>
            <button class="um-btn um-btn-primary" @onclick="OpenCreate">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> New Rule
            </button>
        </div>
    </div>

    <!-- ── KPI strip ───────────────────────────────────────────────────────── -->
    <div class="sod-kpi-strip">
        <div class="sod-kpi">
            <span class="sod-kpi-value">@_all.Count</span>
            <span class="sod-kpi-label">Total Rules</span>
        </div>
        <div class="sod-kpi sod-kpi--active">
            <span class="sod-kpi-value">@_all.Count(r => r.IsActive)</span>
            <span class="sod-kpi-label">Active</span>
        </div>
        <div class="sod-kpi sod-kpi--inactive">
            <span class="sod-kpi-value">@_all.Count(r => !r.IsActive)</span>
            <span class="sod-kpi-label">Inactive</span>
        </div>
        <div class="sod-kpi sod-kpi--critical">
            <span class="sod-kpi-value">@_all.Count(r => r.SeverityCode is "High" or "Critical")</span>
            <span class="sod-kpi-label">High / Critical</span>
        </div>
    </div>

    <!-- ── Filter row ──────────────────────────────────────────────────────── -->
    <div class="sod-filter-row">
        <div class="sod-search-wrap">
            <i class="bi bi-search sod-search-icon" aria-hidden="true"></i>
            <input class="sod-search-input"
                   type="text"
                   placeholder="Search rule code or name…"
                   value="@_searchTerm"
                   @oninput="OnSearchInput" />
        </div>
        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_severityOptions"
                        Placeholder="All Severities"
                        ShowClearButton="true"
                        Width="160px"
                        Value="_filterSeverity"
                        ValueChanged="@((string v) => { _filterSeverity = v; ApplyFilter(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>
        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_statusOptions"
                        Placeholder="All Statuses"
                        ShowClearButton="true"
                        Width="150px"
                        Value="_filterStatus"
                        ValueChanged="@((string v) => { _filterStatus = v; ApplyFilter(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>
    </div>

    <!-- ── Table ───────────────────────────────────────────────────────────── -->
    @if (_loading)
    {
        <div class="sod-loading">
            <span class="um-spin" aria-hidden="true"></span>
            Loading SoD rules…
        </div>
    }
    else if (_filtered.Count == 0)
    {
        <div class="sod-empty">
            <i class="bi bi-diagram-3 sod-empty-icon" aria-hidden="true"></i>
            <p>@(_all.Count == 0 ? "No SoD rules defined yet." : "No rules match the current filters.")</p>
            @if (_all.Count == 0)
            {
                <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> New Rule
                </button>
            }
        </div>
    }
    else
    {
        <div class="sod-table-wrap">
            <table class="sod-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Rule Name</th>
                        <th>Role A ↔ Role B</th>
                        <th>Permissions</th>
                        <th>Severity</th>
                        <th>Exception Policy</th>
                        <th>Status</th>
                        <th class="sod-th-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rule in _filtered)
                    {
                        <tr class="@(rule.IsActive ? "" : "sod-row--inactive")">
                            <td><span class="sod-code">@rule.RuleCode</span></td>
                            <td>
                                <div class="sod-rule-name">@rule.RuleName</div>
                                @if (!string.IsNullOrEmpty(rule.Description))
                                {
                                    <div class="sod-rule-desc">@rule.Description</div>
                                }
                            </td>
                            <td>
                                <div class="sod-roles-cell">
                                    <span class="sod-role-badge">@rule.RoleAName</span>
                                    <i class="bi bi-arrow-left-right sod-roles-arrow" aria-hidden="true"></i>
                                    <span class="sod-role-badge">@rule.RoleBName</span>
                                </div>
                            </td>
                            <td>
                                <div class="sod-perms-cell">
                                    @if (rule.PermissionAName is not null)
                                    {
                                        <span class="sod-perm-tag">@rule.PermissionAName</span>
                                    }
                                    @if (rule.PermissionBName is not null)
                                    {
                                        <span class="sod-perm-tag">@rule.PermissionBName</span>
                                    }
                                    @if (rule.PermissionAName is null && rule.PermissionBName is null)
                                    {
                                        <span class="sod-perm-none">—</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="sod-severity-badge sod-severity-badge--@rule.SeverityCode.ToLower()">
                                    @rule.SeverityCode
                                </span>
                            </td>
                            <td>
                                <span class="sod-policy-tag">@ExceptionPolicyLabel(rule.ExceptionPolicyCode)</span>
                            </td>
                            <td>
                                <span class="sod-status-badge @(rule.IsActive ? "sod-status-badge--active" : "sod-status-badge--inactive")">
                                    @(rule.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="sod-td-actions">
                                @if (!rule.IsSystemDefined)
                                {
                                    <button class="sod-action-btn sod-action-btn--edit"
                                            title="Edit"
                                            @onclick="() => OpenEdit(rule)">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </button>
                                }
                                <button class="sod-action-btn @(rule.IsActive ? "sod-action-btn--deactivate" : "sod-action-btn--activate")"
                                        title="@(rule.IsActive ? "Deactivate" : "Activate")"
                                        @onclick="() => ToggleActiveAsync(rule)">
                                    <i class="bi @(rule.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i>
                                </button>
                                <button class="sod-action-btn sod-action-btn--clone"
                                        title="Clone"
                                        @onclick="() => OpenClone(rule)">
                                    <i class="bi bi-copy" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="sod-results-footer">
            Showing <strong>@_filtered.Count</strong> of <strong>@_all.Count</strong> rules
        </div>
    }

</div>

<!-- ── Form dialog (Create / Edit) ───────────────────────────────────────── -->
<SfDialog Width="680px"
          Visible="_formVisible"
          IsModal="true"
          ShowCloseIcon="true"
          CloseOnEscape="true">
    <DialogEvents Closed="OnDialogClosed" />
    <DialogTemplates>
        <Header>
            <span class="sod-dlg-icon sod-dlg-icon--form" aria-hidden="true">
                <i class="bi @(_isEditMode ? "bi-pencil" : "bi-plus-lg")"></i>
            </span>
            @(_isEditMode ? "Edit SoD Rule" : "New SoD Rule")
        </Header>
        <Content>
            <div class="sod-dlg-body">
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="sod-dlg-error">
                        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                        @_formError
                    </div>
                }
                <div class="sod-form-grid">
                    <div class="sod-field">
                        <label class="sod-label">Rule Code <span class="sod-req">*</span></label>
                        <SfTextBox @bind-Value="_form.RuleCode" Placeholder="e.g. SOD-001" />
                        @if (_validate && string.IsNullOrWhiteSpace(_form.RuleCode))
                        {
                            <span class="sod-validation">Rule code is required.</span>
                        }
                    </div>
                    <div class="sod-field">
                        <label class="sod-label">Rule Name <span class="sod-req">*</span></label>
                        <SfTextBox @bind-Value="_form.RuleName" Placeholder="e.g. Segregate AP from GL" />
                        @if (_validate && string.IsNullOrWhiteSpace(_form.RuleName))
                        {
                            <span class="sod-validation">Rule name is required.</span>
                        }
                    </div>
                    <div class="sod-field sod-field--full">
                        <label class="sod-label">Description</label>
                        <SfTextBox @bind-Value="_form.Description"
                                   Multiline="true"
                                   Placeholder="Describe the conflict this rule detects…" />
                    </div>
                    <div class="sod-field">
                        <label class="sod-label">Role A <span class="sod-req">*</span></label>
                        <SfDropDownList TValue="Guid" TItem="RoleDto"
                                        DataSource="@_roles"
                                        @bind-Value="_form.RoleAId"
                                        AllowFiltering="true"
                                        Placeholder="Select Role A…">
                            <DropDownListFieldSettings Value="RoleId" Text="RoleName" />
                        </SfDropDownList>
                        @if (_validate && _form.RoleAId == Guid.Empty)
                        {
                            <span class="sod-validation">Role A is required.</span>
                        }
                    </div>
                    <div class="sod-field">
                        <label class="sod-label">Role B <span class="sod-req">*</span></label>
                        <SfDropDownList TValue="Guid" TItem="RoleDto"
                                        DataSource="@_roles"
                                        @bind-Value="_form.RoleBId"
                                        AllowFiltering="true"
                                        Placeholder="Select Role B…">
                            <DropDownListFieldSettings Value="RoleId" Text="RoleName" />
                        </SfDropDownList>
                        @if (_validate && _form.RoleBId == Guid.Empty)
                        {
                            <span class="sod-validation">Role B is required.</span>
                        }
                        @if (_validate && _form.RoleAId != Guid.Empty && _form.RoleBId != Guid.Empty && _form.RoleAId == _form.RoleBId)
                        {
                            <span class="sod-validation">Role A and Role B must be different.</span>
                        }
                    </div>
                    <div class="sod-field">
                        <label class="sod-label">Permission A</label>
                        <SfDropDownList TValue="Guid?" TItem="PermissionDto"
                                        DataSource="@_permissions"
                                        @bind-Value="_form.PermissionAId"
                                        AllowFiltering="true"
                                        ShowClearButton="true"
                                        Placeholder="Optional permission conflict…">
                            <DropDownListFieldSettings Value="PermissionId" Text="PermissionName" />
                        </SfDropDownList>
                    </div>
                    <div class="sod-field">
                        <label class="sod-label">Permission B</label>
                        <SfDropDownList TValue="Guid?" TItem="PermissionDto"
                                        DataSource="@_permissions"
                                        @bind-Value="_form.PermissionBId"
                                        AllowFiltering="true"
                                        ShowClearButton="true"
                                        Placeholder="Optional permission conflict…">
                            <DropDownListFieldSettings Value="PermissionId" Text="PermissionName" />
                        </SfDropDownList>
                    </div>
                    <div class="sod-field">
                        <label class="sod-label">Severity <span class="sod-req">*</span></label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_severityOptions"
                                        @bind-Value="_form.SeverityCode"
                                        Placeholder="Select severity…">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                        @if (_validate && string.IsNullOrEmpty(_form.SeverityCode))
                        {
                            <span class="sod-validation">Severity is required.</span>
                        }
                    </div>
                    <div class="sod-field">
                        <label class="sod-label">Exception Policy</label>
                        <SfDropDownList TValue="string" TItem="LabelValue"
                                        DataSource="_exceptionPolicyOptions"
                                        @bind-Value="_form.ExceptionPolicyCode"
                                        ShowClearButton="true"
                                        Placeholder="Select exception policy…">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                    <div class="sod-field sod-field--full">
                        <label class="sod-label">Reason</label>
                        <SfTextBox @bind-Value="_form.Reason"
                                   Multiline="true"
                                   Placeholder="Regulatory or business justification for this rule…" />
                    </div>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="sod-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="CloseFormDialog" disabled="@_processing">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="SaveRuleAsync" disabled="@_processing">
                    @if (_processing)
                    {
                        <span class="um-spin" aria-hidden="true"></span>
                        <span>Saving…</span>
                    }
                    else
                    {
                        <i class="bi @(_isEditMode ? "bi-check-lg" : "bi-plus-lg")" aria-hidden="true"></i>
                        <span>@(_isEditMode ? "Save Changes" : "Create Rule")</span>
                    }
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ── Clone dialog ──────────────────────────────────────────────────────── -->
<SfDialog Width="440px"
          Visible="_cloneVisible"
          IsModal="true"
          ShowCloseIcon="true"
          CloseOnEscape="true">
    <DialogEvents Closed="OnCloneDialogClosed" />
    <DialogTemplates>
        <Header>
            <span class="sod-dlg-icon sod-dlg-icon--clone" aria-hidden="true">
                <i class="bi bi-copy"></i>
            </span>
            Clone Rule
        </Header>
        <Content>
            <div class="sod-dlg-body">
                @if (!string.IsNullOrEmpty(_cloneError))
                {
                    <div class="sod-dlg-error">
                        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                        @_cloneError
                    </div>
                }
                @if (_cloneSource is not null)
                {
                    <p class="sod-dlg-clone-src">
                        Cloning from: <strong>@_cloneSource.RuleName</strong>
                        <span class="sod-code">(@_cloneSource.RuleCode)</span>
                    </p>
                }
                <div class="sod-form-grid">
                    <div class="sod-field sod-field--full">
                        <label class="sod-label">New Rule Code <span class="sod-req">*</span></label>
                        <SfTextBox @bind-Value="_cloneCode" Placeholder="e.g. SOD-002" />
                        @if (_validateClone && string.IsNullOrWhiteSpace(_cloneCode))
                        {
                            <span class="sod-validation">New rule code is required.</span>
                        }
                    </div>
                    <div class="sod-field sod-field--full">
                        <label class="sod-label">New Rule Name <span class="sod-req">*</span></label>
                        <SfTextBox @bind-Value="_cloneName" Placeholder="e.g. Copy of Segregate AP from GL" />
                        @if (_validateClone && string.IsNullOrWhiteSpace(_cloneName))
                        {
                            <span class="sod-validation">New rule name is required.</span>
                        }
                    </div>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="sod-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="CloseCloneDialog" disabled="@_processing">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="ExecuteCloneAsync" disabled="@_processing">
                    @if (_processing)
                    {
                        <span class="um-spin" aria-hidden="true"></span>
                        <span>Cloning…</span>
                    }
                    else
                    {
                        <i class="bi bi-copy" aria-hidden="true"></i>
                        <span>Clone Rule</span>
                    }
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ── Toast ─────────────────────────────────────────────────────────────── -->
<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private Guid _currentUserId;

    private SfToast? _toast;

    // ── Data ───────────────────────────────────────────────────────────────────
    private List<SegregationOfDutyRuleDto> _all         = [];
    private List<SegregationOfDutyRuleDto> _filtered    = [];
    private List<RoleDto>                  _roles       = [];
    private List<PermissionDto>            _permissions = [];

    // ── Filter state ───────────────────────────────────────────────────────────
    private bool   _loading        = true;
    private string _searchTerm     = string.Empty;
    private string _filterSeverity = string.Empty;
    private string _filterStatus   = string.Empty;

    // ── Form dialog state ──────────────────────────────────────────────────────
    private bool         _formVisible = false;
    private bool         _isEditMode  = false;
    private bool         _processing  = false;
    private bool         _validate    = false;
    private string       _formError   = string.Empty;
    private Guid         _editingId   = Guid.Empty;
    private SodFormModel _form        = new();

    // ── Clone dialog state ─────────────────────────────────────────────────────
    private bool                      _cloneVisible  = false;
    private bool                      _validateClone = false;
    private string                    _cloneCode     = string.Empty;
    private string                    _cloneName     = string.Empty;
    private string                    _cloneError    = string.Empty;
    private SegregationOfDutyRuleDto? _cloneSource   = null;

    // ── Static options ─────────────────────────────────────────────────────────
    private static readonly List<LabelValue> _severityOptions =
    [
        new("Low",      "Low"),
        new("Medium",   "Medium"),
        new("High",     "High"),
        new("Critical", "Critical"),
    ];

    private static readonly List<LabelValue> _statusOptions =
    [
        new("Active",   "Active"),
        new("Inactive", "Inactive"),
    ];

    private static readonly List<LabelValue> _exceptionPolicyOptions =
    [
        new("None",             "None"),
        new("RequiresApproval", "Requires Approval"),
        new("AutoApprove",      "Auto-Approve"),
    ];

    // ── Lifecycle ──────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadReferenceDataAsync();
        await LoadAsync();
    }

    // ── Data loading ───────────────────────────────────────────────────────────
    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var result = await Api.SearchSodRulesAsync(_tenantId, pageSize: 500);
            _all = result?.Items?.ToList() ?? [];
            ApplyFilter();
        }
        catch
        {
            _all = [];
            await _toast!.ShowAsync(new ToastModel
            {
                Content  = "Failed to load SoD rules.",
                CssClass = "e-toast-danger",
                Icon     = "bi bi-exclamation-triangle",
            });
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadReferenceDataAsync()
    {
        try
        {
            var roles = await Api.SearchRolesAsync(_tenantId);
            var perms = await Api.SearchPermissionsAsync(_tenantId, pageSize: 500);
            _roles       = roles?.Items?.ToList() ?? [];
            _permissions = perms?.Items?.ToList() ?? [];
        }
        catch { /* non-fatal — dropdowns will be empty */ }
    }

    // ── Filtering ──────────────────────────────────────────────────────────────
    private void OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var q = _searchTerm.Trim().ToLowerInvariant();
        _filtered = _all.Where(r =>
            (string.IsNullOrEmpty(q) ||
             r.RuleCode.ToLowerInvariant().Contains(q) ||
             r.RuleName.ToLowerInvariant().Contains(q)) &&
            (string.IsNullOrEmpty(_filterSeverity) || r.SeverityCode == _filterSeverity) &&
            (_filterStatus switch
            {
                "Active"   => r.IsActive,
                "Inactive" => !r.IsActive,
                _          => true,
            })).ToList();
    }

    // ── Form dialog ────────────────────────────────────────────────────────────
    private void OpenCreate()
    {
        _isEditMode  = false;
        _editingId   = Guid.Empty;
        _form        = new();
        _validate    = false;
        _formError   = string.Empty;
        _formVisible = true;
    }

    private void OpenEdit(SegregationOfDutyRuleDto rule)
    {
        _isEditMode = true;
        _editingId  = rule.SodRuleId;
        _form = new SodFormModel
        {
            RuleCode            = rule.RuleCode,
            RuleName            = rule.RuleName,
            Description         = rule.Description,
            RoleAId             = rule.RoleAId,
            RoleBId             = rule.RoleBId,
            PermissionAId       = rule.PermissionAId,
            PermissionBId       = rule.PermissionBId,
            SeverityCode        = rule.SeverityCode,
            Reason              = rule.Reason,
            ExceptionPolicyCode = rule.ExceptionPolicyCode,
        };
        _validate    = false;
        _formError   = string.Empty;
        _formVisible = true;
    }

    private void CloseFormDialog() => _formVisible = false;

    private void OnDialogClosed()
    {
        _formVisible = false;
        _validate    = false;
        _formError   = string.Empty;
    }

    private async Task SaveRuleAsync()
    {
        _validate = true;
        if (!IsFormValid()) return;

        _processing = true;
        _formError  = string.Empty;
        try
        {
            if (_isEditMode)
            {
                await Api.UpdateSodRuleAsync(_editingId, new UpdateSodRuleRequest
                {
                    RuleCode            = _form.RuleCode,
                    RuleName            = _form.RuleName,
                    Description         = _form.Description,
                    RoleAId             = _form.RoleAId,
                    RoleBId             = _form.RoleBId,
                    PermissionAId       = _form.PermissionAId,
                    PermissionBId       = _form.PermissionBId,
                    SeverityCode        = _form.SeverityCode,
                    Reason              = _form.Reason,
                    ExceptionPolicyCode = _form.ExceptionPolicyCode,
                    ModifiedByUserId    = _currentUserId,
                });
                await _toast!.ShowAsync(new ToastModel
                {
                    Content  = "Rule updated successfully.",
                    CssClass = "e-toast-success",
                    Icon     = "bi bi-check-circle",
                });
            }
            else
            {
                await Api.CreateSodRuleAsync(new CreateSodRuleRequest
                {
                    TenantId            = _tenantId,
                    RuleCode            = _form.RuleCode,
                    RuleName            = _form.RuleName,
                    Description         = _form.Description,
                    RoleAId             = _form.RoleAId,
                    RoleBId             = _form.RoleBId,
                    PermissionAId       = _form.PermissionAId,
                    PermissionBId       = _form.PermissionBId,
                    SeverityCode        = _form.SeverityCode,
                    Reason              = _form.Reason,
                    ExceptionPolicyCode = _form.ExceptionPolicyCode,
                    CreatedByUserId     = _currentUserId,
                });
                await _toast!.ShowAsync(new ToastModel
                {
                    Content  = "Rule created successfully.",
                    CssClass = "e-toast-success",
                    Icon     = "bi bi-check-circle",
                });
            }
            _formVisible = false;
            await LoadAsync();
        }
        catch
        {
            _formError = "An error occurred while saving. Please try again.";
        }
        finally
        {
            _processing = false;
        }
    }

    private bool IsFormValid() =>
        !string.IsNullOrWhiteSpace(_form.RuleCode)  &&
        !string.IsNullOrWhiteSpace(_form.RuleName)  &&
        _form.RoleAId    != Guid.Empty              &&
        _form.RoleBId    != Guid.Empty              &&
        _form.RoleAId    != _form.RoleBId           &&
        !string.IsNullOrEmpty(_form.SeverityCode);

    // ── Activate / Deactivate ──────────────────────────────────────────────────
    private async Task ToggleActiveAsync(SegregationOfDutyRuleDto rule)
    {
        var wasActive = rule.IsActive;
        try
        {
            await Api.SetSodRuleActiveAsync(rule.SodRuleId, !wasActive, _currentUserId);
            await _toast!.ShowAsync(new ToastModel
            {
                Content  = wasActive ? "Rule deactivated." : "Rule activated.",
                CssClass = "e-toast-success",
                Icon     = "bi bi-check-circle",
            });
            await LoadAsync();
        }
        catch
        {
            await _toast!.ShowAsync(new ToastModel
            {
                Content  = "Failed to update rule status.",
                CssClass = "e-toast-danger",
                Icon     = "bi bi-exclamation-triangle",
            });
        }
    }

    // ── Clone dialog ───────────────────────────────────────────────────────────
    private void OpenClone(SegregationOfDutyRuleDto rule)
    {
        _cloneSource   = rule;
        _cloneCode     = string.Empty;
        _cloneName     = $"Copy of {rule.RuleName}";
        _cloneError    = string.Empty;
        _validateClone = false;
        _cloneVisible  = true;
    }

    private void CloseCloneDialog() => _cloneVisible = false;

    private void OnCloneDialogClosed()
    {
        _cloneVisible  = false;
        _validateClone = false;
        _cloneError    = string.Empty;
    }

    private async Task ExecuteCloneAsync()
    {
        _validateClone = true;
        if (string.IsNullOrWhiteSpace(_cloneCode) || string.IsNullOrWhiteSpace(_cloneName)) return;

        _processing = true;
        _cloneError = string.Empty;
        try
        {
            await Api.CloneSodRuleAsync(_cloneSource!.SodRuleId, new CloneSodRuleRequest
            {
                NewRuleCode    = _cloneCode,
                NewRuleName    = _cloneName,
                ClonedByUserId = _currentUserId,
            });
            await _toast!.ShowAsync(new ToastModel
            {
                Content  = "Rule cloned successfully.",
                CssClass = "e-toast-success",
                Icon     = "bi bi-check-circle",
            });
            _cloneVisible = false;
            await LoadAsync();
        }
        catch
        {
            _cloneError = "Failed to clone rule. Please try again.";
        }
        finally
        {
            _processing = false;
        }
    }

    // ── Helpers ────────────────────────────────────────────────────────────────
    private static string ExceptionPolicyLabel(string? code) => code switch
    {
        "RequiresApproval" => "Requires Approval",
        "AutoApprove"      => "Auto-Approve",
        _                  => "None",
    };

