@page "/finance/bank-reconciliation"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos

<PageTitle>Bank Reconciliation</PageTitle>

<AppPageHeader Title="Bank Reconciliation"
               Subtitle="Reconcile bank statements with ledger records"
               Icon="bi-bank2">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "fa-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Reconciliation
        </button>
    </Actions>
</AppPageHeader>

<!-- ── Search & Filter ──────────────────────────────────────────────────── -->
<div class="fin-toolbar">
    <div class="fin-search-box">
        <i class="bi bi-search fin-search-icon" aria-hidden="true"></i>
        <input class="e-input fin-search-input"
               placeholder="Search reconciliations…"
               @bind="_searchTerm"
               @bind:event="oninput"
               @onkeyup="@(e => e.Key == "Enter" ? LoadAsync() : Task.CompletedTask)" />
    </div>
    <div class="fin-filter-buttons">
        <button class="um-btn um-btn-ghost um-btn-sm @(_filterActive ? "um-btn-active" : "")"
                @onclick="() => _filterActive = !_filterActive">
            <i class="bi bi-funnel" aria-hidden="true"></i> Filter
        </button>
    </div>
</div>

@if (_filterActive)
{
    <div class="fin-filter-panel">
        <div class="fin-filter-group">
            <label class="fin-filter-label">Status</label>
            <select class="e-input" @bind="_filterStatus">
                <option value="">All</option>
                <option value="Reconciled">Reconciled</option>
                <option value="Pending">Pending</option>
            </select>
        </div>
    </div>
}

<!-- ── KPI Cards ──────────────────────────────────────────────────────── -->
@if (_stats is not null)
{
    <div class="fin-kpi-strip">
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #dbeafe; color: #1d4ed8;"><i class="bi bi-bank-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.TotalReconciliations</div>
                <div class="fin-kpi-label">Total Reconciliations</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #d1fae5; color: #047857;"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.ReconciledCount</div>
                <div class="fin-kpi-label">Reconciled</div>
            </div>
        </div>
        <div class="fin-kpi-card">
            <div class="fin-kpi-icon" style="background: #fef3c7; color: #b45309;"><i class="bi bi-hourglass-split" aria-hidden="true"></i></div>
            <div class="fin-kpi-body">
                <div class="fin-kpi-value">@_stats.PendingCount</div>
                <div class="fin-kpi-label">Pending</div>
            </div>
        </div>
    </div>
}

<!-- ── Content ──────────────────────────────────────────────────────── -->
@if (_error is not null)
{
    <div class="fin-alert fin-alert-warning">
        <div class="fin-alert-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></div>
        <div class="fin-alert-body">
            <div class="fin-alert-title">⚠️ Database Schema Issue</div>
            <p>Finance schema initialization required. Run: <strong>sql/01_Finance_Schema.sql</strong></p>
        </div>
    </div>
}
else if (_loading)
{
    <div class="fin-loading">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading Bank Reconciliations…</span>
    </div>
}
else if (_items?.Count == 0)
{
    <div class="fin-empty-state">
        <i class="bi bi-inbox fin-empty-icon" aria-hidden="true"></i>
        <h3>No Reconciliations Found</h3>
        <p>No bank reconciliations have been created yet.</p>
    </div>
}
else
{
    <div class="fin-grid-container">
        <SfGrid TValue="BankReconciliationDto" DataSource="_items" AllowPaging="true" AllowSorting="true" Height="600px">
            <GridEvents TValue="BankReconciliationDto" RowSelected="OnRowSelected" />
            <GridPageSettings PageSize="12"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(BankReconciliationDto.BankAccountNumber)" HeaderText="Bank Account" Width="140" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(BankReconciliationDto.BankName)" HeaderText="Bank Name" Width="140"></GridColumn>
                <GridColumn Field="@nameof(BankReconciliationDto.BankStatementDate)" HeaderText="Statement Date" Type="ColumnType.Date" Format="d" Width="130" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(BankReconciliationDto.BankBalance)" HeaderText="Bank Balance" Format="C2" Width="130" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(BankReconciliationDto.BookBalance)" HeaderText="Book Balance" Format="C2" Width="130" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(BankReconciliationDto.Discrepancy)" HeaderText="Variance" Format="C2" Width="110" AllowSorting="true"></GridColumn>
                <GridColumn Field="@nameof(BankReconciliationDto.StatusCode)" HeaderText="Status" Width="100" AllowSorting="true">
                    <Template>
                        @{
                            var recon = context as BankReconciliationDto;
                            var badgeClass = recon?.StatusCode switch
                            {
                                "Reconciled" => "fin-badge-success",
                                "Pending" => "fin-badge-warning",
                                _ => "fin-badge-secondary"
                            };
                        }
                        <span class="fin-badge @badgeClass">@recon?.StatusCode</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Actions" Width="90">
                    <Template>
                        @{ var recon = (BankReconciliationDto)context; }
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenEdit(recon)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
}

<SfDialog @bind-Visible="_showForm" Width="680px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-bank" aria-hidden="true"></i><span>@(_editingId == Guid.Empty ? "New Bank Reconciliation" : "Edit Bank Reconciliation")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Bank Account Number <span class="text-danger">*</span></label><InputText @bind-Value="_form.BankAccountNumber" class="um-input" /><ValidationMessage For="() => _form.BankAccountNumber" class="text-danger" /></div>
                    <div class="um-field"><label>Bank Name <span class="text-danger">*</span></label><InputText @bind-Value="_form.BankName" class="um-input" /><ValidationMessage For="() => _form.BankName" class="text-danger" /></div>
                    <div class="um-field"><label>Statement Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.BankStatementDate" class="um-input" /><ValidationMessage For="() => _form.BankStatementDate" class="text-danger" /></div>
                    <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input"><option value="Pending">Pending</option><option value="Reconciled">Reconciled</option><option value="Exception">Exception</option></InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
                    <div class="um-field"><label>Bank Balance</label><InputNumber @bind-Value="_form.BankBalance" class="um-input" /><ValidationMessage For="() => _form.BankBalance" class="text-danger" /></div>
                    <div class="um-field"><label>Book Balance</label><InputNumber @bind-Value="_form.BookBalance" class="um-input" /><ValidationMessage For="() => _form.BookBalance" class="text-danger" /></div>
                    <div class="um-field"><label>Variance</label><input class="um-input" value="@((_form.BankBalance - _form.BookBalance).ToString("C2"))" disabled /></div>
                    @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Reconciliation")</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private string _filterStatus = "";
    private bool _filterActive = false;
    private bool _loading = false;
    private bool _showForm;
    private bool _saving;
    private List<BankReconciliationDto>? _items;
    private string? _error;
    private string? _formError;
    private Guid _editingId = Guid.Empty;
    private BankReconForm _form = new();
    private EditContext _editContext = default!;

    private class Stats
    {
        public int TotalReconciliations { get; set; }
        public int ReconciledCount { get; set; }
        public int PendingCount { get; set; }
    }

    private Stats? _stats;

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(
            new("Home", "/"),
            new("Finance", "/finance"),
            new("Bank Reconciliation", "/finance/bank-reconciliation"));
        _editContext = new(_form);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _items = null;
        try
        {
            var result = await Api.SearchBankReconciliationsAsync(_tenantId, _searchTerm);
            _items = result?.Items.ToList() ?? [];

            if (!string.IsNullOrEmpty(_filterStatus))
                _items = _items.Where(x => x.StatusCode == _filterStatus).ToList();

            _stats = new Stats
            {
                TotalReconciliations = _items.Count,
                ReconciledCount = _items.Count(x => x.StatusCode == "Reconciled"),
                PendingCount = _items.Count(x => x.StatusCode == "Pending")
            };
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            if (ex.Message.Contains("Invalid column name") || ex.Message.Contains("BankReconciliation"))
            {
                _error = "Database schema mismatch. Please ensure 00_schema_migration.sql has been applied to your database. See db/README.md for setup instructions.";
            }
            _items = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnRowSelected(RowSelectEventArgs<BankReconciliationDto> args) => OpenEdit(args.Data);
    private void OpenCreate() { _editingId = Guid.Empty; _form = new(); _editContext = new(_form); _formError = null; _showForm = true; }
    private void OpenEdit(BankReconciliationDto recon)
    {
        _editingId = recon.BankReconciliationId;
        _form = new BankReconForm { BankAccountNumber = recon.BankAccountNumber, BankName = recon.BankName, BankStatementDate = recon.BankStatementDate.ToDateTime(TimeOnly.MinValue), BankBalance = recon.BankBalance, BookBalance = recon.BookBalance, StatusCode = recon.StatusCode };
        _editContext = new(_form);
        _formError = null;
        _showForm = true;
    }
    private void CloseForm() => _showForm = false;

    private async Task SaveAsync()
    {
        if (!_editContext.Validate()) return;
        _saving = true;
        try
        {
            if (_editingId == Guid.Empty)
                await Api.CreateBankReconciliationAsync(new CreateBankReconciliationRequest { TenantId = _tenantId, BankAccountNumber = _form.BankAccountNumber, BankName = _form.BankName, BankStatementDate = DateOnly.FromDateTime(_form.BankStatementDate), BankBalance = _form.BankBalance, BookBalance = _form.BookBalance, StatusCode = _form.StatusCode });
            else
                await Api.UpdateBankReconciliationAsync(_editingId, new UpdateBankReconciliationRequest { TenantId = _tenantId, BankReconciliationId = _editingId, BankAccountNumber = _form.BankAccountNumber, BankName = _form.BankName, BankStatementDate = DateOnly.FromDateTime(_form.BankStatementDate), BankBalance = _form.BankBalance, BookBalance = _form.BookBalance, StatusCode = _form.StatusCode });
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; }
        finally { _saving = false; }
    }

    private sealed class BankReconForm
    {
        [Required, StringLength(50)] public string BankAccountNumber { get; set; } = string.Empty;
        [Required, StringLength(150)] public string BankName { get; set; } = string.Empty;
        [Required] public DateTime BankStatementDate { get; set; } = DateTime.Today;
        [Range(0, 100000000)] public decimal BankBalance { get; set; }
        [Range(0, 100000000)] public decimal BookBalance { get; set; }
        [Required, StringLength(50)] public string StatusCode { get; set; } = "Pending";
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
