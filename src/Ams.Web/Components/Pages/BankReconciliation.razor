@page "/finance/bank-reconciliation"
@inject ApiClient Api
@using Ams.Application.Common.Dtos
@using Ams.Web.Services
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons

<h3>Bank Reconciliation</h3>

<div class="mb-3 d-flex gap-2">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="300px" />
    <SfButton OnClick="LoadAsync">Search</SfButton>
</div>

<SfGrid DataSource="_items" AllowPaging="true">
    <GridPageSettings PageSize="10" />
    <GridColumns>
        <GridColumn Field="@nameof(BankReconciliationDto.ReconciliationId)" HeaderText="ID" Width="220" />
        <GridColumn Field="@nameof(BankReconciliationDto.BankAccountCode)" HeaderText="Bank Account" Width="160" />
        <GridColumn Field="@nameof(BankReconciliationDto.StatementDate)" HeaderText="Statement Date" Width="140" />
        <GridColumn Field="@nameof(BankReconciliationDto.StatementBalance)" HeaderText="Statement Balance" Format="C2" Width="160" />
        <GridColumn Field="@nameof(BankReconciliationDto.BookBalance)" HeaderText="Book Balance" Format="C2" Width="140" />
        <GridColumn Field="@nameof(BankReconciliationDto.StatusCode)" HeaderText="Status" Width="120" />
        <GridColumn Field="@nameof(BankReconciliationDto.CreatedDateUtc)" HeaderText="Created" Width="160" />
    </GridColumns>
</SfGrid>

@code {
    private List<BankReconciliationDto>? _items;
    private string? _searchTerm;
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.SearchBankReconciliationsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
