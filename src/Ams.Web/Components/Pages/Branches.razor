@page "/branches"
@page "/admin/agency/branches"
@inject ApiClient Api

<PageTitle>Branches</PageTitle>
<h1>Branches</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(BranchDto.BranchCode)"    HeaderText="Code"    Width="130"></GridColumn>
        <GridColumn Field="@nameof(BranchDto.BranchName)"    HeaderText="Name"    Width="220"></GridColumn>
        <GridColumn Field="@nameof(BranchDto.City)"          HeaderText="City"    Width="140"></GridColumn>
        <GridColumn Field="@nameof(BranchDto.StateProvince)" HeaderText="State"   Width="120"></GridColumn>
        <GridColumn Field="@nameof(BranchDto.CountryCode)"   HeaderText="Country" Width="100"></GridColumn>
        <GridColumn Field="@nameof(BranchDto.IsActive)"      HeaderText="Active"  Width="90"  DisplayAsCheckBox="true"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<BranchDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchBranchesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
