@page "/policies/new"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>New Policy — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<!-- ── PAGE HEADER ───────────────────────────────────────────────────── -->
<div class="npw-page-header">
    <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies")'>
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Policies
    </button>
    <div class="npw-page-title">
        <i class="bi bi-shield-plus npw-title-icon" aria-hidden="true"></i>
        <div>
            <h1 class="npw-h1">New Policy</h1>
            <span class="npw-subtitle">Complete all steps to bind and issue a new policy.</span>
        </div>
    </div>
    @if (_step > 0)
    {
        <div class="npw-header-draft">
            <i class="bi bi-floppy" aria-hidden="true"></i>
            <span>Draft auto-saved</span>
        </div>
    }
</div>

<!-- ── STEPPER ──────────────────────────────────────────────────────── -->
<div class="npw-stepper-wrap">
    <SfStepper @ref="_stepper" ActiveStep="@_step" ActiveStepChanged="OnStepChanged" Linear="false">
        <Steps>
            <StepperStep Label="Account"    IconCss="bi bi-building"          IsValid="@StepValid(0)" />
            <StepperStep Label="LOB"        IconCss="bi bi-layers"             IsValid="@StepValid(1)" />
            <StepperStep Label="Risk Data"  IconCss="bi bi-clipboard2-data"   IsValid="@StepValid(2)" />
            <StepperStep Label="Markets"    IconCss="bi bi-bank"               IsValid="@StepValid(3)" />
            <StepperStep Label="Quotes"     IconCss="bi bi-journal-text"       IsValid="@StepValid(4)" />
            <StepperStep Label="Forms/Docs" IconCss="bi bi-paperclip"          IsValid="@StepValid(5)" />
            <StepperStep Label="Billing"    IconCss="bi bi-credit-card"        IsValid="@StepValid(6)" />
            <StepperStep Label="Bind/Issue" IconCss="bi bi-shield-check"       IsValid="@StepValid(7)" />
        </Steps>
    </SfStepper>
</div>

<!-- ── STEP BODY ────────────────────────────────────────────────────── -->
<div class="npw-body">
    @if (_step == 0) { @StepAccount() }
    else if (_step == 1) { @StepLob() }
    else if (_step == 2) { @StepRiskData() }
    else if (_step == 3) { @StepMarkets() }
    else if (_step == 4) { @StepQuotes() }
    else if (_step == 5) { @StepFormsDocs() }
    else if (_step == 6) { @StepBilling() }
    else if (_step == 7) { @StepBindIssue() }
</div>

<!-- ── FOOTER NAV ───────────────────────────────────────────────────── -->
<div class="npw-footer">
    <button class="um-btn um-btn-ghost" disabled="@(_step == 0)" @onclick="GoPrev">
        <i class="bi bi-chevron-left" aria-hidden="true"></i> Back
    </button>
    <div class="npw-footer-right">
        <button class="um-btn um-btn-ghost" @onclick="SaveDraft">
            <i class="bi bi-floppy" aria-hidden="true"></i> Save Draft
        </button>
        @if (_step < 7)
        {
            <button class="um-btn um-btn-primary" @onclick="GoNext" disabled="@(!CanAdvance())">
                Next <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </button>
        }
        else
        {
            <button class="um-btn um-btn-success" @onclick="BindAndIssueAsync" disabled="@_binding">
                @if (_binding)
                {
                    <span class="npw-spinner" aria-hidden="true"></span>
                    <span>Binding…</span>
                }
                else
                {
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span>Bind &amp; Issue</span>
                }
            </button>
        }
    </div>
</div>

<!-- ── CONFIRM CANCEL DIALOG ────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showCancelDlg" Width="420px" IsModal="true" ShowCloseIcon="true" Header="Discard Policy?">
    <DialogTemplates>
        <Content>
            <p>All unsaved changes will be lost. Are you sure you want to leave the wizard?</p>
        </Content>
        <FooterTemplate>
            <button class="um-btn um-btn-ghost" @onclick='() => _showCancelDlg = false'>Stay</button>
            <button class="um-btn um-btn-danger" @onclick='() => Nav.NavigateTo("/policies")'>Discard</button>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    /* ── refs / state ──────────────────────────────────────────────── */
    SfStepper _stepper = default!;
    SfToast   _toast   = default!;

    int  _step    = 0;
    bool _binding = false;
    bool _showCancelDlg = false;

    /* ── step completion flags ─────────────────────────────────────── */
    bool?[] _stepValid = new bool?[8];

    bool? StepValid(int i) => _stepValid[i];
    bool  CanAdvance()
    {
        return _step switch
        {
            0 => _treeValues.Count > 0 || _s1.AccountId is not null,
            1 => !string.IsNullOrEmpty(_s2.Lob),
            2 => !string.IsNullOrEmpty(_s3.InsuredName),
            3 => _s4.SelectedCarrierIds.Count > 0,
            4 => true,   // quote linkage optional
            5 => true,   // docs optional
            6 => !string.IsNullOrEmpty(_s7.BillingPlan),
            7 => true,
            _ => false
        };
    }

    void OnStepChanged(int idx) => _step = idx;

    void GoPrev() { if (_step > 0) { CommitStep(); _step--; } }
    void GoNext()
    {
        CommitStep();
        _stepValid[_step] = CanAdvance();
        if (CanAdvance() && _step < 7) _step++;
    }

    void CommitStep()
    {
        // persist step state — in production calls API draft endpoint
    }

    async Task SaveDraft()
    {
        CommitStep();
        await _toast.ShowAsync(new ToastModel
        {
            Title   = "Draft Saved",
            Content = "Your in-progress policy has been saved as a draft.",
            CssClass = "e-toast-success"
        });
    }

    async Task BindAndIssueAsync()
    {
        _binding = true;
        await Task.Delay(1400); // simulate API
        _binding = false;
        var newId = Guid.NewGuid();
        await _toast.ShowAsync(new ToastModel
        {
            Title    = "Policy Issued",
            Content  = $"Policy {_s8.PolicyNumber} has been bound and issued.",
            CssClass = "e-toast-success"
        });
        await Task.Delay(1000);
        Nav.NavigateTo($"/policies/{newId}");
    }

    /* ════════════════════════════════════════════════════════════════
       STEP 1 — ACCOUNT
    ════════════════════════════════════════════════════════════════ */
    sealed class Step1Model
    {
        public Guid?   AccountId   { get; set; }
        public string  AccountName { get; set; } = "";
        public string  AccountType { get; set; } = "";
        public string  SearchText  { get; set; } = "";
    }
    Step1Model _s1 = new();
    bool _s1NewAccount = false;

    sealed class AccountTreeNode
    {
        public string Id       { get; set; } = "";
        public string Name     { get; set; } = "";
        public string ParentId { get; set; } = "";
        public bool   HasChild { get; set; }
        public string Type     { get; set; } = "";
        public string Industry { get; set; } = "";
    }

    List<AccountTreeNode> _accountTree = new()
    {
        new() { Id="grp-comm",  Name="Commercial",         ParentId="",         HasChild=true,  Type="Group"      },
        new() { Id="a-001",     Name="Sullivan Mfg. LLC",  ParentId="grp-comm", HasChild=false, Type="Commercial", Industry="Manufacturing"  },
        new() { Id="a-002",     Name="Bridgewater Hotels", ParentId="grp-comm", HasChild=false, Type="Commercial", Industry="Hospitality"    },
        new() { Id="a-003",     Name="Metro Freight Co.",  ParentId="grp-comm", HasChild=false, Type="Commercial", Industry="Transportation"  },
        new() { Id="a-004",     Name="PineCrest Builders", ParentId="grp-comm", HasChild=false, Type="Commercial", Industry="Construction"   },
        new() { Id="grp-pers",  Name="Personal",           ParentId="",         HasChild=true,  Type="Group"      },
        new() { Id="a-010",     Name="James & Lisa Carter",ParentId="grp-pers", HasChild=false, Type="Personal",   Industry=""               },
        new() { Id="a-011",     Name="Nguyen, Minh T.",    ParentId="grp-pers", HasChild=false, Type="Personal",   Industry=""               },
    };

    List<string> _treeValues = new();

    void OnTreeValuesChanged(List<string> values)
    {
        _treeValues = values;
        var node = _accountTree.FirstOrDefault(n => values.Contains(n.Id) && n.Type != "Group");
        if (node is not null)
        {
            _s1.AccountId   = Guid.NewGuid();
            _s1.AccountName = node.Name;
            _s1.AccountType = node.Type;
        }
        else
        {
            _s1.AccountId   = null;
            _s1.AccountName = "";
        }
    }

    /* ════════════════════════════════════════════════════════════════
       STEP 2 — LINE OF BUSINESS
    ════════════════════════════════════════════════════════════════ */
    sealed class Step2Model
    {
        public string Lob         { get; set; } = "";
        public string SubLine     { get; set; } = "";
    }
    Step2Model _s2 = new();

    record LobCard(string Key, string Label, string Icon, string Color, string[] SubLines);

    readonly LobCard[] _lobCards = new[]
    {
        new LobCard("gl",   "General Liability",    "bi-shield",          "#2563EB", new[]{"Commercial General Liability","Products-Completed Ops","Premises Ops"}),
        new LobCard("prop", "Commercial Property",  "bi-building",        "#7C3AED", new[]{"Building Only","Contents Only","Building & Contents","BOP"}),
        new LobCard("auto", "Commercial Auto",      "bi-truck",           "#D97706", new[]{"Business Auto","Hired & Non-Owned","Fleet Auto"}),
        new LobCard("wc",   "Workers Comp",         "bi-person-badge",    "#059669", new[]{"Standard WC","USL&H","Employers Liability"}),
        new LobCard("um",   "Umbrella / Excess",    "bi-umbrella",        "#DC2626", new[]{"Commercial Umbrella","Excess Liability"}),
        new LobCard("pl",   "Professional Liab.",   "bi-briefcase",       "#0891B2", new[]{"E&O","D&O","Cyber","EPLI"}),
        new LobCard("ha",   "Home / Dwelling",      "bi-house",           "#65A30D", new[]{"Homeowners","Dwelling Fire","Renters"}),
        new LobCard("pa",   "Personal Auto",        "bi-car-front",       "#F59E0B", new[]{"Personal Auto","Motorcycle","Collector Car"}),
    };

    /* ════════════════════════════════════════════════════════════════
       STEP 3 — INSURED / RISK DATA
    ════════════════════════════════════════════════════════════════ */
    sealed class Step3Model
    {
        public string InsuredName   { get; set; } = "";
        public string Dba           { get; set; } = "";
        public string RiskAddress   { get; set; } = "";
        public string City          { get; set; } = "";
        public string State         { get; set; } = "";
        public string Zip           { get; set; } = "";
        public string SicCode       { get; set; } = "";
        public string Description   { get; set; } = "";
        public decimal Payroll      { get; set; }
        public decimal Revenue      { get; set; }
        public int     Employees    { get; set; }
        public decimal TIV          { get; set; }
        public decimal SquareFeet   { get; set; }
        public int     Vehicles     { get; set; }
        public DateTime? YearBuilt  { get; set; }
        public string  Construction { get; set; } = "";
    }
    Step3Model _s3 = new() { State = "TX" };

    readonly string[] _constructionTypes = new[]
    { "Frame","Joisted Masonry","Non-Combustible","Masonry Non-Combustible","Modified Fire Resistive","Fire Resistive" };

    readonly string[] _states = new[]
    { "AL","AK","AZ","AR","CA","CO","CT","DE","FL","GA","HI","ID","IL","IN","IA","KS","KY","LA","ME",
      "MD","MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ","NM","NY","NC","ND","OH","OK","OR","PA",
      "RI","SC","SD","TN","TX","UT","VT","VA","WA","WV","WI","WY" };

    /* ════════════════════════════════════════════════════════════════
       STEP 4 — MARKET TARGETING
    ════════════════════════════════════════════════════════════════ */
    sealed class Step4Model
    {
        public HashSet<string> SelectedCarrierIds { get; set; } = new();
        public decimal         OccurrenceLimit    { get; set; } = 1_000_000;
        public decimal         AggregateLimit     { get; set; } = 2_000_000;
        public decimal         Deductible         { get; set; } = 1_000;
        public string          TargetPremiumNote  { get; set; } = "";
        public decimal         TargetPremium      { get; set; }
    }
    Step4Model _s4 = new();

    record CarrierRow(string Id, string Name, string AMBest, string[] AppetiteLobs, bool Preferred);

    readonly CarrierRow[] _carriers = new[]
    {
        new CarrierRow("c-01","Travelers Indemnity",       "A++", new[]{"gl","prop","auto","wc","um"}, true ),
        new CarrierRow("c-02","Hartford Fire & Casualty",  "A+",  new[]{"gl","prop","auto","wc"},      true ),
        new CarrierRow("c-03","Liberty Mutual Insurance",  "A",   new[]{"gl","prop","auto","wc","um"}, true ),
        new CarrierRow("c-04","Zurich American",           "A+",  new[]{"gl","prop","auto","um","pl"}, false),
        new CarrierRow("c-05","CNA Insurance",             "A",   new[]{"gl","prop","pl","um"},        false),
        new CarrierRow("c-06","Markel Insurance",          "A",   new[]{"pl","um","gl"},               false),
        new CarrierRow("c-07","EMPLOYERS Ins. Co.",        "A-",  new[]{"wc"},                         false),
        new CarrierRow("c-08","State Auto",                "A-",  new[]{"ha","pa","gl"},               false),
    };

    void ToggleCarrier(string id)
    {
        if (_s4.SelectedCarrierIds.Contains(id)) _s4.SelectedCarrierIds.Remove(id);
        else _s4.SelectedCarrierIds.Add(id);
    }

    /* ════════════════════════════════════════════════════════════════
       STEP 5 — QUOTE LINKAGE
    ════════════════════════════════════════════════════════════════ */
    sealed class Step5Model
    {
        public string? LinkedQuoteId { get; set; }
        public bool    ProceedWithout{ get; set; }
    }
    Step5Model _s5 = new();

    record QuoteRow(string Id, string Number, string Carrier, decimal Premium, string Status, DateTime Expires);

    readonly QuoteRow[] _quotes = new[]
    {
        new QuoteRow("q-001","QT-2025-0441","Travelers Indemnity",  14_250m,"Approved",  new DateTime(2025,9,30)),
        new QuoteRow("q-002","QT-2025-0442","Hartford Fire",        15_800m,"Approved",  new DateTime(2025,9,30)),
        new QuoteRow("q-003","QT-2025-0438","Liberty Mutual",       13_500m,"Pending",   new DateTime(2025,10,15)),
        new QuoteRow("q-004","QT-2025-0410","Zurich American",      16_400m,"Declined",  new DateTime(2025,8,31)),
    };

    /* ════════════════════════════════════════════════════════════════
       STEP 6 — FORMS / DOCS
    ════════════════════════════════════════════════════════════════ */
    sealed class Step6Model
    {
        public HashSet<string> AttachedFormIds { get; set; } = new();
        public List<string>    UploadedFileNames{ get; set; } = new();
    }
    Step6Model _s6 = new();

    record FormRow(string Id, string Number, string Name, string Edition, bool Required);

    readonly FormRow[] _forms = new[]
    {
        new FormRow("f-01","ACORD 125", "Commercial Insurance Application",   "2016/03", true ),
        new FormRow("f-02","ACORD 126", "Commercial General Liability Section","2016/03", true ),
        new FormRow("f-03","ACORD 140", "Property Section",                    "2016/03", false),
        new FormRow("f-04","ACORD 137", "Terrorism Risk Insurance Act Notice", "2020/01", true ),
        new FormRow("f-05","IL 00 17",  "Common Policy Conditions",            "2013/11", true ),
        new FormRow("f-06","CG 00 01",  "Commercial General Liability Coverage","2017/04",true ),
        new FormRow("f-07","CG 20 10",  "Additional Insured - Scheduled",      "2013/04", false),
        new FormRow("f-08","CG 20 37",  "Additional Insured - Completed Ops",  "2013/04", false),
    };

    void OnFilesUploaded(UploadChangeEventArgs args)
    {
        foreach (var f in args.Files)
            _s6.UploadedFileNames.Add(f.FileInfo.Name);
    }

    /* ════════════════════════════════════════════════════════════════
       STEP 7 — BILLING / COMMISSION
    ════════════════════════════════════════════════════════════════ */
    sealed class Step7Model
    {
        public string  BillingPlan    { get; set; } = "";
        public string  PaymentMethod  { get; set; } = "Invoice";
        public int     Installments   { get; set; } = 10;
        public decimal DownPaymentPct { get; set; } = 20;
        public string  ProducerCode   { get; set; } = "";
        public decimal CommissionPct  { get; set; } = 15;
        public string  CsrCode        { get; set; } = "";
        public decimal MgaFeeFlat     { get; set; }
        public string  BillingNotes   { get; set; } = "";
    }
    Step7Model _s7 = new();

    readonly string[] _billingPlans    = new[]{ "Agency Bill","Direct Bill","Installment — Agency","Installment — Direct","Flat — Full Pay" };
    readonly string[] _paymentMethods  = new[]{ "Invoice","ACH","Credit Card","Check","EFT" };
    readonly int[]    _installmentOpts = new[]{ 1,2,4,10,12 };

    record ProducerOption(string Code, string Name, decimal DefaultComm);
    readonly ProducerOption[] _producers = new[]
    {
        new ProducerOption("PRD-001","Thornton & Associates",    15m),
        new ProducerOption("PRD-002","Pacific Bridge Insurance", 12m),
        new ProducerOption("PRD-003","Allied Risk Group",        14m),
        new ProducerOption("PRD-004","Midwest Coverage Partners",13m),
    };

    record CsrOption(string Code, string Name);
    readonly CsrOption[] _csrs = new[]
    {
        new CsrOption("CSR-01","Maria Santos"),
        new CsrOption("CSR-02","James Patel"),
        new CsrOption("CSR-03","Chen Li"),
        new CsrOption("CSR-04","Aisha Williams"),
    };

    /* ════════════════════════════════════════════════════════════════
       STEP 8 — BIND / ISSUE
    ════════════════════════════════════════════════════════════════ */
    sealed class Step8Model
    {
        public string    PolicyNumber    { get; set; } = "POL-2025-" + new Random().Next(10000,99999);
        public DateTime  EffectiveDate   { get; set; } = DateTime.Today;
        public DateTime  ExpirationDate  { get; set; } = DateTime.Today.AddYears(1);
        public string    PolicyType      { get; set; } = "New Business";
        public bool      ESignRequired   { get; set; } = false;
        public bool      SendConfirmation{ get; set; } = true;
        public bool      IssueIdCards    { get; set; } = false;
        public string    BindNotes       { get; set; } = "";
    }
    Step8Model _s8 = new();

    readonly string[] _policyTypes = new[]{ "New Business","Rewrite","Takeover","Rollover" };

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(
            new("Home", "/"),
            new("Policies", "/policies"),
            new("New Policy", "/policies/new"));

        // Pre-attach all required forms by default
        foreach (var f in _forms.Where(x => x.Required))
            _s6.AttachedFormIds.Add(f.Id);
    }

    /* ════════════════════════════════════════════════════════════════
       STEP RENDER FRAGMENTS
    ════════════════════════════════════════════════════════════════ */

    // ── Step 1 ──────────────────────────────────────────────────────
    RenderFragment StepAccount() =>
    @<div class="npw-step">
        <div class="npw-step-header">
            <i class="bi bi-building npw-step-icon" aria-hidden="true"></i>
            <div>
                <h2 class="npw-step-title">Select Account</h2>
                <p class="npw-step-desc">Choose an existing account or create a new one to associate with this policy.</p>
            </div>
        </div>

        <div class="npw-step-body">
            <div class="npw-card">
                <div class="npw-card-head">
                    <span>Existing Account</span>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => _s1NewAccount = !_s1NewAccount'>
                        @(_s1NewAccount ? "← Back to search" : "+ New Account")
                    </button>
                </div>

                @if (!_s1NewAccount)
                {
                    <div class="npw-field-row">
                        <div class="npw-field npw-field-lg">
                            <label class="npw-label">Account</label>
                            <SfDropDownTree TItem="AccountTreeNode" TValue="string"
                                            DataSource="@_accountTree"
                                            Placeholder="Search accounts…"
                                            AllowFiltering="true"
                                            Value="_treeValues"
                                            ValueChanged="OnTreeValuesChanged">
                                <DropDownTreeField TItem="AccountTreeNode" Value="Id" Text="Name"
                                                   ParentValue="ParentId" HasChildren="HasChild" />
                            </SfDropDownTree>
                        </div>
                    </div>

                    @if (_s1.AccountId is not null)
                    {
                        <div class="npw-selected-account">
                            <i class="bi bi-check-circle-fill npw-sel-icon" aria-hidden="true"></i>
                            <div>
                                <strong>@_s1.AccountName</strong>
                                <span class="npw-sel-type">@_s1.AccountType</span>
                            </div>
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => { _s1.AccountId = null; _s1.AccountName = ""; _treeValues = new(); }'>
                                <i class="bi bi-x" aria-hidden="true"></i>
                            </button>
                        </div>
                    }
                }
                else
                {
                    <p class="npw-info-note">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        The new account form would open inline or navigate to account creation.
                        This stub simulates a "quick-create" flow.
                    </p>
                    <div class="npw-field-row">
                        <div class="npw-field">
                            <label class="npw-label">Account Name <span class="npw-req">*</span></label>
                            <input class="e-input" @bind="_s1.AccountName" placeholder="Full legal name" />
                        </div>
                        <div class="npw-field npw-field-sm">
                            <label class="npw-label">Type</label>
                            <select class="e-input" @bind="_s1.AccountType">
                                <option value="">— select —</option>
                                <option>Commercial</option>
                                <option>Personal</option>
                                <option>Non-Profit</option>
                            </select>
                        </div>
                    </div>
                    <button class="um-btn um-btn-secondary um-btn-sm" @onclick="() => { _s1.AccountId = Guid.NewGuid(); _s1NewAccount = false; }">
                        <i class="bi bi-plus-circle" aria-hidden="true"></i> Create &amp; Select
                    </button>
                }
            </div>
        </div>
    </div>;

    // ── Step 2 ──────────────────────────────────────────────────────
    RenderFragment StepLob() =>
    @<div class="npw-step">
        <div class="npw-step-header">
            <i class="bi bi-layers npw-step-icon" aria-hidden="true"></i>
            <div>
                <h2 class="npw-step-title">Line of Business</h2>
                <p class="npw-step-desc">Select the primary line of business for this policy.</p>
            </div>
        </div>

        <div class="npw-step-body">
            <div class="npw-lob-grid">
                @foreach (var lob in _lobCards)
                {
                    <button class="npw-lob-card @(_s2.Lob == lob.Label ? "npw-lob-active" : "")"
                            style="--lob-color:@lob.Color"
                            @onclick="() => { _s2.Lob = lob.Label; _s2.SubLine = lob.SubLines[0]; }">
                        <i class="bi @lob.Icon npw-lob-icon" aria-hidden="true"></i>
                        <span class="npw-lob-name">@lob.Label</span>
                    </button>
                }
            </div>

            @if (!string.IsNullOrEmpty(_s2.Lob))
            {
                var sel = _lobCards.First(l => l.Label == _s2.Lob);
                <div class="npw-card npw-mt">
                    <div class="npw-card-head"><span>Sub-Line / Coverage Form</span></div>
                    <div class="npw-lob-sublines">
                        @foreach (var sub in sel.SubLines)
                        {
                            <label class="npw-radio-row">
                                <input type="radio" name="subline" value="@sub"
                                       checked="@(_s2.SubLine == sub)"
                                       @onchange='() => _s2.SubLine = sub' />
                                <span>@sub</span>
                            </label>
                        }
                    </div>
                </div>
            }
        </div>
    </div>;

    // ── Step 3 ──────────────────────────────────────────────────────
    RenderFragment StepRiskData() =>
    @<div class="npw-step">
        <div class="npw-step-header">
            <i class="bi bi-clipboard2-data npw-step-icon" aria-hidden="true"></i>
            <div>
                <h2 class="npw-step-title">Insured &amp; Risk Data</h2>
                <p class="npw-step-desc">Enter insured details and risk-specific exposure information.</p>
            </div>
        </div>

        <EditForm Model="_s3" class="npw-step-body">
            <SfFormValidator />
            <div class="npw-card">
                <div class="npw-card-head"><span>Insured Information</span></div>
                <div class="npw-field-row">
                    <div class="npw-field npw-field-lg">
                        <label class="npw-label">Named Insured <span class="npw-req">*</span></label>
                        <input class="e-input" @bind="_s3.InsuredName" placeholder="Legal name of insured" />
                    </div>
                    <div class="npw-field">
                        <label class="npw-label">DBA</label>
                        <input class="e-input" @bind="_s3.Dba" placeholder="Doing business as" />
                    </div>
                </div>
                <div class="npw-field-row">
                    <div class="npw-field npw-field-lg">
                        <label class="npw-label">Risk Address <span class="npw-req">*</span></label>
                        <input class="e-input" @bind="_s3.RiskAddress" placeholder="Street address" />
                    </div>
                </div>
                <div class="npw-field-row">
                    <div class="npw-field npw-field-lg">
                        <label class="npw-label">City</label>
                        <input class="e-input" @bind="_s3.City" />
                    </div>
                    <div class="npw-field npw-field-xs">
                        <label class="npw-label">State</label>
                        <SfDropDownList TItem="string" TValue="string"
                            DataSource="@_states"
                            @bind-Value="_s3.State" />
                    </div>
                    <div class="npw-field npw-field-xs">
                        <label class="npw-label">ZIP</label>
                        <input class="e-input" @bind="_s3.Zip" maxlength="10" />
                    </div>
                </div>
                <div class="npw-field-row">
                    <div class="npw-field npw-field-sm">
                        <label class="npw-label">SIC Code</label>
                        <input class="e-input" @bind="_s3.SicCode" placeholder="e.g. 3490" />
                    </div>
                    <div class="npw-field npw-field-lg">
                        <label class="npw-label">Business Description</label>
                        <input class="e-input" @bind="_s3.Description" placeholder="Describe operations" />
                    </div>
                </div>
            </div>

            <div class="npw-card npw-mt">
                <div class="npw-card-head"><span>Exposure Data — @_s2.Lob</span></div>

                @* Show relevant fields by LOB *@
                @if (_s2.Lob is "Workers Comp" or "General Liability")
                {
                    <div class="npw-field-row">
                        <div class="npw-field">
                            <label class="npw-label">Annual Payroll ($)</label>
                            <SfNumericTextBox TValue="decimal" @bind-Value="_s3.Payroll" Format="N0" Min="0" />
                        </div>
                        <div class="npw-field">
                            <label class="npw-label">Annual Revenue ($)</label>
                            <SfNumericTextBox TValue="decimal" @bind-Value="_s3.Revenue" Format="N0" Min="0" />
                        </div>
                        <div class="npw-field npw-field-xs">
                            <label class="npw-label">Employees (#)</label>
                            <SfNumericTextBox TValue="int" @bind-Value="_s3.Employees" Min="0" />
                        </div>
                    </div>
                }
                @if (_s2.Lob is "Commercial Property")
                {
                    <div class="npw-field-row">
                        <div class="npw-field">
                            <label class="npw-label">Total Insured Value ($)</label>
                            <SfNumericTextBox TValue="decimal" @bind-Value="_s3.TIV" Format="N0" Min="0" />
                        </div>
                        <div class="npw-field">
                            <label class="npw-label">Square Footage</label>
                            <SfNumericTextBox TValue="decimal" @bind-Value="_s3.SquareFeet" Format="N0" Min="0" />
                        </div>
                        <div class="npw-field npw-field-sm">
                            <label class="npw-label">Construction Type</label>
                            <SfDropDownList TItem="string" TValue="string"
                                DataSource="@_constructionTypes"
                                @bind-Value="_s3.Construction" />
                        </div>
                    </div>
                }
                @if (_s2.Lob is "Commercial Auto" or "Personal Auto")
                {
                    <div class="npw-field-row">
                        <div class="npw-field npw-field-xs">
                            <label class="npw-label">Number of Vehicles</label>
                            <SfNumericTextBox TValue="int" @bind-Value="_s3.Vehicles" Min="1" />
                        </div>
                    </div>
                }
                @if (_s2.Lob is "Home / Dwelling")
                {
                    <div class="npw-field-row">
                        <div class="npw-field">
                            <label class="npw-label">Replacement Cost Value ($)</label>
                            <SfNumericTextBox TValue="decimal" @bind-Value="_s3.TIV" Format="N0" Min="0" />
                        </div>
                        <div class="npw-field npw-field-sm">
                            <label class="npw-label">Construction</label>
                            <SfDropDownList TItem="string" TValue="string"
                                DataSource="@_constructionTypes"
                                @bind-Value="_s3.Construction" />
                        </div>
                        <div class="npw-field npw-field-sm">
                            <label class="npw-label">Year Built</label>
                            <SfDatePicker TValue="DateTime?" @bind-Value="_s3.YearBuilt" Format="yyyy" />
                        </div>
                    </div>
                }
                @if (string.IsNullOrEmpty(_s2.Lob))
                {
                    <p class="npw-info-note"><i class="bi bi-arrow-left-circle" aria-hidden="true"></i> Please select a LOB in the previous step first.</p>
                }
            </div>
        </EditForm>
    </div>;

    // ── Step 4 ──────────────────────────────────────────────────────
    RenderFragment StepMarkets() =>
    @<div class="npw-step">
        <div class="npw-step-header">
            <i class="bi bi-bank npw-step-icon" aria-hidden="true"></i>
            <div>
                <h2 class="npw-step-title">Market Targeting</h2>
                <p class="npw-step-desc">Select target carriers and set desired coverage parameters.</p>
            </div>
        </div>

        <div class="npw-step-body">
            <div class="npw-card">
                <div class="npw-card-head">
                    <span>Coverage Parameters</span>
                </div>
                <div class="npw-field-row">
                    <div class="npw-field">
                        <label class="npw-label">Occurrence Limit ($)</label>
                        <SfNumericTextBox TValue="decimal" @bind-Value="_s4.OccurrenceLimit" Format="N0" Min="0" Step="100000" />
                    </div>
                    <div class="npw-field">
                        <label class="npw-label">Aggregate Limit ($)</label>
                        <SfNumericTextBox TValue="decimal" @bind-Value="_s4.AggregateLimit" Format="N0" Min="0" Step="100000" />
                    </div>
                    <div class="npw-field">
                        <label class="npw-label">Deductible ($)</label>
                        <SfNumericTextBox TValue="decimal" @bind-Value="_s4.Deductible" Format="N0" Min="0" />
                    </div>
                    <div class="npw-field">
                        <label class="npw-label">Target Premium ($)</label>
                        <SfNumericTextBox TValue="decimal" @bind-Value="_s4.TargetPremium" Format="N0" Min="0" />
                    </div>
                </div>
            </div>

            <div class="npw-card npw-mt">
                <div class="npw-card-head">
                    <span>Target Carriers</span>
                    <span class="npw-badge">@_s4.SelectedCarrierIds.Count selected</span>
                </div>
                <table class="npw-table">
                    <thead>
                        <tr>
                            <th style="width:40px"></th>
                            <th>Carrier</th>
                            <th>AM Best</th>
                            <th>Appetite Match</th>
                            <th>Preferred</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _carriers)
                        {
                            var matched = string.IsNullOrEmpty(_s2.Lob) || c.AppetiteLobs.Any(l => _lobCards.Any(lb => lb.Label == _s2.Lob && lb.Key == l));
                            <tr class="@(matched ? "" : "npw-row-dim")">
                                <td>
                                    <SfCheckBox Checked="@_s4.SelectedCarrierIds.Contains(c.Id)"
                                                CheckedChanged="@((bool v) => { if (v) _s4.SelectedCarrierIds.Add(c.Id); else _s4.SelectedCarrierIds.Remove(c.Id); })" />
                                </td>
                                <td>@c.Name</td>
                                <td><span class="npw-ambest npw-ambest-@c.AMBest.ToLower().Replace("+","p").Replace("-","m")">@c.AMBest</span></td>
                                <td>
                                    @if (matched)
                                    {
                                        <span class="npw-badge-green"><i class="bi bi-check" aria-hidden="true"></i> Match</span>
                                    }
                                    else
                                    {
                                        <span class="npw-badge-gray">No appetite</span>
                                    }
                                </td>
                                <td>
                                    @if (c.Preferred)
                                    {
                                        <i class="bi bi-star-fill npw-pref-star" aria-hidden="true"></i>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>;

    // ── Step 5 ──────────────────────────────────────────────────────
    RenderFragment StepQuotes() =>
    @<div class="npw-step">
        <div class="npw-step-header">
            <i class="bi bi-journal-text npw-step-icon" aria-hidden="true"></i>
            <div>
                <h2 class="npw-step-title">Quote Linkage</h2>
                <p class="npw-step-desc">Link an approved quote to this policy. This step is optional — you may proceed without a quote.</p>
            </div>
        </div>

        <div class="npw-step-body">
            <div class="npw-card">
                <div class="npw-card-head"><span>Available Quotes</span></div>
                <table class="npw-table">
                    <thead>
                        <tr>
                            <th style="width:40px"></th>
                            <th>Quote #</th>
                            <th>Carrier</th>
                            <th>Premium</th>
                            <th>Status</th>
                            <th>Expires</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in _quotes)
                        {
                            <tr class="@(q.Status == "Declined" ? "npw-row-dim" : "")">
                                <td>
                                    <input type="radio" name="quote-sel"
                                           disabled="@(q.Status == "Declined")"
                                           checked="@(_s5.LinkedQuoteId == q.Id)"
                                           @onchange='() => _s5.LinkedQuoteId = q.Id' />
                                </td>
                                <td><strong>@q.Number</strong></td>
                                <td>@q.Carrier</td>
                                <td>@q.Premium.ToString("C0")</td>
                                <td>
                                    <span class="npw-qlabel npw-qlabel-@q.Status.ToLower()">@q.Status</span>
                                </td>
                                <td>@q.Expires.ToString("MM/dd/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="npw-proceed-without">
                    <label class="npw-radio-row">
                        <input type="radio" name="quote-sel"
                               checked="@(_s5.ProceedWithout)"
                               @onchange='() => { _s5.ProceedWithout = true; _s5.LinkedQuoteId = null; }' />
                        <span>Proceed without linking a quote</span>
                    </label>
                </div>
            </div>
        </div>
    </div>;

    // ── Step 6 ──────────────────────────────────────────────────────
    RenderFragment StepFormsDocs() =>
    @<div class="npw-step">
        <div class="npw-step-header">
            <i class="bi bi-paperclip npw-step-icon" aria-hidden="true"></i>
            <div>
                <h2 class="npw-step-title">Forms &amp; Documents</h2>
                <p class="npw-step-desc">Attach required policy forms and upload supporting documents.</p>
            </div>
        </div>

        <div class="npw-step-body">
            <div class="npw-card">
                <div class="npw-card-head">
                    <span>Policy Forms</span>
                    <span class="npw-badge">@_s6.AttachedFormIds.Count / @_forms.Length attached</span>
                </div>
                <table class="npw-table">
                    <thead>
                        <tr>
                            <th style="width:40px"></th>
                            <th>Form Number</th>
                            <th>Name</th>
                            <th>Edition</th>
                            <th>Required</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in _forms)
                        {
                            <tr>
                                <td>
                                    <SfCheckBox Checked="@_s6.AttachedFormIds.Contains(f.Id)"
                                                Disabled="@f.Required"
                                                CheckedChanged="@((bool v) => { if (v) _s6.AttachedFormIds.Add(f.Id); else _s6.AttachedFormIds.Remove(f.Id); })" />
                                </td>
                                <td><code>@f.Number</code></td>
                                <td>@f.Name</td>
                                <td>@f.Edition</td>
                                <td>
                                    @if (f.Required)
                                    {
                                        <span class="npw-req-chip">Required</span>
                                    }
                                    else
                                    {
                                        <span class="npw-opt-chip">Optional</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="npw-card npw-mt">
                <div class="npw-card-head"><span>Supporting Documents</span></div>
                <SfUploader AllowedExtensions=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg" Multiple="true" AutoUpload="false">
                    <UploaderEvents OnChange="OnFilesUploaded" />
                </SfUploader>
                @if (_s6.UploadedFileNames.Count > 0)
                {
                    <div class="npw-uploaded-list">
                        @foreach (var fn in _s6.UploadedFileNames)
                        {
                            <span class="npw-uploaded-chip">
                                <i class="bi bi-file-earmark" aria-hidden="true"></i> @fn
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>;

    // ── Step 7 ──────────────────────────────────────────────────────
    RenderFragment StepBilling() =>
    @<div class="npw-step">
        <div class="npw-step-header">
            <i class="bi bi-credit-card npw-step-icon" aria-hidden="true"></i>
            <div>
                <h2 class="npw-step-title">Billing &amp; Commission</h2>
                <p class="npw-step-desc">Configure billing plan, installment schedule, and producer commission split.</p>
            </div>
        </div>

        <EditForm Model="_s7" class="npw-step-body">
            <SfFormValidator />
            <div class="npw-card">
                <div class="npw-card-head"><span>Billing Plan</span></div>
                <div class="npw-field-row">
                    <div class="npw-field">
                        <label class="npw-label">Billing Plan <span class="npw-req">*</span></label>
                        <SfDropDownList TItem="string" TValue="string"
                            DataSource="@_billingPlans"
                            @bind-Value="_s7.BillingPlan"
                            Placeholder="Select billing plan" />
                    </div>
                    <div class="npw-field">
                        <label class="npw-label">Payment Method</label>
                        <SfDropDownList TItem="string" TValue="string"
                            DataSource="@_paymentMethods"
                            @bind-Value="_s7.PaymentMethod" />
                    </div>
                </div>
                <div class="npw-field-row">
                    <div class="npw-field npw-field-xs">
                        <label class="npw-label">Installments</label>
                        <SfDropDownList TItem="int" TValue="int"
                            DataSource="@_installmentOpts"
                            @bind-Value="_s7.Installments" />
                    </div>
                    <div class="npw-field npw-field-xs">
                        <label class="npw-label">Down Payment %</label>
                        <SfNumericTextBox TValue="decimal" @bind-Value="_s7.DownPaymentPct" Min="0" Max="100" Step="5" Format="N0" />
                    </div>
                    <div class="npw-field">
                        <label class="npw-label">MGA Fee (flat, $)</label>
                        <SfNumericTextBox TValue="decimal" @bind-Value="_s7.MgaFeeFlat" Min="0" Format="N0" />
                    </div>
                </div>
                <div class="npw-field-row npw-full">
                    <div class="npw-field npw-field-lg">
                        <label class="npw-label">Billing Notes</label>
                        <textarea class="e-input" rows="2" @bind="_s7.BillingNotes" placeholder="Special instructions for billing…"></textarea>
                    </div>
                </div>
            </div>

            <div class="npw-card npw-mt">
                <div class="npw-card-head"><span>Commission</span></div>
                <div class="npw-field-row">
                    <div class="npw-field">
                        <label class="npw-label">Producer</label>
                        <SfDropDownList TItem="ProducerOption" TValue="string"
                                DataSource="@_producers"
                                Value="_s7.ProducerCode"
                                ValueChanged="@((string code) => { _s7.ProducerCode = code; var p = _producers.FirstOrDefault(x => x.Code == code); if (p is not null) _s7.CommissionPct = p.DefaultComm; })">
                            <DropDownListFieldSettings Value="Code" Text="Name" />
                        </SfDropDownList>
                    </div>
                    <div class="npw-field npw-field-xs">
                        <label class="npw-label">Commission %</label>
                        <SfNumericTextBox TValue="decimal" @bind-Value="_s7.CommissionPct" Min="0" Max="100" Step="0.5m" Format="N1" />
                    </div>
                    <div class="npw-field">
                        <label class="npw-label">CSR</label>
                        <SfDropDownList TItem="CsrOption" TValue="string"
                                DataSource="@_csrs"
                                @bind-Value="_s7.CsrCode">
                            <DropDownListFieldSettings Value="Code" Text="Name" />
                        </SfDropDownList>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>;

    // ── Step 8 ──────────────────────────────────────────────────────
    RenderFragment StepBindIssue() =>
    @<div class="npw-step">
        <div class="npw-step-header">
            <i class="bi bi-shield-check npw-step-icon" aria-hidden="true"></i>
            <div>
                <h2 class="npw-step-title">Bind &amp; Issue</h2>
                <p class="npw-step-desc">Review your policy summary and issue the policy.</p>
            </div>
        </div>

        <div class="npw-step-body">
            <!-- Summary review -->
            <div class="npw-review-grid">
                <div class="npw-review-card">
                    <span class="npw-review-label"><i class="bi bi-building" aria-hidden="true"></i> Account</span>
                    <span class="npw-review-val">@(string.IsNullOrEmpty(_s1.AccountName) ? "—" : _s1.AccountName)</span>
                </div>
                <div class="npw-review-card">
                    <span class="npw-review-label"><i class="bi bi-layers" aria-hidden="true"></i> LOB</span>
                    <span class="npw-review-val">@(string.IsNullOrEmpty(_s2.Lob) ? "—" : $"{_s2.Lob} — {_s2.SubLine}")</span>
                </div>
                <div class="npw-review-card">
                    <span class="npw-review-label"><i class="bi bi-person" aria-hidden="true"></i> Named Insured</span>
                    <span class="npw-review-val">@(string.IsNullOrEmpty(_s3.InsuredName) ? "—" : _s3.InsuredName)</span>
                </div>
                <div class="npw-review-card">
                    <span class="npw-review-label"><i class="bi bi-bank" aria-hidden="true"></i> Carriers</span>
                    <span class="npw-review-val">
                        @if (_s4.SelectedCarrierIds.Count == 0)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            @string.Join(", ", _carriers.Where(c => _s4.SelectedCarrierIds.Contains(c.Id)).Select(c => c.Name))
                        }
                    </span>
                </div>
                <div class="npw-review-card">
                    <span class="npw-review-label"><i class="bi bi-journal-text" aria-hidden="true"></i> Quote</span>
                    <span class="npw-review-val">
                        @(_s5.LinkedQuoteId is not null
                            ? _quotes.FirstOrDefault(q => q.Id == _s5.LinkedQuoteId)?.Number ?? "—"
                            : "None linked")
                    </span>
                </div>
                <div class="npw-review-card">
                    <span class="npw-review-label"><i class="bi bi-credit-card" aria-hidden="true"></i> Billing</span>
                    <span class="npw-review-val">@(string.IsNullOrEmpty(_s7.BillingPlan) ? "—" : $"{_s7.BillingPlan} · {_s7.Installments} install.")</span>
                </div>
                <div class="npw-review-card">
                    <span class="npw-review-label"><i class="bi bi-person-workspace" aria-hidden="true"></i> Producer</span>
                    <span class="npw-review-val">
                        @(_producers.FirstOrDefault(p => p.Code == _s7.ProducerCode)?.Name ?? "—")
                        @if (_s7.CommissionPct > 0) { <span class="npw-review-sub">@_s7.CommissionPct%</span> }
                    </span>
                </div>
                <div class="npw-review-card">
                    <span class="npw-review-label"><i class="bi bi-paperclip" aria-hidden="true"></i> Forms</span>
                    <span class="npw-review-val">@_s6.AttachedFormIds.Count forms · @_s6.UploadedFileNames.Count files</span>
                </div>
            </div>

            <!-- Issue controls -->
            <div class="npw-card npw-mt">
                <div class="npw-card-head"><span>Issue Details</span></div>
                <div class="npw-field-row">
                    <div class="npw-field">
                        <label class="npw-label">Policy Number</label>
                        <input class="e-input" @bind="_s8.PolicyNumber" />
                    </div>
                    <div class="npw-field npw-field-sm">
                        <label class="npw-label">Policy Type</label>
                        <SfDropDownList TItem="string" TValue="string"
                            DataSource="@_policyTypes"
                            @bind-Value="_s8.PolicyType" />
                    </div>
                </div>
                <div class="npw-field-row">
                    <div class="npw-field npw-field-sm">
                        <label class="npw-label">Effective Date</label>
                        <SfDatePicker TValue="DateTime" @bind-Value="_s8.EffectiveDate" Format="MM/dd/yyyy" />
                    </div>
                    <div class="npw-field npw-field-sm">
                        <label class="npw-label">Expiration Date</label>
                        <SfDatePicker TValue="DateTime" @bind-Value="_s8.ExpirationDate" Format="MM/dd/yyyy" />
                    </div>
                </div>
                <div class="npw-field-row">
                    <div class="npw-field npw-field-lg">
                        <label class="npw-label">Bind Notes</label>
                        <textarea class="e-input" rows="2" @bind="_s8.BindNotes" placeholder="Optional notes for the binder…"></textarea>
                    </div>
                </div>
                <div class="npw-check-row">
                    <SfCheckBox @bind-Checked="_s8.ESignRequired"   Label="Require e-signature before issue" />
                    <SfCheckBox @bind-Checked="_s8.SendConfirmation" Label="Send confirmation email to insured" />
                    <SfCheckBox @bind-Checked="_s8.IssueIdCards"     Label="Issue ID cards (auto)" />
                </div>
            </div>
        </div>
    </div>;
}
