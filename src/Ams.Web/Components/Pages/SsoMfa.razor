@page "/iam/sso-mfa"
@page "/admin/security/sso"
@inject ApiClient Api

<PageTitle>SSO &amp; MFA</PageTitle>
<h1>SSO &amp; MFA</h1>

<h4 class="mt-3">SSO Configurations</h4>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search SSO..." @bind-Value="_ssoSearchTerm" Width="280px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_ssoItems is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_ssoItems" AllowPaging="true" AllowSorting="true" Height="260px">
    <GridPageSettings PageSize="5"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(SsoConfigurationDto.ProviderTypeCode)" HeaderText="Provider Type" Width="130"></GridColumn>
        <GridColumn Field="@nameof(SsoConfigurationDto.ProviderName)"     HeaderText="Provider Name" Width="200"></GridColumn>
        <GridColumn Field="@nameof(SsoConfigurationDto.TenantDomain)"     HeaderText="Domain"        Width="180"></GridColumn>
        <GridColumn Field="@nameof(SsoConfigurationDto.IsEnabled)"        HeaderText="Enabled"       Width="90" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(SsoConfigurationDto.RequireSso)"       HeaderText="Require SSO"   Width="110" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(SsoConfigurationDto.AllowLocalLogin)"  HeaderText="Allow Local"   Width="110" DisplayAsCheckBox="true"></GridColumn>
    </GridColumns>
</SfGrid>
}

<h4 class="mt-4">MFA Devices</h4>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search MFA devices..." @bind-Value="_mfaSearchTerm" Width="280px"></SfTextBox>
</div>
@if (_mfaItems is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_mfaItems" AllowPaging="true" AllowSorting="true" Height="260px">
    <GridPageSettings PageSize="5"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(MfaDeviceDto.UserFullName)"     HeaderText="User"         Width="180"></GridColumn>
        <GridColumn Field="@nameof(MfaDeviceDto.DeviceTypeCode)"   HeaderText="Device Type"  Width="120"></GridColumn>
        <GridColumn Field="@nameof(MfaDeviceDto.DeviceName)"       HeaderText="Device Name"  Width="180"></GridColumn>
        <GridColumn Field="@nameof(MfaDeviceDto.IsVerified)"       HeaderText="Verified"     Width="90" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(MfaDeviceDto.IsActive)"         HeaderText="Active"       Width="80" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(MfaDeviceDto.LastUsedDateUtc)"  HeaderText="Last Used"    Width="140" Type="ColumnType.DateTime" Format="MM/dd/yyyy"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private static readonly Guid DefaultTenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _ssoSearchTerm;
    private string? _mfaSearchTerm;
    private List<SsoConfigurationDto>? _ssoItems;
    private List<MfaDeviceDto>? _mfaItems;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var ssoResult = await Api.SearchSsoConfigurationsAsync(DefaultTenantId, _ssoSearchTerm);
        _ssoItems = ssoResult?.Items.ToList() ?? [];
        var mfaResult = await Api.SearchMfaDevicesAsync(DefaultTenantId, searchTerm: _mfaSearchTerm);
        _mfaItems = mfaResult?.Items.ToList() ?? [];
    }
}
