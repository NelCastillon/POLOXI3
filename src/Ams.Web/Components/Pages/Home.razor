@page "/"
@inject ApiClient Api

<PageTitle>Dashboard</PageTitle>

<h1>Enterprise Dashboard</h1>

@if (_kpi is null)
{
    <p>Loading KPIs...</p>
}
else
{
    <div class="dashboard-grid">
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Tenants</div>
                <div class="kpi-value">@_kpi.TotalTenants</div>
                <div class="kpi-sub">Active platform tenants</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Users</div>
                <div class="kpi-value">@_kpi.TotalUsers</div>
                <div class="kpi-sub">Internal, external, partner</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Open Leads</div>
                <div class="kpi-value">@_kpi.OpenLeads</div>
                <div class="kpi-sub">In pipeline for conversion</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Active Accounts</div>
                <div class="kpi-value">@_kpi.ActiveAccounts</div>
                <div class="kpi-sub">Client accounts under management</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Open Opportunities</div>
                <div class="kpi-value">@_kpi.OpenOpportunities</div>
                <div class="kpi-sub">Active sales pipeline</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Active Engagements</div>
                <div class="kpi-value">@_kpi.ActiveEngagements</div>
                <div class="kpi-sub">Service engagements in progress</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Outstanding AR</div>
                <div class="kpi-value">@_kpi.OutstandingInvoicesAmount.ToString("C0")</div>
                <div class="kpi-sub">Open invoice balance</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Collected This Month</div>
                <div class="kpi-value">@_kpi.CollectedThisMonthAmount.ToString("C0")</div>
                <div class="kpi-sub">Payments received MTD</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Pending Approvals</div>
                <div class="kpi-value">@_kpi.PendingApprovals</div>
                <div class="kpi-sub">Awaiting workflow approval</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Open Issues</div>
                <div class="kpi-value">@_kpi.OpenIssues</div>
                <div class="kpi-sub">Active issue tracker items</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Pending Commissions</div>
                <div class="kpi-value">@_kpi.PendingCommissionsAmount.ToString("C0")</div>
                <div class="kpi-sub">Calculated, awaiting payout</div>
            </CardContent>
        </SfCard>
        <SfCard CssClass="kpi-card">
            <CardContent>
                <div class="kpi-label">Documents</div>
                <div class="kpi-value">@_kpi.TotalDocuments</div>
                <div class="kpi-sub">Stored in DMS</div>
            </CardContent>
        </SfCard>
    </div>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private DashboardKpiDto? _kpi;

    protected override async Task OnInitializedAsync()
    {
        _kpi = await Api.GetDashboardKpiAsync(_tenantId);
    }
}

