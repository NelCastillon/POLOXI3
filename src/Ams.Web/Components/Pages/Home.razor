@page "/"
@using System.Globalization
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav

<PageTitle>Home Dashboard - AMS Enterprise</PageTitle>

<AppPageHeader Title="Enterprise Dashboard"
               Subtitle="@($"Good {_greeting}, here's your business overview")"
               Icon="bi-speedometer2">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh">
            <i class="bi bi-arrow-clockwise @(_loading ? "hd-spin" : "")" aria-hidden="true"></i>
            Refresh
        </button>
    </Actions>
</AppPageHeader>

<section class="hd-hero">
    <div class="hd-hero__content">
        <div class="hd-eyebrow"><i class="bi bi-stars" aria-hidden="true"></i> Agency command center</div>
        <h2>Operate the book of business with real-time visibility.</h2>
        <p>Track demand, client activity, billing health, and operational follow-through from one polished workspace.</p>
        <div class="hd-hero__actions">
            <a class="um-btn um-btn-primary" href="/tenant/dashboard">
                <i class="bi bi-speedometer2" aria-hidden="true"></i> Agency Overview
            </a>
            <a class="um-btn um-btn-ghost" href="/reports">
                <i class="bi bi-bar-chart-line" aria-hidden="true"></i> View Reports
            </a>
        </div>
        <div class="hd-growth-card" aria-label="Business growth pulse">
            <div class="hd-growth-copy">
                <span><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Growth pulse</span>
                <strong>Pipeline momentum</strong>
                <small>Current demand signals across leads, opportunities, accounts, and engagements.</small>
            </div>
            <div class="hd-growth-visual" aria-hidden="true">
                <div class="hd-growth-arrow"><i class="bi bi-arrow-up-right"></i></div>
                <div class="hd-growth-bars">
                    <div class="hd-growth-bar hd-growth-bar--lead" style="height:@BarHeight(_kpi?.OpenLeads)"><span></span></div>
                    <div class="hd-growth-bar hd-growth-bar--opp" style="height:@BarHeight(_kpi?.OpenOpportunities)"><span></span></div>
                    <div class="hd-growth-bar hd-growth-bar--acct" style="height:@BarHeight(_kpi?.ActiveAccounts)"><span></span></div>
                    <div class="hd-growth-bar hd-growth-bar--eng" style="height:@BarHeight(_kpi?.ActiveEngagements)"><span></span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="hd-hero__insight" aria-label="Dashboard highlights">
        <div class="hd-pie-card">
            <div class="hd-pie-orb" role="img" aria-label="Business mix pie chart">
                <svg class="hd-pie-svg" viewBox="0 0 42 42" aria-hidden="true" focusable="false">
                    <circle class="hd-pie-ring hd-pie-ring-accounts" cx="21" cy="21" r="15.915" pathLength="100" />
                    <circle class="hd-pie-ring hd-pie-ring-opps" cx="21" cy="21" r="15.915" pathLength="100" stroke-dasharray="@PieOppDash" stroke-dashoffset="@PieOppOffset" />
                    <circle class="hd-pie-ring hd-pie-ring-leads" cx="21" cy="21" r="15.915" pathLength="100" stroke-dasharray="@PieLeadDash" />
                </svg>
                <div class="hd-pie-core">
                    <span>@Kv(PieTotal)</span>
                    <small>Tracked</small>
                </div>
            </div>
            <div class="hd-pie-copy">
                <span class="hd-pie-kicker">Live mix</span>
                <strong>Pipeline distribution</strong>
                <small>Leads, opportunities, and active accounts from current agency data.</small>
            </div>
        </div>
        <div class="hd-hero__status">
            @* <div>
                <span>@Kv(_kpi?.OpenLeads)</span>
                <small><i class="hd-dot hd-dot-leads" aria-hidden="true"></i> Open Leads</small>
            </div>
            <div>
                <span>@Kv(_kpi?.OpenOpportunities)</span>
                <small><i class="hd-dot hd-dot-opps" aria-hidden="true"></i> Opportunities</small>
            </div>
            <div>
                <span>@Cv(_kpi?.CollectedThisMonthAmount)</span>
                <small><i class="hd-dot hd-dot-cash" aria-hidden="true"></i> Collected MTD</small>
            </div> *@
            <div>
                <span>@Kv(_kpi?.OpenLeads)</span>
                <small><i class="hd-dot hd-dot-leads" aria-hidden="true"></i> Open Leads</small>
            </div>
            <div>
                <span>@Kv(_kpi?.OpenOpportunities)</span>
                <small><i class="hd-dot hd-dot-opps" aria-hidden="true"></i> Opportunities</small>
            </div>
            <div>
                <span>@Cv(_kpi?.CollectedThisMonthAmount)</span>
                <small><i class="hd-dot hd-dot-cash" aria-hidden="true"></i> Collected MTD</small>
            </div>
        </div>
    </div>
</section>

@* -- KPI strip --------------------------------------------- *@
<section class="hd-kpi-section" aria-label="Enterprise KPI snapshot">
    <div class="hd-kpi-heading">
        <div>
            <span>Performance snapshot</span>
            <strong>Key operating indicators</strong>
        </div>
        <small>Live tenant, pipeline, billing, and operations metrics</small>
    </div>
    <div class="hd-kpi-row">
        <AppMetricCard CssClass="hd-kpi-card hd-kpi-card--tenants" Label="Tenants"           Value="@Kv(_kpi?.TotalTenants)"           SubLabel="Platform accounts" Icon="bi-buildings-fill"      Variant="blue"    Loading="@_loading" Href="/platform/tenants" />
        <AppMetricCard CssClass="hd-kpi-card hd-kpi-card--users" Label="Users"             Value="@Kv(_kpi?.TotalUsers)"             SubLabel="Active identities"  Icon="bi-people-fill"         Variant="purple"  Loading="@_loading" Href="/iam/users" />
        <AppMetricCard CssClass="hd-kpi-card hd-kpi-card--leads" Label="Open Leads"        Value="@Kv(_kpi?.OpenLeads)"              SubLabel="Demand pipeline"    Icon="bi-person-plus-fill"    Variant="purple"  Loading="@_loading" Href="/crm/leads" />
        <AppMetricCard CssClass="hd-kpi-card hd-kpi-card--accounts" Label="Active Accounts"   Value="@Kv(_kpi?.ActiveAccounts)"         SubLabel="Client records"     Icon="bi-building-fill-check" Variant="blue"    Loading="@_loading" Href="/accounts" />
        <AppMetricCard CssClass="hd-kpi-card hd-kpi-card--opportunities" Label="Opportunities"     Value="@Kv(_kpi?.OpenOpportunities)"      SubLabel="Revenue pipeline"   Icon="bi-trophy-fill"         Variant="green"   Loading="@_loading" Href="/crm/opportunities" />
        <AppMetricCard CssClass="hd-kpi-card hd-kpi-card--engagements" Label="Engagements"       Value="@Kv(_kpi?.ActiveEngagements)"      SubLabel="Work in progress"   Icon="bi-briefcase-fill"      Variant="green"   Loading="@_loading" Href="/engagements" />
        <AppMetricCard CssClass="hd-kpi-card hd-kpi-card--receivables" Label="Outstanding AR"    Value="@Cv(_kpi?.OutstandingInvoicesAmount)" SubLabel="Receivables risk" Icon="bi-hourglass-split" Variant="@(_kpi?.OutstandingInvoicesAmount > 0 ? "amber" : "default")" Loading="@_loading" Href="/billing/ar-aging" />
        <AppMetricCard CssClass="hd-kpi-card hd-kpi-card--collected" Label="Collected MTD"     Value="@Cv(_kpi?.CollectedThisMonthAmount)" SubLabel="Cash received" Icon="bi-cash-coin"       Variant="green"   Loading="@_loading" Href="/payments" />
    </div>
</section>

@* -- Middle row ------------------------------------------- *@
<div class="hd-mid-row">

    @* -- Action items ------------------------------------- *@
    <div class="hd-panel">
        <div class="hd-panel-hd">
            <i class="bi bi-lightning-charge" aria-hidden="true"></i>
            Action Items
            @if (_kpi is not null)
            {
                var total = (_kpi.PendingApprovals + _kpi.OpenIssues);
                if (total > 0)
                {
                    <span class="hd-badge hd-badge-amber">@total</span>
                }
            }
        </div>
        <div class="hd-action-list">
            <a class="hd-action-item @(_kpi?.PendingApprovals > 0 ? "is-alert" : "")" href="/governance/approvals">
                <span class="hd-action-icon"><i class="bi bi-list-check" aria-hidden="true"></i></span>
                <span class="hd-action-body">
                    <span class="hd-action-label">Pending Approvals</span>
                    <span class="hd-action-desc">Awaiting your review</span>
                </span>
                <span class="hd-action-count">@(_kpi?.PendingApprovals ?? 0)</span>
            </a>
            <a class="hd-action-item @(_kpi?.OpenIssues > 0 ? "is-alert" : "")" href="/ops/issues">
                <span class="hd-action-icon"><i class="bi bi-bug" aria-hidden="true"></i></span>
                <span class="hd-action-body">
                    <span class="hd-action-label">Open Issues</span>
                    <span class="hd-action-desc">Active issue tracker items</span>
                </span>
                <span class="hd-action-count">@(_kpi?.OpenIssues ?? 0)</span>
            </a>
            <a class="hd-action-item" href="/commissions/payout-batches">
                <span class="hd-action-icon"><i class="bi bi-percent" aria-hidden="true"></i></span>
                <span class="hd-action-body">
                    <span class="hd-action-label">Pending Commissions</span>
                    <span class="hd-action-desc">Calculated, awaiting payout</span>
                </span>
                <span class="hd-action-count">@Cv(_kpi?.PendingCommissionsAmount)</span>
            </a>
            <a class="hd-action-item" href="/documents">
                <span class="hd-action-icon"><i class="bi bi-folder2-open" aria-hidden="true"></i></span>
                <span class="hd-action-body">
                    <span class="hd-action-label">Documents</span>
                    <span class="hd-action-desc">Stored in DMS</span>
                </span>
                <span class="hd-action-count">@(_kpi?.TotalDocuments ?? 0)</span>
            </a>
        </div>
    </div>

    @* -- Quick navigation ---------------------------------- *@
    <div class="hd-panel">
        <div class="hd-panel-hd">
            <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
            Quick Access
        </div>
        <div class="hd-quick-grid">
            @foreach (var q in _quickLinks)
            {
                <a class="hd-quick-tile" href="@q.Href" title="@q.Label">
                    <i class="@q.Icon" aria-hidden="true"></i>
                    <span>@q.Label</span>
                </a>
            }
        </div>
    </div>

    @* -- Module summary ------------------------------------ *@
    <div class="hd-panel">
        <div class="hd-panel-hd">
            <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
            Module Overview
        </div>
        <div class="hd-module-list">
            @foreach (var m in _modules)
            {
                <a class="hd-module-row" href="@m.Href">
                    <span class="hd-module-icon hd-mod-@m.Color"><i class="@m.Icon" aria-hidden="true"></i></span>
                    <span class="hd-module-name">@m.Name</span>
                    <span class="hd-module-desc">@m.Desc</span>
                    <i class="bi bi-chevron-right hd-module-chevron" aria-hidden="true"></i>
                </a>
            }
        </div>
    </div>

</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private DashboardKpiDto? _kpi;
    private bool _loading = true;

    private string _greeting => DateTime.Now.Hour switch
    {
        < 12 => "morning",
        < 17 => "afternoon",
        _    => "evening"
    };

    private static string Kv(int? v)  => v?.ToString("N0") ?? "?";
    private static string Cv(decimal? v) => v?.ToString("C0") ?? "?";

    private int PieLeads => Math.Max(_kpi?.OpenLeads ?? 0, 0);
    private int PieOpportunities => Math.Max(_kpi?.OpenOpportunities ?? 0, 0);
    private int PieAccounts => Math.Max(_kpi?.ActiveAccounts ?? 0, 0);
    private int PieTotal => Math.Max(PieLeads + PieOpportunities + PieAccounts, 1);
    private decimal PieLeadShare => PieLeads * 100m / PieTotal;
    private decimal PieOppShare => PieOpportunities * 100m / PieTotal;
    private string PieLeadDash => PieDash(PieLeadShare);
    private string PieOppDash => PieDash(PieOppShare);
    private string PieOppOffset => (-PieLeadShare).ToString("0.##", CultureInfo.InvariantCulture);

    private static string PieDash(decimal value) => string.Create(CultureInfo.InvariantCulture, $"{value:0.##} {100 - value:0.##}");

    private int MaxGrowthValue => Math.Max(1, new[]
    {
        _kpi?.OpenLeads ?? 0,
        _kpi?.OpenOpportunities ?? 0,
        _kpi?.ActiveAccounts ?? 0,
        _kpi?.ActiveEngagements ?? 0
    }.Max());

    private string BarHeight(int? value)
    {
        var percent = Math.Clamp(((value ?? 0) * 100m / MaxGrowthValue), 18m, 100m);
        return percent.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    private static readonly (string Label, string Href, string Icon)[] _quickLinks =
    [
        ("New Lead",        "/crm/leads",                       "bi bi-person-plus"),
        ("New Account",     "/accounts",                    "bi bi-building-add"),
        ("New Invoice",     "/invoices",                    "bi bi-receipt"),
        ("New Engagement",  "/engagements",                 "bi bi-briefcase"),
        ("Approvals",       "/governance/approvals",        "bi bi-list-check"),
        ("Reports",         "/reports",                     "bi bi-bar-chart-line"),
        ("IAM / Users",     "/iam/users",                   "bi bi-shield-lock"),
        ("Platform",        "/platform",                    "bi bi-cpu"),
    ];

    private static readonly (string Name, string Desc, string Href, string Icon, string Color)[] _modules =
    [
        ("CRM",         "Leads, opportunities & pipeline",   "crm/leads",              "bi bi-funnel",          "violet"),
        ("Accounts",    "Client accounts & contacts",        "/accounts",           "bi bi-people",          "blue"),
        ("Operations",  "Agreements, engagements & tasks",   "/engagements",        "bi bi-briefcase",       "teal"),
        ("Billing",     "Invoices, payments & AR",           "/invoices",           "bi bi-receipt",         "green"),
        ("Finance",     "GL, journals & reconciliation",     "/finance/glaccounts", "bi bi-bank",            "indigo"),
        ("Commissions", "Plans, calculations & payouts",     "/commissions",        "bi bi-percent",         "amber"),
        ("Workflow",    "Canvas & automation definitions",   "/workflow",           "bi bi-diagram-3",       "cyan"),
        ("Documents",   "All stored files & DMS",           "/documents",          "bi bi-folder2-open",    "orange"),
    ];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try   { _kpi = await Api.GetDashboardKpiAsync(_tenantId); }
        catch { /* keep stale data if available */ }
        finally { _loading = false; }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}

