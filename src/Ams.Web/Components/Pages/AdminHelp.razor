@page "/admin/system/help"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Help &amp; Walkthroughs - AMS</PageTitle>

<AppPageHeader Title="Help &amp; Walkthroughs"
               Subtitle="Interactive guides, feature walkthroughs, video tutorials, and help documentation for all platform modules"
               Icon="bi-question-circle">
    <Actions>
        <button class="um-btn um-btn-ghost"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add Article</button>
    </Actions>
</AppPageHeader>

<!-- Search -->
<div class="hw-search-wrap"><i class="bi bi-search" aria-hidden="true"></i><input class="hw-search" placeholder="Search help articles and walkthroughs..." @bind="_search" @bind:event="oninput" /></div>

<!-- Category grid -->
<div class="hw-cat-grid">
    @foreach (var cat in _categories)
    {
        <div class="hw-cat-card @(_selectedCat==cat.Name?"hw-cat-sel":"")" @onclick="() => ToggleCat(cat.Name)">
            <div class="hw-cat-icon @cat.IconCss"><i class="bi bi-@cat.Icon" aria-hidden="true"></i></div>
            <div class="hw-cat-name">@cat.Name</div>
            <div class="hw-cat-count">@cat.ArticleCount articles</div>
        </div>
    }
</div>

<!-- Articles list -->
<div class="hw-articles">
    @foreach (var art in FilteredArticles)
    {
        <div class="hw-article-card">
            <div class="hw-art-hdr">
                <span class="hw-art-type-badge hw-type-@art.Type.ToLower()"><i class="bi bi-@TypeIcon(art.Type)" aria-hidden="true"></i> @art.Type</span>
                <span class="hw-art-module">@art.Module</span>
            </div>
            <div class="hw-art-title">@art.Title</div>
            <div class="hw-art-desc">@art.Description</div>
            <div class="hw-art-footer">
                <div class="hw-art-meta"><i class="bi bi-clock" aria-hidden="true"></i> @art.ReadTime</div>
                @if (art.IsNew) { <span class="hw-new-badge">New</span> }
                <button class="um-btn um-btn-ghost um-btn-xs" @onclick="()=>_activeArticle=art"><i class="bi bi-play-circle" aria-hidden="true"></i> @(art.Type=="Video"?"Watch":"Start")</button>
            </div>
        </div>
    }
</div>

@if (_activeArticle is not null)
{
    <div class="hw-viewer-overlay" @onclick="()=>_activeArticle=null">
        <div class="hw-viewer" @onclick:stopPropagation="true">
            <div class="hw-viewer-hdr">
                <span>@_activeArticle.Title</span>
                <button class="um-btn um-btn-ghost um-btn-xs" @onclick="()=>_activeArticle=null"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="hw-viewer-body">
                <p>@_activeArticle.Description</p>
                <p>This is an interactive walkthrough placeholder. In production, this panel would host an embedded video player, step-by-step guided overlay, or embedded documentation page for: <strong>@_activeArticle.Title</strong>.</p>
                <div class="hw-viewer-steps">
                    @foreach (var step in _activeArticle.Steps)
                    {
                        <div class="hw-step"><div class="hw-step-num"></div><div>@step</div></div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string _search = string.Empty;
    private string _selectedCat = string.Empty;
    private HelpArticle? _activeArticle;

    private IEnumerable<HelpArticle> FilteredArticles => _articles.Where(a =>
        (string.IsNullOrEmpty(_search) || a.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || a.Description.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_selectedCat) || a.Module == _selectedCat));

    private void ToggleCat(string name) => _selectedCat = _selectedCat == name ? string.Empty : name;

    private List<HelpCategory> _categories = [];
    private List<HelpArticle>  _articles   = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Administration","/admin"), new("Help & Walkthroughs",""));
        _categories =
        [
            new HelpCategory("Getting Started","rocket-takeoff","hw-ic-blue",6),
            new HelpCategory("Policies","shield-check","hw-ic-green",8),
            new HelpCategory("Billing","receipt","hw-ic-amber",7),
            new HelpCategory("Claims","exclamation-circle","hw-ic-red",5),
            new HelpCategory("Renewals","arrow-clockwise","hw-ic-blue",4),
            new HelpCategory("Integrations","plug","hw-ic-purple",6),
            new HelpCategory("Administration","gear","hw-ic-grey",9),
            new HelpCategory("Reports","bar-chart-line","hw-ic-blue",5),
        ];
        _articles =
        [
            new HelpArticle { Title="Getting Started: Your First Day in AMS",      Module="Getting Started", Type="Walkthrough", Description="A guided 10-step walkthrough of AMS core navigation, search, and your personal workbench.", ReadTime="10 min",  IsNew=true,  Steps=["Navigate to your workbench","Review your task queue","Search for an account","Open a policy","Create a follow-up task"] },
            new HelpArticle { Title="How to Process a Carrier Download",            Module="Integrations",    Type="Guide",       Description="Step-by-step guide to receiving, reviewing, and applying carrier download transactions.", ReadTime="8 min",   IsNew=false, Steps=["Open the Downloads page","Review transaction list","Identify exceptions","Resolve matched records","Clear exception queue"] },
            new HelpArticle { Title="Creating and Binding a New Policy",            Module="Policies",        Type="Walkthrough", Description="From submission to bind: creating a new policy application and completing the bind process.", ReadTime="12 min",  IsNew=false, Steps=["Start a new submission","Complete the application","Request quotes","Select a quote","Bind the policy","Generate policy documents"] },
            new HelpArticle { Title="Processing a First Notice of Loss (FNOL)",     Module="Claims",          Type="Video",       Description="Walk through the FNOL intake form and claims assignment workflow.", ReadTime="6 min",   IsNew=true,  Steps=["Navigate to Claims -> FNOL Intake","Enter loss details","Assign adjuster","Trigger notifications"] },
            new HelpArticle { Title="Setting Up Automation Workflows",              Module="Integrations",    Type="Walkthrough", Description="How to create no-code automation flows for renewals, payments, and downloads.", ReadTime="15 min",  IsNew=true,  Steps=["Open Automation Workflows","Click New Workflow","Select trigger event","Add conditions","Add actions","Test and activate"] },
            new HelpArticle { Title="Running Your Renewal Pipeline",               Module="Renewals",        Type="Guide",       Description="A guide to managing the 90/60/30 day renewal process and pipeline dashboard.", ReadTime="10 min",  IsNew=false, Steps=["Filter renewals by stage","Review renewal pipeline","Send 90-day notices","Record renewal activities","Mark as complete"] },
            new HelpArticle { Title="Configuring SLA Policies",                     Module="Administration",  Type="Guide",       Description="How to define service-level targets and assign them to teams.", ReadTime="7 min",   IsNew=false, Steps=["Open SLA Policy Setup","Click New SLA Policy","Set response and resolution targets","Assign to module","Monitor compliance"] },
            new HelpArticle { Title="Generating Commission Statements",             Module="Billing",         Type="Video",       Description="Walk through the commission payout and statement generation workflow.", ReadTime="8 min",   IsNew=false, Steps=["Open Commissions -> Statements","Select period","Run calculation","Review producer ledger","Approve and finalize"] },
        ];
    }

    private static string TypeIcon(string t) => t switch { "Video"=>"play-circle","Walkthrough"=>"signpost","Guide"=>"book",_=>"question-circle" };

    private sealed class HelpCategory(string name, string icon, string iconCss, int articleCount) { public string Name=name; public string Icon=icon; public string IconCss=iconCss; public int ArticleCount=articleCount; }
    private sealed class HelpArticle { public string Title{get;set;}=string.Empty; public string Module{get;set;}=string.Empty; public string Type{get;set;}=string.Empty; public string Description{get;set;}=string.Empty; public string ReadTime{get;set;}=string.Empty; public bool IsNew{get;set;} public List<string> Steps{get;set;}=[]; }
}
