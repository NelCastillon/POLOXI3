@page "/portal/mobile"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Mobile Experience Config — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Mobile Experience Configuration"
               Subtitle="Configure the agency mobile app and mobile-optimized portal experience for your clients"
               Icon="bi-phone-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="() => _showPreview = true">
            <i class="bi bi-phone" aria-hidden="true"></i> Preview App
        </button>
        <button class="um-btn um-btn-primary" @onclick="SaveAsync">
            <i class="bi bi-check-lg" aria-hidden="true"></i> Save Configuration
        </button>
    </Actions>
</AppPageHeader>

<div class="pm-layout">

    <!-- Settings panels -->
    <div class="pm-settings-col">

        <!-- App Identity -->
        <div class="pm-panel">
            <div class="pm-panel-hdr"><i class="bi bi-phone" aria-hidden="true"></i> App Identity</div>
            <div class="pm-form-grid">
                <div class="pm-field pm-field--full">
                    <label class="pm-lbl">App Display Name</label>
                    <SfTextBox @bind-Value="_cfg.AppName" Placeholder="e.g. First Insurance Mobile" />
                </div>
                <div class="pm-field">
                    <label class="pm-lbl">iOS App Store URL</label>
                    <SfTextBox @bind-Value="_cfg.IosUrl" Placeholder="https://apps.apple.com/…" />
                </div>
                <div class="pm-field">
                    <label class="pm-lbl">Android Play Store URL</label>
                    <SfTextBox @bind-Value="_cfg.AndroidUrl" Placeholder="https://play.google.com/…" />
                </div>
                <div class="pm-field">
                    <label class="pm-lbl">App Bundle ID</label>
                    <SfTextBox @bind-Value="_cfg.BundleId" Placeholder="com.agency.clientapp" />
                </div>
                <div class="pm-field">
                    <label class="pm-lbl">App Version</label>
                    <SfTextBox @bind-Value="_cfg.AppVersion" Placeholder="2.4.1" />
                </div>
            </div>
        </div>

        <!-- Push Notifications -->
        <div class="pm-panel">
            <div class="pm-panel-hdr"><i class="bi bi-bell" aria-hidden="true"></i> Push Notifications</div>
            <div class="pm-toggle-list">
                @foreach (var n in _notifications)
                {
                    <label class="pm-toggle-row">
                        <input type="checkbox" class="pm-chk" checked="@n.Enabled" @onchange="() => n.Enabled = !n.Enabled" />
                        <div class="pm-toggle-text">
                            <span class="pm-toggle-name">@n.Name</span>
                            <span class="pm-toggle-desc">@n.Description</span>
                        </div>
                    </label>
                }
            </div>
        </div>

        <!-- Features -->
        <div class="pm-panel">
            <div class="pm-panel-hdr"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> Mobile Features</div>
            <div class="pm-feature-grid">
                @foreach (var f in _features)
                {
                    <div class="pm-feature-tile @(f.Enabled ? "pm-ft--on" : "pm-ft--off")">
                        <div class="pm-ft-icon @f.IconCss"><i class="bi @f.Icon" aria-hidden="true"></i></div>
                        <div class="pm-ft-name">@f.Name</div>
                        <label class="pm-ft-toggle">
                            <input type="checkbox" checked="@f.Enabled" @onchange="() => f.Enabled = !f.Enabled" />
                            <span class="pm-ft-slider"></span>
                        </label>
                    </div>
                }
            </div>
        </div>

        <!-- Biometrics & Security -->
        <div class="pm-panel">
            <div class="pm-panel-hdr"><i class="bi bi-shield-lock" aria-hidden="true"></i> Biometrics &amp; Security</div>
            <div class="pm-toggle-list">
                <label class="pm-toggle-row">
                    <input type="checkbox" class="pm-chk" @bind="_cfg.BiometricLogin" />
                    <div class="pm-toggle-text">
                        <span class="pm-toggle-name">Enable Biometric Login (Face ID / Touch ID)</span>
                        <span class="pm-toggle-desc">Allow clients to authenticate with device biometrics</span>
                    </div>
                </label>
                <label class="pm-toggle-row">
                    <input type="checkbox" class="pm-chk" @bind="_cfg.ForceAppLock" />
                    <div class="pm-toggle-text">
                        <span class="pm-toggle-name">Force App Lock After Inactivity</span>
                        <span class="pm-toggle-desc">Require re-authentication after @_cfg.LockTimeoutMinutes minutes of inactivity</span>
                    </div>
                </label>
                <label class="pm-toggle-row">
                    <input type="checkbox" class="pm-chk" @bind="_cfg.RequireMfaOnMobile" />
                    <div class="pm-toggle-text">
                        <span class="pm-toggle-name">Require MFA for sensitive actions on mobile</span>
                        <span class="pm-toggle-desc">Payments, policy changes, and e-sign require step-up auth</span>
                    </div>
                </label>
            </div>
            <div class="pm-form-grid" style="padding:0 1rem 1rem">
                <div class="pm-field">
                    <label class="pm-lbl">Lock Timeout (minutes)</label>
                    <SfNumericTextBox TValue="int" @bind-Value="_cfg.LockTimeoutMinutes" Min="1" Max="60" />
                </div>
            </div>
        </div>
    </div>

    <!-- Right: phone mock -->
    <div class="pm-preview-col">
        <div class="pm-preview-card">
            <div class="pm-preview-hdr">App Preview</div>
            <div class="pm-phone-frame">
                <div class="pm-phone-screen">
                    <div class="pm-phone-notch"></div>
                    <div class="pm-phone-nav">
                        <span class="pm-phone-app-name">@_cfg.AppName</span>
                    </div>
                    <div class="pm-phone-body">
                        <div class="pm-phone-greet">Good morning 👋</div>
                        <div class="pm-phone-cards">
                            @foreach (var f in _features.Where(f => f.Enabled).Take(4))
                            {
                                <div class="pm-phone-card">
                                    <i class="bi @f.Icon pm-phone-card-icon" aria-hidden="true"></i>
                                    <span class="pm-phone-card-lbl">@f.Name</span>
                                </div>
                            }
                        </div>
                        <div class="pm-phone-policy-card">
                            <div class="pm-phone-pol-hdr">Active Policies</div>
                            <div class="pm-phone-pol-row"><i class="bi bi-house" aria-hidden="true"></i> Homeowners — Expires Jan 2026</div>
                            <div class="pm-phone-pol-row"><i class="bi bi-car-front" aria-hidden="true"></i> Auto — Expires Mar 2026</div>
                        </div>
                        @if (_cfg.BiometricLogin)
                        {
                            <div class="pm-phone-badge"><i class="bi bi-fingerprint" aria-hidden="true"></i> Biometric login active</div>
                        }
                    </div>
                    <div class="pm-phone-tab-bar">
                        <div class="pm-phone-tab pm-phone-tab--active"><i class="bi bi-house-fill" aria-hidden="true"></i><span>Home</span></div>
                        <div class="pm-phone-tab"><i class="bi bi-shield" aria-hidden="true"></i><span>Policies</span></div>
                        <div class="pm-phone-tab"><i class="bi bi-folder2" aria-hidden="true"></i><span>Docs</span></div>
                        <div class="pm-phone-tab"><i class="bi bi-chat" aria-hidden="true"></i><span>Messages</span></div>
                        <div class="pm-phone-tab"><i class="bi bi-person" aria-hidden="true"></i><span>Me</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;
    private bool _showPreview;
    private Guid _recordId;

    private MobileConfig _cfg = new();

    private List<PushNotif> _notifications = [];
    private List<MobileFeature> _features = [];

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Portal","/portal/users"), new("Mobile Config",""));
        var settings = await Api.GetPortalMobileSettingsAsync(_tenantId);
        var records = await Api.SearchPortalAdminRecordsAsync(_tenantId, "PortalMobile");
        _recordId = records?.Items.FirstOrDefault()?.PortalAdminRecordId ?? Guid.Empty;
        if (settings is null) return;
        _cfg = new MobileConfig { AppName = settings.AppName, IosUrl = settings.IosUrl, AndroidUrl = settings.AndroidUrl, BundleId = settings.BundleId, AppVersion = settings.AppVersion, BiometricLogin = settings.BiometricLogin, ForceAppLock = settings.ForceAppLock, LockTimeoutMinutes = settings.LockTimeoutMinutes, RequireMfaOnMobile = settings.RequireMfaOnMobile };
        _notifications = settings.Notifications.Select(n => new PushNotif { Name = n.Name, Description = n.Description, Enabled = n.Enabled }).ToList();
        _features = settings.Features.Select(f => new MobileFeature { Name = f.Name, Icon = f.Icon, IconCss = f.IconCss, Enabled = f.Enabled }).ToList();
    }

    private async Task SaveAsync()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(new { _cfg.AppName, _cfg.IosUrl, _cfg.AndroidUrl, _cfg.BundleId, _cfg.AppVersion, _cfg.BiometricLogin, _cfg.ForceAppLock, _cfg.LockTimeoutMinutes, _cfg.RequireMfaOnMobile, Notifications = _notifications, Features = _features });
        if (_recordId != Guid.Empty)
            await Api.UpdatePortalAdminRecordAsync(_recordId, new UpsertPortalAdminRecordRequest(_tenantId, "PortalMobile", "mobile", _cfg.AppName, "Active", json));
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = "Mobile configuration saved.", CssClass = "e-toast-success" });
    }

    private sealed class MobileConfig
    {
        public string AppName             { get; set; } = string.Empty;
        public string IosUrl              { get; set; } = string.Empty;
        public string AndroidUrl          { get; set; } = string.Empty;
        public string BundleId            { get; set; } = string.Empty;
        public string AppVersion          { get; set; } = string.Empty;
        public bool   BiometricLogin      { get; set; }
        public bool   ForceAppLock        { get; set; }
        public int    LockTimeoutMinutes  { get; set; } = 15;
        public bool   RequireMfaOnMobile  { get; set; }
    }

    private sealed class PushNotif
    {
        public string Name        { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public bool   Enabled     { get; set; }
    }

    private sealed class MobileFeature
    {
        public string Name    { get; set; } = string.Empty;
        public string Icon    { get; set; } = "bi-circle";
        public string IconCss { get; set; } = string.Empty;
        public bool   Enabled { get; set; }
    }
}
