@page "/tenant/marketing/templates2"
@page "/tenant/marketing/segments2"
@page "/tenant/marketing/cross-sell2"
@page "/tenant/marketing/win-back2"
@page "/tenant/marketing/referrals2"
@page "/tenant/marketing/reviews2"
@page "/tenant/marketing/consent2"
@page "/tenant/marketing/defaults2"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Marketing Setup - AMS</PageTitle>

<AppPageHeader Title="Marketing Setup"
               Subtitle="Tenant admin control center for campaign templates, audience segments, cross-sell, win-back, referrals, review requests, consent, and campaign defaults"
               Icon="bi-megaphone-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/tenant/marketing/templates")'>
            <i class="bi bi-layout-text-sidebar" aria-hidden="true"></i> Campaign Templates
        </button>
    </Actions>
</AppPageHeader>

<section class="mktcfg-hero" aria-label="Marketing setup overview">
    <div>
        <span class="mktcfg-eyebrow">Tenant administration</span>
        <h2>Marketing Setup Workflow</h2>
        <p>Configure the agency marketing engine across templates, audiences, cross-sell, win-back, referrals, review requests, consent governance, and campaign defaults.</p>
    </div>
    <div class="mktcfg-hero-grid">
        @foreach (var action in _quickActions)
        {
            <button class="mktcfg-quick-action" @onclick="() => Nav.NavigateTo(action.Url)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
</section>

<section class="mktcfg-kpi-grid" aria-label="Marketing setup metrics">
    @Kpi("Templates", "36", "12 active journeys", "bi-layout-text-sidebar", "mktcfg-tone-blue")
    @Kpi("Segments", "18", "Audience definitions", "bi-pie-chart", "mktcfg-tone-violet")
    @Kpi("Consent", "96%", "Marketable contacts", "bi-toggle-on", "mktcfg-tone-green")
    @Kpi("Reviews", "241", "Pending requests", "bi-star", "mktcfg-tone-amber")
</section>

<section class="mktcfg-command-bar" aria-label="Marketing setup filters">
    <div class="mktcfg-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search"
               placeholder="Search marketing setup, owner, control, module..."
               @bind="_search"
               @bind:event="oninput" />
    </div>
    <div class="mktcfg-pill-group" role="group" aria-label="Marketing workflow filter">
        @foreach (var filter in _filters)
        {
            <button class="mktcfg-pill @(_filter == filter.Key ? "mktcfg-pill--active" : "")"
                    @onclick="() => _filter = filter.Key">
                @filter.Label
                <span>@FilterCount(filter.Key)</span>
            </button>
        }
    </div>
</section>

<section class="mktcfg-layout">
    <div class="mktcfg-flow" aria-label="Marketing setup workflow lanes">
        @foreach (var lane in _lanes)
        {
            var laneItems = FilteredWorkflow.Where(x => x.Stage == lane.Key).ToList();
            <article class="mktcfg-lane">
                <header class="mktcfg-lane-header">
                    <div>
                        <span class="mktcfg-lane-title">@lane.Label</span>
                        <span class="mktcfg-lane-subtitle">@lane.Description</span>
                    </div>
                    <span class="mktcfg-lane-count">@laneItems.Count</span>
                </header>

                <div class="mktcfg-lane-list">
                    @if (laneItems.Count == 0)
                    {
                        <div class="mktcfg-empty-mini">No visible workflow items.</div>
                    }
                    else
                    {
                        @foreach (var item in laneItems)
                        {
                            <button class="mktcfg-work-card @(item.Risk == "High" ? "mktcfg-work-card--risk" : "")"
                                    @onclick="() => _selected = item">
                                <div class="mktcfg-work-topline">
                                    <span class="mktcfg-chip @ToneCss(item.Domain)">@item.Domain</span>
                                    <span class="mktcfg-status @RiskCss(item.Risk)">@item.Risk</span>
                                </div>
                                <strong>@item.Title</strong>
                                <p>@item.Summary</p>
                                <div class="mktcfg-work-meta">
                                    <span><i class="bi bi-person" aria-hidden="true"></i> @item.Owner</span>
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> @item.Sla</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            </article>
        }
    </div>

    <aside class="mktcfg-admin-panel" aria-label="Tenant marketing administration controls">
        @if (_selected is null)
        {
            <div class="mktcfg-side-empty">
                <i class="bi bi-megaphone-fill" aria-hidden="true"></i>
                <h3>Marketing governance</h3>
                <p>Select a workflow item to inspect owner, SLA, risk, marketing control, and setup module.</p>
            </div>
        }
        else
        {
            <div class="mktcfg-detail-header">
                <span class="mktcfg-chip @ToneCss(_selected.Domain)">@_selected.Domain</span>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close details">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h3>@_selected.Title</h3>
            <p>@_selected.Summary</p>

            <dl class="mktcfg-detail-list">
                <div><dt>Owner</dt><dd>@_selected.Owner</dd></div>
                <div><dt>Stage</dt><dd>@_selected.Stage</dd></div>
                <div><dt>Risk</dt><dd><span class="mktcfg-status @RiskCss(_selected.Risk)">@_selected.Risk</span></dd></div>
                <div><dt>SLA</dt><dd>@_selected.Sla</dd></div>
                <div><dt>Control</dt><dd>@_selected.Control</dd></div>
            </dl>

            <div class="mktcfg-policy-card">
                <strong>Tenant marketing controls</strong>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Consent, opt-out, and channel eligibility enforced</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Segment rules, cross-sell, win-back, and referral logic governed</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Template approval, review requests, and defaults audited</span>
            </div>

            <div class="mktcfg-detail-actions">
                <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selected.Url)">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Module
                </button>
                <button class="um-btn um-btn-ghost" @onclick="() => Advance(_selected)">
                    <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Advance
                </button>
            </div>
        }
    </aside>
</section>

<section class="mktcfg-module-grid" aria-label="Marketing setup modules">
    @foreach (var module in _modules)
    {
        <button class="mktcfg-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
            <span class="mktcfg-module-icon @ToneCss(module.Domain)"><i class="bi @module.Icon" aria-hidden="true"></i></span>
            <span class="mktcfg-module-content">
                <strong>@module.Title</strong>
                <small>@module.Description</small>
            </span>
            <i class="bi bi-chevron-right mktcfg-module-arrow" aria-hidden="true"></i>
        </button>
    }
</section>

@code {
    private string _search = string.Empty;
    private string _filter = string.Empty;
    private MarketingWorkflowItem? _selected;
    private readonly List<MarketingWorkflowItem> _workflow = [];

    private readonly Lane[] _lanes =
    [
        new("Design", "Design", "Templates and defaults"),
        new("Target", "Target", "Segments and eligibility"),
        new("Activate", "Activate", "Cross-sell, win-back, referrals"),
        new("Comply", "Comply", "Consent and approvals"),
        new("Measure", "Measure", "Reviews and outcomes")
    ];

    private readonly Filter[] _filters =
    [
        new("", "All"),
        new("risk", "High Risk"),
        new("segments", "Segments"),
        new("consent", "Consent"),
        new("reviews", "Reviews")
    ];

    private readonly MarketingModule[] _modules =
    [
        new("Campaign Templates", "Create and approve reusable email, SMS, landing page, and journey templates.", "/tenant/marketing/templates", "bi-layout-text-sidebar", "Templates"),
        new("Audience Segments", "Define dynamic audiences, eligibility rules, exclusions, and refresh cadence.", "/tenant/marketing/segments", "bi-pie-chart", "Segments"),
        new("Cross-Sell Rules", "Configure coverage gap signals, product eligibility, producer routing, and suppression.", "/tenant/marketing/cross-sell", "bi-arrows-expand", "Cross-Sell"),
        new("Win-Back Rules", "Control lost account cohorts, timing, offers, channels, and contact limits.", "/tenant/marketing/win-back", "bi-arrow-repeat", "Win-Back"),
        new("Referral Rules", "Manage referral triggers, rewards, source tracking, and approval workflow.", "/tenant/marketing/referrals", "bi-person-plus", "Referrals"),
        new("Review Request Rules", "Configure NPS/review triggers, timing, channels, and negative feedback routing.", "/tenant/marketing/reviews", "bi-star", "Reviews"),
        new("Marketing Consent", "Govern opt-in, opt-out, channel consent, suppression lists, and compliance evidence.", "/tenant/marketing/consent", "bi-toggle-on", "Consent"),
        new("Campaign Defaults", "Set default send windows, UTM tags, sender profiles, attribution, and approval policy.", "/tenant/marketing/defaults", "bi-gear", "Defaults")
    ];

    private readonly MarketingModule[] _quickActions =
    [
        new("Templates", "", "/tenant/marketing/templates", "bi-layout-text-sidebar", "Templates"),
        new("Segments", "", "/tenant/marketing/segments", "bi-pie-chart", "Segments"),
        new("Consent", "", "/tenant/marketing/consent", "bi-toggle-on", "Consent"),
        new("Defaults", "", "/tenant/marketing/defaults", "bi-gear", "Defaults")
    ];

    private IEnumerable<MarketingWorkflowItem> FilteredWorkflow => _workflow.Where(item =>
        (string.IsNullOrWhiteSpace(_filter) || _filter switch
        {
            "risk" => item.Risk == "High",
            "segments" => item.Domain == "Segments",
            "consent" => item.Domain == "Consent",
            "reviews" => item.Domain == "Reviews",
            _ => true
        }) &&
        (string.IsNullOrWhiteSpace(_search) ||
         item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Domain.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Control.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(x => x.Risk == "High")
        .ThenBy(x => x.Stage)
        .ThenBy(x => x.Title);

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Marketing Setup", "/tenant/marketing/templates"));
        BuildWorkflow();
        _selected = _workflow.FirstOrDefault(x => x.Risk == "High") ?? _workflow.FirstOrDefault();
    }

    private void BuildWorkflow()
    {
        _workflow.Clear();
        _workflow.AddRange(
        [
            new("Renewal campaign template approval", "Commercial renewal journey template v3 needs compliance approval before publishing.", "Templates", "High", "Design", "Diana Perez", "Today", "Template approval", "/tenant/marketing/templates"),
            new("Campaign default sender review", "Default sender profile and UTM attribution rules require annual tenant admin review.", "Defaults", "Medium", "Design", "Sarah Kim", "This week", "Campaign default policy", "/tenant/marketing/defaults"),
            new("Audience segment refresh", "High-value commercial segment has stale criteria and needs refresh before cross-sell campaigns.", "Segments", "High", "Target", "James Park", "48h", "Segment governance", "/tenant/marketing/segments"),
            new("Cross-sell suppression tuning", "Cyber and umbrella cross-sell campaigns need updated appetite exclusions and contact limits.", "Cross-Sell", "Medium", "Activate", "Maria Santos", "5 days", "Eligibility and suppression", "/tenant/marketing/cross-sell"),
            new("Win-back timing rules", "Lost account win-back sequence needs new delay windows and producer approval routing.", "Win-Back", "Medium", "Activate", "Kevin Obi", "This week", "Win-back governance", "/tenant/marketing/win-back"),
            new("Referral reward rules", "Referral campaign reward criteria and source tracking need final tenant admin approval.", "Referrals", "Low", "Activate", "Lisa Chen", "2 weeks", "Referral policy", "/tenant/marketing/referrals"),
            new("Consent exception review", "SMS campaign contains contacts with missing channel consent and must be remediated.", "Consent", "High", "Comply", "Robert Yamamoto", "Same day", "Consent enforcement", "/tenant/marketing/consent"),
            new("Review request routing", "Negative review responses need escalation routing to service managers before public review request.", "Reviews", "High", "Measure", "Diana Perez", "24h", "Review request governance", "/tenant/marketing/reviews")
        ]);
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _filter = string.Empty;
    }

    private void Advance(MarketingWorkflowItem item)
    {
        item.Stage = item.Stage switch
        {
            "Design" => "Target",
            "Target" => "Activate",
            "Activate" => "Comply",
            "Comply" => "Measure",
            _ => "Measure"
        };
    }

    private int FilterCount(string key) => key switch
    {
        "risk" => _workflow.Count(x => x.Risk == "High"),
        "segments" => _workflow.Count(x => x.Domain == "Segments"),
        "consent" => _workflow.Count(x => x.Domain == "Consent"),
        "reviews" => _workflow.Count(x => x.Domain == "Reviews"),
        _ => _workflow.Count
    };

    private static string ToneCss(string domain) => domain switch
    {
        "Templates" => "mktcfg-tone-blue",
        "Segments" => "mktcfg-tone-violet",
        "Cross-Sell" => "mktcfg-tone-green",
        "Win-Back" => "mktcfg-tone-cyan",
        "Referrals" => "mktcfg-tone-amber",
        "Reviews" => "mktcfg-tone-red",
        "Consent" => "mktcfg-tone-green",
        "Defaults" => "mktcfg-tone-neutral",
        _ => "mktcfg-tone-neutral"
    };

    private static string RiskCss(string risk) => risk switch
    {
        "High" => "mktcfg-status-high",
        "Medium" => "mktcfg-status-medium",
        _ => "mktcfg-status-low"
    };

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="mktcfg-kpi-card">
        <span class="mktcfg-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span>
        <div>
            <strong>@value</strong>
            <span>@label</span>
            <small>@meta</small>
        </div>
    </article>;

    private sealed record Lane(string Key, string Label, string Description);
    private sealed record Filter(string Key, string Label);
    private sealed record MarketingModule(string Title, string Description, string Url, string Icon, string Domain)
    {
        public string Label => Title;
    }

    private sealed class MarketingWorkflowItem(string title, string summary, string domain, string risk, string stage, string owner, string sla, string control, string url)
    {
        public string Title { get; set; } = title;
        public string Summary { get; set; } = summary;
        public string Domain { get; set; } = domain;
        public string Risk { get; set; } = risk;
        public string Stage { get; set; } = stage;
        public string Owner { get; set; } = owner;
        public string Sla { get; set; } = sla;
        public string Control { get; set; } = control;
        public string Url { get; set; } = url;
    }
}
