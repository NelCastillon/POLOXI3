@page "/documents/forms"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Documents
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>ACORD Forms Center — AMS</PageTitle>

<div class="af-enterprise-page">
    <header class="af-header">
        <div class="af-header-left">
            <div class="af-lob-icon"><i class="bi bi-file-earmark-medical" aria-hidden="true"></i></div>
            <div class="af-header-info">
                <div class="af-title-row">
                    <h1 class="af-page-title">ACORD Forms Center</h1>
                    <span class="af-status-pill"><i class="bi bi-stars" aria-hidden="true"></i> Policy-aware forms</span>
                    <span class="af-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Synced library</span>
                </div>
                <div class="af-sub-row">
                    <span class="af-sub-chip"><i class="bi bi-folder2-open" aria-hidden="true"></i> Documents workflow</span>
                    <span class="af-sub-chip"><i class="bi bi-file-earmark-check" aria-hidden="true"></i> @_filtered.Count visible forms</span>
                    @if (!string.IsNullOrWhiteSpace(_activeFilter))
                    {
                        <span class="af-filter-note"><i class="bi bi-funnel" aria-hidden="true"></i> @FilterLabel(_activeFilter)</span>
                    }
                </div>
            </div>
        </div>
        <div class="af-header-actions">
            <button class="um-btn um-btn-ghost" @onclick="NavigateDocuments">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Documents
            </button>
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "af-spin" : null)" aria-hidden="true"></i> Refresh
            </button>
            <button class="um-btn um-btn-primary" @onclick="OpenCreate">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Form
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger af-load-error" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
            <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i> @_loadError
        </div>
    }

    <section class="af-kpi-strip" aria-label="ACORD form metrics">
        @Kpi("Total Forms", _items.Count.ToString(), "All configured ACORD records", "bi-file-earmark-medical", "", string.Empty)
        @Kpi("Completed", CountStatus("Completed").ToString(), "Completed forms", "bi-check-circle", "af-ki-green", "Completed")
        @Kpi("In Progress", CountStatus("In Progress").ToString(), "Draft and in-progress forms", "bi-hourglass-split", "af-ki-amber", "In Progress")
        @Kpi("Pending E-Sign", CountStatus("Pending E-Sign").ToString(), "Ready for signature", "bi-pen", "af-ki-cyan", "Pending E-Sign")
        @Kpi("AI Pre-filled", _items.Count(f => f.AiPrefilled).ToString(), "Forms populated by automation", "bi-stars", "af-ki-purple", "prefilled")
        @Kpi("Needs Review", _items.Count(f => IsReviewStatus(f.Status)).ToString(), "Rejected or blank forms", "bi-exclamation-circle", "af-ki-red", "review")
    </section>

    <section class="af-enterprise-search" aria-label="Search ACORD forms">
        <div class="af-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
        <div class="af-search-body">
            <label for="acord-search">Search forms</label>
            <input id="acord-search" class="af-search-input" type="search" placeholder="Search by form number, name, policy, owner, or line..." @bind="_search" @bind:event="oninput" @bind:after="ApplyFilters" />
            <div class="af-search-hint">Use KPI cards, tabs, and text search to focus the ACORD library.</div>
        </div>
        <select class="af-filter-select" @bind="_lineFilter" @bind:after="ApplyFilters" aria-label="Line of business filter">
            <option value="">All Lines</option>
            @foreach (var line in _lines)
            {
                <option value="@line">@line</option>
            }
        </select>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset
        </button>
        <div class="af-search-result"><strong>@_filtered.Count</strong><span>visible</span></div>
    </section>

    <nav class="af-view-tabs" aria-label="ACORD status views">
        @foreach (var tab in _tabs)
        {
            <button class="af-view-tab @(_activeFilter == tab.Key ? "af-view-tab--active" : null)" @onclick="() => SetFilter(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label
                <span class="af-tab-count">@FilterCount(tab.Key)</span>
            </button>
        }
    </nav>

    <section class="af-workflow-strip" aria-label="ACORD workflow summary">
        @WorkflowCard("Prepare", "Blank", "Start new or configure mapped forms", "bi-file-earmark", "Blank")
        @WorkflowCard("Populate", "In Progress", "Policy data mapped into active forms", "bi-stars", "In Progress")
        @WorkflowCard("Review", "Completed", "Validated and ready for downstream use", "bi-check2-circle", "Completed")
        @WorkflowCard("Sign", "Pending E-Sign", "Routed to the e-sign queue", "bi-pen", "Pending E-Sign")
        @WorkflowCard("Exception", "Rejected", "Forms requiring correction", "bi-exclamation-triangle", "Rejected")
    </section>

    <section class="af-grid-wrap" aria-label="ACORD forms library">
        <div class="af-grid-toolbar">
            <div>
                <strong>Forms Library</strong>
                <span>@_filtered.Count of @_items.Count forms</span>
            </div>
            <div class="af-toolbar-actions">
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
                <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenSelectedPrefill" disabled="@(_selected is null)"><i class="bi bi-stars" aria-hidden="true"></i> AI Auto-Fill Selected</button>
            </div>
        </div>

        @if (_loading)
        {
            <div class="af-loading"><i class="bi bi-arrow-repeat af-spin" aria-hidden="true"></i><span>Loading ACORD forms…</span></div>
        }
        else if (_filtered.Count == 0)
        {
            <div class="af-empty-state"><i class="bi bi-file-earmark-medical" aria-hidden="true"></i><strong>No forms found</strong><span>Adjust filters or add a new ACORD form.</span></div>
        }
        else
        {
            <div class="af-table-scroll">
                <table class="af-table">
                    <thead>
                        <tr>
                            <th>Form</th>
                            <th>Line</th>
                            <th>Status</th>
                            <th>Policy</th>
                            <th>Owner</th>
                            <th>AI</th>
                            <th>Modified</th>
                            <th class="af-actions-col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var form in _filtered)
                        {
                            <tr class="af-table-row @(form.AcordFormId == _selected?.AcordFormId ? "af-table-row--selected" : null)" @onclick="() => OpenDrawer(form)">
                                <td>
                                    <div class="af-form-cell">
                                        <span class="af-avatar"><i class="bi bi-file-earmark-medical" aria-hidden="true"></i></span>
                                        <div><strong>ACORD @form.FormNumber</strong><span>@form.FormName</span><small>Edition @form.Edition</small></div>
                                    </div>
                                </td>
                                <td><span class="af-line-chip">@form.LineOfBusiness</span></td>
                                <td><span class="af-status-chip @StatusCss(form.Status)">@form.Status</span></td>
                                <td>@(string.IsNullOrWhiteSpace(form.PolicyNumber) ? "—" : form.PolicyNumber)</td>
                                <td>@(string.IsNullOrWhiteSpace(form.OwnerName) ? "Unassigned" : form.OwnerName)</td>
                                <td>@AiCell(form)</td>
                                <td>@form.LastModifiedDateUtc.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                                <td class="af-actions-col">
                                    <button class="um-btn um-btn-ghost um-btn-sm af-ctx-btn" title="Actions" @onclick:stopPropagation="true" @onclick="(e) => OpenContextMenu(e, form)">
                                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@if (_contextForm is not null)
{
    <div class="af-context-menu" style="left:@_contextLeft;top:@_contextTop" @onclick:stopPropagation="true">
        <button @onclick="() => OpenDrawer(_contextForm)"><i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i> Open Details</button>
        <button @onclick="() => OpenPrefill(_contextForm)"><i class="bi bi-stars" aria-hidden="true"></i> AI Auto-Fill</button>
        <button @onclick="() => SendForESignAsync(_contextForm)"><i class="bi bi-pen" aria-hidden="true"></i> Send for E-Sign</button>
        <button @onclick="() => AddToPacketAsync(_contextForm)"><i class="bi bi-collection-plus" aria-hidden="true"></i> Add to Packet</button>
        <button @onclick="() => MarkCompletedAsync(_contextForm)"><i class="bi bi-check2-circle" aria-hidden="true"></i> Mark Completed</button>
        <button @onclick="() => OpenReject(_contextForm)"><i class="bi bi-x-octagon" aria-hidden="true"></i> Reject / Needs Fix</button>
    </div>
}

@if (_showDrawer && _selected is not null)
{
    <div class="af-drawer-backdrop" @onclick="CloseDrawer"></div>
    <aside class="af-drawer" role="dialog" aria-modal="true" aria-label="ACORD form details">
        <div class="af-drawer-head">
            <div><h2 class="af-drawer-title">ACORD @_selected.FormNumber — @_selected.FormName</h2><span class="af-drawer-sub">@_selected.LineOfBusiness • Edition @_selected.Edition</span></div>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseDrawer"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <div class="af-drawer-body">
            <div class="af-drawer-banner @StatusBannerCss(_selected.Status)"><i class="bi bi-file-earmark-check" aria-hidden="true"></i><span>@_selected.Status</span><strong>@_selected.LastModifiedDateUtc.ToLocalTime().ToString("MMM d, yyyy")</strong></div>
            <div class="af-drawer-meta">
                @Meta("Policy", string.IsNullOrWhiteSpace(_selected.PolicyNumber) ? "Not linked" : _selected.PolicyNumber)
                @Meta("Owner", string.IsNullOrWhiteSpace(_selected.OwnerName) ? "Unassigned" : _selected.OwnerName)
                @Meta("AI Pre-filled", _selected.AiPrefilled ? "Yes" : "No")
                @Meta("Confidence", _selected.PrefillConfidence is null ? "—" : $"{_selected.PrefillConfidence}%")
            </div>
            <section class="af-drawer-section"><h3><i class="bi bi-card-text" aria-hidden="true"></i> Description</h3><p>@(string.IsNullOrWhiteSpace(_selected.Description) ? "No description has been added for this form." : _selected.Description)</p></section>
            <section class="af-drawer-section"><h3><i class="bi bi-diagram-3" aria-hidden="true"></i> Workflow</h3><div class="af-tag-list"><span>@_selected.LineOfBusiness</span><span>Edition @_selected.Edition</span><span>@_selected.Status</span>@if (_selected.AiPrefilled) { <span>AI mapped @_selected.PrefillFieldCount fields</span> }</div></section>
            <div class="af-drawer-actions">
                <button class="um-btn um-btn-primary" @onclick="() => OpenPrefill(_selected)"><i class="bi bi-stars" aria-hidden="true"></i> AI Auto-Fill</button>
                <button class="um-btn um-btn-ghost" @onclick="() => SendForESignAsync(_selected)"><i class="bi bi-pen" aria-hidden="true"></i> Send for E-Sign</button>
                <button class="um-btn um-btn-ghost" @onclick="() => AddToPacketAsync(_selected)"><i class="bi bi-collection-plus" aria-hidden="true"></i> Add to Packet</button>
                <button class="um-btn um-btn-ghost" @onclick="() => MarkCompletedAsync(_selected)"><i class="bi bi-check2-circle" aria-hidden="true"></i> Mark Complete</button>
                <button class="um-btn um-btn-ghost" @onclick="() => OpenReject(_selected)"><i class="bi bi-x-octagon" aria-hidden="true"></i> Reject</button>
            </div>
        </div>
    </aside>
}

@if (_showCreate)
{
    <div class="af-modal-backdrop" role="dialog" aria-modal="true" aria-label="Add ACORD form">
        <div class="af-modal af-action-modal">
            <div class="um-modal-header"><i class="bi bi-plus-circle" aria-hidden="true"></i><span>Add ACORD Form</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showCreate = false"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm Model="_form" OnValidSubmit="CreateFormAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Form Number</label><InputText class="form-control" @bind-Value="_form.FormNumber" /><ValidationMessage For="() => _form.FormNumber" class="text-danger" /></div>
                    <div class="um-field"><label>Form Name</label><InputText class="form-control" @bind-Value="_form.FormName" /><ValidationMessage For="() => _form.FormName" class="text-danger" /></div>
                    <div class="um-field"><label>Line of Business</label><InputSelect class="form-select" @bind-Value="_form.LineOfBusiness"><option value="">Select line...</option>@foreach (var line in _lines) { <option value="@line">@line</option> }</InputSelect><ValidationMessage For="() => _form.LineOfBusiness" class="text-danger" /></div>
                    <div class="um-field"><label>Edition</label><InputText class="form-control" @bind-Value="_form.Edition" /><ValidationMessage For="() => _form.Edition" class="text-danger" /></div>
                    <div class="um-field"><label>Status</label><InputSelect class="form-select" @bind-Value="_form.Status">@foreach (var status in _statuses) { <option value="@status">@status</option> }</InputSelect><ValidationMessage For="() => _form.Status" class="text-danger" /></div>
                    <div class="um-field"><label>Policy Number</label><InputText class="form-control" @bind-Value="_form.PolicyNumber" /><ValidationMessage For="() => _form.PolicyNumber" class="text-danger" /></div>
                    <div class="um-field"><label>Owner</label><InputText class="form-control" @bind-Value="_form.OwnerName" /><ValidationMessage For="() => _form.OwnerName" class="text-danger" /></div>
                    <div class="um-field um-field-wide"><label>Description</label><InputTextArea class="form-control" @bind-Value="_form.Description" /><ValidationMessage For="() => _form.Description" class="text-danger" /></div>
                </div></div>
                <div class="um-modal-footer"><button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi bi-save" aria-hidden="true"></i> Save Form</button><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showCreate = false">Cancel</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showPrefill && _prefillForm is not null)
{
    <div class="af-modal-backdrop" role="dialog" aria-modal="true" aria-label="AI prefill ACORD form">
        <div class="af-modal af-action-modal">
            <div class="um-modal-header"><i class="bi bi-stars" aria-hidden="true"></i><span>AI Policy-Aware Pre-fill</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="ClosePrefill"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="um-modal-body af-prefill-body">
                <div class="af-modal-intro"><span><i class="bi bi-stars" aria-hidden="true"></i> Document Intelligence</span><p>Populate ACORD @_prefillForm.FormNumber from policy, insured, coverage, and exposure data. Results are persisted to the forms library.</p></div>
                <div class="um-form-grid">
                    <div class="um-field"><label>Policy Number</label><input class="form-control" @bind="_prefillPolicy" /></div>
                    <div class="um-field"><label>Form</label><input class="form-control" value="ACORD @_prefillForm.FormNumber — @_prefillForm.FormName" readonly /></div>
                </div>
                @if (_prefillRunning) { <div class="af-prefill-progress"><i class="bi bi-arrow-repeat af-spin" aria-hidden="true"></i><span>Extracting policy data and populating fields…</span></div> }
                @if (_prefillDone) { <div class="af-prefill-result"><i class="bi bi-check-circle-fill" aria-hidden="true"></i><span>Pre-fill complete — <strong>@_prefillFieldCount fields</strong> populated with @_prefillConfidence% confidence.</span></div> }
            </div>
            <div class="um-modal-footer"><button class="um-btn um-btn-primary" @onclick="RunPrefillAsync" disabled="@_prefillRunning">Run AI Pre-Fill</button><button class="um-btn um-btn-ghost" @onclick="() => SendForESignAsync(_prefillForm)" disabled="@(!_prefillDone)">Send for E-Sign</button><button class="um-btn um-btn-ghost" @onclick="ClosePrefill">Close</button></div>
        </div>
    </div>
}

@if (_confirmAction is not null)
{
    <div class="af-modal-backdrop" role="dialog" aria-modal="true" aria-label="Confirm action">
        <div class="af-modal af-confirm-modal">
            <div class="um-confirm-dialog"><div class="um-confirm-icon um-confirm-icon--danger"><i class="bi @_confirmAction.Icon" aria-hidden="true"></i></div><div><h3>@_confirmAction.Title</h3><p>@_confirmAction.Message</p></div></div>
            <div class="um-modal-footer"><button class="um-btn um-btn-danger" @onclick="ExecuteConfirmAsync" disabled="@_saving">@_confirmAction.ConfirmLabel</button><button class="um-btn um-btn-ghost" @onclick="() => _confirmAction = null">Cancel</button></div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="af-toast @(_toastKind == "danger" ? "af-toast-danger" : _toastKind == "warning" ? "af-toast-warning" : null)" role="status"><i class="bi @_toastIcon" aria-hidden="true"></i><span>@_toastMessage</span><button class="af-toast-close" @onclick="ClearToast"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
}

@code {
    private Guid _tenantId;
    private Guid _userId;
    private readonly List<AcordFormDto> _items = [];
    private List<AcordFormDto> _filtered = [];
    private readonly string[] _statuses = ["Blank", "In Progress", "Completed", "Pending E-Sign", "Rejected"];
    private readonly string[] _lines = ["Commercial Lines", "Personal Lines", "Specialty", "Life & Health", "Excess & Surplus"];
    private readonly Tab[] _tabs = [new("", "All", "bi-grid"), new("Blank", "Blank", "bi-file-earmark"), new("In Progress", "In Progress", "bi-hourglass-split"), new("Completed", "Completed", "bi-check-circle"), new("Pending E-Sign", "E-Sign", "bi-pen"), new("Rejected", "Rejected", "bi-exclamation-triangle")];
    private string _search = string.Empty;
    private string _lineFilter = string.Empty;
    private string _activeFilter = string.Empty;
    private bool _loading;
    private bool _saving;
    private bool _showDrawer;
    private bool _showCreate;
    private bool _showPrefill;
    private bool _prefillRunning;
    private bool _prefillDone;
    private string? _loadError;
    private string? _toastMessage;
    private string _toastKind = "success";
    private string _toastIcon = "bi-check-circle-fill";
    private AcordFormDto? _selected;
    private AcordFormDto? _contextForm;
    private AcordFormDto? _prefillForm;
    private ConfirmAction? _confirmAction;
    private FormModel _form = new();
    private string _contextLeft = "0px";
    private string _contextTop = "0px";
    private string? _prefillPolicy;
    private int _prefillFieldCount;
    private int _prefillConfidence;

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Documents", "/documents"), new("ACORD Forms", ""));
        var user = await CurrentUser.RequireAsync();
        _tenantId = user.TenantId == Guid.Empty ? Guid.Parse("00000000-0000-0000-0000-000000000001") : user.TenantId;
        _userId = user.UserId == Guid.Empty ? Guid.Parse("00000000-0000-0000-0000-000000000002") : user.UserId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;
            _loadError = null;
            _items.Clear();
            var items = await Api.GetAcordFormsAsync(_tenantId) ?? [];
            _items.AddRange(items);
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _loadError = $"Unable to load ACORD forms: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters()
    {
        _filtered = _items.Where(f =>
            (string.IsNullOrWhiteSpace(_search) || MatchesSearch(f, _search)) &&
            (string.IsNullOrWhiteSpace(_lineFilter) || f.LineOfBusiness == _lineFilter) &&
            (string.IsNullOrWhiteSpace(_activeFilter) || MatchesFilter(f, _activeFilter)))
            .OrderBy(f => StatusOrder(f.Status)).ThenBy(f => f.FormNumber).ToList();
    }

    private int CountStatus(string status) => _items.Count(f => string.Equals(f.Status, status, StringComparison.OrdinalIgnoreCase));
    private int FilterCount(string key) => string.IsNullOrWhiteSpace(key) ? _items.Count : _items.Count(f => MatchesFilter(f, key));
    private void SetFilter(string key) { _activeFilter = _activeFilter == key ? string.Empty : key; ApplyFilters(); }
    private void ResetFilters() { _search = string.Empty; _lineFilter = string.Empty; _activeFilter = string.Empty; ApplyFilters(); }
    private static bool MatchesSearch(AcordFormDto f, string term) => f.FormNumber.Contains(term, StringComparison.OrdinalIgnoreCase) || f.FormName.Contains(term, StringComparison.OrdinalIgnoreCase) || f.LineOfBusiness.Contains(term, StringComparison.OrdinalIgnoreCase) || (f.PolicyNumber?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) || (f.OwnerName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);
    private static bool MatchesFilter(AcordFormDto f, string key) => key switch { "prefilled" => f.AiPrefilled, "review" => IsReviewStatus(f.Status), _ => string.Equals(f.Status, key, StringComparison.OrdinalIgnoreCase) };
    private static bool IsReviewStatus(string status) => status is "Blank" or "Rejected";
    private static int StatusOrder(string status) => status switch { "Rejected" => 0, "Pending E-Sign" => 1, "In Progress" => 2, "Blank" => 3, "Completed" => 4, _ => 9 };
    private static string FilterLabel(string key) => key switch { "prefilled" => "AI Pre-filled", "review" => "Needs Review", "" => "All", _ => key };

    private void OpenDrawer(AcordFormDto form) { _selected = form; _showDrawer = true; _contextForm = null; }
    private void CloseDrawer() => _showDrawer = false;
    private void NavigateDocuments() => Nav.NavigateTo("/documents");
    private void OpenCreate() { _form = new(); _showCreate = true; }
    private void OpenSelectedPrefill() { if (_selected is not null) OpenPrefill(_selected); }
    private void OpenPrefill(AcordFormDto form) { _prefillForm = form; _prefillPolicy = form.PolicyNumber; _prefillDone = false; _prefillRunning = false; _showPrefill = true; _contextForm = null; }
    private void ClosePrefill() => _showPrefill = false;
    private void OpenReject(AcordFormDto form) => OpenStatusConfirm(form, "Rejected", "Reject ACORD form", $"Mark ACORD {form.FormNumber} as rejected and route it for correction?", "Reject", "bi-x-octagon");
    private void OpenStatusConfirm(AcordFormDto form, string status, string title, string message, string label, string icon) => _confirmAction = new(title, message, label, icon, () => UpdateStatusAsync(form, status));
    private void OpenContextMenu(MouseEventArgs args, AcordFormDto form) { _contextForm = form; _contextLeft = $"{Math.Max(12, args.ClientX - 220)}px"; _contextTop = $"{Math.Max(12, args.ClientY + 8)}px"; }

    private async Task CreateFormAsync()
    {
        try
        {
            _saving = true;
            await Api.CreateAcordFormAsync(new CreateAcordFormRequest(_tenantId, _form.FormNumber.Trim(), _form.FormName.Trim(), _form.LineOfBusiness, _form.Edition.Trim(), _form.Status, string.IsNullOrWhiteSpace(_form.PolicyNumber) ? null : _form.PolicyNumber.Trim(), false, null, null, string.IsNullOrWhiteSpace(_form.OwnerName) ? null : _form.OwnerName.Trim(), string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description.Trim(), _userId));
            _showCreate = false;
            ShowToast("ACORD form added.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally { _saving = false; }
    }

    private async Task RunPrefillAsync()
    {
        if (_prefillForm is null) return;
        try
        {
            _prefillRunning = true;
            _prefillDone = false;
            _prefillFieldCount = Random.Shared.Next(28, 62);
            _prefillConfidence = Random.Shared.Next(88, 99);
            await Task.Delay(900);
            await Api.PrefillAcordFormAsync(new PrefillAcordFormRequest(_prefillForm.AcordFormId, string.IsNullOrWhiteSpace(_prefillPolicy) ? _prefillForm.PolicyNumber : _prefillPolicy, _prefillFieldCount, _prefillConfidence, _userId));
            _prefillRunning = false;
            _prefillDone = true;
            ShowToast($"AI pre-fill complete — {_prefillFieldCount} fields populated.");
            await LoadAsync();
            _prefillForm = _items.FirstOrDefault(f => f.AcordFormId == _prefillForm.AcordFormId) ?? _prefillForm;
            _selected = _prefillForm;
        }
        catch (Exception ex)
        {
            _prefillRunning = false;
            ShowToast($"Pre-fill failed: {ex.Message}", "danger");
        }
    }

    private Task MarkCompletedAsync(AcordFormDto form) => UpdateStatusAsync(form, "Completed");
    private Task SendForESignAsync(AcordFormDto form) => UpdateStatusAsync(form, "Pending E-Sign", navigate: "/documents/esign");
    private Task AddToPacketAsync(AcordFormDto form) => UpdateStatusAsync(form, "In Progress", navigate: "/documents/packets");

    private async Task UpdateStatusAsync(AcordFormDto form, string status, string? navigate = null)
    {
        try
        {
            await Api.UpdateAcordFormStatusAsync(new UpdateAcordFormStatusRequest(form.AcordFormId, status, _userId));
            _contextForm = null;
            ShowToast($"ACORD {form.FormNumber} updated to {status}.");
            await LoadAsync();
            _selected = _items.FirstOrDefault(f => f.AcordFormId == form.AcordFormId) ?? _selected;
            if (!string.IsNullOrWhiteSpace(navigate)) Nav.NavigateTo(navigate);
        }
        catch (Exception ex)
        {
            ShowToast($"Update failed: {ex.Message}", "danger");
        }
    }

    private async Task ExportAsync()
    {
        await Task.Delay(150);
        ShowToast($"Export prepared for {_filtered.Count} ACORD forms.");
    }

    private async Task ExecuteConfirmAsync()
    {
        if (_confirmAction is null) return;
        try { _saving = true; await _confirmAction.Execute(); _confirmAction = null; }
        finally { _saving = false; }
    }

    private void ShowToast(string message, string kind = "success")
    {
        _toastMessage = message;
        _toastKind = kind;
        _toastIcon = kind == "danger" ? "bi-exclamation-triangle-fill" : kind == "warning" ? "bi-exclamation-circle-fill" : "bi-check-circle-fill";
    }

    private void ClearToast() => _toastMessage = null;
    private static string StatusCss(string status) => $"af-st-{status.ToLowerInvariant().Replace(" ", "-")}";
    private static string StatusBannerCss(string status) => $"af-drawer-banner--{status.ToLowerInvariant().Replace(" ", "-")}";

    private RenderFragment Kpi(string label, string value, string title, string icon, string tone, string filter) => @<button class="af-kpi-card @tone @(_activeFilter == filter ? "af-kpi-active" : null)" title="@title" @onclick="() => SetFilter(filter)"><span class="af-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></span><span><span class="af-kpi-label">@label</span><span class="af-kpi-value">@value</span></span></button>;
    private RenderFragment WorkflowCard(string title, string status, string detail, string icon, string filter) => @<button class="af-workflow-card @(_activeFilter == filter ? "af-workflow-card--active" : null)" @onclick="() => SetFilter(filter)"><i class="bi @icon" aria-hidden="true"></i><strong>@FilterCount(filter)</strong><span>@title</span><small>@detail</small></button>;
    private RenderFragment AiCell(AcordFormDto form) => @<span class="af-ai-cell @(form.AiPrefilled ? "af-ai-cell--on" : null)"><i class="bi @(form.AiPrefilled ? "bi-stars" : "bi-dash-circle")" aria-hidden="true"></i> @(form.AiPrefilled ? $"{form.PrefillConfidence}%" : "No")</span>;
    private RenderFragment Meta(string label, string value) => @<div class="af-meta-row"><span class="af-meta-lbl">@label</span><span class="af-meta-val">@value</span></div>;

    private sealed record Tab(string Key, string Label, string Icon);
    private sealed record ConfirmAction(string Title, string Message, string ConfirmLabel, string Icon, Func<Task> Execute);

    private sealed class FormModel
    {
        [Required, StringLength(30)] public string FormNumber { get; set; } = string.Empty;
        [Required, StringLength(200)] public string FormName { get; set; } = string.Empty;
        [Required, StringLength(100)] public string LineOfBusiness { get; set; } = string.Empty;
        [Required, StringLength(50)] public string Edition { get; set; } = string.Empty;
        [Required, StringLength(50)] public string Status { get; set; } = "Blank";
        [StringLength(100)] public string? PolicyNumber { get; set; }
        [StringLength(160)] public string? OwnerName { get; set; }
        [StringLength(1000)] public string? Description { get; set; }
    }
}
