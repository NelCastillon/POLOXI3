@page "/tenant/integrations/carriers2"
@page "/tenant/integrations/rater2"
@page "/tenant/integrations/email2"
@page "/tenant/integrations/sms2"
@page "/tenant/integrations/esign2"
@page "/tenant/integrations/payments2"
@page "/tenant/integrations/accounting2"
@page "/tenant/integrations/webhooks2"
@page "/tenant/integrations/api2"
@page "/tenant/integrations/health2"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Tenant Integrations - AMS</PageTitle>

<AppPageHeader Title="Tenant Integrations"
               Subtitle="Tenant admin control center for carrier, rating, messaging, signing, payment, accounting, API, webhook, and integration health operations"
               Icon="bi-plug">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/tenant/integrations/health")'>
            <i class="bi bi-heart-pulse" aria-hidden="true"></i> Integration Health
        </button>
    </Actions>
</AppPageHeader>

<section class="intg-hero" aria-label="Tenant integrations overview">
    <div>
        <span class="intg-eyebrow">Tenant administration</span>
        <h2>Tenant Integrations Workflow</h2>
        <p>Govern carrier and rating connections, messaging providers, e-signature, payments, accounting sync, API keys, webhooks, automation access, and tenant integration reliability.</p>
    </div>
    <div class="intg-hero-grid">
        @foreach (var action in _quickActions)
        {
            <button class="intg-quick-action" @onclick="() => Nav.NavigateTo(action.Url)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
</section>

<section class="intg-kpi-grid" aria-label="Integration metrics">
    @Kpi("Connected", "18", "Active tenant integrations", "bi-plug", "intg-tone-blue")
    @Kpi("Uptime", "99.3%", "30-day average", "bi-heart-pulse", "intg-tone-green")
    @Kpi("Exceptions", "7", "Need admin review", "bi-exclamation-triangle", "intg-tone-red")
    @Kpi("Webhook Events", "42K", "Last 30 days", "bi-link-45deg", "intg-tone-violet")
</section>

<section class="intg-command-bar" aria-label="Tenant integrations filters">
    <div class="intg-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search"
               placeholder="Search integrations, provider, owner, control, module..."
               @bind="_search"
               @bind:event="oninput" />
    </div>
    <div class="intg-pill-group" role="group" aria-label="Integration workflow filter">
        @foreach (var filter in _filters)
        {
            <button class="intg-pill @(_filter == filter.Key ? "intg-pill--active" : "")"
                    @onclick="() => _filter = filter.Key">
                @filter.Label
                <span>@FilterCount(filter.Key)</span>
            </button>
        }
    </div>
</section>

<section class="intg-layout">
    <div class="intg-flow" aria-label="Tenant integration workflow lanes">
        @foreach (var lane in _lanes)
        {
            var laneItems = FilteredWorkflow.Where(x => x.Stage == lane.Key).ToList();
            <article class="intg-lane">
                <header class="intg-lane-header">
                    <div>
                        <span class="intg-lane-title">@lane.Label</span>
                        <span class="intg-lane-subtitle">@lane.Description</span>
                    </div>
                    <span class="intg-lane-count">@laneItems.Count</span>
                </header>

                <div class="intg-lane-list">
                    @if (laneItems.Count == 0)
                    {
                        <div class="intg-empty-mini">No visible workflow items.</div>
                    }
                    else
                    {
                        @foreach (var item in laneItems)
                        {
                            <button class="intg-work-card @(item.Risk == "High" ? "intg-work-card--risk" : "")"
                                    @onclick="() => _selected = item">
                                <div class="intg-work-topline">
                                    <span class="intg-chip @ToneCss(item.Domain)">@item.Domain</span>
                                    <span class="intg-status @RiskCss(item.Risk)">@item.Risk</span>
                                </div>
                                <strong>@item.Title</strong>
                                <p>@item.Summary</p>
                                <div class="intg-work-meta">
                                    <span><i class="bi bi-person" aria-hidden="true"></i> @item.Owner</span>
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> @item.Sla</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            </article>
        }
    </div>

    <aside class="intg-admin-panel" aria-label="Tenant integration administration controls">
        @if (_selected is null)
        {
            <div class="intg-side-empty">
                <i class="bi bi-plug" aria-hidden="true"></i>
                <h3>Integration governance</h3>
                <p>Select a workflow item to inspect ownership, risk, SLA, credential policy, provider control, and module action.</p>
            </div>
        }
        else
        {
            <div class="intg-detail-header">
                <span class="intg-chip @ToneCss(_selected.Domain)">@_selected.Domain</span>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close details">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h3>@_selected.Title</h3>
            <p>@_selected.Summary</p>

            <dl class="intg-detail-list">
                <div><dt>Owner</dt><dd>@_selected.Owner</dd></div>
                <div><dt>Stage</dt><dd>@_selected.Stage</dd></div>
                <div><dt>Risk</dt><dd><span class="intg-status @RiskCss(_selected.Risk)">@_selected.Risk</span></dd></div>
                <div><dt>SLA</dt><dd>@_selected.Sla</dd></div>
                <div><dt>Control</dt><dd>@_selected.Control</dd></div>
            </dl>

            <div class="intg-policy-card">
                <strong>Tenant integration controls</strong>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Credentials, API keys, and webhook secrets governed</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Carrier, payment, accounting, and messaging uptime monitored</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Data exchange, retries, exceptions, and audit evidence retained</span>
            </div>

            <div class="intg-detail-actions">
                <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selected.Url)">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Module
                </button>
                <button class="um-btn um-btn-ghost" @onclick="() => Advance(_selected)">
                    <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Advance
                </button>
            </div>
        }
    </aside>
</section>

<section class="intg-module-grid" aria-label="Tenant integration modules">
    @foreach (var module in _modules)
    {
        <button class="intg-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
            <span class="intg-module-icon @ToneCss(module.Domain)"><i class="bi @module.Icon" aria-hidden="true"></i></span>
            <span class="intg-module-content">
                <strong>@module.Title</strong>
                <small>@module.Description</small>
            </span>
            <i class="bi bi-chevron-right intg-module-arrow" aria-hidden="true"></i>
        </button>
    }
</section>

@code {
    private string _search = string.Empty;
    private string _filter = string.Empty;
    private IntegrationWorkflowItem? _selected;
    private readonly List<IntegrationWorkflowItem> _workflow = [];

    private readonly Lane[] _lanes =
    [
        new("Connect", "Connect", "Provider setup and credentials"),
        new("Validate", "Validate", "Testing and certification"),
        new("Operate", "Operate", "Sync, events, and transactions"),
        new("Monitor", "Monitor", "Health, retries, exceptions"),
        new("Secure", "Secure", "API, secrets, audit")
    ];

    private readonly Filter[] _filters =
    [
        new("", "All"),
        new("risk", "High Risk"),
        new("carrier", "Carrier"),
        new("messaging", "Messaging"),
        new("api", "API")
    ];

    private readonly IntegrationModule[] _modules =
    [
        new("Carrier Integrations", "Manage carrier download, policy sync, claims, billing, and appointment connections.", "/tenant/integrations/carriers", "bi-broadcast", "Carrier"),
        new("Comparative Rater", "Configure rating credentials, market access, quote bridging, and appetite checks.", "/tenant/integrations/rater", "bi-calculator", "Carrier"),
        new("Email Provider", "Control SMTP/API provider, sender domains, bounce handling, and delivery health.", "/tenant/integrations/email", "bi-envelope-gear", "Messaging"),
        new("SMS Provider", "Manage SMS provider credentials, consent enforcement, throughput, and opt-out callbacks.", "/tenant/integrations/sms", "bi-phone-vibrate", "Messaging"),
        new("E-Sign Provider", "Configure document signing provider, templates, callbacks, and signer audit events.", "/tenant/integrations/esign", "bi-pen", "Signing"),
        new("Payment Gateway", "Manage payment processor, webhooks, settlement, refunds, and failure handling.", "/tenant/integrations/payments", "bi-credit-card", "Financial"),
        new("Accounting Integration", "Configure GL/AP/AR export, chart mapping, sync schedules, and exception queues.", "/tenant/integrations/accounting", "bi-journal-text", "Financial"),
        new("Webhooks", "Create webhook endpoints, event subscriptions, retry policy, and delivery logs.", "/tenant/integrations/webhooks", "bi-link-45deg", "API"),
        new("API Keys", "Issue, rotate, revoke, and audit tenant API credentials and scopes.", "/tenant/integrations/api", "bi-key", "API"),
        new("Integration Health", "Monitor uptime, latency, success rate, errors, and incident status.", "/tenant/integrations/health", "bi-heart-pulse", "Health")
    ];

    private readonly IntegrationModule[] _quickActions =
    [
        new("Carriers", "", "/tenant/integrations/carriers", "bi-broadcast", "Carrier"),
        new("Payments", "", "/tenant/integrations/payments", "bi-credit-card", "Financial"),
        new("API Keys", "", "/tenant/integrations/api", "bi-key", "API"),
        new("Health", "", "/tenant/integrations/health", "bi-heart-pulse", "Health")
    ];

    private IEnumerable<IntegrationWorkflowItem> FilteredWorkflow => _workflow.Where(item =>
        (string.IsNullOrWhiteSpace(_filter) || _filter switch
        {
            "risk" => item.Risk == "High",
            "carrier" => item.Domain == "Carrier",
            "messaging" => item.Domain is "Messaging" or "Signing",
            "api" => item.Domain == "API",
            _ => true
        }) &&
        (string.IsNullOrWhiteSpace(_search) ||
         item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Domain.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Control.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(x => x.Risk == "High")
        .ThenBy(x => x.Stage)
        .ThenBy(x => x.Title);

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tenant Integrations", "/tenant/integrations/health"));
        BuildWorkflow();
        _selected = _workflow.FirstOrDefault(x => x.Risk == "High") ?? _workflow.FirstOrDefault();
    }

    private void BuildWorkflow()
    {
        _workflow.Clear();
        _workflow.AddRange(
        [
            new("Carrier download credential rotation", "Several carrier download credentials expire within 14 days and require rotation.", "Carrier", "High", "Connect", "Diana Perez", "7 days", "Credential rotation", "/tenant/integrations/carriers"),
            new("Comparative rater market test", "New commercial rater market needs quote validation and appetite mapping before rollout.", "Carrier", "Medium", "Validate", "James Park", "This week", "Rater certification", "/tenant/integrations/rater"),
            new("Email domain authentication", "DKIM and SPF status requires verification after sender domain change.", "Messaging", "High", "Validate", "Sarah Kim", "Today", "Domain authentication", "/tenant/integrations/email"),
            new("SMS opt-out callback review", "SMS provider callback delivery failed for opt-out events and requires retry configuration.", "Messaging", "High", "Monitor", "Kevin Obi", "Same day", "Consent callback control", "/tenant/integrations/sms"),
            new("E-sign webhook certification", "Signing completion webhook needs payload validation before production use.", "Signing", "Medium", "Validate", "Lisa Chen", "48h", "Signer audit callback", "/tenant/integrations/esign"),
            new("Payment settlement exception", "Payment gateway settlement webhook has unmatched deposit references.", "Financial", "High", "Operate", "Maria Santos", "Today", "Settlement reconciliation", "/tenant/integrations/payments"),
            new("Accounting sync mapping", "GL account mapping changes require validation before nightly sync.", "Financial", "Medium", "Operate", "Robert Yamamoto", "2 days", "Chart mapping approval", "/tenant/integrations/accounting"),
            new("Webhook retry backlog", "Third-party webhook endpoint has accumulated failed deliveries and needs tenant admin review.", "API", "High", "Monitor", "Diana Perez", "24h", "Webhook retry policy", "/tenant/integrations/webhooks"),
            new("API key scope review", "Legacy API key has broad scopes and must be rotated with least-privilege permissions.", "API", "High", "Secure", "Robert Yamamoto", "This week", "API key governance", "/tenant/integrations/api"),
            new("Integration health audit", "Monthly integration health evidence package needs uptime, latency, and exception summary.", "Health", "Low", "Secure", "Sarah Kim", "Monthly", "Health audit evidence", "/tenant/integrations/health")
        ]);
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _filter = string.Empty;
    }

    private void Advance(IntegrationWorkflowItem item)
    {
        item.Stage = item.Stage switch
        {
            "Connect" => "Validate",
            "Validate" => "Operate",
            "Operate" => "Monitor",
            "Monitor" => "Secure",
            _ => "Secure"
        };
    }

    private int FilterCount(string key) => key switch
    {
        "risk" => _workflow.Count(x => x.Risk == "High"),
        "carrier" => _workflow.Count(x => x.Domain == "Carrier"),
        "messaging" => _workflow.Count(x => x.Domain is "Messaging" or "Signing"),
        "api" => _workflow.Count(x => x.Domain == "API"),
        _ => _workflow.Count
    };

    private static string ToneCss(string domain) => domain switch
    {
        "Carrier" => "intg-tone-blue",
        "Messaging" => "intg-tone-cyan",
        "Signing" => "intg-tone-violet",
        "Financial" => "intg-tone-green",
        "API" => "intg-tone-amber",
        "Health" => "intg-tone-red",
        _ => "intg-tone-neutral"
    };

    private static string RiskCss(string risk) => risk switch
    {
        "High" => "intg-status-high",
        "Medium" => "intg-status-medium",
        _ => "intg-status-low"
    };

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="intg-kpi-card">
        <span class="intg-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span>
        <div>
            <strong>@value</strong>
            <span>@label</span>
            <small>@meta</small>
        </div>
    </article>;

    private sealed record Lane(string Key, string Label, string Description);
    private sealed record Filter(string Key, string Label);
    private sealed record IntegrationModule(string Title, string Description, string Url, string Icon, string Domain)
    {
        public string Label => Title;
    }

    private sealed class IntegrationWorkflowItem(string title, string summary, string domain, string risk, string stage, string owner, string sla, string control, string url)
    {
        public string Title { get; set; } = title;
        public string Summary { get; set; } = summary;
        public string Domain { get; set; } = domain;
        public string Risk { get; set; } = risk;
        public string Stage { get; set; } = stage;
        public string Owner { get; set; } = owner;
        public string Sla { get; set; } = sla;
        public string Control { get; set; } = control;
        public string Url { get; set; } = url;
    }
}
