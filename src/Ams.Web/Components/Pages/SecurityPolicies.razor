@page "/iam/security-policies"
@inject ApiClient Api

<PageTitle>Security Policies</PageTitle>
<h1>Security Policies</h1>

<h4 class="mt-3">Field-Level Security</h4>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search field policies..." @bind-Value="_fieldSearchTerm" Width="280px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_fieldItems is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_fieldItems" AllowPaging="true" AllowSorting="true" Height="260px">
    <GridPageSettings PageSize="5"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(FieldSecurityPolicyDto.RoleName)"    HeaderText="Role"       Width="150"></GridColumn>
        <GridColumn Field="@nameof(FieldSecurityPolicyDto.EntityName)"  HeaderText="Entity"     Width="160"></GridColumn>
        <GridColumn Field="@nameof(FieldSecurityPolicyDto.FieldName)"   HeaderText="Field"      Width="160"></GridColumn>
        <GridColumn Field="@nameof(FieldSecurityPolicyDto.CanRead)"     HeaderText="Read"       Width="80" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(FieldSecurityPolicyDto.CanWrite)"    HeaderText="Write"      Width="80" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(FieldSecurityPolicyDto.IsHidden)"    HeaderText="Hidden"     Width="80" DisplayAsCheckBox="true"></GridColumn>
    </GridColumns>
</SfGrid>
}

<h4 class="mt-4">Record-Level Security</h4>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search record policies..." @bind-Value="_recordSearchTerm" Width="280px"></SfTextBox>
</div>
@if (_recordItems is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_recordItems" AllowPaging="true" AllowSorting="true" Height="260px">
    <GridPageSettings PageSize="5"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(RecordSecurityPolicyDto.RoleName)"         HeaderText="Role"       Width="150"></GridColumn>
        <GridColumn Field="@nameof(RecordSecurityPolicyDto.EntityName)"       HeaderText="Entity"     Width="160"></GridColumn>
        <GridColumn Field="@nameof(RecordSecurityPolicyDto.PolicyTypeCode)"   HeaderText="Policy Type" Width="130"></GridColumn>
        <GridColumn Field="@nameof(RecordSecurityPolicyDto.FilterExpression)" HeaderText="Filter"     Width="260"></GridColumn>
        <GridColumn Field="@nameof(RecordSecurityPolicyDto.IsActive)"         HeaderText="Active"     Width="80" DisplayAsCheckBox="true"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private static readonly Guid DefaultTenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _fieldSearchTerm;
    private string? _recordSearchTerm;
    private List<FieldSecurityPolicyDto>? _fieldItems;
    private List<RecordSecurityPolicyDto>? _recordItems;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var fieldResult = await Api.SearchFieldSecurityPoliciesAsync(DefaultTenantId, _fieldSearchTerm);
        _fieldItems = fieldResult?.Items.ToList() ?? [];
        var recordResult = await Api.SearchRecordSecurityPoliciesAsync(DefaultTenantId, _recordSearchTerm);
        _recordItems = recordResult?.Items.ToList() ?? [];
    }
}
