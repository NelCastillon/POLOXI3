@page "/crm/quotes"
@inject ApiClient Api

<PageTitle>Quotes</PageTitle>

<AppPageHeader Title="Quotes" Icon="bi-grid" />

<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>

@if (_items is null)
{
    <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(QuoteDto.QuoteNumber)" HeaderText="Quote #" Width="140"></GridColumn>
            <GridColumn Field="@nameof(QuoteDto.AccountName)" HeaderText="Account" Width="200"></GridColumn>
            <GridColumn Field="@nameof(QuoteDto.OpportunityName)" HeaderText="Opportunity" Width="200"></GridColumn>
            <GridColumn Field="@nameof(QuoteDto.TotalAmount)" HeaderText="Total Amount" Format="C2" Width="140"></GridColumn>
            <GridColumn Field="@nameof(QuoteDto.ValidUntilDate)" HeaderText="Valid Until" Type="ColumnType.DateTime" Format="d" Width="140"></GridColumn>
            <GridColumn Field="@nameof(QuoteDto.StatusCode)" HeaderText="Status" Width="120"></GridColumn>
            <GridColumn Field="@nameof(QuoteDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="g" Width="160"></GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<QuoteDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchQuotesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<QuoteDto>();
    }
}
