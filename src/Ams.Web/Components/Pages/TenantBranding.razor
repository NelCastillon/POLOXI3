@page "/platform/branding"
@inject ApiClient Api

<PageTitle>Tenant Branding</PageTitle>
<h1>White-Label Branding</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(TenantBrandingDto.WhiteLabelName)"  HeaderText="Brand Name"     Width="200"></GridColumn>
        <GridColumn Field="@nameof(TenantBrandingDto.CustomDomain)"    HeaderText="Custom Domain"  Width="200"></GridColumn>
        <GridColumn Field="@nameof(TenantBrandingDto.PrimaryColor)"    HeaderText="Primary"        Width="100"></GridColumn>
        <GridColumn Field="@nameof(TenantBrandingDto.SecondaryColor)"  HeaderText="Secondary"      Width="100"></GridColumn>
        <GridColumn Field="@nameof(TenantBrandingDto.AccentColor)"     HeaderText="Accent"         Width="100"></GridColumn>
        <GridColumn Field="@nameof(TenantBrandingDto.SupportEmail)"    HeaderText="Support Email"  Width="200"></GridColumn>
        <GridColumn Field="@nameof(TenantBrandingDto.IsActive)"        HeaderText="Active"         Width="80"  DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(TenantBrandingDto.CreatedDateUtc)"  HeaderText="Created"        Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private string? _searchTerm;
    private List<TenantBrandingDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchTenantBrandingAsync(_searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
