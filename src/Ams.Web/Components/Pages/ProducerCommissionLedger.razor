@page "/commissions/producer-ledger"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Commissions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject IJSRuntime Js

<PageTitle>Producer Commission Ledger - AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="pl-toast pl-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="pl-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showEntryForm)
{
    <div class="pl-modal-backdrop" role="presentation" @onclick="CloseEntryForm">
        <div class="pl-modal pl-action-modal" role="dialog" aria-modal="true" aria-labelledby="pl-entry-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-journal-plus" aria-hidden="true"></i>
                <span id="pl-entry-title">Add Ledger Entry</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseEntryForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_entryForm" OnValidSubmit="SaveEntryAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="pl-modal-intro">
                        <span><i class="bi bi-shield-check" aria-hidden="true"></i> Commission workflow</span>
                        <p>Create credit, bonus, override, adjustment, or clawback entries against the selected producer using synchronized commission data.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Producer <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_entryForm.PayeeId">
                                <option value="@Guid.Empty">Select producer...</option>
                                @foreach (var producer in _producers)
                                {
                                    <option value="@producer.PayeeId">@producer.Name - @producer.Plan</option>
                                }
                            </InputSelect>
                            @if (_entryForm.PayeeId == Guid.Empty && _saveAttempted)
                            {
                                <div class="text-danger">Producer is required.</div>
                            }
                        </div>
                        <div class="um-field">
                            <label>Entry Type <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_entryForm.EntryType">
                                @foreach (var type in _entryTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Entry Date <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="_entryForm.EntryDate" />
                        </div>
                        <div class="um-field">
                            <label>Reference <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_entryForm.Reference" />
                        </div>
                        <div class="um-field">
                            <label>Gross Amount <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_entryForm.GrossAmount" />
                        </div>
                        <div class="um-field">
                            <label>Commission Rate % <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_entryForm.Rate" />
                        </div>
                        <div class="um-field">
                            <label>Commission Amount <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_entryForm.Amount" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Description <span class="text-danger">*</span></label>
                            <InputTextArea class="form-control" @bind-Value="_entryForm.Description" rows="3" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseEntryForm" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        Save Entry
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showExport)
{
    <div class="pl-modal-backdrop" role="presentation" @onclick="CloseExport">
        <div class="pl-modal pl-export-modal" role="dialog" aria-modal="true" aria-labelledby="pl-export-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-download" aria-hidden="true"></i>
                <span id="pl-export-title">Export Producer Ledger</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseExport" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_exportForm" OnValidSubmit="ExportLedgerAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="um-form-grid">
                        <div class="um-field">
                            <label>Format <span class="text-danger">*</span></label>
                            <InputSelect @bind-Value="_exportForm.Format" class="form-select"><option value="CSV">CSV</option><option value="Excel">Excel-compatible CSV</option></InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Start Date <span class="text-danger">*</span></label>
                            <InputDate @bind-Value="_exportForm.StartDate" class="form-control" />
                        </div>
                        <div class="um-field">
                            <label>End Date <span class="text-danger">*</span></label>
                            <InputDate @bind-Value="_exportForm.EndDate" class="form-control" />
                        </div>
                        <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_exportForm.IncludeSplits" /> Include split allocation detail</label></div>
                        @if (!string.IsNullOrWhiteSpace(_exportFormError))
                        {
                            <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_exportFormError</div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseExport" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="pl-enterprise-page">
    <section class="pl-header">
        <div class="pl-header-left">
            <div class="pl-lob-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></div>
            <div class="pl-header-info">
                <div class="pl-title-row">
                    <h1 class="pl-page-title">Producer Commission Ledger</h1>
                    <span class="pl-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live commission data</span>
                    <span class="pl-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span>
                </div>
                <div class="pl-sub-row">
                    <span>Track producer credits, debits, clawbacks, bonuses, overrides, and running balances.</span>
                    <span class="pl-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Seed sync enabled</span>
                    <span class="pl-sub-chip"><i class="bi bi-check2-circle" aria-hidden="true"></i> @_filteredRows.Count active matches</span>
                </div>
            </div>
        </div>
        <div class="pl-header-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi @(_loading ? "bi-arrow-repeat pl-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="OpenExport" disabled="@(!_filteredRows.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="() => OpenEntryForm()"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Entry</button>
        </div>
    </section>

    <section class="pl-kpi-strip" aria-label="Producer ledger metrics">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="pl-kpi-card @kpi.Tone @(_kpiFilter == kpi.Filter ? "pl-kpi-active" : null)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)">
                <span class="pl-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="pl-kpi-copy"><span class="pl-kpi-label">@kpi.Label</span><span class="pl-kpi-value">@kpi.Value</span><span class="pl-kpi-caption">@kpi.Caption</span></span>
            </button>
        }
    </section>

    <section class="pl-workflow-strip" aria-label="Commission workflow shortcuts">
        <button type="button" class="pl-workflow-card pl-wf-ledger" @onclick='() => Nav.NavigateTo("/commissions/producer-ledger")'><span class="pl-workflow-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span><span class="pl-workflow-content"><strong>1</strong><span>Ledger</span><small>Review producer balances.</small></span></button>
        <button type="button" class="pl-workflow-card pl-wf-statement" @onclick='() => Nav.NavigateTo("/commissions/statements")'><span class="pl-workflow-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span><span class="pl-workflow-content"><strong>2</strong><span>Statements</span><small>Issue payout summaries.</small></span></button>
        <button type="button" class="pl-workflow-card pl-wf-split" @onclick='() => Nav.NavigateTo("/commissions/splits")'><span class="pl-workflow-icon"><i class="bi bi-scissors" aria-hidden="true"></i></span><span class="pl-workflow-content"><strong>3</strong><span>Splits</span><small>Maintain allocation rules.</small></span></button>
        <button type="button" class="pl-workflow-card pl-wf-plan" @onclick='() => Nav.NavigateTo("/commissions/plans")'><span class="pl-workflow-icon"><i class="bi bi-clipboard-check" aria-hidden="true"></i></span><span class="pl-workflow-content"><strong>4</strong><span>Plans</span><small>Manage rate schedules.</small></span></button>
        <button type="button" class="pl-workflow-card pl-wf-forecast" @onclick='() => Nav.NavigateTo("/commissions/forecast")'><span class="pl-workflow-icon"><i class="bi bi-graph-up" aria-hidden="true"></i></span><span class="pl-workflow-content"><strong>5</strong><span>Forecast</span><small>Project producer earnings.</small></span></button>
    </section>

    <section class="pl-enterprise-search" aria-label="Producer ledger filters">
        <div class="pl-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
        <div class="pl-search-body">
            <label for="pl-search">Search producer ledger</label>
            <input id="pl-search" class="pl-search-input" type="search" placeholder="Search producer, plan, reference, description, status..." @bind="SearchFilter" @bind:event="oninput" />
            <span class="pl-search-hint">Filters apply instantly across synchronized commission credits, debits, and clawbacks.</span>
        </div>
        <select class="pl-filter-select" @bind="ProducerFilter" aria-label="Producer filter"><option value="">All producers</option>@foreach (var producer in _producers) { <option value="@producer.PayeeId.ToString()">@producer.Name</option> }</select>
        <select class="pl-filter-select" @bind="TypeFilter" aria-label="Entry type filter"><option value="">All entry types</option>@foreach (var type in _entryTypes) { <option value="@type">@type</option> }</select>
        <select class="pl-filter-select" @bind="PeriodFilter" aria-label="Period filter"><option value="">All periods</option><option value="current-month">Current month</option><option value="prior-month">Prior month</option><option value="ytd">Year to date</option></select>
        <div class="pl-search-result"><strong>@_filteredRows.Count</strong><span>matches</span></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger pl-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_loadError</div>
    }

    <section class="pl-content-layout">
        <div class="pl-grid-wrap">
            <div class="pl-grid-toolbar">
                <div><strong>Producer ledger register</strong><span>@ActiveFilterText</span></div>
                <div class="pl-toolbar-actions">
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-eraser" aria-hidden="true"></i> Reset</button>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/commissions/statements")'><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Statements</button>
                    <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenEntryForm()"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add</button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="pl-loading"><i class="bi bi-arrow-repeat pl-spin" aria-hidden="true"></i><strong>Loading producer ledger...</strong><span>Syncing schema, seed data, commission transactions, and clawbacks.</span></div>
            }
            else if (!_filteredRows.Any())
            {
                <div class="pl-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No ledger entries found</strong><span>Adjust filters or add a commission entry for a producer.</span><button type="button" class="um-btn um-btn-primary" @onclick="() => OpenEntryForm()">New Entry</button></div>
            }
            else
            {
                <div class="pl-table-scroll">
                    <table class="pl-table">
                        <thead><tr><th>Producer</th><th>Date</th><th>Type</th><th>Reference</th><th>Status</th><th class="pl-number">Debit</th><th class="pl-number">Credit</th><th class="pl-number">Balance</th><th class="pl-actions-col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var row in _pagedRows)
                            {
                                <tr class="pl-table-row @(IsSelected(row) ? "pl-table-row--selected" : null)" @onclick="() => SelectRow(row)">
                                    <td><div class="pl-producer-cell"><span class="pl-producer-icon @TypeIconClass(row.Type)"><i class="bi bi-person-badge" aria-hidden="true"></i></span><div><strong>@row.ProducerName</strong><span>@row.Plan - @row.SplitPercentage.ToString("N0")% split</span></div></div></td>
                                    <td>@row.Date.ToString("MMM d, yyyy")</td>
                                    <td><span class="pl-entry-chip @TypeCss(row.Type)">@row.Type</span></td>
                                    <td><strong>@row.Reference</strong><span class="pl-row-description">@row.Description</span></td>
                                    <td><span class="pl-status-chip @StatusCss(row.Status)">@row.Status</span></td>
                                    <td class="pl-number"><span class="@(row.Debit > 0 ? "pl-debit" : null)">@row.Debit.ToString("C2")</span></td>
                                    <td class="pl-number"><span class="@(row.Credit > 0 ? "pl-credit" : null)">@row.Credit.ToString("C2")</span></td>
                                    <td class="pl-number">@row.Balance.ToString("C2")</td>
                                    <td><div class="pl-row-acts"><button type="button" class="um-btn um-btn-primary um-btn-xs" @onclick="() => SelectRow(row)" @onclick:stopPropagation="true" title="Inspect entry"><i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick="() => OpenEntryForm(row.PayeeId)" @onclick:stopPropagation="true" title="Add related entry"><i class="bi bi-plus-circle" aria-hidden="true"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="pl-pager"><span>Page @_page of @TotalPages - @_filteredRows.Count records</span><div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button></div></div>
            }
        </div>

        <aside class="pl-detail-panel">
            @if (_selected is null)
            {
                <div class="pl-detail-empty"><i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i><strong>Select a ledger entry</strong><span>Click any row to inspect producer plan, split, transaction source, and running balance.</span></div>
            }
            else
            {
                <div class="pl-detail-head"><div><span class="pl-detail-eyebrow"><i class="bi bi-journal-check" aria-hidden="true"></i> Ledger detail</span><h2>@_selected.ProducerName</h2><div class="pl-detail-meta"><span>@_selected.Reference</span><span>@_selected.Type</span><span>@_selected.Status</span></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearSelection"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
                <div class="pl-detail-body">
                    <div class="pl-detail-summary">
                        <div class="pl-meta-row"><span class="pl-meta-lbl">Debit</span><span class="pl-meta-val">@_selected.Debit.ToString("C2")</span></div>
                        <div class="pl-meta-row"><span class="pl-meta-lbl">Credit</span><span class="pl-meta-val">@_selected.Credit.ToString("C2")</span></div>
                        <div class="pl-meta-row"><span class="pl-meta-lbl">Running balance</span><span class="pl-meta-val">@_selected.Balance.ToString("C2")</span></div>
                        <div class="pl-meta-row"><span class="pl-meta-lbl">Gross amount</span><span class="pl-meta-val">@_selected.GrossAmount.ToString("C2")</span></div>
                        <div class="pl-meta-row"><span class="pl-meta-lbl">Rate</span><span class="pl-meta-val">@_selected.Rate.ToString("N2")%</span></div>
                        <div class="pl-meta-row"><span class="pl-meta-lbl">Entry date</span><span class="pl-meta-val">@_selected.Date.ToString("MMM d, yyyy")</span></div>
                    </div>
                    <div class="pl-contact-card"><strong>Workflow context</strong><span><i class="bi bi-clipboard-check" aria-hidden="true"></i> @_selected.Plan</span><span><i class="bi bi-scissors" aria-hidden="true"></i> @_selected.SplitPercentage.ToString("N0")% split allocation</span><span><i class="bi bi-card-text" aria-hidden="true"></i> @_selected.Description</span></div>
                    <div class="pl-detail-actions"><button type="button" class="um-btn um-btn-primary" @onclick="() => OpenEntryForm(_selected.PayeeId)"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add Related</button><button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/statements")'><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Statements</button><button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/splits")'><i class="bi bi-scissors" aria-hidden="true"></i> Splits</button><button type="button" class="um-btn um-btn-ghost" @onclick="OpenExport"><i class="bi bi-download" aria-hidden="true"></i> Export</button></div>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string _search = string.Empty;
    private string _filterProducer = string.Empty;
    private string _filterType = string.Empty;
    private string _filterPeriod = string.Empty;
    private string _kpiFilter = "all";
    private string? _loadError;
    private string? _toastMessage;
    private string _toastKind = "success";
    private bool _toastVisible;
    private bool _loading;
    private bool _busy;
    private bool _showExport;
    private bool _showEntryForm;
    private bool _saveAttempted;
    private int _page = 1;
    private const int PageSize = 12;

    private readonly List<string> _entryTypes = ["Credit", "Clawback", "Adjustment", "Override", "Bonus"];
    private List<ProducerSummary> _producers = [];
    private List<CommissionPlanDto> _plans = [];
    private List<LedgerRow> _rows = [];
    private List<LedgerRow> _filteredRows = [];
    private List<LedgerRow> _pagedRows = [];
    private LedgerRow? _selected;
    private EntryForm _entryForm = new();
    private ExportLedgerForm _exportForm = new();
    private string? _exportFormError;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filteredRows.Count / (double)PageSize));
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", "info" => "bi-info-circle-fill", _ => "bi-check-circle-fill" };
    private string ActiveFilterText => _kpiFilter == "all" ? "All producer ledger entries" : $"Filtered by {_kpiFilter}";
    private decimal TotalCredits => _rows.Sum(r => r.Credit);
    private decimal TotalDebits => _rows.Sum(r => r.Debit);
    private IReadOnlyList<KpiModel> Kpis =>
    [
        new("all", "Entries", _rows.Count.ToString("N0"), "All ledger rows", "bi-journal-text", "pl-ki-blue"),
        new("producers", "Producers", _producers.Count.ToString("N0"), "Active payees", "bi-people", "pl-ki-purple"),
        new("credits", "YTD Credits", Fmt(TotalCredits), "Earned and bonus", "bi-currency-dollar", "pl-ki-green"),
        new("clawbacks", "YTD Clawbacks", Fmt(TotalDebits), "Debit recovery", "bi-arrow-down-circle", "pl-ki-red"),
        new("net", "YTD Net", Fmt(TotalCredits - TotalDebits), "Running ledger", "bi-graph-up", "pl-ki-green"),
        new("splits", "Split Earners", _producers.Count(p => p.HasSplit).ToString("N0"), "Shared allocations", "bi-scissors", "pl-ki-cyan"),
        new("pending", "Pending", _rows.Count(r => r.Status.Contains("Pending", StringComparison.OrdinalIgnoreCase)).ToString("N0"), "Needs review", "bi-hourglass-split", "pl-ki-amber"),
        new("top", "Top Producer", _producers.OrderByDescending(p => p.YtdNet).FirstOrDefault()?.Name ?? "-", "Highest net", "bi-trophy", "pl-ki-blue")
    ];

    private string SearchFilter { get => _search; set { _search = value; ApplyFilters(resetPage: true); } }
    private string ProducerFilter { get => _filterProducer; set { _filterProducer = value; ApplyFilters(resetPage: true); } }
    private string TypeFilter { get => _filterType; set { _filterType = value; ApplyFilters(resetPage: true); } }
    private string PeriodFilter { get => _filterPeriod; set { _filterPeriod = value; ApplyFilters(resetPage: true); } }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Commissions", "/commissions"), new("Producer Ledger", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await Api.EnsureCommissionSeedAsync(_tenantId, _tenantAdminUserId);
            var payees = (await Api.SearchCommissionPayeesAsync(_tenantId, null))?.Items.ToList() ?? [];
            _plans = (await Api.SearchCommissionPlansAsync(_tenantId, null))?.Items.ToList() ?? [];
            var transactions = (await Api.SearchCommissionTransactionsAsync(_tenantId, null))?.Items.ToList() ?? [];
            var clawbacks = (await Api.SearchCommissionClawbacksAsync(_tenantId, null))?.Items.ToList() ?? [];

            _producers = payees.Select((payee, index) => BuildProducer(payee, index, transactions, clawbacks)).OrderBy(p => p.Name).ToList();
            _rows = BuildRows(payees, transactions, clawbacks);
            ApplyFilters(resetPage: true);
            EnsureSelectedStillVisible();
        }
        catch (Exception ex)
        {
            _loadError = $"Producer ledger failed to load: {ex.Message}";
            _producers = [];
            _rows = [];
            ApplyFilters(resetPage: true);
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally { _loading = false; }
    }

    private ProducerSummary BuildProducer(CommissionPayeeDto payee, int index, List<CommissionTransactionDto> transactions, List<CommissionClawbackDto> clawbacks)
    {
        var gross = transactions.Where(t => t.PayeeId == payee.PayeeId).Sum(t => t.CommissionAmount);
        var debits = clawbacks.Where(c => c.PayeeId == payee.PayeeId).Sum(c => c.Amount);
        return new(payee.PayeeId, ProducerName(payee, index), PlanName(payee.CommissionPlanId), gross, debits, gross - debits, payee.SplitPercentage < 100m, payee.SplitPercentage, payee.StatusCode);
    }

    private List<LedgerRow> BuildRows(List<CommissionPayeeDto> payees, List<CommissionTransactionDto> transactions, List<CommissionClawbackDto> clawbacks)
    {
        var producerNames = payees.Select((payee, index) => new { payee.PayeeId, Name = ProducerName(payee, index) }).ToDictionary(x => x.PayeeId, x => x.Name);
        var splitLookup = payees.ToDictionary(p => p.PayeeId, p => p.SplitPercentage);
        var staged = new List<LedgerDraft>();
        staged.AddRange(transactions.Select(t => new LedgerDraft(t.TransactionId, t.PayeeId, t.TransactionDate.ToDateTime(TimeOnly.MinValue), EntryTypeFromStatus(t.StatusCode), t.SourceEntityName, $"{t.StatusCode} commission at {t.CommissionRate:N2}%", 0m, t.CommissionAmount, t.StatusCode, t.GrossAmount, t.CommissionRate, false)));
        staged.AddRange(clawbacks.Select(c => new LedgerDraft(c.ClawbackId, c.PayeeId, c.ClawbackDate.ToDateTime(TimeOnly.MinValue), "Clawback", c.ReasonCode, c.Notes ?? c.StatusCode, c.Amount, 0m, c.StatusCode, c.Amount, 0m, true)));

        return staged.GroupBy(r => r.PayeeId).SelectMany(group =>
        {
            decimal balance = 0;
            return group.OrderBy(r => r.Date).Select(r =>
            {
                balance += r.Credit - r.Debit;
                return new LedgerRow(r.EntryId, r.PayeeId, producerNames.GetValueOrDefault(r.PayeeId, "Producer"), PlanName(payees.FirstOrDefault(p => p.PayeeId == r.PayeeId)?.CommissionPlanId ?? Guid.Empty), r.Date, r.Type, r.Reference, r.Description, r.Debit, r.Credit, balance, r.Status, r.GrossAmount, r.Rate, r.IsClawback, splitLookup.GetValueOrDefault(r.PayeeId, 100m));
            });
        }).OrderByDescending(r => r.Date).ThenBy(r => r.ProducerName).ToList();
    }

    private void ApplyFilters(bool resetPage = false)
    {
        IEnumerable<LedgerRow> query = _rows;
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var search = _search.Trim();
            query = query.Where(r => r.ProducerName.Contains(search, StringComparison.OrdinalIgnoreCase) || r.Plan.Contains(search, StringComparison.OrdinalIgnoreCase) || r.Reference.Contains(search, StringComparison.OrdinalIgnoreCase) || r.Description.Contains(search, StringComparison.OrdinalIgnoreCase) || r.Status.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        if (Guid.TryParse(_filterProducer, out var producerId)) query = query.Where(r => r.PayeeId == producerId);
        if (!string.IsNullOrWhiteSpace(_filterType)) query = query.Where(r => r.Type == _filterType);
        query = _filterPeriod switch
        {
            "current-month" => query.Where(r => r.Date.Year == DateTime.Today.Year && r.Date.Month == DateTime.Today.Month),
            "prior-month" => query.Where(r => r.Date.Year == DateTime.Today.AddMonths(-1).Year && r.Date.Month == DateTime.Today.AddMonths(-1).Month),
            "ytd" => query.Where(r => r.Date.Year == DateTime.Today.Year),
            _ => query
        };
        query = _kpiFilter switch
        {
            "credits" => query.Where(r => r.Credit > 0),
            "clawbacks" => query.Where(r => r.Type == "Clawback"),
            "net" => query.Where(r => r.Balance != 0),
            "splits" => query.Where(r => r.SplitPercentage < 100m),
            "pending" => query.Where(r => r.Status.Contains("Pending", StringComparison.OrdinalIgnoreCase)),
            "top" => _producers.OrderByDescending(p => p.YtdNet).FirstOrDefault() is { } top ? query.Where(r => r.PayeeId == top.PayeeId) : query,
            _ => query
        };

        _filteredRows = query.OrderByDescending(r => r.Date).ThenBy(r => r.ProducerName).ToList();
        if (resetPage) _page = 1;
        if (_page > TotalPages) _page = TotalPages;
        _pagedRows = _filteredRows.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    }

    private void SetKpiFilter(string filter) { _kpiFilter = _kpiFilter == filter ? "all" : filter; ApplyFilters(resetPage: true); }
    private void ResetFilters() { _search = string.Empty; _filterProducer = string.Empty; _filterType = string.Empty; _filterPeriod = string.Empty; _kpiFilter = "all"; ApplyFilters(resetPage: true); }
    private void PreviousPage() { if (_page <= 1) return; _page--; ApplyFilters(); }
    private void NextPage() { if (_page >= TotalPages) return; _page++; ApplyFilters(); }
    private void SelectRow(LedgerRow row) => _selected = row;
    private void ClearSelection() => _selected = null;
    private bool IsSelected(LedgerRow row) => _selected?.EntryId == row.EntryId;

    private void OpenEntryForm(Guid? payeeId = null)
    {
        _saveAttempted = false;
        var selectedPayeeId = payeeId ?? _selected?.PayeeId ?? _producers.FirstOrDefault()?.PayeeId ?? Guid.Empty;
        var producer = _producers.FirstOrDefault(p => p.PayeeId == selectedPayeeId);
        _entryForm = new() { PayeeId = selectedPayeeId, Rate = producer is null ? 10m : DefaultRate(producer.PayeeId), Reference = $"ADJ-{DateTime.UtcNow:yyyyMMdd}", Description = "Manual ledger entry" };
        _showEntryForm = true;
    }

    private void CloseEntryForm() { if (_busy) return; _showEntryForm = false; _saveAttempted = false; }
    private void OpenExport() { _exportFormError = null; _showExport = true; }
    private void CloseExport() { if (_busy) return; _showExport = false; _exportFormError = null; }

    private async Task SaveEntryAsync()
    {
        _saveAttempted = true;
        if (_entryForm.PayeeId == Guid.Empty) { ShowToast("Select a producer before saving.", "warning"); return; }
        var payee = _producers.FirstOrDefault(p => p.PayeeId == _entryForm.PayeeId);
        var payeeDto = payee is null ? null : _rows.FirstOrDefault(r => r.PayeeId == payee.PayeeId);
        var planId = _plans.FirstOrDefault(p => p.PlanName == payee?.Plan)?.CommissionPlanId ?? _plans.FirstOrDefault()?.CommissionPlanId ?? Guid.Empty;
        if (planId == Guid.Empty) { ShowToast("A commission plan is required before saving ledger entries.", "warning"); return; }

        _busy = true;
        try
        {
            if (_entryForm.EntryType == "Clawback")
            {
                var original = _rows.FirstOrDefault(r => r.PayeeId == _entryForm.PayeeId && !r.IsClawback);
                if (original is null) { ShowToast("Create a credit transaction before adding a clawback.", "warning"); return; }
                await Api.CreateCommissionClawbackAsync(new CreateCommissionClawbackRequest { TenantId = _tenantId, PayeeId = _entryForm.PayeeId, OriginalTransactionId = original.EntryId, ClawbackDate = DateOnly.FromDateTime(_entryForm.EntryDate), Amount = _entryForm.Amount, ReasonCode = _entryForm.Reference, Notes = _entryForm.Description, StatusCode = "Pending", CreatedByUserId = _tenantAdminUserId });
            }
            else
            {
                await Api.CreateCommissionTransactionAsync(new CreateCommissionTransactionRequest { TenantId = _tenantId, PayeeId = _entryForm.PayeeId, CommissionPlanId = planId, SourceEntityName = _entryForm.Reference, SourceEntityId = Guid.NewGuid(), TransactionDate = DateOnly.FromDateTime(_entryForm.EntryDate), GrossAmount = _entryForm.GrossAmount, CommissionRate = _entryForm.Rate, CommissionAmount = _entryForm.Amount, StatusCode = _entryForm.EntryType, CreatedByUserId = _tenantAdminUserId });
            }

            _showEntryForm = false;
            ShowToast("Producer ledger entry saved.", "success");
            await LoadAsync();
        }
        catch (Exception ex) { ShowToast($"Save failed: {ex.Message}", "danger"); }
        finally { _busy = false; }
    }

    private async Task NotifyValidationAsync(EditContext _)
    {
        _saveAttempted = true;
        ShowToast("Please correct the validation errors before continuing.", "warning");
        await Task.CompletedTask;
    }

    private async Task ExportLedgerAsync()
    {
        _exportFormError = null;
        if (_exportForm.EndDate < _exportForm.StartDate) { _exportFormError = "End Date must be on or after Start Date."; return; }
        var exportRows = _filteredRows.Where(r => r.Date.Date >= _exportForm.StartDate.Date && r.Date.Date <= _exportForm.EndDate.Date).ToList();
        if (!exportRows.Any()) { _exportFormError = "No ledger entries match the selected date range."; return; }

        var csv = new StringBuilder();
        csv.AppendLine(_exportForm.IncludeSplits ? "Producer,Plan,SplitPct,Date,Type,Reference,Description,Status,GrossAmount,Rate,Debit,Credit,Balance" : "Producer,Plan,Date,Type,Reference,Description,Status,GrossAmount,Rate,Debit,Credit,Balance");
        foreach (var row in exportRows)
        {
            string[] values = _exportForm.IncludeSplits
                ? [Csv(row.ProducerName), Csv(row.Plan), row.SplitPercentage.ToString("0.####"), row.Date.ToString("yyyy-MM-dd"), Csv(row.Type), Csv(row.Reference), Csv(row.Description), Csv(row.Status), row.GrossAmount.ToString("0.00"), row.Rate.ToString("0.####"), row.Debit.ToString("0.00"), row.Credit.ToString("0.00"), row.Balance.ToString("0.00")]
                : [Csv(row.ProducerName), Csv(row.Plan), row.Date.ToString("yyyy-MM-dd"), Csv(row.Type), Csv(row.Reference), Csv(row.Description), Csv(row.Status), row.GrossAmount.ToString("0.00"), row.Rate.ToString("0.####"), row.Debit.ToString("0.00"), row.Credit.ToString("0.00"), row.Balance.ToString("0.00")];
            csv.AppendLine(string.Join(',', values));
        }

        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        await Js.InvokeVoidAsync("amsShell.downloadBase64", $"producer-ledger-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
        _showExport = false;
        ShowToast($"Exported {exportRows.Count:N0} ledger entries.", "success");
    }

    private void EnsureSelectedStillVisible() { if (_selected is null) return; _selected = _rows.FirstOrDefault(r => r.EntryId == _selected.EntryId); }
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind) { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private string PlanName(Guid planId) => _plans.FirstOrDefault(p => p.CommissionPlanId == planId)?.PlanName ?? "Commission Plan";
    private decimal DefaultRate(Guid payeeId) => _plans.FirstOrDefault(p => p.PlanName == _producers.FirstOrDefault(x => x.PayeeId == payeeId)?.Plan)?.NewBusinessRatePct ?? 10m;
    private static string ProducerName(CommissionPayeeDto payee, int index) => $"{payee.PayeeTypeCode} {index + 1}";
    private static string EntryTypeFromStatus(string status) => status switch { "Bonus" => "Bonus", "Override" => "Override", "Adjustment" => "Adjustment", _ => "Credit" };
    private static string Fmt(decimal v) => v.ToString("C0");
    private static string Csv(string value) { var quote = Convert.ToChar(34).ToString(); return string.Concat(quote, value.Replace(quote, quote + quote), quote); }
    private static string TypeCss(string type) => $"pl-e-{type.ToLowerInvariant()}";
    private static string TypeIconClass(string type) => type switch { "Clawback" => "pl-di-red", "Bonus" => "pl-di-purple", "Override" => "pl-di-amber", "Adjustment" => "pl-di-blue", _ => "pl-di-green" };
    private static string StatusCss(string status) => $"pl-st-{status.ToLowerInvariant().Replace(" ", "-")}";

    private sealed record KpiModel(string Filter, string Label, string Value, string Caption, string Icon, string Tone) { public string Title => $"Filter by {Label}"; }
    private sealed record ProducerSummary(Guid PayeeId, string Name, string Plan, decimal YtdGross, decimal YtdClawbacks, decimal YtdNet, bool HasSplit, decimal SplitPercentage, string Status);
    private sealed record LedgerDraft(Guid EntryId, Guid PayeeId, DateTime Date, string Type, string Reference, string Description, decimal Debit, decimal Credit, string Status, decimal GrossAmount, decimal Rate, bool IsClawback);
    private sealed record LedgerRow(Guid EntryId, Guid PayeeId, string ProducerName, string Plan, DateTime Date, string Type, string Reference, string Description, decimal Debit, decimal Credit, decimal Balance, string Status, decimal GrossAmount, decimal Rate, bool IsClawback, decimal SplitPercentage);

    private sealed class EntryForm
    {
        [Required] public Guid PayeeId { get; set; }
        [Required, StringLength(20)] public string EntryType { get; set; } = "Credit";
        [Required] public DateTime EntryDate { get; set; } = DateTime.Today;
        [Required, StringLength(100)] public string Reference { get; set; } = string.Empty;
        [Range(0, 100000000)] public decimal GrossAmount { get; set; } = 10000;
        [Range(0, 100)] public decimal Rate { get; set; } = 10;
        [Range(0.01, 100000000)] public decimal Amount { get; set; } = 1000;
        [Required, StringLength(1000)] public string Description { get; set; } = string.Empty;
    }

    private sealed class ExportLedgerForm
    {
        [Required, StringLength(20)] public string Format { get; set; } = "CSV";
        [Required] public DateTime StartDate { get; set; } = DateTime.Today.AddMonths(-1);
        [Required] public DateTime EndDate { get; set; } = DateTime.Today;
        public bool IncludeSplits { get; set; } = true;
    }

