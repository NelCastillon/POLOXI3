@page "/commissions/producer-ledger"
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Producer Commission Ledger — AMS</PageTitle>

<AppPageHeader Title="Producer Commission Ledger"
               Subtitle="Full running ledger of commission credits, debits, clawbacks, and adjustments per producer with multi-producer split visibility"
               Icon="bi-journal-text">
    <Actions>
        <button class="pl-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/statements")'>
            <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Statements
        </button>
        <button class="pl-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/splits")'>
            <i class="bi bi-scissors" aria-hidden="true"></i> Split Rules
        </button>
        <button class="pl-btn-primary" @onclick="() => _showExport = true">
            <i class="bi bi-download" aria-hidden="true"></i> Export Ledger
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="pl-kpi-strip">
    @PlKpi("bi-people",            "Producers",       _producers.Count.ToString(),                              "pl-ki-blue")
    @PlKpi("bi-currency-dollar",   "YTD Earned",      Fmt(_producers.Sum(p=>p.YtdGross)),                       "pl-ki-green")
    @PlKpi("bi-arrow-down-circle", "YTD Clawbacks",   Fmt(_producers.Sum(p=>p.YtdClawbacks)),                   "pl-ki-red")
    @PlKpi("bi-currency-dollar",   "YTD Net",         Fmt(_producers.Sum(p=>p.YtdNet)),                         "pl-ki-green")
    @PlKpi("bi-graph-up",          "Top Producer",    _producers.OrderByDescending(p=>p.YtdNet).FirstOrDefault()?.Name ?? "—", "pl-ki-blue")
    @PlKpi("bi-scissors",          "Split Earners",   _producers.Count(p=>p.HasSplit).ToString()+" producers",  "pl-ki-purple")
</div>

<!-- Sub-nav -->
<div class="pl-subnav">
    <button class="pl-snav-btn pl-snav-active"><i class="bi bi-journal-text" aria-hidden="true"></i> Producer Ledger</button>
    <button class="pl-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/statements")'><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Statements</button>
    <button class="pl-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/splits")'><i class="bi bi-scissors" aria-hidden="true"></i> Splits</button>
    <button class="pl-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/plans")'><i class="bi bi-clipboard-check" aria-hidden="true"></i> Plans</button>
    <button class="pl-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/exceptions")'><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Exceptions</button>
    <button class="pl-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/forecast")'><i class="bi bi-graph-up" aria-hidden="true"></i> Forecast</button>
    <button class="pl-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/planner")'><i class="bi bi-calculator" aria-hidden="true"></i> What-If Planner</button>
</div>

<!-- Toolbar -->
<div class="pl-toolbar">
    <SfTextBox Placeholder="Search producer…" @bind-Value="_searchTerm" Width="240px"></SfTextBox>
    <select class="e-input pl-sel" @bind="_filterPeriod">
        <option value="">All Periods</option>
        <option value="2025-02">Feb 2025</option>
        <option value="2025-01">Jan 2025</option>
        <option value="2024-12">Dec 2024</option>
        <option value="YTD">YTD 2025</option>
    </select>
    <select class="e-input pl-sel" @bind="_filterProducer">
        <option value="">All Producers</option>
        @foreach (var p in _producers) { <option value="@p.Name">@p.Name</option> }
    </select>
    <select class="e-input pl-sel" @bind="_filterType">
        <option value="">All Entry Types</option>
        <option value="Credit">Credit</option>
        <option value="Clawback">Clawback</option>
        <option value="Adjustment">Adjustment</option>
        <option value="Override">Override</option>
        <option value="Bonus">Bonus</option>
    </select>
</div>

@if (_loading)
{
    <div style="padding:2rem"><SfSpinner Visible="true" /></div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}
else
{
<!-- Producer cards + ledger -->
<div class="pl-body">
    <!-- Producer selector sidebar -->
    <div class="pl-sidebar">
        <div class="pl-sidebar-hdr">Producers</div>
        @foreach (var p in FilteredProducers)
        {
            <div class="pl-producer-card @(p.Name == _selectedProducer ? "pl-pc-selected" : "")"
                 @onclick="() => SelectProducer(p.Name)">
                <div class="pl-pc-avatar">@p.Name[0]</div>
                <div class="pl-pc-info">
                    <div class="pl-pc-name">@p.Name</div>
                    <div class="pl-pc-plan">@p.Plan</div>
                    <div class="pl-pc-net">@p.YtdNet.ToString("C0") YTD net</div>
                </div>
                @if (p.HasSplit) { <span class="pl-pc-badge">Split</span> }
            </div>
        }
    </div>

    <!-- Ledger entries for selected producer -->
    <div class="pl-ledger">
        @if (_selectedProducer is null)
        {
            <div class="pl-empty"><i class="bi bi-arrow-left-circle" aria-hidden="true"></i> Select a producer to view their ledger</div>
        }
        else
        {
            <div class="pl-ledger-hdr">
                <span class="pl-ledger-name">@_selectedProducer — Commission Ledger</span>
                <span class="pl-ledger-bal">Running Balance: <strong>@RunningBalance.ToString("C2")</strong></span>
            </div>
            <SfGrid DataSource="LedgerEntries" AllowSorting="true" AllowPaging="true" Height="460px">
                <GridPageSettings PageSize="15"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(LedgerEntry.Date)" HeaderText="Date" Type="ColumnType.Date" Format="d" Width="110"></GridColumn>
                    <GridColumn HeaderText="Type" Width="110">
                        <Template>
                            @{ var e = (LedgerEntry)context; }
                            <span class="pl-entry-chip pl-e-@e.Type.ToLower()">@e.Type</span>
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(LedgerEntry.Reference)" HeaderText="Reference" Width="150"></GridColumn>
                    <GridColumn Field="@nameof(LedgerEntry.Description)" HeaderText="Description" Width="260"></GridColumn>
                    <GridColumn Field="@nameof(LedgerEntry.Debit)" HeaderText="Debit" Format="C2" Width="110" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                    <GridColumn Field="@nameof(LedgerEntry.Credit)" HeaderText="Credit" Format="C2" Width="110" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                    <GridColumn Field="@nameof(LedgerEntry.Balance)" HeaderText="Balance" Format="C2" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                </GridColumns>
            </SfGrid>
        }
    </div>
</div>
}

<!-- Export Dialog -->
<SfDialog @bind-Visible="_showExport" Width="520px" ShowCloseIcon="false" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-download" aria-hidden="true"></i><span>Export Producer Ledger</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseExport"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_exportEditContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Format <span class="text-danger">*</span></label><InputSelect @bind-Value="_exportForm.Format" class="um-input"><option value="CSV">CSV</option><option value="Excel">Excel</option><option value="PDF">PDF</option></InputSelect><ValidationMessage For="() => _exportForm.Format" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Start Date <span class="text-danger">*</span></label><InputDate @bind-Value="_exportForm.StartDate" class="um-input" /><ValidationMessage For="() => _exportForm.StartDate" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>End Date <span class="text-danger">*</span></label><InputDate @bind-Value="_exportForm.EndDate" class="um-input" /><ValidationMessage For="() => _exportForm.EndDate" class="validation-message text-danger" /></div>
                    <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_exportForm.IncludeSplits" /> Include split allocation detail</label></div>
                    @if (!string.IsNullOrWhiteSpace(_exportFormError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_exportFormError</div> }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseExport">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="ExportLedger">Export</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm, _filterPeriod, _filterProducer, _filterType, _selectedProducer, _loadError;
    private bool _showExport, _loading;
    private ExportLedgerForm _exportForm = new();
    private EditContext _exportEditContext = default!;
    private string? _exportFormError;

    private List<ProducerSummary> _producers = [];

    private IEnumerable<ProducerSummary> FilteredProducers => _producers.Where(p =>
        string.IsNullOrEmpty(_filterProducer) || p.Name == _filterProducer).Where(p =>
        string.IsNullOrEmpty(_searchTerm) || p.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    private Dictionary<string, List<LedgerEntry>> _allLedgers = [];

    private List<LedgerEntry> LedgerEntries => _selectedProducer is not null && _allLedgers.TryGetValue(_selectedProducer, out var l)
        ? l.Where(e => string.IsNullOrEmpty(_filterType) || e.Type == _filterType).ToList()
        : [];

    private decimal RunningBalance => LedgerEntries.LastOrDefault()?.Balance ?? 0m;

    protected override async Task OnInitializedAsync()
    {
        _exportEditContext = new(_exportForm);
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Commissions","/commissions"), new("Producer Ledger",""));
        await LoadAsync();
    }

    private void CloseExport() => _showExport = false;

    private void ExportLedger()
    {
        _exportFormError = null;
        if (!_exportEditContext.Validate()) return;
        if (_exportForm.EndDate < _exportForm.StartDate)
        {
            _exportFormError = "End Date must be on or after Start Date.";
            return;
        }
        _showExport = false;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var payees = (await Api.SearchCommissionPayeesAsync(_tenantId))?.Items.ToList() ?? [];
            var plans = (await Api.SearchCommissionPlansAsync(_tenantId))?.Items.ToDictionary(x => x.CommissionPlanId) ?? [];
            var transactions = (await Api.SearchCommissionTransactionsAsync(_tenantId))?.Items.ToList() ?? [];
            var clawbacks = (await Api.SearchCommissionClawbacksAsync(_tenantId))?.Items.ToList() ?? [];

            _producers = payees.Select((payee, index) =>
            {
                var name = $"{payee.PayeeTypeCode} {index + 1}";
                var gross = transactions.Where(t => t.PayeeId == payee.PayeeId).Sum(t => t.CommissionAmount);
                var claws = clawbacks.Where(c => c.PayeeId == payee.PayeeId).Sum(c => c.Amount);
                var plan = plans.TryGetValue(payee.CommissionPlanId, out var p) ? p.PlanName : payee.PayeeTypeCode;
                return new ProducerSummary(name, plan, gross, claws, gross - claws, payee.SplitPercentage < 100m);
            }).ToList();

            _allLedgers = payees.Select((payee, index) => new { Payee = payee, Name = $"{payee.PayeeTypeCode} {index + 1}" })
                .ToDictionary(x => x.Name, x => BuildLedger(x.Payee, transactions, clawbacks));

            _selectedProducer = _producers.FirstOrDefault()?.Name;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _producers = [];
            _allLedgers = [];
        }
        finally { _loading = false; }
    }

    private static List<LedgerEntry> BuildLedger(CommissionPayeeDto payee, List<CommissionTransactionDto> transactions, List<CommissionClawbackDto> clawbacks)
    {
        var rows = new List<(DateTime Date, string Type, string Reference, string Description, decimal Debit, decimal Credit)>();
        rows.AddRange(transactions.Where(t => t.PayeeId == payee.PayeeId).Select(t => (t.TransactionDate.ToDateTime(TimeOnly.MinValue), "Credit", t.SourceEntityName, $"{t.StatusCode} commission at {t.CommissionRate:N2}%", 0m, t.CommissionAmount)));
        rows.AddRange(clawbacks.Where(c => c.PayeeId == payee.PayeeId).Select(c => (c.ClawbackDate.ToDateTime(TimeOnly.MinValue), "Clawback", c.ReasonCode, c.Notes ?? c.StatusCode, c.Amount, 0m)));

        decimal balance = 0;
        return rows.OrderBy(x => x.Date).Select(x =>
        {
            balance += x.Credit - x.Debit;
            return new LedgerEntry(x.Date, x.Type, x.Reference, x.Description, x.Debit, x.Credit, balance);
        }).ToList();
    }

    void SelectProducer(string name) => _selectedProducer = name;

    static string Fmt(decimal v) => v.ToString("C0");

    RenderFragment PlKpi(string icon, string label, string val, string color) => __builder =>
    {
        <div class="pl-kpi-card @color">
            <i class="bi @icon pl-kpi-icon" aria-hidden="true"></i>
            <div><div class="pl-kpi-val">@val</div><div class="pl-kpi-lbl">@label</div></div>
        </div>
    };

    record ProducerSummary(string Name, string Plan, decimal YtdGross, decimal YtdClawbacks, decimal YtdNet, bool HasSplit);
    record LedgerEntry(DateTime Date, string Type, string Reference, string Description, decimal Debit, decimal Credit, decimal Balance);

    private sealed class ExportLedgerForm
    {
        [Required, StringLength(20)] public string Format { get; set; } = "Excel";
        [Required] public DateTime StartDate { get; set; } = DateTime.Today.AddMonths(-1);
        [Required] public DateTime EndDate { get; set; } = DateTime.Today;
        public bool IncludeSplits { get; set; } = true;
    }
}
