@page "/admin/system/onboarding"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Tenant Onboarding — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Tenant Onboarding Accelerator"
               Subtitle="Complete guided onboarding for new agencies — data migration, carrier mapping, commission setup, branding, and staff training"
               Icon="bi-rocket-takeoff">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ExportChecklist"><i class="bi bi-download" aria-hidden="true"></i> Export Checklist</button>
        <button class="um-btn um-btn-primary" @onclick="MarkAllComplete"><i class="bi bi-check2-all" aria-hidden="true"></i> Mark Step Complete</button>
    </Actions>
</AppPageHeader>

<!-- Progress header -->
<div class="ob-progress-card">
    <div class="ob-progress-info">
        <div class="ob-progress-title">Onboarding Progress</div>
        <div class="ob-progress-sub">@CompletedCount of @_allSteps.Count tasks complete · Estimated @EstimatedHoursLeft hrs remaining</div>
    </div>
    <div class="ob-progress-bar-wrap">
        <div class="ob-progress-bar"><div class="ob-progress-fill" style="width:@ProgressPct%"></div></div>
        <span class="ob-progress-pct">@ProgressPct%</span>
    </div>
</div>

<!-- Accelerator modules -->
<div class="ob-module-grid">
    @foreach (var module in _modules)
    {
        var modSteps = _allSteps.Where(s => s.Module == module.Key).ToList();
        var modDone  = modSteps.Count(s => s.Completed);
        <div class="ob-module-card @(modDone==modSteps.Count&&modSteps.Count>0?"ob-mod-done":"")">
            <div class="ob-mod-hdr">
                <div class="ob-mod-icon @module.IconCss"><i class="bi bi-@module.Icon" aria-hidden="true"></i></div>
                <div class="ob-mod-info">
                    <div class="ob-mod-name">@module.Name</div>
                    <div class="ob-mod-meta">@modDone / @modSteps.Count complete</div>
                </div>
                @if (modDone == modSteps.Count && modSteps.Count > 0)
                {
                    <span class="ob-done-badge"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Done</span>
                }
                else
                {
                    <div class="ob-mod-mini-bar"><div class="ob-mod-mini-fill" style="width:@(modSteps.Count > 0 ? modDone * 100 / modSteps.Count : 0)%"></div></div>
                }
            </div>
            <div class="ob-step-list">
                @foreach (var step in modSteps)
                {
                    <div class="ob-step-item @(step.Completed?"ob-step-done":"") @(step.IsRequired?"":"ob-step-optional")">
                        <label class="ob-step-chk-wrap">
                            <input type="checkbox" @bind="step.Completed" class="ob-step-chk" />
                            <span class="ob-step-label">@step.Label</span>
                        </label>
                        @if (!string.IsNullOrEmpty(step.ActionUrl))
                        {
                            <button class="um-btn um-btn-ghost um-btn-xs ob-step-action" @onclick='()=>Nav.NavigateTo(step.ActionUrl)' title="Open">
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                            </button>
                        }
                        @if (!step.IsRequired)
                        {
                            <span class="ob-opt-badge">Optional</span>
                        }
                    </div>
                }
            </div>
            @if (!string.IsNullOrEmpty(module.ActionUrl))
            {
                <button class="ob-mod-action-btn" @onclick='()=>Nav.NavigateTo(module.ActionUrl)'>
                    <i class="bi bi-@module.Icon" aria-hidden="true"></i> Open @module.Name
                </button>
            }
        </div>
    }
</div>

@code {
    private SfToast? _toast;

    private int CompletedCount => _allSteps.Count(s => s.Completed);
    private int ProgressPct => _allSteps.Count > 0 ? CompletedCount * 100 / _allSteps.Count : 0;
    private int EstimatedHoursLeft => (_allSteps.Count - CompletedCount) * 20 / 60;

    private List<OnboardModule> _modules = [];
    private List<OnboardStep>   _allSteps = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Administration","/admin"), new("Tenant Onboarding",""));
        _modules =
        [
            new OnboardModule("migration",    "Data Migration Wizard",     "database-up",          "ob-ic-blue",   "/admin/system/onboarding/migration"),
            new OnboardModule("carriers",     "Carrier Mapping Setup",     "broadcast",            "ob-ic-green",  "/admin/system/onboarding/carrier-mapping"),
            new OnboardModule("commissions",  "Commission Import",         "percent",              "ob-ic-amber",  "/admin/system/onboarding/commission-import"),
            new OnboardModule("templates",    "Template Import",           "layout-text-sidebar",  "ob-ic-purple", "/admin/system/onboarding/template-import"),
            new OnboardModule("branding",     "Portal Brand Setup",        "palette",              "ob-ic-red",    "/admin/system/onboarding/portal-brand"),
            new OnboardModule("training",     "Training Checklist",        "mortarboard",          "ob-ic-grey",   "/admin/system/onboarding/training-checklist"),
        ];
        _allSteps =
        [
            // Data Migration
            new OnboardStep("migration","Export data from previous AMS (Applied Epic / Hawksoft / etc.)",true,""),
            new OnboardStep("migration","Validate export file format (CSV / XML)",true,""),
            new OnboardStep("migration","Map source fields to AMS fields using Migration Wizard",true,"/admin/system/onboarding/migration"),
            new OnboardStep("migration","Run dry-run import and review error report",true,"/admin/system/onboarding/migration"),
            new OnboardStep("migration","Run live import and verify account/contact counts",true,"/admin/system/onboarding/migration"),
            new OnboardStep("migration","Import historical policies (optional)",false,"/admin/system/onboarding/migration"),
            new OnboardStep("migration","Import claims history (optional)",false,"/admin/system/onboarding/migration"),
            // Carrier Mapping
            new OnboardStep("carriers","Connect carriers in the Integration Catalog",true,"/integrations"),
            new OnboardStep("carriers","Map carrier codes to AMS carrier master list",true,"/admin/system/onboarding/carrier-mapping"),
            new OnboardStep("carriers","Configure download schedules for each carrier",true,"/admin/system/onboarding/carrier-mapping"),
            new OnboardStep("carriers","Run first carrier download test batch",true,"/admin/system/onboarding/carrier-mapping"),
            new OnboardStep("carriers","Resolve initial download exceptions",true,"/integrations/download-exceptions"),
            // Commission Import
            new OnboardStep("commissions","Define commission schedules for each carrier",true,"/admin/reference/commission-schedules"),
            new OnboardStep("commissions","Import historical commission statements (optional)",false,"/admin/system/onboarding/commission-import"),
            new OnboardStep("commissions","Map producers to commission plans",true,"/admin/system/onboarding/commission-import"),
            new OnboardStep("commissions","Configure split rules for shared accounts",false,"/commissions/splits"),
            new OnboardStep("commissions","Run first commission calculation and verify",true,"/commissions"),
            // Template Import
            new OnboardStep("templates","Import email templates from previous system",false,"/admin/system/onboarding/template-import"),
            new OnboardStep("templates","Configure renewal notice templates (90/60/30 day)",true,"/admin/system/onboarding/template-import"),
            new OnboardStep("templates","Configure payment receipt and invoice templates",true,"/admin/system/onboarding/template-import"),
            new OnboardStep("templates","Configure FNOL acknowledgement template",true,"/admin/system/onboarding/template-import"),
            new OnboardStep("templates","Test-send all key templates and verify rendering",true,"/admin/system/onboarding/template-import"),
            // Portal Brand Setup
            new OnboardStep("branding","Upload agency logo and favicon",true,"/admin/system/onboarding/portal-brand"),
            new OnboardStep("branding","Set primary and accent brand colors",true,"/admin/system/onboarding/portal-brand"),
            new OnboardStep("branding","Configure portal domain / subdomain",true,"/admin/system/onboarding/portal-brand"),
            new OnboardStep("branding","Set portal welcome message and contact info",true,"/admin/system/onboarding/portal-brand"),
            new OnboardStep("branding","Send test portal invite to verify client experience",true,"/admin/system/onboarding/portal-brand"),
            // Training Checklist
            new OnboardStep("training","Enable sandbox mode for new staff",true,"/admin/system/sandbox"),
            new OnboardStep("training","Assign all new staff to sandbox environment",true,"/admin/system/sandbox"),
            new OnboardStep("training","Complete 'Getting Started' walkthrough with each user",true,"/admin/system/help"),
            new OnboardStep("training","Run a simulated carrier download exercise",true,"/admin/system/sandbox"),
            new OnboardStep("training","Complete renewal pipeline simulation in sandbox",true,"/admin/system/sandbox"),
            new OnboardStep("training","Promote trained staff to production when ready",true,"/admin/system/onboarding/training-checklist"),
        ];
        // Pre-mark a few as done for demo
        foreach (var step in _allSteps.Take(8)) step.Completed = true;
    }

    private async Task ExportChecklist()
    {
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = "Onboarding checklist exported to PDF.", CssClass = "e-toast-success" });
    }

    private async Task MarkAllComplete()
    {
        var next = _allSteps.FirstOrDefault(s => !s.Completed);
        if (next is not null) next.Completed = true;
        if (_toast is not null && next is not null) await _toast.ShowAsync(new ToastModel { Content = $"'{next.Label}' marked complete.", CssClass = "e-toast-success" });
    }

    private sealed class OnboardModule(string key, string name, string icon, string iconCss, string actionUrl) { public string Key=key; public string Name=name; public string Icon=icon; public string IconCss=iconCss; public string ActionUrl=actionUrl; }
    private sealed class OnboardStep(string module, string label, bool isRequired, string actionUrl) { public string Module=module; public string Label=label; public bool IsRequired=isRequired; public string ActionUrl=actionUrl; public bool Completed; }
}
