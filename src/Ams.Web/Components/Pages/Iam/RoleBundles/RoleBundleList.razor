@page "/iam/role-bundles"
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Role Bundles — IAM</PageTitle>

<AppPageHeader Title="Role Bundles"
               Subtitle="Group roles into bundles for bulk assignment to users and teams"
               Icon="bi-layers">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-ghost" @onclick="ExportAsync">
            <i class="bi bi-download" aria-hidden="true"></i> Export
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-layers-half" aria-hidden="true"></i> New Bundle
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="rbl-kpi-strip">
    <div class="@KpiClass1" @onclick="() => SetKpiFilter(1)" role="button" tabindex="0" aria-label="Filter: Total Bundles">
        <span class="rbl-kpi-icon rbl-kpi-icon--total"><i class="bi bi-layers-fill" aria-hidden="true"></i></span>
        <div>
            <div class="rbl-kpi-value">@_totalCount</div>
            <div class="rbl-kpi-label">Total Bundles</div>
        </div>
        @if (_kpiActive == 1) { <span class="rbl-kpi-active-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass2" @onclick="() => SetKpiFilter(2)" role="button" tabindex="0" aria-label="Filter: Active">
        <span class="rbl-kpi-icon rbl-kpi-icon--active"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></span>
        <div>
            <div class="rbl-kpi-value">@_activeCount</div>
            <div class="rbl-kpi-label">Active</div>
        </div>
        @if (_kpiActive == 2) { <span class="rbl-kpi-active-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass3" @onclick="() => SetKpiFilter(3)" role="button" tabindex="0" aria-label="Filter: System Bundles">
        <span class="rbl-kpi-icon rbl-kpi-icon--system"><i class="bi bi-gear-fill" aria-hidden="true"></i></span>
        <div>
            <div class="rbl-kpi-value">@_systemCount</div>
            <div class="rbl-kpi-label">System Bundles</div>
        </div>
        @if (_kpiActive == 3) { <span class="rbl-kpi-active-dot" aria-hidden="true"></span> }
    </div>
    <div class="@KpiClass4" @onclick="() => SetKpiFilter(4)" role="button" tabindex="0" aria-label="Filter: Inactive">
        <span class="rbl-kpi-icon rbl-kpi-icon--inactive"><i class="bi bi-slash-circle" aria-hidden="true"></i></span>
        <div>
            <div class="rbl-kpi-value">@_inactiveCount</div>
            <div class="rbl-kpi-label">Inactive</div>
        </div>
        @if (_kpiActive == 4) { <span class="rbl-kpi-active-dot" aria-hidden="true"></span> }
    </div>
</div>

<!-- Filter toolbar -->
<AppFilterPanel @bind-SearchValue="_search"
                OnSearch="OnSearchAsync"
                SearchPlaceholder="Search bundle code or name…">
    <Filters>
        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_statusOptions"
                        Placeholder="All Statuses"
                        ShowClearButton="true"
                        Width="150px"
                        Value="_filterStatus"
                        ValueChanged="@((string v) => { _filterStatus = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>

        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_systemOptions"
                        Placeholder="System?"
                        ShowClearButton="true"
                        Width="130px"
                        Value="_filterSystem"
                        ValueChanged="@((string v) => { _filterSystem = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>
    </Filters>
    <Actions>
        @if (_selected.Count > 0)
        {
            <span class="rbl-sel-count">
                <i class="bi bi-check2-square" aria-hidden="true"></i> @_selected.Count selected
            </span>

            <button class="um-btn um-btn-sm um-btn-ghost"
                    @onclick="() => OpenEdit(_selected[0])"
                    disabled="@(_selected.Count != 1)"
                    title="Edit bundle">
                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
            </button>

            <button class="um-btn um-btn-sm um-btn-ghost"
                    @onclick="() => ViewBundle(_selected[0])"
                    disabled="@(_selected.Count != 1)"
                    title="View bundle detail">
                <i class="bi bi-eye" aria-hidden="true"></i> View
            </button>

            @if (_selected.Count == 1 && _selected[0].IsActive)
            {
                <button class="um-btn um-btn-sm um-btn-warning"
                        @onclick="() => OpenDeactivate(_selected[0])"
                        title="Deactivate bundle">
                    <i class="bi bi-slash-circle" aria-hidden="true"></i> Deactivate
                </button>
            }
            else if (_selected.Count == 1 && !_selected[0].IsActive)
            {
                <button class="um-btn um-btn-sm um-btn-primary"
                        @onclick="() => OpenActivate(_selected[0])"
                        title="Activate bundle">
                    <i class="bi bi-check-circle" aria-hidden="true"></i> Activate
                </button>
            }
        }
    </Actions>
</AppFilterPanel>

<!-- Grid -->
<div class="um-grid-card app-datagrid">
    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite" aria-label="Loading role bundles…">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading role bundles…</span>
        </div>
    }
    <SfGrid @ref="_grid"
            TValue="RoleBundleDto"
            DataSource="@_bundles"
            AllowPaging="true"
            AllowSorting="true"
            EnableHover="true"
            RowHeight="52">
        <GridPageSettings PageSize="25" PageSizes="@(new int[] { 10, 25, 50, 100 })" />
        <GridSelectionSettings Mode="Syncfusion.Blazor.Grids.SelectionMode.Row"
                               Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" />
        <GridEvents TValue="RoleBundleDto"
                    RowSelected="OnRowSelected"
                    RowDeselected="OnRowDeselected" />
        <GridColumns>

            <GridColumn Type="ColumnType.CheckBox" Width="48" />

            <GridColumn Field="@nameof(RoleBundleDto.BundleCode)"
                        HeaderText="Bundle Code"
                        Width="160" />

            <GridColumn Field="@nameof(RoleBundleDto.BundleName)"
                        HeaderText="Bundle Name"
                        Width="230">
                <Template>
                    @{
                        var b = (RoleBundleDto)context;
                    }
                    <div class="rbl-bundle-cell">
                        <span class="rbl-bundle-badge" aria-hidden="true">
                            <i class="bi bi-layers-fill"></i>
                        </span>
                        <div class="rbl-bundle-info">
                            <div class="rbl-bundle-name">@b.BundleName</div>
                            @if (!string.IsNullOrEmpty(b.Description))
                            {
                                <div class="rbl-bundle-desc">@b.Description</div>
                            }
                        </div>
                    </div>
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(RoleBundleDto.IsSystemBundle)"
                        HeaderText="System"
                        Width="90"
                        TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var b = (RoleBundleDto)context;
                    }
                    @if (b.IsSystemBundle)
                    {
                        <span class="rbl-sys-on" title="System bundle"><i class="bi bi-gear-fill" aria-hidden="true"></i></span>
                    }
                    else
                    {
                        <span class="rbl-sys-off" title="Standard bundle"><i class="bi bi-dash" aria-hidden="true"></i></span>
                    }
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(RoleBundleDto.IsActive)"
                        HeaderText="Status"
                        Width="110">
                <Template>
                    @{
                        var b = (RoleBundleDto)context;
                    }
                    <AppStatusBadge Status="@(b.IsActive ? "Active" : "Inactive")" />
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(RoleBundleDto.RoleCount)"
                        HeaderText="Roles"
                        Width="90"
                        TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var b = (RoleBundleDto)context;
                    }
                    <span class="um-count-pill">@b.RoleCount</span>
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(RoleBundleDto.UserCount)"
                        HeaderText="Users"
                        Width="90"
                        TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var b = (RoleBundleDto)context;
                    }
                    <span class="um-count-pill">@b.UserCount</span>
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(RoleBundleDto.ModifiedDateUtc)"
                        HeaderText="Modified"
                        Width="130">
                <Template>
                    @{
                        var b = (RoleBundleDto)context;
                    }
                    <span title="@(b.ModifiedDateUtc?.ToString("g") ?? "Never")">
                        @FormatRelative(b.ModifiedDateUtc)
                    </span>
                </Template>
            </GridColumn>

            <GridColumn HeaderText=""
                        Width="100"
                        AllowSorting="false"
                        AllowFiltering="false">
                <Template>
                    @{
                        var b = (RoleBundleDto)context;
                    }
                    <div class="um-row-actions">
                        <button class="um-btn um-btn-xs um-btn-ghost"
                                @onclick="() => OpenEdit(b)"
                                title="Edit">
                            <i class="bi bi-pencil" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-xs um-btn-ghost"
                                @onclick="() => ViewBundle(b)"
                                title="View detail">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                        @if (b.IsActive)
                        {
                            <button class="um-btn um-btn-xs um-btn-ghost"
                                    @onclick="() => OpenDeactivate(b)"
                                    title="Deactivate"
                                    disabled="@b.IsSystemBundle">
                                <i class="bi bi-slash-circle" aria-hidden="true"></i>
                            </button>
                        }
                        else
                        {
                            <button class="um-btn um-btn-xs um-btn-ghost"
                                    @onclick="() => OpenActivate(b)"
                                    title="Activate">
                                <i class="bi bi-check-circle" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                </Template>
            </GridColumn>

        </GridColumns>
    </SfGrid>
</div>

<!-- Create / Edit drawer -->
<RoleBundleEditDrawer @bind-Visible="_showDrawer"
                      BundleId="_editBundleId"
                      OnSaved="HandleBundleSavedAsync" />

<!-- Deactivate confirmation -->
<AppConfirmActionDialog @bind-Visible="_showDeactivate"
                        Title="Deactivate Bundle"
                        Message="@($"Deactivate {_actionTarget?.BundleName}?")"
                        Detail="Users assigned this bundle will lose the roles it provides. You can reactivate at any time."
                        Variant="warning"
                        ConfirmText="Deactivate"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteDeactivateAsync" />

<!-- Activate confirmation -->
<AppConfirmActionDialog @bind-Visible="_showActivate"
                        Title="Activate Bundle"
                        Message="@($"Activate {_actionTarget?.BundleName}?")"
                        Detail="The bundle will become available for assignment immediately."
                        Variant="primary"
                        ConfirmText="Activate"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteActivateAsync" />

<!-- Toast -->
<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    // ── Constants ─────────────────────────────────────────────────────────────────
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    // ── Refs ──────────────────────────────────────────────────────────────────────
    private SfGrid<RoleBundleDto>? _grid;
    private SfToast?               _toast;

    // ── Data ──────────────────────────────────────────────────────────────────────
    private List<RoleBundleDto> _allBundles = [];
    private List<RoleBundleDto> _bundles    = [];
    private List<RoleBundleDto> _selected   = [];

    // ── Loading / action flags ────────────────────────────────────────────────────
    private bool _loading    = false;
    private bool _confirming = false;

    // ── Dialog visibility ─────────────────────────────────────────────────────────
    private bool _showDrawer     = false;
    private bool _showDeactivate = false;
    private bool _showActivate   = false;

    // ── Active targets ────────────────────────────────────────────────────────────
    private Guid?            _editBundleId;
    private RoleBundleDto?   _actionTarget;

    // ── Filters ───────────────────────────────────────────────────────────────────
    private string _search       = string.Empty;
    private string _filterStatus = string.Empty;
    private string _filterSystem = string.Empty;

    // ── KPI state ─────────────────────────────────────────────────────────────────
    private int _kpiActive = 0; // 0=none 1=total 2=active 3=system 4=inactive

    private string KpiClass1 => "rbl-kpi-card rbl-kpi-card--total"    + (_kpiActive == 1 ? " rbl-kpi-card--active" : "");
    private string KpiClass2 => "rbl-kpi-card rbl-kpi-card--active"   + (_kpiActive == 2 ? " rbl-kpi-card--active" : "");
    private string KpiClass3 => "rbl-kpi-card rbl-kpi-card--system"   + (_kpiActive == 3 ? " rbl-kpi-card--active" : "");
    private string KpiClass4 => "rbl-kpi-card rbl-kpi-card--inactive" + (_kpiActive == 4 ? " rbl-kpi-card--active" : "");

    // ── KPI counters ──────────────────────────────────────────────────────────────
    private int _totalCount;
    private int _activeCount;
    private int _systemCount;
    private int _inactiveCount;

    // ── Static options ────────────────────────────────────────────────────────────
    private static readonly List<LabelValue> _statusOptions =
    [
        new("Active",   "Active"),
        new("Inactive", "Inactive"),
    ];

    private static readonly List<LabelValue> _systemOptions =
    [
        new("Yes", "System"),
        new("No",  "Standard"),
    ];

    // ── Lifecycle ─────────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",         "/"),
            new("IAM",          "/iam"),
            new("Role Bundles", "/iam/role-bundles"));

        await LoadAsync();
    }

    // ── Data loading ──────────────────────────────────────────────────────────────
    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var result = await Api.SearchRoleBundlesAsync(_tenantId, _search);
            _allBundles = result?.Items.ToList() ?? [];
            _selected.Clear();
            ComputeKpi();
            ApplyFilters();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchAsync(string _) => await LoadAsync();

    private void ApplyFilters()
    {
        _bundles = _allBundles.Where(b =>
            (string.IsNullOrEmpty(_filterStatus) ||
                (b.IsActive ? "Active" : "Inactive") == _filterStatus) &&
            (string.IsNullOrEmpty(_filterSystem) ||
                (_filterSystem == "Yes" ? b.IsSystemBundle : !b.IsSystemBundle))
        ).ToList();
        StateHasChanged();
    }

    private void SetKpiFilter(int n)
    {
        _kpiActive    = _kpiActive == n ? 0 : n;
        _filterStatus = string.Empty;
        _filterSystem = string.Empty;
        switch (_kpiActive)
        {
            case 2: _filterStatus = "Active";   break;
            case 3: _filterSystem = "Yes";      break;
            case 4: _filterStatus = "Inactive"; break;
        }
        ApplyFilters();
    }

    private void ComputeKpi()
    {
        _totalCount    = _allBundles.Count;
        _activeCount   = _allBundles.Count(b => b.IsActive);
        _systemCount   = _allBundles.Count(b => b.IsSystemBundle);
        _inactiveCount = _allBundles.Count(b => !b.IsActive);
    }

    // ── Row selection ─────────────────────────────────────────────────────────────
    private void OnRowSelected(RowSelectEventArgs<RoleBundleDto> args)
    {
        if (!_selected.Contains(args.Data))
            _selected.Add(args.Data);
    }

    private void OnRowDeselected(RowDeselectEventArgs<RoleBundleDto> args)
    {
        _selected.Remove(args.Data);
    }

    // ── CRUD ──────────────────────────────────────────────────────────────────────
    private void OpenCreate()
    {
        _editBundleId = null;
        _showDrawer   = true;
    }

    private void OpenEdit(RoleBundleDto bundle)
    {
        _editBundleId = bundle.BundleId;
        _showDrawer   = true;
    }

    private async Task HandleBundleSavedAsync() => await LoadAsync();

    // ── Activate / Deactivate ─────────────────────────────────────────────────────
    private void OpenDeactivate(RoleBundleDto bundle) { _actionTarget = bundle; _showDeactivate = true; }
    private void OpenActivate  (RoleBundleDto bundle) { _actionTarget = bundle; _showActivate   = true; }

    private async Task ExecuteDeactivateAsync()
    {
        if (_actionTarget is null) return;
        _confirming = true;
        try
        {
            await Api.SetRoleBundleActiveAsync(_actionTarget.BundleId, activate: false);
            await ShowToastAsync($"{_actionTarget.BundleName} has been deactivated.", "e-toast-warning");
            await LoadAsync();
        }
        catch (Exception ex) { await ShowToastAsync($"Error: {ex.Message}", "e-toast-danger"); }
        finally { _confirming = false; _actionTarget = null; }
    }

    private async Task ExecuteActivateAsync()
    {
        if (_actionTarget is null) return;
        _confirming = true;
        try
        {
            await Api.SetRoleBundleActiveAsync(_actionTarget.BundleId, activate: true);
            await ShowToastAsync($"{_actionTarget.BundleName} has been activated.", "e-toast-success");
            await LoadAsync();
        }
        catch (Exception ex) { await ShowToastAsync($"Error: {ex.Message}", "e-toast-danger"); }
        finally { _confirming = false; _actionTarget = null; }
    }

    // ── Navigation ────────────────────────────────────────────────────────────────
    private void ViewBundle(RoleBundleDto b) => Nav.NavigateTo("/iam/role-bundles/" + b.BundleId);

    // ── Stub actions ──────────────────────────────────────────────────────────────
    private Task ExportAsync() =>
        ShowToastAsync("Export: not yet implemented.", "e-toast-info");

    // ── Toast helper ──────────────────────────────────────────────────────────────
    private async Task ShowToastAsync(string msg, string cssClass = "e-toast-info")
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = cssClass });
    }

    // ── Helpers ───────────────────────────────────────────────────────────────────
    private static string FormatRelative(DateTime? dt)
    {
        if (dt is null) return "Never";
        var diff = DateTime.UtcNow - dt.Value;
        return diff.TotalDays switch
        {
            < 1   => diff.TotalHours < 1 ? "Just now" : $"{(int)diff.TotalHours}h ago",
            < 7   => $"{(int)diff.TotalDays}d ago",
            < 30  => $"{(int)(diff.TotalDays / 7)}w ago",
            < 365 => $"{(int)(diff.TotalDays / 30)}mo ago",
            _     => dt.Value.ToString("d"),
        };
    }

    // ── Inner models ──────────────────────────────────────────────────────────────
    private sealed record LabelValue(string Value, string Label);
}
