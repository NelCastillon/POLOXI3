@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<div class="tab-section">
    <div class="ts-header">
        <h3 class="ts-title">MFA Devices</h3>
        <button class="ts-btn-ghost" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
    </div>

    @if (_loading)
    {
        <div class="ts-loading" aria-live="polite">
            <div class="ts-spinner" aria-hidden="true"></div> Loading MFA devices...
        </div>
    }
    else if (_devices.Count == 0)
    {
        <div class="ts-empty">
            <i class="bi bi-phone" aria-hidden="true"></i>
            <span>No MFA devices registered for this user.</span>
        </div>
    }
    else
    {
        <AppGrid TValue="MfaDeviceDto" DataSource="@_devices" AllowPaging="false"
                AllowSorting="true" EnableHover="true" RowHeight="52">
            <GridColumns>
                <GridColumn Field="DeviceName" HeaderText="Device Name" Width="200">
                    <Template Context="d">
                        @{ var dev = (MfaDeviceDto)d; }
                        <div class="ts-mfa-cell">
                            <div class="ts-mfa-icon">
                                <i class="bi @MfaIcon(dev.DeviceTypeCode)" aria-hidden="true"></i>
                            </div>
                            <div>
                                <div class="font-semibold text-sm">@dev.DeviceName</div>
                                <div class="text-xs text-muted">@dev.DeviceTypeCode</div>
                            </div>
                        </div>
                    </Template>
                </GridColumn>
                <GridColumn Field="PhoneNumber" HeaderText="Phone / Email" Width="180">
                    <Template Context="d">
                        @{ var dev = (MfaDeviceDto)d; }
                        <span>@(dev.PhoneNumber ?? dev.EmailAddress ?? "-")</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="IsVerified" HeaderText="Verified" Width="100">
                    <Template Context="d">
                        @{ var dev = (MfaDeviceDto)d; }
                        <span class="badge @(dev.IsVerified ? "badge-green" : "badge-amber")">
                            @(dev.IsVerified ? "Verified" : "Pending")
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn Field="IsActive" HeaderText="Active" Width="90">
                    <Template Context="d">
                        @{ var dev = (MfaDeviceDto)d; }
                        <span class="badge @(dev.IsActive ? "badge-green" : "badge-neutral")">
                            @(dev.IsActive ? "Yes" : "No")
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn Field="LastUsedDateUtc" HeaderText="Last Used" Width="150">
                    <Template Context="d">
                        @{ var dev = (MfaDeviceDto)d; }
                        <span>@(dev.LastUsedDateUtc?.ToString("MMM d, yyyy") ?? "Never")</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="CreatedDateUtc" HeaderText="Added" Width="130">
                    <Template Context="d">
                        @{ var dev = (MfaDeviceDto)d; }
                        <span>@dev.CreatedDateUtc.ToString("MMM d, yyyy")</span>
                    </Template>
                </GridColumn>
            </GridColumns>
        </AppGrid>
    }
</div>

@code {
    [Parameter] public Guid UserId   { get; set; }
    [Parameter] public Guid TenantId { get; set; }

    private bool             _loading = true;
    private List<MfaDeviceDto> _devices = [];

    protected override async Task OnInitializedAsync()
    {
        await EnsureTenantContextAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Api.SearchMfaDevicesAsync(TenantId, userId: UserId);
            _devices = result?.Items.ToList() ?? [];
        }
        catch { /* non-critical */ }
        finally { _loading = false; }
    }

    private static string MfaIcon(string type) => type.ToLowerInvariant() switch
    {
        "totp"    => "bi-phone-fill",
        "sms"     => "bi-chat-square-text-fill",
        "email"   => "bi-envelope-fill",
        "hardware" => "bi-usb-drive-fill",
        _         => "bi-shield-fill",
    };

    private async Task EnsureTenantContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        if (TenantId == Guid.Empty) TenantId = context.TenantId;
    }
}
