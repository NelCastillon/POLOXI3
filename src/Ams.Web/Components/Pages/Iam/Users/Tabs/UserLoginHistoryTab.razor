@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<div class="tab-section">
    <div class="ts-header">
        <h3 class="ts-title">Login History</h3>
        <button class="ts-btn-ghost" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
    </div>

    @if (_loading)
    {
        <div class="ts-loading" aria-live="polite">
            <div class="ts-spinner" aria-hidden="true"></div> Loading login history…
        </div>
    }
    else if (_events.Count == 0)
    {
        <div class="ts-empty">
            <i class="bi bi-clock-history" aria-hidden="true"></i>
            <span>No login events recorded.</span>
        </div>
    }
    else
    {
        <SfGrid TValue="SecurityEventLogDto" DataSource="@_events" AllowPaging="true"
                AllowSorting="true" EnableHover="true" RowHeight="48">
            <GridPageSettings PageSize="20" />
            <GridColumns>
                <GridColumn Field="EventTypeCode" HeaderText="Event" Width="160">
                    <Template Context="e">
                        @{ var ev = (SecurityEventLogDto)e; }
                        <span class="badge @(ev.IsSuccess ? "badge-green" : "badge-red")">
                            <i class="bi @(ev.IsSuccess ? "bi-check-circle-fill" : "bi-x-circle-fill")"
                               aria-hidden="true"></i>
                            @ev.EventTypeCode
                        </span>
                    </Template>
                </GridColumn>
                <GridColumn Field="IpAddress" HeaderText="IP Address" Width="140" />
                <GridColumn Field="UserAgent" HeaderText="User Agent" Width="200" />
                <GridColumn Field="RiskScore" HeaderText="Risk" Width="80" TextAlign="TextAlign.Center">
                    <Template Context="e">
                        @{ var ev = (SecurityEventLogDto)e; }
                        @if (ev.RiskScore.HasValue)
                        {
                            <span class="badge @(ev.RiskScore > 70 ? "badge-red" : ev.RiskScore > 40 ? "badge-amber" : "badge-green")">
                                @ev.RiskScore
                            </span>
                        }
                        else { <span>—</span> }
                    </Template>
                </GridColumn>
                <GridColumn Field="CreatedDateUtc" HeaderText="Date / Time" Width="170">
                    <Template Context="e">
                        @{ var ev = (SecurityEventLogDto)e; }
                        <span>@ev.CreatedDateUtc.ToString("MMM d, yyyy HH:mm")</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="EventDescription" HeaderText="Description" Width="220" />
            </GridColumns>
        </SfGrid>
    }
</div>

@code {
    [Parameter] public Guid UserId   { get; set; }
    [Parameter] public Guid TenantId { get; set; }

    private bool                  _loading = true;
    private List<SecurityEventLogDto> _events = [];

    protected override async Task OnInitializedAsync()
    {
        await EnsureTenantContextAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Api.SearchSecurityEventsAsync(TenantId, pageSize: 100);
            _events = (result?.Items
                              .Where(e => e.UserId == UserId)
                              .ToList()) ?? [];
        }
        catch { /* non-critical */ }
        finally { _loading = false; }
    }

    private async Task EnsureTenantContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        if (TenantId == Guid.Empty) TenantId = context.TenantId;
    }
}
