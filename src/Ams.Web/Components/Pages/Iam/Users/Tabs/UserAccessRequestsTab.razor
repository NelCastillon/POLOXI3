@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<div class="tab-section">
    <div class="ts-header">
        <h3 class="ts-title">Privileged Access Requests</h3>
        <button class="ts-btn-ghost" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
    </div>

    @if (_loading)
    {
        <div class="ts-loading" aria-live="polite">
            <div class="ts-spinner" aria-hidden="true"></div> Loading access requests...
        </div>
    }
    else if (_requests.Count == 0)
    {
        <div class="ts-empty">
            <i class="bi bi-lock-fill" aria-hidden="true"></i>
            <span>No privileged access requests found for this user.</span>
        </div>
    }
    else
    {
        <AppGrid TValue="PrivilegedAccessRequestDto" DataSource="@_requests"
                AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
            
            <GridColumns>
                <GridColumn Field="TargetRoleName" HeaderText="Requested Role" Width="200" />
                <GridColumn Field="StatusCode" HeaderText="Status" Width="120">
                    <Template Context="r">
                        @{ var req = (PrivilegedAccessRequestDto)r; }
                        <span class="badge @StatusClass(req.StatusCode)">@req.StatusCode</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="JustificationText" HeaderText="Justification" Width="240" />
                <GridColumn Field="RequestedStartDateUtc" HeaderText="Start" Width="130">
                    <Template Context="r">
                        @{ var req = (PrivilegedAccessRequestDto)r; }
                        <span>@req.RequestedStartDateUtc.ToString("MMM d, yyyy")</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="RequestedEndDateUtc" HeaderText="End" Width="130">
                    <Template Context="r">
                        @{ var req = (PrivilegedAccessRequestDto)r; }
                        <span>@req.RequestedEndDateUtc.ToString("MMM d, yyyy")</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="ApprovedByFullName" HeaderText="Approved By" Width="160" />
                <GridColumn Field="CreatedDateUtc" HeaderText="Requested On" Width="150">
                    <Template Context="r">
                        @{ var req = (PrivilegedAccessRequestDto)r; }
                        <span>@req.CreatedDateUtc.ToString("MMM d, yyyy")</span>
                    </Template>
                </GridColumn>
            </GridColumns>
        </AppGrid>
    }
</div>

@code {
    [Parameter] public Guid UserId   { get; set; }
    [Parameter] public Guid TenantId { get; set; }

    private bool _loading = true;
    private List<PrivilegedAccessRequestDto> _requests = [];

    protected override async Task OnInitializedAsync()
    {
        await EnsureTenantContextAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Api.SearchPrivilegedAccessRequestsAsync(TenantId);
            _requests = result?.Items
                               .Where(r => r.RequestedByUserId == UserId)
                               .ToList() ?? [];
        }
        catch { /* non-critical */ }
        finally { _loading = false; }
    }

    private static string StatusClass(string s) => s.ToLowerInvariant() switch
    {
        "approved" => "badge-green",
        "pending"  => "badge-amber",
        "denied"   => "badge-red",
        "revoked"  => "badge-red",
        _          => "badge-neutral",
    };

    private async Task EnsureTenantContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        if (TenantId == Guid.Empty) TenantId = context.TenantId;
    }
}
