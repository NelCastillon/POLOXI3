@inject ApiClient Api

<div class="tab-section">
    <div class="ts-header">
        <h3 class="ts-title">Policy Acknowledgements</h3>
    </div>

    <div class="ts-policy-info">
        <div class="ts-policy-icon" aria-hidden="true">
            <i class="bi bi-file-earmark-check"></i>
        </div>
        <div class="ts-policy-body">
            <h4>Policy Acknowledgement Tracking</h4>
            <p>
                This section tracks which platform policies this user has reviewed and accepted,
                including terms of service, data privacy, acceptable use, and security policies.
            </p>
            @if (User is not null)
            {
                <div class="ts-policy-meta">
                    <div class="ts-policy-meta-row">
                        <span class="ts-meta-label">User</span>
                        <span>@User.FullName (@User.Email)</span>
                    </div>
                    <div class="ts-policy-meta-row">
                        <span class="ts-meta-label">Account Created</span>
                        <span>@User.CreatedDateUtc.ToString("MMMM d, yyyy")</span>
                    </div>
                    <div class="ts-policy-meta-row">
                        <span class="ts-meta-label">MFA Status</span>
                        <span class="badge @(User.MfaEnabled ? "badge-green" : "badge-amber")">
                            @(User.MfaEnabled ? "Enabled" : "Not Configured")
                        </span>
                    </div>
                </div>
            }
            <div class="ts-policy-placeholder-badge">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                Policy acknowledgement records will appear here once the policy management
                module is configured for your tenant.
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid     UserId   { get; set; }
    [Parameter] public Guid     TenantId { get; set; }
    [Parameter] public UserDto? User     { get; set; }
}
