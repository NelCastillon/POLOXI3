@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<div class="tab-section">
    <div class="ts-header">
        <h3 class="ts-title">Active Sessions</h3>
        <button class="ts-btn-ghost" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
    </div>

    @if (_loading)
    {
        <div class="ts-loading" aria-live="polite">
            <div class="ts-spinner" aria-hidden="true"></div> Loading sessions...
        </div>
    }
    else if (_sessions.Count == 0)
    {
        <div class="ts-empty">
            <i class="bi bi-window" aria-hidden="true"></i>
            <span>No sessions found for this user.</span>
        </div>
    }
    else
    {
        <SfGrid TValue="UserSessionDto" DataSource="@_sessions" AllowPaging="true"
                AllowSorting="true" EnableHover="true" RowHeight="48">
            <GridPageSettings PageSize="15" />
            <GridColumns>
                <GridColumn Field="IpAddress" HeaderText="IP Address" Width="140" />
                <GridColumn Field="DeviceType" HeaderText="Device" Width="120" />
                <GridColumn Field="LoginDateUtc" HeaderText="Login Time" Width="160">
                    <Template Context="s">
                        @{ var session = (UserSessionDto)s; }
                        <span>@session.LoginDateUtc.ToString("MMM d, HH:mm")</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="LastActivityDateUtc" HeaderText="Last Active" Width="150">
                    <Template Context="s">
                        @{ var session = (UserSessionDto)s; }
                        <span>@(session.LastActivityDateUtc?.ToString("MMM d, HH:mm") ?? "-")</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="ExpiresDateUtc" HeaderText="Expires" Width="140">
                    <Template Context="s">
                        @{ var session = (UserSessionDto)s; }
                        <span>@session.ExpiresDateUtc.ToString("MMM d, HH:mm")</span>
                    </Template>
                </GridColumn>
                <GridColumn Field="IsRevoked" HeaderText="Status" Width="100">
                    <Template Context="s">
                        @{ var session = (UserSessionDto)s; }
                        @if (session.IsRevoked)
                        {
                            <span class="badge badge-red">Revoked</span>
                        }
                        else if (session.ExpiresDateUtc < DateTime.UtcNow)
                        {
                            <span class="badge badge-neutral">Expired</span>
                        }
                        else
                        {
                            <span class="badge badge-green">Active</span>
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    }
</div>

@code {
    [Parameter] public Guid UserId   { get; set; }
    [Parameter] public Guid TenantId { get; set; }

    private bool                _loading  = true;
    private List<UserSessionDto> _sessions = [];

    protected override async Task OnInitializedAsync()
    {
        await EnsureTenantContextAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Api.SearchUserSessionsAsync(TenantId, userId: UserId);
            _sessions = result?.Items.ToList() ?? [];
        }
        catch { /* non-critical, silently fail */ }
        finally { _loading = false; }
    }

    private async Task EnsureTenantContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        if (TenantId == Guid.Empty) TenantId = context.TenantId;
    }
}
