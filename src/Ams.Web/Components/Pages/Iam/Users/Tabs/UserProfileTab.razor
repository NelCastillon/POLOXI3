@inject ApiClient Api

<div class="tab-section">
    @if (User is null)
    {
        <div class="ts-empty"><i class="bi bi-person-x" aria-hidden="true"></i> No profile data.</div>
    }
    else if (!_editing)
    {
        <!-- ── Profile Header ──────────────────────────────── -->
        <div class="up-header">
            <div class="up-ident">
                <div class="up-avatar" style="@AvatarBg(User.FullName)" aria-hidden="true">@Initials(User.FullName)</div>
                <div class="up-ident-text">
                    <div class="up-name">@User.FullName</div>
                    <div class="up-meta">
                        @if (!string.IsNullOrEmpty(User.JobTitle))
                        {
                            <span>@User.JobTitle</span>
                        }
                        @if (!string.IsNullOrEmpty(User.Department))
                        {
                            <span class="up-meta-sep" aria-hidden="true">·</span>
                            <span>@User.Department</span>
                        }
                        <span class="badge @TypeBadgeClass(User.UserTypeCode)">@User.UserTypeCode</span>
                    </div>
                </div>
            </div>
            <SfButton IsPrimary="true" IconCss="bi bi-pencil" @onclick="OpenEdit">Edit Profile</SfButton>
        </div>

        <!-- ── Info Cards ──────────────────────────────────── -->
        <div class="up-cards">

            <!-- Identity -->
            <div class="up-card">
                <div class="up-card-hdr">
                    <i class="bi bi-person-vcard-fill" aria-hidden="true"></i> Identity
                </div>
                <div class="up-card-body">
                    <div class="up-field">
                        <i class="bi bi-person" aria-hidden="true"></i>
                        <span class="up-fl">Full Name</span>
                        <span class="up-fv">@User.FullName</span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-tag" aria-hidden="true"></i>
                        <span class="up-fl">Display Name</span>
                        <span class="up-fv">@(User.DisplayName ?? "—")</span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-at" aria-hidden="true"></i>
                        <span class="up-fl">Username</span>
                        <span class="up-fv"><code>@User.UserName</code></span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <span class="up-fl">Email</span>
                        <span class="up-fv"><a href="mailto:@User.Email">@User.Email</a></span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-telephone" aria-hidden="true"></i>
                        <span class="up-fl">Phone</span>
                        <span class="up-fv">@(User.PhoneNumber ?? "—")</span>
                    </div>
                </div>
            </div>

            <!-- Organization -->
            <div class="up-card">
                <div class="up-card-hdr">
                    <i class="bi bi-building" aria-hidden="true"></i> Organization
                </div>
                <div class="up-card-body">
                    <div class="up-field">
                        <i class="bi bi-person-badge" aria-hidden="true"></i>
                        <span class="up-fl">User Type</span>
                        <span class="up-fv"><span class="badge @TypeBadgeClass(User.UserTypeCode)">@User.UserTypeCode</span></span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-briefcase" aria-hidden="true"></i>
                        <span class="up-fl">Job Title</span>
                        <span class="up-fv">@(User.JobTitle ?? "—")</span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-diagram-3" aria-hidden="true"></i>
                        <span class="up-fl">Department</span>
                        <span class="up-fv">@(User.Department ?? "—")</span>
                    </div>
                </div>
            </div>

            <!-- Localization -->
            <div class="up-card">
                <div class="up-card-hdr">
                    <i class="bi bi-globe" aria-hidden="true"></i> Localization
                </div>
                <div class="up-card-body">
                    <div class="up-field">
                        <i class="bi bi-clock" aria-hidden="true"></i>
                        <span class="up-fl">Time Zone</span>
                        <span class="up-fv">@(User.TimeZoneCode ?? "UTC")</span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-translate" aria-hidden="true"></i>
                        <span class="up-fl">Locale</span>
                        <span class="up-fv">@(User.LocaleCode ?? "en-US")</span>
                    </div>
                </div>
            </div>

            <!-- Contact -->
            <div class="up-card">
                <div class="up-card-hdr">
                    <i class="bi bi-telephone-fill" aria-hidden="true"></i> Contact
                </div>
                <div class="up-card-body">
                    <div class="up-field">
                        <i class="bi bi-phone" aria-hidden="true"></i>
                        <span class="up-fl">Mobile</span>
                        <span class="up-fv">@(Profile?.MobileNumber ?? "—")</span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-image" aria-hidden="true"></i>
                        <span class="up-fl">Avatar URL</span>
                        <span class="up-fv">
                            @if (!string.IsNullOrEmpty(Profile?.AvatarUrl))
                            {
                                <a href="@Profile.AvatarUrl" target="_blank" rel="noopener" class="up-link">@Profile.AvatarUrl</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </span>
                    </div>
                </div>
            </div>

            <!-- Address -->
            <div class="up-card">
                <div class="up-card-hdr">
                    <i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Address
                </div>
                <div class="up-card-body">
                    <div class="up-field">
                        <i class="bi bi-signpost-2" aria-hidden="true"></i>
                        <span class="up-fl">Line 1</span>
                        <span class="up-fv">@(Profile?.AddressLine1 ?? "—")</span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-signpost" aria-hidden="true"></i>
                        <span class="up-fl">Line 2</span>
                        <span class="up-fv">@(Profile?.AddressLine2 ?? "—")</span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-buildings" aria-hidden="true"></i>
                        <span class="up-fl">City</span>
                        <span class="up-fv">@(Profile?.City ?? "—")</span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-map" aria-hidden="true"></i>
                        <span class="up-fl">State / Province</span>
                        <span class="up-fv">@(Profile?.StateProvince ?? "—")</span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-mailbox" aria-hidden="true"></i>
                        <span class="up-fl">Postal Code</span>
                        <span class="up-fv">@(Profile?.PostalCode ?? "—")</span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-flag" aria-hidden="true"></i>
                        <span class="up-fl">Country</span>
                        <span class="up-fv">@(Profile?.CountryCode ?? "—")</span>
                    </div>
                </div>
            </div>

            <!-- Emergency Contact -->
            <div class="up-card">
                <div class="up-card-hdr">
                    <i class="bi bi-heart-pulse-fill" aria-hidden="true"></i> Emergency Contact
                </div>
                <div class="up-card-body">
                    <div class="up-field">
                        <i class="bi bi-person-lines-fill" aria-hidden="true"></i>
                        <span class="up-fl">Name</span>
                        <span class="up-fv">@(Profile?.EmergencyContactName ?? "—")</span>
                    </div>
                    <div class="up-field">
                        <i class="bi bi-telephone" aria-hidden="true"></i>
                        <span class="up-fl">Phone</span>
                        <span class="up-fv">@(Profile?.EmergencyContactPhone ?? "—")</span>
                    </div>
                </div>
            </div>

            <!-- System Record (full-width) -->
            <div class="up-card up-card--full">
                <div class="up-card-hdr">
                    <i class="bi bi-database-fill" aria-hidden="true"></i> System Record
                </div>
                <div class="up-card-body">
                    <div class="up-record-row">
                        <div class="up-field">
                            <i class="bi bi-calendar-plus" aria-hidden="true"></i>
                            <span class="up-fl">Created</span>
                            <span class="up-fv">@User.CreatedDateUtc.ToString("f")</span>
                        </div>
                        <div class="up-field">
                            <i class="bi bi-calendar-check" aria-hidden="true"></i>
                            <span class="up-fl">Last Modified</span>
                            <span class="up-fv">@(User.ModifiedDateUtc?.ToString("f") ?? "—")</span>
                        </div>
                        <div class="up-field">
                            <i class="bi bi-building-lock" aria-hidden="true"></i>
                            <span class="up-fl">Tenant ID</span>
                            <span class="up-fv"><code class="ts-id">@User.TenantId</code></span>
                        </div>
                        <div class="up-field">
                            <i class="bi bi-fingerprint" aria-hidden="true"></i>
                            <span class="up-fl">User ID</span>
                            <span class="up-fv"><code class="ts-id">@User.UserId</code></span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }
    else
    {
        <div class="ts-edit-form">
            <div class="form-row">
                <div class="form-group">
                    <label>Full Name <span class="req" aria-hidden="true">*</span></label>
                    <SfTextBox @bind-Value="_form.FullName" Placeholder="John Doe" />
                </div>
                <div class="form-group">
                    <label>Display Name</label>
                    <SfTextBox @bind-Value="_form.DisplayName" Placeholder="Optional" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Phone Number</label>
                    <SfTextBox @bind-Value="_form.PhoneNumber" Placeholder="+1 555 000 0000" />
                </div>
                <div class="form-group">
                    <label>Job Title</label>
                    <SfTextBox @bind-Value="_form.JobTitle" Placeholder="Software Engineer" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Department</label>
                    <SfTextBox @bind-Value="_form.Department" Placeholder="Engineering" />
                </div>
                <div class="form-group"></div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Mobile Number</label>
                    <SfTextBox @bind-Value="_form.MobileNumber" Placeholder="+1 555 000 0000" Type="InputType.Tel" />
                </div>
                <div class="form-group">
                    <label>Avatar URL <span class="pf-optional">(optional)</span></label>
                    <SfTextBox @bind-Value="_form.AvatarUrl" Placeholder="https://…" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Address Line 1</label>
                    <SfTextBox @bind-Value="_form.AddressLine1" Placeholder="Street address" />
                </div>
                <div class="form-group">
                    <label>Address Line 2 <span class="pf-optional">(optional)</span></label>
                    <SfTextBox @bind-Value="_form.AddressLine2" Placeholder="Suite, unit, etc." />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>City</label>
                    <SfTextBox @bind-Value="_form.City" Placeholder="City" />
                </div>
                <div class="form-group">
                    <label>State / Province</label>
                    <SfTextBox @bind-Value="_form.StateProvince" Placeholder="State or province" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Postal Code</label>
                    <SfTextBox @bind-Value="_form.PostalCode" Placeholder="00000" />
                </div>
                <div class="form-group">
                    <label>Country Code</label>
                    <SfTextBox @bind-Value="_form.CountryCode" Placeholder="US" />
                    <span class="field-hint">2-letter ISO country code (e.g. US, GB, AU)</span>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Emergency Contact Name</label>
                    <SfTextBox @bind-Value="_form.EmergencyContactName" Placeholder="Full name" />
                </div>
                <div class="form-group">
                    <label>Emergency Contact Phone</label>
                    <SfTextBox @bind-Value="_form.EmergencyContactPhone" Placeholder="+1 555 000 0000" Type="InputType.Tel" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="form-alert" role="alert">
                    <i class="bi bi-exclamation-circle" aria-hidden="true"></i> @_error
                </div>
            }
            <div class="ts-edit-actions">
                <SfButton CssClass="e-outline" @onclick="CancelEdit">Cancel</SfButton>
                <SfButton IsPrimary="true" @onclick="SaveAsync" Disabled="@_saving">
                    @if (_saving) { <span class="ts-spin" aria-hidden="true"></span> }
                    Save Changes
                </SfButton>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public UserDto?        User          { get; set; }
    [Parameter] public Guid            TenantId      { get; set; }
    [Parameter] public UserProfileDto? Profile       { get; set; }
    [Parameter] public EventCallback   OnUserUpdated { get; set; }

    private bool   _editing;
    private bool   _saving;
    private string _error = string.Empty;
    private PForm  _form  = new();

    private void OpenEdit()
    {
        if (User is null) return;
        _form = new PForm
        {
            FullName              = User.FullName,
            DisplayName           = User.DisplayName,
            PhoneNumber           = User.PhoneNumber,
            JobTitle              = User.JobTitle,
            Department            = User.Department,
            MobileNumber          = Profile?.MobileNumber,
            AvatarUrl             = Profile?.AvatarUrl,
            AddressLine1          = Profile?.AddressLine1,
            AddressLine2          = Profile?.AddressLine2,
            City                  = Profile?.City,
            StateProvince         = Profile?.StateProvince,
            PostalCode            = Profile?.PostalCode,
            CountryCode           = Profile?.CountryCode,
            EmergencyContactName  = Profile?.EmergencyContactName,
            EmergencyContactPhone = Profile?.EmergencyContactPhone,
        };
        _error   = string.Empty;
        _editing = true;
    }

    private void CancelEdit() { _editing = false; _error = string.Empty; }

    private async Task SaveAsync()
    {
        if (User is null || _saving) return;
        if (string.IsNullOrWhiteSpace(_form.FullName)) { _error = "Full Name is required."; return; }
        _saving = true;
        try
        {
            await Api.UpdateUserAsync(User.UserId, new UpdateUserRequest
            {
                UserId       = User.UserId,
                FullName     = _form.FullName.Trim(),
                DisplayName  = _form.DisplayName?.Trim(),
                PhoneNumber  = _form.PhoneNumber?.Trim(),
                JobTitle     = _form.JobTitle?.Trim(),
                Department   = _form.Department?.Trim(),
                TimeZoneCode = User.TimeZoneCode,
                LocaleCode   = User.LocaleCode,
            });
            var profileReq = CurrentProfileRequest();
            profileReq.MobileNumber          = _form.MobileNumber?.Trim();
            profileReq.AvatarUrl             = string.IsNullOrWhiteSpace(_form.AvatarUrl) ? null : _form.AvatarUrl.Trim();
            profileReq.AddressLine1          = _form.AddressLine1?.Trim();
            profileReq.AddressLine2          = _form.AddressLine2?.Trim();
            profileReq.City                  = _form.City?.Trim();
            profileReq.StateProvince         = _form.StateProvince?.Trim();
            profileReq.PostalCode            = _form.PostalCode?.Trim();
            profileReq.CountryCode           = _form.CountryCode?.Trim();
            profileReq.EmergencyContactName  = _form.EmergencyContactName?.Trim();
            profileReq.EmergencyContactPhone = _form.EmergencyContactPhone?.Trim();
            await Api.UpdateUserProfileAsync(User.UserId, profileReq);
            _editing = false;
            await OnUserUpdated.InvokeAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private UpdateUserProfileRequest CurrentProfileRequest() => new()
    {
        UserId                = User!.UserId,
        PhoneNumber           = Profile?.PhoneNumber,
        MobileNumber          = Profile?.MobileNumber,
        CountryCode           = Profile?.CountryCode,
        AddressLine1          = Profile?.AddressLine1,
        AddressLine2          = Profile?.AddressLine2,
        City                  = Profile?.City,
        StateProvince         = Profile?.StateProvince,
        PostalCode            = Profile?.PostalCode,
        AvatarUrl             = Profile?.AvatarUrl,
        EmergencyContactName  = Profile?.EmergencyContactName,
        EmergencyContactPhone = Profile?.EmergencyContactPhone,
    };

    private static string TypeBadgeClass(string t) => t.ToLowerInvariant() switch
    {
        "internal" => "badge-blue",
        "external" => "badge-neutral",
        "service"  => "badge-amber",
        "system"   => "badge-red",
        _          => "badge-neutral",
    };

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                          .Take(2).Select(w => char.ToUpperInvariant(w[0])));

    private static readonly string[] _avatarColors =
        ["#3b82f6", "#8b5cf6", "#10b981", "#f59e0b", "#ef4444", "#06b6d4", "#6366f1", "#ec4899"];

    private static string AvatarBg(string name)
    {
        var idx = Math.Abs(name.GetHashCode()) % _avatarColors.Length;
        return $"background:{_avatarColors[idx]}";
    }

    private sealed class PForm
    {
        public string  FullName              { get; set; } = string.Empty;
        public string? DisplayName           { get; set; }
        [AmsPhone]
        public string? PhoneNumber           { get; set; }
        public string? JobTitle              { get; set; }
        public string? Department            { get; set; }
        [AmsPhone]
        public string? MobileNumber          { get; set; }
        public string? AvatarUrl             { get; set; }
        public string? AddressLine1          { get; set; }
        public string? AddressLine2          { get; set; }
        public string? City                  { get; set; }
        public string? StateProvince         { get; set; }
        public string? PostalCode            { get; set; }
        public string? CountryCode           { get; set; }
        public string? EmergencyContactName  { get; set; }
        [AmsPhone]
        public string? EmergencyContactPhone { get; set; }
    }
}
