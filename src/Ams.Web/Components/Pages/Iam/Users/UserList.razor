    private bool _showDisable = false;
    private bool _showEnable  = false;
    private bool _showUnlock  = false;
    private bool _showBulk    = false;
    private bool _showInvite       = false;
    private bool _showResetMfaDlg  = false;
    private bool _showBranchAssign = false;
    private bool _showTeamAssign   = false;
    private bool _showRoleAssign   = false;

    // ── Active targets ────────────────────────────────────────────────────────────
    private Guid?    _editUserId;
    private UserDto? _actionTarget = null;
    private string   _bulkAction   = "Disable";

    // ── Invite ─────────────────────────────────────────────────────────────────────────────────
    private string _inviteEmail    = string.Empty;
    private string _inviteRoleCode = string.Empty;

    // ── Assignment fields ────────────────────────────────────────────────────────────────
    private string _assignBranchCode = string.Empty;
    private string _assignTeamCode   = string.Empty;
    private string _assignRoleCode   = string.Empty;

    // ── Chip lists ───────────────────────────────────────────────────────────────────────
    private List<string> _userRoleChips = [];
    private List<string> _userTeamChips = [];

    // ── Filters ───────────────────────────────────────────────────────────────────
    private string _search          = string.Empty;
    private string _filterStatus    = string.Empty;
    private string _filterRoleCode  = string.Empty;
    private string _filterDept      = string.Empty;
    private string _filterBranchCode = string.Empty;
    private string _filterMfa       = string.Empty;
    private bool   _filterLocked    = false;
    private bool   _filterInactive  = false;

    // ── KPI filter state ─────────────────────────────────────────────────────────
    private int _kpiActive = 0; // 0=none 1=total 2=active 3=locked 4=mfa

    private string KpiClass1 => "ul-kpi-card ul-kpi-card--total"        + (_kpiActive == 1 ? " ul-kpi-card--active" : "");
    private string KpiClass2 => "ul-kpi-card ul-kpi-card--active-users" + (_kpiActive == 2 ? " ul-kpi-card--active" : "");
    private string KpiClass3 => "ul-kpi-card ul-kpi-card--locked"       + (_kpiActive == 3 ? " ul-kpi-card--active" : "");
    private string KpiClass4 => "ul-kpi-card ul-kpi-card--mfa"          + (_kpiActive == 4 ? " ul-kpi-card--active" : "");

    // ── KPI counters ──────────────────────────────────────────────────────────────
    private int _totalCount;
    private int _activeCount;
    private int _lockedCount;
    private int _mfaCount;

    // ── Static options ────────────────────────────────────────────────────────────
    private static readonly List<LabelValue> _statusOptions =
    [
        new("Active",   "Active"),
        new("Inactive", "Inactive"),
        new("Pending",  "Pending"),
    ];

    private static readonly List<LabelValue> _mfaOptions =
    [
        new("Enabled",  "Enabled"),
        new("Disabled", "Disabled"),
    ];

    private static readonly List<LabelValue> _userTypeOptions =
    [
        new("Internal", "Internal"),
        new("External", "External"),
        new("Service",  "Service"),
    ];

    private static readonly List<LabelValue> _bulkActionOptions =
    [
        new("Disable", "Disable"),
        new("Enable",  "Enable"),
        new("Unlock",  "Unlock"),
    ];

    // ── Team options (placeholder) ──────────────────────────────────────────────────────────────
    private static readonly List<LabelValue> _teamOptions =
    [
        // TODO: replace with Api.SearchTeamsAsync
        new("Sales",      "Sales"),
        new("Operations", "Operations"),
        new("Support",    "Support"),
        new("Finance",    "Finance"),
    ];

    private List<LabelValue> _deptOptions = [];

    // ── Lifecycle ─────────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",  "/"),
            new("IAM",   "/iam"),
            new("Users", "/iam/users"));

        await Task.WhenAll(LoadRolesAsync(), LoadBranchesAsync());
        await LoadAsync();
    }

    // ── Data loading ──────────────────────────────────────────────────────────────
    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var result = await Api.SearchUsersAsync(_tenantId, _search);
            _allUsers = result?.Items.ToList() ?? [];
            _selected.Clear();

            _deptOptions = _allUsers
                .Where(u => !string.IsNullOrWhiteSpace(u.Department))
                .Select(u => u.Department!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(d => d)
                .Select(d => new LabelValue(d, d))
                .ToList();

            ComputeKpi();
            ApplyFilters();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchAsync(string _) => await LoadAsync();

    private async Task LoadRolesAsync()
    {
        var result = await Api.SearchRolesAsync(_tenantId);
        _roles = result?.Items.ToList() ?? [];
    }

    private async Task LoadBranchesAsync()
    {
        var result = await Api.SearchBranchesAsync(_tenantId);
        _branches = result?.Items.ToList() ?? [];
    }

    private void ApplyFilters()
    {
        _users = _allUsers.Where(u =>
            (string.IsNullOrEmpty(_filterStatus)     || u.StatusCode == _filterStatus) &&
            (string.IsNullOrEmpty(_filterDept)       || string.Equals(u.Department, _filterDept, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(_filterBranchCode) || _branches.FirstOrDefault(b => b.BranchId == u.BranchId)?.BranchCode == _filterBranchCode) &&
            (string.IsNullOrEmpty(_filterMfa)        || (u.MfaEnabled ? "Enabled" : "Disabled") == _filterMfa) &&
            (!_filterLocked   || u.IsLockedOut) &&
            (!_filterInactive || u.StatusCode != "Active")
            // Role filter requires server-side support (UserDto has no role assignment list)
        ).ToList();
        StateHasChanged();
    }

    private void SetKpiFilter(int n)
    {
        _kpiActive       = _kpiActive == n ? 0 : n;
        _filterStatus    = string.Empty;
        _filterLocked    = false;
        _filterMfa       = string.Empty;
        switch (_kpiActive)
        {
            case 2: _filterStatus = "Active";  break;
            case 3: _filterLocked = true;       break;
            case 4: _filterMfa    = "Enabled"; break;
        }
        ApplyFilters();
    }

    private void ComputeKpi()
    {
        _totalCount  = _allUsers.Count;
        _activeCount = _allUsers.Count(u => u.StatusCode == "Active");
        _lockedCount = _allUsers.Count(u => u.IsLockedOut);
        _mfaCount    = _allUsers.Count(u => u.MfaEnabled);
    }

