    // ── Helpers ───────────────────────────────────────────────────────────────────
    private static string Initials(UserDto u)
    {
        var parts = u.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}"
            : u.FullName.Length >= 1 ? u.FullName[..1] : "?";
    }

    private static string AvatarStyle(UserDto u)
    {
        var hue = Math.Abs(u.UserId.GetHashCode()) % 360;
        return $"background:hsl({hue},55%,42%);color:#fff;";
    }

    private static string FormatRelative(DateTime? dt)
    {
        if (dt is null) return "Never";
        var diff = DateTime.UtcNow - dt.Value;
        return diff.TotalDays switch
        {
            < 1   => diff.TotalHours < 1 ? "Just now" : $"{(int)diff.TotalHours}h ago",
            < 7   => $"{(int)diff.TotalDays}d ago",
            < 30  => $"{(int)(diff.TotalDays / 7)}w ago",
            < 365 => $"{(int)(diff.TotalDays / 30)}mo ago",
            _     => dt.Value.ToString("d"),
        };
    }

