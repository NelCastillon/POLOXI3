@page "/iam/users"
@page "/admin/users"
@using Syncfusion.Blazor.Buttons
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Users — IAM</PageTitle>

<AppPageHeader Title="Users"
               Subtitle="Master user registry — manage accounts, access and security"
               Icon="bi-people">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" title="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-ghost" @onclick="ExportAsync">
            <i class="bi bi-download" aria-hidden="true"></i> Export
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-person-plus" aria-hidden="true"></i> New User
        </button>
        <button class="um-btn um-btn-secondary" @onclick="OpenInvite">
            <i class="bi bi-envelope-plus" aria-hidden="true"></i> Invite
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="ul-kpi-strip">
    <div class="@KpiClass1" @onclick="() => SetKpiFilter(1)" role="button" tabindex="0" aria-label="Filter: Total Users">
        <span class="ul-kpi-icon ul-kpi-icon--total"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
        <div>
            <div class="ul-kpi-value">@_totalCount</div>
            <div class="ul-kpi-label">Total Users</div>
        </div>
        @if (_kpiActive == 1)
        {
            <span class="ul-kpi-active-dot" aria-hidden="true"></span>
        }
    </div>
    <div class="@KpiClass2" @onclick="() => SetKpiFilter(2)" role="button" tabindex="0" aria-label="Filter: Active">
        <span class="ul-kpi-icon ul-kpi-icon--active"><i class="bi bi-person-check-fill" aria-hidden="true"></i></span>
        <div>
            <div class="ul-kpi-value">@_activeCount</div>
            <div class="ul-kpi-label">Active</div>
        </div>
        @if (_kpiActive == 2)
        {
            <span class="ul-kpi-active-dot" aria-hidden="true"></span>
        }
    </div>
    <div class="@KpiClass3" @onclick="() => SetKpiFilter(3)" role="button" tabindex="0" aria-label="Filter: Locked Out">
        <span class="ul-kpi-icon ul-kpi-icon--locked"><i class="bi bi-lock-fill" aria-hidden="true"></i></span>
        <div>
            <div class="ul-kpi-value">@_lockedCount</div>
            <div class="ul-kpi-label">Locked Out</div>
        </div>
        @if (_kpiActive == 3)
        {
            <span class="ul-kpi-active-dot" aria-hidden="true"></span>
        }
    </div>
    <div class="@KpiClass4" @onclick="() => SetKpiFilter(4)" role="button" tabindex="0" aria-label="Filter: MFA Enabled">
        <span class="ul-kpi-icon ul-kpi-icon--mfa"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
        <div>
            <div class="ul-kpi-value">@_mfaCount</div>
            <div class="ul-kpi-label">MFA Enabled</div>
        </div>
        @if (_kpiActive == 4)
        {
            <span class="ul-kpi-active-dot" aria-hidden="true"></span>
        }
    </div>
</div>

<!-- Filter toolbar -->
<AppFilterPanel @bind-SearchValue="_search"
                OnSearch="OnSearchAsync"
                SearchPlaceholder="Search name, email or username…">
    <Filters>
        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_statusOptions"
                        Placeholder="All Statuses"
                        ShowClearButton="true"
                        Width="160px"
                        Value="_filterStatus"
                        ValueChanged="@((string v) => { _filterStatus = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>

        <SfDropDownList TValue="string" TItem="RoleDto"
                        DataSource="_roles"
                        Placeholder="All Roles"
                        ShowClearButton="true"
                        Width="160px"
                        Value="_filterRoleCode"
                        ValueChanged="@((string v) => { _filterRoleCode = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="RoleCode" Text="RoleName" />
        </SfDropDownList>

        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_deptOptions"
                        Placeholder="All Departments"
                        ShowClearButton="true"
                        Width="180px"
                        Value="_filterDept"
                        ValueChanged="@((string v) => { _filterDept = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>

        <SfDropDownList TValue="string" TItem="BranchDto"
                        DataSource="_branches"
                        Placeholder="All Branches"
                        ShowClearButton="true"
                        Width="160px"
                        Value="_filterBranchCode"
                        ValueChanged="@((string v) => { _filterBranchCode = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="BranchCode" Text="BranchName" />
        </SfDropDownList>

        <SfDropDownList TValue="string" TItem="LabelValue"
                        DataSource="_mfaOptions"
                        Placeholder="All MFA"
                        ShowClearButton="true"
                        Width="140px"
                        Value="_filterMfa"
                        ValueChanged="@((string v) => { _filterMfa = v; ApplyFilters(); })">
            <DropDownListFieldSettings Value="Value" Text="Label" />
        </SfDropDownList>

        <label class="ul-toggle-label">
            <input type="checkbox" @bind="_filterLocked" @bind:after="ApplyFilters" />
            Locked only
        </label>

        <label class="ul-toggle-label">
            <input type="checkbox" @bind="_filterInactive" @bind:after="ApplyFilters" />
            Inactive only
        </label>
    </Filters>
    <Actions>
        @if (_selected.Count > 0)
        {
            <span class="ul-sel-count"><i class="bi bi-check2-square" aria-hidden="true"></i> @_selected.Count selected</span>

            <button class="um-btn um-btn-sm um-btn-ghost"
                    @onclick="() => OpenEdit(_selected[0])"
                    disabled="@(_selected.Count != 1)"
                    title="Edit user">
                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
            </button>

            <button class="um-btn um-btn-sm um-btn-ghost"
                    @onclick="ViewSelectedUser"
                    disabled="@(_selected.Count != 1)"
                    title="View user detail">
                <i class="bi bi-eye" aria-hidden="true"></i> View
            </button>

            <button class="um-btn um-btn-sm um-btn-warning"
                    @onclick="() => OpenDisable(_selected[0])"
                    disabled="@(_selected.Count != 1 || _selected[0].StatusCode != "Active")"
                    title="Deactivate user">
                <i class="bi bi-person-dash" aria-hidden="true"></i> Deactivate
            </button>

            <button class="um-btn um-btn-sm um-btn-primary"
                    @onclick="() => OpenEnable(_selected[0])"
                    disabled="@(_selected.Count != 1 || _selected[0].StatusCode == "Active")"
                    title="Enable user">
                <i class="bi bi-person-check" aria-hidden="true"></i> Enable
            </button>

            <button class="um-btn um-btn-sm um-btn-ghost"
                    @onclick="() => OpenUnlock(_selected[0])"
                    disabled="@(_selected.Count != 1 || !_selected[0].IsLockedOut)"
                    title="Unlock account">
                <i class="bi bi-unlock" aria-hidden="true"></i> Unlock
            </button>

            <button class="um-btn um-btn-sm um-btn-ghost"
                    @onclick="ResetMfaAsync"
                    disabled="@(_selected.Count != 1)"
                    title="Reset MFA">
                <i class="bi bi-shield-x" aria-hidden="true"></i> Reset MFA
            </button>

            <button class="um-btn um-btn-sm um-btn-ghost"
                    @onclick="RevokeSessionsAsync"
                    disabled="@(_selected.Count != 1)"
                    title="Revoke active sessions">
                <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Revoke Sessions
            </button>

            <button class="um-btn um-btn-sm um-btn-secondary"
                    @onclick="OpenBulk"
                    disabled="@(_selected.Count < 2)"
                    title="Bulk update selected users">
                <i class="bi bi-collection" aria-hidden="true"></i> Bulk Update
            </button>

            <span class="ul-sel-sep" aria-hidden="true"></span>

            <button class="um-btn um-btn-sm um-btn-ghost"
                    @onclick="() => OpenBranchAssign(_selected[0])"
                    disabled="@(_selected.Count != 1)"
                    title="Assign branch">
                <i class="bi bi-building" aria-hidden="true"></i> Branch
            </button>
            <button class="um-btn um-btn-sm um-btn-ghost"
                    @onclick="() => OpenTeamAssign(_selected[0])"
                    disabled="@(_selected.Count != 1)"
                    title="Assign team">
                <i class="bi bi-people" aria-hidden="true"></i> Team
            </button>
            <button class="um-btn um-btn-sm um-btn-ghost"
                    @onclick="() => OpenRoleAssign(_selected[0])"
                    disabled="@(_selected.Count != 1)"
                    title="Assign role">
                <i class="bi bi-person-badge" aria-hidden="true"></i> Role
            </button>
        }
    </Actions>
</AppFilterPanel>

<!-- Grid -->
<div class="um-grid-card app-datagrid">
    @if (_loading)
    {
        <div class="um-loading-overlay" aria-live="polite" aria-label="Loading users…">
            <div class="um-spinner" aria-hidden="true"></div>
            <span>Loading users…</span>
        </div>
    }
    <SfGrid @ref="_grid"
            TValue="UserDto"
            DataSource="@_users"
            AllowPaging="true"
            AllowSorting="true"
            EnableHover="true"
            RowHeight="52">
        <GridPageSettings PageSize="25" PageSizes="@(new int[] { 10, 25, 50, 100 })" />
        <GridSelectionSettings Mode="Syncfusion.Blazor.Grids.SelectionMode.Row" Type="Syncfusion.Blazor.Grids.SelectionType.Multiple" />
        <GridEvents TValue="UserDto"
                    RowSelected="OnRowSelected"
                    RowDeselected="OnRowDeselected" />
        <GridColumns>
            <GridColumn Type="ColumnType.CheckBox" Width="48" />

            <GridColumn Field="@nameof(UserDto.UserName)"
                        HeaderText="Username"
                        Width="150" />

            <GridColumn Field="@nameof(UserDto.FullName)"
                        HeaderText="User"
                        Width="220">
                <Template>
                    @{
                        var u = (UserDto)context;
                    }
                    <div class="ul-user-cell">
                        <span class="ul-avatar" style="@AvatarStyle(u)" aria-hidden="true">
                            @Initials(u)
                        </span>
                        <div class="ul-user-info">
                            <div class="ul-user-name">@u.FullName</div>
                            <div class="ul-user-email">@u.Email</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(UserDto.StatusCode)"
                        HeaderText="Status"
                        Width="140">
                <Template>
                    @{
                        var u = (UserDto)context;
                    }
                    <div class="ul-status-cell">
                        <AppStatusBadge Status="@u.StatusCode" />
                        @if (u.IsLockedOut)
                        {
                            <span class="badge badge-amber" title="Account is locked out">
                                <i class="bi bi-lock-fill" aria-hidden="true"></i> Locked
                            </span>
                        }
                    </div>
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(UserDto.MfaEnabled)"
                        HeaderText="MFA"
                        Width="80"
                        TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var u = (UserDto)context;
                    }
                    <SfSwitch TChecked="bool" Checked="@u.MfaEnabled" Disabled="true"
                              CssClass="@(u.MfaEnabled ? "ul-mfa-switch-on" : "ul-mfa-switch-off")" />
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(UserDto.Department)"
                        HeaderText="Department"
                        Width="150" />

            <GridColumn Field="@nameof(UserDto.BranchId)"
                        HeaderText="Branch"
                        Width="130">
                <Template>
                    @{
                        var u = (UserDto)context;
                        var branch = _branches.FirstOrDefault(b => b.BranchId == u.BranchId);
                    }
                    <span>@(branch?.BranchName ?? "—")</span>
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(UserDto.LastLoginDateUtc)"
                        HeaderText="Last Login"
                        Width="130">
                <Template>
                    @{
                        var u = (UserDto)context;
                    }
                    <span title="@(u.LastLoginDateUtc?.ToString("g") ?? "Never")">
                        @FormatRelative(u.LastLoginDateUtc)
                    </span>
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(UserDto.AssignedRoleCount)"
                        HeaderText="Roles"
                        Width="80"
                        TextAlign="TextAlign.Center">
                <Template>
                    @{
                        var u = (UserDto)context;
                    }
                    <span class="um-count-pill">@u.AssignedRoleCount</span>
                </Template>
            </GridColumn>

            <GridColumn Field="@nameof(UserDto.CreatedDateUtc)"
                        HeaderText="Created"
                        Type="ColumnType.Date"
                        Format="d"
                        Width="120" />

            <GridColumn HeaderText=""
                        Width="110"
                        AllowSorting="false"
                        AllowFiltering="false">
                <Template>
                    @{
                        var u = (UserDto)context;
                    }
                    <div class="um-row-actions">
                        <button class="um-btn um-btn-xs um-btn-ghost"
                                @onclick="() => OpenEdit(u)"
                                title="Edit">
                            <i class="bi bi-pencil" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-xs um-btn-ghost"
                                @onclick="() => ViewUser(u)"
                                        title="View">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                        @if (u.StatusCode == "Active")
                        {
                            <button class="um-btn um-btn-xs um-btn-ghost"
                                    @onclick="() => OpenDisable(u)"
                                    title="Disable">
                                <i class="bi bi-person-dash" aria-hidden="true"></i>
                            </button>
                        }
                        else
                        {
                            <button class="um-btn um-btn-xs um-btn-ghost"
                                    @onclick="() => OpenEnable(u)"
                                    title="Enable">
                                <i class="bi bi-person-check" aria-hidden="true"></i>
                            </button>
                        }
                        @if (u.IsLockedOut)
                        {
                            <button class="um-btn um-btn-xs um-btn-ghost"
                                    @onclick="() => OpenUnlock(u)"
                                    title="Unlock">
                                <i class="bi bi-unlock" aria-hidden="true"></i>
                            </button>
                        }
                        <button class="um-btn um-btn-xs um-btn-ghost"
                                @onclick="() => OpenBranchAssign(u)"
                                title="Assign branch">
                            <i class="bi bi-building" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-xs um-btn-ghost"
                                @onclick="() => OpenRoleAssign(u)"
                                title="Assign role">
                            <i class="bi bi-person-badge" aria-hidden="true"></i>
                        </button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<!-- Create / Edit drawer -->
<UserEditDrawer @bind-Visible="_showDrawer"
                UserId="_editUserId"
                OnSaved="HandleUserSavedAsync" />

<!-- Disable confirmation -->
<AppConfirmActionDialog @bind-Visible="_showDisable"
                        Title="Disable User"
                        Message="@($"Disable {_actionTarget?.FullName}?")"
                        Detail="The user will no longer be able to sign in. You can re-enable them at any time."
                        Variant="warning"
                        ConfirmText="Disable"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteDisableAsync" />

<!-- Enable confirmation -->
<AppConfirmActionDialog @bind-Visible="_showEnable"
                        Title="Enable User"
                        Message="@($"Enable {_actionTarget?.FullName}?")"
                        Detail="The user will regain sign-in access immediately."
                        Variant="primary"
                        ConfirmText="Enable"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteEnableAsync" />

<!-- Unlock confirmation -->
<AppConfirmActionDialog @bind-Visible="_showUnlock"
                        Title="Unlock Account"
                        Message="@($"Unlock account for {_actionTarget?.FullName}?")"
                        Detail="The lockout will be removed and the user can sign in again."
                        Variant="warning"
                        ConfirmText="Unlock"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteUnlockAsync" />

<!-- Bulk action dialog -->
<AppConfirmActionDialog @bind-Visible="_showBulk"
                        Title="Bulk Action"
                        Message="@($"Apply '{_bulkAction}' to {_selected.Count} selected users?")"
                        Detail="This will be applied to all selected users immediately."
                        Variant="warning"
                        ConfirmText="Apply"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteBulkAsync">
    <Body>
        <div class="form-row ul-bulk-action-row">
            <label class="form-label">Action</label>
            <SfDropDownList TValue="string" TItem="LabelValue"
                            DataSource="_bulkActionOptions"
                            @bind-Value="_bulkAction">
                <DropDownListFieldSettings Value="Value" Text="Label" />
            </SfDropDownList>
        </div>
    </Body>
</AppConfirmActionDialog>

<!-- ── Invite User dialog ──────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showInvite"
          Width="480px"
          IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <span class="ul-dlg-header">
                <i class="bi bi-envelope-plus" aria-hidden="true"></i> Invite User
            </span>
        </Header>
        <Content>
            <div class="ul-dlg-body">
                <div class="ul-dlg-info-banner">
                    <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                    <span>An invitation email will be sent to the specified address. The user must complete registration within 48 hours.</span>
                </div>
                <div class="form-row">
                    <label class="form-label">Email Address <span class="form-required">*</span></label>
                    <input type="email" class="form-control" @bind="_inviteEmail" placeholder="user@example.com" />
                </div>
                <div class="form-row">
                    <label class="form-label">Initial Role</label>
                    <SfDropDownList TValue="string" TItem="RoleDto"
                                    DataSource="_roles"
                                    @bind-Value="_inviteRoleCode"
                                    Placeholder="Select role…"
                                    ShowClearButton="true">
                        <DropDownListFieldSettings Value="RoleCode" Text="RoleName" />
                    </SfDropDownList>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="ul-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showInvite = false" disabled="@_confirming">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="ExecuteInviteAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_inviteEmail) || _confirming)">
                    @if (_confirming)
                    {
                        <span class="ul-spin"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></span>
                    }
                    else
                    {
                        <i class="bi bi-envelope-check" aria-hidden="true"></i>
                    }
                    Send Invitation
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ── Reset MFA dialog ────────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showResetMfaDlg"
          Width="440px"
          IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <span class="ul-dlg-header">
                <i class="bi bi-shield-x" aria-hidden="true"></i> Reset MFA
            </span>
        </Header>
        <Content>
            <div class="ul-dlg-body">
                <div class="ul-dlg-warning-banner">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    <div>
                        <strong>Confirm MFA reset for @(_actionTarget?.FullName ?? "this user")</strong>
                        <p>All registered authenticator devices will be removed. The user will be required to re-enrol MFA at their next sign-in.</p>
                    </div>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="ul-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showResetMfaDlg = false" disabled="@_confirming">Cancel</button>
                <button class="um-btn um-btn-warning" @onclick="ExecuteResetMfaDialogAsync" disabled="@_confirming">
                    @if (_confirming)
                    {
                        <span class="ul-spin"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></span>
                    }
                    else
                    {
                        <i class="bi bi-shield-x" aria-hidden="true"></i>
                    }
                    Reset MFA
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ── Branch Assign dialog ────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showBranchAssign"
          Width="440px"
          IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <span class="ul-dlg-header">
                <i class="bi bi-building" aria-hidden="true"></i> Assign Branch
            </span>
        </Header>
        <Content>
            <div class="ul-dlg-body">
                <p class="ul-dlg-hint">Assign <strong>@(_actionTarget?.FullName ?? "this user")</strong> to a branch.</p>
                <div class="form-row">
                    <label class="form-label">Branch <span class="form-required">*</span></label>
                    <SfDropDownList TValue="string" TItem="BranchDto"
                                    DataSource="_branches"
                                    @bind-Value="_assignBranchCode"
                                    Placeholder="Select branch…">
                        <DropDownListFieldSettings Value="BranchCode" Text="BranchName" />
                    </SfDropDownList>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="ul-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showBranchAssign = false" disabled="@_confirming">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="ExecuteBranchAssignAsync"
                        disabled="@(string.IsNullOrEmpty(_assignBranchCode) || _confirming)">
                    @if (_confirming)
                    {
                        <span class="ul-spin"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                    }
                    Assign Branch
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ── Team Assign dialog ──────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showTeamAssign"
          Width="480px"
          IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <span class="ul-dlg-header">
                <i class="bi bi-people" aria-hidden="true"></i> Assign Team
            </span>
        </Header>
        <Content>
            <div class="ul-dlg-body">
                <p class="ul-dlg-hint">Manage team membership for <strong>@(_actionTarget?.FullName ?? "this user")</strong>.</p>
                @if (_userTeamChips.Count > 0)
                {
                    <div class="form-row">
                        <label class="form-label">Current Teams</label>
                        <SfChipList>
                            <ChipListChips>
                                @foreach (var team in _userTeamChips)
                                {
                                    <Chip Text="@team" />
                                }
                            </ChipListChips>
                        </SfChipList>
                    </div>
                }
                else
                {
                    <p class="ul-dlg-empty-hint">Not currently a member of any team.</p>
                }
                <div class="form-row">
                    <label class="form-label">Add to Team</label>
                    <SfDropDownList TValue="string" TItem="LabelValue"
                                    DataSource="_teamOptions"
                                    @bind-Value="_assignTeamCode"
                                    Placeholder="Select team…"
                                    ShowClearButton="true">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="ul-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showTeamAssign = false" disabled="@_confirming">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="ExecuteTeamAssignAsync"
                        disabled="@(string.IsNullOrEmpty(_assignTeamCode) || _confirming)">
                    @if (_confirming)
                    {
                        <span class="ul-spin"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                    }
                    Assign Team
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ── Role Assign dialog ──────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showRoleAssign"
          Width="520px"
          IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <span class="ul-dlg-header">
                <i class="bi bi-person-badge" aria-hidden="true"></i> Assign Role
            </span>
        </Header>
        <Content>
            <div class="ul-dlg-body">
                <p class="ul-dlg-hint">Manage roles for <strong>@(_actionTarget?.FullName ?? "this user")</strong>.</p>
                <div class="form-row">
                    <label class="form-label">Assigned Roles</label>
                    @if (_userRoleChips.Count > 0)
                    {
                        <SfChipList CssClass="ul-role-chips">
                            <ChipListChips>
                                @foreach (var role in _userRoleChips)
                                {
                                    <Chip Text="@role" />
                                }
                            </ChipListChips>
                        </SfChipList>
                    }
                    else
                    {
                        <p class="ul-dlg-empty-hint">No roles currently assigned.</p>
                    }
                </div>
                <div class="form-row">
                    <label class="form-label">Add Role</label>
                    <SfDropDownList TValue="string" TItem="RoleDto"
                                    DataSource="_roles"
                                    @bind-Value="_assignRoleCode"
                                    Placeholder="Select role…"
                                    ShowClearButton="true">
                        <DropDownListFieldSettings Value="RoleCode" Text="RoleName" />
                    </SfDropDownList>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="ul-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showRoleAssign = false" disabled="@_confirming">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="ExecuteRoleAssignAsync"
                        disabled="@(string.IsNullOrEmpty(_assignRoleCode) || _confirming)">
                    @if (_confirming)
                    {
                        <span class="ul-spin"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i></span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                    }
                    Add Role
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- Toast -->
<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@code {
    // ── Constants ─────────────────────────────────────────────────────────────────
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    // ── Refs ──────────────────────────────────────────────────────────────────────
    private SfGrid<UserDto>? _grid;
    private SfToast?         _toast;

    // ── Data ──────────────────────────────────────────────────────────────────────
    private List<UserDto>   _allUsers = [];
    private List<UserDto>   _users    = [];
    private List<UserDto>   _selected = [];
    private List<RoleDto>   _roles    = [];
    private List<BranchDto> _branches = [];

    // ── Loading / saving flags ────────────────────────────────────────────────────
    private bool _loading    = false;
