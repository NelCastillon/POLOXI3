            await Api.SetUserActiveAsync(_actionTarget.UserId, isActive: true);
            await ShowToastAsync($"{_actionTarget.FullName} has been enabled.", "e-toast-success");
            await LoadAsync();
        }
        catch (Exception ex) { await ShowToastAsync($"Error: {ex.Message}", "e-toast-danger"); }
        finally { _confirming = false; _actionTarget = null; }
    }

    private async Task ExecuteUnlockAsync()
    {
        if (_actionTarget is null) return;
        _confirming = true;
        try
        {
            await Api.UnlockUserAsync(_actionTarget.UserId);
