    private void ConfirmDelete(UserDto u) => OpenConfirm("Remove user access?", $"Deactivate {u.FullName} and revoke platform access?", "bi-trash3", true, () => DeleteAsync(u));
    private async Task DeleteAsync(UserDto u)
    {
        try { await Api.SetUserActiveAsync(u.UserId, false, _currentUserId); CloseConfirm(); ShowToast($"User '{u.FullName}' removed.", "use-toast--success"); await LoadAsync(); }
