@page "/users"
@page "/tenant/security/users"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>User Security Command Center - AMS</PageTitle>

<div class="use-page">
    <section class="use-hero">
        <div class="use-hero__content">
            <div class="use-hero-left">
                <span class="use-hero-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
                <div class="use-hero-title">
                    <div class="use-hero__eyebrow">Enterprise identity command center</div>
                    <div class="use-title-row">
                        <h1>User Security Command Center</h1>
                        <div class="use-hero__meta">
                            <span><i class="bi bi-people" aria-hidden="true"></i>@_users.Count users</span>
                            <span><i class="bi bi-exclamation-octagon" aria-hidden="true"></i>@_users.Count(IsHighRisk) high risk</span>
                            <span><i class="bi bi-shield-check" aria-hidden="true"></i>@_users.Count(u => u.MfaEnabled) MFA protected</span>
                            <span><i class="bi bi-lock" aria-hidden="true"></i>@_users.Count(u => u.IsLockedOut) locked</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Provision access, monitor identity risk, and run security workflows across every platform user.</p>
        </div>
        <div class="use-hero__actions">
            <button type="button" class="use-btn use-btn--light" @onclick="RefreshAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "use-spin" : null)" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="use-btn use-btn--primary" @onclick="OpenCreate">
                <i class="bi bi-person-plus" aria-hidden="true"></i> Create User
            </button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger use-alert" style="border-left: 4px solid #dc3545; animation: use-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="use-kpi-strip" aria-label="User security KPIs">
        @KpiCard("all", "Total Users", _users.Count.ToString(), "All users in this tenant", "bi-people", "blue")
        @KpiCard("active", "Active", _users.Count(IsActive).ToString(), "Users with enabled access", "bi-check-circle", "green")
        @KpiCard("risk", "High Risk", _users.Count(IsHighRisk).ToString(), "Locked, unprotected, stale, or role-gap users", "bi-exclamation-octagon", "red")
        @KpiCard("locked", "Locked", _users.Count(u => u.IsLockedOut).ToString(), "Accounts currently locked out", "bi-lock", "amber")
        @KpiCard("mfa", "MFA Disabled", _users.Count(u => !u.MfaEnabled).ToString(), "Users without MFA protection", "bi-shield-x", "purple")
        @KpiCard("stale", "Stale", _users.Count(IsStale).ToString(), "No login in 30+ days or never logged in", "bi-hourglass-bottom", "cyan")
    </section>

    <section class="use-workflows" aria-label="User workflows">
        @WorkflowButton("Security review", "Prioritize highest-risk identities", "bi-shield-exclamation", () => SetDashboardFocus("risk", "risk"))
        @WorkflowButton("Unlock queue", "Review locked-out users", "bi-unlock", () => SetDashboardFocus("locked", "risk"))
        @WorkflowButton("MFA enrollment", "Find users missing MFA", "bi-shield-plus", () => SetDashboardFocus("mfa", "risk"))
        @WorkflowButton("Dormant cleanup", "Audit stale identities", "bi-hourglass-split", () => SetDashboardFocus("stale", "login"))
        @WorkflowButton("Role gaps", "Find active users without roles", "bi-diagram-3", () => SetDashboardFocus("noroles", "risk"))
    </section>

    <section class="use-filter-panel" aria-label="User filters">
        <div class="use-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search"
                   placeholder="Search name, email, username, department, job title, or roles..."
                   aria-label="Search users"
                   value="@_searchTerm"
                   @oninput="OnSearchInput" />
        </div>
        <div class="use-filter-grid">
            <label>
                <span>Status</span>
                <select class="form-select" @bind="_statusFilter" @bind:after="ApplyFilters">
                    <option value="">All statuses</option>
                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </label>
            <label>
                <span>Type</span>
                <select class="form-select" @bind="_typeFilter" @bind:after="ApplyFilters">
                    <option value="">All types</option>
                    @foreach (var type in TypeOptions)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </label>
            <label>
                <span>Risk</span>
                <select class="form-select" @bind="_riskFilter" @bind:after="ApplyFilters">
                    <option value="">All risk levels</option>
                    <option value="Critical">Critical</option>
                    <option value="High">High</option>
                    <option value="Medium">Medium</option>
                    <option value="Low">Low</option>
                </select>
            </label>
            <label>
                <span>Sort</span>
                <select class="form-select" @bind="_sortMode" @bind:after="ApplyFilters">
                    <option value="risk">Risk / importance</option>
                    <option value="name">Name</option>
                    <option value="login">Last login</option>
                    <option value="created">Newest</option>
                    <option value="roles">Role coverage</option>
                </select>
            </label>
        </div>
        <button type="button" class="use-btn use-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)">
            <i class="bi bi-x-lg" aria-hidden="true"></i> Reset
        </button>
    </section>

    <nav class="use-tabs" aria-label="User views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="use-tab @(_activeTab == tab.Key ? "use-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </nav>

    <main class="use-dashboard">
        <section class="use-main-card">
            <div class="use-card-header">
                <div>
                    <span class="use-section-kicker">@ActiveViewTitle</span>
                    <h2>@FilteredUsers.Count() users</h2>
                    <p>Ranked by enterprise importance: lockout, MFA coverage, stale access, failed attempts, status, and roles.</p>
                </div>
                <div class="use-card-actions">
                    @if (_selectedUsers.Count > 0)
                    {
                        <span class="use-sel-count">@_selectedUsers.Count selected</span>
                        <button type="button" class="use-btn use-btn--ghost" @onclick="() => ConfirmBulkToggle(true)"><i class="bi bi-check-circle" aria-hidden="true"></i> Enable</button>
                        <button type="button" class="use-btn use-btn--ghost" @onclick="() => ConfirmBulkToggle(false)"><i class="bi bi-slash-circle" aria-hidden="true"></i> Disable</button>
                        <button type="button" class="use-btn use-btn--danger-ghost" @onclick="ConfirmBulkDelete"><i class="bi bi-trash3" aria-hidden="true"></i> Remove</button>
                    }
                    <button type="button" class="use-btn use-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Prev</button>
                    <span class="use-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="use-btn use-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="use-loading"><span class="use-spinner"></span> Loading users...</div>
            }
            else if (!FilteredUsers.Any())
            {
                <div class="use-empty">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <strong>No users found</strong>
                    <span>Adjust the active tab, KPI, search, or filters.</span>
                </div>
            }
            else if (_activeTab == "department")
            {
                <div class="use-dept-grid">
                    @foreach (var group in DepartmentGroups)
                    {
                        <article class="use-dept-card">
                            <div class="use-dept-icon"><i class="bi bi-building" aria-hidden="true"></i></div>
                            <div class="use-dept-meta">
                                <h3>@group.Name</h3>
                                <p>@group.Count users - @group.HighRisk high risk - @group.MfaOff MFA off</p>
                                <div class="use-mini-bar"><span style="width:@group.Percent%"></span></div>
                            </div>
                            <button type="button" class="use-btn use-btn--ghost" @onclick="() => FilterByDepartment(group.Name)">Open</button>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="use-table-wrap">
                    <table class="use-table">
                        <thead>
                            <tr>
                                <th class="use-check-col"><input type="checkbox" checked="@AllPageSelected" @onchange="ToggleSelectAllPage" aria-label="Select all users on page" /></th>
                                <th>Risk</th>
                                <th>User</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>MFA</th>
                                <th>Roles</th>
                                <th>Last Login</th>
                                <th>Created</th>
                                <th class="use-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in PagedUsers)
                            {
                                <tr class="@(_selected?.UserId == user.UserId ? "use-row use-row--selected" : "use-row")" @onclick="() => SelectRow(user)">
                                    <td class="use-check-col" @onclick:stopPropagation="true">
                                        <input type="checkbox" checked="@IsSelected(user)" @onchange="() => ToggleSelect(user)" aria-label="Select user" />
                                    </td>
                                    <td>@RiskBadge(user)</td>
                                    <td>
                                        <div class="use-user-cell">
                                            <div class="use-avatar" style="@AvatarStyle(user.FullName)" aria-hidden="true">@Initials(user.FullName)</div>
                                            <div class="use-user-meta">
                                                <button type="button" class="use-link-button" @onclick:stopPropagation="true" @onclick="() => ViewUser(user)">@user.FullName</button>
                                                <small>@user.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="use-pill @TypeBadgeClass(user.UserTypeCode)">@Safe(user.UserTypeCode, "Unknown")</span></td>
                                    <td>@StatusBadge(user)</td>
                                    <td class="use-center"><i class="bi @(user.MfaEnabled ? "bi-shield-fill-check use-mfa-on" : "bi-shield-x use-mfa-off")" title="@(user.MfaEnabled ? "MFA enabled" : "MFA disabled")" aria-hidden="true"></i></td>
                                    <td>
                                        <div class="use-role-list" title="@RoleTitle(user)">
                                            @foreach (var roleName in RoleNames(user).Take(2))
                                            {
                                                <span class="use-pill use-pill--blue">@roleName</span>
                                            }
                                            @if (RoleNames(user).Count > 2)
                                            {
                                                <span class="use-count-pill">+@(RoleNames(user).Count - 2)</span>
                                            }
                                            @if (RoleNames(user).Count == 0)
                                            {
                                                <span class="use-muted">None</span>
                                            }
                                        </div>
                                    </td>
                                    <td><span class="use-date" title="@user.LastLoginDateUtc?.ToString("f")">@FormatRelative(user.LastLoginDateUtc)</span></td>
                                    <td><span class="use-date">@user.CreatedDateUtc.ToString("MMM d, yyyy")</span></td>
                                    <td class="use-actions-col">
                                        <button type="button" class="use-icon-btn" title="Open action menu" @onclick:stopPropagation="true" @onclick="() => ToggleActionMenu(user)"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
                                        @if (_openActionMenuFor == user.UserId)
                                        {
                                            <div class="use-menu" role="menu" @onclick:stopPropagation="true">
                                                <div class="use-menu__summary"><strong>@user.FullName</strong><span>@user.UserName</span></div>
                                                <button type="button" class="use-menu-item" role="menuitem" @onclick="() => ViewUser(user)"><i class="bi bi-eye" aria-hidden="true"></i><span>View details</span></button>
                                                <button type="button" class="use-menu-item" role="menuitem" @onclick="() => OpenEdit(user)"><i class="bi bi-pencil" aria-hidden="true"></i><span>Edit user</span></button>
                                                <button type="button" class="use-menu-item" role="menuitem" @onclick="() => ConfirmToggleActive(user)"><i class="bi @(IsActive(user) ? "bi-slash-circle" : "bi-check-circle")" aria-hidden="true"></i><span>@(IsActive(user) ? "Deactivate" : "Activate")</span></button>
                                                @if (user.IsLockedOut)
                                                {
                                                    <button type="button" class="use-menu-item" role="menuitem" @onclick="() => ConfirmUnlock(user)"><i class="bi bi-unlock" aria-hidden="true"></i><span>Unlock account</span></button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="use-menu-item" role="menuitem" @onclick="() => ConfirmLock(user)"><i class="bi bi-lock" aria-hidden="true"></i><span>Lock account</span></button>
                                                }
                                                <button type="button" class="use-menu-item" role="menuitem" @onclick="() => ConfirmToggleMfa(user)"><i class="bi @(user.MfaEnabled ? "bi-shield-x" : "bi-shield-check")" aria-hidden="true"></i><span>@(user.MfaEnabled ? "Disable MFA" : "Enable MFA")</span></button>
                                                <button type="button" class="use-menu-item use-menu-item--danger" role="menuitem" @onclick="() => ConfirmDelete(user)"><i class="bi bi-trash3" aria-hidden="true"></i><span>Remove access</span></button>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="use-side-panel">
            <section class="use-panel-card">
                <span class="use-section-kicker">Selected user</span>
                @if (_selected is null)
                {
                    <div class="use-empty use-empty--compact"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select a row</strong><span>Choose a user to inspect risk and actions.</span></div>
                }
                else
                {
                    <div class="use-selected">
                        <div class="use-selected__title">
                            <div class="use-avatar use-avatar--lg" style="@AvatarStyle(_selected.FullName)">@Initials(_selected.FullName)</div>
                            <div><h3>@_selected.FullName</h3><span>@_selected.Email</span></div>
                        </div>
                        <div class="use-score-card use-score-card--@RiskTone(_selected)"><span>Security risk score</span><strong>@RiskScore(_selected)</strong><small>@RiskLevel(_selected)</small></div>
                        <dl class="use-detail-list">
                            <div><dt>Username</dt><dd>@_selected.UserName</dd></div>
                            <div><dt>Type</dt><dd>@_selected.UserTypeCode</dd></div>
                            <div><dt>Status</dt><dd>@(_selected.IsLockedOut ? "Locked" : _selected.StatusCode)</dd></div>
                            <div><dt>MFA</dt><dd>@(_selected.MfaEnabled ? "Enabled" : "Disabled")</dd></div>
                            <div><dt>Roles</dt><dd>@RoleNames(_selected).Count assigned</dd></div>
                            <div><dt>Department</dt><dd>@Safe(_selected.Department, "-")</dd></div>
                            <div><dt>Job title</dt><dd>@Safe(_selected.JobTitle, "-")</dd></div>
                            <div><dt>Last login</dt><dd>@FormatRelative(_selected.LastLoginDateUtc)</dd></div>
                            <div><dt>Failed attempts</dt><dd>@_selected.FailedLoginAttempts</dd></div>
                        </dl>
                        <div class="use-selected-actions">
                            <button type="button" class="use-btn use-btn--primary" @onclick="() => ViewUser(_selected)"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open</button>
                            <button type="button" class="use-btn use-btn--ghost" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                            @if (_selected.IsLockedOut)
                            {
                                <button type="button" class="use-btn use-btn--ghost" @onclick="() => ConfirmUnlock(_selected)"><i class="bi bi-unlock" aria-hidden="true"></i> Unlock</button>
                            }
                            else if (!_selected.MfaEnabled)
                            {
                                <button type="button" class="use-btn use-btn--ghost" @onclick="() => ConfirmToggleMfa(_selected)"><i class="bi bi-shield-check" aria-hidden="true"></i> Enable MFA</button>
                            }
                        </div>
                    </div>
                }
            </section>

            <section class="use-panel-card">
                <span class="use-section-kicker">Security intelligence</span>
                <div class="use-insight-list">
                    @foreach (var insight in Insights)
                    {
                        <div class="use-insight"><i class="bi @insight.Icon" aria-hidden="true"></i><div><strong>@insight.Title</strong><span>@insight.Description</span></div></div>
                    }
                </div>
            </section>
        </aside>
    </main>
</div>

@if (_showForm)
{
    <div class="use-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="use-modal" role="dialog" aria-modal="true" aria-labelledby="use-form-title" @onclick:stopPropagation="true">
            <div class="use-modal__header"><i class="bi @(_editUser is null ? "bi-person-plus" : "bi-pencil-square")" aria-hidden="true"></i><span id="use-form-title">@(_editUser is null ? "Create User" : $"Edit: {_editUser.FullName}")</span><button type="button" class="use-icon-btn use-icon-btn--light ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm EditContext="@_editContext" OnValidSubmit="SaveUserAsync">
                <DataAnnotationsValidator />
                <div class="use-modal__body">
                    <div class="use-validation-note">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <div>
                            <strong>Enterprise validations enabled</strong>
                            <span>Required identity, email format, phone format, profile, department, time zone, and locale checks are enforced before save.</span>
                        </div>
                    </div>
                    <div class="use-form-grid">
                        @if (_editUser is null)
                        {
                            <label class="use-field"><span>Username <em>*</em></span><InputText @bind-Value="_form.UserName" class="form-control" placeholder="john.doe" /></label>
                            <label class="use-field"><span>Email <em>*</em></span><InputText @bind-Value="_form.Email" class="form-control" type="email" placeholder="john.doe@company.com" />@if (!string.IsNullOrWhiteSpace(_form.Email)) { <span class="@EmailHintClass">@EmailStatusText</span> }</label>
                        }
                        <label class="use-field"><span>Full Name <em>*</em></span><InputText @bind-Value="_form.FullName" class="form-control" placeholder="John Doe" /></label>
                        <label class="use-field"><span>Display Name</span><InputText @bind-Value="_form.DisplayName" class="form-control" /></label>
                        @if (_editUser is null)
                        {
                            <label class="use-field"><span>User Type</span><InputSelect @bind-Value="_form.UserTypeCode" class="form-select">@foreach (var type in _userTypes) { <option value="@type">@type</option> }</InputSelect></label>
                        }
                        <label class="use-field"><span>Phone Number</span><InputText @bind-Value="_form.PhoneNumber" @bind-Value:after="OnPhoneChanged" class="form-control" type="tel" placeholder="(555) 123-4567" />@if (!string.IsNullOrWhiteSpace(_form.PhoneNumber)) { <span class="@PhoneHintClass">@PhoneStatusText</span> }</label>
                        <label class="use-field"><span>Job Title</span><InputText @bind-Value="_form.JobTitle" class="form-control" /></label>
                        <label class="use-field"><span>Department</span><InputSelect @bind-Value="_form.Department" class="form-select"><option value="">Select department...</option>@foreach (var department in _departments) { <option value="@department.DepartmentName">@department.DepartmentName</option> }</InputSelect></label>
                        <label class="use-field"><span>Time Zone</span><InputSelect @bind-Value="_form.TimeZoneCode" class="form-select"><option value="">Select time zone...</option>@foreach (var timeZone in _tzOptions) { <option value="@timeZone">@timeZone</option> }</InputSelect></label>
                        <label class="use-field"><span>Locale</span><InputSelect @bind-Value="_form.LocaleCode" class="form-select"><option value="">Select locale...</option>@foreach (var locale in _localeOptions) { <option value="@locale">@locale</option> }</InputSelect></label>
                    </div>
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <div class="alert alert-danger use-form-alert" style="border-left: 4px solid #dc3545; animation: use-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> @_formError</div>
                    }
                </div>
                <div class="use-modal__footer"><button type="button" class="use-btn use-btn--ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="use-btn use-btn--primary" disabled="@_saving">@if (_saving) { <span class="use-spin-sm" aria-hidden="true"></span> } @(_editUser is null ? "Create User" : "Save Changes")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showConfirm)
{
    <div class="use-modal-backdrop" role="presentation" @onclick="CloseConfirm">
        <div class="use-confirm" role="dialog" aria-modal="true" aria-labelledby="use-confirm-title" @onclick:stopPropagation="true">
            <div class="use-modal__header"><i class="bi @_confirmIcon" aria-hidden="true"></i><span>Confirm action</span><button type="button" class="use-icon-btn use-icon-btn--light ms-auto" @onclick="CloseConfirm" disabled="@_saving"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="use-confirm__body"><div class="@(_confirmDanger ? "use-confirm-icon use-confirm-icon--danger" : "use-confirm-icon")"><i class="bi @_confirmIcon" aria-hidden="true"></i></div><div><h3 id="use-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div></div>
            <div class="use-modal__footer"><button type="button" class="use-btn use-btn--ghost" @onclick="CloseConfirm" disabled="@_saving">Cancel</button><button type="button" class="@(_confirmDanger ? "use-btn use-btn--danger" : "use-btn use-btn--primary")" @onclick="ExecuteConfirmedActionAsync" disabled="@_saving">@if (_saving) { <span class="use-spin-sm" aria-hidden="true"></span> } Confirm</button></div>
        </div>
    </div>
}

<div class="use-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="use-toast @toast.CssClass"><i class="bi @(toast.CssClass.Contains("danger") ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)"><i class="bi bi-x" aria-hidden="true"></i></button></div>
    }
</div>

@code {
    private Guid _tenantId;
    private Guid _currentUserId;
    private static readonly string[] _userTypes = ["Internal", "External", "Service", "System"];
    private static readonly string[] _tzOptions = ["UTC", "America/New_York", "America/Chicago", "America/Denver", "America/Los_Angeles", "Europe/London", "Europe/Paris", "Asia/Tokyo", "Asia/Singapore"];
    private static readonly string[] _localeOptions = ["en-US", "en-GB", "fr-FR", "de-DE", "ja-JP", "es-ES", "zh-CN"];

    private readonly TabDef[] _tabs = [new("all", "All", "bi-people"), new("risk", "High Risk", "bi-exclamation-octagon"), new("locked", "Locked", "bi-lock"), new("mfa", "MFA Disabled", "bi-shield-x"), new("stale", "Stale", "bi-hourglass-bottom"), new("department", "By Department", "bi-building")];
    private readonly InsightDef[] _baselineInsights = [new("Least privilege", "Review active users with no assigned roles or stale activity.", "bi-shield-lock"), new("MFA mandate", "Keep every internal user protected with multi-factor authentication.", "bi-shield-check"), new("Access lifecycle", "Deactivate users who no longer require platform access.", "bi-arrow-left-right")];

    private List<UserDto> _users = [];
    private List<DepartmentDto> _departments = [];
    private readonly List<UserDto> _selectedUsers = [];
    private UserDto? _selected;
    private bool _loading = true;
    private string? _loadError;
    private CancellationTokenSource _cts = new();

    private string _activeTab = "all";
    private string _activeKpi = "all";
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private string _typeFilter = string.Empty;
    private string _riskFilter = string.Empty;
    private string _sortMode = "risk";
    private int _page = 1;
    private const int PageSize = 12;
    private Guid? _openActionMenuFor;

    private bool _showForm;
    private bool _saving;
    private string _formError = string.Empty;
    private UserDto? _editUser;
    private UserFormModel _form = new();
    private EditContext _editContext = default!;

    private bool _showConfirm;
    private bool _confirmDanger;
    private string _confirmTitle = string.Empty;
    private string _confirmMessage = string.Empty;
    private string _confirmIcon = "bi-question-circle";
    private Func<Task>? _confirmedAction;
    private readonly List<ToastMessage> _toasts = [];

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _currentUserId = context.UserId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Security", "/security"), new("Users", null));
        _editContext = new(_form);
        await LoadDepartmentsAsync();
        await LoadAsync();
    }

    private async Task LoadDepartmentsAsync()
    {
        try
        {
            var departments = await Api.GetDepartmentsAsync(_tenantId, _cts.Token);
            _departments = departments?.Where(d => d.IsActive).OrderBy(d => d.DepartmentName).ToList() ?? [];
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { ShowToast($"Failed to load departments: {ex.Message}", "use-toast--danger"); }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();
        try
        {
            await _cts.CancelAsync();
            _cts = new CancellationTokenSource();
            var result = await Api.SearchUsersAsync(_tenantId, _searchTerm.Trim(), 1, 500, _cts.Token);
            _users = result?.Items.ToList() ?? [];
            _selected = _selected is null ? _users.FirstOrDefault() : _users.FirstOrDefault(u => u.UserId == _selected.UserId) ?? _users.FirstOrDefault();
            _selectedUsers.RemoveAll(selected => _users.All(u => u.UserId != selected.UserId));
            _page = 1;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _loadError = $"Failed to load users: {ex.Message}"; }
        finally { _loading = false; StateHasChanged(); }
    }

    private Task RefreshAsync() => LoadAsync();

    private System.Timers.Timer? _debounce;
    private async Task OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(360) { AutoReset = false };
        _debounce.Elapsed += async (_, _) => { _debounce?.Dispose(); _debounce = null; await InvokeAsync(LoadAsync); };
        _debounce.Start();
        await Task.CompletedTask;
    }

    private void SetActiveKpi(string key)
    {
        _activeKpi = _activeKpi == key ? "all" : key;
        _activeTab = _activeKpi switch { "risk" => "risk", "locked" => "locked", "mfa" => "mfa", "stale" => "stale", _ => "all" };
        _page = 1;
    }

    private void SetActiveTab(string key)
    {
        _activeTab = key;
        _activeKpi = key is "risk" or "locked" or "mfa" or "stale" ? key : "all";
        _page = 1;
    }

    private void SetDashboardFocus(string tab, string sortMode)
    {
        _activeTab = tab;
        _activeKpi = tab is "risk" or "locked" or "mfa" or "stale" ? tab : "all";
        _sortMode = sortMode;
        _page = 1;
    }

    private void ApplyFilters() => _page = 1;

    private void ClearFilters()
    {
        _statusFilter = string.Empty;
        _typeFilter = string.Empty;
        _riskFilter = string.Empty;
        _sortMode = "risk";
        _activeTab = "all";
        _activeKpi = "all";
        _page = 1;
    }

    private bool HasFilters => !string.IsNullOrEmpty(_statusFilter) || !string.IsNullOrEmpty(_typeFilter) || !string.IsNullOrEmpty(_riskFilter) || _sortMode != "risk" || _activeTab != "all";
    private string PhoneStatusText => IsPhoneValid(_form.PhoneNumber) ? $"Phone formatted as {NormalizePhone(_form.PhoneNumber)}" : "Enter a valid 10-digit phone number.";
    private string PhoneHintClass => IsPhoneValid(_form.PhoneNumber) ? "use-field-hint use-hint-good" : "use-field-hint use-hint-bad";
    private string EmailStatusText => IsEmailValid(_form.Email) ? "Email format verified." : "Enter a valid business email address.";
    private string EmailHintClass => IsEmailValid(_form.Email) ? "use-field-hint use-hint-good" : "use-field-hint use-hint-bad";

    private void FilterByDepartment(string department)
    {
        _searchTerm = department == "Unassigned" ? string.Empty : department;
        _activeTab = "all";
        _activeKpi = "all";
        _page = 1;
        _ = LoadAsync();
    }

    private IEnumerable<UserDto> TabFiltered => _activeTab switch
    {
        "risk" => _users.Where(IsHighRisk),
        "locked" => _users.Where(u => u.IsLockedOut),
        "mfa" => _users.Where(u => !u.MfaEnabled),
        "stale" => _users.Where(IsStale),
        "noroles" => _users.Where(u => IsActive(u) && RoleNames(u).Count == 0),
        _ => _users,
    };

    private IEnumerable<UserDto> FilteredUsers
    {
        get
        {
            var query = TabFiltered;
            if (!string.IsNullOrEmpty(_statusFilter)) query = query.Where(u => string.Equals(u.StatusCode, _statusFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(_typeFilter)) query = query.Where(u => string.Equals(u.UserTypeCode, _typeFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(_riskFilter)) query = query.Where(u => RiskLevel(u) == _riskFilter);
            return _sortMode switch
            {
                "name" => query.OrderBy(u => u.FullName),
                "login" => query.OrderByDescending(u => u.LastLoginDateUtc ?? DateTime.MinValue),
                "created" => query.OrderByDescending(u => u.CreatedDateUtc),
                "roles" => query.OrderByDescending(u => RoleNames(u).Count).ThenBy(u => u.FullName),
                _ => query.OrderByDescending(RiskScore).ThenBy(u => u.FullName),
            };
        }
    }

    private IEnumerable<UserDto> PagedUsers => FilteredUsers.Skip((_page - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredUsers.Count() / (double)PageSize));
    private void PreviousPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private string ActiveViewTitle => _tabs.FirstOrDefault(t => t.Key == _activeTab)?.Label ?? (_activeTab == "noroles" ? "Role gaps" : "Users");

    private int TabCount(string key) => key switch
    {
        "risk" => _users.Count(IsHighRisk),
        "locked" => _users.Count(u => u.IsLockedOut),
        "mfa" => _users.Count(u => !u.MfaEnabled),
        "stale" => _users.Count(IsStale),
        "department" => DepartmentGroups.Count,
        _ => _users.Count,
    };

    private IEnumerable<string> StatusOptions => _users.Select(u => u.StatusCode).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);
    private IEnumerable<string> TypeOptions => _users.Select(u => u.UserTypeCode).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);

    private List<DeptGroup> DepartmentGroups
    {
        get
        {
            var groups = _users.GroupBy(u => string.IsNullOrWhiteSpace(u.Department) ? "Unassigned" : u.Department!).ToList();
            var max = Math.Max(1, groups.Count == 0 ? 1 : groups.Max(g => g.Count()));
            return groups.Select(g => new DeptGroup(g.Key, g.Count(), g.Count(IsHighRisk), g.Count(u => !u.MfaEnabled), (int)Math.Round(g.Count() * 100.0 / max))).OrderByDescending(g => g.HighRisk).ThenByDescending(g => g.Count).ToList();
        }
    }

    private void SelectRow(UserDto u) { _selected = u; _openActionMenuFor = null; }
    private bool IsSelected(UserDto u) => _selectedUsers.Any(x => x.UserId == u.UserId);
    private void ToggleSelect(UserDto u) { if (IsSelected(u)) _selectedUsers.RemoveAll(x => x.UserId == u.UserId); else _selectedUsers.Add(u); }
    private bool AllPageSelected => PagedUsers.Any() && PagedUsers.All(IsSelected);
    private void ToggleSelectAllPage()
    {
        var page = PagedUsers.ToList();
        if (page.All(IsSelected)) foreach (var u in page) _selectedUsers.RemoveAll(x => x.UserId == u.UserId);
        else foreach (var u in page.Where(u => !IsSelected(u))) _selectedUsers.Add(u);
    }

    private void ToggleActionMenu(UserDto u) => _openActionMenuFor = _openActionMenuFor == u.UserId ? null : u.UserId;
    private void ViewUser(UserDto u) => Nav.NavigateTo($"/tenant/security/users/{u.UserId}");

    private void OpenCreate()
    {
        _editUser = null;
        _form = new UserFormModel();
        _editContext = new(_form);
        _formError = string.Empty;
        _showForm = true;
        _openActionMenuFor = null;
    }

    private void OpenEdit(UserDto u)
    {
        _editUser = u;
        _form = new UserFormModel { FullName = u.FullName, DisplayName = u.DisplayName, PhoneNumber = u.PhoneNumber, JobTitle = u.JobTitle, Department = u.Department, TimeZoneCode = u.TimeZoneCode, LocaleCode = u.LocaleCode };
        _editContext = new(_form);
        _formError = string.Empty;
        _showForm = true;
        _openActionMenuFor = null;
    }

    private void CloseForm() { _showForm = false; _formError = string.Empty; }

    private async Task SaveUserAsync()
    {
        if (_saving) return;
        _formError = string.Empty;
        _saving = true;
        try
        {
            if (_editUser is null)
            {
                var req = new CreateUserRequest { TenantId = _tenantId, UserName = _form.UserName.Trim(), Email = _form.Email.Trim(), FullName = _form.FullName.Trim(), DisplayName = _form.DisplayName?.Trim(), PhoneNumber = _form.PhoneNumber?.Trim(), JobTitle = _form.JobTitle?.Trim(), Department = _form.Department?.Trim(), UserTypeCode = _form.UserTypeCode, TimeZoneCode = _form.TimeZoneCode, LocaleCode = _form.LocaleCode };
                await Api.CreateUserAsync(req);
                CloseForm();
                ShowToast($"User '{req.FullName}' created.", "use-toast--success");
            }
            else
            {
                var req = new UpdateUserRequest { UserId = _editUser.UserId, FullName = _form.FullName.Trim(), DisplayName = _form.DisplayName?.Trim(), PhoneNumber = _form.PhoneNumber?.Trim(), JobTitle = _form.JobTitle?.Trim(), Department = _form.Department?.Trim(), TimeZoneCode = _form.TimeZoneCode, LocaleCode = _form.LocaleCode };
                await Api.UpdateUserAsync(_editUser.UserId, req);
                CloseForm();
                ShowToast($"User '{req.FullName}' updated.", "use-toast--success");
            }
            await LoadAsync();
        }
        catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; }
        finally { _saving = false; }
    }

    private void OpenConfirm(string title, string message, string icon, bool danger, Func<Task> action)
    {
        _confirmTitle = title;
        _confirmMessage = message;
        _confirmIcon = icon;
        _confirmDanger = danger;
        _confirmedAction = action;
        _showConfirm = true;
        _openActionMenuFor = null;
    }

    private void CloseConfirm() { _showConfirm = false; _confirmedAction = null; }

    private async Task ExecuteConfirmedActionAsync()
    {
        if (_confirmedAction is null) return;
        _saving = true;
        try { await _confirmedAction.Invoke(); }
        finally { _saving = false; }
    }

    private void ConfirmToggleActive(UserDto u)
    {
        var activate = !IsActive(u);
        OpenConfirm(activate ? "Activate user?" : "Deactivate user?", $"{(activate ? "Activate" : "Deactivate")} access for {u.FullName}?", activate ? "bi-check-circle" : "bi-slash-circle", !activate, () => ToggleActiveAsync(u, activate));
    }

    private async Task ToggleActiveAsync(UserDto u, bool activate)
    {
        try
        {
            await Api.SetUserActiveAsync(u.UserId, activate, _currentUserId);
            CloseConfirm();
            ShowToast($"User '{u.FullName}' {(activate ? "activated" : "deactivated")}." , "use-toast--success");
            await LoadAsync();
        }
        catch (Exception ex) { CloseConfirm(); ShowToast($"Status update failed: {ex.Message}", "use-toast--danger"); }
    }

