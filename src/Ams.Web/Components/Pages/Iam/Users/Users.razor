    private void ConfirmBulkToggle(bool activate) => OpenConfirm(activate ? "Enable selected users?" : "Disable selected users?", $"{(activate ? "Enable" : "Disable")} {_selectedUsers.Count} selected user(s)?", activate ? "bi-check-circle" : "bi-slash-circle", !activate, () => BulkToggleAsync(activate));
    private async Task BulkToggleAsync(bool activate)
    {
        var targets = _selectedUsers.ToList();
        var failures = 0;
        foreach (var u in targets) try { await Api.SetUserActiveAsync(u.UserId, activate, _currentUserId); } catch { failures++; }
        _selectedUsers.Clear();
        CloseConfirm();
        ShowToast($"{(activate ? "Enabled" : "Disabled")} {targets.Count - failures} user(s)." + (failures > 0 ? $" {failures} failed." : string.Empty), failures > 0 ? "use-toast--danger" : "use-toast--success");
        await LoadAsync();
    }

    private void ConfirmBulkDelete() => OpenConfirm("Remove selected users?", $"Disable and revoke access for {_selectedUsers.Count} selected user(s)?", "bi-trash3", true, BulkDeleteAsync);
    private async Task BulkDeleteAsync()
    {
        var targets = _selectedUsers.ToList();
        var failures = 0;
        foreach (var u in targets) try { await Api.SetUserActiveAsync(u.UserId, false, _currentUserId); } catch { failures++; }
        _selectedUsers.Clear();
        CloseConfirm();
        ShowToast($"Removed {targets.Count - failures} user(s)." + (failures > 0 ? $" {failures} failed." : string.Empty), failures > 0 ? "use-toast--danger" : "use-toast--success");
        await LoadAsync();
    }

    private void ShowToast(string message, string cssClass)
    {
        var toast = new ToastMessage(Guid.NewGuid(), message, cssClass);
        _toasts.Add(toast);
        _ = Task.Run(async () => { await Task.Delay(2800); await InvokeAsync(() => DismissToast(toast.Id)); });
    }

    private void DismissToast(Guid id) { _toasts.RemoveAll(t => t.Id == id); StateHasChanged(); }

    private static bool IsActive(UserDto u) => u.StatusCode.Equals("Active", StringComparison.OrdinalIgnoreCase);
    private static bool IsStale(UserDto u) => u.LastLoginDateUtc is null || (DateTime.UtcNow - u.LastLoginDateUtc.Value).TotalDays >= 30;

    private static int RiskScore(UserDto u)
    {
        var score = 0;
        if (u.IsLockedOut) score += 40;
        if (!u.MfaEnabled) score += 25;
        if (u.LastLoginDateUtc is null) score += 18;
        else if ((DateTime.UtcNow - u.LastLoginDateUtc.Value).TotalDays >= 30) score += 12;
        if (u.AssignedRoleCount == 0 && IsActive(u)) score += 10;
        if (u.FailedLoginAttempts >= 3) score += 10;
        if (u.StatusCode.Equals("Pending", StringComparison.OrdinalIgnoreCase)) score += 8;
        return Math.Min(100, score);
    }

    private static string RiskLevel(UserDto u) => RiskScore(u) switch { >= 60 => "Critical", >= 40 => "High", >= 20 => "Medium", _ => "Low" };
    private static string RiskTone(UserDto u) => RiskLevel(u) switch { "Critical" => "red", "High" => "amber", "Medium" => "cyan", _ => "green" };
    private static bool IsHighRisk(UserDto u) => RiskScore(u) >= 40;

    private IEnumerable<InsightDef> Insights
    {
        get
        {
            var list = new List<InsightDef>();
            var mfaOff = _users.Count(u => !u.MfaEnabled);
            if (mfaOff > 0) list.Add(new("MFA gaps", $"{mfaOff} user(s) need MFA enabled.", "bi-shield-x"));
            var locked = _users.Count(u => u.IsLockedOut);
            if (locked > 0) list.Add(new("Locked accounts", $"{locked} user(s) are blocked from sign-in.", "bi-lock"));
            var stale = _users.Count(IsStale);
            if (stale > 0) list.Add(new("Dormant access", $"{stale} user(s) have stale or no login activity.", "bi-hourglass-bottom"));
            var noRoles = _users.Count(u => IsActive(u) && RoleNames(u).Count == 0);
            if (noRoles > 0) list.Add(new("Role gaps", $"{noRoles} active user(s) have no assigned roles.", "bi-diagram-3"));
            list.AddRange(_baselineInsights);
            return list.Take(5);
        }
    }

    private static string Initials(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    private static readonly string[] _avatarColors = ["#3b82f6", "#8b5cf6", "#10b981", "#f59e0b", "#ef4444", "#06b6d4", "#6366f1", "#ec4899"];
    private static string AvatarStyle(string? name) => $"background:{_avatarColors[Math.Abs((name ?? string.Empty).GetHashCode()) % _avatarColors.Length]}";
    private static string TypeBadgeClass(string? type) => (type ?? string.Empty).ToLowerInvariant() switch { "internal" => "use-pill--blue", "external" => "use-pill--neutral", "service" => "use-pill--amber", "system" => "use-pill--red", _ => "use-pill--neutral" };
    private static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private void OnPhoneChanged() { if (IsPhoneValid(_form.PhoneNumber)) _form.PhoneNumber = NormalizePhone(_form.PhoneNumber); }
    private static bool IsPhoneValid(string? value) { if (string.IsNullOrWhiteSpace(value)) return true; var digits = new string(value.Where(char.IsDigit).ToArray()); if (digits.Length == 11 && digits[0] == '1') digits = digits[1..]; return digits.Length == 10; }
    private static string? NormalizePhone(string? value) { if (string.IsNullOrWhiteSpace(value)) return null; var digits = new string(value.Where(char.IsDigit).ToArray()); if (digits.Length == 11 && digits[0] == '1') digits = digits[1..]; return digits.Length == 10 ? $"({digits[..3]}) {digits.Substring(3, 3)}-{digits[6..]}" : value.Trim(); }
    private static bool IsEmailValid(string? value) => string.IsNullOrWhiteSpace(value) || new EmailAddressAttribute().IsValid(value.Trim());

    private static string FormatRelative(DateTime? dt) => dt is null ? "Never" : (DateTime.UtcNow - dt.Value) switch
    {
        var d when d.TotalMinutes < 1 => "Just now",
        var d when d.TotalHours < 1 => $"{(int)d.TotalMinutes}m ago",
        var d when d.TotalDays < 1 => $"{(int)d.TotalHours}h ago",
        var d when d.TotalDays < 7 => $"{(int)d.TotalDays}d ago",
        var d when d.TotalDays < 30 => $"{(int)(d.TotalDays / 7)}w ago",
        _ => dt.Value.ToString("MMM d, yyyy"),
    };

    private static IReadOnlyList<string> RoleNames(UserDto user) => string.IsNullOrWhiteSpace(user.AssignedRoleNames) ? [] : user.AssignedRoleNames.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Where(roleName => !string.IsNullOrWhiteSpace(roleName)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    private static string RoleTitle(UserDto user) => RoleNames(user).Count == 0 ? "No assigned roles" : string.Join(", ", RoleNames(user));

    private RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string tone) => @<button type="button" class="use-kpi-card use-kpi-card--@tone @(_activeKpi == key ? "use-kpi-card--active" : null)" title="@subtitle" @onclick="() => SetActiveKpi(key)"><div class="use-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></div><div class="use-kpi-body"><span class="use-kpi-label">@label</span><strong class="use-kpi-value">@value</strong><span class="use-kpi-sub">@subtitle</span></div></button>;
    private RenderFragment WorkflowButton(string title, string description, string icon, System.Action onClick) => @<button type="button" class="use-workflow" @onclick="onClick"><div class="use-workflow-icon"><i class="bi @icon" aria-hidden="true"></i></div><div class="use-workflow-meta"><strong>@title</strong><span>@description</span></div></button>;
    private RenderFragment RiskBadge(UserDto u) => @<span class="use-risk-badge use-risk-badge--@RiskTone(u)" title="Security risk score: @RiskScore(u)/100"><i class="bi bi-shield-fill" aria-hidden="true"></i> @RiskLevel(u)</span>;
    private RenderFragment StatusBadge(UserDto u) => u.IsLockedOut ? @<span class="use-pill use-pill--amber"><i class="bi bi-lock-fill" aria-hidden="true"></i> Locked</span> : @<span class="use-pill @(u.StatusCode.ToLowerInvariant() switch { "active" => "use-pill--green", "pending" => "use-pill--amber", _ => "use-pill--neutral" })">@u.StatusCode</span>;

    private sealed class UserFormModel
    {
        [Required(ErrorMessage = "Full Name is required.")]
        [StringLength(200)]
        public string FullName { get; set; } = string.Empty;

        [StringLength(200)]
        public string? DisplayName { get; set; }

        [StringLength(50)]
        [AmsPhone]
        public string? PhoneNumber { get; set; }

        [StringLength(100)]
        public string? JobTitle { get; set; }

        [StringLength(100)]
        public string? Department { get; set; }

        public string? TimeZoneCode { get; set; }
        public string? LocaleCode { get; set; }

        [Required(ErrorMessage = "Username is required.")]
        [StringLength(100)]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [AmsEmailAddress]
        [StringLength(320)]
        public string Email { get; set; } = string.Empty;

        public string UserTypeCode { get; set; } = "Internal";
    }

    private sealed record TabDef(string Key, string Label, string Icon);
    private sealed record InsightDef(string Title, string Description, string Icon);
    private sealed record ToastMessage(Guid Id, string Message, string CssClass);
    private sealed record DeptGroup(string Name, int Count, int HighRisk, int MfaOff, int Percent);
}
