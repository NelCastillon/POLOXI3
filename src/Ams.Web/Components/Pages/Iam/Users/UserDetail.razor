@page "/iam/users/{UserId:guid}"
@page "/users/{UserId:guid}"
@page "/admin/users/{UserId:guid}"
@page "/tenant/security/users/{UserId:guid}"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@PageTitle — IAM</PageTitle>

<!-- Toast must be outside all conditional blocks -->
<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

@if (_loading)
{
    <div class="ud-loading">
        <span class="um-spin ud-loading-spin" aria-hidden="true"></span>
        <span>Loading user…</span>
    </div>
}
else if (_user is null)
{
    <div class="ud-not-found">
        <i class="bi bi-person-x ud-not-found-icon" aria-hidden="true"></i>
        <h2>User not found</h2>
        <p>The requested user could not be loaded.</p>
        <button class="um-btn um-btn-ghost" @onclick="NavigateToList">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Users
        </button>
    </div>
}
else
{
    <!-- Page header -->
    <AppPageHeader Title="@PageTitle"
                   Subtitle="@PageSubtitle"
                   Icon="bi-person-badge">
        <Actions>
            <button class="um-btn um-btn-ghost" @onclick="OpenEdit">
                <i class="bi bi-pencil" aria-hidden="true"></i> Edit User
            </button>
            @if (_user.StatusCode == "Active")
            {
                <button class="um-btn um-btn-warning" @onclick="OpenDisable">
                    <i class="bi bi-person-dash" aria-hidden="true"></i> Disable
                </button>
            }
            else
            {
                <button class="um-btn um-btn-primary" @onclick="OpenEnable">
                    <i class="bi bi-person-check" aria-hidden="true"></i> Enable
                </button>
            }
            @if (_user.IsLockedOut)
            {
                <button class="um-btn um-btn-ghost" @onclick="OpenUnlock">
                    <i class="bi bi-unlock" aria-hidden="true"></i> Unlock
                </button>
            }
            <button class="um-btn um-btn-ghost" @onclick="ResetMfaAsync">
                <i class="bi bi-shield-x" aria-hidden="true"></i> Reset MFA
            </button>
            <button class="um-btn um-btn-ghost" @onclick="RevokeSessionsAsync">
                <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Revoke Sessions
            </button>
            <button class="um-btn um-btn-ghost" @onclick="OpenAddRole">
                <i class="bi bi-person-plus" aria-hidden="true"></i> Add Role
            </button>
            <button class="um-btn um-btn-ghost" @onclick="OpenAddPermission">
                <i class="bi bi-key" aria-hidden="true"></i> Add Permissions
            </button>
        </Actions>
    </AppPageHeader>

    <!-- Identity / stats bar -->
    <div class="ud-stats-bar">
        <div class="ud-avatar-wrap">
            <span class="ud-avatar" style="@AvatarStyle()" aria-hidden="true">@Initials()</span>
        </div>
        <div class="ud-stats">
            <AppStatusBadge Status="@_user.StatusCode" />
            @if (_user.IsLockedOut)
            {
                <span class="badge badge-amber">
                    <i class="bi bi-lock-fill" aria-hidden="true"></i> Locked
                </span>
            }
            @if (_user.MfaEnabled)
            {
                <span class="badge badge-green">
                    <i class="bi bi-shield-check-fill" aria-hidden="true"></i> MFA On
                </span>
            }
            else
            {
                <span class="badge badge-neutral">
                    <i class="bi bi-shield" aria-hidden="true"></i> MFA Off
                </span>
            }
            @if (!string.IsNullOrEmpty(_user.UserTypeCode))
            {
                <span class="badge badge-blue">@_user.UserTypeCode</span>
            }
            @if (!string.IsNullOrEmpty(_user.Department))
            {
                <span class="ud-stat-chip">
                    <i class="bi bi-building" aria-hidden="true"></i> @_user.Department
                </span>
            }
            @if (!string.IsNullOrEmpty(_user.JobTitle))
            {
                <span class="ud-stat-chip">
                    <i class="bi bi-briefcase" aria-hidden="true"></i> @_user.JobTitle
                </span>
            }
            <span class="ud-stat-chip">
                <i class="bi bi-clock" aria-hidden="true"></i> Last login: @FormatRelative(_user.LastLoginDateUtc)
            </span>
        </div>
    </div>

    <div class="ud-kpi-strip" aria-label="User detail sections">
        <button type="button" class="ud-kpi-card @TabKpiClass(0)" @onclick="() => SetTabAsync(0)" title="View identity, contact, and profile information">
            <span class="ud-kpi-icon ud-kpi-icon--profile"><i class="bi bi-person" aria-hidden="true"></i></span>
            <span><strong>@(_user.UserTypeCode ?? "User")</strong><small>Profile</small></span>
        </button>
        <button type="button" class="ud-kpi-card @TabKpiClass(1)" @onclick="() => SetTabAsync(1)" title="View account security state">
            <span class="ud-kpi-icon @(_user.IsLockedOut ? "ud-kpi-icon--danger" : "ud-kpi-icon--safe")"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
            <span><strong>@(_user.IsLockedOut ? "Locked" : (_user.MfaEnabled ? "MFA On" : "MFA Off"))</strong><small>Security</small></span>
        </button>
        <button type="button" class="ud-kpi-card @TabKpiClass(2)" @onclick="() => SetTabAsync(2)" title="View assigned roles">
            <span class="ud-kpi-icon ud-kpi-icon--roles"><i class="bi bi-people" aria-hidden="true"></i></span>
            <span><strong>@AssignedRoleCount</strong><small>Roles</small></span>
        </button>
        <button type="button" class="ud-kpi-card @TabKpiClass(3)" @onclick="() => SetTabAsync(3)" title="View direct overrides and effective permissions">
            <span class="ud-kpi-icon ud-kpi-icon--permissions"><i class="bi bi-key" aria-hidden="true"></i></span>
            <span><strong>@EffectivePermissionCount</strong><small>Effective Access</small></span>
        </button>
        <button type="button" class="ud-kpi-card @TabKpiClass(4)" @onclick="() => SetTabAsync(4)" title="View scope assignments">
            <span class="ud-kpi-icon ud-kpi-icon--scopes"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
            <span><strong>@ScopeCount</strong><small>Scopes</small></span>
        </button>
        <button type="button" class="ud-kpi-card @TabKpiClass(11)" @onclick="() => SetTabAsync(11)" title="View branch access">
            <span class="ud-kpi-icon ud-kpi-icon--branch"><i class="bi bi-building" aria-hidden="true"></i></span>
            <span><strong>@BranchAccessCount</strong><small>Branches</small></span>
        </button>
        <button type="button" class="ud-kpi-card @TabKpiClass(12)" @onclick="() => SetTabAsync(12)" title="View team memberships">
            <span class="ud-kpi-icon ud-kpi-icon--teams"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
            <span><strong>@TeamCount</strong><small>Teams</small></span>
        </button>
    </div>

    <!-- Detail tabs -->
    <AppDetailTabs SelectedTab="_tab" SelectedTabChanged="OnTabChangedAsync">
        <Tabs>

            <!-- 0: Profile -->
            <TabItem>
                <ChildContent><TabHeader Text="Profile" IconCss="bi bi-person" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        <div class="ud-info-card">
                        <h3 class="ud-section-title">Identity</h3>
                        <div class="ud-profile-grid">
                            <div class="ud-field-group">
                                <span class="ts-label">Username</span>
                                <span class="ts-value">@_user.UserName</span>
                            </div>
                            <div class="ud-field-group">
                                <span class="ts-label">Full Name</span>
                                <span class="ts-value">@_user.FullName</span>
                            </div>
                            <div class="ud-field-group">
                                <span class="ts-label">Display Name</span>
                                <span class="ts-value">@(_user.DisplayName ?? "—")</span>
                            </div>
                            <div class="ud-field-group">
                                <span class="ts-label">Email</span>
                                <span class="ts-value">@_user.Email</span>
                            </div>
                            <div class="ud-field-group">
                                <span class="ts-label">Phone</span>
                                <span class="ts-value">@(_user.PhoneNumber ?? "—")</span>
                            </div>
                            <div class="ud-field-group">
                                <span class="ts-label">User Type</span>
                                <span class="ts-value">@(_user.UserTypeCode ?? "—")</span>
                            </div>
                            <div class="ud-field-group">
                                <span class="ts-label">Department</span>
                                <span class="ts-value">@(_user.Department ?? "—")</span>
                            </div>
                            <div class="ud-field-group">
                                <span class="ts-label">Job Title</span>
                                <span class="ts-value">@(_user.JobTitle ?? "—")</span>
                            </div>
                            <div class="ud-field-group">
                                <span class="ts-label">Time Zone</span>
                                <span class="ts-value">@(_user.TimeZoneCode ?? "—")</span>
                            </div>
                            <div class="ud-field-group">
                                <span class="ts-label">Locale</span>
                                <span class="ts-value">@(_user.LocaleCode ?? "—")</span>
                            </div>
                            <div class="ud-field-group">
                                <span class="ts-label">Created</span>
                                <span class="ts-value">@(_user.CreatedDateUtc.ToString("d"))</span>
                            </div>
                            <div class="ud-field-group">
                                <span class="ts-label">Last Modified</span>
                                <span class="ts-value">@(_user.ModifiedDateUtc?.ToString("d") ?? "—")</span>
                            </div>
                        </div>
                        </div>

                        @if (_profile is not null)
                        {
                            <div class="ud-info-card">
                            <h3 class="ud-section-title">Contact &amp; Address</h3>
                            <div class="ud-profile-grid">
                                <div class="ud-field-group">
                                    <span class="ts-label">Mobile</span>
                                    <span class="ts-value">@(_profile.MobileNumber ?? "—")</span>
                                </div>
                                <div class="ud-field-group">
                                    <span class="ts-label">Country</span>
                                    <span class="ts-value">@(_profile.CountryCode ?? "—")</span>
                                </div>
                                <div class="ud-field-group ud-field-group--wide">
                                    <span class="ts-label">Address</span>
                                    <span class="ts-value">@CityState()</span>
                                </div>
                                <div class="ud-field-group">
                                    <span class="ts-label">Emergency Contact</span>
                                    <span class="ts-value">@(_profile.EmergencyContactName ?? "—")</span>
                                </div>
                                <div class="ud-field-group">
                                    <span class="ts-label">Emergency Phone</span>
                                    <span class="ts-value">@(_profile.EmergencyContactPhone ?? "—")</span>
                                </div>
                            </div>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 1: Security -->
            <TabItem>
                <ChildContent><TabHeader Text="Security" IconCss="bi bi-shield-lock" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        <div class="ud-security-grid">

                            <div class="@MfaCardClass">
                                <span class="@MfaIconClass" aria-hidden="true">
                                    <i class="bi bi-shield-check-fill"></i>
                                </span>
                                <div>
                                    <div class="ud-sec-label">MFA Status</div>
                                    <div class="ud-sec-value">@MfaValueText</div>
                                    @if (_user.MfaEnabled)
                                    {
                                        <div class="ud-sec-detail">MFA enrolled</div>
                                    }
                                </div>
                            </div>

                            <div class="@LockCardClass">
                                <span class="@LockIconClass" aria-hidden="true">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <div>
                                    <div class="ud-sec-label">Account Lock</div>
                                    <div class="ud-sec-value">@LockValueText</div>
                                    @if (_user.LockoutEndDateUtc.HasValue)
                                    {
                                        <div class="ud-sec-detail">Expires: @FormatRelative(_user.LockoutEndDateUtc)</div>
                                    }
                                </div>
                            </div>

                            <div class="ud-sec-card">
                                <span class="ud-sec-icon ud-sec-icon--neutral" aria-hidden="true">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                </span>
                                <div>
                                    <div class="ud-sec-label">Failed Attempts</div>
                                    <div class="ud-sec-value">@_user.FailedLoginAttempts</div>
                                    <div class="ud-sec-detail">Since last success</div>
                                </div>
                            </div>

                            <div class="ud-sec-card">
                                <span class="ud-sec-icon ud-sec-icon--neutral" aria-hidden="true">
                                    <i class="bi bi-key-fill"></i>
                                </span>
                                <div>
                                    <div class="ud-sec-label">Password Changed</div>
                                    <div class="ud-sec-value">@FormatRelative(_user.PasswordChangedDateUtc)</div>
                                    @if (_user.PasswordChangedDateUtc.HasValue)
                                    {
                                        <div class="ud-sec-detail">@(_user.PasswordChangedDateUtc.Value.ToString("d"))</div>
                                    }
                                </div>
                            </div>

                            <div class="ud-sec-card">
                                <span class="ud-sec-icon ud-sec-icon--neutral" aria-hidden="true">
                                    <i class="bi bi-clock-history"></i>
                                </span>
                                <div>
                                    <div class="ud-sec-label">Last Login</div>
                                    <div class="ud-sec-value">@FormatRelative(_user.LastLoginDateUtc)</div>
                                    @if (_user.LastLoginDateUtc.HasValue)
                                    {
                                        <div class="ud-sec-detail">@(_user.LastLoginDateUtc.Value.ToString("g"))</div>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 2: Roles -->
            <TabItem>
                <ChildContent><TabHeader Text="Roles" IconCss="bi bi-people" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        <div class="ud-tab-toolbar">
                            <span class="ud-tab-count">@_userRoles.Count role(s)</span>
                            <button class="um-btn um-btn-ghost" @onclick="OpenAddRole">
                                <i class="bi bi-person-plus" aria-hidden="true"></i> Add Role
                            </button>
                        </div>
                        @if (_rolesLoading)
                        {
                            <div class="ud-tab-loading"><span class="um-spin" aria-hidden="true"></span></div>
                        }
                        else
                        {
                            <SfGrid DataSource="_userRoles"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    CssClass="e-grid--compact">
                                <GridPageSettings PageSize="15" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(UserRoleDto.RoleName)"   HeaderText="Role"        Width="180" />
                                    <GridColumn Field="@nameof(UserRoleDto.RoleCode)"   HeaderText="Code"        Width="140" />
                                    <GridColumn Field="@nameof(UserRoleDto.AssignedByFullName)" HeaderText="Assigned By" Width="160" />
                                    <GridColumn Field="@nameof(UserRoleDto.AssignedDateUtc)"    HeaderText="Assigned"    Width="130">
                                        <Template>
                                            @{ var r = (UserRoleDto)context; }
                                            <span>@r.AssignedDateUtc.ToString("d")</span>
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(UserRoleDto.EffectiveStartDateUtc)" HeaderText="Effective From" Width="130">
                                        <Template>
                                            @{ var r = (UserRoleDto)context; }
                                            <span>@(r.EffectiveStartDateUtc?.ToString("d") ?? "—")</span>
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(UserRoleDto.EffectiveEndDateUtc)" HeaderText="Expires" Width="120">
                                        <Template>
                                            @{ var r = (UserRoleDto)context; }
                                            <span>@(r.EffectiveEndDateUtc?.ToString("d") ?? "—")</span>
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(UserRoleDto.IsActive)" HeaderText="Active" Width="90" TextAlign="TextAlign.Center">
                                        <Template>
                                            @{ var r = (UserRoleDto)context; }
                                            <AppStatusBadge Status="@(r.IsActive ? "Active" : "Inactive")" />
                                        </Template>
                                    </GridColumn>
                                    <GridColumn HeaderText="" Width="90" TextAlign="TextAlign.Center">
                                        <Template>
                                            @{ var r = (UserRoleDto)context; }
                                            <button class="um-btn um-btn-ghost um-btn--xs" @onclick="() => RevokeRoleAsync(r)">
                                                <i class="bi bi-x-circle" aria-hidden="true"></i> Revoke
                                            </button>
                                        </Template>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 3: Permissions -->
            <TabItem>
                <ChildContent><TabHeader Text="Permissions" IconCss="bi bi-key" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        <div class="ud-tab-toolbar">
                            <span class="ud-tab-count">@_effectivePermissions.Count effective permission(s)</span>
                            <button class="um-btn um-btn-ghost" @onclick="OpenAddPermission">
                                <i class="bi bi-key-fill" aria-hidden="true"></i> Add Permissions
                            </button>
                        </div>
                        @if (_permsLoading)
                        {
                            <div class="ud-tab-loading"><span class="um-spin" aria-hidden="true"></span></div>
                        }
                        else
                        {
                            <div class="ud-perm-summary-grid">
                                <div class="ud-info-card ud-perm-summary-card">
                                    <span class="ud-sec-icon ud-sec-icon--on" aria-hidden="true"><i class="bi bi-check2-circle"></i></span>
                                    <div>
                                        <div class="ud-sec-label">Role + Direct Grants</div>
                                        <div class="ud-sec-value">@_effectivePermissions.Count(p => !string.Equals(p.GrantSource, "Deny", StringComparison.OrdinalIgnoreCase))</div>
                                        <div class="ud-sec-detail">Effective permissions after deny evaluation</div>
                                    </div>
                                </div>
                                <div class="ud-info-card ud-perm-summary-card">
                                    <span class="ud-sec-icon ud-sec-icon--neutral" aria-hidden="true"><i class="bi bi-key"></i></span>
                                    <div>
                                        <div class="ud-sec-label">Direct Overrides</div>
                                        <div class="ud-sec-value">@_permissions.Count</div>
                                        <div class="ud-sec-detail">Explicit user-level grants or denies</div>
                                    </div>
                                </div>
                                <div class="ud-info-card ud-perm-summary-card">
                                    <span class="ud-sec-icon ud-sec-icon--neutral" aria-hidden="true"><i class="bi bi-boxes"></i></span>
                                    <div>
                                        <div class="ud-sec-label">Resources</div>
                                        <div class="ud-sec-value">@_effectivePermissions.Select(p => p.ResourceCode).Distinct().Count()</div>
                                        <div class="ud-sec-detail">Unique secured resources</div>
                                    </div>
                                </div>
                            </div>

                            <div class="ud-section-heading-row">
                                <h3 class="ud-section-title">Effective Permissions</h3>
                                <span class="ud-tab-count">Role-derived plus direct access</span>
                            </div>
                            @if (_effectivePermissions.Count == 0)
                            {
                                <div class="ts-empty">
                                    <i class="bi bi-key ts-empty-icon" aria-hidden="true"></i>
                                    <div class="ts-empty-title">No effective permissions</div>
                                    <div class="ts-empty-sub">This user does not currently receive permissions from active roles or direct overrides.</div>
                                </div>
                            }
                            else
                            {
                                <SfGrid DataSource="_effectivePermissions"
                                        AllowPaging="true"
                                        AllowSorting="true"
                                        CssClass="e-grid--compact">
                                    <GridPageSettings PageSize="15" />
                                    <GridColumns>
                                        <GridColumn Field="@nameof(EffectivePermissionDto.PermissionName)" HeaderText="Permission" Width="200" />
                                        <GridColumn Field="@nameof(EffectivePermissionDto.PermissionCode)" HeaderText="Code" Width="170" />
                                        <GridColumn Field="@nameof(EffectivePermissionDto.ResourceCode)" HeaderText="Resource" Width="130" />
                                        <GridColumn Field="@nameof(EffectivePermissionDto.ActionCode)" HeaderText="Action" Width="110" />
                                        <GridColumn Field="@nameof(EffectivePermissionDto.GrantSource)" HeaderText="Source" Width="120">
                                            <Template>
                                                @{ var p = (EffectivePermissionDto)context; }
                                                <span class="badge @(p.GrantSource == "Role" ? "badge-blue" : "badge-green")">@p.GrantSource</span>
                                            </Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(EffectivePermissionDto.RoleName)" HeaderText="Role" Width="150">
                                            <Template>
                                                @{ var p = (EffectivePermissionDto)context; }
                                                <span>@(p.RoleName ?? "Direct")</span>
                                            </Template>
                                        </GridColumn>
                                        <GridColumn Field="@nameof(EffectivePermissionDto.ExpiresDateUtc)" HeaderText="Expires" Width="110">
                                            <Template>
                                                @{ var p = (EffectivePermissionDto)context; }
                                                <span>@(p.ExpiresDateUtc?.ToString("d") ?? "Never")</span>
                                            </Template>
                                        </GridColumn>
                                    </GridColumns>
                                </SfGrid>
                            }

                            <div class="ud-section-heading-row ud-section-heading-row--spaced">
                                <h3 class="ud-section-title">Direct Permission Overrides</h3>
                                <span class="ud-tab-count">@_permissions.Count explicit override(s)</span>
                            </div>
                            <SfGrid DataSource="_permissions"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    CssClass="e-grid--compact">
                                <GridPageSettings PageSize="15" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(UserPermissionDto.PermissionName)"  HeaderText="Permission"  Width="180" />
                                    <GridColumn Field="@nameof(UserPermissionDto.PermissionCode)"  HeaderText="Code"        Width="150" />
                                    <GridColumn Field="@nameof(UserPermissionDto.ResourceCode)"    HeaderText="Resource"    Width="130" />
                                    <GridColumn Field="@nameof(UserPermissionDto.ActionCode)"      HeaderText="Action"      Width="110" />
                                    <GridColumn Field="@nameof(UserPermissionDto.IsGranted)"       HeaderText="Grant"       Width="90" TextAlign="TextAlign.Center">
                                        <Template>
                                            @{ var p = (UserPermissionDto)context; }
                                            <AppStatusBadge Status="@(p.IsGranted ? "Active" : "Inactive")"
                                                            Label="@(p.IsGranted ? "Granted" : "Denied")" />
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(UserPermissionDto.GrantedByFullName)" HeaderText="Granted By" Width="150" />
                                    <GridColumn Field="@nameof(UserPermissionDto.GrantedDateUtc)"    HeaderText="Granted"    Width="120">
                                        <Template>
                                            @{ var p = (UserPermissionDto)context; }
                                            <span>@p.GrantedDateUtc.ToString("d")</span>
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(UserPermissionDto.ExpiresDateUtc)" HeaderText="Expires" Width="110">
                                        <Template>
                                            @{ var p = (UserPermissionDto)context; }
                                            <span>@(p.ExpiresDateUtc?.ToString("d") ?? "—")</span>
                                        </Template>
                                    </GridColumn>
                                    <GridColumn HeaderText="" Width="90" TextAlign="TextAlign.Center">
                                        <Template>
                                            @{ var p = (UserPermissionDto)context; }
                                            <button class="um-btn um-btn-ghost um-btn--xs" @onclick="() => RevokePermissionAsync(p)">
                                                <i class="bi bi-x-circle" aria-hidden="true"></i> Revoke
                                            </button>
                                        </Template>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 4: Scope -->
            <TabItem>
                <ChildContent><TabHeader Text="Scope" IconCss="bi bi-diagram-3" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        <div class="ud-tab-toolbar">
                            <span class="ud-tab-count">@_scopes.Count scope(s)</span>
                            <button class="um-btn um-btn-ghost" @onclick="OpenAddScope">
                                <i class="bi bi-plus-circle" aria-hidden="true"></i> Add Scope
                            </button>
                        </div>
                        @if (_scopesLoading)
                        {
                            <div class="ud-tab-loading"><span class="um-spin" aria-hidden="true"></span></div>
                        }
                        else
                        {
                            <SfGrid DataSource="_scopes"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    CssClass="e-grid--compact">
                                <GridPageSettings PageSize="15" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(UserScopeDto.ScopeTypeCode)" HeaderText="Scope Type"  Width="150" />
                                    <GridColumn Field="@nameof(UserScopeDto.ScopeValue)"    HeaderText="Value"       Width="180" />
                                    <GridColumn Field="@nameof(UserScopeDto.IsActive)"      HeaderText="Active"      Width="90" TextAlign="TextAlign.Center">
                                        <Template>
                                            @{ var s = (UserScopeDto)context; }
                                            <AppStatusBadge Status="@(s.IsActive ? "Active" : "Inactive")" />
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(UserScopeDto.GrantedByFullName)" HeaderText="Granted By"  Width="160" />
                                    <GridColumn Field="@nameof(UserScopeDto.GrantedDateUtc)"    HeaderText="Granted"     Width="120">
                                        <Template>
                                            @{ var s = (UserScopeDto)context; }
                                            <span>@s.GrantedDateUtc.ToString("d")</span>
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(UserScopeDto.ExpiresDateUtc)" HeaderText="Expires" Width="110">
                                        <Template>
                                            @{ var s = (UserScopeDto)context; }
                                            <span>@(s.ExpiresDateUtc?.ToString("d") ?? "—")</span>
                                        </Template>
                                    </GridColumn>
                                    <GridColumn HeaderText="" Width="90" TextAlign="TextAlign.Center">
                                        <Template>
                                            @{ var s = (UserScopeDto)context; }
                                            <button class="um-btn um-btn-ghost um-btn--xs" @onclick="() => RevokeScopeAsync(s)">
                                                <i class="bi bi-x-circle" aria-hidden="true"></i> Revoke
                                            </button>
                                        </Template>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 5: Sessions -->
            <TabItem>
                <ChildContent><TabHeader Text="Sessions" IconCss="bi bi-display" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        <div class="ud-tab-toolbar">
                            <span class="ud-tab-count">@_sessions.Count session(s)</span>
                            <button class="um-btn um-btn-ghost" @onclick="RevokeSessionsAsync">
                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Revoke All Sessions
                            </button>
                        </div>
                        @if (_sessionsLoading)
                        {
                            <div class="ud-tab-loading"><span class="um-spin" aria-hidden="true"></span></div>
                        }
                        else if (_sessions.Count == 0)
                        {
                            <div class="ts-empty">
                                <i class="bi bi-display ts-empty-icon" aria-hidden="true"></i>
                                <div class="ts-empty-title">No sessions</div>
                                <div class="ts-empty-sub">No active or historical sessions were found for this user.</div>
                            </div>
                        }
                        else
                        {
                            <SfGrid DataSource="_sessions" AllowPaging="true" AllowSorting="true" CssClass="e-grid--compact">
                                <GridPageSettings PageSize="10" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(UserSessionDto.DeviceType)" HeaderText="Device" Width="120" />
                                    <GridColumn Field="@nameof(UserSessionDto.IpAddress)" HeaderText="IP Address" Width="130" />
                                    <GridColumn Field="@nameof(UserSessionDto.UserAgent)" HeaderText="User Agent" Width="180" />
                                    <GridColumn Field="@nameof(UserSessionDto.LoginDateUtc)" HeaderText="Login" Width="130">
                                        <Template>
                                            @{ var s = (UserSessionDto)context; }
                                            <span>@s.LoginDateUtc.ToString("g")</span>
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(UserSessionDto.LastActivityDateUtc)" HeaderText="Last Activity" Width="130">
                                        <Template>
                                            @{ var s = (UserSessionDto)context; }
                                            <span>@(s.LastActivityDateUtc?.ToString("g") ?? "—")</span>
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(UserSessionDto.IsRevoked)" HeaderText="Status" Width="100">
                                        <Template>
                                            @{ var s = (UserSessionDto)context; }
                                            <AppStatusBadge Status="@SessionStatus(s)" />
                                        </Template>
                                    </GridColumn>
                                    <GridColumn HeaderText="" Width="90" TextAlign="TextAlign.Center">
                                        <Template>
                                            @{ var s = (UserSessionDto)context; }
                                            <button class="um-btn um-btn-ghost um-btn--xs" @onclick="() => RevokeSessionAsync(s)" disabled="@(s.IsRevoked || s.ExpiresDateUtc <= DateTime.UtcNow)">
                                                <i class="bi bi-x-circle" aria-hidden="true"></i> Revoke
                                            </button>
                                        </Template>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 6: MFA -->
            <TabItem>
                <ChildContent><TabHeader Text="MFA" IconCss="bi bi-shield-lock" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        <div class="ud-security-grid">
                            <div class="@MfaCardClass ud-sec-card--wide">
                                <span class="@MfaIconClass" aria-hidden="true">
                                    <i class="bi bi-shield-check-fill"></i>
                                </span>
                                <div>
                                    <div class="ud-sec-label">Multi-Factor Authentication</div>
                                    <div class="ud-sec-value">@MfaValueText</div>
                                    @if (_user.MfaEnabled)
                                    {
                                        <div class="ud-sec-detail">MFA enrolled</div>
                                    }
                                    <button class="um-btn um-btn-primary ud-sec-action" @onclick="ToggleMfaAsync">
                                        <i class="bi bi-shield-check" aria-hidden="true"></i> @(_user.MfaEnabled ? "Disable MFA" : "Enable MFA")
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="ud-info-card">
                            <h3 class="ud-section-title">MFA Operations</h3>
                            <div class="ud-profile-grid">
                                <div class="ud-field-group">
                                    <span class="ts-label">Enrollment State</span>
                                    <span class="ts-value">@MfaValueText</span>
                                </div>
                                <div class="ud-field-group">
                                    <span class="ts-label">Policy Action</span>
                                    <span class="ts-value">@(_user.MfaEnabled ? "User will be challenged at sign-in." : "Enable MFA to require stronger authentication.")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 7: Login History -->
            <TabItem>
                <ChildContent><TabHeader Text="Login History" IconCss="bi bi-clock-history" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        <div class="ud-tab-toolbar">
                            <span class="ud-tab-count">@_sessions.Count login event(s)</span>
                        </div>
                        @if (_sessionsLoading)
                        {
                            <div class="ud-tab-loading"><span class="um-spin" aria-hidden="true"></span></div>
                        }
                        else
                        {
                            <div class="ud-login-timeline">
                                @foreach (var session in _sessions.OrderByDescending(s => s.LoginDateUtc))
                                {
                                    <div class="ud-login-item">
                                        <span class="ud-login-icon"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i></span>
                                        <div>
                                            <div class="ud-login-title">@session.DeviceType session from @(session.IpAddress ?? "unknown IP")</div>
                                            <div class="ud-login-meta">@session.LoginDateUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt") · @SessionStatus(session)</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 8: Audit -->
            <TabItem>
                <ChildContent><TabHeader Text="Audit" IconCss="bi bi-journal-text" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        <AppAuditPanel Entries="_auditEntries"
                                       Loading="_auditLoading"
                                       Title="User Audit Trail" />
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 9: Access Requests -->
            <TabItem>
                <ChildContent><TabHeader Text="Access Requests" IconCss="bi bi-hand-index" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        <div class="ud-tab-toolbar"><span class="ud-tab-count">@_accessRequests.Count request(s)</span></div>
                        @if (_accessRequestsLoading)
                        {
                            <div class="ud-tab-loading"><span class="um-spin" aria-hidden="true"></span></div>
                        }
                        else if (_accessRequests.Count == 0)
                        {
                            <div class="ts-empty">
                                <i class="bi bi-hand-index ts-empty-icon" aria-hidden="true"></i>
                                <div class="ts-empty-title">No access requests</div>
                                <div class="ts-empty-sub">No submitted access requests are associated with this user.</div>
                            </div>
                        }
                        else
                        {
                            <SfGrid DataSource="_accessRequests" AllowPaging="true" AllowSorting="true" CssClass="e-grid--compact">
                                <GridPageSettings PageSize="10" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(AccessRequestDto.RequestTypeCode)" HeaderText="Type" Width="130" />
                                    <GridColumn Field="@nameof(AccessRequestDto.RoleName)" HeaderText="Role" Width="160" />
                                    <GridColumn Field="@nameof(AccessRequestDto.PermissionName)" HeaderText="Permission" Width="180" />
                                    <GridColumn Field="@nameof(AccessRequestDto.StatusCode)" HeaderText="Status" Width="110">
                                        <Template>
                                            @{ var r = (AccessRequestDto)context; }
                                            <AppStatusBadge Status="@r.StatusCode" />
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(AccessRequestDto.CreatedDateUtc)" HeaderText="Submitted" Width="130">
                                        <Template>
                                            @{ var r = (AccessRequestDto)context; }
                                            <span>@r.CreatedDateUtc.ToString("d")</span>
                                        </Template>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 10: Policy Acknowledgements -->
            <TabItem>
                <ChildContent><TabHeader Text="Policy Acknowledgements" IconCss="bi bi-file-check" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        <div class="ud-tab-toolbar"><span class="ud-tab-count">@_acknowledgements.Count acknowledgement(s)</span></div>
                        @if (_ackLoading)
                        {
                            <div class="ud-tab-loading"><span class="um-spin" aria-hidden="true"></span></div>
                        }
                        else if (_acknowledgements.Count == 0)
                        {
                            <div class="ts-empty">
                                <i class="bi bi-file-check ts-empty-icon" aria-hidden="true"></i>
                                <div class="ts-empty-title">No acknowledgements</div>
                                <div class="ts-empty-sub">No policy acknowledgement records matched this user.</div>
                            </div>
                        }
                        else
                        {
                            <SfGrid DataSource="_acknowledgements" AllowPaging="true" AllowSorting="true" CssClass="e-grid--compact">
                                <GridPageSettings PageSize="10" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(AcknowledgementDetailDto.PolicyTitle)" HeaderText="Policy" Width="220" />
                                    <GridColumn Field="@nameof(AcknowledgementDetailDto.UserFullName)" HeaderText="User" Width="160" />
                                    <GridColumn Field="@nameof(AcknowledgementDetailDto.StatusCode)" HeaderText="Status" Width="110">
                                        <Template>
                                            @{ var a = (AcknowledgementDetailDto)context; }
                                            <AppStatusBadge Status="@a.StatusCode" />
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(AcknowledgementDetailDto.AcknowledgedDateUtc)" HeaderText="Acknowledged" Width="140">
                                        <Template>
                                            @{ var a = (AcknowledgementDetailDto)context; }
                                            <span>@(a.AcknowledgedDateUtc == default ? "—" : a.AcknowledgedDateUtc.ToString("d"))</span>
                                        </Template>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 11: Branch Access -->
            <TabItem>
                <ChildContent><TabHeader Text="Branch Access" IconCss="bi bi-building" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        <div class="ud-tab-toolbar">
                            <span class="ud-tab-count">@_branchAccess.Count branch assignment(s)</span>
                            <button class="um-btn um-btn-ghost" @onclick="OpenBranchAssign">
                                <i class="bi bi-plus-circle" aria-hidden="true"></i> Assign Branch
                            </button>
                        </div>
                        @if (_branchAccessLoading)
                        {
                            <div class="ud-tab-loading"><span class="um-spin" aria-hidden="true"></span></div>
                        }
                        else if (_branchAccess.Count == 0)
                        {
                            <div class="ts-empty">
                                <i class="bi bi-building ts-empty-icon" aria-hidden="true"></i>
                                <div class="ts-empty-title">No branch assignments</div>
                                <div class="ts-empty-sub">This user has not been assigned to any branch.</div>
                            </div>
                        }
                        else
                        {
                            <SfGrid DataSource="_branchAccess"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    CssClass="e-grid--compact">
                                <GridPageSettings PageSize="15" />
                                <GridColumns>
                                    <GridColumn Field="@nameof(UserBranchAccessDto.BranchName)"   HeaderText="Branch"      Width="180" />
                                    <GridColumn Field="@nameof(UserBranchAccessDto.BranchCode)"   HeaderText="Code"        Width="130" />
                                    <GridColumn Field="@nameof(UserBranchAccessDto.AccessLevel)"  HeaderText="Access Level" Width="130" />
                                    <GridColumn Field="@nameof(UserBranchAccessDto.IsActive)"     HeaderText="Active"      Width="90" TextAlign="TextAlign.Center">
                                        <Template>
                                            @{ var b = (UserBranchAccessDto)context; }
                                            <AppStatusBadge Status="@(b.IsActive ? "Active" : "Inactive")" />
                                        </Template>
                                    </GridColumn>
                                    <GridColumn Field="@nameof(UserBranchAccessDto.AssignedDateUtc)" HeaderText="Assigned" Width="120">
                                        <Template>
                                            @{ var b = (UserBranchAccessDto)context; }
                                            <span>@b.AssignedDateUtc.ToString("d")</span>
                                        </Template>
                                    </GridColumn>
                                    <GridColumn HeaderText="" Width="90" TextAlign="TextAlign.Center">
                                        <Template>
                                            @{ var b = (UserBranchAccessDto)context; }
                                            <button class="um-btn um-btn-ghost um-btn--xs" @onclick="() => RevokeBranchAccessAsync(b)">
                                                <i class="bi bi-x-circle" aria-hidden="true"></i> Remove
                                            </button>
                                        </Template>
                                    </GridColumn>
                                </GridColumns>
                            </SfGrid>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 12: Teams -->
            <TabItem>
                <ChildContent><TabHeader Text="Teams" IconCss="bi bi-people" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        <div class="ud-tab-toolbar">
                            <span class="ud-tab-count">@_userTeams.Count team(s)</span>
                            <button class="um-btn um-btn-ghost" @onclick="OpenAddTeam">
                                <i class="bi bi-plus-circle" aria-hidden="true"></i> Add to Team
                            </button>
                        </div>
                        @if (_teamsLoading)
                        {
                            <div class="ud-tab-loading"><span class="um-spin" aria-hidden="true"></span></div>
                        }
                        else if (_userTeams.Count == 0)
                        {
                            <div class="ts-empty">
                                <i class="bi bi-people ts-empty-icon" aria-hidden="true"></i>
                                <div class="ts-empty-title">No team memberships</div>
                                <div class="ts-empty-sub">This user is not a member of any team.</div>
                            </div>
                        }
                        else
                        {
                            <div class="ud-team-chips">
                                @foreach (var team in _userTeams)
                                {
                                    <div class="ud-team-chip">
                                        <span class="ud-team-chip-icon"><i class="bi bi-people-fill" aria-hidden="true"></i></span>
                                        <span class="ud-team-chip-name">@team.TeamName</span>
                                        <span class="ud-team-chip-role">@team.MemberRole</span>
                                        <button class="um-btn um-btn-xs um-btn-ghost ud-team-chip-remove"
                                                @onclick="() => LeaveTeamAsync(team)"
                                                title="Remove from team">
                                            <i class="bi bi-x" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 13: License -->
            <TabItem>
                <ChildContent><TabHeader Text="License" IconCss="bi bi-award" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        @if (_licenseLoading)
                        {
                            <div class="ud-tab-loading"><span class="um-spin" aria-hidden="true"></span></div>
                        }
                        else if (_license is null)
                        {
                            <div class="ts-empty">
                                <i class="bi bi-award ts-empty-icon" aria-hidden="true"></i>
                                <div class="ts-empty-title">No license assigned</div>
                                <div class="ts-empty-sub">This user does not have a license assigned.</div>
                            </div>
                        }
                        else
                        {
                            <div class="ud-license-card">
                                <div class="ud-license-icon"><i class="bi bi-award-fill" aria-hidden="true"></i></div>
                                <div class="ud-license-body">
                                    <div class="ud-license-name">@_license.LicenseName</div>
                                    <div class="ud-license-meta">
                                        <span class="ud-stat-chip"><i class="bi bi-tag" aria-hidden="true"></i> @_license.LicenseType</span>
                                        <AppStatusBadge Status="@(_license.IsActive ? "Active" : "Inactive")" />
                                        @if (_license.ExpiresDateUtc.HasValue)
                                        {
                                            <span class="ud-stat-chip">
                                                <i class="bi bi-calendar-x" aria-hidden="true"></i>
                                                Expires @_license.ExpiresDateUtc.Value.ToString("d")
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

            <!-- 14: Notifications -->
            <TabItem>
                <ChildContent><TabHeader Text="Notifications" IconCss="bi bi-bell" /></ChildContent>
                <ContentTemplate>
                    <div class="ud-tab-body">
                        @if (_notifLoading)
                        {
                            <div class="ud-tab-loading"><span class="um-spin" aria-hidden="true"></span></div>
                        }
                        else
                        {
                            <div class="ud-info-card">
                                <h3 class="ud-section-title">Notification Preferences</h3>
                                @if (_notifPrefs.Count == 0)
                                {
                                    <p class="ud-tab-count">No notification preferences configured.</p>
                                }
                                else
                                {
                                    <div class="ud-notif-list">
                                        @foreach (var pref in _notifPrefs)
                                        {
                                            <div class="ud-notif-row">
                                                <div class="ud-notif-name">@pref.NotificationTypeName</div>
                                                <div class="ud-notif-channels">
                                                    @foreach (var ch in pref.EnabledChannels)
                                                    {
                                                        <span class="ud-stat-chip">@ch</span>
                                                    }
                                                </div>
                                                <AppStatusBadge Status="@(pref.IsEnabled ? "Active" : "Inactive")"
                                                                Label="@(pref.IsEnabled ? "On" : "Off")" />
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </TabItem>

        </Tabs>
    </AppDetailTabs>
}

<!-- ═══════════════════════════════════════════════════════════════════════════════
     Edit User drawer
═══════════════════════════════════════════════════════════════════════════════ -->
<UserEditDrawer @bind-Visible="_showEdit"
                UserId="_editUserId"
                OnSaved="HandleEditSavedAsync" />

<!-- Add Scope drawer -->
<AppCrudDrawer @bind-Visible="_showAddScope"
               Title="Add Scope"
               Icon="bi-diagram-3"
               Width="480px"
               IsBusy="_saving"
               ConfirmText="Add Scope"
               OnConfirm="SaveScopeAsync"
               OnClose="CloseAddScope">
    <Content>
        <div class="form-row">
            <label class="form-label">Scope Type <span class="req">*</span></label>
            <SfTextBox @bind-Value="_scopeForm.ScopeTypeCode" Placeholder="e.g. Branch, Region" />
        </div>
        <div class="form-row">
            <label class="form-label">Scope Value <span class="req">*</span></label>
            <SfTextBox @bind-Value="_scopeForm.ScopeValue" Placeholder="e.g. BRANCH-001" />
        </div>
    </Content>
</AppCrudDrawer>

<!-- ═══════════════════════════════════════════════════════════════════════════════
     Confirm dialogs
═══════════════════════════════════════════════════════════════════════════════ -->
<AppConfirmActionDialog @bind-Visible="_showDisable"
                        Title="Disable User"
                        Message="@DisableMessage"
                        Detail="The user will no longer be able to sign in. You can re-enable them at any time."
                        Variant="warning"
                        ConfirmText="Disable"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteDisableAsync" />

<AppConfirmActionDialog @bind-Visible="_showEnable"
                        Title="Enable User"
                        Message="@EnableMessage"
                        Detail="The user will regain sign-in access immediately."
                        Variant="primary"
                        ConfirmText="Enable"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteEnableAsync" />

<AppConfirmActionDialog @bind-Visible="_showUnlock"
                        Title="Unlock Account"
                        Message="@UnlockMessage"
                        Detail="The lockout will be removed and the user can sign in again."
                        Variant="warning"
                        ConfirmText="Unlock"
                        IsBusy="_confirming"
                        OnConfirm="ExecuteUnlockAsync" />

<!-- ═══════════════════════════════════════════════════════════════════════════════
     Lookup dialogs
═══════════════════════════════════════════════════════════════════════════════ -->
<SfDialog @bind-Visible="_showAddRole" Width="520px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="ul-dlg-header"><i class="bi bi-person-plus" aria-hidden="true"></i> Add Role</span></Header>
        <Content>
            <div class="ul-dlg-body">
                <div class="form-row">
                    <label class="form-label">Role <span class="form-required">*</span></label>
                    <SfDropDownList TValue="Guid" TItem="RoleDto"
                                    DataSource="_pickRoles"
                                    @bind-Value="_selectedRoleId"
                                    Placeholder="Select role…"
                                    AllowFiltering="true">
                        <DropDownListFieldSettings Value="RoleId" Text="RoleName" />
                    </SfDropDownList>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="ul-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showAddRole = false" disabled="@_confirming">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="AssignSelectedRoleAsync" disabled="@(_selectedRoleId == Guid.Empty || _confirming)">
                    @if (_confirming) { <span class="ud-spin"></span> } else { <i class="bi bi-check-lg" aria-hidden="true"></i> }
                    Add Role
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<SfDialog @bind-Visible="_showAddPerm" Width="720px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="ul-dlg-header"><i class="bi bi-key" aria-hidden="true"></i> Add Permission Overrides</span></Header>
        <Content>
            <div class="ul-dlg-body">
                <div class="ud-permission-command">
                    <div class="um-search-box">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input class="um-search-input" placeholder="Search permissions…" @bind="_permPickSearch" @bind:event="oninput" />
                    </div>
                    <SfDropDownList TValue="string" TItem="LabelValue"
                                    DataSource="_grantTypeOptions"
                                    @bind-Value="_permissionGrantType"
                                    Width="140px">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
                <div class="ud-permission-checklist">
                    @foreach (var permission in FilteredPickPermissions)
                    {
                        <label class="ud-permission-option">
                            <input type="checkbox" checked="@_selectedPermissionIds.Contains(permission.PermissionId)" @onchange="args => TogglePermissionSelection(permission.PermissionId, args)" />
                            <span>
                                <strong>@permission.PermissionName</strong>
                                <small>@permission.PermissionCode · @permission.ResourceCode / @permission.ActionCode</small>
                            </span>
                        </label>
                    }
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="ul-dlg-footer">
                <span class="ud-tab-count me-auto">@_selectedPermissionIds.Count selected</span>
                <button class="um-btn um-btn-ghost" @onclick="() => _showAddPerm = false" disabled="@_confirming">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="GrantSelectedPermissionsAsync" disabled="@(_selectedPermissionIds.Count == 0 || _confirming)">
                    @if (_confirming) { <span class="ud-spin"></span> } else { <i class="bi bi-check-lg" aria-hidden="true"></i> }
                    Apply Permissions
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ── Branch Assign dialog ────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showBranchAssign"
          Width="440px"
          IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <span class="ul-dlg-header">
                <i class="bi bi-building" aria-hidden="true"></i> Assign Branch
            </span>
        </Header>
        <Content>
            <div class="ul-dlg-body">
                <p class="ul-dlg-hint">Assign <strong>@(_user?.FullName ?? "this user")</strong> to a branch.</p>
                <div class="form-row">
                    <label class="form-label">Branch <span class="form-required">*</span></label>
                    <SfDropDownList TValue="string" TItem="BranchDto"
                                    DataSource="_allBranches"
                                    @bind-Value="_assignBranchCode"
                                    Placeholder="Select branch…">
                        <DropDownListFieldSettings Value="BranchCode" Text="BranchName" />
                    </SfDropDownList>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="ul-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showBranchAssign = false" disabled="@_confirming">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="ExecuteBranchAssignAsync"
                        disabled="@(string.IsNullOrEmpty(_assignBranchCode) || _confirming)">
                    @if (_confirming)
                    {
                        <span class="ud-spin"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                    }
                    Assign Branch
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ── Add Team dialog ─────────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showAddTeam"
          Width="440px"
          IsModal="true"
          ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <span class="ul-dlg-header">
                <i class="bi bi-people" aria-hidden="true"></i> Add to Team
            </span>
        </Header>
        <Content>
            <div class="ul-dlg-body">
                <p class="ul-dlg-hint">Add <strong>@(_user?.FullName ?? "this user")</strong> to a team.</p>
                <div class="form-row">
                    <label class="form-label">Team <span class="form-required">*</span></label>
                    <SfDropDownList TValue="string" TItem="LabelValue"
                                    DataSource="_teamOptions"
                                    @bind-Value="_addTeamCode"
                                    Placeholder="Select team…">
                        <DropDownListFieldSettings Value="Value" Text="Label" />
                    </SfDropDownList>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="ul-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showAddTeam = false" disabled="@_confirming">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="ExecuteAddTeamAsync"
                        disabled="@(string.IsNullOrEmpty(_addTeamCode) || _confirming)">
                    @if (_confirming)
                    {
                        <span class="ud-spin"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                    }
                    Add to Team
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    Guid TenantId { get; set; }
