    // ── Branch / Team assign fields ───────────────────────────────────────────────
    private List<BranchDto> _allBranches     = [];
    private List<DepartmentTeamDto> _allTeams = [];
    private string          _assignBranchCode = string.Empty;
    private string          _addTeamCode      = string.Empty;

    private List<LabelValue> _teamOptions = [];

    // ── Picker state ──────────────────────────────────────────────────────────────
    private List<RoleDto>       _pickRoles = [];
    private List<PermissionDto> _pickPerms = [];
    private string _permPickSearch = string.Empty;
    private Guid _selectedRoleId = Guid.Empty;
    private readonly HashSet<Guid> _selectedPermissionIds = [];
    private string _permissionGrantType = "Allow";

    private static readonly List<LabelValue> _grantTypeOptions =
    [
        new("Allow", "Allow"),
        new("Deny", "Deny"),
    ];

    private IEnumerable<PermissionDto> FilteredPickPermissions => _pickPerms.Where(p =>
        string.IsNullOrWhiteSpace(_permPickSearch) ||
        p.PermissionName.Contains(_permPickSearch, StringComparison.OrdinalIgnoreCase) ||
        p.PermissionCode.Contains(_permPickSearch, StringComparison.OrdinalIgnoreCase) ||
        p.ResourceCode.Contains(_permPickSearch, StringComparison.OrdinalIgnoreCase) ||
        p.ActionCode.Contains(_permPickSearch, StringComparison.OrdinalIgnoreCase));

    // ── Form models ───────────────────────────────────────────────────────────────
    private ScopeFormModel _scopeForm = new();

    // ── Computed string properties (HTML-attribute safe) ──────────────────────────
    private string PageTitle    => _user?.FullName ?? "User Detail";
    private string PageSubtitle => _user?.Email    ?? string.Empty;
    private string DisableMessage => "Disable " + (_user?.FullName ?? "this user") + "?";
    private string EnableMessage  => "Enable "  + (_user?.FullName ?? "this user") + "?";
    private string UnlockMessage  => "Unlock account for " + (_user?.FullName ?? "this user") + "?";

    private string MfaValueText  => _user is null ? "—" : (_user.MfaEnabled  ? "Enabled"   : "Disabled");
    private string LockValueText => _user is null ? "—" : (_user.IsLockedOut ? "Locked Out" : "Unlocked");

    private string MfaIconClass => _user?.MfaEnabled == true
        ? "ud-sec-icon ud-sec-icon--on"
        : "ud-sec-icon ud-sec-icon--off";

    private string MfaCardClass => _user?.MfaEnabled == true
        ? "ud-sec-card ud-sec-card--on"
        : "ud-sec-card ud-sec-card--off";

    private string LockIconClass => _user?.IsLockedOut == true
        ? "ud-sec-icon ud-sec-icon--danger"
        : "ud-sec-icon ud-sec-icon--neutral";

    private string LockCardClass => _user?.IsLockedOut == true
        ? "ud-sec-card ud-sec-card--danger"
        : "ud-sec-card";

    private int AssignedRoleCount => _userRoles.Count > 0 ? _userRoles.Count : _user?.AssignedRoleCount ?? 0;

    private int EffectivePermissionCount => _effectivePermissions.Count;

    private int ScopeCount => _scopes.Count;

    private int BranchAccessCount => _user?.BranchId is not null ? 1 : _branchAccess.Count;

    private int TeamCount => _userTeams.Count > 0
        ? _userTeams.Count
        : HasAssignedTeam ? 1 : 0;

    private bool HasAssignedTeam =>
        !string.IsNullOrWhiteSpace(_user?.JobTitle) ||
        (!string.IsNullOrWhiteSpace(_user?.Department) && _allTeams.Any(t =>
            !string.IsNullOrWhiteSpace(t.DepartmentName) &&
            string.Equals(t.DepartmentName, _user.Department, StringComparison.OrdinalIgnoreCase)));

    private string TabKpiClass(int tab) => _tab == tab ? "ud-kpi-card--active" : string.Empty;

    private async Task RefreshKpisAsync()
    {
        _user = await Api.GetUserByIdAsync(UserId);
        await LoadRolesTabAsync();
        await LoadPermissionsTabAsync();
        await LoadScopesTabAsync();
        await LoadBranchAccessTabAsync();
        await LoadTeamsTabAsync();
        StateHasChanged();
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────────
    protected override async Task OnParametersSetAsync()
    {
        if (_user?.UserId == UserId) return;
        await LoadUserAsync();
    }

    private async Task LoadUserAsync()
    {
        _loading = true;
        _user    = null;
        _profile = null;
        _userRoles.Clear();
        _permissions.Clear();
        _scopes.Clear();
        _sessions.Clear();
        _accessRequests.Clear();
        _acknowledgements.Clear();
        _branchAccess.Clear();
        _userTeams.Clear();
        _license    = null;
        _notifPrefs.Clear();
        StateHasChanged();

        try
        {
            _user        = await Api.GetUserByIdAsync(UserId);
            _profile     = await Api.GetUserProfileAsync(UserId);
            _allBranches = (await Api.SearchBranchesAsync(_tenantId))?.Items.ToList() ?? [];
            _allTeams    = (await Api.GetTeamsAsync(_tenantId))?.ToList() ?? [];
            _teamOptions = _allTeams
                .Where(t => t.IsActive)
                .OrderBy(t => t.TeamName)
                .Select(t => new LabelValue(t.TeamCode ?? t.TeamName, t.TeamName))
                .ToList();
            SetCrumbs();
            await LoadRolesTabAsync();
            await LoadPermissionsTabAsync();
            await LoadScopesTabAsync();
            await LoadTeamsTabAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetCrumbs()
    {
        Breadcrumbs.SetCrumbs(
            new("Home",  "/"),
            new("Administration", "/tenant/security/users"),
            new("Users", "/tenant/security/users"),
            new(_user?.FullName ?? "User", null));
    }

    // ── Tab handling ──────────────────────────────────────────────────────────────
    private async Task OnTabChangedAsync(int tab)
    {
        await SetTabAsync(tab);
    }

    private async Task SetTabAsync(int tab)
    {
        _tab = tab;
        await LoadTabDataAsync(tab);
    }

    private async Task LoadTabDataAsync(int tab)
    {
        switch (tab)
        {
            case 2 when !_userRoles.Any():
                await LoadRolesTabAsync();
                break;
            case 3 when !_permissions.Any():
                await LoadPermissionsTabAsync();
                break;
            case 4 when !_scopes.Any():
                await LoadScopesTabAsync();
                break;
            case 5 when !_sessions.Any():
            case 7 when !_sessions.Any():
                await LoadSessionsTabAsync();
                break;
            case 8 when !_auditEntries.Any():
                await LoadAuditTabAsync();
                break;
            case 9 when !_accessRequests.Any():
                await LoadAccessRequestsTabAsync();
                break;
            case 10 when !_acknowledgements.Any():
                await LoadAcknowledgementsTabAsync();
                break;
            case 11 when !_branchAccess.Any():
                await LoadBranchAccessTabAsync();
                break;
            case 12 when !_userTeams.Any():
                await LoadTeamsTabAsync();
                break;
            case 13 when _license is null:
                await LoadLicenseTabAsync();
                break;
            case 14 when !_notifPrefs.Any():
                await LoadNotifTabAsync();
                break;
        }
    }

    private async Task LoadRolesTabAsync()
    {
        _rolesLoading = true;
        StateHasChanged();
        try
        {
            var result = await Api.SearchUserRolesAsync(_tenantId, UserId, null, null, pageSize: 1000);
            _userRoles = result?.Items.ToList() ?? [];
        }
        finally
        {
            _rolesLoading = false;
        }
    }

    private async Task LoadPermissionsTabAsync()
    {
        _permsLoading = true;
        StateHasChanged();
        try
        {
            var result = await Api.GetUserDirectPermissionsAsync(UserId);
            _permissions = result?.ToList() ?? [];
            var effective = await Api.GetEffectivePermissionsAsync(UserId);
            _effectivePermissions = effective?.ToList() ?? [];
        }
        finally
        {
            _permsLoading = false;
        }
    }

    private async Task LoadScopesTabAsync()
    {
        _scopesLoading = true;
        StateHasChanged();
        try
        {
            var result = await Api.GetUserScopesAsync(UserId);
            _scopes = result?.ToList() ?? [];
        }
        finally
        {
            _scopesLoading = false;
        }
    }

    private async Task LoadAuditTabAsync()
    {
        _auditLoading = true;
        StateHasChanged();
        try
        {
            var result = await Api.SearchAuditLogsAsync(searchTerm: UserId.ToString(), tenantId: _tenantId.ToString(), pageSize: 100);
            _auditEntries = result?.Items.Select(a => new AppAuditPanel.AuditEntryVm(
                a.AuditLogId,
                a.EntityName,
                a.ActionName,
                a.EventTypeCode,
                a.PerformedByUserId?.ToString(),
                a.PerformedDateUtc,
                a.OldValues,
                a.NewValues)) ?? [];
        }
        finally
        {
            _auditLoading = false;
        }
    }

    private async Task LoadSessionsTabAsync()
    {
        _sessionsLoading = true;
        StateHasChanged();
        try
        {
            var result = await Api.SearchUserSessionsAsync(_tenantId, UserId);
            _sessions = result?.Items.ToList() ?? [];
        }
        finally
        {
            _sessionsLoading = false;
        }
    }

    private async Task LoadAccessRequestsTabAsync()
    {
        _accessRequestsLoading = true;
        StateHasChanged();
        try
        {
            var result = await Api.SearchAccessRequestsAsync(_tenantId, requestedForUserId: UserId, pageSize: 100);
            _accessRequests = result?.Items.ToList() ?? [];
        }
        finally
        {
            _accessRequestsLoading = false;
        }
    }

    private async Task LoadAcknowledgementsTabAsync()
    {
        _ackLoading = true;
        StateHasChanged();
        try
        {
            var result = await Api.SearchAcknowledgedAsync(_tenantId, searchTerm: _user?.Email ?? _user?.FullName, pageSize: 100);
            _acknowledgements = result?.Items.Where(a => a.UserId == UserId || string.Equals(a.UserEmail, _user?.Email, StringComparison.OrdinalIgnoreCase)).ToList() ?? [];
        }
        finally
        {
            _ackLoading = false;
        }
    }

    // ── Dialog openers / closers ──────────────────────────────────────────────────
    private void OpenEdit()
    {
        if (_user is null) return;
        _editUserId = _user.UserId;
        _showEdit   = true;
    }

    private async Task HandleEditSavedAsync() => await LoadUserAsync();
    private void OpenDisable()       => _showDisable  = true;
    private void OpenEnable()        => _showEnable   = true;
    private void OpenUnlock()        => _showUnlock   = true;
    private async Task OpenAddRole()
    {
        _selectedRoleId = Guid.Empty;
        if (_pickRoles.Count == 0)
        {
            var result = await Api.SearchRolesAsync(_tenantId);
            _pickRoles = result?.Items.Where(r => r.IsActive).OrderBy(r => r.RoleName).ToList() ?? [];
        }
        _showAddRole = true;
    }

    private async Task OpenAddPermission()
    {
        _selectedPermissionIds.Clear();
        _permPickSearch = string.Empty;
        _permissionGrantType = "Allow";
        if (_pickPerms.Count == 0)
        {
            var result = await Api.SearchPermissionsAsync(_tenantId, pageSize: 1000);
            _pickPerms = result?.Items.Where(p => p.IsActive).OrderBy(p => p.PermissionName).ToList() ?? [];
        }
        _showAddPerm = true;
    }
    private void OpenAddScope()      => _showAddScope = true;
    private void CloseAddScope()     => _showAddScope = false;
    private void OpenBranchAssign()
    {
        _assignBranchCode = string.Empty;
        _showBranchAssign = true;
    }
    private void OpenAddTeam()
    {
        _addTeamCode  = string.Empty;
        _showAddTeam  = true;
    }

    // ── Disable / Enable / Unlock
    private async Task ExecuteDisableAsync()
    {
        if (_user is null) return;
        _confirming = true;
        try
        {
            await Api.SetUserActiveAsync(_user.UserId, false, null);
            _showDisable = false;
            await Toast("User disabled.");
            await LoadUserAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Failed to disable user: {ex.Message}", isError: true);
        }
        finally
        {
            _confirming = false;
        }
    }

    private async Task ExecuteEnableAsync()
    {
        if (_user is null) return;
        _confirming = true;
        try
        {
            await Api.SetUserActiveAsync(_user.UserId, true, null);
            _showEnable = false;
            await Toast("User enabled.");
            await LoadUserAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Failed to enable user: {ex.Message}", isError: true);
        }
        finally
        {
            _confirming = false;
        }
    }

    private async Task ExecuteUnlockAsync()
    {
        if (_user is null) return;
        _confirming = true;
        try
        {
            await Api.UnlockUserAsync(_user.UserId, null);
            _showUnlock = false;
            await Toast("Account unlocked.");
            await LoadUserAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Failed to unlock account: {ex.Message}", isError: true);
        }
        finally
        {
            _confirming = false;
        }
    }

    // ── Reset MFA / Revoke Sessions ───────────────────────────────────────────────
    private async Task ResetMfaAsync()
    {
        if (_user is null) return;
        try
        {
            await Api.SetUserMfaAsync(_user.UserId, false);
            await Toast("MFA reset and disabled.");
            await LoadUserAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Failed to reset MFA: {ex.Message}", isError: true);
        }
    }

    private async Task ToggleMfaAsync()
    {
        if (_user is null) return;
        try
        {
            await Api.SetUserMfaAsync(_user.UserId, !_user.MfaEnabled);
            await Toast(_user.MfaEnabled ? "MFA disabled." : "MFA enabled.");
            await LoadUserAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Failed to update MFA: {ex.Message}", isError: true);
        }
    }

    private async Task RevokeSessionsAsync()
    {
        if (_user is null) return;
        try
        {
            await Api.RevokeAllUserSessionsAsync(_tenantId, _user.UserId, "Revoked from user detail");
            await Toast("All active sessions revoked.");
            _sessions.Clear();
            await LoadSessionsTabAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Failed to revoke sessions: {ex.Message}", isError: true);
        }
    }

    private async Task RevokeSessionAsync(UserSessionDto session)
    {
        try
        {
            await Api.RevokeUserSessionAsync(session.SessionId, "Revoked from user detail");
            await Toast("Session revoked.");
            _sessions.Clear();
            await LoadSessionsTabAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Failed to revoke session: {ex.Message}", isError: true);
        }
    }

    // ── Roles ─────────────────────────────────────────────────────────────────────
    private async Task AssignSelectedRoleAsync()
    {
        if (_user is null || _selectedRoleId == Guid.Empty) return;
        _showAddRole = false;
        _confirming = true;
        try
        {
            var req = new AssignUserRoleRequest
            {
                TenantId = _tenantId,
                UserId   = _user.UserId,
                RoleId   = _selectedRoleId,
            };
            await Api.AssignUserRoleAsync(req);
            await Toast("Role assigned.");
            _userRoles.Clear();
            await RefreshKpisAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Failed to assign role: {ex.Message}", isError: true);
        }
        finally
        {
            _confirming = false;
        }
    }

    private async Task RevokeRoleAsync(UserRoleDto userRole)
    {
        try
        {
            await Api.RevokeUserRoleAsync(new RevokeUserRoleRequest { UserRoleId = userRole.UserRoleId });
            _userRoles.Remove(userRole);
            await Toast("Role revoked.");
        }
        catch (Exception ex)
        {
            await Toast($"Failed to revoke role: {ex.Message}", isError: true);
        }
    }

    // ── Permissions ───────────────────────────────────────────────────────────────
    private void TogglePermissionSelection(Guid permissionId, Microsoft.AspNetCore.Components.ChangeEventArgs args)
    {
        if (args.Value is bool selected && selected)
            _selectedPermissionIds.Add(permissionId);
        else
            _selectedPermissionIds.Remove(permissionId);
    }

    private async Task GrantSelectedPermissionsAsync()
    {
        if (_user is null || _selectedPermissionIds.Count == 0) return;
        _showAddPerm = false;
        _confirming = true;
        try
        {
            foreach (var permissionId in _selectedPermissionIds.ToList())
            {
                var req = new GrantUserPermissionRequest
                {
                    TenantId     = _tenantId,
                    UserId       = _user.UserId,
                    PermissionId = permissionId,
                    IsGranted    = _permissionGrantType != "Deny",
                };
                await Api.GrantUserPermissionAsync(_user.UserId, req);
            }
            await Toast($"{_selectedPermissionIds.Count} permission override(s) applied.");
            _selectedPermissionIds.Clear();
            _permissions.Clear();
            await RefreshKpisAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Failed to apply permissions: {ex.Message}", isError: true);
        }
        finally
        {
            _confirming = false;
        }
    }

    private async Task RevokePermissionAsync(UserPermissionDto perm)
    {
        try
        {
            await Api.RevokeUserPermissionAsync(UserId, perm.PermissionId, null);
            _permissions.Remove(perm);
            await Toast("Permission revoked.");
            await RefreshKpisAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Failed to revoke permission: {ex.Message}", isError: true);
        }
    }

    // ── Scopes ────────────────────────────────────────────────────────────────────
    private async Task SaveScopeAsync()
    {
        if (_user is null) return;
        _saving = true;
        try
        {
            var req = new AssignUserScopeRequest
            {
                TenantId      = _tenantId,
                UserId        = _user.UserId,
                ScopeTypeCode = _scopeForm.ScopeTypeCode,
                ScopeValue    = _scopeForm.ScopeValue,
            };
            await Api.AssignUserScopeAsync(req);
            _showAddScope = false;
            _scopeForm    = new();
            await Toast("Scope assigned.");
            _scopes.Clear();
            await RefreshKpisAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Failed to assign scope: {ex.Message}", isError: true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RevokeScopeAsync(UserScopeDto scope)
    {
        try
        {
            await Api.RevokeUserScopeAsync(scope.UserScopeId, null);
            _scopes.Remove(scope);
            await Toast("Scope revoked.");
            await RefreshKpisAsync();
        }
        catch (Exception ex)
        {
            await Toast($"Failed to revoke scope: {ex.Message}", isError: true);
        }
    }

    // ── Branch Access tab ────────────────────────────────────────────────────────
    private async Task LoadBranchAccessTabAsync()
    {
        _branchAccessLoading = true;
        StateHasChanged();
        try
        {
            _branchAccess = _user?.BranchId is null
                ? []
                : _allBranches
                    .Where(b => b.BranchId == _user.BranchId)
                    .Select(b => new UserBranchAccessDto
                    {
                        BranchId = b.BranchId,
                        BranchName = b.BranchName,
                        BranchCode = b.BranchCode,
                        AccessLevel = "Primary",
                        IsActive = b.IsActive,
                        AssignedDateUtc = _user.ModifiedDateUtc ?? _user.CreatedDateUtc,
                    }).ToList();
        }
        finally
        {
            _branchAccessLoading = false;
        }
    }

    private async Task ExecuteBranchAssignAsync()
    {
        if (_user is null || string.IsNullOrEmpty(_assignBranchCode)) return;
        _confirming = true;
        try
        {
            var branchId = _allBranches.FirstOrDefault(b => b.BranchCode == _assignBranchCode)?.BranchId;
            await Api.AssignUserBranchAsync(_user.UserId, branchId);
            await Toast("Branch assigned.");
            _showBranchAssign = false;
            _branchAccess.Clear();
            await RefreshKpisAsync();
        }
        catch (Exception ex) { await Toast(ex.Message, isError: true); }
        finally { _confirming = false; }
    }

    private async Task RevokeBranchAccessAsync(UserBranchAccessDto b)
    {
        try
        {
            if (_user is not null)
                await Api.AssignUserBranchAsync(_user.UserId, null);
            _branchAccess.Remove(b);
            await Toast("Branch access removed.");
            await RefreshKpisAsync();
        }
        catch (Exception ex) { await Toast(ex.Message, isError: true); }
    }

    // ── Teams tab ─────────────────────────────────────────────────────────────────
    private async Task LoadTeamsTabAsync()
    {
        _teamsLoading = true;
        StateHasChanged();
        try
        {
            _userTeams = _allTeams
                .Where(t =>
                    (!string.IsNullOrWhiteSpace(_user?.JobTitle) &&
                        (string.Equals(t.TeamName, _user.JobTitle, StringComparison.OrdinalIgnoreCase) ||
                         string.Equals(t.TeamCode, _user.JobTitle, StringComparison.OrdinalIgnoreCase))) ||
                    (!string.IsNullOrWhiteSpace(t.DepartmentName) &&
                        string.Equals(t.DepartmentName, _user?.Department, StringComparison.OrdinalIgnoreCase)))
                .Select(t => new UserTeamMembershipDto
                {
                    TeamId = t.TeamId,
                    TeamName = t.TeamName,
                    MemberRole = string.Equals(t.TeamName, _user?.JobTitle, StringComparison.OrdinalIgnoreCase) ? "Assigned" : "Member",
                })
                .ToList();

            if (_userTeams.Count == 0 && !string.IsNullOrWhiteSpace(_user?.JobTitle))
            {
                _userTeams =
                [
                    new UserTeamMembershipDto
                    {
                        TeamId = Guid.Empty,
                        TeamName = _user.JobTitle!,
                        MemberRole = "Assigned",
                    },
                ];
            }
        }
        finally
        {
            _teamsLoading = false;
        }
    }

    private async Task ExecuteAddTeamAsync()
    {
        if (_user is null || string.IsNullOrEmpty(_addTeamCode)) return;
        _confirming = true;
        try
        {
            var team = _allTeams.FirstOrDefault(t => (t.TeamCode ?? t.TeamName) == _addTeamCode);
            if (_user is not null && team is not null)
            {
                var req = new UpdateUserRequest
                {
                    UserId = _user.UserId,
                    FullName = _user.FullName,
                    DisplayName = _user.DisplayName,
                    PhoneNumber = _user.PhoneNumber,
                    Department = team.DepartmentName ?? _user.Department,
                    Region = _user.Region,
                    JobTitle = team.TeamName,
                    TimeZoneCode = _user.TimeZoneCode,
                    LocaleCode = _user.LocaleCode,
                };
                await Api.UpdateUserAsync(_user.UserId, req);
            }
            await Toast("Added to team.");
            _showAddTeam = false;
            await RefreshKpisAsync();
        }
        catch (Exception ex) { await Toast(ex.Message, isError: true); }
        finally { _confirming = false; }
    }

    private async Task LeaveTeamAsync(UserTeamMembershipDto team)
    {
        try
        {
            if (_user is not null)
            {
                var req = new UpdateUserRequest
                {
                    UserId = _user.UserId,
                    FullName = _user.FullName,
                    DisplayName = _user.DisplayName,
                    PhoneNumber = _user.PhoneNumber,
                    Department = _user.Department,
                    Region = _user.Region,
                    JobTitle = null,
                    TimeZoneCode = _user.TimeZoneCode,
                    LocaleCode = _user.LocaleCode,
                };
                await Api.UpdateUserAsync(_user.UserId, req);
            }
            _userTeams.Remove(team);
            await Toast("Removed from team.");
            await RefreshKpisAsync();
        }
        catch (Exception ex) { await Toast(ex.Message, isError: true); }
    }

