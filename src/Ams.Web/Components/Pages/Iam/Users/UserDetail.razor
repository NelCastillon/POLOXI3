@page "/iam/users/{UserId:guid}"
@page "/users/{UserId:guid}"
@page "/admin/users/{UserId:guid}"
@page "/tenant/security/users/{UserId:guid}"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@PageTitle — User Security</PageTitle>

@if (_loading)
{
    <div class="udd-loading"><span class="udd-spinner"></span><span>Loading user security profile…</span></div>
}
else if (_user is null)
{
    <div class="udd-empty udd-empty--page">
        <i class="bi bi-person-x" aria-hidden="true"></i>
        <strong>User not found</strong>
        <span>The requested user could not be loaded.</span>
        <button type="button" class="udd-btn udd-btn--primary" @onclick="NavigateToList"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Users</button>
    </div>
}
else
{
    <div class="udd-page">
        <section class="udd-hero">
            <div class="udd-hero__identity">
                <button type="button" class="udd-back" @onclick="NavigateToList"><i class="bi bi-arrow-left" aria-hidden="true"></i> Users</button>
                <div class="udd-hero__main">
                    <div class="udd-avatar" style="@AvatarStyle(_user.FullName)" aria-hidden="true">@Initials(_user.FullName)</div>
                    <div>
                        <div class="udd-hero__eyebrow"><i class="bi bi-person-badge" aria-hidden="true"></i> Enterprise identity profile</div>
                        <h1>@_user.FullName</h1>
                        <p>@_user.Email • @_user.UserName</p>
                        <div class="udd-hero__meta">
                            @StatusPill(_user)
                            @RiskBadge(_user)
                            <span><i class="bi bi-building" aria-hidden="true"></i>@Safe(_user.Department, "Unassigned")</span>
                            <span><i class="bi bi-briefcase" aria-hidden="true"></i>@Safe(_user.JobTitle, "No title")</span>
                            <span><i class="bi bi-clock-history" aria-hidden="true"></i>Last login @FormatRelative(_user.LastLoginDateUtc)</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="udd-hero__actions">
                <button type="button" class="udd-btn udd-btn--light" @onclick="LoadUserAsync" disabled="@_busy"><i class="bi bi-arrow-clockwise @(_busy ? "udd-spin" : null)" aria-hidden="true"></i> Refresh</button>
                <button type="button" class="udd-btn udd-btn--primary" @onclick="OpenEdit"><i class="bi bi-pencil" aria-hidden="true"></i> Edit Profile</button>
                <button type="button" class="udd-btn udd-btn--light" @onclick="() => ConfirmToggleActive(_user)"><i class="bi @(IsActive(_user) ? "bi-person-dash" : "bi-person-check")" aria-hidden="true"></i> @(IsActive(_user) ? "Disable" : "Enable")</button>
                @if (_user.IsLockedOut)
                {
                    <button type="button" class="udd-btn udd-btn--light" @onclick="() => ConfirmUnlock(_user)"><i class="bi bi-unlock" aria-hidden="true"></i> Unlock</button>
                }
            </div>
        </section>

        @if (_loadError is not null)
        {
            <div class="alert alert-danger udd-alert" style="border-left: 4px solid #dc3545; animation: udd-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@_loadError</span></div>
        }

        <section class="udd-kpi-strip" aria-label="User posture KPIs">
            @KpiCard("overview", "Security Score", RiskScore(_user).ToString(), RiskLevel(_user), "bi-shield-fill", RiskTone(_user))
            @KpiCard("access", "Roles", RoleCount.ToString(), "Assigned role coverage", "bi-people", "blue")
            @KpiCard("permissions", "Permissions", EffectivePermissionCount.ToString(), "Effective permissions", "bi-key", "purple")
            @KpiCard("scopes", "Scopes", ScopeCount.ToString(), "Access boundaries", "bi-diagram-3", "cyan")
            @KpiCard("sessions", "Sessions", ActiveSessionCount.ToString(), "Active sign-in sessions", "bi-display", "amber")
            @KpiCard("governance", "Governance", GovernanceSignalCount.ToString(), "Requests and review signals", "bi-clipboard-check", "green")
        </section>

        <section class="udd-workflows" aria-label="User workflows">
            @WorkflowButton("Security review", "Open highest-impact posture signals", "bi-shield-exclamation", () => SetTab("overview"))
            @WorkflowButton("Role assignment", "Grant or revoke role membership", "bi-person-plus", () => SetTab("access"))
            @WorkflowButton("Permission override", "Manage direct grants and denies", "bi-key", () => SetTab("permissions"))
            @WorkflowButton("Scope boundary", "Limit access to branches, regions, or teams", "bi-diagram-3", () => SetTab("scopes"))
            @WorkflowButton("Session control", "Revoke sessions or unlock sign-in", "bi-box-arrow-right", () => SetTab("sessions"))
        </section>

        <nav class="udd-tabs" aria-label="User detail views">
            @foreach (var tab in _tabs)
            {
                <button type="button" class="udd-tab @(_activeTab == tab.Key ? "udd-tab--active" : null)" @onclick="() => SetTab(tab.Key)">
                    <i class="bi @tab.Icon" aria-hidden="true"></i>
                    <span>@tab.Label</span>
                    <strong>@TabCount(tab.Key)</strong>
                </button>
            }
        </nav>

        <main class="udd-dashboard">
            <section class="udd-main-card">
                <div class="udd-card-header">
                    <div>
                        <span class="udd-section-kicker">@ActiveTabTitle</span>
                        <h2>@ActiveTabHeading</h2>
                        <p>@ActiveTabDescription</p>
                    </div>
                    <div class="udd-card-actions">
                        @if (_activeTab == "access")
                        {
                            <button type="button" class="udd-btn udd-btn--primary" @onclick="OpenAddRole"><i class="bi bi-person-plus" aria-hidden="true"></i> Add Role</button>
                        }
                        @if (_activeTab == "permissions")
                        {
                            <button type="button" class="udd-btn udd-btn--primary" @onclick="OpenAddPermission"><i class="bi bi-key" aria-hidden="true"></i> Add Override</button>
                        }
                        @if (_activeTab == "scopes")
                        {
                            <button type="button" class="udd-btn udd-btn--primary" @onclick="OpenAddScope"><i class="bi bi-diagram-3" aria-hidden="true"></i> Add Scope</button>
                        }
                        @if (_activeTab == "sessions")
                        {
                            <button type="button" class="udd-btn udd-btn--danger-ghost" @onclick="ConfirmRevokeSessions"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Revoke All</button>
                        }
                    </div>
                </div>

                @if (_activeTab == "overview")
                {
                    <div class="udd-overview-grid">
                        <article class="udd-score-card udd-score-card--@RiskTone(_user)"><span>Security posture score</span><strong>@RiskScore(_user)</strong><small>@RiskLevel(_user)</small></article>
                        <article class="udd-info-card"><h3>Identity</h3><dl class="udd-detail-list"><div><dt>Username</dt><dd>@_user.UserName</dd></div><div><dt>Email</dt><dd>@_user.Email</dd></div><div><dt>Type</dt><dd>@_user.UserTypeCode</dd></div><div><dt>Department</dt><dd>@Safe(_user.Department, "—")</dd></div><div><dt>Title</dt><dd>@Safe(_user.JobTitle, "—")</dd></div><div><dt>Locale</dt><dd>@Safe(_user.LocaleCode, "—")</dd></div><div><dt>Time zone</dt><dd>@Safe(_user.TimeZoneCode, "—")</dd></div></dl></article>
                        <article class="udd-info-card"><h3>Security</h3><dl class="udd-detail-list"><div><dt>Status</dt><dd>@(_user.IsLockedOut ? "Locked" : _user.StatusCode)</dd></div><div><dt>MFA</dt><dd>@(_user.MfaEnabled ? "Enabled" : "Disabled")</dd></div><div><dt>Failed attempts</dt><dd>@_user.FailedLoginAttempts</dd></div><div><dt>Password changed</dt><dd>@FormatRelative(_user.PasswordChangedDateUtc)</dd></div><div><dt>Last login</dt><dd>@FormatRelative(_user.LastLoginDateUtc)</dd></div><div><dt>Created</dt><dd>@_user.CreatedDateUtc.ToString("MMM d, yyyy")</dd></div></dl></article>
                        <article class="udd-info-card"><h3>Contact</h3><dl class="udd-detail-list"><div><dt>Phone</dt><dd>@Safe(_user.PhoneNumber ?? _profile?.PhoneNumber, "—")</dd></div><div><dt>Mobile</dt><dd>@Safe(_profile?.MobileNumber, "—")</dd></div><div><dt>Country</dt><dd>@Safe(_profile?.CountryCode, "—")</dd></div><div><dt>Location</dt><dd>@ProfileLocation</dd></div><div><dt>Emergency</dt><dd>@Safe(_profile?.EmergencyContactName, "—")</dd></div></dl></article>
                    </div>
                }
                else if (_activeTab == "access")
                {
                    @if (_rolesLoading)
                    {
                        <div class="udd-loading udd-loading--inline"><span class="udd-spinner"></span> Loading roles…</div>
                    }
                    else if (!_userRoles.Any())
                    {
                        @EmptyState("bi-people", "No roles assigned", "Assign at least one role to grant platform access.")
                    }
                    else
                    {
                        <div class="udd-card-grid">
                            @foreach (var role in _userRoles.OrderByDescending(r => r.IsActive).ThenBy(r => r.RoleName))
                            {
                                <article class="udd-access-card">
                                    <div class="udd-access-icon"><i class="bi bi-people" aria-hidden="true"></i></div>
                                    <div class="udd-access-body"><h3>@Safe(role.RoleName, role.RoleCode ?? "Role")</h3><p>@role.RoleCode • assigned @role.AssignedDateUtc.ToString("MMM d, yyyy")</p><span class="udd-pill @(role.IsActive ? "udd-pill--green" : "udd-pill--neutral")">@(role.IsActive ? "Active" : "Inactive")</span></div>
                                    <button type="button" class="udd-icon-btn udd-icon-btn--danger" title="Revoke role" @onclick="() => ConfirmRevokeRole(role)"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                                </article>
                            }
                        </div>
                    }
                }
                else if (_activeTab == "permissions")
                {
                    <div class="udd-split-grid">
                        <section class="udd-info-card"><h3>Direct overrides</h3>@if (_permissionsLoading) { <div class="udd-mini-loading">Loading…</div> } else if (!_permissions.Any()) { @EmptyState("bi-key", "No direct overrides", "This user inherits access from roles only.") } else { <div class="udd-table-wrap"><table class="udd-table"><thead><tr><th>Permission</th><th>Resource</th><th>Grant</th><th></th></tr></thead><tbody>@foreach (var perm in _permissions.OrderBy(p => p.ResourceCode).ThenBy(p => p.PermissionName)) { <tr><td><strong>@Safe(perm.PermissionName, perm.PermissionCode)</strong><small>@perm.PermissionCode</small></td><td>@perm.ResourceCode</td><td><span class="udd-pill @(perm.IsGranted ? "udd-pill--green" : "udd-pill--red")">@(perm.IsGranted ? "Allow" : "Deny")</span></td><td><button type="button" class="udd-icon-btn udd-icon-btn--danger" @onclick="() => ConfirmRevokePermission(perm)"><i class="bi bi-x-lg" aria-hidden="true"></i></button></td></tr> }</tbody></table></div> }</section>
                        <section class="udd-info-card"><h3>Effective access</h3>@if (_permissionsLoading) { <div class="udd-mini-loading">Loading…</div> } else if (!_effectivePermissions.Any()) { @EmptyState("bi-shield-lock", "No effective permissions", "Assign roles or direct overrides to grant access.") } else { <div class="udd-table-wrap"><table class="udd-table"><thead><tr><th>Permission</th><th>Source</th><th>Expires</th></tr></thead><tbody>@foreach (var perm in _effectivePermissions.OrderBy(p => p.ResourceCode).ThenBy(p => p.ActionCode).Take(30)) { <tr><td><strong>@perm.PermissionName</strong><small>@perm.ResourceCode / @perm.ActionCode</small></td><td>@Safe(perm.RoleName, perm.GrantSource)</td><td>@(perm.ExpiresDateUtc?.ToString("MMM d, yyyy") ?? "—")</td></tr> }</tbody></table></div> }</section>
                    </div>
                }
                else if (_activeTab == "scopes")
                {
                    @if (_scopesLoading)
                    {
                        <div class="udd-loading udd-loading--inline"><span class="udd-spinner"></span> Loading scopes…</div>
                    }
                    else if (!_scopes.Any())
                    {
                        @EmptyState("bi-diagram-3", "No scopes assigned", "Add scope boundaries for branch, department, region, or team-based access.")
                    }
                    else
                    {
                        <div class="udd-card-grid">
                            @foreach (var scope in _scopes.OrderBy(s => s.ScopeTypeCode).ThenBy(s => s.ScopeValue))
                            {
                                <article class="udd-access-card"><div class="udd-access-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></div><div class="udd-access-body"><h3>@scope.ScopeTypeCode</h3><p>@scope.ScopeValue</p><span class="udd-pill @(scope.IsActive ? "udd-pill--green" : "udd-pill--neutral")">@(scope.IsActive ? "Active" : "Inactive")</span></div><button type="button" class="udd-icon-btn udd-icon-btn--danger" @onclick="() => ConfirmRevokeScope(scope)"><i class="bi bi-x-lg" aria-hidden="true"></i></button></article>
                            }
                        </div>
                    }
                }
                else if (_activeTab == "sessions")
                {
                    @if (_sessionsLoading)
                    {
                        <div class="udd-loading udd-loading--inline"><span class="udd-spinner"></span> Loading sessions…</div>
                    }
                    else if (!_sessions.Any())
                    {
                        @EmptyState("bi-display", "No sessions found", "Session telemetry will appear here after sign-in activity.")
                    }
                    else
                    {
                        <div class="udd-table-wrap"><table class="udd-table"><thead><tr><th>Device</th><th>IP</th><th>Login</th><th>Last activity</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var session in _sessions.OrderByDescending(s => s.LastActivityDateUtc ?? s.LoginDateUtc)) { <tr><td><strong>@Safe(session.DeviceType, "Unknown device")</strong><small>@Safe(session.UserAgent, "No user agent")</small></td><td>@Safe(session.IpAddress, "—")</td><td>@FormatRelative(session.LoginDateUtc)</td><td>@FormatRelative(session.LastActivityDateUtc)</td><td><span class="udd-pill @(session.IsRevoked ? "udd-pill--red" : "udd-pill--green")">@(session.IsRevoked ? "Revoked" : "Active")</span></td><td>@if (!session.IsRevoked) { <button type="button" class="udd-icon-btn udd-icon-btn--danger" @onclick="() => ConfirmRevokeSession(session)"><i class="bi bi-box-arrow-right" aria-hidden="true"></i></button> }</td></tr> }</tbody></table></div>
                    }
                }
                else
                {
                    <div class="udd-split-grid">
                        <section class="udd-info-card"><h3>Access intelligence</h3><div class="udd-insight-list">@foreach (var insight in Insights) { <div class="udd-insight"><i class="bi @insight.Icon" aria-hidden="true"></i><div><strong>@insight.Title</strong><span>@insight.Description</span></div></div> }</div></section>
                        <section class="udd-info-card"><h3>Governance summary</h3><dl class="udd-detail-list"><div><dt>Access requests</dt><dd>@_accessRequests.Count</dd></div><div><dt>Pending requests</dt><dd>@_accessRequests.Count(r => r.StatusCode.Contains("Pending", StringComparison.OrdinalIgnoreCase))</dd></div><div><dt>Acknowledgements</dt><dd>@_acknowledgements.Count</dd></div><div><dt>Direct overrides</dt><dd>@_permissions.Count</dd></div><div><dt>Effective permissions</dt><dd>@_effectivePermissions.Count</dd></div></dl></section>
                    </div>
                }
            </section>

            <aside class="udd-side-panel">
                <section class="udd-panel-card"><span class="udd-section-kicker">Priority actions</span><div class="udd-action-list">@foreach (var action in PriorityActions) { <button type="button" class="udd-action-item" @onclick="action.OnClick"><i class="bi @action.Icon" aria-hidden="true"></i><div><strong>@action.Title</strong><span>@action.Description</span></div></button> }</div></section>
                <section class="udd-panel-card"><span class="udd-section-kicker">Important signals</span><div class="udd-insight-list">@foreach (var insight in Insights.Take(5)) { <div class="udd-insight"><i class="bi @insight.Icon" aria-hidden="true"></i><div><strong>@insight.Title</strong><span>@insight.Description</span></div></div> }</div></section>
            </aside>
        </main>
    </div>
}

@if (_showEdit && _user is not null)
{
    <div class="udd-modal-backdrop" role="presentation" @onclick="CloseEdit">
        <div class="udd-modal" role="dialog" aria-modal="true" aria-labelledby="udd-edit-title" @onclick:stopPropagation="true">
            <div class="udd-modal__header"><i class="bi bi-pencil-square" aria-hidden="true"></i><span id="udd-edit-title">Edit user profile</span><button type="button" class="udd-icon-btn udd-icon-btn--light ms-auto" @onclick="CloseEdit"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm EditContext="@_editContext" OnValidSubmit="SaveEditAsync">
                <DataAnnotationsValidator />
                <div class="udd-modal__body">
                    <div class="udd-validation-note"><i class="bi bi-shield-check" aria-hidden="true"></i><div><strong>Enterprise validations enabled</strong><span>Required identity, email format, phone format, department, time zone, and locale checks are enforced before save.</span></div></div>
                    <div class="udd-form-grid">
                        <label class="udd-field"><span>Full Name <em>*</em></span><InputText @bind-Value="_editForm.FullName" class="form-control" /></label>
                        <label class="udd-field"><span>Display Name</span><InputText @bind-Value="_editForm.DisplayName" class="form-control" /></label>
                        <label class="udd-field"><span>Phone Number</span><InputText @bind-Value="_editForm.PhoneNumber" @bind-Value:after="OnPhoneChanged" class="form-control" type="tel" placeholder="(555) 123-4567" />@if (!string.IsNullOrWhiteSpace(_editForm.PhoneNumber)) { <span class="@PhoneHintClass">@PhoneStatusText</span> }</label>
                        <label class="udd-field"><span>Job Title</span><InputText @bind-Value="_editForm.JobTitle" class="form-control" /></label>
                        <label class="udd-field"><span>Department</span><InputText @bind-Value="_editForm.Department" class="form-control" /></label>
                        <label class="udd-field"><span>Time Zone</span><InputSelect @bind-Value="_editForm.TimeZoneCode" class="form-select"><option value="">Select time zone…</option>@foreach (var tz in _tzOptions) { <option value="@tz">@tz</option> }</InputSelect></label>
                        <label class="udd-field"><span>Locale</span><InputSelect @bind-Value="_editForm.LocaleCode" class="form-select"><option value="">Select locale…</option>@foreach (var locale in _localeOptions) { <option value="@locale">@locale</option> }</InputSelect></label>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger udd-form-alert" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@_formError</div> }
                </div>
                <div class="udd-modal__footer"><button type="button" class="udd-btn udd-btn--ghost" @onclick="CloseEdit">Cancel</button><button type="submit" class="udd-btn udd-btn--primary" disabled="@_busy">@if (_busy) { <span class="udd-spin-sm" aria-hidden="true"></span> } Save Changes</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showAddRole)
{
    <div class="udd-modal-backdrop" role="presentation" @onclick="CloseAddRole"><div class="udd-modal udd-modal--sm" role="dialog" aria-modal="true" @onclick:stopPropagation="true"><div class="udd-modal__header"><i class="bi bi-person-plus" aria-hidden="true"></i><span>Add role</span><button type="button" class="udd-icon-btn udd-icon-btn--light ms-auto" @onclick="CloseAddRole"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div><div class="udd-modal__body"><label class="udd-field"><span>Role</span><select class="form-select" @bind="_selectedRoleId"><option value="@Guid.Empty">Select role…</option>@foreach (var role in _pickRoles) { <option value="@role.RoleId">@role.RoleName (@role.RoleCode)</option> }</select></label></div><div class="udd-modal__footer"><button type="button" class="udd-btn udd-btn--ghost" @onclick="CloseAddRole">Cancel</button><button type="button" class="udd-btn udd-btn--primary" @onclick="AssignSelectedRoleAsync" disabled="@(_busy || _selectedRoleId == Guid.Empty)">Assign Role</button></div></div></div>
}

@if (_showAddPermission)
{
    <div class="udd-modal-backdrop" role="presentation" @onclick="CloseAddPermission"><div class="udd-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true"><div class="udd-modal__header"><i class="bi bi-key" aria-hidden="true"></i><span>Add permission override</span><button type="button" class="udd-icon-btn udd-icon-btn--light ms-auto" @onclick="CloseAddPermission"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div><div class="udd-modal__body"><div class="udd-form-grid"><label class="udd-field"><span>Search permissions</span><input class="form-control" @bind="_permissionSearch" @bind:event="oninput" placeholder="Search resource, action, or code…" /></label><label class="udd-field"><span>Grant type</span><select class="form-select" @bind="_permissionGrantType"><option value="Allow">Allow</option><option value="Deny">Deny</option></select></label></div><div class="udd-picker-list">@foreach (var permission in FilteredPermissions.Take(80)) { <label class="udd-picker-row"><input type="checkbox" checked="@_selectedPermissionIds.Contains(permission.PermissionId)" @onchange="args => TogglePermission(permission.PermissionId, args)" /><span><strong>@permission.PermissionName</strong><small>@permission.ResourceCode / @permission.ActionCode • @permission.PermissionCode</small></span></label> }</div></div><div class="udd-modal__footer"><button type="button" class="udd-btn udd-btn--ghost" @onclick="CloseAddPermission">Cancel</button><button type="button" class="udd-btn udd-btn--primary" @onclick="GrantSelectedPermissionsAsync" disabled="@(_busy || _selectedPermissionIds.Count == 0)">Apply Overrides</button></div></div></div>
}

@if (_showAddScope)
{
    <div class="udd-modal-backdrop" role="presentation" @onclick="CloseAddScope"><div class="udd-modal udd-modal--sm" role="dialog" aria-modal="true" @onclick:stopPropagation="true"><div class="udd-modal__header"><i class="bi bi-diagram-3" aria-hidden="true"></i><span>Add access scope</span><button type="button" class="udd-icon-btn udd-icon-btn--light ms-auto" @onclick="CloseAddScope"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div><EditForm Model="_scopeForm" OnValidSubmit="SaveScopeAsync"><DataAnnotationsValidator /><div class="udd-modal__body"><div class="udd-validation-note"><i class="bi bi-diagram-3" aria-hidden="true"></i><div><strong>Scope validation enabled</strong><span>Scope type and value are required before assigning access boundaries.</span></div></div><div class="udd-form-grid udd-form-grid--one"><label class="udd-field"><span>Scope Type <em>*</em></span><InputSelect class="form-select" @bind-Value="_scopeForm.ScopeTypeCode"><option value="">Select scope…</option><option value="Branch">Branch</option><option value="Department">Department</option><option value="Region">Region</option><option value="Team">Team</option><option value="Tenant">Tenant</option></InputSelect></label><label class="udd-field"><span>Scope Value <em>*</em></span><InputText class="form-control" @bind-Value="_scopeForm.ScopeValue" placeholder="Branch code, department, region, or team" /></label></div></div><div class="udd-modal__footer"><button type="button" class="udd-btn udd-btn--ghost" @onclick="CloseAddScope">Cancel</button><button type="submit" class="udd-btn udd-btn--primary" disabled="@_busy">Assign Scope</button></div></EditForm></div></div>
}

@if (_showConfirm)
{
    <div class="udd-modal-backdrop" role="presentation" @onclick="CloseConfirm"><div class="udd-confirm" role="dialog" aria-modal="true" @onclick:stopPropagation="true"><div class="udd-modal__header"><i class="bi @_confirmIcon" aria-hidden="true"></i><span>Confirm action</span><button type="button" class="udd-icon-btn udd-icon-btn--light ms-auto" @onclick="CloseConfirm" disabled="@_busy"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div><div class="udd-confirm__body"><div class="@(_confirmDanger ? "udd-confirm-icon udd-confirm-icon--danger" : "udd-confirm-icon")"><i class="bi @_confirmIcon" aria-hidden="true"></i></div><div><h3>@_confirmTitle</h3><p>@_confirmMessage</p></div></div><div class="udd-modal__footer"><button type="button" class="udd-btn udd-btn--ghost" @onclick="CloseConfirm" disabled="@_busy">Cancel</button><button type="button" class="@(_confirmDanger ? "udd-btn udd-btn--danger" : "udd-btn udd-btn--primary")" @onclick="ExecuteConfirmedActionAsync" disabled="@_busy">@if (_busy) { <span class="udd-spin-sm" aria-hidden="true"></span> } Confirm</button></div></div></div>
}

<div class="udd-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="udd-toast @toast.CssClass"><i class="bi @(toast.CssClass.Contains("danger") ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i><span>@toast.Message</span><button type="button" @onclick="() => DismissToast(toast.Id)"><i class="bi bi-x" aria-hidden="true"></i></button></div>
    }
</div>

@code {
    [Parameter] public Guid UserId { get; set; }

    private Guid _tenantId;
    private Guid _currentUserId;
    private UserDto? _user;
    private UserProfileDto? _profile;
    private List<UserRoleDto> _userRoles = [];
    private List<UserPermissionDto> _permissions = [];
    private List<EffectivePermissionDto> _effectivePermissions = [];
    private List<UserScopeDto> _scopes = [];
    private List<UserSessionDto> _sessions = [];
    private List<AccessRequestDto> _accessRequests = [];
    private List<AcknowledgementDetailDto> _acknowledgements = [];
    private List<RoleDto> _pickRoles = [];
    private List<PermissionDto> _pickPermissions = [];
    private readonly HashSet<Guid> _selectedPermissionIds = [];
    private readonly List<ToastMessage> _toasts = [];

    private bool _loading = true;
    private bool _busy;
    private bool _rolesLoading;
    private bool _permissionsLoading;
    private bool _scopesLoading;
    private bool _sessionsLoading;
    private string? _loadError;
    private string _activeTab = "overview";
    private string _permissionSearch = string.Empty;
    private string _permissionGrantType = "Allow";

    private bool _showEdit;
    private bool _showAddRole;
    private bool _showAddPermission;
    private bool _showAddScope;
    private bool _showConfirm;
    private bool _confirmDanger;
    private string _confirmTitle = string.Empty;
    private string _confirmMessage = string.Empty;
    private string _confirmIcon = "bi-question-circle";
    private Func<Task>? _confirmedAction;
    private string _formError = string.Empty;

    private EditUserForm _editForm = new();
    private EditContext _editContext = default!;
    private ScopeForm _scopeForm = new();
    private Guid _selectedRoleId = Guid.Empty;

    private static readonly string[] _tzOptions = ["UTC", "America/New_York", "America/Chicago", "America/Denver", "America/Los_Angeles", "Europe/London", "Europe/Paris", "Asia/Tokyo", "Asia/Singapore"];
    private static readonly string[] _localeOptions = ["en-US", "en-GB", "fr-FR", "de-DE", "ja-JP", "es-ES", "zh-CN"];
    private readonly TabDef[] _tabs = [new("overview", "Overview", "bi-speedometer2"), new("access", "Roles", "bi-people"), new("permissions", "Permissions", "bi-key"), new("scopes", "Scopes", "bi-diagram-3"), new("sessions", "Sessions", "bi-display"), new("governance", "Governance", "bi-clipboard-check")];

    private string PageTitle => _user?.FullName ?? "User Security Profile";
    private int RoleCount => _userRoles.Count > 0 ? _userRoles.Count : _user?.AssignedRoleCount ?? 0;
    private int EffectivePermissionCount => _effectivePermissions.Count;
    private int ScopeCount => _scopes.Count;
    private int ActiveSessionCount => _sessions.Count(s => !s.IsRevoked && s.ExpiresDateUtc > DateTime.UtcNow);
    private int GovernanceSignalCount => _accessRequests.Count + _acknowledgements.Count;
    private string ActiveTabTitle => _tabs.FirstOrDefault(t => t.Key == _activeTab)?.Label ?? "Overview";
    private string ActiveTabHeading => _activeTab switch { "access" => "Role membership", "permissions" => "Permission posture", "scopes" => "Access boundaries", "sessions" => "Session control", "governance" => "Governance intelligence", _ => "Identity posture" };
    private string ActiveTabDescription => _activeTab switch { "access" => "Review and manage role assignments ranked by access importance.", "permissions" => "Inspect direct overrides and effective permissions inherited from roles.", "scopes" => "Control which organizational boundaries this user can access.", "sessions" => "Monitor active sign-in sessions and revoke access when needed.", "governance" => "Review access requests, acknowledgements, and governance signals.", _ => "Enterprise summary of identity, security, contact, and profile details." };
    private string ProfileLocation => string.Join(", ", new[] { _profile?.City, _profile?.StateProvince, _profile?.CountryCode }.Where(x => !string.IsNullOrWhiteSpace(x))).Trim() is { Length: > 0 } value ? value : "—";
    private string PhoneStatusText => IsPhoneValid(_editForm.PhoneNumber) ? $"Phone formatted as {NormalizePhone(_editForm.PhoneNumber)}" : "Enter a valid 10-digit phone number.";
    private string PhoneHintClass => IsPhoneValid(_editForm.PhoneNumber) ? "udd-field-hint udd-hint-good" : "udd-field-hint udd-hint-bad";

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _currentUserId = context.UserId;
        _editContext = new(_editForm);
    }

    protected override async Task OnParametersSetAsync() => await LoadUserAsync();

    private async Task LoadUserAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();
        try
        {
            _user = await Api.GetUserByIdAsync(UserId);
            if (_user is null) return;
            _profile = await Api.GetUserProfileAsync(UserId);
            SetCrumbs();
            await Task.WhenAll(LoadRolesAsync(), LoadPermissionsAsync(), LoadScopesAsync(), LoadSessionsAsync(), LoadGovernanceAsync());
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load user detail: {ex.Message}";
            ShowToast(_loadError, "udd-toast--danger");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void SetCrumbs() => Breadcrumbs.SetCrumbs(new("Home", "/"), new("Security", "/tenant/security/users"), new("Users", "/tenant/security/users"), new(_user?.FullName ?? "User", null));
    private void NavigateToList() => Nav.NavigateTo("/tenant/security/users");
    private void SetTab(string tab) => _activeTab = tab;
    private int TabCount(string key) => key switch { "access" => RoleCount, "permissions" => EffectivePermissionCount, "scopes" => ScopeCount, "sessions" => ActiveSessionCount, "governance" => GovernanceSignalCount, _ => RiskScore(_user) };

    private async Task LoadRolesAsync()
    {
        _rolesLoading = true;
        try { _userRoles = (await Api.SearchUserRolesAsync(_tenantId, UserId, pageSize: 1000))?.Items.ToList() ?? []; }
        finally { _rolesLoading = false; }
    }

    private async Task LoadPermissionsAsync()
    {
        _permissionsLoading = true;
        try
        {
            _permissions = (await Api.GetUserDirectPermissionsAsync(UserId))?.ToList() ?? [];
            _effectivePermissions = (await Api.GetEffectivePermissionsAsync(UserId))?.ToList() ?? [];
        }
        finally { _permissionsLoading = false; }
    }

    private async Task LoadScopesAsync()
    {
        _scopesLoading = true;
        try { _scopes = (await Api.GetUserScopesAsync(UserId))?.ToList() ?? []; }
        finally { _scopesLoading = false; }
    }

    private async Task LoadSessionsAsync()
    {
        _sessionsLoading = true;
        try { _sessions = (await Api.SearchUserSessionsAsync(_tenantId, UserId))?.Items.ToList() ?? []; }
        catch { _sessions = []; }
        finally { _sessionsLoading = false; }
    }

    private async Task LoadGovernanceAsync()
    {
        try
        {
            _accessRequests = (await Api.SearchAccessRequestsAsync(_tenantId, requestedForUserId: UserId, pageSize: 100))?.Items.ToList() ?? [];
            _acknowledgements = (await Api.SearchAcknowledgedAsync(_tenantId, searchTerm: _user?.Email ?? _user?.FullName, pageSize: 100))?.Items.Where(a => a.UserId == UserId || string.Equals(a.UserEmail, _user?.Email, StringComparison.OrdinalIgnoreCase)).ToList() ?? [];
        }
        catch
        {
            _accessRequests = [];
            _acknowledgements = [];
        }
    }

    private void OpenEdit()
    {
        if (_user is null) return;
        _editForm = new EditUserForm { FullName = _user.FullName, DisplayName = _user.DisplayName, PhoneNumber = _user.PhoneNumber, JobTitle = _user.JobTitle, Department = _user.Department, TimeZoneCode = _user.TimeZoneCode, LocaleCode = _user.LocaleCode };
        _editContext = new(_editForm);
        _formError = string.Empty;
        _showEdit = true;
    }
    private void CloseEdit() => _showEdit = false;

    private async Task SaveEditAsync()
    {
        if (_user is null || _busy) return;
        _busy = true;
        _formError = string.Empty;
        try
        {
            await Api.UpdateUserAsync(_user.UserId, new UpdateUserRequest { UserId = _user.UserId, FullName = _editForm.FullName.Trim(), DisplayName = _editForm.DisplayName?.Trim(), PhoneNumber = _editForm.PhoneNumber?.Trim(), JobTitle = _editForm.JobTitle?.Trim(), Department = _editForm.Department?.Trim(), TimeZoneCode = _editForm.TimeZoneCode, LocaleCode = _editForm.LocaleCode, ModifiedByUserId = _currentUserId });
            _showEdit = false;
            ShowToast("User profile updated.", "udd-toast--success");
            await LoadUserAsync();
        }
        catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; }
        finally { _busy = false; }
    }

    private async Task OpenAddRole()
    {
        _selectedRoleId = Guid.Empty;
        if (_pickRoles.Count == 0) _pickRoles = (await Api.SearchRolesAsync(_tenantId, pageSize: 1000))?.Items.Where(r => r.IsActive).OrderBy(r => r.RoleName).ToList() ?? [];
        _showAddRole = true;
    }
    private void CloseAddRole() => _showAddRole = false;

    private async Task AssignSelectedRoleAsync()
    {
        if (_user is null || _selectedRoleId == Guid.Empty || _busy) return;
        _busy = true;
        try
        {
            await Api.AssignUserRoleAsync(new AssignUserRoleRequest { TenantId = _tenantId, UserId = _user.UserId, RoleId = _selectedRoleId, AssignedByUserId = _currentUserId, Source = "UserDetail" });
            _showAddRole = false;
            ShowToast("Role assigned.", "udd-toast--success");
            await LoadRolesAsync();
        }
        catch (Exception ex) { ShowToast($"Failed to assign role: {ex.Message}", "udd-toast--danger"); }
        finally { _busy = false; }
    }

    private async Task OpenAddPermission()
    {
        _selectedPermissionIds.Clear();
        _permissionSearch = string.Empty;
        _permissionGrantType = "Allow";
        if (_pickPermissions.Count == 0) _pickPermissions = (await Api.SearchPermissionsAsync(_tenantId, pageSize: 1000))?.Items.Where(p => p.IsActive).OrderBy(p => p.PermissionName).ToList() ?? [];
        _showAddPermission = true;
    }
    private void CloseAddPermission() => _showAddPermission = false;
    private IEnumerable<PermissionDto> FilteredPermissions => _pickPermissions.Where(p => string.IsNullOrWhiteSpace(_permissionSearch) || Contains(p.PermissionName, _permissionSearch) || Contains(p.PermissionCode, _permissionSearch) || Contains(p.ResourceCode, _permissionSearch) || Contains(p.ActionCode, _permissionSearch));
    private void TogglePermission(Guid permissionId, Microsoft.AspNetCore.Components.ChangeEventArgs args) { if (args.Value is bool selected && selected) _selectedPermissionIds.Add(permissionId); else _selectedPermissionIds.Remove(permissionId); }

    private async Task GrantSelectedPermissionsAsync()
    {
        if (_user is null || _selectedPermissionIds.Count == 0 || _busy) return;
        _busy = true;
        try
        {
            foreach (var permissionId in _selectedPermissionIds.ToList()) await Api.GrantUserPermissionAsync(_user.UserId, new GrantUserPermissionRequest { TenantId = _tenantId, UserId = _user.UserId, PermissionId = permissionId, IsGranted = _permissionGrantType != "Deny", GrantedByUserId = _currentUserId });
            _showAddPermission = false;
            ShowToast($"{_selectedPermissionIds.Count} permission override(s) applied.", "udd-toast--success");
            _selectedPermissionIds.Clear();
            await LoadPermissionsAsync();
        }
        catch (Exception ex) { ShowToast($"Failed to apply permissions: {ex.Message}", "udd-toast--danger"); }
        finally { _busy = false; }
    }

    private void OpenAddScope() { _scopeForm = new(); _showAddScope = true; }
    private void CloseAddScope() => _showAddScope = false;
    private async Task SaveScopeAsync()
    {
        if (_user is null || _busy) return;
        _busy = true;
        try
        {
            await Api.AssignUserScopeAsync(new AssignUserScopeRequest { TenantId = _tenantId, UserId = _user.UserId, ScopeTypeCode = _scopeForm.ScopeTypeCode.Trim(), ScopeValue = _scopeForm.ScopeValue.Trim(), GrantedByUserId = _currentUserId });
            _showAddScope = false;
            ShowToast("Scope assigned.", "udd-toast--success");
            await LoadScopesAsync();
        }
        catch (Exception ex) { ShowToast($"Failed to assign scope: {ex.Message}", "udd-toast--danger"); }
        finally { _busy = false; }
    }

    private void ConfirmToggleActive(UserDto user) { var activate = !IsActive(user); OpenConfirm(activate ? "Enable user?" : "Disable user?", $"{(activate ? "Enable" : "Disable")} access for {user.FullName}?", activate ? "bi-person-check" : "bi-person-dash", !activate, () => ToggleActiveAsync(user, activate)); }
    private async Task ToggleActiveAsync(UserDto user, bool activate) { try { await Api.SetUserActiveAsync(user.UserId, activate, _currentUserId); CloseConfirm(); ShowToast($"User {(activate ? "enabled" : "disabled")}.", "udd-toast--success"); await LoadUserAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"Status update failed: {ex.Message}", "udd-toast--danger"); } }
    private void ConfirmUnlock(UserDto user) => OpenConfirm("Unlock account?", $"Restore sign-in access for {user.FullName}?", "bi-unlock", false, () => UnlockAsync(user));
    private async Task UnlockAsync(UserDto user) { try { await Api.UnlockUserAsync(user.UserId, _currentUserId); CloseConfirm(); ShowToast("Account unlocked.", "udd-toast--success"); await LoadUserAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"Unlock failed: {ex.Message}", "udd-toast--danger"); } }
    private void ConfirmToggleMfa() { if (_user is null) return; var enable = !_user.MfaEnabled; OpenConfirm(enable ? "Enable MFA?" : "Disable MFA?", $"{(enable ? "Enable" : "Disable")} MFA for {_user.FullName}?", enable ? "bi-shield-check" : "bi-shield-x", !enable, () => ToggleMfaAsync(enable)); }
    private async Task ToggleMfaAsync(bool enable) { if (_user is null) return; try { await Api.SetUserMfaAsync(_user.UserId, enable, _currentUserId); CloseConfirm(); ShowToast($"MFA {(enable ? "enabled" : "disabled")}.", "udd-toast--success"); await LoadUserAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"MFA update failed: {ex.Message}", "udd-toast--danger"); } }
    private void ConfirmRevokeSessions() { if (_user is null) return; OpenConfirm("Revoke all sessions?", $"Sign {_user.FullName} out of every active session?", "bi-box-arrow-right", true, RevokeSessionsAsync); }
    private async Task RevokeSessionsAsync() { if (_user is null) return; try { await Api.RevokeAllUserSessionsAsync(_tenantId, _user.UserId, "Revoked from enterprise user detail"); CloseConfirm(); ShowToast("All active sessions revoked.", "udd-toast--success"); await LoadSessionsAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"Failed to revoke sessions: {ex.Message}", "udd-toast--danger"); } }
    private void ConfirmRevokeSession(UserSessionDto session) => OpenConfirm("Revoke session?", "End this active user session immediately?", "bi-box-arrow-right", true, () => RevokeSessionAsync(session));
    private async Task RevokeSessionAsync(UserSessionDto session) { try { await Api.RevokeUserSessionAsync(session.SessionId, "Revoked from enterprise user detail"); CloseConfirm(); ShowToast("Session revoked.", "udd-toast--success"); await LoadSessionsAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"Failed to revoke session: {ex.Message}", "udd-toast--danger"); } }
    private void ConfirmRevokeRole(UserRoleDto role) => OpenConfirm("Revoke role?", $"Remove {Safe(role.RoleName, role.RoleCode ?? "this role")} from this user?", "bi-x-circle", true, () => RevokeRoleAsync(role));
    private async Task RevokeRoleAsync(UserRoleDto role) { try { await Api.RevokeUserRoleAsync(new RevokeUserRoleRequest { UserRoleId = role.UserRoleId, RevokedByUserId = _currentUserId, Reason = "Revoked from enterprise user detail" }); CloseConfirm(); ShowToast("Role revoked.", "udd-toast--success"); await LoadRolesAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"Failed to revoke role: {ex.Message}", "udd-toast--danger"); } }
    private void ConfirmRevokePermission(UserPermissionDto permission) => OpenConfirm("Revoke override?", $"Remove direct override {Safe(permission.PermissionName, permission.PermissionCode)}?", "bi-x-circle", true, () => RevokePermissionAsync(permission));
    private async Task RevokePermissionAsync(UserPermissionDto permission) { try { await Api.RevokeUserPermissionAsync(UserId, permission.PermissionId, _currentUserId); CloseConfirm(); ShowToast("Permission override revoked.", "udd-toast--success"); await LoadPermissionsAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"Failed to revoke permission: {ex.Message}", "udd-toast--danger"); } }
    private void ConfirmRevokeScope(UserScopeDto scope) => OpenConfirm("Revoke scope?", $"Remove {scope.ScopeTypeCode}: {scope.ScopeValue}?", "bi-x-circle", true, () => RevokeScopeAsync(scope));
    private async Task RevokeScopeAsync(UserScopeDto scope) { try { await Api.RevokeUserScopeAsync(scope.UserScopeId, _currentUserId); CloseConfirm(); ShowToast("Scope revoked.", "udd-toast--success"); await LoadScopesAsync(); } catch (Exception ex) { CloseConfirm(); ShowToast($"Failed to revoke scope: {ex.Message}", "udd-toast--danger"); } }

    private void OpenConfirm(string title, string message, string icon, bool danger, Func<Task> action) { _confirmTitle = title; _confirmMessage = message; _confirmIcon = icon; _confirmDanger = danger; _confirmedAction = action; _showConfirm = true; }
    private void CloseConfirm() { _showConfirm = false; _confirmedAction = null; }
    private async Task ExecuteConfirmedActionAsync() { if (_confirmedAction is null || _busy) return; _busy = true; try { await _confirmedAction.Invoke(); } finally { _busy = false; } }

    private IEnumerable<ActionDef> PriorityActions
    {
        get
        {
            if (_user is null) yield break;
            if (!_user.MfaEnabled) yield return new("Enable MFA", "Protect this identity with MFA", "bi-shield-check", ConfirmToggleMfa);
            if (_user.IsLockedOut) yield return new("Unlock account", "Restore sign-in access", "bi-unlock", () => ConfirmUnlock(_user));
            if (RoleCount == 0 && IsActive(_user)) yield return new("Assign role", "Grant baseline access", "bi-person-plus", () => _ = OpenAddRole());
            if (ActiveSessionCount > 0) yield return new("Revoke sessions", "Force re-authentication", "bi-box-arrow-right", ConfirmRevokeSessions);
            yield return new("Review permissions", "Inspect direct and inherited access", "bi-key", () => SetTab("permissions"));
        }
    }

    private IEnumerable<InsightDef> Insights
    {
        get
        {
            if (_user is null) yield break;
            if (!_user.MfaEnabled) yield return new("MFA gap", "This user is not protected by multi-factor authentication.", "bi-shield-x");
            if (_user.IsLockedOut) yield return new("Locked account", "Sign-in is blocked until the account is unlocked.", "bi-lock");
            if (IsStale(_user)) yield return new("Dormant access", "No sign-in activity in 30+ days or no recorded login.", "bi-hourglass-bottom");
            if (RoleCount == 0 && IsActive(_user)) yield return new("Role gap", "Active user has no assigned roles.", "bi-diagram-3");
            if (_permissions.Any(p => !p.IsGranted)) yield return new("Explicit deny", "One or more direct deny overrides are active.", "bi-slash-circle");
            yield return new("Least privilege", "Review roles, direct permissions, scopes, and sessions regularly.", "bi-shield-lock");
        }
    }

    private void ShowToast(string message, string cssClass) { var toast = new ToastMessage(Guid.NewGuid(), message, cssClass); _toasts.Add(toast); _ = Task.Run(async () => { await Task.Delay(5000); await InvokeAsync(() => DismissToast(toast.Id)); }); }
    private void DismissToast(Guid id) { _toasts.RemoveAll(t => t.Id == id); StateHasChanged(); }
    private void OnPhoneChanged() { if (IsPhoneValid(_editForm.PhoneNumber)) _editForm.PhoneNumber = NormalizePhone(_editForm.PhoneNumber); }

    private static bool IsActive(UserDto user) => user.StatusCode.Equals("Active", StringComparison.OrdinalIgnoreCase);
    private static bool IsStale(UserDto? user) => user?.LastLoginDateUtc is null || (DateTime.UtcNow - user.LastLoginDateUtc.Value).TotalDays >= 30;
    private static int RiskScore(UserDto? user) { if (user is null) return 0; var score = 0; if (user.IsLockedOut) score += 40; if (!user.MfaEnabled) score += 25; if (user.LastLoginDateUtc is null) score += 18; else if ((DateTime.UtcNow - user.LastLoginDateUtc.Value).TotalDays >= 30) score += 12; if (user.AssignedRoleCount == 0 && IsActive(user)) score += 10; if (user.FailedLoginAttempts >= 3) score += 10; if (user.StatusCode.Equals("Pending", StringComparison.OrdinalIgnoreCase)) score += 8; return Math.Min(100, score); }
    private static string RiskLevel(UserDto? user) => RiskScore(user) switch { >= 60 => "Critical", >= 40 => "High", >= 20 => "Medium", _ => "Low" };
    private static string RiskTone(UserDto? user) => RiskLevel(user) switch { "Critical" => "red", "High" => "amber", "Medium" => "cyan", _ => "green" };
    private static bool IsPhoneValid(string? value) { if (string.IsNullOrWhiteSpace(value)) return true; var digits = new string(value.Where(char.IsDigit).ToArray()); if (digits.Length == 11 && digits[0] == '1') digits = digits[1..]; return digits.Length == 10; }
    private static string? NormalizePhone(string? value) { if (string.IsNullOrWhiteSpace(value)) return null; var digits = new string(value.Where(char.IsDigit).ToArray()); if (digits.Length == 11 && digits[0] == '1') digits = digits[1..]; return digits.Length == 10 ? $"({digits[..3]}) {digits.Substring(3, 3)}-{digits[6..]}" : value.Trim(); }
    private static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static bool Contains(string value, string term) => value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static string Initials(string? name) => string.IsNullOrWhiteSpace(name) ? "?" : string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    private static readonly string[] _avatarColors = ["#3b82f6", "#8b5cf6", "#10b981", "#f59e0b", "#ef4444", "#06b6d4", "#6366f1", "#ec4899"];
    private static string AvatarStyle(string? name) => $"background:{_avatarColors[Math.Abs((name ?? string.Empty).GetHashCode()) % _avatarColors.Length]}";
    private static string FormatRelative(DateTime? dt) => dt is null ? "Never" : FormatRelative(dt.Value);
    private static string FormatRelative(DateTime dt) => (DateTime.UtcNow - dt) switch { var d when d.TotalMinutes < 1 => "Just now", var d when d.TotalHours < 1 => $"{(int)d.TotalMinutes}m ago", var d when d.TotalDays < 1 => $"{(int)d.TotalHours}h ago", var d when d.TotalDays < 7 => $"{(int)d.TotalDays}d ago", var d when d.TotalDays < 30 => $"{(int)(d.TotalDays / 7)}w ago", _ => dt.ToString("MMM d, yyyy") };

    private RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string tone) => @<button type="button" class="udd-kpi-card udd-kpi-card--@tone @(_activeTab == key ? "udd-kpi-card--active" : null)" @onclick="() => SetTab(key)"><div class="udd-kpi-icon"><i class="bi @icon" aria-hidden="true"></i></div><div><span>@label</span><strong>@value</strong><small>@subtitle</small></div></button>;
    private RenderFragment WorkflowButton(string title, string description, string icon, System.Action onClick) => @<button type="button" class="udd-workflow" @onclick="onClick"><div class="udd-workflow-icon"><i class="bi @icon" aria-hidden="true"></i></div><div><strong>@title</strong><span>@description</span></div></button>;
    private RenderFragment RiskBadge(UserDto user) => @<span class="udd-risk-badge udd-risk-badge--@RiskTone(user)"><i class="bi bi-shield-fill" aria-hidden="true"></i>@RiskLevel(user)</span>;
    private RenderFragment StatusPill(UserDto user) => @<span class="udd-pill @(user.IsLockedOut ? "udd-pill--amber" : IsActive(user) ? "udd-pill--green" : "udd-pill--neutral")"><i class="bi @(user.IsLockedOut ? "bi-lock-fill" : IsActive(user) ? "bi-check-circle" : "bi-dash-circle")" aria-hidden="true"></i>@(user.IsLockedOut ? "Locked" : user.StatusCode)</span>;
    private RenderFragment EmptyState(string icon, string title, string description) => @<div class="udd-empty"><i class="bi @icon" aria-hidden="true"></i><strong>@title</strong><span>@description</span></div>;

    private sealed class EditUserForm { [Required] [StringLength(200)] public string FullName { get; set; } = string.Empty; [StringLength(200)] public string? DisplayName { get; set; } [AmsPhone] [StringLength(50)] public string? PhoneNumber { get; set; } [StringLength(100)] public string? JobTitle { get; set; } [StringLength(100)] public string? Department { get; set; } public string? TimeZoneCode { get; set; } public string? LocaleCode { get; set; } }
    private sealed class ScopeForm { [Required] public string ScopeTypeCode { get; set; } = string.Empty; [Required] public string ScopeValue { get; set; } = string.Empty; }
    private sealed record TabDef(string Key, string Label, string Icon);
    private sealed record InsightDef(string Title, string Description, string Icon);
    private sealed record ActionDef(string Title, string Description, string Icon, System.Action OnClick);
    private sealed record ToastMessage(Guid Id, string Message, string CssClass);
}
