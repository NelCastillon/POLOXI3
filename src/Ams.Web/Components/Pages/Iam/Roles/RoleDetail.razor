    // -- Edit / Clone ------------------------------------------
    private void OpenEdit()
    {
        if (_role is null) return;
        _isClone = false;
        _form = new RForm
        {
            RoleCode     = _role.RoleCode,
            RoleName     = _role.RoleName,
            RoleTypeCode = _role.RoleTypeCode,
            Description  = _role.Description,
            SortOrder    = _role.SortOrder,
        };
        _formError = string.Empty;
        _showForm  = true;
    }

    private void OpenClone()
    {
        if (_role is null) return;
        _isClone = true;
        _form = new RForm
        {
            RoleCode     = $"{_role.RoleCode}_COPY",
            RoleName     = $"{_role.RoleName} (Copy)",
            RoleTypeCode = _role.RoleTypeCode,
            Description  = _role.Description,
            SortOrder    = _role.SortOrder,
        };
        _formError = string.Empty;
        _showForm  = true;
    }

    private void CloseForm() { _showForm = false; _formError = string.Empty; }

    private async Task SaveAsync()
    {
        if (_saving || _role is null) return;
        _formError = string.Empty;

        if (string.IsNullOrWhiteSpace(_form.RoleCode)) { _formError = "Role Code is required."; return; }
        if (string.IsNullOrWhiteSpace(_form.RoleName)) { _formError = "Role Name is required."; return; }

        _saving = true;
        try
        {
            if (_isClone)
            {
                var req = new CreateRoleRequest
                {
                    TenantId     = _tenantId,
                    RoleCode     = _form.RoleCode.Trim().ToUpperInvariant(),
                    RoleName     = _form.RoleName.Trim(),
                    RoleTypeCode = _form.RoleTypeCode,
                    Description  = _form.Description?.Trim(),
                    SortOrder    = _form.SortOrder,
                };
                var newId = await Api.CreateRoleAsync(req);
                CloseForm();
                await ShowToastAsync($"Role '{req.RoleName}' cloned successfully.");
                Nav.NavigateTo($"/iam/roles/{newId}");
                return;
            }

            var updateReq = new UpdateRoleRequest
            {
                RoleId      = _role.RoleId,
                RoleName    = _form.RoleName.Trim(),
                Description = _form.Description?.Trim(),
                SortOrder   = _form.SortOrder,
            };
            await Api.UpdateRoleAsync(_role.RoleId, updateReq);
            CloseForm();
            await ShowToastAsync($"Role '{updateReq.RoleName}' updated.");
            await LoadRoleAsync();
        }
        catch (Exception ex) { _formError = $"Error: {ex.Message}"; }
        finally { _saving = false; }
    }

    // -- Activate / Deactivate ---------------------------------
    private async Task ToggleActiveAsync()
    {
        if (_role is null) return;
        try
        {
            await Api.SetRoleActiveAsync(_role.RoleId, !_role.IsActive);
            await ShowToastAsync($"Role '{_role.RoleName}' {(!_role.IsActive ? "activated" : "deactivated")}.");
            await LoadRoleAsync();
        }
        catch (Exception ex) { await ShowToastAsync(ex.Message, isError: true); }
    }

