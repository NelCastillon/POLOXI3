    // -- Permissions helpers -----------------------------------
    private HashSet<Guid> AssignedIds => [.. _permissions.Select(p => p.PermissionId)];

    private IReadOnlyList<string> CatalogResources =>
        _catalog.Select(p => p.ResourceCode).Distinct().Order().ToList();

    private IReadOnlyList<string> CatalogActions =>
        _catalog.Select(p => p.ActionCode).Distinct().Order().ToList();

    private List<PermissionDto> ApplyPermFilter()
    {
        var q = ApplyPermFilterNoAssigned();
        var ids = AssignedIds;
        return _permFilterAssigned switch
        {
            "assigned"   => q.Where(p => ids.Contains(p.PermissionId)).ToList(),
            "unassigned" => q.Where(p => !ids.Contains(p.PermissionId)).ToList(),
            _            => q,
        };
    }

    private List<PermissionDto> ApplyPermFilterNoAssigned()
    {
        var q = _catalog.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_permSearch))
            q = q.Where(p =>
                p.PermissionCode.Contains(_permSearch, StringComparison.OrdinalIgnoreCase) ||
                p.PermissionName.Contains(_permSearch, StringComparison.OrdinalIgnoreCase) ||
                p.ResourceCode.Contains(_permSearch, StringComparison.OrdinalIgnoreCase)   ||
                p.ActionCode.Contains(_permSearch, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(_permFilterResource))
            q = q.Where(p => p.ResourceCode == _permFilterResource);
        if (!string.IsNullOrEmpty(_permFilterAction))
            q = q.Where(p => p.ActionCode == _permFilterAction);
        return q.ToList();
    }

    private void ToggleResourceGroup(string resource)
    {
        if (!_collapsedGroups.Add(resource))
            _collapsedGroups.Remove(resource);
    }

    private async Task TogglePermissionAsync(PermissionDto perm, bool isAssigned, Guid? rolePermissionId)
    {
        if (_role is null) return;
        _toggling.Add(perm.PermissionId);
        StateHasChanged();
        try
        {
            if (isAssigned && rolePermissionId.HasValue)
            {
                await Api.RevokePermissionFromRoleAsync(new RevokeRolePermissionRequest
                {
                    RolePermissionId = rolePermissionId.Value,
                });
                _permissions.RemoveAll(p => p.RolePermissionId == rolePermissionId.Value);
                _role.PermissionCount = _permissions.Count;
                await ShowToastAsync($"Permission '{perm.PermissionCode}' revoked.");
            }
            else
            {
                var newId = await Api.AssignPermissionToRoleAsync(new AssignRolePermissionRequest
                {
                    TenantId     = _tenantId,
                    RoleId       = RoleId,
                    PermissionId = perm.PermissionId,
                });
                _permissions.Add(new RolePermissionDto
                {
                    RolePermissionId = newId,
                    RoleId           = RoleId,
                    PermissionId     = perm.PermissionId,
                    PermissionCode   = perm.PermissionCode,
                    PermissionName   = perm.PermissionName,
                    ResourceCode     = perm.ResourceCode,
                    ActionCode       = perm.ActionCode,
                    GrantedDateUtc   = DateTime.UtcNow,
                    CreatedDateUtc   = DateTime.UtcNow,
                });
                _role.PermissionCount = _permissions.Count;
                await ShowToastAsync($"Permission '{perm.PermissionCode}' assigned.");
            }
        }
        catch (Exception ex) { await ShowToastAsync(ex.Message, isError: true); }
        finally { _toggling.Remove(perm.PermissionId); StateHasChanged(); }
    }

