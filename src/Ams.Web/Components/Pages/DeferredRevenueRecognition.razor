@page "/finance/deferred-revenue-recognition"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@using Ams.Application.Common.Dtos
@using Ams.Web.Services
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons

<h3>Deferred Revenue Recognition</h3>

<div class="mb-3 d-flex gap-2">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="300px" />
    <SfButton OnClick="LoadAsync">Search</SfButton>
</div>

<SfGrid DataSource="_items" AllowPaging="true">
    <GridPageSettings PageSize="10" />
    <GridColumns>
        <GridColumn Field="@nameof(DeferredRevenueRecognitionDto.RecognitionId)" HeaderText="ID" Width="220" />
        <GridColumn Field="@nameof(DeferredRevenueRecognitionDto.DeferredRevenueScheduleId)" HeaderText="Schedule ID" Width="220" />
        <GridColumn Field="@nameof(DeferredRevenueRecognitionDto.RecognitionDate)" HeaderText="Recognition Date" Width="140" />
        <GridColumn Field="@nameof(DeferredRevenueRecognitionDto.Amount)" HeaderText="Amount" Format="C2" Width="120" />
        <GridColumn Field="@nameof(DeferredRevenueRecognitionDto.StatusCode)" HeaderText="Status" Width="120" />
        <GridColumn Field="@nameof(DeferredRevenueRecognitionDto.CreatedDateUtc)" HeaderText="Created" Width="160" />
    </GridColumns>
</SfGrid>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private List<DeferredRevenueRecognitionDto>? _items;
    private string? _searchTerm;
    private Guid _tenantId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.SearchDeferredRevenueRecognitionsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
