@page "/expenses"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Billing
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.ComponentModel.DataAnnotations
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject IJSRuntime Js

<PageTitle>Expenses - AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="exp-toast exp-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="exp-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showDeleteConfirm && _deleteTarget is not null)
{
    <div class="exp-modal-backdrop" role="presentation" @onclick="CancelDelete">
        <div class="exp-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="exp-delete-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash-fill"></i></div>
                <div class="um-confirm-title" id="exp-delete-title">Remove Expense</div>
                <div class="um-confirm-body">Remove the <strong>@_deleteTarget.CategoryCode</strong> expense for <strong>@AccountName(_deleteTarget.AccountId)</strong>? This entry will be soft-deleted from active expense views.</div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CancelDelete" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_busy">Remove Expense</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showStatusConfirm && _statusTarget is not null && !string.IsNullOrWhiteSpace(_pendingStatus))
{
    <div class="exp-modal-backdrop" role="presentation" @onclick="CancelStatusUpdate">
        <div class="exp-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="exp-status-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon"><i class="bi @StatusConfirmIcon(_pendingStatus)"></i></div>
                <div class="um-confirm-title" id="exp-status-title">@StatusConfirmTitle(_pendingStatus)</div>
                <div class="um-confirm-body">@StatusConfirmMessage(_statusTarget, _pendingStatus)</div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CancelStatusUpdate" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn um-btn-primary" @onclick="ExecuteStatusUpdateAsync" disabled="@_busy">@StatusConfirmButton(_pendingStatus)</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showForm)
{
    <div class="exp-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="exp-modal exp-action-modal" role="dialog" aria-modal="true" aria-labelledby="exp-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-credit-card" aria-hidden="true"></i>
                <span id="exp-form-title">@(_editingId == Guid.Empty ? "New Expense" : "Edit Expense")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="exp-modal-intro">
                        <span><i class="bi bi-shield-check" aria-hidden="true"></i> Expense workflow</span>
                        <p>Capture tenant-scoped client expenses, approvals, billable flags, and invoice links using the existing Billing.ExpenseEntry workflow.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Billing Account <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.AccountId">
                                <option value="@Guid.Empty">Select account...</option>
                                @foreach (var account in _accountOptions)
                                {
                                    <option value="@account.Id">@account.Display</option>
                                }
                            </InputSelect>
                            @if (_form.AccountId == Guid.Empty && _saveAttempted)
                            {
                                <div class="text-danger">Billing account is required.</div>
                            }
                        </div>
                        <div class="um-field">
                            <label>User <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.UserId">
                                <option value="@Guid.Empty">Select user...</option>
                                @foreach (var user in _userOptions)
                                {
                                    <option value="@user.Id">@user.Display</option>
                                }
                            </InputSelect>
                            @if (_form.UserId == Guid.Empty && _saveAttempted)
                            {
                                <div class="text-danger">User is required.</div>
                            }
                        </div>
                        <div class="um-field">
                            <label>Expense Date <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="_form.ExpenseDate" />
                        </div>
                        <div class="um-field">
                            <label>Category <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.CategoryCode">
                                @foreach (var category in _categories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Amount <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_form.Amount" />
                        </div>
                        <div class="um-field">
                            <label>Status <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.StatusCode">
                                @foreach (var status in _statuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Invoice</label>
                            <InputSelect class="form-select" @bind-Value="_form.InvoiceId">
                                <option value="">None</option>
                                @foreach (var invoice in InvoiceOptionsForForm)
                                {
                                    <option value="@invoice.Id">@invoice.Display</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field um-field--checkbox">
                            <label><InputCheckbox @bind-Value="_form.IsBillable" /> Billable to client</label>
                        </div>
                        <div class="um-field um-field--full">
                            <label>Description</label>
                            <InputTextArea class="form-control" @bind-Value="_form.Description" rows="3" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_formError))
                        {
                            <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div>
                        }
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        @(_editingId == Guid.Empty ? "Create Expense" : "Save Changes")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="exp-enterprise-page">
    <section class="exp-header">
        <div class="exp-header-left">
            <div class="exp-lob-icon"><i class="bi bi-credit-card" aria-hidden="true"></i></div>
            <div class="exp-header-info">
                <div class="exp-title-row">
                    <h1 class="exp-page-title">Expenses</h1>
                    <span class="exp-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live expense data</span>
                    <span class="exp-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span>
                </div>
                <div class="exp-sub-row">
                    <span>Track billable and internal expense entries across accounts, users, approvals, and invoices.</span>
                    <span class="exp-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Seed sync enabled</span>
                    <span class="exp-sub-chip"><i class="bi bi-check2-circle" aria-hidden="true"></i> @_filtered.Count active matches</span>
                </div>
            </div>
        </div>
        <div class="exp-header-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/billing/invoices")'>
                <i class="bi bi-receipt" aria-hidden="true"></i> Invoices
            </button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi @(_loading ? "bi-arrow-repeat exp-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync" disabled="@(!_filtered.Any())">
                <i class="bi bi-download" aria-hidden="true"></i> Export
            </button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">
                <i class="bi bi-plus-circle" aria-hidden="true"></i> New Expense
            </button>
        </div>
    </section>

    <section class="exp-kpi-strip" aria-label="Expense metrics">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="exp-kpi-card @kpi.Tone @(_kpiFilter == kpi.Filter ? "exp-kpi-active" : null)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)">
                <span class="exp-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="exp-kpi-copy">
                    <span class="exp-kpi-label">@kpi.Label</span>
                    <span class="exp-kpi-value">@kpi.Value</span>
                    <span class="exp-kpi-caption">@kpi.Caption</span>
                </span>
            </button>
        }
    </section>

    <section class="exp-workflow-strip" aria-label="Expense workflow shortcuts">
        <button type="button" class="exp-workflow-card exp-wf-time" @onclick='() => Nav.NavigateTo("/timeentries")'>
            <span class="exp-workflow-icon"><i class="bi bi-clock" aria-hidden="true"></i></span>
            <span class="exp-workflow-content"><strong>1</strong><span>Time</span><small>Review time entries.</small></span>
        </button>
        <button type="button" class="exp-workflow-card exp-wf-exp" @onclick="OpenCreate">
            <span class="exp-workflow-icon"><i class="bi bi-credit-card" aria-hidden="true"></i></span>
            <span class="exp-workflow-content"><strong>2</strong><span>Expense</span><small>Capture reimbursables.</small></span>
        </button>
        <button type="button" class="exp-workflow-card exp-wf-approve" @onclick='() => SetKpiFilter("submitted")'>
            <span class="exp-workflow-icon"><i class="bi bi-check2-square" aria-hidden="true"></i></span>
            <span class="exp-workflow-content"><strong>3</strong><span>Approve</span><small>Approve submitted entries.</small></span>
        </button>
        <button type="button" class="exp-workflow-card exp-wf-invoice" @onclick='() => Nav.NavigateTo("/billing/invoices")'>
            <span class="exp-workflow-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
            <span class="exp-workflow-content"><strong>4</strong><span>Invoice</span><small>Link billable costs.</small></span>
        </button>
        <button type="button" class="exp-workflow-card exp-wf-recon" @onclick='() => Nav.NavigateTo("/billing/reconciliation")'>
            <span class="exp-workflow-icon"><i class="bi bi-ui-checks-grid" aria-hidden="true"></i></span>
            <span class="exp-workflow-content"><strong>5</strong><span>Reconcile</span><small>Validate expense recovery.</small></span>
        </button>
    </section>

    <section class="exp-enterprise-search" aria-label="Expense filters">
        <div class="exp-search-wrap">
            <div class="exp-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
            <div class="exp-search-body">
            <label for="exp-search">Search expenses</label>
            <input id="exp-search" class="exp-search-input" type="search" placeholder="Search account, user, category, description, status..." @bind="SearchFilter" @bind:event="oninput" />
            <span class="exp-search-hint">Filters apply instantly across synchronized expense entries.</span>
        </div>
        </div>
        <select class="exp-filter-select" @bind="StatusFilter" aria-label="Status filter">
            <option value="">All statuses</option>
            @foreach (var status in _statuses)
            {
                <option value="@status">@status</option>
            }
        </select>
        <select class="exp-filter-select" @bind="CategoryFilter" aria-label="Category filter">
            <option value="">All categories</option>
            @foreach (var category in _categories)
            {
                <option value="@category">@category</option>
            }
        </select>
        <select class="exp-filter-select" @bind="BillableFilter" aria-label="Billable filter">
            <option value="">Billable: all</option>
            <option value="yes">Billable only</option>
            <option value="no">Internal only</option>
        </select>
        <div class="exp-search-result"><strong>@_filtered.Count</strong><span>matches</span></div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger exp-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
    }

    <section class="exp-content-layout">
        <div class="exp-grid-wrap">
            <div class="exp-grid-toolbar">
                <div>
                    <strong>Expense register</strong>
                    <span>@ActiveFilterText</span>
                </div>
                <div class="exp-toolbar-actions">
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters"><i class="bi bi-eraser" aria-hidden="true"></i> Reset</button>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/timeentries")'><i class="bi bi-clock" aria-hidden="true"></i> Time</button>
                    <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add</button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="exp-loading"><i class="bi bi-arrow-repeat exp-spin" aria-hidden="true"></i><strong>Loading expenses...</strong><span>Syncing schema, seed data, billing accounts, users, invoices, and expense entries.</span></div>
            }
            else if (!_filtered.Any())
            {
                <div class="exp-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No expenses found</strong><span>Adjust filters or create a new expense entry.</span><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate">New Expense</button></div>
            }
            else
            {
                <div class="exp-table-scroll">
                    <table class="exp-table">
                        <thead>
                            <tr>
                                <th>Account / Expense</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>User</th>
                                <th>Date</th>
                                <th>Billable</th>
                                <th class="exp-number">Amount</th>
                                <th class="exp-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PagedItems)
                            {
                                <tr class="exp-table-row @(_selected?.ExpenseId == item.ExpenseId ? "exp-table-row--selected" : null)" @onclick="() => SelectExpense(item)">
                                    <td>
                                        <div class="exp-entry-cell">
                                            <span class="exp-entry-icon @StatusIconTone(item.StatusCode)"><i class="bi @CategoryIcon(item.CategoryCode)" aria-hidden="true"></i></span>
                                            <span>
                                                <strong>@AccountName(item.AccountId)</strong>
                                                <span>@Truncate(item.Description ?? "No description", 92)</span>
                                            </span>
                                        </div>
                                    </td>
                                    <td><span class="exp-category-chip @CategoryCss(item.CategoryCode)">@item.CategoryCode</span></td>
                                    <td><span class="exp-status-chip @StatusCss(item.StatusCode)">@item.StatusCode</span></td>
                                    <td>@UserName(item.UserId)</td>
                                    <td>@item.ExpenseDate.ToString("MMM d, yyyy")</td>
                                    <td><span class="@(item.IsBillable ? "exp-billable-on" : "exp-billable-off")">@(item.IsBillable ? "Billable" : "Internal")</span></td>
                                    <td class="exp-number">@Fmt(item.Amount)</td>
                                    <td>
                                        <div class="exp-row-acts">
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Edit" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Submit" @onclick:stopPropagation="true" @onclick='() => ConfirmStatusUpdate(item, "Submitted")'><i class="bi bi-send" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Approve" @onclick:stopPropagation="true" @onclick='() => ConfirmStatusUpdate(item, "Approved")'><i class="bi bi-check-circle" aria-hidden="true"></i></button>
                                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" title="Remove" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(item)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="exp-pager">
                    <span>Showing @PageStart-@PageEnd of @_filtered.Count</span>
                    <div>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PrevPage" disabled="@(_page == 1)">Previous</button>
                        <span>Page @_page of @TotalPages</span>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next</button>
                    </div>
                </div>
            }
        </div>

        <aside class="exp-detail-panel" aria-label="Selected expense detail">
            @if (_selected is null)
            {
                <div class="exp-detail-empty"><i class="bi bi-cursor" aria-hidden="true"></i><strong>Select an expense</strong><span>Choose a row to inspect billing linkage, approval status, and recovery actions.</span></div>
            }
            else
            {
                <div class="exp-detail-head">
                    <div>
                        <span class="exp-detail-eyebrow"><i class="bi bi-credit-card" aria-hidden="true"></i> Expense entry</span>
                        <h2>@AccountName(_selected.AccountId)</h2>
                        <div class="exp-detail-meta">
                            <span>@_selected.ExpenseDate.ToString("MMM d, yyyy")</span>
                            <span>@UserName(_selected.UserId)</span>
                            <span class="exp-status-chip @StatusCss(_selected.StatusCode)">@_selected.StatusCode</span>
                        </div>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                </div>
                <div class="exp-detail-body">
                    <div class="exp-detail-summary">
                        <div class="exp-meta-row"><span class="exp-meta-lbl">Amount</span><span class="exp-meta-val">@Fmt(_selected.Amount)</span></div>
                        <div class="exp-meta-row"><span class="exp-meta-lbl">Category</span><span class="exp-meta-val">@_selected.CategoryCode</span></div>
                        <div class="exp-meta-row"><span class="exp-meta-lbl">Invoice</span><span class="exp-meta-val">@InvoiceNumber(_selected.InvoiceId)</span></div>
                        <div class="exp-meta-row"><span class="exp-meta-lbl">Created</span><span class="exp-meta-val">@_selected.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy")</span></div>
                    </div>
                    <div class="exp-note-card">
                        <span><i class="bi bi-journal-text" aria-hidden="true"></i> Expense description</span>
                        <p>@(_selected.Description ?? "No description provided.")</p>
                    </div>
                    <div class="exp-detail-actions">
                        <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, "Submitted")'><i class="bi bi-send" aria-hidden="true"></i> Submit</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, "Approved")'><i class="bi bi-check-circle" aria-hidden="true"></i> Approve</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => ConfirmStatusUpdate(_selected, "Invoiced")'><i class="bi bi-receipt" aria-hidden="true"></i> Mark Invoiced</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ConfirmDelete(_selected)"><i class="bi bi-trash" aria-hidden="true"></i> Remove</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@code {
    private const int PageSize = 12;
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<ExpenseEntryDto> _items = [];
    private List<ExpenseEntryDto> _filtered = [];
    private List<BillingAccountDto> _accounts = [];
    private List<UserDto> _users = [];
    private List<InvoiceDto> _invoices = [];
    private List<AccountOption> _accountOptions = [];
    private List<UserOption> _userOptions = [];
    private List<InvoiceOption> _invoiceOptions = [];
    private ExpenseEntryDto? _selected;
    private ExpenseEntryDto? _deleteTarget;
    private ExpenseEntryDto? _statusTarget;
    private ExpenseForm _form = new();
    private Guid _editingId = Guid.Empty;
    private string _searchTerm = string.Empty;
    private string _statusFilter = string.Empty;
    private string _categoryFilter = string.Empty;
    private string _billableFilter = string.Empty;
    private string _kpiFilter = "all";
    private string? _pendingStatus;
    private int _page = 1;
    private bool _loading;
    private bool _busy;
    private bool _showForm;
    private bool _showDeleteConfirm;
    private bool _showStatusConfirm;
    private bool _saveAttempted;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string? _formError;
    private readonly List<string> _statuses = ["Draft", "Submitted", "Approved", "Invoiced"];
    private readonly List<string> _categories = ["Travel", "Meals", "Postage", "Supplies", "Carrier Fee", "Inspection", "Other"];

    private IEnumerable<ExpenseEntryDto> PagedItems => _filtered.Skip((_page - 1) * PageSize).Take(PageSize);
    private IEnumerable<InvoiceOption> InvoiceOptionsForForm => _form.AccountId == Guid.Empty ? _invoiceOptions : _invoiceOptions.Where(x => x.AccountId == _form.AccountId);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)PageSize));
    private int PageStart => _filtered.Count == 0 ? 0 : ((_page - 1) * PageSize) + 1;
    private int PageEnd => Math.Min(_filtered.Count, _page * PageSize);
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", "info" => "bi-info-circle-fill", _ => "bi-check-circle-fill" };
    private string ActiveFilterText => _kpiFilter == "all" ? "All expense entries" : $"Filtered by {_kpiFilter}";
    private IReadOnlyList<KpiModel> Kpis =>
    [
        new("all", "Expenses", _items.Count.ToString("N0"), "All entries", "bi-credit-card", "exp-ki-blue"),
        new("draft", "Draft", _items.Count(x => x.StatusCode == "Draft").ToString("N0"), "Needs submission", "bi-pencil", "exp-ki-amber"),
        new("submitted", "Submitted", _items.Count(x => x.StatusCode == "Submitted").ToString("N0"), "Awaiting approval", "bi-send", "exp-ki-blue"),
        new("approved", "Approved", _items.Count(x => x.StatusCode == "Approved").ToString("N0"), "Ready to bill", "bi-check-circle", "exp-ki-green"),
        new("billable", "Billable", Fmt(_items.Where(x => x.IsBillable).Sum(x => x.Amount)), "Client recoverable", "bi-currency-dollar", "exp-ki-green"),
        new("internal", "Internal", Fmt(_items.Where(x => !x.IsBillable).Sum(x => x.Amount)), "Non-billable cost", "bi-slash-circle", "exp-ki-red")
    ];

    private string SearchFilter { get => _searchTerm; set { _searchTerm = value; ApplyFilters(resetPage: true); } }
    private string StatusFilter { get => _statusFilter; set { _statusFilter = value; ApplyFilters(resetPage: true); } }
    private string CategoryFilter { get => _categoryFilter; set { _categoryFilter = value; ApplyFilters(resetPage: true); } }
    private string BillableFilter { get => _billableFilter; set { _billableFilter = value; ApplyFilters(resetPage: true); } }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Expenses", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await Api.EnsureBillingAccountsSeedAsync(_tenantId);
            var expenses = await Api.SearchExpensesAsync(_tenantId, string.Empty);
            var accounts = await Api.SearchBillingAccountsAsync(_tenantId, pageSize: 500);
            var users = await Api.SearchUsersAsync(_tenantId, pageSize: 500);
            var invoices = await Api.SearchInvoicesAsync(_tenantId);
            _items = expenses?.Items.OrderByDescending(x => x.ExpenseDate).ThenByDescending(x => x.CreatedDateUtc).ToList() ?? [];
            _accounts = accounts?.Items.ToList() ?? [];
            _users = users?.Items.ToList() ?? [];
            _invoices = invoices?.Items.ToList() ?? [];
            _accountOptions = _accounts.OrderBy(x => x.AccountName).Select(x => new AccountOption(x.AccountId, $"{x.AccountName} - {x.AccountNumber}")).ToList();
            _userOptions = _users.OrderBy(x => x.FullName).Select(x => new UserOption(x.UserId, !string.IsNullOrWhiteSpace(x.FullName) ? x.FullName : x.Email)).ToList();
            _invoiceOptions = _invoices.OrderByDescending(x => x.CreatedDateUtc).Select(x => new InvoiceOption(x.InvoiceId, x.AccountId, $"{x.InvoiceNumber} - {Fmt(x.BalanceAmount)} balance")).ToList();
            ApplyFilters(resetPage: true);
            EnsureSelectedStillVisible();
        }
        catch (Exception ex)
        {
            _loadError = $"Expenses failed to load: {ex.Message}";
            ShowToast(_loadError, "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters(bool resetPage)
    {
        IEnumerable<ExpenseEntryDto> query = _items;
        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(x => Contains(AccountName(x.AccountId), term) || Contains(UserName(x.UserId), term) || Contains(x.CategoryCode, term) || Contains(x.StatusCode, term) || Contains(x.Description, term));
        }
        if (!string.IsNullOrWhiteSpace(_statusFilter)) query = query.Where(x => x.StatusCode == _statusFilter);
        if (!string.IsNullOrWhiteSpace(_categoryFilter)) query = query.Where(x => x.CategoryCode == _categoryFilter);
        query = _billableFilter switch
        {
            "yes" => query.Where(x => x.IsBillable),
            "no" => query.Where(x => !x.IsBillable),
            _ => query
        };
        query = _kpiFilter switch
        {
            "draft" => query.Where(x => x.StatusCode == "Draft"),
            "submitted" => query.Where(x => x.StatusCode == "Submitted"),
            "approved" => query.Where(x => x.StatusCode == "Approved"),
            "billable" => query.Where(x => x.IsBillable),
            "internal" => query.Where(x => !x.IsBillable),
            _ => query
        };
        _filtered = query.OrderByDescending(x => x.ExpenseDate).ThenByDescending(x => x.CreatedDateUtc).ToList();
        if (resetPage) _page = 1;
        if (_page > TotalPages) _page = TotalPages;
    }

    private void SetKpiFilter(string filter)
    {
        _kpiFilter = filter;
        ApplyFilters(resetPage: true);
    }

    private void ResetFilters()
    {
        _searchTerm = string.Empty;
        _statusFilter = string.Empty;
        _categoryFilter = string.Empty;
        _billableFilter = string.Empty;
        _kpiFilter = "all";
        ApplyFilters(resetPage: true);
        ShowToast("Expense filters reset.", "info");
    }

    private void SelectExpense(ExpenseEntryDto item) => _selected = item;

    private void OpenCreate()
    {
        _editingId = Guid.Empty;
        _saveAttempted = false;
        _formError = null;
        _form = new ExpenseForm { UserId = _tenantAdminUserId };
        _showForm = true;
    }

    private void OpenEdit(ExpenseEntryDto item)
    {
        _editingId = item.ExpenseId;
        _saveAttempted = false;
        _formError = null;
        _form = new ExpenseForm
        {
            AccountId = item.AccountId,
            UserId = item.UserId,
            ExpenseDate = item.ExpenseDate.ToDateTime(TimeOnly.MinValue),
            CategoryCode = item.CategoryCode,
            Amount = item.Amount,
            Description = item.Description,
            IsBillable = item.IsBillable,
            StatusCode = item.StatusCode,
            InvoiceId = item.InvoiceId
        };
        _showForm = true;
    }

    private void CloseForm()
    {
        if (_busy) return;
        _showForm = false;
    }

    private async Task SaveAsync()
    {
        _saveAttempted = true;
        if (_form.AccountId == Guid.Empty)
        {
            _formError = "Billing account is required.";
            ShowToast(_formError, "warning");
            return;
        }
        if (_form.UserId == Guid.Empty)
        {
            _formError = "User is required.";
            ShowToast(_formError, "warning");
            return;
        }

        _busy = true;
        _formError = null;
        try
        {
            if (_editingId == Guid.Empty)
            {
                await Api.CreateExpenseAsync(new CreateExpenseEntryRequest
                {
                    TenantId = _tenantId,
                    AccountId = _form.AccountId,
                    UserId = _form.UserId,
                    ExpenseDate = DateOnly.FromDateTime(_form.ExpenseDate),
                    CategoryCode = _form.CategoryCode,
                    Amount = _form.Amount,
                    Description = _form.Description,
                    IsBillable = _form.IsBillable,
                    StatusCode = _form.StatusCode,
                    InvoiceId = _form.InvoiceId,
                    CreatedByUserId = _tenantAdminUserId
                });
                ShowToast("Expense created.", "success");
            }
            else
            {
                await Api.UpdateExpenseAsync(_editingId, new UpdateExpenseEntryRequest
                {
                    ExpenseId = _editingId,
                    AccountId = _form.AccountId,
                    UserId = _form.UserId,
                    ExpenseDate = DateOnly.FromDateTime(_form.ExpenseDate),
                    CategoryCode = _form.CategoryCode,
                    Amount = _form.Amount,
                    Description = _form.Description,
                    IsBillable = _form.IsBillable,
                    StatusCode = _form.StatusCode,
                    InvoiceId = _form.InvoiceId,
                    ModifiedByUserId = _tenantAdminUserId
                });
                ShowToast("Expense updated.", "success");
            }
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
            ShowToast(_formError, "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void ConfirmStatusUpdate(ExpenseEntryDto item, string status)
    {
        _statusTarget = item;
        _pendingStatus = status;
        _showStatusConfirm = true;
    }

    private void CancelStatusUpdate()
    {
        if (_busy) return;
        _showStatusConfirm = false;
        _statusTarget = null;
        _pendingStatus = null;
    }

    private async Task ExecuteStatusUpdateAsync()
    {
        if (_statusTarget is null || string.IsNullOrWhiteSpace(_pendingStatus)) return;
        await UpdateStatusAsync(_statusTarget, _pendingStatus);
        _showStatusConfirm = false;
        _statusTarget = null;
        _pendingStatus = null;
    }

    private async Task UpdateStatusAsync(ExpenseEntryDto item, string status)
    {
        _busy = true;
        try
        {
            await Api.UpdateExpenseAsync(item.ExpenseId, new UpdateExpenseEntryRequest
            {
                ExpenseId = item.ExpenseId,
                AccountId = item.AccountId,
                UserId = item.UserId,
                ExpenseDate = item.ExpenseDate,
                CategoryCode = item.CategoryCode,
                Amount = item.Amount,
                Description = item.Description,
                IsBillable = item.IsBillable,
                StatusCode = status,
                InvoiceId = item.InvoiceId,
                ModifiedByUserId = _tenantAdminUserId
            });
            ShowToast($"Expense marked {status.ToLowerInvariant()}.", "success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Update failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void ConfirmDelete(ExpenseEntryDto item)
    {
        _deleteTarget = item;
        _showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        if (_busy) return;
        _showDeleteConfirm = false;
        _deleteTarget = null;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        _busy = true;
        try
        {
            await Api.DeleteExpenseAsync(_deleteTarget.ExpenseId, _tenantAdminUserId);
            ShowToast("Expense removed.", "success");
            _showDeleteConfirm = false;
            _deleteTarget = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Remove failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private Task NotifyValidationAsync(EditContext _)
    {
        _saveAttempted = true;
        ShowToast("Please correct validation errors before saving the expense.", "warning");
        return Task.CompletedTask;
    }

    private async Task ExportAsync()
    {
        if (!_filtered.Any())
        {
            ShowToast("No expenses are available to export.", "warning");
            return;
        }

        var csv = new StringBuilder();
        csv.AppendLine("Account,User,ExpenseDate,Category,Amount,Billable,Status,Invoice,Description,ExpenseId");
        foreach (var item in _filtered)
        {
            csv.AppendLine(string.Join(',',
                Csv(AccountName(item.AccountId)),
                Csv(UserName(item.UserId)),
                Csv(item.ExpenseDate.ToString("yyyy-MM-dd")),
                Csv(item.CategoryCode),
                item.Amount.ToString("0.00"),
                Csv(item.IsBillable ? "Billable" : "Internal"),
                Csv(item.StatusCode),
                Csv(InvoiceNumber(item.InvoiceId)),
                Csv(item.Description ?? string.Empty),
                Csv(item.ExpenseId.ToString())));
        }

        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        await Js.InvokeVoidAsync("amsDownload.downloadBase64", $"expenses-{DateTime.UtcNow:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
        ShowToast($"Exported {_filtered.Count:N0} expenses.", "success");
    }

    private void PrevPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind)
    {
        _toastMessage = message;
        _toastKind = kind;
        _toastVisible = true;
    }

    private void EnsureSelectedStillVisible()
    {
        if (_selected is null)
        {
            _selected = _filtered.FirstOrDefault();
            return;
        }
        _selected = _items.FirstOrDefault(x => x.ExpenseId == _selected.ExpenseId) ?? _filtered.FirstOrDefault();
    }

    private string AccountName(Guid accountId) => _accountOptions.FirstOrDefault(x => x.Id == accountId)?.Display ?? _accounts.FirstOrDefault(x => x.AccountId == accountId)?.AccountName ?? accountId.ToString()[..8];
    private string UserName(Guid userId) => _userOptions.FirstOrDefault(x => x.Id == userId)?.Display ?? _users.FirstOrDefault(x => x.UserId == userId)?.FullName ?? userId.ToString()[..8];
    private string InvoiceNumber(Guid? invoiceId) => invoiceId is Guid id ? _invoiceOptions.FirstOrDefault(x => x.Id == id)?.Display ?? _invoices.FirstOrDefault(x => x.InvoiceId == id)?.InvoiceNumber ?? id.ToString()[..8] : "No invoice";
    private static string Fmt(decimal value) => value.ToString("C0");
    private static bool Contains(string? value, string term) => value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;
    private static string Truncate(string value, int max) => value.Length <= max ? value : value[..max] + "...";
    private static string StatusCss(string status) => $"exp-st-{CssKey(status)}";
    private static string CategoryCss(string category) => $"exp-cat-{CssKey(category)}";
    private static string StatusConfirmTitle(string status) => status switch { "Submitted" => "Submit Expense", "Approved" => "Approve Expense", "Invoiced" => "Mark Expense Invoiced", _ => "Update Expense Status" };
    private static string StatusConfirmButton(string status) => status switch { "Submitted" => "Submit", "Approved" => "Approve", "Invoiced" => "Mark Invoiced", _ => "Update Status" };
    private static string StatusConfirmIcon(string status) => status switch { "Submitted" => "bi-send", "Approved" => "bi-check-circle", "Invoiced" => "bi-receipt", _ => "bi-arrow-repeat" };
    private string StatusConfirmMessage(ExpenseEntryDto item, string status) => status switch
    {
        "Submitted" => $"Submit the {item.CategoryCode} expense for {AccountName(item.AccountId)} for approval?",
        "Approved" => $"Approve the {item.CategoryCode} expense for {AccountName(item.AccountId)}? This makes it ready for billing workflow review.",
        "Invoiced" => $"Mark the {item.CategoryCode} expense for {AccountName(item.AccountId)} as invoiced?",
        _ => $"Update the {item.CategoryCode} expense for {AccountName(item.AccountId)} to {status}?"
    };
    private static string CssKey(string value) => value.ToLowerInvariant().Replace(" ", "-").Replace("/", "-");
    private static string StatusIconTone(string status) => status switch { "Approved" or "Invoiced" => "exp-di-green", "Submitted" => "exp-di-blue", _ => "exp-di-amber" };
    private static string CategoryIcon(string category) => category switch
    {
        "Travel" => "bi-airplane",
        "Meals" => "bi-cup-hot",
        "Postage" => "bi-envelope-paper",
        "Supplies" => "bi-box-seam",
        "Carrier Fee" => "bi-bank",
        "Inspection" => "bi-clipboard-check",
        _ => "bi-credit-card"
    };
    private static string Csv(string value)
    {
        var quote = Convert.ToChar(34).ToString();
        return string.Concat(quote, value.Replace(quote, quote + quote), quote);
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private sealed record KpiModel(string Filter, string Label, string Value, string Caption, string Icon, string Tone)
    {
        public string Title => $"Filter expenses by {Label}";
    }
    private sealed record AccountOption(Guid Id, string Display);
    private sealed record UserOption(Guid Id, string Display);
    private sealed record InvoiceOption(Guid Id, Guid AccountId, string Display);

    private sealed class ExpenseForm
    {
        [RequiredGuid(ErrorMessage = "Billing account is required.")]
        public Guid AccountId { get; set; }

        [RequiredGuid(ErrorMessage = "User is required.")]
        public Guid UserId { get; set; }

        [Required]
        public DateTime ExpenseDate { get; set; } = DateTime.Today;

        [Required]
        [StringLength(80)]
        public string CategoryCode { get; set; } = "Travel";

        [Range(0.01, 1000000)]
        public decimal Amount { get; set; }

        [StringLength(1000)]
        public string? Description { get; set; }

        public bool IsBillable { get; set; } = true;

        [Required]
        [StringLength(50)]
        public string StatusCode { get; set; } = "Draft";

        public Guid? InvoiceId { get; set; }
    }

    private sealed class RequiredGuidAttribute : ValidationAttribute
    {
        public override bool IsValid(object? value) => value is Guid guid && guid != Guid.Empty;
    }
}

