@page "/expenses"
@inject ApiClient Api

<PageTitle>Expenses</PageTitle>
<h1>Expense Entries</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(ExpenseEntryDto.ExpenseDate)"   HeaderText="Date"        Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(ExpenseEntryDto.CategoryCode)"  HeaderText="Category"    Width="160"></GridColumn>
        <GridColumn Field="@nameof(ExpenseEntryDto.Amount)"        HeaderText="Amount"      Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(ExpenseEntryDto.IsBillable)"    HeaderText="Billable"    Width="100" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(ExpenseEntryDto.Description)"   HeaderText="Description" Width="300"></GridColumn>
        <GridColumn Field="@nameof(ExpenseEntryDto.StatusCode)"    HeaderText="Status"      Width="120"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<ExpenseEntryDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchExpensesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
