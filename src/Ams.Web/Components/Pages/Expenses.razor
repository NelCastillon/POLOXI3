@page "/expenses"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav

<PageTitle>Expenses — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true"><ToastPosition X="Right" Y="Bottom" /></SfToast>

<AppPageHeader Title="Expense Entries"
               Subtitle="Tenant Admin view of billable and non-billable expenses synchronized with Billing and Accounting"
               Icon="bi-credit-card">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/billing/invoices")'><i class="bi bi-receipt" aria-hidden="true"></i> Invoices</button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Expense</button>
    </Actions>
</AppPageHeader>

<div class="bill-kpi-strip">
    <button type="button" class="bill-kpi-card @KpiClass("")" @onclick='() => SetFilter("")'><i class="bi bi-credit-card bill-kpi-icon blue"></i><div><div class="bill-kpi-value">@_items.Count</div><div class="bill-kpi-label">Expenses</div></div></button>
    <button type="button" class="bill-kpi-card @KpiClass("Draft")" @onclick='() => SetFilter("Draft")'><i class="bi bi-pencil bill-kpi-icon amber"></i><div><div class="bill-kpi-value">@_items.Count(x => x.StatusCode == "Draft")</div><div class="bill-kpi-label">Draft</div></div></button>
    <button type="button" class="bill-kpi-card @KpiClass("Submitted")" @onclick='() => SetFilter("Submitted")'><i class="bi bi-send bill-kpi-icon blue"></i><div><div class="bill-kpi-value">@_items.Count(x => x.StatusCode == "Submitted")</div><div class="bill-kpi-label">Submitted</div></div></button>
    <button type="button" class="bill-kpi-card @KpiClass("Approved")" @onclick='() => SetFilter("Approved")'><i class="bi bi-check-circle bill-kpi-icon green"></i><div><div class="bill-kpi-value">@_items.Count(x => x.StatusCode == "Approved")</div><div class="bill-kpi-label">Approved</div></div></button>
    <button type="button" class="bill-kpi-card @KpiClass("Billable")" @onclick='() => SetFilter("Billable")'><i class="bi bi-currency-dollar bill-kpi-icon green"></i><div><div class="bill-kpi-value">@Fmt(_items.Where(x => x.IsBillable).Sum(x => x.Amount))</div><div class="bill-kpi-label">Billable</div></div></button>
    <button type="button" class="bill-kpi-card @KpiClass("NonBillable")" @onclick='() => SetFilter("NonBillable")'><i class="bi bi-slash-circle bill-kpi-icon red"></i><div><div class="bill-kpi-value">@Fmt(_items.Where(x => !x.IsBillable).Sum(x => x.Amount))</div><div class="bill-kpi-label">Non-Billable</div></div></button>
</div>

<div class="bill-subnav">
    <button class="bill-snav-btn bill-snav-active"><i class="bi bi-credit-card" aria-hidden="true"></i> Expenses</button>
    <button class="bill-snav-btn" @onclick='() => Nav.NavigateTo("/timeentries")'><i class="bi bi-clock" aria-hidden="true"></i> Time Entries</button>
    <button class="bill-snav-btn" @onclick='() => Nav.NavigateTo("/billing/invoices")'><i class="bi bi-receipt" aria-hidden="true"></i> Invoices</button>
    <button class="bill-snav-btn" @onclick='() => Nav.NavigateTo("/billing/reconciliation")'><i class="bi bi-ui-checks-grid" aria-hidden="true"></i> Reconciliation</button>
</div>

<div class="bill-toolbar">
    <SfTextBox Placeholder="Search category, description…" @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <select class="um-input bill-sel" @bind="_statusFilter"><option value="">All Statuses</option>@foreach (var status in _statuses) { <option value="@status">@status</option> }</select>
    <select class="um-input bill-sel" @bind="_categoryFilter"><option value="">All Categories</option>@foreach (var category in _categories) { <option value="@category">@category</option> }</select>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-search" aria-hidden="true"></i> Search</button>
</div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}

<div class="bill-grid-wrap">
    @if (_loading) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading expenses…</span></div> }
    <SfGrid TValue="ExpenseEntryDto" DataSource="FilteredItems" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridEvents TValue="ExpenseEntryDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="15"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(ExpenseEntryDto.ExpenseDate)" HeaderText="Date" Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
            <GridColumn Field="@nameof(ExpenseEntryDto.CategoryCode)" HeaderText="Category" Width="150"><Template>@{ var item = (ExpenseEntryDto)context; }<span class="bill-chip bill-chip-info">@item.CategoryCode</span></Template></GridColumn>
            <GridColumn Field="@nameof(ExpenseEntryDto.Amount)" HeaderText="Amount" Width="120" Format="C2" TextAlign="TextAlign.Right"></GridColumn>
            <GridColumn Field="@nameof(ExpenseEntryDto.IsBillable)" HeaderText="Billable" Width="100"><Template>@{ var item = (ExpenseEntryDto)context; }@if (item.IsBillable) { <span class="bill-chip bill-chip-success">Billable</span> } else { <span class="bill-chip bill-chip-neutral">Internal</span> }</Template></GridColumn>
            <GridColumn Field="@nameof(ExpenseEntryDto.Description)" HeaderText="Description" Width="330"></GridColumn>
            <GridColumn Field="@nameof(ExpenseEntryDto.StatusCode)" HeaderText="Status" Width="120"><Template>@{ var item = (ExpenseEntryDto)context; }<span class="bill-chip @StatusClass(item.StatusCode)">@item.StatusCode</span></Template></GridColumn>
            <GridColumn HeaderText="Actions" Width="130">
                <Template>
                    @{ var item = (ExpenseEntryDto)context; }
                    <div class="bill-row-actions">
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick='() => UpdateStatusAsync(item, "Submitted")' title="Submit"><i class="bi bi-send" aria-hidden="true"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick='() => UpdateStatusAsync(item, "Approved")' title="Approve"><i class="bi bi-check-circle" aria-hidden="true"></i></button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<SfDialog @bind-Visible="_showForm" Width="680px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates><Content>
        <div class="um-modal-header"><i class="bi bi-credit-card" aria-hidden="true"></i><span>@(_editingId == Guid.Empty ? "New Expense" : "Edit Expense")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
        <EditForm EditContext="_editContext"><DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field"><label>Account <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.AccountId" class="um-input"><option value="@Guid.Empty">Select account…</option>@foreach (var account in _accounts) { <option value="@account.AccountId">@account.AccountName</option> }</InputSelect><ValidationMessage For="() => _form.AccountId" class="text-danger" /></div>
                <div class="um-field"><label>User <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.UserId" class="um-input"><option value="@Guid.Empty">Select user…</option>@foreach (var user in _users) { <option value="@user.UserId">@user.FullName</option> }</InputSelect><ValidationMessage For="() => _form.UserId" class="text-danger" /></div>
                <div class="um-field"><label>Expense Date <span class="text-danger">*</span></label><InputDate @bind-Value="_form.ExpenseDate" class="um-input" /><ValidationMessage For="() => _form.ExpenseDate" class="text-danger" /></div>
                <div class="um-field"><label>Category <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.CategoryCode" class="um-input">@foreach (var category in _categories) { <option value="@category">@category</option> }</InputSelect><ValidationMessage For="() => _form.CategoryCode" class="text-danger" /></div>
                <div class="um-field"><label>Amount <span class="text-danger">*</span></label><InputNumber @bind-Value="_form.Amount" class="um-input" /><ValidationMessage For="() => _form.Amount" class="text-danger" /></div>
                <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input">@foreach (var status in _statuses) { <option value="@status">@status</option> }</InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
                <div class="um-field"><label>Invoice</label><InputSelect @bind-Value="_form.InvoiceId" class="um-input"><option value="">None</option>@foreach (var invoice in _invoices) { <option value="@invoice.InvoiceId">@invoice.InvoiceNumber</option> }</InputSelect><ValidationMessage For="() => _form.InvoiceId" class="text-danger" /></div>
                <div class="um-field"><label class="d-flex align-items-center gap-2"><InputCheckbox @bind-Value="_form.IsBillable" /> Billable to client</label><ValidationMessage For="() => _form.IsBillable" class="text-danger" /></div>
                <div class="um-field um-field--full"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="3" /><ValidationMessage For="() => _form.Description" class="text-danger" /></div>
                @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
            </div></div>
        </EditForm>
        <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Expense")</button></div>
    </Content></DialogTemplates>
</SfDialog>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private SfToast _toast = default!;
    private string? _searchTerm, _loadError, _formError;
    private string _statusFilter = string.Empty, _categoryFilter = string.Empty, _activeFilter = string.Empty;
    private bool _loading, _showForm, _saving;
    private List<ExpenseEntryDto> _items = [];
    private List<BillingAccountDto> _accounts = [];
    private List<UserDto> _users = [];
    private List<InvoiceDto> _invoices = [];
    private Guid _editingId = Guid.Empty;
    private ExpenseForm _form = new();
    private EditContext _editContext = default!;
    private readonly List<string> _statuses = ["Draft", "Submitted", "Approved", "Invoiced"];
    private readonly List<string> _categories = ["Travel", "Meals", "Postage", "Supplies", "Carrier Fee", "Inspection", "Other"];

    private IEnumerable<ExpenseEntryDto> FilteredItems => _items.Where(x =>
        (string.IsNullOrWhiteSpace(_statusFilter) || x.StatusCode == _statusFilter) &&
        (string.IsNullOrWhiteSpace(_categoryFilter) || x.CategoryCode == _categoryFilter) &&
        (_activeFilter switch { "Billable" => x.IsBillable, "NonBillable" => !x.IsBillable, "Draft" or "Submitted" or "Approved" => x.StatusCode == _activeFilter, _ => true }));

    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); _editContext = new(_form); await LoadAsync(); }
    private async Task LoadAsync() { _loading = true; _loadError = null; try { var expenses = await Api.SearchExpensesAsync(_tenantId, _searchTerm); var accounts = await Api.SearchBillingAccountsAsync(_tenantId, pageSize: 500); var users = await Api.SearchUsersAsync(_tenantId, pageSize: 500); var invoices = await Api.SearchInvoicesAsync(_tenantId); _items = expenses?.Items.ToList() ?? []; _accounts = accounts?.Items.ToList() ?? []; _users = users?.Items.ToList() ?? []; _invoices = invoices?.Items.ToList() ?? []; } catch (Exception ex) { _loadError = $"Expenses failed to load: {ex.Message}"; await ToastAsync(_loadError, true); } finally { _loading = false; } }
    private void SetFilter(string filter) => _activeFilter = filter;
    private string KpiClass(string filter) => _activeFilter == filter ? "bill-kpi-active" : string.Empty;
    private void OnRowSelected(RowSelectEventArgs<ExpenseEntryDto> args) => OpenEdit(args.Data);
    private void OpenCreate() { _editingId = Guid.Empty; _form = new(); _editContext = new(_form); _formError = null; _showForm = true; }
    private void OpenEdit(ExpenseEntryDto item) { _editingId = item.ExpenseId; _form = new ExpenseForm { AccountId = item.AccountId, UserId = item.UserId, ExpenseDate = item.ExpenseDate.ToDateTime(TimeOnly.MinValue), CategoryCode = item.CategoryCode, Amount = item.Amount, Description = item.Description, IsBillable = item.IsBillable, StatusCode = item.StatusCode, InvoiceId = item.InvoiceId }; _editContext = new(_form); _formError = null; _showForm = true; }
    private void CloseForm() => _showForm = false;
    private async Task SaveAsync() { if (!_editContext.Validate()) return; _saving = true; try { if (_editingId == Guid.Empty) await Api.CreateExpenseAsync(new CreateExpenseEntryRequest { TenantId = _tenantId, AccountId = _form.AccountId, UserId = _form.UserId, ExpenseDate = DateOnly.FromDateTime(_form.ExpenseDate), CategoryCode = _form.CategoryCode, Amount = _form.Amount, Description = _form.Description, IsBillable = _form.IsBillable, StatusCode = _form.StatusCode, InvoiceId = _form.InvoiceId }); else await Api.UpdateExpenseAsync(_editingId, new UpdateExpenseEntryRequest { ExpenseId = _editingId, AccountId = _form.AccountId, UserId = _form.UserId, ExpenseDate = DateOnly.FromDateTime(_form.ExpenseDate), CategoryCode = _form.CategoryCode, Amount = _form.Amount, Description = _form.Description, IsBillable = _form.IsBillable, StatusCode = _form.StatusCode, InvoiceId = _form.InvoiceId }); await ToastAsync("Expense saved."); _showForm = false; await LoadAsync(); } catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; await ToastAsync(_formError, true); } finally { _saving = false; } }
    private async Task UpdateStatusAsync(ExpenseEntryDto item, string status) { try { await Api.UpdateExpenseAsync(item.ExpenseId, new UpdateExpenseEntryRequest { ExpenseId = item.ExpenseId, AccountId = item.AccountId, UserId = item.UserId, ExpenseDate = item.ExpenseDate, CategoryCode = item.CategoryCode, Amount = item.Amount, Description = item.Description, IsBillable = item.IsBillable, StatusCode = status, InvoiceId = item.InvoiceId }); await ToastAsync($"Expense marked {status.ToLowerInvariant()}."); await LoadAsync(); } catch (Exception ex) { await ToastAsync($"Update failed: {ex.Message}", true); } }
    private async Task ToastAsync(string message, bool isError = false) => await _toast.ShowAsync(new ToastModel { Content = message, CssClass = isError ? "e-toast-danger" : "e-toast-success" });
    private static string Fmt(decimal value) => value.ToString("C0");
    private static string StatusClass(string status) => status switch { "Approved" => "bill-chip-success", "Submitted" => "bill-chip-info", "Invoiced" => "bill-chip-purple", _ => "bill-chip-neutral" };

    private sealed class ExpenseForm { [RequiredGuid(ErrorMessage = "Account is required.")] public Guid AccountId { get; set; } [RequiredGuid(ErrorMessage = "User is required.")] public Guid UserId { get; set; } [Required] public DateTime ExpenseDate { get; set; } = DateTime.Today; [Required, StringLength(80)] public string CategoryCode { get; set; } = "Travel"; [Range(0.01, 1000000)] public decimal Amount { get; set; } [StringLength(1000)] public string? Description { get; set; } public bool IsBillable { get; set; } = true; [Required, StringLength(50)] public string StatusCode { get; set; } = "Draft"; public Guid? InvoiceId { get; set; } }
    private sealed class RequiredGuidAttribute : ValidationAttribute { public override bool IsValid(object? value) => value is Guid guid && guid != Guid.Empty; }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
