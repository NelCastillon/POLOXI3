@page "/portal/users"
@page "/tenant/portal/users"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using Ams.Application.Common.Dtos
@using Ams.Application.Common.Validation
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Portal Users - AMS</PageTitle>

@if (_toastVisible)
{
    <div class="pu-toast pu-toast--@_toastKind" role="status" aria-live="polite">
        <i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="pu-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="pu-modal" role="dialog" aria-modal="true" aria-labelledby="pu-form-title" @onclick:stopPropagation="true">
            <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit">
                <DataAnnotationsValidator />
                <div class="pu-modal__header">
                    <i class="bi @(_editing is null ? "bi-person-plus" : "bi-person-gear")" aria-hidden="true"></i>
                    <span id="pu-form-title">@(_editing is null ? "Add Portal User" : $"Edit {_form.Name}")</span>
                    <button type="button" class="pu-icon-btn pu-icon-btn--light ms-auto" @onclick="CloseForm" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="pu-modal__body">
                    <div class="pu-modal-intro">
                        <strong>Portal access profile</strong>
                        <span>Manage client portal identity, account visibility, role, status, MFA, and invitation workflow.</span>
                    </div>
                    <div class="pu-form-grid">
                        <div class="pu-field">
                            <label>Full Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.Name" />
                        </div>
                        <div class="pu-field">
                            <label>Email Address <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.Email" />
                        </div>
                        <div class="pu-field">
                            <label>Account Name</label>
                            <InputText class="form-control" @bind-Value="_form.AccountName" />
                        </div>
                        <div class="pu-field">
                            <label>Portal Role <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.Role">
                                @foreach (var role in Roles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="pu-field">
                            <label>Status <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.Status">
                                @foreach (var status in Statuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="pu-field">
                            <label>Logins Last 30 Days</label>
                            <InputNumber class="form-control" @bind-Value="_form.Logins30d" />
                        </div>
                        <div class="pu-field pu-check-field">
                            <label>Security</label>
                            <label class="pu-check"><InputCheckbox @bind-Value="_form.MfaEnabled" /> <span>Require MFA</span></label>
                        </div>
                        <div class="pu-field pu-check-field">
                            <label>Invite</label>
                            <label class="pu-check"><InputCheckbox @bind-Value="_sendWelcome" /> <span>Send welcome email</span></label>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_formError))
                    {
                        <div class="alert alert-danger pu-inline-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_formError
                        </div>
                    }
                </div>
                <div class="pu-modal__footer">
                    <button type="button" class="pu-btn pu-btn--ghost" @onclick="CloseForm" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="pu-btn pu-btn--primary" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="pu-spin-sm" aria-hidden="true"></span>
                        }
                        Save User
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showConfirm)
{
    <div class="pu-modal-backdrop" role="presentation" @onclick="CloseConfirm">
        <div class="pu-confirm" role="dialog" aria-modal="true" aria-labelledby="pu-confirm-title" @onclick:stopPropagation="true">
            <div class="pu-modal__header"><i class="bi @_confirmIcon" aria-hidden="true"></i><span>Confirm action</span><button type="button" class="pu-icon-btn pu-icon-btn--light ms-auto" @onclick="CloseConfirm" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="pu-confirm__body">
                <div class="@(_pendingAction is "Suspend" or "Delete" ? "pu-confirm-icon pu-confirm-icon--danger" : "pu-confirm-icon")"><i class="bi @_confirmIcon" aria-hidden="true"></i></div>
                <div><h3 id="pu-confirm-title">@_confirmTitle</h3><p>@_confirmMessage</p></div>
            </div>
            <div class="pu-modal__footer">
                <button type="button" class="pu-btn pu-btn--ghost" @onclick="CloseConfirm" disabled="@_actionBusy">Cancel</button>
                <button type="button" class="@(_pendingAction is "Suspend" or "Delete" ? "pu-btn pu-btn--danger" : "pu-btn pu-btn--primary")" @onclick="ExecuteConfirmedAsync" disabled="@_actionBusy">
                    @if (_actionBusy)
                    {
                        <span class="pu-spin-sm" aria-hidden="true"></span>
                    }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<div class="pu-page" @onclick="CloseActionMenu">
    <section class="pu-hero">
        <div class="pu-hero__content">
            <div class="pu-hero-left">
                <span class="pu-hero-icon"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
                <div class="pu-hero-title">
                    <span class="pu-hero__eyebrow">Client portal identity command center</span>
                    <div class="pu-title-row">
                        <h1>Portal Users</h1>
                        <div class="pu-hero__meta">
                            <span><i class="bi bi-people" aria-hidden="true"></i>@_rows.Count users</span>
                            <span><i class="bi bi-person-check" aria-hidden="true"></i>@_rows.Count(r => r.Status == "Active") active</span>
                            <span><i class="bi bi-shield-check" aria-hidden="true"></i>@MfaCoverage.ToString("0")% MFA</span>
                            <span><i class="bi bi-activity" aria-hidden="true"></i>@_rows.Sum(r => r.Logins30d) logins / 30d</span>
                        </div>
                    </div>
                </div>
            </div>
            <p>Manage portal access, invitation status, account visibility, MFA coverage, and service readiness.</p>
        </div>
        <div class="pu-hero__actions">
            <button type="button" class="pu-btn pu-btn--light" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "pu-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="pu-btn pu-btn--primary" @onclick="OpenCreate"><i class="bi bi-person-plus" aria-hidden="true"></i> Add Portal User</button>
            <button type="button" class="pu-btn pu-btn--light" @onclick='() => Nav.NavigateTo("/portal/invites")'><i class="bi bi-envelope-paper" aria-hidden="true"></i> Invites</button>
            <button type="button" class="pu-btn pu-btn--light" @onclick='() => Nav.NavigateTo("/portal/activity")'><i class="bi bi-clock-history" aria-hidden="true"></i> Activity</button>
        </div>
    </section>

    <section class="pu-kpi-strip" aria-label="Portal user KPIs">
        @KpiCard("all", "Total Users", _rows.Count.ToString(), "All portal identities", "bi-people", "pu-kpi--blue")
        @KpiCard("active", "Active", _rows.Count(r => r.Status == "Active").ToString(), "Can access self-service", "bi-person-check", "pu-kpi--green")
        @KpiCard("pending", "Pending", _rows.Count(r => r.Status == "Pending").ToString(), "Invite follow-up queue", "bi-hourglass-split", "pu-kpi--amber")
        @KpiCard("suspended", "Suspended", _rows.Count(r => r.Status == "Suspended").ToString(), "Blocked from access", "bi-person-slash", "pu-kpi--red")
        @KpiCard("mfa", "MFA Enabled", _rows.Count(r => r.MfaEnabled).ToString(), "Security coverage", "bi-shield-check", "pu-kpi--purple")
        @KpiCard("engaged", "Engaged", _rows.Count(IsEngaged).ToString(), "Logged in during 30 days", "bi-graph-up-arrow", "pu-kpi--cyan")
    </section>

    <section class="pu-workflows" aria-label="Portal workflows">
        @WorkflowButton("bi-envelope-plus", "Invite clients", "Create access and send welcome", OpenCreate)
        @WorkflowButton("bi-shield-lock", "Security review", "Filter MFA gaps", () => SetKpiFilter("mfa-missing"))
        @WorkflowButton("bi-person-lines-fill", "Pending follow-up", "Review invite backlog", () => SetKpiFilter("pending"))
        @WorkflowButton("bi-folder2-open", "Documents", "Open portal document center", () => Nav.NavigateTo("/portal/documents"))
        @WorkflowButton("bi-headset", "Requests", "Open self-service queue", () => Nav.NavigateTo("/portal/requests"))
    </section>

    <section class="pu-filter-panel">
        <div class="pu-search-wrap">
            <span class="pu-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="pu-search-body">
                <input class="pu-search-input" aria-label="Search portal users" placeholder="Search name, email, account, role, status, security, engagement..." @bind="SearchText" @bind:event="oninput" />
            </div>
        </div>
        <div class="pu-filter-actions">
            <select class="pu-select" @bind="RoleFilter">
                <option value="">All roles</option>
                @foreach (var role in Roles)
                {
                    <option value="@role">@role</option>
                }
            </select>
            <select class="pu-select" @bind="StatusFilter">
                <option value="">All statuses</option>
                @foreach (var status in Statuses)
                {
                    <option value="@status">@status</option>
                }
            </select>
            <span>@FilteredRows.Count() visible</span>
            <button type="button" class="pu-btn pu-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger pu-alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError
        </div>
    }

    <section class="pu-tabs" aria-label="Portal user views">
        @foreach (var tab in Tabs)
        {
            <button type="button" class="pu-tab @(_activeTab == tab.Key ? "pu-tab--active" : null)" @onclick="() => SetTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </section>

    <section class="pu-dashboard">
        <div class="pu-main-card">
            <div class="pu-card-header">
                <div>
                    <span class="pu-section-kicker"><i class="bi bi-person-vcard" aria-hidden="true"></i> Identity register</span>
                    <h2>@ActiveViewTitle</h2>
                    <p>Prioritized by access risk, recent engagement, invite aging, MFA posture, and account service importance.</p>
                </div>
                <div class="pu-card-actions">
                    <button type="button" class="pu-btn pu-btn--ghost" @onclick="ExportAsync" disabled="@(!FilteredRows.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
                    <button type="button" class="pu-btn pu-btn--ghost" @onclick="ToggleView"><i class="bi @(_cardView ? "bi-table" : "bi-grid-3x3-gap")" aria-hidden="true"></i> @(_cardView ? "Table" : "Cards")</button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="pu-loading"><span class="pu-spinner" aria-hidden="true"></span> Loading portal users...</div>
            }
            else if (!FilteredRows.Any())
            {
                <div class="pu-empty">
                    <i class="bi bi-inbox" aria-hidden="true"></i>
                    <strong>No portal users found</strong>
                    <span>Adjust filters or add a portal user to start the client access workflow.</span>
                    <button type="button" class="pu-btn pu-btn--primary" @onclick="OpenCreate"><i class="bi bi-person-plus" aria-hidden="true"></i> Add Portal User</button>
                </div>
            }
            else if (_cardView)
            {
                <div class="pu-card-grid">
                    @foreach (var row in PagedRows)
                    {
                        @UserCard(row)
                    }
                </div>
            }
            else
            {
                <div class="pu-table-scroll">
                    <table class="pu-table" aria-label="Portal users">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Account</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Security</th>
                                <th class="pu-num">30d Logins</th>
                                <th>Last Login</th>
                                <th>Priority</th>
                                <th class="pu-actions-col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in PagedRows)
                            {
                                <tr class="pu-table-row @(_selected?.RecordId == row.RecordId ? "pu-table-row--selected" : null)" @onclick="() => SelectUser(row)">
                                    <td>@UserCell(row)</td>
                                    <td>@(string.IsNullOrWhiteSpace(row.AccountName) ? "-" : row.AccountName)</td>
                                    <td><span class="pu-role pu-role--@CssSafe(row.Role)">@row.Role</span></td>
                                    <td><span class="pu-status pu-status--@CssSafe(row.Status)">@row.Status</span></td>
                                    <td>@SecurityCell(row)</td>
                                    <td class="pu-num"><strong>@row.Logins30d</strong></td>
                                    <td>@LastLoginText(row)</td>
                                    <td><span class="pu-priority pu-priority--@PriorityLevel(row).ToLowerInvariant()">@PriorityLevel(row)</span></td>
                                    <td class="pu-actions-col">@ActionMenu(row)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="pu-pager">
                <button type="button" class="pu-btn pu-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</button>
                <span>Page @_page of @TotalPages</span>
                <button type="button" class="pu-btn pu-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
            </div>
        </div>

        <aside class="pu-side-panel">
            <div class="pu-panel-card">
                <span class="pu-section-kicker"><i class="bi bi-stars" aria-hidden="true"></i> Importance score</span>
                <div class="pu-score-card">
                    <span>Portfolio readiness</span>
                    <strong>@ReadinessScore</strong>
                    <small>/100</small>
                </div>
                <div class="pu-readiness"><span style="width:@ReadinessScore%"></span></div>
                <div class="pu-importance-list">
                    @foreach (var item in ImportanceSignals)
                    {
                        <div><i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Text</span></div>
                    }
                </div>
            </div>

            <div class="pu-panel-card">
                <span class="pu-section-kicker"><i class="bi bi-person-badge" aria-hidden="true"></i> Selected user</span>
                @if (_selected is null)
                {
                    <div class="pu-empty pu-empty--compact"><span>Select a portal user to review account access, security, and workflow actions.</span></div>
                }
                else
                {
                    var selected = _selected!;
                    <div class="pu-selected-head">
                        <span class="pu-avatar pu-avatar--@CssSafe(selected.Role)">@Initials(selected.Name)</span>
                        <div><strong>@selected.Name</strong><span>@selected.Email</span></div>
                    </div>
                    <div class="pu-detail-list">
                        <div><span>Account</span><strong>@(string.IsNullOrWhiteSpace(selected.AccountName) ? "-" : selected.AccountName)</strong></div>
                        <div><span>Role</span><strong>@selected.Role</strong></div>
                        <div><span>Status</span><strong>@selected.Status</strong></div>
                        <div><span>MFA</span><strong>@(selected.MfaEnabled ? "Enabled" : "Missing")</strong></div>
                        <div><span>30d Logins</span><strong>@selected.Logins30d</strong></div>
                        <div><span>Last Login</span><strong>@LastLoginText(selected)</strong></div>
                    </div>
                    <div class="pu-selected-actions">
                        <button type="button" class="pu-btn pu-btn--primary" @onclick="@(() => OpenEdit(selected))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit User</button>
                        <button type="button" class="pu-btn pu-btn--ghost" @onclick="@(() => OpenConfirm(selected, ToggleStatusAction(selected)))"><i class="bi bi-shield-exclamation" aria-hidden="true"></i> @ToggleStatusAction(selected)</button>
                    </div>
                }
            </div>

            <div class="pu-panel-card">
                <span class="pu-section-kicker"><i class="bi bi-pie-chart" aria-hidden="true"></i> Role mix</span>
                <div class="pu-mix-list">
                    @foreach (var role in Roles)
                    {
                        <div><span><i class="bi bi-person" aria-hidden="true"></i>@role</span><strong>@_rows.Count(r => r.Role == role)</strong></div>
                    }
                </div>
            </div>
        </aside>
    </section>
</div>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private static readonly string[] Roles = ["Policyholder", "Contact", "Admin"];
    private static readonly string[] Statuses = ["Active", "Pending", "Suspended"];
    private static readonly TabDef[] Tabs =
    [
        new("all", "All", "bi-stack"),
        new("active", "Active", "bi-person-check"),
        new("pending", "Pending", "bi-hourglass-split"),
        new("suspended", "Suspended", "bi-person-slash"),
        new("mfa", "MFA", "bi-shield-check"),
        new("risk", "Needs Attention", "bi-exclamation-triangle"),
        new("engaged", "Engaged", "bi-activity"),
        new("admins", "Admins", "bi-person-gear")
    ];

    private readonly List<PortalUserRow> _rows = [];
    private Guid _tenantId;
    private bool _loading;
    private bool _actionBusy;
    private bool _showForm;
    private bool _showConfirm;
    private bool _toastVisible;
    private bool _sendWelcome = true;
    private bool _cardView;
    private string _toastKind = "success";
    private string _toastMessage = string.Empty;
    private string _activeTab = "all";
    private string? _kpiFilter;
    private string? _searchText;
    private string? _roleFilter;
    private string? _statusFilter;
    private string? _loadError;
    private string? _formError;
    private Guid? _openActionMenuFor;
    private int _page = 1;
    private const int PageSize = 12;

    private PortalUserRow? _selected;
    private PortalUserRow? _editing;
    private PortalUserForm _form = new();
    private PortalUserRow? _pendingUser;
    private string _pendingAction = string.Empty;
    private string _confirmTitle = "Confirm action";
    private string _confirmMessage = "Confirm this portal user action?";
    private string _confirmIcon = "bi-question-circle";

    private string? SearchText { get => _searchText; set { _searchText = value; _page = 1; } }
    private string? RoleFilter { get => _roleFilter; set { _roleFilter = value; _page = 1; } }
    private string? StatusFilter { get => _statusFilter; set { _statusFilter = value; _page = 1; } }
    private bool HasFilters => !string.IsNullOrWhiteSpace(_searchText) || !string.IsNullOrWhiteSpace(_roleFilter) || !string.IsNullOrWhiteSpace(_statusFilter) || _kpiFilter is not null || _activeTab != "all";
    private decimal MfaCoverage => _rows.Count == 0 ? 0 : _rows.Count(r => r.MfaEnabled) * 100m / _rows.Count;
    private int ReadinessScore => _rows.Count == 0 ? 100 : Math.Clamp((int)Math.Round((_rows.Count(r => r.Status == "Active") * 38m + _rows.Count(r => r.MfaEnabled) * 32m + _rows.Count(IsEngaged) * 30m) / _rows.Count), 0, 100);
    private string ActiveViewTitle => _activeTab switch
    {
        "active" => "Active portal access",
        "pending" => "Pending invitation queue",
        "suspended" => "Suspended access controls",
        "mfa" => "MFA-secured users",
        "risk" => "Users needing attention",
        "engaged" => "Recently engaged users",
        "admins" => "Portal administrators",
        _ => "All portal users"
    };

    private IEnumerable<PortalUserRow> TabRows => _activeTab switch
    {
        "active" => _rows.Where(r => r.Status == "Active"),
        "pending" => _rows.Where(r => r.Status == "Pending"),
        "suspended" => _rows.Where(r => r.Status == "Suspended"),
        "mfa" => _rows.Where(r => r.MfaEnabled),
        "risk" => _rows.Where(NeedsAttention),
        "engaged" => _rows.Where(IsEngaged),
        "admins" => _rows.Where(r => r.Role == "Admin"),
        _ => _rows
    };

    private IEnumerable<PortalUserRow> KpiRows => _kpiFilter switch
    {
        "active" => TabRows.Where(r => r.Status == "Active"),
        "pending" => TabRows.Where(r => r.Status == "Pending"),
        "suspended" => TabRows.Where(r => r.Status == "Suspended"),
        "mfa" => TabRows.Where(r => r.MfaEnabled),
        "mfa-missing" => TabRows.Where(r => !r.MfaEnabled),
        "engaged" => TabRows.Where(IsEngaged),
        _ => TabRows
    };

    private IEnumerable<PortalUserRow> FilteredRows => ApplyFilters(KpiRows).OrderByDescending(ImportanceScore).ThenBy(r => r.Name);
    private IEnumerable<PortalUserRow> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)PageSize));
    private IEnumerable<Signal> ImportanceSignals => BuildImportanceSignals();

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Portal", "/portal/users"), new("Users", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchPortalAdminRecordsAsync(_tenantId, "PortalUser", _searchText);
            _rows.Clear();
            foreach (var record in result?.Items ?? [])
            {
                var user = DeserializeUser(record);
                if (user is not null)
                {
                    _rows.Add(PortalUserRow.From(record, user));
                }
            }
            _selected = _rows.FirstOrDefault(r => _selected?.RecordId == r.RecordId) ?? _rows.OrderByDescending(ImportanceScore).FirstOrDefault();
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load portal users: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private static PortalAdminUserDto? DeserializeUser(PortalAdminRecordDto record)
    {
        try
        {
            var user = JsonSerializer.Deserialize<PortalAdminUserDto>(record.JsonData ?? "{}", JsonOptions) ?? new();
            user.Id = record.PortalAdminRecordId;
            if (string.IsNullOrWhiteSpace(user.Name)) user.Name = record.Name;
            if (string.IsNullOrWhiteSpace(user.Email)) user.Email = record.Code;
            if (string.IsNullOrWhiteSpace(user.Status)) user.Status = record.Status;
            return user;
        }
        catch
        {
            return null;
        }
    }

    private IEnumerable<PortalUserRow> ApplyFilters(IEnumerable<PortalUserRow> rows)
    {
        if (!string.IsNullOrWhiteSpace(_roleFilter)) rows = rows.Where(r => r.Role == _roleFilter);
        if (!string.IsNullOrWhiteSpace(_statusFilter)) rows = rows.Where(r => r.Status == _statusFilter);
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim();
            rows = rows.Where(r => Contains(r.Name, term) || Contains(r.Email, term) || Contains(r.AccountName, term) || Contains(r.Role, term) || Contains(r.Status, term) || Contains(r.SecurityText, term) || Contains(LastLoginText(r), term));
        }
        return rows;
    }

    private string TabCount(string key) => key switch
    {
        "all" => _rows.Count.ToString(),
        "active" => _rows.Count(r => r.Status == "Active").ToString(),
        "pending" => _rows.Count(r => r.Status == "Pending").ToString(),
        "suspended" => _rows.Count(r => r.Status == "Suspended").ToString(),
        "mfa" => _rows.Count(r => r.MfaEnabled).ToString(),
        "risk" => _rows.Count(NeedsAttention).ToString(),
        "engaged" => _rows.Count(IsEngaged).ToString(),
        "admins" => _rows.Count(r => r.Role == "Admin").ToString(),
        _ => string.Empty
    };

    private void SetTab(string key) { _activeTab = key; _page = 1; }
    private void SetKpiFilter(string key) { _kpiFilter = _kpiFilter == key || key == "all" ? null : key; _page = 1; }
    private void ClearFilters() { _searchText = null; _roleFilter = null; _statusFilter = null; _kpiFilter = null; _activeTab = "all"; _page = 1; }
    private void ToggleView() => _cardView = !_cardView;
    private void PreviousPage() { if (_page > 1) _page--; }
    private void NextPage() { if (_page < TotalPages) _page++; }
    private void SelectUser(PortalUserRow row) => _selected = row;

    private void OpenCreate()
    {
        _editing = null;
        _form = new PortalUserForm();
        _sendWelcome = true;
        _formError = null;
        _showForm = true;
    }

    private void OpenEdit(PortalUserRow row)
    {
        _selected = row;
        _editing = row;
        _form = row.ToForm();
        _sendWelcome = false;
        _formError = null;
        _showForm = true;
    }

    private void CloseForm()
    {
        if (_actionBusy) return;
        _showForm = false;
        _formError = null;
    }

    private async Task SaveAsync()
    {
        _actionBusy = true;
        _formError = null;
        try
        {
            var user = _form.ToDto(_editing?.LastLogin, _editing?.RecordId ?? Guid.Empty);
            var json = JsonSerializer.Serialize(user, JsonOptions);
            if (_editing is null)
            {
                await Api.CreatePortalAdminRecordAsync(new UpsertPortalAdminRecordRequest(_tenantId, "PortalUser", user.Email, user.Name, user.Status, json));
                ShowToast($"Portal user {user.Name} added{(_sendWelcome ? " and invite queued." : ".")}");
            }
            else
            {
                await Api.UpdatePortalAdminRecordAsync(_editing.RecordId, new UpsertPortalAdminRecordRequest(_tenantId, "PortalUser", user.Email, user.Name, user.Status, json));
                ShowToast($"Portal user {user.Name} updated.");
            }
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private void HandleInvalidSubmit(EditContext editContext) => _formError = "Fix the highlighted validation errors before saving this portal user.";

    private void OpenConfirm(PortalUserRow row, string action)
    {
        _selected = row;
        _pendingUser = row;
        _pendingAction = action;
        (_confirmTitle, _confirmMessage, _confirmIcon) = action switch
        {
            "Reactivate" => ($"Reactivate {row.Name}?", "This restores portal access for the client after confirming account and security posture.", "bi-person-check"),
            "Suspend" => ($"Suspend {row.Name}?", "This immediately blocks portal access while preserving audit history and user configuration.", "bi-person-slash"),
            "Resend" => ($"Resend invite to {row.Email}?", "This keeps the user pending and queues a new welcome invitation notification.", "bi-envelope-arrow-up"),
            "Delete" => ($"Delete {row.Name}?", "This removes the portal user administration record. Use suspend if access may need to be restored later.", "bi-trash"),
            _ => ("Confirm action", "Confirm this portal user action?", "bi-question-circle")
        };
        _showConfirm = true;
    }

    private void CloseConfirm()
    {
        if (_actionBusy) return;
        _showConfirm = false;
    }

    private async Task ExecuteConfirmedAsync()
    {
        if (_pendingUser is null) return;
        _actionBusy = true;
        try
        {
            switch (_pendingAction)
            {
                case "Reactivate":
                    await UpdateStatusAsync(_pendingUser, "Active");
                    ShowToast($"{_pendingUser.Name} reactivated.");
                    break;
                case "Suspend":
                    await UpdateStatusAsync(_pendingUser, "Suspended");
                    ShowToast($"{_pendingUser.Name} suspended.");
                    break;
                case "Resend":
                    await UpdateStatusAsync(_pendingUser, "Pending");
                    ShowToast($"Invite resent to {_pendingUser.Email}.");
                    break;
                case "Delete":
                    await Api.DeletePortalAdminRecordAsync(_pendingUser.RecordId);
                    ShowToast($"{_pendingUser.Name} removed.");
                    break;
            }
            _showConfirm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Action failed: {ex.Message}", "danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    private async Task UpdateStatusAsync(PortalUserRow row, string status)
    {
        var dto = row.ToDto();
        dto.Status = status;
        var json = JsonSerializer.Serialize(dto, JsonOptions);
        await Api.UpdatePortalAdminRecordAsync(row.RecordId, new UpsertPortalAdminRecordRequest(_tenantId, "PortalUser", dto.Email, dto.Name, status, json));
    }

    private async Task HandleActionAsync(PortalUserRow row, string action)
    {
        _openActionMenuFor = null;
        _selected = row;
        switch (action)
        {
            case "Edit": OpenEdit(row); break;
            case "Activity": Nav.NavigateTo($"/portal/activity?searchTerm={Uri.EscapeDataString(row.Email)}"); break;
            case "Documents": Nav.NavigateTo($"/portal/documents?searchTerm={Uri.EscapeDataString(row.AccountName)}"); break;
            case "Requests": Nav.NavigateTo($"/portal/requests?searchTerm={Uri.EscapeDataString(row.AccountName)}"); break;
            case "Resend": OpenConfirm(row, "Resend"); break;
            case "Reactivate": OpenConfirm(row, "Reactivate"); break;
            case "Suspend": OpenConfirm(row, "Suspend"); break;
            case "Delete": OpenConfirm(row, "Delete"); break;
            default: await Task.CompletedTask; break;
        }
    }

    private async Task ExportAsync()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Name,Email,Account,Role,Status,MFA,Logins30d,LastLogin,Priority");
        foreach (var row in FilteredRows)
        {
            csv.AppendLine(string.Join(',', Csv(row.Name), Csv(row.Email), Csv(row.AccountName), Csv(row.Role), Csv(row.Status), Csv(row.MfaEnabled ? "Enabled" : "Missing"), Csv(row.Logins30d.ToString()), Csv(LastLoginText(row)), Csv(PriorityLevel(row))));
        }
        Nav.NavigateTo("data:text/csv;charset=utf-8," + Uri.EscapeDataString(csv.ToString()), forceLoad: true);
        ShowToast("Portal users export generated.");
        await Task.CompletedTask;
    }

    private void ToggleActionMenu(PortalUserRow row)
    {
        _selected = row;
        _openActionMenuFor = _openActionMenuFor == row.RecordId ? null : row.RecordId;
    }

    private void CloseActionMenu()
    {
        if (_actionBusy) return;
        _openActionMenuFor = null;
    }

    private IEnumerable<Signal> BuildImportanceSignals()
    {
        yield return new("bi-shield-exclamation", $"{_rows.Count(r => !r.MfaEnabled)} users missing MFA should be reviewed first.");
        yield return new("bi-hourglass-split", $"{_rows.Count(r => r.Status == "Pending")} pending invites need follow-up.");
        yield return new("bi-person-slash", $"{_rows.Count(r => r.Status == "Suspended")} suspended users are blocked from access.");
        yield return new("bi-activity", $"{_rows.Sum(r => r.Logins30d)} portal logins occurred during the last 30 days.");
    }

    private RenderFragment KpiCard(string key, string label, string value, string detail, string icon, string css) => @<button type="button" class="pu-kpi @css @((_kpiFilter == key || (key == "all" && _kpiFilter is null)) ? "pu-kpi--active" : null)" @onclick="() => SetKpiFilter(key)" title="Filter by @label">
        <span><i class="bi @icon" aria-hidden="true"></i>@label</span>
        <strong>@value</strong>
        <small>@detail</small>
    </button>;

    private RenderFragment WorkflowButton(string icon, string title, string detail, System.Action action) => @<button type="button" class="pu-workflow" @onclick="@(() => action())">
        <i class="bi @icon" aria-hidden="true"></i>
        <span><strong>@title</strong><small>@detail</small></span>
    </button>;

    private RenderFragment UserCell(PortalUserRow row) => @<div class="pu-user-cell">
        <span class="pu-avatar pu-avatar--@CssSafe(row.Role)">@Initials(row.Name)</span>
        <div><strong>@row.Name</strong><span>@row.Email</span></div>
    </div>;

    private RenderFragment SecurityCell(PortalUserRow row) => @<span class="pu-security @(row.MfaEnabled ? "pu-security--ok" : "pu-security--risk")"><i class="bi @(row.MfaEnabled ? "bi-shield-check" : "bi-shield-x")" aria-hidden="true"></i>@row.SecurityText</span>;

    private RenderFragment UserCard(PortalUserRow row) => @<article class="pu-user-card @(_selected?.RecordId == row.RecordId ? "pu-user-card--active" : null)" @onclick="@(() => SelectUser(row))">
        <div class="pu-user-card__top">
            @UserCell(row)
            <span class="pu-priority pu-priority--@PriorityLevel(row).ToLowerInvariant()">@PriorityLevel(row)</span>
        </div>
        <div class="pu-user-card__meta">
            <span><i class="bi bi-building" aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(row.AccountName) ? "No account assigned" : row.AccountName)</span>
            <span><i class="bi bi-person-badge" aria-hidden="true"></i>@row.Role - @row.Status</span>
            <span><i class="bi bi-shield-lock" aria-hidden="true"></i>@row.SecurityText</span>
            <span><i class="bi bi-clock-history" aria-hidden="true"></i>@LastLoginText(row)</span>
        </div>
        <div class="pu-user-card__actions" @onclick:stopPropagation="true">
            <button type="button" class="pu-btn pu-btn--ghost" @onclick="@(() => OpenEdit(row))"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
            <button type="button" class="pu-btn pu-btn--ghost" @onclick="@(() => OpenConfirm(row, ToggleStatusAction(row)))"><i class="bi bi-shield-exclamation" aria-hidden="true"></i> @ToggleStatusAction(row)</button>
        </div>
    </article>;

    private RenderFragment ActionMenu(PortalUserRow row) => @<div class="pu-action-menu-wrap" @onclick:stopPropagation="true">
        <button type="button" class="pu-icon-btn" @onclick="@(() => ToggleActionMenu(row))" aria-haspopup="menu" aria-expanded="@(_openActionMenuFor == row.RecordId)" title="Portal user actions"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
        @if (_openActionMenuFor == row.RecordId)
        {
            <div class="pu-action-menu" role="menu">
                <div class="pu-action-menu__summary"><strong>@row.Name</strong><span>@row.Email</span></div>
                @foreach (var action in ActionsFor(row))
                {
                    <button type="button" class="pu-action-menu__item @(action is "Delete" or "Suspend" ? "pu-action-menu__item--danger" : null)" role="menuitem" @onclick="@(() => HandleActionAsync(row, action))">
                        <i class="bi @ActionIcon(action)" aria-hidden="true"></i>@action
                    </button>
                }
            </div>
        }
    </div>;

    private static IEnumerable<string> ActionsFor(PortalUserRow row)
    {
        yield return "Edit";
        yield return "Activity";
        yield return "Documents";
        yield return "Requests";
        if (row.Status == "Pending") yield return "Resend";
        yield return row.Status == "Suspended" ? "Reactivate" : "Suspend";
        yield return "Delete";
    }

    private static string ActionIcon(string action) => action switch
    {
        "Edit" => "bi-pencil",
        "Activity" => "bi-clock-history",
        "Documents" => "bi-folder2-open",
        "Requests" => "bi-headset",
        "Resend" => "bi-envelope-arrow-up",
        "Reactivate" => "bi-person-check",
        "Suspend" => "bi-person-slash",
        "Delete" => "bi-trash",
        _ => "bi-circle"
    };

    private static bool Contains(string? source, string term) => !string.IsNullOrWhiteSpace(source) && source.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static bool IsEngaged(PortalUserRow row) => row.Status == "Active" && row.LastLogin >= DateTime.Today.AddDays(-30);
    private static bool NeedsAttention(PortalUserRow row) => row.Status == "Pending" || row.Status == "Suspended" || !row.MfaEnabled;
    private static int ImportanceScore(PortalUserRow row) => (row.Status == "Pending" ? 40 : 0) + (row.Status == "Suspended" ? 35 : 0) + (!row.MfaEnabled ? 30 : 0) + (row.Role == "Admin" ? 20 : 0) + Math.Min(row.Logins30d, 20);
    private static string PriorityLevel(PortalUserRow row) => ImportanceScore(row) >= 60 ? "High" : ImportanceScore(row) >= 30 ? "Medium" : "Normal";
    private static string ToggleStatusAction(PortalUserRow row) => row.Status == "Suspended" ? "Reactivate" : "Suspend";
    private static string LastLoginText(PortalUserRow row) => row.LastLogin <= DateTime.MinValue.AddDays(1) ? "Never" : row.LastLogin.ToLocalTime().ToString("MMM d, yyyy");
    private static string CssSafe(string value) => string.IsNullOrWhiteSpace(value) ? "unknown" : value.Trim().ToLowerInvariant().Replace(" ", "-").Replace("/", "-");
    private static string Initials(string name) { var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}" : name.Length > 0 ? name[..1] : "?"; }
    private static string Csv(string? value) => string.Concat("\"", (value ?? string.Empty).Replace("\"", "\"\""), "\"");
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;

    private sealed record TabDef(string Key, string Label, string Icon);
    private sealed record Signal(string Icon, string Text);

    private sealed class PortalUserRow
    {
        public Guid RecordId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string AccountName { get; set; } = string.Empty;
        public string Role { get; set; } = "Policyholder";
        public string Status { get; set; } = "Pending";
        public DateTime LastLogin { get; set; }
        public bool MfaEnabled { get; set; }
        public int Logins30d { get; set; }
        public string SecurityText => MfaEnabled ? "MFA enabled" : "MFA missing";

        public static PortalUserRow From(PortalAdminRecordDto record, PortalAdminUserDto dto) => new()
        {
            RecordId = record.PortalAdminRecordId,
            Name = dto.Name,
            Email = dto.Email,
            AccountName = dto.AccountName,
            Role = string.IsNullOrWhiteSpace(dto.Role) ? "Policyholder" : dto.Role,
            Status = string.IsNullOrWhiteSpace(dto.Status) ? record.Status : dto.Status,
            LastLogin = dto.LastLogin,
            MfaEnabled = dto.MfaEnabled,
            Logins30d = dto.Logins30d
        };

        public PortalAdminUserDto ToDto() => new()
        {
            Id = RecordId,
            Name = Name,
            Email = Email,
            AccountName = AccountName,
            Role = Role,
            Status = Status,
            LastLogin = LastLogin,
            MfaEnabled = MfaEnabled,
            Logins30d = Logins30d
        };

        public PortalUserForm ToForm() => new()
        {
            Name = Name,
            Email = Email,
            AccountName = AccountName,
            Role = Role,
            Status = Status,
            MfaEnabled = MfaEnabled,
            Logins30d = Logins30d
        };
    }

    private sealed class PortalUserForm
    {
        [Required(ErrorMessage = "Full name is required.")]
        [StringLength(160, ErrorMessage = "Full name cannot exceed 160 characters.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email address is required.")]
        [AmsEmailAddress]
        [StringLength(320, ErrorMessage = "Email address cannot exceed 320 characters.")]
        public string Email { get; set; } = string.Empty;

        [StringLength(200, ErrorMessage = "Account name cannot exceed 200 characters.")]
        public string AccountName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Portal role is required.")]
        [StringLength(50, ErrorMessage = "Portal role cannot exceed 50 characters.")]
        public string Role { get; set; } = "Policyholder";

        [Required(ErrorMessage = "Status is required.")]
        [StringLength(50, ErrorMessage = "Status cannot exceed 50 characters.")]
        public string Status { get; set; } = "Pending";

        public bool MfaEnabled { get; set; }

        [Range(0, 100000, ErrorMessage = "Logins must be zero or greater.")]
        public int Logins30d { get; set; }

        public PortalAdminUserDto ToDto(DateTime? lastLogin, Guid id) => new()
        {
            Id = id,
            Name = Name,
            Email = Email,
            AccountName = AccountName,
            Role = Role,
            Status = Status,
            LastLogin = Status == "Pending" ? DateTime.MinValue : lastLogin.GetValueOrDefault(DateTime.UtcNow),
            MfaEnabled = MfaEnabled,
            Logins30d = Logins30d
        };
    }
}
