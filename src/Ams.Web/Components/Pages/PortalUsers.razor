@page "/portal/users"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Portal Users — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Portal Users"
               Subtitle="Manage insured and client accounts with self-service portal access"
               Icon="bi-people-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="() => _showInvite = true">
            <i class="bi bi-envelope-plus" aria-hidden="true"></i> Send Invite
        </button>
        <button class="um-btn um-btn-primary" @onclick="() => _showInvite = true">
            <i class="bi bi-person-plus" aria-hidden="true"></i> Add Portal User
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="pu-kpi-strip">
    <div class="pu-kpi-card">
        <div class="pu-kpi-icon pu-ki-blue"><i class="bi bi-people" aria-hidden="true"></i></div>
        <div><div class="pu-kv">@_users.Count</div><div class="pu-kl">Total Portal Users</div></div>
    </div>
    <div class="pu-kpi-card">
        <div class="pu-kpi-icon pu-ki-green"><i class="bi bi-person-check" aria-hidden="true"></i></div>
        <div><div class="pu-kv">@_users.Count(u => u.Status == "Active")</div><div class="pu-kl">Active</div></div>
    </div>
    <div class="pu-kpi-card">
        <div class="pu-kpi-icon pu-ki-amber"><i class="bi bi-hourglass" aria-hidden="true"></i></div>
        <div><div class="pu-kv">@_users.Count(u => u.Status == "Pending")</div><div class="pu-kl">Pending Invite</div></div>
    </div>
    <div class="pu-kpi-card">
        <div class="pu-kpi-icon pu-ki-red"><i class="bi bi-person-slash" aria-hidden="true"></i></div>
        <div><div class="pu-kv">@_users.Count(u => u.Status == "Suspended")</div><div class="pu-kl">Suspended</div></div>
    </div>
    <div class="pu-kpi-card">
        <div class="pu-kpi-icon pu-ki-green"><i class="bi bi-calendar-check" aria-hidden="true"></i></div>
        <div><div class="pu-kv">@_users.Count(u => u.LastLogin >= DateTime.Today.AddDays(-30))</div><div class="pu-kl">Active 30 Days</div></div>
    </div>
</div>

<!-- Filter bar -->
<div class="pu-filter-bar">
    <div class="pu-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="pu-search" placeholder="Search users…" @bind="_search" @bind:event="oninput" />
    </div>
    <select class="pu-sel" @bind="_statusFilter">
        <option value="">All Statuses</option>
        <option value="Active">Active</option>
        <option value="Pending">Pending</option>
        <option value="Suspended">Suspended</option>
    </select>
    <select class="pu-sel" @bind="_roleFilter">
        <option value="">All Roles</option>
        <option value="Policyholder">Policyholder</option>
        <option value="Contact">Contact</option>
        <option value="Admin">Admin</option>
    </select>
</div>

<!-- Grid -->
<div class="pu-grid-wrap">
    <SfGrid TValue="PortalUser" DataSource="Filtered" AllowSorting="true" AllowFiltering="true"
            EnableHover="true" RowHeight="56">
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu" />
        <GridColumns>
            <GridColumn HeaderText="User" MinWidth="220" Field="@nameof(PortalUser.Name)">
                <Template>
                    @{ var u = (PortalUser)context; }
                    <div class="pu-user-cell">
                        <div class="pu-av @AvatarCss(u.Role)">@Initials(u.Name)</div>
                        <div>
                            <div class="pu-name">@u.Name</div>
                            <div class="pu-email">@u.Email</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(PortalUser.AccountName)" HeaderText="Account" MinWidth="180" />
            <GridColumn Field="@nameof(PortalUser.Role)" HeaderText="Role" Width="130">
                <Template>@{ var u = (PortalUser)context; }<span class="@RoleBadge(u.Role)">@u.Role</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(PortalUser.Status)" HeaderText="Status" Width="110">
                <Template>@{ var u = (PortalUser)context; }<span class="@StatusBadge(u.Status)">@u.Status</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(PortalUser.LastLogin)" HeaderText="Last Login" Width="150" Type="ColumnType.DateTime" Format="MMM d, yyyy" />
            <GridColumn Field="@nameof(PortalUser.MfaEnabled)" HeaderText="MFA" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                <Template>@{ var u = (PortalUser)context; }<i class="bi @(u.MfaEnabled ? "bi-shield-check pu-yes" : "bi-shield-x pu-no")" aria-hidden="true"></i></Template>
            </GridColumn>
            <GridColumn Field="@nameof(PortalUser.Logins30d)" HeaderText="Logins (30d)" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>@{ var u = (PortalUser)context; }<span class="pu-mono">@u.Logins30d</span></Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                <Template>
                    @{ var u = (PortalUser)context; }
                    <div class="pu-row-actions">
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => EditUser(u)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => ToggleSuspend(u)" title="@(u.Status=="Suspended"?"Reactivate":"Suspend")">
                            <i class="bi @(u.Status=="Suspended" ? "bi-person-check" : "bi-person-slash")" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => Resend(u)" title="Resend invite" disabled="@(u.Status != "Pending")">
                            <i class="bi bi-envelope-arrow-up" aria-hidden="true"></i>
                        </button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

<!-- Invite / Add dialog -->
<SfDialog @bind-Visible="_showInvite" Width="500px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span class="pu-dlg-hdr"><i class="bi bi-person-plus" aria-hidden="true"></i> Add Portal User</span></Header>
        <Content>
            <div class="pu-dlg-body">
                <div class="pu-dlg-row">
                    <SfTextBox Placeholder="Full name *" @bind-Value="_newUser.Name" />
                    <SfTextBox Placeholder="Email address *" @bind-Value="_newUser.Email" />
                </div>
                <div class="pu-dlg-row">
                    <SfTextBox Placeholder="Account name" @bind-Value="_newUser.AccountName" />
                    <SfDropDownList TValue="string" TItem="Lv" DataSource="_roleOpts" Placeholder="Portal role"
                                    Width="100%" @bind-Value="_newUser.Role">
                        <DropDownListFieldSettings Value="V" Text="L" />
                    </SfDropDownList>
                </div>
                <div class="pu-dlg-check">
                    <label><SfCheckBox @bind-Checked="_newUser.MfaEnabled" /> Require MFA</label>
                    <label><SfCheckBox @bind-Checked="_sendWelcome" /> Send welcome email</label>
                </div>
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="pu-form-error"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_formError</div>
                }
            </div>
        </Content>
        <FooterTemplate>
            <div class="pu-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="CloseInvite">Cancel</button>
                <button class="um-btn um-btn-primary"
                        disabled="@(string.IsNullOrEmpty(_newUser.Name) || string.IsNullOrEmpty(_newUser.Email))"
                        @onclick="CommitAddUser">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Add User
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    private SfToast? _toast;
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private string _roleFilter = string.Empty;
    private bool _showInvite;
    private bool _sendWelcome = true;
    private string? _formError;
    private PortalUser _newUser = new();

    private List<PortalUser> _users = [];

    private static readonly List<Lv> _roleOpts =
    [
        new("Policyholder","Policyholder"), new("Contact","Contact"), new("Admin","Admin"),
    ];

    private IEnumerable<PortalUser> Filtered => _users.Where(u =>
        (string.IsNullOrEmpty(_search) || u.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || u.Email.Contains(_search, StringComparison.OrdinalIgnoreCase) || u.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_statusFilter) || u.Status == _statusFilter) &&
        (string.IsNullOrEmpty(_roleFilter) || u.Role == _roleFilter));

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Portal","/portal/users"), new("Users",""));
        _users =
        [
            new PortalUser { Id=1, Name="Rachel Nguyen",    Email="rachel@nguyenfamily.com",  AccountName="Nguyen Family HH",     Role="Policyholder", Status="Active",    LastLogin=DateTime.Today.AddDays(-2),  MfaEnabled=true,  Logins30d=14 },
            new PortalUser { Id=2, Name="James Ortega",     Email="james@ortegaconst.com",     AccountName="Ortega Construction",  Role="Admin",        Status="Active",    LastLogin=DateTime.Today.AddDays(-1),  MfaEnabled=true,  Logins30d=22 },
            new PortalUser { Id=3, Name="Brittany Walsh",   Email="bwalsh@techvault.io",       AccountName="TechVault Inc",        Role="Contact",      Status="Active",    LastLogin=DateTime.Today.AddDays(-8),  MfaEnabled=false, Logins30d=5  },
            new PortalUser { Id=4, Name="Marcus Lee",       Email="mlee@sullivanmfg.com",      AccountName="Sullivan Manufacturing",Role="Policyholder", Status="Active",    LastLogin=DateTime.Today.AddDays(-3),  MfaEnabled=true,  Logins30d=9  },
            new PortalUser { Id=5, Name="Sandra Kim",       Email="sandra@kimrealty.net",      AccountName="Kim Realty LLC",       Role="Admin",        Status="Pending",   LastLogin=DateTime.MinValue,           MfaEnabled=false, Logins30d=0  },
            new PortalUser { Id=6, Name="Derek Patel",      Email="dpatel@apexlogistics.com",  AccountName="Apex Logistics",       Role="Policyholder", Status="Pending",   LastLogin=DateTime.MinValue,           MfaEnabled=false, Logins30d=0  },
            new PortalUser { Id=7, Name="Tanya Brooks",     Email="tbrooks@brookslegal.com",   AccountName="Brooks Legal Group",   Role="Contact",      Status="Suspended", LastLogin=DateTime.Today.AddDays(-92), MfaEnabled=false, Logins30d=0  },
            new PortalUser { Id=8, Name="Carlos Vega",      Email="cvega@vegafoods.com",       AccountName="Vega Foods Inc",       Role="Policyholder", Status="Active",    LastLogin=DateTime.Today.AddDays(-5),  MfaEnabled=true,  Logins30d=7  },
            new PortalUser { Id=9, Name="Nicole Thornton",  Email="nicole@thorntonhh.net",     AccountName="Thornton Household",   Role="Policyholder", Status="Active",    LastLogin=DateTime.Today.AddDays(-12), MfaEnabled=false, Logins30d=3  },
            new PortalUser { Id=10,Name="Frank Castillo",   Email="fcastillo@castilloauto.com",AccountName="Castillo Auto Group",  Role="Admin",        Status="Active",    LastLogin=DateTime.Today.AddDays(-1),  MfaEnabled=true,  Logins30d=19 },
        ];
    }

    private void EditUser(PortalUser u) { /* open edit dialog in full impl */ }

    private async Task ToggleSuspend(PortalUser u)
    {
        u.Status = u.Status == "Suspended" ? "Active" : "Suspended";
        await ShowToast(u.Status == "Active" ? $"{u.Name} reactivated." : $"{u.Name} suspended.");
    }

    private async Task Resend(PortalUser u)
    {
        await ShowToast($"Invite resent to {u.Email}.");
    }

    private async Task CommitAddUser()
    {
        if (string.IsNullOrWhiteSpace(_newUser.Email)) { _formError = "Email is required."; return; }
        _newUser.Id = _users.Count + 1;
        _newUser.Status = "Pending";
        _newUser.LastLogin = DateTime.MinValue;
        _users.Add(_newUser);
        CloseInvite();
        await ShowToast($"Portal user {_newUser.Name} added{(_sendWelcome ? " — invite sent." : ".")}");
        _newUser = new();
    }

    private void CloseInvite() { _showInvite = false; _newUser = new(); _formError = null; }

    private async Task ShowToast(string msg)
    {
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = msg, CssClass = "e-toast-success" });
    }

    private static string AvatarCss(string role) => role switch
    {
        "Admin"        => "pu-av-admin",
        "Policyholder" => "pu-av-ph",
        _              => "pu-av-contact",
    };

    private static string RoleBadge(string r) => r switch
    {
        "Admin"        => "pu-badge pu-badge--admin",
        "Policyholder" => "pu-badge pu-badge--ph",
        _              => "pu-badge",
    };

    private static string StatusBadge(string s) => s switch
    {
        "Active"    => "pu-status pu-status--active",
        "Pending"   => "pu-status pu-status--pending",
        "Suspended" => "pu-status pu-status--susp",
        _           => "pu-status",
    };

    private static string Initials(string name)
    {
        var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}" : name.Length > 0 ? name[..1] : "?";
    }

    private sealed class PortalUser
    {
        public int      Id          { get; set; }
        public string   Name        { get; set; } = string.Empty;
        public string   Email       { get; set; } = string.Empty;
        public string   AccountName { get; set; } = string.Empty;
        public string   Role        { get; set; } = "Policyholder";
        public string   Status      { get; set; } = "Pending";
        public DateTime LastLogin   { get; set; }
        public bool     MfaEnabled  { get; set; }
        public int      Logins30d   { get; set; }
    }

    private sealed record Lv(string V, string L);
}
