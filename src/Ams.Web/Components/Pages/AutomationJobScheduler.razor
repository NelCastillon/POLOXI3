    private async Task TriggerJobAsync(JobDefinitionDto job)
    {
        try
        {
            var id = await ApiClient.TriggerAutomationJobAsync(job.JobDefinitionId, new TriggerJobRunRequest(job.TenantId, null, "{}"));
            _message = $"Job queued: {id}";
            _isError = false;
            await LoadRunsAsync();
        }
        catch (Exception ex)
