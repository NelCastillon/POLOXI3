        {
            if (_selectedJob is null) return;
            await ApiClient.SaveAutomationJobStepAsync(_selectedJob.JobDefinitionId, _editingStepId, new UpsertJobStepRequest(_stepForm.TenantId, _selectedJob.JobDefinitionId, _stepForm.StepOrder, _stepForm.StepCode, _stepForm.StepName, _stepForm.StepExecutorType, _stepForm.Description, _stepForm.InputMappingJson, _stepForm.OutputMappingJson, _stepForm.RetryPolicyJson, _stepForm.DynamicFieldSchemaJson, _stepForm.InputParameterJson, _stepForm.OutputContractJson, _stepForm.DependsOnStepCodes, _stepForm.TimeoutSeconds, _stepForm.ContinueOnError, _stepForm.IsEnabled));
