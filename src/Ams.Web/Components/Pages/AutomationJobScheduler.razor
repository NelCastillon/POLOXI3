@page "/automation/job-scheduler"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Common.Models
@using Ams.Application.Features.AutomationJobs
@using Ams.Web.Services
@inject ApiClient ApiClient
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Enterprise Job Scheduler</PageTitle>

<div class="container-fluid py-4 automation-scheduler">
    <section class="ajs-header mb-4">
        <div class="ajs-header-left">
            <div class="ajs-lob-icon"><i class="bi bi-cpu" aria-hidden="true"></i></div>
            <div class="ajs-header-info">
                <div class="ajs-title-row">
                    <h1 class="ajs-page-title">Enterprise Cron Job Scheduler</h1>
                    <span class="ajs-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live automation data</span>
                    <span class="ajs-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span>
                </div>
                <div class="ajs-sub-row">
                    <span>Define reusable AMS jobs, arrange dynamic worker step executors, schedule cron runs, and inspect file ingestion telemetry.</span>
                    <span class="ajs-sub-chip"><i class="bi bi-diagram-3" aria-hidden="true"></i> @(_jobs.TotalCount) jobs</span>
                    <span class="ajs-sub-chip"><i class="bi bi-activity" aria-hidden="true"></i> @(_runs.TotalCount) runs tracked</span>
                </div>
            </div>
        </div>
        <div class="ajs-header-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_isLoading">
                <i class="bi @(_isLoading ? "bi-arrow-repeat ajs-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="um-btn um-btn-primary" @onclick="StartNewJob">
                <i class="bi bi-plus-circle" aria-hidden="true"></i> New job
            </button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") d-flex justify-content-between align-items-center" style="@( _isError ? "border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" : null)">
            <span>@_message</span>
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">
            @_loadError
        </div>
    }

    <div class="ajs-kpi-strip mb-4" aria-label="Scheduler metrics">
            <button type="button" class="ajs-kpi-card ajs-kpi--blue @(_statusFilter == "Active" ? "ajs-kpi-active" : null)" title="Show active jobs" disabled="@_isLoading" @onclick='() => ApplyKpiFilterAsync("Active")'>
            <span class="ajs-kpi-icon"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
            <span class="ajs-kpi-body">
                <span class="ajs-kpi-value">@(_dashboard?.ActiveJobs ?? 0)</span>
                <span class="ajs-kpi-label">Active jobs</span>
            </span>
        </button>
        <button type="button" class="ajs-kpi-card ajs-kpi--green" title="Refresh scheduler data" disabled="@_isLoading" @onclick="LoadAsync">
            <span class="ajs-kpi-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></span>
            <span class="ajs-kpi-body">
                <span class="ajs-kpi-value">@(_dashboard?.EnabledSchedules ?? 0)</span>
                <span class="ajs-kpi-label">Enabled schedules</span>
            </span>
        </button>
        <button type="button" class="ajs-kpi-card ajs-kpi--amber" title="Reload run telemetry" disabled="@_isLoading" @onclick="LoadRunsAsync">
            <span class="ajs-kpi-icon"><i class="bi bi-play-circle" aria-hidden="true"></i></span>
            <span class="ajs-kpi-body">
                <span class="ajs-kpi-value">@(_dashboard?.RunningJobs ?? 0)</span>
                <span class="ajs-kpi-label">Running / queued</span>
            </span>
        </button>
        <button type="button" class="ajs-kpi-card ajs-kpi--cyan" title="Success rate over last 24 hours" disabled="@_isLoading" @onclick="LoadRunsAsync">
            <span class="ajs-kpi-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
            <span class="ajs-kpi-body">
                <span class="ajs-kpi-value">@((_dashboard?.SuccessRate24h ?? 0).ToString("0.#"))%</span>
                <span class="ajs-kpi-label">24h success rate</span>
            </span>
        </button>
    </div>

    <div class="row g-4 ajs-main-grid">
        <div class="col-12 col-xxl-7">
            <section class="ajs-panel mb-4">
                <div class="ajs-panel-body">
                    <div class="ajs-panel-head">
                        <div>
                            <div class="ajs-eyebrow"><i class="bi bi-kanban" aria-hidden="true"></i> Job catalog</div>
                            <h2>Job definitions</h2>
                            <p>Reusable pipelines composed from worker StepExecutor types.</p>
                        </div>
                        <div class="ajs-tools">
                            <input class="ajs-input scheduler-filter" placeholder="Search jobs" @bind="_searchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                            <select class="ajs-input scheduler-select" @bind="_statusFilter" @bind:after="SearchJobsAsync">
                                <option value="">All statuses</option>
                                <option>Draft</option>
                                <option>Active</option>
                                <option>Paused</option>
                                <option>Retired</option>
                            </select>
                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="SearchJobsAsync"><i class="bi bi-funnel" aria-hidden="true"></i> Apply</button>
                        </div>
                    </div>

                    @if (_isLoading)
                    {
                        <div class="py-5 text-center text-muted">
                            <div class="spinner-border spinner-border-sm me-2"></div> Loading scheduler data...
                        </div>
                    }
                    else if (_jobs.Items.Count == 0)
                    {
                        <div class="empty-state">
                            <div class="bi bi-clock-history empty-icon"></div>
                            <h3 class="h6">No automation jobs found</h3>
                            <p>Create the first enterprise job definition to begin scheduling worker pipelines.</p>
                        </div>
                    }
                    else
                    {
                        <div class="ajs-table-wrap">
                            <table class="ajs-table">
                                <thead>
                                    <tr>
                                        <th>Job</th>
                                        <th>Category</th>
                                        <th>Status</th>
                                        <th>Steps</th>
                                        <th>Schedules</th>
                                        <th>Next run</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var job in _jobs.Items)
                                    {
                                        <tr class="@(job.JobDefinitionId == _selectedJob?.JobDefinitionId ? "row-selected" : null)">
                                            <td>
                                                 <button class="ajs-link" @onclick="() => SelectJobAsync(job)">@job.JobName</button>
                                                 <div class="ajs-muted"><code>@job.JobCode</code> - @job.JobTypeCode</div>
                                            </td>
                                            <td>@job.CategoryCode</td>
                                            <td><span class="status-pill @StatusCss(job.StatusCode)">@job.StatusCode</span></td>
                                            <td>@job.StepCount</td>
                                            <td>@job.ScheduleCount</td>
                                            <td>@FormatDate(job.NextRunDateUtc)</td>
                                            <td class="text-end">
                                                 <button type="button" class="um-btn um-btn-ghost um-btn-sm me-1" disabled="@_isLoading" @onclick="() => EditJob(job)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                                                <button type="button" class="um-btn um-btn-primary um-btn-sm" disabled="@_isLoading" @onclick="() => TriggerJobAsync(job)"><i class="bi bi-play-fill" aria-hidden="true"></i> Run now</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>

            <section class="ajs-panel">
                <div class="ajs-panel-body">
                    <div class="ajs-panel-head">
                        <div>
                            <div class="ajs-eyebrow"><i class="bi bi-clock-history" aria-hidden="true"></i> Telemetry stream</div>
                            <h2>Run history</h2>
                            <p>JobRun, JobStepRun, FileRunLog, FileExecutionLog and FileSave telemetry.</p>
                        </div>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" disabled="@_isLoading" @onclick="LoadRunsAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Reload runs</button>
                    </div>
                    @if (_runs.Items.Count == 0)
                    {
                        <div class="empty-state">
                            <div class="bi bi-activity empty-icon"></div>
                            <h3 class="h6">No runs recorded yet</h3>
                            <p>Trigger a job manually or wait for the next cron occurrence to see run telemetry here.</p>
                        </div>
                    }
                    else
                    {
                    <div class="ajs-table-wrap">
                        <table class="ajs-table">
                            <thead>
                                <tr>
                                    <th>Run</th>
                                    <th>Job</th>
                                    <th>Status</th>
                                    <th>Trigger</th>
                                    <th>Duration</th>
                                    <th>Started</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var run in _runs.Items)
                                {
                                    <tr class="@(run.JobRunId == _selectedRun?.JobRunId ? "row-selected" : null)">
                                        <td><span class="ajs-run-id" title="@run.CorrelationId">@ShortRunId(run.CorrelationId)</span></td>
                                        <td>@run.JobName</td>
                                        <td><span class="status-pill @StatusCss(run.StatusCode)">@run.StatusCode</span></td>
                                        <td>@run.TriggerType</td>
                                        <td>@FormatDuration(run.DurationMs)</td>
                                        <td>@FormatDate(run.StartedDateUtc ?? run.CreatedDateUtc)</td>
                                        <td class="text-end"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => SelectRunAsync(run)"><i class="bi bi-search" aria-hidden="true"></i> Inspect</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    }
                </div>
            </section>
        </div>

        <div class="col-12 col-xxl-5">
            <section class="ajs-panel ajs-side-panel mb-4">
                <div class="ajs-panel-body">
                    <div class="ajs-panel-head ajs-panel-head--compact">
                        <div>
                            <div class="ajs-eyebrow"><i class="bi bi-sliders" aria-hidden="true"></i> Definition editor</div>
                            <h2>@(_editingJobId is null ? "Create job" : "Edit job")</h2>
                            <p>Persisted to the Automation.JobDefinition table.</p>
                        </div>
                    </div>
                    <EditForm Model="_jobForm" OnValidSubmit="SaveJobAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Job name</label>
                                <InputText class="ajs-input w-100" @bind-Value="_jobForm.JobName" />
                                <ValidationMessage For="() => _jobForm.JobName" class="text-danger" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Job code</label>
                                <InputText class="ajs-input w-100" @bind-Value="_jobForm.JobCode" disabled="@(_editingJobId is not null)" />
                                <ValidationMessage For="() => _jobForm.JobCode" class="text-danger" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Status</label>
                                <InputSelect class="ajs-input w-100" @bind-Value="_jobForm.StatusCode">
                                    <option>Draft</option>
                                    <option>Active</option>
                                    <option>Paused</option>
                                    <option>Retired</option>
                                </InputSelect>
                                <ValidationMessage For="() => _jobForm.StatusCode" class="text-danger" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Type</label>
                                <InputText class="ajs-input w-100" @bind-Value="_jobForm.JobTypeCode" />
                                <ValidationMessage For="() => _jobForm.JobTypeCode" class="text-danger" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Category</label>
                                <InputText class="ajs-input w-100" @bind-Value="_jobForm.CategoryCode" />
                                <ValidationMessage For="() => _jobForm.CategoryCode" class="text-danger" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">Concurrency</label>
                                <InputSelect class="ajs-input w-100" @bind-Value="_jobForm.ConcurrencyPolicy">
                                    <option>SkipIfRunning</option>
                                    <option>Queue</option>
                                    <option>AllowParallel</option>
                                </InputSelect>
                                <ValidationMessage For="() => _jobForm.ConcurrencyPolicy" class="text-danger" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label">Retries</label>
                                <InputNumber class="ajs-input w-100" @bind-Value="_jobForm.MaxRetryCount" />
                                <ValidationMessage For="() => _jobForm.MaxRetryCount" class="text-danger" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label">Timeout</label>
                                <InputNumber class="ajs-input w-100" @bind-Value="_jobForm.TimeoutSeconds" />
                                <ValidationMessage For="() => _jobForm.TimeoutSeconds" class="text-danger" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <InputTextArea class="ajs-input w-100" rows="3" @bind-Value="_jobForm.Description" />
                                <ValidationMessage For="() => _jobForm.Description" class="text-danger" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Configuration JSON</label>
                                <InputTextArea class="ajs-input code-area w-100" rows="4" @bind-Value="_jobForm.ConfigurationJson" />
                                <ValidationMessage For="() => _jobForm.ConfigurationJson" class="text-danger" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Dynamic field schema JSON</label>
                                <InputTextArea class="ajs-input code-area w-100" rows="3" @bind-Value="_jobForm.DynamicFieldSchemaJson" />
                                <ValidationMessage For="() => _jobForm.DynamicFieldSchemaJson" class="text-danger" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Default parameters JSON</label>
                                <InputTextArea class="ajs-input code-area w-100" rows="3" @bind-Value="_jobForm.DefaultParameterJson" />
                                <ValidationMessage For="() => _jobForm.DefaultParameterJson" class="text-danger" />
                            </div>
                            <div class="col-12 d-flex justify-content-between align-items-center">
                                <div class="form-check form-switch">
                                    <InputCheckbox class="form-check-input" @bind-Value="_jobForm.IsActive" />
                                    <label class="form-check-label">Active</label>
                                </div>
                                <button class="um-btn um-btn-primary" type="submit"><i class="bi bi-check2-circle" aria-hidden="true"></i> Save job</button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </section>

            @if (_selectedJob is not null)
            {
                <section class="ajs-panel ajs-side-panel mb-4">
                    <div class="ajs-panel-body">
                        <div class="ajs-panel-head ajs-panel-head--compact">
                            <div>
                                <div class="ajs-eyebrow"><i class="bi bi-diagram-2" aria-hidden="true"></i> Worker pipeline</div>
                                <h2>Pipeline steps</h2>
                                <p>@_steps.Count configured executor(s).</p>
                            </div>
                            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="StartNewStep"><i class="bi bi-plus-circle" aria-hidden="true"></i> Add step</button>
                        </div>
                        <div class="timeline-list mb-3">
                            @foreach (var step in _steps)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-badge">@step.StepOrder</div>
                                    <div>
                                        <div class="ajs-item-title">@step.StepName</div>
                                        <div class="ajs-muted"><code>@step.StepExecutorType</code></div>
                                        <button type="button" class="ajs-inline-action" @onclick="() => EditStep(step)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit step</button>
                                    </div>
                                </div>
                            }
                        </div>
                        <EditForm Model="_stepForm" OnValidSubmit="SaveStepAsync">
                            <DataAnnotationsValidator />
                            <div class="row g-2">
                                <div class="col-4 col-md-3"><InputNumber class="ajs-input w-100" @bind-Value="_stepForm.StepOrder" /></div>
                                <div class="col-8 col-md-9"><InputText class="ajs-input w-100" placeholder="Step code" @bind-Value="_stepForm.StepCode" /><ValidationMessage For="() => _stepForm.StepCode" class="text-danger" /></div>
                                <div class="col-12 col-md-6"><InputText class="ajs-input w-100" placeholder="Step name" @bind-Value="_stepForm.StepName" /><ValidationMessage For="() => _stepForm.StepName" class="text-danger" /></div>
                                <div class="col-12 col-md-6"><InputText class="ajs-input w-100" placeholder="Depends on step codes" @bind-Value="_stepForm.DependsOnStepCodes" /><ValidationMessage For="() => _stepForm.DependsOnStepCodes" class="text-danger" /></div>
                                <div class="col-12"><InputText class="ajs-input w-100" placeholder="FileIngestionStepExecutor" @bind-Value="_stepForm.StepExecutorType" /><ValidationMessage For="() => _stepForm.StepExecutorType" class="text-danger" /></div>
                                <div class="col-12"><InputTextArea class="ajs-input code-area w-100" rows="3" placeholder="Input mapping JSON" @bind-Value="_stepForm.InputMappingJson" /><ValidationMessage For="() => _stepForm.InputMappingJson" class="text-danger" /></div>
                                <div class="col-12"><InputTextArea class="ajs-input code-area w-100" rows="3" placeholder="Dynamic field schema JSON" @bind-Value="_stepForm.DynamicFieldSchemaJson" /><ValidationMessage For="() => _stepForm.DynamicFieldSchemaJson" class="text-danger" /></div>
                                <div class="col-12"><InputTextArea class="ajs-input code-area w-100" rows="3" placeholder="Input parameters JSON" @bind-Value="_stepForm.InputParameterJson" /><ValidationMessage For="() => _stepForm.InputParameterJson" class="text-danger" /></div>
                                <div class="col-12"><InputTextArea class="ajs-input code-area w-100" rows="3" placeholder="Output contract JSON" @bind-Value="_stepForm.OutputContractJson" /><ValidationMessage For="() => _stepForm.OutputContractJson" class="text-danger" /></div>
                                <div class="col-12"><ValidationMessage For="() => _stepForm.StepOrder" class="text-danger" /></div>
                                <div class="col-12 d-flex justify-content-between align-items-center">
                                    <div class="form-check form-switch"><InputCheckbox class="form-check-input" @bind-Value="_stepForm.IsEnabled" /> <label class="form-check-label">Enabled</label></div>
                                    <button class="um-btn um-btn-primary um-btn-sm" type="submit"><i class="bi bi-check2" aria-hidden="true"></i> Save step</button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </section>

                <section class="ajs-panel ajs-side-panel mb-4">
                    <div class="ajs-panel-body">
                        <div class="ajs-panel-head ajs-panel-head--compact">
                            <div>
                                <div class="ajs-eyebrow"><i class="bi bi-calendar2-week" aria-hidden="true"></i> Cron control</div>
                                <h2>Cron schedules</h2>
                                <p>@_schedules.Count persisted schedule(s).</p>
                            </div>
                        </div>
                        @foreach (var schedule in _schedules)
                        {
                            <div class="schedule-row">
                                <div>
                                    <div class="ajs-item-title">@schedule.ScheduleName</div>
                                    <div class="ajs-muted"><code>@schedule.CronExpression</code> - @schedule.TimeZoneId</div>
                                </div>
                                <span class="status-pill @(schedule.IsEnabled ? "status-success" : "status-muted")">@(schedule.IsEnabled ? "Enabled" : "Disabled")</span>
                                <button type="button" class="ajs-inline-action" @onclick="() => EditSchedule(schedule)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                            </div>
                        }
                        <EditForm Model="_scheduleForm" OnValidSubmit="SaveScheduleAsync">
                            <DataAnnotationsValidator />
                            <div class="row g-2 mt-2">
                                <div class="col-12"><InputText class="ajs-input w-100" placeholder="Schedule name" @bind-Value="_scheduleForm.ScheduleName" /><ValidationMessage For="() => _scheduleForm.ScheduleName" class="text-danger" /></div>
                                <div class="col-12 col-md-6"><InputText class="ajs-input w-100" placeholder="*/15 * * * *" @bind-Value="_scheduleForm.CronExpression" /><ValidationMessage For="() => _scheduleForm.CronExpression" class="text-danger" /></div>
                                <div class="col-12 col-md-6"><InputText class="ajs-input w-100" placeholder="America/New_York" @bind-Value="_scheduleForm.TimeZoneId" /><ValidationMessage For="() => _scheduleForm.TimeZoneId" class="text-danger" /></div>
                                <div class="col-12 d-flex justify-content-between align-items-center">
                                    <div class="form-check form-switch"><InputCheckbox class="form-check-input" @bind-Value="_scheduleForm.IsEnabled" /> <label class="form-check-label">Enabled</label></div>
                                    <button class="um-btn um-btn-primary um-btn-sm" type="submit"><i class="bi bi-check2" aria-hidden="true"></i> Save schedule</button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </section>
            }

            @if (_selectedRun is not null)
            {
                <section class="ajs-panel ajs-side-panel">
                    <div class="ajs-panel-body">
                        <div class="ajs-panel-head ajs-panel-head--compact">
                            <div>
                                <div class="ajs-eyebrow"><i class="bi bi-search" aria-hidden="true"></i> Run inspector</div>
                                <h2>Run inspector</h2>
                                <p>Correlation <span class="ajs-run-id" title="@_selectedRun.CorrelationId">@ShortRunId(_selectedRun.CorrelationId)</span></p>
                            </div>
                        </div>
                        <h3 class="ajs-section-label">Step execution</h3>
                        @foreach (var stepRun in _stepRuns)
                        {
                            <div class="schedule-row">
                                <div>
                                    <div class="ajs-item-title">#@stepRun.StepOrder @stepRun.StepExecutorType</div>
                                    <div class="ajs-muted">@FormatDuration(stepRun.DurationMs) - retry @stepRun.RetryAttempt</div>
                                </div>
                                <span class="status-pill @StatusCss(stepRun.StatusCode)">@stepRun.StatusCode</span>
                            </div>
                        }
                        <h3 class="ajs-section-label mt-3">Files</h3>
                        @foreach (var file in _fileSaves)
                        {
                            <div class="log-line">
                                <span class="bi bi-file-earmark-arrow-up me-2"></span>
                                <span>@file.OriginalFileName</span>
                                <span class="text-muted ms-auto">@file.StatusCode</span>
                            </div>
                        }
                        <h3 class="ajs-section-label mt-3">Execution logs</h3>
                        @foreach (var runLog in _fileRunLogs)
                        {
                            <div class="log-line">
                                <span class="status-pill @StatusCss(runLog.StatusCode)">@runLog.Stage</span>
                                <span>@runLog.RecordsProcessed processed</span>
                                <span class="text-muted ms-auto">@runLog.RecordsFailed failed</span>
                            </div>
                        }
                        <div class="log-panel">
                            @foreach (var log in _fileLogs)
                            {
                                <div class="log-line">
                                    <span class="log-level @LogCss(log.LogLevel)">@log.LogLevel</span>
                                    <span>@log.Message</span>
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }
        </div>
    </div>
</div>

<style>
    /* ── Hero header ─────────────────────────────────── */
    .ajs-header { position: relative; overflow: hidden; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.35rem 1.5rem; border-radius: 20px; background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 52%, #2563eb 100%); color: #e2e8f0; box-shadow: 0 1rem 2.5rem rgba(15, 23, 42, .25); animation: ams-header-float-in .5s ease both; }
