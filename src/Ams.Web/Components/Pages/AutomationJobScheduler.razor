    private static string FormatDate(DateTime? value) => value is null ? "-" : value.Value.ToString("MMM d, yyyy h:mm tt");
    private static string FormatDuration(int durationMs) => durationMs <= 0 ? "-" : TimeSpan.FromMilliseconds(durationMs).TotalSeconds.ToString("0.#") + "s";
    private static string StatusCss(string? status) => status switch
    {
        "Active" or "Completed" or "Enabled" or "Applied" => "status-success",
        "Queued" or "Running" or "In Review" or "CompletedWithWarnings" => "status-warning",
        "Failed" or "Error" or "Disabled" => "status-danger",
        "Draft" or "Paused" => "status-muted",
        _ => "status-info"
    };
    private static string LogCss(string? level) => level switch
    {
        "Error" => "log-error",
        "Warning" => "log-warn",
        _ => "log-info"
    };

    private sealed class JobFormModel
    {
        public Guid TenantId { get; set; }
        [Required, StringLength(100)]
        public string JobCode { get; set; } = string.Empty;
        [Required, StringLength(240)]
        public string JobName { get; set; } = string.Empty;
        [StringLength(1000)]
        public string? Description { get; set; }
        [Required, StringLength(80)]
        public string JobTypeCode { get; set; } = "Pipeline";
        [Required, StringLength(80)]
        public string CategoryCode { get; set; } = "Integration";
        [Required, StringLength(50)]
        public string StatusCode { get; set; } = "Draft";
        [StringLength(160)]
        public string? OwnerTeam { get; set; } = "Integration Operations";
        [Required, StringLength(50)]
        public string ConcurrencyPolicy { get; set; } = "SkipIfRunning";
        [Range(0, 25)]
        public int MaxRetryCount { get; set; } = 3;
        [Range(30, 86400)]
        public int TimeoutSeconds { get; set; } = 3600;
        [StringLength(500)]
        public string? Tags { get; set; }
        [Required]
        public string ConfigurationJson { get; set; } = "{}";
        [Required]
        public string DynamicFieldSchemaJson { get; set; } = "[]";
        [Required]
        public string DefaultParameterJson { get; set; } = "{}";
        public bool IsActive { get; set; } = true;
        public static JobFormModel New(Guid tenantId) => new() { TenantId = tenantId, JobCode = $"JOB_{DateTime.UtcNow:yyyyMMddHHmmss}", JobName = "New automation job" };
    }

