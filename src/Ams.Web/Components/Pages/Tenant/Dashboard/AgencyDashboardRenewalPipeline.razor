@page "/tenant/dashboard/renewal-pipeline"
@namespace Ams.Web.Components.Pages.Tenant.Dashboard
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Renewal Pipeline — Agency Dashboard</PageTitle>

<AppPageHeader Title="Renewal Pipeline"
               Subtitle="Upcoming renewals by due date — track at-risk policies and outstanding premium"
               Icon="bi-arrow-clockwise">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "ad-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
        <a class="um-btn um-btn-ghost" href="/renewals/pipeline">
            <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Full Pipeline
        </a>
    </Actions>
</AppPageHeader>

@if (_loading)
{
    <div class="ad-loading-banner" aria-live="polite">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading renewal pipeline…</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger ad-alert-danger" role="alert"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i> @_loadError</div>
}
else if (_data is null)
{
    <div class="ad-empty"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i><span>No renewal data available.</span></div>
}
else
{
    <!-- ── KPI strip ─────────────────────────────────────────── -->
    <div class="ad-kpi-strip">
        <button type="button" class="ad-kpi-card ad-kpi--claims @KpiClass("overdue")" @onclick='() => SetFilter("overdue")' title="Show overdue renewals">
            <div class="ad-kpi-icon"><i class="bi bi-exclamation-circle" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_data.Overdue</div>
                <div class="ad-kpi-lbl">Overdue</div>
                <div class="ad-kpi-sub">@_data.PremiumOverdue.ToString("C0") at risk</div>
            </div>
        </button>
        <button type="button" class="ad-kpi-card ad-kpi--retention @KpiClass("30")" @onclick='() => SetFilter("30")' title="Show renewals due in 30 days">
            <div class="ad-kpi-icon"><i class="bi bi-calendar-event" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_data.DueIn30Days</div>
                <div class="ad-kpi-lbl">Due in 30 Days</div>
                <div class="ad-kpi-sub">@_data.PremiumDueIn30Days.ToString("C0") premium</div>
            </div>
        </button>
        <button type="button" class="ad-kpi-card ad-kpi--premium @KpiClass("60")" @onclick='() => SetFilter("60")' title="Show renewals due in 31-60 days">
            <div class="ad-kpi-icon"><i class="bi bi-calendar2-range" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_data.DueIn60Days</div>
                <div class="ad-kpi-lbl">Due in 31–60 Days</div>
                <div class="ad-kpi-sub">@_data.PremiumDueIn60Days.ToString("C0") premium</div>
            </div>
        </button>
        <button type="button" class="ad-kpi-card ad-kpi--policies @KpiClass("90")" @onclick='() => SetFilter("90")' title="Show renewals due in 61-90 days">
            <div class="ad-kpi-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_data.DueIn90Days</div>
                <div class="ad-kpi-lbl">Due in 61–90 Days</div>
                <div class="ad-kpi-sub">@_data.PremiumDueIn90Days.ToString("C0") premium</div>
            </div>
        </button>
    </div>
    @if (_activeFilter != "all")
    {
        <div class="ad-filter-bar"><span class="ad-filter-chip"><i class="bi bi-funnel" aria-hidden="true"></i> @FilterLabel(_activeFilter)</span><button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => SetFilter("all")'><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button></div>
    }

    <!-- ── Row detail ─────────────────────────────────────────── -->
    <div class="ad-card">
            <div class="ad-card-hd"><i class="bi bi-list-ul" aria-hidden="true"></i> Renewal Detail (@FilteredRows.Count)</div>
        @if (FilteredRows.Count == 0)
        {
            <div class="ad-empty" style="padding:1.5rem"><span>No upcoming renewals found.</span></div>
        }
        else
        {
            <div class="ad-table-wrap">
                <table class="ad-table">
                    <thead>
                        <tr>
                            <th>Policy Number</th>
                            <th>Account</th>
                            <th>Producer</th>
                            <th>Branch</th>
                            <th>Renewal Date</th>
                            <th class="ad-num">Current Premium</th>
                            <th>Status</th>
                            <th class="ad-num">Days</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in FilteredRows.OrderBy(r => r.DaysUntilRenewal))
                        {
                            <tr>
                                <td style="font-weight:600;font-family:monospace;font-size:.82rem">@r.PolicyNumber</td>
                                <td>@r.AccountName</td>
                                <td style="font-size:.8rem;color:#6b7280">@(r.ProducerName ?? "—")</td>
                                <td style="font-size:.8rem;color:#6b7280">@(r.BranchName ?? "—")</td>
                                <td style="font-size:.82rem">@r.RenewalDate.ToString("MMM d, yyyy")</td>
                                <td class="ad-num" style="font-weight:600">@r.CurrentPremium.ToString("C0")</td>
                                <td>
                                    <span class="ad-badge @StatusBadgeClass(r.StatusCode)">@r.StatusCode</span>
                                </td>
                                <td class="ad-num">
                                    <span class="ad-days-chip @DaysChipClass(r.DaysUntilRenewal)">@r.DaysUntilRenewal</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private RenewalPipelineDto? _data;
    private bool _loading;
    private string? _loadError;
    private string _activeFilter = "all";
    private List<RenewalPipelineRowDto> FilteredRows => (_data?.Rows ?? []).Where(r => _activeFilter switch
    {
        "overdue" => r.DaysUntilRenewal < 0,
        "30" => r.DaysUntilRenewal >= 0 && r.DaysUntilRenewal <= 30,
        "60" => r.DaysUntilRenewal >= 31 && r.DaysUntilRenewal <= 60,
        "90" => r.DaysUntilRenewal >= 61 && r.DaysUntilRenewal <= 90,
        _ => true,
    }).ToList();

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Agency Dashboard", "/tenant/dashboard"), new("Renewal Pipeline"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try { _data = await Api.GetRenewalPipelineAsync(_tenantId); }
        catch (Exception ex) { _loadError = $"Failed to load renewal pipeline: {ex.Message}"; _data = null; }
        finally { _loading = false; }
    }

    private void SetFilter(string filter) => _activeFilter = _activeFilter == filter && filter != "all" ? "all" : filter;
    private string KpiClass(string filter) => _activeFilter == filter ? "ad-kpi-card--active" : string.Empty;
    private static string FilterLabel(string filter) => filter switch { "overdue" => "Overdue renewals", "30" => "Due in 30 days", "60" => "Due in 31-60 days", "90" => "Due in 61-90 days", _ => "All renewals" };

    private static string StatusBadgeClass(string status) => status.ToLower() switch
    {
        "renewed"   => "ad-badge--closed",
        "pending"   => "ad-badge--pending",
        "overdue"   => "ad-badge--overdue",
        "at-risk"   => "ad-badge--warn",
        _           => "ad-badge--info"
    };

    private static string DaysChipClass(int days) =>
        days < 0 ? "ad-days--red" : days <= 30 ? "ad-days--warn" : "ad-days--ok";

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
