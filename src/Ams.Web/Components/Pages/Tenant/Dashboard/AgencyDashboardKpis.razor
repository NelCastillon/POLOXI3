@page "/tenant/dashboard/kpis"
@namespace Ams.Web.Components.Pages.Tenant.Dashboard
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Agency KPIs — Agency Dashboard</PageTitle>

<AppPageHeader Title="Agency KPIs"
               Subtitle="Key performance indicators — premium, retention, conversion and producer activity"
               Icon="bi-bar-chart-line">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "ad-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
    </Actions>
</AppPageHeader>

@if (_loading)
{
    <div class="ad-loading-banner" aria-live="polite">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading KPIs…</span>
    </div>
}
else if (_data is null)
{
    <div class="ad-empty"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>Could not load KPI data.</span></div>
}
else
{
    <!-- ── Top KPI strip ─────────────────────────────────────── -->
    <div class="ad-kpi-strip">
        <div class="ad-kpi-card ad-kpi--premium">
            <div class="ad-kpi-icon"><i class="bi bi-cash-coin" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_data.WrittenPremiumYtd.ToString("C0")</div>
                <div class="ad-kpi-lbl">Written Premium YTD</div>
                <div class="ad-kpi-sub">Prior YTD: @_data.WrittenPremiumPriorYtd.ToString("C0")</div>
            </div>
        </div>
        <div class="ad-kpi-card ad-kpi--retention">
            <div class="ad-kpi-icon"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_data.RetentionRate.ToString("F1")%</div>
                <div class="ad-kpi-lbl">Retention Rate</div>
            </div>
        </div>
        <div class="ad-kpi-card ad-kpi--leads">
            <div class="ad-kpi-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_data.LeadConversionRate.ToString("F1")%</div>
                <div class="ad-kpi-lbl">Lead Conversion</div>
                <div class="ad-kpi-sub">@_data.LeadsThisMonth leads this month</div>
            </div>
        </div>
        <div class="ad-kpi-card ad-kpi--policies">
            <div class="ad-kpi-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_data.TotalActivePolicies.ToString("N0")</div>
                <div class="ad-kpi-lbl">Active Policies</div>
                <div class="ad-kpi-sub">+@_data.NewPoliciesMtd new, -@_data.CancelledPoliciesMtd cancelled MTD</div>
            </div>
        </div>
    </div>

    <!-- ── Detailed KPI rows ────────────────────────────────── -->
    <div class="ad-two-col">
        <div class="ad-card">
            <div class="ad-card-hd"><i class="bi bi-cash-coin" aria-hidden="true"></i> Premium Metrics</div>
            <div class="ad-kpi-rows">
                <div class="ad-kpi-row">
                    <div>
                        <div class="ad-kpi-row-lbl">Written Premium MTD</div>
                    </div>
                    <div class="ad-kpi-row-val">@_data.WrittenPremiumMtd.ToString("C0")</div>
                </div>
                <div class="ad-kpi-row">
                    <div>
                        <div class="ad-kpi-row-lbl">Written Premium YTD</div>
                        <div class="ad-kpi-row-sub">Prior YTD: @_data.WrittenPremiumPriorYtd.ToString("C0")</div>
                    </div>
                    <div class="ad-kpi-row-val">@_data.WrittenPremiumYtd.ToString("C0")</div>
                </div>
                <div class="ad-kpi-row">
                    <div>
                        <div class="ad-kpi-row-lbl">Avg Premium per Policy</div>
                    </div>
                    <div class="ad-kpi-row-val">@_data.AvgPremiumPerPolicy.ToString("C0")</div>
                </div>
                <div class="ad-kpi-row">
                    <div>
                        <div class="ad-kpi-row-lbl">New Business Rate</div>
                    </div>
                    <div class="ad-kpi-row-val">@_data.NewBusinessRate.ToString("F1")%</div>
                </div>
            </div>
        </div>

        <div class="ad-card">
            <div class="ad-card-hd"><i class="bi bi-funnel" aria-hidden="true"></i> Pipeline Metrics</div>
            <div class="ad-kpi-rows">
                <div class="ad-kpi-row">
                    <div>
                        <div class="ad-kpi-row-lbl">Leads This Month</div>
                    </div>
                    <div class="ad-kpi-row-val">@_data.LeadsThisMonth</div>
                </div>
                <div class="ad-kpi-row">
                    <div>
                        <div class="ad-kpi-row-lbl">Lead Conversion Rate</div>
                    </div>
                    <div class="ad-kpi-row-val">@_data.LeadConversionRate.ToString("F1")%</div>
                </div>
                <div class="ad-kpi-row">
                    <div>
                        <div class="ad-kpi-row-lbl">Quotes MTD</div>
                    </div>
                    <div class="ad-kpi-row-val">@_data.QuotesMtd</div>
                </div>
                <div class="ad-kpi-row">
                    <div>
                        <div class="ad-kpi-row-lbl">Quote Conversion Rate</div>
                    </div>
                    <div class="ad-kpi-row-val">@_data.QuoteConversionRate.ToString("F1")%</div>
                </div>
            </div>
        </div>

        <div class="ad-card">
            <div class="ad-card-hd"><i class="bi bi-shield-check" aria-hidden="true"></i> Policy Metrics</div>
            <div class="ad-kpi-rows">
                <div class="ad-kpi-row">
                    <div><div class="ad-kpi-row-lbl">Total Active Policies</div></div>
                    <div class="ad-kpi-row-val">@_data.TotalActivePolicies.ToString("N0")</div>
                </div>
                <div class="ad-kpi-row">
                    <div><div class="ad-kpi-row-lbl">New Policies MTD</div></div>
                    <div class="ad-kpi-row-val">@_data.NewPoliciesMtd</div>
                </div>
                <div class="ad-kpi-row">
                    <div><div class="ad-kpi-row-lbl">Cancelled Policies MTD</div></div>
                    <div class="ad-kpi-row-val">@_data.CancelledPoliciesMtd</div>
                </div>
                <div class="ad-kpi-row">
                    <div><div class="ad-kpi-row-lbl">Retention Rate</div></div>
                    <div class="ad-kpi-row-val">@_data.RetentionRate.ToString("F1")%</div>
                </div>
            </div>
        </div>

        <div class="ad-card">
            <div class="ad-card-hd"><i class="bi bi-person-badge" aria-hidden="true"></i> Producer Metrics</div>
            <div class="ad-kpi-rows">
                <div class="ad-kpi-row">
                    <div><div class="ad-kpi-row-lbl">Active Producers</div></div>
                    <div class="ad-kpi-row-val">@_data.ActiveProducers</div>
                </div>
                <div class="ad-kpi-row">
                    <div><div class="ad-kpi-row-lbl">Avg Premium per Producer</div></div>
                    <div class="ad-kpi-row-val">@(_data.ActiveProducers > 0 ? (_data.WrittenPremiumYtd / _data.ActiveProducers).ToString("C0") : "—")</div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private AgencyKpiDto? _data;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Agency Dashboard", "/tenant/dashboard"), new("Agency KPIs"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _data = await Api.GetAgencyKpisAsync(_tenantId); }
        finally { _loading = false; }
    }
}
