@page "/tenant/dashboard/kpis"
@page "/tenant/dashboard/kpis-performance"
@namespace Ams.Web.Components.Pages.Tenant.Dashboard
@using System.Globalization
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Enterprise KPI Performance - AMS</PageTitle>

@if (_toastVisible)
{
    <div class="kp-toast kp-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="kp-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="kp-enterprise-page">
    <section class="kp-hero">
        <div class="kp-hero-left">
            <span class="kp-hero-icon"><i class="bi bi-bar-chart-line-fill" aria-hidden="true"></i></span>
            <div>
                <div class="kp-title-row">
                    <h1>KPI Performance Command Center</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live KPI data</span>
                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> Tenant scoped</span>
                    <span><i class="bi bi-speedometer2" aria-hidden="true"></i> Executive view</span>
                </div>
                <p>Monitor revenue production, retention, policy growth, lead and quote conversion, producer productivity, and performance exceptions from one enterprise dashboard.</p>
            </div>
        </div>
        <div class="kp-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh KPI performance"><i class="bi @(_loading ? "bi-arrow-repeat kp-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/tenant/dashboard")'><i class="bi bi-speedometer2" aria-hidden="true"></i> Dashboard</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/tenant/dashboard/branch-performance")'><i class="bi bi-diagram-3" aria-hidden="true"></i> Branches</button>
            <button type="button" class="um-btn um-btn-primary" @onclick='() => GoTo("/tenant/dashboard/producer-performance")'><i class="bi bi-person-badge" aria-hidden="true"></i> Producers</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger kp-error-banner" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError</div>
    }

    @if (_loading)
    {
        <section class="kp-loading-state"><i class="bi bi-arrow-repeat kp-spin" aria-hidden="true"></i><strong>Loading enterprise KPI performance...</strong><span>Syncing premium, policy, retention, pipeline, quote, and producer metrics.</span></section>
    }
    else if (_data is null)
    {
        <section class="kp-empty-state"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><strong>KPI data unavailable</strong><span>Refresh KPI performance or verify tenant dashboard data access.</span><button type="button" class="um-btn um-btn-primary" @onclick="LoadAsync">Retry sync</button></section>
    }
    else
    {
        <section class="kp-command-strip" aria-label="KPI performance filters">
            @foreach (var metric in Metrics)
            {
                <button type="button" class="@MetricCardClass(metric)" title="@metric.Caption" @onclick="@(() => SetFocus(metric.Focus))">
                    <span class="kp-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                    <span><span class="kp-kpi-val">@metric.Value</span><span class="kp-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
                </button>
            }
        </section>

        <section class="kp-workflow-strip" aria-label="KPI workflow actions">
            <button type="button" class="kp-workflow-card" @onclick='() => SetFocus("revenue")'><i class="bi bi-cash-coin" aria-hidden="true"></i><span><strong>Grow revenue</strong><span>Review premium, growth, and average policy value.</span></span></button>
            <button type="button" class="kp-workflow-card" @onclick='() => SetFocus("retention")'><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span><strong>Protect book</strong><span>Monitor retention, cancellations, and policy health.</span></span></button>
            <button type="button" class="kp-workflow-card" @onclick='() => SetFocus("pipeline")'><i class="bi bi-funnel" aria-hidden="true"></i><span><strong>Accelerate pipeline</strong><span>Improve lead and quote conversion.</span></span></button>
            <button type="button" class="kp-workflow-card kp-workflow-danger" @onclick='() => SetFocus("exceptions")'><i class="bi bi-shield-exclamation" aria-hidden="true"></i><span><strong>Review exceptions</strong><span>Find risks in retention, cancellations, and production.</span></span></button>
        </section>

        <section class="kp-view-tabs" aria-label="KPI performance views">
            @foreach (var view in _views)
            {
                <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label <span>@ViewCount(view.Id)</span></button>
            }
        </section>

        <section class="kp-content-layout">
            <main class="kp-main-card">
                @if (_view == "executive")
                {
                    <div class="kp-section-head"><div><h2>Executive KPI health</h2><p>Priority KPI signals ranked by growth, retention, conversion, productivity, and operating risk.</p></div><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => GoTo("/tenant/dashboard")'><i class="bi bi-speedometer2" aria-hidden="true"></i> Dashboard</button></div>
                    <div class="kp-executive-grid">
                        <section class="kp-score-card"><span><i class="bi bi-activity" aria-hidden="true"></i> Performance score</span><strong>@PerformanceScoreLabel</strong><p>@GuidanceText</p><div class="kp-progress-track"><div class="@PerformanceFillClass" style="width:@PerformanceScoreWidth"></div></div></section>
                        <section class="kp-guidance-card"><h3><i class="bi bi-stars" aria-hidden="true"></i> Leadership guidance</h3><p>@LeadershipGuidance</p><div class="kp-guidance-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFocus("revenue")'>Revenue</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFocus("retention")'>Retention</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFocus("pipeline")'>Pipeline</button></div></section>
                    </div>
                    @KpiRankPanel
                }
                else if (_view == "revenue")
                {
                    <div class="kp-section-head"><div><h2>Revenue performance</h2><p>Premium production, growth posture, new business rate, and average policy value.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => GoTo("/tenant/dashboard/branch-performance")'>Branch Detail</button></div>
                    <div class="kp-insight-grid">
                        @Insight("Written Premium YTD", _data.WrittenPremiumYtd.ToString("C0", CultureInfo.CurrentCulture), PriorPremiumCaption, "bi-cash-coin", "kp-tone-blue", "/tenant/dashboard/branch-performance")
                        @Insight("Written Premium MTD", _data.WrittenPremiumMtd.ToString("C0", CultureInfo.CurrentCulture), "Current month premium production", "bi-calendar2-week", "kp-tone-green", "/tenant/dashboard/branch-performance")
                        @Insight("New Business Rate", Percent(_data.NewBusinessRate), "New business share of written policies", "bi-graph-up-arrow", "kp-tone-purple", "/crm/opportunities")
                        @Insight("Avg Premium / Policy", _data.AvgPremiumPerPolicy.ToString("C0", CultureInfo.CurrentCulture), "Average premium on active policies", "bi-calculator", "kp-tone-indigo", "/policies")
                    </div>
                    @RevenueComparisonPanel
                }
                else if (_view == "retention")
                {
                    <div class="kp-section-head"><div><h2>Policy and retention performance</h2><p>In-force policy base, new policies, cancellations, and book retention health.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => GoTo("/tenant/dashboard/renewal-pipeline")'>Renewals</button></div>
                    <div class="kp-insight-grid">
                        @Insight("Retention Rate", Percent(_data.RetentionRate), RetentionCaption, "bi-arrow-repeat", RetentionTone, "/tenant/dashboard/renewal-pipeline")
                        @Insight("Active Policies", _data.TotalActivePolicies.ToString("N0", CultureInfo.CurrentCulture), "In-force policy base", "bi-shield-check", "kp-tone-green", "/policies")
                        @Insight("New Policies MTD", _data.NewPoliciesMtd.ToString("N0", CultureInfo.CurrentCulture), "Policies created this month", "bi-plus-circle", "kp-tone-blue", "/policies")
                        @Insight("Cancelled MTD", _data.CancelledPoliciesMtd.ToString("N0", CultureInfo.CurrentCulture), "Cancellation pressure this month", "bi-x-octagon", _data.CancelledPoliciesMtd > 0 ? "kp-tone-red" : "kp-tone-green", "/tenant/dashboard/renewal-pipeline")
                    </div>
                    @PolicyFlowPanel
                }
                else if (_view == "pipeline")
                {
                    <div class="kp-section-head"><div><h2>Pipeline and conversion performance</h2><p>Lead generation, lead conversion, quote volume, and quote conversion quality.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => GoTo("/crm/leads")'>Open Leads</button></div>
                    <div class="kp-insight-grid">
                        @Insight("Leads This Month", _data.LeadsThisMonth.ToString("N0", CultureInfo.CurrentCulture), "Fresh lead flow", "bi-person-plus", "kp-tone-amber", "/crm/leads")
                        @Insight("Lead Conversion", Percent(_data.LeadConversionRate), "Lead-to-customer conversion", "bi-funnel", ConversionTone(_data.LeadConversionRate), "/crm/leads")
                        @Insight("Quotes MTD", _data.QuotesMtd.ToString("N0", CultureInfo.CurrentCulture), "Quotes created this month", "bi-file-earmark-text", "kp-tone-purple", "/crm/quotes")
                        @Insight("Quote Conversion", Percent(_data.QuoteConversionRate), "Quote-to-bound performance", "bi-check2-circle", ConversionTone(_data.QuoteConversionRate), "/crm/quotes")
                    </div>
                    @ConversionPanel
                }
                else if (_view == "producer")
                {
                    <div class="kp-section-head"><div><h2>Producer productivity</h2><p>Active producer coverage, premium per producer, and sales productivity signals sourced from tenant users and activity.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => GoTo("/tenant/dashboard/producer-performance")'>Producer Detail</button></div>
                    <div class="kp-insight-grid">
                        @Insight("Active Producers", _data.ActiveProducers.ToString("N0", CultureInfo.CurrentCulture), "Users with producer role or production activity", "bi-person-badge", "kp-tone-blue", "/tenant/dashboard/producer-performance")
                        @Insight("Avg Premium / Producer", AvgPremiumPerProducer.ToString("C0", CultureInfo.CurrentCulture), "Written premium per active producer", "bi-calculator", "kp-tone-indigo", "/tenant/dashboard/producer-performance")
                        @Insight("Policies / Producer", PoliciesPerProducer.ToString("F1", CultureInfo.CurrentCulture), "Active policy coverage per producer", "bi-shield-check", "kp-tone-green", "/tenant/dashboard/producer-performance")
                        @Insight("Pipeline / Producer", PipelinePerProducer.ToString("F1", CultureInfo.CurrentCulture), "Leads this month per active producer", "bi-funnel", "kp-tone-purple", "/crm/leads")
                    </div>
                    @ProducerProductivityPanel
                }
                else
                {
                    <div class="kp-section-head"><div><h2>Exceptions and action queue</h2><p>Prioritized KPI watchlist for executive follow-up.</p></div><button type="button" class="um-btn um-btn-danger um-btn-sm" @onclick='() => GoTo("/tenant/dashboard/alerts")'>Alerts</button></div>
                    <div class="kp-exception-grid">
                        @ExceptionPanel("Retention watch", RetentionExceptionItems, "Protect renewal and book health", "bi-heart-pulse", "kp-tone-amber")
                        @ExceptionPanel("Production watch", RevenueExceptionItems, "Monitor premium and new business pace", "bi-graph-up-arrow", "kp-tone-blue")
                        @ExceptionPanel("Pipeline watch", PipelineExceptionItems, "Improve lead and quote conversion", "bi-funnel", "kp-tone-purple")
                    </div>
                }
            </main>

            <aside class="kp-priority-panel">
                <div class="kp-priority-head"><span><i class="bi bi-compass" aria-hidden="true"></i> KPI cockpit</span><strong>@FocusLabel</strong></div>
                <div class="kp-priority-stack">
                    @foreach (var item in PriorityItems)
                    {
                        <button type="button" class="kp-priority-item @item.Tone" @onclick="@(() => GoTo(item.Url))"><i class="bi @item.Icon" aria-hidden="true"></i><span><strong>@item.Title</strong><small>@item.Detail</small></span><em>@item.Value</em></button>
                    }
                </div>
            </aside>
        </section>
    }
</div>

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private AgencyKpiDto? _data;
    private bool _loading = true;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string _view = "executive";
    private string _focus = "revenue";

    private readonly ViewOption[] _views = [new("executive", "Executive", "bi-speedometer2"), new("revenue", "Revenue", "bi-cash-coin"), new("retention", "Retention", "bi-arrow-repeat"), new("pipeline", "Pipeline", "bi-funnel"), new("producer", "Producer", "bi-person-badge"), new("exceptions", "Exceptions", "bi-shield-exclamation")];

    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", _ => "bi-check-circle-fill" };
    private string FocusLabel => _focus switch { "retention" => "Retention", "pipeline" => "Pipeline", "quotes" => "Quotes", "producer" => "Producer", "exceptions" => "Exceptions", _ => "Revenue" };
    private decimal PremiumGrowth => _data is null || _data.WrittenPremiumPriorYtd <= 0 ? 0 : ((_data.WrittenPremiumYtd - _data.WrittenPremiumPriorYtd) / _data.WrittenPremiumPriorYtd) * 100;
    private decimal PremiumGap => _data is null ? 0 : _data.WrittenPremiumYtd - _data.WrittenPremiumPriorYtd;
    private decimal AvgPremiumPerProducer => _data is null || _data.ActiveProducers <= 0 ? 0 : _data.WrittenPremiumYtd / _data.ActiveProducers;
    private decimal PoliciesPerProducer => _data is null || _data.ActiveProducers <= 0 ? 0 : (decimal)_data.TotalActivePolicies / _data.ActiveProducers;
    private decimal PipelinePerProducer => _data is null || _data.ActiveProducers <= 0 ? 0 : (decimal)_data.LeadsThisMonth / _data.ActiveProducers;
    private int PerformanceScore => _data is null ? 0 : (int)Math.Clamp((_data.RetentionRate * .35m) + (_data.LeadConversionRate * .25m) + (_data.QuoteConversionRate * .2m) + (Math.Min(100, Math.Max(0, PremiumGrowth + 50)) * .2m), 0, 100);
    private string PerformanceScoreLabel => PerformanceScore.ToString("N0", CultureInfo.CurrentCulture) + "%";
    private string PerformanceScoreWidth => PerformanceScore.ToString("N0", CultureInfo.InvariantCulture) + "%";
    private string PerformanceFillClass => $"kp-progress-fill {(PerformanceScore >= 85 ? "kp-progress-good" : PerformanceScore >= 70 ? "kp-progress-watch" : "kp-progress-risk")}";
    private string PriorPremiumCaption => PremiumGap >= 0 ? $"{PremiumGap.ToString("C0", CultureInfo.CurrentCulture)} ahead of prior YTD" : $"{Math.Abs(PremiumGap).ToString("C0", CultureInfo.CurrentCulture)} behind prior YTD";
    private string RetentionCaption => _data is null ? string.Empty : _data.RetentionRate >= 85 ? "Healthy retention posture" : _data.RetentionRate >= 75 ? "Retention watch threshold" : "Retention risk needs attention";
    private string RetentionTone => _data?.RetentionRate >= 85 ? "kp-tone-green" : _data?.RetentionRate >= 75 ? "kp-tone-amber" : "kp-tone-red";
    private string GuidanceText => _data is null ? string.Empty : PerformanceScore >= 85 ? "KPI performance is strong. Continue monitoring premium growth, conversion, and retention quality." : PerformanceScore >= 70 ? "KPI performance is stable with watch items. Focus coaching on the weakest conversion or retention signal." : "KPI performance needs leadership attention. Prioritize retention, pipeline conversion, and new business velocity.";
    private string LeadershipGuidance => _data is null ? string.Empty : _data.RetentionRate < 80 ? "Retention is the primary executive priority. Review renewal pipeline, cancellations, and branch coaching." : _data.LeadConversionRate < 20 ? "Pipeline conversion needs attention. Review lead sources, assignment quality, and producer follow-up." : PremiumGrowth < 0 ? "Premium is behind prior YTD. Focus producers on opportunity velocity and quote conversion." : "The KPI mix is balanced. Keep cadence on producer performance, policy growth, and pipeline quality.";

    private IReadOnlyList<KpiMetric> Metrics => _data is null ? [] :
    [
        new("revenue", _data.WrittenPremiumYtd.ToString("C0", CultureInfo.CurrentCulture), "Premium YTD", PriorPremiumCaption, "bi-cash-coin", "kp-kpi-premium"),
        new("retention", Percent(_data.RetentionRate), "Retention", $"{_data.TotalActivePolicies:N0} active policies", "bi-arrow-repeat", "kp-kpi-retention"),
        new("pipeline", Percent(_data.LeadConversionRate), "Lead Conversion", $"{_data.LeadsThisMonth:N0} leads this month", "bi-funnel", "kp-kpi-pipeline"),
        new("quotes", Percent(_data.QuoteConversionRate), "Quote Conversion", $"{_data.QuotesMtd:N0} quotes MTD", "bi-file-earmark-check", "kp-kpi-quotes"),
        new("producer", _data.ActiveProducers.ToString("N0", CultureInfo.CurrentCulture), "Producers", $"{AvgPremiumPerProducer.ToString("C0", CultureInfo.CurrentCulture)} avg premium", "bi-person-badge", "kp-kpi-producer"),
        new("exceptions", _data.CancelledPoliciesMtd.ToString("N0", CultureInfo.CurrentCulture), "Cancellations", "Cancelled policies MTD", "bi-shield-exclamation", "kp-kpi-exceptions")
    ];

    private IReadOnlyList<PriorityItem> PriorityItems => _data is null ? [] :
    [
        new("Premium Growth", Percent(PremiumGrowth), PriorPremiumCaption, "bi-graph-up-arrow", PremiumGrowth >= 0 ? "kp-priority-good" : "kp-priority-warn", "/tenant/dashboard/branch-performance"),
        new("Retention", Percent(_data.RetentionRate), RetentionCaption, "bi-arrow-repeat", _data.RetentionRate >= 85 ? "kp-priority-good" : "kp-priority-warn", "/tenant/dashboard/renewal-pipeline"),
        new("Lead Conversion", Percent(_data.LeadConversionRate), $"{_data.LeadsThisMonth:N0} leads this month", "bi-funnel", _data.LeadConversionRate >= 25 ? "kp-priority-good" : "kp-priority-warn", "/crm/leads"),
        new("Quote Conversion", Percent(_data.QuoteConversionRate), $"{_data.QuotesMtd:N0} quotes this month", "bi-check2-circle", _data.QuoteConversionRate >= 25 ? "kp-priority-good" : "kp-priority-warn", "/crm/quotes"),
        new("Producers", _data.ActiveProducers.ToString("N0", CultureInfo.CurrentCulture), $"{AvgPremiumPerProducer.ToString("C0", CultureInfo.CurrentCulture)} avg premium", "bi-person-badge", _data.ActiveProducers > 0 ? "kp-priority-good" : "kp-priority-warn", "/tenant/dashboard/producer-performance"),
        new("Cancellations", _data.CancelledPoliciesMtd.ToString("N0", CultureInfo.CurrentCulture), "Cancelled policies MTD", "bi-x-octagon", _data.CancelledPoliciesMtd == 0 ? "kp-priority-good" : "kp-priority-danger", "/tenant/dashboard/renewal-pipeline")
    ];

    private IReadOnlyList<KpiRankRow> KpiRankRows => _data is null ? [] :
    [
        new("Retention", _data.RetentionRate, Percent(_data.RetentionRate), "Book health", "bi-arrow-repeat", _data.RetentionRate >= 85 ? "kp-rank-good" : "kp-rank-watch"),
        new("Lead Conversion", _data.LeadConversionRate, Percent(_data.LeadConversionRate), "Pipeline quality", "bi-funnel", _data.LeadConversionRate >= 25 ? "kp-rank-good" : "kp-rank-watch"),
        new("Quote Conversion", _data.QuoteConversionRate, Percent(_data.QuoteConversionRate), "Quote quality", "bi-file-earmark-check", _data.QuoteConversionRate >= 25 ? "kp-rank-good" : "kp-rank-watch"),
        new("New Business", _data.NewBusinessRate, Percent(_data.NewBusinessRate), "Policy growth", "bi-graph-up-arrow", _data.NewBusinessRate >= 20 ? "kp-rank-good" : "kp-rank-watch"),
        new("Premium Growth", Math.Clamp(PremiumGrowth + 50, 0, 100), Percent(PremiumGrowth), "Prior YTD comparison", "bi-cash-coin", PremiumGrowth >= 0 ? "kp-rank-good" : "kp-rank-risk")
    ];

    private IReadOnlyList<ExceptionItem> RetentionExceptionItems => _data is null ? [] : [new("Retention rate", Percent(_data.RetentionRate), RetentionCaption), new("Cancelled policies", _data.CancelledPoliciesMtd.ToString("N0", CultureInfo.CurrentCulture), "Cancellations this month"), new("Active policies", _data.TotalActivePolicies.ToString("N0", CultureInfo.CurrentCulture), "In-force policy base")];
    private IReadOnlyList<ExceptionItem> RevenueExceptionItems => _data is null ? [] : [new("Premium growth", Percent(PremiumGrowth), PriorPremiumCaption), new("New business rate", Percent(_data.NewBusinessRate), "New business contribution"), new("Avg policy premium", _data.AvgPremiumPerPolicy.ToString("C0", CultureInfo.CurrentCulture), "Average premium per policy")];
    private IReadOnlyList<ExceptionItem> PipelineExceptionItems => _data is null ? [] : [new("Lead conversion", Percent(_data.LeadConversionRate), "Lead-to-customer conversion"), new("Quote conversion", Percent(_data.QuoteConversionRate), "Quote-to-bound conversion"), new("Quotes MTD", _data.QuotesMtd.ToString("N0", CultureInfo.CurrentCulture), "Quotes created this month")];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tenant Dashboard", "/tenant/dashboard"), new("KPI Performance", "/tenant/dashboard/kpis-performance"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _data = await Api.GetAgencyKpisAsync(_tenantId);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load KPI performance: {ex.Message}";
            _data = null;
            ShowToast($"KPI performance load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private RenderFragment KpiRankPanel => @<section class="kp-panel"><h3><i class="bi bi-bar-chart-line" aria-hidden="true"></i> KPI scorecard</h3><div class="kp-rank-stack">@foreach (var row in KpiRankRows) { <button type="button" class="kp-rank-row @row.Tone" @onclick="@(() => SetFocusFromLabel(row.Label))"><i class="bi @row.Icon" aria-hidden="true"></i><span><strong>@row.Label</strong><small>@row.Caption</small></span><div><i style="width:@PercentWidth(row.Score)"></i></div><em>@row.Value</em></button> }</div></section>;
    private RenderFragment RevenueComparisonPanel => @<section class="kp-panel"><h3><i class="bi bi-columns-gap" aria-hidden="true"></i> Premium comparison</h3><div class="kp-comparison-grid"><div><span>Current YTD</span><strong>@(_data?.WrittenPremiumYtd.ToString("C0", CultureInfo.CurrentCulture) ?? "-")</strong></div><div><span>Prior YTD</span><strong>@(_data?.WrittenPremiumPriorYtd.ToString("C0", CultureInfo.CurrentCulture) ?? "-")</strong></div><div><span>Growth</span><strong>@Percent(PremiumGrowth)</strong></div><div><span>Avg / Producer</span><strong>@AvgPremiumPerProducer.ToString("C0", CultureInfo.CurrentCulture)</strong></div></div></section>;
    private RenderFragment PolicyFlowPanel => @<section class="kp-panel"><h3><i class="bi bi-shield-check" aria-hidden="true"></i> Policy flow</h3><div class="kp-flow-grid"><div><span>New policies</span><strong>@(_data?.NewPoliciesMtd.ToString("N0", CultureInfo.CurrentCulture) ?? "0")</strong></div><div><span>Cancelled policies</span><strong>@(_data?.CancelledPoliciesMtd.ToString("N0", CultureInfo.CurrentCulture) ?? "0")</strong></div><div><span>Net MTD flow</span><strong>@((_data?.NewPoliciesMtd ?? 0) - (_data?.CancelledPoliciesMtd ?? 0))</strong></div></div></section>;
    private RenderFragment ConversionPanel => @<section class="kp-panel"><h3><i class="bi bi-funnel" aria-hidden="true"></i> Conversion health</h3><div class="kp-conversion-stack"><div><span>Lead conversion</span><div><i style="width:@PercentWidth(_data?.LeadConversionRate ?? 0)"></i></div><strong>@Percent(_data?.LeadConversionRate ?? 0)</strong></div><div><span>Quote conversion</span><div><i style="width:@PercentWidth(_data?.QuoteConversionRate ?? 0)"></i></div><strong>@Percent(_data?.QuoteConversionRate ?? 0)</strong></div><div><span>New business rate</span><div><i style="width:@PercentWidth(_data?.NewBusinessRate ?? 0)"></i></div><strong>@Percent(_data?.NewBusinessRate ?? 0)</strong></div></div></section>;
    private RenderFragment ProducerProductivityPanel => @<section class="kp-panel"><h3><i class="bi bi-person-lines-fill" aria-hidden="true"></i> Producer productivity</h3><div class="kp-comparison-grid"><div><span>Active producers</span><strong>@(_data?.ActiveProducers.ToString("N0", CultureInfo.CurrentCulture) ?? "0")</strong></div><div><span>Premium / producer</span><strong>@AvgPremiumPerProducer.ToString("C0", CultureInfo.CurrentCulture)</strong></div><div><span>Policies / producer</span><strong>@PoliciesPerProducer.ToString("F1", CultureInfo.CurrentCulture)</strong></div><div><span>Leads / producer</span><strong>@PipelinePerProducer.ToString("F1", CultureInfo.CurrentCulture)</strong></div></div></section>;

    private RenderFragment Insight(string label, string value, string caption, string icon, string tone, string url) => @<button type="button" class="kp-insight-card @tone" @onclick="@(() => GoTo(url))"><i class="bi @icon" aria-hidden="true"></i><span><strong>@value</strong><em>@label</em><small>@caption</small></span></button>;
    private RenderFragment ExceptionPanel(string title, IReadOnlyList<ExceptionItem> items, string caption, string icon, string tone) => @<section class="kp-exception-panel @tone"><h3><i class="bi @icon" aria-hidden="true"></i> @title</h3><p>@caption</p><div class="kp-exception-list">@foreach (var item in items) { <div><span><strong>@item.Label</strong><small>@item.Caption</small></span><em>@item.Value</em></div> }</div></section>;

    private void SetView(string view) { _view = view; _focus = view == "executive" ? _focus : view; }
    private void SetFocus(string focus) { _focus = focus; _view = focus switch { "retention" => "retention", "pipeline" or "quotes" => "pipeline", "producer" => "producer", "exceptions" => "exceptions", _ => "revenue" }; }
    private void SetFocusFromLabel(string label) => SetFocus(label.Contains("Retention", StringComparison.OrdinalIgnoreCase) ? "retention" : label.Contains("Conversion", StringComparison.OrdinalIgnoreCase) ? "pipeline" : "revenue");
    private void GoTo(string url) => Nav.NavigateTo(url);
    private void ShowToast(string message, string kind) { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;
    private string MetricCardClass(KpiMetric metric) => $"kp-kpi-card {metric.Tone} {(metric.Focus == _focus ? "kp-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewOption view) => $"kp-view-btn {(view.Id == _view ? "kp-view-btn-active" : string.Empty)}";
    private int ViewCount(string view) => _data is null ? 0 : view switch { "revenue" => RevenueExceptionItems.Count, "retention" => RetentionExceptionItems.Count, "pipeline" => PipelineExceptionItems.Count, "producer" => _data.ActiveProducers, "exceptions" => RetentionExceptionItems.Count + RevenueExceptionItems.Count + PipelineExceptionItems.Count, _ => KpiRankRows.Count };
    private static string Percent(decimal value) => value.ToString("F1", CultureInfo.CurrentCulture) + "%";
    private static string PercentWidth(decimal value) => Math.Clamp(value, 3, 100).ToString("F1", CultureInfo.InvariantCulture) + "%";
    private static string ConversionTone(decimal value) => value >= 30 ? "kp-tone-green" : value >= 15 ? "kp-tone-amber" : "kp-tone-red";

    private sealed record ViewOption(string Id, string Label, string Icon);
    private sealed record KpiMetric(string Focus, string Value, string Label, string Caption, string Icon, string Tone);
    private sealed record PriorityItem(string Title, string Value, string Detail, string Icon, string Tone, string Url);
    private sealed record KpiRankRow(string Label, decimal Score, string Value, string Caption, string Icon, string Tone);
    private sealed record ExceptionItem(string Label, string Value, string Caption);
}
