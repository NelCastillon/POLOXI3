@page "/tenant/dashboard/branch-performance"
@namespace Ams.Web.Components.Pages.Tenant.Dashboard
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Branch Performance — Agency Dashboard</PageTitle>

<AppPageHeader Title="Branch Performance"
               Subtitle="Compare premium, policies, leads and AR across all branches"
               Icon="bi-diagram-3">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "ad-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
    </Actions>
</AppPageHeader>

@if (_loading)
{
    <div class="ad-loading-banner" aria-live="polite">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading branch data…</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger ad-alert-danger" role="alert"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i> @_loadError</div>
}
else if (_rows is null || _rows.Count == 0)
{
    <div class="ad-empty"><i class="bi bi-diagram-3" aria-hidden="true"></i><span>No branch data available.</span></div>
}
else
{
    <!-- ── Summary strip ──────────────────────────────────────── -->
    <div class="ad-kpi-strip">
        <button type="button" class="ad-kpi-card ad-kpi--branches @KpiClass("all")" @onclick='() => SetFilter("all")' title="Show all branches">
            <div class="ad-kpi-icon"><i class="bi bi-diagram-3-fill" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_rows.Count</div>
                <div class="ad-kpi-lbl">Branches</div>
            </div>
        </button>
        <button type="button" class="ad-kpi-card ad-kpi--premium @KpiClass("premium")" @onclick='() => SetFilter("premium")' title="Show branches with written premium">
            <div class="ad-kpi-icon"><i class="bi bi-cash-coin" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_rows.Sum(r => r.WrittenPremiumYtd).ToString("C0")</div>
                <div class="ad-kpi-lbl">Total Written YTD</div>
            </div>
        </button>
        <button type="button" class="ad-kpi-card ad-kpi--policies @KpiClass("policies")" @onclick='() => SetFilter("policies")' title="Show branches with active policies">
            <div class="ad-kpi-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_rows.Sum(r => r.ActivePolicies).ToString("N0")</div>
                <div class="ad-kpi-lbl">Total Policies</div>
            </div>
        </button>
        <button type="button" class="ad-kpi-card ad-kpi--ar @KpiClass("ar")" @onclick='() => SetFilter("ar")' title="Show branches with outstanding AR">
            <div class="ad-kpi-icon"><i class="bi bi-receipt" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_rows.Sum(r => r.OutstandingAr).ToString("C0")</div>
                <div class="ad-kpi-lbl">Total AR</div>
            </div>
        </button>
    </div>
    @if (_activeFilter != "all")
    {
        <div class="ad-filter-bar"><span class="ad-filter-chip"><i class="bi bi-funnel" aria-hidden="true"></i> @FilterLabel(_activeFilter)</span><button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => SetFilter("all")'><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button></div>
    }

    <!-- ── Branch table ───────────────────────────────────────── -->
    <div class="ad-card">
        <div class="ad-table-wrap">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th>Branch</th>
                        <th>Location</th>
                        <th class="ad-num">Premium MTD</th>
                        <th class="ad-num">Premium YTD</th>
                        <th class="ad-num">Policies</th>
                        <th class="ad-num">Producers</th>
                        <th class="ad-num">Retention</th>
                        <th class="ad-num">Open Leads</th>
                        <th class="ad-num">Open Claims</th>
                        <th class="ad-num">AR</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in FilteredRows.OrderByDescending(r => r.WrittenPremiumYtd))
                    {
                        <tr>
                            <td>
                                <div style="font-weight:600">@b.BranchName</div>
                                @if (!string.IsNullOrEmpty(b.BranchCode))
                                {
                                    <div style="font-size:.72rem;color:#9ca3af">@b.BranchCode</div>
                                }
                            </td>
                            <td style="font-size:.8rem;color:#6b7280">
                                @if (!string.IsNullOrEmpty(b.City) || !string.IsNullOrEmpty(b.StateProvince))
                                { @($"{b.City}{(b.City != null && b.StateProvince != null ? ", " : "")}{b.StateProvince}") }
                                else { <span>—</span> }
                            </td>
                            <td class="ad-num">@b.WrittenPremiumMtd.ToString("C0")</td>
                            <td class="ad-num" style="font-weight:600">@b.WrittenPremiumYtd.ToString("C0")</td>
                            <td class="ad-num">@b.ActivePolicies</td>
                            <td class="ad-num">@b.ActiveProducers</td>
                            <td class="ad-num">
                                <span class="ad-badge @(b.RetentionRate >= 85 ? "ad-badge--closed" : b.RetentionRate >= 70 ? "ad-badge--pending" : "ad-badge--overdue")">
                                    @b.RetentionRate.ToString("F1")%
                                </span>
                            </td>
                            <td class="ad-num">@b.OpenLeads</td>
                            <td class="ad-num">
                                @if (b.OpenClaims > 0)
                                {
                                    <span class="ad-badge ad-badge--warn">@b.OpenClaims</span>
                                }
                                else { <span>0</span> }
                            </td>
                            <td class="ad-num">@b.OutstandingAr.ToString("C0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private List<BranchPerformanceDto>? _rows;
    private bool _loading;
    private string? _loadError;
    private string _activeFilter = "all";
    private IEnumerable<BranchPerformanceDto> FilteredRows => (_rows ?? []).Where(b => _activeFilter switch
    {
        "premium" => b.WrittenPremiumYtd > 0 || b.WrittenPremiumMtd > 0,
        "policies" => b.ActivePolicies > 0,
        "ar" => b.OutstandingAr > 0,
        _ => true,
    });

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Agency Dashboard", "/tenant/dashboard"), new("Branch Performance"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try { _rows = await Api.GetBranchPerformanceAsync(_tenantId); }
        catch (Exception ex) { _loadError = $"Failed to load branch performance: {ex.Message}"; _rows = []; }
        finally { _loading = false; }
    }

    private void SetFilter(string filter) => _activeFilter = _activeFilter == filter && filter != "all" ? "all" : filter;
    private string KpiClass(string filter) => _activeFilter == filter ? "ad-kpi-card--active" : string.Empty;
    private static string FilterLabel(string filter) => filter switch { "premium" => "Branches with written premium", "policies" => "Branches with active policies", "ar" => "Branches with outstanding AR", _ => "All branches" };

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
