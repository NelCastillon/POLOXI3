@page "/tenant/dashboard/branch-performance"
@page "/dashboard/branch-performance"
@namespace Ams.Web.Components.Pages.Tenant.Dashboard
@using System.Globalization
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Enterprise Branch Performance - AMS</PageTitle>

@if (_toastVisible)
{
    <div class="bp-toast bp-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="bp-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="bp-enterprise-page">
    <section class="bp-hero">
        <div class="bp-hero-left">
            <span class="bp-hero-icon"><i class="bi bi-diagram-3-fill" aria-hidden="true"></i></span>
            <div>
                <div class="bp-title-row">
                    <h1>Branch Performance Command Center</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live branch data</span>
                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> Tenant scoped</span>
                    <span><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Revenue governed</span>
                </div>
                <p>Compare branch revenue, retention, active policies, producer capacity, lead flow, claims pressure, and receivables exposure in one enterprise dashboard.</p>
            </div>
        </div>
        <div class="bp-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh branch performance"><i class="bi @(_loading ? "bi-arrow-repeat bp-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/tenant/dashboard")'><i class="bi bi-speedometer2" aria-hidden="true"></i> Dashboard</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/tenant/dashboard/producer-performance")'><i class="bi bi-person-badge" aria-hidden="true"></i> Producers</button>
            <button type="button" class="um-btn um-btn-primary" @onclick='() => GoTo("/tenant/dashboard/kpis")'><i class="bi bi-bar-chart-line" aria-hidden="true"></i> KPI Detail</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger bp-error-banner" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError</div>
    }

    @if (_loading)
    {
        <section class="bp-loading-state"><i class="bi bi-arrow-repeat bp-spin" aria-hidden="true"></i><strong>Loading enterprise branch performance...</strong><span>Syncing branch premium, policies, producer capacity, claims, leads, and receivables.</span></section>
    }
    else if (_rows.Count == 0)
    {
        <section class="bp-empty-state"><i class="bi bi-diagram-3" aria-hidden="true"></i><strong>No branch data available</strong><span>Sync tenant data or add branch records to activate branch performance analytics.</span><button type="button" class="um-btn um-btn-primary" @onclick="LoadAsync">Retry sync</button></section>
    }
    else
    {
        <section class="bp-kpi-strip" aria-label="Branch KPI filters">
            @foreach (var metric in Metrics)
            {
                <button type="button" class="@MetricCardClass(metric)" title="@metric.Caption" @onclick="@(() => SetFilter(metric.Filter))">
                    <span class="bp-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                    <span><span class="bp-kpi-val">@metric.Value</span><span class="bp-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
                </button>
            }
        </section>

        <section class="bp-workflow-strip" aria-label="Branch workflow actions">
            <button type="button" class="bp-workflow-card" @onclick='() => SetFilter("premium")'><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><span><strong>Rank performance</strong><span>Compare premium and policy production.</span></span></button>
            <button type="button" class="bp-workflow-card" @onclick='() => SetFilter("retention")'><i class="bi bi-heart-pulse" aria-hidden="true"></i><span><strong>Protect retention</strong><span>Find branches below retention target.</span></span></button>
            <button type="button" class="bp-workflow-card" @onclick='() => SetFilter("ar")'><i class="bi bi-receipt" aria-hidden="true"></i><span><strong>Collect receivables</strong><span>Prioritize branches with AR exposure.</span></span></button>
            <button type="button" class="bp-workflow-card bp-workflow-danger" @onclick='() => SetFilter("claims")'><i class="bi bi-exclamation-circle" aria-hidden="true"></i><span><strong>Service exceptions</strong><span>Focus open claims pressure.</span></span></button>
        </section>

        <section class="bp-filter-panel">
            <div class="bp-search-wrap">
                <span class="bp-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                <div class="bp-search-body">
                    <label for="branchSearchInput">Search branches</label>
                    <input id="branchSearchInput" class="bp-search-input" value="@_searchTerm" @oninput="SearchChangedCallback" placeholder="Search branch name, code, city, or state..." />
                    <span>Filters the live branch dashboard immediately.</span>
                </div>
            </div>
            <label class="bp-sort-field">Sort by
                <select class="bp-filter-select" value="@_sort" @onchange="SortChangedCallback">
                    <option value="premium">Premium YTD</option>
                    <option value="retention">Retention</option>
                    <option value="policies">Active policies</option>
                    <option value="ar">Outstanding AR</option>
                    <option value="claims">Open claims</option>
                </select>
            </label>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-cloud-arrow-down" aria-hidden="true"></i> Sync</button>
            <div class="bp-filter-result"><strong>@FilteredRows.Count.ToString("N0", CultureInfo.CurrentCulture)</strong><span>shown</span></div>
        </section>

        <section class="bp-view-tabs" aria-label="Branch performance views">
            @foreach (var view in _views)
            {
                <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label <span>@ViewCount(view.Id)</span></button>
            }
        </section>

        <section class="bp-content-layout">
            <main class="bp-main-card">
                @if (_view == "overview")
                {
                    <div class="bp-section-head"><div><h2>Executive branch overview</h2><p>Most important branch signals by revenue, retention, operating volume, and exception risk.</p></div><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => SetView("table")'><i class="bi bi-table" aria-hidden="true"></i> Table View</button></div>
                    <div class="bp-overview-grid">
                        <section class="bp-spotlight-card"><span><i class="bi bi-trophy" aria-hidden="true"></i> Top producing branch</span><strong>@(TopBranch?.BranchName ?? "?")</strong><p>@((TopBranch?.WrittenPremiumYtd ?? 0).ToString("C0", CultureInfo.CurrentCulture)) YTD premium with @((TopBranch?.ActivePolicies ?? 0).ToString("N0", CultureInfo.CurrentCulture)) active policies.</p><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="SelectTopBranch">Inspect branch</button></section>
                        <section class="bp-guidance-card"><h3><i class="bi bi-stars" aria-hidden="true"></i> Branch guidance</h3><p>@GuidanceText</p><div class="bp-guidance-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("retention")'>Retention</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("ar")'>AR</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("claims")'>Claims</button></div></section>
                    </div>
                    @BranchRankPanel
                }
                else if (_view == "performance")
                {
                    <div class="bp-section-head"><div><h2>Performance ranking</h2><p>Premium, policy count, producer coverage, and retention ranked by branch.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => GoTo("/tenant/dashboard/producer-performance")'>Producer Detail</button></div>
                    <div class="bp-branch-card-grid">
                        @foreach (var branch in FilteredRows)
                        {
                            @BranchCard(branch)
                        }
                    </div>
                }
                else if (_view == "risk")
                {
                    <div class="bp-section-head"><div><h2>Risk and exception cockpit</h2><p>Branches with retention, claims, lead, and receivables pressure requiring leadership attention.</p></div><button type="button" class="um-btn um-btn-danger um-btn-sm" @onclick='() => GoTo("/tenant/dashboard/alerts")'>Open Alerts</button></div>
                    <div class="bp-risk-grid">
                        @RiskPanel("Retention risk", RetentionRiskRows, "Branches below 80% retention", "bi-heart-pulse", "bp-tone-amber")
                        @RiskPanel("Receivables exposure", ArRows, "Branches carrying outstanding AR", "bi-receipt", "bp-tone-indigo")
                        @RiskPanel("Claims pressure", ClaimRows, "Branches with open claims", "bi-exclamation-circle", "bp-tone-red")
                    </div>
                }
                else
                {
                    <div class="bp-section-head"><div><h2>Branch operating table</h2><p>Complete branch data synchronized from the agency dashboard API.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters">Reset</button></div>
                    <div class="bp-table-wrap">
                        <table class="bp-table">
                            <thead>
                                <tr>
                                    <th>Branch</th>
                                    <th>Location</th>
                                    <th class="bp-num">Premium MTD</th>
                                    <th class="bp-num">Premium YTD</th>
                                    <th class="bp-num">Policies</th>
                                    <th class="bp-num">Producers</th>
                                    <th class="bp-num">Retention</th>
                                    <th class="bp-num">Leads</th>
                                    <th class="bp-num">Claims</th>
                                    <th class="bp-num">AR</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var branch in FilteredRows)
                                {
                                    <tr class="@(SelectedId == branch.BranchId ? "bp-row-selected" : string.Empty)" @onclick="@(() => SelectBranch(branch))">
                                        <td><strong>@branch.BranchName</strong><small>@DisplayCode(branch.BranchCode)</small></td>
                                        <td>@Location(branch)</td>
                                        <td class="bp-num">@branch.WrittenPremiumMtd.ToString("C0", CultureInfo.CurrentCulture)</td>
                                        <td class="bp-num"><strong>@branch.WrittenPremiumYtd.ToString("C0", CultureInfo.CurrentCulture)</strong></td>
                                        <td class="bp-num">@branch.ActivePolicies.ToString("N0", CultureInfo.CurrentCulture)</td>
                                        <td class="bp-num">@branch.ActiveProducers.ToString("N0", CultureInfo.CurrentCulture)</td>
                                        <td class="bp-num"><span class="bp-badge @RetentionTone(branch.RetentionRate)">@branch.RetentionRate.ToString("F1", CultureInfo.CurrentCulture)%</span></td>
                                        <td class="bp-num">@branch.OpenLeads.ToString("N0", CultureInfo.CurrentCulture)</td>
                                        <td class="bp-num"><span class="bp-badge @(branch.OpenClaims > 0 ? "bp-badge-danger" : "bp-badge-muted")">@branch.OpenClaims.ToString("N0", CultureInfo.CurrentCulture)</span></td>
                                        <td class="bp-num">@branch.OutstandingAr.ToString("C0", CultureInfo.CurrentCulture)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </main>

            <aside class="bp-detail-panel">
                @if (_selected is null)
                {
                    <div class="bp-detail-empty"><i class="bi bi-diagram-3" aria-hidden="true"></i><strong>Select a branch</strong><span>Choose a branch to inspect production, retention, claims, producer capacity, and receivables actions.</span></div>
                }
                else
                {
                    <div class="bp-detail-head"><div><span><i class="bi bi-building" aria-hidden="true"></i> Branch detail</span><h2>@_selected.BranchName</h2><p>@Location(_selected) - @DisplayCode(_selected.BranchCode)</p></div><span class="bp-badge @RetentionTone(_selected.RetentionRate)">@_selected.RetentionRate.ToString("F1", CultureInfo.CurrentCulture)% retention</span></div>
                    <div class="bp-detail-summary">
                        <div><span>Premium YTD</span><strong>@_selected.WrittenPremiumYtd.ToString("C0", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Premium MTD</span><strong>@_selected.WrittenPremiumMtd.ToString("C0", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Policies</span><strong>@_selected.ActivePolicies.ToString("N0", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Producers</span><strong>@_selected.ActiveProducers.ToString("N0", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Open leads</span><strong>@_selected.OpenLeads.ToString("N0", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Open claims</span><strong>@_selected.OpenClaims.ToString("N0", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Outstanding AR</span><strong>@_selected.OutstandingAr.ToString("C0", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Share of premium</span><strong>@ShareLabel(_selected.WrittenPremiumYtd, TotalPremiumYtd)</strong></div>
                    </div>
                    <div class="bp-detail-actions">
                        <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/tenant/dashboard/producer-performance")'><i class="bi bi-person-badge" aria-hidden="true"></i> Producers</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/tenant/dashboard/renewal-pipeline")'><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Renewals</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/tenant/dashboard/billing-summary")'><i class="bi bi-receipt" aria-hidden="true"></i> Billing</button>
                        <button type="button" class="um-btn um-btn-primary" @onclick='() => GoTo("/tenant/dashboard/claims-summary")'><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Claims</button>
                    </div>
                }
            </aside>
        </section>
    }
</div>

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<BranchPerformanceDto> _rows = [];
    private BranchPerformanceDto? _selected;
    private bool _loading = true;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string _activeFilter = "all";
    private string _view = "overview";
    private string _searchTerm = string.Empty;
    private string _sort = "premium";

    private Microsoft.AspNetCore.Components.EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> SearchChangedCallback => Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, SearchChanged);
    private Microsoft.AspNetCore.Components.EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> SortChangedCallback => Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, SortChanged);
    private Guid? SelectedId => _selected?.BranchId;
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", _ => "bi-check-circle-fill" };
    private decimal TotalPremiumYtd => _rows.Sum(r => r.WrittenPremiumYtd);
    private decimal TotalPremiumMtd => _rows.Sum(r => r.WrittenPremiumMtd);
    private int TotalPolicies => _rows.Sum(r => r.ActivePolicies);
    private int TotalProducers => _rows.Sum(r => r.ActiveProducers);
    private int TotalLeads => _rows.Sum(r => r.OpenLeads);
    private int TotalClaims => _rows.Sum(r => r.OpenClaims);
    private decimal TotalAr => _rows.Sum(r => r.OutstandingAr);
    private decimal AverageRetention => _rows.Count == 0 ? 0 : _rows.Average(r => r.RetentionRate);
    private int RetentionRiskCount => _rows.Count(r => r.RetentionRate > 0 && r.RetentionRate < 80);
    private int ArBranchCount => _rows.Count(r => r.OutstandingAr > 0);
    private int ClaimsBranchCount => _rows.Count(r => r.OpenClaims > 0);
    private BranchPerformanceDto? TopBranch => _rows.OrderByDescending(r => r.WrittenPremiumYtd).FirstOrDefault();
    private string GuidanceText => ClaimsBranchCount > 0 ? $"{ClaimsBranchCount} branch(es) have open claims pressure. Review service workload and claims follow-up first." : TotalAr > 0 ? $"Outstanding AR totals {TotalAr.ToString("C0", CultureInfo.CurrentCulture)} across {ArBranchCount} branch(es). Prioritize billing follow-up." : RetentionRiskCount > 0 ? $"{RetentionRiskCount} branch(es) are under the 80% retention watch threshold. Focus renewal coaching and producer support." : "Branch performance is stable. Continue monitoring premium mix, retention, and producer coverage.";

    private readonly ViewOption[] _views = [new("overview", "Overview", "bi-speedometer2"), new("performance", "Performance", "bi-graph-up-arrow"), new("risk", "Risk", "bi-shield-exclamation"), new("table", "Table", "bi-table")];

    private IReadOnlyList<BranchMetric> Metrics =>
    [
        new("all", _rows.Count.ToString("N0", CultureInfo.CurrentCulture), "Branches", "All active tenant branches", "bi-diagram-3", "bp-kpi-branches"),
        new("premium", TotalPremiumYtd.ToString("C0", CultureInfo.CurrentCulture), "Premium YTD", $"MTD {TotalPremiumMtd.ToString("C0", CultureInfo.CurrentCulture)}", "bi-cash-coin", "bp-kpi-premium"),
        new("policies", TotalPolicies.ToString("N0", CultureInfo.CurrentCulture), "Policies", $"{TotalProducers:N0} active producer(s)", "bi-shield-check", "bp-kpi-policies"),
        new("retention", AverageRetention.ToString("F1", CultureInfo.CurrentCulture) + "%", "Retention", $"{RetentionRiskCount:N0} branch(es) at risk", "bi-heart-pulse", "bp-kpi-retention"),
        new("claims", TotalClaims.ToString("N0", CultureInfo.CurrentCulture), "Claims", $"{ClaimsBranchCount:N0} branch(es) impacted", "bi-exclamation-circle", "bp-kpi-claims"),
        new("ar", TotalAr.ToString("C0", CultureInfo.CurrentCulture), "Outstanding AR", $"{ArBranchCount:N0} branch(es) with AR", "bi-receipt", "bp-kpi-ar")
    ];

    private IReadOnlyList<BranchPerformanceDto> FilteredRows => SortRows(_rows.Where(MatchesFilters)).ToList();
    private IReadOnlyList<BranchPerformanceDto> RetentionRiskRows => _rows.Where(r => r.RetentionRate > 0 && r.RetentionRate < 80).OrderBy(r => r.RetentionRate).ToList();
    private IReadOnlyList<BranchPerformanceDto> ArRows => _rows.Where(r => r.OutstandingAr > 0).OrderByDescending(r => r.OutstandingAr).ToList();
    private IReadOnlyList<BranchPerformanceDto> ClaimRows => _rows.Where(r => r.OpenClaims > 0).OrderByDescending(r => r.OpenClaims).ToList();

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tenant Dashboard", "/tenant/dashboard"), new("Branch Performance", "/tenant/dashboard/branch-performance"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _rows = await Api.GetBranchPerformanceAsync(_tenantId) ?? [];
            _selected = _rows.FirstOrDefault(r => r.BranchId == SelectedId) ?? FilteredRows.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load branch performance: {ex.Message}";
            _rows = [];
            _selected = null;
            ShowToast($"Branch performance load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private void SearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _searchTerm = e.Value?.ToString() ?? string.Empty; _selected = FilteredRows.FirstOrDefault(); }
    private void SortChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _sort = e.Value?.ToString() ?? "premium";
    private void SetView(string view) => _view = view;
    private void SetFilter(string filter) { _activeFilter = _activeFilter == filter && filter != "all" ? "all" : filter; _view = _activeFilter switch { "claims" or "ar" or "retention" => "risk", "premium" or "policies" => "performance", "all" => "overview", _ => _view }; _selected = FilteredRows.FirstOrDefault(); }
    private void ResetFilters() { _activeFilter = "all"; _searchTerm = string.Empty; _sort = "premium"; _view = "overview"; _selected = FilteredRows.FirstOrDefault(); }
    private void SelectBranch(BranchPerformanceDto branch) => _selected = branch;
    private void SelectTopBranch() { if (TopBranch is not null) { _selected = TopBranch; _view = "performance"; } }
    private void GoTo(string url) => Nav.NavigateTo(url);
    private void ShowToast(string message, string kind) { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;

    private bool MatchesFilters(BranchPerformanceDto branch)
    {
        if (!string.IsNullOrWhiteSpace(_searchTerm) && !MatchesSearch(branch.BranchName, branch.BranchCode, branch.City, branch.StateProvince)) return false;
        return _activeFilter switch
        {
            "premium" => branch.WrittenPremiumYtd > 0 || branch.WrittenPremiumMtd > 0,
            "policies" => branch.ActivePolicies > 0,
            "retention" => branch.RetentionRate > 0 && branch.RetentionRate < 80,
            "claims" => branch.OpenClaims > 0,
            "ar" => branch.OutstandingAr > 0,
            _ => true
        };
    }

    private IEnumerable<BranchPerformanceDto> SortRows(IEnumerable<BranchPerformanceDto> rows) => _sort switch
    {
        "retention" => rows.OrderByDescending(r => r.RetentionRate).ThenByDescending(r => r.WrittenPremiumYtd),
        "policies" => rows.OrderByDescending(r => r.ActivePolicies).ThenByDescending(r => r.WrittenPremiumYtd),
        "ar" => rows.OrderByDescending(r => r.OutstandingAr).ThenByDescending(r => r.WrittenPremiumYtd),
        "claims" => rows.OrderByDescending(r => r.OpenClaims).ThenByDescending(r => r.WrittenPremiumYtd),
        _ => rows.OrderByDescending(r => r.WrittenPremiumYtd)
    };

    private RenderFragment BranchRankPanel => @<section class="bp-panel"><h3><i class="bi bi-bar-chart-line" aria-hidden="true"></i> Premium distribution</h3><div class="bp-rank-stack">@foreach (var branch in _rows.OrderByDescending(r => r.WrittenPremiumYtd).Take(8)) { <button type="button" class="bp-rank-row" @onclick="@(() => SelectBranch(branch))"><span>@branch.BranchName</span><div><i style="width:@WidthPct(branch.WrittenPremiumYtd, TopBranch?.WrittenPremiumYtd ?? 0)"></i></div><strong>@branch.WrittenPremiumYtd.ToString("C0", CultureInfo.CurrentCulture)</strong><small>@ShareLabel(branch.WrittenPremiumYtd, TotalPremiumYtd)</small></button> }</div></section>;
    private RenderFragment BranchCard(BranchPerformanceDto branch) => @<article class="@BranchCardClass(branch)" @onclick="@(() => SelectBranch(branch))"><div class="bp-branch-top"><span class="bp-branch-avatar">@Initials(branch.BranchName)</span><div><strong>@branch.BranchName</strong><small>@Location(branch)</small></div><button type="button" class="bp-card-open" title="Inspect branch" @onclick="@(() => SelectBranch(branch))" @onclick:stopPropagation="true"><i class="bi bi-search" aria-hidden="true"></i></button></div><div class="bp-branch-metrics"><div><span>Premium YTD</span><strong>@branch.WrittenPremiumYtd.ToString("C0", CultureInfo.CurrentCulture)</strong></div><div><span>Policies</span><strong>@branch.ActivePolicies.ToString("N0", CultureInfo.CurrentCulture)</strong></div><div><span>Producers</span><strong>@branch.ActiveProducers.ToString("N0", CultureInfo.CurrentCulture)</strong></div><div><span>Retention</span><strong>@branch.RetentionRate.ToString("F1", CultureInfo.CurrentCulture)%</strong></div></div><div class="bp-branch-foot"><span class="bp-badge @RetentionTone(branch.RetentionRate)">@RetentionLabel(branch.RetentionRate)</span><span>@branch.OpenLeads.ToString("N0", CultureInfo.CurrentCulture) leads</span><span>@branch.OutstandingAr.ToString("C0", CultureInfo.CurrentCulture) AR</span></div></article>;
    private RenderFragment RiskPanel(string title, IReadOnlyList<BranchPerformanceDto> rows, string caption, string icon, string tone) => @<section class="bp-risk-panel @tone"><h3><i class="bi @icon" aria-hidden="true"></i> @title</h3><p>@caption</p>@if (rows.Count == 0) { <div class="bp-mini-empty">No branches in this risk bucket.</div> } else { <div class="bp-risk-list">@foreach (var branch in rows.Take(6)) { <button type="button" @onclick="@(() => SelectBranch(branch))"><span><strong>@branch.BranchName</strong><small>@Location(branch)</small></span><em>@RiskValue(title, branch)</em></button> }</div> }</section>;

    private string MetricCardClass(BranchMetric metric) => $"bp-kpi-card {metric.Tone} {(metric.Filter == _activeFilter ? "bp-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewOption view) => $"bp-view-btn {(view.Id == _view ? "bp-view-btn-active" : string.Empty)}";
    private string BranchCardClass(BranchPerformanceDto branch) => $"bp-branch-card {(SelectedId == branch.BranchId ? "bp-branch-card-selected" : string.Empty)}";
    private int ViewCount(string view) => view switch { "performance" => FilteredRows.Count, "risk" => RetentionRiskCount + ClaimsBranchCount + ArBranchCount, "table" => FilteredRows.Count, _ => _rows.Count };
    private bool MatchesSearch(params string?[] values) => values.Any(v => !string.IsNullOrWhiteSpace(v) && v.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
    private static string DisplayCode(string? value) => string.IsNullOrWhiteSpace(value) ? "?" : value;
    private static string Location(BranchPerformanceDto branch) => string.IsNullOrWhiteSpace(branch.City) && string.IsNullOrWhiteSpace(branch.StateProvince) ? "Location not set" : string.Join(", ", new[] { branch.City, branch.StateProvince }.Where(v => !string.IsNullOrWhiteSpace(v)));
    private static string RetentionTone(decimal value) => value >= 85 ? "bp-badge-success" : value >= 70 ? "bp-badge-warning" : "bp-badge-danger";
    private static string RetentionLabel(decimal value) => value >= 85 ? "Healthy retention" : value >= 70 ? "Watch retention" : "Retention risk";
    private static string ShareLabel(decimal value, decimal total) => total <= 0 ? "0%" : (value / total * 100).ToString("F1", CultureInfo.CurrentCulture) + "%";
    private static string WidthPct(decimal value, decimal max) => (max <= 0 ? 4 : Math.Max(4, Math.Min(100, (double)(value / max * 100)))).ToString("F1", CultureInfo.InvariantCulture) + "%";
    private static string RiskValue(string title, BranchPerformanceDto branch) => title switch { "Retention risk" => branch.RetentionRate.ToString("F1", CultureInfo.CurrentCulture) + "%", "Receivables exposure" => branch.OutstandingAr.ToString("C0", CultureInfo.CurrentCulture), _ => branch.OpenClaims.ToString("N0", CultureInfo.CurrentCulture) };
    private static string Initials(string value) => string.Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));

    private sealed record ViewOption(string Id, string Label, string Icon);
    private sealed record BranchMetric(string Filter, string Value, string Label, string Caption, string Icon, string Tone);
}
