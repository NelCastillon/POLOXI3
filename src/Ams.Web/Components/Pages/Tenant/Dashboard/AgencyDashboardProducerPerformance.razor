@page "/tenant/dashboard/producer-performance"
@namespace Ams.Web.Components.Pages.Tenant.Dashboard
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Producer Performance — Agency Dashboard</PageTitle>

<AppPageHeader Title="Producer Performance"
               Subtitle="Top producers by written premium, conversion rate and pipeline activity"
               Icon="bi-person-badge">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "ad-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
    </Actions>
</AppPageHeader>

@if (_loading)
{
    <div class="ad-loading-banner" aria-live="polite">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading producer data…</span>
    </div>
}
else if (_rows is null || _rows.Count == 0)
{
    <div class="ad-empty"><i class="bi bi-person-badge" aria-hidden="true"></i><span>No producer data available.</span></div>
}
else
{
    <!-- ── Summary strip ──────────────────────────────────────── -->
    <div class="ad-kpi-strip">
        <div class="ad-kpi-card ad-kpi--branches">
            <div class="ad-kpi-icon"><i class="bi bi-people" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_rows.Count</div>
                <div class="ad-kpi-lbl">Active Producers</div>
            </div>
        </div>
        <div class="ad-kpi-card ad-kpi--premium">
            <div class="ad-kpi-icon"><i class="bi bi-cash-coin" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_rows.Sum(r => r.WrittenPremiumMtd).ToString("C0")</div>
                <div class="ad-kpi-lbl">Total Written MTD</div>
            </div>
        </div>
        <div class="ad-kpi-card ad-kpi--leads">
            <div class="ad-kpi-icon"><i class="bi bi-person-plus" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_rows.Sum(r => r.OpenLeads)</div>
                <div class="ad-kpi-lbl">Total Open Leads</div>
            </div>
        </div>
        <div class="ad-kpi-card ad-kpi--policies">
            <div class="ad-kpi-icon"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_rows.Sum(r => r.QuotesMtd)</div>
                <div class="ad-kpi-lbl">Quotes MTD</div>
            </div>
        </div>
    </div>

    <!-- ── Leaderboard table ─────────────────────────────────── -->
    <div class="ad-card">
        <div class="ad-card-hd"><i class="bi bi-trophy" aria-hidden="true"></i> Producer Leaderboard</div>
        <div class="ad-table-wrap">
            <table class="ad-table">
                <thead>
                    <tr>
                        <th style="width:2rem">#</th>
                        <th>Producer</th>
                        <th>Branch</th>
                        <th class="ad-num">Premium MTD</th>
                        <th class="ad-num">Premium YTD</th>
                        <th class="ad-num">New Policies</th>
                        <th class="ad-num">Open Leads</th>
                        <th class="ad-num">Open Opps</th>
                        <th class="ad-num">Quotes MTD</th>
                        <th class="ad-num">Quote Conv.</th>
                        <th class="ad-num">Retention</th>
                    </tr>
                </thead>
                <tbody>
                    @{int rank = 0;}
                    @foreach (var p in _rows.OrderByDescending(r => r.WrittenPremiumYtd))
                    {
                        rank++;
                        var initials = string.Concat(p.DisplayName.Split(' ').Select(w => w.Length > 0 ? w[0].ToString() : "")).ToUpper();
                        <tr>
                            <td style="color:#9ca3af;font-weight:600;font-size:.8rem">
                                @if (rank == 1) { <i class="bi bi-trophy-fill" style="color:#f59e0b" aria-hidden="true"></i> }
                                else if (rank == 2) { <i class="bi bi-trophy-fill" style="color:#9ca3af" aria-hidden="true"></i> }
                                else if (rank == 3) { <i class="bi bi-trophy-fill" style="color:#b45309" aria-hidden="true"></i> }
                                else { @rank }
                            </td>
                            <td>
                                <div class="ad-prod-cell">
                                    <div class="ad-avatar">@initials</div>
                                    <div>
                                        <div class="ad-prod-name">@p.DisplayName</div>
                                        @if (!string.IsNullOrEmpty(p.Email))
                                        {
                                            <div class="ad-prod-sub">@p.Email</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td style="font-size:.8rem;color:#6b7280">@(p.BranchName ?? "—")</td>
                            <td class="ad-num">@p.WrittenPremiumMtd.ToString("C0")</td>
                            <td class="ad-num" style="font-weight:600">@p.WrittenPremiumYtd.ToString("C0")</td>
                            <td class="ad-num">@p.NewPoliciesMtd</td>
                            <td class="ad-num">@p.OpenLeads</td>
                            <td class="ad-num">@p.OpenOpportunities</td>
                            <td class="ad-num">@p.QuotesMtd</td>
                            <td class="ad-num">
                                <span class="ad-badge @(p.QuoteConversionRate >= 40 ? "ad-badge--closed" : p.QuoteConversionRate >= 20 ? "ad-badge--pending" : "ad-badge--overdue")">
                                    @p.QuoteConversionRate.ToString("F1")%
                                </span>
                            </td>
                            <td class="ad-num">@p.RetentionRate.ToString("F1")%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private List<ProducerPerformanceDto>? _rows;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Agency Dashboard", "/tenant/dashboard"), new("Producer Performance"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try { _rows = await Api.GetProducerPerformanceAsync(_tenantId); }
        finally { _loading = false; }
    }
}
