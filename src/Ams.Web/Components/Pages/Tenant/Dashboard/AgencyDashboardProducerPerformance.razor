@page "/tenant/dashboard/producer-performance"
@namespace Ams.Web.Components.Pages.Tenant.Dashboard
@using System.Globalization
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Enterprise Producer Performance ? AMS</PageTitle>

@if (_toastVisible)
{
    <div class="pp-toast pp-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="pp-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="pp-enterprise-page">
    <section class="pp-hero">
        <div class="pp-hero-left">
            <span class="pp-hero-icon"><i class="bi bi-person-badge-fill" aria-hidden="true"></i></span>
            <div>
                <div class="pp-title-row">
                    <h1>Producer Performance Command Center</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live producer data</span>
                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> Tenant scoped</span>
                    <span><i class="bi bi-trophy" aria-hidden="true"></i> Leaderboard governed</span>
                </div>
                <p>Rank producers by premium, policies, pipeline, quotes, conversion, and retention while surfacing coaching priorities and producer productivity actions.</p>
            </div>
        </div>
        <div class="pp-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh producer performance"><i class="bi @(_loading ? "bi-arrow-repeat pp-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/tenant/dashboard")'><i class="bi bi-speedometer2" aria-hidden="true"></i> Dashboard</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/tenant/dashboard/branch-performance")'><i class="bi bi-diagram-3" aria-hidden="true"></i> Branches</button>
            <button type="button" class="um-btn um-btn-primary" @onclick='() => GoTo("/crm/leads")'><i class="bi bi-person-plus" aria-hidden="true"></i> Leads</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger pp-error-banner" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError</div>
    }

    @if (_loading)
    {
        <section class="pp-loading-state"><i class="bi bi-arrow-repeat pp-spin" aria-hidden="true"></i><strong>Loading enterprise producer performance...</strong><span>Syncing premium, policy, lead, opportunity, quote, conversion, and retention metrics.</span></section>
    }
    else if (_rows.Count == 0)
    {
        <section class="pp-empty-state"><i class="bi bi-person-badge" aria-hidden="true"></i><strong>No producer data available</strong><span>Sync tenant activity or confirm active producers are assigned to production workflows.</span><button type="button" class="um-btn um-btn-primary" @onclick="LoadAsync">Retry sync</button></section>
    }
    else
    {
        <section class="pp-kpi-strip" aria-label="Producer KPI filters">
            @foreach (var metric in Metrics)
            {
                <button type="button" class="@MetricCardClass(metric)" title="@metric.Caption" @onclick="@(() => SetFilter(metric.Filter))">
                    <span class="pp-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                    <span><span class="pp-kpi-val">@metric.Value</span><span class="pp-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
                </button>
            }
        </section>

        <section class="pp-workflow-strip" aria-label="Producer workflow actions">
            <button type="button" class="pp-workflow-card" @onclick='() => SetView("leaderboard")'><i class="bi bi-trophy" aria-hidden="true"></i><span><strong>Rank producers</strong><span>Compare premium and productivity.</span></span></button>
            <button type="button" class="pp-workflow-card" @onclick='() => SetFilter("pipeline")'><i class="bi bi-funnel" aria-hidden="true"></i><span><strong>Coach pipeline</strong><span>Focus open leads and opportunities.</span></span></button>
            <button type="button" class="pp-workflow-card" @onclick='() => SetFilter("quotes")'><i class="bi bi-file-earmark-check" aria-hidden="true"></i><span><strong>Improve quotes</strong><span>Review quote volume and conversion.</span></span></button>
            <button type="button" class="pp-workflow-card pp-workflow-danger" @onclick='() => SetView("coaching")'><i class="bi bi-lightbulb" aria-hidden="true"></i><span><strong>Coaching queue</strong><span>Prioritize producer watch items.</span></span></button>
        </section>

        <section class="pp-filter-panel">
            <div class="pp-search-wrap">
                <span class="pp-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                <div class="pp-search-body">
                    <label for="producerSearchInput">Search producers</label>
                    <input id="producerSearchInput" class="pp-search-input" value="@_searchTerm" @oninput="SearchChangedCallback" placeholder="Search producer, email, or branch..." />
                    <span>Filters producer dashboard data immediately.</span>
                </div>
            </div>
            <label class="pp-sort-field">Sort by
                <select class="pp-filter-select" value="@_sort" @onchange="SortChangedCallback">
                    <option value="premium">Premium YTD</option>
                    <option value="mtd">Premium MTD</option>
                    <option value="conversion">Quote conversion</option>
                    <option value="pipeline">Pipeline</option>
                    <option value="retention">Retention</option>
                </select>
            </label>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-cloud-arrow-down" aria-hidden="true"></i> Sync</button>
            <div class="pp-filter-result"><strong>@FilteredRows.Count.ToString("N0", CultureInfo.CurrentCulture)</strong><span>shown</span></div>
        </section>

        <section class="pp-view-tabs" aria-label="Producer performance views">
            @foreach (var view in _views)
            {
                <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label <span>@ViewCount(view.Id)</span></button>
            }
        </section>

        <section class="pp-content-layout">
            <main class="pp-main-card">
                @if (_view == "overview")
                {
                    <div class="pp-section-head"><div><h2>Executive producer overview</h2><p>Top producer signals by revenue, pipeline activity, quote conversion, and retention quality.</p></div><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => SetView("table")'><i class="bi bi-table" aria-hidden="true"></i> Table View</button></div>
                    <div class="pp-overview-grid">
                        <section class="pp-spotlight-card"><span><i class="bi bi-trophy" aria-hidden="true"></i> Top producer</span><strong>@(TopProducer?.DisplayName ?? "?")</strong><p>@((TopProducer?.WrittenPremiumYtd ?? 0).ToString("C0", CultureInfo.CurrentCulture)) YTD premium with @((TopProducer?.NewPoliciesMtd ?? 0).ToString("N0", CultureInfo.CurrentCulture)) new policies this month.</p><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="SelectTopProducer">Inspect producer</button></section>
                        <section class="pp-guidance-card"><h3><i class="bi bi-stars" aria-hidden="true"></i> Producer guidance</h3><p>@GuidanceText</p><div class="pp-guidance-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("pipeline")'>Pipeline</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("quotes")'>Quotes</button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => SetFilter("retention")'>Retention</button></div></section>
                    </div>
                    @ProducerRankPanel
                }
                else if (_view == "leaderboard")
                {
                    <div class="pp-section-head"><div><h2>Producer leaderboard</h2><p>Premium, policies, pipeline, quotes, conversion, and retention ranked by producer.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => GoTo("/tenant/dashboard/kpis-performance")'>KPI Detail</button></div>
                    <div class="pp-producer-card-grid">
                        @foreach (var producer in FilteredRows)
                        {
                            @ProducerCard(producer)
                        }
                    </div>
                }
                else if (_view == "coaching")
                {
                    <div class="pp-section-head"><div><h2>Coaching and action queue</h2><p>Producer watchlists for pipeline, quote conversion, and retention coaching.</p></div><button type="button" class="um-btn um-btn-danger um-btn-sm" @onclick='() => GoTo("/crm/leads")'>Open Leads</button></div>
                    <div class="pp-coaching-grid">
                        @CoachingPanel("Pipeline coaching", PipelineRows, "Open leads and opportunities requiring producer follow-up", "bi-funnel", "pp-tone-amber")
                        @CoachingPanel("Quote coaching", QuoteWatchRows, "Quote volume with conversion below target", "bi-file-earmark-check", "pp-tone-purple")
                        @CoachingPanel("Retention coaching", RetentionWatchRows, "Retention below enterprise target", "bi-arrow-repeat", "pp-tone-red")
                    </div>
                }
                else
                {
                    <div class="pp-section-head"><div><h2>Producer operating table</h2><p>Complete producer performance synchronized from the agency dashboard API.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ResetFilters">Reset</button></div>
                    <div class="pp-table-wrap">
                        <table class="pp-table">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>Producer</th>
                                    <th>Branch</th>
                                    <th class="pp-num">Premium MTD</th>
                                    <th class="pp-num">Premium YTD</th>
                                    <th class="pp-num">New Policies</th>
                                    <th class="pp-num">Leads</th>
                                    <th class="pp-num">Opps</th>
                                    <th class="pp-num">Quotes</th>
                                    <th class="pp-num">Quote Conv.</th>
                                    <th class="pp-num">Retention</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var rank = 0; }
                                @foreach (var producer in FilteredRows)
                                {
                                    rank++;
                                    <tr class="@(SelectedId == producer.UserId ? "pp-row-selected" : string.Empty)" @onclick="@(() => SelectProducer(producer))">
                                        <td>@RankLabel(rank)</td>
                                        <td><div class="pp-prod-cell"><span class="pp-avatar">@Initials(producer.DisplayName)</span><span><strong>@producer.DisplayName</strong><small>@DisplayCode(producer.Email)</small></span></div></td>
                                        <td>@DisplayCode(producer.BranchName)</td>
                                        <td class="pp-num">@producer.WrittenPremiumMtd.ToString("C0", CultureInfo.CurrentCulture)</td>
                                        <td class="pp-num"><strong>@producer.WrittenPremiumYtd.ToString("C0", CultureInfo.CurrentCulture)</strong></td>
                                        <td class="pp-num">@producer.NewPoliciesMtd.ToString("N0", CultureInfo.CurrentCulture)</td>
                                        <td class="pp-num">@producer.OpenLeads.ToString("N0", CultureInfo.CurrentCulture)</td>
                                        <td class="pp-num">@producer.OpenOpportunities.ToString("N0", CultureInfo.CurrentCulture)</td>
                                        <td class="pp-num">@producer.QuotesMtd.ToString("N0", CultureInfo.CurrentCulture)</td>
                                        <td class="pp-num"><span class="pp-badge @ConversionTone(producer.QuoteConversionRate)">@producer.QuoteConversionRate.ToString("F1", CultureInfo.CurrentCulture)%</span></td>
                                        <td class="pp-num"><span class="pp-badge @RetentionTone(producer.RetentionRate)">@producer.RetentionRate.ToString("F1", CultureInfo.CurrentCulture)%</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </main>

            <aside class="pp-detail-panel">
                @if (_selected is null)
                {
                    <div class="pp-detail-empty"><i class="bi bi-person-badge" aria-hidden="true"></i><strong>Select a producer</strong><span>Choose a producer to inspect premium, policy flow, pipeline, quote conversion, retention, and coaching actions.</span></div>
                }
                else
                {
                    <div class="pp-detail-head"><div><span><i class="bi bi-person" aria-hidden="true"></i> Producer detail</span><h2>@_selected.DisplayName</h2><p>@DisplayCode(_selected.Email) ? @DisplayCode(_selected.BranchName)</p></div><span class="pp-badge @ConversionTone(_selected.QuoteConversionRate)">@_selected.QuoteConversionRate.ToString("F1", CultureInfo.CurrentCulture)% quote</span></div>
                    <div class="pp-detail-summary">
                        <div><span>Premium YTD</span><strong>@_selected.WrittenPremiumYtd.ToString("C0", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Premium MTD</span><strong>@_selected.WrittenPremiumMtd.ToString("C0", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>New policies</span><strong>@_selected.NewPoliciesMtd.ToString("N0", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Open leads</span><strong>@_selected.OpenLeads.ToString("N0", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Open opps</span><strong>@_selected.OpenOpportunities.ToString("N0", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Quotes MTD</span><strong>@_selected.QuotesMtd.ToString("N0", CultureInfo.CurrentCulture)</strong></div>
                        <div><span>Retention</span><strong>@_selected.RetentionRate.ToString("F1", CultureInfo.CurrentCulture)%</strong></div>
                        <div><span>Premium share</span><strong>@ShareLabel(_selected.WrittenPremiumYtd, TotalPremiumYtd)</strong></div>
                    </div>
                    <div class="pp-detail-actions">
                        <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/crm/leads")'><i class="bi bi-person-plus" aria-hidden="true"></i> Leads</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/crm/opportunities")'><i class="bi bi-kanban" aria-hidden="true"></i> Opportunities</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/crm/quotes")'><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Quotes</button>
                        <button type="button" class="um-btn um-btn-primary" @onclick='() => GoTo("/tenant/dashboard/renewal-pipeline")'><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Renewals</button>
                    </div>
                }
            </aside>
        </section>
    }
</div>

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private List<ProducerPerformanceDto> _rows = [];
    private ProducerPerformanceDto? _selected;
    private bool _loading = true;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string _activeFilter = "all";
    private string _view = "overview";
    private string _searchTerm = string.Empty;
    private string _sort = "premium";

    private Microsoft.AspNetCore.Components.EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> SearchChangedCallback => Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, SearchChanged);
    private Microsoft.AspNetCore.Components.EventCallback<Microsoft.AspNetCore.Components.ChangeEventArgs> SortChangedCallback => Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, SortChanged);
    private Guid? SelectedId => _selected?.UserId;
    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", _ => "bi-check-circle-fill" };
    private decimal TotalPremiumYtd => _rows.Sum(r => r.WrittenPremiumYtd);
    private decimal TotalPremiumMtd => _rows.Sum(r => r.WrittenPremiumMtd);
    private int TotalNewPolicies => _rows.Sum(r => r.NewPoliciesMtd);
    private int TotalLeads => _rows.Sum(r => r.OpenLeads);
    private int TotalOpportunities => _rows.Sum(r => r.OpenOpportunities);
    private int TotalQuotes => _rows.Sum(r => r.QuotesMtd);
    private decimal AverageQuoteConversion => _rows.Count == 0 ? 0 : _rows.Average(r => r.QuoteConversionRate);
    private decimal AverageRetention => _rows.Count == 0 ? 0 : _rows.Average(r => r.RetentionRate);
    private int PipelineProducerCount => _rows.Count(r => r.OpenLeads > 0 || r.OpenOpportunities > 0);
    private int QuoteWatchCount => _rows.Count(r => r.QuotesMtd > 0 && r.QuoteConversionRate < 20);
    private int RetentionWatchCount => _rows.Count(r => r.RetentionRate > 0 && r.RetentionRate < 80);
    private ProducerPerformanceDto? TopProducer => _rows.OrderByDescending(r => r.WrittenPremiumYtd).FirstOrDefault();
    private string GuidanceText => QuoteWatchCount > 0 ? $"{QuoteWatchCount} producer(s) have quote conversion below 20%. Prioritize quote coaching and follow-up quality." : RetentionWatchCount > 0 ? $"{RetentionWatchCount} producer(s) are below the 80% retention watch threshold. Review renewal strategy and client service cadence." : PipelineProducerCount > 0 ? $"{PipelineProducerCount} producer(s) have active pipeline. Monitor follow-up activity and opportunity velocity." : "Producer performance is stable. Continue monitoring premium production, quote conversion, and retention quality.";

    private readonly ViewOption[] _views = [new("overview", "Overview", "bi-speedometer2"), new("leaderboard", "Leaderboard", "bi-trophy"), new("coaching", "Coaching", "bi-lightbulb"), new("table", "Table", "bi-table")];

    private IReadOnlyList<ProducerMetric> Metrics =>
    [
        new("all", _rows.Count.ToString("N0", CultureInfo.CurrentCulture), "Producers", "All active producers", "bi-people", "pp-kpi-producers"),
        new("premium", TotalPremiumYtd.ToString("C0", CultureInfo.CurrentCulture), "Premium YTD", $"MTD {TotalPremiumMtd.ToString("C0", CultureInfo.CurrentCulture)}", "bi-cash-coin", "pp-kpi-premium"),
        new("policies", TotalNewPolicies.ToString("N0", CultureInfo.CurrentCulture), "New Policies", "Policies created MTD", "bi-shield-check", "pp-kpi-policies"),
        new("pipeline", (TotalLeads + TotalOpportunities).ToString("N0", CultureInfo.CurrentCulture), "Pipeline", $"{TotalLeads:N0} leads ? {TotalOpportunities:N0} opps", "bi-funnel", "pp-kpi-pipeline"),
        new("quotes", TotalQuotes.ToString("N0", CultureInfo.CurrentCulture), "Quotes MTD", $"{AverageQuoteConversion:F1}% avg conversion", "bi-file-earmark-check", "pp-kpi-quotes"),
        new("retention", AverageRetention.ToString("F1", CultureInfo.CurrentCulture) + "%", "Retention", $"{RetentionWatchCount:N0} watch item(s)", "bi-arrow-repeat", "pp-kpi-retention")
    ];

    private IReadOnlyList<ProducerPerformanceDto> FilteredRows => SortRows(_rows.Where(MatchesFilters)).ToList();
    private IReadOnlyList<ProducerPerformanceDto> PipelineRows => _rows.Where(r => r.OpenLeads > 0 || r.OpenOpportunities > 0).OrderByDescending(r => r.OpenLeads + r.OpenOpportunities).ToList();
    private IReadOnlyList<ProducerPerformanceDto> QuoteWatchRows => _rows.Where(r => r.QuotesMtd > 0 && r.QuoteConversionRate < 20).OrderBy(r => r.QuoteConversionRate).ThenByDescending(r => r.QuotesMtd).ToList();
    private IReadOnlyList<ProducerPerformanceDto> RetentionWatchRows => _rows.Where(r => r.RetentionRate > 0 && r.RetentionRate < 80).OrderBy(r => r.RetentionRate).ToList();

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tenant Dashboard", "/tenant/dashboard"), new("Producer Performance", "/tenant/dashboard/producer-performance"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _rows = await Api.GetProducerPerformanceAsync(_tenantId) ?? [];
            _selected = _rows.FirstOrDefault(r => r.UserId == SelectedId) ?? FilteredRows.FirstOrDefault();
            ShowToast("Producer performance synced successfully.", "success");
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load producer performance: {ex.Message}";
            _rows = [];
            _selected = null;
            ShowToast($"Producer performance load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private void SearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _searchTerm = e.Value?.ToString() ?? string.Empty; _selected = FilteredRows.FirstOrDefault(); }
    private void SortChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _sort = e.Value?.ToString() ?? "premium";
    private void SetView(string view) => _view = view;
    private void SetFilter(string filter) { _activeFilter = _activeFilter == filter && filter != "all" ? "all" : filter; _view = filter is "pipeline" or "quotes" or "retention" ? "coaching" : _view; _selected = FilteredRows.FirstOrDefault(); }
    private void ResetFilters() { _activeFilter = "all"; _searchTerm = string.Empty; _sort = "premium"; _view = "overview"; _selected = FilteredRows.FirstOrDefault(); }
    private void SelectProducer(ProducerPerformanceDto producer) => _selected = producer;
    private void SelectTopProducer() { if (TopProducer is not null) { _selected = TopProducer; _view = "leaderboard"; } }
    private void GoTo(string url) => Nav.NavigateTo(url);
    private void ShowToast(string message, string kind) { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;

    private bool MatchesFilters(ProducerPerformanceDto producer)
    {
        if (!string.IsNullOrWhiteSpace(_searchTerm) && !MatchesSearch(producer.DisplayName, producer.Email, producer.BranchName)) return false;
        return _activeFilter switch
        {
            "premium" => producer.WrittenPremiumYtd > 0 || producer.WrittenPremiumMtd > 0,
            "policies" => producer.NewPoliciesMtd > 0,
            "pipeline" => producer.OpenLeads > 0 || producer.OpenOpportunities > 0,
            "quotes" => producer.QuotesMtd > 0,
            "retention" => producer.RetentionRate > 0 && producer.RetentionRate < 80,
            _ => true
        };
    }

    private IEnumerable<ProducerPerformanceDto> SortRows(IEnumerable<ProducerPerformanceDto> rows) => _sort switch
    {
        "mtd" => rows.OrderByDescending(r => r.WrittenPremiumMtd).ThenByDescending(r => r.WrittenPremiumYtd),
        "conversion" => rows.OrderByDescending(r => r.QuoteConversionRate).ThenByDescending(r => r.QuotesMtd),
        "pipeline" => rows.OrderByDescending(r => r.OpenLeads + r.OpenOpportunities).ThenByDescending(r => r.WrittenPremiumYtd),
        "retention" => rows.OrderByDescending(r => r.RetentionRate).ThenByDescending(r => r.WrittenPremiumYtd),
        _ => rows.OrderByDescending(r => r.WrittenPremiumYtd)
    };

    private RenderFragment ProducerRankPanel => @<section class="pp-panel"><h3><i class="bi bi-bar-chart-line" aria-hidden="true"></i> Premium distribution</h3><div class="pp-rank-stack">@foreach (var producer in _rows.OrderByDescending(r => r.WrittenPremiumYtd).Take(8)) { <button type="button" class="pp-rank-row" @onclick="@(() => SelectProducer(producer))"><span>@producer.DisplayName</span><div><i style="width:@WidthPct(producer.WrittenPremiumYtd, TopProducer?.WrittenPremiumYtd ?? 0)"></i></div><strong>@producer.WrittenPremiumYtd.ToString("C0", CultureInfo.CurrentCulture)</strong><small>@ShareLabel(producer.WrittenPremiumYtd, TotalPremiumYtd)</small></button> }</div></section>;
    private RenderFragment ProducerCard(ProducerPerformanceDto producer) => @<article class="@ProducerCardClass(producer)" @onclick="@(() => SelectProducer(producer))"><div class="pp-producer-top"><span class="pp-avatar">@Initials(producer.DisplayName)</span><div><strong>@producer.DisplayName</strong><small>@DisplayCode(producer.BranchName)</small></div><button type="button" class="pp-card-open" title="Inspect producer" @onclick="@(() => SelectProducer(producer))" @onclick:stopPropagation="true">?</button></div><div class="pp-producer-metrics"><div><span>Premium YTD</span><strong>@producer.WrittenPremiumYtd.ToString("C0", CultureInfo.CurrentCulture)</strong></div><div><span>Policies</span><strong>@producer.NewPoliciesMtd.ToString("N0", CultureInfo.CurrentCulture)</strong></div><div><span>Pipeline</span><strong>@((producer.OpenLeads + producer.OpenOpportunities).ToString("N0", CultureInfo.CurrentCulture))</strong></div><div><span>Quote Conv.</span><strong>@producer.QuoteConversionRate.ToString("F1", CultureInfo.CurrentCulture)%</strong></div></div><div class="pp-producer-foot"><span class="pp-badge @ConversionTone(producer.QuoteConversionRate)">@ConversionLabel(producer.QuoteConversionRate)</span><span>@producer.QuotesMtd.ToString("N0", CultureInfo.CurrentCulture) quotes</span><span>@producer.RetentionRate.ToString("F1", CultureInfo.CurrentCulture)% retention</span></div></article>;
    private RenderFragment CoachingPanel(string title, IReadOnlyList<ProducerPerformanceDto> rows, string caption, string icon, string tone) => @<section class="pp-coaching-panel @tone"><h3><i class="bi @icon" aria-hidden="true"></i> @title</h3><p>@caption</p>@if (rows.Count == 0) { <div class="pp-mini-empty">No producers in this coaching bucket.</div> } else { <div class="pp-coaching-list">@foreach (var producer in rows.Take(6)) { <button type="button" @onclick="@(() => SelectProducer(producer))"><span><strong>@producer.DisplayName</strong><small>@DisplayCode(producer.BranchName)</small></span><em>@CoachingValue(title, producer)</em></button> }</div> }</section>;

    private string MetricCardClass(ProducerMetric metric) => $"pp-kpi-card {metric.Tone} {(metric.Filter == _activeFilter ? "pp-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewOption view) => $"pp-view-btn {(view.Id == _view ? "pp-view-btn-active" : string.Empty)}";
    private string ProducerCardClass(ProducerPerformanceDto producer) => $"pp-producer-card {(SelectedId == producer.UserId ? "pp-producer-card-selected" : string.Empty)}";
    private int ViewCount(string view) => view switch { "coaching" => PipelineProducerCount + QuoteWatchCount + RetentionWatchCount, "table" => FilteredRows.Count, _ => _rows.Count };
    private bool MatchesSearch(params string?[] values) => values.Any(v => !string.IsNullOrWhiteSpace(v) && v.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
    private static string DisplayCode(string? value) => string.IsNullOrWhiteSpace(value) ? "?" : value;
    private static string ConversionTone(decimal value) => value >= 40 ? "pp-badge-success" : value >= 20 ? "pp-badge-warning" : "pp-badge-danger";
    private static string RetentionTone(decimal value) => value >= 85 ? "pp-badge-success" : value >= 70 ? "pp-badge-warning" : "pp-badge-danger";
    private static string ConversionLabel(decimal value) => value >= 40 ? "Strong conversion" : value >= 20 ? "Conversion watch" : "Coaching needed";
    private static string ShareLabel(decimal value, decimal total) => total <= 0 ? "0%" : (value / total * 100).ToString("F1", CultureInfo.CurrentCulture) + "%";
    private static string WidthPct(decimal value, decimal max) => (max <= 0 ? 4 : Math.Max(4, Math.Min(100, (double)(value / max * 100)))).ToString("F1", CultureInfo.InvariantCulture) + "%";
    private static string CoachingValue(string title, ProducerPerformanceDto producer) => title switch { "Pipeline coaching" => (producer.OpenLeads + producer.OpenOpportunities).ToString("N0", CultureInfo.CurrentCulture), "Quote coaching" => producer.QuoteConversionRate.ToString("F1", CultureInfo.CurrentCulture) + "%", _ => producer.RetentionRate.ToString("F1", CultureInfo.CurrentCulture) + "%" };
    private static string Initials(string value) => string.Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
    private static string RankLabel(int rank) => rank switch { 1 => "??", 2 => "??", 3 => "??", _ => rank.ToString(CultureInfo.CurrentCulture) };

    private sealed record ViewOption(string Id, string Label, string Icon);
    private sealed record ProducerMetric(string Filter, string Value, string Label, string Caption, string Icon, string Tone);
}
