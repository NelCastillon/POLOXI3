@page "/tenant/dashboard/claims-summary"
@namespace Ams.Web.Components.Pages.Tenant.Dashboard
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Claims Summary — Agency Dashboard</PageTitle>

<AppPageHeader Title="Claims Summary"
               Subtitle="Open claims, reserves, payouts, litigation and frequency by line of business"
               Icon="bi-exclamation-circle">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "ad-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
        <a class="um-btn um-btn-ghost" href="/claims">
            <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Claims Register
        </a>
    </Actions>
</AppPageHeader>

@if (_loading)
{
    <div class="ad-loading-banner" aria-live="polite">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading claims data…</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger ad-alert-danger" role="alert"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i> @_loadError</div>
}
else if (_data is null)
{
    <div class="ad-empty"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>No claims data available.</span></div>
}
else
{
    <!-- ── KPI strip ───────────────────────────────────────────── -->
    <div class="ad-kpi-strip">
        <button type="button" class="ad-kpi-card ad-kpi--claims @KpiClass("open")" @onclick='() => SetFilter("open")' title="Show open claim statuses">
            <div class="ad-kpi-icon"><i class="bi bi-exclamation-circle" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_data.TotalOpenClaims</div>
                <div class="ad-kpi-lbl">Open Claims</div>
                <div class="ad-kpi-sub">+@_data.NewClaimsMtd new MTD</div>
            </div>
        </button>
        <button type="button" class="ad-kpi-card ad-kpi--premium @KpiClass("reserved")" @onclick='() => SetFilter("reserved")' title="Show statuses with reserves">
            <div class="ad-kpi-icon"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_data.TotalReservedAmount.ToString("C0")</div>
                <div class="ad-kpi-lbl">Total Reserves</div>
            </div>
        </button>
        <button type="button" class="ad-kpi-card ad-kpi--ar @KpiClass("paid")" @onclick='() => SetFilter("paid")' title="Show line of business summary">
            <div class="ad-kpi-icon"><i class="bi bi-cash-coin" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_data.TotalPaidMtd.ToString("C0")</div>
                <div class="ad-kpi-lbl">Paid MTD</div>
                <div class="ad-kpi-sub">@_data.ClosedClaimsMtd closed MTD</div>
            </div>
        </button>
        <button type="button" class="ad-kpi-card @(_data.LitigatedClaims > 0 ? "ad-kpi--claims" : "ad-kpi--policies") @KpiClass("litigated")" @onclick='() => SetFilter("litigated")' title="Show litigation-sensitive claims metrics">
            <div class="ad-kpi-icon"><i class="bi bi-briefcase" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_data.LitigatedClaims</div>
                <div class="ad-kpi-lbl">Litigated Claims</div>
                <div class="ad-kpi-sub">Avg close @_data.AvgDaysToClose.ToString("F0") days</div>
            </div>
        </button>
    </div>
    @if (_activeFilter != "all")
    {
        <div class="ad-filter-bar"><span class="ad-filter-chip"><i class="bi bi-funnel" aria-hidden="true"></i> @FilterLabel(_activeFilter)</span><button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => SetFilter("all")'><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button></div>
    }

    <!-- ── By status + By LOB ─────────────────────────────────── -->
    <div class="ad-two-col">
        @if (ShowStatusCard)
        {
        <div class="ad-card">
            <div class="ad-card-hd"><i class="bi bi-tags" aria-hidden="true"></i> Claims by Status</div>
            @if (_data.ByStatus.Count == 0)
            {
                <div class="ad-empty" style="padding:1rem"><span>No data.</span></div>
            }
            else
            {
                <div class="ad-table-wrap">
                    <table class="ad-table">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th class="ad-num">Count</th>
                                <th class="ad-num">Reserves</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in FilteredStatuses.OrderByDescending(x => x.Count))
                            {
                                <tr class="ad-click-row" title="Open claims register filtered to @s.StatusCode" @onclick="() => OpenClaimsByStatus(s.StatusCode)">
                                    <td>
                                        <span class="ad-badge @StatusBadgeClass(s.StatusCode)">@s.StatusCode</span>
                                    </td>
                                    <td class="ad-num" style="font-weight:600">@s.Count</td>
                                    <td class="ad-num">@s.Reserved.ToString("C0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        }

        @if (ShowLobCard)
        {
        <div class="ad-card">
            <div class="ad-card-hd"><i class="bi bi-pie-chart" aria-hidden="true"></i> Claims by Line of Business</div>
            @if (_data.ByLob.Count == 0)
            {
                <div class="ad-empty" style="padding:1rem"><span>No data.</span></div>
            }
            else
            {
                <div class="ad-table-wrap">
                    <table class="ad-table">
                        <thead>
                            <tr>
                                <th>Line of Business</th>
                                <th class="ad-num">Count</th>
                                <th class="ad-num">Reserves</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in _data.ByLob.OrderByDescending(x => x.Reserved))
                            {
                                <tr class="ad-click-row" title="Open claims register filtered to @l.LobName" @onclick="() => OpenClaimsByLob(l.LobName)">
                                    <td style="font-weight:500">@l.LobName</td>
                                    <td class="ad-num">@l.Count</td>
                                    <td class="ad-num" style="font-weight:600">@l.Reserved.ToString("C0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        }
    </div>
}

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private ClaimsSummaryDto? _data;
    private bool _loading;
    private string? _loadError;
    private string _activeFilter = "all";
    private bool ShowStatusCard => _activeFilter is "all" or "open" or "reserved" or "litigated";
    private bool ShowLobCard => _activeFilter is "all" or "paid";
    private IEnumerable<ClaimsByStatusDto> FilteredStatuses => (_data?.ByStatus ?? []).Where(s => _activeFilter switch
    {
        "reserved" => s.Reserved > 0,
        _ => true,
    });

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Agency Dashboard", "/tenant/dashboard"), new("Claims Summary"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try { _data = await Api.GetClaimsSummaryAsync(_tenantId); }
        catch (Exception ex) { _loadError = $"Failed to load claims summary: {ex.Message}"; _data = null; }
        finally { _loading = false; }
    }

    private void SetFilter(string filter) => _activeFilter = _activeFilter == filter && filter != "all" ? "all" : filter;
    private string KpiClass(string filter) => _activeFilter == filter ? "ad-kpi-card--active" : string.Empty;
    private static string FilterLabel(string filter) => filter switch { "open" => "Open claims", "reserved" => "Claims with reserves", "paid" => "LOB summary", "litigated" => "Litigation metrics", _ => "All claims" };

    private void OpenClaimsByStatus(string status) => Nav.NavigateTo($"/claims?status={Uri.EscapeDataString(status)}");
    private void OpenClaimsByLob(string lob) => Nav.NavigateTo($"/claims?lob={Uri.EscapeDataString(lob)}");

    private static string StatusBadgeClass(string status) => status.ToLower() switch
    {
        "open"    => "ad-badge--open",
        "closed"  => "ad-badge--closed",
        "pending" => "ad-badge--pending",
        _         => "ad-badge--info"
    };

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
