@page "/tenant/dashboard"
@namespace Ams.Web.Components.Pages.Tenant.Dashboard
@using System.Globalization
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Enterprise Tenant Dashboard — AMS</PageTitle>

@if (_toastVisible)
{
    <div class="ad-toast ad-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="ad-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="ad-enterprise-page">
    <section class="ad-hero">
        <div class="ad-hero-left">
            <span class="ad-hero-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
            <div>
                <div class="ad-title-row">
                    <h1>Enterprise Tenant Dashboard</h1>
                    <span><i class="bi bi-building-check" aria-hidden="true"></i> @AgencyName</span>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> Live agency data</span>
                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> Tenant scoped</span>
                </div>
                <p>Executive command center for revenue, retention, pipeline, renewals, claims, billing exposure, and operational alerts.</p>
            </div>
        </div>
        <div class="ad-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading" title="Refresh dashboard"><i class="bi @(_loading ? "bi-arrow-repeat ad-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/workbench")'><i class="bi bi-grid-1x2" aria-hidden="true"></i> Workbench</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => GoTo("/crm/leads")'><i class="bi bi-person-plus" aria-hidden="true"></i> Leads</button>
            <button type="button" class="um-btn um-btn-primary" @onclick='() => GoTo("/tenant/dashboard/alerts")'><i class="bi bi-bell" aria-hidden="true"></i> Alerts @AlertBadge</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger ad-error-banner" role="alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @_loadError</div>
    }

    @if (_loading)
    {
        <section class="ad-loading-state"><i class="bi bi-arrow-repeat ad-spin" aria-hidden="true"></i><strong>Loading tenant command center...</strong><span>Syncing premium, pipeline, claims, billing, renewals, and alert data.</span></section>
    }
    else if (_data is null)
    {
        <section class="ad-empty-state"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><strong>Dashboard data unavailable</strong><span>Refresh the dashboard or verify tenant data access.</span><button type="button" class="um-btn um-btn-primary" @onclick="LoadAsync">Retry</button></section>
    }
    else
    {
        <section class="ad-command-strip" aria-label="Executive priority KPIs">
            @foreach (var metric in Metrics)
            {
                <button type="button" class="@MetricCardClass(metric)" title="@metric.Caption" @onclick="@(() => SetFocus(metric.Focus))">
                    <span class="ad-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                    <span><span class="ad-kpi-val">@metric.Value</span><span class="ad-kpi-lbl">@metric.Label</span><small>@metric.Caption</small></span>
                </button>
            }
        </section>

        <section class="ad-workflow-strip" aria-label="Dashboard workflow actions">
            <button type="button" class="ad-workflow-card" @onclick='() => GoTo("/tenant/dashboard/kpis")'><i class="bi bi-bar-chart-line" aria-hidden="true"></i><span><strong>Review KPIs</strong><span>Open detailed agency metrics.</span></span></button>
            <button type="button" class="ad-workflow-card" @onclick='() => GoTo("/tenant/dashboard/renewal-pipeline")'><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span><strong>Protect renewals</strong><span>Prioritize renewal pipeline risk.</span></span></button>
            <button type="button" class="ad-workflow-card" @onclick='() => GoTo("/tenant/dashboard/billing-summary")'><i class="bi bi-receipt" aria-hidden="true"></i><span><strong>Collect AR</strong><span>Review outstanding receivables.</span></span></button>
            <button type="button" class="ad-workflow-card ad-workflow-danger" @onclick='() => GoTo("/tenant/dashboard/alerts")'><i class="bi bi-bell" aria-hidden="true"></i><span><strong>Resolve alerts</strong><span>@(_data.OpenAlerts == 0 ? "No open alerts." : $"{_data.OpenAlerts} open alert(s).")</span></span></button>
        </section>

        <section class="ad-view-tabs" aria-label="Dashboard views">
            @foreach (var view in _views)
            {
                <button type="button" class="@ViewButtonClass(view)" @onclick="@(() => SetView(view.Id))"><i class="bi @view.Icon" aria-hidden="true"></i> @view.Label</button>
            }
        </section>

        <section class="ad-content-layout">
            <main class="ad-main-card">
                @if (_view == "executive")
                {
                    <div class="ad-section-head"><div><h2>Executive health</h2><p>Revenue goal attainment, growth posture, and operational risk by priority.</p></div><button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => GoTo("/tenant/dashboard/kpis")'><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> KPI Detail</button></div>
                    <div class="ad-executive-grid">
                        <section class="ad-goal-card">
                            <div class="ad-goal-head"><span><i class="bi bi-bullseye" aria-hidden="true"></i> Premium goal progress</span><strong>@GoalPercentLabel</strong></div>
                            <div class="ad-progress-track"><div class="@GoalFillClass" style="width:@GoalWidth"></div></div>
                            <div class="ad-goal-foot"><span>@_data.WrittenPremiumYtd.ToString("C0", CultureInfo.CurrentCulture) YTD</span><span>@_data.WrittenPremiumGoal.ToString("C0", CultureInfo.CurrentCulture) goal</span></div>
                        </section>
                        <section class="ad-guidance-card"><h3><i class="bi bi-stars" aria-hidden="true"></i> Executive guidance</h3><p>@GuidanceText</p><div class="ad-guidance-actions"><button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => GoTo("/tenant/dashboard/renewal-pipeline")'>Renewals</button><button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => GoTo("/tenant/dashboard/billing-summary")'>Billing</button><button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => GoTo("/crm/leads")'>Pipeline</button></div></section>
                    </div>
                    @TrendPanel
                }
                else if (_view == "revenue")
                {
                    <div class="ad-section-head"><div><h2>Revenue command</h2><p>Premium, conversion, retention, leads, and opportunities.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => GoTo("/crm/opportunities")'>Opportunities</button></div>
                    <div class="ad-insight-grid">
                        @Insight("Written Premium MTD", _data.WrittenPremiumMtd.ToString("C0", CultureInfo.CurrentCulture), "Monthly revenue production", "bi-cash-stack", "ad-tone-blue", "/tenant/dashboard/kpis")
                        @Insight("Conversion Rate", _data.ConversionRate.ToString("F1", CultureInfo.CurrentCulture) + "%", "Lead conversion YTD", "bi-funnel", "ad-tone-green", "/crm/leads")
                        @Insight("Open Leads", _data.OpenLeads.ToString("N0", CultureInfo.CurrentCulture), "Active lead pipeline", "bi-person-plus", "ad-tone-amber", "/crm/leads")
                        @Insight("Open Opportunities", _data.OpenOpportunities.ToString("N0", CultureInfo.CurrentCulture), "Revenue opportunities", "bi-kanban", "ad-tone-purple", "/crm/opportunities")
                    </div>
                    @TrendPanel
                }
                else if (_view == "operations")
                {
                    <div class="ad-section-head"><div><h2>Operations command</h2><p>Policy, account, branch, producer, and renewal operating signals.</p></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => GoTo("/tenant/dashboard/branch-performance")'>Branches</button></div>
                    <div class="ad-insight-grid">
                        @Insight("Active Policies", _data.ActivePolicies.ToString("N0", CultureInfo.CurrentCulture), "In-force policy base", "bi-shield-check", "ad-tone-green", "/policies")
                        @Insight("Active Accounts", _data.ActiveAccounts.ToString("N0", CultureInfo.CurrentCulture), "Client/account base", "bi-buildings", "ad-tone-blue", "/accounts")
                        @Insight("Pending Renewals", _data.PendingRenewals.ToString("N0", CultureInfo.CurrentCulture), "Renewals requiring action", "bi-arrow-repeat", "ad-tone-purple", "/tenant/dashboard/renewal-pipeline")
                        @Insight("Retention Rate", _data.RetentionRate.ToString("F1", CultureInfo.CurrentCulture) + "%", "Book retention health", "bi-heart-pulse", "ad-tone-emerald", "/tenant/dashboard/renewal-pipeline")
                    </div>
                    @QuickLinksPanel
                }
                else
                {
                    <div class="ad-section-head"><div><h2>Risk and exceptions</h2><p>Claims, receivables, alerts, and operational exceptions that need attention.</p></div><button type="button" class="um-btn um-btn-danger um-btn-sm" @onclick='() => GoTo("/tenant/dashboard/alerts")'>Open Alerts</button></div>
                    <div class="ad-insight-grid">
                        @Insight("Open Claims", _data.OpenClaims.ToString("N0", CultureInfo.CurrentCulture), "Claims requiring service", "bi-exclamation-circle", "ad-tone-red", "/tenant/dashboard/claims-summary")
                        @Insight("Outstanding AR", _data.OutstandingAr.ToString("C0", CultureInfo.CurrentCulture), "Receivables exposure", "bi-receipt", "ad-tone-indigo", "/tenant/dashboard/billing-summary")
                        @Insight("Open Alerts", _data.OpenAlerts.ToString("N0", CultureInfo.CurrentCulture), "Operational alerts", "bi-bell", _data.OpenAlerts > 0 ? "ad-tone-red" : "ad-tone-green", "/tenant/dashboard/alerts")
                        @Insight("Goal Gap", GoalGap.ToString("C0", CultureInfo.CurrentCulture), "Remaining premium to goal", "bi-bullseye", GoalGap <= 0 ? "ad-tone-green" : "ad-tone-amber", "/tenant/dashboard/kpis")
                    </div>
                    @QuickLinksPanel
                }
            </main>

            <aside class="ad-priority-panel">
                <div class="ad-priority-head"><span><i class="bi bi-compass" aria-hidden="true"></i> Priority cockpit</span><strong>@_focusLabel</strong></div>
                <div class="ad-priority-stack">
                    @foreach (var item in PriorityItems)
                    {
                        <button type="button" class="ad-priority-item @item.Tone" @onclick="@(() => GoTo(item.Url))"><i class="bi @item.Icon" aria-hidden="true"></i><span><strong>@item.Title</strong><small>@item.Detail</small></span><em>@item.Value</em></button>
                    }
                </div>
            </aside>
        </section>
    }
</div>

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private AgencyExecutiveOverviewDto? _data;
    private bool _loading = true;
    private bool _toastVisible;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string _view = "executive";
    private string _focus = "revenue";
    private string _focusLabel = "Revenue";
    private decimal _maxTrend = 1;

    private readonly ViewOption[] _views = [new("executive", "Executive", "bi-speedometer2"), new("revenue", "Revenue", "bi-cash-coin"), new("operations", "Operations", "bi-diagram-3"), new("risk", "Risk", "bi-shield-exclamation")];

    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", _ => "bi-check-circle-fill" };
    private string AgencyName => string.IsNullOrWhiteSpace(_data?.AgencyName) ? "Agency" : _data.AgencyName;
    private string AlertBadge => _data?.OpenAlerts > 0 ? $"({_data.OpenAlerts})" : string.Empty;
    private decimal GoalGap => Math.Max(0, (_data?.WrittenPremiumGoal ?? 0) - (_data?.WrittenPremiumYtd ?? 0));
    private double GoalPct => _data is null || _data.WrittenPremiumGoal <= 0 ? 0 : Math.Min(100, (double)(_data.WrittenPremiumYtd / _data.WrittenPremiumGoal * 100));
    private string GoalPercentLabel => GoalPct.ToString("F1", CultureInfo.CurrentCulture) + "%";
    private string GoalWidth => GoalPct.ToString("F1", CultureInfo.InvariantCulture) + "%";
    private string GoalFillClass => $"ad-progress-fill {(GoalPct >= 100 ? "ad-progress-achieved" : GoalPct >= 75 ? "ad-progress-on-track" : "ad-progress-behind")}";
    private string GuidanceText => _data is null ? string.Empty : _data.OpenAlerts > 0 ? $"Resolve {_data.OpenAlerts} open alert(s) first, then address AR exposure and renewal pipeline risk." : _data.OutstandingAr > 0 ? $"Outstanding AR is {_data.OutstandingAr.ToString("C0", CultureInfo.CurrentCulture)}. Prioritize billing follow-up while monitoring renewals." : _data.PendingRenewals > 0 ? $"{_data.PendingRenewals} renewal(s) are pending. Protect retention and revenue continuity." : GoalPct < 75 ? "Premium production is behind target. Focus producers on leads, opportunities, and quotes." : "Agency health is stable. Continue monitoring retention, pipeline velocity, and service exceptions.";

    private IReadOnlyList<DashboardMetric> Metrics => _data is null ? [] :
    [
        new("revenue", _data.WrittenPremiumYtd.ToString("C0", CultureInfo.CurrentCulture), "Premium YTD", $"MTD {_data.WrittenPremiumMtd.ToString("C0", CultureInfo.CurrentCulture)}", "bi-cash-coin", "ad-kpi-premium", "revenue"),
        new("retention", _data.RetentionRate.ToString("F1", CultureInfo.CurrentCulture) + "%", "Retention", $"{_data.PendingRenewals:N0} pending renewals", "bi-arrow-repeat", "ad-kpi-retention", "operations"),
        new("policies", _data.ActivePolicies.ToString("N0", CultureInfo.CurrentCulture), "Policies", $"{_data.ActiveAccounts:N0} accounts", "bi-shield-check", "ad-kpi-policies", "operations"),
        new("pipeline", _data.OpenLeads.ToString("N0", CultureInfo.CurrentCulture), "Open Leads", $"{_data.OpenOpportunities:N0} opportunities", "bi-person-plus", "ad-kpi-leads", "revenue"),
        new("risk", _data.OpenClaims.ToString("N0", CultureInfo.CurrentCulture), "Claims", "Open service issues", "bi-exclamation-circle", "ad-kpi-claims", "risk"),
        new("billing", _data.OutstandingAr.ToString("C0", CultureInfo.CurrentCulture), "Outstanding AR", $"{_data.OpenAlerts:N0} alerts", "bi-receipt", "ad-kpi-ar", "risk")
    ];

    private IReadOnlyList<PriorityItem> PriorityItems => _data is null ? [] :
    [
        new("Revenue Goal", GoalPercentLabel, $"{GoalGap.ToString("C0", CultureInfo.CurrentCulture)} remaining", "bi-bullseye", GoalPct >= 75 ? "ad-priority-good" : "ad-priority-warn", "/tenant/dashboard/kpis"),
        new("Renewals", _data.PendingRenewals.ToString("N0", CultureInfo.CurrentCulture), "Pending renewal workflows", "bi-arrow-repeat", _data.PendingRenewals > 0 ? "ad-priority-warn" : "ad-priority-good", "/tenant/dashboard/renewal-pipeline"),
        new("Receivables", _data.OutstandingAr.ToString("C0", CultureInfo.CurrentCulture), "Outstanding AR exposure", "bi-receipt", _data.OutstandingAr > 0 ? "ad-priority-warn" : "ad-priority-good", "/tenant/dashboard/billing-summary"),
        new("Alerts", _data.OpenAlerts.ToString("N0", CultureInfo.CurrentCulture), "Open operational alerts", "bi-bell", _data.OpenAlerts > 0 ? "ad-priority-danger" : "ad-priority-good", "/tenant/dashboard/alerts")
    ];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tenant", "/tenant/dashboard"), new("Dashboard", "/tenant/dashboard"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _data = await Api.GetAgencyOverviewAsync(_tenantId);
            _maxTrend = _data?.PremiumTrend.Count > 0 ? Math.Max(1, _data.PremiumTrend.Max(t => t.Amount)) : 1;
            ShowToast("Tenant dashboard synced successfully.");
        }
        catch (Exception ex)
        {
            _loadError = $"Dashboard load failed: {ex.Message}";
            _data = null;
            ShowToast($"Dashboard load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

    private RenderFragment TrendPanel => @<section class="ad-panel ad-trend-panel"><h3><i class="bi bi-bar-chart-line" aria-hidden="true"></i> 6-month premium trend</h3><div class="ad-trend-rows">@foreach (var row in _data?.PremiumTrend ?? []) { var pct = _maxTrend > 0 ? Math.Max(4, (double)(row.Amount / _maxTrend * 100)) : 4; <button type="button" class="ad-trend-row" @onclick='() => GoTo("/tenant/dashboard/kpis")'><span>@row.Label</span><div><i style="width:@pct.ToString("F1", CultureInfo.InvariantCulture)%"></i></div><strong>@row.Amount.ToString("C0", CultureInfo.CurrentCulture)</strong><small>@row.Count policy</small></button> }</div></section>;
    private RenderFragment QuickLinksPanel => @<section class="ad-panel ad-quick-panel"><h3><i class="bi bi-lightning-charge" aria-hidden="true"></i> Executive shortcuts</h3><div class="ad-quick-grid">@foreach (var link in QuickLinks) { <button type="button" class="ad-quick-card" @onclick="@(() => GoTo(link.Url))"><i class="bi @link.Icon" aria-hidden="true"></i><span>@link.Label</span></button> }</div></section>;
    private IReadOnlyList<QuickLink> QuickLinks => [new("Agency KPIs", "bi-bar-chart-line", "/tenant/dashboard/kpis"), new("Branch Performance", "bi-diagram-3", "/tenant/dashboard/branch-performance"), new("Producer Performance", "bi-person-badge", "/tenant/dashboard/producer-performance"), new("Renewal Pipeline", "bi-arrow-clockwise", "/tenant/dashboard/renewal-pipeline"), new("Claims Summary", "bi-exclamation-circle", "/tenant/dashboard/claims-summary"), new("Billing Summary", "bi-receipt", "/tenant/dashboard/billing-summary"), new("Alerts", "bi-bell", "/tenant/dashboard/alerts")];

    private RenderFragment Insight(string label, string value, string caption, string icon, string tone, string url) => @<button type="button" class="ad-insight-card @tone" @onclick="@(() => GoTo(url))"><i class="bi @icon" aria-hidden="true"></i><span><strong>@value</strong><em>@label</em><small>@caption</small></span></button>;
    private string MetricCardClass(DashboardMetric metric) => $"ad-kpi-card {metric.Tone} {(metric.Focus == _focus ? "ad-kpi-card-active" : string.Empty)}";
    private string ViewButtonClass(ViewOption view) => $"ad-view-btn {(view.Id == _view ? "ad-view-btn-active" : string.Empty)}";
    private void SetView(string view) => _view = view;
    private void SetFocus(string focus) { _focus = focus; _focusLabel = focus switch { "retention" => "Retention", "policies" => "Operations", "pipeline" => "Pipeline", "risk" => "Risk", "billing" => "Billing", _ => "Revenue" }; _view = focus is "risk" or "billing" ? "risk" : focus is "retention" or "policies" ? "operations" : "revenue"; }
    private void GoTo(string url) => Nav.NavigateTo(url);
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;

    private sealed record ViewOption(string Id, string Label, string Icon);
    private sealed record DashboardMetric(string Focus, string Value, string Label, string Caption, string Icon, string Tone, string View);
    private sealed record PriorityItem(string Title, string Value, string Detail, string Icon, string Tone, string Url);
    private sealed record QuickLink(string Label, string Icon, string Url);
}
