@page "/tenant/dashboard/alerts"
@namespace Ams.Web.Components.Pages.Tenant.Dashboard
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Alerts — Agency Dashboard</PageTitle>

<AppPageHeader Title="Alerts"
               Subtitle="Active agency alerts by severity — system, operational and compliance notifications"
               Icon="bi-bell">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "ad-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
    </Actions>
</AppPageHeader>

@if (_loading)
{
    <div class="ad-loading-banner" aria-live="polite">
        <div class="um-spinner" aria-hidden="true"></div>
        <span>Loading alerts…</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger ad-alert-danger" role="alert"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i> @_loadError</div>
}
else
{
    <!-- ── Severity summary strip ─────────────────────────────── -->
    <div class="ad-kpi-strip">
        <button type="button" class="ad-kpi-card ad-kpi--claims @KpiClass("Critical")" @onclick='() => SetFilter("Critical")' title="Show critical alerts">
            <div class="ad-kpi-icon"><i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_critical</div>
                <div class="ad-kpi-lbl">Critical</div>
            </div>
        </button>
        <button type="button" class="ad-kpi-card ad-kpi--leads @KpiClass("High")" @onclick='() => SetFilter("High")' title="Show high alerts">
            <div class="ad-kpi-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_high</div>
                <div class="ad-kpi-lbl">High</div>
            </div>
        </button>
        <button type="button" class="ad-kpi-card ad-kpi--policies @KpiClass("Medium")" @onclick='() => SetFilter("Medium")' title="Show medium alerts">
            <div class="ad-kpi-icon"><i class="bi bi-info-circle-fill" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_medium</div>
                <div class="ad-kpi-lbl">Medium</div>
            </div>
        </button>
        <button type="button" class="ad-kpi-card ad-kpi--ar @KpiClass("All")" @onclick='() => SetFilter("All")' title="Show all open alerts">
            <div class="ad-kpi-icon"><i class="bi bi-bell-fill" aria-hidden="true"></i></div>
            <div class="ad-kpi-body">
                <div class="ad-kpi-val">@_total</div>
                <div class="ad-kpi-lbl">Total Open</div>
            </div>
        </button>
    </div>

    <!-- ── Filter tabs ────────────────────────────────────────── -->
    <div class="ad-tab-bar">
        @foreach (var sev in _severities)
        {
            <button class="ad-tab @(_filter == sev ? "ad-tab--active" : "")"
                    @onclick="() => SetFilter(sev)">
                @sev
            </button>
        }
    </div>

    <!-- ── Alert list ─────────────────────────────────────────── -->
    <div class="ad-card">
        @{
            var visible = _alerts.Where(a =>
                _filter == "All" || a.SeverityCode.Equals(_filter, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        @if (visible.Count == 0)
        {
            <div class="ad-empty" style="padding:2rem">
                <i class="bi bi-check-circle" style="font-size:2rem;color:#10b981" aria-hidden="true"></i>
                <span>No @(_filter == "All" ? "" : _filter.ToLower() + " ")alerts — all clear.</span>
            </div>
        }
        else
        {
            <div class="ad-alert-list">
                @foreach (var a in visible.OrderBy(x => SeverityOrder(x.SeverityCode)).ThenByDescending(x => x.TriggeredDateUtc))
                {
                    <div class="ad-alert-row ad-alert-row--@a.SeverityCode.ToLower()">
                        <div class="ad-alert-left">
                            <span class="ad-dot ad-dot--@a.SeverityCode.ToLower()" aria-hidden="true"></span>
                            <div>
                                <div class="ad-alert-name">@a.AlertName</div>
                                @if (!string.IsNullOrEmpty(a.Message))
                                {
                                    <div class="ad-alert-msg">@a.Message</div>
                                }
                                <div class="ad-alert-meta">
                                    <span>@a.ServiceName</span>
                                    @if (!string.IsNullOrEmpty(a.AlertTypeCode))
                                    {
                                        <span class="ad-badge ad-badge--info">@a.AlertTypeCode</span>
                                    }
                                    <span>@a.TriggeredDateUtc.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                </div>
                            </div>
                        </div>
                        <div class="ad-alert-right">
                            <span class="ad-badge @SeverityBadgeClass(a.SeverityCode)">@a.SeverityCode</span>
                            <span class="ad-badge @StatusBadgeClass(a.StatusCode)">@a.StatusCode</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private List<AlertDto> _alerts = [];
    private bool _loading;
    private string? _loadError;
    private string _filter = "All";
    private static readonly string[] _severities = ["All", "Critical", "High", "Medium", "Low"];
    private int _critical, _high, _medium, _total;

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Agency Dashboard", "/tenant/dashboard"), new("Alerts"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _loadError = null;
            var result = await Api.SearchAlertsAsync(tenantId: _tenantId, openOnly: true, pageSize: 100);
            _alerts   = result?.Items.ToList() ?? [];
            _critical = _alerts.Count(a => a.SeverityCode.Equals("Critical", StringComparison.OrdinalIgnoreCase));
            _high     = _alerts.Count(a => a.SeverityCode.Equals("High",     StringComparison.OrdinalIgnoreCase));
            _medium   = _alerts.Count(a => a.SeverityCode.Equals("Medium",   StringComparison.OrdinalIgnoreCase));
            _total    = _alerts.Count;
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load alerts: {ex.Message}";
            _alerts = [];
            _critical = _high = _medium = _total = 0;
        }
        finally { _loading = false; }
    }

    private void SetFilter(string filter) => _filter = _filter == filter && filter != "All" ? "All" : filter;
    private string KpiClass(string filter) => _filter == filter ? "ad-kpi-card--active" : string.Empty;

    private static int SeverityOrder(string s) => s.ToLower() switch
    {
        "critical" => 0,
        "high"     => 1,
        "medium"   => 2,
        _          => 3
    };

    private static string SeverityBadgeClass(string s) => s.ToLower() switch
    {
        "critical" => "ad-badge--overdue",
        "high"     => "ad-badge--warn",
        "medium"   => "ad-badge--pending",
        _          => "ad-badge--info"
    };

    private static string StatusBadgeClass(string s) => s.ToLower() switch
    {
        "open"          => "ad-badge--open",
        "acknowledged"  => "ad-badge--pending",
        "resolved"      => "ad-badge--closed",
        _               => "ad-badge--info"
    };
}
