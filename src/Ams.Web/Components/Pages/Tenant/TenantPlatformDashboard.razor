@page "/tenant"
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Tenant Platform Dashboard</PageTitle>

<AppPageHeader Title="Tenant Platform Dashboard"
               Subtitle="Platform-wide tenant overview"
               Icon="bi-speedometer2" />

<div class="tpd-kpi-row">
    @foreach (var card in _kpis)
    {
        <div class="tpd-kpi-card">
            <i class="bi @card.Icon tpd-kpi-icon" aria-hidden="true"></i>
            <div class="tpd-kpi-body">
                <span class="tpd-kpi-value">@(card.Value?.ToString("N0") ?? "—")</span>
                <span class="tpd-kpi-label">@card.Label</span>
            </div>
        </div>
    }
</div>

<div class="tpd-section-hd">Tenants</div>

@if (_tenants is null)
{
    <p class="tpd-loading"><span class="um-spin" aria-hidden="true"></span> Loading…</p>
}
else
{
    <SfGrid DataSource="_tenants" AllowPaging="true" AllowSorting="true" Height="420px">
        <GridPageSettings PageSize="10" />
        <GridColumns>
            <GridColumn Field="@nameof(TenantDto.TenantCode)"     HeaderText="Code"     Width="120" />
            <GridColumn Field="@nameof(TenantDto.TenantName)"     HeaderText="Name"     Width="220" />
            <GridColumn Field="@nameof(TenantDto.PlanCode)"       HeaderText="Plan"     Width="120" />
            <GridColumn Field="@nameof(TenantDto.CurrencyCode)"   HeaderText="Currency" Width="100" />
            <GridColumn Field="@nameof(TenantDto.IsActive)"       HeaderText="Active"   Width="90"  DisplayAsCheckBox="true" />
            <GridColumn Field="@nameof(TenantDto.CreatedDateUtc)" HeaderText="Created"  Type="ColumnType.DateTime" Format="d" Width="140" />
        </GridColumns>
    </SfGrid>
}

@code {
    private List<TenantDto>?     _tenants;
    private KpiCard[]            _kpis = [];

    private sealed record KpiCard(string Label, string Icon, int? Value);

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new BreadcrumbService.BreadcrumbItem("Tenant", "/tenant"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchTenantsAsync();
        _tenants   = result?.Items.ToList() ?? [];

        var total  = result?.TotalCount ?? 0;
        var active = _tenants.Count(t => t.IsActive);

        _kpis =
        [
            new("Total Tenants",  "bi-buildings",        total),
            new("Active",         "bi-check-circle",     active),
            new("Inactive",       "bi-x-circle",         total - active),
        ];
    }
}
