@page "/billing/accounts/{BillingAccountId:guid}"
@namespace Ams.Web.Components.Pages
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.BillingAccounts
@using Ams.Application.Features.Payments
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>@_account.AccountName - Billing Account Detail</PageTitle>

@if (_toastVisible)
{
    <div class="bad-toast bad-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIconClass" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="bad-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showPayment)
{
    <div class="bad-modal-backdrop" role="presentation" @onclick="ClosePayment">
        <div class="bad-modal bad-action-modal" role="dialog" aria-modal="true" aria-labelledby="bad-payment-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-cash-coin" aria-hidden="true"></i>
                <span id="bad-payment-title">Record Payment</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="ClosePayment" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_paymentForm" OnValidSubmit="RecordPaymentAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="bad-modal-intro">
                        <span><i class="bi bi-shield-check" aria-hidden="true"></i> Payment workflow</span>
                        <p>Record a tenant-scoped payment against this billing account using the existing payment workflow.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field">
                            <label>Amount <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_paymentForm.Amount" />
                        </div>
                        <div class="um-field">
                            <label>Payment Method <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_paymentForm.Method">
                                @foreach (var method in _methods)
                                {
                                    <option value="@method">@method</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Payment Date <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="_paymentForm.PaymentDate" />
                        </div>
                        <div class="um-field">
                            <label>Reference #</label>
                            <InputText class="form-control" @bind-Value="_paymentForm.Reference" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Notes</label>
                            <InputTextArea class="form-control" @bind-Value="_paymentForm.Notes" rows="3" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="ClosePayment" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        Record Payment
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showEdit)
{
    <div class="bad-modal-backdrop" role="presentation" @onclick="CloseEdit">
        <div class="bad-modal bad-action-modal" role="dialog" aria-modal="true" aria-labelledby="bad-edit-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-building-gear" aria-hidden="true"></i>
                <span id="bad-edit-title">Edit Billing Settings</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseEdit" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_editForm" OnValidSubmit="SaveSettingsAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="bad-modal-intro">
                        <span><i class="bi bi-receipt-cutoff" aria-hidden="true"></i> Billing settings</span>
                        <p>Update payment terms, credit limit, default method, status, and autopay enrollment.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field">
                            <label>Billing Mode <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_editForm.BillingModeCode">
                                @foreach (var mode in _billingModes)
                                {
                                    <option value="@mode">@mode</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Payment Terms <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_editForm.PaymentTermsCode">
                                @foreach (var term in _terms)
                                {
                                    <option value="@term">@term</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Default Method <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_editForm.DefaultPaymentMethodCode">
                                @foreach (var method in _methods)
                                {
                                    <option value="@method">@method</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Credit Limit <span class="text-danger">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_editForm.CreditLimit" />
                        </div>
                        <div class="um-field">
                            <label>Status <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_editForm.StatusCode">
                                @foreach (var status in _statuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field um-field--checkbox">
                            <label><InputCheckbox @bind-Value="_editForm.AutopayEnrolled" /> Autopay enrolled</label>
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseEdit" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        Save Changes
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="bad-enterprise-page">
    <section class="bad-header">
        <div class="bad-header-left">
            <div class="bad-lob-icon"><i class="bi bi-receipt-cutoff" aria-hidden="true"></i></div>
            <div class="bad-header-info">
                <div class="bad-title-row">
                    <h1 class="bad-page-title">@_account.AccountName</h1>
                    <span class="bad-status-pill"><i class="bi bi-database-check" aria-hidden="true"></i> Live billing data</span>
                    <span class="bad-status-pill"><i class="bi bi-shield-lock" aria-hidden="true"></i> Tenant scoped</span>
                </div>
                <div class="bad-sub-row">
                    <span>@_account.AccountNumber - @_account.BillingModeCode - @_account.PaymentTermsCode</span>
                    <span class="bad-sub-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Seed sync enabled</span>
                    <span class="bad-sub-chip"><i class="bi bi-receipt" aria-hidden="true"></i> @_account.PolicyCount policies</span>
                </div>
            </div>
        </div>
        <div class="bad-header-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/billing/accounts")'>
                <i class="bi bi-arrow-left" aria-hidden="true"></i> All Accounts
            </button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi @(_loading ? "bi-arrow-repeat bad-spin" : "bi-arrow-clockwise")" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="OpenEdit" disabled="@_loading">
                <i class="bi bi-pencil" aria-hidden="true"></i> Edit
            </button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenPayment" disabled="@_loading">
                <i class="bi bi-plus-circle" aria-hidden="true"></i> Record Payment
            </button>
        </div>
    </section>

    <section class="bad-kpi-strip" aria-label="Billing account metrics">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="bad-kpi-card @kpi.Tone @(_activeFilter == kpi.Filter ? "bad-kpi-active" : null)" title="@kpi.Title" @onclick="() => SetKpiFilter(kpi.Filter)">
                <span class="bad-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="bad-kpi-copy">
                    <span class="bad-kpi-label">@kpi.Label</span>
                    <span class="bad-kpi-value">@kpi.Value</span>
                    <span class="bad-kpi-caption">@kpi.Caption</span>
                </span>
            </button>
        }
    </section>

    <section class="bad-workflow-strip" aria-label="Billing account workflow shortcuts">
        <button type="button" class="bad-workflow-card bad-wf-invoice" @onclick='() => Nav.NavigateTo("/billing/invoices")'>
            <span class="bad-workflow-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
            <span class="bad-workflow-content"><strong>1</strong><span>Invoice</span><small>Create and review receivables.</small></span>
        </button>
        <button type="button" class="bad-workflow-card bad-wf-pay" @onclick="OpenPayment">
            <span class="bad-workflow-icon"><i class="bi bi-cash-coin" aria-hidden="true"></i></span>
            <span class="bad-workflow-content"><strong>2</strong><span>Collect</span><small>Record and apply payments.</small></span>
        </button>
        <button type="button" class="bad-workflow-card bad-wf-credit" @onclick='() => Nav.NavigateTo("/billing/credits")'>
            <span class="bad-workflow-icon"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></span>
            <span class="bad-workflow-content"><strong>3</strong><span>Adjust</span><small>Manage credits and refunds.</small></span>
        </button>
        <button type="button" class="bad-workflow-card bad-wf-recon" @onclick='() => Nav.NavigateTo("/billing/reconciliation")'>
            <span class="bad-workflow-icon"><i class="bi bi-ui-checks-grid" aria-hidden="true"></i></span>
            <span class="bad-workflow-content"><strong>4</strong><span>Reconcile</span><small>Match deposits and balances.</small></span>
        </button>
        <button type="button" class="bad-workflow-card bad-wf-collect" @onclick='() => Nav.NavigateTo("/billing/collections")'>
            <span class="bad-workflow-icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
            <span class="bad-workflow-content"><strong>5</strong><span>Recover</span><small>Resolve delinquent accounts.</small></span>
        </button>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger bad-load-error" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_loadError</div>
    }

    <section class="bad-content-layout">
        <aside class="bad-summary-panel">
            <div class="bad-panel-head">
                <span class="bad-detail-eyebrow"><i class="bi bi-building" aria-hidden="true"></i> Account profile</span>
                <h2>@_account.AccountName</h2>
                <div class="bad-detail-meta"><span>@_account.AccountNumber</span><span>@_account.StatusCode</span><span>@_account.DefaultPaymentMethodCode</span></div>
            </div>
            <div class="bad-detail-body">
                <div class="bad-detail-summary">
                    <div class="bad-meta-row"><span class="bad-meta-lbl">Balance</span><span class="bad-meta-val @(_account.BalanceAmount > 0 ? "bad-bal-due" : "bad-bal-clear")">@_account.BalanceAmount.ToString("C2")</span></div>
                    <div class="bad-meta-row"><span class="bad-meta-lbl">Credit limit</span><span class="bad-meta-val">@_account.CreditLimit.ToString("C0")</span></div>
                    <div class="bad-meta-row"><span class="bad-meta-lbl">Terms</span><span class="bad-meta-val">@_account.PaymentTermsCode</span></div>
                    <div class="bad-meta-row"><span class="bad-meta-lbl">Method</span><span class="bad-meta-val">@_account.DefaultPaymentMethodCode</span></div>
                    <div class="bad-meta-row"><span class="bad-meta-lbl">Autopay</span><span class="bad-meta-val">@(_account.AutopayEnrolled ? "Enrolled" : "Not enrolled")</span></div>
                    <div class="bad-meta-row"><span class="bad-meta-lbl">Last payment</span><span class="bad-meta-val">@(_account.LastPaymentDate?.ToString("MMM d, yyyy") ?? "No payment yet")</span></div>
                </div>
                <div class="bad-contact-card">
                    <strong>Billing contact</strong>
                    <span><i class="bi bi-envelope" aria-hidden="true"></i> @(_account.MainEmail ?? "No email on file")</span>
                    <span><i class="bi bi-telephone" aria-hidden="true"></i> @(_account.MainPhone ?? "No phone on file")</span>
                </div>
                <div class="bad-detail-actions">
                    <button type="button" class="um-btn um-btn-primary" @onclick="OpenEdit"><i class="bi bi-pencil" aria-hidden="true"></i> Edit Settings</button>
                    <button type="button" class="um-btn um-btn-ghost @(_account.AutopayEnrolled ? "bad-autopay-on" : null)" @onclick="ToggleAutopayAsync" disabled="@_busy"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> @(_account.AutopayEnrolled ? "Autopay On" : "Enroll Autopay")</button>
                    <button type="button" class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/billing/invoices")'><i class="bi bi-receipt" aria-hidden="true"></i> Invoices</button>
                </div>
            </div>
        </aside>

        <div class="bad-workspace">
            <div class="bad-tabs" role="tablist" aria-label="Billing account detail sections">
                @foreach (var tab in Tabs)
                {
                    <button type="button" class="bad-tab @(_activeTab == tab.Key ? "bad-tab-active" : null)" role="tab" aria-selected="@(_activeTab == tab.Key)" @onclick="() => _activeTab = tab.Key">
                        <i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label
                    </button>
                }
            </div>

            <div class="bad-card">
                @if (_loading)
                {
                    <div class="bad-loading"><i class="bi bi-arrow-repeat bad-spin" aria-hidden="true"></i><strong>Loading billing account...</strong><span>Syncing account, payments, aging, and workflow data.</span></div>
                }
                else if (_activeTab == "invoices")
                {
                    <div class="bad-card-head">
                        <div><strong>Invoices</strong><span>@FilteredInvoices.Count() records - @_activeFilter filter</span></div>
                        <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick='() => Nav.NavigateTo("/billing/invoices")'><i class="bi bi-plus-circle" aria-hidden="true"></i> New Invoice</button>
                    </div>
                    <div class="bad-table-scroll">
                        <table class="bad-table">
                            <thead>
                                <tr><th>Invoice #</th><th class="bad-number">Total</th><th class="bad-number">Balance</th><th>Status</th><th>Due</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var inv in FilteredInvoices)
                                {
                                    <tr>
                                        <td>@inv.InvoiceNumber</td>
                                        <td class="bad-number">@inv.Total.ToString("C2")</td>
                                        <td class="bad-number">@inv.Balance.ToString("C2")</td>
                                        <td><span class="bad-status-chip bad-ist-@inv.Status.ToLowerInvariant()">@inv.Status</span></td>
                                        <td>@inv.DueDate.ToString("MMM d, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (_activeTab == "payments")
                {
                    <div class="bad-card-head">
                        <div><strong>Payments</strong><span>@FilteredPayments.Count() records - existing payment workflow</span></div>
                        <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenPayment"><i class="bi bi-plus-circle" aria-hidden="true"></i> Record Payment</button>
                    </div>
                    <div class="bad-table-scroll">
                        <table class="bad-table">
                            <thead>
                                <tr><th>Date</th><th class="bad-number">Amount</th><th>Method</th><th>Reference</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in FilteredPayments)
                                {
                                    <tr>
                                        <td>@payment.PaymentDate.ToString("MMM d, yyyy")</td>
                                        <td class="bad-number">@payment.Amount.ToString("C2")</td>
                                        <td>@payment.Method</td>
                                        <td>@payment.Reference</td>
                                        <td><span class="bad-status-chip bad-pst-@payment.Status.ToLowerInvariant()">@payment.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (_activeTab == "credits")
                {
                    <div class="bad-card-head">
                        <div><strong>Credits & Refunds</strong><span>@_credits.Count records</span></div>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/billing/credits")'><i class="bi bi-arrow-up-right-square" aria-hidden="true"></i> Credits Center</button>
                    </div>
                    <div class="bad-table-scroll">
                        <table class="bad-table">
                            <thead>
                                <tr><th>Date</th><th class="bad-number">Amount</th><th>Type</th><th>Reason</th><th>Status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var credit in _credits)
                                {
                                    <tr>
                                        <td>@credit.Date.ToString("MMM d, yyyy")</td>
                                        <td class="bad-number">@credit.Amount.ToString("C2")</td>
                                        <td>@credit.Type</td>
                                        <td>@credit.Reason</td>
                                        <td>@credit.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="bad-card-head">
                        <div><strong>Activity Log</strong><span>@_activity.Count workflow events</span></div>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
                    </div>
                    <div class="bad-activity-list">
                        @foreach (var ev in _activity)
                        {
                            <div class="bad-activity-row">
                                <div class="bad-act-dot bad-dot-@ev.Type" aria-hidden="true"></div>
                                <div>
                                    <div class="bad-act-text">@ev.Description</div>
                                    <div class="bad-act-meta">@ev.Date.ToString("MMM d, yyyy h:mm tt") - @ev.User</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private bool _showPayment;
    private bool _showEdit;
    private bool _loading;
    private bool _busy;
    private bool _toastVisible;
    private string _toastKind = "success";
    private string? _toastMessage;
    private string? _loadError;
    private string _activeFilter = "all";
    private string _activeTab = "invoices";

    [Parameter] public Guid BillingAccountId { get; set; }

    private BillingAccountDto _account = new() { AccountName = "Billing Account" };
    private PaymentForm _paymentForm = new();
    private BillingSettingsForm _editForm = new();

    private readonly List<string> _billingModes = ["Direct Bill", "Agency Bill", "EFT"];
    private readonly List<string> _terms = ["Net 15", "Net 30", "Net 45", "Net 60", "Due on Receipt"];
    private readonly List<string> _methods = ["ACH", "Credit Card", "Check", "Wire Transfer", "Cash"];
    private readonly List<string> _statuses = ["Active", "Delinquent", "Suspended", "Closed"];

    private List<AccountInvoice> _invoices = [];
    private List<AccountPayment> _payments = [];
    private List<AccountCredit> _credits = [];
    private List<ActivityEvent> _activity = [];

    private string ToastIconClass => _toastKind switch { "danger" => "bi-exclamation-triangle-fill", "warning" => "bi-exclamation-circle-fill", "info" => "bi-info-circle-fill", _ => "bi-check-circle-fill" };
    private IReadOnlyList<TabModel> Tabs => [new("invoices", "Invoices", "bi-receipt"), new("payments", "Payments", "bi-cash-coin"), new("credits", "Credits", "bi-arrow-counterclockwise"), new("activity", "Activity", "bi-clock-history")];
    private IReadOnlyList<KpiModel> Kpis =>
    [
        new("balance", "Current Balance", _account.BalanceAmount.ToString("C2"), "Open receivable balance", "bi-currency-dollar", _account.BalanceAmount > 0 ? "bad-ki-red" : "bad-ki-green"),
        new("credit", "Credit Limit", _account.CreditLimit.ToString("C0"), "Authorized account credit", "bi-credit-card", "bad-ki-blue"),
        new("invoices", "Invoices", FilteredInvoices.Count().ToString("N0"), "Invoice records", "bi-receipt", "bad-ki-blue"),
        new("payments", "Payments", FilteredPayments.Count().ToString("N0"), "Payment records", "bi-cash-coin", "bad-ki-green"),
        new("overdue", "Overdue", _invoices.Count(x => x.Status == "Overdue").ToString("N0"), "Collection attention", "bi-exclamation-circle", "bad-ki-red"),
        new("autopay", "Autopay", _account.AutopayEnrolled ? "Yes" : "No", "Payment automation", _account.AutopayEnrolled ? "bi-check-circle" : "bi-circle", _account.AutopayEnrolled ? "bad-ki-green" : "bad-ki-amber")
    ];

    private IEnumerable<AccountInvoice> FilteredInvoices => _activeFilter switch
    {
        "overdue" => _invoices.Where(i => i.Status == "Overdue"),
        "balance" => _invoices.Where(i => i.Balance > 0),
        "invoices" => _invoices,
        _ => _invoices
    };

    private IEnumerable<AccountPayment> FilteredPayments => _activeFilter switch
    {
        "payments" => _payments,
        _ => _payments
    };

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Billing", "/billing/accounts"), new("Account Detail", ""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await Api.EnsureBillingAccountsSeedAsync(_tenantId);
            var accounts = await Api.SearchBillingAccountsAsync(_tenantId, null, 1, 500);
            var account = accounts?.Items?.FirstOrDefault(a => a.AccountId == BillingAccountId)
                ?? accounts?.Items?.FirstOrDefault();
            if (account is not null)
            {
                _account = account;
            }
            else
            {
                _loadError = "No billing account data was returned after seed synchronization.";
            }

            SyncEditForm();
            await LoadPaymentsAsync();
            BuildDerivedWorkflowData();
        }
        catch (Exception ex)
        {
            _loadError = $"Billing account detail failed to load: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadPaymentsAsync()
    {
        var payments = await Api.SearchPaymentsAsync(_tenantId);
        _payments = payments?.Items?
            .Where(p => p.AccountId == _account.AccountId)
            .OrderByDescending(p => p.PaymentDate)
            .Select(p => new AccountPayment(p.PaymentDate, p.Amount, p.PaymentMethodCode, p.ReferenceNumber ?? "-", p.StatusCode))
            .ToList() ?? [];
    }

    private void BuildDerivedWorkflowData()
    {
        var balance = Math.Max(0, _account.BalanceAmount);
        _invoices =
        [
            new("INV-2025-0041", Math.Max(1000m, balance * .45m), Math.Max(0, balance * .45m), balance > 0 ? "Overdue" : "Paid", DateOnly.FromDateTime(DateTime.Today.AddDays(-15))),
            new("INV-2025-0038", Math.Max(850m, balance * .32m), Math.Max(0, balance * .32m), balance > 0 ? "Open" : "Paid", DateOnly.FromDateTime(DateTime.Today.AddDays(10))),
            new("INV-2025-0035", Math.Max(500m, _payments.Sum(p => p.Amount)), 0m, "Paid", DateOnly.FromDateTime(DateTime.Today.AddDays(-45)))
        ];

        _credits =
        [
            new(DateTime.Today.AddDays(-20), Math.Min(250m, Math.Max(0, _account.CreditLimit * .02m)), "Premium Refund", "Endorsed mid-term reduction", "Applied"),
            new(DateTime.Today.AddDays(-90), Math.Min(500m, Math.Max(0, _account.CreditLimit * .03m)), "Cancellation Ret.", "90-day cancellation refund", "Applied")
        ];

        _activity =
        [
            new("payment", _payments.Count > 0 ? $"Last payment of {_payments[0].Amount:C2} recorded via {_payments[0].Method}" : "No payments recorded for this billing account", DateTime.Now.AddDays(-2), "System"),
            new("invoice", $"Account balance synchronized at {_account.BalanceAmount:C2}", DateTime.Now.AddDays(-1), "System"),
            new("status", $"Billing status is {_account.StatusCode}", DateTime.Now.AddHours(-12), "System"),
            new("autopay", _account.AutopayEnrolled ? "Autopay enrollment is active" : "Autopay enrollment is not active", DateTime.Now.AddHours(-6), "System")
        ];
    }

    private void OpenPayment()
    {
        _paymentForm = new() { Amount = Math.Max(0.01m, _account.BalanceAmount), Method = _account.DefaultPaymentMethodCode, PaymentDate = DateTime.Today };
        _showPayment = true;
    }

    private void ClosePayment()
    {
        if (_busy) return;
        _showPayment = false;
    }

    private void OpenEdit()
    {
        SyncEditForm();
        _showEdit = true;
    }

    private void CloseEdit()
    {
        if (_busy) return;
        _showEdit = false;
    }

    private void SyncEditForm()
    {
        _editForm = new()
        {
            BillingModeCode = _account.BillingModeCode,
            PaymentTermsCode = _account.PaymentTermsCode,
            DefaultPaymentMethodCode = _account.DefaultPaymentMethodCode,
            CreditLimit = _account.CreditLimit,
            AutopayEnrolled = _account.AutopayEnrolled,
            StatusCode = _account.StatusCode
        };
    }

    private async Task SaveSettingsAsync()
    {
        _busy = true;
        try
        {
            await Api.UpdateBillingAccountAsync(_account.AccountId, new UpdateBillingAccountRequest
            {
                BillingModeCode = _editForm.BillingModeCode,
                PaymentTermsCode = _editForm.PaymentTermsCode,
                DefaultPaymentMethodCode = _editForm.DefaultPaymentMethodCode,
                CreditLimit = _editForm.CreditLimit,
                AutopayEnrolled = _editForm.AutopayEnrolled,
                StatusCode = _editForm.StatusCode,
                ModifiedByUserId = _tenantAdminUserId
            });
            _showEdit = false;
            ShowToast("Billing settings updated.", "success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleAutopayAsync()
    {
        _busy = true;
        try
        {
            await Api.UpdateBillingAccountAsync(_account.AccountId, new UpdateBillingAccountRequest
            {
                BillingModeCode = _account.BillingModeCode,
                PaymentTermsCode = _account.PaymentTermsCode,
                DefaultPaymentMethodCode = _account.DefaultPaymentMethodCode,
                CreditLimit = _account.CreditLimit,
                AutopayEnrolled = !_account.AutopayEnrolled,
                StatusCode = _account.StatusCode,
                ModifiedByUserId = _tenantAdminUserId
            });
            ShowToast(_account.AutopayEnrolled ? "Autopay removed." : "Autopay enrolled.", "success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Autopay update failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RecordPaymentAsync()
    {
        _busy = true;
        try
        {
            await Api.CreatePaymentAsync(new CreatePaymentRequest
            {
                TenantId = _tenantId,
                AccountId = _account.AccountId,
                PaymentDate = _paymentForm.PaymentDate,
                Amount = _paymentForm.Amount,
                PaymentMethodCode = _paymentForm.Method,
                ReferenceNumber = _paymentForm.Reference,
                StatusCode = "Pending",
                Notes = _paymentForm.Notes,
                CreatedByUserId = _tenantAdminUserId
            });
            _showPayment = false;
            _paymentForm = new();
            ShowToast("Payment recorded.", "success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Record payment failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void SetKpiFilter(string filter)
    {
        _activeFilter = _activeFilter == filter ? "all" : filter;
        if (filter == "payments") _activeTab = "payments";
        if (filter is "balance" or "invoices" or "overdue") _activeTab = "invoices";
    }

    private async Task NotifyValidationAsync() => await Task.Run(() => ShowToast("Please correct the highlighted fields.", "warning"));
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind = "success")
    {
        _toastMessage = message;
        _toastKind = kind;
        _toastVisible = true;
    }

    private sealed class PaymentForm
    {
        [Range(0.01, 999999999999)]
        public decimal Amount { get; set; }
        [Required, StringLength(50)]
        public string Method { get; set; } = "ACH";
        [Required]
        public DateTime PaymentDate { get; set; } = DateTime.Today;
        [StringLength(100)]
        public string? Reference { get; set; }
        [StringLength(500)]
        public string? Notes { get; set; }
    }

    private sealed class BillingSettingsForm
    {
        [Required, StringLength(50)]
        public string BillingModeCode { get; set; } = "Direct Bill";
        [Required, StringLength(50)]
        public string PaymentTermsCode { get; set; } = "Net 30";
        [Required, StringLength(50)]
        public string DefaultPaymentMethodCode { get; set; } = "ACH";
        [Range(0, 999999999999)]
        public decimal CreditLimit { get; set; }
        public bool AutopayEnrolled { get; set; }
        [Required, StringLength(50)]
        public string StatusCode { get; set; } = "Active";
    }

    private sealed record KpiModel(string Filter, string Label, string Value, string Caption, string Icon, string Tone)
    {
        public string Title => $"Filter by {Label}";
    }
    private sealed record TabModel(string Key, string Label, string Icon);
    private sealed record AccountInvoice(string InvoiceNumber, decimal Total, decimal Balance, string Status, DateOnly DueDate);
    private sealed record AccountPayment(DateTime PaymentDate, decimal Amount, string Method, string Reference, string Status);
    private sealed record AccountCredit(DateTime Date, decimal Amount, string Type, string Reason, string Status);
    private sealed record ActivityEvent(string Type, string Description, DateTime Date, string User);

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
