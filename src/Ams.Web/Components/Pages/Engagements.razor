@page "/engagements"
@inject ApiClient Api

<PageTitle>Engagements</PageTitle>
<h1>Engagements</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(EngagementDto.EngagementNumber)"  HeaderText="Eng #"    Width="130"></GridColumn>
        <GridColumn Field="@nameof(EngagementDto.EngagementName)"    HeaderText="Name"     Width="250"></GridColumn>
        <GridColumn Field="@nameof(EngagementDto.EngagementTypeCode)" HeaderText="Type"    Width="130"></GridColumn>
        <GridColumn Field="@nameof(EngagementDto.StartDate)"         HeaderText="Start"    Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(EngagementDto.EndDate)"           HeaderText="End"      Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
        <GridColumn Field="@nameof(EngagementDto.StatusCode)"        HeaderText="Status"   Width="120"></GridColumn>
        <GridColumn Field="@nameof(EngagementDto.CreatedDateUtc)"    HeaderText="Created"  Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<EngagementDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchEngagementsAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
