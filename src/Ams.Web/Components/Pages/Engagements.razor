@page "/engagements"
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@using Ams.Application.Features.Engagements

<PageTitle>Engagements — Operations</PageTitle>
<AppPageHeader Title="Engagements Administration" Subtitle="Tenant admin oversight for customer engagements, delivery timelines, owners, and operational execution" Icon="bi-briefcase">
    <Actions>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New Engagement</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </Actions>
</AppPageHeader>

<section class="ma-hero twf-hero">
    <div>
        <span class="ma-eyebrow">Tenant Administration · Engagements</span>
        <h2>Tenant Engagement Control Center</h2>
        <p>Administer tenant-wide engagements, owners, delivery dates, milestones, activities, and service execution risk.</p>
    </div>
    <div class="ma-hero-actions">
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/agreements")'><i class="bi bi-file-earmark-check"></i> Agreements</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/ops/milestones")'><i class="bi bi-flag"></i> Milestones</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/ops/activities")'><i class="bi bi-clock-history"></i> Activity History</button>
    </div>
</section>
<div class="pc-kpi-strip">
    <div class="pc-kpi-card @(_filter == null ? "pc-kpi-card--active" : "")" @onclick="() => SetFilter(null)" title="Show all">
        <span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-briefcase-fill"></i></span>
        <div>
            <div class="pc-kpi-value">@_items.Count</div>
            <div class="pc-kpi-label">Total</div>
        </div>
    </div>
    <div class="pc-kpi-card @(_filter == "Active" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Active")' title="Filter active">
        <span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check-circle-fill"></i></span>
        <div>
            <div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Active")</div>
            <div class="pc-kpi-label">Active</div>
        </div>
    </div>
</div>
<AppFilterPanel @bind-SearchValue="_searchTerm" OnSearch="OnSearchAsync" SearchPlaceholder="Search engagements…" />
@if (_loadError is not null) {
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}
<div class="um-grid-card">
    @if (_loading) {
        <div class="um-loading-overlay">
            <div class="um-spinner"></div><span>Loading…</span>
        </div>
    }
    <SfGrid TValue="EngagementDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52">
        <GridEvents TValue="EngagementDto" RowSelected="OnRowSelected" />
        <GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" />
        <GridColumns>
            <GridColumn Field="EngagementNumber" HeaderText="Eng #" Width="130" />
            <GridColumn Field="EngagementName" HeaderText="Name" Width="250" />
            <GridColumn Field="EngagementTypeCode" HeaderText="Type" Width="130" />
            <GridColumn Field="StartDate" HeaderText="Start" Type="ColumnType.Date" Format="d" Width="120" />
            <GridColumn Field="EndDate" HeaderText="End" Type="ColumnType.Date" Format="d" Width="120" />
            <GridColumn Field="StatusCode" HeaderText="Status" Width="120" />
            <GridColumn Field="CreatedDateUtc" HeaderText="Created" Type="ColumnType.DateTime" Format="d" Width="130" />
        </GridColumns>
    </SfGrid>
</div>
<SfDialog @bind-Visible="_showForm" Width="560px" IsModal="true" ShowCloseIcon="false">
    <DialogEvents Closed="ResetForm" />
    <DialogContent>
        <div class="um-modal-header">
            <i class="bi bi-briefcase"></i><span>New Engagement</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="um-field">
                        <label>Engagement # <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.EngagementNumber" class="um-input" />
                        <ValidationMessage For="() => _form.EngagementNumber" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Account Id <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.AccountIdText" class="um-input" />
                        <ValidationMessage For="() => _form.AccountIdText" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Name <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.EngagementName" class="um-input" />
                        <ValidationMessage For="() => _form.EngagementName" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Type <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_form.EngagementTypeCode" class="um-input" />
                        <ValidationMessage For="() => _form.EngagementTypeCode" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>Start</label>
                        <InputDate @bind-Value="_form.StartDate" class="um-input" />
                        <ValidationMessage For="() => _form.StartDate" class="text-danger" />
                    </div>
                    <div class="um-field">
                        <label>End</label>
                        <InputDate @bind-Value="_form.EndDate" class="um-input" />
                        <ValidationMessage For="() => _form.EndDate" class="text-danger" />
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Create</button>
            </div>
        </EditForm>
    </DialogContent>
</SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />
<style>
    @@keyframes um-shake {
        0%,
        100% {
            transform: translateX(0)
        }
        25% {
            transform: translateX(-4px)
        }
        75% {
            transform: translateX(4px)
        }
    }
</style>
@code {
    static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    string? _searchTerm, _loadError, _filter;
    bool _loading, _saving, _showForm;
    List<EngagementDto> _items = [], _filtered = [];
    SfToast _toast = default!;
    EngagementForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tasks & Workflows", "/tasks"), new("Engagements", null));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchEngagementsAsync(TenantId, _searchTerm);
            _items = result?.Items.ToList() ?? [];
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load engagements: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    Task OnSearchAsync() => LoadAsync();

    void ApplyFilter() => _filtered = _filter is null ? [.. _items] : _items.Where(x => x.StatusCode == _filter).ToList();

    void SetFilter(string? f)
    {
        _filter = f;
        ApplyFilter();
    }

    void OnRowSelected(RowSelectEventArgs<EngagementDto> args)
    {
    }

    void OpenCreate()
    {
        _form = new() { EngagementNumber = $"ENG-{DateTime.UtcNow:yyyyMMddHHmmss}" };
        _showForm = true;
    }

    async Task SaveAsync()
    {
        _saving = true;
        try
        {
            await Api.CreateEngagementAsync(new()
            {
                TenantId = TenantId,
                EngagementNumber = _form.EngagementNumber,
                AccountId = Guid.Parse(_form.AccountIdText),
                EngagementName = _form.EngagementName,
                EngagementTypeCode = _form.EngagementTypeCode,
                StartDate = _form.StartDate,
                EndDate = _form.EndDate
            });
            _showForm = false;
            await _toast.ShowAsync(new() { Content = "Engagement created", CssClass = "e-toast-success" });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
        finally
        {
            _saving = false;
        }
    }

    void ResetForm() => _form = new();

    sealed class EngagementForm
    {
        [Required, StringLength(50)]
        public string EngagementNumber { get; set; } = string.Empty;

        [Required, RegularExpression("^[0-9a-fA-F-]{36}$", ErrorMessage = "Enter a valid Account Id.")]
        public string AccountIdText { get; set; } = string.Empty;

        [Required, StringLength(200)]
        public string EngagementName { get; set; } = string.Empty;

        [Required, StringLength(50)]
        public string EngagementTypeCode { get; set; } = "Project";

        public DateOnly? StartDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);

        public DateOnly? EndDate { get; set; }
    }
}
