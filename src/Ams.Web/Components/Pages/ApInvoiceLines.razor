@page "/finance/ap-invoice-lines"
@inject ApiClient Api

<PageTitle>AP Invoice Lines</PageTitle>
<AppPageHeader Title="AP Invoice Lines" Icon="bi-list-ul" />
<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(ApInvoiceLineDto.LineOrder)"    HeaderText="#"          Width="70"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceLineDto.Description)"  HeaderText="Description" Width="350"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceLineDto.Quantity)"     HeaderText="Qty"         Format="N2" Width="90"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceLineDto.UnitPrice)"    HeaderText="Unit Price"  Format="C2" Width="120"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceLineDto.LineTotal)"    HeaderText="Total"       Format="C2" Width="120"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<ApInvoiceLineDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchApInvoiceLinesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
