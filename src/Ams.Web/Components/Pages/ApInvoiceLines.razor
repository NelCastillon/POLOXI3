@page "/finance/ap-invoice-lines"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>AP Invoice Lines</PageTitle>
<AppPageHeader Title="AP Invoice Lines" Icon="bi-list-ul" />
<div class="toolbar">
    <AppTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></AppTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
else {
<AppGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(ApInvoiceLineDto.LineOrder)"    HeaderText="#"          Width="70"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceLineDto.Description)"  HeaderText="Description" Width="350"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceLineDto.Quantity)"     HeaderText="Qty"         Format="N2" Width="90"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceLineDto.UnitPrice)"    HeaderText="Unit Price"  Format="C2" Width="120"></GridColumn>
        <GridColumn Field="@nameof(ApInvoiceLineDto.LineTotal)"    HeaderText="Total"       Format="C2" Width="120"></GridColumn>
    </GridColumns>
</AppGrid>
}
@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private string? _loadError;
    private List<ApInvoiceLineDto>? _items;
    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            var result = await Api.SearchApInvoiceLinesAsync(_tenantId, _searchTerm);
            _items = result?.Items.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = $"AP invoice lines failed to load: {ex.Message}";
            _items = [];
        }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
