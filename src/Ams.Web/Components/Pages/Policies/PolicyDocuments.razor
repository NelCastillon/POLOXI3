    private static bool IsPolicyDocument(DocumentDto document) =>
        string.Equals(document.EntityName, "Policy", StringComparison.OrdinalIgnoreCase)
        || IsCategory(document, "Policy")
        || IsCategory(document, "Endorsement")
        || IsCategory(document, "Certificate")
        || IsCategory(document, "Binder")
        || IsCategory(document, "Declaration")
        || TagsFor(document).Any(t => string.Equals(t, "policy", StringComparison.OrdinalIgnoreCase));

    private static bool IsCategory(DocumentDto document, string category) => string.Equals(document.CategoryCode, category, StringComparison.OrdinalIgnoreCase);
    private static string CssSafe(string? value) => string.IsNullOrWhiteSpace(value) ? "unknown" : value.Trim().ToLowerInvariant().Replace(" ", "-");
    private static string DocumentIcon(DocumentDto row) => row.CategoryCode switch
    {
        "Endorsement" => "bi-pen",
        "Certificate" => "bi-file-earmark-check",
        "Binder" => "bi-journal-bookmark",
        "Declaration" => "bi-card-checklist",
        _ => "bi-file-earmark-pdf"
    };

    private static IReadOnlyList<string> TagsFor(DocumentDto row) => string.IsNullOrWhiteSpace(row.Tags)
        ? []
        : row.Tags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

    private static string ShortTags(DocumentDto row)
    {
        var tags = TagsFor(row).Take(3).ToArray();
        return tags.Length == 0 ? "â€”" : string.Join(", ", tags);
    }

    private static string EnsurePolicyTag(string? tags)
    {
        var items = (tags ?? string.Empty).Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        if (!items.Any(x => string.Equals(x, "policy", StringComparison.OrdinalIgnoreCase)))
        {
            items.Insert(0, "policy");
        }
        return string.Join(", ", items.Distinct(StringComparer.OrdinalIgnoreCase));
    }

    private static string RetentionLabel(DocumentDto row)
    {
        if (row.RetentionDate is null) return "No retention";
        var days = row.RetentionDate.Value.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
        return days < 0 ? "Retention due" : days <= 30 ? "Due soon" : row.RetentionDate.Value.ToString("MM/dd/yyyy");
    }

    private static string RetentionClass(DocumentDto row)
    {
        if (row.RetentionDate is null) return "pd-retention-none";
        var days = row.RetentionDate.Value.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber;
        return days < 0 ? "pd-retention-overdue" : days <= 30 ? "pd-retention-soon" : "pd-retention-ok";
    }

    private static IEnumerable<BreakdownRow> BuildBreakdown(IEnumerable<IGrouping<string, DocumentDto>> groups)
    {
        var rows = groups.Select(g => new { Label = g.Key, Count = g.Count() }).OrderByDescending(g => g.Count).ThenBy(g => g.Label).Take(8).ToList();
        var max = Math.Max(1, rows.Count == 0 ? 1 : rows.Max(r => r.Count));
        return rows.Select(r => new BreakdownRow(r.Label, r.Count, Math.Clamp(r.Count * 100 / max, 8, 100)));
    }

    private static string AvatarClass(string name) => $"pd-av{Math.Abs(name.GetHashCode()) % 6 + 1}";

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F1} GB";
    }

