@page "/policies/documents"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Documents
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Policy Documents â€” AMS Enterprise</PageTitle>

@if (_toastVisible)
{
    <div class="pd-toast pd-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="pd-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showUpload)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseUpload">
        <div class="mt-modal pd-action-modal" role="dialog" aria-modal="true" aria-labelledby="pd-upload-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-cloud-arrow-up-fill" aria-hidden="true"></i>
                <span id="pd-upload-title">Upload Policy Document</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseUpload" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_uploadForm" OnValidSubmit="UploadAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="pd-modal-intro">
                        <span class="pd-modal-chip"><i class="bi bi-folder2-open" aria-hidden="true"></i> Policy document vault</span>
                        <p>Upload declarations, certificates, endorsements, binders, cancellation notices, and retained policy workflow files.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full pd-dlg-section">Document File</div>
                        <div class="um-field um-field--full">
                            <label>File <span class="text-danger">*</span></label>
                            <InputFile class="form-control" OnChange="OnUploadFileSelected" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.tif,.tiff" />
                            @if (_uploadFile is not null)
                            {
                                <div class="pd-file-note"><i class="bi bi-paperclip" aria-hidden="true"></i>@_uploadFile.Name Â· @FormatFileSize(_uploadFile.Size)</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_fileError))
                            {
                                <div class="text-danger mt-1">@_fileError</div>
                            }
                        </div>

                        <div class="um-field um-field--full pd-dlg-section">Indexing & Workflow</div>
                        <div class="um-field">
                            <label>Document Name <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_uploadForm.FileName" />
                        </div>
                        <div class="um-field">
                            <label>Document Type <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_uploadForm.DocumentTypeCode">
                                @foreach (var type in DocumentTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Category <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_uploadForm.CategoryCode">
                                @foreach (var category in Categories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Retention Date</label>
                            <InputDate class="form-control" @bind-Value="_uploadForm.RetentionDate" />
                        </div>
                        <div class="um-field">
                            <label>Tags</label>
                            <InputText class="form-control" @bind-Value="_uploadForm.Tags" />
                        </div>
                        <div class="um-field">
                            <label>Uploaded By</label>
                            <input class="form-control pd-readonly-input" value="@_uploadedByName" disabled />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Description</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_uploadForm.Description" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseUpload" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        Upload Document
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showMetadata)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseMetadata">
        <div class="mt-modal pd-action-modal" role="dialog" aria-modal="true" aria-labelledby="pd-metadata-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                <span id="pd-metadata-title">Edit Document Metadata</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseMetadata" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_metadataForm" OnValidSubmit="SaveMetadataAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="pd-modal-intro">
                        <span class="pd-modal-chip"><i class="bi bi-tags" aria-hidden="true"></i> Metadata workflow</span>
                        <p>Update retention, tags, and description for the selected policy document without changing the stored file.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Document</label>
                            <input class="form-control pd-readonly-input" value="@_selected?.FileName" disabled />
                        </div>
                        <div class="um-field">
                            <label>Retention Date</label>
                            <InputDate class="form-control" @bind-Value="_metadataForm.RetentionDate" />
                        </div>
                        <div class="um-field">
                            <label>Tags</label>
                            <InputText class="form-control" @bind-Value="_metadataForm.Tags" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Description</label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_metadataForm.Description" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseMetadata" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">Save Metadata</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showRename)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseRename">
        <div class="mt-modal pd-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="pd-rename-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-input-cursor-text" aria-hidden="true"></i>
                <span id="pd-rename-title">Rename Document</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseRename" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_renameForm" OnValidSubmit="RenameAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="um-field">
                        <label>New File Name <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="_renameForm.NewFileName" />
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseRename" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">Rename</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showVersion)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseVersion">
        <div class="mt-modal pd-action-modal" role="dialog" aria-modal="true" aria-labelledby="pd-version-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-files" aria-hidden="true"></i>
                <span id="pd-version-title">Upload New Version</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseVersion" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_versionForm" OnValidSubmit="UploadVersionAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="pd-modal-intro">
                        <span class="pd-modal-chip"><i class="bi bi-diagram-3" aria-hidden="true"></i> Version control</span>
                        <p>Replace the current file and preserve a new document version in the enterprise document vault.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Version File <span class="text-danger">*</span></label>
                            <InputFile class="form-control" OnChange="OnVersionFileSelected" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.tif,.tiff" />
                            @if (_versionFile is not null)
                            {
                                <div class="pd-file-note"><i class="bi bi-paperclip" aria-hidden="true"></i>@_versionFile.Name Â· @FormatFileSize(_versionFile.Size)</div>
                            }
                        </div>
                        <div class="um-field um-field--full">
                            <label>Change Notes</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_versionForm.ChangeNotes" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseVersion" disabled="@_busy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">Upload Version</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showShare)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseShare">
        <div class="mt-modal pd-action-modal" role="dialog" aria-modal="true" aria-labelledby="pd-share-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-share-fill" aria-hidden="true"></i>
                <span id="pd-share-title">Secure Share Link</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseShare" disabled="@_busy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_shareForm" OnValidSubmit="CreateShareLinkAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="pd-modal-intro">
                        <span class="pd-modal-chip"><i class="bi bi-link-45deg" aria-hidden="true"></i> Controlled access</span>
                        <p>Create time-bound, auditable access to the selected policy document.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field">
                            <label>Expires <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="_shareForm.ExpiresDate" />
                        </div>
                        <div class="um-field">
                            <label>Max Access Count</label>
                            <InputNumber class="form-control" @bind-Value="_shareForm.MaxAccessCount" />
                        </div>
                        <div class="um-field pd-check-field">
                            <label class="pd-check-label"><InputCheckbox @bind-Value="_shareForm.RequiresPin" /> Require PIN</label>
                        </div>
                        <div class="um-field">
                            <label>PIN</label>
                            <InputText class="form-control" @bind-Value="_shareForm.Pin" disabled="@(!_shareForm.RequiresPin)" />
                        </div>
                    </div>
                    @if (_shareLinks.Any())
                    {
                        <div class="pd-dlg-section mt-3">Existing Share Links</div>
                        <div class="pd-mini-list">
                            @foreach (var link in _shareLinks.Take(5))
                            {
                                <div class="pd-mini-item">
                                    <strong>@link.Token</strong>
                                    <span>Expires @link.ExpiresDateUtc.ToLocalTime().ToString("MM/dd/yyyy") Â· @link.AccessCount access(es)@(link.IsRevoked ? " Â· Revoked" : string.Empty)</span>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseShare" disabled="@_busy">Close</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_busy">Create Link</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showDelete)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseDelete">
        <div class="mt-modal pd-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="pd-delete-title" @onclick:stopPropagation="true">
            <div class="um-confirm-dialog">
                <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash3-fill" aria-hidden="true"></i></div>
                <div class="um-confirm-message">
                    <h6 id="pd-delete-title">Delete Document?</h6>
                    <p>You are about to delete <strong>@_selected?.FileName</strong>. This action removes the document from active workflows.</p>
                </div>
                <div class="um-modal-footer w-100">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseDelete" disabled="@_busy">Cancel</button>
                    <button type="button" class="um-btn um-btn-danger" @onclick="DeleteAsync" disabled="@_busy">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="pd-enterprise-page" @onclick="CloseActionMenu">
    <section class="pd-hero" aria-label="Policy documents enterprise header">
        <div class="pd-hero-left">
            <div class="pd-hero-icon"><i class="bi bi-folder2-open" aria-hidden="true"></i></div>
            <div>
                <div class="pd-title-row">
                    <h1>Policy Documents</h1>
                    <span><i class="bi bi-stack" aria-hidden="true"></i>@FilteredRows.Count() visible</span>
                    @if (HasFilters)
                    {
                        <span><i class="bi bi-funnel" aria-hidden="true"></i>Filtered</span>
                    }
                </div>
                <p>Enterprise policy document vault for declarations, binders, endorsements, certificates, cancellations, retention, sharing, and version-controlled service workflows.</p>
            </div>
        </div>
        <div class="pd-hero-actions">
            <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "pd-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-primary" @onclick="OpenUpload"><i class="bi bi-upload" aria-hidden="true"></i> Upload Document</button>
            <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/policies")'><i class="bi bi-shield-check" aria-hidden="true"></i> Policies</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger pd-load-error" style="border-left: 4px solid #dc3545; animation: pd-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div>
    }

    <section class="pd-kpi-strip" aria-label="Policy document KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="pd-kpi-card pd-@kpi.Tone @(_kpiFilter == kpi.Filter ? "pd-kpi-card-active" : null)" title="@kpi.Tooltip" @onclick="() => SetKpiFilter(kpi.Filter)">
                <span class="pd-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span><strong class="pd-kpi-val">@kpi.Value</strong><span class="pd-kpi-lbl">@kpi.Label</span><small>@kpi.Detail</small></span>
            </button>
        }
    </section>

    <section class="pd-workflow-strip" aria-label="Policy document workflow shortcuts">
        @foreach (var shortcut in WorkflowShortcuts)
        {
            <button type="button" class="pd-workflow-card" @onclick="shortcut.Callback">
                <i class="bi @shortcut.Icon" aria-hidden="true"></i>
                <span><strong>@shortcut.Title</strong><small>@shortcut.Detail</small></span>
            </button>
        }
    </section>

    <section class="pd-search-panel" role="search" aria-label="Search policy documents">
        <div class="pd-search-wrap">
            <div class="pd-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
            <div class="pd-search-body">
                <label for="pd-search-input">Enterprise search</label>
                <input id="pd-search-input" class="pd-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search file name, category, type, tags, status, uploader, description, dates..." />
                <span class="pd-search-hint">Searches all document vault and workflow fields as you type.</span>
            </div>
        </div>
        <select class="pd-filter-select" aria-label="Category filter" @bind="_categoryFilter" @bind:after="OnFilterChanged">
            <option value="">All categories</option>
            @foreach (var category in Categories)
            {
                <option value="@category">@category</option>
            }
        </select>
        <select class="pd-filter-select" aria-label="Document type filter" @bind="_typeFilter" @bind:after="OnFilterChanged">
            <option value="">All types</option>
            @foreach (var type in DocumentTypes)
            {
                <option value="@type">@type</option>
            }
        </select>
        <select class="pd-filter-select" aria-label="Status filter" @bind="_statusFilter" @bind:after="OnFilterChanged">
            <option value="">All statuses</option>
            <option value="Active">Active</option>
            <option value="Archived">Archived</option>
            <option value="Pending Review">Pending Review</option>
        </select>
        <div class="pd-search-result"><strong>@FilteredRows.Count()</strong><span>matches</span></div>
        @if (HasFilters)
        {
            <button type="button" class="um-btn um-btn-ghost um-btn-sm pd-search-clear" @onclick="ClearFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
        }
    </section>

    <div class="pd-bulk-bar">
        <span><i class="bi bi-diagram-3" aria-hidden="true"></i> @WorkflowSummary</span>
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/endorsements")'><i class="bi bi-pen" aria-hidden="true"></i> Endorsements</button>
        <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/cancellations")'><i class="bi bi-x-circle" aria-hidden="true"></i> Cancellations</button>
        <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => SetActiveTab("board")'><i class="bi bi-kanban" aria-hidden="true"></i> Board</button>
    </div>

    <div class="pd-view-tabs" role="tablist" aria-label="Policy document views">
        @foreach (var tab in _tabs)
        {
            <button class="pd-view-btn @(_activeTab == tab.Key ? "pd-view-btn-active" : null)" type="button" role="tab" aria-selected="@(_activeTab == tab.Key)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i> @tab.Label <span>@TabCount(tab.Key)</span>
            </button>
        }
    </div>

    <section class="pd-content-layout">
        <div class="pd-main-card">
            @if (_loading)
            {
                <div class="pd-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Loading policy documents...</span></div>
            }
            else if (!PagedRows.Any())
            {
                <div class="pd-empty-state"><i class="bi bi-folder-x" aria-hidden="true"></i><strong>No policy documents found</strong><span>Upload a document or adjust the current tab, KPI, or search criteria.</span></div>
            }
            else if (_activeTab == "board")
            {
                <div class="pd-board" aria-label="Policy document workflow board">
                    @foreach (var group in BoardGroups)
                    {
                        <section class="pd-board-col">
                            <header><strong>@group.Label</strong><span>@group.Rows.Count</span></header>
                            @foreach (var row in group.Rows.Take(8))
                            {
                                <article class="pd-board-card" @onclick="() => OpenDetailAsync(row)">
                                    <div><strong>@row.FileName</strong><span class="pd-status pd-status-@CssSafe(row.StatusCode)">@row.StatusCode</span></div>
                                    <span>@row.CategoryCode · @row.DocumentTypeCode</span>
                                    <small>v@row.VersionNumber · @FormatFileSize(row.FileSizeBytes ?? 0) · @RetentionLabel(row)</small>
                                </article>
                            }
                        </section>
                    }
                </div>
            }
            else if (_activeTab == "analytics")
            {
                <div class="pd-analytics-grid">
                    <section>
                        <h3>Category concentration</h3>
                        @foreach (var row in CategoryBreakdown)
                        {
                            <button type="button" class="pd-stage-row @(string.Equals(_categoryFilter, row.Label, StringComparison.OrdinalIgnoreCase) ? "pd-active" : null)" @onclick="() => SetCategoryFilter(row.Label)"><span>@row.Label</span><div><i style="width:@row.Percent%"></i></div><strong>@row.Count</strong></button>
                        }
                    </section>
                    <section>
                        <h3>Type distribution</h3>
                        @foreach (var row in TypeBreakdown)
                        {
                            <button type="button" class="pd-stage-row @(string.Equals(_typeFilter, row.Label, StringComparison.OrdinalIgnoreCase) ? "pd-active" : null)" @onclick="() => SetTypeFilter(row.Label)"><span>@row.Label</span><div><i style="width:@row.Percent%"></i></div><strong>@row.Count</strong></button>
                        }
                    </section>
                </div>
            }
            else
            {
                <div class="pd-table-scroll">
                    <table class="pd-table" aria-label="Policy documents register">
                        <thead>
                            <tr>
                                <th>Document</th>
                                <th>Category</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th class="pd-number">Size</th>
                                <th>Version</th>
                                <th>Uploaded</th>
                                <th>Uploaded By</th>
                                <th>Retention</th>
                                <th>Tags</th>
                                <th class="pd-actions-col"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in PagedRows)
                            {
                                <tr class="@(_drawerRow?.DocumentId == row.DocumentId ? "pd-row-selected" : null)" @onclick="() => OpenDetailAsync(row)">
                                    <td><div class="pd-name-cell"><span class="pd-avatar @AvatarClass(row.FileName)"><i class="bi @DocumentIcon(row)" aria-hidden="true"></i></span><div><strong>@row.FileName</strong><small>@(row.Description ?? "Policy document")</small></div></div></td>
                                    <td><span class="pd-category-chip pd-category-@CssSafe(row.CategoryCode)">@row.CategoryCode</span></td>
                                    <td>@row.DocumentTypeCode</td>
                                    <td><span class="pd-status pd-status-@CssSafe(row.StatusCode)">@row.StatusCode</span></td>
                                    <td class="pd-number">@FormatFileSize(row.FileSizeBytes ?? 0)</td>
                                    <td><span class="pd-doc-count">v@row.VersionNumber</span></td>
                                    <td>@row.CreatedDateUtc.ToLocalTime().ToString("MM/dd/yyyy")</td>
                                    <td>@(row.UploadedByName ?? "—")</td>
                                    <td>@RetentionCell(row)</td>
                                    <td><span class="pd-tags-inline">@ShortTags(row)</span></td>
                                    <td class="pd-actions-col">@CtxBtn(row)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="pd-pager">
                    <span>@PageSummary</span>
                    <div>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left" aria-hidden="true"></i> Previous</button>
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right" aria-hidden="true"></i></button>
                    </div>
                </div>
            }
        </div>
        <aside class="pd-detail-card">
            @if (_drawerRow is null)
            {
                <div class="pd-detail-empty"><i class="bi bi-layout-sidebar-inset-reverse" aria-hidden="true"></i><strong>Select a document</strong><span>Click a document row to review metadata, versions, sharing, audit events, and service actions.</span></div>
            }
            else
            {
                <div class="pd-detail-head">
                    <div>
                        <span class="pd-detail-eyebrow"><i class="bi @DocumentIcon(_drawerRow)" aria-hidden="true"></i> @_drawerRow.CategoryCode</span>
                        <h2>@_drawerRow.FileName</h2>
                        <p>@_drawerRow.DocumentTypeCode · v@_drawerRow.VersionNumber · @_drawerRow.StatusCode</p>
                    </div>
                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseDrawer" aria-label="Close details"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="pd-detail-body">
                    <div class="pd-detail-summary">
                        <div><span>Size</span><strong>@FormatFileSize(_drawerRow.FileSizeBytes ?? 0)</strong></div>
                        <div><span>Retention</span><strong>@RetentionLabel(_drawerRow)</strong></div>
                        <div><span>Uploaded</span><strong>@_drawerRow.CreatedDateUtc.ToLocalTime().ToString("MM/dd/yyyy")</strong></div>
                        <div><span>Uploaded by</span><strong>@(_drawerRow.UploadedByName ?? "—")</strong></div>
                    </div>
                    <div class="pd-contact-card"><strong>Description</strong><span>@(string.IsNullOrWhiteSpace(_drawerRow.Description) ? "No description has been provided." : _drawerRow.Description)</span></div>
                    <div class="pd-tag-list">
                        @foreach (var tag in TagsFor(_drawerRow))
                        {
                            <span>@tag</span>
                        }
                    </div>
                    <section class="pd-detail-timeline">
                        <h3><i class="bi bi-files" aria-hidden="true"></i> Versions</h3>
                        @foreach (var version in _versions.Take(4))
                        {
                            <div class="pd-mini-item"><strong>v@version.VersionNumber · @version.FileName</strong><span>@FormatFileSize(version.FileSizeBytes ?? 0) · @version.CreatedDateUtc.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</span></div>
                        }
                    </section>
                    <section class="pd-detail-timeline">
                        <h3><i class="bi bi-clock-history" aria-hidden="true"></i> Audit Log</h3>
                        @foreach (var log in _accessLog.Take(4))
                        {
                            <div class="pd-timeline-item"><span class="pd-timeline-dot"></span><div><strong>@log.ActionCode</strong><span>@log.AccessDateUtc.ToLocalTime().ToString("MM/dd/yyyy h:mm tt") · @(log.IpAddress ?? "system")</span></div></div>
                        }
                    </section>
                    <div class="pd-detail-actions">
                        <div class="pd-detail-actions-row">
                            <button class="um-btn um-btn-primary um-btn-sm" @onclick="() => DownloadDocument(_drawerRow)"><i class="bi bi-download" aria-hidden="true"></i> Download</button>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenMetadata(_drawerRow)"><i class="bi bi-pencil-square" aria-hidden="true"></i> Metadata</button>
                            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenVersion(_drawerRow)"><i class="bi bi-files" aria-hidden="true"></i> Version</button>
                        </div>
                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenShareAsync(_drawerRow)"><i class="bi bi-share" aria-hidden="true"></i> Secure Share</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@if (_openActionMenuFor is not null)
{
    <div class="pd-context-menu" style="left:@_menuXpx; top:@_menuYpx" @onclick:stopPropagation="true">
        <button type="button" @onclick='() => ExecuteMenuActionAsync("View")'><i class="bi bi-eye" aria-hidden="true"></i><span>View details</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Download")'><i class="bi bi-download" aria-hidden="true"></i><span>Download</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Metadata")'><i class="bi bi-pencil-square" aria-hidden="true"></i><span>Edit metadata</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Rename")'><i class="bi bi-input-cursor-text" aria-hidden="true"></i><span>Rename</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Version")'><i class="bi bi-files" aria-hidden="true"></i><span>Upload new version</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Share")'><i class="bi bi-share" aria-hidden="true"></i><span>Secure share link</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Audit")'><i class="bi bi-clock-history" aria-hidden="true"></i><span>Audit log</span></button>
        <button type="button" @onclick='() => ExecuteMenuActionAsync("Archive")' disabled="@IsSelectedArchived"><i class="bi bi-archive" aria-hidden="true"></i><span>Archive</span></button>
        <button type="button" class="pd-menu-danger" @onclick='() => ExecuteMenuActionAsync("Delete")'><i class="bi bi-trash" aria-hidden="true"></i><span>Delete</span></button>
    </div>
}

@code {
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading;
    private bool _busy;
    private bool _toastVisible;
    private bool _showUpload;
    private bool _showMetadata;
    private bool _showRename;
    private bool _showVersion;
    private bool _showShare;
    private bool _showDelete;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private string? _searchText;
    private string? _kpiFilter;
    private string? _categoryFilter;
    private string? _typeFilter;
    private string? _statusFilter;
    private string _activeTab = "all";
    private string _uploadedByName = "Current user";
    private Guid? _openActionMenuFor;
    private string _menuXpx = "0px";
    private string _menuYpx = "0px";
    private int _page = 1;
    private const int PageSize = 20;
    private const long MaxUploadBytes = 104_857_600;

    private readonly List<DocumentDto> _rows = [];
    private readonly List<DocumentVersionDto> _versions = [];
    private readonly List<DocumentShareLinkDto> _shareLinks = [];
    private readonly List<DocumentAccessLogDto> _accessLog = [];

    private DocumentDto? _selected;
    private DocumentDto? _drawerRow;
    private IBrowserFile? _uploadFile;
    private IBrowserFile? _versionFile;
    private string? _fileError;
    private UploadForm _uploadForm = new();
    private MetadataForm _metadataForm = new();
    private RenameForm _renameForm = new();
    private VersionForm _versionForm = new();
    private ShareForm _shareForm = new();

    private static readonly string[] Categories = ["Policy", "Endorsement", "Certificate", "Binder", "Declaration"];
    private static readonly string[] DocumentTypes = ["Declarations", "Policy", "Endorsement", "Certificate", "Binder", "Cancellation Notice", "Reinstatement Notice", "Claims Supplement", "Audit", "Other"];

    private readonly TabDef[] _tabs =
    [
        new("all", "All", "bi-stack"),
        new("active", "Active", "bi-shield-check"),
        new("policy", "Policy", "bi-journal-check"),
        new("endorsement", "Endorsements", "bi-pen"),
        new("certificate", "Certificates", "bi-file-earmark-check"),
        new("binder", "Binders", "bi-journal-bookmark"),
        new("archived", "Archived", "bi-archive"),
        new("retention", "Retention", "bi-calendar-check"),
        new("board", "Board", "bi-kanban"),
        new("analytics", "Analytics", "bi-bar-chart")
    ];

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policies", "/policies"), new("Policy Documents", null));
        await LoadAsync();
    }

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _uploadedByName = user.FindFirst(ClaimTypes.Name)?.Value
            ?? user.FindFirst("user_name")?.Value
            ?? user.FindFirst(ClaimTypes.Email)?.Value
            ?? "Current user";
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchDocumentsAsync(tenantId: _tenantId, entityName: "Policy", searchTerm: null);
            _rows.Clear();
            _rows.AddRange((result?.Items ?? []).Where(IsPolicyDocument).OrderByDescending(x => x.CreatedDateUtc));
            _page = 1;
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load policy documents: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string? SearchText
    {
        get => _searchText;
        set
        {
            _searchText = value;
            _page = 1;
        }
    }

    private IEnumerable<DocumentDto> FilteredRows => _rows.Where(MatchesActiveTab).Where(MatchesKpiFilter).Where(MatchesEnterpriseFilters).Where(MatchesSearch).ToList();
    private IEnumerable<DocumentDto> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)PageSize));
    private bool HasFilters => !string.IsNullOrWhiteSpace(_searchText) || _activeTab != "all" || _kpiFilter is not null || !string.IsNullOrWhiteSpace(_categoryFilter) || !string.IsNullOrWhiteSpace(_typeFilter) || !string.IsNullOrWhiteSpace(_statusFilter);
    private bool IsSelectedArchived => _selected?.StatusCode == "Archived";
    private string PageSummary => $"Page {_page} of {TotalPages} · {FilteredRows.Count()} records";
    private string WorkflowSummary => $"{FilteredRows.Count():N0} documents · {_rows.Sum(r => Math.Max(r.VersionNumber, 1)):N0} retained versions · {FormatFileSize(_rows.Sum(r => r.FileSizeBytes ?? 0))}";
    private IEnumerable<KpiDef> Kpis =>
    [
        new("bi-folder2-open", "Total", _rows.Count.ToString("N0"), "documents", "Show all policy documents", "blue", null),
        new("bi-shield-check", "Policy Forms", _rows.Count(r => IsCategory(r, "Policy")).ToString("N0"), "issued", "Filter to policy form documents", "blue", "Policy"),
        new("bi-pen", "Endorsements", _rows.Count(r => IsCategory(r, "Endorsement")).ToString("N0"), "changes", "Filter to endorsements", "purple", "Endorsement"),
        new("bi-file-earmark-check", "Certificates", _rows.Count(r => IsCategory(r, "Certificate")).ToString("N0"), "coi", "Filter to certificates", "green", "Certificate"),
        new("bi-journal-bookmark", "Binders", _rows.Count(r => IsCategory(r, "Binder")).ToString("N0"), "bound", "Filter to binders", "amber", "Binder"),
        new("bi-archive", "Archived", _rows.Count(r => r.StatusCode == "Archived").ToString("N0"), "retained", "Filter to archived documents", "slate", "__archived"),
        new("bi-hdd", "Vault Size", FormatFileSize(_rows.Sum(r => r.FileSizeBytes ?? 0)), "stored", "Show document storage footprint", "cyan", "__size")
    ];
    private IEnumerable<WorkflowShortcut> WorkflowShortcuts =>
    [
        new("Upload document", "Index a new policy document", "bi-upload", OpenUpload),
        new("Retention queue", $"{_rows.Count(r => r.RetentionDate is not null):N0} retained document(s)", "bi-calendar-check", () => SetActiveTab("retention")),
        new("Version board", $"{_rows.Sum(r => Math.Max(r.VersionNumber, 1)):N0} total version(s)", "bi-kanban", () => SetActiveTab("board")),
        new("Analytics", "Review category and type concentration", "bi-bar-chart", () => SetActiveTab("analytics"))
    ];
    private IEnumerable<BoardGroup> BoardGroups =>
    [
        new("Active", FilteredRows.Where(r => r.StatusCode == "Active").ToList()),
        new("Retention", FilteredRows.Where(r => r.RetentionDate is not null && r.StatusCode != "Archived").ToList()),
        new("Versioned", FilteredRows.Where(r => r.VersionNumber > 1).ToList()),
        new("Archived", FilteredRows.Where(r => r.StatusCode == "Archived").ToList())
    ];
    private IEnumerable<BreakdownRow> CategoryBreakdown => BuildBreakdown(FilteredRows.Where(r => !string.IsNullOrWhiteSpace(r.CategoryCode)).GroupBy(r => r.CategoryCode));
    private IEnumerable<BreakdownRow> TypeBreakdown => BuildBreakdown(FilteredRows.Where(r => !string.IsNullOrWhiteSpace(r.DocumentTypeCode)).GroupBy(r => r.DocumentTypeCode));

    private bool MatchesActiveTab(DocumentDto row) => _activeTab switch
    {
        "active" => row.StatusCode == "Active",
        "policy" => IsCategory(row, "Policy"),
        "endorsement" => IsCategory(row, "Endorsement"),
        "certificate" => IsCategory(row, "Certificate"),
        "binder" => IsCategory(row, "Binder"),
        "archived" => row.StatusCode == "Archived",
        "retention" => row.RetentionDate is not null,
        "board" => true,
        "analytics" => true,
        _ => true
    };

    private bool MatchesKpiFilter(DocumentDto row) => _kpiFilter switch
    {
        null => true,
        "__archived" => row.StatusCode == "Archived",
        "__size" => true,
        _ => IsCategory(row, _kpiFilter)
    };

    private bool MatchesEnterpriseFilters(DocumentDto row) =>
        (string.IsNullOrWhiteSpace(_categoryFilter) || string.Equals(row.CategoryCode, _categoryFilter, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(_typeFilter) || string.Equals(row.DocumentTypeCode, _typeFilter, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(_statusFilter) || string.Equals(row.StatusCode, _statusFilter, StringComparison.OrdinalIgnoreCase));

    private bool MatchesSearch(DocumentDto row)
    {
        if (string.IsNullOrWhiteSpace(_searchText)) return true;
        var s = _searchText.Trim();
        return Contains(row.FileName, s)
            || Contains(row.CategoryCode, s)
            || Contains(row.DocumentTypeCode, s)
            || Contains(row.StatusCode, s)
            || Contains(row.Description, s)
            || Contains(row.Tags, s)
            || Contains(row.UploadedByName, s)
            || Contains(row.EntityName, s)
            || Contains(row.CreatedDateUtc.ToLocalTime().ToString("MM/dd/yyyy"), s)
            || Contains(row.RetentionDate?.ToString("MM/dd/yyyy"), s);
    }

    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;

    private void SetActiveTab(string key)
    {
        _activeTab = key;
        _kpiFilter = null;
        _page = 1;
    }

    private void SetKpiFilter(string? key)
    {
        _kpiFilter = key;
        _page = 1;
    }

    private void ClearFilters()
    {
        _searchText = null;
        _kpiFilter = null;
        _categoryFilter = null;
        _typeFilter = null;
        _statusFilter = null;
        _activeTab = "all";
        _page = 1;
    }

    private void OnFilterChanged() => _page = 1;
    private void SetCategoryFilter(string category) { _categoryFilter = string.Equals(_categoryFilter, category, StringComparison.OrdinalIgnoreCase) ? null : category; _page = 1; }
    private void SetTypeFilter(string type) { _typeFilter = string.Equals(_typeFilter, type, StringComparison.OrdinalIgnoreCase) ? null : type; _page = 1; }

    private void PreviousPage() => _page = Math.Max(1, _page - 1);
    private void NextPage() => _page = Math.Min(TotalPages, _page + 1);

    private int TabCount(string key) => key switch
    {
        "active" => _rows.Count(r => r.StatusCode == "Active"),
        "policy" => _rows.Count(r => IsCategory(r, "Policy")),
        "endorsement" => _rows.Count(r => IsCategory(r, "Endorsement")),
        "certificate" => _rows.Count(r => IsCategory(r, "Certificate")),
        "binder" => _rows.Count(r => IsCategory(r, "Binder")),
        "archived" => _rows.Count(r => r.StatusCode == "Archived"),
        "retention" => _rows.Count(r => r.RetentionDate is not null),
        "board" => _rows.Count(r => r.StatusCode == "Active" || r.VersionNumber > 1 || r.RetentionDate is not null),
        "analytics" => _rows.Select(r => r.CategoryCode).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
        _ => _rows.Count
    };

    private void OpenUpload()
    {
        _uploadForm = new();
        _uploadFile = null;
        _fileError = null;
        _showUpload = true;
    }

    private void CloseUpload() => _showUpload = false;

    private void OnUploadFileSelected(InputFileChangeEventArgs args)
    {
        _fileError = null;
        _uploadFile = args.File;
        if (_uploadFile.Size > MaxUploadBytes)
        {
            _fileError = "The selected file is larger than the 100 MB upload limit.";
            _uploadFile = null;
            return;
        }

        _uploadForm.FileName = _uploadFile.Name;
    }

    private async Task UploadAsync()
    {
        if (_uploadFile is null)
        {
            _fileError = "Select a document file to upload.";
            return;
        }

        _busy = true;
        try
        {
            await using var stream = _uploadFile.OpenReadStream(MaxUploadBytes);
            await Api.UploadDocumentAsync(new ApiClient.UploadDocumentRequest
            {
                TenantId = _tenantId,
                DocumentTypeCode = _uploadForm.DocumentTypeCode,
                CategoryCode = _uploadForm.CategoryCode,
                FileName = _uploadForm.FileName,
                OriginalFileName = _uploadFile.Name,
                EntityName = "Policy",
                Description = _uploadForm.Description,
                Tags = EnsurePolicyTag(_uploadForm.Tags),
                RetentionDate = _uploadForm.RetentionDate,
                UploadedByName = _uploadedByName,
                CreatedByUserId = _tenantAdminUserId,
                Content = stream
            });
            _showUpload = false;
            ShowToast("Document uploaded successfully.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Upload failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenMetadata(DocumentDto row)
    {
        _selected = row;
        _metadataForm = new MetadataForm { Description = row.Description, Tags = row.Tags, RetentionDate = row.RetentionDate };
        _showMetadata = true;
    }

    private void CloseMetadata() => _showMetadata = false;

    private async Task SaveMetadataAsync()
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            await Api.UpdateDocumentMetadataAsync(new UpdateDocumentMetadataRequest
            {
                DocumentId = _selected.DocumentId,
                Description = _metadataForm.Description,
                Tags = EnsurePolicyTag(_metadataForm.Tags),
                RetentionDate = _metadataForm.RetentionDate,
                ModifiedByUserId = _tenantAdminUserId
            });
            _showMetadata = false;
            ShowToast("Document metadata updated.");
            await LoadAsync();
            await RefreshDrawerAsync(_selected.DocumentId);
        }
        catch (Exception ex)
        {
            ShowToast($"Metadata update failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenRename(DocumentDto row)
    {
        _selected = row;
        _renameForm = new RenameForm { NewFileName = row.FileName };
        _showRename = true;
    }

    private void CloseRename() => _showRename = false;

    private async Task RenameAsync()
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            await Api.RenameDocumentAsync(new RenameDocumentRequest { DocumentId = _selected.DocumentId, NewFileName = _renameForm.NewFileName, ModifiedByUserId = _tenantAdminUserId });
            _showRename = false;
            ShowToast("Document renamed.");
            await LoadAsync();
            await RefreshDrawerAsync(_selected.DocumentId);
        }
        catch (Exception ex)
        {
            ShowToast($"Rename failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenVersion(DocumentDto row)
    {
        _selected = row;
        _versionFile = null;
        _versionForm = new VersionForm { ChangeNotes = "Updated policy document version" };
        _showVersion = true;
    }

    private void CloseVersion() => _showVersion = false;

    private void OnVersionFileSelected(InputFileChangeEventArgs args)
    {
        _versionFile = args.File;
        if (_versionFile.Size > MaxUploadBytes)
        {
            ShowToast("The selected version file is larger than the 100 MB upload limit.", "danger");
            _versionFile = null;
        }
    }

    private async Task UploadVersionAsync()
    {
        if (_selected is null) return;
        if (_versionFile is null)
        {
            ShowToast("Select a file for the new version.", "danger");
            return;
        }

        _busy = true;
        try
        {
            await using var stream = _versionFile.OpenReadStream(MaxUploadBytes);
            await Api.UploadDocumentVersionAsync(_selected.DocumentId, new ApiClient.UploadDocumentVersionRequest
            {
                FileName = _versionFile.Name,
                OriginalFileName = _versionFile.Name,
                ChangeNotes = _versionForm.ChangeNotes,
                CreatedByUserId = _tenantAdminUserId,
                Content = stream
            });
            _showVersion = false;
            ShowToast("New document version uploaded.");
            await LoadAsync();
            await RefreshDrawerAsync(_selected.DocumentId);
        }
        catch (Exception ex)
        {
            ShowToast($"Version upload failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenShareAsync(DocumentDto row)
    {
        _selected = row;
        _shareForm = new ShareForm { ExpiresDate = DateOnly.FromDateTime(DateTime.Today.AddDays(14)), MaxAccessCount = 10 };
        await LoadShareLinksAsync(row.DocumentId);
        _showShare = true;
    }

    private void CloseShare() => _showShare = false;

    private async Task CreateShareLinkAsync()
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            await Api.CreateDocumentShareLinkAsync(new CreateDocumentShareLinkRequest
            {
                TenantId = _tenantId,
                DocumentId = _selected.DocumentId,
                CreatedByUserId = _tenantAdminUserId,
                ExpiresDateUtc = _shareForm.ExpiresDate.ToDateTime(TimeOnly.MaxValue).ToUniversalTime(),
                MaxAccessCount = _shareForm.MaxAccessCount,
                RequiresPin = _shareForm.RequiresPin,
                Pin = _shareForm.Pin
            });
            await LoadShareLinksAsync(_selected.DocumentId);
            ShowToast("Secure share link created.");
        }
        catch (Exception ex)
        {
            ShowToast($"Share link failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadShareLinksAsync(Guid documentId)
    {
        _shareLinks.Clear();
        var links = await Api.GetDocumentShareLinksAsync(documentId);
        _shareLinks.AddRange(links ?? []);
    }

    private void OpenDelete(DocumentDto row)
    {
        _selected = row;
        _showDelete = true;
    }

    private void CloseDelete() => _showDelete = false;

    private async Task DeleteAsync()
    {
        if (_selected is null) return;
        _busy = true;
        try
        {
            await Api.DeleteDocumentAsync(_selected.DocumentId, _tenantAdminUserId);
            _showDelete = false;
            _drawerRow = null;
            ShowToast("Document deleted.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Delete failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ArchiveAsync(DocumentDto row)
    {
        _busy = true;
        try
        {
            await Api.ArchiveDocumentAsync(row.DocumentId, _tenantAdminUserId);
            ShowToast("Document archived.");
            await LoadAsync();
            await RefreshDrawerAsync(row.DocumentId);
        }
        catch (Exception ex)
        {
            ShowToast($"Archive failed: {ex.Message}", "danger");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenDetailAsync(DocumentDto row)
    {
        _selected = row;
        _drawerRow = row;
        await LoadRelatedAsync(row.DocumentId);
    }

    private void CloseDrawer() => _drawerRow = null;

    private async Task RefreshDrawerAsync(Guid documentId)
    {
        if (_drawerRow is null) return;
        _drawerRow = _rows.FirstOrDefault(r => r.DocumentId == documentId) ?? await Api.GetDocumentByIdAsync(documentId);
        if (_drawerRow is not null)
        {
            await LoadRelatedAsync(documentId);
        }
    }

    private async Task LoadRelatedAsync(Guid documentId)
    {
        _versions.Clear();
        _accessLog.Clear();
        var versions = await Api.GetDocumentVersionsAsync(documentId);
        var logs = await Api.GetDocumentAccessLogAsync(documentId, 25);
        _versions.AddRange(versions ?? []);
        _accessLog.AddRange(logs ?? []);
    }

    private void DownloadDocument(DocumentDto row) => Nav.NavigateTo(Api.GetDocumentDownloadUrl(row.DocumentId), forceLoad: true);

    private void OpenActionMenu(DocumentDto row, MouseEventArgs args)
    {
        _selected = row;
        _openActionMenuFor = row.DocumentId;
        _menuXpx = $"{Math.Min(args.ClientX, 1420)}px";
        _menuYpx = $"{Math.Min(args.ClientY, 820)}px";
    }

    private void CloseActionMenu() => _openActionMenuFor = null;

    private async Task ExecuteMenuActionAsync(string action)
    {
        var row = _selected;
        CloseActionMenu();
        if (row is null) return;

        switch (action)
        {
            case "View":
            case "Audit":
                await OpenDetailAsync(row);
                break;
            case "Download":
                DownloadDocument(row);
                break;
            case "Metadata":
                OpenMetadata(row);
                break;
            case "Rename":
                OpenRename(row);
                break;
            case "Version":
                OpenVersion(row);
                break;
            case "Share":
                await OpenShareAsync(row);
                break;
            case "Archive":
                await ArchiveAsync(row);
                break;
            case "Delete":
                OpenDelete(row);
                break;
        }
    }

