@page "/portal/features"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>Portal Capabilities — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Portal Capabilities"
               Subtitle="Configure which self-service features are available to insured portal users"
               Icon="bi-toggles-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="EnableAll">
            <i class="bi bi-check-all" aria-hidden="true"></i> Enable All
        </button>
        <button class="um-btn um-btn-primary" @onclick="SaveAsync">
            <i class="bi bi-check-lg" aria-hidden="true"></i> Save Settings
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="pc-kpi-strip">
    <div class="pc-kpi-card">
        <div class="pc-kv">@_capabilities.Count(c => c.Enabled)</div>
        <div class="pc-kl">Enabled Features</div>
    </div>
    <div class="pc-kpi-card">
        <div class="pc-kv">@_capabilities.Count(c => !c.Enabled)</div>
        <div class="pc-kl">Disabled Features</div>
    </div>
    <div class="pc-kpi-card">
        <div class="pc-kv">@_capabilities.Count(c => c.RequiresApproval && c.Enabled)</div>
        <div class="pc-kl">Approval-Gated</div>
    </div>
    <div class="pc-kpi-card">
        <div class="pc-kv">@_capabilities.Count(c => c.MfaRequired && c.Enabled)</div>
        <div class="pc-kl">MFA-Required</div>
    </div>
</div>

<!-- Capability cards -->
<div class="pc-cap-grid">
    @foreach (var cap in _capabilities)
    {
        <div class="pc-cap-card @(cap.Enabled ? "pc-cap-card--on" : "pc-cap-card--off")">
            <div class="pc-cap-header">
                <div class="pc-cap-icon @cap.IconCss"><i class="bi @cap.Icon" aria-hidden="true"></i></div>
                <div class="pc-cap-title-wrap">
                    <div class="pc-cap-name">@cap.Name</div>
                    <div class="pc-cap-desc">@cap.Description</div>
                </div>
                <label class="pc-toggle" title="@(cap.Enabled ? "Disable" : "Enable")">
                    <input type="checkbox" checked="@cap.Enabled" @onchange="() => cap.Enabled = !cap.Enabled" />
                    <span class="pc-toggle-slider"></span>
                </label>
            </div>
            <div class="pc-cap-opts">
                <label class="pc-opt-lbl @(!cap.Enabled ? "pc-opt-disabled" : "")">
                    <SfCheckBox @bind-Checked="cap.RequiresApproval" Disabled="@(!cap.Enabled)" />
                    <span>Require staff approval</span>
                </label>
                <label class="pc-opt-lbl @(!cap.Enabled ? "pc-opt-disabled" : "")">
                    <SfCheckBox @bind-Checked="cap.MfaRequired" Disabled="@(!cap.Enabled)" />
                    <span>Require MFA to use</span>
                </label>
                <label class="pc-opt-lbl @(!cap.Enabled ? "pc-opt-disabled" : "")">
                    <SfCheckBox @bind-Checked="cap.AuditLog" Disabled="@(!cap.Enabled)" />
                    <span>Log to audit trail</span>
                </label>
            </div>
            <div class="pc-cap-footer">
                <span class="pc-cat-badge @CategoryCss(cap.Category)">@cap.Category</span>
                @if (cap.Enabled)
                {
                    <span class="pc-on-chip"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Active</span>
                }
                else
                {
                    <span class="pc-off-chip"><i class="bi bi-dash-circle" aria-hidden="true"></i> Disabled</span>
                }
            </div>
        </div>
    }
</div>

@code {
    private SfToast? _toast;

    private List<PortalCapability> _capabilities = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Portal","/portal/users"), new("Capabilities",""));
        _capabilities =
        [
            new PortalCapability { Id=1,  Name="Request Certificate of Insurance", Description="Clients can request COIs directly from the portal without calling the agency.", Icon="bi-file-earmark-text", IconCss="pc-ic-blue",   Category="Policy Services", Enabled=true,  RequiresApproval=true,  MfaRequired=false, AuditLog=true  },
            new PortalCapability { Id=2,  Name="Request Policy Change",            Description="Submit endorsement and policy modification requests online.",                   Icon="bi-pencil-square",     IconCss="pc-ic-amber",  Category="Policy Services", Enabled=true,  RequiresApproval=true,  MfaRequired=false, AuditLog=true  },
            new PortalCapability { Id=3,  Name="Upload Documents",                 Description="Clients can securely upload loss runs, applications, and supporting docs.",     Icon="bi-cloud-arrow-up",    IconCss="pc-ic-green",  Category="Documents",       Enabled=true,  RequiresApproval=false, MfaRequired=false, AuditLog=true  },
            new PortalCapability { Id=4,  Name="Pay Invoice Online",               Description="Clients pay premiums and invoices via card or ACH through the portal.",         Icon="bi-credit-card",       IconCss="pc-ic-green",  Category="Billing",         Enabled=true,  RequiresApproval=false, MfaRequired=true,  AuditLog=true  },
            new PortalCapability { Id=5,  Name="Download ID Card",                 Description="Instant download of auto and other ID cards without agent involvement.",        Icon="bi-person-vcard",      IconCss="pc-ic-blue",   Category="Documents",       Enabled=true,  RequiresApproval=false, MfaRequired=false, AuditLog=false },
            new PortalCapability { Id=6,  Name="Secure Messaging",                 Description="Two-way encrypted messaging between clients and agency staff.",                 Icon="bi-chat-lock",         IconCss="pc-ic-purple", Category="Communication",   Enabled=true,  RequiresApproval=false, MfaRequired=false, AuditLog=true  },
            new PortalCapability { Id=7,  Name="Renewal Questionnaire",            Description="Clients complete pre-renewal data-gathering forms ahead of renewal.",           Icon="bi-clipboard-check",   IconCss="pc-ic-amber",  Category="Policy Services", Enabled=true,  RequiresApproval=false, MfaRequired=false, AuditLog=true  },
            new PortalCapability { Id=8,  Name="E-Sign Documents",                 Description="Clients e-sign policy applications, endorsements, and agency forms.",           Icon="bi-pen",               IconCss="pc-ic-purple", Category="Documents",       Enabled=true,  RequiresApproval=false, MfaRequired=true,  AuditLog=true  },
            new PortalCapability { Id=9,  Name="Claim Intake (FNOL)",              Description="Clients initiate first notice of loss directly from the portal.",               Icon="bi-exclamation-circle",IconCss="pc-ic-red",    Category="Claims",          Enabled=false, RequiresApproval=true,  MfaRequired=true,  AuditLog=true  },
            new PortalCapability { Id=10, Name="View Policy Documents",            Description="Download declarations pages, policy forms, and schedules.",                     Icon="bi-folder2",           IconCss="pc-ic-blue",   Category="Documents",       Enabled=true,  RequiresApproval=false, MfaRequired=false, AuditLog=false },
            new PortalCapability { Id=11, Name="Billing History",                  Description="View payment history, invoices, and upcoming due dates.",                       Icon="bi-receipt",           IconCss="pc-ic-green",  Category="Billing",         Enabled=true,  RequiresApproval=false, MfaRequired=false, AuditLog=false },
            new PortalCapability { Id=12, Name="Service Request Tracker",          Description="Track the status of submitted requests in real time.",                          Icon="bi-list-check",        IconCss="pc-ic-amber",  Category="Communication",   Enabled=true,  RequiresApproval=false, MfaRequired=false, AuditLog=false },
        ];
    }

    private void EnableAll() { foreach (var c in _capabilities) c.Enabled = true; }

    private async Task SaveAsync()
    {
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = "Portal capabilities saved.", CssClass = "e-toast-success" });
    }

    private static string CategoryCss(string cat) => cat switch
    {
        "Policy Services" => "pc-cat pc-cat--policy",
        "Documents"       => "pc-cat pc-cat--docs",
        "Billing"         => "pc-cat pc-cat--billing",
        "Claims"          => "pc-cat pc-cat--claims",
        "Communication"   => "pc-cat pc-cat--comms",
        _                 => "pc-cat",
    };

    private sealed class PortalCapability
    {
        public int    Id              { get; set; }
        public string Name            { get; set; } = string.Empty;
        public string Description     { get; set; } = string.Empty;
        public string Icon            { get; set; } = "bi-circle";
        public string IconCss         { get; set; } = string.Empty;
        public string Category        { get; set; } = string.Empty;
        public bool   Enabled         { get; set; }
        public bool   RequiresApproval{ get; set; }
        public bool   MfaRequired     { get; set; }
        public bool   AuditLog        { get; set; }
    }
}
