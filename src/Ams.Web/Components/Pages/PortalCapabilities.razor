@page "/portal/features"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs

<PageTitle>Portal Capabilities — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Portal Capabilities"
               Subtitle="Configure which self-service features are available to insured portal users"
               Icon="bi-toggles-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="EnableAll">
            <i class="bi bi-check-all" aria-hidden="true"></i> Enable All
        </button>
        <button class="um-btn um-btn-primary" @onclick="SaveAsync">
            <i class="bi bi-check-lg" aria-hidden="true"></i> Save Settings
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="pc-kpi-strip">
    <div class="pc-kpi-card">
        <div class="pc-kv">@_capabilities.Count(c => c.Enabled)</div>
        <div class="pc-kl">Enabled Features</div>
    </div>
    <div class="pc-kpi-card">
        <div class="pc-kv">@_capabilities.Count(c => !c.Enabled)</div>
        <div class="pc-kl">Disabled Features</div>
    </div>
    <div class="pc-kpi-card">
        <div class="pc-kv">@_capabilities.Count(c => c.RequiresApproval && c.Enabled)</div>
        <div class="pc-kl">Approval-Gated</div>
    </div>
    <div class="pc-kpi-card">
        <div class="pc-kv">@_capabilities.Count(c => c.MfaRequired && c.Enabled)</div>
        <div class="pc-kl">MFA-Required</div>
    </div>
</div>

<!-- Capability cards -->
<div class="pc-cap-grid">
    @foreach (var cap in _capabilities)
    {
        <div class="pc-cap-card @(cap.Enabled ? "pc-cap-card--on" : "pc-cap-card--off")">
            <div class="pc-cap-header">
                <div class="pc-cap-icon @cap.IconCss"><i class="bi @cap.Icon" aria-hidden="true"></i></div>
                <div class="pc-cap-title-wrap">
                    <div class="pc-cap-name">@cap.Name</div>
                    <div class="pc-cap-desc">@cap.Description</div>
                </div>
                <label class="pc-toggle" title="@(cap.Enabled ? "Disable" : "Enable")">
                    <input type="checkbox" checked="@cap.Enabled" @onchange="() => cap.Enabled = !cap.Enabled" />
                    <span class="pc-toggle-slider"></span>
                </label>
            </div>
            <div class="pc-cap-opts">
                <label class="pc-opt-lbl @(!cap.Enabled ? "pc-opt-disabled" : "")">
                    <SfCheckBox @bind-Checked="cap.RequiresApproval" Disabled="@(!cap.Enabled)" />
                    <span>Require staff approval</span>
                </label>
                <label class="pc-opt-lbl @(!cap.Enabled ? "pc-opt-disabled" : "")">
                    <SfCheckBox @bind-Checked="cap.MfaRequired" Disabled="@(!cap.Enabled)" />
                    <span>Require MFA to use</span>
                </label>
                <label class="pc-opt-lbl @(!cap.Enabled ? "pc-opt-disabled" : "")">
                    <SfCheckBox @bind-Checked="cap.AuditLog" Disabled="@(!cap.Enabled)" />
                    <span>Log to audit trail</span>
                </label>
            </div>
            <div class="pc-cap-footer">
                <span class="pc-cat-badge @CategoryCss(cap.Category)">@cap.Category</span>
                @if (cap.Enabled)
                {
                    <span class="pc-on-chip"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Active</span>
                }
                else
                {
                    <span class="pc-off-chip"><i class="bi bi-dash-circle" aria-hidden="true"></i> Disabled</span>
                }
            </div>
        </div>
    }
</div>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private SfToast? _toast;

    private List<PortalCapability> _capabilities = [];

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Portal","/portal/users"), new("Capabilities",""));
        var result = await Api.GetPortalCapabilitiesAsync(_tenantId);
        _capabilities = result?.Items.Select(c => new PortalCapability { Id = c.Id, Name = c.Name, Description = c.Description, Icon = c.Icon, IconCss = c.IconCss, Category = c.Category, Enabled = c.Enabled, RequiresApproval = c.RequiresApproval, MfaRequired = c.MfaRequired, AuditLog = c.AuditLog }).ToList() ?? [];
    }

    private void EnableAll() { foreach (var c in _capabilities) c.Enabled = true; }

    private async Task SaveAsync()
    {
        foreach (var cap in _capabilities)
            await Api.SetPortalAdminRecordStatusAsync(cap.Id, cap.Enabled ? "Active" : "Inactive");
        if (_toast is not null)
            await _toast.ShowAsync(new ToastModel { Content = "Portal capabilities saved.", CssClass = "e-toast-success" });
    }

    private static string CategoryCss(string cat) => cat switch
    {
        "Policy Services" => "pc-cat pc-cat--policy",
        "Documents"       => "pc-cat pc-cat--docs",
        "Billing"         => "pc-cat pc-cat--billing",
        "Claims"          => "pc-cat pc-cat--claims",
        "Communication"   => "pc-cat pc-cat--comms",
        _                 => "pc-cat",
    };

    private sealed class PortalCapability
    {
        public Guid   Id              { get; set; }
        public string Name            { get; set; } = string.Empty;
        public string Description     { get; set; } = string.Empty;
        public string Icon            { get; set; } = "bi-circle";
        public string IconCss         { get; set; } = string.Empty;
        public string Category        { get; set; } = string.Empty;
        public bool   Enabled         { get; set; }
        public bool   RequiresApproval{ get; set; }
        public bool   MfaRequired     { get; set; }
        public bool   AuditLog        { get; set; }
    }
}
