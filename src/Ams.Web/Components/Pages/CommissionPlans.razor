@page "/commissions"
@page "/commissions/plans"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Compensation Plans — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<SfDialog @bind-Visible="_showCreate" Width="680px" ShowCloseIcon="false" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-clipboard-check" aria-hidden="true"></i><span>New Compensation Plan</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseCreate"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_createEditContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Plan Code <span class="text-danger">*</span></label><InputText @bind-Value="_createForm.PlanCode" class="um-input" placeholder="e.g. COMM-2025-STD" /><ValidationMessage For="() => _createForm.PlanCode" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Plan Name <span class="text-danger">*</span></label><InputText @bind-Value="_createForm.PlanName" class="um-input" placeholder="e.g. Standard Producer Plan 2025" /><ValidationMessage For="() => _createForm.PlanName" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Plan Type</label><InputSelect @bind-Value="_createForm.PlanTypeCode" class="um-input">@foreach (var t in _planTypes) { <option value="@t">@t</option> }</InputSelect><ValidationMessage For="() => _createForm.PlanTypeCode" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>New Business Rate %</label><InputNumber @bind-Value="_createForm.NewBusinessRatePct" class="um-input" /><ValidationMessage For="() => _createForm.NewBusinessRatePct" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Renewal Rate %</label><InputNumber @bind-Value="_createForm.RenewalRatePct" class="um-input" /><ValidationMessage For="() => _createForm.RenewalRatePct" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Effective Date <span class="text-danger">*</span></label><InputDate @bind-Value="_createForm.EffectiveStartDate" class="um-input" /><ValidationMessage For="() => _createForm.EffectiveStartDate" class="validation-message text-danger" /></div>
                    <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_createForm.AllowSplit" /> Allow split commissions</label></div>
                    <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_createForm.HouseAccountRules" /> House account rules apply</label></div>
                    <div class="um-field um-field--checkbox"><label><InputCheckbox @bind-Value="_createForm.BranchOverrideEligible" /> Branch override eligible</label></div>
                    @if (!string.IsNullOrWhiteSpace(_createFormError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_createFormError</div> }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseCreate">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="CreatePlanAsync" disabled="@_saving">@(_saving ? "Saving…" : "Create Plan")</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

<AppPageHeader Title="Compensation Plans"
               Subtitle="Define, version, and manage new business &amp; renewal commission plans, split rules, and producer schedules"
               Icon="bi-clipboard-check">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/splits")'>
            <i class="bi bi-scissors" aria-hidden="true"></i> Split Rules
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/planner")'>
            <i class="bi bi-calculator" aria-hidden="true"></i> What-If Planner
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> New Plan
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="cp-kpi-strip">
    @CpKpi("bi-clipboard-check",  "Total Plans",      _plans.Count.ToString(),                                     "cp-ki-blue")
    @CpKpi("bi-check-circle",     "Active",           _plans.Count(p=>p.Status=="Active").ToString(),              "cp-ki-green")
    @CpKpi("bi-layers",           "With Versions",    _plans.Count(p=>p.Versions>1).ToString(),                   "cp-ki-blue")
    @CpKpi("bi-scissors",         "Split-Enabled",    _plans.Count(p=>p.AllowSplit).ToString(),                   "cp-ki-purple")
    @CpKpi("bi-building",         "Branch Override",  _plans.Count(p=>p.BranchOverride).ToString(),               "cp-ki-amber")
    @CpKpi("bi-house",            "House Account",    _plans.Count(p=>p.HouseRules).ToString(),                   "cp-ki-amber")
    @CpKpi("bi-arrow-up-circle",  "Avg New Biz Rate", _plans.Any()?(_plans.Average(p=>p.NewBizRate).ToString("N1")+"%"):"—", "cp-ki-blue")
    @CpKpi("bi-arrow-repeat",     "Avg Renewal Rate", _plans.Any()?(_plans.Average(p=>p.RenewalRate).ToString("N1")+"%"):"—","cp-ki-blue")
</div>

<!-- Sub-nav -->
<div class="cp-subnav">
    <button class="cp-snav-btn cp-snav-active"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Plans</button>
    <button class="cp-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/statements")'><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Statements</button>
    <button class="cp-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/producer-ledger")'><i class="bi bi-journal-text" aria-hidden="true"></i> Producer Ledger</button>
    <button class="cp-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/splits")'><i class="bi bi-scissors" aria-hidden="true"></i> Split Rules</button>
    <button class="cp-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/exceptions")'><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Exceptions</button>
    <button class="cp-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/forecast")'><i class="bi bi-graph-up" aria-hidden="true"></i> Forecast</button>
    <button class="cp-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/planner")'><i class="bi bi-calculator" aria-hidden="true"></i> What-If Planner</button>
    <button class="cp-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/plan-versions")'><i class="bi bi-layers" aria-hidden="true"></i> Plan Versions</button>
</div>

<!-- Toolbar -->
<div class="cp-toolbar">
    <SfTextBox Placeholder="Search plan code, name…" @bind-Value="_searchTerm" Width="270px"></SfTextBox>
    <select class="e-input cp-sel" @bind="_filterType">
        <option value="">All Types</option>
        @foreach (var t in _planTypes) { <option value="@t">@t</option> }
    </select>
    <select class="e-input cp-sel" @bind="_filterStatus">
        <option value="">All Statuses</option>
        <option value="Active">Active</option>
        <option value="Draft">Draft</option>
        <option value="Archived">Archived</option>
    </select>
</div>

@if (_loading)
{
    <div style="padding:2rem"><SfSpinner Visible="true" /></div>
}
else
{
<div class="cp-grid-wrap">
    <SfGrid DataSource="FilteredPlans" AllowSorting="true" AllowPaging="true" Height="520px">
        <GridPageSettings PageSize="15"></GridPageSettings>
        <GridColumns>
            <GridColumn HeaderText="Plan" Width="280">
                <Template>
                    @{ var p = (PlanRow)context; }
                    <div class="cp-plan-cell">
                        <i class="bi bi-clipboard-check cp-plan-icon" aria-hidden="true"></i>
                        <div>
                            <div class="cp-plan-name">@p.Name</div>
                            <div class="cp-plan-code">@p.Code</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Type" Width="140">
                <Template>
                    @{ var p2 = (PlanRow)context; }
                    <span class="cp-type-chip cp-t-@p2.Type.ToLower().Replace(" ","-")">@p2.Type</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(PlanRow.NewBizRate)" HeaderText="New Biz %" Format="N2" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
            <GridColumn Field="@nameof(PlanRow.RenewalRate)" HeaderText="Renewal %" Format="N2" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
            <GridColumn Field="@nameof(PlanRow.Versions)" HeaderText="Versions" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center"></GridColumn>
            <GridColumn HeaderText="Features" Width="170">
                <Template>
                    @{ var p3 = (PlanRow)context; }
                    <div class="cp-feat-chips">
                        @if (p3.AllowSplit)    { <span class="cp-feat cp-f-split">Split</span> }
                        @if (p3.BranchOverride){ <span class="cp-feat cp-f-branch">Branch</span> }
                        @if (p3.HouseRules)    { <span class="cp-feat cp-f-house">House</span> }
                    </div>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Status" Width="100">
                <Template>
                    @{ var p4 = (PlanRow)context; }
                    <span class="cp-status-chip cp-st-@p4.Status.ToLower()">@p4.Status</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(PlanRow.Effective)" HeaderText="Effective" Type="ColumnType.Date" Format="d" Width="110"></GridColumn>
            <GridColumn HeaderText="Actions" Width="120">
                <Template>
                    @{ var p5 = (PlanRow)context; }
                    <div class="cp-row-acts">
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => Nav.NavigateTo("/commissions/plan-versions")' title="Versions">
                            <i class="bi bi-layers" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => Nav.NavigateTo("/commissions/splits")' title="Splits">
                            <i class="bi bi-scissors" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => Nav.NavigateTo("/commissions/planner")' title="Model this plan">
                            <i class="bi bi-calculator" aria-hidden="true"></i>
                        </button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>
}

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private string _filterType = "", _filterStatus = "";
    private bool _loading, _showCreate, _saving;
    private string? _createFormError;
    private PlanForm _createForm = new();
    private EditContext _createEditContext = default!;
    private SfToast _toast = default!;

    private readonly List<string> _planTypes = ["Standard","Senior Producer","Branch Manager","House Account","Referral","Override","Performance Bonus"];

    private List<PlanRow> _plans = [];

    private IEnumerable<PlanRow> FilteredPlans => _plans.Where(p =>
        (string.IsNullOrEmpty(_searchTerm)   || p.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) || p.Code.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterType)   || p.Type == _filterType) &&
        (string.IsNullOrEmpty(_filterStatus) || p.Status == _filterStatus));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        _createEditContext = new(_createForm);
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Commissions","/commissions"), new("Plans",""));
        await LoadAsync();
    }

    private void OpenCreate() { _createForm = new(); _createEditContext = new(_createForm); _createFormError = null; _showCreate = true; }
    private void CloseCreate() => _showCreate = false;

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Api.SearchCommissionPlansAsync(_tenantId, _searchTerm);
            _plans = result?.Items.Select(ToPlanRow).ToList() ?? [];
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Content = $"Load failed: {ex.Message}", CssClass = "e-toast-danger" });
            _plans = [];
        }
        finally
        {
            _loading = false;
        }
    }

    async Task CreatePlanAsync()
    {
        if (!_createEditContext.Validate()) return;
        _saving = true;
        _createFormError = null;
        try
        {
            await Api.CreateCommissionPlanAsync(new CreateCommissionPlanRequest { TenantId = _tenantId, PlanCode = _createForm.PlanCode, PlanName = _createForm.PlanName, PlanTypeCode = _createForm.PlanTypeCode, NewBusinessRatePct = _createForm.NewBusinessRatePct, RenewalRatePct = _createForm.RenewalRatePct, EffectiveStartDate = DateOnly.FromDateTime(_createForm.EffectiveStartDate), StatusCode = "Draft", AllowSplit = _createForm.AllowSplit, HouseAccountRules = _createForm.HouseAccountRules, BranchOverrideEligible = _createForm.BranchOverrideEligible });
            _showCreate = false;
            await LoadAsync();
            await _toast.ShowAsync(new ToastModel { Content = "Plan created as Draft.", CssClass = "e-toast-success" });
        }
        catch (Exception ex)
        {
            _createFormError = $"Create failed: {ex.Message}";
            await _toast.ShowAsync(new ToastModel { Content = _createFormError, CssClass = "e-toast-danger" });
        }
        finally
        {
            _saving = false;
        }
    }

    private static PlanRow ToPlanRow(CommissionPlanDto plan) => new(plan.CommissionPlanId, plan.PlanCode, plan.PlanName, plan.PlanTypeCode, plan.NewBusinessRatePct, plan.RenewalRatePct, 1, plan.AllowSplit, plan.HouseAccountRules, plan.BranchOverrideEligible, plan.StatusCode, plan.EffectiveStartDate.ToDateTime(TimeOnly.MinValue));

    RenderFragment CpKpi(string icon, string label, string val, string color) => __builder =>
    {
        <div class="cp-kpi-card @color">
            <i class="bi @icon cp-kpi-icon" aria-hidden="true"></i>
            <div><div class="cp-kpi-val">@val</div><div class="cp-kpi-lbl">@label</div></div>
        </div>
    };

    record PlanRow(Guid Id, string Code, string Name, string Type, decimal NewBizRate, decimal RenewalRate,
                  int Versions, bool AllowSplit, bool HouseRules, bool BranchOverride, string Status, DateTime Effective);

    private sealed class PlanForm
    {
        [Required, StringLength(50)] public string PlanCode { get; set; } = string.Empty;
        [Required, StringLength(200)] public string PlanName { get; set; } = string.Empty;
        [Required, StringLength(50)] public string PlanTypeCode { get; set; } = "Standard";
        [Range(0, 100)] public decimal NewBusinessRatePct { get; set; } = 10m;
        [Range(0, 100)] public decimal RenewalRatePct { get; set; } = 8m;
        [Required] public DateTime EffectiveStartDate { get; set; } = DateTime.Today;
        public bool AllowSplit { get; set; }
        public bool HouseAccountRules { get; set; }
        public bool BranchOverrideEligible { get; set; }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
