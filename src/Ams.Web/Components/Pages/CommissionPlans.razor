@page "/commissions"
@inject ApiClient Api

<PageTitle>Commission Plans</PageTitle>

<h1>Commission Plans</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>

            <GridColumn Field="@nameof(CommissionPlanDto.PlanCode)" HeaderText="Plan Code" Width="160"></GridColumn>
            <GridColumn Field="@nameof(CommissionPlanDto.PlanName)" HeaderText="Plan Name" Width="260"></GridColumn>
            <GridColumn Field="@nameof(CommissionPlanDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="g" Width="180"></GridColumn>

        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<CommissionPlanDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchCommissionPlansAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<CommissionPlanDto>();
    }
}
