@page "/admin/system/onboarding/portal-brand"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Portal Brand Setup ? AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<AppPageHeader Title="Portal Brand Setup"
               Subtitle="Configure your client portal's logo, colors, domain, and welcome experience"
               Icon="bi-palette">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/admin/system/onboarding")'><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Onboarding</button>
        <button class="um-btn um-btn-ghost" @onclick="SendTestInvite"><i class="bi bi-envelope" aria-hidden="true"></i> Send Test Invite</button>
        <button class="um-btn um-btn-primary" @onclick="SaveBranding"><i class="bi bi-check2" aria-hidden="true"></i> Save Branding</button>
    </Actions>
</AppPageHeader>

<div class="pb-layout">
    <!-- Left: Settings panels -->
    <div class="pb-settings">

        <!-- Logo -->
        <div class="pb-section">
            <div class="pb-section-title"><i class="bi bi-image" aria-hidden="true"></i> Logo &amp; Favicon</div>
            <div class="pb-logo-row">
                <div class="pb-logo-preview" style="background:@_primaryColor">
                    @if (!string.IsNullOrEmpty(_agencyName))
                    {
                        <span class="pb-logo-initials">@string.Concat(_agencyName.Split(' ').Take(2).Select(w => w[0]))</span>
                    }
                </div>
                <div class="pb-logo-actions">
                    <button class="um-btn um-btn-ghost um-btn-xs"><i class="bi bi-upload" aria-hidden="true"></i> Upload Logo</button>
                    <button class="um-btn um-btn-ghost um-btn-xs"><i class="bi bi-upload" aria-hidden="true"></i> Upload Favicon</button>
                    <div class="pb-logo-hint">Recommended: PNG, 200?60 px, transparent background</div>
                </div>
            </div>
        </div>

        <!-- Colors -->
        <div class="pb-section">
            <div class="pb-section-title"><i class="bi bi-palette" aria-hidden="true"></i> Brand Colors</div>
            <div class="pb-color-row">
                <label class="pb-color-label">Primary Color</label>
                <div class="pb-color-pick-wrap">
                    <input type="color" class="pb-color-input" @bind="_primaryColor" />
                    <input type="text" class="pb-color-hex" @bind="_primaryColor" maxlength="7" />
                </div>
            </div>
            <div class="pb-color-row">
                <label class="pb-color-label">Accent Color</label>
                <div class="pb-color-pick-wrap">
                    <input type="color" class="pb-color-input" @bind="_accentColor" />
                    <input type="text" class="pb-color-hex" @bind="_accentColor" maxlength="7" />
                </div>
            </div>
            <div class="pb-color-row">
                <label class="pb-color-label">Button Color</label>
                <div class="pb-color-pick-wrap">
                    <input type="color" class="pb-color-input" @bind="_buttonColor" />
                    <input type="text" class="pb-color-hex" @bind="_buttonColor" maxlength="7" />
                </div>
            </div>
            <div class="pb-preset-row">
                @foreach (var preset in _colorPresets)
                {
                    <button class="pb-preset-swatch" style="background:@preset.Primary" title="@preset.Name" @onclick="() => ApplyPreset(preset)"></button>
                }
            </div>
        </div>

        <!-- Agency Info -->
        <div class="pb-section">
            <div class="pb-section-title"><i class="bi bi-building" aria-hidden="true"></i> Agency Information</div>
            <div class="pb-field"><label class="pb-lbl">Agency Name</label><input class="pb-input" @bind="_agencyName" /></div>
            <div class="pb-field"><label class="pb-lbl">Tagline</label><input class="pb-input" @bind="_tagline" placeholder="e.g. Protecting what matters most" /></div>
            <div class="pb-field"><label class="pb-lbl">Support Phone</label><input class="pb-input" @bind="_supportPhone" placeholder="(555) 555-0100" /></div>
            <div class="pb-field"><label class="pb-lbl">Support Email</label><input class="pb-input" @bind="_supportEmail" placeholder="support@agency.com" /></div>
            <div class="pb-field"><label class="pb-lbl">Welcome Message</label><textarea class="pb-textarea" @bind="_welcomeMessage" rows="3" placeholder="Welcome! We're glad to have you on the portal?"></textarea></div>
        </div>

        <!-- Domain -->
        <div class="pb-section">
            <div class="pb-section-title"><i class="bi bi-globe" aria-hidden="true"></i> Portal Domain</div>
            <div class="pb-field">
                <label class="pb-lbl">Subdomain (default)</label>
                <div class="pb-domain-row">
                    <input class="pb-input pb-domain-input" @bind="_subdomain" placeholder="yourAgency" />
                    <span class="pb-domain-suffix">.ams.app</span>
                </div>
            </div>
            <div class="pb-field">
                <label class="pb-lbl">Custom Domain (optional)</label>
                <input class="pb-input" @bind="_customDomain" placeholder="portal.youragency.com" />
                <div class="pb-domain-hint">Add a CNAME record pointing to portal.ams.app</div>
            </div>
            <div class="pb-ssl-row">
                <i class="bi bi-shield-lock-fill pb-ssl-icon" aria-hidden="true"></i>
                <span class="pb-ssl-label">SSL certificate will be provisioned automatically</span>
            </div>
        </div>

    </div>

    <!-- Right: Live preview -->
    <div class="pb-preview-pane">
        <div class="pb-preview-label"><i class="bi bi-eye" aria-hidden="true"></i> Live Preview</div>
        <div class="pb-browser-frame">
            <div class="pb-browser-bar">
                <span class="pb-browser-dot"></span><span class="pb-browser-dot"></span><span class="pb-browser-dot"></span>
                <span class="pb-browser-url">@_subdomain.ToLower().Replace(" ","")@(".ams.app")</span>
            </div>
            <!-- Simulated portal header -->
            <div class="pb-portal-header" style="background:@_primaryColor">
                <div class="pb-portal-logo-area">
                    <div class="pb-portal-logo-box">
                        @if (!string.IsNullOrEmpty(_agencyName))
                        {
                            <span class="pb-portal-logo-text">@string.Concat(_agencyName.Split(' ').Take(2).Select(w => w[0]))</span>
                        }
                    </div>
                    <span class="pb-portal-agency-name">@_agencyName</span>
                </div>
                <nav class="pb-portal-nav">
                    <span>My Policies</span>
                    <span>Claims</span>
                    <span>Documents</span>
                </nav>
            </div>
            <!-- Simulated hero -->
            <div class="pb-portal-hero">
                <div class="pb-portal-tagline">@_tagline</div>
                <div class="pb-portal-welcome">@_welcomeMessage</div>
                <button class="pb-portal-btn" style="background:@_buttonColor">View My Policies</button>
            </div>
            <!-- Simulated cards -->
            <div class="pb-portal-cards">
                @foreach (var card in _previewCards)
                {
                    <div class="pb-portal-card">
                        <i class="bi bi-@card.Icon pb-portal-card-icon" style="color:@_accentColor" aria-hidden="true"></i>
                        <div class="pb-portal-card-label">@card.Label</div>
                    </div>
                }
            </div>
            <!-- Simulated footer -->
            <div class="pb-portal-footer">
                <span>@_supportPhone</span>
                <span>@_supportEmail</span>
                <span>@_agencyName</span>
            </div>
        </div>
    </div>
</div>

@code {
    private EnterpriseToast? _toast;

    private string _primaryColor  = "#1d4ed8";
    private string _accentColor   = "#3b82f6";
    private string _buttonColor   = "#1d4ed8";
    private string _agencyName    = "Rocky Mountain Insurance";
    private string _tagline       = "Protecting what matters most";
    private string _supportPhone  = "(303) 555-0100";
    private string _supportEmail  = "support@rminsurance.com";
    private string _welcomeMessage= "Welcome to your secure insurance portal. Manage policies, file claims, and access documents 24/7.";
    private string _subdomain     = "rminsurance";
    private string _customDomain  = string.Empty;

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Administration","/admin"), new("Tenant Onboarding","/admin/system/onboarding"), new("Portal Brand Setup",""));
    }

    private async Task SaveBranding()
    {
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = "Portal branding saved and published.", CssClass = "enterprise-toast-success" });
    }

    private async Task SendTestInvite()
    {
        if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = "Test portal invite sent to your account email.", CssClass = "enterprise-toast-success" });
    }

    private void ApplyPreset(ColorPreset p) { _primaryColor = p.Primary; _accentColor = p.Accent; _buttonColor = p.Button; }

    private sealed class ColorPreset(string name, string primary, string accent, string button) { public string Name=name; public string Primary=primary; public string Accent=accent; public string Button=button; }
    private sealed class PreviewCard(string icon, string label) { public string Icon=icon; public string Label=label; }

    private List<ColorPreset> _colorPresets =
    [
        new("Ocean Blue",   "#1d4ed8","#3b82f6","#1d4ed8"),
        new("Forest Green", "#166534","#22c55e","#16a34a"),
        new("Crimson",      "#991b1b","#ef4444","#dc2626"),
        new("Slate",        "#334155","#64748b","#475569"),
        new("Amber",        "#92400e","#f59e0b","#b45309"),
        new("Purple",       "#4c1d95","#8b5cf6","#7c3aed"),
    ];

    private static readonly List<PreviewCard> _previewCards =
    [
        new("shield-check","My Policies"),
        new("exclamation-circle","Claims"),
        new("folder2-open","Documents"),
        new("credit-card","Payments"),
    ];
}
