@page "/portal/activity"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Portal Activity — AMS</PageTitle>

<AppPageHeader Title="Portal Activity"
               Subtitle="Real-time audit log of all client portal interactions and self-service actions"
               Icon="bi-activity">
    <Actions>
        <button class="um-btn um-btn-ghost">
            <i class="bi bi-download" aria-hidden="true"></i> Export
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="pa-kpi-strip">
    <div class="pa-kpi-card">
        <div class="pa-kpi-icon pa-ki-blue"><i class="bi bi-people" aria-hidden="true"></i></div>
        <div><div class="pa-kv">@_events.Select(e => e.UserEmail).Distinct().Count()</div><div class="pa-kl">Unique Users Today</div></div>
    </div>
    <div class="pa-kpi-card">
        <div class="pa-kpi-icon pa-ki-green"><i class="bi bi-lightning" aria-hidden="true"></i></div>
        <div><div class="pa-kv">@_events.Count</div><div class="pa-kl">Total Events</div></div>
    </div>
    <div class="pa-kpi-card">
        <div class="pa-kpi-icon pa-ki-amber"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i></div>
        <div><div class="pa-kv">@_events.Count(e => e.EventType == "Request Submitted")</div><div class="pa-kl">Requests Submitted</div></div>
    </div>
    <div class="pa-kpi-card">
        <div class="pa-kpi-icon pa-ki-red"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></div>
        <div><div class="pa-kv">@_events.Count(e => e.Severity == "Warning" || e.Severity == "Error")</div><div class="pa-kl">Warnings / Errors</div></div>
    </div>
</div>

<!-- Filter bar -->
<div class="pa-filter-bar">
    <div class="pa-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="pa-search" placeholder="Search user, action…" @bind="_search" @bind:event="oninput" />
    </div>
    <select class="pa-sel" @bind="_typeFilter">
        <option value="">All Event Types</option>
        <option value="Login">Login</option>
        <option value="Document Download">Document Download</option>
        <option value="Request Submitted">Request Submitted</option>
        <option value="Payment">Payment</option>
        <option value="Message Sent">Message Sent</option>
        <option value="E-Sign">E-Sign</option>
    </select>
    <select class="pa-sel" @bind="_sevFilter">
        <option value="">All Severities</option>
        <option value="Info">Info</option>
        <option value="Warning">Warning</option>
        <option value="Error">Error</option>
    </select>
</div>

<!-- Grid -->
<div class="pa-grid-wrap">
    <SfGrid TValue="PortalEvent" DataSource="Filtered" AllowSorting="true" EnableHover="true" RowHeight="50">
        <GridColumns>
            <GridColumn Field="@nameof(PortalEvent.OccurredAt)" HeaderText="Time" Width="160" Type="ColumnType.DateTime" Format="MMM d h:mm tt" />
            <GridColumn Field="@nameof(PortalEvent.UserName)" HeaderText="User" MinWidth="170">
                <Template>
                    @{ var e = (PortalEvent)context; }
                    <div class="pa-user-cell">
                        <div class="pa-av">@Initials(e.UserName)</div>
                        <div>
                            <div class="pa-uname">@e.UserName</div>
                            <div class="pa-uemail">@e.UserEmail</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(PortalEvent.EventType)" HeaderText="Event" Width="180">
                <Template>@{ var e = (PortalEvent)context; }<span class="@EventBadge(e.EventType)">@e.EventType</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(PortalEvent.Detail)" HeaderText="Detail" MinWidth="200" />
            <GridColumn Field="@nameof(PortalEvent.AccountName)" HeaderText="Account" Width="170" />
            <GridColumn Field="@nameof(PortalEvent.Severity)" HeaderText="Severity" Width="100">
                <Template>@{ var e = (PortalEvent)context; }<span class="@SevBadge(e.Severity)">@e.Severity</span></Template>
            </GridColumn>
            <GridColumn Field="@nameof(PortalEvent.IpAddress)" HeaderText="IP" Width="130">
                <Template>@{ var e = (PortalEvent)context; }<span class="pa-mono">@e.IpAddress</span></Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string _search = string.Empty;
    private string _typeFilter = string.Empty;
    private string _sevFilter  = string.Empty;

    private List<PortalEvent> _events = [];

    private IEnumerable<PortalEvent> Filtered => _events.Where(e =>
        (string.IsNullOrEmpty(_search) || e.UserName.Contains(_search, StringComparison.OrdinalIgnoreCase) || e.Detail.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_typeFilter) || e.EventType == _typeFilter) &&
        (string.IsNullOrEmpty(_sevFilter)  || e.Severity  == _sevFilter));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Portal","/portal/users"), new("Activity",""));
        var result = await Api.SearchPortalAdminActivityAsync(_tenantId, _search);
        _events = result?.Items.Select(e => new PortalEvent { Id = e.Id, OccurredAt = e.OccurredAt, UserName = e.UserName, UserEmail = e.UserEmail, AccountName = e.AccountName, EventType = e.EventType, Detail = e.Detail, Severity = e.Severity, IpAddress = e.IpAddress }).ToList() ?? [];
    }

    private static string EventBadge(string t) => t switch
    {
        "Login"              => "pa-ev pa-ev--login",
        "Document Download"  => "pa-ev pa-ev--doc",
        "Request Submitted"  => "pa-ev pa-ev--req",
        "Payment"            => "pa-ev pa-ev--pay",
        "Message Sent"       => "pa-ev pa-ev--msg",
        "E-Sign"             => "pa-ev pa-ev--sign",
        _                    => "pa-ev",
    };

    private static string SevBadge(string s) => s switch
    {
        "Warning" => "pa-sev pa-sev--warn",
        "Error"   => "pa-sev pa-sev--err",
        _         => "pa-sev pa-sev--info",
    };

    private static string Initials(string name)
    {
        var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}" : name.Length > 0 ? name[..1] : "?";
    }

    private sealed class PortalEvent
    {
        public Guid     Id          { get; set; }
        public DateTime OccurredAt  { get; set; }
        public string   UserName    { get; set; } = string.Empty;
        public string   UserEmail   { get; set; } = string.Empty;
        public string   AccountName { get; set; } = string.Empty;
        public string   EventType   { get; set; } = string.Empty;
        public string   Detail      { get; set; } = string.Empty;
        public string   Severity    { get; set; } = "Info";
        public string   IpAddress   { get; set; } = string.Empty;
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
