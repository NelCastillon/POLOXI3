@page "/claims"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Claims
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject Ams.Web.Services.ApiClient Api
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Claims Command Center - AMS</PageTitle>

<div class="clm-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="clm-toast @toast.CssClass">
            <i class="bi @toast.Icon" aria-hidden="true"></i>
            <span>@toast.Content</span>
            <button type="button" @onclick="() => DismissToast(toast.Id)" aria-label="Dismiss notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
    }
</div>

@if (_showNewClaimDialog)
{
    <div class="clm-modal-backdrop" role="presentation" @onclick="CloseNewClaimDialog">
        <div class="clm-claim-modal" role="dialog" aria-modal="true" aria-labelledby="claimFormTitle" @onclick:stopPropagation="true">
            <div class="clm-modal-header">
                <div class="clm-modal-title">
                    <span class="clm-modal-icon"><i class="bi bi-clipboard-plus" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="claimFormTitle">Report enterprise claim</h2>
                        <p>Capture FNOL details, claimant, policy, carrier, severity indicators, and claim workflow metadata.</p>
                    </div>
                </div>
                <button type="button" class="clm-btn clm-btn-ghost clm-btn-sm" @onclick="CloseNewClaimDialog" disabled="@_savingNewClaim" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_newClaim" OnValidSubmit="SaveNewClaimAsync" OnInvalidSubmit="NotifyInvalidAsync">
                <DataAnnotationsValidator />
                <div class="clm-modal-body">
                    <div class="clm-form-banner">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <div>
                            <strong>DB-backed claim intake</strong>
                            <span>Required policy, insured, carrier, loss, claimant, and description checks are enforced before save.</span>
                        </div>
                    </div>
                    <div class="clm-form-grid">
                        <div class="clm-field">
                            <label>Policy # <span>*</span></label>
                            <InputText class="clm-input" @bind-Value="_newClaim.PolicyNumber" placeholder="Policy number" />
                            
                        </div>
                        <div class="clm-field">
                            <label>Account / Insured <span>*</span></label>
                            <InputText class="clm-input" @bind-Value="_newClaim.AccountName" placeholder="Named insured" />
                            
                        </div>
                        <div class="clm-field">
                            <label>Carrier <span>*</span></label>
                            <InputText class="clm-input" @bind-Value="_newClaim.Carrier" placeholder="Carrier name" />
                            
                        </div>
                        <div class="clm-field">
                            <label>Line of Business <span>*</span></label>
                            <InputSelect class="clm-input" @bind-Value="_newClaim.Lob">
                                <option value="">Select LOB</option>
                                @foreach (var lob in _lobs)
                                {
                                    <option value="@lob">@lob</option>
                                }
                            </InputSelect>
                            
                        </div>
                        <div class="clm-field">
                            <label>Date of Loss <span>*</span></label>
                            <InputDate class="clm-input" @bind-Value="_newClaim.DateOfLoss" />
                            
                        </div>
                        <div class="clm-field">
                            <label>Date Reported <span>*</span></label>
                            <InputDate class="clm-input" @bind-Value="_newClaim.DateReported" />
                            
                        </div>
                        <div class="clm-field">
                            <label>Loss Type <span>*</span></label>
                            <InputSelect class="clm-input" @bind-Value="_newClaim.LossType">
                                <option value="">Select loss type</option>
                                @foreach (var lossType in _lossTypes)
                                {
                                    <option value="@lossType">@lossType</option>
                                }
                            </InputSelect>
                            
                        </div>
                        <div class="clm-field">
                            <label>Claimant <span>*</span></label>
                            <InputText class="clm-input" @bind-Value="_newClaim.PrimaryClaimant" placeholder="Primary claimant" />
                            
                        </div>
                        <div class="clm-field">
                            <label>Handler</label>
                            <InputText class="clm-input" @bind-Value="_newClaim.AssignedHandler" placeholder="Assigned handler" />
                            
                        </div>
                        <div class="clm-field">
                            <label>Priority</label>
                            <InputSelect class="clm-input" @bind-Value="_newClaim.Priority">
                                @foreach (var priority in _priorities)
                                {
                                    <option value="@priority">@priority</option>
                                }
                            </InputSelect>
                            
                        </div>
                        <div class="clm-field clm-field-wide">
                            <label>Loss Location</label>
                            <InputText class="clm-input" @bind-Value="_newClaim.LossLocation" placeholder="Location of loss" />
                            
                        </div>
                        <div class="clm-field clm-field-wide">
                            <label>Loss Description <span>*</span></label>
                            <InputTextArea class="clm-input" rows="4" @bind-Value="_newClaim.LossDescription" placeholder="Describe the loss, damages, parties, and immediate next action" />
                            
                        </div>
                        <div class="clm-check-row clm-field-wide">
                            <label><InputCheckbox @bind-Value="_newClaim.IsLitigation" /> Litigation</label>
                            <label><InputCheckbox @bind-Value="_newClaim.HasSubrogation" /> Subrogation</label>
                            <label><InputCheckbox @bind-Value="_newClaim.IsCatastrophe" /> Catastrophe</label>
                            <label><InputCheckbox @bind-Value="_newClaim.IsDisputed" /> Disputed coverage</label>
                        </div>
                    </div>
                </div>
                <div class="clm-modal-footer">
                    <button type="button" class="clm-btn clm-btn-ghost" @onclick="CloseNewClaimDialog" disabled="@_savingNewClaim">Cancel</button>
                    <button type="submit" class="clm-btn clm-btn-primary" disabled="@_savingNewClaim">
                        @if (_savingNewClaim)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        Report Claim
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="clm-enterprise-page">
    <section class="clm-hero">
        <div class="clm-hero-left">
            <div class="clm-hero-icon"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i></div>
            <div>
                <div class="clm-title-row">
                    <h1>Claims Command Center</h1>
                    <span><i class="bi bi-building" aria-hidden="true"></i>@(_userContext?.TenantName ?? "Tenant")</span>
                    <span><i class="bi bi-lightning-charge" aria-hidden="true"></i>@FilteredClaims.Count.ToString("N0") visible</span>
                </div>
                <p>Monitor claim severity, reserves, litigation, subrogation, catastrophe exposure, handlers, and follow-up workflows from DB-backed claim data.</p>
            </div>
        </div>
        <div class="clm-hero-actions">
            <button type="button" class="clm-btn clm-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="clm-btn clm-btn-ghost" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="clm-btn clm-btn-ghost" @onclick='() => Nav.NavigateTo("/claims/follow-up")'><i class="bi bi-list-check" aria-hidden="true"></i> Follow-Up</button>
            <button type="button" class="clm-btn clm-btn-primary" @onclick="OpenNewClaimDialog"><i class="bi bi-plus-lg" aria-hidden="true"></i> Report Claim</button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="clm-error-banner" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>@_loadError</div>
    }

    <section class="clm-kpi-strip" aria-label="Claims KPIs">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="@KpiClass(kpi)" title="@kpi.Title" @onclick="() => ApplyKpi(kpi)">
                <span class="clm-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span>
                    <strong>@kpi.Value</strong>
                    <small>@kpi.Label</small>
                    <em>@kpi.Detail</em>
                </span>
            </button>
        }
    </section>

    <section class="clm-workflow-strip" aria-label="Claims workflow shortcuts">
        @foreach (var item in WorkflowCards)
        {
            <button type="button" class="@WorkflowClass(item)" @onclick="() => ApplyWorkflow(item)">
                <i class="bi @item.Icon" aria-hidden="true"></i>
                <span><strong>@item.Title</strong><small>@item.Detail</small></span>
            </button>
        }
    </section>

    <section class="clm-search-panel" aria-label="Claims filters">
        <div class="clm-search-wrap">
            <span class="clm-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="clm-search-body">
                <label>Search claims</label>
                <input class="clm-search-input" @bind="_search" @bind:event="oninput" placeholder="Claim #, policy, insured, claimant, carrier, handler..." />
                <span class="clm-search-hint">DB-backed claims only. Filters update all tabs, KPIs, board, and detail context.</span>
            </div>
        </div>
        <select class="clm-filter-select" @bind="_statusFilter">
            <option value="">All statuses</option>
            @foreach (var status in StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>
        <select class="clm-filter-select" @bind="_lobFilter">
            <option value="">All lines</option>
            @foreach (var lob in LobOptions)
            {
                <option value="@lob">@lob</option>
            }
        </select>
        <select class="clm-filter-select" @bind="_carrierFilter">
            <option value="">All carriers</option>
            @foreach (var carrier in CarrierOptions)
            {
                <option value="@carrier">@carrier</option>
            }
        </select>
        <select class="clm-filter-select" @bind="_handlerFilter">
            <option value="">All handlers</option>
            @foreach (var handler in HandlerOptions)
            {
                <option value="@handler">@handler</option>
            }
        </select>
        <button type="button" class="clm-btn clm-btn-ghost clm-btn-sm" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
        <div class="clm-search-result"><strong>@FilteredClaims.Count</strong><span>claims</span></div>
    </section>

    <section class="clm-view-tabs" role="tablist" aria-label="Claims views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="@TabClass(tab.Key)" role="tab" aria-selected="@(_activeTab == tab.Key)" @onclick="() => SelectTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>@tab.Label <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </section>

    @if (_loading)
    {
        <div class="clm-loading"><i class="bi bi-arrow-repeat clm-spin" aria-hidden="true"></i><strong>Loading claims command center...</strong></div>
    }
    else
    {
        <div class="clm-content-layout">
            <main class="clm-main-card">
                @if (_activeTab == "register")
                {
                    <div class="clm-card-head"><div><h2>Claims Register</h2><p>Prioritized by open severity, flags, reserves, and recency.</p></div><span>@FilteredClaims.Count claim(s)</span></div>
                    @if (FilteredClaims.Count == 0)
                    {
                        @EmptyState("bi-inbox", "No claims found", "No DB-backed claims match the current filters.")
                    }
                    else
                    {
                        <div class="clm-table-scroll">
                            <table class="clm-table">
                                <thead><tr><th>Claim</th><th>Insured</th><th>Status</th><th>Loss</th><th>Handler</th><th class="text-end">Incurred</th><th class="text-end">Actions</th></tr></thead>
                                <tbody>
                                    @foreach (var claim in FilteredClaims)
                                    {
                                        <tr class="@RowClass(claim)" @onclick="() => SelectClaim(claim)">
                                            <td data-label="Claim"><button type="button" class="clm-link" @onclick:stopPropagation="true" @onclick="@(() => OpenClaim(claim))">@claim.ClaimNumber</button><small>@claim.DateReported.ToString("MMM d, yyyy") / @(DaysOpenLabel(claim))</small></td>
                                            <td data-label="Insured"><strong>@claim.AccountName</strong><small>@claim.PolicyNumber / @claim.Lob</small></td>
                                            <td data-label="Status"><span class="@StatusClass(claim.Status)">@claim.Status</span></td>
                                            <td data-label="Loss"><strong>@claim.LossType</strong><small>@claim.PrimaryClaimant</small></td>
                                            <td data-label="Handler"><strong>@DisplayValue(claim.AssignedHandler, "Unassigned")</strong><small>@FlagSummary(claim)</small></td>
                                            <td data-label="Incurred" class="text-end"><strong>@claim.TotalIncurred.ToString("C0")</strong><small>Reserve @claim.TotalReserves.ToString("C0")</small></td>
                                            <td data-label="Actions" class="text-end">
                                                <div class="clm-row-actions" @onclick:stopPropagation="true">
                                                    <button type="button" class="clm-icon-btn" title="Open claim" @onclick="@(() => OpenClaim(claim))"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i></button>
                                                    <button type="button" class="clm-icon-btn" title="Account 360" @onclick="@(() => OpenAccount(claim))"><i class="bi bi-building" aria-hidden="true"></i></button>
                                                    <button type="button" class="clm-icon-btn" title="Policy" @onclick="@(() => OpenPolicy(claim))"><i class="bi bi-shield-check" aria-hidden="true"></i></button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else if (_activeTab == "board")
                {
                    <div class="clm-card-head"><div><h2>Status Board</h2><p>Operational view grouped by claim status.</p></div></div>
                    <div class="clm-board">
                        @foreach (var group in BoardGroups)
                        {
                            <section class="clm-board-col">
                                <header><span>@group.Status</span><strong>@group.Claims.Count</strong></header>
                                @foreach (var claim in group.Claims)
                                {
                                    <button type="button" class="@BoardCardClass(claim)" @onclick="@(() => SelectClaim(claim))">
                                        <strong>@claim.ClaimNumber</strong>
                                        <span>@claim.AccountName</span>
                                        <small>@claim.LossType / @claim.TotalIncurred.ToString("C0")</small>
                                    </button>
                                }
                            </section>
                        }
                    </div>
                }
                else if (_activeTab == "followup")
                {
                    <div class="clm-card-head"><div><h2>Follow-Up Priorities</h2><p>Open claims needing handler attention by severity and age.</p></div><span>@FollowUpClaims.Count item(s)</span></div>
                    <div class="clm-priority-list">
                        @foreach (var claim in FollowUpClaims)
                        {
                            <button type="button" class="@PriorityRowClass(claim)" @onclick="@(() => SelectClaim(claim))">
                                <i class="bi @PriorityIcon(claim)" aria-hidden="true"></i>
                                <span><strong>@claim.AccountName</strong><small>@claim.ClaimNumber / @claim.LossType / @(DaysOpenLabel(claim))</small></span>
                                <em>@claim.TotalIncurred.ToString("C0")</em>
                            </button>
                        }
                    </div>
                    @if (FollowUpClaims.Count == 0)
                    {
                        @EmptyState("bi-check-circle", "No follow-ups", "No open severity or flagged claims match the current filters.")
                    }
                }
                else
                {
                    <div class="clm-card-head"><div><h2>Claims Analytics</h2><p>Severity, reserve, litigation, subrogation, CAT, and handler mix.</p></div></div>
                    <div class="clm-analytics-grid">
                        @Metric("Total Claims", AllClaims.Count.ToString("N0"), "bi-exclamation-circle")
                        @Metric("Open Claims", OpenCount.ToString("N0"), "bi-folder2-open")
                        @Metric("Total Incurred", TotalIncurred.ToString("C0"), "bi-currency-dollar")
                        @Metric("Open Reserves", OpenReserves.ToString("C0"), "bi-safe")
                        @Metric("Avg Days Open", $"{AvgDaysOpen:N0}d", "bi-clock-history")
                        @Metric("Flagged", FlaggedCount.ToString("N0"), "bi-flag")
                    </div>
                }
            </main>

            <aside class="clm-detail-card">
                @if (_selected is null)
                {
                    @EmptyState("bi-layout-sidebar", "Select claim", "Choose a claim to inspect severity, reserves, flags, and action paths.")
                }
                else
                {
                    <div class="clm-detail-head">
                        <div>
                            <span class="clm-detail-eyebrow"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> Selected Claim</span>
                            <h2>@_selected.ClaimNumber</h2>
                            <p>@_selected.AccountName / @_selected.PolicyNumber</p>
                        </div>
                        <span class="@StatusClass(_selected.Status)">@_selected.Status</span>
                    </div>
                    <div class="clm-detail-body">
                        <div class="clm-detail-summary">
                            <div><span>Total Incurred</span><strong>@_selected.TotalIncurred.ToString("C0")</strong></div>
                            <div><span>Open Reserves</span><strong>@_selected.TotalReserves.ToString("C0")</strong></div>
                            <div><span>Days Open</span><strong>@(DaysOpenLabel(_selected))</strong></div>
                            <div><span>Handler</span><strong>@DisplayValue(_selected.AssignedHandler, "Unassigned")</strong></div>
                        </div>
                        <div class="clm-contact-card">
                            <strong>@_selected.LossType</strong>
                            <span>@_selected.PrimaryClaimant</span>
                            <span>@DisplayValue(_selected.LossLocation, "Loss location not recorded")</span>
                        </div>
                        <div class="clm-flag-grid">
                            @FlagChip(_selected.IsLitigation, "Litigation", "bi-gavel")
                            @FlagChip(_selected.HasSubrogation, "Subrogation", "bi-arrow-counterclockwise")
                            @FlagChip(_selected.IsCatastrophe, "CAT", "bi-cloud-lightning")
                            @FlagChip(_selected.IsDisputed, "Disputed", "bi-shield-exclamation")
                        </div>
                        <div class="clm-detail-actions">
                            <button type="button" class="clm-btn clm-btn-primary" @onclick="@(() => OpenClaim(_selected))"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Open Claim</button>
                            <button type="button" class="clm-btn clm-btn-ghost" @onclick="@(() => OpenAccount(_selected))"><i class="bi bi-building" aria-hidden="true"></i> Account 360</button>
                            <button type="button" class="clm-btn clm-btn-ghost" @onclick="@(() => OpenPolicy(_selected))"><i class="bi bi-shield-check" aria-hidden="true"></i> Policy</button>
                        </div>
                    </div>
                }
            </aside>
        </div>
    }
</div>

@code {
    private CurrentUserContextModel? _userContext;
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading;
    private bool _savingNewClaim;
    private bool _showNewClaimDialog;
    private string? _loadError;
    private string _search = string.Empty;
    private string _statusFilter = string.Empty;
    private string _lobFilter = string.Empty;
    private string _carrierFilter = string.Empty;
    private string _handlerFilter = string.Empty;
    private string _kpiFilter = "All";
    private string _activeTab = "register";
    private ClaimDto? _selected;
    private NewClaimForm _newClaim = new();
    private List<ClaimDto> _claims = [];
    private readonly List<ClaimToast> _toasts = [];

    private readonly TabDef[] _tabs = [new("register", "Register", "bi-table"), new("board", "Board", "bi-kanban"), new("followup", "Follow-Up", "bi-list-check"), new("analytics", "Analytics", "bi-bar-chart")];
    private readonly string[] _statuses = ["Open", "Closed", "Reopened", "In Litigation", "Subrogation", "Denied"];
    private readonly string[] _lobs = ["General Liability", "Commercial Auto", "Commercial Property", "Workers Comp", "Umbrella", "Professional Liab.", "Home/Dwelling", "Personal Auto"];
    private readonly string[] _lossTypes = ["Bodily Injury", "Property Damage", "Auto Collision", "Auto Comprehensive", "Workers Comp Injury", "Product Liability", "Professional Error", "Theft", "Fire", "Water/Flood", "Wind/Hail", "Slip & Fall", "Equipment Breakdown"];
    private readonly string[] _priorities = ["Standard", "High", "Critical"];

    private List<ClaimDto> AllClaims => _claims;
    private List<ClaimDto> FilteredClaims => AllClaims.Where(MatchesFilters).OrderByDescending(c => SeverityScore(c)).ThenByDescending(c => c.DateReported).ToList();
    private List<ClaimDto> FollowUpClaims => FilteredClaims.Where(c => !IsClosed(c) && (SeverityScore(c) >= 3 || c.DaysOpen >= 30)).Take(24).ToList();
    private IEnumerable<string> StatusOptions => AllClaims.Select(c => c.Status).Where(HasValue).Concat(_statuses).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);
    private IEnumerable<string> LobOptions => AllClaims.Select(c => c.Lob).Where(HasValue).Concat(_lobs).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);
    private IEnumerable<string> CarrierOptions => AllClaims.Select(c => c.Carrier).Where(HasValue).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);
    private IEnumerable<string> HandlerOptions => AllClaims.Select(c => c.AssignedHandler).Where(HasValue).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);
    private int OpenCount => AllClaims.Count(c => !IsClosed(c));
    private int LitigationCount => AllClaims.Count(c => c.IsLitigation || string.Equals(c.Status, "In Litigation", StringComparison.OrdinalIgnoreCase));
    private int SubrogationCount => AllClaims.Count(c => c.HasSubrogation || string.Equals(c.Status, "Subrogation", StringComparison.OrdinalIgnoreCase));
    private int CatCount => AllClaims.Count(c => c.IsCatastrophe || HasValue(c.CatCode));
    private int DisputedCount => AllClaims.Count(c => c.IsDisputed);
    private int FlaggedCount => AllClaims.Count(c => c.IsLitigation || c.HasSubrogation || c.IsCatastrophe || c.IsDisputed);
    private decimal TotalIncurred => AllClaims.Sum(c => c.TotalIncurred);
    private decimal OpenReserves => AllClaims.Where(c => !IsClosed(c)).Sum(c => c.TotalReserves);
    private int AvgDaysOpen => OpenCount == 0 ? 0 : (int)AllClaims.Where(c => !IsClosed(c)).Average(c => c.DaysOpen);
    private IReadOnlyList<KpiTile> Kpis => [
        new("Open", OpenCount.ToString("N0"), "bi-folder2-open", "red", "Open", "Active open claims", "Show open claims"),
        new("Litigation", LitigationCount.ToString("N0"), "bi-gavel", "purple", "Litigation", "Claims in litigation", "Show litigation claims"),
        new("Subrogation", SubrogationCount.ToString("N0"), "bi-arrow-counterclockwise", "cyan", "Subrogation", "Recovery potential", "Show subrogation claims"),
        new("CAT", CatCount.ToString("N0"), "bi-cloud-lightning", "amber", "Catastrophe", "Catastrophe exposure", "Show catastrophe claims"),
        new("Disputed", DisputedCount.ToString("N0"), "bi-shield-exclamation", "red", "Disputed", "Coverage disputed", "Show disputed claims"),
        new("Incurred", TotalIncurred.ToString("C0"), "bi-currency-dollar", "green", "All", "Total incurred", "Show all claims")
    ];
    private IReadOnlyList<WorkflowCard> WorkflowCards => [
        new("Severity review", $"{FollowUpClaims.Count(c => SeverityScore(c) >= 4):N0} high-severity item(s)", "bi-exclamation-triangle", "Severity", "followup"),
        new("Handler follow-up", $"{FollowUpClaims.Count:N0} claim(s) need attention", "bi-list-check", "FollowUp", "followup"),
        new("CAT operations", $"{CatCount:N0} catastrophe claim(s)", "bi-cloud-lightning", "Catastrophe", "board"),
        new("Financial review", OpenReserves.ToString("C0"), "bi-safe", "All", "analytics")
    ];
    private IReadOnlyList<BoardGroup> BoardGroups => StatusOptions.Select(status => new BoardGroup(status, FilteredClaims.Where(c => string.Equals(c.Status, status, StringComparison.OrdinalIgnoreCase)).Take(12).ToList())).Where(g => g.Claims.Count > 0).ToList();

    protected override async Task OnInitializedAsync()
    {
        ResetNewClaimForm();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Claims", "/claims"));
        Nav.LocationChanged += OnLocationChanged;
        await LoadAsync();
        ApplyQueryFilters();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _userContext ??= await CurrentUser.RequireAsync();
            _tenantId = _userContext.TenantId;
            _tenantAdminUserId = _userContext.UserId;
            var result = await Api.SearchClaimsAsync(_tenantId, pageSize: 500);
            _claims = (result?.Items ?? []).ToList();
            _selected = _selected is null ? FilteredClaims.FirstOrDefault() : FilteredClaims.FirstOrDefault(c => c.ClaimId == _selected.ClaimId) ?? FilteredClaims.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load claims: {ex.Message}";
            await ShowToast(_loadError, true);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool MatchesFilters(ClaimDto c) =>
        (string.IsNullOrWhiteSpace(_search) ||
         Contains(c.ClaimNumber, _search) || Contains(c.PolicyNumber, _search) || Contains(c.AccountName, _search) || Contains(c.PrimaryClaimant, _search) || Contains(c.Carrier, _search) || Contains(c.AssignedHandler, _search) || Contains(c.LossType, _search)) &&
        (string.IsNullOrWhiteSpace(_statusFilter) || string.Equals(c.Status, _statusFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_lobFilter) || string.Equals(c.Lob, _lobFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_carrierFilter) || string.Equals(c.Carrier, _carrierFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(_handlerFilter) || string.Equals(c.AssignedHandler, _handlerFilter, StringComparison.OrdinalIgnoreCase)) &&
        (_kpiFilter == "All" ||
         (_kpiFilter == "Open" && !IsClosed(c)) ||
         (_kpiFilter == "Litigation" && (c.IsLitigation || string.Equals(c.Status, "In Litigation", StringComparison.OrdinalIgnoreCase))) ||
         (_kpiFilter == "Subrogation" && (c.HasSubrogation || string.Equals(c.Status, "Subrogation", StringComparison.OrdinalIgnoreCase))) ||
         (_kpiFilter == "Catastrophe" && (c.IsCatastrophe || HasValue(c.CatCode))) ||
         (_kpiFilter == "Disputed" && c.IsDisputed) ||
         (_kpiFilter == "Severity" && SeverityScore(c) >= 4) ||
         (_kpiFilter == "FollowUp" && !IsClosed(c) && (SeverityScore(c) >= 3 || c.DaysOpen >= 30)));

    private void ApplyQueryFilters()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (query.TryGetValue("status", out var status)) _statusFilter = status.ToString();
        if (query.TryGetValue("lob", out var lob)) _lobFilter = lob.ToString();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ApplyQueryFilters();
        _ = InvokeAsync(StateHasChanged);
    }

    private void ApplyKpi(KpiTile kpi) => _kpiFilter = _kpiFilter == kpi.Filter ? "All" : kpi.Filter;
    private void ApplyWorkflow(WorkflowCard item) { _kpiFilter = item.Filter; _activeTab = item.Tab; }
    private void SelectTab(string key) => _activeTab = key;
    private void SelectClaim(ClaimDto claim) => _selected = claim;
    private void OpenClaim(ClaimDto claim) => Nav.NavigateTo($"/claims/{claim.ClaimId}");
    private void OpenAccount(ClaimDto claim) => Nav.NavigateTo($"/accounts/{claim.AccountId}");
    private void OpenPolicy(ClaimDto claim) => Nav.NavigateTo($"/policies/{claim.PolicyId}");
    private void ResetFilters() { _search = string.Empty; _statusFilter = string.Empty; _lobFilter = string.Empty; _carrierFilter = string.Empty; _handlerFilter = string.Empty; _kpiFilter = "All"; }
    private void OpenNewClaimDialog() { ResetNewClaimForm(); _showNewClaimDialog = true; }
    private void CloseNewClaimDialog() => _showNewClaimDialog = false;

    private async Task SaveNewClaimAsync()
    {
        _savingNewClaim = true;
        try
        {
            var id = await Api.CreateClaimAsync(new CreateClaimRequest
            {
                TenantId = _tenantId,
                PolicyNumber = Normalize(_newClaim.PolicyNumber) ?? string.Empty,
                AccountName = Normalize(_newClaim.AccountName) ?? string.Empty,
                Lob = _newClaim.Lob,
                Carrier = Normalize(_newClaim.Carrier) ?? string.Empty,
                LossType = _newClaim.LossType,
                PrimaryClaimant = Normalize(_newClaim.PrimaryClaimant) ?? string.Empty,
                DateOfLoss = _newClaim.DateOfLoss!.Value,
                DateReported = _newClaim.DateReported!.Value,
                LossDescription = Normalize(_newClaim.LossDescription) ?? string.Empty,
                LossLocation = Normalize(_newClaim.LossLocation),
                AssignedHandler = Normalize(_newClaim.AssignedHandler) ?? "Unassigned",
                Priority = _newClaim.Priority,
                Status = "Open",
                IsLitigation = _newClaim.IsLitigation,
                HasSubrogation = _newClaim.HasSubrogation,
                IsCatastrophe = _newClaim.IsCatastrophe,
                IsDisputed = _newClaim.IsDisputed,
                CreatedByUserId = _tenantAdminUserId
            });
            _showNewClaimDialog = false;
            await LoadAsync();
            await ShowToast($"Claim reported for policy {_newClaim.PolicyNumber}.");
            Nav.NavigateTo($"/claims/{id}");
        }
        catch (Exception ex)
        {
            await ShowToast($"Report claim failed: {ex.Message}", true);
        }
        finally
        {
            _savingNewClaim = false;
        }
    }

    private async Task ExportAsync()
    {
        var rows = FilteredClaims;
        var csv = new StringBuilder();
        csv.AppendLine("ClaimNumber,PolicyNumber,AccountName,Status,Lob,Carrier,LossType,Claimant,DateOfLoss,DateReported,DaysOpen,TotalIncurred,TotalReserves,TotalPaid,Handler");
        foreach (var c in rows)
        {
            csv.AppendLine(string.Join(',', Csv(c.ClaimNumber), Csv(c.PolicyNumber), Csv(c.AccountName), Csv(c.Status), Csv(c.Lob), Csv(c.Carrier), Csv(c.LossType), Csv(c.PrimaryClaimant), Csv(c.DateOfLoss.ToString("yyyy-MM-dd")), Csv(c.DateReported.ToString("yyyy-MM-dd")), c.DaysOpen, c.TotalIncurred, c.TotalReserves, c.TotalPaid, Csv(c.AssignedHandler)));
        }
        var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(csv.ToString()));
        var script = $"(() => {{ const a = document.createElement(\"a\"); a.href = \"data:text/csv;base64,{base64}\"; a.download = \"claims-register.csv\"; document.body.appendChild(a); a.click(); a.remove(); }})()";
        await Js.InvokeVoidAsync("eval", script);
        await ShowToast($"Exported {rows.Count:N0} claim(s).");
    }

    private async Task NotifyInvalidAsync() => await ShowToast("Please fix validation errors before reporting the claim.", true);

    private void ResetNewClaimForm()
    {
        _newClaim = new NewClaimForm
        {
            DateOfLoss = DateTime.Today,
            DateReported = DateTime.Today,
            AssignedHandler = "Unassigned",
            Priority = "Standard"
        };
    }

    private string TabClass(string key) => _activeTab == key ? "clm-view-btn clm-view-btn-active" : "clm-view-btn";
    private int TabCount(string key) => key switch { "register" => FilteredClaims.Count, "board" => BoardGroups.Sum(g => g.Claims.Count), "followup" => FollowUpClaims.Count, "analytics" => AllClaims.Count, _ => 0 };
    private string KpiClass(KpiTile kpi) => _kpiFilter == kpi.Filter ? $"clm-kpi-card clm-{kpi.Tone} clm-kpi-card-active" : $"clm-kpi-card clm-{kpi.Tone}";
    private string WorkflowClass(WorkflowCard item) => _kpiFilter == item.Filter && _activeTab == item.Tab ? "clm-workflow-card clm-active" : "clm-workflow-card";
    private static string StatusClass(string status) => $"clm-status clm-stage-{CssToken(status)}";
    private static string RowClass(ClaimDto c) => SeverityScore(c) >= 4 ? "clm-row-high" : IsClosed(c) ? "clm-row-closed" : string.Empty;
    private string BoardCardClass(ClaimDto c) => _selected?.ClaimId == c.ClaimId ? "clm-board-card clm-board-card-active" : "clm-board-card";
    private static string PriorityRowClass(ClaimDto c) => SeverityScore(c) >= 4 ? "clm-priority-row clm-priority-row-danger" : "clm-priority-row";
    private static string PriorityIcon(ClaimDto c) => c.IsLitigation ? "bi-gavel" : c.IsCatastrophe ? "bi-cloud-lightning" : c.IsDisputed ? "bi-shield-exclamation" : "bi-list-check";
    private static int SeverityScore(ClaimDto c) => (c.TotalIncurred >= 250000 ? 2 : c.TotalIncurred >= 100000 ? 1 : 0) + (c.IsLitigation ? 2 : 0) + (c.IsDisputed ? 1 : 0) + (c.IsCatastrophe ? 1 : 0) + (c.DaysOpen >= 120 && !IsClosed(c) ? 1 : 0);
    private static bool IsClosed(ClaimDto c) => string.Equals(c.Status, "Closed", StringComparison.OrdinalIgnoreCase) || string.Equals(c.Status, "Denied", StringComparison.OrdinalIgnoreCase);
    private static bool Contains(string? value, string search) => !string.IsNullOrWhiteSpace(value) && value.Contains(search, StringComparison.OrdinalIgnoreCase);
    private static bool HasValue(string? value) => !string.IsNullOrWhiteSpace(value);
    private static string DisplayValue(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static string FlagSummary(ClaimDto c) => string.Join(" / ", new[] { c.IsLitigation ? "Litigation" : null, c.HasSubrogation ? "Subrogation" : null, c.IsCatastrophe ? "CAT" : null, c.IsDisputed ? "Disputed" : null }.Where(HasValue).DefaultIfEmpty("No flags"));
    private static string DaysOpenLabel(ClaimDto claim) => claim.ClosedDate.HasValue || string.Equals(claim.Status, "Closed", StringComparison.OrdinalIgnoreCase) ? "Closed" : $"{claim.DaysOpen:N0}d open";
    private static string CssToken(string value) => string.IsNullOrWhiteSpace(value) ? "none" : value.ToLowerInvariant().Replace(" ", "-").Replace("/", "-");
    private static string? Normalize(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string Csv(string? value) => "\"" + (value ?? string.Empty).Replace("\"", "\"\"") + "\"";

    private static RenderFragment Metric(string label, string value, string icon) => builder =>
    {
        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class", "clm-metric");
        builder.OpenElement(2, "i");
        builder.AddAttribute(3, "class", $"bi {icon}");
        builder.AddAttribute(4, "aria-hidden", "true");
        builder.CloseElement();
        builder.OpenElement(5, "span");
        builder.AddContent(6, label);
        builder.CloseElement();
        builder.OpenElement(7, "strong");
        builder.AddContent(8, value);
        builder.CloseElement();
        builder.CloseElement();
    };

