    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "clm-empty-state");
        builder.OpenElement(2, "i");
        builder.AddAttribute(3, "class", $"bi {icon}");
        builder.AddAttribute(4, "aria-hidden", "true");
        builder.CloseElement();
        builder.OpenElement(5, "strong");
        builder.AddContent(6, title);
        builder.CloseElement();
        builder.OpenElement(7, "span");
        builder.AddContent(8, detail);
        builder.CloseElement();
        builder.CloseElement();
    };

    private static RenderFragment FlagChip(bool active, string label, string icon) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", active ? "clm-flag-chip clm-flag-chip-active" : "clm-flag-chip");
        builder.OpenElement(2, "i");
        builder.AddAttribute(3, "class", $"bi {icon}");
        builder.AddAttribute(4, "aria-hidden", "true");
        builder.CloseElement();
        builder.AddContent(5, label);
        builder.CloseElement();
    };

    private async Task ShowToast(string content, bool danger = false)
    {
        var toast = new ClaimToast(Guid.NewGuid(), content, danger ? "clm-toast-danger" : "clm-toast-success", danger ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill");
        _toasts.Add(toast);
        await InvokeAsync(StateHasChanged);
        _ = Task.Run(async () =>
        {
            await Task.Delay(4500);
            await InvokeAsync(() => DismissToast(toast.Id));
        });
    }

    private void DismissToast(Guid id)
    {
        _toasts.RemoveAll(t => t.Id == id);
        StateHasChanged();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

