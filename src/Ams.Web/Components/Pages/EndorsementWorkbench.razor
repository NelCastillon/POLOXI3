    IEnumerable<PolicyEndorsementDto> BaseTabRows => _activeTab switch
    {
        "open" => _rows.Where(r => r.Status is "Pending" or "In Review" or "Info Needed"),
        "review" => _rows.Where(r => r.Status == "In Review"),
        "approved" => _rows.Where(r => r.Status == "Approved"),
        "issued" => _rows.Where(r => r.Status == "Issued"),
        "declined" => _rows.Where(r => r.Status == "Declined"),
        "urgent" => _rows.Where(r => r.IsUrgent),
        "carrier" => _rows.OrderBy(r => r.Carrier).ThenBy(r => r.DueDate),
        "lob" => _rows.OrderBy(r => r.LineOfBusiness).ThenBy(r => r.DueDate),
        _ => _rows,
    };

    IEnumerable<PolicyEndorsementDto> FilteredRows => ApplyEnterpriseFilters(BaseTabRows);
    IEnumerable<PolicyEndorsementDto> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize);
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)PageSize));
    string PageSummary
    {
        get
        {
            var total = FilteredRows.Count();
            if (total == 0) return "No endorsements";
            var start = ((_page - 1) * PageSize) + 1;
            var end = Math.Min(_page * PageSize, total);
            return $"Showing {start}-{end} of {total}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policies", "/policies"), new("Endorsements", "/policies/endorsements"));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var center = await Api.GetPolicyEndorsementCenterAsync(_tenantId);
            _rows.Clear();
            _activities.Clear();
            _deltas.Clear();
            _rows.AddRange(center?.Endorsements ?? []);
            _activities.AddRange(center?.Activities ?? []);
            _deltas.AddRange(center?.Deltas ?? []);
            if (_rows.Count == 0)
                BuildStubData();
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load endorsements: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger");
            if (_rows.Count == 0)
                BuildStubData();
        }
        finally
        {
            _loading = false;
        }
    }

    void BuildStubData()
    {
        var rng = new Random(130);
        var accounts = new[] { "Sullivan Manufacturing LLC", "Lakeside Medical Group", "Apex Tech Solutions", "Green Valley Foods Inc", "Harbor Logistics Co", "Cascade Retail Group" };
        var people = new[] { "Amy Scott", "Dan Rivera", "Paula Ngo", "Chris Hall", "Sarah Chen" };
        _rows.Clear();
        _activities.Clear();
        _deltas.Clear();
        for (var i = 1; i <= 18; i++)
        {
            var id = Guid.NewGuid();
            var status = Statuses[rng.Next(Statuses.Length)];
            var delta = rng.Next(-4000, 12000);
            var row = new PolicyEndorsementDto
            {
                EndorsementId = id,
                TenantId = _tenantId,
                EndorsementNumber = $"END-2025-{i:D4}",
                PolicyNumber = $"POL-2025-{rng.Next(10000, 99999)}",
                AccountName = accounts[rng.Next(accounts.Length)],
                LineOfBusiness = LinesOfBusiness[rng.Next(0, 7)],
                Carrier = Carriers[rng.Next(Carriers.Length)],
                EndorsementType = EndorsementTypes[rng.Next(EndorsementTypes.Length)],
                Description = "Enterprise endorsement workflow synchronized from policy servicing activity.",
                EffectiveDate = DateTime.Today.AddDays(rng.Next(-20, 45)),
                RequestedDateUtc = DateTime.UtcNow.AddDays(-rng.Next(1, 18)),
                PremiumDelta = delta,
                Status = status,
                Priority = rng.Next(0, 5) == 0 ? "High" : "Normal",
                RequestedByName = people[rng.Next(people.Length)],
                AssignedToName = people[rng.Next(people.Length)],
                UnderwriterName = people[rng.Next(people.Length)],
                Reason = "Policy servicing change requested by client or carrier.",
                RequiredDocuments = "Signed change request; supporting exposure schedule.",
                WorkflowStage = StageFor(status),
                DueDate = DateTime.Today.AddDays(rng.Next(-3, 12)),
                IsUrgent = rng.Next(0, 5) == 0
            };
            _rows.Add(row);
            _activities.Add(new PolicyEndorsementActivityDto { ActivityId = Guid.NewGuid(), EndorsementId = id, TenantId = _tenantId, ActivityType = "Created", Subject = "Endorsement request created", Notes = row.Description, CreatedByName = row.RequestedByName, ActivityDateUtc = row.RequestedDateUtc });
            _deltas.Add(new PolicyEndorsementDeltaDto { DeltaId = Guid.NewGuid(), EndorsementId = id, TenantId = _tenantId, FieldName = "Annual Premium", BeforeValue = "Current premium", AfterValue = delta.ToString("+$#,##0;-$#,##0;$0"), NumericDelta = delta });
        }
    }

    IEnumerable<PolicyEndorsementDto> ApplyEnterpriseFilters(IEnumerable<PolicyEndorsementDto> rows)
    {
        if (_kpiFilter is not null)
        {
            rows = _kpiFilter switch
            {
                "__open" => rows.Where(r => r.Status is "Pending" or "In Review" or "Info Needed"),
                "__urgent" => rows.Where(r => r.IsUrgent),
                "__premium" => rows.Where(r => r.PremiumDelta != 0),
                _ => rows.Where(r => r.Status == _kpiFilter)
            };
        }

        if (string.IsNullOrWhiteSpace(_searchText)) return rows;
        var term = _searchText.Trim();
        return rows.Where(r => SearchBlob(r).Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    static string SearchBlob(PolicyEndorsementDto r) => string.Join(' ', r.EndorsementNumber, r.PolicyNumber, r.AccountName, r.LineOfBusiness, r.Carrier, r.EndorsementType, r.Description, r.Status, r.Priority, r.RequestedByName, r.AssignedToName, r.UnderwriterName, r.Reason, r.RequiredDocuments, r.WorkflowStage, r.EffectiveDate.ToString("MM/dd/yyyy"), r.DueDate?.ToString("MM/dd/yyyy"), r.PremiumDelta.ToString());

