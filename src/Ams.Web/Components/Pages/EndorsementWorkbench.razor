@page "/policies/endorsements"
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.PolicyEndorsements
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Enterprise Endorsements - AMS</PageTitle>

<div class="ew-enterprise-page">
    <div class="ew-header pb-white-on-dark">
        <div class="ew-header-left">
            <div class="ew-lob-icon"><i class="bi bi-file-earmark-diff" aria-hidden="true"></i></div>
            <div class="ew-header-info">
                <div class="ew-title-row">
                    <h1 class="ew-page-title">Policy Endorsements</h1>
                    <span class="ew-status-pill"><i class="bi bi-shield-check" aria-hidden="true"></i> Enterprise workflow</span>
                    <span class="ew-sub-chip"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Policy changes</span>
                    <span class="ew-sub-chip"><i class="bi bi-person-check" aria-hidden="true"></i> Approvals</span>
                    <span class="ew-sub-chip"><i class="bi bi-diagram-3" aria-hidden="true"></i> Accounting &amp; documents</span>
                </div>
            </div>
        </div>
        <div class="ew-header-actions">
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Refresh endorsements" @onclick="LoadAsync">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh
            </button>
            @if (Can("ENDORSEMENT_CREATE"))
            {
                <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCreateAsync">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> Create Endorsement
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-@_messageKind ew-load-error" role="alert">
            <i class="bi @(_messageKind == "danger" ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
            <span>@_message</span>
        </div>
    }

    @if (_loading)
    {
        <div class="ew-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading policy endorsements...</span></div>
    }
    else
    {
        <div class="ew-workflow-strip" aria-label="Endorsement workspace summary">
            <div class="ew-workflow-card"><i class="bi bi-collection" aria-hidden="true"></i><div><strong>@_center.Endorsements.Count</strong><small>Total endorsements</small></div></div>
            <div class="ew-workflow-card"><i class="bi bi-hourglass-split" aria-hidden="true"></i><div><strong>@_center.Endorsements.Count(x => x.Status is not ("Completed" or "Declined" or "Cancelled"))</strong><small>Active workflows</small></div></div>
            <div class="ew-workflow-card"><i class="bi bi-check2-circle" aria-hidden="true"></i><div><strong>@_center.Endorsements.Count(x => x.Status == "Completed")</strong><small>Completed</small></div></div>
            <button type="button" class="ew-workflow-card ew-workflow-card--button" @onclick="ShowApprovalInbox"><i class="bi bi-person-check" aria-hidden="true"></i><div><strong>@_approvalInbox.Count</strong><small>My approvals</small></div></button>
        </div>

        @if (_showApprovalInbox && Can("ENDORSEMENT_APPROVE"))
        {
            <section class="ew-approval-inbox" aria-label="My assigned endorsement approvals">
                <div class="ew-section-title"><i class="bi bi-inbox" aria-hidden="true"></i><div><strong>My approval queue</strong><small>Pending endorsements assigned to the authenticated approver</small></div><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showApprovalInbox = false"><i class="bi bi-x-lg"></i></button></div>
                @if (_approvalInbox.Count == 0) { <div class="ew-next-action-empty"><i class="bi bi-check2-circle"></i><div><strong>No approvals awaiting you</strong><span>New tenant-routed approvals will appear here.</span></div></div> }
                else { <div class="ew-approval-inbox-list">@foreach (var item in _approvalInbox){<button type="button" class="ew-approval-inbox-row" @onclick="() => SelectApprovalAsync(item)"><span><strong>@item.EndorsementNumber</strong><small>@item.PolicyNumber · @item.AccountName</small></span><span><strong>@item.ApprovalLevelCode</strong><small>@item.RequestedDateUtc.ToLocalTime()</small></span><i class="bi bi-chevron-right"></i></button>}</div> }
            </section>
        }

        @NextActionPanel()

        <div class="ew-content-layout">
            <section class="ew-main-card" aria-label="Endorsement register">
                <div class="ew-grid-toolbar">
                    <div class="ew-search-box">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input @bind="_search" @bind:event="oninput" placeholder="Search endorsement, policy, account, status" aria-label="Search endorsements" />
                    </div>
                    <span class="ew-page-chip">@FilteredEndorsements.Count() results</span>
                </div>
                <div class="ew-endorsement-list">
                    @if (!FilteredEndorsements.Any())
                    {
                        <div class="ew-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><strong>No endorsements found</strong><span>Adjust the search criteria to view other records.</span></div>
                    }
                    else
                    {
                        @foreach (var endorsement in FilteredEndorsements)
                        {
                            <button type="button" class="ew-endorsement-row @(endorsement.EndorsementId == _detail?.Endorsement.EndorsementId ? "ew-endorsement-row--active" : null)" @onclick="() => SelectAsync(endorsement.EndorsementId)">
                                <span class="ew-avatar"><i class="bi bi-file-earmark-diff" aria-hidden="true"></i></span>
                                <span class="ew-endorsement-main"><strong>@endorsement.EndorsementNumber</strong><span>@endorsement.PolicyNumber · @endorsement.AccountName</span><small>@endorsement.EndorsementType · Effective @endorsement.EffectiveDate.ToString("d")</small></span>
                                <span class="ew-endorsement-side"><span class="ew-status @StatusCss(endorsement.Status)">@endorsement.Status</span>@if (_canViewFinancial){<strong class="@DeltaCss(endorsement.TotalCostDelta)">@endorsement.TotalCostDelta.ToString("C2")</strong>}</span>
                                <i class="bi bi-chevron-right ew-row-chevron" aria-hidden="true"></i>
                            </button>
                        }
                    }
                </div>
                    @if (_workflowDialogAction == "RequestInformation")
                    {
                        <div class="ew-wizard-field ew-workflow-dialog-field">
                            <label for="endorsement-rfi-due-date">Response due date</label>
                            <input id="endorsement-rfi-due-date" type="date" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" @bind="_workflowDueDate" />
                        </div>
                    }
                    @if (_workflowDialogAction == "Reverse")
                    {
                        <div class="ew-wizard-field ew-workflow-dialog-field">
                            <label for="endorsement-reversal-date">Reversal effective date</label>
                            <input id="endorsement-reversal-date" type="date" @bind="_workflowDueDate" />
                        </div>
                    }
            </section>

            <aside class="ew-detail-card" aria-label="Selected endorsement workflow">
                @if (_detail is null)
                {
                    <div class="ew-detail-empty"><i class="bi bi-layout-text-sidebar-reverse" aria-hidden="true"></i><strong>Select an endorsement</strong><span>Choose a record to inspect policy changes, approvals, automation, versions, and workflow history.</span></div>
                }
                else
                {
                    @DetailPanel()
                }
            </aside>
        </div>
    }
</div>

@if (_showWizard)
{
    <div class="um-modal-backdrop ew-wizard-backdrop" role="presentation" @onclick="CloseWizard">
        <div class="um-modal ew-wizard-modal" role="dialog" aria-modal="true" aria-labelledby="endorsement-wizard-title" @onclick:stopPropagation="true">
            <div class="um-modal-header ew-wizard-header">
                <i class="bi bi-file-earmark-diff" aria-hidden="true"></i>
                <div>
                    <span id="endorsement-wizard-title">@(_editingId.HasValue ? "Edit Endorsement Draft" : "Create Endorsement")</span>
                    <small>Step @_step of 7 · @StepTitle</small>
                </div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" title="Close endorsement wizard" aria-label="Close endorsement wizard" @onclick="CloseWizard"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="ew-wizard-progress" aria-label="Endorsement wizard progress">
                @for (var wizardStep = 1; wizardStep <= 7; wizardStep++)
                {
                    var stepNumber = wizardStep;
                    <span class="@(stepNumber <= _step ? "ew-wizard-progress-step ew-wizard-progress-step--active" : "ew-wizard-progress-step")"><i>@stepNumber</i><span>@WizardStepLabel(stepNumber)</span></span>
                }
            </div>
            <div class="um-modal-body ew-wizard-body">
                <div class="ew-wizard-step-card">
                    @WizardStep()
                </div>
            </div>
            <div class="um-modal-footer ew-wizard-footer">
                <button type="button" class="um-btn um-btn-ghost" disabled="@_busy" @onclick="CloseWizard">Cancel</button>
                <span class="ew-wizard-footer-spacer"></span>
                @if (_step > 1)
                {
                    <button type="button" class="um-btn um-btn-ghost" disabled="@_busy" @onclick="PreviousStep"><i class="bi bi-arrow-left"></i> Back</button>
                }
                @if (_step < 7)
                {
                    <button type="button" class="um-btn um-btn-primary" disabled="@_busy" @onclick="NextStep">Continue <i class="bi bi-arrow-right"></i></button>
                }
                else
                {
                    <button type="button" class="um-btn um-btn-ghost" disabled="@_busy" @onclick="() => SaveWizardAsync(false)"><i class="bi bi-save"></i> Save Draft</button>
                    <button type="button" class="um-btn um-btn-primary" disabled="@_busy" @onclick="() => SaveWizardAsync(true)">@if (_busy){<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>}<i class="bi bi-send"></i> Save and Submit</button>
                }
            </div>
        </div>
    </div>
}

@if (_selectedTransition is not null)
{
    <div class="um-modal-backdrop ew-wizard-backdrop" role="presentation" @onclick="CloseTransitionDialog">
        <div class="um-modal ew-decision-modal" role="dialog" aria-modal="true" aria-labelledby="endorsement-decision-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-signpost-split" aria-hidden="true"></i>
                <span id="endorsement-decision-title">@_selectedTransition.ConfirmationTitle</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" title="Close workflow action" aria-label="Close workflow action" disabled="@_busy" @onclick="CloseTransitionDialog"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-modal-body">
                <div class="um-form-grid">
                    <div class="ew-decision-message">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        <div><strong>@_selectedTransition.ActionLabel</strong><span>@_selectedTransition.ConfirmationMessage</span></div>
                    </div>
                    @RoutePreviewPanel()
                    <div class="um-form-field">
                        <label for="endorsement-decision-notes">@_selectedTransition.NotesLabel@(_selectedTransition.RequiresNotes ? " *" : string.Empty)</label>
                        <textarea id="endorsement-decision-notes" class="form-control" rows="5" maxlength="2000" placeholder="@_selectedTransition.NotesPlaceholder" @bind="_transitionNotes"></textarea>
                        @if (!string.IsNullOrWhiteSpace(_transitionValidationError))
                        {
                            <div class="text-danger">@_transitionValidationError</div>
                        }
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" disabled="@_busy" @onclick="CloseTransitionDialog">Cancel</button>
                <button type="button" class="um-btn um-btn-primary" disabled="@_busy" @onclick="ExecuteTransitionAsync">
                    @if (_busy) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                    <i class="bi bi-arrow-right-circle"></i> @_selectedTransition.ActionLabel
                </button>
            </div>
        </div>
    </div>
}

@if (_workflowDialogAction is not null && _detail is not null)
{
    <div class="um-modal-backdrop" role="presentation" @onclick="CloseWorkflowDialog">
        <div class="um-modal ew-workflow-modal" role="dialog" aria-modal="true" aria-labelledby="endorsement-workflow-dialog-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi @WorkflowDialogIcon" aria-hidden="true"></i>
                <span id="endorsement-workflow-dialog-title">@WorkflowDialogTitle</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" disabled="@_busy" @onclick="CloseWorkflowDialog"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-modal-body">
                <div class="um-form-grid">
                    @RoutePreviewPanel()
                    <div class="ew-wizard-field ew-workflow-dialog-field">
                        <label for="endorsement-workflow-notes">@WorkflowDialogLabel</label>
                        <textarea id="endorsement-workflow-notes" rows="6" maxlength="2000" @bind="_workflowDialogNotes" placeholder="@WorkflowDialogPlaceholder"></textarea>
                        @if (!string.IsNullOrWhiteSpace(_workflowDialogValidationError))
                        {
                            <div class="text-danger">@_workflowDialogValidationError</div>
                        }
                    </div>
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" disabled="@_busy" @onclick="CloseWorkflowDialog">Cancel</button>
                <button type="button" class="um-btn @WorkflowDialogButtonCss" disabled="@_busy" @onclick="ExecuteWorkflowDialogAsync">
                    @if (_busy) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                    <i class="bi @WorkflowDialogIcon"></i> @WorkflowDialogSubmitLabel
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "policyId")]
    public Guid? RequestedPolicyId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "endorsement")]
    public string? RequestedEndorsement { get; set; }

    private Guid _tenantId;
    private CurrentUserContextModel? _user;
    private bool _loading = true;
    private bool _busy;
    private bool _canViewFinancial;
    private string _currencyCode = string.Empty;
    private string _search = string.Empty;
    private string? _message;
    private string _messageKind = "success";
    private PolicyEndorsementCenterDto _center = new();
    private PolicyEndorsementCatalogDto _catalog = new();
    private IReadOnlyList<PolicyEndorsementTypeCatalogDto> _availableTypes = [];
    private PolicyEndorsementWorkflowDetailDto? _detail;
    private IReadOnlyList<PolicyEndorsementApprovalInboxItemDto> _approvalInbox = [];
    private bool _showApprovalInbox;
    private PolicyEndorsementTransitionDto? _selectedTransition;
    private string _transitionNotes = string.Empty;
    private string? _transitionValidationError;
    private string? _workflowDialogAction;
    private string _workflowDialogNotes = string.Empty;
    private string? _workflowDialogValidationError;
    private DateTime? _workflowDueDate;
    private PolicyEndorsementApprovalDto? _workflowApproval;
    private PolicyEndorsementInformationRequestDto? _workflowInformationRequest;
    private PolicyEndorsementRoutePreviewDto? _routePreview;
    private bool _routePreviewLoading;
    private string? _routePreviewError;
    private readonly List<PolicyRegisterDto> _policies = [];
    private bool _showWizard;
    private bool _policyDropdownOpen;
    private string _policySearchText = string.Empty;
    private int _step = 1;
    private Guid? _editingId;
    private readonly WizardModel _wizard = new();

    private IEnumerable<PolicyEndorsementDto> FilteredEndorsements => _center.Endorsements.Where(x => string.IsNullOrWhiteSpace(_search) || string.Join(' ', x.EndorsementNumber, x.PolicyNumber, x.AccountName, x.Status, x.EndorsementType).Contains(_search, StringComparison.OrdinalIgnoreCase));
    private IEnumerable<PolicyRegisterDto> FilteredPolicyOptions => _policies
        .Where(x => string.IsNullOrWhiteSpace(_policySearchText) || string.Join(' ', x.PolicyNumber, x.AccountName, x.CarrierName, x.LineOfBusiness, x.Status).Contains(_policySearchText.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.PolicyNumber)
        .Take(30);
    private bool Can(string permission) => _user?.HasPermission(permission) == true || _user?.HasPermission("ENDORSEMENT_MANAGE") == true;
    private bool CanTransition(PolicyEndorsementTransitionDto transition) => Can(transition.RequiredPermissionCode ?? "ENDORSEMENT_MANAGE");
    private bool IsAssignedApprover(PolicyEndorsementApprovalDto approval) => Can("ENDORSEMENT_APPROVE") && approval.AssignedToUserId == _user?.UserId;
    private bool IsAssignedInformationRequest(PolicyEndorsementInformationRequestDto request) => request.AssignedToUserId == _user?.UserId;
    private static string RouteStrategyLabel(PolicyEndorsementRoutePreviewDto preview) => preview.AssignmentStrategyCode switch { "ExplicitUser" => "Configured user", "Role" => $"Role · {preview.AssignedRoleCode}", "Permission" => "Permission-based", "Requestor" => "Original requestor", "AccountManager" => "Assigned Account Manager fallback", _ => preview.AssignmentStrategyCode };
    private RenderFragment RoutePreviewPanel() => @<text>
        @if (_routePreviewLoading)
        {
            <div class="ew-route-preview ew-route-preview--loading"><span class="um-spinner" aria-hidden="true"></span><span>Resolving tenant workflow route...</span></div>
        }
        else if (_routePreview is not null)
        {
            <section class="ew-route-preview" aria-label="Workflow routing summary">
                <div class="ew-route-preview-head"><span class="ew-route-avatar"><i class="bi bi-person-check"></i></span><div><small>Assigned recipient</small><strong>@_routePreview.AssignedToName</strong><span>@_routePreview.AssignedToEmail</span></div><span class="ew-route-badge"><i class="bi bi-database-check"></i> Tenant routed</span></div>
                <div class="ew-route-preview-grid"><div><small>Destination</small><strong>@_routePreview.DestinationStatusCode</strong></div>@if (!string.IsNullOrWhiteSpace(_routePreview.ApprovalLevelCode)){<div><small>Approval level</small><strong>@_routePreview.ApprovalLevelCode</strong></div>}<div><small>Routing method</small><strong>@RouteStrategyLabel(_routePreview)</strong></div><div><small>Required authority</small><strong>@_routePreview.RequiredPermissionCode</strong></div></div>
                <p><i class="bi bi-shield-lock"></i> Recipient eligibility is resolved from active tenant users, roles, and permissions. Final routing is revalidated when submitted.</p>
            </section>
        }
        else if (!string.IsNullOrWhiteSpace(_routePreviewError))
        {
            <div class="ew-route-preview-error"><i class="bi bi-exclamation-triangle"></i><span>@_routePreviewError</span></div>
        }
    </text>;
    private string WorkflowDialogTitle => _workflowDialogAction switch { "Approve" => "Approve endorsement", "Reject" => "Reject endorsement", "RequestInformation" => "Request for Information", "Respond" => "Respond to Request for Information", "Resubmit" => "Resubmit for review", "Reverse" => "Reverse completed endorsement", _ => "Endorsement workflow" };
    private string WorkflowDialogLabel => _workflowDialogAction switch { "RequestInformation" => "Information required", "Respond" => "Response", "Resubmit" => "Resubmission notes", "Reverse" => "Reversal reason", _ => "Decision notes" };
    private string WorkflowDialogPlaceholder => _workflowDialogAction switch { "RequestInformation" => "Describe exactly what information or documentation is required.", "Respond" => "Provide the requested information and identify any supporting documentation.", "Resubmit" => "Summarize what was updated before returning this endorsement to review.", "Reverse" => "Explain why this completed endorsement must be reversed.", _ => "Record the rationale for this decision." };
    private string WorkflowDialogSubmitLabel => _workflowDialogAction switch { "Approve" => "Approve", "Reject" => "Reject", "RequestInformation" => "Send request", "Respond" => "Submit response", "Resubmit" => "Resubmit", "Reverse" => "Create reversal", _ => "Continue" };
    private string WorkflowDialogIcon => _workflowDialogAction switch { "Approve" => "bi-check-circle", "Reject" => "bi-x-octagon", "RequestInformation" => "bi-question-circle", "Respond" => "bi-reply", "Resubmit" => "bi-arrow-repeat", "Reverse" => "bi-arrow-counterclockwise", _ => "bi-diagram-3" };
    private string WorkflowDialogButtonCss => _workflowDialogAction switch { "Approve" => "um-btn-success", "Reject" or "Reverse" => "um-btn-danger", _ => "um-btn-primary" };
    private string StepTitle => _step switch { 1 => "Type", 2 => "Effective Date", 3 => "Reason", 4 => "Modify Policy", 5 => "Compare", 6 => "Premium Impact", _ => "Submit" };
    private static string WizardStepLabel(int step) => step switch { 1 => "Type", 2 => "Effective", 3 => "Reason", 4 => "Changes", 5 => "Compare", 6 => "Financial", _ => "Submit" };
    private static string StatusCss(string? status) => status?.ToUpperInvariant() switch
    {
        "COMPLETED" or "APPROVED" => "ew-status-approved",
        "ISSUED" => "ew-status-issued",
        "DECLINED" or "REJECTED" or "CANCELLED" => "ew-status-declined",
        "INREVIEW" or "PENDINGAPPROVAL" or "PENDING" => "ew-status-review",
        "NEEDMOREINFO" => "ew-status-info",
        _ => "ew-status-pending"
    };
    private static string DeltaCss(decimal value) => value switch { > 0 => "ew-delta-pos", < 0 => "ew-delta-neg", _ => "ew-delta-zero" };

    protected override async Task OnInitializedAsync()
    {
        _user = await CurrentUser.RequireAsync();
        _tenantId = _user.TenantId;
        _canViewFinancial = Can("ENDORSEMENT_FINANCIAL_VIEW");
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policies", "/policies"), new("Endorsements", "/policies/endorsements"));
        await LoadAsync();
        if (!string.IsNullOrWhiteSpace(RequestedEndorsement))
        {
            var requested = RequestedEndorsement.Trim();
            var endorsement = _center.Endorsements.FirstOrDefault(x =>
                string.Equals(x.EndorsementNumber, requested, StringComparison.OrdinalIgnoreCase) ||
                (Guid.TryParse(requested, out var requestedId) && x.EndorsementId == requestedId));
            if (endorsement is not null)
            {
                _search = endorsement.EndorsementNumber;
                await SelectAsync(endorsement.EndorsementId);
            }
            else
            {
                ShowError($"Endorsement '{requested}' was not found in the current tenant.");
            }
        }
        else if (_center.Endorsements.FirstOrDefault() is { } firstEndorsement)
        {
            await SelectAsync(firstEndorsement.EndorsementId);
        }
        if (RequestedPolicyId.HasValue && RequestedPolicyId != Guid.Empty && Can("ENDORSEMENT_CREATE"))
        {
            await OpenCreateAsync();
            _wizard.PolicyId = RequestedPolicyId.Value;
            await PolicyChangedAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _center = await Api.GetPolicyEndorsementCenterAsync(_tenantId) ?? new();
            _catalog = await Api.GetPolicyEndorsementCatalogAsync(_tenantId) ?? new();
            _currencyCode = (await Api.GetAgencyProfileAsync(_tenantId))?.CurrencyCode ?? string.Empty;
            _approvalInbox = Can("ENDORSEMENT_APPROVE") ? await Api.GetPolicyEndorsementApprovalInboxAsync(_tenantId) ?? [] : [];
            var policies = await Api.SearchPolicyRegisterAsync(_tenantId, pageSize: 500);
            _policies.Clear();
            _policies.AddRange(policies?.Items ?? []);
            if (_detail is not null) await SelectAsync(_detail.Endorsement.EndorsementId);
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _loading = false; }
    }

    private void ShowApprovalInbox() => _showApprovalInbox = true;

    private async Task SelectApprovalAsync(PolicyEndorsementApprovalInboxItemDto item)
    {
        _showApprovalInbox = false;
        _search = item.EndorsementNumber;
        await SelectAsync(item.EndorsementId);
    }

    private async Task SelectAsync(Guid endorsementId)
    {
        try { _detail = await Api.GetPolicyEndorsementWorkflowDetailAsync(_tenantId, endorsementId); }
        catch (Exception ex) { ShowError(ex.Message); }
    }

    private RenderFragment NextActionPanel() => @<section class="ew-next-action" aria-label="Next workflow action">
        <div class="ew-section-title"><i class="bi bi-signpost-split" aria-hidden="true"></i><div><strong>Next action</strong><small>What should happen next in this workflow</small></div></div>
        @if (_detail is null)
        {
            <div class="ew-next-action-empty">
                <i class="bi bi-cursor" aria-hidden="true"></i>
                <div><strong>Select an endorsement</strong><span>Choose an endorsement below to load its tenant-configured workflow actions and instructions.</span></div>
            </div>
        }
        else if (_detail.AvailableTransitions.Count > 0)
        {
            <div class="ew-next-action-list">
                @foreach (var transition in _detail.AvailableTransitions)
                {
                    var canExecute = CanTransition(transition);
                    <div class="ew-next-action-item @(canExecute ? "" : "ew-next-action-item--restricted")">
                        <div class="ew-next-action-copy">
                            <span class="ew-next-action-step">@transition.FromStatusCode <i class="bi bi-arrow-right"></i> @transition.ToStatusCode</span>
                            <strong>@transition.ActionLabel</strong>
                            <p>@transition.Instruction</p>
                            @if (!canExecute)
                            {
                                <small><i class="bi bi-lock"></i> Hand off to a user with <strong>@(transition.RequiredPermissionCode ?? "ENDORSEMENT_MANAGE")</strong> permission.</small>
                            }
                        </div>
                        @if (canExecute)
                        {
                            <button type="button" class="um-btn um-btn-primary um-btn-sm" @onclick="() => OpenTransitionDialog(transition)"><i class="bi bi-arrow-right-circle"></i> @transition.ActionLabel</button>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="ew-next-action-empty">
                <i class="bi bi-info-circle"></i>
                <div><strong>No configured transition is available</strong><span>This workflow is either complete or its tenant endorsement configuration does not define a next step for the current status. Contact a tenant administrator if additional processing is expected.</span></div>
            </div>
        }
    </section>;

    private RenderFragment DetailPanel() => @<div>
