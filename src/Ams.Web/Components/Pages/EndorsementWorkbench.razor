@page "/policies/endorsements"
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.PolicyEndorsements
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs

<PageTitle>Enterprise Endorsements - AMS</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1">Enterprise Policy Endorsements</h1>
            <p class="text-secondary mb-0">Transactional policy changes, approvals, versions, accounting, and documents.</p>
        </div>
        @if (Can("ENDORSEMENT_CREATE"))
        {
            <button class="btn btn-primary" @onclick="OpenCreate">Create Endorsement</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-@_messageKind" role="alert">@_message</div>
    }

    @if (_loading)
    {
        <div class="text-center py-5"><span class="spinner-border"></span></div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-xl-5">
                <div class="card shadow-sm">
                    <div class="card-header d-flex gap-2">
                        <input class="form-control" @bind="_search" @bind:event="oninput" placeholder="Search endorsement, policy, account, status" />
                        <button class="btn btn-outline-secondary" @onclick="LoadAsync">Refresh</button>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var endorsement in FilteredEndorsements)
                        {
                            <button class="list-group-item list-group-item-action text-start @(endorsement.EndorsementId == _detail?.Endorsement.EndorsementId ? "active" : null)" @onclick="() => SelectAsync(endorsement.EndorsementId)">
                                <div class="d-flex justify-content-between"><strong>@endorsement.EndorsementNumber</strong><span class="badge text-bg-light">@endorsement.Status</span></div>
                                <div>@endorsement.PolicyNumber · @endorsement.AccountName</div>
                                <small>@endorsement.EndorsementType · @endorsement.EffectiveDate.ToString("d")</small>
                                @if (_canViewFinancial)
                                {
                                    <div class="mt-1"><strong>@endorsement.TotalCostDelta.ToString("C2")</strong></div>
                                }
                            </button>
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-7">
                @if (_detail is null)
                {
                    <div class="card shadow-sm"><div class="card-body py-5 text-center text-secondary">Select an endorsement to inspect its workflow.</div></div>
                }
                else
                {
                    @DetailPanel()
                }
            </div>
        </div>
    }
</div>

@if (_showWizard)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.45)">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div><h2 class="h5 mb-1">@(_editingId.HasValue ? "Edit Endorsement Draft" : "Create Endorsement")</h2><small>Step @_step of 7 · @StepTitle</small></div>
                    <button class="btn-close" @onclick="CloseWizard"></button>
                </div>
                <div class="modal-body">
                    <div class="progress mb-4"><div class="progress-bar" style="width:@(_step * 100 / 7)%"></div></div>
                    @WizardStep()
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseWizard">Close</button>
                    @if (_step > 1)
                    {
                        <button class="btn btn-outline-primary" @onclick="PreviousStep">Back</button>
                    }
                    @if (_step < 7)
                    {
                        <button class="btn btn-primary" @onclick="NextStep">Next</button>
                    }
                    else
                    {
                        <button class="btn btn-outline-primary" disabled="@_busy" @onclick="() => SaveWizardAsync(false)">Save Draft</button>
                        <button class="btn btn-primary" disabled="@_busy" @onclick="() => SaveWizardAsync(true)">Save and Submit</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "policyId")]
    public Guid? RequestedPolicyId { get; set; }

    private Guid _tenantId;
    private CurrentUserContextModel? _user;
    private bool _loading = true;
    private bool _busy;
    private bool _canViewFinancial;
    private string _search = string.Empty;
    private string? _message;
    private string _messageKind = "success";
    private PolicyEndorsementCenterDto _center = new();
    private PolicyEndorsementWorkflowDetailDto? _detail;
    private readonly List<PolicyRegisterDto> _policies = [];
    private bool _showWizard;
    private int _step = 1;
    private Guid? _editingId;
    private readonly WizardModel _wizard = new();

    private IEnumerable<PolicyEndorsementDto> FilteredEndorsements => _center.Endorsements.Where(x => string.IsNullOrWhiteSpace(_search) || string.Join(' ', x.EndorsementNumber, x.PolicyNumber, x.AccountName, x.Status, x.EndorsementType).Contains(_search, StringComparison.OrdinalIgnoreCase));
    private bool Can(string permission) => _user?.HasPermission(permission) == true || _user?.HasPermission("ENDORSEMENT_MANAGE") == true;
    private string StepTitle => _step switch { 1 => "Type", 2 => "Effective Date", 3 => "Reason", 4 => "Modify Policy", 5 => "Compare", 6 => "Premium Impact", _ => "Submit" };

    protected override async Task OnInitializedAsync()
    {
        _user = await CurrentUser.RequireAsync();
        _tenantId = _user.TenantId;
        _canViewFinancial = Can("ENDORSEMENT_FINANCIAL_VIEW");
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policies", "/policies"), new("Endorsements", "/policies/endorsements"));
        await LoadAsync();
        if (RequestedPolicyId.HasValue && RequestedPolicyId != Guid.Empty && Can("ENDORSEMENT_CREATE"))
        {
            OpenCreate();
            _wizard.PolicyId = RequestedPolicyId.Value;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _center = await Api.GetPolicyEndorsementCenterAsync(_tenantId) ?? new();
            var policies = await Api.SearchPolicyRegisterAsync(_tenantId, pageSize: 500);
            _policies.Clear();
            _policies.AddRange(policies?.Items ?? []);
            if (_detail is not null) await SelectAsync(_detail.Endorsement.EndorsementId);
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _loading = false; }
    }

    private async Task SelectAsync(Guid endorsementId)
    {
        try { _detail = await Api.GetPolicyEndorsementWorkflowDetailAsync(_tenantId, endorsementId); }
        catch (Exception ex) { ShowError(ex.Message); }
    }

    private RenderFragment DetailPanel() => @<div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><strong>@_detail!.Endorsement.EndorsementNumber</strong><div class="small text-secondary">@_detail.Endorsement.Description</div></div>
            <span class="badge text-bg-primary">@_detail.Endorsement.Status</span>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-4"><small class="text-secondary">Policy</small><div>@_detail.Endorsement.PolicyNumber</div></div>
                <div class="col-md-4"><small class="text-secondary">Effective</small><div>@_detail.Endorsement.EffectiveDate.ToString("d")</div></div>
                <div class="col-md-4"><small class="text-secondary">Version</small><div>@(_detail.Endorsement.PolicyVersionAfterId?.ToString() ?? "Not activated")</div></div>
            </div>
            @if (_canViewFinancial)
            {
                <div class="alert alert-light border">Premium @_detail.FinancialImpact.PremiumChange.ToString("C2") · Fees @_detail.FinancialImpact.AgencyFee.ToString("C2") · Taxes @_detail.FinancialImpact.Taxes.ToString("C2") · <strong>Total @_detail.FinancialImpact.TotalDue.ToString("C2")</strong></div>
            }
            <h3 class="h6">Before / After Changes</h3>
            <div class="table-responsive mb-3"><table class="table table-sm"><thead><tr><th>Category</th><th>Operation</th><th>Summary</th></tr></thead><tbody>@foreach (var change in _detail.Changes){<tr><td>@change.CategoryCode</td><td>@change.OperationCode</td><td>@change.Summary</td></tr>}</tbody></table></div>
            <div class="d-flex flex-wrap gap-2 mb-4">
                @if ((_detail.Endorsement.Status is "Draft" or "NeedMoreInfo") && Can("ENDORSEMENT_EDIT_DRAFT")) { <button class="btn btn-outline-primary btn-sm" @onclick="OpenEdit">Edit Draft</button> }
                @foreach (var transition in _detail.AvailableTransitions)
                {
                    if (Can(transition.RequiredPermissionCode ?? "ENDORSEMENT_MANAGE")) { <button class="btn btn-primary btn-sm" @onclick="() => TransitionAsync(transition.ToStatusCode)">@transition.ToStatusCode</button> }
                }
                @if (_detail.Endorsement.Status == "Completed" && Can("ENDORSEMENT_REVERSE")) { <button class="btn btn-outline-danger btn-sm" @onclick="ReverseAsync">Reverse</button> }
            </div>
            @if (_detail.Approvals.Count > 0)
            {
                <h3 class="h6">Approvals</h3>
                @foreach (var approval in _detail.Approvals)
                {
                    <div class="border rounded p-2 mb-2 d-flex justify-content-between">
                        <span>@approval.ApprovalLevelCode · @approval.StatusCode</span>
                        @if (approval.StatusCode == "Pending" && Can("ENDORSEMENT_APPROVE"))
                        {
                            <span><button class="btn btn-success btn-sm me-1" @onclick='() => DecideAsync(approval, "Approved")'>Approve</button><button class="btn btn-danger btn-sm" @onclick='() => DecideAsync(approval, "Rejected")'>Reject</button></span>
                        }
                    </div>
                }
            }
            <div class="row g-3">
                <div class="col-lg-6"><h3 class="h6">Timeline</h3>@foreach (var item in _detail.Timeline.Take(12)){<div class="border-start ps-2 mb-2"><strong>@item.EventTypeCode</strong><div>@item.Description</div><small>@item.OccurredDateUtc.ToLocalTime()</small></div>}</div>
                <div class="col-lg-6"><h3 class="h6">Automation</h3><div>Carrier: @QueueSummary(_detail.CarrierDispatches.Select(x => x.StatusCode))</div><div>Accounting: @QueueSummary(_detail.AccountingWork.Select(x => x.StatusCode))</div><div>Documents: @QueueSummary(_detail.DocumentWork.Select(x => x.StatusCode))</div><h3 class="h6 mt-3">Versions</h3>@foreach (var version in _detail.Versions){<div>Version @version.VersionNumber · @version.VersionReasonCode · @version.CreatedDateUtc.ToLocalTime()</div>}</div>
            </div>
        </div>
    </div>;

    private RenderFragment WizardStep() => _step switch
    {
        1 => @<div class="row g-3"><div class="col-md-6"><label class="form-label">Policy</label><select class="form-select" @bind="_wizard.PolicyId"><option value="@Guid.Empty">Select policy</option>@foreach(var policy in _policies){<option value="@policy.PolicyId">@policy.PolicyNumber · @policy.AccountName</option>}</select></div><div class="col-md-3"><label class="form-label">Category</label><select class="form-select" @bind="_wizard.Category"><option>Insured</option><option>Vehicle</option><option>Driver</option><option>Coverage</option><option>Property</option><option>Commercial</option><option>Financial</option><option>Legal</option></select></div><div class="col-md-3"><label class="form-label">Endorsement Type</label><input class="form-control" @bind="_wizard.EndorsementType" /></div></div>,
        2 => @<div><label class="form-label">Effective Date</label><input type="date" class="form-control" @bind="_wizard.EffectiveDate" /><div class="form-text">Backdated dates require ENDORSEMENT_BACKDATE.</div></div>,
        3 => @<div class="row g-3"><div class="col-md-4"><label class="form-label">Reason</label><select class="form-select" @bind="_wizard.Reason"><option>CustomerRequest</option><option>CarrierRequirement</option><option>Correction</option><option>Audit</option><option>AgencyError</option><option>Other</option></select></div><div class="col-md-8"><label class="form-label">Description</label><textarea class="form-control" @bind="_wizard.Description"></textarea></div></div>,
        4 => ChangeEditor(),
        5 => CompareView(),
        6 => @<div class="row g-3"><div class="col-md-3"><label class="form-label">Premium</label><input type="number" step=".01" class="form-control" @bind="_wizard.Premium" /></div><div class="col-md-3"><label class="form-label">Agency Fee</label><input type="number" step=".01" class="form-control" @bind="_wizard.Fee" /></div><div class="col-md-3"><label class="form-label">Taxes</label><input type="number" step=".01" class="form-control" @bind="_wizard.Taxes" /></div><div class="col-md-3"><label class="form-label">Total Due</label><input class="form-control" value="@(_wizard.Premium + _wizard.Fee + _wizard.Taxes).ToString("C2")" disabled /></div></div>,
        _ => @<div><h3 class="h6">Ready to submit</h3><p>@_wizard.Description</p><ul><li>@_wizard.Category · @_wizard.Operation</li><li>Effective @_wizard.EffectiveDate.ToString("d")</li><li>Total impact @(_wizard.Premium + _wizard.Fee + _wizard.Taxes).ToString("C2")</li></ul><p>Save as a draft or submit immediately for internal review.</p></div>
    };

    private RenderFragment ChangeEditor() => @<div>
        <div class="row g-3 mb-3"><div class="col-md-3"><label class="form-label">Operation</label><select class="form-select" @bind="_wizard.Operation"><option>Add</option><option>Update</option><option>Remove</option><option>Replace</option></select></div><div class="col-md-4"><label class="form-label">Entity Key</label><input class="form-control" @bind="_wizard.EntityKey" /></div><div class="col-md-5"><label class="form-label">Summary</label><input class="form-control" @bind="_wizard.Summary" /></div></div>
        <div class="table-responsive"><table class="table"><thead><tr><th>Field</th><th>Before</th><th>After</th></tr></thead><tbody>
            <tr><td>@FieldLabel(1)</td><td><input class="form-control" @bind="_wizard.Before1" /></td><td><input class="form-control" @bind="_wizard.After1" /></td></tr>
            <tr><td>@FieldLabel(2)</td><td><input class="form-control" @bind="_wizard.Before2" /></td><td><input class="form-control" @bind="_wizard.After2" /></td></tr>
            <tr><td>@FieldLabel(3)</td><td><input class="form-control" @bind="_wizard.Before3" /></td><td><input class="form-control" @bind="_wizard.After3" /></td></tr>
            <tr><td>@FieldLabel(4)</td><td><input type="number" step=".01" class="form-control" @bind="_wizard.BeforeAmount1" /></td><td><input type="number" step=".01" class="form-control" @bind="_wizard.AfterAmount1" /></td></tr>
            <tr><td>@FieldLabel(5)</td><td><input type="number" step=".01" class="form-control" @bind="_wizard.BeforeAmount2" /></td><td><input type="number" step=".01" class="form-control" @bind="_wizard.AfterAmount2" /></td></tr>
        </tbody></table></div>
    </div>;

    private RenderFragment CompareView() => @<div><h3 class="h6">Before / After Comparison</h3><table class="table"><thead><tr><th>Field</th><th>Before</th><th>After</th></tr></thead><tbody>@foreach(var row in CompareRows){<tr><td>@row.Label</td><td>@row.Before</td><td class="fw-semibold">@row.After</td></tr>}</tbody></table></div>;

    private IEnumerable<(string Label,string Before,string After)> CompareRows => new[] { (FieldLabel(1),_wizard.Before1,_wizard.After1),(FieldLabel(2),_wizard.Before2,_wizard.After2),(FieldLabel(3),_wizard.Before3,_wizard.After3),(FieldLabel(4),_wizard.BeforeAmount1?.ToString() ?? "",_wizard.AfterAmount1?.ToString() ?? ""),(FieldLabel(5),_wizard.BeforeAmount2?.ToString() ?? "",_wizard.AfterAmount2?.ToString() ?? "") }.Where(x => !string.IsNullOrWhiteSpace(x.Item2) || !string.IsNullOrWhiteSpace(x.Item3));

    private string FieldLabel(int field) => (_wizard.Category, field) switch { ("Insured",1)=>"Name",("Insured",2)=>"DBA",("Insured",3)=>"Mailing Address",("Vehicle",1)=>"VIN",("Vehicle",2)=>"Make / Model",("Vehicle",3)=>"Usage / Garaging",("Driver",1)=>"Driver Name",("Driver",2)=>"License Number",("Driver",3)=>"License State",("Coverage",1)=>"Coverage Name",("Coverage",2)=>"Limit Description",("Coverage",3)=>"Coverage Code",("Coverage",4)=>"Limit",("Coverage",5)=>"Deductible",("Property",1)=>"Location",("Property",2)=>"Occupancy",("Property",3)=>"Construction",("Property",4)=>"Square Feet",("Property",5)=>"Building Value",("Commercial",1)=>"Classification",("Commercial",2)=>"Equipment Schedule",("Commercial",3)=>"Locations",("Commercial",4)=>"Payroll",("Commercial",5)=>"Revenue",("Financial",1)=>"Billing Plan",("Financial",2)=>"Financing Provider",("Financial",3)=>"Installments",("Financial",4)=>"Commission Rate",("Financial",5)=>"Financed Amount",("Legal",1)=>"Party Name",("Legal",2)=>"Relationship",("Legal",3)=>"Address",_=>$"Field {field}" };

    private void OpenCreate() { _wizard.Reset(); _editingId = null; _step = 1; _showWizard = true; }
    private void OpenEdit() { if (_detail is null) return; _editingId = _detail.Endorsement.EndorsementId; _wizard.PolicyId = _detail.Endorsement.PolicyId ?? Guid.Empty; _wizard.EndorsementType = _detail.Endorsement.EndorsementType; _wizard.EffectiveDate = _detail.Endorsement.EffectiveDate; _wizard.Reason = _detail.Endorsement.ReasonCode ?? "Other"; _wizard.Description = _detail.Endorsement.Description; _wizard.Premium = _detail.Endorsement.PremiumDelta; _wizard.Fee = _detail.Endorsement.AgencyFeeDelta; _wizard.Taxes = _detail.Endorsement.TaxDelta; if (_detail.Changes.FirstOrDefault() is { } change) LoadChange(change); _step = 1; _showWizard = true; }
    private void CloseWizard() => _showWizard = false;
    private void NextStep() { if (ValidateStep()) _step++; }
    private void PreviousStep() => _step--;
    private bool ValidateStep() { if (_step == 1 && (_wizard.PolicyId == Guid.Empty || string.IsNullOrWhiteSpace(_wizard.EndorsementType))) { ShowError("Select a policy and endorsement type."); return false; } if (_step == 3 && string.IsNullOrWhiteSpace(_wizard.Description)) { ShowError("Enter a reason and description."); return false; } if (_step == 4 && string.IsNullOrWhiteSpace(_wizard.Summary)) { ShowError("Describe the typed policy change."); return false; } return true; }

    private async Task SaveWizardAsync(bool submit)
    {
        if (_user is null) return;
        _busy = true;
        try
        {
            Guid id;
            if (_editingId.HasValue && _detail is not null)
            {
                await Api.SavePolicyEndorsementDraftAsync(_editingId.Value, new SavePolicyEndorsementDraftRequest { TenantId=_tenantId,EndorsementTypeCode=_wizard.EndorsementType,ReasonCode=_wizard.Reason,EffectiveDate=_wizard.EffectiveDate,Description=_wizard.Description,PriorityCode="Normal",FinancialImpact=Financial(),Changes=[BuildChange()],RowVersion=_detail.Endorsement.RowVersion });
                id = _editingId.Value;
            }
            else
            {
                id = await Api.CreatePolicyEndorsementTransactionAsync(new CreatePolicyEndorsementTransactionRequest { TenantId=_tenantId,PolicyId=_wizard.PolicyId,EndorsementTypeCode=_wizard.EndorsementType,ReasonCode=_wizard.Reason,EffectiveDate=_wizard.EffectiveDate,Description=_wizard.Description,PriorityCode="Normal",CarrierMethodCode="Manual",FinancialImpact=Financial(),Changes=[BuildChange()] });
            }
            if (submit)
            {
                var detail = await Api.GetPolicyEndorsementWorkflowDetailAsync(_tenantId,id) ?? throw new InvalidOperationException("Created endorsement could not be loaded.");
                await Api.TransitionPolicyEndorsementAsync(id,new TransitionPolicyEndorsementRequest { TenantId=_tenantId,ToStatusCode="PendingReview",RowVersion=detail.Endorsement.RowVersion });
            }
            _showWizard=false; ShowSuccess(submit ? "Endorsement submitted for review." : "Endorsement draft saved."); await LoadAsync(); await SelectAsync(id);
        }
        catch(Exception ex){ShowError(ex.Message);} finally{_busy=false;}
    }

    private PolicyEndorsementFinancialImpactInput Financial() => new(){CurrencyCode="USD",PremiumChange=_wizard.Premium,AgencyFee=_wizard.Fee,Taxes=_wizard.Taxes,ProratedPremiumChange=_wizard.Premium,BillingImpactCode=_wizard.Premium+_wizard.Fee+_wizard.Taxes==0?"NoBillingImpact":"BillInstallment",CommissionImpactCode=_wizard.Premium==0?"NoCommissionImpact":"RecalculateCommission"};
    private PolicyEndorsementChangeInput BuildChange() { var change=new PolicyEndorsementChangeInput{CategoryCode=_wizard.Category,OperationCode=_wizard.Operation,EntityKey=string.IsNullOrWhiteSpace(_wizard.EntityKey)?Guid.NewGuid().ToString("N"):_wizard.EntityKey,Summary=_wizard.Summary}; switch(_wizard.Category){case "Insured":change.Insured=new(){BeforeName=_wizard.Before1,AfterName=_wizard.After1,BeforeDba=_wizard.Before2,AfterDba=_wizard.After2,BeforeMailingAddress=_wizard.Before3,AfterMailingAddress=_wizard.After3};break;case "Vehicle":change.Vehicle=new(){BeforeVin=_wizard.Before1,AfterVin=_wizard.After1,BeforeMake=_wizard.Before2,AfterMake=_wizard.After2,BeforeUsageCode=_wizard.Before3,AfterUsageCode=_wizard.After3};break;case "Driver":change.Driver=new(){BeforeName=_wizard.Before1,AfterName=_wizard.After1,BeforeLicenseNumber=_wizard.Before2,AfterLicenseNumber=_wizard.After2,BeforeLicenseState=_wizard.Before3,AfterLicenseState=_wizard.After3};break;case "Coverage":change.Coverage=new(){CoverageCode=_wizard.After3??_wizard.Before3,BeforeCoverageName=_wizard.Before1,AfterCoverageName=_wizard.After1,BeforeLimitDescription=_wizard.Before2,AfterLimitDescription=_wizard.After2,BeforeLimitAmount=_wizard.BeforeAmount1,AfterLimitAmount=_wizard.AfterAmount1,BeforeDeductibleAmount=_wizard.BeforeAmount2,AfterDeductibleAmount=_wizard.AfterAmount2};break;case "Property":change.Property=new(){BeforeLocationAddress=_wizard.Before1,AfterLocationAddress=_wizard.After1,BeforeOccupancyCode=_wizard.Before2,AfterOccupancyCode=_wizard.After2,BeforeConstructionCode=_wizard.Before3,AfterConstructionCode=_wizard.After3,BeforeSquareFeet=(int?)_wizard.BeforeAmount1,AfterSquareFeet=(int?)_wizard.AfterAmount1,BeforeBuildingValue=_wizard.BeforeAmount2,AfterBuildingValue=_wizard.AfterAmount2};break;case "Commercial":change.Commercial=new(){ClassificationCode=_wizard.After1??_wizard.Before1,BeforePayrollAmount=_wizard.BeforeAmount1,AfterPayrollAmount=_wizard.AfterAmount1,BeforeRevenueAmount=_wizard.BeforeAmount2,AfterRevenueAmount=_wizard.AfterAmount2};break;case "Financial":change.Financial=new(){BeforeBillingPlanCode=_wizard.Before1,AfterBillingPlanCode=_wizard.After1,BeforeFinancingProvider=_wizard.Before2,AfterFinancingProvider=_wizard.After2,BeforeInstallmentCount=int.TryParse(_wizard.Before3,out var bi)?bi:null,AfterInstallmentCount=int.TryParse(_wizard.After3,out var ai)?ai:null,BeforeCommissionRate=_wizard.BeforeAmount1,AfterCommissionRate=_wizard.AfterAmount1,BeforeFinancedAmount=_wizard.BeforeAmount2,AfterFinancedAmount=_wizard.AfterAmount2};break;default:change.Legal=new(){PartyTypeCode=_wizard.EndorsementType,BeforePartyName=_wizard.Before1,AfterPartyName=_wizard.After1,BeforeRelationshipCode=_wizard.Before2,AfterRelationshipCode=_wizard.After2,BeforeAddress=_wizard.Before3,AfterAddress=_wizard.After3};break;} return change; }
    private void LoadChange(PolicyEndorsementChangeDto change){_wizard.Category=change.CategoryCode;_wizard.Operation=change.OperationCode;_wizard.EntityKey=change.EntityKey??"";_wizard.Summary=change.Summary??"";if(change.Insured is{} i){_wizard.Before1=i.BeforeName;_wizard.After1=i.AfterName;_wizard.Before2=i.BeforeDba;_wizard.After2=i.AfterDba;_wizard.Before3=i.BeforeMailingAddress;_wizard.After3=i.AfterMailingAddress;}else if(change.Vehicle is{} v){_wizard.Before1=v.BeforeVin;_wizard.After1=v.AfterVin;_wizard.Before2=v.BeforeMake;_wizard.After2=v.AfterMake;_wizard.Before3=v.BeforeUsageCode;_wizard.After3=v.AfterUsageCode;}else if(change.Driver is{} d){_wizard.Before1=d.BeforeName;_wizard.After1=d.AfterName;_wizard.Before2=d.BeforeLicenseNumber;_wizard.After2=d.AfterLicenseNumber;_wizard.Before3=d.BeforeLicenseState;_wizard.After3=d.AfterLicenseState;}else if(change.Coverage is{} c){_wizard.Before1=c.BeforeCoverageName;_wizard.After1=c.AfterCoverageName;_wizard.Before2=c.BeforeLimitDescription;_wizard.After2=c.AfterLimitDescription;_wizard.Before3=c.CoverageCode;_wizard.After3=c.CoverageCode;_wizard.BeforeAmount1=c.BeforeLimitAmount;_wizard.AfterAmount1=c.AfterLimitAmount;_wizard.BeforeAmount2=c.BeforeDeductibleAmount;_wizard.AfterAmount2=c.AfterDeductibleAmount;}}

    private async Task TransitionAsync(string status){if(_detail is null)return;try{await Api.TransitionPolicyEndorsementAsync(_detail.Endorsement.EndorsementId,new(){TenantId=_tenantId,ToStatusCode=status,RowVersion=_detail.Endorsement.RowVersion});await LoadAsync();ShowSuccess($"Endorsement moved to {status}.");}catch(Exception ex){ShowError(ex.Message);}}
    private async Task DecideAsync(PolicyEndorsementApprovalDto approval,string decision){if(_detail is null)return;try{await Api.DecidePolicyEndorsementApprovalAsync(_detail.Endorsement.EndorsementId,approval.ApprovalId,new(){TenantId=_tenantId,DecisionCode=decision,EndorsementRowVersion=_detail.Endorsement.RowVersion,ApprovalRowVersion=approval.RowVersion});await SelectAsync(_detail.Endorsement.EndorsementId);ShowSuccess($"Approval {decision.ToLowerInvariant()}.");}catch(Exception ex){ShowError(ex.Message);}}
    private async Task ReverseAsync(){if(_detail is null)return;try{var id=await Api.ReversePolicyEndorsementAsync(_detail.Endorsement.EndorsementId,new(){TenantId=_tenantId,EffectiveDate=DateTime.Today,Reason="Compensating reversal requested from endorsement workbench.",RowVersion=_detail.Endorsement.RowVersion});await LoadAsync();await SelectAsync(id);ShowSuccess("Reversal draft created.");}catch(Exception ex){ShowError(ex.Message);}}
    private static string QueueSummary(IEnumerable<string> statuses){var values=statuses.ToList();return values.Count==0?"Not queued":string.Join(", ",values.GroupBy(x=>x).Select(x=>$"{x.Key} ({x.Count()})"));}
    private void ShowError(string message){_message=message;_messageKind="danger";}
    private void ShowSuccess(string message){_message=message;_messageKind="success";}

