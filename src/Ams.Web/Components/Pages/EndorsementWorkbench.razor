        [Required, StringLength(100)] public string LineOfBusiness { get; set; } = string.Empty;
        [Required, StringLength(160)] public string Carrier { get; set; } = string.Empty;
        [Required, StringLength(120)] public string EndorsementType { get; set; } = string.Empty;
        [Required, StringLength(1000)] public string Description { get; set; } = string.Empty;
        [Required] public DateTime EffectiveDate { get; set; } = DateTime.Today;
        [Range(-10000000, 10000000)] public decimal PremiumDelta { get; set; }
        [Required, StringLength(40)] public string Priority { get; set; } = "Normal";
        [Required, StringLength(160)] public string RequestedByName { get; set; } = "Current User";
        [Required, StringLength(160)] public string AssignedToName { get; set; } = string.Empty;
        [StringLength(160)] public string? UnderwriterName { get; set; }
        [StringLength(1000)] public string? Reason { get; set; }
        [StringLength(1000)] public string? RequiredDocuments { get; set; }
        public DateTime? DueDate { get; set; }
        public bool IsUrgent { get; set; }

        public static EndorsementForm From(PolicyEndorsementDto row) => new()
        {
            EndorsementId = row.EndorsementId,
            PolicyId = row.PolicyId,
