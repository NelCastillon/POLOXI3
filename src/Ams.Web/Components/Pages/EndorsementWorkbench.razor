    private async Task OpenCreateAsync() { _wizard.Reset(); _editingId = null; _availableTypes = _catalog.Types; _policySearchText = string.Empty; _policyDropdownOpen = false; ApplyOptionDefaults(); _step = 1; _showWizard = true; await Task.CompletedTask; }
    private async Task OpenEditAsync() { if (_detail is null) return; _editingId = _detail.Endorsement.EndorsementId; _wizard.PolicyId = _detail.Endorsement.PolicyId ?? Guid.Empty; SyncPolicySearchText(); await PolicyChangedAsync(); _wizard.EndorsementType = _detail.Endorsement.EndorsementType; TypeChanged(); _wizard.EffectiveDate = _detail.Endorsement.EffectiveDate; _wizard.Reason = _detail.Endorsement.ReasonCode ?? DefaultOption("Reason"); _wizard.Description = _detail.Endorsement.Description; _wizard.Priority = _detail.Endorsement.Priority; _wizard.CarrierMethod = _detail.Endorsement.CarrierMethodCode ?? _wizard.CarrierMethod; _wizard.Premium = _detail.Endorsement.PremiumDelta; _wizard.Fee = _detail.Endorsement.AgencyFeeDelta; _wizard.Taxes = _detail.Endorsement.TaxDelta; if (_detail.Changes.FirstOrDefault() is { } change) LoadChange(change); _step = 1; _showWizard = true; }
    private void CloseWizard() { _showWizard = false; _policyDropdownOpen = false; }
    private void OpenPolicyDropdown() => _policyDropdownOpen = true;
    private void TogglePolicyDropdown() => _policyDropdownOpen = !_policyDropdownOpen;
    private void OnPolicySearchChanged(ChangeEventArgs args) { _policySearchText = args.Value?.ToString() ?? string.Empty; _wizard.PolicyId = Guid.Empty; _wizard.EndorsementType = string.Empty; _availableTypes = []; _policyDropdownOpen = true; }
    private async Task SelectPolicyAsync(PolicyRegisterDto policy) { _wizard.PolicyId = policy.PolicyId; _policySearchText = PolicyDisplayText(policy); _policyDropdownOpen = false; await PolicyChangedAsync(); }
    private async Task ClosePolicyDropdownAsync() { await Task.Delay(120); _policyDropdownOpen = false; }
    private void SyncPolicySearchText() { var policy = _policies.FirstOrDefault(x => x.PolicyId == _wizard.PolicyId); _policySearchText = policy is null ? string.Empty : PolicyDisplayText(policy); }
    private static string PolicyDisplayText(PolicyRegisterDto policy) => $"{policy.PolicyNumber} · {policy.AccountName}";
    private void NextStep() { if (ValidateStep()) _step++; }
    private void PreviousStep() => _step--;
    private bool ValidateStep() { if (_step == 1 && (_wizard.PolicyId == Guid.Empty || string.IsNullOrWhiteSpace(_wizard.EndorsementType))) { ShowError("Select a policy and endorsement type."); return false; } if (_step == 3 && string.IsNullOrWhiteSpace(_wizard.Description)) { ShowError("Enter a reason and description."); return false; } if (_step == 4 && string.IsNullOrWhiteSpace(_wizard.Summary)) { ShowError("Describe the typed policy change."); return false; } return true; }

    private async Task SaveWizardAsync(bool submit)
    {
        if (_user is null) return;
        if (!ValidateWizard()) return;
        _busy = true;
        try
        {
            Guid id;
            if (_editingId.HasValue && _detail is not null)
            {
                await Api.SavePolicyEndorsementDraftAsync(_editingId.Value, new SavePolicyEndorsementDraftRequest { TenantId=_tenantId,EndorsementTypeCode=_wizard.EndorsementType,ReasonCode=_wizard.Reason,EffectiveDate=_wizard.EffectiveDate,Description=_wizard.Description,PriorityCode=_wizard.Priority,CarrierMethodCode=_wizard.CarrierMethod,FinancialImpact=Financial(),Changes=[BuildChange()],RowVersion=_detail.Endorsement.RowVersion });
                id = _editingId.Value;
            }
            else
            {
                id = await Api.CreatePolicyEndorsementTransactionAsync(new CreatePolicyEndorsementTransactionRequest { TenantId=_tenantId,PolicyId=_wizard.PolicyId,EndorsementTypeCode=_wizard.EndorsementType,ReasonCode=_wizard.Reason,EffectiveDate=_wizard.EffectiveDate,Description=_wizard.Description,PriorityCode=_wizard.Priority,CarrierMethodCode=_wizard.CarrierMethod,FinancialImpact=Financial(),Changes=[BuildChange()] });
            }
            if (submit)
            {
                var detail = await Api.GetPolicyEndorsementWorkflowDetailAsync(_tenantId,id) ?? throw new InvalidOperationException("Created endorsement could not be loaded.");
                var transition = detail.AvailableTransitions.SingleOrDefault() ?? throw new InvalidOperationException(detail.AvailableTransitions.Count == 0 ? "No configured submission transition is available for this endorsement type." : "Multiple workflow actions are available. Save the draft and select the intended action from Next action.");
                await Api.TransitionPolicyEndorsementAsync(id,new TransitionPolicyEndorsementRequest { TenantId=_tenantId,ToStatusCode=transition.ToStatusCode,RowVersion=detail.Endorsement.RowVersion });
            }
            _showWizard=false; ShowSuccess(submit ? "Endorsement submitted for review." : "Endorsement draft saved."); await LoadAsync(); await SelectAsync(id);
        }
        catch(Exception ex){ShowError(ex.Message);} finally{_busy=false;}
    }

    private PolicyEndorsementFinancialImpactInput Financial() => new(){CurrencyCode=_currencyCode,PremiumChange=_wizard.Premium,AgencyFee=_wizard.Fee,Taxes=_wizard.Taxes,ProratedPremiumChange=_wizard.Premium,BillingImpactCode=_wizard.BillingImpact,CommissionImpactCode=_wizard.CommissionImpact};
    private bool ValidateWizard()
    {
        if (_wizard.PolicyId == Guid.Empty || string.IsNullOrWhiteSpace(_wizard.EndorsementType)) { ShowError("Select a policy and endorsement type."); return false; }
        if (_wizard.EffectiveDate == default) { ShowError("Enter an effective date."); return false; }
        if (string.IsNullOrWhiteSpace(_wizard.Reason) || string.IsNullOrWhiteSpace(_wizard.Description)) { ShowError("Select a reason and enter a description."); return false; }
        if (string.IsNullOrWhiteSpace(_wizard.Category) || string.IsNullOrWhiteSpace(_wizard.Operation) || string.IsNullOrWhiteSpace(_wizard.Summary)) { ShowError("Complete the typed policy change."); return false; }
        if (string.IsNullOrWhiteSpace(_wizard.Priority) || string.IsNullOrWhiteSpace(_wizard.BillingImpact) || string.IsNullOrWhiteSpace(_wizard.CommissionImpact)) { ShowError("The tenant endorsement options are incomplete. Contact an administrator."); return false; }
        if (string.IsNullOrWhiteSpace(_currencyCode)) { ShowError("The agency currency is not configured."); return false; }
        return true;
    }
