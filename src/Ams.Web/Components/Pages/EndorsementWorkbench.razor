@page "/policies/endorsements"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.PolicyEndorsements
@using Microsoft.AspNetCore.Components.Rendering
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Policy Endorsements — AMS</PageTitle>

@if (_toastVisible)
{
    <div class="ew-toast ew-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="ew-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="mt-modal ew-action-modal" role="dialog" aria-modal="true" aria-labelledby="ew-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-pen-fill" aria-hidden="true"></i>
                <span id="ew-form-title">@(_form.EndorsementId == Guid.Empty ? "New Endorsement" : $"Edit {_form.EndorsementNumber}")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_actionBusy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveEndorsementAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="ew-modal-intro">
                        <span class="ew-modal-chip"><i class="bi bi-shield-check" aria-hidden="true"></i> Policy servicing workflow</span>
                        <p>Create and maintain policy endorsement requests used by underwriting, service, documents, billing, and issuance workflows.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full ew-dlg-section">Policy & Account</div>
                        <div class="um-field">
                            <label>Policy Number <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.PolicyNumber" />
                            <ValidationMessage For="() => _form.PolicyNumber" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Account <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.AccountName" />
                            <ValidationMessage For="() => _form.AccountName" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Line of Business <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.LineOfBusiness">
                                <option value="">Select LOB</option>
                                @foreach (var lob in LinesOfBusiness)
                                {
                                    <option value="@lob">@lob</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.LineOfBusiness" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Carrier <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.Carrier">
                                <option value="">Select carrier</option>
                                @foreach (var carrier in Carriers)
                                {
                                    <option value="@carrier">@carrier</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.Carrier" class="text-danger" />
                        </div>

                        <div class="um-field um-field--full ew-dlg-section">Endorsement Detail</div>
                        <div class="um-field">
                            <label>Type <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.EndorsementType">
                                <option value="">Select type</option>
                                @foreach (var type in EndorsementTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.EndorsementType" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Effective Date <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="_form.EffectiveDate" />
                            <ValidationMessage For="() => _form.EffectiveDate" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Premium Delta</label>
                            <InputNumber class="form-control" @bind-Value="_form.PremiumDelta" />
                            <ValidationMessage For="() => _form.PremiumDelta" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Priority</label>
                            <InputSelect class="form-select" @bind-Value="_form.Priority">
                                @foreach (var priority in Priorities)
                                {
                                    <option value="@priority">@priority</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.Priority" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Assigned To <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_form.AssignedToName" />
                            <ValidationMessage For="() => _form.AssignedToName" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Underwriter</label>
                            <InputText class="form-control" @bind-Value="_form.UnderwriterName" />
                            <ValidationMessage For="() => _form.UnderwriterName" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Due Date</label>
                            <InputDate class="form-control" @bind-Value="_form.DueDate" />
                            <ValidationMessage For="() => _form.DueDate" class="text-danger" />
                        </div>
                        <div class="um-field ew-check-field">
                            <label class="ew-check-label"><InputCheckbox @bind-Value="_form.IsUrgent" /> Urgent workflow</label>
                        </div>
                        <div class="um-field um-field--full">
                            <label>Description <span class="text-danger">*</span></label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_form.Description" />
                            <ValidationMessage For="() => _form.Description" class="text-danger" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Reason</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.Reason" />
                            <ValidationMessage For="() => _form.Reason" class="text-danger" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Required Documents</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.RequiredDocuments" />
                            <ValidationMessage For="() => _form.RequiredDocuments" class="text-danger" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        Save Endorsement
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showActionDialog)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseActionDialog">
        <div class="mt-modal ew-action-modal" role="dialog" aria-modal="true" aria-labelledby="ew-action-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi @_actionIcon" aria-hidden="true"></i>
                <span id="ew-action-title">@_actionTitle</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseActionDialog" disabled="@_actionBusy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_actionForm" OnValidSubmit="ConfirmActionAsync" OnInvalidSubmit="NotifyActionValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="ew-modal-intro">
                        <span class="ew-modal-chip"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Workflow action</span>
                        <p>@_actionHelpText</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Endorsement</label>
                            <input class="form-control ew-readonly-input" value="@_selected.EndorsementNumber - @_selected.AccountName" disabled />
                        </div>
                        @if (_pendingAction == "Add Delta")
                        {
                            <div class="um-field">
                                <label>Field <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_actionForm.FieldName" />
                                <ValidationMessage For="() => _actionForm.FieldName" class="text-danger" />
                            </div>
                            <div class="um-field">
                                <label>Premium / Numeric Delta</label>
                                <InputNumber class="form-control" @bind-Value="_actionForm.NumericDelta" />
                                <ValidationMessage For="() => _actionForm.NumericDelta" class="text-danger" />
                            </div>
                            <div class="um-field">
                                <label>Before</label>
                                <InputText class="form-control" @bind-Value="_actionForm.BeforeValue" />
                            </div>
                            <div class="um-field">
                                <label>After</label>
                                <InputText class="form-control" @bind-Value="_actionForm.AfterValue" />
                            </div>
                        }
                        <div class="um-field um-field--full">
                            <label>
                                Notes
                                @if (_pendingAction is "Decline" or "Request Info" or "Add Note")
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_actionForm.Notes" />
                            <ValidationMessage For="() => _actionForm.Notes" class="text-danger" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseActionDialog" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="um-btn @(_pendingAction == "Decline" || _pendingAction == "Archive" ? "um-btn-danger" : "um-btn-primary")" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @_actionButtonText
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_drawerRow is not null)
{
    <div class="ew-drawer-backdrop" @onclick="CloseDrawer"></div>
    <aside class="ew-drawer" aria-label="Endorsement details">
        <div class="ew-drawer-head">
            <div>
                <h2 class="ew-drawer-title">@_drawerRow.EndorsementNumber</h2>
                <span class="ew-drawer-sub">@_drawerRow.PolicyNumber · @_drawerRow.AccountName</span>
            </div>
            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="CloseDrawer"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <div class="ew-drawer-body">
            <div class="ew-drawer-banner @(_drawerRow.IsUrgent ? "ew-drawer-banner--urgent" : null)">
                <i class="bi @(_drawerRow.IsUrgent ? "bi-exclamation-triangle-fill" : "bi-info-circle")" aria-hidden="true"></i>
                <span>@_drawerRow.WorkflowStage</span>
                <strong>@_drawerRow.Priority</strong>
            </div>
            <div class="ew-drawer-meta">
                @DrawerField("Type", _drawerRow.EndorsementType)
                @DrawerField("Status", _drawerRow.Status)
                @DrawerField("LOB", _drawerRow.LineOfBusiness)
                @DrawerField("Carrier", _drawerRow.Carrier)
                @DrawerField("Effective", _drawerRow.EffectiveDate.ToString("MM/dd/yyyy"))
                @DrawerField("Premium Delta", _drawerRow.PremiumDelta.ToString("+$#,##0;-$#,##0;$0"))
                @DrawerField("Requested By", _drawerRow.RequestedByName)
                @DrawerField("Assigned To", _drawerRow.AssignedToName)
                @DrawerField("Underwriter", _drawerRow.UnderwriterName ?? "—")
                @DrawerField("Due", _drawerRow.DueDate?.ToString("MM/dd/yyyy") ?? "—")
            </div>
            <section class="ew-drawer-section">
                <h3><i class="bi bi-card-text" aria-hidden="true"></i> Description</h3>
                <p>@_drawerRow.Description</p>
                @if (!string.IsNullOrWhiteSpace(_drawerRow.Reason))
                {
                    <strong>Reason</strong>
                    <p>@_drawerRow.Reason</p>
                }
                @if (!string.IsNullOrWhiteSpace(_drawerRow.RequiredDocuments))
                {
                    <strong>Required Documents</strong>
                    <p>@_drawerRow.RequiredDocuments</p>
                }
            </section>
            <section class="ew-drawer-section">
                <h3><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Exposure Changes</h3>
                <table class="ew-delta-table">
                    <thead><tr><th>Field</th><th>Before</th><th>After</th><th>Delta</th></tr></thead>
                    <tbody>
                        @foreach (var d in DeltasFor(_drawerRow.EndorsementId))
                        {
                            <tr>
                                <td>@d.FieldName</td>
                                <td class="ew-dt-before">@d.BeforeValue</td>
                                <td class="ew-dt-after">@d.AfterValue</td>
                                <td>@DeltaCell(d.NumericDelta)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
            <section class="ew-drawer-section">
                <h3><i class="bi bi-clock-history" aria-hidden="true"></i> Activity Timeline</h3>
                <div class="ew-timeline">
                    @foreach (var a in ActivitiesFor(_drawerRow.EndorsementId).Take(6))
                    {
                        <div class="ew-timeline-item">
                            <span class="ew-timeline-dot"></span>
                            <div>
                                <strong>@a.Subject</strong>
                                <span>@a.ActivityType · @a.CreatedByName · @a.ActivityDateUtc.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</span>
                                @if (!string.IsNullOrWhiteSpace(a.Notes))
                                {
                                    <p>@a.Notes</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
            <div class="ew-drawer-actions">
                <button class="um-btn um-btn-success um-btn-sm" @onclick='() => OpenWorkflowAction(_drawerRow, "Approve")' disabled="@IsTerminal(_drawerRow)"><i class="bi bi-check-lg"></i> Approve</button>
                <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => OpenWorkflowAction(_drawerRow, "Issue")' disabled="@(_drawerRow.Status != "Approved")"><i class="bi bi-patch-check"></i> Issue</button>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenWorkflowAction(_drawerRow, "Add Note")'><i class="bi bi-chat-left-text"></i> Add Note</button>
            </div>
        </div>
    </aside>
}

<div class="ew-enterprise-page" @onclick="CloseActionMenu">
    <div class="ew-header">
        <div class="ew-header-left">
            <div class="ew-lob-icon"><i class="bi bi-pen-fill" aria-hidden="true"></i></div>
            <div class="ew-header-info">
                <div class="ew-title-row">
                    <h1 class="ew-page-title">Policy Endorsements</h1>
                    <span class="ew-status-pill">@FilteredRows.Count() active</span>
                    @if (HasFilters)
                    {
                        <span class="ew-filter-pill">Filtered</span>
                    }
                </div>
                <div class="ew-sub-row">
                    <span class="ew-sub-chip"><i class="bi bi-stack" aria-hidden="true"></i>@_rows.Count total endorsements</span>
                    <span class="ew-sub-chip"><i class="bi bi-hourglass-split" aria-hidden="true"></i>@_rows.Count(r => r.Status is "Pending" or "In Review" or "Info Needed") open</span>
                    <span class="ew-sub-chip"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>@_rows.Count(r => r.IsUrgent) urgent</span>
                    <span class="ew-sub-chip"><i class="bi bi-cash-stack" aria-hidden="true"></i>@_rows.Sum(r => r.PremiumDelta).ToString("+$#,##0;-$#,##0;$0") premium impact</span>
                </div>
            </div>
        </div>
        <div class="ew-header-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "ew-spin" : "")"></i> Refresh</button>
            <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenNew"><i class="bi bi-plus-lg"></i> New Endorsement</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies")'><i class="bi bi-shield-check"></i> Policies</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/cancellations")'><i class="bi bi-x-circle"></i> Cancellations</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/documents")'><i class="bi bi-folder2"></i> Documents</button>
        </div>
    </div>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger ew-load-error" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div>
    }

    <div class="ew-kpi-strip">
        @KpiCard("bi-stack", "Total", _rows.Count.ToString(), "ew-kpi-total", null)
        @KpiCard("bi-hourglass-split", "Open", _rows.Count(r => r.Status is "Pending" or "In Review" or "Info Needed").ToString(), "ew-kpi-open", "__open")
        @KpiCard("bi-check-circle", "Approved", _rows.Count(r => r.Status == "Approved").ToString(), "ew-kpi-approved", "Approved")
        @KpiCard("bi-patch-check", "Issued", _rows.Count(r => r.Status == "Issued").ToString(), "ew-kpi-issued", "Issued")
        @KpiCard("bi-x-circle", "Declined", _rows.Count(r => r.Status == "Declined").ToString(), "ew-kpi-declined", "Declined")
        @KpiCard("bi-exclamation-triangle", "Urgent", _rows.Count(r => r.IsUrgent).ToString(), "ew-kpi-urgent", "__urgent")
        @KpiCard("bi-cash-stack", "Premium Impact", _rows.Sum(r => r.PremiumDelta).ToString("+$#,##0;-$#,##0;$0"), "ew-kpi-prem", "__premium")
    </div>

    <div class="ew-enterprise-search" role="search" aria-label="Search endorsements">
        <div class="ew-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
        <div class="ew-search-body">
            <label for="ew-search-input">Enterprise search</label>
            <input id="ew-search-input" class="ew-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search endorsement #, policy #, account, carrier, LOB, status, type, assignee, underwriter, notes, dates…" />
            <div class="ew-search-hint">Searches all visible and workflow fields as you type.</div>
        </div>
        <div class="ew-search-result"><strong>@FilteredRows.Count()</strong><span>matches</span></div>
        @if (HasFilters)
        {
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ew-search-clear" @onclick="ClearFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
        }
    </div>

    <div class="ew-view-tabs" role="tablist" aria-label="Endorsement views">
        @foreach (var tab in _tabs)
        {
            <button class="ew-view-tab @(_activeTab == tab.Key ? "ew-view-tab--active" : null)" type="button" role="tab" aria-selected="@(_activeTab == tab.Key)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <span class="ew-tab-count">@TabCount(tab.Key)</span>
            </button>
        }
    </div>

    <div class="ew-grid-wrap">
        @if (_loading)
        {
            <div class="ew-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Loading endorsements…</span></div>
        }
        else if (!PagedRows.Any())
        {
            <div class="ew-empty-state">
                <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                <strong>No endorsements found</strong>
                <span>Adjust the current tab, KPI, or search criteria.</span>
            </div>
        }
        else
        {
            <div class="ew-grid-toolbar">
                <div><strong>@FilteredRows.Count()</strong> endorsements @if (HasFilters) { <span class="ew-filter-note">Filtered</span> }</div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
            </div>
            <div class="ew-table-scroll">
                <table class="ew-table" aria-label="Policy endorsements register">
                    <thead>
                        <tr>
                            <th>Endorsement #</th>
                            <th>Policy #</th>
                            <th>Account</th>
                            <th>LOB</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Effective</th>
                            <th>Due</th>
                            <th class="ew-num">Prem Δ</th>
                            <th>Assigned</th>
                            <th>Workflow</th>
                            <th class="ew-actions-col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedRows)
                        {
                            <tr class="ew-table-row" @onclick="() => OpenDetail(row)">
                                <td>@EndorsementNoLink(row)</td>
                                <td>@PolicyNoLink(row)</td>
                                <td>
                                    <div class="ew-account-cell">
                                        <span class="ew-avatar">@Initials(row.AccountName)</span>
                                        <div><strong>@row.AccountName</strong><span>@row.Carrier</span></div>
                                    </div>
                                </td>
                                <td>@LobChip(row.LineOfBusiness)</td>
                                <td>@row.EndorsementType</td>
                                <td>@StatusChip(row.Status)</td>
                                <td>@row.EffectiveDate.ToString("MM/dd/yyyy")</td>
                                <td>@DueCell(row)</td>
                                <td class="ew-num">@DeltaCell(row.PremiumDelta)</td>
                                <td>@row.AssignedToName</td>
                                <td><span class="ew-workflow-chip @PriorityClass(row.Priority)">@row.WorkflowStage</span></td>
                                <td class="ew-actions-col">@CtxBtn(row)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="ew-pager">
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left"></i> Previous</button>
                <span class="ew-page-chip">@PageSummary</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right"></i></button>
            </div>
        }
    </div>
</div>

@if (_openActionMenuFor is not null)
{
    <div class="ew-context-menu" style="left:@_menuXpx; top:@_menuYpx" @onclick:stopPropagation="true">
        @foreach (var action in _actionItems)
        {
            <button type="button" @onclick="() => ExecuteMenuAction(action.Label)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
}

@code {
    Guid _tenantId;
    Guid _tenantAdminUserId;
    bool _loading;
    bool _showForm;
    bool _showActionDialog;
    bool _actionBusy;
    bool _toastVisible;
    string _activeTab = "all";
    string _toastMessage = string.Empty;
    string _toastKind = "success";
    string? _kpiFilter;
    string? _loadError;
    string? _searchText;
    Guid? _openActionMenuFor;
    string _menuXpx = "0px";
    string _menuYpx = "0px";
    int _page = 1;
    const int PageSize = 20;

    PolicyEndorsementDto _selected = new();
    PolicyEndorsementDto? _drawerRow;
    EndorsementForm _form = new();
    readonly EndorsementActionForm _actionForm = new();
    string _pendingAction = string.Empty;
    string _actionTitle = "Endorsement Action";
