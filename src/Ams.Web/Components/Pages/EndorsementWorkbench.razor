    {
        "Approve" => "Approved",
        "Decline" => "Declined",
        "Issue" => "Issued",
        "Request Info" => "Info Needed",
        _ => "In Review"
    };

    static string StageFor(string status) => status switch
    {
        "Pending" => "Intake",
        "In Review" => "Underwriting Review",
        "Approved" => "Approved Pending Issue",
        "Declined" => "Closed Declined",
        "Issued" => "Issued to Policy",
        "Info Needed" => "Awaiting Information",
        _ => "Intake"
    };

    async Task ExecuteMenuAction(string action)
    {
        CloseActionMenu();
        switch (action)
        {
            case "Review": OpenWorkflowAction(_selected, "Review"); break;
            case "Edit": OpenEdit(_selected); break;
            case "Approve": OpenWorkflowAction(_selected, "Approve"); break;
            case "Decline": OpenWorkflowAction(_selected, "Decline"); break;
            case "Issue": OpenWorkflowAction(_selected, "Issue"); break;
            case "Request Info": OpenWorkflowAction(_selected, "Request Info"); break;
            case "Add Note": OpenWorkflowAction(_selected, "Add Note"); break;
            case "Add Delta": OpenWorkflowAction(_selected, "Add Delta"); break;
            case "View Policy": NavigateToPolicy(_selected); break;
            case "Archive": OpenWorkflowAction(_selected, "Archive"); break;
            default: await Task.CompletedTask; break;
        }
    }

