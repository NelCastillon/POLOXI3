    static bool IsActionDisabled(PolicyEndorsementDto row, string action) => action switch
    {
        "Approve" or "Decline" or "Request Info" => IsTerminal(row),
        "Issue" => row.Status != "Approved",
        "Archive" => row.EndorsementId == Guid.Empty,
        _ => false
    };

    static string StatusClass(string status) => status.ToLowerInvariant().Replace(" ", "-") switch
    {
        "pending" => "ew-status-pending",
        "in-review" => "ew-status-review",
        "info-needed" => "ew-status-info",
        "approved" => "ew-status-approved",
        "issued" => "ew-status-issued",
        "declined" => "ew-status-declined",
        _ => "ew-status-pending"
    };

    static string PriorityClass(string priority) => priority switch
    {
        "High" => "ew-workflow-high",
        "Critical" => "ew-workflow-critical",
        "Low" => "ew-workflow-low",
        _ => "ew-workflow-normal"
    };

    static string DueClass(PolicyEndorsementDto row)
    {
        if (row.DueDate is null) return "ew-due-none";
        var days = (row.DueDate.Value.Date - DateTime.Today).Days;
        return days < 0 ? "ew-due-overdue" : days <= 3 ? "ew-due-soon" : "ew-due-ok";
    }

    static IEnumerable<string> DistinctOptions(params IEnumerable<string?>[] sources)
        => sources.SelectMany(source => source)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Select(value => value!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(value => value);

    static string FormatPolicySearchText(string policyNumber, string accountName)
        => string.IsNullOrWhiteSpace(policyNumber) ? string.Empty : $"{policyNumber} - {accountName}";

    static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][0].ToString().ToUpperInvariant(),
            _ => string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant()
        };
    }

