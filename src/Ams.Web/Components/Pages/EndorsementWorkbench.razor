@page "/policies/endorsements"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.PolicyEndorsements
@using Microsoft.AspNetCore.Components.Rendering
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Policy Endorsements - AMS</PageTitle>

@if (_toastVisible)
{
    <div class="ew-toast ew-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="ew-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

@if (_showForm)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseForm">
        <div class="mt-modal ew-action-modal" role="dialog" aria-modal="true" aria-labelledby="ew-form-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi bi-pen-fill" aria-hidden="true"></i>
                <span id="ew-form-title">@(_form.EndorsementId == Guid.Empty ? "New Endorsement" : $"Edit {_form.EndorsementNumber}")</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm" disabled="@_actionBusy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_form" OnValidSubmit="SaveEndorsementAsync" OnInvalidSubmit="NotifyValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="ew-modal-intro">
                        <span class="ew-modal-chip"><i class="bi bi-shield-check" aria-hidden="true"></i> Policy servicing workflow</span>
                        <p>Create and maintain policy endorsement requests used by underwriting, service, documents, billing, and issuance workflows.</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full ew-dlg-section">Policy & Account</div>
                        <div class="um-field">
                            <label>Policy <span class="text-danger">*</span></label>
                            <input class="form-control" list="ew-policy-options" value="@_policySearchText" @onchange="OnPolicySearchChanged" placeholder="Search/select policy" />
                            <datalist id="ew-policy-options">
                                @foreach (var policy in PolicyOptions)
                                {
                                    <option value="@policy.DisplayName"></option>
                                }
                            </datalist>
                            <ValidationMessage For="() => _form.PolicyId" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Account <span class="text-danger">*</span></label>
                            <input class="form-control ew-readonly-input" value="@_form.AccountName" disabled />
                            <ValidationMessage For="() => _form.AccountName" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Line of Business <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.LineOfBusiness">
                                <option value="">Select LOB</option>
                                @foreach (var lob in LineOfBusinessOptions)
                                {
                                    <option value="@lob">@lob</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.LineOfBusiness" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Carrier <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.Carrier">
                                <option value="">Select carrier</option>
                                @foreach (var carrier in CarrierOptions)
                                {
                                    <option value="@carrier">@carrier</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.Carrier" class="text-danger" />
                        </div>

                        <div class="um-field um-field--full ew-dlg-section">Endorsement Detail</div>
                        <div class="um-field">
                            <label>Type <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.EndorsementType">
                                <option value="">Select type</option>
                                @foreach (var type in EndorsementTypes)
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.EndorsementType" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Effective Date <span class="text-danger">*</span></label>
                            <InputDate class="form-control" @bind-Value="_form.EffectiveDate" />
                            <ValidationMessage For="() => _form.EffectiveDate" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Expiration Date</label>
                            <InputDate class="form-control" @bind-Value="_form.ExpirationDate" />
                            <ValidationMessage For="() => _form.ExpirationDate" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Change Category</label>
                            <InputSelect class="form-select" @bind-Value="_form.ChangeCategoryCode">
                                @foreach (var option in OptionValues("ChangeCategory"))
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Request Source</label>
                            <InputSelect class="form-select" @bind-Value="_form.RequestSourceCode">
                                @foreach (var option in OptionValues("RequestSource"))
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Premium Delta</label>
                            <InputNumber class="form-control" @bind-Value="_form.PremiumDelta" />
                            <ValidationMessage For="() => _form.PremiumDelta" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Taxes / Fees Delta</label>
                            <InputNumber class="form-control" @bind-Value="_form.TaxFeeDelta" />
                            <ValidationMessage For="() => _form.TaxFeeDelta" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Priority</label>
                            <InputSelect class="form-select" @bind-Value="_form.Priority">
                                @foreach (var priority in Priorities)
                                {
                                    <option value="@priority">@priority</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.Priority" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Assigned To <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="_form.AssignedToName">
                                <option value="">Select assignee</option>
                                @foreach (var assignee in AssigneeOptions)
                                {
                                    <option value="@assignee">@assignee</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.AssignedToName" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Underwriter</label>
                            <InputSelect class="form-select" @bind-Value="_form.UnderwriterName">
                                <option value="">Select underwriter</option>
                                @foreach (var underwriter in UnderwriterOptions)
                                {
                                    <option value="@underwriter">@underwriter</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.UnderwriterName" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Carrier Reference</label>
                            <InputText class="form-control" @bind-Value="_form.CarrierReferenceNumber" />
                            <ValidationMessage For="() => _form.CarrierReferenceNumber" class="text-danger" />
                        </div>
                        <div class="um-field">
                            <label>Billing Impact</label>
                            <InputSelect class="form-select" @bind-Value="_form.BillingImpactCode">
                                @foreach (var option in OptionValues("BillingImpact"))
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Approval Level</label>
                            <InputSelect class="form-select" @bind-Value="_form.ApprovalLevelCode">
                                @foreach (var option in OptionValues("ApprovalLevel"))
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Document Delivery</label>
                            <InputSelect class="form-select" @bind-Value="_form.DocumentDeliveryCode">
                                @foreach (var option in OptionValues("DocumentDelivery"))
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="um-field">
                            <label>Due Date</label>
                            <InputDate class="form-control" @bind-Value="_form.DueDate" />
                            <ValidationMessage For="() => _form.DueDate" class="text-danger" />
                        </div>
                        <div class="um-field ew-check-field">
                            <label class="ew-check-label"><InputCheckbox @bind-Value="_form.IsUrgent" /> Urgent workflow</label>
                            <ValidationMessage For="() => _form.IsUrgent" class="text-danger" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Description <span class="text-danger">*</span></label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_form.Description" />
                            <ValidationMessage For="() => _form.Description" class="text-danger" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Reason</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.Reason" />
                            <ValidationMessage For="() => _form.Reason" class="text-danger" />
                        </div>
                        <div class="um-field um-field--full">
                            <label>Required Documents</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_form.RequiredDocuments" />
                            <ValidationMessage For="() => _form.RequiredDocuments" class="text-danger" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="um-btn um-btn-primary" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        Save Endorsement
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showActionDialog)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="CloseActionDialog">
        <div class="mt-modal ew-action-modal" role="dialog" aria-modal="true" aria-labelledby="ew-action-title" @onclick:stopPropagation="true">
            <div class="um-modal-header">
                <i class="bi @_actionIcon" aria-hidden="true"></i>
                <span id="ew-action-title">@_actionTitle</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseActionDialog" disabled="@_actionBusy"><i class="bi bi-x-lg"></i></button>
            </div>
            <EditForm Model="_actionForm" OnValidSubmit="ConfirmActionAsync" OnInvalidSubmit="NotifyActionValidationAsync">
                <DataAnnotationsValidator />
                <div class="um-modal-body">
                    <div class="ew-modal-intro">
                        <span class="ew-modal-chip"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Workflow action</span>
                        <p>@_actionHelpText</p>
                    </div>
                    <div class="um-form-grid">
                        <div class="um-field um-field--full">
                            <label>Endorsement</label>
                            <input class="form-control ew-readonly-input" value="@_selected.EndorsementNumber - @_selected.AccountName" disabled />
                        </div>
                        @if (_pendingAction == "Add Delta")
                        {
                            <div class="um-field">
                                <label>Field <span class="text-danger">*</span></label>
                                <InputText class="form-control" @bind-Value="_actionForm.FieldName" />
                                <ValidationMessage For="() => _actionForm.FieldName" class="text-danger" />
                            </div>
                            <div class="um-field">
                                <label>Premium / Numeric Delta</label>
                                <InputNumber class="form-control" @bind-Value="_actionForm.NumericDelta" />
                                <ValidationMessage For="() => _actionForm.NumericDelta" class="text-danger" />
                            </div>
                            <div class="um-field">
                                <label>Before</label>
                                <InputText class="form-control" @bind-Value="_actionForm.BeforeValue" />
                                <ValidationMessage For="() => _actionForm.BeforeValue" class="text-danger" />
                            </div>
                            <div class="um-field">
                                <label>After</label>
                                <InputText class="form-control" @bind-Value="_actionForm.AfterValue" />
                                <ValidationMessage For="() => _actionForm.AfterValue" class="text-danger" />
                            </div>
                        }
                        <div class="um-field um-field--full">
                            <label>
                                Notes
                                @if (_pendingAction is "Decline" or "Request Info" or "Add Note")
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_actionForm.Notes" />
                            <ValidationMessage For="() => _actionForm.Notes" class="text-danger" />
                        </div>
                    </div>
                </div>
                <div class="um-modal-footer">
                    <button type="button" class="um-btn um-btn-ghost" @onclick="CloseActionDialog" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="um-btn @(_pendingAction == "Decline" || _pendingAction == "Archive" ? "um-btn-danger" : "um-btn-primary")" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @_actionButtonText
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_drawerRow is not null)
{
    <div class="ew-drawer-backdrop" @onclick="CloseDrawer"></div>
    <aside class="ew-drawer" aria-label="Endorsement details">
        <div class="ew-drawer-head">
            <div>
                <h2 class="ew-drawer-title">@_drawerRow.EndorsementNumber</h2>
                <span class="ew-drawer-sub">@_drawerRow.PolicyNumber - @_drawerRow.AccountName</span>
            </div>
            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="CloseDrawer"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <div class="ew-drawer-body">
            <div class="ew-drawer-banner @(_drawerRow.IsUrgent ? "ew-drawer-banner--urgent" : null)">
                <i class="bi @(_drawerRow.IsUrgent ? "bi-exclamation-triangle-fill" : "bi-info-circle")" aria-hidden="true"></i>
                <span>@_drawerRow.WorkflowStage</span>
                <strong>@_drawerRow.Priority</strong>
            </div>
            <div class="ew-drawer-meta">
                @DrawerField("Type", _drawerRow.EndorsementType)
                @DrawerField("Status", _drawerRow.Status)
                @DrawerField("LOB", _drawerRow.LineOfBusiness)
                @DrawerField("Carrier", _drawerRow.Carrier)
                @DrawerField("Effective", _drawerRow.EffectiveDate.ToString("MM/dd/yyyy"))
                @DrawerField("Premium Delta", _drawerRow.PremiumDelta.ToString("+$#,##0;-$#,##0;$0"))
                @DrawerField("Requested By", _drawerRow.RequestedByName)
                @DrawerField("Assigned To", _drawerRow.AssignedToName)
                @DrawerField("Underwriter", _drawerRow.UnderwriterName ?? "-")
                @DrawerField("Due", _drawerRow.DueDate?.ToString("MM/dd/yyyy") ?? "-")
            </div>
            <section class="ew-drawer-section">
                <h3><i class="bi bi-card-text" aria-hidden="true"></i> Description</h3>
                <p>@_drawerRow.Description</p>
                @if (!string.IsNullOrWhiteSpace(_drawerRow.Reason))
                {
                    <strong>Reason</strong>
                    <p>@_drawerRow.Reason</p>
                }
                @if (!string.IsNullOrWhiteSpace(_drawerRow.RequiredDocuments))
                {
                    <strong>Required Documents</strong>
                    <p>@_drawerRow.RequiredDocuments</p>
                }
            </section>
            <section class="ew-drawer-section">
                <h3><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Exposure Changes</h3>
                <table class="ew-delta-table">
                    <thead><tr><th>Field</th><th>Before</th><th>After</th><th>Delta</th></tr></thead>
                    <tbody>
                        @foreach (var d in DeltasFor(_drawerRow.EndorsementId))
                        {
                            <tr>
                                <td>@d.FieldName</td>
                                <td class="ew-dt-before">@d.BeforeValue</td>
                                <td class="ew-dt-after">@d.AfterValue</td>
                                <td>@DeltaCell(d.NumericDelta)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
            <section class="ew-drawer-section">
                <h3><i class="bi bi-clock-history" aria-hidden="true"></i> Activity Timeline</h3>
                <div class="ew-timeline">
                    @foreach (var a in ActivitiesFor(_drawerRow.EndorsementId).Take(6))
                    {
                        <div class="ew-timeline-item">
                            <span class="ew-timeline-dot"></span>
                            <div>
                                <strong>@a.Subject</strong>
                                <span>@a.ActivityType - @a.CreatedByName - @a.ActivityDateUtc.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")</span>
                                @if (!string.IsNullOrWhiteSpace(a.Notes))
                                {
                                    <p>@a.Notes</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
            <div class="ew-drawer-actions">
                <button class="um-btn um-btn-success um-btn-sm" @onclick='() => OpenWorkflowAction(_drawerRow, "Approve")' disabled="@IsTerminal(_drawerRow)"><i class="bi bi-check-lg"></i> Approve</button>
                <button class="um-btn um-btn-primary um-btn-sm" @onclick='() => OpenWorkflowAction(_drawerRow, "Issue")' disabled="@(_drawerRow.Status != "Approved")"><i class="bi bi-patch-check"></i> Issue</button>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenWorkflowAction(_drawerRow, "Add Note")'><i class="bi bi-chat-left-text"></i> Add Note</button>
            </div>
        </div>
    </aside>
}

<div class="ew-enterprise-page" @onclick="CloseActionMenu">
    <div class="ew-header">
        <div class="ew-header-left">
            <div class="ew-lob-icon"><i class="bi bi-pen-fill" aria-hidden="true"></i></div>
            <div class="ew-header-info">
                <div class="ew-title-row">
                    <h1 class="ew-page-title">Policy Endorsements</h1>
                    <span class="ew-status-pill">@FilteredRows.Count() active</span>
                    @if (HasFilters)
                    {
                        <span class="ew-filter-pill">Filtered</span>
                    }
                </div>
                <p class="ew-hero-copy">Enterprise policy change command center for intake, underwriting review, approval, issuing, premium impact, document requirements, and workflow synchronization.</p>
                <div class="ew-sub-row">
                    <span class="ew-sub-chip"><i class="bi bi-stack" aria-hidden="true"></i>@_rows.Count total endorsements</span>
                    <span class="ew-sub-chip"><i class="bi bi-hourglass-split" aria-hidden="true"></i>@_rows.Count(r => r.Status is "Pending" or "In Review" or "Info Needed") open</span>
                    <span class="ew-sub-chip"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i>@_rows.Count(r => r.IsUrgent) urgent</span>
                    <span class="ew-sub-chip"><i class="bi bi-cash-stack" aria-hidden="true"></i>@_rows.Sum(r => r.PremiumDelta).ToString("+$#,##0;-$#,##0;$0") premium impact</span>
                </div>
            </div>
        </div>
        <div class="ew-header-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "ew-spin" : "")"></i> Refresh</button>
            <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenNew"><i class="bi bi-plus-lg"></i> New Endorsement</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies")'><i class="bi bi-shield-check"></i> Policies</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/cancellations")'><i class="bi bi-x-circle"></i> Cancellations</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/policies/documents")'><i class="bi bi-folder2"></i> Documents</button>
        </div>
    </div>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger ew-load-error" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div>
    }

    <div class="ew-kpi-strip">
        <button type="button" class="@TotalKpiClass" title="Portfolio total" @onclick="@(() => ClearKpiFilter())">
            <div class="ew-kpi-icon"><i class="bi bi-stack" aria-hidden="true"></i></div>
            <div><span class="ew-kpi-val">@_rows.Count</span><span class="ew-kpi-lbl">Total</span><small>Portfolio total</small></div>
        </button>
        <button type="button" class="@OpenKpiClass" title="Click to filter" @onclick="@(() => SetOpenKpiFilter())">
            <div class="ew-kpi-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></div>
            <div><span class="ew-kpi-val">@OpenCount</span><span class="ew-kpi-lbl">Open</span><small>Click to filter</small></div>
        </button>
        <button type="button" class="@ApprovedKpiClass" title="Click to filter" @onclick="@(() => SetApprovedKpiFilter())">
            <div class="ew-kpi-icon"><i class="bi bi-check-circle" aria-hidden="true"></i></div>
            <div><span class="ew-kpi-val">@ApprovedCount</span><span class="ew-kpi-lbl">Approved</span><small>Click to filter</small></div>
        </button>
        <button type="button" class="@IssuedKpiClass" title="Click to filter" @onclick="@(() => SetIssuedKpiFilter())">
            <div class="ew-kpi-icon"><i class="bi bi-patch-check" aria-hidden="true"></i></div>
            <div><span class="ew-kpi-val">@IssuedCount</span><span class="ew-kpi-lbl">Issued</span><small>Click to filter</small></div>
        </button>
        <button type="button" class="@DeclinedKpiClass" title="Click to filter" @onclick="@(() => SetDeclinedKpiFilter())">
            <div class="ew-kpi-icon"><i class="bi bi-x-circle" aria-hidden="true"></i></div>
            <div><span class="ew-kpi-val">@DeclinedCount</span><span class="ew-kpi-lbl">Declined</span><small>Click to filter</small></div>
        </button>
        <button type="button" class="@UrgentKpiClass" title="Click to filter" @onclick="@SetUrgentKpiFilter">
            <div class="ew-kpi-icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div>
            <div><span class="ew-kpi-val">@UrgentCount</span><span class="ew-kpi-lbl">Urgent</span><small>Click to filter</small></div>
        </button>
        <button type="button" class="@PremiumKpiClass" title="Click to filter" @onclick="@(() => SetPremiumKpiFilter())">
            <div class="ew-kpi-icon"><i class="bi bi-cash-stack" aria-hidden="true"></i></div>
            <div><span class="ew-kpi-val">@PremiumImpactText</span><span class="ew-kpi-lbl">Premium Impact</span><small>Click to filter</small></div>
        </button>
    </div>

    <section class="ew-workflow-strip" aria-label="Endorsement workflow shortcuts">
        <button type="button" class="ew-workflow-card" @onclick='() => FocusDashboard("open", "__open")'>
            <i class="bi bi-inboxes" aria-hidden="true"></i>
            <span><strong>Intake queue</strong><small>Open pending and information-needed policy change requests</small></span>
        </button>
        <button type="button" class="ew-workflow-card" @onclick='() => FocusDashboard("review", null)'>
            <i class="bi bi-search" aria-hidden="true"></i>
            <span><strong>Underwriting review</strong><small>Prioritize endorsements waiting on underwriting decisions</small></span>
        </button>
        <button type="button" class="ew-workflow-card" @onclick='() => FocusDashboard("approved", "Approved")'>
            <i class="bi bi-patch-check" aria-hidden="true"></i>
            <span><strong>Issue desk</strong><small>Move approved endorsements into issued policy documents</small></span>
        </button>
        <button type="button" class="ew-workflow-card" @onclick='() => FocusDashboard("all", "__premium")'>
            <i class="bi bi-cash-stack" aria-hidden="true"></i>
            <span><strong>Premium impact</strong><small>Review endorsements that change policy premium or exposure</small></span>
        </button>
    </section>

    <div class="um-search-row" role="search" aria-label="Search endorsements">
        <div class="um-search-box">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="ew-search-input" class="um-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search endorsement #, policy #, account, carrier, LOB, status, type, assignee, underwriter, notes, dates..." />
        </div>
        <div class="um-search-result"><strong>@FilteredRows.Count()</strong><span>matches</span></div>
        @if (HasFilters)
        {
            <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
        }
    </div>

    <div class="ew-view-tabs" role="tablist" aria-label="Endorsement views">
        @foreach (var tab in _tabs)
        {
            <button class="ew-view-tab @(_activeTab == tab.Key ? "ew-view-tab--active" : null)" type="button" role="tab" aria-selected="@(_activeTab == tab.Key)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <span class="ew-tab-count">@TabCount(tab.Key)</span>
            </button>
        }
    </div>

    <main class="ew-content-layout">
        <section class="ew-main-card">
    <div class="ew-grid-wrap">
        @if (_loading)
        {
            <div class="ew-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Loading endorsements...</span></div>
        }
        else if (!PagedRows.Any())
        {
            <div class="ew-empty-state">
                <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                <strong>No endorsements found</strong>
                <span>Adjust the current tab, KPI, or search criteria.</span>
            </div>
        }
        else
        {
            <div class="ew-grid-toolbar">
                <div><strong>@FilteredRows.Count()</strong> endorsements @if (HasFilters) { <span class="ew-filter-note">Filtered</span> }</div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="ClearFilters" disabled="@(!HasFilters)"><i class="bi bi-x-lg" aria-hidden="true"></i> Reset</button>
            </div>
            <div class="ew-table-scroll">
                <table class="ew-table" aria-label="Policy endorsements register">
                    <thead>
                        <tr>
                            <th>Endorsement #</th>
                            <th>Policy #</th>
                            <th>Account</th>
                            <th>LOB</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Effective</th>
                            <th>Due</th>
                            <th class="ew-num">Prem Δ</th>
                            <th>Assigned</th>
                            <th>Workflow</th>
                            <th class="ew-actions-col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedRows)
                        {
                            <tr class="ew-table-row" @onclick="() => OpenDetail(row)">
                                <td>@EndorsementNoLink(row)</td>
                                <td>@PolicyNoLink(row)</td>
                                <td>
                                    <div class="ew-account-cell">
                                        <span class="ew-avatar">@Initials(row.AccountName)</span>
                                        <div><a class="ew-account-link" href="@AccountHref(row)" @onclick:stopPropagation="true">@row.AccountName</a><span>@row.Carrier</span></div>
                                    </div>
                                </td>
                                <td>@LobChip(row.LineOfBusiness)</td>
                                <td>@row.EndorsementType</td>
                                <td>@StatusChip(row.Status)</td>
                                <td>@row.EffectiveDate.ToString("MM/dd/yyyy")</td>
                                <td>@DueCell(row)</td>
                                <td class="ew-num">@DeltaCell(row.PremiumDelta)</td>
                                <td>@row.AssignedToName</td>
                                <td><span class="ew-workflow-chip @PriorityClass(row.Priority)">@row.WorkflowStage</span></td>
                                <td class="ew-actions-col">@CtxBtn(row)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="ew-pager">
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="PreviousPage" disabled="@(_page <= 1)"><i class="bi bi-chevron-left"></i> Previous</button>
                <span class="ew-page-chip">@PageSummary</span>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="NextPage" disabled="@(_page >= TotalPages)">Next <i class="bi bi-chevron-right"></i></button>
            </div>
        }
    </div>
        </section>

        <aside class="ew-detail-card" aria-label="Selected endorsement summary">
            <div class="ew-detail-head">
                <div>
                    <span class="ew-detail-eyebrow"><i class="bi bi-pen-fill" aria-hidden="true"></i> Selected endorsement</span>
                    <h2>@(SelectedRow?.EndorsementNumber ?? "Select an endorsement")</h2>
                    <p>@(SelectedRow is null ? "Choose a row to inspect workflow, premium impact, and actions." : $"{SelectedRow.PolicyNumber} - {SelectedRow.AccountName}")</p>
                </div>
            </div>
            <div class="ew-detail-body">
                @if (SelectedRow is null)
                {
                    <div class="ew-detail-empty"><i class="bi bi-cursor" aria-hidden="true"></i><strong>No endorsement selected</strong><span>Details and actions appear here after selecting a row.</span></div>
                }
                else
                {
                    var selected = SelectedRow;
                    <div class="ew-detail-summary">
                        <div><span>Status</span><strong>@selected.Status</strong></div>
                        <div><span>Priority</span><strong>@selected.Priority</strong></div>
                        <div><span>Premium Impact</span><strong>@selected.PremiumDelta.ToString("+$#,##0;-$#,##0;$0")</strong></div>
                        <div><span>Due</span><strong>@(selected.DueDate?.ToString("MM/dd/yyyy") ?? "-")</strong></div>
                    </div>
                    <div class="ew-contact-card"><strong>@selected.EndorsementType</strong><span>@selected.Description</span><small>@selected.LineOfBusiness - @selected.Carrier</small></div>
                    <div class="ew-detail-actions">
                        <button type="button" class="um-btn um-btn-primary" @onclick="() => OpenDetail(selected)"><i class="bi bi-eye" aria-hidden="true"></i> Review</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => OpenEdit(selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                        <button type="button" class="um-btn um-btn-success" @onclick='() => OpenWorkflowAction(selected, "Approve")' disabled="@IsTerminal(selected)"><i class="bi bi-check-lg" aria-hidden="true"></i> Approve</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick='() => OpenWorkflowAction(selected, "Add Note")'><i class="bi bi-chat-left-text" aria-hidden="true"></i> Add Note</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick='() => OpenWorkflowAction(selected, "Add Delta")'><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Add Delta</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => NavigateToPolicy(selected)"><i class="bi bi-shield" aria-hidden="true"></i> View Policy</button>
                    </div>
                }
            </div>
        </aside>
    </main>
</div>

@if (_openActionMenuFor is not null)
{
    <div class="ew-context-menu" style="left:@_menuXpx; top:@_menuYpx" @onclick:stopPropagation="true">
        @foreach (var action in _actionItems)
        {
            <button type="button" disabled="@IsActionDisabled(_selected, action.Label)" @onclick="() => ExecuteMenuAction(action.Label)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
}

@code {
    Guid _tenantId;
    Guid _tenantAdminUserId;
    bool _loading;
    bool _showForm;
    bool _showActionDialog;
    bool _actionBusy;
    bool _toastVisible;
    string _activeTab = "all";
    string _toastMessage = string.Empty;
    string _toastKind = "success";
    string? _kpiFilter;
    string? _loadError;
    string? _searchText;
    string _policySearchText = string.Empty;
    Guid? _openActionMenuFor;
    string _menuXpx = "0px";
    string _menuYpx = "0px";
    int _page = 1;
    const int PageSize = 20;

    PolicyEndorsementDto _selected = new();
    PolicyEndorsementDto? _drawerRow;
    EndorsementForm _form = new();
    readonly EndorsementActionForm _actionForm = new();
    string _pendingAction = string.Empty;
    string _actionTitle = "Endorsement Action";
    string _actionIcon = "bi-lightning-charge";
    string _actionButtonText = "Continue";
    string _actionHelpText = string.Empty;

    readonly List<PolicyEndorsementDto> _rows = [];
    readonly List<PolicyEndorsementActivityDto> _activities = [];
    readonly List<PolicyEndorsementDeltaDto> _deltas = [];
    readonly List<PolicyEndorsementOptionDto> _options = [];
    readonly List<EndorsementTypeDto> _endorsementTypes = [];
    readonly List<PolicyRegisterDto> _policies = [];

    readonly TabDef[] _tabs =
    [
        new("all", "All", "bi-stack"),
        new("open", "Open", "bi-hourglass-split"),
        new("review", "In Review", "bi-search"),
        new("approved", "Approved", "bi-check-circle"),
        new("issued", "Issued", "bi-patch-check"),
        new("declined", "Declined", "bi-x-circle"),
        new("urgent", "Urgent", "bi-exclamation-triangle"),
        new("carrier", "By Carrier", "bi-building"),
        new("lob", "By LOB", "bi-layers"),
    ];

    readonly ActionItem[] _actionItems =
    [
        new("Review", "bi-eye"),
        new("Edit", "bi-pencil"),
        new("Approve", "bi-check-lg"),
        new("Decline", "bi-x-lg"),
        new("Issue", "bi-patch-check"),
        new("Request Info", "bi-question-circle"),
        new("Add Note", "bi-chat-left-text"),
        new("Add Delta", "bi-arrow-left-right"),
        new("View Policy", "bi-shield"),
        new("Archive", "bi-archive"),
    ];

    bool HasFilters => !string.IsNullOrWhiteSpace(_searchText) || _kpiFilter is not null;
    string? SearchText
    {
        get => _searchText;
        set { _searchText = value; _page = 1; }
    }

    IEnumerable<PolicyEndorsementDto> BaseTabRows => _activeTab switch
    {
        "open" => _rows.Where(r => r.Status is "Pending" or "In Review" or "Info Needed"),
        "review" => _rows.Where(r => r.Status == "In Review"),
        "approved" => _rows.Where(r => r.Status == "Approved"),
        "issued" => _rows.Where(r => r.Status == "Issued"),
        "declined" => _rows.Where(r => r.Status == "Declined"),
        "urgent" => _rows.Where(r => r.IsUrgent),
        "carrier" => _rows.OrderBy(r => r.Carrier).ThenBy(r => r.DueDate),
        "lob" => _rows.OrderBy(r => r.LineOfBusiness).ThenBy(r => r.DueDate),
        _ => _rows,
    };

    IEnumerable<PolicyEndorsementDto> FilteredRows => ApplyEnterpriseFilters(BaseTabRows);
    IEnumerable<PolicyEndorsementDto> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize);
    IEnumerable<PolicyOption> PolicyOptions => _policies.Select(PolicyOption.From).OrderBy(p => p.PolicyNumber);
    IEnumerable<string> LineOfBusinessOptions => DistinctOptions(_policies.Select(p => p.LineOfBusiness), _rows.Select(r => r.LineOfBusiness));
    IEnumerable<string> CarrierOptions => DistinctOptions(_policies.Select(p => p.CarrierName), _rows.Select(r => r.Carrier));
    IEnumerable<string> AssigneeOptions => DistinctOptions(_policies.Select(p => p.AssignedToUserName), _policies.Select(p => p.CsrName), _policies.Select(p => p.ProducerName), _rows.Select(r => r.AssignedToName));
    IEnumerable<string> UnderwriterOptions => DistinctOptions(_rows.Select(r => r.UnderwriterName));
    IEnumerable<string> EndorsementTypes => _endorsementTypes.OrderBy(x => x.SortOrder).ThenBy(x => x.TypeName).Select(x => x.TypeName);
    IEnumerable<string> Priorities => OptionValues("Priority");
    IEnumerable<string> Statuses => OptionValues("Status");
    PolicyEndorsementDto? SelectedRow => _drawerRow ?? (_selected.EndorsementId == Guid.Empty ? FilteredRows.FirstOrDefault() : _rows.FirstOrDefault(r => r.EndorsementId == _selected.EndorsementId) ?? FilteredRows.FirstOrDefault());
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)PageSize));
    string PageSummary
    {
        get
        {
            var total = FilteredRows.Count();
            if (total == 0) return "No endorsements";
            var start = ((_page - 1) * PageSize) + 1;
            var end = Math.Min(_page * PageSize, total);
            return $"Showing {start}-{end} of {total}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Policies", "/policies"), new("Endorsements", "/policies/endorsements"));
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var center = await Api.GetPolicyEndorsementCenterAsync(_tenantId);
            var policies = await Api.SearchPolicyRegisterAsync(_tenantId, pageSize: 500);
            var endorsementTypes = await Api.SearchEndorsementTypesAsync(_tenantId, pageSize: 500);
            _rows.Clear();
            _activities.Clear();
            _deltas.Clear();
            _options.Clear();
            _endorsementTypes.Clear();
            _policies.Clear();
            _rows.AddRange(center?.Endorsements ?? []);
            _activities.AddRange(center?.Activities ?? []);
            _deltas.AddRange(center?.Deltas ?? []);
            _options.AddRange(center?.Options ?? []);
            _endorsementTypes.AddRange(endorsementTypes?.Items.Where(x => x.IsActive) ?? []);
            _policies.AddRange(policies?.Items ?? []);
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load endorsements: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    IEnumerable<PolicyEndorsementDto> ApplyEnterpriseFilters(IEnumerable<PolicyEndorsementDto> rows)
    {
        if (_kpiFilter is not null)
        {
            rows = _kpiFilter switch
            {
                "__open" => rows.Where(r => r.Status is "Pending" or "In Review" or "Info Needed"),
                "__urgent" => rows.Where(r => r.IsUrgent),
                "__premium" => rows.Where(r => r.PremiumDelta != 0),
                _ => rows.Where(r => r.Status == _kpiFilter)
            };
        }

        if (string.IsNullOrWhiteSpace(_searchText)) return rows;
        var term = _searchText.Trim();
        return rows.Where(r => SearchBlob(r).Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    static string SearchBlob(PolicyEndorsementDto r) => string.Join(' ', r.EndorsementNumber, r.PolicyNumber, r.AccountName, r.LineOfBusiness, r.Carrier, r.EndorsementType, r.Description, r.Status, r.Priority, r.RequestedByName, r.AssignedToName, r.UnderwriterName, r.Reason, r.RequiredDocuments, r.WorkflowStage, r.EffectiveDate.ToString("MM/dd/yyyy"), r.DueDate?.ToString("MM/dd/yyyy"), r.PremiumDelta.ToString());

    IEnumerable<string> OptionValues(string groupCode)
        => _options
            .Where(x => string.Equals(x.OptionGroupCode, groupCode, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => x.SortOrder)
            .ThenBy(x => x.DisplayName)
            .Select(x => x.OptionCode)
            .Distinct(StringComparer.OrdinalIgnoreCase);

    string DefaultOptionValue(string groupCode)
        => _options
            .Where(x => string.Equals(x.OptionGroupCode, groupCode, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.IsDefault)
            .ThenBy(x => x.SortOrder)
            .Select(x => x.OptionCode)
            .FirstOrDefault() ?? string.Empty;

    void SetActiveTab(string tab) { _activeTab = tab; _kpiFilter = null; _page = 1; }
    void FocusDashboard(string tab, string? kpiFilter) { _activeTab = tab; _kpiFilter = kpiFilter; _page = 1; }
    void ApplyKpiFilter(string? filter) { _kpiFilter = _kpiFilter == filter ? null : filter; _page = 1; }
    const string OpenKpi = "__open";
    const string ApprovedKpi = "Approved";
    const string IssuedKpi = "Issued";
    const string DeclinedKpi = "Declined";
    const string UrgentKpi = "__urgent";
    const string PremiumKpi = "__premium";
    string KpiClass(string cssClass, string? filter) => $"ew-kpi-card {cssClass} {(_kpiFilter == filter ? "ew-kpi-card--active" : string.Empty)}";
    string TotalKpiClass => KpiClass("ew-kpi-total", null);
    string OpenKpiClass => KpiClass("ew-kpi-open", OpenKpi);
    string ApprovedKpiClass => KpiClass("ew-kpi-approved", ApprovedKpi);
    string IssuedKpiClass => KpiClass("ew-kpi-issued", IssuedKpi);
    string DeclinedKpiClass => KpiClass("ew-kpi-declined", DeclinedKpi);
    string UrgentKpiClass => KpiClass("ew-kpi-urgent", UrgentKpi);
    string PremiumKpiClass => KpiClass("ew-kpi-prem", PremiumKpi);
    int OpenCount => _rows.Count(r => r.Status is "Pending" or "In Review" or "Info Needed");
    int ApprovedCount => _rows.Count(r => r.Status == ApprovedKpi);
    int IssuedCount => _rows.Count(r => r.Status == IssuedKpi);
    int DeclinedCount => _rows.Count(r => r.Status == DeclinedKpi);
    int UrgentCount => _rows.Count(r => r.IsUrgent);
    string PremiumImpactText => _rows.Sum(r => r.PremiumDelta).ToString("+$#,##0;-$#,##0;$0");
    void ClearKpiFilter() { ApplyKpiFilter(null); }
    void SetOpenKpiFilter() { ApplyKpiFilter(OpenKpi); }
    void SetApprovedKpiFilter() { ApplyKpiFilter(ApprovedKpi); }
    void SetIssuedKpiFilter() { ApplyKpiFilter(IssuedKpi); }
    void SetDeclinedKpiFilter() { ApplyKpiFilter(DeclinedKpi); }
    void SetUrgentKpiFilter() { ApplyKpiFilter(UrgentKpi); }
    void SetPremiumKpiFilter() { ApplyKpiFilter(PremiumKpi); }
    void ClearFilters() { _searchText = null; _kpiFilter = null; _page = 1; }
    void PreviousPage() { if (_page > 1) _page--; }
    void NextPage() { if (_page < TotalPages) _page++; }
    int TabCount(string key) => key switch
    {
        "open" => _rows.Count(r => r.Status is "Pending" or "In Review" or "Info Needed"),
        "review" => _rows.Count(r => r.Status == "In Review"),
        "approved" => _rows.Count(r => r.Status == "Approved"),
        "issued" => _rows.Count(r => r.Status == "Issued"),
        "declined" => _rows.Count(r => r.Status == "Declined"),
        "urgent" => _rows.Count(r => r.IsUrgent),
        _ => _rows.Count,
    };

    void OpenNew()
    {
        var assignee = AssigneeOptions.FirstOrDefault() ?? "Current User";
        _form = new EndorsementForm
        {
            EffectiveDate = DateTime.Today,
            DueDate = DateTime.Today.AddDays(5),
            RequestedByName = assignee,
            AssignedToName = assignee,
            Priority = DefaultOptionValue("Priority"),
            RequestSourceCode = DefaultOptionValue("RequestSource"),
            ChangeCategoryCode = DefaultOptionValue("ChangeCategory"),
            BillingImpactCode = DefaultOptionValue("BillingImpact"),
            ApprovalLevelCode = DefaultOptionValue("ApprovalLevel"),
            DocumentDeliveryCode = DefaultOptionValue("DocumentDelivery"),
            AgentAuthorityCode = DefaultOptionValue("AgentAuthority")
        };
        _policySearchText = string.Empty;
        _showForm = true;
    }

    void OpenEdit(PolicyEndorsementDto row)
    {
        _selected = row;
        _form = EndorsementForm.From(row);
        _policySearchText = FormatPolicySearchText(_form.PolicyNumber, _form.AccountName);
        _showForm = true;
    }

    void OnPolicySearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args)
    {
        _policySearchText = args.Value?.ToString() ?? string.Empty;
        var selected = PolicyOptions.FirstOrDefault(p => string.Equals(p.DisplayName, _policySearchText, StringComparison.OrdinalIgnoreCase))
            ?? PolicyOptions.FirstOrDefault(p => string.Equals(p.PolicyNumber, _policySearchText, StringComparison.OrdinalIgnoreCase));

        if (selected is null)
        {
            _form.PolicyId = null;
            _form.AccountId = null;
            _form.PolicyNumber = string.Empty;
            _form.AccountName = string.Empty;
            _form.LineOfBusiness = string.Empty;
            _form.Carrier = string.Empty;
            return;
        }

        _form.PolicyId = selected.PolicyId;
        _form.AccountId = selected.AccountId;
        _form.PolicyNumber = selected.PolicyNumber;
        _form.AccountName = selected.AccountName;
        _form.LineOfBusiness = selected.LineOfBusiness;
        _form.Carrier = selected.CarrierName;
        _policySearchText = selected.DisplayName;
    }

    void CloseForm() => _showForm = false;

    async Task SaveEndorsementAsync()
    {
        _actionBusy = true;
        try
        {
            if (_form.EndorsementId == Guid.Empty)
            {
                await Api.CreatePolicyEndorsementAsync(new CreatePolicyEndorsementRequest
                {
                    TenantId = _tenantId,
                    PolicyId = _form.PolicyId,
                    AccountId = _form.AccountId,
                    PolicyNumber = _form.PolicyNumber,
                    AccountName = _form.AccountName,
                    LineOfBusiness = _form.LineOfBusiness,
                    Carrier = _form.Carrier,
                    EndorsementType = _form.EndorsementType,
                    RequestSourceCode = _form.RequestSourceCode,
                    ChangeCategoryCode = _form.ChangeCategoryCode,
                    Description = _form.Description,
                    EffectiveDate = _form.EffectiveDate,
                    ExpirationDate = _form.ExpirationDate,
                    PremiumDelta = _form.PremiumDelta,
                    TaxFeeDelta = _form.TaxFeeDelta,
                    TotalCostDelta = _form.PremiumDelta + _form.TaxFeeDelta,
                    ProratedPremiumDelta = _form.PremiumDelta,
                    Priority = _form.Priority,
                    RequestedByName = _form.RequestedByName,
                    AssignedToName = _form.AssignedToName,
                    UnderwriterName = _form.UnderwriterName,
                    CarrierReferenceNumber = _form.CarrierReferenceNumber,
                    AgentAuthorityCode = _form.AgentAuthorityCode,
                    ApprovalLevelCode = _form.ApprovalLevelCode,
                    BillingImpactCode = _form.BillingImpactCode,
                    CommissionImpactCode = _form.PremiumDelta == 0m && _form.TaxFeeDelta == 0m ? "NoCommissionImpact" : "RecalculateCommission",
                    DocumentDeliveryCode = _form.DocumentDeliveryCode,
                    CertificateRequired = _form.CertificateRequired,
                    ComplianceReviewRequired = _form.ComplianceReviewRequired,
                    InternalNotes = _form.InternalNotes,
                    ClientFacingNotes = _form.ClientFacingNotes,
                    Reason = _form.Reason,
                    RequiredDocuments = _form.RequiredDocuments,
                    DueDate = _form.DueDate,
                    IsUrgent = _form.IsUrgent,
                    CreatedByUserId = _tenantAdminUserId
                });
                ShowToast("Endorsement created.");
            }
            else
            {
                await Api.UpdatePolicyEndorsementAsync(_form.EndorsementId, new UpdatePolicyEndorsementRequest
                {
                    EndorsementType = _form.EndorsementType,
                    RequestSourceCode = _form.RequestSourceCode,
                    ChangeCategoryCode = _form.ChangeCategoryCode,
                    Description = _form.Description,
                    EffectiveDate = _form.EffectiveDate,
                    ExpirationDate = _form.ExpirationDate,
                    PremiumDelta = _form.PremiumDelta,
                    TaxFeeDelta = _form.TaxFeeDelta,
                    TotalCostDelta = _form.PremiumDelta + _form.TaxFeeDelta,
                    ProratedPremiumDelta = _form.PremiumDelta,
                    Priority = _form.Priority,
                    AssignedToName = _form.AssignedToName,
                    UnderwriterName = _form.UnderwriterName,
                    CarrierReferenceNumber = _form.CarrierReferenceNumber,
                    AgentAuthorityCode = _form.AgentAuthorityCode,
                    ApprovalLevelCode = _form.ApprovalLevelCode,
                    BillingImpactCode = _form.BillingImpactCode,
                    CommissionImpactCode = _form.PremiumDelta == 0m && _form.TaxFeeDelta == 0m ? "NoCommissionImpact" : "RecalculateCommission",
                    DocumentDeliveryCode = _form.DocumentDeliveryCode,
                    CertificateRequired = _form.CertificateRequired,
                    ComplianceReviewRequired = _form.ComplianceReviewRequired,
                    InternalNotes = _form.InternalNotes,
                    ClientFacingNotes = _form.ClientFacingNotes,
                    Reason = _form.Reason,
                    RequiredDocuments = _form.RequiredDocuments,
                    DueDate = _form.DueDate,
                    IsUrgent = _form.IsUrgent,
                    ModifiedByUserId = _tenantAdminUserId
                });
                ShowToast("Endorsement updated.");
            }
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    void OpenDetail(PolicyEndorsementDto row) { _selected = row; _drawerRow = row; }
    void CloseDrawer() => _drawerRow = null;

    void OpenWorkflowAction(PolicyEndorsementDto row, string action)
    {
        _selected = row;
        _pendingAction = action;
        _actionForm.Reset();
        (_actionTitle, _actionIcon, _actionButtonText, _actionHelpText) = action switch
        {
            "Approve" => ("Approve endorsement", "bi-check-circle", "Approve", "Approve the endorsement and move it to approved pending issue."),
            "Decline" => ("Decline endorsement", "bi-x-circle", "Decline", "Decline this endorsement and record the reason."),
            "Issue" => ("Issue endorsement", "bi-patch-check", "Issue", "Mark the approved endorsement as issued to the policy."),
            "Request Info" => ("Request information", "bi-question-circle", "Request Info", "Move this endorsement to information needed and capture what is missing."),
            "Add Note" => ("Add workflow note", "bi-chat-left-text", "Add Note", "Add an activity note to the endorsement workflow."),
            "Add Delta" => ("Add exposure delta", "bi-arrow-left-right", "Add Delta", "Add an exposure, coverage, or premium delta to the endorsement."),
            "Archive" => ("Archive endorsement", "bi-archive", "Archive", "Archive this endorsement from the active register."),
            _ => ("Review endorsement", "bi-eye", "Start Review", "Move this endorsement into underwriting review.")
        };

        _showActionDialog = true;
    }

    void CloseActionDialog() => _showActionDialog = false;

    async Task ConfirmActionAsync()
    {
        if (_pendingAction is "Decline" or "Request Info" or "Add Note" && string.IsNullOrWhiteSpace(_actionForm.Notes))
        {
            ShowToast("Notes are required for this action.", "danger");
            return;
        }
        if (_pendingAction == "Add Delta" && string.IsNullOrWhiteSpace(_actionForm.FieldName))
        {
            ShowToast("Field name is required for exposure delta.", "danger");
            return;
        }

        _actionBusy = true;
        try
        {
            switch (_pendingAction)
            {
                case "Add Note":
                    await Api.AddPolicyEndorsementActivityAsync(new AddPolicyEndorsementActivityRequest { EndorsementId = _selected.EndorsementId, ActivityType = "Note", Subject = "Workflow note added", Notes = _actionForm.Notes, CreatedByName = "Current User", CreatedByUserId = _tenantAdminUserId });
                    ShowToast("Note added.");
                    break;
                case "Add Delta":
                    await Api.UpsertPolicyEndorsementDeltaAsync(new UpsertPolicyEndorsementDeltaRequest { EndorsementId = _selected.EndorsementId, FieldName = _actionForm.FieldName, BeforeValue = _actionForm.BeforeValue, AfterValue = _actionForm.AfterValue, NumericDelta = _actionForm.NumericDelta, CreatedByUserId = _tenantAdminUserId });
                    ShowToast("Exposure delta added.");
                    break;
                case "Archive":
                    await Api.ArchivePolicyEndorsementAsync(_selected.EndorsementId, _tenantAdminUserId);
                    ShowToast("Endorsement archived.");
                    break;
                default:
                    await UpdateStatusAsync(_selected, StatusForAction(_pendingAction), _actionForm.Notes);
                    break;
            }
            _showActionDialog = false;
            _drawerRow = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Action failed: {ex.Message}", "danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    async Task UpdateStatusAsync(PolicyEndorsementDto row, string status, string? notes = null)
    {
        await Api.UpdatePolicyEndorsementStatusAsync(row.EndorsementId, new UpdatePolicyEndorsementStatusRequest { Status = status, Notes = notes, CreatedByName = "Current User", ModifiedByUserId = _tenantAdminUserId });
        ShowToast($"Endorsement {status.ToLowerInvariant()}.");
    }

    static string StatusForAction(string action) => action switch
    {
        "Approve" => "Approved",
        "Decline" => "Declined",
        "Issue" => "Issued",
        "Request Info" => "Info Needed",
        _ => "In Review"
    };

    static string StageFor(string status) => status switch
    {
        "Pending" => "Intake",
        "In Review" => "Underwriting Review",
        "Approved" => "Approved Pending Issue",
        "Declined" => "Closed Declined",
        "Issued" => "Issued to Policy",
        "Info Needed" => "Awaiting Information",
        _ => "Intake"
    };

    async Task ExecuteMenuAction(string action)
    {
        CloseActionMenu();
        switch (action)
        {
            case "Review": OpenWorkflowAction(_selected, "Review"); break;
            case "Edit": OpenEdit(_selected); break;
            case "Approve": OpenWorkflowAction(_selected, "Approve"); break;
            case "Decline": OpenWorkflowAction(_selected, "Decline"); break;
            case "Issue": OpenWorkflowAction(_selected, "Issue"); break;
            case "Request Info": OpenWorkflowAction(_selected, "Request Info"); break;
            case "Add Note": OpenWorkflowAction(_selected, "Add Note"); break;
            case "Add Delta": OpenWorkflowAction(_selected, "Add Delta"); break;
            case "View Policy": NavigateToPolicy(_selected); break;
            case "Archive": OpenWorkflowAction(_selected, "Archive"); break;
            default: await Task.CompletedTask; break;
        }
    }

    void NavigateToPolicy(PolicyEndorsementDto row)
    {
        if (row.PolicyId is { } policyId && policyId != Guid.Empty)
            Nav.NavigateTo($"/policies/{policyId}");
        else
            Nav.NavigateTo("/policies");
    }

    IEnumerable<PolicyEndorsementActivityDto> ActivitiesFor(Guid id) => _activities.Where(a => a.EndorsementId == id).OrderByDescending(a => a.ActivityDateUtc);
    IEnumerable<PolicyEndorsementDeltaDto> DeltasFor(Guid id) => _deltas.Where(d => d.EndorsementId == id);
    static bool IsTerminal(PolicyEndorsementDto row) => row.Status is "Issued" or "Declined";

    RenderFragment EndorsementNoLink(PolicyEndorsementDto row) => builder => BuildAnchorFragment(builder, row.EndorsementNumber, $"/policies/endorsements?endorsementId={row.EndorsementId}", "ew-link-btn", EventCallback.Factory.Create(this, () => OpenDetail(row)));
    RenderFragment PolicyNoLink(PolicyEndorsementDto row) => builder => BuildAnchorFragment(builder, row.PolicyNumber, PolicyHref(row), "ew-link-btn", EventCallback.Factory.Create(this, () => NavigateToPolicy(row)));
