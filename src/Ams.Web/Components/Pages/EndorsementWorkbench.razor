    private async Task OpenTransitionDialog(PolicyEndorsementTransitionDto transition)
    {
        _selectedTransition = transition;
        _transitionNotes = string.Empty;
        _transitionValidationError = null;
        ClearRoutePreview();
        if (string.Equals(transition.ToStatusCode, "PendingApproval", StringComparison.OrdinalIgnoreCase))
            await LoadRoutePreviewAsync("Approval");
    }

    private void OpenReverseDialog()
    {
        _workflowApproval = null;
        _workflowInformationRequest = null;
        _workflowDialogAction = "Reverse";
        _workflowDialogNotes = string.Empty;
        _workflowDueDate = DateTime.Today;
        _workflowDialogValidationError = null;
    }

    private void CloseTransitionDialog()
    {
        if (_busy) return;
        _selectedTransition = null;
        _transitionNotes = string.Empty;
        _transitionValidationError = null;
    }

    private async Task ExecuteTransitionAsync()
    {
        if (_detail is null || _selectedTransition is null) return;
        if (_selectedTransition.RequiresNotes && string.IsNullOrWhiteSpace(_transitionNotes))
        {
            _transitionValidationError = $"{_selectedTransition.NotesLabel} is required.";
            return;
        }

        _busy = true;
        _transitionValidationError = null;
        try
        {
            var actionLabel = _selectedTransition.ActionLabel;
            await Api.TransitionPolicyEndorsementAsync(_detail.Endorsement.EndorsementId, new()
            {
                TenantId = _tenantId,
                ToStatusCode = _selectedTransition.ToStatusCode,
                Notes = string.IsNullOrWhiteSpace(_transitionNotes) ? null : _transitionNotes.Trim(),
                RowVersion = _detail.Endorsement.RowVersion
            });
            _selectedTransition = null;
            _transitionNotes = string.Empty;
            await LoadAsync();
            ShowSuccess($"{actionLabel} completed.");
        }
        catch (Exception ex) { ShowError($"Workflow action failed: {ex.Message}"); }
        finally { _busy = false; }
    }
    private async Task OpenApprovalDialog(PolicyEndorsementApprovalDto approval, string action)
    {
        _workflowApproval = approval;
        _workflowInformationRequest = null;
        _workflowDialogAction = action;
        _workflowDialogNotes = string.Empty;
        _workflowDueDate = action == "RequestInformation" ? DateTime.Today.AddDays(2) : null;
        _workflowDialogValidationError = null;
        ClearRoutePreview();
        if (action == "RequestInformation") await LoadRoutePreviewAsync("InformationRequest");
    }

    private void OpenInformationRequestDialog(PolicyEndorsementInformationRequestDto request, string action)
    {
        _workflowInformationRequest = request;
        _workflowApproval = null;
        _workflowDialogAction = action;
        _workflowDialogNotes = string.Empty;
        _workflowDueDate = null;
        _workflowDialogValidationError = null;
        ClearRoutePreview();
    }

    private void CloseWorkflowDialog()
    {
        if (_busy) return;
        _workflowDialogAction = null;
        _workflowDialogNotes = string.Empty;
        _workflowDueDate = null;
        _workflowDialogValidationError = null;
        _workflowApproval = null;
        _workflowInformationRequest = null;
        ClearRoutePreview();
    }

    private void ClearRoutePreview() { _routePreview = null; _routePreviewError = null; _routePreviewLoading = false; }

    private async Task LoadRoutePreviewAsync(string purpose)
    {
        if (_detail is null) return;
        _routePreviewLoading = true;
        _routePreview = null;
        _routePreviewError = null;
        try
        {
            _routePreview = await Api.GetPolicyEndorsementRoutePreviewAsync(_tenantId, _detail.Endorsement.EndorsementId, purpose);
            if (_routePreview is null) _routePreviewError = "The workflow route preview returned no result.";
            else if (!_routePreview.IsResolved)
            {
                _routePreviewError = _routePreview.ResolutionMessage ?? "No eligible recipient could be resolved from the active tenant route.";
                _routePreview = null;
            }
        }
        catch (Exception ex) { _routePreviewError = $"Routing preview unavailable: {ex.Message}"; }
        finally { _routePreviewLoading = false; }
    }

    private async Task ExecuteWorkflowDialogAsync()
    {
        if (_detail is null || _workflowDialogAction is null) return;
        if (string.IsNullOrWhiteSpace(_workflowDialogNotes))
        {
            _workflowDialogValidationError = $"{WorkflowDialogLabel} is required.";
            return;
        }

        _busy = true;
        _workflowDialogValidationError = null;
        var endorsementId = _detail.Endorsement.EndorsementId;
        try
        {
            switch (_workflowDialogAction)
            {
                case "Approve" or "Reject" when _workflowApproval is not null:
                    await Api.DecidePolicyEndorsementApprovalAsync(endorsementId, _workflowApproval.ApprovalId, new()
                    {
                        TenantId = _tenantId,
                        DecisionCode = _workflowDialogAction == "Approve" ? "Approved" : "Rejected",
                        Notes = _workflowDialogNotes.Trim(),
                        EndorsementRowVersion = _detail.Endorsement.RowVersion,
                        ApprovalRowVersion = _workflowApproval.RowVersion
                    });
                    break;
                case "Reverse" when _workflowDueDate.HasValue:
                    var reversalId = await Api.ReversePolicyEndorsementAsync(endorsementId, new()
                    {
                        TenantId = _tenantId,
                        EffectiveDate = _workflowDueDate.Value,
                        Reason = _workflowDialogNotes.Trim(),
                        RowVersion = _detail.Endorsement.RowVersion
                    });
                    await LoadAsync();
                    await SelectAsync(reversalId);
                    break;
                case "RequestInformation" when _workflowApproval is not null:
                    await Api.RequestPolicyEndorsementInformationAsync(endorsementId, new()
                    {
                        TenantId = _tenantId,
                        RequestDetails = _workflowDialogNotes.Trim(),
                        DueDateUtc = _workflowDueDate,
                        EndorsementRowVersion = _detail.Endorsement.RowVersion
                    });
                    break;
                case "Respond" when _workflowInformationRequest is not null:
                    await Api.RespondToPolicyEndorsementInformationRequestAsync(endorsementId, _workflowInformationRequest.InformationRequestId, new()
                    {
                        TenantId = _tenantId,
                        ResponseDetails = _workflowDialogNotes.Trim(),
                        EndorsementRowVersion = _detail.Endorsement.RowVersion,
                        InformationRequestRowVersion = _workflowInformationRequest.RowVersion
                    });
                    break;
                case "Resubmit" when _workflowInformationRequest is not null:
                    await Api.ResubmitPolicyEndorsementInformationRequestAsync(endorsementId, _workflowInformationRequest.InformationRequestId, new()
                    {
                        TenantId = _tenantId,
                        Notes = _workflowDialogNotes.Trim(),
                        EndorsementRowVersion = _detail.Endorsement.RowVersion,
                        InformationRequestRowVersion = _workflowInformationRequest.RowVersion
                    });
                    break;
                default:
                    throw new InvalidOperationException("The selected workflow action is no longer available.");
            }

            var completedAction = WorkflowDialogSubmitLabel;
            _workflowDialogAction = null;
            _workflowDialogNotes = string.Empty;
            _workflowApproval = null;
            _workflowInformationRequest = null;
            await LoadAsync();
            ShowSuccess($"{completedAction} completed.");
        }
        catch (Exception ex) { ShowError($"Workflow action failed: {ex.Message}"); }
        finally { _busy = false; }
    }
    private static string QueueSummary(IEnumerable<string> statuses){var values=statuses.ToList();return values.Count==0?"Not queued":string.Join(", ",values.GroupBy(x=>x).Select(x=>$"{x.Key} ({x.Count()})"));}
    private void ShowError(string message){_message=message;_messageKind="danger";}
    private void ShowSuccess(string message){_message=message;_messageKind="success";}

