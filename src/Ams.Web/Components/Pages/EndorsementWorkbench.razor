    async Task SaveEndorsementAsync()
    {
        _actionBusy = true;
        try
        {
            if (_form.EndorsementId == Guid.Empty)
            {
                await Api.CreatePolicyEndorsementAsync(new CreatePolicyEndorsementRequest
                {
                    TenantId = _tenantId,
                    PolicyId = _form.PolicyId,
                    AccountId = _form.AccountId,
                    PolicyNumber = _form.PolicyNumber,
                    AccountName = _form.AccountName,
                    LineOfBusiness = _form.LineOfBusiness,
                    Carrier = _form.Carrier,
                    EndorsementType = _form.EndorsementType,
                    Description = _form.Description,
                    EffectiveDate = _form.EffectiveDate,
                    PremiumDelta = _form.PremiumDelta,
                    Priority = _form.Priority,
                    RequestedByName = _form.RequestedByName,
                    AssignedToName = _form.AssignedToName,
                    UnderwriterName = _form.UnderwriterName,
                    Reason = _form.Reason,
                    RequiredDocuments = _form.RequiredDocuments,
                    DueDate = _form.DueDate,
                    IsUrgent = _form.IsUrgent,
                    CreatedByUserId = _tenantAdminUserId
                });
                ShowToast("Endorsement created.");
            }
            else
            {
                await Api.UpdatePolicyEndorsementAsync(_form.EndorsementId, new UpdatePolicyEndorsementRequest
                {
                    EndorsementType = _form.EndorsementType,
                    Description = _form.Description,
                    EffectiveDate = _form.EffectiveDate,
                    PremiumDelta = _form.PremiumDelta,
                    Priority = _form.Priority,
                    AssignedToName = _form.AssignedToName,
                    UnderwriterName = _form.UnderwriterName,
                    Reason = _form.Reason,
                    RequiredDocuments = _form.RequiredDocuments,
                    DueDate = _form.DueDate,
                    IsUrgent = _form.IsUrgent,
                    ModifiedByUserId = _tenantAdminUserId
                });
                ShowToast("Endorsement updated.");
            }
            _showForm = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

