    RenderFragment StatusChip(string status) => builder => BuildSpanFragment(builder, $"ew-status {StatusClass(status)}", status);
    RenderFragment DeltaCell(decimal delta) => builder => BuildSpanFragment(builder, delta == 0 ? "ew-delta-zero" : delta > 0 ? "ew-delta-pos" : "ew-delta-neg", delta == 0 ? "$0" : delta.ToString("+$#,##0;-$#,##0"));
    RenderFragment DueCell(PolicyEndorsementDto row) => builder => BuildSpanFragment(builder, DueClass(row), row.DueDate?.ToString("MM/dd/yyyy") ?? "-");
    RenderFragment CtxBtn(PolicyEndorsementDto row) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "class", "um-btn um-btn-ghost um-btn-xs ew-ctx-btn");
        builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, e => OpenActionMenu(row, e.ClientX, e.ClientY)));
        builder.OpenElement(seq++, "i");
        builder.AddAttribute(seq++, "class", "bi bi-three-dots-vertical");
        builder.AddAttribute(seq++, "aria-hidden", "true");
        builder.CloseElement();
        builder.CloseElement();
    };
    RenderFragment DrawerField(string label, string value) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "ew-meta-row");
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "ew-meta-lbl");
        builder.AddContent(seq++, label);
        builder.CloseElement();
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "ew-meta-val");
        builder.AddContent(seq++, value);
        builder.CloseElement();
        builder.CloseElement();
    };

    static void BuildAnchorFragment(RenderTreeBuilder builder, string text, string href, string css, EventCallback callback)
    {
        var seq = 0;
        builder.OpenElement(seq++, "a");
        builder.AddAttribute(seq++, "href", href);
        builder.AddAttribute(seq++, "class", css);
        builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
        builder.AddAttribute(seq++, "onclick", callback);
        builder.AddContent(seq++, text);
        builder.CloseElement();
    }

    string AccountHref(PolicyEndorsementDto row) => row.AccountId is { } accountId && accountId != Guid.Empty ? $"/accounts/{accountId}" : "/accounts";
    string PolicyHref(PolicyEndorsementDto row) => row.PolicyId is { } policyId && policyId != Guid.Empty ? $"/policies/{policyId}" : "/policies";

    static void BuildSpanFragment(RenderTreeBuilder builder, string css, string text)
    {
        var seq = 0;
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", css);
        builder.AddContent(seq++, text);
        builder.CloseElement();
    }

