    sealed class EndorsementActionForm
    {
        [StringLength(1000)] public string? Notes { get; set; }
        [StringLength(120)] public string FieldName { get; set; } = string.Empty;
        [StringLength(500)] public string BeforeValue { get; set; } = string.Empty;
        [StringLength(500)] public string AfterValue { get; set; } = string.Empty;
        [Range(-10000000, 10000000)] public decimal NumericDelta { get; set; }
