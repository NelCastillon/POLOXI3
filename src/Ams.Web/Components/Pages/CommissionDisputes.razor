@page "/commissions/disputes"
@inject ApiClient Api

<PageTitle>Commission Disputes</PageTitle>

<h1>Commission Disputes</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(CommissionDisputeDto.DisputeDate)" HeaderText="Dispute Date" Type="ColumnType.Date" Format="d" Width="150"></GridColumn>
            <GridColumn Field="@nameof(CommissionDisputeDto.DisputedAmount)" HeaderText="Disputed Amount" Format="C2" Width="160"></GridColumn>
            <GridColumn Field="@nameof(CommissionDisputeDto.StatusCode)" HeaderText="Status" Width="120"></GridColumn>
            <GridColumn Field="@nameof(CommissionDisputeDto.ResolvedDateUtc)" HeaderText="Resolved Date" Type="ColumnType.DateTime" Format="g" Width="180"></GridColumn>
            <GridColumn Field="@nameof(CommissionDisputeDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="g" Width="180"></GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<CommissionDisputeDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchCommissionDisputesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<CommissionDisputeDto>();
    }
}
