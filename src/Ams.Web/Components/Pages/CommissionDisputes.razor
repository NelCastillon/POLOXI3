@page "/commissions/disputes"
@page "/commissions/exceptions"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Commission Exceptions &amp; Disputes - AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<!-- New Dispute Dialog -->
<AppModal @bind-Visible="_showNew" Width="640px" ShowCloseIcon="false" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>Raise Exception / Dispute</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseNew"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="@_newEditContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Exception Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_newForm.ExceptionType" class="um-input">@foreach (var t in _exTypes) { <option value="@t">@t</option> }</InputSelect></div>
                    <div class="um-field"><label>Producer / Payee <span class="text-danger">*</span></label><InputText @bind-Value="_newForm.Payee" class="um-input" placeholder="Producer name..." /></div>
                    <div class="um-field"><label>Disputed Amount <span class="text-danger">*</span></label><InputNumber @bind-Value="_newForm.DisputedAmount" class="um-input" /></div>
                    <div class="um-field"><label>Policy / Statement Reference</label><InputText @bind-Value="_newForm.Reference" class="um-input" placeholder="Policy # or Statement ID..." /></div>
                    <div class="um-field um-field--full"><label>Description</label><InputTextArea @bind-Value="_newForm.Description" class="um-input" rows="3" placeholder="Describe the exception or dispute..." /></div>
                    @if (!string.IsNullOrWhiteSpace(_newFormError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_newFormError</div> }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseNew">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SubmitExceptionAsync">Submit</button></div>
        </Content>
    </DialogTemplates>
</AppModal>

<AppPageHeader Title="Commission Exceptions &amp; Disputes"
               Subtitle="Track, investigate, and resolve commission calculation errors, missing payments, and producer disputes"
               Icon="bi-exclamation-circle">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/statements")'>
            <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Statements
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/producer-ledger")'>
            <i class="bi bi-journal-text" aria-hidden="true"></i> Producer Ledger
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenNew">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> Raise Exception
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="ce-kpi-strip">
    @CeKpi("bi-exclamation-circle","Open",          _rows.Count(x=>x.Status=="Open").ToString(),           "ce-ki-red")
    @CeKpi("bi-hourglass",         "In Review",     _rows.Count(x=>x.Status=="In Review").ToString(),       "ce-ki-amber")
    @CeKpi("bi-check-circle",      "Resolved",      _rows.Count(x=>x.Status=="Resolved").ToString(),       "ce-ki-green")
    @CeKpi("bi-x-circle",          "Denied",        _rows.Count(x=>x.Status=="Denied").ToString(),         "ce-ki-gray")
    @CeKpi("bi-currency-dollar",   "$ Disputed",    Fmt(_rows.Sum(x=>x.DisputedAmount)),                    "ce-ki-red")
    @CeKpi("bi-currency-dollar",   "$ Recovered",   Fmt(_rows.Where(x=>x.Status=="Resolved").Sum(x=>x.DisputedAmount)), "ce-ki-green")
    @CeKpi("bi-calendar-x",        "Avg Days Open",  _rows.Where(x=>x.Status=="Open").Any() ? ((int)_rows.Where(x=>x.Status=="Open").Average(x=>(DateTime.Today-x.RaisedDate).TotalDays)).ToString()+" d" : "-", "ce-ki-amber")
    @CeKpi("bi-people",            "Producers",     _rows.Select(x=>x.Producer).Distinct().Count().ToString(),"ce-ki-blue")
</div>

<!-- Sub-nav -->
<div class="ce-subnav">
    <button class="ce-snav-btn ce-snav-active"><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Exceptions &amp; Disputes</button>
    <button class="ce-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/statements")'><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Statements</button>
    <button class="ce-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/producer-ledger")'><i class="bi bi-journal-text" aria-hidden="true"></i> Producer Ledger</button>
    <button class="ce-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/splits")'><i class="bi bi-scissors" aria-hidden="true"></i> Splits</button>
    <button class="ce-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/clawbacks")'><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Clawbacks</button>
    <button class="ce-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/forecast")'><i class="bi bi-graph-up" aria-hidden="true"></i> Forecast</button>
</div>

<!-- Toolbar -->
<div class="ce-toolbar">
    <AppTextBox Placeholder="Search producer, policy, description..." @bind-Value="_searchTerm" Width="280px"></AppTextBox>
    <select class="e-input ce-sel" @bind="_filterType">
        <option value="">All Types</option>
        @foreach (var t in _exTypes) { <option value="@t">@t</option> }
    </select>
    <select class="e-input ce-sel" @bind="_filterStatus">
        <option value="">All Statuses</option>
        <option value="Open">Open</option>
        <option value="In Review">In Review</option>
        <option value="Resolved">Resolved</option>
        <option value="Denied">Denied</option>
    </select>
</div>

@if (_loading)
{
    <div style="padding:2rem"><AppSpinner Visible="true" /></div>
}
else if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}
else
{
<div class="ce-grid-wrap">
    <AppGrid DataSource="FilteredRows" AllowSorting="true" AllowPaging="true" Height="520px">
        <GridPageSettings PageSize="15"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(ExRow.RaisedDate)" HeaderText="Raised" Type="ColumnType.Date" Format="d" Width="110"></GridColumn>
            <GridColumn Field="@nameof(ExRow.Producer)" HeaderText="Producer" Width="160"></GridColumn>
            <GridColumn HeaderText="Type" Width="160">
                <Template>
                    @{ var r = (ExRow)context; }
                    <span class="ce-type-chip ce-t-@r.Type.ToLower().Replace(" ","-")">@r.Type</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(ExRow.DisputedAmount)" HeaderText="Disputed" Format="C2" Width="120" TextAlign=@("Right")></GridColumn>
            <GridColumn Field="@nameof(ExRow.Reference)" HeaderText="Reference" Width="150"></GridColumn>
            <GridColumn Field="@nameof(ExRow.Description)" HeaderText="Description" Width="240"></GridColumn>
            <GridColumn HeaderText="Status" Width="110">
                <Template>
                    @{ var r2 = (ExRow)context; }
                    <span class="ce-status-chip ce-st-@r2.Status.ToLower().Replace(" ","-")">@r2.Status</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(ExRow.ResolvedDate)" HeaderText="Resolved" Type="ColumnType.Date" Format="d" Width="110"></GridColumn>
            <GridColumn HeaderText="Actions" Width="150">
                <Template>
                    @{ var r3 = (ExRow)context; }
                    <div class="ce-row-acts">
                        @if (r3.Status == "Open")
                        {
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => Review(r3)" title="Mark In Review">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                            <button class="um-btn um-btn-primary um-btn-xs" @onclick="() => Resolve(r3)" title="Resolve">
                                <i class="bi bi-check-circle" aria-hidden="true"></i> Resolve
                            </button>
                        }
                        @if (r3.Status == "In Review")
                        {
                            <button class="um-btn um-btn-primary um-btn-xs" @onclick="() => Resolve(r3)" title="Resolve">
                                <i class="bi bi-check-circle" aria-hidden="true"></i> Resolve
                            </button>
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => Deny(r3)" title="Deny">
                                <i class="bi bi-x-circle" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </AppGrid>
</div>
}

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm, _loadError;
    private string _filterType = "", _filterStatus = "";
    private bool _showNew, _loading;
    private ExceptionForm _newForm = new();
    private EditContext _newEditContext = default!;
    private string? _newFormError;
    private EnterpriseToast _toast = default!;

    private readonly List<string> _exTypes = ["Missing Payment","Rate Mismatch","Split Error","Clawback Dispute","Override Error","House Account Dispute","Calculation Error","Other"];

    private List<ExRow> _rows = [];

    private IEnumerable<ExRow> FilteredRows => _rows.Where(r =>
        (string.IsNullOrEmpty(_searchTerm)   || r.Producer.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) || r.Description.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterType)   || r.Type == _filterType) &&
        (string.IsNullOrEmpty(_filterStatus) || r.Status == _filterStatus));

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        _newEditContext = new(_newForm);
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Commissions","/commissions"), new("Exceptions",""));
        await LoadAsync();
    }

    private void OpenNew() { _newForm = new(); _newEditContext = new(_newForm); _newFormError = null; _showNew = true; }
    private void CloseNew() => _showNew = false;

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchCommissionDisputesAsync(_tenantId, _searchTerm);
            _rows = result?.Items.Select(ToRow).ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _rows = [];
        }
        finally { _loading = false; }
    }

    async Task SubmitExceptionAsync()
    {
        _newFormError = null;
        if (!_newEditContext.Validate()) return;
        try
        {
            var reason = string.Join(" - ", new[] { _newForm.ExceptionType, _newForm.Description }.Where(x => !string.IsNullOrWhiteSpace(x)));
            await Api.CreateCommissionDisputeAsync(new CreateCommissionDisputeRequest { TenantId = _tenantId, DisputeDate = DateOnly.FromDateTime(DateTime.Today), DisputeReason = reason, DisputedAmount = _newForm.DisputedAmount, Resolution = string.IsNullOrWhiteSpace(_newForm.Reference) ? null : $"Reference: {_newForm.Reference}", StatusCode = "Open" });
            _showNew = false;
            await LoadAsync();
            await _toast.ShowAsync(new ToastModel { Content = "Exception submitted.", CssClass = "enterprise-toast-success" });
        }
        catch (Exception ex)
        {
            _newFormError = $"Save failed: {ex.Message}";
            await _toast.ShowAsync(new ToastModel { Content = _newFormError, CssClass = "enterprise-toast-danger" });
        }
    }

    async Task Review(ExRow r)  { await UpdAsync(r, "In Review"); await _toast.ShowAsync(new ToastModel { Content = "Marked In Review.", CssClass = "enterprise-toast-info" }); }
    async Task Resolve(ExRow r) { await UpdAsync(r, "Resolved", DateTime.Today); await _toast.ShowAsync(new ToastModel { Content = "Exception resolved.", CssClass = "enterprise-toast-success" }); }
    async Task Deny(ExRow r)    { await UpdAsync(r, "Denied", DateTime.Today); await _toast.ShowAsync(new ToastModel { Content = "Exception denied.", CssClass = "enterprise-toast-warning" }); }

    async Task UpdAsync(ExRow r, string s, DateTime? d = null)
    {
        try
        {
            await Api.UpdateCommissionDisputeAsync(r.Id, new UpdateCommissionDisputeRequest { TenantId = _tenantId, DisputeId = r.Id, DisputeDate = DateOnly.FromDateTime(r.RaisedDate), DisputeReason = $"{r.Type} - {r.Description}", DisputedAmount = r.DisputedAmount, Resolution = r.Reference, StatusCode = s, ResolvedDateUtc = d });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Content = $"Update failed: {ex.Message}", CssClass = "enterprise-toast-danger" });
        }
    }

    static ExRow ToRow(CommissionDisputeDto item)
    {
        var parts = item.DisputeReason.Split(" - ", 2, StringSplitOptions.TrimEntries);
        return new ExRow(item.DisputeId, item.PayeeId.ToString()[..8], parts[0], item.DisputedAmount, item.Resolution ?? item.TransactionId?.ToString()[..8] ?? "", parts.Length > 1 ? parts[1] : item.DisputeReason, item.StatusCode, item.DisputeDate.ToDateTime(TimeOnly.MinValue), item.ResolvedDateUtc?.Date);
    }

    static string Fmt(decimal v) => v.ToString("C0");

    RenderFragment CeKpi(string icon, string label, string val, string color) => __builder =>
    {
        <div class="ce-kpi-card @color">
            <i class="bi @icon ce-kpi-icon" aria-hidden="true"></i>
            <div><div class="ce-kpi-val">@val</div><div class="ce-kpi-lbl">@label</div></div>
        </div>
    };

    record ExRow(Guid Id, string Producer, string Type, decimal DisputedAmount, string Reference,
                 string Description, string Status, DateTime RaisedDate, DateTime? ResolvedDate)
    {
        public string Status { get; set; } = Status;
        public DateTime? ResolvedDate { get; set; } = ResolvedDate;
    }

    private sealed class ExceptionForm
    {
        [Required, StringLength(100)] public string ExceptionType { get; set; } = "Missing Payment";
        [Required, StringLength(200)] public string Payee { get; set; } = string.Empty;
        [Range(0.01, 100000000)] public decimal DisputedAmount { get; set; }
        [StringLength(100)] public string? Reference { get; set; }
        [StringLength(1000)] public string? Description { get; set; }
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
