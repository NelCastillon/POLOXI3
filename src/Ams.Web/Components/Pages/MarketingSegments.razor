@page "/marketing/segments"
@namespace Ams.Web.Components.Pages
@using Syncfusion.Blazor.QueryBuilder
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Audience Segments — AMS</PageTitle>

<AppPageHeader Title="Audience Segments"
               Subtitle="Build and manage targeted insurance audience segments for campaign personalization"
               Icon="bi-pie-chart-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/marketing/rules-engine")'>
            <i class="bi bi-lightning-charge" aria-hidden="true"></i> Rules Engine
        </button>
        <button class="um-btn um-btn-primary" @onclick="() => _showCreate = true">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Segment
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI -->
<div class="mks-kpi-strip">
    <div class="mks-kpi-card"><div class="mks-kv">@_segments.Count</div><div class="mks-kl">Total Segments</div></div>
    <div class="mks-kpi-card"><div class="mks-kv">@_segments.Sum(s => s.Count).ToString("N0")</div><div class="mks-kl">Total Contacts</div></div>
    <div class="mks-kpi-card"><div class="mks-kv">@_segments.Count(s => s.IsDynamic)</div><div class="mks-kl">Dynamic Segments</div></div>
    <div class="mks-kpi-card"><div class="mks-kv">@_segments.Count(s => !s.IsDynamic)</div><div class="mks-kl">Static Segments</div></div>
</div>

<!-- Segment cards -->
<div class="mks-seg-grid">
    @foreach (var seg in _segments)
    {
        <div class="mks-seg-card">
            <div class="mks-seg-header">
                <div class="mks-seg-icon @seg.ColorCss"><i class="bi @seg.Icon" aria-hidden="true"></i></div>
                <div class="mks-seg-meta">
                    <div class="mks-seg-name">@seg.Name</div>
                    <span class="mks-seg-badge @(seg.IsDynamic ? "mks-dyn" : "mks-static")">@(seg.IsDynamic ? "Dynamic" : "Static")</span>
                </div>
            </div>
            <div class="mks-seg-desc">@seg.Description</div>
            <div class="mks-seg-stat">
                <span class="mks-seg-cnt">@seg.Count.ToString("N0")</span>
                <span class="mks-seg-cnt-lbl">contacts</span>
                <span class="mks-seg-updated">Updated @seg.Updated.ToString("MMM d")</span>
            </div>
            <div class="mks-seg-rules">
                @foreach (var rule in seg.Rules)
                {
                    <span class="mks-rule-chip">@rule</span>
                }
            </div>
            <div class="mks-seg-footer">
                <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => Nav.NavigateTo($"/marketing/campaigns/new")'>
                    <i class="bi bi-megaphone" aria-hidden="true"></i> Use in Campaign
                </button>
                <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => { _editSeg = seg; _showEdit = true; }">
                    <i class="bi bi-pencil" aria-hidden="true"></i> Edit
                </button>
            </div>
        </div>
    }
</div>

<!-- Create segment dialog -->
<SfDialog @bind-Visible="_showCreate" Width="680px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header><span><i class="bi bi-pie-chart" aria-hidden="true"></i> New Audience Segment</span></Header>
        <Content>
            <div style="padding:.5rem 0;display:flex;flex-direction:column;gap:.75rem">
                <div><label class="mks-dlg-lbl">Segment Name *</label>
                    <SfTextBox @bind-Value="_newName" Placeholder="e.g. SMB No Workers Comp"></SfTextBox>
                </div>
                <div><label class="mks-dlg-lbl">Description</label>
                    <SfTextBox @bind-Value="_newDesc" Multiline="true" Placeholder="Who is in this segment?"></SfTextBox>
                </div>
                <div><label class="mks-dlg-lbl">Segment Type</label>
                    <SfDropDownList TValue="string" TItem="string" DataSource='new[]{"Dynamic","Static"}' @bind-Value="_newType" Width="100%"></SfDropDownList>
                </div>
                <div>
                    <label class="mks-dlg-lbl">Segment Rules (Query Builder)</label>
                    <div class="mks-qb-wrap">
                        <SfQueryBuilder TValue="SegmentContact" @ref="_qb">
                            <QueryBuilderColumns>
                                <QueryBuilderColumn Field="AccountType"    Label="Account Type"     Type="Syncfusion.Blazor.QueryBuilder.ColumnType.String" />
                                <QueryBuilderColumn Field="Status"         Label="Account Status"   Type="Syncfusion.Blazor.QueryBuilder.ColumnType.String" />
                                <QueryBuilderColumn Field="PolicyCount"    Label="Policy Count"     Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Number" />
                                <QueryBuilderColumn Field="Lob"            Label="Line of Business" Type="Syncfusion.Blazor.QueryBuilder.ColumnType.String" />
                                <QueryBuilderColumn Field="Premium"        Label="Annual Premium"   Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Number" />
                                <QueryBuilderColumn Field="LossRatio"      Label="Loss Ratio %"     Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Number" />
                                <QueryBuilderColumn Field="LastNps"        Label="NPS Score"        Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Number" />
                                <QueryBuilderColumn Field="DaysSinceContact" Label="Days Since Contact" Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Number" />
                                <QueryBuilderColumn Field="State"          Label="State"            Type="Syncfusion.Blazor.QueryBuilder.ColumnType.String" />
                                <QueryBuilderColumn Field="ProducerName"   Label="Producer"         Type="Syncfusion.Blazor.QueryBuilder.ColumnType.String" />
                            </QueryBuilderColumns>
                        </SfQueryBuilder>
                    </div>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div style="display:flex;justify-content:flex-end;gap:.5rem;padding:.5rem 0 0">
                <button class="um-btn um-btn-ghost" @onclick="() => _showCreate = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="CommitCreateAsync"
                        disabled="@string.IsNullOrEmpty(_newName)">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Create
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    private SfToast? _toast;
    private SfQueryBuilder<SegmentContact>? _qb;
    private bool _showCreate, _showEdit;
    private string _newName = "", _newDesc = "", _newType = "Dynamic";
    private SegRow? _editSeg;

    // Stub type used only for SfQueryBuilder column schema
    private sealed class SegmentContact
    {
        public string AccountType      { get; set; } = "";
        public string Status           { get; set; } = "";
        public int    PolicyCount      { get; set; }
        public string Lob              { get; set; } = "";
        public decimal Premium         { get; set; }
        public decimal LossRatio       { get; set; }
        public int    LastNps          { get; set; }
        public int    DaysSinceContact { get; set; }
        public string State            { get; set; } = "";
        public string ProducerName     { get; set; } = "";
    }

    private List<SegRow> _segments = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Marketing","/marketing/campaigns"), new("Segments",""));
        _segments =
        [
            new("Active Commercial Clients",  "bi-building",   "mks-ic-blue",   "All commercial accounts with Active status and at least one policy",                        3_840, true,  DateTime.Today, ["Status = Active","Type = Commercial","Policies ≥ 1"]),
            new("Personal Lines Households",  "bi-house",      "mks-ic-purple", "Household accounts with personal auto or homeowners policies",                              12_400, true, DateTime.Today.AddDays(-1), ["Type = Personal","Policy: Auto OR HO"]),
            new("SMB — No Workers Comp",      "bi-briefcase",  "mks-ic-amber",  "Small business accounts without an active Workers Compensation policy",                    1_290, true,  DateTime.Today, ["Type = Commercial","Employees 1–50","NO WC policy"]),
            new("HH With Teen Drivers",       "bi-car-front",  "mks-ic-green",  "Households with a listed driver aged 16–19 and no teen driver endorsement",                2_150, true,  DateTime.Today.AddDays(-2), ["Driver age 16–19","No teen endorsement"]),
            new("BOP Holders — No Umbrella",  "bi-umbrella",   "mks-ic-red",    "Commercial BOP policyholders who do not carry an umbrella or excess liability policy",     980, true,   DateTime.Today, ["Has BOP","NO Umbrella/Excess"]),
            new("Lapsed 60–180 Days",         "bi-arrow-repeat","mks-ic-gray",  "Accounts whose most recent policy lapsed between 60 and 180 days ago",                    3_100, true,  DateTime.Today.AddDays(-1), ["Last lapse 60–180 days ago","Not re-written"]),
            new("NPS Promoters",              "bi-star-fill",  "mks-ic-gold",   "Contacts who gave an NPS score of 9 or 10 in the last 12 months",                         1_750, true,  DateTime.Today, ["NPS ≥ 9","Survey < 12mo"]),
            new("Employer Groups",            "bi-people",     "mks-ic-blue",   "Employer group accounts with 5+ enrolled employees",                                       640, false,  DateTime.Today.AddDays(-7), ["Type = Employer Group","Enrolled ≥ 5"]),
        ];
    }

    private async Task CommitCreateAsync()
    {
        // Extract rule summary chips from the query builder
        var rules = new List<string>();
        if (_qb is not null)
        {
            var sql = _qb.GetSqlFromRules();
            if (!string.IsNullOrWhiteSpace(sql))
                rules.Add(sql.Length > 60 ? sql[..60] + "…" : sql);
        }
        if (rules.Count == 0) rules.Add("(all contacts)");

        _segments.Add(new(_newName, "bi-pie-chart", "mks-ic-blue", _newDesc, 0, _newType == "Dynamic", DateTime.Today, rules));
        _showCreate = false; _newName = ""; _newDesc = ""; _newType = "Dynamic";
        await Task.Delay(0);
    }

    private sealed record SegRow(string Name, string Icon, string ColorCss, string Description, int Count, bool IsDynamic, DateTime Updated, List<string> Rules);
    private sealed record LV(string Value, string Label);
}
