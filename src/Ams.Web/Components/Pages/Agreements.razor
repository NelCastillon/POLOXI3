@page "/ops/renewals"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>Agreement Renewals</PageTitle>
<AppPageHeader Title="Agreement Renewals" Icon="bi-arrow-repeat" />

<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>

@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(AgreementRenewalDto.RenewalNumber)"      HeaderText="Renewal #"    Width="150"></GridColumn>
        <GridColumn Field="@nameof(AgreementRenewalDto.NewStartDate)"       HeaderText="New Start"    Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(AgreementRenewalDto.NewEndDate)"         HeaderText="New End"      Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(AgreementRenewalDto.TotalContractValue)" HeaderText="Contract Value" Format="C2" Width="150"></GridColumn>
        <GridColumn Field="@nameof(AgreementRenewalDto.StatusCode)"         HeaderText="Status"       Width="120"></GridColumn>
        <GridColumn Field="@nameof(AgreementRenewalDto.ProcessedDateUtc)"   HeaderText="Processed"    Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(AgreementRenewalDto.CreatedDateUtc)"     HeaderText="Created"      Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
    </GridColumns>
</SfGrid>
}

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private List<AgreementRenewalDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchAgreementRenewalsAsync(_tenantId, searchTerm: _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
