@page "/commissions/splits-legacy"
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Commissions
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject ConfirmationDialogService Confirmations
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>Split Commission Setup - AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

<!-- Create/Edit Split Rule Dialog -->
<AppModal @bind-Visible="_showCreate" Width="620px" ShowCloseIcon="true" IsModal="true">
    <DialogTemplates>
        <Header><div class="sp-dlg-hdr"><i class="bi bi-scissors" aria-hidden="true"></i> @(_editRule is null ? "New Split Rule" : "Edit Split Rule")</div></Header>
        <Content>
            <div class="sp-dlg-body">
                <div class="form-group mb-2"><label class="sp-lbl">Rule Name *</label>
                    <AppTextBox @bind-Value="_editName" Placeholder="e.g. 60/40 New Biz Sharing Rule"></AppTextBox>
                </div>
                <div class="form-group mb-2">
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem">
                        <div><label class="sp-lbl">Applies To</label>
                            <AppSelect TValue="string" TItem="string"
                                DataSource="AppliesOptions"
                                @bind-Value="_editAppliesTo" Width="100%"></AppSelect>
                        </div>
                        <div><label class="sp-lbl">Split Type</label>
                            <AppSelect TValue="string" TItem="string"
                                DataSource="SplitTypeOptions"
                                @bind-Value="_editSplitType" Width="100%"></AppSelect>
                        </div>
                    </div>
                </div>

                <!-- Producer allocation rows -->
                <label class="sp-lbl">Producer Allocations (must total 100%)</label>
                <div class="sp-alloc-list">
                    @for (int i = 0; i < _editProducers.Count; i++)
                    {
                        var idx = i;
                        var alloc = _editProducers[idx];
                        <div class="sp-alloc-row">
                            <AppTextBox Value="@alloc.Name" ValueChanged="v => _editProducers[idx] = alloc with { Name = v }" Placeholder="Producer name..." Width="180px"></AppTextBox>
                            <AppSelect TValue="string" TItem="string" Value="@alloc.Role" ValueChanged="v => _editProducers[idx] = alloc with { Role = v }"
                                DataSource="RoleOptions"
                                Width="155px"></AppSelect>
                            <AppNumericTextBox TValue="decimal" Value="@alloc.Pct" ValueChanged="v => _editProducers[idx] = alloc with { Pct = v }" Format="N1" Min="0" Max="100" Width="80px"></AppNumericTextBox>
                            <span class="sp-pct-lbl">%</span>
                            <button class="sp-rm-btn" @onclick="() => RemoveProducerAllocationAsync(idx)" title="Remove">
                                <i class="bi bi-x" aria-hidden="true"></i>
                            </button>
                        </div>
                    }
                    <div class="sp-alloc-footer">
                        <button class="sp-add-btn" @onclick='() => _editProducers.Add(new(string.Empty, "Secondary", 0m))'>
                            <i class="bi bi-plus-circle" aria-hidden="true"></i> Add Producer
                        </button>
                        <span class="sp-total @(_editProducers.Sum(p=>p.Pct) == 100 ? "sp-t-ok" : "sp-t-err")">
                            Total: @_editProducers.Sum(p=>p.Pct).ToString("N1")%
                        </span>
                    </div>
                </div>

                <div class="sp-switches">
                    <div class="sp-sw-row"><AppCheckBox Label="Branch override applies" @bind-Checked="_editBranchOverride"></AppCheckBox></div>
                    <div class="sp-sw-row"><AppCheckBox Label="House account rule" @bind-Checked="_editHouseAccount"></AppCheckBox></div>
                    <div class="sp-sw-row"><AppCheckBox Label="Clawback shared proportionally" @bind-Checked="_editSharedClawback"></AppCheckBox></div>
                </div>

                <div class="form-group mb-2"><label class="sp-lbl">Effective Date</label>
                    <AppDatePicker TValue="DateTime" @bind-Value="_editEffective" Width="100%"></AppDatePicker>
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="@(_editRule is null ? "Create Rule" : "Save Changes")" IsPrimary="true" OnClick="SaveRuleAsync"></DialogButton>
        <DialogButton Content="Cancel" OnClick="() => _showCreate = false"></DialogButton>
    </DialogButtons>
</AppModal>

<AppPageHeader Title="Split Commission Setup"
               Subtitle="Configure new business and renewal split rules, multi-producer sharing arrangements, branch overrides, and house account rules"
               Icon="bi-scissors">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/plans")'>
            <i class="bi bi-clipboard-check" aria-hidden="true"></i> Comp Plans
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/planner")'>
            <i class="bi bi-calculator" aria-hidden="true"></i> What-If Planner
        </button>
        <button class="um-btn um-btn-primary" @onclick="NewRule">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> New Split Rule
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="sp-kpi-strip">
    @SpKpi("bi-scissors",       "Total Rules",        _rules.Count.ToString(),                               "sp-ki-blue")
    @SpKpi("bi-check-circle",   "Active",             _rules.Count(r=>r.Status=="Active").ToString(),        "sp-ki-green")
    @SpKpi("bi-arrow-up-circle","New Biz Rules",      _rules.Count(r=>r.AppliesTo is "New Business" or "Both").ToString(), "sp-ki-blue")
    @SpKpi("bi-arrow-repeat",   "Renewal Rules",      _rules.Count(r=>r.AppliesTo is "Renewal" or "Both").ToString(),     "sp-ki-blue")
    @SpKpi("bi-building",       "Branch Override",    _rules.Count(r=>r.BranchOverride).ToString(),          "sp-ki-amber")
    @SpKpi("bi-house",          "House Account",      _rules.Count(r=>r.HouseAccount).ToString(),            "sp-ki-amber")
    @SpKpi("bi-people",         "Multi-Producer",     _rules.Count(r=>r.ProducerCount>2).ToString(),         "sp-ki-purple")
    @SpKpi("bi-arrow-counterclockwise","Shared Clawback",_rules.Count(r=>r.SharedClawback).ToString(),      "sp-ki-red")
</div>

<!-- Sub-nav -->
<div class="sp-subnav">
    <button class="sp-snav-btn sp-snav-active"><i class="bi bi-scissors" aria-hidden="true"></i> Split Rules</button>
    <button class="sp-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/plans")'><i class="bi bi-clipboard-check" aria-hidden="true"></i> Comp Plans</button>
    <button class="sp-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/statements")'><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Statements</button>
    <button class="sp-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/producer-ledger")'><i class="bi bi-journal-text" aria-hidden="true"></i> Producer Ledger</button>
    <button class="sp-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/exceptions")'><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Exceptions</button>
    <button class="sp-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/planner")'><i class="bi bi-calculator" aria-hidden="true"></i> What-If Planner</button>
</div>

<!-- Toolbar -->
<div class="sp-toolbar">
    <AppTextBox Placeholder="Search rule name..." @bind-Value="_searchTerm" Width="260px"></AppTextBox>
    <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
    <select class="e-input sp-sel" @bind="_filterApplies">
        <option value="">All Types</option>
        @foreach (var applies in AppliesOptions)
        {
            <option value="@applies">@applies</option>
        }
    </select>
    <select class="e-input sp-sel" @bind="_filterStatus">
        <option value="">All Statuses</option>
        @foreach (var status in StatusOptions)
        {
            <option value="@status">@status</option>
        }
    </select>
</div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}

<!-- Rules grid -->
@if (_loading)
{
    <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading split rules...</span></div>
}
else if (_rules.Count == 0)
{
    <div class="sp-empty-state">
        <i class="bi bi-scissors sp-es-icon" aria-hidden="true"></i>
        <p>No split rules configured. Create your first rule to enable multi-producer commission sharing.</p>
        <button class="um-btn um-btn-primary" @onclick="NewRule"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Split Rule</button>
    </div>
}
else
{
<div class="sp-grid-wrap">
    <AppGrid DataSource="FilteredRules" AllowSorting="true" AllowPaging="true" Height="500px">
        <GridPageSettings PageSize="12"></GridPageSettings>
        <GridColumns>
            <GridColumn HeaderText="Rule Name" Width="240">
                <Template>
                    @{ var r = (SplitRule)context; }
                    <div class="sp-rule-cell">
                        <i class="bi bi-scissors sp-rule-icon" aria-hidden="true"></i>
                        <div>
                            <div class="sp-rule-name">@r.Name</div>
                            <div class="sp-rule-type">@r.SplitType</div>
                        </div>
                    </div>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Applies To" Width="130">
                <Template>
                    @{ var r2 = (SplitRule)context; }
                    <span class="sp-applies-chip sp-a-@r2.AppliesTo.ToLower().Replace(" ","-")">@r2.AppliesTo</span>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Producers" Width="260">
                <Template>
                    @{ var r3 = (SplitRule)context; }
                    <div class="sp-producers-cell">
                        @foreach (var p in r3.Allocations)
                        {
                            <div class="sp-prod-row">
                                <span class="sp-prod-name">@p.Name</span>
                                <span class="sp-prod-role">@p.Role</span>
                                <span class="sp-prod-pct">@p.Pct.ToString("N0")%</span>
                            </div>
                        }
                    </div>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Features" Width="160">
                <Template>
                    @{ var r4 = (SplitRule)context; }
                    <div class="sp-feat-chips">
                        @if (r4.BranchOverride) { <span class="sp-feat sp-f-branch">Branch</span> }
                        @if (r4.HouseAccount)   { <span class="sp-feat sp-f-house">House</span> }
                        @if (r4.SharedClawback) { <span class="sp-feat sp-f-clawback">Shared CW</span> }
                        @if (r4.ProducerCount > 2) { <span class="sp-feat sp-f-multi">@r4.ProducerCount-way</span> }
                    </div>
                </Template>
            </GridColumn>
            <GridColumn HeaderText="Status" Width="100">
                <Template>
                    @{ var r5 = (SplitRule)context; }
                    <span class="sp-status-chip sp-st-@r5.Status.ToLower()">@r5.Status</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(SplitRule.Effective)" HeaderText="Effective" Type="ColumnType.Date" Format="d" Width="110"></GridColumn>
            <GridColumn HeaderText="Actions" Width="110">
                <Template>
                    @{ var r6 = (SplitRule)context; }
                    <div class="sp-row-acts">
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => EditRule(r6)" title="Edit">
                            <i class="bi bi-pencil" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick='() => Nav.NavigateTo("/commissions/planner")' title="Model">
                            <i class="bi bi-calculator" aria-hidden="true"></i>
                        </button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </AppGrid>
</div>
}

@code {
    private string? _searchTerm;
    private string _filterApplies = "", _filterStatus = "";
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading;
    private string? _loadError;
    private bool _showCreate;
    private SplitRule? _editRule;
    private string? _editName, _editAppliesTo = "Both", _editSplitType = "Fixed %";
    private bool _editBranchOverride, _editHouseAccount, _editSharedClawback;
    private DateTime _editEffective = DateTime.Today;
    private List<AllocRow> _editProducers = [];
    private EnterpriseToast _toast = default!;
    private List<CommissionPlanDto> _plans = [];
    private List<CommissionPayeeDto> _payees = [];
    private List<CommissionSplitRuleDto> _ruleDtos = [];

    private List<SplitRule> _rules = [];

    private IReadOnlyList<string> AppliesOptions => DistinctOptions(_rules.Select(r => r.AppliesTo), _editAppliesTo, _filterApplies);
    private IReadOnlyList<string> SplitTypeOptions => DistinctOptions(_rules.Select(r => r.SplitType), _editSplitType);
    private IReadOnlyList<string> StatusOptions => DistinctOptions(_rules.Select(r => r.Status), _filterStatus);
    private IReadOnlyList<string> RoleOptions => DistinctOptions(_rules.SelectMany(r => r.Allocations.Select(a => a.Role)), _editProducers.Select(p => p.Role).ToArray());

    private IEnumerable<SplitRule> FilteredRules => _rules.Where(r =>
        (string.IsNullOrEmpty(_searchTerm)    || r.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterApplies) || r.AppliesTo == _filterApplies) &&
        (string.IsNullOrEmpty(_filterStatus)  || r.Status == _filterStatus));

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Commissions","/commissions"), new("Split Rules", ""));
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await Api.EnsureCommissionSplitRulesSeedAsync(_tenantId, _tenantAdminUserId);
            var rulesTask = Api.SearchCommissionSplitRulesAsync(_tenantId, _searchTerm);
            var plansTask = Api.SearchCommissionPlansAsync(_tenantId, null);
            var payeesTask = Api.SearchCommissionPayeesAsync(_tenantId, null);
            await Task.WhenAll(rulesTask, plansTask, payeesTask);
            _ruleDtos = rulesTask.Result?.Items.ToList() ?? [];
            _plans = plansTask.Result?.Items.ToList() ?? [];
            _payees = payeesTask.Result?.Items.ToList() ?? [];
            _rules = _ruleDtos.Select(ToSplitRule).ToList();
        }
        catch (Exception ex)
        {
            _loadError = $"Commission split rules failed to load: {ex.Message}";
            _rules = [];
            await _toast.ShowAsync(new ToastModel { Content = $"Load failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
        finally
        {
            _loading = false;
        }
    }

    void NewRule()
    {
        _editRule = null; _editName = null;
        _editAppliesTo = _plans.FirstOrDefault()?.PlanTypeCode ?? AppliesOptions.FirstOrDefault() ?? "Standard"; _editSplitType = SplitTypeOptions.FirstOrDefault() ?? "Producer";
        _editBranchOverride = _editHouseAccount = _editSharedClawback = false;
        _editEffective = DateTime.Today;
        _editProducers = [new(PayeeLabel(null), RoleOptions.FirstOrDefault() ?? "Producer", 100m)];
        _showCreate = true;
    }

    void EditRule(SplitRule r)
    {
        _editRule = r; _editName = r.Name;
        _editAppliesTo = r.AppliesTo; _editSplitType = r.SplitType;
        _editBranchOverride = r.BranchOverride; _editHouseAccount = r.HouseAccount; _editSharedClawback = r.SharedClawback;
        _editEffective = r.Effective;
        _editProducers = r.Allocations.Select(a => new AllocRow(a.Name, a.Role, a.Pct)).ToList();
        _showCreate = true;
    }

    async Task SaveRuleAsync()
    {
        if (string.IsNullOrWhiteSpace(_editName) || _editProducers.Sum(p => p.Pct) != 100) return;
        var primaryAlloc = _editProducers.OrderByDescending(p => p.Pct).FirstOrDefault();
        var plan = _plans.FirstOrDefault(p => string.Equals(p.PlanTypeCode, _editAppliesTo, StringComparison.OrdinalIgnoreCase)) ?? _plans.FirstOrDefault();
        if (plan is null)
        {
            await _toast.ShowAsync(new ToastModel { Content = "Save failed: no commission plan is available for this tenant.", CssClass = "e-toast-danger" });
            return;
        }

        var payeeId = PayeeIdFromLabel(primaryAlloc?.Name);
        if (_editRule is null)
        {
            await Api.CreateCommissionSplitRuleAsync(new CreateCommissionSplitRuleRequest
            {
                TenantId = _tenantId,
                CommissionPlanId = plan.CommissionPlanId,
                RuleName = _editName,
                SplitTypeCode = _editSplitType!,
                PayeeId = payeeId,
                SplitPct = primaryAlloc?.Pct ?? 100m,
                OverrideRatePct = _editBranchOverride ? primaryAlloc?.Pct : null,
                EffectiveStartDate = DateOnly.FromDateTime(_editEffective),
                StatusCode = "Draft",
                CreatedByUserId = _tenantAdminUserId
            });
        }
        else
        {
            var source = _ruleDtos.First(r => r.SplitRuleId == _editRule.Id);
            await Api.UpdateCommissionSplitRuleAsync(_editRule.Id, new UpdateCommissionSplitRuleRequest
            {
                SplitRuleId = _editRule.Id,
                TenantId = _tenantId,
                CommissionPlanId = plan.CommissionPlanId,
                RuleName = _editName,
                SplitTypeCode = _editSplitType!,
                PayeeId = payeeId,
                SplitPct = primaryAlloc?.Pct ?? source.SplitPct,
                OverrideRatePct = _editBranchOverride ? primaryAlloc?.Pct : source.OverrideRatePct,
                Priority = source.Priority,
                EffectiveStartDate = DateOnly.FromDateTime(_editEffective),
                EffectiveEndDate = source.EffectiveEndDate,
                StatusCode = source.StatusCode,
                ModifiedByUserId = _tenantAdminUserId
            });
        }
        _showCreate = false;
        await LoadAsync();
        await _toast.ShowAsync(new ToastModel { Content = "Split rule saved.", CssClass = "e-toast-success" });
    }

    async Task RemoveProducerAllocationAsync(int idx)
    {
        if (idx < 0 || idx >= _editProducers.Count) return;
        if (!await Confirmations.ConfirmAsync("Remove producer allocation", "Remove this producer allocation from the split rule?", "Remove")) return;
        _editProducers.RemoveAt(idx);
    }

    RenderFragment SpKpi(string icon, string label, string val, string color) => __builder =>
    {
        <div class="sp-kpi-card @color">
            <i class="bi @icon sp-kpi-icon" aria-hidden="true"></i>
            <div><div class="sp-kpi-val">@val</div><div class="sp-kpi-lbl">@label</div></div>
        </div>
    };

    record AllocRow(string Name, string Role, decimal Pct);
    record SplitRule(Guid Id, string Name, string AppliesTo, string SplitType, List<AllocRow> Allocations,
                     bool BranchOverride, bool HouseAccount, bool SharedClawback, string Status, DateTime Effective)
    {
        public int ProducerCount => Allocations.Count;
        public string Status { get; set; } = Status;
    }

    private SplitRule ToSplitRule(CommissionSplitRuleDto rule)
    {
        var plan = _plans.FirstOrDefault(p => p.CommissionPlanId == rule.CommissionPlanId);
        var allocation = new AllocRow(PayeeLabel(rule.PayeeId), rule.SplitTypeCode, rule.SplitPct);
        return new(rule.SplitRuleId, rule.RuleName, plan?.PlanTypeCode ?? rule.SplitTypeCode, rule.SplitTypeCode, [allocation], rule.OverrideRatePct.HasValue, plan?.HouseAccountRules ?? false, false, rule.StatusCode, rule.EffectiveStartDate.ToDateTime(TimeOnly.MinValue));
    }

    private string PayeeLabel(Guid? payeeId)
    {
        if (payeeId is null) return "Unassigned payee";
        var payee = _payees.FirstOrDefault(p => p.PayeeId == payeeId.Value);
        return payee is null ? payeeId.Value.ToString()[..8] : $"{payee.PayeeTypeCode} {payee.UserId.ToString()[..8]}";
    }

    private Guid? PayeeIdFromLabel(string? label)
        => _payees.FirstOrDefault(p => string.Equals(PayeeLabel(p.PayeeId), label, StringComparison.OrdinalIgnoreCase))?.PayeeId;

    private static IReadOnlyList<string> DistinctOptions(IEnumerable<string?> values, params string?[] additionalValues)
        => values.Concat(additionalValues)
            .Where(v => !string.IsNullOrWhiteSpace(v))
            .Select(v => v!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v)
            .ToList();
}
