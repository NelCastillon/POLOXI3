@page "/tenant/workflows/rules2"
@page "/tenant/workflows/tasks2"
@page "/tenant/workflows/routing2"
@page "/tenant/workflows/sla2"
@page "/tenant/workflows/escalation2"
@page "/tenant/workflows/requests2"
@page "/tenant/workflows/renewals2"
@page "/tenant/workflows/audit2"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Workflow & SLA - AMS</PageTitle>

<AppPageHeader Title="Workflow & SLA"
               Subtitle="Tenant admin control center for workflow rules, task templates, queue routing, SLA policies, escalations, service requests, renewal workflows, and automation audit"
               Icon="bi-diagram-3-fill">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/tenant/workflows/rules")'>
            <i class="bi bi-node-plus" aria-hidden="true"></i> Workflow Rules
        </button>
    </Actions>
</AppPageHeader>

<section class="wfslacfg-hero" aria-label="Workflow and SLA setup overview">
    <div>
        <span class="wfslacfg-eyebrow">Tenant administration</span>
        <h2>Workflow & SLA Command Center</h2>
        <p>Configure task automation, queue routing, service request types, renewal workflows, SLA timers, escalation policy, and automation audit controls across the tenant.</p>
    </div>
    <div class="wfslacfg-hero-grid">
        @foreach (var action in _quickActions)
        {
            <button class="wfslacfg-quick-action" @onclick="() => Nav.NavigateTo(action.Url)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
</section>

<section class="wfslacfg-kpi-grid" aria-label="Workflow and SLA metrics">
    @Kpi("Active Rules", "64", "Workflow automations", "bi-node-plus", "wfslacfg-tone-blue")
    @Kpi("SLA Coverage", "91%", "Tasks with SLA policy", "bi-stopwatch", "wfslacfg-tone-green")
    @Kpi("Escalations", "18", "Open breach reviews", "bi-bell", "wfslacfg-tone-red")
    @Kpi("Templates", "42", "Task and request templates", "bi-check2-square", "wfslacfg-tone-violet")
</section>

<section class="wfslacfg-command-bar" aria-label="Workflow and SLA setup filters">
    <div class="wfslacfg-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search"
               placeholder="Search workflow setup, owner, queue, SLA, control..."
               @bind="_search"
               @bind:event="oninput" />
    </div>
    <div class="wfslacfg-pill-group" role="group" aria-label="Workflow setup filter">
        @foreach (var filter in _filters)
        {
            <button class="wfslacfg-pill @(_filter == filter.Key ? "wfslacfg-pill--active" : "")"
                    @onclick="() => _filter = filter.Key">
                @filter.Label
                <span>@FilterCount(filter.Key)</span>
            </button>
        }
    </div>
</section>

<section class="wfslacfg-layout">
    <div class="wfslacfg-flow" aria-label="Workflow and SLA workflow lanes">
        @foreach (var lane in _lanes)
        {
            var laneItems = FilteredWorkflow.Where(x => x.Stage == lane.Key).ToList();
            <article class="wfslacfg-lane">
                <header class="wfslacfg-lane-header">
                    <div>
                        <span class="wfslacfg-lane-title">@lane.Label</span>
                        <span class="wfslacfg-lane-subtitle">@lane.Description</span>
                    </div>
                    <span class="wfslacfg-lane-count">@laneItems.Count</span>
                </header>

                <div class="wfslacfg-lane-list">
                    @if (laneItems.Count == 0)
                    {
                        <div class="wfslacfg-empty-mini">No visible workflow items.</div>
                    }
                    else
                    {
                        @foreach (var item in laneItems)
                        {
                            <button class="wfslacfg-work-card @(item.Risk == "High" ? "wfslacfg-work-card--risk" : "")"
                                    @onclick="() => _selected = item">
                                <div class="wfslacfg-work-topline">
                                    <span class="wfslacfg-chip @ToneCss(item.Domain)">@item.Domain</span>
                                    <span class="wfslacfg-status @RiskCss(item.Risk)">@item.Risk</span>
                                </div>
                                <strong>@item.Title</strong>
                                <p>@item.Summary</p>
                                <div class="wfslacfg-work-meta">
                                    <span><i class="bi bi-person" aria-hidden="true"></i> @item.Owner</span>
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> @item.Sla</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            </article>
        }
    </div>

    <aside class="wfslacfg-admin-panel" aria-label="Tenant workflow and SLA administration controls">
        @if (_selected is null)
        {
            <div class="wfslacfg-side-empty">
                <i class="bi bi-diagram-3-fill" aria-hidden="true"></i>
                <h3>Workflow governance</h3>
                <p>Select a workflow item to inspect owner, SLA, risk, routing control, and setup module.</p>
            </div>
        }
        else
        {
            <div class="wfslacfg-detail-header">
                <span class="wfslacfg-chip @ToneCss(_selected.Domain)">@_selected.Domain</span>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected = null" aria-label="Close details">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <h3>@_selected.Title</h3>
            <p>@_selected.Summary</p>

            <dl class="wfslacfg-detail-list">
                <div><dt>Owner</dt><dd>@_selected.Owner</dd></div>
                <div><dt>Stage</dt><dd>@_selected.Stage</dd></div>
                <div><dt>Risk</dt><dd><span class="wfslacfg-status @RiskCss(_selected.Risk)">@_selected.Risk</span></dd></div>
                <div><dt>SLA</dt><dd>@_selected.Sla</dd></div>
                <div><dt>Control</dt><dd>@_selected.Control</dd></div>
            </dl>

            <div class="wfslacfg-policy-card">
                <strong>Tenant workflow controls</strong>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Workflow rules, task templates, and routing changes governed</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> SLA timers, breach thresholds, and escalation paths monitored</span>
                <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Service request, renewal automation, and audit evidence retained</span>
            </div>

            <div class="wfslacfg-detail-actions">
                <button class="um-btn um-btn-primary" @onclick="() => Nav.NavigateTo(_selected.Url)">
                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Module
                </button>
                <button class="um-btn um-btn-ghost" @onclick="() => Advance(_selected)">
                    <i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Advance
                </button>
            </div>
        }
    </aside>
</section>

<section class="wfslacfg-module-grid" aria-label="Workflow and SLA setup modules">
    @foreach (var module in _modules)
    {
        <button class="wfslacfg-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
            <span class="wfslacfg-module-icon @ToneCss(module.Domain)"><i class="bi @module.Icon" aria-hidden="true"></i></span>
            <span class="wfslacfg-module-content">
                <strong>@module.Title</strong>
                <small>@module.Description</small>
            </span>
            <i class="bi bi-chevron-right wfslacfg-module-arrow" aria-hidden="true"></i>
        </button>
    }
</section>

@code {
    private string _search = string.Empty;
    private string _filter = string.Empty;
    private WorkflowSetupItem? _selected;
    private readonly List<WorkflowSetupItem> _workflow = [];

    private readonly Lane[] _lanes =
    [
        new("Design", "Design", "Rules and templates"),
        new("Route", "Route", "Queues and requests"),
        new("Timebox", "Timebox", "SLA and renewals"),
        new("Escalate", "Escalate", "Breach handling"),
        new("Audit", "Audit", "Automation evidence")
    ];

    private readonly Filter[] _filters =
    [
        new("", "All"),
        new("risk", "High Risk"),
        new("routing", "Routing"),
        new("sla", "SLA"),
        new("audit", "Audit")
    ];

    private readonly WorkflowModule[] _modules =
    [
        new("Workflow Rules", "Configure automation triggers, conditions, actions, approvals, and pause windows.", "/tenant/workflows/rules", "bi-node-plus", "Rules"),
        new("Task Templates", "Manage reusable task templates, default owners, checklist steps, due dates, and priorities.", "/tenant/workflows/tasks", "bi-check2-square", "Templates"),
        new("Queue Routing Rules", "Control queue assignment, round robin, branch/team matching, fallback, and capacity rules.", "/tenant/workflows/routing", "bi-signpost-split", "Routing"),
        new("SLA Policies", "Define timers, business hours, pause reasons, breach thresholds, and service levels.", "/tenant/workflows/sla", "bi-stopwatch", "SLA"),
        new("Escalation Rules", "Configure breach escalation paths, notifications, manager routing, and severity policy.", "/tenant/workflows/escalation", "bi-bell", "Escalation"),
        new("Service Request Types", "Define request forms, required fields, routing, assignment, and client portal availability.", "/tenant/workflows/requests", "bi-tools", "Requests"),
        new("Renewal Workflow Rules", "Manage renewal milestones, activity creation, risk routing, and producer/CSR handoffs.", "/tenant/workflows/renewals", "bi-arrow-clockwise", "Renewals"),
        new("Automation Audit", "Review workflow changes, automation runs, skipped rules, SLA breaches, and escalation evidence.", "/tenant/workflows/audit", "bi-journal-text", "Audit")
    ];

    private readonly WorkflowModule[] _quickActions =
    [
        new("Rules", "", "/tenant/workflows/rules", "bi-node-plus", "Rules"),
        new("Routing", "", "/tenant/workflows/routing", "bi-signpost-split", "Routing"),
        new("SLA", "", "/tenant/workflows/sla", "bi-stopwatch", "SLA"),
        new("Audit", "", "/tenant/workflows/audit", "bi-journal-text", "Audit")
    ];

    private IEnumerable<WorkflowSetupItem> FilteredWorkflow => _workflow.Where(item =>
        (string.IsNullOrWhiteSpace(_filter) || _filter switch
        {
            "risk" => item.Risk == "High",
            "routing" => item.Domain is "Routing" or "Requests",
            "sla" => item.Domain is "SLA" or "Escalation",
            "audit" => item.Domain == "Audit",
            _ => true
        }) &&
        (string.IsNullOrWhiteSpace(_search) ||
         item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Domain.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
         item.Control.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(x => x.Risk == "High")
        .ThenBy(x => x.Stage)
        .ThenBy(x => x.Title);

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Workflow & SLA", "/tenant/workflows/rules"));
        BuildWorkflow();
        _selected = _workflow.FirstOrDefault(x => x.Risk == "High") ?? _workflow.FirstOrDefault();
    }

    private void BuildWorkflow()
    {
        _workflow.Clear();
        _workflow.AddRange(
        [
            new("Workflow rule approval", "Commercial claims automation rule needs condition review before tenant-wide activation.", "Rules", "High", "Design", "Diana Perez", "Today", "Workflow change approval", "/tenant/workflows/rules"),
            new("Task template refresh", "Renewal task templates need checklist and default owner updates for new service model.", "Templates", "Medium", "Design", "Sarah Kim", "This week", "Template governance", "/tenant/workflows/tasks"),
            new("Queue capacity routing", "Service request routing needs capacity and fallback changes after branch staffing update.", "Routing", "High", "Route", "James Park", "24h", "Queue routing control", "/tenant/workflows/routing"),
            new("Portal request type rollout", "Certificate and endorsement service request types require required-field validation.", "Requests", "Medium", "Route", "Maria Santos", "5 days", "Request type policy", "/tenant/workflows/requests"),
            new("SLA business hours review", "Claims and billing SLA timers must align with updated agency holidays and branch hours.", "SLA", "High", "Timebox", "Kevin Obi", "48h", "SLA timer governance", "/tenant/workflows/sla"),
            new("Renewal workflow milestone", "Renewal milestone automation needs producer/CSR handoff changes for commercial accounts.", "Renewals", "Medium", "Timebox", "Lisa Chen", "This week", "Renewal workflow policy", "/tenant/workflows/renewals"),
            new("Escalation path breach", "Open SLA breaches are not escalating to service managers for unassigned tasks.", "Escalation", "High", "Escalate", "Robert Yamamoto", "Same day", "Escalation path validation", "/tenant/workflows/escalation"),
            new("Automation audit exceptions", "Automation audit shows skipped rules and failed notification actions needing review.", "Audit", "High", "Audit", "Diana Perez", "Today", "Automation audit evidence", "/tenant/workflows/audit")
        ]);
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _filter = string.Empty;
    }

    private void Advance(WorkflowSetupItem item)
    {
        item.Stage = item.Stage switch
        {
            "Design" => "Route",
            "Route" => "Timebox",
            "Timebox" => "Escalate",
            "Escalate" => "Audit",
            _ => "Audit"
        };
    }

    private int FilterCount(string key) => key switch
    {
        "risk" => _workflow.Count(x => x.Risk == "High"),
        "routing" => _workflow.Count(x => x.Domain is "Routing" or "Requests"),
        "sla" => _workflow.Count(x => x.Domain is "SLA" or "Escalation"),
        "audit" => _workflow.Count(x => x.Domain == "Audit"),
        _ => _workflow.Count
    };

    private static string ToneCss(string domain) => domain switch
    {
        "Rules" => "wfslacfg-tone-blue",
        "Templates" => "wfslacfg-tone-violet",
        "Routing" => "wfslacfg-tone-cyan",
        "SLA" => "wfslacfg-tone-green",
        "Escalation" => "wfslacfg-tone-red",
        "Requests" => "wfslacfg-tone-amber",
        "Renewals" => "wfslacfg-tone-blue",
        "Audit" => "wfslacfg-tone-neutral",
        _ => "wfslacfg-tone-neutral"
    };

    private static string RiskCss(string risk) => risk switch
    {
        "High" => "wfslacfg-status-high",
        "Medium" => "wfslacfg-status-medium",
        _ => "wfslacfg-status-low"
    };

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="wfslacfg-kpi-card">
        <span class="wfslacfg-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span>
        <div>
            <strong>@value</strong>
            <span>@label</span>
            <small>@meta</small>
        </div>
    </article>;

    private sealed record Lane(string Key, string Label, string Description);
    private sealed record Filter(string Key, string Label);
    private sealed record WorkflowModule(string Title, string Description, string Url, string Icon, string Domain)
    {
        public string Label => Title;
    }

    private sealed class WorkflowSetupItem(string title, string summary, string domain, string risk, string stage, string owner, string sla, string control, string url)
    {
        public string Title { get; set; } = title;
        public string Summary { get; set; } = summary;
        public string Domain { get; set; } = domain;
        public string Risk { get; set; } = risk;
        public string Stage { get; set; } = stage;
        public string Owner { get; set; } = owner;
        public string Sla { get; set; } = sla;
        public string Control { get; set; } = control;
        public string Url { get; set; } = url;
    }
}
