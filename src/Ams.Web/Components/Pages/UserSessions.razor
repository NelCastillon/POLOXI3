@page "/platform/sessions"
@page "/admin/security/sessions"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>User Sessions</PageTitle>
<AppPageHeader Title="User Sessions" Icon="bi-display" />
<div class="toolbar">
    <AppTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></AppTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading?</span></div> }
else {
<AppGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(UserSessionDto.UserFullName)"          HeaderText="User"           Width="200"></GridColumn>
        <GridColumn Field="@nameof(UserSessionDto.DeviceType)"            HeaderText="Device"         Width="120"></GridColumn>
        <GridColumn Field="@nameof(UserSessionDto.IpAddress)"             HeaderText="IP Address"     Width="130"></GridColumn>
        <GridColumn Field="@nameof(UserSessionDto.LoginDateUtc)"          HeaderText="Login"          Width="160"  Format="MM/dd/yyyy HH:mm"></GridColumn>
        <GridColumn Field="@nameof(UserSessionDto.LastActivityDateUtc)"   HeaderText="Last Activity"  Width="160"  Format="MM/dd/yyyy HH:mm"></GridColumn>
        <GridColumn Field="@nameof(UserSessionDto.ExpiresDateUtc)"        HeaderText="Expires"        Width="160"  Format="MM/dd/yyyy HH:mm"></GridColumn>
        <GridColumn Field="@nameof(UserSessionDto.IsRevoked)"             HeaderText="Revoked"        Width="90" DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(UserSessionDto.RevokedReason)"         HeaderText="Revoke Reason"  Width="180"></GridColumn>
    </GridColumns>
</AppGrid>
}
@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private Guid DefaultTenantId { get; set; }
    private string? _searchTerm;
    private List<UserSessionDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchUserSessionsAsync(DefaultTenantId, searchTerm: _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
