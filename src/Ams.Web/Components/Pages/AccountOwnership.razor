@page "/client/account-ownership"
@inject ApiClient Api

<PageTitle>Account Ownership</PageTitle>
<h1>Account Ownership History</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(AccountOwnerHistoryDto.AccountName)"       HeaderText="Account"          Width="220"></GridColumn>
        <GridColumn Field="@nameof(AccountOwnerHistoryDto.PreviousOwnerName)" HeaderText="Previous Owner"   Width="180"></GridColumn>
        <GridColumn Field="@nameof(AccountOwnerHistoryDto.NewOwnerName)"      HeaderText="New Owner"        Width="180"></GridColumn>
        <GridColumn Field="@nameof(AccountOwnerHistoryDto.ChangedDateUtc)"    HeaderText="Changed"          Width="150" Format="d"></GridColumn>
        <GridColumn Field="@nameof(AccountOwnerHistoryDto.Notes)"             HeaderText="Notes"            Width="280"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<AccountOwnerHistoryDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchAccountOwnershipAsync(_tenantId, null, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
