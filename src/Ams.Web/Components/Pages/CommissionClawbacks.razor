@page "/commissions/clawbacks"
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Commission Clawbacks — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<!-- Initiate Clawback Dialog -->
<SfDialog @bind-Visible="_showNew" Width="620px" ShowCloseIcon="false" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="um-modal-header"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i><span>Initiate Clawback</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseNew"><i class="bi bi-x-lg"></i></button></div>
            <EditForm EditContext="_editContext">
                <DataAnnotationsValidator />
                <div class="um-modal-body"><div class="um-form-grid">
                    <div class="um-field"><label>Reason Code <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.ReasonCode" class="um-input">@foreach (var r in _reasonCodes) { <option value="@r">@r</option> }</InputSelect><ValidationMessage For="() => _form.ReasonCode" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Producer / Payee Note</label><InputText @bind-Value="_form.PayeeNote" class="um-input" placeholder="Producer name…" /><ValidationMessage For="() => _form.PayeeNote" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Clawback Amount <span class="text-danger">*</span></label><InputNumber @bind-Value="_form.Amount" class="um-input" /><ValidationMessage For="() => _form.Amount" class="validation-message text-danger" /></div>
                    <div class="um-field"><label>Original Transaction Reference</label><InputText @bind-Value="_form.Reference" class="um-input" placeholder="TX-… or STM-…" /><ValidationMessage For="() => _form.Reference" class="validation-message text-danger" /></div>
                    <div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_form.Notes" class="um-input" rows="3" /><ValidationMessage For="() => _form.Notes" class="validation-message text-danger" /></div>
                    @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
                </div></div>
            </EditForm>
            <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseNew">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="InitiateAsync" disabled="@_saving">@(_saving ? "Saving…" : "Initiate Clawback")</button></div>
        </Content>
    </DialogTemplates>
</SfDialog>

<!-- What-If Modeling Panel -->
<SfDialog @bind-Visible="_showModel" Width="600px" ShowCloseIcon="true" IsModal="true" Header="Clawback Impact Modeler">
    <DialogTemplates>
        <Content>
            <div class="cw-model-body">
                <p class="cw-model-intro">Simulate the net-pay impact of one or more clawbacks before approving. Adjusts for active payment plans and split arrangements.</p>
                <div class="cw-model-grid">
                    <div class="cw-mg-row cw-mg-hdr"><span>Scenario</span><span>Gross Earned</span><span>Clawback</span><span>Net Payout</span><span>Δ Impact</span></div>
                    <div class="cw-mg-row"><span>Current (no clawback)</span><span>@Fmt(GrossEarned)</span><span>—</span><span>@Fmt(GrossEarned)</span><span class="cw-pos">—</span></div>
                    <div class="cw-mg-row"><span>Pending clawbacks</span><span>@Fmt(GrossEarned)</span><span>@Fmt(PendingClawbacks)</span><span>@Fmt(GrossEarned - PendingClawbacks)</span><span class="cw-neg">−@Fmt(PendingClawbacks)</span></div>
                    <div class="cw-mg-row"><span>With payment plan (3 mo)</span><span>@Fmt(GrossEarned)</span><span>@Fmt(PendingClawbacks)</span><span>@Fmt(GrossEarned - (PendingClawbacks / 3))</span><span class="cw-neg">−@Fmt(PendingClawbacks / 3)/mo</span></div>
                    <div class="cw-mg-row"><span>Approved clawbacks</span><span>@Fmt(GrossEarned)</span><span>@Fmt(ApprovedClawbacks)</span><span>@Fmt(GrossEarned - ApprovedClawbacks)</span><span class="cw-neg">−@Fmt(ApprovedClawbacks)</span></div>
                </div>
                <div class="cw-model-note">Values are illustrative. Final amounts are calculated at batch run time.</div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Close" OnClick="() => _showModel = false"></DialogButton>
    </DialogButtons>
</SfDialog>

<AppPageHeader Title="Commission Clawbacks"
               Subtitle="Review, approve, and model commission clawbacks including payment cancellations, chargebacks, and repayment arrangements"
               Icon="bi-arrow-counterclockwise">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="() => _showModel = true">
            <i class="bi bi-calculator" aria-hidden="true"></i> Clawback Modeler
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/exceptions")'>
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i> Disputes
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenNew">
            <i class="bi bi-plus-circle" aria-hidden="true"></i> Initiate Clawback
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="cw-kpi-strip">
    @CwKpi("bi-arrow-counterclockwise","Total",    (_items?.Count ?? 0).ToString(),                                      "cw-ki-blue")
    @CwKpi("bi-hourglass",             "Pending",  (_items?.Count(x=>x.StatusCode=="Pending") ?? 0).ToString(),          "cw-ki-amber")
    @CwKpi("bi-check-circle",          "Approved", (_items?.Count(x=>x.StatusCode=="Approved") ?? 0).ToString(),         "cw-ki-green")
    @CwKpi("bi-x-circle",              "Denied",   (_items?.Count(x=>x.StatusCode=="Denied")  ?? 0).ToString(),          "cw-ki-gray")
    @CwKpi("bi-currency-dollar",       "$ Pending",Fmt(_items?.Where(x=>x.StatusCode=="Pending").Sum(x=>x.Amount)),       "cw-ki-amber")
    @CwKpi("bi-currency-dollar",       "$ Applied",Fmt(_items?.Where(x=>x.StatusCode=="Approved").Sum(x=>x.Amount)),      "cw-ki-red")
</div>

<!-- Sub-nav -->
<div class="cw-subnav">
    <button class="cw-snav-btn cw-snav-active"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Clawbacks</button>
    <button class="cw-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/statements")'><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Statements</button>
    <button class="cw-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/exceptions")'><i class="bi bi-exclamation-circle" aria-hidden="true"></i> Exceptions</button>
    <button class="cw-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/forecast")'><i class="bi bi-graph-up" aria-hidden="true"></i> Forecast</button>
    <button class="cw-snav-btn" @onclick='() => Nav.NavigateTo("/commissions/planner")'><i class="bi bi-calculator" aria-hidden="true"></i> What-If Planner</button>
</div>

<!-- Toolbar -->
<div class="cw-toolbar">
    <SfTextBox Placeholder="Search…" @bind-Value="_searchTerm" Width="270px"></SfTextBox>
    <select class="e-input cw-sel" @bind="_filterStatus">
        <option value="">All Statuses</option>
        <option value="Pending">Pending</option>
        <option value="Approved">Approved</option>
        <option value="Denied">Denied</option>
        <option value="Reversed">Reversed</option>
    </select>
    <select class="e-input cw-sel" @bind="_filterReason">
        <option value="">All Reasons</option>
        @foreach (var r in _reasonCodes) { <option value="@r">@r</option> }
    </select>
</div>

@if (_items is null)
{
    <div style="padding:2rem"><SfSpinner Visible="true" /></div>
}
else
{
<div class="cw-grid-wrap">
    <SfGrid DataSource="FilteredItems" AllowSorting="true" AllowPaging="true" Height="480px">
        <GridPageSettings PageSize="15"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(CommissionClawbackDto.ClawbackDate)" HeaderText="Date" Type="ColumnType.Date" Format="d" Width="110"></GridColumn>
            <GridColumn HeaderText="Reason" Width="180">
                <Template>
                    @{ var c = (CommissionClawbackDto)context; }
                    <span class="cw-reason-chip cw-r-@c.ReasonCode.ToLower().Replace(" ","-")">@c.ReasonCode</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(CommissionClawbackDto.Amount)" HeaderText="Amount" Format="C2" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
            <GridColumn Field="@nameof(CommissionClawbackDto.Notes)" HeaderText="Notes" Width="240"></GridColumn>
            <GridColumn HeaderText="Status" Width="110">
                <Template>
                    @{ var c2 = (CommissionClawbackDto)context; }
                    <span class="cw-status-chip cw-st-@c2.StatusCode.ToLower()">@c2.StatusCode</span>
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(CommissionClawbackDto.ApprovedDateUtc)" HeaderText="Approved" Type="ColumnType.DateTime" Format="d" Width="110"></GridColumn>
            <GridColumn HeaderText="Actions" Width="150">
                <Template>
                    @{ var c3 = (CommissionClawbackDto)context; }
                    <div class="cw-row-acts">
                        @if (c3.StatusCode == "Pending")
                        {
                            <button class="um-btn um-btn-primary um-btn-xs" @onclick:stopPropagation="true" @onclick='() => SetStatusAsync(c3, "Approved")' title="Approve">
                                <i class="bi bi-check-circle" aria-hidden="true"></i> Approve
                            </button>
                            <button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick='() => SetStatusAsync(c3, "Denied")' title="Deny">
                                <i class="bi bi-x-circle" aria-hidden="true"></i>
                            </button>
                        }
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _showModel = true" title="Model impact">
                            <i class="bi bi-calculator" aria-hidden="true"></i>
                        </button>
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
</div>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private string _filterStatus = "", _filterReason = "";
    private bool _showNew, _showModel, _saving;
    private string? _formError;
    private ClawbackForm _form = new();
    private EditContext _editContext = default!;
    private SfToast _toast = default!;

    private readonly List<string> _reasonCodes =
        ["Policy Cancellation","Non-Sufficient Funds","Policy Rescission","Fraud/Misrepresentation","Carrier Chargeback","Calculation Error","Overpayment","Other"];

    private List<CommissionClawbackDto>? _items;
    private decimal GrossEarned => (_items ?? []).Sum(x => x.Amount) + 14500m;
    private decimal PendingClawbacks => (_items ?? []).Where(x => x.StatusCode == "Pending").Sum(x => x.Amount);
    private decimal ApprovedClawbacks => (_items ?? []).Where(x => x.StatusCode == "Approved").Sum(x => x.Amount);

    private IEnumerable<CommissionClawbackDto> FilteredItems => (_items ?? []).Where(x =>
        (string.IsNullOrEmpty(_filterStatus) || x.StatusCode == _filterStatus) &&
        (string.IsNullOrEmpty(_filterReason) || x.ReasonCode == _filterReason));

    protected override async Task OnInitializedAsync()
    {
        _editContext = new(_form);
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Commissions","/commissions"), new("Clawbacks",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchCommissionClawbacksAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }

    async Task InitiateAsync()
    {
        if (!_editContext.Validate()) return;
        _saving = true;
        try
        {
            var notes = string.Join("\n", new[] { _form.Notes, string.IsNullOrWhiteSpace(_form.PayeeNote) ? null : $"Payee note: {_form.PayeeNote}", string.IsNullOrWhiteSpace(_form.Reference) ? null : $"Reference: {_form.Reference}" }.Where(x => !string.IsNullOrWhiteSpace(x)));
            await Api.CreateCommissionClawbackAsync(new CreateCommissionClawbackRequest { TenantId = _tenantId, ClawbackDate = DateOnly.FromDateTime(DateTime.UtcNow), Amount = _form.Amount, ReasonCode = _form.ReasonCode, Notes = notes, StatusCode = "Pending" });
            _showNew = false;
            await LoadAsync();
            await _toast.ShowAsync(new ToastModel { Content = "Clawback initiated.", CssClass = "e-toast-warning" });
        }
        catch (Exception ex)
        {
            _formError = $"Save failed: {ex.Message}";
            await _toast.ShowAsync(new ToastModel { Content = _formError, CssClass = "e-toast-danger" });
        }
        finally { _saving = false; }
    }

    private void OpenNew() { _form = new(); _editContext = new(_form); _formError = null; _showNew = true; }
    private void CloseNew() => _showNew = false;

    private async Task SetStatusAsync(CommissionClawbackDto item, string status)
    {
        try
        {
            await Api.UpdateCommissionClawbackAsync(item.ClawbackId, new UpdateCommissionClawbackRequest { TenantId = _tenantId, ClawbackId = item.ClawbackId, PayeeId = item.PayeeId, OriginalTransactionId = item.OriginalTransactionId, ClawbackDate = item.ClawbackDate, Amount = item.Amount, ReasonCode = item.ReasonCode, Notes = item.Notes, StatusCode = status, ApprovedDateUtc = status == "Approved" ? DateTime.UtcNow : item.ApprovedDateUtc });
            await LoadAsync();
            await _toast.ShowAsync(new ToastModel { Content = $"Clawback {status.ToLowerInvariant()}.", CssClass = status == "Approved" ? "e-toast-success" : "e-toast-warning" });
        }
        catch (Exception ex)
        {
            await _toast.ShowAsync(new ToastModel { Content = $"Update failed: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    static string Fmt(decimal? v) => v.HasValue ? v.Value.ToString("C0") : "$0";

    private sealed class ClawbackForm
    {
        [Required, StringLength(100)] public string ReasonCode { get; set; } = "Policy Cancellation";
        [StringLength(200)] public string? PayeeNote { get; set; }
        [Range(0.01, 100000000)] public decimal Amount { get; set; }
        [StringLength(100)] public string? Reference { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
    }

    RenderFragment CwKpi(string icon, string label, string val, string color) => __builder =>
    {
        <div class="cw-kpi-card @color">
            <i class="bi @icon cw-kpi-icon" aria-hidden="true"></i>
            <div><div class="cw-kpi-val">@val</div><div class="cw-kpi-lbl">@label</div></div>
        </div>
    };
}
