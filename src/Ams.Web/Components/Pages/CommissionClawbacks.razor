@page "/commissions/clawbacks"
@inject ApiClient Api

<PageTitle>Commission Clawbacks</PageTitle>

<h1>Commission Clawbacks</h1>

<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>

@if (_items is null)
{
    <p>Loading...</p>
}
else
{
    <SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
        <GridPageSettings PageSize="10"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(CommissionClawbackDto.ClawbackDate)" HeaderText="Clawback Date" Type="ColumnType.Date" Format="d" Width="150"></GridColumn>
            <GridColumn Field="@nameof(CommissionClawbackDto.Amount)" HeaderText="Amount" Format="C2" Width="130"></GridColumn>
            <GridColumn Field="@nameof(CommissionClawbackDto.ReasonCode)" HeaderText="Reason" Width="140"></GridColumn>
            <GridColumn Field="@nameof(CommissionClawbackDto.StatusCode)" HeaderText="Status" Width="120"></GridColumn>
            <GridColumn Field="@nameof(CommissionClawbackDto.ApprovedDateUtc)" HeaderText="Approved Date" Type="ColumnType.DateTime" Format="g" Width="180"></GridColumn>
            <GridColumn Field="@nameof(CommissionClawbackDto.CreatedDateUtc)" HeaderText="Created" Type="ColumnType.DateTime" Format="g" Width="180"></GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<CommissionClawbackDto>? _items;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SearchCommissionClawbacksAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? new List<CommissionClawbackDto>();
    }
}
