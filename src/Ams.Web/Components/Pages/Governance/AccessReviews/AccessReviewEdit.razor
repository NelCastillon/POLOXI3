@page "/governance/access-reviews/new"
@page "/governance/access-reviews/{Id:guid}/edit"
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Governance
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav

<PageTitle>@(IsEdit ? "Edit Campaign" : "New Campaign")</PageTitle>

<div class="are-shell">

    <!-- -- Header ------------------------------------------------------------ -->
    <div class="are-header">
        <nav class="are-breadcrumb" aria-label="breadcrumb">
            <a href="/governance" class="are-bc-link">Governance</a>
            <span class="are-bc-sep" aria-hidden="true">?</span>
            <a href="/governance/access-reviews" class="are-bc-link">Access Reviews</a>
            <span class="are-bc-sep" aria-hidden="true">?</span>
            <span class="are-bc-current">@(IsEdit ? "Edit Campaign" : "New Campaign")</span>
        </nav>
        <h1 class="are-title">
            <i class="bi @(IsEdit ? "bi-pencil-square" : "bi-clipboard2-plus")" aria-hidden="true"></i>
            @(IsEdit ? "Edit Campaign" : "New Access Review Campaign")
        </h1>
    </div>

    @if (_loading)
    {
        <div class="are-loading">
            <span class="um-spin" aria-hidden="true"></span>
            Loading?
        </div>
    }
    else
    {
        <div class="are-card">

            <!-- Section: Campaign Details -->
            <div class="are-section">
                <div class="are-section-header">
                    <span class="are-section-num">1</span>
                    <div>
                        <h3 class="are-section-title">Campaign Details</h3>
                        <p class="are-section-sub">Basic information about this review campaign.</p>
                    </div>
                </div>
                <div class="are-field-grid">
                    <div class="are-field are-field--full">
                        <label class="are-label">Campaign Name <span class="are-req">*</span></label>
                        <AppTextBox @bind-Value="_form.CampaignName"
                                   Placeholder="e.g. Q2 2025 Role Access Review" />
                        @if (_validate && string.IsNullOrWhiteSpace(_form.CampaignName))
                        {
                            <span class="are-validation">Campaign name is required.</span>
                        }
                    </div>
                    <div class="are-field are-field--full">
                        <label class="are-label">Description <span class="are-optional">(optional)</span></label>
                        <AppTextBox @bind-Value="_form.Description"
                                   Multiline="true"
                                   Placeholder="Describe the purpose and scope of this review?"
                                   HtmlAttributes="@(new Dictionary<string, object> { ["rows"] = "3" })" />
                    </div>
                </div>
            </div>

            <!-- Section: Scope -->
            <div class="are-section">
                <div class="are-section-header">
                    <span class="are-section-num">2</span>
                    <div>
                        <h3 class="are-section-title">Review Scope</h3>
                        <p class="are-section-sub">Which users and access types are included in this review.</p>
                    </div>
                </div>
                <div class="are-field-grid">
                    <div class="are-field">
                        <label class="are-label">Scope Type <span class="are-req">*</span></label>
                        <AppSelect TValue="string" TItem="LabelValue"
                                        DataSource="@_scopeOptions"
                                        @bind-Value="_form.ScopeTypeCode"
                                        Placeholder="Select scope">
                            
                        </AppSelect>
                    </div>
                    @if (_form.ScopeTypeCode == "ByRole")
                    {
                        <div class="are-field">
                            <label class="are-label">Role <span class="are-req">*</span></label>
                            <AppSelect TValue="Guid?" TItem="RoleDto"
                                            DataSource="@_roles"
                                            @bind-Value="_form.ScopeReferenceId"
                                            AllowFiltering="true"
                                            Placeholder="Search for a role?">
                                
                            </AppSelect>
                            @if (_validate && _form.ScopeTypeCode == "ByRole" && _form.ScopeReferenceId is null)
                            {
                                <span class="are-validation">Please select a role for the scope.</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Section: Reviewer -->
            <div class="are-section">
                <div class="are-section-header">
                    <span class="are-section-num">3</span>
                    <div>
                        <h3 class="are-section-title">Reviewer</h3>
                        <p class="are-section-sub">The user responsible for reviewing all items in this campaign.</p>
                    </div>
                </div>
                <div class="are-field-grid">
                    <div class="are-field are-field--full">
                        <label class="are-label">Reviewer <span class="are-req">*</span></label>
                        <AppSelect TValue="Guid" TItem="UserDto"
                                        DataSource="@_users"
                                        @bind-Value="_form.ReviewerUserId"
                                        AllowFiltering="true"
                                        Placeholder="Search for a user?">
                            
                        </AppSelect>
                        @if (_validate && _form.ReviewerUserId == Guid.Empty)
                        {
                            <span class="are-validation">Please select a reviewer.</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Section: Timeline -->
            <div class="are-section">
                <div class="are-section-header">
                    <span class="are-section-num">4</span>
                    <div>
                        <h3 class="are-section-title">Review Window</h3>
                        <p class="are-section-sub">The period within which reviews must be completed.</p>
                    </div>
                </div>
                <div class="are-field-grid">
                    <div class="are-field">
                        <label class="are-label">Start Date <span class="are-req">*</span></label>
                        <AppDatePicker TValue="DateTime" @bind-Value="_form.StartDateUtc"
                                      Format="dd MMM yyyy"
                                      Placeholder="Select start date" />
                    </div>
                    <div class="are-field">
                        <label class="are-label">End Date <span class="are-req">*</span></label>
                        <AppDatePicker TValue="DateTime" @bind-Value="_form.EndDateUtc"
                                      Format="dd MMM yyyy"
                                      Placeholder="Select end date"
                                      Min="@_form.StartDateUtc" />
                        @if (_validate && _form.EndDateUtc <= _form.StartDateUtc)
                        {
                            <span class="are-validation">End date must be after start date.</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Error -->
            @if (!string.IsNullOrEmpty(_saveError))
            {
                <div class="are-save-error">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    @_saveError
                </div>
            }

            <!-- Footer -->
            <div class="are-footer">
                <a href="/governance/access-reviews" class="um-btn um-btn-ghost">Cancel</a>
                <button class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="um-spin" aria-hidden="true"></span>
                        <span>Saving?</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                        <span>@(IsEdit ? "Save Changes" : "Create Campaign")</span>
                    }
                </button>
            </div>

        </div>
    }
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    [Parameter] public Guid? Id { get; set; }

    // -- Constants --------------------------------------------------------------
    private Guid _tenantId;
    private Guid _currentUserId;

    // -- State ------------------------------------------------------------------
    private bool    _loading   = true;
    private bool    _saving    = false;
    private bool    _validate  = false;
    private string  _saveError = string.Empty;

    // -- Reference data ---------------------------------------------------------
    private List<UserDto> _users = [];
    private List<RoleDto> _roles = [];

    // -- Form model -------------------------------------------------------------
    private CampaignFormModel _form = new();

    // -- Computed ---------------------------------------------------------------
    private bool IsEdit => Id.HasValue;

    // -- Options ----------------------------------------------------------------
    private static readonly List<LabelValue> _scopeOptions =
    [
        new("AllUsers", "All Users"),
        new("ByRole",   "By Role"),
    ];

    // -- Lifecycle --------------------------------------------------------------
    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        try
        {
            var userResult = await Api.SearchUsersForStatusAsync(_tenantId, pageSize: 500);
            _users = userResult?.Items?.ToList() ?? [];

            var roleResult = await Api.SearchRolesAsync(_tenantId);
            _roles = roleResult?.Items?.ToList() ?? [];

            if (IsEdit && Id.HasValue)
            {
                var campaign = await Api.GetAccessReviewCampaignByIdAsync(Id.Value);
                if (campaign is not null)
                {
                    _form = new CampaignFormModel
                    {
                        CampaignName     = campaign.CampaignName,
                        Description      = campaign.Description,
                        ScopeTypeCode    = campaign.ScopeTypeCode,
                        ScopeReferenceId = campaign.ScopeReferenceId,
                        ReviewerUserId   = campaign.ReviewerUserId,
                        StartDateUtc     = campaign.StartDateUtc,
                        EndDateUtc       = campaign.EndDateUtc,
                    };
                }
            }
        }
        finally
        {
            _loading = false;
        }
    }

    // -- Save -------------------------------------------------------------------
    private async Task SaveAsync()
    {
        _validate  = true;
        _saveError = string.Empty;

        if (!IsFormValid()) return;

        _saving = true;
        try
        {
            if (IsEdit && Id.HasValue)
            {
                await Api.UpdateAccessReviewCampaignAsync(Id.Value, new UpdateAccessReviewCampaignRequest
                {
                    CampaignName     = _form.CampaignName,
                    Description      = _form.Description,
                    ScopeTypeCode    = _form.ScopeTypeCode,
                    ScopeReferenceId = _form.ScopeReferenceId,
                    ReviewerUserId   = _form.ReviewerUserId,
                    StartDateUtc     = _form.StartDateUtc,
                    EndDateUtc       = _form.EndDateUtc,
                    ModifiedByUserId = _currentUserId,
                });
                Nav.NavigateTo($"/governance/access-reviews/{Id.Value}");
            }
            else
            {
                var id = await Api.CreateAccessReviewCampaignAsync(new CreateAccessReviewCampaignRequest
                {
                    TenantId         = _tenantId,
                    CampaignName     = _form.CampaignName,
                    Description      = _form.Description,
                    ScopeTypeCode    = _form.ScopeTypeCode,
                    ScopeReferenceId = _form.ScopeReferenceId,
                    ReviewerUserId   = _form.ReviewerUserId,
                    StartDateUtc     = _form.StartDateUtc,
                    EndDateUtc       = _form.EndDateUtc,
                    CreatedByUserId  = _currentUserId,
                });
                Nav.NavigateTo($"/governance/access-reviews/{id}");
            }
        }
        catch
        {
            _saveError = "An error occurred while saving. Please try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private bool IsFormValid()
    {
        if (string.IsNullOrWhiteSpace(_form.CampaignName))         return false;
        if (_form.ReviewerUserId == Guid.Empty)                     return false;
        if (_form.EndDateUtc <= _form.StartDateUtc)                 return false;
        if (_form.ScopeTypeCode == "ByRole" && _form.ScopeReferenceId is null) return false;
        return true;
    }

    // -- Inner types ------------------------------------------------------------
    private sealed class CampaignFormModel
    {
        public string   CampaignName     { get; set; } = string.Empty;
        public string?  Description      { get; set; }
        public string   ScopeTypeCode    { get; set; } = "AllUsers";
        public Guid?    ScopeReferenceId { get; set; }
        public Guid     ReviewerUserId   { get; set; } = Guid.Empty;
        public DateTime StartDateUtc     { get; set; } = DateTime.Today;
        public DateTime EndDateUtc       { get; set; } = DateTime.Today.AddDays(30);
    }

    private sealed record LabelValue(string Value, string Label);

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
