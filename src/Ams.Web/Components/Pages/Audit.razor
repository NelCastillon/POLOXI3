@page "/audit2"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>Audit, Compliance &amp; Record History</PageTitle>

<AppPageHeader Title="Audit, Compliance & Record History" Icon="bi-grid" />

<SfTab>
    <TabItems>
        @* ── 1. CRUD History ─────────────────────────────────── *@
        <TabItem>
            <ChildContent>
                <TabHeader Text="CRUD History"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <SfTextBox Placeholder="Search entities / actions..." @bind-Value="_auditSearch" Width="300px"></SfTextBox>
                    <SfButton CssClass="e-primary" OnClick="LoadAuditAsync">Search</SfButton>
                </div>

                @if (_auditItems is null)
                {
                    <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading�</span></div>
                }
                else
                {
                    <SfGrid DataSource="_auditItems" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(AuditLogDto.EntityName)" HeaderText="Entity" Width="150"></GridColumn>
                            <GridColumn Field="@nameof(AuditLogDto.EntityId)" HeaderText="Entity ID" Width="260"></GridColumn>
                            <GridColumn Field="@nameof(AuditLogDto.EventTypeCode)" HeaderText="Event" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(AuditLogDto.ActionName)" HeaderText="Action" Width="130"></GridColumn>
                            <GridColumn Field="@nameof(AuditLogDto.PerformedByUserId)" HeaderText="User" Width="260"></GridColumn>
                            <GridColumn Field="@nameof(AuditLogDto.PerformedDateUtc)" HeaderText="Date (UTC)" Type="ColumnType.DateTime" Format="yyyy-MM-dd HH:mm:ss" Width="180"></GridColumn>
                        </GridColumns>
                    </SfGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* ── 2. Field-Level Changes ──────────────────────────── *@
        <TabItem>
            <ChildContent>
                <TabHeader Text="Field Changes"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <SfTextBox Placeholder="Entity name..." @bind-Value="_fieldEntityFilter" Width="200px"></SfTextBox>
                    <SfTextBox Placeholder="Field name..." @bind-Value="_fieldNameFilter" Width="200px"></SfTextBox>
                    <SfButton CssClass="e-primary" OnClick="LoadFieldChangesAsync">Search</SfButton>
                </div>

                @if (_fieldChanges is null)
                {
                    <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading�</span></div>
                }
                else
                {
                    <SfGrid DataSource="_fieldChanges" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(FieldChangeLogDto.EntityName)" HeaderText="Entity" Width="140"></GridColumn>
                            <GridColumn Field="@nameof(FieldChangeLogDto.EntityId)" HeaderText="Entity ID" Width="250"></GridColumn>
                            <GridColumn Field="@nameof(FieldChangeLogDto.FieldName)" HeaderText="Field" Width="140"></GridColumn>
                            <GridColumn Field="@nameof(FieldChangeLogDto.OldValue)" HeaderText="Old Value" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(FieldChangeLogDto.NewValue)" HeaderText="New Value" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(FieldChangeLogDto.ChangedByUserId)" HeaderText="Changed By" Width="250"></GridColumn>
                            <GridColumn Field="@nameof(FieldChangeLogDto.ChangedDateUtc)" HeaderText="Date (UTC)" Type="ColumnType.DateTime" Format="yyyy-MM-dd HH:mm:ss" Width="180"></GridColumn>
                            <GridColumn Field="@nameof(FieldChangeLogDto.ChangeSource)" HeaderText="Source" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(FieldChangeLogDto.IpAddress)" HeaderText="IP" Width="130"></GridColumn>
                        </GridColumns>
                    </SfGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* ── 3. Approval History ─────────────────────────────── *@
        <TabItem>
            <ChildContent>
                <TabHeader Text="Approval History"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <SfTextBox Placeholder="Action code filter..." @bind-Value="_approvalActionFilter" Width="220px"></SfTextBox>
                    <SfButton CssClass="e-primary" OnClick="LoadApprovalHistoryAsync">Search</SfButton>
                </div>

                @if (_approvalHistory is null)
                {
                    <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading�</span></div>
                }
                else
                {
                    <SfGrid DataSource="_approvalHistory" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(WorkflowApprovalHistoryDto.WorkflowInstanceId)" HeaderText="Workflow" Width="260"></GridColumn>
                            <GridColumn Field="@nameof(WorkflowApprovalHistoryDto.ActionCode)" HeaderText="Action" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(WorkflowApprovalHistoryDto.PreviousStatusCode)" HeaderText="Previous" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(WorkflowApprovalHistoryDto.NewStatusCode)" HeaderText="New" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(WorkflowApprovalHistoryDto.ActorUserId)" HeaderText="Actor" Width="260"></GridColumn>
                            <GridColumn Field="@nameof(WorkflowApprovalHistoryDto.IsDelegated)" HeaderText="Delegated" Width="100" Type="ColumnType.Boolean"></GridColumn>
                            <GridColumn Field="@nameof(WorkflowApprovalHistoryDto.Notes)" HeaderText="Notes" Width="200"></GridColumn>
                            <GridColumn Field="@nameof(WorkflowApprovalHistoryDto.ActionDateUtc)" HeaderText="Date (UTC)" Type="ColumnType.DateTime" Format="yyyy-MM-dd HH:mm:ss" Width="180"></GridColumn>
                        </GridColumns>
                    </SfGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* ── 4. Security Events ──────────────────────────────── *@
        <TabItem>
            <ChildContent>
                <TabHeader Text="Security Events"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <SfTextBox Placeholder="Search events..." @bind-Value="_securitySearch" Width="260px"></SfTextBox>
                    <SfDropDownList TItem="SuccessFilter" TValue="string" DataSource="_successFilters" @bind-Value="_securitySuccessFilter" Width="160px" Placeholder="Status">
                        <DropDownListFieldSettings Text="Label" Value="Value"></DropDownListFieldSettings>
                    </SfDropDownList>
                    <SfButton CssClass="e-primary" OnClick="LoadSecurityEventsAsync">Search</SfButton>
                </div>

                @if (_securityEvents is null)
                {
                    <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading�</span></div>
                }
                else
                {
                    <SfGrid DataSource="_securityEvents" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(SecurityEventLogDto.EventTypeCode)" HeaderText="Event Type" Width="140"></GridColumn>
                            <GridColumn Field="@nameof(SecurityEventLogDto.EventDescription)" HeaderText="Description" Width="240"></GridColumn>
                            <GridColumn Field="@nameof(SecurityEventLogDto.IsSuccess)" HeaderText="Success" Width="90" Type="ColumnType.Boolean"></GridColumn>
                            <GridColumn Field="@nameof(SecurityEventLogDto.RiskScore)" HeaderText="Risk" Width="80"></GridColumn>
                            <GridColumn Field="@nameof(SecurityEventLogDto.UserId)" HeaderText="User" Width="250"></GridColumn>
                            <GridColumn Field="@nameof(SecurityEventLogDto.IpAddress)" HeaderText="IP" Width="140"></GridColumn>
                            <GridColumn Field="@nameof(SecurityEventLogDto.UserAgent)" HeaderText="User Agent" Width="200"></GridColumn>
                            <GridColumn Field="@nameof(SecurityEventLogDto.CreatedDateUtc)" HeaderText="Date (UTC)" Type="ColumnType.DateTime" Format="yyyy-MM-dd HH:mm:ss" Width="180"></GridColumn>
                        </GridColumns>
                    </SfGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* ── 5. Export/Download History ───────────────────────── *@
        <TabItem>
            <ChildContent>
                <TabHeader Text="Export History"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <SfTextBox Placeholder="Entity name..." @bind-Value="_exportEntityFilter" Width="200px"></SfTextBox>
                    <SfTextBox Placeholder="Export type..." @bind-Value="_exportTypeFilter" Width="200px"></SfTextBox>
                    <SfButton CssClass="e-primary" OnClick="LoadExportLogsAsync">Search</SfButton>
                </div>

                @if (_exportLogs is null)
                {
                    <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading�</span></div>
                }
                else
                {
                    <SfGrid DataSource="_exportLogs" AllowPaging="true" AllowSorting="true" Height="460px">
                        <GridPageSettings PageSize="15"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(ExportLogDto.EntityName)" HeaderText="Entity" Width="140"></GridColumn>
                            <GridColumn Field="@nameof(ExportLogDto.ExportTypeCode)" HeaderText="Type" Width="120"></GridColumn>
                            <GridColumn Field="@nameof(ExportLogDto.FileName)" HeaderText="File" Width="200"></GridColumn>
                            <GridColumn Field="@nameof(ExportLogDto.FormatCode)" HeaderText="Format" Width="90"></GridColumn>
                            <GridColumn Field="@nameof(ExportLogDto.RecordCount)" HeaderText="Records" Width="90"></GridColumn>
                            <GridColumn Field="@nameof(ExportLogDto.PerformedByUserId)" HeaderText="User" Width="250"></GridColumn>
                            <GridColumn Field="@nameof(ExportLogDto.IpAddress)" HeaderText="IP" Width="130"></GridColumn>
                            <GridColumn Field="@nameof(ExportLogDto.CreatedDateUtc)" HeaderText="Date (UTC)" Type="ColumnType.DateTime" Format="yyyy-MM-dd HH:mm:ss" Width="180"></GridColumn>
                        </GridColumns>
                    </SfGrid>
                }
            </ContentTemplate>
        </TabItem>

        @* ── 6. Record Timeline ──────────────────────────────── *@
        <TabItem>
            <ChildContent>
                <TabHeader Text="Record Timeline"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <SfTextBox Placeholder="Entity name (e.g. Account)" @bind-Value="_timelineEntityName" Width="200px"></SfTextBox>
                    <SfTextBox Placeholder="Entity ID (GUID)" @bind-Value="_timelineEntityIdText" Width="300px"></SfTextBox>
                    <SfButton CssClass="e-primary" OnClick="LoadTimelineAsync">Load Timeline</SfButton>
                </div>

                @if (_timelineEntries is not null)
                {
                    <SfGrid DataSource="_timelineEntries" AllowSorting="true" Height="460px">
                        <GridColumns>
                            <GridColumn Field="@nameof(RecordTimelineEntryDto.OccurredDateUtc)" HeaderText="Date (UTC)" Type="ColumnType.DateTime" Format="yyyy-MM-dd HH:mm:ss" Width="180"></GridColumn>
                            <GridColumn Field="@nameof(RecordTimelineEntryDto.SourceType)" HeaderText="Source" Width="110"></GridColumn>
                            <GridColumn Field="@nameof(RecordTimelineEntryDto.Summary)" HeaderText="Summary" Width="280"></GridColumn>
                            <GridColumn Field="@nameof(RecordTimelineEntryDto.Detail)" HeaderText="Detail" Width="300"></GridColumn>
                            <GridColumn Field="@nameof(RecordTimelineEntryDto.PerformedByUserId)" HeaderText="User" Width="260"></GridColumn>
                        </GridColumns>
                    </SfGrid>
                }
                else
                {
                    <p class="text-muted">Enter an entity name and ID, then click <strong>Load Timeline</strong>.</p>
                }
            </ContentTemplate>
        </TabItem>

        @* ── 7. Retention Policies ───────────────────────────── *@
        <TabItem>
            <ChildContent>
                <TabHeader Text="Retention Policies"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="display:flex;gap:8px;align-items:center;margin:12px 0;">
                    <SfTextBox Placeholder="Search policies..." @bind-Value="_retentionSearch" Width="260px"></SfTextBox>
                    <SfButton CssClass="e-primary" OnClick="LoadRetentionPoliciesAsync">Search</SfButton>
                    <SfButton CssClass="e-success" OnClick="OpenNewRetentionPolicy">+ New Policy</SfButton>
                </div>

                @if (_retentionPolicies is null)
                {
                    <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading�</span></div>
                }
                else
                {
                    <SfGrid DataSource="_retentionPolicies" AllowPaging="true" AllowSorting="true" Height="400px">
                        <GridPageSettings PageSize="10"></GridPageSettings>
                        <GridEvents RowSelected="OnRetentionRowSelected" TValue="RetentionPolicyDto"></GridEvents>
                        <GridColumns>
                            <GridColumn Field="@nameof(RetentionPolicyDto.EntityName)" HeaderText="Entity" Width="150"></GridColumn>
                            <GridColumn Field="@nameof(RetentionPolicyDto.RetentionDays)" HeaderText="Days" Width="80"></GridColumn>
                            <GridColumn Field="@nameof(RetentionPolicyDto.ActionCode)" HeaderText="Action" Width="100"></GridColumn>
                            <GridColumn Field="@nameof(RetentionPolicyDto.IsEnabled)" HeaderText="Enabled" Width="90" Type="ColumnType.Boolean"></GridColumn>
                            <GridColumn Field="@nameof(RetentionPolicyDto.Description)" HeaderText="Description" Width="240"></GridColumn>
                            <GridColumn Field="@nameof(RetentionPolicyDto.LastAppliedDateUtc)" HeaderText="Last Applied" Type="ColumnType.DateTime" Format="yyyy-MM-dd HH:mm" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(RetentionPolicyDto.LastAppliedCount)" HeaderText="Affected" Width="90"></GridColumn>
                            <GridColumn HeaderText="Actions" Width="100">
                                <Template>
                                    @{
                                        var ctx = (context as RetentionPolicyDto)!;
                                    }
                                    <SfButton CssClass="e-warning e-small" OnClick="() => ApplyPolicyAsync(ctx.RetentionPolicyId)">Apply</SfButton>
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                }

                @* Retention Policy dialog *@
                <SfDialog @bind-Visible="_showRetentionDialog" Width="520px" Header="@(_isEditingRetention ? "Edit Retention Policy" : "New Retention Policy")" IsModal="true" ShowCloseIcon="true">
                    <DialogTemplates>
                        <Content>
                            <div style="display:flex;flex-direction:column;gap:12px;padding:8px;">
                                <label>Entity Name</label>
                                <SfDropDownList TItem="string" TValue="string" DataSource="_retentionEntityOptions" @bind-Value="_retentionEntityName" Placeholder="Select entity..."></SfDropDownList>

                                <label>Retention Days</label>
                                <SfNumericTextBox TValue="int" @bind-Value="_retentionDays" Min="1" Max="36500" Format="N0"></SfNumericTextBox>

                                <label>Action</label>
                                <SfDropDownList TItem="string" TValue="string" DataSource="_retentionActionOptions" @bind-Value="_retentionAction" Placeholder="Select action..."></SfDropDownList>

                                <label>Description</label>
                                <SfTextBox @bind-Value="_retentionDescription" Multiline="true"></SfTextBox>

                                @if (_isEditingRetention)
                                {
                                    <div style="display:flex;align-items:center;gap:6px;">
                                        <SfCheckBox @bind-Checked="_retentionEnabled" Label="Enabled"></SfCheckBox>
                                    </div>
                                }
                            </div>
                        </Content>
                    </DialogTemplates>
                    <DialogButtons>
                        <DialogButton Content="Save" CssClass="e-primary" OnClick="SaveRetentionPolicyAsync"></DialogButton>
                        <DialogButton Content="Cancel" OnClick="() => _showRetentionDialog = false"></DialogButton>
                    </DialogButtons>
                </SfDialog>
            </ContentTemplate>
        </TabItem>
    </TabItems>
</SfTab>

<SfToast @ref="_toast" Timeout="3000">
    <ToastPosition X="Right" Y="Top"></ToastPosition>
</SfToast>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private SfToast _toast = default!;

    // ── 1. CRUD History ─────────────────────────────────────
    private string? _auditSearch;
    private List<AuditLogDto>? _auditItems;

    // ── 2. Field Changes ────────────────────────────────────
    private string? _fieldEntityFilter;
    private string? _fieldNameFilter;
    private List<FieldChangeLogDto>? _fieldChanges;

    // ── 3. Approval History ─────────────────────────────────
    private string? _approvalActionFilter;
    private List<WorkflowApprovalHistoryDto>? _approvalHistory;

    // ── 4. Security Events ──────────────────────────────────
    private string? _securitySearch;
    private string? _securitySuccessFilter;
    private List<SecurityEventLogDto>? _securityEvents;
    private readonly List<SuccessFilter> _successFilters = new()
    {
        new("All", ""),
        new("Success", "true"),
        new("Failed", "false")
    };

    // ── 5. Export History ───────────────────────────────────
    private string? _exportEntityFilter;
    private string? _exportTypeFilter;
    private List<ExportLogDto>? _exportLogs;

    // ── 6. Record Timeline ──────────────────────────────────
    private string? _timelineEntityName;
    private string? _timelineEntityIdText;
    private List<RecordTimelineEntryDto>? _timelineEntries;

    // ── 7. Retention Policies ───────────────────────────────
    private string? _retentionSearch;
    private List<RetentionPolicyDto>? _retentionPolicies;
    private bool _showRetentionDialog;
    private bool _isEditingRetention;
    private Guid? _editingRetentionId;
    private string _retentionEntityName = string.Empty;
    private int _retentionDays = 365;
    private string _retentionAction = "Archive";
    private string? _retentionDescription;
    private bool _retentionEnabled = true;

    private readonly List<string> _retentionEntityOptions = new()
    {
        "AuditLog", "FieldChangeLog", "SecurityEventLog", "ExportLog"
    };
    private readonly List<string> _retentionActionOptions = new() { "Archive", "Delete" };

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        await LoadAuditAsync();
    }

    // ── Load methods ────────────────────────────────────────

    private async Task LoadAuditAsync()
    {
        var result = await Api.SearchAuditAsync(_tenantId, _auditSearch);
        _auditItems = result?.Items.ToList() ?? [];
    }

    private async Task LoadFieldChangesAsync()
    {
        var entity = string.IsNullOrWhiteSpace(_fieldEntityFilter) ? null : _fieldEntityFilter;
        var field = string.IsNullOrWhiteSpace(_fieldNameFilter) ? null : _fieldNameFilter;
        var result = await Api.SearchFieldChangesAsync(_tenantId, entity, fieldName: field);
        _fieldChanges = result?.Items.ToList() ?? [];
    }

    private async Task LoadApprovalHistoryAsync()
    {
        var action = string.IsNullOrWhiteSpace(_approvalActionFilter) ? null : _approvalActionFilter;
        var result = await Api.SearchApprovalHistoryAsync(_tenantId, actionCode: action);
        _approvalHistory = result?.Items.ToList() ?? [];
    }

    private async Task LoadSecurityEventsAsync()
    {
        bool? isSuccess = _securitySuccessFilter switch
        {
            "true" => true,
            "false" => false,
            _ => null
        };
        var result = await Api.SearchSecurityEventsAsync(_tenantId, _securitySearch, isSuccess);
        _securityEvents = result?.Items.ToList() ?? [];
    }

    private async Task LoadExportLogsAsync()
    {
        var entity = string.IsNullOrWhiteSpace(_exportEntityFilter) ? null : _exportEntityFilter;
        var type = string.IsNullOrWhiteSpace(_exportTypeFilter) ? null : _exportTypeFilter;
        var result = await Api.SearchExportLogsAsync(_tenantId, entity, type);
        _exportLogs = result?.Items.ToList() ?? [];
    }

    private async Task LoadTimelineAsync()
    {
        if (string.IsNullOrWhiteSpace(_timelineEntityName) || !Guid.TryParse(_timelineEntityIdText, out var entityId))
        {
            await _toast.ShowAsync(new ToastModel { Title = "Validation", Content = "Enter both entity name and a valid GUID.", CssClass = "e-toast-warning" });
            return;
        }
        var items = await Api.GetRecordTimelineAsync(_tenantId, _timelineEntityName, entityId);
        _timelineEntries = items?.ToList() ?? [];
    }

    private async Task LoadRetentionPoliciesAsync()
    {
        var result = await Api.SearchRetentionPoliciesAsync(_tenantId, _retentionSearch);
        _retentionPolicies = result?.Items.ToList() ?? [];
    }

    // ── Retention policy CRUD ───────────────────────────────

    private void OpenNewRetentionPolicy()
    {
        _isEditingRetention = false;
        _editingRetentionId = null;
        _retentionEntityName = "AuditLog";
        _retentionDays = 365;
        _retentionAction = "Archive";
        _retentionDescription = null;
        _retentionEnabled = true;
        _showRetentionDialog = true;
    }

    private void OnRetentionRowSelected(RowSelectEventArgs<RetentionPolicyDto> args)
    {
        var p = args.Data;
        _isEditingRetention = true;
        _editingRetentionId = p.RetentionPolicyId;
        _retentionEntityName = p.EntityName;
        _retentionDays = p.RetentionDays;
        _retentionAction = p.ActionCode;
        _retentionDescription = p.Description;
        _retentionEnabled = p.IsEnabled;
        _showRetentionDialog = true;
    }

    private async Task SaveRetentionPolicyAsync()
    {
        if (_isEditingRetention && _editingRetentionId.HasValue)
        {
            await Api.UpdateRetentionPolicyAsync(new UpdateRetentionPolicyRequest
            {
                RetentionPolicyId = _editingRetentionId.Value,
                RetentionDays = _retentionDays,
                ActionCode = _retentionAction,
                IsEnabled = _retentionEnabled,
                Description = _retentionDescription
            });
            await _toast.ShowAsync(new ToastModel { Title = "Updated", Content = "Retention policy updated.", CssClass = "e-toast-success" });
        }
        else
        {
            await Api.CreateRetentionPolicyAsync(new CreateRetentionPolicyRequest
            {
                TenantId = _tenantId,
                EntityName = _retentionEntityName,
                RetentionDays = _retentionDays,
                ActionCode = _retentionAction,
                Description = _retentionDescription
            });
            await _toast.ShowAsync(new ToastModel { Title = "Created", Content = "Retention policy created.", CssClass = "e-toast-success" });
        }
        _showRetentionDialog = false;
        await LoadRetentionPoliciesAsync();
    }

    private async Task ApplyPolicyAsync(Guid policyId)
    {
        var affected = await Api.ApplyRetentionPolicyAsync(policyId);
        await _toast.ShowAsync(new ToastModel { Title = "Applied", Content = $"Policy applied. {affected} records affected.", CssClass = "e-toast-info" });
        await LoadRetentionPoliciesAsync();
    }

    // ── Helper types ────────────────────────────────────────
    private sealed record SuccessFilter(string Label, string Value);

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
