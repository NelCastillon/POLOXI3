@page "/client/account-notes"
@inject ApiClient Api

<PageTitle>Account Notes</PageTitle>
<h1>Account Notes</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(AccountNoteDto.AccountName)"  HeaderText="Account"    Width="220"></GridColumn>
        <GridColumn Field="@nameof(AccountNoteDto.NoteTypeCode)" HeaderText="Type"       Width="120"></GridColumn>
        <GridColumn Field="@nameof(AccountNoteDto.NoteText)"     HeaderText="Note"       Width="400"></GridColumn>
        <GridColumn Field="@nameof(AccountNoteDto.CreatedDateUtc)" HeaderText="Created"  Width="160" Format="d"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<AccountNoteDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchAccountNotesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
