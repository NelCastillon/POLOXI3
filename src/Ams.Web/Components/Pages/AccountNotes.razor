@page "/client/account-notes"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.AccountNotes
@using Ams.Web.Components.Pages.Accounts

<PageTitle>Account Notes — Tenant Admin</PageTitle>

<AppPageHeader Title="Account Notes" Subtitle="Tenant Admin notes and account observations" Icon="bi-sticky"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New Note</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<section class="ma-hero acct-hero"><div><span class="ma-eyebrow">Tenant Admin · Account Intelligence</span><h2>Account Notes Workspace</h2><p>Track critical observations, follow-up items, risk flags, and account context across the tenant.</p></div></section>
<div class="pc-kpi-strip acct-kpi-strip"><div class="pc-kpi-card @(_activeFilter is null ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter(null)'><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-sticky"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Notes</div></div></div><div class="pc-kpi-card @(_activeFilter == "Critical" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Critical")'><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-exclamation-circle"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.NoteTypeCode == "Critical")</div><div class="pc-kpi-label">Critical</div></div></div><div class="pc-kpi-card @(_activeFilter == "Risk" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Risk")'><span class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-shield-exclamation"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.NoteTypeCode == "Risk")</div><div class="pc-kpi-label">Risk</div></div></div><div class="pc-kpi-card @(_activeFilter == "today" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("today")'><span class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-calendar-check"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.CreatedDateUtc.Date == DateTime.UtcNow.Date)</div><div class="pc-kpi-label">Today</div></div></div></div>
<div class="ma-filter-bar acct-filter-bar"><div class="ma-search-wrap"><i class="bi bi-search"></i><input class="ma-search" value="@_search" @oninput="OnSearchChanged" placeholder="Search account or note text…" /></div><button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters"><i class="bi bi-x"></i> Reset</button><span class="ma-filter-count">@Filtered.Count() notes</span></div>
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>@_loadError</div> }
<div class="ma-content acct-timeline-card">@if (_loading) { <div class="mt-loading"><div class="um-spinner"></div><span>Loading notes…</span></div> }<div class="ma-feed">@foreach (var note in Filtered.OrderByDescending(x => x.CreatedDateUtc)) { <div class="ma-feed-item"><div class="ma-feed-icon acct-tone-@(note.NoteTypeCode == "Critical" ? "danger" : note.NoteTypeCode == "Risk" ? "warning" : "info")"><i class="bi bi-sticky"></i></div><div class="ma-feed-body"><div class="ma-feed-hdr"><span class="ma-feed-acct">@note.AccountName</span><span class="ma-type-chip acct-tone-info">@note.NoteTypeCode</span></div><div class="ma-feed-notes">@note.NoteText</div><div class="ma-feed-meta"><span><i class="bi bi-clock"></i> @note.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span></div></div></div> } @if (!Filtered.Any()) { <div class="ma-empty"><i class="bi bi-sticky ma-empty-icon"></i><span>No notes match current filters.</span></div> }</div></div>
<SfDialog @bind-Visible="_showForm" Width="640px" IsModal="true" ShowCloseIcon="false"><DialogContent><div class="um-modal-header"><i class="bi bi-sticky"></i><span>New Account Note</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Account <span class="text-danger">*</span></label><InputSelect @bind-Value="_accountId" class="um-input"><option value="">Select account</option>@foreach (var a in _accounts) { <option value="@a.AccountId">@a.AccountName</option> }</InputSelect></div><div class="um-field"><label>Type</label><InputSelect @bind-Value="_noteType" class="um-input"><option>General</option><option>FollowUp</option><option>Issue</option><option>Opportunity</option><option>Risk</option><option>Critical</option></InputSelect></div><div class="um-field um-field--full"><label>Note Text <span class="text-danger">*</span></label><InputTextArea @bind-Value="_noteText" class="um-input" rows="5" /></div></div></div><div class="um-modal-footer"><button class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">Save</button></div></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" />
@code { List<AccountNoteDto> _items = []; List<AccountDto> _accounts = []; Guid? _accountId; string _search = string.Empty, _noteText = string.Empty, _noteType = "General"; string? _activeFilter, _loadError; bool _loading, _saving, _showForm; SfToast _toast = default!; IEnumerable<AccountNoteDto> Filtered => _items.Where(x => (_activeFilter switch { "today" => x.CreatedDateUtc.Date == DateTime.UtcNow.Date, null => true, _ => x.NoteTypeCode == _activeFilter }) && (string.IsNullOrWhiteSpace(_search) || x.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase) || x.NoteText.Contains(_search, StringComparison.OrdinalIgnoreCase))); protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Accounts", "/accounts"), new("Account Notes")); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { _items = (await Api.SearchAccountNotesAsync(AccountPageConstants.TenantId))?.Items.ToList() ?? []; _accounts = (await Api.SearchAccountsAsync(AccountPageConstants.TenantId))?.Items.ToList() ?? []; } catch (Exception ex) { _loadError = $"Failed to load notes: {ex.Message}"; } finally { _loading = false; } } void OpenCreate() { _accountId = null; _noteText = string.Empty; _noteType = "General"; _showForm = true; } async Task SaveAsync() { if (!_accountId.HasValue || string.IsNullOrWhiteSpace(_noteText)) return; _saving = true; try { await Api.CreateAccountNoteAsync(new CreateAccountNoteRequest { TenantId = AccountPageConstants.TenantId, AccountId = _accountId.Value, NoteText = _noteText, NoteTypeCode = _noteType }); _showForm = false; await _toast.ShowAsync(new() { Content = "Note saved", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } void OnSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; } void SetFilter(string? key) { _activeFilter = key; } void ResetFilters() { _activeFilter = null; _search = string.Empty; } }
