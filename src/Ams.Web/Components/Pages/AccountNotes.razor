@page "/client/account-notes"
@namespace Ams.Web.Components.Pages
@using Microsoft.AspNetCore.Components
@using Ams.Application.Features.AccountNotes
@using Ams.Application.Common.Dtos
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Account Notes</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<AppPageHeader Title="Account Notes"
               Subtitle="Internal notes and observations across all accounts"
               Icon="bi-sticky">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise @(_loading ? "acn-spin" : "")" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-primary" @onclick="NewNote">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> New Note
        </button>
    </Actions>
</AppPageHeader>

<!-- KPI Strip -->
<div class="acn-kpi-strip">
    <div class="acn-kpi-card">
        <span class="acn-ki acn-ki1"><i class="bi bi-sticky" aria-hidden="true"></i></span>
        <div><div class="acn-kv">@_items?.Count ?? 0</div><div class="acn-kl">Total Notes</div></div>
    </div>
    <div class="acn-kpi-card">
        <span class="acn-ki acn-ki2"><i class="bi bi-exclamation-circle" aria-hidden="true"></i></span>
        <div><div class="acn-kv">@(_items?.Count(n => n.NoteTypeCode == "Critical") ?? 0)</div><div class="acn-kl">Critical</div></div>
    </div>
    <div class="acn-kpi-card">
        <span class="acn-ki acn-ki3"><i class="bi bi-clock-history" aria-hidden="true"></i></span>
        <div><div class="acn-kv">@(_items?.Count(n => n.CreatedDateUtc.Date == DateTime.Now.Date) ?? 0)</div><div class="acn-kl">Today</div></div>
    </div>
    <div class="acn-kpi-card">
        <span class="acn-ki acn-ki4"><i class="bi bi-tag" aria-hidden="true"></i></span>
        <div><div class="acn-kv">@(_items?.Select(n => n.AccountName).Distinct().Count() ?? 0)</div><div class="acn-kl">Accounts</div></div>
    </div>
</div>

<!-- Filter bar -->
<div class="acn-filter-bar">
    <div class="acn-search-wrap">
        <i class="bi bi-search acn-si" aria-hidden="true"></i>
        <input class="acn-search" type="search" placeholder="Search by account, note content…"
               value="@_search"
               @oninput="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => UpdateSearch(e))" />
    </div>
    <SfDropDownList TValue="string" TItem="LV" DataSource="_typeOpts" Placeholder="All Types" ShowClearButton="true" Width="130px"
                    Value="_filterType" ValueChanged="@((string v) => { _filterType = v; ApplyFilters(); })">
        <DropDownListFieldSettings Value="Value" Text="Label" />
    </SfDropDownList>
</div>

@if (_loading)
{
    <div class="acn-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading notes…</span></div>
}
else if (_items == null || _items.Count == 0)
{
    <div class="acn-empty">
        <i class="bi bi-inbox" aria-hidden="true"></i>
        <span>No account notes yet. <button class="um-link" @onclick="NewNote">Create one now.</button></span>
    </div>
}
else if (_filtered.Count == 0)
{
    <div class="acn-empty">
        <i class="bi bi-search" aria-hidden="true"></i>
        <span>No notes match your filters.</span>
    </div>
}
else
{
    <div class="acn-list">
        @foreach (var note in _filtered.OrderByDescending(n => n.CreatedDateUtc))
        {
            <div class="acn-card">
                <div class="acn-card-header">
                    <div class="acn-header-left">
                        <div class="acn-account-badge">
                            <span class="acn-account-initial">@GetInitial(note.AccountName)</span>
                        </div>
                        <div class="acn-header-info">
                            <div class="acn-account">@note.AccountName</div>
                            <div class="acn-meta">
                                <span class="acn-date">@note.CreatedDateUtc.ToString("MMM d, yyyy")</span>
                                <span class="acn-separator">·</span>
                                <span class="acn-time">@note.CreatedDateUtc.ToString("h:mm tt")</span>
                            </div>
                        </div>
                    </div>
                    <div class="acn-badges">
                        @if (!string.IsNullOrEmpty(note.NoteTypeCode))
                        {
                            <span class="@TypeBadge(note.NoteTypeCode)">@note.NoteTypeCode</span>
                        }
                    </div>
                </div>

                <div class="acn-card-body">
                    <div class="acn-content">@note.NoteText</div>
                </div>

                <div class="acn-card-footer">
                    <div class="acn-footer-left">
                        <span class="acn-footer-meta">by System</span>
                    </div>
                    <div class="acn-actions">
                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => EditNote(note)" title="Edit">
                            <i class="bi bi-pencil" aria-hidden="true"></i>
                        </button>
                        <button class="um-btn um-btn-ghost um-btn-sm um-btn-danger" @onclick="() => DeleteNoteAsync(note)" title="Delete">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Create/Edit Note Modal -->
<SfDialog @bind-Visible="_showModal" Width="600px" IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <span class="acn-dlg-hdr">
                <i class="bi @(_editingNote?.AccountNoteId == Guid.Empty ? "bi-plus-lg" : "bi-pencil")" aria-hidden="true"></i>
                @(_editingNote?.AccountNoteId == Guid.Empty ? "New Note" : "Edit Note")
            </span>
        </Header>
        <Content>
            <div class="acn-dlg-body">
                <div style="display:grid;grid-template-columns:1fr;gap:.75rem">
                    <div>
                        <label class="acn-label">Account *</label>
                        <SfDropDownList TValue="Guid" TItem="LV<Guid>" DataSource="_accountOpts" Placeholder="Select account" Width="100%"
                                        @bind-Value="_selectedAccountId">
                            <DropDownListFieldSettings Value="Data" Text="Label" />
                        </SfDropDownList>
                    </div>

                    <div>
                        <label class="acn-label">Note Content *</label>
                        <textarea class="acn-textarea" placeholder="Enter your note…" @bind="_editingNote.NoteText" style="height:140px;"></textarea>
                    </div>

                    <div>
                        <label class="acn-label">Note Type</label>
                        <SfDropDownList TValue="string" TItem="LV" DataSource="_typeOpts" Placeholder="Select type" Width="100%"
                                        @bind-Value="_editingNote.NoteTypeCode" ShowClearButton="true">
                            <DropDownListFieldSettings Value="Value" Text="Label" />
                        </SfDropDownList>
                    </div>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="acn-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showModal = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="SaveNoteAsync" disabled="@(!IsNoteFormValid())">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Save
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

@code {
    private Guid _tenantId = Guid.Empty;
    private Guid _currentUserId = Guid.Empty;

    private SfToast? _toast;
    private bool _loading = false;
    private bool _showModal = false;

    private string _search = string.Empty;
    private string _filterType = string.Empty;
    private Guid _selectedAccountId = Guid.Empty;

    private List<AccountNoteDto>? _items;
    private List<AccountNoteDto> _filtered = [];
    private AccountNoteDto _editingNote = new();
    private List<LV<Guid>> _accountOpts = [];

    private static readonly List<LV> _typeOpts = [
        new("General", "General"),
        new("FollowUp", "Follow-up"),
        new("Issue", "Issue"),
        new("Opportunity", "Opportunity"),
        new("Risk", "Risk"),
        new("Critical", "Critical")
    ];

    protected override async Task OnInitializedAsync()
    {
        _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001"); // TODO: Get from auth context
        _currentUserId = Guid.Parse("00000000-0000-0000-0000-000000000001"); // TODO: Get from auth context

        Breadcrumbs.SetCrumbs(
            new("Home", "/"),
            new("Accounts", "/accounts"),
            new("Account Notes", "/client/account-notes")
        );
        await LoadAsync();
    }

    private void UpdateSearch(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        ApplyFilters();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        try
        {
            // Load notes from database via API
            var result = await Api.SearchAccountNotesAsync(_tenantId, string.Empty);
            _items = result?.Items?.ToList() ?? [];

            // Load accounts for dropdown
            var accounts = await Api.SearchAccountsAsync(_tenantId, string.Empty);
            _accountOpts = accounts?.Items?.Select(a => new LV<Guid>(a.AccountId.ToString(), a.AccountName, a.AccountId)).ToList() ?? [];

            ApplyFilters();
        }
        catch (Exception ex)
        {
            await _toast!.ShowAsync(new ToastModel { Content = $"Error loading notes: {ex.Message}", CssClass = "e-toast-danger" });
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilters()
    {
        if (_items == null) { _filtered = []; return; }

        _filtered = _items.Where(n =>
            (string.IsNullOrEmpty(_filterType) || n.NoteTypeCode == _filterType) &&
            (string.IsNullOrEmpty(_search) ||
             n.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             n.NoteText.Contains(_search, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    }

    private void NewNote()
    {
        _editingNote = new AccountNoteDto 
        { 
            TenantId = _tenantId,
            CreatedDateUtc = DateTime.UtcNow
        };
        _selectedAccountId = Guid.Empty;
        _showModal = true;
    }

    private void EditNote(AccountNoteDto note)
    {
        _editingNote = new AccountNoteDto
        {
            AccountNoteId = note.AccountNoteId,
            TenantId = note.TenantId,
            AccountId = note.AccountId,
            AccountName = note.AccountName,
            NoteText = note.NoteText,
            NoteTypeCode = note.NoteTypeCode,
            CreatedDateUtc = note.CreatedDateUtc,
            CreatedByUserId = note.CreatedByUserId
        };
        _selectedAccountId = note.AccountId;
        _showModal = true;
    }

    private bool IsNoteFormValid()
    {
        return _selectedAccountId != Guid.Empty && !string.IsNullOrEmpty(_editingNote.NoteText);
    }

    private async Task SaveNoteAsync()
    {
        try
        {
            if (!IsNoteFormValid())
            {
                await _toast!.ShowAsync(new ToastModel { Content = "Please fill in all required fields.", CssClass = "e-toast-warning" });
                return;
            }

            // Create request for new note or update
            var request = new CreateAccountNoteRequest
            {
                TenantId = _tenantId,
                AccountId = _selectedAccountId,
                NoteText = _editingNote.NoteText,
                NoteTypeCode = _editingNote.NoteTypeCode ?? "General",
                CreatedByUserId = _currentUserId
            };

            // Call API to create/update note
            var noteId = await Api.CreateAccountNoteAsync(request);

            _showModal = false;
            _editingNote = new();
            _selectedAccountId = Guid.Empty;
            await _toast!.ShowAsync(new ToastModel { Content = "Note saved successfully.", CssClass = "e-toast-success" });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await _toast!.ShowAsync(new ToastModel { Content = $"Error saving note: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    private async Task DeleteNoteAsync(AccountNoteDto note)
    {
        if (!await ConfirmDeleteAsync()) return;

        try
        {
            // TODO: Add delete method to ApiClient
            // await Api.DeleteAccountNoteAsync(note.AccountNoteId);

            await _toast!.ShowAsync(new ToastModel { Content = "Note deleted.", CssClass = "e-toast-success" });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await _toast!.ShowAsync(new ToastModel { Content = $"Error deleting note: {ex.Message}", CssClass = "e-toast-danger" });
        }
    }

    private async Task<bool> ConfirmDeleteAsync()
    {
        return await Task.FromResult(true);
    }

    private static string GetInitial(string accountName)
    {
        return string.IsNullOrEmpty(accountName) ? "?" : accountName[0].ToString().ToUpper();
    }

    private static string TypeBadge(string? type) => type switch
    {
        "Critical" => "acn-type acn-type--critical",
        "Risk" => "acn-type acn-type--risk",
        "Opportunity" => "acn-type acn-type--opportunity",
        "Issue" => "acn-type acn-type--issue",
        "FollowUp" => "acn-type acn-type--followup",
        _ => "acn-type acn-type--general",
    };

    private sealed record LV(string Value, string Label);

    private sealed record LV<T>(string Value, string Label, T Data) 
        where T : struct
    {
        public static implicit operator T(LV<T> item) => item.Data;
    }
}
