@page "/ops/amendments"
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Operations
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Amendments</PageTitle>

@if (_toastVisible)
{
    <div class="amd-toast amd-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIcon" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="amd-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="amd-enterprise-page">
    <section class="amd-hero">
        <div class="amd-hero-left">
            <span class="amd-hero-icon"><i class="bi bi-pencil-square" aria-hidden="true"></i></span>
            <div>
                <div class="amd-title-row">
                    <h1>Amendments</h1>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> DB synced</span>
                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> Approval controlled</span>
                </div>
                <p>Enterprise amendment command center for agreement changes, approval state, effective dates, contract governance, client-facing adjustments, and operational amendment workflow.</p>
            </div>
        </div>
        <div class="amd-hero-actions">
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "amd-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="ExportAsync" disabled="@(!_items.Any())"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
            <button type="button" class="um-btn um-btn-ghost" @onclick="OpenAgreements"><i class="bi bi-file-earmark-check" aria-hidden="true"></i> Agreements</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Amendment</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="amd-error-banner" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@_loadError</span></div>
    }

    <section class="amd-kpi-strip" aria-label="Amendment KPIs">
        <button type="button" class="@AllKpiClass" @onclick="ShowAll"><span class="amd-kpi-icon"><i class="bi bi-pencil-square" aria-hidden="true"></i></span><span><strong>@_items.Count</strong><em>Total</em><small>Tenant amendments</small></span></button>
        <button type="button" class="@DraftKpiClass" @onclick="ShowDraft"><span class="amd-kpi-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span><span><strong>@DraftCount</strong><em>Draft</em><small>In preparation</small></span></button>
        <button type="button" class="@PendingKpiClass" @onclick="ShowPending"><span class="amd-kpi-icon"><i class="bi bi-send-check" aria-hidden="true"></i></span><span><strong>@PendingCount</strong><em>Pending</em><small>Awaiting approval</small></span></button>
        <button type="button" class="@ApprovedKpiClass" @onclick="ShowApproved"><span class="amd-kpi-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span><span><strong>@ApprovedCount</strong><em>Approved</em><small>Authorized changes</small></span></button>
        <button type="button" class="@EffectiveKpiClass" @onclick="ShowEffective"><span class="amd-kpi-icon"><i class="bi bi-calendar2-check" aria-hidden="true"></i></span><span><strong>@EffectiveSoonCount</strong><em>Effective Soon</em><small>Next 30 days</small></span></button>
        <button type="button" class="@ReviewKpiClass" @onclick="ShowReview"><span class="amd-kpi-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></span><span><strong>@NeedsReviewCount</strong><em>Needs Review</em><small>Rejected or incomplete</small></span></button>
    </section>

    <section class="amd-workflow-strip" aria-label="Amendment workflows">
        <button type="button" class="amd-workflow-card" @onclick="ShowLibrary"><i class="bi bi-kanban" aria-hidden="true"></i><span><strong>Library</strong><small>Amendment register</small></span></button>
        <button type="button" class="amd-workflow-card" @onclick="ShowLifecycleView"><i class="bi bi-calendar-range" aria-hidden="true"></i><span><strong>Lifecycle</strong><small>Effective dates</small></span></button>
        <button type="button" class="amd-workflow-card" @onclick="ShowGovernance"><i class="bi bi-shield-check" aria-hidden="true"></i><span><strong>Governance</strong><small>Approval lanes</small></span></button>
        <button type="button" class="amd-workflow-card" @onclick="OpenActivities"><i class="bi bi-clock-history" aria-hidden="true"></i><span><strong>Activities</strong><small>Operational history</small></span></button>
        <button type="button" class="amd-workflow-card" @onclick="OpenCreate"><i class="bi bi-plus-circle" aria-hidden="true"></i><span><strong>Create</strong><small>Add amendment</small></span></button>
    </section>

    <section class="amd-search-panel">
        <div class="amd-search-wrap">
            <span class="amd-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="amd-search-body">
                <label for="amd-search">Amendment search</label>
                <input id="amd-search" class="amd-search-input" @bind="_searchTerm" @bind:event="oninput" @bind:after="ApplyFilter" placeholder="Search amendment, type, status, agreement, description..." />
                <span class="amd-search-hint">Filters real tenant amendment records and keeps KPIs, tabs, and detail selection in sync.</span>
            </div>
        </div>
        <select class="amd-filter-select" @bind="_statusFilter" @bind:after="ApplyFilter" aria-label="Status filter">
            <option value="all">All statuses</option>
            @foreach (var status in StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>
        <select class="amd-filter-select" @bind="_priorityFilter" @bind:after="ApplyFilter" aria-label="Priority filter">
            <option value="all">All priority</option>
            <option value="pending">Pending approval</option>
            <option value="effective">Effective soon</option>
            <option value="approved">Approved</option>
            <option value="review">Needs review</option>
        </select>
        <select class="amd-filter-select" @bind="_agreementFilter" @bind:after="ApplyFilter" aria-label="Agreement filter">
            <option value="all">All agreements</option>
            @foreach (var agreement in _agreements)
            {
                <option value="@agreement.Value">@agreement.Label</option>
            }
        </select>
        <div class="amd-search-result"><strong>@_filtered.Count</strong><span>records</span></div>
    </section>

    <nav class="amd-view-tabs" aria-label="Amendment views">
        @foreach (var view in _views)
        {
            <button type="button" class="amd-view-btn @(_activeView == view ? "amd-view-btn-active" : null)" @onclick="() => SetView(view)">@view</button>
        }
    </nav>

    <section class="amd-content-layout">
        <div class="amd-main-card">
            @if (_loading)
            {
                <div class="amd-loading"><i class="bi bi-arrow-repeat amd-spin" aria-hidden="true"></i><span>Loading amendments...</span></div>
            }
            else if (_filtered.Count == 0)
            {
                <div class="amd-empty-state"><i class="bi bi-pencil-square" aria-hidden="true"></i><h2>No amendments found</h2><p>Adjust filters or create the first agreement amendment.</p><button type="button" class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Amendment</button></div>
            }
            else if (_activeView == "Lifecycle")
            {
                <div class="amd-governance-grid">
                    <section class="amd-panel">
                        <header><div><i class="bi bi-calendar-range" aria-hidden="true"></i><strong>Lifecycle Health</strong></div><span>@LifecycleScore.ToString("F0")%</span></header>
                        <div class="amd-panel-body amd-metric-list">
                            <div class="amd-metric-row"><span>Draft</span><div><i style="@WidthStyle(DraftCount, SafeTotal)"></i></div><strong>@DraftCount</strong></div>
                            <div class="amd-metric-row"><span>Pending</span><div><i style="@WidthStyle(PendingCount, SafeTotal)"></i></div><strong>@PendingCount</strong></div>
                            <div class="amd-metric-row"><span>Approved</span><div><i style="@WidthStyle(ApprovedCount, SafeTotal)"></i></div><strong>@ApprovedCount</strong></div>
                            <div class="amd-metric-row"><span>Needs review</span><div><i style="@WidthStyle(NeedsReviewCount, SafeTotal)"></i></div><strong>@NeedsReviewCount</strong></div>
                        </div>
                    </section>
                    <section class="amd-panel">
                        <header><div><i class="bi bi-file-earmark-check" aria-hidden="true"></i><strong>Agreement Coverage</strong></div><span>@AgreementSummaries.Count</span></header>
                        <div class="amd-panel-body amd-group-list">
                            @foreach (var group in AgreementSummaries.Take(8))
                            {
                                <button type="button" class="amd-group-row" @onclick="() => FilterAgreement(group.Id)"><span>@group.Name</span><div><i style="@WidthStyle(group.Count, SafeTotal)"></i></div><strong>@group.Count</strong></button>
                            }
                        </div>
                    </section>
                    <section class="amd-panel amd-panel-wide">
                        <header><div><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><strong>Amendment Review Queue</strong></div><span>@ReviewQueue.Count</span></header>
                        <div class="amd-panel-body amd-review-list">
                            @foreach (var item in ReviewQueue.Take(8))
                            {
                                <button type="button" class="amd-review-row" @onclick="() => SelectItem(item)"><strong>@item.AmendmentNumber</strong><span>@ReviewReason(item)</span><em>@PriorityLabel(item)</em></button>
                            }
                        </div>
                    </section>
                </div>
            }
            else if (_activeView == "Governance")
            {
                <div class="amd-board">
                    @foreach (var lane in GovernanceLanes)
                    {
                        <section class="amd-board-col">
                            <header><strong>@lane.Title</strong><span>@lane.Items.Count</span></header>
                            @foreach (var item in lane.Items)
                            {
                                <button type="button" class="amd-board-card" @onclick="() => SelectItem(item)">
                                    <div><strong>@item.AmendmentNumber</strong><span>@item.StatusCode</span></div>
                                    <small>@AgreementNumber(item.AgreementId) · Effective @FormatDate(item.EffectiveDate)</small>
                                    <em>@PriorityLabel(item)</em>
                                </button>
                            }
                        </section>
                    }
                </div>
            }
            else
            {
                <div class="amd-table-scroll">
                    <table class="amd-table">
                        <thead><tr><th>Amendment</th><th>Agreement</th><th>Type</th><th>Effective</th><th>Priority</th><th>Status</th><th>Created</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var item in _filtered)
                            {
                                <tr @onclick="() => SelectItem(item)">
                                    <td><div class="amd-name-cell"><span class="amd-avatar @AvatarClass(item)">@Initials(item.AmendmentNumber)</span><span><strong>@item.AmendmentNumber</strong><small>@(item.Description ?? "No description provided")</small></span></div></td>
                                    <td>@AgreementNumber(item.AgreementId)</td>
                                    <td><span class="amd-code-pill">@item.AmendmentTypeCode</span></td>
                                    <td>@FormatDate(item.EffectiveDate)</td>
                                    <td><span class="@PriorityClass(item)">@PriorityLabel(item)</span></td>
                                    <td><span class="@StatusClass(item)">@StatusLabel(item)</span></td>
                                    <td>@item.CreatedDateUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                                    <td><div class="amd-row-actions"><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick:stopPropagation="true" @onclick="() => ToggleApprovedAsync(item)" title="Approve/Reopen"><i class="bi bi-check2-circle" aria-hidden="true"></i></button><button type="button" class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick:stopPropagation="true" @onclick="() => ConfirmDelete(item)" title="Delete"><i class="bi bi-trash" aria-hidden="true"></i></button></div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <aside class="amd-detail-card" aria-label="Selected amendment">
            @if (_selected is null)
            {
                <div class="amd-detail-empty"><i class="bi bi-pencil-square" aria-hidden="true"></i><h2>Amendment command brief</h2><p>Select an amendment to review agreement alignment, approval state, effective date, and actions.</p></div>
            }
            else
            {
                <div class="amd-detail-head"><div><span class="amd-detail-eyebrow"><i class="bi bi-file-earmark-check" aria-hidden="true"></i> @AgreementNumber(_selected.AgreementId)</span><h2>@_selected.AmendmentNumber</h2><p>@_selected.AmendmentTypeCode</p></div><span class="@StatusClass(_selected)">@StatusLabel(_selected)</span></div>
                <div class="amd-detail-body">
                    <div class="amd-detail-summary">
                        <div><span>Priority</span><strong>@PriorityLabel(_selected)</strong></div>
                        <div><span>Status</span><strong>@StatusLabel(_selected)</strong></div>
                        <div><span>Effective</span><strong>@FormatDate(_selected.EffectiveDate)</strong></div>
                        <div><span>Type</span><strong>@_selected.AmendmentTypeCode</strong></div>
                    </div>
                    <div class="amd-config-card"><span>Governance brief</span><strong>@ReviewReason(_selected)</strong><small>@(_selected.Description ?? "No description configured.")</small></div>
                    <div class="amd-detail-actions">
                        <button type="button" class="um-btn um-btn-primary" @onclick="() => OpenEdit(_selected)"><i class="bi bi-pencil" aria-hidden="true"></i> Edit Amendment</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="DuplicateSelected"><i class="bi bi-files" aria-hidden="true"></i> Duplicate</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="() => ToggleApprovedAsync(_selected)"><i class="bi bi-check2-circle" aria-hidden="true"></i> @(IsApproved(_selected) ? "Reopen" : "Approve")</button>
                        <button type="button" class="um-btn um-btn-ghost" @onclick="OpenAgreements"><i class="bi bi-file-earmark-check" aria-hidden="true"></i> Agreements</button>
                        <button type="button" class="um-btn um-btn-ghost text-danger" @onclick="() => ConfirmDelete(_selected)"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                    </div>
                </div>
            }
        </aside>
    </section>
</div>

@if (_showForm)
{
    <div class="amd-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="amd-form-title">
        <div class="amd-modal">
            <div class="amd-modal-header"><div class="amd-modal-title"><span class="amd-modal-icon"><i class="bi bi-pencil-square" aria-hidden="true"></i></span><div><h2 id="amd-form-title">@(_editId.HasValue ? "Edit Amendment" : "New Amendment")</h2><p>Configure agreement change, amendment type, effective date, description, and approval status.</p></div></div><button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CloseForm" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <EditForm @key="_form" Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="ShowValidation">
                <DataAnnotationsValidator />
                <div class="amd-modal-body">
                    <div class="amd-form-banner"><i class="bi bi-info-circle" aria-hidden="true"></i><span><strong>Amendment governance</strong> Create requests start as Draft in the backend; edit amendments to update approval status after creation.</span></div>
                    <div class="amd-form-grid">
                        <div class="amd-field amd-field-wide"><label>Agreement <span>*</span></label><InputSelect @bind-Value="_form.AgreementIdText" class="amd-input"><option value="">Select agreement</option>@foreach (var agreement in _agreements){<option value="@agreement.Value">@agreement.Label</option>}</InputSelect><ValidationMessage For="() => _form.AgreementIdText" class="text-danger" /></div>
                        <div class="amd-field"><label>Amendment # <span>*</span></label><InputText @bind-Value="_form.AmendmentNumber" class="amd-input" /><ValidationMessage For="() => _form.AmendmentNumber" class="text-danger" /></div>
                        <div class="amd-field"><label>Type <span>*</span></label><InputSelect @bind-Value="_form.AmendmentTypeCode" class="amd-input">@foreach (var type in ActiveTaskTypes){<option value="@type.TaskTypeCode">@type.TaskTypeName</option>}</InputSelect><ValidationMessage For="() => _form.AmendmentTypeCode" class="text-danger" /></div>
                        <div class="amd-field"><label>Effective <span>*</span></label><InputDate @bind-Value="_form.EffectiveDate" class="amd-input" /><ValidationMessage For="() => _form.EffectiveDate" class="text-danger" /></div>
                        <div class="amd-field"><label>Status <span>*</span></label><InputSelect @bind-Value="_form.StatusCode" class="amd-input"><option>Draft</option><option>Pending Approval</option><option>Approved</option><option>Rejected</option></InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
                        <div class="amd-field amd-field-wide"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="amd-input" rows="3" /><ValidationMessage For="() => _form.Description" class="text-danger" /></div>
                    </div>
                </div>
                <div class="amd-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi bi-check2" aria-hidden="true"></i> @(_editId.HasValue ? "Save Changes" : "Create Amendment")</button></div>
            </EditForm>
        </div>
    </div>
}

@if (_showDelete)
{
    <div class="amd-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="amd-delete-title">
        <div class="amd-confirm-modal">
            <div class="amd-confirm-icon"><i class="bi bi-trash3-fill" aria-hidden="true"></i></div>
            <h2 id="amd-delete-title">Delete Amendment</h2>
            <p>Delete <strong>@_deleteTarget?.AmendmentNumber</strong>? Agreement change history may still reference this amendment.</p>
            <div class="amd-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CancelDelete">Cancel</button><button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div>
        </div>
    </div>
}

@code {
    private Guid TenantId { get; set; }
    private Guid TenantAdminUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading;
    private bool _saving;
    private bool _showForm;
    private bool _showDelete;
    private bool _toastVisible;
    private string _searchTerm = string.Empty;
    private string _statusFilter = "all";
    private string _priorityFilter = "all";
    private string _agreementFilter = "all";
    private string _activeView = "Library";
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string? _loadError;
    private Guid? _editId;
    private AgreementAmendmentDto? _selected;
    private AgreementAmendmentDto? _deleteTarget;
    private readonly string[] _views = ["Library", "Lifecycle", "Governance"];
    private List<AgreementAmendmentDto> _items = [];
    private List<AgreementAmendmentDto> _filtered = [];
    private List<AgreementOption> _agreements = [];
    private List<TaskTypeDto> _taskTypes = [];
    private AmendmentForm _form = new();

    private IEnumerable<TaskTypeDto> ActiveTaskTypes => _taskTypes.Where(x => x.IsActive).DefaultIfEmpty(new TaskTypeDto { TaskTypeCode = "Amendment", TaskTypeName = "Amendment", IsActive = true });
    private int DraftCount => _items.Count(IsDraft);
    private int PendingCount => _items.Count(IsPending);
    private int ApprovedCount => _items.Count(IsApproved);
    private int EffectiveSoonCount => _items.Count(IsEffectiveSoon);
    private int NeedsReviewCount => _items.Count(NeedsReview);
    private int SafeTotal => Math.Max(_items.Count, 1);
    private double LifecycleScore => _items.Count == 0 ? 0 : (ApprovedCount + PendingCount + EffectiveSoonCount - NeedsReviewCount) * 100d / Math.Max(_items.Count * 3, 1);
    private List<string> StatusOptions => _items.Select(StatusLabel).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
    private List<AgreementSummary> AgreementSummaries => _items.GroupBy(x => x.AgreementId).Select(g => new AgreementSummary(g.Key.ToString(), AgreementNumber(g.Key), g.Count())).OrderByDescending(x => x.Count).ToList();
    private List<AgreementAmendmentDto> ReviewQueue => _items.Where(x => NeedsReview(x) || IsPending(x) || IsEffectiveSoon(x)).OrderBy(x => x.EffectiveDate).ThenBy(x => x.AmendmentNumber).ToList();
    private List<GovernanceLane> GovernanceLanes =>
    [
        new("Draft", _filtered.Where(IsDraft).ToList()),
        new("Pending Approval", _filtered.Where(IsPending).ToList()),
        new("Approved", _filtered.Where(IsApproved).ToList()),
    ];
    private string ToastIcon => _toastKind == "success" ? "bi-check-circle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-exclamation-triangle-fill";
    private string AllKpiClass => KpiClass("all", "amd-blue");
    private string DraftKpiClass => KpiClass("draft", "amd-slate");
    private string PendingKpiClass => KpiClass("pending", "amd-cyan");
    private string ApprovedKpiClass => KpiClass("approved", "amd-green");
    private string EffectiveKpiClass => KpiClass("effective", "amd-purple");
    private string ReviewKpiClass => KpiClass("review", "amd-amber");

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tasks & Workflows", "/tasks"), new("Amendments", "/ops/amendments"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await LoadAgreementsAsync();
            await LoadTaskTypesAsync();
            var result = await Api.SearchAgreementAmendmentsAsync(TenantId, searchTerm: _searchTerm);
            _items = result?.Items.OrderBy(x => IsPending(x) ? 0 : IsDraft(x) ? 1 : 2).ThenBy(x => x.EffectiveDate).ThenBy(x => x.AmendmentNumber).ToList() ?? [];
            ApplyFilter();
            _selected ??= _filtered.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load amendments: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilter()
    {
        IEnumerable<AgreementAmendmentDto> query = _items;
        if (!string.IsNullOrWhiteSpace(_searchTerm)) query = query.Where(MatchesSearch);
        if (_statusFilter != "all") query = query.Where(x => string.Equals(StatusLabel(x), _statusFilter, StringComparison.OrdinalIgnoreCase));
        if (_priorityFilter == "pending") query = query.Where(IsPending);
        else if (_priorityFilter == "effective") query = query.Where(IsEffectiveSoon);
        else if (_priorityFilter == "approved") query = query.Where(IsApproved);
        else if (_priorityFilter == "review") query = query.Where(NeedsReview);
        if (_agreementFilter != "all" && Guid.TryParse(_agreementFilter, out var agreementId)) query = query.Where(x => x.AgreementId == agreementId);
        _filtered = query.OrderBy(x => NeedsReview(x) ? 0 : IsPending(x) ? 1 : 2).ThenBy(x => x.EffectiveDate).ThenBy(x => x.AmendmentNumber).ToList();
        if (_selected is not null && !_filtered.Any(x => x.AmendmentId == _selected.AmendmentId)) _selected = _filtered.FirstOrDefault();
    }

    private void ShowAll() { _statusFilter = "all"; _priorityFilter = "all"; _agreementFilter = "all"; ApplyFilter(); }
    private void ShowDraft() { _statusFilter = "Draft"; _priorityFilter = "all"; ApplyFilter(); }
    private void ShowPending() { _statusFilter = "all"; _priorityFilter = "pending"; ApplyFilter(); }
    private void ShowApproved() { _statusFilter = "Approved"; _priorityFilter = "approved"; ApplyFilter(); }
    private void ShowEffective() { _statusFilter = "all"; _priorityFilter = "effective"; ApplyFilter(); }
    private void ShowReview() { _statusFilter = "all"; _priorityFilter = "review"; ApplyFilter(); }
    private void ShowLibrary() => SetView("Library");
    private void ShowLifecycleView() => SetView("Lifecycle");
    private void ShowGovernance() => SetView("Governance");
    private void SetView(string view) => _activeView = view;
    private void FilterAgreement(string agreementId) { _agreementFilter = agreementId; ApplyFilter(); }
    private void SelectItem(AgreementAmendmentDto item) => _selected = item;
    private void OpenAgreements() => Nav.NavigateTo("/agreements");
    private void OpenActivities() => Nav.NavigateTo("/ops/activities");

    private void OpenCreate()
    {
        _editId = null;
        _form = new() { AmendmentNumber = $"AMD-{DateTime.UtcNow:yyyyMMddHHmmss}", AmendmentTypeCode = GetDefaultTaskTypeCode("Amendment"), EffectiveDate = DateOnly.FromDateTime(DateTime.Today), StatusCode = "Draft" };
        _showForm = true;
    }

    private void OpenEdit(AgreementAmendmentDto item)
    {
        _editId = item.AmendmentId;
        _form = new()
        {
            AgreementIdText = item.AgreementId.ToString(),
            AmendmentNumber = item.AmendmentNumber,
            AmendmentTypeCode = item.AmendmentTypeCode,
            EffectiveDate = item.EffectiveDate,
            Description = item.Description,
            StatusCode = item.StatusCode
        };
        _showForm = true;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var agreementId = Guid.Parse(_form.AgreementIdText);
            if (_editId.HasValue)
            {
                await Api.UpdateAgreementAmendmentAsync(_editId.Value, new()
                {
                    AgreementId = agreementId,
                    AmendmentNumber = _form.AmendmentNumber.Trim(),
                    AmendmentTypeCode = _form.AmendmentTypeCode,
                    EffectiveDate = _form.EffectiveDate,
                    Description = Clean(_form.Description),
                    StatusCode = _form.StatusCode,
                    ModifiedByUserId = TenantAdminUserId
                });
                ShowToast("Amendment updated.");
            }
            else
            {
                var id = await Api.CreateAgreementAmendmentAsync(new()
                {
                    TenantId = TenantId,
                    AgreementId = agreementId,
                    AmendmentNumber = _form.AmendmentNumber.Trim(),
                    AmendmentTypeCode = _form.AmendmentTypeCode,
                    EffectiveDate = _form.EffectiveDate,
                    Description = Clean(_form.Description),
                    CreatedByUserId = TenantAdminUserId
                });
                _editId = id;
                ShowToast("Amendment created.");
            }
            _showForm = false;
            await LoadAsync();
            _selected = _items.FirstOrDefault(x => x.AmendmentId == _editId) ?? _selected;
        }
        catch (Exception ex)
        {
            ShowToast($"Save failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmDelete(AgreementAmendmentDto item) { _deleteTarget = item; _showDelete = true; }
    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget is null) return;
        _saving = true;
        try
        {
            await Api.DeleteAgreementAmendmentAsync(_deleteTarget.AmendmentId, TenantAdminUserId);
            ShowToast("Amendment deleted.");
            if (_selected?.AmendmentId == _deleteTarget.AmendmentId) _selected = null;
            _showDelete = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Delete failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private void DuplicateSelected()
    {
        if (_selected is null) return;
        _editId = null;
        _form = new()
        {
            AgreementIdText = _selected.AgreementId.ToString(),
            AmendmentNumber = $"{_selected.AmendmentNumber}-COPY",
            AmendmentTypeCode = _selected.AmendmentTypeCode,
            EffectiveDate = _selected.EffectiveDate,
            Description = _selected.Description,
            StatusCode = "Draft"
        };
        _showForm = true;
    }

    private async Task ToggleApprovedAsync(AgreementAmendmentDto item)
    {
        _saving = true;
        try
        {
            var approve = !IsApproved(item);
            await Api.UpdateAgreementAmendmentAsync(item.AmendmentId, new()
            {
                AgreementId = item.AgreementId,
                AmendmentNumber = item.AmendmentNumber,
                AmendmentTypeCode = item.AmendmentTypeCode,
                EffectiveDate = item.EffectiveDate,
                Description = item.Description,
                StatusCode = approve ? "Approved" : "Draft",
                ModifiedByUserId = TenantAdminUserId
            });
            ShowToast(approve ? "Amendment approved." : "Amendment reopened as draft.");
            await LoadAsync();
            _selected = _items.FirstOrDefault(x => x.AmendmentId == item.AmendmentId) ?? _selected;
        }
        catch (Exception ex)
        {
            ShowToast($"Approval update failed: {ex.Message}", "danger");
        }
        finally
        {
            _saving = false;
        }
    }

    private Task ExportAsync()
    {
        var rows = new List<string> { "Amendment,Agreement,Type,Status,Priority,Effective,Description,Created" };
        rows.AddRange(_filtered.Select(x => string.Join(',', Csv(x.AmendmentNumber), Csv(AgreementNumber(x.AgreementId)), Csv(x.AmendmentTypeCode), Csv(StatusLabel(x)), Csv(PriorityLabel(x)), Csv(FormatDate(x.EffectiveDate)), Csv(x.Description), Csv(x.CreatedDateUtc.ToString("O")))));
        Nav.NavigateTo("data:text/csv;charset=utf-8," + Uri.EscapeDataString(string.Join(Environment.NewLine, rows)), forceLoad: true);
        ShowToast("Amendment export generated.");
        return Task.CompletedTask;
    }

    private async Task LoadAgreementsAsync()
    {
        if (_agreements.Count > 0) return;
        var result = await Api.SearchAgreementsAsync(TenantId);
        _agreements = (result?.Items ?? []).OrderBy(x => x.AgreementNumber).Select(x => new AgreementOption(x.AgreementId.ToString(), x.AgreementNumber)).ToList();
    }

    private async Task LoadTaskTypesAsync()
    {
        if (_taskTypes.Count > 0) return;
        var result = await Api.SearchTaskTypesAsync(TenantId, pageSize: 250);
        _taskTypes = (result?.Items ?? []).OrderBy(x => x.SortOrder).ThenBy(x => x.TaskTypeName).ToList();
    }

    private void ShowValidation() => ShowToast("Please fix validation errors before saving.", "danger");
    private void CloseForm() { _showForm = false; _form = new(); _editId = null; }
    private void CancelDelete() { _showDelete = false; _deleteTarget = null; }
    private void HideToast() => _toastVisible = false;
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }

    private string KpiClass(string key, string tone)
    {
        var active = false;
        if (key == "all") active = _statusFilter == "all" && _priorityFilter == "all" && _agreementFilter == "all";
        else if (key == "draft") active = _statusFilter == "Draft";
        else if (key == "pending") active = _priorityFilter == "pending";
        else if (key == "approved") active = _statusFilter == "Approved" || _priorityFilter == "approved";
        else if (key == "effective") active = _priorityFilter == "effective";
        else if (key == "review") active = _priorityFilter == "review";
        return $"amd-kpi-card {tone}{(active ? " amd-kpi-card-active" : string.Empty)}";
    }

    private bool MatchesSearch(AgreementAmendmentDto item)
    {
        var q = _searchTerm.Trim();
        return Contains(item.AmendmentNumber, q) || Contains(item.AmendmentTypeCode, q) || Contains(item.StatusCode, q) || Contains(item.Description, q) || Contains(AgreementNumber(item.AgreementId), q);
    }

    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;
    private static bool IsDraft(AgreementAmendmentDto item) => string.Equals(item.StatusCode, "Draft", StringComparison.OrdinalIgnoreCase);
    private static bool IsPending(AgreementAmendmentDto item) => string.Equals(item.StatusCode, "Pending Approval", StringComparison.OrdinalIgnoreCase) || string.Equals(item.StatusCode, "Pending", StringComparison.OrdinalIgnoreCase);
    private static bool IsApproved(AgreementAmendmentDto item) => string.Equals(item.StatusCode, "Approved", StringComparison.OrdinalIgnoreCase);
    private static bool IsRejected(AgreementAmendmentDto item) => string.Equals(item.StatusCode, "Rejected", StringComparison.OrdinalIgnoreCase);
    private static bool IsEffectiveSoon(AgreementAmendmentDto item) => item.EffectiveDate >= DateOnly.FromDateTime(DateTime.Today) && item.EffectiveDate <= DateOnly.FromDateTime(DateTime.Today.AddDays(30));
    private static bool NeedsReview(AgreementAmendmentDto item) => IsRejected(item) || string.IsNullOrWhiteSpace(item.Description) || string.IsNullOrWhiteSpace(item.AmendmentTypeCode) || item.AgreementId == Guid.Empty;
    private static string StatusLabel(AgreementAmendmentDto item) => string.IsNullOrWhiteSpace(item.StatusCode) ? "Draft" : item.StatusCode.Trim();
    private static string StatusClass(AgreementAmendmentDto item) => IsApproved(item) ? "amd-status amd-status-approved" : IsPending(item) ? "amd-status amd-status-pending" : NeedsReview(item) ? "amd-status amd-status-risk" : "amd-status amd-status-draft";
    private static string PriorityLabel(AgreementAmendmentDto item) => NeedsReview(item) ? "Needs Review" : IsPending(item) ? "Pending Approval" : IsEffectiveSoon(item) ? "Effective Soon" : IsApproved(item) ? "Approved" : IsDraft(item) ? "Draft" : "Standard";
    private static string PriorityClass(AgreementAmendmentDto item) => NeedsReview(item) ? "amd-priority amd-priority-risk" : IsPending(item) ? "amd-priority amd-priority-pending" : IsEffectiveSoon(item) ? "amd-priority amd-priority-effective" : IsApproved(item) ? "amd-priority amd-priority-approved" : "amd-priority amd-priority-draft";
    private static string ReviewReason(AgreementAmendmentDto item)
    {
        if (item.AgreementId == Guid.Empty) return "Amendment is not linked to an agreement.";
        if (IsRejected(item)) return "Amendment was rejected and needs follow-up.";
        if (string.IsNullOrWhiteSpace(item.AmendmentTypeCode)) return "Amendment type is missing.";
        if (string.IsNullOrWhiteSpace(item.Description)) return "Amendment description is missing.";
        if (IsPending(item)) return "Amendment is awaiting approval.";
        if (IsEffectiveSoon(item)) return "Amendment becomes effective within the next 30 days.";
        if (IsApproved(item)) return "Amendment is approved.";
        return "Amendment is in draft governance.";
    }

    private string AgreementNumber(Guid agreementId) => _agreements.FirstOrDefault(x => string.Equals(x.Value, agreementId.ToString(), StringComparison.OrdinalIgnoreCase))?.Label ?? "Unassigned agreement";
    private string GetDefaultTaskTypeCode(string defaultCode) => _taskTypes.FirstOrDefault(x => x.TaskTypeCode == defaultCode)?.TaskTypeCode ?? _taskTypes.FirstOrDefault(x => x.IsActive)?.TaskTypeCode ?? defaultCode;
    private static string FormatDate(DateOnly value) => value.ToString("MMM d, yyyy");
    private static string WidthStyle(int value, int max) => $"width:{Math.Clamp((int)Math.Round(value * 100d / Math.Max(max, 1)), 0, 100)}%;";
    private static string AvatarClass(AgreementAmendmentDto item)
    {
        var index = Math.Abs(item.AmendmentNumber.GetHashCode()) % 6;
        if (index == 0) return "amd-av1";
        if (index == 1) return "amd-av2";
        if (index == 2) return "amd-av3";
        if (index == 3) return "amd-av4";
        if (index == 4) return "amd-av5";
        return "amd-av6";
    }
    private static string Initials(string name)
    {
        var parts = name.Split(' ', '-', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant() : name.Length > 0 ? name[..1].ToUpperInvariant() : "?";
    }
    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string Csv(string? value) => string.Concat("\"", (value ?? string.Empty).Replace("\"", "\"\""), "\"");

    private async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
    }

