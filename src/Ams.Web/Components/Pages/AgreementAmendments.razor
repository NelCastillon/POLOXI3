@page "/ops/amendments"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Operations

<PageTitle>Amendments — Operations</PageTitle>
<AppPageHeader Title="Amendments Administration" Subtitle="Tenant admin review of agreement amendments, effective dates, status, approvals, and client-facing changes" Icon="bi-pencil-square"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New Amendment</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<section class="ma-hero twf-hero"><div><span class="ma-eyebrow">Tenant Administration · Amendments</span><h2>Tenant Amendment Control Center</h2><p>Administer amendment requests, approval status, effective dates, agreement changes, and operational contract governance.</p></div><div class="ma-hero-actions"><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/agreements")'><i class="bi bi-file-earmark-check"></i> Agreements</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/workflow")'><i class="bi bi-diagram-3"></i> Workflows</button><button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/ops/activities")'><i class="bi bi-clock-history"></i> Activities</button></div></section>
<div class="pc-kpi-strip"><div class="pc-kpi-card @(_filter == null ? "pc-kpi-card--active" : "")" @onclick="() => SetFilter(null)" title="Show all"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-pencil-square"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total</div></div></div><div class="pc-kpi-card @(_filter == "Draft" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Draft")' title="Draft"><span class="pc-kpi-icon pc-kpi-icon--warning"><i class="bi bi-hourglass-split"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Draft")</div><div class="pc-kpi-label">Draft</div></div></div></div>
<AppFilterPanel @bind-SearchValue="_searchTerm" OnSearch="OnSearchAsync" SearchPlaceholder="Search amendments…" />
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div> }
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }<SfGrid TValue="AgreementAmendmentDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52"><GridEvents TValue="AgreementAmendmentDto" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" /><GridColumns><GridColumn Field="AmendmentNumber" HeaderText="Amendment #" Width="150" /><GridColumn Field="AgreementId" HeaderText="Agreement Id" Width="250" /><GridColumn Field="AmendmentTypeCode" HeaderText="Type" Width="150" /><GridColumn Field="EffectiveDate" HeaderText="Effective" Type="ColumnType.Date" Format="d" Width="130" /><GridColumn Field="StatusCode" HeaderText="Status" Width="120" /><GridColumn Field="Description" HeaderText="Description" Width="280" /><GridColumn HeaderText="Actions" Width="120" TextAlign="TextAlign.Center"><Template>@{ var r = (AgreementAmendmentDto)context; }<button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => OpenEdit(r)" @onclick:stopPropagation="true" title="Edit"><i class="bi bi-pencil"></i></button><button class="um-btn um-btn-ghost um-btn-sm text-danger" @onclick="() => ConfirmDelete(r)" @onclick:stopPropagation="true" title="Delete"><i class="bi bi-trash"></i></button></Template></GridColumn></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="560px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm" /><DialogContent><div class="um-modal-header"><i class="bi bi-pencil-square"></i><span>@(_editId.HasValue ? "Edit Amendment" : "New Amendment")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div><EditForm @key="_form" Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="ShowValidation"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Agreement # <span class="text-danger">*</span></label><SfDropDownList TValue="string" TItem="AgreementOption" DataSource="_agreements" @bind-Value="_form.AgreementIdText" AllowFiltering="true" FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains" Placeholder="Search agreement #" CssClass="um-input"><DropDownListFieldSettings Value="Value" Text="Label" /></SfDropDownList>@if (_showValidation) { }</div><div class="um-field"><label>Amendment # <span class="text-danger">*</span></label><InputText @bind-Value="_form.AmendmentNumber" class="um-input" /></div><div class="um-field"><label>Type <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.AmendmentTypeCode" class="um-input">@foreach (var type in _taskTypes.Where(x => x.IsActive)) { <option value="@type.TaskTypeCode">@type.TaskTypeName</option> }</InputSelect></div><div class="um-field"><label>Effective <span class="text-danger">*</span></label><InputDate @bind-Value="_form.EffectiveDate" class="um-input" /></div><div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input"><option>Draft</option><option>Pending Approval</option><option>Approved</option><option>Rejected</option></InputSelect></div><div class="um-field um-field--full"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="3" /></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">@(_editId.HasValue ? "Save Changes" : "Create")</button></div></EditForm></DialogContent></SfDialog>
@if (_showDelete && _deleteTarget is not null) { <div class="mt-modal-backdrop" @onclick="() => _showDelete = false"><div class="um-confirm-dialog mt-confirm" @onclick:stopPropagation="true"><div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash"></i></div><div class="um-confirm-title">Delete amendment?</div><div class="um-confirm-text">This will remove <strong>@_deleteTarget.AmendmentNumber</strong>.</div><div class="um-modal-footer"><button class="um-btn um-btn-ghost" @onclick="() => _showDelete = false">Cancel</button><button class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving">Delete</button></div></div></div> }
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" /><style>@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }</style>
@code {
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId; Guid TenantId { get; set; } Guid TenantAdminUserId { get; set; } string? _searchTerm, _loadError, _filter; bool _loading, _saving, _showForm, _showDelete, _showValidation; Guid? _editId; AgreementAmendmentDto? _deleteTarget; List<AgreementAmendmentDto> _items = [], _filtered = []; List<AgreementOption> _agreements = []; List<TaskTypeDto> _taskTypes = []; SfToast _toast = default!; AmendmentForm _form = new(); protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tasks & Workflows", "/tasks"), new("Amendments", null)); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { await LoadAgreementsAsync(); await LoadTaskTypesAsync(); var result = await Api.SearchAgreementAmendmentsAsync(TenantId, searchTerm: _searchTerm); _items = result?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = $"Failed to load amendments: {ex.Message}"; } finally { _loading = false; } } Task OnSearchAsync() => LoadAsync(); void ApplyFilter() => _filtered = _filter is null ? [.. _items] : _items.Where(x => x.StatusCode == _filter).ToList(); void SetFilter(string? f) { _filter = f; ApplyFilter(); } void OnRowSelected(RowSelectEventArgs<AgreementAmendmentDto> args) => OpenEdit(args.Data); void OpenCreate() { _editId = null; _showValidation = false; _form = new() { AmendmentNumber = $"AMD-{DateTime.UtcNow:yyyyMMddHHmmss}", AmendmentTypeCode = GetDefaultTaskTypeCode("Amendment"), EffectiveDate = DateOnly.FromDateTime(DateTime.Today) }; _showForm = true; } void OpenEdit(AgreementAmendmentDto item) { _editId = item.AmendmentId; _showValidation = false; _form = new() { AgreementIdText = item.AgreementId.ToString(), AmendmentNumber = item.AmendmentNumber, AmendmentTypeCode = item.AmendmentTypeCode, EffectiveDate = item.EffectiveDate, Description = item.Description, StatusCode = item.StatusCode }; _showForm = true; } void ConfirmDelete(AgreementAmendmentDto item) { _deleteTarget = item; _showDelete = true; } async Task SaveAsync() { _showValidation = true; _saving = true; try { if (_editId.HasValue) await Api.UpdateAgreementAmendmentAsync(_editId.Value, new() { AgreementId = Guid.Parse(_form.AgreementIdText), AmendmentNumber = _form.AmendmentNumber, AmendmentTypeCode = _form.AmendmentTypeCode, EffectiveDate = _form.EffectiveDate, Description = _form.Description, StatusCode = _form.StatusCode, ModifiedByUserId = TenantAdminUserId }); else await Api.CreateAgreementAmendmentAsync(new() { TenantId = TenantId, AgreementId = Guid.Parse(_form.AgreementIdText), AmendmentNumber = _form.AmendmentNumber, AmendmentTypeCode = _form.AmendmentTypeCode, EffectiveDate = _form.EffectiveDate, Description = _form.Description }); _showForm = false; await _toast.ShowAsync(new() { Content = _editId.HasValue ? "Amendment updated" : "Amendment created", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } async Task ExecuteDeleteAsync() { if (_deleteTarget is null) return; _saving = true; try { await Api.DeleteAgreementAmendmentAsync(_deleteTarget.AmendmentId, TenantAdminUserId); _showDelete = false; await _toast.ShowAsync(new() { Content = "Amendment deleted", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Delete failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } void ResetForm() { _form = new(); _editId = null; _showValidation = false; } void ShowValidation() => _showValidation = true; async Task LoadAgreementsAsync() { if (_agreements.Count > 0) return; var result = await Api.SearchAgreementsAsync(TenantId); _agreements = (result?.Items ?? []).OrderBy(x => x.AgreementNumber).Select(x => new AgreementOption(x.AgreementId.ToString(), x.AgreementNumber)).ToList(); } async Task LoadTaskTypesAsync() { if (_taskTypes.Count > 0) return; var result = await Api.SearchTaskTypesAsync(TenantId, pageSize: 250); _taskTypes = (result?.Items ?? []).OrderBy(x => x.SortOrder).ThenBy(x => x.TaskTypeName).ToList(); } string GetDefaultTaskTypeCode(string defaultCode) => _taskTypes.FirstOrDefault(x => x.TaskTypeCode == defaultCode)?.TaskTypeCode ?? defaultCode; sealed record AgreementOption(string Value, string Label); sealed class AmendmentForm { [Required(ErrorMessage = "Select an agreement.")] public string AgreementIdText { get; set; } = string.Empty; [Required, StringLength(50)] public string AmendmentNumber { get; set; } = string.Empty; [Required, StringLength(50)] public string AmendmentTypeCode { get; set; } = "Amendment"; [Required] public DateOnly EffectiveDate { get; set; } = DateOnly.FromDateTime(DateTime.Today); [Required, StringLength(50)] public string StatusCode { get; set; } = "Draft"; [StringLength(1000)] public string? Description { get; set; } } 
    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
