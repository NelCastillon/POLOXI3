@page "/ops/amendments"
@inject ApiClient Api

<PageTitle>Agreement Amendments</PageTitle>
<AppPageHeader Title="Agreement Amendments" Icon="bi-grid" />

<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>

@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(AgreementAmendmentDto.AmendmentNumber)"   HeaderText="Amendment #"  Width="150"></GridColumn>
        <GridColumn Field="@nameof(AgreementAmendmentDto.AmendmentTypeCode)" HeaderText="Type"         Width="150"></GridColumn>
        <GridColumn Field="@nameof(AgreementAmendmentDto.EffectiveDate)"     HeaderText="Effective"    Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
        <GridColumn Field="@nameof(AgreementAmendmentDto.StatusCode)"        HeaderText="Status"       Width="120"></GridColumn>
        <GridColumn Field="@nameof(AgreementAmendmentDto.Description)"       HeaderText="Description"  Width="280"></GridColumn>
        <GridColumn Field="@nameof(AgreementAmendmentDto.CreatedDateUtc)"    HeaderText="Created"      Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
    </GridColumns>
</SfGrid>
}

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<AgreementAmendmentDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchAgreementAmendmentsAsync(_tenantId, searchTerm: _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
