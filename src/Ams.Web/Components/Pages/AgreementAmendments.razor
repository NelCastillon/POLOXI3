@page "/ops/amendments"
@inject ApiClient Api
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Features.Operations

<PageTitle>Amendments — Operations</PageTitle>
<AppPageHeader Title="Agreement Amendments" Subtitle="Review agreement amendments, effective dates, status, and client-facing changes" Icon="bi-pencil-square"><Actions><button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg"></i> New Amendment</button><button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button></Actions></AppPageHeader>
<div class="pc-kpi-strip"><div class="pc-kpi-card @(_filter == null ? "pc-kpi-card--active" : "")" @onclick="() => SetFilter(null)" title="Show all"><span class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-pencil-square"></i></span><div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">Total</div></div></div><div class="pc-kpi-card @(_filter == "Draft" ? "pc-kpi-card--active" : "")" @onclick='() => SetFilter("Draft")' title="Draft"><span class="pc-kpi-icon pc-kpi-icon--warning"><i class="bi bi-hourglass-split"></i></span><div><div class="pc-kpi-value">@_items.Count(x => x.StatusCode == "Draft")</div><div class="pc-kpi-label">Draft</div></div></div></div>
<AppFilterPanel @bind-SearchValue="_searchTerm" OnSearch="OnSearchAsync" SearchPlaceholder="Search amendments…" />
@if (_loadError is not null) { <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div> }
<div class="um-grid-card">@if (_loading) { <div class="um-loading-overlay"><div class="um-spinner"></div><span>Loading…</span></div> }<SfGrid TValue="AgreementAmendmentDto" DataSource="@_filtered" AllowPaging="true" AllowSorting="true" EnableHover="true" RowHeight="52"><GridEvents TValue="AgreementAmendmentDto" RowSelected="OnRowSelected" /><GridPageSettings PageSize="25" PageSizes="@(new[] { 25, 50, 100 })" /><GridColumns><GridColumn Field="AmendmentNumber" HeaderText="Amendment #" Width="150" /><GridColumn Field="AgreementId" HeaderText="Agreement Id" Width="250" /><GridColumn Field="AmendmentTypeCode" HeaderText="Type" Width="150" /><GridColumn Field="EffectiveDate" HeaderText="Effective" Type="ColumnType.Date" Format="d" Width="130" /><GridColumn Field="StatusCode" HeaderText="Status" Width="120" /><GridColumn Field="Description" HeaderText="Description" Width="280" /></GridColumns></SfGrid></div>
<SfDialog @bind-Visible="_showForm" Width="560px" IsModal="true" ShowCloseIcon="false"><DialogEvents Closed="ResetForm" /><DialogContent><div class="um-modal-header"><i class="bi bi-pencil-square"></i><span>New Amendment</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showForm = false"><i class="bi bi-x-lg"></i></button></div><EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><div class="um-modal-body"><div class="um-form-grid"><div class="um-field"><label>Agreement Id <span class="text-danger">*</span></label><InputText @bind-Value="_form.AgreementIdText" class="um-input" /><ValidationMessage For="() => _form.AgreementIdText" class="text-danger" /></div><div class="um-field"><label>Amendment # <span class="text-danger">*</span></label><InputText @bind-Value="_form.AmendmentNumber" class="um-input" /><ValidationMessage For="() => _form.AmendmentNumber" class="text-danger" /></div><div class="um-field"><label>Type <span class="text-danger">*</span></label><InputText @bind-Value="_form.AmendmentTypeCode" class="um-input" /><ValidationMessage For="() => _form.AmendmentTypeCode" class="text-danger" /></div><div class="um-field"><label>Effective <span class="text-danger">*</span></label><InputDate @bind-Value="_form.EffectiveDate" class="um-input" /><ValidationMessage For="() => _form.EffectiveDate" class="text-danger" /></div><div class="um-field um-field--full"><label>Description</label><InputTextArea @bind-Value="_form.Description" class="um-input" rows="3" /><ValidationMessage For="() => _form.Description" class="text-danger" /></div></div></div><div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="() => _showForm = false">Cancel</button><button type="submit" class="um-btn um-btn-primary" disabled="@_saving">Create</button></div></EditForm></DialogContent></SfDialog>
<SfToast @ref="_toast" NewestOnTop="true" ShowProgressBar="true" /><style>@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }</style>
@code { static readonly Guid TenantId = Guid.Parse("00000000-0000-0000-0000-000000000001"); string? _searchTerm, _loadError, _filter; bool _loading, _saving, _showForm; List<AgreementAmendmentDto> _items = [], _filtered = []; SfToast _toast = default!; AmendmentForm _form = new(); protected override async Task OnInitializedAsync() { Breadcrumbs.SetCrumbs(new("Home", "/"), new("Tasks & Workflows", "/tasks"), new("Amendments", null)); await LoadAsync(); } async Task LoadAsync() { _loading = true; _loadError = null; try { var result = await Api.SearchAgreementAmendmentsAsync(TenantId, searchTerm: _searchTerm); _items = result?.Items.ToList() ?? []; ApplyFilter(); } catch (Exception ex) { _loadError = $"Failed to load amendments: {ex.Message}"; } finally { _loading = false; } } Task OnSearchAsync() => LoadAsync(); void ApplyFilter() => _filtered = _filter is null ? [.. _items] : _items.Where(x => x.StatusCode == _filter).ToList(); void SetFilter(string? f) { _filter = f; ApplyFilter(); } void OnRowSelected(RowSelectEventArgs<AgreementAmendmentDto> args) { } void OpenCreate() { _form = new() { AmendmentNumber = $"AMD-{DateTime.UtcNow:yyyyMMddHHmmss}", EffectiveDate = DateOnly.FromDateTime(DateTime.Today) }; _showForm = true; } async Task SaveAsync() { _saving = true; try { await Api.CreateAgreementAmendmentAsync(new() { TenantId = TenantId, AgreementId = Guid.Parse(_form.AgreementIdText), AmendmentNumber = _form.AmendmentNumber, AmendmentTypeCode = _form.AmendmentTypeCode, EffectiveDate = _form.EffectiveDate, Description = _form.Description }); _showForm = false; await _toast.ShowAsync(new() { Content = "Amendment created", CssClass = "e-toast-success" }); await LoadAsync(); } catch (Exception ex) { await _toast.ShowAsync(new() { Content = $"Save failed: {ex.Message}", CssClass = "e-toast-danger" }); } finally { _saving = false; } } void ResetForm() => _form = new(); sealed class AmendmentForm { [Required, RegularExpression("^[0-9a-fA-F-]{36}$", ErrorMessage = "Enter a valid Agreement Id.")] public string AgreementIdText { get; set; } = string.Empty; [Required, StringLength(50)] public string AmendmentNumber { get; set; } = string.Empty; [Required, StringLength(50)] public string AmendmentTypeCode { get; set; } = "Amendment"; [Required] public DateOnly EffectiveDate { get; set; } = DateOnly.FromDateTime(DateTime.Today); [StringLength(1000)] public string? Description { get; set; } } }
