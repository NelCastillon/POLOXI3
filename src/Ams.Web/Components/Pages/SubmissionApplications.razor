    async Task ExecuteConfirmedActionAsync()
    {
        if (_selected is null) return;

        _actionBusy = true;
        try
        {
            SubmissionActionResult result = _pendingAction switch
            {
                "Submit to Carrier" => await Api.SubmitSubmissionToMarketAsync(_selected.SubId, new SubmitSubmissionToMarketRequest(_tenantId, ParseCarrierId(_actionForm.CarrierIdText), _actionForm.Notes ?? "Application submitted to carrier from application command center.")),
                "Add Requirements" => await GenerateApplicationPacketAsync("Application Requirements", _actionForm.Notes),
                "Request Info" => await GenerateApplicationPacketAsync("Application Information Request", _actionForm.Notes),
                "Mark Approved" => await Api.RequestSubmissionQuoteAsync(_selected.SubId, new RequestSubmissionQuoteRequest(_tenantId, ParseCarrierId(_actionForm.CarrierIdText), _actionForm.AnnualPremium, null, null, _actionForm.Notes ?? "Application approved from application command center.")),
                "Reject" => await Api.DeclineSubmissionAsync(_selected.SubId, new DeclineSubmissionRequest(_tenantId, _actionForm.Notes ?? $"Application rejected from command center: {_selected.AppNo}.")),
                "Download App" => await GenerateApplicationPacketAsync("Application Packet", _actionForm.Notes),
                _ => new SubmissionActionResult(_selected.SubId, "No action executed.")
            };

            _showActionDialog = false;
            _showConfirmDialog = false;
            ShowToast(result.Message, "sa-toast--success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Action failed: {ex.Message}", "sa-toast--danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    async Task<SubmissionActionResult> GenerateApplicationPacketAsync(string titlePrefix, string? notes)
    {
        if (_selected is null) return new SubmissionActionResult(Guid.Empty, "No application selected.");
        var proposalId = await Api.GenerateProposalAsync(new GenerateProposalRequest(_selected.SubId, _tenantId, $"{titlePrefix} - {_selected.AppNo}", [], notes));
        return new SubmissionActionResult(proposalId, $"{titlePrefix} generated.");
    }

    void ShowToast(string message, string cssClass)
    {
        var toast = new ToastMessage(Guid.NewGuid(), message, cssClass);
        _toasts.Add(toast);
        _ = Task.Run(async () =>
        {
            await Task.Delay(5000);
            await InvokeAsync(() => DismissToast(toast.Id));
        });
    }

    void DismissToast(Guid id) => _toasts.RemoveAll(t => t.Id == id);

