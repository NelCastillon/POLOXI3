    RenderFragment LobChip(string lob) =>
        @<span class="sa-lob-chip">@lob</span>;

    RenderFragment StatusChip(string s)
    {
        var css = s.ToLowerInvariant().Replace(" ", "-").Replace("_", "-");
        return @<span class="sa-status sa-status-@css">@s</span>;
    }

    RenderFragment CompletenessBar(int pct)
    {
        var color = pct >= 80 ? "#059669" : pct >= 50 ? "#d97706" : "#dc2626";
        return @<div class="sa-complete-wrap" title="@($"{pct}% complete")">
            <div class="sa-complete-bar" style="width:@pct%;background:@color"></div>
            <span class="sa-complete-lbl">@pct%</span>
        </div>;
    }

    RenderFragment DueCell(DateTime d)
    {
        var days = (d - DateTime.Today).TotalDays;
        var css = days < 0 ? "sa-due-late" : days <= 3 ? "sa-due-soon" : string.Empty;
        return @<span class="@css">@d.ToString("MM/dd/yyyy")</span>;
    }

    RenderFragment CtxBtn(AppRow row) =>
        @<div class="um-action-menu-wrap sa-action-menu-wrap" @onclick:stopPropagation="true">
            <button type="button"
                    class="um-btn um-btn-ghost um-btn-xs sa-ctx-btn"
                    aria-haspopup="menu"
                    aria-expanded="@(_openActionMenuFor == row.AppId)"
                    title="Application actions"
                    @onclick="() => ToggleActionMenu(row)">
                <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
            </button>
            @if (_openActionMenuFor == row.AppId)
            {
                <div class="sa-action-menu" role="menu" aria-label="Application actions">
                    <div class="sa-action-menu-summary">
                        <strong>@row.AppNo</strong>
                        <span>@row.Status</span>
                    </div>
                    @foreach (var item in _actionItems)
                    {
                        <button type="button"
                                class="um-action-menu-item @(item.Text == "Reject" ? "um-action-menu-item--danger" : null)"
                                role="menuitem"
                                @onclick="() => HandleActionAsync(item.Text)">
                            <i class="@item.IconCss" aria-hidden="true"></i>
                            <span>@item.Text</span>
                        </button>
                    }
                </div>
            }
        </div>;

    void ToggleActionMenu(AppRow row)
    {
        _selected = row;
        _openActionMenuFor = _openActionMenuFor == row.AppId ? null : row.AppId;
    }

    RenderFragment KpiCard(string icon, string label, string val, string css, string? filterKey)
    {
        var isActive = _kpiFilter == filterKey;
        var cardClass = $"sa-kpi-card {css} {(isActive ? "sa-kpi-active" : string.Empty)}";
        var title = filterKey is null ? "Show all" : isActive ? "Clear filter" : $"Filter by {label}";
        return @<button type="button"
                        class="@cardClass"
                        @onclick="() => ToggleKpiFilter(filterKey)"
                        title="@title">
            <div class="sa-kpi-val">@val</div>
            <div class="sa-kpi-lbl"><i class="bi @icon" aria-hidden="true"></i> @label</div>
        </button>;
    }

    static string Initials(string value)
    {
        var words = value.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (words.Length == 0) return "A";
        if (words.Length == 1) return words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant();
        return string.Concat(words.Take(2).Select(w => char.ToUpperInvariant(w[0])));
    }

    sealed class ApplicationActionForm : IValidatableObject
    {
        [StringLength(80)] public string? CarrierIdText { get; set; }
        [Range(0, 999999999999)] public decimal? AnnualPremium { get; set; }
        public DateTime? DueDate { get; set; }
        [Range(0, 100)] public int? Completeness { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
        string _action = string.Empty;

        public void Reset(AppRow row, string action)
        {
            _action = action;
            CarrierIdText = row.CarrierId == Guid.Empty ? string.Empty : row.CarrierId.ToString();
            AnnualPremium = row.TargetPremium is > 0 ? row.TargetPremium : null;
            DueDate = row.DueDate == default ? DateTime.Today.AddDays(7) : row.DueDate;
            Completeness = row.Completeness;
            Notes = action switch
            {
                "Add Requirements" => "Outstanding requirements: signed application, loss runs, and supplemental underwriting details.",
                "Request Info" => "Please confirm missing application details and return supporting documents.",
                "Reject" => "Application rejected due to underwriting eligibility or incomplete requirements.",
                "Submit to Carrier" => "Application package reviewed and ready for carrier submission.",
                "Mark Approved" => "Application approved for quote workflow.",
                "Download App" => "Generate current application packet for distribution.",
                _ => string.Empty
            };
        }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!string.IsNullOrWhiteSpace(CarrierIdText) && !Guid.TryParse(CarrierIdText, out _))
                yield return new ValidationResult("Carrier ID must be a valid GUID.", [nameof(CarrierIdText)]);

            if (_action == "Mark Approved" && AnnualPremium is null or <= 0)
                yield return new ValidationResult("Target premium is required and must be greater than zero.", [nameof(AnnualPremium)]);

            if ((_action is "Add Requirements" or "Request Info") && DueDate is null)
                yield return new ValidationResult("Due date is required.", [nameof(DueDate)]);

            if ((_action is "Add Requirements" or "Request Info" or "Reject") && string.IsNullOrWhiteSpace(Notes))
                yield return new ValidationResult("Notes are required for this action.", [nameof(Notes)]);
        }
    }
}
