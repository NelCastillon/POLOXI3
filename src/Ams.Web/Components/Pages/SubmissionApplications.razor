    sealed class ApplicationActionForm : IValidatableObject
    {
        [StringLength(80)] public string? CarrierIdText { get; set; }
        [Range(0, 999999999999)] public decimal? AnnualPremium { get; set; }
        public DateTime? DueDate { get; set; }
        [Range(0, 100)] public int? Completeness { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
        string _action = string.Empty;

        public void Reset(AppRow row, string action)
        {
            _action = action;
            CarrierIdText = row.CarrierId == Guid.Empty ? string.Empty : row.CarrierId.ToString();
            AnnualPremium = row.TargetPremium is > 0 ? row.TargetPremium : null;
            DueDate = row.DueDate == default ? DateTime.Today.AddDays(7) : row.DueDate;
            Completeness = row.Completeness;
            Notes = action switch
            {
                "Add Requirements" => "Outstanding requirements: signed application, loss runs, and supplemental underwriting details.",
                "Request Info" => "Please confirm missing application details and return supporting documents.",
                "Reject" => "Application rejected due to underwriting eligibility or incomplete requirements.",
                "Submit to Carrier" => "Application package reviewed and ready for carrier submission.",
                "Mark Approved" => "Application approved for quote workflow.",
                "Download App" => "Generate current application packet for distribution.",
                _ => string.Empty
            };
        }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!string.IsNullOrWhiteSpace(CarrierIdText) && !Guid.TryParse(CarrierIdText, out _))
                yield return new ValidationResult("Carrier ID must be a valid GUID.", [nameof(CarrierIdText)]);

            if (_action == "Mark Approved" && AnnualPremium is null or <= 0)
                yield return new ValidationResult("Target premium is required and must be greater than zero.", [nameof(AnnualPremium)]);

            if ((_action is "Add Requirements" or "Request Info") && DueDate is null)
                yield return new ValidationResult("Due date is required.", [nameof(DueDate)]);

            if ((_action is "Add Requirements" or "Request Info" or "Reject") && string.IsNullOrWhiteSpace(Notes))
                yield return new ValidationResult("Notes are required for this action.", [nameof(Notes)]);
        }
    }

    sealed record TabDef(string Key, string Label, string Icon);
    sealed record ActionDef(string Key, string Label, string Icon, bool IsDanger);
    sealed record GroupSummary(string Name, int Count, decimal Premium, int Priority, double AverageComplete, int Percent);
    sealed record InsightDef(string Title, string Description, string Icon);
    sealed record ToastMessage(Guid Id, string Message, string CssClass);
}
