@page "/submissions/applications"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Submissions
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject CurrentUserContext CurrentUser

<PageTitle>Application Command Center â€” AMS</PageTitle>

<div class="sa-page">
    <section class="sa-hero">
        <div class="sa-hero__content">
            <div class="sa-hero__eyebrow"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Enterprise application command center</div>
            <h1>Application Tracking Desk</h1>
            <p>Prioritize incomplete applications, monitor carrier submission readiness, manage requirement follow-up, and move approved applications into quote workflows.</p>
            <div class="sa-hero__meta">
                <span><i class="bi bi-stack" aria-hidden="true"></i>@TotalApplicationCount applications</span>
                <span><i class="bi bi-exclamation-diamond" aria-hidden="true"></i>@PriorityApplicationCount priority</span>
                <span><i class="bi bi-percent" aria-hidden="true"></i>@AverageCompletenessText average complete</span>
                <span><i class="bi bi-building" aria-hidden="true"></i>@CarrierCount carrier groups</span>
            </div>
        </div>
        <div class="sa-hero__actions">
            <button type="button" class="sa-btn sa-btn--light" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @_refreshIconClass" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="sa-btn sa-btn--primary" @onclick='() => Nav.NavigateTo("/submissions/new")'>
                <i class="bi bi-plus-lg" aria-hidden="true"></i> New Application
            </button>
            <button type="button" class="sa-btn sa-btn--light" @onclick='() => Nav.NavigateTo("/submissions")'>
                <i class="bi bi-send" aria-hidden="true"></i> Submissions
            </button>
            <button type="button" class="sa-btn sa-btn--light" @onclick='() => Nav.NavigateTo("/submissions/quotes")'>
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Quotes
            </button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger sa-alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="sa-kpi-strip" aria-label="Application KPIs">
        @KpiCard("all", "Total Apps", TotalApplicationCount.ToString(), "All application records from submission workflow", "bi-stack", "blue")
        @KpiCard("priority", "Priority", PriorityApplicationCount.ToString(), "Incomplete, overdue, high-value, or requirement-heavy applications", "bi-exclamation-octagon", "red")
        @KpiCard("submitted", "Submitted", SubmittedApplicationCount.ToString(), "Applications submitted or ready for carrier review", "bi-send", "cyan")
        @KpiCard("requirements", "Requirements", RequirementsApplicationCount.ToString(), "Applications waiting on missing information", "bi-paperclip", "amber")
        @KpiCard("approved", "Approved", ApprovedApplicationCount.ToString(), "Applications ready for quote workflow", "bi-check-circle", "green")
        @KpiCard("complete", "Avg Complete", AverageCompletenessText, "Average application completeness", "bi-percent", "emerald")
    </section>

    <section class="sa-workflows" aria-label="Application workflows">
        <button type="button" class="sa-workflow" @onclick="ShowPriorityQueue">
            <i class="bi bi-lightning-charge" aria-hidden="true"></i>
            <span><strong>Priority queue</strong><small>Open highest-importance application work</small></span>
        </button>
        <button type="button" class="sa-workflow" @onclick="ShowRequirementsQueue">
            <i class="bi bi-paperclip" aria-hidden="true"></i>
            <span><strong>Requirements</strong><small>Follow up on missing application items</small></span>
        </button>
        <button type="button" class="sa-workflow" @onclick="ShowCarrierView">
            <i class="bi bi-building" aria-hidden="true"></i>
            <span><strong>Carrier view</strong><small>Analyze applications by market</small></span>
        </button>
        <button type="button" class="sa-workflow" @onclick="ShowApprovedQueue">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            <span><strong>Approved apps</strong><small>Move approved applications into quotes</small></span>
        </button>
        <button type="button" class="sa-workflow" @onclick="ShowLobView">
            <i class="bi bi-layers" aria-hidden="true"></i>
            <span><strong>LOB view</strong><small>Review application quality by line</small></span>
        </button>
    </section>

    <section class="sa-filter-panel" aria-label="Application filters">
        <div class="sa-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input @bind="SearchText" @bind:event="oninput" placeholder="Search app #, submission, account, LOB, carrier, status, producer, premium, due date, priorityâ€¦" />
        </div>
        <div class="sa-filter-grid">
            <label>
                <span>Status</span>
                <select class="form-select" @bind="StatusFilter">
                    <option value="">All statuses</option>
                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </label>
            <label>
                <span>Carrier</span>
                <select class="form-select" @bind="CarrierFilter">
                    <option value="">All carriers</option>
                    @foreach (var carrier in CarrierOptions)
                    {
                        <option value="@carrier">@carrier</option>
                    }
                </select>
            </label>
            <label>
                <span>Line of Business</span>
                <select class="form-select" @bind="LobFilter">
                    <option value="">All lines</option>
                    @foreach (var lob in LobOptions)
                    {
                        <option value="@lob">@lob</option>
                    }
                </select>
            </label>
            <label>
                <span>Sort</span>
                <select class="form-select" @bind="SortMode">
                    <option value="importance">Importance</option>
                    <option value="due">Due date</option>
                    <option value="complete">Completeness</option>
                    <option value="premium">Premium</option>
                    <option value="status">Status</option>
                    <option value="carrier">Carrier</option>
                </select>
            </label>
        </div>
        <button type="button" class="sa-btn sa-btn--ghost" @onclick="ClearFilters" disabled="@(!HasFilters)">
            <i class="bi bi-x-lg" aria-hidden="true"></i> Reset
        </button>
    </section>

    <nav class="sa-tabs" aria-label="Application views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="@TabClass(tab.Key)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </nav>

    <main class="sa-dashboard">
        <section class="sa-main-card">
            <div class="sa-card-header">
                <div>
                    <span class="sa-section-kicker">@ActiveViewTitle</span>
                    <h2>@FilteredRows.Count() applications</h2>
                    <p>Ranked by enterprise importance: completeness, due date risk, workflow status, premium opportunity, market readiness, and follow-up urgency.</p>
                </div>
                <div class="sa-card-actions">
                    <button type="button" class="sa-btn sa-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i> Previous
                    </button>
                    <span class="sa-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="sa-btn sa-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">
                        Next <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="sa-loading"><span class="sa-spinner"></span> Loading applicationsâ€¦</div>
            }
            else if (!FilteredRows.Any())
            {
                <div class="sa-empty">
                    <i class="bi bi-clipboard" aria-hidden="true"></i>
                    <strong>No applications found</strong>
                    <span>Adjust filters or create a new submission application.</span>
                </div>
            }
            else if (_activeTab == "carrier")
            {
                <div class="sa-carrier-grid">
                    @foreach (var group in CarrierRows)
                    {
                        <article class="sa-carrier-card">
                            <div class="sa-carrier-card__head">
                                <div>
                                    <span>Carrier market</span>
                                    <h3>@group.Name</h3>
                                </div>
                                <strong>@group.Count</strong>
                            </div>
                            <p>@group.AverageComplete.ToString("0")% average complete â€¢ @group.Priority priority â€¢ @group.Premium.ToString("C0") target premium</p>
                            <div class="sa-mini-bar"><span style="width:@group.Percent%"></span></div>
                            <button type="button" class="sa-btn sa-btn--ghost" @onclick="() => FilterByCarrier(group.Name)">View carrier</button>
                        </article>
                    }
                </div>
            }
            else if (_activeTab == "lob")
            {
                <div class="sa-lob-grid">
                    @foreach (var group in LobRows)
                    {
                        <article class="sa-lob-card">
                            <div class="sa-lob-icon"><i class="bi bi-layers" aria-hidden="true"></i></div>
                            <div>
                                <h3>@group.Name</h3>
                                <p>@group.Count apps â€¢ @group.AverageComplete.ToString("0")% complete â€¢ @group.Priority priority</p>
                                <div class="sa-mini-bar"><span style="width:@group.Percent%"></span></div>
                            </div>
                            <button type="button" class="sa-btn sa-btn--ghost" @onclick="() => FilterByLob(group.Name)">Open</button>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="sa-table-wrap">
                    <table class="sa-table">
                        <thead>
                            <tr>
                                <th>Importance</th>
                                <th>Application</th>
                                <th>Submission</th>
                                <th>Account</th>
                                <th>LOB</th>
                                <th>Carrier</th>
                                <th>Status</th>
                                <th>Complete</th>
                                <th>Target Premium</th>
                                <th>Submitted</th>
                                <th>Due</th>
                                <th>Producer</th>
                                <th class="sa-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in PagedRows)
                            {
                                <tr class="@RowClass(row)" @onclick="() => SelectRow(row)">
                                    <td>@ImportanceBadge(row)</td>
                                    <td>
                                        <button type="button" class="sa-link-button" @onclick:stopPropagation="true" @onclick="() => OpenApplication(row)">@row.AppNo</button>
                                        <small>@row.Priority priority</small>
                                    </td>
                                    <td>
                                        <button type="button" class="sa-sub-link" @onclick:stopPropagation="true" @onclick="() => OpenApplication(row)">@row.SubmissionNo</button>
                                    </td>
                                    <td><strong>@row.Account</strong></td>
                                    <td><span class="sa-lob-pill">@Safe(row.Lob, "Unknown")</span></td>
                                    <td>@Safe(row.Carrier, "Not Assigned")</td>
                                    <td>@StatusBadge(row.Status)</td>
                                    <td>@CompletenessBar(row)</td>
                                    <td>@MoneyOrDash(row.TargetPremium)</td>
                                    <td>@row.SubmittedDate.ToString("MMM d, yyyy")</td>
                                    <td>@DueBadge(row)</td>
                                    <td>@Safe(row.Producer, "Unassigned")</td>
                                    <td class="sa-actions-col">
                                        <button type="button" class="sa-icon-btn" title="Open action menu" @onclick:stopPropagation="true" @onclick="() => ToggleActionMenu(row)">
                                            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                        </button>
                                        @if (_openActionMenuFor == row.AppId)
                                        {
                                            <div class="sa-menu" role="menu" @onclick:stopPropagation="true">
                                                <div class="sa-menu__summary">
                                                    <strong>@row.AppNo</strong>
                                                    <span>@row.Status</span>
                                                </div>
                                                @foreach (var action in _actions)
                                                {
                                                    <button type="button" class="@ActionMenuItemClass(action)" role="menuitem" @onclick="() => HandleActionAsync(action.Key)">
                                                        <i class="bi @action.Icon" aria-hidden="true"></i>
                                                        <span>@action.Label</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="sa-side-panel">
            <section class="sa-panel-card">
                <span class="sa-section-kicker">Selected application</span>
                @if (_selected is null)
                {
                    <div class="sa-empty sa-empty--compact">
                        <i class="bi bi-cursor" aria-hidden="true"></i>
                        <strong>Select an application</strong>
                        <span>Choose an application to review status, requirements, and workflow actions.</span>
                    </div>
                }
                else
                {
                    <div class="sa-selected">
                        <div class="sa-selected__title">
                            <h3>@_selected.AppNo</h3>
                            @StatusBadge(_selected.Status)
                        </div>
                        <p>@_selected.Account â€¢ @_selected.Carrier</p>
                        <div class="sa-score-card">
                            <span>Importance score</span>
                            <strong>@ImportanceScore(_selected)</strong>
                            <small>@ImportanceLevel(_selected)</small>
                        </div>
                        <dl class="sa-detail-list">
                            <div><dt>Submission</dt><dd>@_selected.SubmissionNo</dd></div>
                            <div><dt>LOB</dt><dd>@Safe(_selected.Lob, "Unknown")</dd></div>
                            <div><dt>Complete</dt><dd>@_selected.Completeness%</dd></div>
                            <div><dt>Target Premium</dt><dd>@MoneyText(_selected.TargetPremium)</dd></div>
                            <div><dt>Markets</dt><dd>@_selected.MarketCount</dd></div>
                            <div><dt>Quotes</dt><dd>@_selected.QuoteCount</dd></div>
                            <div><dt>Effective</dt><dd>@_selected.EffectiveDate.ToString("MMM d, yyyy")</dd></div>
                            <div><dt>Due</dt><dd>@_selected.DueDate.ToString("MMM d, yyyy")</dd></div>
                            <div><dt>Producer</dt><dd>@Safe(_selected.Producer, "Unassigned")</dd></div>
                        </dl>
                        <div class="sa-selected-actions">
                            <button type="button" class="sa-btn sa-btn--primary" @onclick="() => OpenApplication(_selected)"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open Submission</button>
                            <button type="button" class="sa-btn sa-btn--ghost" @onclick='() => OpenActionDialog("Submit to Carrier")'><i class="bi bi-send" aria-hidden="true"></i> Submit</button>
                            <button type="button" class="sa-btn sa-btn--ghost" @onclick='() => OpenActionDialog("Mark Approved")'><i class="bi bi-check-circle" aria-hidden="true"></i> Approve</button>
                        </div>
                    </div>
                }
            </section>

            <section class="sa-panel-card">
                <span class="sa-section-kicker">Application intelligence</span>
                <div class="sa-insight-list">
                    @foreach (var insight in Insights)
                    {
                        <div class="sa-insight">
                            <i class="bi @insight.Icon" aria-hidden="true"></i>
                            <div>
                                <strong>@insight.Title</strong>
                                <span>@insight.Description</span>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </aside>
    </main>
</div>

@if (_showActionDialog && _selected is not null)
{
    <div class="sa-modal-backdrop" role="presentation" @onclick="CloseActionDialog">
        <div class="sa-modal" role="dialog" aria-modal="true" aria-labelledby="sa-action-title" @onclick:stopPropagation="true">
            <div class="sa-modal__header">
                <i class="bi @_actionIcon" aria-hidden="true"></i>
                <span id="sa-action-title">@_actionTitle</span>
                <button type="button" class="sa-icon-btn sa-icon-btn--light ms-auto" @onclick="CloseActionDialog" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_actionForm" OnValidSubmit="ConfirmActionAsync" OnInvalidSubmit="NotifyActionValidationAsync">
                <DataAnnotationsValidator />
                <div class="sa-modal__body">
                    <div class="sa-modal-intro">
                        <strong>@_actionHelpText</strong>
                        <span>@_selected.AppNo â€” @_selected.Account â€” @_selected.Carrier</span>
                    </div>
                    <div class="sa-form-grid">
                        @if (_pendingAction is "Submit to Carrier" or "Mark Approved")
                        {
                            <label class="sa-field sa-field--full">
                                <span>Carrier ID</span>
                                <InputText class="form-control" @bind-Value="_actionForm.CarrierIdText" placeholder="Optional carrier GUID" />
                            </label>
                        }
                        @if (_pendingAction == "Mark Approved")
                        {
                            <label class="sa-field">
                                <span>Target Premium <em>*</em></span>
                                <InputNumber class="form-control" @bind-Value="_actionForm.AnnualPremium" />
                            </label>
                        }
                        @if (_pendingAction is "Add Requirements" or "Request Info")
                        {
                            <label class="sa-field">
                                <span>Due Date <em>*</em></span>
                                <InputDate class="form-control" @bind-Value="_actionForm.DueDate" />
                            </label>
                        }
                        @if (_pendingAction == "Add Requirements")
                        {
                            <label class="sa-field">
                                <span>Completeness Target</span>
                                <InputNumber class="form-control" @bind-Value="_actionForm.Completeness" />
                            </label>
                        }
                        <label class="sa-field sa-field--full">
                            <span>@ActionNotesLabel</span>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_actionForm.Notes" />
                        </label>
                    </div>
                </div>
                <div class="sa-modal__footer">
                    <button type="button" class="sa-btn sa-btn--ghost" @onclick="CloseActionDialog" disabled="@_actionBusy">Cancel</button>
                    <button type="submit" class="sa-btn sa-btn--primary" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @_actionButtonText
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showConfirmDialog)
{
    <div class="sa-modal-backdrop" role="presentation" @onclick="CloseConfirmDialog">
        <div class="sa-confirm" role="dialog" aria-modal="true" aria-labelledby="sa-confirm-title" @onclick:stopPropagation="true">
            <div class="sa-modal__header">
                <i class="bi @_confirmIcon" aria-hidden="true"></i>
                <span>Confirm application action</span>
                <button type="button" class="sa-icon-btn sa-icon-btn--light ms-auto" @onclick="CloseConfirmDialog" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="sa-confirm__body">
                <div class="@ConfirmIconClass">
                    <i class="bi @_confirmIcon" aria-hidden="true"></i>
                </div>
                <div>
                    <h3 id="sa-confirm-title">@_confirmTitle</h3>
                    <p>@_confirmMessage</p>
                </div>
            </div>
            <div class="sa-modal__footer">
                <button type="button" class="sa-btn sa-btn--ghost" @onclick="CloseConfirmDialog" disabled="@_actionBusy">Cancel</button>
                <button type="button" class="@ConfirmButtonClass" @onclick="ExecuteConfirmedActionAsync" disabled="@_actionBusy">
                    @if (_actionBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<div class="sa-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="sa-toast @toast.CssClass">
            <i class="bi @ToastIconClass(toast)" aria-hidden="true"></i>
            <span>@toast.Message</span>
            <button type="button" @onclick="() => DismissToast(toast.Id)"><i class="bi bi-x" aria-hidden="true"></i></button>
        </div>
    }
</div>

@code {
    bool _loading;
    bool _showActionDialog;
    bool _showConfirmDialog;
    bool _actionBusy;
    string _activeTab = "all";
    string _activeKpi = "all";
    string _sortMode = "importance";
    string? _loadError;
    string? _searchText;
    string? _statusFilter;
    string? _carrierFilter;
    string? _lobFilter;
    string _refreshIconClass = string.Empty;
    Guid? _openActionMenuFor;
    Guid _tenantId;
    int _page = 1;
    const int PageSize = 18;

    AppRow? _selected;
    readonly ApplicationActionForm _actionForm = new();
    readonly List<AppRow> _rows = [];
    readonly List<ToastMessage> _toasts = [];
    List<SubmissionOption> _applicationStatusOptions = [];
    List<SubmissionOption> _lobOptions = [];
    string _pendingAction = string.Empty;
    string _actionTitle = "Application Action";
    string _actionIcon = "bi-clipboard";
    string _actionButtonText = "Continue";
    string _actionHelpText = string.Empty;
    string _confirmTitle = "Confirm action";
    string _confirmMessage = "Confirm this application action?";
    string _confirmIcon = "bi-question-circle";

    readonly TabDef[] _tabs =
    [
        new("all", "All", "bi-stack"),
        new("priority", "Priority", "bi-lightning-charge"),
        new("draft", "Draft", "bi-pencil-square"),
        new("submitted", "Submitted", "bi-send"),
        new("review", "Under Review", "bi-hourglass-split"),
        new("reqs", "Requirements", "bi-paperclip"),
        new("approved", "Approved", "bi-check-circle"),
        new("carrier", "Carrier", "bi-building"),
        new("lob", "LOB", "bi-layers"),
    ];

    readonly ActionDef[] _actions =
    [
        new("Open", "Open Submission", "bi-box-arrow-up-right", false),
        new("Submit to Carrier", "Submit to Carrier", "bi-send", false),
        new("Add Requirements", "Add Requirements", "bi-paperclip", false),
        new("Request Info", "Request Info", "bi-question-circle", false),
        new("Mark Approved", "Mark Approved", "bi-check-circle", false),
        new("Download App", "Generate Packet", "bi-file-earmark-pdf", false),
        new("Reject", "Reject", "bi-x-circle", true),
    ];

    string AverageCompletenessText => _rows.Count == 0 ? "0%" : $"{_rows.Average(r => r.Completeness):0}%";
    int TotalApplicationCount => _rows.Count;
    int PriorityApplicationCount => PriorityRows.Count();
    int SubmittedApplicationCount => _rows.Count(r => r.Status == "Submitted");
    int RequirementsApplicationCount => _rows.Count(r => r.Status == "Requirements Pending");
    int ApprovedApplicationCount => _rows.Count(r => r.Status == "Approved");
    int CarrierCount => _rows.Select(r => Safe(r.Carrier, "Not Assigned")).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    bool HasFilters => _activeKpi != "all" || !string.IsNullOrWhiteSpace(_searchText) || !string.IsNullOrWhiteSpace(_statusFilter) || !string.IsNullOrWhiteSpace(_carrierFilter) || !string.IsNullOrWhiteSpace(_lobFilter);
    string ActiveViewTitle => _tabs.FirstOrDefault(t => t.Key == _activeTab)?.Label ?? "All";
    string ConfirmIconClass => _pendingAction == "Reject" ? "sa-confirm-icon sa-confirm-icon--danger" : "sa-confirm-icon";
    string ConfirmButtonClass => _pendingAction == "Reject" ? "sa-btn sa-btn--danger" : "sa-btn sa-btn--primary";
    string ActionNotesLabel => _pendingAction switch
    {
        "Add Requirements" => "Requirements",
        "Request Info" => "Information Request",
        "Reject" => "Rejection Reason",
        _ => "Notes"
    };

    string? SearchText { get => _searchText; set { _searchText = value; _page = 1; } }
    string? StatusFilter { get => _statusFilter; set { _statusFilter = value; _page = 1; } }
    string? CarrierFilter { get => _carrierFilter; set { _carrierFilter = value; _page = 1; } }
    string? LobFilter { get => _lobFilter; set { _lobFilter = value; _page = 1; } }
    string SortMode { get => _sortMode; set { _sortMode = value; _page = 1; } }

    IEnumerable<string> StatusOptions => MergeOptions(_applicationStatusOptions.Select(o => o.Code), _rows.Select(r => r.Status));
    IEnumerable<string> CarrierOptions => _rows.Select(r => Safe(r.Carrier, "Not Assigned")).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);
    IEnumerable<string> LobOptions => MergeOptions(_lobOptions.Select(o => o.Code), _rows.Select(r => Safe(r.Lob, "Unknown")));
    IEnumerable<AppRow> PriorityRows => _rows.Where(r => ImportanceLevel(r) is "Critical" or "High");
    IEnumerable<AppRow> OverdueRows => _rows.Where(r => DaysUntilDue(r) < 0 && r.Status is not "Approved" and not "Rejected");

    IEnumerable<AppRow> TabRows => _activeTab switch
    {
        "priority" => PriorityRows,
        "draft" => _rows.Where(r => r.Status == "Draft"),
        "submitted" => _rows.Where(r => r.Status == "Submitted"),
        "review" => _rows.Where(r => r.Status == "Under Review"),
        "reqs" => _rows.Where(r => r.Status == "Requirements Pending"),
        "approved" => _rows.Where(r => r.Status == "Approved"),
        "carrier" => _rows,
        "lob" => _rows,
        _ => _rows
    };

    IEnumerable<AppRow> FilteredRows => SortRows(ApplyFilters(TabRows));
    IEnumerable<AppRow> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize);
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)PageSize));

    IEnumerable<GroupSummary> CarrierRows
    {
        get
        {
            var groups = FilteredRows.GroupBy(r => Safe(r.Carrier, "Not Assigned")).ToList();
            var max = Math.Max(1, groups.Count == 0 ? 1 : groups.Max(g => g.Count()));
            return groups.Select(g => new GroupSummary(g.Key, g.Count(), g.Sum(x => x.TargetPremium ?? 0), g.Count(x => ImportanceLevel(x) is "Critical" or "High"), g.Average(x => x.Completeness), Math.Max(8, (int)Math.Round(g.Count() * 100m / max))))
                .OrderByDescending(g => g.Priority)
                .ThenByDescending(g => g.Premium);
        }
    }

    IEnumerable<GroupSummary> LobRows
    {
        get
        {
            var groups = FilteredRows.GroupBy(r => Safe(r.Lob, "Unknown")).ToList();
            var max = Math.Max(1, groups.Count == 0 ? 1 : groups.Max(g => g.Count()));
            return groups.Select(g => new GroupSummary(g.Key, g.Count(), g.Sum(x => x.TargetPremium ?? 0), g.Count(x => ImportanceLevel(x) is "Critical" or "High"), g.Average(x => x.Completeness), Math.Max(8, (int)Math.Round(g.Count() * 100m / max))))
                .OrderByDescending(g => g.Count);
        }
    }

    IEnumerable<InsightDef> Insights =>
    [
        new("Requirement risk", $"{RequirementsApplicationCount} applications have outstanding requirements.", "bi-paperclip"),
        new("Overdue follow-up", $"{OverdueRows.Count()} applications are past due and need review.", "bi-clock-history"),
        new("Carrier readiness", $"{SubmittedApplicationCount} submitted applications are available for market workflow.", "bi-building"),
        new("Approval pipeline", $"{ApprovedApplicationCount} applications are ready for quote workflow.", "bi-check-circle")
    ];

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Submissions", "/submissions"), new("Applications", "/submissions/applications"));
        await LoadReferenceDataAsync();
        await LoadAsync();
    }

    async Task LoadReferenceDataAsync()
    {
        var options = await Api.GetSubmissionReferenceOptionsAsync(_tenantId);
        var activeOptions = options?.Where(o => o.IsActive).ToList() ?? [];
        _applicationStatusOptions = ToOptions(activeOptions, "ApplicationStatus");
        _lobOptions = ToOptions(activeOptions, "LineOfBusiness");
    }

    async Task LoadAsync()
    {
        _loading = true;
        _refreshIconClass = "sa-spin";
        _loadError = null;
        try
        {
            var result = await Api.SearchSubmissionsAsync(_tenantId, pageSize: 500);
            _rows.Clear();
            _rows.AddRange((result?.Items ?? []).Select(ToAppRow));
            _selected = _selected is null ? _rows.OrderByDescending(ImportanceScore).FirstOrDefault() : _rows.FirstOrDefault(r => r.AppId == _selected.AppId) ?? _rows.OrderByDescending(ImportanceScore).FirstOrDefault();
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load applications: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "sa-toast--danger");
        }
        finally
        {
            _loading = false;
            _refreshIconClass = string.Empty;
        }
    }

    static AppRow ToAppRow(SubmissionDto dto)
    {
        var row = ToApplicationRow(dto);
        return new AppRow
        {
            AppId = row.AppId,
            AppNo = row.AppNo,
            SubmissionNo = row.SubmissionNo,
            SubId = row.SubId,
            Account = row.Account,
            Lob = row.Lob,
            Carrier = dto.MarketCount > 1 ? "Multiple Markets" : row.Carrier,
            Status = DeriveApplicationStatus(dto),
            Completeness = DeriveCompleteness(dto),
            SubmittedDate = row.SubmittedDate,
            DueDate = row.DueDate,
            Producer = row.Producer,
            TargetPremium = dto.TargetPremium,
            EffectiveDate = dto.EffectiveDate,
            ExpirationDate = dto.ExpirationDate,
            Priority = string.IsNullOrWhiteSpace(dto.Priority) ? "Normal" : dto.Priority,
            MarketCount = dto.MarketCount,
            QuoteCount = dto.QuoteCount
        };
    }

    static string DeriveApplicationStatus(SubmissionDto dto) => dto.Status switch
    {
        "Draft" => "Draft",
        "New" => "Submitted",
        "In Review" => dto.MarketCount > 0 && dto.QuoteCount == 0 ? "Under Review" : "Requirements Pending",
        "Quoted" or "Bound" => "Approved",
        "Declined" or "Withdrawn" => "Rejected",
        _ => "Submitted"
    };

    static int DeriveCompleteness(SubmissionDto dto) => dto.Status switch
    {
        "Draft" => 35,
        "New" => dto.MarketCount > 0 ? 65 : 55,
        "In Review" => dto.MarketCount > 0 ? 82 : 72,
        "Quoted" or "Bound" => 100,
        "Declined" or "Withdrawn" => 100,
        _ => 60
    };

    IEnumerable<AppRow> ApplyFilters(IEnumerable<AppRow> rows)
    {
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim();
            rows = rows.Where(r => Contains(r.AppNo, term)
                || Contains(r.SubmissionNo, term)
                || Contains(r.Account, term)
                || Contains(r.Lob, term)
                || Contains(r.Carrier, term)
                || Contains(r.Status, term)
                || Contains(r.Producer, term)
                || Contains(r.Priority, term)
                || Contains(r.AppId.ToString(), term)
                || Contains(r.SubId.ToString(), term)
                || Contains(r.Completeness.ToString(), term)
                || Contains($"{r.Completeness}%", term)
                || Contains(r.SubmittedDate.ToString("MM/dd/yyyy"), term)
                || Contains(r.DueDate.ToString("MM/dd/yyyy"), term)
                || Contains(r.EffectiveDate.ToString("MM/dd/yyyy"), term)
                || Contains(r.TargetPremium?.ToString("C0"), term)
                || Contains(r.TargetPremium?.ToString("0.##"), term)
                || Contains(r.MarketCount.ToString(), term)
                || Contains(r.QuoteCount.ToString(), term));
        }

        if (!string.IsNullOrWhiteSpace(_statusFilter))
        {
            rows = rows.Where(r => string.Equals(r.Status, _statusFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_carrierFilter))
        {
            rows = rows.Where(r => string.Equals(Safe(r.Carrier, "Not Assigned"), _carrierFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_lobFilter))
        {
            rows = rows.Where(r => string.Equals(Safe(r.Lob, "Unknown"), _lobFilter, StringComparison.OrdinalIgnoreCase));
        }

        rows = _activeKpi switch
        {
            "priority" => rows.Where(r => ImportanceLevel(r) is "Critical" or "High"),
            "submitted" => rows.Where(r => r.Status == "Submitted"),
            "requirements" => rows.Where(r => r.Status == "Requirements Pending"),
            "approved" => rows.Where(r => r.Status == "Approved"),
            "complete" => rows.Where(r => r.Completeness >= 90),
            _ => rows
        };

        return rows;
    }

    IEnumerable<AppRow> SortRows(IEnumerable<AppRow> rows) => _sortMode switch
    {
        "due" => rows.OrderBy(r => r.DueDate),
        "complete" => rows.OrderBy(r => r.Completeness).ThenBy(r => r.DueDate),
        "premium" => rows.OrderByDescending(r => r.TargetPremium ?? 0),
        "status" => rows.OrderBy(r => r.Status).ThenBy(r => r.DueDate),
        "carrier" => rows.OrderBy(r => Safe(r.Carrier, "Not Assigned")).ThenBy(r => r.DueDate),
        _ => rows.OrderByDescending(ImportanceScore).ThenBy(r => r.DueDate)
    };

    int ImportanceScore(AppRow row)
    {
        var score = 0;
        score += row.Status switch
        {
            "Requirements Pending" => 34,
            "Under Review" => 28,
            "Submitted" => 22,
            "Draft" => 14,
            "Approved" => 18,
            "Rejected" => 4,
            _ => 10
        };

        var due = DaysUntilDue(row);
        score += due switch
        {
            < 0 => 30,
            <= 3 => 24,
            <= 7 => 16,
            <= 14 => 8,
            _ => 0
        };

        score += row.Completeness switch
        {
            < 45 => 16,
            < 70 => 10,
            < 90 => 5,
            _ => 0
        };

        if (row.Priority.Contains("Critical", StringComparison.OrdinalIgnoreCase)) score += 20;
        else if (row.Priority.Contains("High", StringComparison.OrdinalIgnoreCase)) score += 14;
        if ((row.TargetPremium ?? 0) >= 100000) score += 8;
        if (row.MarketCount == 0 && row.Status is "Submitted" or "Under Review") score += 6;
        if (row.QuoteCount > 0) score += 4;

        return Math.Clamp(score, 0, 100);
    }

    string ImportanceLevel(AppRow row) => ImportanceScore(row) switch
    {
        >= 78 => "Critical",
        >= 58 => "High",
        >= 36 => "Medium",
        _ => "Standard"
    };

    int DaysUntilDue(AppRow row) => (int)Math.Floor((row.DueDate.Date - DateTime.Today).TotalDays);

