@page "/iam/privileged-access"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>Privileged Access</PageTitle>
<AppPageHeader Title="Privileged Access Management" Icon="bi-grid" />
<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(PrivilegedAccessRequestDto.RequestedByFullName)" HeaderText="Requested By"   Width="170"></GridColumn>
        <GridColumn Field="@nameof(PrivilegedAccessRequestDto.TargetRoleName)"      HeaderText="Target Role"    Width="170"></GridColumn>
        <GridColumn Field="@nameof(PrivilegedAccessRequestDto.StatusCode)"          HeaderText="Status"         Width="110"></GridColumn>
        <GridColumn Field="@nameof(PrivilegedAccessRequestDto.RequestedStartDateUtc)" HeaderText="Start"        Width="140" Type="ColumnType.DateTime" Format="MM/dd/yyyy HH:mm"></GridColumn>
        <GridColumn Field="@nameof(PrivilegedAccessRequestDto.RequestedEndDateUtc)"   HeaderText="End"          Width="140" Type="ColumnType.DateTime" Format="MM/dd/yyyy HH:mm"></GridColumn>
        <GridColumn Field="@nameof(PrivilegedAccessRequestDto.ApprovedByFullName)"   HeaderText="Approved By"   Width="150"></GridColumn>
        <GridColumn Field="@nameof(PrivilegedAccessRequestDto.ApprovalDateUtc)"      HeaderText="Approval Date" Width="140" Type="ColumnType.DateTime" Format="MM/dd/yyyy"></GridColumn>
        <GridColumn Field="@nameof(PrivilegedAccessRequestDto.RevokedReason)"        HeaderText="Revoke Reason" Width="200"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private Guid DefaultTenantId { get; set; }
    private string? _searchTerm;
    private List<PrivilegedAccessRequestDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchPrivilegedAccessRequestsAsync(DefaultTenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
