@page "/tenant/settings/notifications"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>Notification Settings — AMS</PageTitle>

<AppPageHeader Title="Notification Settings"
               Subtitle="Configure tenant notification channels, routing, digests, quiet hours, and escalation recipients"
               Icon="bi-bell-gear">
    <Actions>
        <button class="um-btn um-btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> Save Rules</button>
    </Actions>
</AppPageHeader>

<section class="tset-hero" aria-label="Notification settings overview">
    <div>
        <span class="tset-eyebrow">Tenant administration</span>
        <h2>Notification Governance</h2>
        <p>Control tenant-wide delivery channels, digest cadence, escalation paths, and notification policy exceptions.</p>
    </div>
</section>

<section class="tset-kpi-grid" aria-label="Notification metrics">
    @Kpi("Rules", "18", "Active routing rules", "bi-bell-gear", "tset-tone-amber")
    @Kpi("Channels", "4", "Email, SMS, push, in-app", "bi-broadcast", "tset-tone-blue")
    @Kpi("Escalations", "7", "Manager paths", "bi-arrow-up-circle", "tset-tone-red")
    @Kpi("Digest", "Daily", "Default cadence", "bi-calendar-check", "tset-tone-green")
</section>

<section class="tset-layout">
    <TenantSettingsWorkflowManager PageCode="notifications"
                                   Label="Notification settings workflow"
                                   DefaultStage="Notify"
                                   DefaultCategory="Digest Rules" />
    <TenantConfigManager Kind="NotificationSetting"
                         Title="Notification Settings"
                         Subtitle="Configure tenant notification channels, routing, digests, quiet hours, and escalation recipients"
                         Icon="bi bi-bell-gear" />
    <aside class="tset-admin-panel">
        <h3>Notification controls</h3>
        <div class="tset-policy-card">
            <strong>Delivery governance</strong>
            <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Critical alerts bypass digest and quiet hour policies</span>
            <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Role-based routing and escalation recipients audited</span>
            <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Client-facing notification channels respect consent state</span>
        </div>
    </aside>
</section>

@code {
    protected override void OnInitialized() => Breadcrumbs.SetCrumbs(new("Home", "/"), new("Notification Settings", "/tenant/settings/notifications"));

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="tset-kpi-card"><span class="tset-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span><div><strong>@value</strong><span>@label</span><small>@meta</small></div></article>;
}
