        public decimal NewBusinessPremium   { get; set; }
        public double  NewBusinessDelta     { get; set; }
        public int     RenewalAtRiskCount   { get; set; }
        public decimal RenewalAtRiskPremium { get; set; }
        public int     OpenClaimsCount      { get; set; }
