@page "/dashboard/executive"
@namespace Ams.Web.Components.Pages.Dashboards
@using System.Text
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Executive Dashboard</PageTitle>

@if (_toastVisible)
{
    <div class="ed-toast ed-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @ToastIcon" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="ed-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<div class="ed-enterprise-page">
    <section class="ed-hero">
        <div class="ed-hero-left">
            <span class="ed-hero-icon"><i class="bi bi-speedometer2" aria-hidden="true"></i></span>
            <div>
                <div class="ed-title-row">
                    <h1>Executive Dashboard</h1>
                    <span><i class="bi bi-calendar3" aria-hidden="true"></i> @_periodLabel</span>
                    <span><i class="bi bi-database-check" aria-hidden="true"></i> DB synced</span>
                </div>
                <p>Agency-wide command center for premium, retention, growth, claims, receivables, campaigns, and producer execution.</p>
            </div>
        </div>
        <div class="ed-hero-actions">
            <select class="ed-filter-select" @bind="_period" @bind:after="LoadAsync">
                @foreach (var option in _periodOptions)
                {
                    <option value="@option.Value">@option.Label</option>
                }
            </select>
            <button type="button" class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise @(_loading ? "ed-spin" : null)" aria-hidden="true"></i> Refresh</button>
            <button type="button" class="um-btn um-btn-primary" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
        </div>
    </section>

    @if (_loading)
    {
        <div class="ed-loading-banner" aria-live="polite"><i class="bi bi-arrow-repeat ed-spin" aria-hidden="true"></i><span>Loading executive data...</span></div>
    }

    <section class="ed-kpi-strip" aria-label="Executive KPIs">
        <button type="button" class="@PremiumKpiClass" @onclick="SetPremiumKpi"><span class="ed-kpi-icon"><i class="bi bi-cash-coin" aria-hidden="true"></i></span><span><strong>@_kpi.WrittenPremium.ToString("C0")</strong><em>Written Premium</em><small>@($"{Math.Abs(_kpi.WrittenPremiumDelta):F1}% vs prior period")</small></span></button>
        <button type="button" class="@RetentionKpiClass" @onclick="SetRetentionKpi"><span class="ed-kpi-icon"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span><span><strong>@($"{_kpi.RetentionRate:F1}%")</strong><em>Retention Rate</em><small>@($"{Math.Abs(_kpi.RetentionDelta):F1}% vs prior period")</small></span></button>
        <button type="button" class="@GrowthKpiClass" @onclick="SetGrowthKpi"><span class="ed-kpi-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span><span><strong>@_kpi.NewBusinessPremium.ToString("C0")</strong><em>New Business</em><small>@($"{Math.Abs(_kpi.NewBusinessDelta):F1}% vs prior period")</small></span></button>
        <button type="button" class="@RiskKpiClass" @onclick="SetRiskKpi"><span class="ed-kpi-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></span><span><strong>@_kpi.RenewalAtRiskCount</strong><em>Renewals at Risk</em><small>@($"{_kpi.RenewalAtRiskPremium:C0} at stake")</small></span></button>
        <button type="button" class="@ClaimsKpiClass" @onclick="SetClaimsKpi"><span class="ed-kpi-icon"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></span><span><strong>@_kpi.OpenClaimsCount</strong><em>Open Claims</em><small>@($"{_kpi.TotalIncurredLoss:C0} incurred")</small></span></button>
        <button type="button" class="@ReceivablesKpiClass" @onclick="SetReceivablesKpi"><span class="ed-kpi-icon"><i class="bi bi-calendar2-week" aria-hidden="true"></i></span><span><strong>@_kpi.OverdueReceivables.ToString("C0")</strong><em>Overdue Receivables</em><small>@($"{_kpi.OverduePct:F1}% of total AR")</small></span></button>
    </section>

    <section class="ed-workflow-strip" aria-label="Executive workflows">
        <button type="button" class="ed-workflow-card" @onclick="ShowExecutive"><i class="bi bi-speedometer2" aria-hidden="true"></i><span><strong>Executive</strong><small>Top-line performance</small></span></button>
        <button type="button" class="ed-workflow-card" @onclick="ShowRevenue"><i class="bi bi-cash-coin" aria-hidden="true"></i><span><strong>Revenue</strong><small>Premium and AR</small></span></button>
        <button type="button" class="ed-workflow-card" @onclick="ShowRisk"><i class="bi bi-shield-exclamation" aria-hidden="true"></i><span><strong>Risk</strong><small>Renewals and claims</small></span></button>
        <button type="button" class="ed-workflow-card" @onclick="ShowGrowth"><i class="bi bi-trophy" aria-hidden="true"></i><span><strong>Growth</strong><small>Campaigns and producers</small></span></button>
    </section>

    <section class="ed-search-panel">
        <div class="ed-search-wrap">
            <span class="ed-search-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
            <div class="ed-search-body">
                <label for="ed-search">Executive search</label>
                <input id="ed-search" class="ed-search-input" @bind="_search" @bind:event="oninput" placeholder="Search producers, campaigns, renewals, LOB, branch, risk..." />
                <span class="ed-search-hint">Filters producer, campaign, and renewal priority tables.</span>
            </div>
        </div>
        <select class="ed-filter-select" @bind="_period" @bind:after="LoadAsync">
            @foreach (var option in _periodOptions)
            {
                <option value="@option.Value">@option.Label</option>
            }
        </select>
        <div class="ed-search-result"><strong>@VisibleInsightCount</strong><span>insights</span></div>
    </section>

    <nav class="ed-view-tabs" aria-label="Executive dashboard views">
        @foreach (var view in _views)
        {
            <button type="button" class="ed-view-btn @(_activeView == view ? "ed-view-btn-active" : null)" @onclick="() => SetView(view)">@view</button>
        }
    </nav>

    <section class="ed-content-layout">
        <div class="ed-main-card">
            @if (_activeView == "Revenue")
            {
                <div class="ed-dashboard-grid">
                    <section class="ed-panel">
                        <header><div><i class="bi bi-cash-coin" aria-hidden="true"></i><strong>Premium Trend</strong></div><span>@_periodLabel</span></header>
                        <div class="ed-panel-body ed-chart-lines">
                            @foreach (var p in _premiumTrend)
                            {
                                <div class="ed-bar-row"><span>@p.Label</span><div><i style="@WidthStyle(p.Value, MaxPremium)"></i><b style="@WidthStyle(p.PriorValue, MaxPremium)"></b></div><strong>@p.Value.ToString("C0")</strong></div>
                            }
                        </div>
                    </section>
                    <section class="ed-panel">
                        <header><div><i class="bi bi-calendar2-week" aria-hidden="true"></i><strong>Receivables Aging</strong></div><span>@_kpi.OverdueReceivables.ToString("C0")</span></header>
                        <div class="ed-panel-body ed-donut-list">
                            @foreach (var p in _receivablesAging)
                            {
                                <div class="ed-metric-row"><span>@p.Label</span><div><i style="@WidthStyle(p.Value, MaxReceivables)"></i></div><strong>@p.Value.ToString("C0")</strong></div>
                            }
                        </div>
                    </section>
                    <section class="ed-panel">
                        <header><div><i class="bi bi-bar-chart" aria-hidden="true"></i><strong>New / Renewal Mix</strong></div><span>@_periodLabel</span></header>
                        <div class="ed-panel-body ed-split-bars">
                            @foreach (var p in _newBizTrend)
                            {
                                var total = Math.Max(p.NewBiz + p.Renewal, 1);
                                <div class="ed-split-row"><span>@p.Label</span><div><i style="@WidthStyle(p.NewBiz, total)"></i><b style="@WidthStyle(p.Renewal, total)"></b></div><strong>@((p.NewBiz + p.Renewal).ToString("C0"))</strong></div>
                            }
                        </div>
                    </section>
                    <section class="ed-panel">
                        <header><div><i class="bi bi-lightning-charge" aria-hidden="true"></i><strong>Revenue Actions</strong></div><span>Focus</span></header>
                        <div class="ed-panel-body ed-priority-list">
                            @foreach (var item in PriorityItems.Where(x => x.Type == "Revenue").Take(6))
                            {
                                <button type="button" @onclick="() => NavigatePriority(item)"><strong>@item.Title</strong><span>@item.Subtitle</span></button>
                            }
                        </div>
                    </section>
                </div>
            }
            else if (_activeView == "Risk")
            {
                <div class="ed-dashboard-grid">
                    <section class="ed-panel">
                        <header><div><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><strong>Renewals at Risk</strong></div><span>@_renewalsAtRisk.Count</span></header>
                        <div class="ed-panel-body ed-risk-list">
                            @foreach (var r in FilteredRenewals)
                            {
                                <div class="ed-risk-row"><div><strong>@r.AccountName</strong><span>@r.LobCode - exp @r.ExpiryDate.ToString("d")</span></div><div><strong>@r.Premium.ToString("C0")</strong><span class="@RiskBadgeClass(r.RiskLevel)">@r.RiskLevel</span></div></div>
                            }
                        </div>
                    </section>
                    <section class="ed-panel">
                        <header><div><i class="bi bi-shield-exclamation" aria-hidden="true"></i><strong>Claims by Severity</strong></div><span>@_kpi.OpenClaimsCount</span></header>
                        <div class="ed-panel-body ed-donut-list">
                            @foreach (var p in _claimsBySeverity)
                            {
                                <div class="ed-metric-row"><span>@p.Label</span><div><i style="@WidthStyle(p.Value, MaxClaims)"></i></div><strong>@p.Value.ToString("F0")</strong></div>
                            }
                        </div>
                    </section>
                    <section class="ed-panel">
                        <header><div><i class="bi bi-arrow-repeat" aria-hidden="true"></i><strong>Retention Segments</strong></div><span>@_kpi.RetentionRate.ToString("F1")%</span></header>
                        <div class="ed-panel-body ed-donut-list">
                            @foreach (var p in _retentionSegments)
                            {
                                <div class="ed-metric-row"><span>@p.Label</span><div><i style="@WidthStyle(p.Value, 100)"></i></div><strong>@($"{p.Value:F1}%")</strong></div>
                            }
                        </div>
                    </section>
                    <section class="ed-panel">
                        <header><div><i class="bi bi-shield-check" aria-hidden="true"></i><strong>Risk Actions</strong></div><span>Priority</span></header>
                        <div class="ed-panel-body ed-priority-list">
                            @foreach (var item in PriorityItems.Where(x => x.Type == "Risk").Take(6))
                            {
                                <button type="button" @onclick="() => NavigatePriority(item)"><strong>@item.Title</strong><span>@item.Subtitle</span></button>
                            }
                        </div>
                    </section>
                </div>
            }
            else if (_activeView == "Growth")
            {
                <div class="ed-dashboard-grid ed-dashboard-grid-wide">
                    <section class="ed-panel">
                        <header><div><i class="bi bi-megaphone-fill" aria-hidden="true"></i><strong>Campaign Conversion</strong></div><span>@_campaigns.Count</span></header>
                        <div class="ed-panel-body ed-table-scroll">
                            <table class="ed-table"><thead><tr><th>Campaign</th><th>Leads</th><th>Quoted</th><th>Bound</th><th>Conv</th><th>Premium</th></tr></thead><tbody>
                            @foreach (var c in FilteredCampaigns)
                            {
                                <tr><td>@c.Name</td><td>@c.Leads</td><td>@c.Quoted</td><td>@c.Bound</td><td><span class="@ConvClass(c.ConversionPct)">@c.ConversionPct.ToString("F1")%</span></td><td>@c.Premium.ToString("C0")</td></tr>
                            }
                            </tbody></table>
                        </div>
                    </section>
                    <section class="ed-panel">
                        <header><div><i class="bi bi-trophy-fill" aria-hidden="true"></i><strong>Producer Leaderboard</strong></div><span>@_producers.Count</span></header>
                        <div class="ed-panel-body ed-table-scroll">
                            <table class="ed-table"><thead><tr><th>#</th><th>Producer</th><th>Premium</th><th>Policies</th><th>New Biz</th><th>Retention</th><th>Goal</th><th>LOB</th></tr></thead><tbody>
                            @foreach (var p in FilteredProducers.Select((value, index) => new { value, index }))
                            {
                                <tr><td><span class="@RankBadge(p.index + 1)">@(p.index + 1)</span></td><td><div class="ed-producer-cell"><span class="ed-avatar" style="@AvatarStyle(p.value.ProducerName)">@Initials(p.value.ProducerName)</span><span><strong>@p.value.ProducerName</strong><small>@p.value.Branch</small></span></div></td><td>@p.value.WrittenPremium.ToString("C0")</td><td>@p.value.PoliciesWritten</td><td>@p.value.NewBusiness.ToString("C0")</td><td><span class="@RetentionClass(p.value.RetentionRate)">@($"{p.value.RetentionRate:F1}%")</span></td><td><div class="ed-goal-bar-wrap"><div class="ed-goal-bar" style="@GoalStyle(p.value.GoalPct)"></div><span>@($"{p.value.GoalPct:F0}%")</span></div></td><td>@p.value.Lob</td></tr>
                            }
                            </tbody></table>
                        </div>
                    </section>
                </div>
            }
            else
            {
                <div class="ed-dashboard-grid">
                    <section class="ed-panel">
                        <header><div><i class="bi bi-cash-coin" aria-hidden="true"></i><strong>Written Premium Trend</strong></div><span>@_periodLabel</span></header>
                        <div class="ed-panel-body ed-chart-lines">
                            @foreach (var p in _premiumTrend)
                            {
                                <div class="ed-bar-row"><span>@p.Label</span><div><i style="@WidthStyle(p.Value, MaxPremium)"></i><b style="@WidthStyle(p.PriorValue, MaxPremium)"></b></div><strong>@p.Value.ToString("C0")</strong></div>
                            }
                        </div>
                    </section>
                    <section class="ed-panel">
                        <header><div><i class="bi bi-graph-up-arrow" aria-hidden="true"></i><strong>New Business vs Renewal</strong></div><span>@_periodLabel</span></header>
                        <div class="ed-panel-body ed-split-bars">
                            @foreach (var p in _newBizTrend)
                            {
                                var total = Math.Max(p.NewBiz + p.Renewal, 1);
                                <div class="ed-split-row"><span>@p.Label</span><div><i style="@WidthStyle(p.NewBiz, total)"></i><b style="@WidthStyle(p.Renewal, total)"></b></div><strong>@((p.NewBiz + p.Renewal).ToString("C0"))</strong></div>
                            }
                        </div>
                    </section>
                    <section class="ed-panel">
                        <header><div><i class="bi bi-arrow-repeat" aria-hidden="true"></i><strong>Retention Analysis</strong></div><span>Segments</span></header>
                        <div class="ed-panel-body ed-donut-list">
                            @foreach (var p in _retentionSegments)
                            {
                                <div class="ed-metric-row"><span>@p.Label</span><div><i style="@WidthStyle(p.Value, 100)"></i></div><strong>@($"{p.Value:F1}%")</strong></div>
                            }
                        </div>
                    </section>
                    <section class="ed-panel">
                        <header><div><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><strong>Renewals at Risk</strong></div><span>@_renewalsAtRisk.Count</span></header>
                        <div class="ed-panel-body ed-risk-list">
                            @foreach (var r in FilteredRenewals.Take(6))
                            {
                                <div class="ed-risk-row"><div><strong>@r.AccountName</strong><span>@r.LobCode - exp @r.ExpiryDate.ToString("d")</span></div><div><strong>@r.Premium.ToString("C0")</strong><span class="@RiskBadgeClass(r.RiskLevel)">@r.RiskLevel</span></div></div>
                            }
                        </div>
                    </section>
                </div>
            }
        </div>
        <aside class="ed-detail-card" aria-label="Executive priorities">
            <div class="ed-detail-head">
                <span class="ed-detail-eyebrow"><i class="bi bi-lightning-charge" aria-hidden="true"></i> Priority brief</span>
                <h2>@PriorityTitle</h2>
                <p>@PrioritySubtitle</p>
            </div>
            <div class="ed-detail-body">
                <div class="ed-detail-summary">
                    <div><span>Risk premium</span><strong>@_kpi.RenewalAtRiskPremium.ToString("C0")</strong></div>
                    <div><span>Open claims</span><strong>@_kpi.OpenClaimsCount</strong></div>
                    <div><span>Top producer</span><strong>@(_producers.FirstOrDefault()?.ProducerName ?? "No data")</strong></div>
                    <div><span>Campaigns</span><strong>@_campaigns.Count</strong></div>
                </div>
                <div class="ed-priority-list">
                    @foreach (var item in PriorityItems.Take(6))
                    {
                        <button type="button" @onclick="() => NavigatePriority(item)"><strong>@item.Title</strong><span>@item.Subtitle</span></button>
                    }
                </div>
                <div class="ed-detail-actions">
                    <button type="button" class="um-btn um-btn-primary" @onclick="ExportAsync"><i class="bi bi-download" aria-hidden="true"></i> Export Brief</button>
                    <button type="button" class="um-btn um-btn-ghost" @onclick="ShowRisk"><i class="bi bi-shield-exclamation" aria-hidden="true"></i> Review Risk</button>
                    <button type="button" class="um-btn um-btn-ghost" @onclick="ShowGrowth"><i class="bi bi-trophy" aria-hidden="true"></i> Producer Focus</button>
                </div>
            </div>
        </aside>
    </section>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private bool _loading;
    private bool _toastVisible;
    private string _period = "YTD";
    private string _activeView = "Executive";
    private string _search = string.Empty;
    private string _toastMessage = string.Empty;
    private string _toastKind = "success";
    private string _periodLabel => _periodOptions.FirstOrDefault(p => p.Value == _period)?.Label ?? _period;
    private readonly string[] _views = ["Executive", "Revenue", "Risk", "Growth"];
    private ExecKpi _kpi = new();
    private List<PremiumPoint> _premiumTrend = [];
    private List<NewBizPoint> _newBizTrend = [];
    private List<PiePoint> _retentionSegments = [];
    private List<RenewalRisk> _renewalsAtRisk = [];
    private List<PiePoint> _claimsBySeverity = [];
    private List<PiePoint> _receivablesAging = [];
    private List<CampaignRow> _campaigns = [];
    private List<ProducerRow> _producers = [];
    private static readonly List<LabelValue> _periodOptions = [new("MTD", "Month to Date"), new("QTD", "Quarter to Date"), new("YTD", "Year to Date"), new("L12M", "Last 12 Months"), new("Custom", "Custom Range")];
    private IEnumerable<RenewalRisk> FilteredRenewals => _renewalsAtRisk.Where(MatchesSearch).OrderByDescending(x => x.RiskLevel == "High").ThenBy(x => x.ExpiryDate);
    private IEnumerable<CampaignRow> FilteredCampaigns => _campaigns.Where(MatchesSearch).OrderByDescending(x => x.Premium);
    private IEnumerable<ProducerRow> FilteredProducers => _producers.Where(MatchesSearch).OrderByDescending(x => x.WrittenPremium);
    private IEnumerable<PriorityItem> PriorityItems => BuildPriorityItems();
    private int VisibleInsightCount => FilteredRenewals.Count() + FilteredCampaigns.Count() + FilteredProducers.Count();
    private decimal MaxPremium => _premiumTrend.Select(x => Math.Max(x.Value, x.PriorValue)).DefaultIfEmpty(1).Max();
    private double MaxReceivables => _receivablesAging.Select(x => x.Value).DefaultIfEmpty(1).Max();
    private double MaxClaims => Math.Max(_claimsBySeverity.Sum(x => x.Value), 1);
    private string ToastIcon => _toastKind == "success" ? "bi-check-circle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : "bi-exclamation-triangle-fill";
    private string PriorityTitle => _activeView switch { "Revenue" => "Revenue command actions", "Risk" => "Risk and retention actions", "Growth" => "Growth execution focus", _ => "Executive operating priorities" };
    private string PrioritySubtitle => _activeView switch { "Revenue" => "Protect cash, monitor premium mix, and clear AR exposure.", "Risk" => "Triage renewals, claims, and retention leakage before escalation.", "Growth" => "Focus producer coaching and campaign conversion opportunities.", _ => "Highest-impact actions across agency performance." };

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Executive Dashboard", "/dashboard/executive"));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var data = await Api.GetExecutiveDashboardPageAsync(_tenantId);
            if (data is null) return;
            _kpi = new ExecKpi { WrittenPremium = data.Kpi.WrittenPremium, WrittenPremiumDelta = data.Kpi.WrittenPremiumDelta, RetentionRate = data.Kpi.RetentionRate, RetentionDelta = data.Kpi.RetentionDelta, NewBusinessPremium = data.Kpi.NewBusinessPremium, NewBusinessDelta = data.Kpi.NewBusinessDelta, RenewalAtRiskCount = data.Kpi.RenewalAtRiskCount, RenewalAtRiskPremium = data.Kpi.RenewalAtRiskPremium, OpenClaimsCount = data.Kpi.OpenClaimsCount, TotalIncurredLoss = data.Kpi.TotalIncurredLoss, OverdueReceivables = data.Kpi.OverdueReceivables, OverduePct = data.Kpi.OverduePct };
            _premiumTrend = data.PremiumTrend.Select(x => new PremiumPoint { Label = x.Label, Value = x.Value, PriorValue = x.PriorValue }).ToList();
            _newBizTrend = data.NewBusinessTrend.Select(x => new NewBizPoint { Label = x.Label, NewBiz = x.NewBiz, Renewal = x.Renewal }).ToList();
            _retentionSegments = data.RetentionSegments.Select(x => new PiePoint { Label = x.Label, Value = x.Value }).ToList();
            _renewalsAtRisk = data.RenewalsAtRisk.Select(x => new RenewalRisk { AccountName = x.AccountName, LobCode = x.LobCode, ExpiryDate = x.ExpiryDate, Premium = x.Premium, RiskLevel = x.RiskLevel }).ToList();
            _claimsBySeverity = data.ClaimsBySeverity.Select(x => new PiePoint { Label = x.Label, Value = x.Value }).ToList();
            _receivablesAging = data.ReceivablesAging.Select(x => new PiePoint { Label = x.Label, Value = x.Value }).ToList();
            _campaigns = data.Campaigns.Select(x => new CampaignRow { Name = x.Name, Leads = x.Leads, Quoted = x.Quoted, Bound = x.Bound, ConversionPct = x.ConversionPct, Premium = x.Premium }).ToList();
            _producers = data.Producers.Select(x => new ProducerRow { ProducerName = x.ProducerName, Branch = x.Branch, WrittenPremium = x.WrittenPremium, PoliciesWritten = x.PoliciesWritten, NewBusiness = x.NewBusiness, RetentionRate = x.RetentionRate, GoalPct = x.GoalPct, Lob = x.Lob }).ToList();
        }
        catch (Exception ex)
        {
            ShowToast($"Load failed: {ex.Message}", "danger");
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ExportAsync()
    {
        var csv = new StringBuilder();
        csv.AppendLine("Metric,Value,Context");
        csv.AppendLine($"Written Premium,{Csv(_kpi.WrittenPremium.ToString("C0"))},{Csv(_periodLabel)}");
        csv.AppendLine($"Retention Rate,{Csv($"{_kpi.RetentionRate:F1}%")},{Csv(_periodLabel)}");
        csv.AppendLine($"New Business,{Csv(_kpi.NewBusinessPremium.ToString("C0"))},{Csv(_periodLabel)}");
        csv.AppendLine($"Renewals At Risk,{_kpi.RenewalAtRiskCount},{Csv(_kpi.RenewalAtRiskPremium.ToString("C0"))}");
        csv.AppendLine($"Open Claims,{_kpi.OpenClaimsCount},{Csv(_kpi.TotalIncurredLoss.ToString("C0"))}");
        csv.AppendLine($"Overdue Receivables,{Csv(_kpi.OverdueReceivables.ToString("C0"))},{Csv($"{_kpi.OverduePct:F1}% of AR")}");
        csv.AppendLine();
        csv.AppendLine("Producer,Branch,Written Premium,Policies,New Business,Retention,Goal,LOB");
        foreach (var p in FilteredProducers) csv.AppendLine(string.Join(',', Csv(p.ProducerName), Csv(p.Branch), Csv(p.WrittenPremium.ToString("C0")), p.PoliciesWritten, Csv(p.NewBusiness.ToString("C0")), Csv($"{p.RetentionRate:F1}%"), Csv($"{p.GoalPct:F0}%"), Csv(p.Lob)));
        Nav.NavigateTo("data:text/csv;charset=utf-8," + Uri.EscapeDataString(csv.ToString()), forceLoad: true);
        ShowToast("Executive dashboard export generated.");
        return Task.CompletedTask;
    }

    private void SetView(string view) => _activeView = view;
    private void ShowExecutive() => SetView("Executive");
    private void ShowRevenue() => SetView("Revenue");
    private void ShowRisk() => SetView("Risk");
    private void ShowGrowth() => SetView("Growth");
    private void SetPremiumKpi() => SetKpi("premium");
    private void SetRetentionKpi() => SetKpi("retention");
    private void SetGrowthKpi() => SetKpi("growth");
    private void SetRiskKpi() => SetKpi("risk");
    private void SetClaimsKpi() => SetKpi("claims");
    private void SetReceivablesKpi() => SetKpi("receivables");
    private void SetKpi(string key) { _activeKpi = _activeKpi == key ? null : key; _activeView = key switch { "premium" or "receivables" => "Revenue", "risk" or "claims" or "retention" => "Risk", "growth" => "Growth", _ => _activeView }; }
    private string? _activeKpi;

    private bool MatchesSearch(RenewalRisk r) => string.IsNullOrWhiteSpace(_search) || Contains(r.AccountName, _search) || Contains(r.LobCode, _search) || Contains(r.RiskLevel, _search);
    private bool MatchesSearch(CampaignRow c) => string.IsNullOrWhiteSpace(_search) || Contains(c.Name, _search);
    private bool MatchesSearch(ProducerRow p) => string.IsNullOrWhiteSpace(_search) || Contains(p.ProducerName, _search) || Contains(p.Branch, _search) || Contains(p.Lob, _search);
    private static bool Contains(string? value, string search) => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;
    private static int Percent(decimal value, decimal max) => max <= 0 ? 0 : Math.Clamp((int)Math.Round(value * 100m / max), 0, 100);
    private static int Percent(double value, double max) => max <= 0 ? 0 : Math.Clamp((int)Math.Round(value * 100d / max), 0, 100);
    private static string WidthStyle(decimal value, decimal max) => $"width:{Percent(value, max)}%;";
    private static string WidthStyle(double value, double max) => $"width:{Percent(value, max)}%;";
    private string PremiumKpiClass => KpiClass("premium", "ed-blue");
    private string RetentionKpiClass => KpiClass("retention", "ed-green");
    private string GrowthKpiClass => KpiClass("growth", "ed-purple");
    private string RiskKpiClass => KpiClass("risk", "ed-amber");
    private string ClaimsKpiClass => KpiClass("claims", "ed-red");
    private string ReceivablesKpiClass => KpiClass("receivables", "ed-cyan");
    private string KpiClass(string key, string tone) => $"ed-kpi-card {tone}{(_activeKpi == key ? " ed-kpi-card-active" : string.Empty)}";
    private static string GoalStyle(double pct) => $"width:{Math.Min(pct, 100):F0}%;background:{GoalBarColor(pct)}";

    private IEnumerable<PriorityItem> BuildPriorityItems()
    {
        foreach (var r in _renewalsAtRisk.OrderByDescending(x => x.RiskLevel == "High").ThenBy(x => x.ExpiryDate).Take(4)) yield return new("Risk", r.AccountName, $"{r.RiskLevel} renewal - {r.Premium:C0} - exp {r.ExpiryDate:d}", "/renewals/retention-center");
        if (_kpi.OverdueReceivables > 0) yield return new("Revenue", "Overdue receivables", $"{_kpi.OverdueReceivables:C0} overdue - {_kpi.OverduePct:F1}% of AR", "/billing/ar-aging");
        foreach (var c in _campaigns.OrderByDescending(x => x.Premium).Take(3)) yield return new("Growth", c.Name, $"{c.ConversionPct:F1}% conversion - {c.Premium:C0}", "/marketing/campaigns");
        foreach (var p in _producers.OrderByDescending(x => x.WrittenPremium).Take(3)) yield return new("Growth", p.ProducerName, $"{p.WrittenPremium:C0} written - {p.GoalPct:F0}% goal", "/analytics/producers");
    }

    private void NavigatePriority(PriorityItem item) => Nav.NavigateTo(item.Url);
    private void ShowToast(string message, string kind = "success") { _toastMessage = message; _toastKind = kind; _toastVisible = true; }
    private void HideToast() => _toastVisible = false;
    private static string DeltaClass(double d) => d >= 0 ? "ed-delta ed-delta--ok" : "ed-delta ed-delta--bad";
    private static string DeltaIcon(double d) => d >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short";
    private static string RiskBadgeClass(string level) => level switch { "High" => "ed-risk-badge ed-risk-badge--high", "Medium" => "ed-risk-badge ed-risk-badge--medium", _ => "ed-risk-badge ed-risk-badge--low" };
    private static string ConvClass(double pct) => pct >= 30 ? "ed-conv-good" : pct >= 15 ? "ed-conv-avg" : "ed-conv-poor";
    private static string RetentionClass(double r) => r >= 85 ? "ed-ret-good" : r >= 70 ? "ed-ret-avg" : "ed-ret-poor";
    private static string GoalBarColor(double pct) => pct >= 100 ? "#22c55e" : pct >= 75 ? "#3b82f6" : pct >= 50 ? "#eab308" : "#f97316";
    private static string RankBadge(int rank) => rank switch { 1 => "ed-rank ed-rank--gold", 2 => "ed-rank ed-rank--silver", 3 => "ed-rank ed-rank--bronze", _ => "ed-rank" };
    private static string Initials(string name) { var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length >= 1 ? name[..1] : "?"; }
    private static string AvatarStyle(string name) { var hue = Math.Abs(name.GetHashCode()) % 360; return $"background:hsl({hue},50%,40%);color:#fff;"; }
    private static string Csv(string? value) { var text = value ?? string.Empty; return string.Concat("\"", text.Replace("\"", "\"\""), "\""); }

    private sealed record LabelValue(string Value, string Label);
    private sealed record PriorityItem(string Type, string Title, string Subtitle, string Url);
    private sealed class ExecKpi { public decimal WrittenPremium { get; set; } public double WrittenPremiumDelta { get; set; } public double RetentionRate { get; set; } public double RetentionDelta { get; set; } public decimal NewBusinessPremium { get; set; } public double NewBusinessDelta { get; set; } public int RenewalAtRiskCount { get; set; } public decimal RenewalAtRiskPremium { get; set; } public int OpenClaimsCount { get; set; } public decimal TotalIncurredLoss { get; set; } public decimal OverdueReceivables { get; set; } public double OverduePct { get; set; } }
    private sealed class PremiumPoint { public string Label { get; set; } = string.Empty; public decimal Value { get; set; } public decimal PriorValue { get; set; } }
    private sealed class NewBizPoint { public string Label { get; set; } = string.Empty; public decimal NewBiz { get; set; } public decimal Renewal { get; set; } }
    private sealed class PiePoint { public string Label { get; set; } = string.Empty; public double Value { get; set; } }
    private sealed class RenewalRisk { public string AccountName { get; set; } = string.Empty; public string LobCode { get; set; } = string.Empty; public DateTime ExpiryDate { get; set; } public decimal Premium { get; set; } public string RiskLevel { get; set; } = "Low"; }
    private sealed class CampaignRow { public string Name { get; set; } = string.Empty; public int Leads { get; set; } public int Quoted { get; set; } public int Bound { get; set; } public double ConversionPct { get; set; } public decimal Premium { get; set; } }
    private sealed class ProducerRow { public string ProducerName { get; set; } = string.Empty; public string Branch { get; set; } = string.Empty; public decimal WrittenPremium { get; set; } public int PoliciesWritten { get; set; } public decimal NewBusiness { get; set; } public double RetentionRate { get; set; } public double GoalPct { get; set; } public string Lob { get; set; } = string.Empty; }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
