@page "/finance/period-close"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Period Close — AMS</PageTitle>

<AppPageHeader Title="Period Close"
               Subtitle="Tenant Admin period-end checklist for financial close readiness"
               Icon="bi-lock">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/finance/accounting-periods")'><i class="bi bi-calendar-range" aria-hidden="true"></i> Periods</button>
        <button class="um-btn um-btn-primary" @onclick="OpenCreate"><i class="bi bi-plus-lg" aria-hidden="true"></i> New Task</button>
    </Actions>
</AppPageHeader>

<div class="fin-kpi-strip">
    <div class="fin-kpi-card"><div class="fin-kpi-icon"><i class="bi bi-list-check"></i></div><div><div class="fin-kpi-value">@_items.Count</div><div class="fin-kpi-label">Close Tasks</div></div></div>
    <div class="fin-kpi-card"><div class="fin-kpi-icon"><i class="bi bi-check-circle"></i></div><div><div class="fin-kpi-value">@_items.Count(x => x.StatusCode == "Completed")</div><div class="fin-kpi-label">Completed</div></div></div>
    <div class="fin-kpi-card"><div class="fin-kpi-icon"><i class="bi bi-hourglass"></i></div><div><div class="fin-kpi-value">@_items.Count(x => x.StatusCode != "Completed")</div><div class="fin-kpi-label">Open</div></div></div>
</div>

<div class="fin-toolbar">
    <div class="fin-search-box"><i class="bi bi-search fin-search-icon" aria-hidden="true"></i><input class="e-input fin-search-input" placeholder="Search close task or notes…" @bind="_searchTerm" @bind:event="oninput" @onkeyup="@(e => e.Key == "Enter" ? LoadAsync() : Task.CompletedTask)" /></div>
    <select class="um-input" @bind="_statusFilter"><option value="">All Statuses</option><option value="Completed">Completed</option><option value="Open">Open</option><option value="Blocked">Blocked</option></select>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-search" aria-hidden="true"></i> Search</button>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="fin-alert"><div class="fin-alert-icon"><i class="bi bi-exclamation-triangle-fill"></i></div><div><div class="fin-alert-title">Period close failed to load</div><div>@_error</div></div></div>
}
else if (_loading)
{
    <div class="fin-loading"><div class="um-spinner" aria-hidden="true"></div><span>Loading period close tasks…</span></div>
}
else
{
    <div class="fin-grid-container">
        <SfGrid TValue="PeriodCloseEntryDto" DataSource="FilteredItems" AllowPaging="true" AllowSorting="true" Height="600px">
            <GridEvents TValue="PeriodCloseEntryDto" RowSelected="OnRowSelected" />
            <GridPageSettings PageSize="15"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(PeriodCloseEntryDto.TaskDescription)" HeaderText="Task" Width="360"></GridColumn>
                <GridColumn Field="@nameof(PeriodCloseEntryDto.StatusCode)" HeaderText="Status" Width="120"><Template>@{ var item = (PeriodCloseEntryDto)context; }<span class="fin-chip @StatusClass(item.StatusCode)">@item.StatusCode</span></Template></GridColumn>
                <GridColumn Field="@nameof(PeriodCloseEntryDto.CompletedDateUtc)" HeaderText="Completed" Type="ColumnType.DateTime" Format="d" Width="140"></GridColumn>
                <GridColumn Field="@nameof(PeriodCloseEntryDto.Notes)" HeaderText="Notes" Width="320"></GridColumn>
                <GridColumn HeaderText="Actions" Width="90"><Template>@{ var item = (PeriodCloseEntryDto)context; }<button class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenEdit(item)" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button></Template></GridColumn>
            </GridColumns>
        </SfGrid>
    </div>
}

<SfDialog @bind-Visible="_showForm" Width="680px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates><Content>
        <div class="um-modal-header"><i class="bi bi-lock" aria-hidden="true"></i><span>@(_editingId == Guid.Empty ? "New Period Close Task" : "Edit Period Close Task")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
        <EditForm EditContext="_editContext"><DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field"><label>Accounting Period <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.AccountingPeriodId" class="um-input"><option value="@Guid.Empty">Select period…</option>@foreach (var period in _periods) { <option value="@period.AccountingPeriodId">@period.PeriodCode - @period.PeriodName</option> }</InputSelect><ValidationMessage For="() => _form.AccountingPeriodId" class="text-danger" /></div>
                <div class="um-field"><label>Status <span class="text-danger">*</span></label><InputSelect @bind-Value="_form.StatusCode" class="um-input"><option value="Open">Open</option><option value="Completed">Completed</option><option value="Blocked">Blocked</option></InputSelect><ValidationMessage For="() => _form.StatusCode" class="text-danger" /></div>
                <div class="um-field um-field--full"><label>Task Description <span class="text-danger">*</span></label><InputTextArea @bind-Value="_form.TaskDescription" class="um-input" rows="3" /><ValidationMessage For="() => _form.TaskDescription" class="text-danger" /></div>
                <div class="um-field"><label>Completed Date</label><InputDate @bind-Value="_form.CompletedDateUtc" class="um-input" /><ValidationMessage For="() => _form.CompletedDateUtc" class="text-danger" /></div>
                <div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_form.Notes" class="um-input" rows="3" /><ValidationMessage For="() => _form.Notes" class="text-danger" /></div>
                @if (!string.IsNullOrWhiteSpace(_formError)) { <div class="alert alert-danger um-field--full" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_formError</div> }
            </div></div>
        </EditForm>
        <div class="um-modal-footer"><button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button><button type="button" class="um-btn um-btn-primary" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Task")</button></div>
    </Content></DialogTemplates>
</SfDialog>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm, _error;
    private string _statusFilter = string.Empty;
    private bool _loading, _showForm, _saving;
    private List<PeriodCloseEntryDto> _items = [];
    private List<AccountingPeriodDto> _periods = [];
    private string? _formError;
    private Guid _editingId = Guid.Empty;
    private PeriodCloseForm _form = new();
    private EditContext _editContext = default!;
    private IEnumerable<PeriodCloseEntryDto> FilteredItems => _items.Where(x => string.IsNullOrWhiteSpace(_statusFilter) || x.StatusCode == _statusFilter);
    protected override async Task OnInitializedAsync() { _editContext = new(_form); await LoadAsync(); }
    private async Task LoadAsync() { _loading = true; _error = null; try { var result = await Api.SearchPeriodCloseEntriesAsync(_tenantId, _searchTerm); var periods = await Api.SearchAccountingPeriodsAsync(_tenantId); _items = result?.Items.ToList() ?? []; _periods = periods?.Items.ToList() ?? []; } catch (Exception ex) { _error = ex.Message; _items = []; } finally { _loading = false; } }
    private void OnRowSelected(RowSelectEventArgs<PeriodCloseEntryDto> args) => OpenEdit(args.Data);
    private void OpenCreate() { _editingId = Guid.Empty; _form = new(); _editContext = new(_form); _formError = null; _showForm = true; }
    private void OpenEdit(PeriodCloseEntryDto item) { _editingId = item.PeriodCloseEntryId; _form = new PeriodCloseForm { AccountingPeriodId = item.AccountingPeriodId, TaskDescription = item.TaskDescription, StatusCode = item.StatusCode, CompletedDateUtc = item.CompletedDateUtc, Notes = item.Notes }; _editContext = new(_form); _formError = null; _showForm = true; }
    private void CloseForm() => _showForm = false;
    private async Task SaveAsync() { if (!_editContext.Validate()) return; _saving = true; try { if (_editingId == Guid.Empty) await Api.CreatePeriodCloseEntryAsync(new CreatePeriodCloseEntryRequest { TenantId = _tenantId, AccountingPeriodId = _form.AccountingPeriodId, TaskDescription = _form.TaskDescription, StatusCode = _form.StatusCode, CompletedDateUtc = _form.CompletedDateUtc, Notes = _form.Notes }); else await Api.UpdatePeriodCloseEntryAsync(_editingId, new UpdatePeriodCloseEntryRequest { TenantId = _tenantId, PeriodCloseEntryId = _editingId, AccountingPeriodId = _form.AccountingPeriodId, TaskDescription = _form.TaskDescription, StatusCode = _form.StatusCode, CompletedDateUtc = _form.CompletedDateUtc, Notes = _form.Notes }); _showForm = false; await LoadAsync(); } catch (Exception ex) { _formError = $"Save failed: {ex.Message}"; } finally { _saving = false; } }
    private static string StatusClass(string status) => status switch { "Completed" => "fin-chip-success", "Blocked" => "fin-chip-danger", "Open" => "fin-chip-warning", _ => "fin-chip-neutral" };
    private sealed class PeriodCloseForm { [RequiredGuid(ErrorMessage = "Accounting Period is required.")] public Guid AccountingPeriodId { get; set; } [Required, StringLength(500)] public string TaskDescription { get; set; } = string.Empty; [Required, StringLength(50)] public string StatusCode { get; set; } = "Open"; public DateTime? CompletedDateUtc { get; set; } [StringLength(1000)] public string? Notes { get; set; } }
}
