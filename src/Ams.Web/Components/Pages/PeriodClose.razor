@page "/finance/period-close"
@inject ApiClient Api

<PageTitle>Period Close</PageTitle>
<h1>Period Close</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(PeriodCloseEntryDto.TaskDescription)"  HeaderText="Task"        Width="350"></GridColumn>
        <GridColumn Field="@nameof(PeriodCloseEntryDto.StatusCode)"       HeaderText="Status"      Width="110"></GridColumn>
        <GridColumn Field="@nameof(PeriodCloseEntryDto.CompletedDateUtc)" HeaderText="Completed"   Type="ColumnType.DateTime" Format="d" Width="140"></GridColumn>
        <GridColumn Field="@nameof(PeriodCloseEntryDto.Notes)"            HeaderText="Notes"       Width="300"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _searchTerm;
    private List<PeriodCloseEntryDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchPeriodCloseEntriesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
