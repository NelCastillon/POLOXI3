@page "/communications/inbox"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject ApiClient Api
@inject ConfirmationDialogService Confirmations
@using Ams.Application.Features.Communications
@using System.ComponentModel.DataAnnotations

<PageTitle>Communications Inbox — AMS</PageTitle>

@if (_toastVisible)
{
    <div class="ci-toast ci-toast-@_toastKind" role="status" aria-live="polite">
        <i class="bi @(_toastKind == "danger" ? "bi-exclamation-triangle-fill" : _toastKind == "warning" ? "bi-exclamation-circle-fill" : _toastKind == "info" ? "bi-info-circle-fill" : "bi-check-circle-fill")" aria-hidden="true"></i>
        <div>
            <strong>@_toastTitle</strong>
            <span>@_toastMessage</span>
        </div>
        <button type="button" class="ci-toast-close" @onclick="HideToast" aria-label="Close notification"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    </div>
}

<!-- ── COMPOSE DIALOG ────────────────────────────────────────────── -->
@if (_showComposeDlg)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="() => _showComposeDlg = false">
        <div class="mt-modal ci-action-modal" role="dialog" aria-modal="true" aria-labelledby="ci-compose-title" @onclick:stopPropagation="true">
        <div class="um-modal-header">
            <i class="bi @ChannelIcon(_compose.Channel)" aria-hidden="true"></i>
            <span id="ci-compose-title">New @_compose.Channel</span>
            <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showComposeDlg = false"><i class="bi bi-x-lg"></i></button>
        </div>
        <EditForm Model="_compose" OnValidSubmit="SendMessage">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="ci-compose-channel-row um-field--full">
                    @foreach (var ch in _channels)
                    {
                        <button type="button" class="ci-ch-pill @(_compose.Channel == ch ? "ci-ch-active" : "")"
                                @onclick="() => _compose.Channel = ch">
                            <i class="bi @ChannelIcon(ch)" aria-hidden="true"></i> @ch
                        </button>
                    }
                </div>
                <div class="um-form-grid" style="margin-top:.65rem;">
                    <div class="um-field"><label>Account / Contact <span class="text-danger">*</span></label>
                        <InputSelect @bind-Value="_compose.Account" class="um-input"><option value="">Select account</option>@foreach (var account in _accountNames) { <option value="@account">@account</option> }</InputSelect>
                        <ValidationMessage For="() => _compose.Account" class="text-danger" />
                    </div>
                    <div class="um-field"><label>To (Name or Address) <span class="text-danger">*</span></label>
                        <InputText @bind-Value="_compose.ToAddress" class="um-input" placeholder="@(_compose.Channel=="SMS" ? "Phone number" : _compose.Channel=="Email" ? "email@domain.com" : "Recipient name")" />
                        <ValidationMessage For="() => _compose.ToAddress" class="text-danger" />
                    </div>
                    @if (_compose.Channel == "Email")
                    {
                        <div class="um-field um-field--full"><label>Subject <span class="text-danger">*</span></label>
                            <InputText @bind-Value="_compose.Subject" class="um-input" placeholder="Email subject…" />
                            <ValidationMessage For="() => _compose.Subject" class="text-danger" />
                        </div>
                    }
                    <div class="um-field"><label>Template</label>
                        <InputSelect @bind-Value="_compose.Template" class="um-input"><option value="">Select template (optional)</option>@foreach (var template in _templates) { <option value="@template">@template</option> }</InputSelect>
                        <ValidationMessage For="() => _compose.Template" class="text-danger" />
                    </div>
                    <div class="um-field"><label>Priority</label>
                        <InputSelect @bind-Value="_compose.Priority" class="um-input"><option>Normal</option><option>High</option><option>Urgent</option></InputSelect>
                        <ValidationMessage For="() => _compose.Priority" class="text-danger" />
                    </div>
                    <div class="um-field um-field--full"><label>Message <span class="text-danger">*</span></label>
                        <InputTextArea @bind-Value="_compose.Body" class="um-input" rows="6" placeholder="@(_compose.Channel=="SMS" ? "Text message (160 chars recommended)…" : "Message body…")" />
                        <ValidationMessage For="() => _compose.Body" class="text-danger" />
                    </div>
                    @if (_compose.Channel is "Email" or "Portal Message")
                    {
                        <div class="ci-attach-row">
                            <button class="um-btn um-btn-ghost um-btn-xs">
                                <i class="bi bi-paperclip" aria-hidden="true"></i> Attach File
                            </button>
                            @foreach (var a in _compose.Attachments)
                            {
                                <span class="ci-attach-chip">@a <button @onclick="() => RemoveAttachmentAsync(a)">×</button></span>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showComposeDlg = false">Discard</button>
                <button type="button" class="um-btn um-btn-ghost" @onclick="SaveDraft">
                    <i class="bi bi-floppy" aria-hidden="true"></i> Save Draft
                </button>
                <button type="submit" class="um-btn um-btn-primary">
                    <i class="bi bi-send" aria-hidden="true"></i> Send
                </button>
            </div>
        </EditForm>
        </div>
    </div>
}

<!-- ── ASSIGN DIALOG ─────────────────────────────────────────────── -->
@if (_showAssignDlg)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="() => _showAssignDlg = false">
        <div class="mt-modal ci-compact-modal" role="dialog" aria-modal="true" aria-labelledby="ci-assign-title" @onclick:stopPropagation="true">
        <div class="um-modal-header"><i class="bi bi-person-check" aria-hidden="true"></i><span id="ci-assign-title">Assign Conversation</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showAssignDlg = false"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_assignForm" OnValidSubmit="ConfirmAssign">
            <DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field um-field--full"><label>Assign To <span class="text-danger">*</span></label><InputSelect @bind-Value="_assignForm.AssignTo" class="um-input"><option value="">Select agent</option>@foreach (var agent in _agents) { <option value="@agent">@agent</option> }</InputSelect><ValidationMessage For="() => _assignForm.AssignTo" class="text-danger" /></div>
                <div class="um-field um-field--full"><label>Note</label><InputTextArea @bind-Value="_assignForm.Note" class="um-input" rows="3" placeholder="Optional handoff note…" /><ValidationMessage For="() => _assignForm.Note" class="text-danger" /></div>
            </div></div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showAssignDlg = false">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Assign
                </button>
            </div>
        </EditForm>
        </div>
    </div>
}

<!-- ── ESCALATE DIALOG ───────────────────────────────────────────── -->
@if (_showEscalateDlg)
{
    <div class="mt-modal-backdrop" role="presentation" @onclick="() => _showEscalateDlg = false">
        <div class="mt-modal ci-compact-modal" role="dialog" aria-modal="true" aria-labelledby="ci-escalate-title" @onclick:stopPropagation="true">
        <div class="um-modal-header"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i><span id="ci-escalate-title">Escalate Conversation</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="() => _showEscalateDlg = false"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_escalateForm" OnValidSubmit="ConfirmEscalate">
            <DataAnnotationsValidator />
            <div class="um-modal-body"><div class="um-form-grid">
                <div class="um-field um-field--full"><label>Escalate To <span class="text-danger">*</span></label><InputSelect @bind-Value="_escalateForm.EscalateTo" class="um-input"><option value="">Select supervisor</option>@foreach (var supervisor in _supervisors) { <option value="@supervisor">@supervisor</option> }</InputSelect><ValidationMessage For="() => _escalateForm.EscalateTo" class="text-danger" /></div>
                <div class="um-field um-field--full"><label>Reason <span class="text-danger">*</span></label><InputSelect @bind-Value="_escalateForm.Reason" class="um-input"><option value="">Select reason</option>@foreach (var reason in _escalationReasons) { <option value="@reason">@reason</option> }</InputSelect><ValidationMessage For="() => _escalateForm.Reason" class="text-danger" /></div>
                <div class="um-field um-field--full"><label>Notes</label><InputTextArea @bind-Value="_escalateForm.Note" class="um-input" rows="3" placeholder="Escalation context…" /><ValidationMessage For="() => _escalateForm.Note" class="text-danger" /></div>
            </div></div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="() => _showEscalateDlg = false">Cancel</button>
                <button type="submit" class="um-btn um-btn-danger">
                    <i class="bi bi-arrow-up-circle" aria-hidden="true"></i> Escalate
                </button>
            </div>
        </EditForm>
        </div>
    </div>
}

<section class="ci-enterprise-page">
    <div class="ci-hero">
        <div class="ci-hero-left">
            <div class="ci-hero-icon"><i class="bi bi-inbox" aria-hidden="true"></i></div>
            <div class="ci-hero-info">
                <div class="ci-eyebrow">Tenant Administration · Communications Inbox</div>
                <div class="ci-title-row">
                    <h1>Tenant Communications Command Center</h1>
                    <span class="ci-status-pill">@FilteredList.Count() conversations</span>
                </div>
                <p>Administer inbound and outbound communications across channels, monitor unread and unassigned messages, escalate conversations, and coordinate team ownership.</p>
                <div class="ci-hero-chips">
                    <span><i class="bi bi-hdd-network" aria-hidden="true"></i> @ProviderHealthLabel</span>
                    <span><i class="bi bi-diagram-3" aria-hidden="true"></i> @ActiveQueueCount active queues</span>
                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> @ComplianceClearRate.ToString("0")% compliance clear</span>
                    <span><i class="bi bi-clock-history" aria-hidden="true"></i> @AverageResponseHours.ToString("0.0") hr avg response</span>
                </div>
            </div>
        </div>
        <div class="ci-hero-actions">
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick="Refresh"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
            <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenCompose"><i class="bi bi-pencil-square" aria-hidden="true"></i> Compose</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/communications/campaigns")'><i class="bi bi-megaphone" aria-hidden="true"></i> Campaigns</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/communications/templates")'><i class="bi bi-layout-text-sidebar" aria-hidden="true"></i> Templates</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/communications/outreach")'><i class="bi bi-telephone-outbound" aria-hidden="true"></i> Outreach Queue</button>
            <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/communications/notifications")'><i class="bi bi-bell" aria-hidden="true"></i> Notifications</button>
        </div>
    </div>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError
    </div>
}

<!-- ── KPI STRIP ─────────────────────────────────────────────────── -->
<div class="ci-kpi-strip">
    @CiKpi("bi-inbox",              "Total Unread",      _messages.Count(m => !m.IsRead).ToString(),                                              "ci-ki-blue", "unread")
    @CiKpi("bi-envelope",           "Email",             _messages.Count(m => m.Channel=="Email"   && !m.IsRead).ToString(),                      "ci-ki-blue", "ch-email")
    @CiKpi("bi-phone",              "SMS",               _messages.Count(m => m.Channel=="SMS"     && !m.IsRead).ToString(),                      "ci-ki-green", "ch-sms")
    @CiKpi("bi-sticky",             "Internal Notes",    _messages.Count(m => m.Channel=="Internal Note" && !m.IsRead).ToString(),                "ci-ki-amber", "ch-internal")
    @CiKpi("bi-globe",              "Portal",            _messages.Count(m => m.Channel=="Portal Message" && !m.IsRead).ToString(),               "ci-ki-purple", "ch-portal")
    @CiKpi("bi-person-x",           "Unassigned",        _messages.Count(m => string.IsNullOrEmpty(m.AssignedTo)).ToString(),                     "ci-ki-red", "unassigned")
    @CiKpi("bi-arrow-up-circle",    "Escalated",         _messages.Count(m => m.IsEscalated).ToString(),                                          "ci-ki-red", "escalated")
    @CiKpi("bi-clock-history",      "SLA Risk",          _messages.Count(m => m.SlaStatus is "At Risk" or "Breached").ToString(),                "ci-ki-gray", "aging")
</div>

<div class="ci-command-strip" aria-label="Command center operational health">
    <article><span><i class="bi bi-diagram-3" aria-hidden="true"></i> Queue Load</span><strong>@QueueLoadLabel</strong><small>@UnassignedCount unassigned · @EscalatedCount escalated</small></article>
    <article><span><i class="bi bi-stopwatch" aria-hidden="true"></i> SLA Health</span><strong>@SlaHealthLabel</strong><small>@SlaAtRiskCount at risk · @SlaBreachedCount breached</small></article>
    <article><span><i class="bi bi-shield-check" aria-hidden="true"></i> Compliance</span><strong>@ComplianceClearRate.ToString("0")%</strong><small>@ComplianceReviewCount review required</small></article>
    <article><span><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Last Sync</span><strong>@LastSyncLabel</strong><small>@ProviderHealthLabel</small></article>
</div>

<!-- ── 3-PANE INBOX LAYOUT ───────────────────────────────────────── -->
<div class="ci-layout">

    <!-- ────────────────── LEFT NAV SIDEBAR ──────────────────────── -->
    <aside class="ci-nav">

        <div class="ci-nav-section">
            <div class="ci-nav-section-lbl">Views</div>
            @NavItem("inbox",        "bi-inbox",           "All Inbox",    _messages.Count(m => !m.IsRead))
            @NavItem("unassigned",   "bi-person-x",        "Unassigned",   _messages.Count(m => string.IsNullOrEmpty(m.AssignedTo) && !m.IsRead))
            @NavItem("escalated",    "bi-arrow-up-circle", "Escalated",    _messages.Count(m => m.IsEscalated))
            @NavItem("mine",         "bi-person-check",    "Assigned to Me",_messages.Count(m => m.AssignedTo == _currentUser && !m.IsRead))
            @NavItem("drafts",       "bi-floppy",          "Drafts",       _messages.Count(m => m.Status == "Draft"))
            @NavItem("sent",         "bi-send",            "Sent",         0)
        </div>

        <div class="ci-nav-section">
            <div class="ci-nav-section-lbl">Group By</div>
            @NavItem("by-account",   "bi-building",        "By Account",   0)
            @NavItem("by-producer",  "bi-person-badge",    "By Producer",  0)
            @NavItem("by-branch",    "bi-diagram-2",       "By Branch",    0)
        </div>

        <div class="ci-nav-section">
            <div class="ci-nav-section-lbl">Channels</div>
            @NavItem("ch-email",     "bi-envelope",        "Email",         _messages.Count(m => m.Channel=="Email"          && !m.IsRead))
            @NavItem("ch-sms",       "bi-phone",           "SMS",           _messages.Count(m => m.Channel=="SMS"            && !m.IsRead))
            @NavItem("ch-internal",  "bi-sticky",          "Internal Notes",_messages.Count(m => m.Channel=="Internal Note"  && !m.IsRead))
            @NavItem("ch-portal",    "bi-globe",           "Portal",        _messages.Count(m => m.Channel=="Portal Message" && !m.IsRead))
        </div>

    </aside>

    <!-- ────────────────── MIDDLE MESSAGE LIST ───────────────────── -->
    <div class="ci-list-pane">

        <!-- Filter bar -->
        <div class="ci-list-toolbar">
            <input class="e-input ci-search" @bind="_search" @bind:event="oninput"
                   placeholder="Search messages, accounts, subjects…" />
            <select class="e-input ci-sel" @bind="_channelFilter">
                <option value="">All Channels</option>
                @foreach (var ch in _channels) { <option>@ch</option> }
            </select>
            <select class="e-input ci-sel" @bind="_statusFilter">
                <option value="">All Status</option>
                <option>Open</option><option>Pending</option><option>Resolved</option><option>Draft</option>
            </select>
            <select class="e-input ci-sel" @bind="_priorityFilter">
                <option value="">All Priority</option>
                <option>Urgent</option><option>High</option><option>Normal</option>
            </select>
            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters">
                <i class="bi bi-x" aria-hidden="true"></i>
            </button>
        </div>

        <!-- Sub-header with count + sort -->
        <div class="ci-list-header">
            <span class="ci-list-count">@ListLabel — <strong>@FilteredList.Count()</strong> conversation(s)</span>
            <div class="ci-sort-row">
                <button class="ci-sort-btn @(_sortNewest ? "ci-sort-active" : "")" @onclick='() => _sortNewest = true'>Newest</button>
                <button class="ci-sort-btn @(!_sortNewest ? "ci-sort-active" : "")" @onclick='() => _sortNewest = false'>Oldest</button>
            </div>
        </div>

        <!-- Message rows -->
        <div class="ci-message-list">
            @if (!FilteredList.Any())
            {
                <div class="ci-empty">
                    <i class="bi bi-inbox ci-empty-icon" aria-hidden="true"></i>
                    <span>No conversations match the current filters.</span>
                </div>
            }

            @foreach (var msg in (_sortNewest
                ? FilteredList.OrderByDescending(m => m.LastActivityAt)
                : FilteredList.OrderBy(m => m.LastActivityAt)))
            {
                <div class="ci-msg-row @(!msg.IsRead ? "ci-msg-unread" : "") @(_selected?.Id == msg.Id ? "ci-msg-selected" : "") @(msg.IsEscalated ? "ci-msg-escalated" : "")"
                     @onclick="() => SelectMessage(msg)">

                    <!-- Channel + unread dot -->
                    <div class="ci-msg-channel-col">
                        <span class="ci-ch-icon ci-ch-@ChannelCss(msg.Channel)" title="@msg.Channel">
                            <i class="bi @ChannelIcon(msg.Channel)" aria-hidden="true"></i>
                        </span>
                        @if (!msg.IsRead)
                        {
                            <span class="ci-unread-dot" aria-label="Unread"></span>
                        }
                    </div>

                    <!-- Message body preview -->
                    <div class="ci-msg-body-col">
                        <div class="ci-msg-top-row">
                            <span class="ci-msg-account @(!msg.IsRead ? "ci-msg-account-bold" : "")">@msg.AccountName</span>
                            <span class="ci-msg-time">@FormatTime(msg.LastActivityAt)</span>
                        </div>
                        <div class="ci-msg-subject @(!msg.IsRead ? "ci-msg-subject-bold" : "")">@msg.Subject</div>
                        <div class="ci-msg-preview">@msg.BodyPreview</div>
                        <div class="ci-msg-meta-row">
                            @if (!string.IsNullOrEmpty(msg.AssignedTo))
                            {
                                <span class="ci-meta-chip ci-mc-agent"><i class="bi bi-person" aria-hidden="true"></i>@msg.AssignedTo</span>
                            }
                            else
                            {
                                <span class="ci-meta-chip ci-mc-unassigned"><i class="bi bi-person-x" aria-hidden="true"></i>Unassigned</span>
                            }
                            @if (!string.IsNullOrEmpty(msg.Producer))
                            {
                                <span class="ci-meta-chip"><i class="bi bi-person-badge" aria-hidden="true"></i>@msg.Producer</span>
                            }
                            @if (!string.IsNullOrEmpty(msg.Branch))
                            {
                                <span class="ci-meta-chip"><i class="bi bi-diagram-2" aria-hidden="true"></i>@msg.Branch</span>
                            }
                            @if (msg.IsEscalated)
                            {
                                <span class="ci-meta-chip ci-mc-esc"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i>Escalated</span>
                            }
                            @if (msg.OptedOut)
                            {
                                <span class="ci-optout-chip"><i class="bi bi-slash-circle" aria-hidden="true"></i>Opt-Out</span>
                            }
                            <span class="ci-msg-count-chip">@msg.MessageCount msg</span>
                        </div>
                        <div class="ci-msg-intel-row">
                            <span class="ci-sentiment ci-sent-@SentimentCss(msg.Sentiment)" title="Sentiment: @msg.Sentiment">
                                @SentimentIcon(msg.Sentiment) @msg.Sentiment
                            </span>
                            @{ var ageH = GetUnansweredHours(msg); }
                            @if (ageH >= 4)
                            {
                                <span class="ci-aging-badge @(ageH >= 24 ? "ci-aging-hot" : ageH >= 8 ? "ci-aging-warm" : "ci-aging-cool")">
                                    <i class="bi bi-hourglass-split" aria-hidden="true"></i>@ageH&#8203;h unanswered
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(msg.CsrOwner))
                            {
                                <span class="ci-csr-chip"><i class="bi bi-headset" aria-hidden="true"></i>@msg.CsrOwner</span>
                            }
                            <span class="ci-queue-chip"><i class="bi bi-diagram-3" aria-hidden="true"></i>@msg.QueueName</span>
                            <span class="ci-sla-chip ci-sla-@SlaCss(msg.SlaStatus)"><i class="bi bi-stopwatch" aria-hidden="true"></i>@msg.SlaStatus</span>
                        </div>
                    </div>

                    <!-- Status + priority -->
                    <div class="ci-msg-status-col">
                        <span class="ci-status-badge ci-st-@StatusCss(msg.Status)">@msg.Status</span>
                        @if (msg.Priority != "Normal")
                        {
                            <span class="ci-pri-badge ci-pri-@msg.Priority.ToLower()">@msg.Priority</span>
                        }
                    </div>

                </div>
            }
        </div>
    </div>

    <!-- ────────────────── RIGHT DETAIL / THREAD PANE ────────────── -->
    <div class="ci-detail-pane @(_selected is null ? "ci-detail-empty" : "")">

        @if (_selected is null)
        {
            <div class="ci-detail-placeholder">
                <i class="bi bi-chat-left-text ci-dp-icon" aria-hidden="true"></i>
                <h3>Select a conversation</h3>
                <p>Choose a message on the left to view the full thread and reply.</p>
                <button class="um-btn um-btn-primary" @onclick="OpenCompose">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i> Compose New Message
                </button>
            </div>
        }
        else
        {
            <!-- Detail header -->
            <div class="ci-detail-header">
                <div class="ci-dh-left">
                    <span class="ci-ch-icon ci-ch-lg ci-ch-@ChannelCss(_selected.Channel)">
                        <i class="bi @ChannelIcon(_selected.Channel)" aria-hidden="true"></i>
                    </span>
                    <div>
                        <div class="ci-dh-subject">@_selected.Subject</div>
                        <div class="ci-dh-meta">
                            <span>@_selected.AccountName</span>
                            <span class="ci-dh-dot">·</span>
                            <span>@_selected.Channel</span>
                            @if (!string.IsNullOrEmpty(_selected.Producer))
                            {
                                <span class="ci-dh-dot">·</span>
                                <span>@_selected.Producer</span>
                            }
                            @if (!string.IsNullOrEmpty(_selected.Branch))
                            {
                                <span class="ci-dh-dot">·</span>
                                <span>@_selected.Branch</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="ci-dh-actions">
                    <button class="um-btn um-btn-ghost um-btn-xs"
                            @onclick='() => Nav.NavigateTo($"/communications/thread/{_selected.Id}")'
                            title="Open full thread">
                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                    </button>
                    @if (!_selected.IsRead)
                    {
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="MarkRead" title="Mark as read">
                            <i class="bi bi-check2-all" aria-hidden="true"></i>
                        </button>
                    }
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _showAssignDlg = true" title="Assign">
                        <i class="bi bi-person-check" aria-hidden="true"></i>
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _showEscalateDlg = true" title="Escalate">
                        <i class="bi bi-arrow-up-circle" aria-hidden="true"></i>
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResolveConversation" title="Resolve">
                        <i class="bi bi-check-circle" aria-hidden="true"></i>
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _selected = null" title="Close">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <!-- Conversation info pills -->
            <div class="ci-dh-pills">
                <span class="ci-status-badge ci-st-@StatusCss(_selected.Status)">@_selected.Status</span>
                @if (_selected.Priority != "Normal")
                {
                    <span class="ci-pri-badge ci-pri-@_selected.Priority.ToLower()">@_selected.Priority</span>
                }
                @if (_selected.IsEscalated)
                {
                    <span class="ci-meta-chip ci-mc-esc"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i>Escalated</span>
                }
                @if (!string.IsNullOrEmpty(_selected.AssignedTo))
                {
                    <span class="ci-meta-chip ci-mc-agent"><i class="bi bi-person" aria-hidden="true"></i>@_selected.AssignedTo</span>
                }
                else
                {
                    <span class="ci-meta-chip ci-mc-unassigned"><i class="bi bi-person-x" aria-hidden="true"></i>Unassigned</span>
                }
                @if (!string.IsNullOrEmpty(_selected.CsrOwner))
                {
                    <span class="ci-meta-chip ci-mc-csr"><i class="bi bi-headset" aria-hidden="true"></i>CSR: @_selected.CsrOwner</span>
                }
                <span class="ci-sentiment ci-sent-@SentimentCss(_selected.Sentiment) ci-sent-pill">
                    @SentimentIcon(_selected.Sentiment) @_selected.Sentiment
                </span>
                @{ var detailAge = GetUnansweredHours(_selected); }
                @if (detailAge >= 4)
                {
                    <span class="ci-aging-badge @(detailAge >= 24 ? "ci-aging-hot" : detailAge >= 8 ? "ci-aging-warm" : "ci-aging-cool")">
                        <i class="bi bi-hourglass-split" aria-hidden="true"></i>@detailAge&#8203;h unanswered
                    </span>
                }
                <span class="ci-meta-chip"><i class="bi bi-clock" aria-hidden="true"></i>@_selected.LastActivityAt.ToString("MM/dd/yyyy h:mm tt")</span>
                <span class="ci-meta-chip"><i class="bi bi-diagram-3" aria-hidden="true"></i>@_selected.QueueName</span>
                <span class="ci-sla-chip ci-sla-@SlaCss(_selected.SlaStatus)"><i class="bi bi-stopwatch" aria-hidden="true"></i>@_selected.SlaStatus (@FormatSla(_selected))</span>
                <span class="ci-meta-chip"><i class="bi bi-shield-check" aria-hidden="true"></i>@_selected.ComplianceStatus</span>
                <span class="ci-meta-chip"><i class="bi bi-arrow-repeat" aria-hidden="true"></i>@_selected.SourceSystem · @FormatTime(_selected.LastSyncedDateUtc)</span>
            </div>

            @if (_selected.OptedOut)
            {
                <div class="ci-optout-warning">
                    <i class="bi bi-slash-circle" aria-hidden="true"></i>
                    <strong>Opt-Out / Do Not Contact</strong> — This contact has opted out of direct @_selected.Channel communication.
                    Route all outreach through the designated representative or via legal counsel.
                </div>
            }

            @if (!string.IsNullOrEmpty(_selected.AiSummary))
            {
                <div class="ci-ai-summary">
                    <div class="ci-ai-summary-hdr">
                        <i class="bi bi-stars" aria-hidden="true"></i> AI Thread Summary
                        <span class="ci-ai-badge">Auto-generated</span>
                    </div>
                    <div class="ci-ai-summary-body">@_selected.AiSummary</div>
                </div>
            }

            <!-- Message thread -->
            <div class="ci-thread">
                @foreach (var msg in _selected.Thread.OrderBy(t => t.SentAt))
                {
                    var isOutbound = msg.Direction == "Outbound";
                    <div class="ci-bubble-wrap @(isOutbound ? "ci-bubble-out" : "ci-bubble-in")">
                        <div class="ci-bubble @(isOutbound ? "ci-bubble-outbound" : "ci-bubble-inbound") ci-bbl-@ChannelCss(msg.Channel)">
                            <div class="ci-bubble-header">
                                <span class="ci-bubble-sender">@msg.SenderName</span>
                                <span class="ci-bubble-ch"><i class="bi @ChannelIcon(msg.Channel)" aria-hidden="true"></i>@msg.Channel</span>
                                <span class="ci-bubble-time">@FormatTime(msg.SentAt)</span>
                                @if (msg.IsAutomated)
                                {
                                    <span class="ci-auto-badge"><i class="bi bi-robot" aria-hidden="true"></i>Auto</span>
                                }
                            </div>
                            <div class="ci-bubble-body">@msg.Body</div>
                            @if (msg.Attachments.Any())
                            {
                                <div class="ci-bubble-attachments">
                                    @foreach (var a in msg.Attachments)
                                    {
                                        <span class="ci-attach-chip-sm"><i class="bi bi-paperclip" aria-hidden="true"></i>@a</span>
                                    }
                                </div>
                            }
                            @if (msg.DeliveryStatus != "Delivered")
                            {
                                <div class="ci-bubble-status ci-ds-@msg.DeliveryStatus.ToLower()">
                                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @msg.DeliveryStatus
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Reply box -->
            <div class="ci-reply-box">
                <div class="ci-reply-toolbar">
                    <div class="ci-reply-ch-row">
                        @foreach (var ch in _channels)
                        {
                            <button class="ci-ch-pill ci-ch-pill-sm @(_reply.Channel == ch ? "ci-ch-active" : "")"
                                    @onclick="() => _reply.Channel = ch">
                                <i class="bi @ChannelIcon(ch)" aria-hidden="true"></i>
                                @if (ch != "Internal Note") { @ch } else { <span>Note</span> }
                            </button>
                        }
                    </div>
                    <div class="ci-reply-tools">
                        <select class="e-input ci-tpl-sel" @bind="_reply.Template" @bind:after="ApplyTemplate">
                            <option value="">Use template…</option>
                            @foreach (var t in _templates) { <option>@t</option> }
                        </select>
                        <button class="um-btn um-btn-ghost um-btn-xs" title="Attach">
                            <i class="bi bi-paperclip" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                @if (_reply.Channel == "Email")
                {
                    <input class="e-input ci-reply-subject" @bind="_reply.Subject" placeholder="Subject…" />
                }

                <textarea class="ci-reply-textarea"
                          rows="4"
                          @bind="_reply.Body"
                          @bind:event="oninput"
                          placeholder="@(_reply.Channel=="SMS" ? "Type a text message…" : _reply.Channel=="Internal Note" ? "Write an internal note (not visible to client)…" : _reply.Channel=="Portal Message" ? "Write a portal message…" : "Write your reply…")"></textarea>

                <div class="ci-reply-footer">
                    <div class="ci-reply-footer-left">
                        @if (_reply.Channel == "SMS")
                        {
                            <span class="ci-char-count @(_reply.Body.Length > 160 ? "ci-char-warn" : "")">
                                @_reply.Body.Length / 160 chars
                            </span>
                        }
                        @if (_reply.Channel == "Internal Note")
                        {
                            <span class="ci-internal-note-hint">
                                <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                Internal only — not sent to client
                            </span>
                        }
                    </div>
                    <div class="ci-reply-footer-right">
                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="DiscardReply">Discard</button>
                        <button class="um-btn um-btn-primary um-btn-sm" @onclick="SendReply"
                                disabled="@(string.IsNullOrWhiteSpace(_reply.Body))">
                            <i class="bi @(_reply.Channel=="Internal Note" ? "bi-sticky" : "bi-send")" aria-hidden="true"></i>
                            @(_reply.Channel=="Internal Note" ? "Add Note" : "Send Reply")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

</div>
</section>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    bool _toastVisible;
    string _toastTitle = string.Empty;
    string _toastMessage = string.Empty;
    string _toastKind = "success";

    // ── State ─────────────────────────────────────────────────────
    string _view           = "inbox";
    string _search         = "";
    string _channelFilter  = "";
    string _statusFilter   = "";
    string _priorityFilter = "";
    string? _loadError;
    bool   _sortNewest     = true;
    string? _activeKpi;

    bool   _showComposeDlg  = false;
    bool   _showAssignDlg   = false;
    bool   _showEscalateDlg = false;

    AssignForm _assignForm = new();
    EscalateForm _escalateForm = new();

    const string _currentUser = "Sarah Kim";

    ConversationThread? _selected = null;

    ComposeForm _compose = new();
    ReplyForm   _reply   = new();

    // ── Lookups ───────────────────────────────────────────────────
    readonly string[] _channels     = { "Email", "SMS", "Internal Note", "Portal Message" };
    readonly string[] _agents       = { "Sarah Kim", "James Park", "Kevin Obi", "Maria Santos", "Lisa Chen" };
    readonly string[] _supervisors  = { "Diana Perez", "Robert Yamamoto" };
    readonly string[] _escalationReasons = { "Complaint", "Coverage Dispute", "Legal Threat", "Regulatory Issue", "VIP Client", "Complex Situation", "Other" };
    readonly string[] _accountNames = { "Sullivan Mfg. LLC", "Bridgewater Hotels", "Metro Freight Co.", "Apex Medical Group", "Dallas Roofing LLC", "Harbor View Marina", "Greenleaf Nurseries", "Sunrise Healthcare", "Pacific Coast Builders" };
    readonly string[] _templates    = { "Policy Renewal Reminder", "Claim Acknowledgement", "Coverage Review Invitation", "Payment Due Reminder", "CAT Event Check-In", "Certificate Request Confirmation", "Auto Endorsement Confirmation", "Welcome — New Client" };

    // ── Data ──────────────────────────────────────────────────────
    List<ConversationThread> _messages = new();

    // ── Models ────────────────────────────────────────────────────
    sealed class ConversationThread
    {
        public Guid     Id              { get; set; }
        public string   AccountName     { get; set; } = "";
        public string   AccountId       { get; set; } = "";
        public string   ContactName     { get; set; } = "";
        public string   ContactEmail    { get; set; } = "";
        public string   ContactPhone    { get; set; } = "";
        public string   Channel         { get; set; } = "";
        public string   Subject         { get; set; } = "";
        public string   BodyPreview     { get; set; } = "";
        public string   Status          { get; set; } = "";
        public string   Priority        { get; set; } = "Normal";
        public string   AssignedTo      { get; set; } = "";
        public string   Producer        { get; set; } = "";
        public string   Branch          { get; set; } = "";
        public bool     IsRead          { get; set; }
        public bool     IsEscalated     { get; set; }
        public bool     OptedOut        { get; set; }
        public int      MessageCount    { get; set; }
        public DateTime LastActivityAt  { get; set; }
        // ── Intelligence fields ──────────────────────────────
        public string   Sentiment       { get; set; } = "Neutral"; // Positive | Neutral | Negative | Urgent
        public string   CsrOwner        { get; set; } = "";
        public string   AiSummary       { get; set; } = "";
        public string   QueueName       { get; set; } = "General Inbox";
        public string   SlaStatus       { get; set; } = "On Track";
        public int      SlaMinutesRemaining { get; set; }
        public DateTime? DueDateUtc     { get; set; }
        public string   ComplianceStatus { get; set; } = "Clear";
        public string   SourceSystem    { get; set; } = "AMS";
        public DateTime LastSyncedDateUtc { get; set; }
        public List<ThreadMessage> Thread { get; set; } = new();
    }

    sealed class ThreadMessage
    {
        public string   SenderName      { get; set; } = "";
        public string   Channel         { get; set; } = "";
        public string   Direction       { get; set; } = "Inbound"; // Inbound | Outbound
        public string   Body            { get; set; } = "";
        public DateTime SentAt          { get; set; }
        public string   DeliveryStatus  { get; set; } = "Delivered";
        public bool     IsAutomated     { get; set; }
        public string   ExternalMessageId { get; set; } = "";
        public string   ProviderName    { get; set; } = "AMS";
        public DateTime? DeliveredAtUtc { get; set; }
        public DateTime? ReadAtUtc      { get; set; }
        public List<string> Attachments { get; set; } = new();
    }

    sealed class ComposeForm
    {
        [Required, StringLength(40)]
        public string Channel    { get; set; } = "Email";
        [Required, StringLength(200)]
        public string Account    { get; set; } = "";
        [Required, StringLength(254)]
        public string ToAddress  { get; set; } = "";
        [StringLength(200)]
        public string Subject    { get; set; } = "";
        [StringLength(120)]
        public string Template   { get; set; } = "";
        [Required, StringLength(20)]
        public string Priority   { get; set; } = "Normal";
        [Required, StringLength(4000)]
        public string Body       { get; set; } = "";
        public List<string> Attachments { get; set; } = new();
    }

    sealed class AssignForm
    {
        [Required, StringLength(120)] public string AssignTo { get; set; } = "";
        [StringLength(500)] public string Note { get; set; } = "";
    }

    sealed class EscalateForm
    {
        [Required, StringLength(120)] public string EscalateTo { get; set; } = "";
        [Required, StringLength(80)] public string Reason { get; set; } = "";
        [StringLength(500)] public string Note { get; set; } = "";
    }

    sealed class ReplyForm
    {
        public string Channel  { get; set; } = "Email";
        public string Subject  { get; set; } = "";
        public string Template { get; set; } = "";
        public string Body     { get; set; } = "";
    }

    // ── Filtering ─────────────────────────────────────────────────
    IEnumerable<ConversationThread> FilteredList => _messages
        .Where(m =>
            MatchView(m)
         && MatchKpi(m)
         && (string.IsNullOrEmpty(_search) ||
             m.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             m.Subject.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             m.BodyPreview.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
             m.ContactName.Contains(_search, StringComparison.OrdinalIgnoreCase))
         && (string.IsNullOrEmpty(_channelFilter)  || m.Channel   == _channelFilter)
         && (string.IsNullOrEmpty(_statusFilter)   || m.Status    == _statusFilter)
         && (string.IsNullOrEmpty(_priorityFilter) || m.Priority  == _priorityFilter));

    bool MatchView(ConversationThread m) => _view switch
    {
        "unassigned"  => string.IsNullOrEmpty(m.AssignedTo),
        "escalated"   => m.IsEscalated,
        "mine"        => m.AssignedTo == _currentUser,
        "drafts"      => m.Status == "Draft",
        "sent"        => m.Thread.Any(t => t.Direction == "Outbound"),
        "by-account"  => true,
        "by-producer" => true,
        "by-branch"   => true,
        "ch-email"    => m.Channel == "Email",
        "ch-sms"      => m.Channel == "SMS",
        "ch-internal" => m.Channel == "Internal Note",
        "ch-portal"   => m.Channel == "Portal Message",
        _             => true   // inbox = all
    };

    bool MatchKpi(ConversationThread m) => _activeKpi switch
    {
        "unread" => !m.IsRead,
        "aging" => m.SlaStatus is "At Risk" or "Breached",
        null => true,
        _ => true
    };

    int UnassignedCount => _messages.Count(m => string.IsNullOrEmpty(m.AssignedTo));
    int EscalatedCount => _messages.Count(m => m.IsEscalated);
    int SlaAtRiskCount => _messages.Count(m => m.SlaStatus == "At Risk");
    int SlaBreachedCount => _messages.Count(m => m.SlaStatus == "Breached");
    int ComplianceReviewCount => _messages.Count(m => m.ComplianceStatus != "Clear");
    int ActiveQueueCount => _messages.Select(m => m.QueueName).Where(q => !string.IsNullOrWhiteSpace(q)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    decimal ComplianceClearRate => _messages.Count == 0 ? 100 : (decimal)_messages.Count(m => m.ComplianceStatus == "Clear") / _messages.Count * 100;
    double AverageResponseHours => _messages.Count == 0 ? 0 : _messages.Average(m => Math.Max(0, GetUnansweredHours(m)));
    string QueueLoadLabel => _messages.Count == 0 ? "No active load" : $"{_messages.Count} conversations";
    string SlaHealthLabel => SlaBreachedCount > 0 ? "Breached" : SlaAtRiskCount > 0 ? "At Risk" : "On Track";
    string ProviderHealthLabel => _messages.Any(m => m.LastSyncedDateUtc < DateTime.UtcNow.AddHours(-2)) ? "Sync review" : "Providers healthy";
    string LastSyncLabel => _messages.Count == 0 ? "No sync" : FormatTime(_messages.Max(m => m.LastSyncedDateUtc));

    string ListLabel => _view switch
    {
        "unassigned"  => "Unassigned",
        "escalated"   => "Escalated",
        "mine"        => "Assigned to Me",
        "drafts"      => "Drafts",
        "sent"        => "Sent",
        "by-account"  => "By Account",
        "by-producer" => "By Producer",
        "by-branch"   => "By Branch",
        "ch-email"    => "Email",
        "ch-sms"      => "SMS",
        "ch-internal" => "Internal Notes",
        "ch-portal"   => "Portal Messages",
        _             => "All Inbox"
    };

    // ── Tenant (placeholder until auth context is wired) ──────────
    private Guid _tenantId;

    // ── Lifecycle ─────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Communications","/communications/inbox"), new("Inbox",""));
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            var dtos = await Api.GetMessageThreadsAsync(_tenantId);
            _messages = (dtos ?? []).Select(MapThread).ToList();
        }
        catch (Exception ex)
        {
            _messages = [];
            _selected = null;
            _loadError = $"Unable to load communications: {ex.Message}";
            ShowToast("Inbox unavailable", $"Unable to load communications: {ex.Message}", "danger");
        }
    }

    private async Task RemoveAttachmentAsync(string attachment)
    {
        if (!await Confirmations.ConfirmAsync("Remove attachment", $"Remove attachment {attachment}?", "Remove")) return;
        _compose.Attachments.Remove(attachment);
    }

    static ConversationThread MapThread(MessageThreadDto d) => new()
    {
        Id            = d.ThreadId,
        AccountName   = d.AccountName,
        AccountId     = d.AccountId ?? string.Empty,
        ContactName   = d.ContactName,
        ContactEmail  = d.ContactEmail ?? string.Empty,
        ContactPhone  = d.ContactPhone ?? string.Empty,
        Channel       = d.Channel,
        Subject       = d.Subject,
        BodyPreview   = d.BodyPreview,
        Status        = d.Status,
        Priority      = d.Priority,
        AssignedTo    = d.AssignedTo ?? string.Empty,
        Producer      = d.Producer ?? string.Empty,
        Branch        = d.Branch ?? string.Empty,
        IsRead        = d.IsRead,
        IsEscalated   = d.IsEscalated,
        OptedOut      = d.OptedOut,
        MessageCount  = d.MessageCount,
        LastActivityAt= d.LastActivityAt,
        Sentiment     = d.Sentiment,
        CsrOwner      = d.CsrOwner ?? string.Empty,
        AiSummary     = d.AiSummary ?? string.Empty,
        QueueName     = d.QueueName,
        SlaStatus     = d.SlaStatus,
        SlaMinutesRemaining = d.SlaMinutesRemaining,
        DueDateUtc    = d.DueDateUtc,
        ComplianceStatus = d.ComplianceStatus,
        SourceSystem  = d.SourceSystem,
        LastSyncedDateUtc = d.LastSyncedDateUtc == default ? d.LastActivityAt : d.LastSyncedDateUtc,
        Thread        = d.Messages.Select(m => new ThreadMessage
        {
            SenderName     = m.SenderName,
            Channel        = m.Channel,
            Direction      = m.Direction,
            Body           = m.Body,
            SentAt         = m.SentAt,
            DeliveryStatus = m.DeliveryStatus,
            IsAutomated    = m.IsAutomated,
            ExternalMessageId = m.ExternalMessageId,
            ProviderName   = m.ProviderName,
            DeliveredAtUtc = m.DeliveredAtUtc,
            ReadAtUtc      = m.ReadAtUtc,
            Attachments    = m.Attachments.ToList()
        }).ToList()
    };

    // ── Interactions ──────────────────────────────────────────────
    void SelectMessage(ConversationThread msg)
    {
        _selected    = msg;
        msg.IsRead   = true;
        _reply       = new ReplyForm { Channel = msg.Channel == "Internal Note" ? "Internal Note" : msg.Channel };
    }

    void OpenCompose() { _compose = new(); _showComposeDlg = true; }

    async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_compose.Body)) return;
        await Api.SendMessageAsync(new SendMessageRequest(
            _tenantId, _compose.Account, null, _compose.Channel,
            string.IsNullOrEmpty(_compose.Subject) ? "(No subject)" : _compose.Subject,
            _compose.Body, _compose.Priority, _currentUser, _compose.Template));
        _showComposeDlg = false;
        var account = _compose.Account;
        var channel  = _compose.Channel;
        _compose = new();
        await LoadAsync();
        ShowToast("Sent", $"{channel} sent to {account}.");
    }

    async Task SaveDraft()
    {
        _showComposeDlg = false;
        ShowToast("Draft Saved", "Message saved as draft.", "info");
        await Task.CompletedTask;
    }

    async Task SendReply()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_reply.Body)) return;
        await Api.ReplyMessageAsync(_selected.Id,
            new ReplyMessageRequest(_selected.Id, _currentUser, _reply.Channel, _reply.Body));
        var ch = _reply.Channel;
        _reply = new ReplyForm { Channel = _selected.Channel };
        await LoadAsync();
        _selected = _messages.FirstOrDefault(m => m.Id == _selected?.Id);
        ShowToast("Reply Sent", $"{ch} reply sent.");
    }

    void DiscardReply() { _reply = new ReplyForm { Channel = _selected?.Channel ?? "Email" }; }

    async Task MarkRead()
    {
        if (_selected is null) return;
        await Api.MarkThreadReadAsync(_selected.Id);
        _selected.IsRead = true;
        ShowToast("Marked Read", "Conversation marked as read.", "info");
    }

    async Task ResolveConversation()
    {
        if (_selected is null) return;
        await Api.ResolveThreadAsync(_selected.Id);
        _selected.Status = "Resolved";
        ShowToast("Resolved", $"Conversation with {_selected.AccountName} resolved.");
    }

    async Task ConfirmAssign()
    {
        if (_selected is null || string.IsNullOrEmpty(_assignForm.AssignTo)) return;
        await Api.AssignThreadAsync(_selected.Id, new AssignThreadRequest(_selected.Id, _assignForm.AssignTo, _assignForm.Note));
        _showAssignDlg = false;
        var assignedTo = _assignForm.AssignTo;
        _assignForm = new();
        await LoadAsync();
        _selected = _messages.FirstOrDefault(m => m.Id == _selected?.Id);
        ShowToast("Assigned", $"Conversation assigned to {assignedTo}.");
    }

    async Task ConfirmEscalate()
    {
        if (_selected is null || string.IsNullOrEmpty(_escalateForm.EscalateTo)) return;
        await Api.EscalateThreadAsync(_selected.Id, new EscalateThreadRequest(_selected.Id, _escalateForm.EscalateTo, _escalateForm.Reason, _escalateForm.Note));
        _showEscalateDlg = false;
        var escalatedTo = _escalateForm.EscalateTo;
        _escalateForm = new();
        await LoadAsync();
        _selected = _messages.FirstOrDefault(m => m.Id == _selected?.Id);
        ShowToast("Escalated", $"Conversation escalated to {escalatedTo}.", "warning");
    }

    void ApplyTemplate()
    {
        if (string.IsNullOrEmpty(_reply.Template)) return;
        _reply.Body = _reply.Template switch
        {
            "Policy Renewal Reminder"           => "Dear [Client Name],\n\nYour policy is approaching its renewal date. Please review the attached renewal proposal and contact us with any questions or changes. We're here to ensure your coverage continues without interruption.\n\nBest regards,\n[Agent Name] | AMS Insurance",
            "Claim Acknowledgement"             => "Dear [Client Name],\n\nWe have received your claim and assigned it to our claims team. Your claim number is [Claim #]. A handler will be in touch within 1 business day.\n\nBest regards,\n[Agent Name] | AMS Insurance",
            "Certificate Request Confirmation"  => "Dear [Client Name],\n\nYour Certificate of Insurance request has been received. We will process and deliver your COI within [X] business hours.\n\nPlease reply if you need to add additional insured information.\n\nBest regards,\n[Agent Name] | AMS Insurance",
            "Payment Due Reminder"              => "Dear [Client Name],\n\nThis is a friendly reminder that your premium payment is due on [Due Date]. To avoid any lapse in coverage, please ensure payment is submitted by that date.\n\nBest regards,\n[Agent Name] | AMS Insurance",
            "CAT Event Check-In"                => "Dear [Client Name],\n\nWe wanted to reach out following the recent weather event in your area. If your property has sustained any damage, please don't hesitate to contact us immediately to file a claim. Our CAT team is standing by.\n\nBest regards,\n[Agent Name] | AMS Insurance",
            _                                   => _reply.Body
        };
    }

    async Task Refresh() => await LoadAsync();
    void ResetFilters() { _search=""; _channelFilter=""; _statusFilter=""; _priorityFilter=""; _activeKpi = null; _view = "inbox"; }

    void SetKpiFilter(string key)
    {
        if (_activeKpi == key)
        {
            _activeKpi = null;
            _view = "inbox";
            _channelFilter = string.Empty;
            _selected = null;
            return;
        }

        _activeKpi = key;
        _selected = null;
        _channelFilter = string.Empty;
        _statusFilter = string.Empty;
        _priorityFilter = string.Empty;
        _view = key switch
        {
            "ch-email" => "ch-email",
            "ch-sms" => "ch-sms",
            "ch-internal" => "ch-internal",
            "ch-portal" => "ch-portal",
            "unassigned" => "unassigned",
            "escalated" => "escalated",
            _ => "inbox"
        };
    }

    void ShowToast(string title, string message, string kind = "success")
    {
        _toastTitle = title;
        _toastMessage = message;
        _toastKind = kind;
        _toastVisible = true;
    }

    void HideToast() => _toastVisible = false;

    // ── Helpers ───────────────────────────────────────────────────
    static string ChannelIcon(string ch) => ch switch
    {
        "Email"          => "bi-envelope",
        "SMS"            => "bi-phone",
        "Internal Note"  => "bi-sticky",
        "Portal Message" => "bi-globe",
        _                => "bi-chat-dots"
    };

    static string ChannelCss(string ch) => ch switch
    {
        "Email"          => "email",
        "SMS"            => "sms",
        "Internal Note"  => "note",
        "Portal Message" => "portal",
        _                => "gen"
    };

    static string StatusCss(string s) => s.ToLower().Replace(" ","-");

    static string FormatTime(DateTime dt)
    {
        var diff = DateTime.Now - dt;
        if (diff.TotalMinutes < 60)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours   < 24)  return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 7)   return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("MM/dd/yyyy");
    }

    // ── Sentiment / aging / opt-out helpers ─────────────────────
    static string SentimentIcon(string s) => s switch
    {
        "Positive" => "👍",
        "Negative" => "👎",
        "Urgent"   => "⚠️",
        _          => "🟡"
    };
    static string SentimentCss(string s)  => s.ToLower();

    static string SlaCss(string status) => status.ToLower().Replace(" ", "-");

    static string FormatSla(ConversationThread t)
        => t.SlaStatus == "Completed" ? "done"
         : t.SlaMinutesRemaining < 0 ? $"{Math.Abs(t.SlaMinutesRemaining)}m overdue"
         : t.SlaMinutesRemaining >= 60 ? $"{t.SlaMinutesRemaining / 60}h left"
         : $"{t.SlaMinutesRemaining}m left";

    static int GetUnansweredHours(ConversationThread t)
    {
        var lastIn = t.Thread.Where(m => m.Direction == "Inbound").MaxBy(m => m.SentAt);
        if (lastIn is null) return 0;
        var hasOutboundAfter = t.Thread.Any(m => m.Direction == "Outbound" && m.SentAt > lastIn.SentAt);
        return hasOutboundAfter ? 0 : (int)(DateTime.Now - lastIn.SentAt).TotalHours;
    }

    // ── Render helpers ──────────────────────────────────
    void SetNavView(string view)
    {
        _view = view;
        _activeKpi = null;
        _selected = null;
    }

    RenderFragment NavItem(string view, string icon, string label, int badge) => __builder =>
    {
        <button class="ci-nav-item @(_view == view && _activeKpi is null ? "ci-nav-active" : "")" @onclick="() => SetNavView(view)">
            <i class="bi @icon" aria-hidden="true"></i>
            <span>@label</span>
            @if (badge > 0)
            {
                <span class="ci-nav-badge">@badge</span>
            }
        </button>
    };

    RenderFragment CiKpi(string icon, string label, string val, string color, string key) => __builder =>
    {
        <button type="button" class="ci-kpi-card @color @(_activeKpi == key ? "ci-kpi-active" : "")" @onclick="() => SetKpiFilter(key)" title="@(_activeKpi == key ? "Clear KPI filter" : $"Filter by {label}")">
            <i class="bi @icon ci-kpi-icon" aria-hidden="true"></i>
            <div><div class="ci-kpi-val">@val</div><div class="ci-kpi-lbl">@label</div></div>
        </button>
    };

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
