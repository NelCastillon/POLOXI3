    static ConversationThread Thread(
        string account, string contact, string email, string phone,
        string channel, string subject, string preview,
        string status, string priority, string assignedTo, string branch, string producer,
        bool escalated, DateTime lastActivity, ThreadMessage[] messages) => new()
    {
        Id            = Guid.NewGuid(),
        AccountName   = account,
        ContactName   = contact,
        ContactEmail  = email,
        ContactPhone  = phone,
        Channel       = channel,
        Subject       = subject,
        BodyPreview   = preview,
        Status        = status,
        Priority      = priority,
        AssignedTo    = assignedTo,
        Branch        = branch,
        Producer      = producer,
        IsEscalated   = escalated,
        IsRead        = false,
        MessageCount  = messages.Length,
        LastActivityAt= lastActivity,
        Thread        = messages.ToList()
    };

    static ThreadMessage Msg(
        string sender, string channel, string direction, string body, DateTime sentAt,
        bool automated = false, string[] attachments = null!, string deliveryStatus = "Delivered") => new()
    {
        SenderName    = sender,
        Channel       = channel,
        Direction     = direction,
        Body          = body,
        SentAt        = sentAt,
        IsAutomated   = automated,
        Attachments   = (attachments ?? Array.Empty<string>()).ToList(),
        DeliveryStatus= deliveryStatus
    };

    // ── Interactions ──────────────────────────────────────────────
    void SelectMessage(ConversationThread msg)
    {
        _selected    = msg;
        msg.IsRead   = true;
        _reply       = new ReplyForm { Channel = msg.Channel == "Internal Note" ? "Internal Note" : msg.Channel };
    }

    void OpenCompose() { _compose = new(); _showComposeDlg = true; }

    async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_compose.Body)) return;
        _messages.Insert(0, new ConversationThread
        {
            Id             = Guid.NewGuid(),
            AccountName    = _compose.Account,
            Channel        = _compose.Channel,
            Subject        = string.IsNullOrEmpty(_compose.Subject) ? "(No subject)" : _compose.Subject,
            BodyPreview    = _compose.Body[..Math.Min(100,_compose.Body.Length)],
            Status         = "Open",
            Priority       = _compose.Priority,
            AssignedTo     = _currentUser,
            IsRead         = true,
            MessageCount   = 1,
            LastActivityAt = DateTime.Now,
            Thread         = new List<ThreadMessage> { Msg(_currentUser, _compose.Channel, "Outbound", _compose.Body, DateTime.Now) }
        });
        _showComposeDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Sent", Content=$"{_compose.Channel} sent to {_compose.Account}.", CssClass="e-toast-success" });
    }

    async Task SaveDraft()
    {
        _showComposeDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Draft Saved", Content="Message saved as draft.", CssClass="e-toast-info" });
    }

    async Task SendReply()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_reply.Body)) return;
        _selected.Thread.Add(Msg(_currentUser, _reply.Channel, "Outbound", _reply.Body, DateTime.Now));
        _selected.MessageCount++;
        _selected.LastActivityAt = DateTime.Now;
        _selected.Status = "Pending";
        var body = _reply.Body;
        _reply = new ReplyForm { Channel = _selected.Channel };
        await _toast.ShowAsync(new ToastModel { Title="Reply Sent", Content=$"{_selected.Channel} reply sent.", CssClass="e-toast-success" });
    }

    void DiscardReply() { _reply = new ReplyForm { Channel = _selected?.Channel ?? "Email" }; }

    async Task MarkRead()
    {
        if (_selected is null) return;
        _selected.IsRead = true;
        await _toast.ShowAsync(new ToastModel { Title="Marked Read", Content="Conversation marked as read.", CssClass="e-toast-info" });
    }

    async Task ResolveConversation()
    {
        if (_selected is null) return;
        _selected.Status = "Resolved";
        await _toast.ShowAsync(new ToastModel { Title="Resolved", Content=$"Conversation with {_selected.AccountName} resolved.", CssClass="e-toast-success" });
    }

    async Task ConfirmAssign()
    {
        if (_selected is null || string.IsNullOrEmpty(_assignTo)) return;
        _selected.AssignedTo = _assignTo;
        _selected.Thread.Add(Msg("System", "Internal Note", "Outbound", $"Assigned to {_assignTo}.{(string.IsNullOrEmpty(_assignNote) ? "" : " Note: " + _assignNote)}", DateTime.Now));
        _selected.MessageCount++;
        _showAssignDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Assigned", Content=$"Conversation assigned to {_assignTo}.", CssClass="e-toast-success" });
    }

    async Task ConfirmEscalate()
    {
        if (_selected is null || string.IsNullOrEmpty(_escalateTo)) return;
        _selected.IsEscalated = true;
        _selected.Priority    = "Urgent";
        _selected.AssignedTo  = _escalateTo;
        _selected.Thread.Add(Msg("System", "Internal Note", "Outbound", $"Escalated to {_escalateTo}. Reason: {_escalateReason}.{(string.IsNullOrEmpty(_escalateNote) ? "" : " " + _escalateNote)}", DateTime.Now));
        _selected.MessageCount++;
        _showEscalateDlg = false;
        await _toast.ShowAsync(new ToastModel { Title="Escalated", Content=$"Conversation escalated to {_escalateTo}.", CssClass="e-toast-warning" });
    }

    void ApplyTemplate()
    {
        if (string.IsNullOrEmpty(_reply.Template)) return;
        _reply.Body = _reply.Template switch
        {
            "Policy Renewal Reminder"           => "Dear [Client Name],\n\nYour policy is approaching its renewal date. Please review the attached renewal proposal and contact us with any questions or changes. We're here to ensure your coverage continues without interruption.\n\nBest regards,\n[Agent Name] | AMS Insurance",
            "Claim Acknowledgement"             => "Dear [Client Name],\n\nWe have received your claim and assigned it to our claims team. Your claim number is [Claim #]. A handler will be in touch within 1 business day.\n\nBest regards,\n[Agent Name] | AMS Insurance",
            "Certificate Request Confirmation"  => "Dear [Client Name],\n\nYour Certificate of Insurance request has been received. We will process and deliver your COI within [X] business hours.\n\nPlease reply if you need to add additional insured information.\n\nBest regards,\n[Agent Name] | AMS Insurance",
            "Payment Due Reminder"              => "Dear [Client Name],\n\nThis is a friendly reminder that your premium payment is due on [Due Date]. To avoid any lapse in coverage, please ensure payment is submitted by that date.\n\nBest regards,\n[Agent Name] | AMS Insurance",
            "CAT Event Check-In"                => "Dear [Client Name],\n\nWe wanted to reach out following the recent weather event in your area. If your property has sustained any damage, please don't hesitate to contact us immediately to file a claim. Our CAT team is standing by.\n\nBest regards,\n[Agent Name] | AMS Insurance",
            _                                   => _reply.Body
        };
    }

    void Refresh() => BuildStub();
    void ResetFilters() { _search=""; _channelFilter=""; _statusFilter=""; _priorityFilter=""; }

    // ── Helpers ───────────────────────────────────────────────────
    static string ChannelIcon(string ch) => ch switch
    {
        "Email"          => "bi-envelope",
        "SMS"            => "bi-phone",
        "Internal Note"  => "bi-sticky",
        "Portal Message" => "bi-globe",
        _                => "bi-chat-dots"
    };

    static string ChannelCss(string ch) => ch switch
    {
        "Email"          => "email",
        "SMS"            => "sms",
        "Internal Note"  => "note",
        "Portal Message" => "portal",
        _                => "gen"
    };

    static string StatusCss(string s) => s.ToLower().Replace(" ","-");

    static string FormatTime(DateTime dt)
    {
        var diff = DateTime.Now - dt;
        if (diff.TotalMinutes < 60)  return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours   < 24)  return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 7)   return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("MM/dd/yyyy");
    }

    // ── Sentiment / aging / opt-out helpers ─────────────────────
    static string SentimentIcon(string s) => s switch
    {
        "Positive" => "👍",
        "Negative" => "👎",
        "Urgent"   => "⚠️",
        _          => "🟡"
    };
    static string SentimentCss(string s)  => s.ToLower();

    static int GetUnansweredHours(ConversationThread t)
    {
        var lastIn = t.Thread.Where(m => m.Direction == "Inbound").MaxBy(m => m.SentAt);
        if (lastIn is null) return 0;
        var hasOutboundAfter = t.Thread.Any(m => m.Direction == "Outbound" && m.SentAt > lastIn.SentAt);
        return hasOutboundAfter ? 0 : (int)(DateTime.Now - lastIn.SentAt).TotalHours;
    }

    // ── Render helpers ──────────────────────────────────
    RenderFragment NavItem(string view, string icon, string label, int badge) => __builder =>
    {
        <button class="ci-nav-item @(_view == view ? "ci-nav-active" : "")" @onclick="() => { _view = view; _selected = null; }">
            <i class="bi @icon" aria-hidden="true"></i>
            <span>@label</span>
            @if (badge > 0)
            {
                <span class="ci-nav-badge">@badge</span>
            }
        </button>
    };

    RenderFragment CiKpi(string icon, string label, string val, string color) => __builder =>
    {
        <div class="ci-kpi-card @color">
            <i class="bi @icon ci-kpi-icon" aria-hidden="true"></i>
            <div><div class="ci-kpi-val">@val</div><div class="ci-kpi-lbl">@label</div></div>
        </div>
    };
}
