@page "/communications/inbox"
@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Communications Inbox — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true">
    <ToastPosition X="Right" Y="Bottom" />
</SfToast>

<!-- ── COMPOSE DIALOG ────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showComposeDlg" Width="620px" ShowCloseIcon="true" IsModal="true">
    <DialogTemplates>
        <Header>
            <div class="pd-dlg-hdr">
                <i class="bi @ChannelIcon(_compose.Channel)" aria-hidden="true"></i>
                New @_compose.Channel
            </div>
        </Header>
        <Content>
            <div class="pd-dlg-body">
                <div class="ci-compose-channel-row">
                    @foreach (var ch in _channels)
                    {
                        <button class="ci-ch-pill @(_compose.Channel == ch ? "ci-ch-active" : "")"
                                @onclick="() => _compose.Channel = ch">
                            <i class="bi @ChannelIcon(ch)" aria-hidden="true"></i> @ch
                        </button>
                    }
                </div>
                <div class="pd-dlg-grid" style="margin-top:.65rem;">
                    <div><label class="cd-dlg-lbl">Account / Contact *</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@_accountNames" @bind-Value="_compose.Account" Placeholder="Select account" />
                    </div>
                    <div><label class="cd-dlg-lbl">To (Name or Address) *</label>
                        <SfTextBox @bind-Value="_compose.ToAddress" Placeholder="@(_compose.Channel=="SMS" ? "Phone number" : _compose.Channel=="Email" ? "email@domain.com" : "Recipient name")" />
                    </div>
                    @if (_compose.Channel == "Email")
                    {
                        <div style="grid-column:1/-1"><label class="cd-dlg-lbl">Subject *</label>
                            <SfTextBox @bind-Value="_compose.Subject" Placeholder="Email subject…" />
                        </div>
                    }
                    <div><label class="cd-dlg-lbl">Template</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@_templates" @bind-Value="_compose.Template" Placeholder="Select template (optional)" />
                    </div>
                    <div><label class="cd-dlg-lbl">Priority</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@(new[]{"Normal","High","Urgent"})" @bind-Value="_compose.Priority" Placeholder="Normal" />
                    </div>
                    <div style="grid-column:1/-1"><label class="cd-dlg-lbl">Message *</label>
                        <SfTextBox @bind-Value="_compose.Body" Multiline="true"
                                   Placeholder="@(_compose.Channel=="SMS" ? "Text message (160 chars recommended)…" : "Message body…")"
                                   HtmlAttributes='@(new() {{"rows","6"}})' />
                    </div>
                    @if (_compose.Channel is "Email" or "Portal Message")
                    {
                        <div class="ci-attach-row">
                            <button class="um-btn um-btn-ghost um-btn-xs">
                                <i class="bi bi-paperclip" aria-hidden="true"></i> Attach File
                            </button>
                            @foreach (var a in _compose.Attachments)
                            {
                                <span class="ci-attach-chip">@a <button @onclick="() => _compose.Attachments.Remove(a)">×</button></span>
                            }
                        </div>
                    }
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="pd-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showComposeDlg = false">Discard</button>
                <button class="um-btn um-btn-ghost" @onclick="SaveDraft">
                    <i class="bi bi-floppy" aria-hidden="true"></i> Save Draft
                </button>
                <button class="um-btn um-btn-primary" @onclick="SendMessage">
                    <i class="bi bi-send" aria-hidden="true"></i> Send
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ── ASSIGN DIALOG ─────────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showAssignDlg" Width="380px" ShowCloseIcon="true" IsModal="true">
    <DialogTemplates>
        <Header><div class="pd-dlg-hdr"><i class="bi bi-person-check" aria-hidden="true"></i> Assign Conversation</div></Header>
        <Content>
            <div class="pd-dlg-body">
                <div class="pd-dlg-grid-1">
                    <div><label class="cd-dlg-lbl">Assign To *</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@_agents" @bind-Value="_assignTo" Placeholder="Select agent" />
                    </div>
                    <div><label class="cd-dlg-lbl">Note</label>
                        <SfTextBox @bind-Value="_assignNote" Placeholder="Optional handoff note…" Multiline="true" />
                    </div>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="pd-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showAssignDlg = false">Cancel</button>
                <button class="um-btn um-btn-primary" @onclick="ConfirmAssign">
                    <i class="bi bi-check-lg" aria-hidden="true"></i> Assign
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<!-- ── ESCALATE DIALOG ───────────────────────────────────────────── -->
<SfDialog @bind-Visible="_showEscalateDlg" Width="400px" ShowCloseIcon="true" IsModal="true">
    <DialogTemplates>
        <Header><div class="pd-dlg-hdr"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i> Escalate Conversation</div></Header>
        <Content>
            <div class="pd-dlg-body">
                <div class="pd-dlg-grid-1">
                    <div><label class="cd-dlg-lbl">Escalate To *</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="@_supervisors" @bind-Value="_escalateTo" Placeholder="Select supervisor" />
                    </div>
                    <div><label class="cd-dlg-lbl">Reason *</label>
                        <SfDropDownList TValue="string" TItem="string"
                                        DataSource="@(new[]{"Complaint","Coverage Dispute","Legal Threat","Regulatory Issue","VIP Client","Complex Situation","Other"})"
                                        @bind-Value="_escalateReason" Placeholder="Select reason" />
                    </div>
                    <div><label class="cd-dlg-lbl">Notes</label>
                        <SfTextBox @bind-Value="_escalateNote" Placeholder="Escalation context…" Multiline="true" />
                    </div>
                </div>
            </div>
        </Content>
        <FooterTemplate>
            <div class="pd-dlg-footer">
                <button class="um-btn um-btn-ghost" @onclick="() => _showEscalateDlg = false">Cancel</button>
                <button class="um-btn um-btn-danger" @onclick="ConfirmEscalate">
                    <i class="bi bi-arrow-up-circle" aria-hidden="true"></i> Escalate
                </button>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>

<AppPageHeader Title="Communications Inbox"
               Subtitle="Unified 2-way inbox — email, SMS, internal notes and portal messages"
               Icon="bi-inbox">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="Refresh">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/communications/templates")'>
            <i class="bi bi-layout-text-sidebar" aria-hidden="true"></i> Templates
        </button>
        <button class="um-btn um-btn-primary" @onclick="OpenCompose">
            <i class="bi bi-pencil-square" aria-hidden="true"></i> Compose
        </button>
    </Actions>
</AppPageHeader>

<!-- ── KPI STRIP ─────────────────────────────────────────────────── -->
<div class="ci-kpi-strip">
    @CiKpi("bi-inbox",              "Total Unread",      _messages.Count(m => !m.IsRead).ToString(),                                              "ci-ki-blue")
    @CiKpi("bi-envelope",           "Email",             _messages.Count(m => m.Channel=="Email"   && !m.IsRead).ToString(),                      "ci-ki-blue")
    @CiKpi("bi-phone",              "SMS",               _messages.Count(m => m.Channel=="SMS"     && !m.IsRead).ToString(),                      "ci-ki-green")
    @CiKpi("bi-sticky",             "Internal Notes",    _messages.Count(m => m.Channel=="Internal Note" && !m.IsRead).ToString(),                "ci-ki-amber")
    @CiKpi("bi-globe",              "Portal",            _messages.Count(m => m.Channel=="Portal Message" && !m.IsRead).ToString(),               "ci-ki-purple")
    @CiKpi("bi-person-x",           "Unassigned",        _messages.Count(m => string.IsNullOrEmpty(m.AssignedTo)).ToString(),                     "ci-ki-red")
    @CiKpi("bi-arrow-up-circle",    "Escalated",         _messages.Count(m => m.IsEscalated).ToString(),                                          "ci-ki-red")
    @CiKpi("bi-clock-history",      "Avg Response Time", "2.4 hrs",                                                                               "ci-ki-gray")
</div>

<!-- ── 3-PANE INBOX LAYOUT ───────────────────────────────────────── -->
<div class="ci-layout">

    <!-- ────────────────── LEFT NAV SIDEBAR ──────────────────────── -->
    <aside class="ci-nav">

        <div class="ci-nav-section">
            <div class="ci-nav-section-lbl">Views</div>
            @NavItem("inbox",        "bi-inbox",           "All Inbox",    _messages.Count(m => !m.IsRead))
            @NavItem("unassigned",   "bi-person-x",        "Unassigned",   _messages.Count(m => string.IsNullOrEmpty(m.AssignedTo) && !m.IsRead))
            @NavItem("escalated",    "bi-arrow-up-circle", "Escalated",    _messages.Count(m => m.IsEscalated))
            @NavItem("mine",         "bi-person-check",    "Assigned to Me",_messages.Count(m => m.AssignedTo == _currentUser && !m.IsRead))
            @NavItem("drafts",       "bi-floppy",          "Drafts",       _messages.Count(m => m.Status == "Draft"))
            @NavItem("sent",         "bi-send",            "Sent",         0)
        </div>

        <div class="ci-nav-section">
            <div class="ci-nav-section-lbl">Group By</div>
            @NavItem("by-account",   "bi-building",        "By Account",   0)
            @NavItem("by-producer",  "bi-person-badge",    "By Producer",  0)
            @NavItem("by-branch",    "bi-diagram-2",       "By Branch",    0)
        </div>

        <div class="ci-nav-section">
            <div class="ci-nav-section-lbl">Channels</div>
            @NavItem("ch-email",     "bi-envelope",        "Email",         _messages.Count(m => m.Channel=="Email"          && !m.IsRead))
            @NavItem("ch-sms",       "bi-phone",           "SMS",           _messages.Count(m => m.Channel=="SMS"            && !m.IsRead))
            @NavItem("ch-internal",  "bi-sticky",          "Internal Notes",_messages.Count(m => m.Channel=="Internal Note"  && !m.IsRead))
            @NavItem("ch-portal",    "bi-globe",           "Portal",        _messages.Count(m => m.Channel=="Portal Message" && !m.IsRead))
        </div>

    </aside>

    <!-- ────────────────── MIDDLE MESSAGE LIST ───────────────────── -->
    <div class="ci-list-pane">

        <!-- Filter bar -->
        <div class="ci-list-toolbar">
            <input class="e-input ci-search" @bind="_search" @bind:event="oninput"
                   placeholder="Search messages, accounts, subjects…" />
            <select class="e-input ci-sel" @bind="_channelFilter">
                <option value="">All Channels</option>
                @foreach (var ch in _channels) { <option>@ch</option> }
            </select>
            <select class="e-input ci-sel" @bind="_statusFilter">
                <option value="">All Status</option>
                <option>Open</option><option>Pending</option><option>Resolved</option><option>Draft</option>
            </select>
            <select class="e-input ci-sel" @bind="_priorityFilter">
                <option value="">All Priority</option>
                <option>Urgent</option><option>High</option><option>Normal</option>
            </select>
            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResetFilters">
                <i class="bi bi-x" aria-hidden="true"></i>
            </button>
        </div>

        <!-- Sub-header with count + sort -->
        <div class="ci-list-header">
            <span class="ci-list-count">@ListLabel — <strong>@FilteredList.Count()</strong> conversation(s)</span>
            <div class="ci-sort-row">
                <button class="ci-sort-btn @(_sortNewest ? "ci-sort-active" : "")" @onclick='() => _sortNewest = true'>Newest</button>
                <button class="ci-sort-btn @(!_sortNewest ? "ci-sort-active" : "")" @onclick='() => _sortNewest = false'>Oldest</button>
            </div>
        </div>

        <!-- Message rows -->
        <div class="ci-message-list">
            @if (!FilteredList.Any())
            {
                <div class="ci-empty">
                    <i class="bi bi-inbox ci-empty-icon" aria-hidden="true"></i>
                    <span>No conversations match the current filters.</span>
                </div>
            }

            @foreach (var msg in (_sortNewest
                ? FilteredList.OrderByDescending(m => m.LastActivityAt)
                : FilteredList.OrderBy(m => m.LastActivityAt)))
            {
                <div class="ci-msg-row @(!msg.IsRead ? "ci-msg-unread" : "") @(_selected?.Id == msg.Id ? "ci-msg-selected" : "") @(msg.IsEscalated ? "ci-msg-escalated" : "")"
                     @onclick="() => SelectMessage(msg)">

                    <!-- Channel + unread dot -->
                    <div class="ci-msg-channel-col">
                        <span class="ci-ch-icon ci-ch-@ChannelCss(msg.Channel)" title="@msg.Channel">
                            <i class="bi @ChannelIcon(msg.Channel)" aria-hidden="true"></i>
                        </span>
                        @if (!msg.IsRead)
                        {
                            <span class="ci-unread-dot" aria-label="Unread"></span>
                        }
                    </div>

                    <!-- Message body preview -->
                    <div class="ci-msg-body-col">
                        <div class="ci-msg-top-row">
                            <span class="ci-msg-account @(!msg.IsRead ? "ci-msg-account-bold" : "")">@msg.AccountName</span>
                            <span class="ci-msg-time">@FormatTime(msg.LastActivityAt)</span>
                        </div>
                        <div class="ci-msg-subject @(!msg.IsRead ? "ci-msg-subject-bold" : "")">@msg.Subject</div>
                        <div class="ci-msg-preview">@msg.BodyPreview</div>
                        <div class="ci-msg-meta-row">
                            @if (!string.IsNullOrEmpty(msg.AssignedTo))
                            {
                                <span class="ci-meta-chip ci-mc-agent"><i class="bi bi-person" aria-hidden="true"></i>@msg.AssignedTo</span>
                            }
                            else
                            {
                                <span class="ci-meta-chip ci-mc-unassigned"><i class="bi bi-person-x" aria-hidden="true"></i>Unassigned</span>
                            }
                            @if (!string.IsNullOrEmpty(msg.Producer))
                            {
                                <span class="ci-meta-chip"><i class="bi bi-person-badge" aria-hidden="true"></i>@msg.Producer</span>
                            }
                            @if (!string.IsNullOrEmpty(msg.Branch))
                            {
                                <span class="ci-meta-chip"><i class="bi bi-diagram-2" aria-hidden="true"></i>@msg.Branch</span>
                            }
                            @if (msg.IsEscalated)
                            {
                                <span class="ci-meta-chip ci-mc-esc"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i>Escalated</span>
                            }
                            @if (msg.OptedOut)
                            {
                                <span class="ci-optout-chip"><i class="bi bi-slash-circle" aria-hidden="true"></i>Opt-Out</span>
                            }
                            <span class="ci-msg-count-chip">@msg.MessageCount msg</span>
                        </div>
                        <div class="ci-msg-intel-row">
                            <span class="ci-sentiment ci-sent-@SentimentCss(msg.Sentiment)" title="Sentiment: @msg.Sentiment">
                                @SentimentIcon(msg.Sentiment) @msg.Sentiment
                            </span>
                            @{ var ageH = GetUnansweredHours(msg); }
                            @if (ageH >= 4)
                            {
                                <span class="ci-aging-badge @(ageH >= 24 ? "ci-aging-hot" : ageH >= 8 ? "ci-aging-warm" : "ci-aging-cool")">
                                    <i class="bi bi-hourglass-split" aria-hidden="true"></i>@ageH&#8203;h unanswered
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(msg.CsrOwner))
                            {
                                <span class="ci-csr-chip"><i class="bi bi-headset" aria-hidden="true"></i>@msg.CsrOwner</span>
                            }
                        </div>
                    </div>

                    <!-- Status + priority -->
                    <div class="ci-msg-status-col">
                        <span class="ci-status-badge ci-st-@StatusCss(msg.Status)">@msg.Status</span>
                        @if (msg.Priority != "Normal")
                        {
                            <span class="ci-pri-badge ci-pri-@msg.Priority.ToLower()">@msg.Priority</span>
                        }
                    </div>

                </div>
            }
        </div>
    </div>

    <!-- ────────────────── RIGHT DETAIL / THREAD PANE ────────────── -->
    <div class="ci-detail-pane @(_selected is null ? "ci-detail-empty" : "")">

        @if (_selected is null)
        {
            <div class="ci-detail-placeholder">
                <i class="bi bi-chat-left-text ci-dp-icon" aria-hidden="true"></i>
                <h3>Select a conversation</h3>
                <p>Choose a message on the left to view the full thread and reply.</p>
                <button class="um-btn um-btn-primary" @onclick="OpenCompose">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i> Compose New Message
                </button>
            </div>
        }
        else
        {
            <!-- Detail header -->
            <div class="ci-detail-header">
                <div class="ci-dh-left">
                    <span class="ci-ch-icon ci-ch-lg ci-ch-@ChannelCss(_selected.Channel)">
                        <i class="bi @ChannelIcon(_selected.Channel)" aria-hidden="true"></i>
                    </span>
                    <div>
                        <div class="ci-dh-subject">@_selected.Subject</div>
                        <div class="ci-dh-meta">
                            <span>@_selected.AccountName</span>
                            <span class="ci-dh-dot">·</span>
                            <span>@_selected.Channel</span>
                            @if (!string.IsNullOrEmpty(_selected.Producer))
                            {
                                <span class="ci-dh-dot">·</span>
                                <span>@_selected.Producer</span>
                            }
                            @if (!string.IsNullOrEmpty(_selected.Branch))
                            {
                                <span class="ci-dh-dot">·</span>
                                <span>@_selected.Branch</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="ci-dh-actions">
                    <button class="um-btn um-btn-ghost um-btn-xs"
                            @onclick='() => Nav.NavigateTo($"/communications/thread/{_selected.Id}")'
                            title="Open full thread">
                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                    </button>
                    @if (!_selected.IsRead)
                    {
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="MarkRead" title="Mark as read">
                            <i class="bi bi-check2-all" aria-hidden="true"></i>
                        </button>
                    }
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _showAssignDlg = true" title="Assign">
                        <i class="bi bi-person-check" aria-hidden="true"></i>
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _showEscalateDlg = true" title="Escalate">
                        <i class="bi bi-arrow-up-circle" aria-hidden="true"></i>
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="ResolveConversation" title="Resolve">
                        <i class="bi bi-check-circle" aria-hidden="true"></i>
                    </button>
                    <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => _selected = null" title="Close">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            <!-- Conversation info pills -->
            <div class="ci-dh-pills">
                <span class="ci-status-badge ci-st-@StatusCss(_selected.Status)">@_selected.Status</span>
                @if (_selected.Priority != "Normal")
                {
                    <span class="ci-pri-badge ci-pri-@_selected.Priority.ToLower()">@_selected.Priority</span>
                }
                @if (_selected.IsEscalated)
                {
                    <span class="ci-meta-chip ci-mc-esc"><i class="bi bi-arrow-up-circle" aria-hidden="true"></i>Escalated</span>
                }
                @if (!string.IsNullOrEmpty(_selected.AssignedTo))
                {
                    <span class="ci-meta-chip ci-mc-agent"><i class="bi bi-person" aria-hidden="true"></i>@_selected.AssignedTo</span>
                }
                else
                {
                    <span class="ci-meta-chip ci-mc-unassigned"><i class="bi bi-person-x" aria-hidden="true"></i>Unassigned</span>
                }
                @if (!string.IsNullOrEmpty(_selected.CsrOwner))
                {
                    <span class="ci-meta-chip ci-mc-csr"><i class="bi bi-headset" aria-hidden="true"></i>CSR: @_selected.CsrOwner</span>
                }
                <span class="ci-sentiment ci-sent-@SentimentCss(_selected.Sentiment) ci-sent-pill">
                    @SentimentIcon(_selected.Sentiment) @_selected.Sentiment
                </span>
                @{ var detailAge = GetUnansweredHours(_selected); }
                @if (detailAge >= 4)
                {
                    <span class="ci-aging-badge @(detailAge >= 24 ? "ci-aging-hot" : detailAge >= 8 ? "ci-aging-warm" : "ci-aging-cool")">
                        <i class="bi bi-hourglass-split" aria-hidden="true"></i>@detailAge&#8203;h unanswered
                    </span>
                }
                <span class="ci-meta-chip"><i class="bi bi-clock" aria-hidden="true"></i>@_selected.LastActivityAt.ToString("MM/dd/yyyy h:mm tt")</span>
            </div>

            @if (_selected.OptedOut)
            {
                <div class="ci-optout-warning">
                    <i class="bi bi-slash-circle" aria-hidden="true"></i>
                    <strong>Opt-Out / Do Not Contact</strong> — This contact has opted out of direct @_selected.Channel communication.
                    Route all outreach through the designated representative or via legal counsel.
                </div>
            }

            @if (!string.IsNullOrEmpty(_selected.AiSummary))
            {
                <div class="ci-ai-summary">
                    <div class="ci-ai-summary-hdr">
                        <i class="bi bi-stars" aria-hidden="true"></i> AI Thread Summary
                        <span class="ci-ai-badge">Auto-generated</span>
                    </div>
                    <div class="ci-ai-summary-body">@_selected.AiSummary</div>
                </div>
            }

            <!-- Message thread -->
            <div class="ci-thread">
                @foreach (var msg in _selected.Thread.OrderBy(t => t.SentAt))
                {
                    var isOutbound = msg.Direction == "Outbound";
                    <div class="ci-bubble-wrap @(isOutbound ? "ci-bubble-out" : "ci-bubble-in")">
                        <div class="ci-bubble @(isOutbound ? "ci-bubble-outbound" : "ci-bubble-inbound") ci-bbl-@ChannelCss(msg.Channel)">
                            <div class="ci-bubble-header">
                                <span class="ci-bubble-sender">@msg.SenderName</span>
                                <span class="ci-bubble-ch"><i class="bi @ChannelIcon(msg.Channel)" aria-hidden="true"></i>@msg.Channel</span>
                                <span class="ci-bubble-time">@FormatTime(msg.SentAt)</span>
                                @if (msg.IsAutomated)
                                {
                                    <span class="ci-auto-badge"><i class="bi bi-robot" aria-hidden="true"></i>Auto</span>
                                }
                            </div>
                            <div class="ci-bubble-body">@msg.Body</div>
                            @if (msg.Attachments.Any())
                            {
                                <div class="ci-bubble-attachments">
                                    @foreach (var a in msg.Attachments)
                                    {
                                        <span class="ci-attach-chip-sm"><i class="bi bi-paperclip" aria-hidden="true"></i>@a</span>
                                    }
                                </div>
                            }
                            @if (msg.DeliveryStatus != "Delivered")
                            {
                                <div class="ci-bubble-status ci-ds-@msg.DeliveryStatus.ToLower()">
                                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @msg.DeliveryStatus
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Reply box -->
            <div class="ci-reply-box">
                <div class="ci-reply-toolbar">
                    <div class="ci-reply-ch-row">
                        @foreach (var ch in _channels)
                        {
                            <button class="ci-ch-pill ci-ch-pill-sm @(_reply.Channel == ch ? "ci-ch-active" : "")"
                                    @onclick="() => _reply.Channel = ch">
                                <i class="bi @ChannelIcon(ch)" aria-hidden="true"></i>
                                @if (ch != "Internal Note") { @ch } else { <span>Note</span> }
                            </button>
                        }
                    </div>
                    <div class="ci-reply-tools">
                        <select class="e-input ci-tpl-sel" @bind="_reply.Template" @bind:after="ApplyTemplate">
                            <option value="">Use template…</option>
                            @foreach (var t in _templates) { <option>@t</option> }
                        </select>
                        <button class="um-btn um-btn-ghost um-btn-xs" title="Attach">
                            <i class="bi bi-paperclip" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                @if (_reply.Channel == "Email")
                {
                    <input class="e-input ci-reply-subject" @bind="_reply.Subject" placeholder="Subject…" />
                }

                <SfTextBox @bind-Value="_reply.Body"
                           Multiline="true"
                           Placeholder="@(_reply.Channel=="SMS" ? "Type a text message…" : _reply.Channel=="Internal Note" ? "Write an internal note (not visible to client)…" : _reply.Channel=="Portal Message" ? "Write a portal message…" : "Write your reply…")"
                           HtmlAttributes='@(new() {{"rows","4"}, {"class","ci-reply-textarea"}})' />

                <div class="ci-reply-footer">
                    <div class="ci-reply-footer-left">
                        @if (_reply.Channel == "SMS")
                        {
                            <span class="ci-char-count @(_reply.Body.Length > 160 ? "ci-char-warn" : "")">
                                @_reply.Body.Length / 160 chars
                            </span>
                        }
                        @if (_reply.Channel == "Internal Note")
                        {
                            <span class="ci-internal-note-hint">
                                <i class="bi bi-eye-slash" aria-hidden="true"></i>
                                Internal only — not sent to client
                            </span>
                        }
                    </div>
                    <div class="ci-reply-footer-right">
                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="DiscardReply">Discard</button>
                        <button class="um-btn um-btn-primary um-btn-sm" @onclick="SendReply"
                                disabled="@(string.IsNullOrWhiteSpace(_reply.Body))">
                            <i class="bi @(_reply.Channel=="Internal Note" ? "bi-sticky" : "bi-send")" aria-hidden="true"></i>
                            @(_reply.Channel=="Internal Note" ? "Add Note" : "Send Reply")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

</div>

