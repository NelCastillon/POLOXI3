    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _currentUserId = context.UserId;
        _scheduleEditContext = new(_scheduleForm);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var records = await Api.SearchDashboardRecordsAsync(_tenantId, "MarketingAnalytics", _search);
            var analytics = await Api.SearchMarketingAnalyticsAsync(_tenantId, null, _search);
            var emailBlasts = await Api.SearchMarketingEmailBlastsAsync(_tenantId, _search);
            var landingPages = await Api.SearchMarketingLandingPagesAsync(_tenantId, _search);
            var segments = await Api.SearchMarketingSegmentsAsync(_tenantId, _search);
            var crossSell = await Api.SearchMarketingCrossSellAsync(_tenantId);
            var winBack = await Api.SearchMarketingWinBackAsync(_tenantId);
            var referrals = await Api.SearchMarketingReferralsAsync(_tenantId);
            var reviews = await Api.SearchMarketingReviewsAsync(_tenantId);
            var definitions = await Api.SearchReportDefinitionsAsync("Marketing");
            var executions = await Api.SearchReportExecutionsAsync(_tenantId, null);
            var schedules = await Api.SearchReportSchedulesAsync(_tenantId, "Marketing");

            _marketingItems = records?.Items.Select(r => DeserializeMarketingRecord(r.Id, r.JsonData)).Where(r => r is not null).Cast<MarketingAnalyticsRecord>().ToList() ?? [];
            _analytics = analytics ?? new();
            _emailBlasts = emailBlasts?.Items.ToList() ?? [];
            _landingPages = landingPages?.Items.ToList() ?? [];
            _segments = segments?.Items.ToList() ?? [];
            _crossSell = crossSell?.Items.ToList() ?? [];
            _winBack = winBack?.Items.ToList() ?? [];
            _referrals = referrals?.Items.ToList() ?? [];
            _reviews = reviews ?? new();
            _marketingReports = definitions?.Items.Where(r => r.ModuleCode == "Marketing").ToList() ?? [];
            _executions = executions?.Items.Where(e => _marketingReports.Any(r => r.ReportDefinitionId == e.ReportDefinitionId)).ToList() ?? [];
            _schedules = schedules?.Items.Where(s => _marketingReports.Any(r => r.ReportDefinitionId == s.ReportDefinitionId)).ToList() ?? [];
            _selectedItem = _selectedItem is null ? FilteredItems.FirstOrDefault() : _marketingItems.FirstOrDefault(i => i.Title == _selectedItem.Title) ?? FilteredItems.FirstOrDefault();
            _selectedEmailBlast = _selectedEmailBlast is null ? EmailBlastsByImportance.FirstOrDefault() : _emailBlasts.FirstOrDefault(e => e.EmailBlastId == _selectedEmailBlast.EmailBlastId) ?? EmailBlastsByImportance.FirstOrDefault();
            _selectedLandingPage = _selectedLandingPage is null ? LandingPagesByImportance.FirstOrDefault() : _landingPages.FirstOrDefault(p => p.LandingPageId == _selectedLandingPage.LandingPageId) ?? LandingPagesByImportance.FirstOrDefault();
            _selectedCrossSell = _selectedCrossSell is null ? CrossSellByImportance.FirstOrDefault() : _crossSell.FirstOrDefault(c => c.OpportunityId == _selectedCrossSell.OpportunityId) ?? CrossSellByImportance.FirstOrDefault();
            _selectedReview = _selectedReview is null ? ReviewsByImportance.FirstOrDefault() : _reviews.Reviews.FirstOrDefault(r => r.ReviewId == _selectedReview.ReviewId) ?? ReviewsByImportance.FirstOrDefault();
            _selectedReport = _selectedReport is null ? MarketingReportsByImportance.FirstOrDefault() : _marketingReports.FirstOrDefault(r => r.ReportDefinitionId == _selectedReport.ReportDefinitionId) ?? MarketingReportsByImportance.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load marketing analytics: {ex.Message}";
            _marketingItems = [];
            _analytics = new();
            _emailBlasts = [];
            _landingPages = [];
            _segments = [];
            _crossSell = [];
            _winBack = [];
            _referrals = [];
            _reviews = new();
            _marketingReports = [];
            _executions = [];
            _schedules = [];
            ShowToast(_loadError, true);
        }
        finally
        {
            _loading = false;
        }
    }

