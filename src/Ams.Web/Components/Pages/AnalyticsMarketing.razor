@page "/analytics/marketing"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>Marketing Attribution — AMS</PageTitle>

<AppPageHeader Title="Marketing Attribution"
               Subtitle="Campaign ROI, lead source performance, cross-sell conversion, and referral pipeline"
               Icon="bi-megaphone-fill">
    <Actions>
        <button class="um-btn um-btn-ghost"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
    </Actions>
</AppPageHeader>

<div class="ma-kpi-strip">
    <div class="ma-kpi-card"><div class="ma-kpi-icon ma-ki-amber"><i class="bi bi-megaphone" aria-hidden="true"></i></div><div><div class="ma-kv">24</div><div class="ma-kl">Active Campaigns</div></div></div>
    <div class="ma-kpi-card"><div class="ma-kpi-icon ma-ki-green"><i class="bi bi-currency-dollar" aria-hidden="true"></i></div><div><div class="ma-kv">$4.8:1</div><div class="ma-kl">Avg Campaign ROI</div></div></div>
    <div class="ma-kpi-card"><div class="ma-kpi-icon ma-ki-blue"><i class="bi bi-person-plus" aria-hidden="true"></i></div><div><div class="ma-kv">312</div><div class="ma-kl">Leads Generated (MTD)</div></div></div>
    <div class="ma-kpi-card"><div class="ma-kpi-icon ma-ki-purple"><i class="bi bi-arrows-expand" aria-hidden="true"></i></div><div><div class="ma-kv">48</div><div class="ma-kl">Cross-Sell Conversions</div></div></div>
    <div class="ma-kpi-card"><div class="ma-kpi-icon ma-ki-green"><i class="bi bi-people" aria-hidden="true"></i></div><div><div class="ma-kv">71</div><div class="ma-kl">Referrals (MTD)</div></div></div>
</div>

<div class="ma-two-col">

    <!-- Campaign performance table -->
    <div class="ma-panel ma-panel--wide">
        <div class="ma-panel-hdr">Campaign Performance</div>
        <SfGrid TValue="CampaignRow" DataSource="_campaigns" AllowSorting="true" EnableHover="true" RowHeight="52">
            <GridColumns>
                <GridColumn Field="@nameof(CampaignRow.Name)"      HeaderText="Campaign" MinWidth="180" />
                <GridColumn Field="@nameof(CampaignRow.Channel)"   HeaderText="Channel" Width="120">
                    <Template>@{ var c = (CampaignRow)context; }<span class="@ChannelBadge(c.Channel)">@c.Channel</span></Template>
                </GridColumn>
                <GridColumn Field="@nameof(CampaignRow.Spend)"     HeaderText="Spend" Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                <GridColumn Field="@nameof(CampaignRow.Leads)"     HeaderText="Leads" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                <GridColumn Field="@nameof(CampaignRow.Converted)" HeaderText="Converted" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                <GridColumn Field="@nameof(CampaignRow.Revenue)"   HeaderText="Revenue" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
                <GridColumn Field="@nameof(CampaignRow.Roi)"       HeaderText="ROI" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                    <Template>@{ var c = (CampaignRow)context; }<span class="@(c.RoiVal>=4?"ma-roi-great":c.RoiVal>=2?"ma-roi-ok":"ma-roi-low")">@c.Roi</span></Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    </div>

    <!-- Lead source mix -->
    <div class="ma-panel">
        <div class="ma-panel-hdr">Lead Sources</div>
        <div class="ma-source-list">
            @foreach (var s in _sources)
            {
                <div class="ma-source-row">
                    <div class="ma-source-dot" style="background:@s.Color"></div>
                    <div class="ma-source-name">@s.Source</div>
                    <div class="ma-source-bar-wrap"><div class="ma-source-bar" style="width:@s.Pct%; background:@s.Color"></div></div>
                    <div class="ma-source-pct">@s.Pct%</div>
                </div>
            }
        </div>
    </div>

    <!-- Cross-sell & referral pipeline -->
    <div class="ma-panel">
        <div class="ma-panel-hdr">Cross-Sell &amp; Referral Pipeline</div>
        <div class="ma-pipeline">
            @foreach (var p in _pipeline)
            {
                <div class="ma-pl-row">
                    <div class="ma-pl-lbl">@p.Type</div>
                    <div class="ma-pl-bar-wrap"><div class="ma-pl-bar" style="width:@p.Pct%; background:@p.Color"></div></div>
                    <div class="ma-pl-val">@p.Count</div>
                    <div class="ma-pl-rev">@p.Revenue</div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private sealed class CampaignRow { public string Name{get;set;}=string.Empty; public string Channel{get;set;}=string.Empty; public string Spend{get;set;}=string.Empty; public int Leads{get;set;} public int Converted{get;set;} public string Revenue{get;set;}=string.Empty; public string Roi{get;set;}=string.Empty; public decimal RoiVal{get;set;} }
    private record SourceRow(string Source, int Pct, string Color);
    private record PipelineRow(string Type, int Count, string Revenue, int Pct, string Color);

    private List<CampaignRow> _campaigns = [];
    private List<SourceRow>   _sources   = [];
    private List<PipelineRow> _pipeline  = [];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Analytics","/analytics/reports"), new("Marketing Attribution",""));
        _campaigns =
        [
            new CampaignRow { Name="Q2 Commercial Renewal Blast", Channel="Email",     Spend="$1,200", Leads=84,  Converted=31, Revenue="$62,400", Roi="52:1",  RoiVal=52  },
            new CampaignRow { Name="Spring BOP Promotion",        Channel="Email",     Spend="$900",   Leads=61,  Converted=18, Revenue="$38,100", Roi="42:1",  RoiVal=42  },
            new CampaignRow { Name="LinkedIn Agent Awareness",    Channel="Social",    Spend="$3,800", Leads=48,  Converted=9,  Revenue="$22,000", Roi="5.8:1", RoiVal=5.8m },
            new CampaignRow { Name="Workers Comp Webinar",        Channel="Webinar",   Spend="$2,100", Leads=32,  Converted=11, Revenue="$28,600", Roi="13.6:1",RoiVal=13.6m},
            new CampaignRow { Name="Google Ads — Commercial LOB", Channel="Paid Search",Spend="$6,400",Leads=112, Converted=14, Revenue="$31,200", Roi="4.9:1", RoiVal=4.9m },
            new CampaignRow { Name="Referral Partner Program",   Channel="Referral",  Spend="$500",   Leads=71,  Converted=38, Revenue="$84,100", Roi="168:1", RoiVal=168 },
        ];
        _sources  = [new("Referral",28,"#22c55e"), new("Paid Search",22,"#3b82f6"), new("Email",20,"#8b5cf6"), new("Social",14,"#f59e0b"), new("Organic/SEO",10,"#06b6d4"), new("Other",6,"#94a3b8")];
        _pipeline = [new("Cross-Sell Opportunities",124,"$248K",100,"#3b82f6"), new("Cross-Sell Converted",48,"$94K",39,"#22c55e"), new("Win-Back Prospects",67,"$134K",54,"#f59e0b"), new("Win-Back Converted",14,"$28K",11,"#22c55e"), new("Referrals Pending",38,"$76K",31,"#8b5cf6")];
    }

    private static string ChannelBadge(string ch) => ch switch { "Email"=>"ma-ch ma-ch--email","Social"=>"ma-ch ma-ch--social","Webinar"=>"ma-ch ma-ch--web","Paid Search"=>"ma-ch ma-ch--paid","Referral"=>"ma-ch ma-ch--ref",_=>"ma-ch" };
}
