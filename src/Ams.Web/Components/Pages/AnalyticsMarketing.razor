    private static MarketingAnalyticsRecord? DeserializeMarketingRecord(Guid id, string json)
    {
        try
        {
            var item = System.Text.Json.JsonSerializer.Deserialize<MarketingAnalyticsRecord>(json, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
            if (item is not null) item.Id = id;
            return item;
        }
        catch
        {
            return null;
        }
    }

    private bool MatchesSearch(MarketingAnalyticsRecord item)
    {
        if (string.IsNullOrWhiteSpace(_search)) return true;
        return item.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || item.Category.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || item.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || item.Segment.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || item.Channel.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || item.Workflow.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || item.Status.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || item.Insight.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || _analytics.Items.Any(m => m.CampaignName.Contains(_search, StringComparison.OrdinalIgnoreCase) || m.Channel.Contains(_search, StringComparison.OrdinalIgnoreCase))
            || _emailBlasts.Any(e => e.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || e.Subject.Contains(_search, StringComparison.OrdinalIgnoreCase))
            || _landingPages.Any(p => p.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || p.CampaignName.Contains(_search, StringComparison.OrdinalIgnoreCase))
            || _marketingReports.Any(r => r.ReportName.Contains(_search, StringComparison.OrdinalIgnoreCase));
    }

    private bool MatchesActiveView(MarketingAnalyticsRecord item) => _activeTab switch
    {
        "roi" => item.Category == "ROI",
        "leads" => item.Category == "Leads",
        "campaigns" => item.Category is "ROI" or "Leads",
        "growth" => item.Category is "Cross-sell" or "Retention",
        "reputation" => item.Category == "Reputation",
        "reports" => _marketingReports.Any(),
        _ => true
    };

