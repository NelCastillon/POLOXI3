@page "/tenant/support"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>Support — AMS</PageTitle>

<AppPageHeader Title="Support"
               Subtitle="Manage tenant support contacts, open cases, escalation paths, service levels, and help resources"
               Icon="bi-question-circle">
    <Actions>
        <button class="um-btn um-btn-ghost"><i class="bi bi-book" aria-hidden="true"></i> Knowledge Base</button>
    </Actions>
</AppPageHeader>

<section class="tset-hero" aria-label="Tenant support overview">
    <div>
        <span class="tset-eyebrow">Tenant administration</span>
        <h2>Support Readiness</h2>
        <p>Track support cases, service level commitments, escalation contacts, environment health, and tenant assistance resources.</p>
    </div>
</section>

<section class="tset-kpi-grid" aria-label="Support metrics">
    @Kpi("Open Cases", "2", "Active support cases", "bi-life-preserver", "tset-tone-red")
    @Kpi("SLA", "99.9%", "Enterprise target", "bi-stopwatch", "tset-tone-green")
    @Kpi("Contacts", "5", "Tenant admins", "bi-people", "tset-tone-blue")
    @Kpi("Health", "Good", "Environment status", "bi-heart-pulse", "tset-tone-green")
</section>

<section class="tset-layout">
    <TenantSettingsWorkflowManager PageCode="support"
                                   Label="Tenant support workflow"
                                   DefaultStage="Assist"
                                   DefaultCategory="Open Cases" />
    <TenantConfigManager Kind="TenantSupport"
                         Title="Support"
                         Subtitle="Manage tenant support contacts, open cases, escalation paths, service levels, and help resources"
                         Icon="bi bi-question-circle" />
    <aside class="tset-admin-panel">
        <h3>Support escalation</h3>
        <div class="tset-policy-card">
            <strong>Support controls</strong>
            <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Critical case escalation contacts are verified</span>
            <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Tenant admins can access help resources and release notes</span>
            <span><i class="bi bi-check2-circle" aria-hidden="true"></i> Open support cases are tracked against SLA target</span>
        </div>
    </aside>
</section>

@code {
    protected override void OnInitialized() => Breadcrumbs.SetCrumbs(new("Home", "/"), new("Support", "/tenant/support"));

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="tset-kpi-card"><span class="tset-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span><div><strong>@value</strong><span>@label</span><small>@meta</small></div></article>;
}
