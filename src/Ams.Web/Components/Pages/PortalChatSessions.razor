@page "/portal/chat-sessions"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Chat Sessions — AMS</PageTitle>

<SfToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true"><ToastPosition X="Right" Y="Bottom" /></SfToast>

<AppPageHeader Title="Chat Sessions" Subtitle="Portal chat assistant sessions, resolution outcomes, and live handoffs" Icon="bi-chat-dots">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/portal/my-account")'><i class="bi bi-arrow-left" aria-hidden="true"></i> My Account</button>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/portal/white-label")'><i class="bi bi-robot" aria-hidden="true"></i> Chat Settings</button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i> @_loadError</div>
}

<div class="pma-kpi-strip">
    @Kpi("Total Sessions", _items.Sum(x => x.Count).ToString("N0"), "bi-chat-dots", "")
    @Kpi("AI Resolved", _items.Where(x => x.Status == "AI Resolved").Sum(x => x.Count).ToString("N0"), "bi-stars", "AI Resolved")
    @Kpi("Live Handoff", _items.Where(x => x.Status == "Live Handoff").Sum(x => x.Count).ToString("N0"), "bi-headset", "Live Handoff")
    @Kpi("Open", _items.Where(x => x.Status == "Open").Sum(x => x.Count).ToString("N0"), "bi-hourglass", "Open")
</div>

<div class="pma-panel app-datagrid">
    <div class="pma-panel-hdr"><i class="bi bi-chat-dots" aria-hidden="true"></i> Session Detail</div>
    <div class="api-filter-bar"><input class="api-search" placeholder="Search client, topic, or owner…" @bind="_search" @bind:event="oninput" /><select class="api-search" @bind="_filter"><option value="">All</option><option>AI Resolved</option><option>Live Handoff</option><option>Open</option></select></div>
    <SfGrid TValue="PortalMetricRecordDto" DataSource="Filtered" AllowSorting="true" AllowPaging="true" AllowTextWrap="true" RowHeight="56">
        <GridTextWrapSettings WrapMode="WrapMode.Content" />
        <GridPageSettings PageSize="20" />
        <GridColumns>
            <GridColumn Field="@nameof(PortalMetricRecordDto.Name)" HeaderText="Client" MinWidth="200" />
            <GridColumn Field="@nameof(PortalMetricRecordDto.Category)" HeaderText="Topic" MinWidth="160" />
            <GridColumn Field="@nameof(PortalMetricRecordDto.Status)" HeaderText="Outcome" Width="140" />
            <GridColumn Field="@nameof(PortalMetricRecordDto.Owner)" HeaderText="Owner" MinWidth="150" />
            <GridColumn Field="@nameof(PortalMetricRecordDto.Detail)" HeaderText="Summary" MinWidth="260" />
            <GridColumn Field="@nameof(PortalMetricRecordDto.EventDateUtc)" HeaderText="Started" Width="145" Type="ColumnType.DateTime" Format="MMM d, h:mm tt" />
            <GridColumn Field="@nameof(PortalMetricRecordDto.Count)" HeaderText="Messages" Width="110" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right" />
        </GridColumns>
    </SfGrid>
</div>

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private SfToast? _toast;
    private string _search = string.Empty;
    private string _filter = string.Empty;
    private string? _loadError;
    private List<PortalMetricRecordDto> _items = [];
    private IEnumerable<PortalMetricRecordDto> Filtered => _items.Where(i => (string.IsNullOrEmpty(_filter) || i.Status == _filter) && (string.IsNullOrEmpty(_search) || i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) || i.Category.Contains(_search, StringComparison.OrdinalIgnoreCase) || i.Owner.Contains(_search, StringComparison.OrdinalIgnoreCase) || i.Detail.Contains(_search, StringComparison.OrdinalIgnoreCase)));
    protected override async Task OnInitializedAsync() { await ResolveCurrentUserContextAsync(); Breadcrumbs.SetCrumbs(new("Home", "/"), new("Portal", "/portal/users"), new("Chat Sessions", "")); await LoadAsync(); }
    private async Task LoadAsync() { try { _loadError = null; _items = (await Api.SearchPortalMetricRecordsAsync(_tenantId, "PortalChatSession"))?.Items.ToList() ?? []; } catch (Exception ex) { _loadError = $"Unable to load chat sessions: {ex.Message}"; if (_toast is not null) await _toast.ShowAsync(new ToastModel { Content = _loadError, CssClass = "e-toast-danger" }); } }
    private RenderFragment Kpi(string label, string value, string icon, string filter) => @<button type="button" class="pma-kpi-card pma-ki-blue" @onclick="() => _filter = _filter == filter ? string.Empty : filter"><i class="bi @icon pma-kpi-icon"></i><div><div class="pma-kpi-value">@value</div><div class="pma-kpi-label">@label</div><span>@(string.IsNullOrEmpty(filter) ? "all records" : "click to filter")</span></div></button>;

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
