@page "/integrations/automation/history"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs
@inject NavigationManager Nav

<PageTitle>Automation Job History - AMS</PageTitle>

<AppPageHeader Title="Job History &amp; Automation Audit"
               Subtitle="Complete execution history for all automation workflows - runs, retries, failures, and payloads"
               Icon="bi-clock-history">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='()=>Nav.NavigateTo("/integrations/automation")'><i class="bi bi-arrow-left" aria-hidden="true"></i> Workflows</button>
        <button class="um-btn um-btn-ghost"><i class="bi bi-download" aria-hidden="true"></i> Export</button>
    </Actions>
</AppPageHeader>

<!-- KPI strip -->
<div class="jh-kpi-strip">
    <div class="jh-kpi-card"><div class="jh-kpi-icon jh-ki-blue"><i class="bi bi-play-circle" aria-hidden="true"></i></div><div><div class="jh-kv">4,821</div><div class="jh-kl">Total Runs (Today)</div></div></div>
    <div class="jh-kpi-card"><div class="jh-kpi-icon jh-ki-green"><i class="bi bi-check-circle" aria-hidden="true"></i></div><div><div class="jh-kv">4,787</div><div class="jh-kl">Succeeded</div></div></div>
    <div class="jh-kpi-card"><div class="jh-kpi-icon jh-ki-red"><i class="bi bi-x-circle" aria-hidden="true"></i></div><div><div class="jh-kv">34</div><div class="jh-kl">Failed</div></div></div>
    <div class="jh-kpi-card"><div class="jh-kpi-icon jh-ki-amber"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></div><div><div class="jh-kv">8</div><div class="jh-kl">Retrying</div></div></div>
    <div class="jh-kpi-card"><div class="jh-kpi-icon jh-ki-blue"><i class="bi bi-speedometer2" aria-hidden="true"></i></div><div><div class="jh-kv">99.3%</div><div class="jh-kl">Success Rate</div></div></div>
</div>

<!-- Filter bar -->
<div class="jh-filter-bar">
    <div class="jh-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="jh-search" placeholder="Search by workflow, trigger, account..." @bind="_search" @bind:event="oninput" />
    </div>
    <select class="jh-sel" @bind="_wfFilter">
        <option value="">All Workflows</option>
        <option value="Renewal">Renewal 90-Day Reminder</option>
        <option value="Claim">Claim Severity Alert</option>
        <option value="Payment">Payment Failed Outreach</option>
        <option value="Download">Download Exception Triage</option>
        <option value="eSign">eSign Timeout Escalation</option>
    </select>
    <select class="jh-sel" @bind="_statusFilter">
        <option value="">All Statuses</option>
        <option value="Success">Success</option>
        <option value="Failed">Failed</option>
        <option value="Retrying">Retrying</option>
        <option value="Skipped">Skipped</option>
    </select>
</div>

<div class="jh-grid-wrap">
    <AppGrid TValue="JobRun" DataSource="Filtered.ToList()" AllowSorting="true" AllowPaging="true" EnableHover="true" RowHeight="52">
        
        <GridColumns>
            <GridColumn Field="@nameof(JobRun.StartedAt)"  HeaderText="Started" Width="150"  Format="MMM d h:mm:ss tt" />
            <GridColumn Field="@nameof(JobRun.Workflow)"   HeaderText="Workflow" MinWidth="160" />
            <GridColumn Field="@nameof(JobRun.Trigger)"    HeaderText="Trigger" Width="180" />
            <GridColumn Field="@nameof(JobRun.Account)"    HeaderText="Account" Width="160" />
            <GridColumn Field="@nameof(JobRun.StepsTotal)" HeaderText="Steps" Width="70" TextAlign=@("Center") />
            <GridColumn Field="@nameof(JobRun.Duration)"   HeaderText="Duration" Width="90" />
            <GridColumn Field="@nameof(JobRun.Status)"     HeaderText="Status" Width="110">
                <Template>@{ var r=(JobRun)context; }<span class="@StatusBadge(r.Status)">@r.Status</span></Template>
            </GridColumn>
            <GridColumn HeaderText="" Width="70" TextAlign=@("Right")>
                <Template>@{ var r=(JobRun)context; }
                    <div class="jh-row-actions">
                        <button class="um-btn um-btn-ghost um-btn-xs" title="View log" @onclick="()=>ToggleLog(r)"><i class="bi bi-terminal" aria-hidden="true"></i></button>
                        @if (r.Status == "Failed") { <button class="um-btn um-btn-ghost um-btn-xs jh-retry" title="Retry" @onclick="()=>RetryRun(r)"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></button> }
                    </div>
                </Template>
            </GridColumn>
        </GridColumns>
    </AppGrid>
</div>

@if (_openLog is not null)
{
    <div class="jh-log-panel">
        <div class="jh-log-hdr">
            <span><i class="bi bi-terminal" aria-hidden="true"></i> Execution Log - @_openLog.Workflow</span>
            <button class="um-btn um-btn-ghost um-btn-xs" @onclick="()=>_openLog=null">Close</button>
        </div>
        <div class="jh-log-body">
            @foreach (var line in GenerateLog(_openLog))
            {
                <div class="jh-log-line @(line.Level=="ERROR"?"jh-ll-err":line.Level=="WARN"?"jh-ll-warn":"")">
                    <span class="jh-ll-time">@line.Time</span>
                    <span class="jh-ll-lvl">@line.Level</span>
                    <span class="jh-ll-msg">@line.Message</span>
                </div>
            }
        </div>
    </div>
}

@code {
    private string _search = string.Empty;
    private string _wfFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private JobRun? _openLog;

    private List<JobRun> _runs = [];

    private IEnumerable<JobRun> Filtered => _runs.Where(r =>
        (string.IsNullOrEmpty(_search) || r.Workflow.Contains(_search, StringComparison.OrdinalIgnoreCase) || r.Account.Contains(_search, StringComparison.OrdinalIgnoreCase) || r.Trigger.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_wfFilter) || r.Workflow.Contains(_wfFilter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_statusFilter) || r.Status == _statusFilter));

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Integrations","/integrations"), new("Automation","/integrations/automation"), new("Job History",""));
        var rng = new Random(42);
        var workflows = new[]
        {
            ("Renewal 90-Day Reminder","renewal.created",4),
            ("Claim Severity Alert","claim.opened",4),
            ("Payment Failed Outreach","payment.failed",6),
            ("Download Exception Triage","download.received",5),
            ("Missing Document Reminder","document.missing_required",4),
            ("eSign Timeout Escalation","document.esign.timeout",4),
            ("Lead Inactivity Re-Engagement","lead.inactive",4),
        };
        var accounts = new[]{"Apex Logistics LLC","Kim Realty LLC","Rivera Roofing LLC","Mesa Contractors","Vega Foods Inc","Blue Harbor Marina","Summit Tech Partners","Ortega Construction"};
        var statuses = new[]{"Success","Success","Success","Success","Success","Failed","Retrying","Skipped"};
        for (var i = 0; i < 120; i++)
        {
            var wf = workflows[rng.Next(workflows.Length)];
            _runs.Add(new JobRun
            {
                Id         = i + 1,
                StartedAt  = DateTime.Now.AddMinutes(-rng.Next(1, 1440)),
                Workflow   = wf.Item1,
                Trigger    = wf.Item2,
                Account    = accounts[rng.Next(accounts.Length)],
                StepsTotal = wf.Item3,
                Duration   = $"{rng.Next(50,2000)}ms",
                Status     = statuses[rng.Next(statuses.Length)],
            });
        }
        _runs = [.. _runs.OrderByDescending(r => r.StartedAt)];
    }

    private void ToggleLog(JobRun r) => _openLog = _openLog?.Id == r.Id ? null : r;

    private async Task RetryRun(JobRun r)
    {
        r.Status = "Retrying";
        await Task.Delay(800);
        r.Status = "Success";
        StateHasChanged();
    }

    private static IEnumerable<LogLine> GenerateLog(JobRun r)
    {
        var t = r.StartedAt;
        yield return new LogLine(t.ToString("HH:mm:ss.fff"), "INFO",  $"Workflow '{r.Workflow}' started. Trigger: {r.Trigger}. Account: {r.Account}");
        yield return new LogLine(t.AddMilliseconds(12).ToString("HH:mm:ss.fff"), "INFO",  "Evaluating trigger conditions - matched 1 record");
        yield return new LogLine(t.AddMilliseconds(38).ToString("HH:mm:ss.fff"), "INFO",  "Step 1 - Condition evaluated: PASS");
        yield return new LogLine(t.AddMilliseconds(85).ToString("HH:mm:ss.fff"), "INFO",  "Step 2 - Action: Create task -> Task ID 88412 created");
        if (r.Status == "Failed") { yield return new LogLine(t.AddMilliseconds(120).ToString("HH:mm:ss.fff"), "ERROR", "Step 3 - Action: Send email failed. SMTP timeout after 10s. Will retry in 5 minutes."); }
        else { yield return new LogLine(t.AddMilliseconds(120).ToString("HH:mm:ss.fff"), "INFO", $"Step 3 - Action: Email sent. Message-ID: <ams-{r.Id}@mail.ams>"); }
        yield return new LogLine(t.AddMilliseconds(145).ToString("HH:mm:ss.fff"), r.Status == "Failed" ? "WARN" : "INFO", $"Workflow completed. Status: {r.Status}. Duration: {r.Duration}");
    }

    private static string StatusBadge(string s) => s switch { "Success"=>"jh-st jh-st--ok","Failed"=>"jh-st jh-st--err","Retrying"=>"jh-st jh-st--retry","Skipped"=>"jh-st jh-st--skip",_=>"jh-st" };

    private sealed class JobRun { public int Id{get;set;} public DateTime StartedAt{get;set;} public string Workflow{get;set;}=string.Empty; public string Trigger{get;set;}=string.Empty; public string Account{get;set;}=string.Empty; public int StepsTotal{get;set;} public string Duration{get;set;}=string.Empty; public string Status{get;set;}=string.Empty; }
    private sealed record LogLine(string Time, string Level, string Message);
}
