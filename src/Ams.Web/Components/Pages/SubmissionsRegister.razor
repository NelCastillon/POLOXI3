    async Task HandleActionAsync(string action)
    {
        _openActionMenuFor = null;
        if (_selected is null)
        {
            ShowToast("Select a submission before running an action.", "sde-toast--danger");
            return;
        }

        switch (action)
        {
            case "Open":
                OpenSubmission(_selected);
                break;
            case "Markets":
                OpenMarkets(_selected);
                break;
            case "Quote Register":
                Nav.NavigateTo($"/submissions/quotes?submissionId={_selected.SubmissionId}");
                break;
            case "Initiate Workflow":
                OpenConfirmDialog(action);
                break;
            case "Submit to Market":
            case "Request Quote":
            case "Bind":
            case "Copy":
            case "Decline":
                OpenActionDialog(action);
                break;
        }

        await Task.CompletedTask;
    }

    void OpenActionDialog(string action)
    {
        if (_selected is null)
        {
            ShowToast("Select a submission before running an action.", "sde-toast--danger");
            return;
        }

        _pendingAction = action;
        _actionForm.Reset(_selected, action);
        (_actionTitle, _actionIcon, _actionButtonText) = action switch
        {
            "Submit to Market" => ($"Submit {_selected.SubmissionNumber} to Market", "bi-send", "Submit"),
            "Request Quote" => ($"Request Quote for {_selected.SubmissionNumber}", "bi-file-earmark-text", "Request Quote"),
            "Bind" => ($"Request Bind for {_selected.SubmissionNumber}", "bi-shield-check", "Create Bind Request"),
            "Copy" => ($"Copy {_selected.SubmissionNumber}", "bi-copy", "Create Copy"),
            "Decline" => ($"Decline {_selected.SubmissionNumber}", "bi-x-circle", "Decline"),
            _ => ("Submission Action", "bi-send", "Save")
        };
        _actionHelpText = action switch
        {
            "Submit to Market" => "Send this underwriting package to the recommended or selected carrier market.",
            "Request Quote" => "Create a quote request with a valid annual premium and optional carrier targeting.",
            "Bind" => "Create a bind request. The system creates the policy only after carrier confirmation is recorded from the Bind Center.",
            "Copy" => "Create a new submission copy with a required effective date and line of business.",
            "Decline" => "Record the decline reason before marking this submission declined.",
            _ => "Review the submission action details, complete required fields, and confirm before changes are applied."
        };
        _showActionDialog = true;
    }

    void CloseActionDialog()
    {
        if (_actionBusy) return;
        _showActionDialog = false;
    }

    Task ConfirmActionAsync()
    {
        OpenConfirmDialog(_pendingAction);
        return Task.CompletedTask;
    }

    Task NotifyActionValidationAsync()
    {
        ShowToast("Please correct the highlighted fields before continuing.", "sde-toast--danger");
        return Task.CompletedTask;
    }

    void OpenConfirmDialog(string action)
    {
        if (_selected is null) return;

        _pendingAction = action;
        (_confirmTitle, _confirmMessage, _confirmIcon) = action switch
        {
            "Submit to Market" => ($"Submit {_selected.SubmissionNumber} to market?", "This will add or update a carrier market record and move the submission into review.", "bi-send"),
            "Request Quote" => ($"Request quote for {_selected.SubmissionNumber}?", "This will create a quote request and update submission quote progress.", "bi-file-earmark-text"),
            "Bind" => ($"Create bind request for {_selected.SubmissionNumber}?", "This records a bind request. Policy creation is automatic only after carrier confirmation.", "bi-shield-check"),
            "Copy" => ($"Copy {_selected.SubmissionNumber}?", "This will create a new submission copy using the selected form values.", "bi-copy"),
            "Initiate Workflow" => ($"Initiate workflow for {_selected.SubmissionNumber}?", "This will start a workflow instance for the selected submission.", "bi-diagram-3"),
            "Decline" => ($"Decline {_selected.SubmissionNumber}?", "This will mark the submission and non-final market responses as declined.", "bi-exclamation-triangle"),
            _ => ("Confirm action", "Confirm this submission action?", "bi-question-circle")
        };
        _showConfirmDialog = true;
    }

    void CloseConfirmDialog()
    {
        if (_actionBusy) return;
        _showConfirmDialog = false;
    }

    async Task ExecuteConfirmedActionAsync()
    {
        if (_pendingAction == "Initiate Workflow")
        {
            _showConfirmDialog = false;
            await InitiateWorkflowAsync();
            return;
        }

        await ExecuteActionAsync();
    }

    async Task ExecuteActionAsync()
    {
        if (_selected is null) return;

        _actionBusy = true;
        try
        {
            var carrierId = _actionForm.TryGetCarrierId();
            SubmissionActionResult result;
            if (_pendingAction == "Bind")
            {
                result = new SubmissionActionResult(_selected.SubmissionId, "Continue in the Bind Center to record the bind request and carrier confirmation. The system creates the policy after confirmation.");
                Nav.NavigateTo("/quotes/bind");
            }
            else
            {
                result = _pendingAction switch
            {
                "Submit to Market" => await Api.SubmitSubmissionToMarketAsync(_selected.SubmissionId, new SubmitSubmissionToMarketRequest(_tenantId, carrierId, _actionForm.Notes)),
                "Request Quote" => await Api.RequestSubmissionQuoteAsync(_selected.SubmissionId, new RequestSubmissionQuoteRequest(_tenantId, carrierId, _actionForm.AnnualPremium, null, null, _actionForm.Notes)),
                "Copy" => await Api.CopySubmissionAsync(_selected.SubmissionId, new CopySubmissionRequest(_tenantId, _actionForm.EffectiveDate, _actionForm.LineOfBusiness, _selected.Priority)),
                "Decline" => await Api.DeclineSubmissionAsync(_selected.SubmissionId, new DeclineSubmissionRequest(_tenantId, string.IsNullOrWhiteSpace(_actionForm.Notes) ? "Declined from submissions command center." : _actionForm.Notes)),
                _ => new SubmissionActionResult(_selected.SubmissionId, "No action executed.")
            };
            }

            _showActionDialog = false;
            _showConfirmDialog = false;
            ShowToast(result.Message, "sde-toast--success");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Action failed: {ex.Message}", "sde-toast--danger");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    async Task InitiateWorkflowAsync()
    {
        if (_selected is null) return;

        _actionBusy = true;
        try
        {
            await Api.InitiateWorkflowForSubmissionAsync(_selected.SubmissionId, _tenantId);
            ShowToast("Workflow initiated.", "sde-toast--success");
        }
        catch (Exception ex)
        {
            ShowToast($"Workflow initiation failed: {ex.Message}", "sde-toast--danger");
            Nav.NavigateTo($"/workflow?entity=Submission&entityId={_selected.SubmissionId}");
        }
        finally
        {
            _actionBusy = false;
        }
    }

    void ShowToast(string message, string cssClass)
    {
        var toast = new ToastMessage(Guid.NewGuid(), message, cssClass);
        _toasts.Add(toast);
        _ = Task.Run(async () =>
        {
            await Task.Delay(2800);
            await InvokeAsync(() => DismissToast(toast.Id));
        });
    }

    void DismissToast(Guid id) => _toasts.RemoveAll(t => t.Id == id);

    RenderFragment KpiCard(string key, string label, string value, string subtitle, string icon, string tone)
    {
        var active = _activeKpi == key;
        return @<button type="button" class="sde-kpi sde-kpi--@tone @(active ? "sde-kpi--active" : null)" @onclick="() => SetKpi(key)" title="@(active ? "Clear KPI filter" : subtitle)">
            <span><i class="bi @icon" aria-hidden="true"></i>@label</span>
            <strong>@value</strong>
            <small>@subtitle</small>
        </button>;
    }

    RenderFragment WorkflowButton(string title, string description, string icon, System.Action callback) => @<button type="button" class="sde-workflow" @onclick="() => callback()">
        <i class="bi @icon" aria-hidden="true"></i>
        <span><strong>@title</strong><small>@description</small></span>
    </button>;

    RenderFragment StatusBadge(SubmissionDto row)
    {
        var status = NormalizeStatus(row.Status);
        return @<span class="sde-status sde-status--@Slug(status)">@status</span>;
    }

    RenderFragment ImportanceBadge(SubmissionDto row) => @<span class="sde-importance sde-importance--@Slug(ImportanceLevel(row))">@ImportanceLevel(row)<small>@ImportanceScore(row)</small></span>;

    RenderFragment DueBadge(SubmissionDto row)
    {
        var days = (row.EffectiveDate.Date - DateTime.Today).Days;
        var label = days < 0 ? $"{Math.Abs(days)}d late" : days == 0 ? "Today" : $"{days}d";
        var css = days < 0 ? "late" : days <= 7 ? "soon" : "normal";
        return @<span class="sde-due sde-due--@css">@label</span>;
    }

    RenderFragment PremiumCell(SubmissionDto row)
    {
        var value = row.TargetPremium ?? 0;
        return value <= 0 ? @<span class="sde-muted">-</span> : @<strong class="sde-premium">@value.ToString("C0")</strong>;
    }

    static bool IsReview(SubmissionDto row) => NormalizeStatus(row.Status) == "In Review";
    static bool IsQuoted(SubmissionDto row) => NormalizeStatus(row.Status) == "Quoted";
    static bool IsBound(SubmissionDto row) => NormalizeStatus(row.Status) == "Bound";
    static bool IsDeclined(SubmissionDto row) => NormalizeStatus(row.Status) is "Declined" or "Withdrawn";
    static string NormalizeStatus(string? status) => (string.IsNullOrWhiteSpace(status) ? "New" : status) switch
    {
        "Draft" => "New",
        "Submitted" => "In Review",
        "Under Review" => "In Review",
        "Approved" => "Quoted",
        "Rejected" => "Declined",
        var value => value
    };
    static bool Contains(string? source, string term) => !string.IsNullOrWhiteSpace(source) && source.Contains(term, StringComparison.OrdinalIgnoreCase);
    static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    static string Slug(string value) => value.ToLowerInvariant().Replace(" ", "-").Replace("/", "-");
    static IEnumerable<string> MergeOptions(IEnumerable<string> configured, IEnumerable<string> observed) => configured.Concat(observed).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(s => s);
    static List<SubmissionOption> ToOptions(IEnumerable<SubmissionReferenceOptionDto> options, string group) => options.Where(o => string.Equals(o.OptionGroup, group, StringComparison.OrdinalIgnoreCase)).OrderBy(o => o.SortOrder).ThenBy(o => o.OptionName).Select(o => new SubmissionOption(o.OptionCode, o.OptionName, o.IsDefault)).ToList();

    sealed record SubmissionOption(string Code, string Name, bool IsDefault);
    sealed record TabDef(string Key, string Label, string Icon);
    sealed record ActionDef(string Key, string Label, string Icon, bool IsDanger);
    sealed record GroupSummary(string Name, int Count, decimal TargetPremium, int CriticalCount, int QuoteCount, int Percent);
    sealed record InsightDef(string Title, string Description, string Icon);
    sealed record ToastMessage(Guid Id, string Message, string CssClass);

    sealed class SubmissionActionForm : IValidatableObject
    {
        public string? CarrierIdText { get; set; }
        [Range(0, 999999999999)] public decimal? AnnualPremium { get; set; }
        public DateTime? EffectiveDate { get; set; }
        [StringLength(100)] public string? LineOfBusiness { get; set; }
        [StringLength(80)] public string? PolicyNumber { get; set; }
        [Required, StringLength(50)] public string PolicySourceCode { get; set; } = "QuoteBound";
        [StringLength(500)] public string? PolicySourceReason { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
        string _action = string.Empty;

        public void Reset(SubmissionDto row, string action)
        {
            _action = action;
            CarrierIdText = null;
            AnnualPremium = row.TargetPremium;
            EffectiveDate = row.EffectiveDate == default ? DateTime.Today.AddDays(30) : row.EffectiveDate;
            LineOfBusiness = row.LineOfBusiness;
            Notes = action == "Decline" ? "Carrier declined or account withdrawn." : string.Empty;
            PolicyNumber = string.Empty;
            PolicySourceReason = string.Empty;
            PolicySourceCode = "QuoteBound";
        }

        public Guid? TryGetCarrierId() => Guid.TryParse(CarrierIdText, out var carrierId) ? carrierId : null;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!string.IsNullOrWhiteSpace(CarrierIdText) && !Guid.TryParse(CarrierIdText, out _))
                yield return new ValidationResult("Carrier ID must be a valid GUID.", [nameof(CarrierIdText)]);
            if (_action == "Decline" && string.IsNullOrWhiteSpace(Notes))
                yield return new ValidationResult("Decline reason is required.", [nameof(Notes)]);
            if (_action is "Request Quote" or "Bind")
            {
                if (AnnualPremium is null or <= 0)
                    yield return new ValidationResult("Annual premium is required and must be greater than zero.", [nameof(AnnualPremium)]);
                if (EffectiveDate is null)
                    yield return new ValidationResult("Effective date is required.", [nameof(EffectiveDate)]);
            }
            if (_action == "Copy")
            {
                if (EffectiveDate is null)
                    yield return new ValidationResult("Effective date is required.", [nameof(EffectiveDate)]);
                if (string.IsNullOrWhiteSpace(LineOfBusiness))
                    yield return new ValidationResult("Line of business is required.", [nameof(LineOfBusiness)]);
            }
        }
    }
}
