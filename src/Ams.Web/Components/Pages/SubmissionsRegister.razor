@page "/submissions"
@namespace Ams.Web.Components.Pages
@using System.ComponentModel.DataAnnotations
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Submissions
@inject ApiClient Api
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject CurrentUserContext CurrentUser

<PageTitle>Submissions Command Center - AMS</PageTitle>

<div class="sde-page">
    <section class="sde-hero">
        <div class="sde-hero-left">
            <div class="sde-hero-icon">
                <i class="bi bi-send-check" aria-hidden="true"></i>
            </div>
            <div class="sde-hero__content">
                <div class="sde-title-row">
                    <h1>Submissions Command Center</h1>
                    <span><i class="bi bi-stack" aria-hidden="true"></i>@FilteredRows.Count() matches</span>
                    @if (HasFilters)
                    {
                        <span><i class="bi bi-funnel" aria-hidden="true"></i>Filtered</span>
                    }
                </div>
                <p>Prioritize underwriting work, monitor market progress, and run submission workflows from one native Blazor dashboard.</p>
                <div class="sde-hero__meta">
                    <span><i class="bi bi-stack" aria-hidden="true"></i>@_rows.Count submissions</span>
                    <span><i class="bi bi-exclamation-diamond" aria-hidden="true"></i>@CriticalRows.Count() critical</span>
                    <span><i class="bi bi-cash-stack" aria-hidden="true"></i>@PipelinePremium.ToString("C0") target premium</span>
                    <span><i class="bi bi-diagram-3" aria-hidden="true"></i>@MarketedRows.Count() marketed</span>
                </div>
            </div>
        </div>
        <div class="sde-hero__actions">
            <button type="button" class="sde-btn sde-btn--light" @onclick="LoadAsync" disabled="@_loading">
                <i class="bi bi-arrow-clockwise @(_loading ? "sde-spin" : null)" aria-hidden="true"></i> Refresh
            </button>
            <button type="button" class="sde-btn sde-btn--primary" @onclick='() => Nav.NavigateTo("/submissions/new")'>
                <i class="bi bi-plus-lg" aria-hidden="true"></i> New Submission
            </button>
            <button type="button" class="sde-btn sde-btn--light" @onclick='() => Nav.NavigateTo("/submissions/quotes")'>
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Quotes
            </button>
            <button type="button" class="sde-btn sde-btn--light" @onclick='() => Nav.NavigateTo("/submissions/applications")'>
                <i class="bi bi-clipboard-check" aria-hidden="true"></i> Applications
            </button>
            <button type="button" class="sde-btn sde-btn--light" @onclick='() => Nav.NavigateTo("/submissions/intake")'>
                <i class="bi bi-inboxes" aria-hidden="true"></i> Intake
            </button>
            <button type="button" class="sde-btn sde-btn--light" @onclick='() => Nav.NavigateTo("/submissions/declines")'>
                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Declines
            </button>
        </div>
    </section>

    @if (_loadError is not null)
    {
        <div class="alert alert-danger sde-alert" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
    }

    <section class="sde-kpi-strip" aria-label="Submission KPIs">
        @KpiCard("all", "Total Submissions", _rows.Count.ToString(), "All active submission records", "bi-stack", "blue")
        @KpiCard("critical", "Critical Work", CriticalRows.Count().ToString(), "High importance, overdue, or near effective", "bi-exclamation-octagon", "red")
        @KpiCard("review", "In Review", _rows.Count(IsReview).ToString(), "Submissions currently in underwriting review", "bi-hourglass-split", "amber")
        @KpiCard("quoted", "Quoted", _rows.Count(IsQuoted).ToString(), "Quoted submissions ready for proposal or bind", "bi-file-earmark-check", "cyan")
        @KpiCard("bound", "Bound", _rows.Count(IsBound).ToString(), "Converted submissions with bound coverage", "bi-shield-check", "green")
        @KpiCard("premium", "Target Premium", PipelinePremium.ToString("C0"), "Total target premium in active pipeline", "bi-cash-stack", "emerald")
    </section>

    <section class="sde-workflows" aria-label="Submission workflows">
        @WorkflowButton("Critical work", "Open highest-importance submissions first", "bi-lightning-charge", () => SetDashboardFocus("critical", "priority"))
        @WorkflowButton("Market follow-up", "Review submissions with markets but no quotes", "bi-diagram-3", () => SetDashboardFocus("markets", "market"))
        @WorkflowButton("Quote desk", "Work quoted items and proposal-ready submissions", "bi-file-earmark-text", () => SetDashboardFocus("quoted", "quoted"))
        @WorkflowButton("Bind queue", "Convert quoted submissions into policies", "bi-shield-plus", () => SetDashboardFocus("bind", "quoted"))
        @WorkflowButton("Decline recovery", "Review declined and withdrawn submissions", "bi-arrow-counterclockwise", () => SetDashboardFocus("declined", "declined"))
    </section>

    <section class="sde-filter-panel" aria-label="Submission filters">
        <div class="sde-search-wrap">
            <div class="sde-search-icon"><i class="bi bi-search" aria-hidden="true"></i></div>
            <div class="sde-search-body">
                <label for="submission-search-input">Enterprise search</label>
                <input id="submission-search-input" class="sde-search-input" @bind="SearchText" @bind:event="oninput" placeholder="Search submission #, account, opportunity, LOB, status, priority, assignee, premium, markets..." />
                <span class="sde-search-hint">Searches all visible and supporting submission fields as you type.</span>
            </div>
        </div>
        <div class="sde-filter-grid">
            <label>
                <span>Status</span>
                <select class="form-select" @bind="StatusFilter">
                    <option value="">All statuses</option>
                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </label>
        </div>
        <div class="sde-search-result">
            <strong>@FilteredRows.Count()</strong>
            <span>matches</span>
        </div>
    </section>

    <nav class="sde-tabs" aria-label="Submission views">
        @foreach (var tab in _tabs)
        {
            <button type="button" class="sde-tab @(_activeTab == tab.Key ? "sde-tab--active" : null)" @onclick="() => SetActiveTab(tab.Key)">
                <i class="bi @tab.Icon" aria-hidden="true"></i>
                <span>@tab.Label</span>
                <strong>@TabCount(tab.Key)</strong>
            </button>
        }
    </nav>

    <main class="sde-dashboard">
        <section class="sde-main-card">
            <div class="sde-card-header">
                <div>
                    <span class="sde-section-kicker">@ActiveViewTitle</span>
                    <h2>@FilteredRows.Count() submissions</h2>
                    <p>Ranked by enterprise importance: urgency, status, premium value, market activity, and quote readiness.</p>
                </div>
                <div class="sde-card-actions">
                    <button type="button" class="sde-btn sde-btn--ghost" @onclick="PreviousPage" disabled="@(_page <= 1)">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i> Previous
                    </button>
                    <span class="sde-page-indicator">Page @_page of @TotalPages</span>
                    <button type="button" class="sde-btn sde-btn--ghost" @onclick="NextPage" disabled="@(_page >= TotalPages)">
                        Next <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>
            </div>

            @if (_loading)
            {
                <div class="sde-loading"><span class="sde-spinner"></span> Loading submissions...</div>
            }
            else if (!FilteredRows.Any())
            {
                <div class="sde-empty">
                    <i class="bi bi-inbox" aria-hidden="true"></i>
                    <strong>No submissions found</strong>
                    <span>Adjust the active view, KPI, search, or filters.</span>
                </div>
            }
            else if (_activeTab == "producer")
            {
                <div class="sde-producer-grid">
                    @foreach (var group in ProducerRows)
                    {
                        <article class="sde-producer-card">
                            <div>
                                <span>Producer / owner</span>
                                <h3>@group.Name</h3>
                            </div>
                            <strong>@group.Count</strong>
                            <p>@group.TargetPremium.ToString("C0") target premium - @group.CriticalCount critical - @group.QuoteCount quotes</p>
                            <button type="button" class="sde-btn sde-btn--ghost" @onclick="() => FilterByOwner(group.Name)">View owner work</button>
                        </article>
                    }
                </div>
            }
            else if (_activeTab == "lob")
            {
                <div class="sde-lob-grid">
                    @foreach (var group in LobRows)
                    {
                        <article class="sde-lob-card">
                            <div class="sde-lob-icon"><i class="bi bi-layers" aria-hidden="true"></i></div>
                            <div>
                                <h3>@group.Name</h3>
                                <p>@group.Count submissions - @group.TargetPremium.ToString("C0") target premium</p>
                                <div class="sde-mini-bar"><span style="width:@group.Percent%"></span></div>
                            </div>
                            <button type="button" class="sde-btn sde-btn--ghost" @onclick="() => FilterByLob(group.Name)">Open</button>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="@(_openActionMenuFor.HasValue ? "sde-table-wrap sde-table-wrap--menu-open" : "sde-table-wrap")">
                    <table class="sde-table">
                        <thead>
                            <tr>
                                <th>Importance</th>
                                <th>Submission</th>
                                <th>Account / Opportunity</th>
                                <th>Line</th>
                                <th>Status</th>
                                <th>Owner</th>
                                <th>Effective</th>
                                <th>Due</th>
                                <th>Premium</th>
                                <th>Markets</th>
                                <th>Quotes</th>
                                <th class="sde-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in PagedRows)
                            {
                                <tr class="@(_selected?.SubmissionId == row.SubmissionId ? "sde-row sde-row--selected" : "sde-row")" @onclick="() => SelectRow(row)">
                                    <td>@ImportanceBadge(row)</td>
                                    <td>
                                        <button type="button" class="sde-link-button" @onclick:stopPropagation="true" @onclick="() => OpenSubmission(row)">@row.SubmissionNumber</button>
                                        <small>@row.CreatedDateUtc.ToString("MMM d, yyyy")</small>
                                    </td>
                                    <td>
                                        <strong>@row.AccountName</strong>
                                        <small>@(string.IsNullOrWhiteSpace(row.OpportunityName) ? "No linked opportunity" : row.OpportunityName)</small>
                                    </td>
                                    <td><span class="sde-lob-pill">@Safe(row.LineOfBusiness, "Unknown")</span></td>
                                    <td>@StatusBadge(row)</td>
                                    <td>@Safe(row.AssignedToUserName, "Unassigned")</td>
                                    <td>@row.EffectiveDate.ToString("MMM d, yyyy")</td>
                                    <td>@DueBadge(row)</td>
                                    <td>@PremiumCell(row)</td>
                                    <td><span class="sde-count-pill">@row.MarketCount</span></td>
                                    <td><span class="sde-count-pill sde-count-pill--quote">@row.QuoteCount</span></td>
                                    <td class="sde-actions-col">
                                        <button type="button" class="sde-icon-btn" title="Open action menu" @onclick:stopPropagation="true" @onclick="() => ToggleActionMenu(row)">
                                            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                        </button>
                                        @if (_openActionMenuFor == row.SubmissionId)
                                        {
                                            <div class="sde-menu" role="menu" @onclick:stopPropagation="true">
                                                <div class="sde-menu__summary">
                                                    <strong>@row.SubmissionNumber</strong>
                                                    <span>@row.AccountName</span>
                                                </div>
                                                @foreach (var action in _actions)
                                                {
                                                    <button type="button" class="@(action.IsDanger ? "sde-menu-item sde-menu-item--danger" : "sde-menu-item")" role="menuitem" @onclick="() => HandleActionAsync(action.Key)">
                                                        <i class="bi @action.Icon" aria-hidden="true"></i>
                                                        <span>@action.Label</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <aside class="sde-side-panel">
            <section class="sde-panel-card">
                <span class="sde-section-kicker">Selected submission</span>
                @if (_selected is null)
                {
                    <div class="sde-empty sde-empty--compact">
                        <i class="bi bi-cursor" aria-hidden="true"></i>
                        <strong>Select a row</strong>
                        <span>Choose a submission to inspect priority and actions.</span>
                    </div>
                }
                else
                {
                    <div class="sde-selected">
                        <div class="sde-selected__title">
                            <h3>@_selected.SubmissionNumber</h3>
                            @StatusBadge(_selected)
                        </div>
                        <p>@_selected.AccountName</p>
                        <div class="sde-score-card">
                            <span>Importance score</span>
                            <strong>@ImportanceScore(_selected)</strong>
                            <small>@ImportanceLevel(_selected)</small>
                        </div>
                        <dl class="sde-detail-list">
                            <div><dt>LOB</dt><dd>@Safe(_selected.LineOfBusiness, "Unknown")</dd></div>
                            <div><dt>Priority</dt><dd>@Safe(_selected.Priority, "Standard")</dd></div>
                            <div><dt>Owner</dt><dd>@Safe(_selected.AssignedToUserName, "Unassigned")</dd></div>
                            <div><dt>Effective</dt><dd>@_selected.EffectiveDate.ToString("MMM d, yyyy")</dd></div>
                            <div><dt>Expiration</dt><dd>@_selected.ExpirationDate.ToString("MMM d, yyyy")</dd></div>
                            <div><dt>Target premium</dt><dd>@((_selected.TargetPremium ?? 0).ToString("C0"))</dd></div>
                            <div><dt>Markets / Quotes</dt><dd>@_selected.MarketCount / @_selected.QuoteCount</dd></div>
                        </dl>
                        <div class="sde-selected-actions">
                            <button type="button" class="sde-btn sde-btn--primary" @onclick="() => OpenSubmission(_selected)"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i> Open</button>
                            <button type="button" class="sde-btn sde-btn--ghost" @onclick='() => OpenActionDialog("Submit to Market")'><i class="bi bi-send" aria-hidden="true"></i> Submit</button>
                            <button type="button" class="sde-btn sde-btn--ghost" @onclick='() => OpenActionDialog("Request Quote")'><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Quote</button>
                            <button type="button" class="sde-btn sde-btn--ghost" @onclick="() => OpenMarkets(_selected)"><i class="bi bi-diagram-3" aria-hidden="true"></i> Markets</button>
                            <button type="button" class="sde-btn sde-btn--ghost" @onclick='() => OpenConfirmDialog("Initiate Workflow")'><i class="bi bi-diagram-2" aria-hidden="true"></i> Workflow</button>
                            <button type="button" class="sde-btn sde-btn--ghost" @onclick='() => OpenActionDialog("Copy")'><i class="bi bi-copy" aria-hidden="true"></i> Copy</button>
                        </div>
                    </div>
                }
            </section>

            <section class="sde-panel-card">
                <span class="sde-section-kicker">Operational intelligence</span>
                <div class="sde-insight-list">
                    @foreach (var insight in Insights)
                    {
                        <div class="sde-insight">
                            <i class="bi @insight.Icon" aria-hidden="true"></i>
                            <div>
                                <strong>@insight.Title</strong>
                                <span>@insight.Description</span>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </aside>
    </main>
</div>

@if (_showActionDialog)
{
    <div class="sde-modal-backdrop" role="presentation" @onclick="CloseActionDialog">
        <div class="sde-modal" role="dialog" aria-modal="true" aria-labelledby="sde-action-title" @onclick:stopPropagation="true">
            <div class="sde-modal__header">
                <i class="bi @_actionIcon" aria-hidden="true"></i>
                <span id="sde-action-title">@_actionTitle</span>
                <button type="button" class="sde-icon-btn sde-icon-btn--light ms-auto" @onclick="CloseActionDialog"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <EditForm Model="_actionForm" OnValidSubmit="ConfirmActionAsync" OnInvalidSubmit="NotifyActionValidationAsync">
                <DataAnnotationsValidator />
                <div class="sde-modal__body">
                    <div class="sde-modal-intro">
                        <strong>@_actionHelpText</strong>
                        <span>@_selected?.SubmissionNumber - @_selected?.AccountName</span>
                    </div>
                    <div class="sde-form-grid">
                        @if (_pendingAction is "Submit to Market" or "Request Quote" or "Bind")
                        {
                            <label class="sde-field sde-field--full">
                                <span>Carrier ID <small>optional</small></span>
                                <InputText class="form-control" @bind-Value="_actionForm.CarrierIdText" placeholder="Carrier GUID, or leave blank for best market" />
                                <ValidationMessage For="() => _actionForm.CarrierIdText" class="text-danger" />
                            </label>
                        }
                        @if (_pendingAction is "Request Quote" or "Bind")
                        {
                            <label class="sde-field">
                                <span>Annual Premium <em>*</em></span>
                                <InputNumber class="form-control" @bind-Value="_actionForm.AnnualPremium" />
                                <ValidationMessage For="() => _actionForm.AnnualPremium" class="text-danger" />
                            </label>
                            <label class="sde-field">
                                <span>Effective Date <em>*</em></span>
                                <InputDate class="form-control" @bind-Value="_actionForm.EffectiveDate" />
                                <ValidationMessage For="() => _actionForm.EffectiveDate" class="text-danger" />
                            </label>
                        }
                        @if (_pendingAction is "Copy")
                        {
                            <label class="sde-field">
                                <span>Effective Date <em>*</em></span>
                                <InputDate class="form-control" @bind-Value="_actionForm.EffectiveDate" />
                                <ValidationMessage For="() => _actionForm.EffectiveDate" class="text-danger" />
                            </label>
                            <label class="sde-field">
                                <span>Line of Business <em>*</em></span>
                                <InputSelect class="form-select" @bind-Value="_actionForm.LineOfBusiness">
                                    <option value="">Use original</option>
                                    @foreach (var lob in LobOptions)
                                    {
                                        <option value="@lob">@lob</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => _actionForm.LineOfBusiness" class="text-danger" />
                            </label>
                        }
                        <label class="sde-field sde-field--full">
                            <span>@(_pendingAction == "Decline" ? "Reason *" : "Notes")</span>
                            <InputTextArea class="form-control" rows="4" @bind-Value="_actionForm.Notes" />
                            <ValidationMessage For="() => _actionForm.Notes" class="text-danger" />
                        </label>
                    </div>
                </div>
                <div class="sde-modal__footer">
                    <button type="button" class="sde-btn sde-btn--ghost" @onclick="CloseActionDialog">Cancel</button>
                    <button type="submit" class="sde-btn sde-btn--primary" disabled="@_actionBusy">
                        @if (_actionBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @_actionButtonText
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showConfirmDialog)
{
    <div class="sde-modal-backdrop" role="presentation" @onclick="CloseConfirmDialog">
        <div class="sde-confirm" role="dialog" aria-modal="true" aria-labelledby="sde-confirm-title" @onclick:stopPropagation="true">
            <div class="sde-modal__header">
                <i class="bi @_confirmIcon" aria-hidden="true"></i>
                <span>Confirm submission action</span>
                <button type="button" class="sde-icon-btn sde-icon-btn--light ms-auto" @onclick="CloseConfirmDialog" disabled="@_actionBusy"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="sde-confirm__body">
                <div class="@(_pendingAction == "Decline" ? "sde-confirm-icon sde-confirm-icon--danger" : "sde-confirm-icon")">
                    <i class="bi @_confirmIcon" aria-hidden="true"></i>
                </div>
                <div>
                    <h3 id="sde-confirm-title">@_confirmTitle</h3>
                    <p>@_confirmMessage</p>
                </div>
            </div>
            <div class="sde-modal__footer">
                <button type="button" class="sde-btn sde-btn--ghost" @onclick="CloseConfirmDialog" disabled="@_actionBusy">Cancel</button>
                <button type="button" class="@(_pendingAction == "Decline" ? "sde-btn sde-btn--danger" : "sde-btn sde-btn--primary")" @onclick="ExecuteConfirmedActionAsync" disabled="@_actionBusy">
                    @if (_actionBusy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Confirm
                </button>
            </div>
        </div>
    </div>
}

<div class="sde-toast-stack" aria-live="polite" aria-atomic="true">
    @foreach (var toast in _toasts)
    {
        <div class="sde-toast @toast.CssClass">
            <i class="bi @(toast.CssClass.Contains("danger") ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
            <span>@toast.Message</span>
            <button type="button" @onclick="() => DismissToast(toast.Id)"><i class="bi bi-x" aria-hidden="true"></i></button>
        </div>
    }
</div>

@code {
    bool _loading;
    bool _showActionDialog;
    bool _showConfirmDialog;
    bool _actionBusy;
    Guid? _openActionMenuFor;
    string _activeTab = "all";
    string _activeKpi = "all";
    string _sortMode = "importance";
    string? _searchText;
    string? _statusFilter;
    string? _lobFilter;
    string? _importanceFilter;
    int _page = 1;
    const int PageSize = 18;
    string? _loadError;
    string _pendingAction = string.Empty;
    string _actionTitle = "Submission Action";
    string _actionIcon = "bi-send";
    string _actionButtonText = "Save";
    string _actionHelpText = "Review the submission action details, complete required fields, and confirm before changes are applied.";
    string _confirmTitle = "Confirm action";
    string _confirmMessage = "Confirm this submission action?";
    string _confirmIcon = "bi-question-circle";
    Guid _tenantId;
    SubmissionDto? _selected;
    readonly SubmissionActionForm _actionForm = new();
    readonly List<SubmissionDto> _rows = new();
    readonly List<ToastMessage> _toasts = new();
    List<SubmissionOption> _statusOptions = [];
    List<SubmissionOption> _lobOptions = [];
    List<PolicyCreationSourceDto> _policyCreationSources = [];

    readonly TabDef[] _tabs =
    [
        new("all", "All", "bi-stack"),
        new("priority", "Priority", "bi-lightning-charge"),
        new("markets", "Markets", "bi-diagram-3"),
        new("quoted", "Quoted", "bi-file-earmark-check"),
        new("bind", "Bind Queue", "bi-shield-plus"),
        new("declined", "Declines", "bi-x-circle"),
        new("producer", "By Producer", "bi-person-workspace"),
        new("lob", "By LOB", "bi-layers")
    ];

    readonly ActionDef[] _actions =
    [
        new("Open", "Open", "bi-box-arrow-up-right", false),
        new("Markets", "Markets", "bi-diagram-3", false),
        new("Quote Register", "Quote Register", "bi-table", false),
        new("Submit to Market", "Submit to Market", "bi-send", false),
        new("Request Quote", "Request Quote", "bi-file-earmark-text", false),
        new("Bind", "Request Bind", "bi-shield-check", false),
        new("Copy", "Copy", "bi-copy", false),
        new("Initiate Workflow", "Initiate Workflow", "bi-diagram-3", false),
        new("Decline", "Decline", "bi-x-circle", true)
    ];

    IEnumerable<SubmissionDto> CriticalRows => _rows.Where(r => ImportanceLevel(r) is "Critical" or "High");
    IEnumerable<SubmissionDto> MarketedRows => _rows.Where(r => r.MarketCount > 0 || r.QuoteCount > 0 || IsReview(r));
    decimal PipelinePremium => _rows.Where(r => !IsBound(r) && !IsDeclined(r)).Sum(r => r.TargetPremium ?? 0);
    bool HasFilters => _activeKpi != "all" || !string.IsNullOrWhiteSpace(_searchText) || !string.IsNullOrWhiteSpace(_statusFilter) || !string.IsNullOrWhiteSpace(_lobFilter) || !string.IsNullOrWhiteSpace(_importanceFilter);
    int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)PageSize));
    string ActiveViewTitle => _tabs.FirstOrDefault(t => t.Key == _activeTab)?.Label ?? "All";
    string? SearchText { get => _searchText; set { _searchText = value; _page = 1; } }
    string? StatusFilter { get => _statusFilter; set { _statusFilter = value; _page = 1; } }
    string? LobFilter { get => _lobFilter; set { _lobFilter = value; _page = 1; } }
    string? ImportanceFilter { get => _importanceFilter; set { _importanceFilter = value; _page = 1; } }
    string SortMode { get => _sortMode; set { _sortMode = value; _page = 1; } }
    PolicyCreationSourceDto? SelectedPolicyCreationSource => _policyCreationSources.FirstOrDefault(x => string.Equals(x.SourceCode, _actionForm.PolicySourceCode, StringComparison.OrdinalIgnoreCase));

    IEnumerable<string> StatusOptions => MergeOptions(_statusOptions.Select(o => o.Code), _rows.Select(r => NormalizeStatus(r.Status)));
    IEnumerable<string> LobOptions => MergeOptions(_lobOptions.Select(o => o.Code), _rows.Select(r => r.LineOfBusiness));

    IEnumerable<SubmissionDto> FilteredRows => SortRows(ApplyFilters(TabRows));
    IEnumerable<SubmissionDto> PagedRows => FilteredRows.Skip((_page - 1) * PageSize).Take(PageSize);

    IEnumerable<SubmissionDto> TabRows => _activeTab switch
    {
        "priority" => CriticalRows,
        "markets" => _rows.Where(r => r.MarketCount > 0 || IsReview(r)),
        "quoted" => _rows.Where(IsQuoted),
        "bind" => _rows.Where(r => IsQuoted(r) || (r.QuoteCount > 0 && !IsBound(r) && !IsDeclined(r))),
        "declined" => _rows.Where(IsDeclined),
        _ => _rows
    };

    IEnumerable<GroupSummary> ProducerRows => FilteredRows
        .GroupBy(r => Safe(r.AssignedToUserName, "Unassigned"))
        .Select(g => new GroupSummary(g.Key, g.Count(), g.Sum(x => x.TargetPremium ?? 0), g.Count(x => ImportanceLevel(x) is "Critical" or "High"), g.Sum(x => x.QuoteCount), 100))
        .OrderByDescending(g => g.TargetPremium);

    IEnumerable<GroupSummary> LobRows
    {
        get
        {
            var groups = FilteredRows.GroupBy(r => Safe(r.LineOfBusiness, "Unknown")).ToList();
            var max = Math.Max(1, groups.Max(g => g.Count()));
            return groups.Select(g => new GroupSummary(g.Key, g.Count(), g.Sum(x => x.TargetPremium ?? 0), g.Count(x => ImportanceLevel(x) is "Critical" or "High"), g.Sum(x => x.QuoteCount), Math.Max(8, (int)Math.Round(g.Count() * 100m / max))))
                .OrderByDescending(g => g.TargetPremium);
        }
    }

    IEnumerable<InsightDef> Insights =>
    [
        new("Critical work", $"{CriticalRows.Count()} submissions need priority attention.", "bi-exclamation-diamond"),
        new("Market readiness", $"{_rows.Count(r => r.MarketCount == 0 && !IsDeclined(r) && !IsBound(r))} active submissions have no markets recorded.", "bi-diagram-3"),
        new("Quote conversion", $"{_rows.Count(r => r.QuoteCount > 0 && !IsBound(r))} quoted or quote-ready submissions remain unbound.", "bi-file-earmark-check"),
        new("Unassigned work", $"{_rows.Count(r => string.IsNullOrWhiteSpace(r.AssignedToUserName))} submissions have no owner.", "bi-person-x")
    ];

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Submissions", "/submissions"));
        await LoadReferenceDataAsync();
        await LoadAsync();
    }

    async Task LoadReferenceDataAsync()
    {
        var optionsTask = Api.GetSubmissionReferenceOptionsAsync(_tenantId);
        var policySourcesTask = Api.GetPolicyCreationSourcesAsync(_tenantId);
        await Task.WhenAll(optionsTask, policySourcesTask);
        var options = optionsTask.Result;
        var activeOptions = options?.Where(o => o.IsActive).ToList() ?? [];
        _statusOptions = ToOptions(activeOptions, "SubmissionStatus");
        _lobOptions = ToOptions(activeOptions, "LineOfBusiness");
        _policyCreationSources = policySourcesTask.Result?.Where(x => x.IsActive).OrderBy(x => x.SortOrder).ThenBy(x => x.SourceName).ToList() ?? [];
    }

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchSubmissionsAsync(_tenantId, pageSize: 500);
            _rows.Clear();
            _rows.AddRange(result?.Items ?? []);
            _selected = _selected is null ? _rows.OrderByDescending(ImportanceScore).FirstOrDefault() : _rows.FirstOrDefault(r => r.SubmissionId == _selected.SubmissionId) ?? _rows.OrderByDescending(ImportanceScore).FirstOrDefault();
            _page = Math.Min(_page, TotalPages);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load submissions: {ex.Message}";
            ShowToast($"Load failed: {ex.Message}", "sde-toast--danger");
        }
        finally
        {
            _loading = false;
        }
    }

    IEnumerable<SubmissionDto> ApplyFilters(IEnumerable<SubmissionDto> rows)
    {
        rows = _activeKpi switch
        {
            "critical" => rows.Where(r => ImportanceLevel(r) is "Critical" or "High"),
            "review" => rows.Where(IsReview),
            "quoted" => rows.Where(IsQuoted),
            "bound" => rows.Where(IsBound),
            "premium" => rows.Where(r => (r.TargetPremium ?? 0) > 0),
            _ => rows
        };

        if (!string.IsNullOrWhiteSpace(_statusFilter))
        {
            rows = rows.Where(r => string.Equals(NormalizeStatus(r.Status), _statusFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_lobFilter))
        {
            rows = rows.Where(r => string.Equals(r.LineOfBusiness, _lobFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_importanceFilter))
        {
            rows = rows.Where(r => string.Equals(ImportanceLevel(r), _importanceFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim();
            rows = rows.Where(r => Contains(r.SubmissionNumber, term)
                || Contains(r.AccountName, term)
                || Contains(r.OpportunityName, term)
                || Contains(r.LineOfBusiness, term)
                || Contains(r.Status, term)
                || Contains(r.Priority, term)
                || Contains(r.AssignedToUserName, term)
                || Contains(r.SubmissionId.ToString(), term)
                || Contains(r.EffectiveDate.ToString("MM/dd/yyyy"), term)
                || Contains(r.EffectiveDate.ToString("yyyy-MM-dd"), term)
                || Contains((r.TargetPremium ?? 0).ToString("C0"), term)
                || Contains(r.MarketCount.ToString(), term)
                || Contains(r.QuoteCount.ToString(), term));
        }

        return rows;
    }

    IEnumerable<SubmissionDto> SortRows(IEnumerable<SubmissionDto> rows) => _sortMode switch
    {
        "effective" => rows.OrderBy(r => r.EffectiveDate),
        "premium" => rows.OrderByDescending(r => r.TargetPremium ?? 0),
        "status" => rows.OrderBy(r => NormalizeStatus(r.Status)).ThenByDescending(ImportanceScore),
        "markets" => rows.OrderByDescending(r => r.MarketCount + r.QuoteCount).ThenByDescending(ImportanceScore),
        _ => rows.OrderByDescending(ImportanceScore).ThenBy(r => r.EffectiveDate)
    };

    int ImportanceScore(SubmissionDto row)
    {
        var score = 0;
        var status = NormalizeStatus(row.Status);
        var daysToEffective = (row.EffectiveDate.Date - DateTime.Today).Days;
        var premium = row.TargetPremium ?? 0;

        score += status switch
        {
            "New" => 22,
            "In Review" => 30,
            "Quoted" => 34,
            "Bound" => 5,
            "Declined" or "Withdrawn" => 10,
            _ => 14
        };
        score += row.Priority?.Contains("High", StringComparison.OrdinalIgnoreCase) == true ? 22 : row.Priority?.Contains("Urgent", StringComparison.OrdinalIgnoreCase) == true ? 28 : 8;
        score += daysToEffective < 0 ? 30 : daysToEffective <= 7 ? 24 : daysToEffective <= 30 ? 14 : 6;
        score += premium >= 100000 ? 24 : premium >= 50000 ? 16 : premium > 0 ? 8 : 0;
        score += row.QuoteCount > 0 ? 10 : row.MarketCount > 0 ? 6 : 0;
        score += string.IsNullOrWhiteSpace(row.AssignedToUserName) ? 8 : 0;
        return Math.Min(score, 100);
    }

    string ImportanceLevel(SubmissionDto row) => ImportanceScore(row) switch
    {
        >= 80 => "Critical",
        >= 62 => "High",
        >= 42 => "Medium",
        _ => "Standard"
    };

