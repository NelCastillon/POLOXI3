    void ClearFilters()
    {
        _activeKpi = "all";
        _searchText = null;
        _statusFilter = null;
        _lobFilter = null;
        _importanceFilter = null;
        _page = 1;
    }

    void PreviousPage()
    {
        if (_page > 1) _page--;
    }

    void NextPage()
    {
        if (_page < TotalPages) _page++;
    }

    int TabCount(string key) => key switch
    {
        "priority" => CriticalRows.Count(),
        "markets" => _rows.Count(r => r.MarketCount > 0 || IsReview(r)),
        "quoted" => _rows.Count(IsQuoted),
        "bind" => _rows.Count(r => IsQuoted(r) || (r.QuoteCount > 0 && !IsBound(r) && !IsDeclined(r))),
        "declined" => _rows.Count(IsDeclined),
        "producer" => _rows.Select(r => Safe(r.AssignedToUserName, "Unassigned")).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
        "lob" => _rows.Select(r => Safe(r.LineOfBusiness, "Unknown")).Distinct(StringComparer.OrdinalIgnoreCase).Count(),
        _ => _rows.Count
    };

