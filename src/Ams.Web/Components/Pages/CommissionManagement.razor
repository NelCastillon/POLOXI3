@page "/commission-management"
@inject ApiClient Api

<PageTitle>Commission Management</PageTitle>
<AppPageHeader Title="Commission Management" Icon="bi-grid" />

<SfTab>
    <TabItems>
        <TabItem>
            <ChildContent><TabHeader Text="Payees"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="margin-top:12px">
                    <SfTextBox Placeholder="Search..." @bind-Value="_payeeSearch" Width="320px"></SfTextBox>
                    <SfButton CssClass="e-primary" OnClick="LoadPayeesAsync">Refresh</SfButton>
                </div>
                @if (_payees is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div> }
                else {
                <SfGrid DataSource="_payees" AllowPaging="true" AllowSorting="true" Height="420px">
                    <GridPageSettings PageSize="10"></GridPageSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(CommissionPayeeDto.PayeeTypeCode)"    HeaderText="Type"       Width="130"></GridColumn>
                        <GridColumn Field="@nameof(CommissionPayeeDto.SplitPercentage)"  HeaderText="Split %"    Width="110" Format="N2"></GridColumn>
                        <GridColumn Field="@nameof(CommissionPayeeDto.EffectiveDate)"    HeaderText="Effective"  Type="ColumnType.Date" Format="d" Width="130"></GridColumn>
                        <GridColumn Field="@nameof(CommissionPayeeDto.StatusCode)"       HeaderText="Status"     Width="120"></GridColumn>
                    </GridColumns>
                </SfGrid>
                }
            </ContentTemplate>
        </TabItem>
        <TabItem>
            <ChildContent><TabHeader Text="Transactions"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="margin-top:12px">
                    <SfTextBox Placeholder="Search..." @bind-Value="_txSearch" Width="320px"></SfTextBox>
                    <SfButton CssClass="e-primary" OnClick="LoadTransactionsAsync">Refresh</SfButton>
                </div>
                @if (_transactions is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div> }
                else {
                <SfGrid DataSource="_transactions" AllowPaging="true" AllowSorting="true" Height="420px">
                    <GridPageSettings PageSize="10"></GridPageSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(CommissionTransactionDto.TransactionDate)"   HeaderText="Date"       Type="ColumnType.Date" Format="d" Width="120"></GridColumn>
                        <GridColumn Field="@nameof(CommissionTransactionDto.SourceEntityName)"  HeaderText="Source"     Width="160"></GridColumn>
                        <GridColumn Field="@nameof(CommissionTransactionDto.GrossAmount)"       HeaderText="Gross"      Width="120" Format="C2"></GridColumn>
                        <GridColumn Field="@nameof(CommissionTransactionDto.CommissionRate)"    HeaderText="Rate %"     Width="100" Format="N2"></GridColumn>
                        <GridColumn Field="@nameof(CommissionTransactionDto.CommissionAmount)"  HeaderText="Commission" Width="130" Format="C2"></GridColumn>
                        <GridColumn Field="@nameof(CommissionTransactionDto.StatusCode)"        HeaderText="Status"     Width="120"></GridColumn>
                    </GridColumns>
                </SfGrid>
                }
            </ContentTemplate>
        </TabItem>
        <TabItem>
            <ChildContent><TabHeader Text="Payouts"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="toolbar" style="margin-top:12px">
                    <SfTextBox Placeholder="Search..." @bind-Value="_payoutSearch" Width="320px"></SfTextBox>
                    <SfButton CssClass="e-primary" OnClick="LoadPayoutsAsync">Refresh</SfButton>
                </div>
                @if (_payouts is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div> }
                else {
                <SfGrid DataSource="_payouts" AllowPaging="true" AllowSorting="true" Height="420px">
                    <GridPageSettings PageSize="10"></GridPageSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(CommissionPayoutDto.PayoutDate)"   HeaderText="Payout Date" Type="ColumnType.Date" Format="d" Width="140"></GridColumn>
                        <GridColumn Field="@nameof(CommissionPayoutDto.TotalAmount)"  HeaderText="Total"       Width="140" Format="C2"></GridColumn>
                        <GridColumn Field="@nameof(CommissionPayoutDto.StatusCode)"   HeaderText="Status"      Width="120"></GridColumn>
                        <GridColumn Field="@nameof(CommissionPayoutDto.ProcessedDateUtc)" HeaderText="Processed" Type="ColumnType.DateTime" Format="d" Width="140"></GridColumn>
                        <GridColumn Field="@nameof(CommissionPayoutDto.Notes)"        HeaderText="Notes"       Width="280"></GridColumn>
                    </GridColumns>
                </SfGrid>
                }
            </ContentTemplate>
        </TabItem>
    </TabItems>
</SfTab>

@code {
    private readonly Guid _tenantId = Guid.Parse("00000000-0000-0000-0000-000000000001");
    private string? _payeeSearch, _txSearch, _payoutSearch;
    private List<CommissionPayeeDto>? _payees;
    private List<CommissionTransactionDto>? _transactions;
    private List<CommissionPayoutDto>? _payouts;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadPayeesAsync(), LoadTransactionsAsync(), LoadPayoutsAsync());
    }

    private async Task LoadPayeesAsync()
    {
        var r = await Api.SearchCommissionPayeesAsync(_tenantId, _payeeSearch);
        _payees = r?.Items.ToList() ?? [];
    }

    private async Task LoadTransactionsAsync()
    {
        var r = await Api.SearchCommissionTransactionsAsync(_tenantId, _txSearch);
        _transactions = r?.Items.ToList() ?? [];
    }

    private async Task LoadPayoutsAsync()
    {
        var r = await Api.SearchCommissionPayoutsAsync(_tenantId, _payoutSearch);
        _payouts = r?.Items.ToList() ?? [];
    }
}
