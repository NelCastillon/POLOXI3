@namespace Ams.Web.Components.Pages
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Subscription & Tenant Settings — AMS</PageTitle>

<AppPageHeader Title="Subscription & Tenant Settings"
               Subtitle="Tenant admin control center for subscription, feature entitlement, usage limits, storage, seats, billing contact, preferences, branding, notifications, and support"
               Icon="bi-gear-wide-connected">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="ResetFilters">
            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Reset
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/tenant/subscription")'>
            <i class="bi bi-card-checklist" aria-hidden="true"></i> Subscription Overview
        </button>
    </Actions>
</AppPageHeader>

<section class="tenant-hero" aria-label="Subscription and tenant settings overview">
    <div>
        <span class="tenant-eyebrow">Tenant administration</span>
        <h2>Subscription & Tenant Settings</h2>
        <p>Govern subscription status, entitled features, tenant usage, storage, seats, billing contact, preferences, branding, notification policy, and support readiness.</p>
    </div>
    <div class="tenant-hero-grid">
        @foreach (var action in _quickActions)
        {
            <button class="tenant-quick-action" @onclick="() => Nav.NavigateTo(action.Url)">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Label</span>
            </button>
        }
    </div>
</section>

<section class="tenant-kpi-grid" aria-label="Subscription and tenant settings metrics">
    @Kpi("Plan", "Enterprise", "Active subscription", "bi-award", "tenant-tone-blue")
    @Kpi("Usage", "72%", "Average entitlement use", "bi-speedometer", "tenant-tone-amber")
    @Kpi("Seats", "184 / 250", "Licensed users", "bi-people", "tenant-tone-green")
    @Kpi("Support", "2 Open", "Active support cases", "bi-question-circle", "tenant-tone-red")
</section>

<section class="tenant-command-bar" aria-label="Tenant settings filters">
    <div class="tenant-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search"
               placeholder="Search subscription, settings, owner, control, module..."
               @bind="_search"
               @bind:event="oninput" />
    </div>
    <div class="tenant-pill-group" role="group" aria-label="Tenant settings filter">
        @foreach (var filter in _filters)
        {
            <button class="tenant-pill @(_filter == filter.Key ? "tenant-pill--active" : "")"
                    @onclick="() => _filter = filter.Key">
                @filter.Label
                <span>@FilterCount(filter.Key)</span>
            </button>
        }
    </div>
</section>

<SubscriptionSettingsWorkflowManager PageCode="@PageCode"
                                     Label="@WorkflowLabel"
                                     DefaultStage="@DefaultStage"
                                     DefaultCategory="@DefaultCategory" />

<SubscriptionConfigManager Kind="@ConfigKind"
                           Title="@ConfigTitle"
                           Subtitle="@ConfigSubtitle"
                           Icon="@ConfigIcon" />

<section class="tenant-module-grid" aria-label="Subscription and tenant settings modules">
    @foreach (var module in _modules)
    {
        <button class="tenant-module-card" @onclick="() => Nav.NavigateTo(module.Url)">
            <span class="tenant-module-icon @ToneCss(module.Domain)"><i class="bi @module.Icon" aria-hidden="true"></i></span>
            <span class="tenant-module-content">
                <strong>@module.Title</strong>
                <small>@module.Description</small>
            </span>
            <i class="bi bi-chevron-right tenant-module-arrow" aria-hidden="true"></i>
        </button>
    }
</section>

@code {
    [Parameter, EditorRequired] public string PageCode { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string WorkflowLabel { get; set; } = string.Empty;
    [Parameter] public string DefaultStage { get; set; } = "Open";
    [Parameter] public string DefaultCategory { get; set; } = "General";
    [Parameter, EditorRequired] public string ConfigKind { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ConfigTitle { get; set; } = string.Empty;
    [Parameter] public string ConfigSubtitle { get; set; } = "Manage subscription settings";
    [Parameter] public string ConfigIcon { get; set; } = "bi bi-card-checklist";

    private string _search = string.Empty;
    private string _filter = string.Empty;

    private readonly Filter[] _filters =
    [
        new("", "All"),
        new("risk", "High Risk"),
        new("subscription", "Subscription"),
        new("usage", "Usage"),
        new("settings", "Settings")
    ];

    private readonly TenantModule[] _modules =
    [
        new("Subscription Overview", "Review plan, status, renewal type, billing cycle, and subscription health.", "/tenant/subscription", "bi-card-checklist", "Subscription"),
        new("Enabled Features", "Manage tenant feature flags, add-ons, module entitlements, and rollout state.", "/tenant/subscription/features", "bi-toggles", "Entitlement"),
        new("Usage & Limits", "Monitor API, workflow, document, communications, and automation quotas.", "/tenant/subscription/usage", "bi-speedometer", "Usage"),
        new("Storage Usage", "Review document storage, attachments, retention footprint, and growth trend.", "/tenant/subscription/storage", "bi-hdd", "Usage"),
        new("Seat Usage", "Track licensed users, active seats, pending invites, and role distribution.", "/tenant/subscription/seats", "bi-people", "Seats"),
        new("Billing Contact", "Maintain billing contact, invoice delivery, payment owner, and renewal notices.", "/tenant/subscription/billing", "bi-credit-card", "Subscription"),
        new("Tenant Preferences", "Configure locale, fiscal year, timezone, defaults, and operational preferences.", "/tenant/settings/preferences", "bi-sliders", "Settings"),
        new("Notification Settings", "Control tenant notification channels, routing, digests, and escalation rules.", "/tenant/settings/notifications", "bi-bell-gear", "Notifications"),
        new("Tenant Branding", "Manage logo, colors, portal theme, email brand, and white-label identity.", "/tenant/settings/branding", "bi-palette", "Branding"),
        new("Support", "Open support cases, review SLA, environment status, and escalation contacts.", "/tenant/support", "bi-question-circle", "Support")
    ];

    private readonly TenantModule[] _quickActions =
    [
        new("Features", "", "/tenant/subscription/features", "bi-toggles", "Entitlement"),
        new("Usage", "", "/tenant/subscription/usage", "bi-speedometer", "Usage"),
        new("Seats", "", "/tenant/subscription/seats", "bi-people", "Seats"),
        new("Support", "", "/tenant/support", "bi-question-circle", "Support")
    ];

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home", "/"), new("Subscription & Settings", "/tenant/subscription"));
    }

    private void ResetFilters()
    {
        _search = string.Empty;
        _filter = string.Empty;
    }

    private int FilterCount(string key) => key switch
    {
        "subscription" => 2,
        "usage" => 3,
        "settings" => 4,
        _ => _modules.Length
    };

    private static string ToneCss(string domain) => domain switch
    {
        "Subscription" => "tenant-tone-blue",
        "Entitlement" => "tenant-tone-violet",
        "Usage" => "tenant-tone-amber",
        "Seats" => "tenant-tone-green",
        "Settings" => "tenant-tone-cyan",
        "Branding" => "tenant-tone-violet",
        "Notifications" => "tenant-tone-red",
        "Support" => "tenant-tone-red",
        _ => "tenant-tone-neutral"
    };

    private static string RiskCss(string risk) => risk switch
    {
        "High" => "tenant-status-high",
        "Medium" => "tenant-status-medium",
        _ => "tenant-status-low"
    };

    private RenderFragment Kpi(string label, string value, string meta, string icon, string tone) => @<article class="tenant-kpi-card">
        <span class="tenant-kpi-icon @tone"><i class="bi @icon" aria-hidden="true"></i></span>
        <div>
            <strong>@value</strong>
            <span>@label</span>
            <small>@meta</small>
        </div>
    </article>;

    private sealed record Filter(string Key, string Label);
    private sealed record TenantModule(string Title, string Description, string Url, string Icon, string Domain)
    {
        public string Label => Title;
    }

}
