    // -- Helpers --------------------------------------------------
    static string AiClassify(DocumentDto d)
    {
        if (!string.IsNullOrEmpty(d.CategoryCode)) return d.CategoryCode;
        var n = (d.FileName ?? "").ToLowerInvariant();
        if (n.Contains("acord") || n.Contains("form"))  return "ACORD Form";
        if (n.Contains("policy")|| n.Contains("dec"))   return "Policy / Dec Page";
        if (n.Contains("claim") || n.Contains("fnol"))  return "Claim Document";
        if (n.Contains("cert")  || n.Contains("coi"))   return "Certificate";
        if (n.Contains("endorse")|| n.Contains("endo")) return "Endorsement";
        if (n.Contains("invoice")|| n.Contains("bill")) return "Billing";
        if (n.Contains("proposal"))                     return "Proposal";
        return "Unclassified";
    }

    static int AiConfidence(DocumentDto d)
    {
        if (!string.IsNullOrEmpty(d.CategoryCode)) return 98;
        var n = (d.FileName ?? "").ToLowerInvariant();
        return (n.Contains("acord") || n.Contains("policy") || n.Contains("cert")) ? 87 : 61;
    }

    static bool IsAcord(DocumentDto d)  => (d.FileName ?? "").ToLowerInvariant().Contains("acord") || (d.DocumentTypeCode ?? "").ToLowerInvariant().Contains("acord");
    static bool NeedsESign(DocumentDto d) => IsAcord(d) || (d.DocumentTypeCode ?? "").ToLowerInvariant().Contains("contract");

    static IEnumerable<string> SuggestTags(DocumentDto d)
    {
        var tags = new List<string>();
        if (IsAcord(d))    tags.Add("ACORD");
        if (NeedsESign(d)) tags.Add("needs-esign");
        if (!string.IsNullOrWhiteSpace(d.EntityName)) tags.Add(d.EntityName);
        if (!string.IsNullOrWhiteSpace(d.Tags)) return tags;
        tags.Add("auto-tagged");
        return tags;
    }

    void ApplyAiClassification(DocumentDto d)
    {
        _metaReq.DocumentId = d.DocumentId;
        _metaReq.Tags = string.Join(", ", SuggestTags(d));
        _showMeta = true;
    }

    static string DocIcon(string? mime) => mime?.ToLowerInvariant() switch
    {
        var m when m?.Contains("pdf")   == true => "bi-file-earmark-pdf",
        var m when m?.Contains("word")  == true ||
                   m?.Contains("docx")  == true => "bi-file-earmark-word",
        var m when m?.Contains("excel") == true ||
                   m?.Contains("xlsx")  == true => "bi-file-earmark-excel",
        var m when m?.Contains("image") == true => "bi-file-earmark-image",
        _                                        => "bi-file-earmark"
    };

    static string FormatSize(long? bytes) => bytes switch
    {
        null          => "?",
        < 1024        => $"{bytes} B",
        < 1048576     => $"{bytes / 1024.0:F1} KB",
        < 1073741824  => $"{bytes / 1048576.0:F1} MB",
        _             => $"{bytes / 1073741824.0:F2} GB"
    };

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }

