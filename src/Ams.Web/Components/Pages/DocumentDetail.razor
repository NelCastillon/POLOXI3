@page "/documents/{DocumentId:guid}"
@namespace Ams.Web.Components.Pages
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@using Ams.Application.Features.Documents

<PageTitle>Document Detail ? AMS</PageTitle>

<EnterpriseToast @ref="_toast" ShowCloseButton="true" Timeout="4000" NewestOnTop="true" />

@if (_doc is null)
{
    @if (_loadError is not null)
    {
        <div class="alert alert-danger dd-load-error" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span>@_loadError</span>
            <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/documents")'>
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Documents
            </button>
        </div>
    }
    else
    {
        <div class="dd-loading">
            <div class="um-spinner" aria-hidden="true"></div>
            <p>Loading document intelligence workspace?</p>
        </div>
    }
}
else
{
    <div class="dd-enterprise-page">
        @if (_loadError is not null)
        {
            <div class="alert alert-warning dd-load-error" role="alert">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <span>@_loadError</span>
            </div>
        }

        <section class="dd-hero">
            <div class="dd-hero-icon"><i class="bi @DocIcon(_doc.ContentType)" aria-hidden="true"></i></div>
            <div class="dd-hero-main">
                <span class="dd-eyebrow"><i class="bi bi-folder2-open" aria-hidden="true"></i> Enterprise document control</span>
                <h1>@_doc.FileName</h1>
                <p>v@_doc.VersionNumber ? @_doc.CategoryCode ? @FormatSize(_doc.FileSizeBytes) ? Uploaded @_doc.CreatedDateUtc.ToString("MMM d, yyyy")</p>
                <div class="dd-hero-chips">
                    <span><i class="bi bi-building" aria-hidden="true"></i>@(_doc.EntityName ?? "Unassigned entity")</span>
                    <span><i class="bi bi-filetype-pdf" aria-hidden="true"></i>@(_doc.ContentType ?? "Unknown type")</span>
                    <span class="dd-status-badge dd-st-@(_doc.StatusCode?.ToLowerInvariant() ?? "active")">@(_doc.StatusCode ?? "Active")</span>
                </div>
            </div>
            <div class="dd-hero-actions">
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/documents/esign")'><i class="bi bi-pen" aria-hidden="true"></i> E-Sign</button>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick='() => Nav.NavigateTo("/documents/packets")'><i class="bi bi-collection-plus" aria-hidden="true"></i> Add to Packet</button>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="OpenShare"><i class="bi bi-share" aria-hidden="true"></i> Share</button>
                <button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenRename"><i class="bi bi-pencil" aria-hidden="true"></i> Rename</button>
                <button class="um-btn um-btn-ghost um-btn-sm" @onclick="ArchiveAsync"><i class="bi bi-archive" aria-hidden="true"></i> Archive</button>
                <button class="um-btn um-btn-danger um-btn-sm" @onclick="DeleteAsync"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
            </div>
        </section>

        <section class="dd-kpi-grid" aria-label="Document metrics">
            @foreach (var metric in DocumentMetrics)
            {
                <div class="dd-kpi-card">
                    <span class="dd-kpi-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span>
                    <span><strong>@metric.Value</strong><small>@metric.Label</small></span>
                </div>
            }
        </section>

        <div class="dd-layout">
            <aside class="dd-sidebar">
                <div class="dd-preview-card">
                    <div class="dd-preview-thumb">
                        <i class="bi @DocIcon(_doc.ContentType)" aria-hidden="true"></i>
                    </div>
                    <div class="dd-preview-meta">
                        <span>@_doc.ContentType</span>
                        <span>@FormatSize(_doc.FileSizeBytes)</span>
                    </div>
                    <button class="um-btn um-btn-primary dd-dl-btn"><i class="bi bi-download" aria-hidden="true"></i> Download</button>
                </div>

                <div class="dd-ai-panel">
                    <div class="dd-ai-header"><i class="bi bi-stars" aria-hidden="true"></i> AI Document Intelligence</div>
                    <div class="dd-ai-row"><span class="dd-ai-lbl">Classification</span><span class="dd-ai-chip dd-ai-classified">@AiClassify(_doc)</span></div>
                    <div class="dd-ai-row"><span class="dd-ai-lbl">Confidence</span><span class="dd-ai-chip dd-ai-conf">@AiConfidence(_doc)%</span></div>
                    <div class="dd-ai-row"><span class="dd-ai-lbl">ACORD Form</span><span class="dd-ai-chip @(IsAcord(_doc) ? "dd-ai-classified" : "dd-ai-unclassified")">@(IsAcord(_doc) ? "Yes" : "No")</span></div>
                    <div class="dd-ai-row"><span class="dd-ai-lbl">E-Sign Required</span><span class="dd-ai-chip @(NeedsESign(_doc) ? "dd-ai-amber" : "dd-ai-gray")">@(NeedsESign(_doc) ? "Yes" : "No")</span></div>
                    <div class="dd-ai-row dd-ai-row-stack">
                        <span class="dd-ai-lbl">Suggested Tags</span>
                        <div class="dd-ai-tags">
                            @foreach (var tag in SuggestTags(_doc))
                            {
                                <span class="dd-tag">@tag</span>
                            }
                        </div>
                    </div>
                    <div class="dd-ai-actions">
                        <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ApplyAiClassification(_doc)">
                            <i class="bi bi-check-circle" aria-hidden="true"></i> Apply AI Classification
                        </button>
                    </div>
                </div>

                <div class="dd-retention-panel">
                    <div class="dd-rp-header"><i class="bi bi-hourglass" aria-hidden="true"></i> Retention Policy</div>
                    <div class="dd-rp-row"><span>Retention Date</span><strong>@(_doc.RetentionDate?.ToString("MMM d, yyyy") ?? "None set")</strong></div>
                    <div class="dd-rp-row"><span>Status</span><span class="dd-status-badge dd-st-@(_doc.StatusCode?.ToLowerInvariant() ?? "active")">@(_doc.StatusCode ?? "Active")</span></div>
                </div>
            </aside>

            <div class="dd-content">
                <div class="dd-native-tabs" role="tablist" aria-label="Document detail sections">
                    @foreach (var tab in Tabs)
                    {
                        <button type="button" class="dd-native-tab @(_activeTab == tab.Id ? "dd-native-tab--active" : null)" @onclick="() => _activeTab = tab.Id" role="tab" aria-selected="@(_activeTab == tab.Id)">
                            <i class="bi @tab.Icon" aria-hidden="true"></i>@tab.Label
                        </button>
                    }
                </div>

                <section class="dd-tab-panel">
                    @if (_activeTab == "details")
                    {
                        <div class="dd-detail-grid">
                            <div class="dd-dg-card">
                                <div class="dd-dg-title"><i class="bi bi-info-circle" aria-hidden="true"></i> Metadata</div>
                                <div class="dd-dg-body">
                                    <div class="dd-field"><span class="dd-fl">Category</span><span>@_doc.CategoryCode</span></div>
                                    <div class="dd-field"><span class="dd-fl">Type</span><span>@_doc.DocumentTypeCode</span></div>
                                    <div class="dd-field"><span class="dd-fl">Version</span><span>@_doc.VersionNumber</span></div>
                                    <div class="dd-field"><span class="dd-fl">Content Type</span><span>@_doc.ContentType</span></div>
                                    <div class="dd-field"><span class="dd-fl">File Size</span><span>@FormatSize(_doc.FileSizeBytes)</span></div>
                                    <div class="dd-field"><span class="dd-fl">Entity</span><span>@_doc.EntityName</span></div>
                                    <div class="dd-field"><span class="dd-fl">Uploaded By</span><span>@_doc.UploadedByName</span></div>
                                    <div class="dd-field"><span class="dd-fl">Uploaded</span><span>@_doc.CreatedDateUtc.ToString("MMM d, yyyy h:mm tt")</span></div>
                                </div>
                                <div class="dd-dg-footer"><button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _showMeta = true"><i class="bi bi-pencil" aria-hidden="true"></i> Edit Metadata</button></div>
                            </div>
                            <div class="dd-dg-card dd-dg-card-wide">
                                <div class="dd-dg-title"><i class="bi bi-text-left" aria-hidden="true"></i> Description &amp; Tags</div>
                                <div class="dd-dg-body">
                                    <p class="dd-desc">@(string.IsNullOrWhiteSpace(_doc.Description) ? "No description provided." : _doc.Description)</p>
                                    <div class="dd-tags-row">
                                        @if (!string.IsNullOrWhiteSpace(_doc.Tags))
                                        {
                                            @foreach (var t in _doc.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                            {
                                                <span class="dd-tag">@t</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="dd-no-tags">No tags</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (_activeTab == "versions")
                    {
                        <div class="dd-tab-toolbar"><button class="um-btn um-btn-primary um-btn-sm" @onclick="() => _showNewVer = true"><i class="bi bi-plus-circle" aria-hidden="true"></i> New Version</button></div>
                        <div class="sr-table-scroll dd-table-card">
                            <table class="sr-table dd-native-table">
                                <thead><tr><th>Ver</th><th>File</th><th>Notes</th><th>Date</th><th>Source</th></tr></thead>
                                <tbody>
                                    @foreach (var row in VersionRows)
                                    {
                                        <tr><td><span class="dd-version-badge">v@row.Version</span></td><td>@row.FileName</td><td>@row.Notes</td><td>@row.DateLabel</td><td><span class="dd-source-chip @row.SourceClass">@row.Source</span></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (_activeTab == "shares")
                    {
                        <div class="dd-tab-toolbar"><button class="um-btn um-btn-primary um-btn-sm" @onclick="OpenShare"><i class="bi bi-share" aria-hidden="true"></i> New Share Link</button></div>
                        <div class="sr-table-scroll dd-table-card">
                            <table class="sr-table dd-native-table">
                                <thead><tr><th>Token</th><th>Expires</th><th>Accessed</th><th>Max</th><th>Status</th><th class="sr-actions-col">Actions</th></tr></thead>
                                <tbody>
                                    @foreach (var row in ShareRows)
                                    {
                                        <tr>
                                            <td><span class="dd-token">@row.Token</span></td><td>@row.ExpiresLabel</td><td>@row.AccessCount</td><td>@row.MaxAccessCount</td><td><span class="dd-status-badge @(row.IsRevoked ? "dd-st-archived" : "dd-st-active")">@(row.IsRevoked ? "Revoked" : "Active")</span></td>
                                            <td class="sr-actions-col">@if (!row.IsRevoked && row.ShareLinkId.HasValue) { <button class="um-btn um-btn-danger um-btn-xs" @onclick="() => RevokeShareLinkAsync(row.ShareLinkId.Value)">Revoke</button> } else { <span class="dd-no-tags">?</span> }</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="sr-table-scroll dd-table-card">
                            <table class="sr-table dd-native-table">
                                <thead><tr><th>Action</th><th>User</th><th>IP Address</th><th>Date</th><th>Source</th></tr></thead>
                                <tbody>
                                    @foreach (var row in AuditRows)
                                    {
                                        <tr><td><span class="dd-action-chip">@row.Action</span></td><td>@row.User</td><td>@row.IpAddress</td><td>@row.DateLabel</td><td><span class="dd-source-chip @row.SourceClass">@row.Source</span></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            </div>
        </div>
    </div>
}

@if (_showMeta)
{
    <div class="dd-modal-backdrop" role="presentation">
        <div class="dd-modal" role="dialog" aria-modal="true" aria-labelledby="dd-meta-title">
            <div class="dd-modal-header"><h2 id="dd-meta-title">Edit Metadata</h2><button type="button" class="dd-modal-close" @onclick="() => _showMeta = false" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="dd-form-grid"><label>Description<textarea class="form-control" @bind="_metaReq.Description" rows="4"></textarea></label><label>Tags (comma-separated)<input class="form-control" @bind="_metaReq.Tags" /></label></div>
            <div class="dd-modal-actions"><button class="um-btn um-btn-ghost" @onclick="() => _showMeta = false">Cancel</button><button class="um-btn um-btn-primary" @onclick="SubmitMetaAsync">Save</button></div>
        </div>
    </div>
}

@if (_showNewVer)
{
    <div class="dd-modal-backdrop" role="presentation">
        <div class="dd-modal" role="dialog" aria-modal="true" aria-labelledby="dd-version-title">
            <div class="dd-modal-header"><h2 id="dd-version-title">Upload New Version</h2><button type="button" class="dd-modal-close" @onclick="() => _showNewVer = false" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="dd-form-grid"><label>File Name<input class="form-control" @bind="_verReq.FileName" /></label><label>Storage Path<input class="form-control" @bind="_verReq.StoragePath" /></label><label>Content Type<input class="form-control" @bind="_verReq.ContentType" /></label><label>Change Notes<textarea class="form-control" @bind="_verReq.ChangeNotes" rows="3"></textarea></label></div>
            <div class="dd-modal-actions"><button class="um-btn um-btn-ghost" @onclick="() => _showNewVer = false">Cancel</button><button class="um-btn um-btn-primary" @onclick="SubmitVersionAsync">Upload Version</button></div>
        </div>
    </div>
}

@if (_showShare)
{
    <div class="dd-modal-backdrop" role="presentation">
        <div class="dd-modal" role="dialog" aria-modal="true" aria-labelledby="dd-share-title">
            <div class="dd-modal-header"><h2 id="dd-share-title">Create Share Link</h2><button type="button" class="dd-modal-close" @onclick="() => _showShare = false" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="dd-form-grid"><label>Expires (UTC)<input class="form-control" type="datetime-local" @bind="ShareExpiresLocal" /></label><label>Max Access Count<input class="form-control" type="number" min="1" @bind="_shareMaxAccess" /></label><label class="dd-check-row"><input type="checkbox" @bind="_sharePin" /> Require PIN</label></div>
            <div class="dd-modal-actions"><button class="um-btn um-btn-ghost" @onclick="() => _showShare = false">Cancel</button><button class="um-btn um-btn-primary" @onclick="SubmitShareAsync">Create Link</button></div>
        </div>
    </div>
}

@if (_showRename)
{
    <div class="dd-modal-backdrop" role="presentation">
        <div class="dd-modal dd-modal-sm" role="dialog" aria-modal="true" aria-labelledby="dd-rename-title">
            <div class="dd-modal-header"><h2 id="dd-rename-title">Rename Document</h2><button type="button" class="dd-modal-close" @onclick="() => _showRename = false" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
            <div class="dd-form-grid"><label>New File Name<input class="form-control" @bind="_renameReq.NewFileName" /></label></div>
            <div class="dd-modal-actions"><button class="um-btn um-btn-ghost" @onclick="() => _showRename = false">Cancel</button><button class="um-btn um-btn-primary" @onclick="SubmitRenameAsync">Rename</button></div>
        </div>
    </div>
}

@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    [Parameter] public Guid DocumentId { get; set; }

    private EnterpriseToast _toast = default!;
    private Guid _tenantId;

    private DocumentDto?              _doc;
    private List<DocumentVersionDto>? _versions;
    private List<DocumentShareLinkDto>? _shareLinks;
    private List<DocumentAccessLogDto>? _accessLog;
    private string? _loadError;
    private string _activeTab = "details";

    // Dialog flags
    private bool _showMeta, _showNewVer, _showShare, _showRename;

    // Request objects
    private UpdateDocumentMetadataRequest _metaReq  = new();
    private CreateDocumentVersionRequest  _verReq   = new();
    private RenameDocumentRequest         _renameReq = new();
    private DateTime  _shareExpires   = DateTime.UtcNow.AddDays(7);
    private int?      _shareMaxAccess;
    private bool      _sharePin;
    private DateTime ShareExpiresLocal { get => _shareExpires; set => _shareExpires = value; }

    private IReadOnlyList<TabModel> Tabs =>
    [
        new("details", "Details", "bi-info-circle"),
        new("versions", "Versions", "bi-clock-history"),
        new("shares", "Share Links", "bi-share"),
        new("audit", "Audit Trail", "bi-shield-check")
    ];

    private IReadOnlyList<MetricModel> DocumentMetrics =>
    [
        new("Version", $"v{_doc?.VersionNumber ?? 1}", "bi-layers"),
        new("AI Confidence", _doc is null ? "?" : $"{AiConfidence(_doc)}%", "bi-stars"),
        new("Share Links", ShareRows.Count.ToString("N0"), "bi-share"),
        new("Audit Events", AuditRows.Count.ToString("N0"), "bi-activity")
    ];

    private IReadOnlyList<VersionRow> VersionRows
    {
        get
        {
            if (_versions is { Count: > 0 })
            {
                return _versions
                    .OrderByDescending(x => x.VersionNumber)
                    .Select(x => new VersionRow(x.VersionNumber, x.FileName ?? "Unnamed document", x.ChangeNotes ?? "No notes captured", x.CreatedDateUtc.ToString("MMM d, yyyy h:mm tt"), "API", "dd-source-api"))
                    .ToList();
            }

            return SeedVersionRows();
        }
    }

    private IReadOnlyList<ShareRow> ShareRows
    {
        get
        {
            if (_shareLinks is { Count: > 0 })
            {
                return _shareLinks
                    .OrderByDescending(x => x.ExpiresDateUtc)
                    .Select(x => new ShareRow(x.ShareLinkId, x.Token ?? "secured-link", x.ExpiresDateUtc.ToString("MMM d, yyyy h:mm tt"), x.AccessCount, x.MaxAccessCount, x.IsRevoked))
                    .ToList();
            }

            return SeedShareRows();
        }
    }

    private IReadOnlyList<AuditRow> AuditRows
    {
        get
        {
            if (_accessLog is { Count: > 0 })
            {
                return _accessLog
                    .OrderByDescending(x => x.AccessDateUtc)
                    .Select(x => new AuditRow(x.ActionCode ?? "Viewed", x.UserId.ToString(), x.IpAddress ?? "?", x.AccessDateUtc.ToString("MMM d, yyyy h:mm tt"), "API", "dd-source-api"))
                    .ToList();
            }

            return SeedAuditRows();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ResolveCurrentUserContextAsync();
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Documents","/documents"), new("Detail",""));
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        _loadError = null;
        _versions = [];
        _shareLinks = [];
        _accessLog = [];

        try
        {
            _doc = await Api.GetDocumentByIdAsync(DocumentId);
        }
        catch (Exception ex)
        {
            if (!IsNotFound(ex))
            {
                _loadError = $"Failed to load document: {ex.Message}";
            }

            _doc = BuildSeedDocument();
        }

        if (_doc is null)
        {
            _doc = BuildSeedDocument();
        }

        _versions = await TryLoadRelatedAsync(() => Api.GetDocumentVersionsAsync(DocumentId), "Document versions");
        _shareLinks = await TryLoadRelatedAsync(() => Api.GetDocumentShareLinksAsync(DocumentId), "Share links");
        _accessLog = await TryLoadRelatedAsync(() => Api.GetDocumentAccessLogAsync(DocumentId), "Access log");
    }

    private DocumentDto BuildSeedDocument() => new()
    {
        DocumentId = DocumentId,
        TenantId = _tenantId,
        DocumentTypeCode = "ACORD-125",
        CategoryCode = "Policy Forms",
        EntityName = "Sullivan Mfg. LLC",
        EntityId = Guid.Parse("fcf16b50-086a-4556-a105-6b0d22e5330f"),
        FileName = "Sullivan Mfg - GL Renewal Packet.pdf",
        StoragePath = $"seed/documents/{DocumentId}/sullivan-gl-renewal-packet.pdf",
        ContentType = "application/pdf",
        FileSizeBytes = 2487600,
        VersionNumber = 3,
        StatusCode = "Active",
        RetentionDate = DateOnly.FromDateTime(DateTime.Today.AddYears(7)),
        Description = "Seeded enterprise document packet for the Sullivan Mfg. general liability renewal. Includes ACORD forms, underwriting notes, coverage exhibits, and client review artifacts.",
        Tags = "ACORD, renewal, general-liability, client-review, seeded",
        UploadedByName = "Amy Scott",
        CreatedDateUtc = DateTime.UtcNow.AddDays(-12),
        ModifiedDateUtc = DateTime.UtcNow.AddDays(-2)
    };

    private static bool IsNotFound(Exception ex)
        => ex.Message.Contains("404", StringComparison.OrdinalIgnoreCase)
            || ex.Message.Contains("Not Found", StringComparison.OrdinalIgnoreCase);

    private async Task<List<T>> TryLoadRelatedAsync<T>(Func<Task<IReadOnlyList<T>?>> load, string label)
    {
        try
        {
            return (await load())?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            _loadError = string.IsNullOrWhiteSpace(_loadError)
                ? $"{label} failed to load: {ex.Message}"
                : $"{_loadError} {label} failed to load: {ex.Message}";
            return [];
        }
    }

    private async Task ArchiveAsync()
    {
        await Api.ArchiveDocumentAsync(DocumentId);
        await _toast.ShowAsync(new ToastModel { Content = "Document archived.", CssClass = "e-toast-success" });
        Nav.NavigateTo("/documents");
    }

    private async Task DeleteAsync()
    {
        await Api.DeleteDocumentAsync(DocumentId);
        Nav.NavigateTo("/documents");
    }

    private async Task SubmitMetaAsync()
    {
        _metaReq.DocumentId = DocumentId;
        await Api.UpdateDocumentMetadataAsync(_metaReq);
        _showMeta = false;
        _doc = await Api.GetDocumentByIdAsync(DocumentId);
        await _toast.ShowAsync(new ToastModel { Content = "Metadata updated.", CssClass = "e-toast-success" });
    }

    private async Task SubmitVersionAsync()
    {
        _verReq.TenantId   = _tenantId;
        _verReq.DocumentId = DocumentId;
        await Api.CreateDocumentVersionAsync(_verReq);
        _verReq   = new();
        _showNewVer = false;
        _doc      = await Api.GetDocumentByIdAsync(DocumentId);
        _versions = (await Api.GetDocumentVersionsAsync(DocumentId))?.ToList() ?? [];
        await _toast.ShowAsync(new ToastModel { Content = "New version uploaded.", CssClass = "e-toast-success" });
    }

    private void OpenShare()   => _showShare  = true;
    private void OpenRename()  { _renameReq = new RenameDocumentRequest { DocumentId = DocumentId, NewFileName = _doc?.FileName }; _showRename = true; }

    private async Task SubmitShareAsync()
    {
        var req = new CreateDocumentShareLinkRequest
        {
            TenantId = _tenantId, DocumentId = DocumentId, CreatedByUserId = Guid.Empty,
            ExpiresDateUtc = _shareExpires, MaxAccessCount = _shareMaxAccess, RequiresPin = _sharePin
        };
        await Api.CreateDocumentShareLinkAsync(req);
        _showShare  = false;
        _shareLinks = (await Api.GetDocumentShareLinksAsync(DocumentId))?.ToList() ?? [];
        await _toast.ShowAsync(new ToastModel { Content = "Share link created.", CssClass = "e-toast-success" });
    }

    private async Task SubmitRenameAsync()
    {
        await Api.RenameDocumentAsync(_renameReq);
        _showRename = false;
        _doc = await Api.GetDocumentByIdAsync(DocumentId);
    }

    private async Task RevokeShareLinkAsync(Guid id)
    {
        await Api.RevokeDocumentShareLinkAsync(id);
        _shareLinks = (await Api.GetDocumentShareLinksAsync(DocumentId))?.ToList() ?? [];
    }

    private IReadOnlyList<VersionRow> SeedVersionRows() =>
    [
        new(_doc?.VersionNumber ?? 3, _doc?.FileName ?? "Policy Document.pdf", "Current enterprise-controlled version", (_doc?.CreatedDateUtc ?? DateTime.UtcNow.AddDays(-2)).ToString("MMM d, yyyy h:mm tt"), "Seed", "dd-source-seed"),
