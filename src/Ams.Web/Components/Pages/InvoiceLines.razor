@page "/billing/invoice-lines"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>Invoice Lines</PageTitle>
<AppPageHeader Title="Invoice Lines" Icon="bi-list-ul" />
<div class="toolbar">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <button class="um-btn um-btn-ghost" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
</div>
@if (_items is null) { <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading…</span></div> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(InvoiceLineDto.LineOrder)"       HeaderText="#"          Width="70"></GridColumn>
        <GridColumn Field="@nameof(InvoiceLineDto.ItemCode)"        HeaderText="Item Code"  Width="120"></GridColumn>
        <GridColumn Field="@nameof(InvoiceLineDto.Description)"     HeaderText="Description" Width="280"></GridColumn>
        <GridColumn Field="@nameof(InvoiceLineDto.Quantity)"        HeaderText="Qty"         Width="90" Format="N4"></GridColumn>
        <GridColumn Field="@nameof(InvoiceLineDto.UnitPrice)"       HeaderText="Unit Price"  Width="120" Format="C2"></GridColumn>
        <GridColumn Field="@nameof(InvoiceLineDto.DiscountPercent)" HeaderText="Disc %"      Width="90" Format="N2"></GridColumn>
        <GridColumn Field="@nameof(InvoiceLineDto.LineTotal)"       HeaderText="Line Total"  Width="130" Format="C2"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    Guid TenantId { get; set; }
    Guid TenantAdminUserId { get; set; }
    Guid DevTenantId { get; set; }
    Guid DevUserId { get; set; }
    private Guid _tenantAdminUserId;
    private Guid _tenantId;
    private string? _searchTerm;
    private List<InvoiceLineDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchInvoiceLinesAsync(_tenantId, _searchTerm);
        _items = result?.Items.ToList() ?? [];
    }

    async Task ResolveCurrentUserContextAsync()
    {
        var context = await CurrentUser.RequireAsync();
        TenantId = context.TenantId;
        TenantAdminUserId = context.UserId;
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        DevTenantId = context.TenantId;
        DevUserId = context.UserId;
    }
}
