@page "/analytics/ai-insights"
@page "/analytics/ai"
@namespace Ams.Web.Components.Pages
@inject BreadcrumbService Breadcrumbs

<PageTitle>AI Insight Center — AMS</PageTitle>

<AppPageHeader Title="AI Insight Center"
               Subtitle="Machine-generated insights across every domain — surface risks, opportunities, and anomalies before they become problems"
               Icon="bi-stars">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick="RefreshInsights">
            <i class="bi bi-arrow-clockwise @(_refreshing ? "ai-spin" : "")" aria-hidden="true"></i> Refresh
        </button>
        <button class="um-btn um-btn-primary" @onclick='() => Nav.NavigateTo("/analytics/ai-assistant")'>
            <i class="bi bi-robot" aria-hidden="true"></i> Open AI Assistant
        </button>
    </Actions>
</AppPageHeader>

<!-- Summary strip -->
<div class="ai-summary-strip">
    <div class="ai-sum-card ai-sum-card--urgent">
        <div class="ai-sum-icon"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i></div>
        <div class="ai-sum-count">@_insights.Count(i => i.Priority == "Critical")</div>
        <div class="ai-sum-lbl">Critical</div>
    </div>
    <div class="ai-sum-card ai-sum-card--high">
        <div class="ai-sum-icon"><i class="bi bi-arrow-up-circle-fill" aria-hidden="true"></i></div>
        <div class="ai-sum-count">@_insights.Count(i => i.Priority == "High")</div>
        <div class="ai-sum-lbl">High Priority</div>
    </div>
    <div class="ai-sum-card ai-sum-card--opp">
        <div class="ai-sum-icon"><i class="bi bi-lightbulb-fill" aria-hidden="true"></i></div>
        <div class="ai-sum-count">@_insights.Count(i => i.Type == "Opportunity")</div>
        <div class="ai-sum-lbl">Opportunities</div>
    </div>
    <div class="ai-sum-card ai-sum-card--risk">
        <div class="ai-sum-icon"><i class="bi bi-shield-exclamation" aria-hidden="true"></i></div>
        <div class="ai-sum-count">@_insights.Count(i => i.Type == "Risk")</div>
        <div class="ai-sum-lbl">Risks</div>
    </div>
    <div class="ai-sum-card ai-sum-card--quality">
        <div class="ai-sum-icon"><i class="bi bi-database-exclamation" aria-hidden="true"></i></div>
        <div class="ai-sum-count">@_insights.Count(i => i.Type == "Data Quality")</div>
        <div class="ai-sum-lbl">Data Quality</div>
    </div>
</div>

<!-- ── DASHBOARD LAYOUT (spec: SfDashboardLayout) ────────────────────── -->
<div class="ai-dashboard-wrap">
    <SfDashboardLayout CellSpacing="@(new double[]{8,8})" Columns="12" CellAspectRatio="2.5f"
                       AllowResizing="false" AllowDragging="false">
        <DashboardLayoutPanels>

            <!-- ① Critical / High at-a-glance -->
            <DashboardLayoutPanel Id="ai-priorities" Column="0" Row="0" SizeX="4" SizeY="1">
                <HeaderTemplate>
                    <div class="ai-dlp-hdr"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Priority Breakdown</div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="ai-dlp-body ai-dlp-priority">
                        <div class="ai-dp-row ai-dp-crit"><span class="ai-dp-lbl">Critical</span><span class="ai-dp-val">@_insights.Count(i => i.Priority == "Critical")</span></div>
                        <div class="ai-dp-row ai-dp-high"><span class="ai-dp-lbl">High</span><span class="ai-dp-val">@_insights.Count(i => i.Priority == "High")</span></div>
                        <div class="ai-dp-row ai-dp-med"><span class="ai-dp-lbl">Medium</span><span class="ai-dp-val">@_insights.Count(i => i.Priority == "Medium")</span></div>
                        <div class="ai-dp-row ai-dp-low"><span class="ai-dp-lbl">Low</span><span class="ai-dp-val">@_insights.Count(i => i.Priority == "Low")</span></div>
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <!-- ② Type distribution -->
            <DashboardLayoutPanel Id="ai-types" Column="4" Row="0" SizeX="4" SizeY="1">
                <HeaderTemplate>
                    <div class="ai-dlp-hdr"><i class="bi bi-pie-chart" aria-hidden="true"></i> Insight Types</div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="ai-dlp-body ai-dlp-types">
                        @foreach (var t in new[]{ ("Risk","bi-shield-exclamation","ai-t-risk"), ("Opportunity","bi-lightbulb","ai-t-opp"), ("Anomaly","bi-activity","ai-t-anom"), ("Data Quality","bi-database-exclamation","ai-t-dq") })
                        {
                            <div class="ai-type-row @t.Item3">
                                <i class="bi @t.Item2" aria-hidden="true"></i>
                                <span>@t.Item1</span>
                                <span class="ai-type-cnt">@_insights.Count(i => i.Type == t.Item1)</span>
                            </div>
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>

            <!-- ③ Domain heatmap -->
            <DashboardLayoutPanel Id="ai-domains" Column="8" Row="0" SizeX="4" SizeY="1">
                <HeaderTemplate>
                    <div class="ai-dlp-hdr"><i class="bi bi-grid-3x3" aria-hidden="true"></i> Domains</div>
                </HeaderTemplate>
                <ContentTemplate>
                    <div class="ai-dlp-body ai-dlp-domains">
                        @foreach (var d in new[]{ "Retention","Sales","Claims","Finance","Service","Marketing","Data Quality" })
                        {
                            var cnt = _insights.Count(i => i.Domain == d && !i.Dismissed);
                            @if (cnt > 0)
                            {
                                <div class="ai-dom-chip ai-dom-@(cnt >= 2 ? "hot" : "warm")" @onclick="() => { _domainFilter = d; }">
                                    <span class="ai-dom-lbl">@d</span><span class="ai-dom-cnt">@cnt</span>
                                </div>
                            }
                        }
                    </div>
                </ContentTemplate>
            </DashboardLayoutPanel>

        </DashboardLayoutPanels>
    </SfDashboardLayout>
</div>

<!-- Filter bar -->
<div class="ai-filter-bar">
    <div class="ai-search-wrap">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input class="ai-search" placeholder="Search insights…" @bind="_search" @bind:event="oninput" />
    </div>
    <select class="ai-sel" @bind="_domainFilter">
        <option value="">All Domains</option>
        <option value="Retention">Retention</option>
        <option value="Sales">Sales</option>
        <option value="Claims">Claims</option>
        <option value="Finance">Finance</option>
        <option value="Service">Service</option>
        <option value="Data Quality">Data Quality</option>
        <option value="Marketing">Marketing</option>
    </select>
    <select class="ai-sel" @bind="_typeFilter">
        <option value="">All Types</option>
        <option value="Risk">Risk</option>
        <option value="Opportunity">Opportunity</option>
        <option value="Anomaly">Anomaly</option>
        <option value="Data Quality">Data Quality</option>
    </select>
    <select class="ai-sel" @bind="_priorityFilter">
        <option value="">All Priorities</option>
        <option value="Critical">Critical</option>
        <option value="High">High</option>
        <option value="Medium">Medium</option>
        <option value="Low">Low</option>
    </select>
    <label class="ai-dismissed-toggle">
        <input type="checkbox" @bind="_showDismissed" /> Show dismissed
    </label>
</div>

<!-- Insight cards -->
<div class="ai-insight-list">
    @foreach (var ins in Filtered)
    {
        <div class="ai-insight-card @TypeCss(ins.Type) @(ins.Dismissed ? "ai-ins-dismissed" : "")">
            <div class="ai-ins-hdr">
                <div class="ai-ins-icon @PriorityCss(ins.Priority)"><i class="bi @TypeIcon(ins.Type)" aria-hidden="true"></i></div>
                <div class="ai-ins-meta">
                    <div class="ai-ins-title">@ins.Title</div>
                    <div class="ai-ins-tags">
                        <span class="@PriorityBadge(ins.Priority)">@ins.Priority</span>
                        <span class="@TypeBadge(ins.Type)">@ins.Type</span>
                        <span class="ai-domain-badge">@ins.Domain</span>
                        <span class="ai-conf">@ins.Confidence% confidence</span>
                    </div>
                </div>
                <div class="ai-ins-actions ms-auto">
                    @if (!ins.Dismissed)
                    {
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => CreateTask(ins)" title="Create task"><i class="bi bi-check2-square" aria-hidden="true"></i></button>
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => ins.Dismissed = true" title="Dismiss"><i class="bi bi-x" aria-hidden="true"></i></button>
                    }
                    else
                    {
                        <button class="um-btn um-btn-ghost um-btn-xs" @onclick="() => ins.Dismissed = false" title="Restore"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                    }
                </div>
            </div>

            <div class="ai-ins-body">@ins.Summary</div>

            @if (ins.AffectedEntities.Length > 0)
            {
                <div class="ai-ins-entities">
                    <span class="ai-ent-lbl">Affected:</span>
                    @foreach (var e in ins.AffectedEntities)
                    {
                        <span class="ai-ent-chip">@e</span>
                    }
                </div>
            }

            <div class="ai-ins-rec">
                <i class="bi bi-lightbulb ai-rec-icon" aria-hidden="true"></i>
                <span>@ins.Recommendation</span>
            </div>

            <div class="ai-ins-footer">
                <span class="ai-ins-ts"><i class="bi bi-clock" aria-hidden="true"></i> @ins.GeneratedAt.ToString("MMM d, h:mm tt")</span>
                @if (ins.TaskCreated) { <span class="ai-task-chip"><i class="bi bi-check2-circle" aria-hidden="true"></i> Task created</span> }
            </div>
        </div>
    }
    @if (!Filtered.Any())
    {
        <div class="ai-empty"><i class="bi bi-stars" aria-hidden="true"></i><span>No insights match the current filters.</span></div>
    }
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private string _search = string.Empty;
    private string _domainFilter = string.Empty;
    private string _typeFilter = string.Empty;
    private string _priorityFilter = string.Empty;
    private bool _showDismissed;
    private bool _refreshing;

    private List<InsightCard> _insights = [];

    private IEnumerable<InsightCard> Filtered => _insights.Where(i =>
        (_showDismissed || !i.Dismissed) &&
        (string.IsNullOrEmpty(_search) || i.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) || i.Summary.Contains(_search, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_domainFilter) || i.Domain == _domainFilter) &&
        (string.IsNullOrEmpty(_typeFilter) || i.Type == _typeFilter) &&
        (string.IsNullOrEmpty(_priorityFilter) || i.Priority == _priorityFilter));

    protected override void OnInitialized()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Analytics","/analytics/reports"), new("AI Insight Center",""));
        LoadInsights();
    }

    private void LoadInsights()
    {
        _insights =
        [
            new InsightCard
            {
                Id=1, Domain="Retention", Type="Risk", Priority="Critical", Confidence=94,
                Title="17 accounts at high renewal risk — $312K premium at stake",
                Summary="AI detected 17 accounts with a combination of no recent engagement (>45 days), open service complaints, and price increases >15%. Historical data shows accounts with this pattern churn at 68% in the next 30 days.",
                AffectedEntities=["Apex Logistics LLC","Riverside Dental Group","Castillo Auto Group","+14 more"],
                Recommendation="Assign proactive outreach tasks to each account's producer. Prioritize accounts with active service complaints — resolving them before renewal increases retention probability by 34%.",
                GeneratedAt=DateTime.Now.AddMinutes(-18)
            },
            new InsightCard
            {
                Id=2, Domain="Sales", Type="Opportunity", Priority="High", Confidence=88,
                Title="Cross-sell opportunity: 84 BOP-only accounts eligible for umbrella",
                Summary="84 commercial accounts have BOP coverage but no umbrella policy. Based on LOB profile and revenue band, AI projects 60–70% are likely to accept an umbrella quote if presented within the next renewal cycle.",
                AffectedEntities=["84 BOP accounts"],
                Recommendation="Generate a targeted cross-sell campaign for these accounts. Estimated premium uplift: $168K. Assign to producers with highest BOP cross-sell conversion history.",
                GeneratedAt=DateTime.Now.AddMinutes(-42)
            },
            new InsightCard
            {
                Id=3, Domain="Claims", Type="Anomaly", Priority="High", Confidence=91,
                Title="Loss ratio spike detected in Workers Comp — 14% above 6-month average",
                Summary="Workers Comp loss ratio hit 74% in the last 30 days vs a 6-month average of 60%. Cluster analysis shows 4 accounts in the construction segment account for 62% of the increase. This may indicate a safety or classification issue.",
                AffectedEntities=["Ortega Construction","Bautista Framing","Rivera Roofing LLC","Mesa Contractors"],
                Recommendation="Conduct a loss control review on these 4 accounts before their next renewal. Consider classification audit and risk engineering visit. Notify carrier underwriter.",
                GeneratedAt=DateTime.Now.AddMinutes(-71)
            },
            new InsightCard
            {
                Id=4, Domain="Finance", Type="Anomaly", Priority="High", Confidence=87,
                Title="3 commission statements unreconciled for 45+ days — $28K exposure",
                Summary="Three commission statements received from carriers in March have not been matched to internal policy records. Combined value: $28,300. Unreconciled statements beyond 60 days may be forfeited under carrier agreements.",
                AffectedEntities=["Acme Casualty Statement #AC-20250312","Guardian Specialty #GS-20250314","Midland Re #MR-20250318"],
                Recommendation="Assign to accounting team for immediate reconciliation. Escalate to carrier contacts if unable to match within 5 business days.",
                GeneratedAt=DateTime.Now.AddHours(-2.5)
            },
            new InsightCard
            {
                Id=5, Domain="Service", Type="Risk", Priority="Medium", Confidence=82,
                Title="COI processing bottleneck — average 51h vs 24h SLA target",
                Summary="Certificate of Insurance requests are averaging 51 hours to fulfill this month, more than double the 24-hour SLA target. Root cause: 2 of 3 CSRs handling COI requests have caseloads >120% capacity.",
                AffectedEntities=["Lisa Park (141% capacity)","Marcus Webb (128% capacity)"],
                Recommendation="Redistribute COI requests to available CSRs. Consider temporary delegation to senior producers for simple certificates. Review and potentially update COI SLA target if structurally unachievable.",
                GeneratedAt=DateTime.Now.AddHours(-4)
            },
            new InsightCard
            {
                Id=6, Domain="Data Quality", Type="Data Quality", Priority="Medium", Confidence=96,
                Title="214 account records missing primary contact email address",
                Summary="214 active account records have no primary contact email, which blocks automated renewal notices, campaign delivery, and portal invitations. These accounts collectively represent $840K in annual premium.",
                AffectedEntities=["214 accounts — $840K premium"],
                Recommendation="Run the data quality enrichment workflow to source email addresses from prior correspondence and documents. Assign remaining gaps to producers for manual update during next touch.",
                GeneratedAt=DateTime.Now.AddHours(-6)
            },
            new InsightCard
            {
                Id=7, Domain="Marketing", Type="Opportunity", Priority="Medium", Confidence=79,
                Title="Win-back opportunity: 38 lapsed accounts from prior 24 months",
                Summary="38 accounts that cancelled in the last 24 months show signs of renewed interest — portal password resets, opened email campaigns, or LinkedIn engagement. Average lapsed premium was $14,200.",
                AffectedEntities=["38 lapsed accounts"],
                Recommendation="Launch a personalized win-back sequence. Lead with a competitive re-quote and coverage gap analysis. Accounts that lapsed due to price have 42% win-back probability; those lost to service have 28%.",
                GeneratedAt=DateTime.Now.AddHours(-9)
            },
            new InsightCard
            {
                Id=8, Domain="Retention", Type="Opportunity", Priority="Low", Confidence=76,
                Title="12 long-tenured accounts have not had a coverage review in 3+ years",
                Summary="12 accounts with 5+ year tenure and $380K combined premium have had no formal coverage review documented in 3+ years. These accounts may be underinsured and represent risk for E&O exposure as well as a sales opportunity.",
                AffectedEntities=["12 accounts — $380K premium"],
                Recommendation="Schedule annual account reviews for all 12. Prioritize accounts with business growth indicators (e.g., increased revenue, new locations). Coverage review meetings have a 55% upsell close rate.",
                GeneratedAt=DateTime.Now.AddHours(-14)
            },
        ];
    }

    private async Task RefreshInsights()
    {
        _refreshing = true;
        await Task.Delay(1200);
        foreach (var ins in _insights) ins.GeneratedAt = DateTime.Now.AddMinutes(-Random.Shared.Next(1, 30));
        _refreshing = false;
    }

    private void CreateTask(InsightCard ins) => ins.TaskCreated = true;

    private static string TypeCss(string t) => t switch { "Risk"=>"ai-ins-risk","Opportunity"=>"ai-ins-opp","Anomaly"=>"ai-ins-anomaly","Data Quality"=>"ai-ins-dq",_=>"" };
    private static string TypeIcon(string t) => t switch { "Risk"=>"bi-shield-exclamation","Opportunity"=>"bi-lightbulb","Anomaly"=>"bi-exclamation-circle","Data Quality"=>"bi-database-exclamation",_=>"bi-stars" };
    private static string PriorityCss(string p)   => p switch { "Critical"=>"ai-picon-crit","High"=>"ai-picon-high","Medium"=>"ai-picon-med",_=>"ai-picon-low" };
    private static string PriorityBadge(string p)  => p switch { "Critical"=>"ai-pri ai-pri--crit","High"=>"ai-pri ai-pri--high","Medium"=>"ai-pri ai-pri--med",_=>"ai-pri ai-pri--low" };
    private static string TypeBadge(string t)      => t switch { "Risk"=>"ai-typ ai-typ--risk","Opportunity"=>"ai-typ ai-typ--opp","Anomaly"=>"ai-typ ai-typ--anomaly",_=>"ai-typ ai-typ--dq" };

    private sealed class InsightCard
    {
        public int      Id              { get; set; }
        public string   Domain          { get; set; } = string.Empty;
        public string   Type            { get; set; } = string.Empty;
        public string   Priority        { get; set; } = string.Empty;
        public int      Confidence      { get; set; }
        public string   Title           { get; set; } = string.Empty;
        public string   Summary         { get; set; } = string.Empty;
        public string[] AffectedEntities{ get; set; } = [];
        public string   Recommendation  { get; set; } = string.Empty;
        public DateTime GeneratedAt     { get; set; }
        public bool     Dismissed       { get; set; }
        public bool     TaskCreated     { get; set; }
    }
}
