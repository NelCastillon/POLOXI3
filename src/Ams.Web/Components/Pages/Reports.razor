@page "/platform/reports"
@page "/reports"
@inject ApiClient Api
@inject CurrentUserContext CurrentUser
@inject IJSRuntime Js

<PageTitle>Reports</PageTitle>

<AppPageHeader Title="Report Definitions"
               Subtitle="View, run, and export DB-backed report definitions with actual in-page report previews."
               Icon="bi-bar-chart-line">
    <Actions>
        <button class="um-btn um-btn-ghost" type="button" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</button>
        <button class="um-btn um-btn-primary" type="button" @onclick="ExportVisibleAsync" disabled="@(!_filtered.Any() || _busy)"><i class="bi bi-download" aria-hidden="true"></i> Export View</button>
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="pr-toast @_toastClass" role="status">
        <i class="bi @(_toastClass == "pr-toast--danger" ? "bi-exclamation-triangle" : "bi-check-circle")" aria-hidden="true"></i>
        <span>@_toastMessage</span>
        <button type="button" class="pr-toast-close" @onclick="ClearToast" aria-label="Dismiss message"><i class="bi bi-x-lg"></i></button>
    </div>
}

<div class="pr-page">
    <section class="pr-hero">
        <div>
            <div class="pr-eyebrow"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i> Reporting catalog</div>
            <h2>@_reports.Count.ToString("N0") report definitions</h2>
            <p>Open an actual preview of any report, review generated rows, run audited executions, and download Excel outputs without leaving the page.</p>
        </div>
        <div class="pr-hero-panel">
            <span>Report readiness</span>
            <strong>@ReadinessScore%</strong>
            <div class="pr-score-track"><div style="width:@ReadinessScore%"></div></div>
            <small>@ReadinessSummary</small>
        </div>
    </section>

    <section class="pr-kpi-strip" aria-label="Report KPI filters">
        @foreach (var kpi in Kpis)
        {
            <button type="button" class="pr-kpi-card @(IsActiveFilter(kpi.Key) ? "pr-kpi-card--active" : null)" title="@kpi.Tooltip" @onclick="() => SetFilter(kpi.Key)">
                <span class="pr-kpi-icon"><i class="bi @kpi.Icon" aria-hidden="true"></i></span>
                <span class="pr-kpi-label">@kpi.Label</span>
                <strong>@kpi.Value</strong>
                <small>@kpi.Detail</small>
            </button>
        }
    </section>

    <section class="pr-command-bar">
        <div class="pr-search-wrap">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input class="pr-search" placeholder="Search reports, modules, types, formats, or descriptions..." @bind="_searchTerm" @bind:event="oninput" @bind:after="ApplyFilter" />
        </div>
        <select class="pr-select" @bind="_moduleFilter" @bind:after="ApplyFilter">
            <option value="">All modules</option>
            @foreach (var module in Modules)
            {
                <option value="@module">@module</option>
            }
        </select>
        <select class="pr-select" @bind="_formatFilter" @bind:after="ApplyFilter">
            <option value="">All formats</option>
            <option value="PDF">PDF</option>
            <option value="Excel">Excel</option>
            <option value="CSV">CSV</option>
        </select>
        <button class="um-btn um-btn-ghost" type="button" @onclick="ResetFilters"><i class="bi bi-x-lg" aria-hidden="true"></i> Clear</button>
    </section>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="alert alert-danger pr-load-error" role="alert"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_loadError</div>
    }

    <section class="pr-panel">
        <div class="pr-panel-header">
            <div><strong>Report catalog</strong><span>@_filtered.Count.ToString("N0") reports sorted by enterprise importance</span></div>
        </div>
        @if (_loading)
        {
            <div class="pr-loading"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading reports...</div>
        }
        else if (!_filtered.Any())
        {
            <div class="pr-empty"><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i><strong>No reports match this view</strong><span>Adjust filters or refresh report definitions.</span></div>
        }
        else
        {
            <div class="pr-report-list">
                @foreach (var report in _filtered)
                {
                    <button type="button" class="pr-report-row" @onclick="() => OpenPreviewAsync(report)">
                        <span class="pr-module-icon pr-module-icon--@ModuleCss(report.ModuleCode)"><i class="bi @ModuleIcon(report.ModuleCode)" aria-hidden="true"></i></span>
                        <span class="pr-report-main">
                            <span class="pr-report-title"><strong>@report.ReportName</strong><span class="pr-badge pr-badge--@ModuleCss(report.ModuleCode)">@report.ModuleCode</span><span class="pr-badge pr-badge--type">@report.ReportTypeCode</span></span>
                            <span class="pr-report-desc">@report.Description</span>
                            <span class="pr-report-meta"><span>@report.ReportCode</span><span>@report.OutputFormats</span><span>@(report.IsSystemReport ? "System" : "Custom")</span><span>@(report.IsActive ? "Active" : "Inactive")</span></span>
                        </span>
                        <span class="pr-row-actions">
                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => OpenPreviewAsync(report)" title="View actual report"><i class="bi bi-eye" aria-hidden="true"></i></button>
                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => RunReportAsync(report)" disabled="@_busy" title="Run now"><i class="bi bi-play-fill" aria-hidden="true"></i></button>
                            <button type="button" class="um-btn um-btn-ghost um-btn-xs" @onclick:stopPropagation="true" @onclick="() => ExportReportAsync(report)" disabled="@_busy" title="Export"><i class="bi bi-download" aria-hidden="true"></i></button>
                        </span>
                    </button>
                }
            </div>
        }
    </section>
</div>

@if (_showPreview)
{
    <div class="pr-modal-backdrop" role="presentation">
        <div class="pr-modal pr-modal--preview" role="dialog" aria-modal="true" aria-labelledby="preview-title">
            <div class="um-modal-header">
                <i class="bi @(string.IsNullOrWhiteSpace(_preview?.ModuleCode) ? "bi-file-earmark-bar-graph" : ModuleIcon(_preview.ModuleCode))" aria-hidden="true"></i>
                <div><span id="preview-title">@(_preview?.ReportName ?? _previewReport?.ReportName ?? "Report Preview")</span><small>@(_preview?.Description ?? _previewReport?.Description)</small></div>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="ClosePreview"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="um-modal-body pr-preview-body">
                @if (_previewLoading)
                {
                    <div class="pr-loading pr-loading--preview"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Generating actual report preview...</div>
                }
                else if (!string.IsNullOrWhiteSpace(_previewError))
                {
                    <div class="alert alert-danger pr-load-error" role="alert"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@_previewError</div>
                }
                else if (_preview is not null)
                {
                    <div class="pr-preview-summary">
                        <div><span>Module</span><strong>@_preview.ModuleCode</strong></div>
                        <div><span>Type</span><strong>@_preview.ReportTypeCode</strong></div>
                        <div><span>Rows</span><strong>@_preview.RowCount.ToString("N0")</strong></div>
                        <div><span>Generated</span><strong>@_preview.GeneratedDateUtc.ToLocalTime().ToString("MMM d, h:mm tt")</strong></div>
                    </div>
                    <div class="pr-preview-table-wrap">
                        <table class="pr-preview-table">
                            <thead>
                                <tr>
                                    @foreach (var column in _preview.Columns)
                                    {
                                        <th class="@PreviewCellCss(column.DataType)">@column.Header</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _preview.Rows)
                                {
                                    <tr>
                                        @foreach (var column in _preview.Columns)
                                        {
                                            <td class="@PreviewCellCss(column.DataType)">@row.GetValueOrDefault(column.Field)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="um-modal-footer">
                <button type="button" class="um-btn um-btn-ghost" @onclick="ClosePreview">Close</button>
                @if (_previewReport is not null)
                {
                    <button type="button" class="um-btn um-btn-ghost" @onclick="() => RunReportAsync(_previewReport)" disabled="@_busy"><i class="bi bi-play-fill" aria-hidden="true"></i> Run</button>
                    <button type="button" class="um-btn um-btn-primary" @onclick="() => ExportReportAsync(_previewReport)" disabled="@_busy"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> Download Excel</button>
                }
            </div>
        </div>
    </div>
}

<style>
@@keyframes um-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }
</style>

@code {
    private Guid _tenantId;
    private Guid? _currentUserId;
    private bool _loading;
    private bool _saving;
    private bool _showPreview;
    private bool _previewLoading;
    private string _searchTerm = string.Empty;
    private string _moduleFilter = string.Empty;
    private string _formatFilter = string.Empty;
    private string _activeFilter = "all";
    private string? _loadError;
    private string? _previewError;
    private string? _toastMessage;
    private string _toastClass = "pr-toast--success";
    private List<ReportDefinitionDto> _reports = [];
    private List<ReportDefinitionDto> _filtered = [];
    private ReportDefinitionDto? _previewReport;
    private ReportPreviewDto? _preview;
    private bool _busy => _loading || _saving || _previewLoading;

    private IEnumerable<string> Modules => _reports.Select(r => r.ModuleCode).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().OrderBy(s => s);
    private int ActiveCount => _reports.Count(r => r.IsActive);
    private int ExportableCount => _reports.Count(IsExportable);
    private int SystemCount => _reports.Count(r => r.IsSystemReport);
    private int ReadinessScore => _reports.Count == 0 ? 0 : Math.Clamp(70 + Math.Min(12, ExportableCount) + Math.Min(10, ActiveCount / 2) + (SystemCount > 0 ? 5 : 0), 0, 100);
    private string ReadinessSummary => ReadinessScore >= 90 ? "Report catalog is enterprise ready" : ReadinessScore >= 80 ? "Core reports are ready for operations" : "Activate and export priority reports to improve readiness";

    private IEnumerable<KpiItem> Kpis =>
    [
        new("all", "Reports", "bi-file-earmark-bar-graph", _reports.Count.ToString("N0"), "definitions", "Show all reports"),
        new("active", "Active", "bi-check-circle", ActiveCount.ToString("N0"), "available", "Show active reports"),
        new("exportable", "Exportable", "bi-download", ExportableCount.ToString("N0"), "Excel or CSV", "Show export-ready reports"),
        new("system", "System", "bi-shield-check", SystemCount.ToString("N0"), "curated", "Show system reports")
    ];

    protected override async Task OnInitializedAsync()
    {
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _currentUserId = context.UserId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Api.SearchReportDefinitionsAsync(null);
            _reports = result?.Items.ToList() ?? [];
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load reports: {ex.Message}";
            _reports = [];
            _filtered = [];
            ShowToast(_loadError, true);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilter()
    {
        _filtered = _reports
            .Where(MatchesSearch)
            .Where(r => string.IsNullOrWhiteSpace(_moduleFilter) || r.ModuleCode == _moduleFilter)
            .Where(r => string.IsNullOrWhiteSpace(_formatFilter) || r.OutputFormats.Contains(_formatFilter, StringComparison.OrdinalIgnoreCase))
            .Where(MatchesActiveFilter)
            .OrderByDescending(ReportScore)
            .ThenBy(r => r.ModuleCode)
            .ThenBy(r => r.ReportName)
            .ToList();
    }

    private bool MatchesSearch(ReportDefinitionDto report)
    {
        if (string.IsNullOrWhiteSpace(_searchTerm)) return true;
        return report.ReportName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
            || report.ReportCode.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
            || report.ModuleCode.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
            || report.ReportTypeCode.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
            || report.OutputFormats.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
            || (report.Description?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private bool MatchesActiveFilter(ReportDefinitionDto report) => _activeFilter switch
    {
        "active" => report.IsActive,
        "exportable" => IsExportable(report),
        "system" => report.IsSystemReport,
        _ => true
    };

    private void SetFilter(string key)
    {
        _activeFilter = key;
        ApplyFilter();
    }

    private void ResetFilters()
    {
        _searchTerm = string.Empty;
        _moduleFilter = string.Empty;
        _formatFilter = string.Empty;
        _activeFilter = "all";
        ApplyFilter();
    }

    private bool IsActiveFilter(string key) => _activeFilter == key;

    private async Task OpenPreviewAsync(ReportDefinitionDto report)
    {
        _previewReport = report;
        _preview = null;
        _previewError = null;
        _previewLoading = true;
        _showPreview = true;
        try
        {
            _preview = await Api.GetReportPreviewAsync(report.ReportDefinitionId, _tenantId);
        }
        catch (Exception ex)
        {
            _previewError = $"Preview failed: {ex.Message}";
        }
        finally
        {
            _previewLoading = false;
        }
    }

    private void ClosePreview()
    {
        _showPreview = false;
        _previewError = null;
        _previewLoading = false;
    }

    private async Task RunReportAsync(ReportDefinitionDto report)
    {
        _saving = true;
        try
        {
            await Api.RunReportAsync(report.ReportDefinitionId, new RunReportRequest(_tenantId, PreferredFormat(report), _currentUserId));
            ShowToast($"Report run completed: {report.ReportName}");
        }
        catch (Exception ex)
        {
            ShowToast($"Run failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ExportReportAsync(ReportDefinitionDto report)
    {
        _saving = true;
        try
        {
            var file = await Api.DownloadReportExcelAsync(report.ReportDefinitionId, _tenantId);
            await DownloadFileAsync(file);
            ShowToast($"Excel downloaded: {report.ReportName}");
        }
        catch (Exception ex)
        {
            ShowToast($"Export failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ExportVisibleAsync()
    {
        _saving = true;
        try
        {
            var file = await Api.DownloadReportsExcelAsync(new DownloadReportsRequest
            {
                TenantId = _tenantId,
                ReportDefinitionIds = _filtered.Select(r => r.ReportDefinitionId).ToList(),
                SearchTerm = _searchTerm,
                ModuleCode = _moduleFilter,
                Format = _formatFilter
            });
            await DownloadFileAsync(file);
            ShowToast($"Excel downloaded for {_filtered.Count} report(s).");
        }
        catch (Exception ex)
        {
            ShowToast($"Export view failed: {ex.Message}", true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DownloadFileAsync(ReportDownloadFile file)
    {
        var fileName = file.FileName.Replace("'", string.Empty).Replace("\"", string.Empty);
        var base64 = Convert.ToBase64String(file.Content);
        var script = $"(() => {{ const a = document.createElement(\"a\"); a.href = \"data:application/vnd.ms-excel;base64,{base64}\"; a.download = \"{fileName}\"; document.body.appendChild(a); a.click(); a.remove(); }})()";
        await Js.InvokeVoidAsync("eval", script);
    }

    private void ShowToast(string message, bool danger = false)
    {
        _toastMessage = message;
        _toastClass = danger ? "pr-toast--danger" : "pr-toast--success";
    }

    private void ClearToast() => _toastMessage = null;

    private static bool IsExportable(ReportDefinitionDto report) => report.OutputFormats.Contains("Excel", StringComparison.OrdinalIgnoreCase) || report.OutputFormats.Contains("CSV", StringComparison.OrdinalIgnoreCase);
    private static string PreferredFormat(ReportDefinitionDto report) => report.OutputFormats.Contains("Excel", StringComparison.OrdinalIgnoreCase) ? "Excel" : report.OutputFormats.Contains("CSV", StringComparison.OrdinalIgnoreCase) ? "CSV" : "PDF";
    private static string PreviewCellCss(string dataType) => dataType is "Currency" or "Number" ? "pr-preview-num" : string.Empty;

    private static int ReportScore(ReportDefinitionDto report)
    {
        var score = 20;
        if (report.IsActive) score += 25;
        if (report.IsSystemReport) score += 15;
        if (IsExportable(report)) score += 12;
        if (report.ReportTypeCode is "Dashboard" or "Analytics" or "Financial") score += 18;
        return Math.Clamp(score, 0, 100);
    }

    private static string ModuleIcon(string module) => module switch
    {
        "Agency" => "bi-building-check",
        "Sales" => "bi-graph-up-arrow",
        "Policy" => "bi-shield-check",
        "Retention" => "bi-arrow-clockwise",
        "Claims" => "bi-exclamation-circle",
        "Finance" => "bi-bank",
        "Producer" => "bi-person-badge",
        "Marketing" => "bi-megaphone",
        "Compliance" => "bi-patch-check",
        _ => "bi-file-earmark-bar-graph"
    };

    private static string ModuleCss(string module) => module switch
    {
        "Claims" => "red",
        "Finance" or "Retention" => "green",
        "Producer" => "purple",
        "Marketing" => "amber",
        "Agency" or "Sales" => "blue",
        _ => "slate"
    };

    private sealed record KpiItem(string Key, string Label, string Icon, string Value, string Detail, string Tooltip);
}
