@page "/platform/reports"
@inject ApiClient Api

<PageTitle>Reports</PageTitle>
<h1>Report Definitions</h1>
<div class="toolbar-row">
    <SfTextBox Placeholder="Search..." @bind-Value="_searchTerm" Width="320px"></SfTextBox>
    <SfButton CssClass="e-primary" OnClick="LoadAsync">Refresh</SfButton>
</div>
@if (_items is null) { <p>Loading...</p> }
else {
<SfGrid DataSource="_items" AllowPaging="true" AllowSorting="true" Height="520px">
    <GridPageSettings PageSize="10"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(ReportDefinitionDto.ReportCode)"      HeaderText="Code"         Width="160"></GridColumn>
        <GridColumn Field="@nameof(ReportDefinitionDto.ReportName)"      HeaderText="Name"         Width="220"></GridColumn>
        <GridColumn Field="@nameof(ReportDefinitionDto.ModuleCode)"      HeaderText="Module"       Width="120"></GridColumn>
        <GridColumn Field="@nameof(ReportDefinitionDto.ReportTypeCode)"  HeaderText="Type"         Width="100"></GridColumn>
        <GridColumn Field="@nameof(ReportDefinitionDto.OutputFormats)"   HeaderText="Formats"      Width="150"></GridColumn>
        <GridColumn Field="@nameof(ReportDefinitionDto.IsSystemReport)"  HeaderText="System"       Width="80"  DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(ReportDefinitionDto.IsActive)"        HeaderText="Active"       Width="80"  DisplayAsCheckBox="true"></GridColumn>
        <GridColumn Field="@nameof(ReportDefinitionDto.CreatedDateUtc)"  HeaderText="Created"      Type="ColumnType.DateTime" Format="d" Width="130"></GridColumn>
    </GridColumns>
</SfGrid>
}
@code {
    private string? _searchTerm;
    private List<ReportDefinitionDto>? _items;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync()
    {
        var result = await Api.SearchReportDefinitionsAsync(_searchTerm);
        _items = result?.Items.ToList() ?? [];
    }
}
