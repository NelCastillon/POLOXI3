@page "/commissions/statements/{StatementId:guid}"
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs

<PageTitle>Statement Detail ? AMS</PageTitle>

<AppPageHeader Title="@($"Statement {StatementId.ToString()[..8].ToUpper()}")"
               Subtitle="Commission payout statement ? line items, split allocations, clawback adjustments, and net payout breakdown"
               Icon="bi-file-earmark-text">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/statements")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Statements
        </button>
        <button class="um-btn um-btn-ghost" @onclick="() => _showDispute = true">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i> Raise Dispute
        </button>
        @if (_statement.Status == "Pending")
        {
            <button class="um-btn um-btn-primary" @onclick="Approve">
                <i class="bi bi-check-circle" aria-hidden="true"></i> Approve &amp; Issue
            </button>
        }
    </Actions>
</AppPageHeader>

<!-- Statement header card -->
<div class="sd-header-row">
    <div class="sd-meta-card">
        <div class="sd-meta-grid">
            <div class="sd-meta-item"><span class="sd-mi-lbl">Producer</span><span class="sd-mi-val">@_statement.Producer</span></div>
            <div class="sd-meta-item"><span class="sd-mi-lbl">Period</span><span class="sd-mi-val">@_statement.Period</span></div>
            <div class="sd-meta-item"><span class="sd-mi-lbl">Plan</span><span class="sd-mi-val">@_statement.Plan</span></div>
            <div class="sd-meta-item"><span class="sd-mi-lbl">Currency</span><span class="sd-mi-val">@_statement.Currency</span></div>
            <div class="sd-meta-item"><span class="sd-mi-lbl">Status</span>
                <span class="sd-status-chip sd-st-@_statement.Status.ToLower()">@_statement.Status</span>
            </div>
            <div class="sd-meta-item"><span class="sd-mi-lbl">Issued</span><span class="sd-mi-val">@(_statement.IssuedDate?.ToString("MMM d, yyyy") ?? "?")</span></div>
        </div>
    </div>
    <!-- Payout summary -->
    <div class="sd-payout-summary">
        <div class="sd-ps-row"><span class="sd-ps-lbl">Gross Earned (New Biz)</span><span class="sd-ps-val">@_statement.NewBizGross.ToString("C2")</span></div>
        <div class="sd-ps-row"><span class="sd-ps-lbl">Gross Earned (Renewal)</span><span class="sd-ps-val">@_statement.RenewalGross.ToString("C2")</span></div>
        <div class="sd-ps-row"><span class="sd-ps-lbl">Override / Bonus</span><span class="sd-ps-val">@_statement.Override.ToString("C2")</span></div>
        <div class="sd-ps-row sd-ps-sub"><span class="sd-ps-lbl">Clawbacks</span><span class="sd-ps-val sd-ps-neg">(@_statement.Clawbacks.ToString("C2"))</span></div>
        <div class="sd-ps-row sd-ps-sub"><span class="sd-ps-lbl">Adjustments</span><span class="sd-ps-val sd-ps-neg">(@_statement.Adjustments.ToString("C2"))</span></div>
        <div class="sd-ps-divider"></div>
        <div class="sd-ps-row sd-ps-total"><span class="sd-ps-lbl">Net Payout</span><span class="sd-ps-val sd-ps-big">@_statement.NetPayout.ToString("C2")</span></div>
    </div>
</div>

<!-- Tabs: Line Items | Split Allocations | Clawback Detail | Audit Trail -->
<SfTab>
    <TabItems>
        <!-- Line Items -->
        <TabItem>
            <ChildContent><TabHeader Text="Line Items"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="sd-tab-content">
                    <SfGrid DataSource="_lineItems" AllowSorting="true" AllowPaging="true" Height="360px">
                        <GridPageSettings PageSize="12"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(LineItem.PolicyNumber)" HeaderText="Policy" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(LineItem.Insured)" HeaderText="Insured" Width="180"></GridColumn>
                            <GridColumn HeaderText="Type" Width="110">
                                <Template>
                                    @{ var li = (LineItem)context; }
                                    <span class="sd-type-chip sd-t-@li.Type.ToLower()">@li.Type</span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(LineItem.Premium)" HeaderText="Premium" Format="C2" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                            <GridColumn Field="@nameof(LineItem.Rate)" HeaderText="Rate %" Format="N2" Width="80" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                            <GridColumn Field="@nameof(LineItem.Commission)" HeaderText="Commission" Format="C2" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                            <GridColumn Field="@nameof(LineItem.EffectiveDate)" HeaderText="Effective" Type="ColumnType.Date" Format="d" Width="110"></GridColumn>
                        </GridColumns>
                    </SfGrid>
                </div>
            </ContentTemplate>
        </TabItem>
        <!-- Split Allocations -->
        <TabItem>
            <ChildContent><TabHeader Text="Split Allocations"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="sd-tab-content">
                    <div class="sd-split-info">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        Multi-producer splits applied per plan <strong>@_statement.Plan</strong>. Adjustments for branch overrides and house account rules are included.
                    </div>
                    <SfGrid DataSource="_splits" AllowSorting="true" Height="320px">
                        <GridColumns>
                            <GridColumn Field="@nameof(SplitRow.Producer)" HeaderText="Producer" Width="200"></GridColumn>
                            <GridColumn HeaderText="Role" Width="130">
                                <Template>
                                    @{ var sp = (SplitRow)context; }
                                    <span class="sd-role-chip sd-r-@sp.Role.ToLower().Replace(" ","-")">@sp.Role</span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(SplitRow.SplitPct)" HeaderText="Split %" Format="N1" Width="90" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                            <GridColumn Field="@nameof(SplitRow.GrossShare)" HeaderText="Gross Share" Format="C2" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                            <GridColumn Field="@nameof(SplitRow.ClawbackShare)" HeaderText="Clawbacks" Format="C2" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                            <GridColumn Field="@nameof(SplitRow.NetShare)" HeaderText="Net Share" Format="C2" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                            <GridColumn HeaderText="Override" Width="90">
                                <Template>
                                    @{ var sp2 = (SplitRow)context; }
                                    @if (sp2.BranchOverride) { <span class="sd-badge-override">Branch</span> }
                                    @if (sp2.HouseAccount)   { <span class="sd-badge-house">House</span> }
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                </div>
            </ContentTemplate>
        </TabItem>
        <!-- Clawback Detail -->
        <TabItem>
            <ChildContent><TabHeader Text=@($"Clawbacks ({_clawbacks.Count})")></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="sd-tab-content">
                    @if (_clawbacks.Count == 0)
                    {
                        <div class="sd-empty"><i class="bi bi-check-circle" aria-hidden="true"></i> No clawbacks applied to this statement.</div>
                    }
                    else
                    {
                        <SfGrid DataSource="_clawbacks" AllowSorting="true" Height="320px">
                            <GridColumns>
                                <GridColumn Field="@nameof(ClawbackRow.Date)" HeaderText="Date" Type="ColumnType.Date" Format="d" Width="110"></GridColumn>
                                <GridColumn Field="@nameof(ClawbackRow.Reason)" HeaderText="Reason" Width="180"></GridColumn>
                                <GridColumn Field="@nameof(ClawbackRow.PolicyNumber)" HeaderText="Policy" Width="140"></GridColumn>
                                <GridColumn Field="@nameof(ClawbackRow.Amount)" HeaderText="Amount" Format="C2" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right"></GridColumn>
                                <GridColumn Field="@nameof(ClawbackRow.Notes)" HeaderText="Notes" Width="280"></GridColumn>
                            </GridColumns>
                        </SfGrid>
                    }
                </div>
            </ContentTemplate>
        </TabItem>
        <!-- Audit Trail -->
        <TabItem>
            <ChildContent><TabHeader Text="Audit Trail"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="sd-tab-content">
                    <div class="sd-audit-list">
                        @foreach (var e in _auditTrail)
                        {
                            <div class="sd-audit-row">
                                <span class="sd-au-dot sd-au-@e.Type"></span>
                                <div class="sd-au-content">
                                    <div class="sd-au-msg">@e.Message</div>
                                    <div class="sd-au-meta">@e.User &bull; @e.Timestamp.ToString("MMM d, yyyy h:mm tt")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </ContentTemplate>
        </TabItem>
    </TabItems>
</SfTab>

<!-- Raise Dispute Dialog -->
<SfDialog @bind-Visible="_showDispute" Width="520px" ShowCloseIcon="true" IsModal="true" Header="Raise Dispute on Statement">
    <DialogTemplates>
        <Content>
            <div class="sd-dlg-body">
                <div class="form-group mb-2"><label class="sd-lbl">Disputed Amount</label>
                    <SfNumericTextBox TValue="decimal" @bind-Value="_disputeAmount" Format="C2" Width="100%"></SfNumericTextBox>
                </div>
                <div class="form-group mb-2"><label class="sd-lbl">Description</label>
                    <SfTextBox @bind-Value="_disputeDesc" Multiline="true" Placeholder="Describe the issue?"></SfTextBox>
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Submit Dispute" IsPrimary="true" OnClick="SubmitDisputeAndNav"></DialogButton>
        <DialogButton Content="Cancel" OnClick="() => _showDispute = false"></DialogButton>
    </DialogButtons>
</SfDialog>

@code {
    [Parameter] public Guid StatementId { get; set; }

    private bool _showDispute;
    private decimal _disputeAmount;
    private string? _disputeDesc;

    private void SubmitDisputeAndNav()
    {
        _showDispute = false;
        Nav.NavigateTo("/commissions/exceptions");
    }

    // -- Seeded statement header ----------------------------------------------
    private StatementHeader _statement = new(
        "Sarah Chen", "February 2025", "Standard Producer Plan 2025", "USD", "Pending",
        null, 8_200m, 5_100m, 1_500m, 400m, 200m);

    private decimal Net => _statement.NewBizGross + _statement.RenewalGross + _statement.Override - _statement.Clawbacks - _statement.Adjustments;

    // -- Line items -----------------------------------------------------------
    private readonly List<LineItem> _lineItems =
    [
        new("POL-2025-00182","Riverside Construction LLC","New Biz", 45_000m,10.0m,4_500m,new DateTime(2025,2,1)),
        new("POL-2025-00211","Harbor View Marina",        "New Biz", 31_000m,10.0m,3_100m,new DateTime(2025,2,5)),
        new("POL-2024-09912","Summit Roofing Inc",        "Renewal", 28_000m, 8.0m,2_240m,new DateTime(2025,2,10)),
        new("POL-2024-08811","GreenPath Landscaping",     "Renewal", 19_500m, 8.0m,1_560m,new DateTime(2025,2,12)),
        new("POL-2025-00241","BlueLine Logistics",        "New Biz", 12_000m, 8.0m,  960m,new DateTime(2025,2,18)),
        new("POL-2024-07730","West Side Auto Body",       "Renewal", 16_200m, 8.0m,1_296m,new DateTime(2025,2,20)),
    ];

    // -- Split allocations ----------------------------------------------------
    private readonly List<SplitRow> _splits =
    [
        new("Sarah Chen",   "Primary Agent",  60m, 9_900m,  240m, 9_660m,  false, false),
        new("Marcus Webb",  "Secondary Agent",30m, 4_950m,  120m, 4_830m,  false, false),
        new("Branch Office","Branch Override",10m, 1_650m,   40m, 1_610m,  true,  false),
    ];

    // -- Clawbacks ------------------------------------------------------------
    private readonly List<ClawbackRow> _clawbacks =
    [
        new(new DateTime(2025,2,8),"Policy Cancellation","POL-2024-07415",350m,"Policy cancelled within 90 days"),
        new(new DateTime(2025,2,15),"NSF Chargeback",    "POL-2025-00095", 50m,"Premium payment returned NSF"),
    ];

    // -- Audit trail ----------------------------------------------------------
    private readonly List<AuditEntry> _auditTrail =
    [
        new("info","Statement generated for period Feb 2025","System",     new DateTime(2025,3,1,2,0,0)),
        new("info","Clawback CLW-2025-0012 applied",          "System",     new DateTime(2025,3,1,2,1,0)),
        new("edit","Split allocations recalculated",           "System",     new DateTime(2025,3,1,2,2,0)),
        new("info","Statement submitted for approval",         "Sarah Chen", new DateTime(2025,3,3,10,15,0)),
        new("warn","Dispute raised: rate mismatch query",      "Marcus Webb",new DateTime(2025,3,4,14,30,0)),
    ];

    protected override void OnInitialized() =>
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Commissions","/commissions"), new("Statements","/commissions/statements"), new("Detail",""));

    void Approve() => _statement = _statement with { Status = "Issued", IssuedDate = DateTime.Today };

    record StatementHeader(string Producer, string Period, string Plan, string Currency, string Status,
                           DateTime? IssuedDate, decimal NewBizGross, decimal RenewalGross,
                           decimal Override, decimal Clawbacks, decimal Adjustments)
    {
        public string Status { get; set; } = Status;
        public DateTime? IssuedDate { get; set; } = IssuedDate;
        public decimal NetPayout => NewBizGross + RenewalGross + Override - Clawbacks - Adjustments;
    }
    record LineItem(string PolicyNumber, string Insured, string Type, decimal Premium, decimal Rate, decimal Commission, DateTime EffectiveDate);
    record SplitRow(string Producer, string Role, decimal SplitPct, decimal GrossShare, decimal ClawbackShare, decimal NetShare, bool BranchOverride, bool HouseAccount);
    record ClawbackRow(DateTime Date, string Reason, string PolicyNumber, decimal Amount, string Notes);
    record AuditEntry(string Type, string Message, string User, DateTime Timestamp);
}
