@page "/commissions/statements/{StatementId:guid}"
@using Ams.Application.Common.Dtos
@using Ams.Application.Features.Commissions
@inject NavigationManager Nav
@inject BreadcrumbService Breadcrumbs
@inject ApiClient Api
@inject CurrentUserContext CurrentUser

<PageTitle>Statement Detail ? AMS</PageTitle>

<AppPageHeader Title="@($"Statement {StatementId.ToString()[..8].ToUpper()}")"
               Subtitle="Commission payout statement ? line items, split allocations, clawback adjustments, and net payout breakdown"
               Icon="bi-file-earmark-text">
    <Actions>
        <button class="um-btn um-btn-ghost" @onclick='() => Nav.NavigateTo("/commissions/statements")'>
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to Statements
        </button>
        <button class="um-btn um-btn-ghost" @onclick="() => _showDispute = true">
            <i class="bi bi-exclamation-circle" aria-hidden="true"></i> Raise Dispute
        </button>
        @if (_statement.Status == "Pending")
        {
            <button class="um-btn um-btn-primary" @onclick="ApproveAsync">
                <i class="bi bi-check-circle" aria-hidden="true"></i> Approve &amp; Issue
            </button>
        }
    </Actions>
</AppPageHeader>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;" role="alert">@_loadError</div>
}

@if (_loading)
{
    <div class="um-loading-overlay"><div class="um-spinner" aria-hidden="true"></div><span>Loading statement detail...</span></div>
}

<!-- Statement header card -->
<div class="sd-header-row">
    <div class="sd-meta-card">
        <div class="sd-meta-grid">
            <div class="sd-meta-item"><span class="sd-mi-lbl">Producer</span><span class="sd-mi-val">@_statement.Producer</span></div>
            <div class="sd-meta-item"><span class="sd-mi-lbl">Period</span><span class="sd-mi-val">@_statement.Period</span></div>
            <div class="sd-meta-item"><span class="sd-mi-lbl">Plan</span><span class="sd-mi-val">@_statement.Plan</span></div>
            <div class="sd-meta-item"><span class="sd-mi-lbl">Currency</span><span class="sd-mi-val">@_statement.Currency</span></div>
            <div class="sd-meta-item"><span class="sd-mi-lbl">Status</span>
                <span class="sd-status-chip sd-st-@_statement.Status.ToLower()">@_statement.Status</span>
            </div>
            <div class="sd-meta-item"><span class="sd-mi-lbl">Issued</span><span class="sd-mi-val">@(_statement.IssuedDate?.ToString("MMM d, yyyy") ?? "?")</span></div>
        </div>
    </div>
    <!-- Payout summary -->
    <div class="sd-payout-summary">
        <div class="sd-ps-row"><span class="sd-ps-lbl">Gross Earned (New Biz)</span><span class="sd-ps-val">@_statement.NewBizGross.ToString("C2")</span></div>
        <div class="sd-ps-row"><span class="sd-ps-lbl">Gross Earned (Renewal)</span><span class="sd-ps-val">@_statement.RenewalGross.ToString("C2")</span></div>
        <div class="sd-ps-row"><span class="sd-ps-lbl">Override / Bonus</span><span class="sd-ps-val">@_statement.Override.ToString("C2")</span></div>
        <div class="sd-ps-row sd-ps-sub"><span class="sd-ps-lbl">Clawbacks</span><span class="sd-ps-val sd-ps-neg">(@_statement.Clawbacks.ToString("C2"))</span></div>
        <div class="sd-ps-row sd-ps-sub"><span class="sd-ps-lbl">Adjustments</span><span class="sd-ps-val sd-ps-neg">(@_statement.Adjustments.ToString("C2"))</span></div>
        <div class="sd-ps-divider"></div>
        <div class="sd-ps-row sd-ps-total"><span class="sd-ps-lbl">Net Payout</span><span class="sd-ps-val sd-ps-big">@_statement.NetPayout.ToString("C2")</span></div>
    </div>
</div>

<!-- Tabs: Line Items | Split Allocations | Clawback Detail | Audit Trail -->
<AppTab>
    <TabItems>
        <!-- Line Items -->
        <TabItem>
            <ChildContent><TabHeader Text="Line Items"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="sd-tab-content">
                    <AppGrid DataSource="_lineItems" AllowSorting="true" AllowPaging="true" Height="360px">
                        <GridPageSettings PageSize="12"></GridPageSettings>
                        <GridColumns>
                            <GridColumn Field="@nameof(LineItem.PolicyNumber)" HeaderText="Policy" Width="160"></GridColumn>
                            <GridColumn Field="@nameof(LineItem.Insured)" HeaderText="Insured" Width="180"></GridColumn>
                            <GridColumn HeaderText="Type" Width="110">
                                <Template>
                                    @{ var li = (LineItem)context; }
                                    <span class="sd-type-chip sd-t-@li.Type.ToLower()">@li.Type</span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(LineItem.Premium)" HeaderText="Premium" Format="C2" Width="120" TextAlign=@("Right")></GridColumn>
                            <GridColumn Field="@nameof(LineItem.Rate)" HeaderText="Rate %" Format="N2" Width="80" TextAlign=@("Right")></GridColumn>
                            <GridColumn Field="@nameof(LineItem.Commission)" HeaderText="Commission" Format="C2" Width="120" TextAlign=@("Right")></GridColumn>
                            <GridColumn Field="@nameof(LineItem.EffectiveDate)" HeaderText="Effective" Type="ColumnType.Date" Format="d" Width="110"></GridColumn>
                        </GridColumns>
                    </AppGrid>
                </div>
            </ContentTemplate>
        </TabItem>
        <!-- Split Allocations -->
        <TabItem>
            <ChildContent><TabHeader Text="Split Allocations"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="sd-tab-content">
                    <div class="sd-split-info">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        Multi-producer splits applied per plan <strong>@_statement.Plan</strong>. Adjustments for branch overrides and house account rules are included.
                    </div>
                    <AppGrid DataSource="_splits" AllowSorting="true" Height="320px">
                        <GridColumns>
                            <GridColumn Field="@nameof(SplitRow.Producer)" HeaderText="Producer" Width="200"></GridColumn>
                            <GridColumn HeaderText="Role" Width="130">
                                <Template>
                                    @{ var sp = (SplitRow)context; }
                                    <span class="sd-role-chip sd-r-@sp.Role.ToLower().Replace(" ","-")">@sp.Role</span>
                                </Template>
                            </GridColumn>
                            <GridColumn Field="@nameof(SplitRow.SplitPct)" HeaderText="Split %" Format="N1" Width="90" TextAlign=@("Right")></GridColumn>
                            <GridColumn Field="@nameof(SplitRow.GrossShare)" HeaderText="Gross Share" Format="C2" Width="130" TextAlign=@("Right")></GridColumn>
                            <GridColumn Field="@nameof(SplitRow.ClawbackShare)" HeaderText="Clawbacks" Format="C2" Width="120" TextAlign=@("Right")></GridColumn>
                            <GridColumn Field="@nameof(SplitRow.NetShare)" HeaderText="Net Share" Format="C2" Width="120" TextAlign=@("Right")></GridColumn>
                            <GridColumn HeaderText="Override" Width="90">
                                <Template>
                                    @{ var sp2 = (SplitRow)context; }
                                    @if (sp2.BranchOverride) { <span class="sd-badge-override">Branch</span> }
                                    @if (sp2.HouseAccount)   { <span class="sd-badge-house">House</span> }
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </AppGrid>
                </div>
            </ContentTemplate>
        </TabItem>
        <!-- Clawback Detail -->
        <TabItem>
            <ChildContent><TabHeader Text=@($"Clawbacks ({_clawbacks.Count})")></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="sd-tab-content">
                    @if (_clawbacks.Count == 0)
                    {
                        <div class="sd-empty"><i class="bi bi-check-circle" aria-hidden="true"></i> No clawbacks applied to this statement.</div>
                    }
                    else
                    {
                        <AppGrid DataSource="_clawbacks" AllowSorting="true" Height="320px">
                            <GridColumns>
                                <GridColumn Field="@nameof(ClawbackRow.Date)" HeaderText="Date" Type="ColumnType.Date" Format="d" Width="110"></GridColumn>
                                <GridColumn Field="@nameof(ClawbackRow.Reason)" HeaderText="Reason" Width="180"></GridColumn>
                                <GridColumn Field="@nameof(ClawbackRow.PolicyNumber)" HeaderText="Policy" Width="140"></GridColumn>
                                <GridColumn Field="@nameof(ClawbackRow.Amount)" HeaderText="Amount" Format="C2" Width="120" TextAlign=@("Right")></GridColumn>
                                <GridColumn Field="@nameof(ClawbackRow.Notes)" HeaderText="Notes" Width="280"></GridColumn>
                            </GridColumns>
                        </AppGrid>
                    }
                </div>
            </ContentTemplate>
        </TabItem>
        <!-- Audit Trail -->
        <TabItem>
            <ChildContent><TabHeader Text="Audit Trail"></TabHeader></ChildContent>
            <ContentTemplate>
                <div class="sd-tab-content">
                    <div class="sd-audit-list">
                        @foreach (var e in _auditTrail)
                        {
                            <div class="sd-audit-row">
                                <span class="sd-au-dot sd-au-@e.Type"></span>
                                <div class="sd-au-content">
                                    <div class="sd-au-msg">@e.Message</div>
                                    <div class="sd-au-meta">@e.User &bull; @e.Timestamp.ToString("MMM d, yyyy h:mm tt")</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </ContentTemplate>
        </TabItem>
    </TabItems>
</AppTab>

<!-- Raise Dispute Dialog -->
<AppModal @bind-Visible="_showDispute" Width="520px" ShowCloseIcon="true" IsModal="true" Header="Raise Dispute on Statement">
    <DialogTemplates>
        <Content>
            <div class="sd-dlg-body">
                <div class="form-group mb-2"><label class="sd-lbl">Disputed Amount</label>
                    <AppNumericTextBox TValue="decimal" @bind-Value="_disputeAmount" Format="C2" Width="100%"></AppNumericTextBox>
                </div>
                <div class="form-group mb-2"><label class="sd-lbl">Description</label>
                    <AppTextBox @bind-Value="_disputeDesc" Multiline="true" Placeholder="Describe the issue?"></AppTextBox>
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Submit Dispute" IsPrimary="true" OnClick="SubmitDisputeAndNav"></DialogButton>
        <DialogButton Content="Cancel" OnClick="() => _showDispute = false"></DialogButton>
    </DialogButtons>
</AppModal>

@code {
    [Parameter] public Guid StatementId { get; set; }

    private Guid _tenantId;
    private Guid _tenantAdminUserId;
    private bool _loading;
    private string? _loadError;
    private bool _showDispute;
    private decimal _disputeAmount;
    private string? _disputeDesc;
    private CommissionPayoutStatementDto? _statementDto;
    private List<CommissionPayeeDto> _payees = [];
    private List<CommissionPlanDto> _plans = [];
    private List<CommissionTransactionDto> _transactions = [];
    private List<CommissionClawbackDto> _clawbackDtos = [];
    private List<CommissionDisputeDto> _disputes = [];

    private async Task SubmitDisputeAndNav()
    {
        if (_statementDto is null)
        {
            _showDispute = false;
            return;
        }

        try
        {
            await Api.CreateCommissionDisputeAsync(new CreateCommissionDisputeRequest
            {
                TenantId = _tenantId,
                PayeeId = _statementDto.PayeeId,
                DisputeDate = DateOnly.FromDateTime(DateTime.UtcNow),
                DisputeReason = string.IsNullOrWhiteSpace(_disputeDesc) ? $"Statement {StatementId} dispute" : _disputeDesc,
                DisputedAmount = _disputeAmount,
                StatusCode = "Open",
                CreatedByUserId = _tenantAdminUserId
            });
            _showDispute = false;
            Nav.NavigateTo("/commissions/exceptions");
        }
        catch (Exception ex)
        {
            _loadError = $"Dispute submit failed: {ex.Message}";
        }
    }

    private StatementHeader _statement = new(
        "Unassigned payee", string.Empty, string.Empty, "USD", string.Empty,
        null, 0m, 0m, 0m, 0m, 0m);

    private decimal Net => _statement.NewBizGross + _statement.RenewalGross + _statement.Override - _statement.Clawbacks - _statement.Adjustments;

    private List<LineItem> _lineItems = [];

    private List<SplitRow> _splits = [];

    private List<ClawbackRow> _clawbacks = [];

    private List<AuditEntry> _auditTrail = [];

    protected override async Task OnInitializedAsync()
    {
        Breadcrumbs.SetCrumbs(new("Home","/"), new("Commissions","/commissions"), new("Statements","/commissions/statements"), new("Detail",""));
        var context = await CurrentUser.RequireAsync();
        _tenantId = context.TenantId;
        _tenantAdminUserId = context.UserId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            await Api.EnsureCommissionPayoutStatementsSeedAsync(_tenantId, _tenantAdminUserId);
            _statementDto = await Api.GetCommissionPayoutStatementAsync(StatementId);
            if (_statementDto is null)
            {
                _loadError = "Commission statement was not found.";
                ClearDetailRows();
                return;
            }

            var payeesTask = Api.SearchCommissionPayeesAsync(_tenantId, null);
            var plansTask = Api.SearchCommissionPlansAsync(_tenantId, null);
            var transactionsTask = Api.SearchCommissionTransactionsAsync(_tenantId, null);
            var clawbacksTask = Api.SearchCommissionClawbacksAsync(_tenantId, null);
            var disputesTask = Api.SearchCommissionDisputesAsync(_tenantId, null);
            await Task.WhenAll(payeesTask, plansTask, transactionsTask, clawbacksTask, disputesTask);

            _payees = payeesTask.Result?.Items.ToList() ?? [];
            _plans = plansTask.Result?.Items.ToList() ?? [];
            _transactions = transactionsTask.Result?.Items.Where(t => t.PayeeId == _statementDto.PayeeId).ToList() ?? [];
            _clawbackDtos = clawbacksTask.Result?.Items.Where(c => c.PayeeId == _statementDto.PayeeId).ToList() ?? [];
            _disputes = disputesTask.Result?.Items.Where(d => d.PayeeId == _statementDto.PayeeId).ToList() ?? [];

            MapStatementDetail();
        }
        catch (Exception ex)
        {
            _loadError = $"Commission statement detail failed to load: {ex.Message}";
            ClearDetailRows();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApproveAsync()
    {
        if (_statementDto is null) return;
        try
        {
            await Api.UpdateCommissionPayoutStatementAsync(_statementDto.StatementId, new UpdateCommissionPayoutStatementRequest
            {
                StatementId = _statementDto.StatementId,
                TenantId = _statementDto.TenantId,
                PayeeId = _statementDto.PayeeId,
                PayoutBatchId = _statementDto.PayoutBatchId,
                StatementDate = _statementDto.StatementDate,
                GrossEarnings = _statementDto.GrossEarnings,
                TotalClawbacks = _statementDto.TotalClawbacks,
                NetPayout = _statementDto.NetPayout,
                CurrencyCode = _statementDto.CurrencyCode,
                StatusCode = "Issued",
                IssuedDateUtc = DateTime.UtcNow,
                ModifiedByUserId = _tenantAdminUserId
            });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Statement approval failed: {ex.Message}";
        }
    }

    private void MapStatementDetail()
    {
        if (_statementDto is null) return;
        var payee = _payees.FirstOrDefault(p => p.PayeeId == _statementDto.PayeeId);
        var plan = payee is null ? null : _plans.FirstOrDefault(p => p.CommissionPlanId == payee.CommissionPlanId);
        var grossFromTransactions = _transactions.Sum(t => t.CommissionAmount);
        var clawbacks = _clawbackDtos.Sum(c => c.Amount);
        _statement = new(
            PayeeLabel(payee),
            _statementDto.StatementDate.ToString("MMMM yyyy"),
            plan?.PlanName ?? "Commission plan not assigned",
            _statementDto.CurrencyCode,
            _statementDto.StatusCode,
            _statementDto.IssuedDateUtc,
            grossFromTransactions,
            0m,
            Math.Max(0m, _statementDto.GrossEarnings - grossFromTransactions),
            _statementDto.TotalClawbacks,
            Math.Max(0m, _statementDto.GrossEarnings - _statementDto.TotalClawbacks - _statementDto.NetPayout));

        _lineItems = _transactions.Select(t => new LineItem(t.SourceEntityId.ToString()[..8], t.SourceEntityName, t.StatusCode, t.GrossAmount, t.CommissionRate, t.CommissionAmount, t.TransactionDate.ToDateTime(TimeOnly.MinValue))).ToList();
        var splitPct = payee?.SplitPercentage ?? 100m;
        _splits = [new(PayeeLabel(payee), payee?.PayeeTypeCode ?? "Payee", splitPct, _statementDto.GrossEarnings, _statementDto.TotalClawbacks, _statementDto.NetPayout, plan?.BranchOverrideEligible ?? false, plan?.HouseAccountRules ?? false)];
        _clawbacks = _clawbackDtos.Select(c => new ClawbackRow(c.ClawbackDate.ToDateTime(TimeOnly.MinValue), c.ReasonCode, string.IsNullOrWhiteSpace(c.TransactionReference) ? c.OriginalTransactionId.ToString()[..8] : c.TransactionReference, c.Amount, c.Notes ?? c.StatusCode)).ToList();
        _auditTrail = BuildAuditTrail(payee);
    }

    private void ClearDetailRows()
    {
        _lineItems = [];
        _splits = [];
        _clawbacks = [];
        _auditTrail = [];
    }

    private List<AuditEntry> BuildAuditTrail(CommissionPayeeDto? payee)
    {
        var rows = new List<AuditEntry>();
        if (_statementDto is not null)
        {
            rows.Add(new("info", $"Statement created with status {_statementDto.StatusCode}.", "System", _statementDto.CreatedDateUtc));
            if (_statementDto.IssuedDateUtc.HasValue) rows.Add(new("info", "Statement issued.", PayeeLabel(payee), _statementDto.IssuedDateUtc.Value));
        }
        rows.AddRange(_clawbackDtos.Select(c => new AuditEntry("warn", $"Clawback applied: {c.ReasonCode} ({c.Amount:C2}).", "System", c.CreatedDateUtc)));
        rows.AddRange(_disputes.Select(d => new AuditEntry("warn", $"Dispute {d.StatusCode}: {d.DisputeReason}", PayeeLabel(payee), d.CreatedDateUtc)));
        return rows.OrderByDescending(r => r.Timestamp).ToList();
    }

    private static string PayeeLabel(CommissionPayeeDto? payee)
        => payee is null ? "Unassigned payee" : $"{payee.PayeeTypeCode} {payee.UserId.ToString()[..8]}";

    record StatementHeader(string Producer, string Period, string Plan, string Currency, string Status,
                           DateTime? IssuedDate, decimal NewBizGross, decimal RenewalGross,
                           decimal Override, decimal Clawbacks, decimal Adjustments)
    {
        public string Status { get; set; } = Status;
        public DateTime? IssuedDate { get; set; } = IssuedDate;
        public decimal NetPayout => NewBizGross + RenewalGross + Override - Clawbacks - Adjustments;
    }
    record LineItem(string PolicyNumber, string Insured, string Type, decimal Premium, decimal Rate, decimal Commission, DateTime EffectiveDate);
    record SplitRow(string Producer, string Role, decimal SplitPct, decimal GrossShare, decimal ClawbackShare, decimal NetShare, bool BranchOverride, bool HouseAccount);
    record ClawbackRow(DateTime Date, string Reason, string PolicyNumber, decimal Amount, string Notes);
    record AuditEntry(string Type, string Message, string User, DateTime Timestamp);
}
