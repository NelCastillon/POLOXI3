@using Microsoft.AspNetCore.Components.Web
@using Ams.Web.Components
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0d1526" />
    <base href="/" />
    <title>AMS Enterprise Platform</title>
    <!-- Inter variable font — preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- AMS Design System -->
    <link rel="stylesheet" href="css/site.css" />
    <!-- Blazor CSS isolation bundle (NavSidebar, TopHeader, MainLayout scoped styles) -->
    <link rel="stylesheet" href="Ams.Web.styles.css" />
    <!-- Enterprise CSS-only visual refresh -->
    <link rel="stylesheet" href="css/enterprise.css" />
    <!-- Apply persisted theme before first paint to avoid a light-mode flash -->
    <script>
        try {
            if (document.cookie.indexOf('ams-theme=dark') !== -1) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        } catch (e) { /* unavailable */ }
    </script>
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>
<body>
    <Routes @rendermode="RenderMode.InteractiveServer" />
    <script src="_content/Syncfusion.Blazor/scripts/syncfusion-blazor.min.js"></script>
    <script src="js/download.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script>
        window.amsDownloadFile = function (b64, name, mime) {
            var a = document.createElement('a');
            a.href = 'data:' + mime + ';base64,' + b64;
            a.download = name;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        };
    </script>
</body>
</html>
