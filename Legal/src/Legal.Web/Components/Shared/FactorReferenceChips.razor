@* Reusable reference-chip strip for a factor's ACTUAL references (matter/profile/document/evidence/
   authority/channel). Each chip is a button that raises OnReferenceSelected so the host can open the
   shared FactorReferencePopup. Renders an em dash when the factor has no references. Shared by the
   Factor Matrix, Global factors, Candidate × factor, and Factor Inventory checklist surfaces. *@

@if (References is null || References.Count == 0)
{
    <text>—</text>
}
else
{
    <div class="poloxi-factorcheck-item-refs">
        @foreach (var reference in References)
        {
            var refIcon = reference.KindCode switch
            {
                "MATTER_FIELD" => "bi-journal-text",
                "PROFILE_FIELD" => "bi-person-badge",
                "DOCUMENT" => "bi-file-earmark-text",
                "EVIDENCE" => "bi-paperclip",
                "LEGAL_AUTHORITY" => "bi-bank",
                "CHANNEL" => "bi-broadcast",
                _ => "bi-link-45deg"
            };
            var refKindLabel = reference.KindCode switch
            {
                "MATTER_FIELD" => "Matter",
                "PROFILE_FIELD" => "Profile",
                "DOCUMENT" => "Doc",
                "EVIDENCE" => "Evidence",
                "LEGAL_AUTHORITY" => "Authority",
                "CHANNEL" => "Channel",
                _ => reference.KindCode
            };
            var refState = (reference.VerificationState ?? "UNVERIFIED").ToLowerInvariant();
            var refTitle = string.IsNullOrWhiteSpace(reference.Reference) ? reference.Label : reference.Reference;
            var hasPopup = HasReferenceDetail(reference);
            var captured = reference;
            <button type="button"
                    class="poloxi-factor-ref poloxi-factor-ref--@refState"
                    title="@refTitle"
                    @onclick="() => OnReferenceSelected.InvokeAsync(captured)">
                <i class="bi @refIcon"></i>
                <span class="poloxi-factor-ref-kind">@(refKindLabel):</span> @reference.Label
                @if (hasPopup)
                {
                    <i class="bi bi-box-arrow-up-right poloxi-factor-ref-open"></i>
                }
            </button>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyCollection<WideFactorReferenceDto>? References { get; set; }

    [Parameter] public EventCallback<WideFactorReferenceDto> OnReferenceSelected { get; set; }

    private static bool HasReferenceDetail(WideFactorReferenceDto reference)
        => !string.IsNullOrWhiteSpace(reference.NavigationRoute)
            || !string.IsNullOrWhiteSpace(reference.Excerpt)
            || !string.IsNullOrWhiteSpace(reference.Reference)
            || reference.DocumentId.HasValue;
}
