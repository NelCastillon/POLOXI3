            <datalist id="pie-impact-types">@foreach (var v in _options.ImpactTypes){<option value="@v" />}</datalist>
            <datalist id="pie-deadline-types">@foreach (var v in _options.DeadlineTypes){<option value="@v" />}</datalist>
            <datalist id="pie-treatment-specialties">@foreach (var v in _options.TreatmentSpecialties){<option value="@v" />}</datalist>
            <datalist id="pie-negotiation-sources">@foreach (var v in _options.NegotiationSources){<option value="@v" />}</datalist>
            <datalist id="pie-limits-sources">@foreach (var v in _options.LimitsSources){<option value="@v" />}</datalist>
            <datalist id="pie-request-statuses">@foreach (var v in _options.RequestStatuses){<option value="@v" />}</datalist>
        </section>

        @* ── Witnesses ── *@
        <section class="intel-panel pi-wizard-section">
            <div class="pi-section-head">
                <h2><i class="bi bi-people"></i> Witnesses</h2>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick='() => OpenAdd("witness")'><i class="bi bi-plus-lg"></i> Add witness</button>
            </div>
