            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Deadline type</span><input class="form-control" @bind="row.DeadlineTypeCode" /></label>
                        <label class="um-field"><span class="um-field-label">Candidate date</span><input type="date" class="form-control" @bind="row.CandidateDate" /></label>
                        <label class="um-field"><span class="um-field-label">Rule source</span><input class="form-control" list="pie-rule-sources" @bind="row.RuleSourceCode" /></label>
                        <label class="um-field"><span class="um-field-label">Verification</span><input class="form-control" list="pie-deadline-verif" @bind="row.VerificationState" /></label>
