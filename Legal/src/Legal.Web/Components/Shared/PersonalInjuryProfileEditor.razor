            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Role</span><input class="form-control" list="pie-vehicle-roles" @bind="row.RoleCode" /></label>
                        <label class="um-field"><span class="um-field-label">Description</span><input class="form-control" @bind="row.Description" /></label>
                        <label class="um-field"><span class="um-field-label">Owner</span><input class="form-control" @bind="row.Owner" /></label>
                        <label class="um-field"><span class="um-field-label">Driver</span><input class="form-control" @bind="row.Driver" /></label>
                        <label class="um-field"><span class="um-field-label">Impact type</span><input class="form-control" @bind="row.ImpactType" /></label>
                        <label class="um-field"><span class="um-field-label">Citation</span><input class="form-control" @bind="row.Citation" /></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Notes</span><textarea class="form-control" rows="2" @bind="row.Notes"></textarea></label>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm pi-row-remove" @onclick="() => _vehicles.Remove(row)"><i class="bi bi-trash"></i></button>
                </div>
