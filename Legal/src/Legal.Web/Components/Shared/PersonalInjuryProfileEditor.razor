@using System.ComponentModel.DataAnnotations
@using Legal.Application.Features.Intelligence.Decision
@inject ApiClient Api

@* ── Reusable, self-contained editor for the authoritative PI profile. ──
   Loads PersonalInjuryProfileDto for the given MatterId, edits it via the full
   wizard form, and saves through PersonalInjuryProfileSaveRequest. Used by both
   the PI matter wizard and the generic matter detail page. *@

@if (_loading)
{
    <div class="pi-editor-loading"><i class="bi bi-hourglass-split"></i> Loading personal injury profile…</div>
}
else
{
    @if (_loadError is not null)
    {
        <div class="alert alert-danger" style="border-left: 4px solid #dc3545;">@_loadError</div>
    }
    @if (_saveError is not null)
    {
        <div class="alert alert-danger" style="border-left: 4px solid #dc3545;">@_saveError</div>
    }
    @if (_saved)
    {
        <div class="alert alert-success">Personal injury profile saved.</div>
    }

    <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <section class="intel-panel pi-wizard-section">
            <h2><i class="bi bi-geo-alt"></i> Incident</h2>
            <div class="um-form-grid">
                <label class="um-field">
                    <span class="um-field-label">Incident type</span>
                    <InputText class="form-control" list="pie-incident-types" @bind-Value="_form.IncidentTypeCode" autocomplete="off" />
                    <datalist id="pie-incident-types">@foreach (var v in _options.IncidentTypes){<option value="@v" />}</datalist>
                    <ValidationMessage For="() => _form.IncidentTypeCode" class="text-danger" />
                </label>
                <label class="um-field">
                    <span class="um-field-label">Incident date</span>
                    <InputDate class="form-control" @bind-Value="_form.IncidentDate" />
                </label>
                <label class="um-field">
                    <span class="um-field-label">Incident time</span>
                    <input type="time" class="form-control" value="@(_form.IncidentTime?.ToString("HH:mm"))" @onchange="OnIncidentTimeChanged" />
                </label>
                <label class="um-field">
                    <span class="um-field-label">Location</span>
                    <InputText class="form-control" @bind-Value="_form.IncidentLocation" autocomplete="off" />
                    <ValidationMessage For="() => _form.IncidentLocation" class="text-danger" />
                </label>
                <label class="um-field">
                    <span class="um-field-label">City</span>
                    <InputText class="form-control" @bind-Value="_form.IncidentCity" autocomplete="off" />
                    <ValidationMessage For="() => _form.IncidentCity" class="text-danger" />
                </label>
                <label class="um-field">
                    <span class="um-field-label">County</span>
                    <InputText class="form-control" @bind-Value="_form.IncidentCounty" autocomplete="off" />
                    <ValidationMessage For="() => _form.IncidentCounty" class="text-danger" />
                </label>
                <label class="um-field">
                    <span class="um-field-label">State</span>
                    <InputText class="form-control" @bind-Value="_form.IncidentState" autocomplete="off" />
                    <ValidationMessage For="() => _form.IncidentState" class="text-danger" />
                </label>
                <label class="um-field um-field--full">
                    <span class="um-field-label">Incident summary</span>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_form.IncidentSummary" />
                </label>
            </div>
        </section>

        <section class="intel-panel pi-wizard-section">
            <h2><i class="bi bi-diagram-3"></i> Case posture &amp; narrative</h2>
            <div class="um-form-grid">
                <label class="um-field">
                    <span class="um-field-label">Current stage</span>
                    <InputText class="form-control" list="pie-stages" @bind-Value="_form.CurrentStageCode" autocomplete="off" />
                    <datalist id="pie-stages">@foreach (var v in _options.MatterStages){<option value="@v" />}</datalist>
                </label>
                <label class="um-field">
                    <span class="um-field-label">Litigation status</span>
                    <InputText class="form-control" list="pie-litstatus" @bind-Value="_form.LitigationStatusCode" autocomplete="off" />
                    <datalist id="pie-litstatus">@foreach (var v in _options.LitigationStatuses){<option value="@v" />}</datalist>
                </label>
                <label class="um-field">
                    <span class="um-field-label">Demand status</span>
                    <InputText class="form-control" list="pie-demandstatus" @bind-Value="_form.DemandStatusCode" autocomplete="off" />
                    <datalist id="pie-demandstatus">@foreach (var v in _options.DemandStatuses){<option value="@v" />}</datalist>
                </label>
                <label class="um-field">
                    <span class="um-field-label">Settlement status</span>
                    <InputText class="form-control" list="pie-settlestatus" @bind-Value="_form.SettlementStatusCode" autocomplete="off" />
                    <datalist id="pie-settlestatus">@foreach (var v in _options.SettlementStatuses){<option value="@v" />}</datalist>
                </label>
                <label class="um-field um-field--full">
                    <span class="um-field-label">Liability summary</span>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_form.LiabilitySummary" />
                </label>
                <label class="um-field um-field--full">
                    <span class="um-field-label">Injury summary</span>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_form.InjurySummary" />
                </label>
                <label class="um-field um-field--full">
                    <span class="um-field-label">Treatment summary</span>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_form.TreatmentSummary" />
                </label>
                <label class="um-field um-field--full">
                    <span class="um-field-label">Damages summary</span>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_form.DamagesSummary" />
                </label>
            </div>
        </section>

        @* ── Insurance policies ── *@
        <section class="intel-panel pi-wizard-section">
            <div class="pi-section-head">
                <h2><i class="bi bi-shield-check"></i> Insurance policies</h2>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _insurance.Add(new())"><i class="bi bi-plus-lg"></i> Add policy</button>
            </div>
            @foreach (var row in _insurance)
            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Carrier</span><input class="form-control" @bind="row.Carrier" /></label>
                        <label class="um-field"><span class="um-field-label">Insured</span><input class="form-control" @bind="row.Insured" /></label>
                        <label class="um-field"><span class="um-field-label">Adjuster</span><input class="form-control" @bind="row.Adjuster" /></label>
                        <label class="um-field"><span class="um-field-label">Claim #</span><input class="form-control" @bind="row.ClaimNumber" /></label>
                        <label class="um-field"><span class="um-field-label">Policy #</span><input class="form-control" @bind="row.PolicyNumber" /></label>
                        <label class="um-field"><span class="um-field-label">Coverage type</span><input class="form-control" list="pie-coverage-types" @bind="row.CoverageTypeCode" /></label>
                        <label class="um-field"><span class="um-field-label">BI limit / person</span><input type="number" step="0.01" class="form-control" @bind="row.BodilyInjuryLimitPerPerson" /></label>
                        <label class="um-field"><span class="um-field-label">BI limit / occurrence</span><input type="number" step="0.01" class="form-control" @bind="row.BodilyInjuryLimitPerOccur" /></label>
                        <label class="um-field"><span class="um-field-label">Coverage status</span><input class="form-control" list="pie-coverage-statuses" @bind="row.CoverageStatusCode" /></label>
                        <label class="um-field"><span class="um-field-label">Limits source</span><input class="form-control" @bind="row.LimitsSource" /></label>
                        <label class="um-field pi-check"><input type="checkbox" @bind="row.LimitsVerified" /><span>Limits verified</span></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Notes</span><textarea class="form-control" rows="2" @bind="row.Notes"></textarea></label>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm pi-row-remove" @onclick="() => _insurance.Remove(row)"><i class="bi bi-trash"></i></button>
                </div>
            }
            <datalist id="pie-coverage-types">@foreach (var v in _options.CoverageTypes){<option value="@v" />}</datalist>
            <datalist id="pie-coverage-statuses">@foreach (var v in _options.CoverageStatuses){<option value="@v" />}</datalist>
        </section>

        @* ── Injuries ── *@
        <section class="intel-panel pi-wizard-section">
            <div class="pi-section-head">
                <h2><i class="bi bi-activity"></i> Injuries</h2>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _injuries.Add(new())"><i class="bi bi-plus-lg"></i> Add injury</button>
            </div>
            @foreach (var row in _injuries)
            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Body area</span><input class="form-control" list="pie-body-areas" @bind="row.BodyAreaCode" /></label>
                        <label class="um-field"><span class="um-field-label">Severity</span><input class="form-control" list="pie-injury-severities" @bind="row.SeverityCode" /></label>
                        <label class="um-field"><span class="um-field-label">Diagnosis</span><input class="form-control" @bind="row.Diagnosis" /></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Initial symptoms</span><input class="form-control" @bind="row.InitialSymptoms" /></label>
                        <label class="um-field pi-check"><input type="checkbox" @bind="row.IsPreexisting" /><span>Preexisting</span></label>
                        <label class="um-field pi-check"><input type="checkbox" @bind="row.ClaimedPermanency" /><span>Permanency</span></label>
                        <label class="um-field pi-check"><input type="checkbox" @bind="row.SurgeryRecommended" /><span>Surgery rec.</span></label>
                        <label class="um-field pi-check"><input type="checkbox" @bind="row.SurgeryPerformed" /><span>Surgery done</span></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Notes</span><textarea class="form-control" rows="2" @bind="row.Notes"></textarea></label>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm pi-row-remove" @onclick="() => _injuries.Remove(row)"><i class="bi bi-trash"></i></button>
                </div>
            }
            <datalist id="pie-body-areas">@foreach (var v in _options.BodyAreas){<option value="@v" />}</datalist>
            <datalist id="pie-injury-severities">@foreach (var v in _options.InjurySeverities){<option value="@v" />}</datalist>
        </section>

        @* ── Treatments ── *@
        <section class="intel-panel pi-wizard-section">
            <div class="pi-section-head">
                <h2><i class="bi bi-hospital"></i> Treatments</h2>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _treatments.Add(new())"><i class="bi bi-plus-lg"></i> Add treatment</button>
            </div>
            @foreach (var row in _treatments)
            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Provider</span><input class="form-control" @bind="row.Provider" /></label>
                        <label class="um-field"><span class="um-field-label">Specialty</span><input class="form-control" @bind="row.Specialty" /></label>
                        <label class="um-field"><span class="um-field-label">First treatment</span><input type="date" class="form-control" @bind="row.FirstTreatmentDate" /></label>
                        <label class="um-field"><span class="um-field-label">Last treatment</span><input type="date" class="form-control" @bind="row.LastTreatmentDate" /></label>
                        <label class="um-field"><span class="um-field-label">Status</span><input class="form-control" list="pie-treatment-statuses" @bind="row.StatusCode" /></label>
                        <label class="um-field"><span class="um-field-label">Visits</span><input type="number" class="form-control" @bind="row.VisitCount" /></label>
                        <label class="um-field"><span class="um-field-label">Treatment gap (days)</span><input type="number" class="form-control" @bind="row.TreatmentGapDays" /></label>
                        <label class="um-field"><span class="um-field-label">Record request status</span><input class="form-control" @bind="row.RecordRequestStatus" /></label>
                        <label class="um-field"><span class="um-field-label">Bill request status</span><input class="form-control" @bind="row.BillRequestStatus" /></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Notes</span><textarea class="form-control" rows="2" @bind="row.Notes"></textarea></label>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm pi-row-remove" @onclick="() => _treatments.Remove(row)"><i class="bi bi-trash"></i></button>
                </div>
            }
            <datalist id="pie-treatment-statuses">@foreach (var v in _options.TreatmentStatuses){<option value="@v" />}</datalist>
        </section>

        @* ── Medical bills ── *@
        <section class="intel-panel pi-wizard-section">
            <div class="pi-section-head">
                <h2><i class="bi bi-receipt"></i> Medical bills</h2>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _bills.Add(new())"><i class="bi bi-plus-lg"></i> Add bill</button>
            </div>
            @foreach (var row in _bills)
            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Provider</span><input class="form-control" @bind="row.Provider" /></label>
                        <label class="um-field"><span class="um-field-label">Billed</span><input type="number" step="0.01" class="form-control" @bind="row.AmountBilled" /></label>
                        <label class="um-field"><span class="um-field-label">Adjustments</span><input type="number" step="0.01" class="form-control" @bind="row.Adjustments" /></label>
                        <label class="um-field"><span class="um-field-label">Paid</span><input type="number" step="0.01" class="form-control" @bind="row.AmountPaid" /></label>
                        <label class="um-field"><span class="um-field-label">Outstanding</span><input type="number" step="0.01" class="form-control" @bind="row.OutstandingBalance" /></label>
                        <label class="um-field"><span class="um-field-label">Payer</span><input class="form-control" @bind="row.Payer" /></label>
                        <label class="um-field"><span class="um-field-label">Lien status</span><input class="form-control" list="pie-lien-statuses" @bind="row.LienStatusCode" /></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Notes</span><textarea class="form-control" rows="2" @bind="row.Notes"></textarea></label>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm pi-row-remove" @onclick="() => _bills.Remove(row)"><i class="bi bi-trash"></i></button>
                </div>
            }
        </section>

        @* ── Damages ── *@
        <section class="intel-panel pi-wizard-section">
            <div class="pi-section-head">
                <h2><i class="bi bi-cash-coin"></i> Damages</h2>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _damages.Add(new())"><i class="bi bi-plus-lg"></i> Add damage</button>
            </div>
            @foreach (var row in _damages)
            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Damage type</span><input class="form-control" list="pie-damage-types" @bind="row.DamageTypeCode" /></label>
                        <label class="um-field"><span class="um-field-label">Claimed amount</span><input type="number" step="0.01" class="form-control" @bind="row.ClaimedAmount" /></label>
                        <label class="um-field pi-check"><input type="checkbox" @bind="row.IsEconomic" /><span>Economic</span></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Description</span><input class="form-control" @bind="row.Description" /></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Notes</span><textarea class="form-control" rows="2" @bind="row.Notes"></textarea></label>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm pi-row-remove" @onclick="() => _damages.Remove(row)"><i class="bi bi-trash"></i></button>
                </div>
            }
            <datalist id="pie-damage-types">@foreach (var v in _options.DamageTypes){<option value="@v" />}</datalist>
        </section>

        @* ── Liens ── *@
        <section class="intel-panel pi-wizard-section">
            <div class="pi-section-head">
                <h2><i class="bi bi-link-45deg"></i> Liens</h2>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _liens.Add(new())"><i class="bi bi-plus-lg"></i> Add lien</button>
            </div>
            @foreach (var row in _liens)
            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Lienholder</span><input class="form-control" @bind="row.Lienholder" /></label>
                        <label class="um-field"><span class="um-field-label">Lien type</span><input class="form-control" list="pie-lien-types" @bind="row.LienTypeCode" /></label>
                        <label class="um-field"><span class="um-field-label">Asserted</span><input type="number" step="0.01" class="form-control" @bind="row.AssertedAmount" /></label>
                        <label class="um-field"><span class="um-field-label">Verified</span><input type="number" step="0.01" class="form-control" @bind="row.VerifiedAmount" /></label>
                        <label class="um-field"><span class="um-field-label">Negotiated</span><input type="number" step="0.01" class="form-control" @bind="row.NegotiatedAmount" /></label>
                        <label class="um-field"><span class="um-field-label">Final payoff</span><input type="number" step="0.01" class="form-control" @bind="row.FinalPayoffAmount" /></label>
                        <label class="um-field"><span class="um-field-label">Status</span><input class="form-control" list="pie-lien-statuses" @bind="row.StatusCode" /></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Notes</span><textarea class="form-control" rows="2" @bind="row.Notes"></textarea></label>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm pi-row-remove" @onclick="() => _liens.Remove(row)"><i class="bi bi-trash"></i></button>
                </div>
            }
            <datalist id="pie-lien-types">@foreach (var v in _options.LienTypes){<option value="@v" />}</datalist>
            <datalist id="pie-lien-statuses">@foreach (var v in _options.LienStatuses){<option value="@v" />}</datalist>
        </section>

        @* ── Demands ── *@
        <section class="intel-panel pi-wizard-section">
            <div class="pi-section-head">
                <h2><i class="bi bi-envelope-paper"></i> Demands</h2>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _demands.Add(new())"><i class="bi bi-plus-lg"></i> Add demand</button>
            </div>
            @foreach (var row in _demands)
            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Demand date</span><input type="date" class="form-control" @bind="row.DemandDate" /></label>
                        <label class="um-field"><span class="um-field-label">Amount</span><input type="number" step="0.01" class="form-control" @bind="row.DemandAmount" /></label>
                        <label class="um-field"><span class="um-field-label">Recipient</span><input class="form-control" @bind="row.Recipient" /></label>
                        <label class="um-field"><span class="um-field-label">Response deadline</span><input type="date" class="form-control" @bind="row.ResponseDeadline" /></label>
                        <label class="um-field"><span class="um-field-label">Status</span><input class="form-control" list="pie-demandstatus" @bind="row.StatusCode" /></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Notes</span><textarea class="form-control" rows="2" @bind="row.Notes"></textarea></label>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm pi-row-remove" @onclick="() => _demands.Remove(row)"><i class="bi bi-trash"></i></button>
                </div>
            }
        </section>

        @* ── Negotiations ── *@
        <section class="intel-panel pi-wizard-section">
            <div class="pi-section-head">
                <h2><i class="bi bi-chat-left-dots"></i> Negotiations</h2>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _negotiations.Add(new())"><i class="bi bi-plus-lg"></i> Add entry</button>
            </div>
            @foreach (var row in _negotiations)
            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Date</span><input type="date" class="form-control" @bind="row.EventDate" /></label>
                        <label class="um-field"><span class="um-field-label">Amount</span><input type="number" step="0.01" class="form-control" @bind="row.Amount" /></label>
                        <label class="um-field"><span class="um-field-label">Source</span><input class="form-control" @bind="row.Source" /></label>
                        <label class="um-field pi-check"><input type="checkbox" @bind="row.IsOffer" /><span>Offer</span></label>
                        <label class="um-field"><span class="um-field-label">Expires</span><input type="date" class="form-control" @bind="row.ExpirationDate" /></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Conditions</span><input class="form-control" @bind="row.Conditions" /></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Notes</span><textarea class="form-control" rows="2" @bind="row.Notes"></textarea></label>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm pi-row-remove" @onclick="() => _negotiations.Remove(row)"><i class="bi bi-trash"></i></button>
                </div>
            }
        </section>

        @* ── Settlements ── *@
        <section class="intel-panel pi-wizard-section">
            <div class="pi-section-head">
                <h2><i class="bi bi-cash-stack"></i> Settlements</h2>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _settlements.Add(new())"><i class="bi bi-plus-lg"></i> Add settlement</button>
            </div>
            @foreach (var row in _settlements)
            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Gross recovery</span><input type="number" step="0.01" class="form-control" @bind="row.GrossRecovery" /></label>
                        <label class="um-field"><span class="um-field-label">Fees</span><input type="number" step="0.01" class="form-control" @bind="row.Fees" /></label>
                        <label class="um-field"><span class="um-field-label">Costs</span><input type="number" step="0.01" class="form-control" @bind="row.Costs" /></label>
                        <label class="um-field"><span class="um-field-label">Liens</span><input type="number" step="0.01" class="form-control" @bind="row.Liens" /></label>
                        <label class="um-field"><span class="um-field-label">Net to client</span><input type="number" step="0.01" class="form-control" @bind="row.NetToClient" /></label>
                        <label class="um-field"><span class="um-field-label">Status</span><input class="form-control" list="pie-settlestatus" @bind="row.StatusCode" /></label>
                        <label class="um-field"><span class="um-field-label">Settlement date</span><input type="date" class="form-control" @bind="row.SettlementDate" /></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Notes</span><textarea class="form-control" rows="2" @bind="row.Notes"></textarea></label>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm pi-row-remove" @onclick="() => _settlements.Remove(row)"><i class="bi bi-trash"></i></button>
                </div>
            }
        </section>

        @* ── Deadlines ── *@
        <section class="intel-panel pi-wizard-section">
            <div class="pi-section-head">
                <h2><i class="bi bi-calendar-event"></i> Deadlines</h2>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _deadlines.Add(new())"><i class="bi bi-plus-lg"></i> Add deadline</button>
            </div>
            @foreach (var row in _deadlines)
            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Deadline type</span><input class="form-control" @bind="row.DeadlineTypeCode" /></label>
                        <label class="um-field"><span class="um-field-label">Candidate date</span><input type="date" class="form-control" @bind="row.CandidateDate" /></label>
                        <label class="um-field"><span class="um-field-label">Rule source</span><input class="form-control" list="pie-rule-sources" @bind="row.RuleSourceCode" /></label>
                        <label class="um-field"><span class="um-field-label">Verification</span><input class="form-control" list="pie-deadline-verif" @bind="row.VerificationState" /></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Notes</span><textarea class="form-control" rows="2" @bind="row.Notes"></textarea></label>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm pi-row-remove" @onclick="() => _deadlines.Remove(row)"><i class="bi bi-trash"></i></button>
                </div>
            }
            <datalist id="pie-rule-sources">@foreach (var v in _options.DeadlineRuleSources){<option value="@v" />}</datalist>
            <datalist id="pie-deadline-verif">@foreach (var v in _options.DeadlineVerificationStates){<option value="@v" />}</datalist>
        </section>

        @* ── Incident vehicles ── *@
        <section class="intel-panel pi-wizard-section">
            <div class="pi-section-head">
                <h2><i class="bi bi-car-front"></i> Incident vehicles</h2>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _vehicles.Add(new())"><i class="bi bi-plus-lg"></i> Add vehicle</button>
            </div>
            @foreach (var row in _vehicles)
            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Role</span><input class="form-control" list="pie-vehicle-roles" @bind="row.RoleCode" /></label>
                        <label class="um-field"><span class="um-field-label">Description</span><input class="form-control" @bind="row.Description" /></label>
                        <label class="um-field"><span class="um-field-label">Owner</span><input class="form-control" @bind="row.Owner" /></label>
                        <label class="um-field"><span class="um-field-label">Driver</span><input class="form-control" @bind="row.Driver" /></label>
                        <label class="um-field"><span class="um-field-label">Impact type</span><input class="form-control" @bind="row.ImpactType" /></label>
                        <label class="um-field"><span class="um-field-label">Citation</span><input class="form-control" @bind="row.Citation" /></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Notes</span><textarea class="form-control" rows="2" @bind="row.Notes"></textarea></label>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm pi-row-remove" @onclick="() => _vehicles.Remove(row)"><i class="bi bi-trash"></i></button>
                </div>
            }
            <datalist id="pie-vehicle-roles">@foreach (var v in _options.VehicleRoles){<option value="@v" />}</datalist>
        </section>

        @* ── Witnesses ── *@
        <section class="intel-panel pi-wizard-section">
            <div class="pi-section-head">
                <h2><i class="bi bi-people"></i> Witnesses</h2>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _witnesses.Add(new())"><i class="bi bi-plus-lg"></i> Add witness</button>
            </div>
            @foreach (var row in _witnesses)
            {
                <div class="pi-row-card">
                    <div class="um-form-grid">
                        <label class="um-field"><span class="um-field-label">Name</span><input class="form-control" @bind="row.Name" /></label>
                        <label class="um-field"><span class="um-field-label">Contact</span><input class="form-control" @bind="row.ContactInfo" /></label>
                        <label class="um-field pi-check"><input type="checkbox" @bind="row.SupportsClient" /><span>Supports client</span></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Statement summary</span><input class="form-control" @bind="row.StatementSummary" /></label>
                        <label class="um-field um-field--full"><span class="um-field-label">Notes</span><textarea class="form-control" rows="2" @bind="row.Notes"></textarea></label>
                    </div>
                    <button type="button" class="um-btn um-btn-ghost um-btn-sm pi-row-remove" @onclick="() => _witnesses.Remove(row)"><i class="bi bi-trash"></i></button>
                </div>
            }
        </section>

        @if (ShowFooter)
        {
            <div class="pi-wizard-footer">
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving">
                    <i class="bi @(_saving ? "bi-hourglass-split" : "bi-check-lg")"></i> @(_saving ? "Saving…" : "Save PI profile")
                </button>
            </div>
        }
    </EditForm>
}

@code {
    [Parameter, EditorRequired] public Guid MatterId { get; set; }

    // When false, the host page provides its own Save button and calls SaveAsync via @ref.
    [Parameter] public bool ShowFooter { get; set; } = true;

    // Raised after a successful save so host pages can refresh dependent data.
    [Parameter] public EventCallback OnSaved { get; set; }

    public bool IsSaving => _saving;

    private bool _loading = true;
    private bool _saving;
    private bool _saved;
    private string? _loadError;
    private string? _saveError;

    private PersonalInjuryOptionsDto _options = new();
    private ProfileForm _form = new();

    private readonly List<InsuranceRow> _insurance = [];
    private readonly List<InjuryRow> _injuries = [];
    private readonly List<TreatmentRow> _treatments = [];
    private readonly List<BillRow> _bills = [];
    private readonly List<DamageRow> _damages = [];
    private readonly List<LienRow> _liens = [];
    private readonly List<DemandRow> _demands = [];
    private readonly List<NegotiationRow> _negotiations = [];
    private readonly List<SettlementRow> _settlements = [];
    private readonly List<DeadlineRow> _deadlines = [];
    private readonly List<VehicleRow> _vehicles = [];
    private readonly List<WitnessRow> _witnesses = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    public async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _saved = false;
        StateHasChanged();
        try
        {
            _options = await Api.GetLegalDecisionPersonalInjuryOptionsAsync();
            var profile = await Api.GetLegalDecisionPersonalInjuryProfileAsync(MatterId);
            if (profile is not null)
                Hydrate(profile);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load personal injury profile: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void OnIncidentTimeChanged(ChangeEventArgs e)
        => _form.IncidentTime = TimeOnly.TryParse(e.Value?.ToString(), out var t) ? t : null;

    private void Hydrate(PersonalInjuryProfileDto p)
    {
        _form = new ProfileForm
        {
            IncidentTypeCode = p.IncidentTypeCode,
            IncidentDate = p.IncidentDate,
            IncidentTime = p.IncidentTime,
            IncidentLocation = p.IncidentLocation,
            IncidentCity = p.IncidentCity,
            IncidentCounty = p.IncidentCounty,
            IncidentState = p.IncidentState,
            IncidentSummary = p.IncidentSummary,
            LiabilitySummary = p.LiabilitySummary,
            InjurySummary = p.InjurySummary,
            TreatmentSummary = p.TreatmentSummary,
            DamagesSummary = p.DamagesSummary,
            CurrentStageCode = p.CurrentStageCode,
            LitigationStatusCode = p.LitigationStatusCode,
            DemandStatusCode = p.DemandStatusCode,
            SettlementStatusCode = p.SettlementStatusCode,
        };
        _insurance.Clear();
        foreach (var x in p.InsurancePolicies)
            _insurance.Add(new() { Carrier = x.Carrier, Insured = x.Insured, Adjuster = x.Adjuster, ClaimNumber = x.ClaimNumber, PolicyNumber = x.PolicyNumber, CoverageTypeCode = x.CoverageTypeCode, BodilyInjuryLimitPerPerson = x.BodilyInjuryLimitPerPerson, BodilyInjuryLimitPerOccur = x.BodilyInjuryLimitPerOccur, CoverageStatusCode = x.CoverageStatusCode, LimitsSource = x.LimitsSource, LimitsVerified = x.LimitsVerified, Notes = x.Notes });
        _injuries.Clear();
        foreach (var x in p.Injuries)
            _injuries.Add(new() { BodyAreaCode = x.BodyAreaCode, InitialSymptoms = x.InitialSymptoms, Diagnosis = x.Diagnosis, IsPreexisting = x.IsPreexisting, ClaimedPermanency = x.ClaimedPermanency, SurgeryRecommended = x.SurgeryRecommended, SurgeryPerformed = x.SurgeryPerformed, SeverityCode = x.SeverityCode, Notes = x.Notes });
        _treatments.Clear();
        foreach (var x in p.Treatments)
            _treatments.Add(new() { Provider = x.Provider, Specialty = x.Specialty, FirstTreatmentDate = x.FirstTreatmentDate, LastTreatmentDate = x.LastTreatmentDate, StatusCode = x.StatusCode, VisitCount = x.VisitCount, RecordRequestStatus = x.RecordRequestStatus, BillRequestStatus = x.BillRequestStatus, TreatmentGapDays = x.TreatmentGapDays, Notes = x.Notes });
        _bills.Clear();
        foreach (var x in p.MedicalBills)
            _bills.Add(new() { Provider = x.Provider, AmountBilled = x.AmountBilled, Adjustments = x.Adjustments, AmountPaid = x.AmountPaid, OutstandingBalance = x.OutstandingBalance, Payer = x.Payer, LienStatusCode = x.LienStatusCode, Notes = x.Notes });
        _damages.Clear();
        foreach (var x in p.Damages)
            _damages.Add(new() { DamageTypeCode = x.DamageTypeCode, Description = x.Description, ClaimedAmount = x.ClaimedAmount, IsEconomic = x.IsEconomic, Notes = x.Notes });
        _liens.Clear();
        foreach (var x in p.Liens)
            _liens.Add(new() { Lienholder = x.Lienholder, LienTypeCode = x.LienTypeCode, AssertedAmount = x.AssertedAmount, VerifiedAmount = x.VerifiedAmount, NegotiatedAmount = x.NegotiatedAmount, FinalPayoffAmount = x.FinalPayoffAmount, StatusCode = x.StatusCode, Notes = x.Notes });
        _demands.Clear();
        foreach (var x in p.Demands)
            _demands.Add(new() { DemandDate = x.DemandDate, DemandAmount = x.DemandAmount, Recipient = x.Recipient, ResponseDeadline = x.ResponseDeadline, StatusCode = x.StatusCode, Notes = x.Notes });
        _negotiations.Clear();
        foreach (var x in p.Negotiations)
            _negotiations.Add(new() { EventDate = x.EventDate, Amount = x.Amount, Source = x.Source, IsOffer = x.IsOffer, Conditions = x.Conditions, ExpirationDate = x.ExpirationDate, Notes = x.Notes });
        _settlements.Clear();
        foreach (var x in p.Settlements)
            _settlements.Add(new() { GrossRecovery = x.GrossRecovery, Fees = x.Fees, Costs = x.Costs, Liens = x.Liens, NetToClient = x.NetToClient, StatusCode = x.StatusCode, SettlementDate = x.SettlementDate, Notes = x.Notes });
        _deadlines.Clear();
        foreach (var x in p.Deadlines)
            _deadlines.Add(new() { DeadlineTypeCode = x.DeadlineTypeCode, CandidateDate = x.CandidateDate, RuleSourceCode = x.RuleSourceCode, VerificationState = x.VerificationState, Notes = x.Notes });
        _vehicles.Clear();
        foreach (var x in p.IncidentVehicles)
            _vehicles.Add(new() { RoleCode = x.RoleCode, Description = x.Description, Owner = x.Owner, Driver = x.Driver, ImpactType = x.ImpactType, Citation = x.Citation, Notes = x.Notes });
        _witnesses.Clear();
        foreach (var x in p.Witnesses)
            _witnesses.Add(new() { Name = x.Name, ContactInfo = x.ContactInfo, StatementSummary = x.StatementSummary, SupportsClient = x.SupportsClient ?? false, Notes = x.Notes });
    }

    public async Task SaveAsync()
    {
        _saving = true;
        _saveError = null;
        _saved = false;
        StateHasChanged();
        try
        {
            var request = new PersonalInjuryProfileSaveRequest
            {
                IncidentTypeCode = _form.IncidentTypeCode,
                IncidentDate = _form.IncidentDate,
                IncidentTime = _form.IncidentTime,
                IncidentLocation = _form.IncidentLocation,
                IncidentCity = _form.IncidentCity,
                IncidentCounty = _form.IncidentCounty,
                IncidentState = _form.IncidentState,
                IncidentSummary = _form.IncidentSummary,
                LiabilitySummary = _form.LiabilitySummary,
                InjurySummary = _form.InjurySummary,
                TreatmentSummary = _form.TreatmentSummary,
                DamagesSummary = _form.DamagesSummary,
                CurrentStageCode = _form.CurrentStageCode,
                LitigationStatusCode = _form.LitigationStatusCode,
                DemandStatusCode = _form.DemandStatusCode,
                SettlementStatusCode = _form.SettlementStatusCode,
                InsurancePolicies = _insurance.Select(x => new PersonalInjuryInsurancePolicyDto() { Id = Guid.NewGuid(), Carrier = x.Carrier, Insured = x.Insured, Adjuster = x.Adjuster, ClaimNumber = x.ClaimNumber, PolicyNumber = x.PolicyNumber, CoverageTypeCode = x.CoverageTypeCode, BodilyInjuryLimitPerPerson = x.BodilyInjuryLimitPerPerson, BodilyInjuryLimitPerOccur = x.BodilyInjuryLimitPerOccur, CoverageStatusCode = x.CoverageStatusCode, LimitsSource = x.LimitsSource, LimitsVerified = x.LimitsVerified, Notes = x.Notes }).ToList(),
                Injuries = _injuries.Select(x => new PersonalInjuryInjuryDto() { Id = Guid.NewGuid(), BodyAreaCode = x.BodyAreaCode, InitialSymptoms = x.InitialSymptoms, Diagnosis = x.Diagnosis, IsPreexisting = x.IsPreexisting, ClaimedPermanency = x.ClaimedPermanency, SurgeryRecommended = x.SurgeryRecommended, SurgeryPerformed = x.SurgeryPerformed, SeverityCode = x.SeverityCode, Notes = x.Notes }).ToList(),
                Treatments = _treatments.Select(x => new PersonalInjuryTreatmentDto() { Id = Guid.NewGuid(), Provider = x.Provider, Specialty = x.Specialty, FirstTreatmentDate = x.FirstTreatmentDate, LastTreatmentDate = x.LastTreatmentDate, StatusCode = x.StatusCode, VisitCount = x.VisitCount, RecordRequestStatus = x.RecordRequestStatus, BillRequestStatus = x.BillRequestStatus, TreatmentGapDays = x.TreatmentGapDays, Notes = x.Notes }).ToList(),
                MedicalBills = _bills.Select(x => new PersonalInjuryMedicalBillDto() { Id = Guid.NewGuid(), Provider = x.Provider, AmountBilled = x.AmountBilled, Adjustments = x.Adjustments, AmountPaid = x.AmountPaid, OutstandingBalance = x.OutstandingBalance, Payer = x.Payer, LienStatusCode = x.LienStatusCode, Notes = x.Notes }).ToList(),
                Damages = _damages.Select(x => new PersonalInjuryDamageDto() { Id = Guid.NewGuid(), DamageTypeCode = x.DamageTypeCode, Description = x.Description, ClaimedAmount = x.ClaimedAmount, IsEconomic = x.IsEconomic, Notes = x.Notes }).ToList(),
                Liens = _liens.Select(x => new PersonalInjuryLienDto() { Id = Guid.NewGuid(), Lienholder = x.Lienholder, LienTypeCode = x.LienTypeCode, AssertedAmount = x.AssertedAmount, VerifiedAmount = x.VerifiedAmount, NegotiatedAmount = x.NegotiatedAmount, FinalPayoffAmount = x.FinalPayoffAmount, StatusCode = x.StatusCode, Notes = x.Notes }).ToList(),
                Demands = _demands.Select(x => new PersonalInjuryDemandDto() { Id = Guid.NewGuid(), DemandDate = x.DemandDate, DemandAmount = x.DemandAmount, Recipient = x.Recipient, ResponseDeadline = x.ResponseDeadline, StatusCode = x.StatusCode, Notes = x.Notes }).ToList(),
                Negotiations = _negotiations.Select(x => new PersonalInjuryNegotiationDto() { Id = Guid.NewGuid(), EventDate = x.EventDate, Amount = x.Amount, Source = x.Source, IsOffer = x.IsOffer, Conditions = x.Conditions, ExpirationDate = x.ExpirationDate, Notes = x.Notes }).ToList(),
                Settlements = _settlements.Select(x => new PersonalInjurySettlementDto() { Id = Guid.NewGuid(), GrossRecovery = x.GrossRecovery, Fees = x.Fees, Costs = x.Costs, Liens = x.Liens, NetToClient = x.NetToClient, StatusCode = x.StatusCode, SettlementDate = x.SettlementDate, Notes = x.Notes }).ToList(),
                Deadlines = _deadlines.Select(x => new PersonalInjuryDeadlineDto() { Id = Guid.NewGuid(), DeadlineTypeCode = x.DeadlineTypeCode, CandidateDate = x.CandidateDate, RuleSourceCode = x.RuleSourceCode, VerificationState = x.VerificationState, Notes = x.Notes }).ToList(),
                IncidentVehicles = _vehicles.Select(x => new PersonalInjuryIncidentVehicleDto() { Id = Guid.NewGuid(), RoleCode = x.RoleCode, Description = x.Description, Owner = x.Owner, Driver = x.Driver, ImpactType = x.ImpactType, Citation = x.Citation, Notes = x.Notes }).ToList(),
                Witnesses = _witnesses.Select(x => new PersonalInjuryWitnessDto() { Id = Guid.NewGuid(), Name = x.Name, ContactInfo = x.ContactInfo, StatementSummary = x.StatementSummary, SupportsClient = x.SupportsClient, Notes = x.Notes }).ToList(),
            };
            await Api.SaveLegalDecisionPersonalInjuryProfileAsync(MatterId, request);
            _saved = true;
            if (OnSaved.HasDelegate)
                await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _saveError = $"Save failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    // ── Mutable editor rows (mapped to/from the init-only DTOs) ──
    private sealed class ProfileForm
    {
        public string? IncidentTypeCode { get; set; }
        public DateOnly? IncidentDate { get; set; }
        public TimeOnly? IncidentTime { get; set; }
        [StringLength(400)] public string? IncidentLocation { get; set; }
        [StringLength(120)] public string? IncidentCity { get; set; }
        [StringLength(120)] public string? IncidentCounty { get; set; }
        [StringLength(60)] public string? IncidentState { get; set; }
        public string? IncidentSummary { get; set; }
        public string? LiabilitySummary { get; set; }
        public string? InjurySummary { get; set; }
        public string? TreatmentSummary { get; set; }
        public string? DamagesSummary { get; set; }
        public string? CurrentStageCode { get; set; }
        public string? LitigationStatusCode { get; set; }
        public string? DemandStatusCode { get; set; }
        public string? SettlementStatusCode { get; set; }
    }

    private sealed class InsuranceRow
    {
        public string? Carrier { get; set; }
        public string? Insured { get; set; }
        public string? Adjuster { get; set; }
        public string? ClaimNumber { get; set; }
        public string? PolicyNumber { get; set; }
        public string? CoverageTypeCode { get; set; }
        public decimal? BodilyInjuryLimitPerPerson { get; set; }
        public decimal? BodilyInjuryLimitPerOccur { get; set; }
        public string? CoverageStatusCode { get; set; }
        public string? LimitsSource { get; set; }
        public bool LimitsVerified { get; set; }
        public string? Notes { get; set; }
    }

    private sealed class InjuryRow
    {
        public string? BodyAreaCode { get; set; }
        public string? InitialSymptoms { get; set; }
        public string? Diagnosis { get; set; }
        public bool IsPreexisting { get; set; }
        public bool ClaimedPermanency { get; set; }
        public bool SurgeryRecommended { get; set; }
        public bool SurgeryPerformed { get; set; }
        public string? SeverityCode { get; set; }
        public string? Notes { get; set; }
    }

    private sealed class TreatmentRow
    {
        public string? Provider { get; set; }
        public string? Specialty { get; set; }
        public DateOnly? FirstTreatmentDate { get; set; }
        public DateOnly? LastTreatmentDate { get; set; }
        public string? StatusCode { get; set; }
        public int? VisitCount { get; set; }
        public string? RecordRequestStatus { get; set; }
        public string? BillRequestStatus { get; set; }
        public int? TreatmentGapDays { get; set; }
        public string? Notes { get; set; }
    }

    private sealed class BillRow
    {
        public string? Provider { get; set; }
        public decimal? AmountBilled { get; set; }
        public decimal? Adjustments { get; set; }
        public decimal? AmountPaid { get; set; }
        public decimal? OutstandingBalance { get; set; }
        public string? Payer { get; set; }
        public string? LienStatusCode { get; set; }
        public string? Notes { get; set; }
    }

    private sealed class DamageRow
    {
        public string? DamageTypeCode { get; set; }
        public string? Description { get; set; }
        public decimal? ClaimedAmount { get; set; }
        public bool IsEconomic { get; set; }
        public string? Notes { get; set; }
    }

    private sealed class LienRow
    {
        public string? Lienholder { get; set; }
        public string? LienTypeCode { get; set; }
        public decimal? AssertedAmount { get; set; }
        public decimal? VerifiedAmount { get; set; }
        public decimal? NegotiatedAmount { get; set; }
        public decimal? FinalPayoffAmount { get; set; }
        public string? StatusCode { get; set; }
        public string? Notes { get; set; }
    }

    private sealed class DemandRow
    {
        public DateOnly? DemandDate { get; set; }
        public decimal? DemandAmount { get; set; }
        public string? Recipient { get; set; }
        public DateOnly? ResponseDeadline { get; set; }
        public string? StatusCode { get; set; }
        public string? Notes { get; set; }
    }

    private sealed class NegotiationRow
    {
        public DateOnly? EventDate { get; set; }
        public decimal? Amount { get; set; }
        public string? Source { get; set; }
        public bool IsOffer { get; set; }
        public string? Conditions { get; set; }
        public DateOnly? ExpirationDate { get; set; }
        public string? Notes { get; set; }
    }

    private sealed class SettlementRow
    {
        public decimal? GrossRecovery { get; set; }
        public decimal? Fees { get; set; }
        public decimal? Costs { get; set; }
        public decimal? Liens { get; set; }
        public decimal? NetToClient { get; set; }
        public string? StatusCode { get; set; }
        public DateOnly? SettlementDate { get; set; }
        public string? Notes { get; set; }
    }

    private sealed class DeadlineRow
    {
        public string? DeadlineTypeCode { get; set; }
        public DateOnly? CandidateDate { get; set; }
        public string? RuleSourceCode { get; set; }
        public string? VerificationState { get; set; }
        public string? Notes { get; set; }
    }

    private sealed class VehicleRow
    {
        public string? RoleCode { get; set; }
        public string? Description { get; set; }
        public string? Owner { get; set; }
        public string? Driver { get; set; }
        public string? ImpactType { get; set; }
        public string? Citation { get; set; }
        public string? Notes { get; set; }
    }

    private sealed class WitnessRow
    {
        public string? Name { get; set; }
        public string? ContactInfo { get; set; }
        public string? StatementSummary { get; set; }
        public bool SupportsClient { get; set; }
        public string? Notes { get; set; }
    }
}
