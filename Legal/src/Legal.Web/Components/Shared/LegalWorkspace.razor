<div class="intel-shell @ExtraClass">
    <section class="intel-workspace-nav" aria-label="Workspace navigation">
        <div class="intel-workspace-top">
            <a class="intel-workspace-title" href="/">
                <img src="image/JudzLogo.png" alt="judz.ai — Legal Intelligence" class="intel-brand-logo" />
                <span class="intel-brand-word"><strong>judz<span>.ai</span></strong><small>LEGAL INTELLIGENCE</small></span>
            </a>
            <a class="intel-brand-powered" href="https://poloxi.ai" target="_blank" rel="noopener">Algorithm By: <strong>Poloxi.ai</strong></a>
        </div>
        <nav class="intel-nav" aria-label="Platform">
            <div class="intel-nav-primary">
                <NavLink href="/legal/search" Match="NavLinkMatch.All"><i class="bi bi-search"></i> Search</NavLink>
            </div>
            <span class="intel-nav-divider" aria-hidden="true"></span>
            <div class="intel-nav-groups">
                <div class="intel-nav-group" aria-label="Legal">
                    <NavLink href="/legal/matters"><i class="bi bi-folder2-open"></i> Matters</NavLink>
                    <NavLink href="/legal/decision" Match="NavLinkMatch.All"><i class="bi bi-signpost-split"></i> Decision Intelligence</NavLink>
                </div>
                <span class="intel-nav-divider" aria-hidden="true"></span>
                <div class="intel-nav-group" aria-label="Reasoning Engine">
                    <NavLink href="/legal/math/formalize"><i class="bi bi-diagram-3"></i> Formalization Gate</NavLink>
                    <NavLink href="/legal/math/solve"><i class="bi bi-calculator"></i> Math Solver</NavLink>
                    <NavLink href="/legal/math/runs"><i class="bi bi-clock-history"></i> Math Runs</NavLink>
                </div>
                <span class="intel-nav-divider" aria-hidden="true"></span>
                <div class="intel-nav-group" aria-label="System">
                    <NavLink href="/legal/configuration"><i class="bi bi-sliders"></i> Configuration</NavLink>
                </div>
            </div>
        </nav>
    </section>
    <main class="intel-content">@ChildContent</main>
</div>
@code{[Parameter]public RenderFragment? ChildContent{get;set;}[Parameter]public string? ExtraClass{get;set;}}
