<div class="intel-shell @ExtraClass">
    <section class="intel-workspace-nav" aria-label="Workspace navigation">
        <div class="intel-workspace-top">
            <a class="intel-workspace-title" href="/">
                <img src="image/JudzLogo.png" alt="Judz.ai — Legal Intelligence" class="intel-brand-logo" />
                <span class="intel-brand-word"><strong>Judz<span>.ai</span></strong><small>LEGAL INTELLIGENCE</small></span>
            </a>
            <a class="intel-brand-powered" href="https://poloxi.ai" target="_blank" rel="noopener">Algorithm By: <strong>Poloxi.ai</strong></a>
            <AuthorizeView>
                <Authorized>
                    <div class="intel-userbar">
                        <span class="intel-userbar-name"><i class="bi bi-person-circle" aria-hidden="true"></i> @context.User.Identity?.Name</span>
                        <NavLink href="/account/settings" class="intel-userbar-settings" title="Account Settings">
                            <i class="bi bi-gear" aria-hidden="true"></i> Account Settings
                        </NavLink>
                        <form method="post" action="/auth/logout" class="intel-userbar-form">
                            <AntiforgeryToken />
                            <button type="submit" class="intel-userbar-logout"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Sign out</button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
            <button type="button"
                    class="intel-menu-toggle"
                    aria-label="Toggle navigation menu"
                    aria-controls="legal-workspace-menu"
                    aria-expanded="@_menuOpen"
                    @onclick="ToggleMenu">
                <i class="bi @(_menuOpen ? "bi-x-lg" : "bi-list")" aria-hidden="true"></i>
                <span>Menu</span>
            </button>
        </div>
        <nav id="legal-workspace-menu"
             class="intel-nav @(_menuOpen ? "intel-nav-open" : null)"
             data-open="@_menuOpen.ToString().ToLowerInvariant()"
             aria-label="Platform">
            <div class="intel-nav-primary">
                <a href="https://judz.ai"><i class="bi bi-house-door"></i> Home</a>
                <NavLink href="/legal/search" Match="NavLinkMatch.All"><i class="bi bi-search"></i> Search</NavLink>
            </div>
            <span class="intel-nav-divider" aria-hidden="true"></span>
            <div class="intel-nav-groups">
                <div class="intel-nav-group" aria-label="Legal">
                    <NavLink href="/legal/matters"><i class="bi bi-folder2-open"></i> Matters</NavLink>
                    <NavLink href="/legal/decision" Match="NavLinkMatch.All"><i class="bi bi-signpost-split"></i> Decision Intelligence</NavLink>
                    <NavLink href="/legal/personalinjury"><i class="bi bi-bandaid"></i> Personal Injury</NavLink>
                    <NavLink href="/legal/personalinjury_decision" Match="NavLinkMatch.All"><i class="bi bi-clipboard2-pulse"></i> Personal Injury Decision</NavLink>
                </div>
                <span class="intel-nav-divider" aria-hidden="true"></span>
                <div class="intel-nav-group" aria-label="Reasoning Engine">
                    <NavLink href="/legal/math/formalize"><i class="bi bi-diagram-3"></i> Formalization Gate</NavLink>
                    <NavLink href="/legal/math/solve"><i class="bi bi-calculator"></i> Math Solver</NavLink>
                    <NavLink href="/legal/math/runs"><i class="bi bi-clock-history"></i> Math Runs</NavLink>
                </div>
                <AuthorizeView Context="adminContext">
                    <Authorized>
                        @if (IsAdministrator(adminContext.User))
                        {
                            <span class="intel-nav-divider" aria-hidden="true"></span>
                            <div class="intel-nav-group intel-nav-dropdown @(_adminOpen ? "intel-nav-dropdown-open" : null)" aria-label="Administration">
                                <button type="button" class="intel-nav-dropdown-toggle" aria-haspopup="true" aria-expanded="@_adminOpen" @onclick="ToggleAdmin">
                                    <i class="bi bi-shield-lock"></i> Administration <i class="bi bi-chevron-down intel-nav-caret"></i>
                                </button>
                                <div class="intel-nav-dropdown-menu">
                                    <span class="intel-nav-dropdown-label">Tenant</span>
                                    <NavLink href="/admin/users" @onclick="CloseAdmin"><i class="bi bi-people"></i> User Management</NavLink>
                                    <NavLink href="/admin/groups" @onclick="CloseAdmin"><i class="bi bi-people-fill"></i> Group Management</NavLink>
                                    <NavLink href="/admin/activity" @onclick="CloseAdmin"><i class="bi bi-clock-history"></i> Activity &amp; Audit</NavLink>
                                    <NavLink href="/admin/configuration" @onclick="CloseAdmin"><i class="bi bi-gear-wide-connected"></i> Configuration</NavLink>
                                    <span class="intel-nav-dropdown-label">Platform</span>
                                    <NavLink href="/platform/users" @onclick="CloseAdmin"><i class="bi bi-person-badge"></i> Platform Users</NavLink>
                                    <NavLink href="/platform/configuration" @onclick="CloseAdmin"><i class="bi bi-hdd-network"></i> Platform Configuration</NavLink>
                                    <span class="intel-nav-dropdown-label">System</span>
                                    <NavLink href="/legal/configuration" @onclick="CloseAdmin"><i class="bi bi-sliders"></i> AI Configuration</NavLink>
                                </div>
                            </div>
                        }
                    </Authorized>
                </AuthorizeView>
            </div>
        </nav>
    </section>
    <main class="intel-content">@ChildContent</main>
</div>
@code {
    private bool _menuOpen;
    private bool _adminOpen;

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? ExtraClass { get; set; }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void ToggleAdmin() => _adminOpen = !_adminOpen;
    private void CloseAdmin() => _adminOpen = false;

    // Administration is restricted to Super Admin (SUPERADMIN) and Tenant Admin
    // (ADMIN) roles only. OWNER / MEMBER / VIEWER never see the menu. Roles are
    // forwarded as claims at sign-in from the tenant membership.
    private static bool IsAdministrator(System.Security.Claims.ClaimsPrincipal user)
        => user.IsInRole("SUPERADMIN")
        || user.IsInRole("ADMIN")
        || user.IsInRole("SYSTEM_ADMIN")
        || user.IsInRole("TENANT_ADMIN");

}
