<div class="intel-shell">
    <section class="intel-workspace-nav" aria-label="Legal workspace navigation">
        <div class="intel-workspace-title">
            <span class="intel-brand-icon" aria-hidden="true"><i class="bi bi-briefcase"></i></span>
            <span><small>Legal Enterprise</small><strong>Legal Workspace</strong></span>
        </div>
        <nav class="intel-nav" aria-label="Legal platform">
            <NavLink href="/legal/search" Match="NavLinkMatch.All"><i class="bi bi-search"></i> Legal Search</NavLink>
            <NavLink href="/legal/math/solve"><i class="bi bi-calculator"></i> Math Solver</NavLink>
            <NavLink href="/legal/math/runs"><i class="bi bi-clock-history"></i> Math Runs</NavLink>
            <NavLink href="/legal/configuration"><i class="bi bi-sliders"></i> Configuration</NavLink>
        </nav>
    </section>
    <main class="intel-content">@ChildContent</main>
</div>
@code{[Parameter]public RenderFragment? ChildContent{get;set;}}
