@using System.ComponentModel.DataAnnotations
@using Legal.Application.Features.Intelligence.Decision
@inject ApiClient Api

@* ── Per-matter Atomic Propositions (migration 0442). ──
   One row per LLM-generated L3+ proposition under a Domain Pack L2 target (Evidence Type / Concept), with
   the worker (parallel batch slot / recovery) that produced it and the full call provenance. Attorneys can
   override scope, add their own propositions, or edit title/statement. USER rows are never overwritten. *@

@if (_loading)
{
    <div class="map-loading"><i class="bi bi-hourglass-split"></i> Loading atomic propositions…</div>
}
else
{
    @if (_loadError is not null)
    {
        <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_loadError</div>
    }

    <div class="pc-kpi-strip">
        <div class="pc-kpi-card @(_activeFilter == "ALL" ? "pc-kpi-card--active" : null)" title="All atomic propositions generated or added for this matter" @onclick='() => SetFilter("ALL")'>
            <div class="pc-kpi-icon pc-kpi-icon--total"><i class="bi bi-diagram-3"></i></div>
            <div><div class="pc-kpi-value">@_items.Count</div><div class="pc-kpi-label">All propositions</div></div>
        </div>
        <div class="pc-kpi-card @(_activeFilter == MatterAtomicPropositionStatusCodes.InScope ? "pc-kpi-card--active" : null)" title="Participates in deeper narrowing, grounding and scoring" @onclick="() => SetFilter(MatterAtomicPropositionStatusCodes.InScope)">
            <div class="pc-kpi-icon pc-kpi-icon--active"><i class="bi bi-check2-circle"></i></div>
            <div><div class="pc-kpi-value">@Count(MatterAtomicPropositionStatusCodes.InScope)</div><div class="pc-kpi-label">In scope</div></div>
        </div>
        <div class="pc-kpi-card @(_activeFilter == MatterAtomicPropositionStatusCodes.OutOfScope ? "pc-kpi-card--active" : null)" title="Held back for this matter; marked eliminated in each run, never deleted" @onclick="() => SetFilter(MatterAtomicPropositionStatusCodes.OutOfScope)">
            <div class="pc-kpi-icon pc-kpi-icon--inactive"><i class="bi bi-slash-circle"></i></div>
            <div><div class="pc-kpi-value">@Count(MatterAtomicPropositionStatusCodes.OutOfScope)</div><div class="pc-kpi-label">Out of scope</div></div>
        </div>
        <div class="pc-kpi-card @(_activeFilter == MatterAtomicPropositionStatusCodes.PendingReview ? "pc-kpi-card--active" : null)" title="Generated by the model and awaiting attorney review" @onclick="() => SetFilter(MatterAtomicPropositionStatusCodes.PendingReview)">
            <div class="pc-kpi-icon"><i class="bi bi-question-circle"></i></div>
            <div><div class="pc-kpi-value">@Count(MatterAtomicPropositionStatusCodes.PendingReview)</div><div class="pc-kpi-label">Pending review</div></div>
        </div>
        <div class="pc-kpi-card @(_activeFilter == "USER" ? "pc-kpi-card--active" : null)" title="Rows decided or authored by an attorney; the system never overwrites these" @onclick='() => SetFilter("USER")'>
            <div class="pc-kpi-icon"><i class="bi bi-person-check"></i></div>
            <div><div class="pc-kpi-value">@_items.Count(i => i.DecidedByCode == MatterAtomicPropositionDeciderCodes.User)</div><div class="pc-kpi-label">Attorney overrides</div></div>
        </div>
        <div class="pc-kpi-card @(_activeFilter == "WORKERS" ? "pc-kpi-card--active" : null)" title="Distinct workers (parallel batch slots / recovery) that produced propositions" @onclick='() => SetFilter("WORKERS")'>
            <div class="pc-kpi-icon"><i class="bi bi-cpu"></i></div>
            <div><div class="pc-kpi-value">@_workers.Count</div><div class="pc-kpi-label">Workers</div></div>
        </div>
    </div>

    <div class="map-toolbar">
        <div class="map-search">
            <i class="bi bi-search"></i>
            <input class="form-control" placeholder="Search proposition, statement, evidence type, worker, model…" value="@_search" @oninput="OnSearchChanged" />
        </div>
        <select class="form-select map-filter" value="@_parentFilter" @onchange="OnParentChanged">
            <option value="">All evidence types / concepts</option>
            @foreach (var p in _parents) { <option value="@p.Key">@p.Value</option> }
        </select>
        <select class="form-select map-filter" value="@_workerFilter" @onchange="OnWorkerChanged">
            <option value="">All workers</option>
            @foreach (var w in _workers) { <option value="@w">@w</option> }
        </select>
        <select class="form-select map-filter map-filter--sm" value="@_levelFilter" @onchange="OnLevelChanged">
            <option value="">All levels</option>
            @foreach (var l in _levels) { <option value="@l">L@l</option> }
        </select>
        @if (_selected.Count > 0)
        {
            <div class="map-bulk">
                <span>@_selected.Count selected</span>
                <select class="form-select" @bind="_bulkStatus">
                    @foreach (var s in _options.Statuses) { <option value="@s.StatusCode">@s.Name</option> }
                </select>
                <button type="button" class="um-btn um-btn-secondary um-btn-sm" @onclick="ApplyBulkStatusAsync" disabled="@_saving"><i class="bi bi-check2-all"></i> Apply</button>
                <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="() => _selected.Clear()">Clear</button>
            </div>
        }
        <button type="button" class="um-btn um-btn-primary um-btn-sm ms-auto" @onclick="OpenAdd"><i class="bi bi-plus-lg"></i> Add proposition</button>
        <button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Refresh" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i></button>
    </div>

    @if (_items.Count == 0)
    {
        <div class="map-empty">
            <i class="bi bi-diagram-3"></i>
            <span>No atomic propositions have been generated for this matter yet. Run a Wide analysis for this matter to populate them, or add propositions manually.</span>
        </div>
    }
    else
    {
        <div class="map-table-wrap">
            <table class="map-table">
                <thead>
                    <tr>
                        <th class="map-col-check"><input type="checkbox" checked="@(_filtered.Count > 0 && _filtered.All(f => _selected.Contains(f.MatterAtomicPropositionId)))" @onchange="ToggleAll" /></th>
                        <th>Proposition</th>
                        <th>Evidence type / concept</th>
                        <th class="map-num">Level</th>
                        <th>Status</th>
                        <th>Decided by</th>
                        <th>Worker</th>
                        <th>Model</th>
                        <th class="map-num" title="Confidence · Anchors · Tokens in/out · Duration">Conf · Anchors · Tokens · ms</th>
                        <th>Type · Role</th>
                        <th class="map-col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _filtered)
                    {
                        <tr class="map-row @(row.DecidedByCode == MatterAtomicPropositionDeciderCodes.User ? "map-row--user" : null)" @onclick="() => OpenEdit(row)">
                            <td class="map-col-check" @onclick:stopPropagation="true"><input type="checkbox" checked="@_selected.Contains(row.MatterAtomicPropositionId)" @onchange="e => ToggleOne(row.MatterAtomicPropositionId, e)" /></td>
                            <td class="map-prop">
                                <div class="map-prop-name">@row.DisplayName</div>
                                <div class="map-prop-code">@row.PropositionCode@(row.ParentPropositionCode is null ? null : $" ← {row.ParentPropositionCode}")</div>
                                <div class="map-statement" title="@row.Statement">@row.Statement</div>
                            </td>
                            <td>
                                <div class="map-prop-name">@row.ParentDisplayName</div>
                                <div class="map-prop-code"><span class="map-kind map-kind--@row.ParentTargetKindCode.ToLowerInvariant()">@(row.ParentTargetKindCode == "CONCEPT" ? "CPT" : "EVD")</span>@row.ParentTargetCode</div>
                                <span class="map-dim">@row.DimensionCode</span>
                            </td>
                            <td class="map-num">L@row.LevelNumber</td>
                            <td><span class="map-status map-status--@row.ScopeStatusCode.ToLowerInvariant()">@StatusName(row.ScopeStatusCode)</span></td>
                            <td class="map-decider">@DeciderName(row.DecidedByCode)</td>
                            <td>
                                <div class="map-worker"><i class="bi bi-cpu"></i> @row.WorkerName</div>
                                <div class="map-prop-code">batch @row.BatchNumber · attempt @row.AttemptNumber@(row.BatchTierCode is null ? null : $" · {row.BatchTierCode}")</div>
                            </td>
                            <td>
                                <div>@(row.ModelCode ?? "—")</div>
                                <div class="map-prop-code">@(row.ProviderCode ?? "")</div>
                            </td>
                            <td class="map-num">@Pct(row.Confidence) · @row.AnchorCount · @(row.InputTokenCount?.ToString() ?? "—")/@(row.OutputTokenCount?.ToString() ?? "—") · @(row.DurationMs?.ToString() ?? "—")</td>
                            <td class="map-decider">@(row.SemanticTypeCode ?? "—") · @(row.BranchRoleCode ?? "—")</td>
                            <td class="map-col-actions">
                                <button type="button" class="um-btn um-btn-ghost um-btn-sm" title="Edit" @onclick="() => OpenEdit(row)" @onclick:stopPropagation="true"><i class="bi bi-pencil"></i></button>
                                <button type="button" class="um-btn um-btn-ghost um-btn-sm map-danger" title="Remove" @onclick="() => ConfirmDelete(row)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="map-footnote">Showing @_filtered.Count of @_items.Count · Pack <strong>@(_options.PackCode ?? "—")</strong> · Last generated @(_items.Max(i => i.LastEvaluatedDateUtc)?.ToLocalTime().ToString("g") ?? "never")</div>
    }
}

@if (_showForm)
{
    <div class="um-modal-backdrop" @onclick="CloseForm"><div class="um-modal map-modal" @onclick:stopPropagation="true">
        <div class="um-modal-header"><i class="bi bi-diagram-3"></i><span>@(_editing is null ? "Add atomic proposition" : "Edit atomic proposition")</span><button type="button" class="um-btn um-btn-ghost um-btn-sm ms-auto" @onclick="CloseForm"><i class="bi bi-x-lg"></i></button></div>
        <EditForm Model="_form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="um-modal-body">
                <div class="um-form-grid">
                    @if (_editing is null)
                    {
                        <label class="um-field map-span-2">
                            <span class="um-field-label">Evidence type / concept (parent)</span>
                            <InputSelect class="form-select" @bind-Value="_form.ParentKey">
                                <option value="">Select the parent evidence type or concept…</option>
                                @foreach (var g in _options.Parents.GroupBy(t => t.DimensionCode))
                                {
                                    <optgroup label="@g.Key">
                                        @foreach (var t in g) { <option value="@($"{t.TargetKindCode}|{t.TargetCode}")">@(t.TargetKindCode == "CONCEPT" ? "CPT" : "EVD") · @t.DisplayName</option> }
                                    </optgroup>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _form.ParentKey" class="text-danger" />
                        </label>
                        <label class="um-field">
                            <span class="um-field-label">Proposition code</span>
                            <InputText class="form-control" @bind-Value="_form.PropositionCode" placeholder="e.g. DUTY_OF_CARE_BREACH" />
                            <ValidationMessage For="() => _form.PropositionCode" class="text-danger" />
                        </label>
                    }
                    else
                    {
                        <div class="map-span-2 map-readonly">
                            <div class="map-prop-code">@_editing.ParentTargetKindCode · @_editing.ParentTargetCode · @_editing.DimensionCode · @_editing.PropositionCode · L@_editing.LevelNumber</div>
                            <dl class="map-dl">
                                <dt>Worker</dt><dd>@_editing.WorkerName</dd>
                                <dt>Batch · attempt</dt><dd>@_editing.BatchNumber · @_editing.AttemptNumber@(_editing.BatchTierCode is null ? null : $" · {_editing.BatchTierCode}")</dd>
                                <dt>Model</dt><dd>@(_editing.ModelCode ?? "—")@(_editing.ProviderCode is null ? null : $" ({_editing.ProviderCode})")</dd>
                                <dt>Tokens in / out</dt><dd>@(_editing.InputTokenCount?.ToString() ?? "—") / @(_editing.OutputTokenCount?.ToString() ?? "—")</dd>
                                <dt>Duration</dt><dd>@(_editing.DurationMs is null ? "—" : $"{_editing.DurationMs} ms")</dd>
                                <dt>Request id</dt><dd class="map-prop-code">@(_editing.ProviderRequestId ?? "—")</dd>
                                <dt>Confidence</dt><dd>@Pct(_editing.Confidence)</dd>
                                <dt>Type · Role</dt><dd>@(_editing.SemanticTypeCode ?? "—") · @(_editing.BranchRoleCode ?? "—")</dd>
                                <dt>Continue narrowing</dt><dd>@(_editing.ContinueNarrowing ? "Yes" : "No")@(_editing.StopReason is null ? null : $" · {_editing.StopReason}")</dd>
                                <dt>Capability</dt><dd>@(_editing.CapabilityCode ?? "—")</dd>
                                <dt>Anchors</dt><dd>@_editing.AnchorCount</dd>
                                <dt>Generations</dt><dd>@_editing.GenerationCount</dd>
                                <dt>Decided by</dt><dd>@DeciderName(_editing.DecidedByCode)</dd>
                                <dt>Last generated</dt><dd>@(_editing.LastEvaluatedDateUtc?.ToLocalTime().ToString("g") ?? "never")</dd>
                            </dl>
                            @if (!string.IsNullOrWhiteSpace(_editing.SearchText)) { <div class="map-def"><strong>Search text:</strong> @_editing.SearchText</div> }
                            @if (!string.IsNullOrWhiteSpace(_editing.DependsOnCodes)) { <div class="map-def"><strong>Depends on:</strong> @_editing.DependsOnCodes</div> }
                            @if (!string.IsNullOrWhiteSpace(_editing.EquivalentToCodes)) { <div class="map-def"><strong>Equivalent to:</strong> @_editing.EquivalentToCodes</div> }
                            @if (!string.IsNullOrWhiteSpace(_editing.AnchorsJson)) { <div class="map-def map-json"><strong>Anchors:</strong> <code>@_editing.AnchorsJson</code></div> }
                        </div>
                    }
                    <label class="um-field map-span-2">
                        <span class="um-field-label">Title</span>
                        <InputText class="form-control" @bind-Value="_form.DisplayName" />
                        <ValidationMessage For="() => _form.DisplayName" class="text-danger" />
                    </label>
                    <label class="um-field map-span-2">
                        <span class="um-field-label">Statement</span>
                        <InputTextArea class="form-control" rows="3" @bind-Value="_form.Statement" />
                        <ValidationMessage For="() => _form.Statement" class="text-danger" />
                    </label>
                    <label class="um-field">
                        <span class="um-field-label">Scope status</span>
                        <InputSelect class="form-select" @bind-Value="_form.ScopeStatusCode">
                            @foreach (var s in _options.Statuses) { <option value="@s.StatusCode">@s.Name — @s.Description</option> }
                        </InputSelect>
                        <ValidationMessage For="() => _form.ScopeStatusCode" class="text-danger" />
                    </label>
                    <label class="um-field">
                        <span class="um-field-label">Confidence (0–1)</span>
                        <InputNumber class="form-control" @bind-Value="_form.Confidence" step="0.05" />
                        <ValidationMessage For="() => _form.Confidence" class="text-danger" />
                    </label>
                    <label class="um-field map-span-2">
                        <span class="um-field-label">Attorney note</span>
                        <InputTextArea class="form-control" rows="2" @bind-Value="_form.UserNote" />
                        <ValidationMessage For="() => _form.UserNote" class="text-danger" />
                    </label>
                </div>
            </div>
            <div class="um-modal-footer">
                @if (_saveError is not null) { <span class="text-danger me-auto">@_saveError</span> }
                <button type="button" class="um-btn um-btn-ghost" @onclick="CloseForm">Cancel</button>
                <button type="submit" class="um-btn um-btn-primary" disabled="@_saving"><i class="bi bi-check-lg"></i> Save</button>
            </div>
        </EditForm>
    </div></div>
}

@if (_deleting is not null)
{
    <div class="um-modal-backdrop" @onclick="() => _deleting = null"><div class="um-modal um-confirm-dialog" @onclick:stopPropagation="true">
        <div class="um-confirm-icon um-confirm-icon--danger"><i class="bi bi-trash"></i></div>
        <h3>Remove atomic proposition?</h3>
        <p><strong>@_deleting.DisplayName</strong> (@_deleting.PropositionCode) will be removed from this matter. The next Wide run may regenerate it. To keep an attorney decision instead, set it to <em>Out of scope</em>.</p>
        <div class="um-modal-footer">
            @if (_saveError is not null) { <span class="text-danger me-auto">@_saveError</span> }
            <button type="button" class="um-btn um-btn-ghost" @onclick="() => _deleting = null">Cancel</button>
            <button type="button" class="um-btn um-btn-danger" @onclick="ExecuteDeleteAsync" disabled="@_saving"><i class="bi bi-trash"></i> Remove</button>
        </div>
    </div></div>
}

@code {
    [Parameter, EditorRequired] public Guid MatterId { get; set; }

    private bool _loading = true, _saving, _showForm;
    private string? _loadError, _saveError;
    private MatterAtomicPropositionOptionsDto _options = new();
    private List<MatterAtomicPropositionDto> _items = [];
    private List<MatterAtomicPropositionDto> _filtered = [];
    private List<KeyValuePair<string, string>> _parents = [];
    private List<string> _workers = [];
    private List<int> _levels = [];
    private string _activeFilter = "ALL", _search = string.Empty, _parentFilter = string.Empty, _workerFilter = string.Empty, _levelFilter = string.Empty;
    private readonly HashSet<Guid> _selected = [];
    private string _bulkStatus = MatterAtomicPropositionStatusCodes.OutOfScope;
    private MatterAtomicPropositionDto? _editing, _deleting;
    private PropositionForm _form = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    public async Task LoadAsync()
    {
        _loading = true; _loadError = null;
        try
        {
            _options = await Api.GetLegalDecisionMatterAtomicPropositionOptionsAsync(MatterId);
            _items = (await Api.GetLegalDecisionMatterAtomicPropositionsAsync(MatterId)).ToList();
            _parents = _items.GroupBy(i => $"{i.ParentTargetKindCode}|{i.ParentTargetCode}", StringComparer.OrdinalIgnoreCase)
                .Select(g => new KeyValuePair<string, string>(g.Key, g.First().ParentDisplayName))
                .OrderBy(p => p.Value).ToList();
            _workers = _items.Select(i => i.WorkerName).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(w => w, StringComparer.OrdinalIgnoreCase).ToList();
            _levels = _items.Select(i => i.LevelNumber).Distinct().OrderBy(l => l).ToList();
            _selected.RemoveWhere(id => _items.All(i => i.MatterAtomicPropositionId != id));
            ApplyFilter();
        }
        catch (Exception ex) { _loadError = $"Failed to load atomic propositions: {ex.Message}"; }
        finally { _loading = false; }
    }

    private int Count(string status) => _items.Count(i => string.Equals(i.ScopeStatusCode, status, StringComparison.OrdinalIgnoreCase));
    private string StatusName(string code) => _options.Statuses.FirstOrDefault(s => s.StatusCode == code)?.Name ?? code;
    private string DeciderName(string code) => _options.Deciders.FirstOrDefault(d => d.DeciderCode == code)?.Name ?? code;
    private static string Pct(decimal v) => $"{v * 100:0}%";

    private void SetFilter(string filter) { _activeFilter = filter; ApplyFilter(); }
    private void OnSearchChanged(ChangeEventArgs e) { _search = e.Value?.ToString() ?? string.Empty; ApplyFilter(); }
    private void OnParentChanged(ChangeEventArgs e) { _parentFilter = e.Value?.ToString() ?? string.Empty; ApplyFilter(); }
    private void OnWorkerChanged(ChangeEventArgs e) { _workerFilter = e.Value?.ToString() ?? string.Empty; ApplyFilter(); }
    private void OnLevelChanged(ChangeEventArgs e) { _levelFilter = e.Value?.ToString() ?? string.Empty; ApplyFilter(); }

    private void ApplyFilter()
    {
        IEnumerable<MatterAtomicPropositionDto> q = _items;
        if (_activeFilter == "USER") q = q.Where(i => i.DecidedByCode == MatterAtomicPropositionDeciderCodes.User);
        else if (_activeFilter == "WORKERS") q = q.Where(i => i.DecidedByCode == MatterAtomicPropositionDeciderCodes.Llm);
        else if (_activeFilter != "ALL") q = q.Where(i => string.Equals(i.ScopeStatusCode, _activeFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_parentFilter)) q = q.Where(i => string.Equals($"{i.ParentTargetKindCode}|{i.ParentTargetCode}", _parentFilter, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrWhiteSpace(_workerFilter)) q = q.Where(i => string.Equals(i.WorkerName, _workerFilter, StringComparison.OrdinalIgnoreCase));
        if (int.TryParse(_levelFilter, out var level)) q = q.Where(i => i.LevelNumber == level);
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim();
            q = q.Where(i => i.DisplayName.Contains(s, StringComparison.OrdinalIgnoreCase)
                          || i.Statement.Contains(s, StringComparison.OrdinalIgnoreCase)
                          || i.PropositionCode.Contains(s, StringComparison.OrdinalIgnoreCase)
                          || i.ParentDisplayName.Contains(s, StringComparison.OrdinalIgnoreCase)
                          || i.ParentTargetCode.Contains(s, StringComparison.OrdinalIgnoreCase)
                          || i.DimensionCode.Contains(s, StringComparison.OrdinalIgnoreCase)
                          || i.WorkerName.Contains(s, StringComparison.OrdinalIgnoreCase)
                          || (i.ModelCode?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                          || (i.SearchText?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                          || (i.UserNote?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        _filtered = q.OrderBy(i => i.DimensionCode).ThenBy(i => i.ParentDisplayName).ThenBy(i => i.LevelNumber).ThenByDescending(i => i.Confidence).ThenBy(i => i.SortOrder).ThenBy(i => i.DisplayName).ToList();
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        var on = e.Value is true;
        foreach (var f in _filtered) { if (on) _selected.Add(f.MatterAtomicPropositionId); else _selected.Remove(f.MatterAtomicPropositionId); }
    }
    private void ToggleOne(Guid id, ChangeEventArgs e) { if (e.Value is true) _selected.Add(id); else _selected.Remove(id); }

    private async Task ApplyBulkStatusAsync()
    {
        if (_selected.Count == 0) return;
        _saving = true; _saveError = null;
        try
        {
            await Api.SetLegalDecisionMatterAtomicPropositionStatusAsync(MatterId, new MatterAtomicPropositionBulkStatusRequest(_selected.ToArray(), _bulkStatus, null));
            _selected.Clear();
            await LoadAsync();
        }
        catch (Exception ex) { _loadError = $"Bulk update failed: {ex.Message}"; }
        finally { _saving = false; }
    }

    private void OpenAdd()
    {
        _editing = null; _saveError = null;
        _form = new PropositionForm { ScopeStatusCode = MatterAtomicPropositionStatusCodes.InScope, Confidence = 0.80m, ParentKey = _parentFilter };
        _showForm = true;
    }

    private void OpenEdit(MatterAtomicPropositionDto row)
    {
        _editing = row; _saveError = null;
        _form = new PropositionForm
        {
            ParentKey = $"{row.ParentTargetKindCode}|{row.ParentTargetCode}",
            PropositionCode = row.PropositionCode,
            DisplayName = row.DisplayName,
            Statement = row.Statement,
            Confidence = row.Confidence,
            SemanticTypeCode = row.SemanticTypeCode,
            BranchRoleCode = row.BranchRoleCode,
            ScopeStatusCode = row.ScopeStatusCode,
            UserNote = row.UserNote
        };
        _showForm = true;
    }

    private void CloseForm() { _showForm = false; _editing = null; }

    private async Task SaveAsync()
    {
        var parts = (_form.ParentKey ?? string.Empty).Split('|', 2);
        if (parts.Length != 2) { _saveError = "Select the parent evidence type or concept."; return; }
        _saving = true; _saveError = null;
        try
        {
            await Api.UpsertLegalDecisionMatterAtomicPropositionAsync(MatterId, new MatterAtomicPropositionUpsertRequest(
                parts[0], parts[1], _form.PropositionCode ?? string.Empty, _form.DisplayName?.Trim() ?? string.Empty, _form.Statement?.Trim() ?? string.Empty,
                _form.Confidence, _form.SemanticTypeCode, _form.BranchRoleCode, _form.ScopeStatusCode,
                string.IsNullOrWhiteSpace(_form.UserNote) ? null : _form.UserNote.Trim()));
            _showForm = false; _editing = null;
            await LoadAsync();
        }
        catch (Exception ex) { _saveError = $"Save failed: {ex.Message}"; }
        finally { _saving = false; }
    }

    private void ConfirmDelete(MatterAtomicPropositionDto row) { _deleting = row; _saveError = null; }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleting is null) return;
        _saving = true; _saveError = null;
        try
        {
            await Api.DeleteLegalDecisionMatterAtomicPropositionAsync(MatterId, _deleting.MatterAtomicPropositionId);
            _deleting = null;
            await LoadAsync();
        }
        catch (Exception ex) { _saveError = $"Delete failed: {ex.Message}"; }
        finally { _saving = false; }
    }

    private sealed class PropositionForm
    {
        [Required, StringLength(280)] public string? ParentKey { get; set; }
        [Required, StringLength(240)] public string? PropositionCode { get; set; }
        [Required, StringLength(300)] public string? DisplayName { get; set; }
        [Required, StringLength(2000)] public string? Statement { get; set; }
        [Range(0, 1)] public decimal Confidence { get; set; }
        [StringLength(30)] public string? SemanticTypeCode { get; set; }
        [StringLength(30)] public string? BranchRoleCode { get; set; }
        [Required, StringLength(40)] public string ScopeStatusCode { get; set; } = MatterAtomicPropositionStatusCodes.InScope;
        [StringLength(1000)] public string? UserNote { get; set; }
    }
}
