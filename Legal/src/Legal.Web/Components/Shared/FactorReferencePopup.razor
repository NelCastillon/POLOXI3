@* Reusable reference-details popup. Given any factor reference (matter field, profile field, document,
   evidence, legal authority, or decision channel), it shows the human citation, verification state, the
   ACTUAL source excerpt (the line inside the document that links to the proposition), and — when a real
   route/document exists — a link to open the underlying entity. Never fabricates a link or passage: it only
   renders what the reference actually carries. Shared by the Factor Matrix, Global factors, Candidate ×
   factor, and Factor Inventory checklist surfaces. *@

@if (Reference is not null)
{
    var r = Reference;
    var kindLabel = r.KindCode switch
    {
        "MATTER_FIELD" => "Matter field",
        "PROFILE_FIELD" => "Profile field",
        "DOCUMENT" => "Document",
        "EVIDENCE" => "Admitted evidence",
        "LEGAL_AUTHORITY" => "Legal authority",
        "CHANNEL" => "Decision channel",
        _ => r.KindCode
    };
    var kindIcon = r.KindCode switch
    {
        "MATTER_FIELD" => "bi-journal-text",
        "PROFILE_FIELD" => "bi-person-badge",
        "DOCUMENT" => "bi-file-earmark-text",
        "EVIDENCE" => "bi-paperclip",
        "LEGAL_AUTHORITY" => "bi-bank",
        "CHANNEL" => "bi-broadcast",
        _ => "bi-link-45deg"
    };
    var state = (r.VerificationState ?? "UNVERIFIED").ToLowerInvariant();

    <div class="frp-backdrop" @onclick="OnClose">
        <div class="frp-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="frp-header">
                <span class="frp-header-icon"><i class="bi @kindIcon"></i></span>
                <div class="frp-header-text">
                    <span class="frp-eyebrow">@kindLabel</span>
                    <h3 class="frp-title">@r.Label</h3>
                </div>
                <span class="frp-state frp-state--@state">@r.VerificationState</span>
                <button type="button" class="frp-close" title="Close" @onclick="OnClose"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="frp-body">
                @if (!string.IsNullOrWhiteSpace(r.Reference))
                {
                    <div class="frp-field">
                        <span class="frp-field-label">Citation / source location</span>
                        <div class="frp-field-value">@r.Reference</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(r.Excerpt))
                {
                    <div class="frp-field">
                        <span class="frp-field-label">Passage that links to the proposition</span>
                        <blockquote class="frp-excerpt">@r.Excerpt</blockquote>
                    </div>
                }

                @if (r.PageNumber.HasValue || !string.IsNullOrWhiteSpace(r.LineReference))
                {
                    <div class="frp-meta">
                        @if (r.PageNumber.HasValue)
                        {
                            <span class="frp-meta-chip"><i class="bi bi-file-earmark"></i> Page @r.PageNumber</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(r.LineReference))
                        {
                            <span class="frp-meta-chip"><i class="bi bi-text-left"></i> @r.LineReference</span>
                        }
                    </div>
                }

                @if (string.IsNullOrWhiteSpace(r.Reference) && string.IsNullOrWhiteSpace(r.Excerpt))
                {
                    <p class="frp-empty">No additional passage detail is attached to this reference.</p>
                }
            </div>

            <div class="frp-footer">
                @if (!string.IsNullOrWhiteSpace(r.NavigationRoute))
                {
                    <a class="frp-open-btn" href="@r.NavigationRoute">
                        <i class="bi bi-box-arrow-up-right"></i>
                        @(r.KindCode == "DOCUMENT" || r.KindCode == "EVIDENCE" ? "Open document" : "Open source")
                    </a>
                }
                else
                {
                    <span class="frp-no-route"><i class="bi bi-slash-circle"></i> No direct link available for this source.</span>
                }
                <button type="button" class="frp-dismiss" @onclick="OnClose">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public WideFactorReferenceDto? Reference { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
