@using Legal.Application.Features.Intelligence.Decision
@inject ApiClient Api
@inject IJSRuntime JS
@implements IAsyncDisposable

@* ─────────────────────────────────────────────────────────────────────────────
   Reusable premium passage → PDF preview dialog. Given a document version and a
   passage (text + page + optional source span / bounding geometry), it shows the
   passage on the left and the actual PDF on the right with the passage highlighted
   inside the document (pdf.js self-hosted viewer). Reusable across every evidence /
   passage list — pass the passage fields in and toggle Visible.
   ──────────────────────────────────────────────────────────────────────────── *@

@if (Visible)
{
    <div class="ppd-backdrop" @onclick="CloseAsync">
        <div class="ppd-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="ppd-header">
                <span class="ppd-header-icon"><i class="bi bi-file-earmark-text"></i></span>
                <div class="ppd-header-text">
                    <span class="ppd-eyebrow">Evidence provenance</span>
                    <h3 class="ppd-title">@(string.IsNullOrWhiteSpace(FileName) ? "Document passage" : FileName)</h3>
                </div>
                <a class="ppd-ghost" href="@_contentUrl" target="_blank" rel="noopener" title="Open document in new tab">
                    <i class="bi bi-box-arrow-up-right"></i>
                </a>
                <button type="button" class="ppd-close" title="Close" @onclick="CloseAsync"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="ppd-split">
                <!-- Left: the passage text + provenance -->
                <aside class="ppd-passage">
                    <div class="ppd-passage-meta">
                        @if (PageNumber is { } pg)
                        {
                            <span class="ppd-chip"><i class="bi bi-file-earmark"></i> Page @pg</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(SectionPath))
                        {
                            <span class="ppd-chip"><i class="bi bi-diagram-2"></i> @SectionPath</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(ExtractionMethodCode))
                        {
                            <span class="ppd-chip"><i class="bi bi-cpu"></i> @ExtractionMethodCode.Replace('_', ' ')</span>
                        }
                        @if (ExtractionConfidence is { } conf)
                        {
                            <span class="ppd-chip"><i class="bi bi-graph-up"></i> @($"{Math.Round(conf * 100)}% conf")</span>
                        }
                    </div>

                    <div class="ppd-passage-scroll">
                        <ol class="ppd-chain">
                            @if (!string.IsNullOrWhiteSpace(PropositionText))
                            {
                                <li class="ppd-chain-step ppd-chain-step--prop">
                                    <span class="ppd-chain-label"><i class="bi bi-bullseye"></i> Proposition</span>
                                    <p class="ppd-chain-text"><mark class="ppd-proposition-mark">@PropositionText</mark></p>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(AssessmentReason))
                            {
                                <li class="ppd-chain-step ppd-chain-step--reason">
                                    <span class="ppd-chain-label">
                                        <i class="bi bi-link-45deg"></i>
                                        @if (!string.IsNullOrWhiteSpace(RelationshipTypeCode))
                                        {
                                            <span class="ppd-rel ppd-rel--@(RelationshipTypeCode.ToLowerInvariant())">@RelationshipTypeCode.Replace('_', ' ')</span>
                                        }
                                        Why linked
                                    </span>
                                    <p class="ppd-chain-text"><mark class="ppd-reason-mark">@AssessmentReason</mark></p>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(EvidenceSummary))
                            {
                                <li class="ppd-chain-step ppd-chain-step--evidence">
                                    <span class="ppd-chain-label"><i class="bi bi-patch-check"></i> Evidence</span>
                                    <p class="ppd-chain-text"><mark class="ppd-evidence-mark">@EvidenceSummary</mark></p>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(PassageText))
                            {
                                <li class="ppd-chain-step ppd-chain-step--source">
                                    <span class="ppd-chain-label"><i class="bi bi-quote"></i> Source passage this evidence was drawn from</span>
                                    <blockquote class="ppd-passage-text"><mark class="ppd-passage-mark">@PassageText</mark></blockquote>
                                </li>
                            }
                        </ol>
                    </div>

                    <div class="ppd-passage-actions">
                        <button type="button" class="um-btn um-btn-ghost um-btn-sm" @onclick="CopyPassageAsync" title="Copy passage text">
                            <i class="bi bi-clipboard"></i> Copy
                        </button>
                        <span class="ppd-hint"><i class="bi bi-highlighter"></i> Source passage highlighted in the document →</span>
                    </div>
                </aside>

                <!-- Right: the PDF rendered with highlight -->
                <section class="ppd-viewer">
                    <div class="ppd-viewer-toolbar">
                        <span class="ppd-viewer-label"><i class="bi bi-file-earmark-pdf"></i> Document preview</span>
                        @if (_viewerError is not null)
                        {
                            <span class="ppd-viewer-error" title="@_viewerError"><i class="bi bi-exclamation-triangle"></i> Preview unavailable</span>
                        }
                    </div>
                    <div class="ppd-viewer-surface">
                        @if (_rendering)
                        {
                            <div class="ppd-viewer-state"><i class="bi bi-hourglass-split"></i> Rendering document…</div>
                        }
                        @if (_viewerError is not null)
                        {
                            <div class="ppd-viewer-state ppd-viewer-state--error">
                                <i class="bi bi-file-earmark-break"></i>
                                <p>We couldn't render this document inline.</p>
                                <a class="um-btn um-btn-primary um-btn-sm" href="@_contentUrl" target="_blank" rel="noopener">Open in new tab</a>
                            </div>
                        }
                        <div id="@_hostId" class="ppd-viewer-host"></div>
                    </div>
                </section>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public Guid DocumentVersionId { get; set; }
    [Parameter] public string? FileName { get; set; }
    [Parameter] public string? PropositionText { get; set; }
    [Parameter] public string? RelationshipTypeCode { get; set; }
    [Parameter] public string? AssessmentReason { get; set; }
    [Parameter] public string? EvidenceSummary { get; set; }
    [Parameter] public string? PassageText { get; set; }
    [Parameter] public int? PageNumber { get; set; }
    [Parameter] public string? SectionPath { get; set; }
    [Parameter] public string? ExtractionMethodCode { get; set; }
    [Parameter] public decimal? ExtractionConfidence { get; set; }
    [Parameter] public string? BoundingRegionJson { get; set; }

    private readonly string _hostId = $"ppd-host-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private string? _contentUrl;
    private bool _rendering;
    private string? _viewerError;

    // Tracks the last rendered identity so parameter changes (new passage selected while
    // the dialog is open) re-render, and the initial open renders exactly once.
    private Guid _renderedVersion;
    private string? _renderedPassage;
    private bool _wasVisible;

    protected override void OnParametersSet()
    {
        _contentUrl = DocumentVersionId == Guid.Empty ? null : Api.LegalDocumentVersionContentUrl(DocumentVersionId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Visible)
        {
            if (_wasVisible)
            {
                _wasVisible = false;
                await TeardownViewerAsync();
            }
            return;
        }

        _wasVisible = true;
        var identityChanged = _renderedVersion != DocumentVersionId || _renderedPassage != PassageText;
        if (!identityChanged || DocumentVersionId == Guid.Empty)
            return;

        _renderedVersion = DocumentVersionId;
        _renderedPassage = PassageText;
        await RenderViewerAsync();
    }

    private async Task RenderViewerAsync()
    {
        _viewerError = null;
        _rendering = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/pdf-passage-viewer.js");
            var result = await _module.InvokeAsync<RenderResult>("render", _hostId, _contentUrl, new
            {
                pageNumber = PageNumber ?? 1,
                passageText = PassageText,
                evidenceText = EvidenceSummary,
                reasonText = AssessmentReason,
                propositionText = PropositionText,
                boundingRegionJson = BoundingRegionJson
            });
            if (result is null || !result.Ok)
                _viewerError = result?.Detail ?? result?.Error ?? "render-failed";
        }
        catch (Exception ex)
        {
            _viewerError = ex.Message;
        }
        finally
        {
            _rendering = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task TeardownViewerAsync()
    {
        _renderedVersion = Guid.Empty;
        _renderedPassage = null;
        if (_module is null)
            return;
        try { await _module.InvokeVoidAsync("dispose", _hostId); }
        catch { /* circuit may be gone */ }
    }

    private async Task CopyPassageAsync()
    {
        if (string.IsNullOrWhiteSpace(PassageText))
            return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", PassageText); }
        catch { /* clipboard unavailable */ }
    }

    private async Task CloseAsync()
    {
        await TeardownViewerAsync();
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await TeardownViewerAsync();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch { /* circuit may be gone */ }
        }
    }

    private sealed record RenderResult(bool Ok, int? Pages, int? Page, string? Error, string? Detail);
}
