@inject ApiClient Api

@* ─────────────────────────────────────────────────────────────────────────────
   Renders a DB-backed legal agreement (Terms of Service or Privacy Policy) on a
   public, anonymous page. The body text is authoritative in the database; it is
   rendered as pre-formatted text (never as raw HTML) so seeded markdown content
   is displayed safely without any injection risk.
   ───────────────────────────────────────────────────────────────────────────── *@

<div class="legal-shell">
    <div class="legal-card">
        <div class="legal-brand">
            <img src="image/JudzLogo.png" alt="judz.ai" class="legal-logo" />
            <span class="legal-word"><strong>judz<span>.ai</span></strong><small>EARLY ACCESS</small></span>
        </div>

        @if (_error is not null)
        {
            <div class="legal-alert" role="alert"><i class="bi bi-exclamation-triangle"></i> @_error</div>
        }
        else if (_agreement is null)
        {
            <p class="legal-loading">Loading @Heading…</p>
        }
        else
        {
            <h1 class="legal-title">@_agreement.Title</h1>
            <p class="legal-meta">Version @_agreement.Version · Effective @_agreement.EffectiveAtUtc.ToString("MMMM d, yyyy")</p>
            <pre class="legal-body">@_agreement.Body</pre>
        }

        <p class="legal-foot"><a href="/signup">Back to sign up</a></p>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string AgreementType { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Heading { get; set; } = string.Empty;

    private LegalAgreementDto? _agreement;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var agreements = await Api.GetActiveAgreementsAsync();
            _agreement = agreements.FirstOrDefault(a =>
                string.Equals(a.AgreementType, AgreementType, StringComparison.OrdinalIgnoreCase));
            if (_agreement is null)
                _error = $"{Heading} is not currently available.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to load {Heading}: {ex.Message}";
        }
    }
}
