@page "/admin/configuration"
@using Legal.Application.Features.Saas
@inject ApiClient Api

<LegalWorkspace>
<div class="intel-page">
    <header class="intel-header">
        <div>
            <span>Administration · Control plane</span>
            <h1>Tenant Configuration</h1>
            <p>How Judz operates for your organization. Configuration never grants access — it only shapes how already-permitted capabilities behave. Values resolve from platform defaults unless your tenant overrides them.</p>
        </div>
        <button class="um-btn um-btn-ghost" @onclick="LoadAsync" disabled="@_loading"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
    </header>

    @if (_loading)
    {
        <div class="intel-state">Loading configuration…</div>
    }
    else
    {
        @if (_error is not null)
        {
            <div class="alert alert-danger" style="border-left: 4px solid #dc3545; animation: um-shake 0.3s ease;">@_error</div>
        }

        <section class="intel-kpis">
            <article class="intel-kpi-link @(_activeCategory is null ? "intel-kpi-active" : null)" role="button" tabindex="0"
                     title="Show all configuration" @onclick="() => SetCategory(null)">
                <span>All settings</span><strong>@_categories.Sum(c => c.Items.Count)</strong>
            </article>
            @foreach (var category in _categories)
            {
                <article class="intel-kpi-link @(_activeCategory == category.Category ? "intel-kpi-active" : null)" role="button" tabindex="0"
                         title="@($"Show {category.Category} settings")" @onclick="() => SetCategory(category.Category)">
                    <span>@category.Category</span><strong>@category.Items.Count</strong>
                </article>
            }
        </section>

        @if (_categories.Count == 0)
        {
            <div class="intel-state">No tenant-configurable settings are defined.</div>
        }

        @foreach (var category in _categories.Where(c => _activeCategory is null || c.Category == _activeCategory))
        {
            <section class="intel-panel">
                <div class="intel-toolbar"><h2>@category.Category</h2></div>
                @foreach (var item in category.Items)
                {
                    <div class="intel-row cfg-row">
                        <div class="cfg-meta">
                            <strong>@item.DisplayName</strong>
                            <small>@item.Key</small>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <span>@item.Description</span>
                            }
                            <span class="cfg-source">
                                Effective: <code>@Display(item, _drafts[item.Key])</code>
                                @if (item.IsOverridden)
                                {
                                    <AppStatusBadge Status="TENANT" />
                                }
                                else
                                {
                                    <span class="cfg-source-tag">@(item.Source == "Platform" ? "Platform default" : "System default")</span>
                                }
                                @if (!item.CanOverride)
                                {
                                    <span class="cfg-locked" title="This setting is enforced by a platform policy and cannot be overridden."><i class="bi bi-lock-fill"></i> Locked</span>
                                }
                            </span>
                        </div>
                        <div class="cfg-editor">
                            @if (!item.CanOverride || item.Sensitive)
                            {
                                <span class="cfg-readonly">@(item.Sensitive ? "Managed securely" : "Enforced")</span>
                            }
                            else
                            {
                                @switch (item.ValueType)
                                {
                                    case "Boolean":
                                        <label class="cfg-switch"><input type="checkbox" checked="@(_drafts[item.Key] == "true")"
                                            @onchange="e => OnBoolChange(item.Key, e)" /> @(_drafts[item.Key] == "true" ? "On" : "Off")</label>
                                        break;
                                    case "Integer":
                                    case "Decimal":
                                        <input type="number" step="@(item.ValueType == "Decimal" ? "0.01" : "1")"
                                            min="@(item.Min?.ToString())" max="@(item.Max?.ToString())"
                                            value="@_drafts[item.Key]" @onchange="e => OnValueChange(item.Key, e)" />
                                        break;
                                    case "Enum" when item.Options is { Count: > 0 }:
                                        <select value="@_drafts[item.Key]" @onchange="e => OnValueChange(item.Key, e)">
                                            @foreach (var option in item.Options)
                                            {
                                                <option value="@option" selected="@(_drafts[item.Key] == option)">@option</option>
                                            }
                                        </select>
                                        break;
                                    default:
                                        <input type="text" value="@_drafts[item.Key]" @onchange="e => OnValueChange(item.Key, e)" />
                                        break;
                                }
                                <button class="um-btn um-btn-primary um-btn-sm" @onclick="() => SaveAsync(item)" disabled="@_saving">Save</button>
                                @if (item.IsOverridden)
                                {
                                    <button class="um-btn um-btn-ghost um-btn-sm" @onclick="() => ResetAsync(item)" disabled="@_saving" title="Remove the tenant override and inherit the platform default.">Reset</button>
                                }
                            }
                        </div>
                    </div>
                }
            </section>
        }
    }
</div>
</LegalWorkspace>

@code {
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private string? _activeCategory;
    private IReadOnlyList<TenantConfigurationCategoryDto> _categories = [];
    private readonly Dictionary<string, string> _drafts = new(StringComparer.Ordinal);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _categories = await Api.GetTenantConfigurationAsync();
            _drafts.Clear();
            foreach (var item in _categories.SelectMany(c => c.Items))
                _drafts[item.Key] = ToDisplayValue(item.EffectiveValueJson ?? item.DefaultValueJson, item.ValueType);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load configuration: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetCategory(string? category) => _activeCategory = category;

    private void OnValueChange(string key, ChangeEventArgs e) => _drafts[key] = e.Value?.ToString() ?? string.Empty;

    private void OnBoolChange(string key, ChangeEventArgs e) => _drafts[key] = (e.Value is bool b && b) ? "true" : "false";

    private async Task SaveAsync(TenantConfigurationItemDto item)
    {
        _saving = true;
        _error = null;
        try
        {
            var json = ToJson(_drafts[item.Key], item.ValueType);
            await Api.SetTenantConfigurationValueAsync(item.Key, json);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Save failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResetAsync(TenantConfigurationItemDto item)
    {
        _saving = true;
        _error = null;
        try
        {
            await Api.SetTenantConfigurationValueAsync(item.Key, null);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Reset failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private string Display(TenantConfigurationItemDto item, string draft) => draft;

    // Convert stored JSON to a plain editable value (strip quotes for strings/enums).
    private static string ToDisplayValue(string json, string valueType)
    {
        if (string.IsNullOrWhiteSpace(json))
            return string.Empty;
        return valueType switch
        {
            "String" or "Enum" => json.Length >= 2 && json.StartsWith('"') && json.EndsWith('"')
                ? System.Text.Json.JsonSerializer.Deserialize<string>(json) ?? string.Empty
                : json,
            _ => json
        };
    }

    // Convert an edited plain value back to JSON for storage.
    private static string ToJson(string value, string valueType) => valueType switch
    {
        "String" or "Enum" => System.Text.Json.JsonSerializer.Serialize(value),
        "Boolean" => value == "true" ? "true" : "false",
        _ => string.IsNullOrWhiteSpace(value) ? "0" : value
    };
}
