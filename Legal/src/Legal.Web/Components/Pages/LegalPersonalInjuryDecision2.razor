    // Always-visible universal Factor Inventory checklist. Independent of the _showPipeline diagnostics
    // toggle so users can always see, per candidate, which required/supporting factors are satisfied
    // (AVAILABLE/SUPPLIED) vs. still missing — and how each factor affects that outcome in the pipeline.
    private RenderFragment FactorChecklistPanel => __builder =>
    {
        @if (_response?.DecisionInspector?.FactorInventory is { } inventory && inventory.Factors.Count > 0)
        {
            <section class="poloxi-panel poloxi-reveal poloxi-factorcheck-panel">
                <div class="poloxi-panel-header">
                    <div class="poloxi-panel-title">
                        <span class="poloxi-panel-icon"><i class="bi bi-list-check"></i></span>
                        <div><span>Factor inventory checklist</span><h2>What each outcome needs — and what is established</h2></div>
                    </div>
                    <span class="poloxi-status" title="Factors are derived from the actual normalized decision plan and matter data. Nothing is hardcoded.">@inventory.Factors.Count factors · @inventory.SharedFactorCount shared · @inventory.MissingFactorCount missing</span>
                </div>

                @if (inventory.IsProvisional || inventory.RejectedBindingCount > 0 || inventory.ContradictedFactorCount > 0 || inventory.UnvalidatedRequiredCount > 0 || inventory.UnsatisfiedRequiredDependencyCount > 0 || (inventory.BlockingObligations?.Count ?? 0) > 0)
                {
                    <div class="poloxi-provisional-banner" role="status">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            <strong>Provisional comparison — not a validated recommendation.</strong>
                            <span>
                                @(string.IsNullOrWhiteSpace(inventory.DecisionReadinessStatus) ? "PROVISIONAL" : inventory.DecisionReadinessStatus)
                                @if (inventory.RejectedBindingCount > 0)
                                {
                                    <text> · @inventory.RejectedBindingCount supplied value(s) could not establish their proposition</text>
                                }
                                @if (inventory.ContradictedFactorCount > 0)
                                {
                                    <text> · @inventory.ContradictedFactorCount proposition(s) have conflicting values across sources</text>
                                }
                                @if (inventory.UnvalidatedRequiredCount > 0)
                                {
                                    <text> · @inventory.UnvalidatedRequiredCount REQUIRED link(s) lack a validated basis</text>
                                }
                                @if (inventory.UnsatisfiedRequiredDependencyCount > 0)
                                {
                                    <text> · @inventory.UnsatisfiedRequiredDependencyCount REQUIRED dependency(ies) not established</text>
                                }
                            </span>
                            @if ((inventory.BlockingObligations?.Count ?? 0) > 0)
                            {
                                <ul class="poloxi-provisional-obligations">
                                    @foreach (var obligation in inventory.BlockingObligations!)
                                    {
                                        <li><i class="bi bi-shield-exclamation"></i> @obligation</li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                }

                <div class="poloxi-factor-sources">
                    <span class="poloxi-factor-chip poloxi-factor-chip--@(inventory.SourceStatus.MatterDataLoaded ? "on" : "off")">Matter data: @(inventory.SourceStatus.MatterDataLoaded ? $"{inventory.SourceStatus.MatterFieldCount} fields" : "none")</span>
                    <span class="poloxi-factor-chip poloxi-factor-chip--@(inventory.SourceStatus.DomainPackResolved ? "on" : "off")">Domain pack: @(inventory.SourceStatus.DomainPackResolved ? (inventory.SourceStatus.DomainPackCode ?? "resolved") : "not resolved")</span>
                    <span class="poloxi-factor-chip poloxi-factor-chip--@(inventory.SourceStatus.DocumentCorpusStatus == "AVAILABLE" ? "on" : "off")">Documents: @inventory.SourceStatus.DocumentCorpusStatus</span>
                    <span class="poloxi-factor-chip poloxi-factor-chip--@(inventory.SourceStatus.EvidenceStatus == "ADMITTED" ? "on" : "off")">Evidence: @inventory.SourceStatus.EvidenceStatus</span>
                </div>

                @{
                    // Group relationship rows by candidate so each outcome shows its own factor checklist.
                    var byCandidate = inventory.Relationships
                        .GroupBy(r => r.CandidateTitle)
                        .OrderByDescending(g => g.Count(x => x.IsRequired))
                        .ThenBy(g => g.Key)
                        .ToArray();
                    var factorById = inventory.Factors.ToDictionary(f => f.FactorId, StringComparer.OrdinalIgnoreCase);
                }

                @if (byCandidate.Length == 0)
                {
                    <p class="poloxi-factorcheck-empty">The normalized plan registered factors but no candidate relationships were produced for this run.</p>
                }
                else
                {
                    <div class="poloxi-factorcheck-grid">
                        @foreach (var grp in byCandidate)
                        {
                            var required = grp.Where(r => r.IsRequired).ToArray();
                            var met = required.Count(r => factorById.TryGetValue(r.FactorId, out var f) && f.Availability == "AVAILABLE");
                            <article class="poloxi-factorcheck-card">
                                <header>
                                    <h3>@grp.Key</h3>
                                    <span class="poloxi-factorcheck-progress" title="Required factors with an established (AVAILABLE) value.">@met / @required.Length required established</span>
                                </header>
                                <ul class="poloxi-factorcheck-list">
                                    @foreach (var rel in grp.OrderByDescending(r => r.IsRequired).ThenBy(r => r.FactorName))
                                    {
                                        factorById.TryGetValue(rel.FactorId, out var factor);
                                        var available = factor?.Availability == "AVAILABLE";
                                        var stateClass = available ? "met" : (rel.IsRequired ? "missing" : "pending");
                                        var icon = available ? "bi-check-circle-fill" : (rel.IsRequired ? "bi-x-circle-fill" : "bi-dash-circle");
                                        <li class="poloxi-factorcheck-item poloxi-factorcheck-item--@stateClass">
                                            <i class="bi @icon"></i>
                                            <div class="poloxi-factorcheck-item-body">
                                                <div class="poloxi-factorcheck-item-head">
                                                    <strong>@rel.FactorName</strong>
                                                    <span class="poloxi-factor-badge poloxi-factor-badge--@(rel.RelationType.ToLowerInvariant())">@rel.RelationType</span>
                                                    @if (factor is not null)
                                                    {
                                                        <span class="poloxi-factor-badge poloxi-factor-badge--@factor.Availability.ToLowerInvariant()">@factor.Availability</span>
                                                        <span class="poloxi-factor-badge poloxi-factor-badge--@factor.VerificationStatus.ToLowerInvariant()">@factor.VerificationStatus</span>
                                                        @if (!string.IsNullOrWhiteSpace(factor.EvidenceAdmissionState))
                                                        {
                                                            <span class="poloxi-factor-badge poloxi-factor-badge--@factor.EvidenceAdmissionState.ToLowerInvariant()" title="Evidence-admission state">@factor.EvidenceAdmissionState</span>
                                                        }
                                                        @if (string.Equals(factor.BindingAdmissibility, "REJECTED", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <span class="poloxi-factor-badge poloxi-factor-badge--rejected" title="The supplied value does not establish this proposition (category mismatch).">BINDING REJECTED</span>
                                                        }
                                                    }
                                                </div>
                                                <div class="poloxi-factorcheck-item-value">
                                                    @if (factor is not null && !string.IsNullOrWhiteSpace(factor.ActualValue))
                                                    {
                                                        <span><i class="bi bi-database"></i> @factor.ActualValue <em>(@factor.Source)</em></span>
                                                    }
                                                    else if (factor is not null && !string.IsNullOrWhiteSpace(factor.MissingInformation))
                                                    {
                                                        <span class="poloxi-factorcheck-missing">@factor.MissingInformation</span>
                                                    }
                                                </div>
                                                @if (factor is not null && !string.IsNullOrWhiteSpace(factor.VerificationObligation))
                                                {
                                                    <div class="poloxi-factorcheck-item-obligation"><i class="bi bi-shield-exclamation"></i> Verification required: @factor.VerificationObligation</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(rel.Rationale))
                                                {
                                                    <div class="poloxi-factorcheck-item-effect"><i class="bi bi-arrow-return-right"></i> @rel.Rationale</div>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </article>
                        }
                    </div>
                }
            </section>
        }
    };

    // ══ Decision Change Intelligence (DCI) ═══════════════════════════════════════════════════════════
    // Attorney-facing interpretation of matter changes. Pure, read-only projections over the DB-backed
    // DecisionDelta records (_dciDeltas), calibration snapshots (_cdcSnapshots), the per-event impact
    // rows (_dciChangeReview) and the advisory proposition frontier (_propositionInfoValue). Nothing is
    // fabricated — when the pipeline produced no delta the views render their empty-states.
    private IReadOnlyList<Legal.Application.Features.Intelligence.Decision.DecisionDeltaDto> DciDeltas =>
        _dciDeltas.OrderByDescending(d => d.OccurredDateUtc).ToArray();

    private Legal.Application.Features.Intelligence.Decision.DecisionDeltaDto? DciSelectedDelta =>
        DciDeltas.FirstOrDefault(d => d.DecisionDeltaId == _dciSelectedDeltaId) ?? DciDeltas.FirstOrDefault();

    // "Since last review" cutoff: the evaluation time of the most recent attorney-approved snapshot.
    // KPIs count only deltas that occurred after this point so the header ("Changes Since Last Review")
    // stays truthful. When nothing has been approved yet, every recorded delta is "since last review".
    private DateTime? DciLastReviewedUtc =>
        _cdcSnapshots.Where(s => s.IsAttorneyApproved)
                     .OrderByDescending(s => s.EvaluatedDateUtc)
                     .Select(s => (DateTime?)s.EvaluatedDateUtc)
                     .FirstOrDefault();

    private IReadOnlyList<Legal.Application.Features.Intelligence.Decision.DecisionDeltaDto> DciDeltasSinceReview =>
        DciLastReviewedUtc is { } cutoff
            ? DciDeltas.Where(d => d.OccurredDateUtc > cutoff).ToArray()
            : DciDeltas;

    // Live Decision Monitor KPIs — aggregated strictly from recorded delta data since the last reviewed
    // snapshot (0 when not computed).
    private int DciNewEvidenceCount => DciDeltasSinceReview.Sum(d => d.AffectedEvidenceCount);
    private int DciChangedPropositionCount => DciDeltasSinceReview.Sum(d => d.AffectedPropositionCount);
    private int DciAffectedOutcomeCount => DciDeltasSinceReview.Sum(d => d.AffectedCandidateCount);
    private int DciNewContradictionCount => DciDeltasSinceReview.Count(d =>
        (d.ClassificationCode ?? "").Contains("CONTRADICT", StringComparison.OrdinalIgnoreCase));
    private int DciFrontierChangeCount => DciDeltasSinceReview.Count(d => d.FrontierChanged == true);
    private int DciReviewRequiredCount => DciDeltasSinceReview.Count(d => d.AttorneyReviewRequired);

    private static string DciDeltaKindLabel(string? code) => (code ?? "").ToUpperInvariant() switch
    {
        "WINNER_CHANGED" => "Material decision change",
        "MARGIN_SHIFTED" => "Margin shifted",
        "REEVALUATED_NO_CHANGE" => "Reevaluated · no change",
        _ => string.IsNullOrWhiteSpace(code) ? "Decision reevaluated" : code,
    };

    private static string DciDeltaKindTone(string? code) => (code ?? "").ToUpperInvariant() switch
    {
        "WINNER_CHANGED" => "danger",
        "MARGIN_SHIFTED" => "warn",
        _ => "info",
    };

    private static string DciScore(double? value) => value is { } v ? $"{Math.Round(v * 100)}%" : "—";
    private static string DciDelta(double? previous, double? current)
    {
        if (previous is not { } p || current is not { } c) return "";
        var diff = (int)Math.Round((c - p) * 100);
        return diff == 0 ? "±0%" : diff > 0 ? $"+{diff}%" : $"{diff}%";
    }

    private Legal.Application.Features.Intelligence.Decision.DecisionSnapshotDto? DciSnapshotById(Guid? id) =>
        id is { } sid ? _cdcSnapshots.FirstOrDefault(s => s.DecisionSnapshotId == sid) : null;

    private string DciSnapshotLabel(Guid? id)
    {
        var snap = DciSnapshotById(id);
        return snap is null ? "—" : $"Snapshot #{snap.SnapshotNumber}";
    }

    private async Task SelectDciDeltaAsync(Legal.Application.Features.Intelligence.Decision.DecisionDeltaDto delta)
    {
        _dciSelectedDeltaId = delta.DecisionDeltaId;
        _dciChangeReview = null;
        if (delta.MatterChangeEventId is { } eventId)
            await LoadDciChangeReviewAsync(eventId);
    }

    // Loads the DB-backed impact rows for the selected delta's change event (Why It Changed traceability).
    private async Task LoadDciChangeReviewAsync(Guid changeEventId)
    {
        if (_dciChangeReviewLoading) return;
        _dciChangeReviewLoading = true;
        try { _dciChangeReview = await Api.GetLegalDecisionChangeReviewAsync(changeEventId); }
        catch { _dciChangeReview = null; }
        finally { _dciChangeReviewLoading = false; StateHasChanged(); }
    }

    private async Task SelectDciViewAsync(string view)
    {
        _dciView = view;
        if (view == "Why It Changed" && _dciChangeReview is null && DciSelectedDelta?.MatterChangeEventId is { } eventId)
            await LoadDciChangeReviewAsync(eventId);
    }

    private RenderFragment DciDashboard => __builder =>
    {
        var deltas = DciDeltas;
        var selected = DciSelectedDelta;
        var latest = deltas.FirstOrDefault();

        <div class="dci-root">
            <div class="dci-topbar">
                <div class="dci-topbar-title">
                    <span class="dci-topbar-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span>
                    <div>
                        <div class="dci-topbar-heading">
                            <h4>Decision Intelligence &mdash; Changes Since Last Review</h4>
                            @if (latest is not null)
                            {
                                <span class="dci-badge dci-badge--live"><span class="dci-live-dot" aria-hidden="true"></span> Live</span>
                            }
                        </div>
                        <p class="dci-topbar-sub">
                            @if (latest is not null)
                            {
                                <span>Last updated: @latest.OccurredDateUtc.ToString("MMM dd, yyyy h:mm tt")</span>
                                @if (DciLastReviewedUtc is { } reviewed)
                                {
                                    <span> · since reviewed snapshot of @reviewed.ToString("MMM dd, yyyy h:mm tt")</span>
                                }
                                else
                                {
                                    <span> · no reviewed snapshot yet — showing all recorded changes</span>
                                }
                            }
                            else
                            {
                                <span>Every material change is reevaluated by POLOXI Core into an immutable decision delta.</span>
                            }
                        </p>
                    </div>
                </div>
                @if (DciReviewRequiredCount > 0)
                {
                    <button type="button" class="dci-btn dci-btn--primary" @onclick='() => SelectDciViewAsync("Review Queue")'>
                        Review Required (@DciReviewRequiredCount) <i class="bi bi-chevron-right"></i>
                    </button>
                }
            </div>

            @* ── Live Decision Monitor KPI strip (all values DB-backed; 0 when not computed) ── *@
            <div class="dci-kpi-strip">
                <div class="dci-kpi dci-kpi--evidence">
                    <span class="dci-kpi-ic"><i class="bi bi-file-earmark-text"></i></span>
                    <div><span class="dci-kpi-num">@DciNewEvidenceCount</span><span class="dci-kpi-lbl">New Evidence</span></div>
                </div>
                <div class="dci-kpi dci-kpi--props">
                    <span class="dci-kpi-ic"><i class="bi bi-diagram-2"></i></span>
                    <div><span class="dci-kpi-num">@DciChangedPropositionCount</span><span class="dci-kpi-lbl">Changed Propositions</span></div>
                </div>
                <div class="dci-kpi dci-kpi--outcomes">
                    <span class="dci-kpi-ic"><i class="bi bi-bank"></i></span>
                    <div><span class="dci-kpi-num">@DciAffectedOutcomeCount</span><span class="dci-kpi-lbl">Affected Outcomes</span></div>
                </div>
                <div class="dci-kpi dci-kpi--contradictions">
                    <span class="dci-kpi-ic"><i class="bi bi-exclamation-triangle"></i></span>
                    <div><span class="dci-kpi-num">@DciNewContradictionCount</span><span class="dci-kpi-lbl">New Contradictions</span></div>
                </div>
                <div class="dci-kpi dci-kpi--frontier">
                    <span class="dci-kpi-ic"><i class="bi bi-bullseye"></i></span>
                    <div><span class="dci-kpi-num">@DciFrontierChangeCount</span><span class="dci-kpi-lbl">Decision-Frontier Changes</span></div>
                </div>
                <div class="dci-kpi dci-kpi--review">
                    <span class="dci-kpi-ic"><i class="bi bi-flag"></i></span>
                    <div><span class="dci-kpi-num">@DciReviewRequiredCount</span><span class="dci-kpi-lbl">Material Changes Requiring Review</span></div>
                </div>
            </div>

            @if (deltas.Count == 0)
            {
                <div class="dci-empty">
                    <i class="bi bi-activity" aria-hidden="true"></i>
                    <h5>No decision changes yet</h5>
                    <p>As new documents and evidence are ingested, POLOXI reevaluates the matter and records each material change here as a traceable before/after decision delta.</p>
                </div>
            }
            else
            {
                @* ── Inner view tabs ── *@
                <div class="dci-views" role="tablist">
                    @foreach (var view in DciViews)
                    {
                        <button type="button" role="tab"
                                class="dci-view-tab @(_dciView == view ? "dci-view-tab--active" : "")"
                                @onclick="() => SelectDciViewAsync(view)">@view</button>
                    }
                </div>

                <div class="dci-view-panel">
                    @switch (_dciView)
                    {
                        case "Changes":
                            <div class="dci-feed">
                                @foreach (var d in deltas)
                                {
                                    <button type="button" class="dci-feed-item @(d.DecisionDeltaId == _dciSelectedDeltaId ? "dci-feed-item--active" : "")"
                                            @onclick="() => SelectDciDeltaAsync(d)">
                                        <span class="dci-feed-time">@d.OccurredDateUtc.ToString("MMM dd, yyyy h:mm tt")</span>
                                        <span class="dci-feed-body">
                                            <span class="dci-feed-head">
                                                <span class="dci-chip dci-chip--@DciDeltaKindTone(d.DeltaKindCode)">@DciDeltaKindLabel(d.DeltaKindCode)</span>
                                                @if (d.AttorneyReviewRequired)
                                                {
                                                    <span class="dci-chip dci-chip--danger">Review required</span>
                                                }
                                            </span>
                                            <strong class="dci-feed-title">@(d.Summary ?? d.ChangeSourceLabel ?? "Decision reevaluated")</strong>
                                            <span class="dci-feed-meta">
                                                @d.AffectedPropositionCount propositions · @d.AffectedCandidateCount candidates · @d.AffectedEvidenceCount evidence
                                                @if (d.FrontierChanged == true)
                                                {
                                                    <span> · frontier changed</span>
                                                }
                                            </span>
                                        </span>
                                        <i class="bi bi-chevron-right dci-feed-arrow"></i>
                                    </button>
                                }
                            </div>
                            break;

                        case "Before vs After":
                            @if (selected is null)
                            {
                                <p class="dci-muted">Select a change from the Changes feed to compare snapshots.</p>
                            }
                            else
                            {
                                <div class="dci-compare">
                                    <div class="dci-compare-col">
                                        <h6>@DciSnapshotLabel(selected.FromSnapshotId)</h6>
                                        <span class="dci-compare-sub">Before</span>
                                        <ul class="dci-compare-metrics">
                                            <li><span>Leading outcome</span><strong>@(selected.PreviousWinnerLabel ?? "—")</strong></li>
                                            <li><span>Margin</span><strong>@DciScore(selected.PreviousMargin)</strong></li>
                                            <li><span>Uncertainty</span><strong>@DciScore(selected.PreviousEntropy)</strong></li>
                                            <li><span>Readiness</span><strong>@(selected.PreviousReadinessCode ?? "—")</strong></li>
                                        </ul>
                                    </div>
                                    <div class="dci-compare-arrow"><i class="bi bi-arrow-right"></i></div>
                                    <div class="dci-compare-col dci-compare-col--after">
                                        <h6>@DciSnapshotLabel(selected.ToSnapshotId)</h6>
                                        <span class="dci-compare-sub">After</span>
                                        <ul class="dci-compare-metrics">
                                            <li><span>Leading outcome</span><strong>@(selected.CurrentWinnerLabel ?? "—")</strong></li>
                                            <li><span>Margin</span><strong>@DciScore(selected.CurrentMargin) <em class="dci-delta">@DciDelta(selected.PreviousMargin, selected.CurrentMargin)</em></strong></li>
                                            <li><span>Uncertainty</span><strong>@DciScore(selected.CurrentEntropy)</strong></li>
                                            <li><span>Readiness</span><strong>@(selected.CurrentReadinessCode ?? "—")</strong></li>
                                        </ul>
                                    </div>
                                </div>
                                <p class="dci-illustrative"><i class="bi bi-info-circle"></i> Percentages are illustrative decision-state indicators, not legal win probabilities.</p>
                            }
                            break;

                        case "Why It Changed":
                            @if (selected is null)
                            {
                                <p class="dci-muted">Select a change to trace why it changed.</p>
                            }
                            else if (_dciChangeReviewLoading)
                            {
                                <p class="dci-muted">Loading traceability…</p>
                            }
                            else if (_dciChangeReview is null || _dciChangeReview.Impacts.Count == 0)
                            {
                                <div class="dci-why">
                                    <p class="dci-muted">@(selected.RequiredAction ?? "No detailed impact rows were recorded for this change.")</p>
                                </div>
                            }
                            else
                            {
                                <div class="dci-why">
                                    @if (!string.IsNullOrWhiteSpace(_dciChangeReview.ChangeEvent.SourceLabel))
                                    {
                                        <div class="dci-why-source"><i class="bi bi-file-earmark-text"></i> @_dciChangeReview.ChangeEvent.SourceLabel</div>
                                    }
                                    <ul class="dci-why-chain">
                                        @foreach (var impact in _dciChangeReview.Impacts)
                                        {
                                            <li class="dci-why-node">
                                                <span class="dci-chip dci-chip--info">@impact.AffectedKindCode</span>
                                                <strong>@(impact.AffectedLabel ?? impact.AffectedKey)</strong>
                                                <span class="dci-why-transition">@(impact.PreviousStateCode ?? "—") <i class="bi bi-arrow-right"></i> @(impact.CurrentStateCode ?? "—")</span>
                                                @if (!string.IsNullOrWhiteSpace(impact.Rationale))
                                                {
                                                    <span class="dci-why-reason">@impact.Rationale</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            break;

                        case "What Matters Now":
                            <div class="dci-frontier">
                                <h6>Current decision frontier</h6>
                                <p class="dci-muted">Highest-information-value propositions after the latest changes. POLOXI ranks what to investigate next.</p>
                                @if (PropositionInfoValues.Count == 0)
                                {
                                    <p class="dci-muted">No proposition frontier is available yet for this matter.</p>
                                }
                                else
                                {
                                    <ul class="dci-frontier-list">
                                        @foreach (var p in PropositionInfoValues)
                                        {
                                            <li class="dci-frontier-item">
                                                <div class="dci-frontier-bar" style="width:@(Math.Round((double)(p.InformationValue / PropositionInfoValueMax) * 100))%"></div>
                                                <div class="dci-frontier-copy">
                                                    <strong>@p.PropositionText</strong>
                                                    <span class="dci-frontier-meta">IV @p.InformationValue.ToString("0.00") · <span class="dci-chip dci-chip--@PropositionStateTone(p.VerificationStateCode)">@(p.VerificationStateCode ?? "Unresolved")</span></span>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                            break;

                        case "Review Queue":
                            var reviewDeltas = deltas.Where(d => d.AttorneyReviewRequired).ToArray();
                            @if (reviewDeltas.Length == 0)
                            {
                                <p class="dci-muted">No material changes are currently awaiting attorney review.</p>
                            }
                            else
                            {
                                <div class="dci-queue">
                                    @foreach (var d in reviewDeltas)
                                    {
                                        <div class="dci-queue-item">
                                            <div class="dci-queue-head">
                                                <span class="dci-chip dci-chip--danger">Material change</span>
                                                <strong>@DciSnapshotLabel(d.ToSnapshotId)</strong>
                                                <span class="dci-muted ms-auto">@d.OccurredDateUtc.ToString("MMM dd, yyyy h:mm tt")</span>
                                            </div>
                                            <p class="dci-queue-summary">@(d.Summary ?? "New evidence changed the decision state.")</p>
                                            <p class="dci-queue-meta">@d.AffectedPropositionCount propositions · @d.AffectedCandidateCount candidate outcomes affected@(d.FrontierChanged == true ? " · decision frontier changed" : "")</p>
                                            @if (!string.IsNullOrWhiteSpace(d.RequiredAction))
                                            {
                                                <p class="dci-queue-action"><i class="bi bi-arrow-return-right"></i> @d.RequiredAction</p>
                                            }
                                            <div class="dci-queue-actions">
                                                <button type="button" class="dci-btn dci-btn--ghost" @onclick="() => SelectDciDeltaAsync(d)">Review evidence</button>
                                                <button type="button" class="dci-btn dci-btn--ghost" @onclick='async () => { await SelectDciDeltaAsync(d); _dciView = "Before vs After"; }'>Compare snapshots</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            break;
                    }
                </div>
            }
        </div>
    };

    // ── Decision Analysis tab state ──────────────────────────────────────────────────────────────
    // Every value on this tab is a PROJECTION of the authoritative POLOXI DecisionSnapshot held in
    // _response (candidates, factor inventory, shared dependencies, proposed authorities, evidence).
    // Nothing here computes a new score, IV, hierarchy, or candidate — read-model only.
    private string _daSubTab = "Decision Brief";
    private static readonly string[] DaSubTabs =
        ["Decision Brief", "Factors", "Propositions", "Evidence", "Contradictions", "Authority",
         "Proof Map", "Causation", "Chronology", "Entities", "Frontier & Gaps", "Flip Points",
         "Scenario Lab", "Investigation", "Attorney Input", "Decision Changes", "Full Trace"];
    private string? _daSelectedFactorId;
    private Guid? _daSelectedCandidateId;

    // The Decision Analysis snapshot projects the FULL authoritative candidate pool ordered by rank —
    // including constraint-violation ("RULED OUT") candidates, which the dashboard is designed to render.
    // Using FinalRankedCandidates here (which strips violations) would hide the entire snapshot when every
    // surviving formal candidate was ruled out, even though _response holds a real completed decision.
    private IReadOnlyList<WideCandidateDto> DaCandidates => _response is null ? []
        : _response.Candidates.OrderBy(c => c.RankNumber).Take(4).ToArray();
    private WideCandidateDto? DaSelectedCandidate => DaCandidates.Count == 0 ? null
        : (_daSelectedCandidateId is null ? DaCandidates[0]
            : DaCandidates.FirstOrDefault(c => c.WideCandidateId == _daSelectedCandidateId) ?? DaCandidates[0]);
    private int DaSelectedCandidateIndex
    {
        get
        {
            var sel = DaSelectedCandidate;
            if (sel is null) return 0;
            for (var i = 0; i < DaCandidates.Count; i++)
            {
                if (DaCandidates[i].WideCandidateId == sel.WideCandidateId) return i;
            }
            return 0;
        }
    }
    private void DaSelectCandidate(Guid id) => _daSelectedCandidateId = id;
    private WideFactorInventoryDto? DaInventory => _response?.DecisionInspector?.FactorInventory;
    private IReadOnlyList<WideFactorDto> DaFactors => DaInventory?.Factors?.ToArray() ?? [];
    private IReadOnlyList<WideFactorDto> DaParentFactors => DaFactors.Where(f => f.NodeKind == "PARENT").ToArray();
    private IReadOnlyList<WideFactorDto> DaAtomicFactors => DaFactors.Where(f => f.NodeKind == "ATOMIC").ToArray();
    private IReadOnlyList<WideFactorDto> DaContradictedFactors => DaFactors.Where(f => f.Contradictions.Count > 0).ToArray();
    private IReadOnlyList<WideInspectorDependencyDto> DaSharedDeps => _response?.DecisionInspector?.SharedDependencies?.ToArray() ?? [];
    private IReadOnlyList<WideInspectorDependencyDto> DaFrontierDeps => DaSharedDeps.Where(d => !string.IsNullOrWhiteSpace(d.UnresolvedInformation)).ToArray();
    private IReadOnlyList<WideProposedAuthorityDto> DaAuthorities => _response?.ProposedLegalAuthorities?.ToArray() ?? [];
    private IReadOnlyList<PoloxiEvidenceDto> DaEvidence => _response?.Evidence?.OrderByDescending(e => e.RelevanceScore).ToArray() ?? [];
    private WideFactorDto? DaSelectedFactor => _daSelectedFactorId is null
        ? DaAtomicFactors.FirstOrDefault()
        : DaFactors.FirstOrDefault(f => f.FactorId == _daSelectedFactorId) ?? DaAtomicFactors.FirstOrDefault();

    private decimal DaModelConfidence => _response?.DecisionConfidence ?? _response?.FinalConfidence ?? 0m;
    private decimal DaDecisionUncertainty => Math.Clamp(1m - DaModelConfidence, 0m, 1m);
    private decimal DaStructuralCoverage => _response?.EvidenceCoverage ?? 0m;
    private decimal DaEvidenceCoverage => _response?.DecisionEvidenceCoverage ?? 0m;
    private decimal DaAuthorityCoverage => DaAuthorities.Count == 0 ? 0m
        : (decimal)DaAuthorities.Count(a => string.Equals(a.VerificationStatus, "VERIFIED", StringComparison.OrdinalIgnoreCase)) / DaAuthorities.Count;
    private string DaStabilityState => _response?.WinnerStability switch
    {
        null => "INSUFFICIENT HISTORY",
        >= 0.8m => "STABLE",
        >= 0.5m => "RECENTLY CHANGED",
        _ => "VOLATILE"
    };
    private string DaReadinessState => DaInventory?.DecisionReadinessStatus ?? "PROVISIONAL";
    private string DaCandidateState(WideCandidateDto c) => c.IsConstraintViolation
        ? "RULED OUT"
        : c.SupportTierCode switch { "STRONG" => "SUPPORTED", "MODERATE" => "CONTESTED", "LIMITED" => "UNRESOLVED", _ => "CONTESTED" };
    private static string DaFactorStateLabel(WideFactorDto f) => f.Contradictions.Count > 0 ? "CONTRADICTED"
        : f.EvidenceAdmissionState switch
        {
            "VERIFIED" => "ESTABLISHED",
            "SUPPORTED" => "SUPPORTED",
            "EXTRACTED" or "SOURCE_AVAILABLE" or "SUPPLIED" => "SUPPLIED",
            "UNRESOLVED" => "UNRESOLVED",
            _ => f.EvidenceAdmissionState
        };
    private static string DaFactorTone(WideFactorDto f) => DaFactorStateLabel(f) switch
    {
        "ESTABLISHED" => "ok",
        "SUPPORTED" => "ok",
        "CONTRADICTED" => "bad",
        "UNRESOLVED" => "warn",
        _ => "muted"
    };
    private void DaSelectFactor(string factorId) => _daSelectedFactorId = factorId;

    private RenderFragment DecisionAnalysisDashboard => __builder =>
    {
        <div class="da-root">
            @if (_response is null || _response.Candidates.Count == 0)
            {
                <div class="da-empty">
                    <i class="bi bi-diagram-3" aria-hidden="true"></i>
                    <h4>No decision snapshot yet</h4>
                    <p>Run a decision analysis for this matter. Once POLOXI produces a candidate competition, this tab projects the authoritative decision snapshot — candidate headers, factor map, evidence balance, contradictions, authority map and full trace — with no fabricated values.</p>
                </div>
            }
            else
            {
                var leader = DaCandidates[0];
                var selected = DaSelectedCandidate ?? leader;
                var selectedIdx = DaSelectedCandidateIndex + 1;
                var maxScore = Math.Max(0.01m, DaCandidates.Max(c => c.CompositeScore));

                <div class="da-candstrip" role="group" aria-label="Select a candidate to inspect">
                    @for (var i = 0; i < DaCandidates.Count; i++)
                    {
                        var c = DaCandidates[i];
                        var idx = i + 1;
                        var isSel = c.WideCandidateId == selected.WideCandidateId;
                        <button type="button" class="da-cand da-cand--c@(idx) @(isSel ? "da-cand--leader" : "")"
                                aria-pressed="@(isSel ? "true" : "false")"
                                aria-label="@($"Candidate {idx}: {c.DisplayName}, POLOXI score {(c.CompositeScore * 100m).ToString("0")}{(isSel ? ", selected" : "")}")"
                                @onclick="() => DaSelectCandidate(c.WideCandidateId)">
                            <span class="da-cand-code">C@(idx)</span>
                            <span class="da-cand-name">@c.DisplayName</span>
                            <span class="da-cand-score">@((c.CompositeScore * 100m).ToString("0"))</span>
                            <span class="da-cand-track"><span class="da-cand-fill" style="width:@(((c.CompositeScore / maxScore) * 100m).ToString("0"))%"></span></span>
                        </button>
                    }
                </div>

                <div class="da-grid3">
                    @* ── Selected candidate header card ── *@
                    <div class="da-panel da-headercard">
                        <div class="da-headercard-top">
                            <span class="da-cand-code da-cand-code--lg da-cand--c@(selectedIdx)">C@(selectedIdx)</span>
                            <div>
                                <h4>@selected.DisplayName</h4>
                                <span class="da-chip da-chip--@(selected.IsConstraintViolation ? "bad" : "warn")">@DaCandidateState(selected)</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(selected.Detail))
                        {
                            <p class="da-headercard-detail">@selected.Detail</p>
                        }
                        <div class="da-metricgrid">
                            <div class="da-metric"><span class="da-metric-lbl">POLOXI Decision Score</span><span class="da-metric-val">@((selected.CompositeScore * 100m).ToString("0"))</span><span class="da-metric-scope da-metric-scope--cand">C@(selectedIdx)</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Model Confidence</span><span class="da-metric-val">@selected.EvidenceConfidence.ToString("0.00")</span><span class="da-metric-scope da-metric-scope--cand">C@(selectedIdx)</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Decision Uncertainty</span><span class="da-metric-val">@DaDecisionUncertainty.ToString("0.00")</span><span class="da-metric-scope da-metric-scope--wide">Decision-wide</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Decision Stability</span><span class="da-metric-val da-metric-val--sm">@DaStabilityState</span><span class="da-metric-scope da-metric-scope--wide">Decision-wide</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Structural Coverage</span><span class="da-metric-val">@DaStructuralCoverage.ToString("P0")</span><span class="da-metric-scope da-metric-scope--wide">Decision-wide</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Evidence Coverage</span><span class="da-metric-val">@selected.EvidenceCoverage.ToString("P0")</span><span class="da-metric-scope da-metric-scope--cand">C@(selectedIdx)</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Authority Coverage</span><span class="da-metric-val">@DaAuthorityCoverage.ToString("P0")</span><span class="da-metric-scope da-metric-scope--wide">Decision-wide</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Decision Frontier</span><span class="da-metric-val">@DaFrontierDeps.Count</span><span class="da-metric-scope da-metric-scope--wide">Decision-wide</span></div>
                            <div class="da-metric"><span class="da-metric-lbl">Decision Readiness</span><span class="da-metric-val da-metric-val--sm">@DaReadinessState</span><span class="da-metric-scope da-metric-scope--wide">Decision-wide</span></div>
                        </div>
                    </div>

                    @* ── Candidate comparison (key metrics) ── *@
                    <div class="da-panel">
                        <h4 class="da-panel-title">Candidate Comparison <span class="da-panel-sub">Key metrics</span></h4>
                        <div class="da-tablewrap">
                            <table class="da-table">
                                <thead>
                                    <tr>
                                        <th>Metric</th>
                                        @for (var i = 0; i < DaCandidates.Count; i++)
                                        {
                                            <th>C@(i + 1) @DaCandidates[i].DisplayName</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td>POLOXI Score</td>@foreach (var c in DaCandidates){<td>@((c.CompositeScore * 100m).ToString("0"))</td>}</tr>
                                    <tr><td>Model Confidence</td>@foreach (var c in DaCandidates){<td>@c.EvidenceConfidence.ToString("0.00")</td>}</tr>
                                    <tr><td>Quality Score</td>@foreach (var c in DaCandidates){<td>@c.QualityScore.ToString("P0")</td>}</tr>
                                    <tr><td>Evidence Coverage</td>@foreach (var c in DaCandidates){<td>@c.EvidenceCoverage.ToString("P0")</td>}</tr>
                                    <tr><td>Support Tier</td>@foreach (var c in DaCandidates){<td>@c.SupportTierCode</td>}</tr>
                                    <tr><td>Interpretive Support</td>@foreach (var c in DaCandidates){<td>@c.InterpretiveSupportCount</td>}</tr>
                                    <tr><td>Evidence Hosts</td>@foreach (var c in DaCandidates){<td>@c.EvidenceHostSupportCount</td>}</tr>
                                    <tr><td>Decision State</td>@foreach (var c in DaCandidates){<td>@DaCandidateState(c)</td>}</tr>
                                    <tr><td>Est. Resolution</td>@foreach (var c in DaCandidates){<td>@(c.EstimatedResolutionLabel ?? "—")</td>}</tr>
                                    <tr><td>Est. Cost Band</td>@foreach (var c in DaCandidates){<td>@(c.EstimatedCostBand ?? "—")</td>}</tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    @* ── Decision landscape (value × likelihood) ── *@
                    <div class="da-panel">
                        <h4 class="da-panel-title">Decision Landscape</h4>
                        <div class="da-scatter">
                            <span class="da-scatter-ylbl">Higher likelihood</span>
                            <span class="da-scatter-ylbl da-scatter-ylbl--low">Lower likelihood</span>
                            <span class="da-scatter-xlbl da-scatter-xlbl--low">Lower value</span>
                            <span class="da-scatter-xlbl">Higher value</span>
                            @for (var i = 0; i < DaCandidates.Count; i++)
                            {
                                var c = DaCandidates[i];
                                var x = Math.Clamp(c.CompositeScore * 100m, 4m, 94m);
                                var y = Math.Clamp(c.EvidenceConfidence * 100m, 4m, 92m);
                                <span class="da-scatter-dot da-scatter-dot--c@(i + 1)" style="left:@x.ToString("0")%;bottom:@y.ToString("0")%"
                                      title="C@(i + 1) @c.DisplayName · score @((c.CompositeScore * 100m).ToString("0")) · confidence @c.EvidenceConfidence.ToString("0.00")">
                                    C@(i + 1)
                                </span>
                            }
                        </div>
                    </div>
                </div>

                @* ── Inner sub-tab strip ── *@
                <div class="da-subtabs" role="tablist">
                    @foreach (var st in DaSubTabs)
                    {
                        <button type="button" role="tab" aria-selected="@(_daSubTab == st ? "true" : "false")" class="da-subtab @(_daSubTab == st ? "da-subtab--active" : "")" @onclick="() => _daSubTab = st">@st</button>
                    }
                </div>

                <div class="da-subgrid">
                    <div class="da-panel da-subbody">
                        @switch (_daSubTab)
                        {
                            case "Decision Brief":
                                <h4 class="da-panel-title">Executive Summary (C1)</h4>
                                @if (!string.IsNullOrWhiteSpace(_response.FinalAnswer))
                                {
                                    <p class="da-brief">@_response.FinalAnswer</p>
                                }
                                else if (!string.IsNullOrWhiteSpace(leader.Detail))
                                {
                                    <p class="da-brief">@leader.Detail</p>
                                }
                                else
                                {
                                    <p class="da-empty-inline">No composed decision brief is available for this snapshot yet.</p>
                                }
                                @if (DaInventory is { BlockingObligations.Count: > 0 })
                                {
                                    <div class="da-callout da-callout--warn">
                                        <strong>Blocking obligations</strong>
                                        <ul>@foreach (var b in DaInventory.BlockingObligations){<li>@b</li>}</ul>
                                    </div>
                                }
                                break;

                            case "Factors":
                                <h4 class="da-panel-title">Material Factors (L1 / L2)</h4>
                                @if (DaParentFactors.Count == 0 && DaFactors.Count == 0)
                                {
                                    <p class="da-empty-inline">No factor inventory was produced for this snapshot.</p>
                                }
                                else
                                {
                                    <table class="da-table">
                                        <thead><tr><th>Factor</th><th>Type</th><th>State</th><th>Availability</th><th>Verification</th></tr></thead>
                                        <tbody>
                                            @foreach (var f in (DaParentFactors.Count > 0 ? DaParentFactors : DaFactors))
                                            {
                                                <tr>
                                                    <td>@f.FactorName</td>
                                                    <td>@f.FactorType</td>
                                                    <td><span class="da-chip da-chip--@DaFactorTone(f)">@DaFactorStateLabel(f)</span></td>
                                                    <td>@f.Availability</td>
                                                    <td>@f.VerificationStatus</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                break;

                            case "Propositions":
                                <h4 class="da-panel-title">Proposition Ledger (@DaAtomicFactors.Count)</h4>
                                @if (DaAtomicFactors.Count == 0)
                                {
                                    <p class="da-empty-inline">No atomic propositions were resolved for this snapshot.</p>
                                }
                                else
                                {
                                    <table class="da-table">
                                        <thead><tr><th>Proposition</th><th>State</th><th>Admission</th><th>Binding</th></tr></thead>
                                        <tbody>
                                            @foreach (var f in DaAtomicFactors)
                                            {
                                                <tr class="da-row-click" @onclick="() => DaSelectFactor(f.FactorId)">
                                                    <td>@f.FactorName</td>
                                                    <td><span class="da-chip da-chip--@DaFactorTone(f)">@DaFactorStateLabel(f)</span></td>
                                                    <td>@f.EvidenceAdmissionState</td>
                                                    <td>@f.BindingAdmissibility</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                break;

                            case "Evidence":
                                <h4 class="da-panel-title">Evidence Balance (@DaEvidence.Count)</h4>
                                @if (DaEvidence.Count == 0)
                                {
                                    <p class="da-empty-inline">No evidence items were admitted for this snapshot.</p>
                                }
                                else
                                {
                                    <table class="da-table">
                                        <thead><tr><th>Source</th><th>Module</th><th>Relevance</th><th>Rank</th></tr></thead>
                                        <tbody>
                                            @foreach (var e in DaEvidence.Take(40))
                                            {
                                                <tr>
                                                    <td>@e.Title</td>
                                                    <td>@e.ModuleCode</td>
                                                    <td>@e.RelevanceScore.ToString("P0")</td>
                                                    <td>@e.RankNumber</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                break;

                            case "Contradictions":
                                <h4 class="da-panel-title">Contradiction Intelligence (@DaContradictedFactors.Count)</h4>
                                @if (DaContradictedFactors.Count == 0)
                                {
                                    <p class="da-empty-inline">No contradicted propositions were detected in this snapshot.</p>
                                }
                                else
                                {
                                    <ul class="da-contra">
                                        @foreach (var f in DaContradictedFactors)
                                        {
                                            <li>
                                                <strong>@f.FactorName</strong>
                                                <div class="da-contra-conflicts">
                                                    @foreach (var conflict in f.Contradictions)
                                                    {
                                                        <span class="da-chip da-chip--bad">@conflict</span>
                                                    }
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                                break;

                            case "Authority":
                                <h4 class="da-panel-title">Authority Map (@DaAuthorities.Count)</h4>
                                @if (DaAuthorities.Count == 0)
                                {
                                    <p class="da-empty-inline">No legal authorities were proposed for this snapshot.</p>
                                }
                                else
                                {
                                    <table class="da-table">
                                        <thead><tr><th>Authority</th><th>Kind</th><th>Relevance</th><th>Verification</th></tr></thead>
                                        <tbody>
                                            @foreach (var a in DaAuthorities)
                                            {
                                                <tr>
                                                    <td>@a.Name</td>
                                                    <td>@a.Kind</td>
                                                    <td>@a.Relevance</td>
                                                    <td><span class="da-chip da-chip--@(string.Equals(a.VerificationStatus, "VERIFIED", StringComparison.OrdinalIgnoreCase) ? "ok" : "muted")">@a.VerificationStatus</span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                break;

                            case "Frontier & Gaps":
                                <h4 class="da-panel-title">Decision Frontier (@DaFrontierDeps.Count)</h4>
                                @if (DaFrontierDeps.Count == 0)
                                {
                                    <p class="da-empty-inline">No unresolved decision-frontier dependencies remain for this snapshot.</p>
                                }
                                else
                                {
                                    <ul class="da-frontier">
                                        @foreach (var d in DaFrontierDeps)
                                        {
                                            <li>
                                                <div><strong>@d.Proposition</strong><span class="da-chip da-chip--warn">@d.VerificationState</span></div>
                                                @if (!string.IsNullOrWhiteSpace(d.UnresolvedInformation))
                                                {
                                                    <p class="da-frontier-un">@d.UnresolvedInformation</p>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                break;

                            case "Attorney Input":
                                <h4 class="da-panel-title">Attorney Decision Input</h4>
                                <p class="da-empty-inline">Attorney assessments for this snapshot are surfaced on the Human Intelligence tab. When authorized attorneys assess these candidates, factors and propositions, their approved matter assessments appear here.</p>
                                break;

                            default:
                                <h4 class="da-panel-title">@_daSubTab</h4>
                                <p class="da-empty-inline">This projection reads directly from the authoritative decision snapshot. Backed data for this view is populated as the Decision Proof Ledger substrate is produced for the current matter — no values are shown until they trace to real snapshot state.</p>
                                break;
                        }
                    </div>

                    @* ── Selected proposition drawer ── *@
                    <div class="da-panel da-drawer">
                        <h4 class="da-panel-title">Selected Proposition</h4>
                        @if (DaSelectedFactor is { } sf)
                        {
                            <div class="da-drawer-head">
                                <span class="da-chip da-chip--@DaFactorTone(sf)">@DaFactorStateLabel(sf)</span>
                                <strong>@sf.FactorName</strong>
                            </div>
                            <dl class="da-drawer-dl">
                                <dt>Factor type</dt><dd>@sf.FactorType</dd>
                                <dt>Source</dt><dd>@sf.Source</dd>
                                <dt>Actual value</dt><dd>@(sf.ActualValue ?? "—")</dd>
                                <dt>Availability</dt><dd>@sf.Availability</dd>
                                <dt>Verification</dt><dd>@sf.VerificationStatus</dd>
                                <dt>Admission state</dt><dd>@sf.EvidenceAdmissionState</dd>
                                <dt>Binding</dt><dd>@sf.BindingAdmissibility</dd>
                            </dl>
                            @if (!string.IsNullOrWhiteSpace(sf.VerificationObligation))
                            {
                                <div class="da-callout da-callout--warn"><strong>Verification obligation</strong><p>@sf.VerificationObligation</p></div>
                            }
                            @if (sf.Contradictions.Count > 0)
                            {
                                <div class="da-callout da-callout--bad">
                                    <strong>Contradictions</strong>
                                    <ul>@foreach (var conflict in sf.Contradictions){<li>@conflict</li>}</ul>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(sf.MissingInformation))
                            {
                                <div class="da-callout"><strong>Missing information</strong><p>@sf.MissingInformation</p></div>
                            }
                        }
                        else
                        {
                            <p class="da-empty-inline">Select a proposition to trace its evidence, verification and candidate impact.</p>
                        }
                    </div>
                </div>

                @* ── Snapshot provenance / staleness ── *@
                <div class="da-provenance">
                    <span><i class="bi bi-hash" aria-hidden="true"></i> Snapshot @_response.WideExecutionId.ToString("N").Substring(0, 8)</span>
                    <span><i class="bi bi-diagram-2" aria-hidden="true"></i> Depth @_response.DepthReached</span>
                    <span><i class="bi bi-shield-check" aria-hidden="true"></i> @(_response.AnswerVerificationCode ?? "—")</span>
                    <span><i class="bi bi-clock" aria-hidden="true"></i> @_response.DurationMilliseconds ms</span>
                    <span class="da-provenance-note">Every value on this tab projects the authoritative POLOXI decision snapshot — no independent scoring.</span>
                </div>
            }
        </div>
    };

    private RenderFragment CdcDashboard => __builder =>
    {
        <div class="cdc-root">
            <div class="cdc-topbar">
                <div class="cdc-topbar-title">
                    <span class="cdc-topbar-icon"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span>
                    <div>
                        <div class="cdc-topbar-heading">
                            <h4>Continuous Decision Calibration</h4>
                            @if (CdcAutoCalibrationEnabled)
                            {
                                <span class="cdc-badge cdc-badge--ok"><i class="bi bi-check-circle-fill"></i> Auto-calibration enabled</span>
                            }
                        </div>
                        <p class="cdc-topbar-sub">Incorporates new information — document uploads, supporting-document cleanup, and authorized attorney decision input (Human Intelligence) — then recalculates affected propositions, factors, and candidate outcomes and tracks every change over time.</p>
                    </div>
                </div>
                <div class="cdc-topbar-actions">
                    @if (CdcSnapshots.Count > 0)
                    {
                        <div class="cdc-snapshot-select">
                            <i class="bi bi-clock-history" aria-hidden="true"></i>
                            <select class="cdc-select" value="@_cdcSelectedSnapshotId" @onchange="OnCdcSnapshotChanged">
                                @foreach (var s in CdcSnapshots)
                                {
                                    <option value="@s.DecisionSnapshotId">@CdcSnapshotLabel(s) · @s.EvaluatedDateUtc.ToString("MMM dd, yyyy h:mm tt")</option>
                                }
                            </select>
                        </div>
                    }
                    <button type="button" class="cdc-btn cdc-btn--primary" disabled="@_loading" @onclick="RunCalibrationNowAsync">
                        <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i> Run Calibration Now
                    </button>
                </div>
            </div>

            <div class="cdc-row cdc-row--head">
                <div class="cdc-outcomes">
                    @if (CdcOutcomes.Count > 0)
                    {
                        @foreach (var o in CdcOutcomes)
                        {
                            <div class="cdc-outcome-card @(o.IsLeader ? "cdc-outcome-card--leader" : "cdc-outcome-card--compete")">
                                <div class="cdc-outcome-tag">
                                    <i class="bi @(o.IsLeader ? "bi-trophy-fill" : "bi-diagram-3")" aria-hidden="true"></i>
                                    @(o.IsLeader ? "Current Leader" : "Competing")
                                </div>
                                <div class="cdc-outcome-title">@o.Code · @o.Title</div>
                                <div class="cdc-outcome-pct">@o.SupportPct%</div>
                                <div class="cdc-outcome-bar"><span style="width:@(o.SupportPct)%"></span></div>
                                <div class="cdc-outcome-foot">Support index (illustrative)</div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="dfi-empty">No calibrated outcomes are available for this matter yet. Run a calibration to populate outcomes.</p>
                    }
                </div>
                <div class="cdc-status-card">
                    <div class="cdc-card-head"><i class="bi bi-clipboard-check" aria-hidden="true"></i> Calibration Status</div>
                    <ul class="cdc-status-list">
                        @foreach (var row in CdcCalibrationStatus)
                        {
                            <li class="cdc-status-item">
                                <span class="cdc-status-ic cdc-status-ic--@(row.Done ? "ok" : "idle")"><i class="bi @(row.Done ? "bi-check-circle-fill" : "bi-circle")"></i></span>
                                <span class="cdc-status-lbl">@row.Label</span>
                                <span class="cdc-status-val">@row.Detail</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="cdc-row cdc-row--3">
                <div class="cdc-panel">
                    <div class="cdc-panel-head"><h5>Recent Activity</h5></div>
                    @if (CdcRecentActivity.Count > 0)
                    {
                        <ul class="cdc-activity">
                            @foreach (var a in CdcRecentActivity)
                            {
                                <li class="cdc-activity-item">
                                    <span class="cdc-activity-ic cdc-activity-ic--@a.Tone"><i class="bi bi-file-earmark-text"></i></span>
                                    <div class="cdc-activity-body">
                                        <span class="cdc-activity-title">@a.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(a.Detail))
                                        {
                                            <span class="cdc-activity-detail">@a.Detail</span>
                                        }
                                    </div>
                                    <span class="cdc-activity-time">@a.When.ToString("h:mm tt")</span>
                                    <span class="cdc-chip cdc-chip--@a.Tone">@a.Status</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="dfi-empty">No calibration activity recorded yet.</p>
                    }
                </div>

                <div class="cdc-panel">
                    <div class="cdc-panel-head"><h5>Support Index Trend</h5></div>
                    @if (CdcTrendSnapshots.Count > 0 && CdcOutcomes.Count > 0)
                    {
                        <div class="cdc-trend">
                            <div class="cdc-trend-legend">
                                @foreach (var o in CdcOutcomes)
                                {
                                    <span class="cdc-trend-key cdc-trend-key--c@(o.Index)"><i class="bi bi-circle-fill"></i> @o.Code · @o.Title</span>
                                }
                            </div>
                            <div class="cdc-trend-plot">
                                @foreach (var o in CdcOutcomes)
                                {
                                    <div class="cdc-trend-line cdc-trend-line--c@(o.Index)">
                                        <span class="cdc-trend-endval">@o.SupportPct%</span>
                                    </div>
                                }
                                <div class="cdc-trend-axis">
                                    @foreach (var s in CdcTrendSnapshots)
                                    {
                                        <span>V@s.SnapshotNumber</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="dfi-empty">Not enough snapshots to render a support-index trend.</p>
                    }
                </div>

                <div class="cdc-panel">
                    <div class="cdc-panel-head"><h5>Changed by This Calibration</h5></div>
                    <ul class="cdc-change-list">
                        @foreach (var c in CdcChangedSummary)
                        {
                            <li class="cdc-change-item">
                                <span class="cdc-change-lbl">@c.Label</span>
                                <span class="cdc-change-val cdc-change-val--@c.Tone">@c.Value</span>
                                @if (!string.IsNullOrWhiteSpace(c.Chips))
                                {
                                    <span class="cdc-change-chips">@c.Chips</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="cdc-row cdc-row--drivers">
                <div class="cdc-panel cdc-panel--wide">
                    <div class="cdc-panel-head"><h5>Key Drivers of Change</h5></div>
                    @if (CdcKeyDrivers.Count > 0)
                    {
                        <table class="cdc-table">
                            <thead><tr><th>Proposition / Factor</th><th>Change</th><th>Impact</th><th>Reason</th><th>Linked Candidates</th></tr></thead>
                            <tbody>
                                @foreach (var d in CdcKeyDrivers)
                                {
                                    <tr>
                                        <td>@d.Factor</td>
                                        <td><i class="bi @(d.ChangeDir == "up" ? "bi-arrow-up text-success" : d.ChangeDir == "down" ? "bi-arrow-down text-danger" : "bi-dash")"></i></td>
                                        <td><span class="cdc-pill cdc-pill--@d.ImpactTone">@d.Impact</span></td>
                                        <td>@d.Reason</td>
                                        <td>@d.LinkedCandidates</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="dfi-empty">No change drivers recorded for this calibration.</p>
                    }
                </div>

                <div class="cdc-panel cdc-panel--wide">
                    <div class="cdc-panel-head"><h5>Information Value (Top 5)</h5></div>
                    @if (CdcInfoValues.Count > 0)
                    {
                        <table class="cdc-table">
                            <thead><tr><th>Proposition</th><th>IV Score</th><th>Status</th><th>Next Action</th></tr></thead>
                            <tbody>
                                @foreach (var v in CdcInfoValues)
                                {
                                    <tr>
                                        <td>@v.Proposition</td>
                                        <td>
                                            <div class="cdc-iv"><span class="cdc-iv-num">@v.Score.ToString("0.000")</span><span class="cdc-iv-bar"><span style="width:@((int)Math.Round((double)(v.Score / CdcMaxInfoValue) * 100))%"></span></span></div>
                                        </td>
                                        <td><span class="cdc-chip cdc-chip--@v.StatusTone">@v.Status</span></td>
                                        <td><span class="cdc-nextaction">@v.NextAction</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="dfi-empty">No information-value targets were produced for this execution.</p>
                    }
                </div>

                <div class="cdc-panel cdc-panel--wide">
                    <div class="cdc-panel-head">
                        <h5>Proposition Information Value (Top 5)</h5>
                        <span class="cdc-panel-sub">Advisory · atomic fact propositions on the POLOXI VIV scale</span>
                    </div>
                    @if (PropositionInfoValues.Count > 0)
                    {
                        <table class="cdc-table">
                            <thead><tr><th>Proposition</th><th>IV Score</th><th>Fact State</th><th>Verification</th><th>Redundancy</th><th>Integrity</th></tr></thead>
                            <tbody>
                                @foreach (var p in PropositionInfoValues)
                                {
                                    <tr>
                                        <td>@p.PropositionText @if (p.IsEssential){<span class="cdc-chip cdc-chip--warn">Essential</span>}</td>
                                        <td>
                                            <div class="cdc-iv"><span class="cdc-iv-num">@p.InformationValue.ToString("0.000")</span><span class="cdc-iv-bar"><span style="width:@((int)Math.Round((double)(p.InformationValue / PropositionInfoValueMax) * 100))%"></span></span></div>
                                        </td>
                                        <td>@p.FactStateCode</td>
                                        <td><span class="cdc-chip cdc-chip--@PropositionStateTone(p.VerificationStateCode)">@p.VerificationStateCode</span></td>
                                        <td>@if (p.RedundancyPenalty > 0m){<span class="cdc-chip cdc-chip--warn" title="Supporting evidence collapses onto few distinct source documents (correlated, not independent corroboration).">@p.RedundancyPenalty.ToString("P0")</span>}else{<span class="cdc-muted">—</span>}</td>
                                        <td>
                                            @if (p.IntegrityDisposition is not null)
                                            {
                                                <span class="cdc-chip cdc-chip--@PropositionIntegrityTone(p.IntegrityDisposition)" title="@PropositionIntegrityTitle(p)">@PropositionIntegrityLabel(p.IntegrityDisposition)</span>
                                            }
                                            else
                                            {
                                                <span class="cdc-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (_propositionInfoValueLoading)
                    {
                        <p class="dfi-empty">Scoring propositions…</p>
                    }
                    else
                    {
                        <p class="dfi-empty">No proposition-level information value is available for this matter yet.</p>
                    }
                </div>

                <div class="cdc-panel cdc-panel--coverage">
                    <div class="cdc-panel-head"><h5>Evidence Coverage</h5><span class="cdc-coverage-pct">@CdcEvidenceCoveragePct.ToString("P0")</span></div>
                    @if (CdcCoverageBreakdown.Count > 0)
                    {
                        <div class="cdc-coverage-seg">
                            @foreach (var seg in CdcCoverageBreakdown)
                            {
                                @if (seg.Pct > 0m)
                                {
                                    <span class="cdc-coverage-seg-part cdc-coverage-seg-part--@seg.Tone" style="width:@((int)Math.Round((double)seg.Pct * 100))%" title="@seg.Label @seg.Count"></span>
                                }
                            }
                        </div>
                        <ul class="cdc-coverage-stats">
                            @foreach (var seg in CdcCoverageBreakdown)
                            {
                                <li><span class="cdc-dot cdc-dot--@seg.Tone"></span> @seg.Label <strong>@seg.Pct.ToString("P0") (@seg.Count)</strong></li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="cdc-coverage-bar"><span style="width:@((int)Math.Round((double)CdcEvidenceCoveragePct * 100))%"></span></div>
                    }
                    <ul class="cdc-coverage-stats">
                        <li><span class="cdc-dot cdc-dot--ok"></span> Total evidence items <strong>@CdcTotalEvidence</strong></li>
                        <li><span class="cdc-dot cdc-dot--info"></span> Unique sources <strong>@CdcUniqueSources</strong></li>
                    </ul>
                    <button type="button" class="cdc-btn cdc-btn--ghost cdc-btn--block" @onclick='() => _dfiTab = "Evidence"'>View Evidence Matrix →</button>
                </div>
            </div>

            <div class="cdc-row cdc-row--bottom">
                <div class="cdc-panel cdc-panel--wide">
                    <div class="cdc-panel-head"><h5>Decision Snapshots</h5></div>
                    @if (CdcSnapshots.Count > 0)
                    {
                        <table class="cdc-table">
                            <thead><tr><th>Version</th><th>Date / Time</th><th>Proposition</th><th>Readiness</th><th>Reliance</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var s in CdcSnapshots)
                                {
                                    <tr class="@(s.DecisionSnapshotId == _cdcSelectedSnapshotId ? "cdc-row-active" : "")">
                                        <td><strong>V@s.SnapshotNumber</strong></td>
                                        <td>@s.EvaluatedDateUtc.ToString("MMM dd, yyyy h:mm tt")</td>
                                        <td>@(s.PropositionStatement ?? s.Title ?? "—")</td>
                                        <td>@s.ReadinessStatusCode</td>
                                        <td>@s.RelianceStatusCode</td>
                                        <td><span class="cdc-chip cdc-chip--@(s.IsAttorneyApproved ? "ok" : "warn")">@(s.IsAttorneyApproved ? "Attorney Reviewed" : "Review Required")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="dfi-empty">No decision snapshots have been created for this matter yet.</p>
                    }
                </div>

                <div class="cdc-panel cdc-panel--review">
                    <div class="cdc-panel-head">
                        <h5><i class="bi bi-shield-exclamation"></i> Pending Attorney Review</h5>
                        @if (CdcPendingReview.Count > 0)
                        {
                            <span class="cdc-badge cdc-badge--warn">Attention required</span>
                        }
                    </div>
                    <p class="cdc-review-sub">Calibration changes that require attorney review before the decision can be relied upon.</p>
                    @if (CdcPendingReview.Count > 0)
                    {
                        <ul class="cdc-review-list">
                            @foreach (var t in CdcPendingReview)
                            {
                                <li class="cdc-review-item">
                                    <span class="cdc-review-check"><i class="bi bi-square"></i></span>
                                    <span class="cdc-review-title">@t.Title</span>
                                    <span class="cdc-chip cdc-chip--@(t.PriorityCode == "HIGH" ? "danger" : t.PriorityCode == "MEDIUM" ? "warn" : "info")">@(t.PriorityCode == "HIGH" ? "Required" : t.PriorityCode == "LOW" ? "Recommended" : "Required")</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="dfi-empty">No pending attorney-review items.</p>
                    }
                    <button type="button" class="cdc-btn cdc-btn--primary cdc-btn--block" @onclick='() => _dfiTab = "Readiness"'>Open Review Workspace →</button>
                </div>
            </div>
        </div>
    };

    private void OnCdcSnapshotChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            _cdcSelectedSnapshotId = id;
        }
    }

    private RenderFragment DecisionInspectorPanel => __builder =>
    {
        @if (_response?.DecisionInspector is { } inspector)
        {
            <section class="poloxi-panel poloxi-reveal poloxi-inspector-panel">
                <div class="poloxi-panel-header">
                    <div class="poloxi-panel-title">
                        <span class="poloxi-panel-icon"><i class="bi bi-clipboard-data"></i></span>
                        <div><span>Legal decision processing inspector</span><h2>Actual execution — every processing stage</h2></div>
                    </div>
                    <span class="poloxi-status" title="Diagnostic only. Every value is captured from the real run; MISSING / NOT_REACHED is explicit.">DIAGNOSTIC</span>
                </div>

                <div class="poloxi-inspector-mode">
                    <span><strong>Execution route:</strong> @inspector.ExecutionMode.ExecutionRoute</span>
                    <span><strong>Answer kind:</strong> @(inspector.ExecutionMode.AnswerKind ?? "MISSING")</span>
                    <span><strong>Legal EVALUATE run:</strong> @inspector.ExecutionMode.IsLegalDecisionEvaluationRun</span>
                    <span><strong>Gate mode:</strong> @inspector.ExecutionMode.GateMode</span>
                    <span><strong>Normalization mode:</strong> @(inspector.ExecutionMode.NormalizationMode ?? "NOT_REACHED")</span>
                    <span><strong>Prompt key:</strong> @(inspector.ExecutionMode.PromptKey ?? "MISSING")</span>
                    <span><strong>Prompt version:</strong> @(inspector.ExecutionMode.PromptVersion ?? "MISSING")</span>
                    <span><strong>Prompt hash:</strong> @(inspector.ExecutionMode.PromptHash ?? "MISSING")</span>
                </div>

                <div class="poloxi-inspector-stages">
                    @foreach (var stage in inspector.Stages)
                    {
                        <details class="poloxi-inspector-stage">
                            <summary>
                                <span class="poloxi-inspector-stage-name">@stage.StageName</span>
                                <span class="poloxi-inspector-badge poloxi-inspector-badge--@stage.Status.ToLowerInvariant()">@stage.Status</span>
                            </summary>
                            <div class="poloxi-inspector-stage-body">
                                @if (!string.IsNullOrWhiteSpace(stage.InputSource))
                                {
                                    <div><strong>Input source:</strong> @stage.InputSource</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(stage.ActualInput))
                                {
                                    <div><strong>Actual input:</strong> @stage.ActualInput</div>
                                }
                                @if (stage.RequiredFactors.Count > 0)
                                {
                                    <div><strong>Required factors:</strong> @string.Join(" · ", stage.RequiredFactors)</div>
                                }
                                @if (stage.AvailableFactors.Count > 0)
                                {
                                    <div><strong>Available factors:</strong> @string.Join(" · ", stage.AvailableFactors)</div>
                                }
                                @if (stage.MissingFactors.Count > 0)
                                {
                                    <div class="poloxi-inspector-missing"><strong>Missing factors:</strong> @string.Join(" · ", stage.MissingFactors)</div>
                                }
                                @if (stage.ValidationErrors.Count > 0)
                                {
                                    <div class="poloxi-inspector-missing"><strong>Validation errors:</strong> @string.Join(" · ", stage.ValidationErrors)</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(stage.ProcessingPerformed))
                                {
                                    <div><strong>Processing performed:</strong> @stage.ProcessingPerformed</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(stage.ActualOutput))
                                {
                                    <div><strong>Actual output:</strong> <pre class="poloxi-inspector-output">@stage.ActualOutput</pre></div>
                                }
                                @if (stage.DurationMilliseconds is { } ms)
                                {
                                    <div><strong>Duration:</strong> @ms ms</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(stage.BlockingReason))
                                {
                                    <div class="poloxi-inspector-blocked"><strong>Blocking / failure reason:</strong> @stage.BlockingReason</div>
                                }
                            </div>
                        </details>
                    }
                </div>

                @if (inspector.NormalizedCandidates.Count > 0)
                {
                    <div class="poloxi-inspector-subsection">
                        <h3>Normalized global candidate pool</h3>
                        <div class="poloxi-table-scroll">
                            <table class="poloxi-inspector-table">
                                <thead>
                                    <tr>
                                        <th>Normalized ID</th><th>Original title</th><th>Semantic role</th>
                                        <th>Identity decision</th><th>Material distinction</th><th>Origins</th>
                                        <th>Eligible</th><th>Reached scoring</th><th>Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in inspector.NormalizedCandidates)
                                    {
                                        <tr>
                                            <td>@c.NormalizedCandidateId</td>
                                            <td>@c.OriginalTitle</td>
                                            <td>@c.SemanticRole</td>
                                            <td>@c.IdentityDecision</td>
                                            <td>@c.MaterialDistinction</td>
                                            <td>@(c.OriginMappings.Count > 0 ? string.Join(", ", c.OriginMappings) : "—")</td>
                                            <td>@(c.CompetitionEligible ? "yes" : "no")</td>
                                            <td>@(c.ReachedScoring ? "yes" : "no")</td>
                                            <td>@c.DecisionReason</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (inspector.SharedDependencies.Count > 0)
                {
                    <div class="poloxi-inspector-subsection">
                        <h3>Shared dependencies <small>(shown once, linked to related candidates)</small></h3>
                        <div class="poloxi-table-scroll">
                            <table class="poloxi-inspector-table">
                                <thead>
                                    <tr>
                                        <th>Dependency ID</th><th>Type</th><th>Proposition</th>
                                        <th>Related candidates</th><th>Relation</th><th>Verification</th><th>Unresolved</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in inspector.SharedDependencies)
                                    {
                                        <tr>
                                            <td>@d.DependencyId</td>
                                            <td>@d.DependencyType</td>
                                            <td>@d.Proposition</td>
                                            <td>@(d.RelatedCandidateIds.Count > 0 ? string.Join(", ", d.RelatedCandidateIds) : "—")</td>
                                            <td>@d.RelationType</td>
                                            <td>@d.VerificationState</td>
                                            <td>@(string.IsNullOrWhiteSpace(d.UnresolvedInformation) ? "—" : d.UnresolvedInformation)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                @if (inspector.RejectedObjects.Count > 0)
                {
                    <div class="poloxi-inspector-subsection">
                        <h3>Rejected objects <small>(preserved for provenance)</small></h3>
                        <ul class="poloxi-inspector-rejected">
                            @foreach (var r in inspector.RejectedObjects)
                            {
                                <li><strong>@r.ObjectKind</strong> — @r.Identifier: @r.Reason</li>
                            }
                        </ul>
                    </div>

                    @if (inspector.FactorInventory is { } inventory)
                    {
                        <div class="poloxi-inspector-subsection poloxi-factor-inventory">
                            <h3>Factor inventory <small>(universal · @inventory.CandidateCount candidates · @inventory.Factors.Count factors · @inventory.SharedFactorCount shared · @inventory.MissingFactorCount missing)</small></h3>
                            <div class="poloxi-factor-sources">
                                <span class="poloxi-factor-chip poloxi-factor-chip--@(inventory.SourceStatus.MatterDataLoaded ? "on" : "off")">Matter data: @(inventory.SourceStatus.MatterDataLoaded ? $"{inventory.SourceStatus.MatterFieldCount} fields" : "none")</span>
                                <span class="poloxi-factor-chip poloxi-factor-chip--@(inventory.SourceStatus.DomainPackResolved ? "on" : "off")">Domain pack: @(inventory.SourceStatus.DomainPackResolved ? (inventory.SourceStatus.DomainPackCode ?? "resolved") : "not resolved")</span>
                                <span class="poloxi-factor-chip poloxi-factor-chip--@(inventory.SourceStatus.DocumentCorpusStatus == "AVAILABLE" ? "on" : "off")">Documents: @inventory.SourceStatus.DocumentCorpusStatus</span>
                                <span class="poloxi-factor-chip poloxi-factor-chip--@(inventory.SourceStatus.EvidenceStatus == "ADMITTED" ? "on" : "off")">Evidence: @inventory.SourceStatus.EvidenceStatus</span>
                            </div>

                            <h4>Global factors <small>(one identity, reused across candidates)</small></h4>
                            <label class="poloxi-factor-filter">
                                <input type="checkbox" @bind="_atomicFactorsOnly" />
                                Atomic factors only <small>(hide broad parent groupings)</small>
                            </label>
                            <table class="poloxi-inspector-table">
                                <thead>
                                    <tr><th>Factor</th><th>Source</th><th>Actual value</th><th>Availability</th><th>Verification</th><th>Requirement</th><th>Relationship</th><th>Missing information</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in inventory.Factors.Where(f => !_atomicFactorsOnly || !string.Equals(f.NodeKind, "PARENT", StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <tr>
                                            <td><strong>@f.FactorName</strong> <span class="poloxi-factor-badge poloxi-factor-badge--@f.NodeKind.ToLowerInvariant()">@f.NodeKind</span><br /><small>@f.FactorId · @f.FactorType</small></td>
                                            <td>@f.Source</td>
                                            <td>@(string.IsNullOrWhiteSpace(f.ActualValue) ? "—" : f.ActualValue)@if (f.Contradictions.Count > 0)
                                                {
                                                    <br /><span class="poloxi-factor-badge poloxi-factor-badge--contradicted" title="@string.Join(" vs ", f.Contradictions)"><i class="bi bi-exclamation-diamond-fill"></i> CONFLICTING SOURCES</span>
                                                }</td>
                                            <td><span class="poloxi-factor-badge poloxi-factor-badge--@f.Availability.ToLowerInvariant()">@f.Availability</span></td>
                                            <td><span class="poloxi-factor-badge poloxi-factor-badge--@f.VerificationStatus.ToLowerInvariant()">@f.VerificationStatus</span></td>
                                            <td>@f.Requirement</td>
                                            <td>@(f.Relationships.Count == 0 ? "—" : string.Join(" · ", f.Relationships))</td>
                                            <td>@(string.IsNullOrWhiteSpace(f.MissingInformation) ? "—" : f.MissingInformation)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <h4>Candidate × factor relationships</h4>
                            @foreach (var grp in inventory.Relationships.GroupBy(r => r.CandidateTitle).OrderBy(g => g.Key))
                            {
                                <details class="poloxi-inspector-stage">
                                    <summary><span class="poloxi-inspector-stage-name">@grp.Key</span> <span class="poloxi-inspector-badge">@grp.Count() factors</span></summary>
                                    <table class="poloxi-inspector-table">
                                        <thead><tr><th>Factor</th><th>Relationship</th><th>Required</th><th>Validated</th><th>Rationale</th></tr></thead>
                                        <tbody>
                                            @foreach (var rel in grp)
                                            {
                                                <tr>
                                                    <td>@rel.FactorName</td>
                                                    <td>@rel.RelationType</td>
                                                    <td>@(rel.IsRequired ? "Yes" : "No")</td>
                                                    <td><span class="poloxi-factor-badge poloxi-factor-badge--@(rel.IsValidatedRelation ? "available" : "missing")" title="@(rel.IsValidatedRelation ? "Validated by a semantic legal/logical rationale" : "Lexical/structural link only — not a validated dependency")">@(rel.IsValidatedRelation ? "Validated" : "Unvalidated")</span></td>
                                                    <td>@(string.IsNullOrWhiteSpace(rel.Rationale) ? "—" : rel.Rationale)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </details>
                            }
                        </div>
                    }
                }
            </section>
        }
    };

    private RenderFragment ComparisonPanel => __builder =>
    {
        @if (ShouldShowComparisonPanel)
        {
            <section class="poloxi-panel poloxi-reveal">
                <div class="poloxi-panel-header">
                    <div class="poloxi-panel-title"><span class="poloxi-panel-icon"><i class="bi bi-columns-gap"></i></span><div><span>Ranking comparison</span><h2>POLOXI vs. raw model vs. unweighted baseline</h2></div></div>
                    <span class="poloxi-status">diagnostic</span>
                </div>
                 <p><strong>LLM Raw</strong> is the model's single-shot answer. <strong>Mention-frequency baseline</strong> ranks POLOXI-discovered candidates by mentions and unweighted average scores. Missing cells mean that diagnostic input was unavailable, not that the POLOXI result failed.</p>
                <div class="poloxi-table-scroll">
                <table class="poloxi-compare-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>With POLOXI <small>(Candidate × Branch)</small></th>
                            <th>LLM Raw <small>(single-shot)</small></th>
                            <th>Mention-frequency baseline <small>(unweighted)</small></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var compareRowCount = Math.Max(1, Math.Max(Math.Max(FinalRankedCandidates.Count, BaselineRankedCandidates.Count), LlmRawItems.Count)); }
                        @for (var i = 0; i < compareRowCount; i++)
                        {
                            var poloxi = i < FinalRankedCandidates.Count ? FinalRankedCandidates[i] : null;
                            var raw = i < LlmRawItems.Count ? LlmRawItems[i] : null;
                            var baseline = i < BaselineRankedCandidates.Count ? BaselineRankedCandidates[i] : null;
                            var moved = raw is not null && poloxi is not null && FindPoloxiRank(raw.Name) != i + 1;
                            <tr class="@(moved ? "poloxi-compare-diff" : null)">
                                <td>@(i + 1)</td>
                                <td>
                                    @if (poloxi is not null)
                                    {
                                        <strong>@poloxi.DisplayName</strong> <span>@poloxi.CompositeScore.ToString("P0") quality score</span>
                                    }
                                    else
                                    {
                                        <em title="@PoloxiUnavailableReason">POLOXI unavailable — @PoloxiUnavailableReason</em>
                                    }
                                </td>
                                <td class="poloxi-compare-raw">
                                    @if (raw is not null)
                                    {
                                        var poloxiPosition = FindPoloxiRank(raw.Name);
                                            @raw.Name
                                            @if (raw.Score is decimal rawScore)
                                            {
                                                <span>@rawScore.ToString("P0") raw score</span>
                                            }
                                        @if (poloxiPosition is int position && position != i + 1)
                                        {
                                            <span>POLOXI #@position</span>
                                        }
                                        else if (poloxiPosition is null)
                                        {
                                            <span>not in POLOXI ranking</span>
                                        }
                                    }
                                    else
                                    {
                                        <em>Raw LLM comparison unavailable</em>
                                    }
                                </td>
                                <td>
                                    @if (baseline is not null)
                                    {
                                        @baseline.DisplayName <span class="poloxi-mention-detail" title="@MentionBreakdown(baseline)">@baseline.InterpretiveSupportCount mention@(baseline.InterpretiveSupportCount == 1 ? "" : "s")@(baseline.BranchScores.Count > 0 ? $" · avg {baseline.BranchScores.Average(s => s.EvidenceScore):P0}" : "") <i class="bi bi-info-circle" aria-hidden="true"></i></span>
                                    }
                                    else
                                    {
                                        <em title="@BaselineUnavailableReason">Baseline unavailable — @BaselineUnavailableReason</em>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </section>
        }
    };

    // Shared KPI strip: rendered below the Full answer section in Answer view, or standalone in Analysis view.
    private RenderFragment KpiStrip => __builder =>
    {
        <section class="poloxi-kpis poloxi-kpis--compact">
            <article><i class="bi bi-activity poloxi-kpi-icon"></i><span>Status</span><strong>@_response!.StatusCode</strong><small>@_response.TerminationReasonCode</small></article>
            <article title="End-to-end execution time of this POLOXI run, measured by the platform from request start to final answer."><i class="bi bi-stopwatch poloxi-kpi-icon"></i><span>Execution time</span><strong>@TimeSpan.FromMilliseconds(_response.DurationMilliseconds).TotalSeconds.ToString("0.0")s</strong><small>@_response.DurationMilliseconds.ToString("N0") ms</small></article>
            @if (!string.IsNullOrWhiteSpace(_response.AnswerKindCode))
            {
                <article title="V3.2 answer-kind-aware workflow routing: the Stage 0 classification of what the answer items ARE. TUNED means kind-specific depth/round budgets shortened this execution; FULL PIPELINE means the complete budgets applied."><i class="bi bi-signpost-2 poloxi-kpi-icon"></i><span>Answer kind</span><strong>@_response.AnswerKindCode.Replace('_', ' ')</strong><small>@(_response.AnswerKindRoutingApplied ? "tuned budgets" : "full pipeline")</small></article>
            }
            @if (!string.IsNullOrWhiteSpace(_response.ModelCodeUsed))
            {
                <article title="The AI model that composed the final answer, resolved by the platform router — your explicit selection when one was chosen, otherwise the Auto route."><i class="bi bi-cpu poloxi-kpi-icon"></i><span>Model used</span><strong>@_response.ModelCodeUsed</strong><small>@(string.IsNullOrWhiteSpace(_selectedModelCode) ? "auto-routed" : "user-selected")@(string.IsNullOrWhiteSpace(_response.ProviderCodeUsed) ? "" : $" · {_response.ProviderCodeUsed}")</small></article>
            }
            <article><i class="bi bi-diagram-3 poloxi-kpi-icon"></i><span>Depth reached</span><strong>@_response.DepthReached</strong><small>@_response.LlmCallCount LLM calls</small></article>
            <article><i class="bi bi-signpost-split poloxi-kpi-icon"></i><span>Surviving paths</span><strong>@SurvivingBranches.Count</strong><small>@EliminatedBranches.Count pruned</small></article>
            <article><i class="bi bi-database-check poloxi-kpi-icon"></i><span>Evidence</span><strong>@(_response.EnterpriseEvidenceCount + _response.ExternalEvidenceCount)</strong><small>@_response.ExternalEvidenceCount external &middot; @_response.EnterpriseEvidenceCount enterprise</small></article>
            <article title="Hierarchy coverage: share of ALL surviving branches supported by any evidence. Deep leaf branches without evidence lower this without necessarily weakening the answer."><i class="bi bi-bounding-box-circles poloxi-kpi-icon"></i><span>Evidence coverage</span><strong>@_response.EvidenceCoverage.ToString("P0")</strong><small>hierarchy branches supported</small></article>
            <article title="Decision coverage: share of the dimensions that actually drive the final Candidate &times; Branch ranking that are supported by evidence &mdash; the most meaningful grounding measure for the answer itself."><i class="bi bi-crosshair poloxi-kpi-icon"></i><span>Decision coverage</span><strong>@_response.DecisionEvidenceCoverage.ToString("P0")</strong><small>deciding dimensions supported</small></article>
            <article title="@(IsEvidenceWeightedConfidence ? "Decision evidence confidence: winner quality, winner-vs-runner-up separation, evidence confidence behind the winner, ranking stability, and decision-dimension coverage. This is separate from ranking certainty." : "Interpretation confidence: no Candidate × Branch competition ran for this execution, so this value reflects POLOXI's interpretation-prior confidence and is NOT weighted by retrieved evidence. Check evidence coverage separately.")"><i class="bi bi-shield-check poloxi-kpi-icon"></i><span>@ConfidenceLabel</span><strong>@_response.FinalConfidence.ToString("P0")</strong><small>@ConfidenceCaption</small></article>
            <article title="Challenge-the-Winner (watch mode): when the leader-vs-runner-up margin is thin, one adversarial LLM assessment argues against the leader and records its verdict for audit. Diagnostic only — it never changes the winner, ranking, or answer."><i class="bi bi-lightning-charge poloxi-kpi-icon"></i><span>Winner challenge</span><strong>@(_response.ChallengeOutcome is null ? "NOT FIRED" : _response.ChallengeOutcome.VerdictCode.Replace('_', ' '))</strong><small>@(_response.ChallengeOutcome is null ? "margin above threshold or disabled" : $"{_response.ChallengeOutcome.ChallengedCandidate} vs {_response.ChallengeOutcome.ChallengerCandidate} · margin {_response.ChallengeOutcome.Margin:P0}")</small></article>
            @if (_response.WinnerStability is { } winnerStability)
            {
                <article title="Deterministic ranking stability across information rounds. Winner: share of consecutive measurements where the #1 candidate did not change. Top-3: average overlap of the top-3 set between consecutive measurements. High stability means additional evidence is not changing the answer &mdash; a convergence signal."><i class="bi bi-graph-up-arrow poloxi-kpi-icon"></i><span>Ranking stability</span><strong>@winnerStability.ToString("P0")</strong><small>winner &middot; top-3 @(_response.TopKStability?.ToString("P0") ?? "—")</small></article>
            }
            @if (_response.InformationRounds.Count > 0)
            {
                <article title="Deterministic Shannon entropy &mdash; 0% = fully resolved, 100% = maximal uncertainty. Measured by POLOXI math, never the LLM. Basis: BRANCH = competing ALTERNATIVE interpretations; CANDIDATE = deterministic candidate-signal distribution (which candidate wins)."><i class="bi bi-thermometer-half poloxi-kpi-icon"></i><span>Uncertainty</span><strong>@_response.InitialNormalizedEntropy.ToString("P0") &rarr; @_response.FinalNormalizedEntropy.ToString("P0")</strong><small>@_response.TotalActualInformationGain.ToString("0.###") bits gained &middot; @(_response.EntropyBasisCode ?? "BRANCH") basis@(string.Equals(_response.EntropyBasisCode, "CANDIDATE", StringComparison.OrdinalIgnoreCase) ? $" &middot; candidate uncertainty {CandidateUncertaintyDisplay}" : "")</small></article>
            }
        </section>
        <section class="poloxi-decision-summary poloxi-reveal">
            <h3><i class="bi bi-diagram-2"></i> Detailed summary — how POLOXI shaped this decision</h3>
            <ol class="poloxi-decision-steps">
                <li>
                    <span class="poloxi-step-badge">1</span>
                    <div>
                        <strong>Query contract &amp; answer kind</strong>
                        <p>
                            POLOXI classified this task as <em>@(_response.AnswerKindCode?.Replace('_', ' ') ?? "unclassified")</em>@(_response.AnswerKindRoutingApplied ? " and tuned its depth/round budgets to that kind" : " and ran the full pipeline budgets").
                            @if (_response.QueryContract is { } summaryContract)
                            {
                                <text> It locked @summaryContract.HardConstraints.Count hard constraint@(summaryContract.HardConstraints.Count == 1 ? "" : "s")@(summaryContract.HardConstraints.Count > 0 ? $" ({string.Join(", ", summaryContract.HardConstraints)})" : "") as fixed and isolated @summaryContract.AmbiguousConcepts.Count ambiguous concept@(summaryContract.AmbiguousConcepts.Count == 1 ? "" : "s")@(summaryContract.AmbiguousConcepts.Count > 0 ? $" ({string.Join(", ", summaryContract.AmbiguousConcepts)})" : "") as the only part it was allowed to disambiguate.</text>
                            }
                        </p>
                    </div>
                </li>
                <li>
                    <span class="poloxi-step-badge">2</span>
                    <div>
                        <strong>Interpretation hierarchy</strong>
                        @SurvivingBranches.Count path@(SurvivingBranches.Count == 1 ? "" : "s") @SurvivalVerb while @EliminatedBranches.Count @(EliminatedBranches.Count == 1 ? "was" : "were") ruled out
                    </div>
                </li>
                <li>
                    <span class="poloxi-step-badge">3</span>
                    <div>
                        <strong>Evidence grounding</strong>
                        <p>@(_response.EnterpriseEvidenceCount + _response.ExternalEvidenceCount) evidence signals were retrieved (@_response.ExternalEvidenceCount external &middot; @_response.EnterpriseEvidenceCount enterprise), supporting @_response.EvidenceCoverage.ToString("P0") of surviving hierarchy branches and @_response.DecisionEvidenceCoverage.ToString("P0") of the dimensions that actually decided the final ranking. Branches without evidence lost influence — they could not vote on the outcome.</p>
                    </div>
                </li>
                @if (_response.InformationRounds.Count > 0)
                {
                    <li>
                        <span class="poloxi-step-badge">4</span>
                        <div>
                            <strong>Information-directed exploration</strong>
                            <p>@_response.InformationRounds.Count measurement round@(_response.InformationRounds.Count == 1 ? "" : "s") targeted the highest-uncertainty dimensions, reducing measured uncertainty from @_response.InitialNormalizedEntropy.ToString("P0") to @_response.FinalNormalizedEntropy.ToString("P0") (@_response.TotalActualInformationGain.ToString("0.###") bits gained on the @(_response.EntropyBasisCode ?? "BRANCH") basis). Each round's gain was measured deterministically by POLOXI math — never self-reported by the LLM.</p>
                        </div>
                    </li>
                }
                <li>
                    <span class="poloxi-step-badge">@(_response.InformationRounds.Count > 0 ? 5 : 4)</span>
                    <div>
                        <strong>Candidate &times; Branch competition — actual result</strong>
                        @if (FinalRankedCandidates.Count > 0)
                        {
                            <p>Every candidate was scored against every surviving interpretation path; the composite of those interpretation-weighted quality scores produced the authoritative ordering:</p>
                            <ol class="poloxi-summary-ranking">
                                @foreach (var candidate in FinalRankedCandidates.Take(5))
                                {
                                    <li><strong>@candidate.DisplayName</strong> <span>@candidate.CompositeScore.ToString("P0")</span></li>
                                }
                            </ol>
                        }
                        else
                        {
                            <p>No candidate competition applied to this execution — the answer was composed directly from the surviving grounded interpretation paths.</p>
                        }
                    </div>
                </li>
                <li>
                    <span class="poloxi-step-badge">@(_response.InformationRounds.Count > 0 ? 6 : 5)</span>
                    <div>
                        <strong>Decision quality</strong>
                        @{
                            var stabilityExplanation = _response.WinnerStability switch
                            {
                                null => "Ranking stability was not measured for this execution.",
                                <= .05m => "The hierarchy settled, but the candidate ranking did not stabilize; the current winner remains highly sensitive to additional evidence or weighting changes.",
                                < .60m => "The candidate ranking has limited stability, so treat the winner as the current quality-weighted leader rather than a fully settled recommendation.",
                                _ => "High ranking stability means additional evidence had largely stopped changing the answer — the convergence signal POLOXI expects before treating a ranking as settled."
                            };
                        }
                        <p>The final decision carries @_response.FinalConfidence.ToString("P0") @(IsEvidenceWeightedConfidence ? "decision evidence confidence" : "interpretation confidence (not evidence-weighted \u2014 no candidate competition ran)")@(_response.WinnerStability is { } summaryStability ? $" with {summaryStability:P0} winner stability across rounds (top-3 {(_response.TopKStability?.ToString("P0") ?? "—")})" : "") and finished as <em>@_response.StatusCode</em> (@_response.TerminationReasonCode.Replace('_', ' ')) after @_response.LlmCallCount LLM calls in @TimeSpan.FromMilliseconds(_response.DurationMilliseconds).TotalSeconds.ToString("0.#")s. @stabilityExplanation</p>
                    </div>
                </li>
                <li class="poloxi-summary-conclusion">
                    <span class="poloxi-step-badge poloxi-step-badge--conclusion"><i class="bi bi-award"></i></span>
                    <div>
                        <strong>Conclusion — POLOXI vs. the raw LLM answer</strong>
                        <p>
                            @if (LlmRawItems.Count > 0 && FinalRankedCandidates.Count > 0)
                            {
                                var rawTop = LlmRawItems[0].Name;
                                var rawTopPoloxiRank = FindPoloxiRank(rawTop);
                                var rawExcluded = LlmRawItems.Count(item => FindPoloxiRank(item.Name) is null);
                                var rawMoved = LlmRawItems.Select((item, index) => (item, index)).Count(x => FindPoloxiRank(x.item.Name) is int rank && rank != x.index + 1);
                                <text>The raw single-shot answer from the same model (the LLM Raw column) put “@rawTop” first@(rawTopPoloxiRank switch { 1 => " — and POLOXI's evidence competition agreed", int rank => $" — but POLOXI's evidence competition demoted it to #{rank}", null => " — a candidate POLOXI's evidence competition excluded from the final ranking entirely" }). Of the model's @LlmRawItems.Count raw picks, @rawMoved landed at a different position and @rawExcluded did not survive evidence review at all. </text>
                            }
                            else if (LlmRawItems.Count > 0)
                            {
                                <text>The raw single-shot answer from the same model (the LLM Raw column) put “@LlmRawItems[0].Name” first, but no candidate competition ran for this execution, so POLOXI's answer was composed directly from the surviving grounded interpretation paths rather than an evidence-scored ranking — the raw pick was neither confirmed nor refuted by a competition. </text>
                            }
                            else
                            {
                                <text>A non-POLOXI search would have asked the model once and accepted its first, unaudited answer — no competing interpretations, no evidence retrieval, no measured uncertainty, and no way to detect a confidently-worded wrong answer. </text>
                            }
                            POLOXI changed the outcome in concrete, measurable ways: it @(EliminatedBranches.Count > 0 ? $"eliminated {EliminatedBranches.Count} misreading{(EliminatedBranches.Count == 1 ? "" : "s")} of your question before they could steer the result, " : "kept every plausible reading of your question in competition instead of silently betting on one, ")forced confidence to rest on @(_response.EnterpriseEvidenceCount + _response.ExternalEvidenceCount) retrieved evidence signals instead of the model's memory@(FinalRankedCandidates.Count > 0 ? $", and locked the final ordering to the deterministic Candidate × Branch competition — so \"{FinalRankedCandidates[0].DisplayName}\" ranks #1 because interpretation-weighted quality scored it there, with evidence disclosed separately" : "").
                            @if (_response.InformationRounds.Count > 0)
                            {
                                <text>Measured uncertainty fell from @_response.InitialNormalizedEntropy.ToString("P0") to @_response.FinalNormalizedEntropy.ToString("P0") — a plain LLM answer reports no such number and offers no convergence proof. </text>
                            }
                            The result is an answer with @_response.FinalConfidence.ToString("P0") @(IsEvidenceWeightedConfidence ? "auditable decision evidence confidence" : "auditable interpretation confidence (not evidence-weighted for this execution)") and a full provenance trail, versus a single-shot response whose reliability cannot be inspected at all.
                        </p>
                    </div>
                </li>
            </ol>
            @FactorChecklistPanel
            @if (_showPipeline)
            {
                <section class="poloxi-panel poloxi-pipeline-panel">
                    <div class="poloxi-panel-header">
                        <div class="poloxi-panel-title">
                            <span class="poloxi-panel-icon"><i class="bi bi-diagram-3"></i></span>
                            <div><span>End-to-end POLOXI pipeline</span><h2>Structured decision analysis</h2></div>
                        </div>
                        <span class="poloxi-status" title="Interpretation defines quality, evidence supports confidence, constraints veto only explicit requirements.">QUALITY FIRST</span>
                    </div>
                    <ol class="poloxi-pipeline-steps">
                        <li><strong>Query contract</strong><span>Separate fixed constraints from the ambiguous concept being ranked.</span></li>
                        <li><strong>Structured hierarchy</strong><span>Organize the ambiguous concept into distinct, comprehensive parent dimensions.</span></li>
                        <li><strong>Hierarchical sub-criteria</strong><span>Expand parent dimensions into child criteria, then roll children back into the parent so nothing is double counted.</span></li>
                        <li><strong>Candidate discovery</strong><span>@(FinalRankedCandidates.Count > 0 ? "Merge interpretive candidates, harvested evidence names, and verified seed candidates; reject query echoes and pseudo-candidates." : "Candidate competition data was not produced for this execution.")</span></li>
                        <li><strong>Candidate × Branch matrix</strong><span>@(FinalRankedCandidates.Count > 0 ? "Score every candidate against every scoreable dimension and compute quality from interpretation-weighted dimensions." : "No final Candidate × Branch matrix is available for this run.")</span></li>
                        <li><strong>Evidence confidence</strong><span>Use source diversity and dimension coverage to disclose confidence/support, not to override quality.</span></li>
                        <li><strong>Constraint guardrails</strong><span>Apply veto penalties only when the query states an explicit hard requirement.</span></li>
                        <li><strong>Final ranking</strong><span>Rank by composite quality first, then use support tier as the tie-breaker.</span></li>
                    </ol>
                    <div class="poloxi-formula-grid">
                        <article><span>Branch confidence</span><strong>0.45 × Interpretation + 0.55 × Evidence</strong><small>Used for lifecycle, support, and diagnostics.</small></article>
                        <article><span>Quality weighting</span><strong>Interpretation prior</strong><small>Determines dimension importance in the candidate composite.</small></article>
                        <article><span>Roll-up</span><strong>50% parent + 50% children</strong><small>Uses structured hierarchy without double counting.</small></article>
                        <article><span>Ranking order</span><strong>Quality → Support tier</strong><small>Evidence validates confidence; quality leads the answer.</small></article>
                    </div>
                </section>
            }
            @DecisionInspectorPanel
            @if (ShouldShowComparisonPanel)
            {
                <div class="poloxi-compare">
                    <h4><i class="bi bi-columns-gap"></i> Ranking comparison — POLOXI vs. raw model vs. unweighted baseline</h4>
                    <p><strong>LLM Raw</strong> is the actual answer the selected model returned for your plain question in a single shot — the same result you would get in the model's own chat interface, captured in parallel and never touched by POLOXI. <strong>Mention-frequency baseline</strong> is a “what if we skipped the smart part?” view: it takes the same candidates POLOXI discovered during its research and ranks them by how often they were mentioned, breaking ties with a plain unweighted average of the dimension scores — like a popularity contest with no evidence weighting, no constraint checks, and no head-to-head competition. Comparing the three columns shows exactly where POLOXI's evidence work changed the outcome.</p>
                    <div class="poloxi-decision">
                        <div class="poloxi-decision-header"><i class="bi bi-award" aria-hidden="true"></i> POLOXI Decision</div>
                        <div class="poloxi-decision-grid">
                            <section class="poloxi-decision-block" title="Composite quality from the interpretation-weighted Candidate × Branch matrix. Evidence confidence is disclosed separately.">
                                <span class="poloxi-decision-label"><i class="bi bi-clipboard-data" aria-hidden="true"></i> Quality</span>
                                @if (FinalRankedCandidates.Count > 0)
                                {
                                    <ol class="poloxi-decision-podium">
                                        @for (var p = 0; p < Math.Min(3, FinalRankedCandidates.Count); p++)
                                        {
                                            var podium = FinalRankedCandidates[p];
                                            <li>
                                                <span class="poloxi-decision-rank poloxi-decision-rank--@(p + 1)">@(p + 1)</span>
                                                <span class="poloxi-decision-name">@podium.DisplayName</span>
                                                <strong>@podium.CompositeScore.ToString("P0")</strong>
                                            </li>
                                        }
                                    </ol>
                                }
                                else
                                {
                                    <p class="poloxi-compare-unavailable">POLOXI candidate competition did not produce a final ranking for this execution. Reason: @PoloxiUnavailableReason</p>
                                }
                            </section>
                            <section class="poloxi-decision-block" title="Competition: evidence-score gap between the #1 and #2 candidates. Under 3 percentage points is within scoring noise — the winner is directional, not settled.">
                                <span class="poloxi-decision-label"><i class="bi bi-distribute-vertical" aria-hidden="true"></i> Winner margin</span>
                                @if (MarginToNext(0) is decimal topMargin)
                                {
                                    <strong class="poloxi-decision-value">+@((topMargin * 100).ToString("0.#")) pp</strong>
                                    <small>@(topMargin < .03m ? $"{FinalRankedCandidates[0].DisplayName} leads by only {topMargin:P0} — within scoring noise." : $"{FinalRankedCandidates[0].DisplayName} leads the runner-up by {topMargin:P0}.")</small>
                                }
                                else
                                {
                                    <strong class="poloxi-decision-value">—</strong>
                                }
                            </section>
                            <section class="poloxi-decision-block" title="Ranking certainty = 1 − final measured uncertainty (Shannon entropy). How certain POLOXI is that the ranking is sufficiently resolved. Low values are honest: they mean the field is genuinely contested, not that the ranking is wrong.">
                                <span class="poloxi-decision-label"><i class="bi bi-bullseye" aria-hidden="true"></i> Ranking certainty</span>
                                @{
                                    var rankingCertainty = 1m - _response.FinalNormalizedEntropy;
                                    var confidenceBand = rankingCertainty >= .7m ? "HIGH" : rankingCertainty >= .4m ? "MODERATE" : "LOW";
                                }
                                <strong class="poloxi-decision-value">@confidenceBand <span>@rankingCertainty.ToString("P0")</span></strong>
                                <small>Remaining ranking uncertainty @_response.FinalNormalizedEntropy.ToString("P0")</small>
                            </section>
                            <section class="poloxi-decision-block" title="Measured ambiguity at the start of the funnel vs. after interpretation, evidence evaluation, candidate competition, and convergence. The bar shows how much ambiguity was resolved. It does not represent confidence in an individual candidate.">
                                <span class="poloxi-decision-label"><i class="bi bi-funnel" aria-hidden="true"></i> POLOXI funnel &mdash; ambiguity resolved</span>
                                @{
                                    var ambiguityResolved = _response.InitialNormalizedEntropy <= 0m ? 0m : (_response.InitialNormalizedEntropy - _response.FinalNormalizedEntropy) / _response.InitialNormalizedEntropy;
                                }
                                <div class="poloxi-decision-funnel">
                                    <div class="poloxi-ambiguity-track"><span style="width: @((ambiguityResolved * 100m).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                                    <strong>@ambiguityResolved.ToString("P0") <span>(ambiguity @_response.InitialNormalizedEntropy.ToString("P0") → @_response.FinalNormalizedEntropy.ToString("P0"))</span></strong>
                                </div>
                                <small>Initial ambiguity → evidence → convergence</small>
                            </section>
                        </div>
                    </div>
                    <section class="poloxi-funnel-diagram" title="Pipeline-level ambiguity funnel — descends from the initial measured ambiguity through each information round to the resolved state after convergence. It does not represent confidence in any individual candidate.">
                        <span class="poloxi-decision-label"><i class="bi bi-funnel" aria-hidden="true"></i> Ambiguity funnel <small>(execution-level &mdash; not per-candidate)</small></span>
                        @foreach (var stage in FunnelStages)
                        {
                            <div class="poloxi-funnel-stage">
                                <span class="poloxi-funnel-stage-label">@stage.Label</span>
                                <div class="poloxi-ambiguity-track"><span style="width: @((Math.Clamp(stage.Value, 0m, 1m) * 100m).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
                                <strong>@stage.Value.ToString("P0")</strong>
                            </div>
                        }
                    </section>
                    <div class="poloxi-table-scroll">
                    <table class="poloxi-compare-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>With POLOXI <small>(interpretation-weighted Candidate × Branch)</small></th>
                                <th>LLM Raw <small>(actual single-shot model answer)</small></th>
                                <th title="The same candidates POLOXI found, ranked only by mention count with a plain unweighted score average as tie-break — no evidence weighting, no filtering, no competition.">Mention-frequency baseline <small>(POLOXI candidates, unweighted)</small></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var compareRowCount = Math.Max(1, Math.Max(Math.Max(FinalRankedCandidates.Count, BaselineRankedCandidates.Count), LlmRawItems.Count)); }
                            @for (var i = 0; i < compareRowCount; i++)
                            {
                                var poloxi = i < FinalRankedCandidates.Count ? FinalRankedCandidates[i] : null;
                                var raw = i < LlmRawItems.Count ? LlmRawItems[i] : null;
                                var baseline = i < BaselineRankedCandidates.Count ? BaselineRankedCandidates[i] : null;
                                var moved = raw is not null && poloxi is not null && FindPoloxiRank(raw.Name) != i + 1;
                                var zone = ContestZoneAt(i);
                                <tr class="@(moved ? "poloxi-compare-diff" : null)">
                                    <td>@(i + 1)</td>
                                    <td class="@(zone == 1 ? "poloxi-zone-contested" : zone == 2 ? "poloxi-zone-clear" : null)">
                                        @if (poloxi is not null)
                                        {
                                            <strong>@poloxi.DisplayName</strong> <span>@poloxi.CompositeScore.ToString("P0") quality score</span>
                                            var margin = MarginToNext(i);
                                            @if (margin is decimal gap)
                                            {
                                                <span class="poloxi-margin-gap @(gap < .03m ? "poloxi-margin-gap--contested" : gap >= .05m ? "poloxi-margin-gap--clear" : null)"
                                                      title="@(gap < .03m ? $"Contested: only {gap:P0} ahead of the next candidate — within scoring noise, the order here is not settled." : gap >= .05m ? $"Clear lead: {gap:P0} ahead of the next candidate — a separation the evidence actually supports." : $"{gap:P0} ahead of the next candidate.")">
                                                    <i class="bi @(gap < .03m ? "bi-arrows-collapse" : "bi-arrow-down-short")" aria-hidden="true"></i> +@gap.ToString("P0") vs next
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <em title="@PoloxiUnavailableReason">POLOXI unavailable — @PoloxiUnavailableReason</em>
                                        }
                                    </td>
                                    <td class="poloxi-compare-raw">
                                        @if (raw is not null)
                                        {
                                            var poloxiPosition = FindPoloxiRank(raw.Name);
                                            @raw.Name
                                            @if (poloxiPosition is int position && position != i + 1)
                                            {
                                                <span>POLOXI #@position</span>
                                            }
                                            else if (poloxiPosition is null)
                                            {
                                                <span>not in POLOXI ranking</span>
                                            }
                                        }
                                        else
                                        {
                                            <em>Raw LLM comparison unavailable</em>
                                        }
                                    </td>
                                    <td>
                                        @if (baseline is not null)
                                        {
                                            @baseline.DisplayName <span class="poloxi-mention-detail" title="@MentionBreakdown(baseline)">@baseline.InterpretiveSupportCount mention@(baseline.InterpretiveSupportCount == 1 ? "" : "s")@(baseline.BranchScores.Count > 0 ? $" · avg {baseline.BranchScores.Average(s => s.EvidenceScore):P0}" : "") <i class="bi bi-info-circle" aria-hidden="true"></i></span>
                                            @if (baseline.BranchScores.Count > 0)
                                            {
                                                <small class="poloxi-mention-dimensions">@string.Join(" · ", baseline.BranchScores.OrderByDescending(s => s.EvidenceScore).Select(s => $"{s.BranchDisplayName} {s.EvidenceScore:P0}"))</small>
                                            }
                                            @if (baseline.IsConstraintViolation)
                                            {
                                                <span class="poloxi-compare-flag">violates your constraints — POLOXI ruled it out</span>
                                            }
                                        }
                                        else
                                        {
                                            <em title="@BaselineUnavailableReason">Baseline unavailable — @BaselineUnavailableReason</em>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                </div>
            }
        </section>
    };

    private string _query = "";
    private string _clarificationAnswer = "";
    // Empty = Auto (tiered routing: mechanical stages on the fast model, synthesis on the reasoning model).
    // A specific ModelCode (e.g. gpt-4.1-mini or gpt-6-astra) forces that single model through every stage.
    private string _selectedModelCode = "";
    private IReadOnlyCollection<WideModelOptionDto> _models = [];
    private string _selectedContextCode = "Legal";
    private IReadOnlyCollection<WideSearchContextDto> _contexts = [];
    private bool _loading, _usePoloxiEngine = true;
    private bool _showPipeline;
    // Factor inventory: default to hiding broad parent (L1/L2) groupings so only atomic L3 factors show.
    private bool _atomicFactorsOnly = true;
    // V2.9 two-view UX: consumer Answer view by default; the full POLOXI Analysis stays one click away.
    private bool _showAnswerView = true;
    private string? _error;
    private WideSearchResponse? _response;

    // Candidate Full Analysis popup: the selected outcome to show in the in-page modal (null = closed).
    private OvOutcome? _analysisPopupOutcome;

    // DB-backed full candidate analysis loaded on demand for the popup (null until loaded).
    private CandidateFullAnalysisDto? _analysisPopupModel;
    private bool _analysisPopupLoading;
    private string? _analysisPopupError;

    // ── Real-time SignalR KPI feed ────────────────────────────────────────────────────────────
    // The Wide2 pipeline pushes provisional KPI snapshots through the Wide2ProgressHub while the
    // background search runs. _liveProgress holds the latest snapshot; it is set when a run starts
    // (with the run's CorrelationId) and cleared onto the final response when the run completes.
    private HubConnection? _hub;
    private string? _liveCorrelationId;
    // True once the SignalR hub has connected AND the subscribe round-trip succeeded. Drives an honest
    // LIVE/OFFLINE badge instead of tying "LIVE" to _loading (which lights up even when the socket
    // never connected). _liveFeedError holds the last transport failure reason for diagnostics.
    private bool _liveFeedConnected;
    private string? _liveFeedError;
    private Wide2ProgressUpdate? _liveProgress;
    // Local heartbeat that re-renders the pipeline strip roughly once per second while a run is
    // loading. The pipeline bar and mm:ss clock are pure getters that only update when the component
    // re-renders; without SignalR delivering progress messages the strip would otherwise freeze at
    // the seeded ANALYZING snapshot (stage 2) for the whole run. The timer keeps the visual advancing
    // via a time-based floor (see DfiPipelineFraction) even when the live feed never connects.
    private System.Threading.Timer? _liveHeartbeat;
    private DateTime _liveRunStartedUtc;
    // Rolling, newest-first log of execution phases pushed by the pipeline. Rendered as the shared
    // real-time execution strip at the top of every workspace tab so progress is visible regardless
    // of which tab the user is on. Capped to keep the strip compact.
    private readonly List<LiveExecutionEntry> _livePhaseLog = new();
    private const int LivePhaseLogCap = 8;
    // Newest-first running log of the actual documents processed during corpus activation, so the
    // operator can expand the pipeline strip and see each real file, what was done to it, how much
    // evidence was extracted, and whether it was concept-bound. Populated from the authoritative
    // per-document details returned by the activation service (never inflated/synthetic).
    private readonly List<Legal.Application.Features.Intelligence.Decision.LegalCorpusActivationDocumentDetail> _documentActivationLog = new();
    private bool _showDocumentActivationLog;
    private bool DfiLiveProvisional => _loading && _liveProgress is { IsProvisional: true };
    // The strip is shown while a run is streaming (provisional) and remains visible with the final
    // "Decision complete" entry until the next run clears it.
    private bool DfiShowLiveExecution => _livePhaseLog.Count > 0 && (_loading || _liveProgress is { IsProvisional: false });
    // The Decision Command Center (the full dfi-console workspace) is only rendered once an execution
    // has produced results. While a search is running it is hidden so the loading strip stays in view.
    private bool DfiShowCommandCenter => _response is not null && !_loading;
    // The Decision workspace (tabs + tab panel) is only meaningful once a run is streaming or has
    // produced results. Before the first search it is hidden so the page does not show an empty
    // tab strip with a large blank panel below it.
    private bool DfiShowWorkspace => DfiShowLiveExecution || DfiShowCommandCenter;
    private string DfiLivePhaseLabel => _liveProgress?.Phase switch
    {
        "PREPARING" => "Preparing documents",
        "ANALYZING" => "Interpreting",
        "HIERARCHY" => "Framing outcomes",
        "NARROWING" => "Refining",
        "COMPLETED" => "Complete",
        null => "Idle",
        _ => _liveProgress!.Phase
    };

    private sealed record LiveExecutionEntry(string Phase, string Label, string? Message, int CompetingOutcomes, int IdentifiedFactors, int AdmittedEvidence, bool IsProvisional, DateTime TimestampUtc);

    // ── Decision processing pipeline (fixed 7-stage cockpit visual) ────────────────────────────
    // The real pipeline emits a small set of coarse phases (ANALYZING / HIERARCHY / NARROWING /
    // COMPLETED). We map that phase onto a fixed, human-readable 7-stage journey so the operator
    // always sees the full route with completed / active / pending states, a connector rail, and a
    // determinate progress bar. Stage titles/subtitles are presentation only; scoring is unaffected.
    private sealed record DfiPipelineStage(string Title, string Subtitle);
    private static readonly IReadOnlyList<DfiPipelineStage> DfiPipelineStages = new[]
    {
        new DfiPipelineStage("Framing", "Structuring decision factors"),
        new DfiPipelineStage("Interpretation", "Refining interpretation paths"),
        new DfiPipelineStage("Candidate Outcomes", "Framing candidate outcomes"),
        new DfiPipelineStage("Question Analysis", "Interpreting the question"),
        new DfiPipelineStage("Factor Registration", "Registering dependencies"),
        new DfiPipelineStage("Evaluation", "Running competition and analysis"),
        new DfiPipelineStage("Readiness", "Checking decision readiness"),
    };
    // Fraction of the fixed journey completed, derived from the current coarse phase. Kept monotonic
    // so the bar only advances. COMPLETED fills the whole route.
    private double DfiPipelineFraction
    {
        get
        {
            var phaseFraction = (_liveProgress?.Phase, DfiLiveProvisional) switch
            {
                (_, false) when _liveProgress is { Phase: "COMPLETED" } => 1d,
                ("FRAMING", _) => 0.10,
                ("PREPARING", _) => 0.08,
                ("ANALYZING", _) => 0.18,
                ("HIERARCHY", _) => 0.42,
                ("NARROWING", _) => 0.66,
                ("COMPLETED", _) => 1d,
                (null, _) => 0.06,
                _ => 0.30,
            };
            // Real completion always wins outright.
            if (_liveProgress is { Phase: "COMPLETED" }) return 1d;
            // During document preparation (pre-pipeline corpus activation) the run has not entered the
            // decision pipeline yet, so the time-floor creep must NOT advance the bar past the preparing
            // stage — activation can legitimately take minutes. Hold the bar at the PREPARING fraction and
            // let the live "Preparing documents (N of M)" message convey motion instead of a misleading creep.
            if (_liveProgress is { Phase: "PREPARING" }) return phaseFraction;
            // The seeded/provisional FRAMING snapshot is shown immediately so the strip is visible for the
            // whole run. It must NOT creep past the Framing stage on a timer — otherwise step 1 turns green
            // "right away" before any real pipeline phase has arrived. Hold at the Framing fraction until a
            // real downstream phase (ANALYZING / HIERARCHY / …) replaces the seed.
            if (_liveProgress is { Phase: "FRAMING" }) return phaseFraction;
            // When the real-time feed is CONNECTED we trust the streamed phases outright and do NOT apply the
            // time-only creep. Otherwise the exponential floor (≈0.22 by 6s) races the bar to stage 2 and
            // marks Framing "done" before its real work finishes — which also hides the active stage's live
            // detail line. Tracking real phases keeps Framing active (and its detail visible) until the
            // pipeline genuinely advances.
            if (_liveFeedConnected) return phaseFraction;
            // While loading WITHOUT a connected feed, ease the bar smoothly along the journey using elapsed
            // time so it always visibly advances even when no SignalR progress message arrives
            // (transport/tenant/auth can silently drop the live feed). Capped at 0.85 so the time-only creep
            // glides up to stage 6 (ceil(0.85*7)=6) but never lights the final Readiness stage; stage 7 /
            // 100% is reserved exclusively for a REAL COMPLETED phase (live feed) or the synthesized
            // COMPLETED snapshot written in StopLiveProgressAsync when the run's result actually returns.
            if (_loading)
            {
                var elapsed = (DateTime.UtcNow - _liveRunStartedUtc).TotalSeconds;
                if (elapsed < 0) elapsed = 0;
                var timeFloor = 0.85 * (1 - Math.Exp(-elapsed / 20d));
                return Math.Clamp(Math.Max(phaseFraction, timeFloor), 0.06, Math.Max(phaseFraction, 0.85));
            }
            return phaseFraction;
        }
    }
    private int DfiPipelineActiveIndex => Math.Clamp((int)Math.Ceiling(DfiPipelineFraction * DfiPipelineStages.Count), 1, DfiPipelineStages.Count);
    private int DfiPipelineProgressPct => (int)Math.Round(DfiPipelineFraction * 100);
    private string DfiPipelineStatusLine
    {
        get
        {
            var stage = DfiPipelineStages[DfiPipelineActiveIndex - 1];
            var current = _livePhaseLog.Count > 0 ? _livePhaseLog[0].Label : stage.Subtitle;
            return $"Step {DfiPipelineActiveIndex} of {DfiPipelineStages.Count} · {current}";
        }
    }

    // Latest streamed detail for the active stage, truncated so the rail stays compact.
    // Falls back to the stage subtitle when no live message has arrived yet.
    private string DfiPipelineActiveDetail
    {
        get
        {
            var raw = _livePhaseLog.Count > 0
                ? (!string.IsNullOrWhiteSpace(_livePhaseLog[0].Message) ? _livePhaseLog[0].Message : _livePhaseLog[0].Label)
                : DfiPipelineStages[DfiPipelineActiveIndex - 1].Subtitle;
            return (raw ?? string.Empty).Replace('\n', ' ').Replace('\r', ' ').Trim();
        }
    }
    // Wall-clock elapsed since the first streamed phase, rendered as mm:ss in the cockpit header.
    private string DfiPipelineElapsed
    {
        get
        {
            if (_livePhaseLog.Count == 0) return "00:00";
            var start = _livePhaseLog[^1].TimestampUtc;
            var span = DateTime.UtcNow - start;
            if (span < TimeSpan.Zero) span = TimeSpan.Zero;
            return $"{(int)span.TotalMinutes:00}:{span.Seconds:00}";
        }
    }

    private int DfiLiveCompetingOutcomes => DfiLiveProvisional ? _liveProgress!.CompetingOutcomes : DfiCompetingOutcomes;
    private int DfiLiveFactorCount => DfiLiveProvisional ? _liveProgress!.IdentifiedFactors : DfiFactorCount;
    private int DfiLiveEvidenceCount => DfiLiveProvisional ? _liveProgress!.AdmittedEvidence : TotalEvidenceCount;
    private string DfiLiveReadinessLabel => DfiLiveProvisional ? _liveProgress!.DecisionReadiness : DfiReadinessLabel;
    private string DfiLiveReadinessTone => DfiLiveProvisional ? "warn" : DfiReadinessTone;

    // Seeds a local ANALYZING snapshot so the 1->7 pipeline strip is visible immediately for the
    // whole run, independent of the SignalR live feed. Real "progress" messages replace this entry.
    private void SeedLiveProgress(string correlationId)
    {
        _livePhaseLog.Clear();
        _liveRunStartedUtc = DateTime.UtcNow;
        _liveFeedConnected = false;
        _liveFeedError = null;
        var bootstrap = new Wide2ProgressUpdate(correlationId, "FRAMING", 0, 0, 0, "Framing", true, "Structuring decision factors…");
        _liveProgress = bootstrap;
        RecordLivePhase(bootstrap);
        StartLiveHeartbeat();
    }

    // Pushes a local PREPARING snapshot onto the strip while pre-pipeline corpus activation runs. This
    // window can take minutes (per-document LEGAL_DOCUMENT_SEMANTIC_EXTRACTION calls) and the decision
    // pipeline — the only source of SignalR progress frames — has NOT started yet, so without this the
    // strip would sit frozen at the seeded snapshot. The activated/pending counts convey real motion.
    // Pushes a local PREPARING snapshot onto the strip while pre-pipeline corpus activation runs. This
    // window can take minutes (per-document LEGAL_DOCUMENT_SEMANTIC_EXTRACTION calls) and the decision
    // pipeline — the only source of SignalR progress frames — has NOT started yet, so without this the
    // strip would sit frozen at the seeded snapshot. Counts are the authoritative DB totals: how many
    // document versions are genuinely enriched out of the real corpus size (never an inflated tally).
    private void ReportPreparingPhase(int enriched, int total)
    {
        if (!_loading) return;
        var message = total > 0
            ? $"Preparing documents ({enriched} of {total})…"
            : "Preparing documents…";
        var update = new Wide2ProgressUpdate(_liveCorrelationId, "PREPARING", 0, 0, enriched, "Preparing", true, message);
        _liveProgress = update;
        RecordLivePhase(update);
    }

    // Enriched real-time variant: names the actual document being processed and what is being done to
    // it (semantic enrichment, evidence extracted, concept binding) so the pipeline strip shows a
    // meaningful, human-readable line instead of a bare "N of M" count.
    private void ReportPreparingPhase(int enriched, int total, Legal.Application.Features.Intelligence.Decision.LegalCorpusActivationDocumentDetail? detail)
    {
        if (!_loading) return;
        // Keep the newest processed documents at the top of the expandable activation log.
        if (detail is not null)
        {
            _documentActivationLog.RemoveAll(d => d.LegalDocumentVersionId == detail.LegalDocumentVersionId);
            _documentActivationLog.Insert(0, detail);
        }
        string message;
        if (detail is not null)
        {
            var name = string.IsNullOrWhiteSpace(detail.FileName) ? "document" : detail.FileName.Trim();
            if (detail.Succeeded)
            {
                var parts = new List<string>();
                if (detail.EvidenceExtracted > 0)
                    parts.Add($"{detail.EvidenceExtracted} evidence item{(detail.EvidenceExtracted == 1 ? "" : "s")}");
                else if (detail.PassagesRead > 0)
                    parts.Add($"{detail.PassagesRead} passage{(detail.PassagesRead == 1 ? "" : "s")} analyzed");
                if (detail.ConceptBound && !string.IsNullOrWhiteSpace(detail.DomainPackCode))
                    parts.Add($"concept-bound ({FormatDomainPack(detail.DomainPackCode)})");
                var suffix = parts.Count > 0 ? $" — {string.Join(", ", parts)}" : string.Empty;
                message = total > 0
                    ? $"Extracting evidence from \u201C{name}\u201D ({enriched} of {total}){suffix}"
                    : $"Extracting evidence from \u201C{name}\u201D{suffix}";
            }
            else
            {
                message = total > 0
                    ? $"Could not activate \u201C{name}\u201D ({enriched} of {total}) — skipped"
                    : $"Could not activate \u201C{name}\u201D — skipped";
            }
        }
        else
        {
            message = total > 0 ? $"Preparing documents ({enriched} of {total})…" : "Preparing documents…";
        }
        var update = new Wide2ProgressUpdate(_liveCorrelationId, "PREPARING", 0, 0, enriched, "Preparing", true, message);
        _liveProgress = update;
        RecordLivePhase(update);
    }

    // Presents a raw pack code (e.g. PERSONAL_INJURY) as a readable label (Personal Injury).
    private static string FormatDomainPack(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return "Bound";
        var words = code.Replace('_', ' ').ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join(' ', words.Select(w => char.ToUpperInvariant(w[0]) + w[1..]));
    }

    // Drives ~1s re-renders while a run is loading so the time-based pipeline floor and the mm:ss
    // clock advance even when SignalR delivers no progress messages. Stopped when the run completes.
    private void StartLiveHeartbeat()
    {
        _liveHeartbeat ??= new System.Threading.Timer(_ =>
        {
            if (!_loading) return;
            _ = InvokeAsync(StateHasChanged);
        }, null, System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
        _liveHeartbeat.Change(TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopLiveHeartbeat()
        => _liveHeartbeat?.Change(System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);

    // Lazily creates and starts the hub connection to the API host, then subscribes to a run's
    // correlation group. Fully fail-soft: any transport error leaves the poll-based result intact.
    private async Task StartLiveProgressAsync(string correlationId)
    {
        _liveCorrelationId = correlationId;
        // Ensure a local snapshot exists so the 1->7 pipeline strip renders even if the hub below
        // never connects. If SearchAsync already seeded it for this correlation, keep the log intact.
        if (_livePhaseLog.Count == 0 || !string.Equals(_liveProgress?.CorrelationId, correlationId, StringComparison.Ordinal))
            SeedLiveProgress(correlationId);
        StateHasChanged();
        try
        {
            if (_hub is null)
            {
                var apiBase = Configuration["Api:BaseUrl"] ?? "https://localhost:7251/";
                var hubUrl = new Uri(new Uri(apiBase), "hubs/wide2-progress");
                _hub = new HubConnectionBuilder()
                    .WithUrl(hubUrl, options =>
                    {
                        // Blazor Server opens this hub connection server->API. In Development the API is
                        // served over the self-signed localhost dev certificate, which the HubConnection's
                        // own HttpClient rejects during /negotiate — silently killing the live feed while
                        // the ApiClient (which trusts the dev cert) still works. Bypass validation for
                        // localhost dev only; production uses a real certificate and keeps full validation.
                        if (HostEnvironment.IsDevelopment())
                        {
                            options.HttpMessageHandlerFactory = _ => new HttpClientHandler
                            {
                                ServerCertificateCustomValidationCallback =
                                    HttpClientHandler.DangerousAcceptAnyServerCertificateValidator
                            };
                            options.WebSocketConfiguration = ws =>
                                ws.RemoteCertificateValidationCallback = (_, _, _, _) => true;
                        }
                    })
                    .WithAutomaticReconnect()
                    .Build();
                _hub.On<Wide2ProgressUpdate>("progress", update =>
                {
                    if (!string.Equals(update.CorrelationId, _liveCorrelationId, StringComparison.Ordinal)) return;
                    _liveProgress = update;
                    RecordLivePhase(update);
                    _ = InvokeAsync(StateHasChanged);
                });
            }
            if (_hub.State == HubConnectionState.Disconnected) await _hub.StartAsync();
            await _hub.InvokeAsync("Subscribe", correlationId);
            _liveFeedConnected = true;
            _liveFeedError = null;
        }
        catch (Exception ex)
        {
            // Real-time feed is best-effort; the start+poll result path is unchanged. Record the reason
            // so the cockpit can indicate the live feed is offline instead of showing a misleading LIVE
            // badge with frozen 0/0/0 counters.
            _liveFeedConnected = false;
            _liveFeedError = ex.Message;
        }
    }

    // Appends a phase snapshot to the newest-first rolling log used by the shared execution strip.
    // Consecutive updates for the same phase replace the prior one so the strip advances instead of
    // repeating identical rows while counters tick up within a phase.
    private void RecordLivePhase(Wide2ProgressUpdate update)
    {
        var label = update.Phase switch
        {
            "FRAMING" => "Structuring decision factors",
            "PREPARING" => "Preparing documents",
            "ANALYZING" => "Interpreting the question",
            "HIERARCHY" => "Framing candidate outcomes",
            "NARROWING" => "Refining interpretation paths",
            "COMPLETED" => DfiExecutionCompleteLabel,
            _ => update.Phase
        };
        var entry = new LiveExecutionEntry(update.Phase, label, update.Message,
            update.CompetingOutcomes, update.IdentifiedFactors, update.AdmittedEvidence,
            update.IsProvisional, DateTime.UtcNow);
        if (_livePhaseLog.Count > 0 && string.Equals(_livePhaseLog[0].Phase, update.Phase, StringComparison.Ordinal))
            _livePhaseLog[0] = entry;
        else
            _livePhaseLog.Insert(0, entry);
        if (_livePhaseLog.Count > LivePhaseLogCap)
            _livePhaseLog.RemoveRange(LivePhaseLogCap, _livePhaseLog.Count - LivePhaseLogCap);
    }

    private async Task StopLiveProgressAsync()
    {
        StopLiveHeartbeat();
        // Deterministically finish the strip. The live SignalR feed may never deliver a COMPLETED
        // phase (transport/tenant/auth), so when the run's result has actually returned we synthesize
        // a COMPLETED snapshot ourselves. This fills the bar to 100% / stage 7 and flips the strip out
        // of the provisional state, instead of leaving it frozen at the seeded snapshot.
        var correlationId = _liveCorrelationId;
        if (!string.IsNullOrEmpty(correlationId))
        {
            var lastCounts = _liveProgress;
            var completed = new Wide2ProgressUpdate(
                correlationId, "COMPLETED",
                lastCounts?.CompetingOutcomes ?? DfiCompetingOutcomes,
                lastCounts?.IdentifiedFactors ?? DfiFactorCount,
                lastCounts?.AdmittedEvidence ?? TotalEvidenceCount,
                DfiReadinessLabel, false, DfiExecutionCompleteLabel);
            _liveProgress = completed;
            RecordLivePhase(completed);
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            _liveProgress = null;
        }
        _liveCorrelationId = null;
        if (_hub is null || string.IsNullOrEmpty(correlationId)) return;
        try { if (_hub.State == HubConnectionState.Connected) await _hub.InvokeAsync("Unsubscribe", correlationId); }
        catch { /* best-effort */ }
    }

    public async ValueTask DisposeAsync()
    {
        try { _liveHeartbeat?.Dispose(); } catch { /* best-effort */ }
        if (_hub is not null)
        {
            try { await _hub.DisposeAsync(); } catch { /* best-effort */ }
        }
    }

