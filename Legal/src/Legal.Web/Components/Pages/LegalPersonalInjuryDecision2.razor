    // ── Real-time intake pipeline stepper (directional stage indicator) ──
    // One integrated indicator with two phases: "Prepared on upload" (deterministic intake) and
    // "Activated on answer" (metered reasoning that runs on Disambiguate & Answer). The Queued state
    // marks activation stages that are prepared but deferred until the answer path runs.
    internal enum UploadStageState { Pending, Active, Done, Skipped, Failed, Queued }
    internal enum UploadResult { None, Pass, Warn, Fail }
    private UploadResult _uploadResult = UploadResult.None;
    internal sealed class UploadStage
    {
        public required string Key { get; init; }
        public required string Label { get; init; }
        public required string Icon { get; init; }
        // "prepare" (runs on upload) or "activate" (runs on Disambiguate & Answer).
        public required string Segment { get; init; }
        public UploadStageState State { get; set; } = UploadStageState.Pending;
    }
    private List<UploadStage>? _uploadStages;

    private List<UploadStage> BuildUploadStages() =>
    [
        new() { Key = "upload", Label = "Upload", Icon = "bi-cloud-arrow-up", Segment = "prepare" },
        new() { Key = "scan", Label = "Malware scan", Icon = "bi-shield-check", Segment = "prepare" },
        new() { Key = "blob", Label = "Store to Blob", Icon = "bi-hdd-network", Segment = "prepare" },
        new() { Key = "db", Label = "Save to database", Icon = "bi-database", Segment = "prepare" },
        new() { Key = "extract", Label = "Extract text", Icon = "bi-file-text", Segment = "prepare" },
        new() { Key = "propositions", Label = "Atomic propositions", Icon = "bi-diagram-3", Segment = "activate" },
        new() { Key = "cdc", Label = "Re-check decisions (CDC)", Icon = "bi-arrow-repeat", Segment = "activate" },
    ];

    private void SetUploadStage(string key, UploadStageState state)
    {
        var stage = _uploadStages?.FirstOrDefault(s => s.Key == key);
        if (stage is not null)
        {
            stage.State = state;
            StateHasChanged();
        }
    }

    private static string UploadStageCss(UploadStageState state) => state switch
    {
        UploadStageState.Active => "is-active",
        UploadStageState.Done => "is-done",
        UploadStageState.Skipped => "is-skipped",
        UploadStageState.Failed => "is-failed",
        UploadStageState.Queued => "is-queued",
        _ => "is-pending"
    };

    private static string UploadStageIcon(UploadStage stage) => stage.State switch
    {
        UploadStageState.Done => "bi-check-circle-fill",
        UploadStageState.Active => "bi-arrow-repeat intake-spin",
        UploadStageState.Skipped => "bi-slash-circle",
        UploadStageState.Failed => "bi-x-circle-fill",
        UploadStageState.Queued => "bi-hourglass-split",
        _ => stage.Icon
    };

    private void SetUploadResult(UploadResult result)
    {
        _uploadResult = result;
        StateHasChanged();
    }

    private static string UploadResultCss(UploadResult result) => result switch
    {
        UploadResult.Pass => "is-pass",
        UploadResult.Warn => "is-warn",
        UploadResult.Fail => "is-fail",
        _ => string.Empty
    };

    private static string UploadResultIcon(UploadResult result) => result switch
    {
        UploadResult.Pass => "bi-check2-all",
